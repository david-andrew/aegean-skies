# AEGEAN SKIES - a living-world seaplane sandbox in a sunlit, interwar Aegean.
#
# On foot: WASD to walk (Shift to run), the mouse (right button held) or Q/E to look around, F by
# your aircraft to climb aboard. M: the chart. F2: a free camera, for looking around.
#
# AEGEAN_VIEW="x y z yaw pitch hour" starts in the free camera there, at that hour (screenshots);
# AEGEAN_HOUR sets the hour of the start.

build:
    name = "Aegean Skies"
    js = "src/web_compat.js"

use 'src/world.jo'
use 'src/quality.jo'
use 'src/look.jo'
use 'src/terrain.jo'
use 'src/terrain_lod.jo'
use 'src/geography.jo'
use 'src/world_terrain.jo'
use 'src/world_groves.jo'
use 'src/world_towns.jo'
use 'src/render_space.jo'
use 'src/curved_world.jo'
use 'src/sea.jo'
use 'src/clouds.jo'
use 'src/cloud_volume.jo'
use 'src/cloud_field.jo'
use 'src/cloud_depth.jo'
use 'src/sky.jo'
use 'src/objects.jo'
use 'src/touch.jo'
use 'src/chart.jo'
use 'src/planes.jo'
use 'src/folk.jo'
use 'src/hud.jo'
use 'src/grass.jo'
use 'src/sound.jo'
use 'src/flight.jo'
use 'src/pilot.jo'
use 'src/traffic.jo'
use 'src/distant.jo'
use 'src/tweaks.jo'
import 'src/living_world.jo' as living
import 'src/living_scene.jo' as living_scene
use 'src/wake.jo'
use 'src/shadow.jo'
use 'src/birds.jo'
use 'src/trails.jo'
use 'src/damage.jo'
use 'src/townsfolk.jo'
use 'src/speech.jo'
use 'src/panels.jo'
use 'src/mooring.jo'
use 'src/vessel_types.jo'
use 'src/vessels.jo'
use 'src/sea_routes.jo'
use 'src/vessel_scene.jo'
use 'src/vessel_view.jo'
use 'src/guns.jo'
use 'src/combat.jo'
use 'src/combat_bridge.jo'
use 'src/combat_view.jo'
use 'src/combat_sound.jo'
use 'src/cockpit.jo'
use 'src/bailout.jo'
use 'src/fabric.jo'
use 'src/debugmenu.jo'
use 'src/notebook.jo'
import 'src/cargo_scene.jo' as cargo_scene
import 'src/cargo_view.jo' as cargo_view
import 'src/life_view.jo' as life_view
import 'src/life_audio.jo' as life_audio
import 'src/living_portage.jo' as portage
import 'src/living_claims.jo' as claims
import 'src/living_types.jo' as lt
import 'src/life_types.jo' as social
from 'src/living_money.jo' import craft_grams

window("Aegean Skies", 1280, 720)
init_quality()
# The CPU rasterizer cannot sample its depth buffer through the GL texture API.
# Keep its existing opaque cloud path for CI/software use, as well as A/B runs.
legacy_clouds = (env("AEGEAN_LEGACY_CLOUDS") ?? "") == "1"
when TARGET != "wasm":
    if __soft: legacy_clouds = true
if not legacy_clouds: init_cloud_volumes()
init_terrain()
init_sky()
init_objects()
init_sea()
init_grass()
init_wake()
init_shadow()
init_trails()
init_birds()
init_curved_world()

# how many times faster than designed the aircraft truly fly (handling kept at the designed turn
# rates; the pause menu's Speed scale, AEGEAN_SPEED_SCALE): set before any aircraft or trip is made
BASE_SPEED_SCALE = 3.3              # (the pause menu's Speed, to start with)
set_speed_scale(to_float(env("AEGEAN_SPEED_SCALE") ?? "") ?? BASE_SPEED_SCALE)
lt.scale_airframes(speed_scale)

t0 = time()
if not load_land(embed("assets/terrain.bin")): panic("assets/terrain.bin mismatch/corruption: run sloppy --release tools/bake.jo")
build_terrain_from_source()
if (env("AEGEAN_WORLD") ?? "1") == "1":
    if not load_geography(embed("assets/world.bin")): panic("world.bin mismatch/corruption: run sloppy --release tools/bake_world.jo")
    geography_enabled = true
    init_world_terrain()
    if env("AEGEAN_WORLD_CHECK") != none: print("geography fingerprint {geography_fingerprint()}")
depth_tex = build_depth_texture()
sea_mesh = build_sea_mesh()
# The legacy instances are allocated only when that path is selected.
puff_mesh: Mesh
puffs: InstanceBuffer[Puff]
if legacy_clouds:
    puff_mesh = build_puff_mesh()
    puffs = instance_buffer(build_puffs(7,render_quality.cloud_fields))
towns = [loop st in SETTLEMENTS: build_town(st)]
init_world_towns(towns)
living_world = living.build_world(u64(0), harbors_from_towns(towns))
traffic_scene = living_scene.SceneAdapter()
tree_meshes = build_tree_meshes()
groves = [loop k in 0..ISLANDS.len(): build_grove(k, towns)]
chart = build_chart()
flocks = build_flocks(towns, 21)
bird_mesh = build_bird()
# Saved living trips and the trade/war adapter supply identities; no second fleet.
vessels = VesselFleet()
vessel_bindings = VesselBindings()
vessel_view = VesselView()
vessel_mooring = VesselMooring()
craft_models = build_craft_models()
if env("TOWNS_PRINT") != none:
    loop tw in towns: print("{tw.name}: {tw.center.x:.0} {tw.center.z:.0} out {tw.out.x:.2} {tw.out.y:.2} houses {tw.houses.len()}")
print("world built in {(time() - t0) * 1000.0:.0} ms")

fonts = Fonts(load_font(embed("assets/fonts/JosefinSans-SemiBold.ttf")), load_font(embed("assets/fonts/Limelight-Regular.ttf")))

# ---------------- the player ----------------

enum Mode:
    walking
    aboard          # in the cockpit (the flight model comes here)
    descent         # falling, under a canopy, or swimming after leaving an aircraft
    free            # a free camera, for looking around

struct Player:
    mode: Mode = .walking
    pos: vec3
    yaw: f64 = 0.0                  # the way they face (world turn: faces (sin, cos))
    phase: f64 = 0.0                # the walk's swing
    stride: f64 = 0.0
    money = 120

# an aircraft at rest: moored at a dock, bobbing on the swell
struct Moored:
    kind: Craft
    model: int
    pos: vec3
    yaw: f64

home = towns[0]
along_quay = atan2(f64(home.out.x), -f64(home.out.y))        # (a flight heading: 0 north, east PI/2)
# the player's own aircraft, moored at the first dock; others moored at the rest
# AEGEAN_CRAFT uses the append-only Craft ID, independent of cached livery/model slots.
start_kind = Craft(clamp(to_int(env("AEGEAN_CRAFT") ?? "0") ?? 0, 0, CRAFT_NAMES.len() - 1))
start_model = default_craft_model(start_kind)
start_record = living_world.people[living_world.player].craft
living_world.aircraft[start_record].kind = lt.Airframe(int(start_kind))
living_world.aircraft[start_record].model_index = start_model
living_world.aircraft[start_record].livery_index = DEFAULT_LIVERIES[int(start_kind)]
pc = make_flyer(start_kind, start_model, craft_models[start_model].contacts, home.docks[0], along_quay)
pc.spec.player = true
moored: Moored[]
traffic = make_living_traffic(living_world, craft_models)
bind_living_player(pc, living_world, traffic_scene)

# ---------------- the people of the towns, the boards, talking and trading ----------------

cargo_scene.configure_cargo_scene(living_world,towns)
cargo_meshes = cargo_view.build_cargo_meshes()
folks: Folk[]
sync_folk(folks, living_world, towns)
life_meshes = life_view.build_life_meshes(living_world)
folk_sync_t = 0.0
enum Ui: none, talk, board, handling, trade
ui = Ui.none
ui_folk = -1
ui_place = -1
ui_line = ""
ui_news = 0
# (the conversation under way: the last thing they said, the replies it invites, whether they've
# had enough)
ui_turn = social.ConversationTurn(-1, -1, .greeting)

# what a turn says aloud: the words, then any question
turn_text = (turn: social.ConversationTurn) -> str: if turn.question != "": "{turn.text} {turn.question}" else: turn.text
ui_job = -1
toast = ""
paused = false
my_jobs: {int: lt.JobState} = {}       # the errands one carries, and how they stood last
toast_until = 0.0

# a harbor's notice board: two posts and a board with a little roof, on the waterfront
board_mesh = custom_mesh(():
    vs: Vertex3D[]
    wood = rgb(0.42, 0.3, 0.19)
    add_box(vs, vec3(-0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0, 1.45, 0), vec3(2.1, 1.1, 0.08), rgb(0.5, 0.36, 0.22))
    loop k in 0..5: add_box(vs, vec3(f32(-0.75 + f64(k) * 0.37), f32(1.45 + f64((k * 37) % 3) * 0.12 - 0.12), 0.06), vec3(0.28, 0.34, 0.02), rgb(0.95, 0.91, 0.8))
    add_gable(vs, vec3(0, 2.05, 0), 2.2, 0.5, 0.25, ROOFS[1], mat4())
    vs
())
board_spots: vec3[]
loop tw in towns:
    bp = tw.center - vec3(tw.out.x, 0, tw.out.y) * 4.0 + vec3(-tw.out.y, 0, tw.out.x) * 7.0
    board_spots.push(vec3(bp.x, f32(walk_height(towns, f64(bp.x), f64(bp.z))), bp.z))

# (AEGEAN_UI=board|talk|trade opens that panel at the home harbor at the start, for screenshots)
if let v = env("AEGEAN_UI"):
    living.advance_minutes(living_world, if v == "board": 180 else: 20)
    sync_folk(folks, living_world, towns)
    ui_place = 0
    if v == "board": ui = .board
    else:
        loop k in 0..folks.len():
            if folks[k].place == 0 and ui_folk < 0 and (v != "trade" or living_world.people[folks[k].person].occupation == .merchant): ui_folk = k
        # (talk: someone with work to offer, if anyone has)
        loop k in 0..folks.len():
            loop id in living_world.active_jobs:
                if v == "talk" and folks[k].place == 0 and living_world.jobs[id].delivery_mode == .aircraft and living_world.jobs[id].state == .open and living_world.jobs[id].poster == folks[k].person and living_world.jobs[id].origin == folks[k].place: ui_folk = k
        if ui_folk >= 0:
            ui = if v == "trade": Ui.trade else: Ui.talk
            ui_line = say(living_world, folks[ui_folk].person)

player_cents = () -> int:
    a = living_world.people[living_world.player].account
    if a >= 0: living_world.accounts[a].cents else: 0

say_toast = (s: str):
    global toast, toast_until
    toast = s
    toast_until = t + 5.0

# the town one is in (by the nearest waterfront within a few hundred meters), or -1
town_here = (p: vec3) -> int:
    best = -1
    bd = 450.0
    loop k in 0..towns.len():
        d = f64(length(vec2(towns[k].center.x - p.x, towns[k].center.z - p.z)))
        if d < bd:
            bd = d
            best = k
    best

near_board = () -> int:
    loop k in 0..board_spots.len():
        if length(board_spots[k] - me.pos) < 3.2: return k
    -1

# jobs the player carries for this place, delivered on arrival (paid then)
deliver_here = (place: int):
    loop id in living_world.active_jobs:
        j = living_world.jobs[id]
        if j.state != .claimed or j.carrier != living_world.player or j.destination != place or j.purpose != .passenger: continue
        before = player_cents()
        if living.deliver_job(living_world, id, living_world.player):
            say_toast("Delivered for {living_world.people[j.poster].name}: {(player_cents() - before) / 100} lire")
spray_ps = Particles3D(gravity = vec3(0, -9.8, 0), drag = 1.5)
smoke_ps = Particles3D(gravity = vec3(0, 1.5, 0), drag = 2.0)
vapor_trails = [Trail(), Trail()]
wakes: WakeTrail[] = [loop k in 0..traffic.len() + 1: WakeTrail()]

# on the main quay, beside one's own aircraft
q0 = home.quays[0]
dk = vec2(home.docks[0].x, home.docks[0].z)
qd = q0.b - q0.a
along_q = clamp(dot(dk - q0.a, qd) / dot(qd, qd), 0.0, 1.0)
on_q = q0.a + qd * along_q
toward = normalize(dk - on_q)
sp = on_q + toward * (q0.width * 0.5 - 1.2)
start = vec3(sp.x, 0, sp.y)
me = Player(pos = vec3(start.x, f32(walk_height(towns, f64(start.x), f64(start.z))), start.z), yaw = atan2(f64(home.out.x), f64(home.out.y)))
me_fig = build_figure(.pilot, 7)
tuft = build_tuft()
audio = if env("SLOPPY_NO_AUDIO") != none: Audio() else: start_audio()
life_sound = life_audio.build_life_audio()
hearing = if env("SLOPPY_NO_AUDIO") != none: Hearing() else: make_hearing()
battle = Battle(enabled=true,seed=int(living_world.seed%100000))
register_combat_body(battle,living_world,living_world.people[living_world.player].craft,pc.spec,pc.state,true)
combat_visual = make_combat_view()
combat_audio = if env("SLOPPY_NO_AUDIO") != none: CombatAudio() else: start_combat_audio()
cockpit_model = build_cockpit()

grass = GrassField(me.pos, instance_buffer([Instance3D(mat4(), vec4(1, 1, 1, 1))]), 0)

follow = follow_camera(distance = 5.5, pitch = 0.25, height = 1.6)
descent_camera = follow_camera(distance=14.0,pitch=0.18,height=3.5)
follow.yaw = me.yaw + PI
free = fly_camera(vec3(2600, 380, 2600), 0.8, -0.18)
free.speed = 120.0
hour = to_float(env("AEGEAN_HOUR") ?? "9.5") ?? 9.5
t = 0.0
show_chart = env("AEGEAN_CHART") != none

if let v = env("AEGEAN_VIEW"):
    w = split(v, " ")
    if w.len() >= 6:
        free.pos = vec3(f32(to_float(w[0]) ?? 0.0), f32(to_float(w[1]) ?? 0.0), f32(to_float(w[2]) ?? 0.0))
        free.yaw = to_float(w[3]) ?? 0.0
        free.pitch = to_float(w[4]) ?? 0.0
        hour = to_float(w[5]) ?? 15.0
        me.mode = .free
if let v = env("AEGEAN_AT"):
    w = split(v, " ")
    x = to_float(w[0]) ?? 0.0
    z = to_float(w[1]) ?? 0.0
    me.pos = vec3(f32(x), f32(walk_height(towns, x, z)), f32(z))
    follow.yaw = to_float(w[2]) ?? 0.0
if env("AEGEAN_ABOARD") != none: me.mode = .aboard
trace = env("AEGEAN_TRACE") != none
# AEGEAN_NEAR_BOOST=x sets how much faster the near sea and ground stream past (the pause menu's)
if let nb = env("AEGEAN_NEAR_BOOST"): set_near_boost(to_float(nb) ?? 3.0)
# AEGEAN_SPEED_MODE=0..3 picks the trick for the feel of speed (off, detail, sea, stretch)
if let sm = env("AEGEAN_SPEED_MODE"): set_speed_mode(to_int(sm) ?? 1)
# AEGEAN_FLYING="altitude speed" starts in the air off the home harbor, heading out to sea
if let v = env("AEGEAN_FLYING"):
    w = split(v, " ")
    alt = to_float(w[0]) ?? 60.0
    spd = to_float(w[1]) ?? 55.0
    h = along_quay
    p0 = home.docks[0] + vec3(home.out.x, 0, home.out.y) * 500.0
    pc.state = CraftState(position = vec3(p0.x, f32(alt), p0.z), velocity = heading_vector(h) * f32(spd), orientation = quat_euler(0, -h, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, throttle = 0.85)
    pc.throttle = 0.85
    pc.aim_heading = h
    me.mode = .aboard
if let v = env("AEGEAN_WIND"):
    w = split(v, " ")
    wind_now.speed = to_float(w[0]) ?? 6.0

# ---------------- townsfolk wandering (until the world's people walk here themselves) ----------------

struct Walker:
    fig: Figure
    town: int
    pos: vec3
    target: vec3
    yaw: f64
    phase: f64
    wait: f64
    speed: f64

walkers: Walker[]
seed_random(5)
loop ti in 0..towns.len():
    tw = towns[ti]
    if tw.houses.len() < 3: continue
    n = min(6, 1 + tw.houses.len() / 12)
    loop k in 0..n:
        hp = tw.houses[random_int(0, tw.houses.len() - 1)]
        dress: Dress = [Dress.fisher, .merchant, .dress, .widow, .worker, .fisher, .police][k % 7]
        p = vec3(hp.x, f32(walk_height(towns, f64(hp.x), f64(hp.z))), hp.z)
        walkers.push(Walker(build_figure(dress, ti * 100 + k), ti, p, p, random(0.0, TAU), 0.0, random(0.0, 5.0), random(1.0, 1.5)))

_pick_target = (w: Walker) -> vec3:
    tw = towns[w.town]
    if random() < 0.4 and tw.quays.len() > 0:
        q = tw.quays[random_int(0, tw.quays.len() - 1)]
        p = q.a + (q.b - q.a) * f32(random(0.15, 0.95))
        return vec3(p.x, 0, p.y)
    hp = tw.houses[random_int(0, tw.houses.len() - 1)]
    vec3(hp.x + f32(random(-6.0, 6.0)), 0, hp.z + f32(random(-6.0, 6.0)))

update_walkers = (dt: f64):
    loop mut w in walkers:
        if length(w.pos - me.pos) > 900.0: continue
        if w.wait > 0.0:
            w.wait -= dt
            if w.wait <= 0.0: w.target = _pick_target(w)
            continue
        d = vec2(w.target.x - w.pos.x, w.target.z - w.pos.z)
        l = f64(length(d))
        if l < 1.0:
            w.wait = random(2.0, 12.0)
            continue
        dir = d / f32(l)
        w.yaw = approach_angle(w.yaw, atan2(f64(dir.x), f64(dir.y)), 6.0, dt)
        np = walk_step(towns, w.pos, vec2(f32(sin(w.yaw)), f32(cos(w.yaw))) * f32(w.speed * dt))
        if np == w.pos:
            w.wait = random(0.5, 3.0)            # stuck: pause, then go somewhere else
        w.pos = np
        w.phase += dt * w.speed * 5.5

# ---------------- update ----------------

# by one's own aircraft, at rest on the water or moored
# the wind as a velocity (for cloth)
wind_now_vec = () -> vec3: vec3(wind_now.dir.x, 0, wind_now.dir.y) * f32(wind_now.speed)

near_own_craft = () -> bool:
    d = f64(length(vec2(pc.state.position.x - me.pos.x, pc.state.position.z - me.pos.z)))
    d < 8.5 and (pc.state.moored or length(pc.state.velocity) < 1.0)

rope: Rope
was_moored = false
talk_at_start = env("AEGEAN_TALK") != none
click_took_mouse = false            # (the left button's press that took the mouse, until let go)

# Cargo is saved living-world stock; the notebook only projects its current handling status.
notebook = load_notebook()

# who at a job's destination is waiting for it: whoever it is for, if they live there, else the
# harbor's merchant
recipient_of = (id: int) -> int:
    j = living_world.jobs[id]
    b = j.cause.beneficiary
    if b >= 0 and b < living_world.people.len() and living_world.people[b].home == j.destination: return b
    living_world.places[j.destination].market_owner

# what a job carries, in a few words
job_cargo = (id: int) -> str:
    j = living_world.jobs[id]
    if j.purpose == .passenger: return living_world.people[j.passenger].name
    if j.cargo_mode == .sealed: return "the sealed bag"
    "the {living_world.goods[j.good].key}"

holding_cargo = () -> int: living_world.people[living_world.player].carrying

near_job_cargo = () -> int: cargo_view.nearest_cargo(living_world,living_world.player)

# The same published handling terms can be agreed at the board or with the sender.
agree_cargo_job = (id: int, choice: lt.CarriageChoice) -> str:
    j = living_world.jobs[id]
    if j.delivery_mode == .aircraft and not pc.state.moored: return "Bring your aircraft alongside a quay here first."
    if not living.take_job(living_world,id,living_world.player,choice): return "The job is unavailable, the hold is reserved, or the journey cannot be made in time."
    my_jobs[id] = lt.JobState.claimed
    rcv = living_world.people[recipient_of(id)].name
    status = portage.cargo_status(living_world,id)
    pin_notice(notebook,id,j.poster,"{job_cargo(id)} to {rcv}","By {clock_text(living_world,j.due_minute)}; {f64(living_world.jobs[id].reward_cents)/100.0:.2} lire. From {living_world.people[j.poster].name}.",clock_text(living_world,living_world.minute))
    log_note(notebook,"Agreed to {if j.delivery_mode == .foot: "carry" else: "fly"} {job_cargo(id)} for {rcv}. {status}",clock_text(living_world,living_world.minute))
    status

# F has one meaning per press: pick up, set down/load, or (with empty hands) board.
cargo_interact = () -> bool:
    actor = living_world.player
    held = holding_cargo()
    if held >= 0:
        c = living_world.cargo[held]
        aboard = false
        if c.job >= 0 and c.job in living_world.jobs:
            j = living_world.jobs[c.job]
            point = portage.cargo_loading_spot(living_world,living_world.people[actor].craft)
            aboard = j.delivery_mode == .aircraft and not j.loaded and point != none and length(me.pos-point!) < 4
        if c.job < 0:
            point = portage.cargo_loading_spot(living_world,living_world.people[actor].craft)
            aboard = point != none and length(me.pos-point!) < 4 and c.store != .aircraft
        if portage.cargo_put_down(living_world,actor,aboard):
            if c.job >= 0:
                if aboard: claims.load_job(living_world,c.job)
                if living_world.jobs[c.job].collected: living.deliver_job(living_world,c.job,actor)
            say_toast(if aboard: "Put {cargo_view.cargo_label(living_world,c)} into the hold" else: "Set down {cargo_view.cargo_label(living_world,c)}")
            log_note(notebook,if aboard: "Loaded {cargo_view.cargo_label(living_world,c)} into the aircraft." else: "Set down {cargo_view.cargo_label(living_world,c)} at {me.pos.x:.0}, {me.pos.z:.0}.",clock_text(living_world,living_world.minute))
        return true
    id = near_job_cargo()
    if id >= 0:
        if portage.cargo_pick_up(living_world,actor,id): say_toast("Carrying {cargo_view.cargo_label(living_world,living_world.cargo[living_world.people[actor].carrying])}; F to put it down")
        else: say_toast("It cannot be picked up now: it is too heavy or someone is handling it")
        return true
    false

# guns, cloth, debugging
guns = Guns()
splashes: Splash[]
dust_ps = Particles3D(gravity = vec3(0, -9.8, 0), drag = 1.2)
cloth_mesh: ClothMesh
scarf_mesh: ClothMesh
dbg = Debug()
# AEGEAN_TWEAKS="pure,curve,grip,airframe,cloth,trim,orbit" switches trials on from the start
if let tw = env("AEGEAN_TWEAKS"):
    loop name in split(tw, ","):
        match name:
            "pure": dbg.tweaks.pure_scale = true
            "curve": dbg.tweaks.true_curve = true
            "grip": dbg.tweaks.quick_grip = true
            "airframe": dbg.tweaks.airframe_true = true
            "cloth": dbg.tweaks.cloth_true = true
            "trim": dbg.tweaks.auto_trim = true
            "orbit": dbg.tweaks.orbit_camera = true
            _: pass
    set_tweaks(dbg.tweaks)
wind_bias = 0.0
set_touch_pad(touch_device() or env("AEGEAN_TOUCH") != none)
last_shots = 0
# (going into the water hard: how far under the aircraft is driven, and how fast, on a spring that
# brings it back up; drawn, not simulated)
plunge = 0.0
plunge_v = 0.0
MUZZLES: vec3[] = [vec3(-2.7, 1.7, -1.3), vec3(2.7, 1.7, -1.3)]

# a new aircraft of another kind for the player, where the old one is (moored where it was moored)
change_craft = (kind: Craft, model: int):
    global pc
    record = living_world.people[living_world.player].craft
    a = lt.AIRFRAMES[int(kind)]
    if craft_grams(living_world,record) > a.cargo_grams or living_world.aircraft[record].passengers.len() > a.seats:
        say_toast("Unload cargo and passengers before changing to this aircraft")
        return
    old = pc.state
    nf = make_flyer(kind, model, craft_models[model].contacts, old.position - vec3(0, f32(pc.spec.float_height), 0), heading(old))
    if not old.moored:
        unmoor(nf.state)
        nf.state.position = old.position
        nf.state.velocity = old.velocity
        nf.state.orientation = old.orientation
        nf.state.on_water = old.on_water
        nf.state.water_age = old.water_age
        nf.throttle = pc.throttle
    # (the camera stays where it was: the new aircraft takes over the old one's)
    nf.cam_pos = pc.cam_pos; nf.look = pc.look; nf.look_v = pc.look_v; nf.cam_up = pc.cam_up; nf.roll = pc.roll
    nf.path = pc.path; nf.cam_e = pc.cam_e; nf.cam_ev = pc.cam_ev; nf.cam_lh = pc.cam_lh; nf.fov = pc.fov
    nf.prev_vel = pc.prev_vel; nf.acc_lp = pc.acc_lp; nf.prev_dir = pc.prev_dir
    nf.placed = pc.placed
    nf.spec.player = true
    nf.spec.fuel_capacity = f64(a.tank_ml)/1000.0
    nf.spec.fuel_burn = f64(a.burn_ml_sec)/1000.0
    nf.state.fuel = min(old.fuel,nf.spec.fuel_capacity)
    living_world.aircraft[record].kind = lt.Airframe(int(kind))
    living_world.aircraft[record].model_index = model
    living_world.aircraft[record].livery_index = DEFAULT_LIVERIES[int(kind)]
    living_world.aircraft[record].fuel_ml = int(nf.state.fuel*1000.0)
    living_world.aircraft[record].scene_extension = ""
    living_world.aircraft[record].scene_extension_tick = -1
    living_world.aircraft[record].revision += 1
    pc = nf
    ci=combat_index(battle,record)
    if ci>=0:battle.actors[ci]=Combatant(record,living_world.player,0,nf.spec,nf.state,external=true,human=true,previous=nf.state.position,model=model)

# paused (or not): the pause menu is the debugging panel
set_paused = (on: bool):
    global paused, show_chart
    paused = on
    dbg.open = on
    if dbg.picking: show_chart = false
    dbg.picking = false
    if on: mouse_lock(false)

# the speed scale changed: every aircraft's spec made again for it (keeping its fuel figures), and
# the world's trips and traffic paced to it
apply_speed_scale = (k: f64):
    set_speed_scale(k)
    lt.scale_airframes(k)
    old = pc.spec
    pc.spec = craft_spec(pc.kind, craft_models[pc.model].contacts)
    pc.spec.player = true
    pc.spec.fuel_capacity = old.fuel_capacity
    pc.spec.fuel_burn = old.fuel_burn
    loop i in 0..traffic.len():
        o = traffic[i].spec
        traffic[i].spec = craft_spec(traffic[i].kind, craft_models[traffic[i].model].contacts)
        traffic[i].spec.fuel_capacity = o.fuel_capacity
        traffic[i].spec.fuel_burn = o.fuel_burn

# the debugging panel: how things are now, for it to show and change
debug_view = () -> DebugView:
    v = DebugView()
    v.craft = pc.model
    v.fuel = pc.state.fuel / max(pc.spec.fuel_capacity, 0.001)
    v.parts = [loop k in 0..pc.spec.parts.len(): part_health(pc.state.damage, pc.spec.parts[k].id)]
    c = living_world.people[living_world.player].craft
    if c >= 0:
        v.hull_wear = 1.0 - f64(living_world.aircraft[c].hull) / 1000.0
        v.engine_wear = 1.0 - f64(living_world.aircraft[c].engine) / 1000.0
    v.hour = hour
    v.wind = wind_bias
    v.wind_now = wind_now.speed
    v.lire = player_cents() / 100
    v.speed_scale = speed_scale
    v.lift_scale = lift_scale
    v.bullet_scale = bullet_scale
    v.sea_rough = sea_rough
    v

# the debugging panel's fuel and money, entered in the living world's books (fuel made or spent,
# money brought in from or sent out of the world) so its conservation checks still hold
debug_fuel_ml = (c: int, ml: int):
    if c < 0: return
    cap = lt.AIRFRAMES[int(living_world.aircraft[c].kind)].tank_ml
    want = clamp(ml, 0, cap)
    d = want - living_world.aircraft[c].fuel_ml
    if d > 0: living_world.goods_ledger.created[int(lt.GoodKind.fuel)] += d
    else: living_world.goods_ledger.consumed[int(lt.GoodKind.fuel)] += -d
    living_world.aircraft[c].fuel_ml = want
    living_world.aircraft[c].revision += 1

debug_cents = (cents: int):
    a = living_world.people[living_world.player].account
    if a < 0: return
    want = max(0, cents)
    d = want - living_world.accounts[a].cents
    if d > 0: living_world.ledger.external_in_cents += d
    else: living_world.ledger.external_out_cents += -d
    living_world.accounts[a].cents = want

# put the aircraft in the air (or on the water, at 0 m) at x, z
debug_place = (x: f64, z: f64, alt: f64):
    h = heading(pc.state)
    unmoor(pc.state)
    if alt < 5.0:
        if surface_height(x, z) > 0.0:
            say_toast("That's land there: give it some altitude")
            return
        pc.state = water_start(pc.spec, vec3(f32(x), 0, f32(z)), h)
        pc.throttle = 0.0
    else:
        ground = max(surface_height(x, z), 0.0)
        pc.state.position = vec3(f32(x), f32(max(alt, ground + 40.0)), f32(z))
        pc.state.velocity = heading_vector(h) * f32(pc.spec.cruise_speed)
        pc.state.orientation = quat_euler(0, -h, 0)
        pc.state.angular_velocity = vec3(0, 0, 0)
        pc.state.on_water = false
        pc.state.water_age = 1.0
        pc.state.crashed = false
        pc.throttle = 0.8
    pc.aim_heading = h
    pc.aim_climb = 0.0
    pc.placed = false
    me.mode = .aboard

# what the debugging panel changed or asked for
debug_apply = (was: DebugView, v: DebugView, r: DebugResult):
    global hour, wind_bias
    c = living_world.people[living_world.player].craft
    if v.craft != was.craft:
        kind = Craft(clamp(v.craft, 0, CRAFT_NAMES.len() - 1))
        change_craft(kind, default_craft_model(kind))
        return
    if abs(v.fuel - was.fuel) > 0.0001:
        pc.state.fuel = v.fuel * pc.spec.fuel_capacity
        debug_fuel_ml(c, int(pc.state.fuel * 1000.0))
    st = pc.state
    loop k in 0..min(v.parts.len(), was.parts.len()):
        if abs(v.parts[k] - was.parts[k]) < 0.0001: continue
        id = pc.spec.parts[k].id
        i = int(id)
        if v.parts[k] <= 0.0:
            detach_part(pc.state.damage, pc.spec.parts, id, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        else:
            if not pc.state.damage.parts[i].attached:
                # (put back: its wreckage gone from the water)
                pc.state.damage.parts[i].attached = true
                pc.state.damage.debris = [loop db in pc.state.damage.debris if db.part != id: db]
            pc.state.damage.parts[i].health = v.parts[k]
    if c >= 0:
        if abs(v.hull_wear - was.hull_wear) > 0.0001: living_world.aircraft[c].hull = int((1.0 - v.hull_wear) * 1000.0 + 0.5)
        if abs(v.engine_wear - was.engine_wear) > 0.0001: living_world.aircraft[c].engine = int((1.0 - v.engine_wear) * 1000.0 + 0.5)
    if abs(v.hour - was.hour) > 0.0001: hour = v.hour % 24.0
    wind_bias = v.wind
    if abs(v.speed_scale - was.speed_scale) > 0.0001: apply_speed_scale(max(1.0, v.speed_scale))
    if abs(v.lift_scale - was.lift_scale) > 0.0001: set_lift_scale(v.lift_scale)
    if abs(v.bullet_scale - was.bullet_scale) > 0.0001: set_bullet_scale(v.bullet_scale)
    if abs(v.sea_rough - was.sea_rough) > 0.0001: set_sea_rough(v.sea_rough)
    match r.act:
        .repair:
            pc.state.damage = DamageState()
            pc.state.crashed = false
            pc.state.capsized = false
            pc.state.hull_damage = 0.0
            pc.state.engine_damage = 0.0
            if c >= 0:
                living_world.aircraft[c].hull = 1000
                living_world.aircraft[c].engine = 1000
        .wreck: detach_part(pc.state.damage, pc.spec.parts, .body, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        .money_add: debug_cents(player_cents() + 100000)
        .money_set: debug_cents(r.lire * 100)
        .to_altitude:
            p0 = if me.mode == .aboard: pc.state.position else: me.pos
            debug_place(f64(p0.x), f64(p0.z), dbg.altitude)
            set_paused(false)
        .pick:
            global show_chart
            dbg.picking = true
            dbg.open = false
            show_chart = true
        .to_town:
            tw = towns[r.town]
            dock = free_dock(tw, others_at(), tw.center) ?? tw.docks[0]
            h = atan2(f64(tw.out.x), -f64(tw.out.y))
            pc.state = water_start(pc.spec, dock, h)
            moor(pc.state, pc.state.position, h)
            pc.throttle = 0.0
            pc.placed = false
            tie_up()
            if me.mode != .aboard: step_ashore(dock)
            set_paused(false)
        _: pass

    # An explicit debug repair/part edit changes the authoritative physical body too.
    ci=combat_index(battle,c)
    if ci>=0:
        battle.actors[ci].state=pc.state
        if r.act==.repair:
            battle.actors[ci].fire=0;battle.actors[ci].fire_age=0
            battle.actors[ci].marks.clear();battle.actors[ci].last_attacker=-1
            battle.actors[ci].down_reported=false
            if not battle.actors[ci].bailed:battle.actors[ci].status=.flying

# (each kind's engine its own pitch, the bigger lower; each aircraft a touch its own)
engine_tone = (kind: Craft, craft: int) -> f64:
    base = aircraft_profile(kind).tone
    base * (1.0 + 0.03 * f64((craft * 37) % 7 - 3) / 3.0)

# the other aircraft's places (for keeping docks free)
# where every other aircraft is or is bound: those flying about, every one the world has tied up
# anywhere (drawn or not), and the docks claimed by those on their way in
others_at = () -> vec3[]:
    out = [loop tr in traffic: tr.state.position]
    mine = living_world.people[living_world.player].craft
    loop c in 0..living_world.aircraft.len():
        if c != mine: out.push(living_world.aircraft[c].pose.pos)
    loop id in living_world.active_trips:
        tp = living_world.trips[id]
        if tp.craft != mine and tp.claimed_dock >= 0: out.push(living_world.harbors[tp.destination].docks[tp.claimed_dock])
    out

# tie up at the bollard nearest the aircraft
tie_up = ():
    global was_moored
    if let b = nearest_bollard(towns, pc.state.position):
        rope.anchor = b
        rope.tied = true
        rope.loose = b
        was_moored = true

# where the player's aircraft is tied: the bollard its line is on (none: not moored)
mooring_anchor = () -> vec3?:
    if pc.state.moored and rope.tied: return rope.anchor
    if not pc.state.moored: return none
    p = vec2(pc.state.position.x, pc.state.position.z)
    best: vec3? = none
    bd = 40.0
    loop tw in towns:
        if length(vec2(tw.center.x, tw.center.z) - p) > 600.0: continue
        loop q in tw.quays:
            d = q.b - q.a
            u = clamp(dot(p - q.a, d) / dot(d, d), 0.0, 1.0)
            c = q.a + d * u
            off = p - c
            l = f64(length(off))
            if l < bd and l > 0.01:
                bd = l
                e = c + off / f32(l) * (q.width * 0.5 - 0.4)
                best = vec3(e.x, f32(QUAY_TOP + 0.5), e.y)
    best

# haul the line in a little: the aircraft comes alongside (to a few meters off the quay's edge)
haul_in = (dt: f64):
    if let a = mooring_anchor():
        p = pc.state.position
        off = vec3(p.x - a.x, 0, p.z - a.z)
        l = f64(length(off))
        if l > 3.6:
            step = min(1.4 * dt, l - 3.6)
            np = p - off / f32(l) * f32(step)
            pc.state.position = np
            pc.state.mooring_point = np

# off the aircraft onto the quay beside a dock (or the nearest walkable ground)
step_ashore = (near: vec3):
    best = me.pos
    found = false
    loop r in [5.0, 8.0, 12.0, 18.0]:
        loop k in 0..16:
            a = f64(k) / 16.0 * TAU
            c = near + vec3(f32(cos(a) * r), 0, f32(sin(a) * r))
            h = walk_height(towns, f64(c.x), f64(c.z))
            if h > 0.5 and not found:
                best = vec3(c.x, f32(h), c.z)
                found = true
    if found:
        me.pos = best
        me.mode = .walking
        follow.placed = false

update = (dt: f64):
    global t, hour, show_chart, chart_local, pc, ui, ui_folk, ui_line, ui_news, ui_place, paused, descent_camera, vessel_mooring, was_moored
    # (the touch screen's stick and buttons, read as keys below; mode: 0 flying, 1 on the water,
    # 2 on foot, 3 a panel open)
    # (AEGEAN_TALK: a conversation with the nearest person opens at the start, for looking at it)
    if talk_at_start and t > 1.0 and ui == .none and me.mode == .walking:
        global talk_at_start, ui_turn
        talk_at_start = false
        k0 = nearest_folk(folks, me.pos, 1000000.0)
        if k0 >= 0:
            ui = .talk
            ui_folk = k0
            ui_turn = living.talk(living_world, folks[k0].person, .greeting, living_world.player)
            ui_line = turn_text(ui_turn)
    pad_mode = if paused or ui != .none or notebook.open or show_chart: 3 else if me.mode == .aboard: (if pc.state.on_water or pc.state.moored: 1 else: 0) else: 2
    update_pad(pad_mode, not pc.slow, me.mode == .aboard and (pc.state.crashed or pc.state.capsized or pc.state.beached))
    # P (or F1) stops the world and its sounds, and opens the pause menu (the debugging panel)
    if (vpressed(.p) or vpressed(.f1)) and not notebook.open and not ui_typing() and not debug_typing(): set_paused(not paused)
    if show_chart and geography_enabled and vpressed(.tab): chart_local = not chart_local
    if paused:
        hush_audio(audio)
        hush_combat_audio(combat_audio)
        hush_engines(hearing)
        # (picking a place on the chart from the pause menu; Escape gives up)
        if dbg.picking and show_chart and mouse_pressed(.left):
            if let q = chart_place(mouse_pos()):
                debug_place(f64(q.x), f64(q.y), dbg.altitude)
                set_paused(false)
        if dbg.picking and (vpressed(.escape) or vpressed(.m)):
            dbg.picking = false
            dbg.open = true
            show_chart = false
        return
    let dt = clamp(dt, 0.0, 0.25)
    t += dt
    wind_step(wind_now, t, dt, hour)
    hour = (hour + dt / 120.0 + 24.0) % 24.0          # an hour of the day: two minutes
    typing = ui_typing() or debug_typing()
    if vdown(.n1) and not typing: hour = (hour - dt * 2.0 + 24.0) % 24.0
    if vdown(.n2) and not typing: hour = (hour + dt * 2.0) % 24.0
    if vpressed(.m) and not typing: show_chart = not show_chart
    if vpressed(.escape): mouse_lock(false)
    # (a click takes the mouse for the camera only when no panel is open to be clicked)
    if mouse_pressed(.left) and me.mode != .free and ui == .none and not notebook.open and not dbg.open and not show_chart and not is_mouse_locked():
        mouse_lock(true)
        global click_took_mouse
        click_took_mouse = true             # (that click only takes the mouse: it doesn't fire)
    if not mouse_down(.left):
        global click_took_mouse
        click_took_mouse = false
    if vpressed(.j) and not notebook.open and ui == .none and not typing:
        notebook.open = true
        mouse_lock(false)
    if vpressed(.f2) and not typing: me.mode = if me.mode == .free: Mode.walking else: Mode.free
    player_combat=combat_index(battle,living_world.people[living_world.player].craft)
    if player_combat>=0:battle.actors[player_combat].pilot.trigger=false
    match me.mode:
        .free: free.update(dt)
        .walking:
          if ui != .none: update(follow, me.pos, dt)
          if ui == .none and not notebook.open:
              follow.distance = clamp(follow.distance * pow(0.93, clamp(mouse_wheel(), -3.0, 3.0)), 2.5, 14.0)
              if vdown(.q): follow.yaw += dt * 2.0
              if vdown(.e): follow.yaw -= dt * 2.0
              a = input_axis() + pad.stick
              if length(a) > 1.0: a = normalize(a)
              # (a finger dragging on the right half turns the view, as the mouse does)
              follow.yaw -= f64(pad.look.x) * 0.006
              follow.pitch = clamp(follow.pitch + f64(pad.look.y) * 0.004, follow.min_pitch, follow.max_pitch)
              move = flat_forward(follow) * -a.y + flat_right(follow) * a.x
              run = vdown(.shift)
              speed = if holding_cargo() >= 0: 1.0 else: if run: 4.2 else: 1.7
              if length(move) > 0.1:
                  dir = normalize(vec2(move.x, move.z))
                  me.yaw = approach_angle(me.yaw, atan2(f64(dir.x), f64(dir.y)), 10.0, dt)
                  me.pos = walk_step(towns, me.pos, dir * f32(speed * dt))
                  me.stride = approach(me.stride, if run: 1.0 else: 0.7, 8.0, dt)
                  me.phase += dt * speed * 5.0
              else:
                  me.stride = approach(me.stride, 0.0, 8.0, dt)
              update(follow, me.pos, dt)
              portage.cargo_person_pose(living_world,living_world.player,me.pos)
              living_world.people[living_world.player].pose.rot = lt.facing(vec3(f32(sin(me.yaw)),0,f32(cos(me.yaw))))
              if vdown(.f) and holding_cargo() < 0 and not near_own_craft() and pc.state.moored:
                  if let a = mooring_anchor():
                      if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: haul_in(dt)
              # talk to whoever is near; read the board
              cargo_used = vpressed(.f) and cargo_interact()
              if vpressed(.t):
                  k = nearest_folk(folks, me.pos, 3.5)
                  if k >= 0:
                      ui = .talk
                      ui_folk = k
                      global ui_turn
                      ui_turn = living.talk(living_world, folks[k].person, .greeting, living_world.player)
                      ui_line = turn_text(ui_turn)
                      # (someone whose cargo one has brought sees it)
                      loop id in living_world.active_jobs:
                          j = living_world.jobs[id]
                          if j.state == .claimed and j.carrier == living_world.player and j.loaded and j.destination == folks[k].place and recipient_of(id) == folks[k].person:
                              ui_line = "Is that {job_cargo(id)} from {living_world.people[j.poster].name}?"
                      ui_news = 0
                      mouse_lock(false)
              if vpressed(.f) and not cargo_used and not near_own_craft() and near_board() >= 0:
                  ui = .board
                  ui_place = near_board()
                  mouse_lock(false)
              if vpressed(.f) and not cargo_used and holding_cargo() < 0 and near_own_craft():
                  me.mode = .aboard
                  mouse_lock(true)
                  pc.placed = false
                  pc.throttle = 0.0
        .descent:
            loop mut d in battle.descents:
                if d.person!=living_world.player or d.released:continue
                move=input_axis()
                d.steering=flat_forward(descent_camera)*-move.y+flat_right(descent_camera)*move.x
                d.open_requested=vpressed(.t)
                me.pos=d.position
                if d.phase==.swimming:descent_camera.height=1.2;descent_camera.distance=7.0
                update(descent_camera,me.pos,dt)
                if d.phase==.landed:
                    me.mode=.walking;d.released=true;follow.placed=false
        .aboard:
            if vpressed(.v) and not typing:pc.cockpit_view=not pc.cockpit_view
            if vpressed(.x) and not typing:pc.gear_down=not pc.gear_down
            protected=pc.state.moored
            loop tw in towns:
                if length(pc.state.position-tw.center)<1200 and pc.state.position.y<300:protected=true
            gun_safety(pc,protected,vpressed(.g) and not typing)
            ci=combat_index(battle,living_world.people[living_world.player].craft)
            if vpressed(.t) and not typing and not pc.state.moored and ci>=0:
                battle.actors[ci].state=pc.state
                if bail_combatant(battle,ci):
                    me.mode=.descent;pc.cockpit_view=false
                    if combat_audio.guns.len()>0:combat_audio_events(combat_audio,[battle.events[battle.events.len()-1]],scene_camera())
                    me.pos=battle.descents[battle.descents.len()-1].position;follow.placed=false
                    descent_camera=follow_camera(distance=14.0,yaw=-heading(pc.state),pitch=0.18,height=3.5)
                    update(descent_camera,me.pos,dt)
            before = pc.state.velocity
            set_drag_scale(if dbg.no_drag: 0.0 else: 1.0)
            previous_vessel_contact = pc.state.position
            if me.mode==.aboard:fly(pc, dt, t)
            if not dbg.no_damage: collide_vessels(vessels,pc.spec,pc.state,previous_vessel_contact,living_world.people[living_world.player].craft)
            set_drag_scale(1.0)
            # into the water hard (falling fast): a column of spray thrown up all round, and the
            # aircraft driven under in the blink of an eye, to bob back up
            global plunge, plunge_v
            down = -f64(before.y)
            if down > 15.0 and abs(plunge) < 0.5 and plunge_v > -1.0:
                loop ev in pc.state.damage.events:
                    if ev.kind == .splash:
                        q = vec3(ev.position.x, f32(swell_at(f64(ev.position.x), f64(ev.position.z), t).x), ev.position.z)
                        plunge_v = -min(down, 90.0) * 0.7
                        emit(spray_ps, q, 220, 16.0 + down * 0.3, rgba(0.97, 0.99, 1.0, 0.95), 2.4, 1.8, 0.28, vec3(0, 1, 0))
                        emit(spray_ps, q, 120, 9.0 + down * 0.12, rgba(0.93, 0.97, 1.0, 0.85), 1.8, 1.2, 1.3, vec3(0, 1, 0))
                        break
            plunge_v += (-(2.6 * plunge) - 2.2 * plunge_v) * dt
            plunge += plunge_v * dt
            if abs(plunge) < 0.01 and abs(plunge_v) < 0.05:
                plunge = 0.0
                plunge_v = 0.0
            # the guns: Space in the air, or the left button once the game has the mouse
            # (not while slow, with the mouse orbiting the camera)
            held = (not tweaks.orbit_camera or not pc.slow) and ((vdown(.space) and not pc.state.on_water) or (mouse_down(.left) and is_mouse_locked() and not click_took_mouse))
            if ci>=0:
                battle.actors[ci].pilot.trigger=held and me.mode==.aboard and not pc.state.crashed
                battle.actors[ci].gun.locked=pc.guns_locked
            if trace and floor(t) != floor(t - dt):
                st = pc.state
                f = quat_rotate(st.orientation, vec3(0, 0, -1))
                print("t {t:.0} spd {length(st.velocity):.1} alt {st.position.y:.1} pitch {asin(f64(f.y)) * 57.3:.0} aoa {st.aoa * 57.3:.0} thr {st.throttle:.2} water {st.on_water} stall {st.stalled} crash {st.crashed} cap {st.capsized} hull {st.hull_damage:.2}")
            chase(pc, dt)
            spray(pc, craft_models, spray_ps)
            # what the aircraft hit: a splash, a crunch, parts tearing away; seen, heard and felt
            loop ev in pc.state.damage.events:
                hard = clamp(log(1.0 + ev.strength / 2000.0) / 6.0, 0.0, 1.0)
                if hard < 0.05: continue
                crunch = ev.kind != .splash
                n = int(6.0 + 60.0 * hard)
                emit(spray_ps, ev.position, n, 4.0 + 14.0 * hard, rgba(0.96, 0.98, 1.0, 0.9), 1.4, 0.6 + 0.8 * hard, 0.9, normalize(ev.normal + vec3(0, 1, 0)))
                if crunch: emit(spray_ps, ev.position, n / 2, 6.0 + 10.0 * hard, rgba(0.42, 0.3, 0.2, 1), 1.8, 0.25, PI, vec3(0, 1, 0))
                impact_sound(audio, ev.position, crunch, hard)
                # (the camera feels it: a jolt in its spring)
                pc.cam_ev += normalize(ev.impulse + vec3(0, 0.001, 0)) * f32(-3.0 * hard)
            vapor(pc, vapor_trails, hour, t)
            if vpressed(.f):
                if let ship_mooring = find_vessel_mooring(vessels,pc.state,pc.spec.span):
                    vessel_mooring = ship_mooring
                    if let point = vessel_mooring_point(vessels,vessel_mooring,pc.spec.span):
                        moor(pc.state,vec3(point.x,f32(pc.spec.float_height),point.z),heading(pc.state))
                        pc.throttle = 0.0
                        rope.tied = true; rope.anchor = point; was_moored = true
                else if let d0 = mooring_spot(pc, towns):
                  if dock_taken(d0, others_at()): say_toast("That dock is taken")
                  else:
                    d = d0
                    moor(pc.state, vec3(d.x, f32(pc.spec.float_height), d.z), heading(pc.state))
                    pc.throttle = 0.0
                    tie_up()
                    step_ashore(d)
                    th = town_here(d)
                    if th >= 0: deliver_here(th)
                else if pc.state.moored and vessel_mooring.vessel < 0: step_ashore(pc.state.position)
            if vpressed(.r) and (pc.state.crashed or pc.state.capsized or pc.state.beached):
                # towed home to a free dock and patched up (the bill comes later)
                dock = free_dock(home, others_at(), home.docks[0]) ?? home.docks[0]
                pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, dock, along_quay)
                ci=combat_index(battle,living_world.people[living_world.player].craft)
                if ci>=0:battle.actors[ci]=Combatant(battle.actors[ci].craft,living_world.player,0,pc.spec,pc.state,external=true,human=true,previous=pc.state.position,model=pc.model)
                pc.placed = false
                tie_up()
    if was_moored and not pc.state.moored and rope.tied:
        was_moored = false
        off = vec3(pc.state.position.x - rope.anchor.x, 0, pc.state.position.z - rope.anchor.z)
        rope.loose = rope.anchor + normalize(off + vec3(0.001, 0, 0)) * 3.0
    if not rope.tied and pc.state.moored: tie_up()
    dust_ps.update(dt)
    # debugging: F1 opens the panel; its standing switches
    if dbg.infinite_fuel:
        pc.state.fuel = pc.spec.fuel_capacity
        debug_fuel_ml(living_world.people[living_world.player].craft, int(pc.spec.fuel_capacity * 1000.0))
    if dbg.no_damage and not pc.state.crashed:
        loop k in 0..pc.state.damage.parts.len():
            if pc.state.damage.parts[k].attached: pc.state.damage.parts[k].health = 1.0
    wind_now.speed = max(0.0, wind_now.speed + wind_bias)
    update_walkers(dt)
    # the errands one carries: told, and written in the log, when they are done or missed
    loop id, was in my_jobs:
        if not (id in living_world.jobs): continue
        j = living_world.jobs[id]
        if j.state == was: continue
        my_jobs[id] = j.state
        rcv = living_world.people[recipient_of(id)].name
        dest = SETTLEMENTS[j.destination].name
        now = clock_text(living_world, living_world.minute)
        match j.state:
            .delivered:
                say_toast("Delivered: {job_cargo(id)} to {rcv} at {dest}, {j.paid_cents / 100} lire")
                log_note(notebook, "Delivered {job_cargo(id)} to {rcv} at {dest}. Paid {j.paid_cents / 100} lire{if j.paid_cents < j.reward_cents: " (late)" else: ""}.", now)
            .failed:
                say_toast("The errand failed: {job_cargo(id)} for {rcv} at {dest}")
                log_note(notebook, "Failed: {job_cargo(id)} for {rcv} at {dest}.", now)
            .expired:
                say_toast("Too late: {job_cargo(id)} for {rcv} at {dest}")
                log_note(notebook, "Too late for {rcv} at {dest}: {job_cargo(id)}.", now)
            .cancelled:
                log_note(notebook, "Called off: {job_cargo(id)} for {rcv} at {dest}.", now)
            _: pass
    notebook.live = [loop id in my_jobs.keys(): if id in living_world.jobs and living_world.jobs[id].state == .claimed: "{job_cargo(id)}: {portage.cargo_status(living_world,id)}"]
    if t - folk_sync_t > 2.0:
        sync_folk(folks, living_world, towns)
        global folk_sync_t
        folk_sync_t = t
    step_sea_navigation(vessels,if render_quality.tier == 0: 32 else: 64)
    step_vessels(vessels,wind_now.dir*f32(wind_now.speed),dt)
    if vessel_mooring.vessel >= 0:
        point = vessel_mooring_point(vessels,vessel_mooring,pc.spec.span)
        if not pc.state.moored or point == none:
            vessel_mooring = VesselMooring(); rope.tied = false
            if pc.state.moored: unmoor(pc.state)
        else:
            pc.state.position = vec3(point!.x,f32(pc.spec.float_height),point!.z)
            k = vessel_index(vessels,vessel_mooring.vessel)
            pc.state.velocity = vessels.ships[k].velocity
            spec = vessel_spec(vessels.ships[k].kind)
            right = vec3(f32(cos(vessels.ships[k].yaw)),0,f32(-sin(vessels.ships[k].yaw)))
            rope.anchor = point!-right*f32(vessel_mooring.side*(pc.spec.span*0.55+3.0))+vec3(0,f32(spec.deck),0)
    publish_vessel_targets(vessels,battle,vessel_bindings,if me.mode == .aboard: pc.state.position else: me.pos)
    battle.bullet_scale=bullet_scale
    pci=combat_index(battle,living_world.people[living_world.player].craft)
    if pci>=0:
        battle.actors[pci].spec=pc.spec
        if (pc.state.moored or dbg.no_damage) and not battle.actors[pci].bailed:
            if pc.state.moored:sync_living_player(pc,living_world)
            battle.actors[pci].state=pc.state
            if dbg.no_damage:battle.actors[pci].fire=0;battle.actors[pci].fire_age=0
    update_traffic(traffic,living_world,traffic_scene,if me.mode==.aboard:pc.state.position else:me.pos,t,dt,pc.state,towns,battle,
        (events:CombatEvent[]):
            combat_effect_events(combat_visual,events)
            if combat_audio.guns.len()>0:combat_audio_events(combat_audio,events,scene_camera())
        ,(craft: int,spec: CraftSpec,state: CraftState,previous: vec3) -> CraftState:
            result = state
            collide_vessels(vessels,spec,result,previous,craft)
            result
    )
    receive_vessel_hits(vessels,battle,vessel_bindings)
    sync_workboat_vessels(vessels,vessel_bindings,living_world,dt)
    ci=combat_index(battle,living_world.people[living_world.player].craft)
    if ci>=0:
        pc.state.damage=battle.actors[ci].state.damage
        refresh_damage(pc.spec,pc.state)
        if battle.actors[ci].bailed:pc.state=battle.actors[ci].state
    # Combat parts already supplied this tick's world condition; do not heal them through the
    # older nonlinear wear projection. Outside combat retain the existing service adapter.
    if ci<0 or (battle.actors[ci].last_attacker<0 and not battle.actors[ci].bailed):sync_living_player(pc,living_world)
    update_combat_view(combat_visual,battle,wind_now_vec(),dt,scene_camera())
    if combat_audio.guns.len()>0:update_combat_audio(combat_audio,battle,scene_camera(),living_world.player)
    update_folk(folks, living_world, towns, if me.mode == .aboard: pc.state.position else: me.pos, dt)
    # A contact/bark event commits words once; drawing the bubble only reads them.
    if me.mode == .walking and ui == .none:
        k = nearest_folk(folks,me.pos,7.0)
        if k >= 0 and t-folks[k].line_t > 20.0:
            folks[k].line = passing_line(living_world,folks[k].person)
            folks[k].line_t = t
    # skimming: fast within about a span of the water, the downwash churns it and throws spray
    gap = f64(pc.state.position.y) - pc.spec.float_height
    skim = if pc.state.on_water or pc.state.moored: 0.0 else: (1.0 - smoothstep(0.5, pc.spec.span * 0.6, gap)) * smoothstep(28.0, 60.0, f64(length(pc.state.velocity)) / pure_k(pc.spec))
    under = vec3(pc.state.position.x, 0.1, pc.state.position.z) - vec3(pc.state.velocity.x, 0, pc.state.velocity.z) * 0.15
    wake_step(wakes[0], under, pc.state.velocity, pc.state.on_water and not pc.state.moored, 1.6, t, skim)
    if skim > 0.1 and me.mode == .aboard: emit(spray_ps, under, int(1.0 + skim * 4.0), 3.0 + 6.0 * skim, rgba(0.96, 0.98, 1.0, f32(0.5 + 0.4 * skim)), 1.2, 0.5 + 0.6 * skim, 0.7, normalize(vec3(-pc.state.velocity.x, 30.0, -pc.state.velocity.z)))
    loop k in 0..traffic.len():
        tr = traffic[k]
        wake_step(wakes[k + 1], tr.state.position, tr.state.velocity, tr.state.on_water and not tr.state.moored, if tr.kind == .heron: 1.4 else: 1.6, t)
    if trace and floor(t / 10.0) != floor((t - dt) / 10.0):
        print("living minute {living_world.minute}, tick {living_world.tick}")
        loop tr in traffic: print("  craft {tr.craft} / {tr.name}: {if tr.flying: (if tr.materialized: str(tr.plan.phase) else: "abstract") else: "moored"} -> {towns[tr.town].name} at {tr.state.position.x:.0} {tr.state.position.y:.0} {tr.state.position.z:.0}; {tr.why}")
        loop id, trip in living_world.trips:
            if trip.state == .arrived: print("  committed arrival {id}: {living_world.people[trip.actor].name} at {towns[trip.destination].name}")
    spray_ps.update(dt)
    smoke_ps.update(dt)
    flying = me.mode == .aboard
    where = if flying: pc.state.position else: me.pos
    shore = abs(f64(surface_height(f64(where.x), f64(where.z)))) * 8.0 + (if flying: f64(where.y) * 2.0 else: 0.0)
    # (the sounds go by the speed as designed: true speed / the speed scale)
    update_audio(audio, dt, flying and not pc.state.moored, pc.state.throttle, if flying: true_speed(pc.spec, f64(length(pc.state.velocity))) else: 0.0, shore, not flying, where, pc.kind)
    life_audio.update_life_audio(life_sound,living_world,where,t)
    # the other aircraft's engines, heard from where their sound left them, Doppler and all
    hear_engines(hearing, [loop tr in traffic: EngineSource(tr.craft, tr.state.position, tr.state.velocity,
        if tr.flying and tr.state.throttle < 0.05: 0.7 else: f64(tr.state.throttle),
        not tr.state.moored and (tr.flying or tr.state.throttle > 0.02 or f64(length(tr.state.velocity)) > 0.5),
        engine_tone(tr.kind, tr.craft), true_speed(tr.spec, f64(length(tr.state.velocity))), voice = aircraft_profile(tr.kind).voice)], scene_camera(), if me.mode == .aboard: pc.state.velocity else: vec3(0, 0, 0), t)
    set_tweaks(dbg.tweaks)
    audio.air_on = dbg.snd_air
    audio.cloth_on = dbg.snd_cloth
    audio.frame_on = dbg.snd_frame
    if flying: airframe_sounds(audio, true_speed(pc.spec, f64(length(pc.state.velocity - wind_now_vec()))), if pc.state.on_water: 1.0 else: pc.load, true_speed(pc.spec, f64(length(pc.state.velocity - wind_now_vec()))), dt)
    else: airframe_sounds(audio, 0.0, 1.0, if me.mode == .walking: wind_now.speed else: 0.0, dt)
    # the grass around whoever is on foot (rebuilt as they go)
    if me.mode == .walking and (not grass.built or length(grass.center - me.pos) > 12.0):
        global grass
        grass = build_grass(towns, me.pos)

# ---------------- draw ----------------

craft_matrix = (m: Moored) -> mat4:
    bob = sin(t * 1.3 + f64(m.pos.x)) * 0.12
    roll = sin(t * 0.9 + f64(m.pos.z)) * 0.03
    translation(m.pos + vec3(0, f32(2.1 + bob), 0)) * rotation_y(m.yaw) * rotation_z(roll)

# where the player's aircraft is drawn: riding the swell when moored, driven under in a plunge
pc_at = () -> mat4: translation(vec3(0, f32(plunge), 0)) * (if pc.state.moored: afloat(pc.state.position, t) else: mat4()) * craft_transform(pc)

draw_world = (L: Light):
    if not legacy_clouds: draw_custom((): begin_cloud_depth())
    draw_custom(():
        bow = transform_point(afloat(pc.state.position, t) * craft_transform(pc), vec3(1.4, -1.9, -2.6))
        draw_rope(rope, pc.state.moored, bow, L, t))
    draw_custom((): draw_sky(L, t))
    draw_custom((): draw_far_sea(depth_tex, L, t, wind_now))
    draw_custom(():
        draw_ground(L, t)
        draw_world_terrain(L, t)
    )
    draw_custom(():
        draw_towns(towns, L, t)
        draw_world_towns(towns, L, t))
    cam_now = scene_camera()
    draw_custom(():
        prepare_vessel_view(vessel_view,vessels,cam_now,t,wind_now.dir*f32(wind_now.speed))
        draw_vessels(vessel_view,L,t)
        # and those tied up along the quays, riding the swell too
        loop tw in towns:
            if f64(length(tw.center - cam_now)) > 6000.0: continue
            loop b in tw.boats: draw(obj_sh, b.mesh, obj_params(L, t, afloat(b.at, t) * translation(b.at)))
    )
    draw_custom((): draw_birds(bird_mesh, flocks, L, t))
    draw_custom(():
        draw_groves(tree_meshes, groves, L, t)
        draw_world_groves(tree_meshes,L,t))
    draw_custom(():
        loop m in moored:
            cm = craft_models[m.model]
            at = craft_matrix(m)
            draw(obj_sh, cm.body, obj_params(L, t, at))
            draw_craft_props(cm, L, t, at, 0.4)
            draw_craft_gear(cm, L, t, at)
        draw_folk(folks, L, t)
        life_view.draw_life(living_world,life_meshes,L,t)
        cargo_view.draw_cargo(living_world,cargo_meshes,L,t)
        loop k in 0..board_spots.len():
            tw = towns[k]
            draw(obj_sh, board_mesh, obj_params(L, t, translation(board_spots[k]) * rotation_y(atan2(f64(tw.out.x), f64(tw.out.y)))))
        loop w in walkers:
            if length(w.pos - scene_camera()) < 600.0: draw_figure(w.fig, w.pos, w.yaw, w.phase, if w.wait > 0.0: 0.0 else: 0.8, L, t)
        if me.mode == .walking: draw_figure(me_fig, me.pos, me.yaw, me.phase, me.stride, L, t, carrying=holding_cargo() >= 0)
        draw_traffic(traffic,craft_models,L,t,battle)
        ci=combat_index(battle,living_world.people[living_world.player].craft)
        left=ci>=0 and battle.actors[ci].bailed
        draw_combat_aircraft(combat_visual,battle,craft_models,L,t,if left:-1 else:living_world.people[living_world.player].craft)
        pm = craft_models[pc.model]
        at = pc_at()
        if not left:
            draw_craft_parts(pm,pc.state.damage,at,L,t,pc.prop_angle,airframe(pc),pc.state.gear)
            draw_debris(pm,pc.state.damage,L,t)
            if ci>=0:draw_player_hit_marks(combat_visual,battle.actors[ci],at,L,t)
            if me.mode==.aboard and pc.cockpit_view:draw_cockpit(cockpit_model,pm,pc.spec,pc.state,at,L,t)
        if me.mode == .aboard and not pc.cockpit_view: draw_figure_at(me_fig, at * translation(pm.cockpit - vec3(0, 1.55, 0)), 0.0, 0.0, L, t, seated = true)
        if me.mode != .free or length(scene_camera() - grass.center) < 300.0: draw_grass(tuft, grass, L, t)
    )
    if legacy_clouds: draw_custom((): draw_clouds(puff_mesh,puffs,L,wind_now.drift*0.35,t))
    # shadows of the aircraft near the camera: on the sea, drawn by the sea itself; on land, flattened meshes
    sea_sh = SeaShadows()
    cam = scene_camera()
    land: (CraftState, CraftModel)[]
    loop k in 0..traffic.len() + 1:
        st = if k == 0: pc.state else: traffic[k - 1].state
        cm = if k == 0: craft_models[pc.model] else: craft_models[traffic[k - 1].model]
        if length(st.position - cam) > 1500.0: continue
        sd = normalize(L.sun_dir)
        if sd.y < 0.08: continue
        under = st.position - sd * f32(f64(st.position.y) / max(f64(sd.y), 0.2))
        g = surface_height(f64(under.x), f64(under.z))
        hgt = f64(st.position.y) - max(g, 0.0)
        a = 0.55 * (1.0 - smoothstep(60.0, 420.0, hgt)) * smoothstep(0.08, 0.2, f64(sd.y))
        if g > 0.3:
            land.push((st, cm))
            continue
        m = translation(st.position) * quat_to_mat4(st.orientation)
        loop j in 0..cm.shade.len() / 2: add_sea_shadow(sea_sh, m, cm.shade[j * 2], cm.shade[j * 2 + 1], L.sun_dir, a)
    draw_custom((): draw_sea(sea_mesh, depth_tex, L, t, wind_now, if me.mode == .aboard: pc.state.velocity else: vec3(0, 0, 0), sea_sh), transparent = true)
    draw_custom(():
        loop sc in land:
            st, cm = sc
            sd = normalize(L.sun_dir)
            g0 = max(surface_height(f64(st.position.x), f64(st.position.z)), 0.0)
            under = st.position - sd * f32((f64(st.position.y) - g0) / max(f64(sd.y), 0.2))
            g = max(surface_height(f64(under.x), f64(under.z)), 0.0)
            draw_curved_shadow(cm.body, translation(st.position) * quat_to_mat4(st.orientation), g + 0.4, f64(st.position.y) - g, L)
    , transparent = true)
    if env("AEGEAN_NOWAKE") == none:
        draw_custom((): draw_wakes(wakes, L, t), transparent = true)
        draw_custom((): draw_vessel_wakes(vessel_view,L,t), transparent = true)
    draw_custom((): draw_vessel_smoke(vessel_view,L,t), transparent = true)
    draw_curved_particles(spray_ps, false)
    draw_curved_particles(smoke_ps, false)
    draw_custom((): draw_trails(vapor_trails, L, t), transparent = true)
    draw_curved_particles(dust_ps, false)
    draw_combat_particles(combat_visual,battle)
    # (the cloth streams out by the drawn speed, as soon as the takeoff run gets going, and its
    # flutter builds all the way to the drawn top speed in a dive, so it doesn't saturate early; a
    # trial (Tweaks) has it by the true speed instead)
    vis = f64(length(pc.state.velocity))
    cloth_vel = if tweaks.cloth_true: pc.state.velocity * f32(if vis > 0.1: true_speed(pc.spec, vis) / vis else: 1.0) else: pc.state.velocity
    cloth_top = if tweaks.cloth_true: 95.0 else: max(1.3 * pc.spec.max_speed, 95.0)
    draw_custom((): draw_cloths(cloth_mesh, cloths_for(pc.model), pc_at(), wind_now_vec() - cloth_vel, L, t, cloth_top))
    # (the pilot's scarf, on him wherever he is: in the cockpit in the aircraft's wind, ashore in
    # the wind and his own walking)
    if me.mode == .aboard and not pc.cockpit_view:
        seat = pc_at() * translation(craft_models[pc.model].cockpit - vec3(0, 1.55, 0)) * scaling(f64(me_fig.height))
        draw_custom((): draw_cloths(scarf_mesh, pilot_scarf(), seat, wind_now_vec() - cloth_vel, L, t, cloth_top))
    else if me.mode == .walking:
        fwd = vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw)))
        body = translation(me.pos) * rotation_y(me.yaw + PI) * scaling(f64(me_fig.height))
        draw_custom((): draw_cloths(scarf_mesh, pilot_scarf(0.75), body, (wind_now_vec() - fwd * f32(me.stride * 3.0)) * 2.2, L, t))

    if not legacy_clouds:
        draw_custom((): draw_cloud_volumes(world_clouds(scene_camera(),wind_now.drift*0.35),L),transparent=true)

draw = ():
    L = light_at(hour,f64(living_world.minute)/1440.0)
    if env("AEGEAN_CLEAR_AIR") != none: L.fog_density = 0.0
    clear(BLACK)
    sun(L.sun_dir, L.sun, 0.0)
    hide_sky()
    fog(L.haze, L.fog_density, 0.0012)
    post_effects(0.35, 0.85, 0.22, 1.08)
    match me.mode:
        .free: camera3d(free, 62.0, 1.0, world_far(f64(free.pos.y)))
        .aboard:
            if pc.cockpit_view:place_cockpit_camera(craft_models[pc.model],pc.state,pc.look_yaw,pc.look_pitch)
            else:place_chase_camera(pc,t)
        .descent:camera3d(descent_camera,58.0,0.1,world_far(f64(me.pos.y)))
        _: camera3d(follow, 58.0, 0.3, world_far(f64(me.pos.y)))
    if me.mode == .aboard:
        pp = pc.state.position
        hgt = f64(pp.y) - pc.spec.float_height - max(surface_height(f64(pp.x), f64(pp.z)), 0.0)
        set_scene_flow(pc.state.velocity, hgt)
        # (the stretch trial: as strong as the near boost, up to 4.5 times, growing with the speed,
        # reaching farther the higher one flies)
        sp = f64(length(vec3(pc.state.velocity.x, 0, pc.state.velocity.z)))
        k = if speed_mode == 3: 1.0 + (min(near_boost, 4.5) - 1.0) * clamp((sp - 10.0) / 75.0, 0.0, 1.0) else: 1.0
        set_scene_warp(pp, pc.state.velocity, k, 400.0 + 3.0 * max(hgt, 0.0))
    else:
        set_scene_flow(vec3(0, 0, 0), 0.0)
        set_scene_warp(vec3(0, 0, 0), vec3(0, 0, 0), 1.0, 400.0)
    draw_world(L)
    set_font(fonts.ui)
    text("{int(hour):02}:{int((hour - floor(hour)) * 60.0):02}", vec2(f32(screen_width() - 80), 18), 22, rgba(1, 1, 1, 0.85), shadow = rgba(0, 0, 0, 0.4))
    set_font()
    # money
    set_font(fonts.ui)
    text("{player_cents() / 100} lire", vec2(f32(screen_width() - 120), 46), 20, rgba(1, 0.95, 0.8, 0.85), shadow = rgba(0, 0, 0, 0.4))
    set_font()
    # the people about: names over those near, a line from whoever is nearest
    if me.mode == .walking and ui == .none:
        k = nearest_folk(folks, me.pos, 7.0)
        loop i in 0..folks.len():
            f = folks[i]
            if not f.shown or i == k: continue
            d = f64(length(f.pos - me.pos))
            if d < 16.0: name_tag(fonts, f.pos + vec3(0, 1.7, 0), living_world.people[f.person].name, d)
        if k >= 0:
            d = f64(length(folks[k].pos - me.pos))
            speech_bubble(fonts, folks[k].pos + vec3(0, 1.7, 0), living_world.people[folks[k].person].name, folks[k].line, d, 8.0)
    if me.mode == .walking: cargo_view.draw_cargo_targets(living_world)
    match me.mode:
        .walking:
            if ui != .none: pass
            else if holding_cargo() >= 0:
                point = portage.cargo_loading_spot(living_world,living_world.people[living_world.player].craft)
                prompt_card(fonts,if point != none and length(me.pos-point!) < 4: "F  put the crate into the hold" else: "F  put down or hand over the crate")
            else if near_job_cargo() >= 0: prompt_card(fonts,"F  pick up {cargo_view.cargo_label(living_world,living_world.cargo[near_job_cargo()])}")
            else if near_own_craft(): prompt_card(fonts, "F  climb aboard your {CRAFT_NAMES[int(pc.kind)]}")
            else if near_board() >= 0: prompt_card(fonts, "F  read the notices")
            else if nearest_folk(folks, me.pos, 3.5) >= 0: prompt_card(fonts, "T  talk to {living_world.people[folks[nearest_folk(folks, me.pos, 3.5)].person].name}")
            else if pc.state.moored:
                if let a = mooring_anchor():
                    if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: prompt_card(fonts, "hold F  haul in the line")
        .aboard:
            if pc.state.crashed or pc.state.capsized: prompt_card(fonts, "Wrecked.  R  to be towed home", 180.0)
            else if pc.state.beached: prompt_card(fonts, "Run aground.  R  to be towed home", 180.0)
            else if pc.state.moored: prompt_card(fonts, "F  step onto the quay      Shift  open the throttle", 180.0)
            else if mooring_spot(pc, towns) != none: prompt_card(fonts, "F  moor here", 180.0)
        .descent: pass
        .free: text("{free.pos.x:.0} {free.pos.y:.0} {free.pos.z:.0}", vec2(16, 16), 18, rgba(1, 1, 1, 0.7))
    if me.mode == .aboard:
        aim_marks(pc)
        st = pc.state
        # (the speedometer reads the true speed)
        if not pc.cockpit_view and (tweaks.true_curve or tweaks.pure_scale): instruments(fonts, true_speed(pc.spec, f64(length(st.velocity))), f64(st.position.y) - pc.spec.float_height, st.throttle, pc.throttle, st.fuel / pc.spec.fuel_capacity, (heading(st) + TAU) % TAU, pc.spec.stall_speed, pc.spec.max_speed / pc.spec.handling_scale)
        else if not pc.cockpit_view: instruments(fonts, f64(length(st.velocity)), f64(st.position.y) - pc.spec.float_height, st.throttle, pc.throttle, st.fuel / pc.spec.fuel_capacity, (heading(st) + TAU) % TAU, pc.spec.stall_speed, pc.spec.max_speed)
    if me.mode != .free and not paused: title_card(fonts, t)
    if vdown(.h) or (t > 7.5 and t < 22.0 and me.mode == .walking): controls_card(fonts, me.mode == .aboard)
    draw_ui()
    notebook_panel(fonts, notebook, clock_text(living_world, living_world.minute))
    if paused and not dbg.picking: rect(0, 0, f64(screen_width()), f64(screen_height()), rgba(0.03, 0.05, 0.08, 0.25))
    if dbg.open:
        was = debug_view()
        v = was
        debug_apply(was, v, debug_panel(dbg, v, [loop tw in towns: tw.name], CRAFT_NAMES))
    if dbg.picking and show_chart: prompt_card(fonts, "Click where to go  ({int(dbg.altitude)} m)", 60.0)
    if t < toast_until: prompt_card(fonts, toast, 260.0)
    if show_chart: draw_chart(chart, towns, if me.mode == .aboard: pc.state.position else: me.pos, if me.mode == .aboard: heading(pc.state) else: PI - me.yaw, hour,
        [loop tr in traffic: vec4(tr.state.position.x, tr.state.position.y, tr.state.position.z, f32(heading(tr.state)))],vessels.ships,vessels.lanes)
    # (on a touch screen: the stick and the buttons, over everything)
    draw_pad()

# the panels open over the scene: a conversation, a board, a ledger
draw_ui = ():
    global ui, ui_line, ui_news, ui_place, ui_job, ui_turn
    match ui:
        .talk:
            if ui_folk < 0 or ui_folk >= folks.len():
                ui = .none
                return
            f = folks[ui_folk]
            p = living_world.people[f.person]
            merchant = p.occupation == .merchant or p.occupation == .innkeeper or p.occupation == .hotelier or p.occupation == .quartermaster
            # errands first: work they posted (offered to them in person), cargo one has brought them
            offers: int[]
            offer_choices: lt.CarriageChoice[]
            handovers: int[]
            handover_choices: lt.CarriageChoice[]
            answers: str[]
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.poster == f.person and j.state == .open and j.origin == f.place:
                    offers.push(id)
                    offer_choices.push(if j.delivery_mode == .foot: lt.CarriageChoice.player else: lt.CarriageChoice.automatic)
                    answers.push(if j.delivery_mode == .foot: "I'll carry {job_cargo(id)} across town." else: "Fly {job_cargo(id)} to {SETTLEMENTS[j.destination].name}; arrange carrying.")
                    if j.delivery_mode == .aircraft and j.cargo_mode != .none:
                        offers.push(id); offer_choices.push(.porter)
                        answers.push("To {SETTLEMENTS[j.destination].name}: please hire a porter for {job_cargo(id)}.")
                        offers.push(id); offer_choices.push(.player)
                        answers.push("To {SETTLEMENTS[j.destination].name}: I'll fetch and load {job_cargo(id)}.")
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.state == .claimed and j.carrier == living_world.player and (j.loaded or j.delivery_mode == .foot) and j.destination == f.place and recipient_of(id) == f.person:
                    handovers.push(id); handover_choices.push(.automatic)
                    answers.push("I've brought {job_cargo(id)} from {living_world.people[j.poster].name}.")
                    if j.delivery_mode == .aircraft and j.cargo_mode != .none:
                        handovers.push(id); handover_choices.push(.player)
                        answers.push("I'll carry {job_cargo(id)} from the aircraft to your door myself.")
            nerr = answers.len()
            # then the conversation itself: answers to what they just asked, the things one can
            # bring up with them (their work, the news, the weather, the market, people, home...),
            # work and trade, and leaving. When they've had enough, only leaving.
            replies = if ui_turn.exhausted: [] else: ui_turn.replies
            loop r in replies: answers.push("\"{r.label}\"")
            nrep = answers.len()
            topics = if ui_turn.exhausted: [] else: [loop o in living.talk_topics(living_world, f.person, living_world.player): if o.topic != .greeting and o.topic != .farewell: o]
            if topics.len() > 5: topics = [loop k in 0..5: topics[k]]
            loop o in topics: answers.push(o.label)
            ntop = answers.len()
            answers.push("Any work going?")
            if merchant: answers.push("Let's trade.")
            answers.push("Goodbye.")
            role = "{p.occupation}".replace("_", " ")
            c = conversation_grouped(fonts, p.name, "{role}, {SETTLEMENTS[f.place].name}", ui_line, [loop k in 0..nrep: answers[k]], [loop k in nrep..ntop: answers[k]], [loop k in ntop..answers.len(): answers[k]])
            if vpressed(.escape): c = answers.len() - 1
            if c >= 0 and c < offers.len():
                id = offers[c]
                choice = offer_choices[c]
                ui_line = agree_cargo_job(id,choice)
            else if c >= offers.len() and c < nerr:
                id = handovers[c - offers.len()]
                before = player_cents()
                choice = handover_choices[c-offers.len()]
                if choice == .player:
                    portage.choose_collection(living_world,id,living_world.player,.player)
                    ui_line = "Please bring it to the marked delivery point. " + portage.cargo_status(living_world,id)
                else if living.deliver_job(living_world, id, living_world.player):
                    ui_line = "Thank you. That's what was promised: {(player_cents() - before) / 100} lire."
                else: ui_line = portage.cargo_status(living_world,id)
            else if c >= nerr and c < nrep:
                ui_turn = living.reply(living_world, f.person, replies[c - nerr].reply, living_world.player)
                ui_line = turn_text(ui_turn)
            else if c >= nrep and c < ntop:
                ui_turn = living.talk(living_world, f.person, topics[c - nrep].topic, living_world.player)
                ui_line = turn_text(ui_turn)
                if topics[c - nrep].topic == .news: ui_news += 1
            else if c >= 0:
              c -= ntop
              if c == 0:
                  ui_place = f.place
                  ui = .board
              else if merchant and c == 1:
                  ui_place = f.place
                  ui = .trade
              else if c >= 0:
                  # (a parting word, left hanging over the quay as one walks off)
                  bye = living.talk(living_world, f.person, .farewell, living_world.player)
                  if bye.text != "": say_toast("{p.name}: {bye.text}")
                  ui = .none
        .board:
            yesterday: str[]
            loop r in living_world.places[ui_place].yesterday:
                l = reason_line(living_world, r)
                if l != "": yesterday.push(l)
            res = notice_board(fonts, SETTLEMENTS[ui_place].name, job_notices(living_world, ui_place), yesterday)
            if res.take >= 0:
                # Keep the notice, then review its actual handling terms before agreeing.
                j = living_world.jobs[res.take]
                pin_notice(notebook, res.take, j.poster, "{job_cargo(res.take)} to {SETTLEMENTS[j.destination].name}".replace("the ", ""), "{living_world.people[j.poster].name} at {SETTLEMENTS[j.origin].name} wants it there by {clock_text(living_world, j.due_minute)}. {j.reward_cents / 100} lire.", clock_text(living_world, living_world.minute))
                ui_job = res.take
                ui_line = "{living_world.people[j.poster].name} offers {f64(j.reward_cents)/100.0:.2} lire. The goods are at their existing warehouse spot. Who will carry them?"
                ui = .handling
            if res.closed: ui = .none
        .handling:
            if ui_job < 0 or not (ui_job in living_world.jobs): ui = .board; return
            j = living_world.jobs[ui_job]
            answers: str[]; choices: lt.CarriageChoice[]
            if j.state == .open:
                if j.delivery_mode == .foot:
                    answers.push("I'll carry it on foot."); choices.push(.player)
                else:
                    answers.push("Arrange the carrying with the sender."); choices.push(.automatic)
                    if j.cargo_mode != .none:
                        answers.push("The sender hires a dock porter."); choices.push(.porter)
                        answers.push("I'll fetch and load it myself."); choices.push(.player)
            answers.push("Back to the board.")
            c = conversation(fonts,"{living_world.people[j.poster].name}'s notice",SETTLEMENTS[j.origin].name,ui_line,answers)
            if c >= 0 and c < choices.len(): ui_line = agree_cargo_job(ui_job,choices[c])
            else if c >= 0 or vpressed(.escape): ui = .board
        .trade:
            w = living_world
            m = w.places[ui_place].market
            c = w.people[w.player].craft
            rows: GoodRow[]
            goods: int[]
            loop g in 0..w.goods.len():
                if w.goods[g].illegal and ui_place != 5: continue
                pr = m.price_cents[g]
                have = w.people[w.player].pocket.qty[g] / 1000
                rows.push(GoodRow(w.goods[g].key, "load", pr * 102 / 10000, pr * 98 / 10000, m.inventory.qty[g] / 1000, have))
                goods.push(g)
            used = 0
            if c >= 0:
                loop g in 0..w.goods.len(): used += w.aircraft[c].cargo.qty[g] / 1000
            res = ledger(fonts, w.people[folks[ui_folk].person].name, SETTLEMENTS[ui_place].name, rows, player_cents() / 100, used, 8)
            if res.row >= 0:
                ok = if res.dir > 0: living.buy(living_world, ui_place, goods[res.row], 1000, living_world.player) else: living.sell(living_world, ui_place, goods[res.row], 1000, living_world.player)
                if not ok: say_toast("No: not enough money or stock. Bring your goods ashore to sell them.")
                else if res.dir > 0: say_toast("Yours at the warehouse. Carry the crate aboard with F.")
            if res.closed: ui = .none
        _: pass
