window("Aegean Skies", 1280, 720)
enable_world_depth()
init_quality()
# The CPU rasterizer cannot sample its depth buffer through the GL texture API.
# Keep its existing opaque cloud path for CI/software use, as well as A/B runs.
legacy_clouds = (env("AEGEAN_LEGACY_CLOUDS") ?? "") == "1"
when TARGET != "wasm":
    if __soft: legacy_clouds = true
if not legacy_clouds: init_cloud_volumes()
init_terrain()
init_sky()
init_rain()
init_objects()
init_sea()
init_grass()
init_wake()
init_boat_scene()
init_shadow()
init_trails()
init_flight_effects();init_splashes();init_storm_render();init_craft_shadow();init_look_outline()
init_birds()
init_curved_world(legacy_clouds)
# These effects first appear when a nearby aircraft starts, potentially long
# after a walking scene has settled. Load their programs before the game loop.
init_prop_discs()
init_local_particles()
effect_pipelines_ready = false

# how many times faster than designed the aircraft truly fly (handling kept at the designed turn
# rates; the pause menu's Speed scale, AEGEAN_SPEED_SCALE): set before any aircraft or trip is made
BASE_SPEED_SCALE = 3.3              # (the pause menu's Speed, to start with)
set_speed_scale(to_float(env("AEGEAN_SPEED_SCALE") ?? "") ?? BASE_SPEED_SCALE)
lt.scale_airframes(speed_scale)

t0 = time()
if not load_land(embed("assets/terrain.bin")): panic("assets/terrain.bin mismatch/corruption: run sloppy --release tools/bake.jo")
# (the islands' render tiles as tools/bake.jo derived them from that source, byte for byte what
# build_terrain_from_source makes: about 2.5 s less to the first frame in a browser, for a larger
# download; tests/baked_assets_test.jo checks the two agree)
load_terrain(embed("assets/terrain_lod.bin"))
if (env("AEGEAN_WORLD") ?? "1") == "1":
    if not load_geography(embed("assets/world.bin")): panic("world.bin mismatch/corruption: run sloppy --release tools/bake_world.jo")
    geography_enabled = true
    init_world_terrain()
    if env("AEGEAN_WORLD_CHECK") != none: print("geography fingerprint {geography_fingerprint()}")
init_canal_geometry()
depth_tex = build_depth_texture()
sea_mesh = build_sea_mesh()
# The legacy instances are allocated only when that path is selected.
puff_mesh: Mesh
puffs: InstanceBuffer[Puff]
if legacy_clouds:
    puff_mesh = build_puff_mesh()
    puffs = instance_buffer(build_puffs(7,render_quality.cloud_fields))
towns = [loop st in SETTLEMENTS: build_town(st)]
init_world_towns(towns)
# (the unnamed crowd's figures, made once now rather than as the first big town comes near)
if geography_enabled: ambient_prepare()
living_validation.set_living_strict(false)
living_world = living.build_world(u64(0), harbors_from_towns(towns))
traffic_scene = living_scene.SceneAdapter()
import 'src/speech_warmup.jo' as speech_loading
speech_warmup = speech_loading.SpeechWarmup()
tree_meshes = build_tree_meshes()
grove_far_meshes = build_tree_meshes(true)
groves: Grove[]
loop k in 0..ISLANDS.len(): groves += build_grove(k,towns)
# The chart's paper (two textures, about 0.7 s on a phone) is made in the background once the
# game is drawing, a few milliseconds a frame, not before its first frame; opening the chart
# before that is done makes the rest at once.
chart_built: Chart? = none
chart_job = ChartBuild()
CHART_SLICE = 0.003             # seconds of each frame
chart_background_step = ():
    global chart_built, chart_job
    if chart_built != none or frame_number() < 30: return
    if let c = chart_step(chart_job, CHART_SLICE):
        chart_built = c
        chart_job = ChartBuild()    # (its rows let go)
the_chart = () -> Chart:
    global chart_built, chart_job
    if let c = chart_built: return c
    c = chart_step(chart_job, 1.0e9) ?? build_chart()
    chart_built = c
    chart_job = ChartBuild()
    c
flocks = build_flocks(towns, 21)
bird_mesh = build_bird()
# Saved living trips and the trade/war adapter supply identities; no second fleet.
vessels = VesselFleet()
vessel_bindings = VesselBindings()
vessel_view = VesselView()
vessel_mooring = VesselMooring()
craft_models = build_craft_models()
# The player's aircraft repainted (the pause menu's Paint page; saved with the game): its own model,
# built from the paint, drawn in place of the type's (whose other aircraft keep their paint).
player_paint = Paint()
# The sandbox's unlimited money (src/sandbox.jo): the level the purse is held at and how much of it
# is lent from outside the world; saved with the game (GameSession.purse).
purse_hold = PurseHold()
painted_model: CraftModel? = none
paint_dirty = false
paint_built_at = -100
paint_support_cache = PaintSupport()
paint_shown = Paint()               # (the paint the model was last built in: the player's, a shop's draft, or a job's stage)
paint_space: DecalSpace? = none     # (the painted model's triangles, for a decal pointed at on the aircraft)
# The paint shop (src/paint_shop.jo): a mechanic paints her for a price and a little time. While
# the Paint page is a shop's, it changes a draft, shown on the aircraft and priced; ordered, the
# aircraft stays in the shop (paint_job, saved) until the paint is dry.
paint_job = PaintJob()
paint_shop_open = false
paint_shop_draft = Paint()
paint_panel = PaintPanel()          # (the shop's own panel: where it is on the screen, what scrolls)
paint_view_yaw = 0.9                # (the view about the aircraft while her paint is chosen: turned by drags beside the panel)
paint_view_pitch = 0.28
paint_view_zoom = 1.0
paint_shop_who = -1                 # (the painter, a Person, and their town)
paint_shop_place = -1
paint_fresh_until = -1              # (a new paint is remarked on until this minute, once by each)
paint_remarked: int[] = []
# Other pilots' liveries (src/pilot_liveries.jo): each one's paint is kept with their aircraft's
# record; their models are built from it a few frames apart and kept by the paint's text.
pilot_livery_queue: int[] = []      # (the aircraft whose models are still to build)
pilot_livery_models: {str: int} = {}    # (a paint's model in craft_models, by its type and text)
pilot_livery_by_craft: {int: int} = {}  # (and by aircraft, once found: looked up every frame)
if env("TOWNS_PRINT") != none:
    loop tw in towns: print("{tw.name}: {tw.center.x:.0} {tw.center.z:.0} out {tw.out.x:.2} {tw.out.y:.2} houses {tw.houses.len()}")
print("world built in {(time() - t0) * 1000.0:.0} ms")

# a font from the game's own files (they're known good: a bad one stops at once, saying so)
_font = (bytes: u8[]) -> Font:
    f = load_font(bytes)
    if f is FontError: panic("font: {f}")
    f

fonts = Fonts(_font(embed("assets/fonts/JosefinSans-SemiBold.ttf")), _font(embed("assets/fonts/Limelight-Regular.ttf")))

# ---------------- the player ----------------

enum Mode:
    walking
    aboard          # in the cockpit (the flight model comes here)
    descent         # falling, under a canopy, or swimming after leaving an aircraft
    free            # a free camera, for looking around

struct Player:
    mode: Mode = .walking
    pos: vec3
    yaw: f64 = 0.0                  # the way they face (world turn: faces (sin, cos))
    phase: f64 = 0.0                # the walk's swing
    stride: f64 = 0.0
    money = 120

# an aircraft at rest: moored at a dock, bobbing on the swell
struct Moored:
    kind: Craft
    model: int
    pos: vec3
    yaw: f64

home = towns[0]
along_quay = atan2(f64(home.out.x), -f64(home.out.y))        # (a flight heading: 0 north, east PI/2)
# the player's own aircraft, moored at the first dock; others moored at the rest
# AEGEAN_CRAFT uses the append-only Craft ID, independent of cached livery/model slots.
start_kind = Craft(clamp(to_int(env("AEGEAN_CRAFT") ?? "0") ?? 0, 0, CRAFT_NAMES.len() - 1))
start_model = default_craft_model(start_kind)
start_record = living_world.people[living_world.player].craft
living_world.aircraft[start_record].kind = lt.Airframe(int(start_kind))
living_world.aircraft[start_record].model_index = start_model
living_world.aircraft[start_record].livery_index = DEFAULT_LIVERIES[int(start_kind)]
# A landplane put down on an airfield stand (the airfield nearest `near`): on the grass, at rest,
# its nose toward the strip. (airfields.jo; a landplane never starts on the water)
landplane_at_airfield = (kind: Craft, model: int, near: vec3, where: str = "stand") -> Flyer:
    f = AIRFIELDS[max(0, nearest_airfield(near.xz))]
    spec = craft_spec(kind, craft_models[model].contacts)
    at = if where == "runway": airfield_point(f, -f.half_length + 40.0, 0.0) else: (if where == "fuel": airfield_fuel_stand(f) else: airfield_stand(f, AIRFIELD_VISITOR_STAND))
    st = ground_start(spec, at, if where == "runway": f.heading else: airfield_stand_heading(f))
    Flyer(kind, model, spec, st, cam_pos = st.position, aim_heading = heading(st))
pc = if aircraft_profile(start_kind).landplane: landplane_at_airfield(start_kind, start_model, home.docks[0]) else: make_flyer(start_kind, start_model, craft_models[start_model].contacts, home.docks[0], along_quay)
pc.spec.player = true
moored: Moored[]
traffic = make_living_traffic(living_world, craft_models)
assign_pilot_liveries()
bind_living_player(pc, living_world, traffic_scene)

# A landplane is never left on the water: bound to a record that has her at a harbour's berth (a
# new game begun in one, or a record from before she was a landplane), she is put on the nearest
# aerodrome's stand instead, and the record with her
landplane_ashore = ():
    global pc
    if not pc.spec.landplane or surface_height(f64(pc.state.position.x), f64(pc.state.position.z)) > 0.5: return
    pc = landplane_at_airfield(pc.kind, pc.model, pc.state.position)
    pc.spec.player = true
    c = living_world.people[living_world.player].craft
    if c >= 0:
        living_world.aircraft[c].pose = lt.Pose(pos = pc.state.position, vel = pc.state.velocity, rot = pc.state.orientation)
        lt.place_pose(living_world.aircraft[c].pose, craft_point(pc.state))
        living_world.aircraft[c].revision += 1
landplane_ashore()

# ---------------- the people of the towns, the boards, talking and trading ----------------

cargo_scene.configure_cargo_scene(living_world,towns)
cargo_meshes = cargo_view.build_cargo_meshes()
folks: Folk[]
# whether the title will open (title_wanted below, for the startup above it)
TITLE_KEEPS = ["AEGEAN_QUALITY", "AEGEAN_TOUCH", "AEGEAN_TITLE"]
title_will_open = () -> bool:
    if let v = env("AEGEAN_TITLE"): return v != "0"
    if PROGRAM_NAME != "Aegean Skies": return false
    if env("SLOPPY_FRAMES") != none or env("SLOPPY_SCREENSHOT") != none: return false
    when TARGET == "wasm": return __aegean_staged() == 0
    loop name, _ in env_all():
        if name.starts_with("AEGEAN_") and not TITLE_KEEPS.contains(name): return false
    true
# (behind the title the far economy's opening, about 3.5 s of a phone's start, is made a few
# milliseconds a frame on the world kept aside for a new game: step_far_opening)
set_far_opening_deferred(title_will_open())
sync_folk(folks, living_world, towns)
life_meshes = life_view.build_life_meshes(living_world)
folk_sync_t = 0.0
ui = Ui.none
ui_folk = -1
ui_place = -1
ui_line = ""
ui_news = 0
# (the conversation under way: the last thing they said, the replies it invites, whether they've
# had enough)
ui_turn = social.ConversationTurn(-1, -1, .greeting)

# what a turn says aloud: the words, then any question
turn_text = (turn: social.ConversationTurn) -> str: if turn.question != "": "{turn.text} {turn.question}" else: turn.text
ui_job = -1
ui_mission = -1                     # the military contract open at the office counter
# the war as the player meets and hears of it: battle cards shown, the chart's war layer
battle_card = BattleCard()
war_chart = WarChart()
war_layer_on = true
# what the player has met and turned down, kept with the living world when it is saved
# (battle cards shown, battles seen, contracts declined): the game passes this to save_world
presentation = lt.PresentationState()
packets_now: ContractMark[]           # where the packets of claimed contracts are to be collected or taken
ui_shop = ""                    # (the map seller whose counter is open)
toast = ""
toast_words = ""                    # (the words in it that are spoken: say_toast)
paused = false
my_jobs: {int: lt.JobState} = {}       # the errands one carries, and how they stood last
toast_until = 0.0

# a harbor's notice board: two posts and a board with a little roof, on the waterfront
board_mesh = custom_mesh(():
    vs: Vertex3D[]
    wood = rgb(0.42, 0.3, 0.19)
    add_box(vs, vec3(-0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0, 1.45, 0), vec3(2.1, 1.1, 0.08), rgb(0.5, 0.36, 0.22))
    loop k in 0..5: add_box(vs, vec3(f32(-0.75 + f64(k) * 0.37), f32(1.45 + f64((k * 37) % 3) * 0.12 - 0.12), 0.06), vec3(0.28, 0.34, 0.02), rgb(0.95, 0.91, 0.8))
    add_gable(vs, vec3(0, 2.05, 0), 2.2, 0.5, 0.25, ROOFS[1], mat4())
    vs
())
board_spots: vec3[]
loop tw in towns: board_spots.push(town_board_spot(tw))

# (AEGEAN_UI=board|talk|trade opens that panel at the home harbor at the start, for screenshots)
if let v = env("AEGEAN_UI"):
    living.advance_minutes(living_world, if v == "board": 180 else: 20)
    sync_folk(folks, living_world, towns)
    ui_place = 0
    if v == "board": ui = .board
    else:
        loop k in 0..folks.len():
            if folks[k].place == 0 and ui_folk < 0 and (v != "trade" or living_world.people[folks[k].person].occupation == .merchant): ui_folk = k
        # (talk: someone with work to offer, if anyone has)
        loop k in 0..folks.len():
            loop id in living_world.active_jobs:
                if v == "talk" and folks[k].place == 0 and living_world.jobs[id].delivery_mode == .aircraft and living_world.jobs[id].state == .open and living_world.jobs[id].poster == folks[k].person and living_world.jobs[id].origin == folks[k].place: ui_folk = k
        if ui_folk >= 0:
            ui = if v == "trade": Ui.trade else: Ui.talk
            ui_line = say(living_world, folks[ui_folk].person)

# ---------------- leisure: the Hotel Ancora, the coffee house, resting, working on the aircraft ----------------
# (optional activities: no needs, no meters, no penalties; src/leisure.jo, docs/leisure.md)

hotel = build_hotel(hotel_site(towns[0], (x: f64, z: f64) -> f64: surface_height(x, z)))
towns[0].quays = towns[0].quays + hotel.quays
walk_publish("hotel-ancora", hotel_solids(hotel) + room_solids(hotel))
walk_publish_floors(room_floor_sites(hotel))
publish_leisure_venue(living_world, hotel.venue)

# ---------------- the paint shops (src/paint_shed.jo) ----------------
# An open-fronted workshop on its own deck at the water's edge, in each harbour town a mechanic
# lives in: found a spot clear of the docks, the boats and the hotel, built, its deck walkable, its
# walls solid, and its venue published (the mechanic works there in working hours).
paint_sheds: PaintShed[] = []
build_paint_sheds = ():
    global paint_sheds
    loop q in living_world.people:
        place = q.home
        if q.occupation != .mechanic or q.far_home >= 0 or place < 0 or place >= towns.len(): continue
        if paint_sheds.any((s: PaintShed) -> bool: s.place == place): continue
        port = SETTLEMENTS[place].kind == .port
        # (clear of the hotel's pier and terrace, where the town has it)
        keep: vec3[] = if place == 0 and hotel.ok: [vec3(hotel.origin.x + hotel.table_z.x * 15.0, 26.0, hotel.origin.z + hotel.table_z.z * 15.0)] else: []
        frame = paint_shed_site(towns[place], (x: f64, z: f64) -> f64: surface_height(x, z), port, keep) ?? continue
        # (a harbour with no waterfront to stand off: a gangway from its quay)
        shed = build_paint_shed(frame, place, if port: 0.0 else: paint_shed_gangway(towns[place], frame))
        paint_sheds.push(shed)
        towns[place].quays = towns[place].quays + shed.quays
        walk_publish("paint-shop:{place}", paint_shed_solids(shed))
        publish_leisure_venue(living_world, paint_shed_venue(shed))
build_paint_sheds()

# the paint shop of a town, if it has one
paint_shed_of = (place: int) -> PaintShed?:
    loop s in paint_sheds:
        if s.place == place: return s
    none
band = make_band()
# (and drawn as themselves on the stand when the town hasn't their figures to hand: the stand's
# stock figures had Marta, on the violin, as a young fisherman)
# (in their evening clothes, src/wardrobe.jo)
band_dressed = (role: int) -> Figure:
    p = living_world.people[BAND_ROSTER[role]]
    woman = person_woman(p.name)
    build_outfit_figure(evening_outfit(role, p.appearance_seed, woman), p.appearance_seed, age = p.age, woman = woman)
band.singer = band_dressed(0); band.pianist = band_dressed(1)
band.bassist = band_dressed(2); band.reeds = band_dressed(3)
# (the band's players are townspeople: the world keeps their programme, src/band_life.jo)
band_publish(living_world, band_numbers(hotel), BAR_START, BAR_END, int(BAR_GAP * 60.0))
band_notes = BandFeed()            # what the band plays, note by note, as heard (src/live_notes.jo)
band_perf = Performance()          # (its players' motions and the clock they play to)
# (every number of the set and its players' motions made now, so no number starts with a hitch)
bar_feed_warm(band_notes)
loop k in 0..BAR_SET.len(): perform_warm(band_perf, band_notes.ready[k], bar_feed_key(BAR_SET[k].piece, k))
serve_parts = build_serve_parts()
bar_music = BarMusic()
hotel_place = LeisurePlace("hotel", 0, .bar, "Hotel Ancora", "hotel, restaurant and terrace bar", 6, hotel.seat, opens = 420, closes = 120, room_cents = 600, menu = "hotel")
coffee_place = LeisurePlace("coffee", 0, .coffee_house, "The coffee house", "kafeneio by the square", 3, opens = 360, closes = 1320, menu = "coffee")
coffee = CoffeeHouse()
leisure_place_cafe = () -> social.LifeVenue?:
    cafes = [loop v in living_world.life_venues: if v.place == 0 and v.kind == .cafe and not v.key.ends_with(social.TERRACE_VENUE_SUFFIX): v]
    cafes.sort((v: social.LifeVenue): v.key)
    if cafes.len() > 0: cafes[0] else: none
if let v = leisure_place_cafe():
    coffee = build_coffee_house(vec3(v.pos.x, f32(walk_height(towns, f64(v.pos.x), f64(v.pos.z))), v.pos.z), v.facing)
    coffee_place.pos = coffee.seat
hotel_menu = leisure_menu(hotel_place)
coffee_menu = leisure_menu(coffee_place)
leisure = LeisureState()
menu_view = MenuView()
leisure_ui = 0                  # (with ui == .leisure) 0 sitting, 1 the menu, 2 a room, 3 the aircraft, 4 a spare room, 6 who to play tavli with, 7 the tavli board, 8 asking the band for a number, 9 the paper, 10 fishing, 12 the barber's chair
leisure_at = "hotel"            # whose menu or room is open
leisure_line = ""               # (what was last said or done there)
leisure_host = -1               # (the family offering a spare room)
leisure_spent = 0               # (this sitting: for the notebook when one gets up)
leisure_had: str[]
served_look_until = -1.0        # (a look at the table while what was ordered arrives)
served_pending = false
ride = Joyride()                 # (a pleasure flight with someone from the town: src/joyride.jo)
ride_fig: Figure? = none
rider = RescuedRider()              # (a pilot taken out of the water, seen aboard and walking off: src/rescued_rider.jo)
rider_fig: Figure? = none
ride_rolled = false              # (whether anyone asks: rolled once each time the pilot comes to the aircraft)
ride_asker = -1                  # (the folk asking, while they ask)
ride_asking_wait = false         # (the pilot stepped ashore with them seated: the choice is up)
ride_lift_to = -1                # (the one asking wants a lift: THERMAL_SITES index of the springs, else -1)
ride_boarded = false             # (the pilot has been aboard with them seated: only then is stepping ashore a question)
ride_declined: {int: int} = {}   # (who was put off, or gave up waiting: the world minute; not asked again that day)
ride_owed: {int: bool} = {}      # (who gave up waiting and has yet to say so)
stay = Stay()                    # (a night under a roof: the hotel's room, or a family's: src/stay.jo)
stay_rooms = build_stay_rooms()
stay_host_fig: Figure? = none
stay_figs: Figure[] = []         # (the household at the table)
# the room's things and the pilot among them, what is pointed at, and the view (src/room_walk.jo)
room_objs: RoomObject[] = []
room_rects: vec4[] = []
room_ways: vec3[] = []
room_me = RoomPilot()
room_hover = -1                     # (under the mouse)
room_focus = -1                     # (chosen with the arrow keys or a pad's d-pad; Enter or A uses it)
room_press = vec2(-1, -1)           # (where the left button went down: let go there, a click uses what is under it)
room_eye = vec3(0, 0, 0)            # (the view, eased from one of its places to another: room-local)
room_aim = vec3(0, 0, 0)
room_prev_stage: StayStage = .awake # (before going to the window)
room_after_wake = -1                # (a thing tapped while he slept: he goes there once up)
room_escape_quiet = 0.0             # (the Escape or Back that woke him isn't also the way out)
room_script = env("AEGEAN_ROOM_SCRIPT") ?? ""
foot_go_script = env("AEGEAN_FOOT_GO") ?? ""
table_script = ""                # (captures: the table's script of getting up and sitting again)
left_table: Served[] = []        # (what the pilot left on the table on getting up: there until cleared)
left_key = ""                    # (where: "hotel", "bar", "coffee")
left_spots = ServiceSpots(vec3(0, 0, 0), vec3(0, 0, 0), vec3(0, 0, 0), vec3(1, 0, 0), vec3(0, 0, 1))
left_at = -1.0                   # (when, on the game's clock)
clear_waiter = Waiter()          # (whoever comes for it, some while after)
left_wait = to_float(env("AEGEAN_LEFT_WAIT") ?? "40") ?? 40.0   # seconds after the pilot gets up before they come to clear
company = Company()              # (someone come to sit with the pilot, now and then: src/company.jo)
company_line = ""                # (what they said last, and until when it shows)
company_line_until = -1.0
# The pilot's small talk (src/pilot_talk.jo; the option "Your pilot makes small talk"): what he did
# today, his answer waiting to be said (a moment after the remark), and the line he is saying.
town_speech = TownSpeech()
# A conversation in the panel, said over the speakers' heads too (src/talk_bubbles.jo).
talk_bubbles = TalkBubbles()
pilot_chat_trace = env("AEGEAN_SMALL_TALK")
flight_on = false                # (a flight under way: the worst of the air met on it, and where from)
flight_storm = 0.0
flight_rain = 0.0
flight_wind = 0.0
flight_from = ""

# A deliberate walk to an action, carrying a load, or a panel needs the pilot's attention.
chat_busy = () -> bool:
    if me.mode != .walking or menus_open() or job.active or foot_goal >= 0 or me.stride > 0.85: return true
    if swim.active or gaze.active or stay.active or cat_busy(cat_scene) or fish_hands_busy(): return true
    chat_on_business(living_world,me.stride > 0.2)

# Weather moves with the world minute. Between remarks, check it at most once a second.
storm_check_at = -1.0
chat_at = (speaker: int, place: int, seated: bool, warnings_only: bool = false) -> str:
    global town_speech, storm_check_at
    if world_held(): return ""
    storm_check_at = t + 1.0
    if town_speech.turn.tag.starts_with("storm:"): return ""
    c = ChatContact(speaker,place,seated=seated,busy=chat_busy(),warnings_only=warnings_only,rain=weather_here.rain > 0.3,
        wind=f64(length(weather_here.wind)),answers=options.small_talk,first_at_table=seated and not company_greeted,
        forced=pilot_chat_trace == "always" or env("AEGEAN_LEADS") == "always")
    turn = town_chat(living_world,presentation.town_chat,c,() -> MeetNote[]?:
        if _lead_now(if seated: 0.33 else: 0.14): _lead_meets() else: none)
    if turn.opening != "":
        town_speech = TownSpeech(speaker,seated,turn,t)
        if pilot_chat_trace != none: print("TOWN {living_world.people[speaker].name}: {turn.opening}")
    turn.opening

# Run after input, including frames that opened a menu or paused the world.
pilot_reply_frame = ():
    global town_speech
    if ui == .talk and ui_folk >= 0 and ui_folk < folks.len():
        f = folks[ui_folk]
        n = presentation.town_chat.len()
        if n == 0 or presentation.town_chat[n-1] != ChatVisit(living_world.minute,f.person,f.place,"conversation"):
            chat_remember(presentation.town_chat,living_world.minute,f.person,f.place,"conversation")
    if town_speech.speaker < 0: return
    seated = seat_view()
    listener = -1
    if seated and company.stage == .sitting: listener = company.person
    else if not seated and me.mode == .walking:
        k = nearest_folk(folks,me.pos,7.0)
        if k >= 0 and folks[k].line == "": listener = folks[k].person
    was = town_speech
    chat_step(town_speech,t,listener,seated,chat_busy(),options.small_talk)
    if was.seated and town_speech.speaker < 0 and company_line == was.turn.opening:
        global company_line_until
        company_line_until = -1.0
    if pilot_chat_trace != none and not was.answered and town_speech.answered: print("PILOT says: {town_speech.turn.reply}")

pilot_talk_frame = ():
    global flight_on, flight_storm, flight_rain, flight_wind, flight_from
    st = pc.state
    up = me.mode == .aboard and not st.on_water and not st.moored and not st.on_ground and not st.crashed
    if up and not flight_on:
        flight_on = true; flight_storm = 0.0; flight_rain = 0.0; flight_wind = 0.0
        place = living_world.people[living_world.player].place
        flight_from = if place >= 0: living.place_name(living_world, place) else: ""
    if up:
        flight_storm = max(flight_storm, f64(weather_here.storm)); flight_rain = max(flight_rain, f64(weather_here.rain))
        flight_wind = max(flight_wind, f64(length(weather_here.wind)))
    else if flight_on:
        flight_on = false
        pilot_did(living_world.pilot_day, Doing(.flew, living_world.minute, where = flight_from, rough = flight_rough(flight_storm, flight_rain, flight_wind), rain = flight_rain > 0.3))

# Leads (src/leads.jo): what people mention the pilot could go and do; who has said what, today.
_lead_meets = () -> MeetNote[]: [loop m in air_events.meets: MeetNote(id = m.id, capital = m.capital, day = m.day, open = m.phase == .registration, fast = m.race_class == .schneider)]
# What `person` mentions now, if anything they haven't said today: their words ("" if nothing).
# (who has told him which lead is the world's, saved with it: World.rep.told_leads)
tell_lead = (person: int) -> str:
    chat_lead(living_world,person,_lead_meets())
# (how often a lead comes up: asked what they've heard, half the time; a third of the table's
# remarks; one passing remark in seven. AEGEAN_LEADS=always: whenever there is one)
_lead_now = (chance: f64) -> bool: env("AEGEAN_LEADS") == "always" or random(0.0, 1.0) < chance

company_greeted = false          # (their first word said: one who has heard of him says so first)
waiter = Waiter()                # (whoever brings what is ordered: the hotel's waiter, the barkeep, the coffee house's boy)
taking = Taking()                # (the pilot and what is in front of him)
table_input = TableBarResult()   # (the table's keys and buttons, last frame)
table_put = false                # (Esc with something in hand: put it down)
held_capture = false             # (a capture holds the drink at the lips)
service_frozen = false           # (a capture stops the waiter where he is)
# (the hotel's staff in theirs: the waiter's white jacket and long apron, the barkeep's waistcoat,
# the errand boy's cap; src/wardrobe.jo)
waiter_fig = build_outfit_figure(waiter_outfit(), 311, age = 34)
barkeep_fig = build_outfit_figure(barkeep_outfit(), 77, age = 52)
boy_fig = build_outfit_figure(errand_boy_outfit(), 905, age = 14)
tray_mesh = build_tray()
band_cue = NoteCue()             # (notes rising from the band, src/note_cue.jo)
street_cue = NoteCue()           # (and from the street musician one hears)
street_player = -1               # (the folk playing: the nearest, as src/life_audio.jo hears only them)
street_feed = LiveNoteFeed()     # (their phrase about now: src/street_phrase.jo)
band_heard = LiveHearing()       # (how the band is heard from the camera: for the notes' fade)
fork_mesh = build_fork()
# tavli at the coffee house (src/tavli.jo, src/tavli_view.jo)
tavli_game = TavliGame()
tavli_view = TavliView()
tavli_with = -1                 # (the townsperson across the board)
tavli_stake = 0
tavli_games = 0                 # (games this session: each game's dice differ)
tavli_choices: int[]            # (partners offered, then stakes)
tavli_step = 0                  # (choosing: 0 a partner, 1 the stake)
tavli_plakoto = false           # (the game chosen: Portes or Plakoto)
tavli_sounds: TavliSounds?      # (made the first time a game is played, when there is sound)
tavli_fig_of = -1               # (the opponent's figure, built for whoever sits across the table)
tavli_fig: Figure? = none
tavli_board_mesh: Mesh? = none

# where the opponent sits: across the coffee house's table from the pilot, facing him
tavli_across = () -> vec3:
    p = coffee.table * 2.0 - coffee.seat
    vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)

# the opponent at the table and the board between them, while a game is on
draw_tavli_table = (L: Light):
    global tavli_fig_of, tavli_fig, tavli_board_mesh
    if not (ui == .leisure and leisure_ui == 7) or tavli_with < 0 or not coffee.ok: return
    if tavli_fig_of != tavli_with or tavli_fig == none:
        p = living_world.people[tavli_with]
        tavli_fig = person_figure(p)
        tavli_fig_of = tavli_with
    pose = tb_gesture_pose(tavli_view)
    if let fig = tavli_fig: draw_figure(fig, tavli_across(), coffee.seat_yaw + PI, 0.0, 0.0, L, t, posture = 1, arms = pose.0, bounce = pose.1, spread = pose.2)
    draw(obj_sh, tavli_board(), obj_params(L, t, translation(coffee.table) * rotation_y(coffee.seat_yaw)))

# the board (open: its two halves' points), made once
tavli_board = () -> Mesh:
    global tavli_board_mesh
    if let m = tavli_board_mesh: return m
    vs: Vertex3D[]
    add_box(vs, vec3(0, 0.025, 0), vec3(0.52, 0.05, 0.38), rgb(0.33, 0.2, 0.12))
    add_box(vs, vec3(-0.13, 0.052, 0), vec3(0.22, 0.01, 0.32), rgb(0.72, 0.55, 0.34))
    add_box(vs, vec3(0.13, 0.052, 0), vec3(0.22, 0.01, 0.32), rgb(0.72, 0.55, 0.34))
    add_box(vs, vec3(0, 0.052, 0), vec3(0.03, 0.012, 0.36), rgb(0.22, 0.13, 0.08))
    m = custom_mesh(vs)
    tavli_board_mesh = m
    m

# The house's tavli board, closed, and the day's paper folded on the pilot's table at the coffee
# house: there to be tapped (src: foot_things, seat_things). The board is open between the two
# players while a game is on (draw_tavli_table).
coffee_paper_mesh: Mesh? = none
draw_coffee_things = (L: Light):
    global coffee_paper_mesh
    if not coffee.ok or f64(length(coffee.table - scene_camera())) > 60.0: return
    yaw = coffee.seat_yaw
    # (closed: half the board's width, twice as deep, the halves folded together)
    if not (ui == .leisure and leisure_ui == 7):
        bp = obj_params(L, t, translation(coffee_board_at()) * rotation_y(yaw + 0.12) * scaling(vec3(0.52, 1.6, 1.0)))
        draw(obj_sh, tavli_board(), bp)
        look_capture(look_coffee == "tavli")
        look_take(tavli_board(), bp.model)
        look_capture(false)
    if coffee_paper_mesh == none:
        vs: Vertex3D[]
        add_box(vs, vec3(0, 0.008, 0), vec3(0.3, 0.016, 0.21), rgb(0.88, 0.85, 0.76))
        loop k in 0..5: add_box(vs, vec3(-0.05, 0.0165, f32(-0.07 + f64(k) * 0.03)), vec3(0.16, 0.002, 0.012), rgb(0.42, 0.4, 0.37))
        add_box(vs, vec3(0.0, 0.0165, -0.09), vec3(0.26, 0.002, 0.02), rgb(0.2, 0.19, 0.18))
        coffee_paper_mesh = custom_mesh(vs)
    if let m = coffee_paper_mesh:
        pp = obj_params(L, t, translation(coffee_paper_at()) * rotation_y(yaw - 0.35))
        draw(obj_sh, m, pp)
        look_capture(look_coffee == "paper")
        look_take(m, pp.model)
        look_capture(false)

# the camera from the pilot's chair, turned so the opponent's face sits in the panel's window
tavli_camera = () -> bool:
    if not (ui == .leisure and leisure_ui == 7) or tavli_with < 0 or not coffee.ok: return false
    g = tavli_window()
    if g.w <= 0.0: return false
    toward = normalize(vec3(coffee.table.x - coffee.seat.x, 0, coffee.table.z - coffee.seat.z) + vec3(0.0001, 0, 0))
    side = vec3(-toward.z, 0, toward.x)
    eye = coffee.seat + vec3(0, 1.5, 0) - toward * 0.55 + side * 0.35
    # (over the pilot's shoulder: the opponent from the chest up, the board on the table between)
    camera_into_window(eye, tavli_across() + vec3(0, 1.2, 0), 1.1, g)
    true
# the newspaper at the coffee house (src/newspaper.jo, src/newspaper_view.jo)
paper_today = Paper(title = "", dateline = "")
paper_view = PaperView()
# fishing from a dock (src/fishing.jo)
angling = Angling()
fishing_frozen = false          # (captures: the float held where it is)

struct TimeSkip:
    active = false
    left = 0                    # minutes still to pass
    total = 0
    doing = ""
    fade = 0.0
    after = 0                   # 1: wake at the hotel's door; 3: wake in the room of a stay; else where one was
    folded = false
    visible = false             # (a stay's: the room seen while time passes, no dark card)
    rate = 15                   # (minutes passed a frame)
skip = TimeSkip()

# (the menu's search line has the keyboard: letters don't also work the game's keys)
leisure_typing = () -> bool: ui == .leisure and (leisure_ui == 0 or leisure_ui == 15 or leisure_ui == 16 or leisure_ui == 18 or leisure_ui == 19 or leisure_ui == 13 or leisure_ui == 14 or leisure_ui == 1 or leisure_ui == 7 or leisure_ui == 9 or leisure_ui == 10 or leisure_ui == 12)

leisure_place = (key: str) -> LeisurePlace: if key == "coffee": coffee_place else: hotel_place
leisure_items = (key: str) -> MenuItem[]: if key == "coffee": coffee_menu else: hotel_menu
leisure_keeper = (key: str) -> str: split(living_world.people[leisure_place(key).keeper].name, " ")[0]

# the hour by the world's clock (the bar room opens by it)
room_hour = () -> f64: f64(lt.local_minute(living_world.minute)) / 60.0

# where one sits (or, at the bar, stands) and which way one faces
# (at the bar: the second stool, the figure raised to its seat)
leisure_seat = (key: str) -> vec3: if key == "coffee": coffee.seat else: if key == "bar": hotel.stools[1] else: if key == "guest": guest_seat else: hotel.seat
leisure_seat_yaw = (key: str) -> f64: if key == "coffee": coffee.seat_yaw else: if key == "bar": hotel.bar_yaw else: if key == "guest": guest_yaw else: hotel.seat_yaw

# The chair across someone else's table on the hotel's terrace, sat at as their guest ("Mind if I
# sit?" in talk with them; the "guest" sitting key): the seat, the way it faces, and the table's
# service (set by leisure_sit_with).
guest_seat = vec3(0, 0, 0)
guest_yaw = 0.0
guest_spots = ServiceSpots(vec3(0, 0, 0), vec3(0, 0, 0), vec3(0, 0, 0), vec3(1, 0, 0), vec3(0, 0, 1))

leisure_sit = (key: str):
    global ui, leisure_ui, leisure_at, leisure_spent, leisure_had, me, follow, waiter, taking
    # (sitting down at the hotel is a cut: its places, terrace or bar room, as they should be now)
    if key != "coffee": room_go_in(hotel, room_hour(), weather_here.rain, weather_here.storm)
    seat = leisure_seat(key)
    me.pos = vec3(seat.x, f32(walk_height(towns, f64(seat.x), f64(seat.z)) + (if key == "bar": STOOL_LIFT else: 0.0)), seat.z)
    me.yaw = leisure_seat_yaw(key)
    me.stride = 0.0
    # (the view about the seat, from behind a shoulder, at a seated head's height)
    follow.yaw = me.yaw + PI + 0.3; follow.distance = 3.2; follow.pitch = 0.22; follow.height = 1.25
    global company
    company = company_plan(key == "bar", random(0.0, 1.0), random(0.0, 1.0), t, rep_welcome(living_world, rep_town_of_place(living_world, leisure_place(key).place)))
    if let at = env("AEGEAN_COMPANY"): company.due = t + (to_float(at) ?? 2.0)
    leisure.sitting = key; leisure.served = []; leisure.coming = []
    waiter = Waiter(); taking = Taking()
    # (back at the table before it was cleared: everything as it was left; a guest's table only
    # if it is the same table)
    global left_table, left_key, clear_waiter
    if left_key == key and left_table.len() > 0 and length(left_spots.table - service_spots(key).table) < 0.5:
        leisure.served = left_table
        left_table = []; left_key = ""; clear_waiter = Waiter()
    leisure_at = key; leisure_spent = 0; leisure_had = []
    ui = .leisure; leisure_ui = 0
    mouse_lock(false)

leisure_stand = ():
    global ui, follow
    if leisure_spent > 0:
        log_note(notebook, "At {leisure_place(leisure.sitting).name}: {join(leisure_had, ", ")}. {phoenix_text(leisure_spent)}.", clock_text(living_world, living_world.minute))
    global waiter, taking
    # (off the stool, onto the deck)
    if leisure.sitting == "bar": me.pos = vec3(me.pos.x, f32(walk_height(towns, f64(me.pos.x), f64(me.pos.z))), me.pos.z)
    # (what is on the table stays there, as it is, until someone comes to clear it; what was in
    # hand goes back down first)
    global left_table, left_key, left_spots, left_at, clear_waiter
    if leisure.served.len() > 0:
        left_table = [loop s in leisure.served: Served(s.item, s.minute, s.seat, amount = s.amount, empty_for = s.empty_for, still = s.still)]
        left_key = leisure.sitting; left_spots = service_spots(leisure.sitting); left_at = t
        clear_waiter = Waiter()
    leisure.sitting = ""; leisure.served = []; leisure.coming = []
    set_life_reserved_seat(none)
    waiter = Waiter(); taking = Taking()
    follow.distance = 5.5; follow.height = 1.6
    ui = .none

# the card on the table (the board, at the coffee house)
leisure_open_menu = (key: str):
    global ui, leisure_ui, leisure_at, menu_view
    ui = .leisure; leisure_ui = 13; leisure_at = key
    menu_view.remark = ""; menu_view.line = ""
    mouse_lock(false)

# the house's whole book, for one who asks
leisure_open_book = (key: str):
    global ui, leisure_ui, leisure_at, menu_view
    ui = .leisure; leisure_ui = 1; leisure_at = key
    menu_view.fresh = true; menu_view.remark = ""; menu_view.line = ""
    mouse_lock(false)

leisure_skip = (minutes: int, doing: str, after: int = 0):
    global skip
    skip = TimeSkip(active = true, left = minutes, total = minutes, doing = doing, after = after)

# Any table on the terrace (while dining is out there, not in the bar room for the rain): the free
# chair nearest `p` within `reach`, as (table, chair), or (-1, -1). A chair someone sits on, or
# just stands at, is not free.
hotel_sit_target: vec3? = none       # (the chair a tap on a table walked him to)
hotel_free_chair = (p: vec3, reach: f64) -> (int, int):
    if not hotel.ok or bar_room.level == 2: return (-1, -1)
    best = (-1, -1); bd = reach
    loop k in 0..hotel_table_count():
        loop c in 0..hotel_chair_count(k):
            at = hotel_chair(hotel, k, c)
            d = f64(length(vec3(at.x - p.x, 0, at.z - p.z)))
            if d >= bd: continue
            taken = false
            loop f in folks:
                if f.shown and f64(length(vec3(f.pos.x - at.x, 0, f.pos.z - at.z))) < 0.55: taken = true
            if not taken: best = (k, c); bd = d
    best

# what one can do here, on foot (the card says it; F does it)
leisure_prompt = () -> str:
    if me.mode != .walking or holding_cargo() >= 0 or not hotel.ok: return ""
    if hotel_free_chair(me.pos, 2.4).0 >= 0: return "F  sit at a table on the terrace"
    if f64(length(me.pos - hotel.seat)) < 2.4: return if room_point_inside(hotel, hotel.seat): "F  sit at a table" else: "F  sit at a table on the terrace"
    if f64(length(me.pos - hotel.counter)) < 2.4: return "F  order at the bar"
    if f64(length(me.pos - hotel.desk)) < 2.8: return if hotel_room_paid(): "F  go up to your room" else: "F  ask at the desk for a room"
    if tip_jar_here(): return "F  tip the band"
    if coffee.ok and f64(length(me.pos - coffee.seat)) < 2.4: return "F  sit at the coffee house"
    if f64(length(me.pos - hotel.barber_seat)) < 1.6: return "F  a shave at the barber's"
    if fishing_here() and not fish_in_hand(fish): return "F  fish from the dock"
    ""

# a room at the hotel paid for, its night not yet over (taken at the desk: till eleven next morning)
hotel_room_until = -1
hotel_room_paid = () -> bool: hotel_room_until > living_world.minute

leisure_act = ():
    global ui, leisure_ui, leisure_at, leisure_line
    said = leisure_prompt()
    if said.contains("tip the band"):
        ui = .leisure; leisure_ui = 20; leisure_line = ""
        mouse_lock(false)
    else if said.contains("sit at a table"):
        # (at whichever table he is by: the nearest free chair there is his)
        # (walked over to a table: its chair; else the nearest free one)
        global hotel_sit_target
        ch = hotel_free_chair(me.pos, 2.4)
        if let at = hotel_sit_target:
            exact = hotel_free_chair(at, 0.3)
            if exact.0 >= 0: ch = exact
        hotel_sit_target = none
        if ch.0 >= 0: hotel_take_table(hotel, ch.0, ch.1)
        if foot_go_script != "": print("FOOT table {ch.0} chair {ch.1} seat {hotel.seat.x:.1} {hotel.seat.z:.1}")
        leisure_sit("hotel")
        # (his chair is his: the evening's patrons are sent to the others)
        set_life_reserved_seat(hotel.seat)
    else if said.contains("barber"): barber_begin()
    else if said.contains("order at the bar"):
        leisure_sit("bar")
        leisure_open_menu("bar")
    else if said.contains("your room"): stay_begin_hotel()
    else if said.contains("desk"):
        ui = .leisure; leisure_ui = 2; leisure_at = "hotel"; leisure_line = ""
        mouse_lock(false)
    else if said.contains("coffee"): leisure_sit("coffee")
    else if said.contains("fish"): fishing_begin()

# ---------------- the world by its things ----------------
# On foot, the things themselves are tapped or clicked, rather than their cards: one's own
# aircraft (climb aboard at the cockpit, work on her at the engine), the pilot's table, the bar's
# stool, the hotel's desk, the barber's chair, the tip jar and the band's stand, the coffee house's
# table, its tavli board and the paper on it, and the people about. He walks over until what the
# card would offer is in reach, and does it, just as its key does (the keys work as ever). Sitting,
# the band, the tip jar, the board and the paper are tapped the same way.
struct FootThing:
    act: str                        # (the walk_offers act it does there: "aboard", "tinker", "leisure", "talk"; "" on reaching `stand`)
    sub: str                        # (words that offer must have: "tip the band"; "" any)
    then: str                       # (once there, or sat down: "tavli", "paper", "song", "tip"; "" nothing more)
    label: str
    lo: vec3                        # (its box, in its own frame: about `origin`, turned by `rot`)
    hi: vec3
    stand: vec3                     # (where he walks to, in the world)
    origin: vec3 = vec3(0, 0, 0)
    rot: vec4 = vec4(0, 0, 0, 1)
    folk = -1                       # (a person, by the scene's folk)

_box_at = (c: vec3, half: vec3, up: f64) -> (vec3, vec3): (vec3(c.x - half.x, c.y, c.z - half.z), vec3(c.x + half.x, f32(f64(c.y) + up), c.z + half.z))

_thing = (act: str, sub: str, then: str, label: str, c: vec3, half: vec3, up: f64, stand: vec3) -> FootThing:
    lo, hi = _box_at(c, half, up)
    FootThing(act, sub, then, label, lo, hi, stand)

# where he stands to reach a thing: a step out from it toward him (not in the piano the jar is on)
_step_out = (at: vec3, by: f64) -> vec3:
    d = vec3(me.pos.x - at.x, 0, me.pos.z - at.z)
    l = f64(length(d))
    g = if l > 0.01: at + d * f32(min(by, l) / l) else: at
    vec3(g.x, me.pos.y, g.z)

# the coffee house's tavli board and its paper, on the pilot's table there
coffee_board_at = () -> vec3: coffee.table + coffee.table_x * 0.22
coffee_paper_at = () -> vec3: coffee.table - coffee.table_x * 0.24 + coffee.table_z * 0.05

# Whether he can walk there: on the same side of the bar room's walls (his walk slides round
# tables and chairs, not through a wall). The hotel's desk is at its door, reached from either side.
way_clear = (a: vec3, b: vec3) -> bool: room_point_inside(hotel, a) == room_point_inside(hotel, b)

# (made once a frame: the hover, the cards, the gleam and the tap all ask)
foot_things_frame = -1
foot_things_kept: FootThing[] = []
foot_things = () -> FootThing[]:
    global foot_things_frame, foot_things_kept
    if foot_things_frame != frame_number():
        foot_things_kept = [loop th in _foot_things_now(): if th.act == "aboard" or th.act == "tinker" or th.sub == "desk" or th.sub == "your room" or way_clear(me.pos, th.stand): th]
        foot_things_frame = frame_number()
    foot_things_kept

_foot_things_now = () -> FootThing[]:
    out: FootThing[]
    if me.mode != .walking or holding_cargo() >= 0 or swim.active or gaze.active or leisure.sitting != "" or stay.active: return out
    # (one's own aircraft at her mooring)
    if pc.state.moored and f64(length(pc.state.position - me.pos)) < 45.0:
        m = player_model()
        q = pc.state.orientation; p = pc.state.position
        c = m.cockpit
        out.push(FootThing("aboard", "", "", if paint_job.active: "In the paint shop" else: "Climb aboard", c - vec3(0.75, 1.3, 1.1), c + vec3(0.75, 0.45, 1.1), p, origin = p, rot = q))
        e = m.prop_at; r = f32(min(m.prop_radius, 1.1))
        out.push(FootThing("tinker", "", "", "Work on her", e - vec3(r, r, 0.7), e + vec3(r, r, 0.7), p, origin = p, rot = q))
    if hotel.ok and f64(length(me.pos - hotel.counter)) < 45.0:
        # (any table on the terrace: a tap on it walks him to its nearest free chair; inside for the
        # rain, his own table there)
        if bar_room.level == 2:
            tb = hotel.table
            out.push(_thing("leisure", "sit at a table", "", "Sit", tb - vec3(0, 0.8, 0), vec3(0.55, 0, 0.55), 0.95, hotel.seat))
        else:
            loop k in 0..hotel_table_count():
                top = hotel_table_top(hotel, k)
                ch = hotel_free_chair(top, 2.0)
                if ch.0 != k: continue
                # (the chair on the aisle's side, when it is free: the one reached first)
                aisle = if k < hotel_table_count() - 1 and hotel_free_chair(hotel_chair(hotel, k, AISLE_CHAIR), 0.3).1 == AISLE_CHAIR: AISLE_CHAIR else: ch.1
                out.push(_thing("leisure", "sit at a table", "", "Sit", top - vec3(0, 0.8, 0), vec3(0.6, 0, 0.6), 0.95, hotel_chair(hotel, k, aisle)))
        if hotel.stools.len() > 1:
            out.push(_thing("leisure", "order at the bar", "", "Sit at the bar", hotel.stools[1], vec3(0.3, 0, 0.3), 0.85, hotel.counter))
        out.push(_thing("leisure", if hotel_room_paid(): "your room" else: "desk", "", if hotel_room_paid(): "Your room" else: "Ask for a room", hotel.desk, vec3(0.6, 0, 0.6), 2.2, _step_out(hotel.desk, 0.8)))
        out.push(_thing("leisure", "barber", "", "A shave", hotel.barber_seat, vec3(0.4, 0, 0.4), 1.3, _step_out(hotel.barber_seat, 0.8)))
        if band_evening(living_world) or living_world.band.index >= 0:
            jar = band_jar_at(hotel)
            out.push(_thing("leisure", "tip the band", "", "Tip the band", jar - vec3(0, 0.05, 0), vec3(0.2, 0, 0.2), 0.45, _step_out(jar, 1.4)))
        if leisure_open(living_world, hotel_place):
            out.push(_thing("", "", "song", "Ask for a song", hotel.stage, vec3(1.6, 0, 1.6), 2.4, hotel.stage + hotel.stage_out * 2.6))
    if coffee.ok and f64(length(me.pos - coffee.seat)) < 45.0:
        out.push(_thing("leisure", "coffee", "tavli", "A game of tavli", coffee_board_at(), vec3(0.28, 0, 0.22), 0.12, coffee.seat))
        out.push(_thing("leisure", "coffee", "paper", "The paper", coffee_paper_at(), vec3(0.2, 0, 0.16), 0.08, coffee.seat))
        out.push(_thing("leisure", "coffee", "", "Sit", coffee.table - vec3(0, 0.8, 0), vec3(0.5, 0, 0.5), 0.95, coffee.seat))
    # (the springs: the keeper at the bathhouse door, the hot pool)
    bk = bath_site_here()
    if bk >= 0 and bath.stage != .soaking and bath.stage != .changing:
        site = THERMAL_SITES[bk]
        kp = bath_keeper_at(site)
        paid = bath_paid_today(bath, lt.day_index(living_world.minute), bk)
        out.push(_thing("", "", "bath-keeper", if paid: "The keeper" else: "The waters", kp, vec3(0.35, 0, 0.35), 1.85, kp + _site_dir(site, 0.0) * 1.1))
        pl = thermal_pool(site)
        out.push(_thing("", "", "bath-pool", "Get in", pl - vec3(0, 0.5, 0), vec3(4.6, 0, 4.6), 0.75, me.pos))
    # (a paint shop: its bench of pots, tapped, walks him to the workshop to ask)
    loop shed in paint_sheds:
        if f64(length(shed.stand - me.pos)) < 45.0:
            out.push(_thing("", "", "paint-shop", "The paint shop", shed.bench - vec3(0, 0.9, 0), vec3(2.5, 0, 0.55), 2.3, shed.stand))
    # (the people about: over to them, and talk)
    loop k in 0..folks.len():
        f = folks[k]
        if not f.shown or f.performing or f.person == living_world.player: continue
        if f64(length(f.pos - me.pos)) > 18.0: continue
        th = _thing("talk", "", "", split(living_world.people[f.person].name, " ")[0], f.pos, vec3(0.32, 0, 0.32), 1.85, f.pos)
        th.folk = k
        out.push(th)
    out

# Sitting at a table or the bar: the band's stand, the tip jar, the board and the paper.
seat_things = () -> FootThing[]:
    out: FootThing[]
    key = leisure.sitting
    if key == "" or ui != .leisure or leisure_ui != 0: return out
    if key == "coffee":
        out.push(_thing("", "", "tavli", "A game of tavli", coffee_board_at(), vec3(0.28, 0, 0.22), 0.12, coffee.seat))
        out.push(_thing("", "", "paper", if leisure.paper_day == lt.day_index(living_world.minute): "Read the paper" else: "Buy the paper", coffee_paper_at(), vec3(0.2, 0, 0.16), 0.08, coffee.seat))
        return out
    if leisure_open(living_world, hotel_place): out.push(_thing("", "", "song", "Ask for a song", hotel.stage, vec3(1.6, 0, 1.6), 2.4, hotel.stage))
    if band_evening(living_world) or living_world.band.index >= 0: out.push(_thing("", "", "tip", "Tip the band", band_jar_at(hotel) - vec3(0, 0.05, 0), vec3(0.2, 0, 0.2), 0.45, band_jar_at(hotel)))
    out

# what a point on the screen is on, of those (-1 nothing); the nearest thing first
# (a thing far off is a small mark for a finger: its box grows a little with distance, a centimetre
# and a half a metre, up to a metre)
foot_pick = (things: FootThing[], p: vec2) -> int:
    o, d = screen_ray(p)
    best = -1; bt = 60.0
    loop k in 0..things.len():
        th = things[k]
        inv = quat_inverse(th.rot)
        far = f64(length(thing_top(th) - o))
        g = f32(clamp(far * 0.015, 0.0, 1.0))
        tt = ray_box(quat_rotate(inv, o - th.origin), quat_rotate(inv, d), th.lo - vec3(g, g * 0.5, g), th.hi + vec3(g, g * 0.5, g))
        if tt >= 0.0 and tt < bt: best = k; bt = tt
    best

_on_screen = (p: vec3) -> bool:
    if let sp = world_to_screen(p): return f64(sp.x) > 0.0 and f64(sp.x) < f64(screen_width()) and f64(sp.y) > 0.0 and f64(sp.y) < f64(screen_height())
    false

# the top of a thing's box, in the world (for its label and its gleam)
thing_top = (th: FootThing) -> vec3: th.origin + quat_rotate(th.rot, vec3((th.lo.x + th.hi.x) * 0.5, th.hi.y, (th.lo.z + th.hi.z) * 0.5))

# ---------------- the look ----------------
# On foot, the thing the view looks at is lit: what a ray from the camera through the screen's
# middle meets, or else a thing within a few degrees of it (the one nearest that ray, then the
# nearest the eye). It goes by where the camera looks, not where he faces, so it is the same with
# the mouse locked to the view or not, and on a touch screen, where it shows what a tap there would
# do. A click uses it. His own body is never one of the things (foot_things).
LOOK_CONE = 0.06                    # (radians: about three and a half degrees round the middle)
LOOK_SWEEP = 3.2                    # (seconds for the band of light to cross the thing, and again)

foot_look = (things: FootThing[]) -> int:
    o, d = screen_ray(vec2(f32(f64(screen_width()) * 0.5), f32(f64(screen_height()) * 0.5)))
    best = -1; ba = LOOK_CONE; bt = 60.0
    loop k in 0..things.len():
        th = things[k]
        inv = quat_inverse(th.rot)
        lo = quat_rotate(inv, o - th.origin); ld = quat_rotate(inv, d)
        # (the eye inside its box, as wading in the springs' pool: not looked at)
        if clamp(lo, th.lo, th.hi) == lo: continue
        a = 0.0
        tt = ray_box(lo, ld, th.lo, th.hi)
        if tt < 0.0:
            # (missed: the box's point nearest the ray, stepping between the two a few times)
            s = max(f64(dot((th.lo + th.hi) * 0.5 - lo, ld)), 0.1)
            q = lo
            loop _ in 0..5:
                q = clamp(lo + ld * f32(s), th.lo, th.hi)
                s = max(f64(dot(q - lo, ld)), 0.1)
            tt = f64(length(q - lo))
            if tt < 0.05: continue
            a = acos(clamp(f64(dot(q - lo, ld)) / tt, -1.0, 1.0))
        if tt > 60.0 or a > LOOK_CONE: continue
        if a < ba - 0.002 or (a < ba + 0.002 and tt < bt): best = k; ba = min(a, ba); bt = tt
    best

# a thing's box on the screen: the outline round its eight corners, a few points out (empty when
# a corner is behind the eye)
thing_outline = (th: FootThing) -> vec2[]:
    ps: vec2[]
    loop k in 0..8:
        c = vec3(if k % 2 == 1: th.hi.x else: th.lo.x, if (k / 2) % 2 == 1: th.hi.y else: th.lo.y, if k / 4 == 1: th.hi.z else: th.lo.z)
        if let sp = world_to_screen(th.origin + quat_rotate(th.rot, c)): ps.push(sp)
        else: return []
    h = _hull(ps)
    if h.len() < 3: return h
    mid = _outline_mid(h)
    [loop p in h: (if length(p - mid) > 0.5: p + normalize(p - mid) * 3.0 else: p)]

_outline_mid = (h: vec2[]) -> vec2:
    mid = vec2(0, 0)
    loop p in h: mid = mid + p
    mid / f32(max(h.len(), 1))

# the convex outline round some points (gift wrapping: a box's eight corners)
_hull = (ps: vec2[]) -> vec2[]:
    out: vec2[]
    n = ps.len()
    if n < 3: return out
    start = 0
    loop k in 1..n:
        if ps[k].x < ps[start].x or (ps[k].x == ps[start].x and ps[k].y < ps[start].y): start = k
    cur = start
    loop _ in 0..n + 1:
        out.push(ps[cur])
        nxt = (cur + 1) % n
        loop k in 0..n:
            c = f64(cross(ps[nxt] - ps[cur], ps[k] - ps[cur]))
            if c < -1e-6 or (abs(c) <= 1e-6 and length(ps[k] - ps[cur]) > length(ps[nxt] - ps[cur])): nxt = k
        cur = nxt
        if cur == start: break
    out

# the part of a convex outline on one side of a line (dot(p, n) below c, or above it)
_clip_side = (ps: vec2[], n: vec2, c: f64, below: bool) -> vec2[]:
    out: vec2[]
    m = ps.len()
    loop k in 0..m:
        a = ps[k]; b = ps[(k + 1) % m]
        da = f64(dot(a, n)) - c; db = f64(dot(b, n)) - c
        if not below: da = -da; db = -db
        if da <= 0.0: out.push(a)
        if (da < 0.0 and db > 0.0) or (da > 0.0 and db < 0.0): out.push(a + (b - a) * f32(da / (da - db)))
    out

# whether a point is inside a convex outline (either way round)
_in_outline = (ps: vec2[], p: vec2) -> bool:
    pos = false; neg = false
    loop k in 0..ps.len():
        c = cross(ps[(k + 1) % ps.len()] - ps[k], p - ps[k])
        if c > 0.0: pos = true
        if c < 0.0: neg = true
    not (pos and neg)

_look_hash = (x: f64) -> f64: fract(sin(x * 12.9898 + 78.233) * 43758.5453)

# The lit thing: a thin white line round it, and a soft band of light passing slowly down over it,
# slanted a little, with a few flecks in it like a bar of static over a paused screen; then from
# the top again. Faint, with a dark edge under the line for a pale wall or a sunlit dock.
# the look's line width unit, in the screen's own pixels (a 2D unit, larger on a phone, as the box's)
look_unit = () -> f64: f64(__screen_px_h()) / f64(max(screen_height(), 1)) * min(readable(1.0), 1.5)

draw_look = (th: FootThing, age: f64):
    h = thing_outline(th)
    if h.len() < 3: return
    s = min(readable(1.0), 1.5)
    fade = clamp(age / 0.18, 0.0, 1.0)
    # (the band: across the slant, from just above the outline to just below it)
    n = normalize(vec2(0.32, 1.0))
    m0 = 1e9; m1 = -1e9
    loop p in h:
        u = f64(dot(p, n))
        m0 = min(m0, u); m1 = max(m1, u)
    w = clamp((m1 - m0) * 0.2, 8.0 * s, 56.0 * s)
    c = m0 - w + (m1 - m0 + w * 2.0) * fract(age / LOOK_SWEEP)
    peak = 0.24 * fade
    loop half in 0..2:
        a = if half == 0: c - w else: c
        b = if half == 0: c else: c + w
        part = _clip_side(_clip_side(h, n, a, false), n, b, true)
        if part.len() < 3: continue
        al = [loop p in part: f32(peak * max(0.0, 1.0 - abs(f64(dot(p, n)) - c) / w))]
        loop k in 1..part.len() - 1:
            triangle_gradient(part[0], part[k], part[k + 1], rgba(1, 1, 1, al[0]), rgba(1, 1, 1, al[k]), rgba(1, 1, 1, al[k + 1]))
    # (the flecks: short dashes along the band, new ones twelve times a second)
    along = vec2(n.y, -n.x)
    tick = floor(age * 12.0)
    v0 = 1e9; v1 = -1e9
    loop p in h:
        v = f64(dot(p, along))
        v0 = min(v0, v); v1 = max(v1, v)
    loop k in 0..14:
        r1 = _look_hash(tick * 7.31 + f64(k) * 1.7); r2 = _look_hash(tick * 3.17 + f64(k) * 5.3); r3 = _look_hash(tick + f64(k) * 9.1)
        # (across the band, crowded to its middle; along it, anywhere over the outline)
        u = c + (r1 - 0.5) * w * 1.2
        v = v0 + (v1 - v0) * r2
        p = n * f32(u) + along * f32(v)
        l = (2.0 + 6.0 * r3) * s
        e0 = p - along * f32(l * 0.5); e1 = p + along * f32(l * 0.5)
        if _in_outline(h, e0) and _in_outline(h, e1):
            line(e0, e1, 1.0 * s, rgba(1, 1, 1, f32(fade * (0.08 + 0.22 * r3) * max(0.0, 1.0 - abs(u - c) / w))))
    # (the line round it)
    polyline(h, 3.2 * s, rgba(0, 0, 0, f32(0.16 * fade)), closed = true)
    polyline(h, 1.3 * s, rgba(1, 1, 1, f32(0.72 * fade)), closed = true)

foot_goal = -1                      # (a thing he's walking over to: going while >= 0)
foot_goal_act = ""
foot_goal_sub = ""
foot_goal_then = ""
foot_goal_folk = -1
foot_goal_at = vec3(0, 0, 0)
foot_goal_since = 0.0
foot_route: vec3[] = []             # (the points after foot_goal_at: the bath's stairs)
foot_goal_best = 1e9                # (the nearest he's got, and when)
foot_goal_best_t = -1.0
foot_then = ""                      # (to do once the card's act has been done: sat down, then the board)
foot_hover = -1                     # (the thing the view looks at, lit: foot_look; a click uses it)
foot_hover_since = 0.0              # (since when it has been that thing: the sweep starts from its top)
look_trace = env("AEGEAN_LOOK_TRACE") == "1"   # (captures: a LOOK line each time the view comes to look at another thing)
seat_hover = -1
seat_press = vec2(-1, -1)
talk_pick = -1                      # (the person a click or tap chose to talk to, over the nearest)

foot_go = (things: FootThing[], k: int):
    global foot_goal, foot_goal_act, foot_goal_sub, foot_goal_then, foot_goal_folk, foot_goal_at, foot_goal_since
    if k < 0 or k >= things.len(): return
    th = things[k]
    foot_goal = k; foot_goal_act = th.act; foot_goal_sub = th.sub; foot_goal_then = th.then; foot_goal_folk = th.folk
    foot_goal_at = th.stand; foot_goal_since = t
    bath_route_to(th.stand)
    # (a table on the terrace: by the aisle, round the other tables, to its chair)
    if th.sub == "sit at a table" and hotel.ok and bar_room.level != 2:
        ch = hotel_free_chair(th.stand, 0.3)
        if ch.0 >= 0:
            global foot_route
            way = hotel_table_way(hotel, me.pos, ch.0, ch.1)
            foot_goal_at = way[0]; way.remove_at(0); foot_route = way

# What comes after: the board, the paper, the band's request, the tip jar.
run_then = (what: str):
    global ui, leisure_ui, leisure_line, leisure_at
    if what == "tavli": tavli_open_choice()
    else if what == "paper": paper_open()
    else if what == "song":
        ui = .leisure; leisure_ui = 8; leisure_line = ""
        if leisure.sitting == "": leisure_at = "hotel"
        mouse_lock(false)
    else if what == "tip":
        ui = .leisure; leisure_ui = 20; leisure_line = ""
        mouse_lock(false)
    else if what == "picnic": picnic_begin()
    else if what == "paint-shop": paint_shop_ask()
    else if what == "bath-keeper":
        ui = .leisure; leisure_ui = 21; leisure_line = ""
        mouse_lock(false)
    else if what == "bath-change":
        global bath
        bath.stage = .changing; bath.since = t
    else if what == "bath-in":
        global bath
        if bath.costume and bath.stage == .dressed: bath.stage = .getting_in; bath.settle = 0.0; bath.since = t
    else if what == "bath-pool":
        k = bath_site_here()
        if k >= 0: bath_go_in(k)

# The lit thing's label, small, over it (the mouse free).
draw_thing_label = (th: FootThing):
    if let sp = world_to_screen(thing_top(th) + vec3(0, 0.25, 0)):
        set_font(fonts.ui)
        size = readable(15.0)
        w = ptext_width(th.label, size) + 18.0
        x = f64(sp.x) - w * 0.5; y = f64(sp.y) - size * 1.6
        rect_rounded(x, y, w, size * 1.5, size * 0.75, rgba(0.08, 0.07, 0.06, 0.55))
        ptext_centered(th.label, vec2(f32(x + w * 0.5), f32(y + size * 0.75)), size, rgba(1, 0.96, 0.86, 0.95))
        set_font()

# ---------------- the gleam ----------------
# A touch screen has no pointer to hover with: when the view comes to rest, what can be tapped
# near and in view catches the light for a moment (a small soft glint, no words), and again now and
# then while it stays still. Nothing with a mouse or a pad, which light what they point at.
view_still = 0.0                    # (seconds the view has stayed where it is)
view_was = vec3(0, 0, 0)
view_dir_was = vec3(0, 0, 1)

gleam_step = (dt: f64):
    global view_still, view_was, view_dir_was
    eye = scene_camera()
    o, d = screen_ray(vec2(f32(f64(screen_width()) * 0.5), f32(f64(screen_height()) * 0.5)))
    moved = f64(length(eye - view_was)) > 0.01 or f64(dot(d, view_dir_was)) < 0.99995
    view_still = if moved: 0.0 else: view_still + dt
    view_was = eye; view_dir_was = d

# how bright the glint is now: once as the view settles, then every eight seconds while it stays
gleam_now = () -> f64:
    if view_still < 0.5: return 0.0
    ph = (view_still - 0.5) % 8.0
    if ph > 1.3: 0.0 else: sin(PI * ph / 1.3)

_glint = (p: vec2, a: f64, seed: f64):
    if a <= 0.01: return
    # (small on any screen: a phone's larger type doesn't make it larger than a glint)
    s = min(readable(1.0), 1.4)
    c = rgba(1.0, 0.97, 0.86, f32(a * 0.6))
    circle(p, 6.0 * s, rgba(1.0, 0.92, 0.7, f32(a * 0.07)))
    # (a small four-pointed star, turning a little as it comes and goes)
    turn = seed + a * 0.6
    loop k in 0..2:
        ang = turn + f64(k) * PI * 0.5
        dx = cos(ang) * 6.0 * s * a; dy = sin(ang) * 6.0 * s * a
        line(vec2(f32(f64(p.x) - dx), f32(f64(p.y) - dy)), vec2(f32(f64(p.x) + dx), f32(f64(p.y) + dy)), 1.3 * s, c)
    circle(p, 1.8 * s, c)

draw_gleams = ():
    if not pad.on: return
    a = gleam_now()
    if a <= 0.0: return
    eye = scene_camera()
    tops: vec3[] = []
    if stay.active and ui == .leisure and leisure_ui == 15 and not skip.active and not room_busy(room_me):
        loop o in room_objs: tops.push(stay_point(vec3((o.lo.x + o.hi.x) * 0.5, min(o.hi.y, 2.2), (o.lo.z + o.hi.z) * 0.5)))
    else if ui == .leisure and leisure_ui == 0:
        loop th in seat_things(): tops.push(thing_top(th))
    else if ui == .none and me.mode == .walking and foot_goal < 0:
        loop th in foot_things():
            if th.folk < 0 and f64(length(thing_top(th) - eye)) < 14.0: tops.push(thing_top(th))
    loop k in 0..tops.len():
        if let sp = world_to_screen(tops[k]):
            if f64(sp.x) > 0.0 and f64(sp.x) < f64(screen_width()) and f64(sp.y) > 0.0 and f64(sp.y) < f64(screen_height()):
                # (each its own moment, a little apart)
                _glint(sp, max(0.0, a - f64(k) * 0.08), f64(k) * 0.7)

# where a click aims on foot: the screen's middle, where the view looks (the mouse locked to the
# view or not: no pointer on foot)
foot_aim = () -> vec2: vec2(f32(f64(screen_width()) * 0.5), f32(f64(screen_height()) * 0.5))

# the mouse on the sand of a picnic spot, the basket along
picnic_ground_hover = () -> bool:
    if not picnic.basket or picnic.active or me.mode != .walking or ui != .none or pad.on: return false
    if let g = ground_under(foot_aim()):
        if f64(length(g - me.pos)) < 40.0: return picnic_spot_at(g).0
    false

draw_foot_label = ():
    # (the thing the view looks at, lit, no words: on a touch screen too, what a tap there does)
    if ui == .none and foot_hover >= 0 and me.mode == .walking:
        things = foot_things()
        # (by its own shape, where it has a mesh of its own; else its box's outline)
        if foot_hover < things.len() and not draw_look_outline(t - foot_hover_since, look_unit()): draw_look(things[foot_hover], t - foot_hover_since)
    if pad.on: return
    if ui == .none and foot_hover < 0 and picnic_ground_hover():
        if let g = ground_under(foot_aim()):
            draw_thing_label(FootThing("", "", "", "Spread the blanket", g, g, g))
    if seat_hover >= 0:
        things = seat_things()
        if seat_hover < things.len(): draw_thing_label(things[seat_hover])

# time passing: the screen darkens, the scene's people and craft are folded back into the world,
# the world's clock runs on in steps, and the screen comes back
leisure_time_step = (dt: f64):
    global skip, hour, me, folk_sync_t, follow
    bar_music_stop(bar_music)
    hush_audio(audio)
    ambience_hush(world_ambience.sound)
    life_audio.hush_life_audio(life_sound)
    radio.radio_silence(cockpit_radio)
    if skip.left > 0:
        if not skip.visible:
            skip.fade = min(1.0, skip.fade + dt * 2.5)
            if skip.fade < 1.0: return
        if not skip.folded:
            fold_living_scene_for_save(traffic, pc, living_world, traffic_scene)
            skip.folded = true
        step = min(skip.left, skip.rate)
        living.advance_minutes(living_world, step)
        skip.left -= step
        hour = f64(lt.local_minute(living_world.minute)) / 60.0
        if skip.left == 0:
            if skip.after == 2: finish_launch()
            if skip.after == 8: tender_repaired()
            if skip.after == 5: help_after_wait()
            if skip.after == 6: help_arrive()
            if skip.after == 7: help_carried_home()
            if skip.after == 9: help_pilot_home()
            if skip.after == 3: stay_woke()
            if skip.after == 1:
                me.pos = vec3(hotel.desk.x, f32(walk_height(towns, f64(hotel.desk.x), f64(hotel.desk.z))), hotel.desk.z)
                # (facing along the waterfront, the camera behind on the quay, not in the hotel)
                me.yaw = atan2(f64(hotel.table_x.x), f64(hotel.table_x.z))
                follow.yaw = me.yaw + PI
            if skip.after == 12: paint_berth_arrived()
            sync_folk(folks, living_world, towns)
            publish_leisure_venue(living_world, hotel.venue)
            loop shed in paint_sheds: publish_leisure_venue(living_world, paint_shed_venue(shed))
            folk_sync_t = t
        return
    skip.fade = max(0.0, skip.fade - dt * 1.6)
    if skip.fade <= 0.0: skip.active = false


# ---------------- tavli ----------------

tavli_open_choice = ():
    global leisure_ui, leisure_line, tavli_choices, tavli_step
    near: int[]
    order = [loop k in 0..folks.len(): if folks[k].shown and folks[k].place == 0 and f64(length(folks[k].pos - coffee.seat)) < 14.0: k]
    order.sort((k: int) -> f64: f64(length(folks[k].pos - coffee.seat)))
    loop k in order: near.push(folks[k].person)
    tavli_choices = tavli_partners(living_world, coffee_place.place, near)
    tavli_step = 0
    leisure_line = if tavli_choices.len() == 0: "Nobody is free for a game just now. The boards wait in their stack." else: "Who'll take you on?"
    leisure_ui = 6

tavli_begin = (person: int, stake: int):
    global leisure_ui, tavli_game, tavli_view, tavli_with, tavli_stake, tavli_games
    tavli_with = person; tavli_stake = stake
    tavli_games += 1
    tavli_game = tavli_new(living_world, person, stake, tavli_games + leisure.tavli.len() * 7, tavli_plakoto)
    tavli_view = TavliView()
    tb_say(tavli_view, tavli_game, "start")
    leisure_ui = 7
    mouse_lock(false)

tavli_face = () -> TavliFace:
    w = living_world
    name = split(w.people[tavli_with].name, " ")[0]
    record = "Your first game with {name}"
    if let r = tavli_record(leisure.tavli, tavli_with):
        record = "Games with {name}: you {r.wins}, {name} {r.losses}"
        if r.balance != 0: record = "{record}; you are {if r.balance > 0: "up" else: "down"} {phoenix_text(abs(r.balance))}"
    TavliFace(name, w.people[tavli_with].name, "{talk_words.role_noun(w, tavli_with)}, who {tavli_style_words(tavli_game.style)}", tavli_stake_words(tavli_stake), record, player_cents())

# choosing who to play tavli with, then for what
tavli_choice_frame = ():
    global leisure_ui, leisure_line, tavli_with, tavli_step
    w = living_world
    # who to play, then for what
    if tavli_step == 0:
        choices = [loop id in tavli_choices: "{w.people[id].name}, {talk_words.role_noun(w, id)}, who {tavli_style_words(tavli_style(w, id))}"]
        choices.push("Not now")
        r = choice_panel(fonts, "Tavli", "Portes, at the coffee house", leisure_line, choices)
        if r.choice >= 0 and r.choice < tavli_choices.len():
            tavli_with = tavli_choices[r.choice]
            tavli_step = 1
            leisure_line = "{split(w.people[tavli_with].name, " ")[0]} sets out the board. For what?"
        else if r.choice >= 0 or r.closed:
            leisure_ui = 0; leisure_line = ""
    else:
        stakes = tavli_stakes(w, tavli_with)
        choices = [loop s in stakes: (if s == 0: "Just for the game" else: "{phoenix_text(s)} a point")]
        choices.push(if tavli_plakoto: "Play Portes instead (hitting)" else: "Play Plakoto instead (pinning)")
        choices.push("Back")
        game = if tavli_plakoto: "Plakoto: a lone checker landed on is pinned, not hit; pin the other's last at home and win double" else: "Portes: a gammon counts double; giving up a game costs a single point"
        r = choice_panel(fonts, w.people[tavli_with].name, game, leisure_line, choices)
        if r.choice >= 0 and r.choice < stakes.len(): tavli_begin(tavli_with, stakes[r.choice])
        else if r.choice == stakes.len():
            global tavli_plakoto
            tavli_plakoto = not tavli_plakoto
        else if r.choice >= 0 or r.closed:
            tavli_step = 0
            leisure_line = "Who'll take you on?"

# the board, each frame
tavli_capture_gesture = to_int(env("AEGEAN_TAVLI_GESTURE") ?? "") ?? 0   # (captures: 1 a shrug, 2 a slap, 3 a laugh, caught mid-way)
tavli_frame = ():
    global leisure_ui, leisure_line, tavli_sounds, tavli_view
    if tavli_capture_gesture > 0 and frame_number() == (to_int(env("SLOPPY_FRAMES") ?? "0") ?? 0) - 12: tb_gesture(tavli_view, tavli_capture_gesture)
    act = tavli_panel(fonts, tavli_game, tavli_view, tavli_face())
    if audio_enabled and tavli_view.sounds.len() > 0:
        if tavli_sounds == none: tavli_sounds = make_tavli_sounds()
        if let bank = tavli_sounds: play_tavli_sounds(bank, tavli_view.sounds, frame_number(), 0.7)
    tavli_view.sounds = []
    if act.resign: tavli_resign(tavli_game, 0)
    if act.finished:
        s = tavli_settle(living_world, tavli_game, leisure.tavli)
        tavli_view.result = s.message
        name = split(living_world.people[tavli_with].name, " ")[0]
        log_note(notebook, "Tavli with {name} at the coffee house: {if tavli_game.winner == 0: "won" else: "lost"}{if tavli_game.points == 2: " a gammon" else: ""}{if s.cents != 0: ", " + (if s.cents > 0: "+" else: "-") + phoenix_text(abs(s.cents)) else: ""}.", clock_text(living_world, living_world.minute))
        # (what the pilot did today, for his small talk: src/pilot_talk.jo)
        pilot_did(living_world.pilot_day, Doing(if tavli_game.winner == 0: DoingKind.tavli_won else: DoingKind.tavli_lost, living_world.minute, who = split(name, " ")[0]))
    if act.again:
        if tavli_stake in tavli_stakes(living_world, tavli_with): tavli_begin(tavli_with, tavli_stake)
        else: tavli_begin(tavli_with, 0)
    if act.leave:
        leisure_ui = 0; leisure_line = ""

# ---------------- swimming ----------------

swim = Swim()
swim_tread = 0.0                # (0 lying along the water .. 1 upright, treading it: smoothed)
swim_ground = (x: f64, z: f64) -> f64: walk_height(towns, x, z)
# (the water's surface: an inland lake or river's level, else the sea's swell as it is drawn)
swim_level = (x: f64, z: f64) -> f64: f64(swell_at(x, z, t).x)
# (the still water: an inland lake or river's level, else the sea's mean level; what decides
# swimming, wading and coming out, as walking's own wading limit does)
swim_still = (x: f64, z: f64) -> f64:
    if geography_enabled:
        water=water_at(x,z)
        if water.wet: return water.level
    0.0

# On a beach or the end of a dock, facing water: somewhere to go in.
swim_here = () -> bool:
    if me.mode != .walking or swim.active or holding_cargo() >= 0 or near_own_craft(): return false
    ahead = me.pos + vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw))) * 2.6
    lv = swim_level(f64(ahead.x), f64(ahead.z))
    if lv - swim_ground(f64(ahead.x), f64(ahead.z)) < 0.5: return false
    here = swim_level(f64(me.pos.x), f64(me.pos.z))
    f64(me.pos.y) < here + 2.6

# the swimmer placed where the swim put him (not snapped to the ground as walking would)
_place_swimmer = (p: vec3):
    global me, walker_point, walker_published
    me.pos = p; walker_point = world_point(p); walker_published = p

swim_go = ():
    global ui
    ui = .none
    swim_begin(swim, me.pos, vec2(f32(sin(me.yaw)), f32(cos(me.yaw))), living_world.minute, swim_ground, swim_level)
    say_toast(if swim.diving >= 0.0: "Off the end of the dock." else: "Into the sea.")

swim_end = (at: vec3):
    global swim
    minutes = max(1, living_world.minute - swim.started)
    log_note(notebook, "A swim at {living.place_name(living_world, max(0, living_world.people[living_world.player].place))}: {minutes} minutes in the water{if swim.strokes > 40: ", a good long way" else: ""}.", clock_text(living_world, living_world.minute))
    # (what the pilot did today, for his small talk: src/pilot_talk.jo)
    pilot_did(living_world.pilot_day, Doing(.swam, living_world.minute))
    swim = Swim()
    _place_swimmer(at)

# one step in the water: moving `move` (flat metres) this frame
swim_move = (move: vec2, dt: f64, strong: bool):
    global swim_tread
    if not swim.active: return
    st = swim_step(swim, me.pos, move, dt, strong, swim_ground, swim_level, swim_still)
    if st.out:
        swim_end(st.pos)
        return
    _place_swimmer(st.pos)
    swim_tread = approach(swim_tread, if swim.effort > 0.05: 0.0 else: 1.0, 2.5, dt)
    if swim.splash:
        ahead = vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw)))
        at = vec3(me.pos.x, f32(swim.level), me.pos.z) + ahead * (if swim.strokes == 0: 0.0 else: 0.7)
        if swim.strokes == 0:
            emit(spray_ps, at, 70, 4.0, rgba(0.97, 0.99, 1.0, 0.92), 1.1, 0.3, 0.9, vec3(0, 1, 0))
        else:
            emit(spray_ps, at, 6, 1.5, rgba(0.96, 0.98, 1.0, 0.8), 0.6, 0.12, 0.8, vec3(0, 1, 0))

swim_prompt = () -> str:
    if not swim.active: return ""
    if swim.diving >= 0.0: return ""
    if swim_climb_out(me.pos, swim_ground, swim_level) != none: return "F  climb out onto the dock"
    if swim.swimming: "Swimming: Shift a strong stroke; walk out where it's shallow" else: "Wading: walk out onto the shore"

# A camera at `eye` that shows `target` in a window of the screen (a mirror, a view across a
# table), `extent` metres of it from the bottom of the window to the top. Solved in plain geometry:
# the camera turned until the target falls in the window's middle (off the screen's middle a
# projection magnifies, so the field of view is set from the target's own height there).
_project = (e: vec3, f: vec3, r: vec3, u: vec3, tn: f64, aspect: f64, p: vec3) -> vec2:
    q = p - e
    z = max(f64(dot(q, f)), 0.001)
    vec2(f32(f64(dot(q, r)) / z / (tn * aspect)), f32(f64(dot(q, u)) / z / tn))

camera_into_window = (eye: vec3, target: vec3, extent: f64, g: Rect):
    sw = f64(screen_width()); sh = f64(screen_height())
    aspect = sw / sh
    wx = (f64(g.x) + f64(g.w) * 0.5) / sw * 2.0 - 1.0
    wy = 1.0 - (f64(g.y) + f64(g.h) * 0.5) / sh * 2.0
    span = f64(g.h) / sh * 2.0                          # (the window's height, in the screen's terms)
    d = f64(length(target - eye))
    # (the angle the extent needs, but never wider than 80 degrees: a window far off the screen's
    # middle can't show more than that without the picture stretching)
    tn = min(extent / d / span, tan(40.0 * PI / 180.0))
    toward = normalize(target - eye)
    f = toward
    loop k in 0..24:
        r = normalize(cross(f, vec3(0, 1, 0)))
        u = cross(r, f)
        # (where the target should be seen from this camera; turn the camera by what's off)
        v = normalize(r * f32(wx * tn * aspect) + u * f32(wy * tn) + f)
        axis = cross(v, toward)
        s = f64(length(axis)); c = f64(dot(v, toward))
        if s < 0.000001: break
        ax = axis / f32(s); ang = atan2(s, c)
        f = normalize(f * f32(cos(ang)) + cross(ax, f) * f32(sin(ang)) + ax * f32(f64(dot(ax, f)) * (1.0 - cos(ang))))
    render_camera(eye, f, 2.0 * atan(tn) * 180.0 / PI, 0.05, world_far(f64(eye.y)))

# ---------------- stargazing ----------------

gaze = Gaze()

# somewhere to lie back at night: a hilltop (high and open), or the end of the hotel's pier
stargaze_here = () -> bool:
    if me.mode != .walking or swim.active or gaze.active or holding_cargo() >= 0 or ui != .none: return false
    if star_night(hour) < 0.5: return false
    # (out past the bar's awning, which reaches 0.5 m beyond the counter: under it there are no stars)
    out = if hotel.ok: f64(dot(me.pos - hotel.built.counter, hotel.table_z)) else: 0.0
    on_pier = hotel.ok and out > 2.5 and f64(length(me.pos - (hotel.built.counter + hotel.table_z * 8.0))) < 8.0
    on_pier or f64(me.pos.y) > 45.0

gaze_begin = ():
    global gaze, follow
    gaze = Gaze(active = true, yaw = me.yaw, pitch = 1.05, started = living_world.minute)
    me.stride = 0.0

gaze_end = ():
    global gaze
    minutes = max(1, living_world.minute - gaze.started)
    names = if gaze.seen.len() > 0: ": " + join(gaze.seen[0..min(6, gaze.seen.len())], ", ") else: ""
    log_note(notebook, "Lay back and looked at the stars for {minutes} minutes{names}.", clock_text(living_world, living_world.minute))
    # (what the pilot did today, for his small talk: src/pilot_talk.jo)
    pilot_did(living_world.pilot_day, Doing(.stars, living_world.minute))
    gaze = Gaze()

# where the eye is, lying back (the head, which lies behind where the figure stood facing)
gaze_eye = () -> vec3: me.pos - vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw))) * 0.85 + vec3(0, 0.45, 0)

const GAZE_FOV = 62.0

gaze_camera = ():
    render_camera(gaze_eye(), gaze_dir(gaze), GAZE_FOV, 0.05, world_far(f64(gaze_eye().y)))

# the brighter stars at their places, and the names one is looking at, faintly
draw_gaze_sky = ():
    if not gaze.active: return
    global gaze
    sw = f64(screen_width()); sh = f64(screen_height())
    night = star_night(hour)
    f = gaze_dir(gaze)
    r = normalize(cross(f, vec3(0, 1, 0))); u = cross(r, f)
    tn = tan(GAZE_FOV * PI / 360.0); aspect = sw / sh
    on_screen = (d: vec3) -> vec2?:
        z = f64(dot(d, f))
        if z < 0.05: return none
        x = f64(dot(d, r)) / z / (tn * aspect); y = f64(dot(d, u)) / z / tn
        if abs(x) > 1.1 or abs(y) > 1.1: return none
        vec2(f32((x + 1.0) * 0.5 * sw), f32((1.0 - y) * 0.5 * sh))
    label = (at: vec2, a: f64, greek: str, english: str, group: bool):
        if a <= 0.02: return
        ink = rgba(0.93, 0.9, 0.78, f32(a * 0.75))
        set_font(fonts.title)
        ptext_centered(greek, at + vec2(0, if group: 0 else: 16), if group: 17 else: 14, ink)
        set_font(fonts.ui)
        ptext_centered(english, at + vec2(0, if group: 18 else: 32), 12, rgba(0.93, 0.9, 0.78, f32(a * 0.55)))
        set_font()
    days = f64(living_world.minute) / 1440.0
    loop s in SKY_NAMES:
        d = sky_star(s.ra, s.dec, hour)
        if d.y < 0.02: continue
        if let p = on_screen(d):
            if not s.group:
                circle_gradient(p, star_size(s.mag) * 3.0, rgba(1, 0.96, 0.85, f32(0.18 * night * star_light(s.mag))), rgba(1, 0.96, 0.85, 0))
                circle(p, star_size(s.mag), rgba(1, 0.97, 0.9, f32(night * star_light(s.mag))))
            a = name_alpha(f, d, s.group) * night
            label(p, a, s.greek, s.english, s.group)
            if a > 0.6 and not (s.english in gaze.seen): gaze.seen.push(s.english)
    planets = sky_planets(hour, days)
    loop k in 0..4:
        d = normalize(planets[k].xyz)
        if d.y < 0.02 or planets[k].w <= 0.0: continue
        if let p = on_screen(d):
            label(p, name_alpha(f, d, false) * night, split(PLANET_NAMES[k], " (")[0], split(PLANET_NAMES[k], " (")[1].replace(")", ""), false)
    m = sky_moon(hour, days)
    if m.y > 0.02:
        if let p = on_screen(m): label(p + vec2(0, 18), name_alpha(f, m, false) * night, "Selene", "the Moon", false)
    if pad.on:
        prompt_card(fonts, "T  let an hour pass", 124.0)
        prompt_card(fonts, "L  get up", 64.0)
    else: prompt_card(fonts, "Q E and the arrows look round     T  let an hour pass     L  get up", 60.0)

# ---------------- the barber ----------------

barber_stage = 0                # 0 choosing, 1 at work (time passing), 2 done
barber_from = 1                 # (the style one sat down with)
barber_pick = 1                 # (the one shown in the glass)
barber_said = ""
barber_n = 0

barber_begin = ():
    global ui, leisure_ui, leisure_line, me, barber_stage, barber_from, barber_pick, barber_said, barber_n
    barber_n = lt.day_index(living_world.minute) + living_world.minute / 37
    me.pos = hotel.barber_seat; me.yaw = hotel.barber_yaw; me.stride = 0.0
    barber_stage = 0; barber_from = pilot_mustache; barber_pick = pilot_mustache
    barber_said = if barber_open(living_world): barber_greeting(pilot_mustache, barber_n) else: "(The chair is empty. A card on the glass: open from eight until seven.)"
    ui = .leisure; leisure_ui = 12; leisure_line = ""
    mouse_lock(false)

# the mirror: the pilot's face as the glass shows it
barber_face = () -> vec3: me.pos + vec3(0, 1.4, 0)

# where the glass is on the screen (beside the words, or above them on a phone held upright)
barber_glass = () -> Rect:
    sw = f64(screen_width()); sh = f64(screen_height())
    wide = sw > sh
    fw = if wide: min(sw * 0.5, sh * 0.82) else: sw * 0.84
    fh = if wide: sh * 0.86 else: min(sh * 0.5, fw * 1.25)
    fx = if wide: sw * 0.06 else: (sw - fw) * 0.5
    fy = if wide: (sh - fh) * 0.5 else: max(10.0, pad_top_clear(fx, fx + fw) + 6.0)
    Rect(fx, fy, fw, fh)

# the camera at the glass, turned so the face sits in the middle of the frame on the screen
barber_camera = ():
    camera_into_window(hotel.barber_mirror, barber_face() - vec3(0, 0.08, 0), 0.75, barber_glass())

barber_frame = ():
    global ui, leisure_ui, leisure_line, barber_stage, barber_pick, barber_said, barber_n
    w = living_world
    sw = f64(screen_width()); sh = f64(screen_height())
    # the glass in its gilt frame: the face in the middle, the hotel's wall round it
    wide = sw > sh
    g = barber_glass()
    fx = f64(g.x); fy = f64(g.y); fw = f64(g.w); fh = f64(g.h)
    wall = rgba(0.94, 0.87, 0.72, 1)
    rect(0, 0, sw, fy, wall); rect(0, fy + fh, sw, sh - fy - fh, wall)
    rect(0, fy, fx, fh, wall); rect(fx + fw, fy, sw - fx - fw, fh, wall)
    rect_outline(fx - 14, fy - 14, fw + 28, fh + 28, 16, rgba(0.72, 0.56, 0.24, 1))
    rect_outline(fx - 6, fy - 6, fw + 12, fh + 12, 3, rgba(0.86, 0.72, 0.38, 1))
    rect_outline(fx - 16, fy - 16, fw + 32, fh + 32, 2, rgba(0.45, 0.33, 0.12, 1))
    rect_gradient(fx, fy, fw, fh * 0.25, rgba(1, 1, 1, 0.08), rgba(1, 1, 1, 0))
    # what one can say, beside the glass (or under it)
    choices: str[]
    if barber_stage == 0 and barber_open(w):
        loop k in 0..4: choices.push("{BARBER_STYLES[k]}{if k == barber_from: " (as it is)" else: ""}")
        choices.push("Go ahead, {phoenix_text(barber_price(barber_from, barber_pick))}")
        choices.push("Not today")
    else if barber_stage == 2: choices = ["Thank you"]
    else if not barber_open(w): choices = ["Get up"]
    px = if wide: fx + fw + 34.0 else: 12.0
    py = if wide: fy else: fy + fh + 22.0
    pw = if wide: sw - px - 20.0 else: sw - 24.0
    set_font(fonts.title)
    ptext(fit_text("{BARBER_NAME}, the barber", pw, 22), vec2(f32(px), f32(py)), 22, INK)
    set_font(fonts.ui)
    ptext(fit_text("at the Hotel Ancora; a shave and a trim {phoenix_text(BARBER_SHAVE_CENTS)}, a new shape {phoenix_text(BARBER_STYLE_CENTS)}", pw, 14), vec2(f32(px), f32(py + 30)), 14, LIGHT_INK)
    y = py + 58.0
    loop l in wrap_text("\"{barber_said}\"", pw, 17):
        ptext(l, vec2(f32(px), f32(y)), 17, STAMP); y += 22.0
    y += 10.0
    pick = -1
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6]
    row = if pad.on: 42.0 else: 34.0
    loop k in 0..choices.len():
        r = Rect(px, y + f64(k) * row, pw, row - 4.0)
        over = contains(r, mouse_pos())
        shown = barber_stage == 0 and k == barber_pick and k < 4
        rect_rounded(r.x, r.y, r.w, r.h, 6, if shown: rgba(0.42, 0.29, 0.17, 1) else: if over: rgba(0.85, 0.74, 0.5, 0.75) else: rgba(0.97, 0.94, 0.86, 0.9))
        ptext(fit_text(if pad.on: choices[k] else: "{k + 1}.  {choices[k]}", r.w - 16, 17), vec2(f32(r.x + 8), f32(r.y + 6)), 17, if shown: rgba(1, 0.97, 0.9, 1) else: rgba(0.32, 0.2, 0.1, 1))
        if over and mouse_pressed(.left): pick = k
        if k < keys.len() and key_pressed(keys[k]): pick = k
    if vpressed(.escape): pick = choices.len() - 1
    set_font()
    if pick < 0: return
    chosen = choices[pick]
    if barber_stage == 0 and pick < 4:
        barber_pick = pick
        set_pilot_mustache(pick)
        barber_said = barber_style_words(barber_from, pick)
    else if chosen.starts_with("Go ahead"):
        o = barber_pay(living_world, hotel_place.keeper, barber_from, barber_pick)
        if not o.ok: barber_said = o.message
        else:
            global leisure_spent
            barber_n += 1
            barber_stage = 1
            barber_said = barber_chat(w, 0, barber_n)
            leisure_skip(BARBER_MINUTES, "{BARBER_NAME} lathers and shaves you. \"{barber_chat(w, 0, barber_n + 1)}\"")
            log_note(notebook, "A shave at the barber's by the Hotel Ancora{if barber_pick != barber_from: ": " + BARBER_STYLES[barber_pick].lower() else: ""}. {o.message}", clock_text(w, w.minute))
            # (what the pilot did today, for his small talk: src/pilot_talk.jo)
            pilot_did(living_world.pilot_day, Doing(.shave, living_world.minute))
    else:
        # (got up without the work done: the glass shows what one came in with)
        if barber_stage == 0: set_pilot_mustache(barber_from)
        ui = .none; leisure_ui = 0

# the barber's work done (when the time has passed): the result in the glass
barber_step = ():
    global barber_stage, barber_said
    if barber_stage == 1 and not skip.active:
        barber_stage = 2
        barber_said = barber_done(barber_pick, barber_n)

# ---------------- fishing from a dock ----------------

# the hotel's kitchen grills a plate of one's own catch, and it comes to the table
grill_catch = ():
    global leisure_spent, leisure_had, served_look_until, leisure_line
    plate = fish_plate(fish)
    if plate.len() == 0: return
    first = FISH_KINDS[fish_all(fish)[plate[0]].kind].name
    eaten = fish_grill(living_world, fish, living_world.people[hotel_place.keeper].account)
    if eaten <= 0:
        leisure_line = "The kitchen wants {phoenix_text(GRILL_CENTS)} for the grilling."
        return
    # (it comes out from the kitchen like any order: the waiter brings it)
    plate_item = MenuItem("Your own catch, grilled", "Food", "From the grill", "with lemon and oil", GRILL_CENTS, serve = .plate, food = true)
    leisure.coming.push(Served(plate_item, living_world.minute, leisure.orders % 6))
    leisure.orders += 1
    leisure_spent += GRILL_CENTS; leisure_had.push("{first} of one's own, grilled")

# Any menu, panel or overlay open (src/ui_state.jo): the mouse wheel is its own, never a camera's.
# Every camera step that can read the wheel goes through wheel_kept with this.
when TARGET == "wasm":
    extern __aegean_panel_open = (on: i32)
menus_open = () -> bool: overlays_open(Overlays(ui, paused, notebook.open, show_chart, skip.active, leisure.sitting != "", seat_view()))

# sitting with only the table's bar along the bottom (no menu open over it): the view about the seat
seat_view = () -> bool: leisure.sitting != "" and ui == .leisure and leisure_ui == 0

# ---------------- notes rising from music in the world ----------------

# Each frame: the band's notes as heard (its feed, band_notes, stepped by band_step), and the
# nearest street musician's phrase, a few of them sent up from whoever played them.
music_cues_step = ():
    global band_cue, street_cue, street_player, street_feed
    note_cue_age(band_cue, t)
    note_cue_age(street_cue, t)
    if hotel.ok and band_notes.frame >= 0 and f64(length(scene_camera() - hotel.stage)) < NOTE_HEARD + 20.0:
        # (in the bar room they keep under its ceiling, and no wind carries them)
        inside = room_point_inside(hotel, hotel.stage)
        band_cue.ceiling = if inside: f64(transform_point(hotel.frame, vec3(0, f32(DECK + 3.6), 12)).y) else: 1e9
        air = if inside: 0.0 else: wind_now.speed
        bp = bar_band_position(living_world.band, living_world.tick)
        spots = band_spots(hotel, BAR_SET[bp.index].lineup, bar_singing(bp))
        loop chord in note_cue_take(band_cue, band_notes.feed.notes, band_notes.frame):
            n = chord[0]
            at = hotel.stage + vec3(0, 1.9, 0)
            loop s in spots:
                if s.instrument == n.part: at = s.pos + vec3(0, f32(if s.seated: 1.5 else: 1.95), 0)
            note_cue_rise(band_cue, chord, at, t, music_quarter_of(band_notes.piece, n), note_ago(band_notes.frame, n), wind_now.dir, air)
    else: band_cue.frame = -1
    # (the street: only the nearest musician is heard, within STREET_HEARD)
    ear = scene_camera()
    best = -1; bd = STREET_HEARD
    loop k in 0..folks.len():
        f = folks[k]
        if not f.shown or not f.performing: continue
        d = f64(length(f.pos - ear))
        if d < bd: best = k; bd = d
    if best != street_player:
        street_player = best; street_cue = NoteCue()
    if best < 0: return
    f = folks[best]
    live_notes_load(street_feed, street_events(f.person, t), STREET_PART)
    head = f.pos + vec3(0, f32(f.fixture_height + (if f.posture == 1: 1.5 else: 1.95)), 0)
    frame = live_notes_clock_frame(t)
    loop chord in note_cue_take(street_cue, street_feed.notes, frame):
        note_cue_rise(street_cue, chord, head, t, STREET_QUARTER, note_ago(frame, chord[0]), wind_now.dir, wind_now.speed)

const STREET_HEARD = 70.0           # (metres: as far as src/life_audio.jo plays a street musician)

# Drawn over the scene, under the cards: none when the option is off.
draw_music_cues = ():
    if not options.music_notes or stay.active: return
    night = 1.0 - smoothstep(-0.06, 0.1, f64(sky_sun(hour).y))
    draw_note_cue(band_cue, t, note_heard_alpha(band_heard.distance, band_heard.occlusion), night)
    if street_player >= 0 and street_player < folks.len():
        d = f64(length(folks[street_player].pos - scene_camera()))
        # (the street is heard to 70 m, the band to 140: the same fade over half the distance)
        draw_note_cue(street_cue, t, note_heard_alpha(d * NOTE_HEARD / STREET_HEARD, 0.0), night)

# ---------------- the player's aircraft repainted ----------------

set_player_paint = (p: Paint):
    global player_paint, paint_dirty
    player_paint = p
    paint_dirty = true
    # (the aircraft's record wears the base livery too, as the world sees it)
    rec = living_world.people[living_world.player].craft
    if rec >= 0:
        kind = int(pc.kind)
        l = if paint_active(p, kind) and p.livery >= 0: p.livery else: DEFAULT_LIVERIES[kind]
        if living_world.aircraft[rec].livery_index != l:
            living_world.aircraft[rec].livery_index = l
            living_world.aircraft[rec].revision += 1
        # (and the whole paint, kept with the aircraft as every pilot's is)
        living_world.aircraft[rec].paint = if paint_active(p, kind): paint_to_record(p) else: ""

# Whether painting is free anywhere, from the pause menu's Paint page: the sandbox's "Paint the
# aircraft anywhere, at any time" (src/sandbox.jo). Off, painting is done at a paint shop, for a
# price and a little time, and the page says so. (AEGEAN_PAINT_AT_SHOPS=1 holds it off whatever
# the switch, for captures and checks.)
paint_free_anywhere = () -> bool: sandbox.paint_anywhere and env("AEGEAN_PAINT_AT_SHOPS") == none

# the paint the aircraft is seen in now: a shop's draft while it is being chosen, a job's stage
# while she is in the shop, or her own
paint_seen = () -> Paint:
    if paint_shop_open: return paint_shop_draft
    paint_job_look(paint_job, player_paint, living_world.minute)

# (each frame: the shop's job, and the painted model rebuilt when the paint changed, at most every
# few frames while a slider is dragged)
paint_step = ():
    global painted_model, paint_dirty, paint_built_at, paint_shown
    paint_job_step()
    kind = int(pc.kind)
    if paint_seen() != paint_shown: paint_dirty = true
    if not paint_dirty or frame_number() - paint_built_at < 6: return
    paint_dirty = false; paint_built_at = frame_number()
    paint_shown = paint_seen()
    painted_model = if paint_active(paint_shown, kind): paint_build(paint_shown, kind) else: none
    global paint_space
    paint_space = if paint_parts_set(paint_shown) > 0 or paint_shown.decals.len() > 0: last_painted_space() else: none

# The Decals tab's "Point at her": a click or tap on the aircraft, beside the page, puts the
# chosen decal where it fell (the side the surface faces, and the place there).
paint_point_step = ():
    on_page = dbg.open and dbg.page == PAINT_PAGE
    if not (on_page or ui == .paint) or dbg.paint_page.tab != 2 or not dbg.paint_page.pointing or not mouse_pressed(.left): return
    m = mouse_pos()
    r = if on_page: dbg.panel else: paint_panel.rect
    if f64(m.x) >= f64(r.x) and f64(m.x) <= f64(r.x) + f64(r.w) and f64(m.y) >= f64(r.y) and f64(m.y) <= f64(r.y) + f64(r.h): return
    space = paint_space ?? return
    o, d = screen_ray(m)
    inv = quat_inverse(pc.state.orientation)
    hit = decal_pick(space, quat_rotate(inv, o - pc.state.position), quat_rotate(inv, d)) ?? return
    p = if paint_shop_open: paint_shop_draft else: player_paint
    k = dbg.paint_page.decal
    if k < 0 or k >= p.decals.len(): return
    p.decals[k].spot = ""; p.decals[k].side = hit.0; p.decals[k].u = hit.1; p.decals[k].v = hit.2
    if p.decals[k].size <= 0.0: p.decals[k].size = 0.8
    dbg.paint_page.pointing = false
    if paint_shop_open:
        global paint_shop_draft, paint_dirty
        paint_shop_draft = p; paint_dirty = true
    else: set_player_paint(p)

# the model the player's aircraft is drawn with
player_model = () -> CraftModel:
    if let m = painted_model:
        if paint_active(paint_shown, int(pc.kind)): return m
    craft_models[pc.model]

# ---------------- the paint shop ----------------

paint_clock = (minute: int) -> str: clock_text(living_world, minute)

# The painter's answer when asked: the shop's page opened (the pause menu's Paint page, as the
# shop's), or why not, in their words.
open_paint_shop = (person: int, place: int, brought: bool = false) -> str:
    global paint_shop_open, paint_shop_draft, paint_shop_who, paint_shop_place
    if paint_job.active: return "She'll be dry at {paint_clock(paint_job.ready_minute)}. Best leave her be till then."
    rec = living_world.people[living_world.player].craft
    if rec < 0 or not pc.state.moored: return "Moor her here first and I'll see to her."
    # (at this harbour: at a dock, or a big boat on her buoy off it)
    if f64(length(pc.state.position - me.pos)) > 1500.0: return "Bring her round to this harbour and moor her; I can't paint her from here."
    # (a town with a paint shop: asked there, with its painter at it; and she is brought round to
    # its berth first, where the paint is chosen with her in front of one)
    if let shed = paint_shed_of(place):
        if not brought and (f64(length(living_world.people[person].pose.pos - shed.painter)) > 14.0 or f64(length(me.pos - shed.painter)) > 22.0):
            # (a new pilot's greeter, asked for paint, has seen the pilot settled: back to work)
            if person == living_world.welcome.greeter: living_world.welcome.done = true
            clock = lt.local_minute(living_world.minute)
            working = (clock >= 420 and clock < 750) or (clock >= 900 and clock < 1080)
            return if working: "Not here. Come over to the workshop on the water; I'm on my way there." else: "Not here. Come by the workshop on the water: I'm there mornings, and from three till six."
        if paint_berth_fits() and not paint_at_berth(shed):
            global paint_berth_from
            paint_shop_who = person; paint_shop_place = place
            paint_berth_from = place
            leisure_skip(6, "{_first_name(person)} brings her round to the workshop", 12)
            return "I'll bring her round to the berth, and we'll see what you'd like."
    paint_shop_open = true
    paint_shop_draft = if player_paint.kind == int(pc.kind): player_paint else: paint_reset(int(pc.kind))
    paint_shop_who = person; paint_shop_place = place
    dbg.paint_page.pointing = false
    global ui, paint_view_yaw, paint_view_pitch, paint_view_zoom, paint_panel
    paint_view_yaw = 0.9; paint_view_pitch = 0.28; paint_view_zoom = 1.0
    paint_panel = PaintPanel()
    ui = .paint
    mouse_lock(false)
    "Show me what you'd like."

# Whether the aircraft can lie at a paint shop's berth: a seaplane that fits a harbour's docks (a
# big boat is painted on her buoy, a landplane where she stands).
paint_berth_fits = () -> bool: not offshore_only(pc.kind) and not pc.spec.landplane

paint_at_berth = (shed: PaintShed) -> bool:
    b = paint_shed_berth(shed, aircraft_profile(pc.kind).length)
    pc.state.moored and f64(length(vec2(pc.state.position.x - b.0.x, pc.state.position.z - b.0.z))) < 2.0

# The aircraft moored at a paint shop's berth, nose in, her line on the deck's bollard.
paint_berth_moor = (shed: PaintShed):
    global was_moored, offshore
    b = paint_shed_berth(shed, aircraft_profile(pc.kind).length)
    moor(pc.state, vec3(b.0.x, pc.state.position.y, b.0.z), b.1)
    pc.throttle = 0.0; pc.placed = false; pc.aim_heading = b.1
    rope.anchor = shed.bollard; rope.tied = true; rope.loose = rope.anchor
    was_moored = true
    offshore = none

paint_berth_from = -1               # (the town whose painter is bringing her round)
# (the few minutes' wait over: she is at the berth, and the painter shows the colours)
paint_berth_arrived = ():
    global paint_berth_from
    place = paint_berth_from
    paint_berth_from = -1
    shed = paint_shed_of(place) ?? return
    if not pc.state.moored or paint_job.active: return
    paint_berth_moor(shed)
    said = open_paint_shop(paint_shop_who, place, true)
    if not paint_shop_open: say_toast("{_first_name(paint_shop_who)}: {said}")

# At the workshop (its bench tapped, the pilot walked over): the painter spoken to, if they are
# there; else when they will be.
paint_shop_ask = ():
    global talk_pick, pad_talk
    shed = paint_shed_of(town_here(me.pos)) ?? return
    loop k in 0..folks.len():
        f = folks[k]
        if f.person >= 0 and f.shown and living_world.people[f.person].occupation == .mechanic and f64(length(f.pos - shed.painter)) < 14.0:
            talk_pick = k; pad_talk = true
            return
    say_toast("Nobody is at the workshop. The mechanic keeps it mornings, and from three till six.")

paint_shop_quote = () -> PaintQuote: paint_quote(player_paint, paint_shop_draft, int(pc.kind))

# the Paint page's standing: the shop's price for the draft, free, or closed with where things stand
paint_shop_view = () -> PaintShopView:
    if paint_job.active:
        return PaintShopView(mode = .closed, note = "She is in the paint shop at {living.place_name(living_world, max(0, paint_job.place))} until {paint_clock(paint_job.ready_minute)}.")
    if paint_free_anywhere(): return PaintShopView()
    # (where the paint shops are)
    names = [loop shed in paint_sheds: towns[shed.place].name]
    where = if names.len() == 0: "Ask a mechanic, with her moored at their harbour." else: "There is one at {join(names, ", and one at ")}: ask the mechanic there."
    PaintShopView(mode = .closed, note = "Painting is done at a paint shop. {where}")

paint_shop_close = ():
    global paint_shop_open, paint_dirty, ui
    if not paint_shop_open: return
    paint_shop_open = false
    paint_dirty = true
    dbg.paint_page.pointing = false
    if ui == .paint: ui = .none

# The shop's own panel (ui == .paint): the painter's card and the paint's tabs, drawn beside the
# aircraft; what it changes is the draft, what it returns orders the work or leaves it.
paint_shop_panel_step = ():
    global paint_shop_draft, paint_dirty
    if not paint_shop_open or me.mode != .walking:
        paint_shop_close()
        return
    q = paint_shop_quote()
    shop = PaintShopView(.shop, living_world.people[paint_shop_who].name, q.cents, q.minutes, q.items, paint_order_refusal(q, player_cents()))
    draft = paint_shop_draft
    res = paint_shop_panel(fonts, paint_panel, dbg.paint_page, draft, paint_support_for(int(pc.kind)), int(pc.kind), shop, living.place_name(living_world, max(0, paint_shop_place)))
    if draft != paint_shop_draft:
        paint_shop_draft = draft; paint_dirty = true
    if res.order: paint_shop_order()
    else if res.leave: paint_shop_close()

# The view while her paint is chosen: round the aircraft, turned by a drag beside the panel (the
# mouse, or a finger) and brought nearer by the wheel, the aircraft held in the part of the screen
# the panel leaves.
paint_shop_camera = ():
    global paint_view_yaw, paint_view_pitch, paint_view_zoom
    beside = not paint_panel_over(paint_panel, mouse_pos()) and not dbg.paint_page.pointing
    # (a finger is the mouse too: one drag beside the panel turns the view, on a phone as with a mouse)
    drag = if beside and mouse_down(.left) and not mouse_pressed(.left): mouse_delta() else: vec2(0, 0)
    gain = if pad.on: touch_look_gain() else: 0.006
    paint_view_yaw -= f64(drag.x) * gain
    paint_view_pitch = clamp(paint_view_pitch + f64(drag.y) * gain * 0.7, 0.04, 1.2)
    if beside: paint_view_zoom = clamp(paint_view_zoom * (1.0 - f64(mouse_wheel()) * 0.08), 0.55, 1.8)
    prof = aircraft_profile(pc.kind)
    aspect = f64(screen_width()) / max(f64(screen_height()), 1.0)
    fov = 50.0
    # (far enough that her span fills the part of the screen left to her)
    shift = paint_panel_shift(paint_panel)
    room = if paint_panel.upright: aspect else: aspect * (1.0 + 2.0 * f64(shift.x))
    dist = (max(prof.span, prof.length) * 0.62 / (tan(radians(fov) * 0.5) * max(room, 0.3)) + 2.0) * paint_view_zoom
    h = heading(pc.state) + paint_view_yaw
    dir = vec3(f32(sin(h) * cos(paint_view_pitch)), f32(sin(paint_view_pitch)), f32(-cos(h) * cos(paint_view_pitch)))
    look = pc.state.position + vec3(0, f32(prof.wing_y * 0.3), 0)
    eye = look + dir * f32(dist)
    # (kept above the water and the deck)
    eye.y = max(eye.y, 1.9)
    fwd = normalize(look - eye)
    right = normalize(cross(fwd, vec3(0, 1, 0)))
    up = cross(right, fwd)
    half_h = dist * tan(radians(fov) * 0.5)
    # (the look point moved so she sits in the middle of the room beside the panel)
    aim = look - right * f32(2.0 * f64(shift.x) * half_h * aspect) + up * f32(2.0 * f64(shift.y) * half_h)
    render_camera(eye, aim - eye, fov, 0.1, world_far(f64(eye.y)))

# The order given: the painter paid, the aircraft in the shop until the paint is dry.
paint_shop_order = ():
    global paint_job
    q = paint_shop_quote()
    if paint_order_refusal(q, player_cents()) != "": return
    payer = living_world.people[living_world.player].account
    to = living_world.people[paint_shop_who].account
    if not transfer(living_world, payer, to, q.cents, .repair): return
    paint_job = paint_job_begin(paint_shop_draft, int(pc.kind), q, living_world.minute, paint_shop_place, paint_shop_who)
    log_note(notebook, "Left her with {living_world.people[paint_shop_who].name} to be painted: {join(q.items, ", ")}. {phoenix_text(q.cents)}; dry at {paint_clock(paint_job.ready_minute)}.", paint_clock(living_world.minute))
    say_toast("She is in the paint shop until {paint_clock(paint_job.ready_minute)}")
    if paint_shop_capture: print("PAINTSHOP order taken: {phoenix_text(q.cents)} for {join(q.items, ", ")}; dry at {paint_clock(paint_job.ready_minute)}; purse {player_cents()}")
    paint_shop_close()

# (each frame: the page's order or leave; the shop's page gone with the pause menu; the job done
# when the paint is dry)
paint_job_step = ():
    global paint_job, paint_fresh_until, paint_remarked
    # (the shop's panel closed some other way: the draft is dropped)
    if paint_shop_open and ui != .paint: paint_shop_close()
    if not paint_job.active: return
    # (another aircraft taken meanwhile: the shop's job was for the one she left)
    if paint_job.kind != int(pc.kind):
        paint_job = PaintJob()
        return
    if paint_job_done(paint_job, living_world.minute):
        done = paint_job
        paint_job = PaintJob()
        set_player_paint(done.paint)
        paint_fresh_until = living_world.minute + 1440; paint_remarked = []
        say_toast("The paint is dry: she is ready")
        log_note(notebook, "Her new paint is dry.", paint_clock(living_world.minute))

# What someone says of a new paint, the first time they are spoken to within a day of it ("": nothing).
paint_remark = (person: int) -> str:
    global paint_remarked
    if living_world.minute >= paint_fresh_until or person in paint_remarked: return ""
    paint_remarked.push(person)
    ["That's new paint on her. She looks well in it.", "I saw her come out of the shop. Handsome.", "New colours? I'd know her anywhere now.", "Fresh paint. You can smell the dope from here."][person % 4]

# the mechanic in the player's town, or -1
paint_mechanic_here = () -> int:
    here = town_here(me.pos)
    loop q in living_world.people:
        if q.occupation == .mechanic and q.place == here and q.far_home < 0: return q.id
    -1

paint_capture_cash = 0
paint_capture_done = false

# AEGEAN_CAPTURE_SHED="place [yaw pitch distance]": the free camera on that town's paint shop, from
# out on the water (yaw round from straight out to sea), and a PAINT SHED line for each (captures)
paint_shed_capture_view = ():
    global free
    words = split(env("AEGEAN_CAPTURE_SHED") ?? "0", " ")
    loop shed in paint_sheds: print("PAINT SHED {towns[shed.place].name} at {shed.origin} heading out {shed.out_heading:.3} painter {shed.painter} berth {paint_shed_berth(shed, 8.0).0}")
    loop shed in paint_sheds:
        if shed.place != (to_int(words[0]) ?? 0): continue
        yaw = shed.out_heading + (if words.len() > 1: to_float(words[1]) ?? 0.5 else: 0.5); pitch = if words.len() > 2: to_float(words[2]) ?? 0.25 else: 0.25
        out_dir = vec3(f32(sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
        middle = transform_point(shed.frame, vec3(-1.5, 2.2, 8.0))
        free.pos = middle + out_dir * f32(if words.len() > 3: to_float(words[3]) ?? 24.0 else: 24.0)
        free.pitch = -pitch
        free.yaw = atan2(f64(out_dir.x), f64(out_dir.z))
        if dot(forward(free), -out_dir) < 0.9: free.yaw = -free.yaw
        me.mode = .free
        # (the same view for a build without the shop: AEGEAN_VIEW takes these)
        print("PAINT SHED view AEGEAN_VIEW=\"{free.pos.x:.2} {free.pos.y:.2} {free.pos.z:.2} {free.yaw:.4} {free.pitch:.4} 10.5\"")
# (AEGEAN_CAPTURE_LAUNCH=paintshop, and AEGEAN_CAPTURE_PANEL=paint-shop for its page alone)
paint_shop_capture_step = ():
    global paint_shop_draft, paint_dirty, paint_capture_cash, paint_capture_done, paint_job
    n = frame_number()
    kind = int(pc.kind)
    who = paint_mechanic_here()
    if n == 60:
        # (staged at the town's paint shop, as if walked there and the painter asked: the pilot on
        # the apron, the aircraft brought round to the berth)
        place = town_here(me.pos)
        if let shed = paint_shed_of(place):
            me.pos = shed.stand; follow.placed = false
            me.yaw = atan2(f64(shed.facing.x), f64(shed.facing.z))
            if paint_berth_fits(): paint_berth_moor(shed)
        said = if who >= 0: open_paint_shop(who, place, true) else: "no mechanic here"
        if let tab = env("AEGEAN_PAINT_TAB"): dbg.paint_page.tab = clamp(to_int(tab) ?? 0, 0, 3)
        print("PAINTSHOP ask: '{said}' open={paint_shop_open} ui={ui} painter={if who >= 0: living_world.people[who].name else: "-"} at_berth={if let shed = paint_shed_of(place): paint_at_berth(shed) else: false}")
    if n == 62 and paint_shop_open:
        paint_shop_draft = paint_from_spec(env("AEGEAN_PAINT_DRAFT") ?? "part.lwing=stripes:0.78,0.18,0.12:0.95,0.94,0.9:0:6 part.rwing=stripes:0.78,0.18,0.12:0.95,0.94,0.9:0:6 part.rudder=plain:0.78,0.18,0.12 decal=star:fuselage", kind)
        paint_dirty = true
        q = paint_shop_quote()
        print("PAINTSHOP quote: {phoenix_text(q.cents)} ({q.cents}), {paint_minutes_text(q.minutes)}, for {join(q.items, ", ")}; cash {player_cents()}; refusal '{paint_order_refusal(q, player_cents())}'")
    if launch_capture != "paintshop": return
    if n == 70 and paint_shop_open:
        paint_capture_cash = player_cents()
        painter_before = living_world.accounts[living_world.people[who].account].cents
        paint_shop_order()
        print("PAINTSHOP ordered: job={paint_job.active} ready={paint_clock(paint_job.ready_minute)} paid={paint_capture_cash - player_cents()} painter_got={living_world.accounts[living_world.people[who].account].cents - painter_before} paused={paused} page_open={paint_shop_open} still_old_paint={player_paint != paint_job.paint}")
    if n == 80 and paint_job.active:
        g = capture_running_game()
        if g is lt.SaveGame:
            kept = paint_job
            paint_job = PaintJob()
            runtime = read_game_session(g)
            ok = runtime is GameSession and apply_saved_game(g, runtime as GameSession)
            print("PAINTSHOP save round trip {ok}: job kept {paint_job == kept}, active {paint_job.active}")
        else: print("PAINTSHOP save refused: {g.message}")
    if n == 90 and paint_job.active:
        print("PAINTSHOP waiting {paint_job_left(paint_job, living_world.minute)} minutes; aboard thing '{[loop th in _foot_things_now(): if th.act == "aboard": th.label]}'")
        # (AEGEAN_PAINT_STAGE=primer|top: the wait stopped while she is in primer, or in her top
        # coat before the decals, for a picture of her mid-paint)
        whole = paint_job.ready_minute - paint_job.started_minute
        part = match env("AEGEAN_PAINT_STAGE") ?? "":
            "primer": whole / 2
            "top": whole * 8 / 10
            else: paint_job_left(paint_job, living_world.minute) + 1
        leisure_skip(max(1, part - (living_world.minute - paint_job.started_minute)), "Waiting for the paint to dry")
    if n == 96 and env("AEGEAN_CAPTURE_SHED") != none: paint_shed_capture_view()
    if n > 90 and not paint_job.active and not paint_capture_done:
        paint_capture_done = true
        rec = living_world.people[living_world.player].craft
        print("PAINTSHOP dry at frame {n}, {paint_clock(living_world.minute)}: parts {player_paint.parts.len()} decals {player_paint.decals.len()} record_paint {living_world.aircraft[rec].paint.len()} chars, same_as_record {paint_from_record(living_world.aircraft[rec].paint) == player_paint}")

# ---------------- other pilots' liveries ----------------

# Each pilot's aircraft given its paint (made once from the pilot's number, then kept with the
# aircraft's record), and queued to have its model built.
assign_pilot_liveries = ():
    global pilot_livery_queue, pilot_livery_by_craft
    pilot_livery_queue = []
    pilot_livery_by_craft = {}
    loop k in 0..traffic.len():
        c = traffic[k].craft
        if c < 0 or c >= living_world.aircraft.len(): continue
        if living_world.aircraft[c].paint == "":
            owner = living_world.aircraft[c].owner
            who = if living_world.aircraft[c].operator >= 0: living_world.aircraft[c].operator else: owner
            job = living_world.people[who].occupation
            style = if job == .patrol: LiveryStyle.service else: if job == .pirate: LiveryStyle.pirate else: LiveryStyle.personal
            living_world.aircraft[c].paint = paint_to_record(pilot_paint(who, int(traffic[k].kind), pilot_livery_base(c), living_world.people[who].name, style))
        _ = pilot_livery_model(c)

# the base livery an aircraft's record wears (its own, or its type's)
pilot_livery_base = (craft: int) -> int:
    rec = living_world.aircraft[craft]
    if rec.livery_index >= 0 and rec.livery_index < LIVERIES.len(): rec.livery_index else: DEFAULT_LIVERIES[clamp(int(rec.kind), 0, DEFAULT_LIVERIES.len() - 1)]

# The model of an aircraft's own paint (an index into craft_models), or -1 while it has none or
# its model is still to be built (it is queued).
pilot_livery_model = (craft: int) -> int:
    global pilot_livery_queue, pilot_livery_by_craft
    if craft in pilot_livery_by_craft: return pilot_livery_by_craft[craft]
    if craft < 0 or craft >= living_world.aircraft.len() or living_world.aircraft[craft].paint == "": return -1
    key = "{int(living_world.aircraft[craft].kind)} {living_world.aircraft[craft].paint}"
    if key in pilot_livery_models:
        pilot_livery_by_craft[craft] = pilot_livery_models[key]
        return pilot_livery_by_craft[craft]
    if not (craft in pilot_livery_queue): pilot_livery_queue.push(craft)
    -1

# An aircraft flying now that has no paint of its own yet (a far pilot's, the air arm's, a
# scenario squadron's) is given one, kept with its record: a far pilot's is their own; the air
# arm's and a squadron's are the unit's livery (the service's paint kept whole, so its side still
# reads) with the aircraft's own number.
pilot_livery_give = (craft: int):
    if craft < 0 or craft >= living_world.aircraft.len() or living_world.aircraft[craft].paint != "": return
    if craft == living_world.people[living_world.player].craft: return
    rec = living_world.aircraft[craft]
    kind = int(rec.kind)
    base = pilot_livery_base(craft)
    lv = LIVERIES[base]
    ink = if f64(lv.body.x) * 0.3 + f64(lv.body.y) * 0.59 + f64(lv.body.z) * 0.11 > 0.5: vec4(0.09, 0.09, 0.1, 1) else: vec4(0.95, 0.94, 0.9, 1)
    loop p in air_events.arm:
        if p.craft == craft:
            living_world.aircraft[craft].paint = paint_to_record(unit_paint(1000 + p.field, kind, base, p.stand + 1, [lv.accent, lv.trim], ink))
            return
    loop k in 0..battle.actors.len():
        a = battle.actors[k]
        if a.craft != craft: continue
        if a.human: return
        # (its number: its place among its side's aircraft)
        number = 1
        loop j in 0..k:
            if battle.actors[j].side == a.side and not battle.actors[j].human: number += 1
        living_world.aircraft[craft].paint = paint_to_record(unit_paint(2000 + a.side * 16 + base, kind, base, number, [lv.accent, lv.trim], ink))
        return
    who = if rec.operator >= 0: rec.operator else: rec.owner
    if who < 0 or who >= living_world.people.len(): return
    living_world.aircraft[craft].paint = paint_to_record(pilot_paint(who, kind, base, living_world.people[who].name, .personal))

# AEGEAN_CAPTURE_FORMATION=1 (with AEGEAN_FLYING): for a picture of the liveries from the chase
# view, the named pilots' aircraft are drawn placed in a vee ahead of the player's (staged for the
# still: their own flying goes on untouched underneath)
pilot_formation_capture = env("AEGEAN_CAPTURE_FORMATION") != none
pilot_formation_stage = ():
    # (ahead and a little below, so the chase view looks down on their wings)
    slots = [vec3(-13, -5.0, 26), vec3(14, -5.5, 28), vec3(-30, -9.0, 44), vec3(31, -9.5, 47), vec3(-50, -13.0, 66), vec3(52, -13.5, 70), vec3(0, -15.0, 78)]
    f = forward(pc.state)
    ahead = normalize(vec3(f.x, 0, f.z)); right = vec3(-ahead.z, 0, ahead.x)
    loop k in 0..min(traffic.len(), min(all_air_traffic.len(), slots.len())):
        sl = slots[k]
        st = pc.state
        st.position = pc.state.position + right * sl.x + vec3(0, sl.y, 0) + ahead * sl.z
        st.orientation = quat_euler(0, -heading(pc.state), 0)
        st.moored = false; st.on_water = false
        all_air_traffic[k].state = st
        all_air_traffic[k].visible = true
        all_air_traffic[k].prop_angle = t * 30.0 + f64(k)

# (each frame, once the air traffic is gathered: every aircraft drawn in its own paint's model)
pilot_livery_remap = ():
    if pilot_formation_capture and me.mode == .aboard: pilot_formation_stage()
    loop k in 0..all_air_traffic.len():
        c = all_air_traffic[k].craft
        if k >= traffic.len(): pilot_livery_give(c)
        m = pilot_livery_model(c)
        if m >= 0: all_air_traffic[k].model = m
    loop k in 0..traffic.len():
        m = pilot_livery_model(traffic[k].craft)
        if m >= 0: traffic[k].model = m
    loop k in 0..battle.actors.len():
        if battle.actors[k].human or battle.actors[k].craft < 0: continue
        pilot_livery_give(battle.actors[k].craft)
        m = pilot_livery_model(battle.actors[k].craft)
        if m >= 0: battle.actors[k].model = m

# AEGEAN_CAPTURE_LIVERY="k [yaw pitch distance]": once the liveries are built, the free camera on the
# k-th other pilot's aircraft, and a PILOT LIVERY line for each (captures)
pilot_livery_capture = env("AEGEAN_CAPTURE_LIVERY")
pilot_livery_captured = false
pilot_livery_capture_step = ():
    global pilot_livery_captured, free
    if pilot_livery_queue.len() > 0 or frame_number() < 30: return
    words = split(pilot_livery_capture ?? "0", " ")
    if not pilot_livery_captured:
        loop k in traffic.len()..all_air_traffic.len():
            tr = all_air_traffic[k]
            if tr.craft < 0 or tr.craft >= living_world.aircraft.len(): continue
            p = paint_from_record(living_world.aircraft[tr.craft].paint)
            print("PILOT LIVERY far {k} {tr.name} {CRAFT_NAMES[int(tr.kind)]} livery {living_world.aircraft[tr.craft].livery_index} parts {[loop q in p.parts: PAINT_PARTS[q.part]]} decals {[loop d in p.decals: (if d.motif == "text": d.text else: d.motif)]} model {tr.model}")
        loop k in 0..battle.actors.len():
            a = battle.actors[k]
            if a.craft < 0 or a.craft >= living_world.aircraft.len(): continue
            p = paint_from_record(living_world.aircraft[a.craft].paint)
            print("PILOT LIVERY actor {k} side {a.side} human {a.human} craft {a.craft} livery {living_world.aircraft[a.craft].livery_index} parts {[loop q in p.parts: PAINT_PARTS[q.part]]} decals {[loop d in p.decals: (if d.motif == "text": d.text else: d.motif)]} model {a.model}")
    loop k in 0..(if pilot_livery_captured: 0 else: traffic.len()):
        c = living_world.aircraft[traffic[k].craft]
        p = paint_from_record(c.paint)
        print("PILOT LIVERY {k} {traffic[k].name} ({living_world.people[traffic[k].person].occupation}) {CRAFT_NAMES[int(traffic[k].kind)]} livery {c.livery_index} parts {[loop q in p.parts: PAINT_PARTS[q.part]]} decals {[loop d in p.decals: d.motif]} model {traffic[k].model} at {traffic[k].state.position} visible {traffic[k].visible}")
    pilot_livery_captured = true
    k = clamp(to_int(words[0]) ?? 0, 0, max(traffic.len() - 1, 0))
    if traffic.len() == 0: return
    st = traffic[k].state
    side_a = heading(st) + (if words.len() > 1: to_float(words[1]) ?? 0.9 else: 0.9); side_e = if words.len() > 2: to_float(words[2]) ?? 0.3 else: 0.3
    out = vec3(f32(sin(side_a) * cos(side_e)), f32(sin(side_e)), f32(-cos(side_a) * cos(side_e)))
    free.pos = st.position + out * f32(if words.len() > 3: to_float(words[3]) ?? 15.0 else: 15.0)
    free.pitch = -side_e
    free.yaw = atan2(f64(out.x), f64(out.z))
    if dot(forward(free), -out) < 0.9: free.yaw = -free.yaw
    me.mode = .free

# (each frame: one waiting model built every few frames, so a start or a load does not stall on them)
pilot_livery_step = ():
    global pilot_livery_queue, pilot_livery_models
    if pilot_livery_capture != none: pilot_livery_capture_step()
    if pilot_livery_queue.len() == 0 or frame_number() % 4 != 0: return
    c = pilot_livery_queue[0]
    pilot_livery_queue.remove_at(0)
    if c < 0 or c >= living_world.aircraft.len(): return
    text = living_world.aircraft[c].paint
    p = paint_from_record(text)
    kind = int(living_world.aircraft[c].kind)
    if not paint_active(p, kind): return
    key = "{kind} {text}"
    if not (key in pilot_livery_models):
        craft_models.push(paint_build(p, kind))
        pilot_livery_models[key] = craft_models.len() - 1

# what the player's type can wear (worked out once a type, by building it with and without marks)
paint_support_for = (kind: int) -> PaintSupport:
    global paint_support_cache
    if paint_support_cache.kind != kind:
        paint_support_cache = paint_support(kind, CRAFT_NAMES[kind], (lv: Livery) -> int: build_craft(Craft(kind), lv).body.count, boat_paints(Craft(kind)))
        paint_support_cache.kind = kind
    paint_support_cache

# ---------------- a pleasure flight with someone from the town ----------------

# Who could be taken up: the nearest grown townsperson within reach of the aircraft at the dock,
# when it is moored, has a seat to spare, and nobody is going up already.
ride_candidate = (reach: f64) -> int:
    if ride.stage != .none or me.mode != .walking or not pc.state.moored or not near_own_craft(): return -1
    if lt.AIRFRAMES[int(pc.kind)].seats < 1: return -1
    best = -1; bd = reach
    loop k in 0..folks.len():
        f = folks[k]
        if not f.shown or f.performing or f.cycling or f.carrying: continue
        p = living_world.people[f.person]
        if p.age < 12 or f.person == living_world.player: continue
        if f.person in ride_declined and living_world.minute - ride_declined[f.person] < 1440: continue
        d = f64(length(f.pos - me.pos))
        if d < bd: best = k; bd = d
    best

ride_start = (k: int):
    global ride, ride_fig
    f = folks[k]
    p = living_world.people[f.person]
    home = choose_life_venue(living_world, p.home, .home, f.person)
    # (the town they set off from: where the pilot is, or (taken up mid-air, in a capture) theirs)
    here = living_world.people[living_world.player].place
    origin = if here >= 0: here else: p.home
    ride = ride_begin(f.person, k, p.traits.boldness < 450, f.pos, if home != none: home!.pos else: vec3(0, 0, 0), home != none and p.home == origin)
    ride.origin = origin
    global ride_boarded
    ride_boarded = false
    ride_fig = build_figure(dress_of(p.occupation), p.appearance_seed, age = p.age, woman = person_woman(p.name))
    # (their answer, said: in the caption at the top, which a marker at the screen's edge points
    # from toward them while they're out of view, behind the camera or off to the side)
    ride.line = ride_accept_line(ride.nervous); ride.line_until = t + 4.5

# The springs a lift could go to from here: one whose harbour isn't this place and is within a
# good flight (120 km); the nearest. -1 none.
ride_lift_choice = () -> int:
    here = living_world.people[living_world.player].place
    if not (here in settlement_registry.settlement_by_id): return -1
    at = settlement_registry.world_settlements[settlement_registry.settlement_by_id[here]].center
    best = -1; bd = 120000.0
    loop k in 0..THERMAL_SITES.len():
        pl = THERMAL_SITES[k].place
        if not (pl in INLAND_ACCESS): continue
        landing = INLAND_ACCESS[pl].landing
        if landing == here or not (landing in settlement_registry.settlement_by_id): continue
        d = f64(length(settlement_registry.world_settlements[settlement_registry.settlement_by_id[landing]].center.xz - at.xz))
        if d < bd: best = k; bd = d
    best
ride_at_dest = () -> bool:
    if not (ride.dest in settlement_registry.settlement_by_id): return false
    c = settlement_registry.world_settlements[settlement_registry.settlement_by_id[ride.dest]].center
    f64(length(c.xz - pc.state.position.xz)) < 1500.0

ride_lift_harbour = (k: int) -> str:
    landing = INLAND_ACCESS[THERMAL_SITES[k].place].landing
    if landing in settlement_registry.settlement_by_id: settlement_registry.world_settlements[settlement_registry.settlement_by_id[landing]].name else: living.place_name(living_world, landing)

# where the second seat is, in the aircraft's frame (the second cockpit, or just behind the pilot)
ride_seat = (m: CraftModel) -> vec3: if m.cockpits.len() >= 2: m.cockpits[1] else: m.cockpit + vec3(0, -0.05, 0.95)

ride_height = () -> f64:
    p = pc.state.position
    f64(p.y) - max(0.0, surface_height(f64(p.x), f64(p.z)))

ride_tick = (dt: f64):
    global ride, ride_rolled, ride_asker, ui, leisure_ui
    # (now and then, as the pilot comes to the aircraft, someone near asks to be taken up)
    near = me.mode == .walking and near_own_craft() and pc.state.moored
    if not near: ride_rolled = false
    else if not ride_rolled and ride.stage == .none and ui == .none:
        ride_rolled = true
        k = ride_candidate(15.0)
        if k >= 0 and ride_asks(random(0.0, 1.0)):
            ride_asker = k; ui = .leisure; leisure_ui = 16
            # (now and then it's a lift they want: to the springs' harbour, if one is in reach)
            global ride_lift_to
            ride_lift_to = if random(0.0, 1.0) < 0.4 or env("AEGEAN_RIDE_LIFT") != none: ride_lift_choice() else: -1
            _ = mouse_lock(false)
    if ride.stage == .none: return
    if ride.stage == .walking:
        # (over to the aircraft's side, then up into the seat)
        goal = pc.state.position + quat_rotate(pc.state.orientation, vec3(1.6, 0, 0.6))
        d = vec3(goal.x - ride.pos.x, 0, goal.z - ride.pos.z)
        l = f64(length(d))
        if l < 0.3 or l > 40.0: ride.stage = .seated; ride.next_line = t + 1.0
        else:
            step = min(l, 1.3 * dt)
            ride.pos = ride.pos + d / f32(l) * f32(step)
            ride.pos = vec3(ride.pos.x, f32(walk_height(towns, f64(ride.pos.x), f64(ride.pos.z))), ride.pos.z)
            ride.yaw = atan2(f64(d.x), f64(d.z)); ride.phase += dt * 6.0
        return
    if ride.stage == .thanked:
        if t > ride.line_until: ride_finish()
        return
    # (the pilot steps ashore before they have flown: back in a few minutes, or another day. Only
    # once he has been aboard with them: seated while he is still on the dock, they wait for him)
    global ride_boarded
    if ride.stage == .seated and me.mode == .aboard: ride_boarded = true
    if me.mode == .walking and ride.stage == .seated and ride_boarded:
        if not ride_asking_wait and ui == .none:
            global ride_asking_wait
            ride_asking_wait = true; ui = .leisure; leisure_ui = 18
            _ = mouse_lock(false)
        return
    # (waiting in the seat: back aboard, the flight goes on; an hour, or the pilot gone from the
    # island, and they give up; in earshot now and then, a word)
    if ride.stage == .waiting:
        if me.mode == .aboard:
            _ = ride_resume(ride, living_world.minute)
            ride.line_until = t + 5.0; ride.next_line = t + 4.0
            return
        if ride_wait_over(ride, living_world.minute, living_world.people[living_world.player].place == ride.origin):
            ride_give_up()
            return
        if f64(length(me.pos - pc.state.position)) < 30.0:
            said = ride_wait_remark(ride, living_world.minute)
            if said != "": ride.line = said; ride.line_until = t + 5.0
        return
    # (back ashore after the flight: their thanks)
    if me.mode == .walking and ride.stage == .landed:
        ride.flew = true
        # (a lift: set down where they asked, they pay and thank; anywhere else, they say so and stay)
        if ride.dest >= 0:
            # (there: moored within a mile or so of the harbour they asked for, by its place on the
            # map; the living world's own places are the old harbours only)
            if not ride_at_dest():
                if not ride.told_not_here:
                    ride.told_not_here = true
                    ride.line = ride_lift_not_here(ride.dest_name); ride.line_until = t + 5.0
                return
            paid = ride.fare > 0 and lift_fare_pay(living_world, ride.person, ride.fare, -1)
            _ = ride_thank(ride, t)
            ride.line = ride_lift_thanks(paid)
            if paid: say_toast("{phoenix_text(ride.fare)} for the lift.")
            return
        _ = ride_thank(ride, t)
        return
    st = pc.state
    v = RideView(moored = st.moored, on_water = st.on_water, speed = f64(length(st.velocity)), height = ride_height(), climb = f64(st.velocity.y), wrecked = st.crashed or st.capsized, throttle = pc.throttle)
    home_town = ride.origin
    loop k in 0..towns.len():
        if f64(length(vec2(towns[k].center.x - st.position.x, towns[k].center.z - st.position.z))) < 700.0: v.over_town = true
    # (their house in view and near: within a kilometre and a half and ahead, or just below)
    to_home = vec2(ride.home.x - st.position.x, ride.home.z - st.position.z)
    home_d = f64(length(to_home))
    fwd = vec2(st.velocity.x, st.velocity.z)
    ahead = f64(length(fwd)) > 1.0 and home_d > 1.0 and f64(dot(to_home / f32(home_d), normalize(fwd))) > 0.5
    v.house_near = ride.has_home and v.height < 900.0 and (home_d < 350.0 or (home_d < 1500.0 and ahead))
    loop p in 0..living_world.harbors.len():
        if p == home_town: continue
        if f64(length(vec2(living_world.harbors[p].center.x - st.position.x, living_world.harbors[p].center.z - st.position.z))) < 2500.0: v.place_seen = living.place_name(living_world, p)
    _ = ride_step(ride, v, t)
    if ride.stage == .landed and st.moored: _ = ride_thank(ride, t)

# they gave up waiting: out of the seat and home; they'll say so when next they meet the pilot,
# and it tells a little against him (a promise not kept, mildly)
ride_give_up = ():
    global ride, ride_declined, ride_owed
    if ride.person >= 0:
        ride_declined[ride.person] = living_world.minute
        ride_owed[ride.person] = true
        rep_act(living_world, .cut_short, ride.person)
        log_note(notebook, "{split(living_world.people[ride.person].name, " ")[0]} waited at the {CRAFT_NAMES[int(pc.kind)]} a good while, and went home.", clock_text(living_world, living_world.minute))
    ride = Joyride()

# the ride over: they climb out and are back in the town's routine; the world remembers it
ride_finish = ():
    global ride
    if ride.flew and ride.person >= 0:
        # (the pilot's name: a flight given is a small act of kindness, as a gift is (src/reputation.jo
        # rep_act; it warms them and a little of their town); and a private meeting they remember)
        rep_act(living_world, .gift, ride.person)
        place = living_world.people[living_world.player].place
        if place >= 0:
            ev = emit_event(living_world, .met, place, ride.person, living_world.player, lt.Reason(purpose = .passenger, actor = ride.person, counterparty = living_world.player, origin = place, destination = place), private = true)
            if ev in living_world.events: remember(living_world, ride.person, living_world.player, living_world.events[ev])
        first = split(living_world.people[ride.person].name, " ")[0]
        log_note(notebook, if ride.dest >= 0: "Gave {first} a lift to {ride.dest_name}, for the waters." else: "Took {first} up for a flight{if ride.top > 300.0: " round the island" else: ""}.", clock_text(living_world, living_world.minute))
        # (what the pilot did today, for his small talk: src/pilot_talk.jo)
        pilot_did(living_world.pilot_day, Doing(.ride, living_world.minute, who = split(living_world.people[ride.person].name, " ")[0]))
    ride = Joyride()

hide_ride_folk = ():
    global folks
    if ride.stage != .none and ride.who >= 0 and ride.who < folks.len(): folks[ride.who].shown = false

draw_ride_walking = (L: Light):
    if ride.stage != .walking: return
    if let f = ride_fig: draw_local_walker(f,WALK_RIDE,ride.pos,ride.yaw,ride.phase,0.8,L,t)

# the second seat, in the world (the aircraft as it lies)
ride_seat_world = () -> vec3: pc.state.position + quat_rotate(pc.state.orientation, ride_seat(player_model()))

draw_ride_seated = (m: CraftModel, at: mat4, L: Light):
    if ride.stage == .none or ride.stage == .walking: return
    if let f = ride_fig:
        seat = ride_seat(m)
        # (an arm out at their house; both hands on the cockpit's edge on the take-off run)
        arms = if t < ride.pointing_until: vec2(-9, 2.6) else: if ride.stage == .seated and pc.throttle > 0.3: vec2(1.0, 1.0) else: vec2(-9, -9)
        draw_figure_at(f, at * translation(seat - vec3(0, 1.55, 0)), 0.0, 0.0, L, t, seated = true, offset = world_residual(craft_point(pc.state)), arms = arms)

# The rescued pilot (src/rescued_rider.jo): their figure in flying kit, made once per person.
rider_takes = (person: int, in_water: vec3):
    global rider, rider_fig
    rider = rider_board(person, in_water, t, ride.stage != .none)
    p = living_world.people[person]
    rider_fig = build_figure(.pilot, p.appearance_seed, age = p.age, woman = person_woman(p.name))

rider_tick = (dt: f64):
    global rider, rider_fig, tender_way_on
    # (after a load, whoever the world has aboard is back in the seat)
    if rider.stage == .none:
        aboard = rescue_aboard(living_world)
        if aboard.len() > 0 and living_world.war.survivors[aboard[0]].person >= 0:
            person = living_world.war.survivors[aboard[0]].person
            rider = rider_seated(person, t, ride.stage != .none)
            p = living_world.people[person]
            rider_fig = build_figure(.pilot, p.appearance_seed, age = p.age, woman = person_woman(p.name))
    # (a passenger the pilot carries for a job: seen in the second seat, src/errands.jo too)
    if rider.stage == .none:
        person = job_passenger_aboard()
        if person >= 0:
            rider = rider_seated(person, t, ride.stage != .none)
            p = living_world.people[person]
            rider_fig = build_figure(dress_of(p.occupation), p.appearance_seed, age = p.age, woman = person_woman(p.name))
    # (and a skipper taken off a boat adrift: src/living_adrift.jo)
    if rider.stage == .none:
        person = adrift_aboard_person(living_world)
        if person >= 0:
            rider = rider_seated(person, t, ride.stage != .none)
            p = living_world.people[person]
            rider_fig = build_figure(dress_of(p.occupation), p.appearance_seed, age = p.age, woman = person_woman(p.name))
    # (gone into the town only out of sight: off the screen, or far off)
    if tender_way_on and rider.stage == .walking:
        if tender_local_below(rider.pos): rider = RescuedRider()
        else:
            goal = tender_deck_course(rider.pos)
            rider.away = normalize(goal-rider.pos+vec3(0.0001,0,0))
            rider.yaw = atan2(f64(rider.away.x),f64(rider.away.z))
            rider_step(rider,t,dt,tender_local_deck,false)
    else:
        unseen = rider.stage == .walking and (hud_point(rider.pos+vec3(0,1,0)) == none or f64(length(rider.pos-scene_camera())) > 120.0)
        rider_step(rider,t,dt,(x: f64,z: f64) -> f64?: (if walk_height(towns,x,z) > (if geography_enabled: water_at(x,z).level else: 0.0)+0.3: walk_height(towns,x,z) else: none),unseen)
    if rider.stage == .none: rider_fig = none; tender_way_on = false

draw_rider_seated = (m: CraftModel, at: mat4, L: Light):
    if rider.stage != .aboard: return
    if let f = rider_fig:
        seat = rider_seat(ride_seat(m), rider.on_wing, pc.spec.span)
        draw_figure_at(f, at * translation(seat - vec3(0, 1.55, 0)), 0.0, 0.0, L, t, seated = true, offset = world_residual(craft_point(pc.state)))

draw_rider_out = (L: Light):
    if let f = rider_fig:
        if rider.stage == .boarding:
            seat = pc.state.position + quat_rotate(pc.state.orientation, rider_seat(ride_seat(player_model()), rider.on_wing, pc.spec.span) - vec3(0, 1.55, 0))
            p = rider_climb_point(rider.from, seat, (t - rider.since) / RIDER_CLIMB)
            draw_figure(f, p, heading(pc.state), t * 3.0, 0.3, L, t, arms = vec2(2.6, 2.6))
        else if rider.stage == .alighting:
            p = rider_climb_point(rider.from - vec3(0, 1.55, 0), rider.pos, (t - rider.since) / RIDER_ALIGHT)
            draw_figure(f, p, rider.yaw, 0.0, 0.0, L, t)
        else if rider.stage == .walking:
            if tender_way_on:
                if let ship = vessel_view.poses.get(TENDER_ID):
                    draw_figure_at(f,ship*translation(rider.pos)*rotation_y(rider.yaw+PI),rider.phase,0.8,L,t,render_local=true)
            else: draw_local_walker(f,WALK_RESCUED,rider.pos,rider.yaw,rider.phase,0.8,L,t)

draw_ride_talk = ():
    if ride.stage == .none or ride.person < 0 or ride.line == "" or t > ride.line_until: return
    name = split(living_world.people[ride.person].name, " ")[0]
    set_font(fonts.ui)
    said = "{name}:  {ride.line}"
    size = min(20.0, 20.0 * (f64(screen_width()) - 60.0) / max(ptext_width(said, 20), 1.0))
    w = ptext_width(said, size) + 36.0
    x = (f64(screen_width()) - w) * 0.5
    # (below the compass, and below the touch buttons along the top where they reach)
    y = max(64.0, pad_top_clear(x, x + w) + 6.0)
    rect_rounded(x, y, w, 40, 8, rgba(0.95, 0.91, 0.8, 0.94))
    ptext(said, vec2(f32(x + 18), f32(y + (40.0 - size) * 0.45)), size, rgba(0.25, 0.15, 0.07, 1))
    set_font()
    # (on foot, the one speaking out of view: a marker at the screen's edge, toward them)
    if me.mode == .walking and (ride.stage == .walking or ride.stage == .waiting or ride.stage == .thanked):
        head = if ride.stage == .walking: ride.pos + vec3(0, 1.7, 0) else: ride_seat_world() + vec3(0, 0.6, 0)
        offscreen_pointer(fonts, head, name)

# ---------------- a night under a roof ----------------

# The hotel's room upstairs, behind the French window at the balcony's x = 4 (the hotel's frame).
stay_hotel_frame = () -> mat4: hotel.frame * translation(vec3(4.0, f32(DECK + 4.65), 16.0))

stay_point = (local: vec3) -> vec3: transform_point(stay.frame, local)
stay_yaw = (local: f64) -> f64:
    fz = normalize((stay.frame * vec4(0, 0, 1, 0)).xyz)
    atan2(f64(fz.x), f64(fz.z)) + local

stay_begin_hotel = ():
    global stay, ui, leisure_ui, stay_look_turn
    stay_look_turn = ViewTurn()
    global table_bar_area
    table_bar_area = Rect(0, 0, 0, 0)
    stay = Stay(active = true, kind = .hotel, host = hotel_place.keeper, place = hotel_place.place, frame = stay_hotel_frame(), started = living_world.minute)
    room_setup()
    ui = .leisure; leisure_ui = 15
    _ = mouse_lock(false)

# The family's own house (their home in the living world): false when it isn't in the scene.
stay_begin_family = (host: int) -> bool:
    global stay, ui, leisure_ui, stay_host_fig, stay_figs, stay_look_turn
    stay_look_turn = ViewTurn()
    global table_bar_area
    table_bar_area = Rect(0, 0, 0, 0)
    w = living_world
    p = w.people[host]
    home = choose_life_venue(w, p.home, .home, host)
    if home == none: return false
    v = home!
    f = normalize(vec3(v.facing.x, 0, v.facing.z) + vec3(0.0001, 0, 0))
    at = vec3(v.pos.x, f32(walk_height(towns, f64(v.pos.x), f64(v.pos.z))), v.pos.z)
    ids = [loop r in w.households: r.id]
    guardians = [loop r in w.households: r.guardian]
    stay = Stay(active = true, kind = .family, host = host, place = p.home, frame = translation(at) * rotation_y(atan2(f64(f.x), f64(f.z))), started = w.minute)
    stay.household = stay_household(guardians, ids, host)
    # (the host and the children as the town draws them: a grown fisherman stood in for each child)
    stay_host_fig = person_figure(p)
    stay_figs = [loop id in stay.household: life_view.child_figure(_resident(id))]
    stay_family_rooms(stay_rooms, trade_of(int(p.occupation)))
    clock = lt.local_minute(w.minute)
    if stay_supper_time(clock):
        stay.stage = .supper; stay.had_supper = true; stay.next_line = t + 2.0
    room_setup()
    ui = .leisure; leisure_ui = 15
    _ = mouse_lock(false)
    log_note(notebook, "Went home with {split(p.name, " ")[0]} to {living.place_name(w, p.home)}.", clock_text(w, w.minute))
    true

_resident = (id: int) -> social.HouseholdResident:
    loop r in living_world.households:
        if r.id == id: return r
    social.HouseholdResident(id, "", 9, 0, -1, vec3(0, 0, 0), vec3(0, 0, 0))

_resident_age = (id: int) -> int:
    loop r in living_world.households:
        if r.id == id: return r.age
    10

# Time passes in the room, seen: the light at the window turns as the clock runs on.
stay_sleep = (minutes: int, doing: str):
    global skip, stay
    stay.stage = .asleep
    skip = TimeSkip(active = true, left = minutes, total = minutes, doing = doing, after = 3, visible = true, rate = if minutes > 120: 3 else: 1)

stay_woke = ():
    global stay
    stay.slept = stay.slept or skip.total >= 240
    clock = lt.local_minute(living_world.minute)
    if stay.kind == .family and stay_supper_time(clock) and not stay.had_supper:
        stay.stage = .supper; stay.had_supper = true
    else if stay_morning_time(clock): stay.stage = .morning
    else: stay.stage = .awake
    stay.next_line = t + 1.5

# Where leaving the room puts the pilot: by the hotel's desk, or out of the family's door.
stay_exit = () -> (vec3, f64):
    if stay.kind == .hotel:
        return (vec3(hotel.desk.x, f32(walk_height(towns, f64(hotel.desk.x), f64(hotel.desk.z))), hotel.desk.z), atan2(f64(hotel.table_x.x), f64(hotel.table_x.z)))
    # (out of their door, a step into the street)
    out = stay_point(vec3(-1.1, 0, -3.0))
    (vec3(out.x, f32(walk_height(towns, f64(out.x), f64(out.z))), out.z), stay_yaw(PI))

stay_end = ():
    global stay, ui, me, follow, walker_point
    w = living_world
    host_name = if stay.host >= 0: split(w.people[stay.host].name, " ")[0] else: ""
    log_note(notebook, stay_note(stay, host_name, living.place_name(w, stay.place), hotel_place.name), clock_text(w, w.minute))
    me.pos, me.yaw = stay_exit()
    follow.yaw = me.yaw + PI; follow.distance = 5.5; follow.height = 1.6
    walker_point = world_point(me.pos)
    stay = Stay()
    ui = .none
    sync_folk(folks, living_world, towns)

# The room by its things (src/room_walk.jo): the pilot starts in the chair (at a family's, his
# place at their table), and goes where he's sent.
room_setup = ():
    global room_objs, room_rects, room_ways, room_me, room_hover, room_focus, room_press, room_eye, room_aim
    room_objs = room_objects(stay.kind); room_rects = room_furniture(stay.kind); room_ways = room_hubs(stay.kind)
    room_me = room_pilot_in(room_objs, room_index(.chair))
    room_hover = -1; room_focus = -1; room_press = vec2(-1, -1)
    room_eye = stay_eye_local(); room_aim = stay_look_local()

room_index = (thing: RoomThing) -> int:
    loop k in 0..room_objs.len():
        if room_objs[k].thing == thing: return k
    -1

# what a point on the screen is on, in the room
room_pick_at = (p: vec2) -> int:
    o, d = screen_ray(p)
    inv = inverse(stay.frame)
    lo = transform_point(inv, o)
    ld = normalize((inv * vec4(d, 0)).xyz)
    room_pick(room_objs, lo, ld)

# What tapping or clicking a thing does: the bed he's lying in, up; the window he's at, back to
# the chair; anything else, off there (up out of the bed or the chair first).
room_use = (k: int):
    global room_me, stay
    if k < 0 or k >= room_objs.len(): return
    o = room_objs[k]
    if o.thing == .bed and room_me.on == k and room_me.going == -1:
        room_get_up(room_me)
        return
    to = if o.thing == .window and stay.stage == .window: room_index(.chair) else: k
    if stay.stage == .window: stay.stage = room_prev_stage
    room_go(room_me, room_objs, room_rects, room_ways, to)

# Got there: lying down sleeps (until morning of an evening, else until the evening, unless he gets
# up first); at the window, the view goes out over the harbour; at the door, out.
room_arrive = (k: int):
    global stay, room_prev_stage
    o = room_objs[k]
    clock = lt.local_minute(living_world.minute)
    if o.thing == .bed:
        until = room_sleep_until(clock)
        stay_sleep(rest_minutes(living_world, until), if until == 420: "Asleep" else: "Resting")
    else if o.thing == .window:
        room_prev_stage = stay.stage; stay.stage = .window
    else if o.thing == .door: stay_end()

# each frame in the room: his walk, and the view easing to where it belongs
room_step_frame = (dt: f64):
    global room_me, room_eye, room_aim, stay_look_turn
    if not stay.active: return
    if not skip.active:
        got = room_step(room_me, room_objs, dt)
        if got >= 0: room_arrive(got)
    to_eye = stay_eye_local(); to_aim = stay_look_local()
    moving = f64(length(to_eye - room_eye)) > 0.03
    k = 1.0 - exp(-dt * 2.6)
    room_eye = mix(room_eye, to_eye, f32(k)); room_aim = mix(room_aim, to_aim, f32(k))
    # (going from one place of the view to another, a turned look comes back ahead)
    if moving: stay_look_turn = ViewTurn(stay_look_turn.yaw * (1.0 - k), stay_look_turn.pitch * (1.0 - k))

# The room's input: what is pointed at (the mouse; the arrow keys or a pad's d-pad), and a click,
# a tap or Enter on it. Asleep, any of them wakes him (he lies there till sent somewhere).
stay_frame = ():
    global room_hover, room_focus, room_press, skip, room_after_wake, room_escape_quiet
    if not stay.active: return
    if skip.active:
        room_hover = -1
        # (a tap or a click on a thing wakes him and sends him there once he's up; a key, Back
        # among them, only wakes him)
        if skip.after == 3 and skip.left > 1:
            woke = false
            if pad.tapped: room_after_wake = room_pick_at(pad.tap_at); woke = true
            else if not pad.on and mouse_pressed(.left): room_after_wake = room_pick_at(mouse_pos()); woke = true
            else if vpressed(.enter) or vpressed(.escape) or vpressed(.space): room_after_wake = -1; woke = true
            if woke: skip.left = 1; room_escape_quiet = t + 0.6
        return
    # (woken by a tap on a thing: there he goes)
    if room_after_wake >= 0:
        room_use(room_after_wake)
        room_after_wake = -1
    n = room_objs.len()
    room_hover = if not pad.on: room_pick_at(mouse_pos()) else: -1
    if room_hover >= 0 and mouse_delta() != vec2(0, 0): room_focus = -1
    if n > 0:
        if vpressed(.right) or vpressed(.down) or vpressed(.tab): room_focus = (room_focus + 1) % n
        if vpressed(.left) or vpressed(.up): room_focus = if room_focus < 0: n - 1 else: (room_focus - 1 + n) % n
    chosen = -1
    if vpressed(.enter) and room_focus >= 0: chosen = room_focus
    # (a click is a press and a let-go in the same place; a drag turns the view)
    if not pad.on:
        if mouse_pressed(.left): room_press = mouse_pos()
        if mouse_released(.left):
            if room_press.x >= 0.0 and f64(length(mouse_pos() - room_press)) < 8.0: chosen = room_pick_at(mouse_pos())
            room_press = vec2(-1, -1)
    if pad.tapped: chosen = room_pick_at(pad.tap_at)
    # (Escape, or a phone's Back: up, if he's lying down; in from the window; else out by the door.
    # Not the same press that woke him)
    if vpressed(.escape) and t > room_escape_quiet:
        lying = room_me.on >= 0 and room_objs[room_me.on].thing == .bed
        if lying: room_get_up(room_me)
        else: chosen = if stay.stage == .window: room_index(.window) else: room_index(.door)
    room_use(chosen)

# what is said at the table, now and then
stay_tick = ():
    global stay
    if not stay.active or skip.active: return
    if not stay_line_due(stay, t): return
    morning = stay.stage == .morning
    speaker = if morning: -1 else: stay_next_speaker(stay, stay.household.len())
    # (the host's own talk from the dialogue now and then, their day or the weather; between,
    # the ordinary words of the table)
    line = if speaker == -1 and stay.lines_said % 4 == 1 and stay.host >= 0: table_remark(living_world, stay.host, stay.lines_said / 4) else: ""
    if line == "": line = stay_line(stay, speaker, morning)
    stay_said(stay, speaker, line, t)

# where the view is (room-local): the room's corner, or up at the hotel's window beside him; at a
# family's, asleep, from the doorway of the room at the back
stay_eye_local = () -> vec3:
    if stay.kind == .hotel: return if stay.stage == .window: HOTEL_WINDOW_EYE else: HOTEL_EYE
    if stay.stage == .asleep: FAMILY_BED_EYE else: FAMILY_EYE
stay_look_local = () -> vec3:
    if stay.kind == .hotel: return if stay.stage == .window: vec3(-0.25, 1.2, 8.0) else: HOTEL_LOOK
    if stay.stage == .asleep: FAMILY_BED_LOOK else: FAMILY_LOOK
stay_eye = () -> vec3: stay_point(room_eye)
stay_look = () -> vec3: stay_point(room_aim)

stay_camera = ():
    eye = stay_eye()
    # (the look turned about the eye by the player's drags: yaw about the up axis, then pitch)
    look = normalize(stay_look() - eye)
    yaw = stay_look_turn.yaw; pitch = stay_look_turn.pitch
    flat = vec3(f32(f64(look.x) * cos(yaw) + f64(look.z) * sin(yaw)), look.y, f32(f64(look.z) * cos(yaw) - f64(look.x) * sin(yaw)))
    lift = clamp(asin(clamp(f64(flat.y), -1.0, 1.0)) + pitch, -1.2, 1.2)
    h = normalize(vec3(flat.x, 0, flat.z) + vec3(0.0001, 0, 0))
    dir = h * f32(cos(lift)) + vec3(0, f32(sin(lift)), 0)
    # (a phone held upright: wider, so the room's things are in the narrow view)
    aspect = f64(screen_width()) / max(f64(screen_height()), 1.0)
    fov = if aspect < 1.0: clamp(degrees(2.0 * atan(tan(radians(31.0)) / aspect)), 62.0, 88.0) else: 62.0
    render_camera(eye, dir, fov, 0.05, world_far(f64(eye.y)))

# the room's light: the day through the window, a lamp's warmth after dark (out while asleep)
stay_light = (L: Light) -> Light:
    out = L
    day = smoothstep(-0.05, 0.25, f64(normalize(L.sun_dir).y))
    lamp = (1.0 - day) * (if stay.stage == .asleep: 0.0 else: 1.0)
    out.sun = L.sun * f32(0.45 * day)
    asleep = if stay.stage == .asleep: 1.0 else: 0.0
    # (asleep in the dark: the lamp out, a little moonlight's blue to see the room by)
    out.shade = L.shade * f32(0.55 + 0.35 * day) + vec3(0.5, 0.36, 0.2) * f32(lamp) + vec3(0.05, 0.06, 0.09) * f32(1.0 - day) + vec3(0.07, 0.08, 0.13) * f32((1.0 - day) * asleep)
    out

draw_stay = (L: Light):
    clear_depth()
    hotel_stay = stay.kind == .hotel
    day = smoothstep(-0.05, 0.25, f64(normalize(L.sun_dir).y))
    night = day < 0.5
    # (the room baked three ways: by day, the window's light; of an evening, the lamp's pool;
    # asleep, the lamp out; the day's dimmed toward dusk)
    mode = if stay.stage == .asleep and night: 2 else: if night: 1 else: 0
    rooms = if hotel_stay: stay_rooms.hotel else: stay_rooms.family
    m = stay.frame
    exposure = if mode == 0: 0.55 + 0.45 * day else: 1.0
    if rooms.len() == 3: draw(obj_sh, rooms[mode], obj_params(stay_room_light(L, exposure), t, m))
    # (what is pointed at, drawn again over itself a little brighter)
    lit = room_lit()
    things = if hotel_stay: stay_rooms.hotel_things else: stay_rooms.family_things
    if lit >= 0 and things.len() == 3 and lit < things[mode].len():
        glow = f32(1.16 + 0.05 * sin(t * 3.2))
        draw(obj_sh, things[mode][lit], obj_params(stay_room_light(L, exposure), t, m, tint = vec4(glow, glow, glow * 0.97, 1)))
    Ls = stay_light(L)
    if night and stay.stage != .asleep: draw(obj_sh, if hotel_stay: stay_rooms.hotel_lamp else: stay_rooms.lamp, obj_params(Ls, t, m))
    # (the pilot where his walk has him: in the chair, on his way, at the window, lying down)
    body = room_body(room_me, room_objs)
    # (not while he passes right under the view: a body a hand's breadth from the eye would fill it)
    near_eye = f64(length(stay_point(body.pos + vec3(0, 1.3, 0)) - scene_camera())) < 1.1
    if not near_eye: draw_figure(player_figure(), stay_point(body.pos), stay_yaw(body.yaw), room_me.phase, room_me.stride, Ls, t, posture = (if body.posture == 2: 6 else: if body.posture == 3: 7 else: body.posture), settle = body.amount)
    if hotel_stay: return
    # (the family's house: the host across the table; at supper, those they look after round it, a
    # plate each, the pot and the jug between; asleep, the house is abed)
    if stay.stage == .asleep: return
    if let hf = stay_host_fig:
        hs = FAMILY_SEATS[1]
        draw_figure(hf, stay_point(hs.at), stay_yaw(hs.yaw), 0.0, 0.0, Ls, t, posture = 1, bounce = if stay.speaker == -1 and t < stay.line_until: 0.01 * sin(t * 9.0) else: 0.0)
    top = FAMILY_TABLE + vec3(0, 0.775, 0)
    supper = stay.stage == .supper
    if supper:
        loop k in 0..stay_figs.len():
            s = FAMILY_SEATS[2 + k]
            draw_figure(stay_figs[k], stay_point(s.at), stay_yaw(s.yaw), 0.0, 0.0, Ls, t, posture = 1)
    places = 2 + (if supper: stay_figs.len() else: 0)
    loop k in 0..places:
        s = FAMILY_SEATS[k]
        spot = top + (s.at - FAMILY_TABLE) * 0.55
        item = if supper: MenuItem("Supper", "Food", "At home", serve = .bowl, food = true) else: MenuItem("Coffee", "Coffee", "At home", serve = .cup)
        draw_serving(serve_parts, Served(item, 0, k, amount = 0.6), m * translation(vec3(spot.x, top.y, spot.z)) * rotation_y(f64(k)) * scaling(1.2), Ls, t)
    if supper:
        draw_serving(serve_parts, Served(MenuItem("Bread", "Food", "At home", serve = .plate, food = true), 0, 0, amount = 0.7), m * translation(top) * scaling(1.3), Ls, t)
        draw_serving(serve_parts, Served(MenuItem("Wine", "Wine", "At home", serve = .bottle), 0, 0), m * translation(top + vec3(0.32, 0, 0.05)) * scaling(1.2), Ls, t)

# what is lit: the mouse's, else the keys' or the pad's choice; nothing while he's on his way
room_lit = () -> int:
    if not stay.active or skip.active or room_busy(room_me) or ui != .leisure or leisure_ui != 15: return -1
    if room_hover >= 0: room_hover else: room_focus

# The lit thing's label (what it does now), small, over it; one corner line for the keys.
draw_room_label = ():
    lit = room_lit()
    if lit >= 0:
        o = room_objs[lit]
        clock = lt.local_minute(living_world.minute)
        label = room_label(o, stay.kind, clock, room_me.on == lit, stay.stage == .window)
        at = stay_point(vec3((o.lo.x + o.hi.x) * 0.5, min(o.hi.y + 0.12, 2.3), (o.lo.z + o.hi.z) * 0.5))
        if stay.stage == .window and o.thing == .window: at = stay_point(stay_look_local() * 0.1 + room_eye * 0.9 + vec3(0, -0.25, 0))
        if let sp = world_to_screen(at):
            set_font(fonts.ui)
            size = readable(15.0)
            w = ptext_width(label, size) + 18.0
            x = clamp(f64(sp.x) - w * 0.5, 8.0, f64(screen_width()) - w - 8.0)
            y = clamp(f64(sp.y) - size * 1.6, 8.0, f64(screen_height()) - size * 2.0)
            rect_rounded(x, y, w, size * 1.5, size * 0.75, rgba(0.08, 0.07, 0.06, 0.55))
            ptext_centered(label, vec2(f32(x + w * 0.5), f32(y + size * 0.75)), size, rgba(1, 0.96, 0.86, 0.95))
            set_font()
    # (the keys, once, small, in the corner: a pointer or a finger needs none)
    if pad.on or skip.active: return
    hint = if ctl.used: "D-pad  choose    A  use    B  leave" else: "Click a thing to use it    Arrows  choose    Enter  use    Esc  leave"
    set_font(fonts.ui)
    size = readable(12.0)
    ptext(hint, vec2(14, f32(f64(screen_height()) - size - 12.0)), size, rgba(1, 0.97, 0.9, 0.5), shadow = rgba(0, 0, 0, 0.35))
    set_font()

draw_stay_talk = ():
    draw_room_label()
    if stay.stage == .asleep:
        # (a small clock while the time passes: no dark card, the room is there to see)
        clock = lt.local_minute(living_world.minute)
        tc = "{clock / 60:02}:{clock % 60:02}"
        set_font(fonts.ui)
        w = ptext_width(tc, 22) + 32.0
        rect_rounded((f64(screen_width()) - w) * 0.5, 18, w, 40, 8, rgba(0.08, 0.1, 0.14, 0.55))
        ptext_centered(tc, vec2(f32(f64(screen_width()) * 0.5), 38), 22, rgba(1, 0.97, 0.9, 1))
        set_font()
        return
    if stay.line == "" or t > stay.line_until or stay.kind != .family: return
    speaker_at = if stay.speaker == -1: FAMILY_SEATS[1].at else: FAMILY_SEATS[min(2 + stay.speaker, FAMILY_SEATS.len() - 1)].at
    head = stay_point(speaker_at + vec3(0, 1.2, 0))
    name = if stay.speaker == -1 and stay.host >= 0: split(living_world.people[stay.host].name, " ")[0] else: _resident_name(if stay.speaker >= 0 and stay.speaker < stay.household.len(): stay.household[stay.speaker] else: -1)
    speech_bubble(fonts, head, name, stay.line, f64(length(head - scene_camera())))

_resident_name = (id: int) -> str:
    loop r in living_world.households:
        if r.id == id: return split(r.name, " ")[0]
    ""

# ---------------- company at the table ----------------

# Someone comes over (when the sitting's plan says so, and the pilot is sitting quietly): of the
# townsfolk about, those the pilot knows and, at the hotel, the pilots most likely.
company_come = ():
    global company
    seat_at = leisure_seat(leisure.sitting)
    cands: Candidate[]
    loop k in 0..folks.len():
        f = folks[k]
        if not f.shown or f.performing or f.cycling or f.carrying: continue
        d = f64(length(f.pos - seat_at))
        if d > 45.0 or d < 2.5: continue
        p = living_world.people[f.person]
        if p.age < 16 or f.person == living_world.player: continue
        # (the band's players aren't free while the band wants them: src/band_roster.jo)
        if band_wanted(living_world, f.person) > 0: continue
        weight = 1.0
        if leisure.sitting != "coffee" and (p.occupation == .courier or p.occupation == .racer or p.occupation == .patrol): weight += 2.0
        if f.person in living_world.speech and living_world.player in living_world.speech[f.person].acquaintance: weight += 2.0
        # (what they've heard of him: src/reputation_talk.jo)
        weight *= rep_pull(living_world, f.person)
        cands.push(Candidate(k, f.person, f.pos, weight))
    k = company_pick(cands, random(0.0, 1.0))
    if env("AEGEAN_COMPANY") != none: print("COMPANY come: {cands.len()} about, {if k >= 0: living_world.people[cands[k].person].name else: "nobody"}")
    if k < 0 or (leisure.sitting == "coffee" and (tavli_active())):
        company.due = -1.0
        return
    at_bar = leisure.sitting == "bar"
    ground = (p: vec3) -> vec3: vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)
    seat = if at_bar: ground(hotel.stools[2]) + vec3(0, f32(STOOL_LIFT), 0) else: if leisure.sitting == "coffee": tavli_across() else: ground(hotel.table * 2.0 - hotel.seat)
    yaw = if at_bar: hotel.bar_yaw else: if leisure.sitting == "coffee": coffee.seat_yaw + PI else: hotel.seat_yaw + PI
    # (to ask, they stop beside the table, a step to the side of the chair they would take)
    across = normalize(vec3(seat.x - me.pos.x, 0, seat.z - me.pos.z) + vec3(0.0001, 0, 0))
    stand = ground(seat + vec3(-across.z, 0, across.x) * 0.75)
    # (one who has heard of something he did has something to say)
    heard = rep_view(living_world, cands[k].person).deed >= 0
    global company_greeted
    company_greeted = false
    company_start(company, cands[k], seat, yaw, stand, (not at_bar) or heard or random(0.0, 1.0) < COMPANY_TALKS_AT_BAR, t)
    # (in the bar room, one from outside comes in by the door)
    company.pos = room_way_in(hotel, seat, company.pos); company.from = company.pos
    # (captures, AEGEAN_COMPANY: they set off from a few steps away, so a clip sees them come)
    if env("AEGEAN_COMPANY") != none:
        away = normalize(vec3(company.pos.x - seat.x, 0, company.pos.z - seat.z) + vec3(0.0001, 0, 0))
        company.pos = ground(seat + away * 7.0); company.from = company.pos

tavli_active = () -> bool: ui == .leisure and (leisure_ui == 6 or leisure_ui == 7)

# Someone sat at a table on the hotel's terrace (as the town's routine sits them, src/townsfolk.jo):
# the table's middle, the chair across from them and the way it faces, or none.
_terrace_table = (k: int) -> (vec3, vec3, f64)?:
    if k < 0 or k >= folks.len(): return none
    f = folks[k]
    if f.posture != 1 or not f.shown or not (f.person in living_world.daily_life): return none
    intent = living_world.daily_life[f.person]
    if not intent.arrived or intent.venue != .cafe or not intent.anchor.ends_with(social.TERRACE_VENUE_SUFFIX): return none
    loop v in living_world.life_venues:
        if v.key != intent.anchor: continue
        if f64(length(v.pos - hotel.table)) > 60.0: return none
        side = vec3(-v.facing.z, 0, v.facing.x)
        best = v.pos; bd = 1000000.0
        loop c in 0..4:
            centre = v.pos + side * f32(f64(c - 1) * 4.4)
            d = f64(length(centre.xz - f.pos.xz))
            if d < bd: bd = d; best = centre
        across = vec3(best.x - f.pos.x, 0, best.z - f.pos.z)
        if f64(length(across)) < 0.2: return none
        seat = vec3(best.x + across.x, f.pos.y, best.z + across.z)
        return (best, seat, atan2(f64(-across.x), f64(-across.z)))
    none

# "Mind if I sit?": asked of someone sat at a terrace table while the house is open, once a day.
sit_asked: {int: int} = {}        # (person -> the day they were asked)
can_ask_to_sit = (k: int) -> bool:
    if leisure.sitting != "" or k < 0 or k >= folks.len() or not leisure_open(living_world, hotel_place): return false
    p = folks[k].person
    if band_wanted(living_world, p) > 0 or sit_asked.get(p, -1) == lt.day_index(living_world.minute): return false
    _terrace_table(k) != none

# Their answer follows what they've heard of him (src/reputation_talk.jo); being asked is a
# kindness either way. Yes: he sits across from them. No: they say why, in the talk.
ask_to_sit = (k: int) -> str:
    global sit_asked
    p = folks[k].person
    roll = if env("AEGEAN_INVITE") == "no": 0.999 else: if env("AEGEAN_INVITE") == "yes": 0.0 else: random(0.0, 1.0)
    yes = rep_accepts(living_world, p, roll)
    said = if yes: rep_accept_line(living_world, p) else: rep_decline_line(living_world, p)
    rep_act(living_world, .asked_over, p)
    sit_asked[p] = lt.day_index(living_world.minute)
    if yes: leisure_sit_with(k, said)
    said

# Sitting down across from someone at their table: the hotel's sitting at the "guest" seat, and
# them as the company already sat with him.
leisure_sit_with = (k: int, said: str):
    if let tb = _terrace_table(k):
        global guest_seat, guest_yaw, guest_spots, company, company_line, company_line_until, company_greeted
        centre = tb.0
        guest_seat = tb.1; guest_yaw = tb.2
        toward = normalize(vec3(guest_seat.x - centre.x, 0, guest_seat.z - centre.z))
        side = vec3(-toward.z, 0, toward.x)
        top = vec3(centre.x, hotel.table.y - hotel.seat.y + guest_seat.y, centre.z)
        guest_spots = ServiceSpots(hotel.waiter_pass, top + side * 0.9 - vec3(0, top.y - guest_seat.y, 0), top, side, toward)
        f = folks[k]
        leisure_sit("guest")
        company = Company(stage = .sitting, who = k, person = f.person, talks = true, pos = f.pos, yaw = atan2(f64(centre.x - f.pos.x), f64(centre.z - f.pos.z)), from = f.pos, seat = f.pos, since = t, next_line = t + COMPANY_FIRST_LINE)
        company.seat_yaw = company.yaw
        company_greeted = false
        company_line = said; company_line_until = t + 5.0

rep_ask_due = -1.0                # (capture: "Mind if I sit?" asked a moment after talk begins, and of whom)
rep_ask_k = -1
rep_talk_due = -1.0               # (capture: the talk begun a moment after the scene is seen)

company_tick = (dt: f64):
    global company, company_line, company_line_until, leisure_ui, rep_ask_due, rep_talk_due
    if rep_talk_due >= 0.0 and t >= rep_talk_due:
        rep_talk_due = -1.0
        _leisure_talk(rep_ask_k)
        print("REP talk: {ui_line}")
    if rep_ask_due >= 0.0 and t >= rep_ask_due and ui == .talk:
        rep_ask_due = -1.0
        said = ask_to_sit(rep_ask_k)
        if leisure.sitting == "":
            global ui_line
            ui_line = said_by(living_world.people[folks[rep_ask_k].person].name, said)
        print("REP asked to sit: {said} (sitting {leisure.sitting})")
    if company_due(company, t) and seat_view(): company_come()
    if company.stage == .none: return
    # (one of the band's players, called to the stand: they excuse themselves and go to it, back
    # to where the town has them on their way there)
    if company.person >= 0 and band_wanted(living_world, company.person) == 2 and company.who >= 0 and company.who < folks.len():
        goal = folks[company.who].pos
        if band_on_stage(living_world, company.person):
            if let step = band_step_point(living_world, company.person): goal = step
        if company.stage != .leaving:
            company_line = "Forgive me. They want me at the stand."; company_line_until = t + 5.0
            if ui == .leisure and leisure_ui == 14: leisure_ui = 0
        company_called_away(company, goal)
        company.from = goal
    st = company_step(company, t, dt, leisure.sitting != "", (x: f64, z: f64) -> f64: walk_height(towns, x, z))
    if st.asks and leisure.sitting != "" and ui == .leisure and leisure_ui == 0: leisure_ui = 14
    if company.stage == .sitting and (st.speak or t >= storm_check_at):
        global company_greeted
        line = chat_at(company.person,lt.person_place(living_world,company.person),true,warnings_only=not st.speak)
        if line != "":
            company_greeted = true
            if env("AEGEAN_COMPANY") != none: print("COMPANY says {living_world.people[company.person].name}: {line}")
            company_line = line; company_line_until = t + 7.0
        # (captures: AEGEAN_COMPANY_GAP=<seconds> between their remarks)
        if st.speak:
            if let gap = env("AEGEAN_COMPANY_GAP"): company.next_line = t + (to_float(gap) ?? 12.0)
    if st.gone: company_line = ""

# (the one who has come over is drawn by the table, not where the town's routine has them)
hide_company_folk = ():
    global folks
    if company.stage != .none and company.who >= 0 and company.who < folks.len(): folks[company.who].shown = false

draw_company = (L: Light):
    if company.stage == .none or company.who < 0 or company.who >= folks.len(): return
    f = folks[company.who]
    sitting = company.stage == .sitting
    walking = company.stage == .coming or company.stage == .leaving
    light = leisure_light(L, hotel, coffee.seat)
    if walking: draw_local_walker(f.fig,WALK_COMPANY,company.pos,company.yaw,company.phase,0.8,light,t)
    else: draw_figure(f.fig,company.pos,company.yaw,company.phase,0.0,light,t,posture=if sitting:1 else:0)

# ---------------- tipping the band ----------------

tip_thanks_cents = 0                # (a tip waiting for its thanks, and when it was given)
tip_thanks_at = -1.0
tip_thanks_line = ""                # (the thanks being said, by whom, till when)
tip_thanks_who = -1
tip_thanks_until = -1.0

# Near the jar on foot (the terrace's stand), with the band's evening on.
tip_jar_here = () -> bool:
    if not hotel.ok or me.mode != .walking or leisure.sitting != "": return false
    if not (band_evening(living_world) or living_world.band.index >= 0): return false
    j = band_jar_at(hotel)
    # (on the piano in the bar room, it is reached across the stand from its front)
    inside = room_point_inside(hotel, j)
    f64(length(vec2(j.x - me.pos.x, j.z - me.pos.z))) < (if inside: 4.6 else: 2.2) and abs(f64(j.y - me.pos.y)) < 2.0

# A coin or a note in the jar (src/leisure.jo leisure_tip): the ledger, the reputation; thanks
# come from the stand between numbers.
tip_frame = ():
    global leisure_line, tip_thanks_cents, tip_thanks_at, leisure_spent, leisure_had
    w = living_world
    r = choice_panel(fonts, "Tip the band", "Into the jar on the stand", leisure_line, ["A small coin, {phoenix_text(TIP_COIN)}", "A note, {phoenix_text(TIP_NOTE)}", "Not now"])
    if r.choice == 0 or r.choice == 1:
        o = leisure_tip(living_world, hotel_place, if r.choice == 0: TIP_COIN else: TIP_NOTE)
        if o.ok:
            if leisure.sitting != "":
                leisure_spent += o.cents; leisure_had.push("a tip for the band")
            else: log_note(notebook, "{o.message} At the Hotel Ancora, {phoenix_text(o.cents)}.", clock_text(w, w.minute))
            tip_thanks_cents = o.cents; tip_thanks_at = t
            say_toast(o.message)
            _leisure_back()
        else: leisure_line = o.message
    else if r.choice == 2 or r.closed: _leisure_back()

# The thanks, from the player at the front of the stand once the number is over: a word, or for a
# note, the next one dedicated. (None if the evening ends first.)
tip_thanks_step = ():
    global tip_thanks_cents, tip_thanks_line, tip_thanks_who, tip_thanks_until
    if tip_thanks_cents <= 0: return
    if t - tip_thanks_at > 600.0: tip_thanks_cents = 0; return
    if let from = band_thanks_from(hotel, living_world.band, living_world.tick):
        lines = ["Thank you kindly.", "Much obliged, signore.", "That's good of you."]
        tip_thanks_line = if tip_thanks_cents >= TIP_NOTE: "This one's for the pilot." else: lines[int(t) % lines.len()]
        tip_thanks_who = from.0; tip_thanks_until = t + 5.0
        tip_thanks_cents = 0

draw_tip_thanks = ():
    if t >= tip_thanks_until or tip_thanks_who < 0: return
    if let from = band_thanks_from(hotel, living_world.band, living_world.tick):
        if from.0 == tip_thanks_who:
            speech_bubble(fonts, from.1, split(living_world.people[tip_thanks_who].name, " ")[0], tip_thanks_line, f64(length(from.1 - scene_camera())), 30.0)

draw_company_talk = ():
    # (the pilot's own word, over his head)
    if town_speech.answered:
        ph = me.pos + vec3(0, if leisure.sitting != "": 1.25 else: 1.75, 0)
        speech_bubble(fonts, ph, "", town_speech.turn.reply, f64(length(ph - scene_camera())))
    if company.stage == .none or company.person < 0: return
    head = company.pos + vec3(0, if company.stage == .sitting: 1.25 else: 1.7, 0)
    name = split(living_world.people[company.person].name, " ")[0]
    if company.stage == .asking: speech_bubble(fonts, head, name, "May I join you?", f64(length(head - scene_camera())))
    else if company_line != "" and t < company_line_until: speech_bubble(fonts, head, name, company_line, f64(length(head - scene_camera())))

# How fast someone's words arrive in a panel: by their voice and their years (src/speech_stream.jo).
person_spoken_rate = (person: int) -> f64:
    if person < 0 or person >= living_world.people.len(): return SPOKEN_RATE
    spoken_rate(voice_of_context(living_world, person), living_world.people[person].age)

# The conversation in the panel, over the two heads in the world: their line arriving as the
# panel's does, and what the pilot said. Both kept above the panel's edge and off each other;
# both gone when the conversation is. (Before the panel is drawn, so it lies over them.)
draw_talk_bubbles = ():
    global talk_bubbles
    talking = ui == .talk and ui_folk >= 0 and ui_folk < folks.len()
    person = if talking: folks[ui_folk].person else: -1
    said = if talking: spoken_peek("talk", ui_line) else: Said()
    was = talk_bubbles.person
    talk_bubbles_step(talk_bubbles, talking, person, ui_line, said.done, t)
    if was >= 0 and talk_bubbles.person < 0: spoken_forget("talk")
    if not talking: return
    floor = conversation_top()
    f = folks[ui_folk]
    seated_with = company.stage == .sitting and company.who == ui_folk
    head = if seated_with: company.pos + vec3(0, 1.25, 0) else: folk_view_position(f) + vec3(0, if f.posture == 1: 1.25 else: 1.7, 0)
    mine = me.pos + vec3(0, if leisure.sitting != "": 1.25 else: 1.75, 0)
    theirs: BubbleBox? = if talk_person_speaks(talk_bubbles, t) and said.shown != 0: bubble_box(fonts, head, living_world.people[person].name, ui_line, floor) else: none
    own: BubbleBox? = if talk_pilot_speaks(talk_bubbles, t): bubble_box(fonts, mine, "", talk_bubbles.pilot, floor) else: none
    if theirs != none and own != none:
        a = theirs!; b = own!
        bubbles_apart(a, b, f64(screen_width()))
        theirs = a; own = b
    if let b = own: bubble_draw(fonts, b, 1.0)
    if let a = theirs: bubble_draw(fonts, a, 1.0, said.shown)

# ---------------- the view about the seat ----------------
# Seated, the camera turns about the pilot as the taxiing orbit does: a drag of the mouse (either
# button; one begun on the table's bar is the bar's), the right stick or a finger turns it, the
# wheel or a pinch brings it nearer or farther; the follow camera keeps it out of the walls.

seat_drag = false                # (the left button's drag began on the scene, not on the bar)
table_bar_area = Rect(0, 0, 0, 0)

# what turns the view this frame, seated or in a room: a drag begun off the table's bar (one
# finger, or two together on a touch screen; either mouse button with a mouse), and whether a press
# began this frame (its jump is no drag)
seat_drag_input = () -> (vec2, bool):
    global seat_drag
    if pad.on:
        # (a touch screen: the fingers only; its mouse follows the first finger and would count twice)
        off_bar = not contains(table_bar_area, pad.drag_at)
        d = if pad.two: pad.orbit else: if off_bar: pad.aim else: vec2(0, 0)
        return (d, false)
    pressed = mouse_pressed(.left) or mouse_pressed(.right)
    if mouse_pressed(.left): seat_drag = not contains(table_bar_area, mouse_pos())
    if not mouse_down(.left): seat_drag = false
    d = if mouse_down(.right) or seat_drag: mouse_delta() else: vec2(0, 0)
    (d, pressed)

seat_orbit_step = (dt: f64):
    global follow
    inp = seat_drag_input()
    up = if options.invert_y: -1.0 else: 1.0
    v = view_turn(ViewTurn(follow.yaw, follow.pitch), inp.0, inp.1, ctl.look, dt, up, -0.1, 1.2, touch = pad.on)
    follow.yaw = v.yaw; follow.pitch = v.pitch
    zoom = wheel_zoom()
    if pad.on and pad.zoom > 0.0 and abs(pad.zoom - 1.0) > 0.001: zoom = zoom / pad.zoom
    follow.distance = clamp(follow.distance * zoom, 1.4, 7.0)
    follow.height = approach(follow.height, 1.25, 4.0, dt)

# In a room (a stay), the view looks about from where it is: a turn of the head, kept within the room.
stay_look_turn = ViewTurn()
stay_look_step = (dt: f64):
    global stay_look_turn
    inp = seat_drag_input()
    up = if options.invert_y: -1.0 else: 1.0
    v = view_turn(stay_look_turn, inp.0, inp.1, ctl.look, dt, up, -0.6, 0.6, touch = pad.on)
    # (all the way round: the door may be behind)
    v.yaw = v.yaw - TAU * floor((v.yaw + PI) / TAU)
    stay_look_turn = v

_ahead = () -> vec3: vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw)))
_right = () -> vec3: vec3(f32(-cos(me.yaw)), 0, f32(sin(me.yaw)))

# On a dock or quay, facing deep enough water a step or two out.
fish_water_ahead = () -> bool:
    if me.mode != .walking or f64(me.pos.y) > 4.0 or f64(me.pos.y) < 0.3: return false
    out = me.pos + _ahead() * 3.0
    # (a floor over the water is no water: the bar room's)
    if walk_floor_height(out.xz, -1e9) > -1e8: return false
    # (nor is the hotel's terrace a dock: its tables, its band, its rail over the water; nor its bar
    # room, whose windows look over the water)
    if hotel.ok and room_point_inside(hotel, me.pos): return false
    if hotel.ok:
        loop tb in hotel.tables:
            if f64(length(vec2(tb.x - me.pos.x, tb.z - me.pos.z))) < 6.5: return false
        if f64(length(vec2(hotel.stage.x - me.pos.x, hotel.stage.z - me.pos.z))) < 7.0: return false
    surface_height(f64(out.x), f64(out.z)) <= -0.6

# On a dock or quay in a harbour town, facing deep enough water, away from one's own mooring and
# from anyone close enough to talk to.
fishing_here = () -> bool:
    if me.mode != .walking or living_world.people[living_world.player].place < 0: return false
    if not fish_water_ahead(): return false
    if nearest_folk(folks, me.pos, 3.5) >= 0 or near_own_craft(): return false
    if let a = mooring_anchor():
        if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 8.0: return false
    true

fishing_begin = ():
    global ui, leisure_ui, leisure_line, angling, follow
    angling = Angling(place = living_world.people[living_world.player].place)
    ui = .leisure; leisure_ui = 10; leisure_line = ""
    follow.yaw = me.yaw + PI + 0.35; follow.pitch = 0.18; follow.distance = 4.2
    # (the bucket in his hand goes down on the dock beside him)
    global fish_bucket_beside
    fish_bucket_beside = fish.carrying
    if fish.carrying >= 0: _ = fish_put_down(fish, fish_ground(me.pos + _right() * 0.55 - _ahead() * 0.25), me.yaw)
    mouse_lock(false)

fishing_end = ():
    global ui, follow
    if angling.caught.len() > 0:
        log_note(notebook, "Fished from the dock at {living.place_name(living_world, angling.place)}: {if angling.caught.len() == 0: "nothing caught" else: fishing_tally(angling)}.", clock_text(living_world, living_world.minute))
        # (what the pilot did today, for his small talk: src/pilot_talk.jo)
        pilot_did(living_world.pilot_day, Doing(.fished, living_world.minute))
    follow.distance = 5.5
    # (and he picks the bucket up again)
    k = fish_bucket_index(fish, fish_bucket_beside)
    if k >= 0 and fish.buckets[k].where == BUCKET_DOWN and f64(length(fish.buckets[k].at - me.pos)) < 2.5: _ = fish_pick_up(living_world, fish, k)
    ui = .none

# the rod's tip and where the float is (the scene draws them)
fishing_tip = () -> vec3: me.pos + _ahead() * 1.9 + vec3(0, 2.05, 0) - _right() * 0.3
fishing_float = () -> vec3:
    out = me.pos + _ahead() * 6.5
    rest = vec3(out.x, f32(0.04 + sin(t * 1.7) * 0.025 - fishing_float_dip(angling) * 0.16), out.z)
    if angling.stage == 1:
        u = clamp(angling.clock / 0.8, 0.0, 1.0)
        tip = fishing_tip()
        p = tip + (rest - tip) * f32(u)
        return p + vec3(0, f32(sin(u * PI) * 1.6), 0)
    rest

draw_fishing = ():
    if not (ui == .leisure and leisure_ui == 10): return
    hand = me.pos + _ahead() * 0.35 + vec3(0, 1.15, 0) - _right() * 0.3
    tip = fishing_tip()
    draw_line3d(hand, tip, rgba(0.36, 0.24, 0.12, 1), 0.035)
    if angling.stage == 0 or angling.stage == 4: return
    f = fishing_float()
    draw_line3d(tip, f + vec3(0, 0.06, 0), rgba(0.9, 0.9, 0.85, 0.7), 0.006)
    draw_line3d(f, f + vec3(0, 0.11, 0), rgba(0.85, 0.12, 0.08, 1), 0.085)
    draw_line3d(f - vec3(0, 0.05, 0), f, rgba(0.95, 0.94, 0.9, 1), 0.085)

# ---------------- the catch in hand, and the bucket ----------------
# (src/fishing.jo FishHold: saved with the game; none of it in the world's stock until sold or eaten)

fish = FishHold()
fish_meshes = build_fish_meshes()
fish_landed_at = -100.0             # (when the fish in the hand came out of the water: it flaps a while)

struct FishThrow:
    c: Catch
    from: vec3
    to: vec3
    at = 0.0
fish_throws: FishThrow[]
fish_rings: Splash[]

fish_bucket_beside = -1            # (the bucket set down beside him while he fishes: its id)

fish_ground = (p: vec3) -> vec3: vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)

# the bucket in his hand
fish_bucket_carried = () -> bool: fish_carried(fish) >= 0
# (a fish in the hand, or the bucket of fish carried: nothing that wants both hands, or a free one)
fish_hands_busy = () -> bool: fish_in_hand(fish) or (fish_bucket_carried() and fish_pail(fish).len() > 0)

# a bucket within reach that he may take (his own, one lent him, one in his locker): its index
fish_bucket_near = () -> int:
    best = -1; bd = 1.7
    loop k in 0..fish.buckets.len():
        b = fish.buckets[k]
        if b.where == BUCKET_CARRIED or not fish_may_take(living_world, b): continue
        at = if b.where == BUCKET_LOCKER: fish_stall_customer(fish_locker_of()) else: b.at
        d = f64(length((at - me.pos).xz))
        if d < bd:
            bd = d; best = k
    best

# the bucket the catch goes into: the one in the hand, else one set down within reach
fish_bucket_reach = () -> int:
    k = fish_carried(fish)
    if k >= 0: return k
    best = -1; bd = 2.6
    loop i in 0..fish.buckets.len():
        b = fish.buckets[i]
        if b.where != BUCKET_DOWN or not fish_may_take(living_world, b): continue
        d = f64(length((b.at - me.pos).xz))
        if d < bd:
            bd = d; best = i
    best

# the player's locker at his home port (src/fish_stall.jo), placed and made solid once
fish_locker = FishStall(place = -2)
fish_locker_of = () -> FishStall:
    global fish_locker
    if fish_locker.place == -2:
        home = living_world.people[living_world.player].home
        fish_locker = fish_locker_place(towns, home)
        walk_publish("fish-locker", fish_locker_solids(fish_locker))
    fish_locker

# by the locker's open front
fish_at_locker = () -> bool:
    l = fish_locker_of()
    l.found and f64(length((fish_stall_customer(l) - me.pos).xz)) < 1.4

# Into the sea it goes, in an arc from the hand, with a splash where it lands.
fish_throw = ():
    if let c = fish_throw_back(fish):
        from = me.pos + _ahead() * 0.4 + _right() * 0.35 + vec3(0, 1.2, 0)
        to = me.pos + _ahead() * f32(5.0 + random(0.0, 1.5)) + _right() * f32(random(-0.6, 0.6))
        fish_throws.push(FishThrow(c, from, vec3(to.x, 0.0, to.z), t))
        say_toast("Back it goes: {FISH_KINDS[c.kind].name}.")

const FISH_FLIGHT = 0.75            # seconds in the air

fish_throw_step = ():
    i = 0
    loop i < fish_throws.len():
        f = fish_throws[i]
        if t - f.at >= FISH_FLIGHT:
            size = clamp(fish_length(f.c) * 1.4, 0.25, 0.8)
            fish_rings.push(Splash(f.to, t, f32(size)))
            emit(spray_ps, f.to, 4 + int(size * 6.0), 2.2 + size * 2.0, rgba(0.95, 0.98, 1.0, 0.75), 0.12 + size * 0.15, 0.4, 0.3, vec3(0, 1, 0))
            if audio_enabled and frames(audio.splash) > 0: play_at(audio.splash, f.to, 0.12 + size * 0.2, 60.0, pitch = 1.9 - size)
            fish_throws.remove_at(i)
            continue
        i += 1
    loop fish_rings.len() > 0 and t - fish_rings[0].born > 2.5: fish_rings.remove_at(0)

# The pilot's arms for what he holds (left, right; below -5: as he walks).
fish_arms = () -> vec2:
    if leisure.sitting != "" or me.mode != .walking: return vec2(-9, -9)
    vec2(if fish_bucket_carried(): f32(BUCKET_ARM) else: -9.0, if fish_in_hand(fish): f32(HELD_ARM) else: -9.0)

# the fish, the bucket and fish thrown back, in the scene
draw_catch_scene = (L: Light):
    fish_throw_step()
    fish_market_refresh()
    loop _, st in fish_stalls:
        if st.found and f64(length(st.at - scene_camera())) < 250.0: draw_fish_stall(fish_meshes, st.at, fish_stall_front(st), L, t)
    locker = fish_locker_of()
    if locker.found and f64(length(locker.at - scene_camera())) < 200.0: draw_fish_locker(fish_meshes, locker.at, fish_stall_front(locker), L, t)
    loop b in fish.buckets:
        if b.where != BUCKET_CARRIED and f64(length(b.at - scene_camera())) < 120.0: draw_bucket(fish_meshes, b.pail, b.at, b.yaw, L, t)
    if me.mode == .walking:
        stride = if leisure.sitting != "": 0.0 else: me.stride
        offset = world_residual(walker_point)
        if fish_in_hand(fish) and leisure.sitting == "":
            age = t - fish_landed_at
            draw_held_fish(fish_meshes, player_figure(), fish.hand[0], me.pos, me.yaw, me.phase, stride, L, t, fish_flap(age, fish.hand[0].grams), offset)
        if fish_bucket_carried():
            if leisure.sitting != "": draw_bucket(fish_meshes, fish_pail(fish), me.pos + _right() * 0.5, me.yaw, L, t)
            else: draw_carried_bucket(fish_meshes, player_figure(), fish_pail(fish), me.pos, me.yaw, me.phase, stride, L, t, offset)
    loop f in fish_throws:
        u = clamp((t - f.at) / FISH_FLIGHT, 0.0, 1.0)
        p = f.from + (f.to - f.from) * f32(u) + vec3(0, f32(sin(u * PI) * 1.6), 0)
        spin = u * 9.0
        at = render_model(translation(p) * rotation_y(me.yaw + PI * 0.5) * rotation_x(spin), render_origin(scene_camera()))
        draw_catch(fish_meshes, f.c, at, L, t, 0.6, t * 14.0)
    if fish_rings.len() > 0: draw_splash_rings(fish_rings, t)

# the town's fish stall (src/fish_stall.jo: an open spot on its quay or in its square, the same
# the world audit checks), placed and made solid the first time one is in that town
fish_stalls: {int: FishStall}
fish_market_place = -2
fish_stall_of = (place: int) -> FishStall:
    if place < 0 or place >= towns.len(): return FishStall()
    if not (place in fish_stalls):
        started = time()
        st = fish_stall_place(towns, place)
        fish_stalls[place] = st
        walk_publish("fish-stall:{place}", fish_stall_solids(st))
        if leisure_capture != "": print("FISH stall {towns[place].name} found {st.found} quay {st.on_quay} at {st.at} in {(time() - started) * 1000.0:.0f} ms")
    fish_stalls[place]
fish_market_refresh = ():
    global fish_market_place
    if not fish.seeded: fish_seed_buckets(fish, living_world, towns)
    if living_world.minute % 60 == 0: fish_note_late(living_world, fish)
    place = living_world.people[living_world.player].place
    if place == fish_market_place: return
    fish_market_place = place
    _ = fish_stall_of(place)
# at the counter of the town's stall: the place, or -1
fish_market_here = () -> int:
    fish_market_refresh()
    if fish_market_place < 0 or me.mode != .walking: return -1
    st = fish_stall_of(fish_market_place)
    if not st.found: return -1
    if f64(length((fish_stall_customer(st) - me.pos).xz)) < 2.2 or f64(length((st.at - me.pos).xz)) < 2.4: fish_market_place else: -1

# a chandler's (or a store's) counter within a few steps (its shop key, "" for none)
fish_chandler_here = () -> str:
    loop s in living.map_sellers(living_world, living_world.player):
        if (s.kind == "chandler" or s.kind == "general store") and f64(length(vec2(s.pos.x - me.pos.x, s.pos.z - me.pos.z))) < 7.0: return s.id
    ""

# (a lent bucket carried near the spot its owner keeps it)
fish_home_here = () -> bool:
    k = fish_carried(fish)
    if k < 0: return false
    b = fish.buckets[k]
    b.owner != living_world.player and f64(length((b.home - me.pos).xz)) < 2.0

# What can be done with the catch here, on foot (each on a card of its own: walk_offers).
fish_offers = (o: mut Offer[]):
    if me.mode != .walking or holding_cargo() >= 0: return
    market = fish_market_here()
    if fish_count(fish) > 0 and market >= 0:
        q = fish_quote(living_world, fish, market)
        offer_add(o, "fish-sell", if q > 0: "sell your catch at the market, {phoenix_text(q)}" else: "sell your catch at the market (it isn't buying)")
    w = living_world
    # B: what's to be done with a bucket here (one card at a time, the likeliest first)
    reach = fish_bucket_reach()
    if fish_in_hand(fish) and fish_bucket_room(fish, reach): offer_add(o, "fish-bucket", "into the bucket", .b)
    carried = fish_carried(fish)
    if carried >= 0:
        b = fish.buckets[carried]
        if b.owner == w.player and fish_at_locker(): offer_add(o, "fish-stow", "put your bucket in the locker", .b)
        if fish_home_here(): offer_add(o, "fish-return", "put {fish_bucket_whose(w, b)} bucket back {fish_bucket_where_words(w, b.owner).replace("my ", "the ")}", .b)
        if not fish_in_hand(fish): offer_add(o, "fish-down", "put the bucket down", .b)
    else:
        near = fish_bucket_near()
        if near >= 0:
            b = fish.buckets[near]
            offer_add(o, "fish-pick-bucket", if b.where == BUCKET_LOCKER: "take your bucket from the locker" else: "pick up {fish_bucket_whose(w, b)} bucket", .b)
    if fish_in_hand(fish) and fish_water_ahead(): offer_add(o, "fish-throw", "throw it back", .x)
    if fish_chandler_here() != "": offer_add(o, "fish-buy-bucket", "buy a bucket, {phoenix_text(BUCKET_CENTS)}")
    if fish_count(fish) > 0 and hotel.ok and (f64(length(me.pos - hotel.counter)) < 2.4 or f64(length(me.pos - hotel.seat)) < 2.4): offer_add(o, "fish-grill", "have the kitchen grill your catch, {phoenix_text(GRILL_CENTS)}")

fish_act = (act: str):
    w = living_world
    now = clock_text(w, w.minute)
    if act == "fish-sell":
        what = fish_words(fish_all(fish))
        got = fish_sell(living_world, fish)
        if got > 0:
            say_toast("The market takes {what} for {phoenix_text(got)}.")
            log_note(notebook, "Sold my catch at the market in {living.place_name(w, w.people[w.player].place)}: {what}, {phoenix_text(got)}.", now)
            # (what the pilot did today, for his small talk: src/pilot_talk.jo)
            pilot_did(living_world.pilot_day, Doing(.sold_catch, living_world.minute))
        else: say_toast("The market can't take it just now.")
    else if act == "fish-bucket":
        k = fish_bucket_reach()
        if fish_into_bucket(fish, k): say_toast("Into the bucket: {fish.buckets[k].pail.len()} of {BUCKET_FISH}.")
    else if act == "fish-throw": fish_throw()
    else if act == "fish-pick-bucket":
        k = fish_bucket_near()
        if k >= 0 and fish_pick_up(w, fish, k): say_toast(if fish.buckets[k].owner == w.player: "Your bucket." else: "{fish_bucket_whose(w, fish.buckets[k])} bucket, lent: bring it back.")
    else if act == "fish-down": _ = fish_put_down(fish, fish_ground(me.pos + _right() * 0.5 + _ahead() * 0.3), me.yaw)
    else if act == "fish-stow":
        l = fish_locker_of()
        _ = fish_put_down(fish, fish_locker_shelf(l), l.yaw, BUCKET_LOCKER)
        say_toast("Into the locker with it.")
    else if act == "fish-return":
        k = fish_carried(fish)
        owner = fish.buckets[k].owner
        said = fish_return_bucket(living_world, fish, k)
        if said != "":
            say_toast("{fish_bucket_whose(w, fish.buckets[k])} bucket, back where it's kept.")
            log_note(notebook, "Brought {w.people[owner].name}'s bucket back.", now)
    else if act == "fish-buy-bucket":
        shop = w.maps.shops[fish_chandler_here()]
        side = vec3(-towns[clamp(shop.place, 0, towns.len() - 1)].out.y, 0, towns[clamp(shop.place, 0, towns.len() - 1)].out.x)
        k = fish_buy_bucket(living_world, fish, shop.account, shop.place, fish_ground(shop.pos - side * 1.2), me.yaw)
        if k >= 0:
            say_toast("A new zinc bucket, {phoenix_text(BUCKET_CENTS)}: it's on the counter for you.")
            log_note(notebook, "Bought a bucket at {shop.name}, {phoenix_text(BUCKET_CENTS)}.", now)
        else: say_toast("Not enough money for a bucket.")
    else if act == "fish-grill":
        # (at the table, or standing at the bar, where it is brought)
        leisure_sit(if f64(length(me.pos - hotel.counter)) < 2.4: "bar" else: "hotel")
        grill_catch()

# (a crate wants both hands: the bucket goes down where he stands first)
fish_before_cargo = ():
    if fish_bucket_carried(): _ = fish_put_down(fish, fish_ground(me.pos + _right() * 0.6), me.yaw)

fishing_frame = ():
    global leisure_line, fish_landed_at
    w = living_world
    strike_key = vpressed(.f) or key_pressed(.space) or mkey(.enter)
    dt = clamp(frame_time(), 0.0, 0.05)
    holding = fish_in_hand(fish)
    reach = fish_bucket_reach()
    # the card along the bottom
    set_font(fonts.ui)
    actions: str[]
    if holding:
        if fish_bucket_room(fish, reach): actions.push("Into the bucket")
        actions.push("Throw it back")
    else:
        actions.push(if angling.stage == 0: "Cast" else: if angling.stage == 4: "Cast again" else: "Strike")
    actions.push("Done")
    status = if angling.stage == 1: "The float flies out." else: if angling.stage == 2: "Waiting. Watch the float." else: if angling.stage == 3: "It's under!" else: if angling.line != "" and angling.stage == 4: angling.line else: "{if leisure_line != "": leisure_line + " " else: ""}Cast when you're ready."
    if holding:
        c = fish.hand[0]
        # (the keys named as the player works them: a controller's buttons, the keyboard's
        # letters, and none on a touch screen, where the buttons below say it)
        kb = if pad.on: "" else if pad_hints(): key_button_name(.b, options.controls) + " " else: "B "
        kx = if pad.on: "" else if pad_hints(): key_button_name(.x, options.controls) + " " else: "X "
        back = if pad.on: "back into the sea" else: "{kx}back into the sea"
        status = if fish_bucket_room(fish, reach): (if pad.on: "{fish_hand_line(c)}. Into the bucket, or back into the sea." else: "{fish_hand_line(c)}. {kb}into the bucket, {back}.") else: if reach >= 0: "{fish_hand_line(c)}. The bucket's full: {back}, or carry it to the market." else: "{fish_hand_line(c)}. {_cap_first(back)}, or carry it to the market. (A bucket holds {BUCKET_FISH}: yours is in your locker, or borrow one.)"
    held = if reach >= 0: "In the bucket: {if fish.buckets[reach].pail.len() == 0: "nothing yet" else: fish_words(fish.buckets[reach].pail)}" else: if angling.caught.len() == 0: "Nothing caught yet." else: "Caught {fishing_tally(angling)}."
    r = sitting_bar(fonts, "Fishing at {living.place_name(w, angling.place)}", "{status}  {held}", actions)
    pick = if r.choice >= 0: actions[r.choice] else: ""
    if holding:
        # (no casting with a fish in the hand: into the bucket with it, or back into the sea)
        if pick == "Into the bucket" or (vpressed(.b) and fish_bucket_room(fish, reach)):
            _ = fish_into_bucket(fish, reach)
            angling.stage = 0; leisure_line = ""
        else if pick == "Throw it back" or vpressed(.x):
            fish_throw()
            angling.stage = 0; leisure_line = ""
    else:
        strike = (pick == "Strike" or (strike_key and angling.stage >= 1 and angling.stage <= 3))
        cast = pick == "Cast" or pick == "Cast again" or (strike_key and (angling.stage == 0 or angling.stage == 4))
        if cast:
            seed = lt.mix64(living_world.seed xor u64(living_world.minute * 31 + angling.casts))
            fishing_cast(angling, seed, lt.local_minute(w.minute))
            leisure_line = ""
        else if not fishing_frozen:
            if let c = fishing_step(angling, dt, strike):
                angling.caught.push(c)
                _ = fish_take(fish, c)
                fish_landed_at = t
    if pick == "Done" or vpressed(.escape): fishing_end()
    set_font()

# ---------------- the newspaper ----------------

# Today's paper: the town's news, with the notices posted on its board and the air club's meets.
paper_of = (place: int) -> Paper:
    w = living_world
    extra: PaperPiece[]
    loop n in job_notices(w, place):
        if n.taken_by != "": continue
        extra.push(PaperPiece("Notices", "Wanted: {n.title}", "{n.body} Pays {phoenix_text(n.pay)}, {n.due}. Apply to {n.poster}.", 0))
    loop n in air_meet_notices(air_events, w, w.harbors[clamp(place, 0, w.harbors.len() - 1)].center, (m: int) -> str: clock_text(w, m), limit = 3):
        extra.push(PaperPiece("The air", n.title, "{n.body} {if n.pay_text != "": n.pay_text else: if n.pay > 0: "Prize " + phoenix_text(n.pay) + "." else: ""} {n.due}".replace("  ", " "), 50))
    # (what the town tells of the pilot that a paper prints: src/reputation_talk.jo)
    loop r in rep_paper_pieces(w, place): extra.push(PaperPiece(if r.head.contains("race") or r.head.contains("wins"): "The air" else: "The islands", r.head, r.body, r.weight))
    newspaper(w, place, extra)

paper_open = ():
    global leisure_ui, leisure_line, paper_today, paper_view, leisure_spent, leisure_had
    o = leisure_buy_paper(living_world, coffee_place, leisure, PAPER_CENTS)
    if not o.ok:
        leisure_line = o.message
        return
    if o.cents > 0:
        leisure_spent += o.cents; leisure_had.push("the paper")
    paper_today = paper_of(coffee_place.place)
    paper_view = PaperView()
    leisure_ui = 9
    mouse_lock(false)

# what the band is doing, in a line for the table
band_words = () -> str:
    b = living_world.band
    bp = bar_band_position(b, living_world.tick)
    waiting = if b.queue.len() > 0: " Your request, {MUSIC_PIECES[BAR_SET[b.queue[0]].piece].title}, is next." else: ""
    if b.index < 0:
        local = lt.local_minute(living_world.minute)
        if local < BAR_START or local >= BAR_END: return "The band plays in the evening.{waiting}"
        return "The band is between numbers.{waiting}"
    sp = BAR_SET[b.index]
    if not bp.playing:
        absent = [loop q in band_needed(living_world, b.index): if not (q in b.called and b.up[index_of(b.called, q) ?? 0] >= 0): q]
        names = [loop q in absent: split(living_world.people[q].name, " ")[0]]
        return if names.len() > 0: "The band is waiting for {names_list(names)} to come up for {MUSIC_PIECES[sp.piece].title}.{waiting}" else: "The band is settling in for {MUSIC_PIECES[sp.piece].title}.{waiting}"
    who = if sp.lineup == 0: "The pianist is playing" else: if sp.lineup == 2: "The trio is playing" else: if sp.lineup == 4: "The piano and the violin are playing" else: if sp.lineup == 5: "A guitar and a mandolin are playing" else: if sp.lineup == 6: "A violin and a guitar are playing" else: "The band is playing"
    yours = if bp.request: "your request, " else: ""
    "{who} {yours}{MUSIC_PIECES[sp.piece].title}{if bar_singing(bp): ", and the singer sings" else: ""}.{waiting}"

# the numbers one may ask for, as the band would offer them
band_offer = () -> str[]:
    [loop sp in BAR_SET: "{split(MUSIC_PIECES[sp.piece].title, " (")[0]} ({if sp.lineup == 0: "the pianist alone" else: if sp.lineup == 4: "piano and violin" else: if sp.lineup == 5: "guitar and mandolin" else: if sp.lineup == 6: "violin and guitar" else: "the band"}{if sp.sung.len() > 0: ", sung" else: ""})"]

band_fetch_for = -1                 # (a number asked for whose players must be sent for)
boy_errand_t = -1.0                 # (when the house's boy last ran off for a musician)

# Where a player of the band is, in a few words, for the panel.
band_whereabouts = (q: int) -> str:
    w = living_world
    if w.people[q].place != 0: return "away"
    if not (q in w.daily_life): return "about the town"
    i = w.daily_life[q]
    if w.people[q].action.activity == .work: return "at work"
    match i.venue:
        .home, .seat, .laundry, .oven: if i.activity == .sleep: "asleep at home" else: "at home"
        .quay: "down at the harbour"
        .market: "at the market"
        .workshop: "at the workshop"
        .cafe: "at the café"
        .square: "in the square"
        .church: "at the church"
        .school: "at the school"
        .fields: "out in the fields"
        _: "about the town"

# The boy sent for a musician: out of the bar's door at the back of the counter, round the
# counter's end, across the terrace and down the side walk toward the town (a dozen seconds).
# (the hotel's frame, at the deck's height: the terrace, the side walk and the quay are flush)
BOY_ROUTE = [vec3(0, 1.2, 17.6), vec3(0, 1.2, 19.1), vec3(4.6, 1.2, 19.1), vec3(4.7, 1.2, 21.2), vec3(12.4, 1.2, 21.6), vec3(13.0, 1.2, 10.0), vec3(13.0, 1.2, 3.0)]
const BOY_SPEED = 2.6

draw_boy_errand = (L: Light):
    if boy_errand_t < 0.0 or not hotel.ok: return
    along = (t - boy_errand_t) * BOY_SPEED
    k = 0
    loop k < BOY_ROUTE.len() - 1:
        seg = f64(length(BOY_ROUTE[k + 1] - BOY_ROUTE[k]))
        if along <= seg: break
        along -= seg; k += 1
    if k >= BOY_ROUTE.len() - 1:
        global boy_errand_t
        boy_errand_t = -1.0; return
    a = transform_point(hotel.frame, BOY_ROUTE[k]); b = transform_point(hotel.frame, BOY_ROUTE[k + 1])
    u = along / max(0.001, f64(length(BOY_ROUTE[k + 1] - BOY_ROUTE[k])))
    p = lerp(a, b, f32(u))
    d = b - a
    draw_figure(boy_fig, p, atan2(f64(d.x), f64(d.z)), (t - boy_errand_t) * 11.0, 1.0, leisure_light(L, hotel, coffee.seat), t)


band_request_frame = ():
    global leisure_ui, leisure_line, band_fetch_for
    w = living_world
    if band_fetch_for >= 0:
        # (someone the number needs isn't here: the house's boy can go for them)
        missing = band_missing(w, band_fetch_for)
        if missing.len() == 0:
            band_fetch_for = -1; leisure_ui = 0; return
        # (those the boy can go for, and those he can't: at work, away, abed)
        can_go = [loop q in missing: if band_fetch_refusal(w, q) == "": q]
        said = band_missing_said(w, missing, (q: int) -> str: "is {band_whereabouts(q)}")
        if can_go.len() < missing.len() and can_go.len() > 0: said = said + " The number waits for the rest."
        names = [loop q in can_go: split(w.people[q].name, " ")[0]]
        who = names_list(names)
        title = split(MUSIC_PIECES[BAR_SET[band_fetch_for].piece].title, " (")[0]
        send = if can_go.len() > 0: "Send the boy for {who}: {phoenix_text(FETCH_TIP * can_go.len())}" else: "Nobody the boy can go for just now"
        r = fetch_panel(fonts, "Not everyone is here", "{title} waits for its players", said, send, can_go.len() > 0)
        if r.choice == 0:
            said2: str[]
            sent = false
            loop q in can_go:
                o = leisure_fetch(living_world, hotel_place, q)
                said2.push(o.message)
                if o.ok:
                    global leisure_spent
                    leisure_spent += o.cents; sent = true
            if sent:
                log_note(notebook, "Sent the Hotel Ancora's boy for {who} to play.", clock_text(w, w.minute))
                global boy_errand_t
                boy_errand_t = t
            leisure_line = join(said2, " ")
            band_fetch_for = -1; leisure_ui = 0
        else if r.choice == 1:
            band_fetch_for = -1; leisure_line = ""
        else if r.choice == 2 or r.closed:
            band_fetch_for = -1; leisure_ui = 0; leisure_line = ""
        return
    choices = band_offer()
    choices.push("Not now")
    r = choice_panel(fonts, "Ask the band for a number", "A phoenix in the hat; they play it next", leisure_line, choices)
    if r.choice >= 0 and r.choice < BAR_SET.len():
        title = MUSIC_PIECES[BAR_SET[r.choice].piece].title
        o = leisure_request(living_world, hotel_place, leisure, r.choice, title)
        if o.ok:
            rep_act(living_world, .tipped, hotel_place.keeper)
            global leisure_spent, leisure_had
            leisure_spent += o.cents
            leisure_had.push("{title} from the band")
            log_note(notebook, "Asked the band at the Hotel Ancora for {title}; a phoenix in the hat.", clock_text(w, w.minute))
            leisure_line = o.message
            if band_missing(w, r.choice).len() > 0: band_fetch_for = r.choice
            else: leisure_ui = 0; leisure_line = ""
        else: leisure_line = o.message
    else if r.choice >= 0 or r.closed:
        leisure_ui = 0; leisure_line = ""

# The band's notes followed on the stream (or the clock), its players' motions made for the number,
# and where each part's player stands.
band_step = (dt: f64):
    global band_notes, band_perf
    if band_forced.len() >= 2:
        bar_note_feed_forced(band_notes, int(band_forced[0]), band_forced_from + t - band_forced_t)
        if frame_number() % 60 == 0: print("BAND frame {frame_number()} seconds {band_forced_from + t - band_forced_t:.4f}")
    else: bar_note_feed(band_notes, bar_music, bar_band_position(living_world.band, living_world.tick))
    if band_log and frame_number() % 30 == 0:
        b = living_world.band
        print("BANDLOG frame {frame_number()} local {lt.local_minute(living_world.minute)} tick {living_world.tick} index {b.index} start {b.start} ends {b.ends} called {b.called} up {b.up} packing {b.packing} until {b.packing_until} queue {b.queue}")
    perform_follow(band_perf, band_notes.frame, dt)
    if band_notes.frame >= 0: perform_prepare(band_perf, band_notes.feed, bar_feed_key(band_notes.piece, band_notes.index))

# AEGEAN_BAND='piece lineup [from]': the band plays that catalogue piece in that line-up from that
# second, whatever the hour (captures; the music isn't heard)
band_forced = [loop w in split(env("AEGEAN_BAND") ?? "", " "): if w != "": to_float(w) ?? 0.0]
band_forced_from = if band_forced.len() >= 3: band_forced[2] else: 0.0
band_forced_t = 0.0
band_log = env("AEGEAN_BAND_LOG") != none   # (captures: the band's state in the log twice a second)

draw_leisure = (L: Light):
    draw_fishing()
    draw_tavli_table(L)
    draw_coffee_things(L)
    draw_catch_scene(L)
    local = lt.local_minute(living_world.minute)
    if band_forced.len() >= 2: draw_band(hotel, band, L, t, int(band_forced[1]), bar_piece_sung(int(band_forced[0]), band_perf.seconds), band_perf)
    else:
        # (the band's players as themselves: each one's own figure, from the town's people)
        figs = [band.singer, band.pianist, band.bassist, band.reeds]
        has = fill(false, 4)
        loop f in folks:
            r = band_role(f.person)
            if r >= 0: figs[r] = f.fig; has[r] = true
        # (one walking back from the pilot's table is the table's to draw until they are there)
        if company.stage != .none and band_role(company.person) >= 0: has[band_role(company.person)] = false
        draw_band_people(hotel, band, living_world.band, living_world.tick, figs, has, band_perf, L, t)
    draw_tip_jar(hotel, living_world.band, band_evening(living_world) or living_world.band.jar > 0, L, t)
    draw_service(L)
    draw_boy_errand(L)
    draw_table_things(L)
    draw_picnic(L)

# ---------------- service at the table ----------------

build_tray = () -> Mesh:
    vs: Vertex3D[]
    add_cylinder(vs, vec3(0, 0, 0), 0.2, 0.012, rgb(0.74, 0.72, 0.68), 14)
    add_cylinder(vs, vec3(0, 0.012, 0), 0.2, 0.012, rgb(0.66, 0.64, 0.6), 14, 0.205)
    custom_mesh(vs)

# a fork, held from its end (at 0) with the tines up and a bite on them
build_fork = () -> Mesh:
    vs: Vertex3D[]
    steel = rgb(0.78, 0.78, 0.76)
    add_box(vs, vec3(0, 0.06, 0), vec3(0.014, 0.13, 0.006), steel)
    loop k in 0..3: add_box(vs, vec3(f32(-0.009 + 0.009 * f64(k)), 0.15, 0), vec3(0.003, 0.05, 0.004), steel)
    add_sphere(vs, vec3(0, 0.165, 0.004), 0.016, rgb(0.82, 0.6, 0.32), 5, 3)
    custom_mesh(vs)

# the counter's top in front of one standing at the bar
bar_top = () -> vec3: hotel.stools[1] - hotel.table_z * 0.85 + vec3(0, 1.17, 0)

# Where whoever serves waits, stands to serve, and puts things down, at each place.
service_spots = (key: str) -> ServiceSpots:
    if key == "coffee": return ServiceSpots(transform_point(coffee.frame, vec3(0.2, 0, -3.0)), transform_point(coffee.frame, vec3(2.8, 0, -0.2)), coffee.table, coffee.table_x, coffee.table_z)
    if key == "bar": return ServiceSpots(hotel.bar_rest, hotel.bar_back, bar_top(), hotel.table_x, hotel.table_z)
    if key == "guest": return guest_spots
    ServiceSpots(hotel.waiter_pass, hotel.waiter_serve, hotel.table, hotel.table_x, hotel.table_z)

service_fig = (key: str) -> Figure: if key == "coffee": boy_fig else: if key == "bar": barkeep_fig else: waiter_fig

# The pilot's right arm with something in hand, bent at the elbow: (the arm's angle forward,
# how far it comes in across the body, the forearm's turn inward, the elbow's bend). A drink goes
# from the table to the chest (held) to the lips; a fork from the plate to the mouth.
struct ArmPose:
    angle = 0.0
    reach = 0.0
    twist = 0.0
    bend = 0.0

_ARM_TABLE = ArmPose(0.7, 0.38, 1.2, 0.1)
_ARM_CHEST = ArmPose(0.7, -0.02, 1.2, 1.4)
_ARM_LIPS = ArmPose(1.3, 0.28, 1.0, 1.8)
_ARM_MOUTH = ArmPose(1.0, 0.38, 0.9, 1.9)

_arm_mix = (a: ArmPose, b: ArmPose, u: f64) -> ArmPose:
    k = clamp(u, 0.0, 1.0)
    ArmPose(a.angle + (b.angle - a.angle) * k, a.reach + (b.reach - a.reach) * k, a.twist + (b.twist - a.twist) * k, a.bend + (b.bend - a.bend) * k)

# none: the arm as it would be
pilot_arm_pose = () -> ArmPose?:
    if taking.held < 0 or taking.held >= leisure.served.len(): return none
    if leisure.served[taking.held].item.food:
        if not taking.busy and taking.lift <= 0.01: return none
        return _arm_mix(_ARM_TABLE, _ARM_MOUTH, (taking.lift - 0.5) * 2.0)
    if taking.lift < 0.35: return _arm_mix(_ARM_TABLE, _ARM_CHEST, taking.lift / 0.35)
    _arm_mix(_ARM_CHEST, _ARM_LIPS, (taking.lift - 0.35) / 0.65)

# where the pilot's right hand is, in the world
pilot_hand = (pose: ArmPose) -> vec3:
    f = player_figure()
    local = figure_hand_local(f, pilot_posture(), pose.angle, 1.0, 0.0, pose.bend, pose.reach, pose.twist)
    transform_point(translation(me.pos) * rotation_y(me.yaw + PI) * scaling(f64(f.height)), local)

pilot_posture = () -> int: if leisure.sitting != "": 1 else: 0

# One frame of service and of taking one's time: the waiter's round, and what the keys and the
# buttons asked for at the table.
service_step = (dt: f64):
    global waiter, taking, served_look_until, table_put, table_input, left_table, left_key, clear_waiter, ui, leisure_ui
    # (a table the pilot left: some while after, whoever serves there comes and clears it all,
    # carrying it back on the tray; then it's done)
    if left_key != "" and left_key != leisure.sitting and not service_frozen:
        clear_waiter.clear_all = t - left_at >= left_wait
        waiter_step(clear_waiter, left_spots, left_table, dt, (x: f64, z: f64) -> f64: walk_height(towns, x, z))
        if left_table.len() == 0 and clear_waiter.stage == 0:
            left_key = ""; clear_waiter = Waiter()
    if leisure.sitting == "" or service_frozen: return
    loop s in leisure.coming: waiter_order(waiter, s)
    leisure.coming = []
    was = waiter.stage
    waiter_step(waiter, service_spots(leisure.sitting), leisure.served, dt, (x: f64, z: f64) -> f64: walk_height(towns, x, z))
    if waiter.stage == 2 and was != 2 and waiter.tray.len() > 0: served_look_until = t + SET_DOWN * f64(waiter.tray.len()) + 1.4
    # (things may have come and gone under the held one: find it again)
    taking.held = -1
    loop k in 0..leisure.served.len():
        if leisure.served[k].held: taking.held = k
    at_table = ui == .leisure and leisure_ui == 0
    pressed = if at_table: table_input.item else: -1
    down = (at_table and table_input.down) or held_capture
    take_step(taking, leisure.served, dt, pressed, down, table_put)
    table_input = TableBarResult(); table_put = false
    # ("Finished with this?": asked at the table, answered on the panel)
    if waiter.stage == 7 and ui == .leisure and leisure_ui == 0: leisure_ui = 19

draw_service = (L: Light):
    if not hotel.ok: return
    key = leisure.sitting
    clearing = left_key != "" and left_key != key and clear_waiter.ready
    near_hotel = f64(length(scene_camera() - hotel.counter)) < 80.0
    if near_hotel and leisure_open(living_world, hotel_place):
        # (the hotel's people at their places when they are not the ones serving, or clearing)
        terrace_clearing = clearing and (left_key == "hotel" or left_key == "guest")
        if key != "bar" and not (clearing and left_key == "bar"): draw_figure(barkeep_fig, hotel.bar_rest, hotel.bar_yaw + PI, 0.0, 0.0, L, t)
        if key != "hotel" and key != "guest" and not terrace_clearing:
            d = hotel.waiter_serve - hotel.waiter_pass
            draw_figure(waiter_fig, hotel.waiter_pass, atan2(f64(d.x), f64(d.z)), 0.0, 0.0, L, t)
    if clearing: _draw_server(clear_waiter, left_key, WALK_CLEAR_SERVER, L)
    if key != "" and waiter.ready: _draw_server(waiter, key, WALK_SERVER, L)

server_walk_subject = (wt:Waiter,id:int) -> WalkSubject:
    walking=wt.stage==1 or wt.stage==3 or wt.stage==4 or wt.stage==6
    WalkSubject(id,world_point(wt.pos),wt.yaw,if walking:1.35 else:0.0,phase=wt.phase)

# whoever serves at a place, walking, setting down or carrying away, with the tray and what is on it
_draw_server = (wt: Waiter, key: str, id:int, L: Light):
    fig = service_fig(key)
    subject=server_walk_subject(wt,id)
    shown=walk_presentation(subject)
    pos=world_vec(shown.point)
    yaw=shown.yaw+shown.shoulder
    busy = wt.tray.len() > 0 or wt.stage == 2 or wt.stage == 5
    draw_figure(fig,pos,shown.yaw,shown.phase,if shown.active or subject.speed>0.0:shown.pace else:0.0,L,t,carrying=busy,offset=world_residual(shown.point),shoulder=shown.shoulder)
    if not busy: return
    # (the tray, between his hands, and what is on it)
    at = translation(pos) * rotation_y(yaw + PI) * scaling(f64(fig.height))
    a = transform_point(at, figure_hand_local(fig, 0, 1.15, -1.0, -0.1))
    b = transform_point(at, figure_hand_local(fig, 0, 1.15, 1.0, -0.1))
    fwd = vec3(f32(sin(yaw)), 0, f32(cos(yaw)))
    top = (a + b) * 0.5 + fwd * 0.1
    draw(obj_sh, tray_mesh, obj_params(L, t, translation(top) * rotation_y(yaw)))
    right = vec3(f32(cos(yaw)), 0, f32(-sin(yaw)))
    loop k in 0..wt.tray.len():
        o = [vec2(-0.08, -0.06), vec2(0.09, -0.03), vec2(0.0, 0.1)][k % 3]
        p = top + vec3(0, 0.024, 0) + right * o.x + fwd * o.y
        draw_serving(serve_parts, wt.tray[k], translation(p) * rotation_y(yaw + f64(k)) * scaling(1.2), L, t)

# "Finished with this?", over whoever is asking
draw_waiter_ask = ():
    if leisure.sitting == "" or waiter.stage != 7: return
    head = waiter.pos + vec3(0, 1.75, 0)
    speech_bubble(fonts, head, if leisure.sitting == "coffee": "The boy" else: if leisure.sitting == "bar": "The barkeep" else: "The waiter", "Finished with this?", f64(length(head - scene_camera())))

draw_table_things = (L: Light):
    # (what was left on a table the pilot got up from, as it was left)
    if left_key != "" and left_key != leisure.sitting:
        loop s in left_table:
            draw_serving(serve_parts, s, translation(table_spot(left_spots, s.seat)) * rotation_y(f64(s.seat) * 1.3) * scaling(1.2), L, t)
    if leisure.served.len() == 0 or leisure.sitting == "": return
    sp = service_spots(leisure.sitting)
    loop s in leisure.served:
        if s.held and not s.item.food: continue
        draw_serving(serve_parts, s, translation(table_spot(sp, s.seat)) * rotation_y(f64(s.seat) * 1.3) * scaling(1.2), L, t)
    # (the drink in hand: at the lips while sipping, tipped toward the face; or the fork, with a
    # bite on it on its way up)
    if let pose = pilot_arm_pose():
        s = leisure.served[taking.held]
        hand = pilot_hand(pose)
        if s.item.food:
            draw(obj_sh, fork_mesh, obj_params(L, t, translation(hand) * rotation_y(me.yaw) * rotation_x(-0.5 - 0.6 * clamp((taking.lift - 0.5) * 2.0, 0.0, 1.0))))
            return
        tilt = clamp((taking.lift - 0.55) / 0.45, 0.0, 1.0) * (if s.amount < 0.3: 1.25 else: 0.9)
        draw_serving(serve_parts, s, translation(hand) * rotation_y(me.yaw) * rotation_x(-tilt) * scaling(1.2) * translation(vec3(0, -0.05, 0)), L, t)

_leisure_talk = (k: int):
    global ui, ui_folk, ui_turn, ui_line, ui_news
    ui = .talk
    ui_folk = k
    ui_turn = living.talk(living_world, folks[k].person, .greeting, living_world.player)
    ui_line = with_meet_remark(folks[k].person, ui_turn)
    ui_news = 0

_cap_first = (s: str) -> str: if s.len() > 0: s[0..1].upper() + s[1..s.len()] else: s

_leisure_order = (key: str, item: MenuItem):
    global leisure_spent, leisure_had, menu_view
    o = leisure_order(living_world, leisure_place(key), item, leisure)
    menu_view.remark = o.remark
    menu_view.line = o.message; menu_view.refused = not o.ok
    if o.ok:
        leisure_spent += o.cents
        leisure_had.push(if item.food: item.name.lower() else: item.name)
        # (a picnic basket isn't brought to the table: it's made up and handed over, to take along)
        if item.name == PICNIC_ITEM:
            global picnic
            if leisure.coming.len() > 0: leisure.coming.remove_at(leisure.coming.len() - 1)
            picnic.basket = true
            menu_view.line = "A basket made up for you, {phoenix_text(o.cents)}. Take it where you like."

_leisure_back = ():
    global ui, leisure_ui
    leisure_ui = 0
    if leisure.sitting == "": ui = .none

# the leisure panels (ui == .leisure)
leisure_panel = ():
    global ui, leisure_ui, leisure_at, leisure_line
    w = living_world
    match leisure_ui:
        0:
            key = leisure.sitting
            if key == "":
                ui = .none
                return
            lp = leisure_place(key)
            hotelish = key != "coffee"
            actions = ["See the menu", "Wait an hour"]
            letters = ["M", "W"]
            if hotelish and fish_count(fish) > 0:
                actions.push("Have your catch grilled"); letters.push("G")
            # (the board and the paper on the table, the band's stand and its jar, are tapped or
            # clicked themselves (seat_things); their keys, T, P, S and B, work as ever)
            if lp.room_cents > 0:
                actions.push("Take a room"); letters.push("R")
            # (whoever has sat down with the pilot, first; else whoever is near)
            k_talk = if company.stage == .sitting and company.who >= 0 and company.who < folks.len(): company.who else: nearest_folk(folks, me.pos, 7.0)
            if k_talk >= 0:
                actions.push("Talk to {split(w.people[folks[k_talk].person].name, " ")[0]}"); letters.push("K")
            actions.push("Get up"); letters.push("Esc")
            things = [loop s in leisure.served: take_label(s)]
            global table_input, table_put, table_bar_area
            r = table_bar(fonts, if key == "bar": "At the bar, {lp.name}" else: lp.name, if hotelish: band_words() else: "", things, taking.held, actions, letters, [loop s in leisure.served: s.amount])
            table_input = r
            table_bar_area = r.area
            global seat_hover, seat_press
            st = seat_things()
            seat_hover = if not pad.on and not contains(r.area, mouse_pos()): foot_pick(st, mouse_pos()) else: -1
            if mouse_pressed(.left): seat_press = mouse_pos()
            chose = -1
            if not pad.on and mouse_released(.left) and seat_hover >= 0 and f64(length(mouse_pos() - seat_press)) < 8.0: chose = seat_hover
            if pad.tapped and not contains(r.area, pad.tap_at): chose = foot_pick(st, pad.tap_at)
            if chose >= 0: run_then(st[chose].then)
            # (the keyboard's own keys: a touch screen's Pause button is a P too)
            else if key == "coffee" and key_pressed(.t): run_then("tavli")
            else if key == "coffee" and key_pressed(.p): run_then("paper")
            else if hotelish and leisure_open(w, hotel_place) and key_pressed(.s): run_then("song")
            else if hotelish and (band_evening(w) or w.band.index >= 0) and key_pressed(.b): run_then("tip")
            if vpressed(.escape):
                if taking.held >= 0: table_put = true
                else: r.action = actions.len() - 1
            pick = if r.action >= 0: actions[r.action] else: ""
            if pick == "See the menu": leisure_open_menu(key)
            else if pick == "Wait an hour": leisure_skip(60, "An hour passes at {lp.name}.")
            else if pick == "Play tavli": tavli_open_choice()
            else if pick == "Have your catch grilled": grill_catch()
            else if pick == "Read the paper" or pick == "Buy the paper": paper_open()
            else if pick == "Tip the band":
                leisure_ui = 20; leisure_line = ""
            else if pick == "Ask for a song":
                leisure_ui = 8; leisure_line = ""
            else if pick == "Take a room":
                leisure_ui = 2; leisure_at = key; leisure_line = ""
            else if pick.starts_with("Talk to"): _leisure_talk(k_talk)
            else if pick == "Get up": leisure_stand()
        1:
            lp = leisure_place(leisure_at)
            items = leisure_items(leisure_at)
            prices = [loop d in items: item_cents(w, lp.place, d, lp.keeper)]
            r = menu_panel(fonts, menu_view, lp.name, lp.what, leisure_keeper(leisure_at), items, prices, player_cents())
            if r.order >= 0: _leisure_order(leisure_at, items[r.order])
            if r.closed: _leisure_back()
        14:
            # (someone at the table, asking to join the pilot)
            if company.stage != .asking:
                leisure_ui = 0
                return
            name = living_world.people[company.person].name
            # (what they ask is in their speech bubble; the panel holds the answers)
            r = choice_panel(fonts, name, "at your table", "", ["Please, sit down", "I'd rather sit alone"])
            if r.choice == 0:
                rep_act(living_world, .kept_company, company.person)
                company_answer(company, true, t); leisure_ui = 0
            else if r.choice == 1 or r.closed:
                # (only a spoken "no" tells against him: closing the question unanswered doesn't)
                if r.choice == 1: rep_act(living_world, .declined_company, company.person)
                company_answer(company, false, t); leisure_ui = 0
        13:
            # (the bill of fare: a handful of things; the house's whole book for one who asks)
            lp = leisure_place(leisure_at)
            items = leisure_items(leisure_at)
            bill = leisure_bill(lp, items)
            secs: BillSection[]
            first = 0
            loop k in 0..bill.titles.len():
                secs.push(BillSection(bill.titles[k], first, bill.counts[k]))
                first += bill.counts[k]
            lines = [loop i in bill.items: items[i]]
            prices = [loop d in lines: item_cents(w, lp.place, d, lp.keeper)]
            said = if menu_view.remark != "": "{menu_view.line}  {leisure_keeper(leisure_at)}: {menu_view.remark}" else: menu_view.line
            r = bill_of_fare(fonts, lp.name, leisure_at == "coffee", secs, lines, prices, player_cents(), said, if leisure_at == "coffee": "and whatever else the house has" else: "Other wines and spirits on request")
            if r.order >= 0: _leisure_order(leisure_at, lines[r.order])
            if r.secret:
                leisure_open_book(leisure_at)
                menu_view.remark = if leisure_at == "coffee": "Anything else? Here, the list." else: "Ah. Then you'll want the book."
            else if r.closed:
                menu_view.line = ""; menu_view.remark = ""
                _leisure_back()
        2:
            lp = leisure_place(leisure_at)
            r = choice_panel(fonts, lp.name, "A room on the sea side, {phoenix_text(lp.room_cents)} a night", leisure_line, ["Take the room", "Not now"], spoken = true)
            if r.choice == 0:
                o = leisure_take_room(living_world, lp)
                if o.ok:
                    if leisure.sitting != "": leisure_stand()
                    log_note(notebook, "Took a room at the {lp.name}, {phoenix_text(o.cents)}.", clock_text(w, w.minute))
                    # (the night paid for: the room is his till eleven the next morning)
                    global hotel_room_until
                    hotel_room_until = thermal_life.thermal_until(w.minute, 11)
                    stay_begin_hotel()
                else: leisure_line = o.message
            else if r.choice == 1 or r.closed: _leisure_back()
        3:
            c = w.people[w.player].craft
            choices = [loop j in TINKER_JOBS: "{j.label} ({j.minutes} min)"]
            # (moored at the Neravessa workshop's slipway, its mechanics can do the work instead)
            at_workshop = CANAL_CITY_ID in w.far.districts and length(w.people[w.player].pose.pos - canal_workshop) <= DESK_REACH
            if at_workshop: choices.push("Ask the workshop to repair her")
            choices.push("That will do")
            r = choice_panel(fonts, "Your {CRAFT_NAMES[int(pc.kind)]}", "Moored at {living.place_name(w, w.people[w.player].place)}", leisure_line, choices)
            if at_workshop and r.choice == TINKER_JOBS.len(): open_workshop()
            else if r.choice >= 0 and r.choice < TINKER_JOBS.len():
                if w.aircraft[c].state != .moored:
                    leisure_line = "She has to be moored and still first."
                else:
                    leisure_line = ""
                    start_plane_job(TINKER_JOBS[r.choice].task)
            else if r.choice >= 0 or r.closed: ui = .none
        5:
            # (at work on the aircraft: what he is doing, on a card; Escape stops)
            if not job.active: leisure_ui = 3
            else:
                prompt_card(fonts, job.line, 150.0)
                if vpressed(.escape): stop_plane_job()
        4:
            if leisure_host < 0:
                ui = .none
                return
            name = w.people[leisure_host].name
            r = choice_panel(fonts, name, "At home in {living.place_name(w, w.people[leisure_host].home)}", leisure_line, ["Go in with them", "Another time"], spoken = true)
            if r.choice == 0:
                if not stay_begin_family(leisure_host):
                    # (no house of theirs in the scene: rest there all the same, the time passing on a card)
                    ui = .none
                    log_note(notebook, "Rested in the spare room at {name}'s.", clock_text(w, w.minute))
                    leisure_skip(rest_minutes(w, 420), "Asleep in the spare room at {split(name, " ")[0]}'s")
            else if r.choice == 1 or r.closed: ui = .none
        15: stay_frame()
        16:
            # (someone from the town, at the aircraft, asking to be taken up)
            global ride_asker
            if ride_asker < 0 or ride_asker >= folks.len() or ride.stage != .none:
                ui = .none; leisure_ui = 0
                return
            pp = w.people[folks[ride_asker].person]
            lift = ride_lift_to
            asks = if lift >= 0: ride_lift_ask_line(pp.traits.boldness < 450, THERMAL_SITES[lift].name, ride_lift_harbour(lift)) else: ride_ask_line(pp.traits.boldness < 450)
            r = choice_panel(fonts, pp.name, "at your {CRAFT_NAMES[int(pc.kind)]}", "“{asks}”", ["Climb in, then", "Another day"], spoken = true)
            if r.choice == 0:
                ui = .none; leisure_ui = 0
                ride_start(ride_asker)
                if lift >= 0:
                    global ride
                    ride.dest = INLAND_ACCESS[THERMAL_SITES[lift].place].landing; ride.dest_name = ride_lift_harbour(lift); ride.fare = RIDE_LIFT_CENTS
            else if r.choice == 1 or r.closed:
                ui = .none; leisure_ui = 0
            if r.choice >= 0 or r.closed: ride_asker = -1
        19:
            # (the waiter, asking whether the pilot has finished with something that has some left)
            about = waiter_asking_about(waiter, leisure.served)
            if about == none or leisure.sitting == "":
                leisure_ui = 0
                return
            who = if leisure.sitting == "coffee": "The boy" else: if leisure.sitting == "bar": "The barkeep" else: "The waiter"
            r = choice_panel(fonts, who, "the {about!.item.name.lower()}", "", ["Yes, thank you", "Not yet"])
            if r.choice == 0: waiter_answer(waiter, leisure.served, true)
            else if r.choice == 1 or r.closed: waiter_answer(waiter, leisure.served, false)
            if r.choice >= 0 or r.closed: leisure_ui = 0
        18:
            # (stepping ashore with someone in the second seat, before they have flown)
            global ride_asking_wait
            if ride.stage != .seated or ride.person < 0:
                ui = .none; leisure_ui = 0; ride_asking_wait = false
                return
            pp = w.people[ride.person]
            r = choice_panel(fonts, pp.name, "in the second seat", "", ["Back in a few minutes", "Sorry, another day"])
            if r.choice == 1:
                _ = ride_put_off(ride, t)
                ride_declined[ride.person] = w.minute
            else if r.choice == 0 or r.closed:
                ride_wait_begin(ride, w.minute)
                ride.line_until = t + 5.0
            if r.choice >= 0 or r.closed:
                ui = .none; leisure_ui = 0; ride_asking_wait = false
        6: tavli_choice_frame()
        7: tavli_frame()
        8: band_request_frame()
        20: tip_frame()
        21:
            # (the keeper at the bathhouse door: the waters, a few lepta)
            k = bath_site_here()
            if k < 0: ui = .none; leisure_ui = 0; return
            site = THERMAL_SITES[k]
            day = lt.day_index(w.minute)
            paid = bath_paid_today(bath, day, k)
            said = if leisure_line != "": leisure_line else: bath_keeper_ask(paid)
            r = choice_panel(fonts, bath_keeper_name(site), site.name, said, if paid: ["Go and change", "Not now"] else: ["Pay {phoenix_text(BATH_CENTS)}", "Not now"], spoken = true)
            if bath_auto_pay and leisure_line == "": r.choice = 0
            if r.choice == 0:
                global bath
                ok = paid
                if not paid:
                    keeper = bath_keeper_person(site)
                    owner = if keeper >= 0: w.people[keeper].account else: w.far.districts[site.place].market_account
                    ok = bath_pay(living_world, owner, site.place)
                    if ok: bath.paid_day = day; bath.site = k; say_toast(bath_keeper_thanks())
                if ok:
                    ui = .none; leisure_ui = 0
                    bath.then_in = true
                    bath_walk_to(bath_cabin_door(site), "bath-change")
                else: leisure_line = "Thirty lepta, friend. Come back when you have it."
            else if r.choice == 1 or r.closed: ui = .none; leisure_ui = 0
        10: fishing_frame()
        12:
            barber_step()
            barber_frame()
        9:
            if paper_panel(fonts, paper_today, paper_view):
                leisure_ui = 0; leisure_line = ""
        _: ui = .none

listen_mode = ""                # (captures: the camera turning by the band, or walking away)
listen_path: vec3[]
listen_angle = 0.0
listen_run = false              # (captures: the walk away at a run)
listen_step = (dt: f64):
    global follow, me, listen_path
    if listen_mode == "listen-turn":
        # (a head turning on the spot, 4.6 m in front of the band, a full circle every 16 s)
        global judge_camera, listen_angle
        listen_angle += dt * TAU / 16.0
        eye = hotel.stage + hotel.stage_out * 4.6 + vec3(0, 1.45, 0)
        toward = -hotel.stage_out
        side = vec3(-toward.z, 0, toward.x)
        look = toward * f32(cos(listen_angle)) + side * f32(sin(listen_angle))
        judge_camera = JudgeView(eye, eye + look * 10.0, "turning by the band")
    if listen_mode == "listen-walk" and listen_path.len() > 0:
        d = listen_path[0].xz - me.pos.xz
        if f64(length(d)) < 0.3: listen_path.remove_at(0); return
        dir = normalize(d)
        speed = if listen_run: 4.2 else: 1.5
        step_player_walk(dir * f32(speed * dt))
        me.yaw = approach_angle(me.yaw, atan2(f64(dir.x), f64(dir.y)), 6.0, dt)
        me.stride = approach(me.stride, if listen_run: 1.0 else: 0.7, 8.0, dt); me.phase += dt * speed * 5.0
        follow.yaw = approach_angle(follow.yaw, me.yaw + PI, 3.0, dt)

# AEGEAN_LEISURE=sit|order|menu|search|rest|coffee|tinker|spare|terrace|bar|listen-walk|listen-run|tavli-choose|tavli|tavli-mid|request|requested|paper|fishing|fishing-bite|stars|stars-hill|tavli-plakoto|barber|barber-walrus|barber-clean|swim-dock|swim-night|swim-beach|swim-wade|bill|bill-coffee|deliver|drink|held|eat|bar-drink|empties|notes|notes-near: stage a leisure panel at
# the start, for captures (with AEGEAN_CAPTURE_MINUTES for the hour)
leisure_capture = env("AEGEAN_LEISURE") ?? ""
if leisure_capture != "": print("HOTEL at {hotel.origin} seat {hotel.seat} stage {hotel.stage} desk {hotel.desk} coffee {coffee.seat}")
leisure_capture_step = ():
    global leisure_capture, listen_run, hour, ui, leisure_ui, leisure_host, leisure_line, me, follow, fish, walker_point, walker_published
    if frame_number() < 3: return
    stage = leisure_capture
    leisure_capture = ""
    loop id in [2, 6, 8, 9, 11, 21]:
        pp = living_world.people[id]
        if let intent = living.daily_intent(living_world, id): print("LEISURE {pp.name} place {pp.place} trip {pp.trip} venue {intent.venue} anchor {intent.anchor} arrived {intent.arrived} at {pp.pose.pos} target {intent.target} act {intent.activity}")
    hour = f64(lt.local_minute(living_world.minute)) / 60.0
    pick = (name: str) -> MenuItem:
        loop d in hotel_menu:
            if d.name == name: return d
        hotel_menu[0]
    if stage == "sit" or stage == "order" or stage == "menu" or stage == "search" or stage == "rest" or stage == "bill": leisure_sit("hotel")
    if stage == "order":
        loop name in ["Meze plate", "Ouzo, the house's", "Aviation", "Bread and olives", "Fix"]: _leisure_order("hotel", pick(name))
    if stage == "menu": leisure_open_book("hotel")
    if stage == "bill": leisure_open_menu("hotel")
    if stage == "picnic":
        # (the basket along, on foot a few steps up from a quiet bit of shore near the town)
        global picnic, picnic_capture_spot
        picnic.basket = true
        c = towns[0].center
        found = false
        loop ring in 6..80:
            if found: break
            loop k in 0..48:
                a = f64(k) * TAU / 48.0
                q = c + vec3(f32(cos(a) * f64(ring) * 8.0), 0, f32(sin(a) * f64(ring) * 8.0))
                g = vec3(q.x, f32(walk_height(towns, f64(q.x), f64(q.z))), q.z)
                okang = picnic_spot_at(g)
                if okang.0:
                    picnic_capture_spot = g
                    back = vec3(f32(-sin(okang.1)), 0, f32(-cos(okang.1)))
                    st = g + back * 6.0
                    me.mode = .walking
                    me.pos = vec3(st.x, f32(walk_height(towns, f64(st.x), f64(st.z))), st.z)
                    me.yaw = okang.1; follow.yaw = me.yaw + PI + 0.6; follow.distance = 6.0; follow.pitch = 0.3
                    walker_point = world_point(me.pos)
                    print("PICNIC spot {g} sea {okang.1:.2}")
                    found = true; break
    if stage == "foot-craft":
        # (on foot on the dock, a few steps from one's own aircraft at her mooring, facing her)
        if me.mode == .aboard: step_ashore(pc.state.position + quat_rotate(pc.state.orientation, craft_models[pc.model].exit))
        me.mode = .walking
        to = pc.state.position - me.pos
        me.yaw = atan2(f64(to.x), f64(to.z)); follow.yaw = me.yaw + PI + 0.4; follow.distance = 6.0; follow.pitch = 0.3
    if stage == "foot-hotel":
        # (on foot on the terrace, a few steps from the pilot's table, for AEGEAN_FOOT_GO)
        at = hotel.seat - hotel.table_z * 5.0 + hotel.table_x * 2.0
        me.mode = .walking
        me.pos = vec3(at.x, f32(walk_height(towns, f64(at.x), f64(at.z))), at.z)
        to = hotel.seat - me.pos
        me.yaw = atan2(f64(to.x), f64(to.z)); follow.yaw = me.yaw + PI; follow.distance = 5.5; follow.pitch = 0.3
        walker_point = world_point(me.pos)
    if stage == "bill-coffee":
        leisure_sit("coffee")
        leisure_open_menu("coffee")
    if stage.starts_with("ride-"):
        # (a pleasure flight: someone asking at the aircraft; seated on the water at the dock; in
        # the air (with AEGEAN_FLYING or AEGEAN_CAPTURE_TAKEOFF); their house below; landed back)
        nearest = -1; nd = 1e9
        loop k in 0..folks.len():
            f = folks[k]
            if not f.shown or f.performing or living_world.people[f.person].age < 16: continue
            d = f64(length(f.pos - pc.state.position))
            if d < nd: nearest = k; nd = d
        print("RIDE with {if nearest >= 0: living_world.people[folks[nearest].person].name else: ""} {nd:.0} m")
        if nearest >= 0:
            if stage == "ride-lift-land":
                # (a lift flown to the springs' harbour: moored at its dock with them in the seat,
                # the pilot stepping ashore; they pay and thank him)
                k = 0
                landing = INLAND_ACCESS[THERMAL_SITES[k].place].landing
                docks = harbour_docks(landing)
                print("RIDE lift-land {ride_lift_harbour(k)} docks {docks.len()} cash {player_cents()}")
                if docks.len() > 0:
                    ride_start(nearest)
                    global ride
                    ride.dest = landing; ride.dest_name = ride_lift_harbour(k); ride.fare = RIDE_LIFT_CENTS
                    ride.stage = .landed; ride.flew = true
                    d = docks[0]
                    pc.state.position = vec3(d.x, d.y, d.z)
                    moor_at_dock(pc, d)
                    pc.throttle = 0.0
                    tie_up()
                    step_ashore(d)
                    me.mode = .walking
                    walker_point = world_point(me.pos)
            else if stage == "ride-offer":
                # (offered from the dock, the one who answers behind the camera: the caption says
                # it, and a marker at the screen's edge points round to them)
                if me.mode == .aboard: step_ashore(pc.state.position + quat_rotate(pc.state.orientation, craft_models[pc.model].exit))
                me.mode = .walking
                ride_start(nearest)
                # (a few steps off along the dock behind him, walking over)
                global ride
                back = vec3(f32(-sin(me.yaw)), 0, f32(-cos(me.yaw)))
                ride.pos = me.pos + back * 7.0
                follow.yaw = me.yaw + PI; follow.distance = 4.5; follow.pitch = 0.2
            else if stage == "ride-ask":
                if me.mode == .aboard: step_ashore(pc.state.position + quat_rotate(pc.state.orientation, craft_models[pc.model].exit))
                me.mode = .walking
                global ride_asker, ride_rolled
                ride_asker = nearest; ride_rolled = true; ui = .leisure; leisure_ui = 16
                global ride_lift_to
                if env("AEGEAN_RIDE_LIFT") != none:
                    ride_lift_to = ride_lift_choice()
                    here = living_world.people[living_world.player].place
                    loop q in 0..THERMAL_SITES.len():
                        ld = INLAND_ACCESS[THERMAL_SITES[q].place].landing
                        print("RIDE springs {THERMAL_SITES[q].name} landing {ld} here {here} km {if ld in settlement_registry.settlement_by_id and here in settlement_registry.settlement_by_id: length(settlement_registry.world_settlements[settlement_registry.settlement_by_id[ld]].center.xz - settlement_registry.world_settlements[settlement_registry.settlement_by_id[here]].center.xz) / 1000.0 else: -1.0}")
                    print("RIDE lift to {ride_lift_to} {if ride_lift_to >= 0: THERMAL_SITES[ride_lift_to].name + " by " + ride_lift_harbour(ride_lift_to) else: ""}")
                # (facing the aircraft, the camera behind and above: the pilot, the asker and the Gull)
                to = pc.state.position - me.pos
                me.yaw = atan2(f64(to.x), f64(to.z))
                follow.yaw = me.yaw + PI + 0.5; follow.distance = 7.0; follow.pitch = 0.35
            else:
                ride_start(nearest)
                global ride
                ride.stage = .seated; ride.next_line = t + 0.5
                if stage == "ride-air" or stage == "ride-house":
                    ride.stage = .flying; ride.flew = true; ride.said = ["aboard", "throttle", "run", "up"]
                if stage == "ride-house":
                    # (flying in toward their house from 1.4 km off: the line comes of itself
                    # once it is near and ahead)
                    ride.said = ["aboard", "throttle", "run", "up"]
                    if ride.has_home:
                        hf = normalize(vec3(ride.home.x - pc.state.position.x, 0, ride.home.z - pc.state.position.z) + vec3(0.0001, 0, 0))
                        h = atan2(f64(hf.x), -f64(hf.z))
                        start = ride.home - hf * 1400.0
                        # (at AEGEAN_FLYING's own height and speed, turned toward the house)
                        spd = f64(length(pc.state.velocity))
                        alt = max(f64(pc.state.position.y), 160.0)
                        pc.state.position = vec3(start.x, f32(alt), start.z)
                        pc.state.velocity = heading_vector(h) * f32(spd)
                        pc.state.orientation = quat_euler(0, -h, 0)
                        pc.aim_heading = h; pc.placed = false
                    print("RIDE house {ride.has_home} at {ride.home}")
                if stage == "ride-air" or stage == "ride-house":
                    # (boarded in the air for the capture: no boarding notice up there)
                    global toast_until
                    toast_until = 0.0
                if stage == "ride-thanks":
                    ride.flew = true; ride.top = 620.0
                    _ = ride_thank(ride, t); ride.line_until = 1e9
                if stage != "ride-thanks": me.mode = .aboard
    if stage == "lead-bar" or stage == "lead-ride":
        # (leads, staged: src/leads.jo. Someone in Porto Vecchio wants a lift to Kalamos, posted as a
        # passenger job. lead-bar: at the bar, whoever sits by him mentions what's going on
        # (AEGEAN_COMPANY, AEGEAN_COMPANY_GAP, AEGEAN_LEADS=always). lead-ride: he has walked up
        # to the one who wants the lift, and talks to them: they offer it)
        rider = -1
        loop k in 0..folks.len():
            q = folks[k].person
            pp = living_world.people[q]
            if rider < 0 and folks[k].shown and pp.place == 0 and pp.trip < 0 and pp.age >= 18 and q != living_world.player and band_wanted(living_world, q) == 0 and pp.occupation != .innkeeper and pp.occupation != .hotelier: rider = k
        job = if rider >= 0: lead_jobs.post_job(living_world, folks[rider].person, 1, .none, -1, 1, 1800, living_world.minute + 600, passenger = folks[rider].person) else: -1
        print("LEAD staged: {if rider >= 0: living_world.people[folks[rider].person].name else: "nobody"} job {job}")
        if stage == "lead-bar":
            leisure_sit("bar")
            if env("AEGEAN_COMPANY") == none: company.due = t
        else if rider >= 0:
            fp = folks[rider].pos
            away = normalize(vec3(fp.x - hotel.counter.x, 0, fp.z - hotel.counter.z) + vec3(0.0001, 0, 0))
            me.mode = .walking
            me.pos = vec3(fp.x - away.x * 1.6, f32(walk_height(towns, f64(fp.x - away.x * 1.6), f64(fp.z - away.z * 1.6))), fp.z - away.z * 1.6)
            me.yaw = atan2(f64(away.x), f64(away.z)); me.stride = 0.0
            follow.yaw = me.yaw + PI + 0.7; follow.distance = 3.6; follow.pitch = 0.2; follow.height = 1.5
            global rep_ask_k, rep_talk_due
            rep_ask_k = rider; rep_talk_due = t + 1.5
    if stage == "rep-remark" or stage == "rep-remark-strait" or stage == "rep-decline" or stage == "rep-join":
        # (the pilot's name, staged: src/reputation.jo. rep-remark: a Kalyran pulled out of a
        # storm sea off Neravessa, talked of in Porto Vecchio for days; at the bar, someone who has
        # heard takes the next stool and says so (AEGEAN_COMPANY=<seconds> brings them).
        # rep-remark-strait: the same, for an Orenthian taken out of the strait's squall off
        # Lyravanoria (the rescue capture's story, AEGEAN_CAPTURE_STRAIT_AFTER=rescue).
        # rep-decline: known in Porto Vecchio for turning people away; at the bar, the nearest
        # asked over says no, and why)
        here = rep_town_of_place(living_world, hotel_place.place)
        if stage == "rep-remark" or stage == "rep-remark-strait":
            strait = stage == "rep-remark-strait"
            off = rep_town_named(living_world, if strait: "Lyravanoria" else: "Neravessa")
            kalyra = -1
            loop c in 0..living_world.countries.len():
                if living_world.countries[c].key == (if strait: "orenthia" else: "kalyra"): kalyra = c
            # (the strait's rescue out at sea when its harbours are not about in this world)
            d = rep_record(living_world, .rescued_foe, -1, if off >= 0: off else: (if strait: -1 else: here), -1, kalyra, 1, [], 880)
            rep_stage_heard(living_world, here, d, 2, 1000)
            # (AEGEAN_SMALL_TALK: the day behind him too, for his answers: a bumpy flight over from
            # Kalamos and a load brought in; src/pilot_talk.jo)
            if env("AEGEAN_SMALL_TALK") != none:
                pilot_did(living_world.pilot_day, Doing(.flew, living_world.minute - 150, where = "Kalamos", rough = 2))
                _ = rep_record(living_world, .job_done, here, here, 3, -1, 1, [], 0)
            leisure_sit("bar")
            if env("AEGEAN_COMPANY") == none: company.due = t
            print("REP remark staged: deed {d} off {rep_town_name(living_world, if off >= 0: off else: here)}")
        else:
            # (rep-decline: known for turning people away; he walks up to someone sat at a terrace
            # table and asks to sit. rep-join: the same, liked, and they say yes)
            if stage == "rep-decline":
                # (a week of evenings: those at the terrace tables he turned away once or twice)
                loop k in 0..folks.len():
                    if _terrace_table(k) != none:
                        rep_act(living_world, .declined_company, folks[k].person, here)
                        rep_act(living_world, .declined_company, folks[k].person, here)
                loop k in 0..12: rep_act(living_world, .declined_company, -1, here)
                rep_stage_talked(living_world, here)
            else:
                loop k in 0..12: rep_act(living_world, .kept_company, -1, here)
                rep_stage_talked(living_world, here)
            target = -1; bd = 1e9
            loop k in 0..folks.len():
                if not can_ask_to_sit(k): continue
                d = f64(length(folks[k].pos - hotel.seat))
                if d < bd: bd = d; target = k
            if let tb = _terrace_table(target):
                # (standing at their table, by the empty chair, facing them)
                fp = folks[target].pos
                to = normalize(vec3(fp.x - tb.1.x, 0, fp.z - tb.1.z))
                me.mode = .walking
                me.pos = vec3(tb.1.x - to.x * 0.5, f32(walk_height(towns, f64(tb.1.x), f64(tb.1.z))), tb.1.z - to.z * 0.5)
                me.yaw = atan2(f64(to.x), f64(to.z)); me.stride = 0.0
                follow.yaw = me.yaw + PI + (to_float(env("AEGEAN_REP_CAM") ?? "0.7") ?? 0.7); follow.distance = 3.4; follow.pitch = 0.2; follow.height = 1.5
                global rep_ask_due, rep_ask_k, rep_talk_due
                rep_ask_k = target; rep_talk_due = t + 1.5; rep_ask_due = t + (to_float(env("AEGEAN_INVITE_AT") ?? "4.5") ?? 4.5)
                print("REP {stage} staged: {living_world.people[folks[target].person].name}: {ui_line}")
            else: print("REP {stage}: nobody sat at a terrace table")
    if stage.starts_with("stay-"):
        # (a stay: the hotel's room (evening, the window in the morning, asleep), or a family's
        # house (supper, in bed, the morning's coffee): the town's host with the largest household)
        if stage.starts_with("stay-hotel"):
            o = leisure_take_room(living_world, hotel_place)
            print("STAY room {o.ok} {o.message}")
            global hotel_room_until
            if o.ok: hotel_room_until = thermal_life.thermal_until(living_world.minute, 11)
            stay_begin_hotel()
            if stage == "stay-hotel-window":
                global room_me
                stay.stage = .window
                w0 = room_index(.window)
                room_me = RoomPilot(at = room_objs[w0].stand, yaw = room_objs[w0].face)
        else:
            best = -1; most = -1
            loop k in 1..living_world.people.len():
                pp = living_world.people[k]
                if pp.home != 0 or pp.place != 0 or k == living_world.player: continue
                n = [loop r in living_world.households: if r.guardian == k: 1].len()
                if n > most and choose_life_venue(living_world, pp.home, .home, k) != none: best = k; most = n
            print("STAY host {best} {if best >= 0: living_world.people[best].name else: ""} household {most}")
            if best >= 0: _ = stay_begin_family(best)
            if stage == "stay-family-morning": stay.stage = .morning
            if stage == "stay-family-supper": stay.stage = .supper; stay.had_supper = true
        if stage.ends_with("-asleep"):
            stay_sleep(rest_minutes(living_world, 420), "Asleep")
            global room_me
            room_me = room_pilot_in(room_objs, room_index(.bed))
        global room_eye, room_aim
        room_eye = stay_eye_local(); room_aim = stay_look_local()
        global stay
        stay.next_line = t + 0.5
    if stage.starts_with("table-"):
        # (the table's things: left on getting up (table-leave, table-back: and come back to),
        # cleared after (table-clear), an empty taken while seated (table-empty), the waiter asking
        # about one with some left (table-ask))
        leisure_sit("hotel")
        loop name in ["Meze plate", "Ouzo, the house's", "House white"]:
            d = pick(name)
            leisure.served.push(Served(d, living_world.minute, leisure.served.len() * 2, amount = if name == "Ouzo, the house's" and stage == "table-empty": 0.0 else: if d.food: 0.45 else: 0.6, empty_for = 60.0, still = if stage == "table-ask" and name == "House white": 200.0 else: 0.0))
        global table_script
        table_script = if stage == "table-leave" or stage == "table-clear": "stand:60" else: if stage == "table-back": "stand:60 sit:200" else: "trace:0"
        follow.yaw = me.yaw + PI + 1.4; follow.distance = 4.5; follow.pitch = 0.45
    if stage.starts_with("seat") or stage.starts_with("company"):
        # (seated, the view about the seat; things on the table half gone, a glass at the lips;
        # company: someone come over, asking (at a table), sitting with the pilot, or on the next stool)
        key = if stage == "seat-bar" or stage == "company-bar": "bar" else: "hotel"
        leisure_sit(key)
        loop name in ["Meze plate", "Ouzo, the house's", "House white"]:
            d = pick(name)
            leisure.served.push(Served(d, living_world.minute, leisure.served.len() * 2, amount = if d.food: 0.35 else: if name == "House white": 0.6 else: 1.0))
        global held_capture, company_line, company_line_until
        held_capture = stage != "company-ask" and stage != "company-sit"
        leisure.served[2].held = true
        loop k in 0..20: service_step(0.05)
        if stage == "seat-orbit":
            follow.yaw += 2.3; follow.distance = 4.6; follow.pitch = 0.5
        if stage.starts_with("company"):
            company.due = t
            company_come()
            print("COMPANY {company.stage} who {company.person} {if company.person >= 0: living_world.people[company.person].name else: ""}")
            loop k in 0..1200:
                if company.stage == .asking or company.stage == .sitting: break
                company_tick(0.05)
            if stage == "company-sit": company_answer(company, true, t)
            if company.stage == .sitting and company.talks:
                company_line = table_remark(living_world, company.person, 0); company_line_until = 1e9
            if stage == "company-ask": leisure_ui = 14
            # (the camera to the side, both in view)
            follow.yaw = me.yaw + PI + (if stage == "company-bar": -1.0 else: 1.1); follow.distance = 3.6; follow.pitch = 0.32
            print("COMPANY now {company.stage} talks {company.talks} line {company_line}")
    if stage == "deliver" or stage == "drink" or stage == "bar-drink" or stage == "empties" or stage == "eat" or stage == "held":
        key = if stage == "bar-drink": "bar" else: "hotel"
        leisure_sit(key)
        loop name in ["Meze plate", "Ouzo, the house's", "House white"]:
            d = pick(name)
            leisure.served.push(Served(d, living_world.minute, leisure.served.len() * 2, amount = if stage == "empties": 0.0 else: if d.food: 0.55 else: 0.7))
        if stage == "deliver":
            leisure.served = []
            loop name in ["Meze plate", "Ouzo, the house's", "Fix"]: _leisure_order(key, pick(name))
            service_step(0.0)
            sp = service_spots(key)
            # (on his way out from the bar with the tray, most of the way to the table)
            loop k in 0..200:
                if waiter.stage == 1 and f64(length(waiter.pos - sp.serve)) < 2.6: break
                service_step(0.05)
            global service_frozen
            service_frozen = env("AEGEAN_SERVICE_RUN") == none
        else if stage == "empties":
            loop k in 0..leisure.served.len(): leisure.served[k].empty_for = 60.0
            service_step(0.0)
            loop k in 0..400:
                if waiter.stage == 5: break
                service_step(0.05)
        else:
            global held_capture, served_look_until
            held_capture = stage != "held"
            served_look_until = 1e9
            leisure.served[if stage == "eat": 0 else: 2].held = true
            loop k in 0..30: service_step(0.05)
    if stage == "search":
        leisure_open_book("hotel")
        menu_view.fresh = false
        menu_view.query = env("AEGEAN_LEISURE_QUERY") ?? "islay"
    if stage == "rest":
        leisure_ui = 2
    if stage == "sit-coffee": leisure_sit("coffee")
    if stage == "coffee":
        leisure_sit("coffee")
        _leisure_order("coffee", coffee_menu[coffee_menu.len() - 30])
        leisure_open_menu("coffee")
    if stage == "request" or stage == "requested":
        leisure_sit("hotel")
        leisure_ui = 8; leisure_line = ""
        if stage == "requested":
            o = leisure_request(living_world, hotel_place, leisure, 2, "Clair de lune")
            print("REQUEST {o.message}")
            leisure_ui = 0
    if stage == "fetch" or stage == "fetch-sent":
        # (the afternoon: Ave Maria asked for while its players are about the town; the panel
        # offering the boy, or the boy already running off and the camera on the terrace)
        leisure_sit("hotel")
        global band_fetch_for, judge_camera
        o = leisure_request(living_world, hotel_place, leisure, 1, "Ave Maria")
        print("REQUEST {o.message} missing {band_missing(living_world, 1)}")
        band_fetch_for = 1; leisure_ui = 8; leisure_line = o.message
        if stage == "fetch-sent":
            loop q in band_missing(living_world, 1):
                f = leisure_fetch(living_world, hotel_place, q)
                print("FETCH {f.message}")
            global boy_errand_t
            boy_errand_t = t; band_fetch_for = -1; leisure_ui = 0; leisure_line = ""
            ui = .none
            judge_camera = JudgeView(transform_point(hotel.frame, vec3(9.5, 3.6, 27.5)), transform_point(hotel.frame, vec3(5.0, 1.4, 19.5)), "Hotel Ancora, the boy runs off")
    if stage == "notes" or stage == "notes-near":
        # (on the waterfront west of the hotel, the bandstand in view past the building's end:
        # about 35 m off, or 24 from the walk along its front)
        local = if stage == "notes": vec3(-30, 0, -2) else: vec3(-14, 0, 3.5)
        q = transform_point(hotel.frame, local)
        me.pos = vec3(q.x, f32(walk_height(towns, f64(q.x), f64(q.z))), q.z)
        d = hotel.stage - me.pos
        me.yaw = atan2(f64(d.x), f64(d.z))
        # (the camera a little to his side, so he isn't in front of the band)
        follow.yaw = me.yaw + PI - 0.3; follow.distance = 4.5; follow.pitch = 0.1
        print("NOTES at {me.pos} stage {hotel.stage} distance {length(d):.1f}")
    if stage == "fishing" or stage == "fishing-bite":
        # (on the waterfront quay below the hotel, facing the water)
        q = hotel.desk - hotel.table_z * 7.0
        me.pos = vec3(q.x, f32(walk_height(towns, f64(q.x), f64(q.z))), q.z)
        out = -hotel.table_z
        me.yaw = atan2(f64(out.x), f64(out.z))
        print("FISHING here {fishing_here()} at {me.pos} ahead {surface_height(f64((me.pos + _ahead() * 3.0).x), f64((me.pos + _ahead() * 3.0).z))}")
        fishing_begin()
        global fishing_frozen
        fishing_frozen = true
        fishing_cast(angling, u64(5), 1140)
        angling.caught = [Catch(1, 240), Catch(4, 610)]
        if stage == "fishing-bite":
            angling.stage = 3; angling.clock = 0.08
        else:
            angling.stage = 2; angling.clock = 0.5
    if stage == "stars" or stage == "stars-hill":
        if stage == "stars":
            q = hotel.counter + hotel.table_z * 8.0
            me.pos = vec3(q.x, f32(walk_height(towns, f64(q.x), f64(q.z))), q.z)
            me.yaw = atan2(f64(hotel.table_z.x), f64(hotel.table_z.z))
        else:
            # (the highest open ground within a kilometre of the town)
            c = towns[0].center; best = c; bh = -1.0
            loop ring in 1..40:
                loop k in 0..32:
                    a = f64(k) * TAU / 32.0
                    p = c + vec3(f32(cos(a) * f64(ring) * 25.0), 0, f32(sin(a) * f64(ring) * 25.0))
                    g = walk_height(towns, f64(p.x), f64(p.z))
                    if g > bh and slope_at(f64(p.x), f64(p.z)) < 0.35: bh = g; best = vec3(p.x, f32(g), p.z)
            me.pos = best
            print("STARS hill at {best}")
        hour = f64(lt.local_minute(living_world.minute)) / 60.0
        gaze_begin()
        # (looking toward the Lyre)
        d = sky_star(18.616, 38.78, hour)
        global gaze
        gaze.yaw = atan2(f64(d.x), f64(d.z)) + 0.04 + (to_float(env("AEGEAN_GAZE_TURN") ?? "0") ?? 0.0); gaze.pitch = asin(f64(d.y)) - 0.03; gaze.drift = 0.0
        print("STARS night {star_night(hour):.2} vega {d}")
    if stage.starts_with("swim"):
        # (the beach at Porto Vecchio's harbour edge, or the end of the hotel's terrace)
        global swim_tread
        if stage == "swim-dock" or stage == "swim-night":
            q = hotel.counter + hotel.table_z * 9.6
            me.pos = vec3(q.x, f32(walk_height(towns, f64(q.x), f64(q.z))), q.z)
            me.yaw = atan2(f64(hotel.table_z.x), f64(hotel.table_z.z))
            swim_go()
            loop k in 0..120: swim_move(vec2(0, 0), 1.0 / 60.0, false)
            # (and a few strokes out)
            ahead = vec2(f32(sin(me.yaw)), f32(cos(me.yaw)))
            loop k in 0..240: swim_move(ahead * f32(0.85 / 60.0), 1.0 / 60.0, false)
            swim.effort = 0.6; swim_tread = 0.0
        else:
            # (a gentle beach near the town: dry sand a few metres from water deep enough to wade)
            c = towns[0].center
            best = vec3(0, 0, 0); found = false
            loop ring in 1..60:
                if found: break
                loop k in 0..48:
                    a = f64(k) * TAU / 48.0
                    p = c + vec3(f32(cos(a) * f64(ring) * 8.0), 0, f32(sin(a) * f64(ring) * 8.0))
                    g = swim_ground(f64(p.x), f64(p.z))
                    if g < 0.25 or g > 0.7: continue
                    toward = vec3(f32(cos(a)), 0, f32(sin(a)))
                    q = p + toward * 6.0
                    if swim_level(f64(q.x), f64(q.z)) - swim_ground(f64(q.x), f64(q.z)) > 0.9 and abs(swim_ground(f64(p.x + toward.x * 2.0), f64(p.z + toward.z * 2.0)) - g) < 0.6:
                        best = p; me.yaw = atan2(f64(toward.x), f64(toward.z)); found = true; break
            if found:
                me.pos = vec3(best.x, f32(swim_ground(f64(best.x), f64(best.z))), best.z)
                print("SWIM beach at {me.pos} here {swim_here()}")
                swim_go()
                ahead = vec2(f32(sin(me.yaw)), f32(cos(me.yaw)))
                steps = if stage == "swim-wade": 250 else: 420
                loop k in 0..steps: swim_move(ahead * f32(0.9 / 60.0), 1.0 / 60.0, false)
                swim.effort = 0.6; swim_tread = 0.0
        # (the camera ahead of the swimmer, looking back at him and the shore)
        follow.yaw = me.yaw + 0.5; follow.pitch = 0.2; follow.distance = 4.2
        if stage == "swim-night":
            # (turned toward the moon, the camera behind him: its glitter on the water ahead)
            m = sky_moon(f64(lt.local_minute(living_world.minute)) / 60.0, f64(living_world.minute) / 1440.0)
            print("SWIM moon {m}")
            me.yaw = atan2(f64(m.x), f64(m.z)); follow.yaw = me.yaw + PI; follow.pitch = 0.12; follow.distance = 4.5
        print("SWIM active {swim.active} swimming {swim.swimming} level {swim.level:.2} depth {swim.depth:.2} at {me.pos}")
    if stage == "barber" or stage == "barber-walrus" or stage == "barber-clean":
        barber_begin()
        if stage == "barber-walrus":
            global barber_pick, barber_said
            barber_pick = 2; set_pilot_mustache(2); barber_said = barber_style_words(1, 2)
        if stage == "barber-clean":
            global barber_pick, barber_said
            barber_pick = 0; set_pilot_mustache(0); barber_said = barber_style_words(1, 0)
    if stage.starts_with("fish-"):
        # (a fish just landed, in the hand, his own bucket beside him on the quay below the hotel;
        # or that bucket carried, a handful in it, at the town's fish stall; or at his locker; or
        # asking a fisherman, the harbour master or the chandler for the loan of a bucket)
        q = hotel.desk - hotel.table_z * 7.0
        me.pos = vec3(q.x, f32(walk_height(towns, f64(q.x), f64(q.z))), q.z)
        out = -hotel.table_z
        me.yaw = atan2(f64(out.x), f64(out.z))
        w = living_world
        fish = FishHold()
        fish_seed_buckets(fish, w, towns)
        mine = -1
        loop k in 0..fish.buckets.len():
            if fish.buckets[k].owner == w.player: mine = k
        print("FISH buckets {[loop b in fish.buckets: "{b.owner}:{b.where}@{b.at}"]}")
        kind = to_int(env("AEGEAN_FISH_KIND") ?? "6") ?? 6
        global fish_landed_at
        fish_landed_at = t - (to_float(env("AEGEAN_FISH_AGE") ?? "0.4") ?? 0.4)
        if stage == "fish-hold" or stage == "fish-dock" or stage == "fish-market" or stage == "fish-walk" or stage == "fish-throw":
            if mine >= 0:
                _ = fish_pick_up(w, fish, mine)
                fish.buckets[mine].pail = [Catch(0, 70), Catch(3, 420), Catch(1, 260), Catch(4, 830)]
            if stage != "fish-market": _ = fish_take(fish, Catch(kind, FISH_KINDS[kind].lo + (FISH_KINDS[kind].hi - FISH_KINDS[kind].lo) / 2))
        if stage == "fish-dock":
            fishing_begin()
            global fishing_frozen
            fishing_frozen = true
            angling.stage = 4; angling.clock = 0.3
        else if stage == "fish-hold" or stage == "fish-throw":
            _ = fish_put_down(fish, fish_ground(me.pos + _right() * 0.55 - _ahead() * 0.25), me.yaw)
        if stage == "fish-market":
            st = fish_stall_of(w.people[w.player].place)
            front = fish_stall_front(st)
            p = fish_stall_customer(st) + front * 1.2
            me.pos = fish_ground(p)
            me.yaw = atan2(f64(-front.x), f64(-front.z))
        if stage == "fish-locker" or stage == "fish-stow":
            l = fish_locker_of()
            front = fish_stall_front(l)
            me.pos = fish_ground(fish_stall_customer(l) + front * f32(to_float(env("AEGEAN_FISH_BACK") ?? "0.2") ?? 0.2))
            me.yaw = atan2(f64(-front.x), f64(-front.z))
            if stage == "fish-stow" and mine >= 0:
                _ = fish_pick_up(w, fish, mine)
            print("FISH locker found {l.found} at {l.at}")
        if stage == "fish-borrow" or stage == "fish-borrowed":
            # (whoever of those who'd lend one is about in the scene: a fisherman first)
            who = -1; k_folk = -1
            loop round in 0..2:
                loop b in fish.buckets:
                    if who >= 0 or b.owner == w.player or b.place != w.people[w.player].place: continue
                    is_fisher = w.people[b.owner].occupation == .fisher
                    if (round == 0) != is_fisher: continue
                    loop k in 0..folks.len():
                        if folks[k].person == b.owner: who = b.owner; k_folk = k
            print("FISH lender {who} folk {k_folk}")
            if who >= 0:
                f = folks[k_folk]
                me.pos = fish_ground(f.pos + vec3(f32(sin(f.yaw)), 0, f32(cos(f.yaw))) * 1.6)
                me.yaw = atan2(f64(f.pos.x - me.pos.x), f64(f.pos.z - me.pos.z))
                warm = to_int(env("AEGEAN_FISH_WARM") ?? "0") ?? 0
                if warm != 0:
                    fish_set_regard(living_world, who, warm)
                ans = fish_ask_bucket(living_world, fish, who, fish_bucket_where_words(w, who), seller = fish_bucket_seller(w, who) != "")
                print("FISH asked {w.people[who].name}: lent {ans.lent} '{ans.line}'")
                if stage == "fish-borrow":
                    global ui_turn, ui_line, ui_news, ui_folk
                    ui = .talk; ui_folk = k_folk
                    ui_turn = living.talk(living_world, who, .greeting, w.player)
                    ui_line = ans.line; ui_news = 0
                    mouse_lock(false)
                else:
                    k = fish_bucket_of(fish, who)
                    b = fish.buckets[k]
                    me.pos = fish_ground(b.at + vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw))) * -1.2)
                    me.yaw = atan2(f64(b.at.x - me.pos.x), f64(b.at.z - me.pos.z))
        walker_point = world_point(me.pos); walker_published = me.pos
        follow.placed = false
        portage.cargo_person_pose(living_world, living_world.player, me.pos)
        turn = to_float(env("AEGEAN_FISH_VIEW") ?? "") ?? -99.0
        if turn > -50.0:
            follow.yaw = me.yaw + PI + turn; follow.pitch = to_float(env("AEGEAN_FISH_PITCH") ?? "0.12") ?? 0.12; follow.distance = to_float(env("AEGEAN_FISH_DIST") ?? "3.2") ?? 3.2
        print("FISH at {me.pos} yaw {me.yaw} water ahead {fish_water_ahead()}")
        print("FISH cards {[loop o in walk_offers(): offer_card(o)]}")
        if stage == "fish-throw": fish_throw()
    if stage == "paper":
        leisure_sit("coffee")
        paper_open()
        if (env("AEGEAN_PAPER_SCROLL") ?? "") != "": paper_view.scroll = to_float(env("AEGEAN_PAPER_SCROLL") ?? "0") ?? 0.0
    if stage == "tavli-choose":
        leisure_sit("coffee")
        tavli_open_choice()
    if stage == "tavli" or stage == "tavli-mid" or stage == "tavli-plakoto":
        global tavli_plakoto
        tavli_plakoto = stage == "tavli-plakoto"
        leisure_sit("coffee")
        tavli_open_choice()
        if tavli_choices.len() > 0:
            tavli_begin(tavli_choices[0], 50)
            if stage == "tavli-mid" or stage == "tavli-plakoto":
                # (a few turns played by two careful hands, then the player's throw)
                tavli_opening(tavli_game)
                loop k in 0..14:
                    if tavli_game.phase == .done: break
                    if tavli_game.phase == .roll: tavli_throw(tavli_game)
                    play = tavli_choose(tavli_game.board, tavli_game.turn, tavli_roll_dice(tavli_game.roll[0], tavli_game.roll[1]), TavliStyle(care = 0.8), tavli_game.rng xor u64(k))
                    loop m in play.moves: _ = tavli_move(tavli_game, m)
                    if tavli_game.turn == 1: tavli_view.last_theirs = play.moves
                    tavli_pass(tavli_game)
                if tavli_game.turn == 1:
                    tavli_throw(tavli_game)
                    play = tavli_choose(tavli_game.board, 1, tavli_roll_dice(tavli_game.roll[0], tavli_game.roll[1]), TavliStyle(care = 0.8), tavli_game.rng)
                    loop m in play.moves: _ = tavli_move(tavli_game, m)
                    tavli_view.last_theirs = play.moves
                    tavli_pass(tavli_game)
                tavli_throw(tavli_game)
                loop k in 0..2:
                    tb_throw_die(tavli_view.dice[k], 0, tavli_game.roll[k], f64(k) * 3.3 + 1.0)
                    loop _ in 0..400: tb_dice_step(tavli_view.dice, 1.0 / 60.0)
                tb_say(tavli_view, tavli_game, "hit")
    if stage.starts_with("work:"):
        name = stage[5..stage.len()]
        loop jb in TINKER_JOBS:
            if "{jb.task}" == name: start_plane_job(jb.task)
    if stage == "tinker":
        ui = .leisure; leisure_ui = 3; leisure_line = ""
    if stage == "spare":
        leisure_host = 7
        leisure_line = spare_room_words(living_world, 7)
        ui = .leisure; leisure_ui = 4
    if stage == "terrace":
        p = hotel.counter + hotel.table_z * 5.0 + hotel.table_x * 4.0
        me.pos = vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)
        me.yaw = atan2(f64(-hotel.table_x.x), f64(-hotel.table_x.z))
        follow.yaw = me.yaw + PI
    if stage == "bar":
        # (standing at the bar to order, facing the counter, seen from behind over a shoulder)
        p = hotel.counter + hotel.table_z * 0.15 - hotel.table_x * 0.4
        me.pos = vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)
        me.yaw = atan2(f64(-hotel.table_z.x), f64(-hotel.table_z.z))
        follow.yaw = me.yaw + PI - 0.25; follow.distance = 2.6; follow.pitch = 0.32
    if stage.starts_with("doorway"):
        # (the bar room's doorways close to, from outside and inside: doorway, doorway-in,
        # doorway-side, doorway-side-in)
        global judge_camera
        at = (x: f64, y: f64, z: f64) -> vec3: transform_point(hotel.frame, vec3(f32(x), f32(DECK + y), f32(z)))
        judge_camera = match stage:
            "doorway": JudgeView(at(1.6, 1.6, 20.2), at(0.0, 1.5, 17.8), "the bar room's doorway, from the terrace")
            "doorway-in": JudgeView(at(-1.4, 1.6, 15.6), at(0.0, 1.4, 18.0), "the bar room's doorway, from inside")
            "doorway-side": JudgeView(at(12.8, 1.6, 13.6), at(11.0, 1.5, 15.0), "the side doorway, from the walk")
            _: JudgeView(at(8.6, 1.6, 13.4), at(11.0, 1.4, 15.0), "the side doorway, from inside")
    if stage == "walk-in" or stage == "walk-in-side":
        # (from the terrace round the bar's end and in at its doorway, or along the east walk and in
        # at the side door, on foot: the bar room is there, through the door)
        global listen_mode, listen_path
        at = (x: f64, z: f64) -> vec3: transform_point(hotel.frame, vec3(f32(x), 1.2, f32(z)))
        route = if stage == "walk-in": [at(5.6, 23.5), at(5.4, 19.1), at(0.0, 18.9), at(0.0, 16.6), at(-1.0, 13.4), at(-1.6, 12.6)] else: [at(13.0, 24.0), at(13.0, 15.0), at(10.0, 15.0), at(6.0, 13.0)]
        me.pos = vec3(route[0].x, f32(walk_height(towns, f64(route[0].x), f64(route[0].z))), route[0].z)
        d = route[1] - route[0]
        me.yaw = atan2(f64(d.x), f64(d.z))
        follow.yaw = me.yaw + PI; follow.distance = 3.6; follow.pitch = 0.18
        listen_mode = "listen-walk"; listen_path = route[1..route.len()]
    if stage == "listen-run": listen_run = true
    if stage == "listen-turn" or stage == "listen-walk" or stage == "listen-run":
        # (for recording how the band is heard: by it, turning on the spot; or walking away)
        l = hotel.stage + hotel.stage_out * 4.6
        if stage != "listen-turn": l = hotel.stage + hotel.stage_out * 4.0 - hotel.table_z * 1.5
        me.pos = vec3(l.x, f32(walk_height(towns, f64(l.x), f64(l.z))), l.z)
        me.yaw = atan2(f64(-hotel.stage_out.x), f64(-hotel.stage_out.z))
        follow.yaw = me.yaw + PI; follow.distance = 3.0; follow.pitch = 0.12
        global listen_mode, listen_path
        listen_mode = if stage == "listen-run": "listen-walk" else: stage
        if stage != "listen-turn":
            corner = (x: f64, z: f64) -> vec3: transform_point(hotel.frame, vec3(f32(x), 1.2, f32(z)))
            listen_path = [corner(12.5, 25), corner(13, 4), corner(13, -2), corner(-45, -2)]
    if stage == "band":
        global judge_camera
        judge_camera = JudgeView(hotel.stage + hotel.stage_out * 5.5 + hotel.table_z * 0.6 + vec3(0, 1.6, 0), hotel.stage + hotel.table_z * 0.6 + vec3(0, 1.0, 0), "Hotel Ancora, the band")
        # (AEGEAN_BAND_CAM='out along up  out along up': the eye and where it looks, in metres from
        # the stand: out from it, along the terrace, up)
        cam = [loop w in split(env("AEGEAN_BAND_CAM") ?? "", " "): if w != "": to_float(w) ?? 0.0]
        if cam.len() == 6:
            on_stand = (o: f64, a: f64, u: f64) -> vec3: hotel.stage + hotel.stage_out * f32(o) + hotel.table_z * f32(a) + vec3(0, f32(u), 0)
            judge_camera = JudgeView(on_stand(cam[0], cam[1], cam[2]), on_stand(cam[3], cam[4], cam[5]), "Hotel Ancora, the band")
    if stage.starts_with("tip"):
        # (AEGEAN_TIPS=n: n coins from the pilot in the jar first, and a note; captures)
        global tip_thanks_cents, tip_thanks_at
        n = int(to_float(env("AEGEAN_TIPS") ?? "0") ?? 0.0)
        loop k in 0..n: _ = leisure_tip(living_world, hotel_place, if k == n - 1: TIP_NOTE else: TIP_COIN)
        j = band_jar_at(hotel)
        if stage == "tip" or stage == "tip-panel":
            # (on foot in front of the stand, by the jar)
            p = band_stand_world(hotel, STAND_HALF_OUT + 1.2, 2.2, 0.0)
            me.pos = vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)
            me.yaw = atan2(f64(-hotel.stage_out.x), f64(-hotel.stage_out.z))
            follow.yaw = me.yaw + PI + 0.5; follow.distance = 3.4; follow.pitch = 0.25
            if stage == "tip-panel":
                ui = .leisure; leisure_ui = 20; leisure_line = ""
        if stage == "tip-thanks":
            o = leisure_tip(living_world, hotel_place, TIP_NOTE)
            print("TIP {o.ok} {o.message}")
            tip_thanks_cents = TIP_NOTE; tip_thanks_at = t
        cam = [loop w in split(env("AEGEAN_BAND_CAM") ?? "", " "): if w != "": to_float(w) ?? 0.0]
        if stage == "tip-thanks" and cam.len() == 6:
            global judge_camera
            on_stand = (o: f64, a: f64, u: f64) -> vec3: hotel.stage + hotel.stage_out * f32(o) + hotel.table_z * f32(a) + vec3(0, f32(u), 0)
            judge_camera = JudgeView(on_stand(cam[0], cam[1], cam[2]), on_stand(cam[3], cam[4], cam[5]), "the band thanks the pilot")
        else if stage == "tip-thanks" or stage == "tip-jar":
            global judge_camera
            # (the stand from its front, or the jar close to)
            judge_camera = if stage == "tip-jar": JudgeView(j + hotel.stage_out * 0.55 + hotel.table_z * 0.25 + vec3(0, 0.3, 0), j + vec3(0, 0.07, 0), "the band's tip jar") else: JudgeView(hotel.stage + hotel.stage_out * 5.0 + hotel.table_z * 1.4 + vec3(0, 1.5, 0), hotel.stage + hotel.table_z * 0.4 + vec3(0, 1.3, 0), "the band thanks the pilot")
        print("TIP jar {living_world.band.jar} pieces {living_world.band.jar_pieces.len()} at {j}")
    if stage == "door" or stage == "board":
        global judge_camera
        if stage == "door": judge_camera = JudgeView(hotel.desk - hotel.table_z * 9.0 + hotel.table_x * 2.0 + vec3(0, 1.4, 0), hotel.desk + vec3(0, 2.6, 0) + hotel.table_z * 1.4, "Hotel Ancora, the door")
        else: judge_camera = JudgeView(hotel.counter + hotel.table_z * 6.5 - hotel.table_x * 1.5 + vec3(0, 0.6, 0), hotel.counter + vec3(0, 4.2, 0) - hotel.table_z * 1.5, "Hotel Ancora, the terrace")
    if stage == "exterior" or stage == "harbour":
        global judge_camera
        out = hotel.table_z; side = hotel.table_x
        eye = if stage == "exterior": hotel.origin + out * 62.0 + side * 34.0 + vec3(0, 12, 0) else: hotel.origin - out * 6.0 - side * 70.0 + vec3(0, 9, 0)
        judge_camera = JudgeView(eye, hotel.origin + out * 16.0 + vec3(0, 4, 0), "Hotel Ancora")
    if stage == "sleep":
        leisure_sit("hotel")
        leisure_ui = 2
        o = leisure_take_room(living_world, hotel_place)
        print("LEISURE room {o.ok} {o.message}")
        leisure_stand()
        ui = .none
        leisure_skip(rest_minutes(living_world, 420), "Asleep in a room at the Hotel Ancora", 1)
    if menu_view.query == "" and env("AEGEAN_LEISURE_SECTION") != none: menu_view.section = to_int(env("AEGEAN_LEISURE_SECTION") ?? "0") ?? 0


# ---------------- working on the aircraft, by hand (src/plane_work.jo) ----------------
# A job from the aircraft's panel: the pilot walks to the quay's edge, hauls the line in if she
# lies off, steps aboard and climbs to where the job is (or does it from the quay when it's within
# reach), works at it, and comes back ashore. Time passes while he works.

struct PlaneJob:
    active = false
    task: TinkerTask = .wipe
    legs: WorkLeg[]
    leg = 0
    clock = 0.0
    point = 0
    planned = false                 # (the job's own legs, after any hauling in)
    minutes = 0
    work_total = 1.0
    aboard = false
    local: vec3 = vec3(0, 0, 0)     # (the feet, in the craft frame, while aboard)
    pose: WorkPose = .stand
    line = ""
    stall = 0.0
    caught_up = false               # (the world's clock has run on for the job)
    ashore: vec3 = vec3(0, 0, 0)    # (where he steps aboard from: the camera keeps that side)
job = PlaneJob()

cowling_panel = custom_mesh((): 
    vs: Vertex3D[]
    add_box(vs, vec3(0, -0.24, 0), vec3(0.03, 0.48, 0.5), rgb(0.55, 0.55, 0.56))
    vs
())

plane_layout = () -> CraftLayout:
    cm = craft_models[pc.model]
    craft_layout(cm.shade, cm.prop_at, cm.prop_radius, cm.cockpit, cm.exit)

# the nearest walkable quay (or ground) to a world point, within three metres, or none
quay_point = (p: vec3) -> vec3?:
    best: vec3? = none
    bd = 1000.0
    loop ring in 0..13:
        r = f64(ring) * 0.25
        n = if ring == 0: 1 else: 16
        loop k in 0..n:
            a = f64(k) / f64(n) * TAU
            x = f64(p.x) + cos(a) * r; z = f64(p.z) + sin(a) * r
            h = walk_height(towns, x, z)
            if h < 0.6: continue
            c = vec2(f32(x), f32(z))
            if town_avoid_buildings(towns, c, h) != c: continue
            if r < bd:
                bd = r; best = vec3(f32(x), f32(h), f32(z))
        if best != none: return best
    best

# the player put exactly here (on the airframe the ground's height doesn't apply)
place_walker = (p: vec3):
    global me, walker_point, walker_published
    me.pos = p
    walker_point = world_point(p)
    walker_published = me.pos

# the part most in need of a patch (the near lower wing if nothing is torn)
damaged_part = (near: f64) -> int:
    best = if near < 0.0: 2 else: 3
    worst = 0.98
    loop k in [0, 2, 3, 4, 5, 6]:
        if k < pc.state.damage.parts.len() and pc.state.damage.parts[k].attached and pc.state.damage.parts[k].health < worst:
            worst = pc.state.damage.parts[k].health; best = k
    best

# which side of the aircraft the player is on (-1 left, 1 right)
player_side = () -> f64:
    local = transform_point(inverse(pc_at()), me.pos)
    if local.x < 0: -1.0 else: 1.0

start_plane_job = (task: TinkerTask):
    global job, ui, leisure_ui, follow
    minutes = 15
    loop j in TINKER_JOBS:
        if j.task == task: minutes = j.minutes
    l = plane_layout()
    b = choose_boarding(l, pc_at(), quay_point)
    if b.gap >= 999.0 and mooring_anchor() == none:
        global leisure_line
        leisure_line = "There's no dock alongside to work from."
        return
    job = PlaneJob(active = true, task = task, minutes = minutes)
    # (lying off: to the bollard first, to haul her in)
    if b.gap > 1.4:
        if let a = mooring_anchor():
            if let q = quay_point(a): job.legs = [WorkLeg(.walk, [q]), WorkLeg(.haul, [])]
    ui = .leisure; leisure_ui = 5
    mouse_lock(false)

_plan_plane_job = ():
    global job
    l = plane_layout()
    job.legs = plan_work(l, pc_at(), task_stops(l, job.task, damaged_part(player_side()), player_side()), quay_point)
    job.leg = 0; job.clock = 0.0; job.point = 0; job.planned = true
    loop g in job.legs:
        if g.kind == .hop_on: job.ashore = g.from
    total = 0.0
    loop g in job.legs:
        if g.kind == .work: total += g.seconds
    job.work_total = max(1.0, total)

_next_leg = ():
    global job
    job.leg += 1; job.clock = 0.0; job.point = 0; job.stall = 0.0

_face = (p: vec3):
    global me
    d = p - me.pos
    if length(d.xz) > 0.01: me.yaw = atan2(f64(d.x), f64(d.z))

# A frame of the job: the current leg walked, climbed or worked.
plane_job_step = (dt: f64):
    global job, me, hour, leisure_ui, leisure_line, follow, pc, follow_steady
    if not job.active: return
    frame = pc_at()
    # (the camera keeps a three-quarter view from behind, a little farther out)
    # (on the quay, a three-quarter view from behind; aboard, from the quay's side of her, a little
    # off the nose, steady while she rides the swell)
    near_craft = job.aboard or (job.leg < job.legs.len() and (job.legs[job.leg].kind == .hop_on or job.legs[job.leg].kind == .hop_off))
    follow.distance += ((if near_craft: 7.0 else: 6.0) - follow.distance) * min(1.0, dt * 2.0)
    follow.pitch += ((if near_craft: 0.38 else: 0.3) - follow.pitch) * min(1.0, dt * 2.0)
    if near_craft:
        side = normalize((job.ashore - pc.state.position).xz + vec2(0.0001, 0))
        nose = normalize(quat_rotate(pc.state.orientation, vec3(0, 0, -1)).xz + vec2(0.0001, 0))
        look = normalize(side * 0.8 + nose * 0.6)
        follow.yaw = approach_angle(follow.yaw, atan2(f64(look.x), f64(look.y)), 1.5, dt)
        follow_steady = vec3(0, f32(swell_at(f64(pc.state.position.x), f64(pc.state.position.z), t).x * 0.9), 0)
    else:
        follow.yaw = approach_angle(follow.yaw, me.yaw + PI + 0.7, 1.2, dt)
        follow_steady = vec3(0, 0, 0)
    if job.leg >= job.legs.len():
        if not job.planned:
            _plan_plane_job()
            return
        out = leisure_tinker(living_world, living_world.people[living_world.player].craft, job.task)
        leisure_line = out.line
        job.active = false
        job.pose = .stand
        follow.distance = 5.5
        follow_steady = vec3(0, 0, 0)
        leisure_ui = 3
        return
    g = job.legs[job.leg]
    job.clock += dt
    me.stride = approach(me.stride, 0.0, 6.0, dt)
    match g.kind:
        .walk:
            job.pose = .stand; job.line = "To the aircraft"
            target = g.points[min(job.point, g.points.len() - 1)]
            d = target.xz - me.pos.xz
            if f64(length(d)) < 0.18:
                job.point += 1
                if job.point >= g.points.len(): _next_leg()
                return
            before = me.pos
            dir = normalize(d)
            step_player_walk(dir * f32(min(1.6 * dt, f64(length(d)))))
            me.yaw = approach_angle(me.yaw, atan2(f64(dir.x), f64(dir.y)), 10.0, dt)
            me.stride = approach(me.stride, 0.7, 8.0, dt)
            me.phase += dt * 1.6 * 5.0
            # (blocked by something: go round it by the navigation grid, or at last step past)
            if f64(length(me.pos.xz - before.xz)) < 0.2 * dt:
                job.stall += dt
                if job.stall > 0.6 and g.points.len() == 1:
                    path = cargo_scene.cargo_walk_path(towns, me.pos, target)
                    if path.len() > 1: job.legs[job.leg].points = path; job.point = 1
                    job.stall = -1.0
                else if job.stall > 1.5: place_walker(target); job.stall = 0.0
            else: job.stall = max(0.0, job.stall)
        .haul:
            job.pose = .haul; job.line = "Hauling in the line"
            p = pc.state.position
            if let a = mooring_anchor():
                _face(vec3(p.x, me.pos.y, p.z))
                off = vec3(p.x - a.x, 0, p.z - a.z)
                l = f64(length(off))
                if l > 3.1 and job.clock < 8.0:
                    np = p - off / f32(l) * f32(min(1.2 * dt, l - 3.1))
                    pc.state.position = np; pc.state.mooring_point = np
                else: _next_leg()
            else: _next_leg()
        .hop_on, .hop_off:
            job.pose = .climb; job.line = if g.kind == .hop_on: "Stepping aboard" else: "Back onto the dock"
            u = clamp(job.clock / 0.9, 0.0, 1.0)
            a = if g.kind == .hop_on: g.from else: transform_point(frame, g.from)
            b = if g.kind == .hop_on: transform_point(frame, g.to) else: g.to
            arc = f32(sin(u * PI) * 0.35)
            place_walker(a + (b - a) * f32(u * u * (3.0 - 2.0 * u)) + vec3(0, arc, 0))
            _face(b)
            if u >= 1.0:
                job.aboard = g.kind == .hop_on
                if job.aboard: job.local = g.to
                else: place_walker(g.to)
                _next_leg()
        .craft:
            target = g.points[min(job.point, g.points.len() - 1)]
            d = target - job.local
            climbing = abs(f64(d.y)) > 0.25
            job.pose = if climbing: WorkPose.climb else: WorkPose.stand
            job.line = if climbing: "Climbing up" else: "Along the aircraft"
            dist = f64(length(d))
            if dist < 0.05:
                job.point += 1
                if job.point >= g.points.len(): _next_leg()
            else:
                speed = if climbing: 0.6 else: 1.1
                job.local = job.local + d / f32(dist) * f32(min(speed * dt, dist))
                if not climbing:
                    me.stride = approach(me.stride, 0.6, 8.0, dt)
                    me.phase += dt * speed * 5.0
                _face(transform_point(frame, target))
            place_walker(transform_point(frame, job.local))
        .work:
            job.pose = g.pose; job.line = g.line
            if job.aboard: place_walker(transform_point(frame, job.local))
            aim = transform_point(frame, g.target)
            _face(aim)
            # (the propeller turned so a blade comes to his hand)
            if job.task == .polish:
                hub = craft_models[pc.model].prop_at
                pc.prop_angle = atan2(-f64(g.target.x - hub.x), f64(g.target.y - hub.y))
            # (the sun moves as he works; the world's clock catches up when the work is done)
            hour = (hour + dt * f64(job.minutes) / 60.0 / job.work_total + 24.0) % 24.0
            if job.clock >= g.seconds:
                last = true
                loop k in job.leg + 1..job.legs.len():
                    if job.legs[k].kind == .work: last = false
                if last and not job.caught_up:
                    job.caught_up = true
                    leisure_skip(job.minutes, "Working on the aircraft")
                _next_leg()

# Escape stops the job where it is: back onto the quay, nothing done.
stop_plane_job = ():
    global job, leisure_ui, follow, follow_steady
    follow_steady = vec3(0, 0, 0)
    if job.aboard:
        loop k in job.leg..job.legs.len():
            if job.legs[k].kind == .hop_off: place_walker(job.legs[k].to); break
    job.active = false
    job.pose = .stand
    follow.distance = 5.5
    leisure_ui = 3

player_cents = () -> int:
    a = living_world.people[living_world.player].account
    if a >= 0: living_world.accounts[a].cents else: 0

# The player's aircraft takes no damage: the debugging panel's switch, or the sandbox's.
no_damage_now = () -> bool: dbg.no_damage or sandbox.no_damage

# `words`: the part of it someone says aloud (after their name), which arrives as it is spoken
# (src/spoken_view.jo); "" for a note of what happened, there at once.
say_toast = (s: str, words: str = ""):
    global toast, toast_until, toast_words
    toast = s
    toast_words = if s.ends_with(words): words else: ""
    toast_until = t + 5.0 + (if toast_words != "": spoken_seconds(toast_words, RADIO_SPOKEN_RATE, options.text_speed) else: 0.0)

# the town one is in (by the nearest waterfront within a few hundred meters), or -1
town_here = (p: vec3) -> int:
    best = -1
    bd = 450.0
    loop k in 0..towns.len():
        d = f64(length(vec2(towns[k].center.x - p.x, towns[k].center.z - p.z)))
        if d < bd:
            bd = d
            best = k
    best

near_board = () -> int:
    loop k in 0..board_spots.len():
        if length(board_spots[k] - me.pos) < 3.2: return k
    -1

# A passenger the pilot carries for a job, aboard his aircraft now (-1 none).
job_passenger_aboard = () -> int:
    craft = living_world.people[living_world.player].craft
    if craft < 0 or craft >= living_world.aircraft.len(): return -1
    loop id in living_world.active_jobs:
        j = living_world.jobs[id]
        if j.state == .claimed and j.carrier == living_world.player and j.purpose == .passenger and j.passenger >= 0 and j.passenger in living_world.aircraft[craft].passengers: return j.passenger
    -1

# jobs the player carries for this place, delivered on arrival (paid then): the passenger climbs out
# onto the dock beside the pilot, thanks him, and goes on into the town
deliver_here = (place: int):
    loop id in living_world.active_jobs:
        j = living_world.jobs[id]
        if j.state != .claimed or j.carrier != living_world.player or j.destination != place or j.purpose != .passenger: continue
        before = player_cents()
        late = living_world.minute > j.due_minute
        if living.deliver_job(living_world, id, living_world.player):
            p = j.passenger
            if rider.person == p and (rider.stage == .aboard or rider.stage == .boarding):
                seat = pc.state.position + quat_rotate(pc.state.orientation, rider_seat(ride_seat(player_model()), rider.on_wing, pc.spec.span))
                inland = me.pos - pc.state.position
                side = normalize(vec3(-inland.z, 0, inland.x) + vec3(0.0001, 0, 0))
                rider_alight(rider, seat, me.pos + side * 1.2, inland, t)
            thanks = if let e = errand_of(living_world, id): errand_thanks(living_world, e, late) else: ["Here already. Thank you.", "Safe and sound. Thank you.", "That was quicker than the boat."][(p + living_world.minute) % 3]
            say_toast("{split(living_world.people[p].name, " ")[0]}: {thanks}  {phoenix_text(player_cents() - before)} from {split(living_world.people[j.poster].name, " ")[0]}.")
spray_ps = WorldParticles(gravity = vec3(0, -9.8, 0), drag = 1.5,billowing=true)
smoke_ps = WorldParticles(gravity = vec3(0, 1.5, 0), drag = 2.0)
vapor_trails = [Trail(), Trail()]
pc_wing_vapour = WingVapour()       # (the vapour over the player's wings: a Tweaks trial, src/wing_vapour.jo)
air_visual=make_air_view()
air_events=AirEvents()
air_meet_view=make_air_meet_view()
all_air_traffic=traffic
view_target=TargetView()
target_scan=0.0
wakes: WakeTrail[] = [loop k in 0..traffic.len() + 1: WakeTrail()]

# on the main quay, beside one's own aircraft
q0 = home.quays[0]
dk = vec2(home.docks[0].x, home.docks[0].z)
qd = q0.b - q0.a
along_q = clamp(dot(dk - q0.a, qd) / dot(qd, qd), 0.0, 1.0)
on_q = q0.a + qd * along_q
toward = normalize(dk - on_q)
sp = on_q + toward * (q0.width * 0.5 - 1.2)
start = vec3(sp.x, 0, sp.y)
me = Player(pos = vec3(start.x, f32(walk_height(towns, f64(start.x), f64(start.z))), start.z), yaw = atan2(f64(home.out.x), f64(home.out.y)))
pilot_mustache = 1              # the pilot's mustache: 0 clean-shaven, 1 handlebar, 2 walrus, 3 chevron (saved)
me_fig = build_figure(.pilot, 7, mustache = 1, mustache_tint = PILOT_MUSTACHE)       # (a full handlebar)
me_bathing:Figure?
# the pilot's figure with another mustache (the barber's work, or a loaded game's)
set_pilot_mustache = (style: int):
    global pilot_mustache, me_fig, me_bathing
    s = clamp(style, 0, 3)
    if s == pilot_mustache: return
    pilot_mustache = s
    me_fig = build_figure(.pilot, 7, mustache = s, mustache_tint = PILOT_MUSTACHE)
    me_bathing = none
player_figure=()->Figure:
    global me_bathing
    if (presentation.thermal.active and not presentation.thermal.sleeping) or swim.active or bath.costume:
        if me_bathing==none:me_bathing=build_figure(.pilot,7,mustache=pilot_mustache,mustache_tint=PILOT_MUSTACHE,bathing=true)
        return me_bathing!
    me_fig
# how the player's figure is drawn on foot: how much its legs swing, and its posture (see
# draw_figure_at): his scarf goes by the same
player_stride = () -> f64: if cat_busy(cat_scene) or presentation.thermal.active or leisure.sitting != "" or (ui == .leisure and leisure_ui == 12): 0.0 else: me.stride
# (seated at a table or in the barber's chair; standing at the bar)
player_posture = () -> int: if presentation.thermal.active: 1 else: if cat_busy(cat_scene): 4 else: if pilot_posture() == 1 or (ui == .leisure and leisure_ui == 12): 1 else: if job.active: work_posture(job.pose) else: 0
tuft = build_tuft()
capture_audio = startup_aegean_audio_capture != none and env("SLOPPY_SCREENSHOT") != none
audio_enabled = startup_sloppy_no_audio == none or capture_audio
captured_audio: f32[]
audio_capture_frames = int(f64(to_int(env("AEGEAN_AUDIO_SECONDS") ?? "") ?? 30) * 60.0)   # (frames of the mix the capture keeps)
# (behind the title the sounds, about 0.9 s of a phone's start, are made a piece a frame while the
# title dips to dusk between shots, the rest at once when the title closes: step_audio_build)
audio_deferred = audio_enabled and title_will_open()
audio_built = not audio_deferred
audio_job = AudioBuild(environment = false)
audio_job_step = 0               # (0 the sounds' pieces, 1 the far engines' hearing, 2 the guns')
audio = if audio_enabled and not audio_deferred: start_audio(false) else: Audio()
# AEGEAN_SKY_DAYS=d fixes the sky's day count (the Moon's age) for captures.
sky_days_override: f64? = to_float(env("AEGEAN_SKY_DAYS") ?? "")
# (a thunderstorm's rain, gusts and thunder: made with the other sounds, behind the title when
# those are deferred: step_audio_build)
storm_audio = StormSound()
if audio_enabled and not audio_deferred: storm_sound_start(storm_audio)
life_sound = life_audio.build_life_audio()
world_ambience = AmbienceScene(sound=build_ambience(render_only=capture_audio))
if capture_audio: world_ambience.sound.playback=true
cockpit_radio = radio.Radio()
cockpit_radio.khz = load_value("radio-khz", cockpit_radio.khz)
radio_saved_khz = cockpit_radio.khz
if audio_enabled: radio.radio_prepare(cockpit_radio)
radio_bulletin = broadcast.RadioBulletinCache()
broadcast.radio_place_transmitters(cockpit_radio, height)
# AEGEAN_RADIO=kc: the cockpit radio on and tuned to that frequency from the start (captures)
if let v = env("AEGEAN_RADIO"):
    radio.radio_mute(cockpit_radio, false)
    radio.radio_tune(cockpit_radio, to_float(v) ?? 780.0)
hearing = if audio_enabled and not audio_deferred: make_hearing() else: Hearing()
cat_scene = build_cat_scene(audio_enabled)       # the town cats about the player (src/cats.jo)
battle = Battle(enabled=true,seed=int(living_world.seed%100000))
register_combat_body(battle,living_world,living_world.people[living_world.player].craft,pc.spec,pc.state,true)
combat_visual = make_combat_view()
combat_audio = if audio_enabled and not audio_deferred: start_combat_audio() else: CombatAudio()
battle_radio = BattleRadio()
homeward = HomewardView()           # after the strait: the way home (src/homeward_view.jo)
rt = RtPad()                        # the R/T to one's own flight (src/rt_pad.jo)
cockpit_model = build_cockpit()

grass = GrassField(me.pos, instance_buffer([GrassCell(mat4(), vec4(1, 1, 1, 1),vec4(0,1,0,0))]), 0)
grass_job = GrassBuild()        # the next field, made a slice a frame
grass_was_walking = false       # (on foot last frame: a field out of reach then is a jump)
grass_arriving = false          # (no field near the walker yet: the job takes the arrival's slice)
const GRASS_ARRIVAL_SECONDS = 0.012
const GRASS_BUILD_SECONDS = 0.003

follow = follow_camera(distance = 5.5, pitch = 0.25, height = 1.6)
const WALK_NEAREST = 2.5            # (how near and far the wheel takes the camera on foot)
const WALK_FARTHEST = 14.0
follow_frame = FollowFrame()
walker_point = world_point(me.pos)
walker_published = me.pos
sync_walker_point = ():
    global walker_point,walker_published,me
    if me.pos != walker_published:
        walker_point=world_point(me.pos)
        if me.mode==.walking:walker_point.y=walk_height(towns,walker_point.x,walker_point.z)
        me.pos=world_vec(walker_point);walker_published=me.pos
step_player_walk = (move: vec2):
    global walker_point,walker_published,me
    sync_walker_point()
    walker_point=walk_step_precise(towns,walker_point,move)
    me.pos=world_vec(walker_point);walker_published=me.pos
# The way the camera looks, kept where each camera is placed (for hearing live music from it).
ear_forward = vec3(0, 0, -1)

# (follow_steady: taken off the camera's target, so it doesn't heave with a moored aircraft)
follow_steady = vec3(0, 0, 0)
update_player_follow = (dt: f64,input: bool = true):
    global follow,follow_frame,actor_render_offsets
    sync_walker_point()
    target = if follow_steady == vec3(0, 0, 0): walker_point else: world_point(world_vec(walker_point) - follow_steady)
    before = follow.distance
    update_local_follow(follow,follow_frame,target,dt,input=input)
    # (the library's camera zooms by the wheel itself; the game's own zoom, smoothed, instead)
    follow.distance = if menus_open(): before else if input: clamp(before * wheel_zoom(), WALK_NEAREST, WALK_FARTHEST) else: follow.distance
    follow_clear_of_walls(dt)
    actor_render_offsets[living_world.player]=world_residual(walker_point)

# The follow camera kept on the near side of a wall: along the line from the pilot's head out to
# where the camera would be, the first point inside a building (the same solids walking stops at)
# brings it in to just short of there, so a house never stands between the view and the pilot.
follow_clear_of_walls = (dt: f64):
    global follow
    a = aim(follow)
    cp = cos(follow.pitch)
    off = vec3(f32(sin(follow.yaw) * cp), f32(sin(follow.pitch)), f32(cos(follow.yaw) * cp))
    d = follow.distance
    o = follow_frame.origin
    want = 1.0
    steps = max(1, int(ceil(d / 0.25)))
    loop k in 1..steps + 1:
        along = d * f64(k) / f64(steps)
        if along < 0.6: continue
        q = a + off * f32(along)
        at = vec2(f32(f64(o.x) + f64(q.x)), f32(f64(o.z) + f64(q.z)))
        # (pushed more than a hand's breadth: inside a wall, or nearly; only what stands taller than
        # the pilot counts, so benches, tables and garden walls don't pull the view in)
        # (or under the ground behind: on a steep hillside, a lane along the slope, the view sank into
        # the hill)
        # (or inside an aircraft on the water or the ground: the pilot's own moored beside the dock,
        # another's at its mooring)
        under = walk_height(towns, f64(at.x), f64(at.y)) > f64(o.y) + f64(q.y) - 0.35
        if under or length(town_avoid_buildings(towns, at, max(f64(q.y) - 0.3, f64(me.pos.y) + 2.1)) - at) > 0.2 or camera_in_aircraft(vec3(at.x, f32(f64(o.y) + f64(q.y)), at.y)):
            # (never closer than a metre behind the head)
            want = max(along - 0.45, 1.0) / d
            break
    # (in quickly but not at once, from half a metre short of the solid, so it never pops and the
    # view never goes inside; out again gently, as the library's camera does)
    follow.reach = want
    if want < follow.shown_reach: follow.shown_reach = approach(follow.shown_reach, want, 18.0, dt)

# Whether a point (the camera, in the world) is inside an aircraft standing on the water or the
# ground nearby: a box about it in its own frame (its span across, nose to tail about the span,
# float or wheel bottoms to above the top wing). The pilot's own when not aboard; the traffic's at
# their moorings.
camera_in_aircraft = (p: vec3) -> bool:
    if me.mode != .aboard and _in_craft_box(p, pc.state.position, pc.state.orientation, pc.spec.span): return true
    loop tr in all_air_traffic:
        if tr.visible and not tr.flying and f64(length(tr.state.position - p)) < tr.spec.span + 4.0:
            if _in_craft_box(p, tr.state.position, tr.state.orientation, tr.spec.span): return true
    false
_in_craft_box = (p: vec3, at: vec3, turn: vec4, span: f64) -> bool:
    if f64(length(p - at)) > span + 2.0: return false
    l = quat_rotate(quat_inverse(turn), p - at)
    x = abs(f64(l.x)); y = f64(l.y); z = f64(l.z)
    long = span * 0.42 + 0.5              # (half its length, nose to tail, about the span's)
    # (the wings: the whole span, a chord's depth fore and aft, the lower wing to the upper; the
    # fuselage, nose to tail; the floats or wheels below: not the open air between them)
    wings = x < span * 0.5 + 0.3 and abs(z + 0.3) < 1.4 and y > -0.6 and y < 2.4
    body = x < 1.0 and abs(z) < long and y > -1.2 and y < 1.6
    floats = x < 2.8 and abs(z) < long * 0.85 and y > -2.6 and y < -1.0
    wings or body or floats

descent_camera = DescentCamera()
follow.yaw = me.yaw + PI
free = fly_camera(vec3(2600, 380, 2600), 0.8, -0.18)
free.speed = 120.0
hour = to_float(env("AEGEAN_HOUR") ?? "9.5") ?? 9.5
# AEGEAN_HOUR_RATE: hours of the day per second (captures: a dusk in seconds); by default 1/120
hour_rate = to_float(env("AEGEAN_HOUR_RATE") ?? "") ?? (1.0 / 120.0)
t = 0.0
show_chart = env("AEGEAN_CHART") != none
# (captures and the pause menu: every edition on the counters handed over at once)
if env("AEGEAN_MAPS") == "all": _ = living.grant_every_map(living_world,living_world.player)
if let v = env("AEGEAN_CHART_VIEW"):
    f = split(v, " ")
    if f.len() >= 3:
        cw = to_float(f[2]) ?? 6000.0
        chart_view_override = ChartView(to_float(f[0]) ?? 0.0, to_float(f[1]) ?? 0.0, cw, cw)
if let focus = env("AEGEAN_CHART_FOCUS"):
    loop c in living.owned_maps(living_world,living_world.player):
        if c.edition == focus: chart_focus = c.id

# AEGEAN_SETTLE=1: the terrain generates without its per-frame budget (slow headless captures see
# the settled ground of real play rather than the coarse arrival tiles).
if env("AEGEAN_SETTLE")!=none:world_generate_seconds=2.0
if let v = env("AEGEAN_VIEW"):
    w = split(v, " ")
    if w.len() >= 6:
        free.pos = vec3(f32(to_float(w[0]) ?? 0.0), f32(to_float(w[1]) ?? 0.0), f32(to_float(w[2]) ?? 0.0))
        free.yaw = to_float(w[3]) ?? 0.0
        free.pitch = to_float(w[4]) ?? 0.0
        hour = to_float(w[5]) ?? 15.0
        me.mode = .free
# AEGEAN_VIEW_GLIDE="vx vy vz" (captures, with AEGEAN_VIEW): the free camera moves at that
# velocity (m/s), its look held, for fly-in clips
view_glide: vec3? = none
if let v = env("AEGEAN_VIEW_GLIDE"):
    w = split(v, " ")
    if w.len() >= 3: view_glide = vec3(f32(to_float(w[0]) ?? 0.0),f32(to_float(w[1]) ?? 0.0),f32(to_float(w[2]) ?? 0.0))
if let v = env("AEGEAN_AT"):
    w = split(v, " ")
    x = to_float(w[0]) ?? 0.0
    z = to_float(w[1]) ?? 0.0
    me.pos = vec3(f32(x), f32(walk_height(towns, x, z)), f32(z))
    follow.yaw = to_float(w[2]) ?? 0.0
# AEGEAN_FOLLOW="distance pitch": the walking camera's distance and pitch from the start (captures)
if let v = env("AEGEAN_FOLLOW"):
    w = split(v, " ")
    follow.distance = to_float(w[0]) ?? follow.distance
    if w.len() > 1: follow.pitch = to_float(w[1]) ?? follow.pitch
if env("AEGEAN_ABOARD") != none: me.mode = .aboard
if let name = env("AEGEAN_WEATHER"):
    anchor = if me.mode == .free: free.pos else: me.pos
    if let v = env("AEGEAN_WEATHER_CENTER"):
        fields = split(v," ")
        if fields.len() >= 2: anchor = vec3(f32(to_float(fields[0]) ?? 0.0),0,f32(to_float(fields[1]) ?? 0.0))
    weather_fixture(living_world,name,anchor)
weather_scene_step(living_world,if me.mode == .free: free.pos else: me.pos,hour,0.0)
trace = env("AEGEAN_TRACE") != none
# AEGEAN_AMBIENCE_TRACE: what the ambience is playing, every two seconds (captures)
ambience_trace = env("AEGEAN_AMBIENCE_TRACE") != none
world_hidden = env("AEGEAN_NO_WORLD") != none
# AEGEAN_NEAR_BOOST=x sets how much faster the near sea and ground stream past (the pause menu's)
if let nb = env("AEGEAN_NEAR_BOOST"): set_near_boost(to_float(nb) ?? 3.0)
# AEGEAN_SPEED_MODE=0..3 picks the trick for the feel of speed (off, detail, sea, stretch)
if let sm = env("AEGEAN_SPEED_MODE"): set_speed_mode(to_int(sm) ?? 1)
# AEGEAN_FLYING="altitude [speed] [cockpit]" starts in the air off the home harbor, heading out to
# sea: altitude in metres, speed the TRUE airspeed in m/s (the speedometer's; drawn at the speed
# scale, 3.3 times faster), by default a safe 1.3 times the aircraft's stall; "cockpit": in the
# cockpit view. The aircraft starts serviced (AEGEAN_WEAR=1 keeps a new game's wear)
flying_drawn_speed = (spec: CraftSpec, given: f64?) -> f64:
    (given ?? spec.stall_speed * 1.3) * max(spec.handling_scale, 1.0)
if let v = env("AEGEAN_FLYING"):
    w = split(v, " ")
    alt = to_float(w[0]) ?? 60.0
    given: f64? = if w.len() > 1: to_float(w[1]) else: none
    spd = flying_drawn_speed(pc.spec, given)
    h = along_quay
    p0 = home.docks[0] + vec3(home.out.x, 0, home.out.y) * 500.0
    # (AEGEAN_FLYING_OVER=airfield: over the nearest airfield's grass instead, along its runway, the
    # height above the ground; for captures over land)
    if env("AEGEAN_FLYING_OVER") == "airfield":
        af = AIRFIELDS[max(0, nearest_airfield(home.docks[0].xz))]
        p0 = airfield_point(af, -af.half_length * 0.6, 0.0); h = af.heading
        alt += max(surface_height(f64(p0.x), f64(p0.z)), 0.0)
    pc.state = CraftState(position = vec3(p0.x, f32(alt), p0.z), velocity = heading_vector(h) * f32(spd), orientation = quat_euler(0, -h, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, throttle = 0.85)
    pc.throttle = 0.85
    pc.aim_heading = h
    me.mode = .aboard
    if w.contains("cockpit"): pc.cockpit_view = true
    # (AEGEAN_CAPTURE_SHADOW_VIEW=1, captures only: a free camera behind and above, looking between
    # the aircraft and its shadow, so the shadow is in frame however high she is)
    if env("AEGEAN_CAPTURE_SHADOW_VIEW") != none:
        sd = normalize(light_at(hour).sun_dir)
        ground = max(surface_height(f64(pc.state.position.x), f64(pc.state.position.z)), 0.0)
        shade = pc.state.position - sd * f32((f64(pc.state.position.y) - ground) / max(f64(sd.y), 0.2))
        look = (pc.state.position + shade) * 0.5
        back = heading_vector(h + PI * 0.6)
        reach = 30.0 + f64(length(pc.state.position - shade)) * 0.9
        eye = look + back * f32(reach) + vec3(0, f32(reach * 0.55), 0)
        want = normalize(look - eye)
        best = 0.0; best_d = -2.0
        loop k in 0..720:
            yw = f64(k) * TAU / 720.0
            d = f64(dot(forward(fly_camera(eye, yw, asin(f64(want.y)))), want))
            if d > best_d: best_d = d; best = yw
        free = fly_camera(eye, best, asin(f64(want.y)))
        me.mode = .free
    # (a weather fixture centres on the aircraft it starts in)
    if let name = env("AEGEAN_WEATHER"):
        if env("AEGEAN_WEATHER_CENTER") == none: weather_fixture(living_world,name,pc.state.position)
    # (the speed is through the air: the wind where it starts is added, so a storm's wind from
    # behind doesn't start it below its stall)
    weather_scene_step(living_world,pc.state.position,hour,0.0)
    pc.state.velocity += weather_at_point(pc.state.position).wind
if let v = env("AEGEAN_WIND"):
    w = split(v, " ")
    wind_now.speed = to_float(w[0]) ?? 6.0

# AEGEAN_AIRFIELD=stand|fuel|runway: aboard at the nearest airfield, on its apron stand, at its
# fuel point, or at the strip's southern threshold heading down it (a landplane on its wheels; captures and checks)
if let v = env("AEGEAN_AIRFIELD"):
    was = pc
    pc = landplane_at_airfield(pc.kind, pc.model, pc.state.position, v)
    pc.spec = was.spec; pc.state.fuel = was.state.fuel
    me.mode = .aboard

# AEGEAN_SWITCH=id: after the start, change to that aircraft as the pause menu's Aircraft page does
# (checks and captures of the switch: a landplane goes to an airfield, a boat to clear water)
if let v = env("AEGEAN_SWITCH"):
    k = Craft(clamp(to_int(v) ?? 0, 0, CRAFT_NAMES.len() - 1))
    change_craft(k, default_craft_model(k))
    me.mode = .aboard

# Reproducible river fixture; ordinary flight controls and the owned player craft.
if env("AEGEAN_RIVER") != none or env("AEGEAN_CANAL")!=none:
    a=RIVER_NODES[85];b=RIVER_NODES[86]
    if env("AEGEAN_CANAL")!=none:a=RIVER_NODES[CANAL_BEGIN+22];b=RIVER_NODES[CANAL_BEGIN+23]
    h=atan2(f64(b.x-a.x),-f64(b.y-a.y))
    pc.state=water_start(pc.spec,vec3(a.x,a.z,a.y),h)
    pc.throttle=0.0;pc.aim_heading=h;pc.placed=false
    me.mode=.aboard
# AEGEAN_LAKE=k: the same, at the start of settlement lake k's clear takeoff run.
if let v=env("AEGEAN_LAKE"):
    lake=SETTLEMENT_LAKES[clamp(to_int(v) ?? 0,0,SETTLEMENT_LAKES.len()-1)]
    h=atan2(f64(lake.axis.x),-f64(lake.axis.y));at=lake.center-lake.axis*720.0
    pc.state=water_start(pc.spec,vec3(at.x,f32(lake.level),at.y),h)
    pc.throttle=0.0;pc.aim_heading=h;pc.placed=false
    me.mode=.aboard
# AEGEAN_OLD_SHADOWS=1: the aircraft's shadows as they were (rectangles on the sea, flattened meshes on
# land), for comparisons with src/craft_shadow.jo's
craft_shadow_old=env("AEGEAN_OLD_SHADOWS")!=none
# AEGEAN_CAPTURE_TAKEOFF=1 (captures only): at rest on the water off the home harbour, heading out
# to sea, and the production take-off autopilot flies the player's aircraft off the water and up.
# AEGEAN_CAPTURE_TAKEOFF=pad: placed the same, flown by the player's controls (a gamepad's take-off
# scripted with SLOPPY_INPUT's pad items: 30:rt=1 200:lstick=0x0.6 ...)
capture_takeoff_pad=env("AEGEAN_CAPTURE_TAKEOFF")=="pad"
capture_takeoff=env("AEGEAN_CAPTURE_TAKEOFF")!=none and not capture_takeoff_pad
capture_takeoff_worn=env("AEGEAN_CAPTURE_TAKEOFF")=="worn"
# AEGEAN_CAPTURE_TAKEOFF=mouse: flown by the player's own mouse steering instead (flight.jo `steer`),
# the aim as tools/type_survey.jo holds it: on the horizon, four degrees up near flying speed on the
# wheels (the nose held at six degrees on the water, as src/pilot.jo's touch law), eight once off
capture_takeoff_mouse=env("AEGEAN_CAPTURE_TAKEOFF")=="mouse"
# AEGEAN_CAPTURE_CIRCUIT=1 (captures only, a landplane): from the aerodrome's visitors' stand the
# player's aircraft is taxied out, flown off the strip, once round a short circuit, landed, rolled out
# and taxied back to its stand, as the air arm's sorties go (air_arm.jo), on the player's own steering
capture_circuit_on=env("AEGEAN_CAPTURE_CIRCUIT")!=none
capture_circuit=ArmPilot(-1,-1,0,AIRFIELD_VISITOR_STAND,0,CraftState(),laps=0)
capture_mouse_heading = -1000.0    # (the heading she starts on, held down the strip and away)
capture_mouse_controls = (f: Flyer) -> Controls:
    global capture_mouse_heading
    st = f.state
    v = true_speed(f.spec, f64(length(st.velocity)))
    nose = asin(clamp(f64(forward(st).y), -1.0, 1.0))
    if capture_mouse_heading < -100.0: capture_mouse_heading = heading(st)
    h = capture_mouse_heading
    if st.on_water:
        c = Controls(throttle = 1.0, assist = 0.0)
        c.pitch = if v < f.spec.stall_speed * 0.85: 0.0 else: clamp((0.1 - nose) * 3.0, -1.0, 1.0)
        c.yaw = clamp(angle_delta(h, heading(st)) * 2.5, -1.0, 1.0)
        return c
    climb = if st.on_ground: (if v > f.spec.stall_speed * 0.85: 0.07 else: 0.0) else: 0.14
    c = steer(f.spec, st, vec3(f32(sin(h) * cos(climb)), f32(sin(climb)), f32(-cos(h) * cos(climb))))
    c.throttle = 1.0
    c
flying_serviced=env("AEGEAN_FLYING")!=none and env("AEGEAN_WEAR")==none
capture_takeoff_plan=FlightPlan()
# AEGEAN_CAPTURE_TAXI=s (with AEGEAN_CAPTURE_TAKEOFF=1): taxi out at the autopilot's taxiing pace
# for s seconds first, then the take-off run (a clip of dolphins racing a taxiing aircraft)
capture_taxi_until=to_float(env("AEGEAN_CAPTURE_TAXI") ?? "0") ?? 0.0
if capture_takeoff and env("AEGEAN_LAKE")!=none:
    # (with AEGEAN_LAKE: from the start of that lake's clear run, along it)
    h=pc.aim_heading;f=forward(pc.state);out=normalize(vec3(f.x,0,f.z));at=pc.state.position
    capture_takeoff_plan=FlightPlan(target=at+out*30000.0,taxi_target=at+out*30100.0,takeoff_heading=h,altitude=250.0)
else if (capture_takeoff or capture_takeoff_pad) and env("AEGEAN_AIRFIELD")==none:
    h=atan2(f64(home.out.x),-f64(home.out.y));out=vec3(home.out.x,0,home.out.y)
    at=home.docks[0]+out*300.0
    pc.state=water_start(pc.spec,vec3(at.x,0,at.z),h)
    pc.throttle=0.0;pc.aim_heading=h;pc.placed=false
    capture_takeoff_plan=FlightPlan(target=at+out*30000.0,taxi_target=at+out*30100.0,takeoff_heading=h,altitude=250.0)
    me.mode=.aboard
# AEGEAN_CAPTURE_LOW_PASS=h (captures only, with AEGEAN_FLYING): the production autopilot cruises the
# player's aircraft on at that height, a low pass held for a clip (the aircraft shadows' film cue)
if let lp=env("AEGEAN_CAPTURE_LOW_PASS"):
    capture_takeoff=true
    hd=heading(pc.state);at=pc.state.position
    capture_takeoff_plan=FlightPlan(target=at+heading_vector(hd)*f32(40000.0),taxi_target=at+heading_vector(hd)*f32(40100.0),takeoff_heading=hd,altitude=to_float(lp) ?? 6.0,phase=.cruise,initialized=true,approach_heading=hd,approach_distance=1800.0,clearance_altitude=to_float(lp) ?? 6.0)
# AEGEAN_CAPTURE_TAKEOFF=land (captures only): on short final 1.5 km out and 25 m up, heading out to sea, and
# the production autopilot lands the player's aircraft on the water off the home harbour.
capture_landing=env("AEGEAN_CAPTURE_TAKEOFF")=="land"
if capture_landing:
    h=atan2(f64(home.out.x),-f64(home.out.y));out=vec3(home.out.x,0,home.out.y)
    touch=home.docks[0]+out*1300.0
    pc.state=water_start(pc.spec,vec3(touch.x,0,touch.z)-out*1500.0,h)
    pc.state.position.y+=25.0;pc.state.on_water=false;pc.state.water_age=1.0
    pc.state.velocity=out*f32(pc.spec.stall_speed*1.35*pure_k(pc.spec))
    pc.state.precise=world_point(pc.state.position);pc.state.published=pc.state.position;pc.state.precise_ready=true
    pc.throttle=0.3;pc.aim_heading=h;pc.placed=false
    capture_takeoff_plan=FlightPlan(target=touch,taxi_target=touch+out*400.0,takeoff_heading=h,landing_heading=h,altitude=60.0,phase=.land)
    me.mode=.aboard

# ---------------- townsfolk wandering (until the world's people walk here themselves) ----------------

struct Walker:
    fig: Figure
    town: int
    pos: vec3
    target: vec3
    yaw: f64
    phase: f64
    wait: f64
    speed: f64

walkers: Walker[]
seed_random(5)
loop ti in 0..towns.len():
    tw = towns[ti]
    if tw.houses.len() < 3: continue
    n = min(6, 1 + tw.houses.len() / 12)
    loop k in 0..n:
        hp = tw.houses[random_int(0, tw.houses.len() - 1)]
        front=hp.xz+tw.out*9.0+vec2(-tw.out.y,tw.out.x)*f32(k)*0.8
        p=vec3(front.x,f32(walk_height(towns,front.x,front.y)),front.y)
        p=walk_step(towns,p,vec2(0,0))
        walkers.push(Walker(build_outfit_figure(walker_outfit(ti * 100 + k, 24 + (ti * 13 + k * 17) % 50), ti * 100 + k, age = 24 + (ti * 13 + k * 17) % 50), ti, p, p, random(0.0, TAU), 0.0, random(0.0, 5.0), random(1.0, 1.5)))

initial_walkers=walkers

_pick_target = (w: Walker) -> vec3:
    tw = towns[w.town]
    if random() < 0.4 and tw.quays.len() > 0:
        q = tw.quays[random_int(0, tw.quays.len() - 1)]
        p = q.a + (q.b - q.a) * f32(random(0.15, 0.95))
        return vec3(p.x, 0, p.y)
    hp = tw.houses[random_int(0, tw.houses.len() - 1)]
    vec3(hp.x + f32(random(-6.0, 6.0)), 0, hp.z + f32(random(-6.0, 6.0)))

update_walkers = (dt: f64):
    loop mut w in walkers:
        if length(w.pos - me.pos) > 900.0: continue
        if w.wait > 0.0:
            w.wait -= dt
            if w.wait <= 0.0: w.target = _pick_target(w)
            continue
        d = vec2(w.target.x - w.pos.x, w.target.z - w.pos.z)
        l = f64(length(d))
        if l < 1.0:
            w.wait = random(2.0, 12.0)
            continue
        dir = d / f32(l)
        w.yaw = approach_angle(w.yaw, atan2(f64(dir.x), f64(dir.y)), 6.0, dt)
        np = walk_step(towns, w.pos, vec2(f32(sin(w.yaw)), f32(cos(w.yaw))) * f32(w.speed * dt))
        if np == w.pos:
            w.wait = random(0.5, 3.0)            # stuck: pause, then go somewhere else
        w.pos = np
        w.phase += dt * w.speed * 5.5

draw_local_walker = (fig:Figure,id:int,pos:vec3,yaw:f64,phase:f64,stride:f64,L:Light,now:f64):
    shown=walk_presentation(WalkSubject(id,world_point(pos),yaw,0.0,phase=phase))
    draw_figure(fig,world_vec(shown.point),shown.yaw,shown.phase,if shown.active:0.8*shown.pace else:stride,L,now,offset=world_residual(shown.point),shoulder=shown.shoulder)

update_walk_around = (dt:f64):
    global actor_render_offsets
    if me.mode!=.walking or swim.active or stay.active or gaze.active:
        clear_walk_presentations()
        return
    observer=walker_point
    pilot=WalkSubject(WALK_PILOT,observer,me.yaw,player_stride()*2.4)
    people=[pilot]
    loop k in 0..folks.len():
        f=folks[k]
        if f.person in walk_presentations:actor_render_offsets[f.person]=world_local(f.precise,living_world.people[f.person].pose.pos)
        if not f.shown or f.cycling:continue
        if (k==company.who and company.stage!=.none) or (k==ride.who and ride.stage!=.none) or (f.person==rider.person and rider.stage!=.none):continue
        walk_offer(people,folk_walk_subject(f),observer)
    loop k in 0..walkers.len():
        w=walkers[k]
        walk_offer(people,WalkSubject(WALK_OTHER-3*k,world_point(w.pos),w.yaw,if w.wait>0.0:0.0 else:w.speed,phase=w.phase),observer)
    if company.stage==.coming or company.stage==.leaving:
        walk_offer(people,WalkSubject(WALK_COMPANY,world_point(company.pos),company.yaw,1.35,phase=company.phase),observer)
    if ride.stage==.walking:
        walk_offer(people,WalkSubject(WALK_RIDE,world_point(ride.pos),ride.yaw,1.35,phase=ride.phase),observer)
    if rider.stage==.walking and not tender_way_on:
        walk_offer(people,WalkSubject(WALK_RESCUED,world_point(rider.pos),rider.yaw,1.35,phase=rider.phase),observer)
    if waiter.ready and leisure.sitting!="":
        walk_offer(people,server_walk_subject(waiter,WALK_SERVER),observer)
    if clear_waiter.ready and left_key!="" and left_key!=leisure.sitting:
        walk_offer(people,server_walk_subject(clear_waiter,WALK_CLEAR_SERVER),observer)
    ambient_walk_subjects(people,observer,t,hour)
    life_view.child_walk_subjects(people,living_world,life_meshes,observer,t)
    walk_update_presentations(towns,people,pilot,dt)
    # Carried objects follow exactly the position used for the drawn resident.
    loop id,shown in walk_presentations:
        if id>=0:actor_render_offsets[id]=world_local(shown.point,living_world.people[id].pose.pos)

# ---------------- update ----------------

# by one's own aircraft, at rest on the water or moored
# the wind as a velocity (for cloth)
wind_now_vec = () -> vec3: vec3(wind_now.dir.x, 0, wind_now.dir.y) * f32(wind_now.speed)

# ---------------- wildlife (src/wildlife.jo): geese, gulls, goats and sheep about the camera ----------------
wildlife = Wildlife()
dolphins = Dolphins()
wild_dolphin_hold = env("AEGEAN_WILD_DOLPHIN_HOLD") != none
wild_trace = env("AEGEAN_WILD_TRACE") != none
wild_env = () -> WildEnv:
    WildEnv(ground = (x: f64, z: f64) -> f64: surface_height(x, z), water = wild_world_water,
        built = (x: f64, z: f64) -> bool: geography_enabled and settlement_registry.settlement_urban(vec2(f32(x), f32(z))),
        wind = wind_now_vec(), hour = hour, day = lt.day_index(living_world.minute))
# what they keep away from: the player's aircraft or the player on foot, and the other aircraft near
wild_threats = () -> WildThreat[]:
    out: WildThreat[]
    if me.mode == .aboard: out.push(WildThreat(pc.state.position, pc.state.velocity, true))
    else if me.mode == .walking: out.push(WildThreat(me.pos, vec3(0, 0, 0), false))
    cam = scene_camera()
    loop tr in all_air_traffic:
        if tr.visible and length(tr.state.position - cam) < 2000.0: out.push(WildThreat(tr.state.position, tr.state.velocity, true))
    out
# AEGEAN_WILD_RAFT="x z" (or "ahead d s": d metres ahead of the aircraft's start and s to its
# right): a raft of geese on the water there (captures of a raft, and of one put up by a taxi)
if let v = env("AEGEAN_WILD_RAFT"):
    w = split(v, " ")
    at = vec2(0, 0)
    if w.len() >= 3 and w[0] == "ahead":
        f = forward(pc.state); fw = normalize(vec2(f.x, f.z))
        at = pc.state.position.xz + fw * f32(to_float(w[1]) ?? 150.0) + vec2(-fw.y, fw.x) * f32(to_float(w[2]) ?? 0.0)
    else if w.len() >= 2: at = vec2(f32(to_float(w[0]) ?? 0.0), f32(to_float(w[1]) ?? 0.0))
    if let site = wild_raft_at(f64(at.x), f64(at.y), wild_env()): wildlife.extra.push(site)
    else: print("AEGEAN_WILD_RAFT: no water deep enough at {at.x:.1f} {at.y:.1f}")
# AEGEAN_WILD_WATCH="distance height bearing" (with AEGEAN_WILD_RAFT): whatever the player is doing,
# the view is from a fixed point that far from the raft given, turned to follow its geese (a clip
# of a raft put up by a taxiing aircraft)
wild_watch: vec3? = none
if let v = env("AEGEAN_WILD_WATCH"):
    w = split(v, " ")
    if w.len() >= 3 and wildlife.extra.len() > 0:
        # (the bearing from the aircraft's heading at the start: 0 ahead of the raft, looking back)
        c = wildlife.extra[0].at; d = to_float(w[0]) ?? 20.0; b = to_float(w[2]) ?? 0.0
        f = forward(pc.state); fw = normalize(vec2(f.x, f.z)); right = vec2(-fw.y, fw.x)
        p = c.xz + fw * f32(cos(b) * d) + right * f32(sin(b) * d)
        wild_watch = vec3(p.x, c.y + f32(to_float(w[1]) ?? 1.5), p.y)
wild_watch_target = () -> vec3:
    if wildlife.extra.len() == 0: return vec3(0, 0, 0)
    loop r in wildlife.rafts:
        if r.site.key == wildlife.extra[0].key:
            c = vec3(0, 0, 0)
            loop g in r.geese: c += g.pos
            return c / f32(max(1, r.geese.len())) + vec3(0, 0.4, 0)
    wildlife.extra[0].at + vec3(0, 0.4, 0)
# AEGEAN_WILD_CHASE="distance height": the view kept beside and behind one of the harbour's gulls
# in the air, unsmoothed, to see it bank, glide and beat (captures)
wild_chase = env("AEGEAN_WILD_CHASE")
wild_chased = -1
wild_chase_view = () -> (vec3, vec3)?:
    global wild_chased
    if wild_chase == none: return none
    w = split(wild_chase!, " ")
    d = to_float(w[0]) ?? 6.0; h = if w.len() > 1: to_float(w[1]) ?? 1.0 else: 1.0
    loop c in wildlife.colonies:
        if c.boat >= 0: continue
        if wild_chased < 0 or wild_chased >= c.gulls.len() or c.gulls[wild_chased].act == .perch:
            wild_chased = -1
            loop k in 0..c.gulls.len():
                if wild_chased < 0 and c.gulls[k].act == .fly: wild_chased = k
        if wild_chased < 0: return none
        g = c.gulls[wild_chased]
        f = vec3(f32(sin(g.yaw)), 0, f32(cos(g.yaw))); right = vec3(f.z, 0, -f.x)
        return (g.pos - f * f32(d * 0.75) + right * f32(d * 0.66) + vec3(0, f32(h), 0), g.pos)
    none
# AEGEAN_WILD_POD="ahead d s" (or "x z"): a pod of dolphins in the water there, every day (captures;
# placed on the first frame, from where the aircraft is by then)
wild_pod_spec = env("AEGEAN_WILD_POD")
wild_pod_place = ():
    global wild_pod_spec
    if wild_pod_spec == none: return
    v = wild_pod_spec!
    wild_pod_spec = none
    w = split(v, " ")
    at = vec2(0, 0); out = vec2(1, 0)
    f = forward(pc.state); fw = normalize(vec2(f.x, f.z))
    if w.len() >= 3 and w[0] == "ahead":
        at = pc.state.position.xz + fw * f32(to_float(w[1]) ?? 150.0) + vec2(-fw.y, fw.x) * f32(to_float(w[2]) ?? 0.0)
        out = fw
    else if w.len() >= 2: at = vec2(f32(to_float(w[0]) ?? 0.0), f32(to_float(w[1]) ?? 0.0))
    dolphins.extra.push(pod_at(f64(at.x), f64(at.y), out))
    dolphins.scanned = vec2(1.0e9, 1.0e9)
# AEGEAN_WILD_LOOK="raft|gulls|herd distance height bearing": the free camera kept on the nearest
# raft, colony or herd from that far, that high, from that bearing (radians; captures)
wild_look = env("AEGEAN_WILD_LOOK")
# AEGEAN_WILD_PORTRAIT="greylag|drake|duck|coot|gosling|gull|goat|sheep distance height bearing":
# the view held, unsmoothed, on one animal of that kind, from a bearing taken from its own heading
# (0 in front of it, 1.57 its side, 3.14 behind; captures and turnarounds)
wild_portrait = env("AEGEAN_WILD_PORTRAIT")
wild_portrait_view = () -> (vec3, vec3)?:
    if wild_portrait == none: return none
    w = split(wild_portrait!, " ")
    if w.len() < 4: return none
    at = vec3(0, 0, 0); yaw = 0.0; lift = 0.25; found = false
    kinds = ["greylag", "drake", "duck", "coot"]
    loop r in wildlife.rafts:
        loop g in r.geese:
            if found: break
            want = if w[0] == "gosling": g.young else: not g.young and g.kind < kinds.len() and kinds[g.kind] == w[0]
            if want and g.act != .fly and g.act != .run:
                at = g.pos; yaw = g.yaw; found = true
                lift = 0.22 * FOWL_SIZE[g.kind]
    if w[0] == "dolphin":
        # (the held one, or the one nearest the surface, so it is seen)
        best = -100.0
        loop p in dolphins.pods:
            loop dol in p.dolphins:
                if f64(dol.pos.y) > best: best = f64(dol.pos.y); at = vec3(dol.pos.x, dol.pos.y + f32(wild_swell(f64(dol.pos.x), f64(dol.pos.z), t)), dol.pos.z); yaw = atan2(f64(dol.vel.x), f64(dol.vel.z)); found = true; lift = 0.0
            if wild_dolphin_hold: break
    if w[0] == "gull":
        loop c in wildlife.colonies:
            loop g in c.gulls:
                if not found and g.act == .perch: at = g.pos; yaw = g.yaw; found = true; lift = 0.25
    if w[0] == "goat" or w[0] == "sheep":
        loop h in wildlife.herds:
            if (h.site.species == 1) != (w[0] == "sheep"): continue
            # (one of the commonest coat: a white sheep, a brown goat)
            loop e in h.beasts:
                if not found and e.coat == 0 and e.act != .lie: at = e.pos; yaw = e.yaw; found = true; lift = 0.6
    if not found: return none
    d = to_float(w[1]) ?? 3.0; hgt = to_float(w[2]) ?? 0.5; b = yaw + (to_float(w[3]) ?? 1.57)
    target = at + vec3(0, f32(lift), 0)
    # (from the first bearing round from b whose eye is above the ground and sees the animal
    # past the hill between: a far view of a herd on a slope)
    eye = target
    loop k in 0..16:
        bb = b + f64((k + 1) / 2) * (if k % 2 == 0: 1.0 else: -1.0) * TAU / 16.0
        eye = target + vec3(f32(sin(bb) * d), f32(hgt), f32(cos(bb) * d))
        ground = surface_height(f64(eye.x), f64(eye.z)) + 1.6
        if f64(eye.y) < ground: eye.y = f32(ground)
        clear = true
        loop j in 1..12:
            p = eye + (target - eye) * f32(f64(j) / 12.0)
            if surface_height(f64(p.x), f64(p.z)) > f64(p.y) - 0.3 and j < 11: clear = false
        if clear: break
    # (never under the sea's swell, looking at something swimming)
    eye.y = max(eye.y, f32(wild_swell(f64(eye.x), f64(eye.z), t) + 0.8))
    (eye, target)
# (the portrait's field of view: AEGEAN_WILD_FOV, degrees, 40 by default; narrow for far views)
wild_portrait_fov = to_float(env("AEGEAN_WILD_FOV") ?? "40") ?? 40.0
# AEGEAN_WILD_RACECAM="side ahead up": the view held on the player's aircraft from beside it (side
# metres to its right, ahead metres forward, up metres up), looking across at the water just off
# its floats on that side, where a racing pod swims (captures of dolphins racing a taxiing aircraft)
wild_racecam = env("AEGEAN_WILD_RACECAM")
wild_racecam_view = () -> (vec3, vec3)?:
    if wild_racecam == none: return none
    w = split(wild_racecam!, " ")
    if w.len() < 3: return none
    f = forward(pc.state); fw = normalize(vec3(f.x, 0, f.z)); right = vec3(-fw.z, 0, fw.x)
    side = to_float(w[0]) ?? 18.0
    at = pc.state.position * vec3(1, 0, 1) + vec3(0, 0.6, 0)
    eye = at + right * f32(side) + fw * f32(to_float(w[1]) ?? 8.0) + vec3(0, f32(to_float(w[2]) ?? 2.5), 0)
    (eye, at + right * f32(side * 0.3) - fw * 2.0)
# AEGEAN_WILD_POSE="swim|upend|preen|rest|alert": every bird of every raft held at that (captures)
wild_pose = env("AEGEAN_WILD_POSE") ?? ""
wild_pose_step = ():
    if wild_pose == "": return
    loop k in 0..wildlife.rafts.len():
        loop j in 0..wildlife.rafts[k].geese.len():
            g = wildlife.rafts[k].geese[j]
            if g.young or g.act == .fly or g.act == .run: continue
            match wild_pose:
                "upend": g.act = if g.kind == FOWL_COOT: GooseAct.dive else: GooseAct.upend
                "preen": g.act = .preen
                "rest": g.act = .rest
                _: g.act = .swim
            g.timer = 5.0
            wildlife.rafts[k].geese[j] = g
        if wild_pose == "alert": wildlife.rafts[k].alarm = 1; wildlife.rafts[k].alarm_t = 5.0; wildlife.rafts[k].away = vec2(1, 0)
wild_look_step = ():
    if wild_look == none or me.mode != .free: return
    w = split(wild_look!, " ")
    if w.len() < 4: return
    pts: vec3[]
    if w[0] == "raft" and wildlife.rafts.len() > 0:
        loop g in wildlife.rafts[0].geese: pts.push(g.pos)
    else if w[0] == "gulls":
        loop c in wildlife.colonies:
            if c.boat >= 0 or pts.len() > 0: continue
            # (the perched gull with the most perched about it, and those)
            best = -1; most = 0
            loop k in 0..c.gulls.len():
                if c.gulls[k].act != .perch: continue
                n = 0
                loop g in c.gulls:
                    if g.act == .perch and length(g.pos - c.gulls[k].pos) < 20.0: n += 1
                if n > most: most = n; best = k
            if best >= 0:
                loop g in c.gulls:
                    if g.act == .perch and length(g.pos - c.gulls[best].pos) < 20.0: pts.push(g.pos)
            if pts.len() == 0: pts.push(c.site.at)
    else if w[0] == "upend" or w[0] == "duck":
        # (the nearest bird feeding tail up: any, or a mallard)
        loop r in wildlife.rafts:
            loop g in r.geese:
                if pts.len() == 0 and g.tip > 0.8 and (w[0] == "upend" or g.kind == FOWL_DRAKE or g.kind == FOWL_DUCK): pts.push(g.pos)
    else if w[0] == "hauling":
        # (the gulls about a fishing boat)
        loop c in wildlife.colonies:
            if c.boat >= 0 and pts.len() == 0:
                loop g in c.gulls: pts.push(g.pos)
    else if w[0] == "pod":
        # (a placed pod if there is one, else the first)
        pick = -1
        loop k in 0..dolphins.pods.len():
            if pick < 0 or dolphins.pods[k].site.key >= 7900000: pick = k
        if pick >= 0:
            loop dol in dolphins.pods[pick].dolphins: pts.push(vec3(dol.pos.x, 0, dol.pos.z))
    else if w[0] == "flying":
        loop c in wildlife.colonies:
            if c.boat >= 0: continue
            loop g in c.gulls:
                if g.act == .fly and pts.len() == 0: pts.push(g.pos)
    else if w[0] == "herd" and wildlife.herds.len() > 0:
        loop e in wildlife.herds[0].beasts: pts.push(e.pos)
    if pts.len() == 0: return
    c = vec3(0, 0, 0)
    loop p in pts: c += p
    c = c / f32(pts.len())
    d = to_float(w[1]) ?? 12.0; hgt = to_float(w[2]) ?? 1.5; b = to_float(w[3]) ?? 0.0
    # (gulls on a quay are seen from out on the water: the first bearing round from b that is)
    if w[0] == "gulls":
        loop k in 0..12:
            bb = b + f64(k) * TAU / 12.0
            if surface_height(f64(c.x) + sin(bb) * d, f64(c.z) + cos(bb) * d) < -1.0: b = bb; break
    free.pos = c + vec3(f32(sin(b) * d), f32(hgt), f32(cos(b) * d))
    to = c - free.pos
    free.yaw = atan2(-f64(to.x), -f64(to.z))
    free.pitch = atan2(f64(to.y), f64(length(to.xz)))

# A landplane standing still on its wheels, throttle closed: one may climb down (and back up).
landplane_parked = () -> bool: pc.spec.landplane and pc.state.on_ground and not pc.state.crashed and pc.throttle < 0.05 and length(pc.state.velocity) < 0.3

near_own_craft = () -> bool:
    d = f64(length(vec2(pc.state.position.x - me.pos.x, pc.state.position.z - me.pos.z)))
    d < 8.5 and (pc.state.moored or length(pc.state.velocity) < 1.0) and craft_in_reach()

# The aircraft within reach, not merely near: not from inside a building (the hotel's bar room),
# and nothing solid between the pilot and it (a wall, a house): along the line at chest height, no
# point inside what walking stops at.
craft_in_reach = () -> bool:
    if room_point_inside(hotel, me.pos): return false
    a = me.pos.xz; b = pc.state.position.xz
    l = f64(length(b - a))
    steps = max(1, int(l / 0.4))
    height = f64(me.pos.y) + 1.0
    loop k in 1..steps:
        u = f64(k) / f64(steps)
        if u * l < 0.5 or (1.0 - u) * l < 1.5: continue
        p = mix(a, b, f32(u))
        # (pushed out by more than a body's half-width: inside the solid itself, not just beside it)
        if f64(length(town_avoid_buildings(towns, p, height) - p)) > 0.36: return false
    true

rope: Rope
was_moored = false
talk_at_start = env("AEGEAN_TALK") != none
radio_card_until = -1.0             # (while the radio's card shows, after tuning)
radio_volume_card_until = -1.0      # (and while it shows the volume, after the knob turns)
radio_hit_rect: Rect? = none        # (where the radio was drawn last frame, in the cockpit)

# The radio's volume knob, turned by a drag on the radio (the mouse, free of the view, or a finger:
# up is louder), the wheel over it, [ and ], or the gamepad's Radio button held with the look
# stick. While it turns, the level is the knob's own; the options keep it when it stops.
struct RadioKnob:
    level = -1.0                    # (-1: not being turned; the options' level is the one)
    turning = 0                     # 0 still, 1 the mouse, 2 a finger, 3 the gamepad
    from = vec2(0, 0)
    start = 0.5
    moved = false
    idle = 0.0                      # (seconds since a key or the wheel last turned it)
radio_knob = RadioKnob()

# F9, the Radio button or a tap on the radio: on to the next station, and off after the last
radio_next_station = ():
    if cockpit_radio.muted:
        radio.radio_mute(cockpit_radio, false)
        radio.radio_seek(cockpit_radio, 1, living_world.minute)
    else:
        was = cockpit_radio.khz
        radio.radio_seek(cockpit_radio, 1, living_world.minute)
        if cockpit_radio.khz <= was: radio.radio_mute(cockpit_radio, true)

# the knob's level now: its own while it turns, else the one kept with the options
radio_knob_level = () -> f64: if radio_knob.level >= 0.0: radio_knob.level else: dbg.opts.radio_volume

# the knob turned to v (0..1): the card says so; the options keep it once it stops
radio_knob_set = (v: f64, now: f64):
    global radio_knob, radio_volume_card_until, radio_card_until
    radio_knob.level = clamp(v, 0.0, 1.0)
    radio_volume_card_until = now + 2.0
    radio_card_until = now + 2.0

# The knob, once a frame aboard (keys free): a drag that hardly moves is a tap (the next station).
radio_knob_step = (dt: f64, now: f64):
    global radio_knob, radio_card_until
    r = radio_hit_rect
    # (a drag the whole height of the radio, twice, turns it from off to the top)
    span = if r is Rect: max(r.h * 2.0, 80.0) else: 160.0
    if radio_knob.turning == 0:
        if r is Rect and not pad.on and not is_mouse_locked() and mouse_pressed(.left) and contains(r, mouse_pos()):
            radio_knob = RadioKnob(level = radio_knob_level(), turning = 1, from = mouse_pos(), start = radio_knob_level())
        else if let f = pad_finger_on(.f8):
            radio_knob = RadioKnob(level = radio_knob_level(), turning = 2, from = f, start = radio_knob_level())
        else if ctl_pressed(.f7):
            radio_knob = RadioKnob(level = radio_knob_level(), turning = 3, start = radio_knob_level())
    at: vec2? = none
    held = false
    if radio_knob.turning == 1:
        held = mouse_down(.left)
        at = mouse_pos()
    else if radio_knob.turning == 2:
        at = pad_finger_on(.f8)
        held = at != none
    else if radio_knob.turning == 3:
        held = ctl_down(.f7)
        look = ctl.radio_look
        if abs(f64(look.y)) > 0.15:
            radio_knob_set(radio_knob_level() - f64(look.y) * dt * 0.5, now)
            radio_knob.moved = true
        across = if look.x > 0.5: 1 else: if look.x < -0.5: -1 else: 0
        if across != 0:
            if radio.radio_hold_tune(cockpit_radio, across, dt) and cockpit_radio.muted: radio.radio_mute(cockpit_radio, false)
            radio_knob.moved = true
            radio_card_until = now + 2.5
    if radio_knob.turning == 1 or radio_knob.turning == 2:
        if let p = at:
            rise = f64(radio_knob.from.y - p.y)
            if abs(rise) > 6.0 or radio_knob.moved:
                if not radio_knob.moved: radio_knob.from = p          # (the drag starts where it was taken up)
                radio_knob.moved = true
                radio_knob_set(radio_knob.start + f64(radio_knob.from.y - p.y) / span, now)
    if radio_knob.turning != 0 and not held:
        if not radio_knob.moved:
            radio_next_station()
            radio_card_until = now + 2.5
        radio_knob.turning = 0
        radio_knob.idle = 0.0
    # the wheel over the radio, and [ ]
    step = 0.0
    if r is Rect and not is_mouse_locked() and contains(r, mouse_pos()): step += clamp(mouse_wheel(), -3.0, 3.0) * 0.05
    if key_repeat(.rbracket): step += 0.05
    if key_repeat(.lbracket): step -= 0.05
    if step != 0.0:
        radio_knob_set(radio_knob_level() + step, now)
        radio_knob.idle = 0.0
    # (kept once it has stopped a moment: not a save a frame while it turns)
    if radio_knob.turning == 0 and radio_knob.level >= 0.0:
        radio_knob.idle += dt
        if radio_knob.idle > 0.4:
            global dbg
            dbg.opts.radio_volume = radio_knob.level
            radio_knob.level = -1.0

# what the radio is on, for its card: the station near the dial, or the band between them
radio_label = () -> str:
    if t < radio_volume_card_until: return radio.radio_volume_label(radio_knob_level())
    if cockpit_radio.muted: return "Wireless off"
    loop st in cockpit_radio.stations:
        if abs(st.khz - cockpit_radio.khz) < 8.0: return "{st.name}   {int(cockpit_radio.khz)} kc"
    "{int(cockpit_radio.khz)} kc   static"
pad_talk = false                    # (a tap on someone near: talk to them)

# where on the ground (or the quay) a point on the screen falls, near the walker's height
ground_under = (p: vec2) -> vec3?:
    o, d = screen_ray(p)
    if f64(d.y) > -0.02: return none
    t = (f64(me.pos.y) - f64(o.y)) / f64(d.y)
    if t < 0.0 or t > 400.0: return none
    o + d * f32(t)
click_took_mouse = false            # (the left button's press that took the mouse, until let go)

# Cargo is saved living-world stock; the notebook only projects its current handling status.
notebook = load_notebook()

# what a job carries, in a few words
job_cargo = (id: int) -> str:
    j = living_world.jobs[id]
    if let e = errand_of(living_world, id):
        if e.kind != .nurse: return errand_label(e.kind)
    if j.purpose == .passenger: return living_world.people[j.passenger].name
    if j.cargo_mode == .sealed: return "the sealed bag"
    "the {living_world.goods[j.good].key}"

holding_cargo = () -> int: living_world.people[living_world.player].carrying

near_job_cargo = () -> int: cargo_view.nearest_cargo(living_world,living_world.player)

# The chart shows only what one's own paper maps cover: one sheet per edition owned.
owned_chart_sheets = () -> ChartSheet[]:
    sheets: ChartSheet[]
    seen: {str: bool}
    loop c in living.owned_maps(living_world,living_world.player):
        if seen.get(c.edition,false): continue
        seen[c.edition] = true
        if let m = living.map_description(living_world,c.edition):
            sheets.push(ChartSheet(c.id,m.id,m.title,m.bounds.west,m.bounds.north,m.bounds.east,m.bounds.south))
    sheets

# The aerodromes the chart shows: with sheets laid down, those the owned sheets print on their
# airfield layer, where each prints it; picking a place in the pause menu, every one where it is.
chart_fields = () -> ChartField[]:
    result: ChartField[]
    if chart_sheets == none:
        loop f in AIRFIELDS: result.push(ChartField(f.center, f.heading, f.name))
        return result
    seen: {str: bool}
    loop c in living.owned_maps(living_world,living_world.player):
        loop feature in living.map_features(living_world, c.edition, .airfields):
            if seen.get(feature.key, false): continue
            seen[feature.key] = true
            k = clamp(to_int(split(feature.key, ":")[1]) ?? 0, 0, AIRFIELDS.len() - 1)
            result.push(ChartField(feature.position.xz, AIRFIELDS[k].heading, feature.label))
    result

# a loose map lying within reach (-1: none)
near_map_find = () -> int:
    finds = living.nearby_map_finds(living_world,living_world.player)
    if finds.len() > 0: finds[0].id else: -1

map_title = (copy: int) -> str:
    if copy in living_world.maps.copies:
        if let m = living.map_description(living_world,living_world.maps.copies[copy].edition): return m.title
    "a map"

# Each map that comes into one's hands is named once, on a card.
known_maps: {int: bool}
loop c in living.owned_maps(living_world,living_world.player): known_maps[c.id] = true
map_card = ""
map_card_until = 0.0
notice_new_maps = ():
    global map_card, map_card_until
    fresh: int[]
    loop c in living.owned_maps(living_world,living_world.player):
        if known_maps.get(c.id,false): continue
        known_maps[c.id] = true
        fresh.push(c.id)
    if fresh.len() == 0: return
    map_card = (if fresh.len() == 1: "New map: {map_title(fresh[0])}" else: "{fresh.len()} new maps") + "      M  the chart"
    map_card_until = t + 6.0

# A cargo status put in the speaker's own mouth: "Eleni Vassiliou is fetching the medicine for
# the aircraft." from Eleni herself is "I'm fetching the medicine for your aircraft."
said_by = (name: str, line: str) -> str:
    if line.starts_with(name + " is "): return "I'm " + line[name.len() + 4..line.len()].replace("the aircraft", "your aircraft")
    line.replace("to the aircraft", "to your aircraft").replace("for the aircraft", "for your aircraft")

# Why a job could not be taken, in plain words (said at the board and by the sender alike).
job_refusal_words = (id: int) -> str:
    w = living_world
    me_ = w.player
    c = w.people[me_].craft
    dest = if id in w.jobs: living.place_name(w,w.jobs[id].destination) else: ""
    craft = CRAFT_NAMES[clamp(int(pc.kind),0,CRAFT_NAMES.len()-1)]
    match claims.claim_refusal(w,id,me_):
        "gone", "taken": "Someone else has already taken that one on."
        "lapsed": "It's too late for that one now."
        "away": "You'd need to be here, with your {craft} at the dock."
        "hands": "Your hands are full already."
        "craft": "You'd need an aircraft for that."
        "tired": "You're worn out. Rest first, then fly."
        "hold":
            loop other in w.aircraft[c].job_manifests:
                if other in w.jobs and w.jobs[other].state == .claimed:
                    return "Your hold is already promised: {job_cargo(other)} for {living.place_name(w,w.jobs[other].destination)}. Deliver that first."
            "Your hold is already promised. Deliver that first."
        "weight": "That's more than your {craft} can lift, with what's aboard."
        "seats": "There's no seat free in your {craft}."
        "closed": "The harbour at {dest} is closed."
        "repairs": "Your {craft} needs repairs before a trip like that."
        "weather": "Not in this weather. Wait for it to ease."
        "fuel": "You haven't the fuel to reach {dest}. Fill up first."
        "charter": "There isn't the fuel here to fly that charter."
        "late": "You couldn't get it to {dest} in time."
        _: "That one can't be done just now."

# The same published handling terms can be agreed at the board or with the sender.
agree_cargo_job = (id: int, choice: lt.CarriageChoice) -> str:
    j = living_world.jobs[id]
    if j.delivery_mode == .aircraft and not pc.state.moored: return "Bring your aircraft alongside a dock here first."
    if not living.take_job(living_world,id,living_world.player,choice): return job_refusal_words(id)
    my_jobs[id] = lt.JobState.claimed
    # (a new pilot's first job: the sender gives them the day for it, finding the place included)
    first = welcome_active(living_world) and not welcome_jobs(living_world).0
    if first and living_world.jobs[id].due_minute < living_world.minute + 720:
        living_world.jobs[id].due_minute = living_world.minute + 720
        living_world.jobs[id].expire_minute = max(living_world.jobs[id].expire_minute, living_world.minute + 720 + 120)
        say_toast("{split(living_world.people[j.poster].name, " ")[0]}: Your first, is it? Take the day over it.")
    rcv = living_world.people[portage.cargo_receiver(living_world,id)].name
    status = portage.cargo_status(living_world,id)
    pin_notice(notebook,id,j.poster,"{job_cargo(id)} to {rcv}","By {clock_text(living_world,j.due_minute)}; {phoenix_text(living_world.jobs[id].reward_cents)}. From {living_world.people[j.poster].name}.",clock_text(living_world,living_world.minute))
    log_note(notebook,"Agreed to {if j.delivery_mode == .foot: "carry" else: "fly"} {job_cargo(id)} for {rcv}. {status}",clock_text(living_world,living_world.minute))
    status

# F has one meaning per press: pick up, set down/load, or (with empty hands) board.
cargo_interact = () -> bool:
    actor = living_world.player
    held = holding_cargo()
    if held >= 0:
        c = living_world.cargo[held]
        aboard = false
        if c.job >= 0 and c.job in living_world.jobs:
            j = living_world.jobs[c.job]
            point = portage.cargo_loading_spot(living_world,living_world.people[actor].craft)
            aboard = j.delivery_mode == .aircraft and not j.loaded and point != none and length(me.pos-point!) < 4
        if c.job < 0:
            point = portage.cargo_loading_spot(living_world,living_world.people[actor].craft)
            aboard = point != none and length(me.pos-point!) < 4 and c.store != .aircraft
        if portage.cargo_put_down(living_world,actor,aboard):
            if c.job >= 0:
                if aboard: claims.load_job(living_world,c.job)
                if living_world.jobs[c.job].collected: living.deliver_job(living_world,c.job,actor)
            say_toast(if aboard: "Put {cargo_view.cargo_label(living_world,c)} into the hold" else: "Set down {cargo_view.cargo_label(living_world,c)}")
            log_note(notebook,if aboard: "Loaded {cargo_view.cargo_label(living_world,c)} into the aircraft." else: "Set down {cargo_view.cargo_label(living_world,c)} at {me.pos.x:.0}, {me.pos.z:.0}.",clock_text(living_world,living_world.minute))
        return true
    id = near_job_cargo()
    if id >= 0:
        fish_before_cargo()
        if portage.cargo_pick_up(living_world,actor,id): say_toast("Carrying {cargo_view.cargo_label(living_world,living_world.cargo[living_world.people[actor].carrying])}; F to put it down")
        else: say_toast("It cannot be picked up now: it is too heavy or someone is handling it")
        return true
    false

# guns, cloth, debugging
guns = Guns()
splashes: Splash[]
dust_ps = WorldParticles(gravity = vec3(0, -9.8, 0), drag = 1.2)
cloth_mesh: ClothMesh
streamer_lost_l: ClothMesh          # (a streamer gone with its lost part, left and right)
streamer_lost_r: ClothMesh
scarf_mesh: ClothMesh
dbg = Debug()
if startup_sloppy_no_audio == none: music_audition_prepare(dbg.music)
set_tweaks(dbg.tweaks)
dbg.opts = options
# AEGEAN_RADIO_VOLUME=0..1: the radio's volume knob set there (captures; kept with the options)
if let v = env("AEGEAN_RADIO_VOLUME"): dbg.opts.radio_volume = clamp(to_float(v) ?? dbg.opts.radio_volume, 0.0, 1.0)
# AEGEAN_COLOUR_VISION=standard|red_green|blue_yellow|monochrome: the Accessibility section's
# colours of the sides (captures; kept with the options, in the run's save folder)
if let v = env("AEGEAN_COLOUR_VISION"):
    loop k in 0..COLOUR_VISIONS.len():
        if str(COLOUR_VISIONS[k]) == v: dbg.opts.colour_vision = COLOUR_VISIONS[k]
# AEGEAN_CAPTURE_SIDES=rows: a sheet of every mark that shows a side, in that many rows over the view
# (src/side_samples.jo): the colour-vision presets checked against sky, cloud and sea
capture_sides = if let v = env("AEGEAN_CAPTURE_SIDES"): clamp(to_int(v) ?? 4, 1, 8) else: 0
sandbox_trace = env("AEGEAN_SANDBOX_TRACE") != none
# AEGEAN_SANDBOX="money,damage,fuel,aircraft,paint,ammunition" (or "all"): the Sandbox section's
# switches turned on (captures and probes; kept with the options too)
if let v = env("AEGEAN_SANDBOX"):
    loop word in split(v, ","):
        every = trim(word) == "all"
        if every or trim(word) == "paint": dbg.opts.sandbox.paint_anywhere = true
        if every or trim(word) == "aircraft": dbg.opts.sandbox.any_aircraft = true
        if every or trim(word) == "money": dbg.opts.sandbox.unlimited_money = true
        if every or trim(word) == "damage": dbg.opts.sandbox.no_damage = true
        if every or trim(word) == "fuel": dbg.opts.sandbox.no_fuel_use = true
        if every or trim(word) == "ammunition": dbg.opts.sandbox.endless_ammunition = true
# AEGEAN_LOOK="yaw pitch [cockpit]": captures of the mouse look (the Options page's "Mouse steers the
# aircraft" turned off, kept in the run's save folder as options are): the view turned that far
# (radians), in the cockpit if asked; outside, the orbit about the aircraft turned that far from behind
if let v = env("AEGEAN_LOOK"):
    w = split(v, " ")
    options.mouse_steers = false
    dbg.opts.mouse_steers = false
    pc.look_yaw = to_float(w[0]) ?? 0.0
    pc.look_pitch = if w.len() > 1: to_float(w[1]) ?? 0.0 else: 0.0
    if w.len() > 2 and w[2] == "cockpit": pc.cockpit_view = true
    else:
        # (outside, the mouse orbits the view about the aircraft instead: from behind, turned that far)
        ahead = quat_rotate(pc.state.orientation, vec3(0, 0, -1))
        pc.orbiting = true
        pc.orbit_yaw = atan2(-f64(ahead.x), f64(ahead.z)) + pc.look_yaw
        pc.orbit_pitch = clamp(pc.look_pitch, -1.35, 1.35)
        pc.orbit_dist = 22.0
        pc.look_yaw = 0.0; pc.look_pitch = 0.0

# AEGEAN_TWEAKS="pure,trim,energy,orbit,fdm2,fdm2npcs,fdmsb,fdm0,nofdm2npcs,fdm2fighters,aim,plainhits,wingvapour,windstudy" switches trials on
# from the start (aim: the aim assist on; plainhits: generous hits off)
if let tw = env("AEGEAN_TWEAKS"):
    loop name in split(tw, ","):
        match name:
            "pure": dbg.tweaks.pure_scale = true
            "trim": dbg.tweaks.auto_trim = true
            "energy": dbg.tweaks.skybarons_response = true
            "orbit": dbg.tweaks.orbit_camera = true
            "fdm2": dbg.tweaks.flight_model = 1
            "fdm2npcs": dbg.tweaks.fdm2_npcs = true
            "fdmsb": dbg.tweaks.flight_model = 2
            "fdm0": dbg.tweaks.flight_model = 0
            "fdm2fighters": dbg.tweaks.fdm2_fighters = true
            "nofdm2npcs": dbg.tweaks.fdm2_npcs = false
            "aim": dbg.tweaks.aim_assist = true
            "plainhits": dbg.tweaks.generous_hits = false
            "wingvapour": dbg.tweaks.wing_vapour = true
            "windstudy": dbg.tweaks.wind_study_grass = true
            "surf": dbg.tweaks.surf = true
            _: pass
    set_tweaks(dbg.tweaks)
# AEGEAN_FDM2="lift=1.35,slow=1.3,..." (the Flight v2 page's copied line) sets flight model v2's numbers
if let line = env("AEGEAN_FDM2"): dbg.fdm2 = fdm2_tuning_parse(line, dbg.fdm2)
wind_bias = 0.0
# AEGEAN_WIND_BIAS=m/s: the Tweaks page's wind slider from the start (captures of strong wind)
if let v = env("AEGEAN_WIND_BIAS"): wind_bias = to_float(v) ?? 0.0
set_touch_pad(touch_device() or env("AEGEAN_TOUCH") != none)
last_shots = 0
# (going into the water hard: how far under the aircraft is driven, and how fast, on a spring that
# brings it back up; drawn, not simulated)
plunge = 0.0
plunge_v = 0.0
slap_t = -1.0                       # (the last weak float slap that threw spray)
MUZZLES: vec3[] = [vec3(-2.7, 1.7, -1.3), vec3(2.7, 1.7, -1.3)]

# a new aircraft of another kind for the player, where the old one is (moored where it was moored)
change_craft = (kind: Craft, model: int):
    global pc, paint_dirty
    paint_dirty = true
    record = living_world.people[living_world.player].craft
    a = lt.AIRFRAMES[int(kind)]
    if craft_grams(living_world,record) > a.cargo_grams or living_world.aircraft[record].passengers.len() > a.seats:
        say_toast("Unload cargo and passengers before changing to this aircraft")
        return
    old = pc.state
    nf = make_flyer(kind, model, craft_models[model].contacts, old.position - vec3(0, f32(pc.spec.float_height), 0), heading(old))
    # (not in the air: a landplane goes to the nearest airfield's stand, never onto the water;
    # a seaplane switched in on land goes to the home harbour's free dock)
    grounded = old.moored or old.on_water or old.on_ground or old.beached or old.crashed
    moved = false
    if aircraft_profile(kind).landplane and grounded:
        nf = landplane_at_airfield(kind, model, old.position); moved = true
    else if pc.spec.landplane and grounded:
        nf = make_flyer(kind, model, craft_models[model].contacts, free_dock(home, others_at(), home.docks[0]) ?? home.docks[0], along_quay); moved = true
    if not old.moored and not moved:
        unmoor(nf.state)
        nf.state.position = old.position
        nf.state.velocity = old.velocity
        nf.state.orientation = old.orientation
        nf.state.on_water = old.on_water
        nf.state.water_age = old.water_age
        nf.throttle = pc.throttle
    # (the camera stays where it was: the new aircraft takes over the old one's)
    nf.cam_pos = pc.cam_pos; nf.look = pc.look; nf.look_v = pc.look_v; nf.cam_up = pc.cam_up; nf.roll = pc.roll
    nf.path = pc.path; nf.cam_e = pc.cam_e; nf.cam_ev = pc.cam_ev; nf.cam_lh = pc.cam_lh; nf.fov = pc.fov
    nf.prev_vel = pc.prev_vel; nf.acc_lp = pc.acc_lp; nf.prev_dir = pc.prev_dir
    nf.placed = pc.placed and not moved
    nf.spec.player = true
    nf.spec.fuel_capacity = f64(a.tank_ml)/1000.0
    nf.spec.fuel_burn = f64(a.burn_ml_sec)/1000.0
    nf.state.fuel = min(old.fuel,nf.spec.fuel_capacity)
    living_world.aircraft[record].kind = lt.Airframe(int(kind))
    living_world.aircraft[record].model_index = model
    living_world.aircraft[record].livery_index = DEFAULT_LIVERIES[int(kind)]
    # (the tank's change goes through the debugging ledger, so the world's goods still balance)
    debug_fuel_ml(record, int(nf.state.fuel*1000.0))
    living_world.aircraft[record].scene_extension = ""
    living_world.aircraft[record].scene_extension_tick = -1
    living_world.aircraft[record].revision += 1
    pc = nf
    # (too big for the dock it was at: out to the nearest clear buoy, or clear water; aboard)
    global buoys_at
    buoys_at = -1
    if offshore_only(kind): settle_big_craft(true)
    refresh_buoys()
    ci=combat_index(battle,record)
    if ci>=0:battle.actors[ci]=Combatant(record,living_world.player,0,pc.spec,pc.state,external=true,human=true,previous=pc.state.position,model=model)

# paused (or not): the pause menu is the debugging panel
set_paused = (on: bool):
    global paused, show_chart
    paused = on
    dbg.open = on
    if dbg.picking: show_chart = false
    dbg.picking = false
    # (the pause menu alone on the screen: the chart and the notebook close)
    if on: mouse_lock(false); show_chart = false; notebook.open = false

# the speed scale changed: every aircraft's spec made again for it (keeping its fuel figures), and
# the world's trips and traffic paced to it
apply_speed_scale = (k: f64):
    set_speed_scale(k)
    lt.scale_airframes(k)
    old = pc.spec
    pc.spec = craft_spec(pc.kind, craft_models[pc.model].contacts)
    pc.spec.player = true
    pc.spec.fuel_capacity = old.fuel_capacity
    pc.spec.fuel_burn = old.fuel_burn
    loop i in 0..traffic.len():
        o = traffic[i].spec
        traffic[i].spec = craft_spec(traffic[i].kind, craft_models[traffic[i].model].contacts)
        traffic[i].spec.fuel_capacity = o.fuel_capacity
        traffic[i].spec.fuel_burn = o.fuel_burn

# the debugging panel: how things are now, for it to show and change
# (copies handed over by the World page's map boxes: where each came from, to be put back there)
debug_maps_given: {int: (str, int)}
debug_view = () -> DebugView:
    v = DebugView()
    # (the World page's map boxes: every edition in the world, by title, ticked where he has a copy)
    if dbg.open and dbg.page == 3:
        have: {str: bool}
        loop c in living.owned_maps(living_world, living_world.player): have[c.edition] = true
        loop edition, m in living_world.maps.editions: v.maps.push(DebugMap(edition, m.title, have.get(edition, false)))
        v.maps.sort((a: DebugMap): a.title)
    v.craft = int(pc.kind)                # (the type, as the menu lists them; the model index differs past the first four)
    v.fuel = pc.state.fuel / max(pc.spec.fuel_capacity, 0.001)
    v.parts = [loop k in 0..pc.spec.parts.len(): part_health(pc.state.damage, pc.spec.parts[k].id)]
    c = living_world.people[living_world.player].craft
    if c >= 0:
        v.hull_wear = 1.0 - f64(living_world.aircraft[c].hull) / 1000.0
        v.engine_wear = 1.0 - f64(living_world.aircraft[c].engine) / 1000.0
    v.hour = hour
    v.wind = wind_bias
    v.wind_now = wind_now.speed
    v.phoenixes = player_cents() / 100
    v.speed_scale = speed_scale
    v.lift_scale = lift_scale
    v.bullet_scale = bullet_scale
    v.sea_rough = sea_rough
    game_page_view(v)
    v.paint = player_paint
    v.paint_shop = paint_shop_view()
    v.paint_name = LIVERY_NAMES[clamp(if paint_active(player_paint, int(pc.kind)) and player_paint.livery >= 0: player_paint.livery else: DEFAULT_LIVERIES[int(pc.kind)], 0, LIVERY_NAMES.len() - 1)]
    v.paint_support = paint_support_for(int(pc.kind))
    v.craft_name = CRAFT_NAMES[clamp(int(pc.kind), 0, CRAFT_NAMES.len() - 1)]
    v

# the debugging panel's fuel and money, entered in the living world's books (fuel made or spent,
# money brought in from or sent out of the world) so its conservation checks still hold
debug_fuel_ml = (c: int, ml: int):
    if c < 0: return
    cap = lt.AIRFRAMES[int(living_world.aircraft[c].kind)].tank_ml
    want = clamp(ml, 0, cap)
    d = want - living_world.aircraft[c].fuel_ml
    if d > 0: living_world.goods_ledger.created[int(lt.GoodKind.fuel)] += d
    else: living_world.goods_ledger.consumed[int(lt.GoodKind.fuel)] += -d
    living_world.aircraft[c].fuel_ml = want
    living_world.aircraft[c].revision += 1

debug_cents = (cents: int):
    a = living_world.people[living_world.player].account
    if a < 0: return
    want = max(0, cents)
    d = want - living_world.accounts[a].cents
    if d > 0: living_world.ledger.external_in_cents += d
    else: living_world.ledger.external_out_cents += -d
    living_world.accounts[a].cents = want

# put the aircraft in the air (or on the water, at 0 m) at x, z
debug_place = (x: f64, z: f64, alt: f64):
    h = heading(pc.state)
    unmoor(pc.state)
    if alt < 5.0:
        if surface_height(x, z) > 0.0:
            say_toast("That's land there: give it some altitude")
            return
        pc.state = water_start(pc.spec, vec3(f32(x), 0, f32(z)), h)
        pc.throttle = 0.0
    else:
        ground = max(surface_height(x, z), 0.0)
        pc.state.position = vec3(f32(x), f32(max(alt, ground + 40.0)), f32(z))
        pc.state.velocity = heading_vector(h) * f32(pc.spec.cruise_speed)
        pc.state.orientation = quat_euler(0, -h, 0)
        pc.state.angular_velocity = vec3(0, 0, 0)
        pc.state.on_water = false
        pc.state.water_age = 1.0
        pc.state.crashed = false
        pc.throttle = 0.8
    pc.aim_heading = h
    pc.aim_climb = 0.0
    pc.placed = false
    me.mode = .aboard

# Apply one complete replacement only after its builder succeeded. GPU assets/options survive;
# no old world identity, physics history, sound scheduler, UI reference or camera spring does.
active_scenario = ""
slip = SlipLaunch()                 # the canal takeoff's opening down the workshop's slipway
scenario_templates: {str: ScenarioState}
# (`given`: put that state in place instead of building one: the title's new game, the startup's
# own world kept aside while the title ran; its notebook stays the one already loaded)
load_scenario = (key: str, given: ScenarioState? = none) -> bool:
    global living_world,pc,me,battle,traffic,traffic_scene,folks,folk_sync_t,air_events,all_air_traffic,view_target,target_scan
    global vessels,vessel_bindings,vessel_view,vessel_mooring,combat_visual,air_visual,homeward
    global ui,ui_folk,ui_place,ui_line,ui_news,ui_turn,ui_job,my_jobs,toast,toast_until,notebook,battle_card,war_chart,presentation,ui_mission
    global t,hour,wind_bias,wind_now,follow,descent_camera,free,show_chart,chart_local
    global rope,was_moored,wakes,vapor_trails,pc_wing_vapour,guns,splashes,last_shots,plunge,plunge_v,launch,buoys_at,offshore,lighter,lighter_phase,swing_rate,sos
    global world_ambience,cockpit_radio,radio_bulletin,radio_card_until,talk_at_start,pad_talk,click_took_mouse
    global active_scenario,judge_camera,scenario_templates,walkers,judge_ready,dbg
    global leisure,leisure_spent,leisure_had,skip,slip,slip_cradle_z,combat_audio
    global fish,fish_throws,fish_rings,fish_landed_at,fish_bucket_beside
    load_started=time()
    reset_scene_moments()
    fresh=key=="start"
    if fresh:
        music_audition_stop(dbg.music)
        dbg=Debug(opts=dbg.opts)
        if startup_sloppy_no_audio == none: music_audition_prepare(dbg.music)
        apply_speed_scale(BASE_SPEED_SCALE);set_lift_scale(3.3);set_bullet_scale(7.0)
        set_sea_rough(1.0);set_drag_scale(1.0);set_tweaks(dbg.tweaks)
        set_near_boost(3.0);set_speed_mode(0);set_camera_rises(false)
    # A situation chooses the world and aircraft, never the user's flight calibration.
    # Cached specs depend on the selected speed scale, just like a normal aircraft change.
    side_size=clamp(to_int(env("AEGEAN_BATTLE_SIDE") ?? "8") ?? 8,2,64)
    cache_key=key+":"+to_text(speed_scale)+":"+to_text(side_size)
    next: ScenarioState
    if let state=given:next=state
    else:
        if fresh or not (cache_key in scenario_templates):
            loaded=build_scenario(key,towns,craft_models,side_size)
            if loaded==none:return false
            scenario_templates[cache_key]=loaded!
        next=scenario_templates[cache_key]
    detach_game_slot_context()
    seed_random(if fresh:5 else:1934);walkers=initial_walkers
    clear_walk_presentations()
    hush_audio(audio);hush_combat_audio(combat_audio);hush_battle_radio(battle_radio)
    audio.clock=0;audio.clock_cloth=0;audio.settled_at=0;audio.settled_load=1;audio.quiet=0.5;audio.next_gull=4;audio.flap_next=0;audio.flap_energy=1
    loop heard in hearing.heard:
        loop voice in [heard.near_v,heard.far_v,heard.near_r,heard.far_r]:
            if voice>=0:stop(voice)
    hearing.heard=[]
    life_audio.hush_life_audio(life_sound);life_sound.last_beat=-1
    ambience_hush(world_ambience.sound)
    saved_sound=world_ambience.sound
    saved_sound.pending=[];saved_sound.sources=[];saved_sound.last_time=-1;saved_sound.refresh=0
    world_ambience=AmbienceScene(sound=saved_sound)
    radio.radio_silence(cockpit_radio);cockpit_radio=radio.Radio()
    broadcast.radio_place_transmitters(cockpit_radio,height)
    radio_bulletin=broadcast.RadioBulletinCache();radio_card_until=-1
    global town_speech
    town_speech = TownSpeech()
    living_world=next.world;pc=next.flyer;battle=next.battle
    hush_homeward(homeward);homeward=HomewardView()
    band_publish(living_world, band_numbers(hotel), BAR_START, BAR_END, int(BAR_GAP * 60.0))
    if battle.ground.len()>0 and combat_audio.guns.len()>0:prepare_ground_audio(combat_audio)
    if next.slipway:slip=start_slip_launch(pc)
    else:slip=SlipLaunch();slip_cradle_z=SLIP_START
    traffic_scene=living_scene.SceneAdapter()
    traffic=make_living_traffic(living_world,craft_models)
    assign_pilot_liveries()
    bind_living_player(pc,living_world,traffic_scene)
    landplane_ashore()
    me=Player(mode=if next.mode==.aboard:Mode.aboard else:if next.mode==.free:Mode.free else:Mode.walking,pos=next.position,yaw=next.yaw)
    folks=[];sync_folk(folks,living_world,towns);folk_sync_t=0
    air_events=AirEvents();all_air_traffic=traffic;view_target=TargetView();target_scan=0
    vessels=next.vessels;vessel_bindings=VesselBindings();vessel_view=vessel_view_fresh(vessel_view);vessel_mooring=VesselMooring()
    cv=combat_visual
    combat_visual=CombatView(low=cv.low,low_parts=cv.low_parts,chute=cv.chute,hole=cv.hole,oil=cv.oil,pilot=cv.pilot,distant_pilot=cv.distant_pilot,
        trails=BattleTrails(mesh=cv.trails.mesh,shader=cv.trails.shader))
    av=air_visual
    air_visual=AirView(silhouette=av.silhouette,exhaust=BattleTrails(mesh=av.exhaust.mesh,shader=av.exhaust.shader))
    spray_ps.items.clear();spray_ps.billows.clear();spray_ps.emission_serial=0;smoke_ps.items.clear();dust_ps.items.clear()
    wakes=[loop k in 0..traffic.len()+1:WakeTrail()];vapor_trails=[Trail(),Trail()];pc_wing_vapour=WingVapour()
    guns=Guns();splashes=[];last_shots=0;plunge=0;plunge_v=0
    rope=Rope();was_moored=false
    launch=launches.LaunchRide();buoys_at= -1;offshore=none
    lighter=launches.LaunchRide();lighter_phase=0;swing_rate=0.0
    sos=HelpCall()
    ui=.none;ui_folk=-1;ui_place=-1;ui_line="";ui_news=0;ui_turn=lt.ConversationTurn();ui_job=-1;my_jobs={}
    if given==none:
        notebook=if fresh:Notebook() else:Notebook(storage_key="scenario-notebook:"+key)
        if fresh:save_notebook(notebook)
    toast="";toast_until=0;show_chart=false;chart_local=false
    battle_card=BattleCard();war_chart=WarChart();presentation=lt.PresentationState();ui_mission= -1
    set_pilot_mustache(1)
    # (another world: nothing of the last one's purse is held)
    global purse_hold
    purse_hold=PurseHold()
    leisure=LeisureState();leisure_spent=0;leisure_had=[];skip=TimeSkip();bar_music_stop(bar_music)
    fish=FishHold();fish_throws=[];fish_rings=[]
    talk_at_start=false;pad_talk=false;click_took_mouse=true
    t=0;hour=next.hour;wind_bias=0;wind_now=Wind()
    follow=follow_camera(distance=5.5,pitch=next.camera_pitch,height=1.6);follow.yaw=next.camera_yaw
    descent_camera=DescentCamera();free=fly_camera(next.position,next.camera_yaw,next.camera_pitch)
    # A battle replaces its weather, not the user's weapon/debug choices. Fresh-start
    # already rebuilt Debug above, including those defaults and their handling globals.
    dbg.weather_choice=-1
    weather_scene_step(living_world,next.position,hour,0)
    chase(pc,1.0/60.0)
    update_player_follow(1.0/60.0,input=false)
    active_scenario=(if fresh:"" else:key);judge_camera=none
    if audio_enabled and active_scenario=="strait":prepare_battle_radio(battle_radio)
    if fresh:judge_ready=false
    set_paused(false)
    if me.mode==.aboard:
        mouse_lock(true)
        pc.mouse_mode=true
    if env("AEGEAN_SCENARIO_TIMING")!=none:print("SCENARIO_LOAD_MS {(time()-load_started)*1000.0:.3}")
    if env("AEGEAN_CAPTURE_TRACE")!=none:print("SCENARIO_STATE {living.canonical_hash(living_world)} {hash(to_text(battle))} {hour} {pc.throttle}")
    if startup_aegean_runtime_trace!=none:print("SCENARIO_FEEL player={pc.spec.player} scale={pc.spec.handling_scale} pure={dbg.tweaks.pure_scale} external={battle.actors[combat_index(battle,living_world.people[living_world.player].craft)].external}")
    print("SCENARIO {key}: {battle.actors.len()} aircraft, player {pc.state.position}, weather {living_world.weather.len()}")
    true

# ---------------- complete game slots (pause-menu presentation lives elsewhere) ----------------
game_saves=GameSlots()
init_game_slots(game_saves)
# A browser page's memory only grows, and growing it mid-game can bring a full garbage
# collection with it. Two blocks the size of a save's text and compressed body are taken and
# released while the game loads; the allocator keeps them, so the first autosave reuses them.
prewarm_save_memory = ():
    text: u8[]; text.reserve(24000000)
    body: u8[]; body.reserve(10000000)
when TARGET == "wasm": prewarm_save_memory()
game_slot_views: GameSlotView[]
game_slots_known=false
game_active_slot= -1
game_save_command=""
game_save_requested= -1
game_save_seen= -1
game_session_epoch=0
game_operation_epoch= -1
game_save_error_logged=""
game_autosave=AutosaveClock()
save_frame_minute= -1           # (the world minute when this frame's update began)
save_waited=0                   # (frames a save in progress has stood aside for a world minute)
game_save_auto=false            # (the request under way is the autosave's, not the player's)
game_ui_note=""                 # the pause menu's Game page: what the player's last request came to
saved_toast_at= -100.0          # (when the last autosave finished: the quiet "Saved" card)

# A new situation/story cannot silently attach itself to the previous save slot.
# An already submitted browser transaction can finish, but its result belongs to its old epoch.
detach_game_slot_context = ():
    global game_session_epoch,game_active_slot,game_slots_known,game_save_command,game_autosave
    game_session_epoch+=1;game_active_slot= -1;game_slots_known=false;game_save_command="";game_autosave=AutosaveClock()
    global game_save_auto,game_ui_note
    game_save_auto=false;game_ui_note=""

game_save_slots = () -> GameSlotView[]: game_slot_views
game_save_status = () -> GameSaveStatus:
    GameSaveStatus(game_saves.ready,game_saves.busy or game_save_command!="" or game_saves.loaded!=none,game_saves.operation,game_saves.slot,game_saves.sequence,game_saves.error,active_slot=game_active_slot)

queue_game_slot = (command: str,slot: int) -> bool:
    global game_save_command,game_save_requested
    if not game_saves.ready or game_saves.busy or game_save_command!="" or game_saves.loaded!=none or not valid_slot(slot): return false
    game_save_command=command;game_save_requested=slot
    true
request_game_save = (slot: int) -> bool: queue_game_slot("save",slot)
request_game_load = (slot: int) -> bool: queue_game_slot("load",slot)
request_game_delete = (slot: int) -> bool: queue_game_slot("delete",slot)

# Registry bins bound this query; no full-world scan or terrain work on the frame path.
game_place_at = (at: vec3) -> int:
    best= -1;distance=1e20
    loop index in settlement_registry.settlement_bins.get(geography_bin(f64(at.x),f64(at.z)),[]):
        place=settlement_registry.world_settlements[index]
        d=f64(length(at.xz-place.center.xz))
        if d<f64(place.radius)+100 and d<distance:
            best=(if place.legacy>=0:place.legacy else:place.id)
            distance=d
    best

capture_running_game = () -> lt.SaveGame | save_types.LivingSaveError:
    if active_scenario!="": return save_types.LivingSaveError("Situations are separate from saved games.")
    if skip.active: return save_types.LivingSaveError("Finish resting or working before saving.")
    if launch.active: return save_types.LivingSaveError("Wait until the launch has arrived.")
    if me.mode==.walking:sync_walker_point()
    who=living_world.people[living_world.player]
    at=if me.mode==.aboard:pc.state.position else:me.pos
    place=game_place_at(at)
    field=airfield_at(at.xz)
    # (at an aerodrome: the save names it, and is filed under the town it serves)
    if field>=0:place=AIRFIELDS[field].place
    summary=lt.SaveSummary(minute=living_world.minute,place=place,place_name=if field>=0:AIRFIELDS[field].name else:(if place>=0:living.place_name(living_world,place) else:"Away from a town"),player_name=who.name,mode=str(me.mode),
        craft=CRAFT_NAMES[clamp(int(pc.kind),0,CRAFT_NAMES.len()-1)],cents=sandbox_own_cents(player_cents(),purse_hold),saved_at=unix_time())
    # (saved while swimming: the pilot is kept where he went in, dressed again)
    kept_pos=if swim.active and me.mode==.walking:swim.shore else:me.pos
    kept_point=if swim.active and me.mode==.walking:world_point(swim.shore) else:walker_point
    kept_yaw=me.yaw
    # (saved in a room for the night: the room isn't kept; the pilot is kept where leaving it puts him)
    if stay.active:
        kept_pos,kept_yaw=stay_exit()
        kept_point=world_point(kept_pos)
    session=GameSession(player_mode=int(me.mode),player_position=kept_pos,player_point=kept_point,player_yaw=kept_yaw,player_phase=me.phase,
        flyer=pc,air=air_events,notes=notebook.notes,world_time=t,hour=hour,wind_bias=wind_bias,accumulator=traffic_scene.accumulator,
        rope_anchor=rope.anchor,rope_loose=rope.loose,rope_tied=rope.tied,mooring=vessel_mooring,speed=speed_scale,lift=lift_scale,bullets=bullet_scale,
        wind=wind_now,feel=dbg.tweaks,follow=follow,free=free,leisure=leisure_kept(),leisure_at=leisure_at,leisure_spent=leisure_spent,leisure_had=leisure_had,served_look_until=served_look_until,mustache=pilot_mustache,fish=fish,paint=player_paint,paint_job=paint_job,help=keep_help(),purse=purse_hold)
    # (the folded checkpoint only; its whole-World checks run in the save's own steps)
    capture_game_snapshot(living_world,presentation,session,traffic,traffic_scene,vessels,battle,terrain_key(),summary)

# what one sits with, as the save keeps it: what the waiter has yet to bring goes back on the order
# (he brings it again after a load), and nothing is in hand
leisure_kept = () -> LeisureState:
    out = leisure
    loop s in waiter.pending: out.coming.push(s)
    loop s in waiter.tray:
        if s.amount > 0.0 and waiter.stage <= 2: out.coming.push(s)
    loop k in 0..out.served.len(): out.served[k].held = false
    out

# A fight's situation ends where the pilot comes safe into harbour: moored, or ashore in a town, with
# no enemy flying within 8 km. The game then simply goes on from there (the same world, its war and
# its towns), and can be saved: no dead end at the end of the strait or the canal escape.
situation_safe_since = -1.0           # (the time the pilot came in safe, while the fight still goes on near)
situation_arrival = (me_index: int):
    global active_scenario, situation_safe_since
    if me_index < 0 or skip.active: return
    safe = (me.mode == .aboard and pc.state.moored and sos.stage == .none) or (me.mode == .walking and game_place_at(me.pos) >= 0)
    if not safe:
        situation_safe_since = -1.0
        return
    if situation_safe_since < 0.0: situation_safe_since = t
    here = if me.mode == .aboard: pc.state.position else: me.pos
    side = battle.actors[me_index].side
    # (in with the fight gone on elsewhere; or, towed into a harbour under it, after half a minute
    # in safe: the fight goes on in the world overhead, and is saved with it)
    loop a in battle.actors:
        # (only those in this fight: civil flyers registered with the battle have sides of their own)
        if a.engagement != battle.actors[me_index].engagement or a.side == side or a.side <= 0: continue
        if a.present and a.status == .flying and f64(length(a.state.position.xz - here.xz)) < 8000.0 and t - situation_safe_since < 30.0: return
    situation_safe_since = -1.0
    place = game_place_at(here)
    where = if place >= 0: living.place_name(living_world, place) else: "harbour"
    log_note(notebook, "Came in safe to {where} after the {if active_scenario == "canal": "escape from Neravessa" else: "fight over the strait"}.", clock_text(living_world, living_world.minute))
    active_scenario = ""
    say_toast("Safe in {where}. The game goes on from here, and can be saved.")

# What a scene holds only while it plays (a room for the night, a pleasure flight, a rescued pilot
# aboard, the waiter and the table, work on the aircraft, stargazing, a handover being signed for):
# none of it is saved, and none of it may outlive a load or a new situation.
reset_scene_moments = ():
    global stay, ride, rider, waiter, clear_waiter, company, taking, left_table, job, gaze
    global handover_job, handover_by, handover_paid_before, situation_safe_since
    global tender_xfer, tender_way_on
    situation_safe_since = -1.0
    stay = Stay(); ride = Joyride(); rider = RescuedRider(); waiter = Waiter(); clear_waiter = Waiter()
    company = Company(); taking = Taking(); left_table = []; job = PlaneJob(); gaze = Gaze()
    handover_job = -1; handover_by = -1; handover_paid_before = 0
    tender_xfer = TenderTransfer(); tender_way_on = false

apply_saved_game = (game: lt.SaveGame,session: GameSession) -> bool:
    global living_world,presentation,pc,me,traffic,traffic_scene,air_events,all_air_traffic,vessels,battle,vessel_bindings,vessel_mooring,sos
    global walker_point,walker_published,folks,folk_sync_t,notebook,my_jobs,t,hour,wind_bias,wind_now,follow,follow_frame,free,descent_camera
    global ui,ui_folk,ui_place,ui_line,ui_news,ui_turn,ui_job,ui_mission,battle_card,war_chart,view_target,target_scan,rope,was_moored,rt
    global wakes,vapor_trails,pc_wing_vapour,splashes,last_shots,plunge,plunge_v,active_scenario,judge_camera,talk_at_start,cat_scene,combat_visual,air_visual,guns
    global launch,buoys_at,offshore,lighter,lighter_phase,swing_rate
    global fuel_pier_seen,fuel_pier_frame,fuel_offered_at,refuel_start,refuel_len,known_maps,toast,toast_until
    global leisure,leisure_at,leisure_spent,leisure_had,leisure_ui,leisure_line,skip,served_look_until,served_pending
    global fish,fish_throws,fish_rings,fish_landed_at,fish_bucket_beside
    # Everything that can reject the load is checked before any running state is replaced.
    if session_error(game,session)!="" or session.flyer.model<0 or session.flyer.model>=craft_models.len(): return false
    fleet=VesselFleet();fight=Battle()
    if not restore_war_scene(game.world,fleet,fight): return false
    hush_audio(audio);hush_combat_audio(combat_audio);hush_battle_radio(battle_radio);hush_engines(hearing)
    life_audio.hush_life_audio(life_sound);ambience_hush(world_ambience.sound);radio.radio_silence(cockpit_radio)
    set_speed_scale(session.speed);lt.scale_airframes(session.speed);set_lift_scale(session.lift);set_bullet_scale(session.bullets)
    dbg.tweaks=session.feel;set_tweaks(session.feel)
    global town_speech
    town_speech = TownSpeech()
    living_world=game.world;presentation=game.presentation;pc=session.flyer;air_events=session.air
    band_publish(living_world, band_numbers(hotel), BAR_START, BAR_END, int(BAR_GAP * 60.0))
    traffic_scene=living_scene.SceneAdapter(accumulator=session.accumulator)
    traffic=make_living_traffic(living_world,craft_models);assign_pilot_liveries();bind_living_player(pc,living_world,traffic_scene);landplane_ashore()
    restore_air_owners(air_events,living_world)
    vessels=fleet;battle=fight;vessel_bindings=VesselBindings();vessel_mooring=session.mooring
    restore_battle_owners(battle,living_world)
    loop ship in vessels.ships:
        id=ship.id-FAR_VESSEL_BASE
        if id>=0 and id<living_world.far.vehicles.len(): living_world.far.vehicles[id].scene_owned=true
    me=Player(mode=Mode(session.player_mode),pos=session.player_position,yaw=session.player_yaw,phase=session.player_phase)
    walker_point=session.player_point;walker_published=me.pos
    t=session.world_time;hour=session.hour;wind_bias=session.wind_bias;wind_now=session.wind
    follow=session.follow;follow_frame=FollowFrame();free=session.free;descent_camera=DescentCamera()
    clear_walk_presentations()
    folks=[];sync_folk(folks,living_world,towns);folk_sync_t=t
    my_jobs={}
    loop id in living_world.active_jobs:
        job=living_world.jobs[id]
        if job.carrier==living_world.player and job.state==.claimed:my_jobs[id]=job.state
    notebook=Notebook(storage_key=slot_prefix(game_saves.slot)+"-notebook",notes=session.notes)
    known_maps={}
    loop copy in living.owned_maps(living_world,living_world.player):known_maps[copy.id]=true
    all_air_traffic=traffic;view_target=TargetView();target_scan=0;war_chart=WarChart();battle_card=BattleCard()
    # Transient effects and interactions are rebuilt from restored positions, never old handles.
    spray_ps.items.clear();spray_ps.billows.clear();smoke_ps.items.clear();dust_ps.items.clear()
    wakes=[loop _ in 0..traffic.len()+1:WakeTrail()];vapor_trails=[Trail(),Trail()];pc_wing_vapour=WingVapour();splashes=[];last_shots=0;plunge=0;plunge_v=0
    rope.anchor=session.rope_anchor;rope.loose=session.rope_loose;rope.tied=session.rope_tied;was_moored=pc.state.moored
    launch=launches.LaunchRide();buoys_at= -1;offshore=find_offshore_berth()
    lighter=launches.LaunchRide();lighter_phase=0;swing_rate=0.0
    ui=.none;ui_folk= -1;ui_place= -1;ui_line="";ui_news=0;ui_turn=lt.ConversationTurn();ui_job= -1;ui_mission= -1
    fuel_pier_seen=none;fuel_pier_frame= -100;fuel_offered_at=FUEL_NOWHERE;refuel_start= -100;refuel_len=0
    if cat_scene.purr_voice>=0:stop(cat_scene.purr_voice)
    cats=cat_scene
    cat_scene=CatScene(meshes=cats.meshes,ready=cats.ready,purr=cats.purr,sound_ready=cats.sound_ready)
    cv=combat_visual
    combat_visual=CombatView(low=cv.low,low_parts=cv.low_parts,chute=cv.chute,hole=cv.hole,oil=cv.oil,pilot=cv.pilot,distant_pilot=cv.distant_pilot,
        trails=BattleTrails(mesh=cv.trails.mesh,shader=cv.trails.shader))
    av=air_visual
    air_visual=AirView(silhouette=av.silhouette,exhaust=BattleTrails(mesh=av.exhaust.mesh,shader=av.exhaust.shader))
    guns=Guns();life_sound.last_beat= -1
    world_ambience.sound.pending=[];world_ambience.sound.sources=[];world_ambience.sound.last_time= -1;world_ambience.sound.refresh=0
    world_ambience.previous_scan= -1
    bar_music_stop(bar_music)
    leisure=session.leisure;leisure_at=session.leisure_at;leisure_spent=session.leisure_spent;leisure_had=session.leisure_had
    set_pilot_mustache(session.mustache)
    # (a game saved before the Paint page: the period paint its aircraft record wears)
    rec = living_world.people[living_world.player].craft
    kept = session.paint
    if not paint_active(kept, int(pc.kind)) and rec >= 0:
        l = living_world.aircraft[rec].livery_index
        if l >= 0 and l < LIVERIES.len() and l != DEFAULT_LIVERIES[int(pc.kind)] and l in boat_paints(pc.kind): kept = Paint(kind = int(pc.kind), livery = l)
    set_player_paint(kept)
    global paint_job
    paint_job = if session.paint_job.active and session.paint_job.kind == int(pc.kind): session.paint_job else: PaintJob()
    paint_shop_close()
    global swim
    swim=Swim()
    leisure_ui=0;leisure_line="";skip=TimeSkip();served_look_until=session.served_look_until;served_pending=false
    fish=session.fish;fish_upgrade(fish,living_world.player);fish_throws=[];fish_rings=[];fish_landed_at= -100.0;fish_bucket_beside= -1
    reset_scene_moments()
    if leisure.sitting!="":ui=.leisure
    active_scenario="";judge_camera=none;talk_at_start=false;toast="";toast_until=0
    rt=RtPad()
    restore_help(session.help)
    global purse_hold
    purse_hold = session.purse
    weather_scene_step(living_world,if me.mode==.aboard:pc.state.position else:me.pos,hour,0)
    update_player_follow(0,input=false)
    mouse_lock(false)
    true

# At update entry the previous frame is complete, including drawing-time purchases.
# This runs while paused too. Loaded World values are consumed before the next simulation step.
# A save in progress works a few milliseconds each frame, after the frame's update, and
# stands aside on a frame that ran a world minute (the busiest frames) unless it has waited
# a while. In the pause menu it may take longer slices.
step_game_save = ():
    global save_waited
    if game_saves.phase!="pack": return
    if (world_held() or living_world.minute!=save_frame_minute) and save_waited<30: save_waited+=1; return
    save_waited=0
    step_game_slots(game_saves,if paused: 12.0 else: 3.0)

process_game_saves = () -> bool:
    global save_frame_minute
    save_frame_minute=living_world.minute
    global game_save_seen,game_active_slot,game_slots_known,game_slot_views,game_save_command,game_save_requested,game_save_error_logged,game_operation_epoch
    global game_save_auto,game_ui_note,saved_toast_at
    poll_game_slots(game_saves)
    if game_saves.ready and not game_saves.busy and (not game_slots_known or game_save_seen!=game_saves.sequence):
        game_slot_views=list_game_slots(game_saves,terrain_key())
        if not game_slots_known:
            loop view in game_slot_views:
                if not view.exists and game_active_slot<0:game_active_slot=view.slot
            game_slots_known=true
    if not game_saves.busy and game_save_seen!=game_saves.sequence:
        game_save_seen=game_saves.sequence
        if game_saves.operation=="save" and game_operation_epoch==game_session_epoch:
            ack_autosave(game_autosave,game_saves.error=="")
            if game_saves.error=="":game_active_slot=game_saves.slot
        if game_saves.operation=="delete" and game_operation_epoch==game_session_epoch and game_saves.error=="" and game_active_slot==game_saves.slot:game_active_slot= -1
        if game_operation_epoch==game_session_epoch:
            n=game_saves.slot+1
            if game_saves.operation=="save" and game_save_auto:
                if game_saves.error=="":saved_toast_at=t
            else if game_saves.error!="":game_ui_note=game_saves.error
            else if game_saves.operation=="save":game_ui_note="Saved in slot {n}."
            else if game_saves.operation=="delete":game_ui_note="Slot {n} deleted."
            if game_saves.operation=="save":game_save_auto=false
        if game_saves.error!="" and game_saves.error!=game_save_error_logged:
            game_save_error_logged=game_saves.error
            eprint("[game save] {game_saves.operation} slot={game_saves.slot} minute={living_world.minute}: {game_saves.error}")
    # (a world minute in progress finishes before a checkpoint is taken or a game replaces it)
    if world_held(): return false
    if let game=take_game_slot(game_saves):
        if game_operation_epoch!=game_session_epoch:return false
        runtime=read_game_session(game)
        if runtime is GameSession and apply_saved_game(game,runtime):
            game_active_slot=game_saves.slot;ack_autosave(game_autosave,true)
            game_ui_note="Loaded slot {game_saves.slot+1}."
            # (the loaded game carries on at once; the menu has done its work)
            set_paused(false)
            return true
        game_saves.error="The saved player could not be restored; the running game is unchanged."
        game_ui_note=game_saves.error
    if game_saves.busy or game_save_command=="":return false
    game_operation_epoch=game_session_epoch
    command=game_save_command;slot=game_save_requested;game_save_command="";game_save_requested= -1
    if command=="load":_=load_game_slot(game_saves,slot,terrain_key())
    else if command=="delete":_=delete_game_slot(game_saves,slot)
    else:
        ack_autosave(game_autosave,false)
        game=capture_running_game()
        if game is lt.SaveGame:_=save_game_slot(game_saves,slot,game,spread=true)
        else:
            game_saves.operation="save";game_saves.slot=slot;finish_slot_operation(game_saves,game.message)
    false

queue_autosave = (dt: f64):
    safe=active_scenario=="" and not skip.active and not refueling() and (ui==.none or (ui==.leisure and leisure_ui==0)) and not notebook.open and not cat_busy(cat_scene)
    # (safe: tied up, or on foot in a town; at an aerodrome, parked on its wheels or on foot there)
    safe=safe and ((me.mode==.aboard and pc.state.moored and not pc.state.crashed) or (me.mode==.walking and game_place_at(me.pos)>=0)
        or (me.mode==.aboard and landplane_parked() and airfield_at(pc.state.position.xz)>=0) or (me.mode==.walking and airfield_at(me.pos.xz)>=0))
    if safe:
        at=if me.mode==.aboard:pc.state.position else:me.pos
        if autosave_combat_near(living_world,at):safe=false
        ci=combat_index(battle,living_world.people[living_world.player].craft)
        if ci>=0 and battle.actors[ci].pilot.trigger:safe=false
    if step_autosave(game_autosave,dt,safe,game_saves.ready and not game_saves.busy and game_active_slot>=0 and living_world.far.populated):
        global game_save_auto
        if request_game_save(game_active_slot):game_save_auto=true

# the pause menu's Game page, as it stands: the slots from their cached headers, and what is under way
game_page_view = (v: mut DebugView):
    status=game_save_status()
    v.games=game_rows(game_slot_views,game_active_slot)
    v.game_ready=status.ready and game_slots_known
    v.game_busy=status.busy
    v.game_note=game_ui_note
    if status.busy and not game_save_auto:
        doing=if game_save_command!="":game_save_command else:status.operation
        v.game_note=if doing=="load":"Loading..." else if doing=="delete":"Deleting..." else:"Saving..."
    full=game_slot_views.len()>0
    loop view in game_slot_views:
        if not view.exists:full=false
    v.autosave_note="Autosave is off until you save or load a slot."
    if active_scenario!="":v.autosave_note="Situations are separate from saved games: nothing autosaves here."
    else if game_active_slot>=0:v.autosave_note="The game autosaves to slot {game_active_slot+1} now and then, at a mooring or in a town."
    else if full:v.autosave_note="Autosave is off while all three slots are full. Save or load one and the game autosaves there."

# ---------------- the title screen (presentation: src/title_screen.jo) ----------------
# It stands at startup over the live scene, the world waiting behind it, until the player
# continues, loads, starts a new game or picks a situation. Tools that import this file, test and
# capture runs (SLOPPY_FRAMES / SLOPPY_SCREENSHOT, or any AEGEAN_ staging option but the quality and
# touch ones) start straight in the game; AEGEAN_TITLE=0 or 1 (in a page: ?AEGEAN_TITLE=0) says so outright.
when TARGET == "wasm":
    extern __aegean_staged = () -> i32
    extern __aegean_shown = ()
    extern __aegean_progress = (stage: i32, fraction: f64)
title_wanted = () -> bool: title_will_open()
title = TitleScreen(open = title_wanted())
title_left_at = -100.0          # (when play began from the title: the scene comes up out of the dusk)
title_handover_frame = -1       # (the frame play began from the title)
# A choice made on the title (New, Continue, a slot, a Situation) waits, the screen in the title's
# dusk with the loading propeller turning and the menu gone, until what play needs that the title
# has been preparing a dusk frame at a time is ready (its shaders, its sounds and, for a new game,
# the far economy), and only then is made:
# play then comes up out of the dusk with nothing left to stall its first frames (a long first
# frame of play showed the dusk it fades out of as a dark box over the game, in a browser).
title_leaving: TitleChoice? = none
title_leaving_since = 0.0
const TITLE_LEAVING_MOST = 10.0       # (seconds, at the most: then it is made all the same)
# (tests: AEGEAN_TITLE_PICK=new, continue, slot1, slot2... or a Situation's key, chosen as a click
# would once the title is ready; each frame's title layers reported for some seconds of play after)
title_pick_env = env("AEGEAN_TITLE_PICK")
title_pick_asked = title_pick_env != none
title_pick_new = (title_pick_env ?? "") == "new"
names_at_play = 0               # (the game's name drawn so far when play began: no more after that)
title_check = to_int(env("AEGEAN_TITLE_CHECK") ?? "") ?? -1   # (a frame to report on the name over play)
page_shown = false              # (web: the page's loading card is taken away once the game has drawn)
title_prep = 0                  # (before the title: 0 the islands' places, a few a frame; 1 the towns, once; 2 ready)
loading_t0 = -1.0               # (when the loading propeller first showed: its cycle runs from there)
# AEGEAN_LOADING_FRAMES=dir: the loading propeller alone, held there (the world not prepared), every
# frame saved to dir, for looking at its regimes (with AEGEAN_TITLE=1 and SLOPPY_FRAMES)
loading_frames = env("AEGEAN_LOADING_FRAMES")

# ---- the title's backdrop: a reel of shots of the live world (src/title_shots.jo) ----
# Behind the title the world runs as in play, seen through a free camera that the reel flies, the
# game's keys left alone. Nothing is saved from it: a new game puts back the world as the startup
# built it (taken when the title opened), a loaded one replaces it, as before.
# AEGEAN_TITLE_SHOT=low|high|city repeats one kind and AEGEAN_TITLE_SEED fixes the order
# (captures); AEGEAN_TITLE_FRAMES=dir saves every 10th frame there (AEGEAN_TITLE_FRAME_STEP: every nth).
const TITLE_DIP = 0.7           # (seconds the screen dips to dusk between shots, each way)
title_rng = TitleRng(s = u64(max(1, (to_int(env("AEGEAN_TITLE_SEED") ?? "") ?? int(unix_time() * 1000.0)) % 2147483647)) * u64(0x9E3779B97F4A7C15) + u64(1))
title_force = env("AEGEAN_TITLE_SHOT") ?? ""
title_frames = env("AEGEAN_TITLE_FRAMES")
title_frame_step = max(1, to_int(env("AEGEAN_TITLE_FRAME_STEP") ?? "10") ?? 10)
title_bare = env("AEGEAN_TITLE_BARE") != none   # (captures: the reel without the menu over it)
title_shot = TitleShot()
title_coming: TitleShot? = none
title_flying = TitleFlying()            # (the next shot's aircraft, flown a slice a frame)
title_battling = TitleBattling()        # (or its battle)
title_vapour: Trail[] = [Trail(), Trail(), Trail(), Trail()]   # (a race: the vapour off each racer's two wingtips in the pull)
title_wing_vapour: WingVapour[] = [WingVapour(), WingVapour()]   # (and over each racer's wings, in the hardest of it)
title_wakes: WakeTrail[] = [WakeTrail(), WakeTrail()]          # (and the water their downwash and prop wash work, skimming the sea)
title_warming = false                   # (its terrain and town asked for ahead)
title_waited = 0.0                      # (how long the shot was held on for the next to be ready)
title_dark = 0.0                        # (how long the new shot has stayed dark, its view not yet settled)
title_dt = 1.0 / 60.0                   # (the shot clock's step: smoothed, so the camera never jerks with an uneven frame)
const TITLE_PICK_AT = 2.0               # (seconds into a shot when the next is chosen and its preparing begins)
const TITLE_WARM_AHEAD = 12.0           # (seconds before the cut its terrain and towns are warmed)
const TITLE_WAIT_MOST = 5.0             # (the longest a shot is held on, waiting)
const TITLE_DARK_MOST = 2.5             # (the longest a new shot stays dark, waiting for its view; the first, longer: nothing was warmed for it)
const TITLE_FIRST_DARK_MOST = 8.0
# (the first shot also waits behind the loading card while the title's own frames stall: its shaders
# linked at their first draw, seconds each on a phone's fresh visit; shown once this many frames in
# a row are quick, or after TITLE_FIRST_STALL_MOST seconds of stalling)
const TITLE_CALM_FRAMES = 4
const TITLE_FIRST_STALL_MOST = 30.0
title_calm = 0
title_jobs_now = 0.0                    # (seconds this frame's dusk jobs took, title_update)
title_jobs_last = 0.0
title_stalled = 0.0
title_shown = 0                         # (shots begun)
title_shot_age = 0.0
title_now = TitleView(eye = vec3(0, 0, 0), dir = vec3(0, 0, -1), up = vec3(0, 1, 0), velocity = vec3(0, 0, 0), pace_at = vec3(0, 0, 0), pace_turn = vec4(0, 0, 0, 1))
title_world_open = false
title_start: ScenarioState? = none
# (1.2 s of the music queued ahead, refilled three blocks a frame: a long frame at a cut, or a
# heavy one in a shot, never runs it dry)
title_music = make_title_music()
title_music_fade = 1.0          # (after play begins the music fades away)
title_sound_on = false          # (in a page: from the first click, tap or key)
title_kept: CraftState? = none  # (the player's aircraft, while a paced one is drawn in its place)
# AEGEAN_TITLE_TIMING=1: each frame longer than 30 ms behind the title, and the worst frame within a
# second of each cut (TITLE_FRAME, TITLE_CUT_WORST lines), with where the time went
title_timing = env("AEGEAN_TITLE_TIMING") != none
title_frame_at = -1.0
title_parts: {str: f64} = {}
title_cut_worst = 0.0
title_cuts = 0
title_part = (name: str, began: f64): if title_timing: title_parts[name] = (title_parts.get(name) ?? 0.0) + (time() - began) * 1000.0

# the big towns a city shot flies over
title_sites = () -> TitleSite[]:
    sites = [TitleSite(name = home.name, center = home.center, radius = 260.0, out = home.out)]
    loop place in settlement_registry.world_settlements:
        if place.name == "Kalyrassa" or place.id == CANAL_CITY_ID:
            # (the canal city: its canals within the town, to follow)
            route: vec3[]
            if place.id == CANAL_CITY_ID:
                loop i in CANAL_BEGIN..CANAL_FINISH + 1:
                    q = vec3(RIVER_NODES[i].x, 0, RIVER_NODES[i].y)
                    if f64(length(q.xz - place.center.xz)) < max(place.radius, 200.0) + 250.0: route.push(q)
            sites.push(TitleSite(name = place.name, center = place.center, radius = max(place.radius, 200.0), out = place.out, route = route))
    sites

title_ground = (x: f64, z: f64) -> f64: f64(surface_height(x, z))

title_pick = (previous: TitleShotKind?) -> TitleShot:
    # (the reel opens on the vista: the Aegean at a glance, sea, islands, a great cloud and a small seaplane)
    if title_force == "high-vista" or (title_force == "" and title_shown == 0 and previous == none):
        if let v = title_vista(title_rng, home.center, title_ground, title_aspect()): return v
    title_next_shot(title_rng, previous, home.center, title_sites(), title_ground, (h: f64) -> vec3: sky_sun(h), title_force, strait_origin(0), title_aspect())

# The vista's tower: one towering cumulus made for the shot from the field's own tower forms
# (src/cloud_field.jo), where the shot puts it (title_vista_tower), grown full and standing solid
# while the shot lasts; scaled as a whole, never stretched, to reach the title's height or, if
# that would make it too broad, as broad as is clear of the letters.
title_tower: CloudVolume? = none
title_make_tower = (shot: TitleShot) -> CloudVolume:
    want = title_vista_tower(shot)
    r = rng(int(shot.phase * 100000.0) + 17)
    v = cloud_place(r, f64(want.x), f64(want.y), 1600.0, cloud_pick(r, CLOUD_CONGESTUS, 4, 6), 0.95, shot.heading)
    tall = f64(v.extent.y) * (1.0 + CLOUD_BASE)
    k = min((f64(want.z) - VISTA_TOWER_BASE) / tall, f64(want.w) / f64(v.extent.x))
    v.extent *= f32(k)
    v.center.y = f32(VISTA_TOWER_BASE + f64(v.extent.y) * CLOUD_BASE)
    v.weather = vec2(1, 0)
    v.growth = vec4(0.05, f32(shot.phase), 0.018, 0.0)
    v.precise = world_point(v.center)
    v

# the screen's shape, and the vertical field the shot is composed with on 16:9 (title_fov widens it
# for narrower screens)
title_aspect = () -> f64: f64(max(screen_width(), 1)) / f64(max(screen_height(), 1))
title_base_fov = () -> f64: if title_shot.pace == 4: 62.0 else: if title_shot.kind == .low: 68.0 else: 55.0

# the aircraft a shot's flights use
title_flight_spec = (shot: TitleShot) -> CraftSpec: if shot.kind == .high: craft_spec(.gull, craft_models[SUNSET_MODEL].contacts) else: craft_spec(.falco, craft_models[3].contacts)

# A shot's aircraft (or its battle) flown on until `until` (time()); true once all flown.
title_fly_some = (shot: mut TitleShot, until: f64) -> bool:
    global title_flying, title_battling
    if shot.kind == .high and shot.pace == 4: return title_battle_step(shot, title_battling, craft_models, title_ground, until)
    title_flight_step(shot, title_flying, title_flight_spec(shot), until)
title_fly_begin = ():
    global title_flying, title_battling
    title_flying = TitleFlying(); title_battling = TitleBattling()
title_flown = () -> bool: title_flying.done or title_battling.done

# The next shot made ready a little a frame through the current one: its aircraft flown (a few
# milliseconds a frame), then, for the last seconds, its terrain and town warmed where its camera
# will be. A race that would cross land is chosen again. True once it is all ready.
title_prepare_next = () -> bool:
    global title_coming, title_flying, title_warming, world_grove_next_anchor, world_grove_next_reach
    if title_coming == none:
        if title_shot_age < TITLE_PICK_AT: return false
        title_coming = title_pick(title_shot.kind); title_fly_begin()
    next = title_coming!
    if not title_flown():
        began = time()
        _ = title_fly_some(next, began + 0.004)
        title_coming = next
        title_part("flight", began)
        if not title_flown(): return false
        if not title_wet(next):
            title_coming = none
            return false
    if title_shot_age < title_shot.length - TITLE_WARM_AHEAD: return false
    if not title_warming:
        title_warming = true
        a = title_view(next, 0.0, title_ground)
        b = title_view(next, next.length * 0.5, title_ground)
        world_warm([WorldWarmView(a.eye, a.eye + a.dir * 100.0), WorldWarmView(b.eye, b.eye + b.dir * 100.0)])
        world_towns_expect(title_path_points(next) + title_path_points(title_shot))
        world_grove_next_anchor = title_grove_anchor(next); world_grove_next_reach = title_grove_reach(next)
    world_warm_settled() and world_towns_settled() and world_groves_settled()

# its aircraft keep over the sea (a race or a lone flight that would cross land is chosen again)
title_wet = (shot: TitleShot) -> bool:
    if shot.kind != .low: return true
    loop track in shot.race:
        loop k in 0..track.at.len():
            if k % 30 == 0 and title_ground(f64(track.at[k].x), f64(track.at[k].z)) > -3.0: return false
    true

# the middle of a shot's path, and how far from it its groves reach: the usual reach round the
# camera wherever it is along the path (no further than 1100 m, the slots' bound)
title_grove_anchor = (shot: TitleShot) -> vec3: title_view(shot, shot.length * 0.5, title_ground).eye
title_grove_reach = (shot: TitleShot) -> f64:
    a = title_view(shot, 0.0, title_ground).eye; b = title_view(shot, shot.length, title_ground).eye; m = title_grove_anchor(shot)
    min(1100.0, render_quality.grove_distance + f64(max(length(a.xz - m.xz), length(b.xz - m.xz))))

# where a shot's camera passes, every 100 m or so, on the ground
title_path_points = (shot: TitleShot) -> vec2[]:
    n = max(2, int(shot.speed * shot.length / 100.0))
    [loop k in 0..n + 1: title_view(shot, shot.length * f64(k) / f64(n), title_ground).eye.xz]

# (timing: the frame that just ended, and the worst near each cut)
title_frame_log = ():
    global title_frame_at, title_parts, title_cut_worst, title_cuts
    now = time()
    if title_frame_at >= 0.0:
        ms = (now - title_frame_at) * 1000.0
        near = title_shot_age < 1.0 or title_shot_age > title_shot.length - 1.0
        if near: title_cut_worst = max(title_cut_worst, ms)
        if ms > 30.0:
            parts = [loop k, v in title_parts: "{k} {v:.1}"].join(", ")
            print("TITLE_FRAME {ms:.1} ms at {title_shot.kind} {title_shot_age:.2} s ({parts})")
        if title_shot_age > 1.0 and title_shot_age < 1.5 and title_cut_worst > 0.0:
            print("TITLE_CUT_WORST cut {title_cuts} into {title_shot.kind} {title_shot.site}: {title_cut_worst:.1} ms")
            title_cut_worst = 0.0
            title_cuts += 1
    title_frame_at = now
    title_parts = {}

# a shot begins: its weather (fair, never rain), where it is
title_cut = (shot: TitleShot):
    global title_shot, title_shot_age, title_coming, title_warming, title_waited, title_dark, title_shown, world_grove_anchor, world_grove_reach, world_grove_next_anchor, world_grove_capped, title_vapour, title_tower, title_wakes, title_wing_vapour
    title_shot = shot; title_shot_age = 0.0; title_coming = none; title_warming = false; title_waited = 0.0; title_dark = 0.0; title_shown += 1
    world_warm_clear()
    world_towns_expect(title_path_points(shot))
    # (the shot's groves reached from its middle: their edge stays still while the camera moves)
    world_grove_anchor = title_grove_anchor(shot); world_grove_reach = title_grove_reach(shot)
    world_grove_next_anchor = none
    if title_frames != none and world_grove_capped: print("TITLE warning: a shot's groves were capped at {WORLD_GROVE_SHOT_MOST} tiles, the farthest left out")
    world_grove_capped = false
    view = title_view(shot, 0.0, title_ground)
    # (the strait's merge in the strait's own weather, as its scenario opens; the chase camera put
    # behind the player's Gull afresh)
    if shot.pace == 4:
        strait_weather(living_world, living_world.minute)
    else: weather_choose(living_world, shot.weather, view.eye)
    title_vapour = [Trail(), Trail(), Trail(), Trail()]
    title_wing_vapour = [WingVapour(), WingVapour()]
    title_wakes = [WakeTrail(), WakeTrail()]
    title_tower = if shot.pace == 5: title_make_tower(shot) else: none
    print("TITLE shot {shot.kind} {shot.site} at {view.eye.x:.0} {view.eye.y:.0} {view.eye.z:.0} hour {shot.hour:.2} weather {WEATHER_LABELS[shot.weather]} pace {shot.pace} for {shot.length:.1} s")

# The far economy's opening for a new game, a few milliseconds a frame behind the title (it was made
# before the first frame, about 3.5 s of a phone's start): on its own copy of the startup's world,
# which nothing else changes; put into the world kept aside for a new game when it is done. The
# reel's own world runs without it meanwhile (configure_life_scene leaves it out).
far_opening_began = -1.0
step_far_opening = (budget: f64, light_only: bool = false):
    global title_start, far_opening_began
    if not far_opening_pending(): return
    if far_opening_began < 0.0: far_opening_began = time()
    if not far_opening_advance(budget, light_only): return
    made = far_opening_take()
    print("TITLE far economy made behind the title in {(time() - far_opening_began) * 1000.0:.0} ms (populated: {made.far.populated})")
    far_opening_made(made)

# (the opening's World, made or taken from the bake: the world kept aside for a new game has it)
far_opening_made = (made: World):
    global title_start
    if let start = title_start:
        kept = start
        kept.world = made
        title_start = kept

# the first frame behind the title: the startup's world kept aside for a new game, the camera free
title_open_world = ():
    global title_world_open, title_start, free, folk_sync_t
    title_world_open = true
    # (the islands' places finished and the far economy populated here, once, before the first
    # frame of the title, as play would a few seconds in, in one stall: the world kept aside for a
    # new game then has it too, and the reel and its music never stall for it)
    began = time()
    settlement_registry.finish_settlement_registry()
    sync_folk(folks, living_world, towns)
    folk_sync_t = t
    print("TITLE world prepared in {(time() - began) * 1000.0:.0} ms (far economy populated: {living_world.far.populated})")
    title_start = ScenarioState(world = living_world, flyer = pc, battle = battle, mode = .walking, position = me.pos, yaw = me.yaw, hour = hour,
        camera_yaw = follow.yaw, camera_pitch = follow.pitch, vessels = vessels)
    if not living_world.far.populated and daily_far_deferred():
        far_opening_begin(living_world)
        # (the bake, when it is this world's, taken here behind the loading card: the title then
        # carries none of the opening's 7 s or so of work on a phone)
        if far_bake_take_now(): far_opening_made(far_opening_take())
    # (the rivers' and the canal city's scenery, made once here rather than at a cut in the reel)
    prepare_inland_scenery(canal_origin)
    me.mode = .free
    first = title_pick(none)
    loop attempt in 0..6:
        title_fly_begin()
        _ = title_fly_some(first, 1e30)
        if title_wet(first): break
        first = title_pick(none)
    title_cut(first)
    free = fly_camera(title_view(title_shot, 0.0, title_ground).eye, 0.0, 0.0)

# how dark the dip between shots is now (0 none .. 1 dusk)
vessels_prewarmed = false        # (the ships' view made while the title is dusk: vessel_view_prewarm)
# the next piece of the sounds made behind the title (all = true: every piece left, at once)
step_audio_build = (all: bool):
    global audio, hearing, combat_audio, audio_built, audio_job_step, audio_job, storm_audio
    loop not audio_built:
        if audio_job_step == 0:
            if audio_build_step(audio_job):
                audio = audio_job.a; audio_job = AudioBuild(); audio_job_step = 1
        else if audio_job_step == 1:
            hearing = make_hearing(); audio_job_step = 2
        else:
            combat_audio = start_combat_audio(); storm_sound_start(storm_audio); audio_built = true
            print("TITLE sounds made behind the title")
        if not all: break

# the first shot still held dark for its view to be drawn whole: the loading card stays up (the
# propeller on the dusk, no menu), the menu coming up with the shot, never over an empty dusk
title_first_waiting = () -> bool: title_shown <= 1 and title_shot_age == 0.0 and not world_hidden

title_dip = () -> f64:
    if title_leaving != none: return 1.0
    into = 1.0 - smoothstep(0.0, TITLE_DIP, title_shot_age)
    out = smoothstep(title_shot.length - TITLE_DIP, title_shot.length, title_shot_age)
    max(into, out)

# how far the one-time preparation has come (0 .. 1)
title_prep_fraction = () -> f64:
    if title_prep >= 2: return 1.0
    if title_prep == 1: return 0.7
    0.7 * f64(settlement_registry.settlement_island_cursor) / f64(max(small_islands.len(), 1))

# Before the title shows: the islands' places a few a frame, then (after a frame that says so) the
# towns' people and trade, in one step; the progress is on the loading card meanwhile.
title_prepare = ():
    global title_prep
    lay_out_screen()
    _ = process_game_saves()
    if loading_frames != none: return
    if title_prep == 0:
        if not settlement_registry.prepare_settlement_registry(): title_prep = 1
        return
    title_open_world()
    title_prep = 2

# the loading card, as the page shows it, while the world is prepared: the turning propeller and
# its filling ring (drawn natively; in a page the page's own card stays up and is told the progress)
draw_title_prep = ():
    when TARGET == "wasm":
        __aegean_progress(i32(title_prep), title_prep_fraction())
        return
    v = visible_rect()
    rect(v, rgba(0.075, 0.1, 0.15, 1))
    global loading_t0
    if loading_t0 < 0.0: loading_t0 = elapsed()
    draw_loading_propeller(vec2(f32(f64(v.x) + f64(v.w) * 0.5), f32(f64(v.y) + f64(v.h) * 0.5)), elapsed() - loading_t0, if loading_frames != none: 0.4 else: title_prep_fraction())
    if let directory = loading_frames: save_png("{directory}/{frame_number():05}.png", screenshot())

# the world runs behind the title; the reel flies the camera; the saved games are read
title_update = (dt: f64):
    global title_wing_vapour
    global title_shot_age, title_coming, title_now, keys_muted, title_sound_on, title_dt, title_dark, title_waited, title_flying, vessels_prewarmed, vessel_view
    if title_timing and title_prep >= 2: title_frame_log()

    if title_prep < 2:
        title_prepare()
        return
    lay_out_screen()
    # (the menu's own fade in begins with the first shot, not under the loading card)
    if not title_first_waiting(): title.age += dt
    # (the far economy's long single steps and the sounds' pieces only while the screen is dusk:
    # a quarter second on a phone would be seen over the shot)
    dusk = title_dip() > 0.92
    # (the time these behind-the-dusk jobs take this frame: not the title's own frames stalling,
    # which the first shot waits for behind the loading card)
    global title_jobs_now, title_jobs_last
    title_jobs_last = title_jobs_now
    jobs_began = time()
    # (a choice waiting on it, the hold's dusk: a bigger slice, the propeller turning slower but the
    # hold over sooner)
    step_far_opening(if title_leaving != none: 0.15 else: if dusk: 0.06 else: build_slice(0.008), not dusk)
    if dusk: step_audio_build(false)
    if dusk and not vessels_prewarmed: vessels_prewarmed = vessel_view_prewarm(vessel_view, vessels)
    # (the shaders play needs but the title has not drawn, linked one a dusk frame: about 60 ms
    # each on a phone; the title's own link at their first draw, and play links the rest first)
    if dusk and shaders_pending() > 0: _ = warm_up_shaders(max_count = 1)
    title_jobs_now = time() - jobs_began
    if process_game_saves():
        title_begin()
        return
    title_leave_step()
    if not game_save_status().busy: title.loading = -1
    # (the shot's own clock: the frame's time smoothed, a long frame never jumping the camera)
    title_dt = title_dt + (clamp(dt, 0.0, 0.05) - title_dt) * 0.15
    # (a new shot stays dark at its start until its view is drawn whole; the first, behind the
    # loading card, until the title's frames run smoothly too)
    global title_calm, title_stalled
    # (the last frame's time without what its dusk jobs took: the sounds, the shaders queued for
    # play, the far economy, each a piece a dusk frame; the first shot's hold is dusk too)
    title_calm = if frame_time() - title_jobs_last < 0.1: title_calm + 1 else: 0
    stalling = title_shown <= 1 and title_shot_age == 0.0 and title_calm < TITLE_CALM_FRAMES and title_stalled < TITLE_FIRST_STALL_MOST
    if stalling: title_stalled += frame_time()
    if stalling or (title_shot_age < 0.05 and title_dark < (if title_shown <= 1: TITLE_FIRST_DARK_MOST else: TITLE_DARK_MOST) and not (world_view_settled() and world_towns_settled())): title_dark += dt
    else:
        if title_shown <= 1 and title_shot_age == 0.0: print("TITLE first shot shown at {elapsed():.2} s: held {title_dark:.2} s behind the loading card, {title_stalled:.2} s of it in stalled frames")
        if title_timing and title_shot_age == 0.0 and title_dark > 0.0: print("TITLE dark {title_dark:.2} s: land missing {world_view_missing}, districts pending {world_town_pending}, job {world_town_job.active}, groves {world_grove_visible} of {world_groves.len()} slots, {world_grove_count} trees")
        title_shot_age += title_dt
    began = time()
    ready = title_prepare_next()
    title_part("prepare", began)
    # (the shot held on, a little at most, until the next is ready to be seen)
    if not ready and title_shot_age > title_shot.length - TITLE_DIP - 0.05 and title_waited < TITLE_WAIT_MOST:
        title_shot.length += title_dt; title_waited += title_dt
    began = time()
    if title_shot_age >= title_shot.length:
        if title_waited > 0.0 or title_dark > 0.0: print("TITLE waited {title_waited:.2} s for the next shot (dark {title_dark:.2} s before this one)")
        # (should the wait run out first, what is left is made ready now)
        if title_coming == none: title_coming = title_pick(title_shot.kind); title_fly_begin()
        next = title_coming!
        if not title_flown(): _ = title_fly_some(next, 1e30)
        title_cut(next)
    title_part("cut", began)
    title_now = title_view(title_shot, title_shot_age, title_ground)
    # (on a narrow screen, a phone upright, the camera turns gently toward the shot's aircraft)
    turn = title_subject_turn(title_shot, title_shot_age, title_ground, title_base_fov(), title_aspect())
    if abs(turn) > 1e-5:
        q = quat_axis_angle(vec3(0, 1, 0), -turn)
        title_now.dir = quat_rotate(q, title_now.dir); title_now.up = quat_rotate(q, title_now.up)
    # (a race: vapour off the racers' wingtips as they pull, as the player's aircraft makes it: the
    # load on its wings, its true speed and the damp of the air)
    if title_shot.kind == .low and title_shot.pace == 2:
        tips = craft_spec(.falco, craft_models[3].contacts).wing_contacts
        left = tips[0]; right = tips[0]
        loop p in tips:
            if p.x < left.x: left = p
            if p.x > right.x: right = p
        loop i in 0..min(2, title_now.racers.len()):
            racer = title_now.racers[i]
            body = CraftState(position = racer.at, orientation = racer.turn, velocity = racer.velocity)
            deck = if weather_active: f64(weather_here.deck) else: 0.0
            rain = if weather_active: f64(weather_here.rain) else: 0.0
            fog = if weather_active: f64(weather_here.fog) else: 0.0
            damp = vapour_dampness(f64(racer.at.y), true, title_now.hour, deck, rain, fog)
            strength = vapour_strength(f64(length(racer.velocity)) / speed_scale, racer.load, damp)
            trail_step(title_vapour[2 * i], craft_offset(body, quat_rotate(racer.turn, left)), strength, t)
            trail_step(title_vapour[2 * i + 1], craft_offset(body, quat_rotate(racer.turn, right)), strength, t)
            # (and in the hardest of the pull, a sheet over their wings: shown in the title always)
            sheet = title_wing_vapour[i]
            wing_vapour_step(sheet, wing_vapour_strength(f64(length(racer.velocity)) / speed_scale, racer.load, damp), t)
            title_wing_vapour[i] = sheet
            # (low and fast, their downwash and prop wash streak the sea under them, as any aircraft's do)
            k = title_airframe_spec(racer.kind)
            water = f64(swell_at(f64(racer.at.x), f64(racer.at.z), t).x)
            skim = skim_amount(k, f64(racer.at.y) - k.float_height - water, racer.velocity)
            under = craft_offset(body, vec3(-racer.velocity.x * 0.15, f32(water + 0.1) - racer.at.y, -racer.velocity.z * 0.15))
            trail = title_wakes[i]
            wake_step(trail, under, racer.velocity, false, wake_width(Craft(racer.kind)), t, skim)
            title_wakes[i] = trail
            if skim > 0.15: emit(spray_ps, under, int(1.0 + skim * 3.0), 3.0 + 5.0 * skim, rgba(0.96, 0.98, 1.0, f32(0.4 + 0.4 * skim)), 1.0, 0.4 + 0.5 * skim, 0.7, normalize(vec3(-racer.velocity.x, 30.0, -racer.velocity.z)))
    # (while the screen is dark the world already looks where the next shot begins)
    free.pos = title_now.eye
    if let next = title_coming:
        if title_shot_age > title_shot.length - TITLE_DIP * 0.5: free.pos = title_view(next, 0.0, title_ground).eye
    keys_muted = true
    began = time()
    update_frame(dt, false)
    title_part("update", began)
    keys_muted = false
    when TARGET == "wasm":
        if not title_sound_on and (mouse_pressed(.left) or touches().len() > 0 or key_pressed(.enter) or key_pressed(.space) or key_pressed(.up) or key_pressed(.down)): title_sound_on = true
    when TARGET != "wasm": title_sound_on = true
    title_sound(dt)

# Ravel's Lever du jour through the receiver. The title's aircraft and battle are silent.
title_sound = (dt: f64):
    global title_music
    if not audio_enabled: return
    # (not before the first shot shows: the long frames of its first moments come first)
    if title.open and title_sound_on and title_shot_age > 0.2 and not title_music.playing and title_music.position == TITLE_MUSIC_FROM:
        title_music.playing = true
        print("TITLE music begins at frame {frame_number()}")
    title_music.volume = TITLE_MUSIC_VOLUME * title_music_fade
    music_audition_update(title_music, dt, audio_enabled)

# play begins (a new game where the startup left it, a loaded one, or a situation)
title_begin = ():
    global title_left_at,game_ui_note,title_start,title_kept,world_grove_anchor,world_grove_next_anchor,title_leaving
    title.open = false
    # (no page of the title's left open for when it next opens; no choice left waiting)
    title.page = 0; title.pick = -1
    title_leaving = none
    set_far_opening_deferred(false)
    far_opening_drop()
    step_audio_build(true)
    # (every shader not yet linked, now, before play's first frame: none waits for a first draw)
    pending = shaders_pending()
    if pending > 0:
        began = time()
        _ = warm_up_shaders()
        print("TITLE {pending} shaders linked for play in {(time() - began) * 1000.0:.0} ms")
    # (the reel's preparing let go: play's own view decides what is made)
    world_warm_clear(); world_towns_expect([]); world_grove_anchor = none; world_grove_next_anchor = none
    title_start = none
    title_kept = none
    title.loading = -1
    title_left_at = t
    global names_at_play
    names_at_play = title_name_draws
    game_ui_note = ""
    print("TITLE play: scenario '{active_scenario}', autosave slot {game_active_slot}, shaders pending {shaders_pending()}")
    global title_handover_frame
    title_handover_frame = frame_number()

# the slot Continue loads: the newest one that can be loaded
title_continue_slot = (rows: GameRow[]) -> int:
    title_latest(rows, [loop v in game_slot_views: v.summary.saved_at], [loop v in game_slot_views: v.summary.minute])

# the title's buttons, and what they ask of the game
draw_title_screen = ():
    global loading_t0
    # (the dip to dusk between shots, under the menu)
    v = visible_rect()
    if title_dip() > 0.002: rect(v, rgba(0.075, 0.1, 0.15, f32(title_dip())))
    if title_leaving != none:
        # (a choice made: the propeller turns on the dusk while play is made ready)
        if loading_t0 < 0.0: loading_t0 = elapsed()
        draw_loading_propeller(vec2(f32(f64(v.x) + f64(v.w) * 0.5), f32(f64(v.y) + f64(v.h) * 0.5)), elapsed() - loading_t0, 0.0)
        return
    if title_bare: return
    if title_first_waiting():
        # (the loading card's propeller turning on, its ring full, until the first shot is there;
        # in a page the page's own card is still up over it)
        if loading_t0 < 0.0: loading_t0 = elapsed()
        draw_loading_propeller(vec2(f32(f64(v.x) + f64(v.w) * 0.5), f32(f64(v.y) + f64(v.h) * 0.5)), elapsed() - loading_t0, 1.0)
        return
    rows = game_rows(game_slot_views, -1)
    status = game_save_status()
    ready = status.ready and game_slots_known
    pick = title_screen(title, fonts, rows, title_continue_slot(rows), ready, status.busy, game_ui_note, status.error != "" and game_ui_note == status.error)
    # (a choice to start play waits for play to be ready: title_leave_step makes it)
    if pick.act == "load" or pick.act == "new" or pick.act == "situation":
        global title_leaving, title_leaving_since
        title_leaving = pick; title_leaving_since = elapsed()
        return
    title_choose(pick)

# A choice waiting to start play: made once nothing play needs is left to prepare (or after
# TITLE_LEAVING_MOST); the tests' AEGEAN_TITLE_PICK made the same way once the title is ready.
title_leave_step = ():
    global title_leaving, title_pick_env, title_leaving_since
    if let want = title_pick_env:
        status = game_save_status()
        if status.ready and game_slots_known and not status.busy and title.age > 1.0:
            rows = game_rows(game_slot_views, -1)
            title_leaving = if want == "new": TitleChoice(act = "new") else: if want == "continue": TitleChoice(act = "load", slot = title_continue_slot(rows)) else: if want.starts_with("slot"): TitleChoice(act = "load", slot = (to_int(want[4..want.len()]) ?? 1) - 1) else: TitleChoice(act = "situation", key = want)
            title_pick_env = none
            title_leaving_since = elapsed()
            print("TITLE pick {want} at frame {frame_number()}, shaders pending {shaders_pending()}")
    if let pick = title_leaving:
        # (the shaders, the sounds and, for a new game, the far economy: each a slice a dusk frame)
        ready = shaders_pending() == 0 and audio_built and (pick.act != "new" or not far_opening_pending())
        if not ready and elapsed() - title_leaving_since < TITLE_LEAVING_MOST: return
        title_leaving = none
        print("TITLE leaving after {(elapsed() - title_leaving_since) * 1000.0:.0} ms, shaders pending {shaders_pending()}, sounds made {audio_built}, far economy pending {far_opening_pending()}")
        title_choose(pick)

# what a choice on the title does
title_choose = (pick: TitleChoice):
    match pick.act:
        "load": _ = request_game_load(pick.slot)
        "delete": _ = request_game_delete(pick.slot)
        "situation":
            if load_scenario(pick.key): title_begin()
        "new":
            # (the world as the startup built it, put back in place of the one the reel ran; its far
            # economy finished at once if the title had not had the time)
            step_far_opening(1.0e30)
            if let start = title_start:
                began = time()
                _ = load_scenario("start", start)
                print("TITLE new game: startup world restored in {(time() - began) * 1000.0:.0} ms")
            # (a new pilot: the harbour's mechanic waits on the dock to greet them)
            if options.guidance: welcome_begin(living_world, living_world.minute, welcome_spot())
            global game_active_slot
            if pick.slot >= 0: game_active_slot = pick.slot
            title_begin()
        _: pass

# what the Game page asked for: one request, the backend's to finish (the note says how it went)
game_page_apply = (r: DebugResult):
    if r.game=="" or r.game_slot<0:return
    global game_save_auto,game_ui_note
    accepted=if r.game=="save":request_game_save(r.game_slot) else if r.game=="load":request_game_load(r.game_slot) else:request_game_delete(r.game_slot)
    if accepted:game_save_auto=false
    game_ui_note=if accepted:"" else:"The saved games are busy; try again in a moment."

# what the debugging panel changed or asked for
debug_apply = (was: DebugView, v: DebugView, r: DebugResult):
    if v.paint != was.paint and v.paint_shop.mode == .free: set_player_paint(v.paint)
    game_page_apply(r)
    if r.scenario!="":load_scenario(r.scenario);return
    weather_anchor = if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos
    if r.weather >= 0: weather_choose(living_world,r.weather,weather_anchor)
    global hour, wind_bias
    c = living_world.people[living_world.player].craft
    if v.craft != was.craft:
        kind = Craft(clamp(v.craft, 0, CRAFT_NAMES.len() - 1))
        change_craft(kind, default_craft_model(kind))
        return
    if abs(v.fuel - was.fuel) > 0.0001:
        pc.state.fuel = v.fuel * pc.spec.fuel_capacity
        debug_fuel_ml(c, int(pc.state.fuel * 1000.0))
    st = pc.state
    loop k in 0..min(v.parts.len(), was.parts.len()):
        if abs(v.parts[k] - was.parts[k]) < 0.0001: continue
        id = pc.spec.parts[k].id
        i = int(id)
        if v.parts[k] <= 0.0:
            detach_part(pc.state.damage, pc.spec.parts, id, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        else:
            if not pc.state.damage.parts[i].attached:
                # (put back: its wreckage gone from the water)
                pc.state.damage.parts[i].attached = true
                pc.state.damage.debris = [loop db in pc.state.damage.debris if db.part != id: db]
            pc.state.damage.parts[i].health = v.parts[k]
    if c >= 0:
        if abs(v.hull_wear - was.hull_wear) > 0.0001: living_world.aircraft[c].hull = int((1.0 - v.hull_wear) * 1000.0 + 0.5)
        if abs(v.engine_wear - was.engine_wear) > 0.0001: living_world.aircraft[c].engine = int((1.0 - v.engine_wear) * 1000.0 + 0.5)
    if abs(v.hour - was.hour) > 0.0001: hour = v.hour % 24.0
    if r.weather >= 0 or abs(v.hour-was.hour) > 0.0001:
        # Preview the chosen weather/light while paused without advancing time.
        weather_scene_step(living_world,weather_anchor,hour,0.0)
    wind_bias = v.wind
    if abs(v.speed_scale - was.speed_scale) > 0.0001: apply_speed_scale(max(1.0, v.speed_scale))
    if abs(v.lift_scale - was.lift_scale) > 0.0001: set_lift_scale(v.lift_scale)
    if abs(v.bullet_scale - was.bullet_scale) > 0.0001: set_bullet_scale(v.bullet_scale)
    if abs(v.sea_rough - was.sea_rough) > 0.0001: set_sea_rough(v.sea_rough)
    match r.act:
        .repair:
            pc.state.damage = DamageState()
            pc.state.crashed = false
            pc.state.capsized = false
            pc.state.hull_damage = 0.0
            pc.state.engine_damage = 0.0
            if c >= 0:
                living_world.aircraft[c].hull = 1000
                living_world.aircraft[c].engine = 1000
        .wreck: detach_part(pc.state.damage, pc.spec.parts, .body, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        .money_add: debug_cents(player_cents() + 100000)
        .maps_all: _ = living.grant_every_map(living_world,living_world.player)
        .map_one:
            global debug_maps_given
            if r.map_on:
                g = living.grant_map_edition(living_world, r.map_edition, living_world.player)
                if g.0 >= 0: debug_maps_given[g.0] = (g.1, g.2)
                else: say_toast("No copy of that map is on a counter.")
            else:
                given = -1
                loop c in living.owned_maps(living_world, living_world.player):
                    if c.edition == r.map_edition and c.id in debug_maps_given: given = c.id
                if given >= 0:
                    from = debug_maps_given[given]
                    living.return_map_to_shop(living_world, given, from.0, from.1, living_world.player)
                    debug_maps_given.remove(given)
                else: say_toast("That map was bought or found in play: kept.")
        .money_set: debug_cents(r.phoenixes * 100)
        .to_altitude:
            p0 = if me.mode == .aboard: pc.state.position else: me.pos
            debug_place(f64(p0.x), f64(p0.z), dbg.altitude)
            set_paused(false)
        .pick:
            global show_chart
            dbg.picking = true
            dbg.open = false
            show_chart = true
        .to_town:
            tw = towns[r.town]
            dock = free_dock(tw, others_at(), tw.center) ?? tw.docks[0]
            h = atan2(f64(tw.out.x), -f64(tw.out.y))
            pc.state = water_start(pc.spec, dock, h)
            moor(pc.state, pc.state.position, h)
            pc.throttle = 0.0
            pc.placed = false
            tie_up()
            if me.mode != .aboard: step_ashore(dock)
            set_paused(false)
        _: pass

    # An explicit debug repair/part edit changes the authoritative physical body too.
    ci=combat_index(battle,c)
    if ci>=0:
        battle.actors[ci].state=pc.state
        if r.act==.repair:
            battle.actors[ci].fire=0;battle.actors[ci].fire_age=0
            battle.actors[ci].marks.clear();battle.actors[ci].last_attacker=-1
            battle.actors[ci].down_reported=false
            if not battle.actors[ci].bailed:battle.actors[ci].status=.flying

# (each kind's engine its own pitch, the bigger lower; each aircraft a touch its own)
engine_tone = (kind: Craft, craft: int) -> f64:
    base = aircraft_profile(kind).tone
    base * (1.0 + 0.03 * f64((craft * 37) % 7 - 3) / 3.0)

# the other aircraft's places (for keeping docks free)
# where every other aircraft is or is bound: those flying about, every one the world has tied up
# anywhere (drawn or not), and the docks claimed by those on their way in
others_at = () -> vec3[]:
    out = [loop tr in traffic: tr.state.position]
    mine = living_world.people[living_world.player].craft
    loop c in 0..living_world.aircraft.len():
        if c != mine: out.push(living_world.aircraft[c].pose.pos)
    loop id in living_world.active_trips:
        tp = living_world.trips[id]
        if tp.craft != mine and tp.claimed_dock >= 0: out.push(living_world.harbors[tp.destination].docks[tp.claimed_dock])
    out

# tie up at the bollard nearest the aircraft
tie_up = ():
    global was_moored
    if let b = nearest_bollard(towns, pc.state.position):
        rope.anchor = b
        rope.tied = true
        rope.loose = b
        was_moored = true

# where the player's aircraft is tied: the bollard its line is on (none: not moored)
mooring_anchor = () -> vec3?:
    if pc.state.moored and rope.tied: return rope.anchor
    if not pc.state.moored: return none
    p = vec2(pc.state.position.x, pc.state.position.z)
    best: vec3? = none
    bd = 40.0
    loop tw in towns:
        if length(vec2(tw.center.x, tw.center.z) - p) > 600.0: continue
        loop q in tw.quays:
            d = q.b - q.a
            u = clamp(dot(p - q.a, d) / dot(d, d), 0.0, 1.0)
            c = q.a + d * u
            off = p - c
            l = f64(length(off))
            if l < bd and l > 0.01:
                bd = l
                e = c + off / f32(l) * (q.width * 0.5 - 0.4)
                best = vec3(e.x, f32(QUAY_TOP + 0.5), e.y)
    best

# haul the line in a little: the aircraft comes alongside (to a few meters off the quay's edge)
haul_in = (dt: f64):
    if let a = mooring_anchor():
        p = pc.state.position
        off = vec3(p.x - a.x, 0, p.z - a.z)
        l = f64(length(off))
        if l > 3.6:
            step = min(1.4 * dt, l - 3.6)
            np = p - off / f32(l) * f32(step)
            pc.state.position = np
            pc.state.mooring_point = np

# off the aircraft onto the quay beside a dock (or the nearest walkable ground)
step_ashore = (near: vec3):
    if let p = shore_point(towns, near):
        me.pos = p
        me.mode = .walking
        follow.placed = false
        # (paying passengers get down here too, however the pilot came ashore: at a dock, by the
        # launch from a buoy, or climbing down from a landplane at an aerodrome)
        field = airfield_at(p.xz)
        place = if field >= 0: AIRFIELDS[field].place else: game_place_at(p)
        if place >= 0: deliver_here(place)

# ---------------- big aircraft: offshore buoys and the harbour launch ----------------
# (src/offshore_moorings.jo finds the buoys; src/harbour_launch.jo is the launch and its fare)

offshore: OffshoreMooring? = none   # the buoy the player's aircraft lies on, when it lies on one
launch = launches.LaunchRide()
launch_view = launches.LaunchView()
buoys_near: OffshoreMooring[]       # (the buoys of the harbour about, for the player's aircraft: drawn)
buoys_at = -1                       # (the harbour they belong to)

# the buoys of the harbour nearest a point for the player's aircraft (none away from harbours)
player_moorings = (p: vec3) -> OffshoreMooring[]:
    h = nearest_harbour(p.xz, 2500.0)
    if h < 0: return []
    offshore_moorings(h, swing_radius(pc.kind))

# where the line is made fast on the aircraft: the bow
rope_bow = () -> vec3:
    if big_boat(pc.kind): return vec3(0, 0.4, f32(-aircraft_profile(pc.kind).length * 0.48))
    vec3(1.4, -1.9, -2.6)

# lie on a buoy: head to seaward, the bow line to the buoy, at rest
moor_on_buoy = (m: OffshoreMooring):
    global offshore, was_moored
    back = heading_vector(m.heading) * f32(-(aircraft_profile(pc.kind).length * 0.5 + 4.0))
    at = m.at + back
    pc.state = water_start(pc.spec, vec3(at.x, 0, at.z), m.heading)
    moor(pc.state, pc.state.position, m.heading)
    pc.throttle = 0.0
    pc.placed = false
    pc.aim_heading = m.heading
    rope.anchor = launches.buoy_top(m.at); rope.tied = true; rope.loose = rope.anchor
    was_moored = true
    offshore = m

# the buoy the moored aircraft's line is on (after loading a game: found again from the line)
find_offshore_berth = () -> OffshoreMooring?:
    if not pc.state.moored or not rope.tied: return none
    loop m in player_moorings(pc.state.position):
        if f64(length(launches.buoy_top(m.at) - rope.anchor)) < 1.0: return m
    none

# a buoy near the bow, when slow on the water: where a big aircraft can make fast
buoy_spot = () -> OffshoreMooring?:
    st = pc.state
    if st.moored or not st.on_water or length(vec3(st.velocity.x, 0, st.velocity.z)) > 2.5: return none
    bow = st.position + quat_rotate(st.orientation, vec3(0, 0, f32(-aircraft_profile(pc.kind).length * 0.5)))
    loop m in buoys_near:
        if f64(length(vec2(m.at.x - bow.x, m.at.z - bow.z))) < 30.0: return m
    none

# a dock for the aircraft: none for one too big for the docks
dock_spot = () -> vec3?: if offshore_only(pc.kind): none else: mooring_spot(pc, towns)

# A big aircraft just taken (from the pause menu, or at the start): where it was, unless it
# doesn't fit there; then on the nearest clear buoy, or in clear open water. Never over land, a
# dock or a building. Flying, it keeps flying. board: the pilot aboard.
settle_big_craft = (board: bool):
    global offshore
    st = pc.state
    if not st.on_water and not st.moored and (f64(st.position.y) > 25.0 or f64(length(st.velocity)) > 15.0):
        if board: me.mode = .aboard
        return
    ms = player_moorings(st.position)
    if ms.len() > 0: moor_on_buoy(ms[0])
    else:
        r = swing_radius(pc.kind)
        if let c = clear_water_near(st.position.xz, r):
            h = heading(st)
            pc.state = water_start(pc.spec, vec3(c.x, 0, c.y), h)
            pc.throttle = 0.0; pc.placed = false
            rope.tied = false; offshore = none
        else: say_toast("No clear water near enough for the {CRAFT_NAMES[int(pc.kind)]}")
    if board:
        me.mode = .aboard
        pc.placed = false

# alongside the moored aircraft, where the launch comes to (its boarding side, a little off)
launch_alongside = () -> vec3:
    m = craft_models[pc.model]
    side = quat_rotate(pc.state.orientation, vec3(1, 0, 0))
    world_vec(craft_offset(pc.state, quat_rotate(pc.state.orientation, m.exit))) + side * f32(aircraft_profile(pc.kind).width + 3.0)

# the dock berth of the buoy's harbour nearest a point
launch_dock = (near: vec3) -> vec3:
    best = offshore!.dock; bd = 1e18
    loop d in harbour_docks(offshore!.place):
        l = f64(length(d.xz - near.xz))
        if l < bd: bd = l; best = d
    best

# on foot by a dock of the harbour whose buoy the aircraft lies on
by_launch_dock = () -> bool:
    if offshore == none or not pc.state.moored or me.mode != .walking: return false
    loop d in harbour_docks(offshore!.place):
        if f64(length(d.xz - me.pos.xz)) < 16.0: return true
    false

# the harbour launch out to the aircraft (outward) or back to the dock: paid, then ridden
start_launch = (outward: bool):
    global launch
    if offshore == none: return
    alongside = launch_alongside()
    dock = launch_dock(if outward: me.pos else: alongside)
    fare = launches.pay_launch(living_world, offshore!.place)
    launch = launches.launch_ride(offshore!.place, dock, alongside, outward)
    launch.fare = fare
    me.mode = .free
    mouse_lock(false)
    say_toast(if fare > 0: "The harbour launch, {phoenix_text(fare)}.  F  to skip the ride" else: "The boatman waves the fare away.  F  to skip the ride")

# the ride's end: aboard the aircraft, or on the quay by the dock
finish_launch = ():
    global launch
    if not launch.active: return
    launch.active = false
    if launch.outward:
        me.mode = .aboard
        pc.placed = false
        pc.throttle = 0.0
        mouse_lock(true)
    else:
        me.mode = .walking
        step_ashore(launch.to)
        follow.placed = false

# each frame of a seen ride: the launch on its way, the camera behind it; F cuts it short
launch_step = (dt: f64, typing: bool):
    global launch
    launch.t += dt
    view = launches.launch_camera(launch)
    free.pos = view.0
    d = normalize(view.1 - view.0)
    free.yaw = atan2(-f64(d.x), -f64(d.z)); free.pitch = asin(f64(d.y))   # (the fly camera looks (-sin yaw, -cos yaw))
    if not typing and (vpressed(.f) or vpressed(.space)) and launch.t > 0.3:
        left = max(1, int(f64(launch.minutes) * (1.0 - launch.t / max(launch.duration, 0.1))))
        leisure_skip(left, if launch.outward: "Out to the {CRAFT_NAMES[int(pc.kind)]} in the harbour launch" else: "Ashore in the harbour launch", 2)
        return
    # (its wash: spray off the bow and a stream astern, as long as it is under way)
    pose = launches.launch_pose(launch)
    u = launch.t / max(launch.duration, 0.1)
    if u > 0.05 and u < 0.95 and spray_ps.items.len() < 900 and frame_number() % 2 == 0:
        dir = vec3(f32(sin(pose.1)), 0, f32(cos(pose.1)))
        stern = pose.0 - dir * 4.2 + vec3(0, 0.05, 0)
        emit(spray_ps, world_point(stern), 2, 1.2, rgba(0.95, 0.97, 1, 0.8), 1.1, 0.35, 0.6, normalize(vec3(0, 1, 0) - dir * 0.6))
        loop side in [-1.0, 1.0]:
            bow = pose.0 + dir * 3.3 + vec3(dir.z, 0, -dir.x) * f32(side * 0.9) + vec3(0, 0.05, 0)
            emit(spray_ps, world_point(bow), 1, 2.0, rgba(0.95, 0.97, 1, 0.85), 0.6, 0.22, 0.5, normalize(vec3(f32(side) * dir.z, 1.0, f32(-side) * dir.x)))
    if launches.launch_done(launch): finish_launch()

# ---- lying to the wind on a buoy (and the fuel lighter that comes out to it) ----

swing_rate = 0.0                    # (how fast the moored aircraft is turning on its buoy, rad/s)

# moored on a buoy, the aircraft swings head to wind round it (src/offshore_moorings.jo buoy_swing);
# the swing circle each buoy was chosen for holds it at any heading
swing_on_buoy = (dt: f64):
    global swing_rate
    if offshore == none or not pc.state.moored or dt <= 0.0:
        swing_rate = 0.0
        return
    f = quat_rotate(pc.state.mooring_orientation, vec3(0, 0, -1))
    h = atan2(f64(f.x), -f64(f.z))
    len = aircraft_profile(pc.kind).length
    s = buoy_swing(h, swing_rate, wind_now.dir, wind_now.speed, len, dt)
    swing_rate = s.1
    c = moored_centre(offshore!.at, s.0, len)
    pc.state.mooring_point = vec3(c.x, f32(pc.spec.float_height), c.z)
    pc.state.mooring_orientation = quat_euler(0, -s.0, 0)
    # (the moored aircraft is posed from these: held there, not flown)
    pc.state.position = pc.state.mooring_point; pc.state.precise_ready = false
    pc.state.orientation = pc.state.mooring_orientation

lighter = launches.LaunchRide()
lighter_phase = 0                   # 0 none, 1 putting out, 2 alongside (the fuel panel), 3 going home
lighter_dock = vec3(0, 0, 0)
lighter_pier = refuel.FuelPier()
lighter_seen: refuel.FuelPier? = none
lighter_seen_frame = -100

# the fuel pier of the buoy's harbour, which the lighter carries the fuel and prices of (none where
# the harbour sells no fuel); looked up every few frames
lighter_pier_here = () -> refuel.FuelPier?:
    global lighter_seen, lighter_seen_frame
    if offshore == none: return none
    if frame_number() - lighter_seen_frame >= 30 or frame_number() < lighter_seen_frame:
        lighter_seen = refuel.fuel_pier_at(living_world, offshore!.dock, 60.0)
        lighter_seen_frame = frame_number()
    lighter_seen

# the card's words aboard on a buoy with room in the tank, or ""
lighter_offer = () -> str:
    if offshore == none or not pc.state.moored or lighter_phase != 0 or launch.active or ui != .none: return ""
    c = living_world.people[living_world.player].craft
    if c < 0 or lt.AIRFRAMES[int(living_world.aircraft[c].kind)].tank_ml - living_world.aircraft[c].fuel_ml < 1000: return ""
    if let p = lighter_pier_here(): return "call the fuel lighter out ({fuel_litre_price(refuel.fuel_price(living_world, p))} a litre, {phoenix_text(launches.LIGHTER_FEE)} to come out)"
    ""

# pay the call-out and send the lighter out from the dock to lie alongside
call_lighter = ():
    global lighter, lighter_phase, lighter_dock, lighter_pier
    if offshore == none: return
    p = lighter_pier_here()
    if p == none: return
    if launches.pay_harbour(living_world, offshore!.place, launches.LIGHTER_FEE) == 0:
        say_toast("The lighterman wants {phoenix_text(launches.LIGHTER_FEE)} to come out; you have {phoenix_text(player_cents())}.")
        return
    lighter_pier = p!
    alongside = launch_alongside()
    lighter_dock = launch_dock(alongside)
    lighter = launches.launch_ride(offshore!.place, lighter_dock, alongside, true)
    lighter_phase = 1
    say_toast("The fuel lighter is putting out from {p!.name}, {phoenix_text(launches.LIGHTER_FEE)} for the trip.")

lighter_home = ():
    global lighter, lighter_phase
    at = launches.launch_pose(lighter).0
    lighter = launches.launch_ride(lighter.place, lighter_dock, at, false)
    lighter_phase = 3

# each frame: out to the aircraft, the fuel panel once alongside (the sale is the pier's own,
# through the ledger), home when it closes or the aircraft casts off
lighter_step = (dt: f64):
    global lighter, lighter_phase, ui, fuel_panel_pier, fuel_notice, fuel_offered_at
    if lighter_phase == 0: return
    if lighter_phase == 1 or lighter_phase == 3: lighter.t += dt
    if lighter_phase == 1:
        if offshore == none or not pc.state.moored or me.mode != .aboard: lighter_home()
        else if launches.launch_done(lighter):
            lighter_phase = 2
            pier = lighter_pier
            pier.dock = lighter.to
            fuel_panel_pier = pier
            fuel_notice = ""
            fuel_offered_at = pc.state.position
            ui = .fuel
            mouse_lock(false)
    else if lighter_phase == 2:
        if ui != .fuel and not refueling(): lighter_home()
    else if lighter_phase == 3 and launches.launch_done(lighter):
        lighter_phase = 0
        lighter.active = false

# the buoys about (once in a while: a harbour's are found once, then kept)
refresh_buoys = ():
    global buoys_near, buoys_at, offshore
    if not pc.state.moored: offshore = none
    if not offshore_only(pc.kind) and offshore == none:
        buoys_near = []; buoys_at = -1
        return
    at = if me.mode == .aboard: pc.state.position else: me.pos
    h = nearest_harbour(at.xz, 2500.0)
    if h == buoys_at: return
    buoys_at = h
    buoys_near = if h >= 0: offshore_moorings(h, swing_radius(pc.kind)) else: []

# (AEGEAN_CRAFT a big boat: it starts on its buoy off the home harbour, not at a dock)
if offshore_only(pc.kind): settle_big_craft(me.mode == .aboard)
refresh_buoys()
# (AEGEAN_FLYING's and AEGEAN_CAPTURE_TAKEOFF's full tank goes to the aircraft's record too, through
# the debugging ledger: the record is the fuel's owner and would put back the starting Gull's litres
# a frame later)
if env("AEGEAN_FLYING") != none or env("AEGEAN_CAPTURE_TAKEOFF") != none: debug_fuel_ml(living_world.people[living_world.player].craft, int(pc.state.fuel * 1000.0))

# AEGEAN_CAPTURE_LAUNCH=out|ashore|cut (captures): at frame 60 the harbour launch sets out from the
# home dock to the big aircraft on its buoy (cut: and the ride is skipped), or comes for the pilot
# aboard; what it cost and where it ended are printed (LAUNCH lines). No effect in ordinary play.
launch_capture = env("AEGEAN_CAPTURE_LAUNCH") ?? ""
# (buoy: whatever the aircraft, on the home harbour's H-4 buoy: like-for-like frame timing)
if launch_capture == "buoy":
    ms = offshore_moorings(0, swing_radius(.hughes_h4))
    if ms.len() > 0: moor_on_buoy(ms[0])
splash_prev: f64[] = fill(0.0, 7)
splash_seen: bool[] = fill(false, 7)
splash_jump = 0.0
launch_capture_step = ():
    # (paintsave: the game captured and applied again, as a load does, after the paint was changed
    # back: the saved paint comes back with it, and the record's livery with it)
    if launch_capture == "paintsave" and frame_number() == 90:
        g = capture_running_game()
        if g is lt.SaveGame:
            saved = player_paint
            set_player_paint(paint_reset(int(pc.kind)))
            runtime = read_game_session(g)
            ok = runtime is GameSession and apply_saved_game(g, runtime as GameSession)
            rec = living_world.people[living_world.player].craft
            print("PAINT save round trip {ok}: saved {to_text(saved)}, restored {to_text(player_paint)}, record {LIVERY_NAMES[living_world.aircraft[rec].livery_index]}, same {player_paint == saved}")
        else: print("PAINT save refused: {g.message}")
        return
    # (paintshop: the paint shop gone through as the player would: the mechanic asked, a paint
    # chosen (AEGEAN_PAINT_DRAFT), ordered and paid, the game saved and loaded with her in the shop,
    # the time waited, the paint dry. PAINTSHOP lines say how each step went.)
    # (run from paint_step, which goes on while the pause menu is open)
    if launch_capture == "paintshop": return
    # (lighter: at frame 60 the fuel lighter is called; once alongside, a full tank bought and the
    # panel closed; LIGHTER lines say what happened, the fuel and the books)
    if launch_capture == "lighter":
        global ui
        if frame_number() == 61:
            # (a camera off the aircraft's boarding side, where the lighter comes alongside)
            global judge_camera, judge_origin
            judge_origin = pc.state.position
            side = quat_rotate(pc.state.orientation, vec3(1, 0, 0)); fwd = forward(pc.state)
            size = aircraft_profile(pc.kind).length
            judge_camera = JudgeView(pc.state.position + side * f32(size * 0.9) + fwd * f32(size * 0.45) + vec3(0, f32(size * 0.12), 0), lighter.to + vec3(0, 2, 0), "the fuel lighter")
        if frame_number() == 60:
            c = living_world.people[living_world.player].craft
            debug_fuel_ml(c, 1000)
            pc.state.fuel = 1.0
            purse0 = player_cents()
            call_lighter()
            print("LIGHTER called: phase {lighter_phase} purse {purse0} -> {player_cents()} ledger {launches.ledger_balances(living_world)}")
        if lighter_phase == 2 and ui == .fuel and not refueling() and fuel_notice == "":
            fuel_take(3)
            print("LIGHTER alongside at frame {frame_number()}: {fuel_notice} fuel {pc.state.fuel:.0} purse {player_cents()} ledger {launches.ledger_balances(living_world)}")
        if lighter_phase == 2 and ui == .fuel and fuel_notice != "" and not refueling(): ui = .none
        if frame_number() % 60 == 0: print("LIGHTER frame {frame_number()} phase {lighter_phase} t {lighter.t:.1} ui {ui}")
        return
    # (swing: the wind held abeam of the moored aircraft at 8 m/s; it comes round head to wind)
    if launch_capture == "swing":
        if frame_number() == 31:
            global judge_camera, judge_origin
            judge_origin = pc.state.position
            judge_camera = JudgeView(offshore!.at + vec3(0, 140, 30), offshore!.at, "on the buoy, from above")
        if frame_number() >= 30:
            f0 = heading_vector(offshore!.heading + PI / 2)
            wind_now.dir = vec2(-f0.x, -f0.z); wind_now.speed = 8.0
        if frame_number() % 120 == 0:
            f = forward(pc.state)
            fm = quat_rotate(pc.state.mooring_orientation, vec3(0, 0, -1))
            print("SWING frame {frame_number()} moor {atan2(f64(fm.x), -f64(fm.z)):.3} heading {atan2(f64(f.x), -f64(f.z)):.3} target {atan2(-f64(wind_now.dir.x), f64(wind_now.dir.y)):.3} rate {swing_rate:.4} from buoy {length((pc.state.position - offshore!.at).xz):.1}")
        return
    # (shot:water34|side|flight: the coordinator's model captures, a camera set off the aircraft
    # by its size, three-quarter ahead, abeam, or riding along in flight)
    if launch_capture.starts_with("shot:"):
        if frame_number() == 40:
            global judge_camera, judge_origin
            judge_origin = pc.state.position
            f = heading_vector(heading(pc.state)); r = heading_vector(heading(pc.state) + PI / 2)
            size = max(aircraft_profile(pc.kind).span, aircraft_profile(pc.kind).length)
            at = pc.state.position + vec3(0, f32(size * 0.06), 0)
            eye = match launch_capture[5..]:
                "side": at + r * f32(size * 1.45) + vec3(0, f32(size * 0.05), 0)
                "flight": at + r * f32(size * 1.1) + f * f32(size * 0.55) + vec3(0, f32(size * 0.12), 0)
                _: at + f * f32(size * 0.95) + r * f32(size * 0.75) + vec3(0, f32(size * 0.22), 0)
            judge_camera = JudgeView(eye, at, launch_capture)
            print("SHOT {launch_capture} eye {eye} at {at} craft {pc.state.position}")
        if launch_capture == "shot:flight": pc.throttle = 0.75
        return
    # (takeoff: from frame 30, a run out to sea from 1.2 km off the home harbour at full throttle)
    if launch_capture.starts_with("takeoff"):
        global splash_jump
        if frame_number() == 31 and launch_capture == "takeoff-side":
            # (a camera abeam, riding along: the spray seen from the side)
            global judge_camera, judge_origin
            judge_origin = pc.state.position
            f = heading_vector(along_quay); r = vec3(-f.z, 0, f.x)
            eye = pc.state.position + r * f32(pc.spec.span * 1.3) + f * f32(pc.spec.span * 0.35) + vec3(0, 5, 0)
            judge_camera = JudgeView(eye, pc.state.position + vec3(0, 3, 0), "takeoff, abeam")
        if frame_number() == 30:
            global offshore
            p0 = home.docks[0] + vec3(home.out.x, 0, home.out.y) * 1200.0
            unmoor(pc.state); rope.tied = false; offshore = none
            pc.state = water_start(pc.spec, vec3(p0.x, 0, p0.z), along_quay)
            pc.aim_heading = along_quay; pc.placed = false; me.mode = .aboard
        if frame_number() >= 30: pc.throttle = 1.0
        # (how far each spray root jumps along the hull from one frame to the next: the largest of
        # the last two seconds, over the parts that are throwing spray)
        loop k in 0..7:
            sh = splash_motion.sheets[k]
            if sh.amount < 0.05:
                splash_seen[k] = false
                continue
            d = world_delta(sh.root, craft_point(pc.state))
            z = f64(dot(d, quat_rotate(pc.state.orientation, vec3(0, 0, 1))))
            if splash_seen[k]: splash_jump = max(splash_jump, abs(z - splash_prev[k]))
            splash_prev[k] = z; splash_seen[k] = true
        if frame_number() % 120 == 0:
            print("LAUNCH takeoff t {pc.state.time:.0} speed {length(pc.state.velocity):.1} y {pc.state.position.y:.1} water {pc.state.on_water} spray {spray_ps.items.len()} root jump {splash_jump:.2} m")
            splash_jump = 0.0
        return
    # (switch:ID: at frame 60 the pause menu's change to that type, wherever one is)
    if launch_capture.starts_with("switch:") and frame_number() == 60:
        kind = Craft(clamp(to_int(launch_capture[7..]) ?? 0, 0, CRAFT_NAMES.len() - 1))
        was = pc.state.position
        change_craft(kind, default_craft_model(kind))
        print("LAUNCH switch to {CRAFT_NAMES[int(kind)]} from {was} to {pc.state.position}, moored {pc.state.moored}, buoy {offshore != none}, mode {me.mode}, ground under {surface_height(f64(pc.state.position.x), f64(pc.state.position.z)):.1}")
        return
    if frame_number() == 60 and offshore != none:
        if launch_capture == "ashore" or launch_capture == "save":
            me.mode = .aboard
            start_launch(false)
        else:
            d = offshore!.dock
            me.mode = .walking; me.pos = vec3(d.x, f32(walk_height(towns, f64(d.x), f64(d.z))), d.z)
            start_launch(true)
            if launch_capture == "cut": leisure_skip(launch.minutes, "Out to the {CRAFT_NAMES[int(pc.kind)]} in the harbour launch", 2)
        print("LAUNCH start {launch_capture} fare {launch.fare} from {launch.from} to {launch.to} seen {launch.duration:.1} s, {launch.minutes} min; purse {player_cents()}; ledger {launches.ledger_balances(living_world)}")
    # (save: ashore by the launch, the running game captured and applied again, as a load does)
    if launch_capture == "save" and frame_number() == 900:
        g = capture_running_game()
        if g is lt.SaveGame:
            runtime = read_game_session(g)
            pc.state.position = vec3(0, 50, 0)
            global offshore
            offshore = none
            ok = runtime is GameSession and apply_saved_game(g, runtime as GameSession)
            print("LAUNCH save round trip {ok}: mode {me.mode} moored {pc.state.moored} at {pc.state.position} buoy {offshore != none} line {rope.tied} {rope.anchor}; purse {player_cents()} ledger {launches.ledger_balances(living_world)}")
        else: print("LAUNCH save refused: {g.message}")
    if frame_number() > 60 and frame_number() % 30 == 0 and launch_capture != "":
        print("LAUNCH frame {frame_number()} active {launch.active} t {launch.t:.1} mode {me.mode} pos {me.pos} skip {skip.active}")

# A look at the cats and the pilot's face for captures (AEGEAN_CAT_CAPTURE=pet|feed|face): the
# player set down by a town cat (AEGEAN_CAT_CAPTURE_INDEX: the nearest, the next...) that knows
# them; it follows them out into the street, where it is stroked or fed over and over, the camera
# turned to see it from the side; face: the follow camera turned to the pilot's face. No effect in
# ordinary play.
cat_capture = env("AEGEAN_CAT_CAPTURE") ?? ""
cat_capture_step = 0
cat_capture_home = vec4(0, 0, 0, 0)
cat_capture_frame = 0
cat_capture_update = ():
    global cat_capture_step, cat_capture_home, cat_capture_frame, follow
    if me.mode != .walking or frame_number() < 20: return
    if cat_capture == "face":
        follow.yaw = me.yaw + 0.45
        follow.distance = to_float(env("AEGEAN_CAT_CAPTURE_DISTANCE") ?? "5.5") ?? 5.5
        return
    out = (h: vec4, d: f64) -> vec3:
        yaw = f64(h.w) + PI
        p = h.xyz + vec3(f32(sin(yaw) * d), 0, f32(cos(yaw) * d))
        vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)
    if cat_capture_step == 0:
        homes = town_cat_homes(me.pos, 900.0)
        if homes.len() == 0: return
        homes.sort((h: vec4) -> f32: length(h.xz - me.pos.xz))
        cat_capture_home = homes[min(homes.len() - 1, (to_int(env("AEGEAN_CAT_CAPTURE_INDEX") ?? "0") ?? 0))]
        presentation.cat_bonds[cat_key(f64(cat_capture_home.x), f64(cat_capture_home.z))] = lt.CatBond(fondness = 90, minute = living_world.minute)
        me.pos = out(cat_capture_home, 1.2); follow.placed = false
        cat_capture_step = 1; cat_capture_frame = frame_number()
    else if cat_capture_step == 1 and frame_number() > cat_capture_frame + 40:
        me.pos = out(cat_capture_home, 6.0)
        me.yaw = f64(cat_capture_home.w)
        cat_capture_step = 2
    else if cat_capture_step == 2:
        follow.yaw = me.yaw + PI + (to_float(env("AEGEAN_CAT_CAPTURE_TURN") ?? "1.45") ?? 1.45); follow.distance = 2.6; follow.height = 0.8
        if not cat_busy(cat_scene):
            k = nearest_cat(cat_scene, me.pos, 1.5)
            if k >= 0 and not cat_scene.cats[k].act == .walk: me.yaw = cat_begin(cat_scene, k, cat_capture == "feed", me.pos)

thermal_credit=0.0
# ---------------- a picnic (src/picnic.jo) ----------------
# The basket carried along (flown wherever one likes); on a quiet shore a tap on the sand (or F
# standing there) spreads the blanket: he sits, the sea in front of him, and the afternoon goes
# by; a bite now and then. Tap the basket (or Escape, or walk off) to pack up.
picnic = Picnic()
picnic_credit = 0.0
picnic_capture_spot = vec3(0, 0, 0)
picnic_mesh: Mesh? = none
picnic_basket_mesh: Mesh? = none

# Whether a point on the ground is a picnic spot, and which way the sea is from it.
picnic_spot_at = (p: vec3) -> (bool, f64):
    h = walk_height(towns, f64(p.x), f64(p.z))
    # (the land itself, not a quay or a pier over the water: the ground there above the sea, and
    # nothing built up over it)
    land = surface_height(f64(p.x), f64(p.z))
    # (nor in a town: no house within a dozen metres)
    paved = land < 0.15 or h - land > 0.3
    tk = town_here(p)
    if tk >= 0:
        loop c in towns[tk].houses:
            if f64(length(vec2(c.x - p.x, c.z - p.z))) < 12.0: paved = true; break
    depths: f64[] = []
    loop k in 0..12:
        a = f64(k) * TAU / 12.0
        deepest = 0.0
        loop r in [8.0, 14.0, PICNIC_SEA_REACH]:
            q = vec2(f32(f64(p.x) + sin(a) * r), f32(f64(p.z) + cos(a) * r))
            deepest = max(deepest, -surface_height(f64(q.x), f64(q.y)))
        depths.push(deepest)
    ang = picnic_sea_angle(depths)
    (picnic_spot_ok(h, paved, ang), ang)

picnic_begin = ():
    global picnic, me, follow
    ok, ang = picnic_spot_at(me.pos)
    if not ok or not picnic.basket: return
    picnic.active = true; picnic.at = me.pos; picnic.yaw = ang; picnic.since = t; picnic.settle = 0.0
    picnic.next_bite = t + 5.0; picnic.bites = 0
    tk = town_here(me.pos)
    picnic.place = if tk >= 0: towns[tk].name else: ""
    me.yaw = ang; me.stride = 0.0
    mouse_lock(false)

# packing up: up off the blanket by degrees, the basket emptied and done with
picnic_pack = ():
    global picnic
    if not picnic.active or picnic.settle < 0.0: return
    picnic.settle = min(picnic.settle, 1.0) - 1e-6
    picnic.since = -1.0             # (packing)

# where the basket stands on the blanket (for a tap on it)
picnic_basket_at = () -> vec3: picnic.at + vec3(f32(sin(picnic.yaw + 1.9) * 0.75), 0, f32(cos(picnic.yaw + 1.9) * 0.75))

picnic_basket_hit = (p: vec2) -> bool:
    o, d = screen_ray(p)
    b = picnic_basket_at()
    ray_box(o, d, b - vec3(0.45, 0.1, 0.45), b + vec3(0.45, 0.6, 0.45)) >= 0.0

# Each frame on the blanket: settling, the world's clock, a bite now and then, the view, and the
# ways to pack up. True while it has the walking to itself.
picnic_step = (dt: f64) -> bool:
    global picnic, me, walker_point, walker_published, follow, follow_frame, picnic_credit, hour
    if not picnic.active: return false
    if picnic.since < 0.0:
        picnic.settle -= dt / 0.9
        if picnic.settle <= 0.0:
            log_note(notebook, picnic_note(picnic), clock_text(living_world, living_world.minute))
            picnic = Picnic()
            return true
    else:
        picnic.settle = min(1.0, picnic.settle + dt / 1.0)
        # (unhurried: about a minute of the world's clock a second)
        picnic_credit += dt * PICNIC_MINUTES_A_SECOND
        if picnic_credit >= 1.0:
            picnic_credit -= 1.0
            living.advance_minutes(living_world, 1)
            hour = f64(lt.local_minute(living_world.minute)) / 60.0
        if picnic_bite_due(picnic, t): picnic.bites += 1; picnic.next_bite = t + PICNIC_BITE_EVERY
        # (the basket tapped or clicked, Escape, or walking off: pack up)
        tapped = (pad.tapped and picnic_basket_hit(pad.tap_at)) or (not pad.on and mouse_pressed(.left) and picnic_basket_hit(foot_aim()))
        if tapped or vpressed(.escape) or length(walk_axis()) > 0.1 or pad.walking: picnic_pack()
    me.pos = picnic.at; me.yaw = picnic.yaw; me.stride = 0.0
    walker_point = world_point(me.pos); walker_published = me.pos
    follow.yaw = approach_angle(follow.yaw, picnic.yaw + PI + 0.55, 1.0, dt)
    follow.distance = approach(follow.distance, 4.6, 1.2, dt)
    follow.pitch = approach(follow.pitch, 0.16, 1.2, dt)
    update_player_follow(dt, input = false)
    true

# (his right hand to his mouth for a moment after each bite)
picnic_biting = () -> bool: picnic.active and picnic.bites > 0 and t < picnic.next_bite - PICNIC_BITE_EVERY + 1.4

# The blanket and what is on it, or the basket on his arm as he walks.
draw_picnic = (L: Light):
    global picnic_mesh, picnic_basket_mesh
    if not picnic.basket: return
    if picnic_basket_mesh == none:
        vs: Vertex3D[]
        add_box(vs, vec3(0, 0.12, 0), vec3(0.42, 0.24, 0.28), rgb(0.66, 0.5, 0.28))
        loop k in 0..4: add_box(vs, vec3(0, f32(0.04 + f64(k) * 0.06), 0), vec3(0.43, 0.012, 0.29), rgb(0.5, 0.36, 0.18))
        add_box(vs, vec3(0, 0.25, 0), vec3(0.4, 0.02, 0.26), rgb(0.86, 0.82, 0.72))
        loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(side * 0.15), 0.36, 0), vec3(0.025, 0.24, 0.025), rgb(0.5, 0.36, 0.18))
        add_box(vs, vec3(0, 0.47, 0), vec3(0.33, 0.025, 0.025), rgb(0.5, 0.36, 0.18))
        picnic_basket_mesh = custom_mesh(vs)
    if not picnic.active:
        if me.mode != .walking: return
        side = vec3(f32(cos(me.yaw)), 0, f32(-sin(me.yaw)))
        if let m = picnic_basket_mesh: draw(obj_sh, m, obj_params(L, t, translation(me.pos + side * 0.32 + vec3(0, 0.42, 0)) * rotation_y(me.yaw) * scaling(0.85)))
        return
    if picnic_mesh == none:
        vs: Vertex3D[]
        loop k in 0..7: add_box(vs, vec3(f32(-0.78 + f64(k) * 0.26), 0.01, 0), vec3(0.26, 0.012, 1.3), if k % 2 == 0: rgb(0.62, 0.17, 0.14) else: rgb(0.9, 0.84, 0.7))
        picnic_mesh = custom_mesh(vs)
    open = clamp(picnic.settle, 0.0, 1.0)
    if let m = picnic_mesh: draw(obj_sh, m, obj_params(L, t, translation(picnic.at + vec3(0, 0.005, 0)) * rotation_y(picnic.yaw) * scaling(vec3(f32(open), 1.0, f32(open)))))
    if let m = picnic_basket_mesh: draw(obj_sh, m, obj_params(L, t, translation(picnic_basket_at()) * rotation_y(picnic.yaw + 0.4)))
    if open > 0.9:
        ahead = vec3(f32(sin(picnic.yaw)), 0, f32(cos(picnic.yaw))); right = vec3(f32(cos(picnic.yaw)), 0, f32(-sin(picnic.yaw)))
        spot = picnic.at + ahead * 0.55
        draw_serving(serve_parts, Served(MenuItem("Bread", "Food", "Picnic", serve = .plate, food = true), 0, 0, amount = 0.7), translation(spot - right * 0.25 + vec3(0, 0.02, 0)) * scaling(1.2), L, t)
        draw_serving(serve_parts, Served(MenuItem("Wine", "Wine", "Picnic", serve = .bottle), 0, 0), translation(spot + right * 0.3 + vec3(0, 0.02, 0)) * scaling(1.2), L, t)
        draw_serving(serve_parts, Served(MenuItem("Olives", "Food", "Picnic", serve = .bowl, food = true), 0, 0, amount = 0.6), translation(spot + ahead * 0.2 + vec3(0, 0.02, 0)) * scaling(1.2), L, t)

# ---------------- taking the waters (src/bath.jo) ----------------
# By the things themselves: the keeper at the bathhouse door (pay), the hot pool (get in: changing
# first), the steps (get out). The keys work as before: F at the pool's edge, R to come out.
bath = Bath()
bath_hurry = false                  # (F or T asked for an hour, or till evening: the old quick passing)
bath_figs: {int: Figure} = {}       # (the bathers and the keeper, in their bathing things or not)
bath_keeper_fig: Figure? = none

# where things are at a site, in the world (its frame: +z downhill, x across)
bath_keeper_at = (site: ThermalSite) -> vec3: thermal_world(site, vec3(-6.4, 0, -1.2))
bath_cabin_door = (site: ThermalSite) -> vec3: thermal_world(site, vec3(-8.0, 0, -0.9))
bath_steps = (site: ThermalSite) -> vec3: thermal_world(site, vec3(THERMAL_POOL.x, f32(-site.drops.x), THERMAL_POOL.y + 5.0))
bath_spot = (site: ThermalSite, k: int) -> vec3:
    a = [2.25, 3.35, 4.3][k % 3]
    thermal_world(site, vec3(THERMAL_POOL.x + f32(sin(a) * 3.3), f32(-0.72 - site.drops.x), THERMAL_POOL.y + f32(cos(a) * 3.3)))
bath_spot_yaw = (site: ThermalSite, k: int) -> f64: site.yaw + [2.25, 3.35, 4.3][k % 3] + PI

# the site he's at (within its grounds), or -1
bath_site_here = () -> int:
    if not geography_enabled: return -1
    loop k in 0..THERMAL_SITES.len():
        if f64(length(me.pos - THERMAL_SITES[k].center)) < 45.0: return k
    -1

# the keeper: the town's innkeeper if it has one, else the town's own (by its account)
bath_keeper_person = (site: ThermalSite) -> int:
    if not (site.place in living_world.far.districts): return -1
    loop person in living_world.far.districts[site.place].named:
        if living_world.people[person].occupation == .innkeeper or living_world.people[person].occupation == .hotelier: return person
    -1
bath_keeper_name = (site: ThermalSite) -> str:
    k = bath_keeper_person(site)
    if k >= 0: living_world.people[k].name else: "The keeper"

# The bathers: a few of the town's grown people, the same ones through a day.
bath_choose_bathers = (k: int):
    global bath
    site = THERMAL_SITES[k]
    out: int[] = []
    if site.place in living_world.far.districts:
        day = lt.day_index(living_world.minute)
        named = living_world.far.districts[site.place].named
        keeper = bath_keeper_person(site)
        loop i in 0..named.len():
            id = named[(i + day * 3) % named.len()]
            pp = living_world.people[id]
            if pp.age < 18 or id == keeper or id == living_world.player or id in out: continue
            out.push(id)
            if out.len() >= 3: break
    bath.bathers = out

bath_fig = (person: int, bathing: bool) -> Figure:
    global bath_figs
    key = person * 2 + (if bathing: 1 else: 0)
    if key in bath_figs: return bath_figs[key]
    pp = living_world.people[person]
    f = build_figure(dress_of(pp.occupation), pp.appearance_seed, age = pp.age, bathing = bathing, woman = person_woman(pp.name))
    bath_figs[key] = f
    f

# Off to somewhere on the grounds on foot, then what comes after (run_then).
bath_walk_to = (at: vec3, then: str):
    global foot_goal, foot_goal_act, foot_goal_sub, foot_goal_then, foot_goal_folk, foot_goal_at, foot_goal_since
    foot_goal = 0; foot_goal_act = ""; foot_goal_sub = ""; foot_goal_then = then; foot_goal_folk = -1
    foot_goal_at = at; foot_goal_since = t
    bath_route_to(at)

# The way across the grounds: the terraces step down the hill, so from one to another is by
# their flights of stairs (the upper to the middle at x 0, the middle to the lower and the lower
# to the path at x 4.5), each walked from its one end to its other.
_bath_level = (z: f64) -> int: if z < 0.0: 0 else: if z < 14.0: 1 else: if z < 22.0: 2 else: 3
bath_route_to = (at: vec3):
    global foot_route, foot_goal_at
    foot_route = []
    k = bath_site_here()
    if k < 0: return
    site = THERMAL_SITES[k]
    stairs = thermal_stairs(site)
    a = _bath_level(f64(thermal_local(site, me.pos.xz).y)); b = _bath_level(f64(thermal_local(site, at.xz).y))
    lv = a
    loop lv != b:
        down = b > lv
        st = stairs[min(if down: lv else: lv - 1, stairs.len() - 1)]
        # (the top on the first step itself, so the way on from it clears the houses' corners)
        top = thermal_world(site, vec3(f32(st.x), f32(-st.top), f32(st.z0 + 0.15)))
        bottom = thermal_world(site, vec3(f32(st.x), f32(-st.bottom), f32(st.z1 + 0.6)))
        if down: foot_route.push(top); foot_route.push(bottom)
        else: foot_route.push(bottom); foot_route.push(top)
        lv = if down: lv + 1 else: lv - 1
    foot_route.push(at)
    # (on the middle terrace, round the hot pool's east side rather than over its coping)
    out: vec3[] = []
    prev = me.pos
    loop q in foot_route:
        loop d in _round_pool(site, prev, q): out.push(d)
        out.push(q)
        prev = q
    foot_route = out
    foot_goal_at = foot_route[0]; foot_route.remove_at(0)

# the points to go by, from a to b, so as not to cross the hot pool (its coping and a step more)
_round_pool = (site: ThermalSite, a: vec3, b: vec3) -> vec3[]:
    la = thermal_local(site, a.xz); lb = thermal_local(site, b.xz)
    c = THERMAL_POOL
    ab = lb - la
    u = clamp(f64(dot(c - la, ab)) / max(f64(dot(ab, ab)), 1e-6), 0.0, 1.0)
    near = la + ab * f32(u)
    if f64(length(near - c)) > 5.6 or _bath_level(f64(la.y)) != 1 or _bath_level(f64(lb.y)) != 1: return []
    side: vec3[] = []
    loop z in [2.2, 7.5, 12.8]:
        if (z > f64(min(la.y, lb.y)) - 0.5) and (z < f64(max(la.y, lb.y)) + 0.5): side.push(thermal_world(site, vec3(c.x + 5.9, f32(-site.drops.x), f32(z))))
    if la.y > lb.y: side = [loop i in 0..side.len(): side[side.len() - 1 - i]]
    side

# The pool tapped: in, if changed and paid; else the cabin first, or the keeper first.
bath_go_in = (k: int):
    global bath
    site = THERMAL_SITES[k]
    day = lt.day_index(living_world.minute)
    if not bath_paid_today(bath, day, k): bath_walk_to(bath_keeper_at(site) + _site_dir(site, 0.0) * 1.1, "bath-keeper"); return
    if not bath.costume:
        bath.then_in = true
        bath_walk_to(bath_cabin_door(site), "bath-change")
        return
    bath_walk_to(thermal_entry(site), "bath-in")

_site_dir = (site: ThermalSite, local_yaw: f64) -> vec3: vec3(f32(sin(site.yaw + local_yaw)), 0, f32(cos(site.yaw + local_yaw)))

# where he is getting in or out: from the steps over the coping, down into the water
bath_path = (site: ThermalSite, e: f64) -> vec3:
    a = thermal_entry(site); b = thermal_seat(site)
    k = e * e * (3.0 - 2.0 * e)
    mix(a, b, f32(k)) + vec3(0, f32(sin(PI * min(1.0, k * 1.6)) * 0.28), 0)

# Each frame near the springs: changing in the cabin, getting in, the bathers and their talk.
bath_step = (dt: f64):
    global bath, me, walker_point, walker_published, thermal_old_view
    k = bath_site_here()
    if k < 0:
        # (left the grounds: dressed again, the day's ticket kept)
        if bath.stage != .none and bath.stage != .soaking: bath.stage = .none
        bath.costume = false
        return
    if bath.site != k or bath.bathers.len() == 0: bath.site = k; bath_choose_bathers(k)
    site = THERMAL_SITES[k]
    if bath.stage == .changing and t - bath.since > BATH_CHANGE_SECONDS:
        bath.costume = not bath.costume
        bath.stage = if bath.costume: .dressed else: .none
        me.pos = bath_cabin_door(site) + _site_dir(site, 0.0) * 0.6
        if bath.costume and bath.then_in: bath.then_in = false; bath_walk_to(thermal_entry(site), "bath-in")
    if bath.stage == .getting_in:
        bath.settle = min(1.0, bath.settle + dt / BATH_IN_SECONDS)
        me.pos = bath_path(site, bath.settle); me.yaw = site.yaw + PI; me.stride = 0.0
        walker_point = world_point(me.pos); walker_published = me.pos
        if bath.settle >= 1.0:
            reason = thermal_life.thermal_begin(living_world, presentation.thermal, site.place, thermal_entry(site))
            if reason != "": say_toast(reason); bath.stage = .dressed
            else:
                bath.stage = .soaking; bath.next_line = t + 4.0; bath.lead_said = false
                thermal_old_view = vec4(f32(follow.distance), f32(follow.pitch), f32(follow.height), f32(follow.yaw))
    # (in the water: someone says something now and then)
    if bath_line_due(bath, t):
        sp = bath_next_speaker(bath)
        person = bath.bathers[sp]
        lead = welcome_job_words(site.place, false)
        if lead == "":
            if site.place in INLAND_ACCESS: lead = welcome_job_words(INLAND_ACCESS[site.place].landing, false)
        remark = if bath.lines_said % 2 == 1: table_remark(living_world, person, bath.lines_said / 2) else: ""
        bath_said(bath, sp, bath_pick_line(bath, lead, remark), t)

# whether a point on the screen is on the pool's steps (the way out), as ray_box finds it: its
# distance, or -1
bath_steps_hit = (site: ThermalSite, p: vec2) -> f64:
    o, d = screen_ray(p)
    c = bath_steps(site)
    ray_box(o, d, c - vec3(1.0, 0.6, 1.0), c + vec3(1.0, 0.7, 1.0))

# The keeper at the bathhouse door, and the bathers in the hot pool to their shoulders (a little
# rise and fall as they breathe; one leaning back now and then).
draw_bath_people = (L: Light):
    k = bath_site_here()
    if k < 0: return
    site = THERMAL_SITES[k]
    keeper = bath_keeper_person(site)
    kf = if keeper >= 0: bath_fig(keeper, false) else: _generic_keeper(site)
    look_capture(look_keeper)
    draw_figure(kf, bath_keeper_at(site), site.yaw, 0.0, 0.0, L, t)
    look_capture(false)
    loop i in 0..bath.bathers.len():
        f = bath_fig(bath.bathers[i], true)
        rise = 0.012 * sin(t * 1.3 + f64(i) * 2.1)
        talking = bath.speaker == i and t < bath.line_until and bath.stage == .soaking
        draw_figure(f, bath_spot(site, i) + vec3(0, f32(rise), 0), bath_spot_yaw(site, i), 0.0, 0.0, L, t, posture = 1, bounce = if talking: 0.01 * sin(t * 9.0) else: 0.0)

_generic_keeper = (site: ThermalSite) -> Figure:
    global bath_keeper_fig
    if let f = bath_keeper_fig: return f
    f = build_figure(.merchant, site.place % 997, age = 58)
    bath_keeper_fig = f
    f

# What a bather says, over their head.
draw_bath_talk = ():
    if bath.stage != .soaking or bath.line == "" or t > bath.line_until or bath.speaker < 0 or bath.speaker >= bath.bathers.len(): return
    k = bath_site_here()
    if k < 0: return
    head = bath_spot(THERMAL_SITES[k], bath.speaker) + vec3(0, 1.2, 0)
    name = split(living_world.people[bath.bathers[bath.speaker]].name, " ")[0]
    speech_bubble(fonts, head, name, bath.line, f64(length(head - scene_camera())), reach = 30.0)

# Out by the steps: up out of the water, then the cabin to change back.
bath_get_out = ():
    global bath
    if bath.stage != .soaking: return
    bath.stage = .getting_out; bath.settle = 1.0; bath.since = t

thermal_old_view=vec4(5.5,0.25,1.6,0)
thermal_capture_id=to_int(env("AEGEAN_CAPTURE_THERMAL") ?? "-1") ?? -1
thermal_capture_started=false
near_thermal=()->(int,bool):
    if not geography_enabled or me.mode!=.walking:return (-1,false)
    loop k in 0..THERMAL_SITES.len():
        site=THERMAL_SITES[k]
        if length(me.pos-thermal_entry(site))<3.5:return (k,false)
        if length(me.pos-thermal_inn(site))<3.5:return (k,true)
    (-1,false)

thermal_leave=():
    global me,walker_point,walker_published,follow,presentation,living_world,thermal_credit
    at=presentation.thermal.exit
    thermal_life.thermal_end(living_world,presentation.thermal)
    me.pos=at;walker_point=world_point(at);walker_published=at
    follow.distance=thermal_old_view.x;follow.pitch=thermal_old_view.y;follow.height=thermal_old_view.z;follow.yaw=thermal_old_view.w
    thermal_credit=0

thermal_walk=(dt:f64)->bool:
    global me,walker_point,walker_published,follow,follow_frame,presentation,living_world,hour,thermal_credit,thermal_old_view
    if not presentation.thermal.active:
        nearby=near_thermal()
        if nearby.0<0 or holding_cargo()>=0 or cat_busy(cat_scene) or not vpressed(.f):return false
        # (F at the pool's edge: the keeper, the cabin and the steps, as a tap on the pool does)
        if not nearby.1:bath_go_in(nearby.0);return true
        site=THERMAL_SITES[nearby.0]
        reason=thermal_life.thermal_begin(living_world,presentation.thermal,site.place,me.pos,nearby.1)
        if reason!="":say_toast(reason);return true
        thermal_old_view=vec4(f32(follow.distance),f32(follow.pitch),f32(follow.height),f32(follow.yaw))
        thermal_credit=0
        # Starting the bath does not consume the same key press as "one hour".
        me.stride=0;me.phase=0
        return true
    visit=presentation.thermal;index=thermal_site(visit.place)
    if index<0:thermal_leave();return true
    site=THERMAL_SITES[index]
    global bath, bath_hurry
    # (up the steps out of the water, by degrees; then to the cabin to change back)
    if bath.stage==.getting_out:
        bath.settle=max(0.0,bath.settle-dt/BATH_IN_SECONDS)
        me.pos=bath_path(site,bath.settle);me.stride=0
        walker_point=world_point(me.pos);walker_published=me.pos
        if bath.settle<=0.0:
            thermal_leave()
            bath.stage=.dressed
            bath_walk_to(bath_cabin_door(site),"bath-change")
        return true
    # (the steps tapped or clicked, R, or walking off: out)
    out_tap=-1.0
    if pad.tapped:out_tap=bath_steps_hit(site,pad.tap_at)
    else if not pad.on and mouse_pressed(.left):out_tap=bath_steps_hit(site,foot_aim())
    if vpressed(.r) or length(walk_axis())>0.1 or pad.walking or out_tap>=0.0:
        if bath.stage==.soaking:bath_get_out()
        else:thermal_leave()
        return true
    if not visit.sleeping:
        if vpressed(.f):presentation.thermal.until=living_world.minute+60;bath_hurry=true
        if vpressed(.t):presentation.thermal.until=thermal_life.thermal_until(living_world.minute,if lt.local_minute(living_world.minute)<1080:18 else:7);bath_hurry=true
    # (soaking with nothing asked of the keys: the morning goes by unhurried)
    if presentation.thermal.until<=living_world.minute:bath_hurry=false
    gentle=bath.stage==.soaking and not bath_hurry and not visit.sleeping
    if gentle and presentation.thermal.until<=living_world.minute:presentation.thermal.until=living_world.minute+1
    if presentation.thermal.until>living_world.minute:
        thermal_credit=min(thermal_credit+dt*(if gentle:BATH_MINUTES_A_SECOND else:30.0),2.0)
        if thermal_credit>=1:
            # At most one simulated minute per frame; no overnight blocking loop.
            elapsed=thermal_life.thermal_advance(living_world,presentation.thermal,1)
            hour=(hour+f64(elapsed)/60.0)%24.0;thermal_credit-=1.0
    thermal_life.thermal_recover(living_world,presentation.thermal)
    if visit.sleeping and living_world.minute>=presentation.thermal.until:
        thermal_leave();say_toast("Morning at the inn.");return true
    if not visit.sleeping and presentation.thermal.until>=0 and living_world.minute>=presentation.thermal.until:
        presentation.thermal.until=if vdown(.f):living_world.minute+60 else: -1
    me.pos=if visit.sleeping:thermal_world(site,vec3(8,0,-9)) else:thermal_seat(site)
    me.yaw=site.yaw+PI;me.stride=0
    walker_point=world_point(me.pos);walker_published=me.pos
    portage.cargo_person_pose(living_world,living_world.player,me.pos)
    follow.distance=approach(follow.distance,7.0,1.2,dt)
    follow.height=approach(follow.height,0.8,1.2,dt)
    follow.pitch=approach(follow.pitch,0.19,1.2,dt)
    follow.yaw=approach_angle(follow.yaw,site.yaw+0.40,1.0,dt)
    update_local_follow(follow,follow_frame,world_point(if visit.sleeping:thermal_entry(site) else:me.pos),dt,input=false)
    true

# Deterministic judging hooks. No effect in ordinary play; private saves belong to the runner.
judge_camera: JudgeView?
judge_origin=pc.state.position
# The landing capture's glide: down the heading at a steady sink, the throttle closed in the last
# few metres, a gentle round-out, then left to run out on the water.
capture_landing_controls=(f:Flyer,e:FlightEnv)->Controls:
    s=f.state
    if s.on_water:return Controls(throttle=0.0,assist=0.0)
    hgt=f64(s.position.y)-f.spec.float_height-sea_surface(e,f64(s.position.x),f64(s.position.z),s.time).height
    # (the sink asked for: steady down to a few metres, then a gentle settle onto the water)
    want=if hgt>4.0:-clamp(hgt*0.5,2.5,8.0) else:-1.6
    c=steer(f.spec,s,heading_vector(f.aim_heading))
    c.pitch=clamp((want-f64(s.velocity.y))*0.12,-0.5,0.5)
    c.throttle=0.0
    if env("AEGEAN_LAND_TRACE")!=none and frame_number()%30==0:print("LAND t {s.time:.2} hgt {hgt:.2} v {length(s.velocity):.1} vy {s.velocity.y:.2} water {s.on_water}")
    c
# AEGEAN_WATCH="ahead side up [look]" (captures only): a camera fixed in the world, ahead of and
# beside where the aircraft starts (metres along and to the right of its heading), looking at a
# point `look` metres further along: to watch the spray it throws and leaves hanging behind it.
capture_watch=env("AEGEAN_WATCH")
if let w=capture_watch:
    v=[loop x in w.split(" "):to_float(x) ?? 0.0]
    f=heading_vector(pc.aim_heading);r=vec3(-f.z,0,f.x);p0=pc.state.position;p0.y=0
    look=if v.len()>3:v[3] else:40.0
    judge_camera=JudgeView(p0+f*f32(v[0])+r*f32(v[1])+vec3(0,f32(v[2]),0),p0+f*f32(v[0]+look)+vec3(0,2,0),"watch")
judge_ready=env("AEGEAN_CAPTURE_READY")!=none
judge_trace=env("AEGEAN_CAPTURE_TRACE")!=none
judge_frame=0
# AEGEAN_PROP_SWEEP="frame seconds": the player's throttle lever held open, then pulled steadily
# to idle from that frame over that many seconds, with a sound engine (for checking the propeller
# disc).
prop_sweep_from=-1.0;prop_sweep_secs=12.0
if let v=env("AEGEAN_PROP_SWEEP"):
    w=split(v," ")
    prop_sweep_from=to_float(w[0]) ?? 240.0
    if w.len()>1:prop_sweep_secs=to_float(w[1]) ?? 12.0
stress_frame_dt=to_float(env("AEGEAN_STRESS_FRAME_DT") ?? "0") ?? 0.0
if let recipe=env("AEGEAN_CAPTURE"):
    judge_camera=judge_view(recipe,towns,pc.state.position,pc.spec.span)
    if recipe!="flight":free.pos=judge_camera!.eye;me.pos=free.pos;me.mode=.free
    print("CAPTURE {judge_camera!.label}; eye {judge_camera!.eye}; target {judge_camera!.target}; hour {hour}")
# A lived-in judging capture must publish the canonical far catalogue before
# advancing its clock; otherwise the lazy island registry can still be warming
# when the requested screenshot is taken. Ordinary startup remains incremental.
if env("AEGEAN_CAPTURE_LIFE")!=none:
    settlement_registry.finish_settlement_registry()
    sync_folk(folks,living_world,towns)
if thermal_site(thermal_capture_id)>=0:
    site=THERMAL_SITES[thermal_site(thermal_capture_id)]
    me.mode=.walking;me.pos=thermal_entry(site);me.yaw=site.yaw+PI
    follow.yaw=site.yaw+0.4;follow.distance=7;follow.pitch=0.19
# (AEGEAN_BATH_ARRIVE=<place>: on foot at the bottom of the baths' last flight, come up the path
# from the town, for the waters by their things; AEGEAN_BATH_PAY=1 pays the keeper when he asks)
bath_arrive_id=to_int(env("AEGEAN_BATH_ARRIVE") ?? "-1") ?? -1
bath_auto_pay=env("AEGEAN_BATH_PAY")!=none
if thermal_site(bath_arrive_id)>=0:
    site=THERMAL_SITES[thermal_site(bath_arrive_id)]
    up=thermal_world(site,vec3(4.5,0,24.5))
    me.mode=.walking;me.pos=vec3(up.x,f32(walk_height(towns,f64(up.x),f64(up.z))),up.z);me.yaw=site.yaw+PI
    follow.yaw=site.yaw+0.25;follow.distance=6.5;follow.pitch=0.3
if let minutes=env("AEGEAN_CAPTURE_MINUTES"):
    living.advance_minutes(living_world,max(0,to_int(minutes) ?? 0))
    sync_folk(folks,living_world,towns)
if startup_aegean_capture_panel=="notebook":
    living.advance_minutes(living_world,180)
    loop id in living_world.active_jobs:
        j=living_world.jobs[id]
        if j.origin==0 and j.state==.open and notebook.notes.len()<3:
            pin_notice(notebook,id,j.poster,"{job_cargo(id)} to {SETTLEMENTS[j.destination].name}","{living_world.people[j.poster].name}; due {clock_text(living_world,j.due_minute)}; {phoenix_text(j.reward_cents)}",clock_text(living_world,living_world.minute))
    notebook.open=true
    print("NOTEBOOK {to_text(notebook.notes)}")
if startup_aegean_capture_panel=="options":dbg.page=5;capture_pause_frame=60
if let attitude=env("AEGEAN_CAPTURE_ATTITUDE"):
    words=split(attitude," ")
    pitch=to_float(words[0]) ?? 0.0
    pc.state.orientation=quat_euler(pitch,-along_quay,0)
    pc.state.velocity=quat_rotate(pc.state.orientation,vec3(0,0,-f32(length(pc.state.velocity))))

if let scenario=env("AEGEAN_SCENARIO"):assert(load_scenario(scenario),"Unknown scenario")
# (AEGEAN_HOUR also overrides a scenario's own hour, for captures at another time of day)
if env("AEGEAN_SCENARIO")!=none and env("AEGEAN_HOUR")!=none:hour=to_float(env("AEGEAN_HOUR") ?? "") ?? hour
# The same close orbit used in play, without browser pointer-lock permission in captures.
if let orbit=env("AEGEAN_CAPTURE_ORBIT"):
    words=split(orbit," ");assert(words.len()==3,"orbit capture: distance yaw pitch")
    me.mode=.aboard;pc.orbiting=true
    pc.orbit_dist=clamp(to_float(words[0]) ?? 9.0,9.0,90.0)
    pc.orbit_yaw=to_float(words[1]) ?? 0.0
    pc.orbit_pitch=clamp(to_float(words[2]) ?? 0.32,-1.35,1.35)

# AEGEAN_CRAFT_VIEW="yaw pitch distance": the free camera on the player's aircraft from that side
# (radians round from its nose and up, meters away), for model captures. Captures only.
if let v=env("AEGEAN_CRAFT_VIEW"):
    words=split(v," ");assert(words.len()==3,"craft view: yaw pitch distance")
    side_a=heading(pc.state)+(to_float(words[0]) ?? 0.8);side_e=to_float(words[1]) ?? 0.2
    out=vec3(f32(sin(side_a)*cos(side_e)),f32(sin(side_e)),f32(-cos(side_a)*cos(side_e)))
    free.pos=pc.state.position+out*f32(to_float(words[2]) ?? 14.0)
    free.pitch=-side_e
    free.yaw=atan2(f64(out.x),f64(out.z))
    if dot(forward(free),-out)<0.9:free.yaw=-free.yaw
    me.mode=.free

# AEGEAN_CAPTURE_DOGFIGHT="ahead across up" (after a battle scenario loads): the nearest hostile put
# that many metres ahead, to the side and above, crossing from left to right at cruise, for
# captures of the lead marker in a real fight. Captures only.
if let fight=env("AEGEAN_CAPTURE_DOGFIGHT"):
    words=split(fight," ");assert(words.len()==3,"dogfight capture: ahead across up")
    mine=combat_index(battle,living_world.people[living_world.player].craft)
    if mine>=0:
        nose=quat_rotate(pc.state.orientation,vec3(0,0,-1));side=quat_rotate(pc.state.orientation,vec3(1,0,0))
        best=-1
        loop i in 0..battle.actors.len():
            if battle.actors[i].side!=battle.actors[mine].side and best<0:best=i
        if best>=0:
            a=battle.actors[best]
            a.state.position=pc.state.position+nose*f32(to_float(words[0]) ?? 300.0)+side*f32(to_float(words[1]) ?? -80.0)+vec3(0,f32(to_float(words[2]) ?? 15.0),0)
            h=heading(pc.state)+PI*0.5
            a.state.orientation=quat_euler(0,-h,0);a.state.velocity=heading_vector(h)*f32(length(pc.state.velocity))
            a.previous=a.state.position;a.previous_point=craft_point(a.state);a.previous_rotation=a.state.orientation
            a.pilot.formation=false;a.pilot.target=mine
            battle.actors[best]=a

# AEGEAN_CAPTURE_STRAIT_AFTER=rescue|home|arrive (after the strait loads): after the battle, for
# clips. rescue: one foe just put down on the water ahead and climbing out, the player on a long
# final beside them (the autopilot lands and taxis alongside; F is taken for the player); home: the
# enemy gone, the flight forming up for home, the player flown in its slot; arrive: that flight
# six kilometres out from its base, landing in turn, the player last. Captures only.
# AEGEAN_CAPTURE_DELIVERY=<place>: a flying job from home to that place taken (the sender's porter
# loading it, half an hour on), and the pilot's aircraft set on the water 60 m off that town's first
# dock, heading in, to moor and hand it over (captures; AEGEAN_DELIVERY_TRACE=1 logs the job;
# AEGEAN_DELIVERY_MOORED=1 tied up at the dock already)
capture_delivery = to_int(env("AEGEAN_CAPTURE_DELIVERY") ?? "") ?? -1
capture_delivery_job = -1
if capture_delivery >= 0 and capture_delivery < towns.len():
    loop id in living_world.active_jobs:
        j = living_world.jobs[id]
        if capture_delivery_job < 0 and j.state == .open and j.origin == 0 and j.destination == capture_delivery and j.delivery_mode == .aircraft: capture_delivery_job = id
    if capture_delivery_job >= 0:
        took = living.take_job(living_world, capture_delivery_job, living_world.player, .automatic)
        waited = 0
        loop waited < 180 and not living_world.jobs[capture_delivery_job].loaded:
            living.advance_minutes(living_world, 1); waited += 1
        print("DELIVERY loaded {living_world.jobs[capture_delivery_job].loaded} after {waited} minutes")
        sync_folk(folks, living_world, towns)
        print("DELIVERY took {took} job {capture_delivery_job} {job_cargo(capture_delivery_job)} for {living_world.people[portage.cargo_receiver(living_world,capture_delivery_job)].name}; {portage.cargo_status(living_world, capture_delivery_job)}")
        # (cast off as a pilot does, so the world has the trip the mooring will end)
        _ = living_scene.scene_player_departure(living_world)
        # (boarding, taking off and the flight over: an hour of the world's while she is away)
        living.advance_minutes(living_world, 60)
        sync_folk(folks, living_world, towns)
        tw = towns[capture_delivery]
        d = tw.docks[0]; out = vec3(tw.out.x, 0, tw.out.y)
        at = d + out * 60.0
        h = atan2(f64(-out.x), f64(out.z))
        pc.state = water_start(pc.spec, vec3(at.x, 0, at.z), h)
        pc.throttle = 0.0; pc.aim_heading = h; pc.placed = false
        me.mode = .aboard
        # (AEGEAN_DELIVERY_MOORED=1: tied up at that dock already, as one who has just come in)
        if env("AEGEAN_DELIVERY_MOORED") != none:
            moor(pc.state, vec3(d.x, f32(pc.spec.float_height), d.z), h)
            tie_up()
    else: print("DELIVERY no open flying job from home to {capture_delivery}")
delivery_trace = env("AEGEAN_DELIVERY_TRACE") != none
delivery_trace_step = ():
    if not delivery_trace or capture_delivery_job < 0 or frame_number() % 60 != 0: return
    w = living_world; id = capture_delivery_job; j = w.jobs[id]; c = w.people[w.player].craft; a = w.aircraft[c]
    tasks = [loop k in w.active_carriage: "{w.people[w.carriage[k].person].name}:{w.carriage[k].phase}:{w.carriage[k].blocked}"]
    print("DELIVERYTRACE f {frame_number()} min {w.minute} job {j.state} loaded {j.loaded} collected {j.collected} | craft place {a.place} dock {a.dock} port {a.port_place} trip {a.trip} state {a.state} | pilot place {w.people[w.player].place} far {w.people[w.player].far_place} | carriage {tasks} | {portage.cargo_status(w, id)} | me {me.mode} {me.pos}")

capture_after=env("AEGEAN_CAPTURE_STRAIT_AFTER") ?? ""
capture_after_plan=FlightPlan()
capture_after_took=false
if capture_after!="" and active_scenario=="strait":
    mine=combat_index(battle,living_world.people[living_world.player].craft)
    side=battle.actors[mine].side
    foe=-1
    loop i in 0..battle.actors.len():
        if battle.actors[i].side!=side and foe<0:foe=i
    loop i in 0..battle.actors.len():
        if i==mine or (capture_after=="rescue" and i==foe):continue
        if battle.actors[i].side!=side or capture_after=="rescue":battle.actors[i].present=false;battle.actors[i].status=.escaped
    h=heading(pc.state);dir=heading_vector(h);across=vec3(-dir.z,0,dir.x)
    if capture_after=="allies-far":
        # (allies-far: the fight won, the flight turning for the rally and home; the player six
        # kilometres off to one side, to find them by their marks and follow)
        battle.tick=max(battle.tick,700)
        pc.state.position+=across*6000.0;pc.state.precise_ready=false
        a=battle.actors[mine];a.state=pc.state;a.previous=pc.state.position;a.previous_point=craft_point(pc.state);battle.actors[mine]=a
    else if capture_after=="allies" or capture_after=="allies-behind":
        # (allies: the flight scattered one to six kilometres ahead, to see them marked; allies-behind:
        # all behind, for the pointer at the screen's edge)
        battle.homes=[]
        k=0
        loop i in 0..battle.actors.len():
            a=battle.actors[i]
            if i==mine or a.side!=side or not a.present:continue
            way=if capture_after=="allies": dir else: -dir
            a.state.position=pc.state.position+way*f32(1000.0+f64(k)*900.0)+across*f32((f64(k%3)-1.0)*f64(400+k*150))+vec3(0,f32((f64(k%2)-0.5)*200.0),0)
            a.state.velocity=dir*f32(a.spec.cruise_speed*0.8);a.state.orientation=quat_euler(0,-h,0);a.state.precise_ready=false
            a.previous=a.state.position;a.previous_point=craft_point(a.state);a.previous_rotation=a.state.orientation
            a.pilot.formation=false
            battle.actors[i]=a;k+=1
    else if capture_after=="rescue":
        # (no flight left to go home with: the radio stays quiet)
        battle.homes=[]
        spot=pc.state.position+dir*5200.0;spot.y=0
        a=battle.actors[foe]
        a.state=CraftState(position=spot+vec3(0,f32(a.spec.float_height),0),orientation=quat_euler(0,-(h+1.1),0),fuel=a.state.fuel,on_water=true,water_age=1.0,damage=a.state.damage)
        a.state.damage.parts[1].health=0.0;refresh_damage(a.spec,a.state)
        a.status=.disabled;a.down_reported=true;a.pilot.mode=.ditching;a.gun.locked=true;a.pilot.formation=false
        a.previous=a.state.position;a.previous_point=craft_point(a.state);a.previous_rotation=a.state.orientation
        battle.actors[foe]=a
        touchdown=spot-dir*1000.0
        pc.state.position=touchdown-dir*1500.0+vec3(0,f32(1400.0*0.065+pc.spec.float_height),0)
        pc.state.orientation=quat_euler(0,-h,0);pc.state.velocity=dir*f32(pc.spec.stall_speed*1.3*pure_k(pc.spec));pc.state.precise_ready=false
        pc.throttle=0.3;pc.state.throttle=0.3
        capture_after_plan=FlightPlan(target=touchdown,taxi_target=spot-dir*10.0+across*16.0,altitude=300.0,landing_heading=h,phase=.descend,initialized=true,approach_heading=h,approach_distance=1800.0,clearance_altitude=300.0)
    else:
        battle.tick=max(battle.tick,700)
        if capture_after=="arrive":
            loop hm in battle.homes:
                if hm.side!=side:continue
                inbound=normalize(vec3(hm.centre.x-STRAIT_CENTER.x,0,hm.centre.z-STRAIT_CENTER.z))
                hh=atan2(f64(inbound.x),-f64(inbound.z))
                # (AEGEAN_ARRIVE_KM: how far out, 6 km unless said)
                lead_at=hm.touchdown-inbound*f32(1000.0*(to_float(env("AEGEAN_ARRIVE_KM") ?? "6") ?? 6.0))+vec3(0,320,0)
                lead_offset=vec3(0,0,0)
                loop a in battle.actors:
                    if a.side==side and not a.human and a.present:lead_offset=a.pilot.formation_offset;break
                place=(offset:vec3)->vec3: lead_at+quat_rotate(quat_euler(0,-hh,0),offset-lead_offset)
                loop i in 0..battle.actors.len():
                    a=battle.actors[i]
                    if a.side!=side or not a.present:continue
                    a.state.position=place(a.pilot.formation_offset);a.state.orientation=quat_euler(0,-hh,0)
                    a.state.velocity=heading_vector(hh)*f32(a.spec.cruise_speed*0.82);a.state.precise_ready=false
                    a.previous=a.state.position;a.previous_point=craft_point(a.state);a.previous_rotation=a.state.orientation
                    battle.actors[i]=a
                pc.state=battle.actors[mine].state
                # (AEGEAN_ARRIVE_FORMED: already formed up for home, no regroup first)
                if env("AEGEAN_ARRIVE_FORMED")!=none:
                    battle.home_since[side]=battle.tick;battle.formed[side]=battle.tick
                    order=0
                    loop i in 0..battle.actors.len():
                        a=battle.actors[i]
                        if a.side!=side or not a.present or a.human:continue
                        a.pilot.mode=.homeward;a.pilot.home_turn=order;a.pilot.rallied=true;a.pilot.formation=false;a.pilot.plan=FlightPlan();order+=1
                        battle.actors[i]=a

# AEGEAN_CAPTURE_TENDER_CAM (with AEGEAN_CAPTURE_STRAIT_AFTER=arrive): the flight coming home to
# the Ierax seen from her bridge: the camera turns, eased, after the lowest of them (the one landing
# or taxiing in), the moorings in view once all are in. TENDER lines say how it goes.
tender_cam_look = vec3(0, 0, 0)
tender_cam_turn = 0.0                       # (0 behind the leader coming in, 1 off her quarter: eased between)
tender_cam_in = false                       # (the leader down: off her quarter from then on, not back)
tender_cam_lead = (vec3(0, 0, 0), vec3(0, 0, 0))
tender_cam_step = ():
    global judge_camera, judge_origin, tender_cam_look, tender_cam_turn, tender_cam_in, tender_cam_lead
    spec = vessel_spec(.seaplane_tender)
    eye = tender_local(vec3(2, f32(spec.deck + 16.0), 4))
    target = tender_slot(3)
    low = 1e9; moored = 0; flying = 0; down = 0
    loop a in battle.actors:
        if a.side == 1 and a.present and not a.human and a.status != .flying: down += 1
        if a.side != 1 or not a.present or a.status != .flying: continue
        if a.pilot.home_done:
            moored += 1
            continue
        flying += 1
        if f64(a.state.position.y) < low: low = f64(a.state.position.y); target = a.state.position
    if length(tender_cam_look) < 1.0: tender_cam_look = target
    tender_cam_look = mix(tender_cam_look, target, 0.04)
    # (the judge camera rides with the player's aircraft from judge_origin: set to where it is now)
    judge_origin = pc.state.position
    lead = home_leader(battle, 1)
    if lead >= 0 and (battle.actors[lead].state.on_water or battle.actors[lead].pilot.home_done): tender_cam_in = true
    if not tender_cam_in and lead >= 0:
        # (coming in: behind and above the leader, the flight and the Ierax ahead)
        l = battle.actors[lead].state
        f = vec3(l.velocity.x, 0, l.velocity.z)
        f = if length(f) > 1.0: normalize(f) else: normalize(vec3(TENDER_AT.x - l.position.x, 0, TENDER_AT.z - l.position.z) + vec3(0.001, 0, 0))
        side = vec3(-f.z, 0, f.x)
        tender_cam_lead = (l.position - f * 90.0 + side * 25.0 + vec3(0, 22, 0), l.position + f * 400.0 - vec3(0, 60, 0))
        tender_cam_look = target
    # (in: off her seaward quarter, looking back at her side and booms, the flight taxiing in; turned
    # to over four seconds from behind the leader as it alights, never cut, and not back)
    if lead < 0: tender_cam_in = true
    tender_cam_turn = if tender_cam_in: min(1.0, tender_cam_turn + 1.0 / 240.0) else: 0.0
    # (never seen coming in: straight to her quarter)
    if length(tender_cam_lead.0) < 1.0: tender_cam_turn = 1.0
    k = f32(smoothstep(0.0, 1.0, tender_cam_turn))
    off = TENDER_AT + tender_port() * 140.0 - tender_forward() * 40.0 + vec3(0, 30, 0)
    quarter = TENDER_AT + tender_port() * 30.0 + vec3(0, 2, 0)
    judge_camera = JudgeView(mix(tender_cam_lead.0, off, k), mix(tender_cam_lead.1, quarter, k), if tender_cam_in: "off the Ierax's quarter" else: "behind the flight, coming home")
    if frame_number() % 300 == 0:
        print("TENDER frame {frame_number()}: {moored} moored, {flying} still flying, {down} down, the lowest at {low:.0} m, {length(target - TENDER_AT):.0} m off; wind {length(wind_now_vec()):.1} m/s")
        loop a in battle.actors:
            if a.side == 1 and a.present and not a.human and (a.status != .flying or a.state.crashed or a.state.capsized): print("TENDER down: {a.craft} status {a.status} crashed {a.state.crashed} capsized {a.state.capsized} at {a.state.position.x:.0},{a.state.position.y:.1},{a.state.position.z:.0} phase {a.pilot.plan.phase} hull {a.state.hull_damage:.2}")

# AEGEAN_CAPTURE_SIGNAL (with AEGEAN_CAPTURE_STRAIT_AFTER=arrive and AEGEAN_ARRIVE_FORMED): the
# flight's leader signals the player in its slot (by hand), then, the player put 900 m out on the
# flight's beam, again (by lamp); the camera from over the player's cockpit on the one signalling.
# SIGNAL lines say each.
signal_capture_step = ():
    global judge_camera, judge_origin, pc
    f = frame_number()
    ci = combat_index(battle, living_world.people[living_world.player].craft)
    if ci < 0: return
    side = battle.actors[ci].side
    lead = home_leader(battle, side)
    if lead < 0: return
    # (the player put abreast of the leader, 90 m off, then 900 m out on the flight's beam, flying on
    # as it was; the flight's own lines held back meanwhile)
    if f == 400 or f == 900:
        l = battle.actors[lead].state
        across = normalize(vec3(-l.velocity.z, 0, l.velocity.x) + vec3(0.0001, 0, 0))
        pc.state.position = l.position + across * f32(if f == 400: 90.0 else: 900.0)
        pc.state.velocity = l.velocity; pc.state.orientation = l.orientation; pc.state.precise_ready = false
        a = battle.actors[ci]; a.state = pc.state; a.previous = pc.state.position; a.previous_point = craft_point(pc.state); battle.actors[ci] = a
        homeward.queue = []; homeward.until = t
    if f == 402: radio_say(homeward, "sig-hand", call_sign(living_world, side, 1), "Follow me down. We'll land in turn.", battle.actors[lead].craft)
    if f == 902: radio_say(homeward, "sig-lamp", call_sign(living_world, side, 1), "Close up. We're turning for home.", battle.actors[lead].craft)
    sig = homeward.signal
    if f % 30 == 0 and sig.way != .none and t < sig.until:
        i = combat_index(battle, sig.craft)
        d = if i >= 0: f64(length(battle.actors[i].state.position - pc.state.position)) else: -1.0
        print("SIGNAL frame {f}: {sig.way} from craft {sig.craft} at {d:.0} m, lit {signal_lit(sig, t - sig.since)}; '{homeward.showing.who}: {homeward.showing.words}'")
    judge_origin = pc.state.position
    i = combat_index(battle, if sig.way != .none and t < sig.until: sig.craft else: battle.actors[lead].craft)
    if i >= 0:
        # (a hand: close by the one signalling, on the player's side of it; a lamp: from the player's
        # own aircraft, the flight far off)
        o = battle.actors[i].state.position
        toward = normalize(pc.state.position - o + vec3(0.0001, 0, 0))
        fwd = forward(battle.actors[i].state)
        eye = if f64(length(pc.state.position - o)) < SIGNAL_HAND: o + toward * 13.0 + fwd * 4.0 + vec3(0, 2.0, 0) else: pc.state.position + vec3(0, 4.0, 0) + vec3(-toward.z, 0, toward.x) * 18.0 + toward * 6.0
        judge_camera = JudgeView(eye, o + vec3(0, 1.0, 0), "the flight's signal")

# Flies the player's aircraft for AEGEAN_CAPTURE_STRAIT_AFTER: the autopilot down beside the
# survivor; in the formation's slot on the leader; round the bay till the rest are down; then in.
capture_after_controls = (e: FlightEnv) -> Controls:
    global capture_after_plan
    if capture_after=="rescue":
        # (taxi up beside the swimmer, where they are now, and stop there: no anchor, which would
        # moor the aircraft out at sea)
        loop d in battle.descents:
            if d.phase==.swimming and not d.released:
                side=quat_rotate(pc.state.orientation,vec3(1,0,0));side.y=0
                capture_after_plan.taxi_target=d.position+normalize(side+vec3(0.0001,0,0))*9.0
        c=autopilot(pc.spec,pc.state,capture_after_plan,e)
        c.anchor=false
        return c
    mine=combat_index(battle,living_world.people[living_world.player].craft)
    if mine<0: return Controls()
    side=battle.actors[mine].side
    lead=home_leader(battle,side)
    if battle.home_since[side]>=0 and battle.formed[side]<0:
        # (regrouping: to the rally point and round it with the rest)
        r=battle.rally[side];out=pc.state.position-r;out.y=0
        if length(out)<1:out=vec3(1,0,0)
        if f64(length(out))>2200.0:return air_waypoint_controls(pc.spec,pc.state,e,r,f64(r.y),pc.spec.cruise_speed*0.8)
        around=f64(atan2(f64(out.z),f64(out.x)))+0.4
        return air_waypoint_controls(pc.spec,pc.state,e,r+vec3(f32(cos(around)*1300.0),0,f32(sin(around)*1300.0)),f64(r.y)-30.0,pc.spec.cruise_speed*0.65)
    if lead>=0 and battle.actors[lead].pilot.descend_tick<0 and not capture_after_plan.initialized:
        slot=home_slot(battle,lead,battle.actors[mine].pilot.formation_offset)
        l=battle.actors[lead].state;direction=heading_vector(heading(l));lv=f64(length(l.velocity))
        pace=clamp(lv+f64(dot(slot-pc.state.position,direction))*0.12,lv*0.75,lv*1.25)
        return air_waypoint_controls(pc.spec,pc.state,e,slot+direction*1000.0,f64(slot.y),pace)
    waiting=0
    loop a in battle.actors:
        if a.side==side and not a.human and a.status==.flying and not a.pilot.home_done:waiting+=1
    loop hm in battle.homes:
        if hm.side!=side:continue
        if waiting==0 or capture_after_plan.initialized:
            if not capture_after_plan.initialized:
                touchdown,landing=home_runway(hm,e)
                capture_after_plan=FlightPlan(target=touchdown,taxi_target=hm.dock+hm.step*8.0,altitude=hm.altitude,landing_heading=landing,phase=.cruise)
            return autopilot(pc.spec,pc.state,capture_after_plan,e)
        touchdown,landing=home_runway(hm,e)
        centre=touchdown-heading_vector(landing)*1600.0
        out=pc.state.position-centre;out.y=0
        around=f64(atan2(f64(out.z),f64(out.x)))+0.45
        return air_waypoint_controls(pc.spec,pc.state,e,centre+vec3(f32(cos(around)*900.0),0,f32(sin(around)*900.0)),hm.altitude+300.0,pc.spec.cruise_speed*0.75)
    Controls()

# AEGEAN_CAPTURE_CANAL_RUN=1: after the slipway hand-over, the canal scenario's tests' steering
# flies the run; AEGEAN_CAPTURE_POST=k watches it from behind ground post k. Captures only.
capture_canal_run=env("AEGEAN_CAPTURE_CANAL_RUN")!=none
capture_canal_plan=canal_run_plan()
# AEGEAN_CAPTURE_CANAL_EYE="x y z" (capture runs only): once the run is past the footbridge (57),
# a camera fixed there in the world follows her across the lagoon and up.
capture_canal_eye:vec3?=none
if let v=env("AEGEAN_CAPTURE_CANAL_EYE"):
    w=[loop x in v.split(" "):to_float(x) ?? 0.0]
    if w.len()>=3:capture_canal_eye=vec3(f32(w[0]),f32(w[1]),f32(w[2]))
capture_post=to_int(env("AEGEAN_CAPTURE_POST") ?? "-1") ?? -1
capture_post_look=env("AEGEAN_CAPTURE_POST_LOOK")!=none
# AEGEAN_CAPTURE_DOGFIGHT_PILOT=1: in a battle, the dogfight brain flies the player's aircraft (a
# chase-camera ride into the melee). AEGEAN_FRAMES="dir from to step" saves those frames.
capture_dogfight_pilot=env("AEGEAN_CAPTURE_DOGFIGHT_PILOT")!=none
# AEGEAN_CAPTURE_MOUSE_TRACK=1: in a battle, the mouse's aim kept on the nearest hostile every frame (a
# perfect hand on the mouse), the aircraft flown by the game's own mouse steering. Captures only.
capture_mouse_track=env("AEGEAN_CAPTURE_MOUSE_TRACK")!=none
capture_aim_on_hostile = (ci: int):
    best=-1;near=1e18
    loop i in 0..battle.actors.len():
        a=battle.actors[i]
        if a.side==battle.actors[ci].side or a.state.crashed:continue
        d=f64(length(world_delta(craft_point(a.state),craft_point(pc.state))))
        if d<near:near=d;best=i
    if best<0:return
    to=normalize(world_delta(craft_point(battle.actors[best].state),craft_point(pc.state)))
    pc.mouse_mode=true
    pc.aim_heading=atan2(f64(to.x),-f64(to.z));pc.aim_climb=asin(clamp(f64(to.y),-1.0,1.0))
capture_trigger=false
capture_frames=env("AEGEAN_FRAMES")

# AEGEAN_NO_GROUND_FIRE=1: the canal's posts removed, for an A/B of their cost in one binary.
if env("AEGEAN_NO_GROUND_FIRE")!=none:battle.ground=[]

capture_pause_frame = -1
# AEGEAN_CAPTURE_LOSE="left_float 240": that part of the player's aircraft lost at that frame
# (a wing, a float, the tail, the engine), for checking what goes with it
capture_lose_part = -1; capture_lose_frame = -1
if let v = env("AEGEAN_CAPTURE_LOSE"):
    w = split(v, " ")
    names = ["body", "engine", "left_wing", "right_wing", "left_float", "right_float", "tail"]
    loop i in 0..names.len():
        if names[i] == w[0]: capture_lose_part = i
    capture_lose_frame = if w.len() > 1: to_int(w[1]) ?? 120 else: 120
if startup_aegean_capture_panel=="scenarios":dbg.page=6;capture_pause_frame=60
if startup_aegean_capture_panel=="flight":dbg.page=8;capture_pause_frame=60
if startup_aegean_capture_panel=="aircraft":dbg.page=1;capture_pause_frame=60
if startup_aegean_capture_panel=="paint":dbg.page=PAINT_PAGE;capture_pause_frame=60
# (paint-shop: the Paint page as a paint shop's, the town's mechanic asked, with AEGEAN_PAINT_DRAFT chosen)
paint_shop_capture = startup_aegean_capture_panel=="paint-shop" or launch_capture == "paintshop"
# (the shed's free view from the start, unless the shop's scripted flow sets it once the work is ordered)
if env("AEGEAN_CAPTURE_SHED") != none and launch_capture != "paintshop": paint_shed_capture_view()

# (paint-parts, paint-decals, paint-marks: the Paint page at that tab)
if startup_aegean_capture_panel=="paint-parts" or startup_aegean_capture_panel=="paint-decals" or startup_aegean_capture_panel=="paint-marks":
    dbg.page=PAINT_PAGE;capture_pause_frame=60
    dbg.paint_page.tab=if startup_aegean_capture_panel=="paint-parts":1 else:if startup_aegean_capture_panel=="paint-decals":2 else:3
if startup_aegean_capture_panel=="plane":dbg.page=PLANE_PAGE;capture_pause_frame=60
if startup_aegean_capture_panel=="controls":dbg.page=CONTROLS_PAGE;capture_pause_frame=60
# (settings: the Settings page, paused; settings-advanced: with Advanced settings on, every tab shown)
if startup_aegean_capture_panel=="settings" or startup_aegean_capture_panel=="settings-advanced":dbg.page=SETTINGS_PAGE;capture_pause_frame=60
if startup_aegean_capture_panel=="settings-advanced":dbg.opts.advanced=true
# (settings-accessibility, settings-sandbox: the Settings page scrolled to that section)
if startup_aegean_capture_panel=="settings-accessibility" or startup_aegean_capture_panel=="settings-sandbox":
    dbg.page=SETTINGS_PAGE;capture_pause_frame=60
    dbg.reveal=if startup_aegean_capture_panel=="settings-sandbox": "sandbox" else: "accessibility"
# AEGEAN_PAINT='livery=17 insignia=4 rudder=4 bars=0 number=I-BAUF body=0.2,0.3,0.6 trim=.. wing=..
# accent=.. part.lwing=stripes:r,g,b:r,g,b decal=roundel:wing-top': the player's aircraft repainted
# at the start (captures; the whole form: src/aircraft_paint.jo, paint_from_spec)
if let spec = env("AEGEAN_PAINT"):
    p = paint_from_spec(spec, int(pc.kind))
    set_player_paint(p)
    print("PAINT {to_text(p)} support {to_text(paint_support_for(int(pc.kind)))}")
if startup_aegean_capture_panel=="tweaks":dbg.page=4;capture_pause_frame=60
if startup_aegean_capture_panel=="flight-levers":dbg.page=8;dbg.fdm2_tab=1;capture_pause_frame=60
# AEGEAN_CAPTURE_PANEL=game|game-confirm opens the pause menu's Game page (with a load waiting for
# its yes on slot 2); =saved shows the autosave's card at the captured frame (SLOPPY_FRAMES)
# (paused a second in, once the camera has settled on the quay)
# (the panel captures pause once the first frames have placed the camera: paused from the start the
# world is drawn from an eye never put anywhere, terrain floating over the sea)
game_capture_frame=if startup_aegean_capture_panel=="game" or startup_aegean_capture_panel=="game-confirm":60 else: -1
if startup_aegean_capture_panel=="saved":saved_toast_at=f64(to_int(env("SLOPPY_FRAMES") ?? "120") ?? 120)/60.0-1.2

# AEGEAN_CAPTURE_WAR=card|chart|board|contract stages war news for headless captures of the
# battle card, the chart's war layer and the military contracts (capture only: the living world
# makes the real ones from its own forces and reports)
import 'src/living_missions.jo' as war_missions
import 'src/living_far_types.jo' as far_types
import 'src/living_far_news.jo' as far_news_api
stage_capture_war = (stage: str):
    global battle_card, presentation, ui, ui_place, ui_mission, ui_line, living_world
    w = living_world
    home_d = core_district(w, 0)
    print("WAR STAGE {stage}: home district {home_d}, {w.far.place_ids.len()} places, populated {w.far.populated}")
    if home_d < 0: return
    at = w.place_contexts[home_d].center
    # (the nearest other places to the home harbor, nearest first)
    near: (f64, int)[]
    loop id in w.far.place_ids:
        if id != home_d and id in w.place_contexts and id in w.far.harbors: near.push((f64(length(w.place_contexts[id].center - at)), id))
    # (towns of some size first, so the staged names read like the real ones)
    near.sort((e: (f64, int)): (if stage == "card" and w.far.districts[e.1].population < 300: 1 else: 0, e.0))
    if near.len() < 4: return
    if stage == "card":
        battle_card.name = "Battle for {w.place_contexts[near[0].1].name}"
        battle_card.line = "{w.place_contexts[near[0].1].name},  {war_date(w.minute, true)}"
        battle_card.since = t - 2.4
        return
    me_ = w.player
    m0 = w.minute
    report = (rid: int, kind: str, place: int, text: str, country: int, other: int, ago: int, heard: int) -> far_types.FarReport:
        far_types.FarReport(900000 + rid, max(0, m0 - ago), max(0, m0 - heard), place, text, kind, country = country, other_country = other, severity = if kind == "battle": 900 else: 1000, confidence = 850, hops = 1)
    if stage == "chart":
        p1 = near[0].1; p2 = near[1].1; p3 = near[2].1
        c1 = w.place_contexts[p1].center; c3 = w.place_contexts[p3].center
        reports = [
            report(0, "war_declared", home_d, "Kalyra declared war on Orenthia.", 1, 2, 2900, 2700),
            report(1, "occupation", p1, "A supplied Orenthia force arrived at {w.place_contexts[p1].name}.", 2, -1, 1500, 1300),
            report(2, "blockade", p2, "A supplied Kalyra charter has established a cordon off {w.place_contexts[p2].name}.", 1, 2, 700, 300),
            report(3, "battle", p1, "Battle for {w.place_contexts[p1].name}: A Orenthia charter defeated a Kalyra unit near {c1.x + 900.0:.0}, {c1.z - 1200.0:.0}.", 2, 1, 1450, 1250),
            report(4, "battle", p3, "A Kalyra charter defeated a Orenthia unit near {c3.x - 1500.0:.0}, {c3.z + 700.0:.0}.", 1, 2, 400, 100)]
        loop r in reports: w.people[me_].far_reports.push(r)
        presentation.battles_seen.push(lt.BattleSighting(-5, "Battle off {w.place_contexts[p3].name}", c3 + vec3(1800, 0, -900), max(0, m0 - 20)))
        living_world = w
        return
    # board / contract: a reconnaissance contract posted at the home office over the nearest port
    country = w.far.districts[home_d].controller
    w.far.districts[near[0].1].controller = (country + 1) % 3
    id = war_missions.post_mission(w, country, .reconnaissance, home_d, home_d, near[0].1, 1800 + int(near[0].0 * 0.12))
    living_world = w
    print("WAR STAGE mission {id} counter-board {length(far_news_api.far_counter_position(w, home_d) - board_spots[0]):.0} m")
    ui_place = 0
    if stage == "board": ui = .board
    else if id >= 0:
        ui = .contract; ui_mission = id
        if let m = find_mission(w, id): ui_line = "{m.why} Due {clock_text(w, m.deadline)}. {contract_status(w, m)}"
war_stage_pending = env("AEGEAN_CAPTURE_WAR")

# AEGEAN_CAPTURE_RACE=offer|countdown|start|racing|missed|finish|schneider|schneider-empty|schneider-finish stages a meet off the home
# harbor for headless captures of the race screens (capture only; the living world makes real ones)
capture_race = env("AEGEAN_CAPTURE_RACE")
capture_race_placed = false
capture_racers: Traffic[] = []
# (the staged Schneider race's opponents: each frame, the race task and the real flight model)
_fly_capture_racers = (dt: f64):
    k = -1
    loop i in 0..air_events.meets.len(): if air_events.meets[i].id == -7: k = i
    if k < 0: return
    n = max(1, int(ceil(dt * 60.0)))
    loop r in 0..capture_racers.len():
        tr = capture_racers[r]
        loop j in 0..n:
            loop entry in air_events.meets[k].entries:
                if entry.craft == tr.craft:
                    if let task = air_race_task(air_events.meets[k], entry, tr.state.position):
                        pace = air_class_pace(.schneider, tr.spec.cruise_speed, tr.spec.max_speed, air_events.meets[k].scale)
                        # (each holds the height it was staged at, the player's, so all stay in the shot)
                        c = air_waypoint_controls(tr.spec, tr.state, FlightEnv(), task.aim, tr.plan.altitude, pace * task.pace)
                        step(tr.spec, tr.state, c, FlightEnv(), dt / f64(n))
        tr.prop_angle += dt * 60.0
        sample_air_entry(air_events.meets[k], tr.craft, tr.state.position, living_world.tick, not tr.state.crashed)
        capture_racers[r] = tr

stage_capture_race = (stage: str, dt: f64 = 1.0 / 60.0):
    global air_events
    tick = living_world.tick
    # (schneider: the open class's long course, a race under way, the player at a gate's approach)
    schneider = stage.starts_with("schneider")
    race_scale = 1.0
    gates: AirGate[]
    loop k in (if schneider: air_class_scales(.schneider) else: [1.0]):
        if gates.len() == 0:
            gates = air_course(home.center, vec3(home.out.x, 0, home.out.y), surface_height, k); race_scale = k
    if gates.len() == 0: return
    capital = -1
    if stage == "offer" and me.mode == .aboard: pc.throttle = 0.0
    before = if stage == "offer": 600 * 60 else: (if stage == "countdown": 90 * 60 else: (if stage == "start": 2 * 60 + 30 else: -70 * 60))
    meet = AirMeet(-7, capital, lt.day_index(living_world.minute), home.name + " air meeting", gates, race_tick = tick + before, display_tick = tick + 100000, end_tick = tick + 200000)
    meet.phase = if before > 0: .registration else: .racing
    if schneider:
        global capture_race_placed, capture_racers, race_capture_clock, race_capture_kinds
        if capture_race_placed:
            _fly_capture_racers(dt)
            return
        capture_race_placed = true
        meet.race_class = .schneider; meet.scale = race_scale
        craft = living_world.people[living_world.player].craft
        # (the player at the third gate's approach, 41 s into the race; five rivals flown by the
        # flight model round the same course: two alongside, three behind. schneider-empty: the
        # same flight with no race, for frame-time comparisons; schneider-finish: the results)
        g = gates[3]; h = atan2(f64(g.forward.x), -f64(g.forward.z)); side = vec3(-g.forward.z, 0, g.forward.x)
        at = g.center - g.forward * 2600.0; at.y = 160
        pc.state = CraftState(position = at, velocity = g.forward * 470.0, orientation = quat_euler(0, -h, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, throttle = 1.0)
        debug_fuel_ml(living_world.people[living_world.player].craft, int(pc.state.fuel * 1000.0))
        pc.throttle = 1.0; pc.aim_heading = h; me.mode = .aboard
        if stage == "schneider-empty": return
        race_capture_clock = 41 * 60
        rivals = [(Craft.macchi_mc72, -11, 170.0, 30.0, 172.0), (Craft.sm_s65, -12, 70.0, -45.0, 158.0), (Craft.curtiss_r3c2, -13, -700.0, 50.0, 165.0),
            (Craft.macchi_m33, -14, -1500.0, -60.0, 150.0), (Craft.sea_lion_ii, -15, -2300.0, 40.0, 175.0)]
        race_capture_kinds = [loop r in rivals: (r.1, CRAFT_NAMES[int(r.0)])]
        if stage == "schneider-finish":
            # (finished second of six behind the M.C.72; the slower racers still out on the course)
            race_capture_clock = 85 * 60 - 300
            meet.entries.push(AirEntry(craft, living_world.player, true, gate = 0, laps = 2, started_tick = 0, finished_tick = tick + 300, sampled = true, last_tick = tick))
            loop r in rivals:
                done = if r.1 == -11: tick + 160 else: (if r.1 == -12: tick + 395 else: -1)
                meet.entries.push(AirEntry(r.1, r.1, gate = if done >= 0: 0 else: 4, laps = if done >= 0: 2 else: 1, started_tick = 0, finished_tick = done, sampled = true, last_tick = tick))
            air_events.meets = [loop m in air_events.meets: if m.id != -7: m] + [meet]
            return
        meet.entries.push(AirEntry(craft, living_world.player, true, gate = 3, laps = 0, started_tick = tick, sampled = true, last_tick = tick, previous = at))
        capture_racers = []
        loop r in rivals:
            model = default_craft_model(r.0)
            spec = craft_spec(r.0, craft_models[model].contacts)
            p = at + g.forward * f32(r.2) + side * f32(r.3); p.y = f32(r.4)
            v = air_class_pace(.schneider, spec.cruise_speed, spec.max_speed, race_scale)
            st = CraftState(position = p, velocity = g.forward * f32(v), orientation = quat_euler(0, -h, 0), fuel = spec.fuel_capacity, water_age = 1.0, throttle = 1.0)
            capture_racers.push(Traffic(craft = r.1, person = r.1, name = CRAFT_NAMES[int(r.0)], why = "Racing in the Schneider class", reason = lt.Reason(purpose = .visit, actor = r.1),
                kind = r.0, model = model, spec = spec, state = st, plan = FlightPlan(altitude = f64(p.y)), town = -1, dock = -1, flying = true, materialized = true))
            meet.entries.push(AirEntry(r.1, r.1, gate = if r.2 < 0.0: 2 else: 3, laps = 0, started_tick = tick, sampled = true, last_tick = tick, previous = p))
        air_events.meets = [loop m in air_events.meets: if m.id != -7: m] + [meet]
        return
    if stage != "offer":
        craft = living_world.people[living_world.player].craft
        mine = AirEntry(craft, living_world.player, true, gate = 3, laps = 1, started_tick = tick - 64 * 60, sampled = true, last_tick = tick)
        if stage == "countdown" or stage == "start": mine = AirEntry(craft, living_world.player, true, sampled = true, last_tick = tick)
        if stage == "missed": mine.missed = true
        if stage == "finish": mine = AirEntry(craft, living_world.player, true, gate = 0, laps = 2, started_tick = tick - 101 * 60 - 20, finished_tick = tick - 60, sampled = true, last_tick = tick)
        meet.entries.push(AirEntry(-11, -11, gate = 4, laps = 1, started_tick = tick - 66 * 60, finished_tick = if stage == "finish": tick - 300 else: -1))
        meet.entries.push(mine)
        meet.entries.push(AirEntry(-12, -12, gate = 2, laps = 1, started_tick = tick - 65 * 60))
        meet.entries.push(AirEntry(-13, -13, gate = 1, laps = 1, started_tick = tick - 63 * 60))
    air_events.meets = [loop m in air_events.meets: if m.id != -7: m] + [meet]

# The flying club's table on a meeting's quay, and its clerk behind it (src/club_desk.jo).
club_desk_view = ClubDeskView()
club_clerk_fig: Figure? = none
draw_club_tables = (L: Light):
    global club_desk_view, club_clerk_fig
    desks = club_desks(air_events, living_world.tick, scene_camera())
    if desks.len() == 0: return
    if not club_desk_view.ready: club_desk_view = make_club_desk()
    if club_clerk_fig == none: club_clerk_fig = build_figure(.merchant, 7717, age = 52)
    on_ground = [loop d in desks: (vec3(d.0.x, f32(walk_height(towns, f64(d.0.x), f64(d.0.z))), d.0.z), d.1)]
    draw_club_desks(club_desk_view, on_ground, L, t)
    loop d in on_ground:
        behind = d.0 - vec3(f32(sin(d.1)), 0, f32(cos(d.1))) * 0.8
        draw_figure(club_clerk_fig!, behind, d.1, 0.0, 0.0, L, t)

# AEGEAN_CAPTURE_RACELEAD=heard|arrive|desk|after|paper: the race lead followed (captures). The
# Kalyran capital's club meeting tomorrow at five is posted as the club posts it the day before.
# heard: in Porto Vecchio, asked what they've heard, someone tells of it (AEGEAN_LEADS=always);
# arrive: in the air 2.5 km off the capital's harbour, its course's pylons ahead (AEGEAN_FLYING);
# desk: on foot at the club's table on its quay, the name put down a moment later; after: home
# again, a second place at it told in the town, someone met says so; paper: and the paper prints it.
racelead_stage_frame = -1
racelead_meet = -1
racelead_capital = () -> int:
    loop c in living_world.countries:
        if c.key == "kalyra": return c.capital_id
    -1
racelead_post = () -> int:
    cap = racelead_capital()
    if cap < 0 or not (cap in living_world.far.harbors): return -1
    harbor = living_world.far.harbors[cap]
    day = lt.day_index(living_world.minute) + 1
    id = air_meet_id(cap, day, .club)
    if air_meet_index(air_events, id) >= 0: return air_meet_index(air_events, id)
    gates = air_course(living_world.place_contexts[cap].center, harbor.out, surface_height, 1.0)
    if gates.len() == 0: return -1
    start = (day * 1440 + air_class_start(.club) - lt.EPOCH_LOCAL_MINUTE) * lt.TICKS_PER_MINUTE
    meet = AirMeet(id, cap, day, living_world.place_contexts[cap].name + " air meeting", gates, race_tick = start, display_tick = start + 120 * 120, end_tick = start + 200 * 120, race_class = .club)
    if harbor.quays.len() > 0:
        right = vec3(-harbor.out.z, 0, harbor.out.x)
        meet.quay_a = harbor.quays[0] - right * 12.0; meet.quay_b = harbor.quays[0] + right * 12.0
    loop pilot in air_events.pilots:
        if pilot.capital == cap and club_class(living_world, pilot.craft) == .club: _ = enter_air_meet(meet, pilot.craft, pilot.person, false, living_world.tick)
    air_events.meets.push(meet)
    air_events.meets.len() - 1
stage_capture_racelead = (stage: str):
    global racelead_stage_frame, racelead_meet
    if racelead_stage_frame < 0:
        if frame_number() < 3 or not living_world.far.populated: return
        racelead_stage_frame = frame_number()
        k = racelead_post()
        racelead_meet = k
        cap = racelead_capital()
        print("RACELEAD staged {stage}: meet {k} at {if cap >= 0: living.place_name(living_world, cap) else: "?"}")
        if k < 0: return
        meet = air_events.meets[k]
        if stage == "heard":
            # (someone near in Porto Vecchio; their other news already told, so this is what comes)
            best = -1; bd = 1e9
            loop i in 0..folks.len():
                q = folks[i].person
                if not folks[i].shown or q == living_world.player or band_wanted(living_world, q) > 0: continue
                d = f64(length(folks[i].pos - me.pos))
                if d < bd: bd = d; best = i
            if best >= 0:
                q = folks[best].person
                loop l in leads_for(living_world, q, _lead_meets()):
                    if l.kind != .race: lead_told_now(living_world, q, l)
                fp = folks[best].pos
                away = normalize(vec3(me.pos.x - fp.x, 0, me.pos.z - fp.z) + vec3(0.0001, 0, 0))
                me.mode = .walking
                me.pos = vec3(fp.x + away.x * 1.6, f32(walk_height(towns, f64(fp.x + away.x * 1.6), f64(fp.z + away.z * 1.6))), fp.z + away.z * 1.6)
                me.yaw = atan2(f64(-away.x), f64(-away.z)); me.stride = 0.0
                follow.yaw = me.yaw + PI + 0.7; follow.distance = 3.6; follow.pitch = 0.2; follow.height = 1.5; follow.placed = false
                global rep_ask_k, rep_talk_due, adrift_ask_due
                rep_ask_k = best; rep_talk_due = t + 1.5; adrift_ask_due = t + 4.5
        else if stage == "arrive":
            at = meet.gates[0].center
            harbour = (meet.quay_a + meet.quay_b) * 0.5
            to = normalize(vec3(harbour.x - at.x, 0, harbour.z - at.z) + vec3(0.0001, 0, 0))
            start = harbour - to * 2600.0 + vec3(-to.z, 0, to.x) * 300.0
            h = atan2(f64(to.x), -f64(to.z))
            spd = f64(length(pc.state.velocity))
            pc.state.position = vec3(start.x, f32(160.0), start.z)
            pc.state.velocity = heading_vector(h) * f32(spd)
            pc.state.orientation = quat_euler(0, -h, 0)
            pc.aim_heading = h; pc.placed = false
        else if stage == "desk":
            if let desk = club_desk_at(meet):
                yaw = club_desk_yaw(meet)
                face = vec3(f32(sin(yaw)), 0, f32(cos(yaw)))
                p = desk + face * 1.6
                me.mode = .walking
                me.pos = vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)
                me.yaw = yaw + PI; me.stride = 0.0
                follow.yaw = me.yaw + PI + 0.9; follow.distance = 4.2; follow.pitch = 0.22; follow.height = 1.5; follow.placed = false
                portage.cargo_person_pose(living_world, living_world.player, me.pos)
        else if stage == "after" or stage == "paper":
            # (the race flown: second of four; Porto Vecchio has heard)
            here = rep_town_of_place(living_world, 0)
            d = rep_record_race(living_world, meet.id, meet.capital, 2, 4, false)
            rep_stage_heard(living_world, here, d, 1, 900)
            if stage == "paper":
                leisure_sit("coffee")
                paper_open()
                paper_view.scroll = to_float(env("AEGEAN_PAPER_SCROLL") ?? "0") ?? 0.0
            else:
                best = -1; bd = 1e9
                loop i in 0..folks.len():
                    q = folks[i].person
                    if not folks[i].shown or q == living_world.player or band_wanted(living_world, q) > 0: continue
                    if rep_view(living_world, q).deed != d: continue
                    dd = f64(length(folks[i].pos - me.pos))
                    if dd < bd: bd = dd; best = i
                if best >= 0:
                    fp = folks[best].pos
                    away = normalize(vec3(me.pos.x - fp.x, 0, me.pos.z - fp.z) + vec3(0.0001, 0, 0))
                    me.mode = .walking
                    me.pos = vec3(fp.x + away.x * 1.6, f32(walk_height(towns, f64(fp.x + away.x * 1.6), f64(fp.z + away.z * 1.6))), fp.z + away.z * 1.6)
                    me.yaw = atan2(f64(-away.x), f64(-away.z)); me.stride = 0.0
                    follow.yaw = me.yaw + PI + 0.7; follow.distance = 3.6; follow.pitch = 0.2; follow.height = 1.5; follow.placed = false
                    global rep_ask_k, rep_talk_due
                    rep_ask_k = best; rep_talk_due = t + 1.5
        return
    wait = frame_number() - racelead_stage_frame
    if stage == "heard" and adrift_ask_due >= 0.0 and t >= adrift_ask_due and ui == .talk:
        global adrift_ask_due, ui_line, ui_turn
        adrift_ask_due = -1.0
        ui_turn = living.talk(living_world, folks[ui_folk].person, .news, living_world.player)
        said = tell_lead(folks[ui_folk].person)
        ui_line = if said != "": said else: turn_text(ui_turn)
        print("RACELEAD told: {ui_line}")
    if stage == "desk":
        if wait == 30: print("RACELEAD cards {[loop o in walk_offers(): offer_card(o)]}")
        if wait == 180 and racelead_meet >= 0:
            # (the aircraft as a pilot brings it to a race: fuelled and sound)
            pcr = living_world.people[living_world.player].craft
            if pcr >= 0:
                living_world.aircraft[pcr].fuel_ml = lt.AIRFRAMES[int(living_world.aircraft[pcr].kind)].tank_ml
                living_world.aircraft[pcr].hull = 1000; living_world.aircraft[pcr].engine = 1000; living_world.aircraft[pcr].revision += 1
                # (flown in and moored off the host harbour, as a pilot comes to a race)
                living_world.aircraft[pcr].pose.pos = air_events.meets[racelead_meet].gates[0].center
            entry = enter_player_air_meet(air_events, living_world, air_events.meets[racelead_meet].id)
            say_toast(if entry.accepted: "Entered. The race starts at {clock_text(living_world, air_events.meets[racelead_meet].race_tick / 120)}" else: entry.reason)
            print("RACELEAD entered {entry.accepted} {entry.reason}")

# (the mail errand capture: the world on to the morning a bag is made up for an island, then on to
# a quarter past eight, the office open)
errand_cap_find = () -> int:
    loop m in 0..3 * 1440:
        loop id, e in living_world.errands:
            if e.kind == .mail and living_world.jobs[id].origin == 0 and living_world.jobs[id].state == .open: return id
        living.advance_minutes(living_world, 1)
    -1
_errand_cap_beside = (k: int, dist: f64):
    global me, follow
    fp = folks[k].pos
    away = normalize(vec3(me.pos.x - fp.x, 0, me.pos.z - fp.z) + vec3(0.0001, 0, 0))
    me.mode = .walking
    me.pos = vec3(fp.x + away.x * f32(dist), f32(walk_height(towns, f64(fp.x + away.x * f32(dist)), f64(fp.z + away.z * f32(dist)))), fp.z + away.z * f32(dist))
    me.yaw = atan2(f64(-away.x), f64(-away.z)); me.stride = 0.0
    follow.yaw = me.yaw + PI + 0.9; follow.distance = 4.6; follow.pitch = 0.06; follow.height = 0.5; follow.placed = false
    portage.cargo_person_pose(living_world, living_world.player, me.pos)
_errand_cap_folk = (person: int) -> int:
    loop i in 0..folks.len():
        if folks[i].shown and folks[i].person == person: return i
    -1
stage_capture_errand = (stage: str):
    global errand_stage_frame, errand_cap_job, errand_cap_folk, hour
    if errand_stage_frame < 0:
        if frame_number() < 3 or not living_world.far.populated: return
        errand_stage_frame = frame_number()
        id = errand_cap_find()
        errand_cap_job = id
        if id < 0:
            print("ERRAND none posted")
            return
        print("ERRAND found {id} at {lt.local_minute(living_world.minute)} day {lt.day_index(living_world.minute)} state {living_world.jobs[id].state} posted {living_world.errands[id].posted}")
        # (a quarter past eight: the office open, the bag waiting)
        loop lt.local_minute(living_world.minute) < 495 and id in living_world.jobs: living.advance_minutes(living_world, 1)
        if not (id in living_world.jobs):
            print("ERRAND job {id} gone at {lt.local_minute(living_world.minute)}")
            errand_cap_job = -1
            return
        j = living_world.jobs[id]
        e = living_world.errands[id]
        print("ERRAND job {id} {job_cargo(id)} from {living_world.people[j.poster].name} to {living_world.people[e.recipient].name} at {living.place_name(living_world, j.destination)}; {phoenix_text(j.reward_cents)} state {j.state}")
        if stage == "arrive":
            # (on his way over with it, half an hour after the bag came aboard)
            living.advance_minutes(living_world, 75)
        if stage == "handover":
            took = agree_cargo_job(id, .automatic)
            print("ERRAND took: {took}")
            waited = 0
            loop waited < 180 and not living_world.jobs[id].loaded:
                living.advance_minutes(living_world, 1); waited += 1
            print("ERRAND loaded {living_world.jobs[id].loaded} after {waited} minutes")
            gone = living_scene.scene_player_departure(living_world)
            cr = living_world.people[living_world.player].craft
            print("ERRAND departed {gone}: trip {living_world.aircraft[cr].trip} place {living_world.aircraft[cr].place} state {living_world.aircraft[cr].state}")
            living.advance_minutes(living_world, 35)
        sync_folk(folks, living_world, towns)
        hour = f64(lt.local_minute(living_world.minute)) / 60.0
        if stage == "offer":
            k = _errand_cap_folk(j.poster)
            print("ERRAND poster folk {k}")
            if k >= 0:
                _errand_cap_beside(k, 1.6)
                global rep_ask_k, rep_talk_due
                rep_ask_k = k; rep_talk_due = t + 1.5
        else if stage == "arrive":
            tw = towns[j.destination]
            d = tw.docks[0]; out = vec3(tw.out.x, 0, tw.out.y)
            to = vec3(-out.x, 0, -out.z)
            start = d + out * 1300.0 + vec3(-to.z, 0, to.x) * 60.0
            h = atan2(f64(to.x), -f64(to.z))
            spd = f64(length(pc.state.velocity))
            pc.state.position = vec3(start.x, f32(120.0), start.z)
            pc.state.velocity = heading_vector(h) * f32(spd)
            pc.state.orientation = quat_euler(0, -h, 0)
            pc.aim_heading = h; pc.placed = false
        else if stage == "handover":
            tw = towns[j.destination]
            d = tw.docks[0]; out = vec3(tw.out.x, 0, tw.out.y)
            h = atan2(f64(-out.x), f64(out.z))
            pc.state = water_start(pc.spec, vec3(d.x + out.x * 8.0, 0, d.z + out.z * 8.0), h)
            pc.throttle = 0.0; pc.aim_heading = h; pc.placed = false
            moor(pc.state, vec3(d.x, f32(pc.spec.float_height), d.z), h)
            tie_up()
            # (the world has him in: the trip ended at that dock, as the mooring does)
            cr = living_world.people[living_world.player].craft
            living_world.aircraft[cr].pose.pos = living_world.harbors[j.destination].docks[0]
            living_world.aircraft[cr].pose.vel = vec3(0, 0, 0)
            arrived = living_scene.scene_player_arrival(living_world, j.destination, 0)
            print("ERRAND arrived {arrived}")
            living.advance_minutes(living_world, 1)
            sync_folk(folks, living_world, towns)
            k = _errand_cap_folk(e.recipient)
            errand_cap_folk = k
            print("ERRAND recipient folk {k} awaited {portage.cargo_awaited(living_world, e.recipient)} craft place {living_world.aircraft[living_world.people[living_world.player].craft].place}")
            if k >= 0:
                # (the pilot stepped onto the dock at the loading place; the postmaster a few steps
                # off, come down from the town as the aircraft tied up)
                spot = portage.cargo_meeting_spot(living_world, id)
                tw = towns[j.destination]
                inland = normalize(vec3(-tw.out.x, 0, -tw.out.y))
                fp = spot + inland * 9.0
                fp = vec3(fp.x, f32(walk_height(towns, f64(fp.x), f64(fp.z))), fp.z)
                folks[k].pos = fp
                living_world.people[e.recipient].pose.pos = fp
                me.mode = .walking
                me.pos = vec3(spot.x, f32(walk_height(towns, f64(spot.x), f64(spot.z))), spot.z)
                me.yaw = atan2(f64(inland.x), f64(inland.z)); me.stride = 0.0
                follow.yaw = me.yaw + PI + 0.5; follow.distance = 4.4; follow.pitch = 0.1; follow.height = 1.0; follow.placed = false
                portage.cargo_person_pose(living_world, living_world.player, me.pos)
        return
    wait = frame_number() - errand_stage_frame
    if errand_cap_job < 0: return
    id = errand_cap_job
    # (offer: the card up a moment, then the pilot takes it, the porter called for)
    if stage == "offer" and wait == 200 and ui == .talk:
        global ui_line, ui_turn
        ui_turn = living.ask_for_work(living_world, folks[ui_folk].person, living_world.player)
        ui_line = turn_text(ui_turn)
        print("ERRAND asked for work: {ui_line}")
    if stage == "offer" and wait == 480 and ui == .talk:
        global ui_line
        ui_line = said_by(living_world.people[living_world.jobs[id].poster].name, agree_cargo_job(id, .automatic))
        print("ERRAND offer taken: {ui_line}")
    # (handover: walked up to the postmaster, then handed it)
    if stage == "handover" and errand_cap_folk >= 0 and wait > 60:
        fp = folks[errand_cap_folk].pos
        dd = vec2(fp.x - me.pos.x, fp.z - me.pos.z)
        if f64(length(dd)) > 1.7 and wait < 400:
            dir = normalize(dd)
            step_player_walk(dir * f32(1.5 / 60.0))
            me.yaw = approach_angle(me.yaw, atan2(f64(dir.x), f64(dir.y)), 6.0, 1.0 / 60.0)
            me.stride = approach(me.stride, 0.7, 8.0, 1.0 / 60.0); me.phase += 1.0 / 60.0 * 1.5 * 5.0
            portage.cargo_person_pose(living_world, living_world.player, me.pos)
        else if living_world.jobs[id].state == .claimed and errand_cap_folk >= 0:
            me.stride = approach(me.stride, 0.0, 8.0, 1.0 / 60.0)
            if wait % 30 == 0:
                k, hid = handover_here()
                print("ERRAND at the postmaster: {k} {hid}")
                if hid == id:
                    handover_act()
                    errand_cap_folk = -1

# A race the pilot flew, once he is in or out of it: placed, talked of (src/reputation.jo).
race_results_told = ():
    if capture_racelead == "list" and frame_number() % 600 == 0:
        print("MEETS {air_events.meets.len()} far {living_world.far.populated} minute {living_world.minute}")
        loop m in air_events.meets: print("MEET {m.id} capital {m.capital} {m.name} day {m.day} today {lt.day_index(living_world.minute)} phase {m.phase} class {m.race_class} at {m.quay_a} start {lt.local_minute(m.race_tick / 120)} entries {m.entries.len()}")
    if frame_number() % 30 != 0: return
    loop meet in air_events.meets:
        if meet.id in living_world.rep.raced_meets: continue
        if let e = player_air_entry(meet, living_world.player):
            done = e.finished_tick >= 0 or e.disqualified or meet.phase == .display or meet.phase == .finished
            if not done or meet.phase == .registration: continue
            # (the place as the club's standings give it, as the finish card shows it)
            rank = 0
            if e.finished_tick >= 0:
                standings = air_standings(meet)
                loop k in 0..standings.len():
                    if standings[k].person == living_world.player and standings[k].human: rank = k + 1
            id = rep_record_race(living_world, meet.id, meet.capital, rank, meet.entries.len(), meet.race_class == .schneider)
            if capture_racelead != "": print("RACE told: meet {meet.id} rank {rank} of {meet.entries.len()} deed {id}")

# the air race open for entry here, when F has nothing else to do here (-1 otherwise)
race_offer_here = () -> int:
    if paused or show_chart or ui != .none or notebook.open: return -1
    if me.mode == .walking:
        # (beside other things to do, it is offered with them: walk_offers)
        if holding_cargo() >= 0: return -1
        # (at the club's table on the meeting's quay: src/club_desk.jo)
        k = race_offer(air_events, living_world, me.pos)
        if k >= 0 and not club_desk_near(air_events.meets[k], me.pos): k = -1
        if k >= 0: return k
        k = race_withdraw_offer(air_events, living_world, me.pos)
        return if k >= 0 and club_desk_near(air_events.meets[k], me.pos): k else: -1
    -1


# ---------------- the Neravessa workshop (repair_desk reads the saved repair; repair_panel draws) ----------------
# On foot within reach of the canal city's workshop, the card offers repairs; F (or the card) asks.
# Asking requests the repair through the standard dispatcher once; the panel then reads the saved
# obligation every frame. The living world's minutes do the work; the panel never advances it.
workshop_id = -1                    # the repair the panel shows (-1: none)
workshop_confirm = false            # asking whether to stop the work
workshop_notice = ""
workshop_logged = -1                # the finished repair already in the notebook

workshop_prompt = () -> str:
    if me.mode != .walking or ui != .none or holding_cargo() >= 0 or near_own_craft(): return ""
    if not (CANAL_CITY_ID in living_world.far.districts): return ""
    if length(living_world.people[living_world.player].pose.pos - canal_workshop) > DESK_REACH: return ""
    "F  ask at the workshop about repairs"

open_workshop = ():
    global ui, workshop_id, workshop_confirm, workshop_notice
    id = desk_request(living_world, living_world.player)
    # (a repair finished since the panel last showed it is shown once more, done)
    keep = workshop_id >= 0 and workshop_id in living_world.obligations and living_world.obligations[workshop_id].state == .fulfilled and workshop_logged != workshop_id
    if id >= 0 or not keep: workshop_id = id
    workshop_confirm = false
    workshop_notice = ""
    ui = .workshop
    _ = mouse_lock(false)

workshop_panel = ():
    global ui, workshop_id, workshop_confirm, workshop_notice, workshop_logged
    who = living_world.player
    if skip.active: return
    if me.mode != .walking or length(living_world.people[who].pose.pos - canal_workshop) > DESK_REACH + 10.0:
        ui = .none
        return
    d = repair_desk(living_world, who, workshop_id)
    now = clock_text(living_world, living_world.minute)
    if d.phase == .done and workshop_logged != d.id:
        workshop_logged = d.id
        log_note(notebook, "The {CANAL_CITY_NAME} workshop repaired the {d.part}: now at {d.now_pct}%, {desk_money(d.charged_cents)}.", now)
        # (the aircraft takes up her repaired condition through the usual reconciliation)
        if pc.state.moored: sync_living_player(pc, living_world)
    res = repair_panel(fonts, d, CRAFT_NAMES[int(pc.kind)], workshop_confirm, workshop_notice)
    if res.refused != "": workshop_notice = res.refused
    match res.action:
        .start:
            why = desk_start(living_world, workshop_id)
            if why == "":
                o = living_world.obligations[workshop_id]
                log_note(notebook, "Left the {CANAL_CITY_NAME} workshop to repair the {desk_part(o)}, {desk_money(o.amount_cents)}.", now)
                workshop_notice = "The work has started; {desk_money(o.amount_cents)} charged."
            else: workshop_notice = why
        .stop: workshop_confirm = true
        .keep: workshop_confirm = false
        .confirm_stop:
            refund = d.refundable_cents
            why = desk_cancel(living_world, workshop_id)
            workshop_confirm = false
            if why == "":
                log_note(notebook, "Stopped the repair at the {CANAL_CITY_NAME} workshop; {desk_money(refund)} of labour refunded.", now)
                workshop_notice = "The work stopped. {desk_money(refund)} of labour came back to you."
            else: workshop_notice = why
        .wait:
            workshop_notice = ""
            leisure_skip(max(1, d.work_total - d.work_done + 1), "Waiting at the {CANAL_CITY_NAME} workshop")
        .again:
            workshop_id = desk_request(living_world, who)
            workshop_notice = ""
        .close:
            if d.phase == .done: workshop_id = -1
            workshop_confirm = false
            ui = .none
        _: pass

# ---------------- taking on fuel (living_refuel sells it; fuel_counter is the panel) ----------------
# Aboard, moored or slow on the water within reach of a harbour's fuel pier, with room in the tank,
# the card offers fuel once at each stop; F moors alongside (if not already) and opens the panel.
# A sale starts the refuelling moment: the pump works and the gauge runs up to the new reading.
FUEL_NOWHERE = vec3(1.0e9, 0, 1.0e9)
fuel_pier_seen: refuel.FuelPier? = none     # the pier within reach, looked up every few frames
fuel_pier_frame = -100
fuel_offered_at = FUEL_NOWHERE              # where the card was last answered
fuel_panel_pier = refuel.FuelPier()         # the pier whose panel is open
fuel_notice = ""
refuel_from = 0.0
refuel_to = 0.0
refuel_start = -100.0
refuel_len = 0.0

fuel_pier_near = () -> refuel.FuelPier?:
    global fuel_pier_seen, fuel_pier_frame
    st = pc.state
    if me.mode != .aboard or st.crashed or st.capsized or st.beached or vessel_mooring.vessel >= 0: return none
    # (a landplane takes on fuel at an airfield's fuel point, from the stores of the town it serves)
    if pc.spec.landplane:
        if not st.on_ground or length(vec3(st.velocity.x, 0, st.velocity.z)) > 2.0: return none
        k = nearest_airfield(st.position.xz, 3000.0)
        if k < 0: return none
        f = AIRFIELDS[k]; stand = airfield_fuel_stand(f)
        if length((st.position - stand).xz) > 18.0 or not (f.place in living_world.far.districts): return none
        return refuel.FuelPier(core = living_world.far.districts[f.place].core, district = f.place, dock = stand, name = f.name)
    if not st.moored and (not st.on_water or length(vec3(st.velocity.x, 0, st.velocity.z)) > 2.0): return none
    if frame_number() - fuel_pier_frame >= 10 or frame_number() < fuel_pier_frame:
        fuel_pier_seen = refuel.fuel_pier_at(living_world, st.position)
        fuel_pier_frame = frame_number()
    fuel_pier_seen

# the fuel card's words, or "" when there is none to show
fuel_offer_text = (again: bool = false) -> str:
    if paused or show_chart or ui != .none or notebook.open or rescue_act == 1: return ""
    # (again: offered beside stepping ashore, even after the panel was opened here once)
    if not again and length((pc.state.position - fuel_offered_at).xz) < 30.0: return ""
    c = living_world.people[living_world.player].craft
    if c < 0 or lt.AIRFRAMES[int(living_world.aircraft[c].kind)].tank_ml - living_world.aircraft[c].fuel_ml < 1000: return ""
    if let p = fuel_pier_near(): return "F  take on fuel, {fuel_litre_price(refuel.fuel_price(living_world, p))} a litre"
    ""

open_fuel_pier = ():
    global ui, fuel_offered_at, fuel_panel_pier, fuel_notice
    p = fuel_pier_near()
    if p == none: return
    if not pc.state.moored and not pc.spec.landplane:
        if let d = dock_spot():
            if not dock_taken(d, others_at()):
                moor(pc.state, vec3(d.x, f32(pc.spec.float_height), d.z), heading(pc.state))
                pc.throttle = 0.0
                tie_up()
                th = town_here(d)
                if th >= 0: deliver_here(th)
    fuel_panel_pier = p!
    fuel_offered_at = pc.state.position
    fuel_notice = ""
    ui = .fuel
    mouse_lock(false)

refueling = () -> bool: t < refuel_start + refuel_len

# (stepping ashore and back aboard is a new stop: the card may offer fuel again)
fuel_stop_step = ():
    global fuel_offered_at
    if me.mode != .aboard: fuel_offered_at = FUEL_NOWHERE

# what the fuel gauges read: the tank, or the rising reading while the pump works
fuel_reading = () -> f64: if refueling(): refuel_gauge(refuel_from, refuel_to, t - refuel_start, refuel_len) else: pc.state.fuel

# a sale at the open panel's pier: 0 fills up, 1 adds 10 litres, 2 adds 20
# the most fuel the purse pays for here, in whole litres (dues included), or 0
fuel_affordable_ml = (p: refuel.FuelPier) -> int:
    w = living_world
    lo = 0; hi = 400
    loop hi - lo > 1:
        mid = (lo + hi) / 2
        if refuel.fuel_quote(w, p, w.player, mid * 1000).ml > 0: lo = mid else: hi = mid
    lo * 1000

fuel_take = (choice: int):
    global fuel_notice, refuel_from, refuel_to, refuel_start, refuel_len
    w = living_world; who = w.player; c = w.people[who].craft
    if c < 0: return
    p = fuel_panel_pier
    cap = lt.AIRFRAMES[int(w.aircraft[c].kind)].tank_ml
    before = f64(w.aircraft[c].fuel_ml) / 1000.0
    got = refuel.buy_tank_fuel(living_world, p, who, [cap, 10000, 20000, fuel_affordable_ml(p)][choice], choice == 0)
    if got.ml > 0:
        pc.state.fuel = f64(living_world.aircraft[c].fuel_ml) / 1000.0
        refuel_from = before; refuel_to = pc.state.fuel; refuel_start = t; refuel_len = refuel_seconds(f64(got.ml) / 1000.0)
        pump_sound(audio)
        fuel_notice = "Took on {fuel_litres_text(got.ml)} for {phoenix_text(got.cents)}."
        log_note(notebook, "Took on {fuel_litres_text(got.ml)} of fuel at {p.name}, {phoenix_text(got.cents)}.", clock_text(living_world, living_world.minute))
    else: fuel_notice = got.reason

# the panel, each frame it is open: the sale goes through the living world's books
fuel_panel = ():
    global ui, fuel_notice
    w = living_world; who = w.player; c = w.people[who].craft
    p = fuel_panel_pier
    if c < 0 or me.mode != .aboard or (not refueling() and length((pc.state.position - p.dock).xz) > 45.0):
        ui = .none
        return
    cap = lt.AIRFRAMES[int(w.aircraft[c].kind)].tank_ml
    fill = refuel.fuel_quote(w, p, who, cap, partial = true)
    q10 = refuel.fuel_quote(w, p, who, 10000)
    q20 = refuel.fuel_quote(w, p, who, 20000)
    options = [FuelOption("Fill up", fill.ml, fill.cents, fill.reason), FuelOption("Add 10 litres", q10.ml, q10.cents, q10.reason), FuelOption("Add 20 litres", q20.ml, q20.cents, q20.reason)]
    # (a purse short of a full tank: as much as it pays for)
    if fill.ml == 0 and fill.cash < fill.cents:
        most = fuel_affordable_ml(p)
        if most > 0:
            q = refuel.fuel_quote(w, p, who, most)
            options.push(FuelOption("Fill what {phoenix_text(fill.cash)} buys", q.ml, q.cents, q.reason))
    res = fuel_counter(fonts, p.name, refuel.fuel_price(w, p), fuel_reading(), f64(cap) / 1000.0, fill.stock_ml, player_cents(), options, refueling(), fuel_notice, dues = p.core >= 0 and p.core != 5, lighter = lighter_phase == 2)
    if res.choice >= 0: fuel_take(res.choice)
    if res.refused >= 0: fuel_notice = options[res.refused].reason
    if res.closed: ui = .none

# (AEGEAN_CAPTURE_FUEL=prompt|panel|pumping|after|done|empty|poor: aboard at the home pier with
# the card, the panel, filling up (mid-pump, after, and the panel closed again), the pier bought
# dry, the purse nearly empty.
# Captures only; every change goes through the books.)
capture_fuel = env("AEGEAN_CAPTURE_FUEL")
capture_fuel_open = -1
stage_capture_fuel = (stage: str):
    global fuel_offered_at, fuel_pier_seen, capture_fuel_open, ui
    n = frame_number()
    c = living_world.people[living_world.player].craft
    if n == 2:
        me.mode = .aboard
        fuel_offered_at = FUEL_NOWHERE
        if stage == "poor": debug_cents(300)
        if stage == "empty":
            debug_cents(100000)
            loop k in 0..12:
                if let p = refuel.fuel_pier_at(living_world, living_world.aircraft[c].pose.pos):
                    if refuel.buy_tank_fuel(living_world, p, living_world.player, 80000, true).ml == 0: break
                debug_fuel_ml(c, 24000)
            debug_cents(12000)
            pc.state.fuel = f64(living_world.aircraft[c].fuel_ml) / 1000.0
    if capture_fuel_open < 0 and n >= 4 and stage != "prompt" and fuel_offer_text() != "":
        open_fuel_pier()
        if ui == .fuel: capture_fuel_open = n
    if capture_fuel_open > 0 and n == capture_fuel_open + 2 and (stage == "pumping" or stage == "after" or stage == "done"): fuel_take(0)
    if capture_fuel_open > 0 and n == capture_fuel_open + 240 and stage == "done": ui = .none


# (AEGEAN_CAPTURE_WORKSHOP=prompt|quote|underway|confirm|interrupted|done|refused|poor: on foot by
# the Neravessa workshop with the aircraft moored at its slipway and its engine worn to 60%; the card,
# the quote, the work under way (twenty minutes in), asking to stop it, stopped, finished, the
# aircraft moored away from the slipway, the purse too thin. Captures only; the repair itself goes
# through the desk, and the world's own minutes do the work.)
capture_workshop = env("AEGEAN_CAPTURE_WORKSHOP")
capture_workshop_from = -1         # (the frame the canal city's district was ready)
stage_capture_workshop = (stage: str):
    global me, follow, workshop_confirm, capture_workshop_from
    c = living_world.people[living_world.player].craft
    if frame_number() == 2:
        settlement_registry.finish_settlement_registry()
        init_canal_geometry()
        berth = if stage == "refused": canal_launch + heading_vector(canal_heading) * 90.0 else: canal_launch
        level = canal_launch.y
        pc.state = water_start(pc.spec, vec3(berth.x, level, berth.z), canal_heading)
        moor(pc.state, vec3(berth.x, level + f32(pc.spec.float_height), berth.z), canal_heading)
        pc.throttle = 0.0
        tie_up()
        me.mode = .walking
        # (on the quay between the slipway and the workshop, clear of the aircraft)
        toward = normalize(vec3(canal_workshop.x - canal_launch.x, 0, canal_workshop.z - canal_launch.z))
        spot = canal_launch + toward * 22.0
        me.pos = vec3(spot.x, f32(walk_height(towns, f64(spot.x), f64(spot.z))), spot.z)
        me.yaw = atan2(f64(canal_workshop.x - me.pos.x), f64(canal_workshop.z - me.pos.z))
        follow.yaw = me.yaw + PI + 0.9; follow.placed = false
        if stage == "poor": debug_cents(300) else: debug_cents(max(player_cents(), 5000))
    if capture_workshop_from < 0:
        if frame_number() > 2 and CANAL_CITY_ID in living_world.far.districts: capture_workshop_from = frame_number()
        return
    n = frame_number() - capture_workshop_from
    if n == 0:
        if c >= 0: living_world.aircraft[c].engine = 600
        # (a mechanic at the bench)
        found = false
        loop p in living_world.far.districts[CANAL_CITY_ID].named:
            if living_world.far.people[p].role == .artisan: found = true
        if not found: _ = settlement_residents.promote_far_person(living_world, CANAL_CITY_ID, .artisan)
        loop p in living_world.far.districts[CANAL_CITY_ID].named:
            if living_world.far.people[p].role == .artisan: living_world.people[p].pose.pos = canal_yard
    if n == 2: print("WORKSHOP ready at frame {capture_workshop_from}; refusal='{desk_refusal(living_world, living_world.player)}' craft={c} state={living_world.aircraft[c].state} engine={living_world.aircraft[c].engine}")
    if n == 4 and stage != "prompt": open_workshop()
    if n == 6 and (stage == "underway" or stage == "confirm" or stage == "interrupted" or stage == "done"):
        why = desk_start(living_world, workshop_id)
        o = living_world.obligations[workshop_id]
        print("WORKSHOP start='{why}' id={workshop_id} started={o.repair_started_minute} state={o.state} craft={living_world.aircraft[c].state} cash={living_world.accounts[living_world.people[living_world.player].account].cents}")
    if n == 7 and (stage == "underway" or stage == "confirm" or stage == "interrupted"): living.advance_minutes(living_world, 20)
    if n == 7 and stage == "done": living.advance_minutes(living_world, 75)
    if n == 8 and (stage == "confirm" or stage == "interrupted"): workshop_confirm = true
    if n == 9 and stage == "interrupted":
        why = desk_cancel(living_world, workshop_id)
        workshop_confirm = false
        print("WORKSHOP cancel='{why}'")
    if n == 10: print("WORKSHOP desk={to_text(repair_desk(living_world, living_world.player, workshop_id))}")

# How far the player's aircraft can go to a meet on the fuel aboard, keeping the entry's fuel.
player_meet_reach = () -> f64: meet_reach_m(pc.state.fuel, pc.spec.fuel_burn, pc.spec.cruise_speed)

# Aboard at a home harbour with a fuel pier, a meet in the next two days beyond the fuel aboard
# shows the race card once, pointing to the pier.
meet_fuel_shown: {int: bool}
meet_fuel_card = ""
meet_fuel_until = 0.0
meet_fuel_step = ():
    global meet_fuel_shown, meet_fuel_card, meet_fuel_until
    st = pc.state
    if st.crashed or st.capsized or st.beached or not st.on_water or length(st.velocity) > 8.0: return
    if fuel_pier_here(living_world, st.position) == none: return
    hint = meet_fuel_hint(air_events, living_world, st.position, player_meet_reach())
    if hint.0 == "" or hint.1 in meet_fuel_shown: return
    meet_fuel_shown[hint.1] = true
    meet_fuel_card = hint.0; meet_fuel_until = t + 9.0

# A townsperson greeting the player mentions the nearest air meet ahead, once a day each.
meet_remarked: {int: int}
# (the remark goes after what they say, before any question they ask)
with_meet_remark = (speaker: int, turn: social.ConversationTurn) -> str:
    global meet_remarked
    day = lt.day_index(living_world.minute)
    if meet_remarked.get(speaker, -1) == day or turn.exhausted: return turn_text(turn)
    remark = air_meet_remark(air_events, living_world, speaker, me.pos)
    if remark == "": remark = tavli_remark(living_world, leisure.tavli, speaker)
    if remark == "": return turn_text(turn)
    meet_remarked[speaker] = day
    said = if turn.text == "": remark else: "{turn.text} {remark}"
    if turn.question != "": "{said} {turn.question}" else: said


# ---------------- map sellers, and people to be picked up from the water ----------------

# a map seller's counter within a few steps, when F has nothing else to do here ("": none)
map_shop_here = () -> str:
    if paused or show_chart or ui != .none or notebook.open or me.mode != .walking: return ""
    if holding_cargo() >= 0 or near_job_cargo() >= 0 or near_own_craft() or near_map_find() >= 0 or near_board() >= 0 or nearest_folk(folks, me.pos, 3.5) >= 0: return ""
    best = ""
    bd = 7.0
    loop s in living.map_sellers(living_world, living_world.player):
        d = f64(length(vec2(s.pos.x - me.pos.x, s.pos.z - me.pos.z)))
        if d < bd: best = s.id; bd = d
    best

# the map seller someone keeps, when one is at their counter ("": none)
map_shop_of = (person: int) -> str:
    loop s in living.map_sellers(living_world, living_world.player):
        if s.person == person: return s.id
    ""

map_shop_prompt = (shop: str) -> str:
    s = living_world.maps.shops[shop]
    ready = false
    loop r in map_counter_rows(living_world, shop, living_world.player):
        if r.job >= 0 and r.ready: ready = true
    if ready: "F  collect the promised map at {s.name}" else: "F  look at the maps for sale at {s.name}"

open_map_counter = (shop: str):
    global ui, ui_shop
    ui = .maps
    ui_shop = shop
    mouse_lock(false)

rescue = RescueView()
# (what F does for a rescue this frame: 1 take survivor `rescue_id` aboard, 2 set them ashore)
rescue_act = 0
rescue_id = -1

# the town cats: food for one (a bit of fish from one's pocket, or from the hold of one's own
# aircraft moored near), the cat in reach, and what the card says by it ("" while anything else
# near has its own card)
cat_food = () -> str:
    pl = living_world.people[living_world.player]
    fish = int(lt.GoodKind.fish)
    if pl.pocket.qty[fish] > 0: return "fish"
    if pl.craft >= 0 and pc.state.moored and length(pc.state.position - me.pos) < 30.0 and living_world.aircraft[pl.craft].cargo.qty[fish] > 0: return "fish"
    ""

cat_here = () -> int: if me.mode == .walking and holding_cargo() < 0 and not fish_in_hand(fish) and not cat_busy(cat_scene): nearest_cat(cat_scene, me.pos) else: -1

cat_prompt_here = () -> str:
    if paused or show_chart or ui != .none or notebook.open or me.mode != .walking: return ""
    if holding_cargo() >= 0: return ""
    k = cat_here()
    if k < 0: return ""
    cat_prompt(cat_scene, k, presentation.cat_bonds, living_world.minute, cat_food())
rescue_place = -1
rescue_name = ""

# A boat in trouble at sea (src/living_adrift.jo): the one the aircraft lies alongside (its index
# in World.adrift), the one whose skipper is aboard to be set ashore here, and what can be done.
adrift_k = -1
adrift_ashore_k = -1
adrift_tow_skipper = -1
adrift_ship = -1                     # (a passing ship far out on its way that could take the line)
adrift_help = AdriftHelp()           # the launch or the caique out to it, seen (src/adrift_help.jo)
_help_wind = () -> vec2: wind_now.dir * f32(wind_now.speed)

_first_name = (p: int) -> str: split(living_world.people[p].name, " ")[0]

update_adrift = ():
    global adrift_k, adrift_ashore_k, adrift_tow_skipper, adrift_ship
    adrift_k = -1; adrift_ashore_k = -1; adrift_tow_skipper = -1; adrift_ship = -1
    if paused or show_chart or notebook.open: return
    st = pc.state
    loop i in 0..living_world.adrift.len():
        a = living_world.adrift[i]
        if a.state == .home: continue
        if me.mode == .aboard:
            d = f64(length(vec2(a.at.x - st.position.x, a.at.z - st.position.z)))
            # (seen: come within sight of it, low enough to make it out; no marker, no word)
            if not a.found and d < 700.0 and f64(st.position.y) < 600.0: adrift_found(living_world, i)
            if a.state == .adrift and (st.on_water or st.moored) and d < 45.0 and f64(length(st.velocity)) < 3.0:
                adrift_k = i
                adrift_tow_skipper = adrift_tow_boat(living_world, i, 4500.0)
                # (or a ship passing on its way, as the radio's help would find: src/radio_help.jo)
                if adrift_help.stage == .none and sos.stage == .none and frame_number() % 15 == 0: adrift_ship = help_pick_ship(living_world, a.at, SHIP_REACH)
                else: adrift_ship = adrift_ship_seen
                adrift_ship_seen_set(adrift_ship)
        else if me.mode == .walking and a.state == .aboard and near_own_craft() and holding_cargo() < 0:
            here = living_world.people[living_world.player].place
            if here >= 0 and here < living_world.places.len(): adrift_ashore_k = i

# Alongside: take the crew aboard (he climbs up into the second seat), or get a line across to a
# boat out fishing near, which tows her in.
adrift_take = ():
    if adrift_k < 0: return
    a = living_world.adrift[adrift_k]
    if not adrift_take_aboard(living_world, adrift_k): return
    global rider_fig
    rider_takes(a.person, a.at + vec3(0, -1.0, 0))
    p = living_world.people[a.person]
    rider_fig = build_figure(dress_of(p.occupation), p.appearance_seed, age = p.age, woman = person_woman(p.name))
    off = living.place_name(living_world, adrift_near(living_world, a))
    log_note(notebook, "Took {_first_name(a.person)} aboard from the boat off {off}.", clock_text(living_world, living_world.minute))
    pilot_did(living_world.pilot_day, Doing(.rescued, living_world.minute, who = _first_name(a.person), where = off))
    said = match a.cause:
        .engine: "Thank God. The engine died on me out here."
        .mast: "Thank God. The mast went, and I've been drifting since."
        .lost: "I'd lost all idea of where I was. Thank you."
    say_toast("{_first_name(a.person)}: {said}")

adrift_ship_seen = -1

# An open job's crates in reach on foot (their lot, or -1).
lead_crate_here = () -> int:
    here = living_world.people[living_world.player].place
    if me.mode != .walking or here < 0 or here >= living_world.places.len(): return -1
    lead_crate_near(living_world, me.pos, here)

# Reading the label: whose crates, and where bound; someone near says where the owner is.
crate_label_read = ():
    lot = lead_crate_here()
    if lot < 0: return
    owner = living_world.jobs[living_world.cargo[lot].job].poster
    k = -1; bd = 12.0
    loop i in 0..folks.len():
        if not folks[i].shown or folks[i].person == owner or folks[i].person == living_world.player: continue
        d = f64(length(folks[i].pos - me.pos))
        if d < bd: bd = d; k = i
    say_toast(lead_crate_label(living_world, lot))
    if k >= 0:
        folks[k].line = lead_crate_said(living_world, lot); folks[k].line_t = t

# The tow line: from the helping boat's stern to the towed boat's bow, sagging a little.
draw_adrift_line = ():
    if adrift_help.stage != .towing: return
    k = vessel_index(vessels, adrift_help.vessel)
    i = adrift_index(living_world, adrift_help.trip)
    if k < 0 or i < 0: return
    a = living_world.adrift[i]
    if a.yaw < -10.0: return
    stern = tow_stern(vessels.ships[k])
    bow = a.at + vec3(f32(sin(a.yaw)), 0, f32(cos(a.yaw))) * f32(vessel_spec(.sail_caique).length * 0.5) + vec3(0, 1.0, 0)
    mid = (stern + bow) * 0.5 - vec3(0, 0.7, 0)
    rope_colour = rgba(0.62, 0.52, 0.36, 1)
    draw_line3d(stern, mid, rope_colour, 0.05)
    draw_line3d(mid, bow, rope_colour, 0.05)
adrift_ship_seen_set = (k: int):
    global adrift_ship_seen
    adrift_ship_seen = k

adrift_line = ():
    if adrift_k < 0: return
    a = living_world.adrift[adrift_k]
    # (a passing ship turned aside, seen coming and towing her in: src/adrift_help.jo)
    if adrift_ship >= 0 and adrift_help.stage == .none:
        minutes = adrift_help_start(adrift_help, vessels, living_world, adrift_k, adrift_ship, _help_wind())
        if minutes > 0 and adrift_tow_ship(living_world, adrift_k, adrift_ship, minutes) > 0:
            log_note(notebook, "Signalled {adrift_help.name} to take {_first_name(a.person)}'s boat in tow.", clock_text(living_world, living_world.minute))
            say_toast("{capital(adrift_help.name)} is turning toward you. {capital(help_eta_words(minutes))} to {help_harbour_name(adrift_help.harbour)}.")
            return
        if minutes > 0: adrift_help_drop(adrift_help, vessels, living_world)
    if adrift_tow_skipper < 0: return
    helper = adrift_tow_skipper
    # (the fishing boat comes over, seen, and tows her in: src/adrift_help.jo)
    given = if adrift_help.stage == .none: adrift_help_start(adrift_help, vessels, living_world, adrift_k, -1, _help_wind(), caique = helper) else: -1
    minutes = adrift_tow(living_world, adrift_k, helper, given)
    if minutes < 0:
        if given > 0: adrift_help_drop(adrift_help, vessels, living_world)
        return
    log_note(notebook, "Got a line across from {_first_name(a.person)}'s boat to {_first_name(helper)}'s, to be towed in.", clock_text(living_world, living_world.minute))
    say_toast("{_first_name(helper)}: I have her. We'll be in before long.")

# At a harbour, the skipper aboard climbs out onto the dock and goes home; the worry's over.
adrift_ashore = ():
    if adrift_ashore_k < 0: return
    a = living_world.adrift[adrift_ashore_k]
    here = living_world.people[living_world.player].place
    if not adrift_set_ashore(living_world, adrift_ashore_k, here): return
    if rider.person == a.person and (rider.stage == .aboard or rider.stage == .boarding):
        seat = pc.state.position + quat_rotate(pc.state.orientation, rider_seat(ride_seat(player_model()), rider.on_wing, pc.spec.span))
        inland = me.pos - pc.state.position
        side = normalize(vec3(-inland.z, 0, inland.x) + vec3(0.0001, 0, 0))
        rider_alight(rider, seat, me.pos + side * 1.2, inland, t)
    name = _first_name(a.person)
    log_note(notebook, "Set {name} ashore at {living.place_name(living_world, here)}.", clock_text(living_world, living_world.minute))
    say_toast("{name}: {if here == a.home: "Home. I'll not forget this." else: "I'll find my way home from here. Thank you."}")
rescue_hold = false                 # (setting ashore a foe in one's own country's harbour: the guard may hold them)

rescue_prompt = () -> str:
    if rescue_act == 1: "F  take {rescue_name} aboard"
    else if rescue_act == 2 and rescue_hold: "F  hand {rescue_name} over to the harbour guard"
    else if rescue_act == 2: "F  help {rescue_name} ashore"
    else: ""

# Which rescue F does here: pick up beside survivors on the water, or land them beside one's
# moored aircraft at a harbour.
update_rescue = ():
    global rescue_act, rescue_id, rescue_place, rescue_name, rescue_hold
    rescue_act = 0
    rescue_id = -1
    rescue_hold = false
    if paused or show_chart or ui != .none or notebook.open: return
    at = if me.mode == .aboard: pc.state.position else: me.pos
    if frame_number() % 20 == 0:
        loop line in rescue_scan(rescue, living_world, at):
            say_toast(line)
            log_note(notebook, line, clock_text(living_world, living_world.minute))
    if me.mode == .aboard:
        k = rescue_pickup_from(rescue, pc.state)
        if k >= 0:
            rescue_act = 1
            rescue_id = k
            loop s in rescue.views:
                if s.id == k: rescue_name = survivor_name(living_world, s)
    else if me.mode == .walking and near_own_craft() and holding_cargo() < 0:
        aboard = rescue_aboard(living_world)
        if aboard.len() > 0:
            place = rescue_harbour(living_world)
            if place >= 0:
                rescue_act = 2
                rescue_id = aboard[0]
                rescue_place = place
                rescue_name = rescue_aboard_name(living_world, aboard[0])
                rescue_hold = living_world.war.survivors[aboard[0]].person >= 0 and rescue_can_hold(living_world, living_world.war.survivors[aboard[0]].country, place)

# The R/T (src/rt_pad.jo): how many of the player's flight would hear it; opened by Y (the R/T
# plate's tap, the controller's R/T button), then a number, Y again to step, F to send.
rt_flight = () -> int:
    me_i = combat_index(battle, living_world.people[living_world.player].craft)
    if me_i < 0 or not battle.enabled: return 0
    n = 0
    loop a in battle.actors:
        if a.side == battle.actors[me_i].side and not a.human and a.status == .flying and a.present: n += 1
    n

# The words on the R/T just now: down on the sea in trouble, the call for help first (a flare when
# no one is in the R/T's reach); help coming by boat, waiting for it; then the flight's words.
rt_lines = () -> int[]:
    out: int[]
    if sos.stage != .none:
        if sos.stage == .coming or sos.stage == .towing: out.push(RT_WAIT)
    else if help_need_now() != .none: out.push(if help_in_reach(): RT_HELP else: RT_FLARE)
    if rt_flight() > 0:
        loop k in 0..5: out.push(k)
    # (the Ierax within the R/T's reach, in the war: what is going)
    if active_scenario == "" and (patrol_at_war(living_world) or patrol_capture != "") and f64(length(vec3(pc.state.position.x - TENDER_AT.x, 0, pc.state.position.z - TENDER_AT.z))) < RADIO_REACH: out.push(RT_IERAX)
    out

rt_tick = ():
    global rt
    if not rt.open:
        if vpressed(.y):
            lines = rt_lines()
            if lines.len() == 0: say_toast("No one on the R/T.")
            else:
                rt_open(rt, t, lines)
                rt.took_mouse = is_mouse_locked()
                if rt.took_mouse: mouse_lock(false)
        return
    number = if vpressed(.n1): 1 else: if vpressed(.n2): 2 else: if vpressed(.n3): 3 else: if vpressed(.n4): 4 else: if vpressed(.n5): 5 else: 0
    esc = vpressed(.escape)
    if esc: take_escape()
    chosen = rt_keys(rt, vpressed(.y), vpressed(.f) or vpressed(.enter), number, esc, t)
    if chosen >= 0: rt_send(chosen)
    if not rt.open and rt.took_mouse and not pad.on: mouse_lock(true); rt.took_mouse = false

# Sends the chosen word: the battle's order, a wingman's answer on the radio; or the call for help.
rt_send = (k: int):
    if k == RT_HELP or k == RT_FLARE:
        help_call(k == RT_FLARE)
        if rt.took_mouse and not pad.on: mouse_lock(true); rt.took_mouse = false
        return
    if k == RT_WAIT:
        help_wait()
        return
    if k == RT_IERAX:
        help_say("Ierax", patrol_answer())
        if rt.took_mouse and not pad.on: mouse_lock(true); rt.took_mouse = false
        return
    me_craft = living_world.people[living_world.player].craft
    me_i = combat_index(battle, me_craft)
    kind = RT_KINDS[k]
    target = -1
    if kind == .attack and view_target.selected >= 0 and view_target.items[view_target.selected].kind == 0:
        c = combat_index(battle, view_target.items[view_target.selected].id)
        # (one gone into the cloud deck is out of the flight's sight)
        if c >= 0 and me_i >= 0 and battle.actors[c].side != battle.actors[me_i].side and not in_deck(battle, battle.actors[c].state.position): target = battle.actors[c].craft
    heard = if kind == .attack and target < 0: rt_flight() else: give_order(battle, me_craft, kind, target)
    if heard == 0:
        say_toast("No answer on the R/T.")
        return
    # (the nearest of the flight answers, by their number in it)
    side = battle.actors[me_i].side
    best = -1; near = 1e18; number = 0; count = 0
    loop a in battle.actors:
        if a.side != side: continue
        count += 1
        if a.human or a.status != .flying or not a.present: continue
        d = f64(length(a.state.position - pc.state.position))
        if d < near: near = d; best = a.craft; number = count
    words = rt_answer(kind, target >= 0)
    if rt.took_mouse and not pad.on: mouse_lock(true); rt.took_mouse = false
    # (the one answering in sight of the player answers by hand or lamp: src/flight_signals.jo)
    if active_scenario == "strait": radio_say(homeward, "rt{battle.tick}", call_sign(living_world, side, max(1, number)), words, best)
    else: say_toast(words)

# ---- the Ierax's dawn patrol (src/sortie.jo) ----
patrol = Sortie()
# AEGEAN_CAPTURE_PATROL=launch|contact|home (captures): at war; launch: the patrol out from the
# Ierax now, whatever the hour, the player up over her to go along; contact: both patrols already
# out, nearing each other over the strait, the player in the Ierax's formation; home: the beat
# flown, the flight five kilometres out from her and turning in. PATROL lines say how it goes.
patrol_capture = env("AEGEAN_CAPTURE_PATROL") ?? ""

patrol_actor = (craft: int) -> int: combat_index(battle, craft)

patrol_active = () -> bool: patrol.stage == .launching or patrol.stage == .out or patrol.stage == .fighting or patrol.stage == .home

# The flight's base and Orenthia's, in the free-play battle (the Ierax for the player's side).
patrol_homes = ():
    has0 = false; has2 = false
    loop h in battle.homes:
        if h.side == IERAX_SIDE: has0 = true
        if h.side == ORENTHIA_SIDE: has2 = true
    if not has0: battle.homes.push(tender_home(IERAX_SIDE))
    if not has2:
        loop h in strait_homes(living_world):
            if h.side == ORENTHIA_SIDE: battle.homes.push(h)

patrol_foe_home = () -> BattleHome?:
    loop h in battle.homes:
        if h.side == ORENTHIA_SIDE: return h
    none

# The Ierax's three on her booms, Orenthia's three at their harbour on the strait: registered once,
# put in the free-play battle (side 0 and 2, the sortie's engagement), moored.
patrol_spawn = () -> bool:
    global patrol
    patrol_homes()
    flight = patrol_register(living_world, 1, "ierax-patrol", PATROL_SIZE, TENDER_AT)
    foes = patrol_register(living_world, 2, "orenthia-patrol", PATROL_SIZE, none)
    if flight.len() == 0: return false
    deck_h = atan2(f64(tender_forward().x), -f64(tender_forward().z))
    loop k in 0..flight.len():
        if patrol_actor(flight[k]) < 0: battle.actors.push(patrol_combatant(living_world, flight[k], IERAX_SIDE, k, flight[0], tender_slot(k), deck_h, IERAX_MODEL, craft_models))
    if let fh = patrol_foe_home():
        loop k in 0..foes.len():
            if patrol_actor(foes[k]) < 0: battle.actors.push(patrol_combatant(living_world, foes[k], ORENTHIA_SIDE, k, foes[0], fh.dock + fh.step * f32(k), fh.heading, ORENTHIA_MODEL, craft_models))
    patrol.flight = flight; patrol.foes = foes
    homeward_call_names[IERAX_SIDE] = "Ierax"
    print("PATROL spawned: the Ierax's {flight.len()}, Orenthia's {foes.len()}")
    true

patrol_say = (key: str, words: str):
    if me.mode == .aboard: radio_say(homeward, "patrol-{patrol.day}-{key}", call_sign(living_world, IERAX_SIDE, 1), words)

# Flying, there, in the fight: an actor of the sortie still in it.
patrol_up = (i: int) -> bool: i >= 0 and battle.actors[i].status == .flying and battle.actors[i].present and not battle.actors[i].state.on_water

# Each frame (free play): spawned near the Ierax at war; out at dawn; the beats flown; contact,
# the fight, home.
patrol_step = (dt: f64):
    global patrol, homeward
    if active_scenario != "" or world_held(): return
    war = patrol_at_war(living_world) or patrol_capture != ""
    near = f64(length(vec3(pc.state.position.x - TENDER_AT.x, 0, pc.state.position.z - TENDER_AT.z))) < 15000.0
    if patrol.stage == .none:
        if war and near and patrol_spawn(): patrol.stage = .ready
        return
    commit_scenario_aircraft(living_world, battle, SORTIE_ENGAGEMENT)
    # (the patrol's own leader sends it home: seen off, beaten or its beat flown)
    battle.managed[IERAX_SIDE] = true; battle.managed[ORENTHIA_SIDE] = true
    day = lt.day_index(living_world.minute)
    # (the player flies with them while it is out: the enemy's to fight as theirs)
    pci = combat_index(battle, living_world.people[living_world.player].craft)
    if pci >= 0: battle.actors[pci].engagement = if patrol_active(): SORTIE_ENGAGEMENT else: -1
    homeward.sortie = true
    # (a soft ceiling under the thrust's fade while it is out, as over the strait; none else)
    battle.ceiling = if patrol_active(): PATROL_CEILING else: 1e9
    if patrol.stage == .ready or patrol.stage == .done:
        forced = patrol_capture == "launch" and patrol.day < 0
        if forced or patrol_due(war, lt.local_minute(living_world.minute), day, patrol.day):
            patrol.stage = .launching; patrol.launched = t; patrol.day = day
            patrol.leg = 0; patrol.foe_leg = 0; patrol.contact = false; patrol.quiet = 0.0; patrol.foe_home = false
            battle.home_since[IERAX_SIDE] = -1; battle.formed[IERAX_SIDE] = -1
            battle.home_since[ORENTHIA_SIDE] = -1; battle.formed[ORENTHIA_SIDE] = -1
            # (the radio from the last time they came home, or from lying moored, not said over again
            # as they go out: what is said on the way home is said fresh)
            homeward = HomewardView(); homeward.sortie = true
            print("PATROL out: day {day}")
        return
    if patrol.stage == .launching:
        wind = wind_now_vec()
        launch_ground = flight_env(t, TENDER_AT).ground
        up = 0
        loop k in 0..patrol.flight.len():
            i = patrol_actor(patrol.flight[k])
            if i < 0: continue
            if battle.actors[i].pilot.home_done and t - patrol.launched >= f64(k) * PATROL_LAUNCH_GAP:
                a = battle.actors[i]; way = atan2(f64(IERAX_BEAT[0].x - a.state.position.x), -f64(IERAX_BEAT[0].z - a.state.position.z)); patrol_launch(a, patrol_takeoff_heading(a.state.position, wind, way, launch_ground), way); battle.actors[i] = a
            if not battle.actors[i].pilot.launching and not battle.actors[i].pilot.home_done: up += 1
        loop k in 0..patrol.foes.len():
            i = patrol_actor(patrol.foes[k])
            if i >= 0 and battle.actors[i].pilot.home_done and t - patrol.launched >= f64(k) * PATROL_LAUNCH_GAP:
                a = battle.actors[i]; way = atan2(f64(ORENTHIA_BEAT[0].x - a.state.position.x), -f64(ORENTHIA_BEAT[0].z - a.state.position.z)); take = patrol_takeoff_heading(a.state.position, wind, way, launch_ground); patrol_launch(a, take, way); battle.actors[i] = a
                if patrol_capture != "": print("PATROL launch: craft {a.craft} side {a.side} from {a.state.position.x:.0},{a.state.position.z:.0} taking off on {take:.2} (the wind's {atan2(-f64(wind.x), f64(wind.z)):.2}), ground there {launch_ground(f64(a.state.position.x), f64(a.state.position.z)):.1}")
        if up >= patrol.flight.len():
            patrol.stage = .out
            patrol_say("out", "The dawn patrol: up the coast, and down the strait. Form on me.")
        return
    # (the leaders on their beats: the formations' heading eased onto the next leg)
    if patrol.stage == .out:
        patrol.leg = patrol_beat(patrol.flight, IERAX_BEAT, patrol.leg, dt)
        if patrol.leg >= IERAX_BEAT.len():
            patrol_say("beat", "That's the beat. Home to the Ierax.")
            send_home(battle, IERAX_SIDE, false, false); patrol.stage = .home
    if not patrol.foe_home and not patrol.contact:
        patrol.foe_leg = patrol_beat(patrol.foes, ORENTHIA_BEAT, patrol.foe_leg, dt)
        if patrol.foe_leg >= ORENTHIA_BEAT.len(): patrol_foe_go(false)
    # (seen: both break and go for each other)
    if not patrol.contact and patrol.stage == .out:
        near_d = 1e18; seen_at = vec3(0, 0, 0); from = vec3(0, 0, 0)
        loop c in patrol.flight:
            i = patrol_actor(c)
            if not patrol_up(i) or battle.actors[i].pilot.launching: continue
            loop f in patrol.foes:
                j = patrol_actor(f)
                if not patrol_up(j) or battle.actors[j].pilot.launching: continue
                d = f64(length(battle.actors[j].state.position - battle.actors[i].state.position))
                if d < near_d: near_d = d; seen_at = battle.actors[j].state.position; from = battle.actors[i].state.position
        if near_d < PATROL_SIGHT:
            patrol.contact = true; patrol.stage = .fighting
            loop c in patrol.flight + patrol.foes:
                i = patrol_actor(c)
                if i >= 0: battle.actors[i].pilot.formation = false
            patrol_say("contact", "Machines to the {compass_word(seen_at - from)}! Orenthians. Go for them!")
            print("PATROL contact at {seen_at.x:.0},{seen_at.z:.0}, {near_d:.0} m")
    if patrol.stage == .fighting:
        # (the Orenthians seen off: none of them still fighting within eight kilometres for half a minute)
        touch = false; lost = 0; foes_lost = 0
        loop c in patrol.flight:
            i = patrol_actor(c)
            if i < 0 or battle.actors[i].status != .flying: lost += 1
        loop f in patrol.foes:
            j = patrol_actor(f)
            if j < 0 or battle.actors[j].status != .flying: foes_lost += 1; continue
            if battle.actors[j].pilot.mode == .homeward or battle.actors[j].pilot.mode == .withdrawing: continue
            loop c in patrol.flight:
                i = patrol_actor(c)
                if patrol_up(i) and f64(length(battle.actors[j].state.position - battle.actors[i].state.position)) < 8000.0: touch = true
        patrol.quiet = if touch: 0.0 else: patrol.quiet + dt
        if not patrol.foe_home and foes_lost * 2 >= max(1, patrol.foes.len()): patrol_foe_go(true)
        if lost * 3 >= patrol.flight.len() * 2:
            patrol_say("beaten", "Break off! Home to the Ierax, low and together.")
            send_home(battle, IERAX_SIDE, true, false); patrol.stage = .home
            patrol_foe_go(false)
        else if patrol.quiet > 30.0:
            patrol_say("seen-off", "That's them off. Rally on me, then home to the Ierax.")
            send_home(battle, IERAX_SIDE, false, false); patrol.stage = .home
            patrol_foe_go(false)
    if patrol.stage == .home:
        flying = 0; moored = 0
        loop c in patrol.flight:
            i = patrol_actor(c)
            if i >= 0 and battle.actors[i].status == .flying:
                flying += 1
                if battle.actors[i].pilot.home_done: moored += 1
        if moored >= flying:
            patrol.stage = .done
            print("PATROL done: {moored} moored at the Ierax")

# (captures) at war; the player up in the air; the patrols where the stage wants them.
patrol_capture_stage = ():
    global pc, patrol
    f = frame_number()
    if f == 20:
        found = false
        loop k in 0..living_world.diplomacy.len():
            r = living_world.diplomacy[k]
            if (r.a == 1 and r.b == 2) or (r.a == 2 and r.b == 1):
                living_world.diplomacy[k].stage = .war; found = true
        if not found: living_world.diplomacy.push(social.DiplomaticRelation(1, 2, tension = 1000, stage = .war, last_incident_minute = 0))
        # (the player up over the Ierax, turning about her)
        at = TENDER_AT + tender_port() * 1500.0 + vec3(0, 400, 0)
        h = atan2(f64(tender_forward().x), -f64(tender_forward().z))
        pc.state = CraftState(position = at, orientation = quat_euler(0, -h, 0), velocity = heading_vector(h) * f32(pc.spec.cruise_speed * 0.8), fuel = pc.spec.fuel_capacity, water_age = 1.0)
        pc.state.precise_ready = false; pc.throttle = 0.7; pc.state.throttle = 0.7; pc.placed = false
        me.mode = .aboard
        debug_fuel_ml(living_world.people[living_world.player].craft, int(pc.spec.fuel_capacity * 1000.0))
        print("PATROL capture {patrol_capture}: at war, the player up over the Ierax")
    if f == 30 and patrol.stage == .ready and (patrol_capture == "contact" or patrol_capture == "home"):
        # (the flight already out: in formation where the stage wants it, its pilots launched)
        day = lt.day_index(living_world.minute)
        patrol.day = day; patrol.stage = .out; patrol.launched = t
        lead_at = if patrol_capture == "contact": vec3(136000, 450, -84000) else: TENDER_AT + tender_port() * 2000.0 + tender_forward() * 5000.0 + vec3(0, 450, 0)
        h = if patrol_capture == "contact": PI * 0.97 else: atan2(f64(TENDER_AT.x - lead_at.x), -f64(TENDER_AT.z - lead_at.z))
        patrol.leg = if patrol_capture == "contact": IERAX_BEAT.len() - 1 else: IERAX_BEAT.len()
        patrol_place(patrol.flight, lead_at, h)
        if patrol_capture == "contact":
            foe_at = vec3(138500, 450, -74000)
            patrol_place(patrol.foes, foe_at, 0.0); patrol.foe_leg = 1
        pc.state.position = lead_at + quat_rotate(quat_euler(0, -h, 0), patrol_offset(3)); pc.state.orientation = quat_euler(0, -h, 0)
        pc.state.velocity = heading_vector(h) * f32(pc.spec.cruise_speed * 0.86); pc.state.precise_ready = false
    if f % 300 == 0 and patrol.stage != .none:
        lead = if patrol.flight.len() > 0: patrol_actor(patrol.flight[0]) else: -1
        where = if lead >= 0: battle.actors[lead].state.position else: vec3(0, 0, 0)
        up = 0; moored = 0; down = 0
        loop c in patrol.flight + patrol.foes:
            i = patrol_actor(c)
            if i < 0: continue
            if battle.actors[i].status != .flying:
                down += 1
                a = battle.actors[i]
                print("PATROL down: craft {c} side {a.side} status {a.status} crashed {a.state.crashed} capsized {a.state.capsized} at {a.state.position.x:.0},{a.state.position.y:.1},{a.state.position.z:.0} mode {a.pilot.mode} phase {a.pilot.plan.phase} launching {a.pilot.launching} hull {a.state.hull_damage:.2} attacker {a.last_attacker}")
            else if battle.actors[i].pilot.home_done: moored += 1
            else: up += 1
        print("PATROL frame {f}: {patrol.stage}, leg {patrol.leg}, foe leg {patrol.foe_leg}, contact {patrol.contact}, leader at {where.x:.0},{where.y:.0},{where.z:.0}; up {up}, moored {moored}, down {down}; home since {battle.home_since[IERAX_SIDE]}/{battle.home_since[ORENTHIA_SIDE]}; player at {pc.state.position.x:.0},{pc.state.position.y:.0},{pc.state.position.z:.0}")

# (captures) a patrol put in the air in formation at `at` on heading h, launched.
patrol_place = (crafts: int[], at: vec3, h: f64):
    loop k in 0..crafts.len():
        i = patrol_actor(crafts[k])
        if i < 0: continue
        a = battle.actors[i]
        if a.state.moored: unmoor(a.state)
        a.state.position = at + quat_rotate(quat_euler(0, -h, 0), patrol_offset(k)); a.state.orientation = quat_euler(0, -h, 0)
        a.state.velocity = heading_vector(h) * f32(a.spec.cruise_speed * 0.86); a.state.on_water = false; a.state.precise_ready = false
        a.previous = a.state.position; a.previous_point = craft_point(a.state); a.previous_rotation = a.state.orientation
        a.pilot.home_done = false; a.pilot.launching = false; a.pilot.formation = true; a.pilot.formation_heading = h
        a.pilot.mode = .regroup; a.pilot.plan = FlightPlan(); a.rally = vec3(at.x, f32(PATROL_ALTITUDE), at.z)
        battle.actors[i] = a

# (captures) the player flown with the patrol: round the Ierax till it is up, then in fourth place
# on the leader; home with them, last in.
patrol_capture_controls = (e: FlightEnv) -> Controls:
    lead = if patrol.flight.len() > 0: patrol_actor(patrol.flight[0]) else: -1
    if lead < 0 or patrol.stage == .launching or patrol.stage == .ready or patrol.stage == .none:
        out = pc.state.position - TENDER_AT; out.y = 0
        if length(out) < 1: out = vec3(1, 0, 0)
        around = f64(atan2(f64(out.z), f64(out.x))) + 0.35
        return air_waypoint_controls(pc.spec, pc.state, e, TENDER_AT + vec3(f32(cos(around) * 1500.0), 0, f32(sin(around) * 1500.0)), 450.0, pc.spec.cruise_speed * 0.7)
    if patrol.stage == .fighting:
        # (the fight: watched from off it and above, turning about its middle)
        mid = vec3(0, 0, 0); n = 0
        loop c in patrol.flight + patrol.foes:
            i = patrol_actor(c)
            if patrol_up(i): mid += battle.actors[i].state.position; n += 1
        if n > 0:
            mid = mid / f32(n)
            out = pc.state.position - mid; out.y = 0
            if length(out) < 1: out = vec3(1, 0, 0)
            around = f64(atan2(f64(out.z), f64(out.x))) + 0.3
            return air_waypoint_controls(pc.spec, pc.state, e, mid + vec3(f32(cos(around) * 900.0), 0, f32(sin(around) * 900.0)), max(600.0, f64(mid.y) + 150.0), pc.spec.cruise_speed * 0.75)
    l = battle.actors[lead]
    if l.pilot.home_done or patrol.stage == .done or (l.pilot.mode == .homeward and l.pilot.descend_tick >= 0):
        return air_waypoint_controls(pc.spec, pc.state, e, TENDER_AT + tender_port() * 1500.0, 400.0, pc.spec.cruise_speed * 0.7)
    h = heading(l.state)
    slot = l.state.position + quat_rotate(quat_euler(0, -h, 0), patrol_offset(3))
    direction = heading_vector(h); lv = max(f64(length(l.state.velocity)), pc.spec.stall_speed * pure_k(pc.spec) * 1.4)
    pace = clamp(lv + f64(dot(slot - pc.state.position, direction)) * 0.12, lv * 0.75, lv * 1.3)
    air_waypoint_controls(pc.spec, pc.state, e, slot + direction * 1000.0, f64(slot.y), pace)

# What the Ierax says of her patrol, asked on the R/T or of her duty officer.
patrol_answer = () -> str:
    if not patrol_at_war(living_world) and patrol_capture == "": return "Nothing doing. The peace holds, for now."
    today = patrol.day == lt.day_index(living_world.minute)
    match patrol.stage:
        .launching: "They're taking off now. Keep with Ierax 1 if you're coming."
        .out:
            lead = if patrol.flight.len() > 0: patrol_actor(patrol.flight[0]) else: -1
            if lead >= 0:
                d = battle.actors[lead].state.position - TENDER_AT
                "The patrol's up, {int(f64(length(vec3(d.x, 0, d.z))) / 1000.0)} kilometres {compass_word(d)} of us. Join Ierax 1 if you're coming."
            else: "The patrol's up. Join Ierax 1 if you're coming."
        .fighting: "They're in a fight, over the strait."
        .home: "They're on their way in."
        _: if today: "The patrol's in. Six tomorrow, if you're coming." else: "Dawn patrol at six: three machines, up the coast and down the strait. Come along if you like; keep with Ierax 1."

# Orenthia's patrol turns for its harbour (beaten: its losses).
patrol_foe_go = (beaten: bool):
    global patrol
    if patrol.foe_home: return
    patrol.foe_home = true
    send_home(battle, ORENTHIA_SIDE, beaten, false)

# A formation on its beat: its pilots' heading eased toward the leg's end; the leg done within
# 1500 m of it. Returns the leg now.
patrol_beat = (crafts: int[], beat: vec3[], leg: int, dt: f64) -> int:
    if crafts.len() == 0 or leg >= beat.len(): return leg
    lead = patrol_actor(crafts[0])
    # (the leader down or gone: the next of them leads)
    loop c in crafts:
        if lead < 0 or not patrol_up(lead): lead = patrol_actor(c)
    if not patrol_up(lead): return leg
    l = battle.actors[lead]
    if l.pilot.launching or not l.pilot.formation: return leg
    at = l.state.position
    if f64(length(vec3(beat[leg].x - at.x, 0, beat[leg].z - at.z))) < 1500.0: return leg + 1
    h = patrol_steer(l.pilot.formation_heading, at, beat[leg], dt)
    loop c in crafts:
        i = patrol_actor(c)
        if i >= 0 and battle.actors[i].pilot.formation:
            battle.actors[i].pilot.formation_heading = h
            if c != battle.actors[lead].craft: battle.actors[i].pilot.leader = battle.actors[lead].craft
    leg

# ---- the Ierax, the Kalyran seaplane tender (src/tender.jo) ----
tender_hoist = 0                     # 0 afloat, 1 being hoisted in, 2 on her deck, 3 being lowered out
tender_hoist_t = 0.0
tender_from = vec3(0, 0, 0)          # where alongside the hoist began (or ends)
tender_heading = 0.0

# Her bunkers: the fuel is Kalyra's, drawn from Ardevanti, its pier's own stock and price.
tender_fuel = ():
    global ui, fuel_panel_pier, fuel_offered_at, fuel_notice
    town = rep_town_named(living_world, "Ardevanti")
    if town < 0 or not (town in living_world.place_contexts):
        say_toast("Her bunkers are empty.")
        return
    p = refuel.fuel_pier_at(living_world, living_world.place_contexts[town].center, 4000.0)
    if p == none:
        say_toast("Her bunkers are empty.")
        return
    pier = p!
    pier.dock = pc.state.position; pier.name = "Bunkers of {TENDER_NAME}"
    fuel_panel_pier = pier
    fuel_offered_at = pc.state.position
    fuel_notice = ""
    ui = .fuel
    mouse_lock(false)

# The derrick: in over the side onto her after deck, or out again onto the water alongside.
tender_hoist_start = (down: bool):
    global tender_hoist, tender_hoist_t, tender_from, tender_heading, vessel_mooring
    if tender_holds_plane(): return
    if down:
        if tender_hoist != 2: return
        # (out over the side by the booms, the first free mooring's water if one is near, else alongside)
        tender_hoist = 3
    else:
        if tender_hoist != 0 or not pc.state.moored: return
        tender_from = vec3(pc.state.position.x, 0, pc.state.position.z)
        tender_heading = atan2(f64(tender_forward().x), -f64(tender_forward().z))
        tender_hoist = 1
    tender_hoist_t = 0.0
    vessel_mooring = VesselMooring(); rope.tied = false
    pc.throttle = 0.0
    say_toast(if down: "The hook's on. Over the side she goes." else: "The hook's on. Up she comes.")

# How far she is from sound (in thousandths, hull and engine), and what her mechanics ask: nothing
# of a Kalyran pilot, the navy's own; of anyone else, the work at a workshop's rate.
tender_wear = () -> int:
    c = living_world.people[living_world.player].craft
    if c < 0: return 0
    max(0, 800 - living_world.aircraft[c].hull) + max(0, 800 - living_world.aircraft[c].engine)
tender_repair_cost = () -> int: if living_world.people[living_world.player].citizenship == 1: 0 else: tender_wear() * 3

# Her mechanics at work (an hour or so behind the dark card): the aircraft brought back to 80% in
# hull and engine, as a workshop does, paid for or owed.
tender_repair = ():
    cost = tender_repair_cost()
    if cost > 0:
        acct = if living_world.countries.len() > 1: living_world.countries[1].treasury_account else: -1
        paid = help_pay(living_world, acct, cost, "tender-repair", -1)
        say_toast(if paid: "Her mechanics at work, {phoenix_text(cost)}." else: "Her mechanics at work, {phoenix_text(cost)} owed.")
    leisure_skip(max(20, tender_wear() / 10), "her mechanics at work", after = 8)

tender_repaired = ():
    c = living_world.people[living_world.player].craft
    if c < 0: return
    hull = max(living_world.aircraft[c].hull, 800); engine = max(living_world.aircraft[c].engine, 800)
    living_world.aircraft[c].hull = hull; living_world.aircraft[c].engine = engine; living_world.aircraft[c].revision += 1
    # (the engine to its figure; every other part at least to the hull's, as a world repair does)
    engine_id = int(PartId.engine)
    loop i in 0..pc.state.damage.parts.len():
        if i == engine_id: pc.state.damage.parts[i].health = max(pc.state.damage.parts[i].health, f64(engine) / 1000.0)
        else: pc.state.damage.parts[i].health = max(pc.state.damage.parts[i].health, f64(hull) / 1000.0)
    refresh_damage(pc.spec, pc.state)
    say_toast("Seen to. She'll do.")

# Each frame: the hoist under way, or held on her deck (no throttle there).
tender_step = (dt: f64):
    global tender_hoist, tender_hoist_t, tender_heading
    if tender_hoist == 0: return
    if me.mode != .aboard:
        return
    pc.throttle = 0.0
    tender_hoist_t += dt
    deck = tender_deck_spot()
    # (swung round with the derrick to lie fore and aft on her deck)
    deck_h = atan2(f64(tender_forward().x), -f64(tender_forward().z))
    u = if tender_hoist == 3: hoist_seconds() - tender_hoist_t else: tender_hoist_t
    k = if tender_hoist == 2: 1.0 else: clamp((u - HOIST_HOOK - HOIST_LIFT) / HOIST_SWING, 0.0, 1.0)
    h = tender_heading + angle_delta(deck_h, tender_heading) * k
    at = deck
    if tender_hoist == 1 or tender_hoist == 3: at = hoist_point(tender_from, tender_under_derrick(), deck, tender_hoist_t, tender_hoist == 3)
    if not pc.state.moored: moor(pc.state, pc.state.position, h)
    pc.state.mooring_point = vec3(at.x, at.y + f32(pc.spec.float_height), at.z)
    pc.state.mooring_orientation = quat_euler(0, -h, 0)
    # (put there now, as a ship's mooring does: the moored aircraft's place is otherwise its record's)
    pc.state.position = pc.state.mooring_point; pc.state.orientation = pc.state.mooring_orientation
    pc.state.velocity = vec3(0, 0, 0); pc.state.precise_ready = false
    if (tender_hoist == 1 or tender_hoist == 3) and tender_hoist_t >= hoist_seconds():
        if tender_hoist == 1:
            tender_hoist = 2
            say_toast("Aboard {TENDER_NAME}, on her after deck.")
        else:
            tender_hoist = 0
            under = tender_under_derrick()
            moor(pc.state, vec3(under.x, f32(pc.spec.float_height), under.z), tender_heading)
            say_toast("Afloat alongside. Cast off when you're ready.")

# ---- the rescued let out onto her ----
enum TenderWay: none, direct, rowing, hoisted
enum TenderStage: none, warping, rowing_out, leaving_plane, rowing_back, onto_ladder, climbing, over_rail, down_to_deck, ladder_idle

struct TenderTransfer:
    stage: TenderStage = .none
    way: TenderWay = .none
    since = 0.0
    out: TenderBoatCourse
    back: TenderBoatCourse
    path: vec3[]                    # (cockpit, float, float's bow, in the aircraft frame)
    ladder: (vec3,vec3) = (vec3(0,0,0),vec3(0,0,0))
    deck = vec3(0,0,0)              # (hoisted in: where they step down, ship-local)
    berth_from = vec3(0,0,0)
    berth_to = vec3(0,0,0)
    heading_from = 0.0
    heading_to = 0.0

tender_xfer = TenderTransfer()
tender_way_on = false               # (rider.pos is ship-local while walking her deck)
tender_hand: Figure?
tender_rowers: Figure[]
tender_dinghy: Mesh?
tender_oar: Mesh?
const XFER_WARP = 5.0
const XFER_DOWN = 1.8
const XFER_STEP = 1.1
const XFER_WALK = 0.9
const XFER_CLIMB = 0.42
const XFER_OVER = 1.5
const XFER_AFT = 2.0

tender_depot = () -> int: rep_town_named(living_world, "Ardevanti")

tender_way_here = () -> TenderWay:
    if me.mode != .aboard or not pc.state.moored or tender_way_on: return .none
    if tender_xfer.stage != .none and tender_xfer.stage != .ladder_idle: return .none
    if tender_hoist == 2: return .hoisted
    if tender_hoist != 0 or pc.spec.landplane: return .none
    if vessel_mooring.vessel == TENDER_ID: return .direct
    if tender_boom_at(pc.state.position) >= 0: return .rowing
    l = tender_local_of(pc.state.position)
    s = vessel_spec(.seaplane_tender)
    if abs(f64(l.x)) < s.beam*0.5+pc.spec.span*0.55+5.0 and abs(f64(l.z)) < s.length*0.38: return .direct
    .none

# Who of the rescued aboard could be let out onto her here: a survivor (kind 1, their id) or a
# skipper taken off a boat adrift (kind 2, its index), and their name.
tender_rescued_here = () -> (int, int, str)?:
    if tender_way_here() == .none or tender_depot() < 0: return none
    aboard = rescue_aboard(living_world)
    if aboard.len() > 0: return (1, aboard[0], rescue_aboard_name(living_world, aboard[0]))
    loop i in 0..living_world.adrift.len():
        if living_world.adrift[i].state == .aboard: return (2, i, _first_name(living_world.adrift[i].person))
    none

tender_offer_words = (name: str) -> str:
    match tender_way_here():
        .hoisted: "help {name} down onto her deck"
        .direct: "take {name} alongside her ladder"
        _: "hail her pulling boat for {name}"

# Her people take them in, and see them to her depot or hold them below.
tender_let_out = ():
    global tender_xfer
    h = tender_rescued_here() ?? return
    way = tender_way_here()
    place = tender_depot()
    now = clock_text(living_world, living_world.minute)
    person = -1
    if h.0 == 1:
        s = living_world.war.survivors[h.1]
        held = countries_at_war(living_world, s.country, 1)
        country = if s.country >= 0 and s.country < living_world.countries.len(): living_world.countries[s.country].name else: "abroad"
        before = living.national_regard(living_world, s.country, living_world.player)
        n = living.land_survivors(living_world, h.1, place, living_world.player, afloat = true)
        if n <= 0:
            say_toast("They can't go aboard her now.")
            return
        after = living.national_regard(living_world, s.country, living_world.player)
        if s.person >= 0:
            words = rescue_words_aboard(living_world, h.2, s.country, 1, TENDER_NAME, harbour_name(living_world, place), held, s.person)
            rescue_card(rescue, words.title, words.lines + ["Standing with {country}: {before} to {after}"], t)
            rescue.card_until = t + 11.0
            rescue_deeds(living_world, s.person, s.country, place, held, [])
            log_note(notebook, "{words.title}. {join(words.lines, " ")} Standing with {country} {before} to {after}.", now)
            person = s.person
        else:
            rescue_card(rescue, "Aboard {TENDER_NAME}", [if n == 1: "{h.2}, rescued" else: "{n} survivors, rescued", "Standing with {country}: {before} to {after}"], t)
            log_note(notebook, "Put {h.2} aboard {TENDER_NAME}. Standing with {country} {before} to {after}.", now)
        pilot_did(living_world.pilot_day, Doing(.set_ashore, living_world.minute))
    else:
        person = living_world.adrift[h.1].person
        if not adrift_set_ashore(living_world, h.1, place): return
        log_note(notebook, "Put {h.2} aboard {TENDER_NAME}; her boat takes them in to {harbour_name(living_world, place)}.", now)
        say_toast("{h.2}: A warship's ladder. I'll have something to tell them at home. Thank you.")
    if person < 0 or rider.person != person or (rider.stage != .aboard and rider.stage != .boarding): return
    prof = aircraft_profile(pc.kind)
    seat = rider_seat(ride_seat(player_model()), rider.on_wing, pc.spec.span) - vec3(0, 1.55, 0)
    water = -pc.spec.float_height
    path = off_aircraft_path(seat, prof.boat, prof.float_x, prof.length, water)
    craft = craft_transform(pc)
    x = TenderTransfer(way = way, since = t, path = path)
    if way == .hoisted:
        at = tender_local_of(transform_point(craft, path[1]))
        out = transform_dir(craft, vec3(1,0,0))
        at += vec3(dot(out,tender_port()),0,dot(out,tender_forward()))*0.9
        # The after deck narrows rapidly toward the stern.
        s = vessel_spec(.seaplane_tender)
        if tender_local_deck(f64(at.x),f64(at.z)) == none:
            at.z += 2.4
            section = vessel_deck_section(f64(at.z),s.length,s.beam,s.deck,false)
            at.x = clamp(at.x,0.32-section.x,section.x-0.32)
        at.y = f32(tender_local_deck(f64(at.x),f64(at.z)) ?? s.deck)
        x.deck = at
        x.stage = .down_to_deck
    else if way == .direct:
        x.ladder = tender_direct_ladder(pc.state.position,prof.span)
        at, hd, float_path = tender_float_berth(x.ladder, prof, water, seat)
        x.path = float_path
        x.berth_from = pc.state.position
        x.berth_to = vec3(at.x, x.berth_from.y, at.z)
        x.heading_from = heading(pc.state)
        x.heading_to = hd
        x.stage = .warping
    else:
        fwd = forward(pc.state); fwd.y = 0; fwd = normalize(fwd + vec3(0, 0, 0.0001))
        bow = transform_point(craft, path[2]); bow.y = 0
        bspec = vessel_spec(.rowboat)
        lie = bow + fwd*f32(bspec.length*0.5+0.18)
        # The whole sweep stays ahead of the aircraft's wing at the boom.
        x.ladder = tender_ladder(lie+fwd*5.0)
        home = tender_boat_at_ladder(x.ladder, bspec.beam)
        fore = tender_forward()
        along = home+fore*f32(if dot(lie-home,fore)<0: -5.0 else: 5.0)
        clear = lie+fwd*9.5
        x.out = tender_boat_course(home,along,clear,lie)
        x.back = tender_boat_course(lie,clear,along,home)
        x.stage = .rowing_out
    rider.stage = .away
    tender_xfer = x

tender_has_boat = (x: TenderTransfer) -> bool: x.way == .rowing and x.stage != .none

tender_boat_pose = (x: TenderTransfer) -> (vec3, f64, f64):
    if x.stage == .rowing_out or x.stage == .leaving_plane:
        return tender_row_pose(x.out, if x.stage == .rowing_out: t-x.since else: 1e9, false)
    tender_row_pose(x.back, if x.stage == .rowing_back: t-x.since else: 1e9, true)

tender_boat_model = (x: TenderTransfer, origin: vec3) -> mat4:
    pose = tender_boat_pose(x)
    v = Vessel(kind=.rowboat,position=pose.0,yaw=pose.1,status=.underway,speed=pose.2)
    vessel_pose(v,t,wind_now_vec().xz,origin)

tender_holds_plane = () -> bool:
    x = tender_xfer
    x.stage == .warping or x.stage == .rowing_out or x.stage == .leaving_plane or x.stage == .down_to_deck or (x.way == .direct and (x.stage == .onto_ladder or (x.stage == .climbing and t-x.since < XFER_WARP)))

# The crew warp the aircraft in by its line, turning it while there's room for
# the wing. Once the passenger has the ladder, they ease the aircraft back out.
tender_place_aircraft = ():
    x = tender_xfer
    if x.way != .direct or not tender_holds_plane(): return
    u = if x.stage == .warping: (t-x.since)/XFER_WARP else: if x.stage == .climbing: 1.0-(t-x.since)/XFER_WARP else: 1.0
    pc.throttle = 0.0
    fore = tender_forward()
    across = x.berth_to-x.berth_from
    along = fore*dot(across,fore)
    pc.state.position = x.berth_from+along*f32(smoothstep(0.0,0.48,u))+(across-along)*f32(smoothstep(0.40,1.0,u))
    hd = x.heading_from+angle_delta(x.heading_to,x.heading_from)*smoothstep(0.0,0.50,u)
    pc.state.orientation = quat_euler(0,-hd,0)
    pc.state.velocity = vec3(0,0,0)
    pc.state.precise_ready = false

tender_ladder_time = (x: TenderTransfer) -> f64:
    f64(x.ladder.1.y-x.ladder.0.y-TENDER_RAIL+0.1)/XFER_CLIMB

tender_float_walk = (x: TenderTransfer) -> f64: f64(length(x.path[2]-x.path[1]))/XFER_WALK

tender_deck_walk = (x: TenderTransfer):
    global tender_way_on
    at = if x.stage == .over_rail: tender_local_of(tender_inboard(x.ladder,1.0)) else: x.deck
    rider.stage = .walking; rider.since = t; rider.pos = at
    rider.away = normalize(vec3(-at.x,0,0))
    rider.yaw = atan2(f64(rider.away.x),f64(rider.away.z))
    tender_way_on = true

tender_xfer_step = ():
    global tender_xfer
    x = tender_xfer
    if x.stage == .none: return
    if x.stage == .ladder_idle:
        at = if tender_has_boat(x): tender_boat_pose(x).0 else: x.ladder.1
        if not tender_way_on and (hud_point(at+vec3(0,1,0)) == none or f64(length(at-scene_camera())) > 400.0): tender_xfer = TenderTransfer()
        return
    if rider.stage != .away:
        tender_xfer = TenderTransfer()
        return
    u = t-x.since
    next = match x.stage:
        .warping: if u >= XFER_WARP: TenderStage.leaving_plane else: x.stage
        .rowing_out: if u*TENDER_ROW_SPEED >= x.out.length: TenderStage.leaving_plane else: x.stage
        .leaving_plane:
            down = XFER_DOWN+tender_float_walk(x)
            if x.way == .direct and u >= down: TenderStage.onto_ladder
            else if x.way == .rowing and u >= down+XFER_STEP+XFER_AFT: TenderStage.rowing_back
            else: x.stage
        .rowing_back: if u*TENDER_ROW_SPEED >= x.back.length: TenderStage.onto_ladder else: x.stage
        .onto_ladder: if u >= XFER_STEP: TenderStage.climbing else: x.stage
        .climbing: if u >= tender_ladder_time(x): TenderStage.over_rail else: x.stage
        .over_rail: if u >= XFER_OVER: TenderStage.ladder_idle else: x.stage
        .down_to_deck: if u >= XFER_DOWN+XFER_STEP: TenderStage.none else: x.stage
        _: x.stage
    if next == x.stage: return
    if next == .ladder_idle or next == .none: tender_deck_walk(x)
    x.stage = next; x.since = t
    tender_xfer = x

# A boarding pose relative to the same render origin as the two hulls.
tender_person_at = (x: TenderTransfer, ship: mat4, boat: mat4, origin: vec3) -> (mat4,int,bool):
    u = t-x.since
    plane = render_model(pc_at(),origin)
    face = (a: vec3,b: vec3) -> f64: atan2(f64(b.x-a.x),f64(b.z-a.z))+PI
    if x.stage == .warping or x.stage == .rowing_out: return (plane*translation(x.path[0]),-1,false)
    if x.stage == .leaving_plane or x.stage == .down_to_deck:
        if u < XFER_DOWN:
            p = lerp(x.path[0],x.path[1],f32(smoothstep(0.0,1.0,u/XFER_DOWN)))
            return (plane*translation(p)*rotation_y(face(x.path[1],x.path[0])),0,true)
        if x.stage == .down_to_deck:
            a = transform_point(plane,x.path[1]); b = transform_point(ship,x.deck)
            k = smoothstep(0.0,1.0,(u-XFER_DOWN)/XFER_STEP)
            return (translation(rider_climb_point(a,b,k))*rotation_y(face(a,b)),0,false)
        walk = tender_float_walk(x)
        if u < XFER_DOWN+walk:
            p = lerp(x.path[1],x.path[2],f32((u-XFER_DOWN)/max(walk,0.01)))
            return (plane*translation(p)*rotation_y(face(x.path[1],x.path[2])),0,false)
        bow = vec3(0,0.18,1.72)
        s = vec3(0,-0.05,-1.1)
        if u < XFER_DOWN+walk+XFER_STEP:
            a = transform_point(plane,x.path[2]); b = transform_point(boat,bow)
            k = smoothstep(0.0,1.0,(u-XFER_DOWN-walk)/XFER_STEP)
            return (translation(rider_climb_point(a,b,k))*rotation_y(face(a,b)),0,true)
        k = smoothstep(0.0,1.0,(u-XFER_DOWN-walk-XFER_STEP)/XFER_AFT)
        if k > 0.90: return (boat*translation(s),1,false)
        return (boat*translation(lerp(bow,vec3(s.x,0.12,s.z),f32(k/0.90))),0,false)
    s = vec3(0,-0.05,-1.1)
    if x.stage == .rowing_back: return (boat*translation(s),1,false)
    foot = tender_local_of(x.ladder.0)
    deck = tender_local_of(tender_inboard(x.ladder,1.0))
    side = if foot.x < 0: -1 else: 1
    turn = rotation_y(f64(side)*PI*0.5)
    foot.x += f32(side)*0.28
    if x.stage == .onto_ladder:
        a = if x.way == .rowing: transform_point(boat,vec3(0,0.12,s.z)) else: transform_point(plane,x.path[2])
        b = transform_point(ship,foot)
        k = smoothstep(0.0,1.0,u/XFER_STEP)
        at = ship*turn
        at[3] = vec4(rider_climb_point(a,b,k),1)
        return (at,0,true)
    top = vec3(foot.x,deck.y+0.1,foot.z)
    if x.stage == .climbing:
        p = lerp(foot,top,f32(clamp(u/tender_ladder_time(x),0.0,1.0)))
        return (ship*translation(p)*turn,0,true)
    k = smoothstep(0.0,1.0,u/XFER_OVER)
    (ship*translation(rider_climb_point(top,deck,k))*turn,0,true)

draw_tender_boat = (x: TenderTransfer, boat: mat4, L: Light):
    global tender_dinghy, tender_oar, tender_rowers
    if tender_dinghy == none: tender_dinghy = custom_mesh(vessel_vertices(.rowboat, animated_oars=true))
    if tender_oar == none:
        vs: Vertex3D[]
        wood = rgb(0.53,0.40,0.23)
        town_beam(vs,vec3(-0.63,0,0),vec3(1.68,0,0),0.035,wood)
        add_box(vs,vec3(1.55,0,0),vec3(0.56,0.036,0.18),wood)
        tender_oar = custom_mesh(vs)
        tender_rowers = [build_figure(.worker,4480),build_figure(.worker,4488)]
    draw(obj_sh,tender_dinghy!,obj_local_params(L,t,boat))
    speed = tender_boat_pose(x).2
    effort = clamp(speed/0.65,0.0,1.0)
    loop i in 0..2:
        side = if i == 0: -1.0 else: 1.0
        z = if i == 0: 0.45 else: -0.38
        phase = t*4.6+f64(i)*0.36
        sweep = sin(phase)*effort
        recovery = cos(phase)*effort
        oar = boat*translation(vec3(f32(side*0.77),0.58,f32(z)))*rotation_y((if i == 0: PI else: 0.0)+side*sweep*0.48)*rotation_z(-0.08-0.29*effort+recovery*0.24)
        draw(obj_sh,tender_oar!,obj_local_params(L,t,oar))
        at = boat*translation(vec3(f32(side*0.19),-0.06,f32(z+0.38)))*rotation_y(PI)
        draw_figure_at(tender_rowers[i],at,0.0,0.0,L,t,posture=1,arms=vec2(f32(1.3-recovery*0.4),f32(1.3-recovery*0.4)),elbows=vec2(0.42,0.42),render_local=true)

draw_tender_xfer = (L: Light):
    global tender_hand
    x = tender_xfer
    if x.stage == .none: return
    ship = vessel_view.poses.get(TENDER_ID) ?? return
    origin = vessel_view.origin
    boat = if tender_has_boat(x): tender_boat_model(x,origin) else: mat4()
    if tender_has_boat(x): draw_tender_boat(x,boat,L)
    if x.way != .hoisted:
        foot = tender_local_of(x.ladder.0); top = tender_local_of(x.ladder.1)
        along = vec3(0,0,0.24)
        world = (p: vec3) -> vec3: origin+transform_point(ship,p)
        rope = rgba(0.62,0.55,0.42,1); rung = rgba(0.52,0.38,0.24,1)
        draw_line3d(world(foot-along),world(top-along),rope,0.035)
        draw_line3d(world(foot+along),world(top+along),rope,0.035)
        side = if top.x < 0: -1.0 else: 1.0
        loop end in [-1.0,1.0]:
            rail = top - vec3(f32(0.17*side),0,f32(0.29*end))
            draw_line3d(world(rail-vec3(0,f32(TENDER_RAIL),0)),world(rail),rgb(0.35,0.36,0.34),0.05)
            draw_line3d(world(rail),world(rail-vec3(0,0,f32(1.0*end))),rgb(0.35,0.36,0.34),0.035)
        k = 0.0
        loop k < f64(top.y-foot.y)-0.2:
            r = foot+vec3(0,f32(k),0)
            draw_line3d(world(r-along),world(r+along),rung,0.05)
            k += 0.33
        reaching = x.stage == .climbing or x.stage == .over_rail
        if x.stage == .onto_ladder or reaching:
            if tender_hand == none: tender_hand = build_figure(.worker,4471)
            at = tender_local_of(tender_inboard(x.ladder,0.55))
            yaw = if top.x < 0: PI*0.5 else: -PI*0.5
            draw_figure_at(tender_hand!,ship*translation(at)*rotation_y(yaw),0,0,L,t,
                arms=if reaching: vec2(1.25,1.25) else: vec2(-9,-9),render_local=true)
    if x.stage == .ladder_idle: return
    if let f = rider_fig:
        fig = tender_person_at(x,ship,boat,origin)
        climbing = x.stage == .climbing
        phase = (t-x.since)*(if climbing: 3.0 else: 5.0)
        stride = if climbing: 0.25 else: if x.stage == .leaving_plane: 0.6 else: 0.0
        draw_figure_at(f,fig.0,phase,stride,L,t,seated=fig.1<0,posture=max(0,fig.1),
            arms=if fig.2: vec2(2.7,2.7) else: vec2(-9,-9),render_local=true)

# Captures stage a rescued pilot at a boom, alongside, or on the after deck.
tender_capture_staged = -1
tender_capture_passenger = (f: int, say: (str) -> void):
    global tender_capture_staged, judge_camera, judge_origin, pc, vessel_mooring
    c = living_world.people[living_world.player].craft
    if f == 32 and (tender_capture == "passenger-direct" or tender_capture == "passenger-brow"):
        s = vessel_spec(.seaplane_tender)
        hd = atan2(f64(tender_forward().x),-f64(tender_forward().z))
        at = tender_local(vec3(f32(s.beam*0.5+pc.spec.span*0.55+3.0),0,18))
        pc = make_flyer(pc.kind,pc.model,craft_models[pc.model].contacts,at,hd)
        pc.spec.player = true; pc.placed = false
        vessel_mooring = VesselMooring(TENDER_ID,1.0,18.0)
    if f >= 70 and tender_capture_staged < 0:
        id = stage_rescue_survivor(living_world,living_world.aircraft[c].pose.pos+vec3(2,0,0))
        if id >= 0 and living.board_survivors(living_world,id,living_world.player) > 0:
            tender_capture_staged = f
            say("a downed pilot aboard, {rescue_aboard_name(living_world,id)}")
        else if f % 60 == 0: say("waiting for the rescued pilot")
    if tender_capture_staged < 0: return
    wait = f-tender_capture_staged
    deck = tender_capture == "passenger-deck"
    if deck and wait == 30: tender_hoist_start(false)
    out_at = if deck: 180+int(hoist_seconds()*60.0) else: 90
    if wait == out_at:
        tender_let_out()
        say("let out: aboard {rescue_aboard(living_world).len()}; transfer {tender_xfer.stage}")
    x = tender_xfer
    origin = TENDER_AT
    ship = vessel_pose(tender_vessel(),t,wind_now_vec().xz,origin)
    boat = if tender_has_boat(x): tender_boat_model(x,origin) else: mat4()
    judge_origin = pc.state.position
    if rider.stage == .away:
        at = origin+tender_person_at(x,ship,boat,origin).0[3].xyz
        if x.stage == .rowing_out or x.stage == .rowing_back:
            row = origin+boat[3].xyz
            focus = if x.stage == .rowing_out: mix(row,at,0.20) else: row
            judge_camera = JudgeView(focus+tender_port()*13.0+tender_forward()*-7.0+vec3(0,6,0),focus+vec3(0,0.9,0),"the Ierax's pulling boat")
        else:
            close = x.stage == .climbing or x.stage == .onto_ladder or x.stage == .over_rail or x.stage == .down_to_deck
            eye = at+tender_port()*f32(if close: 5.6 else: 14.0)-tender_forward()*f32(if close: 4.0 else: 7.0)+vec3(0,f32(if close: 2.4 else: 4.5),0)
            judge_camera = JudgeView(eye,at+vec3(0,1.2,0),"the rescued pilot going aboard")
        if f % 30 == 0: say("transfer {x.stage}; feet local {tender_local_of(at)}")
    else if rider.stage == .walking and tender_way_on:
        at = origin+transform_point(ship,rider.pos)
        away = transform_dir(ship,rider.away)
        judge_camera = JudgeView(at-away*6.0+tender_forward()*-2.4+vec3(0,1.25,0),at+away*0.4+vec3(0,0.85,0),"the rescued pilot on deck")
        if f % 15 == 0: say("deck walk; feet local {rider.pos}")
    else:
        seat = transform_point(pc_at(),rider_seat(ride_seat(player_model()),rider.on_wing,pc.spec.span))
        judge_camera = JudgeView(seat+tender_port()*12.0-tender_forward()*6.0+vec3(0,4,0),seat+vec3(0,0.5,0)-tender_port()*4.0,"the rescued pilot at the Ierax")

# AEGEAN_CAPTURE_TENDER=hoist (captures and checks): at frame 30 the aircraft moored at the
# Ierax's first boom; her bunkers opened and shut; the aircraft knocked about (hull and engine at
# half); hoisted aboard, her mechanics at work, lowered over the side. TENDER lines say each state.
tender_capture = env("AEGEAN_CAPTURE_TENDER") ?? ""
tender_capture_step = ():
    global pc, ui
    f = frame_number()
    c = living_world.people[living_world.player].craft
    say = (what: str):
        print("TENDER frame {f}: {what}; hoist {tender_hoist}, at {pc.state.position.x:.0},{pc.state.position.y:.1},{pc.state.position.z:.0}, moored {pc.state.moored}, hull {living_world.aircraft[c].hull} engine {living_world.aircraft[c].engine}, offers [{join([loop o in aboard_offers(): o.words], " | ")}], toast '{toast}'")
    if f == 30:
        hd = atan2(f64(tender_forward().x), -f64(tender_forward().z))
        pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, tender_slot(0), hd)
        pc.spec.player = true; pc.placed = false; me.mode = .aboard; rope.tied = false
        say("moored at her first boom")
    if tender_capture in ["passenger","passenger-brow","passenger-direct","passenger-deck"]:
        tender_capture_passenger(f, say)
        return
    if f == 60:
        tender_fuel()
        say("her bunkers: ui {ui}, pier {fuel_panel_pier.name}")
        ui = .none
    if f == 90:
        living_world.aircraft[c].hull = 500; living_world.aircraft[c].engine = 500; living_world.aircraft[c].revision += 1
    if f == 120:
        say("knocked about")
        tender_hoist_start(false)
    if f == 120 + int(hoist_seconds() * 60.0) + 60:
        say("hoisted")
        tender_repair()
    if f == 120 + int(hoist_seconds() * 60.0) + 400:
        say("seen to")
        tender_hoist_start(true)
    if f == 120 + int(hoist_seconds() * 120.0) + 520: say("lowered")
    if tender_hoist != 0 and f % 120 == 0: say("hoist under way")

# ---- the call for help (src/radio_help.jo) ----
sos = HelpCall()
sos_serial = 0
sos_wreck_tilt = quat_euler(0, 0, 0)     # (a wreck towed keeps its list: its tilt off level)
sos_tried: int[]                      # passing ships that could not get through, this call
sos_skip = 0                          # minutes a wait skipped
help_tow_at = vec3(0, 0, 0)           # the towed aircraft, following the line
help_tow_h = 0.0

help_need_now = () -> HelpNeed:
    if me.mode != .aboard or pc.spec.landplane: return .none
    need=help_need(pc.state,pc.spec.fuel_capacity)
    if need==.fuel and pc.state.moored and (offshore!=none or fuel_pier_near()!=none):return .none
    need

keep_help = () -> HelpCheckpoint:
    HelpCheckpoint(call=sos, tow_at=help_tow_at, tow_heading=help_tow_h, wreck_tilt=sos_wreck_tilt,
        from=help_from, in_water=help_in_water, swim_to=help_swim_to, swim_seconds=help_swim_s, tried=sos_tried)

restore_help = (kept: HelpCheckpoint):
    global sos, sos_tried, sos_serial, sos_wreck_tilt, help_tow_at, help_tow_h, help_from, help_in_water, help_swim_to, help_swim_s, help_still
    global vessel_mooring
    sos=kept.call; sos_tried=kept.tried; sos_wreck_tilt=kept.wreck_tilt
    help_tow_at=kept.tow_at; help_tow_h=kept.tow_heading; help_from=kept.from
    help_in_water=kept.in_water; help_swim_to=kept.swim_to; help_swim_s=kept.swim_seconds; help_still=0.0
    if sos.vessel>=HELP_VESSEL: sos_serial=max(sos_serial,sos.vessel-HELP_VESSEL)
    # Old checkpoints kept the launch and its line but dropped the call. Release the old tow and
    # put its pilot back at the wreck with an active search, including saves taken aboard the launch.
    old=[loop ship in vessels.ships: if ship.id>=HELP_VESSEL and ship.id<HELP_VESSEL+10000000 and ship.id!=sos.vessel: (ship.id,ship.lane)]
    old_tow=false
    loop pair in old:
        k=sea_lane_index(vessels,pair.1)
        if k>=0 and vessels.lanes[k].destination!=-1:old_tow=true
        retire_vessel(vessels,pair.0)
        if pair.1>=0:retire_sea_lane(vessels,pair.1)
    if sos.stage==.none and ((old_tow and me.mode==.aboard and pc.state.moored) or (me.mode==.free and help_wreck() and pc.state.on_water)):
        unmoor(pc.state); rope.tied=false; vessel_mooring=VesselMooring()
        me.mode=.aboard; pc.placed=false
        help_search(pc.state.position,.tow)

# If nothing can reach the pilot on a live route, wait through the same clock as a long tow.
# Search and return time come from the distance to a harbour and an offshore vessel's speed.
help_search = (at: vec3, need: HelpNeed):
    global sos
    help_drop()
    place=if need==.none:0 else:if need==.pickup:pickup_harbour(at) else:help_harbour(at,1e9)
    if place>=0 and place!=0:
        dock=help_dock(place,[])
        if dock==none or shore_point(towns,dock!.0)==none or (need==.fuel and refuel.fuel_pier_at(living_world,dock!.0)==none):place=0
    else if place!=TENDER_PLACE:place=0
    dest=if place==TENDER_PLACE:TENDER_AT else:help_harbour_at(place)
    d=f64(length(dest.xz-at.xz))
    eta=max(30,2*help_minutes(d*1.25,vessel_spec(.coastal_steamer).speed))
    name=if place==TENDER_PLACE:TENDER_NAME else:help_harbour_name(place)
    sos=HelpCall(stage=.coming,by=.search,need=need,name="a search boat",harbour=place,harbour_name=name,alongside=at,eta=eta)

help_route_failed = ():
    if sos.need==.pickup:
        help_search(me.pos,.pickup)
        return
    # Leave the pilot at the aircraft until they choose to wait. A broken tow line cannot leave it
    # artificially tied to the last point on the route.
    if sos.vessel>=0 and pc.state.moored:unmoor(pc.state)
    need=help_need(pc.state,pc.spec.fuel_capacity)
    help_search(pc.state.position,if need==.none:HelpNeed.tow else:need)

# One of the player's flight that could come down with cans: flying, enough in its own tank,
# nearest within the R/T's reach (-1 none).
help_wingman = (at: vec3) -> int:
    me_i = combat_index(battle, living_world.people[living_world.player].craft)
    if me_i < 0 or not battle.enabled: return -1
    best = -1; near = RADIO_REACH
    loop i in 0..battle.actors.len():
        a = battle.actors[i]
        if a.side != battle.actors[me_i].side or a.human or a.status != .flying or not a.present or a.external: continue
        if a.bailed or a.state.crashed or a.state.on_water or a.state.moored or a.state.beached: continue
        if a.craft < 0 or a.craft >= living_world.aircraft.len() or living_world.aircraft[a.craft].fuel_ml < CANS_ML + 40000: continue
        d = f64(length(a.state.position - at))
        if d < near: near = d; best = i
    best

help_in_reach = () -> bool:
    at = pc.state.position
    help_wingman(at) >= 0 or help_harbour(at, RADIO_REACH) >= 0 or f64(length(vec3(at.x - TENDER_AT.x, 0, at.z - TENDER_AT.z))) < RADIO_REACH

# A line on the radio: the strait's radio box in the fight, plain words otherwise.
help_say = (who: str, words: str):
    if active_scenario == "strait" and battle.enabled: radio_say(homeward, "help{t}", who, words)
    else: say_toast(if who == "": words else: "{capital(who)}: {words}", words)

help_drop = ():
    global sos
    if sos.vessel >= 0:
        retire_vessel(vessels, sos.vessel)
        if sos.lane >= 0:
            if sos.need == .pickup and vessels.search.lane == sos.lane: vessels.search = SeaSearch()
            retire_sea_lane(vessels, sos.lane)
    if sos.hidden >= 0 and sos.hidden < living_world.far.vehicles.len():
        j = living_world.far.vehicles[sos.hidden].journey
        if j >= 0 and j in living_world.far.journeys: living_world.far.journeys[j].hold_until_tick = living_world.tick
    if sos.by == .wingman and battle.assist.craft == sos.who: end_assist(battle)
    if sos.by == .pilot:
        k = help_traffic_index()
        if k >= 0 and traffic[k].assist_stage > 0 and traffic[k].assist_stage < 3:
            tr = traffic[k]; traffic_release_assist(tr, wind_now_vec()); traffic[k] = tr
    if sos.stage == .towing: rope.tied = false
    # (taken off and the help gone wrong: back in one's own cockpit, not left as a camera)
    if sos.aboard and me.mode == .free:
        if sos.need == .pickup:
            me.mode = .descent
            loop n in 0..battle.descents.len():
                i = battle.descents.len() - 1 - n
                if battle.descents[i].person == living_world.player and battle.descents[i].phase == .swimming:
                    battle.descents[i].released = false
                    break
        else:
            me.mode = .aboard; pc.placed = false
    sos = HelpCall()

# The flight first, then a passing ship or the harbour's launch. A relayed
# call goes straight to the surface services if the airborne responder is lost.
help_call = (flare: bool, surface_only: bool = false):
    global sos, sos_serial, sos_tried
    need = help_need_now()
    if need == .none or sos.stage != .none: return
    at = pc.state.position
    if flare: help_flare(at)
    if offshore_only(pc.kind):
        help_search(at,need)
        return
    # (the flight: cans for a dry tank; for a wreck, to take the pilot off and fly them back to base)
    if not flare and not surface_only and (need == .fuel or (help_wreck() and battle.homes.len() > 0)):
        wi = help_wingman(at)
        if wi >= 0:
            a = battle.actors[wi]
            eta = max(2, int(ceil(f64(length(a.state.position - at)) / max(a.spec.cruise_speed * 0.8, 20.0) / 60.0)) + 2)
            number = 0
            loop j in 0..wi + 1:
                if battle.actors[j].side == a.side: number += 1
            who = call_sign(living_world, a.side, max(1, number))
            sos = HelpCall(stage = .coming, by = .wingman, need = need, who = a.craft, name = who, eta = eta)
            help_say(who, if need == .fuel: "I see you. Coming down alongside with a couple of cans; {help_eta_words(eta)}." else: "I see you. Coming down to take you off; {help_eta_words(eta)}.")
            return
    # (another pilot of the world flying near, outside a fight: cans for a dry tank, or for a wreck
    # the pilot taken along to wherever they are bound)
    if not flare and not surface_only and (need == .fuel or help_wreck()):
        k = help_traffic_pick(at, need == .fuel)
        if k >= 0:
            tr = traffic[k]
            along = help_alongside(at, tr.state.position, pc.spec.span)
            traffic_send_assist(tr, vec3(along.x, at.y, along.z), wind_now_vec())
            traffic[k] = tr
            eta = max(2, int(ceil(f64(length(tr.state.position - at)) / max(tr.spec.cruise_speed * 0.8, 20.0) / 60.0)) + 2)
            who = if tr.person >= 0 and tr.person < living_world.people.len(): living_world.people[tr.person].name else: "A pilot"
            sos = HelpCall(stage = .coming, by = .pilot, need = need, who = tr.craft, name = who, eta = eta, alongside = along)
            help_say(who, if need == .fuel: "I hear you. I'm not far off; I'll come down with a couple of cans, {help_eta_words(eta)}." else: "I hear you. I'm not far off; I'll come down and take you along, {help_eta_words(eta)}.")
            return
    dest = help_harbour(at, 90000.0)
    # (the Ierax: her launch answers when she is nearer than any harbour's)
    tender_d = f64(length(vec3(at.x - TENDER_AT.x, 0, at.z - TENDER_AT.z)))
    tender_near = tender_d < (if flare: FLARE_REACH else: RADIO_REACH)
    if dest < 0 and not tender_near:
        help_search(at,need)
        return
    reach = if flare: FLARE_REACH else: SHIP_REACH
    ship = help_pick_ship(living_world, at, reach)
    if ship >= 0 and ship in sos_tried: ship = -1
    launch_from = if flare: help_harbour(at, FLARE_REACH) else: help_harbour(at, RADIO_REACH)
    by_tender = ship < 0 and tender_near and (launch_from < 0 or tender_d < f64(length(help_harbour_at(launch_from) - at)))
    if ship < 0 and launch_from < 0 and not by_tender:
        help_search(at,need)
        return
    sos_serial += 1
    id = HELP_VESSEL + sos_serial
    kind = if ship >= 0: VesselKind.trehantiri else: VesselKind.canal_launch
    spec = vessel_spec(kind)
    start = vec2(0, 0); yaw = 0.0; owner = -1; side = 0; name = ""; hidden = -1
    if ship >= 0:
        v = living_world.far.vehicles[ship]
        start = v.pos.xz; owner = max(0, v.account); side = 200 + v.citizen; hidden = ship
        if f64(length(v.velocity)) > 0.01: yaw = atan2(f64(v.velocity.x), f64(v.velocity.z))
        skipper = if v.captain >= 0 and v.captain < living_world.people.len(): living_world.people[v.captain].name else: ""
        port = help_harbour_name(v.home)
        if port == "the harbour": port = ""
        name = if skipper != "": "{skipper}'s caique" else: if port != "": "a caique out of {port}" else: "a caique"
        if v.journey >= 0 and v.journey in living_world.far.journeys: living_world.far.journeys[v.journey].hold_until_tick = living_world.tick + 120 * 60 * 24
    else if by_tender:
        start = tender_launch_at().xz
        dest = TENDER_PLACE
        owner = 0
        name = "{TENDER_NAME}'s launch"
        d0 = vec2(at.x, at.z) - start
        if length(d0) > 0.1: yaw = atan2(f64(d0.x), f64(d0.y))
    else:
        berth = vessel_berth(launch_from, .canal_launch)
        if berth == none:
            help_search(at,need)
            return
        start = berth!.0
        dest = launch_from
        owner = max(0, launches.harbour_account(living_world, launch_from))
        name = "the launch from {help_harbour_name(launch_from)}"
        d0 = vec2(at.x, at.z) - start
        if length(d0) > 0.1: yaw = atan2(f64(d0.x), f64(d0.y))
    along = help_alongside(at, vec3(start.x, 0, start.y), pc.spec.span, spec.length)
    lane = request_sea_lane(vessels, -1, -1, start, along.xz, spec.draft, spec.beam * 0.5 + 2.0)
    if lane < 0 or not spawn_vessel(vessels, Vessel(id = id, kind = kind, owner = owner, side = side, lane = lane, position = vec3(start.x, 0, start.y), yaw = yaw, status = .waiting_route)):
        if hidden >= 0: sos.hidden = hidden
        if lane>=0:retire_sea_lane(vessels,lane)
        help_search(at,need)
        return
    distance = f64(length(along.xz - start))
    eta = help_minutes(distance * 1.25, help_boat_speed(id))
    sos = HelpCall(stage = .routing, by = if ship >= 0: HelpBy.ship else: HelpBy.launch, need = .tow, who = if ship >= 0: ship else: launch_from, name = name, kind = kind, vessel = id, lane = lane, harbour = dest, harbour_name = if dest == TENDER_PLACE: TENDER_NAME else: help_harbour_name(dest), alongside = along, flare = flare, eta = eta, hidden = hidden)
    station = if by_tender: capital(TENDER_NAME) else: "{help_harbour_name(if launch_from >= 0: launch_from else: dest)} harbour"
    if flare: say_toast("{capital(name)} has seen the flare and is turning toward you.")
    else if ship >= 0: help_say(station, "{capital(name)} is nearest you; she's turning your way. {capital(help_eta_words(eta))}.")
    else: help_say(station, "We'll send the launch out to you. {capital(help_eta_words(eta))}.")

# The pilot and the aircraft can be kilometres apart after a bailout. A launch
# answers the swimmer, and only carries the pilot.
pickup_harbour = (at: vec3) -> int:
    c = combat_index(battle, living_world.people[living_world.player].craft)
    if c >= 0 and active_scenario != "":
        if let h = help_base(battle.actors[c].side):
            if active_scenario == "strait" and not pc.spec.landplane and h.place < 0 and h.name == TENDER_NAME: return TENDER_PLACE
            if h.place >= 0 and vessel_berth(h.place, .canal_launch) != none: return h.place
    help_harbour(at, 1e9)

pickup_launch = (at: vec3, search: bool) -> bool:
    global sos, sos_serial
    dest = pickup_harbour(at)
    if dest < 0 and dest != TENDER_PLACE: return false
    kind = VesselKind.canal_launch
    spec = vessel_spec(kind)
    tender = dest == TENDER_PLACE
    berth = if tender: (tender_launch_at().xz, true) else: vessel_berth(dest, kind)
    if berth == none: return false
    start = berth!.0
    name = if tender: "{TENDER_NAME}'s launch" else: "the launch from {help_harbour_name(dest)}"
    way = normalize(start - at.xz + vec2(0.0001, 0))
    end = at.xz + way * 16
    nearby = search or length(start - at.xz) > 2500.0 or not pickup_channel(end + way * 12, end, spec)
    if nearby:
        if let approach = pickup_search_approach(at.xz, spec):
            start = approach.0; end = approach.1
            name = "a fishing boat"
        else: return false
    id = HELP_VESSEL + sos_serial + 1
    lane = request_sea_lane(vessels, -1, -1, start, end, spec.draft, spec.beam * 0.5 + 2.0, anchorage = true)
    if lane < 0: return false
    yaw = atan2(f64(end.x - start.x), f64(end.y - start.y))
    if not spawn_vessel(vessels, Vessel(id = id, kind = kind, owner = 0, lane = lane, position = vec3(start.x, f32(water_level_at(f64(start.x), f64(start.y))), start.y), yaw = yaw, status = .waiting_route)):
        retire_sea_lane(vessels, lane)
        return false
    sos_serial += 1
    sos = HelpCall(stage = .routing, by = .launch, need = .pickup, name = name, kind = kind, vessel = id, lane = lane,
        harbour = dest, harbour_name = if tender: TENDER_NAME else: help_harbour_name(dest), alongside = vec3(end.x, at.y, end.y),
        nearby_pickup = nearby)
    say_toast("{capital(name)} is coming for you.")
    true

capital = (s: str) -> str: if s.len() == 0: s else: s[0..1].upper() + s[1..]

pickup_retry = ():
    nearby = sos.nearby_pickup
    help_drop()
    if nearby or not pickup_launch(me.pos, true): help_search(me.pos, .pickup)

pickup_step = ():
    if sos.stage == .done or skip.active: return
    k = vessel_index(vessels, sos.vessel)
    if k < 0:
        pickup_retry()
        return
    v = vessels.ships[k]
    if v.status == .sinking or v.status == .sunk or v.status == .captured:
        pickup_retry()
        return
    li = sea_lane_index(vessels, sos.lane)
    if sos.stage == .routing:
        if li >= 0 and vessels.lanes[li].status == .ready:
            sos.stage = .coming; sos.since = 0.0
        else if li < 0 or vessels.lanes[li].status == .blocked or sos.since > 12.0:
            pickup_retry()
    else if sos.stage == .coming:
        if v.status == .docked or v.status == .anchored:
            if length(v.position.xz - me.pos.xz) > 90.0:
                pickup_retry()
            else:
                sos.stage = .alongside; sos.since = 0.0
        else if v.status == .stopped:
            pickup_retry()
        else if sos.since > 20.0 and lane_left(vessels, v) >= SEEN_COMING + 20.0:
            help_wait()
        else if sos.since > 45.0:
            pickup_retry()
    else if sos.stage == .alongside:
        if not sos.aboard:
            help_board(boat_deck_seat(v).0)
        else if help_aboard_done():
            sos.stage = .carrying; sos.since = 0.0
            to = if sos.harbour == TENDER_PLACE: (tender_tow_end(others_at()), true) else: vessel_berth(sos.harbour, sos.kind)
            if let berth = to:
                spec = vessel_spec(sos.kind)
                lane = request_sea_lane(vessels, -1, sos.harbour, v.position.xz, berth.0, spec.draft, spec.beam * 0.5 + 2.0, berth.1)
                if lane >= 0 and set_vessel_route(vessels, sos.vessel, lane):
                    retire_sea_lane(vessels, sos.lane)
                    sos.lane = lane
    else if sos.stage == .carrying:
        if sos.since > 4.0 or vpressed(.f):
            help_wait()

# Each frame aboard: the wingman down and alongside, the cans; the boat routed, coming, alongside,
# the tow under way, in at the harbour.
help_step = (dt: f64):
    global sos, sos_wreck_tilt, sos_tried, help_tow_at, help_tow_h
    if sos.stage == .none: return
    sos.since += dt
    if sos.by==.search:
        if sos.need==.pickup and me.mode!=.descent:help_drop();return
        at=if me.mode==.aboard:pc.state.position else:me.pos
        if sos.need!=.pickup and length(at.xz-sos.alongside.xz)>150.0:help_drop();return
        if me.mode!=.descent and sos.stage==.coming and vpressed(.f):help_wait()
        return
    if sos.need == .pickup:
        if me.mode != .descent and not sos.aboard: help_drop()
        else: pickup_step()
        return
    if me.mode != .aboard and not sos.aboard:
        help_drop()
        return
    # (taken off: the camera rides with them; F skips ahead, once under way)
    if sos.aboard:
        if vpressed(.f) and help_aboard_done() and (sos.stage == .towing or (sos.stage == .carrying and help_carrier_up())): help_wait()
    if sos.by == .pilot:
        help_pilot_step()
        return
    if sos.by == .wingman:
        waiting = sos.stage == .coming and battle.assist.craft != sos.who
        if waiting and sos.need == .tow:
            # A call can come in mid-glide. Wait for a pickup on the surface
            # that the wingman can actually reach at its open-water taxi speed.
            if not (pc.state.on_water or pc.state.beached or pc.state.moored): return
            if length(pc.state.velocity.xz) > 5.0 * pure_k(pc.spec): return
        i = combat_index(battle, sos.who)
        if i < 0 or battle.actors[i].status != .flying or not battle.actors[i].present:
            pending = sos.need == .tow and not sos.aboard and (sos.stage == .coming or sos.stage == .alongside)
            who = sos.name
            if pending:
                help_drop()
                # The first responder can be shot down. Relay the existing
                # call to the surface service while its flight is still fighting.
                help_say("", "Lost contact with {who}. Relaying your position.")
                help_call(false, surface_only = true)
            else: help_route_failed()
            return
        a = battle.actors[i]
        if waiting:
            sos.alongside = help_alongside(pc.state.position, a.state.position, pc.spec.span)
            send_assist(battle, a.craft, sos.alongside, wind_now_vec())
            sos.since = 0.0
            return
        if sos.stage == .coming:
            # The wreck can still drift during the approach and water run.
            wreck = pc.state.position
            offset = length((sos.alongside - wreck).xz)
            if offset > pc.spec.span + ALONGSIDE_GAP:
                along = help_alongside(vec3(wreck.x, 0, wreck.z), a.state.position, pc.spec.span)
                if move_assist(battle, along, wind_now_vec()):
                    sos.alongside = along
                    return
        if sos.stage==.coming and sos.since>max(180.0,f64(sos.eta)*60.0):
            help_route_failed()
        else if sos.stage == .coming and a.pilot.plan.phase == .done:
            battle.assist.stage = 2; sos.stage = .alongside; sos.since = 0.0
            help_say(sos.name, if sos.need == .fuel: "Here. Two cans coming across." else: "Here. Swim across to the float; I'll give you a hand up.")
        else if sos.stage == .alongside and sos.since > 4.0 and sos.need == .tow and not sos.aboard:
            # (the pilot off the wreck, swimming across to the float and up into the second seat)
            help_board(help_carrier_seat().0)
        else if sos.stage == .alongside and sos.need == .tow and help_aboard_done():
            # (aboard: off again, for the base)
            release_assist(battle, wind_now_vec())
            sos.stage = .carrying; sos.since = 0.0
            sos.harbour_name = base_name(living_world, battle, a.side)
            help_say(sos.name, "Got you. Back to {sos.harbour_name}; the harbour will fetch your aircraft in.")
        else if sos.stage == .carrying:
            if sos.since > 600.0: help_wait()
        else if sos.stage == .alongside and sos.since > 6.0 and sos.need == .fuel:
            me_craft = living_world.people[living_world.player].craft
            moved = help_cans(living_world, a.craft, me_craft, CANS_ML)
            pc.state.fuel = f64(living_world.aircraft[me_craft].fuel_ml) / 1000.0
            battle.actors[i].state.fuel = f64(living_world.aircraft[a.craft].fuel_ml) / 1000.0
            litres = moved / 1000
            price = 0
            if let pier = refuel.fuel_pier_at(living_world, pc.state.position, 90000.0): price = refuel.fuel_price(living_world, pier) * moved / 10000
            person = a.person
            to = if person >= 0 and person < living_world.people.len(): living_world.people[person].account else: -1
            paid = help_pay(living_world, to, price, "cans", -1)
            help_say(sos.name, if paid or price == 0: "{litres} litres. That'll see you home." else: "{litres} litres. Settle up when you're flush.")
            if price > 0: say_toast(if paid: "{phoenix_text(price)} to {sos.name} for the fuel." else: "{phoenix_text(price)} owed to {sos.name} for the fuel.")
            release_assist(battle, wind_now_vec())
            sos.stage = .done; sos.since = 0.0
        else if sos.stage == .done and (f64(a.state.position.y) > 120.0 or sos.since > 120.0):
            end_assist(battle)
            sos = HelpCall()
        return
    k = vessel_index(vessels, sos.vessel)
    if k < 0:
        help_route_failed()
        return
    v = vessels.ships[k]
    li = sea_lane_index(vessels, sos.lane)
    if v.status==.sinking or v.status==.sunk or v.status==.captured:
        help_route_failed()
        return
    if sos.stage == .routing:
        if li >= 0 and vessels.lanes[li].status == .ready: sos.stage = .coming; sos.since = 0.0
        else if li < 0 or vessels.lanes[li].status == .blocked or v.status == .stopped or sos.since>30.0:
            if sos.hidden >= 0: sos_tried.push(sos.hidden)
            help_say("", "{capital(sos.name)} can't find a way through to you.")
            help_route_failed()
        return
    if sos.stage == .coming:
        if v.status == .stopped:
            help_say("", "{capital(sos.name)} has had to stop short.")
            help_route_failed()
        else if sos.since>max(180.0,f64(sos.eta)*60.0):
            help_route_failed()
        # (in, or as near as it will come: stopped close by for a while)
        else if v.status == .docked or v.status == .anchored or (v.speed < 0.2 and sos.since > 20.0 and f64(length(v.position.xz - pc.state.position.xz)) < vessel_spec(v.kind).length * 0.5 + pc.spec.span * 0.5 + 40.0 and help_slow(v)):
            sos.stage = .alongside; sos.since = 0.0
            help_say(sos.name, "Alongside. Throw us your line.")
        return
    if sos.stage == .alongside:
        # (a wreck's pilot swims across and climbs aboard first; then the line)
        if help_wreck() and not sos.aboard and sos.since > 3.0: help_board(boat_deck_seat(v).0)
        if sos.since < 5.0 or (sos.aboard and not help_aboard_done()): return
        to = if sos.harbour == TENDER_PLACE: (tender_tow_end(others_at()), true) else: vessel_berth(sos.harbour, sos.kind)
        if to == none:
            help_route_failed()
            return
        spec = vessel_spec(sos.kind)
        old = sos.lane
        # (come to rest close by but not formally in: stopped, so a new voyage can begin where she lies)
        if v.status == .underway: _ = stop_vessel(vessels, sos.vessel)
        lane = request_sea_lane(vessels, -1, sos.harbour, v.position.xz, to!.0, spec.draft, spec.beam * 0.5 + 2.0, to!.1)
        if lane < 0 or not set_vessel_route(vessels, sos.vessel, lane):
            if lane>=0:retire_sea_lane(vessels,lane)
            help_route_failed()
            return
        retire_sea_lane(vessels, old)
        sos.lane = lane
        sos.eta = help_minutes(f64(length(to!.0 - v.position.xz)) * 1.25, help_boat_speed(sos.vessel))
        sos.stage = .towing; sos.since = 0.0
        # (the aircraft on the line: moored to the boat's stern, nosed after it; a wreck keeps its list)
        level = quat_euler(0, -heading(pc.state), 0)
        sos_wreck_tilt = if pc.state.crashed or pc.state.capsized: quat_mul(quat_inverse(level), pc.state.orientation) else: quat_euler(0, 0, 0)
        # (hauled round onto the line from where it lies, not put there)
        help_tow_at = pc.state.position; help_tow_h = heading(pc.state)
        moor(pc.state, vec3(help_tow_at.x, f32(pc.spec.float_height), help_tow_at.z), help_tow_h)
        rope.tied = true; rope.anchor = tow_stern(v); rope.loose = rope.anchor
        if help_wreck():
            # (the pilot aboard on the after deck, the wreck towed in behind)
            help_say(sos.name, "Come aboard; she'll follow on the line. {capital(sos.harbour_name)}, {help_eta_words(sos.eta)}.")
        else: help_say(sos.name, "Made fast. {capital(sos.harbour_name)}, {help_eta_words(sos.eta)}.")
        return
    if sos.stage == .towing:
        if not pc.state.moored:
            help_say(sos.name, "The line's gone. We'll leave you be.")
            help_drop()
            return
        if v.status==.stopped or li<0 or vessels.lanes[li].status==.blocked:
            help_route_failed()
            return
        # (the aircraft follows the line: drawn after the stern, never faster than the boat makes way
        # and a little over, nosing round to follow it)
        place = tow_place(v, TOW_LINE)
        gap = vec3(place.0.x - help_tow_at.x, 0, place.0.z - help_tow_at.z)
        move = min(f64(length(gap)), (v.speed + 1.2) * dt)
        if length(gap) > 0.01: help_tow_at += normalize(gap) * f32(move)
        turn = angle_delta(place.1, help_tow_h)
        help_tow_h += clamp(turn, -0.3 * dt, 0.3 * dt)
        pc.state.mooring_point = vec3(help_tow_at.x, f32(pc.spec.float_height), help_tow_at.z)
        pc.state.mooring_orientation = quat_mul(quat_euler(0, -help_tow_h, 0), sos_wreck_tilt)
        rope.tied = true; rope.anchor = tow_stern(v)
        if (v.status == .docked or v.status == .anchored) and sos.since > 3.0:
            leisure_skip(10, "warped in to a dock", after = 6)
            sos.stage = .done

help_wreck = () -> bool: pc.state.crashed or pc.state.capsized

# The flight's base for a side (none outside a fight with homes).
help_base = (side: int) -> BattleHome?:
    loop h in battle.homes:
        if h.side == side: return h
    none

# Off the wreck: the pilot climbs across to `to` (the camera with them from now on).
# (down off the wreck into the water, a swim across in the vest, and up the side: SWIM_PACE m/s)
const SWIM_PACE = 1.4
const DROP_OFF = 0.8
help_from = vec3(0, 0, 0)
help_in_water = vec3(0, 0, 0)
help_swim_to = vec3(0, 0, 0)
help_swim_s = 0.0
help_board = (to: vec3):
    global help_from, help_in_water, help_swim_to, help_swim_s
    sos.aboard = true; sos.climbed = t
    at = if sos.need == .pickup: me.pos else: pc.state.position
    across = vec3(to.x - at.x, 0, to.z - at.z)
    way = normalize(across + vec3(0.0001, 0, 0))
    help_in_water = vec3(at.x, 0, at.z)
    if sos.need == .pickup:
        help_in_water.y = f32(swim_level(f64(at.x), f64(at.z)))
        help_from = help_in_water - vec3(0, 0.5, 0)
        loop mut d in battle.descents:
            if d.person == living_world.player and not d.released and d.phase == .swimming: d.released = true
    else:
        help_from = at + quat_rotate(pc.state.orientation, ride_seat(player_model()) - vec3(0, 1.2, 0))
        help_in_water += way * f32(pc.spec.span * 0.12 + 1.0)
    help_swim_to = vec3(to.x, help_in_water.y, to.z) - way * f32(if sos.by == .wingman: 1.2 else: vessel_spec(sos.kind).beam * 0.5 + 0.4)
    help_swim_s = f64(length(help_swim_to - help_in_water)) / SWIM_PACE
    me.mode = .free
    mouse_lock(false)

# All the way across and up into the seat.
help_aboard_done = () -> bool: sos.aboard and t - sos.climbed > DROP_OFF + help_swim_s + CLIMB_ACROSS

# The wingman carrying the pilot: where the second seat is (and the folk turn), and whether it is
# up and away yet.
# The aircraft come for the pilot: the wingman, or a pilot of the world passing (whether there is
# one, its drawn state, its model, its span).
help_traffic_index = () -> int:
    loop k in 0..traffic.len():
        if traffic[k].craft == sos.who: return k
    -1
help_carrier = () -> (bool, CraftState, int, f64):
    if sos.by == .wingman:
        i = combat_index(battle, sos.who)
        if i < 0: return (false, pc.state, 0, 0.0)
        a = battle.actors[i]
        return (true, combat_render_state(a, battle.render_alpha), a.model, a.spec.span)
    if sos.by == .pilot:
        k = help_traffic_index()
        if k < 0: return (false, pc.state, 0, 0.0)
        return (true, traffic[k].state, traffic[k].model, traffic[k].spec.span)
    (false, pc.state, 0, 0.0)

help_carrier_seat = () -> (vec3, f64):
    c = help_carrier()
    if not c.0: return (pc.state.position, 0.0)
    st = c.1
    m = craft_models[max(0, min(c.2, craft_models.len() - 1))]
    (st.position + quat_rotate(st.orientation, rider_seat(ride_seat(m), false, c.3) - vec3(0, 1.55, 0)), heading(st))

help_carrier_up = () -> bool:
    c = help_carrier()
    c.0 and not c.1.on_water and f64(c.1.position.y) > 100.0

help_seat_pose = () -> (vec3, f64):
    if sos.by == .wingman or sos.by == .pilot: return help_carrier_seat()
    k = vessel_index(vessels, sos.vessel)
    if k < 0: return (pc.state.position, 0.0)
    boat_deck_seat(vessels.ships[k])

help_boat_seat_model = () -> mat4?:
    if sos.by == .wingman or sos.by == .pilot: return none
    ship = vessel_view.poses.get(sos.vessel) ?? return none
    ship*translation(boat_deck_seat_local(sos.kind))

# The camera riding with a pilot taken off: behind the boat and to one side, the tow in view; or
# behind the wingman's aircraft.
help_camera = ():
    eye = pc.state.position + vec3(0, 10, 20); look = pc.state.position
    if sos.aboard and t - sos.climbed < DROP_OFF + help_swim_s:
        # (the swim: from behind the swimmer, toward the boat or the float they swim for)
        way = normalize(help_swim_to - help_in_water + vec3(0.0001, 0, 0))
        k = clamp((t - sos.climbed - DROP_OFF) / max(help_swim_s, 0.1), 0.0, 1.0)
        p = mix(help_in_water, help_swim_to, f32(k))
        eye = p - way * 9.0 + vec3(-way.z, 0, way.x) * 3.0 + vec3(0, 5, 0)
        look = p + way * 12.0 + vec3(0, 1, 0)
    else if sos.by == .wingman or sos.by == .pilot:
        c = help_carrier()
        if not c.0: return
        st = c.1
        f = forward(st)
        eye = st.position - f * 24.0 + vec3(0, 6, 0); look = st.position + f * 20.0
    else:
        k = vessel_index(vessels, sos.vessel)
        if k < 0: return
        v = vessels.ships[k]; spec = vessel_spec(v.kind)
        f = vec3(f32(sin(v.yaw)), 0, f32(cos(v.yaw))); side = vec3(f.z, 0, -f.x)
        seat = boat_deck_seat(v).0
        # (high on the quarter, down on the after deck and the line running aft: the boat's own
        # line, not the tow, which lags as she turns)
        eye = seat + side * f32(spec.beam * 0.5 + 8.0) + f * 6.0 + vec3(0, 9, 0)
        look = seat - f * 1.5
    free.pos = eye
    dir = normalize(look - eye)
    free.yaw = atan2(-f64(dir.x), -f64(dir.z)); free.pitch = asin(f64(dir.y))

# Flown back to the base in the wingman's second seat (the flight skipped): ashore by its mooring;
# the aircraft left on the sea brought in by the harbour's boat, patched up at a berth there.
help_carried_home = ():
    global sos
    i = combat_index(battle, sos.who)
    side = if i >= 0: battle.actors[i].side else: -1
    home = help_base(side)
    if i < 0 or home == none:
        sos.aboard = false; me.mode = .aboard; help_drop()
        return
    h = home!
    slot = h.dock + h.step * f32(max(0, battle.actors[i].pilot.home_turn))
    out_there = pc.state.position
    _ = assist_home(battle)
    # (a base at sea, the Ierax: her boat brings the aircraft to a mooring of hers)
    at_tender = h.place < 0 and h.name != ""
    place = if at_tender: -1 else: help_harbour(h.dock, 6000.0)
    dock = if at_tender: (tender_slot(max(0, tender_free_slot(others_at()))), h.heading) else: if place >= 0: help_dock(place, others_at()) else: none
    at = dock ?? (h.dock + h.step * 6.0, h.heading)
    fetch_aircraft(at.0, at.1)
    if at_tender:
        # (no quay there: back in one's own aircraft, the mechanics' work done)
        me.mode = .aboard
    else:
        me.mode = .walking
        step_ashore(slot)
        follow.placed = false
    # (the harbour's boat that fetched her in is paid for it, as a tow, or it is owed)
    fee = tow_fee(f64(length(vec3(out_there.x - at.0.x, 0, out_there.z - at.0.z))), true)
    payee = if at_tender: (if living_world.countries.len() > 1: living_world.countries[1].treasury_account else: -1) else: launches.harbour_account(living_world, place)
    paid = help_pay(living_world, payee, fee, "salvage", place)
    say_toast("Back at {sos.harbour_name}. {if at_tender: "Her" else: "The harbour's"} boat brought your aircraft in after, {phoenix_text(fee)}{if paid: "" else: ", owed"}; she is at the dock, patched up.")
    sos = HelpCall()

# A pilot of the world who could come down: flying a trip, not already helping, enough in the tank
# for what it is asked, nearest within PASSING_REACH (an index into traffic, -1 none).
help_traffic_pick = (at: vec3, cans: bool) -> int:
    best = -1; near = PASSING_REACH
    # (the cans out of its own tank and 20 litres left for its own way on; taking a pilot along, the 20)
    need_ml = if cans: CANS_ML + 18000 else: 20000
    loop k in 0..traffic.len():
        tr = traffic[k]
        if not tr.flying or not tr.materialized or tr.trip < 0 or tr.assist_stage != 0 or tr.state.on_water or tr.state.crashed: continue
        if tr.craft < 0 or tr.craft >= living_world.aircraft.len() or living_world.aircraft[tr.craft].fuel_ml < need_ml: continue
        d = f64(length(tr.state.position - at))
        if d < near: near = d; best = k
    best

# Where the passing pilot is bound (a town's index, -1 none).
help_pilot_bound = () -> int:
    k = help_traffic_index()
    if k < 0 or traffic[k].trip < 0 or traffic[k].trip >= living_world.trips.len(): return -1
    d = living_world.trips[traffic[k].trip].destination
    if d >= 0 and d < towns.len(): d else: -1

help_pilot_step = ():
    global sos
    k = help_traffic_index()
    if k < 0:
        if sos.stage==.done:help_drop()
        else:help_route_failed()
        return
    tr = traffic[k]
    first = split(sos.name, " ")[0]
    if sos.stage==.coming and sos.since>max(180.0,f64(sos.eta)*60.0):
        help_route_failed()
    else if sos.stage == .coming and tr.assist_stage == 1 and tr.assist_plan.phase == .done:
        traffic[k].assist_stage = 2; sos.stage = .alongside; sos.since = 0.0
        help_say(sos.name, if sos.need == .fuel: "Here. Two cans for you." else: "Here. Swim across to the float; I'll give you a hand up.")
    else if sos.stage == .alongside and sos.since > 4.0 and sos.need == .tow and not sos.aboard:
        help_board(help_carrier_seat().0)
    else if sos.stage == .alongside and sos.need == .tow and help_aboard_done():
        traffic_release_assist(tr, wind_now_vec()); traffic[k] = tr
        d = help_pilot_bound()
        sos.harbour_name = if d >= 0: SETTLEMENTS[d].name else: "the nearest harbour"
        sos.stage = .carrying; sos.since = 0.0
        help_say(sos.name, "In you get. I'm for {sos.harbour_name}; they'll fetch your aircraft in from there.")
    else if sos.stage == .carrying:
        if sos.since > 600.0: help_wait()
    else if sos.stage == .alongside and sos.since > 6.0 and sos.need == .fuel:
        me_craft = living_world.people[living_world.player].craft
        moved = help_cans(living_world, tr.craft, me_craft, CANS_ML)
        pc.state.fuel = f64(living_world.aircraft[me_craft].fuel_ml) / 1000.0
        litres = moved / 1000
        price = 0
        if let pier = refuel.fuel_pier_at(living_world, pc.state.position, 90000.0): price = refuel.fuel_price(living_world, pier) * moved / 10000
        to = if tr.person >= 0 and tr.person < living_world.people.len(): living_world.people[tr.person].account else: -1
        paid = help_pay(living_world, to, price, "cans", -1)
        help_say(sos.name, if paid or price == 0: "{litres} litres. Safe home." else: "{litres} litres. Pay me when you see me.")
        if price > 0: say_toast(if paid: "{phoenix_text(price)} to {first} for the fuel." else: "{phoenix_text(price)} owed to {first} for the fuel.")
        traffic_release_assist(tr, wind_now_vec()); traffic[k] = tr
        sos.stage = .done; sos.since = 0.0
    else if sos.stage == .done and (traffic[k].assist_stage == 0 or sos.since > 120.0):
        sos = HelpCall()

# Flown on with the passing pilot (the flight skipped): ashore at the town they were bound for; the
# aircraft left on the sea fetched in by that harbour's boat, patched up at a berth there, for a fee.
help_pilot_home = ():
    global pc, sos
    d = help_pilot_bound()
    out_there = pc.state.position
    if d < 0: d = max(0, town_here(pc.state.position))
    tw = towns[d]
    dock = free_dock(tw, others_at(), tw.docks[0]) ?? tw.docks[0]
    h = atan2(f64(tw.out.x), -f64(tw.out.y))
    pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, dock, h)
    pc.spec.player = true; pc.placed = false
    rope.tied = false
    tie_up()
    fee = tow_fee(f64(length(vec3(out_there.x - dock.x, 0, out_there.z - dock.z))), true)
    paid = help_pay(living_world, launches.harbour_account(living_world, d), fee, "salvage", d)
    me.mode = .walking
    step_ashore(dock)
    follow.placed = false
    say_toast("Flown on to {tw.name}. The harbour's boat brought your aircraft in after, {phoenix_text(fee)}{if paid: "" else: ", owed"}; she is at the dock, patched up.")
    sos = HelpCall()

# The card while help is on its way: who, and what to do meanwhile.
help_card = () -> str:
    if sos.by==.search and sos.stage==.coming:
        return "F  wait for a search boat ({help_eta_words(sos.eta)})"
    match sos.stage:
        .routing: "{capital(sos.name)} is putting out."
        .coming: if sos.need == .pickup: "{capital(sos.name)} is coming." else: "{capital(sos.name)} is coming.   Y  R/T"
        .alongside: "{capital(sos.name)} is alongside."
        .towing: if sos.aboard: "F  skip the tow to {sos.harbour_name}" else: "Under tow to {sos.harbour_name}.   Y  R/T"
        .carrying: if sos.need == .pickup: "F  skip the ride to {sos.harbour_name}" else: if help_carrier_up(): "F  skip the flight to {sos.harbour_name}" else: "In {sos.name}'s second seat."
        _: ""

# Stopped a while (seconds of it counted while near and slow).
help_still = 0.0
help_slow = (v: Vessel) -> bool:
    global help_still
    help_still = if v.speed < 0.2: help_still + 1.0 / 60.0 else: 0.0
    help_still > 8.0

# How fast the boat makes way just now, in this wind (m/s).
help_boat_speed = (id: int) -> f64:
    k = vessel_index(vessels, id)
    if k < 0: return 2.0
    max(0.6, vessel_target_speed(vessels.ships[k], wind_now.dir * f32(wind_now.speed)))

# Waiting for the boat (the pad's "Wait for them"): the clock runs on behind the dark card; it is
# found nearly there (coming: the last of the way seen) or in at the harbour (under tow).
help_wait = ():
    global sos_skip
    if sos.stage==.coming and (sos.by==.pilot or sos.by==.wingman):
        # The player can wait for a boat instead of sitting through the aircraft's whole approach.
        help_route_failed()
    if sos.by==.search and sos.stage==.coming:
        sos.stage=.done
        leisure_skip(sos.eta,"waiting for a search boat to {sos.harbour_name}",after=6)
        return
    if sos.need == .pickup and sos.stage == .carrying:
        k = vessel_index(vessels, sos.vessel)
        if k < 0: return
        v = vessels.ships[k]
        to = if sos.harbour == TENDER_PLACE: TENDER_AT else: help_harbour_at(sos.harbour)
        distance = max(lane_left(vessels, v), f64(length(v.position.xz - to.xz)))
        sos.stage = .done
        leisure_skip(help_minutes(distance, help_boat_speed(sos.vessel)), "taken to {sos.harbour_name}", after = 6)
        return
    if sos.by == .pilot and sos.stage == .carrying:
        k = help_traffic_index()
        if k < 0: return
        tr = traffic[k]
        d = help_pilot_bound()
        far = if d >= 0: f64(length(towns[d].center - tr.state.position)) else: 20000.0
        sos.stage = .done
        leisure_skip(max(5, int(far / max(tr.spec.cruise_speed * 0.8, 20.0) / 60.0) + 8), "flown on to {sos.harbour_name}", after = 9)
        return
    if sos.by == .wingman and sos.stage == .carrying:
        i = combat_index(battle, sos.who)
        if i < 0: return
        a = battle.actors[i]
        home = help_base(a.side)
        far = if let h = home: f64(length(h.dock - a.state.position)) else: 20000.0
        sos.stage = .done
        leisure_skip(max(5, int(far / max(a.spec.cruise_speed * 0.8, 20.0) / 60.0) + 8), "flown back to {sos.harbour_name}", after = 7)
        return
    if sos.by == .wingman or sos.stage == .none: return
    k = vessel_index(vessels, sos.vessel)
    if k < 0 or sos.stage == .routing:
        say_toast("They're still finding the way.")
        return
    lane=sea_lane_index(vessels,sos.lane)
    if lane<0 or vessels.lanes[lane].status!=.ready:
        say_toast("They're still finding the way.")
        return
    left = lane_left(vessels, vessels.ships[k])
    if sos.stage == .coming and left < SEEN_COMING + 20.0:
        say_toast("Nearly here.")
        return
    minutes = help_minutes(left, help_boat_speed(sos.vessel)) - 3
    if sos.stage == .coming:
        sos_skip = max(1, minutes)
        leisure_skip(sos_skip, "waiting for {sos.name}", after = 5)
    else if sos.stage == .towing:
        sos_skip = max(1, minutes) + 10
        sos.stage = .done
        leisure_skip(sos_skip, "under tow to {sos.harbour_name}", after = 6)

# (after a skipped wait: the boat on along its lane, the last 250 m of it left to be seen)
help_after_wait = ():
    lane_advance(vessels, sos.vessel, f64(sos_skip) * 60.0 * help_boat_speed(sos.vessel), SEEN_COMING)

# In at the harbour: warped in to a free berth and made fast, the tow paid (or owed), the boat gone
# about its business.
help_arrive = ():
    global pc, sos_tried, swim
    if sos.harbour < 0 and sos.harbour != TENDER_PLACE:
        help_route_failed()
        return
    taken = others_at()
    at_tender = sos.harbour == TENDER_PLACE
    # (at the Ierax: her first free mooring, lying fore and aft along her side)
    dock = if at_tender: (tender_slot(max(0, tender_free_slot(taken))), atan2(f64(tender_forward().x), -f64(tender_forward().z))) else: help_dock(sos.harbour, taken)
    if sos.by==.search and (dock==none or (not at_tender and shore_point(towns,dock!.0)==none)):
        sos.harbour=0; sos.harbour_name=home.name
        dock=(home.docks[0],along_quay); at_tender=false
    if dock == none or (not at_tender and shore_point(towns,dock!.0)==none):
        help_route_failed()
        return
    if sos.need == .pickup:
        # The harbour recovers the abandoned aircraft separately, as in the
        # existing carried-home help. The pilot is never put back in the wreck.
        fetch_aircraft(dock!.0, dock!.1)
        loop mut d in battle.descents:
            if d.person==living_world.player:d.released=true
        me.mode = .aboard
        if not at_tender:
            step_ashore(dock!.0)
            sync_walker_point()
        if at_tender: me.pos = pc.state.position
        follow.placed = false
        mouse_lock(false)
        say_toast("Picked up and brought safely to {sos.harbour_name}.")
        log_note(notebook, "Picked up after bailing out and brought to {sos.harbour_name}.", clock_text(living_world, living_world.minute))
        help_drop()
        return
    if sos.by==.search:
        if sos.need==.none:
            swim=Swim()
            step_ashore(dock!.0)
            sync_walker_point()
        else if sos.need==.tow or help_need(pc.state,pc.spec.fuel_capacity)==.tow or pc.spec.landplane or offshore_only(pc.kind):
            fetch_aircraft(dock!.0,dock!.1)
        else:
            moor(pc.state,vec3(dock!.0.x,f32(pc.spec.float_height),dock!.0.z),dock!.1)
            pc.placed=false
            tie_up()
        distance=f64(length(dock!.0.xz-sos.alongside.xz))
        fee=tow_fee(distance,true)
        paid=help_pay(living_world,launches.harbour_account(living_world,sos.harbour),fee,"search",sos.harbour)
        say_toast("Brought in to {sos.harbour_name}. {phoenix_text(fee)} for the search{if paid: "." else: ", owed."}")
        help_drop()
        return
    if pc.state.moored: unmoor(pc.state)
    if help_need(pc.state,pc.spec.fuel_capacity)==.tow:
        # (a wreck: patched up at the harbour, as the old tow home had it)
        fetch_aircraft(dock!.0,dock!.1)
    else:
        moor(pc.state, vec3(dock!.0.x, f32(pc.spec.float_height), dock!.0.z), dock!.1)
    rope.tied = false
    if not at_tender: tie_up()
    if sos.aboard:
        if at_tender:
            # (at the Ierax: no quay; back in one's own aircraft, at her mooring)
            me.mode = .aboard; pc.placed = false
        else:
            # (off the boat at the harbour, onto the quay by the aircraft)
            me.mode = .aboard
            step_ashore(dock!.0)
            follow.placed = false
    k = vessel_index(vessels, sos.vessel)
    distance = if k >= 0: f64(length(vessels.ships[k].position - pc.state.position)) else: 0.0
    fee = tow_fee(max(distance, 2000.0) + f64(sos.eta) * 60.0 * vessel_spec(sos.kind).speed * 0.5, sos.by == .launch)
    to = if sos.by == .ship and sos.who >= 0: living_world.far.vehicles[sos.who].account else: if at_tender: (if living_world.countries.len() > 1: living_world.countries[1].treasury_account else: -1) else: launches.harbour_account(living_world, sos.harbour)
    paid = help_pay(living_world, to, fee, "tow", sos.harbour)
    say_toast(if paid: "Brought in to {sos.harbour_name}. {phoenix_text(fee)} for the tow." else: "Brought in to {sos.harbour_name}. {phoenix_text(fee)} for the tow, owed.")
    sos_tried = []
    help_drop()

# AEGEAN_CAPTURE_COMPANY="frame [coaster]" (captures and checks, with AEGEAN_ABOARD=1): from that
# frame, once the far economy has coasters sailing in company (three or more under way within
# 60 m, as they put out a world minute apart), the aircraft is put down on the sea 110 m to one
# side of the nearest such group's track (or that coaster's group's) and 40 m ahead of its first,
# and a camera by the aircraft watches them sail past. COMPANY lines then say which coasters
# within 2 km have hulls and where, every time that changes (tests/far_transport_scene.jo: in
# company it must not).
# "frame coaster port": that coaster's port instead, before it sails: the aircraft down on the sea
# 600 m off the first 800 m of its route out and a camera 110 m up over it, to watch the port's
# sailings; a SAILING line for each coaster that puts out, with how far off the one before is.
company_capture = to_int(split(env("AEGEAN_CAPTURE_COMPANY") ?? "", " ")[0]) ?? -1
company_capture_wanted = if split(env("AEGEAN_CAPTURE_COMPANY") ?? "", " ").len() > 1: to_int(split(env("AEGEAN_CAPTURE_COMPANY") ?? "", " ")[1]) ?? -1 else: -1
company_capture_port = split(env("AEGEAN_CAPTURE_COMPANY") ?? "", " ").contains("port")
company_capture_lead = -1
company_capture_last = ""
company_capture_eye = vec3(0, 0, 0)
company_capture_look = vec3(0, 0, 0)
company_capture_out: int[]             # (the coasters seen putting out, in order)
company_capture_step = ():
    global pc, judge_camera, judge_origin, company_capture_lead, company_capture_last, company_capture_eye, company_capture_look, company_capture_out
    if frame_number() < company_capture or not living_world.far.populated: return
    if company_capture_port:
        if company_capture_wanted < 0 or company_capture_wanted >= living_world.far.vehicles.len(): return
        ship = living_world.far.vehicles[company_capture_wanted]
        if company_capture_lead < 0:
            if ship.place < 0 or ship.route < 0: return
            link = living_world.far.links[ship.route]
            # (800 m out along its route: the way the port's sailings go)
            out = if ship.place == link.a: link.points[0] else: link.points[link.points.len() - 1]
            loop k in 0..link.points.len():
                q = link.points[if ship.place == link.a: k else: link.points.len() - 1 - k]
                if f64(length(q - ship.pos)) > 800.0:
                    out = mix(out, q, f32(clamp((800.0 - f64(length(out - ship.pos))) / max(1.0, f64(length(q - out))), 0.0, 1.0)))
                    break
                out = q
            way = normalize(vec3(out.x - ship.pos.x, 0, out.z - ship.pos.z) + vec3(0.001, 0, 0)); side = vec3(way.z, 0, -way.x)
            mid = (ship.pos + out) * 0.5
            at = mid + side * 600.0
            if surface_height(f64(at.x), f64(at.z)) > -2.0: at = mid - side * 600.0
            pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, vec3(at.x, 0, at.z), 0.0)
            pc.spec.player = true
            unmoor(pc.state); rope.tied = false
            company_capture_lead = company_capture_wanted
            company_capture_eye = vec3(at.x, 110, at.z) + normalize(at - mid) * 60.0; company_capture_look = vec3(mid.x, 0, mid.z)
            judge_origin = pc.state.position
            print("COMPANY frame {frame_number()} minute {living_world.minute}: off the port of coaster {ship.id} (place {ship.place}) at {ship.pos.x:.0},{ship.pos.z:.0}")
            return
        judge_camera = JudgeView(company_capture_eye, company_capture_look, "a port's sailings")
        loop v in living_world.far.vehicles:
            if v.kind != .ship or v.journey < 0 or v.id in company_capture_out or not (v.journey in living_world.far.journeys): continue
            j = living_world.far.journeys[v.journey]
            if f64(length(v.pos - company_capture_look)) > 1500.0 or j.departed_tick < living_world.tick - 240: continue
            before = if company_capture_out.len() > 0: "{f64(length(living_world.far.vehicles[company_capture_out[company_capture_out.len() - 1]].pos - v.pos)):.0} m astern of coaster {company_capture_out[company_capture_out.len() - 1]}" else: "the first"
            company_capture_out.push(v.id)
            print("SAILING frame {frame_number()} minute {living_world.minute}: coaster {v.id} put out from place {j.origin}, {before}")
    if company_capture_lead < 0:
        best = -1; best_d = 1e12
        loop v in living_world.far.vehicles:
            if v.kind != .ship or v.journey < 0 or v.hull <= 0 or length(v.velocity) < 1.0: continue
            beside = 0; first = true
            loop o in living_world.far.vehicles:
                if o.id == v.id or o.kind != .ship or o.journey < 0 or length(o.velocity) < 1.0 or length(o.pos - v.pos) > 60.0: continue
                beside += 1
                if dot(o.pos - v.pos, v.velocity) > 0: first = false
            d = f64(length(v.pos - pc.state.position))
            if company_capture_wanted >= 0: d = f64(length(v.pos - living_world.far.vehicles[min(company_capture_wanted, living_world.far.vehicles.len() - 1)].pos))
            if beside >= 2 and first and d < best_d: best = v.id; best_d = d
        if best < 0: return
        lead = living_world.far.vehicles[best]
        way = normalize(vec3(lead.velocity.x, 0, lead.velocity.z)); side = vec3(way.z, 0, -way.x)
        at = lead.pos + way * 40.0 + side * 110.0
        if surface_height(f64(at.x), f64(at.z)) > -2.0: at = lead.pos + way * 40.0 - side * 110.0
        pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, vec3(at.x, 0, at.z), atan2(-f64(side.x), f64(side.z)))
        pc.spec.player = true
        unmoor(pc.state); rope.tied = false
        company_capture_lead = best
        print("COMPANY frame {frame_number()} minute {living_world.minute}: down on the sea beside coaster {best} at {lead.pos.x:.0},{lead.pos.z:.0}, {best_d:.0} m from where the aircraft was")
        return
    lead = living_world.far.vehicles[company_capture_lead]
    if not company_capture_port:
        judge_origin = pc.state.position
        judge_camera = JudgeView(pc.state.position + vec3(0, 7, 0) + normalize(pc.state.position - lead.pos) * 14.0, lead.pos - normalize(vec3(lead.velocity.x, 0, lead.velocity.z) + vec3(0.001, 0, 0)) * 20.0 + vec3(0, 6, 0), "coasters in company")
    ships = if vessel_view.drawn.len() == vessels.ships.len(): vessel_view.drawn else: vessels.ships
    words: str[]; where: str[]
    loop ship in ships:
        id = ship.id - FAR_VESSEL_BASE
        if id < 0 or id >= 2048 or f64(length(ship.position - pc.state.position)) > 2000.0: continue
        words.push("{id}"); where.push("{id}@{ship.position.x:.0},{ship.position.z:.0}")
    words.sort()
    text = words.join(" ")
    if text != company_capture_last:
        company_capture_last = text
        print("COMPANY frame {frame_number()} minute {living_world.minute}: coasters with hulls [{text}] {where.join(" ")}")

# AEGEAN_CAPTURE_HELP=tow|wreck|flare (captures and checks): at frame 30 the aircraft is put down
# 3 km off the home harbour, its tank dry (wreck: wrecked; flare: and the R/T out of reach is not
# staged, the flare only fired); at frame 60 help is called; each wait is skipped once the boat is
# under way (AEGEAN_CAPTURE_HELP_SEE=1: the coming seen, not skipped). HELP lines say what happened;
# a camera off the aircraft looks at the boat.
help_capture = env("AEGEAN_CAPTURE_HELP") ?? ""
help_capture_was = HelpStage.none
help_capture_waited = HelpStage.none
help_capture_at = vec3(0, 0, 0)
help_capture_start = 30               # (passing|passwreck: when a world aircraft is up, its frame)
help_capture_step = ():
    global pc, judge_camera, judge_origin, help_capture_was, help_capture_waited, help_capture_start, help_capture_at
    f = frame_number()
    passing = help_capture == "passing" or help_capture == "passwreck"
    if passing and help_capture_start == 30:
        # (down on the sea three kilometres ahead of the first of the world's aircraft seen flying)
        help_capture_start = -1
    if passing and help_capture_start < 0:
        loop tr in traffic:
            if help_capture_start < 0 and tr.flying and tr.materialized and not tr.state.on_water and tr.trip >= 0:
                way = vec3(tr.state.velocity.x, 0, tr.state.velocity.z)
                if length(way) < 1: continue
                loop d in [3000.0, 2000.0, 4000.0, 1500.0]:
                    q = tr.state.position + normalize(way) * f32(d)
                    if help_capture_start < 0 and surface_height(f64(q.x), f64(q.z)) < -3.0:
                        help_capture_start = f; help_capture_at = vec3(q.x, 0, q.z)
                        print("HELP passing: {tr.name} ({living_world.people[max(0, tr.person)].name}) at {tr.state.position}, the aircraft put down {d:.0} m ahead of it")
        if help_capture_start < 0: return
    if f == help_capture_start:
        out = vec3(home.out.x, 0, home.out.y)
        # (cans: the strait, down on the sea under the flight, where the aircraft was)
        at = if passing: help_capture_at else: if help_capture == "cans" or help_capture == "wingwreck": pc.state.position else: if help_capture == "tender": TENDER_AT + tender_port() * 4000.0 else: home.docks[0] + out * 3000.0
        pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, vec3(at.x, 0, at.z), along_quay)
        pc.spec.player = true
        unmoor(pc.state); rope.tied = false
        c = living_world.people[living_world.player].craft
        debug_fuel_ml(c, 300); pc.state.fuel = 0.3
        if help_capture == "wreck" or help_capture == "wingwreck" or help_capture == "passwreck": pc.state.crashed = true
        print("HELP staged at {at.x:.0},{at.z:.0}: need {help_need_now()}, in reach {help_in_reach()}, purse {player_cents()}")
    if f == help_capture_start + 30:
        if passing:
            loop tr in traffic:
                if tr.flying: print("HELP traffic {tr.name}: materialized {tr.materialized} trip {tr.trip} on water {tr.state.on_water} assist {tr.assist_stage} fuel {if tr.craft >= 0: living_world.aircraft[tr.craft].fuel_ml else: -1} ml, {length(tr.state.position - pc.state.position):.0} m off")
        help_call(help_capture == "flare")
        print("HELP called: {sos.stage} by {sos.by}, {sos.name}, told {help_eta_words(sos.eta)}, tow to {sos.harbour_name}; toast '{toast}'")
    if sos.stage != help_capture_was:
        print("HELP frame {f}: {help_capture_was} -> {sos.stage} ({sos.since:.1} s); aircraft at {pc.state.position.x:.0},{pc.state.position.z:.0} moored {pc.state.moored} fuel {pc.state.fuel:.1} crashed {pc.state.crashed}; mode {me.mode} aboard {sos.aboard} me {me.pos.x:.0},{me.pos.z:.0}; purse {player_cents()}; toast '{toast}'")
        help_capture_was = sos.stage
    if sos.stage != help_capture_waited and not skip.active:
        if (sos.stage == .coming and sos.since > 2.0 and env("AEGEAN_CAPTURE_HELP_SEE") == none) or (sos.stage == .towing and sos.since > 6.0) or (sos.stage == .carrying and sos.since > 15.0 and help_carrier_up()):
            help_capture_waited = sos.stage
            help_wait()
    k = vessel_index(vessels, sos.vessel)
    # (the pilot taken off: the ride's own camera)
    if sos.aboard:
        judge_camera = none
    else if k >= 0:
        boat = vessels.ships[k]
        if f % 120 == 0: print("HELP frame {f}: boat {boat.status} at {boat.position.x:.0},{boat.position.z:.0}, {length(boat.position - pc.state.position):.0} m from the aircraft, lane {lane_left(vessels, boat):.0} m left")
        side = normalize(vec3(boat.position.x - pc.state.position.x, 0, boat.position.z - pc.state.position.z) + vec3(0.001, 0, 0))
        across = vec3(-side.z, 0, side.x)
        judge_origin = pc.state.position
        judge_camera = JudgeView(pc.state.position - side * 22.0 + across * 14.0 + vec3(0, 9, 0), mix(pc.state.position, boat.position, 0.6) + vec3(0, 2, 0), "help coming")
    if skip.active and f % 30 == 0: print("HELP frame {f}: skipping, {skip.left} minutes left of {skip.total}")

# A flare: up from the aircraft, a red star hanging and falling (drawn while it burns).
help_flare_at = vec3(0, 0, 0)
help_flare_t = -100.0
help_flare = (at: vec3):
    global help_flare_at, help_flare_t
    help_flare_at = at; help_flare_t = t

draw_help_flare = (L: Light):
    age = t - help_flare_t
    if age < 0.0 or age > 14.0: return
    up = if age < 3.0: 160.0 * (1.0 - (1.0 - age / 3.0) * (1.0 - age / 3.0)) else: 160.0 - (age - 3.0) * 6.0
    p = help_flare_at + vec3(f32((age) * 1.5), f32(up), 0)
    lamps = WorldParticles()
    nav_lamp(lamps, world_point(p), vec3(1.0, 0.22, 0.10) * f32(if age > 12.0: (14.0 - age) * 0.5 else: 1.0), scene_camera(), 1.0, L.fog_density)
    draw_curved_particles(lamps, true)

# Inland at a harbour: away from the sea as the nearest harbour town faces it (none: no town near).
harbour_inland = (p: vec3) -> vec3?:
    best = -1; near = 2500.0
    ws = settlement_registry.world_settlements
    loop i in 0..ws.len():
        s = ws[i]
        if s.harbor.len() == 0: continue
        d = f64(length(s.center.xz - p.xz))
        if d < near: near = d; best = i
    if best < 0: return none
    o = ws[best].out
    if length(o) < 0.01: return none
    vec3(-o.x, 0, -o.y)

do_rescue = (free: bool = false):
    now = clock_text(living_world, living_world.minute)
    if rescue_act == 1:
        name = rescue_name
        n = living.board_survivors(living_world, rescue_id, living_world.player)
        if n <= 0:
            say_toast("Come right alongside and stop, with room aboard.")
            return
        rescue_card(rescue, if n == 1: "{name} is aboard" else: "{n} survivors aboard", ["Moor at a harbour to set them ashore."], t)
        log_note(notebook, "Took {name} aboard from the water.", now)
        # (what the pilot did today, for his small talk: src/pilot_talk.jo)
        pilot_did(living_world.pilot_day, Doing(.rescued, living_world.minute))
        sv = living_world.war.survivors[rescue_id]
        if sv.person >= 0: rider_takes(sv.person, sv.at + vec3(0, -1.2, 0))
    else if rescue_act == 2:
        s = living_world.war.survivors[rescue_id]
        name = rescue_name
        before = living.national_regard(living_world, s.country, living_world.player)
        n = living.land_survivors(living_world, rescue_id, rescue_place, living_world.player)
        if n <= 0:
            say_toast("They can't go ashore here.")
            return
        after = living.national_regard(living_world, s.country, living_world.player)
        country = living_world.countries[s.country].name
        place = harbour_name(living_world, rescue_place)
        held = rescue_hold and not free
        if s.person >= 0:
            # (they climb out onto the quay beside the pilot and walk off into the town)
            if rider.person == s.person and (rider.stage == .aboard or rider.stage == .boarding):
                seat = pc.state.position + quat_rotate(pc.state.orientation, rider_seat(ride_seat(player_model()), rider.on_wing, pc.spec.span))
                # (into the town: away from the sea as the harbour lies, not along the quay)
                inland = harbour_inland(me.pos) ?? (me.pos - pc.state.position)
                across = me.pos - pc.state.position
                side = normalize(vec3(-across.z, 0, across.x) + vec3(0.0001, 0, 0))
                rider_alight(rider, seat, me.pos + side * 1.2, inland, t)
            words = rescue_words(living_world, name, s.country, rescue_place, place, held, s.person)
            rescue_card(rescue, words.title, words.lines + ["Standing with {country}: {before} to {after}"], t)
            rescue.card_until = t + 11.0
            rescue_deeds(living_world, s.person, s.country, rescue_place, held, [])
            log_note(notebook, "{words.title}. {join(words.lines, " ")} Standing with {country} {before} to {after}.", now)
        else:
            rescue_card(rescue, "Ashore at {place}", [if n == 1: "{name}, rescued" else: "{n} survivors, rescued", "Standing with {country}: {before} to {after}"], t)
            log_note(notebook, "Set {name} ashore at {place}. Standing with {country} {before} to {after}.", now)
            # (what the pilot did today, for his small talk: src/pilot_talk.jo)
            pilot_did(living_world.pilot_day, Doing(.set_ashore, living_world.minute))


# AEGEAN_CAPTURE_MAPS=counter|office|reward|bought|prompt opens a Porto Vecchio map counter (reward: the
# chandler's promised sheet, its errand marked done; bought: one sheet bought first, for the card;
# prompt: the player stood at the chandlery's counter instead)
# and AEGEAN_CAPTURE_RESCUE=mark|pickup|aboard|ashore|landed|papers stages a downed pilot near the player
# (mark: a kilometre out from the aircraft on the water; pickup/aboard: beside it there;
# ashore/landed: already aboard the moored aircraft; papers: landed, then the notebook open).
# Captures only.
capture_maps = env("AEGEAN_CAPTURE_MAPS")
capture_rescue = env("AEGEAN_CAPTURE_RESCUE")
# AEGEAN_CAPTURE_ADRIFT=heard|search|alongside|home stages Petros's boat adrift off Porto Vecchio
# with its engine gone (src/living_adrift.jo). heard: two hours on, at the hotel's bar, whoever
# sits by him tells of it (with AEGEAN_COMPANY, AEGEAN_LEADS=always); search: in the air 1.5 km
# off it, flying toward it (with AEGEAN_FLYING); alongside: on the water beside it, Petros taken
# aboard a moment later; home: moored at home with Petros aboard, set ashore a moment later.
capture_adrift = env("AEGEAN_CAPTURE_ADRIFT")
capture_racelead = env("AEGEAN_CAPTURE_RACELEAD") ?? ""
# AEGEAN_CAPTURE_ERRAND=offer|arrive|handover: the mail bag out of Porto Vecchio, from offer to
# thanks (src/errands.jo; captures). The world run on to the next morning the office makes up a bag
# for an island. offer: on foot by the postmaster; asked for work, he asks it; taken a moment later.
# arrive: on the way over, in the air 1.3 km off the island's pier, heading in (with AEGEAN_FLYING).
# handover: taken, loaded and flown, moored at its dock, the pilot on the dock and the postmaster come
# down from the town, who is walked up to and handed it.
capture_errand = env("AEGEAN_CAPTURE_ERRAND") ?? ""
errand_stage_frame = -1
errand_cap_job = -1
errand_cap_folk = -1
adrift_stage_frame = -1
adrift_ask_due = -1.0
# (launch: the camera on the launch putting out; at 420 frames the long way out skipped to the last
# of it, seen coming alongside and taking the line; once towing a while, the way in skipped to
# the last of it, seen berthing with the boat astern)
adrift_launch_skipped = 0
adrift_launch_capture = (wait: int):
    global judge_camera, adrift_launch_skipped
    k = vessel_index(vessels, adrift_help.vessel)
    if k < 0: return
    v = vessels.ships[k]
    if wait == 420 and adrift_help.stage == .coming and adrift_launch_skipped == 0:
        lane_advance(vessels, adrift_help.vessel, 1e9, 30.0); adrift_launch_skipped = 1
        print("ADRIFT launch: skipped out")
    if adrift_help.stage == .towing and adrift_help.since > 10.0 and adrift_launch_skipped == 1:
        lane_advance(vessels, adrift_help.vessel, 1e9, 28.0); adrift_launch_skipped = 2
        adrift_help.tow_at = tow_place(vessels.ships[k], ADRIFT_TOW_LINE).0
        print("ADRIFT launch: skipped in")
    if wait % 300 == 0: print("ADRIFT launch: frame {wait} stage {adrift_help.stage} at {v.position} status {v.status} boat {living_world.adrift[max(0, adrift_index(living_world, adrift_help.trip))].at}")
    v = vessels.ships[vessel_index(vessels, adrift_help.vessel)]
    fwd = vec3(f32(sin(v.yaw)), 0, f32(cos(v.yaw)))
    side = vec3(fwd.z, 0, -fwd.x)
    boat = living_world.adrift[max(0, adrift_index(living_world, adrift_help.trip))].at
    # (the launch putting out, seen from the dock's end; then both boats, the launch and the one it
    # comes for, or tows, between them)
    look = if adrift_launch_skipped == 0: v.position else: (v.position + boat) * 0.5
    span = if adrift_launch_skipped == 0: 30.0 else: max(20.0, f64(length(v.position - boat)) * 0.7 + 10.0)
    judge_camera = JudgeView(look + side * f32(span) - fwd * f32(span * 0.5) + vec3(0, f32(span * 0.3), 0), look + vec3(0, 1.5, 0), "the launch")

stage_capture_adrift = (stage: str):
    global adrift_stage_frame
    if adrift_stage_frame < 0:
        if frame_number() < 3: return
        adrift_stage_frame = frame_number()
        skipper = 7
        trip = living_world.people[skipper].trip
        if trip < 0 or living_world.trips[trip].reason.purpose != .fishing: trip = workboats_api.begin_fishing(living_world, skipper)
        i = if trip >= 0: adrift_begin(living_world, trip, if stage == "launch": AdriftCause.mast else: AdriftCause.engine) else: -1
        print("ADRIFT staged: trip {trip} boat {i} at {if i >= 0: living_world.adrift[i].at else: vec3(0,0,0)}")
        if i < 0: return
        a = living_world.adrift[i]
        if stage == "heard":
            living.advance_minutes(living_world, 110)
            sync_folk(folks, living_world, towns)
            global hour
            hour = f64(lt.local_minute(living_world.minute)) / 60.0
            # (whoever is near in the town who has heard: he's stopped to talk to them)
            best = -1; bd = 1e9
            loop k in 0..folks.len():
                q = folks[k].person
                if not folks[k].shown or q == skipper or q == living_world.player or band_wanted(living_world, q) > 0: continue
                knows = false
                loop l in leads_for(living_world, q, []):
                    if l.kind == .overdue: knows = true
                d = f64(length(folks[k].pos - me.pos))
                if knows and d < bd: bd = d; best = k
            if best >= 0:
                fp = folks[best].pos
                away = normalize(vec3(me.pos.x - fp.x, 0, me.pos.z - fp.z) + vec3(0.0001, 0, 0))
                me.mode = .walking
                me.pos = vec3(fp.x + away.x * 1.6, f32(walk_height(towns, f64(fp.x + away.x * 1.6), f64(fp.z + away.z * 1.6))), fp.z + away.z * 1.6)
                me.yaw = atan2(f64(-away.x), f64(-away.z)); me.stride = 0.0
                follow.yaw = me.yaw + PI + 0.7; follow.distance = 3.6; follow.pitch = 0.2; follow.height = 1.5; follow.placed = false
                global rep_ask_k, rep_talk_due, adrift_ask_due
                rep_ask_k = best; rep_talk_due = t + 1.5; adrift_ask_due = t + 4.5
                print("ADRIFT heard from {living_world.people[folks[best].person].name}")
        else if stage == "search":
            to = normalize(vec3(a.at.x - pc.state.position.x, 0, a.at.z - pc.state.position.z) + vec3(0.0001, 0, 0))
            h = atan2(f64(to.x), -f64(to.z))
            start = a.at - to * 1100.0 + vec3(-to.z, 0, to.x) * 60.0
            spd = f64(length(pc.state.velocity))
            pc.state.position = vec3(start.x, f32(110.0), start.z)
            pc.state.velocity = heading_vector(h) * f32(spd)
            pc.state.orientation = quat_euler(0, -h, 0)
            pc.aim_heading = h; pc.placed = false
        else if stage == "alongside":
            out = normalize(vec3(a.at.x - home.docks[0].x, 0, a.at.z - home.docks[0].z) + vec3(0.0001, 0, 0))
            p0 = a.at - out * 26.0 + vec3(-out.z, 0, out.x) * 9.0
            h = atan2(f64(out.x), -f64(out.z))
            pc.state = CraftState(position = vec3(p0.x, f32(pc.spec.float_height), p0.z), orientation = quat_euler(0, -h, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, on_water = true)
            pc.throttle = 0.0
            me.mode = .aboard
            follow.yaw = h + PI + 0.35; follow.distance = 20.0; follow.pitch = 0.16
        else if stage == "launch":
            # (found, and the harbour told: the launch puts out from its berth)
            adrift_found(living_world, i)
            given = adrift_help_start(adrift_help, vessels, living_world, i, -1, _help_wind())
            minutes = adrift_report(living_world, i, given)
            print("ADRIFT launch: given {given} minutes {minutes} by {adrift_help.name}")
        else if stage == "home":
            _ = adrift_take_aboard(living_world, i)
            global rider, rider_fig
            rider = rider_seated(skipper, t, false)
            p = living_world.people[skipper]
            rider_fig = build_figure(dress_of(p.occupation), p.appearance_seed, age = p.age, woman = person_woman(p.name))
        return
    wait = frame_number() - adrift_stage_frame
    # (heard: in the talk, he asks what they've heard)
    if stage == "heard" and adrift_ask_due >= 0.0 and t >= adrift_ask_due and ui == .talk:
        global adrift_ask_due, ui_line, ui_turn
        adrift_ask_due = -1.0
        ui_turn = living.talk(living_world, folks[ui_folk].person, .news, living_world.player)
        said = tell_lead(folks[ui_folk].person)
        ui_line = if said != "": said else: turn_text(ui_turn)
        print("ADRIFT told: {ui_line}")
    if stage == "alongside" and wait == 200 and adrift_k >= 0: adrift_take()
    if stage == "launch": adrift_launch_capture(wait)
    if stage == "home" and wait == 150 and adrift_ashore_k >= 0: adrift_ashore()
capture_stage_frame = -1
stage_capture_maps = (stage: str):
    shop = if stage == "office": "porto-office" else: "porto-chandler"
    if stage == "reward":
        loop job, _ in living_world.maps.rewards:
            living_world.jobs[job].carrier = living_world.player
            living_world.jobs[job].state = .delivered
    if stage == "bought":
        rows = map_counter_rows(living_world, shop, living_world.player)
        if rows.len() > 1: _ = living.buy_map(living_world, rows[1].copy, living_world.player)
    if stage == "prompt":
        at = living_world.maps.shops[shop].pos
        me.pos = vec3(at.x, f32(walk_height(towns, f64(at.x), f64(at.z))), at.z)
        follow.placed = false
        portage.cargo_person_pose(living_world, living_world.player, me.pos)
        loop c in living.nearby_map_finds(living_world, living_world.player): _ = living.find_map(living_world, c.id, living_world.player)
        return
    open_map_counter(shop)

stage_capture_rescue = (stage: str):
    global capture_stage_frame
    if capture_stage_frame < 0:
        if not living_world.far.populated: return
        craft = living_world.people[living_world.player].craft
        if stage == "pickup" or stage == "aboard" or stage == "mark":
            out = vec3(home.out.x, 0, home.out.y)
            p0 = home.docks[0] + out * 140.0
            pc.state = CraftState(position = vec3(p0.x, f32(pc.spec.float_height), p0.z), orientation = quat_euler(0, -along_quay, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, on_water = true)
            pc.throttle = 0.0
            me.mode = .aboard
            _ = stage_rescue_survivor(living_world, p0 + out * (if stage == "mark": 1100.0 else: 14.0) + vec3(-out.z, 0, out.x) * (if stage == "mark": 250.0 else: 0.0))
        else:
            id = stage_rescue_survivor(living_world, living_world.aircraft[craft].pose.pos + vec3(2, 0, 0))
            if id >= 0: _ = living.board_survivors(living_world, id, living_world.player)
        capture_stage_frame = frame_number()
        return
    wait = frame_number() - capture_stage_frame
    if (stage == "aboard" or stage == "landed" or stage == "papers") and wait == 40 and rescue_act != 0: do_rescue()
    # (AEGEAN_CAPTURE_RESCUE_CAM: a camera on the rescued pilot: off the aircraft's side at the second
    # seat while they climb in and ride, then after them on the quay as they walk off)
    if env("AEGEAN_CAPTURE_RESCUE_CAM") != none:
        global judge_camera, judge_origin
        side = quat_rotate(pc.state.orientation, vec3(1, 0, 0)); fwd = forward(pc.state)
        seat = pc.state.position + quat_rotate(pc.state.orientation, rider_seat(ride_seat(player_model()), rider.on_wing, pc.spec.span))
        judge_origin = pc.state.position
        if rider.stage == .walking or rider.stage == .alighting:
            away = rider.away
            judge_camera = JudgeView(rider.pos - away * 9.0 + vec3(-away.z, 0, away.x) * 4.0 + vec3(0, 3.2, 0), rider.pos + away * 3.0 + vec3(0, 1.2, 0), "the rescued pilot walking off")
        else:
            judge_camera = JudgeView(seat - fwd * 9.0 + side * 6.0 + vec3(0, 3.2, 0), seat + fwd * 4.0 - vec3(0, 0.8, 0), "the rescued pilot")
    if stage == "papers" and wait == 60:
        notebook.open = true
        notebook.fresh = true

# A world minute may spread over a few frames (living_scene.scene_clock_end_spread). While it
# is in progress (world_held) the frame's other World writers wait their turn, and a frame
# with input, a menu or the pause screen finishes it first (a save or load to apply waits for
# it instead, process_game_saves): nothing else
# touches the World between its pieces, so it is the same minute as all at once.
MINUTE_FRAME_MS = 4.0
WORLD_ACTION_KEYS: Key[] = [.f,.t,.r,.m,.g,.x,.b,.v,.p,.j,.c,.e,.h,.q,.enter,.escape,.tab,.comma,.period,.slash,.page_up,.page_down,.up,.down,.space,.f1,.f2,.f9,.n1,.n2]
# The rain's, the windscreen rain's and the lightning's shaders, left out of the warm-ups (most
# flights see no weather), queued once a look a second finds rain or a storm within 12 km: they
# link one a frame in play (update), well before the first drop or strike is drawn.
weather_shaders_queued = false
weather_shaders_look = 0.0
weather_shaders_near = (p: vec3):
    global weather_shaders_queued, weather_shaders_look
    if weather_shaders_queued or not weather_active or t < weather_shaders_look: return
    weather_shaders_look = t + 1.0
    near = false
    loop d in [vec3(0,0,0),vec3(12000,0,0),vec3(-12000,0,0),vec3(0,0,12000),vec3(0,0,-12000)]:
        a = weather_at_point(p + d)
        if a.rain > 0.0 or a.storm > 0.0: near = true
    if not near: return
    weather_shaders_queued = true
    warm_up_later(rain_sh); warm_up_later(bolt_sh); warm_up_later(screen_rain_sh)

world_held = () -> bool: traffic_scene.holding or traffic_scene.held_ticks > 0
world_input_this_frame = () -> bool:
    if pad.pressed.len()>0 or mouse_pressed(.left) or mouse_pressed(.right) or text_input()!="": return true
    loop k in WORLD_ACTION_KEYS:
        if key_pressed(k): return true
    false

# A frame's update, then (after everything that frame did) a slice of any save in progress.
# ---------------- what can be done here, and with which key ----------------
# Every action open to the pilot at once is offered, each on a card of its own, stacked: the
# first that wants F has it, one more that wants F takes R; T talks and G works on the aircraft
# as ever. The cards and the keys come from the same list, so what a card says is what its key
# (or, on a touch screen, a finger on the card) does.

struct Offer:
    key: Key
    words: str                      # "climb aboard your Gull" (the card puts the key before it)
    act: str
    hold = false                    # (held down, not pressed: "hold F  haul in the line")

offer_key_name = (k: Key) -> str:
    match k:
        .f: "F"
        .r: "R"
        .g: "G"
        .t: "T"
        .k: "K"
        .l: "L"
        .x: "X"
        .b: "B"
        _: "?"

offer_card = (o: Offer) -> str: (if o.hold: "hold " else: "") + "{offer_key_name(o.key)}  {o.words}"

# (a prompt's own words, without the key the old single card put before them)
offer_words = (s: str) -> str:
    t = s
    loop prefix in ["hold F  ", "F  "]:
        if t.starts_with(prefix): t = t[prefix.len()..t.len()]
    t

# Every offer stays reachable: its own key if it is free, else the next free one of the offer
# keys (F, R, G, T, K, L, X; its card names the key it got). None is dropped (a third offer on F,
# or a second on G, once was). On a touch screen each card is its own button and a controller
# chooses them in order, whatever their keys.
OFFER_KEYS: Key[] = [.f, .r, .g, .t, .k, .l, .x]
offer_add = (o: mut Offer[], act: str, words: str, key: Key = .f, hold: bool = false):
    if words == "": return
    used = [loop e in o: e.key]
    taken = (k: Key) -> bool: used.contains(k)
    k = key
    if taken(k):
        loop c in OFFER_KEYS:
            if not taken(c):
                k = c
                break
    if taken(k): return                 # (seven at once: there is no key left)
    o.push(Offer(k, words, act, hold))

# Legacy islands use negative settlement region IDs, newer islands have IDs from 32.
shore_region = (at:vec3) -> int:
    k=island_at(f64(at.x),f64(at.z))
    if k>=0:return -1-k
    land_region_at(f64(at.x),f64(at.z))

shore_help_region = -10000
shore_help_generation = -1
shore_help_has_port = false
isolated_shore = () -> bool:
    global shore_help_region,shore_help_generation,shore_help_has_port
    r=shore_region(me.pos)
    if r>=0 and r<32:return false
    if r!=shore_help_region or shore_help_generation!=settlement_registry.settlement_generation:
        shore_help_region=r;shore_help_generation=settlement_registry.settlement_generation
        shore_help_has_port=false
        loop s in settlement_registry.world_settlements:
            if s.region==r and s.harbor.len()>0:shore_help_has_port=true;break
    if shore_help_has_port:return false
    st=pc.state
    if near_own_craft() and not help_wreck():return false
    if pc.spec.landplane and st.on_ground and not help_wreck():return shore_region(st.position)!=r
    true

hotel_desk_shut = () -> bool:
    hotel.ok and length(me.pos-hotel.desk)<2.8 and not hotel_room_paid() and not leisure_open(living_world,hotel_place)

# on foot (the baths, once in them, keep their own keys: F an hour, T till evening, R leave)
walk_offers = () -> Offer[]:
    o: Offer[]
    if me.mode != .walking or ui != .none or skip.active or presentation.thermal.active or paused or show_chart or notebook.open: return o
    # (lying back, the stars' own card has the keys; in the water, only climbing out)
    if gaze.active: return o
    if sos.by==.search:return o
    if swim.active:
        if swim.diving < 0.0 and swim_climb_out(me.pos, swim_ground, swim_level) != none: offer_add(o, "swim-out", "climb out onto the dock")
        return o
    held = holding_cargo() >= 0
    busy = fish_hands_busy()
    if not held and not busy and near_thermal().0 >= 0:
        nearby = near_thermal(); reserved = presentation.thermal.paid_place == THERMAL_SITES[nearby.0].place and presentation.thermal.paid_until > living_world.minute
        # (the pool in view is its own card: tapped, or F)
        pool_seen = not nearby.1 and not ctl.used and _on_screen(thermal_pool(THERMAL_SITES[nearby.0]))
        if not pool_seen: offer_add(o, "thermal", if not nearby.1: "take the waters" else: if reserved: "return to your room until morning" else: "stay at the inn until morning — {phoenix_text(thermal_life.THERMAL_INN_CENTS)}")
    if held:
        point = portage.cargo_loading_spot(living_world,living_world.people[living_world.player].craft)
        offer_add(o, "cargo", if point != none and length(me.pos-point!) < 4: "put the crate into the hold" else: "put down or hand over the crate")
    else if near_job_cargo() >= 0 and not fish_in_hand(fish) and not handover_waited(living_world.cargo[near_job_cargo()].job): offer_add(o, "cargo", "pick up {cargo_view.cargo_label(living_world,living_world.cargo[near_job_cargo()])}")
    if rescue_act == 2: offer_add(o, "rescue", offer_words(rescue_prompt()))
    if rescue_act == 2 and rescue_hold: offer_add(o, "rescue-free", "let {rescue_name} go ashore free")
    if adrift_ashore_k >= 0: offer_add(o, "adrift-ashore", "help {_first_name(living_world.adrift[adrift_ashore_k].person)} ashore")
    if not held and near_own_craft():
        offer_add(o, "aboard", "climb aboard your {CRAFT_NAMES[int(pc.kind)]}")
        if pc.state.moored and not busy: offer_add(o, "tinker", "work on the aircraft", .g)
    if not held and by_launch_dock(): offer_add(o, "launch-out", "take the harbour launch out to your {CRAFT_NAMES[int(pc.kind)]} ({phoenix_text(launches.LAUNCH_FARE)})")
    if not held and not near_own_craft() and near_map_find() >= 0: offer_add(o, "map-find", "pick up the {map_title(near_map_find())}")
    if not near_own_craft() and near_board() >= 0: offer_add(o, "notices", "read the notices")
    # (crates for a job nobody has taken: whose they are; src/leads.jo)
    if not held and lead_crate_here() >= 0: offer_add(o, "crate-label", "read the label on the crates")
    if hotel_desk_shut():offer_add(o,"wait-desk","wait here until the hotel opens")
    else:offer_add(o, "leisure", offer_words(leisure_prompt()))
    # (the pilot's cargo, to the receiver waiting on the dock)
    ho = handover_here()
    if ho.1 >= 0 and not held: offer_add(o, "handover", handover_words(ho.1))
    k = nearest_folk(folks, me.pos, 3.5)
    if k >= 0: offer_add(o, "talk", "talk to {living_world.people[folks[k].person].name}", .t)
    if map_shop_here() != "": offer_add(o, "map-shop", offer_words(map_shop_prompt(map_shop_here())))
    offer_add(o, "workshop", offer_words(workshop_prompt()))
    race = race_offer_here()
    if race >= 0: offer_add(o, "race", offer_words(race_offer_text(air_events, living_world, race)))
    offer_add(o, "cat", offer_words(cat_prompt_here()))
    fish_offers(o)
    k_ride = ride_candidate(10.0)
    if not held and not busy and k_ride >= 0: offer_add(o, "ride-offer", "offer {split(living_world.people[folks[k_ride].person].name, " ")[0]} a flight", .k)
    if not held and not busy and swim_here(): offer_add(o, "swim", "go for a swim", .g)
    if not held and not busy and picnic.basket and not picnic.active and picnic_spot_at(me.pos).0: offer_add(o, "picnic", "spread the blanket here")
    if not held and not busy and stargaze_here(): offer_add(o, "gaze", "lie back and look at the stars", .l)
    if not held and not busy and not near_own_craft() and pc.state.moored:
        if let a = mooring_anchor():
            if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: offer_add(o, "haul", "haul in the line", hold = true)
    if not held and isolated_shore():offer_add(o,"shore-help","signal for a boat back to {home.name}",.r)
    o

# aboard, on the water (a wreck has only R, to be towed home: its own card)
aboard_offers = () -> Offer[]:
    o: Offer[]
    st = pc.state
    if me.mode != .aboard or ui != .none or paused or show_chart or notebook.open or st.crashed or st.capsized or st.beached: return o
    if rescue_act == 1: offer_add(o, "rescue", offer_words(rescue_prompt()))
    # (anyone rescued aboard, let out onto the Ierax: up from a boom's end, across a brow, or off
    # her deck; before her other offers, which only two keys carry)
    if let h = tender_rescued_here(): offer_add(o, "tender-out", tender_offer_words(h.2))
    if adrift_k >= 0:
        who = _first_name(living_world.adrift[adrift_k].person)
        offer_add(o, "adrift-take", "take {who} aboard")
        if adrift_ship >= 0 and adrift_help.stage == .none: offer_add(o, "adrift-line", "signal the passing caique to take her in tow", .g)
        else if adrift_tow_skipper >= 0: offer_add(o, "adrift-line", "get a line across to {_first_name(adrift_tow_skipper)}'s caique", .g)
    # (lying to an anchor out at sea there is no shore to step to: no offer)
    if st.moored and vessel_mooring.vessel < 0 and (offshore != none or shore_point(towns, st.position) != none):
        if offshore != none: offer_add(o, "launch-ashore", "call the harbour launch to go ashore ({phoenix_text(launches.LAUNCH_FARE)})      Shift  open the throttle")
        else: offer_add(o, "ashore", "step ashore      Shift  open the throttle")
    if landplane_parked(): offer_add(o, "ashore", "climb down      Shift  open the throttle")
    if stranded_on_land(): offer_add(o, "fetch", if pc.spec.landplane: "send for a lorry to take her to the aerodrome" else: "send for a team to bring her down to the harbour", .g)
    if not st.moored and buoy_spot() != none: offer_add(o, "buoy", "make fast to the buoy")
    offer_add(o, "lighter", lighter_offer())
    if not st.moored and (dock_spot() != none or find_vessel_mooring(vessels, st, pc.spec.span) != none): offer_add(o, "moor", "moor here")
    offer_add(o, "fuel", offer_words(fuel_offer_text(again = true)))
    # (at the Ierax: her bunkers, her derrick, and on her deck her mechanics)
    if tender_hoist == 0 and st.moored and near_tender(st.position):
        offer_add(o, "tender-fuel", "take on fuel from {TENDER_NAME}")
        if active_scenario == "": offer_add(o, "tender-duty", "ask the duty officer about the patrol", .t)
        offer_add(o, "tender-hoist", "be hoisted aboard {TENDER_NAME}")
    if tender_hoist == 2:
        cost = tender_repair_cost()
        if tender_wear() > 0: offer_add(o, "tender-repair", if cost > 0: "have her mechanics see to the aircraft ({phoenix_text(cost)})" else: "have her mechanics see to the aircraft")
        offer_add(o, "tender-lower", "be lowered over the side")
    race = race_offer_here()
    if race >= 0: offer_add(o, "race", offer_words(race_offer_text(air_events, living_world, race)))
    o

descent_offers = () -> Offer[]:
    out: Offer[]
    loop d in battle.descents:
        if d.person != living_world.player or d.released or d.phase != .swimming: continue
        if sos.stage == .none: offer_add(out, "pickup-flare", "fire a flare", .t)
        else if sos.stage == .coming:
            words=if sos.by==.search:"wait for a search boat ({help_eta_words(sos.eta)})" else:"wait for the boat"
            offer_add(out, "pickup-wait", words, .f)
        break
    out

offers_now = () -> Offer[]:
    if me.mode == .aboard: aboard_offers() else: if me.mode == .descent: descent_offers() else: walk_offers()

# Brought home from wherever she is: towed to a free dock, or a landplane carried to its aerodrome,
# and patched up (the bill comes later)
rebind_player_combatant = ():
    ci = combat_index(battle, living_world.people[living_world.player].craft)
    if ci < 0: return
    previous = battle.actors[ci]
    battle.actors[ci] = Combatant(previous.craft, living_world.player, previous.side, pc.spec, pc.state,
        external = true, human = true, previous = pc.state.position, model = pc.model, engagement = previous.engagement)

fetch_home = ():
    dock = free_dock(home, others_at(), home.docks[0]) ?? home.docks[0]
    fetch_aircraft(dock,along_quay)

fetch_aircraft = (dock:vec3,h:f64):
    global pc,offshore,vessel_mooring
    c=living_world.people[living_world.player].craft
    fuel=living_world.aircraft[c].fuel_ml
    at=if pc.spec.landplane and me.mode==.aboard:pc.state.position else:dock
    pc = if pc.spec.landplane: landplane_at_airfield(pc.kind,pc.model,at,where=if fuel==0:"fuel" else:"stand") else:make_flyer(pc.kind,pc.model,craft_models[pc.model].contacts,dock,h)
    pc.spec.player = true
    # A paid or owed recovery patches the same aircraft in the registry, as well as its scene body.
    living_world.aircraft[c].hull=1000;living_world.aircraft[c].engine=1000
    living_world.aircraft[c].revision+=1
    pc.placed = false
    offshore=none;vessel_mooring=VesselMooring();rope.tied=false
    if offshore_only(pc.kind):settle_big_craft(false)
    else:tie_up()
    pc.state.fuel=f64(fuel)/1000.0
    rebind_player_combatant()

# On her wheels at rest where she cannot fly on from: a landplane come down away from the aerodrome
# (in a field, short of fuel), or an amphibian ashore, whose run is longer than any strip: never a
# dead end, she can be fetched home
stranded_on_land = () -> bool:
    st = pc.state
    if me.mode != .aboard or st.crashed or st.capsized or st.moored or not st.on_ground or length(st.velocity) > 0.3 * pure_k(pc.spec) or pc.throttle > 0.05: return false
    if pc.spec.landplane: return airfield_at(st.position.xz) < 0 or st.fuel <= 0.0
    st.gear > 0.95

# the offer whose key went down this frame ("" for none); a controller's A (X, Y) chooses the first
# (second, third) whatever its key
offer_pressed = (o: Offer[]) -> str:
    if ctl.choice >= 0 and ctl.choice < o.len() and not o[ctl.choice].hold: return o[ctl.choice].act
    loop e in o:
        if not e.hold and vpressed(e.key): return e.act
    ""
# (a held one, hauling in the line, while its key is down)
offer_held = (o: Offer[], act: str) -> bool:
    loop k in 0..o.len():
        e = o[k]
        if e.act == act and e.hold and (vdown(e.key) or ctl.choice_held == k): return true
    false

# the card for the k-th thing on offer: its key, or the controller's button that chooses it
offer_card_at = (o: Offer, k: int) -> str:
    if not pad_hints() or pad.on: return offer_card(o)
    b = offer_button_name(k, options.controls)
    if b == "": b = key_button_name(o.key, options.controls)
    if b == "": return offer_card(o)
    (if o.hold: "hold " else: "") + "{b}  {o.words}"

# The cards there's no thing in view for: a thing on the screen (his aircraft, the desk, the jar)
# is its own card, tapped or clicked, and its key works as ever. A pad keeps them all, its buttons
# going by their order.
shown_offers = (o: Offer[]) -> Offer[]:
    things = foot_things()
    out: Offer[]
    loop e in o:
        hide = false
        loop th in things:
            if th.folk >= 0 or th.act != e.act or (th.sub != "" and not e.words.contains(th.sub)): continue
            if let sp = world_to_screen(thing_top(th)):
                if f64(sp.x) > 0.0 and f64(sp.x) < f64(screen_width()) and f64(sp.y) > 0.0 and f64(sp.y) < f64(screen_height()): hide = true
        if not hide: out.push(e)
    out

# the cards, stacked up from where the single card stood (the first nearest the bottom)
draw_offers = (o: Offer[], bottom: f64):
    controller_offers(o.len())
    loop k in 0..o.len(): prompt_card(fonts, offer_card_at(o[k], k), bottom + 52.0 * f64(k))

# AEGEAN_FRAME_STATS=1: the frame statistics every 120 frames (FRAME_STATS lines), the same for
# the title and for play, for timing runs on redfox
frame_stats_on = env("AEGEAN_FRAME_STATS") != none
if frame_stats_on: record_stats()

update = (dt: f64):
    chart_background_step()
    # (F11 fills the screen and back, everywhere: the title, play and the menus; a browser that keeps
    # F11 for itself never passes it on)
    if key_pressed(.f11) and can_fullscreen(): set_fullscreen(not is_fullscreen())
    if frame_stats_on and frame_number() % 120 == 0 and frame_number() > 0: print("FRAME_STATS frame={frame_number()} title={title.open} eye={scene_camera().y:.1} at={scene_camera().x:.0},{scene_camera().z:.0} dir={ear_forward.x:.3},{ear_forward.y:.3},{ear_forward.z:.3} {frame_stats_line()}")
    global title_kept
    if let kept = title_kept:
        pc.state = kept
        title_kept = none
    build_slice_tick()
    if title.open:
        title_update(dt)
        return
    # (a start with no title, a shader queued in play (the weather's, as it nears) or one made
    # during play and not yet drawn: linked here, one a frame, not in the middle of a frame's drawing)
    if shaders_pending() > 0: _ = warm_up_shaders(max_count = 1)
    # (walking-path searches for the scenes' people share a few milliseconds each frame)
    cargo_scene.walk_paths_frame(2.0)
    calm=ui==.none and not paused and active_scenario=="" and not world_input_this_frame()
    living_scene.set_scene_minute_budget(if calm: MINUTE_FRAME_MS else: -1.0)
    if not calm: finish_held_minute(traffic,living_world,traffic_scene,battle)
    update_frame(dt)
    pilot_reply_frame()
    # (in a browser: whether a panel is open, so the phone's Back closes it rather than the page)
    when TARGET == "wasm": __aegean_panel_open(i32(if menus_open(): 1 else: 0))
    step_game_save()
    # (the title's music fades away as play begins)
    if title_music.playing or title_music.voice >= 0:
        global title_music_fade
        title_music_fade = max(0.0, title_music_fade - dt / 3.0)
        if title_music_fade <= 0.0: music_audition_stop(title_music)
        else: title_sound(dt)

update_frame = (dt: f64, saves: bool = true):
    if saves and process_game_saves(): return
    global air_visual,air_events,all_air_traffic,view_target,target_scan
    global t, hour, show_chart, chart_local, pc, ui, ui_folk, ui_line, ui_news, ui_place, paused, descent_camera, vessel_mooring, was_moored
    # (the touch screen's stick and buttons, read as keys below; mode: 0 flying, 1 on the water,
    # 2 on foot, 3 a panel open)
    # (AEGEAN_TALK: a conversation with the nearest person opens at the start, for looking at it)
    if talk_at_start and t > 1.0 and ui == .none and me.mode == .walking:
        global talk_at_start, ui_turn
        talk_at_start = false
        k0 = nearest_folk(folks, me.pos, 1000000.0)
        # (AEGEAN_TALK=mechanic: with the town's mechanic, who paints aircraft)
        if env("AEGEAN_TALK") == "mechanic":
            loop j in 0..folks.len():
                if folks[j].person >= 0 and living_world.people[folks[j].person].occupation == .mechanic and folks[j].place == town_here(me.pos): k0 = j
        if k0 >= 0:
            ui = .talk
            ui_folk = k0
            ui_turn = living.talk(living_world, folks[k0].person, .greeting, living_world.player)
            ui_line = with_meet_remark(folks[k0].person, ui_turn)
    # (4: seated at a table or the bar with only its own bar along the bottom, or in a room's view:
    # as a panel, but a finger on the scene turns the view)
    looking = (seat_view() or (stay.active and ui == .leisure and leisure_ui == 15)) and not paused and not notebook.open and not show_chart and not title.open
    pad_mode = if looking: 4 else if title.open or paused or ui != .none or notebook.open or show_chart: 3 else if me.mode == .aboard: (if pc.state.on_water or pc.state.moored: 1 else: 0) else: 2
    lay_out_screen()                # (upright or on its side, a phone gets its own units)
    wheel_zoom_step(dt, menus_open() or title.open)     # (the wheel's zoom, read once a frame)
    # (the touch screen's X: the P.7's hand clutch while it is still on the screw, the Albatross's gear)
    pad_lever = if pc.kind==.piaggio_p7 and not pc.state.foil.engaged: "Clutch" else: if pc.kind==.albatross: "Gear" else: ""
    set_pad_charts_open(ui == .none or show_chart or notebook.open)
    update_pad(pad_mode, not pc.slow, pc.throttle, dt, pad_lever)
    # (a touch screen never keeps the pointer locked: its first finger is also the mouse, and a
    # locked mouse turns the view by that finger's jump from where the last touch lifted to where
    # the next lands; the touch pad turns it instead)
    if pad.on and is_mouse_locked(): mouse_lock(false)
    # (a gamepad or a flight stick: its axes and its buttons as the game's keys, src/controller.jo)
    # (coming down under a parachute is the air's: its button opens the canopy)
    update_controller(if pad_mode == 4: 3 else if me.mode == .descent and pad_mode != 3: 0 else: pad_mode, dt, dbg.opts.controls)
    # P (or F1) stops the world and its sounds, and opens the pause menu (the debugging panel)
    if frame_number()==capture_pause_frame: set_paused(true)
    if frame_number()==capture_lose_frame and capture_lose_part >= 0 and me.mode == .aboard:
        st = pc.state
        detach_part(pc.state.damage, pc.spec.parts, PartId(capture_lose_part), pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
    if frame_number()==game_capture_frame:
        set_paused(true);dbg.page=0
        if startup_aegean_capture_panel=="game-confirm":dbg.confirm="load";dbg.confirm_slot=1
    # One full-screen panel at a time: the pause menu, the chart, the notebook, or a conversation,
    # board or other panel. Opening the pause menu, the chart or the notebook closes the other two
    # (the pause menu covers a conversation, which shows again after it; the chart and the notebook
    # wait while one is open); Escape, a controller's B or the phone's Back closes the top one only.
    # (While the notebook is open its line takes the keyboard's letters: only the touch pad's and a
    # controller's buttons work it then.)
    typing_text = ui_typing() or debug_typing() or leisure_typing()
    esc = vpressed(.escape)
    want_pause = not typing_text and (if notebook.open: vbutton(.p) else: vpressed(.p) or vpressed(.f1))
    if paused and not dbg.picking:
        if esc and dbg.confirm != "": dbg.confirm = ""; take_escape()
        else if (esc and not typing_text) or want_pause: set_paused(false); take_escape()
    else if want_pause and not paused: set_paused(true)
    want_map = not typing_text and not dbg.picking and (if notebook.open: vbutton(.m) else: vpressed(.m))
    if want_map:
        if show_chart:
            show_chart = false
            if me.mode == .aboard: mouse_lock(true)
        else if ui == .none:
            if paused: set_paused(false)
            notebook.open = false
            show_chart = true; mouse_lock(false)
    else if show_chart and esc and not paused and not dbg.picking:
        show_chart = false; take_escape()
        if me.mode == .aboard: mouse_lock(true)
    want_log = not typing_text and (if notebook.open: vbutton(.j) else: vpressed(.j))
    if want_log:
        if notebook.open: notebook.open = false
        else if ui == .none:
            if paused: set_paused(false)
            show_chart = false
            notebook.open = true; notebook.fresh = true; mouse_lock(false)
    if show_chart and geography_enabled and vpressed(.tab): chart_local = not chart_local
    global chart_sheets
    chart_sheets = if dbg.picking or not show_chart: none else: owned_chart_sheets()
    if frame_number() % 15 == 0 and not paused: notice_new_maps()
    # (a repaint shows at once, paused on the Paint page as in play)
    paint_step()
    paint_point_step()
    if paint_shop_capture: paint_shop_capture_step()
    pilot_livery_step()
    # the pause menu's music keeps playing after unpausing, to hear it among the world's sounds
    music_audition_update(dbg.music,dt,startup_sloppy_no_audio == none)
    if paused:
        _ = radio.radio_hold_tune(cockpit_radio,0,0)
        hush_audio(audio)
        ambience_hush(world_ambience.sound)
        world_ambience.previous_scan = -1
        life_audio.hush_life_audio(life_sound)
        radio.radio_silence(cockpit_radio)
        hush_combat_audio(combat_audio);hush_battle_radio(battle_radio)
        hush_engines(hearing)
        bar_music_stop(bar_music)
        # (picking a place on the chart from the pause menu; Escape gives up)
        if dbg.picking and show_chart and mouse_pressed(.left):
            if let q = chart_place(mouse_pos()):
                debug_place(f64(q.x), f64(q.y), dbg.altitude)
                set_paused(false)
        if dbg.picking and (vpressed(.escape) or vpressed(.m)):
            dbg.picking = false
            dbg.open = true
            show_chart = false
        return
    if leisure_capture != "": leisure_capture_step()
    # (time passing at an inn, a table or the aircraft: the world's clock runs on behind a dark card)
    if skip.active:
        leisure_time_step(dt)
        return
    # (sitting at a table: after a word with someone, back to the table)
    if ui == .none and leisure.sitting != "":
        global leisure_ui
        ui = .leisure
        leisure_ui = 0
    if frame_number() % 60 == 0: leisure_clear_table(living_world, leisure)
    let dt = frame_dt(if stress_frame_dt>0:stress_frame_dt else:dt)
    t += dt
    if stay.active and ui == .leisure and leisure_ui == 15 and not skip.active: stay_look_step(dt)
    if stay.active: room_step_frame(dt)
    stay_tick()
    ride_tick(dt)
    rider_tick(dt)
    service_step(dt)
    company_tick(dt)
    pilot_talk_frame()
    tip_thanks_step()
    music_cues_step()
    weather_scene_step(living_world,if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos,hour,dt)
    # (the wind setting's bias, before anything steps: the floats ride the same sea that is drawn)
    wind_now.speed = max(0.0, wind_now.speed + wind_bias)
    weather_shaders_near(if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos)
    hour = (hour + dt * hour_rate + 24.0) % 24.0      # an hour of the day: two minutes
    typing = ui_typing() or debug_typing() or leisure_typing()
    # The radio: , and . tune it (Shift: to the next station on the air), / switches it on and off,
    # and on a touch screen the Radio button steps through the stations and off. Tuning switches it
    # on; a card says where it is.
    if me.mode == .aboard and ui == .none and not notebook.open and not show_chart and not typing:
        tuned = false
        if vdown(.shift):
            _ = radio.radio_hold_tune(cockpit_radio,0,0)
            if vpressed(.comma): radio.radio_seek(cockpit_radio,-1,living_world.minute); tuned = true
            if vpressed(.period): radio.radio_seek(cockpit_radio,1,living_world.minute); tuned = true
        else:
            direction = (if vdown(.period): 1 else: 0)-(if vdown(.comma): 1 else: 0)
            tuned = radio.radio_hold_tune(cockpit_radio,direction,dt)
        if tuned and cockpit_radio.muted: radio.radio_mute(cockpit_radio, false)
        if vpressed(.slash):
            radio.radio_mute(cockpit_radio,not cockpit_radio.muted)
            tuned = true
        if vpressed(.f9):
            radio_next_station()
            tuned = true
        if tuned:
            global radio_card_until
            radio_card_until = t + 2.5
        radio_knob_step(dt, t)
        rt_tick()
    else:
        _ = radio.radio_hold_tune(cockpit_radio,0,0)
        global radio_knob
        radio_knob.turning = 0
    # (the dial stays where it was left, from one game to the next: kept once the tuning stops)
    if abs(cockpit_radio.khz - radio_saved_khz) > 0.5 and not vdown(.comma) and not vdown(.period):
        global radio_saved_khz
        radio_saved_khz = cockpit_radio.khz
        _ = save_value("radio-khz", radio_saved_khz)
    # (1 and 2 wind the hour only with no panel open: in a conversation, a board or the workshop
    # they choose what to say or do)
    hour_keys = not typing and ui == .none and not notebook.open and not show_chart and not rt.open
    if vdown(.n1) and hour_keys: hour = (hour - dt * 2.0 + 24.0) % 24.0
    if vdown(.n2) and hour_keys: hour = (hour + dt * 2.0) % 24.0
    if vpressed(.escape): mouse_lock(false)
    # (a click takes the mouse for the camera only when no panel is open to be clicked)
    # (on foot: the thing the view looks at (foot_look), lit; a click uses it, the mouse locked to
    # the view or not, and walks him over)
    global foot_hover, foot_hover_since
    looked = if me.mode == .walking and ui == .none and not notebook.open and not show_chart: foot_look(foot_things()) else: -1
    global look_folk, look_craft, look_keeper, look_coffee
    look_folk = -1; look_craft = false; look_keeper = false; look_coffee = ""
    if looked >= 0:
        lt_ = foot_things()[looked]
        look_folk = lt_.folk
        look_craft = lt_.act == "aboard" or lt_.act == "tinker"
        look_keeper = lt_.then == "bath-keeper"
        if lt_.sub == "coffee" and (lt_.then == "tavli" or lt_.then == "paper"): look_coffee = lt_.then
    if looked != foot_hover:
        foot_hover_since = t
        # (captures: what the view comes to look at, frame by frame)
        if look_trace: eprint("LOOK {frame_number()} {if looked >= 0: foot_things()[looked].label else: "-"}")
    foot_hover = looked
    clickable = not pad.on and not dbg.open and not rt.open and radio_knob.turning != 1
    if mouse_pressed(.left) and foot_hover >= 0 and clickable:
        foot_go(foot_things(), foot_hover)
    else if mouse_pressed(.left) and picnic_ground_hover() and clickable:
        if let g = ground_under(foot_aim()): bath_walk_to(g, "picnic")
    else if mouse_pressed(.left) and me.mode != .free and ui == .none and not notebook.open and not dbg.open and not show_chart and not is_mouse_locked() and radio_knob.turning != 1 and not rt.open:
        mouse_lock(true)
        global click_took_mouse
        click_took_mouse = true             # (that click only takes the mouse: it doesn't fire)
    if not mouse_down(.left):
        global click_took_mouse
        click_took_mouse = false
    if vpressed(.f2) and not typing and not presentation.thermal.active and not launch.active and not sos.aboard and me.mode != .descent: me.mode = if me.mode == .free: Mode.walking else: Mode.free
    # (only while the card can be seen: a battle met behind a panel keeps its card for later)
    if (me.mode == .aboard or me.mode == .walking) and frame_number() % 20 == 0 and not paused and not show_chart and ui == .none:
        global battle_card, presentation
        if battle_card_step(battle_card, presentation, living_world, if me.mode == .aboard: pc.state.position else: me.pos, t):
            log_note(notebook, "Came upon the {battle_card.name}.", clock_text(living_world, living_world.minute))
            # (what the pilot did today, for his small talk: src/pilot_talk.jo)
            pilot_did(living_world.pilot_day, Doing(.battle, living_world.minute))
    if frame_number() % 30 == 0:
        global packets_now
        packets_now = contract_marks(living_world, living_world.player, if me.mode == .aboard: pc.state.position else: me.pos)
    if show_chart and war_chart.minute != living_world.minute:
        global war_chart
        war_chart = war_chart_data(living_world, living_world.player, presentation.battles_seen)
    if let stage = capture_maps:
        if frame_number() == 3: stage_capture_maps(stage)
    if let stage = capture_rescue: stage_capture_rescue(stage)
    if let stage = capture_adrift: stage_capture_adrift(stage)
    if let stage = capture_fuel: stage_capture_fuel(stage)
    if let stage = capture_workshop: stage_capture_workshop(stage)
    fuel_stop_step()
    update_rescue()
    update_adrift()
    race_results_told()
    if capture_racelead != "" and capture_racelead != "list": stage_capture_racelead(capture_racelead)
    if capture_errand != "": stage_capture_errand(capture_errand)
    # (the rescue capture: F taken for the player once alongside)
    if capture_after=="arrive" and env("AEGEAN_CAPTURE_TENDER_CAM")!=none: tender_cam_step()
    if capture_after=="arrive" and env("AEGEAN_CAPTURE_SIGNAL")!=none: signal_capture_step()
    if capture_after=="rescue" and rescue_act==1 and not capture_after_took:
        global capture_after_took
        capture_after_took=true;do_rescue()
    if me.mode == .aboard and frame_number() % 30 == 15 and not paused and not show_chart and ui == .none: meet_fuel_step()
    race_k = race_offer_here()
    if race_k >= 0 and offer_pressed(offers_now()) == "race" and not typing:
        if player_air_entry(air_events.meets[race_k], living_world.player) != none:
            back = air_withdraw_refund(air_events.meets[race_k], player_air_entry(air_events.meets[race_k], living_world.player)!, living_world.tick)
            out = withdraw_player_air_meet(air_events, living_world, air_events.meets[race_k].id)
            say_toast(if not out.accepted: out.reason else: if back > 0: "Withdrawn. The club returned your {phoenix_text(back)}." else: "Withdrawn.")
        else:
            entry = enter_player_air_meet(air_events, living_world, air_events.meets[race_k].id)
            say_toast(if entry.accepted: "Entered. The race starts at {clock_text(living_world, air_events.meets[race_k].race_tick / 120)}" else: entry.reason)
    player_combat=combat_index(battle,living_world.people[living_world.player].craft)
    if thermal_capture_id>=0 and not thermal_capture_started and frame_number()>=100:
        global thermal_capture_started
        thermal_capture_started=true
        reason=thermal_life.thermal_begin(living_world,presentation.thermal,thermal_capture_id,me.pos,env("AEGEAN_THERMAL_INN")!=none)
        print("THERMAL_CAPTURE place={thermal_capture_id} result={reason} fatigue={living_world.people[living_world.player].fatigue} minute={living_world.minute}")
        if reason=="" and env("AEGEAN_THERMAL_HOUR")!=none:presentation.thermal.until=living_world.minute+60
    if player_combat>=0:battle.actors[player_combat].pilot.trigger=false
    match me.mode:
        .free:
            if launch.active: launch_step(dt, typing)
            # (taken off a wreck by the help that came: the camera rides with the pilot)
            else if sos.aboard: help_camera()
            else if not title.open:
                free.update(dt)
                if let g = view_glide: free.pos += g*f32(dt)
        .walking:
          if job.active: plane_job_step(dt)
          if listen_mode != "": listen_step(dt)
          # (a panel open has the mouse to itself: the menu, the ledger, the paper, the notices, the
          # tavli board click without turning the view; only the bar along the bottom while one
          # sits leaves it to be turned. The wheel is never the camera's while anything is open:
          # menus_open)
          if seat_view():
              seat_orbit_step(dt)
              update_player_follow(dt, input = false)
          else if ui != .none: update_player_follow(dt, input = false)
          bath_step(dt)
          thermal_handled=(ui==.none and picnic_step(dt)) or bath.stage==.getting_in or (ui==.none and not notebook.open and not show_chart and thermal_walk(dt))
          if bath.stage==.getting_in:update_player_follow(dt,input=false)
          if ui == .none and not notebook.open and not show_chart and not thermal_handled:
              if vdown(.q): follow.yaw += dt * 2.0
              if vdown(.e): follow.yaw -= dt * 2.0
              a = walk_axis()
              # (on a touch screen: two fingers turn the view and pinch it nearer)
              # (as every view's finger turns it: half round for the screen's width, touch_look_gain)
              follow.yaw -= f64(pad.orbit.x) * touch_look_gain()
              follow.pitch = clamp(follow.pitch + f64(pad.orbit.y) * touch_look_gain() * TOUCH_LOOK_PITCH, follow.min_pitch, follow.max_pitch)
              # (a controller's right stick turns the view about him too)
              follow.yaw -= f64(ctl.look.x) * dt * 2.4
              follow.pitch = clamp(follow.pitch + f64(ctl.look.y) * dt * 1.4, follow.min_pitch, follow.max_pitch)
              if pad.zoom != 1.0: follow.distance = clamp(follow.distance / pad.zoom, 2.5, 14.0)
              move = flat_forward(follow) * -a.y + flat_right(follow) * a.x
              run = vdown(.shift) and not (fish_bucket_carried() and fish_pail(fish).len() > 0)
              # (on a touch screen: the Walk button walks the way the view looks, faster the farther
              # the thumb slides from it; a tap on someone near talks to them)
              global pad_talk
              if pad.walking:
                  # (the thumb slid across bears him that way, and the view swings after him)
                  bear = pad.walk_side * 0.9
                  move = flat_forward(follow) * f32(cos(bear)) + flat_right(follow) * f32(sin(bear))
                  run = pad.walk_speed > 0.6
                  if abs(pad.walk_side) > 0.15: follow.yaw = approach_angle(follow.yaw, me.yaw + PI, 0.9 * abs(pad.walk_side), dt)
              # (a tap on a thing (his aircraft, a table, the desk, the jar, someone): over he goes)
              tapped_thing = false
              if pad.tapped:
                  ft = foot_things()
                  fk = foot_pick(ft, pad.tap_at)
                  if fk >= 0: foot_go(ft, fk); tapped_thing = true
                  # (the basket along: a tap on the sand of a quiet shore, and he spreads the blanket there)
                  else if picnic.basket:
                      if let g = ground_under(pad.tap_at):
                          if picnic_spot_at(g).0: bath_walk_to(g, "picnic"); tapped_thing = true
              # (walking himself, the keys or the Walk button, he forgets where he was going; there,
              # the card's act is done where the cards are read (offers, below), or a person is
              # talked to, or what comes after done)
              global foot_goal, talk_pick, foot_goal_at, foot_then, foot_goal_best, foot_goal_best_t, foot_route
              if foot_goal >= 0 and (length(move) > 0.1 or ui != .none): foot_goal = -1
              if foot_goal >= 0:
                  if foot_goal_folk >= 0 and foot_goal_folk < folks.len(): foot_goal_at = folks[foot_goal_folk].pos
                  to = vec3(foot_goal_at.x - me.pos.x, 0, foot_goal_at.z - me.pos.z)
                  close = f64(length(to)) < (if foot_goal_folk >= 0: 1.9 else: 0.45)
                  if close and foot_route.len() > 0:
                      foot_goal_at = foot_route[0]; foot_route.remove_at(0); foot_goal_best = 1e9
                      close = false
                      to = vec3(foot_goal_at.x - me.pos.x, 0, foot_goal_at.z - me.pos.z)
                  if close:
                      if foot_goal_folk >= 0: talk_pick = foot_goal_folk; pad_talk = true
                      else if foot_goal_act == "": run_then(foot_goal_then)
                      foot_goal = -1
                  else if t - foot_goal_since > 25.0: foot_goal = -1
                  else:
                      # (no nearer for three seconds, against a wall or a crowd: he stops)
                      dd = f64(length(to))
                      if dd < foot_goal_best - 0.3 or foot_goal_best_t < foot_goal_since: foot_goal_best = dd; foot_goal_best_t = t
                      if t - foot_goal_best_t > 3.0: foot_goal = -1
                      else: move = normalize(to)
              if pad.tapped and not tapped_thing:
                  if let g = ground_under(pad.tap_at):
                      k = nearest_folk(folks, g, 2.0)
                      if k >= 0 and length(folks[k].pos - me.pos) < 3.5: pad_talk = true
              if cat_busy(cat_scene) and length(move) > 0.1:
                  said = cat_stop(cat_scene, presentation.cat_bonds, living_world.minute)
                  if said != "": say_toast(said)
              speed = if holding_cargo() >= 0: 1.0 else: if pad.walking: 1.7 + 2.5 * pad.walk_speed else: if run: 4.2 else: 1.7
              # (a built stair is climbed at a brisk pace: a 300 m cliff stair took three minutes at
              # an ambling 1.7 m/s, its whole climb held at the key)
              if holding_cargo() < 0 and not swim.active and on_any_stair(towns, me.pos): speed = max(speed * 1.3, 3.4)
              if gaze.active:
                  # (lying back: the view drifts round the sky; the keys and a finger look about)
                  turn = (if vdown(.q) or vdown(.left): -0.5 else: 0.0) + (if vdown(.e) or vdown(.right): 0.5 else: 0.0) + f64(ctl.look.x) * 0.5
                  tilt = (if vdown(.up): 0.4 else: 0.0) - (if vdown(.down): 0.4 else: 0.0) - f64(ctl.look.y) * 0.4
                  gaze_step(gaze, dt, turn, tilt)
                  # (a finger turns it as it turns every view: touch_look_gain)
                  gaze.yaw -= f64(pad.orbit.x) * touch_look_gain()
                  gaze.pitch = clamp(gaze.pitch + f64(pad.orbit.y) * touch_look_gain() * TOUCH_LOOK_PITCH, 0.35, 1.5)
                  move = vec3(0, 0, 0)
                  if vpressed(.escape): gaze_end()
              if length(move) > 0.1:
                  dir = normalize(vec2(move.x, move.z))
                  me.yaw = approach_angle(me.yaw, atan2(f64(dir.x), f64(dir.y)), 10.0, dt)
                  if swim.active:
                      swim_move(dir * f32(swim_speed(swim, run) * dt), dt, run)
                      me.phase += dt * 3.0
                  else: step_player_walk(dir * f32(speed * dt))
                  me.stride = approach(me.stride, if run: 1.0 else: 0.7, 8.0, dt)
                  me.phase += dt * speed * 5.0
              else:
                  if swim.active: swim_move(vec2(0, 0), dt, false)
                  me.stride = approach(me.stride, 0.0, 8.0, dt)
              update_player_follow(dt)
              if not world_held():
                  portage.cargo_person_pose(living_world,living_world.player,me.pos)
                  living_world.people[living_world.player].pose.rot = lt.facing(vec3(f32(sin(me.yaw)),0,f32(cos(me.yaw))))
              # what can be done here: one action per key press (walk_offers)
              offers = walk_offers()
              act = if typing: "" else: offer_pressed(offers)
              # (walking over to a thing: there when its card would be offered, and done as its key does)
              if act == "" and foot_goal >= 0 and foot_goal_act != "" and foot_goal_folk < 0:
                  # (a table on the terrace: there at the chair chosen, not at the first one passed)
                  at_chair = foot_route.len() == 0 and f64(length(vec3(me.pos.x - foot_goal_at.x, 0, me.pos.z - foot_goal_at.z))) < 1.8
                  loop e in offers:
                      if e.act == foot_goal_act and (foot_goal_sub == "" or e.words.contains(foot_goal_sub)) and (foot_goal_sub != "sit at a table" or at_chair):
                          act = e.act; foot_then = foot_goal_then; foot_goal = -1
                          if foot_goal_sub == "sit at a table":
                              global hotel_sit_target
                              hotel_sit_target = foot_goal_at
                          break
              if offer_held(offers, "haul"): haul_in(dt)
              if act == "cargo": _ = cargo_interact()
              if act == "handover": handover_act()
              if act == "rescue": do_rescue()
              if act == "rescue-free": do_rescue(free=true)
              if act == "adrift-ashore": adrift_ashore()
              if act == "crate-label": crate_label_read()
              if act == "wait-desk":leisure_skip(rest_minutes(living_world,hotel_place.opens),"waiting for the hotel to open")
              if act == "shore-help":help_search(me.pos,.none)
              if gaze.active and vpressed(.t):
                  # (an hour goes by under the stars; the sky has turned when it has)
                  leisure_skip(60, "An hour passes under the stars")
              if act == "talk" or pad_talk:
                  pad_talk = false
                  k = if talk_pick >= 0 and talk_pick < folks.len(): talk_pick else: nearest_folk(folks, me.pos, 3.5)
                  talk_pick = -1
                  if k >= 0:
                      ui = .talk
                      ui_folk = k
                      global ui_turn
                      ui_turn = living.talk(living_world, folks[k].person, .greeting, living_world.player)
                      ui_line = with_meet_remark(folks[k].person, ui_turn)
                      # (a new paint is noticed)
                      noticed = paint_remark(folks[k].person)
                      if noticed != "": ui_line = said_by(living_world.people[folks[k].person].name, noticed)
                      # (someone whose cargo one has brought sees it)
                      loop id in living_world.active_jobs:
                          j = living_world.jobs[id]
                          if j.state == .claimed and j.carrier == living_world.player and j.loaded and j.destination == folks[k].place and portage.cargo_receiver(living_world,id) == folks[k].person:
                              ui_line = "Is that {job_cargo(id)} from {living_world.people[j.poster].name}?"
                      ui_news = 0
                      mouse_lock(false)
              if act == "map-find":
                  found = living.find_map(living_world,near_map_find(),living_world.player)
                  if not found.ok: say_toast(found.message)
              if act == "notices":
                  ui = .board
                  ui_place = near_board()
                  mouse_lock(false)
              if act == "leisure": leisure_act()
              if act == "picnic": picnic_begin()
              # (sat down at the coffee house to the board, or the paper: those next)
              if foot_then != "" and act != "":
                  if leisure.sitting != "": run_then(foot_then)
                  foot_then = ""
              if gaze.active and vpressed(.l): gaze_end()
              else if act == "gaze": gaze_begin()
              if act == "swim": swim_go()
              if act == "swim-out":
                  if let up = swim_climb_out(me.pos, swim_ground, swim_level): swim_end(up)
              if act == "tinker":
                  global leisure_ui, leisure_line
                  ui = .leisure
                  leisure_ui = 3
                  leisure_line = ""
                  mouse_lock(false)
              if act == "map-shop": open_map_counter(map_shop_here())
              if act.starts_with("fish-"): fish_act(act)
              if act == "workshop": open_workshop()
              if act == "cat" and not cat_busy(cat_scene):
                  me.yaw = cat_begin(cat_scene, cat_here(), cat_prompt_here().starts_with("F  give"), me.pos)
              if act == "launch-out": start_launch(true)
              if act == "ride-offer":
                  k = ride_candidate(10.0)
                  if k >= 0: ride_start(k)
              if act == "aboard" and paint_job.active:
                  # (she is in the paint shop: not to be flown until the paint is dry)
                  say_toast("She is in the paint shop until {paint_clock(paint_job.ready_minute)}")
              else if act == "aboard":
                  me.mode = .aboard
                  mouse_lock(true)
                  pc.placed = false
                  pc.throttle = 0.0
        .descent:
            swimmer=false
            due_pickup=false
            loop mut d in battle.descents:
                if d.person!=living_world.player or d.released:continue
                move=input_axis()
                d.steering=flat_forward(descent_camera.look)*-move.y+flat_right(descent_camera.look)*move.x
                d.open_requested=vpressed(.t)
                me.pos=d.position
                if d.phase == .swimming:
                    swimmer=true
                    due_pickup=d.age-max(0.0,d.wet)>=4.0 and frame_number()%30==0
                if d.phase==.landed:
                    me.mode=.walking;d.released=true;follow.placed=false
            if swimmer:
                act=if typing:"" else:offer_pressed(descent_offers())
                if act=="pickup-flare":help_flare(me.pos)
                if act=="pickup-wait":help_wait()
                if sos.stage==.none and (act=="pickup-flare" or due_pickup):
                    if not pickup_launch(me.pos,false):pickup_retry()
        .aboard:
            if vpressed(.v) and not typing:pc.cockpit_view=not pc.cockpit_view
            # (the first time aboard a P.7 on the water: how she is flown off; not when first met in the air)
            if pc.kind==.piaggio_p7 and not p7_hint_shown and pc.state.on_water:
                global p7_hint_shown
                p7_hint_shown=true
                _=save_value("p7-hint-shown",true)
                say_toast("P.7: full throttle; once her propeller is spinning, ease the stick back, never push")
            # (her engine too worn to lift her: said once a minute or so, while she is tried at full throttle)
            if pc.kind==.piaggio_p7 and pc.state.on_water and pc.throttle > 0.5 and t-p7_worn_told > 60.0 and foil_power_short(part_health(pc.state.damage,.engine)) and not (capture_takeoff and not capture_takeoff_worn):
                global p7_worn_told
                p7_worn_told=t
                say_toast("Her engine is too worn to lift her: have it serviced")
            # (X: the P.7's hand clutch to the air propeller; any other aircraft's wheels)
            if vpressed(.x) and not typing:
                if pc.kind==.piaggio_p7:pc.clutch_hand=true
                else:pc.gear_down=not pc.gear_down
            protected=pc.state.moored
            loop tw in towns:
                if length(pc.state.position-tw.center)<1200 and pc.state.position.y<300:protected=true
            gun_safety(pc,protected,vpressed(.g) and not typing)
            ci=combat_index(battle,living_world.people[living_world.player].craft)
            if vpressed(.t) and not typing and not pc.state.moored and ci>=0:
                battle.actors[ci].state=pc.state
                if bail_combatant(battle,ci):
                    me.mode=.descent;pc.cockpit_view=false
                    me.pos=battle.descents[battle.descents.len()-1].position;follow.placed=false
                    descent_camera=DescentCamera(look=follow_camera(distance=9.0,yaw=-heading(pc.state),pitch=0.0,height=1.9),eye=scene_camera())
            before = pc.state.velocity
            set_drag_scale(if dbg.no_drag: 0.0 else: 1.0)
            # (the sandbox's switches, round the player's own step only: nothing breaks, nothing is burnt)
            set_damage_shield(sandbox.no_damage)
            fuel_before = pc.state.fuel
            previous_vessel_contact = pc.state.position
            if prop_sweep_from>=0.0 and me.mode==.aboard:
                pc.throttle=1.0-clamp((f64(frame_number())-prop_sweep_from)/(prop_sweep_secs*60.0),0.0,1.0)
                # a sound engine, so the sweep starts from true full power
                pc.state.damage.parts[int(PartId.engine)].health=1.0;pc.state.engine_damage=0.0
            # (AEGEAN_FLYING starts from a serviced aircraft: a new game's Gull is worn by design,
            # hull 650 and engine 550, and a staged flight would start it near its stall and short
            # of power; done in the first five seconds, while the new game binds it;
            # AEGEAN_WEAR=1 keeps the wear)
            if flying_serviced and me.mode==.aboard:
                global flying_serviced
                rec=living_world.people[living_world.player].craft
                if rec>=0 and (living_world.aircraft[rec].engine<1000 or living_world.aircraft[rec].hull<1000):
                    living_world.aircraft[rec].engine=1000;living_world.aircraft[rec].hull=1000
                    pc.state.damage=DamageState();pc.state.hull_damage=0.0;pc.state.engine_damage=0.0
                    # (the combat actor's parts are copied back onto the aircraft every frame)
                    fc=combat_index(battle,rec)
                    if fc>=0:battle.actors[fc].state.damage=pc.state.damage;battle.actors[fc].state.hull_damage=0.0;battle.actors[fc].state.engine_damage=0.0
                flying_serviced=frame_number()<300
            if me.mode==.aboard:
                if tender_holds_plane(): pc.throttle = 0.0
                else if slip.active and active_scenario=="canal":
                    global slip
                    _=step_slip_launch(slip,pc,dt,t)
                    if slip.splash:slip_splash(pc,spray_ps)
                else if patrol_capture!="" and active_scenario=="" and frame_number()>40:
                    # (captures only: the player flown with the Ierax's patrol)
                    e=flight_env(t,pc.state.position)
                    flown=patrol_capture_controls(e)
                    pc.throttle=flown.throttle
                    step(pc.spec,pc.state,flown,e,dt)
                    pc.prop_angle+=dt*prop_rotation_speed(pc.state,pc.feedback.speed);pc.sea_t=t;feel(pc,dt,e.wind)
                else if capture_after!="" and active_scenario=="strait":
                    # (captures only: the way home or the rescue, flown for the player)
                    e=flight_env(t,pc.state.position)
                    flown=capture_after_controls(e)
                    pc.throttle=flown.throttle
                    step(pc.spec,pc.state,flown,e,dt)
                    pc.prop_angle+=dt*prop_rotation_speed(pc.state,pc.feedback.speed);pc.sea_t=t;feel(pc,dt,e.wind)
                else if capture_canal_run and active_scenario=="canal":
                    # (capture runs only: the tests' canal steering instead of the keys)
                    e=flight_env(t,pc.state.position)
                    step(pc.spec,pc.state,canal_run_controls(pc,capture_canal_plan,e),e,dt)
                    pc.prop_angle+=dt*prop_rotation_speed(pc.state,pc.feedback.speed);pc.sea_t=t;feel(pc,dt,e.wind)
                    if let eye=capture_canal_eye:
                        if canal_station(pc.state.position)-CANAL_BEGIN>=57:
                            global judge_camera, judge_origin
                            judge_origin=pc.state.position
                            judge_camera=JudgeView(eye,pc.state.position,"the lagoon")
                else if capture_circuit_on:
                    # (captures only: the aerodrome's taxi, circuit and landing, the player's aircraft)
                    global capture_circuit
                    if capture_circuit.phase == .parked and capture_circuit.launched == 0:
                        capture_circuit.state = pc.state; capture_circuit.model = pc.model
                        arm_launch(capture_circuit, frame_number(), 0); capture_circuit.mission = 0
                        capture_circuit.launched = max(frame_number(), 1)
                    capture_circuit.state = pc.state
                    was_phase = capture_circuit.phase
                    arm_tick(capture_circuit, pc.spec, AIRFIELDS[0], vec3(0, 0, 0), flight_env(t, pc.state.position), frame_number())
                    if capture_circuit.phase != was_phase: print("CIRCUIT frame {frame_number()} {was_phase} -> {capture_circuit.phase} speed {true_speed(pc.spec, f64(length(pc.state.velocity))):.1} damage {pc.state.hull_damage:.3}")
                    pc.state = capture_circuit.state; pc.throttle = pc.state.throttle
                    pc.prop_angle+=dt*prop_rotation_speed(pc.state,pc.feedback.speed);pc.sea_t=t;feel(pc,dt,flight_env(t,pc.state.position).wind)
                else if capture_takeoff:
                    # (captures only: the take-off autopilot flies the player's aircraft)
                    # (a serviced aircraft: the save's wear kept off, so the engine gives its full power;
                    # AEGEAN_CAPTURE_TAKEOFF=worn keeps it)
                    rec=living_world.people[living_world.player].craft
                    if not capture_takeoff_worn and rec>=0:
                        if living_world.aircraft[rec].engine<1000:
                            living_world.aircraft[rec].engine=1000;living_world.aircraft[rec].hull=1000
                            pc.state.damage=DamageState();pc.state.hull_damage=0.0
                        # (held so every frame: the world's wear is synced onto the airframe now and then)
                        pc.state.damage.parts[int(PartId.engine)].health=1.0;pc.state.engine_damage=0.0
                    e=flight_env(t,pc.state.position)
                    # (AEGEAN_CAPTURE_TAXI: taxiing out until then, the take-off run after)
                    if capture_taxi_until>0.0 and t<capture_taxi_until: capture_takeoff_plan.phase=.taxi
                    else if capture_taxi_until>0.0 and capture_takeoff_plan.phase==.taxi: capture_takeoff_plan.phase=.takeoff
                    flown=if capture_landing:capture_landing_controls(pc,e) else if capture_takeoff_mouse:capture_mouse_controls(pc) else:autopilot(pc.spec,pc.state,capture_takeoff_plan,e)
                    if capture_watch!=none:
                        global judge_origin
                        judge_origin=pc.state.position
                    # (and, the air propeller in, the stick held back on the foils, as its plate's hint says)
                    if pc.spec.foils.len()>0 and pc.state.foil.air>=1.0 and pc.state.on_water:flown.pitch=max(flown.pitch,0.5)
                    pc.throttle=flown.throttle
                    step(pc.spec,pc.state,flown,e,dt)
                    pc.prop_angle+=dt*prop_rotation_speed(pc.state,pc.feedback.speed);pc.sea_t=t;feel(pc,dt,e.wind)
                else if capture_dogfight_pilot and ci>=0 and not pc.state.on_water:
                    # (captures only: the dogfight brain flies the player's aircraft into the melee)
                    global capture_trigger
                    e=flight_env(t,pc.state.position)
                    flown=combat_controls(battle,ci,e)
                    battle.actors[ci].pilot=flown;capture_trigger=flown.trigger
                    pc.throttle=flown.controls.throttle
                    step(pc.spec,pc.state,flown.controls,e,dt)
                    pc.prop_angle+=dt*prop_rotation_speed(pc.state,pc.feedback.speed);pc.sea_t=t;feel(pc,dt,e.wind)
                else:
                    # (the gamepad's take-off capture: a serviced aircraft too, flown by the controls)
                    if capture_takeoff_pad:
                        rec=living_world.people[living_world.player].craft
                        if rec>=0:
                            living_world.aircraft[rec].engine=1000;living_world.aircraft[rec].hull=1000
                            if frame_number()<3:pc.state.damage=DamageState()
                            pc.state.hull_damage=0.0
                            pc.state.damage.parts[int(PartId.engine)].health=1.0;pc.state.engine_damage=0.0
                        if trace and floor(t) != floor(t - dt): print("PAD t {t:.0} pitch {ctl.pitch:.2} roll {ctl.roll:.2} rudder {ctl.yaw:.2} throttle {pc.throttle:.2} device {ctl.active} {device_name(ctl.active)}")
                    orbit = pc.orbit_dist
                    if capture_mouse_track and ci>=0 and not pc.state.on_water: capture_aim_on_hostile(ci)
                    # (fighting: the guns unlocked, or a target's lead shown on the gunsight)
                    pc.fighting = not pc.guns_locked or lead_marks(battle, living_world.people[living_world.player].craft, pc.state.position, pc.state.velocity).len() > 0
                    fly(pc, dt, t)
                    pc.orbit_dist = wheel_kept(pc.orbit_dist, orbit, menus_open())
            if not dbg.no_damage: collide_vessels(vessels,pc.spec,pc.state,previous_vessel_contact,living_world.people[living_world.player].craft)
            set_drag_scale(1.0)
            set_damage_shield(false)
            pc.state.fuel = min(sandbox_fuel(fuel_before, pc.state.fuel, sandbox.no_fuel_use), max(pc.state.fuel, pc.spec.fuel_capacity))
            # into the water hard (falling fast): a column of spray thrown up all round, and the
            # aircraft driven under in the blink of an eye, to bob back up
            global plunge, plunge_v
            down = -f64(before.y)
            if down > 15.0 and abs(plunge) < 0.5 and plunge_v > -1.0:
                loop ev in pc.state.damage.events:
                    if ev.kind == .splash:
                        q = vec3(ev.position.x, f32(swell_at(f64(ev.position.x), f64(ev.position.z), t).x), ev.position.z)
                        plunge_v = -min(down, 90.0) * 0.7
                        emit(spray_ps, q, 220, 16.0 + down * 0.3, rgba(0.97, 0.99, 1.0, 0.95), 2.4, 1.8, 0.28, vec3(0, 1, 0))
                        emit(spray_ps, q, 120, 9.0 + down * 0.12, rgba(0.93, 0.97, 1.0, 0.85), 1.8, 1.2, 1.3, vec3(0, 1, 0))
                        break
            plunge_v += (-(2.6 * plunge) - 2.2 * plunge_v) * dt
            plunge += plunge_v * dt
            if abs(plunge) < 0.01 and abs(plunge_v) < 0.05:
                plunge = 0.0
                plunge_v = 0.0
            # the guns: Space in the air, or the left button once the game has the mouse
            # (not while slow, with the mouse orbiting the camera)
            held = (not tweaks.orbit_camera or not pc.slow) and ((vdown(.space) and not pc.state.on_water) or (mouse_down(.left) and is_mouse_locked() and not click_took_mouse))
            if capture_dogfight_pilot: held = capture_trigger
            if ci>=0:
                battle.actors[ci].pilot.trigger=held and me.mode==.aboard and not pc.state.crashed
                battle.actors[ci].gun.locked=pc.guns_locked
            if trace and floor(t) != floor(t - dt):
                st = pc.state
                f = quat_rotate(st.orientation, vec3(0, 0, -1))
                print("t {t:.0} spd {length(st.velocity):.1} alt {st.position.y:.1} pitch {asin(f64(f.y)) * 57.3:.0} aoa {st.aoa * 57.3:.0} thr {st.throttle:.2} water {st.on_water} stall {st.stalled} crash {st.crashed} cap {st.capsized} hull {st.hull_damage:.2} rough {weather_turbulence(st.position):.2} bodies {weather_bodies.len()}")
            chase(pc, dt)
            spray(pc, craft_models, spray_ps, dt)
            # what the aircraft hit: a splash, a crunch, parts tearing away; seen, heard and felt
            global slap_t
            loop ev in pc.state.damage.events:
                hard = clamp(log(1.0 + ev.strength / 2000.0) / 6.0, 0.0, 1.0)
                if hard < 0.05: continue
                crunch = ev.kind != .splash
                # (a float running fast slaps the water many times a second, each barely over the
                # threshold; as impacts their bursts lingered and strung out behind into long
                # white bands. Weak slaps throw spray a few times a second, short-lived; real
                # impacts are unchanged)
                weak = not crunch and hard < 0.1
                if weak and t - slap_t >= 0.0 and t - slap_t < 0.3: continue
                if weak: slap_t = t
                n = int(6.0 + 60.0 * hard)
                emit(spray_ps, ev.position, n, 4.0 + 14.0 * hard, rgba(0.96, 0.98, 1.0, 0.9), if weak: min(1.4, 12.0 / max(f64(length(pc.state.velocity)), 1.0)) else: 1.4, 0.6 + 0.8 * hard, 0.9, normalize(ev.normal + vec3(0, 1, 0)))
                if crunch: emit(spray_ps, ev.position, n / 2, 6.0 + 10.0 * hard, rgba(0.42, 0.3, 0.2, 1), 1.8, 0.25, PI, vec3(0, 1, 0))
                impact_sound(audio, ev.position, crunch, hard)
                # (the camera feels it: a jolt in its spring)
                pc.cam_ev += normalize(ev.impulse + vec3(0, 0.001, 0)) * f32(-3.0 * hard)
            vapor(pc, vapor_trails, hour, t)
            # (the trial: vapour over the wings in the hardest pulls in damp air)
            global pc_wing_vapour
            sheet_now = if tweaks.wing_vapour and not pc.state.on_water and pc.load > 5.0 and pc.feedback.speed > 38.0: wing_vapour_strength(pc.feedback.speed, pc.load, vapor_damp(pc, hour, t)) else: 0.0
            wing_vapour_step(pc_wing_vapour, sheet_now, t)
            act = if typing: "" else: offer_pressed(aboard_offers())
            if act == "rescue": do_rescue()
            if act == "rescue-free": do_rescue(free=true)
            else if act == "adrift-take": adrift_take()
            else if act == "adrift-line": adrift_line()
            else if act == "buoy":
                if let m = buoy_spot(): moor_on_buoy(m)
            else if act == "launch-ashore": start_launch(false)
            else if act == "lighter": call_lighter()
            else if act == "fuel": open_fuel_pier()
            else if act == "fetch" and stranded_on_land(): fetch_home()
            else if act == "tender-fuel": tender_fuel()
            else if act == "tender-duty": say_toast("The duty officer: {patrol_answer()}")
            else if act == "tender-hoist": tender_hoist_start(false)
            else if act == "tender-lower": tender_hoist_start(true)
            else if act == "tender-repair": tender_repair()
            else if act == "tender-out": tender_let_out()
            else if act == "ashore" and landplane_parked():
                step_ashore(pc.state.position + quat_rotate(pc.state.orientation, craft_models[pc.model].exit))
            else if act == "ashore" or act == "moor":
                if let ship_mooring = find_vessel_mooring(vessels,pc.state,pc.spec.span):
                    vessel_mooring = ship_mooring
                    if let point = vessel_mooring_point(vessels,vessel_mooring,pc.spec.span):
                        moor(pc.state,vec3(point.x,f32(pc.spec.float_height),point.z),heading(pc.state))
                        pc.throttle = 0.0
                        rope.tied = true; rope.anchor = point; was_moored = true
                else if let d0 = dock_spot():
                  if dock_taken(d0, others_at()): say_toast("That dock is taken")
                  else:
                    d = d0
                    moor_at_dock(pc,d)
                    pc.throttle = 0.0
                    tie_up()
                    step_ashore(d)
                    th = town_here(d)
                    if th >= 0: deliver_here(th)
                else if pc.state.moored and vessel_mooring.vessel < 0 and shore_point(towns, pc.state.position) != none: step_ashore(pc.state.position)
            if vpressed(.r) and (pc.state.crashed or pc.state.capsized or pc.state.beached) and not pc.spec.landplane:
                # (a seaplane: the R/T's call for help, a boat to tow her in)
                if sos.stage == .none: help_call(not help_in_reach())
            else if vpressed(.r) and (pc.state.crashed or pc.state.capsized or pc.state.beached): fetch_home()
    if was_moored and not pc.state.moored and rope.tied:
        was_moored = false
        off = vec3(pc.state.position.x - rope.anchor.x, 0, pc.state.position.z - rope.anchor.z)
        rope.loose = rope.anchor + normalize(off + vec3(0.001, 0, 0)) * 3.0
    if frame_number() % 30 == 7: refresh_buoys()
    if launch_capture != "": launch_capture_step()
    if help_capture != "": help_capture_step()
    if company_capture >= 0: company_capture_step()
    if tender_capture != "": tender_capture_step()
    swing_on_buoy(dt)
    lighter_step(dt)
    if patrol_capture != "" and active_scenario == "": patrol_capture_stage()
    patrol_step(dt)
    tender_step(dt)
    tender_xfer_step()
    help_step(dt)
    if not rope.tied and pc.state.moored and offshore == none: tie_up()
    dust_ps.update(dt)
    # debugging: F1 opens the panel; its standing switches
    if dbg.infinite_fuel:
        pc.state.fuel = pc.spec.fuel_capacity
        debug_fuel_ml(living_world.people[living_world.player].craft, int(pc.spec.fuel_capacity * 1000.0))
    if no_damage_now() and not pc.state.crashed:
        loop k in 0..pc.state.damage.parts.len():
            if pc.state.damage.parts[k].attached: pc.state.damage.parts[k].health = 1.0
    meadow_step(wind_now, f64(scene_camera().x), f64(scene_camera().z), dt)
    update_walkers(dt)
    if geography_enabled and (frame_number() % 20 == 0 or (ambient_town.settlement >= 0 and not ambient_town.done)): ambient_update(if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos)
    # the errands one carries: told, and written in the log, when they are done or missed
    loop id, was in my_jobs:
        if not (id in living_world.jobs): continue
        j = living_world.jobs[id]
        if j.state == was: continue
        my_jobs[id] = j.state
        rcv = living_world.people[portage.cargo_receiver(living_world,id)].name
        dest = SETTLEMENTS[j.destination].name
        now = clock_text(living_world, living_world.minute)
        match j.state:
            .delivered:
                say_toast("Delivered: {job_cargo(id)} to {rcv} at {dest}, {phoenix_text(j.paid_cents)}")
                log_note(notebook, "Delivered {job_cargo(id)} to {rcv} at {dest}. Paid {phoenix_text(j.paid_cents)}{if j.paid_cents < j.reward_cents: " (late)" else: ""}.", now)
            .failed:
                say_toast("The errand failed: {job_cargo(id)} for {rcv} at {dest}")
                log_note(notebook, "Failed: {job_cargo(id)} for {rcv} at {dest}.", now)
            .expired:
                say_toast("Too late: {job_cargo(id)} for {rcv} at {dest}")
                log_note(notebook, "Too late for {rcv} at {dest}: {job_cargo(id)}.", now)
            .cancelled:
                log_note(notebook, "Called off: {job_cargo(id)} for {rcv} at {dest}.", now)
            _: pass
    notebook.live = [loop id in my_jobs.keys(): if id in living_world.jobs and living_world.jobs[id].state == .claimed: "{job_cargo(id)}: {portage.cargo_status(living_world,id)}"]
    loop id in rescue_aboard(living_world): notebook.live.push("{rescue_aboard_name(living_world, id)}: aboard, to be set ashore at a harbour")
    if notebook.open and (notebook.fresh or frame_number() % 30 == 0): notebook.standing = rep_summary_lines(living_world) + standing_lines(living_world)
    if t - folk_sync_t > 2.0 and not world_held():
        # (the list drops those who have gone: the one in a conversation or at the ledger is
        # found again by who they are, not where they stood in it, or the panel closes)
        global folk_sync_t, ui_folk
        talking = if ui_folk >= 0 and ui_folk < folks.len(): folks[ui_folk].person else: -1
        sync_folk(folks, living_world, towns)
        if talking >= 0:
            ui_folk = -1
            loop k in 0..folks.len():
                if folks[k].person == talking: ui_folk = k
        folk_sync_t = t
    step_sea_navigation(vessels,if render_quality.tier == 0: 32 else: 64)
    if not world_held(): sync_canal_traffic(vessels,living_world)
    # (the Ierax lies at anchor in her bight: always in the fleet, as any anchored ship)
    if vessel_index(vessels, TENDER_ID) < 0: _ = spawn_vessel(vessels, tender_vessel())
    step_vessels(vessels,wind_now.dir*f32(wind_now.speed),dt,pc.state.position,pc.state.velocity)
    if active_scenario=="canal": canal_ride_launches(battle,vessels)
    if vessel_mooring.vessel >= 0:
        point = vessel_mooring_point(vessels,vessel_mooring,pc.spec.span)
        if not pc.state.moored or point == none:
            vessel_mooring = VesselMooring(); rope.tied = false
            if pc.state.moored: unmoor(pc.state)
        else:
            pc.state.position = vec3(point!.x,point!.y+f32(pc.spec.float_height),point!.z)
            k = vessel_index(vessels,vessel_mooring.vessel)
            pc.state.velocity = vessels.ships[k].velocity
            spec = vessel_spec(vessels.ships[k].kind)
            right = vec3(f32(cos(vessels.ships[k].yaw)),0,f32(-sin(vessels.ships[k].yaw)))
            rope.anchor = point!-right*f32(vessel_mooring.side*(pc.spec.span*0.55+3.0))+vec3(0,f32(spec.deck),0)
    tender_place_aircraft()
    if not world_held(): prepare_war_scene(living_world,vessels,battle,if me.mode==.aboard: pc.state.position else: me.pos)
    publish_vessel_targets(vessels,battle,vessel_bindings,if me.mode == .aboard: pc.state.position else: me.pos)
    battle.bullet_scale=bullet_scale
    pci=combat_index(battle,living_world.people[living_world.player].craft)
    if pci>=0:
        battle.actors[pci].spec=pc.spec
        configure_player_gun(battle.actors[pci],dbg.gun_choice,dbg.endless_ammunition or sandbox.endless_ammunition)
        if (pc.state.moored or no_damage_now()) and not battle.actors[pci].bailed:
            if pc.state.moored:sync_living_player(pc,living_world)
            battle.actors[pci].state=pc.state
            if no_damage_now():battle.actors[pci].fire=0;battle.actors[pci].fire_age=0
    zone("traffic and world")
    update_traffic(traffic,living_world,traffic_scene,if me.mode == .free: free.pos else: if me.mode==.aboard:pc.state.position else:me.pos,t,dt,pc.state,towns,battle,
        (events:CombatEvent[]):
            combat_effect_events(combat_visual,events,if me.mode==.aboard:living_world.people[living_world.player].craft else:-1)
            listener_index=combat_index(battle,living_world.people[living_world.player].craft)
            listener=if listener_index>=0:battle.actors[listener_index].state.position else:pc.state.position
            combat_near_passes(combat_visual,battle,if me.mode==.aboard:living_world.people[living_world.player].craft else:-1,listener)
            if combat_audio.guns.len()>0:combat_audio_passes(combat_audio,combat_visual.whizzes);combat_audio_snaps(combat_audio,combat_visual.snaps)
            if combat_audio.guns.len()>0:combat_audio_events(combat_audio,events,listener,if me.mode==.aboard:living_world.people[living_world.player].craft else:-1)
        ,(craft: int,spec: CraftSpec,state: CraftState,previous: vec3) -> CraftState:
            result = state
            collide_vessels(vessels,spec,result,previous,craft)
            result
        ,ships=[loop ship in vessels.ships:if ship.health>0.2:AirShip(ship.id,ship.position,ship.velocity)]
        ,other_air=[loop p in air_events.pilots:AirContact(p.craft,p.state.position,p.state.velocity,p.capital,p.state.on_water,p.state.moored)]
    )
    zone_end()
    if me.mode==.descent:
        loop mut d in battle.descents:
            if d.person!=living_world.player or d.released:continue
            # Follow the pose that this frame draws, once the combat clock has advanced.
            held=descent_camera.look.distance
            update_descent_camera(descent_camera,descent_render_pose(d,battle.render_alpha),dt,input=descent_camera.ready,ground=surface_height)
            descent_camera.look.distance=wheel_kept(descent_camera.look.distance,held,menus_open())
            if d.phase==.canopy:d.yaw=descent_camera.look.yaw
    when TARGET == "wasm": speech_loading.step_speech_warmup(living_world,speech_warmup)
    if active_scenario!="":commit_scenario_aircraft(living_world,battle)
    receive_vessel_hits(vessels,battle,vessel_bindings)
    # (while a world minute is in progress these scene-to-World syncs wait a frame or two)
    if not world_held():
        # (the launch or caique out to a boat adrift, and the boat on its line: src/adrift_help.jo)
        if adrift_help_step(adrift_help, vessels, living_world, if me.mode==.aboard: pc.state.position else: me.pos, _help_wind(), dt):
            say_toast("The boat is in at {help_harbour_name(adrift_help.last_harbour)}.")
            if capture_adrift != none: print("ADRIFT in at frame {frame_number()} state {living_world.adrift[0].state} place {living_world.people[living_world.adrift[0].person].place}")
        sync_workboat_vessels(vessels,vessel_bindings,living_world,dt,hidden_trip = adrift_help.hidden_trip)
        sync_far_vessels(vessels,living_world,if me.mode==.aboard: pc.state.position else: me.pos,if render_quality.tier==0: 6 else: 16,refresh=int(t*4)!=int((t-dt)*4),hidden=if sos.hidden >= 0: sos.hidden else: adrift_help.hidden)
        commit_war_scene(living_world,vessels,battle)
    ci=combat_index(battle,living_world.people[living_world.player].craft)
    if ci>=0:
        pc.state.damage=battle.actors[ci].state.damage
        refresh_damage(pc.spec,pc.state)
        if battle.actors[ci].bailed:pc.state=battle.actors[ci].state
    # Combat parts already supplied this tick's world condition; do not heal them through the
    # older nonlinear wear projection. Outside combat retain the existing service adapter.
    if ci<0 or (battle.actors[ci].last_attacker<0 and not battle.actors[ci].bailed):sync_living_player(pc,living_world)
    if not world_held() and (pc.state.crashed or pc.state.capsized or (ci >= 0 and battle.actors[ci].bailed)):
        _ = player_wreck_cargo(living_world, pc.state.position)
    if me.mode==.aboard:pc.jolt=max(pc.jolt,combat_visual.hit)
    update_combat_view(combat_visual,battle,wind_now_vec(),dt,scene_camera())
    if startup_aegean_runtime_trace!=none and floor(t)!=floor(t-dt):
        print("RUNTIME t={t:.3} dt={dt:.4} ticks={traffic_scene.frame_ticks} tick={battle.tick} actors={battle.actors.len()} rounds={battle.rounds.len()} ribbons={combat_visual.trails.ribbons.len()} flame={combat_visual.flame.items.len()} mist={combat_visual.mist.items.len()} spray={spray_ps.items.len()} lookv={length(pc.look_v):.3} came={length(pc.cam_e):.3} camv={length(pc.cam_ev):.3} physics={battle.physics_steps}")
    if combat_audio.guns.len()>0:update_combat_audio(combat_audio,battle,scene_camera())
    fight=active_scenario=="strait" or active_scenario=="canal"
    update_battle_radio(battle_radio,battle,living_world.player,audio_enabled and fight and me.mode==.aboard)
    # (the strait's and the canal's radio, and the Ierax's patrol's)
    if (fight or (active_scenario=="" and patrol.stage != .none)) and not world_held():
        hci=combat_index(battle,living_world.people[living_world.player].craft)
        update_homeward(homeward,battle,living_world,hci,pc.state.position,pc.state.on_water or pc.state.moored,t,dt,audio_enabled and me.mode==.aboard)
        situation_arrival(hci)
    if not world_held(): update_folk(folks, living_world, towns, if me.mode==.free:free.pos else:if me.mode == .aboard: pc.state.position else: me.pos, dt)
    # (the hotel's bar room: its places moved in out of sight, and the terrace's people drawn there)
    room_step(hotel, room_hour(), weather_here.rain, weather_here.storm, leisure.sitting == "hotel" or leisure.sitting == "bar" or leisure.sitting == "guest", scene_camera())
    room_place_folk(folks, hotel)
    update_walk_around(dt)
    cat_at = if me.mode == .aboard: pc.state.position else: me.pos
    cat_said = update_cats(cat_scene, town_cat_homes(cat_at, f32(CAT_SEEN)), cat_at, me.mode == .walking, mooring_anchor(), pc.state.position, presentation.cat_bonds, living_world.minute, (x: f64, z: f64) -> f64: walk_height(towns, x, z), dt, t)
    if cat_said != "": say_toast(cat_said)
    wild_view_warm()
    if not title.open:
        zone("wildlife")
        wildlife_step(wildlife, towns, scene_camera(), wild_threats(), vessels.ships, wild_env(), dt)
        wild_pod_place()
        dolphins_step(dolphins, wildlife, towns, scene_camera(), wild_threats(), vessels.ships, wild_env(), dt)
        # (AEGEAN_WILD_DOLPHIN_HOLD=1: the first pod's first dolphin held just out of the water, for
        # turnarounds of the model)
        if wild_dolphin_hold and dolphins.pods.len() > 0:
            dolphins.pods[0].dolphins[0].pos.y = 0.45; dolphins.pods[0].dolphins[0].vel.y = 0.0; dolphins.pods[0].dolphins[0].airborne = false
        wild_look_step()
        wild_pose_step()
        zone_end()
        if wild_trace and floor(t * 2.0) != floor((t - dt) * 2.0):
            up = 0; afloat = 0; feeding = 0
            loop r in wildlife.rafts:
                loop g in r.geese:
                    if g.act == .fly or (g.act == .run and f64(g.pos.y) > r.site.level + 0.3): up += 1
                    else if g.act == .upend: feeding += 1
                    else: afloat += 1
            gulls = 0; beasts = 0
            loop c in wildlife.colonies: gulls += c.gulls.len()
            loop h in wildlife.herds: beasts += h.beasts.len()
            perched = 0; gat = vec3(0, 0, 0)
            loop c in wildlife.colonies:
                loop g in c.gulls:
                    if g.act == .perch: perched += 1; gat = g.pos
                    else: gat = if perched == 0: g.pos else: gat
            print("WILD gulls perched={perched} at {gat.x:.1f} {gat.y:.1f} {gat.z:.1f} colonies={wildlife.colonies.len()}")
            racing = 0
            loop p in dolphins.pods:
                if p.mode == .race: racing += 1
            print("WILD dolphins pods={dolphins.pods.len()} n={dolphin_count(dolphins)} racing={racing} spray={dolphins.spray.len()} sites={dolphins.sites.len()}")
            print("WILD t={t:.1f} sites={wildlife.sites.len()} rafts={wildlife.rafts.len()} afloat={afloat} feeding={feeding} up={up} gulls={gulls} beasts={beasts} marks={wildlife.marks.len()} calls={wildlife.calls_made} hits={world_ambience.sound.hits.len()} pending={world_ambience.sound.pending.len()}")
    if cat_capture != "": cat_capture_update()
    welcome_frame(dt)
    handover_frame()
    delivery_trace_step()
    # A contact/bark event commits words once; drawing the bubble only reads them.
    if me.mode == .walking and ui == .none and not world_held():
        k = nearest_folk(folks,me.pos,7.0)
        if k >= 0 and welcome_active(living_world) and folks[k].person == living_world.welcome.greeter: k = -1
        if k >= 0 and t-folks[k].line_t > 20.0:
            speaker = folks[k].person
            awaited = portage.cargo_awaited(living_world,speaker)
            if speaker in ride_owed:
                folks[k].line = ride_gave_up_line(living_world.people[speaker].traits.boldness < 450)
                ride_owed.remove(speaker)
            else if awaited >= 0:
                folks[k].line = if let e = errand_of(living_world,awaited): errand_waiting(living_world,e) else: "Is that {job_cargo(awaited)} from {split(living_world.people[living_world.jobs[awaited].poster].name, " ")[0]}?"
            else:
                folks[k].line = ""
                _ = chat_at(speaker,folks[k].place,false)
            folks[k].line_t = t
        else if k >= 0 and folks[k].line == "" and t >= storm_check_at:
            _ = chat_at(folks[k].person,folks[k].place,false,warnings_only=true)
    if not world_held(): update_air_events(air_events,living_world,craft_models,pc.state.position,me.mode==.aboard and not help_wreck(),other_air=[loop tr in traffic:if tr.visible:AirContact(tr.craft,tr.state.position,tr.state.velocity,tr.town,tr.state.on_water,tr.state.moored)])
    else:
        # (while a world minute is in progress the club and the air arm fly on, as the scene's traffic does)
        held_air=[loop tr in traffic:if tr.visible:AirContact(tr.craft,tr.state.position,tr.state.velocity,tr.town,tr.state.on_water,tr.state.moored)]
        if me.mode==.aboard: held_air.push(AirContact(living_world.people[living_world.player].craft,pc.state.position,pc.state.velocity,parked=pc.state.moored))
        step_air_events_held(air_events,living_world,craft_models,living_world.tick+traffic_scene.held_ticks,held_air)
    if let stage = capture_race: stage_capture_race(stage, dt)
    if let stage = war_stage_pending:
        if living_world.far.populated and living_world.far.place_ids.len() > 6:
            global war_stage_pending
            war_stage_pending = none
            if stage == "board" or stage == "contract": living.advance_minutes(living_world,180)
            stage_capture_war(stage)
            global war_chart
            war_chart = WarChart()
            print("WAR STAGE at frame {frame_number()}")
    all_air_traffic=traffic+air_event_traffic(air_events,living_world,craft_models)+(if active_scenario!="":scenario_air_traffic(living_world,battle) else:if patrol.stage != .none: scenario_air_traffic(living_world,battle,SORTIE_ENGAGEMENT) else:[])+capture_racers
    pilot_livery_remap()
    # Relevance is refreshed at 2.5 Hz; selected moving bodies are followed every frame.
    if me.mode==.aboard:
        target_scan-=dt
        if target_scan<=0:
            refresh_targets(view_target,view_candidates(living_world,battle,all_air_traffic,vessels,pc.state.position,living_world.people[living_world.player].craft))
            target_scan=0.4
        if view_target.selected>=0:
            item=view_target.items[view_target.selected]
            if item.kind==0:
                ci=combat_index(battle,item.id)
                if ci>=0:item.position=combat_render_state(battle.actors[ci],battle.render_alpha).position
                else:
                    loop tr in all_air_traffic:if tr.craft==item.id:item.position=tr.state.position;break
            else if item.kind==2:
                vi=vessel_index(vessels,item.id)
                if vi>=0:item.position=vessels.ships[vi].position
            view_target.items[view_target.selected]=item
        if not show_chart and ui==.none and not notebook.open and not typing:
            if key_pressed(.tab):cycle_target(view_target)
            if key_pressed(.c):toggle_target(view_target)
            target_touch(view_target,pad.held.contains(.tab),dt)
        else:view_target.held=0;view_target.long_press=false
        eye=if pc.cockpit_view:cockpit_eye(craft_models[pc.model],pc.state) else:pc.cam_pos
        normal=if pc.cockpit_view:quat_rotate(pc.state.orientation,vec3(0,0,-1)) else:pc.look
        step_target_view(view_target,eye,normal,dt)
    else:view_target=TargetView();target_scan=0
    loop wakes.len()<all_air_traffic.len()+1:wakes.push(WakeTrail())
    update_air_view(air_visual,all_air_traffic,wind_now_vec(),if me.mode==.aboard:pc.state.position else:me.pos,dt)
    # skimming: fast within about a span of the water, the downwash churns it and throws spray
    water_under=f64(swell_at(craft_point(pc.state).x,craft_point(pc.state).z,t).x)
    gap = f64(pc.state.position.y) - pc.spec.float_height - water_under
    skim = if pc.state.on_water or pc.state.moored: 0.0 else: skim_amount(pc.spec, gap, pc.state.velocity)
    under = craft_offset(pc.state,vec3(-pc.state.velocity.x*0.15,f32(water_under+0.1)-pc.state.position.y,-pc.state.velocity.z*0.15))
    wake_step(wakes[0], under, pc.state.velocity, pc.state.on_water and not pc.state.moored, wake_width(pc.kind), t, skim)
    if skim > 0.1 and me.mode == .aboard: emit(spray_ps, under, int(1.0 + skim * 4.0), 3.0 + 6.0 * skim, rgba(0.96, 0.98, 1.0, f32(0.5 + 0.4 * skim)), 1.2, 0.5 + 0.6 * skim, 0.7, normalize(vec3(-pc.state.velocity.x, 30.0, -pc.state.velocity.z)))
    loop k in 0..all_air_traffic.len():
        tr = all_air_traffic[k]
        wake_step(wakes[k + 1], craft_point(tr.state), tr.state.velocity, tr.state.on_water and not tr.state.moored, wake_width(tr.kind), t)
    if trace and floor(t / 10.0) != floor((t - dt) / 10.0):
        print("living minute {living_world.minute}, tick {living_world.tick}")
        loop id in living_world.far.near_people:
            a=living_world.far.people[id];p=living_world.people[id]
            print("  resident {id} {p.name}: {a.anchor} at={p.pose.pos} target={a.target} blocked={a.blocked} commission={a.commission}")
        loop id,intent in living_world.daily_life:
            if intent.venue==.seat or intent.venue==.laundry or intent.venue==.oven: print("  domestic {id}: {intent.anchor} at={living_world.people[id].pose.pos} target={intent.target} arrived={intent.arrived} blocked={intent.blocked}")
        loop tr in traffic: print("  craft {tr.craft} / {tr.name}: {if tr.flying: (if tr.materialized: str(tr.plan.phase) else: "abstract") else: "moored"} -> {towns[tr.town].name} at {tr.state.position.x:.0} {tr.state.position.y:.0} {tr.state.position.z:.0}; {tr.why}")
        loop id, trip in living_world.trips:
            if trip.state == .arrived: print("  committed arrival {id}: {living_world.people[trip.actor].name} at {towns[trip.destination].name}")
    if judge_trace:
        global judge_frame
        judge_frame+=1
        if active_scenario!="" and judge_frame%60==0:
            shots=0;forming=0
            loop a in battle.actors:
                shots+=a.gun.shots
                if a.pilot.formation:forming+=1
            print("BATTLE seconds={t:.2} actors={battle.actors.len()} forming={forming} shots={shots} rounds={battle.rounds.len()}")
        if judge_frame%9==0:
            st=pc.state
            print("FLIGHT,{judge_frame},{t:.3},{st.position.x:.3},{st.position.y:.3},{st.position.z:.3},{st.velocity.x:.3},{st.velocity.y:.3},{st.velocity.z:.3},{asin(f64(forward(st).y)):.5},{st.throttle:.3},{st.on_water},{st.crashed},{st.hull_damage:.3}")
    spray_ps.update(dt)
    smoke_ps.update(dt)
    flying = me.mode == .aboard
    where = if flying: pc.state.position else: me.pos
    shore = abs(f64(surface_height(f64(where.x), f64(where.z)))) * 8.0 + (if flying: f64(where.y) * 2.0 else: 0.0)
    # (the sounds go by the speed as designed: true speed / the speed scale)
    if not title.open:
        update_audio(audio, dt, flying and not pc.state.moored, pc.state.throttle, if flying: pc.feedback.speed else: 0.0, shore, not flying, where, pc.kind, if flying: pc.feedback else: FlightFeedback(), in_descent=me.mode==.descent)
    # (a storm heard from the aircraft: rain on it, gusting wind, thunder after the strikes)
    raining = if weather_active and f64(where.y) < f64(weather_here.ceiling+weather_here.storm*5200.0): f64(weather_here.rain) else: 0.0
    storm_sound_step(storm_audio, flying and not pc.state.moored, pc.cockpit_view, raining, if flying: f64(weather_turbulence(pc.state.position)) else: 0.0, f64(length(pc.state.velocity)), where, weather_seconds)
    # (behind the title the world is heard only through the title's own sound)
    if not title.open:
        world_ambience.sound.enabled = dbg.snd_world
        ear = scene_camera()
        world_ambience.indoors = hotel_zone(hotel, ear) == .indoors
        if ambience_trace and frame_number() % 120 == 0:
            playing = [loop v in world_ambience.sound.loops: "{v.source.kind}:{v.level:.3}:{v.source.soft:.2}:{f64(length(v.source.pos-ear)):.0}m"]
            offered = [loop v in world_ambience.sound.sources: "{v.kind}:{v.gain:.3}"]
            print("AMBIENCE frame {frame_number()} ear {ear.x:.0},{ear.y:.1},{ear.z:.0} hour {f64(lt.local_minute(living_world.minute))/60.0:.1} indoors {world_ambience.indoors} loops {playing} offered {offered} hits {world_ambience.sound.hits.len()}")
        ambience_scene_step(world_ambience,living_world,vessels,towns,groves,ear,dt,flying,wind_now_vec(),if flying: pc.state.position else: none,time_lapse=presentation.thermal.active)
        wildlife_voices(world_ambience,wildlife,ear)
        life_audio.update_life_audio(life_sound,living_world,ear,t,dbg.snd_world[3],flying,
            (a: vec3,b: vec3) -> f64: ambience_obstruction(a,b,towns))
        if me.mode == .aboard and not cockpit_radio.muted:
            radio.radio_receive(cockpit_radio,dt,living_world.minute,pc.state.position,height)
            broadcast.radio_update_content(cockpit_radio,radio_bulletin,living_world)
        # (the band heard from where the camera is: which way it faces, the hotel's walls, the town in
        # between, the terrace or the quay; close by, the harbour's background hushes a little)
        heard = band_hearing(hotel, ear, ear_forward, if f64(length(ear - hotel.stage)) < 150.0: ambience_obstruction(hotel.stage + vec3(0, 1.6, 0), ear, towns) else: 0.0)
        global band_heard
        band_heard = heard
        world_ambience.sound.duck = if bar_band_position(living_world.band, living_world.tick).playing: live_duck(heard) else: 1.0
        bar_music_update(bar_music, bar_band_position(living_world.band, living_world.tick), heard, audio_enabled)
        band_step(dt)
        if listen_mode != "" and frame_number() % 60 == 0: print("LISTEN frame {frame_number()} distance {heard.distance:.1f} pan {heard.pan:+.2f} front {heard.front:+.2f} occlusion {heard.occlusion:.2f} zone {heard.zone} duck {world_ambience.sound.duck:.2f} voice {bar_music.voice} playing {bar_band_position(living_world.band, living_world.tick).playing}")
        cockpit_radio.volume = radio_knob_level()
        radio.radio_play(cockpit_radio,f64(living_world.tick)/60.0,me.mode == .aboard,
            not pc.state.moored,pc.state.throttle,audio_enabled)
        # the other aircraft's engines, heard from where their sound left them, Doppler and all
        hear_engines(hearing, [loop tr in all_air_traffic: EngineSource(tr.craft, tr.state.position, tr.state.velocity,
            if tr.flying and tr.state.throttle < 0.05: 0.7 else: f64(tr.state.throttle),
            not tr.state.moored and (tr.flying or tr.state.throttle > 0.02 or f64(length(tr.state.velocity)) > 0.5),
            engine_tone(tr.kind, tr.craft), true_speed(tr.spec, f64(length(tr.state.velocity))), voice = aircraft_profile(tr.kind).voice,point=craft_point(tr.state))], scene_camera(), if me.mode == .aboard: pc.state.velocity else: vec3(0, 0, 0), t,world_offset(world_point(scene_camera()),render_eye_low))
    queue_autosave(dt)
    set_tweaks(dbg.tweaks)
    set_fdm2_tuning(dbg.fdm2)
    set_options(dbg.opts)
    # (the sandbox's unlimited money: the purse held, through the world's own books; in the game
    # itself, not a situation's world, and never in the middle of a world minute)
    if active_scenario == "" and not world_held():
        global purse_hold
        purse_hold = sandbox_money_step(living_world, purse_hold, sandbox.unlimited_money)
    # (AEGEAN_SANDBOX_TRACE: a line a second for the probes: the purse, the tank, the airframe)
    if sandbox_trace and floor(t) != floor(t - dt): print("SANDBOX t={t:.0} purse={player_cents()} own={sandbox_own_cents(player_cents(), purse_hold)} lent={purse_hold.lent} fuel={pc.state.fuel:.3} hull_damage={pc.state.hull_damage:.3} crashed={pc.state.crashed} books={launches.ledger_balances(living_world)}")
    set_walk_left(dbg.opts.walk_left)
    audio.air_on = dbg.snd_air
    audio.cloth_on = dbg.snd_cloth
    audio.frame_on = dbg.snd_frame
    if flying:
        air = true_speed(pc.spec, f64(length(pc.state.velocity - wind_now_vec())))
        airframe_sounds(audio, air, if pc.state.on_water: 1.0 else: pc.load, air, dt, pc.feedback.glide)
    else: airframe_sounds(audio, 0.0, 1.0, if me.mode == .walking: wind_now.speed else: 0.0, dt)
    # Nearby meadow geometry follows walking and low flight.
    global grass_actor, grass_contact_radius, grass_airflow
    grass_actor = if me.mode == .aboard: pc.state.position else: me.pos
    grass_contact_radius = if me.mode == .aboard: f32(pc.spec.span*0.7) else: 1.2
    grass_airflow = vec3(0,-1,0)
    if me.mode == .aboard:
        direction = normalize(forward(pc.state).xz)
        grass_airflow = vec3(direction,f32(clamp(pc.state.throttle*(1.0-pc.state.engine_damage)+f64(length(pc.state.velocity))*0.006,0.0,1.3)))
    # The next field is made a slice a frame, begun 6 m on (half the old refresh distance) so it
    # is whole before the walker nears the edge of the one drawn. Always in slices (a whole field
    # at once was a frame of 25-200 ms on a slow laptop): on foot with no field near yet, or after
    # a jump clean out of the old one (a load, a jump), in the arrival's larger slice until it is
    # whole; a field is made around an aircraft standing on the water, so the one stepping ashore
    # near it finds theirs begun.
    global grass,grass_job,grass_was_walking,grass_arriving
    grass_moved = f64(length(grass.center.xz-grass_actor.xz))
    afloat = me.mode == .aboard and (pc.state.on_water or pc.state.moored) and length(pc.state.velocity) < 3.0
    # (a jump only from a field made: before the first one, its centre is no place the walker was,
    # and every frame read as a jump restarted the build, which then never finished: 12 ms a frame
    # on a phone for as long as one walked; a build under way restarts below if one leaves its reach)
    jumped_on_foot = grass_was_walking and grass.built and grass_moved > grass.resident_radius
    grass_was_walking = me.mode == .walking
    if (me.mode == .walking or afloat or (me.mode == .aboard and f64(grass_actor.y)-surface_height(f64(grass_actor.x),f64(grass_actor.z))<25.0)) and (grass_needs_refresh(grass,grass_actor,scene_camera()) or (grass.built and grass_moved > 6.0)):
        if me.mode == .walking and ((not grass.built and not grass_job.active) or jumped_on_foot):
            # (no field near, or a jump out of it: made in the arrival's larger slice, as the
            # terrain is after a jump; whole at once it was up to 200 ms stepping ashore)
            grass_job = grass_build_start(towns, grass_actor); grass_arriving = true
        else if not grass_job.active or f64(length(grass_job.center.xz-grass_actor.xz)) > grass_job.radius: grass_job = grass_build_start(towns, grass_actor)
    if grass_job.active:
        zone("grass build")
        # (a field falling behind a fast walker gets a wider slice before the drawn one runs out)
        behind = grass_moved > max(12.0,grass.resident_radius-f64(grass_forward_reach())-6.0)
        # (both within the frame's room: a fixed 8 ms behind kept slow frames over 50 ms for seconds)
        slice = if grass_arriving: max(GRASS_ARRIVAL_SECONDS, build_slice(GRASS_BUILD_SECONDS)) else: build_slice(if behind: 0.008 else: GRASS_BUILD_SECONDS)
        if grass_build_step(towns, grass_job, time()+slice):
            grass = grass_build_finish(grass_job); grass_job = GrassBuild(); grass_arriving = false
        zone_end()

# ---------------- draw ----------------

craft_matrix = (m: Moored) -> mat4:
    bob = sin(t * 1.3 + f64(m.pos.x)) * 0.12
    roll = sin(t * 0.9 + f64(m.pos.z)) * 0.03
    translation(m.pos + vec3(0, f32(2.1 + bob), 0)) * rotation_y(m.yaw) * rotation_z(roll)

# where the player's aircraft is drawn: riding the swell when moored, driven under in a plunge
# the title reel's race: the pylon, and the two racers with their propellers turning
draw_title_race = (L: Light, t: f64):
    if title_now.pylon: draw_instanced(obj_inst_sh, air_meet_view.pylon, [Instance3D(translation(title_now.pylon_at), vec4(1, 1, 1, 1))], obj_params(L, t))
    loop k in 0..title_now.racers.len():
        racer = title_now.racers[k]
        m = craft_models[racer.model]
        at = translation(racer.at) * quat_to_mat4(racer.turn)
        anchor = world_point(racer.at)
        at[3] = vec4(0, 0, 0, 1)
        # (their airframes working as any aircraft's do: bowing in the pull, buffeting, fluttering at speed)
        flex = airframe_cues(title_airframe_spec(racer.kind), racer.velocity, racer.load, false, racer.throttle)
        draw(obj_sh, m.body, obj_params(L, t, at, flex = flex, anchor = anchor))
        if not queue_prop_discs(m, at, anchor, t * 78.0 + f64(k), 78.0, L, t, TITLE_RACER_KEY - k): draw_craft_props(m, L, t, at, t * 78.0 + f64(k), anchor)
    # (the racers' vapour)
    if title_shot.pace == 2 and title_shot.kind == .low: draw_custom((): draw_trails(title_vapour, L, t), transparent = true)
    if title_shot.pace == 2 and title_shot.kind == .low and (title_wing_vapour[0].amount > 0.0 or title_wing_vapour[1].amount > 0.0): draw_custom((): draw_title_wing_vapour(L), transparent = true)
    # (the merge's tracers, drawn as the battle draws its own)
    if title_now.rounds.len() > 0:
        g = Guns()
        loop o in title_now.rounds: g.bullets.push(Bullet(o.at, o.velocity, o.age, true))
        draw_tracers(g, title_shot.round_scale)
    # (and the guns' flashes, on the aircraft as it flies, as the battle draws them)
    if title_shot.shots.len() > 0:
        muzzle = WorldParticles()
        loop n in 0..title_shot.shots.len():
            o = title_shot.shots[n]
            ago = title_shot_age - f64(o.w)
            if ago < 0.0 or ago > 0.065 or title_shot.shot_by[n] >= title_now.racers.len(): continue
            at = title_now.racers[title_shot.shot_by[n]].at + title_shot.shot_off[n]
            distance = f64(length(at - scene_camera()))
            if distance < 11000.0: muzzle.items.push(WorldParticle(at, vec3(0, 0, 0), 1, 1, f32(max(0.6, min(9.0, distance * 0.002))), rgba(1, 0.8, 0.3, 1), precise = world_point(at), published = at, ready = true))
        if muzzle.items.len() > 0: draw_curved_particles(muzzle, true)
const TITLE_RACER_KEY = -1001   # (the racers' own keys for their propellers and engines, never a craft's)
# a title aircraft's spec by its kind, made once (for its airframe's working as it is drawn)
title_airframe_specs: {int: CraftSpec} = {}
title_airframe_spec = (kind: int) -> CraftSpec:
    global title_airframe_specs
    if let s = title_airframe_specs.get(kind): return s
    s = craft_spec(Craft(kind), craft_models[default_craft_model(Craft(kind))].contacts)
    title_airframe_specs[kind] = s
    s

# how fast the eye moves: the water's flecks streak and strengthen with it (the reel's camera
# behind the title, the aircraft when aboard, still on foot)
view_velocity = () -> vec3: if title.open: title_now.velocity else: if me.mode == .aboard: pc.state.velocity else: vec3(0, 0, 0)

# The air at the airfield nearest the camera, for its windsocks (the flight model's own wind).
airfield_wind = () -> vec3:
    k = nearest_airfield(scene_camera().xz)
    if k < 0: return vec3(0, 0, 0)
    pos = vec3(AIRFIELDS[k].center.x, 150, AIRFIELDS[k].center.y)
    if weather_active: weather_flight_wind(pos) else: vec3(wind_now.dir.x, 0, wind_now.dir.y) * f32(wind_now.speed * 0.7)

pc_at = () -> mat4:
    if tender_hoist == 2:
        deck_pose = vessel_pose(tender_vessel(),t,wind_now_vec().xz)
        return deck_pose*translation(tender_local_of(pc.state.position))*rotation_y(-heading(pc.state)-TENDER_YAW)
    translation(vec3(0, f32(plunge), 0)) * (if pc.state.moored: afloat_transform(craft_transform(pc),t) else: craft_transform(pc))

cloud_frame_list: CloudVolume[]
# the vapour over the wings, the player's (a trial) and the title racers'
draw_pc_wing_vapour = (L: Light):
    vs: TrailVertex[]
    wing_vapour_add(vs, pc.spec, pc.state, pc_wing_vapour.amount, part_health(pc.state.damage, .left_wing) > 0, part_health(pc.state.damage, .right_wing) > 0, render_origin(scene_camera()), t)
    draw_wing_vapour(vs, L)

draw_title_wing_vapour = (L: Light):
    vs: TrailVertex[]
    origin = render_origin(scene_camera())
    loop i in 0..min(2, title_now.racers.len()):
        racer = title_now.racers[i]
        wing_vapour_add(vs, title_airframe_spec(racer.kind), CraftState(position = racer.at, orientation = racer.turn), title_wing_vapour[i].amount, true, true, origin, t)
    draw_wing_vapour(vs, L)

draw_world = (L: Light):
    global cloud_cull,cloud_frame_list
    if not effect_pipelines_ready:
        # Prepare the actual transparent-pass blend/target variant once. Vulkan
        # otherwise compiles it and serializes its pipeline cache on first use.
        draw_custom(():
            global effect_pipelines_ready
            warm_up(prop_disc_shader)
            warm_up(local_particle_sh)
            when TARGET == "wasm":
                # warm_up is a native API. WebGL also needs a real first draw
                # to prepare ANGLE's pipeline, even after shader linking. These
                # zero-area instances run the programs without covering pixels.
                origin=render_origin(scene_camera());vp=render_view_proj(origin)
                draw_instanced(prop_disc_shader,prop_disc_mesh,[PropDiscInstance(model=scaling(vec3(0,0,0)))],PropDiscParams(clouds=cloud_veil,vp=vp,cam=render_eye(origin)))
                draw_instanced(local_particle_sh,local_particle_mesh,[LocalParticle(half=0)],LocalParticleParams(clouds=cloud_veil,vp=vp))
            effect_pipelines_ready = true
        ,transparent=true)
    # One cloud list a frame: its shadows are drawn before the ground and water.
    # The cloud list is rebuilt every third frame on low and medium: clouds
    # move little in a frame and the view cull keeps an 18 degree margin for turning.
    if legacy_clouds: cloud_frame_list = []
    else if render_quality.tier == 2 or frame_number()%3 == 0 or cloud_frame_list.len() == 0:
        cloud_cull = cloud_frame_cull(L)
        cloud_frame_list = world_clouds(scene_camera(),WorldPoint(wind_drift(wind_now).x*0.35,0,wind_drift(wind_now).z*0.35))
        # (the title's vista: its tower, standing where the shot put it)
        if title.open:
            if let tower = title_tower: cloud_frame_list.push(tower)
        cloud_weather_bodies(cloud_frame_list,scene_camera())
    frame_clouds = cloud_frame_list
    draw_custom(():
        render_cloud_shadows(frame_clouds,L)
        clear_depth())
    draw_custom(():
        bow = transform_point(afloat_transform(craft_transform(pc),t), rope_bow())
        draw_rope(rope, pc.state.moored, bow, L, t)
        launches.draw_launch(launch_view, launch, L, t)
        launches.draw_lighter(launch_view, lighter, L, t)
        # (the Ierax's brow across to the aircraft alongside, while the rescued go up it)
        loop m in buoys_near: launches.draw_buoy(launch_view, m.at, L, t)
        # (the Ierax's trot of mooring buoys astern of her, past the booms)
        if f64(length(scene_camera() - TENDER_AT)) < 4000.0:
            loop k in 0..TENDER_SLOTS:
                if not tender_on_boom(k): launches.draw_buoy(launch_view, tender_slot(k), L, t))
    draw_custom((): zone("sky");draw_sky(L, t);zone_end())
    draw_custom((): zone("far sea");draw_far_sea(depth_tex, L, t, wind_now);zone_end())
    draw_custom(():
        zone("inland scenery prep");prepare_inland_scenery(scene_camera());zone_end()
        zone("town view prep");prepare_town_view(towns,scene_camera());zone_end())
    # (the towns near the camera before the ground and the land behind them: what a house hides
    # isn't shaded first and then painted over, so a town in view costs its own pixels only; far
    # towns, often behind a hill, after it, which hides them)
    draw_custom(():
        zone("towns")
        draw_towns(towns, L, t, 1)
        if geography_enabled:
            zone("ambient crowd")
            ambient_draw(scene_camera(), L, t, hour)
            zone_end()
        if not (stay.active and stay.kind == .hotel):
            draw_hotel(hotel, leisure_light(L, hotel), t)
            loop shed in paint_sheds: draw_paint_shed(shed, L, t)
            draw_bar_room(hotel, L, t)
        draw_coffee_house(coffee, leisure_light(L, hotel, coffee.seat), t)
        if me.mode==.walking: trace_walk_precision(walker_point,follow,follow_frame,towns)
        zone_end())
    draw_custom(():
        zone("river occlusion");draw_river_occlusion(depth_tex,L,t);zone_end()
        draw_river_banks(L,t)
        zone("lake banks");draw_lake_banks(L,t);zone_end()
        draw_canal(L,t)
        draw_slip_cradle(L,t)
        zone("thermal");draw_thermal(L,t);draw_bath_people(L);zone_end()
        zone("airfields");draw_airfields(L,t,airfield_wind());zone_end()
        zone("access bridges");draw_access_bridges(L,t);zone_end()
        zone("working land");draw_working_land(tree_meshes,L,t);zone_end()
        zone("ground");draw_ground(L, t);zone_end()
        draw_world_terrain(L, t)
    )
    draw_custom(():
        zone("far towns")
        draw_world_towns(towns, L, t)
        draw_towns(towns, L, t, 2)
        zone_end())
    cam_now = scene_camera()
    draw_custom(():
        zone("ships")
        prepare_vessel_view(vessel_view,vessels,cam_now,t,wind_now.dir*f32(wind_now.speed))
        draw_vessels(vessel_view,L,t)
        # and those tied up along the quays, riding the swell too
        loop tw in towns:
            if f64(length(tw.center - cam_now)) > 6000.0: continue
            loop b in tw.boats: draw(obj_sh, b.mesh, obj_params(L, t, afloat_transform(translation(b.at),t)))
        zone_end()
    )
    draw_custom((): draw_birds(bird_mesh, flocks, L, t))
    if not title.open: draw_custom(():
        zone("wildlife view");draw_wildlife(wildlife, L, t);draw_dolphins(dolphins, L, t);zone_end())
    draw_custom(():
        draw_groves(tree_meshes, groves, L, t)
        draw_world_groves(tree_meshes,L,t))
    draw_custom(():
        loop m in moored:
            cm = craft_models[m.model]
            at = craft_matrix(m)
            draw(obj_sh, cm.body, obj_params(L, t, at))
            draw_craft_props(cm, L, t, at, 0.4)
            draw_craft_gear(cm, L, t, at)
        Lw = leisure_light(L, hotel, coffee.seat)
        hide_company_folk()
        hide_ride_folk()
        draw_folk(folks, Lw, t, band.kit)
        draw_company(Lw)
        draw_ride_walking(Lw)
        draw_rider_out(Lw)
        draw_tender_xfer(Lw)
        draw_adrift_line()
        draw_leisure(Lw)
        draw_cats(cat_scene, L, t)
        zone("life");life_view.draw_life(living_world,life_meshes,L,t);zone_end()
        zone("cargo");cargo_view.draw_cargo(living_world,cargo_meshes,L,t);zone_end()
        loop k in 0..board_spots.len():
            tw = towns[k]
            draw(obj_sh, board_mesh, obj_params(L, t, translation(board_spots[k]) * rotation_y(atan2(f64(tw.out.x), f64(tw.out.y)))))
        loop k in 0..walkers.len():
            w=walkers[k]
            if length(w.pos-scene_camera())<600.0:draw_local_walker(w.fig,WALK_OTHER-3*k,w.pos,w.yaw,w.phase,if w.wait>0.0:0.0 else:0.8,L,t)
        if me.mode == .walking and gaze.active:
            # (the view is his own, looking up: he isn't drawn, or his cap and goggles fill it)
            pass
        else if me.mode == .walking and swim.active and (swim.swimming or swim.diving >= 0.0):
            # (along the water, or upright treading it; bobbing on the swell)
            lean = if swim.diving >= 0.0: 1.2 + swim.diving * 0.4 else: 1.35 - 1.05 * swim_tread
            bob = vec3(0, f32(sin(t * 1.9) * 0.035 - 0.5 * swim_tread), 0)
            draw_figure(player_figure(), me.pos + bob, me.yaw, swim.stroke, swim.effort, Lw, t, offset=world_residual(walker_point), posture=5, lean=lean)
        else if me.mode == .free and sos.aboard:
            # (taken off a wreck: climbing across, then seated on the boat or in the second seat)
            seat = help_seat_pose()
            age = t - sos.climbed
            swim_way = help_swim_to - help_in_water
            swim_yaw = atan2(f64(swim_way.x), f64(swim_way.z))
            if age < DROP_OFF:
                # (down off the wreck into the water)
                p = rider_climb_point(help_from, help_in_water - vec3(0, 1.3, 0), age / DROP_OFF)
                draw_figure(player_figure(), p, swim_yaw, t * 3.0, 0.3, Lw, t, offset=world_residual(world_point(p)), arms=vec2(2.6, 2.6))
            else if age < DROP_OFF + help_swim_s:
                # (swimming across in the vest, on the swell)
                p = mix(help_in_water, help_swim_to, f32((age - DROP_OFF) / max(help_swim_s, 0.1)))
                sw = swell_at(f64(p.x), f64(p.z), t)
                draw_figure(player_figure(), vec3(p.x, sw.x - 0.5, p.z), swim_yaw, t * 2.2, 0.7, Lw, t, offset=world_residual(world_point(p)), posture=5, lean=1.35)
            else if age < DROP_OFF + help_swim_s + CLIMB_ACROSS:
                # (up the side and in)
                k = (age - DROP_OFF - help_swim_s) / CLIMB_ACROSS
                p = rider_climb_point(help_swim_to - vec3(0, 1.3, 0), seat.0 - vec3(0, 0.4, 0), k)
                draw_figure(player_figure(), p, swim_yaw, t * 3.0, 0.3, Lw, t, offset=world_residual(world_point(p)), arms=vec2(2.6, 2.6))
            else if let at = help_boat_seat_model():
                draw_figure_at(player_figure(),at,0,0,Lw,t,posture=1,render_local=true)
            else: draw_figure(player_figure(), seat.0, seat.1, 0.0, 0.0, Lw, t, offset=world_residual(world_point(seat.0)), posture=1)
        else if me.mode == .free and launch.active:
            # (riding the harbour launch: seated on its foredeck, facing forward)
            at = launches.launch_model(launch,t,render_origin(scene_camera()))*translation(launches.launch_seat_local())*rotation_y(PI)
            draw_figure_at(player_figure(),at,0,0,Lw,t,posture=1,render_local=true)
        # (out of sight in the bathhouse's cabin while he changes)
        else if me.mode == .walking and bath.stage == .changing: pass
        else if me.mode == .walking: draw_figure(player_figure(), me.pos, me.yaw, me.phase, player_stride(), Lw, t, carrying=holding_cargo() >= 0,offset=world_residual(walker_point),posture=(if bath.stage == .getting_in or bath.stage == .getting_out or picnic.active: 1 else: player_posture()),settle=(if bath.stage == .getting_in or bath.stage == .getting_out: bath.settle else: if picnic.active: clamp(picnic.settle, 0.0, 1.0) else: 1.0),arms=(if picnic_biting(): vec2(-9, 2.25) else: if let ap = pilot_arm_pose(): vec2(-9, f32(ap.angle)) else: fish_arms()),elbows=vec2(0,f32(if let ap = pilot_arm_pose(): ap.bend else: 0.0)),reach=(if let ap = pilot_arm_pose(): ap.reach else: 0.0),twist=(if let ap = pilot_arm_pose(): ap.twist else: 0.0),shoulder=pilot_shoulder)
        draw_traffic(all_air_traffic,craft_models,L,t,battle,1800)
        draw_air_meets(air_meet_view,air_events,L,t)
        draw_club_tables(L)
        if title.open: draw_title_race(L,t)
        draw_air_far(air_visual,all_air_traffic,L,t,battle)
        ci=combat_index(battle,living_world.people[living_world.player].craft)
        left=ci>=0 and battle.actors[ci].bailed
        draw_combat_aircraft(combat_visual,battle,craft_models,L,t,if left:-1 else:living_world.people[living_world.player].craft)
        if active_scenario=="strait" and ci>=0:
            draw_homeward_pilots(homeward,battle,battle.actors[ci].side,surface_height,L,t)
            draw_homeward_signal(homeward,battle,t,L.fog_density,pc.state.position)
        draw_ground_fire(battle,L,t,(id: int)->mat4?:
            slot = CANAL_LAUNCH_GUN-id
            if slot < 0 or slot >= CANAL_VESSELS: return none
            ship = vessel_view.poses.get(CANAL_VESSEL_BASE+slot) ?? return none
            ship*translation(vec3(0,f32(vessel_spec(.canal_launch).deck),0))
        )
        pm = player_model()
        at = pc_at()
        if not left:
            if me.mode==.aboard and pc.cockpit_view:draw_cockpit_airframe(pm,pc.state,at,L,t,pc.prop_angle,prop_disc_speed(pc.state,pc.feedback.speed))
            else:
                local_at=at;local_at[3]=vec4(0,plunge,0,1)
                anchor=craft_point(pc.state)
                if pc.state.moored:
                    anchor=world_offset(anchor,at[3].xyz-pc.state.position)
                    local_at[3]=vec4(0,0,0,1)
                look_capture(look_craft)
                draw_craft_parts(pm,pc.state.damage,local_at,L,t,pc.prop_angle,airframe(pc),pc.state.gear,anchor,prop_speed=prop_disc_speed(pc.state,pc.feedback.speed),prop_key=living_world.people[living_world.player].craft)
                look_capture(false)
            draw_debris(pm,pc.state.damage,L,t)
            # (tuning: a cowling panel swung open on the side he works)
            if job.active and job.task == .tune and job.leg < job.legs.len() and job.legs[job.leg].kind == .work:
                l = plane_layout()
                side = if job.legs[job.leg].target.x < 0: -1.0 else: 1.0
                draw(obj_sh, cowling_panel, obj_params(L, t, at * translation(l.engine + vec3(f32(side * l.engine_radius), f32(l.engine_radius * 0.55), 0)) * rotation_z(side * 2.0)))
            if ci>=0:draw_player_hit_marks(combat_visual,battle.actors[ci],at,L,t,me.mode==.aboard and pc.cockpit_view)
            if me.mode==.aboard and pc.cockpit_view:draw_cockpit(cockpit_model,pm,pc.spec,pc.state,at,L,t,pc.last,bullet_scale,pc.instruments,cockpit_radio.khz,not cockpit_radio.muted,cockpit_radio.strength,pc.prop_angle,prop_disc_speed(pc.state,pc.feedback.speed),living_world.people[living_world.player].craft,radio_knob_level(),fuel_reading()/max(pc.spec.fuel_capacity,0.001))
        if me.mode == .aboard and not pc.cockpit_view: draw_figure_at(me_fig, at * translation(pm.cockpit - vec3(0, 1.55, 0)), 0.0, 0.0, L, t, seated = true,offset=world_residual(craft_point(pc.state)))
        draw_ride_seated(pm, at, L)
        draw_rider_seated(pm, at, L)
        if me.mode != .free or length(scene_camera() - grass.center) < 300.0: draw_grass(tuft, grass, L, t)
    )
    if legacy_clouds: draw_custom((): draw_clouds(puff_mesh,puffs,L,WorldPoint(wind_drift(wind_now).x*0.35,0,wind_drift(wind_now).z*0.35),t))
    # shadows of the aircraft near the camera: the film's flat, crisp silhouettes (src/craft_shadow.jo),
    # on whatever lies under them; outside its mask, or without post-processing, on the sea drawn by the
    # sea itself and on land flattened meshes
    sea_sh = SeaShadows()
    cam = scene_camera()
    land: (CraftState, CraftModel)[]
    crisp = craft_shadow_available() and not craft_shadow_old
    craft_shadow_begin(if me.mode == .aboard: pc.state.position else: cam, L.sun_dir)
    loop k in 0..all_air_traffic.len() + 1:
        st = if k == 0: pc.state else: all_air_traffic[k - 1].state
        cm = if k == 0: player_model() else: craft_models[all_air_traffic[k - 1].model]
        if length(st.position - cam) > 1500.0: continue
        sd = normalize(L.sun_dir)
        if sd.y < 0.08: continue
        under = st.position - sd * f32(f64(st.position.y) / max(f64(sd.y), 0.2))
        g = surface_height(f64(under.x), f64(under.z))
        hgt = f64(st.position.y) - max(g, 0.0)
        if crisp and craft_shadow_covers(st.position, craft_shadow_reach(cm)):
            craft_shadow_add(translation(st.position) * quat_to_mat4(st.orientation), cm.body, hgt, f64(st.position.y) + craft_shadow_lowest(cm), f64(sd.y))
            continue
        a = 0.55 * (1.0 - smoothstep(60.0, 420.0, hgt)) * smoothstep(0.08, 0.2, f64(sd.y))
        if g > 0.3:
            land.push((st, cm))
            continue
        m = translation(st.position) * quat_to_mat4(st.orientation)
        loop j in 0..cm.shade.len() / 2: add_sea_shadow(sea_sh, m, cm.shade[j * 2], cm.shade[j * 2 + 1], L.sun_dir, a)
    snapshot_water_depth()
    draw_custom((): draw_sea(sea_mesh, depth_tex, L, t, wind_now, view_velocity(), sea_sh), transparent = true)
    draw_custom((): draw_rivers(depth_tex,L,t,view_velocity()),transparent=true)
    draw_custom((): zone("lakes");draw_lakes(depth_tex,L,t,view_velocity());zone_end(),transparent=true)
    draw_custom((): zone("thermal water");draw_thermal_water(depth_tex,L,t);zone_end(),transparent=true)
    draw_custom(():
        loop sc in land:
            st, cm = sc
            sd = normalize(L.sun_dir)
            g0 = max(surface_height(f64(st.position.x), f64(st.position.z)), 0.0)
            under = st.position - sd * f32((f64(st.position.y) - g0) / max(f64(sd.y), 0.2))
            g = max(surface_height(f64(under.x), f64(under.z)), 0.0)
            draw_curved_shadow(cm.body, translation(st.position) * quat_to_mat4(st.orientation), g + 0.4, f64(st.position.y) - g, L)
    , transparent = true)
    draw_splashes(pc,craft_models[pc.model],pc_at(),spray_ps,L,t,me.mode==.aboard)
    draw_spindrift(spindrift,L,t)
    if not legacy_clouds:
        draw_cloud_layer(frame_clouds,L)
    else:draw_custom((): prepare_cloud_transparency(),transparent=true)
    draw_splash_dust(spray_ps)
    if startup_aegean_nowake == none:
        draw_custom((): draw_wakes(wakes, L, t), transparent = true)
        if title.open and title_shot.kind == .low and title_shot.pace == 2: draw_custom((): draw_wakes(title_wakes, L, t), transparent = true)
        draw_custom((): draw_vessel_wakes(vessel_view,L,t), transparent = true)
        draw_vessel_spray(vessel_spray,L,t)
        draw_custom((): draw_wildlife_marks(wildlife, L, t), transparent = true)
    draw_custom((): draw_vessel_smoke(vessel_view,L,t), transparent = true)
    if me.mode == .aboard: draw_custom((): draw_flight_effects(pc,craft_models[pc.model],pc_at(),L,t),transparent=true)
    draw_custom((): draw_prop_discs(L),transparent=true)
    draw_curved_particles(smoke_ps, false)
    zone("thermal steam");draw_thermal_steam(t,L);zone_end()
    draw_curved_particles(dust_ps, false)
    draw_combat_particles(combat_visual,battle)
    draw_air_view(air_visual,all_air_traffic,L,t)
    # Navigation lights after dark on every aircraft and vessel in view.
    nav_ci=combat_index(battle,living_world.people[living_world.player].craft)
    draw_nav_lights(L,pc,not(nav_ci>=0 and battle.actors[nav_ci].bailed),all_air_traffic,battle,if vessel_view.drawn.len()==vessels.ships.len(): vessel_view.drawn else: vessels.ships)
    draw_help_flare(L)
    # (the cloth streams out by the drawn speed, as soon as the takeoff run gets going, and its
    # flutter builds all the way to the drawn top speed in a dive, so it doesn't saturate early)
    cloth_vel = pc.state.velocity
    cloth_top = max(1.3 * pc.spec.max_speed, 95.0)
    # (each on its strut: on the aircraft, or gone with a lost part while it is drawn falling or
    # afloat; once that piece is gone, none)
    sm = craft_models[pc.model]
    streamers = cloths_for(sm.streamers)
    kept = [loop k in 0..streamers.len() if streamer_place(sm, pc.state.damage, k) == -1: streamers[k]]
    draw_custom((): draw_cloths(cloth_mesh, kept, pc_at(), wind_now_vec() - cloth_vel, L, t, cloth_top))
    loop k in 0..streamers.len():
        i = streamer_place(sm, pc.state.damage, k)
        if i < 0: continue
        b = pc.state.damage.debris[i]
        at = debris_matrix(sm, b); air = wind_now_vec() - b.velocity; one = [streamers[k]]
        if k == 0: draw_custom((): draw_cloths(streamer_lost_l, one, at, air, L, t, cloth_top))
        else: draw_custom((): draw_cloths(streamer_lost_r, one, at, air, L, t, cloth_top))
    # (the pilot's scarf, on him wherever he is: in the cockpit in the aircraft's wind, ashore in
    # the wind and his own walking; lit as he is, by the lanterns near the hotel after dark too,
    # and kept outside him, going with his torso as he walks, sits or kneels)
    if me.mode == .aboard and not pc.cockpit_view:
        seat = pc_at() * translation(craft_models[pc.model].cockpit - vec3(0, 1.55, 0)) * scaling(f64(me_fig.height))
        draw_custom((): draw_cloths(scarf_mesh, pilot_scarf(), seat, wind_now_vec() - cloth_vel, L, t, cloth_top, offset=world_residual(craft_point(pc.state)), back=f64(me_fig.back)))
    # (not while he lies back looking at the stars, or swims)
    # (nor in his bathing suit at the springs: the scarf stays with his clothes in the cabin)
    else if me.mode == .walking and not presentation.thermal.active and not gaze.active and not swim.active and not bath.costume and bath.stage != .changing:
        fwd = vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw)))
        fig = player_figure()
        body = translation(me.pos) * rotation_y(me.yaw + PI) * scaling(f64(fig.height)) * figure_pose(fig, me.phase, player_stride(), player_posture())
        if pilot_shoulder!=0.0:body=body*rotation_y(pilot_shoulder)
        draw_custom((): draw_cloths(scarf_mesh, pilot_scarf(0.75), body, (wind_now_vec() - fwd * f32(me.stride * 3.0)) * 2.2, leisure_light(L, hotel, coffee.seat), t,offset=world_residual(walker_point), back=f64(fig.back)))
    # (bailed out, falling and under his canopy: the scarf goes with him, as the figure is drawn
    # there, src/combat_view.jo; not left in the cockpit)
    else if me.mode == .descent:
        loop original in battle.descents:
            if original.person != living_world.player or original.released or original.phase == .swimming: continue
            d=descent_render_pose(original,battle.render_alpha)
            jumper = descent_frame(d) * scaling(f64(combat_visual.pilot.height))
            draw_custom((): draw_cloths(scarf_mesh, pilot_scarf(), jumper, wind_now_vec() - d.velocity, L, t, cloth_top, offset=world_residual(descent_point(d)), back=f64(combat_visual.pilot.back)))

    draw_custom((): draw_trails(vapor_trails,L,t),transparent=true)
    if pc_wing_vapour.amount > 0.0: draw_custom((): draw_pc_wing_vapour(L), transparent = true)
    if not room_camera_inside(hotel): draw_custom((): draw_rain(L,if me.mode==.aboard: pc.state.velocity else: vec3(0,0,0)),transparent=true)
    draw_custom((): draw_lightning(L),additive=true)
    # (a stay's room over everything, its own depth: the town's walls never show through it)
    if stay.active: draw_custom((): draw_stay(L))
    if me.mode==.aboard and pc.cockpit_view and weather_active and scene_camera().y < weather_here.ceiling+weather_here.storm*5200.0:
        draw_custom(():
            frame = cockpit_frame(craft_models[pc.model],pc.state,pc_at())
            draw_windscreen_rain(cockpit_view_proj(L,t,frame),frame,weather_here.rain,length(pc.state.velocity),L.haze,weather_seconds)
        ,transparent=true)

# AEGEAN_FRAMES_ONLY=1 (with AEGEAN_FRAMES="dir from to step"): only the frames saved are drawn, so a
# time-lapse clip renders a sixth (or whatever the step) of its frames (captures; the software
# renderer's time goes on the frames kept). The world runs on between them as ever.
frames_only = env("AEGEAN_FRAMES_ONLY") != none
frame_kept = () -> bool:
    if let spec = capture_frames:
        words = split(spec, " ")
        if words.len() == 4:
            frame = frame_number(); from = to_int(words[1]) ?? 0; until = to_int(words[2]) ?? 0; every = max(1, to_int(words[3]) ?? 1)
            # (and every frame of the four seconds before the first: the land and the towns about
            # loaded and drawn by then, as they are only when frames are drawn)
            return (frame >= from and frame <= until and (frame - from) % every == 0) or (frame >= from - 240 and frame < from)
    true

draw = ():
    global render_eye_low,hour
    if frames_only and not frame_kept(): return
    if title.open and title_prep < 2:
        draw_title_prep()
        quality_next_frame()
        return
    render_eye_low=vec3(0,0,0)
    # (behind the title: the reel's shot, in its own light; the world's own hour is put back
    # after the frame)
    world_hour=hour
    if title.open: hour=title_now.hour
    L = weather_light(light_at(hour,sky_days_override ?? f64(living_world.minute)/1440.0),if title.open: title_now.eye else: if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos)
    # (the day's air: clear, hazy, dusty, humid or washed, src/day_air.jo)
    L = day_air_light(L,day_air_kind(int(floor(sky_days_override ?? f64(living_world.minute)/1440.0)),weather_here.rain,weather_here.deck,weather_here.clarity))
    L = sea_storm_light(L,f64(scene_camera().y))
    if startup_aegean_clear_air != none: L.fog_density = 0.0
    clear(BLACK)
    sun(L.sun_dir, L.sun, 0.0)
    hide_sky()
    fog(L.haze, L.fog_density, 0.0012)
    post_effects(0.35, 0.85, 0.22, 1.08, scene_depth = true)
    global ear_forward
    match me.mode:
        .free:
            render_camera(free.pos, forward(free), 62.0, 1.0, world_far(f64(free.pos.y)))
            ear_forward = forward(free)
        .aboard:
            if pc.cockpit_view:
                head=head_shake(pc,t)
                place_cockpit_camera(craft_models[pc.model],pc.state,pc.look_yaw,pc.look_pitch,t,pc.jolt,bullet_scale,combat_visual.recoil,view_target.bearing,view_target.weight,pc_at(),head.0,head.1);remember_screen_axes(pc)
            else:place_chase_camera(pc,t,view_target.bearing,view_target.weight,towns)
            if capture_post>=0 and capture_post<battle.ground.len():
                g=battle.ground[capture_post];toward=normalize(pc.state.position-g.position)
                back=normalize(vec3(toward.x,0,toward.z)+vec3(0.0001,0,0))
                eye=g.position-back*4.5+vec3(0,1.8,0)+normalize(cross(back,vec3(0,1,0)))*3.0
                look=pc.state.position-eye
                if capture_post_look:
                    # (beside the post, looking at the man himself)
                    eye=g.position+normalize(cross(back,vec3(0,1,0)))*4.0-back*1.5+vec3(0,0.3,0)
                    look=g.position-vec3(0,0.5,0)-eye
                precise_camera(world_point(eye),look,55.0,0.3,world_far(f64(eye.y)))
            ear_forward = if pc.cockpit_view: quat_rotate(pc.state.orientation, vec3(0, 0, -1)) else: pc.look
        .descent:
            place_descent_camera(descent_camera,world_far(f64(me.pos.y)))
            ear_forward=descent_direction(descent_camera)
        _:
            # (after a few strong drinks, a gentle sway: Options can turn it off)
            sway = if options.tipsy_sway: leisure_sway(living_world, leisure) else: 0.0
            view = follow
            if stay.active:
                stay_camera()
                ear_forward = stay_look() - stay_eye()
            else if gaze.active:
                gaze_camera()
                ear_forward = gaze_dir(gaze)
            else if tavli_camera():
                ear_forward = tavli_across() - coffee.seat
            else if ui == .leisure and leisure_ui == 12 and not skip.active:
                # (the barber's glass: the pilot's face, seen from the mirror)
                barber_camera()
                ear_forward = barber_face() - hotel.barber_mirror
            else if ui == .paint and not skip.active:
                # (the paint shop: round the aircraft at the berth, beside the shop's panel)
                paint_shop_camera()
                ear_forward = pc.state.position - scene_camera()
            else if leisure.sitting != "" and t < served_look_until and leisure_ui != 1:
                # (what was ordered arriving: the table seen from across it, the pilot beyond)
                top = service_spots(leisure.sitting).table
                across = normalize(vec3(top.x - me.pos.x, 0, top.z - me.pos.z) + vec3(0.0001, 0, 0))
                side = vec3(-across.z, 0, across.x)
                eye = top + across * 1.45 + side * 0.45 + vec3(0, 0.8, 0)
                render_camera(eye, top + vec3(0, 0.12, 0) - across * 0.3 - eye, 56.0, 0.05, world_far(f64(eye.y)))
                ear_forward = top - eye
            else if sway > 0.0:
                view.yaw += sway * 0.05 * sin(t * 0.61)
                view.pitch += sway * 0.025 * sin(t * 0.47 + 1.3)
            if not (leisure.sitting != "" and t < served_look_until and leisure_ui != 1) and not (ui == .leisure and leisure_ui == 12 and not skip.active) and not (ui == .leisure and leisure_ui == 7 and tavli_window().w > 0.0 and coffee.ok) and not gaze.active and not stay.active and not (ui == .paint and not skip.active):
                place_local_follow(view,follow_frame,58.0,0.3,world_far(f64(me.pos.y)))
                ear_forward = aim(view) - position(view)
    if startup_aegean_target_frames!=none and me.mode==.aboard:
        draw_custom(():
            origin=render_origin(scene_camera());vp=render_view_proj(origin)
            clip=vp*vec4(world_local(craft_point(pc.state),origin),1)
            ahead=dot(view_target.bearing,forward(pc.state))
            clearance=f64(scene_camera().y)-f64(swell_at(f64(scene_camera().x)+f64(render_eye_low.x),f64(scene_camera().z)+f64(render_eye_low.z),t).x)
            print("TARGET {frame_number()} {view_target.selected} {view_target.weight:.5} {ahead:.5} {view_target.bearing.y:.5} {clip.x/clip.w:.5} {clip.y/clip.w:.5} {clearance:.4}")
        )
    if let eye=wild_watch:
        render_camera(eye,wild_watch_target()-eye,50.0,0.1,world_far(f64(eye.y)))
    if let view=wild_racecam_view():
        render_camera(view.0,view.1-view.0,55.0,0.05,world_far(f64(view.0.y)))
    if let view=wild_portrait_view():
        render_camera(view.0,view.1-view.0,wild_portrait_fov,0.05,world_far(f64(view.0.y)))
    if let view=wild_chase_view():
        render_camera(view.0,view.1-view.0,50.0,0.1,world_far(f64(view.0.y)))
    if let view=judge_camera:
        delta=if me.mode==.aboard:pc.state.position-judge_origin else:vec3(0,0,0)
        camera3d(view.eye+delta,view.target+delta,62.0,0.1,world_far(f64(view.eye.y+delta.y)))
        ear_forward = view.target - view.eye
    if title.open:
        # (the merge at the chase camera's own field of view, where its fixed rig starts)
        render_camera(title_now.eye,title_now.dir,title_fov(title_base_fov(),title_aspect()),if title_shot.kind==.low: 0.3 else: 1.0,world_far(f64(title_now.eye.y)),title_now.up)
        ear_forward=title_now.dir
    if me.mode == .aboard:
        pp = pc.state.position
        hgt = f64(pp.y) - pc.spec.float_height - max(surface_height(f64(pp.x), f64(pp.z)), 0.0)
        set_scene_flow(pc.state.velocity, hgt)
        # (the stretch trial: as strong as the near boost, up to 4.5 times, growing with the speed,
        # reaching farther the higher one flies)
        sp = f64(length(vec3(pc.state.velocity.x, 0, pc.state.velocity.z)))
        k = if speed_mode == 3: 1.0 + (min(near_boost, 4.5) - 1.0) * clamp((sp - 10.0) / 75.0, 0.0, 1.0) else: 1.0
        set_scene_warp(pp, pc.state.velocity, k, 400.0 + 3.0 * max(hgt, 0.0))
    else:
        set_scene_flow(vec3(0, 0, 0), 0.0)
        set_scene_warp(vec3(0, 0, 0), vec3(0, 0, 0), 1.0, 400.0)
    # (a low pass streams the sea's flecks past as flight does; a paced aircraft is the player's
    # own, drawn where the reel puts it for this frame only)
    if title.open:
        set_scene_flow(title_now.velocity,title_now.height)
        if title_now.paced:
            # (kept through the frame: the aircraft is drawn after draw() returns; the next
            # update puts the real one back)
            global title_kept
            if title_kept==none:title_kept=pc.state
            pc.state=CraftState(position=title_now.pace_at,orientation=title_now.pace_turn,velocity=title_now.velocity*f32(title_now.pace_speed/max(f64(length(title_now.velocity)),1.0)),
                fuel=pc.spec.fuel_capacity,throttle=1.0)
    # (AEGEAN_NO_WORLD: the interface over a blank sky, no world drawn: tests that work the menus
    # under software rendering, tests/gamepad_play_test.py)
    if not world_hidden: draw_world(L)
    if me.mode == .aboard and not world_hidden: draw_flight_lens(pc,if scene_camera().y < weather_here.ceiling+weather_here.storm*5200.0: f64(weather_here.rain) else: 0.0,t)
    # Upscale the finished scene; overlays retain their existing logical coordinates.
    full_resolution()
    when TARGET == "wasm":
        if not page_shown and not (title.open and title_first_waiting()):
            global page_shown
            page_shown=true
            __aegean_shown()
    if frame_number() == title_check: print("TITLE_CHECK frame {frame_number()} open {title.open} names {title_name_draws} over_play {if title.open: 0 else: title_name_draws - names_at_play}")
    if title.open:
        draw_title_screen()
        if let directory=title_frames:
            if frame_number()%title_frame_step==0:save_png("{directory}/{title_shot.kind}-{frame_number():05}.png",screenshot())
        if capture_audio: capture_audio_frame()
        hour=world_hour
        quality_next_frame()
        return
    # (play begun from the title: the scene comes up out of the dusk it left)
    # (over the whole window, letterbox and all, as the title's dusk was)
    if t-title_left_at<0.7: rect(visible_rect(),rgba(0.075,0.1,0.15,f32(1.0-smoothstep(0.0,0.7,t-title_left_at))))
    # (tests: the title's layers in the first seconds of play, AEGEAN_TITLE_PICK)
    if title_handover_frame >= 0 and frame_number() > title_handover_frame and frame_number() <= title_handover_frame + 120 and frame_number() % 10 == 0:
        print("TITLE_LAYERS play frame {frame_number() - title_handover_frame}: open {title.open} leaving {title_leaving != none} dusk {1.0 - smoothstep(0.0, 0.7, t - title_left_at):.2} panel {title.page}")
    # (a test's choice made: done once its two seconds of play are read, software rendering being
    # slow; a new game once its first autosave is made too, for Continue to load next)
    if title_pick_asked and title_handover_frame >= 0 and frame_number() >= title_handover_frame + 120:
        if not title_pick_new or saved_toast_at > title_left_at or frame_number() >= title_handover_frame + 900: quit()
    # (the clock and the purse in the top right corner: not while the pause menu covers it)
    set_font(fonts.ui)
    clock_size = readable(22.0)
    clock_words = "{int(hour):02}:{int((hour - floor(hour)) * 60.0):02}"
    # (a soft dark plate behind the clock and the purse: cream on a bright sky was about 2:1, on
    # the plate about 4.5:1)
    if not dbg.open:
        corner_w = max(text_width(clock_words, clock_size), ptext_width(phoenix_text(player_cents()), readable(20.0))) + 20.0
        rect_rounded(f64(screen_width()) - 14.0 - corner_w, 12.0, corner_w, 18.0 + clock_size + readable(20.0), 8, rgba(0.03, 0.05, 0.08, 0.4))
    if not dbg.open: text(clock_words, vec2(f32(f64(screen_width()) - 24.0 - text_width(clock_words, clock_size)), 18), clock_size, rgba(1, 1, 1, 0.85), shadow = rgba(0, 0, 0, 0.4))
    set_font()
    draw_music_cues()
    draw_tip_thanks()
    draw_company_talk()
    draw_waiter_ask()
    draw_ride_talk()
    draw_bath_talk()
    gleam_step(frame_time())
    draw_foot_label()
    draw_gleams()
    # money
    set_font(fonts.ui)
    # (the purse: the phoenix in gold over its flame, the figure in cream, flush under the clock)
    purse = phoenix_text(player_cents())
    purse_size = readable(20.0)
    if not dbg.open: ptext(purse, vec2(f32(f64(screen_width()) - 24.0 - ptext_width(purse, purse_size)), f32(24.0 + clock_size)), purse_size, rgba(1, 0.95, 0.8, 0.85), shadow = rgba(0, 0, 0, 0.4), sign = PHOENIX_GOLD, fire = PHOENIX_FLAME)
    set_font()
    # the people about: names over those near, a line from whoever is nearest (not through the
    # pause menu, the chart or the notebook)
    if me.mode == .walking and ui == .none and not paused and not show_chart and not notebook.open:
        k = nearest_folk(folks, me.pos, 7.0)
        near: (f64, int)[]
        loop i in 0..folks.len():
            f = folks[i]
            if not f.shown or i == k: continue
            d = f64(length(f.pos - me.pos))
            if d < 16.0: near.push((d, i))
        near.sort((e: (f64, int)): e.0)
        tags: Rect[]
        loop e in near: name_tag(fonts, folk_view_position(folks[e.1]) + vec3(0, 1.7, 0), living_world.people[folks[e.1].person].name, e.0, tags)
        if k >= 0 and not (welcome_active(living_world) and folks[k].person == living_world.welcome.greeter):
            d = f64(length(folks[k].pos - me.pos))
            words = if not town_speech.seated and town_speech.speaker == folks[k].person: town_speech.turn.opening else: folks[k].line
            speech_bubble(fonts, folk_view_position(folks[k]) + vec3(0, 1.7, 0), living_world.people[folks[k].person].name, words, d, 8.0)
    # Deterministic typography capture, using the real projected speech widget.
    if startup_aegean_capture_panel == "speech":
        speech_bubble(fonts, me.pos + vec3(0,1.7,0), "Nikos", "The fishing boats are back in the harbour.", 2.0, 8.0)
    if me.mode == .walking: cargo_view.draw_cargo_targets(living_world)
    match me.mode:
        .walking:
            if ui != .none or skip.active: pass
            else if sos.by==.search:prompt_card(fonts,help_card())
            # (in the water by the things themselves: the steps are the way out, and time passes of
            # itself; a pad keeps its cards, its buttons going by them; F, T and R work as ever)
            else if presentation.thermal.active and bath.stage==.soaking and not ctl.used: pass
            else if presentation.thermal.active:
                if presentation.thermal.sleeping:prompt_card(fonts,"Resting until morning",190)
                else:
                    prompt_card(fonts,"F  spend an hour in the water",190)
                    prompt_card(fonts,if lt.local_minute(living_world.minute)<1080:"T  stay until evening" else:"T  stay until morning",140)
                prompt_card(fonts,if presentation.thermal.sleeping:"R  leave the inn" else:"R  leave the waters",90)
            else if gaze.active: draw_gaze_sky()
            else if swim.active and swim_prompt() != "" and not swim_prompt().starts_with("F "): prompt_card(fonts, swim_prompt())
            # (a capture's judging camera isn't the pilot's view: the pilot's cards aren't shown)
            else if judge_camera == none: draw_offers(if ctl.used: walk_offers() else: shown_offers(walk_offers()), 90.0)
        .aboard:
            if sos.stage != .none and sos.stage != .done and sos.by != .wingman: prompt_card(fonts, help_card(), 180.0)
            else if pc.state.crashed or pc.state.capsized: prompt_card(fonts, if pc.spec.landplane: "Wrecked.  R  to be towed to the aerodrome" else: "Wrecked.  R  call for help", 180.0)
            else if pc.state.beached: prompt_card(fonts, if pc.spec.landplane: "Run aground.  R  to be towed to the aerodrome" else: "Run aground.  R  call for help", 180.0)
            else if t < meet_fuel_until: prompt_card(fonts, meet_fuel_card, 180.0)
            else: draw_offers(aboard_offers(), 196.0)
        .descent:
            if not skip.active:
                if sos.stage != .none and sos.by!=.search: prompt_card(fonts, help_card(), 150.0)
                draw_offers(descent_offers(), 90.0)
        .free:
            if launch.active:
                if not skip.active: prompt_card(fonts, if launch.outward: "F  skip the ride out" else: "F  skip the ride ashore", 90.0)
            else if sos.aboard:
                if not skip.active and help_card() != "": prompt_card(fonts, help_card(), 90.0)
            else: text("{free.pos.x:.0} {free.pos.y:.0} {free.pos.z:.0}", vec2(16, 16), 18, rgba(1, 1, 1, 0.7))
    if (active_scenario=="strait" or (active_scenario=="" and patrol.stage != .none)) and (me.mode == .aboard or me.mode == .walking): draw_homeward(homeward,fonts,t)
    if me.mode == .aboard and rt.open:
        chosen = draw_rt_pad(rt, fonts, t, pad.on)
        if chosen >= 0: rt_send(chosen)
    # (the R/T plate: by the radio in the cockpit, at the left otherwise, while there is a flight to hear)
    if me.mode == .aboard and not rt.open and pad.on and (rt_flight() > 0 or help_need_now() != .none or sos.stage != .none):
        # (beside the throttle's top, clear of its label and handle)
        tr = throttle_track()
        plate = if let r = radio_hit_rect: Rect(r.x, r.y - 42, 76, 36) else: Rect(tr.x + tr.w + 24, tr.y, 76, 36)
        rect_rounded(f64(plate.x), f64(plate.y), f64(plate.w), f64(plate.h), 5, rgba(0.05, 0.07, 0.10, 0.7))
        text_centered("R/T", vec2(plate.x + plate.w * 0.5, plate.y + plate.h * 0.5), 17, rgba(1, 0.97, 0.9, 0.9))
        tap_card(plate, .y)
    draw_welcome()
    global radio_hit_rect
    radio_hit_rect = none
    if me.mode == .aboard:
        on_ways=slip.active and active_scenario=="canal"
        aim_marks(pc,not pc.cockpit_view and not on_ways)
        if not pc.state.on_water and not pc.state.moored and not show_chart and not on_ways:
            draw_lead_marks(lead_marks(battle,living_world.people[living_world.player].craft,pc.state.position,pc.state.velocity))
            draw_ally_marks(ally_marks(battle,living_world.people[living_world.player].craft,pc.state.position),pc.state.position,forward(pc.state))
        if pc.cockpit_view:
            radio_hit_rect = cockpit_radio_rect(craft_models[pc.model],pc_at(),craft_point(pc.state))
            # (a finger on the radio: a tap steps the stations, a drag turns the volume)
            if let radio_hit=radio_hit_rect:tap_card(radio_hit,.f8)
        st = pc.state
        # (the speedometer reads the true speed)
        if show_chart: pass
        else if not pc.cockpit_view and tweaks.pure_scale: instruments(fonts, true_speed(pc.spec, f64(length(st.velocity))), f64(st.position.y) - pc.spec.float_height, st.throttle, pc.throttle, fuel_reading() / pc.spec.fuel_capacity, (heading(st) + TAU) % TAU, pc.spec.stall_speed, pc.spec.max_speed / pc.spec.handling_scale,pc.instruments)
        else if not pc.cockpit_view: instruments(fonts, f64(length(st.velocity)), f64(st.position.y) - pc.spec.float_height, st.throttle, pc.throttle, fuel_reading() / pc.spec.fuel_capacity, (heading(st) + TAU) % TAU, pc.spec.stall_speed, pc.spec.max_speed,pc.instruments)
    # (an amphibian's wheels, on a plate under the compass; the P.7's take-off has no display: she
    # is read from how she rides the water and her propeller)
    if me.mode == .aboard and not show_chart and ui == .none and not notebook.open:
        if pc.kind == .albatross: gear_plate(fonts, f64(pc.state.gear), pc.gear_down)
    if (me.mode == .aboard or me.mode == .walking) and not show_chart and ui == .none and not notebook.open:
        race_k = race_shown(air_events, living_world)
        if race_k >= 0: draw_race_hud(fonts, air_events, living_world, race_k, if me.mode == .aboard: pc.state.position else: me.pos, me.mode == .aboard, pc.spec.span)
        if me.mode == .aboard:
            marks = rescue_marks(rescue, pc.state.position)
            # (not while one is close enough to take aboard: the offer names them, and the mark's
            # words would sit over it)
            if rescue_act != 1:
                loop k in 0..min(marks.len(), 3): draw_rescue_mark(fonts, marks[k].pos, pc.state.position, survivor_name(living_world, marks[k]), side_colour(survivor_standing(living_world, marks[k].country), 0.95), survivor_standing(living_world, marks[k].country), true)
            # (a claimed contract's packet or survivor: where to collect it, then where it is to go)
            if packets_now.len() > 0: draw_rescue_mark(fonts, packets_now[0].pos, pc.state.position, packets_now[0].label, rgba(0.78, 0.86, 1.0, 0.95))
    if (me.mode == .aboard or me.mode == .walking) and not paused and not show_chart and ui == .none: draw_battle_card(fonts, battle_card, t)
    if me.mode==.aboard and not paused and not show_chart and ui==.none and not notebook.open:draw_view_target(view_target,fonts)
    # (AEGEAN_CAPTURE_SIDES: every side's mark in rows over the view, for the colour-vision checks)
    if capture_sides>0:draw_side_samples(fonts,capture_sides)
    if vdown(.h) and not leisure_typing(): controls_card(fonts, me.mode == .aboard)
    else if t-max(title_left_at,0.0) > (if title_left_at<0: 7.5 else: 1.5) and t-max(title_left_at,0.0) < 22.0 and not judge_ready and active_scenario=="" and me.mode != .free and not leisure_typing(): keys_hint(fonts)
    # (the panels worked by the keys and a controller too, each keeping its own focus; not under the
    # pause menu, which has its own)
    # (tavli is worked by its own keys: the d-pad and A over the board, X throws, Y takes back)
    hud_nav((ui != .none or notebook.open) and not paused and not title.open and not (ui == .leisure and leisure_ui == 7), "panel-{ui}-{leisure_ui}-{notebook.open}")
    # (the pause menu covers whatever panel is open: it shows again once play carries on)
    if not paused:
        draw_talk_bubbles()
        draw_ui()
    # (the pause menu over a panel: someone's line keeps its place till the panel is back)
    else: spoken_keep()
    if not paused: notebook_panel(fonts, notebook, clock_text(living_world, living_world.minute))
    hud_nav(false)
    if stay.active: draw_stay_talk()
    if skip.active: time_card(fonts, skip.doing, "{lt.local_minute(living_world.minute) / 60:02}:{lt.local_minute(living_world.minute) % 60:02}", skip.fade)
    if paused and not dbg.picking: rect(0, 0, f64(screen_width()), f64(screen_height()), rgba(0.03, 0.05, 0.08, 0.25))
    if dbg.open:
        was = debug_view()
        v = was
        debug_apply(was, v, debug_panel(dbg, v, [loop tw in towns: tw.name], CRAFT_NAMES, craft_picker_list))
    if dbg.picking and show_chart: prompt_card(fonts, "Click where to go  ({int(dbg.altitude)} m)", 60.0)
    # (under an open panel's lower edge, not across its rows; none over the pause menu: their
    # time is the game's, so what is left of it shows once play carries on)
    if t < toast_until and not dbg.open:
        heard = if toast_words != "": spoken_heard("toast", toast_words, RADIO_SPOKEN_RATE).shown else: -1
        prompt_card(fonts, toast, if ui != .none: 56.0 else: 260.0, chars = if heard < 0: -1 else: char_count(toast) - char_count(toast_words) + heard)
    if t - saved_toast_at < SAVED_TOAST_SECONDS and not paused: saved_toast(fonts, t - saved_toast_at)
    if t < map_card_until and not show_chart and ui != .maps and not dbg.open: prompt_card(fonts, map_card, 200.0)
    if not show_chart and ui == .none and not notebook.open: draw_rescue_card(fonts, rescue, t)
    if t < radio_card_until and me.mode == .aboard and not dbg.open: prompt_card(fonts, radio_label(), if pc.cockpit_view: 120.0 else: 320.0)
    if show_chart:
        facing = if me.mode == .aboard: heading(pc.state) else: PI - me.yaw
        draw_chart(the_chart(), towns, if me.mode == .aboard: pc.state.position else: me.pos, facing, hour,
            [loop tr in traffic: vec4(tr.state.position.x, tr.state.position.y, tr.state.position.z, f32(heading(tr.state)))],vessels.ships,vessels.lanes,if me.mode==.aboard:craft_point(pc.state) else:if me.mode==.walking:walker_point else:world_point(me.pos),[loop tr in traffic:craft_point(tr.state)],chart_fields(),[loop m in buoys_near: m.at.xz])
        cr = chart_rect()
        if chart_sheets != none:
            global war_layer_on
            if war_layer_on: draw_war_layer(cr, war_chart)
            draw_contract_marks(cr, packets_now)
            set_font(fonts.ui)
            war_layer_on = war_layer_button(cr, war_layer_on, war_marks_charted(war_chart))
            set_font()
        # (the pocket compass, set down on the map's corner)
        rr = min(70.0, f64(screen_width()) * 0.11)
        pocket_compass(fonts, vec2(f32(cr.x + cr.w - rr * 0.6), f32(cr.y + cr.h - rr * 0.6)), rr, facing)
        if let sheets = chart_sheets:
            set_font(fonts.ui)
            picked = chart_sheet_list(sheets)
            set_font()
            if picked >= -1:
                global chart_focus
                chart_focus = picked
                if picked >= 0: _ = living.select_map(living_world,picked,living_world.player)
    # (on a touch screen: the stick and the buttons, over everything)
    draw_pad()
    # (which build this is: always in the pause menu, in play while the setting is on)
    draw_build_label(fonts, dbg.open or (options.build_label and not title.open))
    quality_next_frame()
    if let directory=startup_aegean_target_frames:
        if frame_number()%6==0:save_png("{directory}/{frame_number()}.png",screenshot())
    # AEGEAN_PROP_FRAMES=dir (or - for none): every second frame from frame 120, and the player's
    # propeller band state each frame (PROPFRAME frame throttle shaft-rad/s band-angle).
    if let directory=startup_aegean_prop_frames:
        n=frame_number()
        if directory!="-" and n>=120 and n%2==0:save_png("{directory}/{n}.png",screenshot())
        if me.mode==.aboard:
            if let band=prop_bands.get(living_world.people[living_world.player].craft):print("PROPFRAME {n} {pc.state.throttle:.4} {prop_rotation_speed(pc.state,pc.feedback.speed):.3} {band.angle:.5}")
    # AEGEAN_CLOUD_FRAMES=dir: every second frame from frame 60 (clips of cloud shadows)
    if let directory=cloud_frames_dir:
        if frame_number()>=60 and frame_number()%2==0:save_png("{directory}/{(frame_number()-60)/2:05}.png",screenshot())
    if let directory=startup_aegean_atmos_frames:
        if frame_number() in [2,360,780,1200,1800] or frame_number()%4==0 and (frame_number()<=120 or frame_number()>=720 and frame_number()<=960): save_png("{directory}/{frame_number()}.png",screenshot())
    # AEGEAN_RIDE_WAIT_SKIP=<frame>: at that frame the world's clock moves on 25 minutes (the
    # waiting clip: long enough for a word from the one in the seat)
    if let f = env("AEGEAN_RIDE_WAIT_SKIP"):
        if frame_number() == (to_int(f) ?? -1):
            living.advance_minutes(living_world, 25)
            print("RIDE wait skip: {ride.stage} waited from {ride.wait_from} now {living_world.minute}")
    # (AEGEAN_FOOT_GO="<frame>:<thing>": at that frame, on foot, he's sent over to one of
    # foot_things as a tap there would; a trace of where he is and whether he sat)
    if foot_go_script != "":
      loop step in split(foot_go_script, ";"):
        kv = split(step, ":")
        if kv.len() == 2 and frame_number() == (to_int(kv[0]) ?? -1):
            ft = foot_things()
            # (by its label, or its place in the list)
            k = to_int(kv[1]) ?? -1
            loop i in 0..ft.len():
                if ft[i].label == kv[1]: k = i
            st = seat_things()
            loop i in 0..st.len():
                if st[i].label == kv[1]:
                    print("FOOT seated {kv[1]}")
                    run_then(st[i].then)
            print("FOOT things {[loop th in ft: th.label]} going {kv[1]} ({k}); cards {[loop o in shown_offers(walk_offers()): o.words]} of {[loop o in walk_offers(): o.words]}")
            if k >= 0: foot_go(ft, k)
            if kv[1] == "bath-out": bath_get_out()
            if kv[1] == "picnic": bath_walk_to(picnic_capture_spot, "picnic")
            if kv[1] == "pack": picnic_pack()
      if frame_number() % 30 == 0 and picnic.basket: print("PICNIC f{frame_number()} active {picnic.active} settle {picnic.settle:.2} bites {picnic.bites} min {lt.local_minute(living_world.minute)} at {me.pos.x:.1} {me.pos.z:.1} goal {foot_goal}")
      if frame_number() % 30 == 0: print("FOOT f{frame_number()} in-seat {[loop f in folks: if f.shown and f64(length(vec3(f.pos.x - hotel.seat.x, 0, f.pos.z - hotel.seat.z))) < 0.6: 1].len()} near {[loop f in folks: if f.shown and f64(length(vec3(f.pos.x - hotel.seat.x, 0, f.pos.z - hotel.seat.z))) < 3.0: 1].len()} at {me.pos.x:.1} {me.pos.y:.1} {me.pos.z:.1} goal {foot_goal} route {foot_route.len()} mode {me.mode} sitting {leisure.sitting} ui {ui}/{leisure_ui} bath {bath.stage} costume {bath.costume} {bath.settle:.2} soak {presentation.thermal.active} min {lt.local_minute(living_world.minute)} line {bath.line}")
    # (the room capture's script, AEGEAN_ROOM_SCRIPT="<frame>:<bed|chair|window|door|focus-<thing>|wake> ...":
    # sends him to a thing at that frame, or lights one as the arrow keys would; a trace of where he is)
    if room_script != "" and stay.active:
        loop step in split(room_script, " "):
            kv = split(step, ":")
            if kv.len() != 2 or frame_number() != (to_int(kv[0]) ?? -1): continue
            what = kv[1]
            if what == "wake":
                if skip.active and skip.left > 1: skip.left = 1
                continue
            focus = what.starts_with("focus-")
            name = if focus: what[6..] else: what
            k = -1
            loop i in 0..room_objs.len():
                if "{room_objs[i].thing}" == name: k = i
            if focus:
                global room_focus
                room_focus = k
            else: room_use(k)
        if frame_number() % 15 == 0:
            b = room_body(room_me, room_objs)
            print("ROOM f{frame_number()} stage {stay.stage} at {b.pos.x:.2} {b.pos.z:.2} y {b.pos.y:.2} posture {b.posture} {b.amount:.2} going {room_me.going} on {room_me.on} lit {room_lit()} skip {skip.active} {skip.left}")
    # (the table capture's script: get up, sit again, at those frames; a trace of what is where)
    loop step in split(table_script, " "):
        kv = split(step, ":")
        if kv.len() == 2 and frame_number() == (to_int(kv[1]) ?? -1):
            if kv[0] == "stand" and leisure.sitting != "":
                leisure_stand()
                # (a step back from the table, looking at it)
                me.pos = me.pos + vec3(f32(-sin(me.yaw)), 0, f32(-cos(me.yaw))) * 2.0
                follow.yaw = me.yaw + PI + 1.4; follow.distance = 5.0; follow.pitch = 0.45
            if kv[0] == "sit": leisure_sit("hotel")
    if table_script != "" and frame_number() % 20 == 0: print("TABLE f{frame_number()} sitting {leisure.sitting} served {[loop s in leisure.served: s.amount]} left {left_key} {[loop s in left_table: s.amount]} clearer {clear_waiter.stage} tray {clear_waiter.tray.len()} waiter {waiter.stage} ui {leisure_ui}")
    if env("AEGEAN_SEAT_TRACE") != none and frame_number() % 5 == 0: print("SEAT f{frame_number()} yaw {follow.yaw:.3} pitch {follow.pitch:.3} look {stay_look_turn.yaw:.3} {stay_look_turn.pitch:.3}")
    if let f = env("AEGEAN_RIDE_TRACE"):
        if frame_number() % 30 == 0: print("RIDE f{frame_number()} stage {ride.stage} mode {me.mode} ui {ui}/{leisure_ui} line {ride.line} d {length(me.pos - pc.state.position):.1} place {living_world.people[living_world.player].place} dest {ride.dest} cash {player_cents()}")
    # AEGEAN_RIDE_FRAMES=dir: a pleasure flight's clip, every other frame from 60 to 900
    if let directory = env("AEGEAN_RIDE_FRAMES"):
        if frame_number() >= 60 and frame_number() <= 900 and frame_number() % 2 == 0: save_png("{directory}/{(frame_number() - 60) / 2:04}.png", screenshot())
    # AEGEAN_STAY_FRAMES=dir: a stay's clip, every other frame from 60 to 660 (at frame 120 the
    # night begins, with AEGEAN_STAY_SLEEP)
    if let directory = env("AEGEAN_STAY_FRAMES"):
        if frame_number() == 120 and env("AEGEAN_STAY_SLEEP") != none and stay.active: stay_sleep(rest_minutes(living_world, 420), "Asleep")
        if frame_number() >= 60 and frame_number() <= 660 and frame_number() % 2 == 0: save_png("{directory}/{(frame_number() - 60) / 2:04}.png", screenshot())
    # AEGEAN_SEAT_FRAMES=dir: the seat's clip, every other frame from 60 to 900 (the view turned
    # slowly about the seat; someone coming over, when AEGEAN_COMPANY says so)
    if let directory = env("AEGEAN_SEAT_FRAMES"):
        if frame_number() >= 60 and frame_number() <= (to_int(env("AEGEAN_SEAT_FRAMES_END") ?? "900") ?? 900):
            global follow
            follow.yaw += to_float(env("AEGEAN_SEAT_FRAMES_TURN") ?? "0.006") ?? 0.006
            step = to_int(env("AEGEAN_SEAT_FRAMES_STEP") ?? "2") ?? 2
            if frame_number() % step == 0: save_png("{directory}/{(frame_number() - 60) / step:04}.png", screenshot())
    # AEGEAN_LEISURE_FRAMES=dir: every half second of a job on the aircraft, and its legs as they go
    if let directory = startup_aegean_leisure_frames:
        if job.active and frame_number() % 30 == 0:
            save_png("{directory}/{frame_number()}.png", screenshot())
            if job.leg < job.legs.len(): print("JOB frame {frame_number()} leg {job.leg}/{job.legs.len()} {job.legs[job.leg].kind} pose {job.pose} aboard {job.aboard} at {me.pos} hour {hour:.2}")
    if capture_audio: capture_audio_frame()
    if thermal_capture_id>=0 and frame_number() in [300,900,1800]:
        print("THERMAL_STATE frame={frame_number()} minute={living_world.minute} active={presentation.thermal.active} sleeping={presentation.thermal.sleeping} fatigue={living_world.people[living_world.player].fatigue} cash={player_cents()} until={presentation.thermal.until}")
    if let directory=startup_aegean_walk_frames:
        frame=frame_number()
        if frame>=120 and frame<=180 and frame%2==0: save_png("{directory}/{frame}.png",screenshot())
    if let spec=capture_frames:
        words=split(spec," ")
        if words.len()==4:
            frame=frame_number();from=to_int(words[1]) ?? 0;until=to_int(words[2]) ?? 0;every=max(1,to_int(words[3]) ?? 1)
            if frame>=from and frame<=until and (frame-from)%every==0:save_png("{words[0]}/f{(frame-from)/every:05}.png",screenshot())
    # AEGEAN_SHOTS="dir 120 300 600": those frames saved, each with a line of where the player is
    # (for scripted play sessions with SLOPPY_INPUT)
    if let shots=startup_aegean_shots:
        words=split(shots," ")
        if words.len()>1 and "{frame_number()}" in words[1..words.len()]:
            save_png("{words[0]}/{frame_number()}.png",screenshot())
            near_folk = len([loop f in folks: if f.shown and length(f.pos - me.pos) < 40.0: 1])
            print("SHOT {frame_number()} mode {me.mode} pos {me.pos.x:.1} {me.pos.y:.2} {me.pos.z:.1} yaw {me.yaw:.2} ui {ui} paused {paused} minute {living_world.minute} cash {player_cents()} folk40 {near_folk}/{folks.len()} crowd {ambient_drawn}")

# (AEGEAN_AUDIO_CAPTURE: the first audio_capture_frames of the mix, to a file)
capture_audio_frame = ():
    global captured_audio
    if frame_number()<=audio_capture_frames: captured_audio.extend(__mix_buf)
    if frame_number()==audio_capture_frames:
        if let path=startup_aegean_audio_capture: assert(save_wav(path,Sound(captured_audio)))

p7_hint_shown = load_value("p7-hint-shown", false)   # (the P.7's one-line hint, shown once ever)
p7_worn_told = -1000.0                               # (when the P.7's worn engine was last mentioned)

# (the pause menu's aircraft picker: every aircraft's card, made once)
craft_picker_list = craft_entries()

# ---------------- the pilot's cargo handed over on the dock ----------------

# A receiver waits on the dock for the pilot's cargo (portage.cargo_awaited: the living world sends
# them down when the aircraft is bound there), waves as it comes in, and takes it from the pilot's
# hands: "Hand over the medicine". Paid through the ledger once it is in their hands.
handover_job = -1                   # (handed over, waiting for the world to sign for it)
handover_by = -1
handover_paid_before = 0

# the waiting receiver within reach on the dock, and the job: (-1, -1) none
handover_here = () -> (int, int):
    if me.mode != .walking: return (-1, -1)
    w = living_world
    craft = w.people[w.player].craft
    if craft < 0: return (-1, -1)
    loop k in 0..folks.len():
        f = folks[k]
        if not f.shown or f64(length(f.pos - me.pos)) > 3.5: continue
        id = portage.cargo_awaited(w, f.person)
        if id >= 0 and w.aircraft[craft].place == w.jobs[id].destination: return (k, id)
    (-1, -1)

handover_words = (id: int) -> str: "hand over {job_cargo(id)}"

# someone in the scene waits on the dock for this job (then it's handed over, not carried off)
handover_waited = (id: int) -> bool:
    if id < 0: return false
    loop f in folks:
        if f.shown and portage.cargo_awaited(living_world, f.person) == id: return true
    false

handover_act = ():
    global handover_job, handover_by, handover_paid_before
    k, id = handover_here()
    if id < 0: return
    w = living_world
    person = folks[k].person
    before = player_cents()
    if portage.choose_collection(living_world, id, w.player, .sender):
        handover_job = id; handover_by = person; handover_paid_before = before
        # (her thanks in place of what she was asking: said over her head as she takes it)
        folks[k].line = handover_thanks(id); folks[k].line_t = t
        log_note(notebook, "Handed {job_cargo(id)} to {w.people[person].name} at {SETTLEMENTS[w.jobs[id].destination].name}.", clock_text(w, w.minute))
    else: say_toast(portage.cargo_status(w, id))

handover_thanks = (id: int) -> str:
    w = living_world
    sender = split(w.people[w.jobs[id].poster].name, " ")[0]
    late = w.minute > w.jobs[id].due_minute
    if let e = errand_of(w, id): return errand_thanks(w, e, late)
    if late: "There it is at last. I'll take it from here." else: "From {sender}? Thank you, I'll take it from here."

# Each frame: the waiting receivers wave at the pilot coming in; a handover signed for is paid
handover_frame = ():
    global handover_job
    w = living_world
    craft = w.people[w.player].craft
    loop k in 0..folks.len():
        f = folks[k]
        folks[k].waving = 0.0
        if not f.shown or craft < 0: continue
        id = portage.cargo_awaited(w, f.person)
        if id < 0: continue
        # (the aircraft in sight and coming in, or tied up, and the pilot not yet beside them)
        near = if me.mode == .aboard: pc.state.position else: me.pos
        d = f64(length(near.xz - f.pos.xz))
        if d < 160.0 and d > 4.0 and (me.mode == .walking or pc.state.on_water or pc.state.moored): folks[k].waving = 0.7 + 0.3 * sin(t * 6.0)
    if handover_job >= 0 and handover_job in w.jobs and w.jobs[handover_job].state == .delivered:
        j = w.jobs[handover_job]
        say_toast("{w.people[handover_by].name} signs for {job_cargo(handover_job)}: {phoenix_text(player_cents() - handover_paid_before)} paid in.")
        handover_job = -1

# ---------------- a new pilot's welcome (src/newcomer.jo) ----------------

# AEGEAN_WELCOME=1: a new game's welcome without the title (captures)
# where the greeter waits: on the dock's planks a little ahead of the pilot and to the right (the
# aircraft is moored on the left), so even an upright phone's narrow view has him in it
welcome_spot = () -> vec3:
    out = vec3(home.out.x, 0, home.out.y)
    me.pos + vec3(-out.z, 0, out.x) * 1.5 + out * 2.5
if env("AEGEAN_WELCOME") != none: welcome_begin(living_world, living_world.minute, welcome_spot())
welcome_said = ""                   # (what is said, by whom, till when: a bubble over their head)
welcome_by = -1
welcome_until = -1.0
welcome_greeted_t = -1.0
welcome_note_until = -1.0

# the folk drawn for a person (-1: not in the scene)
folk_of = (person: int) -> int:
    loop k in 0..folks.len():
        if folks[k].person == person and folks[k].shown: return k
    -1

welcome_say = (person: int, line: str, secs: f64):
    global welcome_said, welcome_by, welcome_until
    welcome_said = line; welcome_by = person; welcome_until = t + secs

welcome_frame = (dt: f64):
    global welcome_greeted_t, welcome_note_until
    if not welcome_active(living_world): return
    wl = living_world.welcome
    if active_scenario != "":
        living_world.welcome.done = true; return
    if me.mode == .aboard and not pc.state.on_water and not pc.state.moored and not pc.state.on_ground and not pc.state.crashed:
        living_world.welcome.air_seconds = wl.air_seconds + dt
    jobs = welcome_jobs(living_world)
    if welcome_finished(living_world.welcome, jobs.0, jobs.1, options.guidance):
        living_world.welcome.done = true
        return
    if world_held() or skip.active: return
    k = folk_of(wl.greeter)
    near = if k >= 0: f64(length(folks[k].pos - me.pos)) else: 1e9
    # (the greeting: once the pilot is about on the dock, the scene up out of the dusk)
    if not wl.greeted and me.mode == .walking and ui == .none and t - title_left_at > 2.5 and near < 18.0:
        living_world.welcome.greeted = true
        welcome_greeted_t = t
        welcome_say(wl.greeter, WELCOME_GREETING, 6.0)
    # (walked off without a word: he calls after them, once)
    if wl.greeted and not wl.talked and not wl.called and t - welcome_greeted_t > WELCOME_CALL_AFTER and near > 10.0 and near < 60.0 and me.mode == .walking and ui == .none:
        living_world.welcome.called = true
        welcome_say(wl.greeter, WELCOME_CALL, 5.0)
    # (the note by the compass, the first time aboard)
    if not wl.note_shown and me.mode == .aboard and ui == .none:
        living_world.welcome.note_shown = true
        welcome_note_until = t + WELCOME_NOTE_SECONDS
    # (a strike too soon, the first time: a fisherman about says to wait)
    if not wl.fished and angling.stage == 4 and angling.line.starts_with("Too soon"):
        living_world.welcome.fished = true
        best = -1; bd = 30.0
        loop f in folks:
            if f.shown and living_world.people[f.person].occupation == .fisher:
                d = f64(length(f.pos - me.pos))
                if d < bd: bd = d; best = f.person
        if best >= 0: welcome_say(best, WELCOME_FISH, 5.0)

# an open job posted here, said as one would ("Sofia wants wine carried across town", "Eleni has
# medicine for Agios Nikolaos"): on foot or by air, the soonest due; "" none
welcome_job_words = (place: int, on_foot: bool) -> str:
    best = -1
    loop id in living_world.active_jobs:
        j = living_world.jobs[id]
        if j.state != .open or j.origin != place or (j.delivery_mode == .foot) != on_foot: continue
        if best < 0 or j.due_minute < living_world.jobs[best].due_minute: best = id
    if best < 0: return ""
    j = living_world.jobs[best]
    who = split(living_world.people[j.poster].name, " ")[0]
    what = job_cargo(best).replace("the ", "")
    if on_foot: "{who} wants {what} carried across town" else: "{who} has {what} for {SETTLEMENTS[j.destination].name}"

draw_welcome = ():
    if t < welcome_until and welcome_said != "" and ui == .none and not paused and not show_chart and not notebook.open:
        k = folk_of(welcome_by)
        if k >= 0:
            d = f64(length(folks[k].pos - scene_camera()))
            speech_bubble(fonts, folks[k].pos + vec3(0, 1.7, 0), living_world.people[welcome_by].name, welcome_said, d, 40.0)
    if t < welcome_note_until and me.mode == .aboard and ui == .none and not paused:
        draw_welcome_note(welcome_note_lines(hands_now(), options.controls, options.mouse_steers), clamp(welcome_note_until - t, 0.0, 0.6) / 0.6)

# the note by the compass: a slip of paper in Paolo's hand, under the compass
draw_welcome_note = (lines: str[], alpha: f64):
    set_font(fonts.ui)
    size = readable(17.0)
    w = 0.0
    loop l in lines: w = max(w, ptext_width(l, size))
    w = min(w + 36.0, f64(screen_width()) - 40.0)
    h = 18.0 + f64(lines.len()) * size * 1.35
    x = (f64(screen_width()) - w) * 0.5
    # (under the compass; on a touch screen under the buttons over its span, aboard two rows)
    y = max(64.0, pad_top_clear(x, x + w, aboard = true) + 10.0)
    a = f32(alpha)
    rect_rounded(x + 3, y + 4, w, h, 3, rgba(0, 0, 0, 0.25 * a))
    rect_rounded(x, y, w, h, 3, rgba(0.95, 0.91, 0.8, 0.96 * a))
    loop i in 0..lines.len():
        ptext(fit_text(lines[i], w - 36.0, size), vec2(f32(x + 18.0), f32(y + 10.0 + f64(i) * size * 1.35)), size, rgba(0.22, 0.18, 0.14, a))
    set_font()

# the panels open over the scene: a conversation, a board, a ledger
draw_ui = ():
    global ui, ui_line, ui_news, ui_place, ui_job, ui_turn, ui_mission, presentation
    match ui:
        .talk:
            if ui_folk < 0 or ui_folk >= folks.len():
                ui = .none
                return
            f = folks[ui_folk]
            p = living_world.people[f.person]
            merchant = (p.occupation == .merchant or p.occupation == .innkeeper or p.occupation == .hotelier or p.occupation == .quartermaster) and f.place>=0 and f.place<living_world.places.len()
            # errands first: work they posted (offered to them in person), cargo one has brought them
            offers: int[]
            offer_choices: lt.CarriageChoice[]
            handovers: int[]
            handover_choices: lt.CarriageChoice[]
            answers: str[]
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.poster == f.person and j.state == .open and j.origin == f.place:
                    offers.push(id)
                    offer_choices.push(if j.delivery_mode == .foot: lt.CarriageChoice.player else: lt.CarriageChoice.automatic)
                    answers.push(if j.delivery_mode == .foot: "I'll carry {job_cargo(id)} across town." else: "Fly {job_cargo(id)} to {SETTLEMENTS[j.destination].name}; arrange carrying.")
                    if j.delivery_mode == .aircraft and j.cargo_mode != .none:
                        offers.push(id); offer_choices.push(.porter)
                        answers.push("To {SETTLEMENTS[j.destination].name}: please hire a porter for {job_cargo(id)}.")
                        offers.push(id); offer_choices.push(.player)
                        answers.push("To {SETTLEMENTS[j.destination].name}: I'll fetch and load {job_cargo(id)}.")
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.state == .claimed and j.carrier == living_world.player and (j.loaded or j.delivery_mode == .foot) and j.destination == f.place and portage.cargo_receiver(living_world,id) == f.person:
                    handovers.push(id); handover_choices.push(.automatic)
                    answers.push("I've brought {job_cargo(id)} from {living_world.people[j.poster].name}.")
                    if j.delivery_mode == .aircraft and j.cargo_mode != .none:
                        handovers.push(id); handover_choices.push(.player)
                        answers.push("I'll carry {job_cargo(id)} from the aircraft to your door myself.")
            nerr = answers.len()
            # then the conversation itself: answers to what they just asked, the things one can
            # bring up with them (their work, the news, the weather, the market, people, home...),
            # work and trade, and leaving. When they've had enough, only leaving.
            replies = if ui_turn.exhausted: [] else: ui_turn.replies
            loop r in replies: answers.push("\"{r.label}\"")
            nrep = answers.len()
            topics = if ui_turn.exhausted: [] else: [loop o in living.talk_topics(living_world, f.person, living_world.player): if o.topic != .greeting and o.topic != .farewell: o]
            # (a new pilot's greeter: where the work is and how she's flown come first, within the
            # number keys)
            # (a mechanic, Paolo or any other: where the work is and how she's flown, for anyone who
            # asks; a new pilot's greeter with the Hints on, first among the answers)
            welcoming = p.occupation == .mechanic or (welcome_active(living_world) and f.person == living_world.welcome.greeter)
            most_topics = if welcoming: 3 else: 5
            if topics.len() > most_topics: topics = [loop k in 0..most_topics: topics[k]]
            loop o in topics: answers.push(o.label)
            ntop = answers.len()
            welcome_k = 0
            if welcoming: answers.push(WELCOME_ASK_WORK); answers.push(WELCOME_ASK_FLYING)
            work_k = answers.len() - ntop
            answers.push("Any work going?")
            if merchant: answers.push("Let's trade.")
            sells_maps = map_shop_of(f.person)
            if sells_maps != "": answers.push("What maps have you?")
            # (a mechanic paints aircraft: asked, they open the paint shop; with her in the shop,
            # how the work stands, and waiting for it)
            paints = p.occupation == .mechanic
            paint_k = answers.len() - ntop - work_k
            if paints: answers.push(if paint_job.active: "How is the paint coming on?" else: "I'd like her painted.")
            paint_wait = paints and paint_job.active
            if paint_wait: answers.push("I'll wait for the paint.")
            # (a family grateful to the player offers its spare room, at home)
            rest_offer = f.place >= 0 and f.place == p.home and p.occupation != .patrol and p.occupation != .pirate and grateful_to_player(living_world, f.person)
            rest_k = answers.len() - ntop - work_k
            if rest_offer: answers.push("Could I rest at yours a while?")
            # (someone sat at their table on the terrace: asking to sit with them)
            # (a boat he's seen lying out there, from this harbour: telling them where)
            tell_k = -1
            loop ai in 0..living_world.adrift.len():
                aa = living_world.adrift[ai]
                if aa.state == .adrift and aa.found and f.place == aa.home and f.person != aa.person: tell_k = ai
            tell_at = answers.len() - ntop - work_k
            if tell_k >= 0: answers.push("{_first_name(living_world.adrift[tell_k].person)}'s boat is lying off {living.place_name(living_world, adrift_near(living_world, living_world.adrift[tell_k]))}.")
            sit_offer = can_ask_to_sit(ui_folk)
            sit_k = answers.len() - ntop - work_k
            if sit_offer: answers.push("Mind if I sit?")
            # (a bucket: theirs brought back, or the loan of it asked)
            carried_k = fish_carried(fish)
            bucket_back = carried_k >= 0 and fish.buckets[carried_k].owner == f.person
            their = fish_bucket_of(fish, f.person)
            bucket_ask = not bucket_back and their >= 0 and not fish.buckets[their].lent and f.person != living_world.player
            bucket_k = answers.len() - ntop - work_k
            if bucket_back: answers.push("I've brought your bucket back.")
            else if bucket_ask: answers.push("Could I borrow a bucket?")
            answers.push("Goodbye.")
            role = "{p.occupation}".replace("_", " ")
            c = conversation_grouped(fonts, p.name, "{role}, {living.place_name(living_world,f.place)}", ui_line, [loop k in 0..nrep: answers[k]], [loop k in nrep..ntop: answers[k]], [loop k in ntop..answers.len(): answers[k]], rate = person_spoken_rate(f.person), lead = talk_answer_lead(talk_bubbles, t))
            if vpressed(.escape): c = answers.len() - 1
            # (what the pilot says, over his head: the answer as worded, the subject as a question,
            # an errand in a few words)
            if c >= 0:
                global talk_bubbles
                words = pilot_says(answers[c])
                if c < offers.len() and offer_choices[c] == .porter: words = "I'll take it. A porter for the loading, please."
                else if c < offers.len() and offer_choices[c] == .automatic: words = "I'll take it."
                else if c >= nrep and c < ntop: words = pilot_asks(topics[c - nrep].topic)
                talk_bubbles_pilot(talk_bubbles, words, t)
            if c >= 0 and c < offers.len():
                id = offers[c]
                choice = offer_choices[c]
                ui_line = said_by(p.name,agree_cargo_job(id,choice))
            else if c >= offers.len() and c < nerr:
                id = handovers[c - offers.len()]
                before = player_cents()
                choice = handover_choices[c-offers.len()]
                if choice == .player:
                    portage.choose_collection(living_world,id,living_world.player,.player)
                    ui_line = "Please bring it to the marked delivery point. " + portage.cargo_status(living_world,id)
                else:
                    thanks = handover_thanks(id)
                    if living.deliver_job(living_world, id, living_world.player):
                        ui_line = if errand_of(living_world, id) != none: "{thanks} {phoenix_text(player_cents() - before)}." else: "Thank you. That's what was promised: {phoenix_text(player_cents() - before)}."
                    else: ui_line = portage.cargo_status(living_world,id)
            else if c >= nerr and c < nrep:
                ui_turn = living.reply(living_world, f.person, replies[c - nerr].reply, living_world.player)
                ui_line = turn_text(ui_turn)
            else if c >= nrep and c < ntop:
                ui_turn = living.talk(living_world, f.person, topics[c - nrep].topic, living_world.player)
                ui_line = turn_text(ui_turn)
                if topics[c - nrep].topic == .news:
                    ui_news += 1
                    # (what they've heard: now and then, something going on he could look into)
                    if _lead_now(if ui_turn.exhausted: 1.0 else: 0.5):
                        said = tell_lead(f.person)
                        if said != "": ui_line = said
            else if welcoming and c >= ntop and c < ntop + work_k:
                # (where the work is, and how she's flown)
                if c == ntop + welcome_k:
                    living_world.welcome.talked = true
                    ui_line = welcome_work_words(f.place, welcome_job_words(f.place, true), welcome_job_words(f.place, false))
                else: ui_line = welcome_flying_words(hands_now(), options.controls)
            else if c >= 0:
              c -= ntop + work_k
              if c == 0:
                  ui_turn = living.ask_for_work(living_world,f.person,living_world.player)
                  ui_line = turn_text(ui_turn)
              else if merchant and c == 1:
                  ui_place = f.place
                  ui = .trade
              else if sells_maps != "" and c == (if merchant: 2 else: 1): open_map_counter(sells_maps)
              else if paints and c == paint_k:
                  said = open_paint_shop(f.person, f.place)
                  ui_line = said_by(p.name, said)
                  # (she is being brought round to the berth: the talk gives way to the wait)
                  if skip.active and ui == .talk: ui = .none
              else if paint_wait and c == paint_k + 1:
                  ui = .none
                  leisure_skip(paint_job_left(paint_job, living_world.minute) + 1, "Waiting for the paint to dry")
              else if (bucket_back or bucket_ask) and c == bucket_k:
                  if bucket_back:
                      said = fish_return_bucket(living_world, fish, carried_k)
                      ui_line = said
                      log_note(notebook, "Gave {p.name} back the bucket.", clock_text(living_world, living_world.minute))
                  else:
                      ans = fish_ask_bucket(living_world, fish, f.person, fish_bucket_where_words(living_world, f.person), seller = fish_bucket_seller(living_world, f.person) != "")
                      ui_line = ans.line
                      if ans.lent: log_note(notebook, "{p.name} lent me a bucket.", clock_text(living_world, living_world.minute))
              else if tell_k >= 0 and c == tell_at:
                  name = _first_name(living_world.adrift[tell_k].person)
                  # (the launch seen putting out, if it can: src/adrift_help.jo; else the harbour's own time)
                  given = if adrift_help.stage == .none: adrift_help_start(adrift_help, vessels, living_world, tell_k, -1, _help_wind()) else: -1
                  minutes = adrift_report(living_world, tell_k, given)
                  if minutes < 0 and given > 0: adrift_help_drop(adrift_help, vessels, living_world)
                  if minutes > 0:
                      ui_line = said_by(p.name, "Thank God. I'll get word to the harbour; the launch will go out. {capital(help_eta_words(minutes))}, they'll say.")
                      log_note(notebook, "Told {p.name} where {name}'s boat is lying. The launch is going out.", clock_text(living_world, living_world.minute))
              else if sit_offer and c == sit_k:
                  said = ask_to_sit(ui_folk)
                  if leisure.sitting == "": ui_line = said_by(p.name, said)
              else if rest_offer and c == rest_k:
                  global leisure_ui, leisure_host, leisure_line
                  leisure_host = f.person
                  leisure_line = spare_room_words(living_world, f.person)
                  ui = .leisure
                  leisure_ui = 4
              else if c >= 0:
                  # (a parting word, left hanging over the quay as one walks off)
                  bye = living.talk(living_world, f.person, .farewell, living_world.player)
                  if bye.text != "": say_toast("{p.name}: {bye.text}", bye.text)
                  ui = .none
        .board:
            yesterday: str[]
            loop r in living_world.places[ui_place].yesterday:
                l = reason_line(living_world, r)
                if l != "": yesterday.push(l)
            district = core_district(living_world, ui_place)
            res = notice_board(fonts, SETTLEMENTS[ui_place].name, military_notices(living_world, district, living_world.player, presentation.declined_missions, (m: int) -> str: clock_text(living_world, m)) + job_notices(living_world, ui_place) + air_meet_notices(air_events, living_world, me.pos, (m: int) -> str: clock_text(living_world, m), reach = player_meet_reach(), pier_sells = ui_place < living_world.harbors.len() and fuel_pier_here(living_world, living_world.harbors[ui_place].center) != none), yesterday)
            if mission_of_notice(res.take) >= 0:
                ui_mission = mission_of_notice(res.take)
                if let m = find_mission(living_world, ui_mission): ui_line = "{m.why} Due {clock_text(living_world, m.deadline)}. {contract_status(living_world, m)}"
                ui = .contract
            if res.take >= 0:
                # Keep the notice, then review its actual handling terms before agreeing.
                j = living_world.jobs[res.take]
                pin_notice(notebook, res.take, j.poster, "{job_cargo(res.take)} to {SETTLEMENTS[j.destination].name}".replace("the ", ""), "{living_world.people[j.poster].name} at {SETTLEMENTS[j.origin].name} wants it there by {clock_text(living_world, j.due_minute)}. {phoenix_text(j.reward_cents)}.", clock_text(living_world, living_world.minute))
                ui_job = res.take
                ui_line = "{living_world.people[j.poster].name} offers {phoenix_text(j.reward_cents)}. The goods are at their existing warehouse spot. Who will carry them?"
                ui = .handling
            if res.closed: ui = .none
        .contract:
            if let m = find_mission(living_world, ui_mission):
                answers = contract_answers(living_world, m, living_world.player)
                c = conversation(fonts, contract_title(living_world, m), "{SETTLEMENTS[ui_place].name} office", ui_line, answers.0, rate = spoken_rate(.formal), key = "office")
                code = if c >= 0: answers.1[c] else: -1
                if code == 1:
                    presentation.declined_missions[m.id] = true
                    ui = .board
                else if code == 6 or vpressed(.escape): ui = .board
                else if code >= 0:
                    said = contract_act(living_world, m.id, code, living_world.player)
                    if code == 0 and living_world.war.missions[m.id].state == .claimed:
                        log_note(notebook, "Signed for {contract_title(living_world, m).lower()}: {m.why}", clock_text(living_world, living_world.minute))
                    ui_line = said
                    if let after = find_mission(living_world, m.id): ui_line = "{said} {contract_status(living_world, after)}"
            else: ui = .board
        .handling:
            if ui_job < 0 or not (ui_job in living_world.jobs): ui = .board; return
            j = living_world.jobs[ui_job]
            answers: str[]; choices: lt.CarriageChoice[]
            if j.state == .open:
                if j.delivery_mode == .foot:
                    answers.push("I'll carry it on foot."); choices.push(.player)
                else:
                    answers.push("Arrange the carrying with the sender."); choices.push(.automatic)
                    if j.cargo_mode != .none:
                        answers.push("The sender hires a dock porter."); choices.push(.porter)
                        answers.push("I'll fetch and load it myself."); choices.push(.player)
            answers.push("Back to the board.")
            c = conversation(fonts,"{living_world.people[j.poster].name}'s notice",SETTLEMENTS[j.origin].name,ui_line,answers,rate = 0.0,key = "notice")
            if c >= 0 and c < choices.len(): ui_line = agree_cargo_job(ui_job,choices[c])
            else if c >= 0 or vpressed(.escape): ui = .board
        .trade:
            w = living_world
            m = w.places[ui_place].market
            c = w.people[w.player].craft
            rows: GoodRow[]
            goods: int[]
            loop g in 0..w.goods.len():
                if w.goods[g].illegal and ui_place != 5: continue
                pr = m.price_cents[g]
                have = w.people[w.player].pocket.qty[g] / 1000
                # (a load's price and the 2% duty, which the trader pays both ways: living_money.trade)
                duty = if ui_place == 5 or pr == 0: 0 else: max(1, pr * 2 / 100)
                rows.push(GoodRow(w.goods[g].key, "load", pr + duty, pr - duty, m.inventory.qty[g] / 1000, have))
                goods.push(g)
            used = 0
            if c >= 0:
                loop g in 0..w.goods.len(): used += w.aircraft[c].cargo.qty[g] / 1000
            res = ledger(fonts, w.people[folks[ui_folk].person].name, SETTLEMENTS[ui_place].name, rows, player_cents(), used, 8)
            if res.row >= 0:
                before = player_cents()
                ok = if res.dir > 0: living.buy(living_world, ui_place, goods[res.row], 1000 * res.qty, living_world.player) else: living.sell(living_world, ui_place, goods[res.row], 1000 * res.qty, living_world.player)
                loads = if res.qty == 1: "a load" else: "{res.qty} loads"
                if not ok: say_toast("No: not enough money or stock. Bring your goods ashore to sell them.")
                else if res.dir > 0: say_toast("Bought {loads} of {rows[res.row].name}, {phoenix_text(before - player_cents())}. {if res.qty == 1: "It waits" else: "They wait"} at the warehouse: carry {if res.qty == 1: "it" else: "them"} aboard with F.")
                else: say_toast("Sold {loads} of {rows[res.row].name}, {phoenix_text(player_cents() - before)}.")
            if res.closed: ui = .none
        .maps:
            near = [loop s in living.map_sellers(living_world, living_world.player): if s.id == ui_shop: s]
            if near.len() == 0:
                ui = .none
                return
            shop = near[0]
            res = map_counter(fonts, shop.name, shop.kind, living.place_name(living_world, shop.place), map_counter_rows(living_world, ui_shop, living_world.player), player_cents(), if t < map_card_until: map_card.replace("      M  the chart", "") else: "")
            now = clock_text(living_world, living_world.minute)
            if res.buy >= 0:
                bought = living.buy_map(living_world, res.buy, living_world.player)
                if bought.ok:
                    log_note(notebook, "Bought the {map_title(bought.copy)} at {shop.name}, {phoenix_text(bought.cents)}.", now)
                    notice_new_maps()
                else: say_toast(bought.message)
            if res.collect >= 0:
                got = living.claim_map_reward(living_world, res.collect, living_world.player)
                if got.ok:
                    log_note(notebook, "Collected the {map_title(got.copy)} at {shop.name}, as promised.", now)
                    notice_new_maps()
                else: say_toast(got.message)
            if res.closed: ui = .none
        .fuel: fuel_panel()
        .leisure: leisure_panel()
        .workshop: workshop_panel()
        .paint: paint_shop_panel_step()
        _: pass
