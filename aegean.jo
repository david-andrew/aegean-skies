# AEGEAN SKIES - a living-world seaplane sandbox in a sunlit, interwar Aegean.
#
# On foot: WASD to walk (Shift to run), the mouse (right button held) or Q/E to look around, F by
# your aircraft to climb aboard. M: the chart. F2: a free camera, for looking around.
#
# AEGEAN_VIEW="x y z yaw pitch hour" starts in the free camera there, at that hour (screenshots);
# AEGEAN_HOUR sets the hour of the start.

build:
    name = "Aegean Skies"

use 'src/world.jo'
use 'src/look.jo'
use 'src/terrain.jo'
use 'src/sea.jo'
use 'src/clouds.jo'
use 'src/sky.jo'
use 'src/objects.jo'
use 'src/chart.jo'
use 'src/planes.jo'
use 'src/folk.jo'
use 'src/hud.jo'
use 'src/grass.jo'
use 'src/sound.jo'
use 'src/flight.jo'
use 'src/pilot.jo'
use 'src/traffic.jo'
import 'src/living_world.jo' as living
import 'src/living_scene.jo' as living_scene
use 'src/wake.jo'
use 'src/shadow.jo'
use 'src/birds.jo'
use 'src/trails.jo'
use 'src/damage.jo'
use 'src/townsfolk.jo'
use 'src/speech.jo'
use 'src/panels.jo'
use 'src/mooring.jo'
use 'src/guns.jo'
use 'src/fabric.jo'
use 'src/debugmenu.jo'
use 'src/notebook.jo'
import 'src/living_claims.jo' as claims
import 'src/living_types.jo' as lt

window("Aegean Skies", 1280, 720)
init_clouds()
init_terrain()
init_sky()
init_objects()
init_sea()
init_grass()
init_wake()
init_shadow()
init_trails()
init_birds()

t0 = time()
if not load_land(embed("assets/terrain.bin")): print("assets/terrain.bin was made for other islands: run `sloppy --release tools/bake.jo` (working the land out as it is needed, slowly)")
ground_meshes = [loop isl in ISLANDS: build_island_mesh(isl, MESH_STEP)]
depth_tex = build_depth_texture()
sea_mesh = build_sea_mesh()
puff_mesh = build_puff_mesh()
cloud_list = build_puffs(7, 70)
puffs = instance_buffer(cloud_list)
print("{cloud_list.len()} cloud puffs")
towns = [loop st in SETTLEMENTS: build_town(st)]
living_world = living.build_world(u64(0), harbors_from_towns(towns))
traffic_scene = living_scene.SceneAdapter()
tree_meshes = build_tree_meshes()
groves = [loop k in 0..ISLANDS.len(): build_grove(k, towns)]
chart = build_chart()
flocks = build_flocks(towns, 21)
bird_mesh = build_bird()
fleet = build_fishing_fleet(towns, 33)
craft_models = [build_craft(.gull, LIVERIES[0]), build_craft(.heron, LIVERIES[5]), build_craft(.corsair, LIVERIES[3]), build_craft(.falco, LIVERIES[1]),
    build_craft(.gull, LIVERIES[1]), build_craft(.gull, LIVERIES[2]), build_craft(.heron, LIVERIES[4]), build_craft(.gull, LIVERIES[4]),
    build_craft(.heron, LIVERIES[2]), build_craft(.gull, LIVERIES[5]), build_craft(.falco, LIVERIES[3]), build_craft(.corsair, LIVERIES[4])]
if env("TOWNS_PRINT") != none:
    loop tw in towns: print("{tw.name}: {tw.center.x:.0} {tw.center.z:.0} out {tw.out.x:.2} {tw.out.y:.2} houses {tw.houses.len()}")
print("world built in {(time() - t0) * 1000.0:.0} ms")

fonts = Fonts(load_font(embed("assets/fonts/JosefinSans-SemiBold.ttf")), load_font(embed("assets/fonts/Limelight-Regular.ttf")))

# ---------------- the player ----------------

enum Mode:
    walking
    aboard          # in the cockpit (the flight model comes here)
    free            # a free camera, for looking around

struct Player:
    mode: Mode = .walking
    pos: vec3
    yaw: f64 = 0.0                  # the way they face (world turn: faces (sin, cos))
    phase: f64 = 0.0                # the walk's swing
    stride: f64 = 0.0
    money = 120

# an aircraft at rest: moored at a dock, bobbing on the swell
struct Moored:
    kind: Craft
    model: int
    pos: vec3
    yaw: f64

home = towns[0]
along_quay = atan2(f64(home.out.x), -f64(home.out.y))        # (a flight heading: 0 north, east PI/2)
# the player's own aircraft, moored at the first dock; others moored at the rest
pc = make_flyer(.gull, 0, craft_models[0].contacts, home.docks[0], along_quay)
moored: Moored[]
traffic = make_living_traffic(living_world, craft_models)
bind_living_player(pc, living_world, traffic_scene)

# ---------------- the people of the towns, the boards, talking and trading ----------------

folks: Folk[]
sync_folk(folks, living_world, towns)
folk_sync_t = 0.0
enum Ui: none, talk, board, trade
ui = Ui.none
ui_folk = -1
ui_place = -1
ui_line = ""
ui_news = 0
toast = ""
paused = false
toast_until = 0.0

# a harbor's notice board: two posts and a board with a little roof, on the waterfront
board_mesh = custom_mesh(():
    vs: Vertex3D[]
    wood = rgb(0.42, 0.3, 0.19)
    add_box(vs, vec3(-0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0, 1.45, 0), vec3(2.1, 1.1, 0.08), rgb(0.5, 0.36, 0.22))
    loop k in 0..5: add_box(vs, vec3(f32(-0.75 + f64(k) * 0.37), f32(1.45 + f64((k * 37) % 3) * 0.12 - 0.12), 0.06), vec3(0.28, 0.34, 0.02), rgb(0.95, 0.91, 0.8))
    add_gable(vs, vec3(0, 2.05, 0), 2.2, 0.5, 0.25, ROOFS[1], mat4())
    vs
())
board_spots: vec3[]
loop tw in towns:
    bp = tw.center - vec3(tw.out.x, 0, tw.out.y) * 4.0 + vec3(-tw.out.y, 0, tw.out.x) * 7.0
    board_spots.push(vec3(bp.x, f32(walk_height(towns, f64(bp.x), f64(bp.z))), bp.z))

# (AEGEAN_UI=board|talk|trade opens that panel at the home harbor at the start, for screenshots)
if let v = env("AEGEAN_UI"):
    living.advance_minutes(living_world, if v == "board": 180 else: 20)
    sync_folk(folks, living_world, towns)
    ui_place = 0
    if v == "board": ui = .board
    else:
        loop k in 0..folks.len():
            if folks[k].place == 0 and ui_folk < 0 and (v != "trade" or living_world.people[folks[k].person].occupation == .merchant): ui_folk = k
        # (talk: someone with work to offer, if anyone has)
        loop k in 0..folks.len():
            loop id in living_world.active_jobs:
                if v == "talk" and living_world.jobs[id].state == .open and living_world.jobs[id].poster == folks[k].person and living_world.jobs[id].origin == folks[k].place: ui_folk = k
        if ui_folk >= 0:
            ui = if v == "trade": Ui.trade else: Ui.talk
            ui_line = say(living_world, folks[ui_folk].person)

player_cents = () -> int:
    a = living_world.people[living_world.player].account
    if a >= 0: living_world.accounts[a].cents else: 0

say_toast = (s: str):
    global toast, toast_until
    toast = s
    toast_until = t + 5.0

# the town one is in (by the nearest waterfront within a few hundred meters), or -1
town_here = (p: vec3) -> int:
    best = -1
    bd = 450.0
    loop k in 0..towns.len():
        d = f64(length(vec2(towns[k].center.x - p.x, towns[k].center.z - p.z)))
        if d < bd:
            bd = d
            best = k
    best

near_board = () -> int:
    loop k in 0..board_spots.len():
        if length(board_spots[k] - me.pos) < 3.2: return k
    -1

# jobs the player carries for this place, delivered on arrival (paid then)
deliver_here = (place: int):
    loop id in living_world.active_jobs:
        j = living_world.jobs[id]
        if j.state != .claimed or j.carrier != living_world.player or j.destination != place or j.purpose != .passenger: continue
        before = player_cents()
        if living.deliver_job(living_world, id, living_world.player):
            say_toast("Delivered for {living_world.people[j.poster].name}: {(player_cents() - before) / 100} lire")
spray_ps = Particles3D(gravity = vec3(0, -9.8, 0), drag = 1.5)
smoke_ps = Particles3D(gravity = vec3(0, 1.5, 0), drag = 2.0)
vapor_trails = [Trail(), Trail()]
wakes: WakeTrail[] = [loop k in 0..traffic.len() + 1: WakeTrail()]

# on the main quay, beside one's own aircraft
q0 = home.quays[0]
dk = vec2(home.docks[0].x, home.docks[0].z)
qd = q0.b - q0.a
along_q = clamp(dot(dk - q0.a, qd) / dot(qd, qd), 0.0, 1.0)
on_q = q0.a + qd * along_q
toward = normalize(dk - on_q)
sp = on_q + toward * (q0.width * 0.5 - 1.2)
start = vec3(sp.x, 0, sp.y)
me = Player(pos = vec3(start.x, f32(walk_height(towns, f64(start.x), f64(start.z))), start.z), yaw = atan2(f64(home.out.x), f64(home.out.y)))
me_fig = build_figure(.pilot, 7)
tuft = build_tuft()
audio = if env("SLOPPY_NO_AUDIO") != none: Audio() else: start_audio()
grass = GrassField(me.pos, instance_buffer([Instance3D(mat4(), vec4(1, 1, 1, 1))]), 0)

follow = follow_camera(distance = 5.5, pitch = 0.25, height = 1.6)
follow.yaw = me.yaw + PI
free = fly_camera(vec3(2600, 380, 2600), 0.8, -0.18)
free.speed = 120.0
hour = to_float(env("AEGEAN_HOUR") ?? "9.5") ?? 9.5
t = 0.0
show_chart = env("AEGEAN_CHART") != none

if let v = env("AEGEAN_VIEW"):
    w = split(v, " ")
    if w.len() >= 6:
        free.pos = vec3(f32(to_float(w[0]) ?? 0.0), f32(to_float(w[1]) ?? 0.0), f32(to_float(w[2]) ?? 0.0))
        free.yaw = to_float(w[3]) ?? 0.0
        free.pitch = to_float(w[4]) ?? 0.0
        hour = to_float(w[5]) ?? 15.0
        me.mode = .free
if let v = env("AEGEAN_AT"):
    w = split(v, " ")
    x = to_float(w[0]) ?? 0.0
    z = to_float(w[1]) ?? 0.0
    me.pos = vec3(f32(x), f32(walk_height(towns, x, z)), f32(z))
    follow.yaw = to_float(w[2]) ?? 0.0
if env("AEGEAN_ABOARD") != none: me.mode = .aboard
trace = env("AEGEAN_TRACE") != none
# AEGEAN_FLYING="altitude speed" starts in the air off the home harbor, heading out to sea
if let v = env("AEGEAN_FLYING"):
    w = split(v, " ")
    alt = to_float(w[0]) ?? 60.0
    spd = to_float(w[1]) ?? 55.0
    h = along_quay
    p0 = home.docks[0] + vec3(home.out.x, 0, home.out.y) * 500.0
    pc.state = CraftState(position = vec3(p0.x, f32(alt), p0.z), velocity = heading_vector(h) * f32(spd), orientation = quat_euler(0, -h, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, throttle = 0.85)
    pc.throttle = 0.85
    pc.aim_heading = h
    me.mode = .aboard
if let v = env("AEGEAN_WIND"):
    w = split(v, " ")
    wind_now.speed = to_float(w[0]) ?? 6.0

# ---------------- townsfolk wandering (until the world's people walk here themselves) ----------------

struct Walker:
    fig: Figure
    town: int
    pos: vec3
    target: vec3
    yaw: f64
    phase: f64
    wait: f64
    speed: f64

walkers: Walker[]
seed_random(5)
loop ti in 0..towns.len():
    tw = towns[ti]
    if tw.houses.len() < 3: continue
    n = min(6, 1 + tw.houses.len() / 12)
    loop k in 0..n:
        hp = tw.houses[random_int(0, tw.houses.len() - 1)]
        dress: Dress = [Dress.fisher, .merchant, .dress, .widow, .worker, .fisher, .police][k % 7]
        p = vec3(hp.x, f32(walk_height(towns, f64(hp.x), f64(hp.z))), hp.z)
        walkers.push(Walker(build_figure(dress, ti * 100 + k), ti, p, p, random(0.0, TAU), 0.0, random(0.0, 5.0), random(1.0, 1.5)))

_pick_target = (w: Walker) -> vec3:
    tw = towns[w.town]
    if random() < 0.4 and tw.quays.len() > 0:
        q = tw.quays[random_int(0, tw.quays.len() - 1)]
        p = q.a + (q.b - q.a) * f32(random(0.15, 0.95))
        return vec3(p.x, 0, p.y)
    hp = tw.houses[random_int(0, tw.houses.len() - 1)]
    vec3(hp.x + f32(random(-6.0, 6.0)), 0, hp.z + f32(random(-6.0, 6.0)))

update_walkers = (dt: f64):
    loop mut w in walkers:
        if length(w.pos - me.pos) > 900.0: continue
        if w.wait > 0.0:
            w.wait -= dt
            if w.wait <= 0.0: w.target = _pick_target(w)
            continue
        d = vec2(w.target.x - w.pos.x, w.target.z - w.pos.z)
        l = f64(length(d))
        if l < 1.0:
            w.wait = random(2.0, 12.0)
            continue
        dir = d / f32(l)
        w.yaw = approach_angle(w.yaw, atan2(f64(dir.x), f64(dir.y)), 6.0, dt)
        np = walk_step(towns, w.pos, vec2(f32(sin(w.yaw)), f32(cos(w.yaw))) * f32(w.speed * dt))
        if np == w.pos:
            w.wait = random(0.5, 3.0)            # stuck: pause, then go somewhere else
        w.pos = np
        w.phase += dt * w.speed * 5.5

# ---------------- update ----------------

# by one's own aircraft, at rest on the water or moored
# the wind as a velocity (for cloth)
wind_now_vec = () -> vec3: vec3(wind_now.dir.x, 0, wind_now.dir.y) * f32(wind_now.speed)

near_own_craft = () -> bool:
    d = f64(length(vec2(pc.state.position.x - me.pos.x, pc.state.position.z - me.pos.z)))
    d < 8.5 and (pc.state.moored or length(pc.state.velocity) < 1.0)

rope: Rope
was_moored = false

# the notebook, and errands agreed with people: the cargo waiting on the quay by one's aircraft
notebook = load_notebook()
struct Pending:
    job: int
    pos: vec3
pending: Pending[]
crate_mesh = custom_mesh(():
    vs: Vertex3D[]
    add_box(vs, vec3(-0.5, 0.4, 0), vec3(0.9, 0.8, 0.9), rgb(0.62, 0.47, 0.3))
    add_box(vs, vec3(0.5, 0.35, 0.1), vec3(0.8, 0.7, 0.8), rgb(0.55, 0.4, 0.25))
    add_box(vs, vec3(0, 1.1, 0), vec3(0.8, 0.6, 0.7), rgb(0.66, 0.5, 0.32))
    add_box(vs, vec3(0, 1.42, 0), vec3(0.3, 0.02, 0.5), rgb(0.85, 0.2, 0.15))
    vs
())

# who at a job's destination is waiting for it: whoever it is for, if they live there, else the
# harbor's merchant
recipient_of = (id: int) -> int:
    j = living_world.jobs[id]
    b = j.cause.beneficiary
    if b >= 0 and b < living_world.people.len() and living_world.people[b].home == j.destination: return b
    living_world.places[j.destination].market_owner

# what a job carries, in a few words
job_cargo = (id: int) -> str:
    j = living_world.jobs[id]
    if j.purpose == .passenger: return living_world.people[j.passenger].name
    if j.cargo_mode == .sealed: return "the sealed bag"
    "the {living_world.goods[j.good].key}"

# the cargo for an errand: set down on the quay beside one's aircraft (or none if it is not here)
crate_spot = () -> vec3?:
    if not pc.state.moored: return none
    if let a = mooring_anchor():
        side = normalize(vec3(a.x - pc.state.position.x, 0, a.z - pc.state.position.z) + vec3(0.001, 0, 0))
        along = vec3(-side.z, 0, side.x)
        q = a + side * 1.8 + along * 2.0
        return vec3(q.x, f32(walk_height(towns, f64(q.x), f64(q.z))), q.z)
    none

near_pending = () -> int:
    loop k in 0..pending.len():
        if length(pending[k].pos - me.pos) < 3.0: return k
    -1

# guns, cloth, debugging
guns = Guns()
splashes: Splash[]
dust_ps = Particles3D(gravity = vec3(0, -9.8, 0), drag = 1.2)
cloth_mesh: ClothMesh
dbg = Debug()
wind_bias = 0.0
last_shots = 0
MUZZLES: vec3[] = [vec3(-2.7, 1.7, -1.3), vec3(2.7, 1.7, -1.3)]

# a new aircraft of another kind for the player, where the old one is (moored where it was moored)
change_craft = (kind: Craft, model: int):
    global pc
    old = pc.state
    nf = make_flyer(kind, model, craft_models[model].contacts, old.position - vec3(0, f32(pc.spec.float_height), 0), heading(old))
    if not old.moored:
        unmoor(nf.state)
        nf.state.position = old.position
        nf.state.velocity = old.velocity
        nf.state.orientation = old.orientation
        nf.state.on_water = old.on_water
        nf.state.water_age = old.water_age
        nf.throttle = pc.throttle
    nf.placed = false
    pc = nf

# the debugging panel: how things are now, for it to show and change
debug_view = () -> DebugView:
    v = DebugView()
    v.craft = pc.model
    v.fuel = pc.state.fuel / max(pc.spec.fuel_capacity, 0.001)
    v.parts = [loop k in 0..pc.spec.parts.len(): part_health(pc.state.damage, pc.spec.parts[k].id)]
    c = living_world.people[living_world.player].craft
    if c >= 0:
        v.hull_wear = 1.0 - f64(living_world.aircraft[c].hull) / 1000.0
        v.engine_wear = 1.0 - f64(living_world.aircraft[c].engine) / 1000.0
    v.hour = hour
    v.wind = wind_bias
    v.wind_now = wind_now.speed
    v.lire = player_cents() / 100
    v

# the debugging panel's fuel and money, entered in the living world's books (fuel made or spent,
# money brought in from or sent out of the world) so its conservation checks still hold
debug_fuel_ml = (c: int, ml: int):
    if c < 0: return
    cap = lt.AIRFRAMES[int(living_world.aircraft[c].kind)].tank_ml
    want = clamp(ml, 0, cap)
    d = want - living_world.aircraft[c].fuel_ml
    if d > 0: living_world.goods_ledger.created[int(lt.GoodKind.fuel)] += d
    else: living_world.goods_ledger.consumed[int(lt.GoodKind.fuel)] += -d
    living_world.aircraft[c].fuel_ml = want
    living_world.aircraft[c].revision += 1

debug_cents = (cents: int):
    a = living_world.people[living_world.player].account
    if a < 0: return
    want = max(0, cents)
    d = want - living_world.accounts[a].cents
    if d > 0: living_world.ledger.external_in_cents += d
    else: living_world.ledger.external_out_cents += -d
    living_world.accounts[a].cents = want

# put the aircraft in the air (or on the water, at 0 m) at x, z
debug_place = (x: f64, z: f64, alt: f64):
    h = heading(pc.state)
    unmoor(pc.state)
    if alt < 5.0:
        if surface_height(x, z) > 0.0:
            say_toast("That's land there: give it some altitude")
            return
        pc.state = water_start(pc.spec, vec3(f32(x), 0, f32(z)), h)
        pc.throttle = 0.0
    else:
        ground = max(surface_height(x, z), 0.0)
        pc.state.position = vec3(f32(x), f32(max(alt, ground + 40.0)), f32(z))
        pc.state.velocity = heading_vector(h) * f32(pc.spec.cruise_speed)
        pc.state.orientation = quat_euler(0, -h, 0)
        pc.state.angular_velocity = vec3(0, 0, 0)
        pc.state.on_water = false
        pc.state.water_age = 1.0
        pc.state.crashed = false
        pc.throttle = 0.8
    pc.aim_heading = h
    pc.aim_climb = 0.0
    pc.placed = false
    me.mode = .aboard

# what the debugging panel changed or asked for
debug_apply = (was: DebugView, v: DebugView, r: DebugResult):
    global hour, wind_bias
    c = living_world.people[living_world.player].craft
    if v.craft != was.craft:
        match v.craft:
            0: change_craft(.gull, 0)
            1: change_craft(.heron, 1)
            2: change_craft(.corsair, 2)
            _: change_craft(.falco, 3)
        return
    if abs(v.fuel - was.fuel) > 0.0001:
        pc.state.fuel = v.fuel * pc.spec.fuel_capacity
        debug_fuel_ml(c, int(pc.state.fuel * 1000.0))
    st = pc.state
    loop k in 0..min(v.parts.len(), was.parts.len()):
        if abs(v.parts[k] - was.parts[k]) < 0.0001: continue
        id = pc.spec.parts[k].id
        i = int(id)
        if v.parts[k] <= 0.0:
            detach_part(pc.state.damage, pc.spec.parts, id, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        else:
            if not pc.state.damage.parts[i].attached:
                # (put back: its wreckage gone from the water)
                pc.state.damage.parts[i].attached = true
                pc.state.damage.debris = [loop db in pc.state.damage.debris if db.part != id: db]
            pc.state.damage.parts[i].health = v.parts[k]
    if c >= 0:
        if abs(v.hull_wear - was.hull_wear) > 0.0001: living_world.aircraft[c].hull = int((1.0 - v.hull_wear) * 1000.0 + 0.5)
        if abs(v.engine_wear - was.engine_wear) > 0.0001: living_world.aircraft[c].engine = int((1.0 - v.engine_wear) * 1000.0 + 0.5)
    if abs(v.hour - was.hour) > 0.0001: hour = v.hour % 24.0
    wind_bias = v.wind
    match r.act:
        .repair:
            pc.state.damage = DamageState()
            pc.state.crashed = false
            pc.state.capsized = false
            pc.state.hull_damage = 0.0
            pc.state.engine_damage = 0.0
            if c >= 0:
                living_world.aircraft[c].hull = 1000
                living_world.aircraft[c].engine = 1000
        .wreck: detach_part(pc.state.damage, pc.spec.parts, .body, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        .money_add: debug_cents(player_cents() + 100000)
        .money_set: debug_cents(r.lire * 100)
        .to_altitude:
            p0 = if me.mode == .aboard: pc.state.position else: me.pos
            debug_place(f64(p0.x), f64(p0.z), dbg.altitude)
        .pick:
            global show_chart
            dbg.picking = true
            dbg.open = false
            show_chart = true
        .to_town:
            tw = towns[r.town]
            dock = free_dock(tw, others_at(), tw.center) ?? tw.docks[0]
            h = atan2(f64(tw.out.x), -f64(tw.out.y))
            pc.state = water_start(pc.spec, dock, h)
            moor(pc.state, pc.state.position, h)
            pc.throttle = 0.0
            pc.placed = false
            tie_up()
            if me.mode != .aboard: step_ashore(dock)
        _: pass

# the other aircraft's places (for keeping docks free)
others_at = () -> vec3[]: [loop tr in traffic: tr.state.position]

# tie up at the bollard nearest the aircraft
tie_up = ():
    if let b = nearest_bollard(towns, pc.state.position):
        rope.anchor = b
        rope.tied = true
        rope.loose = b
        global was_moored
        was_moored = true

# where the player's aircraft is tied: the bollard its line is on (none: not moored)
mooring_anchor = () -> vec3?:
    if pc.state.moored and rope.tied: return rope.anchor
    if not pc.state.moored: return none
    p = vec2(pc.state.position.x, pc.state.position.z)
    best: vec3? = none
    bd = 40.0
    loop tw in towns:
        if length(vec2(tw.center.x, tw.center.z) - p) > 600.0: continue
        loop q in tw.quays:
            d = q.b - q.a
            u = clamp(dot(p - q.a, d) / dot(d, d), 0.0, 1.0)
            c = q.a + d * u
            off = p - c
            l = f64(length(off))
            if l < bd and l > 0.01:
                bd = l
                e = c + off / f32(l) * (q.width * 0.5 - 0.4)
                best = vec3(e.x, f32(QUAY_TOP + 0.5), e.y)
    best

# haul the line in a little: the aircraft comes alongside (to a few meters off the quay's edge)
haul_in = (dt: f64):
    if let a = mooring_anchor():
        p = pc.state.position
        off = vec3(p.x - a.x, 0, p.z - a.z)
        l = f64(length(off))
        if l > 3.6:
            step = min(1.4 * dt, l - 3.6)
            np = p - off / f32(l) * f32(step)
            pc.state.position = np
            pc.state.mooring_point = np

# where the engine is, in the aircraft's frame (for its smoke)
pm_engine_at = (f: Flyer) -> vec3: craft_models[f.model].prop_at + vec3(0, 0, 0.8)

# off the aircraft onto the quay beside a dock (or the nearest walkable ground)
step_ashore = (near: vec3):
    best = me.pos
    found = false
    loop r in [5.0, 8.0, 12.0, 18.0]:
        loop k in 0..16:
            a = f64(k) / 16.0 * TAU
            c = near + vec3(f32(cos(a) * r), 0, f32(sin(a) * r))
            h = walk_height(towns, f64(c.x), f64(c.z))
            if h > 0.5 and not found:
                best = vec3(c.x, f32(h), c.z)
                found = true
    if found:
        me.pos = best
        me.mode = .walking
        follow.placed = false

update = (dt: f64):
    global t, hour, show_chart, pc, ui, ui_folk, ui_line, ui_news, ui_place, paused
    # P stops the world (and its sounds) until pressed again
    if key_pressed(.p) and not notebook.open and not ui_typing():
        paused = not paused
        if paused: mouse_lock(false)
    if paused:
        hush_audio(audio)
        return
    let dt = clamp(dt, 0.0, 0.25)
    t += dt
    wind_step(wind_now, t, dt, hour)
    hour = (hour + dt / 120.0 + 24.0) % 24.0          # an hour of the day: two minutes
    typing = ui_typing()
    if key_down(.n1) and not typing: hour = (hour - dt * 2.0 + 24.0) % 24.0
    if key_down(.n2) and not typing: hour = (hour + dt * 2.0) % 24.0
    if key_pressed(.m) and not typing:
        show_chart = not show_chart
        dbg.picking = false
    # (picking a place on the chart for the debugging panel)
    if dbg.picking and show_chart and mouse_pressed(.left):
        if let q = chart_place(mouse_pos()):
            debug_place(f64(q.x), f64(q.y), dbg.altitude)
            dbg.picking = false
            show_chart = false
            dbg.open = true
    if key_pressed(.escape): mouse_lock(false)
    # (a click takes the mouse for the camera only when no panel is open to be clicked)
    if mouse_pressed(.left) and me.mode != .free and ui == .none and not notebook.open and not dbg.open and not show_chart: mouse_lock(true)
    if key_pressed(.j) and not notebook.open and ui == .none and not typing:
        notebook.open = true
        mouse_lock(false)
    if key_pressed(.f2) and not typing: me.mode = if me.mode == .free: Mode.walking else: Mode.free
    match me.mode:
        .free: free.update(dt)
        .walking:
          if ui != .none: update(follow, me.pos, dt)
          if ui == .none and not notebook.open:
              follow.distance = clamp(follow.distance * pow(0.93, clamp(mouse_wheel(), -3.0, 3.0)), 2.5, 14.0)
              if key_down(.q): follow.yaw += dt * 2.0
              if key_down(.e): follow.yaw -= dt * 2.0
              a = input_axis()
              move = flat_forward(follow) * -a.y + flat_right(follow) * a.x
              run = key_down(.shift)
              speed = if run: 4.2 else: 1.7
              if length(move) > 0.1:
                  dir = normalize(vec2(move.x, move.z))
                  me.yaw = approach_angle(me.yaw, atan2(f64(dir.x), f64(dir.y)), 10.0, dt)
                  me.pos = walk_step(towns, me.pos, dir * f32(speed * dt))
                  me.stride = approach(me.stride, if run: 1.0 else: 0.7, 8.0, dt)
                  me.phase += dt * speed * 5.0
              else:
                  me.stride = approach(me.stride, 0.0, 8.0, dt)
              update(follow, me.pos, dt)
              if key_down(.f) and not near_own_craft() and pc.state.moored:
                  if let a = mooring_anchor():
                      if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: haul_in(dt)
              # talk to whoever is near; read the board
              if key_pressed(.f) and near_pending() >= 0:
                  # load the errand's cargo aboard: the job is now one's own
                  pj = pending[near_pending()]
                  if living.take_job(living_world, pj.job, living_world.player):
                      j = living_world.jobs[pj.job]
                      say_toast("Aboard: {job_cargo(pj.job)} for {living_world.people[recipient_of(pj.job)].name} at {SETTLEMENTS[j.destination].name}, by {clock_text(living_world, j.due_minute)}")
                  else: say_toast("It won't go aboard now: someone else has taken the job, or the aircraft is full")
                  pending.remove_at(near_pending())
              if key_pressed(.t):
                  k = nearest_folk(folks, me.pos, 3.5)
                  if k >= 0:
                      ui = .talk
                      ui_folk = k
                      ui_line = say(living_world, folks[k].person)
                      # (someone whose cargo one has brought sees it)
                      loop id in living_world.active_jobs:
                          j = living_world.jobs[id]
                          if j.state == .claimed and j.carrier == living_world.player and j.loaded and j.destination == folks[k].place and recipient_of(id) == folks[k].person:
                              ui_line = "Is that {job_cargo(id)} from {living_world.people[j.poster].name}?"
                      ui_news = 0
                      mouse_lock(false)
              if key_pressed(.f) and not near_own_craft() and near_board() >= 0:
                  ui = .board
                  ui_place = near_board()
                  mouse_lock(false)
              if key_pressed(.f) and near_own_craft() and near_pending() < 0:
                  me.mode = .aboard
                  mouse_lock(true)
                  pc.placed = false
                  pc.throttle = 0.0
        .aboard:
            fly(pc, dt, t)
            # the guns: Space in the air, or the left button once the game has the mouse
            held = (key_down(.space) and not pc.state.on_water) or (mouse_down(.left) and is_mouse_locked())
            fire(guns, held and not pc.state.crashed, craft_transform(pc), pc.state.velocity, MUZZLES, dt, spray_ps)
            if guns.shots != last_shots:
                global last_shots
                last_shots = guns.shots
                gun_sound(audio)
            if trace and floor(t) != floor(t - dt):
                st = pc.state
                f = quat_rotate(st.orientation, vec3(0, 0, -1))
                print("t {t:.0} spd {length(st.velocity):.1} alt {st.position.y:.1} pitch {asin(f64(f.y)) * 57.3:.0} aoa {st.aoa * 57.3:.0} thr {st.throttle:.2} water {st.on_water} stall {st.stalled} crash {st.crashed} cap {st.capsized} hull {st.hull_damage:.2}")
            chase(pc, dt)
            spray(pc, craft_models, spray_ps)
            # what the aircraft hit: a splash, a crunch, parts tearing away; seen, heard and felt
            loop ev in pc.state.damage.events:
                hard = clamp(log(1.0 + ev.strength / 2000.0) / 6.0, 0.0, 1.0)
                if hard < 0.05: continue
                crunch = ev.kind != .splash
                n = int(6.0 + 60.0 * hard)
                emit(spray_ps, ev.position, n, 4.0 + 14.0 * hard, rgba(0.96, 0.98, 1.0, 0.9), 1.4, 0.6 + 0.8 * hard, 0.9, normalize(ev.normal + vec3(0, 1, 0)))
                if crunch: emit(spray_ps, ev.position, n / 2, 6.0 + 10.0 * hard, rgba(0.42, 0.3, 0.2, 1), 1.8, 0.25, PI, vec3(0, 1, 0))
                impact_sound(audio, ev.position, crunch, hard)
                # (the camera feels it: a jolt in its spring)
                pc.cam_ev += normalize(ev.impulse + vec3(0, 0.001, 0)) * f32(-3.0 * hard)
            if pc.state.damage.smoke > 0.02 and not pc.state.on_water:
                eng = transform_point(craft_transform(pc), pm_engine_at(pc))
                emit(smoke_ps, eng, 1, 1.5, rgba(0.18, 0.17, 0.16, f32(0.4 + 0.4 * pc.state.damage.smoke)), 2.5, 1.2, 0.6, vec3(0, 1, 0))
            vapor(pc, vapor_trails, hour, t)
            if key_pressed(.f):
                if let d0 = mooring_spot(pc, towns):
                  if dock_taken(d0, others_at()): say_toast("That dock is taken")
                  else:
                    d = d0
                    moor(pc.state, vec3(d.x, f32(pc.spec.float_height), d.z), heading(pc.state))
                    pc.throttle = 0.0
                    tie_up()
                    step_ashore(d)
                    th = town_here(d)
                    if th >= 0: deliver_here(th)
                else if pc.state.moored: step_ashore(pc.state.position)
            if key_pressed(.r) and (pc.state.crashed or pc.state.capsized or pc.state.beached):
                # towed home to a free dock and patched up (the bill comes later)
                dock = free_dock(home, others_at(), home.docks[0]) ?? home.docks[0]
                pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, dock, along_quay)
                pc.placed = false
                tie_up()
    if was_moored and not pc.state.moored and rope.tied:
        global was_moored
        was_moored = false
        off = vec3(pc.state.position.x - rope.anchor.x, 0, pc.state.position.z - rope.anchor.z)
        rope.loose = rope.anchor + normalize(off + vec3(0.001, 0, 0)) * 3.0
    if not rope.tied and pc.state.moored: tie_up()
    update_bullets(guns, splashes, spray_ps, dust_ps, (x: f64, z: f64) -> f64: f64(swell_at(x, z, t).x), surface_height, t, dt)
    dust_ps.update(dt)
    # debugging: F1 opens the panel; its standing switches
    if key_pressed(.f1):
        dbg.open = not dbg.open
        dbg.picking = false
        if dbg.open: mouse_lock(false)
    if dbg.infinite_fuel:
        pc.state.fuel = pc.spec.fuel_capacity
        debug_fuel_ml(living_world.people[living_world.player].craft, int(pc.spec.fuel_capacity * 1000.0))
    if dbg.no_damage and not pc.state.crashed:
        loop k in 0..pc.state.damage.parts.len():
            if pc.state.damage.parts[k].attached: pc.state.damage.parts[k].health = 1.0
    wind_now.speed = max(0.0, wind_now.speed + wind_bias)
    update_walkers(dt)
    if t - folk_sync_t > 2.0:
        sync_folk(folks, living_world, towns)
        global folk_sync_t
        folk_sync_t = t
    update_folk(folks, living_world, towns, if me.mode == .aboard: pc.state.position else: me.pos, dt)
    update_traffic(traffic, living_world, traffic_scene, if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos, t, dt, pc.state)
    sync_living_player(pc, living_world)
    # skimming: fast within about a span of the water, the downwash churns it and throws spray
    gap = f64(pc.state.position.y) - pc.spec.float_height
    skim = if pc.state.on_water or pc.state.moored: 0.0 else: (1.0 - smoothstep(0.5, pc.spec.span * 0.6, gap)) * smoothstep(28.0, 60.0, f64(length(pc.state.velocity)))
    under = vec3(pc.state.position.x, 0.1, pc.state.position.z) - vec3(pc.state.velocity.x, 0, pc.state.velocity.z) * 0.15
    wake_step(wakes[0], under, pc.state.velocity, pc.state.on_water and not pc.state.moored, 1.6, t, skim)
    if skim > 0.1 and me.mode == .aboard: emit(spray_ps, under, int(1.0 + skim * 4.0), 3.0 + 6.0 * skim, rgba(0.96, 0.98, 1.0, f32(0.5 + 0.4 * skim)), 1.2, 0.5 + 0.6 * skim, 0.7, normalize(vec3(-pc.state.velocity.x, 30.0, -pc.state.velocity.z)))
    loop k in 0..traffic.len():
        tr = traffic[k]
        wake_step(wakes[k + 1], tr.state.position, tr.state.velocity, tr.state.on_water and not tr.state.moored, if tr.kind == .heron: 1.4 else: 1.6, t)
    if trace and floor(t / 10.0) != floor((t - dt) / 10.0):
        print("living minute {living_world.minute}, tick {living_world.tick}")
        loop tr in traffic: print("  craft {tr.craft} / {tr.name}: {if tr.flying: (if tr.materialized: str(tr.plan.phase) else: "abstract") else: "moored"} -> {towns[tr.town].name} at {tr.state.position.x:.0} {tr.state.position.y:.0} {tr.state.position.z:.0}; {tr.why}")
        loop id, trip in living_world.trips:
            if trip.state == .arrived: print("  committed arrival {id}: {living_world.people[trip.actor].name} at {towns[trip.destination].name}")
    spray_ps.update(dt)
    smoke_ps.update(dt)
    flying = me.mode == .aboard
    where = if flying: pc.state.position else: me.pos
    shore = abs(f64(surface_height(f64(where.x), f64(where.z)))) * 8.0 + (if flying: f64(where.y) * 2.0 else: 0.0)
    update_audio(audio, dt, flying and not pc.state.moored, pc.state.throttle, if flying: f64(length(pc.state.velocity)) else: 0.0, shore, not flying, where)
    # the grass around whoever is on foot (rebuilt as they go)
    if me.mode == .walking and (not grass.built or length(grass.center - me.pos) > 12.0):
        global grass
        grass = build_grass(towns, me.pos)

# ---------------- draw ----------------

craft_matrix = (m: Moored) -> mat4:
    bob = sin(t * 1.3 + f64(m.pos.x)) * 0.12
    roll = sin(t * 0.9 + f64(m.pos.z)) * 0.03
    translation(m.pos + vec3(0, f32(2.1 + bob), 0)) * rotation_y(m.yaw) * rotation_z(roll)

draw_world = (L: Light):
    draw_custom(():
        bow = transform_point(afloat(pc.state.position, t) * craft_transform(pc), vec3(1.4, -1.9, -2.6))
        draw_rope(rope, pc.state.moored, bow, L, t))
    draw_custom((): draw_sky(L, t))
    draw_custom((): draw_ground(ground_meshes, L, t))
    draw_custom((): draw_towns(towns, L, t))
    draw_custom((): draw(obj_sh, fleet, obj_params(L, t, translation(vec3(0, f32(sin(t * 1.1) * 0.12), 0)))))
    draw_custom((): draw_birds(bird_mesh, flocks, L, t))
    draw_custom((): draw_groves(tree_meshes, groves, L, t))
    draw_custom(():
        loop m in moored:
            cm = craft_models[m.model]
            at = craft_matrix(m)
            draw(obj_sh, cm.body, obj_params(L, t, at))
            draw(obj_sh, cm.prop, obj_params(L, t, at * translation(cm.prop_at) * rotation_z(0.4)))
        draw_folk(folks, L, t)
        loop pj in pending: draw(obj_sh, crate_mesh, obj_params(L, t, translation(pj.pos)))
        loop k in 0..board_spots.len():
            tw = towns[k]
            draw(obj_sh, board_mesh, obj_params(L, t, translation(board_spots[k]) * rotation_y(atan2(f64(tw.out.x), f64(tw.out.y)))))
        loop w in walkers:
            if length(w.pos - scene_camera()) < 600.0: draw_figure(w.fig, w.pos, w.yaw, w.phase, if w.wait > 0.0: 0.0 else: 0.8, L, t)
        if me.mode == .walking: draw_figure(me_fig, me.pos, me.yaw, me.phase, me.stride, L, t)
        draw_traffic(traffic, craft_models, L, t)
        pm = craft_models[pc.model]
        at = (if pc.state.moored: afloat(pc.state.position, t) else: mat4()) * craft_transform(pc)
        draw_craft_parts(pm, pc.state.damage, at, L, t, pc.prop_angle, airframe(pc))
        draw_debris(pm, pc.state.damage, L, t)
        if me.mode == .aboard: draw_figure_at(me_fig, at * translation(pm.cockpit - vec3(0, 1.55, 0)), 0.0, 0.0, L, t)
        if me.mode != .free or length(scene_camera() - grass.center) < 300.0: draw_grass(tuft, grass, L, t)
    )
    draw_custom((): draw_clouds(puff_mesh, puffs, L, wind_now.drift * 0.35, t))
    # shadows of the aircraft near the camera: on the sea, drawn by the sea itself; on land, flattened meshes
    sea_sh = SeaShadows()
    cam = scene_camera()
    land: (CraftState, CraftModel)[]
    loop k in 0..traffic.len() + 1:
        st = if k == 0: pc.state else: traffic[k - 1].state
        cm = if k == 0: craft_models[pc.model] else: craft_models[traffic[k - 1].model]
        if length(st.position - cam) > 1500.0: continue
        sd = normalize(L.sun_dir)
        if sd.y < 0.08: continue
        under = st.position - sd * f32(f64(st.position.y) / max(f64(sd.y), 0.2))
        g = surface_height(f64(under.x), f64(under.z))
        hgt = f64(st.position.y) - max(g, 0.0)
        a = 0.55 * (1.0 - smoothstep(60.0, 420.0, hgt)) * smoothstep(0.08, 0.2, f64(sd.y))
        if g > 0.3:
            land.push((st, cm))
            continue
        m = translation(st.position) * quat_to_mat4(st.orientation)
        loop j in 0..cm.shade.len() / 2: add_sea_shadow(sea_sh, m, cm.shade[j * 2], cm.shade[j * 2 + 1], L.sun_dir, a)
    draw_custom((): draw_sea(sea_mesh, depth_tex, L, t, wind_now, if me.mode == .aboard: pc.state.velocity else: vec3(0, 0, 0), sea_sh), transparent = true)
    draw_custom(():
        loop sc in land:
            st, cm = sc
            sd = normalize(L.sun_dir)
            g0 = max(surface_height(f64(st.position.x), f64(st.position.z)), 0.0)
            under = st.position - sd * f32((f64(st.position.y) - g0) / max(f64(sd.y), 0.2))
            g = max(surface_height(f64(under.x), f64(under.z)), 0.0)
            draw_shadow(cm.body, translation(st.position) * quat_to_mat4(st.orientation), g + 0.4, f64(st.position.y) - g, L)
    , transparent = true)
    if env("AEGEAN_NOWAKE") == none: draw_custom((): draw_wakes(wakes, L, t), transparent = true)
    spray_ps.draw(false)
    smoke_ps.draw(false)
    draw_custom((): draw_trails(vapor_trails, L, t), transparent = true)
    dust_ps.draw(false)
    draw_tracers(guns)
    draw_splash_rings(splashes, t)
    draw_custom((): draw_cloths(cloth_mesh, cloths_for(craft_models[pc.model].cockpit, pc.model), craft_transform(pc), wind_now_vec() - pc.state.velocity, L, t))

draw = ():
    L = light_at(hour)
    clear(BLACK)
    sun(L.sun_dir, L.sun, 0.0)
    hide_sky()
    fog(L.haze, L.fog_density, 0.0012)
    post_effects(0.35, 0.85, 0.22, 1.08)
    match me.mode:
        .free: camera3d(free, 62.0, 1.0, 30000.0)
        .aboard: place_chase_camera(pc, t)
        _: camera3d(follow, 58.0, 0.3, 30000.0)
    draw_world(L)
    set_font(fonts.ui)
    text("{int(hour):02}:{int((hour - floor(hour)) * 60.0):02}", vec2(f32(screen_width() - 80), 18), 22, rgba(1, 1, 1, 0.85), shadow = rgba(0, 0, 0, 0.4))
    set_font()
    # money
    set_font(fonts.ui)
    text("{player_cents() / 100} lire", vec2(f32(screen_width() - 120), 46), 20, rgba(1, 0.95, 0.8, 0.85), shadow = rgba(0, 0, 0, 0.4))
    set_font()
    # the people about: names over those near, a line from whoever is nearest
    if me.mode == .walking and ui == .none:
        k = nearest_folk(folks, me.pos, 7.0)
        loop i in 0..folks.len():
            f = folks[i]
            if not f.shown or i == k: continue
            d = f64(length(f.pos - me.pos))
            if d < 16.0: name_tag(fonts, f.pos + vec3(0, 1.7, 0), living_world.people[f.person].name, d)
        if k >= 0:
            if t - folks[k].line_t > 20.0:
                folks[k].line = say(living_world, folks[k].person)
                folks[k].line_t = t
            d = f64(length(folks[k].pos - me.pos))
            speech_bubble(fonts, folks[k].pos + vec3(0, 1.7, 0), living_world.people[folks[k].person].name, folks[k].line, d, 8.0)
    match me.mode:
        .walking:
            if ui != .none: pass
            else if near_pending() >= 0: prompt_card(fonts, "F  load {job_cargo(pending[near_pending()].job)} aboard")
            else if near_own_craft(): prompt_card(fonts, "F  climb aboard your {CRAFT_NAMES[int(pc.kind)]}")
            else if near_board() >= 0: prompt_card(fonts, "F  read the notices")
            else if nearest_folk(folks, me.pos, 3.5) >= 0: prompt_card(fonts, "T  talk to {living_world.people[folks[nearest_folk(folks, me.pos, 3.5)].person].name}")
            else if pc.state.moored:
                if let a = mooring_anchor():
                    if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: prompt_card(fonts, "hold F  haul in the line")
        .aboard:
            if pc.state.crashed or pc.state.capsized: prompt_card(fonts, "Wrecked.  R  to be towed home", 180.0)
            else if pc.state.beached: prompt_card(fonts, "Run aground.  R  to be towed home", 180.0)
            else if pc.state.moored: prompt_card(fonts, "F  step onto the quay      Shift  open the throttle", 180.0)
            else if mooring_spot(pc, towns) != none: prompt_card(fonts, "F  moor here", 180.0)
        .free: text("{free.pos.x:.0} {free.pos.y:.0} {free.pos.z:.0}", vec2(16, 16), 18, rgba(1, 1, 1, 0.7))
    if me.mode == .aboard:
        aim_marks(pc)
        st = pc.state
        instruments(fonts, f64(length(st.velocity)), f64(st.position.y) - pc.spec.float_height, st.throttle, pc.throttle, st.fuel / pc.spec.fuel_capacity, (heading(st) + TAU) % TAU, pc.spec.stall_speed, pc.spec.max_speed)
    if me.mode != .free and not paused: title_card(fonts, t)
    if key_down(.h) or (t > 7.5 and t < 22.0 and me.mode == .walking): controls_card(fonts, me.mode == .aboard)
    draw_ui()
    notebook_panel(fonts, notebook, clock_text(living_world, living_world.minute))
    if dbg.open:
        was = debug_view()
        v = was
        debug_apply(was, v, debug_panel(dbg, v, [loop tw in towns: tw.name], CRAFT_NAMES))
    if dbg.picking and show_chart: prompt_card(fonts, "Click where to go  ({int(dbg.altitude)} m)", 60.0)
    if t < toast_until: prompt_card(fonts, toast, 260.0)
    if paused: pause_card(fonts)
    if show_chart: draw_chart(chart, towns, if me.mode == .aboard: pc.state.position else: me.pos, if me.mode == .aboard: heading(pc.state) else: PI - me.yaw, hour,
        [loop tr in traffic: vec4(tr.state.position.x, tr.state.position.y, tr.state.position.z, f32(heading(tr.state)))])

# the panels open over the scene: a conversation, a board, a ledger
draw_ui = ():
    global ui, ui_line, ui_news, ui_place
    match ui:
        .talk:
            if ui_folk < 0 or ui_folk >= folks.len():
                ui = .none
                return
            f = folks[ui_folk]
            p = living_world.people[f.person]
            merchant = p.occupation == .merchant or p.occupation == .innkeeper or p.occupation == .hotelier or p.occupation == .quartermaster
            # errands first: work they posted (offered to them in person), cargo one has brought them
            offers: int[]
            handovers: int[]
            answers: str[]
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.poster == f.person and j.state == .open and j.origin == f.place:
                    offers.push(id)
                    agreed = false
                    loop pj in pending:
                        if pj.job == id: agreed = true
                    answers.push(if agreed: "Where did you put {job_cargo(id)}?" else: "I can take {job_cargo(id)} to {SETTLEMENTS[j.destination].name}.")
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.state == .claimed and j.carrier == living_world.player and j.loaded and j.destination == f.place and recipient_of(id) == f.person:
                    handovers.push(id)
                    answers.push("I've brought {job_cargo(id)} from {living_world.people[j.poster].name}.")
            nerr = answers.len()
            answers.push("What's the news?")
            answers.push("Any work going?")
            if merchant: answers.push("Let's trade.")
            answers.push("Goodbye.")
            role = "{p.occupation}".replace("_", " ")
            c = conversation(fonts, p.name, "{role}, {SETTLEMENTS[f.place].name}", ui_line, answers)
            if key_pressed(.escape): c = answers.len() - 1
            if c >= 0 and c < offers.len():
                id = offers[c]
                j = living_world.jobs[id]
                cpl = living_world.people[living_world.player].craft
                here = living_world.people[living_world.player].place == f.place and pc.state.moored
                busy = false
                if cpl >= 0:
                    loop mid in living_world.aircraft[cpl].job_manifests:
                        if living_world.jobs[mid].state == .claimed: busy = true
                if not here: ui_line = "Bring your aircraft to the quay here, and I'll have it sent down to you."
                else if busy: ui_line = "You've a cargo aboard already. Come back when it's delivered."
                else if not claims.claim_feasible(living_world, id, living_world.player, false): ui_line = "I don't think your aircraft would get it there in time, or it won't fit."
                else:
                    already = false
                    loop pj in pending:
                        if pj.job == id: already = true
                    if already: ui_line = "On the quay, beside your aircraft. Load it aboard when you're ready."
                    else if let spot = crate_spot():
                        pending.push(Pending(id, spot))
                        rcv = living_world.people[recipient_of(id)].name
                        ui_line = if j.purpose == .passenger: "Good. {job_cargo(id)} will meet you at your aircraft." else: "Good, thank you. I'll have {job_cargo(id)} carried down beside your aircraft; load it and take it to {rcv} at {SETTLEMENTS[j.destination].name} by {clock_text(living_world, j.due_minute)}. {j.reward_cents / 100} lire when it's there."
                        pin_notice(notebook, id, j.poster, "{job_cargo(id)} to {SETTLEMENTS[j.destination].name}".replace("the ", ""), "For {rcv}, by {clock_text(living_world, j.due_minute)}. {j.reward_cents / 100} lire. From {living_world.people[j.poster].name}.", clock_text(living_world, living_world.minute))
                    else: ui_line = "Bring your aircraft alongside the quay first."
            else if c >= offers.len() and c < nerr:
                id = handovers[c - offers.len()]
                before = player_cents()
                if living.deliver_job(living_world, id, living_world.player):
                    ui_line = "Thank you. That's what was promised: {(player_cents() - before) / 100} lire."
                else: ui_line = "That's not what I was waiting for."
            else if c >= 0:
              c -= nerr
              if c == 0:
                  # the next thing they know
                  lines: str[]
                  loop n in p.news:
                      l = news_line(living_world, f.person, n)
                      if l != "": lines.push(cap_line(l))
                  ui_line = if lines.len() == 0: "Nothing I've heard." else: lines[ui_news % lines.len()]
                  ui_news += 1
              else if c == 1:
                  ui_place = f.place
                  ui = .board
              else if merchant and c == 2:
                  ui_place = f.place
                  ui = .trade
              else if c >= 0:
                  ui = .none
        .board:
            yesterday: str[]
            loop r in living_world.places[ui_place].yesterday:
                l = reason_line(living_world, r)
                if l != "": yesterday.push(l)
            res = notice_board(fonts, SETTLEMENTS[ui_place].name, job_notices(living_world, ui_place), yesterday)
            if res.take >= 0:
                # the notice goes in one's notebook; the poster knows nothing of it till told
                j = living_world.jobs[res.take]
                pin_notice(notebook, res.take, j.poster, "{job_cargo(res.take)} to {SETTLEMENTS[j.destination].name}".replace("the ", ""), "{living_world.people[j.poster].name} at {SETTLEMENTS[j.origin].name} wants it there by {clock_text(living_world, j.due_minute)}. {j.reward_cents / 100} lire.", clock_text(living_world, living_world.minute))
                say_toast("Copied into your notebook. Speak to {living_world.people[j.poster].name} about it.")
            if res.closed: ui = .none
        .trade:
            w = living_world
            m = w.places[ui_place].market
            c = w.people[w.player].craft
            rows: GoodRow[]
            goods: int[]
            loop g in 0..w.goods.len():
                if w.goods[g].illegal and ui_place != 5: continue
                pr = m.price_cents[g]
                have = if c >= 0: w.aircraft[c].cargo.qty[g] / 1000 else: 0
                rows.push(GoodRow(w.goods[g].key, "load", pr * 102 / 10000, pr * 98 / 10000, m.inventory.qty[g] / 1000, have))
                goods.push(g)
            used = 0
            if c >= 0:
                loop g in 0..w.goods.len(): used += w.aircraft[c].cargo.qty[g] / 1000
            res = ledger(fonts, w.people[folks[ui_folk].person].name, SETTLEMENTS[ui_place].name, rows, player_cents() / 100, used, 8)
            if res.row >= 0:
                ok = if res.dir > 0: living.buy(living_world, ui_place, goods[res.row], 1000, living_world.player, c) else: living.sell(living_world, ui_place, goods[res.row], 1000, living_world.player, c)
                if not ok: say_toast("No: not enough money, stock or room aboard, or your aircraft is not here")
            if res.closed: ui = .none
        _: pass
