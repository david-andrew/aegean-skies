use 'tools/judge_scene.jo'

enable_world_depth()
window("Aegean Skies", 1280, 720)
init_quality()
# The CPU rasterizer cannot sample its depth buffer through the GL texture API.
# Keep its existing opaque cloud path for CI/software use, as well as A/B runs.
legacy_clouds = (env("AEGEAN_LEGACY_CLOUDS") ?? "") == "1"
when TARGET != "wasm":
    if __soft: legacy_clouds = true
if not legacy_clouds: init_cloud_volumes()
init_terrain()
init_sky()
init_rain()
init_objects()
init_sea()
init_grass()
init_wake()
init_boat_scene()
init_shadow()
init_trails()
init_flight_effects()
init_birds()
init_curved_world()

# how many times faster than designed the aircraft truly fly (handling kept at the designed turn
# rates; the pause menu's Speed scale, AEGEAN_SPEED_SCALE): set before any aircraft or trip is made
BASE_SPEED_SCALE = 3.3              # (the pause menu's Speed, to start with)
set_speed_scale(to_float(env("AEGEAN_SPEED_SCALE") ?? "") ?? BASE_SPEED_SCALE)
lt.scale_airframes(speed_scale)

t0 = time()
if not load_land(embed("assets/terrain.bin")): panic("assets/terrain.bin mismatch/corruption: run sloppy --release tools/bake.jo")
build_terrain_from_source()
if (env("AEGEAN_WORLD") ?? "1") == "1":
    if not load_geography(embed("assets/world.bin")): panic("world.bin mismatch/corruption: run sloppy --release tools/bake_world.jo")
    geography_enabled = true
    init_world_terrain()
    if env("AEGEAN_WORLD_CHECK") != none: print("geography fingerprint {geography_fingerprint()}")
init_rivers()
init_canal()
depth_tex = build_depth_texture()
sea_mesh = build_sea_mesh()
# The legacy instances are allocated only when that path is selected.
puff_mesh: Mesh
puffs: InstanceBuffer[Puff]
if legacy_clouds:
    puff_mesh = build_puff_mesh()
    puffs = instance_buffer(build_puffs(7,render_quality.cloud_fields))
towns = [loop st in SETTLEMENTS: build_town(st)]
init_world_towns(towns)
living_validation.set_living_strict(false)
living_world = living.build_world(u64(0), harbors_from_towns(towns))
traffic_scene = living_scene.SceneAdapter()
tree_meshes = build_tree_meshes()
grove_far_meshes = build_tree_meshes(true)
groves: Grove[]
loop k in 0..ISLANDS.len(): groves += build_grove(k,towns)
chart = build_chart()
flocks = build_flocks(towns, 21)
bird_mesh = build_bird()
# Saved living trips and the trade/war adapter supply identities; no second fleet.
vessels = VesselFleet()
vessel_bindings = VesselBindings()
vessel_view = VesselView()
vessel_mooring = VesselMooring()
craft_models = build_craft_models()
if env("TOWNS_PRINT") != none:
    loop tw in towns: print("{tw.name}: {tw.center.x:.0} {tw.center.z:.0} out {tw.out.x:.2} {tw.out.y:.2} houses {tw.houses.len()}")
print("world built in {(time() - t0) * 1000.0:.0} ms")

# a font from the game's own files (they're known good: a bad one stops at once, saying so)
_font = (bytes: u8[]) -> Font:
    f = load_font(bytes)
    if f is FontError: panic("font: {f}")
    f

fonts = Fonts(_font(embed("assets/fonts/JosefinSans-SemiBold.ttf")), _font(embed("assets/fonts/Limelight-Regular.ttf")))

# ---------------- the player ----------------

enum Mode:
    walking
    aboard          # in the cockpit (the flight model comes here)
    descent         # falling, under a canopy, or swimming after leaving an aircraft
    free            # a free camera, for looking around

struct Player:
    mode: Mode = .walking
    pos: vec3
    yaw: f64 = 0.0                  # the way they face (world turn: faces (sin, cos))
    phase: f64 = 0.0                # the walk's swing
    stride: f64 = 0.0
    money = 120

# an aircraft at rest: moored at a dock, bobbing on the swell
struct Moored:
    kind: Craft
    model: int
    pos: vec3
    yaw: f64

home = towns[0]
along_quay = atan2(f64(home.out.x), -f64(home.out.y))        # (a flight heading: 0 north, east PI/2)
# the player's own aircraft, moored at the first dock; others moored at the rest
# AEGEAN_CRAFT uses the append-only Craft ID, independent of cached livery/model slots.
start_kind = Craft(clamp(to_int(env("AEGEAN_CRAFT") ?? "0") ?? 0, 0, CRAFT_NAMES.len() - 1))
start_model = default_craft_model(start_kind)
start_record = living_world.people[living_world.player].craft
living_world.aircraft[start_record].kind = lt.Airframe(int(start_kind))
living_world.aircraft[start_record].model_index = start_model
living_world.aircraft[start_record].livery_index = DEFAULT_LIVERIES[int(start_kind)]
pc = make_flyer(start_kind, start_model, craft_models[start_model].contacts, home.docks[0], along_quay)
pc.spec.player = true
moored: Moored[]
traffic = make_living_traffic(living_world, craft_models)
bind_living_player(pc, living_world, traffic_scene)

# ---------------- the people of the towns, the boards, talking and trading ----------------

cargo_scene.configure_cargo_scene(living_world,towns)
cargo_meshes = cargo_view.build_cargo_meshes()
folks: Folk[]
sync_folk(folks, living_world, towns)
life_meshes = life_view.build_life_meshes(living_world)
folk_sync_t = 0.0
enum Ui: none, talk, board, handling, trade, contract, maps
ui = Ui.none
ui_folk = -1
ui_place = -1
ui_line = ""
ui_news = 0
# (the conversation under way: the last thing they said, the replies it invites, whether they've
# had enough)
ui_turn = social.ConversationTurn(-1, -1, .greeting)

# what a turn says aloud: the words, then any question
turn_text = (turn: social.ConversationTurn) -> str: if turn.question != "": "{turn.text} {turn.question}" else: turn.text
ui_job = -1
ui_mission = -1                     # the military contract open at the office counter
# the war as the player meets and hears of it: battle cards shown, the chart's war layer
battle_card = BattleCard()
war_chart = WarChart()
war_layer_on = true
# what the player has met and turned down, kept with the living world when it is saved
# (battle cards shown, battles seen, contracts declined): the game passes this to save_world
presentation = lt.PresentationState()
packets_now: ContractMark[]           # where the packets of claimed contracts are to be collected or taken
ui_shop = ""                    # (the map seller whose counter is open)
toast = ""
paused = false
my_jobs: {int: lt.JobState} = {}       # the errands one carries, and how they stood last
toast_until = 0.0

# a harbor's notice board: two posts and a board with a little roof, on the waterfront
board_mesh = custom_mesh(():
    vs: Vertex3D[]
    wood = rgb(0.42, 0.3, 0.19)
    add_box(vs, vec3(-0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0.9, 0.9, 0), vec3(0.12, 1.8, 0.12), wood)
    add_box(vs, vec3(0, 1.45, 0), vec3(2.1, 1.1, 0.08), rgb(0.5, 0.36, 0.22))
    loop k in 0..5: add_box(vs, vec3(f32(-0.75 + f64(k) * 0.37), f32(1.45 + f64((k * 37) % 3) * 0.12 - 0.12), 0.06), vec3(0.28, 0.34, 0.02), rgb(0.95, 0.91, 0.8))
    add_gable(vs, vec3(0, 2.05, 0), 2.2, 0.5, 0.25, ROOFS[1], mat4())
    vs
())
board_spots: vec3[]
loop tw in towns:
    bp = tw.center - vec3(tw.out.x, 0, tw.out.y) * 4.0 + vec3(-tw.out.y, 0, tw.out.x) * 7.0
    board_spots.push(vec3(bp.x, f32(walk_height(towns, f64(bp.x), f64(bp.z))), bp.z))

# (AEGEAN_UI=board|talk|trade opens that panel at the home harbor at the start, for screenshots)
if let v = env("AEGEAN_UI"):
    living.advance_minutes(living_world, if v == "board": 180 else: 20)
    sync_folk(folks, living_world, towns)
    ui_place = 0
    if v == "board": ui = .board
    else:
        loop k in 0..folks.len():
            if folks[k].place == 0 and ui_folk < 0 and (v != "trade" or living_world.people[folks[k].person].occupation == .merchant): ui_folk = k
        # (talk: someone with work to offer, if anyone has)
        loop k in 0..folks.len():
            loop id in living_world.active_jobs:
                if v == "talk" and folks[k].place == 0 and living_world.jobs[id].delivery_mode == .aircraft and living_world.jobs[id].state == .open and living_world.jobs[id].poster == folks[k].person and living_world.jobs[id].origin == folks[k].place: ui_folk = k
        if ui_folk >= 0:
            ui = if v == "trade": Ui.trade else: Ui.talk
            ui_line = say(living_world, folks[ui_folk].person)

player_cents = () -> int:
    a = living_world.people[living_world.player].account
    if a >= 0: living_world.accounts[a].cents else: 0

say_toast = (s: str):
    global toast, toast_until
    toast = s
    toast_until = t + 5.0

# the town one is in (by the nearest waterfront within a few hundred meters), or -1
town_here = (p: vec3) -> int:
    best = -1
    bd = 450.0
    loop k in 0..towns.len():
        d = f64(length(vec2(towns[k].center.x - p.x, towns[k].center.z - p.z)))
        if d < bd:
            bd = d
            best = k
    best

near_board = () -> int:
    loop k in 0..board_spots.len():
        if length(board_spots[k] - me.pos) < 3.2: return k
    -1

# jobs the player carries for this place, delivered on arrival (paid then)
deliver_here = (place: int):
    loop id in living_world.active_jobs:
        j = living_world.jobs[id]
        if j.state != .claimed or j.carrier != living_world.player or j.destination != place or j.purpose != .passenger: continue
        before = player_cents()
        if living.deliver_job(living_world, id, living_world.player):
            say_toast("Delivered for {living_world.people[j.poster].name}: {(player_cents() - before) / 100} lire")
spray_ps = WorldParticles(gravity = vec3(0, -9.8, 0), drag = 1.5)
smoke_ps = WorldParticles(gravity = vec3(0, 1.5, 0), drag = 2.0)
vapor_trails = [Trail(), Trail()]
air_visual=make_air_view()
air_events=AirEvents()
air_meet_view=make_air_meet_view()
all_air_traffic=traffic
view_target=TargetView()
target_scan=0.0
wakes: WakeTrail[] = [loop k in 0..traffic.len() + 1: WakeTrail()]

# on the main quay, beside one's own aircraft
q0 = home.quays[0]
dk = vec2(home.docks[0].x, home.docks[0].z)
qd = q0.b - q0.a
along_q = clamp(dot(dk - q0.a, qd) / dot(qd, qd), 0.0, 1.0)
on_q = q0.a + qd * along_q
toward = normalize(dk - on_q)
sp = on_q + toward * (q0.width * 0.5 - 1.2)
start = vec3(sp.x, 0, sp.y)
me = Player(pos = vec3(start.x, f32(walk_height(towns, f64(start.x), f64(start.z))), start.z), yaw = atan2(f64(home.out.x), f64(home.out.y)))
me_fig = build_figure(.pilot, 7)
tuft = build_tuft()
capture_audio = env("AEGEAN_AUDIO_CAPTURE") != none and env("SLOPPY_SCREENSHOT") != none
audio_enabled = env("SLOPPY_NO_AUDIO") == none or capture_audio
captured_audio: f32[]
audio = if audio_enabled: start_audio(false) else: Audio()
life_sound = life_audio.build_life_audio()
world_ambience = AmbienceScene(sound=build_ambience(render_only=capture_audio))
if capture_audio: world_ambience.sound.playback=true
cockpit_radio = radio.Radio()
if audio_enabled: radio.radio_prepare(cockpit_radio)
radio_bulletin = broadcast.RadioBulletinCache()
broadcast.radio_place_transmitters(cockpit_radio, height)
hearing = if audio_enabled: make_hearing() else: Hearing()
battle = Battle(enabled=true,seed=int(living_world.seed%100000))
register_combat_body(battle,living_world,living_world.people[living_world.player].craft,pc.spec,pc.state,true)
combat_visual = make_combat_view()
combat_audio = if audio_enabled: start_combat_audio() else: CombatAudio()
battle_radio = BattleRadio()
cockpit_model = build_cockpit()

grass = GrassField(me.pos, instance_buffer([Instance3D(mat4(), vec4(1, 1, 1, 1))]), 0)

follow = follow_camera(distance = 5.5, pitch = 0.25, height = 1.6)
follow_frame = FollowFrame()
walker_point = world_point(me.pos)
walker_published = me.pos
sync_walker_point = ():
    global walker_point,walker_published,me
    if me.pos != walker_published:
        walker_point=world_point(me.pos)
        if me.mode==.walking:walker_point.y=walk_height(towns,walker_point.x,walker_point.z)
        me.pos=world_vec(walker_point);walker_published=me.pos
step_player_walk = (move: vec2):
    global walker_point,walker_published,me
    sync_walker_point()
    walker_point=walk_step_precise(towns,walker_point,move)
    me.pos=world_vec(walker_point);walker_published=me.pos
update_player_follow = (dt: f64,input: bool = true):
    global follow,follow_frame,actor_render_offsets
    sync_walker_point()
    update_local_follow(follow,follow_frame,walker_point,dt,input=input)
    actor_render_offsets[living_world.player]=world_residual(walker_point)

descent_camera = DescentCamera()
follow.yaw = me.yaw + PI
free = fly_camera(vec3(2600, 380, 2600), 0.8, -0.18)
free.speed = 120.0
hour = to_float(env("AEGEAN_HOUR") ?? "9.5") ?? 9.5
t = 0.0
show_chart = env("AEGEAN_CHART") != none
# (captures and the pause menu: every edition on the counters handed over at once)
if env("AEGEAN_MAPS") == "all": _ = living.grant_every_map(living_world,living_world.player)
if let focus = env("AEGEAN_CHART_FOCUS"):
    loop c in living.owned_maps(living_world,living_world.player):
        if c.edition == focus: chart_focus = c.id

if let v = env("AEGEAN_VIEW"):
    w = split(v, " ")
    if w.len() >= 6:
        free.pos = vec3(f32(to_float(w[0]) ?? 0.0), f32(to_float(w[1]) ?? 0.0), f32(to_float(w[2]) ?? 0.0))
        free.yaw = to_float(w[3]) ?? 0.0
        free.pitch = to_float(w[4]) ?? 0.0
        hour = to_float(w[5]) ?? 15.0
        me.mode = .free
if let v = env("AEGEAN_AT"):
    w = split(v, " ")
    x = to_float(w[0]) ?? 0.0
    z = to_float(w[1]) ?? 0.0
    me.pos = vec3(f32(x), f32(walk_height(towns, x, z)), f32(z))
    follow.yaw = to_float(w[2]) ?? 0.0
if env("AEGEAN_ABOARD") != none: me.mode = .aboard
if let name = env("AEGEAN_WEATHER"):
    anchor = if me.mode == .free: free.pos else: me.pos
    if let v = env("AEGEAN_WEATHER_CENTER"):
        fields = split(v," ")
        if fields.len() >= 2: anchor = vec3(f32(to_float(fields[0]) ?? 0.0),0,f32(to_float(fields[1]) ?? 0.0))
    weather_fixture(living_world,name,anchor)
weather_scene_step(living_world,if me.mode == .free: free.pos else: me.pos,hour,0.0)
trace = env("AEGEAN_TRACE") != none
# AEGEAN_NEAR_BOOST=x sets how much faster the near sea and ground stream past (the pause menu's)
if let nb = env("AEGEAN_NEAR_BOOST"): set_near_boost(to_float(nb) ?? 3.0)
# AEGEAN_SPEED_MODE=0..3 picks the trick for the feel of speed (off, detail, sea, stretch)
if let sm = env("AEGEAN_SPEED_MODE"): set_speed_mode(to_int(sm) ?? 1)
# AEGEAN_FLYING="altitude speed" starts in the air off the home harbor, heading out to sea
if let v = env("AEGEAN_FLYING"):
    w = split(v, " ")
    alt = to_float(w[0]) ?? 60.0
    spd = to_float(w[1]) ?? 55.0
    h = along_quay
    p0 = home.docks[0] + vec3(home.out.x, 0, home.out.y) * 500.0
    pc.state = CraftState(position = vec3(p0.x, f32(alt), p0.z), velocity = heading_vector(h) * f32(spd), orientation = quat_euler(0, -h, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, throttle = 0.85)
    pc.throttle = 0.85
    pc.aim_heading = h
    me.mode = .aboard
if let v = env("AEGEAN_WIND"):
    w = split(v, " ")
    wind_now.speed = to_float(w[0]) ?? 6.0

# Reproducible river fixture; ordinary flight controls and the owned player craft.
if env("AEGEAN_RIVER") != none or env("AEGEAN_CANAL")!=none:
    a=RIVER_NODES[85];b=RIVER_NODES[86]
    if env("AEGEAN_CANAL")!=none:a=RIVER_NODES[CANAL_BEGIN+22];b=RIVER_NODES[CANAL_BEGIN+23]
    h=atan2(f64(b.x-a.x),-f64(b.y-a.y))
    pc.state=water_start(pc.spec,vec3(a.x,a.z,a.y),h)
    pc.throttle=0.0;pc.aim_heading=h;pc.placed=false
    me.mode=.aboard

# ---------------- townsfolk wandering (until the world's people walk here themselves) ----------------

struct Walker:
    fig: Figure
    town: int
    pos: vec3
    target: vec3
    yaw: f64
    phase: f64
    wait: f64
    speed: f64

walkers: Walker[]
seed_random(5)
loop ti in 0..towns.len():
    tw = towns[ti]
    if tw.houses.len() < 3: continue
    n = min(6, 1 + tw.houses.len() / 12)
    loop k in 0..n:
        hp = tw.houses[random_int(0, tw.houses.len() - 1)]
        dress: Dress = [Dress.fisher, .merchant, .dress, .widow, .worker, .fisher, .police][k % 7]
        p = vec3(hp.x, f32(walk_height(towns, f64(hp.x), f64(hp.z))), hp.z)
        walkers.push(Walker(build_figure(dress, ti * 100 + k), ti, p, p, random(0.0, TAU), 0.0, random(0.0, 5.0), random(1.0, 1.5)))

initial_walkers=walkers

_pick_target = (w: Walker) -> vec3:
    tw = towns[w.town]
    if random() < 0.4 and tw.quays.len() > 0:
        q = tw.quays[random_int(0, tw.quays.len() - 1)]
        p = q.a + (q.b - q.a) * f32(random(0.15, 0.95))
        return vec3(p.x, 0, p.y)
    hp = tw.houses[random_int(0, tw.houses.len() - 1)]
    vec3(hp.x + f32(random(-6.0, 6.0)), 0, hp.z + f32(random(-6.0, 6.0)))

update_walkers = (dt: f64):
    loop mut w in walkers:
        if length(w.pos - me.pos) > 900.0: continue
        if w.wait > 0.0:
            w.wait -= dt
            if w.wait <= 0.0: w.target = _pick_target(w)
            continue
        d = vec2(w.target.x - w.pos.x, w.target.z - w.pos.z)
        l = f64(length(d))
        if l < 1.0:
            w.wait = random(2.0, 12.0)
            continue
        dir = d / f32(l)
        w.yaw = approach_angle(w.yaw, atan2(f64(dir.x), f64(dir.y)), 6.0, dt)
        np = walk_step(towns, w.pos, vec2(f32(sin(w.yaw)), f32(cos(w.yaw))) * f32(w.speed * dt))
        if np == w.pos:
            w.wait = random(0.5, 3.0)            # stuck: pause, then go somewhere else
        w.pos = np
        w.phase += dt * w.speed * 5.5

# ---------------- update ----------------

# by one's own aircraft, at rest on the water or moored
# the wind as a velocity (for cloth)
wind_now_vec = () -> vec3: vec3(wind_now.dir.x, 0, wind_now.dir.y) * f32(wind_now.speed)

near_own_craft = () -> bool:
    d = f64(length(vec2(pc.state.position.x - me.pos.x, pc.state.position.z - me.pos.z)))
    d < 8.5 and (pc.state.moored or length(pc.state.velocity) < 1.0)

rope: Rope
was_moored = false
talk_at_start = env("AEGEAN_TALK") != none
radio_card_until = -1.0             # (while the radio's card shows, after tuning)

# what the radio is on, for its card: the station near the dial, or the band between them
radio_label = () -> str:
    if cockpit_radio.muted: return "Radio off"
    loop st in cockpit_radio.stations:
        if abs(st.khz - cockpit_radio.khz) < 8.0: return "{st.name}   {int(cockpit_radio.khz)} kc"
    "{int(cockpit_radio.khz)} kc   static"
pad_talk = false                    # (a tap on someone near: talk to them)

# where on the ground (or the quay) a point on the screen falls, near the walker's height
ground_under = (p: vec2) -> vec3?:
    o, d = screen_ray(p)
    if f64(d.y) > -0.02: return none
    t = (f64(me.pos.y) - f64(o.y)) / f64(d.y)
    if t < 0.0 or t > 400.0: return none
    o + d * f32(t)
click_took_mouse = false            # (the left button's press that took the mouse, until let go)

# Cargo is saved living-world stock; the notebook only projects its current handling status.
notebook = load_notebook()

# who at a job's destination is waiting for it: whoever it is for, if they live there, else the
# harbor's merchant
recipient_of = (id: int) -> int:
    j = living_world.jobs[id]
    b = j.cause.beneficiary
    if b >= 0 and b < living_world.people.len() and living_world.people[b].home == j.destination: return b
    living_world.places[j.destination].market_owner

# what a job carries, in a few words
job_cargo = (id: int) -> str:
    j = living_world.jobs[id]
    if j.purpose == .passenger: return living_world.people[j.passenger].name
    if j.cargo_mode == .sealed: return "the sealed bag"
    "the {living_world.goods[j.good].key}"

holding_cargo = () -> int: living_world.people[living_world.player].carrying

near_job_cargo = () -> int: cargo_view.nearest_cargo(living_world,living_world.player)

# The chart shows only what one's own paper maps cover: one sheet per edition owned.
owned_chart_sheets = () -> ChartSheet[]:
    sheets: ChartSheet[]
    seen: {str: bool}
    loop c in living.owned_maps(living_world,living_world.player):
        if seen.get(c.edition,false): continue
        seen[c.edition] = true
        if let m = living.map_description(living_world,c.edition):
            sheets.push(ChartSheet(c.id,m.id,m.title,m.bounds.west,m.bounds.north,m.bounds.east,m.bounds.south))
    sheets

# a loose map lying within reach (-1: none)
near_map_find = () -> int:
    finds = living.nearby_map_finds(living_world,living_world.player)
    if finds.len() > 0: finds[0].id else: -1

map_title = (copy: int) -> str:
    if copy in living_world.maps.copies:
        if let m = living.map_description(living_world,living_world.maps.copies[copy].edition): return m.title
    "a map"

# Each map that comes into one's hands is named once, on a card.
known_maps: {int: bool}
loop c in living.owned_maps(living_world,living_world.player): known_maps[c.id] = true
map_card = ""
map_card_until = 0.0
notice_new_maps = ():
    global map_card, map_card_until
    fresh: int[]
    loop c in living.owned_maps(living_world,living_world.player):
        if known_maps.get(c.id,false): continue
        known_maps[c.id] = true
        fresh.push(c.id)
    if fresh.len() == 0: return
    map_card = (if fresh.len() == 1: "New map: {map_title(fresh[0])}" else: "{fresh.len()} new maps") + "      M  the chart"
    map_card_until = t + 6.0

# The same published handling terms can be agreed at the board or with the sender.
agree_cargo_job = (id: int, choice: lt.CarriageChoice) -> str:
    j = living_world.jobs[id]
    if j.delivery_mode == .aircraft and not pc.state.moored: return "Bring your aircraft alongside a quay here first."
    if not living.take_job(living_world,id,living_world.player,choice): return "The job is unavailable, the hold is reserved, or the journey cannot be made in time."
    my_jobs[id] = lt.JobState.claimed
    rcv = living_world.people[recipient_of(id)].name
    status = portage.cargo_status(living_world,id)
    pin_notice(notebook,id,j.poster,"{job_cargo(id)} to {rcv}","By {clock_text(living_world,j.due_minute)}; {f64(living_world.jobs[id].reward_cents)/100.0:.2} lire. From {living_world.people[j.poster].name}.",clock_text(living_world,living_world.minute))
    log_note(notebook,"Agreed to {if j.delivery_mode == .foot: "carry" else: "fly"} {job_cargo(id)} for {rcv}. {status}",clock_text(living_world,living_world.minute))
    status

# F has one meaning per press: pick up, set down/load, or (with empty hands) board.
cargo_interact = () -> bool:
    actor = living_world.player
    held = holding_cargo()
    if held >= 0:
        c = living_world.cargo[held]
        aboard = false
        if c.job >= 0 and c.job in living_world.jobs:
            j = living_world.jobs[c.job]
            point = portage.cargo_loading_spot(living_world,living_world.people[actor].craft)
            aboard = j.delivery_mode == .aircraft and not j.loaded and point != none and length(me.pos-point!) < 4
        if c.job < 0:
            point = portage.cargo_loading_spot(living_world,living_world.people[actor].craft)
            aboard = point != none and length(me.pos-point!) < 4 and c.store != .aircraft
        if portage.cargo_put_down(living_world,actor,aboard):
            if c.job >= 0:
                if aboard: claims.load_job(living_world,c.job)
                if living_world.jobs[c.job].collected: living.deliver_job(living_world,c.job,actor)
            say_toast(if aboard: "Put {cargo_view.cargo_label(living_world,c)} into the hold" else: "Set down {cargo_view.cargo_label(living_world,c)}")
            log_note(notebook,if aboard: "Loaded {cargo_view.cargo_label(living_world,c)} into the aircraft." else: "Set down {cargo_view.cargo_label(living_world,c)} at {me.pos.x:.0}, {me.pos.z:.0}.",clock_text(living_world,living_world.minute))
        return true
    id = near_job_cargo()
    if id >= 0:
        if portage.cargo_pick_up(living_world,actor,id): say_toast("Carrying {cargo_view.cargo_label(living_world,living_world.cargo[living_world.people[actor].carrying])}; F to put it down")
        else: say_toast("It cannot be picked up now: it is too heavy or someone is handling it")
        return true
    false

# guns, cloth, debugging
guns = Guns()
splashes: Splash[]
dust_ps = WorldParticles(gravity = vec3(0, -9.8, 0), drag = 1.2)
cloth_mesh: ClothMesh
scarf_mesh: ClothMesh
dbg = Debug()
if env("SLOPPY_NO_AUDIO") == none: music_audition_prepare(dbg.music)
# (the chaotic stalls and spins remain an opt-in trial.)
set_tweaks(dbg.tweaks)
dbg.opts = options
# AEGEAN_TWEAKS="pure,curve,grip,airframe,cloth,trim,orbit" switches trials on from the start
if let tw = env("AEGEAN_TWEAKS"):
    loop name in split(tw, ","):
        match name:
            "pure": dbg.tweaks.pure_scale = true
            "curve": dbg.tweaks.true_curve = true
            "grip": dbg.tweaks.quick_grip = true
            "airframe": dbg.tweaks.airframe_true = true
            "cloth": dbg.tweaks.cloth_true = true
            "trim": dbg.tweaks.auto_trim = true
            "stalls": dbg.tweaks.chaotic_stalls = true
            "energy": dbg.tweaks.skybarons_response = true
            "orbit": dbg.tweaks.orbit_camera = true
            _: pass
    set_tweaks(dbg.tweaks)
wind_bias = 0.0
set_touch_pad(touch_device() or env("AEGEAN_TOUCH") != none)
last_shots = 0
# (going into the water hard: how far under the aircraft is driven, and how fast, on a spring that
# brings it back up; drawn, not simulated)
plunge = 0.0
plunge_v = 0.0
MUZZLES: vec3[] = [vec3(-2.7, 1.7, -1.3), vec3(2.7, 1.7, -1.3)]

# a new aircraft of another kind for the player, where the old one is (moored where it was moored)
change_craft = (kind: Craft, model: int):
    global pc
    record = living_world.people[living_world.player].craft
    a = lt.AIRFRAMES[int(kind)]
    if craft_grams(living_world,record) > a.cargo_grams or living_world.aircraft[record].passengers.len() > a.seats:
        say_toast("Unload cargo and passengers before changing to this aircraft")
        return
    old = pc.state
    nf = make_flyer(kind, model, craft_models[model].contacts, old.position - vec3(0, f32(pc.spec.float_height), 0), heading(old))
    if not old.moored:
        unmoor(nf.state)
        nf.state.position = old.position
        nf.state.velocity = old.velocity
        nf.state.orientation = old.orientation
        nf.state.on_water = old.on_water
        nf.state.water_age = old.water_age
        nf.throttle = pc.throttle
    # (the camera stays where it was: the new aircraft takes over the old one's)
    nf.cam_pos = pc.cam_pos; nf.look = pc.look; nf.look_v = pc.look_v; nf.cam_up = pc.cam_up; nf.roll = pc.roll
    nf.path = pc.path; nf.cam_e = pc.cam_e; nf.cam_ev = pc.cam_ev; nf.cam_lh = pc.cam_lh; nf.fov = pc.fov
    nf.prev_vel = pc.prev_vel; nf.acc_lp = pc.acc_lp; nf.prev_dir = pc.prev_dir
    nf.placed = pc.placed
    nf.spec.player = true
    nf.spec.fuel_capacity = f64(a.tank_ml)/1000.0
    nf.spec.fuel_burn = f64(a.burn_ml_sec)/1000.0
    nf.state.fuel = min(old.fuel,nf.spec.fuel_capacity)
    living_world.aircraft[record].kind = lt.Airframe(int(kind))
    living_world.aircraft[record].model_index = model
    living_world.aircraft[record].livery_index = DEFAULT_LIVERIES[int(kind)]
    # (the tank's change goes through the debugging ledger, so the world's goods still balance)
    debug_fuel_ml(record, int(nf.state.fuel*1000.0))
    living_world.aircraft[record].scene_extension = ""
    living_world.aircraft[record].scene_extension_tick = -1
    living_world.aircraft[record].revision += 1
    pc = nf
    ci=combat_index(battle,record)
    if ci>=0:battle.actors[ci]=Combatant(record,living_world.player,0,nf.spec,nf.state,external=true,human=true,previous=nf.state.position,model=model)

# paused (or not): the pause menu is the debugging panel
set_paused = (on: bool):
    global paused, show_chart
    paused = on
    dbg.open = on
    if dbg.picking: show_chart = false
    dbg.picking = false
    if on: mouse_lock(false)

# the speed scale changed: every aircraft's spec made again for it (keeping its fuel figures), and
# the world's trips and traffic paced to it
apply_speed_scale = (k: f64):
    set_speed_scale(k)
    lt.scale_airframes(k)
    old = pc.spec
    pc.spec = craft_spec(pc.kind, craft_models[pc.model].contacts)
    pc.spec.player = true
    pc.spec.fuel_capacity = old.fuel_capacity
    pc.spec.fuel_burn = old.fuel_burn
    loop i in 0..traffic.len():
        o = traffic[i].spec
        traffic[i].spec = craft_spec(traffic[i].kind, craft_models[traffic[i].model].contacts)
        traffic[i].spec.fuel_capacity = o.fuel_capacity
        traffic[i].spec.fuel_burn = o.fuel_burn

# the debugging panel: how things are now, for it to show and change
debug_view = () -> DebugView:
    v = DebugView()
    v.craft = int(pc.kind)                # (the type, as the menu lists them; the model index differs past the first four)
    v.fuel = pc.state.fuel / max(pc.spec.fuel_capacity, 0.001)
    v.parts = [loop k in 0..pc.spec.parts.len(): part_health(pc.state.damage, pc.spec.parts[k].id)]
    c = living_world.people[living_world.player].craft
    if c >= 0:
        v.hull_wear = 1.0 - f64(living_world.aircraft[c].hull) / 1000.0
        v.engine_wear = 1.0 - f64(living_world.aircraft[c].engine) / 1000.0
    v.hour = hour
    v.wind = wind_bias
    v.wind_now = wind_now.speed
    v.lire = player_cents() / 100
    v.speed_scale = speed_scale
    v.lift_scale = lift_scale
    v.bullet_scale = bullet_scale
    v.sea_rough = sea_rough
    v

# the debugging panel's fuel and money, entered in the living world's books (fuel made or spent,
# money brought in from or sent out of the world) so its conservation checks still hold
debug_fuel_ml = (c: int, ml: int):
    if c < 0: return
    cap = lt.AIRFRAMES[int(living_world.aircraft[c].kind)].tank_ml
    want = clamp(ml, 0, cap)
    d = want - living_world.aircraft[c].fuel_ml
    if d > 0: living_world.goods_ledger.created[int(lt.GoodKind.fuel)] += d
    else: living_world.goods_ledger.consumed[int(lt.GoodKind.fuel)] += -d
    living_world.aircraft[c].fuel_ml = want
    living_world.aircraft[c].revision += 1

debug_cents = (cents: int):
    a = living_world.people[living_world.player].account
    if a < 0: return
    want = max(0, cents)
    d = want - living_world.accounts[a].cents
    if d > 0: living_world.ledger.external_in_cents += d
    else: living_world.ledger.external_out_cents += -d
    living_world.accounts[a].cents = want

# put the aircraft in the air (or on the water, at 0 m) at x, z
debug_place = (x: f64, z: f64, alt: f64):
    h = heading(pc.state)
    unmoor(pc.state)
    if alt < 5.0:
        if surface_height(x, z) > 0.0:
            say_toast("That's land there: give it some altitude")
            return
        pc.state = water_start(pc.spec, vec3(f32(x), 0, f32(z)), h)
        pc.throttle = 0.0
    else:
        ground = max(surface_height(x, z), 0.0)
        pc.state.position = vec3(f32(x), f32(max(alt, ground + 40.0)), f32(z))
        pc.state.velocity = heading_vector(h) * f32(pc.spec.cruise_speed)
        pc.state.orientation = quat_euler(0, -h, 0)
        pc.state.angular_velocity = vec3(0, 0, 0)
        pc.state.on_water = false
        pc.state.water_age = 1.0
        pc.state.crashed = false
        pc.throttle = 0.8
    pc.aim_heading = h
    pc.aim_climb = 0.0
    pc.placed = false
    me.mode = .aboard

# Apply one complete replacement only after its builder succeeded. GPU assets/options survive;
# no old world identity, physics history, sound scheduler, UI reference or camera spring does.
active_scenario = ""
scenario_templates: {str: ScenarioState}
load_scenario = (key: str) -> bool:
    global living_world,pc,me,battle,traffic,traffic_scene,folks,folk_sync_t,air_events,all_air_traffic,view_target,target_scan
    global vessels,vessel_bindings,vessel_view,vessel_mooring,combat_visual,air_visual
    global ui,ui_folk,ui_place,ui_line,ui_news,ui_turn,ui_job,my_jobs,toast,toast_until,notebook,battle_card,war_chart,presentation,ui_mission
    global t,hour,wind_bias,wind_now,follow,descent_camera,free,show_chart,chart_local
    global rope,was_moored,wakes,vapor_trails,guns,splashes,last_shots,plunge,plunge_v
    global world_ambience,cockpit_radio,radio_bulletin,radio_card_until,talk_at_start,pad_talk,click_took_mouse
    global active_scenario,judge_camera,scenario_templates,walkers,judge_ready,dbg
    load_started=time()
    fresh=key=="start"
    if fresh:
        music_audition_stop(dbg.music)
        dbg=Debug(opts=dbg.opts)
        if env("SLOPPY_NO_AUDIO") == none: music_audition_prepare(dbg.music)
        apply_speed_scale(BASE_SPEED_SCALE);set_lift_scale(3.3);set_bullet_scale(5.0)
        set_sea_rough(1.0);set_drag_scale(1.0);set_tweaks(dbg.tweaks)
        set_near_boost(3.0);set_speed_mode(0);set_camera_rises(false)
    # A situation chooses the world and aircraft, never the user's flight calibration.
    # Cached specs depend on the selected speed scale, just like a normal aircraft change.
    side_size=clamp(to_int(env("AEGEAN_BATTLE_SIDE") ?? "8") ?? 8,2,64)
    cache_key=key+":"+to_text(speed_scale)+":"+to_text(side_size)
    if fresh or not (cache_key in scenario_templates):
        loaded=build_scenario(key,towns,craft_models,side_size)
        if loaded==none:return false
        scenario_templates[cache_key]=loaded!
    next=scenario_templates[cache_key]
    seed_random(if fresh:5 else:1934);walkers=initial_walkers
    hush_audio(audio);hush_combat_audio(combat_audio);hush_battle_radio(battle_radio)
    audio.clock=0;audio.clock_cloth=0;audio.settled_at=0;audio.settled_load=1;audio.quiet=0.5;audio.next_gull=4;audio.flap_next=0;audio.flap_energy=1
    loop heard in hearing.heard:
        loop voice in [heard.near_v,heard.far_v,heard.near_r,heard.far_r]:
            if voice>=0:stop(voice)
    hearing.heard=[]
    life_audio.hush_life_audio(life_sound);life_sound.last_beat=-1
    ambience_hush(world_ambience.sound)
    saved_sound=world_ambience.sound
    saved_sound.pending=[];saved_sound.sources=[];saved_sound.last_time=-1;saved_sound.refresh=0
    world_ambience=AmbienceScene(sound=saved_sound)
    radio.radio_silence(cockpit_radio);cockpit_radio=radio.Radio()
    broadcast.radio_place_transmitters(cockpit_radio,height)
    radio_bulletin=broadcast.RadioBulletinCache();radio_card_until=-1
    living_world=next.world;pc=next.flyer;battle=next.battle
    traffic_scene=living_scene.SceneAdapter()
    traffic=make_living_traffic(living_world,craft_models)
    bind_living_player(pc,living_world,traffic_scene)
    me=Player(mode=if next.mode==.aboard:Mode.aboard else:if next.mode==.free:Mode.free else:Mode.walking,pos=next.position,yaw=next.yaw)
    folks=[];sync_folk(folks,living_world,towns);folk_sync_t=0
    air_events=AirEvents();all_air_traffic=traffic;view_target=TargetView();target_scan=0
    vessels=next.vessels;vessel_bindings=VesselBindings();vessel_view=VesselView();vessel_mooring=VesselMooring()
    cv=combat_visual
    combat_visual=CombatView(low=cv.low,low_parts=cv.low_parts,chute=cv.chute,hole=cv.hole,oil=cv.oil,pilot=cv.pilot,distant_pilot=cv.distant_pilot,
        trails=BattleTrails(mesh=cv.trails.mesh,shader=cv.trails.shader))
    av=air_visual
    air_visual=AirView(silhouette=av.silhouette,exhaust=BattleTrails(mesh=av.exhaust.mesh,shader=av.exhaust.shader))
    spray_ps.items.clear();smoke_ps.items.clear();dust_ps.items.clear()
    wakes=[loop k in 0..traffic.len()+1:WakeTrail()];vapor_trails=[Trail(),Trail()]
    guns=Guns();splashes=[];last_shots=0;plunge=0;plunge_v=0
    rope=Rope();was_moored=false
    ui=.none;ui_folk=-1;ui_place=-1;ui_line="";ui_news=0;ui_turn=lt.ConversationTurn();ui_job=-1;my_jobs={}
    notebook=if fresh:Notebook() else:Notebook(storage_key="scenario-notebook:"+key)
    if fresh:save_notebook(notebook)
    toast="";toast_until=0;show_chart=false;chart_local=false
    battle_card=BattleCard();war_chart=WarChart();presentation=lt.PresentationState();ui_mission= -1
    talk_at_start=false;pad_talk=false;click_took_mouse=true
    t=0;hour=next.hour;wind_bias=0;wind_now=Wind()
    follow=follow_camera(distance=5.5,pitch=next.camera_pitch,height=1.6);follow.yaw=next.camera_yaw
    descent_camera=DescentCamera();free=fly_camera(next.position,next.camera_yaw,next.camera_pitch)
    # A battle replaces its weather, not the user's weapon/debug choices. Fresh-start
    # already rebuilt Debug above, including those defaults and their handling globals.
    dbg.weather_choice=-1
    weather_scene_step(living_world,next.position,hour,0)
    chase(pc,1.0/60.0)
    update_player_follow(1.0/60.0,input=false)
    active_scenario=(if fresh:"" else:key);judge_camera=none
    if audio_enabled and active_scenario=="strait":prepare_battle_radio(battle_radio)
    if fresh:judge_ready=false
    set_paused(false)
    if me.mode==.aboard:
        mouse_lock(true)
        pc.mouse_mode=true
    if env("AEGEAN_SCENARIO_TIMING")!=none:print("SCENARIO_LOAD_MS {(time()-load_started)*1000.0:.3}")
    if env("AEGEAN_CAPTURE_TRACE")!=none:print("SCENARIO_STATE {living.canonical_hash(living_world)} {hash(to_text(battle))} {hour} {pc.throttle}")
    if env("AEGEAN_RUNTIME_TRACE")!=none:print("SCENARIO_FEEL player={pc.spec.player} scale={pc.spec.handling_scale} pure={dbg.tweaks.pure_scale} grip={dbg.tweaks.quick_grip} trial={dbg.tweaks.chaotic_stalls} external={battle.actors[combat_index(battle,living_world.people[living_world.player].craft)].external}")
    print("SCENARIO {key}: {battle.actors.len()} aircraft, player {pc.state.position}, weather {living_world.weather.len()}")
    true

# what the debugging panel changed or asked for
debug_apply = (was: DebugView, v: DebugView, r: DebugResult):
    if r.scenario!="":load_scenario(r.scenario);return
    weather_anchor = if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos
    if r.weather >= 0: weather_choose(living_world,r.weather,weather_anchor)
    global hour, wind_bias
    c = living_world.people[living_world.player].craft
    if v.craft != was.craft:
        kind = Craft(clamp(v.craft, 0, CRAFT_NAMES.len() - 1))
        change_craft(kind, default_craft_model(kind))
        return
    if abs(v.fuel - was.fuel) > 0.0001:
        pc.state.fuel = v.fuel * pc.spec.fuel_capacity
        debug_fuel_ml(c, int(pc.state.fuel * 1000.0))
    st = pc.state
    loop k in 0..min(v.parts.len(), was.parts.len()):
        if abs(v.parts[k] - was.parts[k]) < 0.0001: continue
        id = pc.spec.parts[k].id
        i = int(id)
        if v.parts[k] <= 0.0:
            detach_part(pc.state.damage, pc.spec.parts, id, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        else:
            if not pc.state.damage.parts[i].attached:
                # (put back: its wreckage gone from the water)
                pc.state.damage.parts[i].attached = true
                pc.state.damage.debris = [loop db in pc.state.damage.debris if db.part != id: db]
            pc.state.damage.parts[i].health = v.parts[k]
    if c >= 0:
        if abs(v.hull_wear - was.hull_wear) > 0.0001: living_world.aircraft[c].hull = int((1.0 - v.hull_wear) * 1000.0 + 0.5)
        if abs(v.engine_wear - was.engine_wear) > 0.0001: living_world.aircraft[c].engine = int((1.0 - v.engine_wear) * 1000.0 + 0.5)
    if abs(v.hour - was.hour) > 0.0001: hour = v.hour % 24.0
    if r.weather >= 0 or abs(v.hour-was.hour) > 0.0001:
        # Preview the chosen weather/light while paused without advancing time.
        weather_scene_step(living_world,weather_anchor,hour,0.0)
    wind_bias = v.wind
    if abs(v.speed_scale - was.speed_scale) > 0.0001: apply_speed_scale(max(1.0, v.speed_scale))
    if abs(v.lift_scale - was.lift_scale) > 0.0001: set_lift_scale(v.lift_scale)
    if abs(v.bullet_scale - was.bullet_scale) > 0.0001: set_bullet_scale(v.bullet_scale)
    if abs(v.sea_rough - was.sea_rough) > 0.0001: set_sea_rough(v.sea_rough)
    match r.act:
        .repair:
            pc.state.damage = DamageState()
            pc.state.crashed = false
            pc.state.capsized = false
            pc.state.hull_damage = 0.0
            pc.state.engine_damage = 0.0
            if c >= 0:
                living_world.aircraft[c].hull = 1000
                living_world.aircraft[c].engine = 1000
        .wreck: detach_part(pc.state.damage, pc.spec.parts, .body, pc.spec.mass, st.position, st.orientation, st.velocity, st.angular_velocity)
        .money_add: debug_cents(player_cents() + 100000)
        .maps_all: _ = living.grant_every_map(living_world,living_world.player)
        .money_set: debug_cents(r.lire * 100)
        .to_altitude:
            p0 = if me.mode == .aboard: pc.state.position else: me.pos
            debug_place(f64(p0.x), f64(p0.z), dbg.altitude)
            set_paused(false)
        .pick:
            global show_chart
            dbg.picking = true
            dbg.open = false
            show_chart = true
        .to_town:
            tw = towns[r.town]
            dock = free_dock(tw, others_at(), tw.center) ?? tw.docks[0]
            h = atan2(f64(tw.out.x), -f64(tw.out.y))
            pc.state = water_start(pc.spec, dock, h)
            moor(pc.state, pc.state.position, h)
            pc.throttle = 0.0
            pc.placed = false
            tie_up()
            if me.mode != .aboard: step_ashore(dock)
            set_paused(false)
        _: pass

    # An explicit debug repair/part edit changes the authoritative physical body too.
    ci=combat_index(battle,c)
    if ci>=0:
        battle.actors[ci].state=pc.state
        if r.act==.repair:
            battle.actors[ci].fire=0;battle.actors[ci].fire_age=0
            battle.actors[ci].marks.clear();battle.actors[ci].last_attacker=-1
            battle.actors[ci].down_reported=false
            if not battle.actors[ci].bailed:battle.actors[ci].status=.flying

# (each kind's engine its own pitch, the bigger lower; each aircraft a touch its own)
engine_tone = (kind: Craft, craft: int) -> f64:
    base = aircraft_profile(kind).tone
    base * (1.0 + 0.03 * f64((craft * 37) % 7 - 3) / 3.0)

# the other aircraft's places (for keeping docks free)
# where every other aircraft is or is bound: those flying about, every one the world has tied up
# anywhere (drawn or not), and the docks claimed by those on their way in
others_at = () -> vec3[]:
    out = [loop tr in traffic: tr.state.position]
    mine = living_world.people[living_world.player].craft
    loop c in 0..living_world.aircraft.len():
        if c != mine: out.push(living_world.aircraft[c].pose.pos)
    loop id in living_world.active_trips:
        tp = living_world.trips[id]
        if tp.craft != mine and tp.claimed_dock >= 0: out.push(living_world.harbors[tp.destination].docks[tp.claimed_dock])
    out

# tie up at the bollard nearest the aircraft
tie_up = ():
    global was_moored
    if let b = nearest_bollard(towns, pc.state.position):
        rope.anchor = b
        rope.tied = true
        rope.loose = b
        was_moored = true

# where the player's aircraft is tied: the bollard its line is on (none: not moored)
mooring_anchor = () -> vec3?:
    if pc.state.moored and rope.tied: return rope.anchor
    if not pc.state.moored: return none
    p = vec2(pc.state.position.x, pc.state.position.z)
    best: vec3? = none
    bd = 40.0
    loop tw in towns:
        if length(vec2(tw.center.x, tw.center.z) - p) > 600.0: continue
        loop q in tw.quays:
            d = q.b - q.a
            u = clamp(dot(p - q.a, d) / dot(d, d), 0.0, 1.0)
            c = q.a + d * u
            off = p - c
            l = f64(length(off))
            if l < bd and l > 0.01:
                bd = l
                e = c + off / f32(l) * (q.width * 0.5 - 0.4)
                best = vec3(e.x, f32(QUAY_TOP + 0.5), e.y)
    best

# haul the line in a little: the aircraft comes alongside (to a few meters off the quay's edge)
haul_in = (dt: f64):
    if let a = mooring_anchor():
        p = pc.state.position
        off = vec3(p.x - a.x, 0, p.z - a.z)
        l = f64(length(off))
        if l > 3.6:
            step = min(1.4 * dt, l - 3.6)
            np = p - off / f32(l) * f32(step)
            pc.state.position = np
            pc.state.mooring_point = np

# off the aircraft onto the quay beside a dock (or the nearest walkable ground)
step_ashore = (near: vec3):
    best = me.pos
    found = false
    loop r in [5.0, 8.0, 12.0, 18.0]:
        loop k in 0..16:
            a = f64(k) / 16.0 * TAU
            c = near + vec3(f32(cos(a) * r), 0, f32(sin(a) * r))
            h = walk_height(towns, f64(c.x), f64(c.z))
            if h > 0.5 and not found:
                best = vec3(c.x, f32(h), c.z)
                found = true
    if found:
        me.pos = best
        me.mode = .walking
        follow.placed = false

# Deterministic judging hooks. No effect in ordinary play; private saves belong to the runner.
judge_camera: JudgeView?
judge_origin=pc.state.position
judge_ready=env("AEGEAN_CAPTURE_READY")!=none
judge_trace=env("AEGEAN_CAPTURE_TRACE")!=none
judge_frame=0
stress_frame_dt=to_float(env("AEGEAN_STRESS_FRAME_DT") ?? "0") ?? 0.0
if let recipe=env("AEGEAN_CAPTURE"):
    judge_camera=judge_view(recipe,towns,pc.state.position,pc.spec.span)
    if recipe!="flight":free.pos=judge_camera!.eye;me.pos=free.pos;me.mode=.free
    print("CAPTURE {judge_camera!.label}; eye {judge_camera!.eye}; target {judge_camera!.target}; hour {hour}")
# A lived-in judging capture must publish the canonical far catalogue before
# advancing its clock; otherwise the lazy island registry can still be warming
# when the requested screenshot is taken. Ordinary startup remains incremental.
if env("AEGEAN_CAPTURE_LIFE")!=none:
    settlement_registry.finish_settlement_registry()
    sync_folk(folks,living_world,towns)
if let minutes=env("AEGEAN_CAPTURE_MINUTES"):
    living.advance_minutes(living_world,max(0,to_int(minutes) ?? 0))
    sync_folk(folks,living_world,towns)
if env("AEGEAN_CAPTURE_PANEL")=="notebook":
    living.advance_minutes(living_world,180)
    loop id in living_world.active_jobs:
        j=living_world.jobs[id]
        if j.origin==0 and j.state==.open and notebook.notes.len()<3:
            pin_notice(notebook,id,j.poster,"{job_cargo(id)} to {SETTLEMENTS[j.destination].name}","{living_world.people[j.poster].name}; due {clock_text(living_world,j.due_minute)}; {j.reward_cents/100} lire",clock_text(living_world,living_world.minute))
    notebook.open=true
    print("NOTEBOOK {to_text(notebook.notes)}")
if env("AEGEAN_CAPTURE_PANEL")=="options":dbg.page=4
if let attitude=env("AEGEAN_CAPTURE_ATTITUDE"):
    words=split(attitude," ")
    pitch=to_float(words[0]) ?? 0.0
    pc.state.orientation=quat_euler(pitch,-along_quay,0)
    pc.state.velocity=quat_rotate(pc.state.orientation,vec3(0,0,-f32(length(pc.state.velocity))))

# The same close orbit used in play, without browser pointer-lock permission in captures.
if let orbit=env("AEGEAN_CAPTURE_ORBIT"):
    words=split(orbit," ");assert(words.len()==3,"orbit capture: distance yaw pitch")
    me.mode=.aboard;pc.orbiting=true
    pc.orbit_dist=clamp(to_float(words[0]) ?? 9.0,9.0,90.0)
    pc.orbit_yaw=to_float(words[1]) ?? 0.0
    pc.orbit_pitch=clamp(to_float(words[2]) ?? 0.32,-0.05,1.35)

if let scenario=env("AEGEAN_SCENARIO"):assert(load_scenario(scenario),"Unknown scenario")
if env("AEGEAN_CAPTURE_PANEL")=="scenarios":dbg.page=5;set_paused(true)

# AEGEAN_CAPTURE_WAR=card|chart|board|contract stages war news for headless captures of the
# battle card, the chart's war layer and the military contracts (capture only: the living world
# makes the real ones from its own forces and reports)
import 'src/living_missions.jo' as war_missions
import 'src/living_far_types.jo' as far_types
import 'src/living_far_news.jo' as far_news_api
stage_capture_war = (stage: str):
    global battle_card, presentation, ui, ui_place, ui_mission, ui_line, living_world
    w = living_world
    home_d = core_district(w, 0)
    print("WAR STAGE {stage}: home district {home_d}, {w.far.place_ids.len()} places, populated {w.far.populated}")
    if home_d < 0: return
    at = w.place_contexts[home_d].center
    # (the nearest other places to the home harbor, nearest first)
    near: (f64, int)[]
    loop id in w.far.place_ids:
        if id != home_d and id in w.place_contexts and id in w.far.harbors: near.push((f64(length(w.place_contexts[id].center - at)), id))
    # (towns of some size first, so the staged names read like the real ones)
    near.sort((e: (f64, int)): (if stage == "card" and w.far.districts[e.1].population < 300: 1 else: 0, e.0))
    if near.len() < 4: return
    if stage == "card":
        battle_card.name = "Battle for {w.place_contexts[near[0].1].name}"
        battle_card.line = "{w.place_contexts[near[0].1].name},  {war_date(w.minute, true)}"
        battle_card.since = t - 2.4
        return
    me_ = w.player
    m0 = w.minute
    report = (rid: int, kind: str, place: int, text: str, country: int, other: int, ago: int, heard: int) -> far_types.FarReport:
        far_types.FarReport(900000 + rid, max(0, m0 - ago), max(0, m0 - heard), place, text, kind, country = country, other_country = other, severity = if kind == "battle": 900 else: 1000, confidence = 850, hops = 1)
    if stage == "chart":
        p1 = near[0].1; p2 = near[1].1; p3 = near[2].1
        c1 = w.place_contexts[p1].center; c3 = w.place_contexts[p3].center
        reports = [
            report(0, "war_declared", home_d, "Kalyra declared war on Orenthia.", 1, 2, 2900, 2700),
            report(1, "occupation", p1, "A supplied Orenthia force arrived at {w.place_contexts[p1].name}.", 2, -1, 1500, 1300),
            report(2, "blockade", p2, "A supplied Kalyra charter has established a cordon off {w.place_contexts[p2].name}.", 1, 2, 700, 300),
            report(3, "battle", p1, "Battle for {w.place_contexts[p1].name}: A Orenthia charter defeated a Kalyra unit near {c1.x + 900.0:.0}, {c1.z - 1200.0:.0}.", 2, 1, 1450, 1250),
            report(4, "battle", p3, "A Kalyra charter defeated a Orenthia unit near {c3.x - 1500.0:.0}, {c3.z + 700.0:.0}.", 1, 2, 400, 100)]
        loop r in reports: w.people[me_].far_reports.push(r)
        presentation.battles_seen.push(lt.BattleSighting(-5, "Battle off {w.place_contexts[p3].name}", c3 + vec3(1800, 0, -900), max(0, m0 - 20)))
        living_world = w
        return
    # board / contract: a reconnaissance contract posted at the home office over the nearest port
    country = w.far.districts[home_d].controller
    w.far.districts[near[0].1].controller = (country + 1) % 3
    id = war_missions.post_mission(w, country, .reconnaissance, home_d, home_d, near[0].1, 1800 + int(near[0].0 * 0.12))
    living_world = w
    print("WAR STAGE mission {id} counter-board {length(far_news_api.far_counter_position(w, home_d) - board_spots[0]):.0} m")
    ui_place = 0
    if stage == "board": ui = .board
    else if id >= 0:
        ui = .contract; ui_mission = id
        if let m = find_mission(w, id): ui_line = "{m.why} Due {clock_text(w, m.deadline)}. {contract_status(w, m)}"
war_stage_pending = env("AEGEAN_CAPTURE_WAR")

# AEGEAN_CAPTURE_RACE=offer|countdown|start|racing|missed|finish stages a meet off the home
# harbor for headless captures of the race screens (capture only; the living world makes real ones)
capture_race = env("AEGEAN_CAPTURE_RACE")
stage_capture_race = (stage: str):
    global air_events
    tick = living_world.tick
    gates = air_course(home.center, vec3(home.out.x, 0, home.out.y), surface_height)
    if gates.len() == 0: return
    capital = -1
    if stage == "offer" and me.mode == .aboard: pc.throttle = 0.0
    before = if stage == "offer": 600 * 60 else: (if stage == "countdown": 90 * 60 else: (if stage == "start": 2 * 60 + 30 else: -70 * 60))
    meet = AirMeet(-7, capital, lt.day_index(living_world.minute), home.name + " air meeting", gates, race_tick = tick + before, display_tick = tick + 100000, end_tick = tick + 200000)
    meet.phase = if before > 0: .registration else: .racing
    if stage != "offer":
        craft = living_world.people[living_world.player].craft
        mine = AirEntry(craft, living_world.player, true, gate = 3, laps = 1, started_tick = tick - 64 * 60, sampled = true, last_tick = tick)
        if stage == "countdown" or stage == "start": mine = AirEntry(craft, living_world.player, true, sampled = true, last_tick = tick)
        if stage == "missed": mine.missed = true
        if stage == "finish": mine = AirEntry(craft, living_world.player, true, gate = 0, laps = 2, started_tick = tick - 101 * 60 - 20, finished_tick = tick - 60, sampled = true, last_tick = tick)
        meet.entries.push(AirEntry(-11, -11, gate = 4, laps = 1, started_tick = tick - 66 * 60, finished_tick = if stage == "finish": tick - 300 else: -1))
        meet.entries.push(mine)
        meet.entries.push(AirEntry(-12, -12, gate = 2, laps = 1, started_tick = tick - 65 * 60))
        meet.entries.push(AirEntry(-13, -13, gate = 1, laps = 1, started_tick = tick - 63 * 60))
    air_events.meets = [loop m in air_events.meets: if m.id != -7: m] + [meet]

# the air race open for entry here, when F has nothing else to do here (-1 otherwise)
race_offer_here = () -> int:
    if paused or show_chart or ui != .none or notebook.open: return -1
    if me.mode == .walking:
        if holding_cargo() >= 0 or near_job_cargo() >= 0 or near_own_craft() or near_board() >= 0 or nearest_folk(folks, me.pos, 3.5) >= 0 or map_shop_here() != "": return -1
        if pc.state.moored:
            if let a = mooring_anchor():
                if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: return -1
        k = race_offer(air_events, living_world, me.pos)
        return if k >= 0: k else: race_withdraw_offer(air_events, living_world, me.pos)
    if me.mode == .aboard:
        st = pc.state
        if st.crashed or st.capsized or st.beached or st.moored or not st.on_water or length(st.velocity) > 8.0: return -1
        if mooring_spot(pc, towns) != none or find_vessel_mooring(vessels, st, pc.spec.span) != none or rescue_act != 0: return -1
        k = race_offer(air_events, living_world, st.position)
        return if k >= 0: k else: race_withdraw_offer(air_events, living_world, st.position)
    -1

# A townsperson greeting the player mentions the nearest air meet ahead, once a day each.
meet_remarked: {int: int}
# (the remark goes after what they say, before any question they ask)
with_meet_remark = (speaker: int, turn: social.ConversationTurn) -> str:
    global meet_remarked
    day = lt.day_index(living_world.minute)
    if meet_remarked.get(speaker, -1) == day or turn.exhausted: return turn_text(turn)
    remark = air_meet_remark(air_events, living_world, speaker, me.pos)
    if remark == "": return turn_text(turn)
    meet_remarked[speaker] = day
    said = if turn.text == "": remark else: "{turn.text} {remark}"
    if turn.question != "": "{said} {turn.question}" else: said


# ---------------- map sellers, and people to be picked up from the water ----------------

# a map seller's counter within a few steps, when F has nothing else to do here ("": none)
map_shop_here = () -> str:
    if paused or show_chart or ui != .none or notebook.open or me.mode != .walking: return ""
    if holding_cargo() >= 0 or near_job_cargo() >= 0 or near_own_craft() or near_map_find() >= 0 or near_board() >= 0 or nearest_folk(folks, me.pos, 3.5) >= 0: return ""
    best = ""
    bd = 7.0
    loop s in living.map_sellers(living_world, living_world.player):
        d = f64(length(vec2(s.pos.x - me.pos.x, s.pos.z - me.pos.z)))
        if d < bd: best = s.id; bd = d
    best

# the map seller someone keeps, when one is at their counter ("": none)
map_shop_of = (person: int) -> str:
    loop s in living.map_sellers(living_world, living_world.player):
        if s.person == person: return s.id
    ""

map_shop_prompt = (shop: str) -> str:
    s = living_world.maps.shops[shop]
    ready = false
    loop r in map_counter_rows(living_world, shop, living_world.player):
        if r.job >= 0 and r.ready: ready = true
    if ready: "F  collect the promised map at {s.name}" else: "F  look at the maps for sale at {s.name}"

open_map_counter = (shop: str):
    global ui, ui_shop
    ui = .maps
    ui_shop = shop
    mouse_lock(false)

rescue = RescueView()
# (what F does for a rescue this frame: 1 take survivor `rescue_id` aboard, 2 set them ashore)
rescue_act = 0
rescue_id = -1
rescue_place = -1
rescue_name = ""

rescue_prompt = () -> str:
    if rescue_act == 1: "F  take {rescue_name} aboard"
    else if rescue_act == 2: "F  help {rescue_name} ashore"
    else: ""

# Which rescue F does here: pick up beside survivors on the water, or land them beside one's
# moored aircraft at a harbour.
update_rescue = ():
    global rescue_act, rescue_id, rescue_place, rescue_name
    rescue_act = 0
    rescue_id = -1
    if paused or show_chart or ui != .none or notebook.open: return
    at = if me.mode == .aboard: pc.state.position else: me.pos
    if frame_number() % 20 == 0:
        loop line in rescue_scan(rescue, living_world, at):
            say_toast(line)
            log_note(notebook, line, clock_text(living_world, living_world.minute))
    if me.mode == .aboard:
        st = pc.state
        if st.crashed or st.capsized or st.beached or st.moored: return
        k = rescue_pickup(rescue, st.position, st.on_water, f64(length(st.velocity)))
        if k >= 0:
            rescue_act = 1
            rescue_id = k
            loop s in rescue.views:
                if s.id == k: rescue_name = survivor_name(living_world, s)
    else if me.mode == .walking and near_own_craft() and holding_cargo() < 0:
        aboard = rescue_aboard(living_world)
        if aboard.len() > 0:
            place = rescue_harbour(living_world)
            if place >= 0:
                rescue_act = 2
                rescue_id = aboard[0]
                rescue_place = place
                rescue_name = rescue_aboard_name(living_world, aboard[0])

do_rescue = ():
    now = clock_text(living_world, living_world.minute)
    if rescue_act == 1:
        name = rescue_name
        n = living.board_survivors(living_world, rescue_id, living_world.player)
        if n <= 0:
            say_toast("Come right alongside and stop, with room aboard.")
            return
        rescue_card(rescue, if n == 1: "{name} is aboard" else: "{n} survivors aboard", ["Moor at a harbour to set them ashore."], t)
        log_note(notebook, "Took {name} aboard from the water.", now)
    else if rescue_act == 2:
        s = living_world.war.survivors[rescue_id]
        name = rescue_name
        before = living.national_regard(living_world, s.country, living_world.player)
        n = living.land_survivors(living_world, rescue_id, rescue_place, living_world.player)
        if n <= 0:
            say_toast("They can't go ashore here.")
            return
        after = living.national_regard(living_world, s.country, living_world.player)
        country = living_world.countries[s.country].name
        place = harbour_name(living_world, rescue_place)
        rescue_card(rescue, "Ashore at {place}", [if n == 1: "{name}, rescued" else: "{n} survivors, rescued", "Standing with {country}: {before} to {after}"], t)
        log_note(notebook, "Set {name} ashore at {place}. Standing with {country} {before} to {after}.", now)


# AEGEAN_CAPTURE_MAPS=counter|office|reward|bought|prompt opens a Porto Vecchio map counter (reward: the
# chandler's promised sheet, its errand marked done; bought: one sheet bought first, for the card;
# prompt: the player stood at the chandlery's counter instead)
# and AEGEAN_CAPTURE_RESCUE=mark|pickup|aboard|ashore|landed|papers stages a downed pilot near the player
# (mark: a kilometre out from the aircraft on the water; pickup/aboard: beside it there;
# ashore/landed: already aboard the moored aircraft; papers: landed, then the notebook open).
# Captures only.
capture_maps = env("AEGEAN_CAPTURE_MAPS")
capture_rescue = env("AEGEAN_CAPTURE_RESCUE")
capture_stage_frame = -1
stage_capture_maps = (stage: str):
    shop = if stage == "office": "porto-office" else: "porto-chandler"
    if stage == "reward":
        loop job, _ in living_world.maps.rewards:
            living_world.jobs[job].carrier = living_world.player
            living_world.jobs[job].state = .delivered
    if stage == "bought":
        rows = map_counter_rows(living_world, shop, living_world.player)
        if rows.len() > 1: _ = living.buy_map(living_world, rows[1].copy, living_world.player)
    if stage == "prompt":
        at = living_world.maps.shops[shop].pos
        me.pos = vec3(at.x, f32(walk_height(towns, f64(at.x), f64(at.z))), at.z)
        follow.placed = false
        portage.cargo_person_pose(living_world, living_world.player, me.pos)
        loop c in living.nearby_map_finds(living_world, living_world.player): _ = living.find_map(living_world, c.id, living_world.player)
        return
    open_map_counter(shop)

stage_capture_rescue = (stage: str):
    global capture_stage_frame
    if capture_stage_frame < 0:
        if not living_world.far.populated: return
        craft = living_world.people[living_world.player].craft
        if stage == "pickup" or stage == "aboard" or stage == "mark":
            out = vec3(home.out.x, 0, home.out.y)
            p0 = home.docks[0] + out * 140.0
            pc.state = CraftState(position = vec3(p0.x, f32(pc.spec.float_height), p0.z), orientation = quat_euler(0, -along_quay, 0), fuel = pc.spec.fuel_capacity, water_age = 1.0, on_water = true)
            pc.throttle = 0.0
            me.mode = .aboard
            _ = stage_rescue_survivor(living_world, p0 + out * (if stage == "mark": 1100.0 else: 14.0) + vec3(-out.z, 0, out.x) * (if stage == "mark": 250.0 else: 0.0))
        else:
            id = stage_rescue_survivor(living_world, living_world.aircraft[craft].pose.pos + vec3(2, 0, 0))
            if id >= 0: _ = living.board_survivors(living_world, id, living_world.player)
        capture_stage_frame = frame_number()
        return
    wait = frame_number() - capture_stage_frame
    if (stage == "aboard" or stage == "landed" or stage == "papers") and wait == 40 and rescue_act != 0: do_rescue()
    if stage == "papers" and wait == 60:
        notebook.open = true
        notebook.fresh = true

update = (dt: f64):
    global air_visual,air_events,all_air_traffic,view_target,target_scan
    global t, hour, show_chart, chart_local, pc, ui, ui_folk, ui_line, ui_news, ui_place, paused, descent_camera, vessel_mooring, was_moored
    # (the touch screen's stick and buttons, read as keys below; mode: 0 flying, 1 on the water,
    # 2 on foot, 3 a panel open)
    # (AEGEAN_TALK: a conversation with the nearest person opens at the start, for looking at it)
    if talk_at_start and t > 1.0 and ui == .none and me.mode == .walking:
        global talk_at_start, ui_turn
        talk_at_start = false
        k0 = nearest_folk(folks, me.pos, 1000000.0)
        if k0 >= 0:
            ui = .talk
            ui_folk = k0
            ui_turn = living.talk(living_world, folks[k0].person, .greeting, living_world.player)
            ui_line = with_meet_remark(folks[k0].person, ui_turn)
    pad_mode = if paused or ui != .none or notebook.open or show_chart: 3 else if me.mode == .aboard: (if pc.state.on_water or pc.state.moored: 1 else: 0) else: 2
    lay_out_screen()                # (upright or on its side, a phone gets its own units)
    update_pad(pad_mode, not pc.slow, pc.throttle, dt)
    # P (or F1) stops the world and its sounds, and opens the pause menu (the debugging panel)
    if (vpressed(.p) or vpressed(.f1)) and not notebook.open and not ui_typing() and not debug_typing(): set_paused(not paused)
    if show_chart and geography_enabled and vpressed(.tab): chart_local = not chart_local
    global chart_sheets
    chart_sheets = if dbg.picking or not show_chart: none else: owned_chart_sheets()
    if frame_number() % 15 == 0 and not paused: notice_new_maps()
    # the pause menu's music keeps playing after unpausing, to hear it among the world's sounds
    music_audition_update(dbg.music,dt,env("SLOPPY_NO_AUDIO") == none)
    if paused:
        _ = radio.radio_hold_tune(cockpit_radio,0,0)
        hush_audio(audio)
        ambience_hush(world_ambience.sound)
        world_ambience.previous_scan = -1
        life_audio.hush_life_audio(life_sound)
        radio.radio_silence(cockpit_radio)
        hush_combat_audio(combat_audio);hush_battle_radio(battle_radio)
        hush_engines(hearing)
        # (picking a place on the chart from the pause menu; Escape gives up)
        if dbg.picking and show_chart and mouse_pressed(.left):
            if let q = chart_place(mouse_pos()):
                debug_place(f64(q.x), f64(q.y), dbg.altitude)
                set_paused(false)
        if dbg.picking and (vpressed(.escape) or vpressed(.m)):
            dbg.picking = false
            dbg.open = true
            show_chart = false
        return
    let dt = frame_dt(if stress_frame_dt>0:stress_frame_dt else:dt)
    t += dt
    weather_scene_step(living_world,if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos,hour,dt)
    hour = (hour + dt / 120.0 + 24.0) % 24.0          # an hour of the day: two minutes
    typing = ui_typing() or debug_typing()
    # The radio: , and . tune it (Shift: to the next station on the air), / switches it on and off,
    # and on a touch screen the Radio button steps through the stations and off. Tuning switches it
    # on; a card says where it is.
    if me.mode == .aboard and ui == .none and not notebook.open and not show_chart and not typing:
        tuned = false
        if vdown(.shift):
            _ = radio.radio_hold_tune(cockpit_radio,0,0)
            if vpressed(.comma): radio.radio_seek(cockpit_radio,-1,living_world.minute); tuned = true
            if vpressed(.period): radio.radio_seek(cockpit_radio,1,living_world.minute); tuned = true
        else:
            direction = (if vdown(.period): 1 else: 0)-(if vdown(.comma): 1 else: 0)
            tuned = radio.radio_hold_tune(cockpit_radio,direction,dt)
        if tuned and cockpit_radio.muted: radio.radio_mute(cockpit_radio, false)
        if vpressed(.slash):
            radio.radio_mute(cockpit_radio,not cockpit_radio.muted)
            tuned = true
        if vpressed(.f9):
            if cockpit_radio.muted:
                radio.radio_mute(cockpit_radio, false)
                radio.radio_seek(cockpit_radio, 1, living_world.minute)
            else:
                was = cockpit_radio.khz
                radio.radio_seek(cockpit_radio, 1, living_world.minute)
                if cockpit_radio.khz <= was: radio.radio_mute(cockpit_radio, true)
            tuned = true
        if tuned:
            global radio_card_until
            radio_card_until = t + 2.5
    else:
        _ = radio.radio_hold_tune(cockpit_radio,0,0)
    if vdown(.n1) and not typing: hour = (hour - dt * 2.0 + 24.0) % 24.0
    if vdown(.n2) and not typing: hour = (hour + dt * 2.0) % 24.0
    if vpressed(.m) and not typing:
        show_chart = not show_chart
        # (the chart's list of maps wants the mouse; flying, it goes back to the camera after)
        if show_chart: mouse_lock(false)
        else if me.mode == .aboard: mouse_lock(true)
    if vpressed(.escape): mouse_lock(false)
    # (a click takes the mouse for the camera only when no panel is open to be clicked)
    if mouse_pressed(.left) and me.mode != .free and ui == .none and not notebook.open and not dbg.open and not show_chart and not is_mouse_locked():
        mouse_lock(true)
        global click_took_mouse
        click_took_mouse = true             # (that click only takes the mouse: it doesn't fire)
    if not mouse_down(.left):
        global click_took_mouse
        click_took_mouse = false
    if vpressed(.j) and not notebook.open and ui == .none and not typing:
        notebook.open = true
        notebook.fresh = true
        mouse_lock(false)
    if vpressed(.f2) and not typing: me.mode = if me.mode == .free: Mode.walking else: Mode.free
    # (only while the card can be seen: a battle met behind a panel keeps its card for later)
    if (me.mode == .aboard or me.mode == .walking) and frame_number() % 20 == 0 and not paused and not show_chart and ui == .none:
        global battle_card, presentation
        if battle_card_step(battle_card, presentation, living_world, if me.mode == .aboard: pc.state.position else: me.pos, t):
            log_note(notebook, "Came upon the {battle_card.name}.", clock_text(living_world, living_world.minute))
    if frame_number() % 30 == 0:
        global packets_now
        packets_now = contract_marks(living_world, living_world.player, if me.mode == .aboard: pc.state.position else: me.pos)
    if show_chart and war_chart.minute != living_world.minute:
        global war_chart
        war_chart = war_chart_data(living_world, living_world.player, presentation.battles_seen)
    if let stage = capture_maps:
        if frame_number() == 3: stage_capture_maps(stage)
    if let stage = capture_rescue: stage_capture_rescue(stage)
    update_rescue()
    race_k = race_offer_here()
    if race_k >= 0 and vpressed(.f) and not typing:
        if player_air_entry(air_events.meets[race_k], living_world.player) != none:
            back = air_withdraw_refund(air_events.meets[race_k], player_air_entry(air_events.meets[race_k], living_world.player)!, living_world.tick)
            out = withdraw_player_air_meet(air_events, living_world, air_events.meets[race_k].id)
            say_toast(if not out.accepted: out.reason else: if back > 0: "Withdrawn. The club returned your {back / 100} lire." else: "Withdrawn.")
        else:
            entry = enter_player_air_meet(air_events, living_world, air_events.meets[race_k].id)
            say_toast(if entry.accepted: "Entered. The race starts at {clock_text(living_world, air_events.meets[race_k].race_tick / 120)}" else: entry.reason)
    player_combat=combat_index(battle,living_world.people[living_world.player].craft)
    if player_combat>=0:battle.actors[player_combat].pilot.trigger=false
    match me.mode:
        .free: free.update(dt)
        .walking:
          if ui != .none: update_player_follow(dt)
          if ui == .none and not notebook.open:
              follow.distance = clamp(follow.distance * pow(0.93, clamp(mouse_wheel(), -3.0, 3.0)), 2.5, 14.0)
              if vdown(.q): follow.yaw += dt * 2.0
              if vdown(.e): follow.yaw -= dt * 2.0
              a = input_axis()
              # (on a touch screen: two fingers turn the view and pinch it nearer)
              follow.yaw -= f64(pad.orbit.x) * 0.006
              follow.pitch = clamp(follow.pitch + f64(pad.orbit.y) * 0.004, follow.min_pitch, follow.max_pitch)
              if pad.zoom != 1.0: follow.distance = clamp(follow.distance / pad.zoom, 2.5, 14.0)
              move = flat_forward(follow) * -a.y + flat_right(follow) * a.x
              run = vdown(.shift)
              # (on a touch screen: the Walk button walks the way the view looks, faster the farther
              # the thumb slides from it; a tap on someone near talks to them)
              global pad_talk
              if pad.walking:
                  # (the thumb slid across bears him that way, and the view swings after him)
                  bear = pad.walk_side * 0.9
                  move = flat_forward(follow) * f32(cos(bear)) + flat_right(follow) * f32(sin(bear))
                  run = pad.walk_speed > 0.6
                  if abs(pad.walk_side) > 0.15: follow.yaw = approach_angle(follow.yaw, me.yaw + PI, 0.9 * abs(pad.walk_side), dt)
              if pad.tapped:
                  if let g = ground_under(pad.tap_at):
                      k = nearest_folk(folks, g, 2.0)
                      if k >= 0 and length(folks[k].pos - me.pos) < 3.5: pad_talk = true
              speed = if holding_cargo() >= 0: 1.0 else: if pad.walking: 1.7 + 2.5 * pad.walk_speed else: if run: 4.2 else: 1.7
              if length(move) > 0.1:
                  dir = normalize(vec2(move.x, move.z))
                  me.yaw = approach_angle(me.yaw, atan2(f64(dir.x), f64(dir.y)), 10.0, dt)
                  step_player_walk(dir * f32(speed * dt))
                  me.stride = approach(me.stride, if run: 1.0 else: 0.7, 8.0, dt)
                  me.phase += dt * speed * 5.0
              else:
                  me.stride = approach(me.stride, 0.0, 8.0, dt)
              update_player_follow(dt)
              portage.cargo_person_pose(living_world,living_world.player,me.pos)
              living_world.people[living_world.player].pose.rot = lt.facing(vec3(f32(sin(me.yaw)),0,f32(cos(me.yaw))))
              if vdown(.f) and holding_cargo() < 0 and not near_own_craft() and pc.state.moored:
                  if let a = mooring_anchor():
                      if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: haul_in(dt)
              # talk to whoever is near; read the board
              cargo_used = vpressed(.f) and cargo_interact()
              if vpressed(.f) and not cargo_used and rescue_act == 2:
                  cargo_used = true
                  do_rescue()
              if vpressed(.t) or pad_talk:
                  pad_talk = false
                  k = nearest_folk(folks, me.pos, 3.5)
                  if k >= 0:
                      ui = .talk
                      ui_folk = k
                      global ui_turn
                      ui_turn = living.talk(living_world, folks[k].person, .greeting, living_world.player)
                      ui_line = with_meet_remark(folks[k].person, ui_turn)
                      # (someone whose cargo one has brought sees it)
                      loop id in living_world.active_jobs:
                          j = living_world.jobs[id]
                          if j.state == .claimed and j.carrier == living_world.player and j.loaded and j.destination == folks[k].place and recipient_of(id) == folks[k].person:
                              ui_line = "Is that {job_cargo(id)} from {living_world.people[j.poster].name}?"
                      ui_news = 0
                      mouse_lock(false)
              if vpressed(.f) and not cargo_used and holding_cargo() < 0 and not near_own_craft() and near_map_find() >= 0:
                  cargo_used = true
                  found = living.find_map(living_world,near_map_find(),living_world.player)
                  if not found.ok: say_toast(found.message)
              if vpressed(.f) and not cargo_used and not near_own_craft() and near_board() >= 0:
                  ui = .board
                  ui_place = near_board()
                  mouse_lock(false)
              if vpressed(.f) and not cargo_used and map_shop_here() != "":
                  cargo_used = true
                  open_map_counter(map_shop_here())
              if vpressed(.f) and not cargo_used and holding_cargo() < 0 and near_own_craft():
                  me.mode = .aboard
                  mouse_lock(true)
                  pc.placed = false
                  pc.throttle = 0.0
        .descent:
            loop mut d in battle.descents:
                if d.person!=living_world.player or d.released:continue
                move=input_axis()
                d.steering=flat_forward(descent_camera.look)*-move.y+flat_right(descent_camera.look)*move.x
                d.open_requested=vpressed(.t)
                me.pos=d.position
                update_descent_camera(descent_camera,d,dt,ground=surface_height)
                if d.phase==.canopy:d.yaw=descent_camera.look.yaw
                if d.phase==.landed:
                    me.mode=.walking;d.released=true;follow.placed=false
        .aboard:
            if vpressed(.v) and not typing:pc.cockpit_view=not pc.cockpit_view
            if vpressed(.x) and not typing:pc.gear_down=not pc.gear_down
            protected=pc.state.moored
            loop tw in towns:
                if length(pc.state.position-tw.center)<1200 and pc.state.position.y<300:protected=true
            gun_safety(pc,protected,vpressed(.g) and not typing)
            ci=combat_index(battle,living_world.people[living_world.player].craft)
            if vpressed(.t) and not typing and not pc.state.moored and ci>=0:
                battle.actors[ci].state=pc.state
                if bail_combatant(battle,ci):
                    me.mode=.descent;pc.cockpit_view=false
                    if combat_audio.guns.len()>0:combat_audio_events(combat_audio,[battle.events[battle.events.len()-1]],scene_camera())
                    me.pos=battle.descents[battle.descents.len()-1].position;follow.placed=false
                    descent_camera=DescentCamera(look=follow_camera(distance=9.0,yaw=-heading(pc.state),pitch=0.0,height=1.9),eye=scene_camera())
                    update_descent_camera(descent_camera,battle.descents[battle.descents.len()-1],dt,input=false,ground=surface_height)
            before = pc.state.velocity
            set_drag_scale(if dbg.no_drag: 0.0 else: 1.0)
            previous_vessel_contact = pc.state.position
            if me.mode==.aboard:fly(pc, dt, t)
            if not dbg.no_damage: collide_vessels(vessels,pc.spec,pc.state,previous_vessel_contact,living_world.people[living_world.player].craft)
            set_drag_scale(1.0)
            # into the water hard (falling fast): a column of spray thrown up all round, and the
            # aircraft driven under in the blink of an eye, to bob back up
            global plunge, plunge_v
            down = -f64(before.y)
            if down > 15.0 and abs(plunge) < 0.5 and plunge_v > -1.0:
                loop ev in pc.state.damage.events:
                    if ev.kind == .splash:
                        q = vec3(ev.position.x, f32(swell_at(f64(ev.position.x), f64(ev.position.z), t).x), ev.position.z)
                        plunge_v = -min(down, 90.0) * 0.7
                        emit(spray_ps, q, 220, 16.0 + down * 0.3, rgba(0.97, 0.99, 1.0, 0.95), 2.4, 1.8, 0.28, vec3(0, 1, 0))
                        emit(spray_ps, q, 120, 9.0 + down * 0.12, rgba(0.93, 0.97, 1.0, 0.85), 1.8, 1.2, 1.3, vec3(0, 1, 0))
                        break
            plunge_v += (-(2.6 * plunge) - 2.2 * plunge_v) * dt
            plunge += plunge_v * dt
            if abs(plunge) < 0.01 and abs(plunge_v) < 0.05:
                plunge = 0.0
                plunge_v = 0.0
            # the guns: Space in the air, or the left button once the game has the mouse
            # (not while slow, with the mouse orbiting the camera)
            held = (not tweaks.orbit_camera or not pc.slow) and ((vdown(.space) and not pc.state.on_water) or (mouse_down(.left) and is_mouse_locked() and not click_took_mouse))
            if ci>=0:
                battle.actors[ci].pilot.trigger=held and me.mode==.aboard and not pc.state.crashed
                battle.actors[ci].gun.locked=pc.guns_locked
            if trace and floor(t) != floor(t - dt):
                st = pc.state
                f = quat_rotate(st.orientation, vec3(0, 0, -1))
                print("t {t:.0} spd {length(st.velocity):.1} alt {st.position.y:.1} pitch {asin(f64(f.y)) * 57.3:.0} aoa {st.aoa * 57.3:.0} thr {st.throttle:.2} water {st.on_water} stall {st.stalled} crash {st.crashed} cap {st.capsized} hull {st.hull_damage:.2}")
            chase(pc, dt)
            spray(pc, craft_models, spray_ps, dt)
            # what the aircraft hit: a splash, a crunch, parts tearing away; seen, heard and felt
            loop ev in pc.state.damage.events:
                hard = clamp(log(1.0 + ev.strength / 2000.0) / 6.0, 0.0, 1.0)
                if hard < 0.05: continue
                crunch = ev.kind != .splash
                n = int(6.0 + 60.0 * hard)
                emit(spray_ps, ev.position, n, 4.0 + 14.0 * hard, rgba(0.96, 0.98, 1.0, 0.9), 1.4, 0.6 + 0.8 * hard, 0.9, normalize(ev.normal + vec3(0, 1, 0)))
                if crunch: emit(spray_ps, ev.position, n / 2, 6.0 + 10.0 * hard, rgba(0.42, 0.3, 0.2, 1), 1.8, 0.25, PI, vec3(0, 1, 0))
                impact_sound(audio, ev.position, crunch, hard)
                # (the camera feels it: a jolt in its spring)
                pc.cam_ev += normalize(ev.impulse + vec3(0, 0.001, 0)) * f32(-3.0 * hard)
            vapor(pc, vapor_trails, hour, t)
            if vpressed(.f) and rescue_act == 1: do_rescue()
            else if vpressed(.f):
                if let ship_mooring = find_vessel_mooring(vessels,pc.state,pc.spec.span):
                    vessel_mooring = ship_mooring
                    if let point = vessel_mooring_point(vessels,vessel_mooring,pc.spec.span):
                        moor(pc.state,vec3(point.x,f32(pc.spec.float_height),point.z),heading(pc.state))
                        pc.throttle = 0.0
                        rope.tied = true; rope.anchor = point; was_moored = true
                else if let d0 = mooring_spot(pc, towns):
                  if dock_taken(d0, others_at()): say_toast("That dock is taken")
                  else:
                    d = d0
                    moor(pc.state, vec3(d.x, f32(pc.spec.float_height), d.z), heading(pc.state))
                    pc.throttle = 0.0
                    tie_up()
                    step_ashore(d)
                    th = town_here(d)
                    if th >= 0: deliver_here(th)
                else if pc.state.moored and vessel_mooring.vessel < 0: step_ashore(pc.state.position)
            if vpressed(.r) and (pc.state.crashed or pc.state.capsized or pc.state.beached):
                # towed home to a free dock and patched up (the bill comes later)
                dock = free_dock(home, others_at(), home.docks[0]) ?? home.docks[0]
                pc = make_flyer(pc.kind, pc.model, craft_models[pc.model].contacts, dock, along_quay)
                ci=combat_index(battle,living_world.people[living_world.player].craft)
                if ci>=0:battle.actors[ci]=Combatant(battle.actors[ci].craft,living_world.player,0,pc.spec,pc.state,external=true,human=true,previous=pc.state.position,model=pc.model)
                pc.placed = false
                tie_up()
    if was_moored and not pc.state.moored and rope.tied:
        was_moored = false
        off = vec3(pc.state.position.x - rope.anchor.x, 0, pc.state.position.z - rope.anchor.z)
        rope.loose = rope.anchor + normalize(off + vec3(0.001, 0, 0)) * 3.0
    if not rope.tied and pc.state.moored: tie_up()
    dust_ps.update(dt)
    # debugging: F1 opens the panel; its standing switches
    if dbg.infinite_fuel:
        pc.state.fuel = pc.spec.fuel_capacity
        debug_fuel_ml(living_world.people[living_world.player].craft, int(pc.spec.fuel_capacity * 1000.0))
    if dbg.no_damage and not pc.state.crashed:
        loop k in 0..pc.state.damage.parts.len():
            if pc.state.damage.parts[k].attached: pc.state.damage.parts[k].health = 1.0
    wind_now.speed = max(0.0, wind_now.speed + wind_bias)
    update_walkers(dt)
    # the errands one carries: told, and written in the log, when they are done or missed
    loop id, was in my_jobs:
        if not (id in living_world.jobs): continue
        j = living_world.jobs[id]
        if j.state == was: continue
        my_jobs[id] = j.state
        rcv = living_world.people[recipient_of(id)].name
        dest = SETTLEMENTS[j.destination].name
        now = clock_text(living_world, living_world.minute)
        match j.state:
            .delivered:
                say_toast("Delivered: {job_cargo(id)} to {rcv} at {dest}, {j.paid_cents / 100} lire")
                log_note(notebook, "Delivered {job_cargo(id)} to {rcv} at {dest}. Paid {j.paid_cents / 100} lire{if j.paid_cents < j.reward_cents: " (late)" else: ""}.", now)
            .failed:
                say_toast("The errand failed: {job_cargo(id)} for {rcv} at {dest}")
                log_note(notebook, "Failed: {job_cargo(id)} for {rcv} at {dest}.", now)
            .expired:
                say_toast("Too late: {job_cargo(id)} for {rcv} at {dest}")
                log_note(notebook, "Too late for {rcv} at {dest}: {job_cargo(id)}.", now)
            .cancelled:
                log_note(notebook, "Called off: {job_cargo(id)} for {rcv} at {dest}.", now)
            _: pass
    notebook.live = [loop id in my_jobs.keys(): if id in living_world.jobs and living_world.jobs[id].state == .claimed: "{job_cargo(id)}: {portage.cargo_status(living_world,id)}"]
    loop id in rescue_aboard(living_world): notebook.live.push("{rescue_aboard_name(living_world, id)}: aboard, to be set ashore at a harbour")
    if notebook.open and (notebook.fresh or frame_number() % 30 == 0): notebook.standing = standing_lines(living_world)
    if t - folk_sync_t > 2.0:
        sync_folk(folks, living_world, towns)
        global folk_sync_t
        folk_sync_t = t
    step_sea_navigation(vessels,if render_quality.tier == 0: 32 else: 64)
    sync_canal_traffic(vessels,living_world)
    step_vessels(vessels,wind_now.dir*f32(wind_now.speed),dt,pc.state.position,pc.state.velocity)
    if vessel_mooring.vessel >= 0:
        point = vessel_mooring_point(vessels,vessel_mooring,pc.spec.span)
        if not pc.state.moored or point == none:
            vessel_mooring = VesselMooring(); rope.tied = false
            if pc.state.moored: unmoor(pc.state)
        else:
            pc.state.position = vec3(point!.x,point!.y+f32(pc.spec.float_height),point!.z)
            k = vessel_index(vessels,vessel_mooring.vessel)
            pc.state.velocity = vessels.ships[k].velocity
            spec = vessel_spec(vessels.ships[k].kind)
            right = vec3(f32(cos(vessels.ships[k].yaw)),0,f32(-sin(vessels.ships[k].yaw)))
            rope.anchor = point!-right*f32(vessel_mooring.side*(pc.spec.span*0.55+3.0))+vec3(0,f32(spec.deck),0)
    prepare_war_scene(living_world,vessels,battle,if me.mode==.aboard: pc.state.position else: me.pos)
    publish_vessel_targets(vessels,battle,vessel_bindings,if me.mode == .aboard: pc.state.position else: me.pos)
    battle.bullet_scale=bullet_scale
    pci=combat_index(battle,living_world.people[living_world.player].craft)
    if pci>=0:
        battle.actors[pci].spec=pc.spec
        configure_player_gun(battle.actors[pci],dbg.gun_choice,dbg.endless_ammunition)
        if (pc.state.moored or dbg.no_damage) and not battle.actors[pci].bailed:
            if pc.state.moored:sync_living_player(pc,living_world)
            battle.actors[pci].state=pc.state
            if dbg.no_damage:battle.actors[pci].fire=0;battle.actors[pci].fire_age=0
    update_traffic(traffic,living_world,traffic_scene,if me.mode == .free: free.pos else: if me.mode==.aboard:pc.state.position else:me.pos,t,dt,pc.state,towns,battle,
        (events:CombatEvent[]):
            combat_effect_events(combat_visual,events,if me.mode==.aboard:living_world.people[living_world.player].craft else:-1)
            listener_index=combat_index(battle,living_world.people[living_world.player].craft)
            listener=if listener_index>=0:battle.actors[listener_index].state.position else:pc.state.position
            combat_near_passes(combat_visual,battle,if me.mode==.aboard:living_world.people[living_world.player].craft else:-1,listener)
            if combat_audio.guns.len()>0:combat_audio_passes(combat_audio,combat_visual.whizzes)
            if combat_audio.guns.len()>0:combat_audio_events(combat_audio,events,listener,if me.mode==.aboard:living_world.people[living_world.player].craft else:-1)
        ,(craft: int,spec: CraftSpec,state: CraftState,previous: vec3) -> CraftState:
            result = state
            collide_vessels(vessels,spec,result,previous,craft)
            result
        ,ships=[loop ship in vessels.ships:if ship.health>0.2:AirShip(ship.id,ship.position,ship.velocity)]
        ,other_air=[loop p in air_events.pilots:AirContact(p.craft,p.state.position,p.state.velocity,p.capital,p.state.on_water,p.state.moored)]
    )
    if active_scenario!="":commit_scenario_aircraft(living_world,battle)
    receive_vessel_hits(vessels,battle,vessel_bindings)
    sync_workboat_vessels(vessels,vessel_bindings,living_world,dt)
    sync_far_vessels(vessels,living_world,if me.mode==.aboard: pc.state.position else: me.pos,if render_quality.tier==0: 6 else: 16,refresh=int(t*4)!=int((t-dt)*4))
    commit_war_scene(living_world,vessels,battle)
    ci=combat_index(battle,living_world.people[living_world.player].craft)
    if ci>=0:
        pc.state.damage=battle.actors[ci].state.damage
        refresh_damage(pc.spec,pc.state)
        if battle.actors[ci].bailed:pc.state=battle.actors[ci].state
    # Combat parts already supplied this tick's world condition; do not heal them through the
    # older nonlinear wear projection. Outside combat retain the existing service adapter.
    if ci<0 or (battle.actors[ci].last_attacker<0 and not battle.actors[ci].bailed):sync_living_player(pc,living_world)
    if me.mode==.aboard:pc.jolt=max(pc.jolt,combat_visual.hit)
    update_combat_view(combat_visual,battle,wind_now_vec(),dt,scene_camera())
    if env("AEGEAN_RUNTIME_TRACE")!=none and floor(t)!=floor(t-dt):
        print("RUNTIME t={t:.3} dt={dt:.4} ticks={traffic_scene.frame_ticks} tick={battle.tick} actors={battle.actors.len()} rounds={battle.rounds.len()} ribbons={combat_visual.trails.ribbons.len()} flame={combat_visual.flame.items.len()} mist={combat_visual.mist.items.len()} spray={spray_ps.items.len()} lookv={length(pc.look_v):.3} came={length(pc.cam_e):.3} camv={length(pc.cam_ev):.3} physics={battle.physics_steps}")
    if combat_audio.guns.len()>0:update_combat_audio(combat_audio,battle,scene_camera(),living_world.player)
    update_battle_radio(battle_radio,battle,living_world.player,audio_enabled and active_scenario=="strait" and me.mode==.aboard)
    update_folk(folks, living_world, towns, if me.mode==.free:free.pos else:if me.mode == .aboard: pc.state.position else: me.pos, dt)
    # A contact/bark event commits words once; drawing the bubble only reads them.
    if me.mode == .walking and ui == .none:
        k = nearest_folk(folks,me.pos,7.0)
        if k >= 0 and t-folks[k].line_t > 20.0:
            folks[k].line = passing_line(living_world,folks[k].person)
            folks[k].line_t = t
    update_air_events(air_events,living_world,craft_models,pc.state.position,me.mode==.aboard,other_air=[loop tr in traffic:if tr.visible:AirContact(tr.craft,tr.state.position,tr.state.velocity,tr.town,tr.state.on_water,tr.state.moored)])
    if let stage = capture_race: stage_capture_race(stage)
    if let stage = war_stage_pending:
        if living_world.far.populated and living_world.far.place_ids.len() > 6:
            global war_stage_pending
            war_stage_pending = none
            if stage == "board" or stage == "contract": living.advance_minutes(living_world,180)
            stage_capture_war(stage)
            global war_chart
            war_chart = WarChart()
            print("WAR STAGE at frame {frame_number()}")
    all_air_traffic=traffic+air_event_traffic(air_events,living_world,craft_models)+(if active_scenario!="":scenario_air_traffic(living_world,battle) else:[])
    # Relevance is refreshed at 2.5 Hz; selected moving bodies are followed every frame.
    if me.mode==.aboard:
        target_scan-=dt
        if target_scan<=0:
            refresh_targets(view_target,view_candidates(living_world,battle,all_air_traffic,vessels,pc.state.position,living_world.people[living_world.player].craft))
            target_scan=0.4
        if view_target.selected>=0:
            item=view_target.items[view_target.selected]
            if item.kind==0:
                ci=combat_index(battle,item.id)
                if ci>=0:item.position=combat_render_state(battle.actors[ci],battle.render_alpha).position
                else:
                    loop tr in all_air_traffic:if tr.craft==item.id:item.position=tr.state.position;break
            else if item.kind==2:
                vi=vessel_index(vessels,item.id)
                if vi>=0:item.position=vessels.ships[vi].position
            view_target.items[view_target.selected]=item
        if not show_chart and ui==.none and not notebook.open and not typing:
            if key_pressed(.tab):cycle_target(view_target)
            if key_pressed(.c):toggle_target(view_target)
            target_touch(view_target,pad.held.contains(.tab),dt)
        else:view_target.held=0;view_target.long_press=false
        eye=if pc.cockpit_view:cockpit_eye(craft_models[pc.model],pc.state) else:pc.cam_pos
        normal=if pc.cockpit_view:quat_rotate(pc.state.orientation,vec3(0,0,-1)) else:pc.look
        step_target_view(view_target,eye,normal,dt)
    else:view_target=TargetView();target_scan=0
    loop wakes.len()<all_air_traffic.len()+1:wakes.push(WakeTrail())
    update_air_view(air_visual,all_air_traffic,wind_now_vec(),if me.mode==.aboard:pc.state.position else:me.pos,dt)
    # skimming: fast within about a span of the water, the downwash churns it and throws spray
    water_under=f64(swell_at(craft_point(pc.state).x,craft_point(pc.state).z,t).x)
    gap = f64(pc.state.position.y) - pc.spec.float_height - water_under
    skim = if pc.state.on_water or pc.state.moored: 0.0 else: (1.0 - smoothstep(0.5, pc.spec.span * 0.6, gap)) * smoothstep(28.0, 60.0, f64(length(pc.state.velocity)) / pure_k(pc.spec))
    under = craft_offset(pc.state,vec3(-pc.state.velocity.x*0.15,f32(water_under+0.1)-pc.state.position.y,-pc.state.velocity.z*0.15))
    wake_step(wakes[0], under, pc.state.velocity, pc.state.on_water and not pc.state.moored, 1.6, t, skim)
    if skim > 0.1 and me.mode == .aboard: emit(spray_ps, under, int(1.0 + skim * 4.0), 3.0 + 6.0 * skim, rgba(0.96, 0.98, 1.0, f32(0.5 + 0.4 * skim)), 1.2, 0.5 + 0.6 * skim, 0.7, normalize(vec3(-pc.state.velocity.x, 30.0, -pc.state.velocity.z)))
    loop k in 0..all_air_traffic.len():
        tr = all_air_traffic[k]
        wake_step(wakes[k + 1], craft_point(tr.state), tr.state.velocity, tr.state.on_water and not tr.state.moored, if tr.kind == .heron: 1.4 else: 1.6, t)
    if trace and floor(t / 10.0) != floor((t - dt) / 10.0):
        print("living minute {living_world.minute}, tick {living_world.tick}")
        loop id in living_world.far.near_people:
            a=living_world.far.people[id];p=living_world.people[id]
            print("  resident {id} {p.name}: {a.anchor} at={p.pose.pos} target={a.target} blocked={a.blocked} commission={a.commission}")
        loop id,intent in living_world.daily_life:
            if intent.venue==.seat or intent.venue==.laundry or intent.venue==.oven: print("  domestic {id}: {intent.anchor} at={living_world.people[id].pose.pos} target={intent.target} arrived={intent.arrived} blocked={intent.blocked}")
        loop tr in traffic: print("  craft {tr.craft} / {tr.name}: {if tr.flying: (if tr.materialized: str(tr.plan.phase) else: "abstract") else: "moored"} -> {towns[tr.town].name} at {tr.state.position.x:.0} {tr.state.position.y:.0} {tr.state.position.z:.0}; {tr.why}")
        loop id, trip in living_world.trips:
            if trip.state == .arrived: print("  committed arrival {id}: {living_world.people[trip.actor].name} at {towns[trip.destination].name}")
    if judge_trace:
        global judge_frame
        judge_frame+=1
        if active_scenario!="" and judge_frame%60==0:
            shots=0;forming=0
            loop a in battle.actors:
                shots+=a.gun.shots
                if a.pilot.formation:forming+=1
            print("BATTLE seconds={t:.2} actors={battle.actors.len()} forming={forming} shots={shots} rounds={battle.rounds.len()}")
        if judge_frame%9==0:
            st=pc.state
            print("FLIGHT,{judge_frame},{t:.3},{st.position.x:.3},{st.position.y:.3},{st.position.z:.3},{st.velocity.x:.3},{st.velocity.y:.3},{st.velocity.z:.3},{asin(f64(forward(st).y)):.5},{st.throttle:.3},{st.on_water},{st.crashed},{st.hull_damage:.3}")
    spray_ps.update(dt)
    smoke_ps.update(dt)
    flying = me.mode == .aboard
    where = if flying: pc.state.position else: me.pos
    shore = abs(f64(surface_height(f64(where.x), f64(where.z)))) * 8.0 + (if flying: f64(where.y) * 2.0 else: 0.0)
    # (the sounds go by the speed as designed: true speed / the speed scale)
    update_audio(audio, dt, flying and not pc.state.moored, pc.state.throttle, if flying: pc.feedback.speed else: 0.0, shore, not flying, where, pc.kind, if flying: pc.feedback else: FlightFeedback())
    world_ambience.sound.enabled = dbg.snd_world
    ear = scene_camera()
    ambience_scene_step(world_ambience,living_world,vessels,towns,groves,ear,dt,flying,wind_now_vec(),if flying: pc.state.position else: none)
    life_audio.update_life_audio(life_sound,living_world,ear,t,dbg.snd_world[3],flying,
        (a: vec3,b: vec3) -> f64: ambience_obstruction(a,b,towns))
    if me.mode == .aboard and not cockpit_radio.muted:
        radio.radio_receive(cockpit_radio,dt,living_world.minute,pc.state.position,height)
        broadcast.radio_update_content(cockpit_radio,radio_bulletin,living_world)
    radio.radio_play(cockpit_radio,f64(living_world.tick)/60.0,me.mode == .aboard,
        not pc.state.moored,pc.state.throttle,audio_enabled)
    # the other aircraft's engines, heard from where their sound left them, Doppler and all
    hear_engines(hearing, [loop tr in all_air_traffic: EngineSource(tr.craft, tr.state.position, tr.state.velocity,
        if tr.flying and tr.state.throttle < 0.05: 0.7 else: f64(tr.state.throttle),
        not tr.state.moored and (tr.flying or tr.state.throttle > 0.02 or f64(length(tr.state.velocity)) > 0.5),
        engine_tone(tr.kind, tr.craft), true_speed(tr.spec, f64(length(tr.state.velocity))), voice = aircraft_profile(tr.kind).voice,point=craft_point(tr.state))], scene_camera(), if me.mode == .aboard: pc.state.velocity else: vec3(0, 0, 0), t,world_offset(world_point(scene_camera()),render_eye_low))
    set_tweaks(dbg.tweaks)
    set_options(dbg.opts)
    audio.air_on = dbg.snd_air
    audio.cloth_on = dbg.snd_cloth
    audio.frame_on = dbg.snd_frame
    if flying: airframe_sounds(audio, true_speed(pc.spec, f64(length(pc.state.velocity - wind_now_vec()))), if pc.state.on_water: 1.0 else: pc.load, true_speed(pc.spec, f64(length(pc.state.velocity - wind_now_vec()))), dt, pc.feedback.glide)
    else: airframe_sounds(audio, 0.0, 1.0, if me.mode == .walking: wind_now.speed else: 0.0, dt)
    # Nearby meadow geometry follows walking and low flight.
    global grass_actor, grass_contact_radius, grass_airflow
    grass_actor = if me.mode == .aboard: pc.state.position else: me.pos
    grass_contact_radius = if me.mode == .aboard: f32(pc.spec.span*0.7) else: 1.2
    grass_airflow = vec3(0,-1,0)
    if me.mode == .aboard:
        direction = normalize(forward(pc.state).xz)
        grass_airflow = vec3(direction,f32(clamp(pc.state.throttle*(1.0-pc.state.engine_damage)+f64(length(pc.state.velocity))*0.006,0.0,1.3)))
    if (me.mode == .walking or (me.mode == .aboard and f64(grass_actor.y)-surface_height(f64(grass_actor.x),f64(grass_actor.z))<25.0)) and (not grass.built or length(grass.center.xz - grass_actor.xz) > 12.0 or grass.road_stamp!=grass_road_stamp(grass.center.xz)):
        global grass
        grass = build_grass(towns, grass_actor)

# ---------------- draw ----------------

craft_matrix = (m: Moored) -> mat4:
    bob = sin(t * 1.3 + f64(m.pos.x)) * 0.12
    roll = sin(t * 0.9 + f64(m.pos.z)) * 0.03
    translation(m.pos + vec3(0, f32(2.1 + bob), 0)) * rotation_y(m.yaw) * rotation_z(roll)

# where the player's aircraft is drawn: riding the swell when moored, driven under in a plunge
pc_at = () -> mat4: translation(vec3(0, f32(plunge), 0)) * (if pc.state.moored: afloat_transform(craft_transform(pc),t) else: craft_transform(pc))

draw_world = (L: Light):
    draw_custom((): begin_cloud_depth())
    draw_custom(():
        bow = transform_point(afloat_transform(craft_transform(pc),t), vec3(1.4, -1.9, -2.6))
        draw_rope(rope, pc.state.moored, bow, L, t))
    draw_custom((): draw_sky(L, t))
    draw_custom((): draw_far_sea(depth_tex, L, t, wind_now))
    draw_custom(():
        prepare_town_view(towns,scene_camera())
        draw_river_occlusion(depth_tex,L,t)
        draw_ground(L, t)
        draw_world_terrain(L, t)
    )
    draw_custom(():
        zone("towns")
        draw_world_towns(towns, L, t)
        draw_towns(towns, L, t)
        if me.mode==.walking: trace_walk_precision(walker_point,follow,follow_frame,towns)
        zone_end())
    cam_now = scene_camera()
    draw_custom(():
        zone("ships")
        prepare_vessel_view(vessel_view,vessels,cam_now,t,wind_now.dir*f32(wind_now.speed))
        draw_vessels(vessel_view,L,t)
        # and those tied up along the quays, riding the swell too
        loop tw in towns:
            if f64(length(tw.center - cam_now)) > 6000.0: continue
            loop b in tw.boats: draw(obj_sh, b.mesh, obj_params(L, t, afloat_transform(translation(b.at),t)))
        zone_end()
    )
    draw_custom((): draw_birds(bird_mesh, flocks, L, t))
    draw_custom(():
        draw_groves(tree_meshes, groves, L, t)
        draw_world_groves(tree_meshes,L,t))
    draw_custom(():
        loop m in moored:
            cm = craft_models[m.model]
            at = craft_matrix(m)
            draw(obj_sh, cm.body, obj_params(L, t, at))
            draw_craft_props(cm, L, t, at, 0.4)
            draw_craft_gear(cm, L, t, at)
        draw_folk(folks, L, t)
        life_view.draw_life(living_world,life_meshes,L,t)
        cargo_view.draw_cargo(living_world,cargo_meshes,L,t)
        loop k in 0..board_spots.len():
            tw = towns[k]
            draw(obj_sh, board_mesh, obj_params(L, t, translation(board_spots[k]) * rotation_y(atan2(f64(tw.out.x), f64(tw.out.y)))))
        loop w in walkers:
            if length(w.pos - scene_camera()) < 600.0: draw_figure(w.fig, w.pos, w.yaw, w.phase, if w.wait > 0.0: 0.0 else: 0.8, L, t)
        if me.mode == .walking: draw_figure(me_fig, me.pos, me.yaw, me.phase, me.stride, L, t, carrying=holding_cargo() >= 0,offset=world_residual(walker_point))
        draw_traffic(all_air_traffic,craft_models,L,t,battle,1800)
        draw_air_meets(air_meet_view,air_events,L,t)
        draw_air_far(air_visual,all_air_traffic,L,t,battle)
        ci=combat_index(battle,living_world.people[living_world.player].craft)
        left=ci>=0 and battle.actors[ci].bailed
        draw_combat_aircraft(combat_visual,battle,craft_models,L,t,if left:-1 else:living_world.people[living_world.player].craft)
        pm = craft_models[pc.model]
        at = pc_at()
        if not left:
            if me.mode==.aboard and pc.cockpit_view:draw_cockpit_airframe(pm,pc.state,at,L,t,pc.prop_angle,prop_rotation_speed(pc.state,pc.feedback.speed))
            else:
                local_at=at;local_at[3]=vec4(0,plunge,0,1)
                anchor=craft_point(pc.state)
                if pc.state.moored:
                    anchor=world_offset(anchor,at[3].xyz-pc.state.position)
                    local_at[3]=vec4(0,0,0,1)
                draw_craft_parts(pm,pc.state.damage,local_at,L,t,pc.prop_angle,airframe(pc),pc.state.gear,anchor,prop_speed=prop_rotation_speed(pc.state,pc.feedback.speed),prop_key=living_world.people[living_world.player].craft)
            draw_debris(pm,pc.state.damage,L,t)
            if ci>=0:draw_player_hit_marks(combat_visual,battle.actors[ci],at,L,t,me.mode==.aboard and pc.cockpit_view)
            if me.mode==.aboard and pc.cockpit_view:draw_cockpit(cockpit_model,pm,pc.spec,pc.state,at,L,t,pc.last,bullet_scale,pc.instruments,cockpit_radio.khz,not cockpit_radio.muted,cockpit_radio.strength,pc.prop_angle,prop_rotation_speed(pc.state,pc.feedback.speed),living_world.people[living_world.player].craft)
        if me.mode == .aboard and not pc.cockpit_view: draw_figure_at(me_fig, at * translation(pm.cockpit - vec3(0, 1.55, 0)), 0.0, 0.0, L, t, seated = true,offset=world_residual(craft_point(pc.state)))
        if me.mode != .free or length(scene_camera() - grass.center) < 300.0: draw_grass(tuft, grass, L, t)
    )
    if legacy_clouds: draw_custom((): draw_clouds(puff_mesh,puffs,L,WorldPoint(wind_drift(wind_now).x*0.35,0,wind_drift(wind_now).z*0.35),t))
    # shadows of the aircraft near the camera: on the sea, drawn by the sea itself; on land, flattened meshes
    sea_sh = SeaShadows()
    cam = scene_camera()
    land: (CraftState, CraftModel)[]
    loop k in 0..all_air_traffic.len() + 1:
        st = if k == 0: pc.state else: all_air_traffic[k - 1].state
        cm = if k == 0: craft_models[pc.model] else: craft_models[all_air_traffic[k - 1].model]
        if length(st.position - cam) > 1500.0: continue
        sd = normalize(L.sun_dir)
        if sd.y < 0.08: continue
        under = st.position - sd * f32(f64(st.position.y) / max(f64(sd.y), 0.2))
        g = surface_height(f64(under.x), f64(under.z))
        hgt = f64(st.position.y) - max(g, 0.0)
        a = 0.55 * (1.0 - smoothstep(60.0, 420.0, hgt)) * smoothstep(0.08, 0.2, f64(sd.y))
        if g > 0.3:
            land.push((st, cm))
            continue
        m = translation(st.position) * quat_to_mat4(st.orientation)
        loop j in 0..cm.shade.len() / 2: add_sea_shadow(sea_sh, m, cm.shade[j * 2], cm.shade[j * 2 + 1], L.sun_dir, a)
    draw_custom((): draw_sea(sea_mesh, depth_tex, L, t, wind_now, if me.mode == .aboard: pc.state.velocity else: vec3(0, 0, 0), sea_sh), transparent = true)
    draw_custom((): draw_rivers(depth_tex,L,t,if me.mode==.aboard:pc.state.velocity else:vec3(0,0,0)),transparent=true)
    draw_custom(():draw_river_banks(L,t);draw_canal(L,t))
    draw_custom(():
        loop sc in land:
            st, cm = sc
            sd = normalize(L.sun_dir)
            g0 = max(surface_height(f64(st.position.x), f64(st.position.z)), 0.0)
            under = st.position - sd * f32((f64(st.position.y) - g0) / max(f64(sd.y), 0.2))
            g = max(surface_height(f64(under.x), f64(under.z)), 0.0)
            draw_curved_shadow(cm.body, translation(st.position) * quat_to_mat4(st.orientation), g + 0.4, f64(st.position.y) - g, L)
    , transparent = true)
    if env("AEGEAN_NOWAKE") == none:
        draw_custom((): draw_wakes(wakes, L, t), transparent = true)
        draw_custom((): draw_vessel_wakes(vessel_view,L,t), transparent = true)
    draw_custom((): draw_vessel_smoke(vessel_view,L,t), transparent = true)
    if me.mode == .aboard: draw_custom((): draw_flight_effects(pc,craft_models[pc.model],pc_at(),L,t),transparent=true)
    draw_custom((): draw_prop_discs(L),transparent=true)
    draw_curved_particles(spray_ps, false)
    draw_curved_particles(smoke_ps, false)
    draw_curved_particles(dust_ps, false)
    draw_combat_particles(combat_visual,battle)
    draw_air_view(air_visual,all_air_traffic,L,t)
    # (the cloth streams out by the drawn speed, as soon as the takeoff run gets going, and its
    # flutter builds all the way to the drawn top speed in a dive, so it doesn't saturate early; a
    # trial (Tweaks) has it by the true speed instead)
    vis = f64(length(pc.state.velocity))
    cloth_vel = if tweaks.cloth_true: pc.state.velocity * f32(if vis > 0.1: true_speed(pc.spec, vis) / vis else: 1.0) else: pc.state.velocity
    cloth_top = if tweaks.cloth_true: 95.0 else: max(1.3 * pc.spec.max_speed, 95.0)
    draw_custom((): draw_cloths(cloth_mesh, cloths_for(pc.model), pc_at(), wind_now_vec() - cloth_vel, L, t, cloth_top))
    # (the pilot's scarf, on him wherever he is: in the cockpit in the aircraft's wind, ashore in
    # the wind and his own walking)
    if me.mode == .aboard and not pc.cockpit_view:
        seat = pc_at() * translation(craft_models[pc.model].cockpit - vec3(0, 1.55, 0)) * scaling(f64(me_fig.height))
        draw_custom((): draw_cloths(scarf_mesh, pilot_scarf(), seat, wind_now_vec() - cloth_vel, L, t, cloth_top))
    else if me.mode == .walking:
        fwd = vec3(f32(sin(me.yaw)), 0, f32(cos(me.yaw)))
        body = translation(me.pos) * rotation_y(me.yaw + PI) * scaling(f64(me_fig.height))
        draw_custom((): draw_cloths(scarf_mesh, pilot_scarf(0.75), body, (wind_now_vec() - fwd * f32(me.stride * 3.0)) * 2.2, L, t,offset=world_residual(walker_point)))

    if not legacy_clouds:
        draw_custom((): draw_cloud_volumes(world_clouds(scene_camera(),WorldPoint(wind_drift(wind_now).x*0.35,0,wind_drift(wind_now).z*0.35)),L),transparent=true)
    draw_custom((): draw_trails(vapor_trails,L,t),transparent=true)
    draw_custom((): draw_rain(L,if me.mode==.aboard: pc.state.velocity else: vec3(0,0,0)),transparent=true)

draw = ():
    global render_eye_low
    render_eye_low=vec3(0,0,0)
    L = weather_light(light_at(hour,f64(living_world.minute)/1440.0),if me.mode == .free: free.pos else: if me.mode == .aboard: pc.state.position else: me.pos)
    if env("AEGEAN_CLEAR_AIR") != none: L.fog_density = 0.0
    clear(BLACK)
    sun(L.sun_dir, L.sun, 0.0)
    hide_sky()
    fog(L.haze, L.fog_density, 0.0012)
    post_effects(0.35, 0.85, 0.22, 1.08)
    match me.mode:
        .free: render_camera(free.pos, forward(free), 62.0, 1.0, world_far(f64(free.pos.y)))
        .aboard:
            if pc.cockpit_view:place_cockpit_camera(craft_models[pc.model],pc.state,pc.look_yaw,pc.look_pitch,t,pc.jolt,bullet_scale,combat_visual.recoil,view_target.bearing,view_target.weight,pc_at())
            else:place_chase_camera(pc,t,view_target.bearing,view_target.weight)
        .descent:place_descent_camera(descent_camera,world_far(f64(me.pos.y)))
        _: place_local_follow(follow,follow_frame,58.0,0.3,world_far(f64(me.pos.y)))
    if env("AEGEAN_TARGET_FRAMES")!=none and me.mode==.aboard:
        draw_custom(():
            origin=render_origin(scene_camera());vp=render_view_proj(origin)
            clip=vp*vec4(world_local(craft_point(pc.state),origin),1)
            ahead=dot(view_target.bearing,forward(pc.state))
            clearance=f64(scene_camera().y)-f64(swell_at(f64(scene_camera().x)+f64(render_eye_low.x),f64(scene_camera().z)+f64(render_eye_low.z),t).x)
            print("TARGET {frame_number()} {view_target.selected} {view_target.weight:.5} {ahead:.5} {view_target.bearing.y:.5} {clip.x/clip.w:.5} {clip.y/clip.w:.5} {clearance:.4}")
        )
    if let view=judge_camera:
        delta=if me.mode==.aboard:pc.state.position-judge_origin else:vec3(0,0,0)
        camera3d(view.eye+delta,view.target+delta,62.0,0.1,world_far(f64(view.eye.y+delta.y)))
    if me.mode == .aboard:
        pp = pc.state.position
        hgt = f64(pp.y) - pc.spec.float_height - max(surface_height(f64(pp.x), f64(pp.z)), 0.0)
        set_scene_flow(pc.state.velocity, hgt)
        # (the stretch trial: as strong as the near boost, up to 4.5 times, growing with the speed,
        # reaching farther the higher one flies)
        sp = f64(length(vec3(pc.state.velocity.x, 0, pc.state.velocity.z)))
        k = if speed_mode == 3: 1.0 + (min(near_boost, 4.5) - 1.0) * clamp((sp - 10.0) / 75.0, 0.0, 1.0) else: 1.0
        set_scene_warp(pp, pc.state.velocity, k, 400.0 + 3.0 * max(hgt, 0.0))
    else:
        set_scene_flow(vec3(0, 0, 0), 0.0)
        set_scene_warp(vec3(0, 0, 0), vec3(0, 0, 0), 1.0, 400.0)
    draw_world(L)
    if me.mode == .aboard: draw_flight_lens(pc,if scene_camera().y < weather_here.ceiling+weather_here.storm*5200.0: f64(weather_here.rain) else: 0.0,t)
    # Upscale the finished scene; overlays retain their existing logical coordinates.
    full_resolution()
    set_font(fonts.ui)
    text("{int(hour):02}:{int((hour - floor(hour)) * 60.0):02}", vec2(f32(screen_width() - 80), 18), 22, rgba(1, 1, 1, 0.85), shadow = rgba(0, 0, 0, 0.4))
    set_font()
    # money
    set_font(fonts.ui)
    text("{player_cents() / 100} lire", vec2(f32(screen_width() - 120), 46), 20, rgba(1, 0.95, 0.8, 0.85), shadow = rgba(0, 0, 0, 0.4))
    set_font()
    # the people about: names over those near, a line from whoever is nearest
    if me.mode == .walking and ui == .none:
        k = nearest_folk(folks, me.pos, 7.0)
        loop i in 0..folks.len():
            f = folks[i]
            if not f.shown or i == k: continue
            d = f64(length(f.pos - me.pos))
            if d < 16.0: name_tag(fonts, f.pos + vec3(0, 1.7, 0), living_world.people[f.person].name, d)
        if k >= 0:
            d = f64(length(folks[k].pos - me.pos))
            speech_bubble(fonts, folks[k].pos + vec3(0, 1.7, 0), living_world.people[folks[k].person].name, folks[k].line, d, 8.0)
    # Deterministic typography capture, using the real projected speech widget.
    if env("AEGEAN_CAPTURE_PANEL") == "speech":
        speech_bubble(fonts, me.pos + vec3(0,1.7,0), "Nikos", "The fishing boats are back in the harbour.", 2.0, 8.0)
    if me.mode == .walking: cargo_view.draw_cargo_targets(living_world)
    match me.mode:
        .walking:
            if ui != .none: pass
            else if holding_cargo() >= 0:
                point = portage.cargo_loading_spot(living_world,living_world.people[living_world.player].craft)
                prompt_card(fonts,if point != none and length(me.pos-point!) < 4: "F  put the crate into the hold" else: "F  put down or hand over the crate")
            else if near_job_cargo() >= 0: prompt_card(fonts,"F  pick up {cargo_view.cargo_label(living_world,living_world.cargo[near_job_cargo()])}")
            else if rescue_act == 2: prompt_card(fonts, rescue_prompt())
            else if near_own_craft(): prompt_card(fonts, "F  climb aboard your {CRAFT_NAMES[int(pc.kind)]}")
            else if near_map_find() >= 0: prompt_card(fonts, "F  pick up the {map_title(near_map_find())}")
            else if near_board() >= 0: prompt_card(fonts, "F  read the notices")
            else if nearest_folk(folks, me.pos, 3.5) >= 0: prompt_card(fonts, "T  talk to {living_world.people[folks[nearest_folk(folks, me.pos, 3.5)].person].name}")
            else if map_shop_here() != "": prompt_card(fonts, map_shop_prompt(map_shop_here()))
            else if race_offer_here() >= 0: prompt_card(fonts, race_offer_text(air_events, living_world, race_offer_here()))
            else if pc.state.moored:
                if let a = mooring_anchor():
                    if f64(length(vec2(a.x - me.pos.x, a.z - me.pos.z))) < 5.0: prompt_card(fonts, "hold F  haul in the line")
        .aboard:
            if pc.state.crashed or pc.state.capsized: prompt_card(fonts, "Wrecked.  R  to be towed home", 180.0)
            else if pc.state.beached: prompt_card(fonts, "Run aground.  R  to be towed home", 180.0)
            else if pc.state.moored: prompt_card(fonts, "F  step onto the quay      Shift  open the throttle", 180.0)
            else if rescue_act == 1: prompt_card(fonts, rescue_prompt(), 180.0)
            else if mooring_spot(pc, towns) != none: prompt_card(fonts, "F  moor here", 180.0)
            else if race_offer_here() >= 0: prompt_card(fonts, race_offer_text(air_events, living_world, race_offer_here()), 180.0)
        .descent: pass
        .free: text("{free.pos.x:.0} {free.pos.y:.0} {free.pos.z:.0}", vec2(16, 16), 18, rgba(1, 1, 1, 0.7))
    if me.mode == .aboard:
        aim_marks(pc,not pc.cockpit_view)
        if pc.cockpit_view:
            if let radio_hit=cockpit_radio_rect(craft_models[pc.model],pc_at(),craft_point(pc.state)):tap_card(radio_hit,.f9)
        st = pc.state
        # (the speedometer reads the true speed)
        if show_chart: pass
        else if not pc.cockpit_view and (tweaks.true_curve or tweaks.pure_scale): instruments(fonts, true_speed(pc.spec, f64(length(st.velocity))), f64(st.position.y) - pc.spec.float_height, st.throttle, pc.throttle, st.fuel / pc.spec.fuel_capacity, (heading(st) + TAU) % TAU, pc.spec.stall_speed, pc.spec.max_speed / pc.spec.handling_scale,pc.instruments)
        else if not pc.cockpit_view: instruments(fonts, f64(length(st.velocity)), f64(st.position.y) - pc.spec.float_height, st.throttle, pc.throttle, st.fuel / pc.spec.fuel_capacity, (heading(st) + TAU) % TAU, pc.spec.stall_speed, pc.spec.max_speed,pc.instruments)
    if (me.mode == .aboard or me.mode == .walking) and not show_chart and ui == .none and not notebook.open:
        race_k = race_shown(air_events, living_world)
        if race_k >= 0: draw_race_hud(fonts, air_events, living_world, race_k, if me.mode == .aboard: pc.state.position else: me.pos, me.mode == .aboard)
        if me.mode == .aboard:
            marks = rescue_marks(rescue, pc.state.position)
            loop k in 0..min(marks.len(), 3): draw_rescue_mark(fonts, marks[k].pos, pc.state.position, survivor_name(living_world, marks[k]))
            # (a claimed contract's packet or survivor: where to collect it, then where it is to go)
            if packets_now.len() > 0: draw_rescue_mark(fonts, packets_now[0].pos, pc.state.position, packets_now[0].label, rgba(0.78, 0.86, 1.0, 0.95))
    if me.mode != .free and not paused and not judge_ready and active_scenario=="": title_card(fonts, t)
    if (me.mode == .aboard or me.mode == .walking) and not paused and not show_chart and ui == .none: draw_battle_card(fonts, battle_card, t)
    if me.mode==.aboard and not paused and not show_chart and ui==.none and not notebook.open:draw_view_target(view_target,fonts)
    if vdown(.h): controls_card(fonts, me.mode == .aboard)
    else if t > 7.5 and t < 22.0 and not judge_ready and active_scenario=="": keys_hint(fonts)
    draw_ui()
    notebook_panel(fonts, notebook, clock_text(living_world, living_world.minute))
    if paused and not dbg.picking: rect(0, 0, f64(screen_width()), f64(screen_height()), rgba(0.03, 0.05, 0.08, 0.25))
    if dbg.open:
        was = debug_view()
        v = was
        debug_apply(was, v, debug_panel(dbg, v, [loop tw in towns: tw.name], CRAFT_NAMES))
    if dbg.picking and show_chart: prompt_card(fonts, "Click where to go  ({int(dbg.altitude)} m)", 60.0)
    if t < toast_until: prompt_card(fonts, toast, 260.0)
    if t < map_card_until and not show_chart and ui != .maps: prompt_card(fonts, map_card, 200.0)
    if not show_chart and ui == .none and not notebook.open: draw_rescue_card(fonts, rescue, t)
    if t < radio_card_until and me.mode == .aboard: prompt_card(fonts, radio_label(), if pc.cockpit_view: 120.0 else: 320.0)
    if show_chart:
        facing = if me.mode == .aboard: heading(pc.state) else: PI - me.yaw
        draw_chart(chart, towns, if me.mode == .aboard: pc.state.position else: me.pos, facing, hour,
            [loop tr in traffic: vec4(tr.state.position.x, tr.state.position.y, tr.state.position.z, f32(heading(tr.state)))],vessels.ships,vessels.lanes,if me.mode==.aboard:craft_point(pc.state) else:if me.mode==.walking:walker_point else:world_point(me.pos),[loop tr in traffic:craft_point(tr.state)])
        cr = chart_rect()
        if chart_sheets != none:
            global war_layer_on
            if war_layer_on: draw_war_layer(cr, war_chart)
            draw_contract_marks(cr, packets_now)
            set_font(fonts.ui)
            war_layer_on = war_layer_button(cr, war_layer_on, war_marks_charted(war_chart))
            set_font()
        # (the pocket compass, set down on the map's corner)
        rr = min(70.0, f64(screen_width()) * 0.11)
        pocket_compass(fonts, vec2(f32(cr.x + cr.w - rr * 0.6), f32(cr.y + cr.h - rr * 0.6)), rr, facing)
        if let sheets = chart_sheets:
            set_font(fonts.ui)
            picked = chart_sheet_list(sheets)
            set_font()
            if picked >= -1:
                global chart_focus
                chart_focus = picked
                if picked >= 0: _ = living.select_map(living_world,picked,living_world.player)
    # (on a touch screen: the stick and the buttons, over everything)
    draw_pad()
    quality_next_frame()
    if let directory=env("AEGEAN_TARGET_FRAMES"):
        if frame_number()%6==0:save_png("{directory}/{frame_number()}.png",screenshot())
    if let directory=env("AEGEAN_ATMOS_FRAMES"):
        if frame_number() in [2,360,780,1200,1800] or frame_number()%4==0 and (frame_number()<=120 or frame_number()>=720 and frame_number()<=960): save_png("{directory}/{frame_number()}.png",screenshot())
    if capture_audio:
        global captured_audio
        if frame_number()<=1800: captured_audio.extend(__mix_buf)
        if frame_number()==1800:
            if let path=env("AEGEAN_AUDIO_CAPTURE"): assert(save_wav(path,Sound(captured_audio)))
    if let directory=env("AEGEAN_WALK_FRAMES"):
        frame=frame_number()
        if frame>=120 and frame<=180 and frame%2==0: save_png("{directory}/{frame}.png",screenshot())

# the panels open over the scene: a conversation, a board, a ledger
draw_ui = ():
    global ui, ui_line, ui_news, ui_place, ui_job, ui_turn, ui_mission, presentation
    match ui:
        .talk:
            if ui_folk < 0 or ui_folk >= folks.len():
                ui = .none
                return
            f = folks[ui_folk]
            p = living_world.people[f.person]
            merchant = (p.occupation == .merchant or p.occupation == .innkeeper or p.occupation == .hotelier or p.occupation == .quartermaster) and f.place>=0 and f.place<living_world.places.len()
            # errands first: work they posted (offered to them in person), cargo one has brought them
            offers: int[]
            offer_choices: lt.CarriageChoice[]
            handovers: int[]
            handover_choices: lt.CarriageChoice[]
            answers: str[]
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.poster == f.person and j.state == .open and j.origin == f.place:
                    offers.push(id)
                    offer_choices.push(if j.delivery_mode == .foot: lt.CarriageChoice.player else: lt.CarriageChoice.automatic)
                    answers.push(if j.delivery_mode == .foot: "I'll carry {job_cargo(id)} across town." else: "Fly {job_cargo(id)} to {SETTLEMENTS[j.destination].name}; arrange carrying.")
                    if j.delivery_mode == .aircraft and j.cargo_mode != .none:
                        offers.push(id); offer_choices.push(.porter)
                        answers.push("To {SETTLEMENTS[j.destination].name}: please hire a porter for {job_cargo(id)}.")
                        offers.push(id); offer_choices.push(.player)
                        answers.push("To {SETTLEMENTS[j.destination].name}: I'll fetch and load {job_cargo(id)}.")
            loop id in living_world.active_jobs:
                j = living_world.jobs[id]
                if j.state == .claimed and j.carrier == living_world.player and (j.loaded or j.delivery_mode == .foot) and j.destination == f.place and recipient_of(id) == f.person:
                    handovers.push(id); handover_choices.push(.automatic)
                    answers.push("I've brought {job_cargo(id)} from {living_world.people[j.poster].name}.")
                    if j.delivery_mode == .aircraft and j.cargo_mode != .none:
                        handovers.push(id); handover_choices.push(.player)
                        answers.push("I'll carry {job_cargo(id)} from the aircraft to your door myself.")
            nerr = answers.len()
            # then the conversation itself: answers to what they just asked, the things one can
            # bring up with them (their work, the news, the weather, the market, people, home...),
            # work and trade, and leaving. When they've had enough, only leaving.
            replies = if ui_turn.exhausted: [] else: ui_turn.replies
            loop r in replies: answers.push("\"{r.label}\"")
            nrep = answers.len()
            topics = if ui_turn.exhausted: [] else: [loop o in living.talk_topics(living_world, f.person, living_world.player): if o.topic != .greeting and o.topic != .farewell: o]
            if topics.len() > 5: topics = [loop k in 0..5: topics[k]]
            loop o in topics: answers.push(o.label)
            ntop = answers.len()
            answers.push("Any work going?")
            if merchant: answers.push("Let's trade.")
            sells_maps = map_shop_of(f.person)
            if sells_maps != "": answers.push("What maps have you?")
            answers.push("Goodbye.")
            role = "{p.occupation}".replace("_", " ")
            c = conversation_grouped(fonts, p.name, "{role}, {living.place_name(living_world,f.place)}", ui_line, [loop k in 0..nrep: answers[k]], [loop k in nrep..ntop: answers[k]], [loop k in ntop..answers.len(): answers[k]])
            if vpressed(.escape): c = answers.len() - 1
            if c >= 0 and c < offers.len():
                id = offers[c]
                choice = offer_choices[c]
                ui_line = agree_cargo_job(id,choice)
            else if c >= offers.len() and c < nerr:
                id = handovers[c - offers.len()]
                before = player_cents()
                choice = handover_choices[c-offers.len()]
                if choice == .player:
                    portage.choose_collection(living_world,id,living_world.player,.player)
                    ui_line = "Please bring it to the marked delivery point. " + portage.cargo_status(living_world,id)
                else if living.deliver_job(living_world, id, living_world.player):
                    ui_line = "Thank you. That's what was promised: {(player_cents() - before) / 100} lire."
                else: ui_line = portage.cargo_status(living_world,id)
            else if c >= nerr and c < nrep:
                ui_turn = living.reply(living_world, f.person, replies[c - nerr].reply, living_world.player)
                ui_line = turn_text(ui_turn)
            else if c >= nrep and c < ntop:
                ui_turn = living.talk(living_world, f.person, topics[c - nrep].topic, living_world.player)
                ui_line = turn_text(ui_turn)
                if topics[c - nrep].topic == .news: ui_news += 1
            else if c >= 0:
              c -= ntop
              if c == 0:
                  ui_turn = living.ask_for_work(living_world,f.person,living_world.player)
                  ui_line = turn_text(ui_turn)
              else if merchant and c == 1:
                  ui_place = f.place
                  ui = .trade
              else if sells_maps != "" and c == (if merchant: 2 else: 1): open_map_counter(sells_maps)
              else if c >= 0:
                  # (a parting word, left hanging over the quay as one walks off)
                  bye = living.talk(living_world, f.person, .farewell, living_world.player)
                  if bye.text != "": say_toast("{p.name}: {bye.text}")
                  ui = .none
        .board:
            yesterday: str[]
            loop r in living_world.places[ui_place].yesterday:
                l = reason_line(living_world, r)
                if l != "": yesterday.push(l)
            district = core_district(living_world, ui_place)
            res = notice_board(fonts, SETTLEMENTS[ui_place].name, military_notices(living_world, district, living_world.player, presentation.declined_missions, (m: int) -> str: clock_text(living_world, m)) + job_notices(living_world, ui_place) + air_meet_notices(air_events, living_world, me.pos, (m: int) -> str: clock_text(living_world, m)), yesterday)
            if mission_of_notice(res.take) >= 0:
                ui_mission = mission_of_notice(res.take)
                if let m = find_mission(living_world, ui_mission): ui_line = "{m.why} Due {clock_text(living_world, m.deadline)}. {contract_status(living_world, m)}"
                ui = .contract
            if res.take >= 0:
                # Keep the notice, then review its actual handling terms before agreeing.
                j = living_world.jobs[res.take]
                pin_notice(notebook, res.take, j.poster, "{job_cargo(res.take)} to {SETTLEMENTS[j.destination].name}".replace("the ", ""), "{living_world.people[j.poster].name} at {SETTLEMENTS[j.origin].name} wants it there by {clock_text(living_world, j.due_minute)}. {j.reward_cents / 100} lire.", clock_text(living_world, living_world.minute))
                ui_job = res.take
                ui_line = "{living_world.people[j.poster].name} offers {f64(j.reward_cents)/100.0:.2} lire. The goods are at their existing warehouse spot. Who will carry them?"
                ui = .handling
            if res.closed: ui = .none
        .contract:
            if let m = find_mission(living_world, ui_mission):
                answers = contract_answers(living_world, m, living_world.player)
                c = conversation(fonts, contract_title(living_world, m), "{SETTLEMENTS[ui_place].name} office", ui_line, answers.0)
                code = if c >= 0: answers.1[c] else: -1
                if code == 1:
                    presentation.declined_missions[m.id] = true
                    ui = .board
                else if code == 6 or vpressed(.escape): ui = .board
                else if code >= 0:
                    said = contract_act(living_world, m.id, code, living_world.player)
                    if code == 0 and living_world.war.missions[m.id].state == .claimed:
                        log_note(notebook, "Signed for {contract_title(living_world, m).lower()}: {m.why}", clock_text(living_world, living_world.minute))
                    ui_line = said
                    if let after = find_mission(living_world, m.id): ui_line = "{said} {contract_status(living_world, after)}"
            else: ui = .board
        .handling:
            if ui_job < 0 or not (ui_job in living_world.jobs): ui = .board; return
            j = living_world.jobs[ui_job]
            answers: str[]; choices: lt.CarriageChoice[]
            if j.state == .open:
                if j.delivery_mode == .foot:
                    answers.push("I'll carry it on foot."); choices.push(.player)
                else:
                    answers.push("Arrange the carrying with the sender."); choices.push(.automatic)
                    if j.cargo_mode != .none:
                        answers.push("The sender hires a dock porter."); choices.push(.porter)
                        answers.push("I'll fetch and load it myself."); choices.push(.player)
            answers.push("Back to the board.")
            c = conversation(fonts,"{living_world.people[j.poster].name}'s notice",SETTLEMENTS[j.origin].name,ui_line,answers)
            if c >= 0 and c < choices.len(): ui_line = agree_cargo_job(ui_job,choices[c])
            else if c >= 0 or vpressed(.escape): ui = .board
        .trade:
            w = living_world
            m = w.places[ui_place].market
            c = w.people[w.player].craft
            rows: GoodRow[]
            goods: int[]
            loop g in 0..w.goods.len():
                if w.goods[g].illegal and ui_place != 5: continue
                pr = m.price_cents[g]
                have = w.people[w.player].pocket.qty[g] / 1000
                rows.push(GoodRow(w.goods[g].key, "load", pr * 102 / 10000, pr * 98 / 10000, m.inventory.qty[g] / 1000, have))
                goods.push(g)
            used = 0
            if c >= 0:
                loop g in 0..w.goods.len(): used += w.aircraft[c].cargo.qty[g] / 1000
            res = ledger(fonts, w.people[folks[ui_folk].person].name, SETTLEMENTS[ui_place].name, rows, player_cents() / 100, used, 8)
            if res.row >= 0:
                ok = if res.dir > 0: living.buy(living_world, ui_place, goods[res.row], 1000, living_world.player) else: living.sell(living_world, ui_place, goods[res.row], 1000, living_world.player)
                if not ok: say_toast("No: not enough money or stock. Bring your goods ashore to sell them.")
                else if res.dir > 0: say_toast("Yours at the warehouse. Carry the crate aboard with F.")
            if res.closed: ui = .none
        .maps:
            near = [loop s in living.map_sellers(living_world, living_world.player): if s.id == ui_shop: s]
            if near.len() == 0:
                ui = .none
                return
            shop = near[0]
            res = map_counter(fonts, shop.name, shop.kind, living.place_name(living_world, shop.place), map_counter_rows(living_world, ui_shop, living_world.player), player_cents(), if t < map_card_until: map_card.replace("      M  the chart", "") else: "")
            now = clock_text(living_world, living_world.minute)
            if res.buy >= 0:
                bought = living.buy_map(living_world, res.buy, living_world.player)
                if bought.ok:
                    log_note(notebook, "Bought the {map_title(bought.copy)} at {shop.name}, {lire_text(bought.cents)}.", now)
                    notice_new_maps()
                else: say_toast(bought.message)
            if res.collect >= 0:
                got = living.claim_map_reward(living_world, res.collect, living_world.player)
                if got.ok:
                    log_note(notebook, "Collected the {map_title(got.copy)} at {shop.name}, as promised.", now)
                    notice_new_maps()
                else: say_toast(got.message)
            if res.closed: ui = .none
        _: pass
