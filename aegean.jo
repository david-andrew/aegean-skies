# AEGEAN SKIES - a living-world seaplane sandbox in a sunlit, interwar Aegean.
#
# AEGEAN_VIEW="x y z yaw pitch hour" starts the camera there, at that hour (for screenshots).

build:
    name = "Aegean Skies"

use 'src/world.jo'
use 'src/look.jo'
use 'src/terrain.jo'
use 'src/sea.jo'
use 'src/clouds.jo'
use 'src/sky.jo'
use 'src/objects.jo'

window("Aegean Skies", 1280, 720)

t0 = time()
ground_meshes = [loop isl in ISLANDS: build_island_mesh(isl, if isl.radius > 1000.0: 320 else: 200)]
depth_tex = build_depth_texture()
sea_mesh = build_sea_mesh()
puff_mesh = build_puff_mesh()
puffs = instance_buffer(build_puffs(7, 120))
towns = [loop st in SETTLEMENTS: build_town(st)]
tree_meshes = build_tree_meshes()
groves = [loop k in 0..ISLANDS.len(): build_grove(k, towns)]
loop tw in towns: print("{tw.name}: {tw.center.x:.0} {tw.center.z:.0} out {tw.out.x:.2} {tw.out.y:.2} houses {tw.houses.len()}")
print("world built in {(time() - t0) * 1000.0:.0} ms")

hour = 15.5
cam = fly_camera(vec3(2600, 380, 2600), 0.8, -0.18)
cam.speed = 120.0
wind = vec2(0, 0)
t = 0.0

if let v = env("AEGEAN_VIEW"):
    w = split(v, " ")
    if w.len() >= 6:
        cam.pos = vec3(f32(to_float(w[0]) ?? 0.0), f32(to_float(w[1]) ?? 0.0), f32(to_float(w[2]) ?? 0.0))
        cam.yaw = to_float(w[3]) ?? 0.0
        cam.pitch = to_float(w[4]) ?? 0.0
        hour = to_float(w[5]) ?? 15.0

update = (dt: f64):
    global t, hour
    t += dt
    cam.update(dt)
    wind += vec2(4.0, 1.5) * f32(dt)
    if key_down(.n1): hour -= dt * 2.0
    if key_down(.n2): hour += dt * 2.0
    hour = (hour + 24.0) % 24.0

draw = ():
    L = light_at(hour)
    clear(BLACK)
    sun(L.sun_dir, L.sun, 0.0)
    hide_sky()
    fog(L.haze, L.fog_density, 0.0012)
    post_effects(0.35, 0.85, 0.22, 1.08)
    camera3d(cam, 62.0, 1.0, 30000.0)
    draw_custom((): draw_sky(L, t))
    draw_custom((): draw_ground(ground_meshes, L, t))
    draw_custom((): draw_towns(towns, L, t))
    draw_custom((): draw_groves(tree_meshes, groves, L, t))
    draw_custom((): draw_clouds(puff_mesh, puffs, L, wind, t))
    draw_custom((): draw_sea(sea_mesh, depth_tex, L, t, 0.3), transparent = true)
    text("{hour:.1}h  {cam.pos.x:.0} {cam.pos.y:.0} {cam.pos.z:.0}", vec2(16, 16), 18, rgba(1, 1, 1, 0.7))
