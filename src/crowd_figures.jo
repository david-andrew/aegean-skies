# A crowd drawn as the world's people are drawn: the same figures (src/folk.jo: a body, a head with
# its face, a hat, arms and legs that swing as they walk), dressed by the same wardrobe
# (src/wardrobe.jo, their own country's clothes) and posed by the same arithmetic as draw_figure,
# but many at once. A crowd has a few dozen looks, each built once and worn by several of its
# people; each look's parts are drawn in one instanced draw for everyone wearing it, so a busy
# square costs a few draws a look instead of six a person.
use 'folk.jo'
use 'wardrobe.jo'
use 'objects.jo'
use 'render_space.jo'
use 'look.jo'
use 'living_types.jo'

# Who someone of a crowd is, as far as their looks go: their seed, age, a woman or a man, their
# trade (0 a shopkeeper, 1 a fisherman or a fish-market woman, 2 a clerk) and their country.
struct CrowdLook:
    seed: int
    age: int
    woman: bool
    role: int
    country: int

CROWD_ROLE_OCCUPATIONS = [Occupation.merchant, Occupation.fisher, Occupation.clerk]

_crowd_hash = (a: int, b: int) -> int:
    h = u64(a) * u64(0x9E3779B97F4A7C15) + u64(b + 11) * u64(0xBF58476D1CE4E5B9)
    h = (h xor (h >> 31)) * u64(0x94D049BB133111EB)
    int((h xor (h >> 29)) & u64(0x3FFFFFFF))

# The k-th look of a crowd seeded `seed` in a country: about half women, ages 18 to 72, the trades
# of a harbour town's square and waterfront.
crowd_look = (seed: int, k: int, country: int) -> CrowdLook:
    h = _crowd_hash(seed, k)
    CrowdLook(h % 999983 + 101, 18 + (h / 7) % 55, (h / 3) % 2 == 1, (h / 11) % 3, country)

# What they wear (a modest purse: the shopkeeper's version, not the well-to-do's)
crowd_outfit = (l: CrowdLook) -> Outfit: outfit_for(CROWD_ROLE_OCCUPATIONS[l.role % 3], l.seed, l.age, l.woman, 3000, l.country)
crowd_figure = (l: CrowdLook, reuse: Figure? = none) -> Figure: build_outfit_figure(crowd_outfit(l), l.seed, age = l.age, woman = l.woman, reuse = reuse, merged = true)

# One of a crowd as they are this frame: which look, where (feet, world), the way they face (as
# draw_figure's yaw), the walk's phase and stride, standing (0) or seated (1), and the right arm's
# gesture (0 hanging .. 1 raised in talk).
struct CrowdPose:
    look: int
    at: vec3
    yaw: f64
    phase = 0.0
    stride = 0.0
    posture = 0
    gesture = 0.0

# The parts of one figure placed as draw_figure_at places them (postures 0 and 1, no props): the
# body (torso and head), each leg and each arm, in render space.
struct CrowdParts:
    body: mat4
    legs: mat4[2]
    arms: mat4[2]

crowd_parts = (f: Figure, p: CrowdPose, origin: vec3) -> CrowdParts:
    base = render_model(translation(p.at) * rotation_y(p.yaw + PI), origin) * scaling(f64(f.height))
    sw = sin(p.phase) * 0.6 * p.stride
    body = base * figure_pose(f, p.phase, p.stride, p.posture)
    legs: mat4[2]
    arms: mat4[2]
    loop k in 0..2:
        side = if k == 0: -1.0 else: 1.0
        leg = body * translation(vec3(f32(side * 0.12), 0.86, 0)) * rotation_x(sw * side)
        if p.posture == 1: leg = leg * scaling(vec3(1, 1 / f.height, 1))
        legs[k] = leg
        angle = if p.posture == 1: 0.85 else: -sw * side * 0.8
        open = 0.08
        if side > 0.0 and p.gesture > 0.0:
            # (a hand raised as they talk: forward and a little out, moving with the words)
            angle = mix(angle, 0.75, p.gesture)
            open = 0.08 + 0.1 * p.gesture
        arms[k] = body * translation(vec3(f32(side * 0.32), 1.43, 0)) * rotation_x(angle) * rotation_z(side * open)
    CrowdParts(body, legs, arms)

# Everyone of a crowd at once: for each look, its standing torso, its head, its legs and its arms
# (and the seated torso and legs) in one instanced draw each; torso and head are one mesh.
draw_crowd = (figs: Figure[], poses: CrowdPose[], L: Light, t: f64) -> int:
    if poses.len() == 0: return 0
    origin = render_origin(scene_camera())
    n = figs.len()
    torsos: Instance3D[][] = [loop k in 0..n: []]
    seated: Instance3D[][] = [loop k in 0..n: []]
    legs: Instance3D[][] = [loop k in 0..n: []]
    rest_legs: Instance3D[][] = [loop k in 0..n: []]
    arms: Instance3D[][] = [loop k in 0..n: []]
    white = vec4(1, 1, 1, 1)
    loop p in poses:
        if p.look < 0 or p.look >= n: continue
        f = figs[p.look]
        if f.body.vbo <= 0: continue
        parts = crowd_parts(f, p, origin)
        if p.posture == 1: seated[p.look].push(Instance3D(parts.body, white))
        else: torsos[p.look].push(Instance3D(parts.body, white))
        loop k in 0..2:
            if p.posture == 1: rest_legs[p.look].push(Instance3D(parts.legs[k], white))
            else: legs[p.look].push(Instance3D(parts.legs[k], white))
            arms[p.look].push(Instance3D(parts.arms[k], white))
    params = local_instance_params(L, t)
    draws = 0
    loop k in 0..n:
        f = figs[k]
        if torsos[k].len() > 0: draw_instanced(obj_inst_sh, f.body, torsos[k], params); draws += 1
        if seated[k].len() > 0: draw_instanced(obj_inst_sh, f.resting_body, seated[k], params); draws += 1
        if legs[k].len() > 0: draw_instanced(obj_inst_sh, f.leg, legs[k], params); draws += 1
        if rest_legs[k].len() > 0: draw_instanced(obj_inst_sh, f.resting_leg, rest_legs[k], params); draws += 1
        if arms[k].len() > 0: draw_instanced(obj_inst_sh, f.arm, arms[k], params); draws += 1
    draws

# One of them alone, through draw_figure itself (the one the look is on, so its outline is taken
# as it is drawn): the same pose as draw_crowd gives them.
draw_crowd_one = (f: Figure, p: CrowdPose, L: Light, t: f64):
    arm = if p.posture == 1 or p.gesture <= 0.0: -9.0 else: mix(0.0, 0.75, p.gesture)
    draw_figure(f, p.at, p.yaw, p.phase, p.stride, L, t, posture = p.posture, arms = if arm > -5.0: vec2(-9.0, f32(arm)) else: vec2(-9, -9))
