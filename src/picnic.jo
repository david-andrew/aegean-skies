# A picnic: a basket made up at the hotel or the coffee house (bread, cheese, olives, a bottle,
# and a blanket), carried along and flown wherever one likes; on a quiet shore, tap the sand and the
# blanket is spread, the pilot sits, and the afternoon goes by with the sea in front of him; tap the
# basket to pack up. Opt-in leisure, nothing needed or measured. Pure: what a good spot is, how long
# a bite takes, the notebook's line; the game draws the blanket and the things on it, and walks him.

struct Picnic:
    basket = false                  # (one made up and carried)
    active = false                  # (the blanket spread, sitting)
    at: vec3 = vec3(0, 0, 0)        # (the blanket's middle)
    yaw = 0.0                       # (facing the sea)
    since = 0.0
    settle = 0.0                    # (sitting down by degrees)
    bites = 0
    next_bite = 0.0
    place = ""                      # (the shore's name, for the notebook)

# A good spot: low ground (above the water, under four metres) with the sea close on one side,
# within twenty metres; the town's paving is no picnic.
const PICNIC_MAX_HEIGHT = 4.0
const PICNIC_SEA_REACH = 20.0

# The way to the sea from a spot, given the water's depth below sea level at points around it
# (depths[k] at angle k * TAU / depths.len(), `reach` metres out): the angle of the deepest water,
# or -1 when none is sea.
picnic_sea_angle = (depths: f64[]) -> f64:
    best = -1; bd = 0.4
    loop k in 0..depths.len():
        if depths[k] > bd: best = k; bd = depths[k]
    if best < 0: -1.0 else: f64(best) * TAU / f64(depths.len())

picnic_spot_ok = (height: f64, paved: bool, sea_angle: f64) -> bool:
    not paved and height > 0.15 and height < PICNIC_MAX_HEIGHT and sea_angle >= 0.0

# A bite or a drink every now and then while sitting (the arm to the mouth for a moment).
const PICNIC_BITE_EVERY = 14.0
picnic_bite_due = (p: Picnic, now: f64) -> bool: p.active and p.settle >= 1.0 and now >= p.next_bite

# Minutes of the world's clock a second of sitting passes: unhurried.
const PICNIC_MINUTES_A_SECOND = 1.0

picnic_note = (p: Picnic) -> str:
    where = if p.place != "": " near {p.place}" else: ""
    "A picnic on the shore{where}: bread, cheese and the sea."
