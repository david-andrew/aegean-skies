use 'settlements.jo'
use 'settlement_ports.jo'
use 'objects.jo'
use 'town_details.jo'
use 'port_mesh.jo'
use 'access_notices.jo'
use 'landing_stairs.jo'
use 'lake_ports.jo'
use 'town_regional_mesh.jo'
use 'town_region.jo'

# A timber landing on piles, not a sea-level concrete block extruded from -6 m.
# The deck's visible top is exactly the contact profile, with no coplanar overlays.
build_lake_port_mesh=(s:WorldSettlement,detail:bool)->Vertex3D[]:
    p=settlement_port(s);vs:Vertex3D[]
    loop q in p.quays:
        delta=q.b-q.a;distance=f64(length(delta.xz));n=vec2(-delta.z,delta.x)/f32(distance)
        start=vs.len();mid=(q.a+q.b)*0.5
        add_box(vs,vec3(0,-0.15,0),vec3(f32(q.width),0.3,f32(distance)),rgb(0.43,0.35,0.24),translation(vec3(mid.x,q.a.y,mid.z))*rotation_y(atan2(f64(delta.x),f64(delta.z))))
        loop k in start..vs.len():
            u=clamp(dot(vs[k].pos.xz-q.a.xz,delta.xz)/dot(delta.xz,delta.xz),0.0,1.0)
            vs[k].pos.y+=port_deck(q,u)-q.a.y
        count=max(1,int(distance/10.0))
        loop k in 0..count+1:
            u=f32(k)/f32(count);at=mix(q.a,q.b,u);at.y=port_deck(q,u)
            loop side in [-1.0,1.0]:
                pos=at+vec3(n.x,0,n.y)*f32(side*(q.width*0.5-0.3))
                bottom=f32(place_ground(pos.xz))-0.5
                add_cylinder(vs,vec3(pos.x,bottom,pos.z),0.20,f64(pos.y-bottom+0.5),rgb(0.31,0.26,0.18),if detail:6 else:4)
    add_landing_stairs_mesh(vs,s.id)
    lake_waterfront_mesh(vs,s,p,detail)
    if detail:
        port_notice_mesh(vs,p.board,atan2(f64(p.out.x),f64(p.out.y)),s.country,true,access_notice_lines(s))
        port_region_lamp(vs,p.quays[0].a+vec3(-p.out.y,0,p.out.x)*1.8,s.country)
        loop k in 0..p.boats.len():add_boat(vs,translation(p.boats[k])*rotation_y(p.boat_headings[k]),s.seed)
    vs

# The lake town's waterfront: houses on stone footings along the path to the
# jetty, timber boat sheds open to the water with slipways, and a dressed
# stone edge along the shore either side of the jetty root.
lake_waterfront_mesh=(vs:mut Vertex3D[],s:WorldSettlement,p:SettlementPort,detail:bool):
    if not lake_town(s.id) or s.harbor.len()==0:return
    yaw=atan2(f64(s.out.x),f64(s.out.y));out=vec3(s.out.x,0,s.out.y);side=vec2(-s.out.y,s.out.x)
    level=f64(s.harbor[0].at.y)
    timber=rgb(0.42,0.32,0.21);dark=rgb(0.20,0.15,0.11)
    loop b in p.buildings:
        m=translation(b.at)*rotation_y(yaw)
        if b.kind=="boat shed":
            w=f32(b.width);d=f32(b.depth)
            # Footing down to the shore, three plank walls, an open water front.
            add_box(vs,vec3(0,-0.6,-0.3),vec3(w,1.2,d-0.6),rgb(0.58,0.54,0.46),m)
            loop x in [-1.0,1.0]:add_box(vs,vec3(f32(x)*(w*0.5-0.1),1.9,0),vec3(0.2,3.8,d),timber,m)
            add_box(vs,vec3(0,1.9,-d*0.5+0.1),vec3(w,3.8,0.2),timber,m)
            add_box(vs,vec3(0,3.5,d*0.5-0.1),vec3(w,0.6,0.2),dark,m)
            add_gable(vs,vec3(0,3.8,0),f64(w)+0.4,f64(d)+0.6,1.6,rgb(0.55,0.34,0.24),m)
            # Slipway planks run from the shed floor down into the lake.
            slip=b.at+out*f32(b.depth*0.5)
            drop=f64(b.at.y)-(level-0.6)
            if drop>0.0:add_box(vs,vec3(0,0,0),vec3(2.6,0.15,f32(drop*2.5+3.0)),timber,translation(slip+out*f32(drop*1.25+1.5)-vec3(0,f32(drop*0.5),0))*rotation_y(yaw)*rotation_x(atan2(drop,drop*2.5+3.0)))
            continue
        low=f64(b.at.y)-2.0
        loop x in [-1.0,1.0]:
            loop z in [-1.0,1.0]:low=min(low,place_ground(b.at.xz+side*f32(x*b.width*0.5)+s.out*f32(z*b.depth*0.5)))
        port_foundation_mesh(vs,m,b.width,b.depth,f64(b.at.y)-low)
        start=vs.len()
        region_house(vs,m,b.width,b.depth,b.height,s.country,town_service_flat(s.seed+int(b.width*7.0),s.country,false),detail)
        loop k in start..vs.len():vs[k].color*=town_region_color(s.seed+int(b.width*7.0),s.country)
    # Dressed stone along the waterline beside the jetty: a quay edge, not a beach.
    root=p.quays[0].a
    loop t in -16..17:
        offset=f64(t)*2.0
        if abs(offset)<4.0:continue
        start=root.xz+side*f32(offset)+s.out*20.0
        r=0.0
        loop r<40.0 and place_ground(start-s.out*f32(r))<level+0.2:r+=0.5
        if r>=40.0:continue
        at=start-s.out*f32(r)
        add_box(vs,vec3(0,0,0),vec3(2.05,1.9,1.0),rgb(0.66,0.62,0.53),translation(vec3(at.x,f32(level-0.15),at.y))*rotation_y(yaw))
