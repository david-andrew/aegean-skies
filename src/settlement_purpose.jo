# One description of a settlement's work for scenery, the route bake and audit.
# Output IDs are the existing economy's goods; this does not silently change the
# trades or founding population of a relocated town.
use 'settlements.jo'
use 'geography.jo'
use 'water_field.jo'
struct SettlementPurpose:
    reason:str
    output:int
    crop:int                       # 0 none, 1 grain, 2 vines, 3 olives, 4 garden crops
    facility:int                   # 0 store, 1 mill, 2 press, 3 drying shed, 4 apothecary
    spring:bool=false

settlement_output=(s:WorldSettlement)->int:
    match s.kind:
        .fishing,.lighthouse:0
        .farm:if s.seed%3==0:2 else:3
        .hill,.hamlet,.monastery,.chapel:if s.seed%4==0:1 else:3
        .capital:if s.country==1:4 else:5
        .market:if s.seed%3==0:6 else:if s.seed%3==1:7 else:3
        .port:if s.seed%4==0:5 else:if s.seed%4==1:2 else:if s.seed%4==2:1 else:0

settlement_purpose=(s:WorldSettlement)->SettlementPurpose:
    output=settlement_output(s)
    crop=if output==1:2 else:if output==2:3 else:if output==3:1 else:if output==6 or output==7:4 else:0
    facility=if output==3:1 else:if output==1 or output==2:2 else:if output==7:3 else:if output==6:4 else:0
    reason=match output:
        0:"Fishing and coastal navigation"
        1:"Vine terraces, wine pressing and road trade"
        2:"Olive groves and an oil press"
        3:if s.size>=100:"A grain market serving the cultivated plain" else:if s.center.y>300:"Terraced upland grain farms" else:"Grain farms and milling"
        4:"Harbour fuel refining and distribution"
        5:"Metalworking supplied by ore and imported fuel"
        6:"Medicinal herb gardens and apothecaries; wine arrives for tinctures"
        7:"Tobacco terraces, drying sheds and a road market"
        _:"A market on the transport network"
    if s.kind==.monastery or s.kind==.chapel:reason=if output==1:"A monastery and its vineyard, with road-borne pilgrims and wine" else:"A monastery supported by grain farms and road-borne pilgrims"
    if s.kind==.lighthouse:reason="A lighthouse marking the coastal passage"
    spring=s.id==141625 or s.id==131459
    if spring:reason=if s.id==141625:"Thermal baths below the escarpment, an inn and a tobacco-growing market" else:"Mountain thermal springs, an inn and terraced farms"
    SettlementPurpose(reason,output,crop,facility,spring)

struct WorkingPlot:
    center:vec2
    half:vec2
    axis:vec2
    crop:int
    seed:int

struct WorkingFacility:
    at:vec3
    yaw:f64
    kind:int
working_facility_cache:{int:WorkingFacility?}
working_facility_generation= -1
working_facility=(s:WorldSettlement)->WorkingFacility?:
    global working_facility_cache,working_facility_generation
    if working_facility_generation!=settlement_generation:
        working_facility_cache={};working_facility_generation=settlement_generation
    if s.id in working_facility_cache:return working_facility_cache[s.id]
    result:WorkingFacility?=none;best=1.8
    loop plot in working_plots_cached(s):
        side=vec2(-plot.axis.y,plot.axis.x)
        at=plot.center-plot.axis*(plot.half.x-12.0)
        low=1e9;high= -1e9;dry=true
        loop x in [-5.0,0.0,5.0]:
            loop z in [-8.0,0.0,8.0]:
                p=at+plot.axis*f32(x)+side*f32(z);h=place_ground(p)
                low=min(low,h);high=max(high,h)
                if water_at(f64(p.x),f64(p.y)).wet or settlement_on_road(p) or length(settlement_avoid_buildings(p)-p)>0.1:dry=false
        if dry and high-low<best and low>3:
            best=high-low;result=WorkingFacility(vec3(at.x,f32(high+0.1),at.y),atan2(f64(side.x),f64(side.y)),settlement_purpose(s).facility)
    working_facility_cache[s.id]=result;result

working_plots=(s:WorldSettlement)->WorkingPlot[]:
    purpose=settlement_purpose(s)
    if s.legacy>=0 or purpose.crop==0 or s.kind==.lighthouse or s.kind==.chapel:return []
    plots:WorkingPlot[]
    count=if s.size>=100:6 else:if s.kind==.farm:2 else:3
    loop k in 0..count:
        seed=place_hash(s.seed,k+873)
        angle=f64(k)*TAU/f64(count)+f64(s.seed%31)*0.07
        radius=s.radius+(if s.size>=100:160.0 else:if s.kind==.farm:65.0 else:95.0)
        center=s.center.xz+vec2(cos(angle),sin(angle))*f32(radius)
        turn=f64(seed%17)*0.05+f64(s.country)*0.3
        half=if s.size>=100:vec2(105,70) else:if s.kind==.farm:vec2(38,24) else:vec2(58,36)
        plots.push(WorkingPlot(center,half,vec2(cos(turn),sin(turn)),purpose.crop,seed))
    plots

working_plot_cover=(plot:WorkingPlot,p:vec2)->f32:
    delta=p-plot.center;q=vec2(dot(delta,plot.axis),dot(delta,vec2(-plot.axis.y,plot.axis.x)))
    edge=min(plot.half.x-abs(q.x),plot.half.y-abs(q.y))
    smoothstep(0.0,5.0,edge)

working_plot_cache:{int:WorkingPlot[]}
working_plot_generation= -1
working_plots_cached=(s:WorldSettlement)->WorkingPlot[]:
    global working_plot_cache,working_plot_generation
    if working_plot_generation!=settlement_generation:
        working_plot_cache={};working_plot_generation=settlement_generation
    if not (s.id in working_plot_cache):working_plot_cache[s.id]=working_plots(s)
    working_plot_cache[s.id]

working_landuse=(p:vec2,h:f64,slope:f64)->vec4:
    if h<3 or h>1200 or slope>0.32:return vec4(0,0,0,0)
    best:f32=0;crop=0
    loop index in settlement_bins.get(geography_bin(f64(p.x),f64(p.y)),[]):
        s=world_settlements[index]
        if length(p-s.center.xz)>f32(s.radius+500):continue
        loop plot in working_plots_cached(s):
            cover=working_plot_cover(plot,p)
            if cover>best:best=cover;crop=plot.crop
    if best==0 or water_at(f64(p.x),f64(p.y)).wet:return vec4(0,0,0,0)
    best*=f32(1.0-smoothstep(0.18,0.32,slope))
    match crop:
        1:vec4(best,0,0,0)
        2:vec4(0,best,0,0)
        3:vec4(0,0,best,0)
        4:vec4(0,0,0,best)
        _:vec4(0,0,0,0)
