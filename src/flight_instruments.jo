# Shared cockpit/HUD readings. The slip ball measures apparent gravity (g - acceleration),
# not sideslip angle; a coordinated bank centers it even with a large heading rate.
use 'flight.jo'

struct FlightInstruments:
    ready = false
    previous_velocity = vec3(0,0,0)
    previous_heading = 0.0
    pitch = 0.0
    bank = 0.0
    turn = 0.0                     # radians/s, right positive; standard turn is 3 degrees/s
    slip = 0.0                     # ball displacement / half tube, right positive

instrument_step = (d: mut FlightInstruments,k: CraftSpec,s: CraftState,dt: f64):
    if dt <= 0: return
    nose=forward(s);right=quat_rotate(s.orientation,vec3(1,0,0));up=quat_rotate(s.orientation,vec3(0,1,0))
    d.pitch=asin(clamp(f64(nose.y),-1.0,1.0))
    d.bank=atan2(-f64(right.y),f64(up.y))
    h=heading(s)
    velocity=s.velocity/f32(max(k.handling_scale,1.0))
    if s.on_water:velocity.y=s.velocity.y
    acceleration=if d.ready:(velocity-d.previous_velocity)/f32(dt) else:vec3(0,0,0)
    apparent=quat_rotate(quat_inverse(s.orientation),vec3(0,-FLIGHT_G,0)-acceleration)
    ball=clamp(atan2(f64(apparent.x),max(0.5,-f64(apparent.y)))/0.35,-1.0,1.0)
    rate=if d.ready and length(nose.xz)>0.15: atan2(sin(h-d.previous_heading),cos(h-d.previous_heading))/dt else:0.0
    a=1.0-exp(-6.0*min(dt,0.25))
    d.turn+=(rate-d.turn)*a;d.slip+=(ball-d.slip)*a
    d.previous_velocity=velocity;d.previous_heading=h;d.ready=true

# Unit circle clipped by the real horizon; y is up. Used for both mesh and HUD faces.
horizon_half = (pitch: f64,bank: f64,sky: bool) -> vec2[]:
    points:vec2[]
    loop j in 0..64:points.push(vec2(cos(f64(j)*TAU/64.0),sin(f64(j)*TAU/64.0)))
    out:vec2[]
    level=(p:vec2)->f64:(f64(p.y)*cos(bank)-f64(p.x)*sin(bank)+pitch*1.5)*(if sky:1.0 else:-1.0)
    loop j in 0..points.len():
        a=points[j];b=points[(j+1)%points.len()];da=level(a);db=level(b)
        if da>=0:out.push(a)
        if (da>=0)!=(db>=0):out.push(a+(b-a)*f32(da/(da-db)))
    out
