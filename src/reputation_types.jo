# The pilot's name in the living world (docs/reputation.md): saved state only. Integers, sparse
# maps keyed by town or person, written in key order. Added to World with defaults, so older saves
# read as "nobody has heard of the pilot yet".

# What was done. The first group are small acts (they touch the people there and the town's
# leaning, and never travel by name); the rest are deeds worth telling.
enum RepKind: talked, cut_short, kept_company, declined_company, asked_over, tipped, gift, job_done, job_late, job_failed, debt_paid, debt_defaulted, rescued_foe, rescued_friend, shot_down, flew_home_in_formation, left_the_fight, rescued_survivors, found_boat

struct RepLean:
    warmth = 0                      # sociable, good company / keeps to himself
    honour = 0                      # fair dealing, mercy / sharp, faithless
    daring = 0                      # feats and risks / timid
    reliability = 0                 # jobs done on time / late, failed

struct RepDeed:
    id: int
    kind: RepKind
    minute: int
    town = -1                       # settlement id (registry id) where it happened, -1 at sea
    near = -1                       # (the town it was off, at sea; for words)
    other = -1                      # the person it was done to or with, -1 nobody named
    side = -1                       # the country of the people it was done to or with
    people = 1                      # how many (survivors brought in, aircraft shot down)
    weight = 0                      # 0..1000: how much talk it makes
    storm = 0                       # 0..1000: the weather's severity there at the time
    lean: RepLean
    radio_minute = -1               # when the wireless reads it (-1: not wireless news)
    aired = false

struct RepHeard:
    deed: int
    hops = 0
    minute = 0                      # when this town heard it

struct TownWord:
    town: int
    heard = 0                       # 0..1000: the share of the town that knows of the pilot
    lean: RepLean
    deeds: RepHeard[]               # <= 4, the most worth telling first
    minute = 0                      # last news

struct RepOpinion:
    person: int
    met = 0                         # dealings in person (talk, a table, a job, a rescue)
    lean: RepLean
    deeds: int[]                    # <= 3 deeds they know firsthand or were told
    told: int[]                     # <= 3 deeds they have already mentioned to him
    minute = 0
    talk_day = -1                   # (the day they last talked: talk counts once a day)

struct PilotRep:
    deeds: RepDeed[]                # <= 48
    next_deed = 0
    towns: {int: TownWord}
    opinions: {int: RepOpinion}
    event_cursor = 0                # living events read so far (World.next_event)
    receipt_cursor = 0              # war rescue receipts read so far
    owed: {int: int}                # the pilot's open obligations seen: id -> creditor
    carrying: {int: int}            # the jobs the pilot has claimed: id -> poster
    started = false                 # (cursors set: older events are not read as new deeds)
    told_leads: {str: int}          # leads people have told him ("person:lead" -> the day: src/leads.jo)
