# Preserve seams, normals and material tags exactly while sharing identical
# triangle corners. The original triangle order (and winding repair) is kept.
town_indexed = (source: Vertex3D[]) -> (Vertex3D[],u32[]):
    vertices: Vertex3D[]; indices: u32[]; lookup: {Vertex3D:int}={}
    loop v in source:
        index=lookup.get(v,-1)
        if index<0: index=vertices.len(); lookup[v]=index; vertices.push(v)
        indices.push(u32(index))
    (vertices,indices)

town_mesh = (source: Vertex3D[]) -> Mesh:
    indexed=town_indexed(source)
    custom_mesh(indexed.0,indexed.1)
