# Shared civil calendar. Saved day_index() zero is Monday, 3 June 1929.
# No weather, simulation or sound dependency; the sky remains fixed summer.
struct CivilDate:
    year: int
    month: int
    day: int
    weekday: int                    # Monday=0 .. Sunday=6, as existing daily life

calendar_leap = (year: int) -> bool: year%4 == 0 and (year%100 != 0 or year%400 == 0)
calendar_month_days = (year: int,month: int) -> int:
    if month == 2: (if calendar_leap(year): 29 else: 28) else: [31,28,31,30,31,30,31,31,30,31,30,31][month-1]
calendar_date = (world_day: int) -> CivilDate:
    year = 1929; month = 6; day = 3+world_day
    # Skip whole Gregorian cycles for bounded work even in a corrupted/debug clock.
    cycles = int(floor(f64(day-1)/146097.0))
    year += cycles*400; day -= cycles*146097
    loop day > calendar_month_days(year,month):
        day -= calendar_month_days(year,month); month += 1
        if month > 12: month = 1; year += 1
    CivilDate(year,month,day,((world_day%7)+7)%7)

# A deliberately small common summer observance set, not a claim to model every
# regional rite. Extend here when daily life adopts feasts; never in an audio file.
calendar_feast = (date: CivilDate) -> str?:
    if date.month == 6 and date.day == 24: return "Nativity of Saint John"
    if date.month == 6 and date.day == 29: return "Saints Peter and Paul"
    if date.month == 8 and date.day == 15: return "Dormition / Assumption"
    none
calendar_service_day = (world_day: int) -> bool:
    date = calendar_date(world_day)
    date.weekday == 6 or calendar_feast(date) != none
