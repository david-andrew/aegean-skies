# Paper maps are finite owned articles, not a global unlocked chart. Edition data is saved so
# a publication does not silently acquire today's roads, names, soundings or military facts.
enum MapKind: nautical, road, tourist, military
enum MapLayer: coast, depth, towns, roads, landmarks, lighthouses, hazards, airfields, moorings
enum MapHolder: shop, person, cache, destroyed
enum MapAcquisition: opening, purchase, gift, reward, found
enum MapErrorKind: displaced, omitted, misnamed, phantom, sounding

struct MapBounds:
    west: f64
    north: f64
    east: f64
    south: f64

struct MapError:
    layer: MapLayer
    feature: str                    # stable rendering key, e.g. mooring:1:0 or road:317
    kind: MapErrorKind
    offset = vec2(0,0)
    label = ""
    at = vec3(0,0,0)
    depth_m = -1.0
    # Renderer data, not a player's clairvoyant warning that this mark is wrong.

struct MapFeature:
    key: str
    layer: MapLayer
    position: vec3
    label: str
    points: vec3[]                   # bounded, simplified survey line; never a live route
    town_size = 1000000
    depth_m = -1.0

struct PaperMap:
    id: str
    title: str
    publisher: str
    year: int
    kind: MapKind
    bounds: MapBounds
    scale: int                      # denominator of printed scale, not a UI zoom permission
    detail: int                     # 0 ocean overview, 1 country/group, 2 island, 3 town
    layers: MapLayer[]
    accuracy_m: f64
    survey_offset = vec2(0,0)
    rotation_rad = 0.0
    scale_error_ppm = 0.0
    minimum_town_size = 0
    notes = ""
    errors: MapError[]
    feature_keys: {str: bool} = {}
    features_ready = false

struct MapShop:
    id: str
    name: str
    place: int                      # stable settlement registry ID
    person = -1                     # existing attendant, or a staffed cohort shop
    account: int                    # real sales recipient
    pos: vec3
    kind: str                       # chandler / harbour office / bookseller / hotel

struct MapCopy:
    id: int
    edition: str
    holder: MapHolder
    person = -1
    shop = ""
    place = -1
    pos = vec3(0,0,0)
    price_cents = 0
    source: str                     # immutable opening/printing provenance
    reserved_job = -1
    acquired_minute = -1
    acquisition: MapAcquisition = .opening
    last_transfer = -1

struct MapTransfer:
    serial: int
    copy: int
    minute: int
    previous: MapHolder
    holder: MapHolder
    giver: int
    receiver: int
    kind: MapAcquisition
    cents = 0
    job = -1

struct MapOffer:
    copy: int
    edition: str
    title: str
    price_cents: int
    shop: str
    affordable: bool

struct MapTradeResult:
    ok: bool
    message: str
    copy = -1
    cents = 0

struct MapMark:
    visible: bool
    position: vec3
    label: str
    depth_m = -1.0

struct MapState:
    version = 0
    catalog_version = 0
    editions: {str: PaperMap}
    features: {str: MapFeature}
    shops: {str: MapShop}
    copies: {int: MapCopy}
    selected: {int: int}             # person -> owned copy ID; never an unowned fallback
    rewards: {int: int}              # job -> actual reserved copy
    transfers: MapTransfer[]         # <=128 recent moves; copies retain last receipt/provenance
    issued = 0
    next_copy = 0
    next_transfer = 0
