# What people say: a line for whoever walks by, made from the speaker's own circumstances first
# (a debt falling due, a delivery running late, a job they need done), then the news they know,
# phrased as people talk (first names, crates and barrels, the time of day), hearsay sounding like
# hearsay, and varied by speaker and hour so a crowd does not chant one line.

from 'living_world.jo' import World
import 'living_types.jo' as lt
use 'world.jo'

_first = (w: World, p: int) -> str:
    if p < 0 or p >= w.people.len(): return "the harbor office"
    if p == w.player: return "the new pilot"
    n = w.people[p].name
    parts = split(n, " ")
    if parts.len() >= 3 and (parts[0] == "Father" or parts[0] == "Mother"): return parts[0] + " " + parts[1]
    parts[0]

# whose: "my" when it is the speaker's own, else the name's
_of = (w: World, speaker: int, p: int) -> str: if p == speaker: "my" else: _first(w, p) + "'s"

_place = (k: int) -> str: if k >= 0 and k < SETTLEMENTS.len(): SETTLEMENTS[k].name else: "somewhere"

# goods as people count them
_load = (w: World, good: int, milli: int) -> str:
    if good < 0 or good >= w.goods.len(): return "the cargo"
    n = max(1, int(round(f64(milli) / 1000.0)))
    key = w.goods[good].key
    unit = match key:
        "fish": "crate"
        "wine": "barrel"
        "oil": "barrel"
        "grain": "sack"
        "fuel": "tin"
        "parts": "crate"
        "medicine": "box"
        "tobacco": "bale"
        "arms": "crate"
        _: "load"
    what = match key:
        "fish": "fish"
        "oil": "oil"
        "parts": "engine parts"
        "arms": "rifles"
        _: key
    units = if unit == "box": "boxes" else: unit + "s"
    if n == 1: "a {unit} of {what}" else: "{n} {units} of {what}"

_good_name = (w: World, good: int) -> str:
    if good < 0 or good >= w.goods.len(): return "goods"
    k = w.goods[good].key
    if k == "parts": "engine parts" else: k

# a minute of the world's clock as people say it
_when = (w: World, minute: int) -> str:
    start = 9 * 60 + 30
    abs_m = minute + start
    day = abs_m / 1440
    today = (w.minute + start) / 1440
    h = (abs_m % 1440) / 60
    part = if h < 6: "before dawn" else: (if h < 11: "this morning" else: (if h < 14: "midday" else: (if h < 18: "this afternoon" else: (if h < 21: "this evening" else: "tonight"))))
    if day == today: part else: (if day == today + 1: "tomorrow" else: (if day < today: "long since" else: "in a few days"))

_money = (cents: int) -> str:
    l = cents / 100
    if l == 1: "a lira" else: "{l} lire"

# one of several ways to say it, chosen by speaker and hour (so it changes, but not every frame)
_pick = (w: World, speaker: int, salt: int, n: int) -> int: int((u64(speaker * 7919 + salt * 104729 + w.minute / 60) * u64(2654435761)) % u64(max(n, 1)))

# a piece of news, as told by someone (first-hand or heard)
news_line = (w: World, speaker: int, n: lt.NewsItem) -> str:
    r = n.reason
    heard = n.hops > 0 or n.source_person != speaker
    a = _first(w, r.actor)
    b = _first(w, r.beneficiary)
    good = _good_name(w, r.good)
    # about the speaker themselves: said in the first person, or not at all
    if r.actor == speaker:
        return match n.kind:
            .late: if r.good >= 0: "I'm late with {_of(w, speaker, r.beneficiary)} {good}, I know." else: ""
            .delivery: if r.good >= 0: "I got {_of(w, speaker, r.beneficiary)} {good} here." else: ""
            .ditch: "I came down in the sea. Don't ask."
            .refused: "I'm not flying. Not today."
            _: ""
    if r.counterparty == speaker and (n.kind == .raid or n.kind == .theft):
        return "They jumped me at sea" + (if r.good >= 0: " and took the {good}." else: ".") + " Kryfo men, I'd bet."
    if r.beneficiary == speaker:
        return match n.kind:
            .late: if r.good >= 0: "I'm still waiting on {a} with my {good}." else: (if r.amount_cents > 0: "{a} owes me {_money(r.amount_cents)}." else: "")
            .delivery: if r.good >= 0: "{a} brought my {good} in." else: "{a} came through for me."
            .defaulted: "{a} never paid me. I won't forget it."
            .rescue: "{a} pulled me out of the water. I owe them."
            _: ""
    v = _first(w, r.counterparty)
    lead = if heard: ["They say ", "I heard ", "Word is "][_pick(w, speaker, n.event, 3)] else: ""
    s = match n.kind:
        .raid, .theft:
            what = if r.good >= 0: " and took the {good}" else: ""
            vic = if r.counterparty >= 0: v else: b
            ["pirates jumped {vic} off {_place(r.origin)}{what}.", "they robbed {vic} at sea{what}. Kryfo men, I'd bet.", "somebody went after {vic}'s cargo out past {_place(r.origin)}."][_pick(w, speaker, n.event + 1, 3)]
        .late:
            if r.good >= 0 and r.destination >= 0: ["{a} is late with {b}'s {good}.", "{b}'s still waiting on {a}. The {good} was due {_when(w, r.due_minute)}."][_pick(w, speaker, n.event, 2)]
            else: if r.amount_cents > 0: "{a} owes {b} {_money(r.amount_cents)} and it's overdue." else: "{a} is running late."
        .delivery: if r.good >= 0: "{a} brought {b}'s {good} in." else: "{a} delivered for {b}."
        .arrived: ["{a}'s just in from {_place(r.origin)}.", "{a} came in a while ago."][_pick(w, speaker, n.event, 2)]
        .departed:
            to = if r.destination >= 0 and r.destination != r.origin: " to {_place(r.destination)}" else: ""
            why = match r.purpose:
                .delivery: " with {b}'s cargo"
                .fishing: " fishing"
                .patrol: " on patrol"
                .passenger: " with a passenger"
                .raid: ", and didn't say why"
                .return_home: ", for home"
                _: ""
            "{a} went out{to}{why}."
        .patrol: ["{a} is out watching the lanes.", "the harbor office has {a} flying the lanes again."][_pick(w, speaker, n.event, 2)]
        .shortage: ["{_place(n.origin)} is short of {good}.", "there's no {good} to be had in {_place(n.origin)}."][_pick(w, speaker, n.event, 2)]
        .ditch: "{a} came down in the sea near {_place(r.origin)}."
        .rescue: "{a} pulled {b} out of the water."
        .repair: "{a}'s aircraft is in the workshop."
        .defaulted: "{a} never paid {b}. That's the end of that."
        .fine: "the harbor office fined {a}."
        .closure: "the harbor at {_place(n.origin)} is closed for the weather."
        .refused: "{a} won't fly. Not for any money."
        .search: "they're searching for {a}."
        _: ""
    if s == "": return ""
    lead + s

# a capital where the line starts
cap_line = (s: str) -> str: if s.len() == 0: s else: upper(s[0..1]) + s[1..]

# what someone says to a person passing by
say = (w: World, speaker: int) -> str: cap_line(_say(w, speaker))

_say = (w: World, speaker: int) -> str:
    if speaker < 0 or speaker >= w.people.len(): return ""
    me = w.people[speaker]
    # their own trouble first: a debt or a delivery due soon or overdue
    loop id in me.obligations:
        if not (id in w.obligations): continue
        o = w.obligations[id]
        if o.debtor != speaker or (o.state != .open and o.state != .blocked): continue
        soon = o.due_minute - w.minute < 6 * 60
        if not soon: continue
        late = w.minute > o.due_minute
        match o.kind:
            .debt, .rent:
                who = if o.creditor >= 0: _first(w, o.creditor) else: "the harbor office"
                return if late: ["{who} wants {_money(o.amount_cents)} I don't have.", "I'm behind with {who}. {_money(o.amount_cents)}, and it was due {_when(w, o.due_minute)}."][_pick(w, speaker, id, 2)] else: ["I owe {who} {_money(o.amount_cents)} by {_when(w, o.due_minute)}.", "{_money(o.amount_cents)} to {who} by {_when(w, o.due_minute)}, and the day's half gone."][_pick(w, speaker, id, 2)]
            .delivery:
                if o.reason.good >= 0 and o.reason.destination >= 0:
                    what = _load(w, o.reason.good, o.reason.quantity)
                    return if late: "I should have been in {_place(o.reason.destination)} with {what} {_when(w, o.due_minute)}." else: "I've {what} to get to {_place(o.reason.destination)} by {_when(w, o.due_minute)}."
            .repair:
                return "My aircraft wants work, and it isn't cheap."
            _: pass
    # a job they need done
    loop id in w.active_jobs:
        j = w.jobs[id]
        if j.poster != speaker or j.state != .open: continue
        pay = _money(j.reward_cents)
        if j.purpose == .passenger: return "{_first(w, j.passenger)} needs passage to {_place(j.destination)} by {_when(w, j.due_minute)}. {pay}, if you're going."
        if j.cargo_mode == .sealed: return "There's a sealed bag that has to reach {_place(j.destination)} by {_when(w, j.due_minute)}. {pay} to whoever takes it."
        return ["I need {_load(w, j.good, j.quantity)} taken to {_place(j.destination)} by {_when(w, j.due_minute)}. {pay}.", "Are you flying to {_place(j.destination)}? I've {_load(w, j.good, j.quantity)} for there. {pay}."][_pick(w, speaker, id, 2)]
    # then the news they know: the weightier, the likelier, but not always the same one
    best = ""
    bs = -1
    loop k in 0..me.news.len():
        n = me.news[k]
        if n.private_fact and n.source_person != speaker: continue
        score = n.severity + _pick(w, speaker, n.event, 300)
        if score > bs:
            line = news_line(w, speaker, n)
            if line != "":
                bs = score
                best = line
    if best != "": return best
    # nothing pressing: their day
    match me.occupation:
        .fisher: ["The fish are deep today.", "Wind's wrong for the nets.", "Calm enough out there, for now."][_pick(w, speaker, 1, 3)]
        .merchant: ["Prices are up again.", "Everything costs more than it did.", "Buying or selling?"][_pick(w, speaker, 2, 3)]
        .courier, .racer: ["Good flying weather.", "Watch the wind past the point.", "Anything going my way?"][_pick(w, speaker, 3, 3)]
        .patrol: ["Quiet, for now.", "Keep to the lanes."][_pick(w, speaker, 4, 2)]
        .innkeeper, .hotelier: ["Come in out of the sun.", "There's wine, if you're thirsty."][_pick(w, speaker, 5, 2)]
        .mechanic: ["Bring her in if she's running rough.", "Floats are the first thing to go."][_pick(w, speaker, 6, 2)]
        .pirate: ["Nice aircraft. Shame if anything happened to it.", "You lost?"][_pick(w, speaker, 7, 2)]
        _: ["Good day.", "Lovely weather."][_pick(w, speaker, 8, 2)]

# a line for the board's "yesterday": what someone did, plainly
reason_line = (w: World, r: lt.Reason) -> str:
    a = _first(w, r.actor)
    b = _first(w, r.beneficiary)
    line = match r.purpose:
        .delivery:
            if r.actor == r.beneficiary or r.good < 0: "" else: "{a} carried {_load(w, r.good, r.quantity)} to {_place(r.destination)} for {b}."
        .patrol: "{a} flew the lanes off {_place(r.destination)}."
        .raid: "Pirates were seen near {_place(r.destination)}."
        .fishing: ""
        .visit: ""
        .return_home: ""
        .report: "{a} took {b}'s report to {_place(r.destination)}."
        .passenger: "{a} flew {b} to {_place(r.destination)}."
        .repair: "{a}'s aircraft was in the workshop."
        .rescue: "{a} went out after {b}."
        _: ""
    cap_line(line)
