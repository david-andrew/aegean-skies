# Committed speech at actual contact; UI projections live in living_conversation.
use 'living_types.jo'
use 'life_types.jo'
use 'living_conversation.jo'
import 'living_types.jo' as lt

cap_line = (s: str) -> str: if s.len() == 0: s else: upper(s[0..1])+s[1..]

say = (w: mut World, speaker: int) -> str:
    turn = converse(w,speaker,w.player,.greeting)
    if turn.question != "": turn.text+" "+turn.question else: turn.text

# Barks have the same bounded saved speech memory. No acquaintance or line use from rendering.
# A passing remark is about the speaker's own day or the weather; news, prices and particulars
# wait until the pilot stops and asks. A remark in passing is not a conversation, so it doesn't
# make the two of them acquainted.
passing_line = (w: mut World, speaker: int) -> str:
    if speaker < 0 or speaker >= w.people.len(): return ""
    ledger = w.speech.get(speaker,SpeechLedger())
    sequence = ledger.sequence
    offered = conversation_topics(w,speaker,w.player)
    if offered.len() == 0: return ""
    topics = [TalkTopic.home,.weather]
    met = ledger.acquaintance.get(w.player,-1)
    line = converse(w,speaker,w.player,topics[sequence%topics.len()]).text
    if speaker in w.speech:
        after = w.speech[speaker]
        if met < 0: after.acquaintance.remove(w.player) else: after.acquaintance[w.player] = met
        w.speech[speaker] = after
    line

news_line = (w: World, speaker: int, n: NewsItem) -> str:
    loop c in news_candidates(w,speaker):
        if c.event == n.event: return c.text
    ""

# a line for the board's "yesterday": what someone did, plainly
reason_line = (w: World, r: lt.Reason) -> str:
    a = talk_name(w, r.actor)
    b = talk_name(w, r.beneficiary)
    line = match r.purpose:
        .delivery:
            if r.actor == r.beneficiary or r.good < 0: "" else: "{a} carried {talk_load(w, r.good, r.quantity)} to {talk_place(w,r.destination)} for {b}."
        .patrol: "{a} flew the lanes off {talk_place(w,r.destination)}."
        .raid: "Pirates were seen near {talk_place(w,r.destination)}."
        .fishing: ""
        .visit: ""
        .return_home: ""
        .report: "{a} took {b}'s report to {talk_place(w,r.destination)}."
        .passenger: "{a} flew {b} to {talk_place(w,r.destination)}."
        .repair: "{a}'s aircraft was in the workshop."
        .rescue: "{a} went out after {b}."
        _: ""
    cap_line(line)
