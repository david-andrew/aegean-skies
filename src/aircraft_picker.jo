# The pause menu's aircraft picker, as words and a little drawing: each aircraft's name in full, its
# year (the historical types), what it is, which group it belongs to, whether it needs a buoy or an
# airfield, and a tiny top-down silhouette drawn from its catalogue profile. The page itself
# (src/debugmenu.jo) lays the cards out; this file knows nothing of the menu.
use 'planes.jo'
use 'aircraft_boats.jo'
use 'aircraft_greek.jo'
use 'phoenix.jo'

CRAFT_GROUPS = ["Aegean types", "Schneider racers", "Early flying boats", "Big flying boats", "Landplanes", "Greek service"]

# (a top-down planform: enough of the profile to draw it, nose up)
struct CraftPlan:
    span = 11.0
    length = 8.0
    chord = 1.6
    width = 0.6
    decks = 1
    boat = false
    landplane = false
    float_x = 1.5
    engine_x = 0.0
    engines = 1
    twin_hull = false

struct CraftEntry:
    kind = 0
    name = ""                       # in full ("Savoia-Marchetti S.55")
    year = ""                       # "1924" (the historical types; the game's own have none)
    role = ""                       # what it is ("twin-hull long-range boat")
    group = 0                       # CRAFT_GROUPS
    needs = ""                      # "buoy" (too big for a dock), "airfield" (wheels only), or ""
    plan: CraftPlan

# "Savoia-Marchetti S.55 (1924): twin-hull long-range boat", "single-seat land fighter, 1926" or
# "utility / mail": the name in full if it gives one, the year, and what it is
_craft_words = (name: str, role: str) -> (str, str, str):
    if let open = index_of(role, " ("):
        if let close = index_of(role, "): "):
            if close > open + 2: return (role[0..open], role[open + 2..close], role[close + 3..role.len()])
    if role.len() > 6 and role[role.len() - 6..role.len() - 4] == ", ":
        year = role[role.len() - 4..role.len()]
        if (to_int(year) ?? 0) > 1900: return (name, year, role[0..role.len() - 6])
    (name, "", role)

_craft_group = (kind: Craft) -> int:
    k = int(kind)
    if k < 16: return 0
    if is_racer(kind) or kind == .macchi_mc72 or kind == .sm_s65 or kind == .piaggio_p7: return 1
    if big_boat(kind): return 3
    if is_greek_craft(kind): return 5
    if aircraft_profile(kind).landplane: return 4
    2

# every aircraft, in Craft order, as the picker shows it
craft_entries = () -> CraftEntry[]:
    [loop k in 0..CRAFT_NAMES.len(): _craft_entry(Craft(k))]

_craft_entry = (kind: Craft) -> CraftEntry:
    p = aircraft_profile(kind)
    words = _craft_words(CRAFT_NAMES[int(kind)], p.role)
    needs = if offshore_only(kind): "buoy" else: if p.landplane: "airfield" else: ""
    plan = CraftPlan(span = p.span, length = p.length, chord = p.chord, width = p.width, decks = p.decks, boat = p.boat, landplane = p.landplane,
        float_x = p.float_x, engine_x = p.engine_x, engines = if p.engines > 0: p.engines else: if p.engine_x > 0.0: 2 else: 1, twin_hull = kind == .sm_s55)
    CraftEntry(kind = int(kind), name = words.0, year = words.1, role = words.2, group = _craft_group(kind), needs = needs, plan = plan)

# The aircraft from above, nose up, in the box (x, y, w, h): wings, fuselage or hull, tailplane,
# floats or wing-tip floats, and engine nacelles where they are out on the wing.
draw_craft_plan = (p: CraftPlan, x: f64, y: f64, w: f64, h: f64, c: vec4):
    s = min(w / max(p.span, 1.0), h / max(p.length, 1.0)) * 0.94
    cx = x + w * 0.5
    len = p.length * s
    top = y + (h - len) * 0.5
    thin = 1.2
    wing_y = top + len * 0.26
    chord = max(p.chord * s, thin * 1.5)
    # (the wings; a biplane's lower one shows a little behind, as a second edge)
    rect(cx - p.span * s * 0.5, wing_y, p.span * s, chord, c)
    if p.decks >= 2: rect(cx - p.span * s * 0.42, wing_y + chord + 0.8, p.span * s * 0.84, thin, vec4(c.x, c.y, c.z, c.w * 0.6))
    # (the fuselage or hull; twin hulls out on booms)
    if p.twin_hull:
        loop side in [-1.0, 1.0]:
            hx = cx + side * p.float_x * s
            rect(hx - max(p.width * s, thin), top + len * 0.12, max(p.width * 2.0 * s, thin * 1.6), len * 0.68, c)
        rect(cx - thin, wing_y, thin * 2.0, len * 0.7, c)
    else:
        fw = max(p.width * 2.0 * s, thin * 1.8)
        rect(cx - fw * 0.5, top, fw, len, c)
    # (the tailplane)
    rect(cx - p.span * s * 0.17, top + len * 0.86, p.span * s * 0.34, max(chord * 0.55, thin), c)
    # (floats under a floatplane; small floats at a boat's wing tips)
    if not p.boat and not p.landplane:
        loop side in [-1.0, 1.0]:
            rect(cx + side * p.float_x * s - thin, top + len * 0.1, thin * 2.0, len * 0.62, c)
    else if p.boat and not p.twin_hull and p.float_x > p.width * 2.0:
        loop side in [-1.0, 1.0]:
            rect(cx + side * p.float_x * s - thin, wing_y + chord * 0.3, thin * 2.0, max(chord * 0.6, thin * 2.0), c)
    # (engines out on the wing: a pair, or a row of them along it)
    if p.engines > 2:
        n = min(p.engines, 12)
        pods = if n > 6: n / 2 else: n
        loop i in 0..pods:
            ex = cx - p.span * s * 0.3 + p.span * s * 0.6 * (f64(i) + 0.5) / f64(pods)
            circle(vec2(f32(ex), f32(wing_y - thin * 0.4)), max(thin * 1.3, chord * 0.28), c)
    else if p.engine_x > 0.0:
        loop side in [-1.0, 1.0]:
            circle(vec2(f32(cx + side * p.engine_x * s), f32(wing_y - thin * 0.4)), max(thin * 1.3, chord * 0.3), c)

# what a needs badge says
craft_needs_words = (needs: str) -> str: if needs == "buoy": "moors to a buoy" else: if needs == "airfield": "airfield only" else: ""
