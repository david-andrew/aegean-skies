# Settlement-side landing adapter. Town identity and house layout stay at the town;
# the waterfront jetty publishes the same docks, cargo and board contract as a sea port.
use 'lake_data.jo'
use 'lake_access_data.jo'
use 'shore_access_data.jo'
use 'landing_access.jo'
use 'settlements.jo'
use 'settlement_ports.jo'
use 'water_field.jo'
use 'landing_access_types.jo'

attach_landing=(index:int,level:f64):
    global world_settlements
    landing=landing_access(world_settlements[index].id)
    side=vec2(-landing.out.y,landing.out.x)
    station=landing.tip.xz-landing.out*12.0
    water=vec3(station.x,f32(level),station.y)
    buoy=water+vec3(landing.out.x,0,landing.out.y)*55.0
    # Each berth needs water under the hull and no rock within a wing's reach;
    # the surveyed spot is kept when clear, else the nearest clear one beside the pier.
    clear=(q:vec2)->bool:
        if place_ground(q)>=level-2.0:return false
        loop k in 0..12:
            if place_ground(q+vec2(f32(cos(f64(k)*TAU/12.0)),f32(sin(f64(k)*TAU/12.0)))*6.0)>level-0.3:return false
        true
    docks:MooringPlace[]
    loop sign in [-1.0,1.0]:
        at=water.xz+side*f32(sign*18.0)
        if not clear(at):
            found=false
            loop back in [12.0,20.0,4.0,28.0]:
                loop lateral in [18.0,22.0,14.0,26.0]:
                    q=landing.tip.xz-landing.out*f32(back)+side*f32(sign*lateral)
                    if not found and clear(q):at=q;found=true
        docks.push(MooringPlace(vec3(at.x,f32(level),at.y),landing.root.xz,landing.tip.xz,5.0,buoy,deck=level+1.2))
    world_settlements[index].harbor=docks
    world_settlements[index].remote_harbor=true

attach_lake_landings=():
    global world_settlements
    loop lake in SETTLEMENT_LAKES:
        if not (lake.id in settlement_by_id):continue
        index=settlement_by_id[lake.id]
        # Move the existing record, never remove/re-add a generated settlement.
        # Names, seed/parcel identities, country, size and economic IDs survive.
        world_settlements[index].center=place_point(lake.town.xz)
        world_settlements[index].out=lake.out
        if lake.id in LAKE_LANDINGS:attach_landing(index,lake.level)

attach_shore_landings=(first:int):
    loop index in first..world_settlements.len():
        if world_settlements[index].id in SHORE_LANDINGS:attach_landing(index,0.0)

build_lake_port=(s:WorldSettlement)->SettlementPort:
    landing=landing_access(s.id);out=landing.out;side=vec2(-out.y,out.x)
    root=landing.root+vec3(0,0.12,0);tip=landing.tip
    join=mix(root,tip,0.45);join.y=tip.y
    p=SettlementPort(s.id,s.name,root,out,country=s.country,region=s.region)
    p.quays=[PortQuay(root,join,5.0,profile=true),PortQuay(join,tip,5.0)]
    p.routes=[landing.route,[root,join,tip]]
    p.board=root+vec3(side.x,0,side.y)*1.5-vec3(out.x,0,out.y)*3.0
    p.board.y=f32(place_ground(p.board.xz))
    # Under a cliff the ground behind the pier is no place for a notice board:
    # it stands on the deck, beside the walkway, near the shore end.
    lo=f64(p.board.y);hi=lo
    loop d in [vec2(0.6,0),vec2(-0.6,0),vec2(0,0.6),vec2(0,-0.6)]:
        h=place_ground(p.board.xz+d);lo=min(lo,h);hi=max(hi,h)
    if (hi-lo)/1.2>0.9 or abs(f64(p.board.y-root.y))>3.0:
        p.board=mix(root,join,0.2)+vec3(side.x,0,side.y)*1.6
        p.board.y=port_deck(p.quays[0],0.2)
    p.anchorage=s.harbor[0].buoy
    loop dock in s.harbor:
        p.docks.push(dock.at)
        along=dot(dock.at.xz-join.xz,out)
        sign=if dot(dock.at.xz-join.xz,side)<0.0: -1.0 else:1.0
        load=join+vec3(out.x,0,out.y)*along+vec3(side.x,0,side.y)*f32(sign*1.7)
        p.loading.push(load);p.routes.push([root,join,load])
    p.boats=[tip+vec3(side.x,0,side.y)*7.0-vec3(out.x,0,out.y)*45.0-vec3(0,1.2,0)]
    p.boat_headings=[atan2(f64(out.x),f64(out.y))]
    if lake_town(s.id):p.buildings=lake_waterfront(s,landing,f64(s.harbor[0].at.y))
    p

lake_town=(id:int)->bool:
    loop lake in SETTLEMENT_LAKES:
        if lake.id==id:return true
    false

# A lake town comes down to its water: a short street of houses lines the path
# from the square to the jetty, and boat sheds stand on the shore beside it.
# Buildings face the water along the town's own axis, as harbour buildings do,
# so collision and rendering share one footprint.
lake_waterfront=(s:WorldSettlement,landing:LandingAccess,level:f64)->PortBuilding[]:
    result:PortBuilding[]
    out=s.out;side=vec2(-out.y,out.x)
    route=landing.route
    near_route=(q:vec2,margin:f64)->bool:
        loop k in 1..route.len():
            a=route[k-1].xz;b=route[k].xz;d=b-a;n=f64(dot(d,d))
            if n<0.01:continue
            u=clamp(f64(dot(q-a,d))/n,0.0,1.0)
            if f64(length(q-(a+d*f32(u))))<margin:return true
        false
    fits=(c:vec2,w:f64,d:f64)->(bool,f64,f64):
        lo=1e9;hi= -1e9
        loop x in [-0.5,0.0,0.5]:
            loop z in [-0.5,0.0,0.5]:
                h=place_ground(c+side*f32(x*w)+out*f32(z*d));lo=min(lo,h);hi=max(hi,h)
        if water_at(f64(c.x),f64(c.y)).wet:return (false,lo,hi)
        (lo>level+0.6 and hi-lo<3.0,lo,hi)
    clear_of=(c:vec2,w:f64,d:f64)->bool:
        loop b in result:
            if abs(f64(dot(c-b.at.xz,side)))<(w+b.width)*0.5+2.5 and abs(f64(dot(c-b.at.xz,out)))<(d+b.depth)*0.5+2.5:return false
        true
    # Houses either side of the path, from the shore up to the town's edge.
    loop k in 1..route.len():
        a=route[route.len()-k].xz;b=route[route.len()-1-k].xz;d=b-a;span=f64(length(d))
        if span<1.0:continue
        dir=d/f32(span);perp=vec2(-dir.y,dir.x)
        t=10.0
        loop t<span:
            q=a+dir*f32(t)
            if f64(length(q-s.center.xz))<s.radius*0.3:break
            loop sign in [-1.0,1.0]:
                seed=place_hash(s.seed,int(t)*7+int(sign)+k*1000)
                w=9.0+f64(seed%4);dd=8.0+f64((seed/4)%3);h=5.5+f64((seed/12)%3)*1.6
                c=q+perp*f32(sign*(5.5+max(w,dd)*0.5))
                ok,lo,hi=fits(c,w,dd)
                if not ok or near_route(c,max(w,dd)*0.71+2.5) or not clear_of(c,w,dd) or seed%7==0:continue
                door=c+out*f32(dd*0.5+0.8)
                result.push(PortBuilding("house",vec3(c.x,f32(lo),c.y),w,dd,h+hi-lo,place_point(door)))
            t+=13.0
    # Boat sheds at the water's edge on either side of the jetty root.
    loop offset in [-40.0,-27.0,-14.0,14.0,27.0,40.0]:
        start=landing.root.xz+side*f32(offset)+out*25.0
        r=0.0
        loop r<70.0 and place_ground(start-out*f32(r))<level+0.4:r+=0.5
        if r>=70.0:continue
        c=start-out*f32(r+3.0)
        w=6.5;dd=9.0
        lo=1e9;hi= -1e9
        loop x in [-0.5,0.5]:
            loop z in [-0.5,0.0]:
                h=place_ground(c+side*f32(x*w)+out*f32(z*dd));lo=min(lo,h);hi=max(hi,h)
        if hi-lo>2.5 or near_route(c,8.0) or not clear_of(c,w,dd):continue
        result.push(PortBuilding("boat shed",vec3(c.x,f32(max(lo,level+0.3)),c.y),w,dd,4.2,place_point(c+out*f32(dd*0.5+0.6))))
    result
