# The world sanity audit's enumeration: every authored and generated harbour,
# landing, placed prop, building, door, bath and road. Shared by
# tools/world_audit.jo (the full ranked report) and tests/world_audit_test.jo.
use 'world.jo'
use 'geography.jo'
use 'settlements.jo'
use 'settlement_ports.jo'
use 'objects.jo'
use 'walk_shapes.jo'
use 'thermal_sites.jo'
use 'landing_access.jo'
use 'world_point.jo'
use 'canal_geometry.jo'
use 'world_audit.jo'
use 'town_sites.jo'

# scope: "all", "legacy" or a list of settlement IDs in wanted. reach adds the
# walking search from every generated harbour to its square (slow).
world_audit_run=(towns:Town[],scope:str,wanted:{int:bool},reach:bool)->AuditFinding[]:
    findings:AuditFinding[]
    # ---- the six authored harbours ----
    loop place in 0..towns.len():
        if scope!="all" and scope!="legacy" and not (place in wanted):continue
        tw=towns[place];name=tw.name
        out=vec3(tw.out.x,0,tw.out.y);side=vec3(-tw.out.y,0,tw.out.x)
        loop k in 0..tw.docks.len():audit_mooring(findings,place,name,k,tw.docks[k],0.0)
        audit_prop(towns,findings,"notice board",place,name,0,town_board_spot(tw))
        store=town_store_spot(tw,tw.center-out*8.0+side+vec3(0,f32(QUAY_TOP)-tw.center.y,0))
        audit_prop(towns,findings,"harbour store",place,name,0,store)
        lamp=0
        loop q in tw.quays:
            dq=q.b-q.a;ql=f64(length(dq));nrm=vec2(-dq.y,dq.x)/f32(ql);k=8.0
            loop k<ql-4.0:
                lp=q.a+dq*f32(k/ql)+nrm*f32(f64(q.width)*0.5-0.6)
                # A lamp is on the deck only where the deck is out of the rock.
                if surface_height(f64(lp.x),f64(lp.y))<f64(QUAY_TOP):audit_prop(towns,findings,"quay lamp",place,name,lamp,vec3(lp.x,QUAY_TOP,lp.y),0.3)
                lamp+=1;k+=26.0
        if tw.houses.len()>0:
            # The harbour must lead to the houses, not end at the foot of a cliff.
            # Any of its houses will do; the nearest to the quay is the natural goal,
            # and a stair may arrive near another one.
            goal=tw.houses[0].xz
            loop h in tw.houses:
                if length(h.xz-tw.center.xz)<length(goal-tw.center.xz):goal=h.xz
            if tw.stairs.len()>0:
                top=tw.stairs[0][tw.stairs[0].len()-1];goal=tw.houses[0].xz
                loop h in tw.houses:
                    if length(h.xz-top.xz)<length(goal-top.xz):goal=h.xz
            if true:   # (cheap for the six authored harbours; always checked)
                start=audit_quay_access(tw,tw.docks[0])
                r=audit_reach(towns,start,goal,12.0,120000,1.0)
                if not r.reached:findings.push(AuditFinding(true,300.0+r.closest,"harbour cut off from its houses",place,name,start,"no walkable route from the quay; closest approach {r.closest:.0f} m at {r.near}",audit_key("reach",place,0)))

    # ---- generated places ----
    checked=0
    loop s in world_settlements:
        if s.legacy>=0 or s.id==CANAL_CITY_ID:continue   # (the canal quarter is authored; its own tests cover it)
        if scope=="legacy" or scope!="all" and not (s.id in wanted):continue
        checked+=1
        # Buildings: overlaps and doors that open into a wall.
        sites:TownSite[]
        loop lot in place_lots(s):
            if let parcel=place_ground_lot(s,lot):sites.push(site_from_parcel(parcel))
        port_sites=0
        # Every other building-sized solid a walker collides with here: the church,
        # monastery ranges, hill-church walls and port buildings.
        parcels=sites.len();seen_at:{vec3:bool}
        loop site in sites:seen_at[site.at]=true
        reach_r=s.radius+40.0;cx=int(floor(f64(s.center.x)/32));cz=int(floor(f64(s.center.z)/32));span=int(ceil(reach_r/32))
        loop dz in -span..span+1:
            loop dx in -span..span+1:
                loop site in walk_cell(vec2(f32((cx+dx)*32+16),f32((cz+dz)*32+16))).sites:
                    if site.height<2.5 or site.at in seen_at or f64(length(site.at.xz-s.center.xz))>reach_r:continue
                    seen_at[site.at]=true;sites.push(site);port_sites+=1
        loop i in 0..sites.len():
            loop j in i+1..sites.len():
                o=audit_overlap(sites[i],sites[j])
                if i>=parcels and j>=parcels:continue    # (both outside the house lots: authored together)
                if o>1.0:findings.push(AuditFinding(o>3.0,(if o>3.0:120.0 else:12.0)+o*5.0,"buildings overlap",s.id,s.name,sites[i].at,"{o:.1f} m interpenetration with the building at {sites[j].at}",audit_key("overlap",s.id,i*1000+j)))
        loop i in 0..sites.len()-port_sites:
            site=sites[i];front=vec2(f32(sin(site.yaw)),f32(cos(site.yaw)))
            door=site.at.xz+front*f32(site.depth*0.5+3.0)   # (beyond the entry steps)
            h=place_ground(door)
            if length(walk_far_exclude(door,h)-door)>1.0:
                # A narrow lane is fine; a door is shut in only when a person on its
                # step cannot walk out to open ground at all.
                step=site.at.xz+front*f32(site.depth*0.5+1.2);hs=audit_ground(towns,f64(step.x),f64(step.y))
                r=audit_reach(towns,vec3(step.x,f32(hs),step.y),site.at.xz+front*f32(site.depth*0.5+12.0),5.0,1500,1.0)
                if not r.reached:findings.push(AuditFinding(true,140.0,"door shut in",s.id,s.name,vec3(step.x,f32(hs),step.y),"no way out from the front step (closest {r.closest:.0f} m)",audit_key("door",s.id,i)))
            if f64(site.at.y)-h>2.5:findings.push(AuditFinding(false,12.0+f64(site.at.y)-h,"door above a drop",s.id,s.name,vec3(door.x,f32(h),door.y),"ground {f64(site.at.y)-h:.1f} m below the floor at the door",audit_key("drop",s.id,i)))
        # Square furniture stands on ground a person can stand on.
        sq=place_square(s)
        loop k in 0..sq.props.len():
            at=place_point(place_to_world(s,sq.props[k].local))
            if place_ground(at.xz)<0.4:continue
            audit_prop(towns,findings,"square furniture",s.id,s.name,k,at,0.8)
        if s.harbor.len()==0:continue
        p=settlement_port(s)
        level=f64(s.harbor[0].at.y)
        loop k in 0..s.harbor.len():audit_mooring(findings,s.id,s.name,k,s.harbor[k].at,level)
        audit_prop(towns,findings,"notice board",s.id,s.name,0,p.board)
        loop k in 0..p.buildings.len():audit_prop(towns,findings,"building door",s.id,s.name,k,p.buildings[k].door,0.5)
        if s.remote_harbor:
            # A surveyed landing: its approach is walked step by step.
            landing=landing_access(s.id)
            # Walk the surveyed approach; where a fountain, bench or wall stands on
            # the polyline, a person steps round it: search a local detour instead.
            point=world_point(landing.route[0]);point.y=walk_height([],point.x,point.z)
            blocked=-1;detours=0
            loop k in 1..landing.route.len():
                goal=landing.route[k]
                count=max(1,int(ceil(f64(length(goal.xz-vec2(f32(point.x),f32(point.z))))/0.25)))
                stuck=false
                loop step in 0..count:
                    delta=vec2(f32(f64(goal.x)-point.x),f32(f64(goal.z)-point.z))/f32(count-step)
                    old=point;point=walk_step_precise([],point,delta)
                    if abs(point.x-old.x-f64(delta.x))>0.02 or abs(point.z-old.z-f64(delta.y))>0.02:stuck=true;break
                # A detour rejoins the line a short way on; long survey segments are
                # walked in pieces rather than one huge search.
                loop stuck:
                    here=vec2(f32(point.x),f32(point.z));left=f64(length(goal.xz-here))
                    aim=if left<=30.0:goal.xz else:here+normalize(goal.xz-here)*30.0
                    r=audit_reach(towns,world_vec(point),aim,1.5,6000,1.0)
                    if not r.reached:blocked=k;break
                    detours+=1;point=world_point(r.near)
                    if left<=30.0:stuck=false;break
                    rest=max(1,int(ceil(f64(length(goal.xz-vec2(f32(point.x),f32(point.z))))/0.25)));stuck=false
                    loop step in 0..rest:
                        delta=vec2(f32(f64(goal.x)-point.x),f32(f64(goal.z)-point.z))/f32(rest-step)
                        old=point;point=walk_step_precise([],point,delta)
                        if abs(point.x-old.x-f64(delta.x))>0.02 or abs(point.z-old.z-f64(delta.y))>0.02:stuck=true;break
                if blocked>=0:break
            if blocked>=0:findings.push(AuditFinding(true,250.0,"landing approach blocked",s.id,s.name,world_vec(point),"surveyed path to the landing stops at segment {blocked} of {landing.route.len()-1}",audit_key("landing",s.id,0)))
        else if reach:
            start=if p.loading.len()>0:p.loading[0] else:p.board
            r=audit_reach(towns,start,s.center.xz,8.0,20000)
            if not r.reached:findings.push(AuditFinding(true,300.0+r.closest,"harbour cut off from its square",s.id,s.name,start,"no walkable route from the quay; closest approach {r.closest:.0f} m at {r.near}",audit_key("reach",s.id,0)))
        if not s.remote_harbor and p.quays.len()>0:
            root=p.quays[0].a;rise=audit_cliff(towns,root,-s.out)
            if rise>8.0:findings.push(AuditFinding(rise>20.0,(if rise>20.0:110.0 else:14.0)+rise,"cliff behind the quay",s.id,s.name,root,"ground rises {rise:.0f} m within 12 m inland of the quay root",audit_key("cliff",s.id,0)))

    # ---- thermal baths ----
    loop site in THERMAL_SITES:
        if scope!="all":continue
        audit_prop(towns,findings,"bath entry",site.place,site.name,0,thermal_entry(site))
        audit_prop(towns,findings,"inn door",site.place,site.name,1,thermal_inn(site))

    # ---- roads end at their places ----
    loop k in 0..settlement_roads.len():
        if scope!="all":break
        r=settlement_roads[k]
        if r.points.len()<2 or r.a==r.b or not (r.a in settlement_by_id) or not (r.b in settlement_by_id):continue
        a=world_settlements[settlement_by_id[r.a]];b=world_settlements[settlement_by_id[r.b]]
        ea=f64(length(r.points[0].xz-a.center.xz));eb=f64(length(r.points[r.points.len()-1].xz-b.center.xz))
        if max(ea,eb)>40.0:findings.push(AuditFinding(true,200.0+max(ea,eb),"road ends at nothing",r.a,a.name,if ea>eb:r.points[0] else:r.points[r.points.len()-1],"road {k} ({a.name} - {b.name}) ends {max(ea,eb):.0f} m from its place",audit_key("road",r.a,k)))

    audit_rank(findings)
