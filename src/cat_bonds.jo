# What the town cats remember of the player. Each cat is known by its spot in the town (its key);
# its fondness grows with each stroke and each meal and fades slowly while the player is away.
# Kept in the presentation state, which is saved with the world.
#
# A bond grows in stages, from what the player does, over days rather than at once:
#   a stranger      keeps to its spot; a wary one keeps its distance, a bold one comes to sniff
#   recognises      (fond enough, met on two days or more) comes over when the player comes back
#                   to its town, rubs round his legs, follows a little way, waits by the aircraft
#   adopted         (very fond, met on several days) follows him everywhere on land and comes
#                   aboard; at most one cat at a time (PresentationState.cat)
# Each cat has its temper (bold, easy, wary): how much it will take from the player in one day,
# and how many days it needs. A bond kept apart fades a point every six hours; a cat that has
# come to recognise the player keeps doing so until it has faded far, and an adopted cat stays
# his while fond. With the pilot, or kept by someone he asked, it doesn't fade at all.

use 'living_types.jo'

const CAT_FRIEND = 60              # fondness at which a cat comes to recognise the player
const CAT_FORGET = 35              # and under which it no longer does
const CAT_ADOPT = 95               # fondness at which it adopts him
const CAT_KEEP = 70                # and under which it is no longer his
const CAT_STROKE = 9               # a stroke's worth
const CAT_MEAL = 22                # a meal's worth
const CAT_FADE_MINUTES = 360       # one point of fondness lost for each six hours away
const CAT_HUNGRY_MINUTES = 480     # fed, a cat wants nothing more for eight hours

# tempers
const CAT_BOLD = 0
const CAT_EASY = 1
const CAT_WARY = 2
CAT_TEMPERS = ["bold", "easy", "wary"]
_CAT_DAY_MOST = [40, 30, 18]        # the most it takes to the player in a day
_CAT_KNOW_DAYS = [2, 2, 3]          # days met before it recognises the player
_CAT_ADOPT_DAYS = [5, 6, 8]         # and before it adopts him

# where the adopted cat is (CatCompanion.with)
const CAT_ROAMING = 0
const CAT_WITH = 1
const CAT_KEPT = 2

# the stages
const CAT_STRANGER = 0
const CAT_KNOWS = 1
const CAT_ADOPTED = 2
CAT_STAGES = ["stranger", "recognises", "adopted"]

# a cat's key from its spot (to the half metre, so a spot rebuilt with float noise keeps its cat)
cat_key = (x: f64, z: f64) -> int:
    ix = int(floor(x * 2.0 + 0.5)); iz = int(floor(z * 2.0 + 0.5))
    mod(ix * 73856093 + iz * 19349663, 2147483647)

_cat_hash = (key: int, salt: int) -> int: mod(key * 2654435 + salt * 40503 + 977, 1000003)

# a cat's own temper, from its key: three in ten bold, four easy, three wary
cat_own_temper = (key: int) -> int:
    h = _cat_hash(key, 11) % 10
    if h < 3: CAT_BOLD else: if h < 7: CAT_EASY else: CAT_WARY

cat_day_most = (temper: int) -> int: _CAT_DAY_MOST[clamp(temper, 0, 2)]

cat_temper = (bonds: {int: CatBond}, key: int) -> int:
    b = cat_bond(bonds, key)
    if b.temper >= 0 and b.temper <= 2: b.temper else: cat_own_temper(key)

# whether a cat is a tom (for "he" or "she"), from its key
cat_is_tom = (key: int) -> bool: _cat_hash(key, 29) % 2 == 0

cat_fondness = (b: CatBond, minute: int) -> int:
    max(0, b.fondness - max(0, minute - b.minute) / CAT_FADE_MINUTES)

cat_bond = (bonds: {int: CatBond}, key: int) -> CatBond: bonds.get(key, CatBond())

# the stage of a cat's bond; `adopted` is whether it is the player's own cat (PresentationState.cat)
cat_stage = (bonds: {int: CatBond}, key: int, minute: int, adopted: bool = false) -> int:
    b = cat_bond(bonds, key)
    f = cat_fondness(b, minute)
    if adopted and f >= CAT_KEEP: return CAT_ADOPTED
    if b.known and f >= CAT_FORGET: return CAT_KNOWS
    if f >= CAT_FRIEND and b.days >= _CAT_KNOW_DAYS[cat_temper(bonds, key)]: return CAT_KNOWS
    CAT_STRANGER

cat_is_friend = (bonds: {int: CatBond}, key: int, minute: int) -> bool: cat_stage(bonds, key, minute) >= CAT_KNOWS

# whether a cat is ready to adopt the player now (none other his)
cat_would_adopt = (bonds: {int: CatBond}, key: int, minute: int) -> bool:
    b = cat_bond(bonds, key)
    cat_fondness(b, minute) >= CAT_ADOPT and b.days >= _CAT_ADOPT_DAYS[cat_temper(bonds, key)]

cat_hungry = (bonds: {int: CatBond}, key: int, minute: int) -> bool:
    minute - cat_bond(bonds, key).fed_minute >= CAT_HUNGRY_MINUTES

# a wary cat that doesn't know the player yet keeps out of reach of his hand (it will come to food)
cat_shy = (bonds: {int: CatBond}, key: int, minute: int) -> bool:
    cat_temper(bonds, key) == CAT_WARY and cat_fondness(cat_bond(bonds, key), minute) < 25 and not cat_bond(bonds, key).known

# (the fading is folded in first, so the fondness is always as of the last meeting; a day's gain
# is held to the temper's most for that day)
_cat_add = (bonds: mut {int: CatBond}, key: int, minute: int, amount: int):
    b = cat_bond(bonds, key)
    day = day_index(minute)
    if b.day != day:
        b.day = day; b.gained = 0; b.days += 1
    most = _CAT_DAY_MOST[cat_temper(bonds, key)]
    add = clamp(amount, 0, max(0, most - b.gained))
    b.gained += add
    b.fondness = min(100, cat_fondness(b, minute) + add)
    b.minute = minute
    bonds[key] = b
    if not b.known and cat_stage(bonds, key, minute) >= CAT_KNOWS:
        b.known = true
        bonds[key] = b

# a stroke: worth less for a cat stroked many times in the last hour (it has had its fill)
cat_stroke = (bonds: mut {int: CatBond}, key: int, minute: int):
    b = cat_bond(bonds, key)
    recent = if minute - b.minute < 60: b.strokes else: 0
    _cat_add(bonds, key, minute, max(2, CAT_STROKE - recent * 2))
    b = bonds[key]
    b.strokes = recent + 1
    bonds[key] = b

# a meal; false (and nothing changes) when the cat isn't hungry
cat_feed = (bonds: mut {int: CatBond}, key: int, minute: int) -> bool:
    if not cat_hungry(bonds, key, minute): return false
    _cat_add(bonds, key, minute, CAT_MEAL)
    b = bonds[key]
    b.fed_minute = minute
    bonds[key] = b
    true

# the fondness held where it is (the cat is with the player, or with someone looking after it)
cat_keep_warm = (bonds: mut {int: CatBond}, key: int, minute: int):
    b = cat_bond(bonds, key)
    b.minute = max(b.minute, minute)
    bonds[key] = b

# the stage set outright (the debug page): the fondness and days it takes, now
cat_set_stage = (bonds: mut {int: CatBond}, key: int, minute: int, stage: int):
    b = cat_bond(bonds, key)
    t = cat_temper(bonds, key)
    b.minute = minute
    b.day = day_index(minute); b.gained = 0
    if stage <= CAT_STRANGER:
        b.fondness = 0; b.days = 0; b.known = false
    else if stage == CAT_KNOWS:
        b.fondness = CAT_FRIEND + 10; b.days = max(b.days, _CAT_KNOW_DAYS[t]); b.known = true
    else:
        b.fondness = 100; b.days = max(b.days, _CAT_ADOPT_DAYS[t]); b.known = true
    bonds[key] = b

# ---- the adopted cat (at most one) ----

# Whether the player has a cat (one that has adopted him and is still fond enough to be his).
cat_has = (c: CatCompanion) -> bool: c.key >= 0

# A cat adopts the player: false when another is his already.
cat_adopt = (c: mut CatCompanion, bonds: {int: CatBond}, key: int, coat: int, at: vec3, minute: int) -> bool:
    if c.key >= 0 and c.key != key: return false
    if c.key == key: return true
    c.key = key; c.coat = coat; c.he = cat_is_tom(key); c.name = ""
    c.with = CAT_WITH; c.at = at; c.aboard = false; c.keeper = -1; c.keeper_place = -1
    c.since = minute; c.welcome = []; c.home = at
    true

# The cat no longer the player's (it faded, or was let go): it lives where it is as any town cat.
cat_release = (c: mut CatCompanion):
    c.key = -1; c.with = CAT_ROAMING; c.aboard = false; c.keeper = -1; c.keeper_place = -1; c.name = ""

# Each moment: an adopted cat with the pilot or kept doesn't fade; one left alone fades, and once
# under CAT_KEEP is his no longer (true when it has just gone).
cat_companion_step = (c: mut CatCompanion, bonds: mut {int: CatBond}, minute: int) -> bool:
    if c.key < 0: return false
    if c.with == CAT_WITH or c.with == CAT_KEPT:
        cat_keep_warm(bonds, c.key, minute)
        return false
    if cat_fondness(cat_bond(bonds, c.key), minute) < CAT_KEEP:
        cat_release(c)
        return true
    false

# Left with someone: they look after it, and it may come into their house after.
cat_leave_with = (c: mut CatCompanion, person: int, place: int, door: vec3, minute: int) -> bool:
    if c.key < 0 or c.with != CAT_WITH or c.aboard: return false
    c.with = CAT_KEPT; c.keeper = person; c.keeper_place = place; c.at = door; c.since = minute
    if not c.welcome.contains(person): c.welcome.push(person)
    true

# Picked up from its keeper.
cat_collect = (c: mut CatCompanion, person: int, minute: int) -> bool:
    if c.key < 0 or c.with != CAT_KEPT or c.keeper != person: return false
    c.with = CAT_WITH; c.keeper = -1; c.keeper_place = -1; c.since = minute
    true

# Left alone in a town (the pilot went without it): it keeps to a spot there and remembers him.
cat_leave_alone = (c: mut CatCompanion, at: vec3, minute: int):
    if c.key < 0: return
    c.with = CAT_ROAMING; c.at = at; c.aboard = false; c.keeper = -1; c.keeper_place = -1; c.since = minute

# Come back to him (it found him again in its town).
cat_rejoin = (c: mut CatCompanion, minute: int):
    if c.key < 0 or c.with == CAT_KEPT: return
    c.with = CAT_WITH; c.since = minute

cat_pronoun = (c: CatCompanion) -> str: if c.he: "he" else: "she"
cat_object = (c: CatCompanion) -> str: if c.he: "him" else: "her"
cat_possessive = (c: CatCompanion) -> str: if c.he: "his" else: "her"
# what the pilot and people call it: its name, or "the cat"
cat_called = (c: CatCompanion) -> str: if c.name != "": c.name else: "the cat"
cat_called_cap = (c: CatCompanion) -> str: if c.name != "": c.name else: "The cat"

_TOM_NAMES = ["Mitsos", "Kanellos", "Mavros", "Pipis", "Lefteris", "Tigris", "Stavros", "Fasolis"]
_QUEEN_NAMES = ["Pipitsa", "Lena", "Mavroula", "Kanella", "Zoi", "Rodia", "Asimina", "Fotini"]
# three names to call it by (the coat suggests one: a ginger is cinnamon, a black one dark)
cat_name_choices = (c: CatCompanion) -> str[]:
    names = if c.he: _TOM_NAMES else: _QUEEN_NAMES
    first = if c.coat == 0: 1 else: if c.coat == 1 or c.coat == 4: 2 else: (_cat_hash(c.key, 5) % names.len())
    out = [names[first % names.len()]]
    k = _cat_hash(c.key, 7)
    loop out.len() < 3:
        n = names[k % names.len()]
        if not out.contains(n): out.push(n)
        k += 3
    out

# cats long forgotten are dropped, so the saved list stays short (never the player's own)
prune_cat_bonds = (bonds: mut {int: CatBond}, minute: int, keep: int = -1):
    keys = bonds.keys()
    loop key in keys:
        if key != keep and cat_fondness(bonds[key], minute) == 0 and minute - bonds[key].fed_minute >= CAT_HUNGRY_MINUTES: bonds.remove(key)
