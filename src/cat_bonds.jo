# What the town cats remember of the player. Each cat is known by its spot in the town (its key);
# its fondness grows with each stroke and each meal and fades slowly while the player is away. A
# cat fond enough is a friend: it comes over, follows a little way and waits by the moored aircraft.
# Kept in the presentation state, which is saved with the world.

use 'living_types.jo'

const CAT_FRIEND = 60              # fondness at which a cat is a friend
const CAT_STROKE = 9               # a stroke's worth
const CAT_MEAL = 22                # a meal's worth
const CAT_FADE_MINUTES = 360       # one point of fondness lost for each six hours away
const CAT_HUNGRY_MINUTES = 480     # fed, a cat wants nothing more for eight hours

# a cat's key from its spot (to the half metre, so a spot rebuilt with float noise keeps its cat)
cat_key = (x: f64, z: f64) -> int:
    ix = int(floor(x * 2.0 + 0.5)); iz = int(floor(z * 2.0 + 0.5))
    mod(ix * 73856093 + iz * 19349663, 2147483647)

cat_fondness = (b: CatBond, minute: int) -> int:
    max(0, b.fondness - max(0, minute - b.minute) / CAT_FADE_MINUTES)

cat_bond = (bonds: {int: CatBond}, key: int) -> CatBond: bonds.get(key, CatBond())

cat_is_friend = (bonds: {int: CatBond}, key: int, minute: int) -> bool:
    cat_fondness(cat_bond(bonds, key), minute) >= CAT_FRIEND

cat_hungry = (bonds: {int: CatBond}, key: int, minute: int) -> bool:
    minute - cat_bond(bonds, key).fed_minute >= CAT_HUNGRY_MINUTES

# (the fading is folded in first, so the fondness is always as of the last meeting)
_cat_add = (bonds: mut {int: CatBond}, key: int, minute: int, amount: int):
    b = cat_bond(bonds, key)
    b.fondness = min(100, cat_fondness(b, minute) + amount)
    b.minute = minute
    bonds[key] = b

# a stroke: worth less for a cat stroked many times in the last hour (it has had its fill)
cat_stroke = (bonds: mut {int: CatBond}, key: int, minute: int):
    b = cat_bond(bonds, key)
    recent = if minute - b.minute < 60: b.strokes else: 0
    _cat_add(bonds, key, minute, max(2, CAT_STROKE - recent * 2))
    b = bonds[key]
    b.strokes = recent + 1
    bonds[key] = b

# a meal; false (and nothing changes) when the cat isn't hungry
cat_feed = (bonds: mut {int: CatBond}, key: int, minute: int) -> bool:
    if not cat_hungry(bonds, key, minute): return false
    _cat_add(bonds, key, minute, CAT_MEAL)
    b = bonds[key]
    b.fed_minute = minute
    bonds[key] = b
    true

# cats long forgotten are dropped, so the saved list stays short
prune_cat_bonds = (bonds: mut {int: CatBond}, minute: int):
    keys = bonds.keys()
    loop key in keys:
        if cat_fondness(bonds[key], minute) == 0 and minute - bonds[key].fed_minute >= CAT_HUNGRY_MINUTES: bonds.remove(key)
