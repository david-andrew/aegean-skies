use 'depth_space.jo'
# Aircraft shadows: the aircraft's own mesh flattened along the sunlight onto the water or ground
# below it, a crisp dark shape that runs over the sea beneath a low-flying aircraft. Drawn after
# the sea; each pixel darkened once (the flattened triangles overlap: the second at the same depth
# is turned away).

use 'look.jo'

struct ShadowParams:
    view_proj: mat4
    model: mat4
    sun: vec3
    ground: f32                     # the height it falls on
    color: vec4

struct ShadowOut:
    pos: vec4

shadow_vs = (v: Vertex3D, u: ShadowParams) -> ShadowOut:
    w = u.model * vec4(v.pos, 1)
    s = normalize(u.sun)
    t = (w.y - u.ground) / max(s.y, 0.2)
    p = vec3(w.x - s.x * t, u.ground + 0.07, w.z - s.z * t)
    ShadowOut(u.view_proj * vec4(p, 1))

shadow_fs = (i: ShadowOut, u: ShadowParams) -> vec4: u.color

shadow_sh: Shader

init_shadow = ():
    global shadow_sh
    shadow_sh = make_world_shader(shader(shadow_vs, shadow_fs))

# a shadow of mesh m placed by model, falling on ground height g; fainter the higher above it
draw_shadow = (m: Mesh, model: mat4, g: f64, height: f64, L: Light):
    if L.sun_dir.y < 0.05: return
    a = 0.42 * (1.0 - smoothstep(60.0, 420.0, height)) * smoothstep(0.05, 0.2, f64(L.sun_dir.y))
    if a < 0.01: return
    glDepthMask(1)
    glDepthFunc(GL_LESS)
    draw(shadow_sh, m, ShadowParams(scene_view_proj(), model, L.sun_dir, f32(g), vec4(0.0, 0.05, 0.12, f32(a))))
    glDepthFunc(GL_LEQUAL)
    glDepthMask(0)
