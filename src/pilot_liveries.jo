# Other pilots' liveries: each pilot's aircraft in its own paint, made with the paint shop's own
# tools (a base livery, parts in their own colours, gradients and stripes, a decal or two) from
# the pilot's number alone, so the same pilot always comes out the same and can be told by their
# colours at a distance. The paint is written out (to_text of a Paint) to be kept with the
# aircraft's record; the game builds the model from it (src/aircraft_paint.jo, paint_build).
#
# Pure, and no drawing code: only the paint's data (src/markings.jo) and names of parts and motifs.

use 'markings.jo'
use 'paint_parts.jo'
use 'decals.jo'

enum LiveryStyle: personal, service, pirate

# a number from a pilot's and a question's: the same answer every time, well mixed
_lv_mix = (seed: int, k: int) -> int:
    # (a few turns of a small multiplicative generator: every product stays well inside an int)
    x = ((seed % 2147483647) * 48271 + k * 69621 + 12345) % 2147483647
    loop turn in 0..3: x = (x * 48271 + 11 + turn) % 2147483647
    # (its low bits are its weakest)
    x / 8

_lv_pick = (seed: int, k: int, n: int) -> int: _lv_mix(seed, k) % max(n, 1)

# every colour the shop's palettes offer
_lv_colours = () -> vec4[]:
    out: vec4[]
    loop pal in PALETTES:
        loop sw in pal.1: out.push(sw.colour)
    out

_lv_bright = (c: vec4) -> f64: f64(c.x) * 0.3 + f64(c.y) * 0.59 + f64(c.z) * 0.11

# a pilot's initials, as a decal can paint them ("Dario Ferraro": "DF")
pilot_initials = (name: str) -> str:
    out = ""
    loop word in split(name, " "):
        if word.len() > 0: out = out + word[0..1]
    clean_number(out)

# The paint of the aircraft of pilot `pilot` (a Person's number), of type `kind`, whose record
# wears the base livery `livery`. A service's aircraft (the harbour patrol) keep the service's
# livery and carry the pilot's number; a pirate's is dark with one bold mark; anyone else's is
# their own: two colours of their choosing over the parts, and their mark.
pilot_paint = (pilot: int, kind: int, livery: int, name: str, style: LiveryStyle = .personal) -> Paint:
    p = Paint(kind = kind, livery = livery)
    colours = _lv_colours()
    seed = pilot * 7919 + 17
    if style == .service:
        # (the service's paint, the aircraft's number on the fuselage and its wing)
        number = "{10 + _lv_pick(seed, 1, 89)}"
        p.decals.push(Decal(motif = "text", text = number, spot = "fuselage", size = 0.0, a = vec4(0.09, 0.09, 0.1, 1)))
        p.decals.push(Decal(motif = "text", text = number, spot = "wing-top", size = 0.0, a = vec4(0.09, 0.09, 0.1, 1), both = false))
        return p
    if style == .pirate:
        dark = [rgb(0.09, 0.09, 0.1), rgb(0.43, 0.27, 0.15), rgb(0.4, 0.42, 0.26), rgb(0.15, 0.2, 0.35)][_lv_pick(seed, 2, 4)]
        mark = [rgb(0.78, 0.18, 0.12), rgb(0.95, 0.94, 0.9), rgb(0.85, 0.7, 0.25)][_lv_pick(seed, 3, 3)]
        p.parts.push(PartPaint(part = PART_TAIL, a = dark)); p.parts.push(PartPaint(part = PART_RUDDER, a = mark))
        p.parts.push(PartPaint(part = PART_COWLING, a = mark))
        motif = ["spade", "lightning", "crescent", "cat", "club", "swallow"][_lv_pick(seed, 4, 6)]
        p.decals.push(Decal(motif = motif, spot = "fuselage", size = 0.0, a = mark))
        return p
    # two colours of their own: a strong one, and a second that stands off it
    first = colours[_lv_pick(seed, 5, colours.len())]
    second = first
    loop tries in 0..12:
        second = colours[_lv_pick(seed, 6 + tries, colours.len())]
        if abs(_lv_bright(second) - _lv_bright(first)) > 0.25: break
    bands = 4 + _lv_pick(seed, 20, 3) * 2
    match _lv_pick(seed, 21, 7):
        0:
            # wings in their colour, the rudder in the other
            p.parts.push(PartPaint(part = PART_LEFT_WING, a = first)); p.parts.push(PartPaint(part = PART_RIGHT_WING, a = first))
            p.parts.push(PartPaint(part = PART_RUDDER, a = second))
        1:
            # striped wings and a cowling to match
            p.parts.push(PartPaint(part = PART_LEFT_WING, pattern = PATTERN_STRIPES, a = first, b = second, count = bands))
            p.parts.push(PartPaint(part = PART_RIGHT_WING, pattern = PATTERN_STRIPES, a = first, b = second, count = bands))
            p.parts.push(PartPaint(part = PART_COWLING, a = first))
        2:
            # a fuselage shading from one to the other, the tail in the second
            p.parts.push(PartPaint(part = PART_FUSELAGE, pattern = PATTERN_GRADIENT, a = first, b = second))
            p.parts.push(PartPaint(part = PART_TAIL, a = second)); p.parts.push(PartPaint(part = PART_RUDDER, a = first))
        3:
            # fuselage and floats in one, wings in the other
            p.parts.push(PartPaint(part = PART_FUSELAGE, a = first)); p.parts.push(PartPaint(part = PART_FLOATS, a = first))
            p.parts.push(PartPaint(part = PART_LEFT_WING, a = second)); p.parts.push(PartPaint(part = PART_RIGHT_WING, a = second))
        4:
            # wings shading to their colour at the tips, a banded rudder
            p.parts.push(PartPaint(part = PART_LEFT_WING, pattern = PATTERN_GRADIENT, a = second, b = first))
            p.parts.push(PartPaint(part = PART_RIGHT_WING, pattern = PATTERN_GRADIENT, a = second, b = first))
            p.parts.push(PartPaint(part = PART_RUDDER, pattern = PATTERN_STRIPES, a = first, b = second, across = true, count = 4))
        5:
            # a two-tone fuselage, tail and cowling picked out
            p.parts.push(PartPaint(part = PART_FUSELAGE, pattern = PATTERN_STRIPES, a = second, b = first, across = true, count = 2))
            p.parts.push(PartPaint(part = PART_TAIL, a = first)); p.parts.push(PartPaint(part = PART_COWLING, a = first))
        else:
            # a banded fuselage, wings left as the livery has them, the struts picked out
            p.parts.push(PartPaint(part = PART_FUSELAGE, pattern = PATTERN_STRIPES, a = first, b = second, count = bands))
            p.parts.push(PartPaint(part = PART_STRUTS, a = first)); p.parts.push(PartPaint(part = PART_RUDDER, a = second))
    # their mark: a motif on the fuselage, or their initials; some a second on the wings
    marks = ["gull", "swallow", "stork", "dolphin", "fish", "cat", "star", "anchor", "sun", "heart", "diamond", "compass", "lightning", "arrow", "chevron"]
    ink = if _lv_bright(first) > 0.5: vec4(0.09, 0.09, 0.1, 1) else: vec4(0.95, 0.94, 0.9, 1)
    if _lv_pick(seed, 30, 4) == 0 and pilot_initials(name) != "":
        p.decals.push(Decal(motif = "text", text = pilot_initials(name), spot = "fuselage", size = 0.0, a = ink))
    else:
        p.decals.push(Decal(motif = marks[_lv_pick(seed, 31, marks.len())], spot = if _lv_pick(seed, 32, 3) == 0: "rudder" else: "fuselage", size = 0.0, a = ink))
    if _lv_pick(seed, 33, 3) == 0:
        p.decals.push(Decal(motif = ["disc", "ring", "star", "diamond", "band"][_lv_pick(seed, 34, 5)], spot = "wing-top", size = 0.0, a = second))
    p

# A paint as the aircraft's record keeps it, and back ("" or anything unreadable: no paint).
paint_to_record = (p: Paint) -> str: if p.kind < 0: "" else: to_text(p)
paint_from_record = (s: str) -> Paint:
    if s == "": return Paint()
    p = from_text[Paint](s)
    if p is Paint: return p
    Paint()
