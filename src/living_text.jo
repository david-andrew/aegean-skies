use 'living_types.jo'
use 'living_content.jo'

person_name = (w: World, id: int) -> str: if id >= 0 and id < w.people.len(): w.people[id].name else: "harbor service"
place_name = (id: int) -> str: if id >= 0 and id < PLACE_NAMES.len(): PLACE_NAMES[id] else: "at sea"

say_reason = (w: World, r: Reason) -> str:
    actor = person_name(w,r.actor)
    beneficiary = if r.outside_credit: "the outside credit office" else: person_name(w,r.beneficiary)
    cargo = if r.good >= 0: "{f64(r.quantity)/1000.0:.1} packages of {w.goods[r.good].key}" else: if r.purpose == .passenger: person_name(w,r.counterparty) else: "the dispatch bag"
    match r.purpose:
        .delivery: "{actor} carries {cargo} for {beneficiary} to {place_name(r.destination)}."
        .salvage: "{actor} is working a salvage shift at {place_name(r.destination)} for {f64(r.amount_cents)/100.0:.2} lire."
        .report: "{actor} carries {person_name(w,r.counterparty)}'s supply report from {place_name(r.origin)} to {beneficiary} at {place_name(r.destination)}."
        .settle: "{actor} owes {beneficiary} {f64(r.amount_cents)/100.0:.2} lire at {place_name(r.destination)}."
        .visit: "{actor} visits the quay at {place_name(r.destination)}."
        .repair: "{actor} needs {beneficiary}'s engine service: {f64(r.amount_cents)/100.0:.2} lire."
        .raid: "{actor} seeks {person_name(w,r.counterparty)}'s cargo to provision the crew at {place_name(r.destination)}."
        .patrol: "{actor} patrols the reported lane near {place_name(r.destination)}."
        .fishing: "{actor} works the fishing grounds outside {place_name(r.origin)}."
        .trade: "{actor} takes {cargo} to sell at {place_name(r.destination)}."
        .return_home: "{actor} returns home to {place_name(r.destination)}."
        .rescue: "Harbor boat rescues {actor} near {place_name(r.destination)}."
        else: "{actor} travels to {place_name(r.destination)} for {beneficiary}."
