# Facts a named resident can know: their work/meal/route, the local counter and carried news.
use 'living_types.jo'
use 'living_far_types.jo'
use 'life_types.jo'
use 'living_talk_context.jo'
use 'living_place_context.jo'
use 'living_far_people.jo'
use 'living_commissions.jo'

far_speech_candidates = (w: World, speaker: int, listener: int, topic: TalkTopic) -> SpeechCandidate[]:
    p = w.people[speaker]; a = w.far.people[speaker]; d = w.far.districts[p.far_place]
    where = life_place_name(w,p.far_place); name = ctx_name(w,listener)
    role = match a.role:
        .trader: "tend the market counter"
        .farmer: "work the fields"
        .fisher: "work at the quay"
        .artisan: "work at the workshop"
        .keeper: "keep the store"
        .clerk: "keep the local books"
        .pilot: "fly the post"
        .sailor: "work the coasting boats"
    result: SpeechCandidate[]
    match topic:
        .home, .troubles:
            venue = far_person_venue(w,speaker)
            target = ctx_venue(venue.kind)
            result = ctx_bank(["I {role} in {where}. My next stop is {target}."],"far-day:{a.role}:{venue.kind}")
            if a.blocked!="": result += ctx_bank(["I was going to {target} in {where}, but I cannot get through. I need a clear walking route."],"far-route-blocked",135)
            if a.hungry_days>0: result += ctx_bank(["I couldn't buy my grain at {where} today. I won't promise to carry anything until I've seen the counter.","No grain bought today, {name}. Ask the {where} market for the price before you offer me supper."],"far-food-short",130)
        .market:
            if a.prices_minute<0: return []
            g = d.output; cents = a.seen_prices[g]
            result = ctx_bank(["The {w.goods[g].key} quote here at {where} is {ctx_money(cents)} a package when I was at the counter, {ctx_time(w,a.prices_minute)}. Look again before you pay.","{where}'s counter quotes {ctx_money(cents)} for a package of {w.goods[g].key}. I heard it {ctx_time(w,a.prices_minute)}; I can't quote the next island."],"far-local-quote:{g}:{cents}")
        .work:
            result=mission_speech_candidates(w,speaker)
            ids=w.far.commissions.keys(); ids.sort()
            loop id in ids:
                c=w.far.commissions[id]
                if c.poster==speaker and c.phase==.open and w.minute<=c.deadline:
                    need=c.provenance.cause
                    intro=match voice_of_context(w,speaker):
                        .salt: "Here's the load and the reason for it."
                        .shop: "Let me give you the order and the terms."
                        .formal: "I can offer this delivery."
                        .anxious: "Yes, and I'd like to get it sent."
                        .warm: "There's something you could take for me."
                        .measured: "There is a delivery, with the payment set aside."
                        .wry: "Yes. An order with money behind it."
                        .guarded: "I'll tell you what I've agreed to send."
                    result.push(SpeechCandidate("commission:{id}","{intro} {need} I've {if c.good>=0: "{f64(c.quantity)/1000.0:.1} packages of {w.goods[c.good].key}" else: "a sealed dispatch"} here for {life_place_name(w,c.destination)}. The carriage pays {ctx_money(c.reward)}, due {ctx_time(w,c.deadline)}; collect it at my counter and bring it to theirs.",140,commission=id))
            if result.len()>0: return result
            # No unowned board offers and no fictional job created by the conversation.
            result = ctx_bank(["No commission of mine, {name}. I {role} at {where}; I've no paid load to promise you.","Nothing I'm paying you to carry, {name}. Ask the sender at the {where} counter for their own terms."],"far-no-own-work")
        .people:
            loop other in d.named:
                if other==speaker: continue
                # This is an observed nearby neighbor, not an omniscient directory.
                if length(w.people[other].pose.pos-p.pose.pos)>40: continue
                result += ctx_bank(["That's {w.people[other].name}, here in {where}. Speak to them; I won't answer for their business."],"far-neighbor:{other}")
        .news: result=far_report_candidates(w,speaker)
        .music:
            result = ctx_bank(["The {where} square is where I go this evening. I haven't heard a musician playing here yet."],"far-square")
        _: pass
    result

far_question_answer = (w: World, speaker: int, q: TalkQuestion) -> str[]:
    p = w.people[speaker]; a = w.far.people[speaker]
    where = life_place_name(w,p.far_place); venue = far_person_venue(w,speaker)
    match q.kind:
        .route: ["As far as {ctx_venue(venue.kind)} here in {where}. I haven't booked a crossing."]
        .company: ["I've a little time here in {where}, before I go to {ctx_venue(venue.kind)}. Stay and talk."]
        .day: ["{where}, {ctx_time(w,w.minute)}: I've {a.worked_minutes} minutes of work to settle at the counter. Then I'm going to {ctx_venue(venue.kind)}."]
        .meal: [if a.hungry_days>0: "I couldn't buy grain at {where} today. That is what I must see to next." else: if a.last_meal_day==day_index(w.minute): "I bought my grain at {where} today. You needn't send me to the counter twice." else: "I haven't bought my grain at {where} today. I must stop at the counter."]
        _: []

far_report_candidates = (w: World, speaker: int) -> SpeechCandidate[]:
    result: SpeechCandidate[]
    loop r in w.people[speaker].far_reports:
        if w.minute-r.occurred_minute>=10080: continue
        where=life_place_name(w,r.origin); dated=ctx_time(w,r.occurred_minute)
        # A counter notice is an attributed written account, not a claim that its original
        # witness personally spoke to every person who later carries a copy of the report.
        text=match voice_of_context(w,speaker):
            .salt: "From {where}, {dated}: '{r.text}' That's the notice."
            .shop: "The {where} counter passed this on, {dated}: '{r.text}'"
            .formal: "The notice from {where}, dated {dated}, reads: '{r.text}'"
            .anxious: "They had this up at {where}, {dated}: '{r.text}'"
            .warm: "Here is the word from {where}, {dated}: '{r.text}'"
            .measured: "Dated {dated}, from {where}: '{r.text}'"
            .wry: "The {where} notice has something to say, {dated}: '{r.text}'"
            .guarded: "This is the {where} account, {dated}: '{r.text}'"
        result.push(SpeechCandidate("far-report:{r.id}",text,115+r.severity/10,source_person=r.source_person,confidence=r.confidence,far_news=r.id))
    result

# A signer can offer their own funded military work. Other people can repeat only a dated
# notice actually carried in their memory; a heard notice never promises a live remote offer.
mission_speech_candidates = (w: World, speaker: int) -> SpeechCandidate[]:
    result: SpeechCandidate[]
    ids=w.war.missions.keys(); ids.sort()
    own: {int: bool}
    loop id in ids:
        m=w.war.missions[id]
        if m.poster==speaker and m.state==.open and w.minute<=m.deadline:
            result.push(SpeechCandidate("military:{id}","I signed this commission: {m.why}",155,mission=id,commission=m.commission))
            own[id]=true
    loop r in w.people[speaker].far_reports:
        if r.mission<0 or r.mission in own or w.minute-r.occurred_minute>=2880: continue
        result.push(SpeechCandidate("military-notice:{r.id}","The office at {life_place_name(w,r.origin)} posted this {ctx_time(w,r.occurred_minute)}: '{r.text}' Ask there whether anyone has taken it.",130,source_person=r.source_person,confidence=r.confidence,far_news=r.id,mission=r.mission))
    result
