# Built stone stairways (a kalderimi on a steep shore): switchback flights that
# stand against the slope, with real treads, masonry down to the ground and a
# parapet on the open side. A stairway is its own walking surface: the treads
# are the contact, not the cliff behind them. Pure geometry; callers own where
# the points come from and whether the mesh is drawn.

const STAIR_RISER=0.17
const STAIR_GRADE=0.62             # rise per metre of run, a steep but ordinary stair
const STAIR_WIDTH=2.4

# Tread height along one flight: risers are quantised so a walker climbs real
# steps rather than a ramp; landings (flat segments) stay flat.
stair_tread=(a:vec3,b:vec3,u:f64)->f64:
    rise=f64(b.y-a.y)
    if abs(rise)<0.05:return f64(a.y)
    steps=max(1,int(ceil(abs(rise)/STAIR_RISER)))
    k=clamp(int(floor(u*f64(steps))),0,steps-1)
    f64(a.y)+rise*f64(k+1)/f64(steps)

# Walking contact for one stairway centreline. Inside its footprint the tread is authoritative.
stair_height=(points:vec3[],width:f64,p:vec2,ground:f64)->f64:
    result=ground;best=1e9
    loop k in 1..points.len():
        a=points[k-1];b=points[k];d=b.xz-a.xz;span=f64(length(d))
        if span<0.01:continue
        u=f64(dot(p-a.xz,d))/(span*span)
        if u< -0.02 or u>1.02:continue
        side=abs(f64(dot(p-a.xz,vec2(-d.y,d.x)))/span)
        if side>width*0.5:continue
        tread=stair_tread(a,b,clamp(u,0.0,1.0))
        # (the treads are the contact wherever the stair runs, however high the rock it is cut into
        # stands over them: a stair is one direction only, so no other flight of it is overhead.
        # Taking the rock's height wherever it stood more than 1.2 m above the tread made a step no
        # walker climbs, and the Agios Nikolaos stair stopped at its sixth tread)
        # Where two flights' footprints touch at a turn, keep the nearer one.
        if side<best or (side==best and tread>result):best=side;result=tread
    # Each turn is a round landing, so the outside of a bend has no gap.
    if best>width*0.5:
        loop k in 1..points.len()-1:
            q=points[k];gap=f64(length(p-q.xz))
            if gap<=width*0.5 and gap<best:best=gap;result=f64(q.y)
    result

# Whether p, at height y, stands on this stair's treads or landings.
on_stair=(points:vec3[],width:f64,p:vec2,y:f64)->bool:
    abs(stair_height(points,width,p,-1e9)-y)<0.6

# The parapet: a step from a stair's treads to beside it, onto ground more than a step below the
# tread (the open side, over the cliff face), is refused. Its two ends meet the quay and the ground
# above level, so they stay open.
stair_parapet_blocks=(points:vec3[],width:f64,from:vec2,from_y:f64,to:vec2,to_ground:f64)->bool:
    if not on_stair(points,width,from,from_y):return false
    if stair_height(points,width,to,-1e9)>-1e8:return false
    to_ground<from_y-0.6

stair_bounds=(points:vec3[],width:f64)->vec4:
    low=points[0].xz;high=low
    loop q in points:low=min(low,q.xz);high=max(high,q.xz)
    vec4(low.x-f32(width),low.y-f32(width),high.x+f32(width),high.y+f32(width))

# Plan a stair climbing diagonally along a steep shore: flights at STAIR_GRADE
# separated by flat landings, each point kept where the ground meets the tread
# so the stair stands on the slope instead of floating over the water or burying
# itself. One direction only: switchbacks on a near-vertical face would stack
# flights over one another in plan, and contact cannot tell those apart.
# ground(x,z) is the canonical surface; along is the run direction, inland points
# up the slope. Returns [] when the face runs out before the top is reached.
# edge>0 sets the centreline that far out from where the rock meets the tread,
# so the walking width stands on masonry against the face, not in the rock.
# rest is the length of the flat landing between flights.
plan_cliff_stair=(ground:(f64,f64)->f64,start:vec3,top:f64,along:vec2,inland:vec2,run:f64=20.0,reach:f64=420.0,edge:f64=0.0,rest:f64=3.0)->vec3[]:
    points=[start];y=f64(start.y);s=0.0;depth=0.0;flight=0.0;goal=top
    # Past the nominal top, keep climbing until the ground inland of the last
    # tread carries on gently: a stair that ends below a ledge leads nowhere.
    joins=()->bool:
        last=points[points.len()-1]
        a=last.xz+inland*f32(1.5+edge);b=last.xz+inland*f32(3.0+edge)
        ground(f64(a.x),f64(a.y))-f64(last.y)<=0.9 and ground(f64(b.x),f64(b.y))-f64(last.y)<=2.2
    loop y<goal-0.05 or not joins():
        if y>=goal-0.05:goal=y+2.0*STAIR_GRADE
        if s>reach:return []
        landing=flight>=run
        s+=if landing:rest else:2.0
        if landing:flight=0.0
        else:y=min(goal,y+2.0*STAIR_GRADE);flight+=2.0
        at=start.xz+along*f32(s);r=max(0.0,depth-3.0);found=false
        loop r<depth+40.0:
            q=at+inland*f32(r+edge)
            if ground(f64(q.x),f64(q.y))>=y-0.45:found=true;break
            r+=0.25
        if not found:return []
        depth=r
        points.push(vec3(at.x+inland.x*f32(r),f32(y),at.y+inland.y*f32(r)))
    # Step off onto the ground just inland of the top tread.
    last=points[points.len()-1];exit=last.xz+inland*f32(1.5+edge)
    points.push(vec3(exit.x,f32(max(f64(last.y),ground(f64(exit.x),f64(exit.y)))),exit.y))
    points

# Steps, the masonry they stand on and a parapet along the downhill side.
# coarse (the aerial silhouette) lays one block per few treads and no parapet.
# parapet_drop: a parapet only where the ground on the open side falls more than this below the
# treads (0: always; a hillside lane's gentle stretches have none)
add_stairway_mesh=(vs:mut Vertex3D[],points:vec3[],width:f64,ground:(f64,f64)->f64,stone:vec4,origin:vec3=vec3(0,0,0),coarse:bool=false,parapet_drop:f64=0.0):
    loop k in 1..points.len():
        a=points[k-1];b=points[k];d=b.xz-a.xz;span=f64(length(d))
        if span<0.01:continue
        yaw=atan2(f64(d.x),f64(d.y));side=vec2(-d.y,d.x)/f32(span)
        rise=f64(b.y-a.y);steps=if abs(rise)<0.05:1 else:max(1,int(ceil(abs(rise)/STAIR_RISER)))
        if coarse:steps=max(1,steps/4)
        loop n in 0..steps:
            u0=f64(n)/f64(steps);u1=f64(n+1)/f64(steps);mid=mix(a.xz,b.xz,f32((u0+u1)*0.5))
            top=stair_tread(a,b,(u0+u1)*0.5)
            low=top
            loop q in [mid+side*f32(width*0.5),mid-side*f32(width*0.5),mid]:low=min(low,ground(f64(q.x),f64(q.y)))
            bottom=max(low-0.4,top-40.0)
            tint=stone*vec4(f32(0.92+f64((n*7+k*3)%5)*0.025),1,1,1)
            add_box(vs,vec3(0,0,0),vec3(f32(width),f32(top-bottom),f32(span/f64(steps))+0.02),tint,translation(vec3(mid.x,f32((top+bottom)*0.5),mid.y)-origin)*rotation_y(yaw))
        if coarse:continue
        # A low parapet on the side where the ground falls away, one stone
        # course per tread so it follows the steps instead of standing as a wall.
        mid=(a.xz+b.xz)*0.5
        left=ground(f64(mid.x+side.x*f32(width)),f64(mid.y+side.y*f32(width)))
        right=ground(f64(mid.x-side.x*f32(width)),f64(mid.y-side.y*f32(width)))
        open=if left<right:side else: -side
        if parapet_drop>0.0 and min(left,right)>f64(a.y+b.y)*0.5-parapet_drop:continue
        loop n in 0..steps:
            u=(f64(n)+0.5)/f64(steps);at=mix(a.xz,b.xz,f32(u))+open*f32(width*0.5-0.18)
            top=stair_tread(a,b,u)
            add_box(vs,vec3(0,0,0),vec3(0.36,0.9,f32(span/f64(steps))+0.02),stone*vec4(0.9,0.9,0.88,1),translation(vec3(at.x,f32(top+0.45),at.y)-origin)*rotation_y(yaw))


# Does ordinary ground (no steeper than 45°) lead from a stair's top to a goal?
# A small flood fill on a 1 m grid; a stair that ends on a ledge is no access.
stair_top_reaches=(ground:(f64,f64)->f64,from:vec3,goal:vec2,radius:f64=10.0,budget:int=20000)->bool:
    key=(i:int,j:int)->int:(i+4096)*8192+(j+4096)
    seen:{int:f64}={key(0,0):f64(from.y)};queue:(f64,int,int)[]=[(f64(length(goal-from.xz)),0,0)]
    loop queue.len()>0 and seen.len()<budget:
        item=queue.heap_pop();i=item.1;j=item.2;h=seen[key(i,j)]
        p=from.xz+vec2(f32(i),f32(j))
        if f64(length(goal-p))<=radius:return true
        loop dj in -1..2:
            loop di in -1..2:
                if di==0 and dj==0 or key(i+di,j+dj) in seen:continue
                q=from.xz+vec2(f32(i+di),f32(j+dj));hq=ground(f64(q.x),f64(q.y))
                if hq<0.3 or abs(hq-h)>f64(length(q-p))*1.0+0.15:continue
                seen[key(i+di,j+dj)]=hq;queue.heap_push((f64(length(goal-q)),i+di,j+dj))
    false

# One six-sided block between two end sections of a stair: at a it spans outward
# offsets lo..hi from the centreline (side points outward) and heights ya0..ya1,
# at b the same offsets and yb0..yb1. Sloped parapets, cut walls and arched
# skirts follow the stair with one block per stretch instead of one per tread.
# tag 184 is coursed masonry (its joints run along the stair), 182 a plain
# limewashed or rock surface; both take the neutral shade fill, not blue sky.
add_stair_block=(vs:mut Vertex3D[],a:vec2,b:vec2,side:vec2,lo:f64,hi:f64,ya0:f64,ya1:f64,yb0:f64,yb1:f64,color:vec4,tag:f64,along0:f64=0.0):
    if f64(length(b-a))<0.001:return
    at=(p:vec2,offset:f64,y:f64)->vec3:
        q=p+side*f32(offset);vec3(q.x,f32(y),q.y)
    add_stair_hexa(vs,[at(a,lo,ya0),at(a,hi,ya0),at(b,hi,yb0),at(b,lo,yb0),at(a,lo,ya1),at(a,hi,ya1),at(b,hi,yb1),at(b,lo,yb1)],a,normalize(b-a),color,tag,along0)

# Any convex six-sided block from its corners: bottom c0..c3, then top c4..c7
# above them in the same order. Faces are turned outward from its centre.
add_stair_hexa=(vs:mut Vertex3D[],c:vec3[],a:vec2,dir:vec2,color:vec4,tag:f64,along0:f64=0.0):
    centre=vec3(0,0,0)
    loop q in c:centre+=q*0.125
    surface=(q:vec3)->vec2:
        if tag==184.0:
            along=(along0+f64(dot(q.xz-a,dir)))%300.0
            return vec2(f32(184.0+along/1024.0),q.y)
        vec2(f32(tag),0)
    loop f in [[0,1,2,3],[7,6,5,4],[0,4,5,1],[1,5,6,2],[2,6,7,3],[3,7,4,0]]:
        loop tri in [[f[0],f[1],f[2]],[f[0],f[2],f[3]]]:
            p0=c[tri[0]];p1=c[tri[1]];p2=c[tri[2]]
            n=cross(p1-p0,p2-p0)
            if length(n)<0.000001:continue
            n=normalize(n)
            if dot(n,(p0+p1+p2)/3.0-centre)<0.0:
                n=-n;swap=p1;p1=p2;p2=swap
            vs.push(Vertex3D(p0,n,surface(p0),color))
            vs.push(Vertex3D(p1,n,surface(p1),color))
            vs.push(Vertex3D(p2,n,surface(p2),color))

const CLIFF_PIER_SPACING=7.0
# A stair built against a sea cliff: pale dressed treads notched against the
# face, a cut rock wall rising on the inner side, a short masonry skirt whose
# soffit arches between slim buttress piers carried down to the rock, and a
# sloped limewashed parapet on the open side. shrines puts a small limewashed
# wayside shrine into the rock wall at alternate landings. coarse (the aerial
# silhouette) keeps the pale treads and the parapet line, with a plain skirt.
add_cliff_stair_mesh=(vs:mut Vertex3D[],points:vec3[],width:f64,ground:(f64,f64)->f64,coarse:bool=false,shrines:bool=false):
    tread_colour=rgb(0.86,0.82,0.72);rock=rgb(0.74,0.71,0.64);white=rgb(0.95,0.94,0.90)
    half=width*0.5;t=0.0;landings=0
    g=(p:vec2)->f64:ground(f64(p.x),f64(p.y))
    # Depth of the skirt below the tread at distance t along the stair: a
    # shallow segmental arch between corbels, 1 m at its crown, 2.5 m where it
    # springs. Nothing hangs deeper than that; the corbels carry it to the rock.
    skirt=(at:f64)->f64:
        if coarse:return 1.0
        x=(at%CLIFF_PIER_SPACING)/CLIFF_PIER_SPACING*2.0-1.0
        1.0+1.5*(1.0-sqrt(max(0.0,1.0-x*x)))
    loop k in 1..points.len():
        a=points[k-1];b=points[k];d=b.xz-a.xz;span=f64(length(d))
        if span<0.01:continue
        dir=d/f32(span);side=vec2(-dir.y,dir.x)
        # Outward is where the ground falls away.
        if g(a.xz+side*0.8+d*0.5)>g(a.xz-side*0.8+d*0.5):side=-side
        lowest=(p:vec2)->f64:min(g(p+side*f32(half+0.1)),min(g(p),g(p-side*f32(half))))
        rise=f64(b.y-a.y);steps=if abs(rise)<0.05:1 else:max(1,int(ceil(abs(rise)/STAIR_RISER)))
        if coarse:steps=max(1,steps/4)
        loop n in 0..steps:
            u0=f64(n)/f64(steps);u1=f64(n+1)/f64(steps)
            p0=mix(a.xz,b.xz,f32(u0));p1=mix(a.xz,b.xz,f32(u1))
            top=stair_tread(a,b,(u0+u1)*0.5)
            b0=max(lowest(p0)-0.4,top-skirt(t+u0*span));b1=max(lowest(p1)-0.4,top-skirt(t+u1*span))
            add_stair_block(vs,p0,p1,side,-half,half,b0,top,b1,top,tread_colour,184.0,t+u0*span)
        # The parapet slopes with the flight, a limewashed coping on the open side.
        add_stair_block(vs,a.xz,b.xz,side,half-0.36,half,f64(a.y)-0.4,f64(a.y)+0.9,f64(b.y)-0.4,f64(b.y)+0.9,white,182.0)
        if not coarse:
            # Raking corbels under the open side: from the arch springing at the
            # outer edge, back and down into the face where the rock is.
            pier=ceil(t/CLIFF_PIER_SPACING)*CLIFF_PIER_SPACING
            loop pier<=t+span:
                u=clamp((pier-t)/span,0.0,1.0);q=mix(a.xz,b.xz,f32(u))
                top=stair_tread(a,b,u)-skirt(pier)+0.15
                # The face at 2 m below the springing: outermost offset where the rock stands that high.
                depth=top-2.0;face= -half
                r=half+0.2
                loop r>= -half:
                    if g(q+side*f32(r))>=depth:face=r;break
                    r-=0.1
                if g(q+side*f32(half+0.2))<top-0.3:
                    c:vec3[]
                    loop level in [(depth-0.3,face-0.6,face+0.1),(top,-half*0.3,half+0.18)]:
                        loop corner in [(-0.42,level.1),(-0.42,level.2),(0.42,level.2),(0.42,level.1)]:
                            p=q+dir*f32(corner.0)+side*f32(corner.1);c.push(vec3(p.x,f32(level.0),p.y))
                    add_stair_hexa(vs,c,a.xz,dir,tread_colour,184.0,pier)
                pier+=CLIFF_PIER_SPACING
            # The rock cut back behind the tread: its face stands where the
            # ground meets the tread, and it rises as high as the slope allows.
            contact=half
            r=0.0
            loop r<=half:
                q=(a.xz+b.xz)*0.5-side*f32(r)
                if g(q)>=(f64(a.y)+f64(b.y))*0.5-0.1:contact=max(0.3,r);break
                r+=0.1
            # Rough-cut: its top breaks irregularly between 1.3 and 2.6 m.
            rough=(p:vec3)->f64:
                h=sin(f64(p.x)*12.9898+f64(p.z)*78.233)*43758.5453
                1.3+(h-floor(h))*1.3
            above=(p:vec3)->f64:min(f64(p.y)+rough(p),g(p.xz-side*f32(contact+1.5))+0.2)
            ta=above(a);tb=above(b)
            if ta>f64(a.y)+0.5 and tb>f64(b.y)+0.5:
                add_stair_block(vs,a.xz,b.xz,side,-contact-0.5,-contact,f64(a.y)-0.5,ta,f64(b.y)-0.5,tb,rock,182.0)
            if abs(rise)<0.05 and span>=2.5:
                landings+=1
                if shrines and landings%2==1:
                    m=(a.xz+b.xz)*0.5;y=f64(a.y)
                    add_stair_block(vs,m-dir*0.5,m+dir*0.5,side,-contact-0.45,-contact+0.12,y-0.1,y+1.55,y-0.1,y+1.55,white,182.0)
                    add_stair_block(vs,m-dir*0.22,m+dir*0.22,side,-contact+0.12,-contact+0.16,y+0.75,y+1.25,y+0.75,y+1.25,rgb(0.18,0.27,0.44),0.0)
                    add_stair_block(vs,m-dir*0.62,m+dir*0.62,side,-contact-0.5,-contact+0.22,y+1.55,y+1.72,y+1.55,y+1.72,rgb(0.66,0.33,0.22),0.0)
        t+=span


# A stepped lane over a hillside, from a stair's top to the nearest of goals (the houses' front
# steps): a search over a 1.5 m grid that keeps to gentle ground (steeper than LANE_GRADE refused,
# steeper than a stroll costs more), clear of the sea and of `blocked` (the houses), then pulled
# into straight runs wherever the ground allows and resampled every 2 m on the ground. [] when no
# way is found within reach.
const LANE_GRADE=0.85
const LANE_CELL=1.5

_lane_ok=(ground:(f64,f64)->f64,blocked:(vec2)->bool,a:vec2,b:vec2)->bool:
    n=max(1,int(ceil(f64(length(b-a)))));prev=ground(f64(a.x),f64(a.y))
    loop k in 1..n+1:
        p=mix(a,b,f32(f64(k)/f64(n)));h=ground(f64(p.x),f64(p.y))
        if h<1.6 or blocked(p) or abs(h-prev)>LANE_GRADE*f64(length(b-a))/f64(n)+0.05:return false
        prev=h
    true

plan_hill_lane=(ground:(f64,f64)->f64,from:vec3,goals:vec2[],blocked:(vec2)->bool,reach:f64=400.0,budget:int=120000)->vec3[]:
    if goals.len()==0:return []
    key=(i:int,j:int)->int:(i+4096)*8192+(j+4096)
    at=(i:int,j:int)->vec2:from.xz+vec2(f32(f64(i)*LANE_CELL),f32(f64(j)*LANE_CELL))
    near=(p:vec2)->f64:
        best=1e18
        loop g in goals:best=min(best,f64(length(g-p)))
        best
    cost:{int:f64}={key(0,0):0.0};back:{int:int}={key(0,0):-1}
    queue:(f64,int,int)[]=[(near(from.xz),0,0)];done=-1
    loop queue.len()>0 and cost.len()<budget:
        item=queue.heap_pop();i=item.1;j=item.2;k=key(i,j);p=at(i,j)
        if near(p)<=LANE_CELL*1.2:done=k;break
        if f64(length(p-from.xz))>reach:continue
        hp=ground(f64(p.x),f64(p.y))
        if item.0-near(p)>cost[k]+1e-6:continue
        loop dj in -1..2:
            loop di in -1..2:
                if di==0 and dj==0:continue
                q=at(i+di,j+dj);hq=ground(f64(q.x),f64(q.y));run=f64(length(q-p))
                grade=abs(hq-hp)/run
                if hq<1.6 or grade>LANE_GRADE or blocked(q):continue
                c=cost[k]+run*(1.0+6.0*max(0.0,grade-0.25))
                nk=key(i+di,j+dj)
                if nk in cost and cost[nk]<=c:continue
                cost[nk]=c;back[nk]=k;queue.heap_push((c+near(q),i+di,j+dj))
    if done<0:return []
    # (the grid's cells back to the start)
    cells:vec2[]
    k=done
    loop k>=0:
        i=k/8192-4096;j=k%8192-4096
        cells.push(at(i,j));k=back[k]
    cells.reverse()
    cells[0]=from.xz
    best=goals[0]
    loop g in goals:
        if length(g-cells[cells.len()-1])<length(best-cells[cells.len()-1]):best=g
    cells.push(best)
    # (pulled straight: from each corner, on to the farthest cell the ground lets one walk to)
    pulled:vec2[]=[cells[0]];i=0
    loop i<cells.len()-1:
        j=cells.len()-1
        loop j>i+1 and not _lane_ok(ground,blocked,cells[i],cells[j]):j-=1
        pulled.push(cells[j]);i=j
    # (every 2 m on the ground; the first point the stair's top itself)
    out:vec3[]=[from]
    loop k2 in 1..pulled.len():
        a=pulled[k2-1];b=pulled[k2];n=max(1,int(ceil(f64(length(b-a))/2.0)))
        loop s in 1..n+1:
            p=mix(a,b,f32(f64(s)/f64(n)))
            out.push(vec3(p.x,f32(ground(f64(p.x),f64(p.y))),p.y))
    out
