# Built stone stairways (a kalderimi on a steep shore): switchback flights that
# stand against the slope, with real treads, masonry down to the ground and a
# parapet on the open side. A stairway is its own walking surface: the treads
# are the contact, not the cliff behind them. Pure geometry; callers own where
# the points come from and whether the mesh is drawn.

const STAIR_RISER=0.17
const STAIR_GRADE=0.62             # rise per metre of run, a steep but ordinary stair
const STAIR_WIDTH=2.4

# Tread height along one flight: risers are quantised so a walker climbs real
# steps rather than a ramp; landings (flat segments) stay flat.
stair_tread=(a:vec3,b:vec3,u:f64)->f64:
    rise=f64(b.y-a.y)
    if abs(rise)<0.05:return f64(a.y)
    steps=max(1,int(ceil(abs(rise)/STAIR_RISER)))
    k=clamp(int(floor(u*f64(steps))),0,steps-1)
    f64(a.y)+rise*f64(k+1)/f64(steps)

# Walking contact for one stairway centreline. Inside its footprint the tread is
# authoritative, unless the ground there is much higher (a later flight above).
stair_height=(points:vec3[],width:f64,p:vec2,ground:f64)->f64:
    result=ground;best=1e9
    loop k in 1..points.len():
        a=points[k-1];b=points[k];d=b.xz-a.xz;span=f64(length(d))
        if span<0.01:continue
        u=f64(dot(p-a.xz,d))/(span*span)
        if u< -0.02 or u>1.02:continue
        side=abs(f64(dot(p-a.xz,vec2(-d.y,d.x)))/span)
        if side>width*0.5:continue
        tread=stair_tread(a,b,clamp(u,0.0,1.0))
        if ground>tread+1.2:continue
        # Where two flights' footprints touch at a turn, keep the nearer one.
        if side<best:best=side;result=tread
    # Each turn is a round landing, so the outside of a bend has no gap.
    if best>width*0.5:
        loop k in 1..points.len()-1:
            q=points[k];gap=f64(length(p-q.xz))
            if gap<=width*0.5 and ground<=f64(q.y)+1.2 and gap<best:best=gap;result=f64(q.y)
    result

stair_bounds=(points:vec3[],width:f64)->vec4:
    low=points[0].xz;high=low
    loop q in points:low=min(low,q.xz);high=max(high,q.xz)
    vec4(low.x-f32(width),low.y-f32(width),high.x+f32(width),high.y+f32(width))

# Plan a stair climbing diagonally along a steep shore: flights at STAIR_GRADE
# separated by flat landings, each point kept where the ground meets the tread
# so the stair stands on the slope instead of floating over the water or burying
# itself. One direction only: switchbacks on a near-vertical face would stack
# flights over one another in plan, and contact cannot tell those apart.
# ground(x,z) is the canonical surface; along is the run direction, inland points
# up the slope. Returns [] when the face runs out before the top is reached.
plan_cliff_stair=(ground:(f64,f64)->f64,start:vec3,top:f64,along:vec2,inland:vec2,run:f64=20.0,reach:f64=420.0)->vec3[]:
    points=[start];y=f64(start.y);s=0.0;depth=0.0;flight=0.0;goal=top
    # Past the nominal top, keep climbing until the ground inland of the last
    # tread carries on gently: a stair that ends below a ledge leads nowhere.
    joins=()->bool:
        last=points[points.len()-1]
        a=last.xz+inland*1.5;b=last.xz+inland*3.0
        ground(f64(a.x),f64(a.y))-f64(last.y)<=0.9 and ground(f64(b.x),f64(b.y))-f64(last.y)<=2.2
    loop y<goal-0.05 or not joins():
        if y>=goal-0.05:goal=y+2.0*STAIR_GRADE
        if s>reach:return []
        landing=flight>=run
        s+=if landing:3.0 else:2.0
        if landing:flight=0.0
        else:y=min(goal,y+2.0*STAIR_GRADE);flight+=2.0
        at=start.xz+along*f32(s);r=max(0.0,depth-3.0);found=false
        loop r<depth+40.0:
            q=at+inland*f32(r)
            if ground(f64(q.x),f64(q.y))>=y-0.45:found=true;break
            r+=0.25
        if not found:return []
        depth=r
        points.push(vec3(at.x+inland.x*f32(r),f32(y),at.y+inland.y*f32(r)))
    # Step off onto the ground just inland of the top tread.
    last=points[points.len()-1];exit=last.xz+inland*1.5
    points.push(vec3(exit.x,f32(max(f64(last.y),ground(f64(exit.x),f64(exit.y)))),exit.y))
    points

# Steps, the masonry they stand on and a parapet along the downhill side.
add_stairway_mesh=(vs:mut Vertex3D[],points:vec3[],width:f64,ground:(f64,f64)->f64,stone:vec4,origin:vec3=vec3(0,0,0)):
    loop k in 1..points.len():
        a=points[k-1];b=points[k];d=b.xz-a.xz;span=f64(length(d))
        if span<0.01:continue
        yaw=atan2(f64(d.x),f64(d.y));side=vec2(-d.y,d.x)/f32(span)
        rise=f64(b.y-a.y);steps=if abs(rise)<0.05:1 else:max(1,int(ceil(abs(rise)/STAIR_RISER)))
        loop n in 0..steps:
            u0=f64(n)/f64(steps);u1=f64(n+1)/f64(steps);mid=mix(a.xz,b.xz,f32((u0+u1)*0.5))
            top=stair_tread(a,b,(u0+u1)*0.5)
            low=top
            loop q in [mid+side*f32(width*0.5),mid-side*f32(width*0.5),mid]:low=min(low,ground(f64(q.x),f64(q.y)))
            bottom=max(low-0.4,top-40.0)
            tint=stone*vec4(f32(0.92+f64((n*7+k*3)%5)*0.025),1,1,1)
            add_box(vs,vec3(0,0,0),vec3(f32(width),f32(top-bottom),f32(span/f64(steps))+0.02),tint,translation(vec3(mid.x,f32((top+bottom)*0.5),mid.y)-origin)*rotation_y(yaw))
        # The parapet stands on the side where the ground falls away.
        mid=(a.xz+b.xz)*0.5
        left=ground(f64(mid.x+side.x*f32(width)),f64(mid.y+side.y*f32(width)))
        right=ground(f64(mid.x-side.x*f32(width)),f64(mid.y-side.y*f32(width)))
        open=if left<right:side else: -side
        wall=mid+open*f32(width*0.5-0.18)
        h=f64(a.y+b.y)*0.5
        add_box(vs,vec3(0,0,0),vec3(0.36,1.1+f32(abs(rise)),f32(span)),stone*vec4(0.9,0.9,0.88,1),translation(vec3(wall.x,f32(h+0.45),wall.y)-origin)*rotation_y(yaw))


# Does ordinary ground (no steeper than 45°) lead from a stair's top to a goal?
# A small flood fill on a 1 m grid; a stair that ends on a ledge is no access.
stair_top_reaches=(ground:(f64,f64)->f64,from:vec3,goal:vec2,radius:f64=10.0,budget:int=20000)->bool:
    key=(i:int,j:int)->int:(i+4096)*8192+(j+4096)
    seen:{int:f64}={key(0,0):f64(from.y)};queue:(f64,int,int)[]=[(f64(length(goal-from.xz)),0,0)]
    loop queue.len()>0 and seen.len()<budget:
        item=queue.heap_pop();i=item.1;j=item.2;h=seen[key(i,j)]
        p=from.xz+vec2(f32(i),f32(j))
        if f64(length(goal-p))<=radius:return true
        loop dj in -1..2:
            loop di in -1..2:
                if di==0 and dj==0 or key(i+di,j+dj) in seen:continue
                q=from.xz+vec2(f32(i+di),f32(j+dj));hq=ground(f64(q.x),f64(q.y))
                if hq<0.3 or abs(hq-h)>f64(length(q-p))*1.0+0.15:continue
                seen[key(i+di,j+dj)]=hq;queue.heap_push((f64(length(goal-q)),i+di,j+dj))
    false
