use 'town_details.jo'
use 'river_data.jo'
# Original working canal quarter: all geometry is procedural.
use 'canal_geometry.jo'
use 'canal_city.jo'
use 'objects.jo'
use 'look.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'geography.jo'
use 'river_banks.jo'
use 'river_field.jo'
use 'world_source.jo'
use 'build_slice.jo'
use 'terrain_lod.jo'

# Bucket only the feature IDs up front. Actual vertex generation and GPU uploads
# are spread over frames, nearest visible block first.
struct CanalBatch:
    center:vec3
    items:(int,int)[]
    near:Mesh
    far:Mesh
    has_near:bool=false
    has_far:bool=false
canal_batches:CanalBatch[]
canal_gardens:(vec3,int,int)[]
const CANAL_CELL=144.0
canal_index=(ids:mut {int:int},at:vec3,kind:int,index:int):
    global canal_batches
    x=int(floor(f64(at.x-canal_origin.x)/CANAL_CELL))
    z=int(floor(f64(at.z-canal_origin.z)/CANAL_CELL))
    key=x*16384+z
    if not (key in ids):
        ids[key]=canal_batches.len()
        center=canal_origin+vec3(f32((f64(x)+0.5)*CANAL_CELL),32,f32((f64(z)+0.5)*CANAL_CELL))
        canal_batches.push(CanalBatch(center,[],Mesh(),Mesh()))
    canal_batches[ids[key]].items.push((kind,index))

init_canal=():
    global canal_gardens
    if canal_batches.len()>0:return
    init_canal_geometry()
    ids:{int:int}
    loop i in 0..canal_banks.len():
        bank=canal_banks[i];p=(bank.a+bank.b)*0.5
        canal_index(ids,vec3(p.x,0,p.y),0,i)
    loop i in 0..CANAL_BRIDGES.len():
        p=RIVER_NODES[CANAL_BEGIN+CANAL_BRIDGES[i].local]
        canal_index(ids,vec3(p.x,0,p.y),1,i)
    loop i in 0..canal_solids.len():
        box=canal_solids[i]
        if (box.look>=0 or box.kind==14 or box.kind==15) and box.kind!=7:
            canal_index(ids,box.center,2,i)
    canal_index(ids,canal_workshop,4,0)
    # Index outer gardens now; sample the bank and terrain only when making a tree.
    loop station in 8..64:
        if station%3!=0:continue
        a=RIVER_NODES[CANAL_BEGIN+station];b=RIVER_NODES[CANAL_BEGIN+station+1]
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        loop sign in [-1.0,1.0]:
            loop row in 0..3:
                p=a.xy+side*f32(sign*(f64(a.w)+340.0+f64(row)*23.0))
                tree=vec3(p.x-canal_origin.x,0,p.y-canal_origin.z)
                canal_index(ids,tree+canal_origin,3,canal_gardens.len())
                canal_gardens.push((tree,row,station))

canal_solid_mesh=(vs:mut Vertex3D[],i:int,detailed:bool):
    box=canal_solids[i]
    m=translation(box.center-canal_origin)*rotation_y(-box.heading)
    if box.kind==1 or box.kind==9 or box.kind==10 or box.kind==12 or box.kind==16:
        across=canal_world_dir(vec3(1,0,0),box.heading).xz
        toward=if box.look==3 or box.look==5:-across else:across
        bottom=vec3(box.center.x-canal_origin.x,box.center.y-box.half.y,box.center.z-canal_origin.z)
        frame=canal_facing(bottom,toward)
        if box.kind==9:
            canal_church(vs,frame,i);return
        r=river_at(f64(box.center.x),f64(box.center.z))
        front=r.distance<r.width+CANAL_PROMENADE+CANAL_ROW_DEPTH+2.0
        # (rows three and more back from the water stay plain blocks even near: hidden from the
        # water behind the front rows, and seen from the air mostly as roofs)
        deep=r.distance>r.width+CANAL_PROMENADE+CANAL_ROW_DEPTH*0.5+60.0
        w=f64(box.half.z*2.0);d=f64(box.half.x*2.0);height=f64(box.half.y*2.0)
        canal_block(vs,frame,w,d,height,i*71,if not detailed:0 else:if box.kind==16:1 else:if front:2 else:if deep:0 else:1,canal_flat_roof(i),box.kind==10)
        if not front:
            # (the lanes round a block behind the front row: stone paving, not grass)
            hw=f32(w*0.5+3.2);hd=f32(d*0.5+3.2)
            add_box(vs,vec3(0,-0.5,0),vec3(hw*2.0,1.8,hd*2.0),rgb(0.60,0.57,0.50),frame)
    else if box.kind==14:
        base=vec3(box.center.x-canal_origin.x,box.center.y-box.half.y-0.5,box.center.z-canal_origin.z)
        canal_tower(vs,base,f64(box.center.y+box.half.y-0.6),mat4(),i)
    else if box.kind==15:
        base=vec3(box.center.x-canal_origin.x,box.center.y-box.half.y,box.center.z-canal_origin.z)
        canal_chimney(vs,base,f64(box.half.y*2.0),mat4())
    else if box.kind==13:
        # a timber boatshed: plank walls, a low gable, wide doors to the yard and a plain board
        frame=m*rotation_y(PI*0.5)
        add_box(vs,vec3(0,0,0),box.half*2.0,CANAL_TIMBER,m)
        add_gable(vs,vec3(0,box.half.y,0),f64(box.half.z*2.0),f64(box.half.x*2.0),2.4,rgb(0.34,0.35,0.37),frame)
        if not detailed:return
        loop k in 0..int(box.half.x*2.0/1.2):
            x=f64(-box.half.x)+0.6+f64(k)*1.2
            loop face in [-1.0,1.0]:add_box(vs,vec3(f32(x),0,f32(face*(f64(box.half.z)+0.04))),vec3(0.12,box.half.y*2.0,0.06),rgb(0.36,0.20,0.15),m)
        out=m*rotation_y(PI*0.5)
        canal_opening(vs,0,-f64(box.half.y)+2.6,f64(box.half.x)+0.08,9.0,5.2,rgb(0.20,0.15,0.12),out)
        canal_panel(vs,0,f64(box.half.y)-1.2,f64(box.half.x)+0.1,5.0,1.1,rgb(0.84,0.79,0.64),out)
    else:
        color=if box.look==1:rgb(0.56,0.55,0.51) else:if box.kind==3:rgb(0.18,0.24,0.25) else:if box.kind==4:rgb(0.43,0.32,0.21) else:if box.kind==5:CANAL_TIMBER else:if box.kind==6:rgb(0.31,0.32,0.34) else:if detailed and box.kind==8:CANAL_SHOP_FLOOR else:rgb(0.58,0.55,0.45)
        add_box(vs,vec3(0,0,0),box.half*2.0,color,m)
        if detailed and box.kind==8:
            # (the shop floor: worn concrete with an oil stain or two)
            loop k in 0..2:
                x=f32((f64(canal_hash(i*5+k)%100)/100.0-0.5)*f64(box.half.x)*1.2)
                z=f32((f64(canal_hash(i*9+k)%100)/100.0-0.5)*f64(box.half.z)*1.2)
                r=min(box.half.x,box.half.z)*0.35
                canal_quad(vs,vec3(x-r,box.half.y+0.01,z+r),vec3(x+r,box.half.y+0.01,z+r),vec3(x+r,box.half.y+0.01,z-r),vec3(x-r,box.half.y+0.01,z-r),rgb(0.30,0.29,0.27),m)
        if detailed and box.kind==5:
            # (vertical battens on the workshop's plank walls)
            long=box.half.z>box.half.x
            n=int(f64(if long:box.half.z else:box.half.x)*2.0/1.3)
            loop k in 0..n:
                t=-f64(if long:box.half.z else:box.half.x)+0.65+f64(k)*1.3
                loop face in [-1.0,1.0]:
                    at=if long:vec3(f32(face*(f64(box.half.x)+0.03)),0,f32(t)) else:vec3(f32(t),0,f32(face*(f64(box.half.z)+0.03)))
                    add_box(vs,at,vec3(if long:0.06 else:0.14,box.half.y*2.0,if long:0.14 else:0.06),rgb(0.36,0.20,0.15),m)

canal_shop_mesh=(vs:mut Vertex3D[]):
    # Tools and timber outside the open workshop, clear of its launch path.
    shop=translation(canal_workshop-canal_origin)*rotation_y(-canal_heading-PI*0.5)
    add_cargo(vs,shop*translation(vec3(12,0,8)),7)
    # Two lamps hang over the shop floor, either side of the ways: lit after dark, as the windows are.
    loop x in [-7.0,7.0]:
        add_cylinder(vs,vec3(f32(x),7.6,-2.0),0.02,1.9,CANAL_IRON,4,-1.0,shop)
        add_box(vs,vec3(f32(x),7.35,-2.0),vec3(0.34,0.34,0.34),rgba(1.0,0.86,0.56,0.8),shop)
        add_cylinder(vs,vec3(f32(x),7.45,-2.0),0.75,0.4,rgb(0.24,0.26,0.24),8,0.12,shop)
    # Window bands, timber doorposts and a roof ridge identify the repair shed.
    loop x in [-16.55,16.55]:
        loop z in [-8.0,0.0,8.0]:
            add_box(vs,vec3(x,6,z),vec3(0.12,2.4,3.2),rgb(0.19,0.27,0.28),shop)
    loop x in [-14.0,14.0]:add_box(vs,vec3(x,4.5,15.4),vec3(0.35,9,0.4),rgb(0.30,0.25,0.18),shop)
    add_box(vs,vec3(0,9.2,15.4),vec3(28,0.45,0.4),rgb(0.30,0.25,0.18),shop)
    # The slipway: an even stone ramp from the shop floor into the canal, two greased timber
    # ways on sleepers, and the winch at its head that lets the cradle down.
    angle=atan(slip_slope());run=SLIP_FOOT+1.0-SLIP_TOP;mid=(SLIP_TOP+SLIP_FOOT+1.0)*0.5
    ramp=shop*translation(vec3(0,f32(-(mid-SLIP_TOP)*slip_slope()),f32(mid)))*rotation_x(angle)
    add_box(vs,vec3(0,-0.3,0),vec3(f32(SLIP_HALF*2.0),0.6,f32(run/cos(angle))),CANAL_SHOP_FLOOR,ramp)
    add_box(vs,vec3(0,0.005,f32((SLIP_WATER+0.5-mid)/cos(angle))),vec3(f32(SLIP_HALF*2.0),0.01,1.0),rgb(0.36,0.38,0.31),ramp)
    loop x in [-1.7,1.7]:add_box(vs,vec3(f32(x),0.165,0),vec3(0.3,0.17,f32(run/cos(angle))),rgb(0.22,0.16,0.10),ramp)
    k=0
    loop k<int(run/1.6):
        add_box(vs,vec3(0,0.04,f32((f64(k)+0.5)*1.6-run*0.5)),vec3(4.6,0.08,0.24),rgb(0.30,0.22,0.14),ramp)
        k+=1
    # (the winch stands back toward the rear wall, the shop's centre clear between it and the ways)
    loop x in [-1.2,1.2]:add_box(vs,vec3(f32(x),0.7,f32(SLIP_TOP-5.5)),vec3(0.3,1.4,0.3),rgb(0.30,0.25,0.18),shop)
    add_cylinder(vs,vec3(0,0,0),0.32,2.1,rgb(0.20,0.20,0.19),10,-1.0,shop*translation(vec3(1.05,1.15,f32(SLIP_TOP-5.5)))*rotation_z(PI*0.5))

canal_piece=(vs:mut Vertex3D[],kind:int,i:int,detailed:bool):
    other:Vertex3D[]
    if kind==0:
        bank=canal_banks[i]
        canal_bank_mesh(vs,bank,canal_origin,f64((i*37)%400))
        canal_promenade(vs,bank,canal_origin,detailed)
    else if kind==1:
        if detailed:canal_bridge_mesh(vs,other,CANAL_BRIDGES[i],canal_origin)
        else:canal_bridge_mesh(other,vs,CANAL_BRIDGES[i],canal_origin)
    else if kind==2:canal_solid_mesh(vs,i,detailed)
    else if kind==3:
        at,row,station=canal_gardens[i]
        q=at+canal_origin
        r=river_at(f64(q.x),f64(q.z))
        if r.distance<r.width+10.0 or canal_floor(f64(q.x),f64(q.z),10000)>-1e8:return
        at.y=f32(world_source_surface(f64(q.x),f64(q.z)))
        river_tree(vs,at,if row==0:0 else:1,f64(station+row),detailed)
    else if detailed:canal_shop_mesh(vs)

# Finish a pending cell before choosing another. At most one upload per slice.
canal_pending= -1
canal_cursor=0
canal_detailed=false
canal_vertices:Vertex3D[]
canal_stream=(index:int,detailed:bool):
    global canal_pending,canal_cursor,canal_detailed,canal_vertices,canal_batches
    if canal_pending<0:
        canal_pending=index;canal_detailed=detailed;canal_cursor=0
    batch=canal_batches[canal_pending]
    until=time()+build_slice(0.003)
    loop canal_cursor<batch.items.len():
        kind,i=batch.items[canal_cursor]
        canal_piece(canal_vertices,kind,i,canal_detailed)
        canal_cursor+=1
        if time()>=until:return
    model=Mesh()
    if canal_vertices.len()>0:
        # Reuse a detailed buffer once its district is well outside the near
        # radius. Flying the entire canal does not accumulate facade buffers.
        if canal_detailed:
            loop k in 0..canal_batches.len():
                old=canal_batches[k]
                if old.has_near and old.near.count>0 and length(scene_camera()-old.center)>700.0:
                    model=old.near;canal_batches[k].near=Mesh();canal_batches[k].has_near=false
                    break
        if model.count>0:update_mesh(model,canal_vertices)
        else:model=mesh(canal_vertices)
    if canal_detailed:
        canal_batches[canal_pending].near=model;canal_batches[canal_pending].has_near=true
    else:
        canal_batches[canal_pending].far=model;canal_batches[canal_pending].has_far=true
    canal_vertices=[];canal_pending= -1

draw_canal=(L:Light,t:f64):
    cam=scene_camera()
    if not geography_enabled or length(cam.xz-canal_origin.xz)>12000:return
    zone("canal blocks")
    p=obj_params(L,t,anchor=world_point(canal_origin))
    planes=land_planes(scene_view_proj())
    best=1e30;next= -1;want_near=false
    loop i in 0..canal_batches.len():
        batch=canal_batches[i]
        # Allow for buildings, long banks and bridges extending beyond the cell.
        visible=true
        loop plane in planes:
            if dot(plane.xyz,batch.center)+plane.w < -228.0:visible=false;break
        if not visible:continue
        distance=f64(length(cam-batch.center))
        detailed=distance<440.0
        if distance<best and ((detailed and not batch.has_near) or (not detailed and not batch.has_far)):
            best=distance;next=i;want_near=detailed
        model=if batch.has_near and (detailed or not batch.has_far):batch.near else:batch.far
        if model.count>0:draw(obj_sh,model,p)
    if next>=0 or canal_pending>=0:canal_stream(next,want_near)
    zone_end()
