use 'town_details.jo'
use 'river_data.jo'
# Original working canal quarter: all geometry is procedural.
use 'canal_geometry.jo'
use 'objects.jo'
use 'look.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'geography.jo'
use 'river_banks.jo'
use 'river_field.jo'
use 'world_source.jo'
use 'quality.jo'
struct CanalBuild:
    center:vec3
    near:Vertex3D[]
    far:Vertex3D[]
struct CanalBatch:
    center:vec3
    near:Mesh
    far:Mesh
canal_batches:CanalBatch[]
canal_collect=(groups:mut {int:CanalBuild},at:vec3,near:Vertex3D[],far:Vertex3D[]):
    x=int(floor(f64(at.x-canal_origin.x)/192.0))
    z=int(floor(f64(at.z-canal_origin.z)/192.0))
    key=x*16384+z
    if not (key in groups):groups[key]=CanalBuild(canal_origin+vec3(f32(x)*192.0+96.0,0,f32(z)*192.0+96.0),[],[])
    groups[key].near.extend(near);groups[key].far.extend(far)
init_canal=():
    global canal_batches
    init_canal_geometry()
    groups:{int:CanalBuild}
    vs:Vertex3D[]
    far:Vertex3D[]
    loop i in 0..canal_solids.len():
        vs=[];far=[]
        box=canal_solids[i]
        m=translation(box.center-canal_origin)*rotation_y(-box.heading)
        if box.kind==9:
            church=m*translation(vec3(0,-box.half.y+2.8,0))*scaling(1.5)
            add_chapel(vs,church);add_chapel(far,church)
        else if box.kind==10:
            add_house(vs,m*translation(vec3(0,-box.half.y,0)),f64(box.half.x*2),f64(box.half.z*2),f64(box.half.y*2),i*71)
            add_house_proxy(far,m*translation(vec3(0,-box.half.y,0)),f64(box.half.x*2),f64(box.half.z*2),f64(box.half.y*2),i*71)
            loop sign in [-1.0,1.0]:
                add_box(vs,vec3(f32(sign)*8.05,2.5-box.half.y,0),vec3(0.15,5,6),rgb(0.27,0.30,0.26),m)
            add_cargo(vs,m*translation(vec3(0,-box.half.y,box.half.z+1.0)),i%9)
        else if box.kind==1:
            r=river_at(f64(box.center.x),f64(box.center.z))
            front=m*rotation_y(if r.lateral>0.0:-PI*0.5 else:PI*0.5)*translation(vec3(0,-box.half.y,0))
            add_house_proxy(far,front,f64(box.half.z*2),f64(box.half.x*2),f64(box.half.y*2),i*71)
            add_house(vs,front,f64(box.half.z*2),f64(box.half.x*2),f64(box.half.y*2),i*71)
            if i%3==0:
                add_box(vs,vec3(0,1.8,8.08),vec3(3.2,3.5,0.12),rgb(0.18,0.25,0.24),front)
                add_box(vs,vec3(0,4,9),vec3(4.2,0.12,2.4),if i%2==0:rgb(0.62,0.27,0.18) else:rgb(0.30,0.42,0.35),front)
        else if box.kind==7:
            # (the slipway's contact pieces: drawn below as one smooth ramp)
            pass
        else:
            color=if box.kind==3:rgb(0.18,0.24,0.25) else:if box.kind==4:rgb(0.43,0.32,0.21) else:if box.kind==5:rgb(0.76,0.66,0.49) else:if box.kind==6:rgb(0.49,0.24,0.15) else:rgb(0.58,0.55,0.45)
            add_box(vs,vec3(0,0,0),box.half*2.0,color,m)
            add_box(far,vec3(0,0,0),box.half*2.0,color,m)
            if box.kind>=2 and box.kind<=4:
                loop sign in [-1.0,1.0]:
                    # Handrails follow each bridge's actual deck profile.
                    add_box(vs,vec3(0,box.half.y+1.0,f32(sign)*box.half.z),vec3(box.half.x*2,0.14,0.14),color,m)
                    add_box(vs,vec3(0,box.half.y+0.5,f32(sign)*box.half.z),vec3(0.12,1.0,0.12),color,m)
                    if box.kind==2:
                        add_box(vs,vec3(0,box.half.y+0.6,f32(sign)*box.half.z),vec3(box.half.x*2,1.2,0.45),color,m)
                    if box.kind==3:
                        town_beam(vs,vec3(-box.half.x,box.half.y+0.15,f32(sign)*box.half.z),vec3(box.half.x,box.half.y+2.8,f32(sign)*box.half.z),0.13,color,m)
                        add_box(vs,vec3(0,box.half.y+2.8,f32(sign)*box.half.z),vec3(box.half.x*2,0.2,0.2),color,m)
                        add_box(vs,vec3(0,box.half.y+1.5,f32(sign)*box.half.z),vec3(0.18,2.8,0.18),color,m)
        canal_collect(groups,box.center,vs,far)
    vs=[];far=[]
    # Garden courts and orchards soften the outer blocks into the valley.
    loop station in 8..64:
        if station%3!=0:continue
        a=RIVER_NODES[CANAL_BEGIN+station];b=RIVER_NODES[CANAL_BEGIN+station+1]
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        loop sign in [-1.0,1.0]:
            loop row in 0..3:
                p=a.xy+side*f32(sign*(f64(a.w)+125.0+f64(row)*19.0))
                r=river_at(f64(p.x),f64(p.y))
                if r.distance<r.width+10.0:continue
                y=world_source_surface(f64(p.x),f64(p.y))
                tree=vec3(p.x-canal_origin.x,f32(y),p.y-canal_origin.z)
                vs=[];far=[]
                river_tree(vs,tree,if row==0:0 else:1,f64(station+row))
                river_tree(far,tree,if row==0:0 else:1,f64(station+row),false)
                canal_collect(groups,tree+canal_origin,vs,far)
    vs=[];far=[]
    # Tools and timber outside the open workshop, clear of its launch path.
    shop=translation(canal_workshop-canal_origin)*rotation_y(-canal_heading-PI*0.5)
    add_cargo(vs,shop*translation(vec3(12,0,8)),7)
    # Window bands, timber doorposts and a roof ridge identify the repair shed.
    loop x in [-16.55,16.55]:
        loop z in [-8.0,0.0,8.0]:
            add_box(vs,vec3(x,6,z),vec3(0.12,2.4,3.2),rgb(0.19,0.27,0.28),shop)
    loop x in [-14.0,14.0]:add_box(vs,vec3(x,4.5,15.4),vec3(0.35,9,0.4),rgb(0.30,0.25,0.18),shop)
    add_box(vs,vec3(0,9.2,15.4),vec3(28,0.45,0.4),rgb(0.30,0.25,0.18),shop)
    # The slipway: an even stone ramp from the shop floor into the canal, two greased timber
    # ways on sleepers, and the winch at its head that lets the cradle down.
    angle=atan(slip_slope());run=SLIP_FOOT+1.0-SLIP_TOP;mid=(SLIP_TOP+SLIP_FOOT+1.0)*0.5
    ramp=shop*translation(vec3(0,f32(-(mid-SLIP_TOP)*slip_slope()),f32(mid)))*rotation_x(angle)
    add_box(vs,vec3(0,-0.3,0),vec3(f32(SLIP_HALF*2.0),0.6,f32(run/cos(angle))),rgb(0.56,0.53,0.46),ramp)
    add_box(vs,vec3(0,0.005,f32((SLIP_WATER+0.5-mid)/cos(angle))),vec3(f32(SLIP_HALF*2.0),0.01,1.0),rgb(0.36,0.38,0.31),ramp)
    loop x in [-1.7,1.7]:add_box(vs,vec3(f32(x),0.165,0),vec3(0.3,0.17,f32(run/cos(angle))),rgb(0.22,0.16,0.10),ramp)
    k=0
    loop k<int(run/1.6):
        add_box(vs,vec3(0,0.04,f32((f64(k)+0.5)*1.6-run*0.5)),vec3(4.6,0.08,0.24),rgb(0.30,0.22,0.14),ramp)
        k+=1
    # (the winch stands back toward the rear wall, the shop's centre clear between it and the ways)
    loop x in [-1.2,1.2]:add_box(vs,vec3(f32(x),0.7,f32(SLIP_TOP-5.5)),vec3(0.3,1.4,0.3),rgb(0.30,0.25,0.18),shop)
    add_cylinder(vs,vec3(0,0,0),0.32,2.1,rgb(0.20,0.20,0.19),10,-1.0,shop*translation(vec3(1.05,1.15,f32(SLIP_TOP-5.5)))*rotation_z(PI*0.5))
    canal_collect(groups,canal_workshop,vs,far)
    keys=groups.keys();keys.sort()
    loop key in keys:
        group=groups[key]
        canal_batches.push(CanalBatch(group.center,mesh(group.near),mesh(group.far)))
draw_canal=(L:Light,t:f64):
    if not geography_enabled or length(scene_camera().xz-canal_origin.xz)>12000:return
    zone("canal blocks")
    p=obj_params(L,t,anchor=world_point(canal_origin))
    # Full frontage detail stays near the viewer; distant blocks retain the same
    # buildings and silhouettes, using the established house proxies.
    reach=if render_quality.tier==0:450.0 else:750.0
    loop batch in canal_batches:
        geometry=if length(scene_camera()-batch.center)<reach:batch.near else:batch.far
        if geometry.count>0:draw(obj_sh,geometry,p)
    zone_end()
