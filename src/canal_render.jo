# Original working canal quarter: all geometry is procedural.
use 'canal_geometry.jo'
use 'objects.jo'
use 'look.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'geography.jo'
canal_mesh:Mesh
init_canal=():
    global canal_mesh
    init_canal_geometry()
    vs:Vertex3D[]
    loop i in 0..canal_solids.len():
        box=canal_solids[i]
        m=translation(box.center-canal_origin)*rotation_y(-box.heading)
        if box.kind==1:
            add_house(vs,m*translation(vec3(0,-box.half.y,0)),f64(box.half.x*2),f64(box.half.z*2),f64(box.half.y*2),i*71)
        else:
            color=if box.kind==3:rgb(0.18,0.24,0.25) else:if box.kind==4:rgb(0.43,0.32,0.21) else:if box.kind==5:rgb(0.76,0.66,0.49) else:if box.kind==6:rgb(0.49,0.24,0.15) else:rgb(0.58,0.55,0.45)
            add_box(vs,vec3(0,0,0),box.half*2.0,color,m)
            if box.kind>=2 and box.kind<=4:
                loop sign in [-1.0,1.0]:
                    # Handrails follow each bridge's actual deck profile.
                    add_box(vs,vec3(0,box.half.y+1.0,f32(sign)*box.half.z),vec3(box.half.x*2,0.14,0.14),color,m)
                    add_box(vs,vec3(0,box.half.y+0.5,f32(sign)*box.half.z),vec3(0.12,1.0,0.12),color,m)
                    if box.kind==3:
                        add_box(vs,vec3(0,box.half.y+2.8,f32(sign)*box.half.z),vec3(box.half.x*2,0.2,0.2),color,m)
                        add_box(vs,vec3(0,box.half.y+1.5,f32(sign)*box.half.z),vec3(0.18,2.8,0.18),color,m)
    # Tools and timber outside the open workshop, clear of its launch path.
    shop=translation(canal_workshop-canal_origin)*rotation_y(-canal_heading-PI*0.5)
    add_cargo(vs,shop*translation(vec3(12,0,8)),7)
    canal_mesh=mesh(vs)
draw_canal=(L:Light,t:f64):
    if not geography_enabled or length(scene_camera().xz-canal_origin.xz)>12000:return
    draw(obj_sh,canal_mesh,obj_params(L,t,anchor=world_point(canal_origin)))
