# Original working canal quarter: all geometry is procedural.
use 'canal_geometry.jo'
use 'objects.jo'
use 'look.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'geography.jo'
use 'river_banks.jo'
canal_mesh:Mesh
canal_far_mesh:Mesh
init_canal=():
    global canal_mesh,canal_far_mesh
    init_canal_geometry()
    vs:Vertex3D[]
    far:Vertex3D[]
    loop i in 0..canal_solids.len():
        box=canal_solids[i]
        m=translation(box.center-canal_origin)*rotation_y(-box.heading)
        if box.kind==1:
            add_house_proxy(far,m*translation(vec3(0,-box.half.y,0)),f64(box.half.x*2),f64(box.half.z*2),f64(box.half.y*2),i*71)
            add_house(vs,m*translation(vec3(0,-box.half.y,0)),f64(box.half.x*2),f64(box.half.z*2),f64(box.half.y*2),i*71)
            if i%3==0:
                # Street-level stores and canvas awnings along the working quay.
                add_box(vs,vec3(0,2-box.half.y,7.08),vec3(3.2,3.5,0.12),rgb(0.18,0.25,0.24),m)
                add_box(vs,vec3(0,4-box.half.y,8),vec3(4.2,0.12,2.4),if i%2==0:rgb(0.62,0.27,0.18) else:rgb(0.30,0.42,0.35),m)
                add_cargo(vs,m*translation(vec3(4,-box.half.y,8)),i%9)
        else:
            color=if box.kind==3:rgb(0.18,0.24,0.25) else:if box.kind==4:rgb(0.43,0.32,0.21) else:if box.kind==5:rgb(0.76,0.66,0.49) else:if box.kind==6:rgb(0.49,0.24,0.15) else:rgb(0.58,0.55,0.45)
            add_box(vs,vec3(0,0,0),box.half*2.0,color,m)
            add_box(far,vec3(0,0,0),box.half*2.0,color,m)
            if box.kind>=2 and box.kind<=4:
                loop sign in [-1.0,1.0]:
                    # Handrails follow each bridge's actual deck profile.
                    add_box(vs,vec3(0,box.half.y+1.0,f32(sign)*box.half.z),vec3(box.half.x*2,0.14,0.14),color,m)
                    add_box(vs,vec3(0,box.half.y+0.5,f32(sign)*box.half.z),vec3(0.12,1.0,0.12),color,m)
                    if box.kind==3:
                        add_box(vs,vec3(0,box.half.y+2.8,f32(sign)*box.half.z),vec3(box.half.x*2,0.2,0.2),color,m)
                        add_box(vs,vec3(0,box.half.y+1.5,f32(sign)*box.half.z),vec3(0.18,2.8,0.18),color,m)
    # Tools and timber outside the open workshop, clear of its launch path.
    shop=translation(canal_workshop-canal_origin)*rotation_y(-canal_heading-PI*0.5)
    add_cargo(vs,shop*translation(vec3(12,0,8)),7)
    # Window bands, timber doorposts and a roof ridge identify the repair shed.
    loop x in [-16.55,16.55]:
        loop z in [-8.0,0.0,8.0]:
            add_box(vs,vec3(x,6,z),vec3(0.12,2.4,3.2),rgb(0.19,0.27,0.28),shop)
    loop x in [-14.0,14.0]:add_box(vs,vec3(x,4.5,15.4),vec3(0.35,9,0.4),rgb(0.30,0.25,0.18),shop)
    add_box(vs,vec3(0,9.2,15.4),vec3(28,0.45,0.4),rgb(0.30,0.25,0.18),shop)
    canal_mesh=mesh(vs);canal_far_mesh=mesh(far)
draw_canal=(L:Light,t:f64):
    if not geography_enabled or length(scene_camera().xz-canal_origin.xz)>12000:return
    draw(obj_sh,if length(scene_camera().xz-canal_origin.xz)>1800:canal_far_mesh else:canal_mesh,obj_params(L,t,anchor=world_point(canal_origin)))
