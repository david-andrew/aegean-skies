# The war beyond the strait's one battle: the Ierax's dawn patrol. While Kalyra and Orenthia are at
# war, three of the Ierax's seaplanes lie on her booms, and each morning at six they take off, form
# on their leader and fly a beat: up the island's west coast, across to the strait's northern
# entrance, down the strait and home. Orenthia flies its own dawn patrol from its harbour on the
# strait, down the strait and back up it. Whether the two meet is the world's doing: where and when
# each is. Seen, they break and fight; the Orenthians seen off (or the Ierax's flight beaten), or the
# beat flown, the leader says so on the radio and the flight regroups and goes home to the Ierax
# through the strait's own flow (combat.jo send_home, homeward_view.jo). A pilot who comes along
# flies with them: the Ierax's flight is the player's side in the free-play battle (side 0), so the
# R/T's orders and the allies' marks are theirs. The aircraft and pilots are the living world's,
# registered from their countries' harbours (as the strait's). The scene glue is aegean.jo's.
use 'world_point.jo'
use 'flight.jo'
use 'planes.jo'
use 'pilot.jo'
use 'combat.jo'
use 'tender.jo'
import 'living_types.jo' as data
import 'living_far_aircraft.jo' as registry

const SORTIE_ENGAGEMENT = 77000001
const PATROL_MINUTE = 360               # 06:00, local time
const PATROL_WINDOW = 120               # it goes out within two hours of that, or not that day
const PATROL_SIZE = 3
const PATROL_ALTITUDE = 450.0
const PATROL_CEILING = 1650.0           # the strait's soft ceiling, under the thrust's fade, while out
const PATROL_SIGHT = 6000.0             # two patrols see each other (m)
const PATROL_LAUNCH_GAP = 10.0          # seconds between take-offs from the booms
const PATROL_TURN = 0.12                # the leader's turn onto the next leg (rad/s)
const IERAX_SIDE = 0                    # the player's side in the free-play battle
const ORENTHIA_SIDE = 2
const IERAX_MODEL = 7                   # the strait's Kalyran and Orenthian Gulls
const ORENTHIA_MODEL = 5

# The Ierax's beat: up the coast and round the island's low north end over the sea (the way the
# flight comes home, the other way about: not over the cape's land), across to the strait's north
# entrance, down the strait.
IERAX_BEAT: vec3[] = [vec3(104000,0,-84000), vec3(117000,0,-90500), vec3(130000,0,-90000), vec3(138500,0,-62000)]
# Orenthia's, from its harbour on the strait: down the strait, back up it, and home.
ORENTHIA_BEAT: vec3[] = [vec3(139000,0,-60000), vec3(137500,0,-87000), vec3(135500,0,-72000)]

enum SortieStage: none, ready, launching, out, fighting, home, done

struct Sortie:
    stage: SortieStage = .none
    day = -1                            # the day it last went out
    flight: int[]                       # the Ierax's aircraft (world IDs)
    foes: int[]                         # Orenthia's
    leg = 0
    foe_leg = 0
    launched = 0.0                      # when the take-offs began (s)
    contact = false
    quiet = 0.0                         # seconds with the enemy out of touch, after contact
    foe_home = false

# Whether the patrol goes out now: at war, the morning's hour, not yet today.
patrol_due = (at_war: bool, local_minute: int, day: int, last_day: int) -> bool:
    at_war and day != last_day and local_minute >= PATROL_MINUTE and local_minute < PATROL_MINUTE+PATROL_WINDOW

# A formation's place k (0 the leader): a loose V, wings back.
patrol_offset = (k: int) -> vec3:
    if k == 0: return vec3(0,0,0)
    row = (k+1)/2
    vec3(f32((if k%2 == 1: -1.0 else: 1.0)*f64(row)*40.0),f32(f64(row)*8.0),f32(f64(row)*70.0))

# A compass word for a way (a flight heading's sense: north -z).
compass_word = (d: vec3) -> str:
    h = atan2(f64(d.x),-f64(d.z))
    words = ["north","north-east","east","south-east","south","south-west","west","north-west"]
    k = int(round(h/(PI/4.0)))
    words[((k%8)+8)%8]

# The heading to steer for `to` from `from`, turned from `now` by at most PATROL_TURN*dt.
patrol_steer = (now: f64, from: vec3, to: vec3, dt: f64) -> f64:
    want = atan2(f64(to.x-from.x),-f64(to.z-from.z))
    now+clamp(angle_delta(want,now),-PATROL_TURN*dt,PATROL_TURN*dt)

# The patrol's aircraft: `n` registered through the living world from `country`'s harbours, by key
# (found again by key after the first time; each harbour sends at most two, as the strait's do).
patrol_register = (w: mut data.World, country: int, key: str, n: int, stand: vec3?) -> int[]:
    out: int[]
    places = w.far.place_ids; places.sort()
    loop place in places:
        if out.len() >= n: break
        if not (place in w.far.harbors) or not (place in w.far.districts) or w.far.districts[place].born_country != country: continue
        d = w.far.districts[place]
        loop slot in 0..2:
            if out.len() >= n: break
            k = "{key}:{out.len()}"
            if not (k in w.far.air_registrations):
                price = data.AIRFRAMES[0].price_cents
                grant = max(0,price-w.accounts[d.household_account].cents)
                w.accounts[d.household_account].cents += grant; w.ledger.external_in_cents += grant
            r = registry.register_far_aircraft(w,place,.gull,d.household_account,k,stand)
            if r.craft >= 0: out.push(r.craft)
    out

# One of a patrol, lying moored at `at` (heading h), its pilot's place `slot` in the formation on
# `leader`: the world's record made the scene's, full tanks, and its combatant in the sortie.
patrol_combatant = (w: mut data.World, craft: int, side: int, slot: int, leader: int, at: vec3, h: f64, model: int, models: CraftModel[]) -> Combatant:
    person = w.aircraft[craft].owner
    k = craft_spec(.gull,models[model].contacts)
    k.fuel_capacity = f64(data.AIRFRAMES[0].tank_ml)/1000.0
    k.fuel_burn = f64(data.AIRFRAMES[0].burn_ml_sec)/1000.0
    s = water_start(k,vec3(at.x,0,at.z),h)
    moor(s,s.position,h)
    c = w.aircraft[craft]
    c.kind = .gull; c.model_index = model; c.livery_index = if side == IERAX_SIDE: 4 else: 2
    c.pose = data.Pose(pos = s.position,rot = s.orientation)
    c.previous_pos = s.position; c.move_owner = .scene; c.state = .moored; c.place = -1; c.dock = -1
    c.last_scene_tick = -1
    w.aircraft[craft] = c
    full = data.AIRFRAMES[0].tank_ml
    difference = full-w.aircraft[craft].fuel_ml
    if difference >= 0: w.goods_ledger.created[int(data.GoodKind.fuel)] += difference
    else: w.goods_ledger.consumed[int(data.GoodKind.fuel)] -= difference
    w.aircraft[craft].fuel_ml = full
    s.fuel = k.fuel_capacity
    w.people[person].pose = c.pose
    if person in w.far.people: w.far.people[person].vehicle = craft
    registry.release_far_berth(w,craft)
    a = Combatant(craft,person,side,k,s,model = model,rally = vec3(at.x,f32(PATROL_ALTITUDE),at.z),previous = s.position,
        pilot = CombatPilot(skill = 0.70+f64(slot%3)*0.05,nerve = 0.85,aggression = 0.6,caution = 0.35,formation_heading = h,formation_speed = k.cruise_speed*0.86,leader = leader,formation_offset = patrol_offset(slot)))
    a.engagement = SORTIE_ENGAGEMENT
    a.spec.combat_flight = true
    # (guns live, as start_engagement makes them for any but the player's)
    a.gun.locked = false
    a.previous_point = world_point(s.position)
    # (lying on her moorings till the morning: as one come home)
    a.pilot.mode = .homeward; a.pilot.home_done = true; a.pilot.home_turn = slot
    a

# The way to take off from `at`: into the wind (or `h` in a calm) if that way is clear, else the
# nearest way round from it that is: open water for the run, and the ground ahead falling away
# under the climb out. `ground` the land's height (sea below 0).
patrol_takeoff_heading = (at: vec3, wind: vec3, h: f64, ground: (f64,f64) -> f64) -> f64:
    flat = vec3(wind.x,0,wind.z)
    into = if length(flat) > 1.0: atan2(-f64(flat.x),f64(flat.z)) else: h
    loop turn in [0.0,0.35,-0.35,0.7,-0.7,1.05,-1.05,1.4,-1.4,1.75,-1.75,PI]:
        hd = into+turn
        dir = heading_vector(hd); side = vec3(-dir.z,0,dir.x)
        clear = true
        loop i in 1..41:
            if not clear: break
            d = f64(i)*100.0
            # (the run, and its first climb, over water; after it, the ground under the climb's line)
            ceiling = if d <= 1600.0: 0.0 else: (d-1600.0)*0.07+15.0
            # (wide of the line: a crosswind sets a take-off aside, and a shore close along it is no
            # way out)
            loop lane in [-160.0,-80.0,0.0,80.0,160.0]:
                q = at+dir*f32(d)+side*f32(lane)
                if ground(f64(q.x),f64(q.z)) > ceiling: clear = false
        if clear: return hd
    into

# Off the water: the clear way into the wind or nearest it (`take`, patrol_takeoff_heading),
# climbing to the patrol's height, then formation (`h` the way it goes).
patrol_launch = (a: mut Combatant, take: f64, h: f64):
    into = take
    if a.state.moored: unmoor(a.state)
    a.pilot.plan = FlightPlan(target = a.state.position+heading_vector(into)*20000.0,altitude = PATROL_ALTITUDE,takeoff_heading = into,phase = .takeoff)
    a.pilot.launching = true; a.pilot.home_done = false; a.pilot.mode = .regroup
    # (the anchor let go now, not at its brain's next look round: else it would lie moored on)
    a.pilot.controls = Controls(throttle = 0.3); a.pilot.brain_tick = -1
    a.pilot.formation = false; a.pilot.formation_heading = h
    a.rally = vec3(a.state.position.x,f32(PATROL_ALTITUDE),a.state.position.z)

# Whether Kalyra and Orenthia are at war (the world's diplomacy, as it stands).
patrol_at_war = (w: data.World) -> bool:
    loop r in w.diplomacy:
        if ((r.a == 1 and r.b == 2) or (r.a == 2 and r.b == 1)) and r.stage == .war: return true
    false
