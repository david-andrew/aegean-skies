# Looking around with the mouse while flying (the Options page's "Mouse steers the aircraft" off):
# how far the view may turn, by aircraft and view. Only the view's direction; nothing here knows the
# cockpit's mesh; the cockpit view's limits are each type's, kept with its cockpit (cockpit_cabins.jo).
from 'planes.jo' import Craft, aircraft_profile
from 'cockpit_cabins.jo' import cockpit_look

struct LookLimits:
    yaw = 2.6                       # either side, radians (the pilot's head and shoulders turned)
    up = 1.2                        # up, radians
    down = 0.6                      # down, radians
    wrap = false                    # (third person: round and round the aircraft)

# The limits for the cockpit view of `kind`; in third person, an orbit all round and from just below
# the aircraft to nearly overhead.
look_limits = (kind: Craft, cockpit: bool) -> LookLimits:
    if not cockpit: return LookLimits(yaw = PI, up = 1.2, down = 0.25, wrap = true)
    # (each type's own, beside its cockpit's layout: src/cockpit_cabins.jo cockpit_look; an open
    # cockpit's head turns well round, a cabin's stops sooner at its rear bulkhead and roof)
    l = cockpit_look(kind)
    LookLimits(yaw = l.yaw, up = l.up, down = l.down)

# a look offset kept within the limits (the yaw wrapped round in an orbit)
limit_look = (yaw: f64, pitch: f64, l: LookLimits) -> (f64, f64):
    y = if l.wrap: atan2(sin(yaw), cos(yaw)) else: clamp(yaw, -l.yaw, l.yaw)
    (y, clamp(pitch, -l.down, l.up))
