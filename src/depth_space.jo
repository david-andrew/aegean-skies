# Sloppy owns the camera projection, depth comparison and clear value.
# Tools that do not opt in keep the library's conventional depth.
const WORLD_DEPTH_LOG_RANGE: f32 = 20.0  # log2(1 + 1,048,575 metres)
world_reversed = false
world_logarithmic = false

enable_world_depth = ():
    global world_reversed, world_logarithmic
    if env("AEGEAN_LINEAR_DEPTH") != none: return
    world_reversed = env("AEGEAN_LOG_DEPTH") == none and reversed_depth()
    world_logarithmic = not world_reversed

world_depth_params = () -> vec2:
    if world_reversed: return vec2(__proj3[3].z, -1)
    if world_logarithmic: return vec2(WORLD_DEPTH_LOG_RANGE, 0)
    vec2(__proj3[2].z, __proj3[3].z)

world_has_depth = (depth: f32, ab: vec2) -> bool:
    if ab.y == -1.0: depth > 0.0 else: depth < 0.9999999

world_depth_encode = (distance: f32) -> f32: log2(1.0 + distance) / WORLD_DEPTH_LOG_RANGE
world_depth_decode = (depth: f32, ab: vec2) -> f32:
    if ab.y == -1.0: return min(1000000.0, ab.x / max(depth, 0.000000001))
    if ab.y == 0.0: return pow(2.0, depth * ab.x) - 1.0
    min(1000000.0, ab.y / min(depth * 2.0 - 1.0 + ab.x, -0.0000001))

# Separate fragment entry points keep hardware early depth on reversed renderers.
world_shader = (regular: ShaderSource, logarithmic: ShaderSource) -> ShaderSource:
    if world_logarithmic: logarithmic else: regular
