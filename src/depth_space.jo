# World depth: native reversed float Z, fragment-correct logarithmic WebGL2 Z.
# ShaderSource is the compiler's public backend boundary: transform its entry
# wrappers, not material functions. Keep the clear/test/decode convention together.
# gl_FragCoord.w is interpolated reciprocal clip-w, so its inverse recovers the
# fragment's true view depth even across very large triangles (no log interpolation).
const WORLD_DEPTH_LOG_RANGE: f32 = 20.0       # log2(1 + 1,048,575 metres)
# Opt in before creating world shaders, then begin every scene with the matching
# depth clear. Standalone tools mixing ordinary engine meshes retain normal depth.
world_log_depth=false
native_reverse_requested=false
world_split_requested=false
enable_world_depth=():
    global world_log_depth,native_reverse_requested,world_split_requested
    world_log_depth=env("AEGEAN_LINEAR_DEPTH")==none
    native_reverse_requested=env("AEGEAN_LOG_DEPTH")==none
    world_split_requested=env("AEGEAN_FULL_LOG_DEPTH")==none
world_reverse_depth_active=()->bool:
    when TARGET=="wasm":return false
    else:return world_log_depth and not __soft and __vk and native_reverse_requested
world_log_depth_active = () -> bool: world_log_depth and not __soft and not world_reverse_depth_active()
world_split_depth_active=()->bool:
    when TARGET=="wasm":return world_log_depth_active() and world_split_requested
    else:return false
world_depth_compare=()->u32:if world_reverse_depth_active():u32(0x0206) else:GL_LEQUAL
world_depth_strict=()->u32:if world_reverse_depth_active():u32(0x0204) else:GL_LESS
world_depth_params = () -> vec2:
    if world_split_depth_active():vec2(0.035,-2)
    else if world_reverse_depth_active():vec2(0.035,-1)
    else if world_log_depth_active():vec2(WORLD_DEPTH_LOG_RANGE,0)
    else:vec2(__proj3[2].z,__proj3[3].z)

world_has_depth=(depth:f32,ab:vec2)->bool:if ab.y== -1.0:depth>0.0 else:depth<0.9999999

world_depth_encode = (distance: f32) -> f32: log(1.0+max(distance,0.0))*(1.44269504089/WORLD_DEPTH_LOG_RANGE)
world_depth_decode = (depth: f32,ab: vec2) -> f32:
    if ab.y== -2.0:
        if depth<0.5:return ab.x/max(1.0-2.0*depth,0.000000001)
        return pow(2.0,(depth-0.5)*26.0+7.0)
    if ab.y== -1.0:return min(1000000.0,ab.x/max(depth,0.000000001))
    if ab.y==0.0:return pow(2.0,depth*ab.x)-1.0
    min(1000000.0,ab.y/min(depth*2.0-1.0+ab.x,-0.0000001))

# SPIR-V 1.5 entry-point adapter. The original Sloppy functions and their
# descriptor/physical-buffer ABI remain byte-for-byte unchanged. Fail explicitly
# if a future compiler changes the entry contract; never mix depth conventions.
depth_spirv = (code: str,fragment: bool,reverse:bool=false,background:bool=false) -> str:
    w=data(code) as *u32;n=len(code)/4
    assert(n>=5 and len(code)%4==0 and w[0]==u32(0x07230203))
    main=0;coordinate=0;scalar=0;vector=0;glsl=0
    i=5
    loop i<n:
        op=int(w[i]&u32(65535));count=int(w[i]>>16)
        assert(count>0 and i+count<=n)
        if op==15:main=int(w[i+2])
        if op==11 and w[i+2]==u32(0x4c534c47):glsl=int(w[i+1])
        if op==71 and count==4 and w[i+2]==u32(11) and int(w[i+3])==(if fragment:15 else:0):coordinate=int(w[i+1])
        if op==22 and w[i+2]==u32(32):scalar=int(w[i+1])
        if op==23 and int(w[i+2])==scalar and w[i+3]==u32(4):vector=int(w[i+1])
        i+=count
    assert(main>0 and coordinate>0 and scalar>0 and vector>0 and glsl>0)
    id=int(w[3])
    globals:int[]=[0x4002B,scalar,id,if background:0 else:if reverse:0x3d0f5c29 else:0,0x4002B,scalar,id+1,0x3f800000,0x4002B,scalar,id+2,0x3d4ccccd]
    if fragment:
        globals+= [0x40020,id+3,3,scalar,0x4003B,id+3,id+4,3]
    out:u32[]=[loop k in 0..5:w[k]];out[3]=u32(id+20)
    in_main=false;inserted_globals=false;decorated=false;writes=0
    i=5
    loop i<n:
        op=int(w[i]&u32(65535));count=int(w[i]>>16)
        if fragment and op==15:
            out.push(u32(((count+1)<<16)|op))
            loop k in 1..count:out.push(w[i+k])
            out.push(u32(id+4))
            # DepthReplacing is mandatory for a fragment-depth output.
            loop x in [0x30010,main,12]:out.push(u32(x))
            i+=count;continue
        if not decorated and op>=19 and op<=39:
            if fragment:
                loop x in [0x40047,id+4,11,22]:out.push(u32(x))
            decorated=true
        if op==54:
            if not inserted_globals:
                loop x in globals:out.push(u32(x))
                inserted_globals=true
            in_main=int(w[i+2])==main
        if in_main and not fragment and op==62 and int(w[i+1])==coordinate:
            value=int(w[i+2])
            patch:int[]=[0x50051,scalar,id+8,value,3,
                0x7000C,scalar,id+9,glsl,40,id+8,id,
                0x50081,scalar,id+10,id+9,id+1,
                0x6000C,scalar,id+11,glsl,30,id+10,
                0x50085,scalar,id+12,id+11,id+2,
                0x50085,scalar,id+13,id+12,id+8,
                0x60052,vector,id+14,id+13,value,2,
                0x3003E,coordinate,id+14]
            if reverse:patch=[0x60052,vector,id+14,id,value,2,0x3003E,coordinate,id+14]
            loop x in patch:out.push(u32(x))
            writes+=1;i+=count;continue
        if in_main and fragment and op==253:
            patch:int[]=[0x4003D,vector,id+8,coordinate,
                0x50051,scalar,id+9,id+8,3,
                0x50088,scalar,id+10,id+1,id+9,
                0x50081,scalar,id+11,id+10,id+1,
                0x6000C,scalar,id+12,glsl,30,id+11,
                0x50085,scalar,id+13,id+12,id+2,
                0x3003E,id+4,id+13]
            loop x in patch:out.push(u32(x))
            writes+=1
        loop k in 0..count:out.push(w[i+k])
        if op==56:in_main=false
        i+=count
    assert(writes==1 and decorated and inserted_globals)
    str_from_bytes(bytes_from(data(out) as *u8,out.len()*4))

depth_glsl = (source: str,fragment: bool) -> str:
    finish=last_index_of(source,"}") ?? -1
    assert(finish>0 and "void main()" in source)
    expression=if fragment:"    gl_FragDepth = log2(1.0 + 1.0 / gl_FragCoord.w) * 0.05;\n" else:"    gl_Position.z = (log2(1.0 + max(gl_Position.w, 0.0)) * 0.1 - 1.0) * gl_Position.w;\n"
    source[..finish]+expression+source[finish..]

depth_metal = (source: str,fragment: bool) -> str:
    if not fragment:
        assert("    return r;" in source)
        return replace(source,"    return r;","    r.pos.z = log2(1.0f + max(r.pos.w, 0.0f)) * 0.05f * r.pos.w;\n    return r;")
    start=index_of(source,"fragment float4 sl_fs") ?? -1
    ret=last_index_of(source,"    return ") ?? -1
    finish=last_index_of(source,";") ?? -1
    assert(start>=0 and ret>start and finish>ret)
    decl="struct SlDepthColor \{ float4 color [[color(0)]]; float depth [[depth(any)]]; };\n"
    prefix=source[..start]+decl+replace(source[start..ret],"fragment float4 sl_fs","fragment SlDepthColor sl_fs")
    prefix+"    SlDepthColor result;\n    result.color = "+source[ret+11..finish]+";\n    result.depth = log2(1.0f + 1.0f / in.pos.w) * 0.05f;\n    return result;\n}\n"

world_depth_source = (source: ShaderSource) -> ShaderSource:
    s=source
    s.vs=depth_glsl(s.vs,false);s.fs=depth_glsl(s.fs,true)
    when TARGET=="macos":
        s.vs_spirv=depth_metal(s.vs_spirv,false);s.fs_spirv=depth_metal(s.fs_spirv,true)
    else when TARGET!="wasm":
        s.vs_spirv=depth_spirv(s.vs_spirv,false);s.fs_spirv=depth_spirv(s.fs_spirv,true)
    s

make_world_shader = (source: ShaderSource) -> Shader:
    # Software rasterization has no fragment-depth output hook. Its CPU shaders
    # retain conventional perspective depth. Native float depth can use reversed Z;
    # WebGL2/OpenGL use fragment-correct log depth without requiring clip control.
    global world_depth_dump_index
    __gfx_init_gl_only()
    if world_split_depth_active():return make_shader(split_depth_source(source))
    adapted=if world_reverse_depth_active():reverse_depth_source(source) else:if world_log_depth_active():world_depth_source(source) else:source
    if let path=env("AEGEAN_DEPTH_DUMP"):
        id=world_depth_dump_index;world_depth_dump_index+=1
        write_file("{path}/{id}-vs.glsl",adapted.vs);write_file("{path}/{id}-fs.glsl",adapted.fs)
        write_file("{path}/{id}-vs.native",adapted.vs_spirv);write_file("{path}/{id}-fs.native",adapted.fs_spirv)
    result=make_shader(adapted)
    warm_world_depth(result)
    result
world_depth_dump_index=0

# The runtime's ordinary warm-up primes LEQUAL. Intel also specializes the
# dynamic depth comparison on first use; prime our reversed states while loading
# instead of paying that compilation in a visible frame. warm_up uses guarded
# scratch vertices/attachments, never real world geometry or the scene target.
warm_world_depth=(sh:Shader):
    when TARGET!="wasm" and TARGET!="macos":
        if not world_reverse_depth_active():return
        depth=__vg_depth;write=__vg_depth_write;compare=__vg_depth_func
        blend=__vg_blend;bf=__vg_bf
        glEnable(GL_DEPTH_TEST);glDepthFunc(world_depth_compare());glDepthMask(1)
        glDisable(GL_BLEND);warm_up(sh)
        glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA)
        warm_up(sh);glDepthMask(0);warm_up(sh)
        glBlendFunc(GL_SRC_ALPHA,GL_ONE);warm_up(sh)
        glDepthFunc(u32(compare));glDepthMask(u32(if write:1 else:0))
        if not depth:glDisable(GL_DEPTH_TEST)
        glBlendFuncSeparate(u32(bf.0),u32(bf.1),u32(bf.2),u32(bf.3))
        if not blend:glDisable(GL_BLEND)

# Native depth attachments are D32_SFLOAT/depth32Float already. Replace the
# final native clip Z directly, after the compiler's GL remap, avoiding the
# cancellation in (-w + near) + w. No fragment output, so early Z is retained.
reverse_depth_source=(source:ShaderSource,background:bool=false)->ShaderSource:
    s=source
    when TARGET=="macos":
        value=if background:"0.0f" else:"0.035f"
        assert("    return r;" in s.vs_spirv)
        s.vs_spirv=replace(s.vs_spirv,"    return r;","    r.pos.z = "+value+";\n    return r;")
    else when TARGET!="wasm":s.vs_spirv=depth_spirv(s.vs_spirv,false,true,background)
    s
make_background_shader=(source:ShaderSource)->Shader:
    __gfx_init_gl_only()
    make_shader(if world_reverse_depth_active():reverse_depth_source(source,true) else:source)

struct DepthClearVertex:
    p:vec2
struct DepthClearOut:
    pos:vec4
struct DepthClearParams:
    unused:f32
depth_clear_vs=(v:DepthClearVertex,u:DepthClearParams)->DepthClearOut:DepthClearOut(vec4(v.p,-1,1))
depth_clear_fs=(i:DepthClearOut,u:DepthClearParams)->vec4:vec4(0,0,0,0)
depth_clear_shader=Shader()
depth_clear_mesh=Mesh()
clear_world_depth=():
    global depth_clear_shader,depth_clear_mesh
    if not world_reverse_depth_active():
        glDepthMask(1);glClear(GL_DEPTH_BUFFER_BIT);glDepthFunc(GL_LEQUAL)
        return
    # The abstraction has no clear-depth setter. A color-masked full-screen
    # zero-depth triangle is portable on both native backends and touches no color.
    if depth_clear_shader.prog==0:
        depth_clear_shader=make_shader(shader(depth_clear_vs,depth_clear_fs))
        depth_clear_mesh=mesh([DepthClearVertex(vec2(-1,-1)),DepthClearVertex(vec2(3,-1)),DepthClearVertex(vec2(-1,3))])
    glEnable(GL_DEPTH_TEST);glDepthFunc(u32(0x0207));glDepthMask(1)
    glColorMask(0,0,0,0);glDisable(GL_CULL_FACE)
    draw(depth_clear_shader,depth_clear_mesh,DepthClearParams())
    glColorMask(1,1,1,1);glDepthFunc(world_depth_compare())

# WebGL depth has a conventional near range below 128 m and a logarithmic
# far range. Range-limited passes interpolate inverse-distance depth nearby,
# without a fragment-depth output. Other passes use exact fragment depth for
# both ranges in one submission.
# The small unused interval just below 0.5 keeps the ranges strictly ordered.
world_scene_depth_encode=(distance:f32,ab:vec2)->f32:
    if ab.y== -2.0:
        if distance<128.0:return 0.5-0.0175/max(distance,0.035)
        return 0.5+(log(max(distance,128.0))*1.44269504089-7.0)/26.0
    world_depth_encode(distance)

split_depth_source=(source:ShaderSource)->ShaderSource:
    s=source
    tail=last_index_of(s.vs,"}") ?? -1
    expression="    float wd = max(gl_Position.w, 0.035);\n    float wz = wd < 128.0 ? 0.5 - 0.0175 / wd : 0.5 + (log2(wd) - 7.0) / 26.0;\n    gl_Position.z = (wz * 2.0 - 1.0) * gl_Position.w;\n"
    assert(tail>0);s.vs=s.vs[..tail]+expression+s.vs[tail..]
    tail=last_index_of(s.fs,"}") ?? -1
    s.fs=s.fs[..tail]+"    float wd = 1.0 / gl_FragCoord.w;\n    gl_FragDepth = wd < 128.0 ? 0.5 - 0.0175 / wd : 0.5 + (log2(wd) - 7.0) / 26.0;\n"+s.fs[tail..]
    s

# Existing paving blocks and refined coast cells can prove that the complete
# submission is inside 127 m. They select this variant without extra geometry,
# uploads or draw calls. Unknown/mixed ranges retain exact fragment depth.
world_near_shaders:{int:Shader}={}
bounded_depth_source=(source:ShaderSource)->ShaderSource:
    s=source;tail=last_index_of(s.vs,"}") ?? -1
    assert(tail>0);s.vs=s.vs[..tail]+"    gl_Position.z = -0.035;\n"+s.vs[tail..]
    s
make_world_bounded_shader=(source:ShaderSource)->Shader:
    global world_near_shaders
    full=make_world_shader(source)
    when TARGET=="wasm":
        if world_split_depth_active():world_near_shaders[full.prog]=make_shader(bounded_depth_source(source))
    full
world_bounded_shader=(sh:Shader,near:bool)->Shader:
    when TARGET=="wasm":
        if near:return world_near_shaders.get(sh.prog,sh)
    sh
