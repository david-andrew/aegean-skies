use 'living_types.jo'
use 'living_money.jo'
use 'living_geometry.jo'
use 'living_events.jo'
use 'living_delivery.jo'
use 'living_news.jo'
use 'living_conditions.jo'
use 'living_contraband.jo'
use 'living_market.jo'
import 'world.jo' as terrain

free_dock = (w: World, place: int, craft: int = -1) -> int:
    loop d in 0..w.harbors[place].docks.len():
        taken = false
        loop c in w.aircraft:
            if c.id != craft and c.place == place and c.dock == d: taken = true
        loop id in w.active_trips:
            if w.trips[id].craft != craft and w.trips[id].destination == place and w.trips[id].claimed_dock == d and (w.trips[id].state == .active or w.trips[id].state == .holding or w.trips[id].state == .diverted): taken = true
        if not taken: return d
    -1

route_geometry = (w: World, origin: int, destination: int, start: vec3) -> vec3[]:
    key = origin*6+destination
    if key in w.route_cache:
        points = w.route_cache[key]
        points[0] = start
        return points
    bake_route(w,origin,destination,start)

segment_duration = (trip: Trip, segment: int) -> int:
    if trip.segment_ticks.len() > segment: return trip.segment_ticks[segment]
    max(1,int(ceil(f64(length(trip.route[segment+1]-trip.route[segment])) * 1000.0 * 60.0 / f64(trip.cruise_mm_per_sec))))

route_duration = (route: vec3[], cruise_mm_sec: int) -> int:
    total = 0
    loop s in 0..route.len()-1:
        total += if s == 0 or s == route.len()-2: 1200 else: max(1,int(ceil(f64(length(route[s+1]-route[s]))*1000.0*60.0/f64(cruise_mm_sec))))
    total

route_fuel = (route: vec3[], kind: Airframe) -> int:
    spec = AIRFRAMES[int(kind)]
    ticks = route_duration(route,spec.cruise_mps * 1000)
    # Departure taxi 20 s; approach is airborne. Round once across the route.
    (1200 * 20 + max(0,ticks-1200) * spec.burn_ml_sec + 59) / 60

travel_ready = (w: World, actor: int, destination: int) -> bool:
    if actor < 0 or actor >= w.people.len() or destination < 0 or destination >= w.places.len(): return false
    c = w.people[actor].craft; origin = w.people[actor].place
    if c < 0 or origin < 0 or origin == destination or w.people[actor].trip >= 0: return false
    if w.aircraft[c].place != origin: return false
    if w.places[origin].harbor_closed or w.places[destination].harbor_closed: return false
    if w.aircraft[c].trip >= 0 or w.aircraft[c].state == .workshop or w.aircraft[c].state == .ditched or w.aircraft[c].state == .wrecked: return false
    if w.aircraft[c].hull < 350 or w.aircraft[c].engine < 350 or w.people[actor].injured_until > w.minute: return false
    if weather_severity(w,w.aircraft[c].pose.pos) > pilot_nerve(w,actor,c): return false
    true

travel_feasible = (w: World, actor: int, destination: int) -> bool:
    if not travel_ready(w,actor,destination): return false
    c = w.people[actor].craft; origin = w.people[actor].place
    route = route_geometry(w,origin,destination,w.aircraft[c].pose.pos)
    fuel = route_fuel(route,w.aircraft[c].kind)
    w.aircraft[c].fuel_ml >= fuel + max(5000,fuel/5)

configure_trip_timing = (w: mut World, id: int, taxi: bool = true):
    w.trips[id].departure_taxi = taxi
    total = 0
    w.trips[id].segment_ticks.clear()
    loop s in 0..w.trips[id].route.len()-1:
        ticks = max(1,int(ceil(f64(length(w.trips[id].route[s+1]-w.trips[id].route[s])) * 1000.0 * 60.0 / f64(w.trips[id].cruise_mm_per_sec))))
        if (taxi and s == 0) or s == w.trips[id].route.len()-2: ticks = 1200
        w.trips[id].segment_ticks.push(ticks)
        total += ticks
    w.trips[id].eta_tick = w.trips[id].last_tick + total

start_trip = (w: mut World, actor: int, destination: int, reason: Reason) -> int:
    if not travel_feasible(w,actor,destination): return -1
    c = w.people[actor].craft; origin = w.people[actor].place
    route = route_geometry(w,origin,destination,w.aircraft[c].pose.pos)
    launch_route(w,actor,destination,route,reason)

launch_route = (w: mut World, actor: int, destination: int, route: vec3[], reason: Reason, physical_departure: bool = false) -> int:
    c = w.people[actor].craft; origin = w.people[actor].place
    if c < 0 or origin < 0 or w.people[actor].trip >= 0 or w.aircraft[c].trip >= 0: return -1
    if route.len() < 2 or length(route[0]-w.aircraft[c].pose.pos) > 1.0: return -1
    # Register the player's actual cast-off even with inadequate reserve or a closed harbor.
    # This is an observation of physical controls, never permission for NPCs to ignore rules.
    if physical_departure:
        if actor != w.player or w.aircraft[c].move_owner != .scene: return -1
    else:
        if w.places[origin].harbor_closed or w.aircraft[c].hull < 350 or w.aircraft[c].engine < 350 or w.people[actor].injured_until > w.minute: return -1
        if w.aircraft[c].repair_obligation >= 0 or w.aircraft[c].state == .ditched or w.aircraft[c].state == .wrecked: return -1
        needed = route_fuel(route,w.aircraft[c].kind)
        if w.aircraft[c].fuel_ml < needed+max(5000,needed/5): return -1
        if weather_severity(w,w.aircraft[c].pose.pos) > pilot_nerve(w,actor,c): return -1
    id = w.next_trip; w.next_trip += 1
    w.trips[id] = Trip(id=id,actor=actor,craft=c,mode=.aircraft,state=.active,origin=origin,destination=destination,reason=reason,route=route,cruise_mm_per_sec=AIRFRAMES[int(w.aircraft[c].kind)].cruise_mps * 1000,departed_tick=w.tick,last_tick=w.tick,eta_tick=w.tick)
    dock = free_dock(w,destination,c)
    w.trips[id].origin_dock = w.aircraft[c].dock
    w.trips[id].claimed_dock = dock
    if dock >= 0: w.trips[id].route[w.trips[id].route.len()-1] = w.harbors[destination].docks[dock]
    configure_trip_timing(w,id)
    schedule_incident(w,id)
    w.active_trips.push(id)
    observe_prices(w,actor,origin)
    w.places[origin].residents.remove(actor)
    w.people[actor].place = -1; w.people[actor].trip = id; w.people[actor].state = .traveling
    w.people[actor].action = Action(activity=.travel,purpose=reason.purpose,reason=reason,end_minute=(w.trips[id].eta_tick+119)/120)
    w.aircraft[c].operator = actor
    w.aircraft[c].place = -1; w.aircraft[c].dock = -1; w.aircraft[c].trip = id; w.aircraft[c].state = .taxi
    w.aircraft[c].revision += 1
    loop p in w.aircraft[c].passengers:
        w.places[origin].residents.remove(p)
        w.people[p].place = -1; w.people[p].trip = id; w.people[p].state = .traveling
    emit_event(w,.departed,origin,actor,reason.beneficiary,reason)
    id

# Verified outcome shared by scheduled and physical landings. A buoy has dock=-1.
commit_arrival = (w: mut World, trip: int, place: int, dock: int, revision: int) -> bool:
    if not (trip in w.trips) or (w.trips[trip].state != .active and w.trips[trip].state != .holding and w.trips[trip].state != .diverted): return false
    c = w.trips[trip].craft; actor = w.trips[trip].actor
    if place != w.trips[trip].destination or w.places[place].harbor_closed: return false
    if c >= 0:
        if w.aircraft[c].revision != revision or w.aircraft[c].trip != trip: return false
        if w.aircraft[c].move_owner == .scene:
            target = if dock >= 0 and dock < w.harbors[place].docks.len(): w.harbors[place].docks[dock] else: w.harbors[place].buoy
            if length(w.aircraft[c].pose.pos-target) > 20.0 or length(w.aircraft[c].pose.vel) > 3.0: return false
        if dock < -1 or dock >= w.harbors[place].docks.len(): return false
        if dock >= 0:
            loop other in w.aircraft:
                if other.id != c and other.place == place and other.dock == dock: return false
        w.aircraft[c].place = place; w.aircraft[c].dock = dock; w.aircraft[c].trip = -1; w.aircraft[c].state = .moored
        w.aircraft[c].pose.pos = if dock >= 0: w.harbors[place].docks[dock] else: w.harbors[place].buoy
        w.aircraft[c].pose.vel = vec3(0,0,0)
        w.aircraft[c].pose.throttle = 0
        w.aircraft[c].revision += 1
    w.trips[trip].state = .arrived; w.trips[trip].terminal_minute = w.minute
    w.people[actor].place = place; w.people[actor].trip = -1; w.people[actor].state = .idle
    if c >= 0 and dock >= 0:
        tangent = vec3(-w.harbors[place].out.z,0,w.harbors[place].out.x)
        foot = w.harbors[place].docks[dock]+tangent*(if dock == 0: 9.0 else: -9.0)
        w.people[actor].pose.pos = vec3(foot.x,1.2,foot.z)
        if actor != w.player: w.aircraft[c].operator = -1
    else: w.people[actor].pose.pos = w.harbors[place].center + vec3(0,1.2,0)
    w.people[actor].next_decision_minute = w.minute
    w.people[actor].action = Action(activity=.wait,purpose=w.trips[trip].reason.purpose,reason=w.trips[trip].reason,end_minute=w.minute)
    if w.trips[trip].reason.purpose == .visit:
        friend = w.trips[trip].reason.counterparty
        if friend >= 0 and w.people[friend].place == place:
            w.people[actor].action.activity = .socialize
            w.people[actor].action.end_minute = w.minute+30
            w.people[actor].next_decision_minute = w.minute+30
    if not (actor in w.places[place].residents): w.places[place].residents.push(actor)
    emit_event(w,.arrived,place,actor,w.trips[trip].reason.beneficiary,w.trips[trip].reason)
    arrival_search(w,trip)
    unload_at_harbor(w,actor)
    disembark_failed_passengers(w,actor,place)
    arrival_exchange(w,actor,place)
    living_costs(w,actor)
    true

advance_trips = (w: mut World, target_tick: int):
    loop id in w.active_trips:
        if w.trips[id].state == .arrived or w.trips[id].state == .failed: continue
        c = w.trips[id].craft
        if c < 0 or w.trips[id].mode != .aircraft or w.aircraft[c].move_owner == .scene: continue
        if w.trips[id].segment_ticks.len() == 0: configure_trip_timing(w,id,false)
        if w.trips[id].encounter >= 0 and not w.encounters[w.trips[id].encounter].resolved:
            w.trips[id].last_tick = target_tick
            continue
        remaining = target_tick - w.trips[id].last_tick
        if remaining <= 0: continue
        w.aircraft[c].previous_pos = w.aircraft[c].pose.pos
        w.trips[id].last_tick = target_tick
        loop remaining > 0 and w.trips[id].segment < w.trips[id].route.len()-1:
            s = w.trips[id].segment
            duration = segment_duration(w.trips[id],s)
            dt = min(remaining,duration-w.trips[id].segment_elapsed_ticks)
            rate = if s == 0 and w.trips[id].departure_taxi and w.trips[id].departed_tick >= 0: 20 else: AIRFRAMES[int(w.aircraft[c].kind)].burn_ml_sec
            raw = dt * rate + w.aircraft[c].burn_remainder
            fuel = raw / 60
            if fuel > w.aircraft[c].fuel_ml:
                burn_fuel(w,c,w.aircraft[c].fuel_ml)
                w.trips[id].state = .failed
                w.trips[id].terminal_minute = w.minute
                w.aircraft[c].state = .ditched
                break
            burn_fuel(w,c,fuel); w.aircraft[c].burn_remainder = raw % 60
            w.trips[id].segment_elapsed_ticks += dt
            remaining -= dt
            a = w.trips[id].route[s]; b = w.trips[id].route[s+1]
            mm = int(round(f64(length(b-a))*1000.0))
            progressed = mm * w.trips[id].segment_elapsed_ticks / duration
            w.trips[id].traveled_mm += progressed - w.trips[id].segment_mm
            w.trips[id].segment_mm = progressed
            w.aircraft[c].pose.pos = lerp(a,b,f32(f64(w.trips[id].segment_elapsed_ticks)/f64(duration)))
            w.aircraft[c].pose.vel = (b-a)*f32(60.0/f64(duration))
            w.aircraft[c].pose.rot = facing(b-a)
            w.aircraft[c].pose.throttle = if s == 0 and w.trips[id].departure_taxi and w.trips[id].departed_tick >= 0: 250 else: if s == w.trips[id].route.len()-2: 200 else: 650
            w.aircraft[c].state = if s == 0 and w.trips[id].departure_taxi and w.trips[id].departed_tick >= 0: CraftState.taxi else: if s == w.trips[id].route.len()-2: CraftState.approach else: CraftState.airborne
            if w.trips[id].segment_elapsed_ticks == duration:
                w.trips[id].segment += 1; w.trips[id].segment_mm = 0; w.trips[id].segment_elapsed_ticks = 0
        if w.trips[id].state == .failed: continue
        if w.trips[id].segment >= w.trips[id].route.len()-1:
            old_tick = w.tick; old_minute = w.minute
            # Use the actual scheduled arrival time, independent of caller partition.
            if w.trips[id].state != .holding:
                w.tick = target_tick - remaining
                w.minute = w.tick / TICKS_PER_MINUTE
            dest = w.trips[id].destination
            dock = w.trips[id].claimed_dock
            if dock >= 0:
                loop other in w.aircraft:
                    if other.id != c and other.place == dest and other.dock == dock: dock = -1
            if dock < 0: dock = free_dock(w,dest,c)
            if w.places[dest].harbor_closed or (dock < 0 and w.trips[id].hold_until_minute == 0):
                w.trips[id].state = .holding
                w.aircraft[c].pose.vel = vec3(0,0,0); w.aircraft[c].pose.throttle = 0
                if w.trips[id].hold_until_minute == 0: w.trips[id].hold_until_minute = w.minute+30
            if not w.places[dest].harbor_closed and (dock >= 0 or w.minute >= w.trips[id].hold_until_minute):
                target = if dock >= 0: w.harbors[dest].docks[dock] else: w.harbors[dest].buoy
                if length(w.aircraft[c].pose.pos-target) > 1.0:
                    # Changed allocation requires a real final taxi, never a snap between berths.
                    w.trips[id].route = [w.aircraft[c].pose.pos,target]
                    w.trips[id].segment = 0; w.trips[id].segment_mm = 0; w.trips[id].segment_elapsed_ticks = 0
                    duration = max(120,int(ceil(f64(length(target-w.aircraft[c].pose.pos))/6.0))*120)
                    w.trips[id].segment_ticks = [duration]
                    w.trips[id].last_tick = target_tick
                    w.trips[id].eta_tick = target_tick+duration
                    w.trips[id].claimed_dock = dock
                    w.trips[id].state = .active
                else: commit_arrival(w,id,dest,dock,w.aircraft[c].revision)
            w.tick = old_tick; w.minute = old_minute
    live: int[]
    loop id in w.active_trips:
        if w.trips[id].state != .arrived and w.trips[id].state != .failed: live.push(id)
    w.active_trips = live

# Compact borrowed projections; inventories/world arrays never escape into render state.
struct AirborneTrip:
    trip: int
    person: int
    craft: int
    origin: int
    destination: int
    origin_dock: vec3
    destination_dock: vec3
    reason: Reason
    kind: Airframe
    model_index: int
    livery_index: int
    pose: Pose
    owner: MoveOwner
    revision: int
    route: vec3[]
    encounter: int
    eta_tick: int
    fuel_ml: int
    hull: int
    engine: int
    phase: CraftState
    segment: int
    segment_mm: int
    incident_at_mm: int
    incident_resolved: bool
    origin_dock_index: int
    destination_dock_index: int
    trip_state: TripState
    hold_until_minute: int

query_airborne = (w: World) -> AirborneTrip[]:
    result: AirborneTrip[]
    loop id in w.active_trips:
        c = w.trips[id].craft
        if c < 0 or w.trips[id].mode != .aircraft: continue
        t = w.trips[id]
        result.push(AirborneTrip(id,t.actor,c,t.origin,t.destination,if t.origin_dock >= 0: w.harbors[t.origin].docks[t.origin_dock] else: w.harbors[t.origin].buoy,if t.claimed_dock >= 0: w.harbors[t.destination].docks[t.claimed_dock] else: w.harbors[t.destination].buoy,t.reason,w.aircraft[c].kind,if w.aircraft[c].model_index >= 0: w.aircraft[c].model_index else: int(w.aircraft[c].kind),if w.aircraft[c].livery_index >= 0: w.aircraft[c].livery_index else: w.aircraft[c].owner%6,w.aircraft[c].pose,w.aircraft[c].move_owner,w.aircraft[c].revision,t.route,t.encounter,t.eta_tick,w.aircraft[c].fuel_ml,w.aircraft[c].hull,w.aircraft[c].engine,w.aircraft[c].state,t.segment,t.segment_mm,t.incident_at_mm,t.incident_resolved,t.origin_dock,t.claimed_dock,t.state,t.hold_until_minute))
    result
