use 'living_types.jo'

severity_base = (kind: EventKind) -> int:
    match kind:
        .delivery: 100
        .produced: 20
        .late: 180
        .defaulted: 400
        .theft: 450
        .raid: 600
        .rescue: 500
        .ditch: 650
        .repair: 120
        .shortage: 250
        .closure: 300
        .refused: 180
        .patrol, .search: 180
        else: 40

emit_event = (w: mut World, kind: EventKind, place: int, actor: int, target: int, reason: Reason, harm: int = 0, private: bool = false, pos: vec3 = vec3(0,0,0)) -> int:
    id = w.next_event; w.next_event += 1
    witnesses: int[]
    if actor >= 0: witnesses.push(actor)
    if target >= 0 and target != actor: witnesses.push(target)
    if place >= 0 and not private:
        loop p in 0..w.people.len():
            if w.people[p].place == place and not (p in witnesses) and witnesses.len() < 8: witnesses.push(p)
    faction = if actor >= 0: w.people[actor].faction else: -1
    position = if place >= 0: w.harbors[place].center else: pos
    unexpected = kind == .closure
    if kind == .defaulted and actor >= 0:
        unexpected = not (actor in w.defaulted_people)
        w.defaulted_people[actor] = true
    if kind == .raid:
        local = place
        if local < 0:
            distance = 1e30
            loop p in 0..w.harbors.len():
                d = f64(length(w.harbors[p].center-position))
                if d < distance: distance = d; local = p
        unexpected = w.minute-w.last_local_raid.get(local,-100000) >= 10080
        w.last_local_raid[local] = w.minute
    w.events[id] = Event(id=id,kind=kind,minute=w.minute,place=place,pos=position,actor=actor,target=target,actor_faction=faction,witnesses=witnesses,severity=min(1000,severity_base(kind)+min(harm/50,300)+(if unexpected: 100 else: 0)),harm_cents=harm,reason=reason,private_fact=private)
    w.event_order.push(id)
    id
