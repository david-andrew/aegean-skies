use 'living_guard.jo'
use 'living_transaction.jo'
use 'living_types.jo'
use 'living_cargo.jo'
use 'living_money.jo'
use 'living_seed.jo'
use 'living_events.jo'

update_prices = (w: mut World):
    loop p in 0..w.places.len():
        loop g in 0..GOOD_COUNT:
            desired = initial_price(w.goods[g].base_cents,w.places[p].market.inventory.qty[g],w.places[p].market.target[g])
            # Integer round-to-nearest, ties up; desired and quote are positive cents.
            w.places[p].market.price_cents[g] = (3*w.places[p].market.price_cents[g]+desired+2)/4

prepare_shipments = (w: mut World):
    day = day_index(w.minute)
    if w.last_ship_day == day: return
    w.last_ship_day = day
    caps: int[9] = [0,3000,0,8000,8000,2000,2000,0,0]
    loop p in 0..6:
        night = p == 5
        id = w.next_shipment; w.next_shipment += 1
        cancel = draw1000000(w.seed,30,p,day,0) < 150000 and w.places[p].import_cancel_streak < 2
        if cancel: w.places[p].import_cancel_streak += 1
        else: w.places[p].import_cancel_streak = 0
        arrival = day*1440-570+(if night: 1380 else: 600)+draw1000000(w.seed,30,p,day,1)*181/1000000
        s = OutsideShipment(id=id,place=p,day=day,arrival_minute=max(w.minute,arrival),original_arrival_minute=max(w.minute,arrival),cancelled=cancel,night=night)
        loop g in 0..GOOD_COUNT:
            cap = if night: (if g == 4 or g == 7: 2000 else: if g == 5: 1000 else: 0) else: caps[g]
            s.manifest[g] = min(max(0,w.places[p].market.target[g]-w.places[p].market.inventory.qty[g]),cap)
        w.shipments.push(s)

_guarded_advance_shipments = (w: mut World):
    loop i in 0..w.shipments.len():
        if w.shipments[i].state != 0 or w.minute < w.shipments[i].arrival_minute: continue
        p = w.shipments[i].place
        if w.shipments[i].cancelled:
            w.shipments[i].state = 2
            emit_event(w,.late,p,w.places[p].market_owner,-1,Reason(purpose=.trade,actor=w.places[p].market_owner,destination=p,due_minute=w.shipments[i].original_arrival_minute))
            continue
        if w.places[p].harbor_closed:
            if w.minute-w.shipments[i].original_arrival_minute >= 360:
                w.shipments[i].state = 2
                emit_event(w,.late,p,w.places[p].market_owner,-1,Reason(purpose=.trade,actor=w.places[p].market_owner,destination=p))
            else: w.shipments[i].arrival_minute = w.minute+60
            continue
        a = w.places[p].market.account
        # A documented working-capital advance is available when needed, once/day,
        # rather than only if a low till happens to coincide with midnight.
        if p != 5 and w.accounts[a].cents < 5000 and w.places[p].last_advance_day != day_index(w.minute):
            if not (transfer(w,-1,a,20000,.subsidy)):
                living_fault("living_market.advance_shipments.0",guard_context(w))
                return
            w.places[p].last_advance_day = day_index(w.minute)
        # Essential operating supplies are purchased before discretionary wine/grain.
        loop g in [4,6,5,3,1,0,2,7,8]:
            quote = w.goods[g].base_cents * (if w.shipments[i].night: 110 else: 80) / 100
            quantity = min(w.shipments[i].manifest[g],w.accounts[a].cents*1000/max(quote,1))
            if quantity <= 0: continue
            key = "import:{p}:{g}"
            raw = quantity*quote + w.quote_residual.get(key,0)
            cents = raw/1000
            if cents > 0:
                if not (transfer(w,a,-1,cents,.outside_import,w.shipments[i].id)):
                    living_fault("living_market.advance_shipments.1",guard_context(w))
                    return
            w.quote_residual[key] = raw%1000
            w.places[p].market.inventory.qty[g] += quantity
            record_creation(w,g,quantity)
            cargo_mint(w,.market,p,g,quantity,w.places[p].market_owner,p,.imported)
        w.shipments[i].state = 1

_guarded_hourly_demand = (w: mut World):
    if w.far.populated: return # these same residents now purchase through their funded cohort
    loop p in 0..6:
        a = w.places[p].market.account
        loop g in 0..GOOD_COUNT:
            raw = w.places[p].market.demand_per_day[g]+w.places[p].market.demand_remainder[g]
            wanted = raw/24
            w.places[p].market.demand_remainder[g] = raw%24
            qty = min(wanted,available(w.places[p].market.inventory,g))
            if qty > 0:
                key = "household:{p}:{g}"
                raw_price = qty*w.places[p].market.price_cents[g]+w.quote_residual.get(key,0)
                if raw_price/1000 > 0:
                    if not (transfer(w,-1,a,raw_price/1000,.household_sale)):
                        living_fault("living_market.hourly_demand.2",guard_context(w))
                        return
                w.quote_residual[key] = raw_price%1000
                cargo_consume(w,.market,p,g,qty)
                w.places[p].market.inventory.qty[g] -= qty
                record_consumption(w,g,qty)
            w.places[p].market.unmet_demand_milli[g] += wanted-qty
            if qty < wanted:
                w.places[p].market.shortage_hours[g] += 1
                if w.places[p].market.shortage_hours[g] == 6:
                    emit_event(w,.shortage,p,w.places[p].market_owner,-1,Reason(purpose=.delivery,actor=w.places[p].market_owner,beneficiary=w.places[p].market_owner,destination=p,good=g,quantity=wanted-qty))
            else: w.places[p].market.shortage_hours[g] = 0

# Reserved fish also decays, with loss assigned to the real lot; promises don't preserve food.
spoil_fish = (w: mut World):
    loop p in 0..6:
        qty = available(w.places[p].market.inventory,0)
        raw = qty + w.places[p].spoil_remainder[0]
        lost = raw/24
        w.places[p].spoil_remainder[0] = raw%24
        cargo_consume(w,.market,p,0,lost)
        w.places[p].market.inventory.qty[0] -= lost
        record_consumption(w,0,lost)
    loop c in 0..w.aircraft.len():
        # One residual per physical inventory, not one per rendering frame.
        key = "spoil-craft:{c}"
        raw = w.aircraft[c].cargo.qty[0]+w.quote_residual.get(key,0)
        lost = raw/24; w.quote_residual[key] = raw%24
        free = available(w.aircraft[c].cargo,0)
        assigned = max(0,lost-free)
        cargo_consume(w,.aircraft,c,0,lost)
        w.aircraft[c].cargo.qty[0] -= lost
        w.aircraft[c].cargo.reserved[0] -= assigned
        record_consumption(w,0,lost)
        loop job in w.aircraft[c].job_manifests:
            if assigned <= 0: break
            if w.jobs[job].good != 0: continue
            n = min(assigned,w.jobs[job].loaded_quantity-w.jobs[job].delivered_quantity-w.jobs[job].lost_quantity)
            w.jobs[job].lost_quantity += n; assigned -= n
    loop p in 0..w.people.len():
        key = "spoil-person:{p}"
        raw = w.people[p].pocket.qty[0]+w.quote_residual.get(key,0)
        lost = raw/24; w.quote_residual[key] = raw%24
        cargo_consume(w,.pocket,p,0,lost)
        w.people[p].pocket.qty[0] -= lost; record_consumption(w,0,lost)

spoil_salvage = (w: mut World):
    ids = w.aftermath.keys()
    loop id in ids:
        qty = w.aftermath[id].inventory.qty[0]
        key = "spoil-salvage:{id}"
        raw = qty+w.quote_residual.get(key,0)
        lost = raw/24; w.quote_residual[key] = raw%24
        reserved_loss = max(0,lost-available(w.aftermath[id].inventory,0))
        cargo_consume(w,.aftermath,id,0,lost)
        w.aftermath[id].inventory.qty[0] -= lost
        w.aftermath[id].inventory.reserved[0] -= reserved_loss
        record_consumption(w,0,lost)
    properties = w.lost_property.keys()
    loop id in properties:
        qty = w.lost_property[id].qty[0]
        key = "spoil-salvage:{id}"
        raw = qty+w.quote_residual.get(key,0)
        lost = raw/24; w.quote_residual[key] = raw%24
        reserved_loss = max(0,lost-available(w.lost_property[id],0))
        cargo_consume(w,.lost_property,id,0,lost)
        w.lost_property[id].qty[0] -= lost; w.lost_property[id].reserved[0] -= reserved_loss
        record_consumption(w,0,lost)

_guarded_outside_exports = (w: mut World):
    loop p in 0..6:
        if p == 5 or w.places[p].harbor_closed: continue
        loop g in 0..7:
            qty = min(8000,min(available(w.places[p].market.inventory,g),max(0,w.places[p].market.inventory.qty[g]-w.places[p].market.target[g])))
            if qty <= 0: continue
            cents = qty*w.goods[g].base_cents*65/100000
            if cents > 0:
                if not (transfer(w,-1,w.places[p].market.account,cents,.outside_export)):
                    living_fault("living_market.outside_exports.3",guard_context(w))
                    return
            cargo_consume(w,.market,p,g,qty)
            w.places[p].market.inventory.qty[g] -= qty; record_consumption(w,g,qty)

_guarded_living_costs = (w: mut World, only_person: int = -1):
    day = day_index(w.minute)-(if local_minute(w.minute) < 1320: 1 else: 0)
    if day < 0: return
    loop person in 1..w.people.len():
        if only_person >= 0 and only_person != person: continue
        place = w.people[person].place
        if place < 0 or w.people[person].living_day >= day: continue
        w.people[person].living_day = day
        if w.people[person].injured_until > w.minute and day-w.people[person].last_care_grant_day >= 7:
            days = max(1,min(3,(w.people[person].injured_until-w.minute+1439)/1440))
            daily = 500+(w.places[place].market.price_cents[0]+w.places[place].market.price_cents[3])/2
            grant = max(0,days*daily-w.accounts[w.people[person].account].cents)
            if grant > 0:
                authority = w.factions[0].account
                if w.accounts[authority].cents >= grant:
                    if not (transfer(w,authority,w.people[person].account,grant,.subsidy,person)):
                        living_fault("living_market.living_costs.4",guard_context(w)+" only_person={only_person}")
                        return
                else:
                    if not (transfer(w,-1,w.people[person].account,grant,.subsidy,person)):
                        living_fault("living_market.living_costs.5",guard_context(w)+" only_person={only_person}")
                        return
                    w.emergency_subsidies += 1
                w.people[person].last_care_grant_day = day
        loop g in [0,3]:
            qty = min(500,available(w.places[place].market.inventory,g))
            if qty > 0 and trade(w,person,place,g,qty,true):
                cargo_consume(w,.pocket,person,g,qty)
                w.people[person].pocket.qty[g] -= qty; record_consumption(w,g,qty)
        landlord = if place == 0: 6 else: if place == 4: 20 else: if place == 5: 25 else: -1
        recipient = if landlord >= 0 and landlord != person: w.people[landlord].account else: if place == 5: w.places[place].market.account else: w.factions[0].account
        if w.accounts[w.people[person].account].cents >= 500:
            if not (transfer(w,w.people[person].account,recipient,500,.rent)):
                living_fault("living_market.living_costs.6",guard_context(w)+" only_person={only_person}")
                return
        else:
            id = seed_obligation(w,"lodging-{person}-{day}",person,landlord,.rent,w.minute,w.minute+7*1440,500,place)
            w.obligations[id].creditor_account = recipient

_guarded_market_day = (w: mut World):
    if not (transfer(w,-1,w.factions[0].account,8000,.subsidy)):
        living_fault("living_market.market_day.7",guard_context(w))
        return
    if not (transfer(w,-1,w.factions[2].account,3000,.subsidy)):
        living_fault("living_market.market_day.8",guard_context(w))
        return
    day = day_index(w.minute)
    loop p in 0..6:
        market = w.places[p].market.account
        owner = w.people[w.places[p].market_owner].account
        draw = min(2000,max(0,w.accounts[market].cents-20000))
        if draw > 0:
            if not (transfer(w,market,owner,draw,.wage)):
                living_fault("living_market.market_day.9",guard_context(w))
                return
        if p != 5 and w.accounts[market].cents < 5000 and w.places[p].last_advance_day != day:
            if not (transfer(w,-1,market,20000,.subsidy)):
                living_fault("living_market.market_day.10",guard_context(w))
                return
            w.places[p].last_advance_day = day

market_minute = (w: mut World):
    clock = local_minute(w.minute)
    if w.places[4].banquet_day < 0 or clock == 360: plan_banquet(w)
    if w.last_ship_day < 0 or clock == 360: prepare_shipments(w)
    if clock == 1140: serve_banquet(w)
    advance_shipments(w)
    if clock%60 == 0:
        hourly_demand(w)
        spoil_fish(w)
        spoil_salvage(w)
        update_prices(w)
    if clock == 0: market_day(w)
    if clock == 1020: outside_exports(w)
    if clock == 1320: living_costs(w)

plan_banquet = (w: mut World):
    day = day_index(w.minute)
    if w.places[4].banquet_day == day: return
    w.places[4].banquet_day = day
    w.places[4].banquet_planned = draw1000000(w.seed,30,4,day,99) < 200000
    if not w.places[4].banquet_planned: return
    w.places[4].market.target[1] += 3000
    due = day*1440-570+1140
    obligation = seed_obligation(w,"selene-banquet-{day}",20,20,.supply,due,due+120,0,4,1,3000)
    w.places[4].banquet_obligation = obligation

_guarded_serve_banquet = (w: mut World):
    if not w.places[4].banquet_planned: return
    # Outside guests pay only for wine actually served from Lucia's physical cellar.
    qty = min(3000,available(w.people[20].pocket,1))
    if qty > 0:
        cents = qty*(w.places[4].market.price_cents[1]+200)/1000
        if not (transfer(w,-1,w.people[20].account,cents,.household_sale)):
            living_fault("living_market.serve_banquet.11",guard_context(w))
            return
        cargo_consume(w,.pocket,20,1,qty)
        w.people[20].pocket.qty[1] -= qty; record_consumption(w,1,qty)
    w.places[4].market.target[1] -= 3000
    w.places[4].banquet_planned = false
    id = w.places[4].banquet_obligation
    if id >= 0:
        w.obligations[id].state = if qty >= 3000: ObligationState.fulfilled else: ObligationState.breached
        if qty < 3000: emit_event(w,.shortage,4,20,-1,w.obligations[id].reason)


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
advance_shipments = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_advance_shipments(w)
    guard_finish(w,scope)

hourly_demand = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_hourly_demand(w)
    guard_finish(w,scope)

outside_exports = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_outside_exports(w)
    guard_finish(w,scope)

living_costs = (w: mut World, only_person: int = -1):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_living_costs(w,only_person)
    guard_finish(w,scope)

market_day = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_market_day(w)
    guard_finish(w,scope)

serve_banquet = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_serve_banquet(w)
    guard_finish(w,scope)
