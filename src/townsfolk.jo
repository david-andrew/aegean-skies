# The world's people on their quays and streets: everyone the living world has in a town (not at
# sea, not abroad, not asleep indoors) is drawn there, dressed for their trade, about the place
# their work belongs to: merchants at the market, pilots by the docks, the clerk at the harbor
# office, the innkeeper at the inn. And the harbor's notice board, read from the world's jobs.

use 'look.jo'
use 'world.jo'
use 'objects.jo'
use 'folk.jo'
use 'panels.jo'
from 'living_world.jo' import World
import 'living_types.jo' as lt
use 'life_types.jo'
import 'life_scene.jo' as daily_scene

struct Folk:
    person: int
    fig: Figure
    place: int                      # the town they are drawn in
    pos: vec3
    target: vec3
    yaw: f64 = 0.0
    phase: f64 = 0.0
    wait: f64 = 0.0
    shown = true
    line = ""                       # what they last said, and when (said again after a while)
    carrying = false
    was_carrier = false
    activity: LifeActivity = .wait
    cycling = false
    performing = false
    stride = 0.0
    line_t = -100.0
    speed = 0.0                     # (how fast they were last seen going, m/s, held between the
    moving = 0.0                    # world's steps; and for how much longer to count them moving)

# what each trade wears
dress_of = (o: lt.Occupation) -> Dress: match o:
    .merchant: .merchant
    .courier: .pilot
    .racer: .pilot
    .pirate: .pilot
    .patrol: .police
    .mechanic: .worker
    .fisher: .fisher
    .clerk: .merchant
    .telegraphist: .merchant
    .innkeeper: .dress
    .hotelier: .merchant
    .priest: .widow
    .nurse: .dress
    .teacher: .dress
    _: .worker

# where in a town a trade keeps itself (a point on the ground)
work_spot = (tw: Town, o: lt.Occupation, seed: int) -> vec3:
    out = vec3(tw.out.x, 0, tw.out.y)
    side = vec3(-tw.out.y, 0, tw.out.x)
    pick = (k: int) -> vec3: if tw.houses.len() > 0: tw.houses[k % tw.houses.len()] else: tw.center
    p = match o:
        .merchant: tw.center - out * 10.0 + side * f32(f64(seed % 5) * 3.0 - 6.0)
        .courier, .racer, .pirate, .patrol: (if tw.docks.len() > 0: tw.docks[seed % tw.docks.len()] - out * 3.0 + side * f32(if seed % 2 == 0: 6.0 else: -6.0) else: tw.center)
        .fisher: tw.center + out * f32(10.0 + f64(seed % 4) * 6.0)
        .clerk, .telegraphist: pick(0) + out * 7.0
        .innkeeper: pick(2) + out * 6.0
        .mechanic: pick(1) + out * 7.0
        .priest: pick(3) + out * 8.0
        _: pick(seed) + out * 6.0
    p

_ground = (towns: Town[], p: vec3) -> vec3: vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.z))), p.z)

# keep one Folk for each person who is in a town now; drop those who left
sync_folk = (folks: mut Folk[], w: mut World, towns: Town[]):
    daily_scene.configure_life_scene(w,towns)
    seen: {int: bool} = {}
    loop k in 0..w.people.len():
        p = w.people[k]
        if p.occupation == .player: continue
        far_here = p.far_home>=0 and p.id in w.far.near_people
        here = far_here or (p.place >= 0 and p.place < towns.len() and p.state != .traveling and p.state != .departed)
        actual_place = lt.person_place(w,p.id)
        if not here: continue
        seen[p.id] = true
        found = false
        loop mut f in folks:
            if f.person == p.id:
                found = true
                if f.place != actual_place:
                    f.place = actual_place
                    f.pos = p.pose.pos
                    f.target = f.pos
                f.shown = true
        if not found:
            start = p.pose.pos
            folks.push(Folk(p.id, build_figure(dress_of(p.occupation), p.appearance_seed), actual_place, start, start, wait = f64(p.id % 5)))
    i = 0
    loop i < folks.len():
        if seen.get(folks[i].person) == none: folks.remove_at(i) else: i += 1

# a few steps about their spot, a pause, a few more
update_folk = (folks: mut Folk[], w: mut World, towns: Town[], near: vec3, dt: f64):
    loop mut f in folks:
        p = w.people[f.person]
        # (the world moves people in steps, not every frame: drawn, they glide between where they
        # were and where the world has them, and keep walking between its steps, instead of
        # standing still on the frames it doesn't step, which flickers walking and standing)
        goal = p.pose.pos
        jump = f64(length(goal - f.pos))
        old = f.pos
        f.pos = if jump > 4.0: goal else: f.pos + (goal - f.pos) * f32(min(1.0, dt * 10.0))
        if lt.person_place(w,p.id)>=0: f.place = lt.person_place(w,p.id)
        f.carrying = p.carrying >= 0
        f.cycling = false; f.performing = false; f.activity = .wait; f.shown = lt.person_place(w,p.id)>=0 and p.trip < 0
        if p.far_home>=0 and p.id in w.far.people:
            a=w.far.people[p.id]; clock=lt.local_minute(w.minute)
            if (clock<360 or clock>=1320) and length(p.pose.pos-a.home_pos)<2.0: f.shown=false
        if p.id in w.daily_life:
            intent = w.daily_life[p.id]
            f.activity = intent.activity
            f.performing = intent.activity == .play and intent.arrived
            f.cycling = intent.mobility == .bicycle and not intent.arrived and p.carriage < 0
            if intent.arrived and intent.anchor != "" and (intent.venue == .home or intent.venue == .shelter) and (intent.activity == .sleep or intent.activity == .rest): f.shown = false
        nose = quat_rotate(p.pose.rot,vec3(0,0,-1))
        f.yaw = atan2(f64(nose.x),f64(nose.z))
        distance = f64(length(f.pos-old))
        if jump > 0.02 and jump <= 4.0:
            f.speed = f.speed + (distance / max(dt, 0.001) - f.speed) * min(1.0, dt * 6.0)
            f.moving = 0.35
        else:
            f.moving = max(f.moving - dt, 0.0)
            if f.moving <= 0.0: f.speed = f.speed * max(0.0, 1.0 - dt * 6.0)
        f.phase += f.speed * dt * (if f.cycling: 3.0 else: 5.0)
        want = if f.moving > 0.0: 0.7 else: 0.0
        f.stride = f.stride + (want - f.stride) * min(1.0, dt * 6.0)
        f.wait = if f.stride > 0.05: 0.0 else: 1.0

draw_folk = (folks: Folk[], L: Light, t: f64):
    cam = scene_camera()
    loop f in folks:
        if not f.shown or length(f.pos - cam) > 500.0: continue
        draw_figure(f.fig, f.pos, f.yaw, f.phase, f.stride, L, t, carrying=f.carrying,cycling=f.cycling,performing=f.performing)

# the one nearest a point (within reach), or -1
nearest_folk = (folks: Folk[], p: vec3, reach: f64) -> int:
    best = -1
    bd = reach
    loop k in 0..folks.len():
        if not folks[k].shown: continue
        d = f64(length(folks[k].pos - p))
        if d < bd:
            bd = d
            best = k
    best

# ---------------- the world's clock and its jobs, as the board shows them ----------------

# a minute of the world's clock as the time of day, and the day relative to today
clock_text = (w: World, minute: int) -> str:
    start = 9 * 60 + 30
    abs_m = minute + start
    day = abs_m / 1440
    today = (w.minute + start) / 1440
    hm = abs_m % 1440
    t = "{hm / 60:02}:{hm % 60:02}"
    if day == today: "today {t}" else: (if day == today + 1: "tomorrow {t}" else: (if day < today: "overdue" else: "in {day - today} days"))

_place_name = (k: int) -> str: if k >= 0 and k < SETTLEMENTS.len(): SETTLEMENTS[k].name else: "?"

# the jobs posted at a place, as notices
job_notices = (w: World, place: int) -> Notice[]:
    out: Notice[]
    loop id in w.active_jobs:
        j = w.jobs[id]
        if j.origin != place: continue
        if j.state != .open and j.state != .claimed: continue
        poster = w.people[j.poster].name
        what = if j.delivery_mode == .foot: "Carry {w.goods[j.good].key} across {_place_name(j.origin)}" else: if j.purpose == .passenger: "A passenger to {_place_name(j.destination)}" else: (if j.cargo_mode == .sealed: "A sealed dispatch to {_place_name(j.destination)}" else: "{w.goods[j.good].key} to {_place_name(j.destination)}")
        body = if j.purpose == .passenger: "{w.people[j.passenger].name}, wanting passage to {_place_name(j.destination)}." else: (if j.cargo_mode == .sealed: "Carried closed, handed over at {_place_name(j.destination)}." else: "{f64(j.quantity) / 1000.0:.1} loads of {w.goods[j.good].key}, delivered at {_place_name(j.destination)}.")
        if j.cargo_mode != .none: body += " The goods already wait at the warehouse; arrange carrying with the sender or offer to fetch them."
        if j.delivery_mode == .foot: body = "From the warehouse to the marked {if j.drop_store == .boat: "boat at the quay" else: "doorstep"}; no aircraft needed."
        taker = if j.state == .claimed and j.carrier >= 0: w.people[j.carrier].name else: ""
        out.push(Notice(id, poster, what, body, j.reward_cents / 100, "by {clock_text(w, j.due_minute)}", taker))
    out
