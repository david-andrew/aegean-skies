# The plucked phrase a street musician plays in a square or an alley: three beats a second on the
# world's time, a note of the scale or a rest on each, offset by who plays it. Heard through
# src/life_audio.jo (only the nearest musician), seen in src/musician_pose.jo (every one).

use 'music_synth.jo'

STREET_PHRASE = [0, 2, 4, 2, 1, 3, 5, 3, 2, 4, 6, 4, 3, 2, 1, -1]
STREET_SCALE = [0, 2, 3, 5, 7, 9, 10, 12]
const STREET_BEATS = 3.0            # a second
const STREET_ROOT = 62              # D4, MIDI
const STREET_PART = 8               # (a bouzouki's part)

# The scale step played on a beat by a musician (-1: a rest). Every fourth phrase is the theme;
# the others are variations on it: a step moved here and there, a held note, a different turn
# home. (The theme alone, round and round, was a 5.3 s loop heard all day.)
street_step = (beat: int, person: int) -> int:
    n = STREET_PHRASE.len()
    b = beat + person * 3
    phrase = int(floor(f64(b) / f64(n))); step = (b % n + n) % n
    theme = STREET_PHRASE[step]
    if phrase % 4 == 0 or step == n - 1: return theme
    h = street_hash(person, phrase, step, 1)
    if step >= n - 3: return [0, 2, 4][int(h * 2.999)]          # (each phrase finds its own way home)
    if h < 0.12: return -1                                      # (a held note: the last one rings on)
    if h < 0.55: return theme
    clamp(theme + [-2, -1, 1, 2, 1, -1][int(street_hash(person, phrase, step, 2) * 5.999)], 0, STREET_SCALE.len() - 1)

# 0..1 from a few whole numbers, the same every time (splitmix64)
street_hash = (a: int, b: int, c: int, d: int) -> f64:
    z = u64((a * 1000003 + b * 7919 + c * 104729 + d * 15485863 + 12345) and 0x7fffffffffffffff)
    z += (u64(0x9E3779B9) << 32 or u64(0x7F4A7C15))
    z = (z xor (z >> 30)) * (u64(0xBF58476D) << 32 or u64(0x1CE4E5B9))
    z = (z xor (z >> 27)) * (u64(0x94D049BB) << 32 or u64(0x133111EB))
    f64((z xor (z >> 31)) >> 11) / 9007199254740992.0

# The phrase's quarter note, in seconds: each beat is an eighth.
const STREET_QUARTER = 2.0 / STREET_BEATS

# The phrase as note events about time t (two seconds either side), timed from t = 0; each lasts
# as written, to the next note played (a held note rings on over the beat after it).
street_events = (person: int, t: f64) -> MusicEvent[]:
    out: MusicEvent[]
    beat = int(floor(t * STREET_BEATS))
    loop b in (beat - 6)..(beat + 7):
        step = street_step(b, person)
        if step < 0 or b < 0: continue
        beats = 1
        loop beats < 4 and street_step(b + beats, person) < 0: beats += 1
        out.push(MusicEvent(int(f64(b) / STREET_BEATS * f64(MUSIC_RATE)), int(f64(beats) / STREET_BEATS * f64(MUSIC_RATE)), STREET_ROOT + STREET_SCALE[step], STREET_PART, 0.6, 0.3))
    out
