# What a street musician plays in a square or an alley: a tune of the catalogue's (the Greek songs
# and the island dance the radio and the hotel's band play: street_tune), its melody alone, on the
# world's time, offset by who plays it; a different tune by the player and the day. Heard through
# src/life_audio.jo (only the nearest musician), seen in src/musician_pose.jo (every one). The
# plucked phrase below (street_step) is what they played before, kept for a world with no tunes.

use 'music_data.jo'
use 'music_synth.jo'
use 'music_tempo.jo'

STREET_PHRASE = [0, 2, 4, 2, 1, 3, 5, 3, 2, 4, 6, 4, 3, 2, 1, -1]
STREET_SCALE = [0, 2, 3, 5, 7, 9, 10, 12]
const STREET_BEATS = 3.0            # a second
const STREET_ROOT = 62              # D4, MIDI
const STREET_PART = 8               # (a bouzouki's part)

# The scale step played on a beat by a musician (-1: a rest). Every fourth phrase is the theme;
# the others are variations on it: a step moved here and there, a held note, a different turn
# home. (The theme alone, round and round, was a 5.3 s loop heard all day.)
street_step = (beat: int, person: int) -> int:
    n = STREET_PHRASE.len()
    b = beat + person * 3
    phrase = int(floor(f64(b) / f64(n))); step = (b % n + n) % n
    theme = STREET_PHRASE[step]
    if phrase % 4 == 0 or step == n - 1: return theme
    h = street_hash(person, phrase, step, 1)
    if step >= n - 3: return [0, 2, 4][int(h * 2.999)]          # (each phrase finds its own way home)
    if h < 0.12: return -1                                      # (a held note: the last one rings on)
    if h < 0.55: return theme
    clamp(theme + [-2, -1, 1, 2, 1, -1][int(street_hash(person, phrase, step, 2) * 5.999)], 0, STREET_SCALE.len() - 1)

# 0..1 from a few whole numbers, the same every time (splitmix64)
street_hash = (a: int, b: int, c: int, d: int) -> f64:
    z = u64((a * 1000003 + b * 7919 + c * 104729 + d * 15485863 + 12345) and 0x7fffffffffffffff)
    z += (u64(0x9E3779B9) << 32 or u64(0x7F4A7C15))
    z = (z xor (z >> 30)) * (u64(0xBF58476D) << 32 or u64(0x1CE4E5B9))
    z = (z xor (z >> 27)) * (u64(0x94D049BB) << 32 or u64(0x133111EB))
    f64((z xor (z >> 31)) >> 11) / 9007199254740992.0

# The phrase's quarter note, in seconds: each beat is an eighth.
const STREET_QUARTER = 2.0 / STREET_BEATS

# ---------------- the catalogue's tunes ----------------
struct StreetNote:
    start: f64                      # seconds into the tune
    length: f64
    pitch: int

struct StreetTune:
    piece = -1                      # MUSIC_PIECES index (-1: none, the plucked phrase instead)
    notes: StreetNote[]
    seconds = 0.0                   # the tune's length
    quarter = STREET_QUARTER        # its quarter note, in seconds
    low = STREET_ROOT
    high = STREET_ROOT + 12

# The tunes: the Greek dances and songs of the 1877 collection, and Ikariotikos (data/music/SOURCES.md).
STREET_TUNE_PIECES = [103, 104, 105, 5, 107, 108, 106, 109, 110]
const STREET_REST = 6.0             # seconds between one playing of the tune and the next
street_day = 0                      # (the world's day: the tune changes with it)
street_tunes_on = true
street_tune_cache: {int: StreetTune} = {}

set_street_day = (day: int):
    global street_day
    street_day = day

# which tune this player plays today
street_piece = (person: int) -> int:
    n = STREET_TUNE_PIECES.len()
    piece = STREET_TUNE_PIECES[((person * 7 + person / 5 * 2 + street_day * 4) % n + n) % n]
    if not street_tunes_on or piece >= MUSIC_PIECES.len(): -1 else: piece

# A piece's melody alone: of its tune's instrument (the bouzouki's, else the violin's), the top
# note at each onset, held to the next.
street_tune = (piece: int) -> StreetTune:
    global street_tune_cache
    if piece < 0: return StreetTune()
    if let tune = street_tune_cache.get(piece): return tune
    s = MusicSynth()
    music_load(s, piece)
    plucked = false
    loop e in s.events:
        if e.instrument == 8: plucked = true
    lead: MusicEvent[]
    loop e in s.events:
        if e.instrument == (if plucked: 8 else: 0): lead.push(e)
    lead.sort((e: MusicEvent): (e.start, -e.pitch))
    tune = StreetTune(piece = piece)
    rate = f64(MUSIC_RATE)
    loop e in lead:
        at = f64(e.start) / rate
        if tune.notes.len() > 0:
            last = tune.notes[tune.notes.len() - 1]
            if at - last.start < 0.03: continue
            tune.notes[tune.notes.len() - 1].length = clamp(at - last.start, 0.06, last.length)
        tune.notes.push(StreetNote(at, max(0.06, f64(e.duration) / rate), e.pitch))
    if tune.notes.len() == 0: return StreetTune()
    first = tune.notes[0].start
    tune.low = 127; tune.high = 0
    loop k in 0..tune.notes.len():
        tune.notes[k].start -= first
        tune.low = min(tune.low, tune.notes[k].pitch); tune.high = max(tune.high, tune.notes[k].pitch)
    final = tune.notes[tune.notes.len() - 1]
    tune.seconds = final.start + final.length
    if piece < MUSIC_TEMPO.len() and MUSIC_TEMPO[piece].len() > 0: tune.quarter = f64(MUSIC_TEMPO[piece][0].y)
    street_tune_cache[piece] = tune
    tune

# the tune this player plays today (its quarter note, for a played note's written value)
street_tune_of = (person: int) -> StreetTune: street_tune(street_piece(person))
street_quarter = (person: int) -> f64: street_tune_of(person).quarter

# What the player plays about time t (two seconds either side), as note events timed from t = 0:
# the day's tune, round and round with a rest between, begun at the player's own moment.
street_events = (person: int, t: f64) -> MusicEvent[]:
    tune = street_tune_of(person)
    if tune.piece < 0: return street_phrase_events(person, t)
    out: MusicEvent[]
    cycle = tune.seconds + STREET_REST
    u = t + f64(person) * 7.3
    begun = t - (u - floor(u / cycle) * cycle)
    loop round in [-1, 0, 1]:
        from = begun + f64(round) * cycle
        if from > t + 2.4 or from + tune.seconds < t - 2.1: continue
        loop n in tune.notes:
            at = from + n.start
            if at < t - 2.0 or at > t + 2.3 or at < 0.0: continue
            out.push(MusicEvent(int(at * f64(MUSIC_RATE)), max(1, int(n.length * f64(MUSIC_RATE))), n.pitch, STREET_PART, 0.6, 0.3))
    out

# The phrase as note events about time t (two seconds either side), timed from t = 0; each lasts
# as written, to the next note played (a held note rings on over the beat after it).
street_phrase_events = (person: int, t: f64) -> MusicEvent[]:
    out: MusicEvent[]
    beat = int(floor(t * STREET_BEATS))
    loop b in (beat - 6)..(beat + 7):
        step = street_step(b, person)
        if step < 0 or b < 0: continue
        beats = 1
        loop beats < 4 and street_step(b + beats, person) < 0: beats += 1
        out.push(MusicEvent(int(f64(b) / STREET_BEATS * f64(MUSIC_RATE)), int(f64(beats) / STREET_BEATS * f64(MUSIC_RATE)), STREET_ROOT + STREET_SCALE[step], STREET_PART, 0.6, 0.3))
    out
