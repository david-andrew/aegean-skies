# Speech particulars. This module reads the speaker's own work, local observations and saved
# knowledge; it never turns an unseen remote event into a fact just to fill a sentence.
use 'living_types.jo'
use 'life_types.jo'
use 'living_conditions.jo'
use 'living_place_context.jo'
use 'living_questions.jo'
use 'living_schedule.jo'
use 'living_voice_lines.jo'

ctx_name = (w: World, person: int) -> str:
    if person == w.player: return "pilot"
    if person < 0 or person >= w.people.len(): return "the harbour office"
    parts = split(w.people[person].name," ")
    if parts.len()>1 and parts[0] == "Father": parts[0]+" "+parts[1] else: parts[0]

ctx_money = (cents: int) -> str:
    if cents%100 == 0: "{cents/100} {if cents == 100: "lira" else: "lire"}" else: "{f64(cents)/100.0:.2} lire"

ctx_time = (w: World, minute: int) -> str:
    t = local_minute(minute); days = day_index(w.minute)-day_index(minute)
    time = "{t/60:02}:{t%60:02}"
    if days == 0: time else: if days == 1: "yesterday at {time}" else: if days == -1: "tomorrow at {time}" else: if days < -1: "in {abs(days)} days at {time}" else: "{days} days ago at {time}"

ctx_load = (w: World, good: int, amount: int) -> str:
    if good < 0: return "the sealed dispatch bag"
    if good == 1 and amount == 100: return "a bottle of wine"
    unit = if good == 1 or good == 2: "barrel" else: if good == 3: "sack" else: if good == 6: "box" else: if good == 4: "tin" else: "crate"
    if amount == 1000: "a {unit} of {w.goods[good].key}" else: "{f64(amount)/1000.0:.1} {if unit == "box": "boxes" else: unit+"s"} of {w.goods[good].key}"

ctx_bank = (lines: str[], key: str, priority: int = 100) -> SpeechCandidate[]:
    [loop k in 0..lines.len(): SpeechCandidate("{key}:{k}",lines[k],priority)]

ctx_venue = (venue: VenueKind) -> str: match venue:
    .home: "my door"
    .quay: "the quay"
    .market: "the market"
    .cafe: "the cafe"
    .church: "the church"
    .square: "the square"
    .fields: "the fields"
    .workshop: "the workshop"
    .shelter: "the covered doorway"
    .school: "the school"

ctx_direction = (wind: vec3) -> str:
    # Weather stores velocity toward; people name the direction it comes from.
    angle = atan2(f64(-wind.x),f64(wind.z))
    names = ["north","north-east","east","south-east","south","south-west","west","north-west"]
    names[(int(round(angle/(PI/4.0)))+8)%8]

context_work = (w: World, speaker: int) -> SpeechCandidate[]:
    p = w.people[speaker]; place = life_place_name(w,person_place(w,speaker))
    if p.carriage >= 0 and p.carriage in w.carriage:
        task = w.carriage[p.carriage]
        if task.job in w.jobs:
            j = w.jobs[task.job]; owner = ctx_name(w,j.poster)
            cargo = ctx_load(w,j.good,if task.cargo in w.cargo: w.cargo[task.cargo].quantity else: j.quantity)
            end = if task.unloading or j.delivery_mode == .foot: (if j.drop_store == .boat: "the boat at {place}'s quay" else: "the delivery point in {place}") else: "the aircraft at {place}"
            pickup = if task.unloading: "the aircraft" else: "the warehouse"
            lines = if task.phase == .fetch: ["I'm fetching {owner}'s {cargo} from {pickup} at {place}.","{owner} has {cargo} waiting by {pickup}. That's where I'm going.","Let me get to {pickup} first: {owner}'s {cargo} won't walk to {end}."] else: ["This is {owner}'s {cargo}, for {end}. Mind your elbow.","I'm taking {cargo} to {end} for {owner}. Walk on this side.","{owner} is waiting for {cargo} at {end}. I'll talk when I've set it down."]
            if task.blocked != "": lines = ["I can't get {owner}'s {cargo} through to {end}. The walking route is blocked.","{cargo} for {owner}, and no clear way to {end}. I need a clear way through before I lift it again."]
            return ctx_bank(lines,"carriage:{task.id}:{task.phase}",150)
    result: SpeechCandidate[]
    loop id in p.obligations:
        if not (id in w.obligations): continue
        o = w.obligations[id]
        if o.debtor != speaker or (o.state != .open and o.state != .blocked): continue
        if o.kind == .delivery:
            cargo = ctx_load(w,o.reason.good,o.reason.quantity); to = life_place_name(w,o.reason.destination)
            who = ctx_name(w,o.reason.beneficiary); by = ctx_time(w,o.due_minute)
            result += ctx_bank(["{who} wants {cargo} in {to} by {by}. That's what I've given my word on.","I've {cargo} for {who} at {to}, promised by {by}. That is the promise I have to keep.", "{to}, {by}: {who}'s {cargo}. I keep going over it so I don't forget."],"promise:{id}",135)
    loop id in w.open_obligations:
        o = w.obligations[id]
        if o.kind != .repair or o.mechanic != speaker or o.state == .fulfilled or o.state == .cancelled: continue
        who = ctx_name(w,o.debtor)
        result += ctx_bank(["{who}'s engine needs my attention in {place}. There's {ctx_money(o.amount_cents)} on the bill.","I've {who}'s aircraft to see to here at {place}. Ask me after I've finished with it.","It's {who}'s engine I have to finish here at {place}. Tell me if you've brought another job."],"repair-work:{id}",130)
    result

context_day = (w: World, speaker: int, voice: VoiceKind, listener: int = -1) -> SpeechCandidate[]:
    p = w.people[speaker]; place = life_place_name(w,person_place(w,speaker))
    own = context_work(w,speaker)
    if own.len()>0: return own
    result: SpeechCandidate[]
    if speaker in w.daily_life:
        intent = w.daily_life[speaker]; where = ctx_venue(intent.venue)
        if not intent.arrived:
            lines = match voice:
                .salt: ["I'm for {where} in {place}. Tell me while we walk.","{where} at {place}. The feet are slower than the mouth; come along.","I've not reached {where} yet. {place} won't move it any nearer for me."]
                .anxious: ["I meant to be at {where} in {place} already. I've let myself get stopped on the way again.", "Walk this way with me. I'm trying to reach {where} at {place}.","{where}, {place}. I say it aloud, or I find another thing to do on the way."]
                .formal: ["My business takes me to {where} in {place}. We may speak as far as the corner.","If you require me, I am bound for {where} at {place}.","The walk to {where} is not the whole business of {place}, though one might think so today."]
                .wry: ["I'm going to {where} in {place}. I shall look indispensable when I get there.","{where} at {place}. If I reach it before remembering another errand, applaud.","You can improve the walk to {where}, if you've a story from {place}."]
                _: ["Come as far as {where} with me. I've things to see to in {place}.","I'm on my way to {where} in {place}. Walk with me if you've a question.", "Try {where} at {place} if you don't find me here again."]
            result += ctx_bank(lines,"walk:{intent.anchor}")
        else:
            time = ctx_time(w,w.minute)
            if intent.activity == .rest or intent.activity == .sleep:
                result += ctx_bank(["It's {time} at {place}. I'm keeping a little quiet at {where}.","At {time} I mean to rest here in {place}. The quay can have me later.","Leave a little of {time} to me. I came to {where} at {place} to rest."],"rest:{intent.anchor}")
            else if intent.activity == .pray:
                result += ctx_bank(["I'm at the church in {place}. We can speak after the service.","It's Sunday at {place}; I came here for the service, not the price of oil.","If it isn't urgent, wait outside {place}'s church. I'll come out to you."],"church:{intent.anchor}")
            else if intent.companion >= 0:
                who = ctx_name(w,intent.companion)
                result += ctx_bank(["I came to {where} to meet {who}. We have until {ctx_time(w,intent.until_minute)}.","{who} and I arranged to meet at {where}. Don't let me miss them while we're talking.","I'm waiting for {who} at {where}. Stay here and we'll have three voices instead of two."],"companion:{intent.companion}",120)
    # Operators know their own fuel and damage; bystanders do not read a hidden aircraft record.
    if p.craft >= 0:
        c = w.aircraft[p.craft]; kind = str(c.kind); fuel = f64(c.fuel_ml)/1000.0
        lines=[voice_craft(voice,kind,"{fuel:.1}",place)]
        if c.engine<500 or c.hull<500:
            lines=["My {kind} at {place} needs work; I've {fuel:.1} litres aboard."]
        result += ctx_bank(lines,"own-craft:{c.id}:{c.fuel_ml}",108)
    if p.occupation == .fisher:
        loop b in p.prices:
            if b.good != 0 or b.place != p.place or b.confidence < 300 or w.minute-b.observed_minute>1440: continue
            price = ctx_money(b.cents); quoted_at = ctx_time(w,b.observed_minute)
            result += ctx_bank([voice_price(voice,"fish",price,place,quoted_at)],"catch-price:{b.observed_minute}",110)
    until=current_shift_end(p.occupation,w.minute)
    if until>w.minute and p.place==p.home and p.trip<0:
        line=match voice:
            .salt: "My shift off {place} ends at {ctx_time(w,until)}; there's time for a word."
            .shop: "I'm at the {place} counter until {ctx_time(w,until)}."
            .formal: "My shift here in {place} ends at {ctx_time(w,until)}."
            .guarded: "{ctx_time(w,until)} ends my shift at {place}; don't keep me past it."
            .anxious: "I have to be at work in {place} until {ctx_time(w,until)}."
            .warm: "I'm working here in {place} until {ctx_time(w,until)}; we can talk between callers."
            .wry: "{ctx_time(w,until)} is when {place} gets rid of me for this shift."
            .measured: "My work here in {place} runs until {ctx_time(w,until)}."
        result += ctx_bank([line],"shift:{day_index(w.minute)}:{until}",112)
    if p.place >= 0 and p.place < w.places.len() and (p.occupation == .merchant or p.occupation == .quartermaster):
        m = w.places[p.place].market
        g = (speaker+day_index(w.minute))%GOOD_COUNT
        amount = m.inventory.qty[g]-m.inventory.reserved[g]
        if amount > 0:
            result += ctx_bank(["I've {ctx_load(w,g,amount)} free in the {place} warehouse. The rest is already promised.","If you've come for {w.goods[g].key}, I can point to {ctx_load(w,g,amount)} in the {place} warehouse.","There's {ctx_load(w,g,amount)} at {place} that hasn't a carrier yet. Ask about the price before lifting it."],"own-stock:{g}",110)
    loop child in w.households:
        if child.guardian == speaker:
            result += ctx_bank(["{child.name} is {child.age}.","{child.name} gets the time after my work in {place}.","I have {child.name} to look after here in {place}."],"child:{child.id}",109)
    # Visible quay craft are observed locally, never a remote timetable pulled from hidden state.
    loop c in w.aircraft:
        if c.place != p.place or c.state != .moored or length(c.pose.pos-p.pose.pos)>90: continue
        owner = ctx_possessive(w,c.owner,speaker,listener); kind = str(c.kind); kind=upper(kind[0..1])+kind[1..]
        if c.owner != speaker:
            lines=match voice:
                .salt: ["{owner} {kind} is on a line at {place}; ask its pilot about the crossing."]
                .shop: ["{owner} {kind} is alongside at {place}; talk to its owner before you book a load."]
                .formal: ["At {place}, {owner} {kind} is moored alongside; its pilot can answer about passage."]
                .guarded: ["{owner} {kind}, there at {place}. I don't answer for another pilot's cargo."]
                .anxious: ["Is that {owner} {kind} at {place}?" ]
                .wry: ["{owner} {kind} has found a berth at {place}. The pilot can do the promising."]
                .warm: ["You can see {owner} {kind} from here at {place}. Go and speak to the pilot if you need passage."]
                .measured: ["{owner} {kind} is alongside at {place}. Its pilot is the one to ask about a load."]
            # This is an observation, not a question for the listener to answer.
            if voice==.anxious: lines=["{owner} {kind} is still at {place}'s quay; I look for the pilot before I promise a crossing."]
            if c.owner==listener:
                lines=match voice:
                    .salt: ["Your {kind} is on a line at {place}. You've shore under your feet for a moment."]
                    .shop: ["Your {kind} has a berth here at {place}; we can talk at the counter before you leave."]
                    .formal: ["Your {kind} is moored at {place}; its line is visible from here."]
                    .guarded: ["That's your {kind} at {place}. Your hold is your business."]
                    .anxious: ["I can still see your {kind} from here at {place}; stand beside me a minute."]
                    .warm: ["Your {kind} is alongside here at {place}. I'm glad you've stopped ashore."]
                    .wry: ["Your {kind} has found a line at {place}; at least it knows where to wait."]
                    .measured: ["Here at {place}, your {kind} is tied up beside the quay we're standing on."]
            result += ctx_bank(lines,"visible-craft:{c.id}",102)
    result

context_greeting = (w: World, speaker: int, listener: int, voice: VoiceKind, known: bool) -> SpeechCandidate[]:
    name = ctx_name(w,listener); own = ctx_name(w,speaker)
    hour = local_minute(w.minute)/60
    hello = if hour < 5: "A late hour" else: if hour < 12: "Good morning" else: if hour < 18: "Good afternoon" else: "Good evening"
    lines=if known:
        match voice:
            .salt: ["{name}. You've found the same old mooring.","Come alongside, {name}. I know that face.","{hello}, {name}. A word before the tide turns."]
            .shop: ["{hello}, {name}. Back at my counter.","{name}, I remember you. What brings you in today?","Good to see you again, {name}. We can leave the prices a moment."]
            .formal: ["{hello}, {name}. We have spoken before.","I remember our last conversation, {name}. Please go on.","{name}, thank you for calling again."]
            .guarded: ["{name}. I remember you; keep your voice down.","Back again, {name}. Listening is still all I've promised.","I know you, {name}. Don't crowd me."]
            .anxious: ["{name}. I'm glad you came back.","There you are, {name}. I was watching the quay.","{hello}, {name}. Stand here; I can hear you better."]
            .warm: ["{hello}, {name}. Come and stand beside me.","You've come back, {name}. Sit if you're stopping.","{name}, you needn't introduce yourself twice."]
            .wry: ["{name}. We meet again, before either of us looks busy.","{hello}, {name}. I haven't forgotten the voice.","You know where to find me now, {name}."]
            .measured: ["{hello}. It's {name} again.","We met here before, {name}. I've time to listen.","{name}, I remember where we left off."]
    else:
        match voice:
            .salt: ["{own}. That's my name, {name}; come alongside.","{hello}. Call me {own}, if we haven't met.","A new face, {name}. I'm {own}."]
            .shop: ["{hello}, {name}. I'm {own}; this is my counter.","{own}, {name}. Tell me what you've come looking for.","We haven't done business yet, {name}. I'm {own}."]
            .formal: ["{hello}. {own}; I don't believe we've been introduced.","My name is {own}, {name}. Please come within earshot.","{name}, I am {own}. You have my attention."]
            .guarded: ["I don't know you, {name}. {own}. Listening is all I've promised.","{name}. You can call me {own}; keep the quay out of this.","{own}, if you need a name. Say what you came to say."]
            .anxious: ["{hello}. I'm {own}; have we spoken before?","{name}. {own}. Come this side, where I can hear.","I don't know your voice yet, {name}. Mine's {own}."]
            .warm: ["{hello}. I'm {own}. We haven't spoken before.","Come closer, {name}. I'm {own}; I can spare a word.","You can call me {own}, {name}. No need to stand so far away."]
            .wry: ["We haven't quarrelled yet, {name}. I'm {own}.","{name}. {own}. That's the introductions done.","I'm {own}, {name}. Speak before somebody gives me work."]
            .measured: ["{hello}, {name}. {own} is my name.","I don't know you yet, {name}. Call me {own}.","{own}. A first conversation needn't be a formal one, {name}."]
    if known:
        extra=match voice:
            .salt: ["{name}. I know your step on these boards.","{hello}. You and I have traded words here before, {name}.","Back by my line, {name}. I remember you."]
            .shop: ["{name}, I've kept your last visit in mind.","Your face is familiar at this counter, {name}.","Back for a word, {name}; I remember where we stopped."]
            .formal: ["We have met, {name}; another introduction is unnecessary.","{name}, I recall your last call.","Please come closer, {name}; I recognise your voice."]
            .guarded: ["We know one another, {name}; leave it at that.","{name}, you've had my ear before.","I remember what you said, {name}. Go on."]
            .anxious: ["I'm relieved to see that face again, {name}.","You made it back, {name}; stand beside me a moment.","{name}, I haven't lost track of our last talk."]
            .warm: ["Good to have you beside me again, {name}.","{name}, there is no need to stand on ceremony with me now.","It's your voice again, {name}; come and tell me how you are."]
            .wry: ["{name}, we have survived a conversation before.","Back for another answer, {name}.","{hello}. I knew we'd find something else to discuss, {name}."]
            .measured: ["I recognise you, {name}; we can begin where we stopped.","A familiar voice, {name}. Let us talk.","{name}, our last meeting is still in my mind."]
        lines += extra
    # Questions are added through the typed domain below, never hidden in an untyped greeting.
    if not known and voice==.anxious: lines[0]="{hello}. I'm {own}; I don't believe we've spoken."
    if known and voice==.shop: lines[1]="{name}, I remember you. Come out of the way of the counter."
    result = ctx_bank(lines,"hello:{known}")
    # Greeting bodies and follow-ups use the same typed question contract.
    q = followup_questions(voice,.greeting)[0]
    result[0].text += " "+q.text; result[0].ask = q
    result

context_farewell = (w: World, speaker: int, listener: int, voice: VoiceKind) -> SpeechCandidate[]:
    name = ctx_name(w,listener)
    lines = match voice:
        .salt: ["Safe home, {name}. Mind the water.","Till next time, {name}. Keep a line ashore.","Go on, {name}; I've kept you long enough.","{name}, don't hurry the sea on my account."]
        .guarded: ["We're finished, {name}. Keep this conversation here.","Go carefully, {name}. I've said my piece.","Enough for now, {name}. Remember what I said.","You can go, {name}. Don't repeat my name over it."]
        .formal: ["Good day, {name}. Thank you for calling.","I won't keep you, {name}. A safe journey.","Until our next conversation, {name}.","Good day to you, {name}. You know where to find me."]
        .shop: ["Good day, {name}. The counter will still be here.","Till next time, {name}. Ask before you promise a load.","Go on, {name}. I have the shop to see to."]
        .anxious: ["Take care on the crossing, {name}.","Come back safely, {name}. Leave word when you arrive.","Safe home, {name}. I'll look for you at the quay."]
        .wry: ["Off you go, {name}, before we find another bill.","Till we next look busy, {name}.","Go well, {name}. I've kept you out of work long enough."]
        .measured: ["Until another day, {name}.","A safe journey from here, {name}.","I'll let you get on, {name}. Thank you for stopping."]
        .warm: ["Take care, {name}. Come back when you've time.","Safe journey, {name}. I'm glad you stopped.","Till next time, {name}. I must get on."]
    ctx_bank(lines,"goodbye")


context_weather = (w: World, speaker: int, voice: VoiceKind) -> SpeechCandidate[]:
    p = w.people[speaker]; place = life_place_name(w,person_place(w,speaker))
    wind = wind_at(w,p.pose.pos); speed = f64(length(wind))*1.94384; from = ctx_direction(wind)
    t = ctx_time(w,w.minute)
    closed = p.place >= 0 and p.place < w.places.len() and w.places[p.place].harbor_closed
    lines = if closed: ["{place}'s harbour is closed. That {from} wind is not a matter for arguing with the clerk.","The office has stopped departures at {place}. There's {speed:.1} knots coming from the {from}.","Stay ashore at {place} until they lift the closure. Look at that {from} wind before promising anyone a crossing."] else: match voice:
        .salt: ["{from} wind off {place}, {speed:.1} knots. Watch what it does along the quay.","At {t} it's coming from the {from} here at {place}. The next headland can tell you its own story.","Look at the water off {place}. That {from} wind is doing {speed:.1} knots.","No need to ask my knees: {place} has a {from} wind at {t}."]
        .anxious: ["From the {from} at {place}, at the quay. I make it {speed:.1} knots.","{from} wind here at {place}. If you're going out at {t}, leave word of your destination.","I've looked again: {from} at {place}, {speed:.1} knots. Look at the water beyond the moorings.", "It's {t}, with wind from the {from} at {place}. I can't promise it past the next headland."]
        .formal: ["The wind off {place} is from the {from}, {speed:.1} knots at {t}. Watch the harbour mouth before casting off.","At {place}, {t}: {from} wind. I would check it again before fixing a departure time."]
        .shop: ["If you're setting a load out of {place}, there's {speed:.1} knots from the {from} at {t}.","The {place} counter can promise a price; outside it's a {from} wind, {speed:.1} knots."]
        .guarded: ["Choose your own crossing; {place} has {speed:.1} knots from the {from} at {t}.","You can feel the {from} wind here at {place}; I won't choose a departure for you."]
        .warm: ["We've a {from} wind off {place} at {t}, {speed:.1} knots. Take care at the harbour mouth.","Look at the water here at {place}; the wind is from the {from}, {speed:.1} knots."]
        .wry: ["{place}'s {from} wind hasn't read anyone's timetable; it's doing {speed:.1} knots at {t}.","From the {from}, {speed:.1} knots at {place}; no arguing it round to a better quarter."]
        .measured: ["Here at {place}, I make the wind {speed:.1} knots from the {from} at {t}.","The wind at {t} is from the {from} off {place}; look again before you leave."]
    ctx_bank(lines,"local-weather:{from}:{closed}")

context_music = (w: World, speaker: int) -> SpeechCandidate[]:
    p = w.people[speaker]; place = life_place_name(w,person_place(w,speaker))
    result: SpeechCandidate[]
    loop other in w.people:
        if other.place != p.place or not (other.id in w.daily_life): continue
        intent = w.daily_life[other.id]
        if intent.activity != .play or not intent.arrived or length(other.pose.pos-p.pose.pos)>25: continue
        who = ctx_name(w,other.id)
        lines=if other.id==speaker: ["I'm playing the mandolin here in {place}; let me finish this phrase."] else: [voice_music(voice_of_context(w,speaker),who,place)]
        result += ctx_bank(lines,"heard-music:{other.id}",120)
    if result.len()==0:
        result=ctx_bank([voice_no_music(voice_of_context(w,speaker),place,ctx_time(w,w.minute))],"no-music")
    result

# Turning a question back answers that domain; a berth/fuel report is not an answer about food.
context_question_answer = (w: World, speaker: int, q: TalkQuestion) -> str[]:
    p = w.people[speaker]; place = life_place_name(w,person_place(w,speaker))
    match q.kind:
        .route:
            if p.trip >= 0 and p.trip in w.trips:
                trip = w.trips[p.trip]
                return ["I'm bound for {life_place_name(w,trip.destination)} from {life_place_name(w,trip.origin)}. That's the crossing I've committed to.","{life_place_name(w,trip.destination)} is my destination. I left {life_place_name(w,trip.origin)} at {ctx_time(w,trip.departed_tick/TICKS_PER_MINUTE)}."]
            if speaker in w.daily_life:
                d = w.daily_life[speaker]
                return ["My next few steps are to {ctx_venue(d.venue)} in {place}. I haven't arranged another crossing.","Here in {place}, as far as {ctx_venue(d.venue)}. I'm not booked for a sea crossing."]
            return ["I haven't booked a crossing from {place}. Ask me when there's a journey to tell you about."]
        .company:
            if speaker in w.daily_life:
                d = w.daily_life[speaker]
                return ["I have until {ctx_time(w,d.until_minute)} here at {ctx_venue(d.venue)}. Sit with me if you have as long.","{ctx_time(w,d.until_minute)} is when I mean to move on from {ctx_venue(d.venue)}. Until then, I'm listening."]
            return ["I can give you a minute here in {place}. If somebody calls me away, we'll finish another time."]
        .meal:
            # Individual meals aren't simulated: do not invent one in response to a legacy save.
            return ["Don't fuss over my supper. Let me ask after you for once.","Leave my supper to me. I'll ask after yours; you can spare me that much."]
        else: []

context_reply = (w: World, speaker: int, listener: int, q: TalkQuestion, reply: TalkReply) -> str[]:
    name=ctx_name(w,listener); voice=voice_of_context(w,speaker)
    if reply==.discreet: return [voice_privacy(voice,life_place_name(w,person_place(w,speaker)))]
    if reply==.tease: return ["{name}, you answered my question with a joke; I heard it."]
    if reply==.decline:
        line=match voice:
            .salt: "No more needed, {name}; I'll let you get on."
            .shop: "You needn't give me a longer answer, {name}."
            .formal: "That will do, {name}; I won't press you."
            .guarded: "Keep the rest to yourself, {name}."
            .anxious: "All right, {name}; I won't keep you standing here."
            .warm: "Another time will do, {name}."
            .wry: "A short answer saves us both time, {name}."
            .measured: "We can leave it there, {name}."
        return [line]
    index=match q.kind:
        .day: 0
        .company: 1
        .news: 2
        .route: 3
        .work: 4
        .meal: 5
        _: 6
    lines=match voice:
        .salt: ["Glad the day held for you, {name}.", "Come alongside, {name}; there's room for a little company.", "Keep my name with the news when you tell it, {name}.", "Settle your shore business first, {name}.", "Look at the cargo before giving your word, {name}.", "Good; no need to send you to the galley, {name}.", "I'll hear you, {name}."]
        .shop: ["A good day's business is worth having, {name}.", "Stay at the counter a moment, {name}; we needn't spend the whole time on prices.", "If you pass on that price or account, say it came from me, {name}.", "Your business here comes first, {name}; we can talk before you leave.", "See the load and its terms before agreeing, {name}.", "Then you needn't leave the counter to eat, {name}.", "Tell me what you came for, {name}."]
        .formal: ["I am pleased your day has gone well, {name}.", "Thank you for making time to speak, {name}.", "Please name your source when repeating that account, {name}.", "I won't delay your business here, {name}.", "Examine the cargo before making an agreement, {name}.", "Then I need not keep you from a meal, {name}.", "Please go on, {name}."]
        .guarded: ["Good for you, {name}; leave my day to me.", "You can stay, {name}, but keep the other voices out of it.", "Don't turn my account into your own eyewitness story, {name}.", "Keep your destination until you've chosen it, {name}.", "Don't put your name to a load you haven't seen, {name}.", "Your supper is your business, {name}.", "I've promised to listen, {name}, nothing else."]
        .anxious: ["I'm glad something has gone right today, {name}.", "Stay here where I can hear you, {name}.", "Tell them who told you, {name}; I don't want the account altered.", "Do what you must here first, {name}; tell me before casting off.", "Check the load again before promising it, {name}.", "Good, {name}; I needn't worry about keeping you from food.", "Say it again if I miss a word, {name}."]
        .warm: ["I'm glad the day's been kind to you, {name}.", "Sit beside me, {name}; I wanted company rather than a customer.", "Pass it on as something I told you, {name}.", "Finish your business, {name}; I'll be glad of a word before you go.", "Have a look first, {name}; I won't hurry your answer about the load.", "Then sit a little, {name}; your meal needn't wait on me.", "You have my ear, {name}."]
        .wry: ["Then I'll try not to spoil your good day, {name}.", "A minute stolen from work won't ruin us, {name}.", "Leave my name on the story, {name}; I can answer for my own mistakes.", "Business before the crossing, {name}; a sensible order for once.", "A look at the cargo is cheaper than a broken promise, {name}.", "Then you won't have to listen on an empty stomach, {name}.", "Go on, {name}; I haven't found a reason to object yet."]
        .measured: ["It is good to hear the day has gone well for you, {name}.", "We have a little time to talk, then, {name}.", "Keep the original source with that news, {name}.", "There is business here to finish before another journey, {name}.", "The load can wait while you consider the terms, {name}.", "Then we can speak without delaying your food, {name}.", "I'm listening to you, {name}."]
    [lines[index]]

voice_of_context = (w: World, person: int) -> VoiceKind:
    p=w.people[person]
    if p.traits.honesty<400: return .guarded
    match p.occupation:
        .fisher: if p.age>=50: VoiceKind.salt else: VoiceKind.wry
        .merchant, .quartermaster: .shop
        .clerk, .patrol: .formal
        .courier: if p.age<=32: VoiceKind.anxious else: VoiceKind.wry
        .racer, .mechanic, .miller: .wry
        .innkeeper, .hotelier, .teacher: .warm
        _: .measured

ctx_possessive = (w: World, person: int, speaker: int, listener: int) -> str:
    if person==speaker: return "my"
    if person>=0 and person==listener: return "your"
    if person==w.player: return w.people[person].name+"'s"
    ctx_name(w,person)+"'s"

# A vocative doesn't turn the pronoun I (or I've/I'd) into lowercase i.
ctx_after_name = (text: str) -> str:
    if text.starts_with("I ") or text.starts_with("I'"): return text
    if text=="": return text
    lower(text[0..1])+text[1..]
