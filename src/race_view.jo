# What the player sees of an air meet: the board notice, the entry prompt, the start countdown,
# the next gate, lap and place, and the result. Reads AirEvents; never changes race state.
use 'air_events.jo'
use 'air_race.jo'
use 'hud.jo'
use 'panels.jo'
use 'render_space.jo'
import 'living_types.jo' as data
import 'living_calendar.jo' as calendar

const RACE_TICKS_PER_SECOND = 60.0

_meet_place = (w: data.World, capital: int, meet_name: str = "") -> str:
    if capital in w.place_contexts: return w.place_contexts[capital].name
    if meet_name.ends_with(" air meeting"): return meet_name[0..(meet_name.len() - 12)]
    "the capital"

_ordinal = (n: int) -> str:
    tail = if n % 100 >= 11 and n % 100 <= 13: "th" else: (if n % 10 == 1: "st" else: (if n % 10 == 2: "nd" else: (if n % 10 == 3: "rd" else: "th")))
    "{n}{tail}"

_race_clock = (ticks: int) -> str:
    s = max(0.0, f64(ticks) / RACE_TICKS_PER_SECOND)
    m = int(s / 60.0)
    "{m}:{s - f64(m) * 60.0:04.1}"

# Board notices for the nearest meets: today's if still open, then feast days in the next two
# days. Notice ids are negative, so a click never takes them as a job.
air_meet_notices = (events: AirEvents, w: data.World, from: vec3, clock: (int) -> str, limit: int = 2) -> Notice[]:
    picks: (f64, str, int, str)[]      # distance, place, race minute, course
    today = data.day_index(w.minute)
    loop meet in events.meets:
        if meet.phase != .registration or w.tick >= meet.race_tick or meet.gates.len() == 0: continue
        picks.push((f64(length(meet.gates[0].center - from)), _meet_place(w, meet.capital, meet.name), meet.race_tick / data.TICKS_PER_MINUTE, "{if meet.laps == 2: "Two" else: "{meet.laps}"} laps of {meet.gates.len()} gates"))
    loop country in w.countries:
        capital = country.capital_id
        if not (capital in w.far.harbors) or not (capital in w.place_contexts): continue
        start = calendar.next_capital_feast_minute(capital, w.minute)
        if start < 0 or data.day_index(start) <= today or data.day_index(start) > today + 2: continue
        picks.push((f64(length(w.place_contexts[capital].center - from)), _meet_place(w, capital), start, "Two laps of a pylon course"))
    picks.sort(key = (p: (f64, str, int, str)): p.0)
    out: Notice[]
    loop k in 0..min(limit, picks.len()):
        p = picks[k]; place = p.1
        out.push(Notice(-1 - k, "{place} flying club", "Air race at {place}",
            "{p.3} over the harbor. Enter at {place} in your own aircraft, fuelled and sound.",
            AIR_MEET_FEE_CENTS / 100, clock(p.2), pay_text = "Entry {AIR_MEET_FEE_CENTS / 100} lire"))
    out

# The meet the player may enter from here, or -1: open for entries, near its harbor, not entered.
race_offer = (events: AirEvents, w: data.World, position: vec3) -> int:
    loop k in 0..events.meets.len():
        meet = events.meets[k]
        if meet.phase != .registration or w.tick >= meet.race_tick or meet.gates.len() == 0 or meet.entries.len() >= 8: continue
        if player_air_entry(meet, w.player) != none: continue
        if length(meet.gates[0].center - position) < 12000: return k
    -1

race_offer_text = (events: AirEvents, w: data.World, k: int) -> str:
    "F  enter the race at {_meet_place(w, events.meets[k].capital, events.meets[k].name)}, fee {AIR_MEET_FEE_CENTS / 100} lire"

# The meet the player is entered in and should see on the HUD, or -1. A result stays up for
# a while after the finish (or after the race closes).
race_shown = (events: AirEvents, w: data.World) -> int:
    loop k in 0..events.meets.len():
        meet = events.meets[k]
        if meet.phase == .cancelled and w.tick < meet.race_tick + 600:
            if player_air_entry(meet, w.player) != none: return k
        if meet.phase == .cancelled or meet.phase == .finished: continue
        if let e = player_air_entry(meet, w.player):
            if e.finished_tick >= 0 and w.tick - e.finished_tick > 900: continue
            if meet.phase == .display and w.tick - meet.display_tick > 900: continue
            return k
    -1

# one small card under the compass: the plain facts, a line or two
_race_card = (fonts: Fonts, lines: str[], warn: str = ""):
    set_font(fonts.ui)
    sw = f64(screen_width())
    size = 19.0
    w = 0.0
    loop l in lines: w = max(w, text_width(l, size))
    if warn != "": w = max(w, text_width(warn, size))
    if w + 36.0 > sw - 24.0:
        size = size * (sw - 60.0) / max(1.0, w); w = sw - 60.0
    rows = lines.len() + (if warn != "": 1 else: 0)
    x = (sw - w) * 0.5; y = 86.0
    rect_rounded(x - 18, y - 8, w + 36, f64(rows) * (size + 8.0) + 12.0, 8, rgba(0.08, 0.1, 0.14, 0.55))
    loop k in 0..lines.len(): text_centered(lines[k], vec2(f32(sw * 0.5), f32(y + f64(k) * (size + 8.0) + size * 0.5)), size, rgba(1, 0.97, 0.9, 1))
    if warn != "": text_centered(warn, vec2(f32(sw * 0.5), f32(y + f64(lines.len()) * (size + 8.0) + size * 0.5)), size, rgba(1, 0.72, 0.48, 1))
    set_font()

_big_word = (fonts: Fonts, s: str, alpha: f64):
    if alpha <= 0.0: return
    cx = f64(screen_width()) * 0.5; cy = f64(screen_height()) * 0.32
    set_font(fonts.title)
    text_centered(s, vec2(f32(cx + 3), f32(cy + 4)), 96, rgba(0.05, 0.08, 0.15, f32(alpha * 0.35)))
    text_centered(s, vec2(f32(cx), f32(cy)), 96, rgba(1, 0.97, 0.9, f32(alpha)))
    set_font()

# The next gate: brackets between its two pylons, or a chevron at the screen's edge.
draw_race_gate = (fonts: Fonts, gate: AirGate, label: str):
    eye = scene_camera()
    p = render_warped(gate.center, eye, scene_warp_a, scene_warp_b)
    clip = scene_view_proj() * vec4(p, 1)
    sw = f64(screen_width()); sh = f64(screen_height())
    c = vec2(sw * 0.5, sh * 0.5)
    d = vec2(clip.x, -clip.y) / max(abs(clip.w), 0.001) * vec2(sw * 0.5, sh * 0.5)
    edge = clip.w <= 0 or abs(d.x) > sw * 0.5 - 55 or abs(d.y) > sh * 0.5 - 100
    if clip.w <= 0: d = -d
    if edge:
        if length(d) < 0.001: d = vec2(0, 1)
        d *= f32(min((sw * 0.5 - 55) / max(0.001, abs(f64(d.x))), (sh * 0.5 - 100) / max(0.001, abs(f64(d.y)))))
    at = c + d; color = rgba(1.0, 0.86, 0.42, 0.92)
    # half the gate's width on screen, kept between a small mark and a third of the screen
    span = clamp(gate.width * f64(sh * 0.5) / max(1.0, f64(clip.w)) * 1.2, 12.0, sw * 0.3)
    if edge:
        along = normalize(d); side = vec2(-along.y, along.x)
        loop k in 0..2:
            tip = at - along * f32(f64(k) * 8.0)
            line(tip, tip - along * 10 + side * 6, 2.0, color); line(tip, tip - along * 10 - side * 6, 2.0, color)
    else:
        loop sign in [-1.0, 1.0]:
            x = at + vec2(f32(sign * span), 0)
            line(x + vec2(0, -10), x + vec2(0, 10), 1.6, color)
            line(x + vec2(0, -10), x + vec2(f32(-sign * 5), -10), 1.6, color)
            line(x + vec2(0, 10), x + vec2(f32(-sign * 5), 10), 1.6, color)
    set_font(fonts.ui)
    tw = text_width(label, 14)
    x = clamp(f64(at.x), tw * 0.5 + 8, sw - tw * 0.5 - 8)
    text_centered(label, vec2(f32(x + 1), f32(f64(at.y) + 23)), 14, rgba(0.03, 0.04, 0.05, 0.9))
    text_centered(label, vec2(f32(x), f32(f64(at.y) + 22)), 14, color)
    set_font()

_finish_card = (fonts: Fonts, title: str, lines: str[], alpha: f64):
    if alpha <= 0.0: return
    sw = f64(screen_width()); sh = f64(screen_height())
    set_font(fonts.title)
    tsize = min(40.0, 40.0 * (sw - 80.0) / max(1.0, text_width(title, 40)))
    w = max(text_width(title, tsize), 0.0)
    set_font(fonts.ui)
    loop l in lines: w = max(w, text_width(l, 22))
    w = min(w, sw - 60.0)
    h = tsize + 28.0 + f64(lines.len()) * 30.0
    x = (sw - w) * 0.5 - 28; y = sh * 0.26
    rect_rounded(x, y, w + 56, h, 10, rgba(0.08, 0.1, 0.14, f32(0.62 * alpha)))
    set_font(fonts.title)
    text_centered(title, vec2(f32(sw * 0.5), f32(y + 12 + tsize * 0.5)), tsize, rgba(1, 0.97, 0.9, f32(alpha)))
    set_font(fonts.ui)
    loop k in 0..lines.len(): text_centered(lines[k], vec2(f32(sw * 0.5), f32(y + tsize + 30 + f64(k) * 30.0)), 22, rgba(1, 0.97, 0.9, f32(alpha)))
    set_font()

# Everything the entered player sees during the meet, drawn over the scene while aboard.
draw_race_hud = (fonts: Fonts, events: AirEvents, w: data.World, k: int, position: vec3, show_gate: bool = true):
    meet = events.meets[k]; place = _meet_place(w, meet.capital, meet.name)
    e0 = player_air_entry(meet, w.player)
    if e0 == none: return
    e = e0!
    tick = w.tick
    if meet.phase == .cancelled:
        _race_card(fonts, ["Air race at {place}"], "Called off: {meet.cancellation.lower()}")
        return
    standings = air_standings(meet)
    rank = 1
    loop j in 0..standings.len(): if standings[j].craft == e.craft: rank = j + 1
    if e.finished_tick >= 0:
        a = 1.0 - smoothstep(720.0, 900.0, f64(tick - e.finished_tick))
        _finish_card(fonts, "Air race at {place}", ["Finished {_ordinal(rank)} of {meet.entries.len()}", "Time {_race_clock(e.finished_tick - e.started_tick)}"], a)
        return
    if e.disqualified:
        since = if meet.phase == .display: tick - meet.display_tick else: 0
        _finish_card(fonts, "Air race at {place}", ["Did not finish"], 1.0 - smoothstep(720.0, 900.0, f64(since)))
        return
    if meet.phase == .registration:
        left = meet.race_tick - tick
        if left > 4 * 60:
            _race_card(fonts, ["Air race at {place}", "Start in {_race_clock(left)[0..(_race_clock(left).len() - 2)]}"], "")
        else:
            _race_card(fonts, ["Air race at {place}", "Fly through the first gate after the start"], "")
            n = (left + 59) / 60
            if n >= 1 and n <= 3: _big_word(fonts, "{n}", 1.0)
        if show_gate: draw_race_gate(fonts, meet.gates[0], "Start  {length(meet.gates[0].center - position) / 1000.0:.1} km")
        return
    gate = meet.gates[e.gate]
    dist = "{length(gate.center - position) / 1000.0:.1} km"
    if e.started_tick < 0:
        since = tick - meet.race_tick
        if since < 90: _big_word(fonts, "Go", 1.0 - smoothstep(45.0, 90.0, f64(since)))
        _race_card(fonts, ["Air race at {place}", "Fly through the first gate to start"], "")
        if show_gate: draw_race_gate(fonts, gate, "Start  {dist}")
        return
    lap = min(meet.laps, e.laps + 1)
    final_gate = e.gate == 0
    lines = ["Lap {lap} of {meet.laps}     Gate {if final_gate: meet.gates.len() else: e.gate} of {meet.gates.len()}     {_ordinal(rank)} of {meet.entries.len()}",
        _race_clock(tick - e.started_tick)]
    warn = if e.missed: "Missed the gate: turn back through it" else: ""
    _race_card(fonts, lines, warn)
    if show_gate:
        name = if final_gate: (if e.laps + 1 >= meet.laps: "Finish" else: "Lap gate") else: "Gate {e.gate}"
        draw_race_gate(fonts, gate, "{name}  {dist}")
