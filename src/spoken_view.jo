# People's words arriving in a panel as they are spoken (src/speech_stream.jo has the pace and the
# frame's step). A panel names its line with a key, gives the whole text each frame, and is told
# how much of it to draw and whether the line is whole; a new text under the same key starts
# afresh. While a line is still arriving, Space, Enter, a controller's A, or a click or tap on the
# panel finishes it at once, and that press does nothing else.
use 'speech_stream.jo'
use 'options.jo'
use 'touch.jo'

_spoken: {str: SpokenEntry}
# Captures only: every line whole at once, whatever the text speed (a time-lapse draws one frame in
# so many, and a line not drawn for a few frames begins again: its words would never arrive).
spoken_whole = false

# Forget a panel's line, so the same words said again arrive again (a conversation begun anew).
spoken_forget = (key: str):
    global _spoken
    if key in _spoken: _spoken.remove(key)

# The panels are not being drawn but are still open (the pause menu over them): their lines keep
# their place, and arrive no further.
spoken_keep = ():
    global _spoken
    f = frame_number()
    loop key in _spoken.keys():
        e = _spoken[key]
        if f <= e.frame + SPOKEN_FORGET_FRAMES:
            e.frame = f
            _spoken[key] = e

# The line `text` under `key`, stepped once a frame: `rate` characters a second (spoken_rate; 0:
# read, not said), `lead` seconds before its first character (the pilot's own words come first),
# `pressed` a click or tap on the panel this frame.
spoken_line = (key: str, text: str, rate: f64 = SPOKEN_RATE, lead: f64 = 0.0, pressed: bool = false) -> Said: _spoken_frame(key, text, rate, lead, pressed, true)

# A line that only arrives (a word over the wireless, a keeper's remark under the bill of fare):
# nothing waits on it, so no press finishes it and Space stays what it was.
spoken_heard = (key: str, text: str, rate: f64 = SPOKEN_RATE) -> Said: _spoken_frame(key, text, rate, 0.0, false, false)

_spoken_frame = (key: str, text: str, rate: f64, lead: f64, pressed: bool, skips: bool) -> Said:
    global _spoken
    e = _spoken.get(key, SpokenEntry(SpokenLine()))
    was_done = e.line.done and e.line.text == text
    press = skips and (pressed or key_pressed(.space) or mkey(.enter))
    said = spoken_entry_step(e, text, frame_number(), min(frame_time(), 0.1), rate, lead, if spoken_whole: TextSpeed.instant else: options.text_speed, press)
    _spoken[key] = e
    # (still arriving, or finished by this frame's press: Space is the line's, src/touch.jo)
    if skips and not was_done and not said.ready: hold_space()
    said

# How the line `text` under `key` stands, without stepping it (the same words drawn elsewhere: a
# bubble over the speaker). One not yet begun has nothing arrived.
spoken_peek = (key: str, text: str) -> Said:
    if spoken_whole or options.text_speed == .instant or text == "": return Said()
    if not (key in _spoken) or _spoken[key].line.text != text: return Said(0, false, false, 0.0)
    spoken_said(_spoken[key], frame_number())
