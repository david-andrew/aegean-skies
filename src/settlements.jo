use 'water_field.jo'
use 'canal_geometry.jo'
use 'lake_ports.jo'
# Deterministic places, independent of rendering and living-world save state.
# IDs 0..5 are reserved for the original harbors. Generated IDs derive from
# geography and candidate coordinates, never a list length or the camera.
use 'world.jo'
use 'geography.jo'
use 'world_source.jo'
use 'settlement_ports.jo'
use 'town_region.jo'

enum SettlementKind: capital, port, market, fishing, hill, monastery, hamlet, farm, lighthouse, chapel

struct MooringPlace:
    at: vec3
    quay_a: vec2
    quay_b: vec2
    width: f64
    buoy: vec3
    deck: f64 = 1.2

struct WorldSettlement:
    id: int
    name: str
    kind: SettlementKind
    size: int                       # target buildings; unsuitable parcels stay empty
    country: int                    # 0 archipelago, 1 Kalyra, 2 Orenthia
    region: int                     # geography region, negative for original islands
    center: vec3                    # square / inland end of harbor
    out: vec2
    radius: f64
    seed: int
    harbor: MooringPlace[]
    neighbors: int[]                # settlement IDs, never array indices
    roads: int[]                    # indices in settlement_roads
    legacy: int = -1
    remote_harbor = false            # landing belongs to this town, outside its house layout
    old: vec2                       # old-quarter hill in local tangent/inland coordinates

struct SettlementRoad:
    a: int
    b: int
    points: vec3[]                  # compact canonical bends; empty until evaluated (or rejected)
    width: f64
    ready: bool = false
    bounds: vec4                    # conservative candidate corridor x/z bounds

struct PlaceLandmark:
    kind: str
    at: vec3

world_settlements: WorldSettlement[]
settlement_roads: SettlementRoad[]
settlement_by_id: {int: int} = {}
settlement_bins: {int: int[]} = {}
settlement_registry_ready = true
settlement_island_cursor = 0
settlement_generation = 0
const SETTLEMENT_VERSION = 4
const PLACE_SPACING = 20.0
SETTLEMENT_COUNTRIES = ["Archipelago", "Kalyra", "Orenthia"]

place_hash = (a: int,b: int) -> int:
    h = u64(a)*u64(0x9E3779B97F4A7C15)+u64(b)*u64(0xBF58476D1CE4E5B9)
    h = (h xor (h >> 31))*u64(0x94D049BB133111EB)
    int((h xor (h >> 29)) & u64(0x7FFFFFFF))

place_name = (seed: int) -> str:
    first = ["Alev", "Kaly", "Orenth", "Vely", "Thalv", "Istr", "Melav", "Nerav", "Petrav", "Dely", "Sary", "Olyth", "Kery", "Lyrav", "Ardev", "Phery", "Tery", "Vathr", "Zery", "Myrev"]
    last = ["ara", "enos", "aki", "essa", "onia", "yra", "atha", "eli", "ona", "issa", "avos", "enia", "ythos", "andra", "oria", "asia", "eia", "anti", "ouna", "erio"]
    middle = ["", "", "", "an", "er", "av", "in", "al", "on", "ath", "il", "ar"]
    first[seed%first.len()]+middle[(seed/400)%middle.len()]+last[(seed/first.len())%last.len()]

place_ground = (p: vec2) -> f64:
    if abs(p.x) < LEGACY_RESERVE and abs(p.y) < LEGACY_RESERVE: return surface_height(f64(p.x),f64(p.y))
    world_source_surface(f64(p.x),f64(p.y))
place_base = (p: vec2) -> f64: new_land_base(f64(p.x),f64(p.y)).0
place_point = (p: vec2) -> vec3: vec3(p.x,f32(place_ground(p)),p.y)
place_flat = (p: vec2,span: f64,limit: f64) -> bool:
    h = place_base(p)
    if h < 2.0 or h > 900.0: return false
    loop d in [vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1)]:
        q = place_base(p+d*f32(span))
        if q < 1.5 or abs(q-h) > span*limit: return false
    true

# A land-to-sea bracket yields a real shore, not an outline approximation.
place_coast = (land: vec2,sea: vec2) -> (vec2,vec2,bool):
    if place_base(land) < 2.0 or place_base(sea) > -2.0: return (land,vec2(0,1),false)
    a = land; b = sea
    loop k in 0..14:
        p = (a+b)*0.5
        if place_base(p) > 0.0: a = p
        else: b = p
    out = normalize(sea-land)
    p = (a+b)*0.5
    # Source/canonical coast can differ slightly; keep the quay's root dry.
    root = p-out*36.0
    if not place_flat(root,18.0,0.38) or place_ground(root) > 24.0: return (p,out,false)
    if not place_flat(p-out*70.0,24.0,0.30) or place_ground(p-out*70.0) > 36.0: return (p,out,false)
    if place_ground(p+out*65.0) > -2.0: return (p,out,false)
    (p,out,true)

place_shelter = (p: vec2,out: vec2) -> f64:
    tangent = vec2(-out.y,out.x)
    sheltered = 0.0
    loop side in [-1.0,1.0]:
        loop distance in [500.0,1100.0,2000.0]:
            if place_base(p+tangent*f32(side*distance)+out*f32(distance*0.3)) > 0.0: sheltered += 1.0
    sheltered

place_add = (id: int,kind: SettlementKind,region_id: int,p: vec2,out: vec2,coastal: bool,size: int,radius: f64):
    global world_settlements,settlement_by_id
    seed = place_hash(GEOGRAPHY_SEED,id)
    country = if region_id == 3 or region_id == 5 or region_id == 6 or region_id == 8 or p.x > 95000.0: 2 else: 1
    center = if coastal: p-out*70.0 else: p
    docks: MooringPlace[]
    if coastal:
        tangent = vec2(-out.y,out.x)
        reach = if kind == .capital: 240.0 else: (if kind == .port: 110.0 else: 55.0)
        qa = p-out*40.0; qb = p+out*f32(reach)
        loop side in [-1.0,1.0]:
            at = p+out*f32(reach-20.0)+tangent*f32(side*14.0)
            if place_ground(at) < -2.0:
                docks.push(MooringPlace(vec3(at.x,0,at.y),qa,qb,if kind == .capital: 12.0 else: 7.0,vec3(at.x+out.x*38.0,0,at.y+out.y*38.0),deck=2.4))
        if docks.len() == 0: return
    name = if kind == .capital: (if region_id == 1: "Kalyrassa" else: "Orenthessa") else: place_name(seed)
    # Names remain deterministic and unique, with a geographic qualifier on collisions.
    loop attempt in 0..32:
        duplicate = false
        loop other in world_settlements:
            if other.name == name: duplicate = true; break
        if not duplicate: break
        name = place_name(place_hash(seed,attempt+id))
    settlement_by_id[id] = world_settlements.len()
    old = vec2(0,20)
    if size >= 100:
        # Choose an inhabited shoulder, not a summit or a flat artificial apron.
        tangent = vec2(-out.y,out.x)
        best = -1e9
        loop k in 0..18:
            angle = f64(k)*TAU/18.0
            q = vec2(f32(cos(angle)*radius*0.42),f32(radius*0.40+sin(angle)*radius*0.20))
            at = center+tangent*q.x-out*q.y
            if not place_flat(at,22.0,0.30): continue
            score = place_base(at)-f64(length(q))*0.015
            if score > best: best = score; old = q
    world_settlements.push(WorldSettlement(id,name,kind,size,country,region_id,place_point(center),out,radius,seed,docks,old=old))

place_spaced = (p: vec2,distance: f64) -> bool:
    loop s in world_settlements:
        if length(s.center.xz-p) < f32(distance+s.radius): return false
    true

# Parcel identities are (place ID, i, j). Negative j rows follow old-town
# contour-like lanes; nonnegative rows are the later courtyard quarters. Both
# LODs and collision consume this same pure lot generator.
struct PlaceParcel:
    at: vec3
    yaw: f64
    width: f64
    depth: f64
    height: f64
    seed: int
    floors: int = 1
    country: int = 0
    rural: int = 0

struct PlaceLot:
    local: vec2
    yaw: f64
    width: f64
    depth: f64
    floors: int
    seed: int

place_columns = (s: WorldSettlement) -> int: if s.kind == .capital: 64 else: (if s.size >= 100: 24 else: 16)
place_old_radius = (s: WorldSettlement) -> f64: if s.size >= 100: s.radius*0.43 else: min(s.radius*0.75,46.0)
place_to_world = (s: WorldSettlement,q: vec2) -> vec2: s.center.xz+vec2(-s.out.y,s.out.x)*q.x-s.out*q.y
place_to_local = (s: WorldSettlement,p: vec2) -> vec2: vec2(dot(p-s.center.xz,vec2(-s.out.y,s.out.x)),-dot(p-s.center.xz,s.out))
place_ring = (s: WorldSettlement,r: f64,angle: f64) -> vec2:
    bend = if s.size >= 100: r*(0.19*sin(angle*3.0+0.4)+0.12*cos(angle*2.0))+6.0*cos(angle*5.0) else: 2.0*sin(angle*3.0)
    drift = if s.size >= 100: vec2(f32(r*0.07*sin(r/180.0)),f32(r*0.06*cos(r/160.0))) else: vec2(0,0)
    s.old+drift+vec2(f32(cos(angle)*(r+bend)),f32(sin(angle)*(r+bend)*0.82))

# Inverse of the smooth lane deformation, used by contact and vegetation. It
# avoids scanning a city's complete parcel list for each walking/tree query.
place_ring_coordinates = (s: WorldSettlement,q: vec2) -> vec2:
    delta = q-s.old
    radius = f64(length(vec2(delta.x,delta.y/0.82)))
    angle = atan2(f64(delta.y)/0.82,f64(delta.x))
    if radius < 1.0: return vec2(0,0)
    loop iteration in 0..5:
        at = place_ring(s,radius,angle)
        dr = place_ring(s,radius+1.0,angle)-at
        da = (place_ring(s,radius,angle+0.002)-at)/0.002
        error = q-at
        det = f64(dr.x*da.y-dr.y*da.x)
        if abs(det) < 0.01: break
        radius = max(0.1,radius+clamp(f64(error.x*da.y-error.y*da.x)/det,-100.0,100.0))
        angle += clamp(f64(dr.x*error.y-dr.y*error.x)/det,-0.4,0.4)
    vec2(f32(radius),f32(angle))

place_inside = (s: WorldSettlement,q: vec2) -> bool:
    angle = atan2(f64(q.y),f64(q.x))
    edge = s.radius*(0.90+0.08*sin(angle*5.0+f64(s.seed%11))+0.04*cos(angle*9.0))
    f64(length(q)) <= edge

place_reserved = (s: WorldSettlement,q: vec2) -> bool:
    if s.legacy<0 and s.harbor.len()>0 and not s.remote_harbor and q.y>-48.0 and q.y<32.0 and abs(q.x)<f32(port_span(s)+20.0): return true
    if s.kind == .capital and q.y > -45.0 and q.y < 45.0 and q.x > -65.0 and q.x < 230.0: return true
    if s.kind == .monastery and abs(q.x) < 48.0 and q.y > 10.0 and q.y < 65.0: return true
    if s.size >= 100:
        if length(q-s.old) < 28.0: return true
        u = dot(q,s.old)/max(dot(s.old,s.old),1.0)
        if u > 0.0 and u < 1.0 and length(q-s.old*u) < 13.0: return true
    false

place_lot = (s: WorldSettlement,i: int,j: int) -> PlaceLot?:
    if s.id==CANAL_CITY_ID:return none
    if s.legacy >= 0: return none
    seed = place_hash(s.seed,place_hash(i+4096,j+4096))
    yaw = 0.0; q = vec2(0,0); w = 12.0; d = 12.0; floors = 1
    if s.size == 1:
        if i != 1 or j != 1: return none
        q = vec2(20,20)
    else if j < 0:
        ring = -j; radius = f64(ring)*15.0
        if radius > place_old_radius(s): return none
        columns = place_columns(s)*2+1
        step = max(1,int(ceil(13.0*f64(columns)/(TAU*radius))))
        column = i+place_columns(s)
        if column < 0 or column >= columns or column%step != 0: return none
        # Evenly close the ring; the short final gap must not overlap the first.
        count = columns/step
        if column/step >= count: return none
        angle = TAU*f64(column/step)/f64(count)+f64(ring)*0.071+f64(s.seed%23)*0.11
        q = place_ring(s,radius,angle)
        if s.size >= 100:
            if seed%11 == 0: return none
            if ring%5 == 0 and sin(angle*2.0+f64(ring)) > -0.35: return none
            spoke = atan2(-f64(s.old.y)/0.82,-f64(s.old.x))
            if abs(sin((angle-spoke)*2.0))*radius < 5.0: return none
        derivative = (place_ring(s,radius,angle+0.015)-place_ring(s,radius,angle-0.015))/0.03
        dir = normalize(derivative)
        yaw = atan2(f64(dir.y),f64(dir.x))
        w = min(18.0,TAU*f64(length(derivative))/f64(count)*0.78)
        if w < 7.0: return none
        radial = place_ring(s,radius+15.0,angle)-q
        pitch = abs(f64(dir.x*radial.y-dir.y*radial.x))
        d = min(8.0+f64(seed%4),pitch*0.68)
        if d < 7.0: return none
        floors = if s.size >= 100: 1+seed%3 else: 1+seed%2
    else:
        if s.size < 100 or i%7 == 0 or j%7 == 0: return none
        bx = int(floor(f64(i)/7.0)); bz = j/7
        x = i-bx*7; z = j-bz*7
        # Courtyards and occasional whole-block gardens break the roof carpet.
        if (x == 3 or x == 4) and (z == 3 or z == 4): return none
        block = place_hash(s.seed,place_hash(bx+512,bz+512))
        if block%13 == 0: return none
        yaw = (f64(block%11)-5.0)*0.025
        dx = (f64(x)-3.5)*22.0; dz = (f64(z)-3.5)*22.0
        q = vec2(f32((f64(bx)*7.0+3.5)*22.0+dx*cos(yaw)-dz*sin(yaw)),f32((f64(bz)*7.0+3.5)*22.0+dx*sin(yaw)+dz*cos(yaw)))
        if place_ring_coordinates(s,q).x < f32(place_old_radius(s)+12.0): return none
        edge = f64(length(q))/s.radius
        density = if edge < 0.62: 0.96 else: max(0.16,1.0-(edge-0.62)*2.2)
        if f64(seed%1000)/1000.0 > density: return none
        w = 12.0+f64(seed%7); d = 10.0+f64((seed/7)%5)
        floors = if q.y < 160.0: 3+seed%2 else: (if edge < 0.65: 2+seed%2 else: 1+seed%2)
    if not place_inside(s,q) or place_reserved(s,q): return none
    if s.harbor.len() > 0 and not s.remote_harbor and q.y < -45.0: return none
    if s.size > 1 and length(q) < 23.0: return none
    PlaceLot(q,yaw,w,d,floors,seed)

place_ground_lot = (s: WorldSettlement,lot: PlaceLot,canonical: bool = true) -> PlaceParcel?:
    p = place_to_world(s,lot.local)
    h = if canonical: place_ground(p) else: place_base(p)
    water=water_at(f64(p.x),f64(p.y))
    if water.wet:return none
    if h < 2.0 or h > (if s.kind == .monastery: 1200.0 else: 850.0): return none
    yaw = atan2(f64(s.out.x),f64(s.out.y))-lot.yaw
    right = vec2(f32(cos(yaw)),f32(-sin(yaw))); forward = vec2(f32(sin(yaw)),f32(cos(yaw)))
    lo = h; hi = h; width = lot.width; depth = lot.depth
    if canonical:
        # A steep lane gets a smaller house, not a flattened slope or a tall
        # artificial foundation. Contact and rendering share the accepted fit.
        accepted = false
        loop attempt in 0..3:
            scale = 1.0-f64(attempt)*0.18
            width = min(lot.width,max(7.0,lot.width*scale))
            depth = min(lot.depth,max(6.0,lot.depth*scale))
            lo = h; hi = h
            loop x in [-1.0,1.0]:
                loop z in [-1.0,1.0]:
                    hh = place_ground(p+right*f32(x*width*0.5)+forward*f32(z*depth*0.5))
                    lo = min(lo,hh); hi = max(hi,hh)
            if lo >= 1.2 and hi-lo <= 5.0: accepted = true; break
            if s.size == 1: break
        if not accepted: return none
    PlaceParcel(vec3(p.x,f32(lo),p.y),yaw,width,depth,f64(lot.floors)*town_floor_height(s.country)+1.0+hi-lo,lot.seed,lot.floors,s.country,if s.kind==.farm: 2 else: if s.kind==.hamlet or s.kind==.hill: 1 else: 0)

place_parcel = (s: WorldSettlement,i: int,j: int) -> PlaceParcel?:
    if let lot = place_lot(s,i,j): return place_ground_lot(s,lot)
    none

place_lots = (s: WorldSettlement) -> PlaceLot[]:
    lots: PlaceLot[]
    n = place_columns(s)
    loop j in -int(ceil(place_old_radius(s)/15.0))..int(ceil(s.radius/22.0))+1:
        loop i in -n..n+1:
            if let lot = place_lot(s,i,j): lots.push(lot)
    lots

# Shared by scenery and the venue/map catalog: an absent cafe is not advertised.
# Kind numbers refer to the shared street-furniture catalog, not living cargo.
struct SquareProp:
    kind: int
    local: vec2
    yaw: f64 = 0.0
    scale: f64 = 1.0

struct PlaceSquare:
    half_width: f64
    depth: f64
    paved: bool
    props: SquareProp[]

place_square = (s: WorldSettlement) -> PlaceSquare:
    seed = place_hash(s.seed,s.region+32)
    flip: f32 = if seed%2 == 0: 1.0 else: -1.0
    large = s.size >= 100
    width = if large: 15.0 else: (if s.size >= 20: 11.0 else: 8.0)
    depth = if large: 23.0 else: 15.0
    paved = large or s.kind == .monastery or s.kind == .port or s.kind == .hill or s.kind == .hamlet
    props: SquareProp[]
    if s.kind == .capital:
        props = [SquareProp(if seed%3 == 0: 9 else: 16,vec2(0,2)),SquareProp(10,vec2(-11,5),scale=1.05),SquareProp(10,vec2(11,5),scale=0.85),SquareProp(0,vec2(10,-7)),SquareProp(3,vec2(-10,-4),yaw=PI/2)]
    else if s.kind == .market:
        width = 14.0; depth = 21.0
        props = [SquareProp(1,vec2(-9,4)),SquareProp(1,vec2(0,7)),SquareProp(1,vec2(9,4)),SquareProp(3,vec2(-10,-5))]
        if seed%3 != 0: props.push(SquareProp(9,vec2(0,-4),scale=0.65))
        if s.size >= 30: props.push(SquareProp(0,vec2(10,-6),scale=0.85))
    else if s.kind == .monastery:
        width = 12.0; depth = 19.0
        props = [SquareProp(2,vec2(-7,5)),SquareProp(3,vec2(6,4),yaw=PI/2),SquareProp(4,vec2(5,7))]
        if seed%2 == 0: props.push(SquareProp(9,vec2(0,-3),scale=0.7))
        else: props.push(SquareProp(10,vec2(5,-4),scale=0.75))
    else if s.kind == .port or s.kind == .fishing:
        props = [SquareProp(5,vec2(-7,-4)),SquareProp(3,vec2(0,5)),SquareProp(0,vec2(7,3),scale=0.85)]
        if s.kind == .port or seed%3 == 0: props.push(SquareProp(10,vec2(-8,5),scale=0.8))
        else: props.push(SquareProp(14,vec2(-7,6),yaw=PI/2,scale=0.65))
    else if s.kind == .hill or s.kind == .hamlet:
        # A small shade court or a water point; no compulsory civic fountain/cafe.
        props = [SquareProp(if seed%3 == 0: 9 else: 10,vec2(-3,2),scale=if seed%3 == 0: 0.65 else: 0.8),SquareProp(3,vec2(3,1),yaw=PI/2)]
        if s.kind == .hill and seed%2 == 0: props.push(SquareProp(0,vec2(6,-5),scale=0.75))
    else if s.kind != .farm:
        width = 6.0; depth = 8.0
        props = [SquareProp(3,vec2(-4,0)),SquareProp(4,vec2(4,0))]
    loop k in 0..props.len():
        props[k].local.x *= flip
        props[k].yaw *= f64(flip)
        # Regional/seed variation changes spacing as well as the inventory.
        props[k].local.y += f32(seed%3-1)*0.65
    PlaceSquare(width+f64(seed%3-1),depth,paved,props)

place_landmarks = (s: WorldSettlement) -> PlaceLandmark[]:
    if s.legacy >= 0: return [] # original Town geometry remains authoritative
    p = s.center.xz; tangent = vec2(-s.out.y,s.out.x)
    result: PlaceLandmark[]
    if s.kind == .farm:
        if let parcel = place_parcel(s,1,1): result.push(PlaceLandmark("farmhouse",parcel.at))
        result.push(PlaceLandmark("olive terrace",place_point(p-s.out*18.0)))
        return result
    result.push(PlaceLandmark(if s.kind == .lighthouse: "lighthouse" else: "church",place_point(p-s.out*26.0)))
    if s.kind == .lighthouse or s.kind == .chapel: return result
    result.push(PlaceLandmark("square",s.center))
    loop prop in place_square(s).props:
        name = match prop.kind:
            0: "cafe"
            1: "market stall"
            2: "pergola"
            9: "fountain"
            10: "plane tree"
            16: "statue"
            _: ""
        if name != "":
            at = place_to_world(s,prop.local)
            if place_ground(at) >= 0.4: result.push(PlaceLandmark(name,place_point(at)))
    if s.kind == .monastery: result.push(PlaceLandmark("cloister",place_point(p-s.out*46.0)))
    if s.size >= 100: result.push(PlaceLandmark("hill church",place_point(place_to_world(s,s.old))))
    if s.kind == .capital:
        result.push(PlaceLandmark("customs",place_point(p+s.out*12.0-tangent*32.0)))
        loop k in 0..6:
            q = p+s.out*10.0+tangent*f32(k*36)
            if place_ground(q) > 1.0: result.push(PlaceLandmark("warehouse",place_point(q)))
    result

init_settlements = (roads: bool = false,defer_islands: bool = false):
    global settlement_generation
    settlement_generation+=1
    global world_settlements,settlement_roads,settlement_by_id,settlement_road_bins,settlement_registry_ready,settlement_island_cursor,port_cache
    port_cache=[]
    settlement_registry_ready = not geography_enabled; settlement_island_cursor = 0
    settlement_road_bins = {}
    world_settlements = []; settlement_roads = []; settlement_by_id = {}
    loop k in 0..SETTLEMENTS.len():
        old = SETTLEMENTS[k]; p,out = coast_point(old.island,old.bearing)
        n = vec2(-out.y,out.x)
        qlen = if old.kind == .port: 70.0 else: (if old.kind == .cove: 25.0 else: 45.0)
        docks: MooringPlace[]
        loop side in [-1.0,1.0]:
            at = p+out*f32(qlen-12.0)+n*f32(side*10.0)
            docks.push(MooringPlace(vec3(at.x,0,at.y),p-out*12.0,p+out*f32(qlen),if old.kind == .port: 8.0 else: 5.0,vec3(at.x+out.x*30.0,0,at.y+out.y*30.0)))
        if old.kind == .port:
            qc = p+n*80.0; at = qc+out*45.0+n*9.0
            docks.push(MooringPlace(vec3(at.x,0,at.y),qc-out*6.0,qc+out*55.0,6.0,vec3(at.x+out.x*30.0,0,at.y+out.y*30.0)))
        settlement_by_id[k] = world_settlements.len()
        world_settlements.push(WorldSettlement(k,old.name,if old.kind == .port: .port else: (if old.kind == .monastery: .monastery else: .fishing),old.size,0,-old.island-1,vec3(p.x,1.2,p.y),out,200.0,old.seed,docks,legacy=k))
    if not geography_enabled:
        index_settlement_bins()
        return
    # Sample both sides of authored shores, then refine against actual geography.
    loop region in LAND_REGIONS:
        candidates: vec2[]; directions: vec2[]; scores: f64[]
        loop edge in 0..region.outline.len():
            a = region.outline[edge]*1000.0; b = region.outline[(edge+1)%region.outline.len()]*1000.0
            steps = max(1,int(length(b-a)/4500.0))
            normal = normalize(vec2(-(b-a).y,(b-a).x))
            loop k in 0..steps:
                mid = mix(a,b,f32((f64(k)+0.5)/f64(steps)))
                if abs(mid.x) > 245000.0 or abs(mid.y) > 195000.0: continue
                p,out,ok = place_coast(mid-normal*2200.0,mid+normal*2200.0)
                if not ok: p,out,ok = place_coast(mid+normal*2200.0,mid-normal*2200.0)
                if not ok: continue
                candidates.push(p); directions.push(out)
                score = place_shelter(p,out)
                # A capital needs a broad low hinterland, not just a flat dock.
                loop depth in [200.0,500.0,900.0,1400.0]:
                    if place_flat(p-out*f32(depth),150.0,0.12): score += 2.0
                scores.push(score)
        best = -1; score = -1.0
        loop k in 0..scores.len():
            if scores[k] > score: score = scores[k]; best = k
        if best >= 0 and (region.id == 1 or region.id == 3):
            place_add(10000+region.id,.capital,region.id,candidates[best],directions[best],true,3200,1150.0)
        loop k in 0..candidates.len():
            p = candidates[k]
            if not place_spaced(p,9000.0): continue
            kind: SettlementKind = if scores[k] >= 7.0 and k%3 == 0: .port else: .fishing
            place_add(20000+region.id*1000+k,kind,region.id,p,directions[k],true,if kind == .port: 180 else: 28,if kind == .port: 270.0 else: 115.0)
        loop k in 0..candidates.len():
            if k%7 != 0 or place_shelter(candidates[k],directions[k]) > 1.0 or not place_spaced(candidates[k],2500.0): continue
            place_add(400000+region.id*1000+k,.lighthouse,region.id,candidates[k]-directions[k]*60.0,directions[k],false,1,40.0)
        # Jittered lowland lattice: no settlements on mountains or steep grades.
        loop j in int(region.bounds.y/10.0)..int(region.bounds.w/10.0)+1:
            loop i in int(region.bounds.x/10.0)..int(region.bounds.z/10.0)+1:
                seed = place_hash(i+300,j+300)
                p = vec2(f32(i)*10000.0+f32(seed%5000),f32(j)*10000.0+f32((seed/5000)%5000))
                if abs(p.x) > 245000.0 or abs(p.y) > 195000.0: continue
                if region_distance(region,f64(p.x),f64(p.y)) < 2000.0: continue
                if not place_flat(p,120.0,0.18) or not place_spaced(p,5500.0): continue
                h = place_ground(p)
                kind: SettlementKind = if seed%13 == 0 and h > 120.0: .monastery else: (if seed%19 == 0: .market else: (if seed%4 == 0: .farm else: (if h > 220.0: .hill else: .hamlet)))
                size = if kind == .market: 130 else: (if kind == .farm: 1 else: 20)
                radius = if kind == .market: 240.0 else: (if kind == .farm: 45.0 else: 100.0)
                place_add(100000+region.id*10000+(j+30)*64+i+30,kind,region.id,p,vec2(0,1),false,size,radius)
    init_canal_geometry()
    settlement_by_id[CANAL_CITY_ID]=world_settlements.len()
    dir=vec2(f32(sin(canal_heading)),f32(-cos(canal_heading)));side=vec2(-dir.y,dir.x)
    qa=canal_launch.xz+side*21.0-dir*12.0;qb=canal_launch.xz+side*21.0+dir*12.0
    harbor=[MooringPlace(canal_launch,qa,qb,3.0,canal_launch,deck=f64(canal_workshop.y))]
    world_settlements.push(WorldSettlement(CANAL_CITY_ID,CANAL_CITY_NAME,.port,80,1,1,canal_workshop,vec2(0,1),1100.0,CANAL_CITY_ID,harbor))
    attach_lake_landings()
    plan_settlement_roads()
    index_settlement_bins()
    if not defer_islands or roads: finish_settlement_registry()
    if roads: build_settlement_roads()

# Mainland places (including capitals) are immediately available. The game can
# append small-island records in authored order after its first frame. This same
# path serves eager/offline callers, preserving names, IDs and candidate indices.
append_island_settlements = (isl: SmallIsland):
    radius = f64(max(isl.radii.x,isl.radii.y))
    if radius < 380.0: return
    best = -1.0; chosen = isl.center; direction = vec2(0,1); found = false
    loop k in 0..32:
        a = f64(k)*TAU/32.0
        out = vec2(f32(cos(a)),f32(sin(a)))
        p,dir,ok = place_coast(isl.center,isl.center+out*f32(radius*1.9))
        if not ok: continue
        score = place_shelter(p,dir)
        if score > best: best = score; chosen = p; direction = dir; found = true
    if found:
        kind: SettlementKind = if radius > 3200.0: .port else: .fishing
        place_add(300000+isl.id*10,kind,isl.id,chosen,direction,true,if kind == .port: 100 else: 18,if kind == .port: 210.0 else: min(95.0,radius*0.2))
    # High islands receive an inland village or monastery on a shoulder.
    if radius > 1600.0 or not found:
        loop k in 0..200:
            r = rng(place_hash(isl.id,k))
            p = if k == 0: isl.center else: isl.center+vec2(f32(geo_random(r,-radius*0.65,radius*0.65)),f32(geo_random(r,-radius*0.5,radius*0.5)))
            if not place_flat(p,28.0,0.25) or not place_spaced(p,400.0): continue
            kind: SettlementKind = if not found and radius < 1200.0: .chapel else: (if isl.id%3 == 0: .monastery else: .hill)
            place_add(300001+isl.id*10,kind,isl.id,p,vec2(0,1),false,if kind == .chapel: 1 else: 16,if kind == .chapel: 40.0 else: 85.0)
            break

prepare_settlement_registry = () -> bool:
    global settlement_island_cursor,settlement_registry_ready
    if settlement_registry_ready: return false
    first = world_settlements.len()
    stop = min(small_islands.len(),settlement_island_cursor+4)
    loop k in settlement_island_cursor..stop: append_island_settlements(small_islands[k])
    settlement_island_cursor = stop
    attach_shore_landings(first)
    plan_settlement_roads(first)
    index_settlement_bins(first)
    settlement_registry_ready = stop == small_islands.len()
    true

finish_settlement_registry = ():
    loop not settlement_registry_ready: prepare_settlement_registry()

# Bounded A* in a corridor around a pair. Elevation change costs more than
# distance, so roads choose valleys and contours; sea and steep grades forbid
# an edge. A final finer canonical check rejects shortcuts across narrow coves.
place_route = (a: vec2,b: vec2) -> vec3[]:
    distance = f64(length(b-a))
    if distance < 100.0: return []
    step = distance/20.0
    forward = normalize(b-a); side = vec2(-forward.y,forward.x)
    points: vec2[]; heights: f64[]; cost: f64[]; parent: int[]; closed: bool[]
    loop j in 0..31:
        loop i in 0..31:
            p = a+forward*f32(f64(i-5)*step)+side*f32(f64(j-15)*step)
            points.push(p); heights.push(place_base(p)); cost.push(1e30); parent.push(-1); closed.push(false)
    start = 15*31+5; goal = 15*31+25
    cost[start] = 0.0
    reached = false
    loop iteration in 0..700:
        best = -1; score = 1e30
        loop k in 0..cost.len():
            if closed[k] or cost[k] >= 1e29: continue
            f = cost[k]+f64(length(points[k]-b))
            if f < score: score = f; best = k
        if best < 0: break
        if best == goal: reached = true; break
        closed[best] = true
        loop dz in -1..2:
            loop dx in -1..2:
                if dx == 0 and dz == 0: continue
                i = best%31+dx; j = best/31+dz
                if i < 0 or i >= 31 or j < 0 or j >= 31: continue
                k = j*31+i
                if closed[k] or heights[k] < 2.0 or heights[k] > 1100.0: continue
                len = f64(length(points[k]-points[best]))
                dh = abs(heights[k]-heights[best])
                if dh/len > 0.24: continue
                mid = place_base((points[k]+points[best])*0.5)
                if mid < 2.0 or abs(mid-(heights[k]+heights[best])*0.5) > len*0.12: continue
                next = cost[best]+len+dh*9.0
                if next < cost[k]: cost[k] = next; parent[k] = best
    if not reached: return []
    backwards: vec2[]; k = goal
    loop k != start:
        backwards.push(points[k]); k = parent[k]
        if k < 0: return []
    backwards.push(a)
    path: vec3[]
    loop n in 0..backwards.len()-1:
        p = backwards[backwards.len()-1-n]; q = backwards[backwards.len()-2-n]
        count = max(1,int(ceil(f64(length(q-p))/55.0)))
        loop j in 0..count:
            here = mix(p,q,f32(f64(j)/f64(count)))
            at = place_point(here)
            if at.y < 1.0: return []
            if path.len() > 0:
                last = path[path.len()-1]
                if abs(at.y-last.y) > length(at.xz-last.xz)*0.38: return []
            path.push(at)
    path.push(place_point(b))
    path

# Candidate identities depend only on place order, not camera or cache history.
# Adapters must check ready and points.len() before treating a link as traversable.
plan_settlement_roads = (first: int = 6):
    global settlement_roads,world_settlements
    loop i in max(6,first)..world_settlements.len():
        a = world_settlements[i]
        if a.id==CANAL_CITY_ID:continue
        nearest = -1; distance = 24000.0
        loop j in 6..i:
            b = world_settlements[j]
            if a.region != b.region: continue
            d = f64(length(a.center.xz-b.center.xz))
            if d < distance: nearest = j; distance = d
        if nearest < 0: continue
        b = world_settlements[nearest]
        width = if a.kind == .hill or a.kind == .monastery or b.kind == .hill or b.kind == .monastery: 1.8 else: 3.4
        # A* searches up to 3/4 of the chord sideways and 1/4 beyond each end.
        lo = min(a.center.xz,b.center.xz)-vec2(f32(distance),f32(distance))
        hi = max(a.center.xz,b.center.xz)+vec2(f32(distance),f32(distance))
        settlement_roads.push(SettlementRoad(a.id,b.id,[],width,false,vec4(lo.x,lo.y,hi.x,hi.y)))

# Keep a bend only when the horizontal direction changes. Full canonical samples
# still validate the entire route first; paving samples its exact terrain again.
compact_place_route = (path: vec3[]) -> vec3[]:
    if path.len() < 3: return path
    result = [path[0]]
    loop k in 1..path.len()-1:
        a = path[k].xz-result[result.len()-1].xz; b = path[k+1].xz-path[k].xz
        if abs(a.x*b.y-a.y*b.x) > max(length(a+b)*0.045,0.2): result.push(path[k])
    result.push(path[path.len()-1])
    result

ensure_settlement_road = (id: int):
    global settlement_roads,world_settlements
    if settlement_roads[id].ready: return
    road = settlement_roads[id]
    ai = settlement_by_id[road.a]; bi = settlement_by_id[road.b]
    path = place_route(world_settlements[ai].center.xz,world_settlements[bi].center.xz)
    settlement_roads[id].ready = true
    if path.len() < 2: return
    settlement_roads[id].points = compact_place_route(path)
    # Sorted reciprocal indices remain identical under arbitrary request order.
    loop pair in [(ai,road.b),(bi,road.a)]:
        world_settlements[pair.0].roads.push(id)
        world_settlements[pair.0].roads.sort()
        world_settlements[pair.0].neighbors = [loop rid in world_settlements[pair.0].roads: (if settlement_roads[rid].a == world_settlements[pair.0].id: settlement_roads[rid].b else: settlement_roads[rid].a)]
    index_settlement_road(id)

build_settlement_roads = ():
    finish_settlement_registry()
    loop id in 0..settlement_roads.len(): ensure_settlement_road(id)

# One bounded search per request. The chart can request the next unevaluated link;
# scene streaming only touches corridors near the camera, never the whole planet.
prepare_settlement_roads = (p: vec2,chart: bool = false) -> bool:
    loop id in 0..settlement_roads.len():
        road = settlement_roads[id]
        if road.ready: continue
        b = road.bounds
        if not chart and (p.x < b.x-1200.0 or p.y < b.y-1200.0 or p.x > b.z+1200.0 or p.y > b.w+1200.0): continue
        ensure_settlement_road(id)
        return true
    false

# Spatial lookup for ecology and contact. Includes enough apron for long moles.
index_settlement_bins = (first: int = 0):
    global settlement_bins
    if first == 0: settlement_bins = {}
    loop index in first..world_settlements.len():
        s = world_settlements[index]; r = s.radius+600.0
        if s.remote_harbor:r=max(r,f64(length(s.harbor[0].quay_a-s.center.xz))+700.0)
        loop z in int(floor((f64(s.center.z)-r)/16000.0))..int(floor((f64(s.center.z)+r)/16000.0))+1:
            loop x in int(floor((f64(s.center.x)-r)/16000.0))..int(floor((f64(s.center.x)+r)/16000.0))+1:
                key = (x+32)*128+z+32
                ids = settlement_bins.get(key,[]); ids.push(index); settlement_bins[key] = ids

place_candidate_cells = (s: WorldSettlement,local: vec2) -> (int,int)[]:
    candidates: (int,int)[]
    if s.size == 1: candidates.push((1,1))
    else:
        # A few adjacent old-town rings; recover the angle's stable column.
        coordinates = place_ring_coordinates(s,local)
        angle = f64(coordinates.y); radius = f64(coordinates.x)
        columns = place_columns(s)*2+1
        loop ring in max(1,int(radius/15.0)-2)..int(radius/15.0)+3:
            step = max(1,int(ceil(13.0*f64(columns)/(TAU*f64(ring)*15.0))))
            count = columns/step
            phase = angle-f64(ring)*0.071-f64(s.seed%23)*0.11
            col = int(round(phase/TAU*f64(count)))
            loop k in col-2..col+3:
                column_index = ((k%count)+count)%count
                candidates.push((column_index*step-place_columns(s),-ring))
        loop j in max(0,int(floor(f64(local.y)/22.0))-2)..int(ceil(f64(local.y)/22.0))+3:
            loop i in int(floor(f64(local.x)/22.0))-2..int(ceil(f64(local.x)/22.0))+3: candidates.push((i,j))
    candidates

settlement_urban = (p: vec2) -> bool:
    loop index in settlement_bins.get(geography_bin(f64(p.x),f64(p.y)),[]):
        s = world_settlements[index]
        if s.legacy >= 0: continue
        if length(p-s.center.xz) > f32(s.radius+35.0): continue
        q = place_to_local(s,p)
        if length(q) < 45.0 or (s.size >= 100 and length(q-s.old) < 40.0) or place_reserved(s,q): return true
        loop cell in place_candidate_cells(s,q):
            if let lot = place_lot(s,cell.0,cell.1):
                if length(lot.local-q) < 22.0: return true
    false

# New-world quays are walkable without adding fake harbors to the legacy sim.
# Callers that materialize a larger living world can use the same contact data.
settlement_quay_height = (p: vec2,h: f64) -> f64:
    port_quay_height(p,h)

settlement_avoid_buildings = (p: vec2) -> vec2:
    result = p
    loop index in settlement_bins.get(geography_bin(f64(p.x),f64(p.y)),[]):
        s = world_settlements[index]
        if s.legacy >= 0 or length(p-s.center.xz) > f32(s.radius+20.0): continue
        if s.harbor.len()>0 and length(p-s.center.xz)<f32(port_span(s)+120.0):
            loop b in settlement_port(s).buildings:
                side=vec2(-s.out.y,s.out.x); delta=result-b.at.xz
                dx=dot(delta,side); dz=dot(delta,s.out)
                wx=f32(b.width*0.5+0.4); wz=f32(b.depth*0.5+0.4)
                if abs(dx)<wx and abs(dz)<wz:
                    if wx-abs(dx)<wz-abs(dz): dx=if dx<0: -wx else: wx
                    else: dz=if dz<0: -wz else: wz
                    result=b.at.xz+side*dx+s.out*dz
        local = place_to_local(s,result)
        candidates = place_candidate_cells(s,local)
        loop cell in candidates:
            if let lot = place_lot(s,cell.0,cell.1):
                if length(place_to_world(s,lot.local)-result) > 20.0: continue
                if let parcel = place_ground_lot(s,lot):
                    right = vec2(f32(cos(parcel.yaw)),f32(-sin(parcel.yaw))); forward = vec2(f32(sin(parcel.yaw)),f32(cos(parcel.yaw)))
                    delta = result-parcel.at.xz
                    dx = dot(delta,right); dz = dot(delta,forward)
                    wx = f32(parcel.width*0.5+0.4); wz = f32(parcel.depth*0.5+0.4)
                    if abs(dx) < wx and abs(dz) < wz:
                        if wx-abs(dx) < wz-abs(dz): dx = if dx < 0.0: -wx else: wx
                        else: dz = if dz < 0.0: -wz else: wz
                        result = parcel.at.xz+right*dx+forward*dz
    result

struct PlaceStreet:
    a: vec2
    b: vec2
    width: f64
    paved: bool

# Streets are data, available without a GPU and in the same district coordinates
# as the renderer. People/routines can pick endpoints and sample canonical ground.
place_streets = (s: WorldSettlement,x: int,z: int) -> PlaceStreet[]:
    streets: PlaceStreet[]
    if s.legacy >= 0 or s.size <= 1: return streets
    lo = vec2(f32(x*160),f32(z*160)); hi = lo+vec2(160,160)
    paved = s.size >= 100 or s.kind == .monastery
    # Segment ownership/clipping is exact; adjacent districts never draw twice.
    emit = (a: vec2,b: vec2,width: f64):
        d = b-a; t0 = 0.0; t1 = 1.0
        loop axis in 0..2:
            av = if axis == 0: a.x else: a.y
            dv = if axis == 0: d.x else: d.y
            low = if axis == 0: lo.x else: lo.y
            high = if axis == 0: hi.x else: hi.y
            if abs(dv) < 0.0001:
                if av < low or av >= high: return
            else:
                u = f64((low-av)/dv); v = f64((high-av)/dv)
                t0 = max(t0,min(u,v)); t1 = min(t1,max(u,v))
        if t1 <= t0: return
        p = a+d*f32(t0); q = a+d*f32(t1)
        if not place_inside(s,(p+q)*0.5): return
        if s.harbor.len() > 0 and not s.remote_harbor and (p.y+q.y)*0.5 < -35.0: return
        streets.push(PlaceStreet(place_to_world(s,p),place_to_world(s,q),width,paved))
    if s.size >= 100:
        loop ring in 1..int(place_old_radius(s)/75.0)+1:
            loop k in 0..48:
                angle = (f64(k)+0.5)*TAU/48.0
                if sin(angle*2.0+f64(ring*5)) > -0.35: emit(place_ring(s,f64(ring)*75.0,f64(k)*TAU/48.0),place_ring(s,f64(ring)*75.0,f64(k+1)*TAU/48.0),5.0)
        angle = atan2(-f64(s.old.y)/0.82,-f64(s.old.x))
        loop spoke in 0..4:
            a = angle+f64(spoke)*TAU/4.0
            loop k in 0..int(place_old_radius(s)/15.0)+1: emit(place_ring(s,f64(k)*15.0,a),place_ring(s,f64(k+1)*15.0,a),4.0)
        n = int(ceil(s.radius/154.0))
        loop j in -n..n+1:
            loop k in 0..int(s.radius/22.0)+1:
                a = vec2(f32(j*154),f32(k*22)); b = a+vec2(0,22)
                if place_ring_coordinates(s,(a+b)*0.5).x > f32(place_old_radius(s)+14.0): emit(a,b,7.0)
        loop j in 0..n+1:
            loop k in -int(s.radius/22.0)..int(s.radius/22.0)+1:
                a = vec2(f32(k*22),f32(j*154)); b = a+vec2(22,0)
                if place_ring_coordinates(s,(a+b)*0.5).x > f32(place_old_radius(s)+14.0): emit(a,b,7.0)
        emit(vec2(0,0),s.old,5.0)
    else:
        loop k in 0..24: emit(place_ring(s,22.5,f64(k)*TAU/24.0),place_ring(s,22.5,f64(k+1)*TAU/24.0),2.8)
        emit(vec2(0,-25),s.old,3.0)
    streets

# Coarse bins store road IDs once, not a copy of every 55 m sample. Canonical
# geometry remains in the compact road; straight segments are tested exactly.
settlement_road_bins: {int: int[]} = {}
road_bin = (p: vec2) -> int: (int(floor(f64(p.x)/2048.0))+256)*512+int(floor(f64(p.y)/2048.0))+256

index_settlement_road = (id: int):
    global settlement_road_bins
    road = settlement_roads[id]
    loop k in 0..road.points.len()-1:
        a = road.points[k].xz; b = road.points[k+1].xz
        steps = max(1,int(ceil(f64(length(b-a))/512.0)))
        loop sample in 0..steps+1:
            p = mix(a,b,f32(f64(sample)/f64(steps)))
            lo = p-vec2(520,520); hi = p+vec2(520,520)
            loop z in int(floor(f64(lo.y)/2048.0))..int(floor(f64(hi.y)/2048.0))+1:
                loop x in int(floor(f64(lo.x)/2048.0))..int(floor(f64(hi.x)/2048.0))+1:
                    key = (x+256)*512+z+256
                    ids = settlement_road_bins.get(key,[])
                    if not (id in ids): ids.push(id); settlement_road_bins[key] = ids

index_settlement_roads = ():
    global settlement_road_bins
    settlement_road_bins = {}
    loop id in 0..settlement_roads.len(): index_settlement_road(id)

settlement_on_road = (p: vec2) -> bool:
    loop id in settlement_road_bins.get(road_bin(p),[]):
        road = settlement_roads[id]
        loop k in 0..road.points.len()-1:
            a = road.points[k].xz; b = road.points[k+1].xz; d = b-a
            u = clamp(dot(p-a,d)/max(dot(d,d),0.0001),0.0,1.0)
            if length(p-a-d*u) < 9.0: return true
    false
