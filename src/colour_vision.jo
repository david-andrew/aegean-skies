# How a colour looks to an eye that doesn't tell every hue apart, and how far apart two colours
# are to it: what the colour-blind presets (src/side_colours.jo) are checked with, in the tests
# and on captures of the game (tools/colour_vision_view.jo). Nothing here is drawn in play.
#
# The simulations are the standard ones: Machado, Oliveira and Fernandes (2009), "A
# Physiologically-based Model for Simulation of Color Vision Deficiency", at full severity
# (protanopia, deuteranopia, tritanopia), applied to linear light; and for no colour at all
# (achromatopsia), the light's luminance alone (Rec. 709's weights). Differences are CIE 1976
# ΔE in L*a*b* (D65): about 2 is just seen side by side, 10 is plain, and a mark wants 20 or more
# against whatever is behind it.

enum Deficiency: none, protan, deutan, tritan, achromat

DEFICIENCIES = [Deficiency.none, Deficiency.protan, Deficiency.deutan, Deficiency.tritan, Deficiency.achromat]

deficiency_name = (d: Deficiency) -> str:
    match d:
        .none: "normal"
        .protan: "protanopia"
        .deutan: "deuteranopia"
        .tritan: "tritanopia"
        .achromat: "achromatopsia"

_to_linear = (c: f64) -> f64: if c <= 0.04045: c / 12.92 else: pow((c + 0.055) / 1.055, 2.4)
_to_srgb = (c: f64) -> f64:
    x = clamp(c, 0.0, 1.0)
    if x <= 0.0031308: x * 12.92 else: 1.055 * pow(x, 1.0 / 2.4) - 0.055

# The colour as the eye with this deficiency sees it (sRGB in, sRGB out; alpha kept).
simulate_colour = (c: vec4, d: Deficiency) -> vec4:
    if d == .none: return c
    r = _to_linear(f64(c.x)); g = _to_linear(f64(c.y)); b = _to_linear(f64(c.z))
    x = r; y = g; z = b
    match d:
        .protan:
            x = 0.152286 * r + 1.052583 * g - 0.204868 * b
            y = 0.114503 * r + 0.786281 * g + 0.099216 * b
            z = -0.003882 * r - 0.048116 * g + 1.051998 * b
        .deutan:
            x = 0.367322 * r + 0.860646 * g - 0.227968 * b
            y = 0.280085 * r + 0.672501 * g + 0.047413 * b
            z = -0.011820 * r + 0.042940 * g + 0.968881 * b
        .tritan:
            x = 1.255528 * r - 0.076749 * g - 0.178779 * b
            y = -0.078411 * r + 0.930809 * g + 0.147602 * b
            z = 0.004733 * r + 0.691367 * g + 0.303900 * b
        _:
            x = 0.2126 * r + 0.7152 * g + 0.0722 * b
            y = x; z = x
    vec4(f32(_to_srgb(x)), f32(_to_srgb(y)), f32(_to_srgb(z)), c.w)

_lab_f = (t: f64) -> f64: if t > 0.008856: pow(t, 1.0 / 3.0) else: 7.787 * t + 16.0 / 116.0

# L*a*b* of an sRGB colour (D65).
colour_lab = (c: vec4) -> vec3:
    r = _to_linear(f64(c.x)); g = _to_linear(f64(c.y)); b = _to_linear(f64(c.z))
    x = (0.4124564 * r + 0.3575761 * g + 0.1804375 * b) / 0.95047
    y = 0.2126729 * r + 0.7151522 * g + 0.0721750 * b
    z = (0.0193339 * r + 0.1191920 * g + 0.9503041 * b) / 1.08883
    fx = _lab_f(x); fy = _lab_f(y); fz = _lab_f(z)
    vec3(f32(116.0 * fy - 16.0), f32(500.0 * (fx - fy)), f32(200.0 * (fy - fz)))

# How far apart two colours are (ΔE 1976), as seen.
colour_distance = (a: vec4, b: vec4) -> f64: f64(length(colour_lab(a) - colour_lab(b)))

# How far apart they are to an eye with this deficiency.
seen_distance = (a: vec4, b: vec4, d: Deficiency) -> f64:
    colour_distance(simulate_colour(a, d), simulate_colour(b, d))

# `over` laid on `under` at its alpha (as a mark is drawn on the view).
colour_over = (over: vec4, under: vec4) -> vec4:
    a = over.w
    vec4(over.x * a + under.x * (1.0 - a), over.y * a + under.y * (1.0 - a), over.z * a + under.z * (1.0 - a), 1.0)
