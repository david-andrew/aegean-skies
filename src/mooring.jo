use 'settlement_ports.jo'
use 'world_towns.jo'
use 'render_space.jo'
use 'geography.jo'
# Mooring: which docks are free, the bollards along a quay's edges, and the line from an aircraft
# to the bollard it is tied to (lit like everything else; left tied to the bollard and trailing in
# the water when the aircraft casts off).

use 'look.jo'
use 'objects.jo'
use 'sea.jo'

# whether any of the given aircraft positions sits at a dock (within the room an aircraft takes)
dock_taken = (dock: vec3, others: vec3[]) -> bool:
    loop p in others:
        if length(vec2(p.x - dock.x, p.z - dock.z)) < 13.0: return true
    false

# the nearest free dock of a town to a point, or none
free_dock = (tw: Town, others: vec3[], near: vec3) -> vec3?:
    best: vec3? = none
    bd = 1e18
    loop d in tw.docks:
        if dock_taken(d, others): continue
        l = f64(length(d - near))
        if l < bd:
            bd = l
            best = d
    best

# the bollard nearest a point on the water: bollards stand every 12 m along both edges of a quay
# (as add_quay places them), 0.5 m in from the edge
nearest_bollard = (towns: Town[], p: vec3) -> vec3?:
    best: vec3? = none
    bd = 45.0
    q2 = vec2(p.x, p.z)
    loop tw in towns:
        if length(vec2(tw.center.x, tw.center.z) - q2) > 600.0: continue
        loop q in tw.quays:
            d = q.b - q.a
            len = f64(length(d))
            if len < 3.0: continue
            dir = d / f32(len)
            nrm = vec2(-dir.y, dir.x)
            mid = (q.a + q.b) * 0.5
            k = 0.0
            loop k < len - 2.0:
                along = -len * 0.5 + 1.0 + k
                loop side in [-1.0, 1.0]:
                    b = mid + dir * f32(along) + nrm * f32(side * (f64(q.width) * 0.5 - 0.5))
                    l = f64(length(b - q2))
                    if l < bd:
                        bd = l
                        best = vec3(b.x, f32(QUAY_TOP + 0.55), b.y)
                k += 12.0
    best ?? port_bollard(p)

# ---------------- the line ----------------

struct Rope:
    anchor: vec3 = vec3(0, 0, 0)    # the bollard
    tied = false                    # tied to the bollard at all (else no rope)
    loose: vec3 = vec3(0, 0, 0)     # where the free end lies in the water, once cast off
    mesh: Mesh
    ready = false

# a tube along points, four-sided, for a rope (drawn lit)
_tube = (pts: vec3[], r: f64, col: vec4) -> Vertex3D[]:
    vs: Vertex3D[]
    loop k in 0..pts.len() - 1:
        a = pts[k]
        b = pts[k + 1]
        d = normalize(b - a + vec3(0, 0.0001, 0))
        s1 = normalize(cross(d, vec3(0, 1, 0)) + vec3(0.0001, 0, 0)) * f32(r)
        s2 = normalize(cross(d, s1)) * f32(r)
        sides = [s1, s2, -s1, -s2]
        loop i in 0..4:
            u = sides[i]
            w = sides[(i + 1) % 4]
            n = normalize(u + w)
            vs.push(Vertex3D(a + u, n, vec2(0, 0), col)); vs.push(Vertex3D(b + u, n, vec2(0, 0), col)); vs.push(Vertex3D(b + w, n, vec2(0, 0), col))
            vs.push(Vertex3D(a + u, n, vec2(0, 0), col)); vs.push(Vertex3D(b + w, n, vec2(0, 0), col)); vs.push(Vertex3D(a + w, n, vec2(0, 0), col))
    vs

# a sagging line from a to b (sag: how far its middle hangs below the straight line)
_sag = (a: vec3, b: vec3, sag: f64, n: int) -> vec3[]:
    [loop k in 0..n + 1: (a + (b - a) * f32(f64(k) / f64(n)) - vec3(0, f32(sin(f64(k) / f64(n) * PI) * sag), 0))]

# draw the line: from the float's bow to the bollard while moored; cast off, from the bollard
# down into the water, its end drifting on the swell
draw_rope = (r: mut Rope, moored: bool, bow: vec3, L: Light, t: f64):
    if not r.tied: return
    if not r.ready:
        r.mesh = custom_mesh(_tube([vec3(0, 0, 0), vec3(0, 0, 1)], 0.05, vec4(1, 1, 1, 1)))
        r.ready = true
    pts: vec3[]
    if moored: pts = _sag(bow, r.anchor, 0.5, 10)
    else:
        sw = swell_at(f64(r.loose.x), f64(r.loose.z), t)
        end = vec3(r.loose.x, sw.x - 0.05, r.loose.z)
        pts = _sag(r.anchor, end, 0.4, 8)
        # (and a few meters of it lying in the water beyond)
        loop k in 1..4:
            q = end + normalize(vec3(end.x - r.anchor.x, 0, end.z - r.anchor.z) + vec3(0.001, 0, 0)) * f32(f64(k) * 0.9)
            s2 = swell_at(f64(q.x), f64(q.z), t)
            pts.push(vec3(q.x, s2.x - 0.04, q.z))
    origin=render_origin(scene_camera())
    loop mut point in pts: point-=origin
    update_mesh(r.mesh, _tube(pts, 0.045, vec4(0.62, 0.5, 0.34, 1)))
    params=obj_params(L,t)
    params.model=mat4()
    if abs(r.anchor.x)<LEGACY_RESERVE and abs(r.anchor.z)<LEGACY_RESERVE: draw(obj_sh,r.mesh,params)
    else:
        origin=render_origin(scene_camera()); params.view_proj=render_view_proj(origin)
        draw(world_town_sh,r.mesh,TownParams(params,origin))
