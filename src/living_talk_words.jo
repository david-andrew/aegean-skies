# How people say numbers, times, loads, weather and who told them. Speech rounds and dates things
# the way a person would ("four phoinikes and some", "yesterday evening"); exact figures stay in the
# structured records, notebook and contract panels, never in casual talk.
use 'living_types.jo'
use 'life_types.jo'
use 'living_place_context.jo'

_ONES: str[] = ["no","one","two","three","four","five","six","seven","eight","nine","ten","eleven","twelve","thirteen","fourteen","fifteen","sixteen","seventeen","eighteen","nineteen"]
_TENS: str[] = ["","","twenty","thirty","forty","fifty","sixty","seventy","eighty","ninety"]
_WEEKDAYS: str[] = ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]

num_words = (n: int) -> str:
    if n < 0: return "{n}"
    if n < 20: return _ONES[n]
    if n < 100: return _TENS[n/10]+(if n%10 == 0: "" else: "-"+_ONES[n%10])
    if n < 1000:
        head = if n/100 == 1: "a hundred" else: _ONES[n/100]+" hundred"
        return if n%100 == 0: head else: head+" and "+num_words(n%100)
    if n%1000 == 0 and n < 20000: return num_words(n/1000)+" thousand"
    "{n}"

phoinix_words = (n: int) -> str: if n == 1: "a phoinix" else: "{num_words(n)} phoinikes"

# Rounded the way a person carries a price in their head: phoinikes, and small change in lepta
# to the nearest ten ("thirty lepta for a coffee").
say_money = (cents: int) -> str:
    if cents <= 0: return "nothing"
    if cents < 15: return "a few lepta"
    if cents < 95: return "{num_words((cents+5)/10*10)} lepta"
    if cents < 100: return "nearly a phoinix"
    whole = cents/100; rest = cents%100
    if whole < 20:
        if rest < 15: return phoinix_words(whole)
        if rest < 40: return if whole == 1: "a phoinix and some" else: "{num_words(whole)} phoinikes and some"
        if rest < 65: return if whole == 1: "a phoinix and a half" else: "{num_words(whole)} and a half phoinikes"
        if rest < 85: return "near enough {phoinix_words(whole+1)}"
        return "nearly {phoinix_words(whole+1)}"
    if whole < 100:
        r = (cents+50)/100
        return if rest == 0: phoinix_words(r) else: "about {phoinix_words(r)}"
    r5 = ((cents+250)/500)*5
    if cents%500 == 0: phoinix_words(r5) else: "about {phoinix_words(r5)}"

weekday_name = (minute: int) -> str: _WEEKDAYS[((day_index(minute)%7)+7)%7]

_hour_word = (hour: int) -> str:
    if hour%24 == 0: return "midnight"
    if hour == 12: return "noon"
    num_words(if hour > 12: hour-12 else: hour)

# A clock time as said aloud, to the nearest quarter hour: "noon", "half past ten", "four".
say_hour = (minute: int) -> str:
    m = ((local_minute(minute)+7)/15)*15
    h = (m/60)%24; q = m%60
    if q == 0: return _hour_word(h)
    if q == 15: return "quarter past {_hour_word(h)}"
    if q == 30: return "half past {_hour_word(h)}"
    "quarter to {_hour_word((h+1)%24)}"

# When something happened, relative to now and in parts of the day.
say_ago = (w: World, minute: int) -> str:
    if minute > w.minute: return say_by(w,minute)
    days = day_index(w.minute)-day_index(minute); h = local_minute(minute)/60
    if days == 0:
        if w.minute-minute < 60: return "not an hour ago"
        if w.minute-minute < 150: return "an hour or two ago"
        if h < 5: return "last night"
        if h < 12: return "this morning"
        if h < 18: return "this afternoon"
        return "this evening"
    if days == 1:
        if h < 5: return "the night before last"
        if h < 12: return "yesterday morning"
        if h < 18: return "yesterday afternoon"
        if h < 22: return "yesterday evening"
        return "last night"
    if days == 2: return "the day before yesterday"
    if days < 7: return "on {weekday_name(minute)}"
    if days < 14: return "last week"
    "a while back"

# A deadline or meeting ahead: "by noon", "by tomorrow evening", "by Thursday".
say_by = (w: World, minute: int) -> str:
    if minute <= w.minute: return "already"
    days = day_index(minute)-day_index(w.minute); h = local_minute(minute)/60
    if days == 0:
        if minute-w.minute < 90: return "within the hour"
        if h >= 18: return "by this evening"
        return "by {say_hour(minute)}"
    if days == 1:
        if h < 11: return "by tomorrow morning"
        if h < 14: return "by noon tomorrow"
        if h < 18: return "by tomorrow afternoon"
        return "by tomorrow evening"
    if days < 7: return "by {weekday_name(minute)}"
    "within the fortnight"

# Wind as people describe it. Knots stay with sailors and pilots, rounded.
say_wind = (knots: f64, from: str) -> str:
    if knots < 2.0: return "hardly a breath of wind"
    if knots < 7.0: return "a light air from the {from}"
    if knots < 12.0: return "a gentle {from}erly"
    if knots < 18.0: return "a fresh {from}erly"
    if knots < 25.0: return "a strong {from}erly"
    if knots < 34.0: return "a gale from the {from}"
    "a full gale from the {from}"

round_knots = (knots: f64) -> str:
    k = int(round(knots/5.0))*5
    if k < 5: "barely five knots" else: "{num_words(k)} knots or so"

good_name = (w: World, good: int) -> str:
    if good < 0 or good >= w.goods.len(): return "goods"
    key = w.goods[good].key
    if key == "parts": "engine parts" else: key

_unit = (good: int) -> str:
    if good == 1 or good == 2: "barrel" else: if good == 3: "sack" else: if good == 4: "tin" else: if good == 6: "box" else: "crate"

_units = (good: int) -> str: if good == 6: "boxes" else: _unit(good)+"s"

# A load the way a carrier would name it, never in fractional packages.
say_load = (w: World, good: int, amount: int) -> str:
    if good < 0: return "the sealed dispatch bag"
    name = good_name(w,good)
    if good == 1 and amount == 100: return "a bottle of wine"
    if amount < 400: return if good == 1: "a few bottles of wine" else: "a little {name}"
    if amount < 800: return "half a {_unit(good)} of {name}"
    n = (amount+500)/1000
    if n == 1: return "a {_unit(good)} of {name}"
    if n <= 12: return "{num_words(n)} {_units(good)} of {name}"
    if n < 20: return "a dozen or so {_units(good)} of {name}"
    if n < 100: return "{num_words((n/10)*10)}-odd {_units(good)} of {name}"
    "a great many {_units(good)} of {name}"

# The shorter form for a stock in hand: "a dozen sacks", "nearly none".
say_stock = (w: World, good: int, amount: int) -> str:
    if amount <= 0: return "none at all"
    if amount < 800: return "hardly any"
    say_load(w,good,amount)

short_name = (w: World, person: int) -> str:
    if person == w.player: return "the pilot"
    if person < 0 or person >= w.people.len(): return "someone"
    parts = split(w.people[person].name," ")
    if parts.len() > 1 and parts[0] == "Father": parts[0]+" "+parts[1] else: parts[0]

# What a neighbour would call someone's work, as a noun: "the mechanic", "the miller".
role_noun = (w: World, person: int) -> str:
    if person < 0 or person >= w.people.len(): return "someone"
    p = w.people[person]
    match p.occupation:
        .merchant: if p.far_home >= 0: "the shopkeeper" else: "the merchant"
        .quartermaster: "the stores keeper"
        .courier: if p.far_home >= 0: "the mail pilot" else: "the courier"
        .mechanic: if p.far_home >= 0: "the smith" else: "the mechanic"
        .clerk: if p.far_home >= 0: "the town clerk" else: "the harbour clerk"
        .innkeeper: "the innkeeper"
        .fisher: "a fisher"
        .patrol: "the patrol pilot"
        .telegraphist: "the telegraphist"
        .oil_presser: "the oil presser"
        .miller: "the miller"
        .teacher: "the schoolteacher"
        .nurse: "the nurse"
        .priest: "the priest"
        .hotelier: "the hotel keeper"
        .racer: "a racing pilot"
        .pirate: "a pilot"
        .farmer: "a farmer"
        .sailor: "a boatman"
        .player: "the pilot"

# Where a neighbour is found at work, for "ask X at the ..." referrals.
role_spot = (w: World, person: int) -> str:
    if person < 0 or person >= w.people.len(): return ""
    match w.people[person].occupation:
        .merchant: if w.people[person].far_home >= 0: "at the market" else: "at the store"
        .quartermaster: "at the stores"
        .mechanic: "at the workshop"
        .clerk: "at the office"
        .innkeeper: "at the inn"
        .fisher: "on the quay"
        .telegraphist: "at the telegraph office"
        .oil_presser: "at the press"
        .miller: "at the mill"
        .teacher: "at the school"
        .nurse: "at the clinic"
        .priest: "at the church"
        .hotelier: "at the hotel"
        .farmer: "in the fields"
        _: ""

# Somebody who told the speaker something. Neighbours and acquaintances are named; anyone else
# is described by trade and town, as people do with a stranger's story.
who_said = (w: World, source: int, speaker: int, listener: int) -> str:
    if source < 0 or source >= w.people.len(): return ""
    if source == listener: return "you"
    if source == speaker: return "I"
    s = w.people[source]; me = w.people[speaker]
    same_town = (s.home >= 0 and s.home == me.home) or (s.far_home >= 0 and s.far_home == me.far_home)
    if same_town or RelationshipKey(speaker,source) in w.relationship_index: return short_name(w,source)
    from = if s.far_home >= 0: life_place_name(w,s.far_home) else: if s.home >= 0: life_place_name(w,s.home) else: ""
    noun = role_noun(w,source)
    noun = if noun.starts_with("the "): "a "+noun[4..] else: noun
    if from == "": noun else: "{noun} from {from}"

# The person a speaker would send you to about a subject, from the speaker's own town:
# goods and prices -> the merchant; work -> merchant or clerk; news -> telegraphist, clerk or inn;
# aircraft -> the mechanic. Knowing what one's neighbours do is not reading a live record.
enum Referral: trade, work, news, craft

town_expert = (w: World, speaker: int, listener: int, about: Referral) -> int:
    me = w.people[speaker]
    pool: int[]
    if me.far_home >= 0:
        loop p in w.people:
            if p.far_home == me.far_home: pool.push(p.id)
    else if me.home >= 0:
        loop p in w.people:
            if p.home == me.home and p.far_home < 0: pool.push(p.id)
    wanted: Occupation[] = match about:
        .trade: [Occupation.merchant,.quartermaster]
        .work: [Occupation.merchant,.clerk,.quartermaster]
        .news: [Occupation.telegraphist,.clerk,.innkeeper,.merchant]
        .craft: [Occupation.mechanic]
    loop occupation in wanted:
        loop id in pool:
            if id != speaker and id != listener and id != w.player and w.people[id].occupation == occupation and w.people[id].state != .departed: return id
    -1

ask_expert = (w: World, speaker: int, listener: int, about: Referral) -> str:
    id = town_expert(w,speaker,listener,about)
    if id < 0: return ""
    spot = role_spot(w,id)
    if spot == "": short_name(w,id) else: "{short_name(w,id)} {spot}"
