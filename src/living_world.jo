# Coordinator entry point: pure headless world, transactions and compact projections.
# All mutators borrow World. Keep projections briefly; never retain an old World in UI state.
# Player claims load cargo but never auto-depart: call begin_trip at actual physical departure.
# Scene bodies/Pool bindings/LOD handoff live in living_scene.jo and traffic.jo.
import 'living_types.jo' as data
import 'living_seed.jo' as seed
import 'living_sim.jo' as sim
import 'living_travel.jo' as travel
import 'living_boats.jo' as boats
import 'living_commands.jo' as commands
import 'living_claims.jo' as claims
import 'living_player.jo' as player
import 'living_services.jo' as services
import 'living_pirates.jo' as pirates
import 'living_delivery.jo' as delivery
import 'living_jobs.jo' as jobs
import 'living_money.jo' as money
import 'living_news.jo' as news
import 'living_duties.jo' as duties
import 'living_save.jo' as saving
import 'living_history.jo' as history
import 'living_checks.jo' as checks
import 'living_text.jo' as sentences
import 'living_conversation.jo' as dialogue
import 'life_types.jo' as social_data
import 'living_place_context.jo' as contexts
import 'living_stories.jo' as stories
import 'living_maps.jo' as paper_maps
import 'living_map_types.jo' as paper_data
import 'living_far_transport.jo' as far_transport
import 'living_far_types.jo' as far_data
import 'living_far_people.jo' as far_people
import 'living_far_news.jo' as far_news

type World = data.World
type HarborGeometry = data.HarborGeometry
type Reason = data.Reason
type Pose = data.Pose
type PresentationState = data.PresentationState
type AirborneTrip = travel.AirborneTrip
type BoatMarker = boats.BoatMarker
type PlayerCommand = player.PlayerCommand
type CommandResult = player.CommandResult
type SaveGame = data.SaveGame
type SaveError = saving.LivingSaveError
type SaveResult = saving.SaveResult

build_world = (seed_value: u64 = u64(0), harbors: HarborGeometry[] = []) -> World: seed.build_world(seed_value,harbors)
step_minute = (w: mut World): sim.step_minute(w)
tick = (w: mut World, ticks: int = 1): sim.advance_ticks(w,ticks)
advance_minutes = (w: mut World, minutes: int): sim.advance_minutes(w,minutes)
airborne_trips = (w: World) -> AirborneTrip[]: travel.query_airborne(w)
scene_requests = (w: World) -> AirborneTrip[]: commands.query_scene_requests(w)
boat_markers = (w: World) -> BoatMarker[]: boats.query_boats(w)
begin_trip = (w: mut World, actor: int, destination: int, reason: Reason) -> int: travel.start_trip(w,actor,destination,reason)

commit_motion = (w: mut World, craft: int, revision: int, tick_value: int, pose: Pose, fuel_ml: int, hull: int, engine: int, resolved_incident: bool = false) -> int:
    commands.commit_scene_motion(w,craft,revision,tick_value,pose,fuel_ml,hull,engine,resolved_incident)
commit_arrival = (w: mut World, trip: int, place: int, dock: int, revision: int) -> bool:
    travel.commit_arrival(w,trip,place,dock,revision)

take_job = (w: mut World, job: int, actor: int = 0, choice: data.CarriageChoice = .automatic) -> bool: claims.take_job(w,job,actor,choice)
deliver_job = (w: mut World, job: int, actor: int = 0) -> bool: delivery.deliver_job(w,job,actor)
return_job_cargo = (w: mut World, job: int, actor: int = 0) -> bool: delivery.return_job_cargo(w,job,actor)
buy = (w: mut World, place: int, good: int, milli_packages: int, actor: int = 0, craft: int = -1) -> bool:
    money.trade(w,actor,place,good,milli_packages,true,craft)
sell = (w: mut World, place: int, good: int, milli_packages: int, actor: int = 0, craft: int = -1) -> bool:
    money.trade(w,actor,place,good,milli_packages,false,craft)
fill_tank = (w: mut World, craft: int, milli_packages: int) -> bool: money.fill_from_cargo(w,craft,milli_packages)
pay = (w: mut World, obligation: int, max_cents: int) -> int: duties.pay_obligation(w,obligation,max_cents)

board_lines = (w: World, place: int) -> str[]: jobs.board_lines(w,place)
proximity_speech = (w: World, person: int) -> str: news.proximity_speech(w,person)
bark = (w: mut World, presentation: mut PresentationState, speaker: int, listener_pos: vec3) -> str:
    news.bark(w,presentation,speaker,listener_pos)
news_lines = (w: World, place: int) -> str[]: news.news_lines(w,place)
say_reason = (w: World, reason: Reason) -> str: sentences.say_reason(w,reason)

# Before save: synchronize common poses/fuel/damage and fold scene ownership in the adapter.
# Rejected schema/terrain versions never overwrite slots. No offline wall-clock catch-up.
save_world = (w: World, presentation: PresentationState, terrain_key: int, prefix: str = "world") -> int | SaveError:
    saving.save_game(w,presentation,terrain_key,prefix)
load_world = (terrain_key: int, prefix: str = "world") -> SaveResult: saving.load_game(terrain_key,prefix)
prune = (w: mut World, presentation: mut PresentationState): history.prune_history(w,presentation)
canonical_hash = (w: World) -> u64: saving.canonical_hash(w)
invariant_errors = (w: World) -> str[]: checks.invariant_errors(w)

apply_command = (w: mut World, command: PlayerCommand) -> CommandResult: player.apply_command(w,command)

request_ferry = (w: mut World, person: int, destination: int) -> int: services.request_ferry(w,person,destination)
request_tow = (w: mut World, person: int, craft: int, workshop: int) -> int: services.request_tow(w,person,craft,workshop)
request_repair = (w: mut World, person: int) -> int: duties.request_repair(w,person)

commit_encounter = (w: mut World, encounter: int, raider_revision: int, victim_revision: int, surrendered: bool) -> bool: pirates.commit_encounter(w,encounter,raider_revision,victim_revision,surrendered)

# Conversation layout reads topics/preview; actual utterances/replies explicitly commit memory.
type TalkTopic = social_data.TalkTopic
type TalkReply = social_data.TalkReply
type TalkOption = social_data.TalkOption
type ConversationTurn = social_data.ConversationTurn
talk_topics = (w: World, speaker: int, listener: int = 0) -> TalkOption[]: dialogue.conversation_topics(w,speaker,listener)
talk_preview = (w: World, speaker: int, topic: TalkTopic, listener: int = 0) -> ConversationTurn: dialogue.conversation_preview(w,speaker,listener,topic)
talk = (w: mut World, speaker: int, topic: TalkTopic, listener: int = 0, private: bool = false) -> ConversationTurn: dialogue.converse(w,speaker,listener,topic,private)
reply = (w: mut World, speaker: int, answer: TalkReply, listener: int = 0) -> ConversationTurn: dialogue.answer_conversation(w,speaker,listener,answer)

# Read-only content contracts; dialogue/notebook presentation stays outside the simulation.
type DailyIntent = social_data.DailyIntent
type LifeVenue = social_data.LifeVenue
type LifePlaceContext = social_data.LifePlaceContext
daily_intent = (w: World, person: int) -> DailyIntent?: if person in w.daily_life: w.daily_life[person] else: none
place_context = (w: World, id: int) -> LifePlaceContext?: contexts.place_context(w,id)
place_name = (w: World, id: int) -> str: contexts.life_place_name(w,id)
personal_story_notes = (w: World, person: int) -> str[]: stories.life_story_lines(w,person)
heard_notes = (w: World, person: int) -> str[]:
    if person < 0 or person >= w.people.len(): return []
    result = [loop n in w.people[person].news: if not n.private_fact and w.minute-n.occurred_minute < 10080: news.news_sentence(w,n)]
    loop r in w.people[person].far_reports:
        if far_news.far_report_current(w,r): result.push(r.text)
    result
town_regard = (w: World, place: int, person: int = 0) -> int: w.reputation.get(data.ReputationKey(place,.person,person),0)

type VenueKind = social_data.VenueKind
type LifeActivity = social_data.LifeActivity
type LifeMobility = social_data.LifeMobility
venues_at = (w: World, place: int) -> LifeVenue[]:
    if place >= 0 and place < w.places.len(): return [loop v in w.life_venues: if v.place == place: v]
    if place in w.place_contexts: return w.place_contexts[place].venues
    []

# Person-to-person work request, never a general board projection. Referrals retain heard terms.
type WorkOffer = social_data.WorkOffer
ask_for_work = (w: mut World, speaker: int, listener: int = 0) -> ConversationTurn: dialogue.converse(w,speaker,listener,.work)
work_offers = (w: World, speaker: int, listener: int = 0) -> WorkOffer[]: dialogue.person_work_offers(w,speaker,listener)

# Owned physical sheets and edition data. The UI chooses browsing/rendering and layer symbols.
type PaperMap = paper_data.PaperMap
type MapCopy = paper_data.MapCopy
type MapLayer = paper_data.MapLayer
type MapKind = paper_data.MapKind
type MapOffer = paper_data.MapOffer
type MapTradeResult = paper_data.MapTradeResult
owned_maps = (w: World, person: int = 0) -> MapCopy[]: paper_maps.owned_maps(w,person)
map_description = (w: World, edition: str) -> PaperMap?: paper_maps.map_description(w,edition)
map_layers = (w: World, edition: str) -> MapLayer[]: paper_maps.map_layers(w,edition)
selected_map = (w: World, person: int = 0) -> MapCopy?: paper_maps.selected_map(w,person)
select_map = (w: mut World, copy: int, person: int = 0) -> bool: paper_maps.select_map(w,copy,person)
map_sellers = (w: World, person: int = 0) -> paper_data.MapShop[]: paper_maps.map_sellers(w,person)
map_offers = (w: World, seller: str, person: int = 0) -> MapOffer[]: paper_maps.map_offers(w,seller,person)
buy_map = (w: mut World, copy: int, person: int = 0) -> MapTradeResult: paper_maps.buy_map(w,copy,person)
give_map = (w: mut World, copy: int, giver: int, receiver: int) -> bool: paper_maps.give_map(w,copy,giver,receiver)
nearby_map_finds = (w: World, person: int = 0) -> MapCopy[]: paper_maps.nearby_map_finds(w,person)
find_map = (w: mut World, copy: int, person: int = 0) -> MapTradeResult: paper_maps.find_map(w,copy,person)
grant_every_map = (w: mut World, person: int = 0) -> int: paper_maps.grant_every_map(w,person)
claim_map_reward = (w: mut World, job: int, person: int = 0) -> MapTradeResult: paper_maps.claim_map_reward(w,job,person)
map_feature = (w: World, edition: str, layer: MapLayer, key: str, actual: vec3, label: str = "", town_size: int = 1000000) -> paper_data.MapMark: paper_maps.map_feature(w,edition,layer,key,actual,label,town_size)
map_extra_marks = (w: World, edition: str, layer: MapLayer) -> paper_data.MapMark[]: paper_maps.map_extra_marks(w,edition,layer)

# Frozen, already projected named marks/lines; do not replace these with today's world features.
type MapFeature = paper_data.MapFeature
map_features = (w: World, edition: str, layer: MapLayer) -> MapFeature[]: paper_maps.map_features(w,edition,layer)

# Read-only physical cargo services for ship/cart scene consumers. Stable district IDs.
type FarTransportView = far_data.FarTransportView
far_transport_views = (w: World, observer: vec3, radius: f64 = 6000.0) -> FarTransportView[]: far_transport.far_transport_views(w,observer,radius)

# A place is a stable registry ID; generated residents keep legacy home/place at -1.
person_place = (w: World, person: int) -> int: data.person_place(w,person)
person_position = (w: World, person: int) -> vec3: data.person_world_position(w,person)

type FarResidentView = far_data.FarResidentView
far_resident_views = (w: World) -> FarResidentView[]: far_people.far_resident_views(w)

# Civil calendar shared with air events; gathering counts never create people.
import 'living_calendar.jo' as calendar
type CapitalGathering = calendar.CapitalGathering
capital_feast_day = (capital_id: int, world_day: int) -> bool: calendar.capital_feast_day(capital_id,world_day)
next_capital_feast_minute = (capital_id: int, after_minute: int) -> int: calendar.next_capital_feast_minute(capital_id,after_minute)
capital_gatherings = (w: World, minute: int) -> CapitalGathering[]: calendar.capital_gatherings(w,minute)

# Sparse-place work uses a separate ID namespace: WorkOffer/ConversationTurn.commission >=0.
# Existing .job fields and all talk signatures keep their previous meanings.
import 'living_commissions.jo' as commissions
type CommissionView = far_data.CommissionView
commission_views = (w: World, place: int = -1, actor: int = -1) -> CommissionView[]: commissions.commission_views(w,place,actor)
refresh_far_work = (w: mut World, place: int) -> int: commissions.refresh_far_work(w,place)
claim_commission = (w: mut World, id: int, actor: int = 0, loader: data.CarriageChoice = .player) -> bool: commissions.claim_far_commission(w,id,actor,loader)
pickup_commission = (w: mut World, id: int, actor: int = 0) -> bool: commissions.pickup_far_commission(w,id,actor)
load_commission = (w: mut World, id: int, actor: int = 0) -> bool: commissions.load_far_commission(w,id,actor)
collect_commission = (w: mut World, id: int, actor: int = 0) -> bool: commissions.collect_far_commission(w,id,actor)

# Survival does not award a generic bounty. Mission escrow pays only its actual participants.
import 'living_war_rescue.jo' as war_rescue
type SurvivorView = war_rescue.SurvivorView
survivors_near = (w: World, observer: vec3, radius: f64 = 6000.0) -> SurvivorView[]: war_rescue.survivor_views(w,observer,radius)
board_survivors = (w: mut World, id: int, actor: int = 0) -> int: war_rescue.board_survivors(w,id,actor)
land_survivors = (w: mut World, id: int, place: int, actor: int = 0) -> int: war_rescue.land_survivors(w,id,place,actor)

import 'living_missions.jo' as missions
import 'living_mission_types.jo' as mission_data
import 'living_war_views.jo' as war_views
type MissionView = mission_data.MissionView
type WarPlaceView = war_views.WarPlaceView
type WarRelationView = war_views.WarRelationView
military_work = (w: World, place: int = -1, actor: int = -1) -> MissionView[]: missions.mission_views(w,place,actor)
claim_military_work = (w: mut World, id: int, actor: int = 0, loader: data.CarriageChoice = .player) -> bool: missions.claim_mission(w,id,actor,loader)
report_military_work = (w: mut World, id: int, actor: int = 0) -> bool: missions.finish_mission(w,id,actor)
war_places = (w: World, actor: int = 0) -> WarPlaceView[]: war_views.war_places(w,actor)
war_relations = (w: World, actor: int = 0) -> WarRelationView[]: war_views.war_relations(w,actor)
national_regard = (w: World, country: int, actor: int = 0) -> int: w.war.reputation.get("{actor}:{country}",0)

import 'living_work.jo' as work_history
job_provenance = (w: World, id: int) -> str[]: work_history.job_provenance(w,id)
commission_provenance = (w: World, id: int) -> str[]: work_history.commission_provenance(w,id)
journey_provenance = (w: World, id: int) -> str[]: work_history.journey_provenance(w,id)

import 'living_war_names.jo' as battle_names
engagement_name = (w: World, engagement: int) -> str?: battle_names.engagement_name(w,engagement)
type WarEngagementView = battle_names.WarEngagementView
war_engagements = (w: World, observer: vec3, radius: f64 = 6000.0) -> WarEngagementView[]: battle_names.war_engagements(w,observer,radius)
