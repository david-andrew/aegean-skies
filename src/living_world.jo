# Coordinator entry point: pure headless world, transactions and compact projections.
# All mutators borrow World. Keep projections briefly; never retain an old World in UI state.
# Player claims load cargo but never auto-depart: call begin_trip at actual physical departure.
# Scene bodies/Pool bindings/LOD handoff and saved integrator extensions belong to chunks 13–14.
import 'living_types.jo' as data
import 'living_seed.jo' as seed
import 'living_sim.jo' as sim
import 'living_travel.jo' as travel
import 'living_boats.jo' as boats
import 'living_commands.jo' as commands
import 'living_claims.jo' as claims
import 'living_player.jo' as player
import 'living_services.jo' as services
import 'living_pirates.jo' as pirates
import 'living_delivery.jo' as delivery
import 'living_jobs.jo' as jobs
import 'living_money.jo' as money
import 'living_news.jo' as news
import 'living_duties.jo' as duties
import 'living_save.jo' as saving
import 'living_history.jo' as history
import 'living_checks.jo' as checks
import 'living_text.jo' as sentences

type World = data.World
type HarborGeometry = data.HarborGeometry
type Reason = data.Reason
type Pose = data.Pose
type PresentationState = data.PresentationState
type AirborneTrip = travel.AirborneTrip
type BoatMarker = boats.BoatMarker
type PlayerCommand = player.PlayerCommand
type CommandResult = player.CommandResult
type SaveGame = data.SaveGame
type SaveError = saving.LivingSaveError
type SaveResult = saving.SaveResult

build_world = (seed_value: u64 = u64(0), harbors: HarborGeometry[] = []) -> World: seed.build_world(seed_value,harbors)
step_minute = (w: mut World): sim.step_minute(w)
tick = (w: mut World, ticks: int = 1): sim.advance_ticks(w,ticks)
advance_minutes = (w: mut World, minutes: int): sim.advance_minutes(w,minutes)
airborne_trips = (w: World) -> AirborneTrip[]: travel.query_airborne(w)
scene_requests = (w: World) -> AirborneTrip[]: commands.query_scene_requests(w)
boat_markers = (w: World) -> BoatMarker[]: boats.query_boats(w)
begin_trip = (w: mut World, actor: int, destination: int, reason: Reason) -> int: travel.start_trip(w,actor,destination,reason)

commit_motion = (w: mut World, craft: int, revision: int, tick_value: int, pose: Pose, fuel_ml: int, hull: int, engine: int, resolved_incident: bool = false) -> int:
    commands.commit_scene_motion(w,craft,revision,tick_value,pose,fuel_ml,hull,engine,resolved_incident)
commit_arrival = (w: mut World, trip: int, place: int, dock: int, revision: int) -> bool:
    travel.commit_arrival(w,trip,place,dock,revision)

take_job = (w: mut World, job: int, actor: int = 0) -> bool: claims.take_job(w,job,actor)
deliver_job = (w: mut World, job: int, actor: int = 0) -> bool: delivery.deliver_job(w,job,actor)
return_job_cargo = (w: mut World, job: int, actor: int = 0) -> bool: delivery.return_job_cargo(w,job,actor)
buy = (w: mut World, place: int, good: int, milli_packages: int, actor: int = 0, craft: int = -1) -> bool:
    money.trade(w,actor,place,good,milli_packages,true,craft)
sell = (w: mut World, place: int, good: int, milli_packages: int, actor: int = 0, craft: int = -1) -> bool:
    money.trade(w,actor,place,good,milli_packages,false,craft)
fill_tank = (w: mut World, craft: int, milli_packages: int) -> bool: money.fill_from_cargo(w,craft,milli_packages)
pay = (w: mut World, obligation: int, max_cents: int) -> int: duties.pay_obligation(w,obligation,max_cents)

board_lines = (w: World, place: int) -> str[]: jobs.board_lines(w,place)
proximity_speech = (w: World, person: int) -> str: news.proximity_speech(w,person)
bark = (w: mut World, presentation: mut PresentationState, speaker: int, listener_pos: vec3) -> str:
    news.bark(w,presentation,speaker,listener_pos)
news_lines = (w: World, place: int) -> str[]: news.news_lines(w,place)
say_reason = (w: World, reason: Reason) -> str: sentences.say_reason(w,reason)

# Before save: synchronize common poses/fuel/damage and fold scene ownership in the adapter.
# Rejected schema/terrain versions never overwrite slots. No offline wall-clock catch-up.
save_world = (w: World, presentation: PresentationState, terrain_key: int, prefix: str = "world") -> int | SaveError:
    saving.save_game(w,presentation,terrain_key,prefix)
load_world = (terrain_key: int, prefix: str = "world") -> SaveResult: saving.load_game(terrain_key,prefix)
prune = (w: mut World, presentation: mut PresentationState): history.prune_history(w,presentation)
canonical_hash = (w: World) -> u64: saving.canonical_hash(w)
invariant_errors = (w: World) -> str[]: checks.invariant_errors(w)

apply_command = (w: mut World, command: PlayerCommand) -> CommandResult: player.apply_command(w,command)

request_ferry = (w: mut World, person: int, destination: int) -> int: services.request_ferry(w,person,destination)
request_tow = (w: mut World, person: int, craft: int, workshop: int) -> int: services.request_tow(w,person,craft,workshop)
request_repair = (w: mut World, person: int) -> int: duties.request_repair(w,person)

commit_encounter = (w: mut World, encounter: int, raider_revision: int, victim_revision: int, surrendered: bool) -> bool: pirates.commit_encounter(w,encounter,raider_revision,victim_revision,surrendered)
