# A continuous fixed-season sky, not a civil-calendar ephemeris. Its one lunar
# phase parameter advances by the 29.53059-day synodic month. Lighting on the
# visible lunar sphere uses the actual Sun direction, never a painted phase mask.
const LUNAR_MONTH = 29.53059
const LUNAR_EPOCH_AGE = 10.0

sky_orbit = (a: f64) -> vec3:
    vec3(f32(cos(a)), f32(sin(a) * 0.93969262), f32(-sin(a) * 0.34202014))

sky_sun = (hour: f64) -> vec3: sky_orbit((hour - 6.0) / 12.0 * PI)

sky_moon = (hour: f64, days: f64) -> vec3:
    a = (hour - 6.0) / 12.0 * PI
    phase = ((days + LUNAR_EPOCH_AGE) / LUNAR_MONTH) % 1.0 * TAU
    p = sky_orbit(a - phase)
    # A small inclination gives conjunctions vertical separation in most months.
    latitude = sin(phase + 0.7) * 0.08979719
    normalize(p * f32(cos(latitude)) + vec3(0, 0.34202014, 0.93969262) * f32(sin(latitude)))

moon_illumination = (sun: vec3, moon: vec3) -> f64:
    clamp((1.0 - f64(dot(sun, moon))) * 0.5, 0.0, 1.0)

# Share the Sun's existing painted exaggeration. Physical diameter is ~0.52 deg;
# the game's solar cel is ~3.14 deg across at half coverage. Do not enlarge only
# the Moon by eye: both masks use these same angular edges.
const SKY_DISC_OUTER:f32=0.99955
const SKY_DISC_INNER:f32=0.9997
const SKY_DISC_RADIUS:f32=0.02738356

# JPL approximate Keplerian elements, Table 1 (1800-2050), J2000 + rates/century.
# https://ssd.jpl.nasa.gov/planets/approx_pos.html
# The world has an elapsed-day calendar, not an absolute civil date. Day zero is
# Monday 1926-06-07 for the orbital epoch only. Preserve its fixed-season solar
# path: geocentric longitude relative to the Sun maps into that same sky plane.
# This is a plausible period sky, not a historical observing ephemeris.
struct SkyOrbit:
    a:f64;e:f64;inc:f64;longitude:f64;peri:f64;node:f64
    da:f64;de:f64;di:f64;dl:f64;dp:f64;dn:f64
SKY_ORBITS=[
    SkyOrbit(1.00000261,0.01671123,-0.00001531,100.46457166,102.93768193,0,0.00000562,-0.00004392,-0.01294668,35999.37244981,0.32327364,0),
    SkyOrbit(0.72333566,0.00677672,3.39467605,181.97909950,131.60246718,76.67984255,0.00000390,-0.00004107,-0.00078890,58517.81538729,0.00268329,-0.27769418),
    SkyOrbit(5.20288700,0.04838624,1.30439695,34.39644051,14.72847983,100.47390909,-0.00011607,-0.00013253,-0.00183714,3034.74612775,0.21252668,0.20469106),
    SkyOrbit(1.52371034,0.09339410,1.84969142,-4.55343205,-23.94362959,49.55953891,0.00001847,0.00007882,-0.00813131,19140.30268499,0.44441088,-0.29257343),
    SkyOrbit(9.53667594,0.05386179,2.48599187,49.95424423,92.59887831,113.66242448,-0.00125060,-0.00050991,0.00193609,1222.49362201,-0.41897216,-0.28867794)]
sky_planet_orbit=(index:int,days:f64)->vec3:
    o=SKY_ORBITS[index]
    T=(days-26871.5)/36525.0
    rad=PI/180.0
    a=o.a+o.da*T;e=o.e+o.de*T
    inc=(o.inc+o.di*T)*rad;node=(o.node+o.dn*T)*rad
    peri=(o.peri+o.dp*T)*rad;w=peri-node
    M=((o.longitude+o.dl*T)*rad-peri)%TAU
    E=M
    loop i in 0..8:E-=(E-e*sin(E)-M)/(1.0-e*cos(E))
    x=a*(cos(E)-e);y=a*sqrt(1.0-e*e)*sin(E)
    vec3((cos(w)*cos(node)-sin(w)*sin(node)*cos(inc))*x+(-sin(w)*cos(node)-cos(w)*sin(node)*cos(inc))*y,
        (cos(w)*sin(node)+sin(w)*cos(node)*cos(inc))*x+(-sin(w)*sin(node)+cos(w)*cos(node)*cos(inc))*y,
        sin(w)*sin(inc)*x+cos(w)*sin(inc)*y)

sky_planets=(hour:f64,days:f64)->vec4[4]:
    result:vec4[4]
    earth=sky_planet_orbit(0,days)
    solar=atan2(-f64(earth.y),-f64(earth.x))
    loop k in 0..4:
        planet=sky_planet_orbit(k+1,days)
        geo=planet-earth;distance=f64(length(geo));n=geo/f32(distance)
        longitude=atan2(f64(n.y),f64(n.x))-solar
        p=sky_orbit((hour-6.0)/12.0*PI-longitude)*sqrt(max(0.0,1.0-n.z*n.z))+vec3(0,0.34202014,0.93969262)*n.z
        phase=clamp((1.0+f64(dot(normalize(-planet),normalize(-geo))))*0.5,0.0,1.0)
        reference=[1.0,5.0,1.5,9.5][k]
        strength=[1.8,1.25,0.85,0.65][k]*clamp(reference/distance,0.6,1.1)*(0.6+0.4*phase)
        if k==0:strength=max(1.55,strength)
        result[k]=vec4(normalize(p),f32(strength))
    result
