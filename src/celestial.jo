# A continuous fixed-season sky, not a civil-calendar ephemeris for the Sun: its path is the same
# every day. The Moon keeps the real calendar from the world's start (7 June 1926): its age and its
# height above or below the Sun's path follow the main terms of the lunar theory (sky_moon), so new
# and full moons fall on their real dates and eclipses come when they really came (eclipse.jo).
# Lighting on the visible lunar sphere uses the actual Sun direction, never a painted phase mask.
const LUNAR_MONTH = 29.53059
const LUNAR_EPOCH_AGE = 25.92       # the Moon's real age at the world's minute 0 (new moon 10 June 1926)
const SKY_EPOCH_JD = 2424673.8125   # the world's minute 0, 1926-06-07 07:30 UT (09:30 in Greece)

sky_orbit = (a: f64) -> vec3:
    vec3(f32(cos(a)), f32(sin(a) * 0.93969262), f32(-sin(a) * 0.34202014))

sky_sun = (hour: f64) -> vec3: sky_orbit((hour - 6.0) / 12.0 * PI)

# The Moon's elongation east of the Sun and its latitude above the ecliptic (radians) on the world's
# day `days`: the mean motions and the largest periodic terms (Meeus, ch. 47; within a few tenths
# of a degree, which places every new and full moon within an hour or so of its real time).
moon_elongation_latitude = (days: f64) -> (f64, f64):
    T = (SKY_EPOCH_JD + days - 2451545.0) / 36525.0
    r = PI / 180.0
    D = (297.8501921 + 445267.1114034 * T) * r
    M = (357.5291092 + 35999.0502909 * T) * r
    Mp = (134.9633964 + 477198.8675055 * T) * r
    F = (93.2720950 + 483202.0175233 * T) * r
    moon = 6.288774 * sin(Mp) + 1.274027 * sin(2.0 * D - Mp) + 0.658314 * sin(2.0 * D) + 0.213618 * sin(2.0 * Mp) - 0.185116 * sin(M) - 0.114332 * sin(2.0 * F) + 0.058793 * sin(2.0 * D - 2.0 * Mp) + 0.057066 * sin(2.0 * D - M - Mp) + 0.053322 * sin(2.0 * D + Mp) + 0.045758 * sin(2.0 * D - M)
    sun = 1.914602 * sin(M) + 0.019993 * sin(2.0 * M)
    lat = 5.128122 * sin(F) + 0.280602 * sin(Mp + F) + 0.277693 * sin(Mp - F) + 0.173237 * sin(2.0 * D - F)
    (D + (moon - sun) * r, lat * r)

sky_moon = (hour: f64, days: f64) -> vec3:
    a = (hour - 6.0) / 12.0 * PI
    (phase, latitude) = moon_elongation_latitude(days)
    p = sky_orbit(a - phase)
    normalize(p * f32(cos(latitude)) + vec3(0, 0.34202014, 0.93969262) * f32(sin(latitude)))

moon_illumination = (sun: vec3, moon: vec3) -> f64:
    clamp((1.0 - f64(dot(sun, moon))) * 0.5, 0.0, 1.0)

# How far the Moon is out as a light of its own, by the sun's height (the sine of it): the day's
# pale wash until a little before sunset, a glowing emitter from about half an hour after it.
moon_glow = (sun_y: f64) -> f64: 1.0 - smoothstep(-0.16, 0.1, sun_y)

# The painted scale the sky's lights were first drawn at (a disc 3.14 deg across): the sea's sun and
# moon glints still use this cone (sea.jo), and the aureoles, glows and coronas about the Sun and the
# Moon keep their reach in these units (sky.jo, night_sky.jo), so the look round them is unchanged.
const SKY_DISC_OUTER:f32=0.99955
const SKY_DISC_INNER:f32=0.9997
const SKY_DISC_RADIUS:f32=0.02738356
# The discs themselves at their real sizes: the Sun 0.533 deg across, the Moon 0.518 (its mean: 0.49
# to 0.56 over its orbit; an eclipse gives its own, eclipse.jo).
const SUN_DISC_RADIUS:f32=0.004652
const MOON_DISC_RADIUS:f32=0.004520
const SUN_DISC_SHARE:f32=0.169883   # SUN_DISC_RADIUS / SKY_DISC_RADIUS
const MOON_DISC_SHARE:f32=0.165063  # MOON_DISC_RADIUS / SKY_DISC_RADIUS

# How large the discs are drawn: the Sun's diameter in degrees (0.533 its real size, the Moon's in
# proportion). The one setting for the user's choice of size: change SKY_DISC_DEGREES here, or try
# one with AEGEAN_SKY_DISC=<degrees> or the World debug page's "Sun and Moon" row.
const SKY_DISC_DEGREES = 0.533
SKY_DISC_CHOICES = [0.533, 1.0, 1.5, 3.14]
sky_disc_scale: f64 = (to_float(env("AEGEAN_SKY_DISC") ?? "") ?? SKY_DISC_DEGREES) / 0.533
set_sky_disc_degrees = (degrees: f64):
    global sky_disc_scale
    sky_disc_scale = clamp(degrees, 0.2, 6.0) / 0.533
sky_disc_degrees = () -> f64: sky_disc_scale * 0.533
sun_disc_radius = () -> f32: SUN_DISC_RADIUS * f32(sky_disc_scale)
moon_disc_radius = () -> f32: MOON_DISC_RADIUS * f32(sky_disc_scale)
sun_disc_share = () -> f32: SUN_DISC_SHARE * f32(sky_disc_scale)
moon_disc_share = () -> f32: MOON_DISC_SHARE * f32(sky_disc_scale)

# JPL approximate Keplerian elements, Table 1 (1800-2050), J2000 + rates/century.
# https://ssd.jpl.nasa.gov/planets/approx_pos.html
# The world has an elapsed-day calendar, not an absolute civil date. Day zero is
# Monday 1926-06-07 for the orbital epoch only. Preserve its fixed-season solar
# path: geocentric longitude relative to the Sun maps into that same sky plane.
# This is a plausible period sky, not a historical observing ephemeris.
struct SkyOrbit:
    a:f64;e:f64;inc:f64;longitude:f64;peri:f64;node:f64
    da:f64;de:f64;di:f64;dl:f64;dp:f64;dn:f64
SKY_ORBITS=[
    SkyOrbit(1.00000261,0.01671123,-0.00001531,100.46457166,102.93768193,0,0.00000562,-0.00004392,-0.01294668,35999.37244981,0.32327364,0),
    SkyOrbit(0.72333566,0.00677672,3.39467605,181.97909950,131.60246718,76.67984255,0.00000390,-0.00004107,-0.00078890,58517.81538729,0.00268329,-0.27769418),
    SkyOrbit(5.20288700,0.04838624,1.30439695,34.39644051,14.72847983,100.47390909,-0.00011607,-0.00013253,-0.00183714,3034.74612775,0.21252668,0.20469106),
    SkyOrbit(1.52371034,0.09339410,1.84969142,-4.55343205,-23.94362959,49.55953891,0.00001847,0.00007882,-0.00813131,19140.30268499,0.44441088,-0.29257343),
    SkyOrbit(9.53667594,0.05386179,2.48599187,49.95424423,92.59887831,113.66242448,-0.00125060,-0.00050991,0.00193609,1222.49362201,-0.41897216,-0.28867794)]
sky_planet_orbit=(index:int,days:f64)->vec3:
    o=SKY_ORBITS[index]
    T=(days-26871.5)/36525.0
    rad=PI/180.0
    a=o.a+o.da*T;e=o.e+o.de*T
    inc=(o.inc+o.di*T)*rad;node=(o.node+o.dn*T)*rad
    peri=(o.peri+o.dp*T)*rad;w=peri-node
    M=((o.longitude+o.dl*T)*rad-peri)%TAU
    E=M
    loop i in 0..8:E-=(E-e*sin(E)-M)/(1.0-e*cos(E))
    x=a*(cos(E)-e);y=a*sqrt(1.0-e*e)*sin(E)
    vec3((cos(w)*cos(node)-sin(w)*sin(node)*cos(inc))*x+(-sin(w)*cos(node)-cos(w)*sin(node)*cos(inc))*y,
        (cos(w)*sin(node)+sin(w)*cos(node)*cos(inc))*x+(-sin(w)*sin(node)+cos(w)*cos(node)*cos(inc))*y,
        sin(w)*sin(inc)*x+cos(w)*sin(inc)*y)

sky_planets=(hour:f64,days:f64)->vec4[4]:
    result:vec4[4]
    earth=sky_planet_orbit(0,days)
    solar=atan2(-f64(earth.y),-f64(earth.x))
    loop k in 0..4:
        planet=sky_planet_orbit(k+1,days)
        geo=planet-earth;distance=f64(length(geo));n=geo/f32(distance)
        longitude=atan2(f64(n.y),f64(n.x))-solar
        p=sky_orbit((hour-6.0)/12.0*PI-longitude)*sqrt(max(0.0,1.0-n.z*n.z))+vec3(0,0.34202014,0.93969262)*n.z
        phase=clamp((1.0+f64(dot(normalize(-planet),normalize(-geo))))*0.5,0.0,1.0)
        reference=[1.0,5.0,1.5,9.5][k]
        strength=[1.8,1.25,0.85,0.65][k]*clamp(reference/distance,0.6,1.1)*(0.6+0.4*phase)
        if k==0:strength=max(1.55,strength)
        result[k]=vec4(normalize(p),f32(strength))
    result
