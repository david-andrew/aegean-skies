# The one stable water-source entry point used by gameplay and surface effects.
use 'water_types.jo'
use 'river_field.jo'
use 'lake_field.jo'
use 'river_data.jo'
use 'lake_data.jo'
use 'lake_channels_data.jo'
water_resolve=(river:WaterSample,lake:WaterSample)->WaterSample:
    # At a confluence, a dry corridor must never mask a covered water surface.
    if lake.wet:return lake
    if river.wet:return river
    if lake.found:return lake
    if river.found:return river
    NO_INLAND_WATER
water_at=(x:f64,z:f64)->WaterSample:water_resolve(river_at(x,z),lake_at(x,z))
water_level_at = (x: f64, z: f64) -> f64:
    water = water_at(x,z)
    if water.wet: water.level else: 0.0
water_current=(x:f64,z:f64)->vec3:
    water=water_at(x,z)
    if water.wet:water.current else:vec3(0,0,0)
water_carve=(x:f64,z:f64,h:f64)->f64:lake_carve(x,z,river_carve(x,z,h))

# Whether any river, lake or lake channel could answer water_at anywhere in the square of
# half-size r about (x,z). The lookups only ever find water through these bins, so false
# means every water_at in the square is NO_INLAND_WATER (the open sea or dry land).
inland_water_near=(x:f64,z:f64,r:f64)->bool:
    if not (x+r<f64(RIVER_BOUNDS.x) or x-r>f64(RIVER_BOUNDS.z) or z+r<f64(RIVER_BOUNDS.y) or z-r>f64(RIVER_BOUNDS.w)):
        loop ix in int(floor((x-r)/2048.0))..int(floor((x+r)/2048.0))+1:
            loop iz in int(floor((z-r)/2048.0))..int(floor((z+r)/2048.0))+1:
                if (ix*1024+iz) in RIVER_BINS:return true
    loop ix in int(floor((x-r)/4096.0))..int(floor((x+r)/4096.0))+1:
        loop iz in int(floor((z-r)/4096.0))..int(floor((z+r)/4096.0))+1:
            if (ix*1024+iz) in LAKE_BINS:return true
    loop ix in int(floor((x-r)/256.0))..int(floor((x+r)/256.0))+1:
        loop iz in int(floor((z-r)/256.0))..int(floor((z+r)/256.0))+1:
            if (ix*8192+iz) in LAKE_CHANNEL_BINS:return true
    false
