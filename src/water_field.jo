# The one stable water-source entry point used by gameplay and surface effects.
use 'water_types.jo'
use 'river_field.jo'
use 'lake_field.jo'
water_resolve=(river:WaterSample,lake:WaterSample)->WaterSample:
    # At a confluence, a dry corridor must never mask a covered water surface.
    if lake.wet:return lake
    if river.wet:return river
    if lake.found:return lake
    if river.found:return river
    WaterSample()
water_at=(x:f64,z:f64)->WaterSample:water_resolve(river_at(x,z),lake_at(x,z))
water_current=(x:f64,z:f64)->vec3:
    water=water_at(x,z)
    if water.wet:water.current else:vec3(0,0,0)
water_carve=(x:f64,z:f64,h:f64)->f64:lake_carve(x,z,river_carve(x,z,h))
