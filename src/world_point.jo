# Double precision world positions. Accumulate motion before narrowing to vec3.
struct WorldPoint:
    x: f64
    y: f64
    z: f64
world_point = (p: vec3) -> WorldPoint: WorldPoint(f64(p.x),f64(p.y),f64(p.z))
world_vec = (p: WorldPoint) -> vec3: vec3(f32(p.x),f32(p.y),f32(p.z))
world_local = (p: WorldPoint,origin: vec3) -> vec3: vec3(f32(p.x-f64(origin.x)),f32(p.y-f64(origin.y)),f32(p.z-f64(origin.z)))
world_residual = (p: WorldPoint) -> vec3: world_local(p,world_vec(p))
world_lerp = (a: WorldPoint,b: WorldPoint,t: f64) -> WorldPoint:
    WorldPoint(a.x+(b.x-a.x)*t,a.y+(b.y-a.y)*t,a.z+(b.z-a.z)*t)

world_offset = (p: WorldPoint,delta: vec3) -> WorldPoint:
    WorldPoint(p.x+f64(delta.x),p.y+f64(delta.y),p.z+f64(delta.z))
world_advance = (p: WorldPoint,velocity: vec3,dt: f64) -> WorldPoint:
    WorldPoint(p.x+f64(velocity.x)*dt,p.y+f64(velocity.y)*dt,p.z+f64(velocity.z)*dt)
world_delta = (a: WorldPoint,b: WorldPoint) -> vec3:
    vec3(f32(a.x-b.x),f32(a.y-b.y),f32(a.z-b.z))
