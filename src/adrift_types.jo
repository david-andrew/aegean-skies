# A working boat in trouble at sea (src/living_adrift.jo): saved in the World (World.adrift), so a
# boat adrift stays adrift, where it is, across a save and a load.

enum AdriftCause: engine, mast, lost
enum AdriftState: adrift, aboard, towed, reported, home

struct AdriftBoat:
    trip: int                       # the fishing trip it was on (held while it is out there)
    person: int                     # its skipper
    home: int                       # the harbour it sailed from (core place)
    cause: AdriftCause
    route: int                      # the sea route it drifts along (its key in World.sea_routes)
    start_mm: int                   # how far along that route it came to grief (mm)
    since: int                      # the minute it did
    state: AdriftState = .adrift
    at: vec3 = vec3(0,0,0)          # where it is now (kept each minute)
    found = false                   # the pilot has come upon it
    help_minute = -1                # (towed, reported) when help set off
    home_minute = -1                # (towed, reported) when it will be in
    helper = -1                     # (towed) the skipper of the boat that took the line
    rescuer = -1                    # who brought them in: the pilot (0), another skipper, -1 the harbour
    pilot_helped = false            # the pilot took them aboard, got them a tow, or told the harbour
    credited = false                # (the pilot's name has had it: src/reputation.jo)
