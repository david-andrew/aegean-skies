# The wildlife heard (src/wildlife.jo): its calls played as the ambience's own events, so they
# share its voices, its budget, its walls and hills and its Animals switch: geese honking, mallards
# quacking and coots calling (louder
# and quicker when alarmed and as they take off), gulls crying and squabbling, goat bells and
# bleats from the herds. All kept quiet.
use 'ambience_scene.jo'
use 'ambience_synth.jo'
use 'ambience.jo'
use 'wildlife.jo'

# (the calls' gains in wildlife.jo are relative: this brings a honk 10 m off to stand out of the
# shore's wash by about as much as the shore's own gull does)
const WILD_VOICE_GAIN = 2.0

wildlife_voices = (scene: mut AmbienceScene, wl: mut Wildlife, listener: vec3):
    if not scene.sound.active or scene.sound.last_time < 0.0: return
    loop c in wl.calls:
        kind = match c.voice:
            .honk: AmbienceKind.goose
            .cry: AmbienceKind.gull
            .bell: AmbienceKind.goat
            .quack: AmbienceKind.quack
            .kowk: AmbienceKind.coot
            .blow: AmbienceKind.blow
            .plash: AmbienceKind.plash
            _: AmbienceKind.bleat
        reach = match c.voice:
            .honk: 320.0
            .cry: 220.0
            .bell: 110.0
            .quack: 200.0
            .kowk: 150.0
            .blow: 120.0
            .plash: 90.0
            _: 160.0
        wl.calls_made += 1
        ambience_event(scene, AmbienceSource(9500000 + c.key % 400000, kind, c.pos, c.loud * WILD_VOICE_GAIN, reach), wl.calls_made, scene.sound.last_time, listener, 0.08)
    clear(wl.calls)
