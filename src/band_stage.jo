# The Hotel Ancora's band on its stand, as the world has it (src/band_life.jo): the numbers of the
# set published to the world (who plays each, their places on the stand and the steps up to them),
# and the players drawn there: stepping up and walking to their place, picking up the instrument,
# playing when the number has begun, and after their last number putting it down where it lives on
# the stand (or closing the piano), walking back to the step and down. Off the stand they are the
# town's (src/townsfolk.jo), walking, sitting at the band's table, going home.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'folk.jo'
use 'life_types.jo'
use 'music_data.jo'
use 'music_synth.jo'
use 'musician_pose.jo'
use 'bar_scene.jo'
use 'look_outline.jo'
use 'bar_band.jo'
use 'band_roster.jo'

# Where each role steps up, along the stand's front edge (toward the terrace's tables): metres
# across the stand from its middle. (Apart, so those waiting there don't crowd each other.)
STEP_ACROSS = [0.0, -1.5, 0.8, 1.6]

# The set as the world knows it.
# (always the terrace's stand as built: when the band plays in the bar room, it is drawn there)
band_numbers = (hotel: HotelScene) -> BandNumber[]:
    h = hotel_as_built(hotel)
    out: BandNumber[]
    loop k in 0..BAR_SET.len():
        sp = BAR_SET[k]
        n = BandNumber(int(f64(MUSIC_PIECES[sp.piece].frames) / f64(MUSIC_RATE) * 60.0), [])
        n.nights = sp.nights
        n.spots = fill(h.stage, 4); n.steps = fill(h.stage, 4); n.yaws = fill(0.0, 4)
        loop s in band_spots(h, sp.lineup, sp.sung.len() > 0):
            if s.instrument < 0: continue
            n.roles.push(s.who)
            n.spots[s.who] = s.pos; n.yaws[s.who] = s.yaw
            n.steps[s.who] = band_stand_world(h, STAND_HALF_OUT + 0.35, STEP_ACROSS[s.who], 0.0)
        out.push(n)
    out

# Where instruments rest on the stand when no one holds them: a row along its back (local metres:
# along the shore, across), and how each lies.
_rest_at = (h: HotelScene, instrument: int) -> mat4:
    at = (a: f64, c: f64, lift: f64) -> mat4: translation(band_stand_world(h, a, c, STAND_HEIGHT + lift))
    yaw = atan2(f64(h.stage_out.x), f64(h.stage_out.z))
    match instrument:
        0: at(-1.75, 0.3, 0.03) * rotation_y(yaw) * rotation_x(0.0)
        7: at(-1.85, 0.9, 0.48) * rotation_y(yaw + PI * 0.5) * rotation_z(1.25)
        8: at(-1.75, 1.5, 0.05) * rotation_y(yaw) * rotation_x(-PI * 0.5)
        9: at(-1.7, 2.1, 0.18) * rotation_y(yaw)
        4: at(-1.75, 2.6, 0.02) * rotation_y(yaw) * rotation_z(PI * 0.5)
        13: at(-1.95, -0.3, 0.0) * rotation_y(yaw + PI) * rotation_x(-0.12)
        _: at(-1.75, 0.3, 0.05)

_rest_mesh = (k: InstrumentKit, instrument: int) -> Mesh:
    match instrument:
        0: k.violin
        7: k.guitar
        8: k.mandolin
        9: k.box_right
        4: k.clarinet
        _: k.bass

# A player's state on the stand, for drawing.
struct StagePlayer:
    person: int
    role: int
    number: int                     # (whose place)
    up = -1                         # the tick they stepped up (called)
    down = -1                       # the tick they are down (putting away; -1: not)

stage_players = (b: BandState) -> StagePlayer[]:
    out: StagePlayer[]
    number = if b.index >= 0: b.index else: b.last
    loop k in 0..b.called.len():
        if b.up[k] >= 0 and number >= 0: out.push(StagePlayer(b.called[k], b.roles[k], number, b.up[k]))
    loop k in 0..b.packing.len():
        out.push(StagePlayer(b.packing[k], b.packing_role[k], b.packing_number[k], -1, b.packing_until[k]))
    out

# A walk from a to b, from the deck up onto the stand (or down, `up` false), u 0..1: the place,
# raised by the step over the first (last) quarter.
_stage_walk = (a: vec3, b: vec3, u: f64, up: bool) -> vec3:
    p = lerp(a, b, f32(u * u * (3.0 - 2.0 * u)))
    lift = if up: smoothstep(0.0, 0.25, u) else: 1.0 - smoothstep(0.75, 1.0, u)
    p + vec3(0, f32(STAND_HEIGHT * lift), 0)

# The players on the stand: `figs` each role's player's own figure (`has` false where they aren't
# in the town to draw), `tick` the world's, `ms` seconds into the number heard (perf's).
draw_band_people = (h: HotelScene, b: Band, band: BandState, tick: int, figs: Figure[], has: bool[], perf: Performance, L: Light, t: f64):
    if not h.ok or band.numbers.len() == 0 or length(h.stage - scene_camera()) > 160.0: return
    near = length(h.stage - scene_camera()) < 40.0
    held: int[]
    piano_open = false
    playing = band_playing(band, tick)
    loop sp in stage_players(band):
        if sp.role < 0 or sp.role >= figs.len() or not has[sp.role]: continue
        number = band.numbers[sp.number]
        # (the world has them at the terrace's stand: in the bar room, the same walk there)
        shift = h.stage - h.built.stage
        step = number.steps[sp.role] + shift; place = number.spots[sp.role] + shift
        fig = figs[sp.role]
        spot: BandSpot? = none
        loop s in band_spots(h, BAR_SET[sp.number].lineup, BAR_SET[sp.number].sung.len() > 0):
            if s.who == sp.role and s.instrument >= 0: spot = s
        if spot == none: continue
        s = spot!
        if sp.down < 0:
            age = tick - sp.up
            if age < BAND_CLIMB:
                # up the step and across to the place
                u = f64(age) / f64(BAND_CLIMB)
                pos = _stage_walk(step, place, u, true)
                dir = place - step
                draw_figure(fig, pos, atan2(f64(dir.x), f64(dir.z)), f64(age) / 60.0 * 7.5, 0.7, L, t)
                continue
            # in place: the instrument picked up, ready, and playing once the number has begun
            held.push(s.instrument)
            if s.instrument == 6: piano_open = true
            ms = if playing and sp.number == band.index: perf.seconds else: -100.0
            draw_band_player(b, s, fig, perf, ms, L, t)
        else:
            left = sp.down - tick
            if left > BAND_PACK / 2:
                # putting it down where it lives (the piano closed): standing at the place
                yaw = s.yaw
                if s.instrument == 6: yaw = s.yaw + PI * 0.5
                draw_figure(fig, place, yaw, 0.0, 0.0, L, t)
            else:
                # back to the step and down
                u = 1.0 - f64(max(left, 0)) / f64(BAND_PACK / 2)
                pos = _stage_walk(place, step, u, false)
                dir = step - place
                draw_figure(fig, pos, atan2(f64(dir.x), f64(dir.z)), f64(left) / 60.0 * 7.5, 0.7, L, t)
    # the instruments no one holds, where they live on the stand; the piano's lid
    if near:
        loop instrument in [0, 7, 8, 9, 4, 13]:
            if instrument in held: continue
            at = _rest_at(h, instrument)
            if instrument == 9:
                # (the accordion shut: its two ends and the bellows folded between)
                draw(obj_sh, b.kit.box_right, obj_params(L, t, at * translation(vec3(0.09, 0, 0))))
                draw(obj_sh, b.kit.bellows, obj_params(L, t, at * scaling(vec3(0.1, 1, 1))))
                draw(obj_sh, b.kit.box_left, obj_params(L, t, at * translation(vec3(-0.085, 0, 0))))
            else: draw(obj_sh, _rest_mesh(b.kit, instrument), obj_params(L, t, at))
        if length(h.stage - scene_camera()) < 25.0:
            draw(obj_sh, b.kit.keys, obj_params(L, t, band_keys_at(h)))
        if not piano_open: draw(obj_sh, b.kit.lid, obj_params(L, t, band_keys_at(h)))

# ---------------- the tip jar ----------------

# Where the band's tip jar stands: on the stand's front corner, by the steps; on the piano when the
# band plays in the bar room (src/bar_room.jo).
band_jar_at = (h: HotelScene) -> vec3:
    if f64(length(h.stage - h.built.stage)) > 0.5: return h.stage + h.stage_out * f32(-1.6) + h.table_z * f32(-0.85) + vec3(0, 1.3, 0)
    band_stand_world(h, STAND_HALF_OUT - 0.3, 2.35, STAND_HEIGHT)

# A glass jar (its base, a rim and the light on its side: the coins seen inside) holding what has
# gone in this evening, in order: copper, silver and brass coins heaped from the bottom, notes
# folded and standing up among them. (At most JAR_SHOWN pieces: by then it looks full.)
const JAR_SHOWN = 64
build_tip_jar = (pieces: int[]) -> Mesh:
    vs: Vertex3D[]
    glass = rgb(0.66, 0.74, 0.74)
    r = 0.075; tall = 0.19
    # (a thick glass foot, a lip at the mouth, and the side as fine panes catching the light, the
    # coins seen between them; a paper label on its front)
    add_cylinder(vs, vec3(0, 0, 0), r + 0.004, 0.016, rgb(0.58, 0.66, 0.66), 14)
    loop k in 0..18:
        a = f64(k) * TAU / 18.0
        add_box(vs, vec3(0, 0, 0), vec3(0.03, 0.014, 0.012), glass, translation(vec3(f32(sin(a) * (r + 0.004)), f32(tall), f32(cos(a) * (r + 0.004)))) * rotation_y(a))
    # (glass can't be seen through here: its far half is drawn as pale glass behind the coins,
    # its near half left open but for two glints, so from the room the coins sit in a jar)
    loop k in 0..16:
        a = f64(k) * TAU / 16.0
        if cos(a) > -0.15: continue
        tone = if k % 4 == 1: rgb(0.86, 0.92, 0.92) else: rgb(0.62, 0.71, 0.72)
        add_box(vs, vec3(0, 0, 0), vec3(0.031, f32(tall - 0.016), 0.003), tone, translation(vec3(f32(sin(a) * r), f32(0.016 + (tall - 0.016) * 0.5), f32(cos(a) * r))) * rotation_y(a))
    loop a in [-0.75, 0.55]:
        add_box(vs, vec3(0, 0, 0), vec3(0.006, f32(tall - 0.05), 0.002), rgb(0.92, 0.96, 0.96), translation(vec3(f32(sin(a) * r), f32(0.03 + (tall - 0.05) * 0.5), f32(cos(a) * r))) * rotation_y(a))
    n = min(pieces.len(), JAR_SHOWN)
    loop i in 0..n:
        cents = pieces[i]
        layer = i / 7
        a = f64(i) * 2.39996
        rr = (r - 0.022) * sqrt(f64((i * 37) % 7 + 1) / 7.0)
        y = 0.014 + f64(layer) * 0.009 + f64((i * 13) % 3) * 0.001
        at = vec3(f32(sin(a) * rr), f32(y), f32(cos(a) * rr))
        if cents >= 100:
            # (a note, folded, standing up)
            add_box(vs, vec3(0, 0.03, 0), vec3(0.05, 0.06, 0.003), rgb(0.62, 0.68, 0.56), translation(at) * rotation_y(a) * rotation_z(0.35))
        else:
            col = if cents <= 10: rgb(0.6, 0.36, 0.2) else: if cents <= 20: rgb(0.74, 0.74, 0.72) else: rgb(0.78, 0.62, 0.3)
            add_cylinder(vs, at, 0.016, 0.004, col, 7, -1.0, translation(at) * rotation_x(f64((i * 7) % 5 - 2) * 0.2) * translation(-at))
    custom_mesh(vs)

struct TipJarView:
    count = -1
    mesh: Mesh? = none
tip_jar_view = TipJarView()

# The jar, while the band's evening is on (`shown`), with this evening's coins and notes in it.
draw_tip_jar = (h: HotelScene, band: BandState, shown: bool, L: Light, t: f64):
    global tip_jar_view
    if not h.ok or not shown: return
    at = band_jar_at(h)
    if f64(length(at - scene_camera())) > 45.0: return
    n = min(band.jar_pieces.len(), JAR_SHOWN)
    if tip_jar_view.count != n or tip_jar_view.mesh == none:
        tip_jar_view = TipJarView(n, build_tip_jar(band.jar_pieces))
    # (its label toward those listening)
    if let m = tip_jar_view.mesh:
        p = obj_params(L, t, translation(at) * rotation_y(atan2(f64(h.stage_out.x), f64(h.stage_out.z))))
        draw(obj_sh, m, p)
        # (looked at: taken for the look's highlight)
        look_capture(look_on(.tip_jar))
        look_take(m, p.model)
        look_capture(false)

# Who thanks a tipper, and from where: the player on the stand nearest its front (their head, in
# the world), between numbers; none while a number plays or nobody is up.
band_thanks_from = (h: HotelScene, band: BandState, tick: int) -> (int, vec3)?:
    if not h.ok or band.numbers.len() == 0 or band_playing(band, tick): return none
    best = -1; at = vec3(0, 0, 0); front = -1e9
    loop sp in stage_players(band):
        if sp.down >= 0 or sp.up < 0 or tick < sp.up + BAND_CLIMB: continue
        loop s in band_spots(h, BAR_SET[sp.number].lineup, BAR_SET[sp.number].sung.len() > 0):
            if s.who != sp.role or s.instrument < 0: continue
            out = f64(dot(s.pos - h.stage, h.stage_out))
            if out > front: front = out; best = sp.person; at = s.pos + vec3(0, f32(if s.seated: 1.45 else: 1.85), 0)
    if best < 0: return none
    (best, at)
