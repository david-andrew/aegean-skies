# A night under a roof: a room at the hotel, or the spare room of a family grateful to the pilot,
# as places one is in rather than a card while time passes. The hotel's room upstairs looks out
# over the harbour through its French window; one sleeps, rests, naps or looks out, and leaves by
# the door. At a family's house there is supper with the household in the evening (the host and
# those they look after, real people of the living world), the bed in the room at the back, and
# coffee in the morning before one goes. The hotel's room is paid at the desk (src/leisure.jo); the
# family takes nothing. Nothing is needed: a stay is for its own sake. Pure: the game draws the
# rooms and the people, and passes the time.

enum StayKind: hotel, family
enum StayStage: awake, supper, window, asleep, morning

struct Stay:
    active = false
    kind: StayKind = .hotel
    stage: StayStage = .awake
    host = -1                       # the family's host (a living-world person); the hotel: its keeper
    place = -1
    frame: mat4 = mat4()            # the room's frame in the world (its floor's middle; +z the window)
    household: int[]                # (household residents at the table: those the host looks after)
    had_supper = false
    started = 0                     # (the world minute one came in)
    slept = false
    speaker = -2                    # (who spoke last: -1 the host, k a resident at the table, -2 none)
    line = ""
    line_until = 0.0
    next_line = 0.0
    lines_said = 0

# ---------------- the rooms ----------------
# Room-local: the floor's middle at 0, +z toward the window (the hotel's) or the back room (the
# family's), +x to the right as one faces it, y up.

struct Seat:
    at: vec3
    yaw: f64                        # (facing, room-local: 0 toward +z)

# The hotel's room: a bed along the left wall, a washstand and a chair by the window.
HOTEL_BED: vec3 = vec3(-1.05, 0.5, -0.25)       # (the mattress's middle; the head toward -z)
HOTEL_CHAIR = Seat(vec3(1.15, 0.0, 1.15), PI * 0.82)
HOTEL_WINDOW: vec3 = vec3(0.0, 0.0, 1.95)       # (the French window's foot, in the sea wall)
HOTEL_EYE: vec3 = vec3(1.6, 1.95, -1.82)
HOTEL_LOOK: vec3 = vec3(-0.45, 0.68, 0.65)
HOTEL_AT_WINDOW: vec3 = vec3(0.42, 0.0, 1.45)     # (the pilot at the window, a little to its right)
HOTEL_WINDOW_EYE: vec3 = vec3(-0.6, 1.72, 0.35)

# The family's house: the kitchen with its table, and the room at the back under a low beam.
FAMILY_TABLE: vec3 = vec3(0.0, 0.0, -0.7)
FAMILY_SEATS: Seat[] = [
    Seat(vec3(0.0, 0.0, -1.35), 0.0),           # (the pilot's: the guest's place, facing the room)
    Seat(vec3(0.0, 0.0, -0.05), PI),             # (the host's, across)
    Seat(vec3(-0.95, 0.0, -0.7), PI * 0.5),
    Seat(vec3(0.95, 0.0, -0.7), -PI * 0.5),
    Seat(vec3(-0.5, 0.0, -0.05), PI),
    Seat(vec3(0.5, 0.0, -0.05), PI)]
FAMILY_BED: vec3 = vec3(0.55, 0.45, 1.45)        # (along x, the head toward +x)
FAMILY_BEAM: vec3 = vec3(0.0, 1.88, 0.8)
FAMILY_EYE: vec3 = vec3(1.75, 1.7, -1.85)
FAMILY_LOOK: vec3 = vec3(-0.05, 0.75, -0.4)
FAMILY_BED_EYE: vec3 = vec3(0.05, 1.72, -0.6)
FAMILY_BED_LOOK: vec3 = vec3(0.6, 0.42, 1.45)

# ---------------- when ----------------

stay_supper_time = (clock: int) -> bool: clock >= 1080 and clock < 1290      # 18:00 to 21:30
stay_morning_time = (clock: int) -> bool: clock >= 330 and clock < 690       # 05:30 to 11:30

# Who sits down to supper: those the host looks after (their own household's residents), as many
# as the table has room for beside the host and the pilot.
stay_household = (guardians: int[], ids: int[], host: int) -> int[]:
    out: int[]
    loop k in 0..ids.len():
        if guardians[k] == host and out.len() < FAMILY_SEATS.len() - 2: out.push(ids[k])
    out

# ---------------- what is said ----------------
# The host's own talk comes from the game's dialogue (their day, the weather); these are the
# ordinary words of a meal at home, said between.

HOST_SUPPER_LINES = ["Eat, eat. There's more in the pot.", "Pass the bread down, would you?",
    "Don't mind the children, they've never had a pilot at the table.", "Another glass? It's our own.",
    "Leave something for tomorrow, you two.", "The room at the back is ready whenever you are."]
HOST_MORNING_LINES = ["Slept well? The shutters didn't keep you up?", "Coffee's on. Sit, sit.",
    "You'll come back when you're passing.", "Mind how you go."]
CHILD_LINES = ["Have you ever flown over our house?", "Is it cold up there?", "Can I see your aeroplane after?",
    "Mama says I mustn't ask you things.", "How high can you go?", "Did you see any dolphins?"]

# The next speaker, in turn: the host most often, now and then one of the children.
stay_next_speaker = (s: Stay, children: int) -> int:
    if children <= 0: return -1
    if s.lines_said % 3 == 2: return (s.lines_said / 3) % children
    -1

# A line of hospitality (the host, at supper or in the morning) or a child's, picked in turn.
stay_line = (s: Stay, speaker: int, morning: bool) -> str:
    n = s.lines_said
    if speaker >= 0: return CHILD_LINES[(n + speaker * 3) % CHILD_LINES.len()]
    lines = if morning: HOST_MORNING_LINES else: HOST_SUPPER_LINES
    lines[(n / 2) % lines.len()]

# A remark due: the next comes some seconds after the last, a little longer as the meal settles.
stay_line_due = (s: Stay, now: f64) -> bool: (s.stage == .supper or s.stage == .morning) and now >= s.next_line

stay_said = (s: mut Stay, speaker: int, line: str, now: f64):
    s.speaker = speaker; s.line = line; s.line_until = now + 5.5
    s.lines_said += 1
    s.next_line = now + 6.5 + f64(s.lines_said % 3) * 1.5

# The notebook's line for a stay, as it ends.
stay_note = (s: Stay, host_name: str, town: str, keeper_place: str) -> str:
    if s.kind == .hotel: return if s.slept: "Slept in a room upstairs at the {keeper_place}, the shutters open on the harbour." else: "Rested a while in a room upstairs at the {keeper_place}."
    first = host_name
    with_meal = if s.had_supper: " Supper with the family round the table." else: ""
    if s.slept: "Stayed the night at {first}'s in {town}.{with_meal}" else: "Rested at {first}'s in {town}.{with_meal}"
