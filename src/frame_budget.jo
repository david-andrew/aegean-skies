# Drop old wall time after a hitch. All owners see the same accepted interval; the live
# game slows briefly rather than doing ever more work to repay a slow frame.
const FRAME_TICKS = 3
const FIXED_DT = 1.0/60.0
const FRAME_DT = f64(FRAME_TICKS)*FIXED_DT
frame_dt = (elapsed: f64) -> f64: if is_finite(elapsed): clamp(elapsed,0.0,FRAME_DT) else: 0.0
frame_spare = (spare: f64,elapsed: f64) -> f64: min(max(spare,0.0)+frame_dt(elapsed),FRAME_DT)

# Exact underdamped spring toward a fixed target for this sample. Unlike Euler integration,
# a 250ms or multi-second hitch cannot inject energy into its velocity state.
spring_vector = (position: vec3, velocity: vec3, target: vec3, frequency: f64, damping: f64, dt: f64) -> (vec3,vec3):
    if dt <= 0 or not is_finite(dt): return (position,velocity)
    w=frequency; z=damping; wd=w*sqrt(1.0-z*z)
    e=f32(exp(-w*z*dt)); c=f32(cos(wd*dt)); s=f32(sin(wd*dt)); offset=position-target
    p=target+(offset*c+(velocity+offset*f32(w*z))*f32(1.0/wd)*s)*e
    v=(velocity*c-(velocity*f32(w*z)+offset*f32(w*w))*f32(1.0/wd)*s)*e
    (p,v)
