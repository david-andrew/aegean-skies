# Small stories are journals of actual relationships, debts, journeys and owned-cargo outcomes.
# This module never issues money/goods or forces a successful ending to fill a quiet day.
use 'living_types.jo'
use 'life_types.jo'
use 'living_life_seed.jo'
use 'living_events.jo'
use 'living_jobs.jo'
use 'living_money.jo'

new_life_story = (w: mut World, kind: LifeStoryKind, actors: int[], place: int) -> int:
    id = w.next_story; w.next_story += 1
    w.stories[id] = LifeStory(id,kind,actors,place,since_minute=w.minute,changed_minute=w.minute,next_check_minute=w.minute)
    id

stories_minute = (w: mut World):
    if w.minute%15 != 0: return
    initialize_life(w)
    # An actual paid local errand is a household's small unfinished business.
    loop job in w.active_jobs:
        j = w.jobs[job]
        if j.delivery_mode != .foot or (j.state != .open and j.state != .claimed): continue
        exists = false
        loop _, story in w.stories:
            if story.job == job: exists = true
        if not exists:
            id = new_life_story(w,.household,[j.poster],j.origin)
            w.stories[id].job = job
    # A repeated breach or real grievance can grow into a feud; an arbitrary pair cannot.
    loop r in w.relationships:
        breaches = 0
        loop memory in r.memories:
            if memory.kind == .late or memory.kind == .defaulted: breaches += 1
        if breaches < 2 and r.grievance < 100: continue
        if w.people[r.observer].home != w.people[r.other].home: continue
        exists = false
        loop _, story in w.stories:
            if story.kind == .feud and not story.resolved and (r.observer in story.actors) and (r.other in story.actors): exists = true
        if not exists:
            id = new_life_story(w,.feud,[r.observer,r.other],w.people[r.observer].home)
            if r.memories.len()>0: w.stories[id].evidence_event = r.memories[0].event
    # Boat concern follows an overdue real working boat. It is not a secretly scripted wreck.
    loop trip in w.active_trips:
        t = w.trips[trip]
        if t.mode != .boat or t.reason.purpose != .fishing or t.state == .arrived or t.state == .failed or w.tick <= t.eta_tick+7200: continue
        exists = false
        loop _, story in w.stories:
            if story.kind == .missing_boat and story.actors[0] == t.actor and not story.resolved: exists = true
        if not exists:
            watcher = w.places[t.origin].market_owner
            id = new_life_story(w,.missing_boat,[t.actor,watcher],t.origin)
            w.stories[id].outcome = "The boat is overdue; nobody here has a confirmed account of why."
    ids = w.stories.keys(); ids.sort()
    loop id in ids:
        s = w.stories[id]
        if s.resolved or w.minute<s.next_check_minute: continue
        w.stories[id].next_check_minute = w.minute+15
        old_stage = s.stage
        match s.kind:
            .courtship:
                a = s.actors[0]; b = s.actors[1]
                together = false
                loop meeting_id in w.active_meetings:
                    meeting = w.meetings[meeting_id]
                    if meeting.active and (a in meeting.people) and (b in meeting.people) and (meeting.venue == .cafe or meeting.venue == .square): together = true
                if together and s.last_meeting_day != day_index(w.minute):
                    w.stories[id].meetings += 1; w.stories[id].last_meeting_day = day_index(w.minute)
                relation = w.relationship_index.get(RelationshipKey(a,b),-1)
                reverse = w.relationship_index.get(RelationshipKey(b,a),-1)
                if relation >= 0 and reverse >= 0:
                    mutual = min(w.relationships[relation].affinity,w.relationships[reverse].affinity)
                    if w.relationships[relation].grievance > 250 or w.relationships[reverse].grievance > 250:
                        w.stories[id].stage = -1; w.stories[id].resolved = true
                        w.stories[id].outcome = "There is too much unsettled between them for easy company."
                    else if w.stories[id].meetings >= 5 and mutual >= 200:
                        w.stories[id].stage = 3; w.stories[id].resolved = true
                        w.stories[id].outcome = "They have made a habit of finding time for one another."
                    else if w.stories[id].meetings >= 3 and mutual >= 100:
                        w.stories[id].stage = 2; w.stories[id].outcome = "They have been choosing the same company on several evenings."
                        # A modest gesture must be bought from existing stock, with real carriage pay.
                        if s.job < 0 and w.people[a].place == s.place and w.people[b].home == s.place and w.accounts[w.people[a].account].cents >= 2000:
                            home = choose_life_venue(w,s.place,.home,b)
                            if home != none:
                                job = post_job(w,a,s.place,.commodity,1,100,80,w.minute+600,delivery_mode=.foot,dropoff=home!.pos)
                                if job >= 0:
                                    w.jobs[job].drop_holder = b; w.jobs[job].cause.beneficiary = b
                                    w.jobs[job].context = "Would you take this bottle of wine to {w.people[b].name}'s door? Say who sent it, if they ask."
                                    w.jobs[job].provenance.cause="After {w.stories[id].meetings} actual evenings together, {w.people[a].name} bought this existing wine as a gift for {w.people[b].name}, and paid for carriage to their door."
                                    w.stories[id].job = job
                        if s.job >= 0 and s.job in w.jobs and w.jobs[s.job].state == .delivered:
                            w.stories[id].stage = 3; w.stories[id].resolved = true
                            w.stories[id].outcome = "A small gift reached its door after several evenings of company."
                            w.relationships[reverse].affinity = min(1000,w.relationships[reverse].affinity+30)
                    else if w.stories[id].meetings > 0: w.stories[id].stage = 1; w.stories[id].outcome = "They found a quiet conversation together."
            .feud:
                a = s.actors[0]; b = s.actors[1]
                relation = w.relationship_index.get(RelationshipKey(a,b),-1)
                if relation >= 0:
                    r = w.relationships[relation]
                    reverse = w.relationship_index.get(RelationshipKey(b,a),-1)
                    settled = r.grievance <= 50 and r.trust >= 550 and r.affinity >= 0
                    if reverse >= 0:
                        other = w.relationships[reverse]
                        settled = settled and other.grievance <= 50 and other.trust >= 550 and other.affinity >= 0
                    if settled:
                        w.stories[id].stage = 2; w.stories[id].resolved = true
                        w.stories[id].outcome = "The quarrel has cooled after better dealings."
                    else:
                        w.stories[id].stage = 1
                        w.stories[id].outcome = "They have not put their differences behind them."
            .missing_boat:
                actor = s.actors[0]
                watcher = s.actors[1]
                known_return = w.people[actor].place == s.place and w.people[watcher].place == s.place and length(w.people[actor].pose.pos-w.people[watcher].pose.pos) <= 60
                loop news in w.people[watcher].news:
                    if news.reason.actor == actor and news.occurred_minute >= s.since_minute and (news.kind == .arrived or news.kind == .rescue): known_return = true
                if known_return:
                    w.stories[id].stage = 2; w.stories[id].resolved = true
                    w.stories[id].outcome = "The missing person is ashore again."

            .debt:
                if s.obligation in w.obligations:
                    o = w.obligations[s.obligation]
                    if o.amount_cents == 0:
                        w.stories[id].stage = 2; w.stories[id].resolved = true
                        w.stories[id].outcome = "The bill has finally been settled."
                    else if o.state == .defaulted:
                        w.stories[id].stage = -1; w.stories[id].resolved = true
                        w.stories[id].outcome = "The unpaid bill has become a breach of trust."
                    else if o.paid_cents > 0:
                        w.stories[id].stage = 1; w.stories[id].outcome = "Some of the debt is paid; the rest still stands between them."
            .household:
                if s.job in w.jobs:
                    j = w.jobs[s.job]
                    if j.state == .delivered:
                        w.stories[id].stage = 2; w.stories[id].resolved = true
                        w.stories[id].outcome = "The household's goods reached the promised place."
                    else if j.state == .failed or j.state == .expired or j.state == .cancelled:
                        w.stories[id].stage = -1; w.stories[id].resolved = true
                        w.stories[id].outcome = "The errand fell through; the goods still have their owner."
                    else if j.state == .claimed: w.stories[id].stage = 1; w.stories[id].outcome = "Someone has agreed to carry the household's goods."
        if old_stage != w.stories[id].stage: w.stories[id].changed_minute = w.minute
    # Keep live situations plus a week of outcomes; referenced jobs stay pinned in normal pruning.
    if local_minute(w.minute)<15:
        remove: int[]
        loop id, s in w.stories:
            if s.resolved and w.minute-s.changed_minute>10080: remove.push(id)
        loop id in remove: w.stories.remove(id)

# Notebook/UI projection. A participant can speak from their own experience; other people need
# carried public news. This is not a global gossip lookup for a bystander's conversation.
life_story_lines = (w: World, person: int) -> str[]:
    result: str[]; ids = w.stories.keys(); ids.sort()
    loop id in ids:
        s = w.stories[id]
        if (person in s.actors) and s.outcome != "": result.push(s.outcome)
    result
