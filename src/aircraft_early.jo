# The early aircraft, 1912-1926: the pioneer Donnet-Lévêque flying boat, three single-seat pusher
# flying-boat fighters (Macchi M.5 and M.7, Hansa-Brandenburg CC) and a landplane, the Fiat C.R.20. Built from the kit in planes.jo, in the
# same frame (forward -z, right +x, up +y, metres, the origin near the CG) and the same seven
# damage bins: 0 hull/fuselage, 1 engine, 2/3 left/right wings, 4/5 tip floats (the C.R.20's
# wheels), 6 tail. Sizes follow aircraft_catalog.jo, whose profile also places the contacts.
use 'planes.jo'
use 'aircraft_catalog.jo'

is_early_craft = (kind: Craft) -> bool:
    kind == .macchi_m5 or kind == .hansa_cc or kind == .macchi_m7 or kind == .fiat_cr20 or kind == .donnet_leveque

# The C.R.20's wheels and tail skid, a little inside the tyres so the sprung contact settles them on
# the ground (flight.jo's landplane gear is stiff: about 7 cm under the weight).
landplane_gear_contacts = (kind: Craft) -> vec3[]:
    if kind != .fiat_cr20: return []
    [vec3(-0.85, -1.53, -1.2), vec3(0.85, -1.53, -1.2), vec3(0, -0.41, 3.12)]

_etri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    vs.push(Vertex3D(a, n, vec2(0, 0), col)); vs.push(Vertex3D(b, n, vec2(0, 0), col)); vs.push(Vertex3D(c, n, vec2(0, 0), col))

_shade = (vs: vec4, k: f64) -> vec4: vec4(vs.x * f32(k), vs.y * f32(k), vs.z * f32(k), vs.w)

# A wooden single-step hull, in units of the profile's half width w and length l. The keel, chines
# and aft keel meet catalog_contacts' points (keel -1.3w from 0.36l forward to the step at 0.04l,
# chines -1.05w, the aft bottom -0.5w at 0.32l). `fine` sharpens the bow (M.7), `deep` raises the
# sides (CC). The aft body from 0.3l is the tail's.
_early_hull = (bins: mut Vertex3D[][], p: AircraftProfile, lv: Livery, fine: f64, deep: f64):
    w = f32(p.width); l = f32(p.length); d = f32(deep)
    under = _shade(lv.body, 0.55)
    s = (z: f64, width: f64, top: f64, bottom: f64, keel: f64) -> Section: Section(l * f32(z), w * f32(width), w * f32(top) * d, w * f32(bottom), w * f32(keel))
    fore = [s(-0.5, 0.12, 0.7, 0.1, 0.0), s(-0.46 + fine * 0.02, 0.5 - fine * 0.15, 0.88, 0.45, 0.15), s(-0.4, 0.82, 0.96, 0.82, 0.26),
        s(-0.3, 0.98, 1.0, 1.02, 0.28), s(-0.12, 1.0, 1.0, 1.05, 0.25), s(0.04, 1.0, 0.98, 1.05, 0.25),
        s(0.05, 0.92, 0.96, 0.62, 0.12), s(0.18, 0.66, 0.92, 0.52, 0.07), s(0.3, 0.45, 0.94, 0.46, 0.05)]
    aft = [s(0.3, 0.45, 0.94, 0.46, 0.05), s(0.42, 0.24, 1.0, 0.1, 0.0), s(0.5, 0.07, 1.12, -0.42, 0.0)]
    loft(bins[0], fore, vec3(0, 0, 0), lv.body, under)
    loft(bins[6], aft, vec3(0, 0, 0), lv.body, under)
    # Spray strakes along the chines and a sheer rubbing strip, darker than the planking.
    loop side in [-1.0, 1.0]:
        kit_strut(bins[0], vec3(side * p.width * 0.98, -p.width * 0.5, -p.length * 0.36), vec3(side * p.width * 1.0, -p.width * 0.5, p.length * 0.04), 0.03, under)
        kit_strut(bins[0], vec3(side * p.width * 0.96, p.width * deep * 0.47, -p.length * 0.38), vec3(side * p.width * 0.66, p.width * deep * 0.45, p.length * 0.2), 0.022, lv.trim)

# A pusher inline: crankcase, six cylinders, a radiator ahead of it (it faces the air), exhaust,
# bearers down to the hull and up to the upper wing's centre section. The hub is the profile's.
_pusher_engine = (vs: mut Vertex3D[], p: AircraftProfile, lv: Livery, wing_y: f64, big: bool):
    metal = rgb(0.36, 0.36, 0.34); dark = rgb(0.16, 0.15, 0.14); steel = rgb(0.55, 0.55, 0.53)
    c = vec3(0, p.engine_y, p.engine_z)
    len = if big: 0.62 else: 0.55
    kit_box(vs, c, vec3(0.17, 0.2, f32(len)), metal)
    loop j in 0..6:
        z = p.engine_z - len * 0.8 + f64(j) * len * 0.32
        kit_box(vs, vec3(0, f32(p.engine_y + 0.29), f32(z)), vec3(0.12, 0.1, 0.075), steel)
        kit_strut(vs, vec3(0.12, f32(p.engine_y + 0.33), f32(z)), vec3(0.3, f32(p.engine_y + 0.4), f32(z + 0.06)), 0.025, dark)
    kit_strut(vs, vec3(0.3, f32(p.engine_y + 0.4), f32(p.engine_z - len * 0.8)), vec3(0.3, f32(p.engine_y + 0.42), f32(p.engine_z + len)), 0.04, dark)
    # (the radiator: a deep honeycomb block in a painted frame, standing in the airstream)
    rz = p.engine_z - len - 0.12
    kit_box(vs, vec3(0, f32(p.engine_y + 0.12), f32(rz)), vec3(0.3, 0.36, 0.09), rgb(0.2, 0.22, 0.21))
    loop k in 0..4: kit_box(vs, vec3(0, f32(p.engine_y - 0.18 + f64(k) * 0.2), f32(rz - 0.095)), vec3(0.31, 0.012, 0.012), rgb(0.42, 0.42, 0.4))
    kit_box(vs, vec3(0, f32(p.engine_y + 0.5), f32(rz)), vec3(0.33, 0.03, 0.11), lv.trim)
    kit_box(vs, vec3(0, f32(p.engine_y - 0.26), f32(rz)), vec3(0.33, 0.03, 0.11), lv.trim)
    hub = vec3(0, p.engine_y, p.engine_z + 0.65)
    kit_strut(vs, c + vec3(0, 0, f32(len)), hub, 0.06, metal)
    kit_spinner(vs, hub, 0.12, lv.accent, true)
    loop side in [-1.0, 1.0]:
        loop dz in [-len * 0.7, len * 0.7]:
            kit_strut(vs, vec3(f32(side * p.width * 0.55), f32(p.width * 0.95), f32(p.engine_z + dz - 0.15)), vec3(f32(side * 0.15), f32(p.engine_y - 0.2), f32(p.engine_z + dz)), 0.04, metal)
            kit_strut(vs, vec3(f32(side * 0.15), f32(p.engine_y + 0.2), f32(p.engine_z + dz)), vec3(f32(side * 0.35), f32(wing_y - 0.02), f32(p.engine_z + dz - 0.1)), 0.035, metal)

# Two fixed Vickers ahead of the windscreen (bow guns on the boats, over the cowling on the C.R.20).
_vickers = (vs: mut Vertex3D[], y: f64, z: f64, apart: f64):
    dark = rgb(0.13, 0.13, 0.12)
    loop side in [-1.0, 1.0]:
        kit_box(vs, vec3(f32(side * apart), f32(y + 0.07), f32(z)), vec3(0.055, 0.07, 0.32), dark)
        kit_strut(vs, vec3(f32(side * apart), f32(y + 0.09), f32(z - 0.3)), vec3(f32(side * apart), f32(y + 0.09), f32(z - 0.62)), 0.03, dark)

# One wing panel through the kit, split left/right into bins 2/3, with its roundels if upper.
_wing = (bins: mut Vertex3D[][], kind: Craft, lv: Livery, c: vec3, span: f64, chord: f64, taper: f64, marks: bool):
    wing: Vertex3D[]
    kit_fabric_wing(wing, c, span, chord, taper, lv)
    kit_split_wings(bins, wing, kind)
    if marks:
        loop side in [-1.0, 1.0]: kit_wing_mark(bins[if side < 0: 2 else: 3], vec3(f32(side * span * 0.29), c.y + 0.205, c.z), lv, min(0.45, chord * 0.25))

# Tip floats under the lower wing: two struts each, a small stepped float. Bins 4/5.
_tip_floats = (bins: mut Vertex3D[][], p: AircraftProfile, lv: Livery, lower_y: f64, wood: vec4):
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        c = vec3(f32(side * p.float_x), f32(p.float_y), -0.6)
        kit_float(bins[id], c, 1.15, 0.17, lv.body, _shade(lv.body, 0.55))
        loop dz in [-0.3, 0.25]: kit_strut(bins[id], c + vec3(0, 0.1, f32(dz)), vec3(f32(side * (p.float_x - 0.1)), f32(lower_y - 0.03), f32(-0.6 + dz)), 0.03, wood)

# The boats' common tail: fin and rudder on the hull's end, a tailplane `ty` up the fin (braced
# when high), the rudder in the accent with a cream band.
_boat_tail = (vs: mut Vertex3D[], p: AircraftProfile, lv: Livery, ty: f64, span: f64, chord: f64, fin: f64, wood: vec4):
    l = p.length; top = p.width * 1.0
    z = l * 0.44
    kit_box(vs, vec3(0, f32(top + fin * 0.5), f32(z)), vec3(0.04, f32(fin * 0.5), f32(chord * 0.42)), lv.body)
    kit_rudder(vs, vec3(0, f32(top + fin * 0.48), f32(z + chord * 0.62)), vec3(0.045, f32(fin * 0.52), f32(chord * 0.2)), lv)
    kit_box(vs, vec3(0, f32(top + fin * 0.48), f32(z + chord * 0.62)), vec3(0.047, f32(fin * 0.1), f32(chord * 0.205)), rgb(0.93, 0.9, 0.8))
    kit_fabric_wing(vs, vec3(0, f32(ty), f32(z)), span, chord, 0.75, lv)
    if ty > top + 0.25:
        loop side in [-1.0, 1.0]:
            loop dz in [-chord * 0.3, chord * 0.3]:
                kit_strut(vs, vec3(f32(side * 0.08), f32(top - 0.05), f32(z + dz)), vec3(f32(side * span * 0.28), f32(ty - 0.02), f32(z + dz)), 0.025, wood)

# Shared boat assembly; struts are the type's own (the CC's star, the Macchis' parallel pairs).
_early_boat = (kind: Craft, lv: Livery) -> CraftModel:
    p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    wood = rgb(0.42, 0.29, 0.17); wire = rgb(0.22, 0.22, 0.21); metal = rgb(0.36, 0.36, 0.34)
    upper_y = p.wing_y; lower_y = p.wing_y - 1.9
    lower_span = p.span * p.lower_span
    lower_chord = if kind == .macchi_m5: p.chord * 0.66 else: p.chord * 0.92
    uz = -0.65; lz = if kind == .macchi_m5: -0.5 else: -0.6
    _early_hull(bins, p, lv, if kind == .macchi_m7: 1.0 else: 0.0, if kind == .hansa_cc: 1.12 else: 1.0)
    # cockpit and guns
    seat = vec3(0, f32(p.width * (if kind == .hansa_cc: 1.12 else: 1.0) + 0.025), f32(p.cockpit_z))
    kit_cockpit(bins[0], seat, lv)
    _vickers(bins[0], f64(seat.y), p.cockpit_z - 0.85, 0.13)
    # wings
    _wing(bins, kind, lv, vec3(0, f32(upper_y), f32(uz)), p.span, p.chord, p.taper, true)
    _wing(bins, kind, lv, vec3(0, f32(lower_y), f32(lz)), lower_span, lower_chord, p.taper, false)
    # centre-section struts from the hull sides to the upper wing (the hull's: they stay with it)
    loop side in [-1.0, 1.0]:
        loop dz in [-0.55, 0.45]:
            kit_strut(bins[0], vec3(f32(side * p.width * 0.9), f32(lower_y + 0.08), f32(uz + dz)), vec3(f32(side * 0.95), f32(upper_y - 0.02), f32(uz + dz)), 0.04, wood)
    # interplane bracing, one bay each side
    front = uz - p.chord * 0.3; rear = uz + p.chord * 0.25
    lfront = lz - lower_chord * 0.3; lrear = lz + lower_chord * 0.25
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        if kind == .hansa_cc:
            # The star: four struts from one node in the middle of the bay to both spars of both
            # wings, the upper pair a little outboard, so it reads as a star from ahead and abeam.
            node = vec3(f32(side * lower_span * 0.4), f32((upper_y + lower_y) * 0.5), f32((uz + lz) * 0.5))
            loop pz in [front, rear]: kit_strut(bins[id], node, vec3(f32(side * (lower_span * 0.4 + 0.45)), f32(upper_y - 0.01), f32(pz)), 0.045, wood)
            loop pz in [lfront, lrear]: kit_strut(bins[id], node, vec3(f32(side * (lower_span * 0.4 - 0.45)), f32(lower_y + 0.04), f32(pz)), 0.045, wood)
            kit_box(bins[id], node, vec3(0.07, 0.07, 0.07), metal)
        else:
            # Parallel pairs, the M.5's leaning out to its broader upper wing; the M.7 adds an N diagonal.
            out = if kind == .macchi_m5: 0.75 else: 0.15
            x0 = lower_span * 0.42
            loop pz in [(lfront, front), (lrear, rear)]:
                kit_strut(bins[id], vec3(f32(side * x0), f32(lower_y + 0.04), f32(pz.0)), vec3(f32(side * (x0 + out)), f32(upper_y - 0.01), f32(pz.1)), 0.04, wood)
            if kind == .macchi_m7:
                kit_strut(bins[id], vec3(f32(side * x0), f32(lower_y + 0.04), f32(lrear)), vec3(f32(side * (x0 + out)), f32(upper_y - 0.01), f32(front)), 0.03, wood)
            # flying and landing wires, crossed in the bay
            kit_strut(bins[id], vec3(f32(side * p.width), f32(lower_y + 0.05), f32(front)), vec3(f32(side * (x0 + out)), f32(upper_y), f32(front)), 0.011, wire)
            kit_strut(bins[id], vec3(f32(side * x0), f32(lower_y + 0.05), f32(front)), vec3(f32(side * 0.95), f32(upper_y), f32(front)), 0.011, wire)
            kit_strut(bins[id], vec3(f32(side * p.width), f32(lower_y + 0.05), f32(rear)), vec3(f32(side * (x0 + out)), f32(upper_y), f32(rear)), 0.011, wire)
    _tip_floats(bins, p, lv, lower_y, wood)
    _pusher_engine(bins[1], p, lv, upper_y, kind == .macchi_m7)
    # tail: the Macchis carry the tailplane high on the fin, braced; the CC's sits on the hull
    if kind == .hansa_cc: _boat_tail(bins[6], p, lv, p.width * 1.12 + 0.05, 3.1, 0.95, 1.25, wood)
    else: _boat_tail(bins[6], p, lv, p.width + (if kind == .macchi_m5: 0.62 else: 0.55), if kind == .macchi_m5: 3.3 else: 3.0, 0.85, 1.15, wood)
    hub = vec3(0, p.engine_y, p.engine_z + 0.65)
    shade = [vec3(0, 0, 0), vec3(p.width, p.width, p.length * 0.5), vec3(0, upper_y, uz), vec3(p.span * 0.5, 0.08, p.chord * 0.5),
        vec3(0, lower_y, lz), vec3(lower_span * 0.5, 0.08, lower_chord * 0.5), vec3(0, p.width + 0.6, p.length * 0.44), vec3(1.5, 0.08, 0.42)]
    vs: Vertex3D[]
    loop bin in bins: vs.extend(bin)
    model = CraftModel(custom_mesh(vs), build_prop(p.prop_radius, 2), hub, catalog_contacts(kind), seat + vec3(0, 0.38, 0),
        vec3(p.width * 0.7, p.width, -1), shade, prop_hubs = [hub], cockpits = [seat + vec3(0, 0.38, 0)], prop_radius = p.prop_radius, prop_blades = 2)
    finish_craft_model(model, bins, kind)

# The Fiat C.R.20: a blunt V-12 nose behind its radiator and shutters, a slim fabric fuselage,
# the broad upper wing on cabanes and the narrow lower one on W struts, split-axle wheels on V legs
# and a tail skid. Its contacts are the fuselage belly: they only meet water (a ditching).
_fiat_cr20 = (lv: Livery) -> CraftModel:
    kind = Craft.fiat_cr20
    p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    metal = rgb(0.33, 0.34, 0.34); dark = rgb(0.14, 0.14, 0.13); tyre = rgb(0.1, 0.1, 0.09)
    cowl = vec4(lv.body.x * 0.9 + 0.04, lv.body.y * 0.9 + 0.04, lv.body.z * 0.9 + 0.05, 1)
    under = _shade(lv.body, 0.85)
    # fuselage: cowled nose (engine bin), fabric body, the tail cone (tail bin)
    loft(bins[1], [Section(-3.35, 0.4, 0.42, 0.44), Section(-3.0, 0.47, 0.49, 0.5), Section(-1.65, 0.5, 0.52, 0.52)], vec3(0, 0, 0), cowl, cowl)
    loft(bins[0], [Section(-1.65, 0.5, 0.52, 0.52), Section(-0.2, 0.48, 0.55, 0.5), Section(0.9, 0.42, 0.5, 0.42), Section(2.0, 0.3, 0.42, 0.26)], vec3(0, 0, 0), lv.body, under)
    loft(bins[6], [Section(2.0, 0.3, 0.42, 0.26), Section(3.35, 0.05, 0.3, 0.02)], vec3(0, 0, 0), lv.body, under)
    # radiator face with its shutters, exhaust stubs both sides, louvres
    kit_box(bins[1], vec3(0, 0, -3.36), vec3(0.34, 0.35, 0.02), rgb(0.2, 0.21, 0.2))
    loop k in 0..7: kit_box(bins[1], vec3(0, f32(-0.3 + f64(k) * 0.1), -3.385), vec3(0.33, 0.012, 0.012), rgb(0.48, 0.48, 0.46))
    kit_spinner(bins[1], vec3(0, 0, -3.5), 0.17, cowl)
    loop side in [-1.0, 1.0]:
        loop j in 0..6:
            kit_box(bins[1], vec3(f32(side * 0.5), 0.18, f32(-3.0 + f64(j) * 0.2)), vec3(0.04, 0.035, 0.05), dark)
        kit_strut(bins[1], vec3(f32(side * 0.49), -0.15, -3.0), vec3(f32(side * 0.5), -0.15, -1.9), 0.012, dark)
    kit_box(bins[0], vec3(0, 0.06, 1.45), vec3(0.4, 0.5, 0.1), lv.trim)
    # cockpit and the guns over the cowling
    seat = vec3(0, 0.55, f32(p.cockpit_z))
    kit_cockpit(bins[0], seat, lv)
    _vickers(bins[0], 0.48, -1.35, 0.13)
    # wings: the upper ahead of the lower (stagger), the lower narrow
    upper_y = p.wing_y; lower_y = p.wing_y - 1.9
    uz = -0.95; lz = -0.6
    lower_span = p.span * p.lower_span; lower_chord = p.chord * 0.68
    _wing(bins, kind, lv, vec3(0, f32(upper_y), f32(uz)), p.span, p.chord, p.taper, true)
    _wing(bins, kind, lv, vec3(0, f32(lower_y), f32(lz)), lower_span, lower_chord, p.taper, false)
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        # cabane, three struts a side joined clear of the cockpit
        loop pz in [(-1.55, -1.75), (-0.7, -0.6)]: kit_strut(bins[0], vec3(f32(side * 0.3), 0.5, f32(pz.0)), vec3(f32(side * 0.55), f32(upper_y - 0.02), f32(pz.1)), 0.035, metal)
        kit_strut(bins[0], vec3(f32(side * 0.3), 0.5, -1.55), vec3(f32(side * 0.55), f32(upper_y - 0.02), -0.6), 0.03, metal)
        # the W: a V each from the lower wing's spars up to two points on the upper
        x = lower_span * 0.4
        loop spar in [(lz - lower_chord * 0.25, uz - p.chord * 0.3), (lz + lower_chord * 0.22, uz + p.chord * 0.22)]:
            low = vec3(f32(side * x), f32(lower_y + 0.04), f32(spar.0))
            kit_strut(bins[id], low, vec3(f32(side * (x - 0.75)), f32(upper_y - 0.01), f32(spar.1)), 0.035, metal)
            kit_strut(bins[id], low, vec3(f32(side * (x + 0.75)), f32(upper_y - 0.01), f32(spar.1)), 0.035, metal)
        kit_strut(bins[id], vec3(f32(side * 0.5), f32(lower_y + 0.05), f32(lz)), vec3(f32(side * (x + 0.75)), f32(upper_y), f32(uz)), 0.01, dark)
        # undercarriage: V legs to the axle, the wheel (bins 4/5)
        wid = if side < 0: 4 else: 5
        axle = vec3(f32(side * p.float_x), f32(p.float_y), -1.2)
        loop z in [-1.65, -0.75]: kit_strut(bins[wid], vec3(f32(side * 0.28), -0.5, f32(z)), axle, 0.04, metal)
        kit_strut(bins[wid], vec3(f32(side * 0.05), -0.62, -1.2), axle, 0.03, metal)
        m = translation(axle) * rotation_z(PI / 2)
        add_cylinder(bins[wid], vec3(0, -0.065, 0), 0.38, 0.13, tyre, 14, -1.0, m)
        add_cylinder(bins[wid], vec3(0, -0.075, 0), 0.22, 0.15, cowl, 10, -1.0, m)
    # tail: tailplane, fin and rudder, the skid
    kit_fabric_wing(bins[6], vec3(0, 0.12, 2.95), 3.2, 0.85, 0.7, lv)
    kit_box(bins[6], vec3(0, 0.62, 3.05), vec3(0.04, 0.42, 0.28), lv.body)
    kit_rudder(bins[6], vec3(0, 0.55, 3.45), vec3(0.045, 0.52, 0.16), lv)
    kit_box(bins[6], vec3(0, 0.55, 3.45), vec3(0.047, 0.1, 0.165), rgb(0.93, 0.9, 0.8))
    kit_strut(bins[6], vec3(0, -0.02, 2.85), vec3(0, -0.4, 3.15), 0.035, metal)
    kit_box(bins[6], vec3(0, -0.42, 3.17), vec3(0.04, 0.025, 0.1), dark)
    hub = vec3(0, 0, -3.5)
    belly = [vec3(-0.35, -0.5, -1.8), vec3(0.35, -0.5, -1.8), vec3(-0.35, -0.5, -0.3), vec3(0.35, -0.5, -0.3), vec3(-0.25, -0.3, 1.3), vec3(0.25, -0.3, 1.3)]
    shade = [vec3(0, 0, -0.1), vec3(0.5, 0.5, 3.35), vec3(0, f32(upper_y), f32(uz)), vec3(f32(p.span * 0.5), 0.08, f32(p.chord * 0.5)),
        vec3(0, f32(lower_y), f32(lz)), vec3(f32(lower_span * 0.5), 0.08, f32(lower_chord * 0.5)), vec3(0, 0.12, 2.95), vec3(1.6, 0.08, 0.42)]
    vs: Vertex3D[]
    loop bin in bins: vs.extend(bin)
    model = CraftModel(custom_mesh(vs), build_prop(p.prop_radius, 2), hub, belly, seat + vec3(0, 0.38, 0),
        vec3(0.95, f32(lower_y + 0.1), -0.6), shade, prop_hubs = [hub], cockpits = [seat + vec3(0, 0.38, 0)], prop_radius = p.prop_radius, prop_blades = 2)
    finish_craft_model(model, bins, kind)

# The Donnet-Lévêque Type A (1912): a short, broad scow-bowed hull with one step, two seats side by
# side, a two-bay biplane with an uncowled Gnome rotary pushing from between the wings, and the tail
# carried back on an open girder of four longerons, kept low under the propeller's disc. Its hull is
# far shorter than its length, so its contacts are its own: the keel and chines under the hull, the
# stern, and the small floats under the lower wing.
_donnet_leveque = (lv: Livery) -> CraftModel:
    kind = Craft.donnet_leveque
    p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    wood = rgb(0.45, 0.32, 0.2); wire = rgb(0.22, 0.22, 0.21); metal = rgb(0.4, 0.4, 0.38)
    under = _shade(lv.body, 0.55)
    hull = [Section(-2.9, 0.32, 0.42, 0.0, 0.0), Section(-2.6, 0.5, 0.55, 0.32, 0.08), Section(-2.0, 0.6, 0.6, 0.55, 0.15),
        Section(-0.8, 0.6, 0.6, 0.6, 0.18), Section(0.15, 0.6, 0.58, 0.6, 0.18), Section(0.18, 0.5, 0.56, 0.36, 0.08), Section(1.3, 0.2, 0.5, 0.04, 0.0)]
    loft(bins[0], hull, vec3(0, 0, 0), lv.body, under)
    # a wide cockpit for two side by side, its coaming and a low screen
    kit_box(bins[0], vec3(0, 0.615, -1.55), vec3(0.5, 0.02, 0.42), rgb(0.12, 0.11, 0.1))
    loop side in [-1.0, 1.0]: kit_strut(bins[0], vec3(f32(side * 0.52), 0.64, -1.97), vec3(f32(side * 0.52), 0.64, -1.13), 0.035, lv.trim)
    kit_box(bins[0], vec3(0, 0.74, -1.98), vec3(0.48, 0.1, 0.02), rgb(0.63, 0.79, 0.83))
    seats = [vec3(-0.27, 1.0, -1.5), vec3(0.27, 1.0, -1.5)]
    upper_y = p.wing_y; lower_y = p.wing_y - 1.9 + 0.06
    lower_span = p.span * p.lower_span
    _wing(bins, kind, lv, vec3(0, f32(upper_y), -0.5), p.span, p.chord, p.taper, true)
    _wing(bins, kind, lv, vec3(0, f32(lower_y), -0.5), lower_span, p.chord, p.taper, false)
    front = -0.5 - p.chord * 0.32; rear = -0.5 + p.chord * 0.28
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        # two bays: plain upright pairs, crossed wires in each
        xs = [0.75, 2.2, lower_span * 0.47]
        loop k in 1..3:
            loop z in [front, rear]: kit_strut(bins[id], vec3(f32(side * xs[k]), f32(lower_y + 0.04), f32(z)), vec3(f32(side * xs[k]), f32(upper_y - 0.01), f32(z)), 0.035, wood)
        # (the crossed wires in the front plane of each bay; the rear plane's hide behind them)
        loop k in 0..2:
            kit_strut(bins[id], vec3(f32(side * xs[k]), f32(lower_y + 0.05), f32(front)), vec3(f32(side * xs[k + 1]), f32(upper_y), f32(front)), 0.01, wire)
            kit_strut(bins[id], vec3(f32(side * xs[k + 1]), f32(lower_y + 0.05), f32(front)), vec3(f32(side * xs[k]), f32(upper_y), f32(front)), 0.01, wire)
        # centre-section struts belong to the hull
        loop z in [front, rear]: kit_strut(bins[0], vec3(f32(side * 0.55), f32(lower_y + 0.04), f32(z)), vec3(f32(side * 0.75), f32(upper_y - 0.01), f32(z)), 0.035, wood)
    _tip_floats(bins, p, lv, lower_y, wood)
    # the Gnome: crankcase, seven bare cylinders round it, on a pylon from the hull and the wing;
    # the tank under the upper wing's centre
    c = vec3(0, f32(p.engine_y), f32(p.engine_z))
    hub = vec3(0, f32(p.engine_y), f32(p.engine_z + 0.65))
    add_cylinder(bins[1], vec3(0, -0.2, 0), 0.17, 0.5, metal, 10, -1.0, translation(c + vec3(0, 0, 0.2)) * rotation_x(PI / 2))
    loop j in 0..7:
        a = f64(j) * TAU / 7.0
        kit_strut(bins[1], hub + vec3(f32(cos(a) * 0.15), f32(sin(a) * 0.15), -0.25), hub + vec3(f32(cos(a) * 0.43), f32(sin(a) * 0.43), -0.25), 0.075, rgb(0.5, 0.49, 0.46))
    kit_spinner(bins[1], hub, 0.1, metal, true)
    loop side in [-1.0, 1.0]:
        loop dz in [-0.35, 0.3]:
            kit_strut(bins[1], vec3(f32(side * 0.35), 0.6, f32(p.engine_z + dz - 0.2)), vec3(f32(side * 0.12), f32(p.engine_y - 0.15), f32(p.engine_z + dz)), 0.04, wood)
            kit_strut(bins[1], vec3(f32(side * 0.12), f32(p.engine_y + 0.15), f32(p.engine_z + dz)), vec3(f32(side * 0.3), f32(upper_y - 0.02), f32(p.engine_z + dz - 0.2)), 0.035, wood)
    add_cylinder(bins[1], vec3(0, -0.45, 0), 0.17, 0.9, rgb(0.62, 0.6, 0.52), 8, -1.0, translation(vec3(0, f32(upper_y - 0.28), -0.75)) * rotation_z(PI / 2))
    # the tail girder: four longerons from the stern, uprights and cross wires, all below the disc
    tail_z = 5.25
    corners = [vec3(-0.25, 0.28, 1.1), vec3(0.25, 0.28, 1.1), vec3(-0.22, 0.55, 1.1), vec3(0.22, 0.55, 1.1)]
    ends = [vec3(-0.05, 0.42, tail_z), vec3(0.05, 0.42, tail_z), vec3(-0.05, 0.72, tail_z), vec3(0.05, 0.72, tail_z)]
    loop k in 0..4: kit_strut(bins[6], corners[k], ends[k], 0.035, wood)
    # (three bays of uprights: the girder reads as open from a distance at a fraction of the cost)
    loop bay in 1..4:
        u = f32(bay) / 4.0
        q = [loop k in 0..4: corners[k] + (ends[k] - corners[k]) * u]
        kit_strut(bins[6], q[0], q[2], 0.025, wood); kit_strut(bins[6], q[1], q[3], 0.025, wood)
        kit_strut(bins[6], q[2], q[3], 0.02, wood)
    kit_fabric_wing(bins[6], vec3(0, 0.74, f32(tail_z - 0.3)), 3.2, 1.0, 0.85, lv)
    kit_box(bins[6], vec3(0, 1.25, f32(tail_z - 0.15)), vec3(0.04, 0.5, 0.32), lv.body)
    kit_rudder(bins[6], vec3(0, 1.2, f32(tail_z + 0.35)), vec3(0.045, 0.6, 0.2), lv)
    contacts = [vec3(-0.3, -0.6, -2.0), vec3(0.3, -0.6, -2.0), vec3(-0.3, -0.6, 0.1), vec3(0.3, -0.6, 0.1),
        vec3(0, -0.78, -1.8), vec3(0, -0.78, 0.1), vec3(0, -0.3, 1.0),
        vec3(-p.float_x, p.float_y - 0.22, -0.6), vec3(p.float_x, p.float_y - 0.22, -0.6)]
    shade = [vec3(0, 0, -0.8), vec3(0.6, 0.6, 2.1), vec3(0, f32(upper_y), -0.5), vec3(f32(p.span * 0.5), 0.08, f32(p.chord * 0.5)),
        vec3(0, f32(lower_y), -0.5), vec3(f32(lower_span * 0.5), 0.08, f32(p.chord * 0.5)), vec3(0, 0.5, 3.2), vec3(0.2, 0.15, 2.1),
        vec3(0, 0.74, f32(tail_z - 0.3)), vec3(1.6, 0.08, 0.5)]
    vs: Vertex3D[]
    loop bin in bins: vs.extend(bin)
    model = CraftModel(custom_mesh(vs), build_prop(p.prop_radius, 2), hub, contacts, seats[0],
        vec3(0.62, 0.6, -0.9), shade, prop_hubs = [hub], cockpits = seats, prop_radius = p.prop_radius, prop_blades = 2)
    finish_craft_model(model, bins, kind)

build_early_craft = (kind: Craft, lv: Livery) -> CraftModel:
    if kind == .fiat_cr20: return _fiat_cr20(lv)
    if kind == .donnet_leveque: return _donnet_leveque(lv)
    _early_boat(kind, lv)
