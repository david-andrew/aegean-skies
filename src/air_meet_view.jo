use 'air_race.jo'
use 'objects.jo'
use 'look.jo'
use 'quality.jo'
use 'crowd_figures.jo'
use 'folk.jo'
use 'settlements.jo'

struct AirMeetView:
    pylon: Mesh

# The spectators on the quay are the town's own people (a bounded visual projection of its unnamed
# residents; the named ones keep the living scene's figures and places): drawn with the world's
# figures in their country's clothes (src/crowd_figures.jo), a dozen looks built two a frame as a
# meeting's quay first comes near.
const SPECTATOR_LOOKS = 12
spectator_figs: Figure[] = []
spectator_looks: CrowdLook[] = []
spectator_key = -1

make_air_meet_view = () -> AirMeetView:
    vs: Vertex3D[]
    add_box(vs, vec3(0, 0.4, 0), vec3(7, 0.8, 7), rgb(0.22, 0.20, 0.16))
    loop band in 0..8:
        add_box(vs, vec3(0, 2.0 + f64(band) * 3.0, 0), vec3(1.8, 3, 1.8), if band % 2 == 0: rgb(0.93, 0.89, 0.72) else: rgb(0.68, 0.13, 0.09))
    add_box(vs, vec3(2.5, 24, 0), vec3(6, 2.6, 0.12), rgb(0.92, 0.74, 0.23))
    AirMeetView(custom_mesh(vs))

# (the looks of a meeting's town's people: its own seed and country; two built a frame, into the
# last meeting's buffers where there are any)
_spectator_next = 0
_spectators_ready = (capital: int) -> bool:
    global spectator_looks, spectator_key, _spectator_next
    if spectator_key != capital:
        country = 0; seed = capital
        if let index = settlement_by_id.get(capital):
            country = world_settlements[index].country; seed = world_settlements[index].seed
        spectator_looks = [loop k in 0..SPECTATOR_LOOKS: crowd_look(seed + 7, k, country)]
        spectator_key = capital
        _spectator_next = 0
    _spectators_step()

_spectators_step = () -> bool:
    global spectator_figs, _spectator_next
    if _spectator_next >= SPECTATOR_LOOKS: return true
    loop n in 0..2:
        if _spectator_next >= SPECTATOR_LOOKS: break
        k = _spectator_next
        reuse: Figure? = if k < spectator_figs.len(): spectator_figs[k] else: none
        f = crowd_figure(spectator_looks[k], reuse)
        if k < spectator_figs.len(): spectator_figs[k] = f else: spectator_figs.push(f)
        _spectator_next += 1
    _spectator_next >= SPECTATOR_LOOKS

draw_air_meets = (view: AirMeetView, events: AirEvents, L: Light, t: f64):
    pylons: Instance3D[]; crowd: CrowdPose[]; cam = scene_camera()
    loop meet in events.meets:
        if meet.phase == .cancelled or meet.phase == .finished or meet.gates.len() == 0: continue
        if f64(length(meet.gates[0].center - cam)) > 15000.0 * max(meet.scale, 1.0): continue
        # (a larger course's pylons stand taller, so a gate kilometres off still reads)
        tall = sqrt(max(meet.scale, 1.0))
        loop gate in meet.gates:
            side = vec3(-gate.forward.z, 0, gate.forward.x)
            loop sign in [-1.0, 1.0]:
                p = gate.center + side * f32(sign * gate.width); p.y = 0
                pylons.push(Instance3D(translation(p) * scaling(vec3(f32(tall), f32(tall), f32(tall))), vec4(1, 1, 1, 1)))
        if meet.phase != .registration and length((meet.quay_a + meet.quay_b) * 0.5 - cam) < 900:
            n = min(meet.audience, if render_quality.tier == 0: 24 else: 48)
            along = meet.quay_b - meet.quay_a
            if length(along) > 1 and n > 0 and _spectators_ready(meet.capital):
                dir = normalize(along); inland = vec3(-dir.z, 0, dir.x)
                # (facing out over the water to the course, from rows back from the edge)
                yaw = atan2(-f64(inland.x), -f64(inland.z))
                loop k in 0..n:
                    p = lerp(meet.quay_a, meet.quay_b, f32((f64(k % 16) + 0.5) / 16.0)) + inland * f32(1.0 + f64(k / 16) * 1.4)
                    # (a cheer now and then, a hand up)
                    w = (t * 0.7 + f64(k) * 1.37) % 6.0
                    crowd.push(CrowdPose((k * 5 + k / 16) % SPECTATOR_LOOKS, p, yaw + sin(f64(k) * 2.1) * 0.15, gesture = if w < 1.4: sin(w / 1.4 * PI) else: 0.0))
    if pylons.len() > 0: draw_instanced(obj_inst_sh, view.pylon, pylons, obj_params(L, t))
    if crowd.len() > 0: draw_crowd(spectator_figs, crowd, L, t)
