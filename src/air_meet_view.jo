use 'depth_space.jo'
use 'air_race.jo'
use 'objects.jo'
use 'look.jo'
use 'quality.jo'

struct AirMeetView:
    pylon: Mesh
    spectator: Mesh

make_air_meet_view = () -> AirMeetView:
    vs: Vertex3D[]
    add_box(vs, vec3(0, 0.4, 0), vec3(7, 0.8, 7), rgb(0.22, 0.20, 0.16))
    loop band in 0..8:
        add_box(vs, vec3(0, 2.0 + f64(band) * 3.0, 0), vec3(1.8, 3, 1.8), if band % 2 == 0: rgb(0.93, 0.89, 0.72) else: rgb(0.68, 0.13, 0.09))
    add_box(vs, vec3(2.5, 24, 0), vec3(6, 2.6, 0.12), rgb(0.92, 0.74, 0.23))
    pylon = custom_mesh(vs); vs = []
    # Cohort spectators are a bounded visual projection of existing unnamed residents.
    # Named residents continue to use the living scene's own figures and positions.
    add_box(vs, vec3(0, 1.12, 0), vec3(0.50, 0.65, 0.3), rgb(0.62, 0.58, 0.47))
    add_box(vs, vec3(0, 1.62, 0), vec3(0.28, 0.31, 0.26), rgb(0.78, 0.57, 0.39))
    add_box(vs, vec3(0, 1.81, 0), vec3(0.4, 0.12, 0.36), rgb(0.55, 0.46, 0.3))
    loop side in [-1.0, 1.0]:
        add_box(vs, vec3(side * 0.14, 0.43, 0), vec3(0.19, 0.86, 0.22), rgb(0.25, 0.29, 0.31))
        add_box(vs, vec3(side * 0.33, 1.10, 0), vec3(0.15, 0.56, 0.18), rgb(0.62, 0.58, 0.47))
    AirMeetView(pylon, custom_mesh(vs))

draw_air_meets = (view: AirMeetView, events: AirEvents, L: Light, t: f64):
    pylons: Instance3D[]; crowd: Instance3D[]; cam = scene_camera()
    loop meet in events.meets:
        if meet.phase == .cancelled or meet.phase == .finished or meet.gates.len() == 0: continue
        if length(meet.gates[0].center - cam) > 15000: continue
        loop gate in meet.gates:
            side = vec3(-gate.forward.z, 0, gate.forward.x)
            loop sign in [-1.0, 1.0]:
                p = gate.center + side * f32(sign * gate.width); p.y = 0
                pylons.push(Instance3D(translation(p), vec4(1, 1, 1, 1)))
        if meet.phase != .registration and length((meet.quay_a + meet.quay_b) * 0.5 - cam) < 900:
            n = min(meet.audience, if render_quality.tier == 0: 24 else: 48)
            along = meet.quay_b - meet.quay_a
            if length(along) > 1:
                dir = normalize(along); inland = vec3(-dir.z, 0, dir.x)
                yaw = atan2(f64(inland.x), f64(inland.z))
                loop k in 0..n:
                    p = lerp(meet.quay_a, meet.quay_b, f32((f64(k % 16) + 0.5) / 16.0)) + inland * f32(1.0 + f64(k / 16) * 1.4)
                    at = translation(p) * rotation_y(yaw + sin(f64(k) * 2.1) * 0.15) * scaling(0.9 + f64(k % 5) * 0.04)
                    crowd.push(Instance3D(at, vec4(0.8 + f32(k % 3) * 0.1, 0.8 + f32(k % 4) * 0.06, 0.75 + f32(k % 5) * 0.05, 1)))
    if pylons.len() > 0: draw_world_instanced(obj_inst_sh, view.pylon, pylons, obj_params(L, t))
    if crowd.len() > 0: draw_world_instanced(obj_inst_sh, view.spectator, crowd, obj_params(L, t))
