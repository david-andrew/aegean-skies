# Close street shoulders meet the contact surface rather than ending as a
# floating sheet. A descending bevel is hidden wherever another lane overlaps.
use 'town_details.jo'
use 'settlements.jo'
use 'objects.jo'

town_paving_shoulder = (vs: mut Vertex3D[],a: vec2,b: vec2,out: vec2,depth: int = 0):
    c=a+out*0.28; d=b+out*0.28
    pa=vec3(a.x,f32(place_ground(a)+0.12),a.y)
    pb=vec3(b.x,f32(place_ground(b)+0.12),b.y)
    pc=vec3(c.x,f32(place_ground(c)+0.005),c.y)
    pd=vec3(d.x,f32(place_ground(d)+0.005),d.y)
    mid=(a+b)*0.5; outer=(c+d)*0.5
    curved=abs(f64((pa.y+pb.y)*0.5)-place_ground(mid)-0.12)>0.02 or abs(f64((pc.y+pd.y)*0.5)-place_ground(outer)-0.005)>0.02
    if depth<10 and (length(b-a)>1.0 or curved and length(b-a)>0.25):
        town_paving_shoulder(vs,a,mid,out,depth+1)
        town_paving_shoulder(vs,mid,b,out,depth+1)
        return
    if min(min(pa.y,pb.y),min(pc.y,pd.y))<0.2: return
    color=rgb(0.72,0.68,0.60)
    add_outward_triangle(vs,pa,pb,pc,color,pa-vec3(0,2,0))
    add_outward_triangle(vs,pb,pd,pc,color,pb-vec3(0,2,0))

town_street = (vs: mut Vertex3D[],a: vec2,b: vec2,width: f64):
    if length(b-a)<0.1: return
    along=normalize(b-a); side=vec2(-along.y,along.x); half=f32(width*0.5)
    # Square caps overlap the connecting lane nodes, closing triangular gaps.
    aa=a-along*half; bb=b+along*half
    town_path(vs,aa,bb,width,true)
    start=vs.len()
    town_paving_shoulder(vs,aa+side*half,bb+side*half,side)
    town_paving_shoulder(vs,aa-side*half,bb-side*half,-side)
    town_paving_shoulder(vs,aa-side*half,aa+side*half,-along)
    town_paving_shoulder(vs,bb-side*half,bb+side*half,along)
    loop end in [-1.0,1.0]:
        loop side_sign in [-1.0,1.0]:
            p=(if end<0: aa else: bb)+side*f32(side_sign)*half
            q=p+along*f32(end*0.28); r=p+side*f32(side_sign*0.28)
            a0=place_point(p)+vec3(0,0.12,0)
            add_outward_triangle(vs,a0,place_point(q)+vec3(0,0.005,0),place_point(r)+vec3(0,0.005,0),rgb(0.72,0.68,0.60),a0-vec3(0,2,0))
    loop k in start..vs.len(): vs[k].uv=vec2(182,0)
