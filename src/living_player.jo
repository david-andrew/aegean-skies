use 'living_types.jo'
use 'living_money.jo'
use 'living_claims.jo'
use 'living_delivery.jo'
use 'living_duties.jo'

enum CommandKind: buy, sell, take_job, deliver_job, return_cargo, pay

struct PlayerCommand:
    tick: int
    sequence: int
    actor = 0
    kind: CommandKind
    place = -1
    craft = -1
    good = -1
    quantity = 0
    job = -1
    obligation = -1

struct CommandResult:
    accepted: bool
    message: str
    amount = 0

# Caller sorts a tick's commands by (tick, actor, sequence); this receipt survives saves.
apply_command = (w: mut World, c: PlayerCommand) -> CommandResult:
    if c.actor < 0 or c.actor >= w.people.len() or c.tick != w.tick or c.sequence < 0: return CommandResult(false,"invalid actor, tick or sequence")
    if c.tick < w.people[c.actor].last_command_tick or (c.tick == w.people[c.actor].last_command_tick and c.sequence <= w.people[c.actor].last_command_sequence): return CommandResult(false,"stale command; already processed")
    w.people[c.actor].last_command_tick = c.tick
    w.people[c.actor].last_command_sequence = c.sequence
    ok = false; amount = 0
    match c.kind:
        .buy: ok = trade(w,c.actor,c.place,c.good,c.quantity,true,c.craft)
        .sell: ok = trade(w,c.actor,c.place,c.good,c.quantity,false,c.craft)
        .take_job: ok = take_job(w,c.job,c.actor)
        .deliver_job: ok = deliver_job(w,c.job,c.actor)
        .return_cargo: ok = return_job_cargo(w,c.job,c.actor)
        .pay:
            if c.obligation in w.obligations and w.obligations[c.obligation].debtor == c.actor:
                amount = pay_obligation(w,c.obligation,c.quantity)
                ok = amount > 0
    CommandResult(ok,if ok: "accepted" else: "unavailable: check location, ownership, capacity, stock, cash or deadline",amount)
