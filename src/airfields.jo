# Airfields: grass landing grounds for landplanes (the C.R.20, the Chelidon): the air arms'
# aerodromes, a flying club's field and a stop on the air mail's route. Each is a mown strip on
# naturally flat ground (the terrain is not regraded: tools/airfield_survey.jo found the site and
# the world audit checks it), a field cleared of trees round it, hangars, an office, a fuel point,
# windsocks, boundary markers and a landing circle. Pure data and queries here; the meshes are in
# airfield_render.jo.
#
# The frame: u along the strip (toward its heading), v across it (to the right of the heading),
# both in metres from the strip's centre. Headings are the game's (0 north/-z, PI/2 east/+x).
use 'world_source.jo'
use 'world_point.jo'

struct Airfield:
    name: str
    place: int                     # the settlement it serves (its stores and its name)
    country: int                   # 1 Kalyra, 2 Orenthia: the buildings' and markings' colours
    center: vec2                   # the strip's centre, world x/z
    heading: f64                   # the strip's axis, toward +u
    half_length: f64               # the mown strip, half its length and width
    half_width: f64
    kind = 0                       # its layout (AIRFIELD_LAYOUTS): 0 military, 1 flying club, 2 mail stop

# The landing grounds of the late 1920s: each strip is grass on ground found flat as it lies (no
# regrading), axis-aligned and centred on the 14 m lattice (so the turf lies on the terrain's own
# cells), long enough for the C.R.20's and the Chelidon's runs (some 1.2 km drawn, at the pure scale)
# with room to spare. The amphibians use the water: the Bat Boat's run on wheels (1.5 km) fits only
# Orenthessa's long military field, and the Albatross's (some 5 km) no field at all.
# (Add new fields at the end: saves refer to them by their place in this list.)
AIRFIELDS = [
    # The Kalyra air arm's field on the plateau 3.6 km south-west of the capital (163 m), running
    # north and south into the prevailing north wind, clear of the roads: 0.25 m relief over the
    # strip, 0.3% grade. (1.6 km: at 1.3 km the Chelidon left the grass at its very end.)
    Airfield("Kalyrassa aerodrome", 10001, 1, vec2(-120176.0, -87738.0), 0.0, 800.0, 28.0),
    # Orenthia's air arm: on the upland 6 km west-south-west of Orenthessa (125 m), north and south as
    # Kalyrassa's: 0.03% grade, 0.65 m relief. The long one, laid out for the bigger machines: 2.1 km.
    Airfield("Orenthessa aerodrome", 10003, 2, vec2(156478.0, -60368.0), 0.0, 1050.0, 30.0),
    # The aero club on the Southern island, 3.6 km west of Saryerio (102 m): members' light aircraft,
    # joy-rides and lessons; 0.07% grade, 0.5 m relief.
    Airfield("Saryerio aero club", 27018, 1, vec2(39242.0, 184730.0), 0.0, 800.0, 28.0, 1),
    # The air mail's stop on the Long island, 3.6 km north of Olytharandra (83 m): halfway between
    # the two capitals, where the mail aircraft takes on fuel and the island's bags; level along, 0.75 m
    # relief.
    Airfield("Olytharandra mail field", 24003, 1, vec2(-48734.0, -72366.0), 0.0, 750.0, 28.0, 2),
]
const AIRFIELD_VERSION = 2

# The field cleared of trees and tall grass round the strip; the apron and buildings on its left
# (the -v side).
const AIRFIELD_CLEAR_U = 90.0      # beyond each end of the strip
const AIRFIELD_CLEAR_LEFT = 190.0  # to the left of the strip's centre line
const AIRFIELD_CLEAR_RIGHT = 70.0

struct AirfieldBuilding:
    kind: int                      # 0 an arched hangar (open toward +v), 1 the office, 2 the fuel shed
    u: f64
    v: f64
    width: f64                     # along u
    depth: f64                     # along v
    height: f64

# A kind of field's buildings and ground: the apron (worn grass before the hangars, where aircraft
# park and take on fuel), the fuel point (pump and raised tank beside the shed) and where an aircraft
# stands to fuel, the parking stands (nose toward the strip, +v; the last of the three is the
# visitors', where the player's landplane is put), and the windsock by the apron (another stands
# at the downwind threshold, airfield_socks).
struct AirfieldLayout:
    apron: vec4                    # u0, v0, u1, v1
    buildings: AirfieldBuilding[]
    fuel: vec2
    fuel_stand: vec2
    stands: vec2[]
    sock: vec2

AIRFIELD_LAYOUTS = [
    # military: two hangars for the air arm's fighters (its stands 0 and 1, air_arm.jo), the office
    AirfieldLayout(vec4(-280.0, -132.0, 40.0, -30.0), [
        AirfieldBuilding(0, -200.0, -142.0, 26.0, 24.0, 8.5),
        AirfieldBuilding(0, -134.0, -142.0, 26.0, 24.0, 8.5),
        AirfieldBuilding(1, -70.0, -146.0, 14.0, 8.0, 4.2),
        AirfieldBuilding(2, -4.0, -112.0, 5.0, 4.0, 3.0),
    ], vec2(-4.0, -104.0), vec2(-4.0, -88.0), [vec2(-200.0, -104.0), vec2(-134.0, -104.0), vec2(-60.0, -100.0)], vec2(30.0, -40.0)),
    # a flying club's: one hangar for the members' light aircraft, the clubhouse
    AirfieldLayout(vec4(-160.0, -126.0, 34.0, -30.0), [
        AirfieldBuilding(0, -116.0, -138.0, 24.0, 22.0, 7.5),
        AirfieldBuilding(1, -66.0, -144.0, 16.0, 9.0, 4.4),
        AirfieldBuilding(2, -4.0, -112.0, 5.0, 4.0, 3.0),
    ], vec2(-4.0, -104.0), vec2(-4.0, -88.0), [vec2(-124.0, -102.0), vec2(-98.0, -102.0), vec2(-60.0, -100.0)], vec2(28.0, -40.0)),
    # a mail stop on the air post's route: a small hangar for the mail aircraft, the post office
    AirfieldLayout(vec4(-124.0, -120.0, 30.0, -30.0), [
        AirfieldBuilding(0, -90.0, -132.0, 20.0, 18.0, 6.5),
        AirfieldBuilding(1, -50.0, -138.0, 10.0, 7.0, 3.8),
        AirfieldBuilding(2, -4.0, -112.0, 5.0, 4.0, 3.0),
    ], vec2(-4.0, -104.0), vec2(-4.0, -88.0), [vec2(-90.0, -100.0), vec2(-64.0, -100.0), vec2(-36.0, -98.0)], vec2(26.0, -40.0)),
]
const AIRFIELD_VISITOR_STAND = 2
airfield_layout = (f: Airfield) -> AirfieldLayout: AIRFIELD_LAYOUTS[clamp(f.kind, 0, AIRFIELD_LAYOUTS.len() - 1)]
# Windsocks: one at the downwind (southern, or western) threshold, where landings into the
# prevailing wind begin, one by the apron.
airfield_socks = (f: Airfield) -> vec2[]: [vec2(f32(-f.half_length + 58.0), -46.0), airfield_layout(f).sock]
# What the field is to a person: an aerodrome, a flying club's ground, the air post's landing ground.
airfield_kind_name = (f: Airfield) -> str: match f.kind:
    1: "flying club"
    2: "air mail stop"
    _: "aerodrome"

airfield_key = () -> u64: hash((AIRFIELDS, AIRFIELD_LAYOUTS, AIRFIELD_VERSION))

airfield_forward = (f: Airfield) -> vec2: vec2(f32(sin(f.heading)), f32(-cos(f.heading)))
airfield_right = (f: Airfield) -> vec2: vec2(f32(cos(f.heading)), f32(sin(f.heading)))
airfield_world = (f: Airfield, u: f64, v: f64) -> vec2: f.center + airfield_forward(f) * f32(u) + airfield_right(f) * f32(v)
airfield_local = (f: Airfield, p: vec2) -> vec2:
    d = p - f.center
    vec2(dot(d, airfield_forward(f)), dot(d, airfield_right(f)))
airfield_ground = (p: vec2) -> f64: world_source_surface(f64(p.x), f64(p.y))
airfield_point = (f: Airfield, u: f64, v: f64) -> vec3:
    p = airfield_world(f, u, v)
    vec3(p.x, f32(airfield_surface(f64(p.x), f64(p.y), airfield_ground(p))), p.y)
# A building's floor: level with the highest ground under it, so it never sinks into the slope.
airfield_floor = (f: Airfield, b: AirfieldBuilding) -> f64:
    top = -1e9
    loop du in [-0.5, 0.0, 0.5]:
        loop dv in [-0.5, 0.0, 0.5]: top = max(top, airfield_ground(airfield_world(f, b.u + du * b.width, b.v + dv * b.depth)))
    top + 0.32
# The strip's heading, either way along it.
airfield_heading_at = (f: Airfield, toward_plus: bool) -> f64: if toward_plus: f.heading else: f.heading + PI

# Broad phase: the field's own neighbourhood.
_airfield_near = (f: Airfield, p: vec2) -> bool: length(p - f.center) < f32(f.half_length + 400.0)

# The turf: the strip and apron are laid on the terrain's own 14 m lattice cells (those whose
# centres are on them), standing AIRFIELD_TURF above the lattice inside and meeting it at the outer
# edge over one cell. The drawn turf and the ground the wheels and feet meet are the same surface.
const AIRFIELD_TURF = 0.2
airfield_cover_cell = (ix: int, iz: int) -> bool:
    mid = vec2(f32((f64(ix) + 0.5) * 14.0), f32((f64(iz) + 0.5) * 14.0))
    loop f in AIRFIELDS:
        if not _airfield_near(f, mid): continue
        q = airfield_local(f, mid)
        if abs(f64(q.x)) < f.half_length and abs(f64(q.y)) < f.half_width: return true
        ap = airfield_layout(f).apron
        if f64(q.x) > f64(ap.x) and f64(q.x) < f64(ap.z) and f64(q.y) > f64(ap.y) and f64(q.y) < f64(ap.w): return true
    false
# the turf's height above the lattice at lattice vertex (ix, iz)
airfield_vertex_turf = (ix: int, iz: int) -> f64:
    if airfield_cover_cell(ix - 1, iz - 1) and airfield_cover_cell(ix, iz - 1) and airfield_cover_cell(ix - 1, iz) and airfield_cover_cell(ix, iz): AIRFIELD_TURF else: 0.0
# ... anywhere, split as the terrain's cells are (0 off the turf)
airfield_turf = (x: f64, z: f64) -> f64:
    p = vec2(f32(x), f32(z))
    near = false
    loop f in AIRFIELDS:
        if _airfield_near(f, p): near = true
    if not near: return 0.0
    ix = int(floor(x / 14.0)); iz = int(floor(z / 14.0))
    if not airfield_cover_cell(ix, iz): return 0.0
    u = x / 14.0 - f64(ix); v = z / 14.0 - f64(iz)
    a = airfield_vertex_turf(ix, iz); b = airfield_vertex_turf(ix + 1, iz)
    c = airfield_vertex_turf(ix, iz + 1); d = airfield_vertex_turf(ix + 1, iz + 1)
    if u + v <= 1.0: a + u * (b - a) + v * (c - a) else: d + (1.0 - u) * (c - d) + (1.0 - v) * (b - d)

# The surface underfoot and under the wheels at a point: on the turf, the turf's own (the
# lattice's triangles through its corners, the turf over them: what is drawn); off it, `ground`.
# (The flight ground below 192 m carries the coast's sub-grid detail, up to 0.4 m inside a cell at
# the island fields: under the drawn turf the wheels rode bumps nobody could see.)
airfield_surface = (x: f64, z: f64, ground: f64) -> f64:
    p = vec2(f32(x), f32(z))
    near = false
    loop f in AIRFIELDS:
        if _airfield_near(f, p): near = true
    if not near: return ground
    ix = int(floor(x / 14.0)); iz = int(floor(z / 14.0))
    if not airfield_cover_cell(ix, iz): return ground
    corner = (i: int, k: int) -> f64: world_source_surface(f64(i) * 14.0, f64(k) * 14.0) + airfield_vertex_turf(i, k)
    u = x / 14.0 - f64(ix); v = z / 14.0 - f64(iz)
    a = corner(ix, iz); b = corner(ix + 1, iz); c = corner(ix, iz + 1); d = corner(ix + 1, iz + 1)
    if u + v <= 1.0: a + u * (b - a) + v * (c - a) else: d + (1.0 - u) * (c - d) + (1.0 - v) * (b - d)

# The mown strip and the apron: no tall grass.
airfield_mown = (p: vec2) -> bool:
    loop f in AIRFIELDS:
        if not _airfield_near(f, p): continue
        q = airfield_local(f, p)
        if abs(f64(q.x)) <= f.half_length and abs(f64(q.y)) <= f.half_width: return true
        ap = airfield_layout(f).apron
        if f64(q.x) >= f64(ap.x) and f64(q.x) <= f64(ap.z) and f64(q.y) >= f64(ap.y) and f64(q.y) <= f64(ap.w): return true
        loop b in airfield_layout(f).buildings:
            if abs(f64(q.x) - b.u) <= b.width * 0.5 + 2.0 and abs(f64(q.y) - b.v) <= b.depth * 0.5 + 2.0: return true
    false

# The whole field, cleared of trees (approaches and wing tips need it, as do the buildings).
airfield_clear = (p: vec2) -> bool:
    loop f in AIRFIELDS:
        if not _airfield_near(f, p): continue
        q = airfield_local(f, p)
        if abs(f64(q.x)) <= f.half_length + AIRFIELD_CLEAR_U and f64(q.y) >= -AIRFIELD_CLEAR_LEFT and f64(q.y) <= AIRFIELD_CLEAR_RIGHT: return true
    false

# The airfield whose ground (the cleared field, its apron and buildings) holds a point, or -1.
airfield_at = (p: vec2) -> int:
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]
        if not _airfield_near(f, p): continue
        q = airfield_local(f, p)
        if abs(f64(q.x)) <= f.half_length + AIRFIELD_CLEAR_U and f64(q.y) >= -AIRFIELD_CLEAR_LEFT and f64(q.y) <= AIRFIELD_CLEAR_RIGHT: return k
    -1

# The nearest airfield to a point, or -1 beyond `reach` metres.
nearest_airfield = (p: vec2, reach: f64 = 1e12) -> int:
    best = -1; d = reach
    loop k in 0..AIRFIELDS.len():
        l = f64(length(p - AIRFIELDS[k].center))
        if l < d: d = l; best = k
    best

# Where a landplane is put down at an airfield: stand `k` (clamped), on the ground, heading to the strip.
airfield_stand = (f: Airfield, k: int) -> vec3:
    s = airfield_stand_uv(f, k)
    airfield_point(f, f64(s.x), f64(s.y))
airfield_stand_uv = (f: Airfield, k: int) -> vec2:
    stands = airfield_layout(f).stands
    stands[clamp(k, 0, stands.len() - 1)]
airfield_stand_heading = (f: Airfield) -> f64: f.heading + PI * 0.5
# The fuel stand, where an aircraft stops to take on fuel.
airfield_fuel_stand = (f: Airfield) -> vec3: airfield_point(f, f64(airfield_layout(f).fuel_stand.x), f64(airfield_layout(f).fuel_stand.y))

# The buildings are solid to a walker (the hangars open along their front) and to an aircraft.
# Boxes in the local frame: centre u/v, half sizes, height above the floor.
struct AirfieldWall:
    at: vec2
    half: vec2
    height: f64
    floor: f64

_airfield_walls_cache: AirfieldWall[][]
airfield_walls = (k: int) -> AirfieldWall[]:
    global _airfield_walls_cache
    if _airfield_walls_cache.len() == 0:
        loop f in AIRFIELDS:
            walls: AirfieldWall[]
            loop b in airfield_layout(f).buildings:
                fl = airfield_floor(f, b)
                hw = b.width * 0.5; hd = b.depth * 0.5
                if b.kind == 0:
                    # side walls, the back wall; the front (+v) stands open
                    walls.push(AirfieldWall(vec2(f32(b.u - hw + 0.2), f32(b.v)), vec2(0.25, f32(hd)), b.height * 0.55, fl))
                    walls.push(AirfieldWall(vec2(f32(b.u + hw - 0.2), f32(b.v)), vec2(0.25, f32(hd)), b.height * 0.55, fl))
                    walls.push(AirfieldWall(vec2(f32(b.u), f32(b.v - hd + 0.2)), vec2(f32(hw), 0.25), b.height, fl))
                else: walls.push(AirfieldWall(vec2(f32(b.u), f32(b.v)), vec2(f32(hw), f32(hd)), b.height, fl))
            _airfield_walls_cache.push(walls)
    _airfield_walls_cache[k]

# Walking: the floors inside the buildings are the surface.
airfield_contact = (x: f64, z: f64, ground: f64) -> f64:
    p = vec2(f32(x), f32(z))
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]
        if not _airfield_near(f, p): continue
        q = airfield_local(f, p)
        loop b in airfield_layout(f).buildings:
            if abs(f64(q.x) - b.u) <= b.width * 0.5 and abs(f64(q.y) - b.v) <= b.depth * 0.5: return max(ground, airfield_floor(f, b))
        return airfield_surface(x, z, ground)
    ground

# Walking: pushed out of the walls (a hangar's open front lets a person in).
airfield_exclude = (p: vec2, height: f64) -> vec2:
    result = p
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]
        if not _airfield_near(f, result): continue
        q = airfield_local(f, result)
        original = q
        loop w in airfield_walls(k):
            if height >= w.floor + w.height: continue
            d = q - w.at; half = w.half + vec2(0.35, 0.35)
            if abs(d.x) >= half.x or abs(d.y) >= half.y: continue
            if half.x - abs(d.x) < half.y - abs(d.y): d.x = if d.x < 0: -half.x else: half.x
            else: d.y = if d.y < 0: -half.y else: half.y
            q = w.at + d
        if q != original: result = f.center + airfield_forward(f) * q.x + airfield_right(f) * q.y
    result

# An aircraft's contact sweeping from a to b: the first wall it is inside at b, as a world normal
# and the depth (vec4: n.xyz, depth; depth <= 0 when clear). Same contract as the canal's sweep.
airfield_solid = (a: vec3, b: vec3) -> vec4:
    p = b.xz
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]
        if not _airfield_near(f, p): continue
        q = airfield_local(f, p)
        loop w in airfield_walls(k):
            if f64(b.y) >= w.floor + w.height or f64(b.y) < w.floor - 1.0: continue
            d = q - w.at
            if abs(d.x) >= w.half.x or abs(d.y) >= w.half.y: continue
            fwd = airfield_forward(f); right = airfield_right(f)
            if w.half.x - abs(d.x) < w.half.y - abs(d.y):
                n = fwd * (if d.x < 0: -1.0 else: 1.0)
                return vec4(n.x, 0, n.y, w.half.x - abs(d.x))
            n = right * (if d.y < 0: -1.0 else: 1.0)
            return vec4(n.x, 0, n.y, w.half.y - abs(d.y))
    vec4(0, 0, 0, 0)
