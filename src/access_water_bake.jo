# Offline detours around new basin arms, using the same dry cart-width probes
# as feeder roads. Never replace a wet route with an unchecked straight chord.
use 'settlements.jo'
use 'access_path_bake.jo'
use 'living_feeder_bake.jo'
use 'water_field.jo'
use 'access_bridges.jo'

access_dry_segment=(a:vec3,b:vec3)->bool:
    count=max(1,int(ceil(f64(length(b.xz-a.xz))/4.0)))
    side=normalize(vec2(a.z-b.z,b.x-a.x))*0.8
    loop k in 0..count+1:
        center=mix(a.xz,b.xz,f32(k)/f32(count))
        loop offset in [-1.0,0.0,1.0]:
            p=center+side*f32(offset);r=water_at(f64(p.x),f64(p.y))
            if r.wet and access_bridge_height(p,place_ground(p))<r.level-0.25:return false
    true

access_water_repair=(coarse:vec3[])->vec3[]:
    if coarse.len()<2:return coarse
    # Ordinary compact roads may contain kilometre-long chords. First recover
    # dry staging points near each water crossing without changing their plan.
    sampled=[coarse[0]]
    loop k in 1..coarse.len():
        a=coarse[k-1];b=coarse[k];n=max(1,int(ceil(f64(length(b.xz-a.xz))/40.0)))
        loop j in 1..n+1:
            p=mix(a.xz,b.xz,f32(j)/f32(n));at=place_point(p);at.y=f32(access_bridge_height(p,f64(at.y)));sampled.push(at)
    result=[sampled[0]];at=1;changed=false
    loop at<sampled.len():
        previous=result[result.len()-1];target=sampled[at]
        if access_dry_segment(previous,target):result.push(target);at+=1;continue
        # Start on a dry shoulder, not the final centimetres of a bank. A 16m
        # search grid needs room to turn before reaching an irregular cove.
        loop _ in 0..min(3,result.len()-1):result.pop()
        previous=result[result.len()-1]
        start=at
        loop at<sampled.len()-1 and not access_dry_segment(sampled[at],sampled[at+1]):at+=1
        at=min(sampled.len()-1,at+4);target=sampled[at]
        path=access_track(previous.xz,target.xz,16.0,2200.0)
        if path.len()<2:
            eprint("ACCESS WATER refused {previous}/{target} samples={at-start}");return []
        eprint("ACCESS WATER detour {previous}/{target} points={path.len()}")
        result.extend(path[1..]);at+=1;changed=true
    if changed:result else:coarse
