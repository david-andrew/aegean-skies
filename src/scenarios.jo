# Whole-state builders. No input, wall clock, cosmetic RNG, or changes to the running world.
# Render resources are shared; everything that can affect play belongs to this result.
use 'scenario_catalog.jo'
use 'canal_geometry.jo'
use 'canal_traffic.jo'
use 'river_data.jo'
use 'life_types.jo'
use 'combat.jo'
use 'combat_bridge.jo'
use 'pilot.jo'
use 'planes.jo'
use 'flight.jo'
use 'objects.jo'
use 'settlements.jo'
use 'traffic.jo'
use 'vessel_types.jo'
import 'living_world.jo' as life
import 'living_types.jo' as data
import 'living_far_aircraft.jo' as registry
import 'living_far_stock.jo' as stock
import 'living_scene.jo' as scene
import 'life_scene.jo' as venues
import 'cargo_scene.jo' as cargo

# These IDs reuse existing meshes/markings, so repeated loads allocate no aircraft models.
const STRAIT_BLUE_MODEL = 7
const STRAIT_RED_MODEL = 5
const STRAIT_ENGAGEMENT = 1000000
const STRAIT_CENTER = vec3(138000,440,-73000)

enum ScenarioMode: walking, aboard, free
struct ScenarioState:
    world: data.World
    flyer: Flyer
    battle: Battle
    mode: ScenarioMode = .walking
    position: vec3
    yaw = 0.0
    hour = 9.5
    camera_yaw = 0.0
    camera_pitch = 0.25
    vessels: VesselFleet

# Fixture grants are explicit in the books. Subsequent use remains finite and conserved.
_scenario_fuel = (w: mut data.World, craft: int, ml: int):
    difference = ml - w.aircraft[craft].fuel_ml
    if difference >= 0: w.goods_ledger.created[int(data.GoodKind.fuel)] += difference
    else: w.goods_ledger.consumed[int(data.GoodKind.fuel)] -= difference
    w.aircraft[craft].fuel_ml = ml

_scenario_body = (w: mut data.World, craft: int, model: int, models: CraftModel[], at: vec3, h: f64) -> Combatant:
    person = w.aircraft[craft].owner
    k = craft_spec(.gull,models[model].contacts)
    k.fuel_capacity = f64(data.AIRFRAMES[0].tank_ml)/1000.0
    k.fuel_burn = f64(data.AIRFRAMES[0].burn_ml_sec)/1000.0
    power=clamp(k.arc_drag*(k.cruise_speed*0.86)^2/k.arc_thrust,0.2,1.0)
    s = CraftState(position=at,velocity=heading_vector(h)*f32(k.cruise_speed*0.86),orientation=quat_euler(0,-h,0),fuel=k.fuel_capacity,throttle=power,water_age=1)
    c = w.aircraft[craft]
    c.kind=.gull; c.model_index=model; c.livery_index=if model==STRAIT_BLUE_MODEL:4 else:2
    c.pose=data.Pose(pos=at,vel=s.velocity,rot=s.orientation,throttle=int(power*1000))
    c.previous_pos=at;c.move_owner=.scene;c.state=.airborne;c.place=-1;c.dock=-1
    c.hull=1000;c.engine=1000;c.last_scene_tick=-1
    w.aircraft[craft]=c
    _scenario_fuel(w,craft,int(k.fuel_capacity*1000))
    w.people[person].pose=c.pose
    if person in w.far.people:
        w.far.people[person].vehicle=craft
        registry.release_far_berth(w,craft)
    Combatant(craft,person,if model==STRAIT_BLUE_MODEL:1 else:2,k,s,model=model,
        pilot=CombatPilot(skill=0.78,nerve=0.85,formation=true,formation_heading=h,formation_speed=k.cruise_speed*0.86))

build_strait = (towns: Town[], models: CraftModel[], per_side:int = 8) -> ScenarioState:
    assert(per_side>=2 and per_side<=64)
    finish_settlement_registry()
    w=life.build_world(u64(1934),harbors_from_towns(towns))
    cargo.configure_cargo_scene(w,towns)
    venues.configure_life_scene(w,towns)
    # War is a saved diplomatic condition; this is an authored starting state, not a random raid.
    w.diplomacy=[DiplomaticRelation(1,2,tension=1000,stage=.war,last_incident_minute=0)]
    w.people[w.player].citizenship=1
    ids: int[][] = [[],[]]
    mine=w.people[w.player].craft
    # Normal departure creates the player's existing trip/occupancy records before relocation.
    scene.scene_player_departure(w)
    # Real pilots are drawn from national harbor cohorts and registered to real aircraft.
    # Select sorted IDs, never hash iteration order. Seven allies plus eight opponents.
    places=w.far.place_ids; places.sort()
    loop side in 1..3:
        loop mobilization in 0..(if per_side>8:32 else:1):
            loop place in places:
                if ids[side-1].len()>=(if side==1:per_side-1 else:per_side): break
                if not (place in w.far.harbors) or w.far.districts[place].born_country!=side: continue
                d=w.far.districts[place]
                if per_side>8:
                    w.far.districts[place].pilot_slots=64
                    missing=4000-stock.far_market_qty(w,place,5)
                    if missing>0:assert(stock.far_produce(w,place,5,missing,opening=true))
                if stock.far_market_qty(w,place,5)<4000: continue
                # Each harbor sends at most two pilots, within its registered cohort limits.
                loop slot in 0..2:
                    if ids[side-1].len()>=(if side==1:per_side-1 else:per_side): break
                    price=data.AIRFRAMES[0].price_cents
                    grant=max(0,price-w.accounts[d.household_account].cents)
                    w.accounts[d.household_account].cents+=grant;w.ledger.external_in_cents+=grant
                    r=registry.register_far_aircraft(w,place,.gull,d.household_account,"strait:{side}:{ids[side-1].len()}")
                    if r.craft>=0:
                        ids[side-1].push(r.craft)
                        if per_side>8:
                            # Launch each registered body before another uses the same berth.
                            _scenario_body(w,r.craft,if side==1:STRAIT_BLUE_MODEL else:STRAIT_RED_MODEL,models,STRAIT_CENTER,0)
    assert(ids[0].len()==per_side-1 and ids[1].len()==per_side,"The strait needs {per_side} per side; registered {ids[0].len()} allies and {ids[1].len()} opponents")
    actors:Combatant[]
    loop side in 0..2:
        members=if side==0:ids[0]+[mine] else:ids[1]
        h=if side==0:0.0 else:PI
        origin=STRAIT_CENTER+vec3(if side==0:-65 else:65,if side==0:0 else:35,if side==0:3000 else:-3000)
        loop slot in 0..members.len():
            # A loose V, with the player behind its centre: every wing pair is visible.
            row=(slot+1)/2
            offset=if slot==0:vec3(0,0,0) else:if members[slot]==mine:vec3(0,24,400) else:vec3((if slot%2==1:-1 else:1)*row*36,row*7,row*70)
            a=_scenario_body(w,members[slot],if side==0:STRAIT_BLUE_MODEL else:STRAIT_RED_MODEL,models,origin+quat_rotate(quat_euler(0,-h,0),offset),h)
            a.pilot.leader=members[0]
            a.pilot.formation_offset=offset
            a.pilot.skill=0.70+f64(slot%4)*0.055
            a.human=a.craft==mine;a.external=a.human;a.spec.player=a.human
            actors.push(a)
    b=start_engagement(STRAIT_ENGAGEMENT,1934,STRAIT_CENTER,actors)
    b.retreat_radius=18000;b.bullet_scale=5
    a=b.actors[combat_index(b,mine)]
    f=Flyer(kind=.gull,model=STRAIT_BLUE_MODEL,spec=a.spec,state=a.state,throttle=a.state.throttle,guns_locked=false,aim_heading=0)
    w.weather=[data.Weather(id=991,kind=.overcast,center=STRAIT_CENTER.xz,radius_m=100000,born_minute=-60,expires_minute=1440),
        data.Weather(id=992,kind=.squall,center=STRAIT_CENTER.xz,radius_m=100000,severity=240,born_minute=-60,expires_minute=1440)]
    w.next_weather=993
    ScenarioState(world=w,flyer=f,battle=b,mode=.aboard,position=f.state.position,hour=9.5)

# The original quay start, reconstructed from seed rather than a snapshot of a played world.
build_start_game = (towns:Town[],models:CraftModel[]) -> ScenarioState:
    w=life.build_world(u64(0),harbors_from_towns(towns));home=towns[0]
    model=default_craft_model(.gull)
    f=make_flyer(.gull,model,models[model].contacts,home.docks[0],atan2(f64(home.out.x),-f64(home.out.y)))
    f.spec.player=true
    adapter=scene.SceneAdapter();bind_living_player(f,w,adapter)
    cargo.configure_cargo_scene(w,towns)
    quay=home.quays[0];dock=home.docks[0].xz;edge=quay.b-quay.a
    near=quay.a+edge*clamp(dot(dock-quay.a,edge)/dot(edge,edge),0.0,1.0)
    start=near+normalize(dock-near)*(quay.width*0.5-1.2)
    position=vec3(start.x,walk_height(towns,f64(start.x),f64(start.y)),start.y)
    yaw=atan2(f64(home.out.x),f64(home.out.y))
    battle=Battle(enabled=true,seed=int(w.seed%100000))
    register_combat_body(battle,w,w.people[w.player].craft,f.spec,f.state,true)
    ScenarioState(world=w,flyer=f,battle=battle,position=position,yaw=yaw,camera_yaw=yaw+PI)

# A freshly repaired aircraft at an original canal workshop. The pursuers are
# registered finite aircraft, using the same combat owner as the strait fixture.
build_canal_takeoff=(towns:Town[],models:CraftModel[])->ScenarioState:
    init_canal_geometry()
    s=build_strait(towns,models,2)
    mine=s.world.people[s.world.player].craft
    f=s.flyer
    f.state=water_start(f.spec,canal_launch,canal_heading)
    f.state.throttle=0.22;f.throttle=0.22;f.aim_heading=canal_heading
    f.spec.player=true
    s.flyer=f;s.position=f.state.position;s.hour=9.5
    s.camera_yaw=canal_heading+PI;s.camera_pitch=0.22
    s.world.weather=[]
    forward=heading_vector(canal_heading)
    loop k in 0..s.battle.actors.len():
        actor=s.battle.actors[k]
        if actor.human:
            actor.state=f.state;actor.spec=f.spec
        else:
            # The allied courier is already leaving; the two pursuers approach
            # behind the repair quarter, leaving seconds to get through its bridges.
            offset=if actor.side==1:2200.0 else:-1500.0-f64(k)*160.0
            at=canal_launch+forward*f32(offset)+vec3(f32(k*55),if actor.side==1:260 else:190,0)
            actor=_scenario_body(s.world,actor.craft,actor.model,models,at,canal_heading)
            actor.pilot.formation=false
            actor.pilot.target=combat_index(s.battle,mine)
        actor.engagement=s.battle.engagement
        s.battle.actors[k]=actor
    s.battle=start_engagement(STRAIT_ENGAGEMENT+1,1935,canal_launch,s.battle.actors)
    s.battle.retreat_radius=18000;s.battle.bullet_scale=5
    c=s.world.aircraft[mine]
    c.pose=data.Pose(pos=f.state.position,vel=f.state.velocity,rot=f.state.orientation,throttle=220)
    c.previous_pos=f.state.position;c.state=.taxi;c.hull=1000;c.engine=1000;c.move_owner=.scene
    s.world.aircraft[mine]=c;s.world.people[s.world.player].pose=c.pose
    sync_canal_traffic(s.vessels,s.world)
    s

build_scenario = (key: str, towns: Town[], models: CraftModel[], per_side:int = 8) -> ScenarioState?:
    match key:
        "start":build_start_game(towns,models)
        "strait": build_strait(towns,models,per_side)
        "canal":build_canal_takeoff(towns,models)
        _: none

# Combat owns these sparse bodies (no Traffic/Trip integrator). Commit once after its tick.
# The scene adapter calls this for all internally-owned bodies outside the traffic registry.
commit_scenario_aircraft = (w: mut data.World, b: Battle):
    loop a in b.actors:
        if b.engagement<0 or a.engagement!=b.engagement or a.human or not a.present: continue
        c=w.aircraft[a.craft]
        phase=if a.status==.wreck or a.state.crashed:data.CraftState.wrecked else:if a.state.on_water:data.CraftState.taxi else:data.CraftState.airborne
        scene.scene_motion(w,a.craft,c.revision,data.Pose(pos=a.state.position,vel=a.state.velocity,rot=a.state.orientation,throttle=int(clamp(a.state.throttle,0.0,1.0)*1000)),
            min(c.fuel_ml,max(0,int(a.state.fuel*1000))),min(c.hull,max(0,int((1-a.state.hull_damage)*1000))),min(c.engine,max(0,int((1-a.state.engine_damage)*1000))),phase,false,false)
        w.aircraft[a.craft].state=phase
        if not a.bailed:w.people[a.person].pose=w.aircraft[a.craft].pose
    loop descent in b.descents:
        i=combat_index(b,descent.craft)
        if i<0 or b.engagement<0 or b.actors[i].engagement!=b.engagement:continue
        w.people[descent.person].pose.pos=descent.position
        w.people[descent.person].pose.vel=descent.velocity

# Read-only projection for existing engine sound, exhaust, glints and shadows. The traffic
# integrator never receives this list; draw_traffic also skips combat-owned bodies.
scenario_air_traffic = (w: data.World, b: Battle) -> Traffic[]:
    result:Traffic[]
    loop a in b.actors:
        if b.engagement<0 or a.engagement!=b.engagement or a.human or not a.present or a.status==.escaped:continue
        result.push(Traffic(craft=a.craft,person=a.person,name=w.people[a.person].name,why="Flying in the engagement",reason=data.Reason(purpose=.patrol,actor=a.person),
            kind=a.spec.kind,model=a.model,spec=a.spec,state=combat_render_state(a,b.render_alpha),plan=FlightPlan(phase=.cruise),town=-1,dock=-1,flying=a.status==.flying,materialized=true,prop_angle=a.prop))
    result
