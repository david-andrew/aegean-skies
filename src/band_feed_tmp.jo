# TEMPORARY: verbatim copies of the band's note feed (src/bar_band.jo) and its players' places
# (src/bar_scene.jo) from t3/musicians, so the floating notes can be built before that branch is
# merged. Delete this file when main has them: the same names defined twice will not compile.

use 'music_synth.jo'
use 'band_request.jo'
use 'bar_band.jo'
use 'bar_scene.jo'
use 'live_notes_shim.jo'

const SINGER_PART = 14              # (the singer's line in a feed: the choir's instrument number)

struct BandFeed:
    feed: LiveNoteFeed = LiveNoteFeed()
    piece = -1                      # (what it is loaded with: a catalogue piece,
    index = -1                      # and the set's number, -1 for none)
    frame = -1                      # the frame being heard (-1: the band isn't playing)
    heard = false                   # (from the stream)

# A piece's events with the singer's line added (for a number of the set that has one).
bar_note_events = (piece: int, index: int) -> MusicEvent[]:
    s = MusicSynth()
    music_load(s, piece)
    events = s.events
    if index >= 0:
        loop n in singer_line(events, BAR_SET[index]):
            events.push(MusicEvent(n.start, max(n.end - n.start, 1), int(round(n.pitch)), SINGER_PART, 0.6, 0.6))
    events

_bar_feed_load = (b: mut BandFeed, piece: int, index: int):
    if b.piece == piece and b.index == index: return
    live_notes_load(b.feed, bar_note_events(piece, index), if index >= 0: BAR_SET[index].lead else: -1)
    b.piece = piece; b.index = index

# Step the band's feed to now: the notes that started since the last step.
bar_note_feed = (b: mut BandFeed, m: BarMusic, tick: int, requests: BandRequest[] = []) -> LiveNote[]:
    p = bar_set_position(tick, requests)
    if not p.playing:
        b.frame = -1; b.heard = false
        return []
    _bar_feed_load(b, BAR_SET[p.index].piece, p.index)
    b.heard = m.voice >= 0 and m.index == p.index
    b.frame = if b.heard: live_notes_heard_frame(m.rendered, queued_samples(m.voice)) else: live_notes_clock_frame(p.seconds)
    live_notes_step(b.feed, b.frame)


struct BandSpot:
    who: int                        # 0 the singer, 1 the pianist, 2 the bassist, 3 the reeds
    instrument: int                 # the part played (MusicInstrument, 14 the singer's line), -1 none
    pos: vec3
    yaw: f64
    seated = false

# (also where each part's player is, for whatever is shown over them)
band_spots = (h: HotelScene, lineup: int, singing: bool) -> BandSpot[]:
    x = h.stage_out
    z = h.table_z
    out = atan2(f64(x.x), f64(x.z))
    spots: BandSpot[]
    piano_seat = h.stage - x * 0.8 - z * 1.5
    if lineup <= 4: spots.push(BandSpot(1, 6, piano_seat, out + PI, true))
    else: spots.push(BandSpot(1, -1, piano_seat + x * 0.35, out + 0.5, true))
    if lineup == 1 or lineup == 2: spots.push(BandSpot(2, 13, h.stage - x * 0.9 + z * 0.6, out + 0.4))
    if lineup == 1: spots.push(BandSpot(3, 4, h.stage + x * 0.1 + z * 2.0, out - 0.3))
    if lineup == 2 or lineup == 3: spots.push(BandSpot(3, 9, h.stage + x * 0.1 + z * 2.0, out - 0.3))
    if lineup == 3: spots.push(BandSpot(2, 8, h.stage - x * 0.2 + z * 0.4, out + 0.2))
    if lineup == 4 or lineup == 6: spots.push(BandSpot(3, 0, h.stage + x * 0.2 + z * 1.6, out - 0.35))
    if lineup == 5 or lineup == 6: spots.push(BandSpot(2, 7, h.stage - x * 0.2 + z * 0.4, out, true))
    if lineup == 5: spots.push(BandSpot(3, 8, h.stage + x * 0.3 + z * 1.8, out - 0.3))
    if singing: spots.push(BandSpot(0, 14, h.stage + x * 0.9 + z * 0.3, out))
    spots
