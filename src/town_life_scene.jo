# Publish fixtures from the same site plans as the close renderer, independent
# of camera visibility, quality and ornament density. No new resident identities.
use 'living_types.jo'
use 'life_types.jo'
use 'town_sites.jo'
use 'town_architecture.jo'
use 'settlements.jo'
use 'objects.jo'
use 'geography.jo'

town_fixture_venues = (place: int,s: TownSite,neighbors: TownSite[]) -> LifeVenue[]:
    result: LifeVenue[]
    if s.chapel or s.service: return result
    out=vec3(site_front(s).x,0,site_front(s).y)
    prefix="street:{place}:{s.seed}"
    chair=site_point(s,-s.width*0.2+2.2,s.depth*0.5+0.9)
    if arch_clear(neighbors,chair,0.4): result.push(LifeVenue(place,prefix+":seat",.seat,place_point(chair)+vec3(0,0.12,0),facing=out,capacity=1,prop_pos=place_point(chair)+vec3(0,0.12,0),prop_yaw=s.yaw))
    if s.seed%3==0:
        at=site_point(s,s.width*0.12,s.depth*0.5+1.0)
        line=site_point(s,s.width*0.12,s.depth*0.5+0.4)
        if arch_clear(neighbors,at,0.4) and abs(place_ground(at)-place_ground(line))<0.3: result.push(LifeVenue(place,prefix+":laundry",.laundry,place_point(at)+vec3(0,0.12,0),facing=-out,capacity=1,prop_pos=place_point(line)+vec3(0,2.15,0),prop_yaw=s.yaw))
    if s.seed%3==1:
        if let court=arch_court(s,neighbors):
            at=site_point(s,f64(court.x),f64(court.y)+0.8)
            oven=site_point(s,f64(court.x),f64(court.y)-1.0)
            result.push(LifeVenue(place,prefix+":oven",.oven,place_point(at)+vec3(0,0.12,0),facing=-out,capacity=1,prop_pos=place_point(oven)+vec3(0,0.12,0),prop_yaw=s.yaw))
    loop side in [-1.0,1.0]:
        at=site_point(s,side*(s.width*0.5+1.8),s.depth*0.5+2.8)
        if arch_clear(neighbors,at,0.6): result.push(LifeVenue(place,prefix+":alley:{side}",.alley,place_point(at)+vec3(0,0.12,0),facing=out,capacity=1))
    result

configure_town_fixtures = (w: mut World,towns: Town[]):
    changed=false
    loop place in 0..min(towns.len(),w.places.len()):
        present=false
        loop v in w.life_venues:
            if v.place==place and v.key.starts_with("street:"): present=true; break
        if present: continue
        tw=towns[place]; changed=true
        loop s in tw.sites: w.life_venues.extend(town_fixture_venues(place,s,tw.sites))
    if changed: w.life_venues.sort((v: LifeVenue): (v.place,int(v.kind),v.key))

prepare_far_fixtures = (w: mut World,observer: vec3):
    if not w.far.populated: return
    loop index in settlement_bins.get(geography_bin(f64(observer.x),f64(observer.z)),[]):
        s=world_settlements[index]
        if s.legacy>=0 or length(s.center-observer)>500 or not (s.id in w.far.districts): continue
        present=false
        loop v in w.place_contexts[s.id].venues:
            if v.key.starts_with("street:"): present=true; break
        if present: continue
        neighbors: TownSite[]
        keys: {int:bool}={}
        loop home in w.far.districts[s.id].homes:
            loop cell in place_candidate_cells(s,place_to_local(s,home.door.xz)):
                if let lot=place_lot(s,cell.0,cell.1):
                    if lot.seed in keys: continue
                    if let parcel=place_ground_lot(s,lot):
                        keys[lot.seed]=true; neighbors.push(site_from_parcel(parcel))
        loop home in w.far.districts[s.id].homes:
            loop site in neighbors:
                if home.key=="home:{s.id}:{site.seed}": w.place_contexts[s.id].venues.extend(town_fixture_venues(s.id,site,neighbors))
