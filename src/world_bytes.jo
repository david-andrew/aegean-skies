# The World in the binary form for saves (slot encoding 4): Sloppy's to_bytes and from_bytes, and
# its stepped byte_writer for a save spread over frames. The bytes are the live World's own (its
# maps in the order they were filled), so a load gives back exactly the World that was saved.
use 'living_types.jo'

world_to_bytes = (w: World) -> u8[]: to_bytes(w)
world_from_bytes = (b: u8[]) -> World | TextError: from_bytes[World](b)
world_writer = (w: World) -> ByteWriter: byte_writer(w)
