use 'thermal_sites.jo'
use 'painted_letters.jo'
use 'objects.jo'
use 'town_details.jo'
use 'town_architecture.jo'
use 'world_source.jo'
use 'world_point.jo'
use 'world_particles.jo'
use 'curved_world.jo'
use 'river_render.jo'
use 'render_space.jo'
use 'look.jo'
use 'quality.jo'
use 'river_banks.jo'
use 'town_regional_mesh.jo'
use 'town_region.jo'

struct ThermalBatch:
    ready:bool=false
    solid:Mesh=Mesh()
    water:Mesh=Mesh()
thermal_batches=[ThermalBatch(),ThermalBatch()]

thermal_mesh=(site:ThermalSite)->Vertex3D[]:
    vs:Vertex3D[]
    stone=if site.country==1:rgb(0.63,0.57,0.47) else:rgb(0.80,0.77,0.66)
    render=if site.country==1:rgb(0.82,0.75,0.61) else:rgb(0.92,0.88,0.77)
    wood=rgb(0.29,0.23,0.16);joinery=if site.country==1:SHUTTER_COLORS[1] else:SHUTTER_COLORS[0]
    d1=site.drops.x;d2=site.drops.y
    ground=(q:vec2)->f64:world_source_surface(f64(thermal_world(site,vec3(q.x,0,q.y)).x),f64(thermal_world(site,vec3(q.x,0,q.y)).z))-f64(site.center.y)
    on_stair=(q:vec2)->bool:
        loop stair in thermal_stairs(site):
            if abs(f64(q.x)-stair.x)<=stair.width*0.5+0.2 and f64(q.y)>=stair.z0-0.2 and f64(q.y)<=stair.z1+0.2:return true
        false
    in_pool=(q:vec2)->bool:length(q-THERMAL_POOL)<4.7 or length(q-THERMAL_COOL_POOL)<2.9
    # Paving on each terrace (2 m stones over the carved ground, no slab).
    loop t in THERMAL_TERRACES:
        z=t.low.y
        loop z<t.high.y-0.01:
            x=t.low.x
            loop x<t.high.x-0.01:
                mid=vec2(f32(x)+1.0,f32(z)+1.0)
                level=thermal_level(site,mid)
                if not in_pool(mid) and not on_stair(mid) and level!=none and abs(level!+thermal_drop(site,t.index))<0.01:
                    color=stone*vec4(f32(0.94+f64((int(x)*7+int(z)*3)%7)*0.012),1,1,1)
                    add_box(vs,vec3(mid.x,f32(-thermal_drop(site,t.index))-0.13,mid.y),vec3(1.98,0.26,1.98),color)
                x+=2.0
            z+=2.0
    # Retaining walls where a terrace stands above the ground beside it, and cut
    # walls where the hillside rises behind it; parapets on the higher drops.
    loop t in THERMAL_TERRACES:
        top= -thermal_drop(site,t.index)
        loop edge in 0..4:
            a=if edge==0:t.low else:if edge==1:vec2(t.high.x,t.low.y) else:if edge==2:t.high else:vec2(t.low.x,t.high.y)
            b=if edge==0:vec2(t.high.x,t.low.y) else:if edge==1:t.high else:if edge==2:vec2(t.low.x,t.high.y) else:t.low
            d=b-a;span=f64(length(d));dir=d/f32(span);normal=vec2(dir.y,-dir.x)
            loop k in 0..int(ceil(span)):
                q=a+dir*f32(f64(k)+0.5);outside=q+normal*0.5
                if on_stair(q) or on_stair(outside):continue
                beside=if let level=thermal_level(site,outside):level else:ground(outside)
                if top-beside>0.3:
                    bottom=beside-0.4;h=top-bottom+(if top-beside>1.2:0.45 else:0.0)
                    add_box(vs,vec3(q.x,f32(bottom+h*0.5),q.y)+vec3(normal.x,0,normal.y)*0.25,vec3(if edge%2==0:1.02 else:0.5,f32(h),if edge%2==0:0.5 else:1.02),stone*vec4(0.92,0.92,0.9,1))
                else if beside-top>0.3:
                    h=beside-top+0.15
                    add_box(vs,vec3(q.x,f32(top+h*0.5),q.y)+vec3(normal.x,0,normal.y)*0.25,vec3(if edge%2==0:1.02 else:0.5,f32(h),if edge%2==0:0.5 else:1.02),stone*vec4(0.86,0.85,0.82,1))
    # Stone flights between the terraces and down to the path.
    loop stair in thermal_stairs(site):
        steps=max(1,int(ceil(abs(stair.bottom-stair.top)/THERMAL_RISER)))
        run=(stair.z1-stair.z0)/f64(steps)
        loop k in 0..steps:
            z=stair.z0+(f64(k)+0.5)*run;top= -thermal_stair_drop(stair,z)
            bottom=min(top-0.2,ground(vec2(f32(stair.x),f32(z)))-0.3)
            add_box(vs,vec3(f32(stair.x),f32((top+bottom)*0.5),f32(z)),vec3(f32(stair.width),f32(top-bottom),f32(run)+0.02),stone)
        loop side in [-1.0,1.0]:
            x=stair.x+side*(stair.width*0.5+0.15);mid=(stair.z0+stair.z1)*0.5
            add_box(vs,vec3(f32(x),f32(-(stair.top+stair.bottom)*0.5+0.2),f32(mid)),vec3(0.3,f32(abs(stair.bottom-stair.top)+0.9),f32(stair.z1-stair.z0)),stone*vec4(0.9,0.9,0.88,1))
    loop solid in thermal_solids(site):
        if solid.kind!=0:continue       # coping and houses are meshed separately
        add_box(vs,vec3(0,0,0),solid.half*2.0,if solid.half.y<1:stone else:render,translation(solid.at)*rotation_y(solid.yaw))
    # Domed communal bathhouse, warm masonry in Kalyra, chalk render in Orenthia.
    add_cylinder(vs,vec3(-8,4.4,-7),5.3,0.55,stone,24)
    add_sphere(vs,vec3(0,0,0),1,render,24,12,translation(vec3(-8,4.9,-7))*scaling(vec3(5.2,3.6,5.2)))
    add_cylinder(vs,vec3(-8,8.3,-7),0.50,0.65,stone,10)
    add_sphere(vs,vec3(-8,9.0,-7),0.65,render,10,5)
    innheight=if site.country==1:8.0 else:5.0
    if site.country==1:add_gable(vs,vec3(8,f32(innheight),-8),12.2,13.2,3.1,ROOFS[1],mat4())
    else:
        add_box(vs,vec3(8,5.15,-8),vec3(12,0.3,13),render)
        loop x in [2.3,13.7]:add_box(vs,vec3(f32(x),5.65,-8),vec3(0.35,0.7,13),render)
        loop z in [-14.3,-1.7]:add_box(vs,vec3(8,5.65,f32(z)),vec3(11.1,0.7,0.35),render)
    if site.country==1:
        loop v in arch_vertices(19,1):vs.push(Vertex3D(v.pos+vec3(8,4.5,-1.45),v.normal,v.uv,v.color))
    # Window recesses and shutters stand proud by real centimetres, never share
    # a lower-wall plane. All geometry remains inside this local metric chart.
    loop x in [4.3,11.7]:
        loop y in (if site.country==1:[1.7,5.6] else:[1.9]):
            add_box(vs,vec3(f32(x),f32(y),-1.66),vec3(1.35,1.9,0.12),rgb(0.16,0.20,0.21))
            loop side in [-1.0,1.0]:add_box(vs,vec3(f32(x+side*0.89),f32(y),-1.52),vec3(0.61,1.95,0.14),joinery)
    # A vine pergola shades the benches beside the hot pool.
    loop x in [7.0,11.5]:
        loop z in [3.0,9.0]:add_box(vs,vec3(f32(x),1.6-d1,f32(z)),vec3(0.20,3.2,0.20),wood)
    loop x in 7..12:add_box(vs,vec3(f32(x),3.25-d1,6),vec3(0.13,0.20,6.7),wood)
    loop z in [3.0,9.0]:add_box(vs,vec3(9.25,3.1-d1,f32(z)),vec3(5.0,0.18,0.22),wood)
    loop k in 0..9:add_sphere(vs,vec3(7.2+f32(k%3)*2.1,3.35-d1,3.6+f32(k/3)*2.2),0.95,rgb(0.32,0.39,0.21),7,4)
    loop z in [4.0,8.0]:
        add_box(vs,vec3(9.25,0.55-d1,f32(z)),vec3(3,0.17,0.7),wood)
        loop x in [8.25,10.25]:add_box(vs,vec3(f32(x),0.25-d1,f32(z)),vec3(0.25,0.5,0.55),stone)
    # Continuous stone coping round both pools; the rims' inner faces hold the water.
    loop pool in [(THERMAL_POOL,4.4,-d1),(THERMAL_COOL_POOL,2.6,-d2)]:
        c=vec3(pool.0.x,pool.2,pool.0.y);r=f32(pool.1);n=if r>3.0:48 else:32
        loop k in 0..n:
            a=f64(k)*TAU/f64(n);b=f64(k+1)*TAU/f64(n)
            ia=c+vec3(f32(cos(a))*r,0.45,f32(sin(a))*r);ib=c+vec3(f32(cos(b))*r,0.45,f32(sin(b))*r)
            oa=c+vec3(f32(cos(a))*(r+0.8),0.45,f32(sin(a))*(r+0.8));ob=c+vec3(f32(cos(b))*(r+0.8),0.45,f32(sin(b))*(r+0.8))
            add_outward_triangle(vs,ia,ib,oa,stone,c-vec3(0,1,0));add_outward_triangle(vs,oa,ib,ob,stone,c-vec3(0,1,0))
            loop pair in [(ia,ib),(ob,oa)]:
                a0=pair.0;b0=pair.1;c0=a0-vec3(0,1.1,0);d0=b0-vec3(0,1.1,0)
                inside=(a0+b0)*0.5+normalize(vec3(a0.x-c.x,0,a0.z-c.z))*f32(if pair.0==ia:0.4 else:-0.4)
                add_outward_triangle(vs,a0,b0,c0,stone,inside);add_outward_triangle(vs,c0,b0,d0,stone,inside)
        add_cylinder(vs,c-vec3(0,0.65,0),r,0.1,rgb(0.48,0.56,0.43),n)
    # The spring rises from rocks in the cut behind the bathhouse; its rill runs
    # along the upper terrace, spills down the walls and feeds both pools.
    back=ground(vec2(-12,-16))
    loop k in 0..8:
        add_sphere(vs,vec3(-14+f32(k%4)*1.3,f32(0.3+f64(k/4)*min(2.0,max(0.6,back*0.4))),-15.2+f32(k%2)*0.8),1.4,stone*vec4(0.85,0.83,0.8,1),7,4)
    water=rgb(0.24,0.41,0.39)
    add_box(vs,vec3(-15,0.06,-7.4),vec3(0.9,0.12,15.2),stone);add_box(vs,vec3(-15,0.14,-7.4),vec3(0.5,0.02,15.0),water)
    add_box(vs,vec3(-15,-d1*0.5,0.18),vec3(0.5,d1,0.06),water)
    add_box(vs,vec3(-11.5,0.06-d1,1.2),vec3(7.0,0.12,0.9),stone);add_box(vs,vec3(-11.5,0.14-d1,1.2),vec3(6.8,0.02,0.5),water)
    add_box(vs,vec3(-4.6,-(d1+d2)*0.5,14.06),vec3(0.5,d2-d1,0.06),water)
    add_box(vs,vec3(-4.6,0.06-d2,14.6),vec3(0.9,0.12,1.0),stone);add_box(vs,vec3(-4.6,0.14-d2,14.6),vec3(0.5,0.02,0.9),water)
    # Plane trees for shade round the terraces, and a fig by the lower pool.
    loop tree in [vec3(-21,0,-11),vec3(21,0,-12),vec3(-25,0,10),vec3(23,0,15)]:
        q=vec2(tree.x,tree.z)
        river_tree(vs,vec3(tree.x,f32(if let level=thermal_level(site,q):level else:ground(q)),tree.z),1,f64(tree.x),true)
    fig=vec3(-10,-d2,20)
    add_cylinder(vs,fig,0.28,2.2,rgb(0.52,0.48,0.40),6,0.14)
    loop k in 0..6:
        a=f64(k)*TAU/6.0
        add_sphere(vs,vec3(0,0,0),1.0,rgb(0.26,0.36,0.17),7,4,translation(fig+vec3(f32(cos(a))*1.7,2.9+f32(k%2)*0.5,f32(sin(a))*1.7))*scaling(vec3(2.0,1.3,2.0)))
    # Two village houses on the middle terrace, the bath's neighbours.
    loop k in 0..thermal_houses.len():
        house=thermal_houses[k]
        hm=translation(vec3(house.x,-d1,house.y))*rotation_y(if k==0:0.0 else:PI)
        start=vs.len()
        region_house(vs,hm,f64(house.z),f64(house.w),6.2,site.country,false)
        loop j in start..vs.len():vs[j].color*=town_region_color(site.place+k*17,site.country)
    # Enamel plates on real brackets, well clear of the building faces.
    loop item in [(vec3(-8,3.2,-1.5),"THERMAL BATHS"),(vec3(8,3.2,-1.5),"INN")]:
        add_box(vs,item.0,vec3(3.8,0.65,0.16),joinery)
        painted_letters(vs,item.1,item.0+vec3(0,-0.025,0.12),0.26,rgb(0.95,0.91,0.81))
    # The local transform is applied once; no enormous translation is baked.
    m=rotation_y(site.yaw)
    [loop v in vs:Vertex3D(transform_point(m,v.pos),transform_dir(m,v.normal),v.uv,v.color)]

thermal_water_mesh=(site:ThermalSite)->InlandWaterVertex[]:
    result:InlandWaterVertex[];center=thermal_pool(site)
    loop pool in [(THERMAL_POOL,4.4,0.2-site.drops.x),(THERMAL_COOL_POOL,2.6,0.2-site.drops.y)]:
        loop k in 0..48:
            a=f64(k)*TAU/48;b=f64(k+1)*TAU/48
            loop q in [vec2(0,0),vec2(f32(cos(b)),f32(sin(b)))*f32(pool.1),vec2(f32(cos(a)),f32(sin(a)))*f32(pool.1)]:
                p=thermal_world(site,vec3(pool.0.x+q.x,pool.2,pool.0.y+q.y))
                result.push(InlandWaterVertex(p,vec2(0.02,0),0.75,p.xz-center.xz))
    result

prepare_thermal=(k:int):
    global thermal_batches
    if thermal_batches[k].ready:return
    thermal_batches[k]=ThermalBatch(true,mesh(thermal_mesh(THERMAL_SITES[k])),mesh(thermal_water_mesh(THERMAL_SITES[k])))

draw_thermal=(L:Light,t:f64):
    loop k in 0..THERMAL_SITES.len():
        site=THERMAL_SITES[k]
        if length(scene_camera()-site.center)>1800:continue
        prepare_thermal(k);draw(obj_sh,thermal_batches[k].solid,obj_params(L,t,anchor=world_point(site.center)))

draw_thermal_water=(depth:Texture,L:Light,t:f64):
    loop k in 0..THERMAL_SITES.len():
        site=THERMAL_SITES[k]
        if length(scene_camera()-site.center)>900:continue
        prepare_thermal(k)
        draw_inland_water(thermal_batches[k].water,thermal_pool(site),depth,L,t,vec3(0,0,0),vec3(0.11,0.22,0.20),vec3(0.29,0.42,0.35),0.45)

# Steam drifts off the hot pool and the spring, thickest in the cool of the
# morning and evening, and tall enough to mark the baths from the air.
draw_thermal_steam=(t:f64,L:Light):
    steam=WorldParticles(gravity=vec3(0,0,0))
    cool=1.0-0.4*smoothstep(0.30,0.75,f64(L.sun_dir.y))
    loop site in THERMAL_SITES:
        d=f64(length(scene_camera()-site.center))
        if d>2600:continue
        near=d<220.0
        # From the air the plume is what marks the baths: more, larger, brighter
        # puffs that climb higher than the ones seen on the terraces.
        count=if near:(if render_quality.tier==0:28 else:52) else:40
        loop k in 0..count:
            phase=(t*(if near:0.10 else:0.05)+f64(k)*0.61803398875)%1.0;angle=f64(k)*2.399963
            source=if k%5==0:vec3(-13,0.4,-14.5) else:vec3(THERMAL_POOL.x,0.3-site.drops.x,THERMAL_POOL.y)
            radius=if k%5==0:1.2 else:3.4
            rise=if near:3.6 else:26.0
            # Drift with the breeze down the slope as it rises and thins.
            at=source+vec3(f32(cos(angle)*radius+phase*1.6),f32(phase*rise),f32(sin(angle)*radius+phase*2.4))
            alpha=f32(min(1.0,sin(phase*PI)*(if near:0.68 else:1.15)*cool))
            size=if near:1.8+phase*3.8 else:9.0+phase*16.0
            tint=if near:vec4(0.88,0.91,0.91,alpha) else:vec4(0.97,0.98,0.98,alpha)
            steam.items.push(WorldParticle(thermal_world(site,at),vec3(0,0,0),1,1,f32(size),tint))
    draw_curved_particles(steam,false)
