use 'thermal_sites.jo'
use 'objects.jo'
use 'town_details.jo'
use 'town_architecture.jo'
use 'world_source.jo'
use 'world_point.jo'
use 'world_particles.jo'
use 'curved_world.jo'
use 'river_render.jo'
use 'render_space.jo'
use 'look.jo'
use 'quality.jo'

struct ThermalBatch:
    ready:bool=false
    solid:Mesh=Mesh()
    water:Mesh=Mesh()
thermal_batches=[ThermalBatch(),ThermalBatch()]

thermal_mesh=(site:ThermalSite)->Vertex3D[]:
    vs:Vertex3D[]
    stone=if site.country==1:rgb(0.63,0.57,0.47) else:rgb(0.80,0.77,0.66)
    render=if site.country==1:rgb(0.82,0.75,0.61) else:rgb(0.92,0.88,0.77)
    wood=rgb(0.29,0.23,0.16);joinery=if site.country==1:SHUTTER_COLORS[1] else:SHUTTER_COLORS[0]
    # Small masonry terrace with an actual pool opening. Its foundations extend
    # down to canonical ground; no floating paving or coplanar frontage layers.
    loop z in -15..15:
        loop x in -15..15:
            mid=vec2(f32(x)+0.5,f32(z)+0.5)
            if length(mid-vec2(-1,7))<4.7:continue
            color=stone*vec4(f32(0.94+f64((x*x+z*z)%7)*0.012),1,1,1)
            add_box(vs,vec3(mid.x,-0.14,mid.y),vec3(1,0.28,1),color)
    loop side in [-1.0,1.0]:
        loop k in -15..15:
            loop edge in 0..2:
                local=if edge==0:vec3(f32(side*15),0,f32(k)+0.5) else:vec3(f32(k)+0.5,0,f32(side*15))
                if edge==1 and side>0 and abs(local.x)<2.5:continue
                p=thermal_world(site,local);bottom=min(-0.3,world_source_surface(f64(p.x),f64(p.z))-f64(site.center.y)-0.2)
                add_box(vs,local+vec3(0,f32(bottom*0.5),0),if edge==0:vec3(0.7,f32(-bottom),1) else:vec3(1,f32(-bottom),0.7),stone)
    steps=max(1,int(ceil((f64(site.center.y)-f64(site.road.y))/0.16)))
    loop k in 0..steps:
        z=28.0-13.0*(f64(k)+0.5)/f64(steps);top=mix(f64(site.road.y),f64(site.center.y),f64(k+1)/f64(steps))-f64(site.center.y)
        p=thermal_world(site,vec3(0,0,f32(z)));bottom=min(top-0.15,world_source_surface(f64(p.x),f64(p.z))-f64(site.center.y)-0.15)
        add_box(vs,vec3(0,f32((top+bottom)*0.5),f32(z)),vec3(4.4,f32(top-bottom),f32(13.0/f64(steps))),stone)
    loop solid in thermal_solids(site):
        if solid.at.z>2:continue       # the coping uses a continuous ring below
        add_box(vs,vec3(0,0,0),solid.half*2.0,render,translation(solid.at)*rotation_y(solid.yaw))
    # Domed communal bathhouse, warm masonry in Kalyra, chalk render in Orenthia.
    add_cylinder(vs,vec3(-8,4.4,-7),5.3,0.55,stone,24)
    add_sphere(vs,vec3(0,0,0),1,render,24,12,translation(vec3(-8,4.9,-7))*scaling(vec3(5.2,3.6,5.2)))
    add_cylinder(vs,vec3(-8,8.3,-7),0.50,0.65,stone,10)
    add_sphere(vs,vec3(-8,9.0,-7),0.65,render,10,5)
    innheight=if site.country==1:8.0 else:5.0
    if site.country==1:add_gable(vs,vec3(8,f32(innheight),-8),12.2,13.2,3.1,ROOFS[1],mat4())
    else:
        add_box(vs,vec3(8,5.15,-8),vec3(12,0.3,13),render)
        loop x in [2.3,13.7]:add_box(vs,vec3(f32(x),5.65,-8),vec3(0.35,0.7,13),render)
        loop z in [-14.3,-1.7]:add_box(vs,vec3(8,5.65,f32(z)),vec3(11.1,0.7,0.35),render)
    # Window recesses and shutters stand proud by real centimetres, never share
    # a lower-wall plane. All geometry remains inside this local metric chart.
    loop x in [4.3,11.7]:
        loop y in (if site.country==1:[1.7,5.6] else:[1.9]):
            add_box(vs,vec3(f32(x),f32(y),-1.66),vec3(1.35,1.9,0.12),rgb(0.16,0.20,0.21))
            loop side in [-1.0,1.0]:add_box(vs,vec3(f32(x+side*0.89),f32(y),-1.52),vec3(0.61,1.95,0.14),joinery)
    # A shaded gallery and benches at the inn, with vines above actual posts.
    loop x in [3.0,13.0]:
        loop z in [0.0,3.0]:add_box(vs,vec3(f32(x),1.6,f32(z)),vec3(0.20,3.2,0.20),wood)
    loop x in 3..14:add_box(vs,vec3(f32(x),3.25,1.5),vec3(0.13,0.20,3.7),wood)
    loop z in [0.0,3.0]:add_box(vs,vec3(8,3.1,f32(z)),vec3(10.5,0.18,0.22),wood)
    loop k in 0..7:add_sphere(vs,vec3(3.4+f32(k)*1.5,3.3,1.5),0.9,rgb(0.32,0.39,0.21),7,4)
    loop z in [4.0,10.0]:
        add_box(vs,vec3(11,0.55,f32(z)),vec3(3,0.17,0.7),wood)
        loop x in [10.0,12.0]:add_box(vs,vec3(f32(x),0.25,f32(z)),vec3(0.25,0.5,0.55),stone)
    # Continuous stone coping. The rim's inner face contains the water exactly.
    loop k in 0..48:
        a=f64(k)*TAU/48;b=f64(k+1)*TAU/48
        ia=vec3(-1+f32(cos(a))*4.4,0.45,7+f32(sin(a))*4.4);ib=vec3(-1+f32(cos(b))*4.4,0.45,7+f32(sin(b))*4.4)
        oa=vec3(-1+f32(cos(a))*5.2,0.45,7+f32(sin(a))*5.2);ob=vec3(-1+f32(cos(b))*5.2,0.45,7+f32(sin(b))*5.2)
        add_outward_triangle(vs,ia,ib,oa,stone,vec3(-1,-1,7));add_outward_triangle(vs,oa,ib,ob,stone,vec3(-1,-1,7))
        loop pair in [(ia,ib),(ob,oa)]:
            a0=pair.0;b0=pair.1;c0=a0-vec3(0,1.1,0);d0=b0-vec3(0,1.1,0)
            inside=(a0+b0)*0.5+normalize(vec3(a0.x+1,0,a0.z-7))*f32(if pair.0==ia:0.4 else:-0.4)
            add_outward_triangle(vs,a0,b0,c0,stone,inside);add_outward_triangle(vs,c0,b0,d0,stone,inside)
    add_cylinder(vs,vec3(-1,-0.65,7),4.4,0.1,rgb(0.48,0.56,0.43),48)
    # Spring source in a low rock outcrop, with its carved stone spout and rill.
    loop k in 0..6:
        add_sphere(vs,vec3(-10+f32(k%3)*1.2,0.3+f32(k/3)*0.55,6+f32(k%2)*1.5),1.3,stone,7,4)
    add_box(vs,vec3(-7,0.75,7),vec3(3,0.4,0.6),stone)
    add_box(vs,vec3(-6.6,0.99,7),vec3(2.8,0.025,0.30),rgb(0.24,0.41,0.39))
    # The local transform is applied once; no enormous translation is baked.
    m=rotation_y(site.yaw)
    [loop v in vs:Vertex3D(transform_point(m,v.pos),transform_dir(m,v.normal),v.uv,v.color)]

thermal_water_mesh=(site:ThermalSite)->InlandWaterVertex[]:
    result:InlandWaterVertex[];center=thermal_pool(site)
    loop k in 0..48:
        a=f64(k)*TAU/48;b=f64(k+1)*TAU/48
        loop q in [vec2(0,0),vec2(f32(cos(b)),f32(sin(b)))*4.4,vec2(f32(cos(a)),f32(sin(a)))*4.4]:
            p=thermal_world(site,vec3(-1+q.x,0.20,7+q.y))
            result.push(InlandWaterVertex(p,vec2(0.02,0),0.75,p.xz-center.xz))
    result

prepare_thermal=(k:int):
    global thermal_batches
    if thermal_batches[k].ready:return
    thermal_batches[k]=ThermalBatch(true,mesh(thermal_mesh(THERMAL_SITES[k])),mesh(thermal_water_mesh(THERMAL_SITES[k])))

draw_thermal=(L:Light,t:f64):
    loop k in 0..THERMAL_SITES.len():
        site=THERMAL_SITES[k]
        if length(scene_camera()-site.center)>1800:continue
        prepare_thermal(k);draw(obj_sh,thermal_batches[k].solid,obj_params(L,t,anchor=world_point(site.center)))

draw_thermal_water=(depth:Texture,L:Light,t:f64):
    loop k in 0..THERMAL_SITES.len():
        site=THERMAL_SITES[k]
        if length(scene_camera()-site.center)>900:continue
        prepare_thermal(k)
        draw_inland_water(thermal_batches[k].water,thermal_pool(site),depth,L,t,vec3(0,0,0),vec3(0.11,0.22,0.20),vec3(0.29,0.42,0.35),0.45)

draw_thermal_steam=(t:f64):
    steam=WorldParticles(gravity=vec3(0,0,0))
    loop site in THERMAL_SITES:
        if length(scene_camera()-site.center)>180:continue
        loop k in 0..(if render_quality.tier==0:16 else:32):
            phase=(t*0.12+f64(k)*0.61803398875)%1.0;angle=f64(k)*2.399963
            at=vec3(-1+f32(cos(angle)*3.4+phase*1.2),f32(0.3+phase*2.8),7+f32(sin(angle)*3.4+phase*0.4))
            alpha=f32(sin(phase*PI)*0.16)
            steam.items.push(WorldParticle(thermal_world(site,at),vec3(0,0,0),1,1,f32(1.0+phase*2.4),vec4(0.82,0.87,0.87,alpha)))
    draw_curved_particles(steam,false)
