# The pilot's notebook (J): notices torn from the harbor boards, a log of the errands (agreed,
# loaded, delivered and paid, or missed), and whatever one writes. Kept between sessions.

use 'hud.jo'
use 'panels.jo'

struct Note:
    text: str
    at: str                         # the day and time it was written
    job = -1                        # a notice from a board: the job it is about (-2: a log line)
    poster = -1                     # (and who posted it)
    title = ""

struct Notebook:
    notes: Note[]
    live: str[]
    open = false
    draft = ""
    page = 0

load_notebook = () -> Notebook:
    n = Notebook()
    empty: Note[]
    n.notes = load_value("notebook", empty)
    n

save_notebook = (n: Notebook): save_value("notebook", n.notes)

# pin a notice in (once)
pin_notice = (n: mut Notebook, job: int, poster: int, title: str, body: str, at: str):
    loop x in n.notes:
        if x.job == job: return
    n.notes.push(Note(body, at, job, poster, title))
    save_notebook(n)

# a line in the log, written for one
log_note = (n: mut Notebook, text: str, at: str):
    n.notes.push(Note(text, at, -2))
    save_notebook(n)

has_notice = (n: Notebook, job: int) -> bool:
    loop x in n.notes:
        if x.job == job: return true
    false

# the notebook open: its pages, and a line to write on. Typing goes into the draft; Enter writes
# it in; Escape or J closes it. (Returns true while it has the keyboard.)
notebook_panel = (fonts: Fonts, n: mut Notebook, now: str) -> bool:
    if not n.open: return false
    # writing
    n.draft = n.draft + text_input()
    if key_typed(.backspace) and n.draft.len() > 0:
        n.draft = n.draft[0..n.draft.len() - 1]
    if key_pressed(.enter) and n.draft.len() > 0:
        n.notes.push(Note(n.draft, now))
        n.draft = ""
        save_notebook(n)
    if key_pressed(.escape): n.open = false
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(860.0, sw - 60.0)
    h = min(600.0, sh - 60.0)
    x = (sw - w) * 0.5
    y = (sh - h) * 0.5
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.4))
    rect_rounded(x + 4, y + 6, w, h, 6, rgba(0, 0, 0, 0.3))
    rect_rounded(x - 10, y - 8, w + 20, h + 16, 8, rgba(0.36, 0.22, 0.14, 1))
    rect(x, y, w, h, PAPER)
    line(vec2(f32(x + w * 0.5), f32(y + 10)), vec2(f32(x + w * 0.5), f32(y + h - 10)), 2, PAPER_DARK)
    # ruled lines
    loop k in 0..int((h - 60.0) / 26.0):
        ly = y + 50.0 + f64(k) * 26.0
        line(vec2(f32(x + 20), f32(ly)), vec2(f32(x + w * 0.5 - 14), f32(ly)), 1, rgba(0.6, 0.7, 0.85, 0.35))
        line(vec2(f32(x + w * 0.5 + 14), f32(ly)), vec2(f32(x + w - 20), f32(ly)), 1, rgba(0.6, 0.7, 0.85, 0.35))
    set_font(fonts.title)
    text("Notebook", vec2(f32(x + 24), f32(y + 12)), 24, INK)
    set_font(fonts.ui)
    text("J or Esc to close", vec2(f32(x + w - 160), f32(y + 18)), 14, LIGHT_INK)
    # the notes, newest last, flowing down the left page then the right
    col_w = w * 0.5 - 50.0
    lines: (str, bool)[]
    loop note in n.notes:
        if note.job >= 0:
            lines.push((note.title, true))
            loop l in wrap_text(note.text, col_w, 16): lines.push((l, false))
        else if note.job == -2:
            loop l in wrap_text("{note.at}  {note.text}", col_w, 16): lines.push(("~" + l, false))
        else:
            loop l in wrap_text("{note.at}: {note.text}", col_w, 16): lines.push((l, false))
        lines.push(("", false))
    if n.live.len() > 0:
        lines.push(("Current errands",true))
        loop status in n.live:
            loop l in wrap_text(status,col_w,16): lines.push((l,false))
        lines.push(("",false))
    per = int((h - 110.0) / 26.0)
    first = max(0, lines.len() - per * 2)
    loop k in first..lines.len():
        i = k - first
        col = i / per
        row = i % per
        lx = x + 24.0 + f64(col) * w * 0.5
        ly = y + 30.0 + f64(row) * 26.0
        l, pinned = lines[k]
        if pinned:
            circle(vec2(f32(lx + 4), f32(ly + 12)), 4, STAMP)
            text(l, vec2(f32(lx + 14), f32(ly + 4)), 17, rgba(0.35, 0.18, 0.08, 1))
        else if l.starts_with("~"): text(l[1..l.len()], vec2(f32(lx), f32(ly + 4)), 16, rgba(0.2, 0.3, 0.5, 1))
        else: text(l, vec2(f32(lx), f32(ly + 4)), 16, INK)
    # the line being written
    wy = y + h - 46.0
    rect_rounded(x + 20, wy - 6, w - 40, 34, 4, rgba(1, 1, 1, 0.5))
    cursor = if int(elapsed() * 2.0) % 2 == 0: "|" else: ""
    text(if n.draft == "": "write here, Enter to write it in" + cursor else: n.draft + cursor, vec2(f32(x + 30), f32(wy)), 17, if n.draft == "": LIGHT_INK else: INK)
    set_font()
    true
