# Player-only effects, one small transparent mesh; no additional render target or texture.
use 'pilot.jo'
use 'flight.jo'
use 'planes.jo'
use 'flight_feedback.jo'
use 'sea.jo'
use 'damage.jo'
use 'render_space.jo'
use 'look.jo'
use 'depth_space.jo'
use 'world_point.jo'

struct FlightFxVertex:
    pos: vec3
    color: vec4
    soft: vec2 = vec2(2,2)
struct FlightFxParams:
    vp: mat4
    cam: vec3
    haze: vec3
    fog: f32
    warp_a: vec4
    warp_b: vec4
struct FlightFxOut:
    pos: vec4
    world: vec3
    color: vec4
    soft: vec2
flight_fx_vs = (v: FlightFxVertex,u: FlightFxParams) -> FlightFxOut:
    FlightFxOut(u.vp*vec4(render_warped(v.pos,u.cam,u.warp_a,u.warp_b),1),v.pos,v.color,v.soft)
flight_fx_fs = (i: FlightFxOut,u: FlightFxParams) -> vec4:
    alpha=i.color.w
    if i.soft.x<1.5:alpha*=1.0-smoothstep(0.15,1.0,dot(i.soft,i.soft))
    if alpha<0.002:discard()
    vec4(aerial(i.color.xyz,i.world,u.cam,u.haze,u.fog),alpha)
flight_fx_shader: Shader
flight_fx_mesh: Mesh
init_flight_effects = ():
    global flight_fx_shader,flight_fx_mesh
    flight_fx_shader = make_world_shader(shader(flight_fx_vs,flight_fx_fs))
    flight_fx_mesh = mesh([FlightFxVertex(vec3(0,0,0),vec4(0,0,0,0))])

fx_tri = (vs: mut FlightFxVertex[],a: vec3,b: vec3,c: vec3,color: vec3,alpha: vec3):
    vs.extend([FlightFxVertex(a,vec4(color,alpha.x)),FlightFxVertex(b,vec4(color,alpha.y)),FlightFxVertex(c,vec4(color,alpha.z))])

# Keep the physical anchor precise until it is subtracted from the render chart.
# The supplied matrix contributes orientation and the existing visual plunge/bob only.
flight_fx_anchor=(f:Flyer,at:mat4)->WorldPoint:
    world_offset(craft_point(f.state),at[3].xyz-f.state.position)

flight_fx_vertices = (f: Flyer, model: CraftModel, pose: mat4,L: Light,t: f64,origin:vec3,eye:vec3) -> FlightFxVertex[]:
    anchor=flight_fx_anchor(f,pose)
    rotation=pose;rotation[3]=vec4(0,0,0,1)
    at=rotation;at[3]=vec4(world_local(anchor,origin),1)
    vs: FlightFxVertex[]
    s = f.state
    right = quat_rotate(s.orientation,vec3(1,0,0))
    back = quat_rotate(s.orientation,vec3(0,0,1))
    if s.on_water and not s.moored and not s.crashed:
        speed = water_run_speed(f.spec,s)
        run = smoothstep(3.0,f.spec.stall_speed,speed)
        # The sheet peels from the bow to the step as the hull lifts. Its roots are real
        # contact points: dry bows disappear first; the aft wet footprint remains visible.
        loop p in model.contacts:
            if run < 0.01 or part_health(s.damage,PartId(contact_part(f.kind,p))) <= 0: continue
            contact = world_offset(anchor,transform_point(rotation,p))
            sea = swell_at(contact.x,contact.z,f.sea_t)
            if contact.y > f64(sea.x)+0.18: continue
            contact.y = f64(sea.x)+0.07
            root = world_local(contact,origin)
            color = mix(L.shade,L.sun,0.65)*0.65+vec3(0.48,0.51,0.54)
            # A V of soft droplets follows curved ballistic arcs from each float.
            # Camera-facing circular footprints have no visible card rim at any angle.
            loop lane in 0..11:
                spread=f64(lane-5)/5.0
                phase=f64(lane)*2.399+f64(p.x)*1.7
                loop j in 0..10:
                    u=(f64(j)+fract(t*8.0+phase))/10.0
                    aft=u*(1.0+run*6.0)*(0.85+0.15*cos(phase))
                    wide=spread*u*(0.5+run*2.1)
                    lift=sin(u*PI)*(0.25+run*1.6)*(1.0-0.4*abs(spread))
                    center=root+back*f32(aft)+right*f32(wide)+vec3(0,f32(lift),0)
                    view=normalize(eye-center)
                    across=normalize(cross(view,vec3(0,1,0))+vec3(0.00001,0,0))
                    up=normalize(cross(across,view))
                    radius=f32((0.10+run*0.17)*(0.6+u*0.9)*(0.8+0.2*sin(phase+f64(j)*5.0)))
                    opacity=f32(run*0.72*pow(1.0-u,1.3))
                    loop uv in [vec2(-1,-1),vec2(1,-1),vec2(-1,1),vec2(-1,1),vec2(1,-1),vec2(1,1)]:
                        vs.push(FlightFxVertex(center+(across*uv.x+up*uv.y)*radius,vec4(color,opacity),uv))
    # (the spinning propeller disc is prop_disc.jo's, drawn for every aircraft)
    if part_health(s.damage,.engine) > 0:
        night = 1.0-smoothstep(-0.08,0.08,f64(L.sun_dir.y))
        loop hub in model.prop_hubs:
            if night > 0.01 and s.throttle > 0.05 and s.fuel > 0 and not s.crashed:
                # Short hot exhaust at the sides of the actual nacelle; paired engines each fire.
                loop side in [-1.0,1.0]:
                    flicker = 0.35+0.65*pow(0.5+0.5*sin(t*73.0+side*2.0+f64(hub.x)),3.0)
                    root = hub+vec3(side*0.38,-0.25,0.65)
                    length = (0.12+0.42*s.throttle)*flicker
                    color = vec3(1.0,0.35+flicker*0.2,0.08)
                    a=transform_point(at,root+vec3(0,0.07,0)); b=transform_point(at,root-vec3(0,0.07,0)); c=transform_point(at,root+vec3(side*0.08,-0.04,length))
                    fx_tri(vs,a,b,c,color,vec3(f32(night*0.8),f32(night*0.8),0))
    vs

# Before cloud compositing, with the same local chart and depth convention as the craft.
draw_flight_effects=(f:Flyer,model:CraftModel,at:mat4,L:Light,t:f64):
    origin=render_origin(scene_camera())
    vs=flight_fx_vertices(f,model,at,L,t,origin,render_eye(origin))
    if vs.len()==0:return
    glDepthMask(0); glDisable(GL_CULL_FACE)
    m=flight_fx_mesh
    update_mesh(m,vs)
    draw(flight_fx_shader,m,FlightFxParams(render_view_proj(origin),render_eye(origin),L.haze,f32(L.fog_density),render_anchor(scene_warp_a,origin),scene_warp_b))

# Tiny edge droplets, no full-screen blur and no obstruction of the gunsight. Rain and actual
# water slaps supply the exposure. Deterministic phases never consume the simulation RNG.
draw_flight_lens = (f: Flyer,rain: f64,t: f64):
    if f.state.moored: return
    cam = scene_camera()
    water_height = f64(swell_at(f64(cam.x)+f64(render_eye_low.x),f64(cam.z)+f64(render_eye_low.z),f.sea_t).x)
    spray = f.feedback.lens*(1.0-smoothstep(3.0,8.0,f64(cam.y)-water_height))
    wet = max(rain*0.32,spray*0.65)
    if wet < 0.015: return
    w=f64(screen_width()); h=f64(screen_height())
    loop j in 0..12:
        seed=f64(j)
        phase=fract(t*(0.19+seed*0.006)+seed*0.618)
        fade=sin(phase*PI)*wet
        x=(if j%2 == 0: 0.05+0.012*seed else: 0.95-0.012*seed)*w
        y=fract(seed*0.371+phase*0.24)*h
        radius=(2.0+f64(j%4))*h/720.0
        ring(vec2(x,y),radius,1.0,rgba(0.76,0.86,0.94,f32(fade*0.35)))
        line(vec2(x-radius*0.6,y-radius*0.5),vec2(x-radius*0.3,y-radius*0.8),1.0,rgba(0.95,0.98,1,f32(fade*0.8)))
