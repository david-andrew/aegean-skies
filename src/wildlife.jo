# Wildlife: geese on the lakes, the rivers and the sheltered corners of harbours; gulls about the
# harbours and after the fishing boats; goats and sheep on the slopes above the villages.
# Cosmetic, like the cats: nothing here touches the living world or is saved. Where the animals
# live comes from the world's own places (settlements, their harbours, the lakes, the river nodes)
# through a hash of each place's id, so a raft is in the same corner every time; what they do
# once the camera comes near is simulated: paddling, feeding tail up, preening, drifting on the
# wind, and when something comes too close, moving off and then running across the water and
# flying off low, wings carrying them as fast as they beat (no keyframed paths).
# Drawn by src/wildlife_view.jo; heard through the ambience (src/wildlife_sound.jo).

use 'world.jo'
use 'water_field.jo'
use 'lake_data.jo'
use 'river_data.jo'
use 'settlements.jo'
use 'settlement_ports.jo'
use 'geography.jo'
use 'objects.jo'
use 'vessel_types.jo'
use 'calendar.jo'

const WILD_SCAN = 3200.0            # places are looked for within this of the camera
const WILD_RESCAN = 400.0           # and again once the camera has moved this far
const WILD_LIVE = 1300.0            # a group is simulated within this (dropped 300 m further)
const WILD_HIGH = 1500.0            # higher than this above the ground, nothing is kept alive
const WILD_AWAY = 900.0             # seconds a raft that flew off stays away
const WILD_DRY = -1.0e9             # (WildEnv.water where there is none)
const WILD_MARK_LIFE = 7.0          # seconds a ring or wake on the water lasts
const WILD_MARKS = 360
# The waterfowl of a raft, as the Aegean had them: greylag geese (winter visitors in numbers, a few
# all the year), mallards (drakes and ducks) and coots. Each kind's size (a greylag's own metres),
# the speed at which its wings carry it off the water, its cruising speed and its wingbeat.
const FOWL_GREYLAG = 0
const FOWL_DRAKE = 1
const FOWL_DUCK = 2
const FOWL_COOT = 3
FOWL_SIZE = [1.0, 0.62, 0.6, 0.48]
FOWL_LIFT = [9.0, 6.0, 6.0, 7.5]
FOWL_THRUST = [4.2, 6.5, 6.5, 3.6]
FOWL_CRUISE = [16.0, 19.0, 19.0, 11.0]
FOWL_BEAT = [2.7, 4.6, 4.6, 4.2]
const GULL_SPEED = 9.5
const GRAVITY_W = 9.81
const WILD_BOLLARD = 0.71          # a bollard's top above its quay's deck

enum WildKind: raft, colony, herd

# A place where animals live: found once from the world's data and kept by its key.
struct WildSite:
    key: int
    kind: WildKind
    at: vec3                        # a raft's water (at its level), a colony's harbour, a herd's slope
    radius = 50.0
    count = 8
    species = 0                     # a herd: 0 goats, 1 sheep
    level = 0.0                     # a raft's water level
    out = vec2(1, 0)                # a raft's way to open water
    perches: vec3[] = []            # a colony's posts, quay ends, mastheads and ridges
    inland = false                  # a raft on a lake or river: ducks and coots among the geese
    resident = false                # a raft there all the year (the islands' own harbours)

# What the animals see of the world (the game's ground, water, wind and clock; a test's own).
struct WildEnv:
    ground: (f64, f64) -> f64 = (x: f64, z: f64) -> f64: -10.0
    water: (f64, f64) -> f64 = (x: f64, z: f64) -> f64: 0.0       # the surface there, or WILD_DRY
    built: (f64, f64) -> bool = (x: f64, z: f64) -> bool: false   # inside a town's streets
    wind = vec3(0, 0, 0)
    hour = 10.0
    day = 0                         # the world's day (calendar.jo)

# Something they keep away from: an aircraft (on the water or in the air), or a person on foot.
struct WildThreat:
    pos: vec3
    vel: vec3 = vec3(0, 0, 0)
    aircraft = true

enum GooseAct: swim, upend, preen, rest, run, fly, dive

struct Goose:
    pos: vec3
    vel = vec3(0, 0, 0)
    yaw = 0.0
    act: GooseAct = .swim
    timer = 0.0
    slot = vec2(0, 0)               # its place in the raft (across, along), in the raft's frame
    tip = 0.0                       # 0 level .. 1 upended, tail to the sky
    neck = 0.0                      # 0 up .. 1 laid back on its back (preening, asleep)
    flap = 0.0                      # the wings' beat (radians)
    beat = 0.0                      # 0 folded .. 1 beating hard
    wait = 0.0                      # before it starts its run
    seed = 0.0
    mark = 0.0                      # to its next wake or ring on the water
    young = false
    kind = FOWL_GREYLAG             # FOWL_*
    rank = 0                        # its place behind the leader of its kind in the air
    under = 0.0                     # 0 afloat .. 1 under the water (a coot diving)
    checked = vec2(1.0e9, 1.0e9)    # where its water was last found deep enough (checked again a metre on)
    splash = 0.0                    # to its next splash, paddling upended

struct Raft:
    site: WildSite
    geese: Goose[]
    centre: vec3
    heading = 0.0
    wander = 0.0
    alarm = 0                       # 0 calm, 1 moving off, 2 flushed
    alarm_t = 0.0
    away = vec2(1, 0)
    launch = vec2(1, 0)             # the way they run, away and into the wind
    flown = 0.0
    honk = 0.0

enum GullAct: perch, fly, land, dive, sit

struct Gull:
    pos: vec3
    vel = vec3(0, 0, 0)
    yaw = 0.0
    act: GullAct = .fly
    timer = 0.0
    perch = -1                      # the perch it is on, or making for
    wheel = vec3(0, 0, 0)           # the point it circles
    radius = 30.0
    turn = 1.0                      # which way round
    alt = 20.0
    bank = 0.0
    flap = 0.0
    beat = 0.0
    seed = 0.0
    squabble = 0.0                  # wings up and shouting at a neighbour
    aim = vec3(0, 0, 0)             # where it is diving to
    look = 0.0
    floor_at = vec2(1.0e9, 1.0e9)   # where the ground under it was last taken (again 8 m on)
    floor = -1.0e9

struct Colony:
    site: WildSite
    gulls: Gull[]
    taken: int[]                    # which gull is on each perch (-1 none)
    boat = -1                       # a fishing boat they follow (its vessel id), not a harbour
    cry = 0.0
    level = 0.0                     # the water they fly over (taken once: the sea, or a lake)

enum BeastAct: graze, walk, look, run, lie

struct Beast:
    pos: vec3
    yaw = 0.0
    act: BeastAct = .graze
    timer = 0.0
    target = vec3(0, 0, 0)
    stride = 0.0
    head = 0.0                      # 0 up .. 1 down, grazing
    speed = 0.0
    coat = 0
    seed = 0.0
    low = 0.0                       # 0 standing .. 1 lying down
    bell = 0.0

struct Herd:
    site: WildSite
    beasts: Beast[]
    centre: vec3
    drift = 0.0
    scare = 0.0

# A ring, a wake or a splash on the water, for drawing (wildlife_view.jo).
struct WildMark:
    pos: vec3
    yaw: f64
    born: f64
    size: f64
    kind: int                       # 0 a ring, 1 a wake, 2 a splash of a running foot

# A call to be heard (wildlife_sound.jo).
enum WildVoice: honk, cry, bell, bleat, quack, kowk, blow, plash
struct WildCall:
    voice: WildVoice
    pos: vec3
    loud: f64
    key: int

struct Wildlife:
    found: {int: WildSite} = {}
    empty: {int: bool} = {}
    sites: WildSite[]
    scanned = vec3(1.0e9, 0, 1.0e9)
    rafts: Raft[]
    colonies: Colony[]
    herds: Herd[]
    gone: {int: f64} = {}           # a site key: when its animals may be back
    marks: WildMark[]
    calls: WildCall[]
    time = 0.0
    calls_made = 0
    extra: WildSite[] = []          # sites given outright (captures: AEGEAN_WILD_RAFT)

# ---------------- hashing and small helpers ----------------

wild_hash = (a: int, b: int) -> int:
    h = u64(a) * u64(0x9E3779B97F4A7C15) + u64(b) * u64(0xBF58476D1CE4E5B9)
    h = (h xor (h >> 31)) * u64(0x94D049BB133111EB)
    int((h xor (h >> 29)) & u64(0x7FFFFFFF))
wild_unit = (a: int, b: int) -> f64: f64(wild_hash(a, b) % 1000003) / 1000003.0

_dir = (yaw: f64) -> vec2: vec2(f32(sin(yaw)), f32(cos(yaw)))
_yaw_of = (d: vec2) -> f64: atan2(f64(d.x), f64(d.y))
_turn = (from: f64, to: f64, rate: f64) -> f64:
    d = angle_difference(from, to)
    from + clamp(d, -rate, rate)
_rot = (v: vec2, yaw: f64) -> vec2:
    # (across, along) in a frame heading `yaw` to world x, z
    f = _dir(yaw); r = vec2(f.y, -f.x)
    r * v.x + f * v.y
_flat = (a: vec3, b: vec3) -> f64: f64(length(a.xz - b.xz))
_unit2 = (v: vec2, fallback: vec2) -> vec2: if length(v) > 0.0001: normalize(v) else: fallback
_dry = (level: f64) -> bool: level < -1.0e8

wild_depth = (env: WildEnv, x: f64, z: f64) -> f64:
    level = env.water(x, z)
    if _dry(level): return -1.0
    level - env.ground(x, z)

wild_slope = (env: WildEnv, x: f64, z: f64) -> f64:
    gx = (env.ground(x + 4.0, z) - env.ground(x - 4.0, z)) / 8.0
    gz = (env.ground(x, z + 4.0) - env.ground(x, z - 4.0)) / 8.0
    sqrt(gx * gx + gz * gz)

wild_night = (hour: f64) -> bool: hour < 5.5 or hour >= 20.5

# The season's flocks: geese winter here in numbers; in summer fewer rafts and smaller, some with
# goslings.
wild_winter = (day: int) -> bool:
    m = calendar_date(day).month
    m >= 11 or m <= 2
wild_summer = (day: int) -> bool:
    m = calendar_date(day).month
    m >= 5 and m <= 8
wild_raft_present = (key: int, day: int) -> bool:
    if wild_winter(day): return true
    wild_unit(key, 9) < (if wild_summer(day): 0.7 else: 0.85)
wild_raft_count = (key: int, day: int) -> int:
    base = 6.0 + wild_unit(key, 8) * 9.0
    if wild_winter(day): return min(20, int(base * 1.45))
    if wild_summer(day): return max(5, int(base * 0.75))
    int(base)

# ---------------- where they live ----------------

# A sheltered corner of a harbour for a raft: along the shore to one side of the quays, off the
# beach, where the water floats a goose and land is close behind.
wild_harbour_raft = (key: int, centre: vec3, out: vec2, env: WildEnv) -> WildSite?:
    if wild_unit(key, 1) > 0.8: return none
    o = _unit2(out, vec2(1, 0))
    side = vec2(-o.y, o.x) * f32(if wild_unit(key, 2) < 0.5: 1.0 else: -1.0)
    loop turn in 0..2:
        s = if turn == 0: side else: -side
        loop along in [120.0, 170.0, 230.0, 300.0, 380.0]:
            loop off in [35.0, 55.0, 80.0]:
                p = centre.xz + s * f32(along) + o * f32(off)
                x = f64(p.x); z = f64(p.y)
                if wild_depth(env, x, z) < 1.2: continue
                # land close inshore, and open water out beyond
                back = p - o * 70.0
                if wild_depth(env, f64(back.x), f64(back.y)) > 0.0 and wild_depth(env, f64(p.x - s.x * 60.0), f64(p.y - s.y * 60.0)) > 0.0 and wild_depth(env, f64(p.x + s.x * 60.0), f64(p.y + s.y * 60.0)) > 0.0: continue
                ahead = p + o * 50.0
                if wild_depth(env, f64(ahead.x), f64(ahead.y)) < 0.5: continue
                level = env.water(x, z)
                return WildSite(key, .raft, vec3(p.x, f32(level), p.y), radius = 40.0, level = level, out = o)
    none

# A raft out on a lake or a river: the spot itself, if it floats a goose.
wild_water_raft = (key: int, at: vec2, out: vec2, env: WildEnv) -> WildSite?:
    x = f64(at.x); z = f64(at.y)
    if wild_depth(env, x, z) < 0.6: return none
    level = env.water(x, z)
    WildSite(key, .raft, vec3(at.x, f32(level), at.y), radius = 45.0, level = level, out = _unit2(out, vec2(1, 0)), inland = level > 0.5 or key >= 3000000)

# A slope above a village for a flock of goats or sheep: grass, not too steep, clear of the houses
# and of the water.
wild_hill_herd = (key: int, centre: vec3, avoid: vec3[], env: WildEnv) -> WildSite?:
    if wild_unit(key, 1) > 0.8: return none
    a0 = wild_unit(key, 2) * TAU
    loop k in 0..14:
        ang = a0 + f64(k) * 2.39996
        r = 220.0 + wild_unit(key, 10 + k) * 560.0
        x = f64(centre.x) + cos(ang) * r; z = f64(centre.z) + sin(ang) * r
        g = env.ground(x, z)
        if g < 10.0 or g > 650.0 or not _dry(env.water(x, z)) or env.built(x, z): continue
        sl = wild_slope(env, x, z)
        if sl < 0.08 or sl > 0.7: continue
        near = false
        loop h in avoid:
            if abs(f64(h.x) - x) < 45.0 and abs(f64(h.z) - z) < 45.0: near = true; break
        if near: continue
        sheep = wild_unit(key, 3) < 0.45
        return WildSite(key, .herd, vec3(f32(x), f32(g), f32(z)), radius = 45.0, count = 5 + int(wild_unit(key, 4) * 8.0), species = if sheep: 1 else: 0)
    none

wild_colony = (key: int, centre: vec3, perches: vec3[]) -> WildSite?:
    if perches.len() < 3: return none
    WildSite(key, .colony, centre, radius = 60.0, count = min(20, 6 + perches.len() / 3 + int(wild_unit(key, 4) * 4.0)), perches = perches)

# What a gull stands on in one of the islands' towns: the quays' ends, the moored boats' mastheads
# and bows, and the ridges of the houses by the water.
wild_town_perches = (tw: Town, env: WildEnv) -> vec3[]:
    out: vec3[]
    # (the bollards' tops: every 12 m along both edges, 0.5 m in, as add_quay sets them)
    loop q in tw.quays:
        d = q.b - q.a
        len = f64(length(d))
        if len < 3.0: continue
        dir = d / f32(len); nrm = vec2(-dir.y, dir.x); mid = (q.a + q.b) * 0.5
        k = 0.0
        loop k < len - 2.0 and out.len() < 28:
            loop side in [-1.0, 1.0]:
                b = mid + dir * f32(-len * 0.5 + 1.0 + k) + nrm * f32(side * (f64(q.width) * 0.5 - 0.5))
                # (only those at a water's edge: some of the islands' quays run on through the town)
                over = b + nrm * f32(side * 2.0)
                if wild_depth(env, f64(over.x), f64(over.y)) < 0.3: continue
                out.push(vec3(b.x, f32(QUAY_TOP + WILD_BOLLARD), b.y))
            k += 12.0
    loop b in tw.boats:
        if b.head.y > 2.0: out.push(b.at + b.head)
    loop s in tw.sites:
        if length(s.at.xz - tw.center.xz) > 110.0 or s.chapel or s.service or s.width < 4.0: continue
        f = vec2(f32(cos(s.yaw)), f32(-sin(s.yaw)))
        top = if s.flat: s.height + 0.3 else: s.height + min(s.width, s.depth) * 0.22
        loop e in [-0.32, 0.32]:
            p = s.at.xz + f * f32(s.width * e)
            out.push(vec3(p.x, s.at.y + f32(top), p.y))
        if out.len() > 38: break
    out

# ... and in the world's other harbours: along the quays' edges, and on the mooring buoys.
wild_place_perches = (s: WorldSettlement) -> vec3[]:
    out: vec3[]
    loop q in settlement_port(s).quays:
        if q.street or q.profile: continue
        delta = q.b - q.a; len = f64(length(delta.xz))
        if len < 3.0: continue
        n = vec2(-delta.z, delta.x) / f32(len)
        loop k in 0..max(1, int(len / 24.0)):
            u = f32((1.0 + f64(k) * 24.0) / len)
            loop side in [-1.0, 1.0]:
                at = mix(q.a, q.b, u); at.y = port_deck(q, u)
                out.push(at + vec3(n.x, 0, n.y) * f32(side * (q.width * 0.5 - 0.3)) + vec3(0, 0.02, 0))
        if out.len() > 20: break
    loop m in s.harbor:
        if m.buoy.y > -5.0: out.push(m.buoy + vec3(0, 0.45, 0))
    out

# A site by its key, found once (or found to be none) and kept.
_wild_keep = (wl: mut Wildlife, key: int, site: WildSite?):
    if let s = site: wl.found[key] = s
    else: wl.empty[key] = true

_wild_known = (wl: Wildlife, key: int) -> bool: key in wl.found or key in wl.empty

# The places near `at` (the camera), each found from its own data alone, so which are near never
# changes what any of them is.
wild_scan = (wl: mut Wildlife, towns: Town[], at: vec3, env: WildEnv):
    wl.scanned = at
    keys: int[]
    reach = WILD_SCAN + 900.0
    # the settlements: a harbour corner, a colony and a hillside each
    places: int[]
    if world_settlements.len() > 0:
        loop dz in -1..2:
            loop dx in -1..2:
                bin = geography_bin(f64(at.x) + f64(dx) * 16000.0, f64(at.z) + f64(dz) * 16000.0)
                loop index in settlement_bins.get(bin, []):
                    if index in places: continue
                    if _flat(world_settlements[index].center, at) < reach: places.push(index)
    loop index in places:
        s = world_settlements[index]
        tw: Town? = if s.legacy >= 0 and s.legacy < towns.len(): towns[s.legacy] else: none
        base = 2000000 + s.id * 4
        harbour = s.harbor.len() > 0 or tw != none
        centre = if let t = tw: t.center else: s.center
        out = if let t = tw: t.out else: s.out
        if harbour:
            if not _wild_known(wl, base):
                raft = wild_harbour_raft(base, if s.harbor.len() > 0 and tw == none: s.harbor[0].at else: centre, out, env)
                if let r0 = raft:
                    r1 = r0; r1.resident = tw != none
                    _wild_keep(wl, base, r1)
                else: _wild_keep(wl, base, none)
            if not _wild_known(wl, base + 1):
                perches = if let t = tw: wild_town_perches(t, env) else: wild_place_perches(s)
                _wild_keep(wl, base + 1, wild_colony(base + 1, if s.harbor.len() > 0 and tw == none: s.harbor[0].at else: centre, perches))
        if s.kind != .lighthouse and s.kind != .capital:
            if not _wild_known(wl, base + 2):
                avoid = if let t = tw: t.houses else: [s.center]
                _wild_keep(wl, base + 2, wild_hill_herd(base + 2, s.center, avoid, env))
        loop j in 0..3: keys.push(base + j)
    # (with no world registry, as in a test of the islands alone, their towns themselves)
    if world_settlements.len() == 0:
        loop k in 0..towns.len():
            tw = towns[k]
            if _flat(tw.center, at) > reach: continue
            base = 2000000 + k * 4
            if not _wild_known(wl, base):
                raft = wild_harbour_raft(base, tw.center, tw.out, env)
                if let r0 = raft:
                    r1 = r0; r1.resident = true
                    _wild_keep(wl, base, r1)
                else: _wild_keep(wl, base, none)
            if not _wild_known(wl, base + 1): _wild_keep(wl, base + 1, wild_colony(base + 1, tw.center, wild_town_perches(tw, env)))
            if not _wild_known(wl, base + 2): _wild_keep(wl, base + 2, wild_hill_herd(base + 2, tw.center, tw.houses, env))
            loop j in 0..3: keys.push(base + j)
    # the lakes: three rafts each, about the clear run and its shores
    loop k in 0..SETTLEMENT_LAKES.len():
        lake = SETTLEMENT_LAKES[k]
        if f64(length(lake.center - at.xz)) > reach + 1500.0: continue
        side = vec2(-lake.axis.y, lake.axis.x)
        loop j in 0..3:
            key = 3000000 + lake.id * 4 + j
            if not _wild_known(wl, key):
                along = (wild_unit(key, 5) - 0.5) * 1400.0
                across = (wild_unit(key, 6) - 0.5) * 2.0
                site: WildSite? = none
                loop tries in 0..5:
                    p = lake.center + lake.axis * f32(along) + side * f32(across * (220.0 - f64(tries) * 40.0))
                    site = wild_water_raft(key, p, lake.axis, env)
                    if site != none: break
                _wild_keep(wl, key, site)
            keys.push(key)
    # the rivers: here and there along the wider reaches, out of the stream to one side
    loop i in 0..RIVER_NODES.len() - 1:
        if i >= CANAL_BEGIN and i <= CANAL_FINISH: continue
        if i in RIVER_BREAKS: continue
        key = 4000000 + i
        if wild_hash(key, 7) % 9 != 0: continue
        n = RIVER_NODES[i]
        if f64(length(n.xy - at.xz)) > reach or n.w < 16.0: continue
        if not _wild_known(wl, key):
            m = RIVER_NODES[i + 1]
            d = _unit2(m.xy - n.xy, vec2(1, 0))
            side = vec2(-d.y, d.x) * f32(if wild_unit(key, 2) < 0.5: 1.0 else: -1.0)
            _wild_keep(wl, key, wild_water_raft(key, n.xy + side * (n.w * 0.22), d, env))
        keys.push(key)
    wl.sites = []
    loop s in wl.extra:
        if _flat(s.at, at) < WILD_SCAN: wl.sites.push(s)
    loop key in keys:
        if key in wl.found:
            s = wl.found[key]
            if _flat(s.at, at) < WILD_SCAN: wl.sites.push(s)

# The game's water for WildEnv: an inland lake's or river's surface, the sea's, or WILD_DRY.
wild_world_water = (x: f64, z: f64) -> f64:
    if geography_enabled:
        w = water_at(x, z)
        if w.wet: return w.level
    if surface_height(x, z) < -0.2: 0.0 else: WILD_DRY

# A raft placed outright where it is asked for (captures), on the water there.
wild_raft_at = (x: f64, z: f64, env: WildEnv) -> WildSite?:
    wild_water_raft(6000000 + int(abs(x) * 0.1) % 100000, vec2(f32(x), f32(z)), vec2(1, 0), env)

# ---------------- rafts of geese ----------------

# Who is in a raft, in order: its greylags (as many as the season brings), then on lakes and
# rivers its mallards in pairs and its coots; in a harbour now and then a pair or two of mallards.
wild_raft_kinds = (site: WildSite, day: int) -> int[]:
    out: int[]
    n = wild_raft_count(site.key, day)
    geese = if site.inland: (if wild_unit(site.key, 23) < 0.25: 0 else: max(2, n * 11 / 20)) else: n
    loop k in 0..geese: out.push(FOWL_GREYLAG)
    pairs = if site.inland: 1 + wild_hash(site.key, 24) % 4 else: (if wild_unit(site.key, 25) < 0.35: 1 + wild_hash(site.key, 26) % 2 else: 0)
    loop k in 0..pairs:
        out.push(FOWL_DRAKE); out.push(FOWL_DUCK)
    coots = if site.inland: wild_hash(site.key, 27) % 7 else: 0
    loop k in 0..coots: out.push(FOWL_COOT)
    if out.len() < 4:
        loop k in out.len()..4: out.push(if site.inland: FOWL_COOT else: FOWL_GREYLAG)
    out

make_raft = (site: WildSite, env: WildEnv) -> Raft:
    r = Raft(site = site, centre = site.at)
    kinds = wild_raft_kinds(site, env.day)
    n = kinds.len()
    r.heading = wild_unit(site.key, 20) * TAU
    rows = if n > 12: 3 else: 2
    # (in summer some rafts with geese have a pair's goslings)
    geese = 0
    loop k in kinds:
        if k == FOWL_GREYLAG: geese += 1
    goslings = if geese >= 2 and wild_summer(env.day) and wild_unit(site.key, 21) < 0.35: 3 + wild_hash(site.key, 22) % 4 else: 0
    loop b in 0..n + goslings:
        young = b >= n
        kind = if young: FOWL_GREYLAG else: kinds[b]
        u = wild_unit(site.key, 100 + b)
        v = wild_unit(site.key, 200 + b)
        slot = if young: vec2(f32((u - 0.5) * 1.6), f32(-1.2 - v * 1.6)) else: vec2(f32((f64(b % rows) - f64(rows - 1) * 0.5) * 2.4 + (u - 0.5) * 1.4), f32(f64(n / rows) * 0.9 - f64(b / rows) * 1.9 + (v - 0.5) * 1.1))
        # (a duck keeps by her drake)
        if kind == FOWL_DUCK and b > 0: slot = r.geese[b - 1].slot + vec2(f32(0.5 + u * 0.4), f32(-0.3 - v * 0.4))
        at = site.at.xz + _rot(slot, r.heading)
        g = Goose(pos = vec3(at.x, f32(site.level), at.y), slot = slot, seed = wild_unit(site.key, 300 + b), young = young, kind = kind)
        g.yaw = r.heading + (v - 0.5) * 0.8
        g.timer = 1.0 + u * 8.0
        # (some already feeding, as a raft is found)
        if not young and kind != FOWL_COOT and wild_unit(site.key, 400 + b) < 0.3 and not wild_night(env.hour): g.act = .upend; g.tip = 1.0; g.timer = 1.0 + u * 5.0
        if wild_night(env.hour): g.act = .rest; g.neck = 1.0
        r.geese.push(g)
    r

# How much one threat alarms a raft (or any animals on the water) at `near`: 0 not at all,
# 1 enough to move off, 2 enough to take flight.
wild_threat_level = (near: vec3, level: f64, th: WildThreat) -> int:
    d = _flat(th.pos, near)
    if not th.aircraft:
        if abs(f64(th.pos.y) - level) > 25.0: return 0
        if d < 16.0: return 2
        if d < 42.0: return 1
        return 0
    h = f64(th.pos.y) - level
    speed = f64(length(th.vel))
    to = _unit2(near.xz - th.pos.xz, vec2(1, 0))
    closing = f64(dot(th.vel.xz, to))
    # (its nearest pass in the next six seconds, and how high then)
    miss = d; miss_h = h
    loop k in 1..13:
        q = th.pos + th.vel * f32(f64(k) * 0.5)
        dd = _flat(q, near)
        if dd < miss: miss = dd; miss_h = f64(q.y) - level
    if h < 8.0:
        # on the water: taxiing, on its take-off run or just down
        if speed < 0.5: return if d < 30.0: 2 else: 0
        if d < 75.0: return 2
        if d < 140.0 and (closing > 2.5 or speed > 12.0): return 2
        if miss < 60.0: return 2
        if d < 230.0: return 1
        return 0
    if h < 50.0:
        # coming in to land, or a low pass
        if miss < 90.0 and miss_h < 40.0: return 2
        if d < 200.0: return 1
        return 0
    if h < 130.0 and miss < 60.0: return 1
    0

raft_alarm = (r: Raft, threats: WildThreat[]) -> (int, vec3):
    best = 0; from = r.centre
    loop th in threats:
        lv = wild_threat_level(r.centre, r.site.level, th)
        if lv > best: best = lv; from = th.pos
    (best, from)

_call = (calls: mut WildCall[], voice: WildVoice, pos: vec3, loud: f64, key: int):
    if calls.len() < 24: calls.push(WildCall(voice, pos, loud, key))

_mark = (marks: mut WildMark[], pos: vec3, yaw: f64, now: f64, size: f64, kind: int):
    if marks.len() >= WILD_MARKS: return
    marks.push(WildMark(pos, yaw, now, size, kind))

# (for the other animals of the sea: src/dolphins.jo)
wild_call = (calls: mut WildCall[], voice: WildVoice, pos: vec3, loud: f64, key: int): _call(calls, voice, pos, loud, key)
wild_mark = (marks: mut WildMark[], pos: vec3, yaw: f64, now: f64, size: f64, kind: int): _mark(marks, pos, yaw, now, size, kind)

raft_flush = (r: mut Raft, from: vec3, env: WildEnv, calls: mut WildCall[]):
    if r.alarm == 2: return
    r.alarm = 2
    r.away = _unit2(r.centre.xz - from.xz, r.site.out)
    # (away, but into the wind as much as it allows: they rise faster into it)
    up = -env.wind.xz
    lean = if length(up) > 0.5: normalize(up) * 0.45 else: vec2(0, 0)
    r.launch = _unit2(r.away + lean, r.away)
    # the nearest go first; the rest follow over a second or two
    flock = r.geese
    order: int[] = [loop k in 0..flock.len(): k]
    order.sort((k: int) -> f32: length(flock[k].pos.xz - from.xz))
    ranks = [0, 0, 0, 0]
    # (goslings cannot fly: they and their parents, the raft's first two greylags, swim off instead)
    brood = false
    loop g in r.geese:
        if g.young: brood = true
    loop k in order:
        g = r.geese[k]
        if g.young or (brood and k < 2 and g.kind == FOWL_GREYLAG):
            g.act = .swim; g.timer = 30.0; g.tip = 0.0
            r.geese[k] = g
            continue
        kind = if g.kind == FOWL_DUCK: FOWL_DRAKE else: g.kind
        g.act = .run; g.rank = ranks[kind]; g.tip = min(g.tip, 0.3)
        g.wait = f64(ranks[kind]) * 0.12 + g.seed * 0.6 + g.under * 1.5
        ranks[kind] += 1
        r.geese[k] = g
    _call(calls, .honk, r.centre, 0.16, r.site.key)
    if ranks[FOWL_DRAKE] > 0: _call(calls, .quack, r.centre, 0.12, r.site.key + 1)

# A goose afloat: to its place in the raft, kept apart from the others, turned the way it swims.
_goose_swim = (r: Raft, k: int, env: WildEnv, dt: f64, paddle: f64) -> Goose:
    g = r.geese[k]
    spread = if wild_night(env.hour) and r.alarm == 0: 0.6 else: 1.0
    young_off = if g.young and r.geese.len() > 0: r.geese[0].pos.xz - r.centre.xz else: vec2(0, 0)
    target = r.centre.xz + _rot(g.slot * f32(spread), r.heading) + young_off * 0.5
    to = target - g.pos.xz
    dist = f64(length(to))
    pace = if r.alarm == 1: 1.0 else: 0.4
    speed = min(dist * 0.4, pace)
    want = _unit2(to, vec2(0, 0)) * f32(speed) + _dir(r.heading) * f32(paddle)
    # apart from the others
    loop j in 0..r.geese.len():
        if j == k: continue
        o = r.geese[j]
        d = g.pos.xz - o.pos.xz
        dl = f64(length(d))
        room = if g.young or o.young: 0.5 else: 1.1 * (FOWL_SIZE[g.kind] + FOWL_SIZE[o.kind]) * 0.5
        if dl < room and dl > 0.001: want += normalize(d) * f32((room - dl) * 0.9)
    if g.act == .upend or g.act == .rest: want *= 0.2
    # (a coot under water swims off a little way on its own)
    if g.act == .dive: want = _dir(g.yaw + g.seed) * 0.5
    v = g.vel.xz + (want - g.vel.xz) * f32(min(1.0, dt * 1.4))
    # (the wind's push on a bird sitting high on the water)
    drift = env.wind.xz * 0.02
    next = g.pos.xz + (v + drift) * f32(dt)
    if length(next - g.checked) > 1.0:
        if r.site.level - env.ground(f64(next.x), f64(next.y)) < 0.5:
            v = v * -0.3
            next = g.pos.xz
        else: g.checked = next
    g.vel = vec3(v.x, 0, v.y)
    g.pos = vec3(next.x, f32(r.site.level), next.y)
    sp = f64(length(v))
    if sp > 0.12 and g.tip < 0.3: g.yaw = _turn(g.yaw, _yaw_of(v), dt * 1.6)
    else if g.tip < 0.3: g.yaw = _turn(g.yaw, r.heading + (g.seed - 0.5) * 0.9, dt * 0.25)
    g

# What a calm goose does next: feed tail up, preen, rest, or paddle on.
_goose_choose = (g: mut Goose, key: int, k: int, env: WildEnv, now: f64):
    u = wild_unit(key * 31 + k, int(now * 7.0))
    if wild_night(env.hour):
        g.act = .rest; g.timer = 20.0 + u * 30.0; return
    if g.young:
        g.act = .swim; g.timer = 3.0 + u * 6.0; return
    if g.kind == FOWL_COOT:
        # coots dive for their food rather than upend
        if u < 0.45: g.act = .dive; g.timer = 4.0 + u * 14.0
        else: g.act = .swim; g.timer = 3.0 + u * 8.0
        return
    if u < (if g.kind == FOWL_GREYLAG: 0.36 else: 0.48): g.act = .upend; g.timer = 3.0 + u * 13.0
    else if u < 0.6: g.act = .preen; g.timer = 4.0 + u * 8.0
    else if u < 0.66: g.act = .rest; g.timer = 8.0 + u * 14.0
    else: g.act = .swim; g.timer = 3.0 + u * 7.0

raft_step = (r: mut Raft, threats: WildThreat[], env: WildEnv, dt: f64, now: f64, marks: mut WildMark[], calls: mut WildCall[]):
    level, from = raft_alarm(r, threats)
    if r.alarm < 2:
        if level == 2: raft_flush(r, from, env, calls)
        else if level == 1:
            if r.alarm == 0: _call(calls, .honk, r.centre, 0.1, r.site.key)
            r.alarm = 1; r.alarm_t = 6.0
            r.away = _unit2(r.centre.xz - from.xz, r.site.out)
        else if r.alarm == 1:
            r.alarm_t -= dt
            if r.alarm_t <= 0.0: r.alarm = 0
    # the raft as a whole: drifting with the wind, paddling slowly about its water, or moving off
    paddle = 0.0
    if r.alarm == 0:
        r.wander -= dt
        if r.wander <= 0.0:
            r.wander = 20.0 + wild_unit(r.site.key, int(now)) * 30.0
            home = r.site.at.xz - r.centre.xz
            r.heading = if f64(length(home)) > r.site.radius * 0.5: _yaw_of(home) else: r.heading + (wild_unit(r.site.key, int(now) + 1) - 0.5) * 1.6
        paddle = if wild_night(env.hour): 0.0 else: 0.12
    else:
        # (moving off; or, the others flown, a brood and its parents swimming away)
        r.heading = _turn(r.heading, _yaw_of(r.away), dt * 0.8)
        paddle = 0.85
    if r.alarm < 2 or r.flown < 40.0:
        move = _dir(r.heading) * f32(paddle) + env.wind.xz * 0.02
        next = r.centre.xz + move * f32(dt)
        lv = r.site.level
        if lv - env.ground(f64(next.x), f64(next.y)) > 0.6 and lv - env.ground(f64(next.x + move.x * 20.0), f64(next.y + move.y * 20.0)) > 0.4:
            r.centre = vec3(next.x, f32(r.site.level), next.y)
        else:
            r.heading += dt * 0.6
            # (cornered while moving off: they go up)
            if r.alarm == 1: raft_flush(r, from, env, calls)
            else if r.alarm == 2: r.away = _dir(r.heading)
    # each goose
    leads = [-1, -1, -1, -1]
    loop k in 0..r.geese.len():
        kind = if r.geese[k].kind == FOWL_DUCK: FOWL_DRAKE else: r.geese[k].kind
        if r.geese[k].rank == 0 and not r.geese[k].young and (r.geese[k].act == .run or r.geese[k].act == .fly): leads[kind] = k
    loop k in 0..r.geese.len():
        g = r.geese[k]
        if g.act == .run or g.act == .fly:
            kind = if g.kind == FOWL_DUCK: FOWL_DRAKE else: g.kind
            g = _goose_air(r, k, if g.young: leads[FOWL_GREYLAG] else: leads[kind], env, dt, now, marks)
        else:
            g = _goose_swim(r, k, env, dt, paddle)
            g.timer -= dt
            if r.alarm >= 1:
                if g.act == .upend or g.act == .preen or g.act == .rest or g.act == .dive: g.act = .swim; g.timer = 4.0
            else if g.timer <= 0.0: _goose_choose(g, r.site.key, k, env, now)
            # a coot's dive: down with a little jump and a ring, up again with another
            down = g.under
            g.under += ((if g.act == .dive: 1.0 else: 0.0) - g.under) * min(1.0, dt * (if g.act == .dive: 5.0 else: 3.0))
            if (down < 0.5) != (g.under < 0.5): _mark(marks, g.pos, g.yaw, now, 0.35, 0)
            # (upended, the feet paddle to keep it there and splash now and then)
            if g.tip > 0.7:
                g.splash -= dt
                if g.splash <= 0.0:
                    g.splash = 0.5 + wild_unit(r.site.key * 7 + k, int(now * 4.0)) * 1.2
                    _mark(marks, g.pos + vec3(_dir(g.yaw).x, 0, _dir(g.yaw).y) * f32(-0.1 * FOWL_SIZE[g.kind]), g.yaw, now, 0.12 * FOWL_SIZE[g.kind], 2)
            tip_to = if g.act == .upend: 0.94 + 0.06 * sin(now * 1.7 + g.seed * 9.0) else: 0.0
            was = g.tip
            g.tip += (tip_to - g.tip) * min(1.0, dt * (if tip_to > g.tip: 3.2 else: 2.4))
            if (was < 0.5) != (g.tip < 0.5): _mark(marks, g.pos, g.yaw, now, 0.5, 0)
            neck_to = if g.act == .rest: 1.0 else: if g.act == .preen: 0.55 + 0.35 * sin(now * 2.3 + g.seed * 20.0) else: if r.alarm == 1: -0.15 else: 0.0
            g.neck += (neck_to - g.neck) * min(1.0, dt * 2.5)
            g.beat = max(0.0, g.beat - dt * 2.0)
            # (now and then a stretch of the wings, preening)
            if g.act == .preen and sin(now * 0.37 + g.seed * 31.0) > 0.985: g.beat = 0.5
            g.flap += dt * 14.0
            g.mark -= dt
            sp = f64(length(g.vel))
            # (a wake only from a bird really paddling, not one drifting or jostled)
            if g.mark <= 0.0 and sp > 0.25 and g.under < 0.5:
                _mark(marks, g.pos, _yaw_of(g.vel.xz), now, sp * FOWL_SIZE[g.kind], 1)
                g.mark = 1.2
        r.geese[k] = g
    # the raft's voice
    r.honk -= dt
    if r.honk <= 0.0:
        busy = r.alarm > 0
        r.honk = if busy: 0.5 + wild_unit(r.site.key, int(now * 3.0)) * 0.6 else: 2.5 + wild_unit(r.site.key, int(now)) * 7.0
        if not wild_night(env.hour) or busy:
            k = wild_hash(r.site.key, int(now * 5.0)) % max(1, r.geese.len())
            g = r.geese[k]
            voice = if g.kind == FOWL_GREYLAG: WildVoice.honk else: if g.kind == FOWL_COOT: WildVoice.kowk else: WildVoice.quack
            if g.under < 0.5: _call(calls, voice, g.pos + vec3(0, 0.4, 0), if busy: 0.12 else: 0.07, r.site.key * 64 + k)
    if r.alarm == 2: r.flown += dt
    # a minute on, those that flew are gone; a brood left on the water settles as a raft again
    if r.alarm == 2 and r.flown > 60.0:
        keep: Goose[]
        loop g in r.geese:
            if g.act != .fly and g.act != .run: keep.push(g)
        r.geese = keep
        if keep.len() > 0:
            r.alarm = 0; r.flown = 0.0
            c = vec3(0, 0, 0)
            loop g in keep: c += g.pos
            r.centre = c / f32(keep.len())

# A goose running over the water and flying: thrust from its beating wings, lift as the square
# of its speed, drag, and its weight; the leader makes off low, the rest follow on its quarter.
_goose_air = (r: Raft, k: int, lead: int, env: WildEnv, dt: f64, now: f64, marks: mut WildMark[]) -> Goose:
    g = r.geese[k]
    if g.wait > 0.0:
        g.wait -= dt
        g.tip += (0.0 - g.tip) * min(1.0, dt * 4.0)
        g.under += (0.0 - g.under) * min(1.0, dt * 4.0)
        g.neck += (-0.2 - g.neck) * min(1.0, dt * 4.0)
        g.yaw = _turn(g.yaw, _yaw_of(r.launch), dt * 2.5)
        return g
    level = r.site.level
    v = g.vel
    hs = f64(length(v.xz))
    heading = if hs > 0.5: _yaw_of(v.xz) else: g.yaw
    # where it wants to go
    want = _yaw_of(r.launch)
    gap = 0.0
    if lead >= 0 and lead != k:
        l = r.geese[lead]
        lf = _unit2(l.vel.xz, r.launch)
        side = vec2(-lf.y, lf.x) * f32(if g.rank % 2 == 0: 1.0 else: -1.0)
        sz = FOWL_SIZE[g.kind]
        slot = l.pos.xz - lf * f32(1.9 * sz * f64((g.rank + 1) / 2)) + side * f32(1.3 * sz * f64((g.rank + 1) / 2))
        to = slot - g.pos.xz
        if f64(length(to)) > 0.5: want = _yaw_of(to + lf * 6.0)
        gap = f64(dot(to, lf))
    heading = _turn(heading, want, dt * (if g.act == .run: 0.5 else: 0.9))
    cruise = FOWL_CRUISE[g.kind] + clamp(gap * 0.4, -3.0, 4.0)
    air = vec3(v.x - env.wind.x, v.y, v.z - env.wind.z)
    speed = f64(length(air))
    on_water = f64(g.pos.y) <= level + 0.05
    thrust = if g.act == .run: FOWL_THRUST[g.kind] else: clamp((cruise - speed) * 0.8 + 1.4, 0.0, 5.0)
    drag = 0.006 * speed * speed + (if on_water: 0.22 * hs else: 0.0)
    hs2 = max(0.0, hs + (thrust - drag) * dt)
    # its height: low over the water, clear of the ground ahead
    fwd = _dir(heading)
    ahead = g.pos.xz + fwd * 45.0
    floor = max(level, env.ground(f64(ahead.x), f64(ahead.y)))
    cruise_alt = floor + 7.0 + g.seed * 7.0
    want_vy = clamp((cruise_alt - f64(g.pos.y)) * 0.45, -1.2, 2.2)
    lift_v = FOWL_LIFT[g.kind] * (if g.young: 0.8 else: 1.0)
    lift_max = GRAVITY_W * (speed / lift_v) * (speed / lift_v) * 1.25
    lift = clamp(GRAVITY_W + (want_vy - f64(v.y)) * 2.5, 0.0, lift_max)
    vy = f64(v.y) + (lift - GRAVITY_W) * dt
    y = f64(g.pos.y) + vy * dt
    if y <= level:
        y = level; vy = max(0.0, vy)
    else if g.act == .run and y > level + 0.4: g.act = .fly
    g.vel = vec3(fwd.x * f32(hs2), f32(vy), fwd.y * f32(hs2))
    p = g.pos.xz + g.vel.xz * f32(dt)
    g.pos = vec3(p.x, f32(y), p.y)
    g.yaw = heading
    # wings: beating hard on the run and the climb, steadier in level flight
    g.beat += ((if g.act == .run or vy > 0.6: 1.0 else: 0.75) - g.beat) * min(1.0, dt * 4.0)
    g.flap += dt * TAU * FOWL_BEAT[g.kind] * (if g.act == .run: 1.25 else: 1.0)
    g.tip += (0.0 - g.tip) * min(1.0, dt * 4.0)
    # (the neck stretched out ahead)
    g.neck += (-1.0 - g.neck) * min(1.0, dt * 3.0)
    # the feet pattering on the water, and the wake it leaves running
    g.mark -= dt
    if g.mark <= 0.0 and y < level + 0.6:
        _mark(marks, g.pos, g.yaw, now, (0.25 + hs2 * 0.03) * FOWL_SIZE[g.kind], 2)
        if hs2 > 1.5: _mark(marks, g.pos, g.yaw, now, hs2 * 0.25 * FOWL_SIZE[g.kind], 1)
        g.mark = 0.09
    g

raft_done = (r: Raft, cam: vec3) -> bool:
    if r.geese.len() == 0: return true
    if r.alarm < 2: return false
    if r.flown > 75.0: return true
    loop g in r.geese:
        if _flat(g.pos, r.site.at) < WILD_LIVE and _flat(g.pos, cam) < WILD_LIVE: return false
    true

# ---------------- gulls ----------------

make_colony = (site: WildSite, env: WildEnv, boat: int = -1) -> Colony:
    c = Colony(site = site, taken = fill(-1, site.perches.len()), boat = boat)
    w = env.water(f64(site.at.x), f64(site.at.z))
    c.level = if _dry(w): 0.0 else: w
    loop b in 0..site.count:
        u = wild_unit(site.key, 500 + b); v = wild_unit(site.key, 600 + b)
        g = Gull(pos = site.at, seed = u, turn = if v < 0.5: -1.0 else: 1.0)
        g.wheel = site.at + vec3(f32((u - 0.5) * 60.0), 0, f32((v - 0.5) * 60.0))
        g.radius = 18.0 + v * 30.0
        g.alt = f64(site.at.y) + 7.0 + u * 18.0
        p = wild_hash(site.key, 700 + b) % max(1, site.perches.len())
        perched = site.perches.len() > 0 and (wild_night(env.hour) or v < 0.6) and c.taken[p] < 0 and boat < 0
        if perched:
            g.act = .perch; g.perch = p; c.taken[p] = b; g.pos = site.perches[p]
            g.timer = 10.0 + u * 60.0
            g.yaw = v * TAU
        else:
            ang = u * TAU
            g.pos = g.wheel + vec3(f32(cos(ang) * g.radius), f32(g.alt - f64(g.wheel.y)), f32(sin(ang) * g.radius))
            g.yaw = ang + g.turn * PI * 0.5
            g.vel = vec3(_dir(g.yaw).x, 0, _dir(g.yaw).y) * f32(GULL_SPEED)
            g.timer = 5.0 + v * 15.0
        c.gulls.push(g)
    c

# A gull in the air: flying itself, banking to turn, gliding where it can and flapping where it
# must, carried on the wind.
gull_fly = (g: mut Gull, want_dir: vec2, want_speed: f64, want_alt: f64, env: WildEnv, dt: f64, level: f64 = 0.0):
    air = g.vel - vec3(env.wind.x, 0, env.wind.z)
    hs = f64(length(air.xz))
    heading = if hs > 0.5: _yaw_of(air.xz) else: g.yaw
    turn = angle_difference(heading, _yaw_of(want_dir))
    g.bank += (clamp(turn * 1.3, -0.8, 0.8) - g.bank) * min(1.0, dt * 3.0)
    heading += GRAVITY_W * tan(g.bank) / max(hs, 4.0) * dt
    climb = want_alt - f64(g.pos.y)
    need = hs < want_speed - 1.2 or climb > 4.0 or (g.beat > 0.5 and (hs < want_speed or climb > 1.5))
    g.beat += ((if need: 1.0 else: 0.0) - g.beat) * min(1.0, dt * 5.0)
    g.flap += dt * TAU * (2.6 + g.seed * 0.6) * (0.25 + 0.75 * g.beat)
    want_vy = clamp(climb * 0.35, -2.8, 2.6)
    # (gliding it pays for its height with speed and sinks a little; beating it climbs)
    if g.beat < 0.5: want_vy = min(want_vy, -0.45 + (hs - want_speed) * 0.25)
    vy = f64(air.y) + (want_vy - f64(air.y)) * min(1.0, dt * 2.0)
    thrust = g.beat * 4.0
    drag = 0.02 * hs * hs - (if g.beat < 0.5: max(0.0, -vy) * 0.9 else: 0.0)
    # (a gull's dive tops out well short of a falcon's)
    hs = clamp(hs + (thrust - drag - vy * 0.6) * dt, 1.5, 18.0)
    f = _dir(heading)
    g.vel = vec3(f.x * f32(hs) + env.wind.x, f32(vy), f.y * f32(hs) + env.wind.z)
    g.pos += g.vel * f32(dt)
    if length(g.pos.xz - g.floor_at) > 8.0 or f64(g.pos.y) < g.floor + 6.0:
        g.floor_at = g.pos.xz; g.floor = env.ground(f64(g.pos.x), f64(g.pos.z))
    floor = max(g.floor, level)
    if f64(g.pos.y) < floor + 1.2: g.pos.y = f32(floor + 1.2); g.vel.y = max(g.vel.y, 0.5)
    g.yaw = heading

_gull_free_perch = (c: Colony, k: int) -> int:
    n = c.site.perches.len()
    if n == 0: return -1
    start = wild_hash(c.site.key * 13 + k, int(c.gulls[k].timer * 10.0 + c.gulls[k].seed * 1000.0)) % n
    loop j in 0..n:
        p = (start + j) % n
        if c.taken[p] < 0: return p
    # (all taken: squabble for one)
    start

# A fishing boat stopped on its ground: hauling its nets, the gulls diving for what comes up.
wild_hauling = (b: Vessel) -> bool: b.status == .anchored or (b.status == .underway and b.speed < 0.3)

colony_step = (c: mut Colony, threats: WildThreat[], env: WildEnv, dt: f64, now: f64, boat: Vessel?, calls: mut WildCall[], marks: mut WildMark[]):
    night = wild_night(env.hour)
    centre = c.site.at
    hauling = false
    stern = c.site.at
    if let b = boat:
        # (behind the boat's stern, low over its wake; hauling, close about it)
        f = vec2(f32(sin(b.yaw)), f32(cos(b.yaw)))
        hauling = wild_hauling(b)
        stern = b.position + vec3(-f.x * 5.0, 0, -f.y * 5.0)
        centre = if hauling: b.position + vec3(-f.x * 6.0, 0, -f.y * 6.0) else: b.position + vec3(-f.x * 16.0, 0, -f.y * 16.0)
    c.cry -= dt
    loop k in 0..c.gulls.len():
        g = c.gulls[k]
        g.look += (sin(now * 0.7 + g.seed * 40.0) * 0.6 - g.look) * min(1.0, dt * 2.0)
        if g.act == .perch:
            g.timer -= dt
            g.pos = c.site.perches[g.perch]
            g.yaw = _turn(g.yaw, _yaw_of(-env.wind.xz) + g.look * 0.3, dt * 0.8)
            g.beat = max(0.0, g.beat - dt * 2.0)
            if g.squabble > 0.0:
                g.squabble -= dt; g.beat = 0.35; g.flap += dt * 16.0
            scared = false
            loop th in threats:
                d = f64(length(th.pos - g.pos))
                if (th.aircraft and d < 45.0 and f64(length(th.vel)) > 2.0) or (not th.aircraft and d < 6.0): scared = true
            if scared or (g.timer <= 0.0 and not night):
                c.taken[g.perch] = -1; g.perch = -1
                g.act = .fly; g.timer = 6.0 + wild_unit(c.site.key + k, int(now)) * 18.0
                f = _dir(g.yaw)
                g.vel = vec3(f.x * 3.0, 2.5, f.y * 3.0); g.beat = 1.0
                if scared: _call(calls, .cry, g.pos, 0.1, c.site.key * 32 + k)
        else if g.act == .fly:
            g.timer -= dt
            wheel = if boat != none: centre + vec3(0, 7, 0) else: g.wheel
            rel = g.pos.xz - wheel.xz
            r = f64(length(rel))
            # round the circle: a tangent, drawn in or out to its radius
            tangent = _unit2(vec2(-rel.y, rel.x) * f32(g.turn), _dir(g.yaw))
            radial = _unit2(-rel, vec2(0, 0)) * f32(clamp((r - g.radius) / g.radius, -1.0, 1.5))
            alt = if boat != none: f64(centre.y) + (if hauling: 3.5 else: 5.0) + 6.0 * (0.5 + 0.5 * sin(now * 0.4 + g.seed * 20.0)) else: g.alt
            if hauling: g.radius = 9.0 + g.seed * 10.0
            want_speed = if boat != none: GULL_SPEED + f64(length(boat!.velocity)) * 0.5 else: GULL_SPEED
            gull_fly(g, _unit2(tangent + radial, tangent), want_speed, alt, env, dt, c.level)
            if g.timer <= 0.0 and hauling and wild_unit(c.site.key + k, int(now * 2.0) + 9) < 0.6:
                # down after something thrown back or slipped from the net, just astern
                u = wild_unit(c.site.key + k, int(now * 3.0)); v = wild_unit(c.site.key + k, int(now * 3.0) + 1)
                g.aim = stern + vec3(f32((u - 0.5) * 12.0), 0, f32((v - 0.5) * 12.0))
                g.aim.y = f32(c.level)
                g.act = .dive; g.timer = 8.0
            else if g.timer <= 0.0:
                if boat == none and (night or wild_unit(c.site.key + k, int(now * 2.0)) < 0.65) and c.site.perches.len() > 0:
                    g.act = .land; g.perch = _gull_free_perch(c, k); g.timer = 25.0
                else:
                    g.timer = 8.0 + wild_unit(c.site.key + k, int(now) + 3) * 22.0
                    if boat == none:
                        u = wild_unit(c.site.key + k, int(now) + 5); v = wild_unit(c.site.key + k, int(now) + 6)
                        g.wheel = c.site.at + vec3(f32((u - 0.5) * 90.0), 0, f32((v - 0.5) * 90.0))
                        g.alt = f64(c.site.at.y) + 6.0 + u * 20.0
                        g.radius = 15.0 + v * 35.0
                    else:
                        g.turn = -g.turn
            if c.cry <= 0.0 and wild_unit(c.site.key + k, int(now * 4.0)) < 0.02:
                _call(calls, .cry, g.pos, 0.08, c.site.key * 32 + k); c.cry = 2.0
        else if g.act == .dive:
            # a steep glide down onto the water, wings half folded, and a splash
            g.timer -= dt
            to = g.aim - g.pos
            hd = f64(length(to.xz))
            hs = clamp(hd * 0.8, 3.0, 9.0)
            vy = if hd < 14.0: max(-7.0, f64(to.y) * 1.6 - 1.0) else: -0.5
            f = _unit2(to.xz, _dir(g.yaw))
            g.vel = vec3(f.x * f32(hs), f32(vy), f.y * f32(hs))
            g.pos += g.vel * f32(dt)
            g.yaw = _turn(g.yaw, _yaw_of(f), dt * 4.0)
            g.bank *= 0.9
            g.beat = max(0.0, g.beat - dt * 3.0)
            if f64(g.pos.y) <= c.level + 0.12 or g.timer <= 0.0:
                g.pos.y = f32(c.level)
                _mark(marks, g.pos, g.yaw, now, 0.35, 2)
                _mark(marks, g.pos, g.yaw, now, 0.4, 0)
                g.act = .sit; g.timer = 1.5 + wild_unit(c.site.key + k, int(now * 5.0)) * 4.0
                if wild_unit(c.site.key + k, int(now * 5.0) + 2) < 0.4: _call(calls, .cry, g.pos, 0.08, c.site.key * 32 + k)
        else if g.act == .sit:
            # on the water a moment, swallowing; then up again with a few hard beats
            g.timer -= dt
            g.pos.y = f32(c.level); g.vel = vec3(0, 0, 0)
            if g.timer <= 0.0:
                g.act = .fly; g.timer = 4.0 + wild_unit(c.site.key + k, int(now)) * 8.0
                f = _dir(g.yaw)
                g.vel = vec3(f.x * 4.0, 3.0, f.y * 4.0); g.beat = 1.0; g.pos.y += 0.3
                _mark(marks, g.pos, g.yaw, now, 0.3, 2)
        else:
            # coming in to its perch: down a glide slope from downwind, slowing, beating to stop
            p = c.site.perches[g.perch]
            to = p.xz - g.pos.xz
            d = f64(length(to))
            g.timer -= dt
            if d < 1.2 and abs(f64(g.pos.y - p.y)) < 1.0:
                other = c.taken[g.perch]
                if other >= 0 and other != k:
                    # someone is on it: a squabble, and the one that was there goes
                    o = c.gulls[other]
                    o.act = .fly; o.perch = -1; o.timer = 6.0 + g.seed * 10.0; o.squabble = 0.0
                    o.vel = vec3(0, 3, 0) + vec3(_dir(o.yaw).x, 0, _dir(o.yaw).y) * 3.0
                    o.beat = 1.0
                    c.gulls[other] = o
                    g.squabble = 1.4
                    _call(calls, .cry, p, 0.12, c.site.key * 32 + k)
                    _call(calls, .cry, p + vec3(0.5, 0, 0), 0.1, c.site.key * 32 + other)
                c.taken[g.perch] = k
                g.act = .perch; g.pos = p; g.vel = vec3(0, 0, 0); g.bank = 0.0
                g.timer = (if night: 600.0 else: 15.0) + wild_unit(c.site.key + k, int(now)) * 60.0
            else if g.timer <= 0.0:
                g.act = .fly; g.timer = 5.0; g.perch = -1
            else:
                into = _unit2(-env.wind.xz, _unit2(to, _dir(g.yaw)))
                # (aim at a point downwind of the perch until close, then at the perch)
                aim = if d > 25.0: p.xz - into * f32(min(d * 0.5, 30.0)) else: p.xz
                speed = clamp(d * 0.3, 2.5, GULL_SPEED)
                alt = f64(p.y) + clamp(d * 0.22, 0.0, 30.0)
                if d < 6.0:
                    # the last metres: hanging on its wings, settling
                    g.beat = 1.0; g.flap += dt * TAU * 3.5
                    off = vec3(p.x, p.y, p.z) - g.pos
                    gap = f64(length(off))
                    q = if gap > 0.001: g.pos + off * f32(min(1.0, min(gap * dt * 2.2, 4.0 * dt) / gap)) else: g.pos
                    g.vel = (q - g.pos) / f32(max(dt, 0.0001))
                    g.pos = q
                    g.yaw = _turn(g.yaw, _yaw_of(_unit2(to, into)), dt * 3.0)
                else:
                    gull_fly(g, _unit2(aim - g.pos.xz, into), speed, alt, env, dt, c.level)
        c.gulls[k] = g
    # perched neighbours fall out now and then
    if not night and c.cry <= 0.0:
        loop k in 0..c.gulls.len():
            if c.gulls[k].act != .perch or c.gulls[k].squabble > 0.0: continue
            loop j in k + 1..c.gulls.len():
                if c.gulls[j].act != .perch: continue
                if f64(length(c.gulls[k].pos - c.gulls[j].pos)) < 1.8 and wild_unit(c.site.key * 7 + k * 31 + j, int(now * 2.0)) < 0.01:
                    c.gulls[k].squabble = 1.2; c.gulls[j].squabble = 1.0
                    _call(calls, .cry, c.gulls[k].pos, 0.11, c.site.key * 32 + k)
                    c.cry = 3.0
                    break
    if c.cry <= 0.0 and wild_unit(c.site.key, int(now)) < 0.08 and c.gulls.len() > 0:
        k = wild_hash(c.site.key, int(now)) % c.gulls.len()
        if c.gulls[k].act == .perch and not night: _call(calls, .cry, c.gulls[k].pos, 0.07, c.site.key * 32 + k); c.cry = 4.0

# ---------------- goats and sheep ----------------

# (captures: every herd made of sheep with AEGEAN_WILD_SHEEP=1, of goats with 0)
wild_force_species = to_int(env("AEGEAN_WILD_SHEEP") ?? "-1") ?? -1

make_herd = (site: WildSite, env: WildEnv) -> Herd:
    h = Herd(site = site, centre = site.at)
    if wild_force_species >= 0: h.site.species = wild_force_species
    loop b in 0..site.count:
        u = wild_unit(site.key, 800 + b); v = wild_unit(site.key, 900 + b)
        ang = u * TAU; r = 2.0 + v * 9.0
        x = f64(site.at.x) + cos(ang) * r; z = f64(site.at.z) + sin(ang) * r
        coat = if site.species == 1: (if wild_unit(site.key, 950 + b) < 0.1: 3 else: wild_hash(site.key, 960 + b) % 3) else: wild_hash(site.key, 970 + b) % 4
        e = Beast(pos = vec3(f32(x), f32(env.ground(x, z)), f32(z)), yaw = v * TAU, coat = coat, seed = u)
        e.timer = 2.0 + u * 12.0
        e.head = if wild_unit(site.key, 980 + b) < 0.7: 1.0 else: 0.0
        if wild_night(env.hour): e.act = .lie; e.low = 1.0; e.head = 0.0
        h.beasts.push(e)
    h

_herd_ok = (env: WildEnv, x: f64, z: f64) -> bool:
    g = env.ground(x, z)
    if g < 3.0 or not _dry(env.water(x, z)) or env.built(x, z): return false
    wild_slope(env, x, z) < 0.85

# (a step from where it stands: onto dry ground no steeper than it can climb; the ground there)
_herd_step = (env: WildEnv, from: vec3, next: vec2) -> f64?:
    g = env.ground(f64(next.x), f64(next.y))
    run = f64(length(next - from.xz))
    if g < 3.0 or (run > 0.0001 and abs(g - f64(from.y)) / run > 0.9): return none
    g

herd_step = (h: mut Herd, threats: WildThreat[], env: WildEnv, dt: f64, now: f64, calls: mut WildCall[]):
    night = wild_night(env.hour)
    goats = h.site.species == 0
    # the herd's grazing moves slowly over its slope
    h.drift -= dt
    if h.drift <= 0.0:
        h.drift = 40.0 + wild_unit(h.site.key, int(now)) * 50.0
        loop tries in 0..4:
            u = wild_unit(h.site.key, int(now) * 4 + tries); v = wild_unit(h.site.key + 1, int(now) * 4 + tries)
            x = f64(h.site.at.x) + (u - 0.5) * 2.0 * h.site.radius; z = f64(h.site.at.z) + (v - 0.5) * 2.0 * h.site.radius
            if _herd_ok(env, x, z): h.centre = vec3(f32(x), f32(env.ground(x, z)), f32(z)); break
    # what frightens them: a low, fast aircraft, or someone walking right up
    scare_from = vec3(0, 0, 0); scared = false
    loop th in threats:
        if th.aircraft:
            ground = env.ground(f64(th.pos.x), f64(th.pos.z))
            if f64(th.pos.y) - max(ground, 0.0) < 90.0 and f64(length(th.vel)) > 12.0:
                miss = _flat(th.pos, h.centre)
                loop k in 1..9:
                    miss = min(miss, _flat(th.pos + th.vel * f32(f64(k) * 0.5), h.centre))
                if miss < 140.0: scared = true; scare_from = th.pos
    if scared and h.scare <= 0.0:
        h.scare = 12.0
        away = _unit2(h.centre.xz - scare_from.xz, vec2(1, 0))
        loop k in 0..h.beasts.len():
            e = h.beasts[k]
            spread = (wild_unit(h.site.key + k, int(now)) - 0.5) * 1.2
            dir = _rot(vec2(f32(sin(spread)), f32(cos(spread))), _yaw_of(away))
            run = 12.0 + e.seed * 18.0
            e.target = e.pos + vec3(dir.x, 0, dir.y) * f32(run)
            e.act = .run; e.timer = 6.0; e.low = 0.0
            e.speed = if goats: 3.6 + e.seed * 1.4 else: 2.6 + e.seed
            h.beasts[k] = e
        _call(calls, if goats: WildVoice.bell else: WildVoice.bleat, h.centre + vec3(0, 1, 0), 0.1, h.site.key)
        _call(calls, .bleat, h.centre + vec3(2, 1, 0), 0.09, h.site.key + 1)
    h.scare = max(0.0, h.scare - dt)
    loop k in 0..h.beasts.len():
        e = h.beasts[k]
        e.timer -= dt
        # (someone on foot right by it: it steps off)
        loop th in threats:
            if not th.aircraft and _flat(th.pos, e.pos) < 7.0 and e.act != .run:
                away = _unit2(e.pos.xz - th.pos.xz, vec2(1, 0))
                e.target = e.pos + vec3(away.x, 0, away.y) * 7.0
                e.act = .walk; e.speed = 1.4; e.timer = 6.0; e.low = 0.0
        if e.act == .lie:
            e.low = min(1.0, e.low + dt * 0.8); e.head = 0.0
            if not night and e.timer <= 0.0: e.act = .look; e.timer = 3.0
        else if night and e.act != .run:
            # (to bed, close by the others)
            to = h.centre.xz - e.pos.xz
            if f64(length(to)) > 5.0 + e.seed * 3.0:
                e.act = .walk; e.target = h.centre + vec3(f32((e.seed - 0.5) * 6.0), 0, f32((wild_unit(h.site.key, k) - 0.5) * 6.0)); e.speed = 0.5
            else:
                e.act = .lie; e.timer = 30.0
        if e.act == .walk or e.act == .run:
            to = e.target.xz - e.pos.xz
            d = f64(length(to))
            step = min(d, e.speed * dt)
            if d > 0.05:
                n = normalize(to)
                next = e.pos.xz + n * f32(step)
                if let g = _herd_step(env, e.pos, next):
                    e.pos = vec3(next.x, f32(g), next.y)
                else:
                    e.timer = min(e.timer, 0.0)
                e.yaw = _turn(e.yaw, _yaw_of(n), dt * (if e.act == .run: 4.0 else: 2.0))
            e.stride += step * (if e.act == .run: 1.6 else: 2.4)
            e.head += ((if e.act == .run: -0.15 else: 0.1) - e.head) * min(1.0, dt * 4.0)
            if d < 0.3 or e.timer <= 0.0:
                e.act = if e.act == .run: BeastAct.look else: BeastAct.graze
                e.timer = if e.act == .look: 3.0 + e.seed * 5.0 else: 5.0 + e.seed * 14.0
            if e.act == .run:
                e.bell -= dt
                if e.bell <= 0.0 and goats:
                    e.bell = 0.6 + e.seed * 0.5
                    _call(calls, .bell, e.pos + vec3(0, 0.6, 0), 0.05, h.site.key * 32 + k)
        else if e.act == .graze:
            e.head += (1.0 - e.head) * min(1.0, dt * 2.0)
            # (a step or two along as it crops)
            if sin(now * 0.5 + e.seed * 30.0) > 0.97:
                f = _dir(e.yaw)
                next = e.pos.xz + f * f32(0.25 * dt)
                if let g = _herd_step(env, e.pos, next): e.pos = vec3(next.x, f32(g), next.y)
                e.stride += 0.25 * dt * 2.4
            if e.timer <= 0.0:
                u = wild_unit(h.site.key * 17 + k, int(now))
                if u < 0.25:
                    e.act = .look; e.timer = 2.0 + u * 10.0
                else:
                    # to fresh grass near the others
                    ang = wild_unit(h.site.key + k, int(now) + 9) * TAU
                    r = 2.0 + wild_unit(h.site.key + k, int(now) + 10) * 8.0
                    e.target = h.centre + vec3(f32(cos(ang) * r), 0, f32(sin(ang) * r))
                    e.act = .walk; e.speed = 0.35 + e.seed * 0.3; e.timer = 25.0
                    if wild_unit(h.site.key + k, int(now) + 11) < 0.15: _call(calls, if goats and u < 0.6: WildVoice.bell else: WildVoice.bleat, e.pos + vec3(0, 0.8, 0), 0.05, h.site.key * 32 + k)
        else if e.act == .look:
            e.head += (-0.1 - e.head) * min(1.0, dt * 3.0)
            if e.timer <= 0.0: e.act = .graze; e.timer = 6.0 + e.seed * 12.0
        if e.act != .lie: e.low = max(0.0, e.low - dt * 1.2)
        # (keep apart a little)
        loop j in 0..h.beasts.len():
            if j == k: continue
            d = e.pos.xz - h.beasts[j].pos.xz
            dl = f64(length(d))
            if dl < 0.9 and dl > 0.001:
                next = e.pos.xz + normalize(d) * f32((0.9 - dl) * dt * 2.0)
                if let g = _herd_step(env, e.pos, next): e.pos = vec3(next.x, f32(g), next.y)
        h.beasts[k] = e

# ---------------- the whole ----------------

_fishing = (v: Vessel) -> bool:
    (v.kind == .sail_caique or v.kind == .motor_caique or v.kind == .trehantiri) and (v.status == .underway or v.status == .anchored)

# A frame of the wildlife about the camera: looked for again as the camera moves, groups brought
# to life as they come near and let go as they fall behind, each stepped.
wildlife_step = (wl: mut Wildlife, towns: Town[], cam: vec3, threats: WildThreat[], boats: Vessel[], env: WildEnv, dt: f64):
    wl.time += dt
    now = wl.time
    clear(wl.calls)
    # (old marks fade away: they are in the order they were made)
    gone = 0
    loop gone < wl.marks.len() and now - wl.marks[gone].born >= WILD_MARK_LIFE: gone += 1
    if gone > 0: wl.marks = wl.marks[gone..]
    above = f64(cam.y) - max(env.ground(f64(cam.x), f64(cam.z)), 0.0)
    if above > WILD_HIGH:
        wl.rafts = []; wl.colonies = []; wl.herds = []
        return
    if _flat(cam, wl.scanned) > WILD_RESCAN: wild_scan(wl, towns, cam, env)
    # let go of those far behind
    rafts: Raft[]
    loop r in wl.rafts:
        if raft_done(r, cam):
            wl.gone[r.site.key] = now + WILD_AWAY
        else if _flat(r.site.at, cam) < WILD_LIVE + 300.0 or r.alarm == 2:
            rafts.push(r)
    wl.rafts = rafts
    colonies: Colony[]
    loop c in wl.colonies:
        if c.boat >= 0:
            alive = false
            loop b in boats:
                if b.id == c.boat and _fishing(b) and _flat(b.position, cam) < WILD_LIVE + 300.0: alive = true
            if alive: colonies.push(c)
        else if _flat(c.site.at, cam) < WILD_LIVE + 300.0: colonies.push(c)
    wl.colonies = colonies
    herds: Herd[]
    loop h in wl.herds:
        if _flat(h.site.at, cam) < WILD_LIVE + 300.0: herds.push(h)
    wl.herds = herds
    # bring to life those come near
    loop s in wl.sites:
        if _flat(s.at, cam) > WILD_LIVE: continue
        if s.key in wl.gone:
            if now < wl.gone[s.key]: continue
            wl.gone.remove(s.key)
        match s.kind:
            .raft:
                live = false
                loop r in wl.rafts:
                    if r.site.key == s.key: live = true
                if not live and (s.resident or wild_raft_present(s.key, env.day)): wl.rafts.push(make_raft(s, env))
            .colony:
                live = false
                loop c in wl.colonies:
                    if c.site.key == s.key: live = true
                if not live: wl.colonies.push(make_colony(s, env))
            .herd:
                live = false
                loop h in wl.herds:
                    if h.site.key == s.key: live = true
                if not live: wl.herds.push(make_herd(s, env))
    # gulls after the fishing boats out by day
    if not wild_night(env.hour):
        loop b in boats:
            if not _fishing(b) or _flat(b.position, cam) > WILD_LIVE: continue
            live = false
            loop c in wl.colonies:
                if c.boat == b.id: live = true
            if live or wild_unit(b.id, 31) > 0.7: continue
            site = WildSite(5000000 + b.id, .colony, b.position, radius = 14.0, count = 3 + wild_hash(b.id, 32) % 5)
            wl.colonies.push(make_colony(site, env, b.id))
    loop k in 0..wl.rafts.len():
        r = wl.rafts[k]
        raft_step(r, threats, env, dt, now, wl.marks, wl.calls)
        wl.rafts[k] = r
    loop k in 0..wl.colonies.len():
        c = wl.colonies[k]
        boat: Vessel? = none
        if c.boat >= 0:
            loop b in boats:
                if b.id == c.boat: boat = b
        colony_step(c, threats, env, dt, now, boat, wl.calls, wl.marks)
        wl.colonies[k] = c
    loop k in 0..wl.herds.len():
        h = wl.herds[k]
        herd_step(h, threats, env, dt, now, wl.calls)
        wl.herds[k] = h

wildlife_count = (wl: Wildlife) -> int:
    n = 0
    loop r in wl.rafts: n += r.geese.len()
    loop c in wl.colonies: n += c.gulls.len()
    loop h in wl.herds: n += h.beasts.len()
    n
