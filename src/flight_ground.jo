# Exact contact-surface memoization for many aircraft/rounds. No lower-resolution terrain:
# cache the authoritative 14 m vertices and use the world's original triangle arithmetic.
# Keep legacy islands on their original path (their grids have individual origins).
use 'world.jo'
use 'geography.jo'

const FLIGHT_GROUND_SLOTS = 8192
struct FlightGroundVertex:
    x = 0
    z = 0
    revision = -1
    height = 0.0

flight_ground_vertices = [loop i in 0..FLIGHT_GROUND_SLOTS:FlightGroundVertex()]

flight_ground_vertex = (x:int,z:int)->f64:
    global flight_ground_vertices
    slot=((x*73856093) xor (z*19349663)) & (FLIGHT_GROUND_SLOTS-1)
    old=flight_ground_vertices[slot]
    if old.revision==geography_revision and old.x==x and old.z==z:return old.height
    value=new_land_canonical(f64(x)*MESH_STEP,f64(z)*MESH_STEP)
    flight_ground_vertices[slot]=FlightGroundVertex(x,z,geography_revision,value)
    value

flight_surface_height = (x:f64,z:f64)->f64:
    # Legacy coverage is a cheap exact broad test, including its grid-edge convention.
    loop isl in ISLANDS:
        ext=mesh_extent(isl)
        fx=(x-(f64(isl.center.x)-ext))/MESH_STEP
        fz=(z-(f64(isl.center.y)-ext))/MESH_STEP
        if fx>=0 and fz>=0 and fx<=ext*2.0/MESH_STEP and fz<=ext*2.0/MESH_STEP:
            return surface_height(x,z)
    if not geography_enabled or (abs(x)<LEGACY_RESERVE and abs(z)<LEGACY_RESERVE):return -60.0
    ix=int(floor(x/MESH_STEP));iz=int(floor(z/MESH_STEP))
    ax=f64(ix)*MESH_STEP;az=f64(iz)*MESH_STEP
    u=(x-ax)/MESH_STEP;v=(z-az)/MESH_STEP
    a=flight_ground_vertex(ix,iz);b=flight_ground_vertex(ix+1,iz)
    c=flight_ground_vertex(ix,iz+1);d=flight_ground_vertex(ix+1,iz+1)
    triangle_height(a,b,c,d,u,v)
