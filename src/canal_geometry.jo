# Neravessa: shared solid geometry for the canal city's draw and swept contact.
use 'river_data.jo'
use 'baked_assets.jo'
use 'geography.jo'
use 'world_source.jo'
use 'river_field.jo'
const CANAL_CITY_ID=1900731
const CANAL_CITY_NAME="Neravessa"
struct CanalSolid:
    center:vec3
    half:vec3
    heading:f64
    kind:int=0
    look:int=0                      # how canal_render.jo draws it: 0 by its kind, 1 dressed stone, -1 not at all (drawn whole elsewhere); a building: 2 its front along +x, 3 along -x
canal_solids:CanalSolid[]
canal_bins:{int:int[]}
canal_bin=(x:f64,z:f64)->int:int(floor(x/64.0))*16384+int(floor(z/64.0))
canal_origin=vec3(RIVER_NODES[CANAL_BEGIN+30].x,0,RIVER_NODES[CANAL_BEGIN+30].y)

# Where Neravessa's people stand along its promenades, bridges and market (world x, y, z and the way
# they face, as draw_figure's yaw): put there as the canal's pieces are built (src/canal_city.jo
# canal_figure) and drawn and met as the town's crowd (src/ambient_crowd.jo).
canal_people: vec4[] = []
canal_people_keys: {int: bool} = {}
canal_person_at = (local: vec3, facing: vec2):
    global canal_people, canal_people_keys
    w = local + canal_origin
    key = int(floor(f64(w.x) * 4.0)) * 92821 + int(floor(f64(w.z) * 4.0))
    if key in canal_people_keys: return
    canal_people_keys[key] = true
    canal_people.push(vec4(w.x, w.y, w.z, f32(atan2(f64(facing.x), f64(facing.y)))))
canal_workshop=vec3(0,0,0)
# The shop floor beside the slipway: the city's gathering point, where people without a venue of
# their own stand (never on the ways down the middle).
canal_yard=vec3(0,0,0)
canal_launch=vec3(0,0,0)
canal_heading=0.0
# The workshop's slipway, in the shop's frame (+z out through the door to the water, y up from
# the shop floor): its top inside the shop, where it meets the canal's water, and its foot.
# (the ramp's head is just forward of the shop's centre, which stays level floor: the workshop's
# standing point and the town's centre)
const SLIP_TOP=1.5
const SLIP_WATER=25.0
const SLIP_FOOT=27.5
const SLIP_HALF=7.6
slip_slope=()->f64:2.0/(SLIP_WATER-SLIP_TOP)
slip_frame=()->f64:canal_heading+PI*0.5
# A point on the ways' surface, z along them.
slip_point=(z:f64)->vec3:
    p=canal_workshop+canal_world_dir(vec3(0,0,f32(z)),slip_frame())
    vec3(p.x,f32(f64(canal_workshop.y)-(z-SLIP_TOP)*slip_slope()),p.z)

# The cut: the city's streets stand this far over the canal's water, behind dark stone walls with a
# parapet; the workshop's working yard is lower, at the shop floor.
const CANAL_STREET=5.0
const CANAL_YARD_LEVEL=2.0
const CANAL_PARAPET=1.1
const CANAL_PROMENADE=8.0
const CANAL_ROW_DEPTH=18.0
# The street behind an arm's or a mouth's wall: deep enough to cover the carve's bank, which falls
# below the sea's level within some 20 m of the wall (the sea's surface would show in the trench).
const CANAL_ARM_TERRACE=20.0

# The crossings, by canal node (offset from CANAL_BEGIN): a bridge every 100-300 m of the cut, the
# basin (44-53) between its entry and exit arches, nothing over the lagoon beside the last straight
# (58-67).
# Heights are over the water: the underside at the walls and at the centre, and the deck's top at
# the centre. A planing Gull's top wing is ~3.9 m over the water: every crossing lets one held
# within ~8 m of the centre line through with a metre or more to spare, or over if it is flying.
struct CanalBridge:
    local:int
    kind:int                        # 0 stone arch, 1 steel truss, 2 low iron footbridge, 3 pipe bridge
    spring:f64
    crown:f64
    deck:f64
const CANAL_STONE=0
const CANAL_TRUSS=1
const CANAL_FOOT=2
const CANAL_PIPES=3
CANAL_BRIDGES=[CanalBridge(4,CANAL_TRUSS,11.0,11.0,11.8),CanalBridge(8,CANAL_STONE,3.8,8.4,9.8),CanalBridge(15,CANAL_STONE,4.0,9.0,10.4),
    CanalBridge(19,CANAL_FOOT,6.2,6.2,6.7),CanalBridge(26,CANAL_STONE,4.0,9.0,10.4),CanalBridge(29,CANAL_STONE,3.6,8.2,9.6),CanalBridge(34,CANAL_STONE,3.8,8.6,10.0),CanalBridge(38,CANAL_TRUSS,13.0,13.0,13.8),
    CanalBridge(41,CANAL_FOOT,6.2,6.2,6.7),CanalBridge(44,CANAL_STONE,3.6,8.0,9.4),CanalBridge(51,CANAL_TRUSS,11.0,11.0,11.8),CanalBridge(53,CANAL_STONE,3.8,8.4,9.8),CanalBridge(57,CANAL_FOOT,5.0,5.0,5.5)]
# Each bridge's half width along the canal, and how far its abutments run onto either bank.
canal_bridge_half=(b:CanalBridge)->f64:if b.kind==CANAL_STONE:5.0 else:if b.kind==CANAL_TRUSS:3.0 else:if b.kind==CANAL_FOOT:1.5 else:1.2
canal_bridge_reach=(b:CanalBridge)->f64:if b.kind==CANAL_STONE:6.0 else:4.0
# The underside over the water at x across the canal (half width w): a stone arch is a flat
# ellipse from wall to wall; the others are flat.
canal_bridge_under=(b:CanalBridge,x:f64,w:f64)->f64:
    if b.kind!=CANAL_STONE:return b.crown
    u=clamp(x/w,-1.0,1.0)
    b.spring+(b.crown-b.spring)*sqrt(max(0.0,1.0-u*u))
# The deck's top: a stone bridge has a slight hump.
canal_bridge_top=(b:CanalBridge,x:f64,w:f64)->f64:
    if b.kind!=CANAL_STONE:return b.deck
    u=clamp(x/(w+canal_bridge_reach(b)),-1.0,1.0)
    b.deck-0.7*u*u
canal_bridge_index=(local:int)->int:
    loop k in 0..CANAL_BRIDGES.len():
        if CANAL_BRIDGES[k].local==local:return k
    -1
canal_bridge_near=(local:int)->bool:
    loop b in CANAL_BRIDGES:
        if b.kind!=CANAL_PIPES and abs(b.local-local)<=1:return true
    false

# Steps down the wall to the water, by node and bank: a stair flight against the wall's face and
# a landing at the water, with mooring rings and bollards.
CANAL_WATER_STAIRS:(int,f64)[]=[(11,-1.0),(30,1.0),(41,-1.0),(48,-1.0),(55,-1.0),(62,-1.0)]
canal_water_stair=(local:int,sign:f64)->bool:
    loop s in CANAL_WATER_STAIRS:
        if s.0==local and s.1==sign:return true
    false

# The skyline's set pieces, where the canal's bends end its vistas: (node, bank, row, what):
# 0 a domed church, 1 a bell tower over a block, 2 a works chimney beside one.
CANAL_SKYLINE:(int,f64,int,int)[]=[(12,1.0,2,0),(26,-1.0,2,1),(33,1.0,2,1),(37,1.0,3,2),(41,-1.0,2,0),(45,1.0,3,1),
    (47,-1.0,3,2),(55,-1.0,2,1),(58,1.0,2,2),(60,1.0,3,1),(63,-1.0,3,0),(16,-1.0,3,2)]
canal_skyline=(local:int,sign:f64,row:int)->int:
    loop k in CANAL_SKYLINE:
        if k.0==local and k.1==sign and k.2==row:return k.3
    -1

# What a bank has along a segment: 0 a promenade with trees and lamps before the houses, 1 works
# and warehouses standing straight on the wall, 2 the workshop's low yard, 3 an arm's mouth (no
# wall), 4 a bridge's square.
canal_frontage=(local:int,sign:f64)->int:
    if (local>=31 and local<=33 and sign<0.0) or (local>=47 and local<=49 and sign>0.0):return 3
    if sign>0.0 and ((local>=11 and local<=12) or (local>=38 and local<=39)):return 3
    # (the lagoon opens beside the last straight: canal_lagoon)
    if local>=57 and local<=68 and sign>0.0:return 3
    if sign>0.0 and local>=18 and local<=26:return 2
    if canal_bridge_near(local):return 4
    if canal_water_stair(local,sign) or canal_water_stair(local-1,sign) or canal_water_stair(local+1,sign):return 0
    if (local*5+(if sign>0.0:3 else:0))%9<2 and local>=5 and local<=68:return 1
    0
canal_promenade_width=(front:int)->f64:if front==1:0.0 else:CANAL_PROMENADE
canal_street=(front:int)->f64:if front==2:CANAL_YARD_LEVEL else:CANAL_STREET

# A drawn length of quay wall (its face along the water from a to b, the bank's side outward):
# canal_render.jo dresses these; their solids are below.
struct CanalBank:
    a:vec2
    b:vec2
    out:vec2
    water:f64
    street:f64
    terrace:f64                     # how far the street runs back from the wall before it drops to the town
    front:int
    parapet:bool
    local:int=-1
    sign:f64=0.0
    oa:vec2=vec2(0,0)               # the street's back edge runs along these at a and b (zero: out), so pieces join on bends
    ob:vec2=vec2(0,0)
    stair:vec3=vec3(0,0,0)          # a stair down to the water, recessed in the wall: its head, foot and landing's end, metres along a to b from the segment's middle (z 0: none)
canal_banks:CanalBank[]
# Station normals averaged at each node, so drawn walls join without cracks at the bends.
canal_node_side=(i:int)->vec2:
    prev=RIVER_NODES[max(CANAL_BEGIN,i-1)];next=RIVER_NODES[min(CANAL_FINISH,i+1)]
    d=normalize(next.xy-prev.xy)
    vec2(-d.y,d.x)

# An arm's normal averaged at node i (its ends keep their own segment's).
canal_arm_side=(i:int)->vec2:
    prev=if RIVER_BREAKS.contains(i-1):RIVER_NODES[i] else:RIVER_NODES[i-1]
    next=if RIVER_BREAKS.contains(i) or i+1>=RIVER_NODES.len():RIVER_NODES[i] else:RIVER_NODES[i+1]
    d=normalize(next.xy-prev.xy+vec2(0.00001,0))
    vec2(-d.y,d.x)

canal_add=(at:vec3,half:vec3,h:f64,kind:int=0,look:int=0):
    global canal_solids,canal_bins
    index=canal_solids.len()
    canal_solids.push(CanalSolid(at,half,h,kind,look))
    radius=f64(length(half.xz))
    loop x in int(floor((f64(at.x)-radius)/64.0))..int(floor((f64(at.x)+radius)/64.0))+1:
        loop z in int(floor((f64(at.z)-radius)/64.0))..int(floor((f64(at.z)+radius)/64.0))+1:
            key=x*16384+z
            if not (key in canal_bins):canal_bins[key]=[]
            canal_bins[key].push(index)
canal_local=(p:vec3,box:CanalSolid)->vec3:transform_point(rotation_y(box.heading),p-box.center)
canal_world_dir=(p:vec3,h:f64)->vec3:(rotation_y(-h)*vec4(p,0)).xyz

# A box across the canal's frame: from x0 to x1 out from the centre line (along side), y0 to y1
# over the world, half along either side of the point at.
canal_slab=(at:vec2,side:vec2,h:f64,x0:f64,x1:f64,y0:f64,y1:f64,along:f64,kind:int,look:int):
    q=at+side*f32((x0+x1)*0.5)
    canal_add(vec3(q.x,f32((y0+y1)*0.5),q.y),vec3(f32(abs(x1-x0)*0.5),f32((y1-y0)*0.5),f32(along)),h,kind,look)

# A flight of steps rising from (from, low) to (to, high): walkable boxes, each rise below the
# walkers' step limit.
canal_stair=(from:vec2,to:vec2,low:f64,high:f64,width:f64,count:int):
    d=to-from;h=atan2(f64(d.x),-f64(d.y))
    loop k in 0..count:
        top=low+(high-low)*(f64(k)+1.0)/f64(count)
        q=from+d*f32((f64(k)+0.5)/f64(count))
        base=low-1.0
        canal_add(vec3(q.x,f32((top+base)*0.5),q.y),vec3(f32(width*0.5),f32((top-base)*0.5),f32(f64(length(d))/f64(count)*0.5+0.02)),h,0,1)

# How far p is outside the through-channel's water (negative: in it).
canal_main_gap=(p:vec2)->f64:
    best=1e30
    loop i in CANAL_BEGIN..CANAL_FINISH:
        a=RIVER_NODES[i];b=RIVER_NODES[i+1];d=b.xy-a.xy
        u=clamp(dot(p-a.xy,d)/max(dot(d,d),0.001),0.0,1.0)
        best=min(best,f64(length(p-a.xy-d*u))-f64(mix(a.w,b.w,u)))
    best

# A slab along the wall line from ea to eb (fractions u0..u1 of it), from d0 to d1 out from the
# line on the bank's side, y0 to y1 over the world; a little longer than its piece at each end.
canal_line_slab=(ea:vec2,eb:vec2,out:vec2,u0:f64,u1:f64,d0:f64,d1:f64,y0:f64,y1:f64,kind:int,look:int,extend:f64=0.3):
    pa=mix(ea,eb,f32(u0));pb=mix(ea,eb,f32(u1))
    d=pb-pa;l=f64(length(d))
    if l<0.01:return
    t=d/f32(l);n=vec2(-t.y,t.x)
    if f64(dot(n,out))<0.0:n=-n
    c=(pa+pb)*0.5+n*f32((d0+d1)*0.5)
    canal_add(vec3(c.x,f32((y0+y1)*0.5),c.y),vec3(f32(abs(d1-d0)*0.5),f32((y1-y0)*0.5),f32(l*0.5+extend)),atan2(f64(t.x),-f64(t.y)),kind,look)

# Collision must be ready on the first simulation tick. Store the generated solids,
# streets and their spatial index together so starting anywhere costs one binary read.
struct CanalLayout:
    solids:CanalSolid[]
    banks:CanalBank[]
    bins:{int:int[]}
    workshop:vec3
    launch:vec3
    yard:vec3
    heading:f64
    key:u64
canal_layout_key=()->u64:hash((geography_key(),hash(embed('canal_geometry.jo'))))
const CANAL_LAYOUT_BAKE="canal-layout-v1.bin"
init_canal_geometry=():
    global canal_solids,canal_banks,canal_bins,canal_workshop,canal_launch,canal_yard,canal_heading
    if canal_solids.len()>0:return
    if let b=baked_asset(CANAL_LAYOUT_BAKE):
        layout=from_bytes[CanalLayout](b)
        if layout is CanalLayout and layout.key==canal_layout_key():
            canal_solids=layout.solids;canal_banks=layout.banks;canal_bins=layout.bins
            canal_workshop=layout.workshop;canal_launch=layout.launch;canal_yard=layout.yard;canal_heading=layout.heading
            return
    generate_canal_layout()

generate_canal_layout=():
    global canal_solids,canal_workshop,canal_launch,canal_heading,canal_yard,canal_banks
    if canal_solids.len()>0:return
    loop i in CANAL_BEGIN..CANAL_FINISH:
        a=RIVER_NODES[i];b=RIVER_NODES[i+1]
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        h=atan2(f64(dir.x),-f64(dir.y));mid=(a+b)*0.5
        length=f64(length(b.xy-a.xy));water=f64(mid.z)
        local=i-CANAL_BEGIN;w=f64(mid.w)
        loop sign in [-1.0,1.0]:
            front=canal_frontage(local,sign)
            if local==22 and sign>0.0:continue
            if front==3:
                # (an arm's mouth: walls only where its water doesn't open behind them)
                s=side*f32(sign)
                loop part in 0..4:
                    u0=f32(f64(part)*0.25);u1=f32(f64(part+1)*0.25)
                    pa=mix(a.xy,b.xy,u0);pb=mix(a.xy,b.xy,u1);pm=(pa+pb)*0.5
                    probe=pm+s*f32(w+3.0)
                    if river_at(f64(probe.x),f64(probe.y)).wet:continue
                    # (the street behind stops short of the arm's water)
                    deep=2.0
                    loop deep<CANAL_ARM_TERRACE and not river_at(f64(pm.x+s.x*f32(w+deep+2.0)),f64(pm.y+s.y*f32(w+deep+2.0))).wet:deep+=2.0
                    # (on the same averaged wall line as the banks either side, so the ends meet)
                    ea=a.xy+canal_node_side(i)*f32(sign*f64(a.w));eb=b.xy+canal_node_side(i+1)*f32(sign*f64(b.w))
                    na=normalize(mix(canal_node_side(i),canal_node_side(i+1),u0))*f32(sign);nb=normalize(mix(canal_node_side(i),canal_node_side(i+1),u1))*f32(sign)
                    canal_banks.push(CanalBank(mix(ea,eb,u0),mix(ea,eb,u1),s,water,water+CANAL_STREET,deep,0,true,local,sign,oa=na,ob=nb))
                    canal_line_slab(ea,eb,s,f64(u0),f64(u1),0.0,1.8,water-4.6,water+CANAL_STREET,0,-1)
                    canal_line_slab(ea,eb,s,f64(u0),f64(u1),1.8,max(deep,2.0),water+CANAL_STREET-3.0,water+CANAL_STREET,8,-1)
                    canal_line_slab(ea,eb,s,f64(u0),f64(u1),0.0,0.5,water+CANAL_STREET,water+CANAL_STREET+CANAL_PARAPET,11,-1)
                continue
            street=water+canal_street(front)
            p=canal_promenade_width(front)
            terrace=if front==4:46.0 else:if front==2:30.0 else:p+CANAL_ROW_DEPTH+6.0
            stair=canal_water_stair(local,sign)
            # (a stair down to the water sits in the wall's thickness: head, foot and landing's end)
            t_top=-length*0.36;t_foot=length*0.24;t_land=t_foot+3.0
            canal_banks.push(CanalBank(a.xy+canal_node_side(i)*f32(sign*f64(a.w)),b.xy+canal_node_side(i+1)*f32(sign*f64(b.w)),side*f32(sign),
                water,street,terrace,front,front!=1 and front!=2,local,sign,stair=if stair:vec3(f32(t_top),f32(t_foot),f32(t_land)) else:vec3(0,0,0),oa=canal_node_side(i)*f32(sign),ob=canal_node_side(i+1)*f32(sign)))
            s=side*f32(sign)
            # The wall, from the canal's bed to the street; the street behind it, its edge over
            # the town's ground; the parapet along the top (open over a stair down to the water).
            # (along the drawn wall line, which follows the canal's width: a basin's walls flare)
            ea=a.xy+canal_node_side(i)*f32(sign*f64(a.w));eb=b.xy+canal_node_side(i+1)*f32(sign*f64(b.w))
            at=(t:f64)->f64:t/length+0.5
            spans:(f64,f64)[]=if stair:[(0.0,at(t_top)),(at(t_land),1.0)] else:[(0.0,1.0)]
            loop span in spans:
                canal_line_slab(ea,eb,s,span.0,span.1,0.0,1.8,water-4.6,street,0,-1)
                if front!=1 and front!=2:canal_line_slab(ea,eb,s,span.0,span.1,0.0,0.5,street,street+CANAL_PARAPET,11,-1)
            canal_line_slab(ea,eb,s,0.0,1.0,1.8,terrace,street-3.0,street,8,-1)
            if stair:
                canal_line_slab(ea,eb,s,at(t_top),at(t_land),0.0,1.8,water-4.6,water-0.6,0,-1,0.0)
                top=mid.xy+s*f32(w+0.9)+dir*f32(t_top)
                foot=mid.xy+s*f32(w+0.9)+dir*f32(t_foot)
                canal_stair(foot,top,water+0.45,street,1.6,22)
                landing=mid.xy+s*f32(w+0.9)+dir*f32((t_foot+t_land)*0.5)
                canal_add(vec3(landing.x,f32(water-0.25),landing.y),vec3(0.8,0.7,f32((t_land-t_foot)*0.5)),h,0,1)
            if front==2 and (local==18 or local==26):
                # (the yard's ends: steps up to the street of the next stretch)
                end=if local==18:a.xy else:b.xy
                inward=if local==18:dir else:-dir
                canal_stair(end+s*f32(w+6.0)+inward*7.0,end+s*f32(w+6.0)+inward*0.2,water+CANAL_YARD_LEVEL,water+CANAL_STREET,3.0,14)
            if front==4 or local%10==7:
                # (the street's back edge: steps down to the town's lanes)
                back=mid.xy+s*f32(w+terrace)
                canal_stair(back+s*6.0,back,water+2.0,street,4.0,14)
            bridge_access=front==4
            if local<5 or local>68:continue
            # (a long segment, round the lagoon, is built up in pieces some 40 m long or less)
            pieces=max(1,int(ceil(length/42.0)))
            loop piece_k in 0..pieces:
                along=(f64(piece_k)+0.5)*length/f64(pieces)-length*0.5
                part=length/f64(pieces)
                # Workshops and the market have deep blocks; outer wards taper to gardens.
                rows=if local<8 or local>65:11 else:if local<20 or local>=42 and local<54:19 else:15
                loop row in 0..rows:
                    # Cross streets and little squares interrupt dense perimeter blocks.
                    if (bridge_access and row<2) or (local%10==7 and row>0):continue
                    if front==2 and row<2:continue
                    if row>3 and local%7==0:continue
                    # (the wall's line at the piece: a flaring wall stands further out along it)
                    offset=f64(mix(a.w,b.w,f32(along/length+0.5)))+(if row==0:p else:CANAL_PROMENADE)+CANAL_ROW_DEPTH*0.5+f64(row)*24.0
                    q=mid.xy+dir*f32(along)+s*f32(offset)
                    r=river_at(f64(q.x),f64(q.y))
                    if r.wet or r.distance<r.width+5.0:continue
                    ground=max(if row==0:street else:water+2.0,world_source_surface(f64(q.x),f64(q.y)))
                    seed=local*7+row*5+int(sign)+piece_k*11
                    storeys=if row==0:(if front==1:3+seed%2 else:4+seed%3) else:3+(seed*3+row)%4
                    height=4.6+3.5*f64(storeys-1)+(if front==1:2.0 else:0.0)
                    depth=if row==0:part*0.5+0.15 else:min(14.0,part*0.5-0.6)
                    # Each building has a small footing rather than a district-wide sand pad.
                    canal_add(vec3(q.x,f32(ground-1.0),q.y),vec3(f32(CANAL_ROW_DEPTH*0.5+0.2),1.0,f32(depth+0.2)),h,0,-1)
                    piece=if piece_k==0:canal_skyline(local,sign,row) else:-1
                    church=piece==0 or (row==8 and piece_k==0 and ((local==14 and sign<0.0) or (local==52 and sign>0.0))) or (row==3 and ((local==28 and sign<0.0) or (local==51 and sign>0.0)))
                    warehouse=row==0 and front==1
                    landmark=piece==1 or (row>=2 and row<7 and not church and ((local*13+row*7+int(sign+1.0)+piece_k*5)%23==0))
                    kind=if church:9 else:if warehouse:10 else:if landmark:12 else:1
                    # (look 2: its front, toward the water, along the box's +x; 3: along -x; 4 and 5 the
                    # same with a flat roof: every third block of the front row, one in six of the rest)
                    facing=if f64(dot(canal_world_dir(vec3(1,0,0),h).xz,-s))>0.0:2 else:3
                    flat=if row==0:local%3==0 else:(local*7+row*5+int(sign+1.0))%6==0
                    if flat:facing+=2
                    canal_add(vec3(q.x,f32(ground+height*0.5),q.y),vec3(f32(CANAL_ROW_DEPTH*0.5),f32(height*0.5),f32(depth)),h,kind,facing)
                    if landmark:
                        # (a bell tower over a corner of the block: the skyline's verticals)
                        t=q+s*4.5
                        rise=if piece==1:13.0 else:9.0
                        canal_add(vec3(t.x,f32(ground+height+rise),t.y),vec3(2.6,f32(rise),2.6),h,14,-1)
                    if piece==2:
                        t=q+dir*f32(depth*0.6)
                        canal_add(vec3(t.x,f32(ground+17.0),t.y),vec3(1.4,17.0,1.4),h,15,-1)
                    if row==1 and front==1 and local%2==0:
                        # (a works' brick chimney behind the warehouses on the wall)
                        t=q+dir*f32(depth*0.5)
                        canal_add(vec3(t.x,f32(ground+15.0),t.y),vec3(1.3,15.0,1.3),h,15,-1)
                    # Side alleys occupy the gaps between rows, climbing with the hillside.
                    if row>0 and local%3==0:
                        alley=q-s*12.0
                        canal_add(vec3(alley.x,f32(ground-0.15),alley.y),vec3(3,0.15,f32(part*0.5)),h,8,-1)
    # The short commercial arms have street-high walls too. Leave their mouths
    # open wherever the through-channel overlaps them.
    loop i in CANAL_FINISH+1..RIVER_NODES.len()-1:
        if RIVER_BREAKS.contains(i):continue
        a=RIVER_NODES[i];b=RIVER_NODES[i+1];mid=(a+b)*0.5
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        h=atan2(f64(dir.x),-f64(dir.y));reach=f64(length(b.xy-a.xy))
        loop sign in [-1.0,1.0]:
            s=side*f32(sign);water=f64(mid.z)
            # (in quarters: a wall wherever the main canal's water doesn't open behind it)
            # (the wall's line joins at each node along the averaged normal, so a bend has no gaps)
            ea=a.xy+canal_arm_side(i)*f32(sign*f64(a.w));eb=b.xy+canal_arm_side(i+1)*f32(sign*f64(b.w))
            loop part in 0..4:
                u0=f32(f64(part)*0.25);u1=f32(f64(part+1)*0.25)
                pa=mix(a,b,u0);pb=mix(a,b,u1);pm=(pa+pb)*0.5;w=f64(pm.w)
                wa=mix(ea,eb,u0);wb=mix(ea,eb,u1)
                # (never across the through-channel where an arm leaves it, but up to its wall line, so
                # the corner where they meet is closed; the arm's own bends don't count)
                if min(canal_main_gap(wa),min(canal_main_gap((wa+wb)*0.5),canal_main_gap(wb)))< -0.3:continue
                # (the street behind stops short of the through-channel near the arm's mouth)
                deep=2.0
                loop deep<CANAL_ARM_TERRACE and canal_main_gap(wa+s*f32(deep+2.0))>1.0 and canal_main_gap(wb+s*f32(deep+2.0))>1.0 and canal_main_gap((wa+wb)*0.5+s*f32(deep+2.0))>1.0:deep+=2.0
                na=normalize(mix(canal_arm_side(i),canal_arm_side(i+1),u0))*f32(sign);nb=normalize(mix(canal_arm_side(i),canal_arm_side(i+1),u1))*f32(sign)
                canal_banks.push(CanalBank(wa,wb,s,water,water+CANAL_STREET,deep,0,true,oa=na,ob=nb))
                canal_slab(pm.xy,s,h,w,w+1.8,water-4.6,water+CANAL_STREET,reach*0.125+0.4,0,-1)
                canal_slab(pm.xy,s,h,w+1.8,w+max(deep,2.0),water+CANAL_STREET-3.0,water+CANAL_STREET,reach*0.125+0.4,8,-1)
                canal_slab(pm.xy,s,h,w,w+0.5,water+CANAL_STREET,water+CANAL_STREET+CANAL_PARAPET,reach*0.125+0.4,11,-1)
    # Houses along the arms: a row standing on the wall's street, one behind on the town's ground
    # (plainer blocks, kind 16), wherever the main canal's rows left the ground open.
    taken:vec2[]=[loop box in canal_solids:if box.kind==1 or box.kind==9 or box.kind==10 or box.kind==12:box.center.xz]
    loop i in CANAL_FINISH+1..RIVER_NODES.len()-1:
        if RIVER_BREAKS.contains(i) or i+1>=RIVER_NODES.len()-1:continue
        a=RIVER_NODES[i];b=RIVER_NODES[i+1];mid=(a+b)*0.5
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        h=atan2(f64(dir.x),-f64(dir.y));reach=f64(length(b.xy-a.xy))
        loop sign in [-1.0,1.0]:
            s=side*f32(sign);water=f64(mid.z);w=f64(mid.w)
            loop row in 0..4:
                offset=w+10.0+26.0*f64(row)
                q=mid.xy+s*f32(offset)
                if canal_main_gap(q)<12.0:continue
                r=river_at(f64(q.x),f64(q.y))
                if r.wet or r.distance<r.width+8.0:continue
                clash=false
                loop t in taken:
                    if f64(length(t-q))<17.0:clash=true;break
                if clash:continue
                taken.push(q)
                ground=if row==0:water+CANAL_STREET else:max(water+2.0,world_source_surface(f64(q.x),f64(q.y)))
                seed=i*7+row*5+int(sign)
                height=4.6+3.5*f64(3+(seed*3+row)%3)
                depth=min(13.0,reach*0.5-0.4)
                facing=if f64(dot(canal_world_dir(vec3(1,0,0),h).xz,-s))>0.0:2 else:3
                if (i+row)%6==0:facing+=2
                canal_add(vec3(q.x,f32(ground-1.0),q.y),vec3(9.2,1.0,f32(depth+0.2)),h,0,-1)
                canal_add(vec3(q.x,f32(ground+height*0.5),q.y),vec3(9.0,f32(height*0.5),f32(depth)),h,16,facing)
    # The arms' closed ends: a round wall at each far end, and at the start of one that stands clear
    # of the through-channel (the lagoon), all but where the through-channel's own water is.
    ends:(int,int)[]=[loop boundary in RIVER_BREAKS:if boundary>CANAL_FINISH:(boundary,boundary-1)]+[(RIVER_NODES.len()-1,RIVER_NODES.len()-2)]
    loop boundary in RIVER_BREAKS:
        if boundary>=CANAL_FINISH and boundary+2<RIVER_NODES.len() and canal_main_gap(RIVER_NODES[boundary+1].xy)>0.0:ends.push((boundary+1,boundary+2))
    loop end in ends:
        endpoint,inner=end
        a=RIVER_NODES[endpoint];previous=RIVER_NODES[inner]
        dir=normalize(a.xy-previous.xy);side=vec2(-dir.y,dir.x)
        loop section in 0..12:
            angle=-PI*0.5+(f64(section)+0.5)*PI/12.0
            radial=dir*f32(cos(angle))+side*f32(sin(angle))
            a0=-PI*0.5+f64(section)*PI/12.0;a1=a0+PI/12.0
            r0=dir*f32(cos(a0))+side*f32(sin(a0));r1=dir*f32(cos(a1))+side*f32(sin(a1))
            if min(canal_main_gap(a.xy+r0*a.w),min(canal_main_gap(a.xy+radial*a.w),canal_main_gap(a.xy+r1*a.w)))< -0.3:continue
            # (nor where the section's straight slabs, out to the street's back, would reach over it)
            if min(canal_main_gap(a.xy+r0*(a.w+21.0)),canal_main_gap(a.xy+r1*(a.w+21.0)))<1.0:continue
            if a.w>60.0:
                # (round a wide end, a row of houses on its street as along its sides)
                q=a.xy+radial*(a.w+10.0)
                clash=canal_main_gap(q)<12.0 or river_at(f64(q.x),f64(q.y)).wet
                loop t in taken:
                    if f64(length(t-q))<17.0:clash=true;break
                if not clash:
                    taken.push(q)
                    tangent=vec2(-radial.y,radial.x);ht=atan2(f64(tangent.x),-f64(tangent.y))
                    seed=endpoint*7+section*5
                    height=4.6+3.5*f64(3+(seed*3)%3)
                    depth=min(13.0,f64(a.w)*PI/24.0-0.4)
                    ground=f64(a.z)+CANAL_STREET
                    facing=if f64(dot(canal_world_dir(vec3(1,0,0),ht).xz,-radial))>0.0:2 else:3
                    canal_add(vec3(q.x,f32(ground-1.0),q.y),vec3(9.2,1.0,f32(depth+0.2)),ht,0,-1)
                    canal_add(vec3(q.x,f32(ground+height*0.5),q.y),vec3(9.0,f32(height*0.5),f32(depth)),ht,16,facing)
            canal_banks.push(CanalBank(a.xy+r1*a.w,a.xy+r0*a.w,radial,f64(a.z),f64(a.z)+CANAL_STREET,CANAL_ARM_TERRACE,0,true))
            qf=a.xy+radial*(a.w+f32((11.0+CANAL_ARM_TERRACE)*0.5))
            canal_add(vec3(qf.x,f32(f64(a.z)+CANAL_STREET-1.5),qf.y),vec3(f32((CANAL_ARM_TERRACE-11.0)*0.5),1.5,f32((f64(a.w)+CANAL_ARM_TERRACE)*PI/24.0+0.4)),atan2(f64(radial.y),f64(radial.x)),8,-1)
            h=atan2(f64(-radial.y),f64(radial.x))
            q=a.xy+radial*(a.w+5.5)
            canal_add(vec3(q.x,f32(f64(a.z)+CANAL_STREET*0.5-2.3),q.y),vec3(5.5,f32(CANAL_STREET*0.5+2.3),f32((f64(a.w)+5.5)*PI/24.0+0.4)),atan2(f64(radial.y),f64(radial.x)),0,-1)
            canal_add(vec3(q.x+radial.x*-5.25,f32(f64(a.z)+CANAL_STREET+CANAL_PARAPET*0.5),q.y+radial.y*-5.25),vec3(0.25,f32(CANAL_PARAPET*0.5),f32(f64(a.w)*PI/24.0+0.3)),atan2(f64(radial.y),f64(radial.x)),11,-1)
    # The bridges: deck and arch as slabs across, their abutments onto either bank, and the steps
    # from the deck's ends down to the street.
    loop bridge in CANAL_BRIDGES:
        index=CANAL_BEGIN+bridge.local
        a=RIVER_NODES[index];b=RIVER_NODES[index+1]
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        h=atan2(f64(dir.x),-f64(dir.y));width=f64(a.w);water=f64(a.z)
        half=canal_bridge_half(bridge);reach=canal_bridge_reach(bridge)
        kind=2+bridge.kind
        slabs=if bridge.kind==CANAL_STONE:20 else:16
        loop j in 0..slabs:
            x=-width+(width*2.0)*(f64(j)+0.5)/f64(slabs)
            under=canal_bridge_under(bridge,x,width)
            top=canal_bridge_top(bridge,x,width)
            # (a stone bridge is solid from its arch to its deck; the iron ones are a deck)
            low=if bridge.kind==CANAL_STONE:under else:if bridge.kind==CANAL_PIPES:top-1.4 else:top-max(0.5,top-under)
            q=a.xy+side*f32(x)
            canal_add(vec3(q.x,f32(water+(low+top)*0.5),q.y),vec3(f32(width/f64(slabs)+0.05),f32((top-low)*0.5),f32(half)),h,kind,-1)
        loop sign in [-1.0,1.0]:
            s=side*f32(sign)
            top=canal_bridge_top(bridge,width,width)
            street=water+CANAL_STREET
            canal_slab(a.xy,s,h,width,width+reach,street-3.0,water+top,half+0.5,0,-1)
            if bridge.kind!=CANAL_PIPES:
                # Parapets (rails on the iron ones) along the deck's edges: a hop over clears them too.
                loop edge in [-1.0,1.0]:
                    e=a.xy+dir*f32(edge*(half-0.25))
                    canal_slab(e,s,h,0.0,width+reach,water+top,water+top+(if bridge.kind==CANAL_TRUSS:3.2 else:1.1),0.25,kind,-1)
                # Walkable approach stair, each rise below the ordinary step limit.
                count=max(8,int(ceil((water+top-street)/0.32)))
                run=f64(count)*0.7
                canal_stair(a.xy+s*f32(width+reach+run),a.xy+s*f32(width+reach),street,water+top,half*1.6,count)
    a=(RIVER_NODES[CANAL_BEGIN+22]+RIVER_NODES[CANAL_BEGIN+23])*0.5;b=RIVER_NODES[CANAL_BEGIN+23]
    dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
    canal_heading=atan2(f64(dir.x),-f64(dir.y))
    canal_launch=vec3(a.x,a.z,a.y)
    q=a.xy+side*43.0;canal_workshop=vec3(q.x,a.z+2.0,q.y)
    canal_yard=canal_workshop+canal_world_dir(vec3(-12,0,-4),canal_heading+PI*0.5)
    # Hollow workshop: broad open water-facing door, walls and roof are real solids.
    h=canal_heading+PI*0.5
    loop x in [-16.0,16.0]:canal_add(canal_workshop+canal_world_dir(vec3(x,5,0),h),vec3(0.5,5,15),h,5)
    canal_add(canal_workshop+canal_world_dir(vec3(0,5,-15),h),vec3(16,5,0.5),h,5)
    canal_add(canal_workshop+vec3(0,10,0),vec3(16.5,0.5,15.5),h,6)
    # The floor is level from the back wall to the slipway's head, then leaves a slot for the
    # ways down the middle to the door.
    back=f32((-15.0+SLIP_TOP)*0.5);back_half=f32((SLIP_TOP+15.0)*0.5)
    canal_add(canal_workshop+canal_world_dir(vec3(0,-0.2,back),h),vec3(16,0.2,back_half),h,8)
    front=f32((SLIP_TOP+15.0)*0.5);front_half=f32((15.0-SLIP_TOP)*0.5)
    loop x in [-12.0,12.0]:canal_add(canal_workshop+canal_world_dir(vec3(f32(x),-0.2,front),h),vec3(4,0.2,front_half),h,8)
    # Masonry cheeks close the excavation beside the narrower launch ramp.
    gap=f64(length(RIVER_NODES[CANAL_BEGIN+23].xy-RIVER_NODES[CANAL_BEGIN+22].xy))*0.5+0.5
    cheek=max(0.5,(gap-8.0)*0.5)
    loop sign in [-1.0,1.0]:
        canal_add(canal_workshop+canal_world_dir(vec3(f32(sign*(8.0+cheek)),-2,12),h),vec3(f32(cheek),2.35,12),h,0,1)
    # Two timber boatsheds on the yard either side of the workshop.
    loop at in [-28.0,28.0]:
        shed=canal_workshop+canal_world_dir(vec3(f32(at),4,-2),h)
        canal_add(shed,vec3(7,4,10),h,13)
    # The slipway: one even slope from the shop's floor to the canal's water, in short level
    # pieces for walking and contact (drawn as the smooth ramp with its timber ways).
    z=SLIP_TOP
    loop z<SLIP_WATER:
        top=slip_point(z+0.25)
        ramp=canal_workshop+canal_world_dir(vec3(0,0,f32(z+0.25)),h)
        canal_add(vec3(ramp.x,top.y-0.5,ramp.z),vec3(8,0.5,0.26),h,7)
        z+=0.5

# Some of the city's blocks have a flat roof with a low parapet (canal_ground_fire.jo's riflemen
# stand on them; canal_city.jo draws them).
canal_flat_roof=(index:int)->bool:canal_solids[index].look>=4

canal_near=(p:vec3)->bool:length(p.xz-canal_origin.xz)<4100.0

# The slipway is kept clear: nobody stands on the ways. (In the shop's frame the slot runs
# x -8..8 from the ramp's head to the water; a little margin round it.)
canal_on_ways=(p:vec2)->bool:
    if canal_solids.len()==0:return false
    q=canal_local(vec3(p.x,0,p.y),CanalSolid(canal_workshop,vec3(0,0,0),slip_frame()))
    abs(q.x)<9.0 and q.z>SLIP_TOP-1.0 and q.z<SLIP_WATER+1.0
# Someone the world puts on the ways is shown on the shop floor beside them, on the nearer side.
canal_off_ways=(p:vec3)->vec3:
    if not canal_on_ways(p.xz):return p
    h=slip_frame()
    q=canal_local(p,CanalSolid(canal_workshop,vec3(0,0,0),h))
    x=if q.x<0:-13.5 else:13.5
    z=clamp(f64(q.z),SLIP_TOP+1.0,14.0)
    canal_workshop+canal_world_dir(vec3(f32(x),0,f32(z)),h)

# Swept point against oriented boxes. The nearest entered face supplies the normal.
canal_sweep=(from:vec3,to:vec3)->vec4:
    if not canal_near(to):return vec4(0,0,0,0)
    best=vec4(0,0,0,0)
    lo_point=min(from.xz,to.xz);hi_point=max(from.xz,to.xz)
    loop bx in int(floor(f64(lo_point.x)/64.0))..int(floor(f64(hi_point.x)/64.0))+1:
        loop bz in int(floor(f64(lo_point.y)/64.0))..int(floor(f64(hi_point.y)/64.0))+1:
            loop index in canal_bins.get(bx*16384+bz,[]):
                box=canal_solids[index]
                a=canal_local(from,box);b=canal_local(to,box);d=b-a
                lo=0.0;hi=1.0;n=vec3(0,0,0);valid=true
                loop axis in 0..3:
                    x=if axis==0:f64(a.x) else:if axis==1:f64(a.y) else:f64(a.z)
                    v=if axis==0:f64(d.x) else:if axis==1:f64(d.y) else:f64(d.z)
                    half=if axis==0:f64(box.half.x) else:if axis==1:f64(box.half.y) else:f64(box.half.z)
                    if abs(v)<0.000001:
                        if abs(x)>half:valid=false;break
                    else:
                        t0=(-half-x)/v;t1=(half-x)/v
                        near=min(t0,t1);far=max(t0,t1)
                        if near>lo:
                            lo=near
                            sign=if v>0.0:-1.0 else:1.0
                            n=if axis==0:vec3(sign,0,0) else:if axis==1:vec3(0,sign,0) else:vec3(0,0,sign)
                        hi=min(hi,far)
                        if lo>hi:valid=false;break
                if not valid:continue
                if length(n)<0.5:
                    gaps=box.half-abs(b)
                    if min(gaps.x,min(gaps.y,gaps.z))<0:continue
                    if gaps.x<=gaps.y and gaps.x<=gaps.z:n=vec3(if b.x>=0:1 else:-1,0,0)
                    else if gaps.y<=gaps.z:n=vec3(0,if b.y>=0:1 else:-1,0)
                    else:n=vec3(0,0,if b.z>=0:1 else:-1)
                    penetration=min(gaps.x,min(gaps.y,gaps.z))+0.02
                    if penetration>best.w:best=vec4(canal_world_dir(n,box.heading),penetration)
                else:
                    penetration=abs(dot(d,n))*f32(1.0-lo)+0.02
                    if penetration>best.w:best=vec4(canal_world_dir(n,box.heading),penetration)
    best

canal_floor=(x:f64,z:f64,ceiling:f64,ground_only:bool=false)->f64:
    p=vec3(f32(x),0,f32(z));best=-1e9
    if not canal_near(p):return best
    loop index in canal_bins.get(canal_bin(x,z),[]):
        box=canal_solids[index]
        if ground_only and box.kind!=0 and box.kind!=7 and box.kind!=8:continue
        q=canal_local(p,box)
        top=f64(box.center.y+box.half.y)
        if abs(q.x)<=box.half.x and abs(q.z)<=box.half.z and top<=ceiling:best=max(best,top)
    best

# How far ahead on the centre line a pilot at that speed (m/s) aims to hold the middle of the cut.
canal_lookahead=(speed:f64)->f64:30.0+speed*1.6
# The point `ahead` metres on along the through-channel's centre line from the one nearest p.
canal_ahead=(p:vec3,ahead:f64)->vec2:
    k=canal_station(p)
    a=RIVER_NODES[k].xy;d=RIVER_NODES[k+1].xy-a
    at=a+d*clamp(dot(p.xz-a,d)/max(dot(d,d),0.001),0.0,1.0)
    left=ahead
    loop k<CANAL_FINISH:
        next=RIVER_NODES[k+1].xy
        gap=f64(length(next-at))
        if left<=gap:return at+normalize(next-at)*f32(left)
        left-=gap;at=next;k+=1
    at

# Navigation keeps the through-channel separate from the water-union query at junctions.
canal_station=(p:vec3)->int:
    best=CANAL_BEGIN;distance=1e30
    loop i in CANAL_BEGIN..CANAL_FINISH:
        a=RIVER_NODES[i].xy;b=RIVER_NODES[i+1].xy;d=b-a
        u=clamp(dot(p.xz-a,d)/max(dot(d,d),0.001),0.0,1.0)
        gap=f64(length(p.xz-a-d*u))
        if gap<distance:distance=gap;best=i
    best
