# Neravessa: shared solid geometry for the canal city's draw and swept contact.
use 'river_data.jo'
const CANAL_CITY_ID=1900731
const CANAL_CITY_NAME="Neravessa"
struct CanalSolid:
    center:vec3
    half:vec3
    heading:f64
    kind:int=0
canal_solids:CanalSolid[]
canal_origin=vec3(RIVER_NODES[CANAL_BEGIN+30].x,0,RIVER_NODES[CANAL_BEGIN+30].y)
canal_workshop=vec3(0,0,0)
canal_launch=vec3(0,0,0)
canal_heading=0.0

canal_add=(at:vec3,half:vec3,h:f64,kind:int=0):
    global canal_solids
    canal_solids.push(CanalSolid(at,half,h,kind))
canal_local=(p:vec3,box:CanalSolid)->vec3:transform_point(rotation_y(box.heading),p-box.center)
canal_world_dir=(p:vec3,h:f64)->vec3:(rotation_y(-h)*vec4(p,0)).xyz

init_canal_geometry=():
    global canal_solids,canal_workshop,canal_launch,canal_heading
    if canal_solids.len()>0:return
    loop i in CANAL_BEGIN..CANAL_FINISH:
        a=RIVER_NODES[i];b=RIVER_NODES[i+1]
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        h=atan2(f64(dir.x),-f64(dir.y));mid=(a+b)*0.5
        length=f64(length(b.xy-a.xy));water=f64(mid.z)
        loop sign in [-1.0,1.0]:
            # Leave the water-facing workshop launch opening unblocked.
            if not (i>=CANAL_BEGIN+20 and i<=CANAL_BEGIN+24 and sign>0.0):
                q=mid.xy+side*f32(sign*(f64(mid.w)+3.0))
                canal_add(vec3(q.x,f32(water-1.0),q.y),vec3(3,3,f32(length*0.5+0.3)),h,0)
            q=mid.xy+side*f32(sign*(f64(mid.w)+27.0))
            if not (i>=CANAL_BEGIN+20 and i<=CANAL_BEGIN+24 and sign>0.0):
                canal_add(vec3(q.x,f32(water+1.7),q.y),vec3(27,0.3,f32(length*0.5+0.4)),h,8)
            if (i-CANAL_BEGIN)%3==0:
                loop row in 0..2:
                    q=mid.xy+side*f32(sign*(f64(mid.w)+16.0+f64(row)*20.0))
                    if i>=CANAL_BEGIN+18 and i<=CANAL_BEGIN+26 and sign>0.0:continue
                    height=6.0+f64((i+row)%3)*2.8
                    canal_add(vec3(q.x,f32(water+2.0+height*0.5),q.y),vec3(6,f32(height*0.5),7),h,1)
    # A stone arch, a high iron span and a low pedestrian bridge.
    loop bridge in 0..3:
        index=CANAL_BEGIN+[15,38,56][bridge]
        a=RIVER_NODES[index];b=RIVER_NODES[index+1]
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        h=atan2(f64(dir.x),-f64(dir.y));width=f64(a.w)
        clear=if bridge==0:9.0 else:if bridge==1:13.0 else:4.0
        loop j in 0..16:
            x=-width-5.0+(width*2.0+10.0)*(f64(j)+0.5)/16.0
            underside=clear+(if bridge==0:4.0*(1.0-pow(clamp(x/width,-1.0,1.0),2.0)) else:0.0)
            q=a.xy+side*f32(x)
            canal_add(vec3(q.x,a.z+f32(underside+0.65),q.y),vec3(f32((width*2.0+10.0)/32.0+0.05),0.65,if bridge==2:1.2 else:3.0),h,2+bridge)
        loop sign in [-1.0,1.0]:
            q=a.xy+side*f32(sign*(width+3.5))
            canal_add(vec3(q.x,a.z+f32(clear*0.5),q.y),vec3(2,f32(clear*0.5),4),h,0)
            # Walkable approach stair, each rise below the ordinary step limit.
            loop step in 0..24:
                rise=2.0+(clear-1.35)*(f64(step)+1.0)/24.0
                q=a.xy+side*f32(sign*(width+28.0-f64(step)))
                canal_add(vec3(q.x,a.z+f32(rise*0.5),q.y),vec3(0.55,f32(rise*0.5),2.5),h,0)
    a=RIVER_NODES[CANAL_BEGIN+22];b=RIVER_NODES[CANAL_BEGIN+23]
    dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
    canal_heading=atan2(f64(dir.x),-f64(dir.y))
    canal_launch=vec3(a.x,a.z,a.y)
    q=a.xy+side*43.0;canal_workshop=vec3(q.x,a.z+2.0,q.y)
    # Hollow workshop: broad open water-facing door, walls and roof are real solids.
    h=canal_heading+PI*0.5
    loop x in [-16.0,16.0]:canal_add(canal_workshop+canal_world_dir(vec3(x,5,0),h),vec3(0.5,5,15),h,5)
    canal_add(canal_workshop+canal_world_dir(vec3(0,5,-15),h),vec3(16,5,0.5),h,5)
    canal_add(canal_workshop+vec3(0,10,0),vec3(16.5,0.5,15.5),h,6)
    # Shallow stepped slipway drops from the shop floor into the canal basin.
    loop step in 0..24:
        y=2.0-f64(step)*0.15
        ramp=canal_workshop+canal_world_dir(vec3(0,f32(y-2.0-0.15),f32(step)),h)
        canal_add(ramp,vec3(8,0.15,0.55),h,7)

canal_near=(p:vec3)->bool:length(p.xz-canal_origin.xz)<2200.0

# Swept point against oriented boxes. The nearest entered face supplies the normal.
canal_sweep=(from:vec3,to:vec3)->vec4:
    if not canal_near(to):return vec4(0,0,0,0)
    best=vec4(0,0,0,0)
    loop box in canal_solids:
        a=canal_local(from,box);b=canal_local(to,box);d=b-a
        lo=0.0;hi=1.0;n=vec3(0,0,0);valid=true
        loop axis in 0..3:
            x=if axis==0:f64(a.x) else:if axis==1:f64(a.y) else:f64(a.z)
            v=if axis==0:f64(d.x) else:if axis==1:f64(d.y) else:f64(d.z)
            half=if axis==0:f64(box.half.x) else:if axis==1:f64(box.half.y) else:f64(box.half.z)
            if abs(v)<0.000001:
                if abs(x)>half:valid=false;break
            else:
                t0=(-half-x)/v;t1=(half-x)/v
                near=min(t0,t1);far=max(t0,t1)
                if near>lo:
                    lo=near
                    sign=if v>0.0:-1.0 else:1.0
                    n=if axis==0:vec3(sign,0,0) else:if axis==1:vec3(0,sign,0) else:vec3(0,0,sign)
                hi=min(hi,far)
                if lo>hi:valid=false;break
        if not valid:continue
        if length(n)<0.5:
            gaps=box.half-abs(b)
            if min(gaps.x,min(gaps.y,gaps.z))<0:continue
            if gaps.x<=gaps.y and gaps.x<=gaps.z:n=vec3(if b.x>=0:1 else:-1,0,0)
            else if gaps.y<=gaps.z:n=vec3(0,if b.y>=0:1 else:-1,0)
            else:n=vec3(0,0,if b.z>=0:1 else:-1)
            penetration=min(gaps.x,min(gaps.y,gaps.z))+0.02
            if penetration>best.w:best=vec4(canal_world_dir(n,box.heading),penetration)
        else:
            penetration=abs(dot(d,n))*f32(1.0-lo)+0.02
            if penetration>best.w:best=vec4(canal_world_dir(n,box.heading),penetration)
    best

canal_floor=(x:f64,z:f64,ceiling:f64)->f64:
    p=vec3(f32(x),0,f32(z));best=-1e9
    if not canal_near(p):return best
    loop box in canal_solids:
        q=canal_local(p,box)
        top=f64(box.center.y+box.half.y)
        if abs(q.x)<=box.half.x and abs(q.z)<=box.half.z and top<=ceiling:best=max(best,top)
    best
