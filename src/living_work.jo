use 'living_types.jo'
use 'living_far_types.jo'
use 'living_work_types.jo'
use 'living_place_context.jo'
use 'living_crop_calendar.jo'

work_date = (minute: int) -> str:
    clock=local_minute(minute)
    "day {day_index(minute)+1} at {clock/60:02}:{clock%60:02}"

work_supply = (w: World, roots: int[]) -> str:
    facts: str[]
    loop root in roots:
        if not (root in w.cargo_sources): continue
        s=w.cargo_sources[root]
        where=if s.producer_place>=0: life_place_name(w,s.producer_place) else: "the supplier's books"
        entry=if s.origin==.opening: "stock listed at {where} before these records begin" else: if s.origin==.production: "production recorded at {where}, {work_date(s.born_tick/120)}" else: "outside-trade stock received at {where}, {work_date(s.born_tick/120)}"
        if s.field_id>=0:
            entry="grain from registered field {s.field_id} at {where}, sown {crop_date(s.crop_sown_day)}, ripe from {crop_date(s.crop_ready_day)}; actual seed lots {s.field_seed_roots}, {f64(s.field_seed_milli)/1000.0:.2} packages. {s.field_seed_supply}"
        facts.push("Batch {root}: {entry}")
    facts.join("; ")

job_supply_roots = (w: World, job: int) -> int[]:
    if not (job in w.jobs): return []
    roots: int[]
    loop lot in w.jobs[job].cargo_ids:
        if lot in w.cargo and not (w.cargo[lot].source in roots): roots.push(w.cargo[lot].source)
    roots.sort(); roots

work_party = (w: World, account: int, person: int = -1) -> str:
    if person>=0 and person<w.people.len() and w.people[person].account==account: return w.people[person].name
    loop place in w.far.place_ids:
        if w.far.districts[place].market_account==account: return "the {life_place_name(w,place)} counter"
        if w.far.districts[place].household_account==account: return "the households of {life_place_name(w,place)}"
    loop place in 0..w.places.len():
        if w.places[place].market.account==account: return "the {life_place_name(w,place)} counter"
    loop c in w.countries:
        if c.treasury_account==account: return "the {c.name} government"
    loop v in w.far.vehicles:
        if v.account==account: return "carrier {v.id}'s owner"
    "the signing owner"

provenance_lines = (w: World, p: WorkProvenance) -> str[]:
    if p.cause=="": return ["No earlier request or agreement is recorded for this work."]
    result=[p.cause]
    if p.opening: result.push("This agreement was recorded before the opening day.")
    else if p.negotiated:
        result.push("Agreed {work_date(p.agreed_minute)}: {f64(p.goods_cents)/100.0:.2} lire for the goods; {f64(p.freight_cents)/100.0:.2} lire set aside for carriage, due {work_date(p.deadline)}.")
    else: result.push("A recipient/supplier purchase agreement has not been recorded.")
    if p.freight_payer>=0: result.push("{work_party(w,p.freight_payer,p.requester)} pays the carrier; the supplier is {work_party(w,p.supplier_account,p.supplier)}.")
    if p.supply!="": result.push(p.supply)
    result

job_provenance = (w: World, job: int) -> str[]:
    if not (job in w.jobs): return []
    provenance_lines(w,w.jobs[job].provenance)

commission_provenance = (w: World, id: int) -> str[]:
    if not (id in w.far.commissions): return []
    provenance_lines(w,w.far.commissions[id].provenance)

journey_provenance = (w: World, id: int) -> str[]:
    if not (id in w.far.journeys): return []
    provenance_lines(w,w.far.journeys[id].provenance)

# Historical roots may have been pruned after consumption; their saved description is kept.
# Identity/account references and dates still have to be valid before any UI can read them.
valid_need_places = (w: World, places: int[]) -> bool:
    if places.len()>12: return false
    loop i in 0..places.len():
        id=places[i]
        if id<0 or (id>=w.places.len() and not (id in w.place_contexts)): return false
        loop j in 0..i:
            if places[j]==id: return false
    true

work_provenance_error = (w: World, p: WorkProvenance) -> str:
    if not valid_need_places(w,p.need_places) or p.need_since< -1 or p.need_since>w.minute or (p.need_since>=0 and p.requested_minute>=0 and p.need_since>p.requested_minute): return "invalid underlying work need"
    if p.cause.len()>4096 or p.supply.len()>16384 or p.supply_roots.len()>64: return "unbounded work provenance"
    if p.requester< -1 or p.requester>=w.people.len() or p.supplier< -1 or p.supplier>=w.people.len() or p.requester_account< -1 or p.requester_account>=w.accounts.len() or p.supplier_account< -1 or p.supplier_account>=w.accounts.len() or p.freight_payer< -1 or p.freight_payer>=w.accounts.len(): return "invalid work provenance identity"
    if p.goods_cents<0 or p.freight_cents<0 or p.request_event< -1 or p.request_report< -1 or p.requested_minute< -1 or p.requested_minute>w.minute or p.heard_minute< -1 or p.heard_minute>w.minute or p.agreed_minute< -1 or p.agreed_minute>w.minute or (p.deadline< -1 and not p.opening): return "invalid work provenance terms"
    if p.request_place>=0 and not (p.request_place in w.place_contexts) and p.request_place>=w.places.len(): return "invalid work request place"
    if p.negotiated and (p.cause=="" or p.supplier_account<0 or p.requester_account<0 or p.freight_payer<0 or p.agreed_minute<0 or p.heard_minute<0 or p.requested_minute<0 or p.heard_minute<p.requested_minute or p.agreed_minute<p.heard_minute or p.deadline<p.agreed_minute): return "incomplete work agreement"
    loop i in 0..p.supply_roots.len():
        root=p.supply_roots[i]
        if root<0 or root>=w.next_cargo_source: return "invalid work supply roots"
        loop j in 0..i:
            if p.supply_roots[j]==root: return "invalid work supply roots"
    ""
