use 'living_types.jo'
use 'living_far_types.jo'
use 'living_work_types.jo'
use 'living_place_context.jo'

work_supply = (w: World, roots: int[]) -> str:
    facts: str[]
    loop root in roots:
        if not (root in w.cargo_sources): continue
        s=w.cargo_sources[root]
        where=if s.producer_place>=0: life_place_name(w,s.producer_place) else: "the recorded outside source"
        facts.push("root {root}: {s.origin} stock from {where}, recorded at minute {s.born_tick/120}")
    facts.join("; ")

job_supply_roots = (w: World, job: int) -> int[]:
    if not (job in w.jobs): return []
    roots: int[]
    loop lot in w.jobs[job].cargo_ids:
        if lot in w.cargo and not (w.cargo[lot].source in roots): roots.push(w.cargo[lot].source)
    roots.sort(); roots

provenance_lines = (w: World, p: WorkProvenance) -> str[]:
    if p.cause=="": return ["The earlier save has no recorded need or negotiation for this work."]
    result=[p.cause]
    if p.opening: result.push("This is an opening signed obligation; its earlier negotiation was not simulated.")
    else if p.negotiated:
        result.push("Agreed at minute {p.agreed_minute}: {f64(p.goods_cents)/100.0:.2} lire for the goods; {f64(p.freight_cents)/100.0:.2} lire reserved for carriage, due by minute {p.deadline}.")
    else: result.push("A recipient/supplier purchase agreement has not been recorded.")
    if p.supply!="": result.push(p.supply)
    result

job_provenance = (w: World, job: int) -> str[]:
    if not (job in w.jobs): return []
    provenance_lines(w,w.jobs[job].provenance)

commission_provenance = (w: World, id: int) -> str[]:
    if not (id in w.far.commissions): return []
    provenance_lines(w,w.far.commissions[id].provenance)
