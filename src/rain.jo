# A fixed mesh of short world-space streaks; no per-frame particle allocations.
use 'weather_scene.jo'
use 'look.jo'
use 'quality.jo'
use 'render_space.jo'
struct RainVertex:
    seed: vec3
    corner: vec2
struct RainParams:
    vp: mat4
    cam: vec3
    wind: vec3
    color: vec3
    time: f32
    strength: f32
    ceiling: f32
struct RainOut:
    pos: vec4
    world: vec3
    uv: vec2
rain_vs = (v: RainVertex,u: RainParams) -> RainOut:
    fall = vec3(u.wind.x*0.6,-18,u.wind.z*0.6)
    p = v.seed+fall*u.time
    p = (fract((p-u.cam)/vec3(64,48,64)+vec3(0.5,0.5,0.5))-vec3(0.5,0.5,0.5))*vec3(64,48,64)+u.cam
    side = cross(u.cam-p,fall)
    side *= 0.018/max(length(side),0.00001)
    world = p+side*v.corner.x+normalize(fall)*v.corner.y*0.9
    RainOut(u.vp*vec4(render_world(world,u.cam),1),world,v.corner)
rain_fs = (i: RainOut,u: RainParams) -> vec4:
    if i.world.y > u.ceiling or i.world.y < 0.0: discard()
    fade = (1.0-smoothstep(18.0,32.0,length(i.world-u.cam)))*(1.0-abs(i.uv.y))
    vec4(u.color,u.strength*fade*0.38)
rain_sh: Shader
rain_mesh: Mesh
init_rain = ():
    global rain_sh,rain_mesh
    r = rng(9013)
    vs: RainVertex[]
    loop k in 0..(if render_quality.tier == 0: 128 else: 320):
        p = vec3(f32(r.next_float()*64.0),f32(r.next_float()*48.0),f32(r.next_float()*64.0))
        loop q in [vec2(-1,-1),vec2(1,-1),vec2(1,1),vec2(-1,-1),vec2(1,1),vec2(-1,1)]: vs.push(RainVertex(p,q))
    rain_mesh = mesh(vs)
    rain_sh = make_shader(shader(rain_vs,rain_fs))
draw_rain = (L: Light):
    ceiling = weather_here.ceiling+weather_here.storm*5200.0
    if weather_here.rain < 0.01 or scene_camera().y > ceiling: return
    zone("rain")
    glDepthMask(0)
    glDisable(GL_CULL_FACE)
    draw(rain_sh,rain_mesh,RainParams(scene_view_proj(),scene_camera(),weather_here.wind,mix(L.haze,L.sun,0.2),f32(weather_seconds),weather_here.rain,ceiling))
    zone_end()
