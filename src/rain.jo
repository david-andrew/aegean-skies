use 'cloud_transparency.jo'
use 'depth_space.jo'
# A fixed mesh of short world-space streaks; no per-frame particle allocations.
use 'weather_scene.jo'
use 'look.jo'
use 'quality.jo'
use 'render_space.jo'
struct RainVertex:
    seed: vec3
    corner: vec2
struct RainParams:
    clouds:CloudVeil
    vp: mat4
    cam: vec3
    wind: vec3
    color: vec3
    time: f32
    strength: f32
    ceiling: f32
    phase: vec3
    velocity: vec3
    veil: f32 = 1.0                # 0: no cloud occlusion (the downpour, inside its own storm)
struct RainOut:
    pos: vec4
    world: vec3
    uv: vec2
rain_vs = (v: RainVertex,u: RainParams) -> RainOut:
    fall = vec3(u.wind.x*0.6,-18,u.wind.z*0.6)
    p = v.seed+u.phase
    p = (fract((p-u.cam)/vec3(64,48,64)+vec3(0.5,0.5,0.5))-vec3(0.5,0.5,0.5))*vec3(64,48,64)+u.cam
    # The drops keep their world-space fall; the short exposure shows their
    # velocity relative to the camera. Flying through rain streams out from
    # the vanishing point rather than drawing stationary vertical scratches.
    relative = fall-u.velocity
    if length(relative)<0.001:relative=fall
    side = cross(u.cam-p,relative)
    side *= 0.032/max(length(side),0.00001)
    # Bound angular length as well as exposure. A two-metre drop beside the
    # lens used to project into a ruler-straight line across half the sea.
    distance = length(p-u.cam)
    # (about three degrees at most: fast through a downpour, the streaks rush past)
    half_length = min(clamp(length(relative)*0.006,0.12,0.7),distance*0.05)
    streak = normalize(relative)*half_length
    world = p+side*v.corner.x+streak*v.corner.y
    RainOut(u.vp*vec4(render_world(world,u.cam),1),world,v.corner)
rain_fs = (i: RainOut,u: RainParams) -> vec4:
    if i.world.y > u.ceiling or i.world.y < 0.0: discard()
    distance = length(i.world-u.cam)
    fade = smoothstep(2.0,4.0,distance)*(1.0-smoothstep(18.0,32.0,distance))*(1.0-abs(i.uv.y))
    seen: f32 = if u.veil > 0.0: cloud_transmittance(i.world,u.clouds) else: 1.0
    vec4(u.color,sqrt(u.strength)*fade*0.48*seen)
rain_sh: Shader
rain_mesh: Mesh
# A thunderstorm's downpour: a second, denser set of streaks drawn only in it.
rain_heavy_mesh: Mesh
rain_streaks = (seed: int, count: int) -> Mesh:
    r = rng(seed)
    vs: RainVertex[]
    loop k in 0..count:
        p = vec3(f32(r.next_float()*64.0),f32(r.next_float()*48.0),f32(r.next_float()*64.0))
        loop q in [vec2(-1,-1),vec2(1,-1),vec2(1,1),vec2(-1,-1),vec2(1,1),vec2(-1,1)]: vs.push(RainVertex(p,q))
    mesh(vs)
init_rain = ():
    global rain_sh,rain_mesh,rain_heavy_mesh
    rain_mesh = rain_streaks(9013,if render_quality.tier == 0: 128 else: 320)
    rain_heavy_mesh = rain_streaks(9029,if render_quality.tier == 0: 640 else: 1600)
    rain_sh = make_world_shader(shader(rain_vs,rain_fs),false)  # (queued when rain comes near, weather_shaders_near)
draw_rain = (L: Light,velocity: vec3 = vec3(0,0,0)):
    ceiling = weather_here.ceiling+weather_here.storm*5200.0
    if weather_here.rain < 0.01 or scene_camera().y > ceiling: return
    zone("rain")
    glDepthMask(0)
    glDisable(GL_CULL_FACE)
    origin = render_origin(scene_camera())
    wind = weather_here.wind
    phase = vec3(render_phase(f64(wind.x)*0.6*weather_seconds-f64(origin.x),64.0),render_phase(-18.0*weather_seconds,48.0),render_phase(f64(wind.z)*0.6*weather_seconds-f64(origin.z),64.0))
    params = RainParams(cloud_veil,render_view_proj(origin),render_eye(origin),wind,mix(L.haze,vec3(0.70,0.74,0.78),0.45),0,weather_here.rain,ceiling,phase,velocity)
    draw(rain_sh,rain_mesh,params)
    if weather_here.storm > 0.1:
        # (the downpour: denser, and its own phase so the two sets never line up)
        params.strength = weather_here.rain*smoothstep(0.1,0.5,weather_here.storm)*2.2
        params.color = mix(params.color,vec3(0.86,0.89,0.92),0.4)
        # (its streaks are within 32 m, in the storm's own rain: the clouds'
        # occlusion per fragment would cost more than all the rest of the rain)
        params.veil = 0.0
        params.phase = vec3(render_phase(f64(wind.x)*0.6*weather_seconds-f64(origin.x)+23.0,64.0),render_phase(-21.0*weather_seconds+11.0,48.0),render_phase(f64(wind.z)*0.6*weather_seconds-f64(origin.z)+37.0,64.0))
        draw(rain_sh,rain_heavy_mesh,params)
    zone_end()
