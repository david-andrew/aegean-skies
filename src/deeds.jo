# Combat deeds (STUB, kept to the combat work's interface until its src/deeds.jo lands: when it
# does, take theirs and keep `deeds_take` (or rename the one call in src/reputation.jo)).
# The fight records what the pilot did; the living world's minute takes the records and the
# pilot's name carries them (src/reputation.jo). No World here: the fight runs in the scene.
#   kind          what was done
#   actor         the person who did it (the pilot is person 0)
#   subject_side  the country of the people it was done to or with (-1 none)
#   place         the settlement id it happened at or off (-1 open sea)
#   witnesses     people who saw it (person ids)

enum DeedKind: rescued_foe, rescued_friend, shot_down, flew_home_in_formation, left_the_fight

struct Deed:
    kind: DeedKind
    actor: int
    subject_side: int
    place: int
    witnesses: int[]

_deeds_pending: Deed[] = []

deed_record = (kind: DeedKind, actor: int, subject_side: int, place: int, witnesses: int[]):
    global _deeds_pending
    _deeds_pending.push(Deed(kind, actor, subject_side, place, witnesses))

# Everything recorded since the last call, oldest first.
deeds_take = () -> Deed[]:
    global _deeds_pending
    out = _deeds_pending
    _deeds_pending = []
    out
