# Deeds: what someone did that others will talk about, as it happened, for the reputation that
# reads them (built elsewhere). Append-only: a deed is never changed or removed once recorded,
# and the log is saved with the world (World.deeds). This file records; it judges nothing.

enum DeedKind: rescued_foe, rescued_friend, shot_down, flew_home_in_formation, left_the_fight, took_prisoner, released_prisoner

struct Deed:
    serial: int                     # 0, 1, 2 ... in the order recorded
    kind: DeedKind
    actor: int                      # the person who did it
    subject_side: int               # the country it was done to or for (-1: none)
    place: int                      # the place it was done at or delivered to (-1: at sea, in the air)
    witnesses: int[]                # the people who saw it (person IDs, sorted, no repeats)
    minute: int                     # the world's minute
    at: vec3                        # where

struct DeedLog:
    entries: Deed[]
    next = 0

const DEEDS_MOST = 4096             # a full log keeps recording: the oldest go first

# Records a deed; returns its serial.
deed_record = (log: mut DeedLog, kind: DeedKind, actor: int, subject_side: int, place: int, witnesses: int[], minute: int = 0, at: vec3 = vec3(0,0,0)) -> int:
    seen: int[]
    loop p in witnesses:
        if p >= 0 and p != actor and not (p in seen): seen.push(p)
    seen.sort()
    serial = log.next; log.next += 1
    if log.entries.len() >= DEEDS_MOST: log.entries.remove_at(0)
    log.entries.push(Deed(serial,kind,actor,subject_side,place,seen,minute,at))
    serial

# The deeds recorded from serial `from` on, oldest first (a reader keeps the next serial it wants).
deeds_since = (log: DeedLog, from: int) -> Deed[]: [loop d in log.entries: if d.serial >= from: d]

# One person's deeds, oldest first.
deeds_by = (log: DeedLog, actor: int) -> Deed[]: [loop d in log.entries: if d.actor == actor: d]

deed_count = (log: DeedLog, actor: int, kind: DeedKind) -> int:
    n = 0
    loop d in log.entries:
        if d.actor == actor and d.kind == kind: n += 1
    n
