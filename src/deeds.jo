# Deeds: what someone did that others will talk about, as it happened. The fight (in the scene,
# with no World to hand) records each one; the living world's minute takes them (deeds_take, in
# src/reputation.jo's _rep_combat_deeds), keeps them in the world's saved, append-only log
# (deeds_keep, World.deeds) and lets the pilot's name carry them. This file records; it judges
# nothing.
#   kind          what was done
#   actor         the person who did it (the pilot is person 0)
#   subject_side  the country of the people it was done to or with (-1 none)
#   place         the settlement id it happened at or off (-1 open sea)
#   witnesses     people who saw it (person ids, sorted, no repeats, not the actor)

enum DeedKind: rescued_foe, rescued_friend, shot_down, flew_home_in_formation, left_the_fight, took_prisoner, released_prisoner

struct Deed:
    kind: DeedKind
    actor: int
    subject_side: int
    place: int
    witnesses: int[]
    minute = -1                     # the world's minute (-1: as yet unknown; set when it is kept)
    at: vec3 = vec3(0,0,0)          # where
    serial = -1                     # its place in the saved log, 0, 1, 2 ... (-1 until it is kept)

struct DeedLog:
    entries: Deed[]
    next = 0

const DEEDS_MOST = 4096             # a full log keeps recording: the oldest go first

_deeds_pending: Deed[] = []

# Records a deed, to be taken by the world's next minute.
deed_record = (kind: DeedKind, actor: int, subject_side: int, place: int, witnesses: int[], minute: int = -1, at: vec3 = vec3(0,0,0)):
    global _deeds_pending
    seen: int[]
    loop p in witnesses:
        if p >= 0 and p != actor and not (p in seen): seen.push(p)
    seen.sort()
    _deeds_pending.push(Deed(kind,actor,subject_side,place,seen,minute,at))

# Everything recorded since the last call, oldest first.
deeds_take = () -> Deed[]:
    global _deeds_pending
    out = _deeds_pending
    _deeds_pending = []
    out

# Keeps deeds in the saved log (in order; never changed or removed after, but the oldest when it
# is full), each given its serial and, if it had none, the minute. Returns them as kept.
deeds_keep = (log: mut DeedLog, deeds: Deed[], minute: int) -> Deed[]:
    kept: Deed[]
    loop d0 in deeds:
        d = d0
        d.serial = log.next; log.next += 1
        if d.minute < 0: d.minute = minute
        if log.entries.len() >= DEEDS_MOST: log.entries.remove_at(0)
        log.entries.push(d); kept.push(d)
    kept

# The kept deeds from serial `from` on, oldest first (a reader keeps the next serial it wants).
deeds_since = (log: DeedLog, from: int) -> Deed[]: [loop d in log.entries: if d.serial >= from: d]

# One person's kept deeds, oldest first.
deeds_by = (log: DeedLog, actor: int) -> Deed[]: [loop d in log.entries: if d.actor == actor: d]

deed_count = (log: DeedLog, actor: int, kind: DeedKind) -> int:
    n = 0
    loop d in log.entries:
        if d.actor == actor and d.kind == kind: n += 1
    n
