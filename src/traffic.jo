struct Traffic:
    craft: int                     # persistent aircraft ID; never an array/Pool index
    person: int
    name: str
    why: str
    reason: living.Reason
    kind: Craft
    model: int
    spec: CraftSpec
    state: CraftState
    plan: FlightPlan
    town: int
    dock: int
    trip = -1
    flying = false
    materialized = false
    visible = true
    prop_angle = 0.0
    waypoint = 1
    route_key: u64 = u64(0)
    why_minute = -1
    combat_damage = false
    air: AirMind = AirMind()

# Original model indices 0..7 stay stable; the four extra seed liveries are appended in aegean.
traffic_model = (craft: int) -> int: [0, 5, 8, 9, 2, 10, 11, 9][craft]

harbors_from_towns = (towns: Town[]) -> living.HarborGeometry[]:
    result: living.HarborGeometry[]
    loop p in 0..towns.len():
        tw = towns[p]
        center = vec3(tw.center.x, 0, tw.center.z)
        out = vec3(tw.out.x, 0, tw.out.y)
        safe = center + out * 300.0
        result.push(data.HarborGeometry(p, center, out, tw.docks, center + out * 200.0, safe, safe))
    result

# The flight model's part health is authoritative while present. Seed coarse world wear into
# attached parts only when constructing a body; snapshots retain actual individual damage.
# The records are per-mille physical health, including real combat loss. Applying a nonlinear
# wear curve every frame heals damaged parts and makes scene/save projections disagree.
_seed_condition = (state: mut CraftState, spec: CraftSpec, hull0: int, engine0: int):
    hull = clamp(hull0,0,1000)
    engine = clamp(engine0,0,1000)
    engine_id = int(PartId.engine)
    engine_share = spec.parts[engine_id].mass_share
    structural = clamp((f64(hull) / 1000.0 - engine_share * f64(engine) / 1000.0) / max(0.01, 1.0 - engine_share), 0.0, 1.0)
    loop i in 0..spec.parts.len():
        state.damage.parts[i].health = if i == engine_id: f64(engine) / 1000.0 else: structural
    state.hull_damage = 1.0 - f64(hull) / 1000.0; state.engine_damage = 1.0 - f64(engine) / 1000.0

_impose_condition = (state: mut CraftState, spec: CraftSpec, hull0: int, engine0: int):
    hull = clamp(hull0,0,1000)
    engine = clamp(engine0,0,1000)
    engine_id = int(PartId.engine)
    engine_share = spec.parts[engine_id].mass_share
    old_engine = state.damage.parts[engine_id].health
    current = (1.0 - state.hull_damage - engine_share * old_engine) / max(0.01, 1.0 - engine_share)
    target = clamp((f64(hull) / 1000.0 - engine_share * f64(engine) / 1000.0) / max(0.01, 1.0 - engine_share), 0.0, 1.0)
    # Coarse structural loss must not manufacture a second engine hit. Conversely an explicit
    # world repair may improve condition; ordinary motion commits cannot grant that increase.
    if abs(f64(engine) / 1000.0 - old_engine) > 0.001: state.damage.parts[engine_id].health = f64(engine) / 1000.0
    if target + 0.001 < current:
        ratio = target / max(0.001, current)
        loop i in 0..spec.parts.len():
            if i != engine_id: state.damage.parts[i].health *= ratio
    else if target > current + 0.001:
        loop i in 0..spec.parts.len():
            if i != engine_id: state.damage.parts[i].health = max(state.damage.parts[i].health, target)

_restore_common = (tr: mut Traffic, w: living.World):
    c = w.aircraft[tr.craft]
    wet = c.state == .moored or c.state == .workshop or (c.pose.pos.y < 5 and (c.state == .taxi or c.state == .approach))
    # The abstract water anchor is at sea level; the physical model's origin is its CG.
    pos = c.pose.pos
    if wet and pos.y == 0: pos.y = f32(tr.spec.float_height)
    tr.state = CraftState(position = pos, velocity = c.pose.vel, orientation = c.pose.rot,
        throttle = f64(c.pose.throttle) / 1000.0, fuel = f64(c.fuel_ml) / 1000.0,
        hull_damage = 1.0 - f64(c.hull) / 1000.0, engine_damage = 1.0 - f64(c.engine) / 1000.0,
        on_water = wet, water_age = if wet: 0.0 else: 1.0)
    tr.state.precise=data.pose_point(c.pose);tr.state.precise.y=f64(pos.y)
    tr.state.published=pos;tr.state.precise_ready=true
    _seed_condition(tr.state, tr.spec, c.hull, c.engine)
    if c.state == .moored or c.state == .workshop: moor(tr.state, pos, heading(tr.state))

traffic_projection = (tr: mut Traffic, w: living.World):
    c = w.aircraft[tr.craft]
    person = if c.operator >= 0: c.operator else: c.owner
    if tr.why_minute != w.minute or tr.trip != c.trip or tr.person != person:
        tr.person = person; tr.name = w.people[person].name
        tr.reason = if c.trip >= 0: w.trips[c.trip].reason else: w.people[person].action.reason
        if tr.reason.actor < 0: tr.reason = data.Reason(purpose = .visit, actor = person, origin = c.place, destination = c.place)
        tr.why = living.say_reason(w, tr.reason)
        tr.why_minute = w.minute
    tr.trip = c.trip; tr.flying = c.trip >= 0
    tr.town = if c.trip >= 0: w.trips[c.trip].destination else: max(0, c.place)
    tr.dock = if c.trip >= 0: w.trips[c.trip].claimed_dock else: c.dock
    tr.visible = c.state != .ditched and c.state != .wrecked
    tr.materialized = c.move_owner == .scene
    if not tr.materialized: _restore_common(tr, w)

make_living_traffic = (w: mut living.World, models: mut CraftModel[]) -> Traffic[]:
    extend_craft_models(models)
    result: Traffic[]
    loop c in w.aircraft:
        if c.owner == w.player or w.people[c.owner].far_home>=0: continue
        kind = Craft(int(c.kind))
        model = if int(kind) >= 4: default_craft_model(kind) else: traffic_model(c.id)
        spec = craft_spec(kind, models[model].contacts)
        # One fuel unit is a litre in the adapter; use the shared economy burn/tank constants.
        spec.fuel_capacity = f64(data.AIRFRAMES[int(c.kind)].tank_ml) / 1000.0
        spec.fuel_burn = f64(data.AIRFRAMES[int(c.kind)].burn_ml_sec) / 1000.0
        tr = Traffic(craft = c.id, person = c.owner, name = w.people[c.owner].name, kind = kind, model = model, spec = spec)
        traffic_projection(tr, w)
        result.push(tr)
    loop tr in result: w.aircraft[tr.craft].model_index = tr.model
    result

# The existing Flyer is the player's one body. Bind it to the same registry and units; it
# stays under human controls, including when it becomes a pirate encounter's victim.
bind_living_player = (player: mut Flyer, w: mut living.World, adapter: mut scene.SceneAdapter):
    c = w.people[w.player].craft
    record = w.aircraft[c]
    player.state.position = record.pose.pos
    if record.pose.pos.y == 0 and record.state == .moored: player.state.position.y = f32(player.spec.float_height)
    player.state.precise=data.pose_point(record.pose);player.state.precise.y=f64(player.state.position.y)
    player.state.published=player.state.position;player.state.precise_ready=true
    player.state.velocity = record.pose.vel; player.state.orientation = record.pose.rot
    restored=false
    if record.scene_extension_tick == w.tick and record.scene_extension != "":
        snapshot = from_text[CraftState](record.scene_extension)
        if snapshot is CraftState: player.state = snapshot; restored=true
    player.spec.fuel_capacity = f64(data.AIRFRAMES[int(w.aircraft[c].kind)].tank_ml) / 1000.0
    player.spec.fuel_burn = f64(data.AIRFRAMES[int(w.aircraft[c].kind)].burn_ml_sec) / 1000.0
    if not restored:
        player.state.fuel=f64(record.fuel_ml)/1000.0
        _seed_condition(player.state,player.spec,record.hull,record.engine)
    else:
        # Keep the exact saved integrator, part damage and fractional ml. Coarse projections
        # may differ by their documented integer rounding, never a new healing pass.
        _restore_snapshot_health(player.state,player.spec,w,c)
        if abs(player.state.fuel*1000.0-f64(record.fuel_ml))>1: player.state.fuel=f64(record.fuel_ml)/1000.0
    w.aircraft[c].pose = data.Pose(pos = player.state.position, vel = player.state.velocity, rot = player.state.orientation)
    data.place_pose(w.aircraft[c].pose,craft_point(player.state))
    if w.aircraft[c].move_owner != .scene: w.aircraft[c].revision += 1
    w.aircraft[c].move_owner = .scene
    if not scene.scene_bound(adapter, c): adapter.handles[c] = adapter.bodies.add(scene.SceneLease(c))

# A valid same-tick full snapshot owns part health. Older saves can contain a coarse wear
# projection alongside different physical health; restoring must not heal or re-damage parts.
_restore_snapshot_health = (state: mut CraftState, spec: CraftSpec, w: mut living.World, craft: int):
    summary=state; refresh_damage(spec,summary)
    if abs(summary.hull_damage-state.hull_damage)>0.001 or abs(summary.engine_damage-state.engine_damage)>0.001: state=summary
    w.aircraft[craft].hull=clamp(int(round((1.0-state.hull_damage)*1000.0)),0,1000)
    w.aircraft[craft].engine=clamp(int(round((1.0-state.engine_damage)*1000.0)),0,1000)

sync_living_player = (player: mut Flyer, w: living.World):
    c = w.aircraft[w.people[w.player].craft]
    if abs(player.state.fuel * 1000.0 - f64(c.fuel_ml)) > 1: player.state.fuel = f64(c.fuel_ml) / 1000.0
    hull=int(round((1.0-player.state.hull_damage)*1000.0))
    engine=int(round((1.0-player.state.engine_damage)*1000.0))
    if abs(hull-c.hull)>1 or abs(engine-c.engine)>1:
        _impose_condition(player.state,player.spec,c.hull,c.engine)
        refresh_damage(player.spec,player.state)

commit_player_motion = (w: mut living.World, state: CraftState, before: data.Pose, before_fuel: int, alpha: f64, progress: bool = true, recover: bool = true):
    c = w.people[w.player].craft
    if w.aircraft[c].move_owner != .scene: return
    rotation = if dot(before.rot, state.orientation) < 0: -state.orientation else: state.orientation
    # (the world's record takes a throttle of 0..1 (the air brake below idle is just idle to it) and
    # a sane speed: with the drag off, a dive can run past what it accepts)
    v = lerp(before.vel, state.velocity, f32(alpha))
    if length(v) > 900.0: v = normalize(v) * 900.0
    pose = data.Pose(pos = lerp(before.pos, state.position, f32(alpha)), vel = v,
        rot = normalize(lerp(before.rot, rotation, f32(alpha))), throttle = clamp(int(round(state.throttle * 1000.0)), 0, 1000))
    data.place_pose(pose,world_lerp(data.pose_point(before),craft_point(state),alpha))
    fuel = min(w.aircraft[c].fuel_ml, max(0, int(round(lerp(f64(before_fuel), state.fuel * 1000.0, alpha)))))
    phase: data.CraftState = if state.moored: data.CraftState.moored else: if state.on_water: data.CraftState.taxi else: data.CraftState.airborne
    hull = min(w.aircraft[c].hull, max(0, int(round((1.0 - state.hull_damage) * 1000.0))))
    engine = min(w.aircraft[c].engine, max(0, int(round((1.0 - state.engine_damage) * 1000.0))))
    # (a motion the world turns down is left out, not a crash: the next frame's will do)
    if scene.scene_motion(w,c,w.aircraft[c].revision,pose,fuel,hull,engine,phase,progress,recover)<0:
        living_fault("traffic.player_motion.refused",guard_context(w)+" craft={c} revision={w.aircraft[c].revision} last_tick={w.aircraft[c].last_scene_tick} pose={pose} fuel={fuel} hull={hull} engine={engine}")
        return
    if state.moored and alpha >= 1.0 and arrive_registry_port(w,pose.pos): return
    if not state.moored: leave_registry_port(w)
    if state.moored and alpha >= 1.0 and w.aircraft[c].trip >= 0:
        loop p in 0..w.harbors.len():
            loop d in 0..w.harbors[p].docks.len():
                if length(pose.pos - w.harbors[p].docks[d]) < 20:
                    if scene.scene_player_arrival(w, p, d):
                        w.aircraft[c].port_place=-1; w.people[w.player].far_place=-1
                    return

# Saved only at an explicit save boundary. The world remains graphics-independent.
struct SceneFlightSnapshot:
    state: CraftState
    plan: FlightPlan
    waypoint: int
    route_key: u64
    trip: int
    combat_damage = false
    air: AirMind = AirMind()

traffic_profile = (w:living.World,person:int) -> AirProfile:
    p=w.people[person]
    if p.occupation==.courier:return AirProfile(.careful,340,0.94,p.traits.sociability>450,false)
    if p.occupation==.racer:return AirProfile(.racer,230,1.08,true,true)
    if p.occupation==.pirate:return AirProfile(.low_patrol,120,0.95,false,true)
    if p.occupation==.patrol:return AirProfile(.careful,280,0.98,true,true)
    AirProfile(altitude=280+f64(1000-p.traits.boldness)*0.1,friendly=p.traits.sociability>450)

start_traffic_plan = (tr: mut Traffic, w: living.World):
    t = w.trips[tr.trip]; h = w.harbors[t.destination]
    out_heading = atan2(f64(w.harbors[t.origin].out.x), -f64(w.harbors[t.origin].out.z))
    target = if t.claimed_dock >= 0: h.docks[t.claimed_dock] else: h.buoy
    tr.plan = FlightPlan(target = h.center + h.out * 420.0, taxi_target = target,
        altitude = 240.0, speed = f64(data.AIRFRAMES[int(w.aircraft[tr.craft].kind)].cruise_mps),
        takeoff_heading = out_heading, landing_heading = atan2(-f64(h.out.x), f64(h.out.z)))
    landing=air_runway(h.center,h.out,conditions.wind_at(w,h.center),surface_height,tr.plan.altitude)
    if landing.valid:tr.plan.target=landing.touchdown;tr.plan.landing_heading=landing.heading
    tr.air=AirMind()
    departure=air_runway(w.harbors[t.origin].center,w.harbors[t.origin].out,conditions.wind_at(w,tr.state.position),surface_height,tr.plan.altitude)
    if departure.valid and tr.state.on_water and not t.harbor_move:
        tr.air.departing=true;tr.air.departure=departure.start;tr.plan.takeoff_heading=departure.heading
    tr.waypoint = max(t.segment + 1, if tr.state.on_water: 2 else: 1)
    # A folded final taxi resumes taxiing, rather than taking off again.
    if tr.state.on_water and length(tr.state.position - h.center) < 1000 and (t.origin != t.destination or t.segment >= t.route.len() - 2):
        tr.waypoint = t.route.len() - 2; tr.plan.phase = .taxi; tr.air.departing=false
    else if not tr.state.on_water:
        tr.plan.phase = .cruise
        # Preserve an already aligned descent across an abstract/scene handoff.
        inward = heading_vector(tr.plan.landing_heading ?? tr.plan.takeoff_heading)
        delta = tr.plan.target - tr.state.position; delta.y = 0
        along = f64(dot(delta, inward))
        cross_track = length(delta - inward * f32(along))
        v = tr.state.velocity; v.y = 0
        approach_distance = max(1800.0, tr.plan.altitude / 0.065 + 500.0)
        if along > 0 and along < approach_distance and cross_track < 200 and tr.state.position.y < 280 and length(v) > 1 and dot(normalize(v), inward) > 0.85:
            tr.waypoint = t.route.len() - 2; tr.plan.phase = .descend
    if t.harbor_move:
        tr.plan.phase=.taxi; tr.waypoint=t.route.len()-2
    tr.route_key = hash(t.route)

_acquire_traffic = (tr: mut Traffic, w: mut living.World, adapter: mut scene.SceneAdapter):
    if not scene.acquire_scene(w, adapter, tr.craft): return
    _restore_common(tr, w)
    tr.materialized = true; tr.trip = w.aircraft[tr.craft].trip
    tr.why_minute = -1
    tr.town = w.trips[tr.trip].destination; tr.dock = w.trips[tr.trip].claimed_dock
    start_traffic_plan(tr, w)
    c = w.aircraft[tr.craft]
    if c.scene_extension_tick == w.tick and c.scene_extension != "":
        snapshot = from_text[SceneFlightSnapshot](c.scene_extension)
        if snapshot is SceneFlightSnapshot and snapshot.trip == tr.trip:
            tr.state = snapshot.state; tr.plan = snapshot.plan
            tr.waypoint = snapshot.waypoint; tr.route_key = snapshot.route_key
            tr.combat_damage = snapshot.combat_damage;tr.air=snapshot.air
            _restore_snapshot_health(tr.state,tr.spec,w,tr.craft)
    w.aircraft[tr.craft].scene_extension = ""; w.aircraft[tr.craft].scene_extension_tick = -1

# Include the controller's real outer approach fix when folding. Otherwise an abstract craft
# flies straight back toward the dock, re-enters the scene, and repeats the approach forever.
_physical_remainder = (tr: Traffic, w: living.World) -> vec3[]:
    t = w.trips[tr.trip]
    points = [tr.state.position]
    last = t.route.len() - 2
    if tr.waypoint < last:
        loop k in tr.waypoint..last: points.push(t.route[k])
    if tr.plan.phase == .takeoff or tr.plan.phase == .climb or tr.plan.phase == .cruise:
        hdir = heading_vector(tr.plan.landing_heading ?? tr.plan.takeoff_heading)
        distance = max(1800.0, tr.plan.altitude / 0.065 + 500.0)
        fix = tr.plan.target - hdir * f32(distance); fix.y = f32(tr.plan.altitude)
        points.push(fix)
    if tr.plan.phase != .taxi and tr.plan.phase != .done: points.push(tr.plan.target)
    points.push(tr.plan.taxi_target)
    points

# Feed semantic cruise waypoints through the existing autopilot. Its virtual landing fix is
# the next waypoint; only the final harbor approach is allowed to descend, land and taxi.
traffic_controls = (tr: mut Traffic, w: living.World, e: FlightEnv, contacts:AirContact[] = [], ships:AirShip[] = [], player:int = -1) -> Controls:
    t = w.trips[tr.trip]
    if tr.route_key != hash(t.route): start_traffic_plan(tr, w)
    last = t.route.len() - 2
    profile=traffic_profile(w,tr.person)
    # Sail away from the berth at taxi speed before aligning for the water run.
    if tr.air.departing:
        taxi=FlightPlan(phase=.taxi,initialized=true,taxi_target=tr.air.departure)
        c=air_autopilot(tr.spec,tr.state,taxi,e);c.anchor=false
        air_think(tr.air,profile,tr.craft,t.destination,tr.state,tr.spec,tr.air.departure,contacts,[],player,w.tick,e)
        tr.air.manner=.departure_taxi
        if tr.air.avoiding and not tr.air.yield_water:
            taxi.taxi_target=tr.air.aim;c=air_autopilot(tr.spec,tr.state,taxi,e);c.anchor=false
        if tr.air.yield_water:c.throttle=0;c.water_brake=1
        if length((tr.state.position-tr.air.departure).xz)<12 and length(tr.state.velocity)<2:
            tr.air.departing=false;tr.plan.phase=.takeoff;unmoor(tr.state)
        return c
    if tr.plan.phase==.takeoff and tr.state.on_water and length(tr.state.velocity)<5:
        error=angle_delta(tr.plan.takeoff_heading,heading(tr.state))
        if abs(error)>0.2:return Controls(throttle=0.16,yaw=clamp(error*2.0,-1.0,1.0),water_brake=if length(tr.state.velocity)>2:1.0 else:0.0,assist=0)
    if tr.waypoint < last and tr.plan.phase != .taxi:
        p = t.route[tr.waypoint]
        if length(tr.state.position - p) < 260:
            tr.waypoint += 1
            if tr.waypoint >= last:
                # Rebuild the real harbor approach after the last cruise waypoint.
                saved = tr.waypoint; start_traffic_plan(tr, w); tr.waypoint = saved
                tr.plan.phase = .cruise
                return air_autopilot(tr.spec, tr.state, tr.plan, e)
            p = t.route[tr.waypoint]
        if tr.plan.phase==.takeoff or tr.plan.phase==.climb:
            controls=air_autopilot(tr.spec,tr.state,tr.plan,e)
            return controls
        air_think(tr.air,profile,tr.craft,t.destination,tr.state,tr.spec,p,contacts,ships,player,w.tick,e)
        return air_social_controls(tr.air,profile,tr.craft,tr.state,tr.spec,e,w.tick)
    # Approach/taxi never perform social manoeuvres. Emergency separation can still wave off
    # a landing or stop a taxi, and retries remain the existing FlightPlan's responsibility.
    air_think(tr.air,profile,tr.craft,t.destination,tr.state,tr.spec,tr.plan.target,contacts,[],player,w.tick,e)
    if tr.air.avoiding and not tr.state.on_water:
        if tr.plan.phase==.land or tr.plan.phase==.descend:tr.plan.phase=.climb
        return air_social_controls(tr.air,profile,tr.craft,tr.state,tr.spec,e,w.tick)
    if tr.state.on_water and tr.air.yield_water:return Controls(throttle=0,water_brake=1)
    if tr.state.on_water and tr.air.avoiding:
        taxi=FlightPlan(phase=.taxi,initialized=true,taxi_target=tr.air.aim)
        c=air_autopilot(tr.spec,tr.state,taxi,e);c.anchor=false;return c
    air_autopilot(tr.spec, tr.state, tr.plan, e)

# Berths can change while the plane is approaching (notably when the player docks).
# Wait physically at the safe buoy, then taxi to a newly reserved berth; never snap or share.
_traffic_berth = (tr: mut Traffic, w: mut living.World):
    id = tr.trip; place = w.trips[id].destination
    dock = w.trips[id].claimed_dock
    available = dock >= 0
    if available:
        loop c in w.aircraft:
            if c.id != tr.craft and c.place == place and c.dock == dock: available = false
    if not available and not w.trips[id].harbor_move: dock = travel.free_dock(w, place, tr.craft)
    if w.places[place].harbor_closed: dock = -1
    if dock < 0 and not w.trips[id].harbor_move:
        w.trips[id].state = .holding
        if w.trips[id].hold_until_minute == 0: w.trips[id].hold_until_minute = w.minute + 30
    else if w.trips[id].state == .holding: w.trips[id].state = .active
    target = if dock >= 0: w.harbors[place].docks[dock] else: w.harbors[place].buoy
    if length(target - tr.plan.taxi_target) > 0.1:
        tr.plan.taxi_target = target
        if tr.plan.phase == .done:
            unmoor(tr.state); tr.plan.phase = .taxi
    tr.town = place; tr.dock = dock
    w.trips[id].claimed_dock = dock

_step_traffic = (tr: mut Traffic, w: mut living.World, e: FlightEnv, commit: bool = true,contacts:AirContact[] = [],ships:AirShip[] = [],player:int = -1):
    c = w.aircraft[tr.craft]
    if c.trip < 0: return
    # Mixed abstract encounters can damage/resolve this body at a minute boundary.
    if c.fuel_ml + 1 < int(round(tr.state.fuel * 1000.0)): tr.state.fuel = f64(c.fuel_ml) / 1000.0
    # Keep actual bullet/part damage while this body retains its scene lease. Reapplying the
    # a nonlinear wear map here would heal bullet damage on the first return-to-route tick.
    if not tr.combat_damage or tr.state.moored:
        _impose_condition(tr.state, tr.spec, c.hull, c.engine)
        tr.state.hull_damage = max(tr.state.hull_damage, 1.0 - f64(c.hull) / 1000.0)
        tr.state.engine_damage = max(tr.state.engine_damage, 1.0 - f64(c.engine) / 1000.0)
    _traffic_berth(tr, w)
    controls = traffic_controls(tr, w, e,contacts,ships,player)
    step(tr.spec, tr.state, air_stabilize(tr.spec,tr.state,e,controls), e, 1.0 / 60.0)
    tr.prop_angle += (8.0 + 70.0 * tr.state.throttle) / 60.0
    if commit:commit_traffic_motion(tr,w)

commit_traffic_motion = (tr: mut Traffic,w: mut living.World,arrival: bool = true):
    c=w.aircraft[tr.craft]
    phase: data.CraftState = if tr.state.on_water: (if tr.plan.phase == .takeoff: data.CraftState.taxi else: data.CraftState.approach) else: data.CraftState.airborne
    fuel = min(c.fuel_ml, max(0, int(round(tr.state.fuel * 1000.0))))
    hull = min(c.hull, max(0, int(round((1.0 - tr.state.hull_damage) * 1000.0))))
    engine = min(c.engine, max(0, int(round((1.0 - tr.state.engine_damage) * 1000.0))))
    velocity = tr.state.velocity
    if length(velocity)>900.0: velocity = normalize(velocity)*900.0
    revision = scene.scene_motion(w, tr.craft, c.revision, data.Pose(pos = tr.state.position,precise=craft_point(tr.state),published=tr.state.position,precise_ready=true, vel = velocity, rot = tr.state.orientation, throttle = clamp(int(round(tr.state.throttle * 1000.0)), 0, 1000)), fuel, hull, engine, phase,arrival)
    if revision < 0:
        living_fault("traffic.npc_motion.refused",guard_context(w)+" craft={tr.craft} revision={c.revision} last_tick={c.last_scene_tick} pos={tr.state.position} velocity={tr.state.velocity} fuel={fuel} hull={hull} engine={engine}")
        return
    if w.aircraft[tr.craft].trip < 0 or not arrival: return
    if tr.state.crashed or tr.state.beached or tr.plan.phase == .failed:
        # Explicit recovery/aftermath, never the old traffic's free tow-and-repair teleport.
        weather.ditch(w, tr.craft, w.trips[tr.trip].reason)
    else if tr.plan.phase == .done:
        if not scene.encounter_active(w, tr.craft) and (tr.dock >= 0 or w.minute >= w.trips[tr.trip].hold_until_minute):
            living.commit_arrival(w, tr.trip, tr.town, tr.dock, revision)

update_traffic = (traffic: mut Traffic[], w: mut living.World, adapter: mut scene.SceneAdapter, observer: vec3, t: f64, dt: f64, player: CraftState? = none, towns: Town[] = [], battle: mut Battle = Battle(), effects: (CombatEvent[]) -> void = (events: CombatEvent[]): pass, contact: (int,CraftSpec,CraftState,vec3) -> CraftState = (id: int,spec: CraftSpec,state: CraftState,previous: vec3) -> CraftState: state,ships:AirShip[] = [],other_air:AirContact[] = []):
    accepted = frame_dt(dt)
    velocity = (observer - adapter.observer) / f32(max(accepted, 1.0 / 60.0))
    if length(velocity) > 200: velocity = normalize(velocity) * 200.0
    adapter.observer = observer; adapter.observer_velocity = velocity
    adapter.accumulator = frame_spare(adapter.accumulator,accepted)
    adapter.frame_ticks = 0
    player_craft = w.people[w.player].craft
    # Saving folds all owners. The same human body claims its lease before the next step.
    if player != none and not scene.scene_bound(adapter, player_craft):
        w.aircraft[player_craft].move_owner = .scene; w.aircraft[player_craft].revision += 1
        adapter.handles[player_craft] = adapter.bodies.add(scene.SceneLease(player_craft))
    player_before = w.aircraft[player_craft].pose
    player_fuel = w.aircraft[player_craft].fuel_ml
    steps = max(1, int(floor((adapter.accumulator + 1e-9) * 60.0)))
    stepped = 0
    life_nav_budget = 1
    loop adapter.accumulator + 1e-9 >= 1.0 / 60.0:
        adapter.accumulator = max(0.0, adapter.accumulator - 1.0 / 60.0)
        # Ownership is fixed before this whole step. New trips become eligible next step.
        loop i in 0..traffic.len():
            tr = traffic[i]
            if not scene.scene_bound(adapter, tr.craft) and scene.scene_candidate(w, tr.craft, observer, velocity): _acquire_traffic(tr, w, adapter)
            traffic[i] = tr
        if let body = player:
            if not body.moored and w.aircraft[player_craft].trip < 0: scene.scene_player_departure(w)
        scene.scene_clock_begin(w)
        cargo_scene.step_cargo_scene(w,towns,observer,1.0/60.0)
        life_nav_budget -= daily_scene.step_life_scene(w,towns,observer,1.0/60.0,life_nav_budget)
        stepped += 1
        adapter.frame_ticks += 1
        alpha=f64(stepped)/f64(steps)
        if not battle.enabled:
            if let body=player:commit_player_motion(w,body,player_before,player_fuel,alpha)
        e = flight_env(f64(w.tick) / 60.0)
        physical:int[]
        if battle.enabled:
            # Registration does not create a second person, lease or body. Passive traffic
            # retains its route controller until a world engagement (or a real hit) takes it.
            loop tr in traffic:
                if scene.scene_bound(adapter,tr.craft):register_combat_body(battle,w,tr.craft,tr.spec,tr.state)
            if let body=player:
                pi=combat_index(battle,player_craft)
                if pi>=0 and not battle.actors[pi].bailed:
                    old=battle.actors[pi].state
                    battle.actors[pi].previous=old.position
                    battle.actors[pi].previous_point=craft_point(old)
                    battle.actors[pi].state=body
                    battle.actors[pi].state.precise=world_lerp(data.pose_point(player_before),craft_point(body),alpha)
                    battle.actors[pi].state.position=world_vec(battle.actors[pi].state.precise)
                    battle.actors[pi].state.published=battle.actors[pi].state.position; battle.actors[pi].state.precise_ready=true
                    loop part in 0..7:
                        if old.damage.parts[part].health<body.damage.parts[part].health:
                            battle.actors[pi].state.damage.parts[part]=old.damage.parts[part]
                            # Retain only pieces detached since this frame's input state.
                            # Copying every old piece would resurrect debris retired by flight.
                            if body.damage.parts[part].attached and not old.damage.parts[part].attached:
                                loop piece in old.damage.debris:
                                    if int(piece.part)==part:battle.actors[pi].state.damage.debris.push(piece)
                    refresh_damage(battle.actors[pi].spec,battle.actors[pi].state)
            physical=bind_scene_engagements(battle,w)
        contacts:AirContact[]=other_air
        loop tr in traffic:
            if not tr.visible or length(tr.state.position-observer)>8000:continue
            contacts.push(AirContact(tr.craft,tr.state.position,tr.state.velocity,tr.town,tr.state.on_water,tr.state.moored))
        if let body=player:contacts.push(AirContact(player_craft,body.position,body.velocity,-1,body.on_water,body.moored))
        loop i in 0..traffic.len():
            tr = traffic[i]
            if scene.scene_bound(adapter, tr.craft) and not combat_owns(battle,tr.craft):
                if weather_active: e.wind = conditions.wind_at(w,tr.state.position)
                previous = tr.state.position
                active = w.aircraft[tr.craft].trip >= 0
                _step_traffic(tr, w, e,false,contacts,ships,player_craft)
                if not battle.enabled and active:
                    before = tr.state.hull_damage
                    tr.state = contact(tr.craft,tr.spec,tr.state,previous)
                    if tr.state.hull_damage > before: tr.combat_damage = true
                    commit_traffic_motion(tr,w)
                ci=combat_index(battle,tr.craft)
                if battle.enabled and ci>=0 and battle.actors[ci].external:
                    battle.actors[ci].previous=battle.actors[ci].state.position
                    battle.actors[ci].previous_point=craft_point(battle.actors[ci].state)
                    battle.actors[ci].state=tr.state
            traffic[i] = tr
        if battle.enabled:
            step_battle(battle,e,observer)
            # Physical contacts resolve before the same revisioned world commit.
            loop i in 0..battle.actors.len():
                a = battle.actors[i]
                if not a.human and a.present:
                    a.state = contact(a.craft,a.spec,a.state,a.previous)
                    battle.actors[i] = a
            effects(battle.events)
            loop i in 0..traffic.len():
                tr=traffic[i];ci=combat_index(battle,tr.craft)
                if scene.scene_bound(adapter,tr.craft):
                    if ci>=0:
                        actor=battle.actors[ci]
                        if actor.state.hull_damage > tr.state.hull_damage: tr.combat_damage=true
                        tr.state=actor.state;tr.prop_angle=actor.prop
                        if actor.last_attacker>=0:tr.combat_damage=true
                    # One revisioned motion commit, after this tick's rounds and fire. A
                    # passive pilot hit in this tick must not also take the route's ditch path.
                    commit_traffic_motion(tr,w,not combat_owns(battle,tr.craft))
                traffic[i]=tr
        if battle.enabled:
            if let body=player:
                pi=combat_index(battle,player_craft)
                if pi>=0:commit_player_motion(w,battle.actors[pi].state,w.aircraft[player_craft].pose,w.aircraft[player_craft].fuel_ml,1.0,battle.actors[pi].status==.flying,false)
                else:commit_player_motion(w,body,player_before,player_fuel,alpha)
        if battle.enabled:resolve_scene_engagements(battle,w,physical)
        scene.scene_encounters(w,physical)
        scene.scene_clock_end(w)
        loop mut tr in traffic:
            if scene.scene_bound(adapter, tr.craft):
                c = w.aircraft[tr.craft]
                safe = not combat_owns(battle,tr.craft) and not tr.state.stalled and not tr.state.beached and not tr.state.crashed and not tr.state.on_water
                terminal = c.trip < 0
                if terminal or scene.scene_should_fold(w, adapter, tr.craft, safe):
                    scene.release_scene(w, adapter, tr.craft, if terminal: [] else: _physical_remainder(tr, w))
                    tr.materialized = false
        # Abstract poses already interpolate at fixed ticks, rather than jumping by minutes.
    loop mut tr in traffic:
        traffic_projection(tr,w)
        ci=combat_index(battle,tr.craft)
        if battle.enabled and ci>=0 and battle.actors[ci].external:
            battle.actors[ci].present=tr.materialized and tr.visible
    battle.render_alpha=clamp(adapter.accumulator/FIXED_DT,0.0,1.0)

# Synchronize NPCs at a completed fixed tick. Use fold_living_scene_for_save for a bound player.
# On reload only an exact matching tick restores hidden state; abstract motion invalidates it.
fold_traffic_for_save = (traffic: mut Traffic[], w: mut living.World, adapter: mut scene.SceneAdapter):
    loop mut tr in traffic:
        if not scene.scene_bound(adapter, tr.craft): continue
        state = SceneFlightSnapshot(tr.state, tr.plan, tr.waypoint, tr.route_key, tr.trip,tr.combat_damage,tr.air)
        guiding = tr.waypoint < w.trips[tr.trip].route.len() - 2
        scene.release_scene(w, adapter, tr.craft, _physical_remainder(tr, w))
        state.waypoint = if guiding: 1 else: w.trips[tr.trip].route.len() - 2
        state.route_key = hash(w.trips[tr.trip].route)
        w.aircraft[tr.craft].scene_extension = to_text(state)
        w.aircraft[tr.craft].scene_extension_tick = w.tick
        tr.materialized = false

fold_living_scene_for_save = (traffic: mut Traffic[], player: Flyer, w: mut living.World, adapter: mut scene.SceneAdapter):
    daily_scene.fold_life_for_save(w)
    portage.fold_carriage_for_save(w)
    fold_traffic_for_save(traffic, w, adapter)
    c = w.people[w.player].craft
    if not scene.scene_bound(adapter, c): return
    scene.release_scene(w, adapter, c)
    w.aircraft[c].scene_extension = to_text(player.state)
    w.aircraft[c].scene_extension_tick = w.tick

# Stable UI lookup; callers may read .person/.name/.why/.reason/.state.position directly.
traffic_for_craft = (traffic: Traffic[], craft: int) -> Traffic?:
    loop tr in traffic:
        if tr.craft == craft: return tr
    none

draw_traffic = (traffic: Traffic[], models: CraftModel[], L: Light, t: f64, battle: Battle = Battle(),detail_distance:f64 = 9000.0):
    cam = scene_camera()
    loop tr in traffic:
        ci=combat_index(battle,tr.craft)
        if battle.enabled and ci>=0 and battle.actors[ci].present and battle.actors[ci].status!=.escaped:
            if not battle.actors[ci].external or battle.actors[ci].last_attacker>=0:continue
        if not tr.visible or length(tr.state.position - cam) > detail_distance: continue
        m = models[tr.model]
        at = translation(tr.state.position) * quat_to_mat4(tr.state.orientation)
        if tr.state.moored: at = afloat_transform(at,t)
        anchor=world_offset(craft_point(tr.state),at[3].xyz-tr.state.position)
        at[3]=vec4(0,0,0,1)
        draw(obj_sh,m.body,obj_params(L,t,at,anchor=anchor))
        if not queue_prop_discs(m,at,anchor,tr.prop_angle,prop_rotation_speed(tr.state,true_speed(tr.spec,f64(length(tr.state.velocity)))),L,t,tr.craft): draw_craft_props(m,L,t,at,tr.prop_angle,anchor)
        draw_craft_gear(m,L,t,at,tr.state.gear,anchor)
