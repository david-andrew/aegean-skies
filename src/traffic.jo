# Other pilots in the air: each with an aircraft, flying the autopilot from one harbor to another,
# landing out in front of it into the wind, taxiing in and mooring at a free dock, waiting a while,
# then off again. (Where they go and why will be the world's people's own business; for now, a
# harbor at random.)

use 'world.jo'
use 'look.jo'
use 'planes.jo'
use 'flight.jo'
use 'objects.jo'
use 'pilot.jo'
use 'sea.jo'

struct Traffic:
    name: str
    kind: Craft
    model: int
    spec: CraftSpec
    state: CraftState
    plan: FlightPlan
    town: int                       # where it is, or is going
    dock: int
    waiting = 0.0                   # seconds left at the dock
    flying = false
    prop_angle = 0.0
    seed: int

# which docks are taken (town, dock), by the player's craft and the others
_dock_taken = (traffic: Traffic[], player: vec3, towns: Town[], ti: int, k: int) -> bool:
    d = towns[ti].docks[k]
    if length(vec2(player.x - d.x, player.z - d.z)) < 14.0: return true
    loop tr in traffic:
        if tr.town == ti and tr.dock == k: return true
    false

_out_heading = (tw: Town) -> f64: atan2(f64(tw.out.x), -f64(tw.out.y))

# a pilot moored at a town's dock, about to wait there a while
make_traffic = (name: str, kind: Craft, model: int, contacts: vec3[], towns: Town[], town: int, dock: int, seed: int) -> Traffic:
    spec = craft_spec(kind, contacts)
    tw = towns[town]
    st = water_start(spec, tw.docks[dock], _out_heading(tw))
    moor(st, st.position, _out_heading(tw))
    Traffic(name, kind, model, spec, st, FlightPlan(), town, dock, waiting = 20.0 + f64(seed % 7) * 15.0, seed = seed)

# off to another harbor: the plan, the dock it will moor at
_depart = (tr: mut Traffic, towns: Town[], others: Traffic[], player: vec3):
    seed_random(tr.seed * 7919 + int(tr.state.time))
    loop tries in 0..12:
        to = random_int(0, towns.len() - 1)
        if to == tr.town or towns[to].docks.len() == 0: continue
        tw = towns[to]
        free = -1
        loop k in 0..tw.docks.len():
            if free < 0 and not _dock_taken(others, player, towns, to, k): free = k
        if free < 0: continue
        from = towns[tr.town]
        # touch down out in front of the harbor, taxi in to the dock
        land = tw.docks[free] + vec3(tw.out.x, 0, tw.out.y) * 420.0
        dist = f64(length(land - tr.state.position))
        tr.plan = FlightPlan(target = land, taxi_target = tw.docks[free] + vec3(tw.out.x, 0, tw.out.y) * 6.0,
            altitude = clamp(dist * 0.03, 110.0, 240.0) + random(0.0, 40.0), takeoff_heading = _out_heading(from),
            landing_heading = _out_heading(tw) + PI)
        tr.town = to
        tr.dock = free
        unmoor(tr.state)
        tr.flying = true
        return
    tr.waiting = 30.0

update_traffic = (traffic: mut Traffic[], towns: Town[], player: vec3, t: f64, dt: f64):
    env = flight_env(t)
    loop i in 0..traffic.len():
        if traffic[i].flying:
            c = autopilot(traffic[i].spec, traffic[i].state, traffic[i].plan, env)
            step(traffic[i].spec, traffic[i].state, c, env, dt)
            traffic[i].prop_angle += dt * (8.0 + 70.0 * traffic[i].state.throttle)
            ph = traffic[i].plan.phase
            if ph == .done or ph == .failed or traffic[i].state.crashed or traffic[i].state.beached:
                # moored (or, having failed, towed in: the world will say so one day)
                tw = towns[traffic[i].town]
                d = tw.docks[traffic[i].dock]
                h = _out_heading(tw)
                traffic[i].state = water_start(traffic[i].spec, d, h)
                moor(traffic[i].state, traffic[i].state.position, h)
                traffic[i].flying = false
                traffic[i].waiting = 40.0 + f64((traffic[i].seed * 31 + int(t)) % 9) * 15.0
        else:
            traffic[i].waiting -= dt
            if traffic[i].waiting <= 0.0:
                let others = traffic
                one = traffic[i]
                _depart(one, towns, others, player)
                traffic[i] = one

draw_traffic = (traffic: Traffic[], models: CraftModel[], L: Light, t: f64):
    cam = scene_camera()
    loop tr in traffic:
        if length(tr.state.position - cam) > 9000.0: continue
        m = models[tr.model]
        at = translation(tr.state.position) * quat_to_mat4(tr.state.orientation)
        if tr.state.moored: at = afloat(tr.state.position, t) * at
        draw(obj_sh, m.body, obj_params(L, t, at))
        draw(obj_sh, m.prop, obj_params(L, t, at * translation(m.prop_at) * rotation_z(tr.prop_angle)))
