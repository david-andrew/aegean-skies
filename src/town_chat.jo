# Incidental exchanges on foot and at a table. Each opening owns its possible answers.
use 'living_types.jo'
use 'pilot_day_types.jo'
use 'pilot_talk.jo'
use 'reputation.jo'
use 'reputation_types.jo'
use 'reputation_talk.jo'
use 'living_calendar.jo'
use 'leads.jo'

const CHAT_PLACE_MINUTES = 36
const CHAT_PERSON_MINUTES = 100
const CHAT_HISTORY = 12

chat_chance = (history: ChatVisit[], minute: int, speaker: int, place: int, seated: bool) -> f64:
    if speaker < 0 or place < 0: return 0.0
    gap = 90
    loop v in history:
        age = minute-v.minute
        if (speaker == v.speaker and age < CHAT_PERSON_MINUTES) or (place == v.place and age < CHAT_PLACE_MINUTES): return 0.0
        gap = min(gap,age)
    (if seated: 0.65 else: 0.44) * clamp(f64(gap-12)/78.0,0.0,1.0)

chat_remember = (history: mut ChatVisit[], minute: int, speaker: int, place: int, opening: str):
    if opening == "conversation":
        loop i in 0..history.len():
            if history[i].speaker == speaker and history[i].place == place and history[i].opening == opening:
                history.remove_at(i)
                break
    history.push(ChatVisit(minute,speaker,place,opening))
    loop history.len() > CHAT_HISTORY and minute-history[0].minute >= CHAT_PERSON_MINUTES: history.remove_at(0)

struct ChatOpening:
    tag: str
    line: str
    replies: str[]
    deed = -1

# Ask about a delivery without assuming a stranger knows who carried it. The pilot knows the
# outcome. A named deed, in contrast, is offered only to a speaker who actually heard of it.
chat_openings = (w: World, speaker: int, place: int, rain: bool, wind: f64) -> ChatOpening[]:
    out = [
        ChatOpening("coffee","Coffee goes cold quickly out here.",["Mine never gets the chance.","That's why I take a small cup."]),
        ChatOpening("cobbles","These shoes know every cobble in town.",["Mine know the loose ones.","You feel them through the soles."]),
        ChatOpening("fish_cook","How do you like your sardines?",["Grilled, with a little lemon.","Just salt, straight off the grill."]),
        ChatOpening("day","What sort of day have you had?",[loop n in 0..2: pilot_on_day(w,w.pilot_day,n)]),
        ChatOpening("spray","Does the salt get into everything?",["Even the buckles.","You ought to see my goggles."])]
    trade = w.people[speaker].occupation
    match trade:
        .fisher, .sailor, .pirate:
            out.push(ChatOpening("rope","There's a knot I'll never get undone.",["Slack it off first.","Try working the turn loose."]))
            out.push(ChatOpening("wake","Can you see a boat's wake from far off?",["Often before I see the boat.","A white one shows for miles."]))
            out.push(ChatOpening("nets","Takes longer to mend a net than to tear it.",["Same with a wing.","One snag and there's your evening gone."]))
        .courier, .racer, .patrol, .mechanic:
            out.push(ChatOpening("engine","Can you hear yourself think in that thing?",["Only on the glide.","It's quieter with the throttle back."]))
            out.push(ChatOpening("seat","Any room to stretch your legs aboard?",["Just enough for the pedals.","My knees know every rivet."]))
            out.push(ChatOpening("charts","Do you fold your charts up there?",["Before I get in.","One fold, with the coast showing."]))
        .merchant, .quartermaster, .clerk, .telegraphist:
            out.push(ChatOpening("weights","Ever weighed your luggage?",["Every bag. It all adds up.","Even the tool roll."]))
            out.push(ChatOpening("papers","How do you keep your charts from blowing away?",["A clip on my knee.","Folded under my knee strap."]))
            out.push(ChatOpening("ink","Salt water makes a mess of ink.",["Pencil holds up better.","I've a chart full of blue smudges."]))
        else:
            out.push(ChatOpening("landmarks","Do the islands look alike from up there?",["The headlands give them away.","Only till you know their shapes."]))
            out.push(ChatOpening("water","How do you tell the depth from up there?",["I look for the pale patches.","Hard to tell with the sun in your eyes."]))
            out.push(ChatOpening("sound","What do the gulls make of your engine?",["They give me room.","Less fuss than you'd think."]))
    if rain:
        out.push(ChatOpening("rain_collar","Rain getting down your collar too?",["Down the back of my neck.","Only on the side my scarf missed."]))
        out.push(ChatOpening("rain_glass","Do your goggles keep the rain out?",["Out, yes. Seeing through them's the trick.","Mostly. It gets in at the edges."]))
    else if wind >= 9.0:
        out.push(ChatOpening("wind_rope","Would you trust one rope in this wind?",["I'd use two.","Only with someone holding the other end."]))
        out.push(ChatOpening("wind_landing","Which way do you land in a blow like this?",["Nose to wind, if there's room.","Into it. Less water to run across."]))
    else if wind < 4.0:
        out.push(ChatOpening("light_air","Much wind down here?",["Hardly enough to lift my scarf.","Little enough at the water."]))
        out.push(ChatOpening("wind_sign","How do you read a light wind on the water?",["The dark streaks show it.","I watch the ripples round the boats."]))
    else:
        out.push(ChatOpening("breeze","A bit of a breeze, isn't there?",["Enough to fill a sail.","Feels fresher out of the lee."]))
    flown = false; caught = false; battle = false
    loop i in 0..w.pilot_day.len():
        d = w.pilot_day[w.pilot_day.len()-1-i]
        if d.minute > w.minute or w.minute-d.minute >= 720: continue
        if d.kind == .flew and not flown:
            flown = true
            out.push(ChatOpening("flight_air","How was the air on your last run?",[loop n in 0..3: pilot_on_weather(w,[d],rain,wind,n)]))
            if d.where != "":
                out.push(ChatOpening("flight_from","Where did you set out from last time?",["{d.where}.","Over from {d.where}."]))
        if d.kind == .fished and not caught:
            caught = true
            out.push(ChatOpening("catch","Anything biting off the dock?",["I had a bite there earlier.","They were biting when I tried."]))
        if d.kind == .battle and not battle:
            battle = true
            out.push(ChatOpening("fight","See any fighting on your travels?",["I saw enough.","Yes. I'd sooner talk about something else."]))
    loop i in 0..w.rep.deeds.len():
        d = w.rep.deeds[w.rep.deeds.len()-1-i]
        if w.minute < d.minute or w.minute-d.minute >= 720: continue
        if d.kind == .job_done or d.kind == .job_late or d.kind == .job_failed:
            replies = match d.kind:
                .job_done: ["Yes, I got the delivery there.","A delivery, all handed over."]
                .job_late: ["A delivery. I was late with it.","Yes. Kept someone waiting."]
                else: ["A delivery that went wrong.","I had a job. It fell through."]
            out.push(ChatOpening("delivery","Had any delivery work lately?",replies))
            break
    if place >= 0 and place < w.places.len() and w.places[place].id == place and w.places[place].has_market:
        fish = int(GoodKind.fish)
        price = w.places[place].market.price_cents[fish]
        if price > 0:
            base = w.goods[fish].base_cents
            replies = if price > base: ["Dearer than usual.","Dear. I'd buy a small one."] else: if price < base: ["Cheap just now.","Less than usual, for once."] else: ["About the usual.","Much the same as ever."]
            out.push(ChatOpening("fish_price","What's fish fetching at the market?",replies))
    if capital_feast_active(w,place,w.minute):
        out.push(ChatOpening("feast","Where are they keeping the feast?",["In the square.","The square, here in town."]))
        out.push(ChatOpening("feast_day","What's the occasion in the square?",["The patronal feast.","It's the town's feast day."]))
    loop report in w.people[speaker].far_reports:
        if report.kind == "war_declared" and report.learned_minute <= w.minute and w.minute-report.occurred_minute >= 0 and w.minute-report.occurred_minute < 1440:
            out.push(ChatOpening("war_news","There's word of a declaration of war.",["Who's the word from?","A bad piece of news."]))
            break
    v = rep_view(w,speaker)
    if v.known:
        if v.regard <= REP_COLD: return []
        if let d = rep_deed(w,v.deed):
            match d.kind:
                .rescued_foe, .rescued_friend, .rescued_survivors, .found_boat:
                    line = if d.storm >= 600: "They say you put down in that storm for them." else: "I heard you brought them home."
                    out.push(ChatOpening("heard_rescue",line,["Couldn't leave them out there.","Glad they're home."],d.id))
                .shot_down, .flew_home_in_formation, .left_the_fight:
                    out.push(ChatOpening("heard_fight","You were in that fight, weren't you?",["Yes. I'd sooner leave it there.","I was there."],d.id))
                .job_done, .job_late, .job_failed:
                    words = if d.kind == .job_failed: ["No. That one went wrong.","I couldn't finish that one."] else: if d.kind == .job_late: ["Yes, in the end.","It did. Later than promised."] else: ["Yes, all handed over.","It did, safe and sound."]
                    out.push(ChatOpening("heard_load","That delivery I heard about. Did it get there?",words,d.id))
                .raced:
                    out.push(ChatOpening("heard_race","Someone said you'd been racing?",["They heard right.","Yes, I flew in it."],d.id))
                .debt_paid, .debt_defaulted:
                    words = if d.kind == .debt_paid: ["Every penny.","Yes, we're square."] else: ["No. I still owe it.","There's still money owing."]
                    out.push(ChatOpening("heard_debt","Are you square with your creditor now?",words,d.id))
                else: pass
    out

# Draw from the least recently heard openings. Even a sparse setting exhausts its eligible
# pool before recycling it. The second draw is within the chosen opening alone.
chat_choose = (bank: ChatOpening[], history: ChatVisit[], pick: int, prefer_deed: bool = false) -> ChatOpening?:
    candidates: ChatOpening[]
    oldest = if history.len() > 0: history[history.len()-1].minute+1 else: 0
    loop o in bank:
        if prefer_deed and o.deed >= 0: return o
        last = -1
        loop v in history:
            if v.opening == o.tag: last = max(last,v.minute)
        if last < oldest: candidates = []; oldest = last
        if last == oldest: candidates.push(o)
    if candidates.len() == 0: return none
    candidates[pick%candidates.len()]

struct ChatTurn:
    tag = ""
    opening = ""
    reply = ""

chat_lead = (w: mut World, speaker: int, meets: MeetNote[]) -> str:
    if let l = lead_to_tell(w,speaker,meets,w.rep.told_leads):
        lead_told_now(w,speaker,l)
        line = lead_line(w,l,speaker,speaker+day_index(w.minute))
        if env("AEGEAN_LEADS") != none: print("LEAD {w.people[speaker].name}: {line} ({l.key})")
        return line
    ""

# The contact roll is keyed to a world minute. Rendering or repeatedly walking in and out of
# reach during that minute cannot reroll it. Service messages are handled by the scene first.
struct ChatContact:
    speaker: int
    place: int
    seated = false
    busy = false
    rain = false
    wind = 0.0
    answers = true
    first_at_table = false
    forced = false                # capture only; cooldowns and activity still apply

town_chat = (w: mut World, history: mut ChatVisit[], c: ChatContact, lead_meets: () -> MeetNote[]?) -> ChatTurn:
    if c.busy or not people_can_talk(w,c.speaker,w.player): return ChatTurn()
    chance = chat_chance(history,w.minute,c.speaker,c.place,c.seated)
    minute = w.minute; seed = w.seed
    draw = (channel: int) -> int: draw1000000(seed,48082,c.speaker,minute,channel)
    if chance <= 0.0 or (not c.forced and f64(draw(0))/1000000.0 >= chance): return ChatTurn()
    bank = chat_openings(w,c.speaker,c.place,c.rain,c.wind)
    if let o = chat_choose(bank,history,draw(1),c.first_at_table):
        if not (c.first_at_table and o.deed >= 0):
            if let meets = lead_meets():
                tip = chat_lead(w,c.speaker,meets)
                if tip != "":
                    chat_remember(history,minute,c.speaker,c.place,"lead")
                    return ChatTurn("lead",tip,"")
        if o.deed >= 0: rep_said(w,c.speaker,w.player,.home,"rep-deed:{o.deed}")
        chat_remember(history,minute,c.speaker,c.place,o.tag)
        return ChatTurn(o.tag,o.line,if c.answers: o.replies[draw(2)%o.replies.len()] else: "")
    ChatTurn()

# Both bubbles belong to the same contact. Losing that person or opening a panel ends it.
struct TownSpeech:
    speaker = -1
    seated = false
    turn: ChatTurn
    since = 0.0
    answered = false

chat_step = (speech: mut TownSpeech, now: f64, listener: int, seated: bool, busy: bool, answers_on: bool):
    age = now-speech.since
    if busy or listener != speech.speaker or seated != speech.seated or age < 0.0 or age >= 7.0:
        speech = TownSpeech()
        return
    if not answers_on: speech.turn.reply = ""
    speech.answered = speech.turn.reply != "" and age >= 2.2 and age < 6.7
