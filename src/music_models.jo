# Scalar acoustic models: harmonic magnitudes, decay rates and envelope parameters.
# The bank contains no PCM, waveform phases, impulse responses or sample loops.
const MUSIC_PARTIALS = 32
const MUSIC_MODEL_WIDTH = 170
const MUSIC_MODEL_PITCHES = 7
const MUSIC_MODEL_VELOCITIES = 3

struct MusicModels:
    pitches: int[]
    values: f64[]

make_music_models = () -> MusicModels:
    b = inflate(embed('../data/music/instruments.z'))!
    assert(b.len() == 116+315*MUSIC_MODEL_WIDTH*4)
    assert(b[8] == 45 and b[9] == 80 and b[10] == 115)
    assert(b[0] == 84 and b[1] == 73 and b[2] == 77 and b[3] == 49)
    assert(b[4] == 15 and b[5] == 7 and b[6] == 3 and b[7] == 32)
    m = MusicModels()
    loop i in 0..105: m.pitches.push(int(b[11+i]))
    at = 116
    loop at+4 <= b.len():
        bits = u32(b[at]) | (u32(b[at+1]) << 8) | (u32(b[at+2]) << 16) | (u32(b[at+3]) << 24)
        m.values.push(f64(f32_from_bits(bits)))
        at += 4
    assert(m.values.len() == 315*MUSIC_MODEL_WIDTH)
    m

struct MusicBlend:
    a: int
    b: int
    c: int
    d: int
    pitch: f64
    effort: f64

music_blend = (m: MusicModels, kind: int, pitch: int, velocity: f64) -> MusicBlend:
    pi = 0
    loop pi < 5 and pitch > m.pitches[kind*7+pi+1]: pi += 1
    lo = m.pitches[kind*7+pi]; hi = m.pitches[kind*7+pi+1]
    p = clamp(f64(pitch-lo)/f64(max(1,hi-lo)),0.0,1.0)
    if kind == 12: p = if p < 0.5: 0.0 else: 1.0
    vi = if velocity <= 80: 0 else: 1
    v = clamp((velocity-(if vi == 0: 45.0 else: 80.0))/35.0,0.0,1.0)
    base = kind*21+pi*3+vi
    MusicBlend(base*MUSIC_MODEL_WIDTH,(base+3)*MUSIC_MODEL_WIDTH,(base+1)*MUSIC_MODEL_WIDTH,(base+4)*MUSIC_MODEL_WIDTH,p,v)

music_parameter = (m: MusicModels, b: MusicBlend, field: int) -> f64:
    x = m.values[b.a+field]*(1.0-b.pitch)+m.values[b.b+field]*b.pitch
    y = m.values[b.c+field]*(1.0-b.pitch)+m.values[b.d+field]*b.pitch
    x*(1.0-b.effort)+y*b.effort
