use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_stock.jo'
use 'living_field_land.jo'
use 'living_crop_calendar.jo'
use 'living_work.jo'

field_seed_route_valid = (w: World,place: int,source: int,route: int[]) -> bool:
    if not (source in w.far.districts) or route.len()>64: return false
    at=source
    loop edge in route:
        if edge<0 or edge>=w.far.links.len(): return false
        link=w.far.links[edge]
        if link.mode==.aircraft or (at!=link.a and at!=link.b): return false
        at=if at==link.a: link.b else: link.a
    at==place

field_roots_valid = (w: World,roots: int[]) -> bool:
    if roots.len()==0 or roots.len()>64: return false
    previous= -1
    loop root in roots:
        if root<=previous or root>=w.next_cargo_source: return false
        previous=root
    true

validate_household_field = (w: World,place: int,field: FarField) -> str:
    if field.last_workers<0 or field.last_workers>1000000: return "invalid actual field workers"
    if not field_land_valid(field.land): return "invalid physical arable parcel"
    now=day_index(w.minute)
    if let crop=field.crop:
        if crop.area_ares<=0 or crop.area_ares>field.land.area_ares or crop.seed_milli!=crop.area_ares*CROP_SEED_PER_ARE or crop.seed_cents<0 or crop.paid_cents<0 or crop.wage_remainder<0 or crop.wage_remainder>=24: return "invalid funded crop area/seed/wages"
        if not field_roots_valid(w,crop.seed_roots) or not far_stock_valid(w,crop.seed) or not field_seed_route_valid(w,place,crop.seed_source,crop.seed_route): return "invalid crop seed ownership/history"
        if crop.sowing_work<0 or crop.sowing_work>crop_required_work(crop.area_ares,CROP_SOW_HOURS_PER_HA) or crop.tending_work<0 or crop.tending_work>crop_required_work(crop.area_ares,CROP_TEND_HOURS_PER_HA) or crop.harvest_work<0 or crop.harvest_work>crop_required_work(crop.area_ares,CROP_HARVEST_HOURS_PER_HA): return "invalid paid crop labor"
        if crop.paid_cents*24+crop.wage_remainder!=(crop.sowing_work+crop.tending_work+crop.harvest_work)*100: return "crop work was not actually paid"
        loop good in 0..9:
            if good!=3 and crop.seed.qty[good]!=0: return "crop seed contains unrelated goods"
        if crop.potential_milli<0 or crop.potential_milli>crop.area_ares*CROP_YIELD_PER_ARE or crop.harvested_milli<0 or crop.harvested_milli>crop.potential_milli: return "invalid actual crop harvest"
        if crop.stage==.sowing:
            if crop.seed.qty[3]!=crop.seed_milli or crop.sown_day!=-1 or crop.ready_day!=-1 or crop.harvest_until_day!=-1 or crop.harvest_work!=0 or crop.potential_milli!=0: return "unplanted crop became a harvest"
        else:
            if crop.seed.roots.len()!=0 or crop.sowing_work!=crop_required_work(crop.area_ares,CROP_SOW_HOURS_PER_HA): return "sown seed still has a second owner"
            if crop.sown_day>now or (crop.sown_day<0 and not crop.opening) or crop.ready_day!=crop_ready_day(crop.sown_day,field.land.id) or crop.ready_day-crop.sown_day<CROP_MIN_GROWING_DAYS or crop.harvest_until_day!=crop.ready_day+30: return "invalid crop season/growing lag"
            if crop.stage==.growing and (crop.harvest_work!=0 or crop.potential_milli!=0 or crop.harvested_milli!=0): return "growing crop became warehouse grain"
            if crop.stage==.harvesting and (now<crop.ready_day or crop.potential_milli!=field_care_bound(crop)): return "unripe or unfunded crop harvest"
        if work_provenance_error(w,crop.agreement)!="": return "invalid field agreement"
    if let record=field.last_harvest:
        if record.area_ares<=0 or record.area_ares>field.land.area_ares or record.collected_day>now or record.grain_milli<0 or record.grain_milli>record.area_ares*CROP_YIELD_PER_ARE or record.seed_milli!=record.area_ares*CROP_SEED_PER_ARE or record.paid_cents<0 or record.labor_hours<0 or record.why.len()>4096 or record.seed_cents<0 or record.seed_route.len()>64: return "invalid saved field harvest receipt"
        if not field_roots_valid(w,record.seed_roots) or work_provenance_error(w,record.agreement)!="": return "invalid harvest seed agreement"
        if record.grain_milli>0 and (record.collected_day<record.ready_day or record.ready_day-record.sown_day<CROP_MIN_GROWING_DAYS): return "harvest receipt bypassed growing season"
    ""

field_care_bound = (crop: FarCrop) -> int:
    required=crop_required_work(crop.area_ares,CROP_TEND_HOURS_PER_HA)
    crop.area_ares*CROP_YIELD_PER_ARE*(500+500*min(required,crop.tending_work)/required)/1000
