# Civil calendar shared by routines and air-event callers. Day zero is Monday; four-week
# patronal cycles are keyed by stable capital ID, independent of camera/load/registry order.
use 'living_types.jo'
use 'life_types.jo'

struct CapitalGathering:
    place: int
    country: int
    day: int
    starts_minute: int
    ends_minute: int
    title: str
    square: LifeVenue
    cohort_people: int              # existing local population, not new drawable identities
    named_people: int[]             # existing identities whose local routine can attend

capital_feast_day = (capital_id: int, world_day: int) -> bool:
    capital_id>=0 and world_day>=0 and world_day%28==6+7*(capital_id%4)

capital_feast_active = (w: World, place: int, minute: int) -> bool:
    if minute<0 or not capital_feast_day(place,day_index(minute)) or local_minute(minute)<1020 or local_minute(minute)>=1320: return false
    loop c in w.countries:
        if c.capital_id==place: return true
    false

next_capital_feast_minute = (capital_id: int, after_minute: int) -> int:
    if capital_id<0 or after_minute<0: return -1
    day=day_index(after_minute); feast=6+7*(capital_id%4)
    result=(day/28*28+feast)*1440+1020-EPOCH_LOCAL_MINUTE
    if result<after_minute: result+=28*1440
    result

capital_gatherings = (w: World, minute: int) -> CapitalGathering[]:
    result: CapitalGathering[]
    loop c in w.countries:
        id=c.capital_id
        if not capital_feast_active(w,id,minute) or not (id in w.place_contexts): continue
        squares=[loop v in w.place_contexts[id].venues: if v.kind==.square: v]
        squares.sort_by((v: LifeVenue): v.key)
        if squares.len()==0: continue
        people: int[]
        loop p in w.people:
            if p.id!=w.player and person_place(w,p.id)==id and p.trip<0 and p.injured_until<=minute and p.state!=.departed: people.push(p.id)
        cohorts=0
        if id in w.far.districts:
            loop n in w.far.districts[id].workers: cohorts+=n
            loop n in w.far.districts[id].dependents: cohorts+=n
        day=day_index(minute)
        result.push(CapitalGathering(id,c.id,day,day*1440+1020-EPOCH_LOCAL_MINUTE,day*1440+1320-EPOCH_LOCAL_MINUTE,"{w.place_contexts[id].name} patronal feast",squares[0],cohorts,people))
    result
