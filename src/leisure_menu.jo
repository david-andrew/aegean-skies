# ---------------- wine ----------------

_wine_years = (name: str, group: str, note: str, cents: int, years: int[], rarity: int = 0, serve: Serve = .wine_glass) -> MenuItem[]:
    out: MenuItem[]
    if years.len() == 0:
        out.push(MenuItem(name, "Wine", group, note, cents, rarity, 2, serve, WINE_GOOD, 15, if rarity == 0: 400 else: 900))
        return out
    loop y in years:
        age = max(0, 1932 - y)
        price = cents * (100 + age * 14) / 100
        r = if age >= 25: max(rarity, 2) else: if age >= 12: max(rarity, 1) else: rarity
        remark = if y == 1811: "The comet year. Older than the hotel and better behaved. Sit down first." else: if age >= 30: "That's older than the hotel. Sit down, I'll fetch the key." else: ""
        out.push(MenuItem("{name} {y}", "Wine", group, note, price, r, 2, serve, -1, 0, 400, y, remark))
    out

