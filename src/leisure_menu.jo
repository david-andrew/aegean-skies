# ---------------- the lists, as each place serves them ----------------

drinks_catalogue = () -> MenuItem[]:
    out: MenuItem[]
    out.extend(COFFEES)
    out.extend(BEERS)
    loop group in WINE_LIST: out.extend(group)
    out.extend(FORTIFIED)
    out.extend(ANISE)
    out.extend(BRANDIES)
    out.extend(WHISKIES)
    out.extend(OTHER_SPIRITS)
    out.extend(LIQUEURS)
    out.extend(COCKTAILS)
    out

# the coffee house: coffee, tea and soft drinks, ouzo and tsipouro, a little brandy and wine
coffee_house_drinks = () -> MenuItem[]:
    out: MenuItem[]
    loop d in COFFEES:
        if d.rarity <= 1 or d.year > 1932: out.push(d)
    loop d in ANISE:
        if d.group.starts_with("Ouzo") or d.group.starts_with("Tsipouro") or d.group.starts_with("Tsikoudia"): out.push(d)
    out.push(BRANDIES[0]); out.push(BRANDIES[5])
    loop group in WINE_LIST:
        loop d in group:
            if d.name.starts_with("House") or d.name == "Retsina": out.push(d)
    out

menu_sections = (items: MenuItem[]) -> str[]:
    out: str[]
    loop d in items:
        if not (d.section in out): out.push(d.section)
    out

# Search: every word must appear somewhere in the name, group, section or note (any case).
menu_matches = (d: MenuItem, query: str) -> bool:
    q = lower(query).trim()
    if q == "": return true
    hay = lower("{d.name} {d.group} {d.section} {d.note}")
    loop word in split(q, " "):
        if word != "" and not (word in hay): return false
    true

menu_search = (items: MenuItem[], section: str, query: str) -> int[]:
    [loop k in 0..items.len(): if (section == "" or items[k].section == section) and menu_matches(items[k], query): k]

# The keeper's word, when the drink has none of its own: by how odd it is to ask for it here.
REMARKS_UNCOMMON: str[] = ["We have a few of those. Don't tell the others.", "That's a choice. Coming.", "I had to blow the dust off. Here.", "You have a taste for the foreign."]
REMARKS_EXOTIC: str[] = ["Nobody has asked for that since the steamer from Marseille. Here.", "There's one bottle. There was one bottle.", "I'll have to climb for that. Wait.", "A captain left it here on a bet. You've won it, or lost.", "That came in a crate marked with three countries. Enjoy it."]
REMARKS_FUTURE: str[] = ["Never heard of it. I'll make something that sounds like it.", "That isn't a thing. I'll invent it for you; don't tell anyone.", "Is that what they drink where you come from? Here's the nearest I have."]
REMARKS_PLAIN: str[] = ["", "Coming.", "Right away.", "There you are."]

keeper_remark = (d: MenuItem, ordinal: int) -> str:
    if d.remark != "": return d.remark
    pick = (xs: str[]) -> str: xs[abs(ordinal * 7 + d.name.len()) % xs.len()]
    if d.rarity >= 3 or d.year > 1932: return pick(REMARKS_FUTURE)
    if d.rarity == 2: return pick(REMARKS_EXOTIC)
    if d.rarity == 1: return pick(REMARKS_UNCOMMON)
    pick(REMARKS_PLAIN)
