# ---------------- cocktails ----------------

_mix = (name: str, group: str, note: str, cents: int, rarity: int = 1, year: int = 0, serve: Serve = .coupe, remark: str = "") -> MenuItem:
    MenuItem(name, "Cocktails", group, note, cents, rarity, 3, serve, year = year, remark = remark)

