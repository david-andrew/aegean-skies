# What the bars and coffee houses serve: food by place and region, and a drinks list that is
# deliberately far too deep for a harbour hotel (hundreds of real drinks: beers by style and
# country, wines by grape, region and vintage, whiskies, brandies, ouzo and tsipouro, liqueurs,
# cocktails), with the keeper's remarks when someone orders something odd. Plain data: prices in
# centesimi, the good a dish or drink is made of (priced from the town's market where it exists),
# and the glass it comes in (for the table).

# How a serving is brought to the table (src/bar_scene.jo draws each).
enum Serve: tumbler, mug, wine_glass, coupe, cup, small_glass, bottle, plate, bowl, flute, tall_glass, pot

struct MenuItem:
    name: str
    section: str                    # "Beer", "Wine", "Meze" ...
    group: str                      # "Lager, Bavaria"; "Bordeaux, red"; "From the grill"
    note: str = ""                  # a few plain words about it
    cents: int = 100                # the house's price where no market good sets it
    rarity = 0                      # 0 everyday, 1 uncommon, 2 exotic, 3 not invented yet
    strength = 0                    # 0 none, 1 beer, 2 wine, 3 spirits (for the gentle sway)
    serve: Serve = .tumbler
    good = -1                       # a living-world good it is made from (priced from the market)
    milli = 0                       # how much of that good a serving uses, in milli-packages
    markup = 400                    # the house's markup on that good, in percent
    year = 0                        # the vintage, or the year it was first made
    remark = ""                     # the keeper's word when it is ordered (else one is chosen)
    food = false

const WINE_GOOD = 1
const FISH_GOOD = 0
const OIL_GOOD = 2
const GRAIN_GOOD = 3

# ---------------- food ----------------

_dish = (name: str, group: str, note: str, cents: int, good: int = -1, milli: int = 0, serve: Serve = .plate, remark: str = "") -> MenuItem:
    MenuItem(name, "Food", group, note, cents, good = good, milli = milli, markup = 300, serve = serve, remark = remark, food = true)

