# Main-thread memo of exact canonical vertices, including each legacy island's
# own grid origin. Derived data only; geometry, interpolation and saves are unchanged.
use 'world.jo'
use 'landforms.jo'

const CANONICAL_CORNER_SLOTS = 2048
_corner_epoch: (int,int,int)?
_corner_values: {(int,f64,f64): f64}

surface_corner_count = () -> int: _corner_values.len()

prepare_surface_corners = ():
    global _corner_epoch,_corner_values
    epoch=(land_bake_hash,land_tiles.len(),terrain_key())
    if _corner_epoch!=epoch:
        _corner_values.clear(); _corner_epoch=epoch

cached_corner_height = (isl: Island,x: f64,z: f64) -> f64:
    global _corner_values
    key=(isl.index,x,z)
    if key in _corner_values: return _corner_values[key]
    value=canonical_height(isl,x,z)
    if _corner_values.len()>=CANONICAL_CORNER_SLOTS: _corner_values.clear()
    _corner_values[key]=value
    value

cached_legacy_surface = (x: f64,z: f64) -> f64:
    prepare_surface_corners()
    surface_height_from(x,z,cached_corner_height)
