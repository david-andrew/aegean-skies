# The sounds of the world, all made here from noise and waves: an engine's beat, the rush of air
# and the airframe working (airsound.jo), the surf along a shore, gulls now and then. Loops play
# all the time; their volumes follow what the player is near and doing.

use 'airsound.jo'

# a loop of noise passed through a one-pole low-pass (cut: 0..1, lower is deeper), its loudness
# rising and falling `swells` times over its length (a surf's breathing)
_noise_loop = (seconds: f64, cut: f64, swells: f64, depth: f64, seed: int) -> Sound:
    seed_random(seed)
    n = int(seconds * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    a = 0.0
    b = 0.0
    loop i in 0..n:
        a += (random(-1.0, 1.0) - a) * cut
        b += (a - b) * cut
        u = f64(i) / f64(n)
        env = 1.0 - depth * (0.5 + 0.5 * cos(u * TAU * swells))
        # (the ends meet: faded across the loop's seam)
        seam = min(1.0, min(u, 1.0 - u) * 40.0)
        v = f32(b * env * 2.2 * (0.6 + 0.4 * seam))
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a radial engine: a beat of firing pulses (each a short, rough thump) with a low drone under it.
# At pitch 1 it beats 30 times a second; set_pitch turns it up with the throttle.
engine_loop = () -> Sound:
    seed_random(3)
    n = MIX_RATE                    # one second
    out = fill(f32(0), n * 2)
    beat = 30.0
    rough = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        ph = t * beat
        f = ph - floor(ph)
        k = int(ph) % 7
        loud = 0.75 + 0.25 * f64((k * 5) % 7) / 6.0
        rough += (random(-1.0, 1.0) - rough) * 0.35
        pulse = exp(-f * 9.0) * (0.6 * sin(f * 26.0) + 0.5 * rough) * loud
        drone = 0.22 * sin(t * TAU * beat * 0.5) + 0.12 * sin(t * TAU * beat * 2.0)
        v = f32((pulse * 0.7 + drone) * 0.6)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a gull's cry: a bright note that falls and breaks, two or three times
_gull = (seed: int) -> Sound:
    seed_random(seed)
    calls = 2 + seed % 2
    len = 0.38
    n = int((f64(calls) * len + 0.1) * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    loop c in 0..calls:
        f0 = random(1500.0, 1900.0)
        start = int(f64(c) * len * f64(MIX_RATE))
        m = int(0.3 * f64(MIX_RATE))
        ph = 0.0
        loop i in 0..m:
            u = f64(i) / f64(m)
            f = f0 * (1.0 - 0.35 * u) * (1.0 + 0.04 * sin(u * 60.0))
            ph += f / f64(MIX_RATE)
            env = sin(PI * min(u * 4.0, 1.0) * 0.5) * (1.0 - u) ^ 1.5
            v = (sin(ph * TAU) * 0.6 + sin(ph * TAU * 2.0) * 0.25 + sin(ph * TAU * 3.0) * 0.1) * env * 0.25
            out[(start + i) * 2] += f32(v)
            out[(start + i) * 2 + 1] += f32(v)
    Sound(out)

# a burst of noise falling away: a splash (soft, long) or a crunch of timber and metal (hard, short,
# with knocks in it)
_burst = (seconds: f64, cut: f64, knocks: f64, seed: int) -> Sound:
    seed_random(seed)
    n = int(seconds * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    a = 0.0
    loop i in 0..n:
        u = f64(i) / f64(n)
        a += (random(-1.0, 1.0) - a) * cut
        env = (1.0 - u) ^ 2.0 * min(1.0, u * 60.0)
        knock = if knocks > 0.0: 0.5 + 0.5 * max(0.0, sin(u * knocks * TAU)) ^ 8.0 else: 1.0
        v = f32(a * env * knock * 1.6)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a heavy blow: a deep thump and a short tail of grit (crunch), or a slap and a hiss of water (splash)
_impact = (crunch: bool, seed: int) -> Sound:
    seed_random(seed)
    n = int((if crunch: 0.7 else: 1.1) * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    lp = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        thump = sin(t * TAU * (if crunch: 55.0 else: 75.0) * (1.0 - t * 0.6)) * exp(-t * (if crunch: 9.0 else: 14.0))
        lp += (random(-1.0, 1.0) - lp) * (if crunch: 0.25 else: 0.12)
        grit = lp * exp(-t * (if crunch: 7.0 else: 3.5)) * (if crunch: 0.5 else: 0.7)
        v = f32((thump * 0.9 + grit) * 0.8)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a gun's report: a sharp crack over a short low bark
_gunshot = (seed: int) -> Sound:
    seed_random(seed)
    n = int(0.16 * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    lp = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        lp += (random(-1.0, 1.0) - lp) * 0.35
        v = (random(-1.0, 1.0) * exp(-t * 120.0) * 0.5 + lp * exp(-t * 30.0) * 0.8 + sin(t * TAU * 90.0) * exp(-t * 25.0) * 0.4)
        out[i * 2] = f32(v * 0.6)
        out[i * 2 + 1] = f32(v * 0.6)
    Sound(out)

struct Audio:
    whistle: int = -1               # (wires and struts singing)
    flap: int = -1                  # (cloth cracking in the wind)
    flap_heavy: int = -1            # (and thrashing, faster)
    rumble: int = -1                # (the air buffeting, low)
    howl: int = -1                  # (the air howling, high, when really fast)
    flex_up: Sound[]                # (panels bowing as the airframe takes a load)
    flex_down: Sound[]              # (and as it lets go)
    air_on = true                   # (the pause menu's switches, to hear each kind alone)
    cloth_on = true
    frame_on = true
    clock_cloth = 0.0
    settled_load = 1.0              # (the load when the panels last moved)
    settled_at = 0.0                # (and when)
    clock = 0.0
    quiet = 0.5                     # (seconds till a panel may flex again)
    shot: Sound = Sound([])
    splash: Sound = Sound([])
    crunch: Sound = Sound([])
    engine: int = -1
    wind: int = -1
    surf: int = -1
    gulls: Sound[]
    next_gull = 4.0

start_audio = () -> Audio:
    a = Audio()
    a.engine = play(engine_loop(), 0.0, looping = true)
    a.wind = play(make_rush(), 0.0, looping = true)
    a.whistle = play(make_singing(), 0.0, looping = true)
    a.flap = play(make_flap(), 0.0, looping = true)
    a.flap_heavy = play(make_flap_heavy(), 0.0, looping = true)
    a.rumble = play(make_rumble(), 0.0, looping = true)
    a.howl = play(make_howl(), 0.0, looping = true)
    a.flex_up = [loop k in 0..6: make_oilcan(k, true)]
    a.flex_down = [loop k in 0..6: make_oilcan(10 + k, false)]
    a.shot = _gunshot(7)
    a.surf = play(_noise_loop(8.0, 0.05, 1.0, 0.75, 9), 0.0, looping = true)
    a.gulls = [_gull(1), _gull(2), _gull(3)]
    a.splash = _impact(false, 21)
    a.crunch = _impact(true, 22)
    a

# each frame: the engine (0 when stopped; throttle 0..1), the speed through the air, how near the
# nearest shore is (meters), and where the listener is (for gulls)
update_audio = (a: mut Audio, dt: f64, engine_on: bool, throttle: f64, airspeed: f64, shore: f64, near_town: bool, listener: vec3):
    if a.engine >= 0:
        # (the engine leads: louder than the air at cruise, level with it at the top speed)
        set_volume(a.engine, if engine_on: 0.25 + 0.4 * throttle else: 0.0)
        set_pitch(a.engine, 0.7 + 0.55 * throttle + airspeed / 250.0)
    if a.wind >= 0:
        # (the air's howl rises in pitch and grows with the speed; more layers join it in
        # airframe_sounds)
        w = clamp((airspeed - 5.0) / 85.0, 0.0, 1.8)
        # (the engine leads, then the air: about half the engine at cruise, near it in a dive)
        set_volume(a.wind, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [10.0, 0.02, 40.0, 0.06, 66.0, 0.11, 85.0, 0.16, 125.0, 0.22, 160.0, 0.26]))
        set_pitch(a.wind, 0.55 + 0.6 * w)
    if a.surf >= 0:
        set_volume(a.surf, 0.18 * (1.0 - smoothstep(10.0, 140.0, shore)))
    a.next_gull -= dt
    if a.next_gull <= 0.0:
        a.next_gull = random(6.0, 18.0)
        if (shore < 200.0 or near_town) and a.gulls.len() > 0:
            d = vec3(f32(random(-40.0, 40.0)), f32(random(8.0, 25.0)), f32(random(-40.0, 40.0)))
            play_at(a.gulls[random_int(0, a.gulls.len() - 1)], listener + d, 0.35, 120.0)

# an impact heard where it happened: how hard (0..1)
impact_sound = (a: Audio, pos: vec3, crunch: bool, hard: f64):
    s = if crunch: a.crunch else: a.splash
    if frames(s) == 0: return
    play_at(s, pos, clamp(0.25 + 0.6 * hard, 0.0, 0.9), 220.0, pitch = if crunch: 0.8 + 0.4 * (1.0 - hard) else: 0.7 + 0.5 * (1.0 - hard))

# the airframe and its cloth, each frame: the speed through the air, the g the wings pull, and the
# wind on the cloth (the airspeed aboard; the breeze ashore). Wires sing when fast (higher the
# faster); streamers and the scarf crack, faster the harder the air; and the airframe's panels
# bow over the frame with the load on it, rarely.
airframe_sounds = (a: mut Audio, airspeed: f64, load: f64, cloth_air: f64, dt: f64):
    # the air, in layers that join as the speed builds: a low buffeting from about 150 km/h, a high
    # howl from 250, the wires singing from 160 (the rush itself is in update_audio)
    if a.rumble >= 0:
        set_volume(a.rumble, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [40.0, 0.0, 66.0, 0.05, 85.0, 0.09, 125.0, 0.14, 160.0, 0.17]))
        set_pitch(a.rumble, 0.8 + airspeed / 400.0)
    if a.howl >= 0:
        set_volume(a.howl, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [75.0, 0.0, 90.0, 0.04, 125.0, 0.13, 160.0, 0.18]))
        set_pitch(a.howl, 0.75 + airspeed / 350.0)
    if a.whistle >= 0:
        set_volume(a.whistle, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [50.0, 0.0, 85.0, 0.04, 125.0, 0.07, 160.0, 0.08]))
        set_pitch(a.whistle, 0.7 + airspeed / 150.0)
    # the cloth: faint, and only now and then (a gust catches a streamer, then it settles), its
    # snaps from a breeze up, a heavier thrashing joining them when fast
    a.clock_cloth += dt
    now = 0.5 + 0.5 * wander(a.clock_cloth, 0.13, 61.0)
    gusts = smoothstep(0.55, 0.85, now)
    if a.flap >= 0:
        set_volume(a.flap, (if a.cloth_on: 1.0 else: 0.0) * gusts * curve(cloth_air, [6.0, 0.0, 30.0, 0.025, 66.0, 0.045, 125.0, 0.06]))
        set_pitch(a.flap, min(0.6 + cloth_air / 90.0, 1.8))
    if a.flap_heavy >= 0:
        set_volume(a.flap_heavy, (if a.cloth_on: 1.0 else: 0.0) * gusts * curve(cloth_air, [50.0, 0.0, 85.0, 0.03, 125.0, 0.05, 160.0, 0.06]))
        set_pitch(a.flap_heavy, min(0.7 + cloth_air / 160.0, 1.6))
    # the airframe, with its bending (load: the g the wings pull, which bows them on screen):
    # now and then, as the load changes sharply, a panel bows over its frame, its ring sliding up
    # as it takes the load, down as it lets go. Rarely: most pulls make no sound, and after one, a
    # long quiet. Nothing from speed alone, and nothing without air to load it.
    a.quiet -= dt
    a.clock += dt
    air = smoothstep(25.0, 70.0, airspeed)
    dl = load - a.settled_load
    if abs(dl) > 1.2:
        rate = abs(dl) / max(a.clock - a.settled_at, 0.05)
        sharp = smoothstep(0.6, 4.0, rate)
        if a.frame_on and a.quiet <= 0.0 and air > 0.1 and a.flex_up.len() > 0 and random(0.0, 1.0) < 0.06 + 0.22 * sharp:
            list = if dl > 0.0: a.flex_up else: a.flex_down
            play(list[random_int(0, list.len() - 1)], (0.07 + 0.16 * sharp) * (0.4 + 0.6 * air), pitch = random(0.85, 1.12))
            a.quiet = random(6.0, 14.0)
        a.settled_load = load
        a.settled_at = a.clock

# paused: every running sound silent (update_audio and airframe_sounds bring them back)
hush_audio = (a: Audio):
    loop v in [a.engine, a.wind, a.whistle, a.surf, a.flap, a.flap_heavy, a.rumble, a.howl]:
        if v >= 0: set_volume(v, 0.0)

gun_sound = (a: Audio):
    if frames(a.shot) > 0: play(a.shot, 0.3, pitch = random(0.92, 1.08))
