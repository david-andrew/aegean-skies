# Aircraft sounds made from noise and waves: engine, air and working airframe.
# The optional legacy surf/gull fallback is disabled by the main game, whose
# positional world ambience now lives in ambience_scene.jo.

use 'airsound.jo'
use 'flight_feedback.jo'
use 'aircraft_catalog.jo'
from 'planes.jo' import Craft, aircraft_profile

# a loop of noise passed through a one-pole low-pass (cut: 0..1, lower is deeper), its loudness
# rising and falling `swells` times over its length (a surf's breathing)
_noise_loop = (seconds: f64, cut: f64, swells: f64, depth: f64, seed: int) -> Sound:
    seed_random(seed)
    n = int(seconds * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    a = 0.0
    b = 0.0
    loop i in 0..n:
        a += (random(-1.0, 1.0) - a) * cut
        b += (a - b) * cut
        u = f64(i) / f64(n)
        env = 1.0 - depth * (0.5 + 0.5 * cos(u * TAU * swells))
        # (the ends meet: faded across the loop's seam)
        seam = min(1.0, min(u, 1.0 - u) * 40.0)
        v = f32(b * env * 2.2 * (0.6 + 0.4 * seam))
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a radial engine: a beat of firing pulses (each a short, rough thump) with a low drone under it.
# At pitch 1 it beats 30 times a second; set_pitch turns it up with the throttle.
engine_loop = (voice: EngineVoice = .radial) -> Sound:
    timbre = ENGINE_TIMBRES[int(voice)]
    seed_random(3)
    n = MIX_RATE                    # one second
    out = fill(f32(0), n * 2)
    beat = timbre.firing
    rough = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        ph = t * beat
        f = ph - floor(ph)
        k = int(ph) % 7
        loud = 0.75 + 0.25 * f64((k * 5) % 7) / 6.0
        rough += (random(-1.0, 1.0) - rough) * 0.35
        pulse = exp(-f * timbre.pulse_decay) * (0.6 * sin(f * 26.0) + timbre.roughness * rough) * loud
        drone = 0.22 * sin(t * TAU * beat * 0.5) + 0.12 * sin(t * TAU * beat * 2.0)
        pair = if timbre.beating > 0: 0.12 * sin(t * TAU * (beat + timbre.beating)) else: 0.0
        chop = if voice == .rotary: 0.85 + 0.15 * cos(t * TAU * 4.0) else: 1.0
        v = f32((pulse * 0.7 + drone + pair) * 0.6 * chop)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# an engine heard from outside, as another aircraft goes over: mostly its propeller's buzz (the
# blades passing about 72 times a second at pitch 1, a rasp of harmonics up to a couple of kHz,
# wavering a little), the exhaust's beat under it, fainter than from the cockpit. One second, so
# every part loops clean.
engine_outside_loop = (voice: EngineVoice = .radial) -> Sound:
    timbre = ENGINE_TIMBRES[int(voice)]
    seed_random(5)
    n = MIX_RATE
    out = fill(f32(0), n * 2)
    beat = timbre.firing
    blade = timbre.blades
    rough = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        # (the buzz: a bright sawtooth-like stack, each harmonic a touch out of step, the whole
        # swelling with each firing)
        wob = 0.25 * sin(t * TAU * 3.0) + 0.15 * sin(t * TAU * 7.0)
        buzz = 0.0
        loop k in 1..22:
            ph0 = t * TAU * blade * f64(k) + wob * f64(k) * 0.3 + f64(k * k) * 0.7
            wave = sin(ph0)
            if timbre.beating > 0: wave = 0.5 * (wave + sin(ph0 + t * TAU * timbre.beating * f64(k)))
            buzz += wave / pow(f64(k), if voice == .inline: 1.05 else: 0.85)
        ph = t * beat
        f = ph - floor(ph)
        rough += (random(-1.0, 1.0) - rough) * 0.5
        bark = exp(-f * timbre.pulse_decay) * (0.5 * sin(f * 30.0) + timbre.roughness * rough)
        v = f32((buzz * 0.11 * (0.8 + 0.2 * exp(-f * 4.0)) + bark * 0.3) * 1.15)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a gull's cry: a bright note that falls and breaks, two or three times
_gull = (seed: int) -> Sound:
    seed_random(seed)
    calls = 2 + seed % 2
    len = 0.38
    n = int((f64(calls) * len + 0.1) * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    loop c in 0..calls:
        f0 = random(1500.0, 1900.0)
        start = int(f64(c) * len * f64(MIX_RATE))
        m = int(0.3 * f64(MIX_RATE))
        ph = 0.0
        loop i in 0..m:
            u = f64(i) / f64(m)
            f = f0 * (1.0 - 0.35 * u) * (1.0 + 0.04 * sin(u * 60.0))
            ph += f / f64(MIX_RATE)
            env = sin(PI * min(u * 4.0, 1.0) * 0.5) * (1.0 - u) ^ 1.5
            v = (sin(ph * TAU) * 0.6 + sin(ph * TAU * 2.0) * 0.25 + sin(ph * TAU * 3.0) * 0.1) * env * 0.25
            out[(start + i) * 2] += f32(v)
            out[(start + i) * 2 + 1] += f32(v)
    Sound(out)

# a burst of noise falling away: a splash (soft, long) or a crunch of timber and metal (hard, short,
# with knocks in it)
_burst = (seconds: f64, cut: f64, knocks: f64, seed: int) -> Sound:
    seed_random(seed)
    n = int(seconds * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    a = 0.0
    loop i in 0..n:
        u = f64(i) / f64(n)
        a += (random(-1.0, 1.0) - a) * cut
        env = (1.0 - u) ^ 2.0 * min(1.0, u * 60.0)
        knock = if knocks > 0.0: 0.5 + 0.5 * max(0.0, sin(u * knocks * TAU)) ^ 8.0 else: 1.0
        v = f32(a * env * knock * 1.6)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a heavy blow: a deep thump and a short tail of grit (crunch), or a slap and a hiss of water (splash)
_impact = (crunch: bool, seed: int) -> Sound:
    seed_random(seed)
    n = int((if crunch: 0.7 else: 1.1) * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    lp = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        thump = sin(t * TAU * (if crunch: 55.0 else: 75.0) * (1.0 - t * 0.6)) * exp(-t * (if crunch: 9.0 else: 14.0))
        lp += (random(-1.0, 1.0) - lp) * (if crunch: 0.25 else: 0.12)
        grit = lp * exp(-t * (if crunch: 7.0 else: 3.5)) * (if crunch: 0.5 else: 0.7)
        v = f32((thump * 0.9 + grit) * 0.8)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

# a gun's report: a sharp crack over a short low bark
_gunshot = (seed: int) -> Sound:
    seed_random(seed)
    n = int(0.16 * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    lp = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        lp += (random(-1.0, 1.0) - lp) * 0.35
        v = (random(-1.0, 1.0) * exp(-t * 120.0) * 0.5 + lp * exp(-t * 30.0) * 0.8 + sin(t * TAU * 90.0) * exp(-t * 25.0) * 0.4)
        out[i * 2] = f32(v * 0.6)
        out[i * 2 + 1] = f32(v * 0.6)
    Sound(out)

struct Audio:
    whistle: int = -1               # (wires and struts singing)
    flap: int = -1                  # (cloth fluttering in the wind)
    flap_hits: Sound[]              # (and its snaps, one at a time)
    flap_energy = 1.0               # (a snap's energy: its squares summed, per second)
    flap_next = 0.0                 # (seconds till the next snap)
    flap_heavy: int = -1            # (and thrashing, faster)
    rumble: int = -1                # (the air buffeting, low)
    howl: int = -1                  # (the air howling, high, when really fast)
    deep: int = -1                  # (the air's low roar)
    gale: int = -1                  # (the wind whistling, very fast)
    flex_up: Sound[]                # (panels bowing as the airframe takes a load)
    flex_down: Sound[]              # (and as it lets go)
    air_on = true                   # (the pause menu's switches, to hear each kind alone)
    cloth_on = true
    frame_on = true
    clock_cloth = 0.0
    settled_load = 1.0              # (the load when the panels last moved)
    settled_at = 0.0                # (and when)
    clock = 0.0
    quiet = 0.5                     # (seconds till a panel may flex again)
    shot: Sound = Sound([])
    splash: Sound = Sound([])
    crunch: Sound = Sound([])
    pump: Sound = Sound([])
    engine: int = -1
    engine_voice: EngineVoice = .radial
    engine_loops: Sound[]
    wind: int = -1
    water_run: int = -1
    surf: int = -1
    gulls: Sound[]
    next_gull = 4.0
    environment_on = true

start_audio = (environment: bool = true) -> Audio:
    a = Audio(environment_on=environment)
    a.engine_loops = [loop i in 0..4: engine_loop(EngineVoice(i))]
    a.engine = play(a.engine_loops[int(a.engine_voice)], 0.0, looping = true)
    a.wind = play(make_rush(), 0.0, looping = true)
    a.water_run = play(make_water_run(),0.0,looping=true)
    a.whistle = play(make_singing(), 0.0, looping = true)
    a.flap = play(make_flap(), 0.0, looping = true)
    a.flap_hits = [loop k in 0..6: make_flap_hit(101 + k * 7)]
    e = 0.0
    loop h in a.flap_hits:
        loop i in 0..h.samples.len() / 2: e += f64(h.samples[i * 2]) * f64(h.samples[i * 2])
    a.flap_energy = max(e / f64(a.flap_hits.len()) / f64(MIX_RATE), 1e-9)
    a.flap_heavy = play(make_flap_heavy(), 0.0, looping = true)
    a.rumble = play(make_rumble(), 0.0, looping = true)
    a.howl = play(make_howl(), 0.0, looping = true)
    a.deep = play(make_deep(), 0.0, looping = true)
    a.gale = play(make_gale(), 0.0, looping = true)
    a.flex_up = [loop k in 0..6: make_oilcan(k, true)]
    a.flex_down = [loop k in 0..6: make_oilcan(10 + k, false)]
    a.shot = _gunshot(7)
    if environment:
        a.surf = play(_noise_loop(8.0, 0.05, 1.0, 0.75, 9), 0.0, looping = true)
        a.gulls = [_gull(1), _gull(2), _gull(3)]
    a.splash = make_water_slap()
    a.crunch = _impact(true, 22)
    a.pump = make_pump()
    a

# an engine's note (its loop's pitch) for its throttle and its true speed (m/s)
engine_note = (throttle: f64, speed: f64) -> f64:
    # (the propeller winding up in a dive, plainly: a third higher at the top speed, more beyond)
    0.6 + 0.4 * throttle + 0.5 * clamp(speed / 85.0, 0.0, 1.8)

# each frame: the engine (0 when stopped; throttle 0..1), the speed through the air, how near the
# nearest shore is (meters), and where the listener is (for gulls)
update_audio = (a: mut Audio, dt: f64, engine_on: bool, throttle: f64, airspeed: f64, shore: f64, near_town: bool, listener: vec3, kind: Craft = .gull, feedback: FlightFeedback = FlightFeedback()):
    profile = aircraft_profile(kind)
    if a.engine_voice != profile.voice and a.engine_loops.len() == 4:
        if a.engine >= 0: stop(a.engine)
        a.engine_voice = profile.voice
        a.engine = play(a.engine_loops[int(profile.voice)], 0.0, looping = true)
    if a.engine >= 0:
        # (the engine leads: louder than the air at cruise, level with it at the top speed)
        # (louder with the throttle and a little with the speed; its note rising with both: a
        # fixed propeller turns faster in a dive, throttled back or not)
        lv = 0.22 + 0.33 * throttle + 0.12 * clamp(airspeed / 85.0, 0.0, 1.4)
        set_volume(a.engine, if engine_on and (not feedback.ready or feedback.powered): lv else: 0.0)
        set_pitch(a.engine, loaded_engine_note(engine_note(throttle, airspeed),feedback.climb) * profile.tone)
    if a.water_run >= 0:
        set_volume(a.water_run,if engine_on and a.air_on: 0.30*feedback.water else: 0.0)
        set_pitch(a.water_run,0.65+0.65*feedback.water)
    if engine_on and a.air_on and feedback.slap_hit > 0 and frames(a.splash) > 0:
        play(a.splash,0.06+0.15*feedback.slap_hit,pitch=0.85+0.25*feedback.slap_hit)
    if a.wind >= 0:
        # (the air's howl rises in pitch and grows with the speed; more layers join it in
        # airframe_sounds)
        w = clamp((airspeed - 5.0) / 85.0, 0.0, 1.8)
        # (the engine leads, then the air: about half the engine at cruise, near it in a dive)
        set_volume(a.wind, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [10.0, 0.02, 40.0, 0.06, 66.0, 0.11, 85.0, 0.16, 125.0, 0.22, 160.0, 0.26]))
        set_pitch(a.wind, 0.55 + 0.6 * w)
    if a.surf >= 0:
        set_volume(a.surf, 0.18 * (1.0 - smoothstep(10.0, 140.0, shore)))
    if not a.environment_on: return
    a.next_gull -= dt
    if a.next_gull <= 0.0:
        a.next_gull = random(6.0, 18.0)
        if (shore < 200.0 or near_town) and a.gulls.len() > 0:
            d = vec3(f32(random(-40.0, 40.0)), f32(random(8.0, 25.0)), f32(random(-40.0, 40.0)))
            play_at(a.gulls[random_int(0, a.gulls.len() - 1)], listener + d, 0.35, 120.0)

# an impact heard where it happened: how hard (0..1)
impact_sound = (a: Audio, pos: vec3, crunch: bool, hard: f64):
    s = if crunch: a.crunch else: a.splash
    if frames(s) == 0: return
    play_at(s, pos, clamp(0.25 + 0.6 * hard, 0.0, 0.9), 220.0, pitch = if crunch: 0.8 + 0.4 * (1.0 - hard) else: 0.7 + 0.5 * (1.0 - hard))

# the airframe and its cloth, each frame: the speed through the air, the g the wings pull, and the
# wind on the cloth (the airspeed aboard; the breeze ashore). Wires sing when fast (higher the
# faster); streamers and the scarf crack, faster the harder the air; and the airframe's panels
# bow over the frame with the load on it, rarely.
airframe_sounds = (a: mut Audio, airspeed: f64, load: f64, cloth_air: f64, dt: f64, glide: f64 = 0.0):
    # the air, in layers that join as the speed builds: a low buffeting from about 150 km/h, a high
    # howl from 250, the wires singing from 160 (the rush itself is in update_audio)
    if a.rumble >= 0:
        set_volume(a.rumble, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [40.0, 0.0, 66.0, 0.05, 85.0, 0.09, 125.0, 0.14, 160.0, 0.17]))
        set_pitch(a.rumble, 0.8 + airspeed / 400.0)
    if a.howl >= 0:
        set_volume(a.howl, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [75.0, 0.0, 90.0, 0.04, 125.0, 0.13, 160.0, 0.18]))
        set_pitch(a.howl, 0.75 + airspeed / 350.0)
    if a.whistle >= 0:
        set_volume(a.whistle, (if a.air_on: 1.0 else: 0.0) * (curve(airspeed, [50.0, 0.0, 85.0, 0.04, 125.0, 0.07, 160.0, 0.08])+0.075*glide))
        set_pitch(a.whistle, 0.7 + airspeed / 150.0)
    # (a deep roar from a breeze up; a gale's whistle when very fast)
    if a.deep >= 0:
        set_volume(a.deep, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [20.0, 0.0, 40.0, 0.05, 66.0, 0.1, 85.0, 0.14, 125.0, 0.19]))
        set_pitch(a.deep, 0.85 + airspeed / 500.0)
    if a.gale >= 0:
        set_volume(a.gale, (if a.air_on: 1.0 else: 0.0) * curve(airspeed, [78.0, 0.0, 90.0, 0.035, 110.0, 0.08, 140.0, 0.12]))
        set_pitch(a.gale, 0.85 + airspeed / 400.0)
    # the cloth: steady and faint, its snaps from a breeze up, a heavier thrashing joining them
    # when fast
    a.clock_cloth += dt
    # (sustained: snap after snap, coming faster and louder as the air gets up; all told as loud as
    # the loop it replaced, the steady flutter under them)
    cloth = (if a.cloth_on: 1.0 else: 0.0) * curve(cloth_air, [3.0, 0.0, 12.0, 0.014, 30.0, 0.026, 66.0, 0.04, 125.0, 0.05])
    rate = curve(cloth_air, [3.0, 2.0, 12.0, 4.0, 30.0, 7.0, 66.0, 11.0, 125.0, 15.0, 160.0, 18.0])
    a.flap_next -= dt
    if a.flap_next <= 0.0:
        a.flap_next = random(0.7, 1.3) / rate
        if cloth > 0.0 and a.flap_hits.len() > 0:
            # (a snap pitched up is shorter, so carries less: made up for, as is the spread in loudness)
            p = min(0.8 + cloth_air / 250.0, 1.4) * random(0.92, 1.08)
            v = cloth * 0.16 * 0.9 / sqrt(rate * a.flap_energy / p * 0.65)
            _ = play(a.flap_hits[random_int(0, a.flap_hits.len() - 1)], v * random(0.6, 1.0), pitch = p)
    if a.flap >= 0:
        set_volume(a.flap, cloth * 0.4)
        set_pitch(a.flap, min(0.6 + cloth_air / 90.0, 1.8))
    if a.flap_heavy >= 0:
        set_volume(a.flap_heavy, (if a.cloth_on: 1.0 else: 0.0) * curve(cloth_air, [20.0, 0.0, 45.0, 0.012, 85.0, 0.03, 125.0, 0.042, 160.0, 0.05]))
        set_pitch(a.flap_heavy, min(0.7 + cloth_air / 160.0, 1.6))
    # the airframe, with its bending (load: the g the wings pull, which bows them on screen):
    # now and then, as the load changes sharply, a panel bows over its frame, its ring sliding up
    # as it takes the load, down as it lets go. Rarely: most pulls make no sound, and after one, a
    # long quiet. Nothing from speed alone, and nothing without air to load it.
    a.quiet -= dt
    a.clock += dt
    air = smoothstep(12.0, 45.0, airspeed)
    dl = load - a.settled_load
    if abs(dl) > 0.8:
        rate = abs(dl) / max(a.clock - a.settled_at, 0.05)
        sharp = smoothstep(0.4, 3.0, rate)
        if a.frame_on and a.quiet <= 0.0 and air > 0.1 and a.flex_up.len() > 0 and (abs(dl) > 1.8 or random(0.0, 1.0) < 0.12 + 0.35 * sharp):
            list = if dl > 0.0: a.flex_up else: a.flex_down
            play(list[random_int(0, list.len() - 1)], (0.07 + 0.16 * sharp) * (0.4 + 0.6 * air), pitch = random(0.85, 1.12))
            a.quiet = random(6.0, 14.0)
        a.settled_load = load
        a.settled_at = a.clock

# paused: every running sound silent (update_audio and airframe_sounds bring them back)
hush_audio = (a: Audio):
    loop v in [a.engine, a.wind, a.whistle, a.water_run, a.surf, a.flap, a.flap_heavy, a.rumble, a.howl, a.deep, a.gale]:
        if v >= 0: set_volume(v, 0.0)

# taking on fuel: a hand pump's strokes at the pier, each a clack of the lever and a gulp of petrol
# down the hose, for about three seconds
make_pump = (seconds: f64 = 3.0) -> Sound:
    seed_random(31)
    n = int(seconds * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    lp = 0.0; lp2 = 0.0
    stroke = 0.62
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        ph = (t % stroke) / stroke
        # the gulp: low noise swelling through the stroke, bubbling as it goes
        lp += (random(-1.0, 1.0) - lp) * 0.05
        lp2 += (lp - lp2) * 0.2
        swell = sin(PI * min(1.0, ph / 0.8)) ^ 2.0
        bubble = 0.6 + 0.4 * sin(t * TAU * (21.0 + 6.0 * sin(t * 3.1)))
        gulp = lp2 * 3.2 * swell * bubble
        # the clack: lever and valve at the top of each stroke, a short metallic knock
        k = ph * stroke
        clack = (sin(k * TAU * 820.0) * 0.6 + sin(k * TAU * 1370.0) * 0.4) * exp(-k * 55.0) * 0.35
        fade = min(1.0, t * 8.0) * min(1.0, (seconds - t) * 4.0)
        v = f32((gulp + clack) * fade * 0.7)
        out[i * 2] = v
        out[i * 2 + 1] = v
    Sound(out)

pump_sound = (a: Audio):
    if frames(a.pump) > 0: play(a.pump, 0.35)

gun_sound = (a: Audio):
    if frames(a.shot) > 0: play(a.shot, 0.3, pitch = random(0.92, 1.08))

# Planing hiss above the low hull rumble, a real-noise crossfaded loop.
make_water_run = (seconds: f64 = 4.0) -> Sound:
    r = rng(8147)
    fade = MIX_RATE/2
    n = int(seconds*f64(MIX_RATE))+fade
    m = fill(0.0,n)
    slow = 0.0; fast = 0.0
    loop i in 0..n:
        v = r.next_float()*2.0-1.0
        slow += (v-slow)*0.018
        fast += (v-fast)*0.32
        t = f64(i)/f64(MIX_RATE)
        m[i] = (slow*2.5+(v-fast)*0.18)*(0.84+0.16*wander(t,3.2,61.0))
    seamless(m,fade,0.18)

# Shared by the live mixer and the offline presentation sample.
make_water_slap=()->Sound:_impact(false,21)
