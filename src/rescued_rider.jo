# A pilot taken out of the water, seen all the way: they climb up out of the sea onto the float and
# into the second seat (or, the seat taken, onto the lower wing's root beside the hull), ride along,
# and at the harbour climb out onto the quay beside the player and walk off into the town, in their
# flying kit, the few words on the quay said over them as they go. Drawing and its timing only:
# who is aboard is the living world's (riding_craft); this follows it.

enum RiderStage: none, boarding, aboard, alighting, walking, away   # (away: in the hands of a transfer that draws them itself, the Ierax's boat and ladder)

struct RescuedRider:
    stage: RiderStage = .none
    person = -1
    since = 0.0                     # when the stage began (s)
    from: vec3 = vec3(0,0,0)        # where a climb began (world)
    pos: vec3 = vec3(0,0,0)         # standing or walking (world)
    yaw = 0.0
    phase = 0.0
    away: vec3 = vec3(0,0,1)        # the way they walk off
    on_wing = false                 # (the second seat taken: on the wing root)

const RIDER_CLIMB = 2.2             # seconds out of the water and up into the seat
const RIDER_ALIGHT = 1.6            # seconds out of the seat onto the quay
const RIDER_WALK = 14.0             # seconds walking off at least, before they may be gone into the town
const RIDER_WALK_MOST = 150.0       # and at most, seen or not
const RIDER_PACE = 1.25             # m/s

rider_board = (person: int, in_water: vec3, now: f64, wing: bool) -> RescuedRider:
    RescuedRider(stage = .boarding, person = person, since = now, from = in_water, pos = in_water, on_wing = wing)

# Back aboard after a load: straight into the seat.
rider_seated = (person: int, now: f64, wing: bool) -> RescuedRider: RescuedRider(stage = .aboard, person = person, since = now, on_wing = wing)

rider_alight = (r: mut RescuedRider, seat: vec3, quay: vec3, inland: vec3, now: f64):
    r.stage = .alighting; r.since = now; r.from = seat; r.pos = quay
    r.away = normalize(vec3(inland.x,0,inland.z)+vec3(0.0001,0,0))
    r.yaw = atan2(f64(r.away.x),f64(r.away.z))

# A step: the climb aboard done, out onto the quay, walking off, gone. `ground` gives the walking
# height (none: water, where they stop). Gone only once out of sight (`unseen`: off the screen or
# far off), never from in front of the camera.
rider_step = (r: mut RescuedRider, now: f64, dt: f64, ground: (f64,f64)->f64?, unseen: bool = true):
    match r.stage:
        .boarding:
            if now-r.since >= RIDER_CLIMB: r.stage = .aboard; r.since = now
        .alighting:
            if now-r.since >= RIDER_ALIGHT: r.stage = .walking; r.since = now
        .walking:
            next = r.pos+r.away*f32(RIDER_PACE*dt)
            if let h = ground(f64(next.x),f64(next.z)):
                r.pos = vec3(next.x,f32(h),next.z); r.phase += dt*7.5
            if (now-r.since >= RIDER_WALK and unseen) or now-r.since >= RIDER_WALK_MOST: r = RescuedRider()
        _: pass

# Where they are in a climb, between `from` and `to`, up and over the edge.
rider_climb_point = (from: vec3, to: vec3, k: f64) -> vec3:
    u = clamp(k,0.0,1.0)
    lift = f32(sin(u*PI)*0.9)
    lerp(from,to,f32(u))+vec3(0,lift,0)

# The seat they ride in, in the aircraft's frame: the second cockpit, or the lower wing's root
# beside it, sitting, legs over the edge.
rider_seat = (second: vec3, wing: bool, span: f64) -> vec3: if wing: second+vec3(f32(min(1.6,span*0.12)),-0.85,0.3) else: second
