# Period broadcast colour for the announcer, before the station leveller and the receiver: the
# small studio (early reflections and a short damped tail, room tone and mains hum), a carbon
# microphone (resonant 300-3400 Hz band, granule nonlinearity and its signal-dependent hiss) and
# transmitter compression with a soft limiter. Fixed storage, bounded work per sample; its noise
# has its own random stream. Amount 0 passes the voice through untouched.
const STUDIO_RATE = 16000
const STUDIO_DELAY = 1024

struct StudioFilter:
    b0 = 0.0
    b1 = 0.0
    b2 = 0.0
    a1 = 0.0
    a2 = 0.0
    x1 = 0.0
    x2 = 0.0
    y1 = 0.0
    y2 = 0.0

# kind 0 low-pass, 1 high-pass, 2 band-pass, 3 peaking (gain in dB)
studio_filter = (hz: f64, kind: int, q: f64 = 0.70710678, db: f64 = 0.0) -> StudioFilter:
    w = TAU*hz/f64(STUDIO_RATE); c = cos(w); a = sin(w)/(2.0*q)
    if kind == 3:
        g = pow(10.0,db/40.0)
        d = 1.0+a/g
        return StudioFilter((1.0+a*g)/d,-2.0*c/d,(1.0-a*g)/d,-2.0*c/d,(1.0-a/g)/d)
    d = 1.0+a
    if kind == 2: return StudioFilter(a/d,0,-a/d,-2*c/d,(1-a)/d)
    b = (if kind == 1: 1.0+c else: 1.0-c)/(2.0*d)
    StudioFilter(b,(if kind == 1: -2.0 else: 2.0)*b,b,-2*c/d,(1-a)/d)

studio_filter_sample = (f: mut StudioFilter, x: f64) -> f64:
    y = f.b0*x+f.b1*f.x1+f.b2*f.x2-f.a1*f.y1-f.a2*f.y2
    f.x2 = f.x1; f.x1 = x; f.y2 = f.y1; f.y1 = y
    y

struct Studio:
    ready = false
    delay: f64[]
    at = 0
    tail = 0.0
    tail_damp = 0.0
    mic_hp: StudioFilter = studio_filter(290,1)
    mic_body: StudioFilter = studio_filter(1500,3,1.1,7.0)
    mic_edge: StudioFilter = studio_filter(2700,3,2.0,4.0)
    mic_lp1: StudioFilter = studio_filter(3400,0)
    mic_lp2: StudioFilter = studio_filter(3400,0)
    dc: StudioFilter = studio_filter(25,1)
    hiss_band: StudioFilter = studio_filter(2200,2,0.7)
    tone_lp: StudioFilter = studio_filter(900,0)
    level = 0.0                      # carbon granule excitation (signal envelope)
    comp_env = 0.0
    comp_gain = 1.0
    hum_phase = 0.0
    rng: u64 = 99991

make_studio = () -> Studio: Studio(ready=true,delay=fill(0.0,STUDIO_DELAY))

studio_random = (s: mut Studio) -> f64:
    s.rng = (s.rng*u64(6364136223846793005)+u64(1442695040888963407))
    f64((s.rng >> 11) & u64(0xfffffffffffff))/4503599627370496.0*2.0-1.0

# Early reflections (5-23 ms) of a small, furnished studio, and a 37 ms recirculating tail.
STUDIO_TAPS = [85,155,226,368]
STUDIO_TAP_GAINS = [0.30,0.22,0.15,0.10]
const STUDIO_TAIL = 593

studio_sample = (s: mut Studio, x: f64, amount: f64) -> f64:
    if amount <= 0: return x
    if not s.ready: s = make_studio()
    # Room: reflections and a damped tail, plus room tone (soft broadband air) and 50 Hz hum.
    s.delay[s.at] = x
    room = x
    loop k in 0..STUDIO_TAPS.len():
        room += STUDIO_TAP_GAINS[k]*s.delay[(s.at+STUDIO_DELAY-STUDIO_TAPS[k])%STUDIO_DELAY]*amount
    recirculated = s.delay[(s.at+STUDIO_DELAY-STUDIO_TAIL)%STUDIO_DELAY]+s.tail*0.35
    s.tail_damp += (recirculated-s.tail_damp)*0.35
    s.tail = s.tail_damp
    room += s.tail*0.12*amount
    s.at = (s.at+1)%STUDIO_DELAY
    s.hum_phase += 50.0/f64(STUDIO_RATE)
    if s.hum_phase >= 1.0: s.hum_phase -= 1.0
    hum = 0.0016*sin(TAU*s.hum_phase)+0.0009*sin(TAU*3.0*s.hum_phase)
    room += (studio_filter_sample(s.tone_lp,studio_random(s))*0.004+hum)*amount
    # Carbon microphone: resonant band-limit, then the granules' asymmetric, level-dependent
    # distortion and their frying hiss, which grows with the signal.
    m = studio_filter_sample(s.mic_hp,room)
    m = studio_filter_sample(s.mic_body,m)
    m = studio_filter_sample(s.mic_edge,m)
    m = studio_filter_sample(s.mic_lp2,studio_filter_sample(s.mic_lp1,m))
    s.level += (abs(m)-s.level)*(if abs(m) > s.level: 0.01 else: 0.0015)
    drive = 1.0+2.2*amount
    bent = m*drive
    bent = bent+0.22*amount*bent*bent
    bent = bent/(1.0+abs(bent))/drive*(1.0+0.6*amount)
    bent = studio_filter_sample(s.dc,bent)
    bent += studio_filter_sample(s.hiss_band,studio_random(s))*(0.001+0.05*s.level)*amount
    # Transmitter: fast compression (2 ms attack, 120 ms release, 4:1 above threshold), then a
    # soft limiter.
    s.comp_env += (abs(bent)-s.comp_env)*(if abs(bent) > s.comp_env: 0.03 else: 0.0005)
    threshold = 0.06
    wanted = if s.comp_env > threshold: pow(threshold/s.comp_env,0.75) else: 1.0
    s.comp_gain += (wanted-s.comp_gain)*(if wanted < s.comp_gain: 0.03 else: 0.0008)
    y = bent*s.comp_gain*2.2
    y = y/(1.0+abs(y)*1.4)
    x*(1.0-amount)+y*amount

studio_block = (s: mut Studio, values: mut f64[], amount: f64):
    if amount <= 0: return
    loop i in 0..values.len(): values[i] = studio_sample(s,values[i],amount)
