# Exact canonical vertex memoization for nearby moving hulls. No pose/depth tolerance,
# coarser surface or skipped hull/quay samples; this cache never enters a save.
use 'world.jo'
use 'landforms.jo'
use 'geography.jo'
use 'settlements.jo'
use 'sea_routes.jo'
use 'surface_corners.jo'

const SCENE_SURFACE_CORNERS = CANONICAL_CORNER_SLOTS
scene_surface_corner_count = () -> int: surface_corner_count()

prepare_scene_surface = (): prepare_surface_corners()

scene_ground = (at: vec2) -> f64:
    if abs(at.x)<LEGACY_RESERVE and abs(at.y)<LEGACY_RESERVE:
        return surface_height_from(f64(at.x),f64(at.y),cached_corner_height)
    place_ground(at)

scene_depth_ok = (at: vec2,draft: f64) -> bool:
    sea_depth_at_ground(at,draft,scene_ground(at))
