# The loading propeller (docs/glossary: Loading propeller), drawn by the game while it prepares the
# world before the title. An engine running up, holding at full, easing back to the edge of the
# disc and down to idle again, every eight seconds, in the in-game propeller's own regimes
# (src/prop_disc.jo): solid blades turning, a pale disc coming in over them, then pencil arcs in
# bands that precess by prop_band_speed, slowly at full power and fast near the hand-over from the
# blades. The web page's card (src/web_compat.js AegeanLoadingProp) is the same: the same
# timetable (160 stops a cycle, linear between them, as its CSS keyframes are), the same shapes
# and the same arcs, so the two match frame for frame.
use 'prop_disc.jo'

const LOADING_CYCLE = 8.0
const LOADING_STOPS = 160
const LOADING_R = 34.0
const LOADING_HUB = 4.5
const LOADING_RIM_RATE = 0.06       # (the rim highlight turns at this fraction of the shaft's speed)
# (rpm in the game's shaft rad/s at these times, eased between)
LOADING_RUN: f64[][] = [[0.0, 8.0], [0.8, 8.0], [2.6, 78.0], [4.2, 78.0], [5.6, 46.0], [6.6, 46.0], [8.0, 8.0]]

struct LoadingRow:
    blade = 0.0                     # degrees, clockwise
    band = 0.0
    rim = 0.0                       # (the rim highlight's own angle: LOADING_RIM_RATE of the shaft's)
    blades = 1.0                    # the layers' opacities
    disc = 0.0
    arcs = 0.0
    rpm = 0.0

_loading_smooth = (a: f64, b: f64, x: f64) -> f64:
    t = clamp((x - a) / (b - a), 0.0, 1.0)
    t * t * (3.0 - 2.0 * t)

loading_rpm = (t: f64) -> f64:
    loop i in 1..LOADING_RUN.len():
        if t <= LOADING_RUN[i][0]:
            a = LOADING_RUN[i - 1]; b = LOADING_RUN[i]
            return a[1] + (b[1] - a[1]) * _loading_smooth(a[0], b[0], t)
    LOADING_RUN[LOADING_RUN.len() - 1][1]

# The timetable: each stop's angles (each cycle closing on itself: a two-bladed prop is the same
# every half turn) and the layers' opacities, from the game's own thresholds.
loading_table = () -> LoadingRow[]:
    n = 2400
    dt = LOADING_CYCLE / f64(n)
    blade = 0.0; band = 0.0; rim = 0.0
    raws: f64[][]
    loop i in 0..n + 1:
        rpm = loading_rpm(f64(i) * dt)
        raws.push([blade, band, rpm, rim])
        blade += rpm * dt; band += prop_band_speed(rpm) * dt; rim += LOADING_RIM_RATE * rpm * dt
    close = (total: f64) -> f64: f64(round(total / PI)) * PI - total
    fix_blade = close(raws[n][0]); fix_band = close(raws[n][1]); fix_rim = close(raws[n][3])
    rows: LoadingRow[]
    loop s in 0..LOADING_STOPS + 1:
        i = int(round(f64(s) * f64(n) / f64(LOADING_STOPS)))
        f = f64(i) / f64(n)
        rpm = raws[i][2]
        rows.push(LoadingRow(blade = (raws[i][0] + fix_blade * f) * 180.0 / PI, band = (raws[i][1] + fix_band * f) * 180.0 / PI, rim = (raws[i][3] + fix_rim * f) * 180.0 / PI,
            blades = 1.0 - _loading_smooth(PROP_BLADES_BELOW - 4.0, PROP_BLADES_BELOW + 4.0, rpm),
            disc = _loading_smooth(PROP_DISC_FROM, PROP_DISC_FULL, rpm), arcs = _loading_smooth(PROP_STREAK_FROM, PROP_STREAK_FULL, rpm), rpm = rpm))
    rows

# where in the cycle at time t (seconds), linear between the stops as the page's keyframes are
loading_row = (rows: LoadingRow[], t: f64) -> LoadingRow:
    x = ((t % LOADING_CYCLE) + LOADING_CYCLE) % LOADING_CYCLE / LOADING_CYCLE * f64(LOADING_STOPS)
    s = clamp(int(floor(x)), 0, LOADING_STOPS - 1)
    u = x - f64(s)
    a = rows[s]; b = rows[s + 1]
    m = (p: f64, q: f64) -> f64: p + (q - p) * u
    LoadingRow(blade = m(a.blade, b.blade), band = m(a.band, b.band), rim = m(a.rim, b.rim), blades = m(a.blades, b.blades), disc = m(a.disc, b.disc), arcs = m(a.arcs, b.arcs), rpm = m(a.rpm, b.rpm))

# (src/prop_disc.jo _disc_hash, in doubles as the page's)
_loading_hash = (x: f64) -> f64:
    v = sin(x * 12.9898) * 43758.547
    v - floor(v)

# One drawing's pencil arcs (variant 0..2): per blade a band of short arcs about the hub, each of
# random length and offset, a few left out: (radius, from, to), radians clockwise from straight up.
loading_arcs = (variant: int) -> vec3[]:
    list: vec3[]
    dr = 3.0
    r0 = LOADING_HUB + 2.5
    loop k in 0..2:
        s = f64(variant) * 17.3 + 7.13 * f64(k)
        axis = f64(k) * PI
        j = 0
        loop r0 + f64(j + 1) * dr < LOADING_R:
            hs = s + f64(j) * 1.37
            if _loading_hash(hs + 3.3) > 0.12:
                rr = r0 + (f64(j) + 0.5) * dr + 0.3 * dr * (_loading_hash(hs) - 0.5)
                w = (0.12 + 0.10 * rr / LOADING_R) * LOADING_R
                centre = (_loading_hash(hs + 1.1) - 0.5) * w * 0.9
                reach = w * (0.25 + 0.9 * _loading_hash(hs + 2.2))
                list.push(vec3(f32(rr), f32(axis + (centre - reach) / rr), f32(axis + (centre + reach) / rr)))
            j += 1
    list

# the blade's outline: the page's path (M0,-3 C5,-6 7,-22 2,-33 C1,-35 -1,-35 -2,-33 C-7,-22 -5,-6 0,-3 Z)
_loading_blade_outline = () -> vec2[]:
    pts: vec2[]
    curves = [[vec2(0, -3), vec2(5, -6), vec2(7, -22), vec2(2, -33)], [vec2(2, -33), vec2(1, -35), vec2(-1, -35), vec2(-2, -33)], [vec2(-2, -33), vec2(-7, -22), vec2(-5, -6), vec2(0, -3)]]
    loop c in curves:
        loop i in 0..12:
            t = f32(f64(i) / 12.0)
            u = 1.0 - t
            pts.push(c[0] * (u * u * u) + c[1] * (3.0 * u * u * t) + c[2] * (3.0 * u * t * t) + c[3] * (t * t * t))
    pts

loading_rows: LoadingRow[] = []
loading_blade: vec2[] = []
loading_arc_sets: vec3[][] = []

# The loader at `center`, at time t (seconds); `fraction` fills the faint ring round it.
draw_loading_propeller = (center: vec2, t: f64, fraction: f64):
    global loading_rows, loading_blade, loading_arc_sets
    if loading_rows.len() == 0:
        loading_rows = loading_table()
        loading_blade = _loading_blade_outline()
        loading_arc_sets = [loop v in 0..3: loading_arcs(v)]
    r = loading_row(loading_rows, t)
    ring(center, 40.0, 1.5, rgba(0.85, 0.83, 0.77, 0.10))
    if fraction > 0.0: arc(center, 40.0, 1.5, -PI * 0.5, -PI * 0.5 + TAU * clamp(fraction, 0.0, 1.0), rgba(0.78, 0.62, 0.32, 0.55))
    # (the pale disc and its rim)
    if r.disc > 0.001:
        circle(center, LOADING_R, rgba(0.85, 0.83, 0.77, f32(0.16 * r.disc)))
        ring(center, LOADING_R - 0.8, 1.1, rgba(0.85, 0.83, 0.77, f32(0.32 * r.disc)))
        # (its rim highlight: two bright arcs, opposite, a sheen sliding round at its own rate, as the page's)
        turn = r.rim * PI / 180.0
        loop k in [0.0, PI]:
            a = k + PI * 0.25 + turn - PI * 0.5
            arc(center, LOADING_R - 0.8, 1.8, a - 0.6, a + 0.6, rgba(0.98, 0.96, 0.89, f32(0.9 * r.disc)))
    # (the arcs: a new drawing twelve times a second, the bands turning by their own angle)
    if r.arcs > 0.001:
        turn = r.band * PI / 180.0
        ink = rgba(0.94, 0.91, 0.82, f32(0.92 * r.arcs))
        loop a in loading_arc_sets[int(floor(t * 12.0)) % 3]:
            arc(center, f64(a.x), 1.4, f64(a.y) + turn - PI * 0.5, f64(a.z) + turn - PI * 0.5, ink)
    # (the blades)
    if r.blades > 0.001:
        loop half in [0.0, PI]:
            a = r.blade * PI / 180.0 + half
            polygon([loop p in loading_blade: center + vec2(f32(f64(p.x) * cos(a) - f64(p.y) * sin(a)), f32(f64(p.x) * sin(a) + f64(p.y) * cos(a)))], rgba(0.78, 0.62, 0.32, f32(0.85 * r.blades)))
    circle(center, LOADING_HUB, rgba(0.54, 0.42, 0.21, 1))
