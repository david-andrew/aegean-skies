use 'living_guard.jo'
use 'living_transaction.jo'
# Explicit committed conversation, separate from read-only topic/preview projections.
use 'living_types.jo'
use 'life_types.jo'
use 'living_phrases.jo'
use 'living_questions.jo'
use 'living_talk_context.jo'
use 'living_voice_lines.jo'
use 'living_work_knowledge.jo'
use 'living_conditions.jo'
use 'living_content.jo'
use 'living_place_context.jo'
use 'living_far_context.jo'
use 'living_far_news.jo'
import 'living_seed.jo' as acquaintances
import 'living_news.jo' as knowledge

const SPEECH_RECENT_MINUTES = 240
const SPEECH_RECENT_LINES = 64

voice_of = (w: World, person: int) -> VoiceKind: voice_of_context(w,person)

talk_name = (w: World, person: int) -> str:
    if person == w.player: return "the pilot"
    if person < 0 or person >= w.people.len(): return "the harbour office"
    parts = split(w.people[person].name," ")
    if parts.len() > 1 and parts[0] == "Father": parts[0]+" "+parts[1] else: parts[0]

talk_place = (w: World, place: int) -> str:
    life_place_name(w,place)

talk_money = (cents: int) -> str:
    if cents % 100 == 0: "{cents/100} {if cents == 100: "lira" else: "lire"}" else: "{f64(cents)/100.0:.2} lire"

talk_when = (w: World, minute: int) -> str:
    hm = local_minute(minute)
    day = day_index(minute)-day_index(w.minute)
    time = "{hm/60:02}:{hm%60:02}"
    if day == 0: time else: if day == 1: "tomorrow at {time}" else: if day == -1: "yesterday at {time}" else: if day < 0: "{abs(day)} days ago" else: "in {day} days, at {time}"

talk_load = (w: World, good: int, quantity: int) -> str:
    if good < 0: return "the sealed bag"
    if good == 1 and quantity == 100: return "a bottle of wine"
    n = f64(quantity)/1000.0
    word = if good == 1 or good == 2: "barrel" else: if good == 3: "sack" else: if good == 6: "box" else: "crate"
    if quantity == 1000: "a {word} of {w.goods[good].key}" else: "{n:.1} {if word == "box": "boxes" else: word+"s"} of {w.goods[good].key}"

conversation_topics = (w: World, speaker: int, listener: int) -> TalkOption[]:
    if speaker < 0 or speaker >= w.people.len() or listener < 0 or listener >= w.people.len(): return []
    p = w.people[speaker]
    if not people_can_talk(w,speaker,listener): return []
    topics = [TalkOption(.greeting,"Say hello"),TalkOption(.weather,"The weather"),TalkOption(.home,"Their day")]
    loop job in w.active_jobs:
        j = w.jobs[job]
        if j.poster == speaker and j.state == .open:
            topics.push(TalkOption(.work,if j.delivery_mode == .foot: "Something to carry in town" else: "Work for a pilot",job=job)); break
    public_news = false
    loop n in p.news:
        if not n.private_fact and w.minute-n.occurred_minute < 10080: public_news = true
    loop r in p.far_reports:
        if w.minute-r.occurred_minute<10080: public_news=true
    if public_news: topics.push(TalkOption(.news,"What they've heard"))
    if p.occupation == .merchant or p.occupation == .oil_presser or p.occupation == .miller or p.occupation == .fisher or p.occupation == .quartermaster: topics.push(TalkOption(.market,"Trade and prices"))
    topics.push(TalkOption(.people,"People they know"))
    troubled = p.injured_until > w.minute
    loop id in p.obligations:
        if not (id in w.obligations): continue
        o = w.obligations[id]
        if o.debtor == speaker and (o.state == .open or o.state == .blocked) and o.due_minute <= w.minute+360 and (o.kind == .debt or o.kind == .rent or o.kind == .delivery or o.kind == .repair): troubled = true
    if troubled: topics.push(TalkOption(.troubles,"Ask how things stand"))
    if local_minute(w.minute)>=1050 and local_minute(w.minute)<1320 and speaker in w.daily_life and (w.daily_life[speaker].venue == .square or w.daily_life[speaker].venue == .cafe): topics.push(TalkOption(.music,"The evening and the music"))
    topics.push(TalkOption(.farewell,"Take your leave"))
    topics

_bank = (lines: str[], key: str, priority: int = 100) -> SpeechCandidate[]:
    [loop k in 0..lines.len(): SpeechCandidate("{key}:{k}",lines[k],priority)]

# Only saved, personally known news is eligible. The speaker never queries remote events.
speech_subject = (w: World, person: int, speaker: int, listener: int) -> str:
    if person==speaker: "I" else: if person>=0 and person==listener: "you" else: if person==w.player: w.people[person].name else: talk_name(w,person)
speech_object = (w: World, person: int, speaker: int, listener: int) -> str:
    if person==speaker: "me" else: if person>=0 and person==listener: "you" else: if person==w.player: w.people[person].name else: talk_name(w,person)

news_candidates = (w: World, speaker: int, listener: int = -1) -> SpeechCandidate[]:
    result: SpeechCandidate[] = far_report_candidates(w,speaker)
    p=w.people[speaker]; voice=voice_of(w,speaker)
    loop n in p.news:
        if n.private_fact or w.minute-n.occurred_minute>=10080: continue
        r=n.reason
        superseded=false
        if n.kind==.late:
            loop later in p.news:
                same=(r.job>=0 and later.reason.job==r.job) or (r.obligation>=0 and later.reason.obligation==r.obligation)
                if same and later.reason.actor==r.actor and later.occurred_minute>=n.occurred_minute and later.kind==.delivery: superseded=true
        if superseded: continue
        a=speech_subject(w,r.actor,speaker,listener); obj=speech_object(w,r.actor,speaker,listener)
        other=speech_object(w,r.counterparty,speaker,listener); who=speech_object(w,r.beneficiary,speaker,listener)
        dest=talk_place(w,r.destination); where=if n.origin<0: "the open sea" else: talk_place(w,n.origin)
        near_place=if n.origin<0: "at sea" else: "near "+where
        off_place=if n.origin<0: "at sea" else: "off "+where
        cargo=talk_load(w,r.good,r.quantity)
        fact=""; firsthand=n.hops==0 and n.confidence==1000
        participant=r.actor==speaker or r.counterparty==speaker or r.beneficiary==speaker
        # A participant can tell their own act; it isn't a stranger's third-person anecdote.
        if participant: firsthand=true
        match n.kind:
            .raid, .theft:
                if r.actor==speaker: continue # no public self-incriminating account/knowledge leak
                fact="{a} attacked {other} {near_place}"
                if r.counterparty==speaker: fact="{a} came after me {near_place}"
                if not firsthand and n.source_person==r.counterparty:
                    source=speech_subject(w,n.source_person,speaker,listener)
                    victim=if n.source_person==listener: "you" else: "them"
                    fact="{source} said {a} attacked {victim} {near_place}"
            .arrived: fact="{a} reached {dest}"
            .departed: fact="{a} left {talk_place(w,r.origin)} for {dest}"
            .patrol: fact="{a} watched the lanes off {dest}"
            .fine: fact="the {where} office fined {obj}"
            .refused: fact="{a} refused the crossing to {dest}"
            .delivery:
                if r.purpose==.report:
                    owner=ctx_possessive(w,r.counterparty,speaker,listener)
                    fact="{a} handed {owner} supply report to {who} at {dest}"
                else:
                    beneficiary=if r.actor==r.beneficiary: (if r.actor==speaker: "myself" else: "themselves") else: who
                    fact="{a} brought {cargo} to {dest} for {beneficiary}"
                    if r.beneficiary==speaker and r.actor!=speaker: fact="I received {cargo} from {obj} at {dest}"
            .late: fact="{a} missed the promised time for {dest}"
            .defaulted: fact="{a} missed the payment to {who}"
            .closure: fact="the weather closed the harbour at {where}"
            .ditch: fact="{ctx_possessive(w,r.actor,speaker,listener)} aircraft came down in the water {off_place}"
            .rescue: fact="the harbour boat brought {obj} ashore at {where}"
            .repair: fact="the workshop attended to {ctx_possessive(w,r.actor,speaker,listener)} aircraft at {where}"
            .shortage:
                if r.good<0: continue
                fact="{speech_subject(w,r.beneficiary,speaker,listener)} needed {w.goods[r.good].key} at {dest}"
            .produced:
                if r.purpose==.report: fact="{a} prepared a supply report for {who} at {dest}"
                else if r.good>=0: fact="{a} brought in {cargo} at {where}"
            .met: fact="{a} stopped for a word with {other} at {where}"
            .search: fact="{a} returned without finding {other}"
            .quarrel: fact="{a} had words with {other} at {where}"
            .celebration: fact="people gathered at {where}"
            else: pass
        if fact=="": continue
        sourced_victim=not firsthand and (n.kind==.raid or n.kind==.theft) and n.source_person==r.counterparty
        sourced_actor=not firsthand and n.source_person==r.actor
        if sourced_actor:
            pronoun=if r.actor==listener: "you" else: "they"
            if fact.starts_with(a+" "): fact="{a} told me {pronoun} "+fact[a.len()+1..]
            else:
                if n.kind==.ditch: fact="{a} told me {if r.actor==listener: "your" else: "their"} aircraft came down {off_place}"
                else if n.kind==.fine: fact="{a} told me the {where} office fined {if r.actor==listener: "you" else: "them"}"
                else if n.kind==.rescue: fact="{a} told me the harbour boat brought {if r.actor==listener: "you" else: "them"} ashore at {where}"
                else if n.kind==.repair: fact="{a} told me the workshop at {where} attended to {if r.actor==listener: "your" else: "their"} aircraft"
        source=""
        if not firsthand and not sourced_victim and not sourced_actor:
            source=if n.source_person>=0 and n.source_person!=speaker: ", as {speech_object(w,n.source_person,speaker,listener)} told me" else: ", from an account brought to me"
        if n.confidence<600 and not firsthand: source+=", though I cannot vouch for it"
        dated=talk_when(w,n.occurred_minute)
        sentence=match voice:
            .salt: "{dated}, {off_place}: {fact}{source}."
            .shop: "The word at the counter for {dated}: {fact}{source}."
            .formal: "The report for {dated} says {fact}{source}."
            .guarded: "Keep the source in mind: {fact}, {dated}{source}."
            .anxious: "Word from {where}, {dated}: {fact}{source}."
            .warm: "There's news from {where}: {fact}, {dated}{source}."
            .wry: "Here's the quay's news for {dated}: {fact}{source}."
            .measured: "{fact}, {dated}{source}."
        sentence=upper(sentence[0..1])+sentence[1..]
        result.push(SpeechCandidate("news:{n.event}:fact",sentence,120+n.severity/10,n.event,n.source_person,n.confidence))
    result

job_candidates = (w: World, speaker: int) -> SpeechCandidate[]:
    result: SpeechCandidate[]
    loop job in w.active_jobs:
        j = w.jobs[job]
        if j.poster != speaker or j.state != .open: continue
        load = talk_load(w,j.good,j.quantity); dest = talk_place(w,j.destination); pay = talk_money(j.reward_cents)
        lines: str[]
        if j.delivery_mode == .foot:
            end = if j.drop_store == .boat: "my boat at the quay" else: "the doorstep I've marked"
            lines = ["Would you carry {load} from the warehouse to {end}? I can give you {pay}.","I've {load} to get to {end}. It's walking work. {pay}, if you've time.","My goods are waiting in the warehouse. {load}, for {end}. I'll pay {pay} to have them carried.","Are your hands free? I need {load} carried to {end}. There's {pay} in it."]
        else if j.purpose == .passenger:
            who = talk_name(w,j.passenger)
            lines = ["{who} needs passage to {dest}. {pay}, if you're going.","Could you take {who} over to {dest}? They need to be there by {talk_when(w,j.due_minute)}."]
        else:
            lines=[voice_offer(voice_of(w,speaker),load,dest,pay,talk_when(w,j.due_minute))]
        if j.provenance.cause!="":
            lines=[loop line in lines: line+" The order says: '"+j.provenance.cause+"'"]
        if job in w.maps.rewards:
            sheet = w.maps.copies[w.maps.rewards[job]].edition
            title = w.maps.editions[sheet].title
            lines = [loop line in lines: line+" Finish it and I'll give you my spare sheet, {title}. Collect it here afterwards."]
        loop k in 0..lines.len(): result.push(SpeechCandidate("work:{job}:{k}",lines[k],if j.context != "" and k == 0: 175 else: 150,job=job,ask=question(.work,"Can you take this work?",open_topic=.work)))
    result

trouble_candidates = (w: World, speaker: int, discreet: bool) -> SpeechCandidate[]:
    p = w.people[speaker]; result: SpeechCandidate[]
    here = talk_place(w,p.place)
    if p.injured_until > w.minute:
        result += _bank(["I've been told to rest until {talk_when(w,p.injured_until)}. I'd rather not tell the accident again.","They say I need rest until {talk_when(w,p.injured_until)}. {here}'s quay isn't going anywhere.","I won't be much use in {here} before {talk_when(w,p.injured_until)}. Ask the mechanic about the aircraft; leave me out of it."],"injury",155)
    loop id in p.obligations:
        if not (id in w.obligations): continue
        o = w.obligations[id]
        if o.debtor != speaker or (o.state != .open and o.state != .blocked) or o.due_minute > w.minute+360: continue
        lines: str[]
        if o.kind == .debt or o.kind == .rent:
            if not discreet:
                lines=[voice_privacy(voice_of(w,speaker),here)]
            else:
                who = if o.creditor >= 0: talk_name(w,o.creditor) else: "the harbour office"
                amount = talk_money(o.amount_cents)
                enough = w.accounts[p.account].cents >= o.amount_cents
                lines = if enough: ["I owe {who} {amount}. I have it; I still have to put it in their hand.","There's {amount} to settle with {who}. That needn't become a quarrel.","{who} is waiting for {amount}. I ought to see to it."] else: ["Between ourselves, I owe {who} {amount}. I haven't it.","{who} wants {amount}. I'm trying to find work before we have words.","There's a bill for {amount} with {who}. No use pretending the purse is fuller than it is.","I'd sleep more easily with {who}'s {amount} paid.","I need money, but not just any work. {who} is waiting on {amount}.","I know what I owe {who}. {amount}. Knowing it doesn't fill my pocket."]
        else if o.kind == .delivery:
            dest = talk_place(w,o.reason.destination)
            lines = ["I gave my word about a delivery to {dest}. It sits on my mind.","I've people waiting at {dest}. I'd sooner get on than explain why I'm still here.","There's a promise to keep at {dest}. That's the short of it."]
        else if o.kind == .repair:
            lines = ["The engine needs attention here at {here}. {talk_name(w,o.mechanic)} has the job.","I've a repair at {here} with {talk_name(w,o.mechanic)}. {talk_money(o.amount_cents)} on the bill.","I have to settle {talk_name(w,o.mechanic)}'s engine work at {here} before promising another flight."]
        loop k in 0..lines.len(): result.push(SpeechCandidate("trouble:{id}:{k}",lines[k],140,private=discreet))
    result

conversation_candidates = (w: World, speaker: int, listener: int, topic: TalkTopic, private: bool = false) -> SpeechCandidate[]:
    p = w.people[speaker]; voice = voice_of(w,speaker)
    count = w.speech.get(speaker,SpeechLedger()).acquaintance.get(listener,0)
    rel = w.relationship_index.get(RelationshipKey(speaker,listener),-1)
    close = rel >= 0 and w.relationships[rel].trust >= 650
    alone = true
    loop other in w.people:
        if other.id != speaker and other.id != listener and other.place == p.place and length(other.pose.pos-p.pose.pos) < 6: alone = false
    discreet = private and alone and close
    result: SpeechCandidate[]
    if p.far_home>=0 and topic!=.greeting and topic!=.farewell and topic!=.weather:
        return far_speech_candidates(w,speaker,listener,topic)
    match topic:
        .greeting:
            result = context_greeting(w,speaker,listener,voice,count > 0 or (rel >= 0 and w.relationships[rel].trust >= 500))
            if rel >= 0 and w.relationships[rel].grievance > 250:
                result = _bank(["We haven't settled what happened. Keep that in mind.","I know you. I haven't forgotten, either.","You and I still have something unsettled. A greeting doesn't put that right.","I'll hear you. Don't mistake that for forgiveness."],"grievance",170)
            if p.fatigue > 750:
                result += _bank(["{ctx_name(w,listener)}, say it slowly. I've lost the thread twice already.","{ctx_name(w,listener)}, come this side. I don't want to shout the same answer across the quay."],"tired-greeting",110)
        .work:
            result = job_candidates(w,speaker)+mission_speech_candidates(w,speaker)
            if result.len() == 0: result = work_referral_candidates(w,speaker,listener)
        .news: result = news_candidates(w,speaker,listener)
        .troubles:
            result = trouble_candidates(w,speaker,discreet)
            result += context_work(w,speaker)
        .weather: result = context_weather(w,speaker,voice)
        .market:
            loop belief in p.prices:
                if belief.good < 0 or belief.good >= w.goods.len() or belief.confidence < 300 or w.minute-belief.observed_minute > 4320: continue
                good = w.goods[belief.good].key; where = talk_place(w,belief.place)
                value = talk_money(belief.cents)
                lines = [voice_price(voice,good,value,where,talk_when(w,belief.observed_minute))]
                loop k in 0..lines.len(): result.push(SpeechCandidate("quote:{belief.place}:{belief.good}:{belief.observed_minute}:{k}",lines[k],105,source_person=belief.source_person,confidence=belief.confidence))
        .people:
            loop id in p.relationship_ids:
                r = w.relationships[id]; other = r.other
                if other == listener or other == speaker: continue
                name = talk_name(w,other)
                lines: str[]
                if r.grievance>250: lines=[voice_feud(voice,name)]
                else if r.affinity>=100: lines=[voice_friend(voice,name)]
                else: continue
                loop k in 0..lines.len(): result.push(SpeechCandidate("people:{other}:{k}",lines[k],105))
            if rel >= 0:
                loop memory in w.relationships[rel].memories:
                    lines: str[]
                    who=ctx_name(w,listener)
                    match memory.kind:
                        .delivery: lines=[voice_delivery(voice,who)]
                        .rescue: lines=[voice_rescue(voice,who)]
                        .late: lines=[voice_late(voice,who)]
                        .raid, .theft: lines=[voice_harm(voice,who)]
                        _: continue
                    loop k in 0..lines.len(): result.push(SpeechCandidate("memory:{memory.event}:{k}",lines[k],150,event=memory.event))
        .home: result = context_day(w,speaker,voice,listener)
        .music: result = context_music(w,speaker)
        .farewell: result = context_farewell(w,speaker,listener,voice)
    if topic == .home or topic == .people:
        loop child in w.households:
            if child.guardian != speaker: continue
            name = child.name
            lines = if voice == .salt: ["{name} is {child.age} now.","I've {name} to think of, as well as the boat.","A little of the evening belongs to {name}."] else: ["There's {name} to look after.","I ought to save a little of the evening for {name}.","Ask me about {name} and you'll get a longer answer than you bargained for.","{name} is {child.age} now."]
            result += _bank(lines,"family:{child.id}",108)
    if topic == .people or topic == .troubles:
        ids = w.stories.keys(); ids.sort()
        loop id in ids:
            story = w.stories[id]
            if not (speaker in story.actors) or story.outcome == "": continue
            lines: str[]
            if story.kind == .courtship and story.stage > 0 and discreet:
                other = if story.actors[0] == speaker: story.actors[1] else: story.actors[0]
                name = talk_name(w,other)
                lines = ["I find myself making time for {name}. Don't make a story of it yet.","Between ourselves, I've enjoyed those evenings with {name}.","I'd like to know {name} better. That is as much as I can tell you."]
            else if story.kind == .feud and not story.resolved:
                other = if story.actors[0] == speaker: story.actors[1] else: story.actors[0]
                name = talk_name(w,other)
                lines=[voice_feud(voice,name)]
            else if story.kind == .missing_boat and story.actors.len()>1 and story.actors[1] == speaker and not story.resolved:
                name = talk_name(w,story.actors[0])
                lines = ["{name}'s boat should have been back. I haven't heard why it isn't.","I'm waiting for word of {name}. Waiting is all I know to do just now."]
            loop k in 0..lines.len(): result.push(SpeechCandidate("story:{id}:{story.stage}:{k}",lines[k],135,private=story.kind == .courtship))
    loop k in 0..result.len():
        text = result[k].text
        if topic == .troubles and result[k].key.starts_with("trouble:") and not result[k].private: text = "{ctx_name(w,listener)}, "+ctx_after_name(text)
        if text != "": result[k].text = upper(text[0..1])+text[1..]
    result

# Read-only projection for UI layout/testing; it cannot consume a phrase or create acquaintance.
conversation_preview = (w: World, speaker: int, listener: int, topic: TalkTopic, private: bool = false) -> ConversationTurn:
    turn = ConversationTurn(speaker,listener,topic)
    if speaker < 0 or speaker >= w.people.len() or listener < 0 or listener >= w.people.len() or speaker == listener: turn.exhausted = true; return turn
    if not people_can_talk(w,speaker,listener): turn.exhausted = true; return turn
    ledger = w.speech.get(speaker,SpeechLedger())
    active_lines = 0
    loop line in ledger.recent:
        if w.minute-line.minute < SPEECH_RECENT_MINUTES: active_lines += 1
    # A persistent click storm reaches silence instead of evicting an unexpired utterance.
    if active_lines >= SPEECH_RECENT_LINES-1: turn.exhausted = true; return turn
    candidates = conversation_candidates(w,speaker,listener,topic,private)
    # An exhausted subject yields an honest refusal, then silence, never a fabricated new fact.
    if topic != .farewell: candidates += _bank([loop line in quiet_lines(voice_of(w,speaker)): "{ctx_name(w,listener)}, {ctx_after_name(line)}"],"quiet",-100)
    best = -1; score = -100000
    loop i in 0..candidates.len():
        c = candidates[i]; repeated = false
        loop old in ledger.recent:
            if w.minute-old.minute < SPEECH_RECENT_MINUTES and (old.key == c.key or old.text == c.text): repeated = true
        if repeated: continue
        noise = draw1000000(w.seed,110,speaker,ledger.sequence,i+int(topic)*1000)%50
        value = c.priority+noise
        if value > score: best = i; score = value
    if best < 0: turn.exhausted = true; return turn
    c = candidates[best]
    turn.question_kind = c.ask.kind
    turn.text = c.text; turn.source_event = c.event; turn.source_person = c.source_person
    turn.far_news=c.far_news; turn.commission=c.commission; turn.mission=c.mission
    turn.confidence = c.confidence; turn.private = c.private; turn.job = c.job
    turn

# Response labels are words the listener can say; presentation chooses how to lay them out.
conversation_replies = (text: str) -> ReplyOption[]: question_replies(question_details(text))

_guarded_converse = (w: mut World, speaker: int, listener: int, topic: TalkTopic, private: bool = false) -> ConversationTurn:
    turn = conversation_preview(w,speaker,listener,topic,private)
    if turn.text == "": return turn
    acquaintances.seed_relationship(w,speaker,listener)
    w.relationships[w.relationship_index[RelationshipKey(speaker,listener)]].last_contact_minute = w.minute
    if not (speaker in w.speech): w.speech[speaker] = SpeechLedger()
    ledger = w.speech[speaker]
    ledger.recent = [loop line in ledger.recent: if w.minute-line.minute < SPEECH_RECENT_MINUTES: line]
    previous_lines = ledger.recent
    candidates = conversation_candidates(w,speaker,listener,topic,private)
    if topic != .farewell: candidates += _bank([loop line in quiet_lines(voice_of(w,speaker)): "{ctx_name(w,listener)}, {ctx_after_name(line)}"],"quiet",-100)
    key = ""; detail = TalkQuestion(.none,"","")
    loop c in candidates:
        if c.text == turn.text: key = c.key; detail = c.ask; break
    ledger.recent.push(SpokenLine(key,turn.text,w.minute,listener,topic))
    # Preserve silence instead of publishing a partial journal entry.
    if not (ledger.recent.len() <= SPEECH_RECENT_LINES):
        living_fault("living_conversation.converse.0",guard_context(w)+" speaker={speaker} listener={listener} topic={topic} private={private}")
        return turn
    ledger.sequence += 1
    ledger.acquaintance[listener] = ledger.acquaintance.get(listener,0)+1
    ledger.last_contact[listener] = w.minute
    ledger.pending_question = ""; ledger.pending_listener = -1; ledger.pending_kind = .none; ledger.pending_echo = ""
    body_question = detail.kind != .none
    if not body_question and (topic == .greeting or ((topic == .home or topic == .news or topic == .music) and draw1000000(w.seed,111,speaker,ledger.sequence)%3 == 0)):
        questions = followup_questions(voice_of(w,speaker),topic)
        loop k in 0..questions.len():
            q = questions[(k+ledger.sequence)%questions.len()]
            used = false
            loop old in previous_lines:
                if w.minute-old.minute < SPEECH_RECENT_MINUTES and old.text == q.text: used = true
            if not used and turn.question == "": turn.question = q.text; detail = q
        if turn.question != "":
            turn.question_kind = detail.kind
            turn.replies = question_replies(detail,ledger.sequence)
            ledger.pending_kind = detail.kind; ledger.pending_echo = detail.echo; ledger.pending_open_topic = detail.open_topic
            ledger.pending_question = turn.question; ledger.pending_listener = listener; ledger.question_minute = w.minute
            ledger.recent.push(SpokenLine("question:{turn.question}",turn.question,w.minute,listener,topic))
            # Preserve silence instead of publishing a partial journal entry.
            if not (ledger.recent.len() <= SPEECH_RECENT_LINES):
                living_fault("living_conversation.converse.1",guard_context(w)+" speaker={speaker} listener={listener} topic={topic} private={private}")
                return turn
    if body_question:
        # The body already asked. Expose replies and a pending question without saying it twice.
        ledger.pending_question = turn.text; ledger.pending_listener = listener; ledger.question_minute = w.minute
        turn.question_kind = detail.kind
        turn.replies = question_replies(detail,ledger.sequence)
        ledger.pending_kind = detail.kind; ledger.pending_echo = detail.echo; ledger.pending_open_topic = detail.open_topic
    w.speech[speaker] = ledger
    if turn.far_news>=0: far_relay_report(w,speaker,listener,turn.far_news)
    if topic == .work and turn.job >= 0: remember_work_offer(w,listener,speaker,turn.job)
    # The listener actually heard this account/quote. Use the existing bounded transfer rules,
    # preserving occurrence/observation date and attribution; never query a hidden Event here.
    if turn.source_event >= 0:
        heard = w.people[speaker].news
        loop n in heard:
            if n.event == turn.source_event and not n.private_fact:
                knowledge.receive_person(w,listener,knowledge.retell(n,speaker,w.minute))
                break
    if topic == .market:
        quotes = w.people[speaker].prices
        loop quote in quotes:
            if not key.starts_with("quote:{quote.place}:{quote.good}:{quote.observed_minute}:"): continue
            next = quote; next.source_person = speaker; next.learned_minute = w.minute
            next.confidence = next.confidence*85/100
            knowledge.learn_price(w,listener,next)
            break
    turn

_guarded_answer_conversation = (w: mut World, speaker: int, listener: int, reply: TalkReply) -> ConversationTurn:
    turn = ConversationTurn(speaker,listener,.home)
    if not (speaker in w.speech) or listener < 0 or listener >= w.people.len(): turn.exhausted = true; return turn
    ledger = w.speech[speaker]
    if ledger.pending_listener != listener or ledger.pending_question == "" or w.minute-ledger.question_minute > 30: turn.exhausted = true; return turn
    if not people_can_talk(w,speaker,listener): turn.exhausted = true; return turn
    detail = if ledger.pending_kind == .none: question_details(ledger.pending_question) else: TalkQuestion(ledger.pending_kind,ledger.pending_question,ledger.pending_echo,ledger.pending_open_topic)
    ledger.pending_question = ""; ledger.pending_listener = -1; ledger.pending_kind = .none; ledger.pending_echo = ""
    w.speech[speaker] = ledger
    if detail.kind == .none: turn.exhausted = true; return turn
    if reply == .leave: return converse(w,speaker,listener,.farewell)
    voice = voice_of(w,speaker)
    lines: str[]
    if reply == .ask_back:
        lines = if w.people[speaker].far_home>=0: far_question_answer(w,speaker,detail) else: context_question_answer(w,speaker,detail)
        if lines.len() == 0: return converse(w,speaker,listener,if detail.kind == .business: TalkTopic.home else: detail.open_topic)
    else if reply == .open_topic:
        return converse(w,speaker,listener,if detail.kind == .work: TalkTopic.home else: detail.open_topic)
    else if reply == .reassure and detail.kind == .business:
        return converse(w,speaker,listener,.work)
    else:
        lines = context_reply(w,speaker,listener,detail,reply)
    # Use the same no-repeat journal as spoken topics, without changing any money or promises.
    existing = w.speech[speaker]
    existing.recent = [loop line in existing.recent: if w.minute-line.minute < SPEECH_RECENT_MINUTES: line]
    if existing.recent.len() >= SPEECH_RECENT_LINES: turn.exhausted = true; return turn
    chosen = -1
    loop k in 0..lines.len():
        i = (k+speaker+existing.sequence)%lines.len()
        repeated = false
        loop old in existing.recent:
            if w.minute-old.minute < SPEECH_RECENT_MINUTES and old.text == lines[i]: repeated = true
        if not repeated and chosen < 0: chosen = i
    if chosen < 0: turn.exhausted = true; return turn
    turn.text = lines[chosen]
    existing.recent.push(SpokenLine("reply:{detail.kind}:{reply}:{chosen}",turn.text,w.minute,listener,.home))
    # Preserve silence instead of publishing a partial journal entry.
    if not (existing.recent.len() <= SPEECH_RECENT_LINES):
        living_fault("living_conversation.answer_conversation.2",guard_context(w)+" speaker={speaker} listener={listener} reply={reply}")
        return turn
    existing.sequence += 1
    rel = w.relationship_index.get(RelationshipKey(speaker,listener),-1)
    if rel >= 0 and w.minute-existing.last_reply_minute >= 360:
        delta = if reply == .reassure: 2 else: if reply == .tease and voice != .wry and voice != .warm: -2 else: 0
        w.relationships[rel].affinity = clamp(w.relationships[rel].affinity+delta,-1000,1000)
        existing.last_reply_minute = w.minute
    w.speech[speaker] = existing
    turn


# Offered IDs are a person's own live commissions or an explicit dated referral they heard.
person_work_offers = (w: World, speaker: int, listener: int) -> WorkOffer[]:
    if speaker < 0 or speaker >= w.people.len() or listener < 0 or listener >= w.people.len(): return []
    if not people_can_talk(w,speaker,listener): return []
    result: WorkOffer[]
    mission_ids=w.war.missions.keys(); mission_ids.sort()
    loop id in mission_ids:
        m=w.war.missions[id]
        if m.poster==speaker and m.state==.open and w.minute<=m.deadline:
            result.push(WorkOffer(-1,speaker,true,speaker,w.minute,m.why,mission=id,commission=m.commission))
    commission_ids=w.far.commissions.keys(); commission_ids.sort()
    loop id in commission_ids:
        c=w.far.commissions[id]
        if c.poster==speaker and c.phase==.open and w.minute<=c.deadline:
            result.push(WorkOffer(-1,speaker,true,speaker,w.minute,c.why,commission=id))
    loop id in w.active_jobs:
        j = w.jobs[id]
        if j.poster == speaker and j.state == .open:
            result.push(WorkOffer(id,speaker,true,speaker,w.minute,"{talk_load(w,j.good,j.quantity)} to {talk_place(w,j.destination)}; {talk_money(j.reward_cents)}"))
    loop lead in w.speech.get(speaker,SpeechLedger()).work_leads:
        if lead.poster == speaker or lead.poster == listener or w.minute-lead.heard_minute >= 4320 or not (lead.job in w.jobs): continue
        result.push(WorkOffer(lead.job,lead.poster,false,lead.source_person,lead.heard_minute,"{talk_name(w,lead.poster)}'s offer, heard {talk_when(w,lead.heard_minute)}"))
    result

work_referral_candidates = (w: World, speaker: int, listener: int) -> SpeechCandidate[]:
    result: SpeechCandidate[]; name = ctx_name(w,listener)
    loop lead in w.speech.get(speaker,SpeechLedger()).work_leads:
        if lead.poster == speaker or lead.poster == listener or w.minute-lead.heard_minute >= 4320 or not (lead.job in w.jobs): continue
        who = talk_name(w,lead.poster); source = talk_name(w,lead.source_person)
        load = talk_load(w,lead.good,lead.quantity); where = talk_place(w,lead.destination)
        dated = talk_when(w,lead.heard_minute)
        # These are quoted terms, not today's remote live stock/status from a board lookup.
        text = if lead.source_person == lead.poster: "{who} asked about carrying {load} to {where} when we spoke. That was {dated}; the offer was {talk_money(lead.reward_cents)}. Ask them; somebody may have taken it." else: "{source} told me {who} wanted {load} carried to {where}. That was {dated}. I haven't promised anything on their behalf."
        result.push(SpeechCandidate("work-lead:{lead.job}:{lead.heard_minute}",text,140,source_person=lead.source_person,confidence=850,job=lead.job))
    if result.len()>0: return result
    lines = match voice_of(w,speaker):
        .salt: ["Nothing of mine to carry, {name}. I won't put you to work on somebody else's promise.","No paid errand for you from me, {name}. Ask the people whose names are on the board.","Not from me, {name}. I've no unclaimed load to offer you."]
        .warm: ["Nothing I can offer you, {name}. I'd tell you if there were.","I haven't an errand to pay you for, {name}. You could try the notices at the quay.","No work from me just now, {name}. Ask me again when you're passing."]
        .formal: ["I have no commission for you, {name}. The public board lists other people's offers.","None from me, {name}. For a posted offer, speak to the person who signed it.","I have nothing to employ you on, {name}. I cannot answer for the other notices."]
        .guarded: ["No work for you from me, {name}. That's all I can answer for.","Not from me, {name}. Other people's business is theirs.","I've no job to offer you, {name}. Don't put my name to somebody else's."]
        .wry: ["Nothing I'm paying for, {name}. A suggestion is cheaper than a job; try the notices.","I've no unclaimed load for you, {name}. I'd rather say no than offer you someone else's money.","No paid errand of mine, {name}. If I find one, you'll hear terms before you hear yes."]
        _: ["I've no work to offer, {name}. I can't promise what other people need.","Nothing of mine needs a carrier just now, {name}. Try asking at the quay notices.","No commission from me, {name}. Ask again when you've finished your next crossing."]
    ctx_bank(lines,"no-own-work")


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
converse = (w: mut World, speaker: int, listener: int, topic: TalkTopic, private: bool = false) -> ConversationTurn:
    if guard_blocked(): return ConversationTurn(speaker,listener,topic,exhausted=true)
    scope = guard_begin(w)
    result = _guarded_converse(w,speaker,listener,topic,private)
    failed = guard_failed(scope)
    guard_finish(w,scope)
    if failed: ConversationTurn(speaker,listener,topic,exhausted=true) else: result

answer_conversation = (w: mut World, speaker: int, listener: int, reply: TalkReply) -> ConversationTurn:
    if guard_blocked(): return ConversationTurn(speaker,listener,.home,exhausted=true)
    scope = guard_begin(w)
    result = _guarded_answer_conversation(w,speaker,listener,reply)
    failed = guard_failed(scope)
    guard_finish(w,scope)
    if failed: ConversationTurn(speaker,listener,.home,exhausted=true) else: result
