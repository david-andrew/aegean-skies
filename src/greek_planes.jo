# Aircraft of the Greek naval air service, built to their own layouts with the racer kit
# (racer_planes.jo rk_*): same frame and style as planes.jo (forward -z, right +x, up +y, metres,
# the origin near the centre of gravity), the seven damage bins (0 body, 1 engine, 2 left wings,
# 3 right wings, 4 left float, 5 right float, 6 tail). Flight, sound and size come from their
# AIRCRAFT profiles (aircraft_catalog.jo).
#   Blackburn T.3 Velos (1925)   the Dart's twin-float two-seater for the Greek navy (four from
#                                Brough, twelve built at Palaion Faliro): a big two-bay biplane, a
#                                Napier Lion behind a nose radiator, the observer's raised cockpit
#                                with a Lewis gun, a torpedo slung between the floats
#   Fairey IIIF (1931)           the naval-cooperation biplane the Greek navy flew on twin floats
#                                from Phaleron Bay to 1941: a metal-skinned fuselage round a Napier
#                                Lion XIA in a pointed cowl, a belly radiator, two-bay wings, the
#                                tall Fairey rudder, observer and gunner behind the pilot
# Markings from the livery (markings.jo): on the Greek naval livery the Greek roundel on the wings
# and fuselage and blue-white-blue stripes on the rudder; repainted, whatever the Paint page sets.
use 'planes.jo'
use 'racer_planes.jo'
from 'markings.jo' import INSIGNIA

is_greek_service = (kind: Craft) -> bool: kind == .blackburn_velos or kind == .fairey_iiif

# Wing-tip strike points, one pair per wing (upper, lower).
greek_wing_contacts = (kind: Craft) -> vec3[]:
    match kind:
        .blackburn_velos: [vec3(-7.35, 1.6, -0.9), vec3(7.35, 1.6, -0.9), vec3(-7.1, -0.5, -0.6), vec3(7.1, -0.5, -0.6)]
        _: [vec3(-6.95, 1.52, -0.75), vec3(6.95, 1.52, -0.75), vec3(-6.6, -0.58, -0.5), vec3(6.6, -0.58, -0.5)]

# The livery's insignia (markings.jo: the Greek roundel on the Greek naval livery) on a face of any
# orientation: the wings' undersides and the fuselage's sides (kit_wing_mark draws the upper wings).
# `up` is the face's normal. Ring insignia only; a star or a cross is left to the upper wings.
GREEK_BLUE = rgb(0.26, 0.47, 0.78)
greek_side_mark = (vs: mut Vertex3D[], c: vec3, radius: f64, up: vec3, lv: Livery):
    ins = INSIGNIA[livery_insignia(lv)]
    if ins.shape != 0 or ins.colours.len() == 0: return
    a0 = if abs(f64(up.y)) > 0.5: vec3(1, 0, 0) else: vec3(0, 1, 0)
    b0 = normalize(cross(up, a0)); a1 = normalize(cross(b0, up))
    n = ins.colours.len()
    lift = up * 0.004
    loop band in 0..n:
        r0 = radius * f64(n - band) / f64(n); r1 = radius * f64(n - 1 - band) / f64(n)
        loop j in 0..16:
            t0 = TAU * f64(j) / 16.0; t1 = TAU * f64(j + 1) / 16.0
            p0 = c + lift + (a1 * f32(cos(t0)) + b0 * f32(sin(t0))) * f32(r0)
            p1 = c + lift + (a1 * f32(cos(t1)) + b0 * f32(sin(t1))) * f32(r0)
            if band == n - 1: rk_tri(vs, c + lift, p0, p1, ins.colours[band])
            else:
                q0 = c + lift + (a1 * f32(cos(t0)) + b0 * f32(sin(t0))) * f32(r1)
                q1 = c + lift + (a1 * f32(cos(t1)) + b0 * f32(sin(t1))) * f32(r1)
                rk_quad(vs, p0, q0, q1, p1, ins.colours[band])

_greek_rudder = [GREEK_BLUE, rgb(0.95, 0.94, 0.9), GREEK_BLUE]

build_greek = (kind: Craft, lv: Livery) -> CraftModel:
    if kind == .blackburn_velos: _build_velos(lv) else: _build_iiif(lv)

# Two-bay biplane wings on both sides: upper and lower panels, the roundels, interplane struts in
# two bays, flying and landing wires, and the cabane to the upper centre section.
_bay_wings = (bins: mut Vertex3D[][], lv: Livery, upper_y: f64, lower_y: f64, upper_z: f64, lower_z: f64, half_up: f64, half_low: f64, chord: f64, thick: f64, bays: f64[], root_low: f64):
    metal = rgb(0.4, 0.41, 0.41); wire = rgb(0.17, 0.17, 0.17)
    strut = vec4(lv.wing.x * 0.82, lv.wing.y * 0.82, lv.wing.z * 0.8, 1)
    st = rk_plain_stations(lv.wing, lv.wing, lv.wing, 0.92)
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        rk_wing_half(bins[id], side, vec3(side * 0.05, upper_y, upper_z), half_up, chord, thick, st, 0.0)
        rk_wing_half(bins[id], side, vec3(side * root_low, lower_y, lower_z), half_low - root_low, chord, thick, st, 0.02)
        kit_wing_mark(bins[id], vec3(f32(side * half_up * 0.72), f32(upper_y + thick * 0.95 + 0.004), f32(upper_z)), lv, chord * 0.36)
        greek_side_mark(bins[id], vec3(side * half_low * 0.72, lower_y + (half_low * 0.72 - root_low) * 0.02 - thick * 0.4, lower_z), chord * 0.36, vec3(0, -1, 0), lv)
        loop x in bays:
            loop dz in [-0.32, 0.32]:
                rk_blade(bins[id], vec3(side * x, lower_y + x * 0.02 + 0.05, lower_z + dz * chord), vec3(side * x, upper_y - 0.03, upper_z + dz * chord), 0.025, 0.05, strut)
        inner = bays[0]; outer = bays[bays.len() - 1]
        rk_strut(bins[id], vec3(side * root_low, lower_y + 0.05, lower_z - chord * 0.25), vec3(side * inner, upper_y, upper_z - chord * 0.25), 0.008, wire)
        rk_strut(bins[id], vec3(side * inner, lower_y + 0.05, lower_z - chord * 0.25), vec3(side * outer, upper_y, upper_z - chord * 0.25), 0.008, wire)
        rk_strut(bins[id], vec3(side * 0.5, upper_y, upper_z - chord * 0.25), vec3(side * inner, lower_y + 0.05, lower_z - chord * 0.25), 0.008, wire)
        loop dz in [-0.3, 0.25]:
            rk_blade(bins[id], vec3(side * 0.32, 0.55, upper_z + dz * chord), vec3(side * 0.45, upper_y - 0.03, upper_z + dz * chord), 0.02, 0.04, metal)

# Twin floats on N-struts with a spreader, their bottoms at the given contacts' depth.
_twin_floats = (bins: mut Vertex3D[][], lv: Livery, fx: f64, fy: f64, length: f64, hw: f64, zc: f64, step: f64, lower_y: f64):
    metal = rgb(0.4, 0.41, 0.41)
    bands = RkBands(lv.body, lv.body, lv.body, lv.trim)
    l = length
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        x = side * fx
        rk_hull(bins[id], [RkRing(zc - l * 0.5, 0.0, 0.0, 0.0, 0.0, fy + 0.12), RkRing(zc - l * 0.44, hw * 0.55, hw * 0.6, hw * 0.4, 0.04, fy + 0.06),
            RkRing(zc - l * 0.3, hw * 0.92, hw, hw * 0.92, 0.07, fy), RkRing(step - 0.02, hw, hw, hw, 0.08, fy), RkRing(step + 0.02, hw * 0.98, hw, hw * 0.6, 0.04, fy),
            RkRing(zc + l * 0.3, hw * 0.65, hw * 0.75, hw * 0.35, 0.02, fy + 0.06), RkRing(zc + l * 0.5, 0.0, 0.0, 0.0, 0.0, fy + 0.15)], bands, x)
        top = fy + hw * 0.95
        loop z in [step - 1.6, step + 0.3]:
            rk_blade(bins[id], vec3(x, top, z), vec3(side * 0.42, lower_y, z + 0.1), 0.03, 0.08, metal)
        rk_blade(bins[id], vec3(x, top, step + 0.3), vec3(side * 0.42, lower_y, step - 1.5), 0.025, 0.06, metal)
        rk_strut(bins[id], vec3(x, top + 0.1, step - 0.6), vec3(0, top + 0.45, step - 0.6), 0.03, metal)

# ---------------- Blackburn T.3 Velos ----------------

_build_velos = (lv: Livery) -> CraftModel:
    bins = rk_bins()
    metal = rgb(0.45, 0.46, 0.46); dark = rgb(0.13, 0.13, 0.12)
    # The Dart's deep, slab-sided fuselage: the Lion's nose, the pilot under the upper wing's
    # trailing edge, the observer raised behind; the rear tapering to a tall fin.
    nose = [RkStation(-4.05, 0.42, 0.42, 0.5, 0.05), RkStation(-3.3, 0.55, 0.6, 0.65, 0.05), RkStation(-2.0, 0.57, 0.64, 0.7, 0.04)]
    body = [RkStation(-2.0, 0.57, 0.64, 0.7, 0.04), RkStation(0.4, 0.55, 0.66, 0.66, 0.06), RkStation(2.4, 0.42, 0.62, 0.48, 0.1), RkStation(3.8, 0.3, 0.5, 0.32, 0.16)]
    tail = [RkStation(3.8, 0.3, 0.5, 0.32, 0.16), RkStation(6.45, 0.05, 0.16, 0.06, 0.32)]
    # (the Lion's cowling and cylinder banks in the navy's blue: the livery's accent, deepened)
    cowl = vec4(lv.accent.x * 0.75, lv.accent.y * 0.75, lv.accent.z * 0.8, 1)
    rk_spindle(bins[1], nose, cowl, cowl, 8)
    rk_spindle(bins[0], body, lv.body, lv.body, 8)
    rk_spindle(bins[6], tail, lv.body, lv.body, 8)
    # (the nose radiator, its honeycomb face, and the Lion's three banks of cylinders on top)
    rk_box(bins[1], vec3(0, -0.12, -4.08), vec3(0.42, 0.45, 0.04), rgb(0.24, 0.24, 0.22))
    loop j in 0..7: rk_box(bins[1], vec3(0, f32(-0.5 + f64(j) * 0.12), -4.13), vec3(0.41, 0.008, 0.01), metal)
    loop k in [-1.0, 0.0, 1.0]:
        rk_box(bins[1], vec3(0, 0, 0), vec3(0.1, 0.1, 0.8), cowl, translation(vec3(f32(k * 0.32), f32(0.6 + (1.0 - abs(k)) * 0.06), -2.85)) * rotation_z(-k * 0.55))
        loop j in 0..4: rk_box(bins[1], vec3(f32(k * 0.36), f32(0.7 - abs(k) * 0.08), f32(-3.4 + f64(j) * 0.38)), vec3(0.05, 0.035, 0.05), dark)
    rk_spindle(bins[1], [RkStation(-4.42, 0.0, 0.0, 0.0, 0.18), RkStation(-4.22, 0.14, 0.14, 0.14, 0.18), RkStation(-4.1, 0.18, 0.18, 0.18, 0.18)], dark, dark, 8)
    # The cockpits: the pilot's under the trailing edge, the observer's raised, with a gun ring.
    pilot = vec3(0, 0.67, 0.55)
    rk_racer_cockpit(bins[0], pilot, lv, 0.36, 0.0, 0.0)
    obs = vec3(0, 0.75, 1.95)
    rk_box(bins[0], obs - vec3(0, 0.05, 0), vec3(0.42, 0.06, 0.5), lv.body)
    rk_racer_cockpit(bins[0], obs, lv, 0.36, 0.0, 0.0)
    loop j in 0..12:
        a = TAU * f64(j) / 12.0; b = TAU * f64(j + 1) / 12.0
        rk_strut(bins[0], obs + vec3(f32(cos(a) * 0.48), 0.06, f32(sin(a) * 0.48)), obs + vec3(f32(cos(b) * 0.48), 0.06, f32(sin(b) * 0.48)), 0.03, dark)
    rk_strut(bins[0], obs + vec3(0, 0.1, 0.3), obs + vec3(0, 0.45, -0.7), 0.035, dark)
    greek_side_mark(bins[0], vec3(0.6, 0.15, 3.0), 0.36, vec3(1, 0, 0), lv)
    greek_side_mark(bins[0], vec3(-0.6, 0.15, 3.0), 0.36, vec3(-1, 0, 0), lv)
    # Two big equal wings of two bays, the upper staggered a little ahead.
    _bay_wings(bins, lv, 1.55, -0.55, -0.85, -0.6, 7.39, 7.15, 2.06, 0.17, [3.1, 6.0], 0.55)
    # Tail: a tall fin and the rudder in Greek stripes; a braced tailplane.
    rk_box(bins[6], vec3(0, 1.0, 5.75), vec3(0.05, 0.62, 0.55), lv.body)
    kit_rudder(bins[6], vec3(0, 0.95, 6.5), vec3(0.03, 0.75, 0.3), lv, _greek_rudder)
    tail_st = rk_plain_stations(lv.wing, lv.wing, lv.wing, 0.7)
    loop side in [-1.0, 1.0]:
        rk_wing_half(bins[6], side, vec3(0, 0.38, 5.65), 2.3, 1.2, 0.08, tail_st)
        rk_strut(bins[6], vec3(side * 0.25, 0.05, 5.0), vec3(side * 1.2, 0.36, 5.6), 0.018, metal)
    # Twin floats; the torpedo on its crutches between them.
    _twin_floats(bins, lv, 1.65, -2.38, 7.7, 0.44, -0.2, 0.1, -0.62)
    add_cylinder(bins[0], vec3(0, 0, 0), 0.23, 4.8, rgb(0.3, 0.32, 0.3), 10, 0.23, translation(vec3(0, -1.15, -2.6)) * rotation_x(PI / 2))
    add_cylinder(bins[0], vec3(0, 0, 0), 0.23, 0.45, rgb(0.55, 0.5, 0.35), 10, 0.0, translation(vec3(0, -1.15, -2.6)) * rotation_x(-PI / 2))
    loop z in [-1.6, 0.8]: rk_strut(bins[0], vec3(0, -0.68, f32(z)), vec3(0, -0.95, f32(z)), 0.03, metal)
    hub = vec3(0, 0.18, -4.3)
    contacts = [vec3(-1.65, -2.76, -3.2), vec3(1.65, -2.76, -3.2), vec3(-1.65, -2.86, 0.1), vec3(1.65, -2.86, 0.1), vec3(-1.65, -2.58, 2.8), vec3(1.65, -2.58, 2.8)]
    shade = [vec3(0, 0, 0.5), vec3(0.57, 0.6, 4.6), vec3(0, 1.55, -0.85), vec3(7.39, 0.09, 1.03), vec3(0, -0.55, -0.6), vec3(7.15, 0.09, 1.03),
        vec3(-1.65, -2.38, -0.2), vec3(0.44, 0.44, 3.85), vec3(1.65, -2.38, -0.2), vec3(0.44, 0.44, 3.85), vec3(0, 0.38, 5.65), vec3(2.3, 0.04, 0.6)]
    m = rk_finish(.blackburn_velos, bins, build_prop(1.45, 2), hub, contacts, pilot + vec3(0, 0.4, 0), vec3(1.65, -1.9, -0.2), shade, 1.45, 2)
    m.cockpits = [pilot + vec3(0, 0.4, 0), obs + vec3(0, 0.4, 0)]
    m

# ---------------- Fairey IIIF ----------------

_build_iiif = (lv: Livery) -> CraftModel:
    bins = rk_bins()
    metal = rgb(0.5, 0.51, 0.51); dark = rgb(0.13, 0.13, 0.12)
    cowl = vec4(lv.body.x * 0.9, lv.body.y * 0.9, lv.body.z * 0.92, 1)
    # A slimmer, metal-skinned fuselage: the Lion XIA in a long pointed cowl, the radiator under
    # the belly, pilot, observer and gunner in a long cockpit run behind the upper wing.
    nose = [RkStation(-4.15, 0.24, 0.26, 0.26, 0.1), RkStation(-3.4, 0.47, 0.55, 0.55, 0.05), RkStation(-2.0, 0.52, 0.6, 0.62, 0.02)]
    body = [RkStation(-2.0, 0.52, 0.6, 0.62, 0.02), RkStation(0.6, 0.5, 0.62, 0.6, 0.04), RkStation(2.6, 0.38, 0.55, 0.42, 0.1), RkStation(3.9, 0.27, 0.45, 0.28, 0.16)]
    tail = [RkStation(3.9, 0.27, 0.45, 0.28, 0.16), RkStation(6.55, 0.04, 0.14, 0.05, 0.3)]
    rk_spindle(bins[1], nose, cowl, cowl, 10)
    rk_spindle(bins[0], body, lv.body, lv.body, 10)
    rk_spindle(bins[6], tail, lv.body, lv.body, 10)
    rk_spindle(bins[1], [RkStation(-4.62, 0.0, 0.0, 0.0, 0.12), RkStation(-4.38, 0.15, 0.15, 0.15, 0.12), RkStation(-4.18, 0.24, 0.24, 0.24, 0.12)], lv.trim, lv.trim, 10)
    loop k in [-1.0, 1.0]:
        loop j in 0..4: rk_box(bins[1], vec3(f32(k * 0.5), 0.32, f32(-3.3 + f64(j) * 0.36)), vec3(0.05, 0.03, 0.05), dark)
    # (the radiator in its fairing under the belly)
    rk_box(bins[1], vec3(0, -0.72, -2.4), vec3(0.32, 0.16, 0.42), rgb(0.26, 0.26, 0.24))
    loop j in 0..6: rk_box(bins[1], vec3(f32(-0.27 + f64(j) * 0.11), -0.72, -2.84), vec3(0.008, 0.15, 0.01), metal)
    pilot = vec3(0, 0.63, 0.25)
    rk_racer_cockpit(bins[0], pilot, lv, 0.34, 0.0, 0.0)
    obs = vec3(0, 0.62, 1.65)
    rk_box(bins[0], obs + vec3(0, -0.01, 0.15), vec3(0.32, 0.02, 0.62), rgb(0.11, 0.1, 0.09))
    loop j in 0..12:
        a = TAU * f64(j) / 12.0; b = TAU * f64(j + 1) / 12.0
        rk_strut(bins[0], obs + vec3(f32(cos(a) * 0.45), 0.05, f32(0.35 + sin(a) * 0.45)), obs + vec3(f32(cos(b) * 0.45), 0.05, f32(0.35 + sin(b) * 0.45)), 0.03, dark)
    rk_strut(bins[0], obs + vec3(0, 0.1, 0.6), obs + vec3(0, 0.42, -0.3), 0.032, dark)
    greek_side_mark(bins[0], vec3(0.55, 0.12, 3.1), 0.33, vec3(1, 0, 0), lv)
    greek_side_mark(bins[0], vec3(-0.55, 0.12, 3.1), 0.33, vec3(-1, 0, 0), lv)
    # Two-bay wings, the lower a little shorter, the upper staggered ahead.
    _bay_wings(bins, lv, 1.5, -0.6, -0.75, -0.45, 6.97, 6.62, 1.48, 0.15, [2.8, 5.5], 0.5)
    # Tail: the tall Fairey fin and rudder, the rudder reaching below the fuselage, Greek stripes.
    rk_box(bins[6], vec3(0, 0.95, 5.9), vec3(0.045, 0.55, 0.42), lv.body)
    kit_rudder(bins[6], vec3(0, 0.8, 6.5), vec3(0.03, 0.85, 0.275), lv, _greek_rudder)
    tail_st = rk_plain_stations(lv.wing, lv.wing, lv.wing, 0.7)
    loop side in [-1.0, 1.0]:
        rk_wing_half(bins[6], side, vec3(0, 0.35, 5.85), 2.0, 1.0, 0.07, tail_st)
        rk_strut(bins[6], vec3(side * 0.2, 0.05, 5.3), vec3(side * 1.0, 0.33, 5.8), 0.016, metal)
    _twin_floats(bins, lv, 1.55, -2.3, 7.1, 0.4, -0.3, 0.05, -0.66)
    hub = vec3(0, 0.12, -4.5)
    contacts = [vec3(-1.55, -2.66, -3.0), vec3(1.55, -2.66, -3.0), vec3(-1.55, -2.78, 0.05), vec3(1.55, -2.78, 0.05), vec3(-1.55, -2.5, 2.6), vec3(1.55, -2.5, 2.6)]
    shade = [vec3(0, 0, 0.5), vec3(0.52, 0.6, 4.6), vec3(0, 1.5, -0.75), vec3(6.97, 0.08, 0.74), vec3(0, -0.6, -0.45), vec3(6.62, 0.08, 0.74),
        vec3(-1.55, -2.3, -0.3), vec3(0.4, 0.4, 3.55), vec3(1.55, -2.3, -0.3), vec3(0.4, 0.4, 3.55), vec3(0, 0.35, 5.85), vec3(2.0, 0.04, 0.5)]
    m = rk_finish(.fairey_iiif, bins, rk_metal_prop(1.45, 2), hub, contacts, pilot + vec3(0, 0.4, 0), vec3(1.55, -1.85, -0.3), shade, 1.45, 2)
    m.cockpits = [pilot + vec3(0, 0.4, 0), obs + vec3(0, 0.4, 0)]
    m
