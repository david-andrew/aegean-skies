use 'world_point.jo'
# Lightning: one deterministic schedule per saved storm, shared by what is seen
# (the bolts, the flash lighting the cloud from inside, the sky's flash) and
# what is heard (thunder, delayed by the distance at the speed of sound). Pure
# functions of the storm's identity, its place and the world clock: no random
# draws, nothing saved, nothing done to the simulation.
import 'living_types.jo' as lt
import 'living_conditions.jo' as conditions

# Each storm's time is cut into slots; most slots hold one strike.
const LIGHTNING_SLOT = 5.5
# The strike's channel lasts this long (seconds), its return strokes within it.
const LIGHTNING_LIFE = 0.55

struct Strike:
    key: int = -1                  # storm id and slot; -1 none
    time = 0.0                     # world seconds of the first return stroke
    center = WorldPoint(0,0,0)     # where the channel meets the cloud base (or its middle, in cloud)
    ground = true                  # cloud to ground, or within the cloud
    heading = 0.0                  # an in-cloud channel's direction
    reach: f32 = 0.0               # an in-cloud channel's length (m)
    weight: f32 = 0.0              # the storm's strength there

lightning_rand = (a: int, b: f64, k: int) -> f64:
    x = sin(f64(a)*12.9898+b*78.233+f64(k)*37.719)*43758.5453
    x-floor(x)

# A thunderstorm is a system tens of kilometres across (cloud_field.jo draws it):
# a dark deck, a shelf cloud along its leading edge, a canopy aloft, and four
# embedded cells at different stages, each with its rain shaft beneath. Their
# places, in the system's frame turned downwind, are shared by the cells, the
# shafts (weather kind 8 in cloud_volume.jo) and where lightning strikes.
struct StormCell:
    offset = vec2(0,0)             # from the system's centre (m, world x and z)
    half_width = 0.0               # the cell's form half-width (m)
    stage = 0                      # 0 towering, 1 mature with an anvil, 2 dissipating
# (in the shafts layer's box units; weather kind 8 in cloud_volume.jo holds the same)
const STORM_CELL_AT = [vec2(-0.29,0.09),vec2(0.11,-0.24),vec2(0.35,0.22),vec2(-0.07,0.42)]

# Which way the system drifts (its winds carry it): the angle of +x in its frame.
storm_downwind = (cell: lt.Weather) -> f64:
    w = cell.wind_milli_m_per_sec
    if abs(w.x)+abs(w.y) < 1: return 0.0
    atan2(f64(w.y),f64(w.x))

# The shafts layer's box (m): the system's ellipse as every weather layer frames it.
storm_box = (cell: lt.Weather) -> vec2: vec2(f32(cell.radius_m)*cell.aspect.x/0.83,f32(cell.radius_m)*cell.aspect.y/0.64)

storm_cells = (cell: lt.Weather) -> StormCell[]:
    out: StormCell[]
    box = storm_box(cell)
    a = storm_downwind(cell)
    yaw = vec2(f32(cos(a)),f32(sin(a)))
    size = clamp(f64(cell.radius_m)*0.42,3500.0,7000.0)
    loop k in 0..4:
        at = STORM_CELL_AT[k]*box
        # (the layers' local frame: x along yaw, z across; as cloud_to_world)
        offset = vec2(at.x*yaw.x-at.y*yaw.y,at.x*yaw.y+at.y*yaw.x)
        stage = (k+cell.id)%3
        out.push(StormCell(offset,size*[1.0,0.8,0.9,0.7][k],if k == 0: 1 else: stage))
    out

# The strike of a storm's slot, if the slot holds one.
lightning_slot_strike = (cell: lt.Weather, slot: f64) -> Strike:
    if lightning_rand(cell.id,slot,1) > 0.8: return Strike()
    time = slot*LIGHTNING_SLOT-f64(cell.id)*7.13+0.4+lightning_rand(cell.id,slot,2)*(LIGHTNING_SLOT-1.2)
    # (world seconds are ticks/60, as weather_seconds and the ambience clock)
    minute = time*60.0/f64(lt.TICKS_PER_MINUTE)
    weight = conditions.weather_weight(cell,minute,vec3(0,0,0)+world_vec(conditions.weather_center(cell,minute)))
    if weight <= 0.0: return Strike()
    c = conditions.weather_center(cell,minute)
    # Under one of the system's cells, more often near its core.
    cells = storm_cells(cell)
    under = cells[int(lightning_rand(cell.id,slot,8)*4.0)%4]
    r = under.half_width*0.45*sqrt(lightning_rand(cell.id,slot,3))
    a = lightning_rand(cell.id,slot,4)*TAU
    ground = lightning_rand(cell.id,slot,5) < 0.45
    Strike(key=cell.id*100000+int(slot)%100000,time=time,center=WorldPoint(c.x+f64(under.offset.x)+r*cos(a),0,c.z+f64(under.offset.y)+r*sin(a)),ground=ground,heading=lightning_rand(cell.id,slot,6)*TAU,reach=f32(2500.0+lightning_rand(cell.id,slot,7)*4500.0),weight=weight)

# The strike of a storm alight at `seconds` (or Strike() between strikes).
lightning_strike_at = (cell: lt.Weather, seconds: f64) -> Strike:
    if cell.kind != .storm: return Strike()
    slot = floor((seconds+f64(cell.id)*7.13)/LIGHTNING_SLOT)
    loop k in [0.0,-1.0]:
        s = lightning_slot_strike(cell,slot+k)
        if s.key >= 0 and seconds >= s.time and seconds < s.time+LIGHTNING_LIFE: return s
    Strike()

# The strikes of every storm whose first stroke falls in (from, to].
lightning_strikes_between = (cells: lt.Weather[], from: f64, to: f64) -> Strike[]:
    out: Strike[]
    if to <= from: return out
    loop cell in cells:
        if cell.kind != .storm: continue
        first = floor((from+f64(cell.id)*7.13)/LIGHTNING_SLOT)
        last = floor((to+f64(cell.id)*7.13)/LIGHTNING_SLOT)
        slot = first
        loop k in 0..100000:
            if slot > last: break
            s = lightning_slot_strike(cell,slot)
            if s.key >= 0 and s.time > from and s.time <= to: out.push(s)
            slot += 1.0
    out

# The channel's light `age` seconds after the first stroke: three or four
# return strokes down the same channel, each a sharp flash and a quick decay.
lightning_brightness = (s: Strike, age: f64) -> f32:
    if s.key < 0 or age < 0.0 or age >= LIGHTNING_LIFE: return 0.0
    strokes = if s.ground: 4 else: 3
    light = 0.0
    at = 0.0
    loop k in 0..4:
        if k >= strokes: break
        if k > 0: at += 0.05+lightning_rand(s.key,f64(k),11)*0.11
        if age >= at:
            peak = if k == 0: 1.0 else: 0.45+lightning_rand(s.key,f64(k),12)*0.45
            light = max(light,peak*exp(-(age-at)/0.045))
    # (the channel glows faintly between strokes)
    f32(max(light,0.12*(1.0-age/LIGHTNING_LIFE)))

struct BoltSegment:
    a: vec3
    b: vec3
    width: f32                     # core half-width (m)
    light: f32                     # relative brightness

# The channel and its branches, in metres from the strike's center (y up).
# `base` is the cloud base's height and `top` how far into the cloud the
# channel starts. Cloud to ground: a jagged channel from inside the cloud to
# the sea with forked branches that die out in the air. In cloud: a long
# crawling channel just under the base, branching out.
lightning_bolt = (s: Strike, base: f32) -> BoltSegment[]:
    out: BoltSegment[]
    if s.key < 0: return out
    r = rng(s.key*7+13)
    if s.ground:
        top = base+400.0
        p = vec3(0,top,0)
        drift = vec2(f32(r.next_float()-0.5),f32(r.next_float()-0.5))*0.5
        n = 34
        main: vec3[]
        main.push(p)
        loop k in 0..n:
            step = top/f32(n)
            jag = vec2(f32(r.next_float()-0.5),f32(r.next_float()-0.5))*step*1.3
            q = p+vec3(drift.x*step+jag.x,-step,drift.y*step+jag.y)
            if k == n-1: q.y = -5.0
            out.push(BoltSegment(p,q,1.2,1.0))
            main.push(q)
            p = q
        lightning_branches(out,main,r,5,0.4,base)
    else:
        dir = vec3(f32(cos(s.heading)),0,f32(sin(s.heading)))
        side = vec3(-dir.z,0,dir.x)
        p = vec3(0,base-30.0,0)-dir*(s.reach*0.5)
        n = 30
        main: vec3[]
        main.push(p)
        loop k in 0..n:
            step = s.reach/f32(n)
            q = p+dir*step+side*(f32(r.next_float()-0.5)*step*1.4)+vec3(0,f32(r.next_float()-0.5)*step*0.5,0)
            q.y = min(q.y,base+60.0)
            out.push(BoltSegment(p,q,0.9,0.8))
            main.push(q)
            p = q
        lightning_branches(out,main,r,7,0.35,base)
    out

lightning_branches = (out: mut BoltSegment[], main: vec3[], r: mut Rng, count: int, light: f32, base: f32):
    loop b in 0..count:
        at = main[int(r.next_float()*f64(main.len()-4))+1]
        prev = at
        heading = r.next_float()*TAU
        dir = normalize(vec3(f32(cos(heading)),-0.9,f32(sin(heading))))
        len = 8+int(r.next_float()*10.0)
        loop k in 0..len:
            step = 70.0+f32(r.next_float())*60.0
            q = prev+dir*step+vec3(f32(r.next_float()-0.5),f32(r.next_float()-0.5)*0.6,f32(r.next_float()-0.5))*step*0.9
            if q.y < 0.0: break
            out.push(BoltSegment(prev,q,0.6*(1.0-f32(k)/f32(len))+0.15,light*(1.0-f32(k)/f32(len)*0.7)))
            prev = q
