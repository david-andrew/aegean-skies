# Programme processing before record wear, reception and noise. Fixed storage;
# control-rate square roots, a seconds-scale leveller and a short peak guard.
const STATION_RATE = 16000
const STATION_LOOKAHEAD = 64

struct StationLevel:
    ready = false
    power = 0.0
    block_power = 0.0
    control = 0
    gain = 1.0
    gain_target = 1.0
    compressor_peak = 0.0
    compressor_target = 1.0
    compressor_gain = 1.0
    limiter_peak = 0.0
    limiter_hold = 0
    delay: f64[]
    at = 0

station_level = (s: mut StationLevel, input: f64) -> f64:
    if s.delay.len()==0:s.delay=fill(0.0,STATION_LOOKAHEAD)
    s.block_power+=input*input
    s.control+=1
    if s.control%160==0:
        measured=s.block_power/160.0;s.block_power=0
        if not s.ready:
            s.power=measured
            if measured>0.000001:
                s.gain_target=clamp(pow(0.085/sqrt(measured),0.7),0.35,6.0)
                s.ready=true
        else:
            # About 0.8 s measurement smoothing. Silence holds gain, not room noise.
            s.power+=(measured-s.power)*0.0124222
            if measured>0.000001:s.gain_target=clamp(pow(0.085/sqrt(max(s.power,0.000001)),0.7),0.35,6.0)
    # Reduce level in roughly 1.2 seconds; raise it over four seconds. Phrase
    # envelopes still pass through, while sustained quiet sections become audible.
    s.gain+=(s.gain_target-s.gain)*(if s.control<1600:0.00312 else:if s.gain_target<s.gain:0.0000520833 else:0.000015625)
    value=input*s.gain
    magnitude=abs(value)
    s.compressor_peak+=(magnitude-s.compressor_peak)*(if magnitude>s.compressor_peak:0.03 else:0.00041658)
    if s.control%32==0:
        s.compressor_target=if s.compressor_peak>0.18:sqrt(0.18/s.compressor_peak) else:1.0
    s.compressor_gain+=(s.compressor_target-s.compressor_gain)*(if s.compressor_target<s.compressor_gain:0.04 else:0.00041658)
    value*=s.compressor_gain
    magnitude=abs(value)
    if magnitude>=s.limiter_peak:
        s.limiter_peak=magnitude;s.limiter_hold=STATION_LOOKAHEAD
    else if s.limiter_hold>0:s.limiter_hold-=1
    else:s.limiter_peak*=0.998751
    # Hold the detected peak through the entire 4 ms delay. No receiver hiss or
    # crackle ever enters this detector. The cap is a sample-peak, not true-peak claim.
    limited=s.delay[s.at]
    s.delay[s.at]=value;s.at=(s.at+1)%STATION_LOOKAHEAD
    if s.limiter_peak>0.50:limited*=0.50/s.limiter_peak
    clamp(limited,-0.50,0.50)

# Music already arrives in a bounded block. Keep its detector and envelope scalars
# local across that block, retaining exactly the scalar path's operation order.
station_level_block = (s: mut StationLevel, values: mut f64[]):
    if s.delay.len()==0:s.delay=fill(0.0,STATION_LOOKAHEAD)
    ready=s.ready
    power=s.power
    block_power=s.block_power
    control=s.control
    gain=s.gain
    gain_target=s.gain_target
    compressor_peak=s.compressor_peak
    compressor_target=s.compressor_target
    compressor_gain=s.compressor_gain
    limiter_peak=s.limiter_peak
    limiter_hold=s.limiter_hold
    delay=s.delay
    at=s.at
    loop i in 0..values.len():
        input=values[i]
        block_power+=input*input
        control+=1
        if control%160==0:
            measured=block_power/160.0;block_power=0
            if not ready:
                power=measured
                if measured>0.000001:
                    gain_target=clamp(pow(0.085/sqrt(measured),0.7),0.35,6.0)
                    ready=true
            else:
                # About 0.8 s measurement smoothing. Silence holds gain, not room noise.
                power+=(measured-power)*0.0124222
                if measured>0.000001:gain_target=clamp(pow(0.085/sqrt(max(power,0.000001)),0.7),0.35,6.0)
        # Reduce level in roughly 1.2 seconds; raise it over four seconds. Phrase
        # envelopes still pass through, while sustained quiet sections become audible.
        gain+=(gain_target-gain)*(if control<1600:0.00312 else:if gain_target<gain:0.0000520833 else:0.000015625)
        value=input*gain
        magnitude=abs(value)
        compressor_peak+=(magnitude-compressor_peak)*(if magnitude>compressor_peak:0.03 else:0.00041658)
        if control%32==0:
            compressor_target=if compressor_peak>0.18:sqrt(0.18/compressor_peak) else:1.0
        compressor_gain+=(compressor_target-compressor_gain)*(if compressor_target<compressor_gain:0.04 else:0.00041658)
        value*=compressor_gain
        magnitude=abs(value)
        if magnitude>=limiter_peak:
            limiter_peak=magnitude;limiter_hold=STATION_LOOKAHEAD
        else if limiter_hold>0:limiter_hold-=1
        else:limiter_peak*=0.998751
        # Hold the detected peak through the entire 4 ms delay. No receiver hiss or
        # crackle ever enters this detector. The cap is a sample-peak, not true-peak claim.
        limited=delay[at]
        delay[at]=value;at=(at+1)%STATION_LOOKAHEAD
        if limiter_peak>0.50:limited*=0.50/limiter_peak
        values[i]=clamp(limited,-0.50,0.50)
    s.ready=ready
    s.power=power
    s.block_power=block_power
    s.control=control
    s.gain=gain
    s.gain_target=gain_target
    s.compressor_peak=compressor_peak
    s.compressor_target=compressor_target
    s.compressor_gain=compressor_gain
    s.limiter_peak=limiter_peak
    s.limiter_hold=limiter_hold
    s.at=at
    s.delay=delay
