# Startup work done ahead of time by tools/bake.jo (assets/baked/README.md). Each product is
# optional: without its file (a fresh checkout, before the first bake) the game makes it itself,
# the same bytes. Names carry a version, raised when the code that makes a product changes.
baked_files = embed_dir('../assets/baked')
baked_asset = (name: str) -> u8[]?: if name in baked_files: baked_files[name] else: none
