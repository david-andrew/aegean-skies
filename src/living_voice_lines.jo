# Social acts and small facts, each phrased by one of the fourteen voices. People speak plainly
# and briefly; figures arrive already rounded (see living_talk_words.jo), never as raw records.
use 'life_types.jo'

voice_friend = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "{other} is a good sort. We go back a long way."
        .shop: "{other} always settles up on time. I've no complaints."
        .formal: "I'm on good terms with {other}."
        .guarded: "{other} is all right. I can talk to them."
        .anxious: "{other} looks out for me. I'd be lost otherwise."
        .warm: "{other} is a dear. You should meet them."
        .measured: "{other} and I get on well."
        .wry: "{other} puts up with me, which is more than most do."
        .plain: "{other} is a good neighbour."
        .devout: "{other} has been a good friend to me, God keep them."
        .brisk: "{other} is reliable. That counts for a lot."
        .chatty: "Oh, {other} and I talk every evening."
        .eager: "{other} is a friend. We'll fly together one of these days."
        .elder: "I've known {other} for years."

voice_feud = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "Keep {other} away from my nets."
        .shop: "{other} still owes me an apology, and maybe more."
        .formal: "{other} and I have a disagreement. I'd rather not go into it."
        .guarded: "Don't talk to me about {other}."
        .anxious: "I'd rather not run into {other} today."
        .warm: "{other} and I have had words. It'll mend, I hope."
        .measured: "I've fallen out with {other}."
        .wry: "{other} and I aren't speaking just now."
        .plain: "{other} and me don't get on."
        .devout: "I pray for {other}, though we've quarrelled."
        .brisk: "{other} and I don't see eye to eye. Leave it there."
        .chatty: "Don't get me started on {other}."
        .eager: "{other} and I aren't friends any more."
        .elder: "{other} and I fell out. At my age you'd think I'd know better."

voice_late = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "You kept me waiting that time. I don't forget."
        .shop: "Your last delivery was late. I lost a customer over it."
        .formal: "Your last delivery arrived late. I noted it."
        .guarded: "Last time I waited on you, you were late."
        .anxious: "You were late last time. I didn't know what had happened to you."
        .warm: "You had me worried, coming in late last time."
        .measured: "You were late with my last delivery."
        .wry: "I hope you're quicker than last time."
        .plain: "You were late last time."
        .devout: "You were late last time, but you came. That's something."
        .brisk: "Last delivery was late. Don't make a habit of it."
        .chatty: "You were late last time; half the street asked me where you'd got to."
        .eager: "You were late last time. I wondered what had happened."
        .elder: "You kept me waiting last time. I'm too old to wait."

voice_delivery = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "You brought my load in when you said. I remember that."
        .shop: "Your last delivery came in on time. Good."
        .formal: "Your last delivery was in order. Thank you."
        .guarded: "You kept your word on that load. That counts."
        .anxious: "You got my things here safely. I was so relieved."
        .warm: "You came through for me with that delivery. I've not forgotten."
        .measured: "You did right by me with that delivery."
        .wry: "You delivered when you said you would. Not everyone does."
        .plain: "You brought what you said you'd bring."
        .devout: "You brought what was promised. Bless you for it."
        .brisk: "Last delivery arrived on time. Thank you."
        .chatty: "You brought my order right to the door. I told everyone."
        .eager: "You got it here fast last time."
        .elder: "You brought my order. That was kind."

voice_rescue = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "You pulled me out of the water. I owe you for that."
        .shop: "You brought me back when I came down. I owe you."
        .formal: "I'm in your debt for bringing me ashore."
        .guarded: "You helped me when I came down. I don't forget that."
        .anxious: "If you hadn't come out for me... I still think about it."
        .warm: "I still think of how you came out for me."
        .measured: "You brought me ashore. Thank you again."
        .wry: "You fished me out of the sea. I suppose I'm grateful."
        .plain: "You got me out of the water. Thank you."
        .devout: "God sent you out for me that day."
        .brisk: "You brought me in when I came down. Thank you."
        .chatty: "I tell everyone how you came out and got me."
        .eager: "You came out for me when I went in the water. I won't forget it."
        .elder: "You came for me when I was in the water. I won't forget."

voice_harm = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "I remember what you did out there."
        .shop: "There's still damage between us to settle."
        .formal: "What happened between us hasn't been settled."
        .guarded: "You know why I keep my distance."
        .anxious: "I haven't forgotten what happened. I'd rather you stood back."
        .warm: "Saying hello doesn't put right what happened."
        .measured: "I remember the harm you did me."
        .wry: "Hello doesn't make us friends."
        .plain: "I've not forgotten what you did."
        .devout: "I'm trying to forgive what you did. It isn't easy."
        .brisk: "I remember what happened. Keep it short."
        .chatty: "After what you did, everyone in town knows your face."
        .eager: "I remember what you did."
        .elder: "I'm old, but I remember what you did."

voice_privacy = (voice: VoiceKind, here: str) -> str:
    match voice:
        .salt: "Not here. Too many ears on this quay."
        .shop: "My accounts aren't for the whole street."
        .formal: "My private affairs aren't for discussion in the street."
        .guarded: "That's my business."
        .anxious: "Not here, please. People are listening."
        .warm: "Walk somewhere quieter with me before you ask that."
        .measured: "I'd rather not talk about money here."
        .wry: "The whole of {here} doesn't need to hear about my bills."
        .plain: "Not here."
        .devout: "That is between me and the people I owe."
        .brisk: "Not in public, thank you."
        .chatty: "Lower your voice; this lot would have it round town by supper."
        .eager: "Can we not talk about that here."
        .elder: "Not out here, where everyone can hear."

voice_music = (voice: VoiceKind, who: str, place: str) -> str:
    match voice:
        .salt: "That's {who} on the mandolin. Plays well enough."
        .shop: "{who}'s playing again. Brings people out, which is good for trade."
        .formal: "That's {who} playing in the square."
        .guarded: "{who}'s playing. I'm only listening."
        .anxious: "I think that's {who} playing. I like it when they play."
        .warm: "Stay a while and listen; that's {who} playing."
        .measured: "That's {who} on the mandolin."
        .wry: "{who}'s at the mandolin again. Better than last week."
        .plain: "{who} plays most evenings."
        .devout: "{who} plays beautifully. It does the heart good."
        .brisk: "{who} on the mandolin. I've five minutes to listen."
        .chatty: "That's {who}; you can hear them three streets off."
        .eager: "Listen to {who}. They're good."
        .elder: "{who} plays the old songs. I like those."

voice_no_music = (voice: VoiceKind, place: str, dated: str) -> str:
    match voice:
        .salt: "No music tonight."
        .shop: "Quiet tonight. No one's playing."
        .formal: "There's no music this evening, as far as I can tell."
        .guarded: "Nobody's playing."
        .anxious: "I haven't heard anyone playing tonight."
        .warm: "No music yet. Someone usually starts later."
        .measured: "Nobody's playing yet."
        .wry: "No music. We'll have to make our own conversation."
        .plain: "Nobody playing tonight."
        .devout: "It's quiet tonight. That's no bad thing."
        .brisk: "No music. Just as well; I've things to do."
        .chatty: "Nobody's playing yet; usually there's someone out in {place} by now."
        .eager: "No one's playing yet. Shame."
        .elder: "When I was young there was music every night. Not tonight."

# A price someone carries in their head: `value` and `dated` are already rounded and relative;
# `source` is who told them ("" when they saw it themselves).
voice_price = (voice: VoiceKind, good: str, value: str, place: str, dated: str, source: str = "") -> str:
    said = if source == "": "" else: ", so {source} said"
    match voice:
        .salt: "{good} fetched {value} at {place} {dated}{said}."
        .shop: "{place} was asking {value} for {good} {dated}{said}."
        .formal: "{good} stood at {value} in {place} {dated}{said}."
        .guarded: "{value} for {good} at {place}, {dated}{said}. Don't hold me to it."
        .anxious: "I think {good} was {value} at {place} {dated}{said}. It may have changed."
        .warm: "They were selling {good} at {value} in {place} {dated}{said}."
        .measured: "{good} was {value} at {place} {dated}{said}."
        .wry: "{good} was {value} at {place} {dated}{said}. It'll have moved since."
        .plain: "{good}'s {value} at {place}, {dated}{said}."
        .devout: "They asked {value} for {good} at {place} {dated}{said}."
        .brisk: "{good}: {value} at {place}, {dated}{said}."
        .chatty: "{good} was going for {value} at {place} {dated}{said}, would you believe."
        .eager: "{good} was {value} at {place} {dated}{said}."
        .elder: "{good} was {value} at {place} {dated}{said}, if I heard right."

# Someone's own paid errand: `load`, `dest`, `pay` and `due` are already said aloud.
voice_offer = (voice: VoiceKind, load: str, dest: str, pay: str, due: str) -> str:
    match voice:
        .salt: "I've {load} for {dest}, {due}. {pay} to whoever takes it."
        .shop: "I need {load} taken to {dest} {due}. I'll pay {pay}."
        .formal: "I have {load} to go to {dest} {due}. The fee is {pay}."
        .guarded: "{load} to {dest}, {due}. {pay}. Take it or leave it."
        .anxious: "I need {load} in {dest} {due}. There's {pay} in it, if you can."
        .warm: "Could you take {load} to {dest} for me, {due}? I'd give you {pay}."
        .measured: "There's {load} to go to {dest} {due}. I can pay {pay}."
        .wry: "{load} wants to be in {dest} {due}, and it won't walk there. {pay}."
        .plain: "{load} to {dest}, {due}. {pay}."
        .devout: "I have {load} that must reach {dest} {due}. I can give {pay} for it."
        .brisk: "{load} to {dest}, {due}. {pay}, paid on delivery."
        .chatty: "I've {load} that has to get to {dest} {due}; {pay} for your trouble."
        .eager: "I've got {load} for {dest}, {due}. {pay} if you'll fly it."
        .elder: "I've {load} to send to {dest}, {due}. I can give you {pay}."

# An air meet ahead at a capital's feast: `moment` is "this afternoon at five", "tomorrow at five"
# or "on Thursday at five".
voice_air_meet = (voice: VoiceKind, place: str, moment: str) -> str:
    match voice:
        .salt: "The {place} club races round the pylons {moment}; I'll watch from the mole."
        .shop: "The flying club at {place} races {moment}, for the feast. They take entries at the quay."
        .formal: "The {place} flying club holds its feast-day race {moment}, two laps of the harbour pylons."
        .guarded: "There is a race over {place} harbour {moment}, if you have a machine for it."
        .anxious: "They race aeroplanes low over {place} harbour {moment}. I can't bear to watch."
        .warm: "Go to {place} {moment} if you can: the club races round the pylons for the feast."
        .wry: "{place} honours its saint {moment} by flying in circles round the harbour."
        .measured: "The race at {place} is {moment}: two laps, and the fastest machine home wins."
        .plain: "They're racing aeroplanes at {place} {moment}, for the feast."
        .devout: "After the feast-day mass at {place} {moment}, the club races round the harbour."
        .brisk: "Air race at {place} {moment}. Entries at the quay."
        .chatty: "Everyone's going to {place} {moment} for the feast-day race round the harbour."
        .eager: "There's a race at {place} {moment}! Two laps round the pylons. You should enter."
        .elder: "They race at {place} {moment} for the feast. We used to race boats."
