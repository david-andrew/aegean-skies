# Literal facts and social acts phrased separately for the eight authored voices.
# No hash ownership, automatic paraphrasing or shared stock sentence tails.
use 'life_types.jo'

voice_friend = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "{other} and I share a good word when the boats are in."
        .shop: "I've always time at the counter for {other}."
        .formal: "My dealings with {other} have been friendly."
        .guarded: "I can talk to {other} without watching every word."
        .anxious: "I look for {other} when I've time for company."
        .warm: "{other} has been kind company to me."
        .wry: "{other} and I get on, despite knowing each other."
        .measured: "I make a little time for {other}."

voice_feud = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "I'd keep a mooring's length between {other} and me."
        .shop: "My business with {other} is still unsettled."
        .formal: "There is a disagreement between {other} and me."
        .guarded: "Leave {other} out of my conversation for now."
        .anxious: "I don't want to run into {other} here."
        .warm: "{other} and I have had words; give us a little room."
        .wry: "{other}'s table is one I can do without today."
        .measured: "I've had a quarrel with {other}."

voice_late = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "You left me watching the harbour mouth that time, {other}."
        .shop: "Your late delivery cost me a wait at the counter, {other}."
        .formal: "I remember your missed delivery time, {other}."
        .guarded: "I was the one left waiting for you, {other}."
        .anxious: "I kept looking for you after the promised time, {other}."
        .warm: "You did keep me waiting before, {other}."
        .wry: "I remember how long that last delivery took you, {other}."
        .measured: "We have discussed your late arrival, {other}."

voice_delivery = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "You brought the promised load ashore, {other}; I remember."
        .shop: "Your last load reached my counter as promised, {other}."
        .formal: "I remember that you completed the delivery, {other}."
        .guarded: "You kept that cargo promise to me, {other}."
        .anxious: "You got the load here before I stopped looking for it, {other}."
        .warm: "You came through for me with that delivery, {other}."
        .wry: "You delivered what you promised last time, {other}."
        .measured: "I have not forgotten your completed delivery, {other}."

voice_rescue = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "You brought me back ashore, {other}; I won't forget."
        .shop: "You can count my rescue to your credit, {other}."
        .formal: "I remember your help in bringing me ashore, {other}."
        .guarded: "You helped me out there, {other}; that counts with me."
        .anxious: "I'm here because you came out to help, {other}."
        .warm: "I still think of how you brought me back, {other}."
        .wry: "You gave me another day to complain about, {other}."
        .measured: "Your help brought me safely ashore, {other}."

voice_harm = (voice: VoiceKind, other: str) -> str:
    match voice:
        .salt: "I remember what passed between us out there, {other}."
        .shop: "There is damage between us still to settle, {other}."
        .formal: "Our previous disagreement remains unresolved, {other}."
        .guarded: "You know why I keep my distance, {other}."
        .anxious: "I haven't stopped watching my words around you, {other}."
        .warm: "A greeting doesn't put right what happened, {other}."
        .wry: "We haven't become friends by saying hello, {other}."
        .measured: "I remember the harm between us, {other}."

voice_privacy = (voice: VoiceKind, here: str) -> str:
    match voice:
        .salt: "Not across {here}'s quay; leave my bills out of the wind."
        .shop: "My {here} accounts aren't for the whole counter to hear."
        .formal: "My private accounts can wait until we are away from {here}'s passers-by."
        .guarded: "Keep my bills off {here}'s quay."
        .anxious: "There are too many people listening here in {here} for my bills."
        .warm: "Walk somewhere quieter in {here} before asking what I owe."
        .wry: "The rest of {here} can find its own bills to discuss."
        .measured: "I won't discuss my accounts in front of {here}'s other voices."

voice_craft = (voice: VoiceKind, kind: str, fuel: str, place: str) -> str:
    match voice:
        .salt: "The {kind} at {place} has {fuel} litres left for the next crossing."
        .shop: "I've {fuel} litres in my {kind} here at {place}; that is the fuel I can put against a load."
        .formal: "My {kind}'s tank here at {place} contains {fuel} litres."
        .guarded: "{fuel} litres in my {kind} at {place}; I haven't promised its hold to anyone here."
        .anxious: "I've checked the {kind} at {place}: {fuel} litres aboard."
        .warm: "My {kind} is here at {place}, with {fuel} litres for another journey."
        .wry: "The {kind} and I are at {place}, with {fuel} litres between us."
        .measured: "I left the {kind} at {place} with {fuel} litres in its tank."

voice_price = (voice: VoiceKind, good: str, value: str, place: str, dated: str) -> str:
    match voice:
        .salt: "{good} was {value} at {place} when I heard, {dated}; ask before selling your catch on it."
        .shop: "The {place} quote I had for {good} was {value}, {dated}."
        .formal: "My recorded price for {good} in {place} is {value}, observed {dated}."
        .guarded: "{value} for {good} at {place}, {dated}; don't call it my promise."
        .anxious: "I last heard {value} for {good} at {place}, {dated}; check it again."
        .warm: "They quoted {value} for {good} in {place}, {dated}; ask at the counter when you arrive."
        .wry: "{good} fetched a quote of {value} at {place}, {dated}; prices can get ahead of gossip."
        .measured: "The last figure I heard for {good} was {value} in {place}, {dated}."

voice_music = (voice: VoiceKind, who: str, place: str) -> str:
    match voice:
        .salt: "{who}'s mandolin carries across {place}'s square to here."
        .shop: "It's {who} playing by {place}'s square; the counter can wait a tune."
        .formal: "The music audible here in {place} is {who}'s mandolin."
        .guarded: "{who} is playing the mandolin here at {place}; I'm listening."
        .anxious: "I can hear {who}'s mandolin from this part of {place}."
        .warm: "Stay for {who}'s mandolin in {place}'s square."
        .wry: "{who} has found time for the mandolin at {place}."
        .measured: "That is {who} on the mandolin in {place}'s square."

voice_no_music = (voice: VoiceKind, place: str, dated: str) -> str:
    match voice:
        .salt: "No mandolin in my ears here at {place}, not at {dated}."
        .shop: "I haven't heard music from {place}'s square at {dated}."
        .formal: "At {dated}, no musician is audible here in {place}."
        .guarded: "Ask in {place}'s square; I have heard no tune at {dated}."
        .anxious: "It's {dated} at {place}, and I haven't heard anyone begin playing."
        .warm: "No tune has reached this part of {place} at {dated}."
        .wry: "{place} has talk enough at {dated}, but no music I can hear."
        .measured: "I've heard no music here at {place}, as of {dated}."

voice_offer = (voice: VoiceKind, load: str, dest: str, pay: str, due: str) -> str:
    match voice:
        .salt: "I've {load} bound for {dest}; {pay} for the crossing, due {due}."
        .shop: "I can pay {pay} to get {load} to {dest} by {due}."
        .formal: "The commission is {load} to {dest} by {due}, for {pay}."
        .guarded: "{pay} for taking {load} to {dest} by {due}; hear the terms before agreeing."
        .anxious: "I need {load} in {dest} by {due}; there's {pay} to pay the carrier."
        .warm: "Could you bring {load} to {dest} by {due} for me, for {pay}?"
        .wry: "{load} needs a crossing to {dest}, not another promise; {pay}, due {due}."
        .measured: "I have {load} for {dest}; I can offer {pay} if it arrives by {due}."

# An air meet ahead at a capital's feast: `moment` is "this afternoon at five", "tomorrow at five"
# or "on Thursday at five".
voice_air_meet = (voice: VoiceKind, place: str, moment: str) -> str:
    match voice:
        .salt: "The {place} club races round the pylons {moment}; I'll watch from the mole."
        .shop: "The flying club at {place} races {moment}, for the feast. They take entries at the quay."
        .formal: "The {place} flying club holds its feast-day race {moment}, two laps of the harbour pylons."
        .guarded: "There is a race over {place} harbour {moment}, if you have a machine for it."
        .anxious: "They race aeroplanes low over {place} harbour {moment}. I can't bear to watch."
        .warm: "Go to {place} {moment} if you can: the club races round the pylons for the feast."
        .wry: "{place} honours its saint {moment} by flying in circles round the harbour."
        .measured: "The race at {place} is {moment}: two laps, and the fastest machine home wins."
