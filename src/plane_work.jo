# Working on one's own aircraft, done by hand: where each job is on the airframe, where the pilot
# can stand to reach it (on the quay if it is within an arm's reach, else on a float, the lower
# wing's root or a flying boat's deck), and the way there: along the quay, the line hauled in, a
# step down onto the float, a climb up a strut. Plain geometry in the craft's own frame (+x right,
# +y up, -z forward); the game walks the pilot through the legs (aegean.jo, `plane_work_step`).
#
# The layout comes from the model's own numbers (its flat parts, propeller hub and radius, the
# pilot's head and the step-off point), so every airframe, hand-built or from the catalogue, works.

use 'leisure.jo'

const WORK_REACH = 1.15             # how far a hand gets, leaning, from where the feet are
const WORK_LOW = -0.35              # a target below the feet is crouched to, down to this
const WORK_HIGH = 2.1               # and reached up to, up to this
const WORK_HOP = 2.3                # the longest step between the quay and the airframe

enum WorkPose: stand, reach_up, lean, crouch, haul, climb

# A strip one can stand on, at the feet's height, from a to b.
struct StandSurface:
    a: vec3
    b: vec3
    kind = 0                        # 0 a float, 1 the lower wing's root, 2 a flying boat's deck
    side = 0.0                      # -1 left, 1 right

struct CraftLayout:
    surfaces: StandSurface[]
    body: vec3                      # the fuselage's centre and half size
    body_half: vec3
    windscreen: vec3
    engine: vec3
    engine_radius = 0.5
    prop: vec3
    prop_radius = 1.25
    lower_wing = -1                 # the wing one can stand on (index into the shade pairs), or -1
    wing_y = 0.0
    wing_half: vec3 = vec3(0, 0, 0)
    wing_z = 0.0
    wing_stand_z = 0.0              # (where on the wing's chord one stands: toward its leading edge)
    floats: vec3[]                  # float centres and half sizes, by pairs
    tail: vec3 = vec3(0, 0, 0)      # the tailplane's centre and half size
    tail_half: vec3 = vec3(0, 0, 0)
    boat = false

_closest_on = (s: StandSurface, p: vec3) -> vec3:
    d = s.b - s.a
    l2 = f64(dot(d.xz, d.xz))
    u = if l2 < 0.0001: 0.0 else: clamp(f64(dot(p.xz - s.a.xz, d.xz)) / l2, 0.0, 1.0)
    s.a + d * f32(u)

_flat = (a: vec3, b: vec3) -> f64: f64(length(a.xz - b.xz))

# The craft's stand-on strips and work places, from its flat parts (centre and half size by pairs:
# the fuselage first, then the wings, floats and tail), its hub, the pilot's head and the step-off.
craft_layout = (shade: vec3[], prop_at: vec3, prop_radius: f64, cockpit: vec3, exit: vec3) -> CraftLayout:
    out = CraftLayout()
    out.body = if shade.len() >= 2: shade[0] else: vec3(0, 0, 0)
    out.body_half = if shade.len() >= 2: shade[1] else: vec3(0.6, 0.6, 4.0)
    bw = f64(out.body_half.x)
    body_top = f64(out.body.y + out.body_half.y)
    out.boat = f64(exit.y) > f64(out.body.y) - 0.3
    lowest = 1000.0
    k = 2
    loop k + 1 < shade.len():
        c = shade[k]; h = shade[k + 1]
        if f64(h.x) > 3.0 and f64(h.y) < 0.25:
            if f64(c.y) < lowest:
                lowest = f64(c.y); out.lower_wing = k
        else if abs(f64(c.x)) > bw + 0.25 and f64(h.x) < 0.8 and f64(h.z) > 0.9:
            out.floats.push(c); out.floats.push(h)
        else if f64(c.z) > f64(out.body.z) + f64(out.body_half.z) * 0.5 and f64(h.x) > 0.4 and f64(h.y) < 0.25:
            out.tail = c; out.tail_half = h
        k += 2
    if out.lower_wing >= 0:
        c = shade[out.lower_wing]; h = shade[out.lower_wing + 1]
        out.wing_y = f64(c.y + h.y); out.wing_half = h; out.wing_z = f64(c.z)
    # floats: their flat tops, short of the pointed ends
    if not out.boat:
        j = 0
        loop j + 1 < out.floats.len():
            c = out.floats[j]; h = out.floats[j + 1]
            top = c.y + h.y * 0.95
            out.surfaces.push(StandSurface(vec3(c.x, top, c.z - h.z * 0.85), vec3(c.x, top, c.z + h.z * 0.72), 0, if c.x < 0: -1.0 else: 1.0))
            j += 2
    # the lower wing's root, either side of the fuselage, if it is low enough to stand on (or, on
    # a flying boat, to climb up onto from the deck), toward its leading edge
    deck_x = max(abs(f64(exit.x)), bw * 0.6)
    climbable = out.wing_y < body_top + 0.2 or (out.boat and out.wing_y - f64(exit.y) < 1.8)
    if out.lower_wing >= 0 and climbable:
        out.wing_stand_z = out.wing_z - f64(out.wing_half.z) * 0.8
        z = f32(out.wing_stand_z)
        inner = if out.boat: deck_x else: bw + 0.3
        loop side in [-1.0, 1.0]:
            y = f32(out.wing_y)
            out.surfaces.push(StandSurface(vec3(f32(side * inner), y, z), vec3(f32(side * (inner + 1.0)), y, z), 1, side))
    # a flying boat's deck, along either side of the hull
    if out.boat:
        loop side in [-1.0, 1.0]:
            x = f32(side * deck_x)
            out.surfaces.push(StandSurface(vec3(x, exit.y, exit.z - 1.6), vec3(x, exit.y, exit.z + 1.4), 2, side))
    out.windscreen = cockpit + vec3(0, -0.22, -0.55)
    pusher = f64(prop_at.z) > f64(out.body.z)
    out.engine = prop_at + vec3(0, 0, if pusher: -0.45 else: 0.4)
    out.engine_radius = clamp(bw * 0.95, 0.35, 0.7)
    # (an engine in its own pod: the pod's size, not the fuselage's)
    k = 2
    loop k + 1 < shade.len():
        if f64(length(shade[k] - prop_at)) < 3.0 and f64(shade[k + 1].x) < 0.8 and f64(shade[k].y) > body_top: out.engine_radius = clamp(f64(shade[k + 1].x), 0.3, 0.7)
        k += 2
    out.prop = prop_at
    out.prop_radius = prop_radius
    out

# ---------------- what each job is, and where ----------------

struct WorkStop:
    targets: vec3[]                 # places on the airframe (craft frame) where it can be done
    pose: WorkPose
    seconds: f64
    line: str                       # what he is doing, for the card

_ring = (c: vec3, r: f64, n: int) -> vec3[]: [loop k in 0..n: c + vec3(f32(cos(TAU * f64(k) / f64(n)) * r), f32(sin(TAU * f64(k) / f64(n)) * r), 0)]

# The points of a part one could patch (PartId order: body, engine, wings, floats, tail).
part_targets = (l: CraftLayout, part: int) -> vec3[]:
    out: vec3[]
    match part:
        0:
            loop side in [-1.0, 1.0]:
                loop k in 0..5: out.push(l.body + vec3(f32(side * f64(l.body_half.x)), 0, f32((f64(k) / 4.0 - 0.5) * f64(l.body_half.z) * 1.2)))
        1:
            loop side in [-1.0, 1.0]: out.push(l.engine + vec3(f32(side * l.engine_radius), 0, 0))
            out.push(l.engine + vec3(0, f32(l.engine_radius), 0))
        2, 3:
            side = if part == 2: -1.0 else: 1.0
            if l.lower_wing >= 0:
                loop k in 0..6:
                    x = side * (f64(l.body_half.x) + 0.6 + f64(k) * (f64(l.wing_half.x) - f64(l.body_half.x)) / 6.0)
                    loop edge in [-1.0, 1.0]: out.push(vec3(f32(x), f32(l.wing_y - 0.08), f32(l.wing_z + edge * f64(l.wing_half.z) * 0.9)))
        4, 5:
            side = if part == 4: -1.0 else: 1.0
            j = 0
            loop j + 1 < l.floats.len():
                c = l.floats[j]; h = l.floats[j + 1]
                if f64(c.x) * side > 0.0:
                    loop k in 0..5:
                        loop s in [-1.0, 1.0]: out.push(c + vec3(f32(s * f64(h.x)), 0, f32((f64(k) / 4.0 - 0.5) * f64(h.z) * 1.4)))
                j += 2
        6:
            loop k in 0..5:
                loop edge in [-1.0, 1.0]: out.push(l.tail + vec3(f32((f64(k) / 4.0 - 0.5) * f64(l.tail_half.x) * 2.0), 0, f32(edge * f64(l.tail_half.z))))
        _: pass
    if out.len() == 0: out.push(l.body + vec3(l.body_half.x, 0, 0))
    out

# The stops a job makes on the airframe, in order.
task_stops = (l: CraftLayout, task: TinkerTask, damaged: int, near_side: f64) -> WorkStop[]:
    match task:
        .wipe: [WorkStop([l.windscreen + vec3(-0.3, 0, 0), l.windscreen, l.windscreen + vec3(0.3, 0, 0)], .reach_up, 6.0, "Wiping the windscreen")]
        .inspect:
            stops: WorkStop[]
            j = 0
            loop j + 1 < l.floats.len():
                c = l.floats[j]; h = l.floats[j + 1]
                if f64(c.x) * near_side >= 0.0 or l.floats.len() == 2:
                    loop dz in [-0.45, 0.25]: stops.push(WorkStop([c + vec3(f32(-f64(c.x) * 0.25), f32(f64(h.y) * 1.2), f32(dz * f64(h.z)))], .crouch, 2.6, "Checking the float struts"))
                j += 2
            if l.lower_wing >= 0:
                x = near_side * f64(l.wing_half.x) * 0.62
                stops.push(WorkStop([vec3(f32(x), f32(l.wing_y + 0.9), f32(l.wing_z)), vec3(f32(x * 0.6), f32(l.wing_y + 0.9), f32(l.wing_z))], .stand, 3.0, "Looking over the wing struts and wires"))
            if stops.len() == 0: stops.push(WorkStop(part_targets(l, 0), .stand, 4.0, "Looking her over"))
            stops
        .oil: [WorkStop(part_targets(l, 1), .lean, 6.0, "Oiling the rocker arms")]
        .tune: [WorkStop(part_targets(l, 1), .lean, 9.0, "Tuning the engine, the cowling open")]
        .patch: [WorkStop(part_targets(l, damaged), .lean, 7.0, "Patching the fabric")]
        .polish: [WorkStop(_ring(l.prop, l.prop_radius * 0.8, 12), .lean, 6.0, "Polishing the propeller")]

# ---------------- where to stand ----------------

struct StandChoice:
    on_quay = false
    quay: vec3 = vec3(0, 0, 0)      # (world) where to stand on the quay
    surface = -1                    # else the strip, and the spot on it (craft frame)
    spot: vec3 = vec3(0, 0, 0)
    target: vec3 = vec3(0, 0, 0)    # the target chosen (craft frame)
    pose: WorkPose = .stand
    stretched = false               # (nothing was within reach: as near as he can get)

_pose_for = (pose: WorkPose, height: f64) -> WorkPose:
    if height < 0.45: return .crouch
    if height > 1.45: return .reach_up
    if pose == .crouch: .lean else: pose

# The best place to do it from: the quay when a target is within reach of it (no climbing needed),
# else the strip of the airframe nearest a target. `frame` takes the craft frame to the world;
# `quay` gives the nearest walkable quay point to a world point (or none).
choose_stand = (l: CraftLayout, frame: mat4, stop: WorkStop, quay: (vec3) -> vec3?, near_side: f64 = 0.0) -> StandChoice:
    best = StandChoice(); best_score = 1000000.0
    fallback = StandChoice(stretched = true); fallback_reach = 1000000.0
    loop t in stop.targets:
        world = transform_point(frame, t)
        if let q = quay(world):
            reach = _flat(world, q); height = f64(world.y - q.y)
            if reach <= WORK_REACH and height >= WORK_LOW and height <= WORK_HIGH and reach < best_score:
                best_score = reach
                best = StandChoice(true, q, -1, vec3(0, 0, 0), t, _pose_for(stop.pose, height))
        loop k in 0..l.surfaces.len():
            p = _closest_on(l.surfaces[k], t)
            reach = _flat(p, t); height = f64(t.y - p.y)
            # (the quay first, when it will do: no climbing needed)
            # (and this side of the aircraft before climbing over to the other)
            score = reach + 0.4 + (if l.surfaces[k].kind == 1: 0.15 else: 0.0) + (if near_side != 0.0 and l.surfaces[k].side != near_side: 0.8 else: 0.0)
            if reach <= WORK_REACH and height >= WORK_LOW and height <= WORK_HIGH and score < best_score:
                best_score = score
                best = StandChoice(false, vec3(0, 0, 0), k, p, t, _pose_for(stop.pose, height))
            if reach < fallback_reach:
                fallback_reach = reach
                fallback = StandChoice(false, vec3(0, 0, 0), k, p, t, _pose_for(stop.pose, clamp(height, WORK_LOW, WORK_HIGH)), true)
    if best_score < 1000000.0: best else: fallback

# ---------------- getting aboard ----------------

struct Boarding:
    ok = false
    quay: vec3 = vec3(0, 0, 0)      # (world) the quay's edge
    surface = -1
    spot: vec3 = vec3(0, 0, 0)      # (craft frame) the step onto the airframe
    gap = 1000.0

# The shortest step from the quay onto a float or the deck (never onto a wing: one climbs to that).
choose_boarding = (l: CraftLayout, frame: mat4, quay: (vec3) -> vec3?) -> Boarding:
    best = Boarding()
    loop k in 0..l.surfaces.len():
        s = l.surfaces[k]
        if s.kind == 1: continue
        loop j in 0..13:
            p = s.a + (s.b - s.a) * f32(f64(j) / 12.0)
            w = transform_point(frame, p)
            if let q = quay(w):
                gap = _flat(q, w)
                if gap < best.gap: best = Boarding(gap <= WORK_HOP, q, k, p, gap)
    best

# The walk on the airframe from where one stepped on to where one works, in the craft frame:
# along a float, up its strut to the wing root, over the fuselage's top to the other side.
craft_route = (l: CraftLayout, from_surface: int, from: vec3, to_surface: int, to: vec3) -> vec3[]:
    if from_surface == to_surface or to_surface < 0 or from_surface < 0: return [from, to]
    a = l.surfaces[from_surface]; b = l.surfaces[to_surface]
    foot = (s: StandSurface) -> vec3: _closest_on(s, vec3(s.a.x, s.a.y, f32(l.wing_stand_z)))
    root = (side: f64) -> int:
        found = -1
        loop k in 0..l.surfaces.len():
            if l.surfaces[k].kind == 1 and l.surfaces[k].side == side: found = k
        found
    route = [from]
    if a.side == b.side:
        if a.kind != 1 and b.kind == 1: route.push(foot(a)); route.push(_closest_on(b, foot(a)))
        else if a.kind == 1 and b.kind != 1: route.push(_closest_on(a, foot(b))); route.push(foot(b))
        route.push(to)
        return route
    # up to this side's wing root, over the top, and down the other side
    up = (s: StandSurface) -> vec3[]:
        if s.kind == 1: return [s.a]
        r = root(s.side)
        if r >= 0: return [foot(s), l.surfaces[r].a]
        []
    route.extend(up(a))
    z = if l.lower_wing >= 0: f32(l.wing_z) else: (from.z + to.z) * 0.5
    route.push(vec3(0, l.body.y + l.body_half.y, z))
    down = up(b)
    down.reverse()
    route.extend(down)
    route.push(to)
    route

# ---------------- the legs of a job ----------------

enum LegKind: walk, haul, hop_on, craft, work, hop_off

struct WorkLeg:
    kind: LegKind
    points: vec3[]                  # walk: world points on the quay; craft: points in the craft frame
    from: vec3 = vec3(0, 0, 0)      # hop_on: from the quay (world) to the craft frame; hop_off: back
    to: vec3 = vec3(0, 0, 0)
    target: vec3 = vec3(0, 0, 0)    # work: what he works on (craft frame)
    pose: WorkPose = .stand
    seconds = 0.0
    line = ""
    aboard = false                  # work: standing on the airframe (else on the quay)

# The whole job as legs: to the quay's edge, aboard by the shortest step, along the airframe to
# each stop, the work itself, and back ashore. `quay` as in choose_stand.
plan_work = (l: CraftLayout, frame: mat4, stops: WorkStop[], quay: (vec3) -> vec3?) -> WorkLeg[]:
    legs: WorkLeg[]
    board = choose_boarding(l, frame, quay)
    aboard = false
    here = -1; spot = vec3(0, 0, 0)
    near = if board.surface >= 0: l.surfaces[board.surface].side else: 0.0
    loop stop in stops:
        c = choose_stand(l, frame, stop, quay, near)
        if not c.on_quay and board.gap >= 999.0: continue
        if not c.on_quay and not board.ok:
            # (it can't be reached from aboard either: as near as the quay's edge allows)
            c.on_quay = true; c.quay = board.quay; c.stretched = true
        if c.on_quay:
            if aboard:
                legs.push(WorkLeg(.craft, craft_route(l, here, spot, board.surface, board.spot)))
                legs.push(WorkLeg(.hop_off, [], board.spot, board.quay))
                aboard = false
            legs.push(WorkLeg(.walk, [c.quay]))
            legs.push(WorkLeg(.work, [c.quay], target = c.target, pose = c.pose, seconds = stop.seconds, line = stop.line, aboard = false))
        else:
            if not aboard:
                legs.push(WorkLeg(.walk, [board.quay]))
                legs.push(WorkLeg(.hop_on, [], board.quay, board.spot))
                aboard = true; here = board.surface; spot = board.spot
            legs.push(WorkLeg(.craft, craft_route(l, here, spot, c.surface, c.spot)))
            legs.push(WorkLeg(.work, [c.spot], target = c.target, pose = c.pose, seconds = stop.seconds, line = stop.line, aboard = true))
            here = c.surface; spot = c.spot
    if aboard:
        legs.push(WorkLeg(.craft, craft_route(l, here, spot, board.surface, board.spot)))
        legs.push(WorkLeg(.hop_off, [], board.spot, board.quay))
    legs

# How the figure stands for each pose (src/folk.jo postures: 0 upright, 2 arms up, 3 leaning in,
# 4 down on a knee).
work_posture = (pose: WorkPose) -> int:
    match pose:
        .reach_up, .climb: 2
        .lean, .haul: 3
        .crouch: 4
        _: 0
