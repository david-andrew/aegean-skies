# The rooms of a stay (src/stay.jo), built in code: the hotel's room upstairs, and a family's
# kitchen with the room at the back. Room-local, the floor's middle at 0 and +z toward the hotel
# room's French window (or the family's back room). Drawn last, over a cleared depth, so the town's
# walls never show through them (clear_depth).
#
# Lived in, and lit as a room is: walls, floor and ceiling are tiled so light can pool on them,
# and each room is baked three times into its vertices' colours: by day (the window's cool light,
# falling off into the room), of an evening (the lamp's warm pool and the dark corners beyond it),
# and asleep (the lamp out, a little moonlight at the window). The game draws whichever fits, in a
# flat light that shows the baked colours as they are (stay_room_light). A family's house shows
# their trade: nets and floats for those who live by the sea, jars and baskets for the land, tools
# for a craftsman, books for those who read, a sewing table otherwise.

use 'look.jo'
use 'objects.jo'
use 'stay.jo'

_ST_PLASTER = rgb(0.86, 0.76, 0.6)
_ST_WASH = rgb(0.92, 0.89, 0.8)
_ST_BOARDS = rgb(0.46, 0.32, 0.2)
_ST_DARK = rgb(0.24, 0.16, 0.1)
_ST_IRON = rgb(0.16, 0.16, 0.17)
_ST_LINEN = rgb(0.95, 0.94, 0.9)
_ST_GLOW = rgba(1.0, 0.82, 0.5, 0.85)          # (alpha under 0.9: it glows after dark)

# what lights a room: lamps (room-local, warm, by night) and its window (cool, by day)
struct RoomLight:
    lamps: vec4[]                   # xyz the lamp, w its reach (metres)
    window: vec3                    # the window's middle
    window_reach = 1.8

HOTEL_LIGHT = RoomLight([vec4(-0.35, 0.72, -1.55, 1.1), vec4(1.82, 1.85, -1.2, 0.7)], vec3(0, 1.2, 2.0), 1.9)
FAMILY_LIGHT = RoomLight([vec4(0.0, 1.5, -0.7, 1.15), vec4(2.0, 1.36, 1.6, 0.45)], vec3(2.05, 1.35, -0.7), 1.4)

struct StayRooms:
    hotel: Mesh[]                   # (by day, of an evening, asleep)
    family: Mesh[]
    hotel_things: Mesh[][]          # (each mode's: each of src/room_walk.jo's room_objects alone, lit as
    family_things: Mesh[][]         # the room is, drawn again a little brighter when pointed at)
    family_trade = -1               # (the trade the family's house was built for)
    lamp: Mesh                      # (a lamp's glow: drawn while it is lit)
    hotel_lamp: Mesh

# ---------------- surfaces ----------------

_quad2 = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, n: vec3, col: vec4):
    # (wound to face `n`, as add_box winds its faces)
    flip = f64(dot(cross(b - a, c - a), n)) < 0.0
    order = if flip: [a, c, b, a, d, c] else: [a, b, c, a, c, d]
    loop p in order: vs.push(Vertex3D(p, n, vec2(0, 0), col))

# A flat surface in tiles of about `tile` metres: from `o`, `u` along one edge and `v` the other,
# facing `n`. Tiles let the baked light pool on it.
_tiled = (vs: mut Vertex3D[], o: vec3, u: vec3, v: vec3, n: vec3, col: vec4, tile: f64 = 0.33):
    nu = max(1, int(f64(length(u)) / tile + 0.5)); nv = max(1, int(f64(length(v)) / tile + 0.5))
    loop i in 0..nu:
        loop j in 0..nv:
            p = o + u * f32(f64(i) / f64(nu)) + v * f32(f64(j) / f64(nv))
            du = u * f32(1.0 / f64(nu)); dv = v * f32(1.0 / f64(nv))
            _quad2(vs, p, p + du, p + du + dv, p + dv, n, col)

# the shell of a room `w` wide (x), `d` deep (z), `h` high: floor, ceiling and four walls, tiled,
# with `skip` an opening in the +z wall (x0, x1, y1: its sides and top), if any
_shell = (vs: mut Vertex3D[], w: f64, d: f64, h: f64, floor: vec4, walls: vec4, ceiling: vec4, open_x0: f64 = 0.0, open_x1: f64 = 0.0, open_y1: f64 = 0.0):
    hw = f32(w * 0.5); hd = f32(d * 0.5); fh = f32(h)
    _tiled(vs, vec3(-hw, 0, -hd), vec3(f32(w), 0, 0), vec3(0, 0, f32(d)), vec3(0, 1, 0), floor)
    _tiled(vs, vec3(-hw, fh, -hd), vec3(f32(w), 0, 0), vec3(0, 0, f32(d)), vec3(0, -1, 0), ceiling)
    _tiled(vs, vec3(-hw, 0, -hd), vec3(0, 0, f32(d)), vec3(0, fh, 0), vec3(1, 0, 0), walls)
    _tiled(vs, vec3(hw, 0, -hd), vec3(0, 0, f32(d)), vec3(0, fh, 0), vec3(-1, 0, 0), walls)
    _tiled(vs, vec3(-hw, 0, -hd), vec3(f32(w), 0, 0), vec3(0, fh, 0), vec3(0, 0, 1), walls)
    if open_x1 > open_x0:
        _tiled(vs, vec3(-hw, 0, hd), vec3(f32(f64(open_x0) + w * 0.5), 0, 0), vec3(0, fh, 0), vec3(0, 0, -1), walls)
        _tiled(vs, vec3(f32(open_x1), 0, hd), vec3(f32(w * 0.5 - open_x1), 0, 0), vec3(0, fh, 0), vec3(0, 0, -1), walls)
        _tiled(vs, vec3(f32(open_x0), f32(open_y1), hd), vec3(f32(open_x1 - open_x0), 0, 0), vec3(0, f32(h - open_y1), 0), vec3(0, 0, -1), walls)
    else: _tiled(vs, vec3(-hw, 0, hd), vec3(f32(w), 0, 0), vec3(0, fh, 0), vec3(0, 0, -1), walls)

_chair = (vs: mut Vertex3D[], s: Seat, col: vec4):
    m = translation(s.at) * rotation_y(s.yaw)
    add_box(vs, vec3(0, 0.45, 0), vec3(0.42, 0.05, 0.4), col, m)
    loop dx in [-0.18, 0.18]:
        loop dz in [-0.16, 0.16]: add_box(vs, vec3(f32(dx), 0.22, f32(dz)), vec3(0.04, 0.45, 0.04), col, m)
    add_box(vs, vec3(0, 0.75, -0.19), vec3(0.42, 0.55, 0.04), col, m)

# a framed picture on a wall facing `n` (a landscape in a few colour blocks, or a portrait)
_picture = (vs: mut Vertex3D[], c: vec3, n: vec3, w: f64, h: f64, frame: vec4, kind: int):
    side = normalize(cross(vec3(0, 1, 0), n))
    out = n * 0.012
    add_box(vs, c + out, vec3(f32(abs(side.x) * w + abs(n.x) * 0.03), f32(h), f32(abs(side.z) * w + abs(n.z) * 0.03)), frame)
    inner = c + out * 2.2
    iw = w - 0.07; ih = h - 0.07
    if kind == 0:
        # (a sea and a sky, a headland)
        add_box(vs, inner + vec3(0, f32(ih * 0.22), 0), vec3(f32(abs(side.x) * iw + abs(n.x) * 0.01), f32(ih * 0.56), f32(abs(side.z) * iw + abs(n.z) * 0.01)), rgb(0.66, 0.74, 0.76))
        add_box(vs, inner - vec3(0, f32(ih * 0.22), 0), vec3(f32(abs(side.x) * iw + abs(n.x) * 0.01), f32(ih * 0.44), f32(abs(side.z) * iw + abs(n.z) * 0.01)), rgb(0.2, 0.38, 0.48))
        add_box(vs, inner + out + side * f32(-iw * 0.25), vec3(f32(abs(side.x) * iw * 0.4 + abs(n.x) * 0.01), f32(ih * 0.3), f32(abs(side.z) * iw * 0.4 + abs(n.z) * 0.01)), rgb(0.42, 0.38, 0.26))
    else:
        # (a portrait: a dark ground, a pale face, a dark coat)
        add_box(vs, inner, vec3(f32(abs(side.x) * iw + abs(n.x) * 0.01), f32(ih), f32(abs(side.z) * iw + abs(n.z) * 0.01)), rgb(0.2, 0.17, 0.13))
        add_sphere(vs, inner + out + vec3(0, f32(ih * 0.12), 0), ih * 0.17, rgb(0.8, 0.66, 0.52), 6, 4)
        add_box(vs, inner + out - vec3(0, f32(ih * 0.3), 0), vec3(f32(abs(side.x) * iw * 0.55 + abs(n.x) * 0.01), f32(ih * 0.36), f32(abs(side.z) * iw * 0.55 + abs(n.z) * 0.01)), rgb(0.1, 0.1, 0.12))

# a curtain hanging in folds along x from `top`, `w` wide and `h` long, off a wall facing -z
_curtain = (vs: mut Vertex3D[], top: vec3, w: f64, h: f64, col: vec4):
    folds = max(3, int(w / 0.12))
    loop k in 0..folds:
        x = f64(top.x) - w * 0.5 + (f64(k) + 0.5) * w / f64(folds)
        shade = if k % 2 == 0: 1.0 else: 0.82
        add_box(vs, vec3(f32(x), f32(f64(top.y) - h * 0.5), top.z + f32(if k % 2 == 0: -0.02 else: 0.0)), vec3(f32(w / f64(folds) + 0.01), f32(h), 0.03), vec4(col.xyz * f32(shade), 1))

# jars on a shelf: a shelf board on its brackets, and jars of a few sizes and glazes
_jar_shelf = (vs: mut Vertex3D[], c: vec3, n: vec3, len: f64, seed: int):
    side = normalize(cross(vec3(0, 1, 0), n))
    add_box(vs, c + n * 0.12, vec3(f32(abs(side.x) * len + abs(n.x) * 0.24), 0.03, f32(abs(side.z) * len + abs(n.z) * 0.24)), _ST_DARK)
    glazes = [rgb(0.62, 0.36, 0.2), rgb(0.3, 0.42, 0.34), rgb(0.82, 0.78, 0.66), rgb(0.48, 0.3, 0.2), rgb(0.2, 0.3, 0.46)]
    k = 0
    x = -len * 0.5 + 0.08
    loop x < len * 0.5 - 0.06:
        r = 0.045 + 0.02 * f64((seed + k * 3) % 3)
        hgt = 0.1 + 0.06 * f64((seed + k * 7) % 3)
        add_cylinder(vs, c + n * 0.12 + side * f32(x) + vec3(0, 0.015, 0), r, hgt, glazes[(seed + k) % glazes.len()], 8, r * 0.75)
        x += r * 2.0 + 0.04
        k += 1

# ---------------- the hotel's room ----------------

# (the rooms' things, by their vertices: [first, past the last] for each of room_objects in order)
build_hotel_room = (things: mut int[]) -> Vertex3D[]:
    vs: Vertex3D[]
    h = 2.95
    _shell(vs, 3.7, 4.0, h, _ST_BOARDS, _ST_PLASTER, _ST_WASH, -0.68, 0.68, 2.42)
    loop k in 0..9: add_box(vs, vec3(f32(-1.6 + f64(k) * 0.4), 0.003, 0), vec3(0.01, 0.004, 3.9), rgb(0.36, 0.25, 0.16))
    # (skirting, a picture rail)
    loop x in [-1.84, 1.84]: add_box(vs, vec3(f32(x), 0.07, 0), vec3(0.02, 0.14, 4.0), _ST_DARK)
    loop x in [-1.84, 1.84]: add_box(vs, vec3(f32(x), 2.3, 0), vec3(0.02, 0.04, 4.0), _ST_DARK)
    # (the French window: its leaves open into the room, a frame round them, curtains either side)
    win0 = vs.len()
    loop side in [-1.0, 1.0]:
        add_box(vs, vec3(f32(side * 0.7), 1.21, 1.94), vec3(0.06, 2.42, 0.14), _ST_WASH)
        leaf = translation(vec3(f32(side * 0.66), 0, 1.92)) * rotation_y(side * 1.25)
        add_box(vs, vec3(f32(-side * 0.32), 1.2, 0), vec3(0.62, 2.3, 0.04), rgb(0.82, 0.85, 0.8), leaf)
        add_box(vs, vec3(f32(-side * 0.32), 1.2, 0), vec3(0.5, 2.1, 0.045), rgba(0.62, 0.74, 0.8, 1), leaf)
        _curtain(vs, vec3(f32(side * 1.12), 2.55, 1.9), 0.55, 2.45, rgb(0.78, 0.6, 0.34))
    add_box(vs, vec3(0, 2.44, 1.94), vec3(1.46, 0.06, 0.14), _ST_WASH)
    add_box(vs, vec3(0, 2.6, 1.88), vec3(2.9, 0.04, 0.04), rgb(0.66, 0.5, 0.25))
    win1 = vs.len()
    # (outside: the balcony and its rail, as the hotel's front has them)
    add_box(vs, vec3(0, -0.06, 2.8), vec3(3.7, 0.12, 1.5), _ST_WASH)
    loop k in 0..10: add_cylinder(vs, vec3(f32(-1.75 + f64(k) * 0.39), 0, 3.48), 0.025, 0.95, _ST_IRON, 5)
    add_box(vs, vec3(0, 0.96, 3.48), vec3(3.7, 0.05, 0.06), _ST_IRON)
    # (the bed: an iron frame, the mattress, a blanket turned down, a pillow)
    bed0 = vs.len()
    b = HOTEL_BED
    loop dx in [-0.45, 0.45]:
        loop dz in [-0.98, 0.98]: add_cylinder(vs, vec3(b.x + f32(dx), 0, b.z + f32(dz)), 0.025, 0.42, _ST_IRON, 5)
        add_cylinder(vs, vec3(b.x + f32(dx), 0, b.z - 1.0), 0.025, 1.05, _ST_IRON, 5)
    add_box(vs, vec3(b.x, 0.95, b.z - 1.0), vec3(0.95, 0.04, 0.04), _ST_IRON)
    add_box(vs, vec3(b.x, 0.42, b.z), vec3(0.95, 0.1, 2.0), _ST_IRON)
    add_box(vs, vec3(b.x, b.y - 0.02, b.z), vec3(0.9, 0.12, 1.95), _ST_LINEN)
    add_box(vs, vec3(b.x, b.y + 0.06, b.z + 0.3), vec3(0.96, 0.05, 1.3), rgb(0.55, 0.17, 0.14))
    add_box(vs, vec3(b.x, b.y + 0.09, b.z - 0.32), vec3(0.96, 0.03, 0.12), _ST_LINEN)
    add_box(vs, vec3(b.x, b.y + 0.1, b.z - 0.78), vec3(0.6, 0.1, 0.3), _ST_LINEN)
    bed1 = vs.len()
    # (a picture over the bed, a portrait by the door)
    _picture(vs, vec3(-1.84, 1.75, -0.25), vec3(1, 0, 0), 0.7, 0.5, rgb(0.6, 0.45, 0.2), 0)
    _picture(vs, vec3(1.84, 1.6, 0.6), vec3(-1, 0, 0), 0.32, 0.42, rgb(0.3, 0.2, 0.12), 1)
    # (a washstand: marble on dark wood, the jug in its basin, a towel, a mirror above)
    add_box(vs, vec3(1.5, 0.4, -0.7), vec3(0.5, 0.8, 0.9), _ST_DARK)
    add_box(vs, vec3(1.5, 0.82, -0.7), vec3(0.54, 0.04, 0.94), rgb(0.88, 0.87, 0.84))
    add_cylinder(vs, vec3(1.5, 0.84, -0.7), 0.2, 0.08, _ST_LINEN, 12, 0.24)
    add_cylinder(vs, vec3(1.5, 0.86, -0.7), 0.07, 0.28, _ST_LINEN, 10, 0.05)
    add_box(vs, vec3(1.76, 0.6, -0.35), vec3(0.02, 0.4, 0.22), _ST_LINEN)
    add_box(vs, vec3(1.83, 1.45, -0.7), vec3(0.02, 0.6, 0.45), rgb(0.55, 0.4, 0.2))
    add_box(vs, vec3(1.82, 1.45, -0.7), vec3(0.02, 0.52, 0.37), rgb(0.62, 0.68, 0.7))
    # (a wardrobe in the corner by the door)
    add_box(vs, vec3(-1.45, 1.0, -1.65), vec3(0.75, 2.0, 0.6), rgb(0.3, 0.2, 0.12))
    add_box(vs, vec3(-1.45, 1.0, -1.34), vec3(0.02, 1.8, 0.02), _ST_DARK)
    loop dx in [-0.06, 0.06]: add_sphere(vs, vec3(-1.45 + f32(dx), 1.05, -1.34), 0.02, rgb(0.8, 0.66, 0.3), 4, 3)
    # (the chair by the window, a small table at the bed's head with the lamp; flowers by the window)
    chair0 = vs.len()
    _chair(vs, HOTEL_CHAIR, rgb(0.42, 0.28, 0.17))
    chair1 = vs.len()
    add_box(vs, vec3(-0.35, 0.55, -1.55), vec3(0.4, 0.04, 0.4), _ST_DARK)
    add_cylinder(vs, vec3(-0.35, 0, -1.55), 0.03, 0.55, _ST_DARK, 5)
    add_cylinder(vs, vec3(-0.35, 0.57, -1.55), 0.06, 0.04, rgb(0.66, 0.5, 0.25), 8)
    add_cylinder(vs, vec3(1.3, 0, 1.6), 0.03, 0.7, _ST_DARK, 5)
    add_box(vs, vec3(1.3, 0.71, 1.6), vec3(0.42, 0.03, 0.42), _ST_DARK)
    add_cylinder(vs, vec3(1.3, 0.72, 1.6), 0.05, 0.2, rgb(0.3, 0.45, 0.55), 8, 0.03)
    loop k in 0..5: add_sphere(vs, vec3(1.3 + f32(f64(k % 3 - 1) * 0.04), 0.95 + f32(f64(k / 3) * 0.05), 1.6 + f32(f64(k % 2) * 0.03)), 0.035, if k % 2 == 0: rgb(0.85, 0.3, 0.2) else: rgb(0.95, 0.85, 0.4), 5, 3)
    # (the pilot's things: a leather bag at the bed's foot, the goggles on the table)
    add_box(vs, vec3(-0.35, 0.16, 0.9), vec3(0.5, 0.3, 0.26), rgb(0.42, 0.26, 0.14))
    add_box(vs, vec3(-0.35, 0.33, 0.9), vec3(0.3, 0.04, 0.04), rgb(0.3, 0.18, 0.1))
    loop dx in [-0.05, 0.05]: add_cylinder(vs, vec3(1.25 + f32(dx), 0.73, 1.45), 0.03, 0.025, rgb(0.5, 0.6, 0.55), 8)
    # (a rug)
    add_box(vs, vec3(0.2, 0.004, 0.3), vec3(1.4, 0.008, 2.0), rgb(0.48, 0.16, 0.13))
    add_box(vs, vec3(0.2, 0.006, 0.3), vec3(1.1, 0.008, 1.7), rgb(0.66, 0.45, 0.25))
    # (the door out to the corridor, in the wall at the bed's foot)
    door0 = vs.len()
    d = HOTEL_DOOR
    add_box(vs, vec3(d.x + 0.02, 1.05, d.z), vec3(0.04, 2.1, 0.85), rgb(0.36, 0.24, 0.15))
    add_box(vs, vec3(d.x + 0.045, 1.05, d.z), vec3(0.01, 2.16, 0.95), _ST_DARK)
    add_box(vs, vec3(d.x + 0.05, 1.05, d.z), vec3(0.01, 2.06, 0.81), rgb(0.36, 0.24, 0.15))
    add_sphere(vs, vec3(d.x + 0.07, 1.0, d.z - 0.3), 0.03, rgb(0.8, 0.66, 0.3), 5, 3)
    door1 = vs.len()
    things.clear()
    loop r in [bed0, bed1, chair0, chair1, win0, win1, door0, door1]: things.push(r)
    vs

# ---------------- a family's house ----------------

# The trade a host's work shows in their house: 0 the sea, 1 the land, 2 a craft, 3 reading, 4 the
# house and its sewing (by the living world's Occupation, as its index).
trade_of = (occupation: int) -> int:
    match occupation:
        6, 19: 0                     # fisher, sailor
        9, 10, 18: 1                 # oil presser, miller, farmer
        3, 8: 2                      # mechanic, telegraphist
        4, 11, 12, 13: 3             # clerk, teacher, nurse, priest
        else: 4

_trade_corner = (vs: mut Vertex3D[], trade: int):
    if trade == 0:
        # (a net hung on pegs, its cork floats, an oar against the wall, a basket trap)
        loop k in 0..9: add_box(vs, vec3(-2.04, f32(0.6 + f64(k) * 0.16), 1.05), vec3(0.01, 0.01, 1.1), rgb(0.5, 0.46, 0.36))
        loop k in 0..8: add_box(vs, vec3(-2.04, 1.25, f32(0.55 + f64(k) * 0.14)), vec3(0.01, 1.3, 0.01), rgb(0.5, 0.46, 0.36))
        loop k in 0..6: add_sphere(vs, vec3(-2.0, 1.95, f32(0.6 + f64(k) * 0.18)), 0.04, rgb(0.82, 0.56, 0.3), 5, 3)
        add_box(vs, vec3(-1.98, 1.0, 1.85), vec3(0.06, 2.0, 0.1), rgb(0.55, 0.42, 0.28), translation(vec3(-1.98, 1.0, 1.85)) * rotation_x(0.15) * translation(vec3(1.98, -1.0, -1.85)))
        add_cylinder(vs, vec3(-1.6, 0, 1.75), 0.28, 0.45, rgb(0.6, 0.48, 0.3), 10, 0.18)
    else if trade == 1:
        # (oil jars by the wall, sacks, a basket of olives, a hoe)
        loop k in 0..3: add_cylinder(vs, vec3(-1.85, 0, f32(0.35 + f64(k) * 0.5)), 0.2, 0.7 - f64(k) * 0.1, rgb(0.66, 0.42, 0.26), 10, 0.12)
        loop k in 0..2: add_box(vs, vec3(-1.35, 0.25, f32(1.6 + f64(k) * 0.05)), vec3(0.4, 0.5, 0.35), rgb(0.74, 0.66, 0.5))
        add_cylinder(vs, vec3(-1.25, 0, 0.9), 0.24, 0.26, rgb(0.6, 0.5, 0.3), 10, 0.3)
        add_sphere(vs, vec3(-1.25, 0.27, 0.9), 0.2, rgb(0.24, 0.26, 0.15), 6, 3)
        add_box(vs, vec3(-2.0, 0.85, 1.95), vec3(0.04, 1.7, 0.04), rgb(0.55, 0.42, 0.28))
        add_box(vs, vec3(-2.0, 1.7, 1.86), vec3(0.04, 0.05, 0.2), _ST_IRON)
    else if trade == 2:
        # (a workbench, a board of tools, a vise)
        add_box(vs, vec3(-1.75, 0.8, 1.2), vec3(0.6, 0.06, 1.3), rgb(0.5, 0.36, 0.22))
        loop dz in [0.65, 1.75]: add_box(vs, vec3(-1.75, 0.4, f32(dz)), vec3(0.5, 0.8, 0.06), rgb(0.42, 0.3, 0.18))
        add_box(vs, vec3(-2.04, 1.35, 1.2), vec3(0.02, 0.7, 1.2), rgb(0.55, 0.45, 0.32))
        loop k in 0..7: add_box(vs, vec3(-2.02, f32(1.2 + f64(k % 2) * 0.25), f32(0.72 + f64(k) * 0.14)), vec3(0.02, 0.24, 0.03), if k % 3 == 0: _ST_IRON else: rgb(0.4, 0.3, 0.2))
        add_box(vs, vec3(-1.55, 0.9, 0.75), vec3(0.14, 0.12, 0.2), _ST_IRON)
    else if trade == 3:
        # (a writing desk with its books, papers and inkwell; books along a shelf)
        add_box(vs, vec3(-1.7, 0.75, 1.3), vec3(0.7, 0.05, 1.1), rgb(0.38, 0.25, 0.15))
        loop dz in [0.82, 1.78]: add_box(vs, vec3(-1.7, 0.37, f32(dz)), vec3(0.6, 0.74, 0.05), rgb(0.32, 0.21, 0.13))
        loop k in 0..3: add_box(vs, vec3(-1.85, f32(0.8 + f64(k) * 0.05), 1.65), vec3(0.24, 0.05, 0.32), [rgb(0.45, 0.16, 0.12), rgb(0.2, 0.28, 0.4), rgb(0.5, 0.42, 0.26)][k])
        add_box(vs, vec3(-1.6, 0.78, 1.2), vec3(0.3, 0.005, 0.22), _ST_LINEN)
        add_cylinder(vs, vec3(-1.5, 0.78, 0.95), 0.03, 0.05, rgb(0.1, 0.1, 0.14), 6)
        add_box(vs, vec3(-2.02, 1.55, 1.2), vec3(0.24, 0.03, 1.2), _ST_DARK)
        loop k in 0..12: add_box(vs, vec3(-1.98, 1.68, f32(0.68 + f64(k) * 0.085)), vec3(0.16, f32(0.2 + f64(k % 3) * 0.03), 0.06), [rgb(0.45, 0.16, 0.12), rgb(0.2, 0.28, 0.4), rgb(0.5, 0.42, 0.26), rgb(0.25, 0.32, 0.2)][k % 4])
    else:
        # (a sewing table under the window's light: the treadle machine, cloth folded, the basket of mending)
        add_box(vs, vec3(-1.7, 0.74, 1.3), vec3(0.55, 0.04, 0.9), rgb(0.42, 0.28, 0.17))
        loop dz in [0.9, 1.7]: add_box(vs, vec3(-1.7, 0.37, f32(dz)), vec3(0.5, 0.74, 0.04), _ST_IRON)
        add_box(vs, vec3(-1.7, 0.06, 1.3), vec3(0.4, 0.04, 0.3), _ST_IRON)
        add_box(vs, vec3(-1.7, 0.86, 1.4), vec3(0.16, 0.2, 0.36), rgb(0.1, 0.1, 0.11))
        add_box(vs, vec3(-1.7, 0.98, 1.27), vec3(0.14, 0.06, 0.1), rgb(0.1, 0.1, 0.11))
        loop k in 0..3: add_box(vs, vec3(-1.75, f32(0.78 + f64(k) * 0.035), 1.0), vec3(0.3, 0.03, 0.28), [rgb(0.7, 0.62, 0.48), rgb(0.42, 0.5, 0.6), rgb(0.6, 0.3, 0.26)][k])
        add_cylinder(vs, vec3(-1.25, 0, 1.75), 0.2, 0.22, rgb(0.6, 0.48, 0.3), 10, 0.25)
        add_sphere(vs, vec3(-1.25, 0.24, 1.75), 0.15, rgb(0.86, 0.82, 0.74), 6, 3)

build_family_house = (trade: int, things: mut int[]) -> Vertex3D[]:
    vs: Vertex3D[]
    h = 2.45
    _shell(vs, 4.2, 4.1, h, rgb(0.55, 0.36, 0.25), _ST_WASH, _ST_WASH)
    loop k in 0..5: add_box(vs, vec3(0, f32(h - 0.08), f32(-1.6 + f64(k) * 0.8)), vec3(4.2, 0.16, 0.14), _ST_DARK)
    # (the low beam at the back room's opening; a curtain drawn half across it)
    add_box(vs, FAMILY_BEAM, vec3(4.2, 0.22, 0.22), _ST_DARK)
    add_box(vs, vec3(-1.45, 1.0, 0.82), vec3(1.2, 1.75, 0.03), rgb(0.62, 0.46, 0.28))
    # (strings of garlic and herbs hung from the beam)
    loop k in 0..4:
        x = -0.9 + f64(k) * 0.55
        loop j in 0..4: add_sphere(vs, vec3(f32(x), f32(1.62 - f64(j) * 0.09), 0.8), 0.04, if k % 2 == 0: rgb(0.9, 0.86, 0.76) else: rgb(0.36, 0.42, 0.24), 5, 3)
    # (the front door, the hearth with a pot on it, plates on a shelf, the icon and its lamp)
    door0 = vs.len()
    add_box(vs, FAMILY_DOOR + vec3(0, 1.0, 0), vec3(0.9, 2.0, 0.05), rgb(0.33, 0.42, 0.36))
    add_sphere(vs, FAMILY_DOOR + vec3(0.32, 1.0, 0.04), 0.03, _ST_IRON, 5, 3)
    door1 = vs.len()
    add_box(vs, vec3(-1.7, 0.45, -1.55), vec3(0.7, 0.9, 0.7), rgb(0.82, 0.78, 0.7))
    add_box(vs, vec3(-1.7, 0.35, -1.21), vec3(0.4, 0.35, 0.02), rgb(0.08, 0.05, 0.04))
    add_box(vs, vec3(-1.7, 1.25, -1.6), vec3(0.8, 0.7, 0.6), rgb(0.8, 0.76, 0.68))
    add_cylinder(vs, vec3(-1.7, 0.9, -1.55), 0.17, 0.22, rgb(0.2, 0.18, 0.17), 10, 0.2)
    add_box(vs, vec3(-2.04, 1.45, -0.3), vec3(0.14, 0.03, 1.0), _ST_DARK)
    loop k in 0..4: add_cylinder(vs, vec3(-2.0, 1.47, f32(-0.68 + f64(k) * 0.26)), 0.1, 0.02, if k % 2 == 0: rgb(0.88, 0.86, 0.8) else: rgb(0.3, 0.42, 0.62), 10, -1.0, translation(vec3(0, 0.1, 0)) * rotation_z(PI * 0.5) * translation(vec3(0, -0.1, 0)))
    add_box(vs, vec3(2.04, 1.65, 1.6), vec3(0.03, 0.4, 0.3), rgb(0.7, 0.55, 0.25))
    add_box(vs, vec3(2.025, 1.65, 1.6), vec3(0.02, 0.32, 0.22), rgb(0.42, 0.24, 0.16))
    add_cylinder(vs, vec3(2.0, 1.36, 1.6), 0.035, 0.06, rgb(0.75, 0.2, 0.15), 8)
    # (jars on a shelf by the hearth; a photograph in its frame)
    _jar_shelf(vs, vec3(-1.35, 1.75, -2.05), vec3(0, 0, 1), 0.9, trade)
    _picture(vs, vec3(0.6, 1.6, -2.05), vec3(0, 0, 1), 0.3, 0.38, rgb(0.25, 0.16, 0.1), 1)
    # (the window on the right: shutters closed, a cotton curtain gathered either side)
    add_box(vs, vec3(2.08, 1.35, -0.7), vec3(0.06, 1.1, 0.9), rgb(0.24, 0.42, 0.34))
    loop dz in [-1.27, -0.13]: add_box(vs, vec3(2.0, 1.4, f32(dz)), vec3(0.04, 1.3, 0.26), rgb(0.86, 0.8, 0.66))
    # (daylight between the shutters' slats)
    loop k in 0..6: add_box(vs, vec3(2.045, f32(0.9 + f64(k) * 0.17), -0.7), vec3(0.02, 0.03, 0.82), rgba(1.0, 0.94, 0.75, 1))
    # (the table and its chairs; a kilim under it)
    tbl = FAMILY_TABLE
    add_box(vs, vec3(tbl.x, 0.005, tbl.z), vec3(2.4, 0.01, 1.8), rgb(0.55, 0.18, 0.14))
    add_box(vs, vec3(tbl.x, 0.008, tbl.z), vec3(2.0, 0.01, 1.4), rgb(0.72, 0.5, 0.26))
    add_box(vs, vec3(tbl.x, 0.011, tbl.z), vec3(1.2, 0.01, 0.6), rgb(0.24, 0.3, 0.42))
    add_box(vs, vec3(tbl.x, 0.74, tbl.z), vec3(1.5, 0.05, 0.85), rgb(0.5, 0.36, 0.23))
    loop dx in [-0.68, 0.68]:
        loop dz in [-0.36, 0.36]: add_box(vs, vec3(tbl.x + f32(dx), 0.36, tbl.z + f32(dz)), vec3(0.05, 0.72, 0.05), rgb(0.42, 0.3, 0.19))
    add_box(vs, vec3(tbl.x, 0.77, tbl.z), vec3(1.3, 0.005, 0.7), rgb(0.9, 0.86, 0.78))
    chair0 = vs.len()
    _chair(vs, FAMILY_SEATS[0], rgb(0.46, 0.33, 0.2))
    chair1 = vs.len()
    loop k in 1..FAMILY_SEATS.len(): _chair(vs, FAMILY_SEATS[k], rgb(0.46, 0.33, 0.2))
    # (the bed in the back room: a wooden frame, a striped wool blanket, a pillow at the window end)
    bed0 = vs.len()
    bd = FAMILY_BED
    add_box(vs, vec3(bd.x, 0.22, bd.z), vec3(2.0, 0.44, 0.95), _ST_DARK)
    add_box(vs, vec3(bd.x, bd.y + 0.04, bd.z), vec3(1.95, 0.1, 0.9), _ST_LINEN)
    loop k in 0..5: add_box(vs, vec3(bd.x - 0.25 + f32(f64(k) * 0.26 - 0.5), bd.y + 0.11, bd.z), vec3(0.26, 0.05, 0.94), if k % 2 == 0: rgb(0.58, 0.17, 0.13) else: rgb(0.84, 0.76, 0.58))
    add_box(vs, vec3(bd.x + 0.8, bd.y + 0.14, bd.z), vec3(0.3, 0.1, 0.6), _ST_LINEN)
    bed1 = vs.len()
    _trade_corner(vs, trade)
    things.clear()
    loop r in [bed0, bed1, chair0, chair1, door0, door1]: things.push(r)
    vs

# ---------------- the light, baked ----------------

_falloff = (d: f64, reach: f64) -> f64: 1.0 / (1.0 + (d / reach) * (d / reach))

# Each vertex's colour as the room is lit: `mode` 0 by day, 1 of an evening, 2 asleep. Glowing
# things (alpha under 0.9: the lamps' shades) keep their own colour.
bake_room = (vs: Vertex3D[], lt: RoomLight, mode: int) -> Vertex3D[]:
    out: Vertex3D[]
    warm = vec3(1.0, 0.8, 0.52)
    cool = vec3(0.86, 0.92, 1.0)
    moon = vec3(0.32, 0.38, 0.56)
    loop v in vs:
        if v.color.w < 0.9:
            out.push(v)
            continue
        n = v.normal
        light = vec3(0, 0, 0)
        if mode == 1:
            light = vec3(0.13, 0.1, 0.08)
            loop l in lt.lamps:
                to = l.xyz - v.pos
                d = f64(length(to))
                face = 0.3 + 0.7 * max(0.0, f64(dot(n, to / f32(max(d, 0.001)))))
                light = light + warm * f32(2.4 * _falloff(d, f64(l.w)) * face)
        else:
            to = lt.window - v.pos
            d = f64(length(to))
            face = 0.35 + 0.65 * max(0.0, f64(dot(n, to / f32(max(d, 0.001)))))
            win = _falloff(d, lt.window_reach) * face
            light = if mode == 0: vec3(0.3, 0.29, 0.27) + cool * f32(1.15 * win) else: vec3(0.05, 0.05, 0.07) + moon * f32(0.7 * win)
        c = v.color.xyz * light
        out.push(Vertex3D(v.pos, v.normal, v.uv, vec4(min(c.x, 1.0), min(c.y, 1.0), min(c.z, 1.0), v.color.w)))
    out

_bake3 = (vs: Vertex3D[], lt: RoomLight) -> Mesh[]: [custom_mesh(bake_room(vs, lt, 0)), custom_mesh(bake_room(vs, lt, 1)), custom_mesh(bake_room(vs, lt, 2))]

# each mode's things alone, cut from the baked room by their vertices
_bake_things = (vs: Vertex3D[], lt: RoomLight, things: int[]) -> Mesh[][]:
    out: Mesh[][]
    loop mode in 0..3:
        baked = bake_room(vs, lt, mode)
        meshes: Mesh[]
        loop k in 0..things.len() / 2: meshes.push(custom_mesh([loop i in things[k * 2]..things[k * 2 + 1]: baked[i]]))
        out.push(meshes)
    out

build_stay_rooms = () -> StayRooms:
    lamp: Vertex3D[]
    add_cylinder(lamp, vec3(FAMILY_TABLE.x, 1.42, FAMILY_TABLE.z), 0.11, 0.22, _ST_GLOW, 12, 0.07)
    add_cylinder(lamp, vec3(FAMILY_TABLE.x, 1.64, FAMILY_TABLE.z), 0.01, 0.8, _ST_IRON, 4)
    hl: Vertex3D[]
    add_cylinder(hl, vec3(-0.35, 0.61, -1.55), 0.05, 0.16, _ST_GLOW, 10, 0.035)
    add_box(hl, vec3(1.82, 1.85, -1.2), vec3(0.06, 0.16, 0.1), _ST_GLOW)
    things: int[]
    room = build_hotel_room(things)
    StayRooms(_bake3(room, HOTEL_LIGHT), [], _bake_things(room, HOTEL_LIGHT, things), [], -1, custom_mesh(lamp), custom_mesh(hl))

# the family's house for their trade (built when first needed, kept while it is the same)
stay_family_rooms = (r: mut StayRooms, trade: int):
    if r.family_trade == trade and r.family.len() == 3: return
    things: int[]
    house = build_family_house(trade, things)
    r.family = _bake3(house, FAMILY_LIGHT)
    r.family_things = _bake_things(house, FAMILY_LIGHT, things)
    r.family_trade = trade

# The light the baked rooms are drawn in: flat, so their baked colours show as they are; the sun's
# direction kept (lamps glow after dark by it). `exposure` brightens or dims the whole.
stay_room_light = (L: Light, exposure: f64) -> Light:
    out = L
    out.sun = vec3(f32(exposure / 1.02), f32(exposure), f32(exposure / 0.94))
    out.shade = vec3(f32(exposure / 1.12), f32(exposure / 1.12), f32(exposure / 1.12))
    out.fog_density = 0.0
    out
