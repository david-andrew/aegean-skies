# The rooms of a stay (src/stay.jo), built in code: the hotel's room upstairs, and a family's
# kitchen with the room at the back. Room-local, the floor's middle at 0 and +z toward the hotel
# room's French window (or the family's back room). Drawn last, over a cleared depth, so the town's
# walls never show through them (src/depth_space.jo clear_world_depth).

use 'objects.jo'
use 'stay.jo'

_ST_PLASTER = rgb(0.9, 0.82, 0.7)
_ST_WASH = rgb(0.93, 0.92, 0.86)
_ST_BOARDS = rgb(0.5, 0.36, 0.23)
_ST_DARK = rgb(0.24, 0.16, 0.1)
_ST_IRON = rgb(0.16, 0.16, 0.17)
_ST_LINEN = rgb(0.95, 0.94, 0.9)
_ST_GLOW = rgba(1.0, 0.82, 0.5, 1)

struct StayRooms:
    hotel: Mesh
    family: Mesh
    slits: Mesh                     # (the family's shutters' daylight: drawn by day only)
    lamp: Mesh                      # (a lamp's glow: drawn while it is lit)
    hotel_lamp: Mesh

_wall_x = (vs: mut Vertex3D[], x: f64, z0: f64, z1: f64, h: f64, col: vec4):
    add_box(vs, vec3(f32(x), f32(h * 0.5), f32((z0 + z1) * 0.5)), vec3(0.12, f32(h), f32(z1 - z0)), col)
_wall_z = (vs: mut Vertex3D[], z: f64, x0: f64, x1: f64, y0: f64, y1: f64, col: vec4):
    add_box(vs, vec3(f32((x0 + x1) * 0.5), f32((y0 + y1) * 0.5), f32(z)), vec3(f32(x1 - x0), f32(y1 - y0), 0.12), col)

_chair = (vs: mut Vertex3D[], s: Seat, col: vec4):
    m = translation(s.at) * rotation_y(s.yaw)
    add_box(vs, vec3(0, 0.45, 0), vec3(0.42, 0.05, 0.4), col, m)
    loop dx in [-0.18, 0.18]:
        loop dz in [-0.16, 0.16]: add_box(vs, vec3(f32(dx), 0.22, f32(dz)), vec3(0.04, 0.45, 0.04), col, m)
    # (its back, behind the sitter)
    add_box(vs, vec3(0, 0.75, -0.19), vec3(0.42, 0.55, 0.04), col, m)

build_hotel_room = () -> Mesh:
    vs: Vertex3D[]
    h = 2.95
    add_box(vs, vec3(0, -0.05, 0), vec3(3.7, 0.1, 4.0), _ST_BOARDS)
    loop k in 0..9: add_box(vs, vec3(f32(-1.6 + f64(k) * 0.4), 0.002, 0), vec3(0.01, 0.004, 3.9), rgb(0.4, 0.28, 0.18))
    add_box(vs, vec3(0, f32(h + 0.05), 0), vec3(3.7, 0.1, 4.0), _ST_WASH)
    _wall_x(vs, -1.85, -2.0, 2.0, h, _ST_PLASTER)
    _wall_x(vs, 1.85, -2.0, 2.0, h, _ST_PLASTER)
    _wall_z(vs, -2.0, -1.85, 1.85, 0.0, h, _ST_PLASTER)
    # (the sea wall, the French window's opening in it)
    _wall_z(vs, 2.0, -1.85, -0.68, 0.0, h, _ST_PLASTER)
    _wall_z(vs, 2.0, 0.68, 1.85, 0.0, h, _ST_PLASTER)
    _wall_z(vs, 2.0, -0.68, 0.68, 2.42, h, _ST_PLASTER)
    # (skirting, the door to the corridor, a picture)
    loop x in [-1.79, 1.79]: add_box(vs, vec3(f32(x), 0.07, 0), vec3(0.02, 0.14, 4.0), _ST_DARK)
    add_box(vs, vec3(1.0, 1.05, -1.93), vec3(0.85, 2.1, 0.04), rgb(0.36, 0.24, 0.15))
    add_sphere(vs, vec3(0.7, 1.0, -1.9), 0.03, rgb(0.8, 0.66, 0.3), 5, 3)
    add_box(vs, vec3(1.79, 1.65, 0.1), vec3(0.03, 0.55, 0.75), rgb(0.66, 0.5, 0.25))
    add_box(vs, vec3(1.775, 1.65, 0.1), vec3(0.02, 0.45, 0.65), rgb(0.42, 0.55, 0.62))
    # (the French window: its two leaves open into the room, a frame round them)
    loop side in [-1.0, 1.0]:
        add_box(vs, vec3(f32(side * 0.7), 1.21, 1.94), vec3(0.06, 2.42, 0.14), _ST_WASH)
        leaf = translation(vec3(f32(side * 0.66), 0, 1.92)) * rotation_y(side * 1.25)
        add_box(vs, vec3(f32(-side * 0.32), 1.2, 0), vec3(0.62, 2.3, 0.04), rgb(0.82, 0.85, 0.8), leaf)
        add_box(vs, vec3(f32(-side * 0.32), 1.2, 0), vec3(0.5, 2.1, 0.045), rgba(0.62, 0.74, 0.8, 1), leaf)
    add_box(vs, vec3(0, 2.44, 1.94), vec3(1.46, 0.06, 0.14), _ST_WASH)
    # (outside: the balcony and its rail, as the hotel's front has them)
    add_box(vs, vec3(0, -0.06, 2.8), vec3(3.7, 0.12, 1.5), _ST_WASH)
    loop k in 0..10:
        add_cylinder(vs, vec3(f32(-1.75 + f64(k) * 0.39), 0, 3.48), 0.025, 0.95, _ST_IRON, 5)
    add_box(vs, vec3(0, 0.96, 3.48), vec3(3.7, 0.05, 0.06), _ST_IRON)
    # (the bed: an iron frame, the mattress, a blanket turned down, a pillow)
    b = HOTEL_BED
    loop dx in [-0.45, 0.45]:
        loop dz in [-0.98, 0.98]: add_cylinder(vs, vec3(b.x + f32(dx), 0, b.z + f32(dz)), 0.025, 0.42, _ST_IRON, 5)
        add_cylinder(vs, vec3(b.x + f32(dx), 0, b.z - 1.0), 0.025, 1.05, _ST_IRON, 5)
    add_box(vs, vec3(b.x, 0.95, b.z - 1.0), vec3(0.95, 0.04, 0.04), _ST_IRON)
    add_box(vs, vec3(b.x, 0.42, b.z), vec3(0.95, 0.1, 2.0), _ST_IRON)
    add_box(vs, vec3(b.x, b.y - 0.02, b.z), vec3(0.9, 0.12, 1.95), _ST_LINEN)
    add_box(vs, vec3(b.x, b.y + 0.06, b.z + 0.3), vec3(0.96, 0.05, 1.3), rgb(0.62, 0.2, 0.16))
    add_box(vs, vec3(b.x, b.y + 0.09, b.z - 0.32), vec3(0.96, 0.03, 0.12), _ST_LINEN)
    add_box(vs, vec3(b.x, b.y + 0.1, b.z - 0.78), vec3(0.6, 0.1, 0.3), _ST_LINEN)
    # (a washstand: marble on dark wood, the jug in its basin; a towel)
    add_box(vs, vec3(1.5, 0.4, -0.7), vec3(0.5, 0.8, 0.9), _ST_DARK)
    add_box(vs, vec3(1.5, 0.82, -0.7), vec3(0.54, 0.04, 0.94), rgb(0.88, 0.87, 0.84))
    add_cylinder(vs, vec3(1.5, 0.84, -0.7), 0.2, 0.08, _ST_LINEN, 12, 0.24)
    add_cylinder(vs, vec3(1.5, 0.86, -0.7), 0.07, 0.28, _ST_LINEN, 10, 0.05)
    add_box(vs, vec3(1.76, 0.6, -0.35), vec3(0.02, 0.4, 0.22), _ST_LINEN)
    # (the chair by the window, and a small table at the bed's head with the lamp on it)
    _chair(vs, HOTEL_CHAIR, rgb(0.42, 0.28, 0.17))
    add_box(vs, vec3(-0.35, 0.55, -1.55), vec3(0.4, 0.04, 0.4), _ST_DARK)
    add_cylinder(vs, vec3(-0.35, 0, -1.55), 0.03, 0.55, _ST_DARK, 5)
    add_cylinder(vs, vec3(-0.35, 0.57, -1.55), 0.06, 0.04, rgb(0.66, 0.5, 0.25), 8)
    # (a rug)
    add_box(vs, vec3(0.2, 0.004, 0.3), vec3(1.4, 0.008, 2.0), rgb(0.55, 0.18, 0.15))
    add_box(vs, vec3(0.2, 0.006, 0.3), vec3(1.1, 0.008, 1.7), rgb(0.72, 0.5, 0.28))
    custom_mesh(vs)

build_family_house = () -> Mesh:
    vs: Vertex3D[]
    h = 2.45
    # (the stone floor, whitewashed walls, dark beams across)
    add_box(vs, vec3(0, -0.05, 0), vec3(4.3, 0.1, 4.2), rgb(0.62, 0.4, 0.28))
    loop k in 0..7: add_box(vs, vec3(0, 0.002, f32(-1.8 + f64(k) * 0.6)), vec3(4.2, 0.004, 0.01), rgb(0.5, 0.32, 0.22))
    add_box(vs, vec3(0, f32(h + 0.05), 0), vec3(4.3, 0.1, 4.2), _ST_WASH)
    loop k in 0..5: add_box(vs, vec3(0, f32(h - 0.08), f32(-1.6 + f64(k) * 0.8)), vec3(4.2, 0.16, 0.14), _ST_DARK)
    _wall_x(vs, -2.1, -2.05, 2.05, h, _ST_WASH)
    _wall_x(vs, 2.1, -2.05, 2.05, h, _ST_WASH)
    _wall_z(vs, -2.05, -2.1, 2.1, 0.0, h, _ST_WASH)
    _wall_z(vs, 2.05, -2.1, 2.1, 0.0, h, _ST_WASH)
    # (the low beam at the back room's opening; a curtain drawn half across it)
    add_box(vs, FAMILY_BEAM, vec3(4.2, 0.22, 0.22), _ST_DARK)
    add_box(vs, vec3(-1.45, 1.0, 0.82), vec3(1.2, 1.75, 0.03), rgb(0.66, 0.5, 0.32))
    # (the front door, the hearth with a pot on it, plates on a shelf, the icon and its lamp)
    add_box(vs, vec3(-1.1, 1.0, -2.0), vec3(0.9, 2.0, 0.05), rgb(0.33, 0.42, 0.36))
    add_box(vs, vec3(-1.7, 0.45, -1.55), vec3(0.7, 0.9, 0.7), rgb(0.86, 0.82, 0.74))
    add_box(vs, vec3(-1.7, 0.35, -1.21), vec3(0.4, 0.35, 0.02), rgb(0.12, 0.08, 0.06))
    add_box(vs, vec3(-1.7, 1.25, -1.6), vec3(0.8, 0.7, 0.6), rgb(0.84, 0.8, 0.72))
    add_cylinder(vs, vec3(-1.7, 0.9, -1.55), 0.17, 0.22, rgb(0.2, 0.18, 0.17), 10, 0.2)
    add_box(vs, vec3(-2.03, 1.45, 0.0), vec3(0.14, 0.03, 1.4), _ST_DARK)
    loop k in 0..5: add_cylinder(vs, vec3(-2.0, 1.47, f32(-0.56 + f64(k) * 0.28)), 0.1, 0.02, if k % 2 == 0: rgb(0.88, 0.86, 0.8) else: rgb(0.3, 0.42, 0.62), 10, -1.0, translation(vec3(0, 0.1, 0)) * rotation_z(PI * 0.5) * translation(vec3(0, -0.1, 0)))
    add_box(vs, vec3(2.03, 1.65, 1.6), vec3(0.03, 0.4, 0.3), rgb(0.7, 0.55, 0.25))
    add_box(vs, vec3(2.015, 1.65, 1.6), vec3(0.02, 0.32, 0.22), rgb(0.42, 0.24, 0.16))
    add_cylinder(vs, vec3(2.0, 1.36, 1.6), 0.035, 0.06, rgb(0.75, 0.2, 0.15), 8)
    # (the window on the right, its shutters closed)
    add_box(vs, vec3(2.06, 1.35, -0.7), vec3(0.06, 1.1, 0.9), rgb(0.24, 0.42, 0.34))
    # (the table and its chairs)
    tbl = FAMILY_TABLE
    add_box(vs, vec3(tbl.x, 0.74, tbl.z), vec3(1.5, 0.05, 0.85), rgb(0.55, 0.4, 0.26))
    loop dx in [-0.68, 0.68]:
        loop dz in [-0.36, 0.36]: add_box(vs, vec3(tbl.x + f32(dx), 0.36, tbl.z + f32(dz)), vec3(0.05, 0.72, 0.05), rgb(0.45, 0.32, 0.2))
    add_box(vs, vec3(tbl.x, 0.77, tbl.z), vec3(1.3, 0.005, 0.7), rgb(0.92, 0.88, 0.8))
    loop s in FAMILY_SEATS: _chair(vs, s, rgb(0.5, 0.36, 0.22))
    # (the bed in the back room: a wooden frame, a striped wool blanket, a pillow at the window end)
    bd = FAMILY_BED
    add_box(vs, vec3(bd.x, 0.22, bd.z), vec3(2.0, 0.44, 0.95), _ST_DARK)
    add_box(vs, vec3(bd.x, bd.y + 0.04, bd.z), vec3(1.95, 0.1, 0.9), _ST_LINEN)
    loop k in 0..5: add_box(vs, vec3(bd.x - 0.25 + f32(f64(k) * 0.26 - 0.5), bd.y + 0.11, bd.z), vec3(0.26, 0.05, 0.94), if k % 2 == 0: rgb(0.62, 0.18, 0.14) else: rgb(0.86, 0.78, 0.6))
    add_box(vs, vec3(bd.x + 0.8, bd.y + 0.14, bd.z), vec3(0.3, 0.1, 0.6), _ST_LINEN)
    custom_mesh(vs)

# (daylight between the slats of the family's closed shutters, drawn by day only)
build_family_slits = () -> Mesh:
    vs: Vertex3D[]
    loop k in 0..6: add_box(vs, vec3(2.025, f32(0.9 + f64(k) * 0.17), -0.7), vec3(0.02, 0.03, 0.82), rgba(1.0, 0.94, 0.75, 1))
    custom_mesh(vs)

build_stay_rooms = () -> StayRooms:
    lamp: Vertex3D[]
    add_cylinder(lamp, vec3(FAMILY_TABLE.x, 1.55, FAMILY_TABLE.z), 0.09, 0.2, _ST_GLOW, 10, 0.06)
    add_cylinder(lamp, vec3(FAMILY_TABLE.x, 1.75, FAMILY_TABLE.z), 0.01, 0.7, _ST_IRON, 4)
    hl: Vertex3D[]
    add_cylinder(hl, vec3(-0.35, 0.61, -1.55), 0.05, 0.16, _ST_GLOW, 10, 0.035)
    StayRooms(build_hotel_room(), build_family_house(), build_family_slits(), custom_mesh(lamp), custom_mesh(hl))
