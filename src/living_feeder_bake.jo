# Offline-only unpaved feeder tracks. Canonical terrain and existing building collision
# validate them; this never edits the authored settlement/road registry or runs in play.
use 'settlements.jo'
use 'living_far_types.jo'
import 'cargo_scene.jo' as walking

feeder_root = (parent: int[], node: int) -> int:
    at=node
    loop _ in 0..parent.len():
        if parent[at]==at: return at
        at=parent[at]
    node

feeder_segment_clear = (from: vec3,to: vec3) -> bool:
    delta=to.xz-from.xz; distance=f64(length(delta))
    if distance<0.01: return true
    side=vec2(-delta.y,delta.x)/f32(distance)
    count=max(1,int(ceil(distance/3.0))); last=place_ground(from.xz)
    loop i in 0..count+1:
        p=mix(from.xz,to.xz,f32(f64(i)/f64(count))); h=place_ground(p)
        if h<1.0 or abs(h-last)>distance/f64(count)*0.30+0.08: return false
        loop offset in [-0.8,0.0,0.8]:
            q=p+side*f32(offset)
            if place_ground(q)<0.8 or length(settlement_avoid_buildings(q)-q)>0.15: return false
        last=h
    true

feeder_track = (a: vec2,b: vec2) -> vec3[]:
    coarse=place_route(a,b)
    if coarse.len()<2: return []
    result=[coarse[0]]
    loop k in 1..coarse.len():
        from=result[result.len()-1]; to=coarse[k]
        if feeder_segment_clear(from,to): result.push(to); continue
        # Only repair a short local obstruction, with the same building/shore contact
        # as a person. A finer wagon-width/slope check can still refuse this detour.
        path=walking.cargo_walk_path([],from,to)
        if path.len()<2: return []
        loop j in 1..path.len():
            if not feeder_segment_clear(path[j-1],path[j]): return []
            result.push(path[j])
        if result.len()>4096: return []
    sampled=[result[0]]
    loop k in 1..result.len():
        from=result[k-1]; to=result[k]; count=max(1,int(ceil(f64(length(to.xz-from.xz))/12.0)))
        loop j in 1..count+1:
            sampled.push(place_point(mix(from.xz,to.xz,f32(f64(j)/f64(count)))))
            if sampled.len()>4096: return []
    sampled

append_feeder_tracks = (links: mut FarLink[],places: WorldSettlement[],limit: int = 1280) -> int:
    index: {int: int}; parent: int[]
    loop k in 0..places.len(): index[places[k].id]=k; parent.push(k)
    loop l in links:
        a=feeder_root(parent,index[l.a]); b=feeder_root(parent,index[l.b])
        if a!=b: parent[max(a,b)]=min(a,b)
    candidates: (f64,int,int)[]
    loop a in 0..places.len():
        loop b in a+1..places.len():
            if feeder_root(parent,a)==feeder_root(parent,b): continue
            d=f64(length(places[a].center.xz-places[b].center.xz))
            if d>=100.0 and d<=24000.0: candidates.push((d,a,b))
    candidates.sort((p: (f64,int,int)): p)
    added=0; refused=0; attempted=0
    loop pair in candidates:
        if links.len()>=limit or attempted>=2048: break
        a=feeder_root(parent,pair.1); b=feeder_root(parent,pair.2)
        if a==b: continue
        attempted+=1
        path=feeder_track(places[pair.1].center.xz,places[pair.2].center.xz)
        if path.len()<2: refused+=1; continue
        distance=0
        loop k in 1..path.len(): distance+=int(round(f64(length(path[k]-path[k-1]))*1000.0))
        links.push(FarLink(links.len(),places[pair.1].id,places[pair.2].id,.cart,path,distance,trail=true))
        parent[max(a,b)]=min(a,b); added+=1
        eprint("FEEDER_BAKE added={added} refused={refused} endpoints={places[pair.1].id}/{places[pair.2].id} length_m={distance/1000}")
    eprint("FEEDER_BAKE completed added={added} refused={refused} attempted={attempted} candidates={candidates.len()} routes={links.len()}")
    added
