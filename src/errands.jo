# Errands posted by the people whose work they are, at the hours they'd be wanted (the words are
# src/errand_words.jo; what each is, World.errands):
#   the mail bag, made up each morning at Porto Vecchio's office, for one island's post in turn,
#   and the island's back the next day; the postmaster at each end;
#   the morning papers, the Courier bundled at five for an island's tables by breakfast, for a
#   pilot who is up (the island couriers don't fly at dawn);
#   ice for the fishmonger, from the ice works every other morning, two hours before it is water;
#   sponges, a diver's dried catch from Mikra for a Porto Vecchio merchant, now and then;
#   the nurse, flown from Agios Nikolaos to a sick child in another harbour, now and then.
# Each is an ordinary job (post_job): carried closed (a sealed parcel minted at the sender's
# market) or as a passenger, paid through the ledger from the poster's purse, handed over on the
# dock to the one named (the dock handover), and told of after (the pilot's name, his day, leads).
use 'living_types.jo'
use 'errand_types.jo'
use 'errand_words.jo'
use 'living_jobs.jo'
use 'living_cargo.jo'

const ERRAND_TAG = 7501
const ERRAND_PLACES: int[] = [1, 2, 3]         # the islands the mail and the papers go to in turn

# Someone of `place` by trade, the first of `trades` found (by id), else its market's keeper.
errand_person = (w: World, place: int, trades: Occupation[]) -> int:
    loop t in trades:
        loop p in w.people:
            if p.id != w.player and p.home == place and p.occupation == t and p.state != .departed: return p.id
    w.places[place].market_owner

# The same, but only someone ashore at home now (a diver may be out at the beds).
errand_ashore = (w: World, place: int, trades: Occupation[]) -> int:
    loop t in trades:
        loop p in w.people:
            if p.id != w.player and p.home == place and p.occupation == t and p.place == place and p.trip < 0 and p.state != .departed: return p.id
    w.places[place].market_owner

errand_postmaster = (w: World, place: int) -> int: errand_person(w,place,[.clerk,.telegraphist,.teacher,.priest,.merchant])
errand_seller = (w: World, place: int) -> int: errand_person(w,place,[.innkeeper,.merchant,.hotelier,.teacher])
errand_fishmonger = (w: World, place: int) -> int: errand_person(w,place,[.fisher,.merchant])

# The price: a base and so much a kilometre between the harbours.
errand_price = (w: World, origin: int, destination: int, base: int, per_km: int) -> int:
    d = f64(length(w.harbors[origin].center-w.harbors[destination].center))/1000.0
    base+int(d*f64(per_km))

# A sealed errand: the parcel made up at the sender's market (minted there, theirs), the job posted,
# its recipient named. -1 when the sender can't (away, short of money, the harbour shut).
errand_parcel = (w: mut World, kind: ErrandKind, poster: int, destination: int, recipient: int, grams: int, reward: int, due: int) -> int:
    if poster < 0 or recipient < 0 or w.people[poster].place != w.people[poster].home or w.people[poster].trip >= 0: return -1
    a = w.people[poster].account
    if a < 0 or a >= w.accounts.len() or w.accounts[a].cents < reward: return -1
    origin = w.people[poster].place
    if origin == destination or w.places[origin].harbor_closed: return -1
    lot = cargo_mint(w,.market,origin,-1,1,poster,origin,.production,grams)
    if lot < 0: return -1
    job = post_job(w,poster,destination,.sealed,-1,1,reward,due,sealed_grams=grams)
    if job < 0:
        # (not posted: the parcel stays the sender's, at the office)
        return -1
    _errand_set(w,job,kind,recipient,"")
    job

_errand_set = (w: mut World, job: int, kind: ErrandKind, recipient: int, child: str):
    e = Errand(job=job,kind=kind,recipient=recipient,child=child,posted=w.minute)
    w.errands[job] = e
    w.jobs[job].cause.beneficiary = recipient
    w.jobs[job].context = errand_ask(w,e)

_already = (w: World, kind: ErrandKind, day: int) -> bool:
    loop _, e in w.errands:
        if e.kind == kind and day_index(e.posted) == day: return true
    false

errands_minute = (w: mut World):
    clock = local_minute(w.minute)
    day = day_index(w.minute)
    if day < 0 or w.places.len() < 4: return
    # (the papers at five: the Courier for one island in turn)
    if clock == 300 and not _already(w,.papers,day):
        to = ERRAND_PLACES[day%ERRAND_PLACES.len()]
        poster = errand_seller(w,0)
        job = errand_parcel(w,.papers,poster,to,errand_seller(w,to),6000,errand_price(w,0,to,700,25),w.minute+180)
        # (the island couriers don't fly at dawn: the papers go with a pilot who is up, or not at all)
        if job >= 0: w.jobs[job].npc_claim_after = w.jobs[job].expire_minute
    # (ice every other morning at six, for a fishing harbour's fish)
    if clock == 360 and day%2 == 0 and not _already(w,.ice,day):
        to = if (day/2)%2 == 0: 1 else: 3
        _ = errand_parcel(w,.ice,w.places[0].market_owner,to,errand_fishmonger(w,to),20000,errand_price(w,0,to,1400,40),w.minute+120)
    # (the mail at half past seven: out to an island one day, back the next)
    if clock == 450 and not _already(w,.mail,day):
        island = ERRAND_PLACES[(day/2)%ERRAND_PLACES.len()]
        from = if day%2 == 0: 0 else: island
        to = if day%2 == 0: island else: 0
        _ = errand_parcel(w,.mail,errand_postmaster(w,from),to,errand_postmaster(w,to),4000,errand_price(w,from,to,900,30),w.minute+270)
    # (sponges every third day from Mikra's divers)
    if clock == 540 and day%3 == 1 and not _already(w,.sponges,day):
        diver = errand_ashore(w,3,[.fisher,.sailor])
        _ = errand_parcel(w,.sponges,diver,0,errand_person(w,0,[.merchant]),15000,errand_price(w,3,0,1600,30),w.minute+600)
    # (now and then a child is ill in a harbour without a nurse: the nurse is wanted)
    if clock == 600 and day%5 == 2 and not _already(w,.nurse,day):
        nurse = errand_person(w,2,[.nurse])
        if nurse >= 0 and w.people[nurse].occupation == .nurse and w.people[nurse].place == w.people[nurse].home and w.people[nurse].trip < 0:
            sick: int[]
            loop k in 0..w.households.len():
                h = w.households[k]
                if h.age < 14 and h.home != w.people[nurse].home and h.home >= 0 and h.home < w.places.len() and h.guardian >= 0: sick.push(k)
            if sick.len() > 0:
                h = w.households[sick[draw1000000(w.seed,ERRAND_TAG,day,0)%sick.len()]]
                job = post_job(w,nurse,h.home,.none,-1,1,errand_price(w,w.people[nurse].home,h.home,2200,40),w.minute+180,passenger=nurse)
                if job >= 0: _errand_set(w,job,.nurse,h.guardian,split(h.name," ")[0])
    # (a month's errands are let go)
    if clock == 0:
        stale = [loop id, e in w.errands: if w.minute-e.posted > 30*1440: id]
        loop id in stale: w.errands.remove(id)
