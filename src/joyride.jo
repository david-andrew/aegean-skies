# A pleasure flight with someone from the town: they ask to be taken up (now and then, when the
# pilot comes to the aircraft at the dock), or the pilot offers. They climb into the second seat,
# and in the air they talk: nerves on the water and the take-off run, what they see below, their
# own house as the town passes under them, the landing. Back at a dock they thank the pilot and go.
# No fare, no needs, no penalty. Pure: the game says where the aircraft is and how it is doing,
# finds their house, draws them, and keeps the world's record of it.

enum RideStage: none, walking, seated, waiting, flying, landed, thanked

struct Joyride:
    stage: RideStage = .none
    wait_from = -1                  # (the world minute the pilot stepped away, asking them to wait)
    nudged = 0                      # (remarks made while waiting)
    who = -1                        # (the folk in the scene)
    person = -1                     # (the living-world person)
    nervous = false                 # (bold or not: their traits)
    home: vec3 = vec3(0, 0, 0)      # their house (world), to point out
    has_home = false
    origin = -1                     # (the town they set off from: theirs; no other town is "another")
    pos: vec3 = vec3(0, 0, 0)       # (walking to the aircraft)
    yaw = 0.0
    phase = 0.0
    flew = false                    # (been airborne)
    said: str[]                     # (the moments already spoken of, by key)
    line = ""
    line_until = 0.0
    next_line = 0.0
    pointing_until = 0.0            # (an arm out at their house)
    top = 0.0                       # (the highest it went, metres above the water)
    since = -1.0                    # (when the aircraft last changed between the water and the air)
    dest = -1                       # (a lift: the place they want setting down at; -1 a pleasure flight)
    dest_name = ""
    fare = 0                        # (what they pay for a lift, in cents, there)
    told_not_here = false

# What the flight is doing now, as the game sees it.
struct RideView:
    moored = false
    on_water = false
    speed = 0.0                     # m/s
    height = 0.0                    # metres above the water or ground under it
    climb = 0.0                     # m/s
    over_town = false               # (within the town's heart)
    house_near = false              # (their house within sight below)
    place_seen = ""                 # (another town in view, by name; "" none)
    wrecked = false
    throttle = 0.0

# The moments of a flight, each spoken of once, and the words for them (nervous, or not).
struct RideMoment:
    key: str
    calm: str
    nervous: str

RIDE_MOMENTS: RideMoment[] = [
    RideMoment("aboard", "I've wanted to do this for years. Where do I put my feet?", "I've never been up before. Is this strap meant to be this loose?"),
    RideMoment("throttle", "Listen to it! The whole thing shakes.", "Is it supposed to shake like that?"),
    RideMoment("run", "We're skipping on the water!", "Oh. Oh. Oh, oh..."),
    RideMoment("up", "We're up! We're really up!", "Are we up? I can't look. Are we up?"),
    RideMoment("boats", "Look how small the boats are.", "The boats look like toys. I'm all right. I'm all right."),
    RideMoment("house", "There! That's our house, by the square. Look, the washing's out!", "Is that our street? It is! There's our roof!"),
    RideMoment("sea", "You can see right down to the rocks from up here.", "The water's so clear. Don't go any higher, will you?"),
    RideMoment("high", "My ears have gone funny.", "My ears! Is that the height?"),
    RideMoment("other", "Is that {{place}}? I've only ever been there by boat.", "{{place}} already? It takes half a day by boat."),
    RideMoment("down", "Down we go. Gently, now.", "Gently, gently, please..."),
    RideMoment("landed", "We're down. Already? It felt like no time.", "We're down. We're down! Thank God."),
    RideMoment("wet", "Well. That's one to tell at the coffee house.", "I'm soaked. But we're alive, aren't we?")]

ride_moment = (key: str) -> RideMoment:
    loop m in RIDE_MOMENTS:
        if m.key == key: return m
    RIDE_MOMENTS[0]

# The thanks, at the dock: for the flight, by how it went.
ride_thanks = (r: Joyride) -> str:
    if not r.flew: return "Another time, then. I'll hold you to it."
    if r.top > 500.0: return "I could see the whole island. I'll remember that the rest of my days. Thank you."
    if r.nervous: return "Thank you. I was terrified, and I'd go again tomorrow."
    "Thank you. Wait till I tell them all at home."

# What they say when the pilot offers (K at the dock): yes, as they are.
ride_accept_line = (nervous: bool) -> str: if nervous: "Me? Up there? ...All right. Before I change my mind." else: "Really? Now? Oh, yes please!"

# ---------------- a lift to the springs ----------------
# Now and then the one who comes over wants a lift rather than a flight: to the harbour below the
# hot springs (src/bath.jo), for the waters, paying a little for it there. Set down anywhere else,
# they say so and stay in the seat.

const RIDE_LIFT_CENTS = 150

ride_lift_ask_line = (nervous: bool, baths: str, harbour: str) -> str:
    if nervous: "I don't suppose you'd be flying toward the {baths}? It's my knees. I'd pay, as far as {harbour}." else: "Would you be going anywhere near the {baths}? I'd pay for a lift as far as {harbour}."

ride_lift_thanks = (paid: bool) -> str:
    if paid: "The waters will set me right. Here, for your trouble." else: "I've nothing to give you but my thanks. The waters will set me right."

ride_lift_not_here = (harbour: str) -> str: "Not here, I'm afraid. It's {harbour} I'm after."

# What they ask, when they come over to the aircraft.
ride_ask_line = (nervous: bool) -> str: if nervous: "Would you... could you take me up? Just a little way?" else: "Could you take me up one day? Just round the island?"

# Whether someone asks, as the pilot comes to the aircraft (a roll in 0..1): now and then.
const RIDE_ASK_CHANCE = 0.2
ride_asks = (roll: f64) -> bool: roll < RIDE_ASK_CHANCE

ride_begin = (person: int, who: int, nervous: bool, pos: vec3, home: vec3, has_home: bool) -> Joyride:
    Joyride(stage = .walking, who = who, person = person, nervous = nervous, pos = pos, home = home, has_home = has_home)

# The next thing to say, from what the flight is doing ("" when nothing new). Each moment once.
ride_next = (r: mut Joyride, v: RideView) -> str:
    key = ""
    if v.wrecked: key = "wet"
    else if r.stage == .seated:
        if v.throttle > 0.3 and v.on_water and v.speed > 4.0: key = "run"
        else if v.throttle > 0.05: key = "throttle"
        else: key = "aboard"
    else if r.stage == .flying:
        if v.height < 60.0 and v.climb > 0.5: key = "up"
        else if v.house_near: key = "house"
        else if v.place_seen != "": key = "other"
        else if v.height > 500.0: key = "high"
        else if v.climb < -2.0 and v.height < 120.0: key = "down"
        else if v.over_town: key = "boats"
        else if v.height > 80.0: key = "sea"
    else if r.stage == .landed: key = "landed"
    if key == "" or key in r.said: return ""
    r.said.push(key)
    m = ride_moment(key)
    line = if r.nervous: m.nervous else: m.calm
    line.replace("{{place}}", v.place_seen)

# One step of the ride: the stage follows the aircraft; a line when there is something new to say,
# not sooner than a few seconds after the last.
ride_step = (r: mut Joyride, v: RideView, now: f64) -> str:
    if r.stage == .none or r.stage == .walking or r.stage == .thanked: return ""
    # (flying: off the water at flying speed for a second and a half, not a hull skipping on the run
    # or settling; landed: back on the water for two)
    off = not v.on_water and not v.moored and v.height > 2.0 and v.speed > 14.0
    if r.stage == .seated:
        if not off: r.since = -1.0
        else if r.since < 0.0: r.since = now
        else if now - r.since >= 1.5: r.stage = .flying; r.flew = true; r.since = -1.0
    else if r.stage == .flying:
        # (landed: down on the water and slowed to a taxi, not touching and going on at speed)
        on = (v.on_water or v.moored) and v.speed < 12.0
        if not on: r.since = -1.0
        else if r.since < 0.0: r.since = now
        else if now - r.since >= 2.0: r.stage = .landed; r.since = -1.0
    else if r.stage == .landed and off:
        # (up again before reaching a dock: still flying)
        if r.since < 0.0: r.since = now
        else if now - r.since >= 1.5: r.stage = .flying; r.since = -1.0
    if r.stage == .flying: r.top = max(r.top, v.height)
    if now < r.next_line: return ""
    line = ride_next(r, v)
    if line != "":
        r.line = line; r.line_until = now + 5.0
        r.next_line = now + 7.0
        if r.said[r.said.len() - 1] == "house": r.pointing_until = now + 4.0
    line

# Back at a dock (moored): their thanks; the ride is over.
ride_thank = (r: mut Joyride, now: f64) -> str:
    r.stage = .thanked
    r.line = ride_thanks(r); r.line_until = now + 6.0
    r.line

# ---------------- waiting for the pilot ----------------
# The pilot steps ashore with a passenger in the seat, before they have flown: "Back in a few
# minutes" and they wait in the seat, up to an hour of the world's time, or until the pilot leaves
# the island; "Sorry, another day" and they climb out and go home, with a kind word. Back aboard,
# the flight goes on. If they give up, they say so the next time they meet the pilot, in passing.

const RIDE_WAIT_MINUTES = 60
const RIDE_NUDGE_MINUTES = 20       # (a remark, if the pilot is in earshot, after this long)

ride_wait_begin = (r: mut Joyride, minute: int):
    r.stage = .waiting; r.wait_from = minute; r.nudged = 0
    r.line = if r.nervous: "I'll wait here. I'll hold on to the edge, just in case." else: "I'll wait here, then. Don't be long!"

# Whether they give up: an hour gone, or the pilot gone from the island.
ride_wait_over = (r: Joyride, minute: int, same_island: bool) -> bool:
    r.stage == .waiting and (not same_island or minute - r.wait_from >= RIDE_WAIT_MINUTES)

# A remark while waiting, when the pilot is in earshot: "" when nothing is due. One after twenty
# minutes, one more after forty.
ride_wait_remark = (r: mut Joyride, minute: int) -> str:
    if r.stage != .waiting: return ""
    waited = minute - r.wait_from
    if r.nudged == 0 and waited >= RIDE_NUDGE_MINUTES:
        r.nudged = 1
        return if r.nervous: "Still going up? I've been working up my nerve." else: "Still going up?"
    if r.nudged == 1 and waited >= RIDE_NUDGE_MINUTES * 2:
        r.nudged = 2
        return "I can't wait much longer, you know."
    ""

# Back aboard: the flight goes on.
ride_resume = (r: mut Joyride, minute: int) -> str:
    waited = minute - r.wait_from
    r.stage = .seated; r.wait_from = -1
    r.line = if waited >= RIDE_NUDGE_MINUTES: "There you are! I'd started to wonder." else: "Ready when you are."
    r.line

# "Sorry, another day": they climb out, politely.
ride_put_off = (r: mut Joyride, now: f64) -> str:
    r.stage = .thanked
    r.line = if r.nervous: "Another day, then. Perhaps that's best." else: "Another day, then. I'll hold you to it."
    r.line_until = now + 5.0
    r.line

# What they say the next time they meet the pilot, having given up waiting.
ride_gave_up_line = (nervous: bool) -> str:
    if nervous: "I waited in your aeroplane a good while. Perhaps it wasn't meant to be. Another day?" else: "I waited by your aeroplane an hour! Another day, then."
