# Thermal baths where the spring rises: three built terraces stepping down a
# hillside. Each is flush with the ground at its uphill edge, so the slope rises
# behind a cut wall, and stands on stone retaining walls where the ground falls
# away in front. The bathhouse and inn are on the upper terrace against the
# rock, the hot pool on the middle one and a cooler pool below; stone stairs join
# them and a last flight comes down to the path from the town. The terrace and
# stair surfaces are the walking contact, as town plinths and quays are.

# Local frame: +z runs downhill (toward the town), x across the slope; y is
# relative to the upper terrace (center.y).
struct ThermalSite:
    place:int
    name:str
    country:int
    center:vec3                    # upper terrace top, centre of the site
    yaw:f64
    road:vec3                      # foot of the last flight, where the path from the town arrives
    drops:vec2                     # middle and lower terraces below the upper one (surveyed)

THERMAL_SITES=[
    ThermalSite(141625,"Saryerenos baths",1,vec3(-47076.0,204.0,-46274.0),-0.3927,vec3(-47080.26,201.15373,-46251.953),vec2(1.50,2.55)),
    ThermalSite(131459,"Ardevavos springs",2,vec3(209829.11,799.3,-77340.22),5.274584434,vec3(209812.89,796.96576,-77324.69),vec2(1.30,2.25)),
]
const THERMAL_VERSION=2

struct ThermalTerrace:
    low:vec2                       # local x/z rectangle
    high:vec2
    index:int                      # 0 upper, 1 middle, 2 lower

THERMAL_TERRACES=[
    ThermalTerrace(vec2(-16,-15),vec2(16,0),0),
    ThermalTerrace(vec2(-22,0),vec2(21,14),1),
    ThermalTerrace(vec2(-12,14),vec2(10,22),2),
]
thermal_drop=(site:ThermalSite,index:int)->f64:if index==0:0.0 else:if index==1:f64(site.drops.x) else:f64(site.drops.y)

# Stone flights between the terraces and down to the path: local start/end
# (x centre, z, drop) and width. The last one's foot is the site's road point.
struct ThermalStair:
    x:f64
    z0:f64
    z1:f64
    top:f64                        # drop at z0
    bottom:f64                     # drop at z1
    width:f64=3.0

thermal_stairs=(site:ThermalSite)->ThermalStair[]:
    foot=thermal_local(site,site.road.xz)
    d1=f64(site.drops.x);d2=f64(site.drops.y)
    # Each flight's run follows its rise at a steady stair grade.
    run1=max(3.0,(d1)/0.42);run2=max(3.0,(d2-d1)/0.42)
    [ThermalStair(0.0,-run1*0.6,run1*0.4,0.0,d1),ThermalStair(4.5,14.0-run2*0.5,14.0+run2*0.5,d1,d2),ThermalStair(4.5,21.0,max(22.0,f64(foot.y)),d2,f64(site.center.y-site.road.y))]

const THERMAL_RISER=0.16
thermal_stair_drop=(stair:ThermalStair,z:f64)->f64:
    u=clamp((z-stair.z0)/max(stair.z1-stair.z0,0.01),0.0,1.0)
    steps=max(1,int(ceil(abs(stair.bottom-stair.top)/THERMAL_RISER)))
    stair.top+(stair.bottom-stair.top)*f64(min(steps,int(floor(u*f64(steps)))))/f64(steps)

thermal_site=(place:int)->int:
    loop k in 0..THERMAL_SITES.len():
        if THERMAL_SITES[k].place==place:return k
    -1
thermal_world=(site:ThermalSite,p:vec3)->vec3:
    c=cos(site.yaw);s=sin(site.yaw)
    vec3(f32(f64(site.center.x)+f64(p.x)*c+f64(p.z)*s),site.center.y+p.y,f32(f64(site.center.z)-f64(p.x)*s+f64(p.z)*c))
thermal_local=(site:ThermalSite,p:vec2)->vec2:
    d=p-site.center.xz;c=f32(cos(site.yaw));s=f32(sin(site.yaw))
    vec2(d.x*c-d.y*s,d.x*s+d.y*c)

const THERMAL_POOL=vec2(-4,7.5)
const THERMAL_COOL_POOL=vec2(-6,17.5)
thermal_pool=(site:ThermalSite)->vec3:thermal_world(site,vec3(THERMAL_POOL.x,f32(0.2-site.drops.x),THERMAL_POOL.y))
thermal_cool_pool=(site:ThermalSite)->vec3:thermal_world(site,vec3(THERMAL_COOL_POOL.x,f32(0.2-site.drops.y),THERMAL_COOL_POOL.y))
thermal_seat=(site:ThermalSite)->vec3:thermal_world(site,vec3(THERMAL_POOL.x,f32(-0.5-site.drops.x),THERMAL_POOL.y+2.7))
thermal_entry=(site:ThermalSite)->vec3:thermal_world(site,vec3(THERMAL_POOL.x,f32(-site.drops.x),THERMAL_POOL.y+5.6))
thermal_inn=(site:ThermalSite)->vec3:thermal_world(site,vec3(8,0,-0.5))
thermal_courtyard=(site:ThermalSite)->vec3:thermal_world(site,vec3(9,f32(-site.drops.x),5))
thermal_houses=[vec4(-17.5,7,8,8),vec4(16.5,7.5,8,8)]   # local x, z, width, depth on the middle terrace

# Terrace or stair height under a local point, relative to the upper terrace.
thermal_level=(site:ThermalSite,q:vec2)->f64?:
    loop stair in thermal_stairs(site):
        if abs(f64(q.x)-stair.x)<=stair.width*0.5 and f64(q.y)>=stair.z0 and f64(q.y)<=stair.z1:return -thermal_stair_drop(stair,f64(q.y))
    loop t in THERMAL_TERRACES:
        if q.x>=t.low.x and q.x<=t.high.x and q.y>=t.low.y and q.y<=t.high.y:return -thermal_drop(site,t.index)
    none

# The terrain source cuts a hollow into the hillside under the whole complex
# and a 14 m margin round it (one cell of the canonical lattice), down to just
# below the lowest terrace: the higher terraces stand on masonry walls inside
# it and the slope rises behind as a bank, never through the paving. Never
# raises ground. Pure: called on terrain worker threads.
const THERMAL_MARGIN=14.0
thermal_carve=(x:f64,z:f64,h:f64)->f64:
    p=vec2(f32(x),f32(z))
    loop site in THERMAL_SITES:
        if length(p-site.center.xz)>80:continue
        q=thermal_local(site,p)
        floor=f64(site.center.y)-f64(site.drops.y)-0.5
        if thermal_level(site,q)!=none:return min(h,floor)
        loop t in THERMAL_TERRACES:
            gap=max(abs(q-(t.low+t.high)*0.5)-(t.high-t.low)*0.5,vec2(0,0))
            if f64(length(gap))<=THERMAL_MARGIN:return min(h,floor)
    h
thermal_key=()->u64:hash((THERMAL_SITES,THERMAL_TERRACES,THERMAL_VERSION))

struct ThermalSolid:
    at:vec3
    half:vec3
    yaw:f64=0
    kind:int=0                     # 1: curved coping, 2: a house; both meshed separately

build_thermal_solids=(site:ThermalSite)->ThermalSolid[]:
    solids:ThermalSolid[]
    loop building in [vec4(-8,-7,5,4.4),vec4(8,-8,5.5,if site.country==1:8 else:5)]:
        x=building.x;z=building.y;w=building.z;h=building.w;d=if x<0:5.0 else:6.0
        loop side in [-1.0,1.0]:
            solids.push(ThermalSolid(vec3(x+f32(side)*w,h*0.5,z),vec3(0.3,h*0.5,f32(d))))
            # Door gap is 2.4m wide and has a real lintel, no black wall decal.
            half=(w-1.2)*0.5
            solids.push(ThermalSolid(vec3(x+f32(side)*(1.2+half),1.3,z+f32(d)),vec3(half,1.3,0.3)))
        solids.push(ThermalSolid(vec3(x,h*0.5,z-f32(d)),vec3(w+0.3,h*0.5,0.3)))
        solids.push(ThermalSolid(vec3(x,(h+2.6)*0.5,z+f32(d)),vec3(w+0.3,(h-2.6)*0.5,0.3)))
    # Village houses on the middle terrace are solid blocks.
    loop house in thermal_houses:solids.push(ThermalSolid(vec3(house.x,f32(3.0-site.drops.x),house.y),vec3(house.z*0.5,3.0,house.w*0.5),kind=2))
    # Coping stones have volume. A step into a pool is an explicit activity,
    # not ordinary walking onto a false dry water surface.
    loop pool in [(THERMAL_POOL,4.8,-site.drops.x),(THERMAL_COOL_POOL,3.0,-site.drops.y)]:
        count=if pool.1>4.0:24 else:16
        loop k in 0..count:
            a=(f64(k)+0.5)*TAU/f64(count)
            solids.push(ThermalSolid(vec3(pool.0.x+f32(cos(a))*f32(pool.1),pool.2+0.17,pool.0.y+f32(sin(a))*f32(pool.1)),vec3(0.65,0.3,0.40),PI*0.5-a,1))
    solids

thermal_solid_cache:ThermalSolid[][]
thermal_solids=(site:ThermalSite)->ThermalSolid[]:
    global thermal_solid_cache
    if thermal_solid_cache.len()==0:thermal_solid_cache=[loop s in THERMAL_SITES:build_thermal_solids(s)]
    thermal_solid_cache[thermal_site(site.place)]

# Walking: the terrace paving and the stair treads are the surface.
thermal_contact=(x:f64,z:f64,ground:f64)->f64:
    p=vec2(f32(x),f32(z))
    loop site in THERMAL_SITES:
        if length(p-site.center.xz)>60:continue
        if let level=thermal_level(site,thermal_local(site,p)):return f64(site.center.y)+level
    ground

thermal_exclude=(p:vec2,height:f64)->vec2:
    result=p
    loop site in THERMAL_SITES:
        if length(result-site.center.xz)>40:continue
        q=thermal_local(site,result)
        original=q
        loop solid in thermal_solids(site):
            if height>=f64(site.center.y+solid.at.y+solid.half.y)+0.05:continue
            c=f32(cos(solid.yaw));s=f32(sin(solid.yaw));d=q-solid.at.xz
            v=vec2(d.x*c-d.y*s,d.x*s+d.y*c);half=solid.half.xz+vec2(0.35,0.35)
            if abs(v.x)>=half.x or abs(v.y)>=half.y:continue
            if half.x-abs(v.x)<half.y-abs(v.y):v.x=if v.x<0:-half.x else:half.x
            else:v.y=if v.y<0:-half.y else:half.y
            q=solid.at.xz+vec2(v.x*c+v.y*s,-v.x*s+v.y*c)
        if q!=original:result=thermal_world(site,vec3(q.x,0,q.y)).xz
    result

thermal_paved=(p:vec2)->bool:
    loop site in THERMAL_SITES:
        if length(p-site.center.xz)>60:continue
        if thermal_level(site,thermal_local(site,p))!=none:return true
    false
