use 'cloud_shadow_map.jo'
use 'world_point.jo'
use 'depth_space.jo'
# Painted 3D cloud bodies and analytic weather layers. The distance atlas holds
# shape and normals only: lighting follows the real sun, never a camera-facing card.
use 'cloud_density.jo'
use 'sky_air.jo'
use 'cloud_depth.jo'
use 'look.jo'
use 'paint.jo'
use 'render_space.jo'
use 'quality.jo'
use 'weather_scene.jo'
use 'cloud_shadow_apply.jo'
const WEATHER_STEPS = 4

struct CloudVolume:
    center: vec3
    extent: vec3
    shape: f32
    heading: f32 = 0.0
    tone: f32 = 0.5
    weather: vec2 = vec2(1,0)       # opacity envelope, storm shading
    growth: vec4 = vec4(0,0,0,0)    # erosion distance, rolling phase, roll, shear
    precise:WorldPoint?=none
    thermal: f32 = 0.0             # cached land heating, CPU only
    stamp: f32 = 0.0               # which procedural form (cloud_density.jo)
    mirror: f32 = 1.0              # +-1: the form mirrored across its width
    alt: f32 = -1.0                # a tower's form while the air builds none, CPU only

struct VolumeVertex:
    corner: vec2

struct VolumeInstance:
    rect: vec4
    center: vec3
    extent: vec3
    meta: vec4                      # cos yaw, sin yaw, stamp, tone
    weather: vec2
    growth: vec4
    air: vec3
    slab: vec4                      # the form's atlas slices: origin, per row, count
    voxels: vec4                    # its voxel grid x, y, channel, mirror

struct VolumeParams:
    rays: mat4
    cam: vec3
    forward: vec3
    sun_dir: vec3
    sun: vec3
    shade: vec3
    haze: vec3
    fog: f32
    depth_ab: vec2
    atlas: Texture
    depth: Texture
    steps: f32
    shadows: f32
    low_size: vec2
    edge_pass: f32
    lightning: f32 = 0.0
    bolt: vec3 = vec3(0,0,0)        # where the strike lights its cloud from inside (chart-local)
    inside: vec4 = vec4(40,0.55,1,0)  # in-cloud: drifting mass size (m), its contrast, brightness
    paint: vec2 = vec2(1,1)           # brushed silhouettes, brush strokes (developer cost checks)
    paint_light: vec3 = vec3(0.96,0.87,0.78)
    paint_shade: vec3 = vec3(0.38,0.53,0.61)
    repair_ready: f32 = 0.0

struct VolumeOut:
    pos: vec4
    ndc: vec2
    center: vec3
    extent: vec3
    meta: vec4
    weather: vec2
    growth: vec4
    air: vec3
    slab: vec4
    voxels: vec4

volume_vs = (v: VolumeVertex, inst: VolumeInstance, u: VolumeParams) -> VolumeOut:
    ndc = mix(inst.rect.xy, inst.rect.zw, v.corner)
    VolumeOut(vec4(ndc, 0, 1), ndc, inst.center, inst.extent, inst.meta, inst.weather,inst.growth,inst.air,inst.slab,inst.voxels)

cloud_to_local = (p: vec3, yaw: vec2) -> vec3: vec3(p.x * yaw.x + p.z * yaw.y, p.y, -p.x * yaw.y + p.z * yaw.x)
cloud_to_world = (p: vec3, yaw: vec2) -> vec3: vec3(p.x * yaw.x - p.z * yaw.y, p.y, p.x * yaw.y + p.z * yaw.x)

# Exact roots for the spherical render chart's constant-height surface. The
# product form avoids cancelling Earth-sized numbers for a nearby ceiling.
cloud_height_roots = (ray_y: f32, altitude: f32, height: f32) -> vec2:
    h = altitude-height
    b = (f32(EARTH_RADIUS)+h)*ray_y
    c = h*(2.0*f32(EARTH_RADIUS)+h)
    disc = b*b-c
    if disc < 0.0: return vec2(1,-1)
    q = -b-(if b < 0.0: -1.0 else: 1.0)*sqrt(disc)
    other = if abs(q) > 0.00001: c/q else: -b
    vec2(min(q,other),max(q,other))

cloud_layer_interval = (ray_y: f32, altitude: f32, bottom: f32, top: f32, bounds: vec2) -> vec2:
    upper = cloud_height_roots(ray_y,altitude,top)
    if upper.x > upper.y: return vec2(1,-1)
    start = max(bounds.x,upper.x); end = min(bounds.y,upper.y)
    lower = cloud_height_roots(ray_y,altitude,bottom)
    if lower.x <= lower.y:
        if start < lower.x: end = min(end,lower.x)
        else: start = max(start,lower.y)
    vec2(start,end)

# Value and exact gradient share four hashes; finite differences would run
# this noise three times at every deck sample.
cloud_layer_noise = (p: vec2) -> vec3:
    cell = floor(p); f = p-cell
    u = f*f*(vec2(3,3)-f*2.0)
    du = f*(vec2(1,1)-f)*6.0
    a = hash21(cell); b = hash21(cell+vec2(1,0))
    c = hash21(cell+vec2(0,1)); d = hash21(cell+vec2(1,1))
    vec3(mix(mix(a,b,u.x),mix(c,d,u.x),u.y),mix(b-a,d-c,u.y)*du.x,mix(c-a,d-b,u.x)*du.y)

volume_sample = (atlas: Texture, p: vec3, kind: f32, ext: vec3) -> vec4:
    if max(abs(p.x), max(abs(p.y), abs(p.z))) > 1.0: return vec4(0.5, 1, 0.5, 0)
    if kind == 13.0:
        # Stratus slivers: long thin streaks along the wind, a few hundred metres
        # wide, scattered in broad patches; a flat thin body (a 60 km layer).
        m = p.xz*60000.0
        streak = vnoise(vec2(m.x/9000.0,m.y/650.0))*0.75+vnoise(vec2(m.x/2600.0,m.y/300.0))*0.25
        patch = smoothstep(0.45,0.7,vnoise(m/23000.0+vec2(5.3,1.7)))
        body = smoothstep(-0.7,-0.2,p.y)*(1.0-smoothstep(0.2,0.7,p.y))
        return vec4(0.5,1,0.5,body*patch*smoothstep(0.6,0.72,streak)*0.9)
    if kind == 8.0:
        # A thunderstorm's rain shafts: a few dark columns and curtains hanging
        # from the anvil's base to the sea under its core, clear air between
        # them, the lower rain carried downwind (the box's x runs downwind).
        q = p.xz+vec2(p.y*0.03,0)
        rain: f32 = 0.0
        ragged = (vnoise(q*vec2(160.0,60.0))-0.5)*0.5
        loop k in 0..4:
            # (under the system's cells: STORM_CELL_AT in lightning.jo)
            at = vec2(vec4(-0.29,0.11,0.35,-0.07)[k],vec4(0.09,-0.24,0.22,0.42)[k])
            size = vec2(vec4(0.07,0.05,0.06,0.09)[k],vec4(0.04,0.06,0.035,0.03)[k])*2.4
            rain = max(rain,1.0-smoothstep(0.55,1.0,length((q-at)/size)+ragged))
        streaks = 0.65+0.35*vnoise(q*vec2(420.0,140.0))
        body = smoothstep(-0.59,-0.52,p.y)*(1.0-smoothstep(0.80,0.87,p.y))
        # Ragged scud hanging under the anvil's base breaks its straight edge.
        scud: f32 = 0.0
        if p.y > 0.55:
            core = 1.0-smoothstep(0.60,0.75,length(q/vec2(0.83,0.64)))
            scud = smoothstep(0.55,0.80,p.y)*(1.0-smoothstep(0.84,0.87,p.y))*smoothstep(0.58,0.75,vnoise(q*vec2(90.0,70.0))*0.7+vnoise(q*260.0)*0.3)*core
        return vec4(0.5,0,0.5,body*rain*streaks*0.28+scud*0.08)
    if kind == 6.0:
        # Slanted, vertically coherent curtains below the deck. Their broad
        # density groups read from the air; fine rain remains the near streaks.
        rim = 1.0-smoothstep(0.6,1.0,length(p.xz/vec2(0.83,0.64)))
        q = p.xz+vec2(p.y*0.002,p.y*0.001)
        field = vnoise(q*vec2(175,31))*0.7+vnoise(q*vec2(57,19))*0.3
        curtains = smoothstep(0.26,0.72,field)
        body = smoothstep(-0.5,-0.35,p.y)*(1.0-smoothstep(0.62,0.85,p.y))
        return vec4(0.5,0,0.5,body*rim*(0.006+curtains*0.052))
    if kind == 4.0 or kind == 7.0 or kind == 10.0:
        # Continuous decks / sea fog. No atlas fetches; their
        # horizontal scales are kilometres, so a 64-voxel stamp would repeat.
        # (a storm's deck ends in a wall, not a haze)
        broad_field = cloud_layer_noise(p.xz*35.0)
        rim = if kind == 10.0: 1.0-smoothstep(0.92,1.0,length(p.xz/vec2(0.83,0.64))) else: 1.0-smoothstep(0.6,1.0,length(p.xz/vec2(0.83,0.64)))
        broad = broad_field.x
        # (a storm's deck without the fine term: four samples through it drew tiles)
        n = if kind == 10.0: broad else: broad*0.65+vnoise(p.xz*93.0)*0.35
        # (a storm's deck has a ragged base, lumps of it hanging well down toward the sea)
        bottom = if kind == 10.0: -0.5+(n-0.5)*0.12-smoothstep(0.55,0.85,vnoise(p.xz*160.0))*0.2 else: -0.5+(n-0.5)*0.18
        # (a storm's deck reaches above anything an aircraft can climb to)
        top = if kind == 10.0: 0.62+n*0.25 else: 0.15+n*0.72
        body = smoothstep(bottom,bottom+0.12,p.y)*(1.0-smoothstep(top-0.18,top,p.y))
        density = body*rim*(if kind == 10.0: 0.9+n*0.5 else: 0.35+n*0.65)
        if kind == 4.0: density *= smoothstep(0.27,0.43,n)
        if kind == 7.0: density *= 0.22
        normal = vec3(0,if p.y < 0.0: -1.0 else: 1.0,0)
        if (kind == 4.0 or kind == 10.0) and density > 0.005:
            # (the vertical part turns over smoothly through the layer's middle: a hard
            # flip there split the view from inside the deck along a stepped horizon)
            # (a storm's deck turns more gently: strong turns painted its wall in dark blotches)
            lean = if kind == 10.0: 8.0 else: 21.0
            normal = normalize(vec3(-broad_field.y*lean,clamp(p.y*10.0,-1.0,1.0),-broad_field.z*lean))
        return vec4(normal*0.5+vec3(0.5,0.5,0.5),density)
    vec4(0.5,1,0.5,0)

# A form's encoded distance (.5 at the surface, larger inside). Each texel
# holds four forms, one per channel; a form's grid has its box's aspect.
cloud_stamp_value = (atlas: Texture, p: vec3, slab: vec4, voxels: vec4) -> f32:
    if max(abs(p.x),max(abs(p.y),abs(p.z))) > 1.0: return 0.0
    q = (vec3(p.x*voxels.w,p.y,p.z)*0.5+vec3(0.5,0.5,0.5))*(vec3(voxels.x,voxels.y,slab.w)-vec3(1,1,1))
    z0 = floor(q.z); z1 = min(z0+1.0,slab.w-1.0)
    tile = vec2(voxels.x+2.0,voxels.y+2.0)
    a = slab.xy+vec2(z0-floor(z0/slab.z)*slab.z,floor(z0/slab.z))*tile+q.xy+vec2(1.5,1.5)
    b = slab.xy+vec2(z1-floor(z1/slab.z)*slab.z,floor(z1/slab.z))*tile+q.xy+vec2(1.5,1.5)
    size = vec2(f32(CLOUD_ATLAS_W),f32(CLOUD_ATLAS_H))
    texel = mix(sample(atlas,a/size),sample(atlas,b/size),q.z-z0)
    if voxels.z < 0.5: return texel.x
    if voxels.z < 1.5: return texel.y
    if voxels.z < 2.5: return texel.z
    texel.w

# The same from the form's index alone: (index+1)*mirror. Loops that march many
# clouds keep one value live instead of the eight of slab and voxels (on Intel
# GPUs that keeps their SIMD16 compile). Equal to cloud_stamp_slab/voxels
# (sky_test checks every form).
cloud_stamp_slab_of = (packed: f32) -> vec4:
    g = floor((abs(packed)-1.0)/4.0+0.01)
    if g < 2.0: return vec4(0,g*56.0,31,48)
    if g < 4.0: return vec4(0,112.0+(g-2.0)*92.0,31,56)
    if g < 6.0: return vec4(0,296.0+(g-4.0)*132.0,40,48)
    vec4(0,560,31,56)
cloud_stamp_voxels_of = (packed: f32) -> vec4:
    s = abs(packed)-1.0
    g = floor(s/4.0+0.01)
    v = vec4(64,26,s-g*4.0,if packed < 0.0: -1.0 else: 1.0)
    if g >= 2.0 and g < 4.0: v.y = 44.0
    if g >= 4.0 and g < 6.0: v.x = 48.0; v.y = 64.0
    if g >= 6.0: v.y = 56.0
    v
cloud_stamp_value_of = (atlas: Texture, p: vec3, packed: f32) -> f32:
    cloud_stamp_value(atlas,p,cloud_stamp_slab_of(packed),cloud_stamp_voxels_of(packed))

# The outward gradient of the form's distance in local box coordinates, from
# four tetrahedral taps `reach` voxels apart. A wide reach gives the lobes'
# broad shoulders rather than every crevice (painted light, not pockmarks).
# Divide by the extent for a world normal.
cloud_stamp_gradient = (atlas: Texture, p: vec3, slab: vec4, voxels: vec4, reach: f32 = 3.4) -> vec3:
    h = vec3(reach/(voxels.x-1.0),reach/(voxels.y-1.0),reach/(slab.w-1.0))
    a = cloud_stamp_value(atlas,p+vec3(h.x,-h.y,-h.z),slab,voxels)
    b = cloud_stamp_value(atlas,p+vec3(-h.x,-h.y,h.z),slab,voxels)
    c = cloud_stamp_value(atlas,p+vec3(-h.x,h.y,-h.z),slab,voxels)
    d = cloud_stamp_value(atlas,p+vec3(h.x,h.y,h.z),slab,voxels)
    -vec3(a-b-c+d,-a-b+c+d,-a+b-c+d)/h

cloud_growth_padding = (growth: vec4) -> vec3: vec3(abs(growth.z)+abs(growth.w),0,abs(growth.z))

cloud_growing_point = (p: vec3, growth: vec4) -> vec3:
    # Slow roll around rising plumes, followed by wind shear as they spread.
    q = p
    q.x += sin(p.y*5.0-growth.y)*growth.z+p.y*growth.w
    q.z += cos(p.y*4.0-growth.y+p.x*3.0)*growth.z
    q

# Fine relief for clouds seen close: two octaves of value noise in the cloud's
# own metres (it drifts and turns with the cloud), faded out before a
# low-resolution pixel could resolve it, and kept off the flat base.
cloud_vnoise3 = (q: vec3) -> f32:
    k = floor(q.y); f = q.y-k; f = f*f*(3.0-2.0*f)
    mix(vnoise(q.xz+vec2(k*17.31,k*31.73)),vnoise(q.xz+vec2((k+1.0)*17.31,(k+1.0)*31.73)),f)

# Signed metres added to the distance (positive erodes, negative bulges).
# Billowed noise: rounded bulges with creases between them, as cauliflower.
cloud_relief = (m: vec3, fade: vec2, seed: f32) -> f32:
    r: f32 = 0.0
    if fade.x > 0.0: r -= (abs(cloud_vnoise3(m/95.0+vec3(seed,seed*0.7,seed*1.3))*2.0-1.0)-0.35)*26.0*fade.x
    if fade.y > 0.0: r -= (abs(cloud_vnoise3(m/38.0+vec3(seed*1.7,seed,seed*0.4))*2.0-1.0)-0.35)*7.0*fade.y
    r

# Relief fades in by metres per low-resolution pixel; none on the base.
cloud_relief_fade = (mpp: f32) -> vec2: vec2(1.0-smoothstep(10.0,30.0,mpp),1.0-smoothstep(4.0,12.0,mpp))

# Painted edge breakup at every distance: scalloped brush dabs a few pixels
# across, whatever the cloud's distance. Their size steps through octaves in
# the cloud's own metres (blended, so nothing swims as the camera closes in).
# Signed metres added to the distance, as cloud_relief.
cloud_brush_octave = (mpp: f32) -> f32: max(log2(max(mpp,1.0)*7.0/95.0),0.0)
cloud_brush = (m: vec3, mpp: f32, seed: f32) -> f32:
    level = cloud_brush_octave(mpp)
    n = floor(level); f = level-n
    size = 95.0*pow(2.0,n)
    # (each octave alone over most of its range; both only in the middle third
    # of the hand-over, so most steps pay for one noise)
    w = smoothstep(0.33,0.67,f)
    a: f32 = 0.0; b: f32 = 0.0
    # (a 2D noise sheared through height: dabs fixed to the cloud at half the
    # price of a 3D one, as the march evaluates them at every step near the surface)
    if w < 1.0:
        q = m/size
        a = abs(vnoise(q.xz+q.y*vec2(0.71,1.29)+vec2(seed*1.3,seed))*2.0-1.0)-0.4
    if w > 0.0:
        q = m/(size*2.0)
        b = abs(vnoise(q.xz+q.y*vec2(1.23,0.67)+vec2(seed*0.8,seed*1.9))*2.0-1.0)-0.4
    -mix(a*size,b*size*2.0,w)*0.3

# Brush strokes inside the painted bands: streaks along the terminator,
# curling round each lobe with its normal, a few pixels wide at any distance.
cloud_strokes = (m: vec3, normal: vec3, sun: vec3, mpp: f32) -> f32:
    along = cross(normal,sun)
    along = if length(along) > 0.001: normalize(along) else: vec3(1,0,0)
    across = cross(normal,along)
    level = max(log2(max(mpp,0.5)*3.0/6.0),0.0)
    n = floor(level); f = level-n
    width = 6.0*pow(2.0,n)
    q = vec2(dot(m,along)/(width*5.0),dot(m,across)/width)
    mix(vnoise(q),vnoise(q*0.5+vec2(31.7,17.3)),f)-0.5
cloud_relief_keep = (p: vec3) -> f32: smoothstep(f32(-CLOUD_BASE),f32(-CLOUD_BASE)+0.08,p.y)

# A strike's light inside its cloud: bright near the channel, glowing through
# a few kilometres of the storm around it.
cloud_flash = (world: vec3, u: VolumeParams) -> f32:
    if u.lightning <= 0.0: return 0.0
    u.lightning*exp(-length(world-u.bolt)/3200.0)

# A storm system's shelf cloud (weather kind 9): three tiered rolls along its
# leading edge, the lowest and furthest forward a dark lip, stepping up and back
# into the deck; tapered at its ends and waved along its length. Metres in its
# own frame (x along the edge, -z downwind); a conservative distance.
storm_shelf_distance = (m: vec3, e: vec3) -> f32:
    length_half = e.x*0.92
    along = clamp(m.x/length_half,-1.0,1.0)
    taper = max(sqrt(max(1.0-along*along,0.0)),0.05)
    wave = sin(m.x/2100.0)*0.08+sin(m.x/870.0+1.3)*0.04
    d: f32 = 1000000.0
    loop k in 0..3:
        c = vec2(vec3(-0.62,-0.18,0.30)[k]*e.z,(vec3(-0.45,-0.05,0.30)[k]+wave)*e.y)
        r = vec2(vec3(0.36,0.42,0.50)[k]*e.z,vec3(0.32,0.36,0.40)[k]*e.y)*taper
        q = (vec2(m.z,m.y)-c)/r
        dk = (length(q)-1.0)*min(r.x,r.y)
        h = clamp(0.5+0.5*(dk-d)/120.0,0.0,1.0)
        d = mix(dk,d,h)-120.0*h*(1.0-h)
    max(d,abs(m.x)-length_half)
storm_shelf_gradient = (m: vec3, e: vec3) -> vec3:
    h: f32 = 25.0
    vec3(storm_shelf_distance(m+vec3(h,0,0),e)-storm_shelf_distance(m-vec3(h,0,0),e),storm_shelf_distance(m+vec3(0,h,0),e)-storm_shelf_distance(m-vec3(0,h,0),e),storm_shelf_distance(m+vec3(0,0,h),e)-storm_shelf_distance(m-vec3(0,0,h),e))

# A storm system's anvil canopy (weather kind 11): one plate spread over its
# cells, thick over the middle and thinning to a ragged rim, slightly domed.
storm_canopy_distance = (m: vec3, e: vec3) -> f32:
    q = vec2(m.x/(e.x*0.95),m.z/(e.z*0.95))
    a = atan2(q.y,q.x)
    rag = 1.0+(vnoise(vec2(a*3.0,0.5))-0.5)*0.3+(vnoise(vec2(a*11.0,3.1))-0.5)*0.12
    r = length(q)/rag
    radial = (r-1.0)*min(e.x,e.z)*0.95*rag
    t = max(40.0,e.y*0.45*(1.0-r*r))
    vertical = abs(m.y-e.y*0.15*(1.0-r*r))-t
    max(radial,vertical)
storm_canopy_gradient = (m: vec3, e: vec3) -> vec3:
    h: f32 = 40.0
    vec3(storm_canopy_distance(m+vec3(h,0,0),e)-storm_canopy_distance(m-vec3(h,0,0),e),storm_canopy_distance(m+vec3(0,h,0),e)-storm_canopy_distance(m-vec3(0,h,0),e),storm_canopy_distance(m+vec3(0,0,h),e)-storm_canopy_distance(m-vec3(0,0,h),e))

# The visible surface at a point of the body: colour and opacity.
cloud_body_hit = (p: vec3, world: vec3, ray: vec3, t: f32, d: f32, leave: f32, fade: vec2, seed: f32, mpp: f32, i: VolumeOut, u: VolumeParams) -> vec4:
    scale = i.extent.x
    path = max(leave-t,0.0)
    local = if i.meta.z == 9.0: storm_shelf_gradient(p*i.extent,i.extent) else: if i.meta.z == 11.0: storm_canopy_gradient(p*i.extent,i.extent) else: cloud_stamp_gradient(u.atlas,p,i.slab,i.voxels)/i.extent
    # (just outside the form's distance band, where a brush dab can reach, the
    # gradient vanishes: the form's mass gives the light there)
    local = if length(local) > 0.0000001: normalize(local) else: normalize(p*vec3(0.8,0.55,0.8)+vec3(0,0.18,0))
    if fade.x+fade.y > 0.0:
        m = p*i.extent; h: f32 = 6.0
        keep = cloud_relief_keep(p)
        r0 = cloud_relief(m,fade,seed)
        g = vec3(cloud_relief(m+vec3(h,0,0),fade,seed)-r0,cloud_relief(m+vec3(0,h,0),fade,seed)-r0,cloud_relief(m+vec3(0,0,h),fade,seed)-r0)/h
        # The relief breaks the silhouette; the light keeps its broad painted
        # masses (full relief shading reads as crumpled paper).
        local = normalize(local+g*(keep*0.3))
    if t < 0.01 and d < 0.0:
        # Looking outward near an exit thins continuously; inward rays
        # see the dense interior rather than a turning sheet.
        outward = dot(normalize(cloud_to_world(local,i.meta.xy)),ray)
        if outward > 0.05: path = min(path,-d*scale/outward)
    opacity = i.weather.x*(1.0-exp(-path*0.018))
    color = cloud_paint(local,p,world,ray,mpp,i,u)
    # (a shelf cloud is the storm's dark leading edge, never a white sheet)
    if i.meta.z == 9.0:
        # (lighter on its upper, lit edges, dark beneath each tier: a tiered form)
        up = cloud_to_world(local,i.meta.xy).y
        color *= mix(0.62,0.9,smoothstep(-0.4,0.6,up))
    inside = smoothstep(0.0,0.035,-d)*step(t,0.01)
    if inside > 0.0:
        # Inside: darker and lighter masses of the cloud drifting past at a
        # few tens of metres, felt as speed and turbulence (cloud_inside_*).
        mist = mix(u.paint_shade,u.shade*0.7,i.weather.y)*mix(1.0,0.48,i.weather.y)*u.inside.z
        patch: f32 = 0.0
        loop k in 0..3:
            reach = u.inside.x*(0.6+f32(k)*1.4)
            patch += (cloud_vnoise3((u.cam+ray*reach)/(u.inside.x*(1.0+f32(k)*0.8))+vec3(f32(k)*7.3,0,0))-0.5)*(1.0-f32(k)*0.25)
        mist *= 1.0+patch*u.inside.y
        mist += vec3(0.7,0.78,1.0)*cloud_flash(world,u)*i.weather.y*1.4
        color = mix(color,mist,inside)
    vec4(color*opacity,opacity)

# Surface values are deliberately grouped into broad painted regions, with
# narrow transitions and gentle washes inside them. The silhouette comes from the distance field,
# rather than an accumulation of widely spaced translucent samples.
cloud_paint = (local_normal: vec3, p: vec3, world: vec3, ray: vec3, mpp: f32, i: VolumeOut, u: VolumeParams) -> vec3:
    normal = cloud_to_world(local_normal,i.meta.xy)
    normal /= max(length(normal),0.000001)
    sun = normalize(u.sun_dir)
    facing = dot(normal,sun)
    wash = vnoise(p.xz*19.0+vec2(p.y*13.0,p.y*7.0))-0.5
    # Brush strokes in the cloud's own metres, curling round each lobe. They
    # break every band edge into dry-brush ragged cuts, as a painter's would.
    stroke: f32 = if u.paint.y > 0.0: cloud_strokes(p*i.extent,normalize(local_normal),cloud_to_local(sun,i.meta.xy),mpp) else: 0.0
    # A broad wash links neighboring heads; local normals retain the lobe cuts.
    # Otherwise every shoulder becomes an identical isolated dark crescent.
    mass_normal = p*vec3(0.8,0.55,0.8)+vec3(0,0.18,0)
    mass_normal = cloud_to_world(mass_normal/max(length(mass_normal),0.000001),i.meta.xy)
    storm = i.weather.y
    value = mix(facing,dot(mass_normal,sun),0.3+0.3*storm)+wash*0.08+stroke*0.22
    # (as the film paints them, the lower part of a cumulus lies in its shade band
    # whatever the light: two values, lit crown over a blue-grey lower body)
    value -= smoothstep(0.1,-0.65,p.y)*0.65
    if storm > 0.0 and u.paint.y > 0.0:
        # A storm's cloud at its own scale: broad brush strokes a fiftieth of
        # its width layer the bands, darker and heavier toward the base and
        # brighter toward the top, as the towers' are at theirs.
        big = cloud_strokes(p*i.extent,normalize(local_normal),cloud_to_local(sun,i.meta.xy),i.extent.x*0.02)
        value += (big*0.35+(p.y*0.45+0.05)*0.4)*storm
    shade = mix(u.shade*0.9,u.paint_shade,smoothstep(-0.12,0.15,sun.y))
    # (a storm in the film's palette: near-black slate shade, its lit tops a cream-grey)
    daylight = dot(u.sun,vec3(0.2126,0.7152,0.0722))
    shade = mix(shade,vec3(0.17,0.19,0.24)*daylight,i.weather.y*0.85)
    white = mix(u.sun*u.paint_light,vec3(0.80,0.79,0.75)*daylight,i.weather.y*0.5)
    # (only a touch of the light in the shade: the film's shaded side is 15-32 L* darker)
    shade = mix(shade,white,0.08*(1.0-i.weather.y))
    middle = mix(shade,white,0.55)
    # Flat painted bands with narrow, brushed transitions: a drawn terminator
    # on every rounded head, no smooth airbrushed gradient.
    light = mix(shade,middle,smoothstep(-0.23,-0.15,value))
    # (a storm's shaded side keeps a second, darker layer under the first)
    light = mix(light,shade*0.72,(1.0-smoothstep(-0.52,-0.44,value))*storm)
    light = mix(light,white*0.9,smoothstep(0.24,0.32,value))
    # A last flat band of full white on the lumps turned most to the sun:
    # under a high sun, seen from above, the lumps still read as shapes.
    light = mix(light,white,smoothstep(0.66,0.72,facing+stroke*0.3)*smoothstep(0.24,0.32,value))
    under = smoothstep(f32(-CLOUD_BASE+0.01),f32(-CLOUD_BASE+0.04),p.y)
    if u.shadows > 0.0:
        # Broad self-shadow from the next mass sunward, not every crevice.
        probe = cloud_stamp_value(u.atlas,p+cloud_to_local(sun,i.meta.xy)/i.extent*min(i.extent.x,min(i.extent.y,i.extent.z))*0.26,i.slab,i.voxels)
        # (never on faces turned to the sun: there it reads as a crater)
        # (not on a storm's cloud: at its size the probe's cut drew round dark holes)
        light = mix(light,shade,smoothstep(0.54,0.58,probe+stroke*0.04)*0.24*(1.0-smoothstep(0.0,0.4,facing))*(1.0-storm))
    edge = 1.0-abs(dot(normal,ray))
    rim = smoothstep(0.80,0.90,edge+stroke*0.1)*smoothstep(0.0,0.15,facing)
    light = mix(light,white*1.04,rim*0.45)
    # The shared condensation floor reads as one cool plane.
    # (a little darker than the shaded sides: seen from below, a near cloud's
    # base separates it from the farther clouds it overlaps)
    light = mix(shade*0.86,light,under)
    # Pigment pooling along the strokes; screen-sized paper grain is added
    # in the composite.
    light *= 1.0+stroke*0.08
    light *= 1.0-i.weather.y*0.18*(1.0-under*0.45)
    light += vec3(0.7,0.78,1.0)*cloud_flash(world,u)*i.weather.y*(1.0+under*1.2)
    distance = length(world-u.cam)
    # (clouds keep their cream through the haze longer than the land does)
    air = 1.0-exp(-distance*max(u.fog,0.000001)*0.14)
    # (the haze over a cloud half desaturated: a cyan cast flattened far towers' two values)
    mix(light,mix(i.air,vec3(dot(i.air,vec3(0.2126,0.7152,0.0722))),0.5),air)

volume_fs = (i: VolumeOut, u: VolumeParams) -> vec4:
    # Only ambiguous reconstruction pixels are marched again at full resolution.
    # Rejecting them outright punches a hole through a NEAR cloud at a FAR sea
    # horizon; accepting a sky neighbor instead paints over thin foreground wings.
    if u.edge_pass > 0.0 and u.repair_ready == 0.0:
        uv = i.ndc*0.5+vec2(0.5,0.5)
        nearest = (floor(uv * u.low_size) + vec2(0.5, 0.5)) / u.low_size
        # This nearest tap has bilinear weight >= 1/4. Equal depth therefore
        # proves reconstruction is valid, avoiding four guide taps over open sky.
        center_raw = sample(u.depth,uv).x; nearest_raw = sample(u.depth,nearest).x
        if center_raw == nearest_raw: discard()
        # The nearest tap owns at least 1/4 of the bilinear footprint. For a
        # relative depth delta <=7 its weight alone exceeds 1e-4. This proves
        # reconstruction succeeds over sloping sea/ground too, avoiding four
        # extra guide taps per weather layer across most foreground pixels.
        center_z = volume_view_depth(center_raw,u.depth_ab)
        nearest_z = volume_view_depth(nearest_raw,u.depth_ab)
        if volume_nearest_resolves(center_z,nearest_z): discard()
        if volume_edge_weight(u.depth, uv, u.low_size, u.depth_ab) >= 0.0001: discard()
    ray = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    bent = render_world(i.center, u.cam)
    origin = cloud_to_local(u.cam - bent, i.meta.xy)
    direction = cloud_to_local(ray, i.meta.xy)
    reach = length(i.extent.xz)
    distance_xz = length(i.center.xz - u.cam.xz)
    pad = world_drop(vec2(distance_xz + reach, 0)) - world_drop(vec2(distance_xz, 0))
    inv = vec3(1.0 / (if abs(direction.x) < 0.000001: 0.000001 else: direction.x), 1.0 / (if abs(direction.y) < 0.000001: 0.000001 else: direction.y), 1.0 / (if abs(direction.z) < 0.000001: 0.000001 else: direction.z))
    a = (i.extent * (CLOUD_MIN-cloud_growth_padding(i.growth)) - vec3(0, pad, 0) - origin) * inv; b = (i.extent * (CLOUD_MAX+cloud_growth_padding(i.growth)) + vec3(0, pad, 0) - origin) * inv
    lo = min(a, b); hi = max(a, b)
    enter = max(0.0, max(lo.x, max(lo.y, lo.z)))
    leave = min(hi.x, min(hi.y, hi.z))
    # A sampled depth is an endpoint along this pixel's ray, not a cloud layer.
    depth = sample(u.depth, i.ndc * 0.5 + vec2(0.5, 0.5)).x
    if world_has_depth(depth,u.depth_ab):
        view_depth = world_depth_decode(depth,u.depth_ab)
        leave = min(leave, view_depth / max(dot(ray, u.forward), 0.0001))
    sea = sea_intersection(ray, u.cam.y)
    if sea > 0.0: leave = min(leave, sea)
    if i.meta.z == 4.0 or (i.meta.z >= 6.0 and i.meta.z != 9.0 and i.meta.z != 11.0):
        # A 600 km weather record must not turn a 500 m cloud layer into a
        # 100 km march through its curvature-expanded bounding box.
        interval = cloud_layer_interval(ray.y,u.cam.y,i.center.y-i.extent.y*0.59,i.center.y+i.extent.y*0.87,vec2(enter,min(leave,150000.0)))
        enter = interval.x; leave = interval.y
        # Inside the guaranteed dense core, distant samples must not replace
        # the near fog with kilometres of aerial haze at the grazing horizon.
        inside = (u.cam-i.center)/i.extent
        if (i.meta.z == 4.0 or i.meta.z == 10.0 or i.meta.z == 12.0) and length(inside.xz/vec2(0.83,0.64)) < 0.55 and inside.y > -0.35 and inside.y < 0.12:
            leave = min(leave,enter+4000.0/max(i.weather.x,0.02))
    if i.meta.z == 8.0:
        # (the shafts' cylinder under the storm's body: all six samples inside it)
        c = vec2(0.8*0.83,0.8*0.64)*i.extent.xz
        o = origin.xz/c; dd = direction.xz/c
        qa = dot(dd,dd); qb = dot(o,dd); qc = dot(o,o)-1.0
        disc = qb*qb-qa*qc
        # (qa is about 1/(4 km)^2: only a ray straight up or down has none)
        if disc <= 0.0 or qa < 1e-16: discard()
        root = sqrt(disc)
        enter = max(enter,(-qb-root)/qa); leave = min(leave,(-qb+root)/qa)
    if leave <= enter: discard()
    distance = length(i.center - u.cam)
    steps = mix(u.steps, 8.0, smoothstep(12000.0, 65000.0, distance))
    if i.meta.z >= 4.0 and i.meta.z != 5.0 and i.meta.z != 9.0 and i.meta.z != 11.0: steps = if i.meta.z == 8.0: mix(10.0,6.0,smoothstep(10000.0,30000.0,distance)) else: if i.meta.z == 10.0: 6.0 else: f32(WEATHER_STEPS)
    if i.meta.z < 4.0 or i.meta.z == 5.0 or i.meta.z == 9.0 or i.meta.z == 11.0:
        # Conservative distance steps skip empty air; quantization and warped
        # ellipsoid gradients get a safety margin. Refine only the visible shell.
        # Distances are in units of the form's half width (uniform scale).
        scale = i.extent.x
        ray_scale = scale/(1.0+leave/f32(EARTH_RADIUS))
        pixel = max(fwidth(i.ndc.x),fwidth(i.ndc.y))*0.4
        seed = i.meta.w*61.0
        fade_far = 1.0-smoothstep(125000.0,150000.0,distance)
        t = enter
        # The ray's closest pass outside the surface, in units of the hit
        # tolerance: a near miss is partly covered, so a low-resolution
        # silhouette is antialiased rather than stepped when enlarged.
        near_r: f32 = 1000.0; near_t: f32 = 0.0
        loop k in 0..96:
            if t >= leave: break
            world = u.cam+ray*t
            world.y += world_drop(ray.xz*t)
            p = cloud_growing_point(cloud_to_local(world-i.center,i.meta.xy)/i.extent,i.growth)
            d = if i.meta.z == 9.0: storm_shelf_distance(p*i.extent,i.extent)/scale else: if i.meta.z == 11.0: storm_canopy_distance(p*i.extent,i.extent)/scale else: (0.5-cloud_stamp_value(u.atlas,p,i.slab,i.voxels))/f32(CLOUD_ENCODE)+i.growth.x
            epsilon = max(0.004,t*pixel/scale*0.55)
            mpp = t*pixel*1.5
            fade = cloud_relief_fade(mpp)
            relief = d*scale < 60.0 and fade.x > 0.0
            if relief: d += cloud_relief(p*i.extent,fade,seed)*cloud_relief_keep(p)/scale
            # (beyond the close relief, the painted brush dabs carry the edge)
            # (only within the dabs' reach, never more than a tenth of the cloud)
            brush = u.paint.x > 0.0 and fade.x < 1.0 and d*scale < min(95.0*pow(2.0,ceil(cloud_brush_octave(mpp)))*0.7,0.12*scale)
            # (never more than a tenth of the cloud: a far, small cloud keeps its shape)
            if brush: d += clamp(cloud_brush(p*i.extent,mpp,seed),-0.1*scale,0.1*scale)*(1.0-fade.x)*cloud_relief_keep(p)/scale
            if d < epsilon:
                return cloud_body_hit(p,world,ray,t,d,leave,if relief: fade else: vec2(0,0),seed,mpp,i,u)*fade_far
            if d/epsilon < near_r: near_r = d/epsilon; near_t = t
            t += max((d-0.001)*ray_scale*(if relief: 0.45 else: if brush: 0.62 else: 0.72),epsilon*ray_scale*0.5)
        if near_r < 3.0:
            world = u.cam+ray*near_t
            world.y += world_drop(ray.xz*near_t)
            p = cloud_growing_point(cloud_to_local(world-i.center,i.meta.xy)/i.extent,i.growth)
            return cloud_body_hit(p,world,ray,near_t,0.0,leave,vec2(0,0),seed,near_t*pixel*1.5,i,u)*(fade_far*(1.0-smoothstep(1.0,3.0,near_r)))
        return vec4(0,0,0,0)
    dt = (leave - enter) / steps
    # Midpoints are stable in world/view space. No frame-random dither/history.
    t = enter + dt * 0.5
    # (a storm's deck is nearly opaque: its first sample sets its colour. Spaced
    # evenly, that sample lay up to kilometres inside its wall and drew the wall
    # as tiles of its interior; spaced as squares, it lies just inside the wall)
    deck = i.meta.z == 10.0
    span = leave - enter
    trans: f32 = 1.0
    color = vec3(0, 0, 0)
    sun = normalize(u.sun_dir)
    loop step in 0..64:
        if f32(step) >= steps or trans < 0.008: break
        world = u.cam + ray * t
        world.y += world_drop(ray.xz * t)
        p = cloud_to_local(world - i.center, i.meta.xy) / i.extent
        if deck:
            s0 = f32(step)/steps; s1 = (f32(step)+1.0)/steps
            t = enter+span*(s0+s1)*(s0+s1)*0.25; dt = span*(s1*s1-s0*s0)
            world = u.cam + ray * t
            world.y += world_drop(ray.xz * t)
            p = cloud_to_local(world - i.center, i.meta.xy) / i.extent
        form = volume_sample(u.atlas, p, i.meta.z, i.extent)
        density = form.w*i.weather.x
        if density > (if i.meta.z == 6.0 or i.meta.z == 8.0: 0.0005 else: 0.005):
            normal = cloud_to_world((form.xyz * 2.0 - vec3(1, 1, 1)) / i.extent, i.meta.xy)
            normal = normal / max(length(normal), 0.000001)
            under = smoothstep(-0.58, 0.05, p.y)
            lit = smoothstep(-0.2, 0.6, dot(normal, sun)) * (0.35 + 0.65 * under)
            white = u.sun * vec3(1, 0.98, 0.93) * (0.92 + 0.08 * i.meta.w)
            shade = u.shade * (0.88 + 0.24 * under)
            light = mix(shade, white, lit)
            light *= 1.0-i.weather.y*0.48*(1.0-under*0.5)
            if i.meta.z == 4.0: light *= 0.72+0.28*vnoise(p.xz*93.0)
            if i.meta.z == 6.0: light = if i.weather.y > 1.5: vec3(0.44,0.47,0.52)*clamp(dot(u.sun,vec3(0.2126,0.7152,0.0722))*1.2,0.25,1.0) else: mix(u.shade,u.haze,0.35)*0.85
            # (a storm's deck in the painted storm palette: cool blue-greys, darker below)
            # (slivers: pale and faintly lit, between the cream and the cool shade)
            if i.meta.z == 13.0: light = mix(u.paint_shade*0.95,u.sun*u.paint_light,0.55)
            # (the storm's deck: near-black slate at its base to a slate grey on top)
            if i.meta.z == 10.0: light = mix(vec3(0.10,0.11,0.14),vec3(0.38,0.40,0.45),smoothstep(-0.2,0.8,dot(normal,sun))*(0.15+0.85*under*under))*clamp(dot(u.sun,vec3(0.2126,0.7152,0.0722))*1.2,0.25,1.0)
            # (rain curtains: a mid slate grey, lighter than the base above them and darker
            # than the sky beyond)
            if i.meta.z == 8.0: light = vec3(0.30,0.33,0.38)*clamp(dot(u.sun,vec3(0.2126,0.7152,0.0722))*1.2,0.25,1.0)+vec3(0.7,0.78,1.0)*cloud_flash(world,u)*0.5
            if i.meta.z == 5.0: light += vec3(0.7,0.78,1.0)*cloud_flash(world,u)*(0.6+under*0.9)
            forward = pow(max(dot(ray, sun), 0.0), 12.0)
            light += u.sun * (forward * (if i.meta.z == 6.0 or i.meta.z == 8.0: 0.07 else: 0.28) * (1.0 - density))
            # (rain shafts take the clouds' lighter haze: they stay dark under a far storm)
            # (rain shafts take far less haze than the air around them: grey streaks to the
            # sea are what says "a storm" from 40 km)
            light = if i.meta.z == 8.0 or (i.meta.z == 6.0 and i.weather.y > 1.5): mix(light,u.haze,(1.0-exp(-length(world-u.cam)*max(u.fog,0.000001)*0.12))*0.7) else: aerial(light, world, u.cam, u.haze, u.fog)
            opacity = 1.0 - exp(-density * dt * 0.009)
            color += light * (trans * opacity)
            trans *= 1.0 - opacity
        t += dt
    # Country-sized layers can contain the camera while their record center
    # is hundreds of kilometres away. Their ray interval is already range
    # limited above; a center-distance fade would erase mainland weather.
    fade = if i.meta.z == 4.0 or i.meta.z >= 6.0: 1.0 else: 1.0-smoothstep(125000.0,150000.0,distance)
    vec4(color, 1.0 - trans)*fade

volume_sh: Shader
volume_quad: Mesh
volume_atlas: Texture
volume_instances: InstanceBuffer[VolumeInstance]
volume_visible = 0
# The film's two cloud values: lit tops cream (never mint), the shaded side a
# cool blue-grey 15-32 L* darker (refs: art-direction §3).
volume_paint_light = vec3(0.96,0.87,0.78)
volume_paint_shade = vec3(0.38,0.53,0.61)
volume_paint_grain: f32 = 0.06
# AEGEAN_CLOUD_BRUSH=0 and AEGEAN_CLOUD_STROKES=0 drop the brushed silhouettes
# and the brush strokes (developer cost measurements).
cloud_paint_switches = vec2(if env("AEGEAN_CLOUD_BRUSH") == "0": 0.0 else: 1.0,if env("AEGEAN_CLOUD_STROKES") == "0": 0.0 else: 1.0)
# The look from inside a cloud, for tuning against film: the size (m) of the
# darker and lighter masses drifting past, their contrast, the mist's
# brightness. AEGEAN_CLOUD_INSIDE="40 0.55 1" overrides them.
const CLOUD_INSIDE_SIZE: f32 = 40.0
const CLOUD_INSIDE_CONTRAST: f32 = 0.55
const CLOUD_INSIDE_BRIGHTNESS: f32 = 1.0
cloud_inside_look = (() -> vec4:
    words = (env("AEGEAN_CLOUD_INSIDE") ?? "").split()
    if words.len() != 3: return vec4(CLOUD_INSIDE_SIZE,CLOUD_INSIDE_CONTRAST,CLOUD_INSIDE_BRIGHTNESS,0)
    vec4(f32(to_float(words[0]) ?? 40.0),f32(to_float(words[1]) ?? 0.55),f32(to_float(words[2]) ?? 1.0),0))()

paint_env_color = (key: str, fallback: vec3) -> vec3:
    words = (env(key) ?? "").split()
    if words.len() != 3: return fallback
    vec3(f32(to_float(words[0]) ?? f64(fallback.x)),f32(to_float(words[1]) ?? f64(fallback.y)),f32(to_float(words[2]) ?? f64(fallback.z)))
volume_occluders: CloudVolume[]
volume_color: RenderTarget
volume_weather_small = false
volume_rain_small = false

struct VolumeCompositeParams:
    color: Texture
    depth: Texture
    size: vec2
    depth_ab: vec2
    sun_uv: vec2
    shaft_color: vec3
    shaft_gain: f32
    shaft_steps: f32
    screen_size: vec2
    rect: vec4
    grain_gain: f32

struct VolumeCompositeOut:
    pos: vec4
    uv: vec2

volume_composite_vs = (v: VolumeVertex, u: VolumeCompositeParams) -> VolumeCompositeOut:
    uv = mix(u.rect.xy,u.rect.zw,v.corner)
    VolumeCompositeOut(vec4(uv * 2.0 - vec2(1, 1), 0, 1), uv)

volume_view_depth = (d: f32, ab: vec2) -> f32: world_depth_decode(d,ab)

volume_nearest_resolves = (center: f32, nearest: f32) -> bool:
    abs(nearest-center) <= max(8.0,center*0.025)*7.0

volume_edge_weight = (depth: Texture, uv: vec2, size: vec2, ab: vec2) -> f32:
    center = volume_view_depth(sample(depth, uv).x, ab)
    pixel = uv * size - vec2(0.5, 0.5)
    base = floor(pixel); f = fract(pixel)
    weight: f32 = 0.0
    loop k in 0..4:
        q = (base + vec2(f32(k % 2), f32(k / 2)) + vec2(0.5, 0.5)) / size
        z = volume_view_depth(sample(depth, q).x, ab)
        delta = abs(z - center) / max(8.0, center * 0.025)
        weight += (if k % 2 == 0: 1.0 - f.x else: f.x) * (if k / 2 == 0: 1.0 - f.y else: f.y) / (1.0 + delta * delta * delta * delta)
    weight

volume_composite_fs = (i: VolumeCompositeOut, u: VolumeCompositeParams) -> vec4:
    center = volume_view_depth(sample(u.depth, i.uv).x, u.depth_ab)
    pixel = i.uv * u.size - vec2(0.5, 0.5)
    base = floor(pixel); f = fract(pixel)
    color = vec4(0, 0, 0, 0); weight: f32 = 0.0
    loop k in 0..4:
        corner = vec2(f32(k % 2), f32(k / 2))
        uv = (base + corner + vec2(0.5, 0.5)) / u.size
        depth = volume_view_depth(sample(u.depth, uv).x, u.depth_ab)
        delta = abs(depth - center) / max(8.0, center * 0.025)
        # Reject cloud/sky samples across an opaque silhouette. An unresolved
        # isolated pixel is resolved by the full-resolution edge pass.
        w = (if k % 2 == 0: 1.0 - f.x else: f.x) * (if k / 2 == 0: 1.0 - f.y else: f.y) / (1.0 + delta * delta * delta * delta)
        color += sample(u.color, uv) * w; weight += w
    result = if weight < 0.0001: vec4(0, 0, 0, 0) else: color / weight
    if u.shaft_gain > 0.0:
        # Screen-space crepuscular rays. Both land and the integrated cloud
        # transmittance occlude them. Bounded taps; no temporal trails/history.
        light: f32 = 0.0
        loop k in 0..8:
            if f32(k) >= u.shaft_steps: break
            q = mix(i.uv, u.sun_uv, (f32(k) + 0.5) / u.shaft_steps * 0.85)
            if q.x < 0.0 or q.y < 0.0 or q.x > 1.0 or q.y > 1.0: continue
            clear = step(0.999999, sample(u.depth, q).x)
            light += (1.0 - sample(u.color, q).w) * clear / u.shaft_steps
        path = 1.0 - exp(-center * 0.00025)
        cone = exp(-dot(i.uv - u.sun_uv, i.uv - u.sun_uv) * 1.8)
        result = vec4(result.xyz + u.shaft_color * (light * u.shaft_gain * path * cone * (1.0 - result.w)), result.w)
    # Paper grain is evaluated once at the final pixel size, never enlarged
    # with the half/third/quarter resolution cloud target. Premultiplied RGB
    # keeps empty sky pixels untouched. No extra texture or history.
    if u.grain_gain <= 0.0 or result.w < 0.001: return result
    paper = (paint_paper(i.pos.xy)-1.0)/0.06
    vec4(result.xyz*(1.0+paper*u.grain_gain),result.w)

# Mark resolved pixels in the scene target's spare depth renderbuffer. Hardware
# depth rejection then skips every weather layer at those pixels, without an
# extra texture allocation or repeating the guide decision in each layer.
struct VolumeRepairParams:
    depth: Texture
    size: vec2
    depth_ab: vec2
    rect: vec4

volume_repair_vs = (v: VolumeVertex,u: VolumeRepairParams) -> VolumeCompositeOut:
    uv = mix(u.rect.xy,u.rect.zw,v.corner)
    VolumeCompositeOut(vec4(uv*2.0-vec2(1,1),0,1),uv)

volume_repair_fs = (i: VolumeCompositeOut,u: VolumeRepairParams) -> vec4:
    nearest = (floor(i.uv*u.size)+vec2(0.5,0.5))/u.size
    raw = sample(u.depth,i.uv).x; next = sample(u.depth,nearest).x
    if raw == next: return vec4(0,0,0,0)
    if volume_nearest_resolves(volume_view_depth(raw,u.depth_ab),volume_view_depth(next,u.depth_ab)): return vec4(0,0,0,0)
    if volume_edge_weight(u.depth,i.uv,u.size,u.depth_ab) < 0.0001: discard()
    vec4(0,0,0,0)

volume_repair_sh: Shader
volume_composite_sh: Shader

init_cloud_volumes = ():
    global volume_sh, volume_quad, volume_atlas, volume_instances, volume_composite_sh,volume_repair_sh
    global volume_paint_light,volume_paint_shade,volume_paint_grain
    volume_paint_light = paint_env_color("CLOUD_PAINT_LIGHT",volume_paint_light)
    volume_paint_shade = paint_env_color("CLOUD_PAINT_SHADE",volume_paint_shade)
    volume_paint_grain = f32(clamp(to_float(env("CLOUD_PAINT_GRAIN") ?? "0.025") ?? 0.025,0.0,0.2))
    volume_sh = make_shader(shader(volume_vs, volume_fs))
    volume_composite_sh = make_shader(shader(volume_composite_vs, volume_composite_fs))
    volume_repair_sh = make_shader(shader(volume_repair_vs,volume_repair_fs))
    volume_quad = mesh([VolumeVertex(vec2(0, 0)), VolumeVertex(vec2(1, 0)), VolumeVertex(vec2(0, 1)), VolumeVertex(vec2(1, 1))], [u32(0), u32(1), u32(2), u32(2), u32(1), u32(3)])
    atlas = load_texture(embed('../assets/clouds.png'), true)
    if atlas is ImageError: panic("clouds atlas: {atlas}")
    volume_atlas = atlas
    empty: VolumeInstance[]
    volume_instances = instance_buffer(empty)

cloud_support_radius = (v: CloudVolume) -> f32:
    length(v.extent)+max(v.extent.x,v.extent.z)*(abs(v.growth.z)+abs(v.growth.w))

volume_bounds = (v: CloudVolume, cam: vec3, vp: mat4) -> vec4:
    lo = vec2(1, 1); hi = vec2(-1, -1)
    reach = length(v.extent.xz)
    distance_xz = length(v.center.xz - cam.xz)
    pad = world_drop(vec2(distance_xz + reach, 0)) - world_drop(vec2(distance_xz, 0))
    low = v.extent * (CLOUD_MIN-cloud_growth_padding(v.growth)) - vec3(0, pad, 0)
    high = v.extent * (CLOUD_MAX+cloud_growth_padding(v.growth)) + vec3(0, pad, 0)
    center = render_world(v.center, cam)
    yaw = vec2(cos(v.heading), sin(v.heading))
    loop corner in 0..8:
        p = center + cloud_to_world(vec3(if corner & 1 == 0: low.x else: high.x, if corner & 2 == 0: low.y else: high.y, if corner & 4 == 0: low.z else: high.z), yaw)
        clip = vp * vec4(p, 1)
        if clip.w <= 0.01: return vec4(-1, -1, 1, 1)
        q = clip.xy / clip.w
        lo = min(lo, q); hi = max(hi, q)
    vec4(max(lo, vec2(-1, -1)), min(hi, vec2(1, 1)))

draw_cloud_volumes = (clouds: CloudVolume[], L: Light):
    global volume_visible, volume_color, volume_weather_small,volume_rain_small,volume_occluders
    if not __post_active or cloud_scene_depth.id == 0: return
    zone("cloud volumes")
    cam = scene_camera(); chart = render_origin(cam)
    vp = render_view_proj(chart); planes = __frustum(vp)
    selected: CloudVolume[]
    loop v in clouds:
        center = render_world(world_local(cloud_point(v),chart), render_eye(chart))
        reach = length(v.extent.xz)
        distance_xz = length(v.center.xz - cam.xz)
        radius = cloud_support_radius(v) + world_drop(vec2(distance_xz + reach, 0)) - world_drop(vec2(distance_xz, 0))
        visible = true
        loop plane in planes:
            if dot(plane.xyz, center) + plane.w < -radius: visible = false; break
        if visible: selected.push(v)
    selected.sort((v: CloudVolume) -> f64: f64(length(v.center - cam)), descending = true)
    volume_occluders = selected
    instances: VolumeInstance[]
    composite_low = vec2(1,1); composite_high = vec2(-1,-1)
    weather_coverage: f32 = 0.0
    paint_coverage: f32 = 0.0
    deck_coverage: f32 = 0.0; rain_coverage: f32 = 0.0
    loop v in selected:
        local = v; local.center = world_local(cloud_point(v),chart)
        rect = volume_bounds(local, render_eye(chart), vp)
        if rect.x >= rect.z or rect.y >= rect.w: continue
        area = (rect.z-rect.x)*(rect.w-rect.y)*v.weather.x*0.25
        if v.shape < 4.0: paint_coverage += area
        if v.shape >= 4.0: weather_coverage += area
        if v.shape == 4.0 or v.shape == 10.0: deck_coverage += area
        if v.shape == 6.0 or v.shape == 8.0: rain_coverage += area
        # A distant thunderhead can be costly while occupying less area than
        # a broad deck. Use the same weather target once it is visibly substantial.
        if v.shape == 5.0 and area > 0.03: weather_coverage = max(weather_coverage,0.31)
        composite_low = min(composite_low,rect.xy); composite_high = max(composite_high,rect.zw)
        air = sky_air_color(normalize(render_world(v.center,cam)-cam).y,cam.y,L.sun_dir.y,L.sky_top,L.sky_horizon,L.haze)
        instances.push(VolumeInstance(rect, world_local(cloud_point(v),chart), v.extent, vec4(cos(v.heading), sin(v.heading), v.shape, v.tone), v.weather,v.growth,air,cloud_stamp_slab(int(v.stamp)),cloud_stamp_voxels(int(v.stamp),v.mirror)))
    volume_visible = instances.len()
    set_instances(volume_instances, instances)
    rays = render_rays(vp)
    steps: f32 = if render_quality.tier == 0: 24.0 else: 40.0
    # Broad, softly varying weather layers need fewer pixels than isolated
    # cumulus silhouettes. Hysteresis avoids reallocating around the threshold;
    # the existing full-resolution depth-edge repair still protects foregrounds.
    if weather_coverage > 0.3: volume_weather_small = true
    if weather_coverage < 0.15: volume_weather_small = false
    # Two overlapping soft layers (front/rain) cost more than an isolated
    # thunderhead. Give their wash fewer pixels, retaining full-resolution
    # scene-depth repair and full-resolution near rain/trails.
    layered = min(deck_coverage,rain_coverage)
    if layered > 0.02: volume_rain_small = true
    if layered < 0.01: volume_rain_small = false
    # Same painted representation and target on every tier. Half-resolution
    # cards measured 3.2ms on UHD620; thirds measured 2.75ms. Grain and opaque
    # edge repair stay at output resolution, preserving thin aircraft/trails.
    divisor = if volume_rain_small: 4 else: 3
    w = max(1, cloud_scene_depth.width / divisor); h = max(1, cloud_scene_depth.height / divisor)
    p = VolumeParams(rays, render_eye(chart), normalize(rays[2].xyz), L.sun_dir, L.sun, L.shade, L.haze, f32(L.fog_density), world_depth_params(), volume_atlas, cloud_scene_depth, steps, if render_quality.tier == 0: 0.0 else: 1.0, vec2(f32(w), f32(h)), 0.0)
    if weather_active:
        # The cloud blocks sunlight for the observer, not for its own exposed top.
        # Surface normals/self-shadowing handle that; camera weather dimming would
        # turn the same sunlit crown brown when viewed from inside the deck.
        p.sun = light_at(weather_hour_now).sun
        p.lightning = weather_lightning()
        if weather_strike.key >= 0: p.bolt = world_local(weather_strike.center,chart)+vec3(0,if weather_strike.ground: 1000.0 else: 1200.0,0)
    p.inside = cloud_inside_look
    # (the low tier keeps the strokes and bands, not the brushed silhouettes:
    # their noise at every march step near a surface cost redfox about 0.3 ms)
    p.paint = vec2(if render_quality.tier == 0: 0.0 else: cloud_paint_switches.x,cloud_paint_switches.y)
    p.paint_light = volume_paint_light; p.paint_shade = volume_paint_shade
    sun_clip = vp * vec4(L.sun_dir, 0)
    sun_uv = sun_clip.xy / max(sun_clip.w, 0.0001) * 0.5 + vec2(0.5, 0.5)
    # Moist air makes breaks visible outside the golden hour too. The same
    # bounded depth/transmittance taps occlude them; no fair-noon extra pass.
    moist = if weather_active: weather_here.rain*(1.0-smoothstep(weather_here.ceiling+450.0,weather_here.ceiling+900.0,cam.y)) else: 0.0
    shaft = smoothstep(-0.03,0.05,L.sun_dir.y)*max((1.0-smoothstep(0.15,0.55,L.sun_dir.y))*0.12,moist*0.18)
    if sun_clip.w <= 0.0 or sun_uv.x < -0.25 or sun_uv.x > 1.25 or sun_uv.y < -0.25 or sun_uv.y > 1.25: shaft = 0.0
    # The laptop bound rejected native-resolution cards (~4ms). Reuse the
    # reduced target; full-resolution grain and scene-edge repair remain intact.
    # A color-only reduced target. Scene depth remains attached to the scene
    # while this DIFFERENT framebuffer samples it, which is legal on WebGL2.
    if volume_color.texture.width != w or volume_color.texture.height != h:
        if volume_color.fbo != 0: free_render_target(volume_color)
        tex = texture(image(w, h), true)
        fbo = gl_create_framebuffer()
        glBindFramebuffer(GL_FRAMEBUFFER, u32(fbo))
        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(tex.id), 0)
        volume_color = RenderTarget(tex, fbo, 0)
    # (a broken overcast casts its rolls' shadow through the same pass)
    global cloud_shadow_deck,cloud_shadow_deck_frame
    cloud_shadow_deck = vec4(0,0,0,0)
    loop v in clouds:
        if v.shape != 12.0: continue
        c = world_local(cloud_point(v),chart)
        cloud_shadow_deck = vec4(c.x,c.z,v.center.y-v.extent.y*0.2,v.weather.x*0.85)
        cloud_shadow_deck_frame = vec4(cos(v.heading),sin(v.heading),cloud_shadow_sun_k.x,cloud_shadow_sun_k.y)
    cloud_shadow_factor_pass(chart,vp)
    glBindFramebuffer(GL_FRAMEBUFFER, u32(volume_color.fbo))
    glViewport(0, 0, i32(w), i32(h))
    glDisable(GL_DEPTH_TEST); glDepthMask(0)
    glClearColor(0, 0, 0, 0); glClear(GL_COLOR_BUFFER_BIT)
    glEnable(GL_BLEND)
    glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA)
    glDisable(GL_CULL_FACE)
    zone("cloud color")
    draw_instanced(volume_sh, volume_quad, volume_instances, p)
    zone_end()
    # The final full-resolution reconstruction samples scene depth, so swap its
    # attachment out temporarily. Color and the actual scene depth are preserved.
    detach_cloud_depth()
    glViewport(0, 0, i32(cloud_scene_depth.width), i32(cloud_scene_depth.height))
    cloud_shadow_multiply()
    # With no shafts, clear pixels outside every projected cloud cannot
    # contribute. Include two low-resolution texels for reconstruction taps.
    # This uses the same conservative curved bounds as the volume/edge passes.
    composite_rect = vec4(0,0,1,1)
    if shaft == 0.0:
        pad_uv = vec2(2.0/f32(w),2.0/f32(h))
        composite_rect = vec4(max(vec2(0,0),composite_low*0.5+vec2(0.5,0.5)-pad_uv),min(vec2(1,1),composite_high*0.5+vec2(0.5,0.5)+pad_uv))
    zone("cloud composite")
    if shaft > 0.0 or instances.len() > 0:
        draw(volume_composite_sh, volume_quad, VolumeCompositeParams(volume_color.texture, cloud_scene_depth, vec2(f32(w), f32(h)), p.depth_ab, sun_uv, L.sun, shaft, if render_quality.tier == 0: 4.0 else: 8.0, vec2(f32(cloud_scene_depth.width),f32(cloud_scene_depth.height)),composite_rect,if volume_weather_small or volume_rain_small: 0.0 else: volume_paint_grain))
    zone_end()
    # The actual scene depth is detached and sampled read-only. Its spare
    # renderbuffer is disposable: clear to far, write 0.5 where reconstruction
    # succeeded, then render edge quads at 0.5 with LESS. Only holes pass.
    # Large nearby paintings benefit from the same early depth rejection as
    # weather: don't shade every overlapping full-resolution quad in clear sky.
    if volume_weather_small or volume_rain_small or paint_coverage > 0.7:
        glEnable(GL_DEPTH_TEST); glDepthFunc(GL_LESS); glDepthMask(1)
        glClear(GL_DEPTH_BUFFER_BIT)
        glColorMask(0,0,0,0)
        rect = vec4(composite_low*0.5+vec2(0.5,0.5),composite_high*0.5+vec2(0.5,0.5))
        zone("cloud guide")
        draw(volume_repair_sh,volume_quad,VolumeRepairParams(cloud_scene_depth,p.low_size,p.depth_ab,rect))
        zone_end()
        glColorMask(1,1,1,1); glDepthMask(0)
        p.repair_ready = 1.0
    p.edge_pass = 1.0
    zone("cloud edges")
    draw_instanced(volume_sh, volume_quad, volume_instances, p)
    zone_end()
    glDepthFunc(world_depth_compare())
    restore_cloud_depth()
    zone_end()

cloud_point=(v:CloudVolume)->WorldPoint:
    p=v.precise ?? world_point(v.center)
    WorldPoint(p.x,f64(v.center.y),p.z)
