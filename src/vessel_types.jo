use 'world_point.jo'
# Saved vessel identity/motion. No graphics, people, cargo creation, or economics.
enum VesselKind: sail_caique, motor_caique, trehantiri, coastal_steamer, island_ferry, passenger_steamer, tramp_freighter, tanker, motor_yacht, rowboat, dinghy, lighthouse_tender, kalyra_torpedo, orenthia_torpedo, kalyra_destroyer, orenthia_destroyer, gunboat, seaplane_tender, canal_barge, canal_launch
enum VesselStatus: waiting_route, underway, docked, anchored, stopped, sinking, sunk, captured
enum VesselEventKind: arrived, blocked, stopped, resumed, damaged, sinking, sunk, captured, lifeboats

enum SeaRouteStatus: queued, searching, validating, ready, blocked

struct VesselSpec:
    name: str
    length: f64
    beam: f64
    draft: f64
    speed: f64
    deck: f64
    mass: f64
    sail: bool = false
    steam: bool = false
    navy: bool = false
    mooring: bool = false
    lifeboats: int = 0

vessel_spec = (kind: VesselKind) -> VesselSpec:
    match kind:
        .canal_barge: VesselSpec("Canal barge",18,4.8,1.1,1.6,1.1,42000)
        .canal_launch: VesselSpec("Canal launch",8,2.3,0.55,2.4,0.7,2200)
        .sail_caique: VesselSpec("Sailing caique",12,3.8,1.1,3.2,1.5,12000,sail=true)
        .motor_caique: VesselSpec("Motor caique",13.5,4.2,1.2,4.0,1.7,18000)
        .trehantiri: VesselSpec("Trading trehantiri",26,7,2.4,4.5,2.9,100000,sail=true,mooring=true,lifeboats=2)
        .coastal_steamer: VesselSpec("Coastal steamer",48,8.5,3.3,5.5,3.8,550000,steam=true,mooring=true,lifeboats=2)
        .island_ferry: VesselSpec("Island ferry",39,9,2.4,5.0,3.1,330000,steam=true,mooring=true,lifeboats=2)
        .passenger_steamer: VesselSpec("Passenger steamer",118,17,6.0,8.2,7.5,5700000,steam=true,mooring=true,lifeboats=8)
        .tramp_freighter: VesselSpec("Tramp freighter",86,13,5.2,5.6,5.7,2900000,steam=true,mooring=true,lifeboats=4)
        .tanker: VesselSpec("Coastal tanker",94,14,5.5,5.8,5.3,3900000,steam=true,mooring=true,lifeboats=4)
        .motor_yacht: VesselSpec("Motor yacht",23,4.8,1.7,7.5,2.3,45000,mooring=true,lifeboats=1)
        .rowboat: VesselSpec("Rowing boat",5,1.6,0.35,1.3,0.55,350)
        .dinghy: VesselSpec("Sailing dinghy",4.3,1.5,0.45,2.2,0.5,250,sail=true)
        .lighthouse_tender: VesselSpec("Lighthouse tender",33,7,2.6,4.8,3.0,200000,steam=true,mooring=true,lifeboats=1)
        .kalyra_torpedo: VesselSpec("Kalyra torpedo boat",47,5.1,1.8,13,2.4,210000,steam=true,navy=true,lifeboats=1)
        .orenthia_torpedo: VesselSpec("Orenthia torpedo boat",53,5.5,2.0,12.5,2.5,250000,steam=true,navy=true,lifeboats=1)
        .kalyra_destroyer: VesselSpec("Kalyra destroyer",94,9.2,3.0,15.5,4.4,1250000,steam=true,navy=true,mooring=true,lifeboats=3)
        .orenthia_destroyer: VesselSpec("Orenthia destroyer",101,10,3.2,15,4.8,1600000,steam=true,navy=true,mooring=true,lifeboats=3)
        .gunboat: VesselSpec("Harbor gunboat",42,7.7,2.0,5.5,3.0,330000,steam=true,navy=true,lifeboats=2)
        .seaplane_tender: VesselSpec("Seaplane tender",77,13,4.1,6.2,5.0,1900000,steam=true,navy=true,mooring=true,lifeboats=4)

const VESSEL_LIMIT = 128
const SEA_LANE_LIMIT = 32
const SEA_NODE_LIMIT = 12000
const VESSEL_DT = 1.0/30.0

struct SeaLane:
    id: int
    origin: int
    destination: int
    start: vec2
    finish: vec2
    draft: f64
    clearance: f64
    status: SeaRouteStatus = .queued
    points: vec2[]
    levels: f32[]                   # optional canonical inland level at each route vertex
    distance = 0.0
    anchorage = false
    repeat = false
    reason = ""
    # Validation works incrementally over the candidate polyline.
    candidate: vec2[]
    checked_segment = 0
    checked_sample = 0
    retries = 0

struct SeaNode:
    key: int
    at: vec2
    cost: f64
    parent: int
    closed = false

struct SeaSearch:
    lane = -1
    nodes: SeaNode[]
    by_key: {int: int}
    # Failed fine checks blacklist an edge, never publish a guessed safe path.
    forbidden: {int: bool}
    path_nodes: int[]
    expanded = 0
    grid = 1500.0
    open: (f64,int)[]
    current = -1
    neighbor = 0
    sample = 0

struct Vessel:
    id: int
    kind: VesselKind
    owner: int
    side: int
    cargo: int[]
    crew: int[]
    convoy = -1
    escort = -1
    lane = -1
    position: vec3
    precise=WorldPoint()
    published=vec3(0,0,0)
    precise_ready=false
    velocity: vec3 = vec3(0,0,0)
    yaw = 0.0                        # bow points +z; atan2(dx,dz)
    speed = 0.0
    segment = 0
    progress = 0.0
    status: VesselStatus = .waiting_route
    health = 1.0
    fire = 0.0
    flooding = 0.0
    sink_age = 0.0
    lifeboats_released = false
    attacker = -1
    external = false                 # existing living Trip owns movement
    source_trip = -1
    seen_tick = 0
    desired_speed = 1.0

struct VesselEvent:
    serial: int
    vessel: int
    kind: VesselEventKind
    position: vec3
    owner: int
    attacker: int = -1
    other: int = -1
    health: f64 = 1.0

struct VesselSurvival:
    vessel: int
    at: vec3
    crew: int[]                        # original person IDs; never new people
    boats: int
    born: f64
    rescued = false

struct VesselFleet:
    version = 1
    ships: Vessel[]
    lanes: SeaLane[]
    search: SeaSearch
    events: VesselEvent[]
    survivors: VesselSurvival[]
    serial = 0
    tick = 0
    accumulator = 0.0
    seconds = 0.0
    next_lane = 0

vessel_index = (f: VesselFleet,id: int) -> int:
    loop k in 0..f.ships.len():
        if f.ships[k].id == id: return k
    -1
sea_lane_index = (f: VesselFleet,id: int) -> int:
    loop k in 0..f.lanes.len():
        if f.lanes[k].id == id: return k
    -1

# Rendering and collision share the same sinking waterline.
vessel_sink_depth = (v: Vessel) -> f64:
    if v.status != .sinking and v.status != .sunk: return 0.0
    spec = vessel_spec(v.kind)
    min(1.0,v.sink_age/65.0)*(spec.draft+spec.deck+spec.beam)

vessel_funnels = (kind: VesselKind) -> int:
    if kind == .passenger_steamer or kind == .kalyra_destroyer: 2 else: if kind == .orenthia_destroyer: 3 else: 1

vessel_point=(v:Vessel)->WorldPoint:
    if v.precise_ready and v.position==v.published:v.precise else:world_point(v.position)
