# The catch, drawn: each kind of fish at its own size (from its weight) and colours, flapping in
# the hand a while after it is landed; the zinc bucket with a handful in it, set on the dock or
# carried by its handle; and the splash of one thrown back. Built from the game's own shapes,
# nothing painted.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'folk.jo'
use 'fishing.jo'

struct FishLook:
    back: vec4                      # the colour along the back
    belly: vec4
    fin: vec4
    depth = 0.24                    # (the body's height, and its width, to its length)
    width = 0.12
    k = 0.010                       # (grams = k * cm^3: how stout it is for its length)
    pattern = 0                     # 0 plain, 1 dark bars (mackerel), 2 gold stripes (bogue, mullet), 3 mottled (scorpion fish)

# (in FISH_KINDS' order)
FISH_LOOKS: FishLook[] = [
    FishLook(rgb(0.22, 0.38, 0.5), rgb(0.86, 0.88, 0.88), rgb(0.6, 0.66, 0.7), 0.18, 0.1, 0.008),                  # sardine
    FishLook(rgb(0.86, 0.36, 0.3), rgb(0.95, 0.82, 0.74), rgb(0.92, 0.55, 0.42), 0.23, 0.13, 0.011, 2),              # red mullet
    FishLook(rgb(0.52, 0.56, 0.48), rgb(0.88, 0.88, 0.82), rgb(0.66, 0.66, 0.56), 0.22, 0.11, 0.009, 2),             # bogue
    FishLook(rgb(0.16, 0.42, 0.42), rgb(0.9, 0.9, 0.86), rgb(0.4, 0.48, 0.5), 0.19, 0.12, 0.008, 1),                 # mackerel
    FishLook(rgb(0.6, 0.62, 0.6), rgb(0.9, 0.9, 0.88), rgb(0.5, 0.52, 0.55), 0.4, 0.13, 0.017),                      # bream
    FishLook(rgb(0.66, 0.26, 0.16), rgb(0.88, 0.62, 0.5), rgb(0.6, 0.24, 0.16), 0.32, 0.22, 0.02, 3),                # scorpion fish
    FishLook(rgb(0.46, 0.5, 0.52), rgb(0.92, 0.92, 0.9), rgb(0.42, 0.45, 0.48), 0.24, 0.13, 0.011),                  # sea bass
    FishLook(rgb(0.62, 0.32, 0.28), rgb(0.85, 0.62, 0.55), rgb(0.62, 0.32, 0.28), 0.5, 0.5, 0.03)                    # octopus
]

const OCTOPUS = 7

# A fish's length, nose to tail (metres), from its weight.
fish_length = (c: Catch) -> f64:
    k = FISH_LOOKS[clamp(c.kind, 0, FISH_LOOKS.len() - 1)].k
    pow(f64(c.grams) / k, 1.0 / 3.0) * 0.01

struct FishMeshes:
    ready = false
    body: Mesh[]                    # per kind: unit length along +z (the snout at +0.5), the tail cut at -0.3
    tail: Mesh[]                    # per kind: the tail, hinged at its own origin, reaching to -z
    bucket: Mesh
    water: Mesh                     # (the bucket's water, drawn when fish are in it)
    stall: Mesh                     # the fish stall at a town's market
    locker: Mesh                    # the player's own locker by his mooring

_mix = (a: vec4, b: vec4, u: f64) -> vec4: a + (b - a) * f32(clamp(u, 0.0, 1.0))

# colour a kind's body by where each point is on it: back to belly, then its markings
_paint = (vs: mut Vertex3D[], from: int, look: FishLook):
    loop i in from..vs.len():
        p = vs[i].pos
        up = f64(p.y) / (look.depth * 0.5)              # -1 belly .. 1 back
        c = _mix(look.belly, look.back, up * 0.9 + 0.45)
        z = f64(p.z)
        match look.pattern:
            1:
                # (wavy dark bars over the back)
                if up > 0.15 and sin(z * 62.0 + f64(p.x) * 30.0 + sin(z * 23.0) * 1.4) > 0.25: c = _mix(c, rgb(0.06, 0.12, 0.14), 0.75)
            2:
                # (a thin gold stripe along the flank)
                if abs(up - 0.05) < 0.12: c = _mix(c, rgb(0.92, 0.74, 0.28), 0.8)
            3:
                # (mottled, blotched dark)
                n = sin(z * 47.0 + f64(p.y) * 61.0) * sin(f64(p.x) * 53.0 + z * 29.0)
                if n > 0.3: c = _mix(c, rgb(0.3, 0.12, 0.08), 0.6)
            _: pass
        vs[i].color = c

_fish_body = (look: FishLook) -> Vertex3D[]:
    vs: Vertex3D[]
    d = look.depth; w = look.width
    # the body: an egg, fuller at the head, narrowing to the tail
    add_sphere(vs, vec3(0, 0, 0), 1.0, look.belly, 12, 7, translation(vec3(0, 0, 0.08)) * scaling(vec3(f32(w * 0.5), f32(d * 0.5), 0.42)))
    add_sphere(vs, vec3(0, 0, 0), 1.0, look.belly, 8, 5, translation(vec3(0, 0, -0.26)) * scaling(vec3(f32(w * 0.28), f32(d * 0.26), 0.14)))
    _paint(vs, 0, look)
    # the dorsal fin along the back, and the belly's small fins
    add_box(vs, vec3(0, 0, 0), vec3(0.008, f32(d * 0.28), 0.26), look.fin, translation(vec3(0, f32(d * 0.46), 0.02)) * rotation_x(0.12))
    add_box(vs, vec3(0, 0, 0), vec3(0.008, f32(d * 0.18), 0.12), look.fin, translation(vec3(0, f32(-d * 0.42), -0.1)) * rotation_x(-0.2))
    # the pectoral fins, and the eyes
    loop side in [-1.0, 1.0]:
        add_box(vs, vec3(0, 0, 0), vec3(0.008, 0.035, 0.06), look.fin, translation(vec3(f32(side * w * 0.5), f32(-d * 0.08), 0.22)) * rotation_z(side * 0.3))
        add_sphere(vs, vec3(f32(side * w * 0.36), f32(d * 0.1), 0.38), 0.022, rgb(0.92, 0.85, 0.55), 6, 3)
        add_sphere(vs, vec3(f32(side * w * 0.4), f32(d * 0.1), 0.385), 0.013, rgb(0.04, 0.04, 0.05), 5, 3)
    vs

_fish_tail = (look: FishLook) -> Vertex3D[]:
    vs: Vertex3D[]
    # (the forked tail: two thin blades from the hinge)
    loop side in [-1.0, 1.0]:
        add_box(vs, vec3(0, 0, 0), vec3(0.008, f32(look.depth * 0.5), 0.07), look.fin, translation(vec3(0, f32(side * look.depth * 0.18), -0.07)) * rotation_x(side * 0.55))
    add_box(vs, vec3(0, 0, -0.02), vec3(0.01, 0.05, 0.06), look.fin)
    vs

# the octopus: the mantle (body) and the arms hanging from it (tail)
_octopus_body = (look: FishLook) -> Vertex3D[]:
    vs: Vertex3D[]
    add_sphere(vs, vec3(0, 0, 0), 1.0, look.back, 10, 6, translation(vec3(0, 0.16, 0)) * scaling(vec3(0.13, 0.17, 0.12)))
    add_sphere(vs, vec3(0, 0, 0), 0.1, look.belly, 8, 4)
    loop side in [-1.0, 1.0]: add_sphere(vs, vec3(f32(side * 0.07), 0.02, 0.07), 0.022, rgb(0.95, 0.85, 0.5), 5, 3)
    vs

_octopus_arms = (look: FishLook) -> Vertex3D[]:
    vs: Vertex3D[]
    loop k in 0..8:
        a = f64(k) * TAU / 8.0
        m = rotation_y(a) * rotation_x(PI - 0.35 - 0.12 * f64(k % 3))
        add_cylinder(vs, vec3(0, 0, 0), 0.028, 0.42, _mix(look.back, look.belly, 0.25 * f64(k % 2)), 5, 0.006, translation(vec3(f32(sin(a) * 0.05), 0, f32(cos(a) * 0.05))) * m)
    vs

_bucket = () -> Vertex3D[]:
    vs: Vertex3D[]
    zinc = rgb(0.62, 0.65, 0.64)
    add_cylinder(vs, vec3(0, 0, 0), 0.115, 0.27, zinc, 14, 0.15)
    loop i in 0..vs.len():
        y = f64(vs[i].pos.y)
        # (the seams and the darker rolled rim)
        if y > 0.25 or abs(y - 0.09) < 0.008 or abs(y - 0.18) < 0.008: vs[i].color = rgb(0.5, 0.53, 0.53)
    # the ears and the wire handle, standing up in an arch over the bucket
    loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(side * 0.15), 0.24, 0), vec3(0.012, 0.04, 0.03), rgb(0.45, 0.47, 0.47))
    loop k in 0..9:
        a = PI * (f64(k) + 0.5) / 9.0
        p = vec3(f32(cos(a) * 0.15), f32(0.25 + sin(a) * 0.17), 0)
        add_box(vs, vec3(0, 0, 0), vec3(0.01, 0.065, 0.01), rgb(0.32, 0.33, 0.33), translation(p) * rotation_z(a))
    vs

# The fish stall at a town's market, where the boats' catch is sold (and one's own): a trestle
# table with wooden trays of fish on ice, under a striped awning on four poles. Its front (the
# customer's side) toward +z; the foot at the origin.
_fish_stall = () -> Vertex3D[]:
    vs: Vertex3D[]
    wood = rgb(0.5, 0.36, 0.22); dark = rgb(0.3, 0.21, 0.13)
    # the table and its trestles
    add_box(vs, vec3(0, 0.84, 0), vec3(2.0, 0.06, 0.9), wood)
    loop x in [-0.8, 0.8]:
        loop z in [-0.35, 0.35]: add_box(vs, vec3(f32(x), 0.41, f32(z)), vec3(0.07, 0.82, 0.07), dark)
    # three trays of fish laid on ice, tilted a little toward the customer
    tilt = rotation_x(0.12)
    loop k in 0..3:
        x = (f64(k) - 1.0) * 0.62
        tray = translation(vec3(f32(x), 0.9, 0.05)) * tilt
        add_box(vs, vec3(0, 0, 0), vec3(0.56, 0.06, 0.62), wood, tray)
        add_box(vs, vec3(0, 0.035, 0), vec3(0.5, 0.02, 0.56), rgb(0.88, 0.93, 0.95), tray)
        look = FISH_LOOKS[[0, 1, 3][k]]
        loop j in 0..5:
            z = -0.2 + f64(j) * 0.1
            n = vs.len()
            add_sphere(vs, vec3(0, 0, 0), 1.0, look.belly, 8, 4, tray * translation(vec3(f32((f64(j % 2) - 0.5) * 0.08), 0.06, f32(z))) * rotation_y(PI * 0.5 + f64(j % 2) * 0.15) * scaling(vec3(f32(look.width * 0.11), f32(look.depth * 0.11), 0.2)))
            loop i in n..vs.len():
                if f64(vs[i].pos.y) > 0.92 + 0.012: vs[i].color = _mix(look.belly, look.back, 0.8)
    # a slate on the front, and a set of scales at one end
    add_box(vs, vec3(0, 0.62, 0.46), vec3(0.5, 0.32, 0.03), rgb(0.16, 0.17, 0.18))
    add_box(vs, vec3(0.92, 0.9, -0.25), vec3(0.04, 0.12, 0.04), rgb(0.35, 0.33, 0.3))
    add_cylinder(vs, vec3(0.92, 0.97, -0.25), 0.11, 0.015, rgb(0.62, 0.5, 0.25), 10)
    # the poles and the striped awning, sloping down toward the front
    loop x in [-1.05, 1.05]:
        add_box(vs, vec3(f32(x), 1.1, -0.5), vec3(0.06, 2.2, 0.06), dark)
        add_box(vs, vec3(f32(x), 0.95, 0.55), vec3(0.06, 1.9, 0.06), dark)
    loop k in 0..9:
        x = -1.1 + (f64(k) + 0.5) * 2.2 / 9.0
        col = if k % 2 == 0: rgb(0.86, 0.3, 0.22) else: rgb(0.95, 0.92, 0.84)
        add_box(vs, vec3(0, 0, 0), vec3(f32(2.2 / 9.0), 0.03, 1.3), col, translation(vec3(f32(x), 2.05, 0.03)) * rotation_x(0.22))
        add_box(vs, vec3(0, 0, 0), vec3(f32(2.2 / 9.0), 0.22, 0.03), col, translation(vec3(f32(x), 1.8, 0.66)))
    vs

# The player's locker on the quay: a slatted wooden locker on short legs, painted a weathered
# blue-green, open at the front (its canvas cover rolled up under the eave), two shelves inside: the
# bottom one for a bucket, the upper with a coil of rope, an oil can and a folded tarpaulin. Its
# front toward +z, its foot at the origin; 1.1 wide, 0.65 deep.
_locker = () -> Vertex3D[]:
    vs: Vertex3D[]
    paint = rgb(0.32, 0.5, 0.48); worn = rgb(0.42, 0.58, 0.54); inside = rgb(0.36, 0.28, 0.2); dark = rgb(0.22, 0.17, 0.12)
    # legs, floor and the two shelves
    loop x in [-0.5, 0.5]:
        loop z in [-0.27, 0.27]: add_box(vs, vec3(f32(x), 0.05, f32(z)), vec3(0.06, 0.1, 0.06), dark)
    add_box(vs, vec3(0, 0.12, 0), vec3(1.06, 0.04, 0.6), inside)
    add_box(vs, vec3(0, 0.62, 0), vec3(1.0, 0.03, 0.56), inside)
    # the back and sides, slatted, and the roof sloping to the back
    loop k in 0..6:
        y = 0.18 + f64(k) * 0.2
        add_box(vs, vec3(0, f32(y), -0.3), vec3(1.1, 0.17, 0.04), if k % 2 == 0: paint else: worn)
        loop x in [-0.53, 0.53]: add_box(vs, vec3(f32(x), f32(y), 0), vec3(0.04, 0.17, 0.62), if k % 2 == 0: worn else: paint)
    add_box(vs, vec3(0, 0, 0), vec3(1.2, 0.05, 0.75), dark, translation(vec3(0, 1.33, 0.02)) * rotation_x(-0.12))
    # the canvas cover, rolled up and tied under the eave over the open front, and a brass hasp
    add_cylinder(vs, vec3(0, 0, 0), 0.07, 1.08, rgb(0.62, 0.56, 0.42), 8, -1.0, translation(vec3(-0.54, 1.22, 0.34)) * rotation_z(-PI * 0.5))
    loop x in [-0.35, 0.35]: add_box(vs, vec3(f32(x), 1.22, 0.34), vec3(0.03, 0.16, 0.16), rgb(0.3, 0.24, 0.16))
    add_box(vs, vec3(0.5, 0.75, 0.32), vec3(0.06, 0.08, 0.03), rgb(0.7, 0.55, 0.25))
    # on the upper shelf: a coil of rope, an oil can, a folded tarpaulin
    add_cylinder(vs, vec3(-0.3, 0.635, 0), 0.15, 0.08, rgb(0.72, 0.62, 0.42), 10, 0.13)
    add_cylinder(vs, vec3(-0.3, 0.64, 0), 0.06, 0.08, inside, 8)
    add_cylinder(vs, vec3(0.05, 0.635, -0.05), 0.06, 0.16, rgb(0.55, 0.12, 0.1), 8)
    add_cylinder(vs, vec3(0.05, 0.795, -0.05), 0.012, 0.08, rgb(0.6, 0.6, 0.58), 5)
    add_box(vs, vec3(0.33, 0.68, -0.02), vec3(0.3, 0.09, 0.4), rgb(0.55, 0.5, 0.36))
    # a name stencilled on the side, as a pale band
    add_box(vs, vec3(-0.555, 0.95, 0.05), vec3(0.01, 0.1, 0.4), rgb(0.88, 0.86, 0.78))
    vs

draw_fish_locker = (m: FishMeshes, pos: vec3, front: vec3, L: Light, t: f64):
    if not m.ready: return
    yaw = atan2(f64(front.x), f64(front.z))
    draw(obj_sh, m.locker, obj_local_params(L, t, render_model(translation(pos) * rotation_y(yaw), render_origin(scene_camera()))))

# the stall standing at `pos`, its customers' side toward `front`
draw_fish_stall = (m: FishMeshes, pos: vec3, front: vec3, L: Light, t: f64):
    if not m.ready: return
    yaw = atan2(f64(front.x), f64(front.z))
    draw(obj_sh, m.stall, obj_local_params(L, t, render_model(translation(pos) * rotation_y(yaw), render_origin(scene_camera()))))

build_fish_meshes = () -> FishMeshes:
    m = FishMeshes(ready = true)
    loop k in 0..FISH_LOOKS.len():
        look = FISH_LOOKS[k]
        if k == OCTOPUS:
            m.body.push(custom_mesh(_octopus_body(look)))
            m.tail.push(custom_mesh(_octopus_arms(look)))
        else:
            m.body.push(custom_mesh(_fish_body(look)))
            m.tail.push(custom_mesh(_fish_tail(look)))
    m.bucket = custom_mesh(_bucket())
    w: Vertex3D[]
    add_cylinder(w, vec3(0, 0, 0), 0.142, 0.004, rgb(0.16, 0.26, 0.26), 14)
    m.water = custom_mesh(w)
    m.stall = custom_mesh(_fish_stall())
    m.locker = custom_mesh(_locker())
    m

# A fish drawn at `at` (render space; its snout along +z, its back up), `flap` 0..1 how hard it
# is flapping now, `kick` its phase.
draw_catch = (m: FishMeshes, c: Catch, at: mat4, L: Light, t: f64, flap: f64 = 0.0, kick: f64 = 0.0):
    if not m.ready: return
    k = clamp(c.kind, 0, FISH_LOOKS.len() - 1)
    len = fish_length(c)
    if k == OCTOPUS:
        # (held by the mantle, its arms hanging and curling)
        s = at * scaling(len * 2.2)
        draw(obj_sh, m.body[k], obj_local_params(L, t, s))
        draw(obj_sh, m.tail[k], obj_local_params(L, t, s * rotation_x(sin(kick * 0.6) * 0.25 * (0.3 + flap)) * rotation_z(cos(kick * 0.45) * 0.2 * (0.3 + flap))))
        return
    wag = sin(kick * 2.0) * (0.08 + 0.75 * flap)
    body = at * rotation_y(-wag * 0.35) * rotation_z(sin(kick * 1.3) * 0.4 * flap) * scaling(len)
    draw(obj_sh, m.body[k], obj_local_params(L, t, body))
    draw(obj_sh, m.tail[k], obj_local_params(L, t, body * translation(vec3(0, 0, -0.36)) * rotation_y(wag)))

# How hard a fish landed `age` seconds ago flaps: hard at first, then in fits, then hardly at all.
fish_flap = (age: f64, seed: int = 0) -> f64:
    if age < 0.0: return 0.0
    fits = max(0.0, sin(age * 1.7 + f64(seed % 7)) - 0.55) * 1.6
    clamp(exp(-age * 0.5) + fits * exp(-age * 0.08) * 0.6, 0.0, 1.0)

# The fish in the pilot's right hand, held up by the gills to be seen: hanging head up, its flank
# to the front and back, a little out from his side.
draw_held_fish = (m: FishMeshes, f: Figure, c: Catch, pos: vec3, yaw: f64, phase: f64, stride: f64, L: Light, t: f64, flap: f64, offset: vec3 = vec3(0,0,0)):
    hand = figure_hand(f, pos, yaw, phase, stride, 1.0, HELD_ARM, offset) * rotation_x(-HELD_ARM) * translation(vec3(0.08, 0, 0))
    kick = t * (9.0 + 9.0 * flap)
    if c.kind == OCTOPUS:
        draw_catch(m, c, hand * translation(vec3(0, -0.1, 0)) * scaling(HELD_SCALE), L, t, flap, kick)
        return
    len = fish_length(c)
    # (the body swings from the fist as it flaps)
    swing = rotation_z(sin(kick * 0.7) * 0.25 * flap) * rotation_x(sin(kick * 0.55 + 1.0) * 0.18 * flap)
    grip = hand * swing * rotation_y(PI * 0.5) * rotation_x(-PI * 0.5) * scaling(HELD_SCALE) * translation(vec3(0, 0, f32(-len * 0.36)))
    draw_catch(m, c, grip, L, t, flap, kick)

const HELD_ARM = 1.05               # (the right arm's swing, forward, holding a fish up)
const HELD_SCALE = 1.25             # (a fish held up looks its size beside the blocky figures)
const BUCKET_ARM = 0.06             # (the left arm hanging, the bucket in its hand)

# the bucket and what is in it, standing at `at` (render space, its foot at the origin)
draw_bucket_at = (m: FishMeshes, pail: Catch[], at: mat4, L: Light, t: f64):
    if not m.ready: return
    draw(obj_sh, m.bucket, obj_local_params(L, t, at))
    if pail.len() == 0: return
    draw(obj_sh, m.water, obj_local_params(L, t, at * translation(vec3(0, 0.24, 0))))
    # (the fish in it heads down, tails up out of the water, leaning on the rim)
    loop k in 0..pail.len():
        c = pail[k]
        a = f64(k) * 2.4 + 0.3
        r = if k == 0: 0.0 else: 0.065
        len = fish_length(c)
        lift = if c.kind == OCTOPUS: 0.27 else: 0.27 - len * 0.18
        place = at * translation(vec3(f32(cos(a) * r), f32(lift), f32(sin(a) * r))) * rotation_y(a)
        if c.kind == OCTOPUS: draw_catch(m, c, place * scaling(0.6), L, t, 0.0, t)
        else: draw_catch(m, c, place * rotation_x(PI * 0.5 - 0.35) * rotation_z(f64(k) * 0.9), L, t, 0.0, t * 0.7 + f64(k))

# the bucket on the ground at a world position
draw_bucket = (m: FishMeshes, pail: Catch[], pos: vec3, yaw: f64, L: Light, t: f64):
    at = render_model(translation(pos) * rotation_y(yaw), render_origin(scene_camera()))
    draw_bucket_at(m, pail, at, L, t)

# the bucket in the pilot's left hand, hanging upright by its handle and swinging with his walk
draw_carried_bucket = (m: FishMeshes, f: Figure, pail: Catch[], pos: vec3, yaw: f64, phase: f64, stride: f64, L: Light, t: f64, offset: vec3 = vec3(0,0,0)):
    hand = figure_hand(f, pos, yaw, phase, stride, -1.0, BUCKET_ARM, offset)
    grip = hand[3].xyz
    swing = sin(phase) * 0.12 * stride
    at = translation(grip) * rotation_y(yaw + PI) * rotation_x(swing) * translation(vec3(0, -0.4, 0))
    draw_bucket_at(m, pail, at, L, t)
