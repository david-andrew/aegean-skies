use 'world_point.jo'
# Working boats use saved Trips and real owners, without aircraft resources or scene bodies.
use 'living_types.jo'
use 'living_travel.jo'
use 'living_events.jo'

begin_fishing = (w: mut World, person: int) -> int:
    home = w.people[person].home
    if w.people[person].trip >= 0 or w.people[person].place != home or w.places[home].harbor_closed: return -1
    clock = local_minute(w.minute)
    if clock < 330 or clock >= 600: return -1
    id = w.next_trip; w.next_trip += 1
    h = w.harbors[home]; ground = h.safe_water+h.out*50.0
    remaining = (600-clock)*120
    transit = min(1200,max(1,remaining/3))
    reason = Reason(purpose=.fishing,actor=person,origin=home,destination=home,good=0)
    w.trips[id] = Trip(id=id,actor=person,mode=.boat,state=.active,origin=home,destination=home,reason=reason,route=[h.buoy,ground,ground,h.buoy],segment_ticks=[transit,max(1,remaining-transit*2),transit],cruise_mm_per_sec=6000,departed_tick=w.tick,last_tick=w.tick,eta_tick=w.tick+remaining)
    w.active_trips.push(id)
    w.people[person].trip = id; w.people[person].place = -1; w.people[person].state = .working
    w.people[person].pose.pos = h.buoy
    w.places[home].residents.remove(person)
    emit_event(w,.departed,home,person,-1,reason)
    id

advance_workboats = (w: mut World):
    loop id in w.active_trips:
        if w.trips[id].mode != .boat or w.trips[id].reason.purpose != .fishing or w.trips[id].state == .arrived: continue
        p = w.trips[id].actor
        if w.people[p].move_owner == .scene: continue
        remaining = w.tick-w.trips[id].last_tick
        w.trips[id].last_tick = w.tick
        loop remaining > 0 and w.trips[id].segment < w.trips[id].route.len()-1:
            s = w.trips[id].segment; duration = w.trips[id].segment_ticks[s]
            dt = min(remaining,duration-w.trips[id].segment_elapsed_ticks)
            w.trips[id].segment_elapsed_ticks += dt; remaining -= dt
            place_pose(w.people[p].pose,world_lerp(world_point(w.trips[id].route[s]),world_point(w.trips[id].route[s+1]),f64(w.trips[id].segment_elapsed_ticks)/f64(duration)))
            if w.trips[id].segment_elapsed_ticks >= duration:
                w.trips[id].segment += 1; w.trips[id].segment_elapsed_ticks = 0
        if w.tick >= w.trips[id].eta_tick:
            if commit_arrival(w,id,w.trips[id].destination,-1,0): w.people[p].state = .idle
            else:
                w.people[p].action.retry_minute = w.minute+30
                w.people[p].action.end_minute = w.minute+30

struct BoatMarker:
    trip: int
    person: int
    pose: Pose
    reason: Reason

query_boats = (w: World) -> BoatMarker[]:
    result: BoatMarker[]
    loop id in w.active_trips:
        if w.trips[id].mode != .aircraft and w.trips[id].state != .arrived:
            p = w.trips[id].actor
            pose = w.people[p].pose
            aboard = p
            loop task in w.public_boats:
                if task.trip == id:
                    pose = task.pose
                    if task.delivered or task.craft >= 0: aboard = -1
            result.push(BoatMarker(id,aboard,pose,w.trips[id].reason))
    result
