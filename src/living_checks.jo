use 'living_types.jo'
use 'living_cargo.jo'
use 'living_money.jo'
use 'living_delivery.jo'
use 'living_maps.jo'

invariant_errors = (w: World) -> str[]:
    errors: str[]
    map_error = validate_maps(w)
    if map_error != "": errors.push(map_error)
    if w.tick/120 != w.minute: errors.push("clock relation")
    if not money_balances(w): errors.push("cash ledger mismatch")
    if not goods_balance(w): errors.push("goods ledger mismatch")
    errors.extend(cargo_inventory_errors(w))
    loop p in 0..w.people.len():
        person = w.people[p]
        if person.id != p or not account_valid(w,person.account): errors.push("person{p} identity/account")
        if person.fatigue < 0 or person.fatigue > 1000: errors.push("person{p} fatigue")
        if not inventory_valid(person.pocket): errors.push("person{p} pocket")
        if person.place < -1 or person.place >= w.places.len(): errors.push("person{p} place")
        if person.trip >= 0 and not (person.trip in w.trips): errors.push("person{p} missing trip")
        if person.trip >= 0 and person.place >= 0: errors.push("person{p} two locations")
        if person.news.len() > 12 or person.prices.len() > 54 or person.relationship_ids.len() > 64: errors.push("person{p} bounded memory")
        if person.trip < 0 and person.injured_until <= w.minute and person.state != .departed and p != w.player:
            a = person.action
            if w.minute > a.end_minute+60 and a.retry_minute < w.minute and a.activity != .wait: errors.push("person{p} stalled action {a.activity}")
    loop p in w.places:
        if p.id < 0 or p.id >= w.places.len() or not inventory_valid(p.market.inventory): errors.push("place{p.id} inventory")
        loop g in 0..GOOD_COUNT:
            base = w.goods[g].base_cents
            if p.market.price_cents[g] < base*45/100-1 or p.market.price_cents[g] > base*180/100+1: errors.push("place{p.id} price {g}")
    loop c in w.aircraft:
        if c.id < 0 or c.id >= w.aircraft.len() or c.owner < 0 or c.owner >= w.people.len(): errors.push("craft identity")
        if c.fuel_ml < 0 or c.fuel_ml > AIRFRAMES[int(c.kind)].tank_ml: errors.push("craft{c.id} fuel")
        if c.hull < 0 or c.hull > 1000 or c.engine < 0 or c.engine > 1000: errors.push("craft{c.id} condition")
        if not inventory_valid(c.cargo): errors.push("craft{c.id} cargo")
        if craft_grams(w,c.id) > AIRFRAMES[int(c.kind)].cargo_grams or c.passengers.len() > AIRFRAMES[int(c.kind)].seats: errors.push("craft{c.id} capacity")
        if c.trip >= 0:
            if not (c.trip in w.trips) or w.trips[c.trip].craft != c.id: errors.push("craft{c.id} trip")
            if c.place >= 0 or c.dock >= 0: errors.push("craft{c.id} double location")
        loop other in w.aircraft:
            if c.id < other.id and c.place >= 0 and c.dock >= 0 and c.place == other.place and c.dock == other.dock: errors.push("dock overlap {c.id}/{other.id}")
    # Reservation ownership is an exact partition, not an extra copy of stock.
    loop place in 0..w.places.len():
        expected: int[GOOD_COUNT]
        loop _, j in w.jobs:
            if j.origin != place: continue
            expected[4] += j.charter_reserved_milli
            if j.cargo_mode == .commodity and (not j.loaded or j.delivery_mode == .foot) and not job_terminal(j.state): expected[j.good] += j.quantity-j.lost_quantity
        loop _, o in w.obligations:
            if o.reserved_parts > 0 and o.craft >= 0 and w.aircraft[o.craft].place == place: expected[5] += o.reserved_parts
        loop g in 0..GOOD_COUNT:
            if expected[g] != w.places[place].market.inventory.reserved[g]: errors.push("place{place} reservation ownership {g}")
    loop c in 0..w.aircraft.len():
        expected: int[GOOD_COUNT]
        loop _, j in w.jobs:
            if j.cargo_mode == .commodity and j.delivery_mode == .aircraft and j.loaded and j.carrier >= 0 and w.people[j.carrier].craft == c:
                expected[j.good] += j.loaded_quantity-j.delivered_quantity-j.lost_quantity-j.returned_quantity
        loop g in 0..GOOD_COUNT:
            if expected[g] != w.aircraft[c].cargo.reserved[g]: errors.push("craft{c} reservation ownership {g}")
    max_trip = -1; max_job = -1; max_obligation = -1; max_event = -1
    loop id, t in w.trips:
        max_trip = max(max_trip,id)
        if id != t.id or t.origin < 0 or t.origin >= 6 or t.destination < 0 or t.destination >= 6: errors.push("trip{id} identity/route")
        if t.route.len() < 2 or t.segment < 0 or t.segment >= t.route.len(): errors.push("trip{id} progress")
    loop id, j in w.jobs:
        max_job = max(max_job,id)
        if j.id != id or not account_valid(w,j.escrow_account): errors.push("job{id} identity/escrow")
        if j.loaded_quantity < 0 or j.delivered_quantity < 0 or j.lost_quantity < 0 or j.delivered_quantity+j.lost_quantity+j.returned_quantity > j.quantity: errors.push("job{id} quantities")
        if job_terminal(j.state):
            if w.accounts[j.escrow_account].cents != 0: errors.push("job{id} terminal escrow")
        else:
            if w.accounts[j.escrow_account].cents != j.reward_cents-j.paid_cents: errors.push("job{id} unfunded escrow")
            if w.minute > j.expire_minute: errors.push("job{id} stale deadline")
    loop id, o in w.obligations:
        max_obligation = max(max_obligation,id)
        if id != o.id or o.debtor < 0 or o.debtor >= w.people.len() or not account_valid(w,o.creditor_account): errors.push("obligation{id} references")
        if o.kind == .debt:
            if o.amount_cents != o.principal_cents+o.interest_cents or o.interest_accrued_total > o.original_cents/2: errors.push("obligation{id} debt math")
        if o.state == .blocked and o.next_retry_minute < w.minute-60: errors.push("obligation{id} stale retry")
    loop id, e in w.events: max_event = max(max_event,id)
    if w.next_trip <= max_trip or w.next_job <= max_job or w.next_obligation <= max_obligation or w.next_event <= max_event: errors.push("ID counters rewind")
    max_aftermath = -1; max_encounter = -1
    loop id, a in w.aftermath:
        max_aftermath = max(max_aftermath,id)
        if id != a.id: errors.push("aftermath identity")
    loop id, e in w.encounters:
        max_encounter = max(max_encounter,id)
        if id != e.id: errors.push("encounter identity")
        if not e.resolved and (not (e.raider_trip in w.trips) or not (e.victim_trip in w.trips)): errors.push("encounter lost active member")
    if w.next_aftermath <= max_aftermath or w.next_encounter <= max_encounter: errors.push("aftermath/encounter counter rewind")
    errors
