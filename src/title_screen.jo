# The title screen, as the game starts: the name over a slow look at the home harbour in the
# evening light, and what to do. Continue (the newest saved game, at once), New game, the saved
# games to load or delete, and, quieter, the situations. When nothing is saved, only New game.
#
# Words and buttons only: the game (aegean.jo) owns the world, the camera's place and the saved
# games, and does what the screen asks (a TitleChoice). The slots are the pause menu's rows
# (src/game_menu.jo game_row), made from the same cached headers.
use 'phoenix.jo'
use 'touch.jo'
use 'hud.jo'
use 'debugmenu.jo'
use 'scenario_catalog.jo'

# (the backdrop's hour: the sun low in the west, the light gold; the world's own clock is left alone)
const TITLE_HOUR = 17.15
# the colour the screen comes up from (the web page's loading card is the same)
TITLE_DUSK = rgba(0.075, 0.1, 0.15, 1)

struct TitleScreen:
    open = false
    age = 0.0                       # seconds it has been up (the camera's drift, the fade in)
    page = 0                        # 0 the title, 1 saved games, 2 situations, 3 a new game when every slot is full
    focus = 0                       # (the title's buttons: which one Enter presses)
    pick = -1                       # page 1: the slot whose Delete waits for a yes; page 3: the slot picked
    loading = -1                    # the slot being loaded (its note says so); -1 none

struct TitleChoice:
    act = ""                        # "load" (Continue too), "delete", "new" or "situation"
    slot = -1                       # load/delete: which; new: the slot to save over (-1: the first empty one, or none)
    key = ""                        # situation: its key

# the slot Continue loads: the newest usable one (by when it was saved; an older save without the
# time, by its world time)
title_latest = (rows: GameRow[], saved_at: f64[], minutes: int[]) -> int:
    best = -1
    loop k in 0..rows.len():
        if not rows[k].usable: continue
        if best < 0 or saved_at[k] > saved_at[best] or (saved_at[k] == saved_at[best] and minutes[k] > minutes[best]): best = k
    best

# ---------------- the backdrop's camera ----------------

# Out over the water off the waterfront, looking back at the town, drifting slowly along the shore
# and a little in and out, as from a seaplane gliding home; never lower than `clear` over the ground.
title_camera = (center: vec3, out: vec2, age: f64, ground: (f64, f64) -> f64) -> (vec3, vec3):
    o = normalize(vec3(out.x, 0, out.y))
    side = vec3(-o.z, 0, o.x)
    swing = 0.62 - age * 0.0075 + 0.06 * sin(age * 0.05)
    reach = 430.0 + 50.0 * sin(age * 0.031)
    eye = center + (o * f32(cos(swing)) + side * f32(sin(swing))) * f32(reach)
    eye.y = f32(max(58.0 + 10.0 * sin(age * 0.043), ground(f64(eye.x), f64(eye.z)) + 45.0))
    look = center + vec3(0, 22, 0) - side * f32(70.0 + 30.0 * sin(age * 0.021))
    (eye, normalize(look - eye))

# ---------------- drawing ----------------

_fade = (c: vec4, a: f64) -> vec4: vec4(c.x, c.y, c.z, c.w * f32(a))

# (bigger on a phone: held upright there is room down the screen; on its side the units are small)
_title_k = () -> f64: if screen_height() > screen_width(): 1.45 else: if pad.on: 1.4 else: 1.0
# (a finger's button: about 44 px on a phone either way; a mouse's)
_title_bh = () -> f64: if pad.on: max(48.0, 0.115 * f64(min(screen_width(), screen_height()))) else: 46.0

_title_style = (a: f64):
    global hud_style
    hud_style.button = rgba(0.04, 0.06, 0.1, f32(0.62 * a))
    hud_style.hover = rgba(0.1, 0.13, 0.19, f32(0.8 * a))
    hud_style.pressed = rgba(0.02, 0.03, 0.05, f32(0.85 * a))
    hud_style.border = rgba(0.96, 0.93, 0.84, f32(0.26 * a))
    hud_style.accent = _fade(BRASS, a)
    hud_style.text = rgba(0.98, 0.95, 0.86, f32(a))
    hud_style.disabled = rgba(0.98, 0.95, 0.86, f32(0.4 * a))
    hud_style.panel = rgba(0.04, 0.06, 0.1, f32(0.86 * a))
    hud_style.panel_edge = rgba(0.96, 0.93, 0.84, f32(0.12 * a))
    hud_style.radius = 3.0
    hud_style.panel_radius = 4.0

# a line of type no wider than `width`: smaller if it must be
_fit = (s: str, size: f64, width: f64) -> f64: min(size, size * width / max(ptext_width(s, size), 1.0))

# The whole screen, drawn over the scene; what was asked for, if anything. `rows` are the saved
# games (the pause menu's), `latest` the one Continue loads, `ready` once they have been read,
# `busy` while a request is under way, `note` what the last one came to.
title_screen = (ts: mut TitleScreen, fonts: Fonts, rows: GameRow[], latest: int, ready: bool, busy: bool, note: str, note_warn: bool = false) -> TitleChoice:
    global hud_style
    choice = TitleChoice()
    # (backgrounds over all the window shows; words and buttons inside what is clear of a notch)
    vis = visible_rect()
    safe = safe_rect()
    ox = f64(safe.x)
    oy = f64(safe.y)
    sw = f64(safe.w)
    sh = f64(safe.h)
    upright = screen_height() > screen_width()
    k = _title_k()
    a = smoothstep(0.15, 1.3, ts.age)
    saved = hud_style
    _title_style(a)
    cream = rgba(0.98, 0.95, 0.86, f32(a))
    soft = rgba(0.88, 0.88, 0.86, f32(0.92 * a))
    muted = rgba(0.82, 0.84, 0.86, f32(0.72 * a))
    warn = rgba(1, 0.78, 0.62, f32(a))
    # the scene coming up out of the evening, and a little dusk at the top and bottom for the words
    vx = f64(vis.x); vy = f64(vis.y); vw = f64(vis.w); vh = f64(vis.h)
    rect_gradient(vx, vy, vw, vh * 0.34, rgba(0.03, 0.05, 0.09, f32(0.3 * a)), rgba(0.03, 0.05, 0.09, 0))
    rect_gradient(vx, vy + vh * 0.42, vw, vh * 0.58, rgba(0.03, 0.05, 0.09, 0), rgba(0.03, 0.05, 0.09, f32(0.62 * a)))
    rect(vx, vy, vw, vh, _fade(TITLE_DUSK, 1.0 - smoothstep(0.0, 1.6, ts.age)))
    set_font(fonts.ui)
    exists = false
    loop row in rows:
        if row.exists: exists = true
    can_act = ready and not busy and ts.age > 0.5
    bh = _title_bh()
    gap = (if pad.on: 12.0 else: 10.0)
    if ts.page == 0:
        # the column of what to do; the title in the room above it (on a phone on its side, where
        # there is no room above it, the column at the right and the title at the left)
        wide = not upright and pad.on
        bw = if upright: min(sw - 80.0, 520.0) else: (if pad.on: 420.0 else: 340.0)
        x = if wide: ox + sw - bw - max(32.0, sw * 0.05) else: ox + (sw - bw) * 0.5
        cx = x + bw * 0.5
        items: str[]
        if ready and latest >= 0: items.push("continue")
        if ready: items.push("new")
        if ready and exists: items.push("saved")
        if ready: items.push("situations")
        cont_h = bh + 26.0 * k
        quiet_h = if pad.on: bh else: 36.0
        column = 0.0
        loop item in items: column += (if item == "continue": cont_h else: if item == "situations": quiet_h else: bh) + gap
        column = max(column, 3.0 * (bh + gap))
        foot = 34.0 * k
        top = if wide: oy + max(16.0, (sh - column) * 0.5) else: oy + sh - foot - column - (if upright: sh * 0.06 else: sh * 0.03)
        # the title: as big as fits, centred in the room above the column (or beside it)
        set_font(fonts.title)
        name = "AEGEAN SKIES"
        room = if wide: x - ox - 48.0 else: sw - 48.0
        tx = if wide: ox + (x - ox) * 0.5 else: ox + sw * 0.5
        size = min(if upright: 76.0 else: 92.0, room * 0.9 / max(text_width(name, 100), 1.0) * 100.0)
        ty = if wide: oy + sh * 0.3 else: oy + max(size * 0.75, min((top - oy) * 0.48, sh * 0.28))
        text_centered(name, vec2(f32(tx + 2.0), f32(ty + 3.0)), size, rgba(0.02, 0.04, 0.09, f32(0.45 * a)))
        text_centered(name, vec2(f32(tx), f32(ty)), size, cream)
        set_font(fonts.ui)
        rule = text_width(name, size) * 0.24
        rect(tx - rule * 0.5, ty + size * 0.58, rule, 2.0, _fade(BRASS, a * 0.9))
        # the keys: up and down choose, Enter presses (Continue first, as it is the default)
        if ts.focus >= items.len(): ts.focus = 0
        if can_act and items.len() > 0:
            if key_pressed(.down) or key_pressed(.s): ts.focus = (ts.focus + 1) % items.len()
            if key_pressed(.up) or key_pressed(.w): ts.focus = (ts.focus + items.len() - 1) % items.len()
        pressed = can_act and items.len() > 0 and (key_pressed(.enter) or key_pressed(.space))
        y = top
        loop i in 0..items.len():
            item = items[i]
            go = pressed and ts.focus == i
            if item == "continue":
                row = rows[latest]
                hud_style.text_size = 22.0 * k
                if hud_button(Rect(x, y, bw, cont_h), "", enabled = can_act, selected = ts.focus == i): go = true
                text_centered("Continue", vec2(f32(cx), f32(y + cont_h * 0.5 - 11.0 * k)), 22.0 * k, cream)
                where = row.place + "  ·  " + row.time
                ws = _fit(where, 14.0 * k, bw - 24.0)
                text_centered(where, vec2(f32(cx), f32(y + cont_h * 0.5 + 15.0 * k)), ws, soft)
                if go: choice = TitleChoice(act = "load", slot = latest); ts.loading = latest
                y += cont_h + gap
            else if item == "situations":
                # (quieter: smaller words on a faint shade, no edge)
                hud_style.text_size = 16.0 * k
                hud_style.button = rgba(0.04, 0.06, 0.1, f32(0.3 * a))
                hud_style.border = rgba(0, 0, 0, 0)
                hud_style.text = muted
                qw = min(bw, ptext_width("Situations", 16.0 * k) + 64.0 * k)
                if hud_button(Rect(cx - qw * 0.5, y, qw, quiet_h), "Situations", enabled = can_act, selected = ts.focus == i): go = true
                _title_style(a)
                if go: ts.page = 2
                y += quiet_h + gap
            else:
                label = if item == "new": "New game" else: "Saved games"
                hud_style.text_size = 20.0 * k
                if hud_button(Rect(x, y, bw, bh), label, enabled = can_act, selected = ts.focus == i): go = true
                if go and item == "new":
                    full = rows.len() > 0
                    loop row in rows:
                        if not row.exists: full = false
                    if full: ts.page = 3; ts.pick = -1
                    else: choice = TitleChoice(act = "new")
                if go and item == "saved": ts.page = 1; ts.pick = -1
                y += bh + gap
        # what is under way, or what the last request came to
        status = if not ready: "Reading saved games..." else: if ts.loading >= 0 and busy: "Loading slot {ts.loading + 1}..." else: note
        if status != "":
            size = _fit(status, 15.0 * k, if wide: bw else: sw - 32.0)
            text_centered(status, vec2(f32(cx), f32(if wide: y + foot * 0.3 else: oy + sh - foot * 0.6)), size, if status == note and note_warn: warn else: muted)
    else:
        # a panel over the scene: the saved games, the situations, or where a new game is to save
        pw = if upright: sw - 32.0 else: min(sw - 64.0, (if pad.on: 820.0 else: 600.0))
        x = ox + (sw - pw) * 0.5
        w = pw - 32.0
        ix = x + 16.0
        big = 18.0 * k
        body = 15.0 * k
        line = 21.0 * k
        back = false
        if key_pressed(.escape): back = true
        # (the panel's height: worked out first, so it sits in the middle of the screen)
        card_text = 3.0 * line + 10.0
        side = not upright                      # (on a wide screen each slot's buttons are beside its words)
        sbw = if side: (if pad.on: 170.0 else: 110.0) else: (w - 24.0 - gap) * 0.5
        card_h = if side: max(card_text, bh) + 20.0 else: card_text + bh + 26.0
        heading = match ts.page:
            1: "Saved games"
            2: "Situations"
            _: "Every slot holds a game"
        lead: str[]
        if ts.page == 2: lead = wrap_text("Set pieces, apart from the saved games: nothing here autosaves.", w, body)
        if ts.page == 3: lead = wrap_text("A new game saves over one of them. Choose which, or play on without saving.", w, body)
        situations = [loop s in SCENARIOS: if s.key != "start": s]
        warned = if ts.page == 3 and ts.pick >= 0: wrap_text("Slot {ts.pick + 1} will be replaced when the new game first saves.", w, body) else: [" "]
        content = match ts.page:
            1: f64(rows.len()) * (card_h + gap)
            2: f64(situations.len()) * (bh + line + 14.0 + gap)
            _: f64(rows.len()) * (bh + gap) + gap + 2.0 * (bh + gap) + f64(max(warned.len(), 1)) * line
        ph = 20.0 + big * 1.6 + f64(lead.len()) * line + 8.0 + content + bh + 20.0
        if note != "" and ts.page == 1: ph += line
        y = oy + max(16.0, (sh - ph) * 0.5)
        hud_panel(Rect(x, y, pw, ph))
        y += 20.0
        text(heading, vec2(f32(ix), f32(y)), big, cream)
        y += big * 1.6
        loop l in lead:
            text(l, vec2(f32(ix), f32(y)), body, soft)
            y += line
        y += 8.0
        hud_style.text_size = 17.0 * k
        if ts.page == 1:
            loop row in rows:
                rect_rounded(ix, y, w, card_h, 4, rgba(1, 1, 1, f32(0.05 * a)))
                tx = ix + 12.0
                tw = if side: w - 24.0 - 2.0 * sbw - gap * 2.0 else: w - 24.0
                ty = y + 10.0
                if ts.pick == row.slot:
                    text("Delete slot {row.slot + 1}?", vec2(f32(tx), f32(ty)), body, warn)
                    text(fit_text("It can't be brought back.", tw, body), vec2(f32(tx), f32(ty + line)), body, soft)
                else:
                    text("Slot {row.slot + 1}", vec2(f32(tx), f32(ty)), body, cream)
                    if row.exists:
                        sx = tx + text_width("Slot 0", body) + 14.0
                        text(fit_text(row.time, tx + tw - sx, body), vec2(f32(sx), f32(ty)), body, soft)
                    if not row.exists:
                        text(if row.problem != "": fit_text(row.problem, tw, body) else: "Empty", vec2(f32(tx), f32(ty + line)), body, if row.problem != "": warn else: muted)
                    else:
                        text(fit_text(row.place, tw, body), vec2(f32(tx), f32(ty + line)), body, soft)
                        ptext(fit_text(if row.problem != "": row.problem else: row.detail, tw, body), vec2(f32(tx), f32(ty + line * 2.0)), body, if row.problem != "": warn else: muted)
                bx = if side: ix + w - 12.0 - 2.0 * sbw - gap else: tx
                by = if side: y + (card_h - bh) * 0.5 else: y + card_text + 12.0
                if ts.pick == row.slot:
                    if hud_button(Rect(bx, by, sbw, bh), "Delete", enabled = can_act):
                        choice = TitleChoice(act = "delete", slot = row.slot); ts.pick = -1
                    if hud_button(Rect(bx + sbw + gap, by, sbw, bh), "Keep it"): ts.pick = -1
                else:
                    if hud_button(Rect(bx, by, sbw, bh), "Load", enabled = can_act and row.usable):
                        choice = TitleChoice(act = "load", slot = row.slot); ts.loading = row.slot
                    if hud_button(Rect(bx + sbw + gap, by, sbw, bh), "Delete", enabled = can_act and row.exists): ts.pick = row.slot
                y += card_h + gap
            if ts.loading >= 0 and busy: text("Loading slot {ts.loading + 1}...", vec2(f32(ix), f32(y)), body, muted); y += line
            else if note != "": text(fit_text(note, w, body), vec2(f32(ix), f32(y)), body, muted); y += line
            if not exists and not busy: ts.page = 0
        else if ts.page == 2:
            loop s in situations:
                if hud_button(Rect(ix, y, w, bh), s.name, enabled = can_act): choice = TitleChoice(act = "situation", key = s.key)
                y += bh + 6.0
                text(fit_text(s.description, w, body), vec2(f32(ix), f32(y)), body, muted)
                y += line + 8.0 + gap
        else:
            # (by key too: 1, 2 or 3 picks a slot, Enter starts saving over it)
            keys = [Key.n1, Key.n2, Key.n3]
            loop n in 0..min(rows.len(), keys.len()):
                if key_pressed(keys[n]): ts.pick = rows[n].slot
            if can_act and ts.pick >= 0 and key_pressed(.enter): choice = TitleChoice(act = "new", slot = ts.pick)
            loop row in rows:
                label = "Slot {row.slot + 1}:  " + (if row.exists: row.place + ", " + row.time else: "Empty")
                # (too long for a narrow screen: the place alone; the date is on Saved games)
                if ptext_width(label, hud_style.text_size) > w - 24.0: label = "Slot {row.slot + 1}:  " + row.place
                if hud_button(Rect(ix, y, w, bh), label, enabled = can_act, selected = ts.pick == row.slot, align = .left): ts.pick = row.slot
                y += bh + gap
            y += gap
            loop l in warned:
                text(l, vec2(f32(ix), f32(y)), body, warn)
                y += line
            if hud_button(Rect(ix, y, w, bh), if ts.pick >= 0: "Start, saving over slot {ts.pick + 1}" else: "Start, saving over...", enabled = can_act and ts.pick >= 0):
                choice = TitleChoice(act = "new", slot = ts.pick)
            y += bh + gap
            if hud_button(Rect(ix, y, w, bh), "Start without saving", enabled = can_act): choice = TitleChoice(act = "new", slot = -1)
            y += bh + gap
        if hud_button(Rect(ix, y, w, bh), "Back"): back = true
        if back:
            ts.page = 0; ts.pick = -1
    set_font()
    hud_style = saved
    choice
