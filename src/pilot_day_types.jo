# The pilot's day (src/pilot_talk.jo reads it for his small talk): what he did today, as the scene
# saw it. Kept in the World (World.pilot_day), so it is saved with the game in the binary form and
# a load brings it back; a save from before it was kept loads with an empty day.

enum DoingKind: flew, tavli_won, tavli_lost, swam, fished, sold_catch, shave, stars, ride, rescued, set_ashore, battle

# One thing the pilot did, as the scene saw it.
struct Doing:
    kind: DoingKind
    minute: int
    who = ""                        # someone's first name, if it matters
    where = ""                      # a place's name, if it matters
    rough = 0                       # (a flight) 0 calm, 1 breezy, 2 rough, 3 a storm
    rain = false
