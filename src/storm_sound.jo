use 'airsound.jo'
use 'lightning.jo'
use 'weather_scene.jo'
# What a thunderstorm sounds like from the aircraft, all synthesized here: rain
# drumming on doped fabric and wood, wind gusting with the rough air, and
# thunder from each strike the bolts show (lightning.jo), arriving after the
# distance at the speed of sound: a crack and a long roll near, only the roll,
# darker and softer, far off. Kept under the engine and the slipstream.

# Rain on the airframe: a dense soft patter on the fabric with sharp ticks of
# drops on the struts, the wires and the wooden coaming.
make_rain_drum = (seconds: f64 = 8.0, seed: int = 31) -> Sound:
    seed_random(seed)
    fade = MIX_RATE / 2
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    patter = Biquad(); body = Biquad(); tick = Biquad()
    bandpass(patter, 2300.0, 0.9)
    lowpass(body, 700.0)
    bandpass(tick, 4200.0, 3.0)
    ring = 0.0; ring_env = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        x = random(-1.0, 1.0)
        # (the patter swells and eases with the downpour's sheets)
        sheet = 0.75 + 0.25 * wander(t, 0.7, 41.0)
        if random(0.0, 1.0) < 0.0016: ring_env = random(0.4, 1.0)
        ring_env *= 0.985
        ring = filt(tick, x * ring_env)
        m[i] = (filt(patter, x) * 0.55 + filt(body, x) * 0.25) * sheet + ring * 0.9
    seamless(m, fade, 0.2)

# Rough air: a low roar that surges in gusts, the slipstream torn about.
make_gust_wind = (seconds: f64 = 12.0, seed: int = 37) -> Sound:
    seed_random(seed)
    fade = MIX_RATE
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    low = Biquad(); mid = Biquad()
    lowpass(low, 220.0)
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 32 == 0: bandpass(mid, 480.0 * (1.0 + 0.35 * wander(t, 0.5, 7.0)), 2.5)
        x = random(-1.0, 1.0)
        gust = max(0.0, 0.55 + 0.6 * wander(t, 0.45, 3.0) + 0.25 * wander(t, 1.7, 9.0))
        m[i] = (filt(low, x) * 1.0 + filt(mid, x) * 0.5) * gust
    seamless(m, fade, 0.22)

# Thunder: near, a ripping crack then a roll; far, only the roll, its highs lost.
make_thunder = (near: bool, seed: int) -> Sound:
    seed_random(seed)
    seconds = if near: 6.5 else: 7.5
    n = int(seconds * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    roll = Biquad(); deep = Biquad(); crack = Biquad()
    lowpass(roll, if near: 420.0 else: 170.0)
    lowpass(deep, 70.0)
    highpass(crack, 900.0)
    lead = if near: 0.0 else: 0.25
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        x = random(-1.0, 1.0)
        # (the roll: rising after the stroke, rumbling on in irregular surges)
        rise = smoothstep(lead, lead + 0.35, t)
        decay = exp(-max(t - lead, 0.0) / (if near: 1.8 else: 2.6))
        surge = max(0.0, 0.6 + 0.6 * wander(t, 2.2, f64(seed)) + 0.3 * wander(t, 6.0, f64(seed) + 3.0))
        v = (filt(roll, x) * 1.6 + filt(deep, x) * 2.2) * rise * decay * surge
        if near:
            # (the crack: the channel tearing the air, a few ripping bursts in the first fifth of a second)
            rip = exp(-t * 18.0) * (0.6 + 0.4 * sin(t * 140.0))
            v += filt(crack, x) * rip * 1.4
        side = 0.12 * wander(t, 0.8, f64(seed) + 7.0)
        out[i * 2] = f32(v * (1.0 - side) * 0.5)
        out[i * 2 + 1] = f32(v * (1.0 + side) * 0.5)
    Sound(out)

struct StormSound:
    ready = false
    rain = -1
    gust = -1
    near: Sound[] = []
    far: Sound[] = []
    last = -1.0                    # the world clock last stepped
    due: vec3[] = []               # (when, gain, near?) of thunder on its way

storm_sound_start = (s: mut StormSound):
    s.rain = play(make_rain_drum(), 0.0, looping = true)
    s.gust = play(make_gust_wind(), 0.0, looping = true)
    s.near = [make_thunder(true, 61), make_thunder(true, 67)]
    s.far = [make_thunder(false, 71), make_thunder(false, 79)]
    s.ready = true

# rain: at the aircraft (0..1); rough: the air's roughness there; speed: drawn m/s;
# inside: the cockpit view (louder: the open cockpit is in it).
storm_sound_step = (s: mut StormSound, flying: bool, inside: bool, rain: f64, rough: f64, speed: f64, listener: vec3, now: f64):
    if not s.ready: return
    near_air = if inside: 1.0 else: 0.6
    set_volume(s.rain, if flying: 0.30 * sqrt(clamp(rain, 0.0, 1.0)) * (0.6 + 0.4 * smoothstep(40.0, 200.0, speed)) * near_air else: 0.0)
    set_volume(s.gust, if flying: 0.38 * clamp(rough, 0.0, 1.0) * smoothstep(20.0, 80.0, speed) * near_air else: 0.0)
    # Thunder from the strikes since the last step, heard after its distance.
    if s.last >= 0.0 and now > s.last and now - s.last < 1.0 and flying:
        loop strike in lightning_strikes_between(weather_cells, s.last, now):
            pos = vec3(f32(strike.center.x), if strike.ground: 400.0 else: 900.0, f32(strike.center.z))
            d = f64(length(pos - listener))
            if d > 16000.0: continue
            loud = (if strike.ground: 1.0 else: 0.7) * f64(strike.weight) * clamp(1.15 - d / 14000.0, 0.15, 1.0)
            s.due.push(vec3(f32(strike.time + d / 343.0), f32(loud), if d < 3500.0: 1.0 else: 0.0))
    s.last = now
    keep: vec3[]
    loop t in s.due:
        if f64(t.x) <= now:
            bank = if t.z > 0.5: s.near else: s.far
            play(bank[int(f64(t.x) * 7.0) % bank.len()], f64(t.y) * 0.55, pitch = 0.92 + f64(t.y) * 0.1)
        else: keep.push(t)
    s.due = keep
