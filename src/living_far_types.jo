# Sparse economic tier. Registry IDs are semantic keys, never subscripts into the six-port core.
# Stock fragments refer to the SAME CargoSource roots as detailed cargo. Quantities are milli-
# packages; tank fuel is ml. Named residents are removed from their citizenship cohort once.
enum FarMode: cart, ship, aircraft
enum FarDuty: merchant, patrol, privateer, convoy, rescue, refugee, mail, idle
enum FarRole: trader, farmer, fisher, artisan, keeper, clerk, pilot, sailor

struct FarStock:
    roots: {int: int}                # source -> quantity; owner is the containing account
    qty: int[9]

struct FarDistrict:
    id: int
    core = -1
    born_country: int
    controller: int
    authority: int
    workers: int[3]
    dependents: int[3]
    market_owner = -1
    market_account: int
    household_account: int
    stock: FarStock
    prices: int[9]
    target: int[9]
    unmet: int[9]
    output: int
    productivity: int
    raw_crude = 0
    raw_ore = 0
    population = 0                  # founding population; cohorts change on migration/loss
    demand_remainder: int[9]
    production_remainder = 0
    wage_remainder = 0
    last_hour = -1
    last_tax_day = -1
    displaced_day = -1
    unrest = 0
    danger = 0
    hunger = 0
    links: int[]
    named: int[]
    recent_news: int[]                # carried by arrivals/actual local witnesses, <=12

struct FarPerson:
    id: int                         # World.people identity/account/pose, never a duplicate person
    role: FarRole
    stock: FarStock
    target: vec3
    anchor = ""
    last_tick = 0
    last_hour = -1
    journey = -1
    vehicle = -1
    scene_owned = false
    news: int[]

struct FarLink:
    id: int
    a: int
    b: int
    mode: FarMode
    points: vec3[]
    length_mm: int
    road = -1                       # original canonical road index, or -1 for a water/air route

struct FarVehicle:
    id: int
    kind: FarMode
    home: int
    place: int
    citizen: int
    account: int
    captain: int
    crew: int[3]
    craft = -1                      # World.aircraft body/tank/hold when this is an aircraft
    airframe = 0
    fuel_ml = 0
    hull = 1000
    engine = 1000
    cargo: FarStock
    provisions: FarStock
    last_meal_day = -1
    hungry_days = 0
    cargo_owner = -1
    journey = -1
    pos: vec3
    velocity: vec3
    duty: FarDuty = .merchant
    route = -1                      # assigned reciprocal service, not a random destination
    capacity_grams = 500000
    speed_mm_sec = 1500
    freight_earned = 0
    next_departure = 0
    battle = -1
    revision = 0
    scene_owned = false
    scene_extension = ""
    scene_tick = -1

struct FarJourney:
    id: int
    vehicle: int
    origin: int
    destination: int
    link: int
    forward: bool
    duty: FarDuty
    departed_tick: int
    last_tick: int
    segment = 0
    progress_mm = 0
    speed_mm_sec: int
    progress_remainder = 0
    fuel_remainder = 0
    cargo_owner: int
    seller: int
    buyer: int
    good = -1
    quantity = 0
    delivered = false
    stranded = false
    refugees: int[3]
    news: int[]

struct FarNews:
    id: int
    minute: int
    place: int
    actor = -1
    other = -1
    country = -1
    kind: str
    text: str
    # News IDs are shared evidence, not an omniscient inbox for every district.

struct FarState:
    version = 0
    populated = false
    registry_version = 0
    crew_population: int[3]
    treasury: int[3] = [-1,-1,-1]
    place_ids: int[]                 # sorted stable registry IDs; staggered hourly work
    districts: {int: FarDistrict}
    links: FarLink[]
    people: {int: FarPerson}
    vehicles: FarVehicle[]
    journeys: {int: FarJourney}
    news: {int: FarNews}
    next_journey = 0
    next_news = 0
    next_place = 0
    live_totals: int[9]              # includes far warehouse/pockets/cargo/tank fuel (ledger units)
    opening_population = 0
    named_core_population = 0
    dead = 0
    evacuated = 0
    produced: int[9]
    consumed: int[9]
    transported: int[9]
    completed_journeys = 0
    last_minute = -1
    last_news_prune = -1

# Construction input: no rendering/terrain dependencies in the economic simulation.
struct FarPlaceSeed:
    id: int
    population: int
    country: int
    output: int
    productivity = 180              # milli-packages per worker per game day
    raw_crude = 0
    raw_ore = 0

struct FarTransportView:
    id: int
    mode: FarMode
    origin: int
    destination: int
    pos: vec3
    velocity: vec3
    good: int
    quantity: int
    reason: str
