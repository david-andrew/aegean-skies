use 'living_work_types.jo'
# Sparse economic tier. Registry IDs are semantic keys, never subscripts into the six-port core.
# Stock fragments refer to the SAME CargoSource roots as detailed cargo. Quantities are milli-
# packages; tank fuel is ml. Named residents are removed from their citizenship cohort once.
enum FarMode: cart, ship, aircraft
enum FarDuty: merchant, patrol, privateer, convoy, rescue, refugee, mail, idle
enum FarRole: trader, farmer, fisher, artisan, keeper, clerk, pilot, sailor

struct FarStock:
    roots: {int: int}                # source -> quantity; owner is the containing account
    qty: int[9]

struct FarDistrict:
    id: int
    core = -1
    born_country: int
    controller: int
    authority: int
    workers: int[3]
    dependents: int[3]
    pending_workers: int[3]          # adults in dependents until the next work hour
    workers_ready_hour: int[3]
    market_owner = -1
    market_account: int
    household_account: int
    stock: FarStock
    prices: int[9]
    target: int[9]
    unmet: int[9]
    output: int
    productivity: int
    raw_crude = 0
    raw_ore = 0
    population = 0                  # founding population; cohorts change on migration/loss
    demand_remainder: int[9]
    production_remainder = 0
    wage_remainder = 0
    last_supply_request: int[9]
    last_hour = -1
    last_tax_day = -1
    displaced_day = -1
    unrest = 0
    danger = 0
    hunger = 0
    links: int[]
    homes: FarHome[]
    named: int[]
    reports: FarReport[]             # carried evidence survives global journal pruning
    recent_news: int[]                # carried by arrivals/actual local witnesses, <=12

struct FarPerson:
    id: int                         # World.people identity/account/pose, never a duplicate person
    role: FarRole
    home_key = ""
    home_pos: vec3
    last_meal_day = -1
    hungry_days = 0
    worked_minutes = 0
    seen_prices: int[9]
    prices_minute = -1
    stock: FarStock
    target: vec3
    anchor = ""
    planned_anchor = ""
    route: vec3[]
    waypoint = 0
    blocked = ""
    last_tick = 0
    last_hour = -1
    journey = -1
    commission = -1
    vehicle = -1
    scene_owned = false
    news: int[]

struct FarLink:
    id: int
    a: int
    b: int
    mode: FarMode
    points: vec3[]
    length_mm: int
    road = -1                       # original canonical road index, or -1 for a water/air route

struct FarVehicle:
    id: int
    kind: FarMode
    home: int
    place: int
    citizen: int
    account: int
    captain: int
    crew: int[3]
    craft = -1                      # World.aircraft body/tank/hold when this is an aircraft
    airframe = 0
    fuel_ml = 0
    hull = 1000
    engine = 1000
    cargo: FarStock
    provisions: FarStock
    last_meal_day = -1
    hungry_days = 0
    cargo_owner = -1
    journey = -1
    pos: vec3
    velocity: vec3
    passengers: int[]
    reports: FarReport[]
    carried_news: int[]
    duty: FarDuty = .merchant
    route = -1                      # assigned reciprocal service, not a random destination
    capacity_grams = 500000
    speed_mm_sec = 1500
    last_boarding_minute = -100000
    freight_earned = 0
    next_departure = 0
    battle = -1
    revision = 0
    scene_owned = false
    motion_blocked = ""
    scene_extension = ""
    scene_tick = -1

struct FarJourney:
    id: int
    vehicle: int
    origin: int
    destination: int
    link: int
    forward: bool
    duty: FarDuty
    departed_tick: int
    last_tick: int
    segment = 0
    progress_mm = 0
    speed_mm_sec: int
    progress_remainder = 0
    fuel_remainder = 0
    cargo_owner: int
    seller: int
    buyer: int
    good = -1
    quantity = 0
    reports: FarReport[]
    delivered = false
    hold_until_tick = -1
    blocked_by = -1
    stranded = false
    refugees: int[3]
    refugee_workers: int[3]
    passenger_account = -1
    news: int[]

struct FarNews:
    id: int
    minute: int
    place: int
    actor = -1
    other = -1
    country = -1
    kind: str
    text: str
    severity = 100
    subject_place = -1
    subject_minute = -1
    mission = -1
    rescue = -1
    other_country = -1
    aggressor = -1
    affected = -1
    state_backed = false
    weight = 0
    # News IDs are shared evidence, not an omniscient inbox for every district.

    supply_good = -1
    supply_qty = 0
    supply_bid = 0
    supply_reward = 0
    supply_due = -1
    supply_account = -1
    supply_observed = 0
    supply_target = 0

struct FarState:
    navigation_version = 0
    version = 0
    populated = false
    registry_version = 0
    core_people = 26
    next_actor_scan = 0
    air_registrations: {str: int}
    air_homes: {int: int}
    air_berths: {int: FarBerth}
    harbors: {int: FarHarbor}
    commissions: {int: FarCommission}
    next_commission = 0
    next_commission_place = 0
    near_people: int[]               # bounded scene list; identities persist when folded
    crew_population: int[3]
    accepted_requests: {int: int}
    core_reports: {int: FarReport}    # real core Event ID -> carried public snapshot
    treasury: int[3] = [-1,-1,-1]
    place_ids: int[]                 # sorted stable registry IDs; staggered hourly work
    districts: {int: FarDistrict}
    links: FarLink[]
    people: {int: FarPerson}
    vehicles: FarVehicle[]
    journeys: {int: FarJourney}
    news: {int: FarNews}
    next_journey = 0
    news_order: int[]
    next_news = 0
    next_place = 0
    live_totals: int[9]              # includes far warehouse/pockets/cargo/tank fuel (ledger units)
    opening_population = 0
    named_core_population = 0
    dead = 0
    evacuated = 0
    produced: int[9]
    consumed: int[9]
    transported: int[9]
    completed_journeys = 0
    last_minute = -1
    last_news_prune = -1

# Construction input: no rendering/terrain dependencies in the economic simulation.
struct FarPlaceSeed:
    id: int
    population: int
    country: int
    output: int
    productivity = 180              # milli-packages per worker per game day
    raw_crude = 0
    raw_ore = 0
    homes: FarHome[]

struct FarTransportView:
    id: int
    mode: FarMode
    origin: int
    destination: int
    pos: vec3
    velocity: vec3
    good: int
    quantity: int
    reason: str

# A carried snapshot survives pruning of the world event journal. Retelling preserves the
# occurrence date and evidence ID; it never refreshes a report into current intelligence.
struct FarReport:
    id: int
    occurred_minute: int
    learned_minute: int
    origin: int
    text: str
    kind: str
    source_person = -1
    actor = -1
    other = -1
    country = -1
    severity = 100
    confidence = 1000
    carriage = 0                    # written report legs; distinct from oral retell hops
    hops = 0
    subject_place = -1
    subject_minute = -1
    mission = -1
    rescue = -1
    other_country = -1
    aggressor = -1
    affected = -1
    state_backed = false
    weight = 0

    supply_good = -1
    supply_qty = 0
    supply_bid = 0
    supply_reward = 0
    supply_due = -1
    supply_account = -1
    supply_observed = 0
    supply_target = 0

struct FarHome:
    key: str
    door: vec3

struct FarResidentView:
    person: int
    name: str
    home: int
    place: int
    citizenship: int
    controller: int
    authority: int
    pos: vec3
    target: vec3
    role: FarRole
    reason: str

# Sparse facilities are copied from registry moorings, never guessed from a town centre.
struct FarHarbor:
    place: int
    out: vec3
    docks: vec3[]
    quays: vec3[]
    buoy: vec3

# A commission owns a single provenance partition from posting through real collection.
# Its cargo is NOT simultaneously in a market, pocket or AircraftRecord inventory.
enum CommissionKind: freight, mail, escort, smuggling, rescue, reconnaissance
enum CommissionPhase: open, claimed, carrying, aboard, collecting, delivered, expired, cancelled
struct FarCommission:
    id: int
    kind: CommissionKind
    origin: int
    destination: int
    poster: int
    funder: int
    owner: int                      # account retaining legal title to the cargo
    escrow: int
    reward: int
    deadline: int
    created: int
    phase: CommissionPhase = .open
    carrier = -1
    craft = -1
    porter = -1
    porter_fee = 0
    cargo: FarStock
    quantity: int
    good: int
    pos: vec3
    last_tick: int
    why: str
    country = -1
    target = -1
    paper: FarReport?               # one saved dispatch backed by an actually known report
    news: int[]
    loader = 0                      # CarriageChoice ordinal; avoids schema dependency cycle
    collected_minute = -1
    failed_minute = -1

    provenance: WorkProvenance = WorkProvenance()

struct CommissionView:
    id: int
    kind: CommissionKind
    phase: CommissionPhase
    origin: int
    destination: int
    poster: int
    carrier: int
    reward: int
    deadline: int
    mass_grams: int
    pos: vec3
    why: str

struct FarBerth:
    place: int
    dock: int

struct AircraftRegistration:
    person = -1
    craft = -1
    error = ""
