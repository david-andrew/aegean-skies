# Saved factual provenance, separate from the carrier's reason/physical custody.
struct WorkProvenance:
    cause = ""
    requester = -1
    requester_account = -1
    supplier = -1
    supplier_account = -1
    request_place = -1
    request_event = -1
    request_report = -1
    requested_minute = -1
    heard_minute = -1
    agreed_minute = -1
    goods_cents = 0
    freight_cents = 0
    freight_payer = -1
    deadline = -1
    supply_roots: int[]
    supply = ""
    negotiated = false
    opening = false
