use 'living_guard.jo'
use 'living_transaction.jo'
# Arrival transactions shared by abstract routes and future scene docking commands.
use 'living_types.jo'
use 'living_portage.jo'
use 'living_cargo.jo'
use 'living_money.jo'
use 'living_events.jo'

job_terminal = (state: JobState) -> bool: state == .delivered or state == .failed or state == .expired or state == .cancelled

_guarded_refund_job = (w: mut World, id: int):
    reserved_fuel = w.jobs[id].charter_reserved_milli
    if reserved_fuel > 0:
        if not (release(w.places[w.jobs[id].origin].market.inventory,4,reserved_fuel)):
            living_fault("living_delivery.refund_job.0",guard_context(w)+" id={id}")
            return
        w.jobs[id].charter_reserved_milli = 0
    escrow = w.jobs[id].escrow_account
    amount = w.accounts[escrow].cents
    recipient = if w.jobs[id].reward_funder >= 0: w.jobs[id].reward_funder else: w.people[w.jobs[id].poster].account
    if amount > 0:
        if not (transfer(w,escrow,recipient,amount,.refund,id)):
            living_fault("living_delivery.refund_job.1",guard_context(w)+" id={id}")
            return

fulfill_supplies = (w: mut World, job: int):
    loop id in w.open_obligations:
        if w.obligations[id].job == job and w.obligations[id].kind == .supply:
            if w.jobs[job].delivered_quantity >= w.jobs[job].quantity:
                w.obligations[id].state = .fulfilled

# A verified docking can unload the surviving earmarked goods once. Partial losses are final.
_guarded_deliver_job = (w: mut World, id: int, carrier: int) -> bool:
    if not (id in w.jobs) or w.jobs[id].state != .claimed: return false
    if w.jobs[id].cargo_mode != .none and (not w.jobs[id].collected or not cargo_all_collected(w,id)):
        cargo_plan_carriage(w,id,true)
        return false
    if not w.jobs[id].loaded and w.jobs[id].delivery_mode != .foot: return false
    if w.jobs[id].carrier != carrier: return false
    if w.jobs[id].cargo_mode == .none and w.people[carrier].place != w.jobs[id].destination: return false
    c = w.people[carrier].craft
    if w.jobs[id].cargo_mode == .none and (c < 0 or w.aircraft[c].place != w.jobs[id].destination or w.aircraft[c].trip >= 0): return false
    g = w.jobs[id].good
    amount = w.jobs[id].loaded_quantity - w.jobs[id].delivered_quantity - w.jobs[id].lost_quantity - w.jobs[id].returned_quantity
    if w.jobs[id].delivery_mode == .foot:
        amount = w.jobs[id].quantity-w.jobs[id].lost_quantity
        w.jobs[id].loaded_quantity = w.jobs[id].quantity
    if w.jobs[id].cargo_mode == .commodity:
        foot = w.jobs[id].delivery_mode == .foot
        if not foot and (amount > w.aircraft[c].cargo.reserved[g] or amount > w.aircraft[c].cargo.qty[g]): return false
        if amount>0 and w.jobs[id].buyer_account>=0 and w.jobs[id].cargo_mode==.commodity:
            # A heard signed buying bid is a conditional purchase, not a debit from a remote
            # stranger. Title and stock stay with the supplier if the actual buyer cannot pay.
            price=amount*w.jobs[id].sale_unit_cents/1000+amount*w.jobs[id].sale_delivery_fee/max(1,w.jobs[id].quantity)
            if w.accounts[w.jobs[id].buyer_account].cents<price: return false
            payee=if w.jobs[id].sale_payee>=0: w.jobs[id].sale_payee else: w.people[w.jobs[id].poster].account
            if price>0 and not transfer(w,w.jobs[id].buyer_account,payee,price,.trade,id): return false
            w.jobs[id].sale_revenue+=price
        if amount > 0:
            source = if foot: w.jobs[id].origin else: c
            from = if foot: CargoStore.market else: CargoStore.aircraft
            destination = w.jobs[id].destination
            receiver = cargo_receiver(w,id)
            store = w.jobs[id].drop_store
            if store == .pocket:
                if foot:
                    if not (move_stock(w.places[source].market.inventory,w.people[receiver].pocket,g,amount,true)):
                        living_fault("living_delivery.deliver_job.2",guard_context(w)+" id={id} carrier={carrier}")
                        return false
                else:
                    if not (move_stock(w.aircraft[c].cargo,w.people[receiver].pocket,g,amount,true)):
                        living_fault("living_delivery.deliver_job.3",guard_context(w)+" id={id} carrier={carrier}")
                        return false
            else if store == .boat:
                boat = w.boat_cargo.get(destination,Inventory())
                if foot:
                    if not (move_stock(w.places[source].market.inventory,boat,g,amount,true)):
                        living_fault("living_delivery.deliver_job.4",guard_context(w)+" id={id} carrier={carrier}")
                        return false
                else:
                    if not (move_stock(w.aircraft[c].cargo,boat,g,amount,true)):
                        living_fault("living_delivery.deliver_job.5",guard_context(w)+" id={id} carrier={carrier}")
                        return false
                w.boat_cargo[destination] = boat
            else:
                if foot and source == destination:
                    if not (release(w.places[source].market.inventory,g,amount)):
                        living_fault("living_delivery.deliver_job.6",guard_context(w)+" id={id} carrier={carrier}")
                        return false
                else if foot:
                    if not (move_stock(w.places[source].market.inventory,w.places[destination].market.inventory,g,amount,true)):
                        living_fault("living_delivery.deliver_job.7",guard_context(w)+" id={id} carrier={carrier}")
                        return false
                else:
                    if not (move_stock(w.aircraft[c].cargo,w.places[destination].market.inventory,g,amount,true)):
                        living_fault("living_delivery.deliver_job.8",guard_context(w)+" id={id} carrier={carrier}")
                        return false
            if not (cargo_move(w,from,source,store,if store == .pocket: receiver else: destination,g,amount,receiver,destination,id)):
                living_fault("living_delivery.deliver_job.9",guard_context(w)+" id={id} carrier={carrier}")
                return false
            w.jobs[id].delivered_quantity += amount
    else:
        if w.jobs[id].cargo_mode == .sealed:
            receiver = cargo_receiver(w,id)
            if not cargo_move(w,.aircraft,c,.pocket,receiver,-1,amount,receiver,w.jobs[id].destination,id): return false
        if w.jobs[id].purpose == .passenger:
            p = w.jobs[id].passenger
            if p < 0 or not (p in w.aircraft[c].passengers): return false
            w.aircraft[c].passengers.remove(p)
            w.people[p].place = w.jobs[id].destination
            w.people[p].trip = -1; w.people[p].state = .idle
            w.places[w.people[p].place].residents.push(p)
        w.jobs[id].delivered_quantity = w.jobs[id].quantity
    late = w.minute > w.jobs[id].due_minute
    gross = w.jobs[id].reward_cents * w.jobs[id].delivered_quantity * (if late: 75 else: 100) / (max(w.jobs[id].quantity,1)*100)
    owed = gross - w.jobs[id].paid_cents
    if owed > 0:
        if not (transfer(w,w.jobs[id].escrow_account,w.people[carrier].account,owed,.reward,id)):
            living_fault("living_delivery.deliver_job.10",guard_context(w)+" id={id} carrier={carrier}")
            return false
        w.jobs[id].paid_cents += owed
    terminal = w.jobs[id].delivered_quantity >= w.jobs[id].quantity or w.jobs[id].lost_quantity > 0
    if terminal:
        w.jobs[id].state = if w.jobs[id].lost_quantity > 0: JobState.failed else: JobState.delivered
        w.jobs[id].status_minute = w.minute
        refund_job(w,id)
        o = w.jobs[id].obligation
        if o >= 0: w.obligations[o].state = if w.jobs[id].state == .delivered: ObligationState.fulfilled else: ObligationState.breached
        if c >= 0: w.aircraft[c].job_manifests.remove(id)
        fulfill_supplies(w,id)
        if w.people[carrier].action.activity == .fulfill and w.people[carrier].action.reason.job == id:
            w.people[carrier].action.activity = .wait
            w.people[carrier].action.end_minute = w.minute; w.people[carrier].next_decision_minute = w.minute
    emit_event(w,.delivery,w.jobs[id].destination,carrier,w.jobs[id].cause.beneficiary,w.jobs[id].cause,w.jobs[id].lost_quantity * (if g >= 0: w.goods[g].base_cents else: 0) / 1000)
    true

unload_at_harbor = (w: mut World, carrier: int):
    c = w.people[carrier].craft
    if c < 0: return
    # Snapshot only the bounded ID list; callbacks remove completed manifests.
    ids = w.aircraft[c].job_manifests
    loop id in ids:
        if job_terminal(w.jobs[id].state): return_job_cargo(w,id,carrier)
        else if w.jobs[id].destination == w.people[carrier].place: deliver_job(w,id,carrier)

# Terminal cargo still has its poster's title, until physically returned in the same harbor.
_guarded_return_job_cargo = (w: mut World, id: int, carrier: int) -> bool:
    if not (id in w.jobs) or not job_terminal(w.jobs[id].state) or not w.jobs[id].loaded or w.jobs[id].carrier != carrier: return false
    c = w.people[carrier].craft; poster = w.jobs[id].poster
    if c < 0: return false
    if w.jobs[id].return_place < 0 and (w.aircraft[c].place < 0 or w.people[poster].place != w.aircraft[c].place): return false
    qty = w.jobs[id].loaded_quantity-w.jobs[id].delivered_quantity-w.jobs[id].lost_quantity-w.jobs[id].returned_quantity
    if qty <= 0: return false
    if w.jobs[id].cargo_mode != .none:
        if w.jobs[id].return_place < 0:
            w.jobs[id].return_place = w.aircraft[c].place
            w.jobs[id].dropoff = cargo_anchor(w,w.aircraft[c].place)
            w.jobs[id].drop_store = .pocket; w.jobs[id].drop_holder = poster
            w.jobs[id].collected = false
        if not w.jobs[id].collected or not cargo_all_collected(w,id):
            cargo_plan_carriage(w,id,true)
            return false
    if w.jobs[id].cargo_mode == .commodity:
        if not move_stock(w.aircraft[c].cargo,w.people[poster].pocket,w.jobs[id].good,qty,true): return false
        if not (cargo_move(w,.aircraft,c,.pocket,poster,w.jobs[id].good,qty,poster,w.people[poster].place,id)):
            living_fault("living_delivery.return_job_cargo.11",guard_context(w)+" id={id} carrier={carrier}")
            return false
    else if w.jobs[id].cargo_mode == .sealed:
        if not cargo_move(w,.aircraft,c,.pocket,poster,-1,qty,poster,w.people[poster].place,id): return false
    w.jobs[id].returned_quantity += qty
    w.aircraft[c].job_manifests.remove(id)
    true

# A boarded passenger with an expired promise is still a person, and disembarks safely.
disembark_failed_passengers = (w: mut World, carrier: int, place: int):
    craft = w.people[carrier].craft
    if craft < 0: return
    passengers = w.aircraft[craft].passengers
    loop p in passengers:
        terminal = false
        loop _, j in w.jobs:
            if j.passenger == p and j.carrier == carrier and job_terminal(j.state): terminal = true
        if not terminal: continue
        w.aircraft[craft].passengers.remove(p)
        w.people[p].place = place; w.people[p].trip = -1; w.people[p].state = .idle
        w.people[p].pose.pos = w.harbors[place].center+vec3(0,1.2,0)
        w.people[p].return_passage_needed = place != w.people[p].home
        w.people[p].action = Action(activity=.wait,purpose=.return_home,reason=Reason(purpose=.return_home,actor=p,origin=place,destination=w.people[p].home),end_minute=w.minute+60,retry_minute=w.minute+60,failure_code="safe alternative harbor; return passage needed")
        w.people[p].next_decision_minute = w.minute
        if not (p in w.places[place].residents): w.places[place].residents.push(p)


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
refund_job = (w: mut World, id: int):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_refund_job(w,id)
    guard_finish(w,scope)

deliver_job = (w: mut World, id: int, carrier: int) -> bool:
    if guard_blocked(): return false
    scope = guard_begin(w)
    result = _guarded_deliver_job(w,id,carrier)
    failed = guard_failed(scope)
    guard_finish(w,scope)
    if failed: false else: result

return_job_cargo = (w: mut World, id: int, carrier: int) -> bool:
    if guard_blocked(): return false
    scope = guard_begin(w)
    result = _guarded_return_job_cargo(w,id,carrier)
    failed = guard_failed(scope)
    guard_finish(w,scope)
    if failed: false else: result
