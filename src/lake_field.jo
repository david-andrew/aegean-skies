# Pure settlement-water source. No terrain query here: carving calls this module.
use 'water_types.jo'
use 'lake_data.jo'
const LAKE_VERSION=1

lake_at=(x:f64,z:f64)->WaterSample:
    key=int(floor(x/4096.0))*1024+int(floor(z/4096.0))
    if not (key in LAKE_BINS):return WaterSample()
    loop i in LAKE_BINS[key]:
        lake=SETTLEMENT_LAKES[i]
        dx=x-f64(lake.center.x);dz=z-f64(lake.center.y)
        if abs(dx)>1200 or abs(dz)>1200:continue
        u=(dx*f64(lake.axis.x)+dz*f64(lake.axis.y))/lake.half_length
        v=(-dx*f64(lake.axis.y)+dz*f64(lake.axis.x))/lake.half_width
        # Uneven coves, contained inside the surveyed ellipse. The straight central
        # 1080 m lane stays clear even at its narrowest section; no islands in it.
        side=0.92+0.08*sin(u*7.0+f64(lake.id%17))
        q=sqrt(u*u+v*v/(side*side))
        if q>=1.2:continue
        r=WaterSample(found=true,wet=q<1.0,level=lake.level,distance=q*lake.half_width,width=lake.half_width,kind=.lake,id=lake.id)
        r.along=u*lake.half_length;r.lateral=v*lake.half_width
        return r
    WaterSample()

lake_carve=(x:f64,z:f64,h:f64)->f64:
    r=lake_at(x,z)
    if not r.found:return h
    q=r.distance/r.width
    # Coverage and the carved zero-depth contour coincide. The submerged shelf
    # avoids vertical shoreline walls and abrupt grounding.
    bed=r.level-5.0+5.0*smoothstep(0.68,1.0,q)
    if q<=1.0:return bed
    bank=r.level+3.0*smoothstep(1.0,1.12,q)
    mix(bank,h,smoothstep(1.12,1.2,q))

lake_key=()->u64:
    key=u64(LAKE_VERSION)
    loop lake in SETTLEMENT_LAKES:
        loop value in [lake.id,int(lake.center.x*16.0),int(lake.center.y*16.0),int(lake.level*1000.0),int(lake.axis.x*1000000.0),int(lake.axis.y*1000000.0),int(lake.half_length),int(lake.half_width)]:
            key=(key xor u64(value))*u64(1099511628211)
    key

# Quadtree bounds can contain a whole lake while their centre is dry. Do not rely
# on a centre water query to preserve the shore when selecting terrain detail.
lake_touches=(x:f64,z:f64,size:f64)->bool:
    if size>4096.0:
        loop lake in SETTLEMENT_LAKES:
            if f64(lake.center.x)+1200>=x and f64(lake.center.x)-1200<=x+size and f64(lake.center.y)+1200>=z and f64(lake.center.y)-1200<=z+size:return true
        return false
    loop iz in int(floor(z/4096.0))..int(floor((z+size)/4096.0))+1:
        loop ix in int(floor(x/4096.0))..int(floor((x+size)/4096.0))+1:
            key=ix*1024+iz
            if not (key in LAKE_BINS):continue
            loop i in LAKE_BINS[key]:
                lake=SETTLEMENT_LAKES[i]
                if f64(lake.center.x)+1200>=x and f64(lake.center.x)-1200<=x+size and f64(lake.center.y)+1200>=z and f64(lake.center.y)-1200<=z+size:return true
    false
