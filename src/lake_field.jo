# Stable lake-source seam, owned by the inland-town/lake implementation.
# Keep this module pure: no renderer, terrain-source or unified-water imports.
# The terrain source calls lake_carve, so sampling that source here would recurse.
use 'water_types.jo'
lake_at=(x:f64,z:f64)->WaterSample:WaterSample()
lake_carve=(x:f64,z:f64,h:f64)->f64:h
# Include authored lake data/version in this key when the source is implemented.
lake_key=()->u64:u64(0)
