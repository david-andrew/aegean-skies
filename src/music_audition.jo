use 'music_data.jo'
use 'music_synth.jo'
# Independent pause-menu stream. Simulation pause hushes the world, never this voice.
use 'radio_synth.jo'

struct MusicAudition:
    piece = 0
    playing = false
    position = 0.0
    through_radio = true
    volume = 0.6
    dirty = true
    voice = -1
    ready = false
    generated = 0
    synth: RadioSynth = RadioSynth()

music_duration = (a: MusicAudition) -> f64: f64(MUSIC_PIECES[a.piece].frames)/f64(MUSIC_RATE)

music_audition_seek = (a: mut MusicAudition, seconds: f64):
    a.position = clamp(seconds,0.0,music_duration(a))
    a.dirty = true

music_audition_select = (a: mut MusicAudition, piece: int):
    if piece == a.piece: return
    a.piece = clamp(piece,0,MUSIC_PIECES.len()-1)
    music_audition_seek(a,0)

music_audition_stop = (a: mut MusicAudition):
    if a.voice >= 0:
        if not a.dirty: a.position = clamp(f64(a.synth.cursor-queued_samples(a.voice))/f64(MUSIC_RATE),0.0,music_duration(a))
        stop(a.voice)
    a.voice = -1; a.playing = false; a.dirty = true

music_audition_update = (a: mut MusicAudition, dt: f64, audio_enabled: bool):
    a.generated = 0
    if not a.playing:
        if a.voice >= 0: music_audition_stop(a)
        return
    if not audio_enabled:
        if a.voice >= 0: stop(a.voice); a.voice = -1
        a.position = min(music_duration(a),a.position+clamp(dt,0.0,0.25))
        if a.position >= music_duration(a): a.playing = false
        return
    if a.position >= music_duration(a) and a.dirty:
        a.playing = false
        if a.voice >= 0: stop(a.voice); a.voice = -1
        return
    if not a.ready:
        a.synth = make_radio_synth(); a.ready = true
    if a.voice < 0 or a.dirty:
        if a.voice >= 0: stop(a.voice)
        # Prepare receiver without unnecessarily loading the default classical score.
        radio_synth_program(a.synth,.morse,0,a.position)
        a.synth.style = .classical; a.synth.strength = 1.0
        radio_music_program(a.synth,a.piece,a.position)
        a.voice = sound_stream(MUSIC_RATE,1,a.volume)
        a.dirty = false
    set_volume(a.voice,a.volume)
    queued = queued_samples(a.voice)
    a.position = clamp(f64(a.synth.cursor-queued)/f64(MUSIC_RATE),0.0,music_duration(a))
    remaining = MUSIC_PIECES[a.piece].frames-a.synth.cursor
    need = min(remaining,clamp(MUSIC_RATE/4-queued,0,MUSIC_RATE/4))
    loop need > 0:
        count = min(need,RADIO_BLOCK)
        push_samples(a.voice,radio_render(a.synth,count,1,0,not a.through_radio))
        need -= count; a.generated += count
    if remaining <= 0 and queued == 0:
        music_audition_stop(a)
        a.position = music_duration(a)
