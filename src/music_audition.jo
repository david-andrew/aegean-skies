use 'music_data.jo'
use 'music_synth.jo'
# Independent music stream for the title and the pause-menu audition.
use 'radio_synth.jo'

type AuditionGain = (f64) -> f64

struct MusicAudition:
    piece = 0
    playing = false
    position = 0.0
    through_radio = true
    station_levelling = true
    volume = 0.6
    strength = 1.0
    dirty = true
    lead = 0.25                     # (seconds of music kept queued ahead: a frame longer than this drops out)
    blocks = 1                      # (render blocks a frame at most, refilling after a long one)
    end_frame = 0                   # (0 plays to the end of the score)
    gain_at: AuditionGain?          # (optional envelope in score seconds, applied to queued PCM)
    voice = -1
    ready = false
    generated = 0
    synth: RadioSynth = RadioSynth()

music_audition_prepare = (a: mut MusicAudition):
    if not a.ready:
        a.synth = make_radio_synth(); a.ready = true
    radio_synth_prepare(a.synth)

music_audition_end = (a: MusicAudition) -> int:
    full = MUSIC_PIECES[a.piece].frames
    if a.end_frame > 0: min(a.end_frame,full) else: full

music_duration = (a: MusicAudition) -> f64: f64(music_audition_end(a))/f64(MUSIC_RATE)

music_audition_seek = (a: mut MusicAudition, seconds: f64):
    a.position = clamp(seconds,0.0,music_duration(a))
    a.dirty = true

music_audition_select = (a: mut MusicAudition, piece: int):
    if piece == a.piece: return
    a.piece = clamp(piece,0,MUSIC_PIECES.len()-1)
    music_audition_seek(a,0)

music_audition_stop = (a: mut MusicAudition):
    if a.voice >= 0:
        if not a.dirty: a.position = clamp(f64(a.synth.cursor-queued_samples(a.voice))/f64(MUSIC_RATE),0.0,music_duration(a))
        stop(a.voice)
    a.voice = -1; a.playing = false; a.dirty = true

music_audition_program = (a: mut MusicAudition):
    if not a.ready:
        a.synth = make_radio_synth(); a.ready = true
    # Prepare receiver without unnecessarily loading the default classical score.
    radio_synth_program(a.synth,.morse,0,a.position)
    a.synth.style = .classical; a.synth.strength = a.strength
    radio_music_program(a.synth,a.piece,a.position)

music_audition_render = (a: mut MusicAudition, count: int) -> f32[]:
    first = a.synth.cursor
    samples = radio_render(a.synth,min(count,music_audition_end(a)-first),a.strength,0,not a.through_radio,a.station_levelling)
    if let gain = a.gain_at:
        loop i in 0..samples.len():
            samples[i] *= f32(gain(f64(first+i)/f64(MUSIC_RATE)))
    samples

music_audition_update = (a: mut MusicAudition, dt: f64, audio_enabled: bool):
    a.generated = 0
    if not a.playing:
        if a.voice >= 0: music_audition_stop(a)
        return
    if not audio_enabled:
        if a.voice >= 0: stop(a.voice); a.voice = -1
        a.position = min(music_duration(a),a.position+clamp(dt,0.0,0.25))
        if a.position >= music_duration(a): a.playing = false
        return
    if a.position >= music_duration(a) and a.dirty:
        a.playing = false
        if a.voice >= 0: stop(a.voice); a.voice = -1
        return
    if a.voice < 0 or a.dirty:
        if a.voice >= 0: stop(a.voice)
        music_audition_program(a)
        a.voice = sound_stream(MUSIC_RATE,1,a.volume)
        a.dirty = false
    set_volume(a.voice,a.volume)
    queued = queued_samples(a.voice)
    a.position = clamp(f64(a.synth.cursor-queued)/f64(MUSIC_RATE),0.0,music_duration(a))
    remaining = music_audition_end(a)-a.synth.cursor
    need = min(remaining,clamp(int(f64(MUSIC_RATE)*a.lead)-queued,0,RADIO_BLOCK*max(a.blocks,1)))
    loop need > 0:
        count = min(need,RADIO_BLOCK)
        push_samples(a.voice,music_audition_render(a,count))
        need -= count; a.generated += count
    if remaining <= 0 and queued == 0:
        music_audition_stop(a)
        a.position = music_duration(a)
