use 'world_point.jo'
# The look of the world: the time of day's light and colors, and the shading helpers every
# custom shader shares (a soft two-tone light like a painted cel, and the haze of distance).

use 'celestial.jo'

struct Light:
    sun_dir: vec3                   # toward the sun
    sun: vec3                       # its light
    sky_top: vec3
    sky_horizon: vec3
    haze: vec3                      # what distance fades to
    shade: vec3                     # the color of the shadowed side (a cool blue-violet)
    fog_density: f64
    sea_deep: vec3
    sea_shallow: vec3
    moon_dir: vec3 = vec3(0, -1, 0)
    planets:vec4[4]

# the light at a time of day (hours, 0..24): dawn gold, a deep blue noon, amber evening, navy night
light_at = (hour: f64, days: f64 = 0.0) -> Light:
    a = (hour - 6.0) / 12.0 * PI                  # 0 at sunrise, PI at sunset
    el = sin(a)                                    # the sun's height
    dir = sky_sun(hour)
    day = smoothstep(-0.12, 0.35, el)              # 0 at night, 1 by mid morning
    low = 1.0 - smoothstep(0.05, 0.55, el)         # the warm hours near sunrise and sunset
    low = low * smoothstep(-0.2, 0.0, el)
    noon_sun = vec3(1.18, 1.1, 0.98)
    gold_sun = vec3(1.25, 0.82, 0.5)
    night_sun = vec3(0.22, 0.28, 0.45)
    sun = mix(mix(night_sun, noon_sun, f32(day)), gold_sun, f32(low))
    top = mix(mix(vec3(0.02, 0.04, 0.12), vec3(0.025, 0.56, 0.74), f32(day)), vec3(0.2, 0.3, 0.6), f32(low * 0.6))
    hor = mix(mix(vec3(0.06, 0.09, 0.2), vec3(0.31, 0.72, 0.80), f32(day)), vec3(1.0, 0.72, 0.5), f32(low))
    haze = mix(mix(vec3(0.05, 0.08, 0.17), vec3(0.58, 0.74, 0.83), f32(day)), vec3(0.93, 0.7, 0.55), f32(low))
    shade = mix(mix(vec3(0.05, 0.07, 0.16), vec3(0.36, 0.45, 0.66), f32(day)), vec3(0.42, 0.36, 0.55), f32(low))
    deep = mix(mix(vec3(0.01, 0.03, 0.08), vec3(0.02, 0.24, 0.46), f32(day)), vec3(0.1, 0.2, 0.4), f32(low))
    shallow = mix(mix(vec3(0.03, 0.09, 0.14), vec3(0.2, 0.78, 0.8), f32(day)), vec3(0.45, 0.6, 0.58), f32(low * 0.5))
    Light(dir, sun, top, hor, haze, shade, 0.00014, deep, shallow, sky_moon(hour, days),sky_planets(hour,days))

# (in shaders) a painted light: lit and shaded sides with a soft edge between them
cel = (ndl: f32) -> f32: smoothstep(-0.05, 0.25, ndl) * 0.82 + clamp(ndl, 0.0, 1.0) * 0.18

# (in shaders) haze over distance, thinner with height (the air is clearer up high)
aerial = (c: vec3, world: vec3, cam: vec3, haze: vec3, density: f32) -> vec3:
    dist = length(world - cam)
    low = max(min(world.y, cam.y), 0.0)
    dh = abs(max(world.y, 0.0) - max(cam.y, 0.0)) * 0.0012
    # Analytic mean density through the height-exponential atmosphere. A valley
    # below a high camera has a thin near path, not ground-level fog all the way.
    mean = exp(-low * 0.0012) * (if dh < 0.01: 1.0 - dh * 0.5 else: (1.0 - exp(-dh)) / dh)
    # A thin upper-air component keeps distant ridges in separate depth
    # layers even above the coastal haze. Nearby paint stays saturated.
    optical = max(dist-60.0,0.0)*density*(0.12+0.88*mean)
    fa = 1.0 - exp(-optical)
    mix(c, haze, clamp(fa, 0.0, 1.0))

# ---------------- the wind ----------------
# One wind over the whole archipelago: the way it blows (toward), its strength, and how far its
# gusts have drifted. Gusts are patches of stronger wind carried along by it: they darken and
# roughen the water as they pass ("cat's paws"), bend the grass and the trees in waves, and the
# clouds drift with the wind.

struct Wind:
    dir: vec2 = vec2(0.8, 0.6)      # unit, the way it blows toward (x, z)
    speed = 6.0                     # m/s
    drift: vec2 = vec2(0, 0)        # compatibility snapshot of gust travel
    drift_point=WorldPoint()
    drift_published=vec2(0,0)

wind_now = Wind()                   # the wind blowing this frame (the game keeps it turning)

# (in shaders) smooth value noise in [0, 1]
vnoise = (p: vec2) -> f32:
    i = floor(p)
    f = p - i
    u = f * f * (vec2(3, 3) - f * 2.0)
    a = hash21(i)
    b = hash21(i + vec2(1, 0))
    c = hash21(i + vec2(0, 1))
    d = hash21(i + vec2(1, 1))
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)

# (in shaders) the gust over a point: 0 a lull, 1 a strong gust
gust = (p: vec2, drift: vec2) -> f32:
    q = p - drift
    g = vnoise(q / 160.0) * 0.6 + vnoise(q / 55.0 + vec2(17, 3)) * 0.4
    smoothstep(0.3, 0.8, g)

# the wind turning and freshening over time (seconds of game time): a sea breeze by day
wind_step = (w: mut Wind, t: f64, dt: f64, hour: f64):
    breeze = 0.6 + 0.4 * smoothstep(9.0, 14.0, hour) * (1.0 - smoothstep(18.0, 21.0, hour))
    w.speed = (3.0 + 7.0 * noise(t * 0.002)) * breeze
    a = 0.65 + (noise(t * 0.0007 + 40.0) - 0.5) * 1.6
    w.dir = vec2(f32(cos(a)), f32(sin(a)))
    advance_wind(w,dt)

# how much faster than the truth the near detail (sea and ground) streams past: up to this many
# times the true speed, reached by about 300 km/h (a setting in the pause menu)
near_boost = 3.0
set_near_boost = (x: f64):
    global near_boost
    near_boost = x

# which trick for the feel of speed (the pause menu's, to compare them): 0 none; 1 the fine
# detail of the sea and ground slides faster (when skimming); 2 the whole look of the sea slides
# (its swells' light and shade and its crests too); 3 space ahead stretched (render_space.jo)
speed_mode = 0
set_speed_mode = (m: int):
    global speed_mode
    speed_mode = m

# the near detail's extra drift for an aircraft moving at vel, `height` meters above the water or
# ground: (x, z) m/s, and the crossfade cycle. Only when skimming (full below about 8 m, gone by
# 30): higher, the swells and the land's shapes show, moving at the true speed, and fine detail
# racing over them would give the trick away
near_flow = (vel: vec3, height: f64) -> vec4:
    v = vec3(vel.x, 0, vel.z)
    sp = f64(length(v))
    # (growing steadily with the speed, all the way up: early on it looks as it truly is, and
    # the felt speed keeps climbing toward the top, where the true speed gains slowly)
    k = 1.0 + (near_boost - 1.0) * clamp((sp - 10.0) / 75.0, 0.0, 1.0) * (1.0 - smoothstep(8.0, 30.0, height))
    if speed_mode != 1 and speed_mode != 2: k = 1.0
    vec4(v.x * f32(k - 1.0), v.z * f32(k - 1.0), 0.6, if speed_mode == 2: 1.0 else: 0.0)

# (the near flow this frame, for the sea and the ground: set before the world is drawn)
scene_flow = vec4(0, 0, 0.6, 0)
set_scene_flow = (vel: vec3, height: f64):
    global scene_flow
    scene_flow = near_flow(vel, height)

wind_drift=(w:Wind)->WorldPoint:
    if w.drift==w.drift_published:w.drift_point else:WorldPoint(w.drift.x,0,w.drift.y)
advance_wind=(w:mut Wind,dt:f64):
    w.drift_point=world_advance(wind_drift(w),vec3(w.dir.x,0,w.dir.y),w.speed*dt*0.9)
    w.drift=world_vec(w.drift_point).xz;w.drift_published=w.drift

# Meadow gusts. Irregular patches of bent, paler grass morph and blow downwind across the meadow: a
# domain-warped, two-octave value noise (cells of 4.5 m and 2.25 m, the warp on 14 m) whose three layers
# are carried downwind by separate offsets at different speeds, so the shapes change as they travel.
# The scales are fixed; wind speed only raises how fast the layers travel, so a point is swept more often
# in stronger wind. The offsets are plain translations accumulated in f64 on the CPU (a turning wind
# only turns the direction they advance in): no direction-dependent phase, so no field-wide pulse.
# The noise lattice repeats every GUST_PERIOD metres, which every offset is wrapped by.
const GUST_PERIOD = 4032.0

struct MeadowPhase:
    a1 = vec2(0,0)                  # offset of the 4.5 m layer (world x, z, wrapped to GUST_PERIOD)
    a2 = vec2(0,0)                  # the 2.25 m layer (travels faster)
    aw = vec2(0,0)                  # the warp layer (travels slower)
    axis = vec2(0.8,0.6)            # the wind's direction, eased (the lean's direction)

meadow_state = MeadowPhase()

# metres a gust layer travels per second: 1.7 m/s in a calm, 4.8 m/s at 8 m/s wind, 13 m/s at 30 m/s
meadow_travel = (speed: f64) -> f64: 5.5 * (0.3 + 0.07 * clamp(speed, 0.0, 40.0))

meadow_wrap = (x: f64) -> f64: x - floor(x / f64(GUST_PERIOD)) * f64(GUST_PERIOD)

# call once a frame with the wind's final speed (x, z unused: the gusts are fixed to the world, not the viewer)
meadow_step = (w: Wind, x: f64, z: f64, dt: f64):
    global meadow_state
    if dt <= 0.0: return
    m = meadow_state
    mixed = m.axis + (w.dir - m.axis) * f32(min(1.0, dt * 1.5))
    if length(mixed) > 0.05: m.axis = normalize(mixed)
    c = meadow_travel(w.speed) * dt
    d = vec2(f64(m.axis.x), f64(m.axis.y))
    m.a1 = vec2(f32(meadow_wrap(f64(m.a1.x) + d.x * c)), f32(meadow_wrap(f64(m.a1.y) + d.y * c)))
    m.a2 = vec2(f32(meadow_wrap(f64(m.a2.x) + d.x * c * 1.15)), f32(meadow_wrap(f64(m.a2.y) + d.y * c * 1.15)))
    m.aw = vec2(f32(meadow_wrap(f64(m.aw.x) + d.x * c * 0.6)), f32(meadow_wrap(f64(m.aw.y) + d.y * c * 0.6)))
    meadow_state = m

# the wind vector the shaders read: (lean direction x, z, speed, 0)
meadow_wind = (w: Wind, origin: vec3) -> vec4:
    vec4(meadow_state.axis.x, meadow_state.axis.y, f32(w.speed), 0)

# layer offsets for a render origin, so a chart-local position p reads the noise at p + shift
meadow_shift = (a: vec2, origin: vec3) -> vec2:
    vec2(f32(meadow_wrap(f64(origin.x) - f64(a.x))), f32(meadow_wrap(f64(origin.z) - f64(a.y))))
meadow_gust = (origin: vec3) -> vec4:
    s1 = meadow_shift(meadow_state.a1, origin); s2 = meadow_shift(meadow_state.a2, origin)
    vec4(s1.x, s1.y, s2.x, s2.y)
meadow_gust_w = (origin: vec3) -> vec2: meadow_shift(meadow_state.aw, origin)

# (in shaders) smooth value noise on a lattice that repeats every 32 cells
pnoise = (p: vec2) -> f32:
    i = floor(p)
    f = p - i
    u = f * f * (vec2(3, 3) - f * 2.0)
    i0 = i - floor(i / 32.0) * 32.0
    i1 = i0 + vec2(1, 1)
    i1 = i1 - floor(i1 / 32.0) * 32.0
    a = hash21(i0)
    b = hash21(vec2(i1.x, i0.y))
    c = hash21(vec2(i0.x, i1.y))
    d = hash21(i1)
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)

# (in shaders) one gust field, 0..1.2. `local` is the render position; g = meadow_gust (4.5 m and 2.25 m layer
# offsets) and gw = meadow_gust_w (the warp layer). detail 1 (blades) warps the field and adds the fine layer;
# 0 is the single coarse layer, unwarped (the ground's sheen, which runs for every pixel: one noise lookup).
meadow_wave = (local: vec2, g: vec4, gw: vec2, speed: f32, detail: f32) -> f32:
    warp = vec2(0, 0)
    if detail > 0.5:
        angle = pnoise((local + gw) / 14.0 + vec2(3.1, 7.7)) * 6.2832
        warp = vec2(cos(angle), sin(angle)) * 3.0
    n = pnoise((local + g.xy + warp) / 4.5)
    if detail > 0.5: n = n * 0.65 + pnoise((local + g.zw + warp * 0.6) / 2.25 + vec2(13, 5)) * 0.35
    smoothstep(0.32, 0.78, n) * (0.35 + 0.85 * smoothstep(0.0, 10.0, speed))

# lean (metres per unit blade height factor): a steady push and the swing of the bands on top of it,
# both growing with the wind speed
meadow_lean = (speed: f32) -> vec2:
    s = clamp(speed, 0.0, 30.0)
    vec2(0.07 + 0.02 * s, 0.14 + 0.016 * s)

# Small achromatic contrast around the visible mass mean. Wind sheen is
# added separately by the shared terrain material, never darkened by roots.
meadow_blade_response=(height:f32,growth:f32,visible_mean:f32)->f32:
    1.0+0.30*(height-mix(0.75,visible_mean,growth))*smoothstep(0.0,0.7,growth)
