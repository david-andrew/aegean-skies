# The look of the world: the time of day's light and colors, and the shading helpers every
# custom shader shares (a soft two-tone light like a painted cel, and the haze of distance).

use 'celestial.jo'

struct Light:
    sun_dir: vec3                   # toward the sun
    sun: vec3                       # its light
    sky_top: vec3
    sky_horizon: vec3
    haze: vec3                      # what distance fades to
    shade: vec3                     # the color of the shadowed side (a cool blue-violet)
    fog_density: f64
    sea_deep: vec3
    sea_shallow: vec3
    moon_dir: vec3 = vec3(0, -1, 0)

# the light at a time of day (hours, 0..24): dawn gold, a deep blue noon, amber evening, navy night
light_at = (hour: f64, days: f64 = 0.0) -> Light:
    a = (hour - 6.0) / 12.0 * PI                  # 0 at sunrise, PI at sunset
    el = sin(a)                                    # the sun's height
    dir = sky_sun(hour)
    day = smoothstep(-0.12, 0.35, el)              # 0 at night, 1 by mid morning
    low = 1.0 - smoothstep(0.05, 0.55, el)         # the warm hours near sunrise and sunset
    low = low * smoothstep(-0.2, 0.0, el)
    noon_sun = vec3(1.18, 1.1, 0.98)
    gold_sun = vec3(1.25, 0.82, 0.5)
    night_sun = vec3(0.22, 0.28, 0.45)
    sun = mix(mix(night_sun, noon_sun, f32(day)), gold_sun, f32(low))
    top = mix(mix(vec3(0.02, 0.04, 0.12), vec3(0.025, 0.56, 0.74), f32(day)), vec3(0.2, 0.3, 0.6), f32(low * 0.6))
    hor = mix(mix(vec3(0.06, 0.09, 0.2), vec3(0.31, 0.72, 0.80), f32(day)), vec3(1.0, 0.72, 0.5), f32(low))
    haze = mix(mix(vec3(0.05, 0.08, 0.17), vec3(0.58, 0.74, 0.83), f32(day)), vec3(0.93, 0.7, 0.55), f32(low))
    shade = mix(mix(vec3(0.05, 0.07, 0.16), vec3(0.36, 0.45, 0.66), f32(day)), vec3(0.42, 0.36, 0.55), f32(low))
    deep = mix(mix(vec3(0.01, 0.03, 0.08), vec3(0.02, 0.24, 0.46), f32(day)), vec3(0.1, 0.2, 0.4), f32(low))
    shallow = mix(mix(vec3(0.03, 0.09, 0.14), vec3(0.2, 0.78, 0.8), f32(day)), vec3(0.45, 0.6, 0.58), f32(low * 0.5))
    Light(dir, sun, top, hor, haze, shade, 0.00014, deep, shallow, sky_moon(hour, days))

# (in shaders) a painted light: lit and shaded sides with a soft edge between them
cel = (ndl: f32) -> f32: smoothstep(-0.05, 0.25, ndl) * 0.82 + clamp(ndl, 0.0, 1.0) * 0.18

# (in shaders) haze over distance, thinner with height (the air is clearer up high)
aerial = (c: vec3, world: vec3, cam: vec3, haze: vec3, density: f32) -> vec3:
    dist = length(world - cam)
    low = max(min(world.y, cam.y), 0.0)
    dh = abs(max(world.y, 0.0) - max(cam.y, 0.0)) * 0.0012
    # Analytic mean density through the height-exponential atmosphere. A valley
    # below a high camera has a thin near path, not ground-level fog all the way.
    mean = exp(-low * 0.0012) * (if dh < 0.01: 1.0 - dh * 0.5 else: (1.0 - exp(-dh)) / dh)
    # A thin upper-air component keeps distant ridges in separate depth
    # layers even above the coastal haze. Nearby paint stays saturated.
    optical = max(dist-60.0,0.0)*density*(0.12+0.88*mean)
    fa = 1.0 - exp(-optical)
    mix(c, haze, clamp(fa, 0.0, 1.0))

# ---------------- the wind ----------------
# One wind over the whole archipelago: the way it blows (toward), its strength, and how far its
# gusts have drifted. Gusts are patches of stronger wind carried along by it: they darken and
# roughen the water as they pass ("cat's paws"), bend the grass and the trees in waves, and the
# clouds drift with the wind.

struct Wind:
    dir: vec2 = vec2(0.8, 0.6)      # unit, the way it blows toward (x, z)
    speed = 6.0                     # m/s
    drift: vec2 = vec2(0, 0)        # how far the gust pattern has moved (meters)

wind_now = Wind()                   # the wind blowing this frame (the game keeps it turning)

# (in shaders) smooth value noise in [0, 1]
vnoise = (p: vec2) -> f32:
    i = floor(p)
    f = p - i
    u = f * f * (vec2(3, 3) - f * 2.0)
    a = hash21(i)
    b = hash21(i + vec2(1, 0))
    c = hash21(i + vec2(0, 1))
    d = hash21(i + vec2(1, 1))
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)

# (in shaders) the gust over a point: 0 a lull, 1 a strong gust
gust = (p: vec2, drift: vec2) -> f32:
    q = p - drift
    g = vnoise(q / 160.0) * 0.6 + vnoise(q / 55.0 + vec2(17, 3)) * 0.4
    smoothstep(0.3, 0.8, g)

# the wind turning and freshening over time (seconds of game time): a sea breeze by day
wind_step = (w: mut Wind, t: f64, dt: f64, hour: f64):
    breeze = 0.6 + 0.4 * smoothstep(9.0, 14.0, hour) * (1.0 - smoothstep(18.0, 21.0, hour))
    w.speed = (3.0 + 7.0 * noise(t * 0.002)) * breeze
    a = 0.65 + (noise(t * 0.0007 + 40.0) - 0.5) * 1.6
    w.dir = vec2(f32(cos(a)), f32(sin(a)))
    w.drift += w.dir * f32(w.speed * dt * 0.9)

# how much faster than the truth the near detail (sea and ground) streams past: up to this many
# times the true speed, reached by about 300 km/h (a setting in the pause menu)
near_boost = 3.0
set_near_boost = (x: f64):
    global near_boost
    near_boost = x

# which trick for the feel of speed (the pause menu's, to compare them): 0 none; 1 the fine
# detail of the sea and ground slides faster (when skimming); 2 the whole look of the sea slides
# (its swells' light and shade and its crests too); 3 space ahead stretched (render_space.jo)
speed_mode = 0
set_speed_mode = (m: int):
    global speed_mode
    speed_mode = m

# the near detail's extra drift for an aircraft moving at vel, `height` meters above the water or
# ground: (x, z) m/s, and the crossfade cycle. Only when skimming (full below about 8 m, gone by
# 30): higher, the swells and the land's shapes show, moving at the true speed, and fine detail
# racing over them would give the trick away
near_flow = (vel: vec3, height: f64) -> vec4:
    v = vec3(vel.x, 0, vel.z)
    sp = f64(length(v))
    # (growing steadily with the speed, all the way up: early on it looks as it truly is, and
    # the felt speed keeps climbing toward the top, where the true speed gains slowly)
    k = 1.0 + (near_boost - 1.0) * clamp((sp - 10.0) / 75.0, 0.0, 1.0) * (1.0 - smoothstep(8.0, 30.0, height))
    if speed_mode != 1 and speed_mode != 2: k = 1.0
    vec4(v.x * f32(k - 1.0), v.z * f32(k - 1.0), 0.6, if speed_mode == 2: 1.0 else: 0.0)

# (the near flow this frame, for the sea and the ground: set before the world is drawn)
scene_flow = vec4(0, 0, 0.6, 0)
set_scene_flow = (vel: vec3, height: f64):
    global scene_flow
    scene_flow = near_flow(vel, height)
