# The look of the world: the time of day's light and colors, and the shading helpers every
# custom shader shares (a soft two-tone light like a painted cel, and the haze of distance).

struct Light:
    sun_dir: vec3                   # toward the sun
    sun: vec3                       # its light
    sky_top: vec3
    sky_horizon: vec3
    haze: vec3                      # what distance fades to
    shade: vec3                     # the color of the shadowed side (a cool blue-violet)
    fog_density: f64
    sea_deep: vec3
    sea_shallow: vec3

# the light at a time of day (hours, 0..24): dawn gold, a deep blue noon, amber evening, navy night
light_at = (hour: f64) -> Light:
    a = (hour - 6.0) / 12.0 * PI                  # 0 at sunrise, PI at sunset
    el = sin(a)                                    # the sun's height
    az = a * 0.9 + 0.6
    dir = normalize(vec3(f32(cos(az) * max(cos(a), -1.0)), f32(max(el, -0.3) * 0.9 + 0.08), f32(-sin(az) * 0.7 - 0.3)))
    day = smoothstep(-0.12, 0.35, el)              # 0 at night, 1 by mid morning
    low = 1.0 - smoothstep(0.05, 0.55, el)         # the warm hours near sunrise and sunset
    low = low * smoothstep(-0.2, 0.0, el)
    noon_sun = vec3(1.18, 1.1, 0.98)
    gold_sun = vec3(1.25, 0.82, 0.5)
    night_sun = vec3(0.22, 0.28, 0.45)
    sun = mix(mix(night_sun, noon_sun, f32(day)), gold_sun, f32(low))
    top = mix(mix(vec3(0.02, 0.04, 0.12), vec3(0.07, 0.29, 0.74), f32(day)), vec3(0.2, 0.3, 0.6), f32(low * 0.6))
    hor = mix(mix(vec3(0.06, 0.09, 0.2), vec3(0.52, 0.75, 0.95), f32(day)), vec3(1.0, 0.72, 0.5), f32(low))
    haze = mix(mix(vec3(0.05, 0.08, 0.17), vec3(0.7, 0.83, 0.94), f32(day)), vec3(0.93, 0.7, 0.55), f32(low))
    shade = mix(mix(vec3(0.05, 0.07, 0.16), vec3(0.36, 0.45, 0.66), f32(day)), vec3(0.42, 0.36, 0.55), f32(low))
    deep = mix(mix(vec3(0.01, 0.03, 0.08), vec3(0.02, 0.24, 0.46), f32(day)), vec3(0.1, 0.2, 0.4), f32(low))
    shallow = mix(mix(vec3(0.03, 0.09, 0.14), vec3(0.2, 0.78, 0.8), f32(day)), vec3(0.45, 0.6, 0.58), f32(low * 0.5))
    Light(dir, sun, top, hor, haze, shade, 0.00011, deep, shallow)

# (in shaders) a painted light: lit and shaded sides with a soft edge between them
cel = (ndl: f32) -> f32: smoothstep(-0.05, 0.25, ndl) * 0.82 + clamp(ndl, 0.0, 1.0) * 0.18

# (in shaders) haze over distance, thinner with height (the air is clearer up high)
aerial = (c: vec3, world: vec3, cam: vec3, haze: vec3, density: f32) -> vec3:
    dist = length(world - cam)
    hy = max(min(world.y, cam.y), 0.0)
    fa = 1.0 - exp(-dist * density * exp(-hy * 0.0012))
    mix(c, haze, clamp(fa, 0.0, 1.0))
