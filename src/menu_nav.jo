# A gamepad's way through the menus drawn with Sloppy's hud_ boxes (the pause menu, the title's
# panels), which answer only the mouse and fingers: nav_button, nav_checkbox and nav_slider draw
# the hud_ box as it is and note where it went. Once a controller has been touched (src/controller.jo),
# a ring marks the box it is on; the d-pad (or the stick) moves it to the nearest box that way, A
# presses it (ticks a box), and left and right step a slider. The ring goes when the mouse or a
# key is used again.
# (Until Sloppy's own hud_ boxes take keys and a gamepad: asked of Sloppy; this then goes.)
use 'controller.jo'

struct NavBox:
    r: Rect
    kind = 0                        # 0 a button, 1 a box to tick, 2 a slider
    enabled = true

struct MenuNav:
    frame = -1
    boxes: NavBox[]                 # this frame's, as they are drawn
    last: NavBox[]                  # last frame's (the focus moves among these)
    focus = 0
    ok = false                      # (A this frame)
    side = 0                        # (left or right this frame, on a slider)
    count = 0
    reset = false                   # (a new page: the focus starts again at the top)

nav = MenuNav()

# whether the ring is shown and the controller works the boxes
nav_on = () -> bool: ctl.used and ctl.connected

# (the first box drawn in a frame: last frame's boxes are where the focus moves now)
_nav_frame = ():
    global nav
    if nav.frame == frame_number(): return
    nav.frame = frame_number()
    nav.last = nav.boxes
    nav.boxes = []
    nav.count = 0
    nav.ok = false
    nav.side = 0
    if nav.reset:
        nav.reset = false
        nav.focus = _first_enabled(nav.last)
    if nav.focus >= nav.last.len(): nav.focus = max(0, nav.last.len() - 1)
    if not nav_on() or nav.last.len() == 0: return
    if nav.focus < nav.last.len() and not nav.last[nav.focus].enabled: nav.focus = _first_enabled(nav.last)
    nav.ok = ctl_menu(.enter)
    dirs: Key[] = [.up, .down, .left, .right]
    loop k in 0..4:
        if not ctl_menu(dirs[k]): continue
        cur = nav.last[nav.focus]
        if k >= 2 and cur.kind == 2:
            nav.side = if k == 2: -1 else: 1
        else:
            nav.focus = nav_step(nav.last, nav.focus, k)

_first_enabled = (bs: NavBox[]) -> int:
    loop i in 0..bs.len():
        if bs[i].enabled: return i
    0

# the box nearest box `from` in direction k (0 up, 1 down, 2 left, 3 right), or `from` if none:
# along that way first, then as little off to the side as can be
nav_step = (bs: NavBox[], from: int, k: int) -> int:
    if from < 0 or from >= bs.len(): return 0
    a = bs[from].r
    ax = f64(a.x) + f64(a.w) * 0.5
    ay = f64(a.y) + f64(a.h) * 0.5
    best = from
    score = 1e18
    loop i in 0..bs.len():
        if i == from or not bs[i].enabled: continue
        b = bs[i].r
        bx = f64(b.x) + f64(b.w) * 0.5
        by = f64(b.y) + f64(b.h) * 0.5
        # (the gap between the boxes along the way, and their offset across it)
        along = 0.0
        across = 0.0
        match k:
            0:
                along = f64(a.y) - (f64(b.y) + f64(b.h))
                if by >= ay - 1.0: continue
                across = max(0.0, max(f64(a.x), f64(b.x)) - min(f64(a.x) + f64(a.w), f64(b.x) + f64(b.w))) + abs(bx - ax) * 0.1
            1:
                along = f64(b.y) - (f64(a.y) + f64(a.h))
                if by <= ay + 1.0: continue
                across = max(0.0, max(f64(a.x), f64(b.x)) - min(f64(a.x) + f64(a.w), f64(b.x) + f64(b.w))) + abs(bx - ax) * 0.1
            2:
                along = f64(a.x) - (f64(b.x) + f64(b.w))
                if bx >= ax - 1.0: continue
                across = abs(by - ay)
            _:
                along = f64(b.x) - (f64(a.x) + f64(a.w))
                if bx <= ax + 1.0: continue
                across = abs(by - ay)
        s = max(along, 0.0) + across * 3.0
        if s < score:
            score = s
            best = i
    best

# (a box drawn: its number this frame, and whether the focus is on it)
_nav_add = (r: Rect, kind: int, enabled: bool) -> bool:
    global nav
    _nav_frame()
    i = nav.count
    nav.count += 1
    nav.boxes.push(NavBox(r, kind, enabled))
    focused = nav_on() and i == nav.focus and enabled
    if focused: _nav_ring(r)
    focused

_nav_ring = (r: Rect):
    # (white and a little outside it: not the gold edge of a tab or a choice that is selected)
    rect_outline(f64(r.x) - 4.0, f64(r.y) - 4.0, f64(r.w) + 8.0, f64(r.h) + 8.0, 2.5, rgba(1, 1, 1, 0.95))

# the box the focus is on this frame (drawn already), for a scrolled list to bring into view
nav_focused = () -> Rect?:
    if not nav_on() or nav.frame != frame_number() or nav.focus >= nav.boxes.len(): return none
    nav.boxes[nav.focus].r

# a new page: the focus back at its first box
nav_reset = ():
    global nav
    nav.reset = true

nav_button = (r: Rect, label: str, enabled: bool = true, selected: bool = false, align: Align = .center) -> bool:
    hit = hud_button(r, label, enabled, selected, align)
    if _nav_add(r, 0, enabled) and nav.ok: hit = true
    hit

nav_checkbox = (r: Rect, label: str, on: bool) -> bool:
    v = hud_checkbox(r, label, on)
    if _nav_add(r, 1, true) and nav.ok: v = not on
    v

nav_slider = (r: Rect, value: f64, low: f64, high: f64, step: f64 = 0.0, label: str = "") -> f64:
    v = hud_slider(r, value, low, high, step, label)
    if _nav_add(r, 2, true) and nav.side != 0:
        d = if step > 0.0: step else: (high - low) / 20.0
        v = clamp(value + d * f64(nav.side), low, high)
    v
