# On foot (a trial: tweaks.on_foot). Before it nothing was heard of walking: no footsteps, no
# climbing in or out of the aircraft, no chair as one sits, no glass set down. With it:
#   footsteps by the ground underfoot, heel then toe, each step its own take and pitch: the
#     jetty's planks over the water (a hollow knock, the board ringing, now and then a creak), stone
#     quays and stairs (a hard click and grit), cobbles (a click and a loose stone or two), earth
#     paths (a soft thud and crunch), sand (a squish), the bar room's boards (brighter wood, and the
#     room's early echoes)
#   climbing into the aircraft and out of it: a foot on the float, the airframe creaking, the seat
#   a chair drawn back on stone as one sits, a stool's legs and its creak; again as one stands
#   a glass set down on the table (a tick of wood, the glass ringing), a plate (a knock, a clatter)
# All of it made here at half the mixer's rate (src/engine_sound.jo ENGINE_RATE), a few takes a
# frame when the trial is first heard, and placed where it happens. Nothing recorded.
use 'airsound.jo'
use 'engine_sound.jo'

enum Ground: planks, stone, cobbles, earth, sand, stairs, floor
const GROUNDS = 7
const FOOT_TAKES = 8

struct FootSound:
    stage = 0
    ready = false
    steps: Sound[][]                # (by Ground, FOOT_TAKES takes each)
    climb_in: Sound[]
    climb_out: Sound[]
    chair: Sound[]
    stool: Sound[]
    glass: Sound[]
    plate: Sound[]
    noise: EngineNoise = EngineNoise(s = u64(1618))
    last_step = 0

# (a ringing into m from a sample on, through a small temporary buffer)
foot_ring = (m: mut f64[],at: int,hz: f64,decay: f64,amp: f64):
    k = fill(0.0,min(m.len()-at,int(f64(ENGINE_RATE)*6.0/decay)+1))
    if k.len() <= 0: return
    engine_ring(k,hz,decay,amp,0.0)
    loop i in 0..k.len(): m[at+i] += k[i]
# (a burst of noise through a band, dying away, into m from a sample on)
foot_noise = (m: mut f64[],r: mut EngineNoise,at: int,hz: f64,q: f64,decay: f64,amp: f64,attack: f64 = 0.0):
    f = Biquad(); bandpass(f,ehz(hz),q)
    count = min(m.len()-at,int(f64(ENGINE_RATE)*6.0/decay)+1)
    g = amp; shrink = exp(-decay/f64(ENGINE_RATE)); rise = if attack > 0.0: f64(ENGINE_RATE)*attack else: 1.0
    loop i in 0..count:
        m[at+i] += filt(f,engine_signed(r))*g*min(1.0,f64(i+1)/rise)
        g *= shrink

# One footstep on a ground: the heel, then the toe a moment after (take: its own seed).
make_step = (ground: Ground,take: int) -> Sound:
    r = EngineNoise(s = u64(int(ground)*7717+take*131+17))
    rate = f64(ENGINE_RATE); n = int(rate*0.3)
    m = fill(0.0,n)
    toe = int(rate*(0.06+0.03*engine_unit(r)))
    v = 0.85+0.3*engine_unit(r)
    match ground:
        .planks, .floor:
            board = (if ground == .floor: 520.0 else: 360.0)*(0.85+0.3*engine_unit(r))
            loop at in [0,toe]:
                g = if at == 0: 1.0 else: 0.45
                foot_ring(m,at,105.0+35.0*engine_unit(r),32.0,1.2*g*v)
                foot_ring(m,at,board,48.0,0.7*g*v)
                foot_noise(m,r,at,1900.0,1.2,900.0,0.5*g)
            if ground == .planks and engine_unit(r) < 0.3:
                # (now and then the board creaks under the weight)
                phase = 0.0; hz = 620.0+120.0*engine_unit(r); start = toe+int(rate*0.02)
                loop i in 0..int(rate*0.12):
                    if start+i >= n: break
                    u = f64(i)/(rate*0.12)
                    phase += hz*(1.0-0.25*u)/rate
                    m[start+i] += (2.0*(phase-floor(phase))-1.0)*0.12*sin(PI*u)
            if ground == .floor:
                # (the room's first echoes off the walls)
                loop d in [int(rate*0.009),int(rate*0.017)]:
                    j = n-d-1
                    loop j >= 0:
                        m[j+d] += m[j]*0.28; j -= 1
        .stone, .stairs, .cobbles:
            loop at in [0,toe]:
                g = if at == 0: 1.0 else: 0.5
                foot_noise(m,r,at,2400.0+600.0*engine_unit(r),1.4,1500.0,1.0*g*v)
                foot_ring(m,at,900.0+300.0*engine_unit(r),220.0,0.35*g)
                foot_ring(m,at,80.0,60.0,0.5*g*v)
            if ground == .stairs: foot_noise(m,r,toe,900.0,0.7,18.0,0.12,0.03)        # (a scuff on the tread)
            if ground == .cobbles:
                loop k in 0..2+int(engine_unit(r)*2.0):
                    at = int(rate*(0.03+0.15*engine_unit(r)))
                    foot_noise(m,r,at,3200.0+1500.0*engine_unit(r),2.0,1800.0,0.25)  # (a loose stone)
        .earth:
            foot_ring(m,0,70.0+40.0*engine_unit(r),26.0,1.3*v)
            foot_noise(m,r,0,900.0,0.6,40.0,0.45*v,0.015)
            foot_ring(m,toe,80.0,30.0,0.5)
            foot_noise(m,r,toe,1100.0,0.6,45.0,0.25,0.01)
        .sand:
            foot_noise(m,r,0,2400.0,0.6,16.0,0.55*v,0.03)
            foot_ring(m,0,60.0,30.0,0.4*v)
            foot_noise(m,r,toe,3000.0,0.7,20.0,0.3,0.025)
    one_shot(m,0.45)

# Into the aircraft (a foot on the float, the airframe creaking under the weight, the seat taking
# it) or out of it (the seat let go, a foot down onto the deck): take, its own seed.
make_climb = (into: bool,take: int) -> Sound:
    r = EngineNoise(s = u64((if into: 11 else: 23)*1009+take))
    rate = f64(ENGINE_RATE); n = int(rate*1.1)
    m = fill(0.0,n)
    first = if into: 0 else: int(rate*0.45)
    last = if into: int(rate*0.55) else: 0
    # a foot on the float or the deck: a hollow thump
    foot_ring(m,first,140.0+30.0*engine_unit(r),24.0,1.2)
    foot_noise(m,r,first,700.0,0.8,60.0,0.4)
    # the airframe creaking: a woody groan sliding down
    start = int(rate*(0.15+0.1*engine_unit(r))); phase = 0.0; hz = 230.0+80.0*engine_unit(r)
    loop i in 0..int(rate*0.35):
        u = f64(i)/(rate*0.35)
        phase += hz*(1.0-0.3*u)/rate
        saw = 2.0*(phase-floor(phase))-1.0
        m[start+i] += saw*0.25*sin(PI*u)*(0.6+0.4*engine_signed(r))
    # the seat: cloth and leather taking or letting go of the weight
    foot_noise(m,r,last,600.0,0.5,9.0,0.35,0.06)
    one_shot(m,0.45)

# A chair drawn back on the floor as one sits (or pushed in as one stands): its legs juddering over
# stone, then a knock; a stool: a short scrape and a creak.
make_chair = (stool: bool,take: int) -> Sound:
    r = EngineNoise(s = u64((if stool: 31 else: 37)*1013+take))
    rate = f64(ENGINE_RATE); n = int(rate*(if stool: 0.5 else: 0.8))
    m = fill(0.0,n)
    length = int(rate*(if stool: 0.14 else: 0.35+0.15*engine_unit(r)))
    judder = 32.0+28.0*engine_unit(r)
    f = Biquad(); bandpass(f,ehz(700.0+500.0*engine_unit(r)),1.5); g2 = Biquad(); bandpass(g2,ehz(2300.0),2.0)
    loop i in 0..length:
        u = f64(i)/f64(length)
        stick = pow(max(0.0,sin(TAU*judder*f64(i)/rate)),6.0)
        x = engine_signed(r)
        m[i] += (filt(f,x)*1.6+filt(g2,x)*0.6)*stick*sin(PI*min(1.0,u*1.2))*0.9
    foot_ring(m,length,180.0+60.0*engine_unit(r),40.0,0.8)
    if stool:
        phase = 0.0; start = length+int(rate*0.05)
        loop i in 0..int(rate*0.18):
            if start+i >= n: break
            phase += 480.0*(1.0-0.2*f64(i)/(rate*0.18))/rate
            m[start+i] += (2.0*(phase-floor(phase))-1.0)*0.15*sin(PI*f64(i)/(rate*0.18))
    one_shot(m,0.45)

# A glass set down on the table: a tick of wood, the glass ringing (its partials a little off one
# another); a plate: a knock, a ceramic ring, a little clatter as it settles.
make_tableware = (plate: bool,take: int) -> Sound:
    r = EngineNoise(s = u64((if plate: 41 else: 43)*1019+take))
    rate = f64(ENGINE_RATE); n = int(rate*(if plate: 0.7 else: 0.9))
    m = fill(0.0,n)
    foot_ring(m,0,900.0+200.0*engine_unit(r),300.0,0.6)
    foot_noise(m,r,0,2000.0,1.0,1200.0,0.4)
    if plate:
        loop k in 0..3:
            at = if k == 0: 0 else: int(rate*(0.04*f64(k)+0.02*engine_unit(r)))
            g = 1.0/f64(k+1)
            foot_ring(m,at,1150.0+150.0*engine_unit(r),30.0,0.35*g)
            foot_ring(m,at,2700.0+300.0*engine_unit(r),45.0,0.25*g)
    else:
        hz = 2600.0+1400.0*engine_unit(r)
        foot_ring(m,0,hz,12.0,0.35); foot_ring(m,0,hz*2.41,18.0,0.18); foot_ring(m,0,hz*4.3,30.0,0.08)
    one_shot(m,0.4)

# One piece of the making (a frame each, a few takes a piece).
foot_sound_build_step = (f: mut FootSound):
    if f.ready: return
    k = f.stage
    if k < GROUNDS*2:
        g = k/2; half = k%2
        if half == 0: f.steps.push([])
        loop t in half*FOOT_TAKES/2..(half+1)*FOOT_TAKES/2: f.steps[g].push(make_step(Ground(g),t))
    else if k == GROUNDS*2: f.climb_in = [make_climb(true,1),make_climb(true,2)]
    else if k == GROUNDS*2+1: f.climb_out = [make_climb(false,1),make_climb(false,2)]
    else if k == GROUNDS*2+2: f.chair = [loop t in 0..3: make_chair(false,t)]
    else if k == GROUNDS*2+3: f.stool = [loop t in 0..3: make_chair(true,t)]
    else if k == GROUNDS*2+4: f.glass = [loop t in 0..4: make_tableware(false,t)]
    else if k == GROUNDS*2+5: f.plate = [loop t in 0..3: make_tableware(true,t)]
    else: f.ready = true
    f.stage += 1
# (all at once: tools and tests)
foot_sound_make = (f: mut FootSound):
    loop not f.ready: foot_sound_build_step(f)

# (one of a few takes, never the same twice running, its pitch a little its own)
foot_pick = (f: mut FootSound,takes: Sound[]) -> Sound:
    k = int(engine_unit(f.noise)*f64(takes.len())*0.9999)
    if takes.len() > 1 and k == f.last_step: k = (k+1)%takes.len()
    f.last_step = k
    takes[k]

# A footstep at `at` on a ground: walking (stride about 0.7) or running (1).
foot_step = (f: mut FootSound,ground: Ground,at: vec3,stride: f64):
    if not f.ready: return
    loud = 0.2+0.22*clamp((stride-0.3)/0.7,0.0,1.0)
    _ = play_at(foot_pick(f,f.steps[int(ground)]),at,loud*(0.85+0.3*engine_unit(f.noise)),30.0,pitch = ENGINE_PLAY*(0.93+0.14*engine_unit(f.noise)))
foot_event = (f: mut FootSound,takes: Sound[],at: vec3,volume: f64):
    if not f.ready or takes.len() == 0: return
    _ = play_at(foot_pick(f,takes),at,volume,30.0,pitch = ENGINE_PLAY*(0.95+0.1*engine_unit(f.noise)))
