# A conversation in the panel, heard in the world too: the person's line over their head and what
# the pilot says over his, as the bubbles of an overheard remark and its answer are
# (src/town_chat.jo). This is who is saying what and for how long; aegean.jo draws it.
use 'life_types.jo'

const TALK_LINE_SECONDS = 7.0       # their line stays this long once it is whole (an overheard remark's stay)
const TALK_PILOT_SECONDS = 4.5      # the pilot's own words (his answer to small talk stays as long)
const TALK_ANSWER_LEAD = 0.45       # the pilot speaks first: this long before the answer begins

struct TalkBubbles:
    person = -1                     # who the pilot is talking with (-1: nobody)
    line = ""                       # what they are saying: the panel's line
    whole_at = -1.0                 # when it had arrived in full (-1: still arriving)
    pilot = ""                      # what the pilot said last
    pilot_at = -100.0

# Each frame: `talking` while the conversation's panel is open with `person`, `line` what the
# panel shows them saying and `whole` once all of it has arrived. Anything else ends it: both
# bubbles go with the conversation.
talk_bubbles_step = (b: mut TalkBubbles, talking: bool, person: int, line: str, whole: bool, now: f64):
    if not talking or person < 0:
        if b.person >= 0 or b.pilot != "": b = TalkBubbles()
        return
    if person != b.person: b = TalkBubbles(person)
    if line != b.line:
        b.line = line
        b.whole_at = -1.0
    if whole and b.whole_at < 0.0: b.whole_at = now
    if not whole: b.whole_at = -1.0

# The pilot says `words` (the answer or the subject chosen in the panel).
talk_bubbles_pilot = (b: mut TalkBubbles, words: str, now: f64):
    b.pilot = words
    b.pilot_at = now

talk_bubbles_end = (b: mut TalkBubbles):
    b = TalkBubbles()

talk_person_speaks = (b: TalkBubbles, now: f64) -> bool:
    b.person >= 0 and b.line != "" and (b.whole_at < 0.0 or now - b.whole_at < TALK_LINE_SECONDS)

talk_pilot_speaks = (b: TalkBubbles, now: f64) -> bool:
    b.person >= 0 and b.pilot != "" and now - b.pilot_at >= 0.0 and now - b.pilot_at < TALK_PILOT_SECONDS

# How long the person's answer waits for the pilot's words just said (0: they speak at once).
talk_answer_lead = (b: TalkBubbles, now: f64) -> f64:
    if b.pilot != "" and now - b.pilot_at >= 0.0 and now - b.pilot_at < TALK_ANSWER_LEAD: TALK_ANSWER_LEAD else: 0.0

# What the pilot says aloud to bring a subject up (the panel's chip names the subject).
pilot_asks = (topic: TalkTopic) -> str:
    match topic:
        .greeting: "Good day."
        .work: "Have you any work for me?"
        .news: "What's the news?"
        .weather: "How's the weather looking?"
        .market: "How's trade?"
        .home: "How has your day been?"
        .people: "Who should I know here?"
        .troubles: "How do things stand with you?"
        .music: "Who's playing tonight?"
        .farewell: "Goodbye."

# An answer as the panel words it, as the pilot says it: without the panel's quotation marks, and
# a long one cut to its first sentence.
pilot_says = (answer: str) -> str:
    s = answer
    if s.len() >= 2 and s.starts_with("\"") and s.ends_with("\""): s = s[1..s.len() - 1]
    if char_count(s) > 70:
        loop mark in [". ", "; ", ": "]:
            if let k = s.index_of(mark):
                if k > 12:
                    s = s[0..k] + "."
                    break
    s
