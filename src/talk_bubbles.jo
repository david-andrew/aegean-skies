# A conversation in the panel, heard in the world too: the person's line over their head and what
# the pilot says over his, as the bubbles of an overheard remark and its answer are
# (src/town_chat.jo). This is who is saying what and for how long; aegean.jo draws it.
use 'life_types.jo'

const TALK_PILOT_SECONDS = 4.5      # the pilot's own words (his answer to small talk stays as long)
const TALK_ANSWER_LEAD = 0.45       # the pilot speaks first: this long before the answer begins

struct TalkBubbles:
    person = -1                     # who the pilot is talking with (-1: nobody)
    line = ""                       # what they are saying: the panel's line
    whole_at = -1.0                 # when it had arrived in full (-1: still arriving)
    pilot = ""                      # what the pilot said last
    pilot_at = -100.0

# Each frame: `talking` while the conversation's panel is open with `person`, `line` what the
# panel shows them saying and `whole` once all of it has arrived. Anything else ends it: both
# bubbles go with the conversation.
talk_bubbles_step = (b: mut TalkBubbles, talking: bool, person: int, line: str, whole: bool, now: f64):
    if not talking or person < 0:
        if b.person >= 0 or b.pilot != "": b = TalkBubbles()
        return
    if person != b.person: b = TalkBubbles(person)
    if line != b.line:
        b.line = line
        b.whole_at = -1.0
    if whole and b.whole_at < 0.0: b.whole_at = now
    if not whole: b.whole_at = -1.0

# The pilot says `words` (the answer or the subject chosen in the panel).
talk_bubbles_pilot = (b: mut TalkBubbles, words: str, now: f64):
    b.pilot = words
    b.pilot_at = now

talk_bubbles_end = (b: mut TalkBubbles):
    b = TalkBubbles()

# (their line is said nowhere else: it stays over them until they say the next thing)
talk_person_speaks = (b: TalkBubbles, now: f64) -> bool: b.person >= 0 and b.line != ""

talk_pilot_speaks = (b: TalkBubbles, now: f64) -> bool:
    b.person >= 0 and b.pilot != "" and now - b.pilot_at >= 0.0 and now - b.pilot_at < TALK_PILOT_SECONDS

# How long the person's answer waits for the pilot's words just said (0: they speak at once).
talk_answer_lead = (b: TalkBubbles, now: f64) -> f64:
    if b.pilot != "" and now - b.pilot_at >= 0.0 and now - b.pilot_at < TALK_ANSWER_LEAD: TALK_ANSWER_LEAD else: 0.0

# What the pilot says aloud to bring a subject up (the panel's chip names the subject).
pilot_asks = (topic: TalkTopic) -> str:
    match topic:
        .greeting: "Good day."
        .work: "Have you any work for me?"
        .news: "What's the news?"
        .weather: "How's the weather looking?"
        .market: "How's trade?"
        .home: "How has your day been?"
        .people: "Who should I know here?"
        .troubles: "How do things stand with you?"
        .music: "Who's playing tonight?"
        .farewell: "Goodbye."

# An answer as the panel words it, as the pilot says it: without the panel's quotation marks, and
# a long one cut to its first sentence.
pilot_says = (answer: str) -> str:
    s = answer
    if s.len() >= 2 and s.starts_with("\"") and s.ends_with("\""): s = s[1..s.len() - 1]
    if char_count(s) > 70:
        loop mark in [". ", "; ", ": "]:
            if let k = s.index_of(mark):
                if k > 12:
                    s = s[0..k] + "."
                    break
    s

# ---------------- out of earshot ----------------
# How clearly words carry over `metres`: 1 near to, falling from `faint` metres to 0 at `gone`.
talk_clarity = (metres: f64, faint: f64 = 15.0, gone: f64 = 25.0) -> f64: 1.0 - smoothstep(faint, gone, metres)

# A line as it is heard at that clarity: whole near to; farther off, more and more of its words
# lost to the distance (the same words lost each time for the same line, the last ones first to
# go as often as any), a run of lost words one gap.
talk_heard = (line: str, clarity: f64) -> str:
    if clarity >= 0.999: return line
    words = split(line, " ")
    lose = (1.0 - clamp(clarity, 0.0, 1.0)) * 0.85
    out: str[]
    gap = false
    loop k in 0..words.len():
        # (a fixed scatter over the words, so a line does not shimmer as one walks)
        roll = f64((k * 7919 + words.len() * 104729 + 13) % 1000) / 1000.0
        if roll < lose:
            if not gap: out.push("…")
            gap = true
        else:
            out.push(words[k]); gap = false
    join(out, " ")

# ---------------- what the pilot can say, a few at a time ----------------
# The replies show in sets of REPLY_SET beside his head, the way out (goodbye) under every set.
const REPLY_SET = 4

struct ReplyFan:
    set = 0                         # which set is showing
    focus = -1                      # the one a controller's d-pad has reached on this set (-1: none;
                                    # the set's count: the way out)
    said = ""                       # (the replies it was showing: new ones start at their first set)

reply_sets = (count: int) -> int: max(1, (count + REPLY_SET - 1) / REPLY_SET)
reply_first = (fan: ReplyFan) -> int: fan.set * REPLY_SET
# how many replies the showing set has
reply_shown = (fan: ReplyFan, count: int) -> int: clamp(count - reply_first(fan), 0, REPLY_SET)

# New replies (or the same ones after an absence) start at their first set, nothing reached.
reply_fresh = (fan: mut ReplyFan, said: str, again: bool):
    if said != fan.said or again: fan = ReplyFan(0, -1, said)

# A set along (step 1) or back (-1), round from the last to the first.
reply_turn = (fan: mut ReplyFan, count: int, step: int):
    sets = reply_sets(count)
    fan.set = ((fan.set + step) % sets + sets) % sets
    fan.focus = -1

# The d-pad down (step 1) or up (-1) through the set's replies and the way out, round at the ends.
reply_reach = (fan: mut ReplyFan, count: int, step: int):
    n = reply_shown(fan, count) + 1
    fan.focus = if fan.focus < 0: (if step > 0: 0 else: n - 1) else: ((fan.focus + step) % n + n) % n

# What a key takes: `digit` 1..REPLY_SET the set's reply of that number, 0 the way out, -1 no
# digit; `enter` the one the d-pad has reached. The reply's place among them all, `count` for
# the way out, -1 nothing.
reply_take = (fan: ReplyFan, count: int, digit: int, enter: bool = false) -> int:
    shown = reply_shown(fan, count)
    if digit == 0: return count
    if digit >= 1 and digit <= shown: return reply_first(fan) + digit - 1
    if enter and fan.focus >= 0: return if fan.focus >= shown: count else: reply_first(fan) + fan.focus
    -1

# A question of theirs left unanswered: its answers stay REPLY_WAIT seconds from when it was
# whole, fading over the last REPLY_FADE, and then it has passed (the subjects remain).
const REPLY_WAIT = 12.0
const REPLY_FADE = 3.0
reply_strength = (since_whole: f64) -> f64: clamp((REPLY_WAIT - since_whole) / REPLY_FADE, 0.0, 1.0)
