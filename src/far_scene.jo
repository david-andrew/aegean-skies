use 'crowd_motion.jo'
use 'access_bridges.jo'
# Publish a baked canonical road/water network only after the complete registry is available.
# No path search, rendering mesh, random destination or invisible market inventory here.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_catalog.jo'
use 'living_far_economy.jo'
use 'living_far_people.jo'
use 'living_commissions.jo'
use 'objects.jo'
import 'cargo_scene.jo' as navigation
use 'living_guard.jo'
use 'living_transaction.jo'
use 'world.jo'
use 'geography.jo'
use 'settlements.jo'
use 'settlement_access.jo'
use 'living_access.jo'
use 'living_relocation.jo'
use 'lake_data.jo'
use 'living_map_types.jo'

# Update the geographic feature registry only. Printed map editions keep their
# historical surveys; no purchased copy, shop inventory or purse is replaced.
refresh_access_map_features=(w:mut World):
    loop lake in SETTLEMENT_LAKES:
        s=world_settlements[settlement_by_id[lake.id]]
        loop k in 0..s.harbor.len():
            key="mooring:{s.id}:{k}"
            w.maps.features[key]=MapFeature(key,.moorings,s.harbor[k].at,"{s.name} lake quay {k+1}")
        loop k in 0.. and landmark in place_landmarks(s):
            key="landmark:{s.id}:{k}"
            if key in w.maps.features:w.maps.features[key].position=landmark.at

_far_catalog_rejected = false
_far_active_layout_key:u64=0
_far_canonical_links:FarLink[]

relocated_contexts_current=(w:World)->bool:
    loop lake in SETTLEMENT_LAKES:
        if not (lake.id in w.place_contexts) or not (lake.id in settlement_by_id):return false
        if length(w.place_contexts[lake.id].center-world_settlements[settlement_by_id[lake.id]].center)>0.1:return false
    true

scene_place_moves=(w:World,seeds:FarPlaceSeed[])->FarPlaceMove[]:
    result:FarPlaceMove[]
    loop lake in SETTLEMENT_LAKES:
        if not (lake.id in w.far.districts):continue
        s=world_settlements[settlement_by_id[lake.id]]
        if s.id in w.far.relocated_centers and length(w.far.relocated_centers[s.id]-s.center)<0.1:continue
        doors:{str:vec3};fallback:FarHome[]
        loop seed in seeds:
            if seed.id==s.id:fallback=seed.homes;break
        loop lot in place_lots(s):
            if let parcel=place_ground_lot(s,lot):
                front=vec2(sin(parcel.yaw),cos(parcel.yaw))
                at=place_point(parcel.at.xz+front*f32(parcel.depth*0.5+1.2))
                doors["home:{s.id}:{parcel.seed}"]=at
        homes=w.far.districts[s.id].homes
        loop k in 0..homes.len():
            homes[k].door=doors.get(homes[k].key,if fallback.len()>0:fallback[k%fallback.len()].door else:s.center)
        if homes.len()==0:homes=fallback
        result.push(FarPlaceMove(s.id,lake.old,s.center,homes))
    result


configure_far_economy = (w: mut World) -> bool:
    global _far_catalog_rejected,_far_active_layout_key,_far_canonical_links
    if w.far.populated and _far_active_layout_key!=u64(0) and w.far.access_layout_key==_far_active_layout_key:
        publish_access_roads(_far_canonical_links)
        return true
    if _far_catalog_rejected: return false
    if not geography_enabled or not settlement_registry_ready or w.place_contexts.len()!=world_settlements.len(): return false
    packed = inflate(embed('../assets/living-routes.bin'))
    if packed==none:
        _far_catalog_rejected = true
        living_fault("far.catalog_decode","corrupt living-routes.bin; run tools/bake_living_routes.jo")
        return false
    decoded = from_text[FarRouteCatalog](str_from_bytes(packed!))
    if decoded is TextError:
        _far_catalog_rejected = true
        living_fault("far.catalog_parse","invalid living-routes.bin; run tools/bake_living_routes.jo")
        return false
    ordered = world_settlements; ordered.sort((s: WorldSettlement): s.id)
    key = hash([loop s in ordered: (s.id,s.center,s.out,s.country)])
    if decoded.navigation_version!=1 or decoded.version!=SETTLEMENT_VERSION or decoded.terrain!=terrain_key() or decoded.geography!=geography_key() or decoded.places!=key or decoded.access_key!=hash(ACCESS_BRIDGES):
        _far_catalog_rejected = true
        living_fault("far.catalog_stale","expected registry={SETTLEMENT_VERSION} places={key}; run tools/bake_living_routes.jo")
        return false
    layout=hash((decoded.places,decoded.geography,decoded.terrain,decoded.access_key))
    if w.far.populated:
        if not upgrade_settlement_layout(w,decoded.links,scene_place_moves(w,decoded.seeds),layout):
            living_fault("far.layout_migration","no verified replacement for a saved route; rebuild a connected living catalogue")
            return false
        configure_far_harbors(w)
        refresh_access_map_features(w)
    else:
        if not populate_settlement_economy(w,decoded.version,decoded.seeds,decoded.links):return false
        w.far.access_layout_key=layout
        loop lake in SETTLEMENT_LAKES:w.far.relocated_centers[lake.id]=world_settlements[settlement_by_id[lake.id]].center
    _far_active_layout_key=layout;_far_canonical_links=decoded.links
    publish_access_roads(decoded.links)
    true

# One bounded local materialization scan per physical second. Camera visibility may name a real
# resident, but it cannot change their cohort/purse twice or return their identity on folding.
prepare_far_people = (w: mut World, observer: vec3):
    if not w.far.populated or w.tick<w.far.next_actor_scan: return
    w.far.next_actor_scan=w.tick+60
    nearest = -1; distance = 400.0
    loop id in w.far.place_ids:
        if w.far.districts[id].core>=0: continue
        d = f64(length(w.place_contexts[id].center-observer))
        if d<distance: nearest=id; distance=d
    if nearest>=0:
        roles: FarRole[] = [.trader,if w.far.districts[nearest].output==0: FarRole.fisher else: .farmer,.artisan]
        loop role in roles:
            locals=0
            loop id in w.far.districts[nearest].named:
                if w.far.people[id].role!=.pilot: locals+=1
            if locals>=3: break
            duplicate = false
            loop id in w.far.districts[nearest].named:
                if w.far.people[id].role==role: duplicate=true
            if not duplicate: promote_far_person(w,nearest,role)
    candidates: int[]
    loop id, a in w.far.people:
        if not person_vehicle_bound(w,id) and length(w.people[id].pose.pos-observer)<(if a.scene_owned: 420.0 else: 350.0): candidates.push(id)
    positions=w.people
    candidates.sort((id: int): (length(positions[id].pose.pos-observer),id))
    if candidates.len()>FAR_MAX_NEAR: candidates=candidates[0..FAR_MAX_NEAR]
    previous = w.far.near_people
    loop id in previous:
        if id in candidates: continue
        w.far.people[id].scene_owned=false; w.far.people[id].last_tick=w.tick
        w.people[id].move_owner=.abstract_world
    w.far.near_people=candidates

step_far_people_scene = (w: mut World, towns: Town[], observer: vec3, dt: f64, nav_budget: int = 1) -> int:
    prepare_far_people(w,observer)
    started=0
    loop id in w.far.near_people:
        a = w.far.people[id]
        if person_vehicle_bound(w,id):
            w.far.people[id].scene_owned=false; w.far.people[id].last_tick=w.tick
            w.people[id].move_owner=.abstract_world
            continue
        if not a.scene_owned:
            far_walk_abstract(w,id,w.tick-1)
            # Validate both the hand-off pose and the reserved destination
            # against physical scenery before creating a navigation route.
            w.people[id].pose.pos=walk_step(towns,w.people[id].pose.pos,vec2(0,0))
            target=walk_step(towns,a.target,vec2(0,0))
            if target!=a.target:
                w.far.people[id].target=target
                w.far.people[id].route=[];w.far.people[id].waypoint=0;w.far.people[id].planned_anchor=""
            w.far.people[id].scene_owned=true; w.people[id].move_owner=.scene
        w.far.people[id].last_tick=w.tick
        a=w.far.people[id]
        if length(a.target-w.people[id].pose.pos)<0.05 or a.blocked!="": continue
        if a.planned_anchor!=a.anchor or a.route.len()==0:
            if started>=nav_budget: continue
            started += 1
            path=navigation.cargo_walk_path(towns,w.people[id].pose.pos,a.target)
            w.far.people[id].planned_anchor=a.anchor
            if path.len()<2 or path.len()>512:
                w.far.people[id].blocked="There is no clear walking route to my next stop."
                continue
            w.far.people[id].route=path; w.far.people[id].waypoint=1
        a=w.far.people[id]
        if a.waypoint<0 or a.waypoint>a.route.len():
            living_fault("far.scene_walk_route",guard_context(w)+" person={id}"); continue
        if a.waypoint>=a.route.len(): continue
        delta=a.route[a.waypoint].xz-w.people[id].pose.pos.xz; distance=f64(length(delta))
        if distance<0.05:
            w.far.people[id].waypoint += 1; continue
        moved=crowd_walk(w,towns,id,delta*f32(min(1.0,1.2*dt/distance)))
        if not finite_living_point(moved):
            living_fault("far.walk_pose",guard_context(w)+" person={id} target={a.target}"); continue
        w.people[id].pose.pos=moved
        w.people[id].pose.rot=facing(vec3(delta.x,0,delta.y))
    started

fold_far_people = (w: mut World):
    loop k in 0..w.far.vehicles.len():
        w.far.vehicles[k].scene_owned=false
        id=w.far.vehicles[k].journey
        if id>=0 and id in w.far.journeys: w.far.journeys[id].last_tick=w.tick
    loop id in w.far.near_people:
        w.far.people[id].scene_owned=false; w.far.people[id].last_tick=w.tick
        w.people[id].move_owner=.abstract_world
    w.far.near_people=[]; w.far.next_actor_scan=w.tick

configure_far_harbors = (w: mut World) -> bool:
    if not settlement_registry_ready: return false
    harbors: FarHarbor[]
    loop s in world_settlements:
        if s.harbor.len()==0: continue
        docks=[loop h in s.harbor: h.at]
        quays: vec3[]
        loop h in s.harbor:
            # Load beside the aircraft along the real quay edge, not the pier midpoint
            # (capital piers are280m long). Match settlement_port's loading geometry.
            along=h.quay_b-h.quay_a
            u=clamp(dot(h.at.xz-h.quay_a,along)/max(0.001,dot(along,along)),0.0,1.0)
            near=h.quay_a+along*u; side=h.at.xz-near
            if length(side)>0.001: near+=normalize(side)*f32(h.width*0.5-0.8)
            quays.push(vec3(near.x,f32(h.deck),near.y))
        if s.legacy>=0 and s.legacy<w.cargo_harbors.len() and w.cargo_harbors[s.legacy].loading.len()==docks.len(): quays=w.cargo_harbors[s.legacy].loading
        heading=if s.remote_harbor:normalize(s.harbor[0].quay_b-s.harbor[0].quay_a) else:s.out
        harbors.push(FarHarbor(s.id,vec3(heading.x,0,heading.y),docks,quays,s.harbor[0].buoy))
    publish_far_harbors(w,harbors)
