use 'world_point.jo'
# Small original props and existing-figure poses. Shared meshes, no new textures or shaders.
use 'look.jo'
use 'objects.jo'
use 'folk.jo'
use 'living_types.jo'
use 'life_types.jo'
use 'living_domestic.jo'
use 'town_architecture.jo'
use 'world_towns.jo'

occupied_fixture_meshes: Mesh[]
domestic_tools: Mesh[]
draw_domestic_tool = (fixture: LifeVenue,L: Light,t: f64):
    global domestic_tools
    if fixture.kind==.seat: return
    if domestic_tools.len()==0:
        peel: Vertex3D[]; cloth: Vertex3D[]
        add_box(peel,vec3(0,0,-0.55),vec3(0.045,0.045,0.85),rgb(0.42,0.29,0.17))
        add_box(peel,vec3(0,0,-1.1),vec3(0.30,0.035,0.40),rgb(0.62,0.48,0.29))
        add_box(cloth,vec3(0,-0.18,0),vec3(0.52,0.38,0.025),rgb(0.81,0.82,0.73))
        domestic_tools=[custom_mesh(peel),custom_mesh(cloth)]
    yaw=atan2(f64(fixture.facing.x),f64(fixture.facing.z))+PI
    at=rotation_y(yaw)
    if fixture.kind==.oven: at=at*translation(vec3(0,1.06,-0.06))*rotation_x(sin(t*1.1)*0.06)
    else: at=at*translation(vec3(0,1.91+f32(sin(t*1.4)*0.08),-0.45))
    draw(obj_sh,domestic_tools[if fixture.kind==.oven: 0 else: 1],obj_params(L,t,at,anchor=world_point(fixture.pos)))
draw_occupied_fixture = (fixture: LifeVenue,L: Light,t: f64):
    global occupied_fixture_meshes
    kind=if fixture.kind==.seat: 11 else: if fixture.kind==.laundry: 10 else: 8
    if close_fixture_drawn(kind,fixture.prop_pos): return
    if occupied_fixture_meshes.len()==0: occupied_fixture_meshes=[loop k in [11,10,8]: custom_mesh(arch_vertices(k))]
    draw(obj_sh,occupied_fixture_meshes[if kind==11: 0 else: if kind==10: 1 else: 2],obj_params(L,t,rotation_y(fixture.prop_yaw),anchor=world_point(fixture.prop_pos)))

struct LifeMeshes:
    bicycle: Mesh
    mandolin: Mesh
    children: Figure[]

life_density = 1.0
set_life_density = (value: f64):
    global life_density
    life_density = clamp(value,0.0,1.0)

# Thin frame members lie in the bicycle's side plane; its front is local -z.
_bike_bar = (vs: mut Vertex3D[], a: vec3, b: vec3, color: vec4):
    delta = b-a
    add_box(vs,vec3(0,f32(length(delta)*0.5),0),vec3(0.045,length(delta),0.045),color,translation(a)*rotation_x(atan2(f64(delta.z),f64(delta.y))))

build_life_meshes = (w: World) -> LifeMeshes:
    bike: Vertex3D[]; ink = rgb(0.12,0.15,0.15); steel = rgb(0.48,0.48,0.43)
    loop z in [-0.62,0.62]:
        at = translation(vec3(0,0.42,f32(z)))*rotation_z(PI*0.5)
        add_cylinder(bike,vec3(0,-0.035,0),0.40,0.07,ink,16,0.40,at)
        add_cylinder(bike,vec3(0,-0.038,0),0.33,0.076,rgb(0.68,0.68,0.60),16,0.33,at)
        add_cylinder(bike,vec3(0,-0.042,0),0.045,0.084,steel,10,0.045,at)
        loop k in 0..8:
            a = f64(k)*PI/4.0
            add_box(bike,vec3(0,0.42,f32(z)),vec3(0.085,0.015,0.65),steel,translation(vec3(0,0.42,f32(z)))*rotation_x(a)*translation(vec3(0,-0.42,f32(-z))))
    loop segment in [(vec3(0,0.42,0.62),vec3(0,0.86,0.24)),(vec3(0,0.86,0.24),vec3(0,0.44,0)),(vec3(0,0.44,0),vec3(0,0.42,0.62)),(vec3(0,0.44,0),vec3(0,1.00,-0.42)),(vec3(0,1.00,-0.42),vec3(0,0.86,0.24)),(vec3(0,1.00,-0.42),vec3(0,0.42,-0.62))]: _bike_bar(bike,segment.0,segment.1,ink)
    add_box(bike,vec3(0,0.91,0.24),vec3(0.28,0.07,0.24),rgb(0.29,0.20,0.13))
    add_box(bike,vec3(0,1.04,-0.44),vec3(0.52,0.04,0.06),steel)
    add_box(bike,vec3(0,0.43,0),vec3(0.45,0.045,0.08),steel)
    instrument: Vertex3D[]
    add_sphere(instrument,vec3(0,0,0),1.0,rgb(0.54,0.27,0.10),12,6,translation(vec3(0.06,1.15,-0.38))*scaling(vec3(0.24,0.19,0.075)))
    add_box(instrument,vec3(0,0.18,0),vec3(0.055,0.43,0.045),rgb(0.30,0.17,0.08),translation(vec3(-0.04,1.28,-0.40))*rotation_z(-0.65))
    add_sphere(instrument,vec3(0.06,1.18,-0.453),0.042,ink,8,4)
    loop x in [-0.012,0.0,0.012]: add_box(instrument,vec3(f32(0.06+x),1.16,-0.458),vec3(0.004,0.18,0.003),rgb(0.82,0.75,0.56))
    children: Figure[]
    loop p in w.households:
        f = build_figure(if p.id%2 == 0: Dress.fisher else: Dress.dress,p.id%10000)
        f.height *= f32(0.60+f64(p.age-7)*0.035)
        children.push(f)
    LifeMeshes(custom_mesh(bike),custom_mesh(instrument),children)

# The named adults are drawn by townsfolk; this draws only their attached saved activity props.
draw_life = (w: World, meshes: LifeMeshes, L: Light, t: f64):
    cam = scene_camera()
    loop p in w.people:
        if length(p.pose.pos-cam)>80: continue
        if let fixture=active_domestic(w,p.id):
            draw_occupied_fixture(fixture,L,t)
            draw_domestic_tool(fixture,L,t)
    loop person, intent in w.daily_life:
        p = w.people[person]
        if p.place < 0 or p.carriage >= 0 or length(p.pose.pos-cam)>300: continue
        at = translation(p.pose.pos)*quat_to_mat4(p.pose.rot)
        if intent.mobility == .bicycle and not intent.arrived:
            draw(obj_sh,meshes.bicycle,obj_params(L,t,at))
        if intent.activity == .play and intent.arrived:
            draw(obj_sh,meshes.mandolin,obj_params(L,t,at))
    if life_density <= 0: return
    loop k in 0..min(w.households.len(),meshes.children.len()):
        p = w.households[k]
        if f64(k)/f64(max(1,w.households.len())) >= life_density or length(p.pose-cam)>300: continue
        arrived = length(p.pose-p.target)<0.4
        if arrived and (p.venue == .home or p.venue == .school): continue
        delta = p.target-p.pose
        yaw = if length(delta)>0.1: atan2(f64(delta.x),f64(delta.z)) else: f64(p.id%7)
        draw_figure(meshes.children[k],p.pose,yaw,t*5.5+f64(k),if arrived: 0.0 else: 0.7,L,t,wave=if arrived and p.activity==.play: 0.25+0.15*sin(t*1.7+f64(k)) else: 0.0)
