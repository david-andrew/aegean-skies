# Validate references BEFORE any simulation helper can index a malformed save's links/accounts.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_money.jo'
use 'living_guard.jo'
use 'living_work.jo'
use 'living_far_orders.jo'

validate_far = (w: World) -> str:
    if not w.far.populated:
        loop p in w.people:
            if p.far_home>=0 or p.far_reports.len()>0: return "far person/report without a populated registry"
        return "" # stock primitive fixtures have no cohort registry
    f = w.far
    if f.version!=1 or f.registry_version<1 or f.place_ids.len()!=f.districts.len() or f.place_ids.len()>1024 or f.vehicles.len()>1280 or f.journeys.len()>f.vehicles.len(): return "invalid far dimensions/version"
    if f.news.len()>2048 or f.news_order.len()!=f.news.len(): return "unbounded far news journal"
    registered: {int: bool}
    loop key, craft in f.air_registrations:
        if key=="" or key.len()>160 or craft<8 or craft>=w.aircraft.len() or craft in registered or not (craft in f.air_homes) or not (w.aircraft[craft].owner in f.people): return "invalid far aircraft registration"
        registered[craft]=true
    loop craft, place in f.air_homes:
        if craft<8 or craft>=w.aircraft.len() or not (place in f.harbors): return "invalid far aircraft home"
    occupied: {str: bool}
    loop craft, berth in f.air_berths:
        if craft<0 or craft>=w.aircraft.len() or not (berth.place in f.harbors) or berth.dock<0 or berth.dock>=f.harbors[berth.place].docks.len(): return "invalid far aircraft berth"
        key="{berth.place}:{berth.dock}"
        if key in occupied: return "duplicate far aircraft berth"
        occupied[key]=true
    if f.accepted_requests.len()>1024: return "unbounded supply agreement receipts"
    loop id, due in f.accepted_requests:
        if id<0 or id>=f.next_news or due<0: return "invalid supply agreement receipt"
    if f.commissions.len()>96: return "unbounded far commissions"
    loop place, h in f.harbors:
        if h.place!=place or not (place in w.place_contexts) or h.docks.len()==0 or h.docks.len()!=h.quays.len() or h.docks.len()>32 or not finite_living_point(h.out) or not finite_living_point(h.buoy): return "invalid sparse harbor"
        loop point in h.docks+h.quays:
            if not finite_living_point(point): return "invalid sparse harbor pose"
    loop id, c in f.commissions:
        agreement_error=work_provenance_error(w,c.provenance)
        if agreement_error!="": return agreement_error
        if id!=c.id or id<0 or id>=f.next_commission or not (c.origin in f.districts) or not (c.destination in f.districts) or c.origin==c.destination or c.poster<0 or c.poster>=w.people.len() or c.carrier< -1 or c.carrier>=w.people.len() or c.porter< -1 or c.porter>=w.people.len() or c.craft< -1 or c.craft>=w.aircraft.len(): return "invalid commission identity"
        if not account_valid(w,c.funder) or not account_valid(w,c.owner) or not account_valid(w,c.escrow) or c.reward<0 or c.quantity<=0 or c.good< -1 or c.good>=9 or c.created>w.minute or c.last_tick>w.tick or c.deadline<c.created or not finite_living_point(c.pos): return "invalid commission terms"
        total=0
        loop g in 0..9:
            if c.cargo.qty[g]<0 or (g!=c.good and c.cargo.qty[g]!=0): return "invalid commission cargo"
            total+=c.cargo.qty[g]
        if c.paper!=none and (c.kind!=.mail or c.good!=-1 or c.quantity!=1 or total!=0): return "invalid sealed dispatch custody"
        if let paper=c.paper:
            if not far_report_valid(w,paper): return "invalid dispatch source evidence"
        if c.phase==.delivered or c.phase==.expired or c.phase==.cancelled:
            if total!=0 or c.paper!=none: return "terminal commission retains cargo"
        else if c.good<0:
            if c.paper==none: return "sealed dispatch is missing"
        else if total!=c.quantity: return "commission cargo custody"
        if c.phase!=.open and c.phase!=.expired and c.phase!=.cancelled and c.carrier<0: return "commission missing carrier"
        if c.phase==.aboard and c.craft<0: return "commission missing aircraft"
    seen_news: {int: bool}
    loop id in f.news_order:
        if id in seen_news or not (id in f.news) or f.news[id].id!=id or id>=f.next_news or not (f.news[id].place in f.districts) or f.news[id].minute>w.minute: return "invalid far news index"
        n=f.news[id]
        if n.actor< -1 or n.actor>=w.people.len() or n.other< -1 or n.other>=w.people.len() or n.country< -1 or n.country>=3 or n.text.len()>4096 or n.severity<0 or n.severity>1000 or n.other_country< -1 or n.other_country>=3 or n.aggressor< -1 or n.aggressor>=3 or n.affected< -1 or n.affected>=3 or n.weight<0 or n.weight>150: return "invalid far witnessed account"
        seen_news[id]=true
    if f.core_people<26 or f.core_people>w.people.len() or f.people.len()!=w.people.len()-f.core_people or f.people.len()>3072 or f.near_people.len()>24: return "invalid far named population"
    previous = -1; population = f.named_core_population+f.people.len()+f.dead+f.evacuated
    loop c in 0..3:
        if f.crew_population[c]<0 or not account_valid(w,f.treasury[c]): return "invalid far treasury/crew"
        population += f.crew_population[c]
    loop id in f.place_ids:
        if id<=previous or not (id in f.districts) or not (id in w.place_contexts): return "invalid far place index"
        previous = id; d = f.districts[id]
        if d.id!=id or d.core< -1 or d.core>=w.places.len() or d.born_country<0 or d.born_country>=3 or d.controller<0 or d.controller>=3 or d.authority<0 or d.authority>=3: return "invalid far district identity/control"
        if not account_valid(w,d.market_account) or not account_valid(w,d.household_account) or d.output<0 or d.output>=9 or d.productivity<1 or d.raw_ore<0 or d.raw_crude<0: return "invalid far district economy"
        if d.core>=0 and (d.market_account!=w.places[d.core].market.account or d.stock.roots.len()>0): return "duplicate detailed gateway inventory"
        loop c in 0..3:
            if d.workers[c]<0 or d.dependents[c]<0 or d.pending_workers[c]<0 or d.pending_workers[c]>d.dependents[c]: return "negative far population"
            population += d.workers[c]+d.dependents[c]
        loop g in 0..9:
            if d.target[g]<0 or d.unmet[g]<0 or d.prices[g]<=0 or d.demand_remainder[g]<0 or d.demand_remainder[g]>=24: return "invalid far market projection"
        if d.reports.len()>12: return "unbounded district accounts"
        if d.customer_orders.len()>FAR_CUSTOMER_ORDERS: return "unbounded counter customer orders"
        services: {int: bool}
        loop e in d.customer_orders:
            if e.service<0 or e.service>=f.vehicles.len() or e.service in services or e.heard>w.minute or e.heard<e.order.minute or e.order.place==id or not restock_order_valid(w,e.order): return "invalid received counter order"
            services[e.service]=true
        loop r in d.reports:
            if not far_report_valid(w,r): return "invalid district account"
        if d.homes.len()>3: return "unbounded resident home anchors"
        loop h in d.homes:
            if h.key=="" or not finite_living_point(h.door): return "invalid resident doorway"
        loop link in d.links:
            if link<0 or link>=f.links.len(): return "missing far district road"
    named_seen: {int: bool}
    loop _, d in f.districts:
        if d.named.len()>5: return "unbounded named district"
        pilots=0
        loop id in d.named:
            if id in f.people and f.people[id].role==.pilot: pilots+=1
        if d.pilot_slots<2 or d.pilot_slots>64 or pilots>d.pilot_slots or d.named.len()-pilots>3: return "unbounded resident/pilot slots"
        loop id in d.named:
            if id in named_seen or not (id in f.people) or id<core_person_count(w) or id>=w.people.len() or w.people[id].far_home!=d.id: return "invalid far resident index"
            named_seen[id]=true
    loop id, a in f.people:
        if id!=a.id or not (id in named_seen) or not finite_living_point(a.home_pos) or a.home_key=="" or not finite_living_point(a.target) or a.last_tick>w.tick or a.worked_minutes<0 or a.route.len()>512 or a.waypoint<0 or a.waypoint>a.route.len(): return "invalid far resident intent"
        loop point in a.route:
            if not finite_living_point(point): return "invalid far resident route"
    near_seen: {int: bool}
    loop id in f.near_people:
        if id in near_seen or not (id in f.people): return "invalid far near-person index"
        near_seen[id]=true
    loop p in w.people:
        if p.far_reports.len()>12: return "unbounded carried far accounts"
        loop r in p.far_reports:
            if not far_report_valid(w,r): return "invalid carried far account"
    loop _, j in f.journeys:
        loop n in j.refugees:
            if n<0: return "negative displaced population"
            population+=n
    loop _, s in w.war.survivors:
        loop n in s.passengers:
            if n<0: return "negative rescued population"
            population+=n
    if population!=f.opening_population: return "far population conservation"
    loop i in 0..f.links.len():
        l = f.links[i]
        if l.id!=i or not (l.a in f.districts) or not (l.b in f.districts) or l.a==l.b or l.points.len()<2 or l.points.len()>4096 or l.length_mm<=0: return "invalid far service route"
        loop p in l.points:
            if not finite_living_point(p): return "invalid far route point"
    counted_crew: int[3]
    loop i in 0..f.vehicles.len():
        v = f.vehicles[i]
        if v.id!=i or not account_valid(w,v.account) or v.route<0 or v.route>=f.links.len() or v.speed_mm_sec<=0 or v.capacity_grams<1 or not finite_living_point(v.pos) or not finite_living_point(v.velocity): return "invalid far vehicle"
        loop person in v.passengers:
            if person<0 or person>=w.people.len() or w.people[person].far_boat!=v.id: return "invalid named sea passenger"
        if v.reports.len()>12: return "unbounded carrier accounts"
        if let order=v.buying_order:
            if not restock_order_valid(w,order): return "invalid carried restocking order"
        loop r in v.reports:
            if not far_report_valid(w,r): return "invalid carrier account"
        if v.journey>=0:
            if not (v.journey in f.journeys) or f.journeys[v.journey].vehicle!=i or v.place>=0: return "far vehicle double location"
        else if not (v.place in f.districts): return "far vehicle missing location"
        loop c in 0..3:
            if v.crew[c]<0: return "negative far crew"
            counted_crew[c] += v.crew[c]
    if counted_crew!=f.crew_population: return "far crew conservation"
    max_journey = -1
    loop id, j in f.journeys:
        if j.follow_vehicle< -1 or j.follow_vehicle>=f.vehicles.len() or j.follow_voyage< -1 or j.follow_voyage>=f.next_journey or (j.follow_vehicle<0)!=(j.follow_voyage<0): return "invalid convoy leader"
        agreement_error=work_provenance_error(w,j.provenance)
        if agreement_error!="": return agreement_error
        if let order=j.return_order:
            if not restock_order_valid(w,order) or order.place!=j.origin: return "invalid return restocking order"
        max_journey = max(id,max_journey)
        if id!=j.id or j.vehicle<0 or j.vehicle>=f.vehicles.len() or j.link<0 or j.link>=f.links.len() or j.last_tick>w.tick or j.last_tick<j.departed_tick or j.segment<0: return "invalid far journey"
        if j.reports.len()>12: return "unbounded journey accounts"
        loop r in j.reports:
            if not far_report_valid(w,r): return "invalid journey account"
        if not (j.origin in f.districts) or not (j.destination in f.districts) or j.origin==j.destination or j.good< -1 or j.good>=9 or j.quantity<0 or (j.duty==.merchant and ((j.survey and (j.good!=-1 or j.quantity!=0)) or (not j.survey and j.good<0))) or j.speed_mm_sec<=0 or j.speed_mm_sec!=f.vehicles[j.vehicle].speed_mm_sec: return "invalid far manifest"
        if f.vehicles[j.vehicle].journey!=id or (j.good>=0 and f.vehicles[j.vehicle].cargo.qty[j.good]!=j.quantity): return "far cargo custody mismatch"
        if not account_valid(w,j.buyer) or not account_valid(w,j.seller) or j.cargo_owner!=j.buyer: return "invalid far cargo title"
        passengers=0
        loop c in 0..3:
            if j.refugees[c]<0 or j.refugee_workers[c]<0 or j.refugee_workers[c]>j.refugees[c]: return "invalid refugee age/work partition"
            passengers+=j.refugees[c]
        if passengers>0 and (j.duty!=.refugee or not account_valid(w,j.passenger_account)): return "invalid funded refugee passage"
        if j.cargo_owner!=f.vehicles[j.vehicle].cargo_owner: return "far custody/title mismatch"
        if inventory_mass(w,f.vehicles[j.vehicle].cargo)+passengers*75000>f.vehicles[j.vehicle].capacity_grams: return "far freight capacity"
        l = f.links[j.link]
        if j.segment>l.points.len()-1 or j.origin!=(if j.forward: l.a else: l.b) or j.destination!=(if j.forward: l.b else: l.a): return "invalid far journey progress"
    if f.next_journey<=max_journey: return "far journey counter rewind"
    ""

inventory_mass = (w: World, stock: FarStock) -> int:
    total = 0
    loop g in 0..9: total += stock.qty[g]*w.goods[g].package_grams/1000
    total

far_report_valid = (w: World, r: FarReport) -> bool:
    if not valid_need_places(w,r.supply_places) or r.supply_since< -1 or (r.supply_since>=0 and r.supply_since>r.occurred_minute): return false
    if r.kind=="supply_request":
        if not (r.origin in w.far.districts) or r.supply_good<0 or r.supply_good>=9 or r.supply_qty<=0 or r.supply_bid<=0 or r.supply_reward<0 or r.supply_due<r.occurred_minute or r.supply_account!=w.far.districts[r.origin].market_account or r.supply_observed<0 or r.supply_target<=r.supply_observed: return false
    (r.supply_good>= -1 and r.supply_good<9 and r.supply_qty>=0 and r.supply_bid>=0 and r.supply_reward>=0 and r.supply_account>= -1 and r.supply_account<w.accounts.len() and r.supply_observed>=0 and r.supply_target>=0) and r.id>=0 and r.id<w.far.next_news and r.origin in w.far.districts and (r.subject_place<0 or r.subject_place in w.far.districts) and r.subject_minute>= -1 and r.subject_minute<=w.minute and r.mission>= -1 and r.mission<w.war.next_mission and r.rescue>= -1 and r.rescue<w.war.next_survivor and r.source_person>= -1 and r.source_person<w.people.len() and r.actor>= -1 and r.actor<w.people.len() and r.other>= -1 and r.other<w.people.len() and r.country>= -1 and r.country<3 and r.other_country>= -1 and r.other_country<3 and r.aggressor>= -1 and r.aggressor<3 and r.affected>= -1 and r.affected<3 and r.weight>=0 and r.weight<=150 and r.occurred_minute<=w.minute and r.learned_minute<=w.minute and r.learned_minute>=r.occurred_minute and r.carriage>=0 and r.carriage<=100000 and r.hops>=0 and r.hops<=4 and r.confidence>=0 and r.confidence<=1000 and r.text.len()<=4096
