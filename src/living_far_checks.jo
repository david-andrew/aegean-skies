# Validate references BEFORE any simulation helper can index a malformed save's links/accounts.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_money.jo'
use 'living_guard.jo'

validate_far = (w: World) -> str:
    if not w.far.populated: return "" # stock primitive fixtures have no cohort registry
    f = w.far
    if f.version!=1 or f.registry_version<1 or f.place_ids.len()!=f.districts.len() or f.place_ids.len()>1024 or f.vehicles.len()>768 or f.journeys.len()>f.vehicles.len(): return "invalid far dimensions/version"
    previous = -1; population = f.named_core_population+f.people.len()+f.dead+f.evacuated
    loop c in 0..3:
        if f.crew_population[c]<0 or not account_valid(w,f.treasury[c]): return "invalid far treasury/crew"
        population += f.crew_population[c]
    loop id in f.place_ids:
        if id<=previous or not (id in f.districts) or not (id in w.place_contexts): return "invalid far place index"
        previous = id; d = f.districts[id]
        if d.id!=id or d.core< -1 or d.core>=w.places.len() or d.born_country<0 or d.born_country>=3 or d.controller<0 or d.controller>=3 or d.authority<0 or d.authority>=3: return "invalid far district identity/control"
        if not account_valid(w,d.market_account) or not account_valid(w,d.household_account) or d.output<0 or d.output>=9 or d.productivity<1 or d.raw_ore<0 or d.raw_crude<0: return "invalid far district economy"
        if d.core>=0 and (d.market_account!=w.places[d.core].market.account or d.stock.roots.len()>0): return "duplicate detailed gateway inventory"
        loop c in 0..3:
            if d.workers[c]<0 or d.dependents[c]<0: return "negative far population"
            population += d.workers[c]+d.dependents[c]
        loop g in 0..9:
            if d.target[g]<0 or d.unmet[g]<0 or d.prices[g]<=0 or d.demand_remainder[g]<0 or d.demand_remainder[g]>=24: return "invalid far market projection"
        loop link in d.links:
            if link<0 or link>=f.links.len(): return "missing far district road"
    if population!=f.opening_population: return "far population conservation"
    loop i in 0..f.links.len():
        l = f.links[i]
        if l.id!=i or not (l.a in f.districts) or not (l.b in f.districts) or l.a==l.b or l.points.len()<2 or l.points.len()>4096 or l.length_mm<=0: return "invalid far service route"
        loop p in l.points:
            if not finite_living_point(p): return "invalid far route point"
    counted_crew: int[3]
    loop i in 0..f.vehicles.len():
        v = f.vehicles[i]
        if v.id!=i or not account_valid(w,v.account) or v.route<0 or v.route>=f.links.len() or v.speed_mm_sec<=0 or v.capacity_grams<1 or not finite_living_point(v.pos) or not finite_living_point(v.velocity): return "invalid far vehicle"
        if v.journey>=0:
            if not (v.journey in f.journeys) or f.journeys[v.journey].vehicle!=i or v.place>=0: return "far vehicle double location"
        else if not (v.place in f.districts): return "far vehicle missing location"
        loop c in 0..3:
            if v.crew[c]<0: return "negative far crew"
            counted_crew[c] += v.crew[c]
    if counted_crew!=f.crew_population: return "far crew conservation"
    max_journey = -1
    loop id, j in f.journeys:
        max_journey = max(id,max_journey)
        if id!=j.id or j.vehicle<0 or j.vehicle>=f.vehicles.len() or j.link<0 or j.link>=f.links.len() or j.last_tick>w.tick or j.last_tick<j.departed_tick or j.segment<0: return "invalid far journey"
        if not (j.origin in f.districts) or not (j.destination in f.districts) or j.origin==j.destination or j.good<0 or j.good>=9 or j.quantity<=0 or j.speed_mm_sec<=0 or j.speed_mm_sec!=f.vehicles[j.vehicle].speed_mm_sec: return "invalid far manifest"
        if f.vehicles[j.vehicle].journey!=id or f.vehicles[j.vehicle].cargo.qty[j.good]!=j.quantity: return "far cargo custody mismatch"
        if not account_valid(w,j.buyer) or not account_valid(w,j.seller) or j.cargo_owner!=j.buyer: return "invalid far cargo title"
        if j.cargo_owner!=f.vehicles[j.vehicle].cargo_owner: return "far custody/title mismatch"
        if inventory_mass(w,f.vehicles[j.vehicle].cargo)>f.vehicles[j.vehicle].capacity_grams: return "far freight capacity"
        l = f.links[j.link]
        if j.segment>l.points.len()-1 or j.origin!=(if j.forward: l.a else: l.b) or j.destination!=(if j.forward: l.b else: l.a): return "invalid far journey progress"
    if f.next_journey<=max_journey: return "far journey counter rewind"
    ""

inventory_mass = (w: World, stock: FarStock) -> int:
    total = 0
    loop g in 0..9: total += stock.qty[g]*w.goods[g].package_grams/1000
    total
