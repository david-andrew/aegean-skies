# Local hulls use the saved fleet and its one fixed-step motion/damage owner.
# No decorative traffic clock, imaginary cargo or duplicate living-world voyages.
use 'river_data.jo'
use 'river_field.jo'
use 'water_field.jo'
use 'canal_geometry.jo'
use 'vessel_types.jo'
use 'vessels.jo'
use 'geography.jo'
import 'living_types.jo' as data
import 'living_far_people.jo' as residents
const CANAL_VESSEL_BASE=720000000
const CANAL_VESSELS=22
# The lagoon's own (slots 15-21): two patrol launches circling across its middle, the way the run
# takes off (canal_ground_fire.jo puts a rifleman aboard each in the escape), barges moored along
# its walls, and a barge and a rowing boat at buoys out on its water.
const CANAL_PATROLS=[15,16]
# A patrol's loop: a circle of radius r about the point `across` out from the cut's centre line at
# station local (the lagoon is on the +side, out to 265 m), one way or the other round.
canal_patrol_loop=(local:int,across:f64,r:f64,turn:f64)->vec2[]:
    c=canal_route_point(CANAL_BEGIN+local,across).xz
    [loop k in 0..25:c+vec2(f32(sin(turn*f64(k)*PI/12.0)*r),f32(cos(turn*f64(k)*PI/12.0)*r))]

canal_route_point=(station:int,offset:f64)->vec3:
    a=RIVER_NODES[station];b=RIVER_NODES[min(station+1,CANAL_FINISH)]
    previous=RIVER_NODES[max(CANAL_BEGIN,station-1)]
    dir=normalize(b.xy-previous.xy);side=vec2(-dir.y,dir.x)
    q=a.xy+side*f32(offset)
    vec3(q.x,a.z,q.y)

ensure_canal_traffic=(fleet:mut VesselFleet,owner:int,morning:bool=false):
    if not geography_enabled or owner<0:return
    # Stable identities survive visits, capture, damage and checkpoint restore.
    if vessel_index(fleet,CANAL_VESSEL_BASE)>=0:return
    if fleet.ships.len()+CANAL_VESSELS>VESSEL_LIMIT or fleet.lanes.len()+8>SEA_LANE_LIMIT:return
    loop slot in 0..15:
        kind=if slot%3==0 or slot==14:VesselKind.canal_barge else:if slot%3==1:VesselKind.canal_launch else:VesselKind.rowboat
        moored=slot>=6 or (morning and slot>=3)
        # (moored 5 m off the wall wherever the canal is; the last three in the basin: at its quays,
        # and one out on its water at a buoy)
        start=if slot<12:CANAL_BEGIN+8+slot*4 else:CANAL_BEGIN+[47,50,49][slot-12]
        berth=f64(RIVER_NODES[start].w)-5.0
        offset=if not moored:6.0 else:if slot==12:-berth else:if slot==14:-22.0 else:berth
        pos=canal_route_point(start,offset)
        next=canal_route_point(start+1,offset)
        yaw=atan2(f64(next.x-pos.x),f64(next.z-pos.z))
        lane_id= -1
        if not moored:
            # Closed loop, starboard lanes in each direction with broad end turns.
            # Starting each route at its own station avoids spawning hulls together.
            route:vec2[]
            loop j in start..CANAL_BEGIN+64:route.push(canal_route_point(j,6.0).xz)
            loop j in 0..60:route.push(canal_route_point(CANAL_BEGIN+63-j,-6.0).xz)
            loop j in CANAL_BEGIN+4..start+1:route.push(canal_route_point(j,6.0).xz)
            lane_id=fleet.next_lane;fleet.next_lane+=1
            fleet.lanes.push(SeaLane(lane_id,CANAL_CITY_ID,CANAL_CITY_ID,pos.xz,pos.xz,2.0,3.0,status=.ready,points=route,levels=[loop p in route:f32(water_at(f64(p.x),f64(p.y)).level)],repeat=true))
        assert(spawn_vessel(fleet,Vessel(id=CANAL_VESSEL_BASE+slot,kind=kind,owner=owner,side=100,lane=lane_id,position=pos,yaw=yaw,status=if moored:.docked else:.underway,desired_speed=0.75)))
    loop slot in 15..CANAL_VESSELS:
        lane_id= -1
        if slot==15 or slot==16:
            route=if slot==15:canal_patrol_loop(61,80.0,90.0,1.0) else:canal_patrol_loop(65,80.0,90.0,-1.0)
            lane_id=fleet.next_lane;fleet.next_lane+=1
            fleet.lanes.push(SeaLane(lane_id,CANAL_CITY_ID,CANAL_CITY_ID,route[0],route[0],2.0,3.0,status=.ready,points=route,levels=[loop p in route:f32(water_at(f64(p.x),f64(p.y)).level)],repeat=true))
            pos=vec3(route[0].x,f32(water_at(f64(route[0].x),f64(route[0].y)).level),route[0].y)
            yaw=atan2(f64(route[1].x-route[0].x),f64(route[1].y-route[0].y))
            assert(spawn_vessel(fleet,Vessel(id=CANAL_VESSEL_BASE+slot,kind=.canal_launch,owner=owner,side=100,lane=lane_id,position=pos,yaw=yaw,status=.underway,desired_speed=0.9)))
            continue
        # (moored 5 m off the lagoon's far wall at 61 and 65 and off the river-side wall at 63; at
        # buoys out on its water at 62 and 64)
        station,across,kind,buoy=[(61,260.0,VesselKind.canal_barge,false),(65,260.0,VesselKind.canal_barge,false),(63,-13.0,VesselKind.canal_barge,false),
            (62,60.0,VesselKind.canal_barge,true),(64,170.0,VesselKind.rowboat,true)][slot-17]
        at=CANAL_BEGIN+station
        pos=canal_route_point(at,across)
        next=canal_route_point(at+1,across)
        if across>200.0:
            # The lagoon wall follows its straight arm, while the neighbouring
            # through-channel curves. Tie these barges parallel to the real wall.
            first=RIVER_NODES[CANAL_BEGIN+61].xy;last=RIVER_NODES[CANAL_BEGIN+66].xy
            axis=normalize(last-first)
            quay=first+(last-first)*f32(f64(station-61)/5.0)+vec2(-axis.y,axis.x)*f32(across)
            pos=vec3(quay.x,pos.y,quay.y);next=pos+vec3(axis.x,0,axis.y)
        yaw=atan2(f64(next.x-pos.x),f64(next.z-pos.z))+(if buoy:0.6 else:0.0)
        assert(spawn_vessel(fleet,Vessel(id=CANAL_VESSEL_BASE+slot,kind=kind,owner=owner,side=100,position=pos,yaw=yaw,status=.docked)))

sync_canal_traffic=(fleet:mut VesselFleet,w:mut data.World,morning:bool=false):
    if vessel_index(fleet,CANAL_VESSEL_BASE)>=0:return
    if CANAL_CITY_ID in w.far.districts:
        owner=residents.promote_far_person(w,CANAL_CITY_ID,.trader)
        ensure_canal_traffic(fleet,owner,morning)
