# Local hulls use the saved fleet and its one fixed-step motion/damage owner.
# No decorative traffic clock, imaginary cargo or duplicate living-world voyages.
use 'river_data.jo'
use 'river_field.jo'
use 'canal_geometry.jo'
use 'vessel_types.jo'
use 'vessels.jo'
use 'geography.jo'
import 'living_types.jo' as data
import 'living_far_people.jo' as residents
const CANAL_VESSEL_BASE=720000000

canal_route_point=(station:int,offset:f64)->vec3:
    a=RIVER_NODES[station];b=RIVER_NODES[min(station+1,CANAL_FINISH)]
    previous=RIVER_NODES[max(CANAL_BEGIN,station-1)]
    dir=normalize(b.xy-previous.xy);side=vec2(-dir.y,dir.x)
    q=a.xy+side*f32(offset)
    vec3(q.x,a.z,q.y)

ensure_canal_traffic=(fleet:mut VesselFleet,owner:int):
    if not geography_enabled or owner<0:return
    # Stable identities survive visits, capture, damage and checkpoint restore.
    if vessel_index(fleet,CANAL_VESSEL_BASE)>=0:return
    if fleet.ships.len()+12>VESSEL_LIMIT or fleet.lanes.len()+6>SEA_LANE_LIMIT:return
    loop slot in 0..12:
        kind=if slot%3==0:VesselKind.canal_barge else:if slot%3==1:VesselKind.canal_launch else:VesselKind.rowboat
        moored=slot>=6
        start=CANAL_BEGIN+8+slot*4
        pos=canal_route_point(start,if moored:13.0 else:6.0)
        next=canal_route_point(start+1,if moored:13.0 else:6.0)
        yaw=atan2(f64(next.x-pos.x),f64(next.z-pos.z))
        lane_id= -1
        if not moored:
            # Closed loop, starboard lanes in each direction with broad end turns.
            # Starting each route at its own station avoids spawning hulls together.
            route:vec2[]
            loop j in start..CANAL_BEGIN+64:route.push(canal_route_point(j,6.0).xz)
            loop j in 0..60:route.push(canal_route_point(CANAL_BEGIN+63-j,-6.0).xz)
            loop j in CANAL_BEGIN+4..start+1:route.push(canal_route_point(j,6.0).xz)
            lane_id=fleet.next_lane;fleet.next_lane+=1
            fleet.lanes.push(SeaLane(lane_id,CANAL_CITY_ID,CANAL_CITY_ID,pos.xz,pos.xz,2.0,3.0,status=.ready,points=route,repeat=true))
        assert(spawn_vessel(fleet,Vessel(id=CANAL_VESSEL_BASE+slot,kind=kind,owner=owner,side=100,lane=lane_id,position=pos,yaw=yaw,status=if moored:.docked else:.underway,desired_speed=0.75)))

sync_canal_traffic=(fleet:mut VesselFleet,w:mut data.World):
    if vessel_index(fleet,CANAL_VESSEL_BASE)>=0:return
    if CANAL_CITY_ID in w.far.districts:
        owner=residents.promote_far_person(w,CANAL_CITY_ID,.trader)
        ensure_canal_traffic(fleet,owner)
