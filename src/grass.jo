use 'terrain.jo'
use 'plants.jo'
use 'paint.jo'
use 'town_sites.jo'
use 'town_mesh.jo'
use 'terrain_lod.jo'
use 'settlements.jo'
use 'depth_space.jo'
# Short distributed meadow blades; persistent world-grid placement, shader wind and contact.

use 'quality.jo'
use 'render_space.jo'
use 'world.jo'
use 'look.jo'
use 'objects.jo'

const GRASS_RADIUS = 42.0
const GRASS_STEP = 1.0

struct GrassChunk:
    center: vec3
    radius: f32
    first: int
    count: int

grass_tile_key=(i:Instance3D)->int:
    int(floor(f64(i.model[3].x)/8.0))*1048576+int(floor(f64(i.model[3].z)/8.0))

struct GrassField:
    center: vec3
    buf: InstanceBuffer[Instance3D]
    count: int
    built = false
    chunks: GrassChunk[] = []
    cells: Instance3D[] = []
    road_stamp: int = 0
    resident_radius: f64 = 0.0

# Approved full-field fade. Geometry detail and shading have separate budgets.
grass_fade_range=(radius:f32)->vec2:
    vec2(max(1.0,radius-4.0),radius)

grass_curve_range=(radius:f32)->vec2:
    if radius<30.0:return vec2(5,8)
    vec2(8,12)

grass_vs = (v: Vertex3D, inst: Instance3D, u: GroundParams) -> ObjOut:
    root = (render_model(inst.model,u.origin) * vec4(v.uv.x,0,v.uv.y,1)).xyz
    tip = v.color.x
    range=grass_fade_range(u.grass_actor.w)
    edge=(vnoise((root.xz+u.origin.xz)*0.23)-0.5)*3.0
    fade = 1.0-smoothstep(range.x,range.y,length(root.xz-u.cam.xz)+edge)
    # A fully faded blade has zero area. Skip its wind/contact work as a unit;
    # every vertex shares the root and therefore takes the same branch.
    if fade<=0.0:return ObjOut(vec4(2,2,2,1),root,vec3(0,1,0),inst.color,vec3(0,0,0))
    w=render_model(inst.model,u.origin)*vec4(v.pos,1)
    curve=tip
    wave = meadow_wave(root.xz-(u.drift-u.origin.xz),u.wind)
    bend = curve*(0.06+0.34*wave)
    delta = root.xz-u.grass_actor.xz
    distance = length(delta)
    contact = (1.0-smoothstep(0.25,1.25,distance))*(1.0-smoothstep(0.5,2.5,abs(u.grass_actor.y-root.y)))
    away = delta/max(distance,0.1)
    offset = u.wind.xy*bend+away*contact*tip*0.3
    if u.grass_airflow.w>2.0:
        # A widening slipstream trails behind the propeller; low wings push
        # air outwards. Both weaken continuously with clearance and engine load.
        behind = -dot(delta,u.grass_airflow.xy)
        across = dot(delta,vec2(-u.grass_airflow.y,u.grass_airflow.x))
        width = u.grass_airflow.w*0.3+max(behind,0.0)*0.22
        cone = smoothstep(-2.0,1.0,behind)*(1.0-smoothstep(10.0,26.0,behind))*(1.0-smoothstep(width*0.45,width,abs(across)))
        wing = (1.0-smoothstep(1.0,u.grass_airflow.w,distance))*0.6
        clearance = 1.0-smoothstep(2.0,14.0,max(u.grass_actor.y-root.y,0.0))
        ripple = 0.78+0.22*sin(behind*2.5-u.time*18.0+across*0.7)
        contact = clamp((cone+wing)*clearance*u.grass_airflow.z*ripple,0.0,1.0)
        offset = u.wind.xy*bend+(-u.grass_airflow.xy*cone+away*wing)*clearance*u.grass_airflow.z*curve*0.55
    w = vec4(w.x+offset.x*fade,root.y+(w.y-root.y)*(1.0-contact*0.8)*fade-bend*0.18*fade,w.z+offset.y*fade,1)
    drawn = render_warped(w.xyz,u.cam,u.warp_a,u.warp_b)
    normal = normalize(vec3(-inst.model[0].y,1,-inst.model[2].y))
    clip=u.view_proj*vec4(drawn,1)
    gi=GroundOut(clip,w.xyz,normal,inst.color)
    strata=vec3(0,0,0)
    if 1.0-normal.y>0.28:strata=ground_strata(gi,u)
    col=ground_surface(gi,u,abs(w.x+u.origin.x)>20000.0 or abs(w.z+u.origin.z)>20000.0,false,0.01,strata,0.08,0.015)
    ObjOut(clip,w.xyz,normal,col,vec3(tip,fade,wave))

# The blades use the terrain's material and lighting, including its colour bands.
# This also carries the distant wind wash after the geometry has faded away.
grass_fs = (i: ObjOut,u: GroundParams) -> vec4:
    col = i.color*vec4(vec3(paint_paper(i.pos.xy)),1)
    # Preserve the terrain's actual pigment bands. Root occlusion is cooler;
    # the translucent upper blade is lighter and warmer within the same pigment.
    lit=col.xyz*meadow_blade_tint(i.surface.x,i.surface.z)
    mass=col.xyz*meadow_mass_tint(i.world-u.cam,i.surface.z)
    vec4(mix(mass,lit,smoothstep(0.0,0.7,i.surface.y)),1)


grass_sh: Shader

# One opaque triangle per blade. Spend the vertex budget on spatial density.
grass_blade_count=()->int:
    density=env("AEGEAN_GRASS_DENSITY") ?? ""
    if density=="dense":return 3072
    count=to_int(density) ?? 0
    if count>0:return clamp(count/24,1,128)*24
    if render_quality.tier==0:72 else:if render_quality.tier==1:216 else:3072

grass_visible_blades=0

grass_draw_radius=()->f32:
    f32(clamp(to_float(env("AEGEAN_GRASS_RADIUS") ?? "") ?? (if render_quality.tier==0:8.0 else:12.0),4.0,36.0))

build_tuft = (far:bool=false) -> Mesh:
    vs:Vertex3D[]
    blades=grass_blade_count()
    columns=if render_quality.tier==0:12 else:24
    loop k in 0..blades:
        angle=f64(k)*2.39996
        direction=vec3(f32(cos(angle)),0,f32(sin(angle)))
        side=vec3(-direction.z,0,direction.x)*f32(if render_quality.tier==0:0.042 else:if render_quality.tier==1:0.026 else:0.009)
        base=vec3((f32(k%columns)+hash21(vec2(f32(k),3)))/f32(columns)-0.5,0,(f32(k/columns)+hash21(vec2(f32(k),9)))/f32(blades/columns)-0.5)
        height=f32(0.30+0.25*f64(hash21(vec2(f32(k),7))))
        tip=base+vec3(0,height,0)+direction*0.11
        loop q in 0..3:
            t=if q==2:1.0 else:0.0
            point=if q==0:base-side else:if q==1:base+side else:tip
            vs.push(Vertex3D(point,vec3(0,1,0),base.xz,vec4(f32(t),0,0,f32(t))))
    town_mesh(vs)

# where grass grows: gentle ground above the beach, green rather than bare (as the ground's
# shader decides), and not on a quay or in a house
grass_cover = (towns: Town[], x: f64, z: f64) -> f64:
    p = vec2(f32(x),f32(z))
    farm=settlement_farm_cover(p)
    # Preserve main's settlement clearing budget. The new plot mask only
    # removes blades inside real yard bounds; it does not enlarge the clearing.
    if farm==0 or settlement_urban(p) or (farm<0 and settlement_on_road(p)):return 0.0
    # Keep a blade-width margin around old town plots and quay shoulders.
    loop tw in towns:
        if length(tw.center.xz-p)>400.0:continue
        loop site in tw.sites:
            q=site_local(site,p)
            if abs(q.x)<f32(site.width*0.5+4.0) and abs(q.y)<f32(site.depth*0.5+5.0):return 0.0
        loop quay in tw.quays:
            d=quay.b-quay.a
            nearest=quay.a+d*clamp(dot(p-quay.a,d)/max(dot(d,d),0.01),0.0,1.0)
            if length(p-nearest)<quay.width*0.5+1.5:return 0.0
    h = height(x, z)
    if h < 3.0: return 0.0
    # Only actual raised geometry excludes blades. The meshed terrain itself
    # can stand above the ecological height source on ordinary rolling hills.
    if walk_height(towns, x, z) > surface_height(x,z) + 0.2: return 0.0
    return grass_hillside_cover(x,z)*smoothstep(3.0,6.0,h)

# Match the drawn hillside rather than fine ecological height steps. A six-metre
# footprint carries the normal smoothly across canonical triangle boundaries.
# The thresholds use 1-normal.y, exactly the terrain meadow material's slope.
grass_hillside_cover=(x:f64,z:f64)->f64:
    gx=(surface_height(x+3.0,z)-surface_height(x-3.0,z))/6.0
    gz=(surface_height(x,z+3.0)-surface_height(x,z-3.0))/6.0
    slope=1.0-1.0/sqrt(1.0+gx*gx+gz*gz)
    1.0-smoothstep(0.15,0.4,slope)

# Keep the full noisy draw disk plus camera offset and the 12 m movement
# reserve. Whole-metre radii keep every rebuild on the same world-root lattice.
# Retain the old maximum for distant orbit/aircraft views.
grass_resident_radius=(center:vec3,eye:vec3)->f64:
    min(render_quality.grass_radius+16.0,ceil(f64(grass_draw_radius())+16.0+f64(length(eye.xz-center.xz))))

grass_needs_refresh=(f:GrassField,center:vec3,eye:vec3)->bool:
    if not f.built or length(f.center.xz-center.xz)>12.0 or f.road_stamp!=grass_road_stamp(f.center.xz):return true
    # A camera orbit/zoom may leave a reduced resident field even while the
    # actor stands still. Grow it before the visible disk reaches its edge.
    f.resident_radius<render_quality.grass_radius+16.0 and f64(length(eye.xz-f.center.xz))+f64(grass_draw_radius())+3.0>f.resident_radius

build_grass = (towns: Town[], center: vec3) -> GrassField:
    list: Instance3D[]
    lanes=grass_road_lanes(center.xz,render_quality.grass_radius+18.0)
    loop tw in towns:
        if length(tw.center.xz-center.xz)>500.0:continue
        lanes.extend(site_lanes(tw.sites))
        tangent=vec2(-tw.out.y,tw.out.x)
        loop k in 0..tw.houses.len():
            front=tw.houses[k].xz+tw.out*8.0
            lanes.push(TownLane(front-tangent*6.0,front+tangent*6.0,2.0))
            if k>0:
                prev=tw.houses[k-1].xz+tw.out*8.0
                if length(prev-front)<25.0:lanes.push(TownLane(prev,front,2.0))
    radius = grass_resident_radius(center,scene_camera())
    n = int(radius * 2.0 / GRASS_STEP)
    cx = floor(f64(center.x) / GRASS_STEP) * GRASS_STEP
    cz = floor(f64(center.z) / GRASS_STEP) * GRASS_STEP
    loop j in 0..n:
        loop i in 0..n:
            gx = cx + (f64(i) - f64(n) * 0.5) * GRASS_STEP
            gz = cz + (f64(j) - f64(n) * 0.5) * GRASS_STEP
            x = gx
            z = gz
            d = sqrt((x - f64(center.x)) ^ 2.0 + (z - f64(center.z)) ^ 2.0)
            if d > radius: continue
            if not grass_lane_clear(vec2(f32(x),f32(z)),lanes):continue
            k = grass_cover(towns, x, z)
            if k < 0.001: continue
            h = surface_height(x, z)
            hx = (surface_height(x+0.5,z)-surface_height(x-0.5,z))
            hz = (surface_height(x,z+0.5)-surface_height(x,z-0.5))
            m = translation(vec3(f32(x),f32(h-0.025),f32(z)))
            m[1]=vec4(0,f32(k),0,0)
            m[0]=vec4(1,f32(hx),0,0);m[2]=vec4(0,f32(hz),1,0)
            island=island_at(x,z)
            seed=if island>=0:ISLANDS[island].seed else:0.0
            tint=vec4(f32(fbm(x*0.004+seed,z*0.004,3)),f32(noise(x*0.0011-seed,z*0.0011)),f32(ridge_at(x,z)*0.5+0.5),1)
            list.push(Instance3D(m,tint))

    # Stable 8 m batches retain all blades but avoid vertex work outside the view.
    list.sort(grass_tile_key)
    chunks: GrassChunk[]
    start=0
    loop start<list.len():
        key=grass_tile_key(list[start]);finish=start+1
        lo=list[start].model[3].xyz;hi=lo
        loop finish<list.len() and grass_tile_key(list[finish])==key:
            at=list[finish].model[3].xyz;lo=min(lo,at);hi=max(hi,at);finish+=1
        chunks.push(GrassChunk((lo+hi)*0.5,length(hi-lo)*0.5+3.0,start,finish-start))
        start=finish
    GrassField(center, instance_buffer(list), list.len(), true,chunks,list,grass_road_stamp(center.xz),radius)

grass_actor = vec3(0,0,0)
grass_contact_radius: f32 = 1.2
# Heading (x,z), strength: supplied by the simulation, never inferred from camera.
grass_airflow = vec3(0,-1,0)

draw_grass = (tuft: Mesh, f: GrassField, L: Light, t: f64):
    global grass_visible_blades
    grass_visible_blades=0
    if not f.built or f.count == 0: return
    # A stale field after departure must not spend vertex work behind the aircraft.
    camera=scene_camera()
    if length(camera.xz-f.center.xz)>f32(render_quality.grass_radius*2.0+16.0) or camera.y-f.center.y>80.0:return
    p = obj_params(L,t,sway=1.0)
    gp = GroundParams(p.view_proj,p.cam,p.sun_dir,p.sun,p.sky,p.shade,p.haze,p.fog,p.time,p.wind,p.drift+p.origin.xz,p.origin,p.pigment,p.pigment,vec4(0,0,0,0),p.warp_a,p.warp_b,p.pigment)
    gp.grass_actor = vec4(grass_actor-p.origin,grass_draw_radius())
    gp.grass_airflow = vec4(grass_airflow,grass_contact_radius)
    if gp.warp_b.x>0.0:
        draw_instanced(grass_sh,tuft,f.buf,gp)
        return
    planes=land_planes(gp.view_proj)
    # Bound the actual root footprint, tip lean, widest blade and maximum wind
    # displacement. Airflow adds its own larger bound; terrain tilt is per cell.
    contact_reach=if gp.grass_airflow.w>2.0:(length(gp.grass_airflow.xy)+0.6)*abs(gp.grass_airflow.z)*0.55 else:0.3
    horizontal=0.68+0.468*length(gp.wind.xy)+contact_reach
    # Reject coarse tiles first, then upload only visible one-metre cells.
    # Keep their order front-to-back in a single instanced draw.
    visible_cells:Instance3D[]
    far_cells:Instance3D[]
    loop chunk in f.chunks:
        center=render_world(chunk.center-gp.origin,gp.cam)
        if length(center.xz-gp.cam.xz)-chunk.radius>grass_fade_range(gp.grass_actor.w).y+1.5:continue
        visible=true
        loop plane in planes:
            if dot(plane.xyz,center)+plane.w < -chunk.radius:visible=false
        if not visible:continue
        loop k in chunk.first..chunk.first+chunk.count:
            cell=f.cells[k]
            at=render_world(cell.model[3].xyz-gp.origin,gp.cam)
            # The blade roots occupy a square of half-width 0.5 m. Fade
            # depends on root distance, not the displaced tip's position.
            if length(at.xz-gp.cam.xz)>grass_fade_range(gp.grass_actor.w).y+2.21:continue
            extent=vec3(horizontal,0.66*(abs(cell.model[0].y)+abs(cell.model[2].y))+0.66,horizontal)
            keep=true
            loop plane in planes:
                if dot(plane.xyz,at)+plane.w < -dot(abs(plane.xyz),extent):keep=false
            if keep:
                if length(at.xz-gp.cam.xz)-0.71>=grass_curve_range(gp.grass_actor.w).y:far_cells.push(cell)
                else:visible_cells.push(cell)
    visible_cells.sort((cell:Instance3D)->f32:dot(cell.model[3].xyz-camera,cell.model[3].xyz-camera))
    far_cells.sort((cell:Instance3D)->f32:dot(cell.model[3].xyz-camera,cell.model[3].xyz-camera))
    grass_visible_blades=(visible_cells.len()+far_cells.len())*grass_blade_count()
    global grass_visible_buf,grass_far_buf
    if visible_cells.len()>0:
        set_instances(grass_visible_buf,visible_cells)
        draw_instanced(grass_sh,tuft,grass_visible_buf,gp)
    if far_cells.len()>0:
        set_instances(grass_far_buf,far_cells)
        draw_instanced(grass_sh,grass_far_mesh,grass_far_buf,gp)


grass_visible_buf:InstanceBuffer[Instance3D]
grass_far_buf:InstanceBuffer[Instance3D]
grass_far_mesh:Mesh

init_grass = ():
    global grass_sh,grass_visible_buf,grass_far_buf,grass_far_mesh
    empty:Instance3D[]
    grass_visible_buf=instance_buffer(empty)
    grass_far_buf=instance_buffer(empty)
    grass_far_mesh=build_tuft(true)
    grass_sh = make_world_shader(shader(grass_vs, grass_fs))

# Test the whole patch footprint, including the sideways reach of a bent blade.
grass_lane_clear=(p:vec2,lanes:TownLane[])->bool:
    loop lane in lanes:
        d=lane.b-lane.a
        nearest=lane.a+d*clamp(dot(p-lane.a,d)/max(dot(d,d),0.01),0.0,1.0)
        if length(p-nearest)<f32(lane.width*0.5+1.0):return false
    true

# Nearby road geometry is streamed after the first grass field. Its spatial bin
# already includes a 520 m shoulder, wider than any grass field. Invalidate only
# when that local list changes, and reserve each actual track plus blade reach.
grass_road_stamp = (p:vec2)->int: int(hash(settlement_road_bins.get(road_bin(p),[])))

grass_road_lanes = (center:vec2,radius:f64)->TownLane[]:
    result:TownLane[]
    loop id in settlement_road_bins.get(road_bin(center),[]):
        road=settlement_roads[id]
        loop k in 0..road.points.len()-1:
            a=road.points[k].xz;b=road.points[k+1].xz;d=b-a
            near=a+d*clamp(dot(center-a,d)/max(dot(d,d),0.01),0.0,1.0)
            if length(center-near)<f32(radius+road.width):result.push(TownLane(a,b,road.width))
    result
