use 'depth_space.jo'
# Tall grass around someone on foot: tufts of blades on the gentle, green ground near them, bent
# by the wind in waves as the gusts pass. Rebuilt around them as they walk.

use 'quality.jo'
use 'render_space.jo'
use 'world.jo'
use 'look.jo'
use 'objects.jo'

const GRASS_RADIUS = 42.0
const GRASS_STEP = 1.0

struct GrassField:
    center: vec3
    buf: InstanceBuffer[Instance3D]
    count: int
    built = false

grass_vs = (v: Vertex3D, inst: Instance3D, u: ObjParams) -> ObjOut:
    w = render_model(inst.model,u.origin) * vec4(v.pos, 1)
    hgt = max(v.pos.y, 0.0)
    g = gust(w.xz, u.drift)
    bend = hgt * hgt * (0.06 + 0.05 * u.wind.z) * (0.25 + 0.95 * g)
    ph = u.sway_phase.z + w.x * 0.4 + w.z * 0.3
    flutter = hgt * hgt * 0.05 * sin(ph) * (0.4 + g)
    w = w + vec4(u.wind.x * (bend + flutter), -bend * 0.35, u.wind.y * (bend + flutter), 0)
    # bent blades catch the light: paler in a gust
    c = v.color * inst.color
    c = vec4(mix(c.xyz, c.xyz * vec3(1.3, 1.28, 1.1), clamp(g * hgt * 1.2, 0.0, 1.0) * 0.6), c.w)
    ObjOut(u.view_proj * w, w.xyz, (inst.model * vec4(v.normal, 0)).xyz, c)

grass_sh: Shader

build_tuft = () -> Mesh:
    vs: Vertex3D[]
    loop k in 0..6:
        a = f64(k) / 6.0 * TAU + f64(k) * 0.7
        lean = 0.12 + 0.05 * f64(k % 3)
        d = vec3(f32(cos(a)), 0, f32(sin(a)))
        side = vec3(-d.z, 0, d.x) * 0.07
        hgt = f32(0.6 + 0.12 * f64(k % 4))
        base = d * 0.08
        tip = d * f32(lean + 0.1) + vec3(0, hgt, 0)
        low = vec4(0.16, 0.3, 0.1, 1)
        top = vec4(0.62, 0.66, 0.32, 1)
        n = normalize(vec3(d.x * 0.3, 1.0, d.z * 0.3))
        loop flip in [false, true]:
            p0 = base - side
            p1 = base + side
            if flip:
                vs.push(Vertex3D(p1, n, vec2(0, 0), low)); vs.push(Vertex3D(p0, n, vec2(0, 0), low)); vs.push(Vertex3D(tip, n, vec2(0, 0), top))
            else:
                vs.push(Vertex3D(p0, n, vec2(0, 0), low)); vs.push(Vertex3D(p1, n, vec2(0, 0), low)); vs.push(Vertex3D(tip, n, vec2(0, 0), top))
    custom_mesh(vs)

# where grass grows: gentle ground above the beach, green rather than bare (as the ground's
# shader decides), and not on a quay or in a house
grass_cover = (towns: Town[], x: f64, z: f64) -> f64:
    h = height(x, z)
    if h < 3.0: return 0.0
    if walk_height(towns, x, z) > h + 0.2: return 0.0
    sl = slope_at(x, z)
    if sl > 0.6: return 0.0
    r = ridge_at(x, z)
    dens = fbm(x * 0.03, z * 0.03, 2) * 1.3 - 0.15 + r * 0.15
    edge = if sl > 0.4 and h > 9.0: smoothstep(0.5,0.75,fbm(x*0.35,z*0.35,2))*0.4 else: 0.0
    clamp(dens, 0.0, 1.0) * max(edge,1.0 - smoothstep(0.3, 0.45, sl)) * (1.0-smoothstep(0.52,0.6,sl))*smoothstep(3.0, 6.0, h)

build_grass = (towns: Town[], center: vec3) -> GrassField:
    list: Instance3D[]
    radius = render_quality.grass_radius
    n = int(radius * 2.0 / GRASS_STEP)
    cx = floor(f64(center.x) / GRASS_STEP) * GRASS_STEP
    cz = floor(f64(center.z) / GRASS_STEP) * GRASS_STEP
    loop j in 0..n:
        loop i in 0..n:
            gx = cx + (f64(i) - f64(n) * 0.5) * GRASS_STEP
            gz = cz + (f64(j) - f64(n) * 0.5) * GRASS_STEP
            # (a fixed jitter per grid point, so the field does not change as it is rebuilt)
            jx = f64(hash21(vec2(f32(gx * 0.7), f32(gz * 1.3)))) - 0.5
            jz = f64(hash21(vec2(f32(gz * 0.9 + 3.0), f32(gx * 1.1)))) - 0.5
            x = gx + jx * GRASS_STEP
            z = gz + jz * GRASS_STEP
            d = sqrt((x - f64(center.x)) ^ 2.0 + (z - f64(center.z)) ^ 2.0)
            if d > radius: continue
            k = grass_cover(towns, x, z)
            if k < 0.25: continue
            s = (0.6 + 0.7 * k) * (1.0 - smoothstep(radius * 0.7, radius, d))
            if s < 0.15: continue
            h = surface_height(x, z)
            tone = f32(0.85 + 0.3 * f64(hash21(vec2(f32(x), f32(z)))))
            m = translation(vec3(f32(x), f32(h - 0.05), f32(z))) * rotation_y(jx * 9.0) * scaling(vec3(f32(s), f32(s * (0.8 + 0.5 * k)), f32(s)))
            list.push(Instance3D(m, vec4(tone, tone, tone * 0.95, 1)))
    GrassField(center, instance_buffer(list), list.len(), true)

draw_grass = (tuft: Mesh, f: GrassField, L: Light, t: f64):
    if not f.built or f.count == 0: return
    draw_world_instanced(grass_sh, tuft, f.buf, obj_params(L, t, sway = 1.0))

init_grass = ():
    global grass_sh
    grass_sh = make_world_shader(shader(grass_vs, obj_fs))
