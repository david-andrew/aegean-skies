use 'water_field.jo'
use 'thermal_sites.jo'
use 'airfields.jo'
use 'working_land_contact.jo'
use 'water_types.jo'
use 'terrain.jo'
use 'plants.jo'
use 'paint.jo'
use 'canopy.jo'
use 'town_sites.jo'
use 'town_mesh.jo'
use 'terrain_lod.jo'
use 'settlements.jo'
use 'depth_space.jo'
# Short distributed meadow blades; persistent world-grid placement, shader wind and contact.

use 'quality.jo'
use 'render_space.jo'
use 'world.jo'
use 'look.jo'
use 'objects.jo'
use 'world_source.jo'
use 'geography.jo'
use 'world_terrain.jo'

const GRASS_RADIUS = 42.0
const GRASS_STEP = 1.0

struct GrassOut:
    pos:vec4
    color:vec4

struct GrassCell:
    model:mat4
    color:vec4
    material:vec4 # normal.xyz, orchard coverage

struct GrassChunk:
    center: vec3
    radius: f32
    first: int
    count: int

grass_tile_key=(i:GrassCell)->int:
    int(floor(f64(i.model[3].x)/8.0))*1048576+int(floor(f64(i.model[3].z)/8.0))

struct GrassField:
    center: vec3
    buf: InstanceBuffer[GrassCell]
    count: int
    built = false
    chunks: GrassChunk[] = []
    cells: GrassCell[] = []
    road_stamp: int = 0
    resident_radius: f64 = 0.0
    material_ready: bool = true

# The drawn region is an egg stretched along the view: it reaches `reach` ahead of the camera, a short way
# behind and `view.z` to each side. view = (look x, look z, side reach, behind reach). The result is 1.0 on
# the egg's rim (a normalized distance), so one scale carries culling, thinning and the near/far split.
grass_shape = (delta: vec2, view: vec4, reach: f32) -> f32:
    along = dot(delta, view.xy)
    across = dot(delta, vec2(-view.y, view.x)) / view.z
    ahead = along / mix(view.w, reach, step(0.0, along))
    sqrt(ahead * ahead + across * across)

# Share of the blades still standing at normalized distance d: all of them to 0.30, none at the rim.
grass_keep = (d: f32) -> f32: 1.0 - smoothstep(0.30, 1.0, d)

# Past this normalized distance a cell is drawn with the cheaper far tuft (fewer, wider blades).
const GRASS_FAR_START = 0.5

grass_vs = (v: Vertex3D, inst: GrassCell, u: GroundParams) -> GrassOut:
    # Every cell turns its tuft by its own angle, so the blades never fall on a one-metre lattice (rows, combs).
    cell = inst.model[3].xz
    cell = cell-floor(cell/4096.0)*4096.0
    angle = hash21(cell*0.37+vec2(11,5))*6.2832
    cs = cos(angle)
    sn = sin(angle)
    uv = vec2(v.uv.x*cs-v.uv.y*sn,v.uv.x*sn+v.uv.y*cs)
    pos = vec3(v.pos.x*cs-v.pos.z*sn,v.pos.y,v.pos.x*sn+v.pos.z*cs)
    root = (render_model(inst.model,u.origin) * vec4(uv.x,0,uv.y,1)).xyz
    tip = v.color.x
    # Clumps: blades gather toward the centres of a jittered ~0.9 m world lattice, and each clump has its
    # own height, lean and tint. The lattice is not the cell grid, so no row of clumps lines up either.
    clump_cell = floor((root.xz+u.origin.xz)*1.1)
    clump_id = clump_cell-floor(clump_cell/4096.0)*4096.0
    clump_at = (clump_cell+vec2(hash21(clump_id+vec2(1,2)),hash21(clump_id+vec2(5,9))))/1.1-u.origin.xz
    clump = hash21(clump_id*1.3+vec2(17,3))
    gather = (clump_at-root.xz)*0.2
    root = vec3(root.x+gather.x,root.y,root.z+gather.y)
    # Thinning by distance along the egg: each blade has its own threshold and shrinks away when the
    # field's density falls below it, so the field thins out like a scatter, never as a ring.
    d = grass_shape(root.xz-u.cam.xz,u.grass_view,u.grass_actor.w)+(vnoise((root.xz+u.origin.xz)*0.23)-0.5)*0.12
    keep = grass_keep(d)
    pick = hash21(cell*1.7+v.uv*41.0+vec2(5,9))
    pick2 = fract(pick*7.31+clump)
    fade = smoothstep(0.0,0.25,keep*1.25-pick)
    size = fade*(0.5+0.5*keep)
    # A fully shrunk blade has zero area. Skip its wind/contact work as a unit;
    # every vertex shares the root and therefore takes the same branch.
    if size<=0.0:return GrassOut(vec4(2,2,2,1),vec4(0,0,0,0))
    w=render_model(inst.model,u.origin)*vec4(pos,1)
    w=vec4(w.x+gather.x,w.y,w.z+gather.y,1)
    # per-blade and per-clump height
    w.y = root.y+(w.y-root.y)*(0.8+0.4*clump)*(0.85+0.3*pick2)
    curve=tip
    wave = meadow_wave(root.xz,u.grass_gust,u.drift,u.wind.z,u.grass_spring,u.grass_lag)
    lean = meadow_lean(u.wind.z)
    # A small flutter per blade (a few percent of the steady lean) so neighbours never move in lockstep.
    flutter = 0.08*sin(u.time*(4.0+3.0*pick)+pick*40.0)
    # lean: each blade and clump leans a little more or less, and a little off the wind's line
    sway = (0.6+0.8*pick2)*(0.85+0.3*clump)
    # The blade is a damped spring driven by the wave field (the gains and phase lags are in the field itself)
    bend = curve*sway*(lean.x*(1.0+flutter)+lean.y*wave)
    yaw = (pick-0.5)*0.9
    along = vec2(u.wind.x*cos(yaw)-u.wind.y*sin(yaw),u.wind.x*sin(yaw)+u.wind.y*cos(yaw))
    delta = root.xz-u.grass_actor.xz
    distance = length(delta)
    # The walker only brushes the blades its legs touch: a small radius, a few degrees of lean away and a slight
    # squash; the blades keep waving with the wind. (The aircraft's wash below replaces this.)
    contact = (1.0-smoothstep(0.1,0.42,distance))*(1.0-smoothstep(0.5,1.2,abs(u.grass_actor.y-root.y)))
    away = delta/max(distance,0.1)
    offset = along*bend+away*contact*tip*0.07
    squash = 0.15
    if u.grass_airflow.w>2.0:
        # A widening slipstream trails behind the propeller; low wings push
        # air outwards. Both weaken continuously with clearance and engine load.
        behind = -dot(delta,u.grass_airflow.xy)
        across = dot(delta,vec2(-u.grass_airflow.y,u.grass_airflow.x))
        width = u.grass_airflow.w*0.3+max(behind,0.0)*0.22
        cone = smoothstep(-2.0,1.0,behind)*(1.0-smoothstep(10.0,26.0,behind))*(1.0-smoothstep(width*0.45,width,abs(across)))
        wing = (1.0-smoothstep(1.0,u.grass_airflow.w,distance))*0.6
        clearance = 1.0-smoothstep(2.0,14.0,max(u.grass_actor.y-root.y,0.0))
        ripple = 0.78+0.22*sin(behind*2.5-u.time*18.0+across*0.7)
        contact = clamp((cone+wing)*clearance*u.grass_airflow.z*ripple,0.0,1.0)
        squash = 0.8
        offset = along*bend+(-u.grass_airflow.xy*cone+away*wing)*clearance*u.grass_airflow.z*curve*0.55
    rel = w.xz-root.xz
    w = vec4(root.x+(rel.x+offset.x)*size,root.y+((w.y-root.y)*(1.0-contact*squash)-bend*0.18)*size,root.z+(rel.y+offset.y)*size,1)
    drawn = render_warped(w.xyz,u.cam,u.warp_a,u.warp_b)
    normal = inst.material.xyz
    clip=u.view_proj*vec4(drawn,1)
    # Use the terrain normal and material at the root for diffuse lighting.
    # Blade normals never reclassify a sage slope as a dark vertical facet.
    ground_normal=vec3(-inst.model[0].y,1,-inst.model[2].y)
    grazing=1.0-smoothstep(0.20,0.55,abs(dot(ground_normal,root-u.cam))/max(length(root.xz-u.cam.xz),0.1))
    visible_mean=mix(u.flow.w,0.95,grazing*0.8)
    response=meadow_blade_response(tip,fade*smoothstep(0.0,0.5,keep),visible_mean)
    # Project only the pigment wash; lighting still uses the root terrain normal.
    ray=w.xyz-u.cam
    projection=clamp(dot(ground_normal,root-u.cam)/min(dot(ground_normal,ray),-0.001),1.0,4.0)
    shade_point=u.cam+ray*projection
    # The ground under the blades is lit by the fine relief normal (the terrain's coast-patch path); take the
    # same one, sampled at the blade's root, so hill shading and soft sun shadows carry through the field.
    # The terrain adds its surface detail's slope to the broad normal (coast_gpu_normal); the cell carries that
    # detail slope in the spare w of its model columns, so the blade is lit like the ground under its root.
    relief_normal=normalize(vec3(normal.x-inst.model[0].w*normal.y,normal.y,normal.z-inst.model[2].w*normal.y))
    gi=GroundOut(clip,shade_point,normal,inst.color,inst.material.w,0.0,relief_normal)
    strata=vec3(0,0,0)
    if 1.0-normal.y>0.28:strata=ground_strata(gi,u)
    col=ground_surface(gi,u,abs(root.x+u.origin.x)>20000.0 or abs(root.z+u.origin.z)>20000.0,true,0.01,strata,0.08,0.015,response)
    # clump-to-clump tint, fading out with the field so the rim keeps the ground's own colour
    tint = mix(vec3(0.95,0.975,0.93),vec3(1.05,1.03,0.985),clump)
    GrassOut(clip,vec4(col.xyz*mix(vec3(1,1,1),tint,smoothstep(0.0,0.5,keep)),col.w))

# The blades use the terrain's material and lighting, including its colour bands.
# This also carries the distant wind wash after the geometry has faded away.
grass_fs = (i: GrassOut,u: GroundParams) -> vec4:
    # Material, gradient and wind are vertex work; opaque fragments only add
    # the same screen-space paper grain as the underlying ground.
    i.color*vec4(vec3(paint_paper(i.pos.xy)),1)


grass_sh: Shader

# One opaque triangle per blade. The blades are twice the old size (height and width), so a third of the
# old count covers more ground; the saved triangles go into the longer reach ahead of the walker.
grass_blade_count=()->int:
    density=env("AEGEAN_GRASS_DENSITY") ?? ""
    if density=="dense":return 1024
    count=to_int(density) ?? 0
    if count>0:return clamp(count/72,1,128)*24
    if render_quality.tier==0:24 else:if render_quality.tier==1:72 else:1024

grass_visible_blades=0

# The far tuft: fewer, wider blades of the same height, for cells beyond GRASS_FAR_START.
grass_far_blade_count=()->int:
    blades=grass_blade_count()
    far=if blades==24:12 else:if blades==72:36 else:if blades==1024:506 else:max(6,blades/2)
    max(4,int(f64(far)*(to_float(env("AEGEAN_GRASS_FAR") ?? "") ?? 1.0)))

# The base radius of the drawn region (8/11/12 m by tier, the old disc's). The egg reaches 2.5 times as far
# ahead, `grass_side_scale` times to each side and `grass_back_scale` behind.
grass_draw_radius=()->f32:
    f32(clamp(to_float(env("AEGEAN_GRASS_RADIUS") ?? "") ?? (if render_quality.tier==0:8.0 else:if render_quality.tier==1:11.0 else:12.0),4.0,36.0))
grass_ahead_scale=()->f32:f32(clamp(to_float(env("AEGEAN_GRASS_AHEAD") ?? "") ?? 2.5,1.0,6.0))
# AEGEAN_GRASS_HIDE=1 draws no grass; AEGEAN_GRASS_FAR=x scales the far tuft's blade count (cost experiments)
grass_hidden=env("AEGEAN_GRASS_HIDE")!=none
const GRASS_SIDE_SCALE=1.2
const GRASS_BACK_SCALE=0.8
grass_forward_reach=()->f32:grass_draw_radius()*grass_ahead_scale()

# The egg for a camera looking along `look` (3D unit vector). Looking steeply down (from the air, or at the
# feet) there is no "ahead": the egg relaxes toward a disc a little wider than the base radius.
grass_view_shape=(look:vec3)->vec4:
    radius=grass_draw_radius()
    flat=length(look.xz)
    aim=if flat>0.0001:look.xz/flat else:vec2(0,1)
    level=smoothstep(0.25,0.75,flat)
    disc=radius*1.1
    vec4(aim.x,aim.y,mix(disc,radius*GRASS_SIDE_SCALE,level),mix(disc,radius*GRASS_BACK_SCALE,level))
grass_reach_for=(look:vec3)->f32:
    radius=grass_draw_radius()
    mix(radius*1.1,radius*grass_ahead_scale(),smoothstep(0.25,0.75,length(look.xz)))

# Rows and columns of a blade grid for n blades: the factor pair nearest a square.
grass_columns=(n:int)->int:
    best=1
    loop c in 1..n+1:
        if n%c==0 and abs(f64(c)-sqrt(f64(n)))<abs(f64(best)-sqrt(f64(n))):best=c
    best

build_tuft = (far:bool=false) -> Mesh:
    vs:Vertex3D[]
    blades=if far:grass_far_blade_count() else:grass_blade_count()
    columns=grass_columns(blades)
    rows=blades/columns
    # twice the old height and half-width; the far tuft's blades are half again as wide
    half=f32(if render_quality.tier==0:0.084 else:if render_quality.tier==1:0.045 else:0.018)*(if far:1.5 else:1.0)
    loop k in 0..blades:
        angle=f64(k)*2.39996
        direction=vec3(f32(cos(angle)),0,f32(sin(angle)))
        side=vec3(-direction.z,0,direction.x)*half
        base=vec3((f32(k%columns)+hash21(vec2(f32(k),if far:5 else:3)))/f32(columns)-0.5,0,(f32(k/columns)+hash21(vec2(f32(k),if far:11 else:9)))/f32(rows)-0.5)
        height=f32(0.60+0.50*f64(hash21(vec2(f32(k),7))))
        tip=base+vec3(0,height,0)+direction*0.22
        loop q in 0..3:
            t=if q==2:1.0 else:0.0
            point=if q==0:base-side else:if q==1:base+side else:tip
            vs.push(Vertex3D(point,vec3(0,1,0),base.xz,vec4(f32(t),0,0,f32(t))))
    town_mesh(vs)

# where grass grows: gentle ground above the beach, green rather than bare (as the ground's
# shader decides), and not on a quay or in a house
# Grass is built on the main thread. Share the bounded, exact source memo used
# by trees and walking instead of reconstructing the same 8 m corners for
# every metre of grass, its coverage slope and its five contact samples.
grass_cached_land = (x:f64,z:f64)->bool: geography_enabled and (abs(x)>=LEGACY_RESERVE or abs(z)>=LEGACY_RESERVE)
grass_ecology_height = (x:f64,z:f64)->f64: if grass_cached_land(x,z):world_source_sample(x,z).0 else:height(x,z)
# Each root's six-metre coverage and half-metre normal reuse samples from
# neighboring roots. Memoize the exact half-metre lattice too, so a new strip
# computes roughly three fine contact samples per cell rather than nine.
const GRASS_HEIGHT_EDGE=256
struct GrassHeight:
    x:int
    z:int
    revision = -1
    height:f64
grass_height_cells:GrassHeight[]
grass_height_misses=0
grass_surface_height = (x:f64,z:f64)->f64:
    global grass_height_cells,grass_height_misses
    if not grass_cached_land(x,z):return surface_height(x,z)
    hx=x*2.0;hz=z*2.0
    if hx!=floor(hx) or hz!=floor(hz):return world_source_surface(x,z)
    if grass_height_cells.len()==0:grass_height_cells=[loop i in 0..GRASS_HEIGHT_EDGE*GRASS_HEIGHT_EDGE:GrassHeight()]
    ix=int(hx);iz=int(hz)
    slot=(ix & (GRASS_HEIGHT_EDGE-1))+(iz & (GRASS_HEIGHT_EDGE-1))*GRASS_HEIGHT_EDGE
    old=grass_height_cells[slot]
    if old.x==ix and old.z==iz and old.revision==geography_revision:return old.height
    h=world_source_surface(x,z)
    grass_height_cells[slot]=GrassHeight(ix,iz,geography_revision,h);grass_height_misses+=1
    h
grass_hillside_slope=(x:f64,z:f64)->f64:
    gx=(grass_surface_height(x+3.0,z)-grass_surface_height(x-3.0,z))/6.0
    gz=(grass_surface_height(x,z+3.0)-grass_surface_height(x,z-3.0))/6.0
    1.0-1.0/sqrt(1.0+gx*gx+gz*gz)

# One bounded toroidal memo for the invariant terrain under one-metre cells.
# Reusing overlapping cells avoids reconstructing fine coast contact six times
# per cell on every 12 m refresh. Coverage/roads/paving are deliberately live.
const GRASS_TERRAIN_EDGE = 128
struct GrassTerrain:
    x: int
    z: int
    revision = -1
    ecology: f64
    slope: f64
    ground: f64
    dx: f64
    dz: f64
grass_terrain_cells: GrassTerrain[]
grass_terrain_misses = 0

grass_terrain_sample = (x:f64,z:f64)->GrassTerrain:
    h=grass_surface_height(x,z)
    GrassTerrain(int(floor(x)),int(floor(z)),geography_revision,grass_ecology_height(x,z),grass_hillside_slope(x,z),h,
        grass_surface_height(x+0.5,z)-grass_surface_height(x-0.5,z),grass_surface_height(x,z+0.5)-grass_surface_height(x,z-0.5))

grass_terrain = (x:f64,z:f64)->GrassTerrain:
    global grass_terrain_cells,grass_terrain_misses
    if not grass_cached_land(x,z) or x!=floor(x) or z!=floor(z):return grass_terrain_sample(x,z)
    if grass_terrain_cells.len()==0:grass_terrain_cells=[loop i in 0..GRASS_TERRAIN_EDGE*GRASS_TERRAIN_EDGE:GrassTerrain()]
    ix=int(x);iz=int(z)
    slot=(ix & (GRASS_TERRAIN_EDGE-1))+(iz & (GRASS_TERRAIN_EDGE-1))*GRASS_TERRAIN_EDGE
    old=grass_terrain_cells[slot]
    if old.x==ix and old.z==iz and old.revision==geography_revision:return old
    value=grass_terrain_sample(x,z)
    grass_terrain_cells[slot]=value;grass_terrain_misses+=1
    value

# The surface detail's own slope at a cell (the cell's metre-wide slope less its 14 m triangle's): what the terrain
# adds to its normal near the coast patches, carried to the blades so they are lit like the ground under them.
# Zero where the terrain has no such detail.
grass_detail_slope = (x:f64,z:f64,hx:f64,hz:f64)->vec2:
    if not grass_cached_land(x,z):return vec2(0,0)
    ax=floor(x/14.0)*14.0;az=floor(z/14.0)*14.0
    a=round(world_source_sample(ax,az).0*4096.0)/4096.0
    b=round(world_source_sample(ax+14.0,az).0*4096.0)/4096.0
    c=round(world_source_sample(ax,az+14.0).0*4096.0)/4096.0
    d=round(world_source_sample(ax+14.0,az+14.0).0*4096.0)/4096.0
    if not (min(min(a,b),min(c,d))<192.0 and max(max(a,b),max(c,d))>-10.0):return vec2(0,0)
    u=(x-ax)/14.0;v=(z-az)/14.0
    tx=if u+v<=1.0:(b-a)/14.0 else:(d-c)/14.0
    tz=if u+v<=1.0:(c-a)/14.0 else:(d-b)/14.0
    vec2(f32(hx-tx),f32(hz-tz))

grass_cover = (towns: Town[], x: f64, z: f64) -> f64:
    if thermal_paved(vec2(f32(x),f32(z))) or working_paved(vec2(f32(x),f32(z))) or airfield_mown(vec2(f32(x),f32(z))):return 0.0
    if water_at(x,z).wet:return 0.0
    p = vec2(f32(x),f32(z))
    farm=settlement_farm_cover(p)
    # Preserve main's settlement clearing budget. The new plot mask only
    # removes blades inside real yard bounds; it does not enlarge the clearing.
    if farm==0 or settlement_urban(p) or (farm<0 and settlement_on_road(p)):return 0.0
    # Keep a blade-width margin around old town plots and quay shoulders.
    loop tw in towns:
        if length(tw.center.xz-p)>400.0:continue
        loop site in tw.sites:
            q=site_local(site,p)
            if abs(q.x)<f32(site.width*0.5+4.0) and abs(q.y)<f32(site.depth*0.5+5.0):return 0.0
        loop quay in tw.quays:
            d=quay.b-quay.a
            nearest=quay.a+d*clamp(dot(p-quay.a,d)/max(dot(d,d),0.01),0.0,1.0)
            if length(p-nearest)<quay.width*0.5+1.5:return 0.0
    if grass_cached_land(x,z):
        cell=grass_terrain(x,z)
        if cell.ecology<3.0:return 0.0
        if walk_height_from_surface(towns,x,z,cell.ground)>cell.ground+0.2:return 0.0
        return (1.0-smoothstep(0.15,0.4,cell.slope))*smoothstep(3.0,6.0,cell.ecology)
    h = height(x, z)
    if h < 3.0: return 0.0
    # Only actual raised geometry excludes blades. The meshed terrain itself
    # can stand above the ecological height source on ordinary rolling hills.
    if walk_height(towns, x, z) > surface_height(x,z) + 0.2: return 0.0
    return grass_hillside_cover(x,z)*smoothstep(3.0,6.0,h)

# Match the drawn hillside rather than fine ecological height steps. A six-metre
# footprint carries the normal smoothly across canonical triangle boundaries.
# The thresholds use 1-normal.y, exactly the terrain meadow material's slope.
grass_hillside_cover=(x:f64,z:f64)->f64:
    1.0-smoothstep(0.15,0.4,grass_hillside_slope(x,z))

# Keep the full noisy draw disk plus camera offset and the 12 m movement
# reserve. Whole-metre radii keep every rebuild on the same world-root lattice.
# Retain the old maximum for distant orbit/aircraft views.
grass_resident_radius=(center:vec3,eye:vec3)->f64:
    min(render_quality.grass_radius+16.0,ceil(f64(grass_forward_reach())+16.0+f64(length(eye.xz-center.xz))))

grass_needs_refresh=(f:GrassField,center:vec3,eye:vec3)->bool:
    if not f.material_ready and grass_ground_material(f64(center.x),f64(center.z),center.y).tint.w>=0.0:return true
    if not f.built or length(f.center.xz-center.xz)>12.0 or f.road_stamp!=grass_road_stamp(f.center.xz):return true
    # A camera orbit/zoom may leave a reduced resident field even while the
    # actor stands still. Grow it before the visible disk reaches its edge.
    f.resident_radius<render_quality.grass_radius+16.0 and f64(length(eye.xz-f.center.xz))+f64(grass_forward_reach())+3.0>f.resident_radius

# A cell's cover is fixed by the world: the terrain, the settlements made so far and the
# roads laid so far. Keep it per metre cell, so a field moved 12 m on computes only the
# strip it gained rather than every cell again.
const GRASS_COVER_EDGE = 256
struct GrassCoverCell:
    x: int
    z: int
    revision = -1
    cover: f64
    made = false                     # (the blade record below is kept once the ground's material is there)
    cell: GrassCell = GrassCell(mat4(),vec4(0,0,0,0),vec4(0,0,0,0))
grass_cover_cells: GrassCoverCell[]
grass_cover_revision = () -> int: (geography_revision*65537+world_settlements.len())*65537+settlement_road_revision
grass_cover_slot = (x: f64, z: f64) -> int:
    global grass_cover_cells
    if x!=floor(x) or z!=floor(z): return -1
    if grass_cover_cells.len()==0: grass_cover_cells=[loop i in 0..GRASS_COVER_EDGE*GRASS_COVER_EDGE: GrassCoverCell()]
    (int(x) & (GRASS_COVER_EDGE-1))+(int(z) & (GRASS_COVER_EDGE-1))*GRASS_COVER_EDGE
grass_cover_at = (towns: Town[], x: f64, z: f64) -> f64:
    global grass_cover_cells
    slot=grass_cover_slot(x,z)
    if slot<0: return grass_cover(towns,x,z)
    ix=int(x);iz=int(z);revision=grass_cover_revision()
    old=grass_cover_cells[slot]
    if old.x==ix and old.z==iz and old.revision==revision: return old.cover
    cover=grass_cover(towns,x,z)
    grass_cover_cells[slot]=GrassCoverCell(ix,iz,revision,cover)
    cover

# A field is made a slice at a time (the field drawn till now stays until the new one is whole).
struct GrassBuild:
    active = false
    center: vec3 = vec3(0,0,0)
    lanes: TownLane[]
    radius: f64 = 0.0
    n: int = 0
    cell: int = 0
    list: GrassCell[]

grass_build_start = (towns: Town[], center: vec3) -> GrassBuild:
    lanes=grass_road_lanes(center.xz,render_quality.grass_radius+18.0)
    loop tw in towns:
        if length(tw.center.xz-center.xz)>500.0:continue
        lanes.extend(site_lanes(tw.sites))
        tangent=vec2(-tw.out.y,tw.out.x)
        loop k in 0..tw.houses.len():
            front=tw.houses[k].xz+tw.out*8.0
            lanes.push(TownLane(front-tangent*6.0,front+tangent*6.0,2.0))
            if k>0:
                prev=tw.houses[k-1].xz+tw.out*8.0
                if length(prev-front)<25.0:lanes.push(TownLane(prev,front,2.0))
    radius = grass_resident_radius(center,scene_camera())
    GrassBuild(true,center,lanes,radius,int(radius * 2.0 / GRASS_STEP))

# Cells until `until` (a time()); true once every cell is done.
grass_build_step = (towns: Town[], b: mut GrassBuild, until: f64) -> bool:
    global grass_cover_cells
    center=b.center; n=b.n
    cx = floor(f64(center.x) / GRASS_STEP) * GRASS_STEP
    cz = floor(f64(center.z) / GRASS_STEP) * GRASS_STEP
    loop b.cell < n*n:
        if b.cell%16 == 0 and time() > until: return false
        i = b.cell%n; j = b.cell/n
        b.cell += 1
        gx = cx + (f64(i) - f64(n) * 0.5) * GRASS_STEP
        gz = cz + (f64(j) - f64(n) * 0.5) * GRASS_STEP
        x = gx
        z = gz
        d = sqrt((x - f64(center.x)) ^ 2.0 + (z - f64(center.z)) ^ 2.0)
        if d > b.radius: continue
        if not grass_lane_clear(vec2(f32(x),f32(z)),b.lanes):continue
        k = grass_cover_at(towns, x, z)
        if k < 0.001: continue
        slot = grass_cover_slot(x,z)
        if slot >= 0 and grass_cover_cells[slot].made:
            b.list.push(grass_cover_cells[slot].cell)
            continue
        cell=if grass_cached_land(x,z):grass_terrain(x,z) else:GrassTerrain(ground=surface_height(x,z),dx=surface_height(x+0.5,z)-surface_height(x-0.5,z),dz=surface_height(x,z+0.5)-surface_height(x,z-0.5))
        h=cell.ground;hx=cell.dx;hz=cell.dz
        m = translation(vec3(f32(x),f32(h-0.025),f32(z)))
        m[1]=vec4(0,f32(k),0,0)
        detail=grass_detail_slope(x,z,hx,hz)
        m[0]=vec4(1,f32(hx),0,f32(detail.x));m[2]=vec4(0,f32(hz),1,f32(detail.y))
        material=grass_ground_material(x,z,f32(h))
        if material.tint.w<0.0:continue
        normal=normalize(material.normal)
        orchard=orchard_cover(vec2(f32(x),f32(z)),f32(h),length(normal.xz)/max(normal.y,0.1))
        made=GrassCell(m,material.tint,vec4(normal,orchard))
        b.list.push(made)
        if slot >= 0: grass_cover_cells[slot].made=true; grass_cover_cells[slot].cell=made
    true

grass_build_finish = (b: GrassBuild) -> GrassField:
    center=b.center; list=b.list
    # Stable 8 m batches retain all blades but avoid vertex work outside the view.
    list.sort(grass_tile_key)
    chunks: GrassChunk[]
    start=0
    loop start<list.len():
        key=grass_tile_key(list[start]);finish=start+1
        lo=list[start].model[3].xyz;hi=lo
        loop finish<list.len() and grass_tile_key(list[finish])==key:
            at=list[finish].model[3].xyz;lo=min(lo,at);hi=max(hi,at);finish+=1
        chunks.push(GrassChunk((lo+hi)*0.5,length(hi-lo)*0.5+3.0,start,finish-start))
        start=finish
    GrassField(center, instance_buffer(list), list.len(), true,chunks,list,grass_road_stamp(center.xz),b.radius,grass_ground_material(f64(center.x),f64(center.z),center.y).tint.w>=0.0)

build_grass = (towns: Town[], center: vec3) -> GrassField:
    b = grass_build_start(towns,center)
    _ = grass_build_step(towns,b,1e30)
    grass_build_finish(b)

grass_actor = vec3(0,0,0)
grass_contact_radius: f32 = 1.2
# Heading (x,z), strength: supplied by the simulation, never inferred from camera.
grass_airflow = vec3(0,-1,0)

draw_grass = (tuft: Mesh, f: GrassField, L: Light, t: f64):
    global grass_visible_blades
    grass_visible_blades=0
    if not f.built or f.count == 0 or grass_hidden: return
    # A stale field after departure must not spend vertex work behind the aircraft.
    camera=scene_camera()
    if length(camera.xz-f.center.xz)>f32(render_quality.grass_radius*2.0+16.0) or camera.y-f.center.y>80.0:return
    p = obj_params(L,t,sway=1.0)
    gp = GroundParams(p.view_proj,p.cam,p.sun_dir,p.sun,p.sky,p.shade,p.haze,p.fog,p.time,p.wind,meadow_gust_w(p.origin),p.origin,p.pigment,p.pigment,vec4(0,0,0,0),p.warp_a,p.warp_b,p.pigment)
    gp.flow.w=if render_quality.tier==0:0.45 else:if render_quality.tier==1:0.56 else:0.78
    # (the blades take the canopy's mean colour: no crowns at their roots, no texture reads)
    gp.canopy=canopy_sheet();gp.grove=vec4(0,0,0,0);gp.land_light=land_light(p.sun_dir)
    # The camera's look direction is the view matrix's fourth row (see render_rays).
    look=normalize(vec3(gp.view_proj[0].w,gp.view_proj[1].w,gp.view_proj[2].w))
    reach=grass_reach_for(look)
    gp.grass_view=grass_view_shape(look)
    gp.grass_actor = vec4(grass_actor-p.origin,reach)
    gp.grass_airflow = vec4(grass_airflow,grass_contact_radius)
    gp.wind=meadow_wind(wind_now,p.origin)
    gp.grass_gust=meadow_gust(p.origin)
    gp.grass_spring=meadow_spring()
    gp.grass_lag=meadow_lag()
    # Under the speed trial's warp the frustum no longer bounds the blades; the egg still does.
    planes:vec4[]=if gp.warp_b.x>0.0:[] else:land_planes(gp.view_proj)
    # Bound the actual root footprint, tip lean, widest blade and maximum wind
    # displacement. Airflow adds its own larger bound; terrain tilt is per cell.
    contact_reach=if gp.grass_airflow.w>2.0:(length(gp.grass_airflow.xy)+0.6)*abs(gp.grass_airflow.z)*0.55 else:0.3
    lean_reach=meadow_lean(gp.wind.z)
    horizontal=1.0+(lean_reach.x+lean_reach.y*1.2)*1.1+contact_reach
    # The egg's normalized distance changes by at most one over the shortest of its half-axes per metre.
    slope=1.0/min(gp.grass_view.z,gp.grass_view.w)
    # Reject coarse tiles first, then upload only visible one-metre cells.
    # Keep their order front-to-back in a single instanced draw.
    # Cells go into sixteen bins by distance along the egg, so the draw runs front to back (early depth
    # rejection) without sorting every cell every frame.
    empty:GrassCell[]
    near_bins:GrassCell[][]=[loop i in 0..16:empty]
    far_bins:GrassCell[][]=[loop i in 0..16:empty]
    near_count=0
    far_count=0
    # a cell's blades reach at most this far (its roots, tips, lean and the tilt of the ground) from its root
    cell_reach=horizontal*1.42+3.0
    loop chunk in f.chunks:
        center=chunk.center-gp.origin
        if grass_shape(center.xz-gp.cam.xz,gp.grass_view,reach)-chunk.radius*slope>1.1:continue
        visible=true
        inside=true
        loop plane in planes:
            side=dot(plane.xyz,center)+plane.w
            if side < -chunk.radius:visible=false
            if side < chunk.radius+cell_reach:inside=false
        if not visible:continue
        loop k in chunk.first..chunk.first+chunk.count:
            cell=f.cells[k]
            at=cell.model[3].xyz-gp.origin
            # The blade roots occupy a square of half-width 0.5 m. Thinning
            # depends on root distance, not the displaced tip's position.
            shape=grass_shape(at.xz-gp.cam.xz,gp.grass_view,reach)
            if shape-0.71*slope>1.1:continue
            if not inside:
                extent=vec3(horizontal,1.35*(abs(cell.model[0].y)+abs(cell.model[2].y))+1.35,horizontal)
                keep=true
                loop plane in planes:
                    if dot(plane.xyz,at)+plane.w < -dot(abs(plane.xyz),extent):keep=false
                if not keep:continue
            bin=clamp(int(shape*15.0),0,15)
            if shape-0.71*slope>=GRASS_FAR_START:
                far_bins[bin].push(cell);far_count+=1
            else:
                near_bins[bin].push(cell);near_count+=1
    visible_cells:GrassCell[]
    far_cells:GrassCell[]
    loop bin in 0..16:
        visible_cells.extend(near_bins[bin])
        far_cells.extend(far_bins[bin])
    grass_visible_blades=near_count*grass_blade_count()+far_count*grass_far_blade_count()
    global grass_visible_buf,grass_far_buf
    if visible_cells.len()>0:
        set_instances(grass_visible_buf,visible_cells)
        draw_instanced(grass_sh,tuft,grass_visible_buf,gp)
    if far_cells.len()>0:
        set_instances(grass_far_buf,far_cells)
        draw_instanced(grass_sh,grass_far_mesh,grass_far_buf,gp)


grass_visible_buf:InstanceBuffer[GrassCell]
grass_far_buf:InstanceBuffer[GrassCell]
grass_far_mesh:Mesh

init_grass = ():
    global grass_sh,grass_visible_buf,grass_far_buf,grass_far_mesh
    empty:GrassCell[]
    grass_visible_buf=instance_buffer(empty)
    grass_far_buf=instance_buffer(empty)
    grass_far_mesh=build_tuft(true)
    grass_sh = make_world_shader(shader(grass_vs, grass_fs))

# Test the whole patch footprint, including the sideways reach of a bent blade.
grass_lane_clear=(p:vec2,lanes:TownLane[])->bool:
    loop lane in lanes:
        d=lane.b-lane.a
        nearest=lane.a+d*clamp(dot(p-lane.a,d)/max(dot(d,d),0.01),0.0,1.0)
        if length(p-nearest)<f32(lane.width*0.5+1.0):return false
    true

# Nearby road geometry is streamed after the first grass field. Its spatial bin
# already includes a 520 m shoulder, wider than any grass field. Invalidate only
# when that local list changes, and reserve each actual track plus blade reach.
grass_road_stamp = (p:vec2)->int: int(hash(settlement_road_bins.get(road_bin(p),[])))

grass_road_lanes = (center:vec2,radius:f64)->TownLane[]:
    result:TownLane[]
    loop id in settlement_road_bins.get(road_bin(center),[]):
        road=settlement_roads[id]
        loop k in 0..road.points.len()-1:
            a=road.points[k].xz;b=road.points[k+1].xz;d=b-a
            near=a+d*clamp(dot(center-a,d)/max(dot(d,d),0.01),0.0,1.0)
            if length(center-near)<f32(radius+road.width):result.push(TownLane(a,b,road.width))
    result

# Material comes from the same resident texels as the surrounding terrain.
grass_ground_material=(x:f64,z:f64,h:f32)->TerrainSample:
    loop tile in terrain_tiles:
        q=vec2(f32((x-tile.x)/14.0),f32((z-tile.z)/14.0))
        if q.x>=0.0 and q.y>=0.0 and q.x<f32(tile.heights.width-1) and q.y<f32(tile.heights.height-1) and tile.cpu_materials.len()>0:
            return land_cpu_material(tile.cpu_materials,tile.heights.width,q,h)
    # The contact ring publishes level-zero mainland tiles before grass builds.
    tx=int(floor((x-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
    tz=int(floor((z-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
    slot=world_cache.get(world_tile_key(tx,tz,0)) ?? -1
    if slot>=0:
        tile=world_tiles[slot]
        ox,oz=world_tile_origin(tx,tz,0)
        if tile.cpu_materials.len()>0:return land_cpu_material(tile.cpu_materials,17,vec2(f32((x-ox)/14.0),f32((z-oz)/14.0)),h)
    # No published ground material yet: do not invent a contrasting grass field.
    TerrainSample(h,vec3(0,1,0),vec4(0,0,0,-1))
