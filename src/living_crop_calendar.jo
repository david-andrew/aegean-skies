# Civil crop calendar: the opening Monday is14May1928, matching the existing weekday.
# Dates are Gregorian; seasons use dates, not elapsed wall time or a repeated month timer.
const CROP_EPOCH_YEAR = 1928
const CROP_EPOCH_DAY = 134
const CROP_YEAR_DAYS = 365
const CROP_MIN_GROWING_DAYS = 180
const CROP_SEED_PER_ARE = 75          #150kg/ha, using20kg grain packages
const CROP_YIELD_PER_ARE = 1000       #2tonnes/ha, before care and harvest labor
const CROP_SOW_HOURS_PER_HA = 48
const CROP_TEND_HOURS_PER_HA = 96
const CROP_HARVEST_HOURS_PER_HA = 96

crop_leap = (year: int) -> bool: year%4==0 and (year%100!=0 or year%400==0)
crop_year_start = (year: int) -> int:
    prior=year-1; epoch=CROP_EPOCH_YEAR-1
    365*(year-CROP_EPOCH_YEAR)+(prior/4-prior/100+prior/400)-(epoch/4-epoch/100+epoch/400)

crop_year = (day: int) -> int:
    year=CROP_EPOCH_YEAR+int(floor(f64(day+CROP_EPOCH_DAY)/365.0))
    loop crop_year_start(year)>day+CROP_EPOCH_DAY: year-=1
    loop crop_year_start(year+1)<=day+CROP_EPOCH_DAY: year+=1
    year

crop_day_of_year = (day: int) -> int: day+CROP_EPOCH_DAY-crop_year_start(crop_year(day))
crop_month_start = (year: int, month: int) -> int:
    lengths=[31,28,31,30,31,30,31,31,30,31,30,31]; result=0
    loop k in 0..month-1: result+=lengths[k]+(if k==1 and crop_leap(year): 1 else: 0)
    crop_year_start(year)+result-CROP_EPOCH_DAY

crop_sowing_season = (day: int) -> bool:
    year=crop_year(day)
    day>=crop_month_start(year,10) and day<crop_month_start(year,12)

crop_ready_day = (sown_day: int, field: int) -> int:
    year=crop_year(sown_day); ready=crop_month_start(year,6)+field%12
    if ready-sown_day<CROP_MIN_GROWING_DAYS: ready=crop_month_start(year+1,6)+field%12
    ready

crop_previous_sowing_day = (day: int) -> int:
    year=crop_year(day); sow=crop_month_start(year,10)+15
    if sow>day: sow=crop_month_start(year-1,10)+15
    sow

crop_opening_sown_day = () -> int: crop_previous_sowing_day(0)
crop_required_work = (area_ares: int, hours_per_ha: int) -> int: max(1,(area_ares*hours_per_ha+99)/100)

crop_date = (day: int) -> str:
    year=crop_year(day); month=1
    loop month<12 and crop_month_start(year,month+1)<=day: month+=1
    names=["January","February","March","April","May","June","July","August","September","October","November","December"]
    "{day-crop_month_start(year,month)+1} {names[month-1]} {year}"
