# Original low-poly interwar hulls. Bow +z, calm water y=0, real metre sizes.
use 'vessel_types.jo'
use 'objects.jo'
use 'town_details.jo'

vessel_triangle = (vs: mut Vertex3D[],a: vec3,b: vec3,c: vec3,col: vec4):
    n = normalize(cross(b-a,c-a)+vec3(0,0.000001,0))
    loop p in [a,b,c]: vs.push(Vertex3D(p,n,vec2(0,0),col))

vessel_hull = (vs: mut Vertex3D[],length: f64,beam: f64,draft: f64,deck: f64,col: vec4,wooden: bool,detail: bool = true):
    rows: vec3[][]
    count = if detail: 12 else: 6
    loop k in 0..count+1:
        u = f64(k)/f64(count); z = (u-0.5)*length
        shape = if wooden: pow(max(0.0,sin(PI*u)),0.65) else: min(1.0,min(pow(u*5.0,0.5),pow((1.0-u)*4.0,0.65)))
        w = max(0.03,beam*0.5*shape)
        sheer = deck+(if wooden: deck*0.28 else: deck*0.13)*pow(abs(u-0.5)*2.0,3.0)
        rows.push([vec3(f32(-w),f32(sheer),f32(z)),vec3(f32(-w*0.92),0,f32(z)),vec3(f32(-w*0.52),f32(-draft*0.8),f32(z)),vec3(0,f32(-draft),f32(z)),vec3(f32(w*0.52),f32(-draft*0.8),f32(z)),vec3(f32(w*0.92),0,f32(z)),vec3(f32(w),f32(sheer),f32(z))])
    loop k in 0..count:
        a = rows[k]; b = rows[k+1]
        loop j in 0..6:
            color = if j == 0 or j == 5: col else: rgb(0.27,0.13,0.10)
            inside = vec3(0,0,(a[0].z+b[0].z)*0.5)
            add_outward_triangle(vs,a[j],b[j],b[j+1],color,inside)
            add_outward_triangle(vs,a[j],b[j+1],a[j+1],color,inside)
        dc = if wooden: rgb(0.64,0.49,0.31) else: rgb(0.53,0.48,0.37)
        vessel_triangle(vs,a[0],b[0],b[6],dc); vessel_triangle(vs,a[0],b[6],a[6],dc)
        if detail:
            loop side in [-1.0,1.0]:
                # Continuous raised gunwale; little separate sections keep the sheer.
                q0 = if side < 0: a[0] else: a[6]
                q1 = if side < 0: b[0] else: b[6]
                town_beam(vs,q0,q1,if wooden: 0.11 else: 0.08,rgb(0.85,0.79,0.62))

vessel_windows = (vs: mut Vertex3D[],width: f64,z0: f64,z1: f64,y: f64,spacing: f64):
    n = max(1,int((z1-z0)/spacing))
    loop k in 0..n:
        z = z0+(f64(k)+0.5)*(z1-z0)/f64(n)
        loop side in [-1.0,1.0]: add_box(vs,vec3(f32(side*width*0.5),f32(y),f32(z)),vec3(0.05,0.65,0.8),rgba(0.12,0.19,0.23,0.55))

vessel_cabin = (vs: mut Vertex3D[],at: vec3,size: vec3,color: vec4,windows: bool = true):
    add_box(vs,at+vec3(0,size.y*0.5,0),size,color)
    add_box(vs,at+vec3(0,size.y,0),vec3(size.x+0.3,0.16,size.z+0.25),rgb(0.69,0.65,0.50))
    if windows:
        vessel_windows(vs,f64(size.x)+0.08,f64(at.z-size.z*0.5),f64(at.z+size.z*0.5),f64(at.y+size.y*0.62),2.0)
        add_box(vs,at+vec3(0,size.y*0.64,size.z*0.5+0.04),vec3(size.x*0.7,0.7,0.06),rgba(0.15,0.21,0.25,0.55))

vessel_mast = (vs: mut Vertex3D[],z: f64,deck: f64,height: f64,sail: bool,boom: f64):
    wood = rgb(0.36,0.25,0.14)
    add_cylinder(vs,vec3(0,f32(deck),f32(z)),0.12,height,wood,6,0.055)
    town_beam(vs,vec3(0,f32(deck+0.7),f32(z)),vec3(0,f32(deck+1.1),f32(z-boom)),0.08,wood)
    # Shrouds and forestay; painted lines read clearly at near detail.
    loop side in [-1.0,1.0]: town_beam(vs,vec3(f32(side*boom*0.30),f32(deck),f32(z-boom*0.2)),vec3(0,f32(deck+height*0.88),f32(z)),0.025,wood)
    if not sail: return
    # Sail UV: x=billowing weight, y=foot height+1 (zero marks rigid geometry).
    # Triangular gaff-like cloth; its height folds down at the quay in the shader.
    color = rgb(0.88,0.77,0.55)
    rows = 6
    loop row in 0..rows:
        u0 = f64(row)/f64(rows); u1 = f64(row+1)/f64(rows)
        make = (u: f64,v: f64) -> Vertex3D:
            p = vec3(f32(sin(v*PI)*(1.0-u)*0.15),f32(deck+1.1+u*(height-1.6)),f32(z-v*boom*(1.0-u)))
            Vertex3D(p,vec3(1,0,0),vec2(f32(sin(v*PI)*(1.0-u)*boom*0.20),f32(deck+2.1)),color)
        loop col in 0..4:
            v0 = f64(col)/4.0; v1 = f64(col+1)/4.0
            a = make(u0,v0); b = make(u0,v1); c = make(u1,v1); d = make(u1,v0)
            loop face in [1,-1]:
                if face == 1: vs.extend([a,b,c,a,c,d])
                else:
                    a.normal = -a.normal; b.normal = -b.normal; c.normal = -c.normal; d.normal = -d.normal
                    vs.extend([a,c,b,a,d,c])

vessel_lifeboat = (vs: mut Vertex3D[],at: vec3,scale: f64 = 1.0):
    local: Vertex3D[]
    vessel_hull(local,5.0,1.6,0.35,0.5,rgb(0.84,0.79,0.65),true,false)
    loop v in local: vs.push(Vertex3D(at+v.pos*f32(scale),v.normal,v.uv,v.color))

vessel_vertices = (kind: VesselKind,far: bool = false) -> Vertex3D[]:
    s = vessel_spec(kind); vs: Vertex3D[]
    wooden = int(kind) <= 2 or kind == .rowboat or kind == .dinghy
    hull = if s.navy: rgb(0.34,0.41,0.43) else: if kind == .motor_yacht or kind == .passenger_steamer: rgb(0.86,0.86,0.79) else: if wooden: rgb(0.17,0.37,0.44) else: rgb(0.14,0.20,0.24)
    vessel_hull(vs,s.length,s.beam,s.draft,s.deck,hull,wooden,not far)
    white = if s.navy: rgb(0.46,0.51,0.51) else: rgb(0.91,0.87,0.73)
    iron = rgb(0.18,0.22,0.22); wood = rgb(0.40,0.28,0.17)
    if kind==.canal_barge or kind==.canal_launch:
        vessel_cabin(vs,vec3(0,f32(s.deck),f32(-s.length*0.3)),vec3(f32(s.beam*0.72),if kind==.canal_barge:1.5 else:1.0,f32(s.length*0.2)),white,not far)
        if kind==.canal_barge:
            add_box(vs,vec3(0,1.2,1.4),vec3(3.5,0.3,8.5),wood)
            if not far:
                loop z in [-2.0,1.0,4.0]:add_box(vs,vec3(0,1.65,f32(z)),vec3(3,0.6,2),rgb(0.47,0.40,0.28))
        return vs
    if kind == .rowboat or kind == .dinghy:
        loop k in [-1.0,0.0,1.0]: add_box(vs,vec3(0,0.42,f32(k)),vec3(f32(s.beam*0.8),0.12,0.28),wood)
        if kind == .dinghy: vessel_mast(vs,0.7,0.5,4.2,true,2.7)
        else if not far:
            loop side in [-1.0,1.0]:
                town_beam(vs,vec3(f32(side*0.4),0.8,-0.2),vec3(f32(side*2.7),0.18,0.8),0.04,wood)
                add_box(vs,vec3(f32(side*2.5),0.15,0.8),vec3(0.65,0.05,0.21),wood)
        return vs
    if wooden or kind == .motor_caique:
        vessel_cabin(vs,vec3(0,f32(s.deck),f32(-s.length*0.24)),vec3(f32(s.beam*0.65),f32(s.deck*0.9),f32(s.length*0.20)),white,not far)
        if s.sail:
            vessel_mast(vs,s.length*0.13,s.deck,s.length*(if kind == .trehantiri: 0.54 else: 0.68),true,s.length*(if kind == .trehantiri: 0.30 else: 0.44))
            if kind == .trehantiri: vessel_mast(vs,-s.length*0.18,s.deck,s.length*0.68,true,s.length*0.36)
        else: vessel_mast(vs,s.length*0.05,s.deck,5.0,false,2.0)
        if not far:
            loop x in [-1.0,1.0]: add_cylinder(vs,vec3(f32(x),f32(s.deck),f32(s.length*0.19)),0.45,0.55,rgb(0.39,0.30,0.18),7)
    else:
        passenger = kind == .passenger_steamer or kind == .island_ferry or kind == .motor_yacht
        levels = if kind == .passenger_steamer: 3 else: if kind == .island_ferry: 2 else: 1
        z = if passenger: -s.length*0.02 else: if kind == .tanker: -s.length*0.29 else: s.length*0.04
        cabin_length = s.length*(if passenger: 0.60 else: 0.23)
        loop level in 0..levels:
            vessel_cabin(vs,vec3(0,f32(s.deck+f64(level)*2.8),f32(z-f64(level)*1.8)),vec3(f32(s.beam*(0.75-f64(level)*0.08)),2.8,f32(cabin_length-f64(level)*s.length*0.08)),white,not far)
        if s.steam:
            funnels = vessel_funnels(kind)
            if not passenger:
                vessel_cabin(vs,vec3(0,f32(s.deck),f32(-s.length*(if kind == .tanker: 0.30 else: 0.18))),vec3(f32(s.beam*0.52),2.8,f32(s.length*(if kind == .tanker: 0.20 else: 0.36))),white,false)
            loop k in 0..funnels:
                fz = -s.length*(if kind == .tanker: 0.30 else: 0.13)-f64(k)*s.length*0.10
                h = s.deck+f64(levels)*2.8
                add_cylinder(vs,vec3(0,f32(h),f32(fz)),s.beam*0.10,s.beam*0.50,if s.navy: hull else: rgb(0.69,0.43,0.16),8)
                add_cylinder(vs,vec3(0,f32(h+s.beam*0.39),f32(fz)),s.beam*0.105,s.beam*0.12,iron,8)
        if not far:
            loop mz in [s.length*0.28,-s.length*0.30]: vessel_mast(vs,mz,s.deck,s.beam*1.8,false,s.length*0.09)
            if kind == .tramp_freighter or kind == .coastal_steamer or kind == .seaplane_tender:
                loop fz in [s.length*0.27,-s.length*0.29]:
                    add_box(vs,vec3(0,f32(s.deck+0.5),f32(fz)),vec3(f32(s.beam*0.65),1.0,f32(s.length*0.18)),rgb(0.40,0.31,0.20))
                    town_beam(vs,vec3(0,f32(s.deck+s.beam),f32(fz)),vec3(f32(s.beam*0.65),f32(s.deck+s.beam*0.6),f32(fz+s.length*0.1)),0.15,iron)
            if kind == .tanker:
                loop k in 0..5:
                    zz = s.length*0.30-f64(k)*s.length*0.105
                    add_cylinder(vs,vec3(0,f32(s.deck),f32(zz)),s.beam*0.15,0.8,iron,8)
                    town_beam(vs,vec3(0,f32(s.deck+1),f32(zz)),vec3(0,f32(s.deck+1),f32(zz-s.length*0.10)),0.13,iron)
            if s.navy:
                loop fz in [s.length*0.34,-s.length*0.32]:
                    add_cylinder(vs,vec3(0,f32(s.deck),f32(fz)),s.beam*0.14,1.2,hull,8)
                    town_beam(vs,vec3(0,f32(s.deck+1.3),f32(fz)),vec3(0,f32(s.deck+1.6),f32(fz+s.length*0.07)),0.13,iron)
                if kind != .gunboat and kind != .seaplane_tender:
                    loop side in [-1.0,1.0]: town_beam(vs,vec3(f32(side*s.beam*0.22),f32(s.deck+0.7),f32(-s.length*0.12)),vec3(f32(side*s.beam*0.22),f32(s.deck+0.7),f32(-s.length*0.22)),0.32,iron)
            if kind == .seaplane_tender or kind == .lighthouse_tender:
                base = vec3(f32(-s.beam*0.25),f32(s.deck),f32(-s.length*0.24))
                town_beam(vs,base,base+vec3(0,f32(s.beam*1.4),0),0.35,iron)
                town_beam(vs,base+vec3(0,f32(s.beam*1.4),0),base+vec3(f32(s.beam*1.1),f32(s.beam*1.1),0),0.20,iron)
                town_beam(vs,base+vec3(f32(s.beam*1.1),f32(s.beam*1.1),0),base+vec3(f32(s.beam*1.1),2,0),0.035,iron)
                if kind == .seaplane_tender:
                    # Folded-wing floatplane carried on the aft working deck.
                    add_box(vs,vec3(0,f32(s.deck+1),f32(-s.length*0.34)),vec3(1.2,1.1,6.5),rgb(0.53,0.64,0.65))
                    loop side in [-1.0,1.0]: add_box(vs,vec3(f32(side*1.1),f32(s.deck+2),f32(-s.length*0.35)),vec3(0.18,2.1,3.8),white)
            loop k in 0..s.lifeboats:
                side = if k%2 == 0: -1.0 else: 1.0
                vessel_lifeboat(vs,vec3(f32(side*s.beam*0.42),f32(s.deck+1.2),f32((f64(k/2)-f64(s.lifeboats/4))*6.2)))
    # White masthead/stern, red port and green starboard lights share the existing
    # emissive-after-dark material convention. Tall ships read on the horizon.
    loop side in [-1.0,1.0]: add_box(vs,vec3(f32(side*s.beam*0.45),f32(s.deck+2.0),f32(s.length*0.08)),vec3(0.35,0.45,0.35),if side < 0: rgba(0.75,0.14,0.08,0.5) else: rgba(0.15,0.58,0.28,0.5))
    add_box(vs,vec3(0,f32(s.deck+3),f32(-s.length*0.40)),vec3(0.3,0.4,0.3),rgba(0.95,0.90,0.66,0.5))
    vs
