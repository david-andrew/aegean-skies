    3.791, 24.11, 2.87, 0,  3.819, 24.05, 3.6, 0,  3.748, 24.11, 3.7, 0,  3.763, 24.37, 3.9, 0,  3.772, 23.95, 4.1, 0,  3.753, 24.47, 4.3, 0]

const FAINT_STARS = 3400           # the strewn ones, magnitude 2.7 to 6.1
const STAR_GLINT_MAG = 1.7          # stars brighter than this carry a glint

struct StarSpec:
    q: vec3                         # its place on the celestial sphere
    mag: f32
    tint: vec3
    phase: f32                      # its twinkle's own phase and pace (0..1)

# (a fixed scatter of its own: the game's random numbers are not touched)
_star_roll = (k: int) -> f64: f64(int(hash(k * 7919 + 104729) % u64(16777216))) / 16777216.0

# how thick the faint stars lie at a galactic latitude b (radians) and longitude l: about three
# times as many in the Milky Way as at its poles, more toward its centre
star_density = (l: f64, b: f64) -> f64:
    deg = b * 180.0 / PI
    0.3 + 0.7 * exp(-(deg / 15.0) * (deg / 15.0)) * (0.7 + 0.3 * cos(l))

night_star_specs = () -> StarSpec[]:
    out: StarSpec[]
    loop k in 0..BRIGHT_STARS.len()/4:
        out.push(StarSpec(celestial_place(BRIGHT_STARS[k*4], BRIGHT_STARS[k*4+1]), f32(BRIGHT_STARS[k*4+2]), STAR_TINTS[int(BRIGHT_STARS[k*4+3])], f32(_star_roll(k * 13 + 5))))
    # (many faint, few bright: the count grows about three times a magnitude, as the real sky's)
    low = 2.7; high = 6.1
    floor_share = pow(10.0, 0.5 * (low - high))
    made = 0
    loop k in 0..FAINT_STARS*4:
        if made >= FAINT_STARS: break
        z = _star_roll(k * 6) * 2.0 - 1.0
        l = _star_roll(k * 6 + 1) * TAU
        if _star_roll(k * 6 + 2) > star_density(l, asin(z)): continue
        made += 1
        r = sqrt(max(1.0 - z * z, 0.0))
        q = GALAXY_X * f32(r * cos(l)) + GALAXY_Y * f32(r * sin(l)) + GALAXY_Z * f32(z)
        mag = high + 2.0 * log10(floor_share + (1.0 - floor_share) * _star_roll(k * 6 + 3))
        c = _star_roll(k * 6 + 4)
        class = if c < 0.2: 0 else: if c < 0.44: 1 else: if c < 0.58: 2 else: if c < 0.71: 3 else: if c < 0.95: 4 else: 5
        out.push(StarSpec(q, f32(mag), STAR_TINTS[class], f32(_star_roll(k * 6 + 5))))
    out

struct StarVertex:
    q: vec3                         # the star's place on the celestial sphere
    corner: vec2                    # which corner of its square (-1..1)
    tint: vec3                      # its colour
    data: vec4                      # x its magnitude, y its twinkle's phase (0..1), z 1 if it carries a glint, w 1 if it twinkles

struct StarParams:
    view_proj: mat4
    ax: vec3                        # the celestial sphere's turn (sky_turn)
    ay: vec3
    az: vec3
    air: vec4                       # x the faintest magnitude seen, y the low air's dimming, z the horizon's dip, w the time (s)
    moon: vec4                      # the Moon's direction, w its glare on the stars about it
    glow: vec4                      # Light.afterglow
    screen: vec4                    # xy a reference pixel (of a 720-line picture) in clip units, z the smallest core (those pixels), w the stars' gain
    far_z: f32

struct StarOut:
    pos: vec4
    at: vec2                        # in core radii
    core: vec3                      # the core's light: near white
    halo: vec4                      # the halo's light, in the star's colour; w its fall-off
    shape: vec3                     # x the glint's strength, y 1 / the square's half size squared, z the glint's fall-off along its arms

# 10^(-0.2 mag): the eye's compressed sense of a star's brightness (magnitude 0: 1, 5: 0.1)
star_brightness = (mag: f32) -> f32: exp(-0.4605 * mag)

night_star_vs = (v: StarVertex, u: StarParams) -> StarOut:
    dir = normalize(u.ax * v.q.x + u.ay * v.q.y + u.az * v.q.z)
    y = dir.y + u.air.z
    seen = night_seen(dir, y, v.data.x, vec4(u.air.x, u.air.y, 0, 0), u.moon, u.glow)
    f = star_brightness(v.data.x)
    big = smoothstep(0.25, 1.0, f)
    # (twinkle: the low air's shimmer, slight overhead and strong near the horizon, each star at
    # its own pace; the planets, discs to the air, hold steady)
    low = 1.0 - smoothstep(0.08, 0.75, y)
    amp = (0.1 + 0.42 * low) * v.data.w
    ph = v.data.y * 6.2832
    t = u.air.w
    wave = sin(t * (5.3 + ph * 0.31) + ph * 7.0) * 0.6 + sin(t * (11.7 + ph * 0.17) + ph * 3.0) * 0.4
    light = (0.13 + 0.95 * pow(f, 0.8)) * seen.x * mix(0.45, 1.0, seen.y) * (1.0 + amp * wave) * u.screen.w
    # (the low air reddens what it dims, and near the horizon a bright star flashes colours)
    tint = v.tint * mix(vec3(1.0, 0.74, 0.5), vec3(1, 1, 1), seen.y)
    flash = amp * low * 0.6
    tint = max(tint + vec3(sin(t * 7.1 + ph * 5.0), sin(t * 6.3 + ph * 9.0) * 0.5, -sin(t * 7.1 + ph * 5.0)) * flash, vec3(0.05, 0.05, 0.05))
    grey = dot(tint, vec3(0.3, 0.5, 0.2))
    vivid = max(mix(vec3(grey, grey, grey), tint, 1.7), vec3(0, 0, 0))
    core = mix(vec3(1, 1, 1), tint, 0.28) * min(light * 1.9, 1.6)
    halo_reach = 2.3 + 1.7 * big
    halo = vivid * (light * (0.22 + 0.5 * big))
    # (a bright star's and a planet's square is wide enough for its halo and its glint's arms)
    wide = smoothstep(1.2, 6.0, f)
    half = 2.8 + 6.2 * big + 5.0 * wide
    radius = max(0.95 + 1.05 * sqrt(min(f, 2.6)), u.screen.z)
    glint = v.data.z * (0.5 + 0.3 * wide)
    shown = step(0.004, light)
    clip = u.view_proj * vec4(dir, 0)
    offset = v.corner * (half * radius * shown) * u.screen.xy * clip.w
    StarOut(vec4(clip.xy + offset, clip.w * u.far_z, clip.w), v.corner * half, core, vec4(halo, 1.0 / (halo_reach * halo_reach)), vec3(glint, 1.0 / (half * half), 2.6 / half))

night_star_fs = (i: StarOut, u: StarParams) -> vec4:
    p = i.at
    r2 = dot(p, p)
    # (to nothing at the square's edge, whatever is in it)
    edge = clamp(1.0 - r2 * i.shape.y, 0.0, 1.0)
    a = abs(p)
    arms = i.shape.x * exp(-min(a.x, a.y) * 2.4 - max(a.x, a.y) * i.shape.z)
    c = i.core * exp(-r2 * 1.15) + i.halo.xyz * (exp(-r2 * i.halo.w) + arms)
    vec4(c * (edge * edge), 0)

night_star_sh = Shader()
night_star_mesh = Mesh()
night_planet_mesh = Mesh()

_star_quad = (vs: mut StarVertex[], idx: mut u32[], q: vec3, tint: vec3, data: vec4):
    base = u32(vs.len())
    loop c in [vec2(-1, -1), vec2(1, -1), vec2(1, 1), vec2(-1, 1)]: vs.push(StarVertex(q, c, tint, data))
    idx.extend([base, base + 1, base + 2, base, base + 2, base + 3])

build_night_stars = () -> Mesh:
    vs: StarVertex[]
    idx: u32[]
    loop s in night_star_specs():
        _star_quad(vs, idx, s.q, s.tint, vec4(s.mag, s.phase, if f64(s.mag) < STAR_GLINT_MAG: 1.0 else: 0.0, 1.0))
    mesh(vs, idx)

# The planets as the eye ranks them: Venus brilliant white, Jupiter cream, Mars red, Saturn pale gold.
PLANET_TINTS = [vec3(1.0, 0.97, 0.88), vec3(1.0, 0.9, 0.7), vec3(1.0, 0.45, 0.28), vec3(1.0, 0.84, 0.52)]
PLANET_MAGS = [-4.3, -2.5, 0.3, 0.7]
PLANET_NOMINAL = [1.8, 1.25, 0.85, 0.65]
# a planet's magnitude now, from celestial.jo's strength (its distance and phase)
planet_magnitude = (k: int, strength: f64) -> f64: PLANET_MAGS[k] - 2.2 * (strength / PLANET_NOMINAL[k] - 1.0)

night_planet_vertices = (planets: vec4[4], turn: SkyTurn) -> StarVertex[]:
    vs: StarVertex[]
    idx: u32[]
    loop k in 0..4:
        p = planets[k]
        # (a planet switched off, w 0: put under the world)
        q = if p.w > 0.0: sky_unturned(turn, normalize(p.xyz)) else: sky_unturned(turn, vec3(0, -1, 0))
        _star_quad(vs, idx, q, PLANET_TINTS[k], vec4(f32(planet_magnitude(k, f64(p.w))), 0.0, 1.0, 0.0))
    vs

# ---------------- the Milky Way ----------------
# Its light at a place in the galaxy's own frame (l along it from the centre, b across it, radians):
# a band a few degrees wide, widest and warm at the central bulge in Sagittarius, a bright cloud in
# the Swan, mottled, and split from the centre up to the Swan by the dark lane of the Great Rift.
# Cool blue-white away from the centre. Nothing at 28 degrees from its equator.
const MILKY_REACH = 28.0            # degrees either side of the galactic equator
const MILKY_COLUMNS = 360
const MILKY_ROWS = 28               # (even: a row lies on the equator)

milky_way_light = (l: f64, b: f64) -> vec3:
    ld = l * 180.0 / PI
    if ld > 180.0: ld -= 360.0
    bd = b * 180.0 / PI
    q = galactic_place(l, b)
    n1 = noise(f64(q.x) * 4.0 + 7.0, f64(q.y) * 4.0 + 3.0, f64(q.z) * 4.0 + 11.0)
    n2 = noise(f64(q.x) * 9.0 + 31.0, f64(q.y) * 9.0 + 17.0, f64(q.z) * 9.0 + 5.0)
    n3 = noise(f64(q.x) * 16.0 + 2.0, f64(q.y) * 16.0 + 41.0, f64(q.z) * 16.0 + 23.0)
    bulge = exp(-(ld / 30.0) * (ld / 30.0))
    swan = exp(-((ld - 76.0) / 22.0) * ((ld - 76.0) / 22.0))
    along = 0.3 + 0.7 * bulge + 0.32 * swan + 0.12 * exp(-((ld + 75.0) / 30.0) * ((ld + 75.0) / 30.0))
    width = 5.5 + 7.5 * bulge + 1.5 * swan
    off = bd - 0.5 + (n1 - 0.5) * 3.0
    band = exp(-(off / width) * (off / width))
    clouds = clamp(0.78 + (n2 - 0.5) * 0.85 + (n3 - 0.5) * 0.55, 0.3, 1.35)
    rift_on = smoothstep(-18.0, 4.0, ld) * (1.0 - smoothstep(62.0, 96.0, ld))
    rift_at = 1.2 + 0.045 * ld + (n1 - 0.5) * 4.0
    rift_wide = 1.8 + 1.6 * n2
    rift = rift_on * exp(-((bd - rift_at) / rift_wide) * ((bd - rift_at) / rift_wide)) * (0.6 + 0.4 * n3)
    light = along * band * clouds * (1.0 - 0.82 * rift) * (1.0 - smoothstep(MILKY_REACH - 8.0, MILKY_REACH, abs(bd)))
    warm = clamp(bulge * band * 1.2, 0.0, 1.0)
    colour = mix(vec3(0.5, 0.63, 1.0), vec3(1.0, 0.82, 0.6), f32(warm))
    # (a touch of rose where the clouds are thick, as long exposures show)
    colour = mix(colour, vec3(0.95, 0.6, 0.75), f32(0.18 * smoothstep(0.55, 0.9, n2) * band))
    colour * f32(light)

struct MilkyVertex:
    q: vec3                         # its place on the celestial sphere
    light: vec3

struct MilkyParams:
    view_proj: mat4
    ax: vec3
    ay: vec3
    az: vec3
    air: vec4                       # x its gain, y the low air's dimming, z the horizon's dip
    far_z: f32

struct MilkyOut:
    pos: vec4
    colour: vec4

# (in shaders and tests) what the low air leaves of the band at a height y over the visible horizon
milky_way_fade = (y: f32, extinction: f32) -> f32:
    mass = 1.0 / (max(y, 0.0) + 0.04) - 0.96
    exp(-extinction * mass * 4.0) * smoothstep(0.0, 0.12, y)

milky_way_vs = (v: MilkyVertex, u: MilkyParams) -> MilkyOut:
    dir = normalize(u.ax * v.q.x + u.ay * v.q.y + u.az * v.q.z)
    clip = u.view_proj * vec4(dir, 0)
    MilkyOut(vec4(clip.xy, clip.w * u.far_z, clip.w), vec4(v.light * (u.air.x * milky_way_fade(dir.y + u.air.z, u.air.y)), 0))

milky_way_fs = (i: MilkyOut, u: MilkyParams) -> vec4: i.colour

milky_way_sh = Shader()
milky_way_mesh = Mesh()

# (the grid the band is painted on: MILKY_COLUMNS + 1 by MILKY_ROWS + 1 vertices, the first and
# last columns the same places, the outer rows dark)
milky_way_grid = () -> MilkyVertex[]:
    vs: MilkyVertex[]
    loop i in 0..MILKY_COLUMNS+1:
        l = f64(i % MILKY_COLUMNS) / f64(MILKY_COLUMNS) * TAU
        loop j in 0..MILKY_ROWS+1:
            b = (f64(j) / f64(MILKY_ROWS) * 2.0 - 1.0) * MILKY_REACH * PI / 180.0
            vs.push(MilkyVertex(galactic_place(l, b), milky_way_light(l, b)))
    vs

build_milky_way = () -> Mesh:
    idx: u32[]
    rows = MILKY_ROWS + 1
    loop i in 0..MILKY_COLUMNS:
        loop j in 0..MILKY_ROWS:
            p = u32(i * rows + j); q = p + u32(rows)
            idx.extend([p, q, p + 1, p + 1, q, q + 1])
    mesh(milky_way_grid(), idx)

# how brightly the Milky Way shows: only when the faint stars do (a dark, clear, moonless night)
milky_way_gain = (air: NightAir) -> f64: 0.5 * smoothstep(5.2, 6.3, f64(air.limit))

# ---------------- the Moon ----------------

# The Moon's look for the frame, all worked out here: by its height (amber low down, cool white
# high up), its phase, how far it is out as a light, and the air.
struct MoonLook:
    face: vec3                      # the lit face as a light: over-bright, so it burns out near white
    out: f32                        # how far it is out as a light (0 the day's pale wash .. 1)
    glow: vec4                      # the tight glow about it: its colour and (w) strength
    ring: vec4                      # the corona in thick or damp air: its colour and (w) strength
    toward: vec2                    # where the glow centres, toward the lit limb (disc radii)
    aureole: vec4                   # the wide aureole: its colour and (w) strength
    reach: f32                      # ... and how far it reaches (radians)
    earthshine: f32

const MOON_QUAD: f32 = 4.2          # the square's half size, in disc radii (the disc and its tight glow)

moon_look = (air: NightAir, sun_dir: vec3, height: f64) -> MoonLook:
    moon = normalize(air.moon)
    lit = f64(air.lit)
    out = f64(air.glow)
    # (how low: 1 on the horizon, 0 from about 25 degrees up)
    low = 1.0 - smoothstep(0.03, 0.42, height)
    thick = min(f64(air.thick), 1.4)
    warm = clamp(low * (0.75 + 0.5 * thick) + 0.12 * thick, 0.0, 1.0)
    face = mix(vec3(0.97, 0.99, 1.06), vec3(1.08, 0.9, 0.62), f32(warm)) * 1.24
    # (a thin crescent gives little light: its glow and aureole weak; the whole thing dimmer under
    # cloud, and at dusk until the sky darkens behind it)
    power = lit * sqrt(lit) * out * (1.0 - 0.85 * f64(air.cover))
    sky_dark = 0.6 + 0.4 * f64(air.dark)
    glow_colour = mix(vec3(0.5, 0.68, 1.0), vec3(1.0, 0.66, 0.34), f32(warm))
    glow = vec4(glow_colour, f32(power * sky_dark * (0.85 - 0.25 * min(thick, 1.0))))
    ring = vec4(mix(vec3(0.95, 0.66, 0.42), vec3(0.9, 0.5, 0.3), f32(warm)), f32(power * sky_dark * 0.24 * smoothstep(0.2, 0.8, thick)))
    # (the glow hugs the lit side: at the disc's middle when full, toward the lit limb for a crescent)
    right = normalize(cross(vec3(0, 1, 0), moon) + vec3(0.00001, 0, 0))
    up = cross(moon, right)
    s = normalize(sun_dir)
    side = vec2(dot(s, right), dot(s, up))
    toward = side / max(length(side), 0.0001) * f32(0.75 * (1.0 - lit))
    aureole_colour = mix(vec3(0.34, 0.5, 0.92), vec3(0.85, 0.6, 0.42), f32(clamp(warm * 0.8 + 0.25 * thick, 0.0, 1.0)))
    # (through haze the aureole is wider and milkier, and takes more of the light)
    aureole = vec4(aureole_colour, f32(power * sky_dark * (0.62 + 0.2 * min(thick, 1.0))))
    reach = f64(SKY_DISC_RADIUS) * (10.0 + 6.0 * min(thick, 1.0))
    MoonLook(face, f32(out), glow, ring, toward, aureole, f32(reach), f32(0.05 * out * (1.0 - lit) * f64(air.dark)))

struct MoonVertex:
    at: vec2                        # the corner, in units of the square's half size

struct MoonParams:
    view_proj: mat4
    moon: vec3
    sun: vec3                       # the sun's direction in the disc's own frame (right, up, toward the eye)
    face: vec4                      # the lit face's light (xyz); w how far it is out as a light
    glow: vec4
    ring: vec4
    shape: vec4                     # xy where the glow centres (radii), z the disc's centre over the horizon (radii), w the earthshine
    far_z: f32

struct MoonOut:
    pos: vec4
    at: vec2                        # in disc radii

moon_disc_vs = (v: MoonVertex, u: MoonParams) -> MoonOut:
    m = normalize(u.moon)
    right = normalize(cross(vec3(0, 1, 0), m) + vec3(0.00001, 0, 0))
    up = cross(m, right)
    dir = m + (right * v.at.x + up * v.at.y) * (MOON_QUAD * SKY_DISC_RADIUS)
    clip = u.view_proj * vec4(dir, 0)
    MoonOut(vec4(clip.xy, clip.w * u.far_z, clip.w), v.at * MOON_QUAD)

# (in shaders) the maria at a place on the disc (in radii, north up): the Sea of Showers and the
# Ocean of Storms to the west, Serenity, Tranquillity and Fertility to the east, Clouds to the south
moon_seas = (p: vec2) -> f32:
    a = p - vec2(-0.3, 0.42); b = p - vec2(-0.6, 0.02); c = p - vec2(0.22, 0.4)
    d = p - vec2(0.42, 0.12); e = p - vec2(0.62, -0.12); f = p - vec2(-0.2, -0.38)
    exp(-dot(a, a) * 9.0) + exp(-dot(b, b) * 7.0) * 0.9 + exp(-dot(c, c) * 20.0) + exp(-dot(d, d) * 22.0) + exp(-dot(e, e) * 26.0) * 0.9 + exp(-dot(f, f) * 16.0) * 0.8

moon_disc_fs = (i: MoonOut, u: MoonParams) -> vec4:
    p = i.at
    r2 = dot(p, p)
    r = sqrt(r2)
    above = smoothstep(-0.35, 1.1, p.y + u.shape.z)
    disc = (1.0 - smoothstep(0.93, 1.05, r)) * above
    # (the lit side of a sphere, by the real Sun: the crescent turns as the Sun does)
    normal = vec3(p.x, p.y, sqrt(max(1.0 - r2, 0.0)))
    lit = smoothstep(-0.03, 0.12, dot(normal, u.sun)) * disc
    # (the maria: the broad grey seas where the real Moon has them, ragged at their edges; only a
    # hint once the face burns out)
    seas = smoothstep(0.38, 0.8, moon_seas(p) + (vnoise(p * 4.5 + vec2(4, 9)) - 0.5) * 0.4)
    out = u.face.w
    # (by day the sky lies in front of it: a pale wash over the blue, its dark side only sky)
    pale = lit * (0.82 + 0.18 * (1.0 - seas)) * 0.42
    day = vec4(vec3(0.84, 0.88, 0.93) * pale, pale)
    night = vec4(u.face.xyz * (1.0 - 0.4 * seas) * lit + vec3(0.6, 0.72, 1.0) * (u.shape.w * disc * (1.0 - lit)), lit)
    body = mix(day, night, out)
    # (the light about it: a saturated ring hugging the lit limb, then a soft glow, covering the sky
    # with its own colour as the sun's bloom does; the corona further out in thick air; all of it
    # to nothing at the square's edge)
    d = length(p - u.shape.xy)
    past = max(d - 0.85, 0.0)
    edge = 1.0 - smoothstep(MOON_QUAD - 1.6, MOON_QUAD - 0.05, r)
    open = (1.0 - body.w) * above * edge
    bloom = clamp(u.glow.w * ((1.0 - smoothstep(0.0, 1.5, past)) * 0.55 + exp(-past * 0.95) * 0.5), 0.0, 0.9) * open
    corona = u.ring.w * exp(-(r - 2.5) * (r - 2.5) * 2.6) * open
    vec4(body.xyz + u.glow.xyz * bloom + u.ring.xyz * corona, body.w + bloom * 0.55 + corona * 0.5)

moon_disc_sh = Shader()
moon_disc_mesh = Mesh()

# what the disc's program is given: the look, the Sun in the disc's own frame, the Moon's height
# over the visible horizon (the sine of it)
moon_disc_params = (k: MoonLook, moon: vec3, sun_dir: vec3, height: f64, vp: mat4, far: f32) -> MoonParams:
    right = normalize(cross(vec3(0, 1, 0), moon) + vec3(0.00001, 0, 0))
    up = cross(moon, right)
    s = normalize(sun_dir)
    local = vec3(dot(s, right), dot(s, up), -dot(s, moon))
    MoonParams(vp, moon, local, vec4(k.face, k.out), k.glow, k.ring, vec4(k.toward, f32(asin(clamp(height, -1.0, 1.0)) / f64(SKY_DISC_RADIUS)), k.earthshine), far)

# The aureole: the Moon's light in the air about it, a fan of painted geometry centred on the Moon
# (AUREOLE_SPOKES bearings by AUREOLE_RINGS distances), its light worked out at each vertex and
# nothing at its rim.
const AUREOLE_SPOKES = 48
const AUREOLE_RINGS = 22

struct AureoleVertex:
    at: vec2                        # x the bearing round the Moon (rad), y how far out (0 the Moon .. 1 the rim)

struct AureoleParams:
    view_proj: mat4
    moon: vec3
    colour: vec4                    # its colour and (w) strength
    reach: f32                      # radians, the Moon to the rim
    far_z: f32

struct AureoleOut:
    pos: vec4
    colour: vec4                    # premultiplied

# (in shaders and tests) the aureole's strength at a distance x from the Moon (0..1 of its reach)
aureole_falloff = (x: f32) -> f32:
    k = 1.0 - x * x
    (0.62 * exp(-x * x * 24.0) + 0.38 * exp(-x * x * 5.0)) * k * k

moon_aureole_vs = (v: AureoleVertex, u: AureoleParams) -> AureoleOut:
    m = normalize(u.moon)
    right = normalize(cross(vec3(0, 1, 0), m) + vec3(0.00001, 0, 0))
    up = cross(m, right)
    ang = v.at.y * u.reach
    dir = m * cos(ang) + (right * cos(v.at.x) + up * sin(v.at.x)) * sin(ang)
    clip = u.view_proj * vec4(dir, 0)
    a = u.colour.w * aureole_falloff(v.at.y)
    AureoleOut(vec4(clip.xy, clip.w * u.far_z, clip.w), vec4(u.colour.xyz * a, a * 0.5))

moon_aureole_fs = (i: AureoleOut, u: AureoleParams) -> vec4: i.colour

moon_aureole_sh = Shader()
moon_aureole_mesh = Mesh()

# (the rings closer together near the Moon, where the light falls off fastest)
aureole_ring = (j: int) -> f64: pow(f64(j) / f64(AUREOLE_RINGS), 1.6)

build_moon_aureole = () -> Mesh:
    vs: AureoleVertex[]
    idx: u32[]
    rows = AUREOLE_RINGS + 1
    loop i in 0..AUREOLE_SPOKES+1:
        a = f64(i % AUREOLE_SPOKES) / f64(AUREOLE_SPOKES) * TAU
        loop j in 0..rows: vs.push(AureoleVertex(vec2(f32(a), f32(aureole_ring(j)))))
    loop i in 0..AUREOLE_SPOKES:
        loop j in 0..AUREOLE_RINGS:
            p = u32(i * rows + j); q = p + u32(rows)
            idx.extend([p, q, p + 1, p + 1, q, q + 1])
    mesh(vs, idx)

# ---------------- drawing ----------------

# The sky's own gradient under a Moon: its light in the air lifts the high sky a little toward blue
# (the horizon and the haze stay as they are, so the sea's far edge still meets the sky).
night_sky_top = (top: vec3, air: NightAir) -> vec3: top + vec3(0.012, 0.024, 0.05) * air.moonlight * (1.0 - air.cover)

# (the picture's height in real pixels: the scene is drawn smaller than the window on phones)
night_picture_height = () -> f64: max(f64(pixel_size().y) * quality_scene_scale(), 90.0)

# The stars, the planets and the Milky Way, over the sky's gradient and under twilight's glow band.
draw_night_stars = (L: Light, air: NightAir, t: f64):
    if air.limit < -5.5: return
    global night_planet_mesh
    vp = scene_view_proj()
    turn = sky_turn(L.sun_dir)
    dip = f32(night_horizon_dip(f64(scene_camera().y)))
    cull(.none)
    blend(.premultiplied)
    gain = milky_way_gain(air)
    if gain > 0.002: draw(milky_way_sh, milky_way_mesh, MilkyParams(vp, turn.ax, turn.ay, turn.az, vec4(f32(gain), air.extinction, dip, 0), far_depth()))
    # (sizes are in the pixels of a 720-line picture, so a star covers the same share of any
    # screen; a core never smaller than about a real pixel, or it would flicker as the view turns)
    lines = night_picture_height()
    unit = vec2(f32(2.0 / 720.0 / aspect_ratio()), f32(2.0 / 720.0))
    p = StarParams(vp, turn.ax, turn.ay, turn.az, vec4(air.limit, air.extinction, dip, f32(t % 1000.0)), vec4(air.moon, air.moonlight * 0.6 + air.glow * air.lit * 0.25), L.afterglow, vec4(unit, f32(0.95 * 720.0 / lines), 1.0), far_depth())
    draw(night_star_sh, night_star_mesh, p)
    update_mesh(night_planet_mesh, night_planet_vertices(L.planets, turn))
    draw(night_star_sh, night_planet_mesh, p)
    blend(.alpha)

# The Moon: its aureole, then its disc and tight glow, over twilight's glow band.
draw_night_moon = (L: Light, air: NightAir):
    moon = normalize(air.moon)
    height = f64(moon.y) + night_horizon_dip(f64(scene_camera().y))
    k = moon_look(air, L.sun_dir, height)
    if height < -f64(k.reach): return
    vp = scene_view_proj()
    cull(.none)
    blend(.premultiplied)
    # (the aureole rises before the Moon does, and stays a while after it sets)
    rise = f32(smoothstep(-0.1, 0.06, height))
    if k.aureole.w * rise > 0.003: draw(moon_aureole_sh, moon_aureole_mesh, AureoleParams(vp, moon, vec4(k.aureole.xyz, k.aureole.w * rise), k.reach, far_depth()))
    if height > -f64(SKY_DISC_RADIUS) * 1.5: draw(moon_disc_sh, moon_disc_mesh, moon_disc_params(k, moon, L.sun_dir, height, vp, far_depth()))
    blend(.alpha)

# (the GPU programs and meshes: made once the window is open)
init_night_sky = ():
    global night_star_sh, night_star_mesh, night_planet_mesh
    night_star_sh = make_shader(shader(night_star_vs, night_star_fs))
    night_star_mesh = build_night_stars()
    quad: u32[] = []
    loop k in 0..4:
        base = u32(k * 4)
        quad.extend([base, base + 1, base + 2, base, base + 2, base + 3])
    night_planet_mesh = mesh(night_planet_vertices([vec4(0, -1, 0, 0), vec4(0, -1, 0, 0), vec4(0, -1, 0, 0), vec4(0, -1, 0, 0)], sky_turn(vec3(1, 0, 0))), quad)
    global milky_way_sh, milky_way_mesh
    milky_way_sh = make_shader(shader(milky_way_vs, milky_way_fs))
    milky_way_mesh = build_milky_way()
    global moon_disc_sh, moon_disc_mesh
    moon_disc_sh = make_shader(shader(moon_disc_vs, moon_disc_fs))
    moon_disc_mesh = mesh([MoonVertex(vec2(-1, -1)), MoonVertex(vec2(1, -1)), MoonVertex(vec2(1, 1)), MoonVertex(vec2(-1, 1))], [u32(0), u32(1), u32(2), u32(0), u32(2), u32(3)])
    global moon_aureole_sh, moon_aureole_mesh
    moon_aureole_sh = make_shader(shader(moon_aureole_vs, moon_aureole_fs))
    moon_aureole_mesh = build_moon_aureole()
