# The night sky's lights: the Moon, the stars, the planets and the Milky Way, each drawn as its own
# small piece of geometry over the sky's gradient (sky.jo draws them, after its own triangle), the
# way the sun's disc is. Every one is an over-bright emitter as the eye and a photograph see it: a
# small near-white core with only a touch of its colour, and the colour in a halo about it.
#   the Moon      a billboard: its phase lit by the real Sun's direction, a hint of the maria, a tight
#                 glow hugging the lit limb, and a wide aureole (a fan of painted geometry, like
#                 twilight's glow band) that is wider in haze and weaker for a thin crescent. It comes
#                 out as a light from a little before sunset (celestial.jo moon_glow).
#   the stars     one mesh of small squares standing on the celestial sphere (the brighter real stars
#                 at their places, stargazing.jo's among them, and a few thousand fainter ones strewn
#                 by a fixed rule, thicker along the Milky Way), turned with the hour. Brightness,
#                 size, twinkle and what is seen at all are worked out at each star's corners; the
#                 pixels only draw the core, the halo and, for the brightest, a four-point glint.
#   the planets   four more squares through the stars' program, steady (no twinkle).
#   the Milky Way a band of painted geometry along the galactic equator, its light at each vertex.
# What is seen follows the faintest magnitude the sky lets through (night_air): twilight, moonlight,
# haze and cloud each take the faint stars first, and the Milky Way shows only on a dark, clear,
# moonless night. Nothing here adds to the sky's own program: that costs Intel GPUs half a
# millisecond a term, and these cost next to nothing.

use 'look.jo'
use 'celestial.jo'
use 'stargazing.jo'
use 'quality.jo'
use 'render_space.jo'

# ---------------- the night's air ----------------

struct NightAir:
    dark: f32 = 0.0                 # 0 by day .. 1 in full night (the sun's depth)
    limit: f32 = -9.0               # the faintest magnitude seen overhead
    extinction: f32 = 0.02          # how fast the low air dims a star (per air mass)
    moon: vec3 = vec3(0, -1, 0)
    lit: f32 = 0.0                  # the Moon's lit share (0 new .. 1 full)
    glow: f32 = 0.0                 # how far the Moon is out as a light (0 the day's pale wash .. 1)
    moonlight: f32 = 0.0            # how much the Moon washes the night sky (lit, up and dark)
    thick: f32 = 0.0                # the day's air (0 clear .. 1.4 heavy dust)
    cover: f32 = 0.0                # cloud overhead (0 none .. 1)

# The faintest magnitude seen by the sun's height (el, the sine of it): Venus before sunset, the
# first stars about 20 minutes after it, the faint ones only in full night.
NIGHT_EL = [-0.6, -0.45, -0.3, -0.2, -0.1, 0.0, 0.12]
NIGHT_LIMIT = [6.4, 5.3, 3.5, 1.8, -0.3, -2.8, -5.8]
night_limit = (el: f64) -> f64:
    if el <= NIGHT_EL[0]: return NIGHT_LIMIT[0]
    loop k in 0..NIGHT_EL.len()-1:
        if el < NIGHT_EL[k+1]:
            return mix(NIGHT_LIMIT[k], NIGHT_LIMIT[k+1], (el - NIGHT_EL[k]) / (NIGHT_EL[k+1] - NIGHT_EL[k]))
    -9.0

# How high a light stands over the visible horizon (the sine of it), from an eye `altitude` metres up.
night_horizon_dip = (altitude: f64) -> f64:
    h = max(altitude, 0.0)
    sqrt(h * (2.0 * EARTH_RADIUS + h)) / (EARTH_RADIUS + h)

# The night's air from the frame's light: cover is the cloud overhead (0..1, the weather's).
night_air = (L: Light, cover: f64 = 0.0, altitude: f64 = 0.0) -> NightAir:
    sun = normalize(L.sun_dir); moon = normalize(L.moon_dir)
    el = f64(sun.y)
    dark = 1.0 - smoothstep(-0.55, 0.0, el)
    lit = moon_illumination(sun, moon)
    up = smoothstep(-0.03, 0.12, f64(moon.y) + night_horizon_dip(altitude))
    thick = max(f64(L.turbidity), 0.0)
    # (a full Moon high up takes about two and a half magnitudes; haze one and a half and more;
    # washed air gives a little back)
    moonlight = lit * sqrt(lit) * up * dark
    limit = night_limit(el) - 2.5 * moonlight - 1.3 * thick + 0.5 * max(-f64(L.turbidity), 0.0) - 9.0 * cover
    NightAir(f32(dark), f32(limit), f32(0.035 + 0.04 * thick), moon, f32(lit), f32(moon_glow(el)), f32(moonlight), f32(thick), f32(cover))

# (in shaders, and on the CPU for the planets and the tests) How much of a point of light of
# magnitude `mag` is seen in the direction dir, y its height over the visible horizon: x what is
# seen of it (0..1), y what the low air leaves of its light (1 overhead .. 0 at the horizon).
#   air: x the faintest magnitude seen overhead, y the low air's dimming per air mass
#   moon: the Moon's direction, w how hard its glare takes the stars about it
#   glow: Light.afterglow (twilight's band low on the sun's side takes the stars in it)
night_seen = (dir: vec3, y: f32, mag: f32, air: vec4, moon: vec4, glow: vec4) -> vec2:
    mass = 1.0 / (max(y, 0.0) + 0.04) - 0.96
    left = exp(-air.y * mass)
    flat = dir.xz / max(length(dir.xz), 0.001)
    facing = dot(flat, glow.zw) * 0.5 + 0.5
    band = glow.x * exp(-max(y, 0.0) * glow.y * 0.9) * mix(0.22, 0.97, facing * facing * facing)
    away = 1.0 - dot(dir, moon.xyz)
    glare = moon.w * (exp(-away * 60.0) + exp(-away * 9.0) * 0.35)
    local = air.x - 3.5 * band - 4.0 * glare - air.y * mass * 3.0
    # (nothing shows through the Moon's own disc, lit or dark)
    behind = smoothstep(0.00042, 0.0009, away)
    vec2(smoothstep(0.0, 1.7, local - mag) * smoothstep(0.0, 0.05, y) * behind, left)

# ---------------- the celestial sphere ----------------

# The sphere's turn at this moment, from the sun's own direction (so it needs no clock): a star at
# the celestial place q = (cos dec cos ra, cos dec sin ra, sin dec) stands at ax q.x + ay q.y + az q.z,
# which is stargazing.jo's sky_star.
struct SkyTurn:
    ax: vec3
    ay: vec3
    az: vec3

const SKY_E1 = vec3(1, 0, 0)
const SKY_E2 = vec3(0, 0.93969262, -0.34202014)
const SKY_POLE = vec3(0, 0.34202014, 0.93969262)

sky_turn = (sun_dir: vec3) -> SkyTurn:
    s = normalize(sun_dir)
    a = atan2(f64(dot(s, SKY_E2)), f64(dot(s, SKY_E1)))
    c = f32(cos(a)); n = f32(sin(a))
    SkyTurn(SKY_E2 * c - SKY_E1 * n, SKY_E1 * c + SKY_E2 * n, SKY_POLE)

celestial_place = (ra_hours: f64, dec_degrees: f64) -> vec3:
    a = ra_hours / 12.0 * PI; d = dec_degrees * PI / 180.0
    vec3(f32(cos(d) * cos(a)), f32(cos(d) * sin(a)), f32(sin(d)))

sky_turned = (k: SkyTurn, q: vec3) -> vec3: k.ax * q.x + k.ay * q.y + k.az * q.z
sky_unturned = (k: SkyTurn, d: vec3) -> vec3: vec3(dot(d, k.ax), dot(d, k.ay), dot(d, k.az))

# The galaxy's frame among the stars (J2000): x toward its centre in Sagittarius, z its north pole.
GALAXY_X = celestial_place(17.7611, -28.936)
GALAXY_Z = celestial_place(12.8573, 27.128)
GALAXY_Y = normalize(cross(GALAXY_Z, GALAXY_X))
galactic_place = (l: f64, b: f64) -> vec3:
    GALAXY_X * f32(cos(b) * cos(l)) + GALAXY_Y * f32(cos(b) * sin(l)) + GALAXY_Z * f32(sin(b))

# ---------------- the stars ----------------

# The colour of a star by its spectral class: 0 B blue-white, 1 A white, 2 F yellow-white,
# 3 G yellow, 4 K orange, 5 M orange-red.
STAR_TINTS = [vec3(0.62, 0.76, 1.0), vec3(0.8, 0.88, 1.0), vec3(1.0, 0.96, 0.86), vec3(1.0, 0.9, 0.66), vec3(1.0, 0.73, 0.44), vec3(1.0, 0.52, 0.36)]

