# Saved activity state. Bookings are paid once and remain usable after a reload
# or an interrupted night's rest. No resident, money or inventory is invented.
struct ThermalVisit:
    place:int= -1
    active:bool=false
    sleeping:bool=false
    exit:vec3=vec3(0,0,0)
    last_minute:int=0
    until:int= -1
    paid_place:int= -1
    paid_until:int= -1

