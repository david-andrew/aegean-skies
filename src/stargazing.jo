PLANET_NAMES: str[] = ["Aphrodite (Venus)", "Dias (Jupiter)", "Ares (Mars)", "Kronos (Saturn)"]

const SUN_RA = 6.0                  # (the game's fixed summer: the sun at right ascension 6h)

# where a star at (ra hours, dec degrees) stands in the game's sky at an hour of the day
sky_star = (ra: f64, dec: f64, hour: f64) -> vec3:
    lst = SUN_RA + (hour - 12.0)
    h = (lst - ra) / 12.0 * PI      # (the hour angle, radians: positive west of the meridian)
    d = dec * PI / 180.0
    e1 = vec3(1, 0, 0)
    e2 = vec3(0, 0.93969262, -0.34202014)
    pole = vec3(0, 0.34202014, 0.93969262)
    normalize(e1 * f32(-sin(h) * cos(d)) + e2 * f32(cos(h) * cos(d)) + pole * f32(sin(d)))

# how dark it is for stars: 0 by day .. 1 in full night (from the sun's height)
star_night = (hour: f64) -> f64: clamp((-f64(sky_sun(hour).y) - 0.03) / 0.15, 0.0, 1.0)

struct Gaze:
    active = false
    yaw = 0.0                       # where one looks (the view drifts slowly round the sky)
    pitch = 1.1                     # (up from the horizon, radians)
    drift = 0.012                   # radians a second
    started = 0                     # (the world minute: for the notebook)
    seen: str[]                     # names one has looked at

gaze_step = (g: mut Gaze, dt: f64, turn: f64, tilt: f64):
    g.yaw += (g.drift + turn) * dt
    g.pitch = clamp(g.pitch + tilt * dt, 0.35, 1.5)

gaze_dir = (g: Gaze) -> vec3: vec3(f32(sin(g.yaw) * cos(g.pitch)), f32(sin(g.pitch)), f32(cos(g.yaw) * cos(g.pitch)))

# How faintly a name shows: by how near the middle of one's view it is (0 out of it .. 1 looked at)
name_alpha = (look: vec3, at: vec3, group: bool) -> f64:
    c = f64(dot(normalize(look), at))
    near = if group: 0.93 else: 0.965
    clamp((c - near) / (1.0 - near) * 1.6, 0.0, 1.0)
