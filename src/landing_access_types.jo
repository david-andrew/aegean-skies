# Compact baked shore access, shared by lake landings and isolated island quays.
struct LandingAccess:
    root:vec3
    tip:vec3
    out:vec2
    route:vec3[]
    width:f64=2.4
    stepped=false                   # a stepped footpath down a cliff, never a cart track
    stair_from= -1                  # route[stair_from..] is a built cliff stair down to the root: tread heights, not ground
