use 'living_far_types.jo'
enum MissionState: open, claimed, completed, failed, expired
struct WarMission:
    id: int
    kind: CommissionKind
    country: int
    origin: int
    destination: int
    target: int
    escrow: int
    reward: int
    posted: int
    deadline: int
    why: str
    poster = -1
    carrier = -1
    commission = -1
    state: MissionState = .open
    progress_ticks = 0
    required_ticks = 7200
    last_tick = -1
    observed_controller = -1
    observed_minute = -1
    rescue_baseline = 0
    completed_minute = -1
    paid = 0
    last_target_pos: vec3
    last_actor_pos: vec3
    target_journey = -1

struct MissionView:
    id: int
    kind: CommissionKind
    country: int
    origin: int
    destination: int
    target: int
    reward: int
    deadline: int
    state: MissionState
    progress: int
    required: int
    commission: int
    why: str
