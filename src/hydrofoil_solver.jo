# The hydrofoils and the water screw in the flight model's contact solver (flight.jo _substep calls
# hydrofoil_contacts with the wet substep's force and torque), and the clutch kept going in the air.
# The arithmetic is hydrofoil.jo's; this is where it meets the craft's state and the sea.
use 'flight.jo'
use 'hydrofoil.jo'
use 'damage.jo'

# Forces from every immersed foil and the screw, and the clutch stepped. Returns how much of her
# is "wet" (the foils count a little, so on the foils she is on the water, with its attitude damping,
# but none of a planing hull's lift).
hydrofoil_contacts = (k: CraftSpec, s: mut CraftState, c: Controls, e: FlightEnv, omega_world: vec3, force: mut vec3, torque: mut vec3, dt: f64) -> f64:
    if k.foils.len() == 0: return 0.0
    f = quat_rotate(s.orientation, vec3(0, 0, -1)); u = quat_rotate(s.orientation, vec3(0, 1, 0))
    inv = quat_inverse(s.orientation)
    wet = 0.0; lift = 0.0
    loop foil in k.foils:
        arm = quat_rotate(s.orientation, foil.point)
        at = craft_offset(s, arm)
        sea = sea_surface(e, at.x, at.z, s.time)
        depth = sea.height - at.y
        if depth <= 0.0: continue
        v = s.velocity + cross(omega_world, arm) - e.current - e.current_at(at.x, at.z) - vec3(0, f32(sea.vertical_speed), 0)
        fd = foil_force(foil, depth, f64(dot(v, f)), f64(dot(v, u)))
        flow = if length(v) > 0.01: normalize(v) else: f
        b = u * fd.x - flow * fd.y
        force += b
        torque += quat_rotate(inv, cross(arm, b))
        lift += f64(fd.x)
        wet += 0.15
    # the hull out of the water? the air propeller's lowest blade?
    hull_clear = true
    loop pt in k.contacts:
        if abs(f64(pt.x)) > 1.0: continue          # (the wing tips' own)
        p = craft_offset(s, quat_rotate(s.orientation, pt))
        if p.y < sea_surface(e, p.x, p.z, s.time).height: hull_clear = false
    hub = craft_offset(s, quat_rotate(s.orientation, k.prop_hub))
    s.foil.prop_wet = hub.y - k.prop_radius * 0.95 < sea_surface(e, hub.x, hub.z, s.time).height
    speed = f64(dot(s.velocity - e.current, f))
    clutch_step(s.foil, dt, false, hull_clear, not s.foil.prop_wet, speed, clamp(c.throttle, 0.0, 1.0), c.clutch)
    # the water screw, pushing along the hull from below the tail
    arm = quat_rotate(s.orientation, k.screw)
    at = craft_offset(s, arm)
    depth = sea_surface(e, at.x, at.z, s.time).height - at.y
    thrust = screw_thrust(s.throttle, speed, depth, screw_drive(s.foil))
    b = f * f32(thrust)
    force += b
    torque += quat_rotate(inv, cross(arm, b))
    s.foil.screw = thrust
    # (an air propeller driven in the sea: it beats the water, and the engine takes the blows;
    # declutched, only windmilling slowly through it, a little drag and no harm)
    if s.foil.prop_wet and s.foil.air > 0.3 and s.throttle > 0.2:
        s.damage.parts[1].health = max(0.0, s.damage.parts[1].health - 0.08 * s.foil.air * s.throttle * dt)
        force -= f * f32(k.mass * 0.8 * s.foil.air * speed)
    else if s.foil.prop_wet:
        force -= f * f32(k.mass * 0.006 * speed)
    s.foil.lift = lift / (k.mass * FLIGHT_G)
    wet

# In the air: the clutch goes over (and stays), and the air propeller's share of the thrust.
hydrofoil_air = (k: CraftSpec, s: mut CraftState, c: Controls, dt: f64) -> f64:
    if k.foils.len() == 0: return 1.0
    s.foil.prop_wet = false; s.foil.lift = 0.0; s.foil.screw = 0.0
    clutch_step(s.foil, dt, true, true, true, f64(length(s.velocity)), clamp(c.throttle, 0.0, 1.0), c.clutch)
    air_drive(s.foil)

# The air propeller's share of the engine on the water (1 for every craft without foils).
foil_air_share = (k: CraftSpec, s: CraftState) -> f64: if k.foils.len() == 0: 1.0 else: air_drive(s.foil)
