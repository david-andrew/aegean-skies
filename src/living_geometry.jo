# The only terrain dependency; no renderer or Town import.
use 'living_types.jo'
use 'living_guard.jo'
import 'world.jo' as terrain

build_harbors = () -> HarborGeometry[]:
    if terrain.land_tiles.len() == 0:
        b = read_bytes("assets/terrain.bin")
        if b is u8[]: terrain.load_land(b)
    result: HarborGeometry[]
    loop id in 0..terrain.SETTLEMENTS.len():
        s = terrain.SETTLEMENTS[id]
        coast, out = terrain.coast_point(s.island,s.bearing)
        tangent = vec2(-out.y,out.x)
        qlen = if s.kind == .port: 70.0 else: if s.kind == .cove: 25.0 else: 45.0
        docks: vec3[]
        loop side in [-1.0,1.0]:
            p = coast + out * f32(qlen - 12.0) + tangent * f32(side * 10.0)
            docks.push(vec3(p.x,0,p.y))
        if id == 0:
            p = coast + tangent * 89.0 + out * 45.0
            docks.push(vec3(p.x,0,p.y))
        center = vec3(coast.x,0,coast.y)
        outward = vec3(out.x,0,out.y)
        safe = center + outward * 300.0
        assert(terrain.height(safe.x,safe.z) <= 0.0)
        result.push(HarborGeometry(id,center,outward,docks,center + outward * 200.0,safe,safe))
    result

# Stable shared crosswind pattern; geometry, never camera position, determines it.
porto_gate = (h: HarborGeometry) -> vec3[]:
    tangent = vec3(-h.out.z,0,h.out.x)
    distance = 900
    loop distance <= 2000:
        p = h.center + h.out * f32(distance)
        clear = true
        loop side in [-600.0,0.0,500.0]:
            q = p + tangent * f32(side)
            if terrain.height(q.x,q.z) > 100: clear = false
        if clear:
            return [p - tangent * 600.0 + vec3(0,300,0), p + vec3(0,300,0), p + tangent * 500.0 + vec3(0,300,0)]
        distance += 100
    living_fault("geometry.porto_gate","harbour={h.place} at={h.center}; Porto crosswind geometry obstructed")
    []

bake_route = (w: World, origin: int, destination: int, start: vec3) -> vec3[]:
    a = w.harbors[origin]; b = w.harbors[destination]
    out = a.center + a.out * 1500.0
    approach = b.center + b.out * 1500.0
    altitude = 500.0
    count = max(1,int(ceil(f64(length(approach-out))/250.0)))
    loop i in 0..count+1:
        p = lerp(out,approach,f32(f64(i)/f64(count)))
        altitude = max(altitude,terrain.height(p.x,p.z)+150.0)
    points = [start,a.center + a.out * 100.0,out + vec3(0,f32(altitude),0),approach + vec3(0,f32(altitude),0)]
    if destination == 0:
        gate = porto_gate(b)
        if gate.len() == 0: return []
        points.extend(gate)
    points.push(b.center + b.out * 250.0 + vec3(0,150,0))
    points.push(b.buoy)
    points


water_segment = (a: vec3, b: vec3) -> bool:
    count = max(1,int(ceil(f64(length(b-a))/50.0)))
    loop i in 0..count+1:
        point = lerp(a,b,f32(f64(i)/f64(count)))
        if terrain.height(point.x,point.z) > -0.5: return false
    true

water_path_valid = (points: vec3[]) -> bool:
    loop s in 0..points.len()-1:
        if not water_segment(points[s],points[s+1]): return false
    true

path_length = (points: vec3[]) -> f64:
    total = 0.0
    loop s in 0..points.len()-1: total += f64(length(points[s+1]-points[s]))
    total

# Conservative water-only routes. Outer sea corners bypass islands; choose shortest valid arc.
# Baked at construction, never from a per-minute planner or the camera.
water_route = (harbors: HarborGeometry[], origin: int, destination: int) -> vec3[]:
    a = harbors[origin]; b = harbors[destination]
    best: vec3[]
    distance = 1e30
    direct = [a.buoy,a.safe_water,b.safe_water,b.buoy]
    if water_path_valid(direct): return direct
    corners = [vec3(-10500,0,-10500),vec3(10500,0,-10500),vec3(10500,0,10500),vec3(-10500,0,10500)]
    loop first in 0..4:
        if not water_segment(a.safe_water,corners[first]): continue
        loop last in 0..4:
            if not water_segment(corners[last],b.safe_water): continue
            loop direction in [-1,1]:
                points = [a.buoy,a.safe_water,corners[first]]
                corner = first
                loop corner != last:
                    corner = (corner+direction+4)%4
                    points.push(corners[corner])
                points.push(b.safe_water); points.push(b.buoy)
                length_m = path_length(points)
                if length_m < distance and water_path_valid(points): best = points; distance = length_m
    best

cached_sea_key: u64 = u64(0)
cached_sea_routes: {int: vec3[]}
build_sea_routes = (harbors: HarborGeometry[], packed: bool = true) -> {int: vec3[]}:
    global cached_sea_key, cached_sea_routes
    key = hash(harbors) xor u64(terrain.terrain_key())
    if packed: key = key xor u64(0x71)
    if key == cached_sea_key and cached_sea_routes.len() > 0: return cached_sea_routes
    routes: {int: vec3[]}
    loop origin in 0..harbors.len():
        loop destination in 0..harbors.len():
            if origin == destination: continue
            route = water_route(harbors,origin,destination)
            if route.len() >= 2: routes[if packed: route_pair(origin,destination) else: origin*harbors.len()+destination] = route
    cached_sea_key = key; cached_sea_routes = routes
    routes
