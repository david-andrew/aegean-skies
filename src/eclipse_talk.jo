# What people say of an eclipse in the days before and after it (the weather topic,
# living_talk_context.jo): a line or two, understated, only for the ones worth remarking on (a good
# bite out of the Sun at the islands, or the Moon well into the umbra). Uses only the table, so the
# living world needs nothing of the sky's drawing.
use 'eclipse_table.jo'

# (how much of the Sun the islands see at greatest, from the row's model at the map's origin)
_talk_solar_cover = (r: EclipseRow) -> f64:
    best = 9.0
    h = r.span / 60.0
    loop i in 0..121:
        t = -h + 2.0 * h * f64(i) / 120.0
        ox = r.cx[0] + r.cx[1] * t + r.cx[2] * t * t + r.cx[3] * t * t * t + r.cx[4] * t * t * t * t
        oy = r.cy[0] + r.cy[1] * t + r.cy[2] * t * t + r.cy[3] * t * t * t + r.cy[4] * t * t * t * t
        best = min(best, sqrt(ox * ox + oy * oy))
    # (the share of the Sun's diameter covered: a plain measure for talk)
    clamp((1.0 + r.k - best) / 2.0, 0.0, 1.0)

_talk_lunar_depth = (r: EclipseRow) -> f64:
    best = 9.0
    h = r.span / 60.0
    loop i in 0..61:
        t = -h + 2.0 * h * f64(i) / 60.0
        ox = r.cx[0] + r.cx[1] * t + r.cx[2] * t * t
        oy = r.cy[0] + r.cy[1] * t + r.cy[2] * t * t
        best = min(best, sqrt(ox * ox + oy * oy))
    (r.k + 1.0 - best) / 2.0

_talk_cap = (s: str) -> str: if s.len() == 0: s else: upper(s[0..1]) + s[1..]

_talk_day_words = (days: int) -> str:
    match days:
        -2: "the day before yesterday"
        -1: "yesterday"
        0: "today"
        1: "tomorrow"
        2: "the day after tomorrow"
        _: if days > 0: "in {days} days" else: "a few days ago"

# Lines about an eclipse within three days of world minute `minute` (local midnight to midnight), or none.
eclipse_talk_lines = (minute: int, local_offset: int = 570) -> str[]:
    out: str[]
    today = int(floor(f64(minute + local_offset) / 1440.0))
    loop r in ECLIPSE_ROWS:
        day = int(floor((r.minute + f64(local_offset)) / 1440.0))
        d = day - today
        if d < -3 or d > 3: continue
        said = _talk_day_words(d)
        if r.solar:
            c = _talk_solar_cover(r)
            if c < 0.3: continue
            total = r.k > 1.0 and c > 0.995
            if d > 0:
                out.push(if total: "They say the sun will go out altogether {said}. The schoolmaster is smoking bits of glass." else: "The paper says the moon takes a bite out of the sun {said}.")
                out.push("An eclipse of the sun {said}, they say. Don't look at it without a smoked glass.")
            else if d == 0:
                out.push(if total: "This is the day the sun goes dark. Have you a smoked glass?" else: "The eclipse is today. Look through a smoked glass, mind.")
            else:
                out.push(if total: "Did you see the sun go out {said}? The dogs went quiet, and there were stars." else: "Did you see the eclipse {said}? The light went strange, like a storm coming.")
                out.push(if total: "{_talk_cap(said)} the birds all came down to roost in the middle of the morning." else: "A bite out of the sun {said}. My hens went to roost.")
        else:
            depth = _talk_lunar_depth(r)
            if depth < 0.3: continue
            if d > 0: out.push("The moon is to be eclipsed {said}, at night. Worth staying up for.")
            else if d == 0: out.push("The moon's to be eclipsed tonight.")
            else: out.push(if depth > 1.0: "The moon went red as copper {said}. My grandmother crossed herself." else: "Did you see the moon go dark on one side {said}?")
    out

