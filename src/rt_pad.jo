# The R/T to one's own flight: the radio-telephone's few set words, as a flight leader of the time
# had them (form on me, circle and wait, attack, break off and go home, lead me home), on a small
# pad by the radio. Opened with Y (a controller's R/T button, D-pad left in the air; a tap on the
# R/T plate by the radio), then a number, a click or a tap on a line, or the R/T button again to
# step down the lines and F (the controller's A) to send. It stays open, however long one reads
# it, until a word is sent, or it is put away: Escape, or its Close line (clicked or tapped). Down on the sea it carries the call for help too (a flare
# when no one is in the R/T's reach), and, help coming, waiting for it. Drawing and choosing only:
# combat.jo's give_order and radio_help.jo act.
use 'combat.jo'
use 'hud.jo'
use 'touch.jo'

struct RtPad:
    open = false
    focus = 0
    since = 0.0                     # the last touch on it (s)
    took_mouse = false              # (the mouse was the camera's when it opened: given back after)
    lines: int[]                    # the words on it now (indices into RT_WORDS)

RT_WORDS = ["Form on me", "Circle here and wait", "Attack my target", "Break off, go home", "Lead me home", "Call for help", "Fire a flare", "Wait for them", "Ierax, anything going?"]
RT_KINDS: OrderKind[] = [.form_on_me, .circle, .attack, .go_home, .lead_home, .none, .none, .none, .none]
const RT_HELP = 5
const RT_FLARE = 6
const RT_WAIT = 7
const RT_IERAX = 8

rt_open = (r: mut RtPad, now: f64, lines: int[]):
    r.open = true; r.focus = 0; r.since = now; r.lines = lines

rt_close = (r: mut RtPad):
    r.open = false

# What the keys say this frame: -1 nothing, else the word chosen (its RT_WORDS index). `step`: the R/T key again;
# `send`: F or the controller's A; `number`: 1..5 (0 none); `escape`.
rt_keys = (r: mut RtPad, step: bool, send: bool, number: int, escape: bool, now: f64) -> int:
    if not r.open: return -1
    if escape: rt_close(r); return -1
    if number >= 1 and number <= r.lines.len(): rt_close(r); return r.lines[number-1]
    if step: r.focus = (r.focus+1)%max(1,r.lines.len()); r.since = now
    if send and r.focus < r.lines.len(): rt_close(r); return r.lines[r.focus]
    -1

# The pad, at the left of the screen: each line a button (a click or a tap sends it). Returns the
# word clicked (its RT_WORDS index), or -1.
draw_rt_pad = (r: mut RtPad, fonts: Fonts, now: f64, touch: bool) -> int:
    global hud_style
    if not r.open: return -1
    sw = f64(screen_width()); sh = f64(screen_height())
    w = min(320.0, sw*0.4); row = 34.0; gap = 4.0
    x = 20.0; y = sh*0.30
    h = 30.0+f64(r.lines.len())*(row+gap)+26.0
    # (on a touch screen: clear of the throttle at the left, its label and handle, and its touches)
    if touch:
        tr = throttle_track()
        x = f64(tr.x + tr.w) + 24.0; y = max(f64(tr.y + tr.h) - h, 60.0)
        w = min(w, sw - x - 20.0)
    rect_rounded(x-8.0,y-8.0,w+16.0,h+16.0,6,rgba(0.05,0.07,0.10,0.78))
    set_font(fonts.ui)
    text("R/T",vec2(f32(x),f32(y)),18,rgba(1,0.97,0.9,0.95))
    chose = -1
    saved = hud_style
    hud_style.text_size = 14.0
    # (put away without a word: a click or a tap on Close)
    shut = hud_button(Rect(x+w-74.0,y-6.0,74.0,26.0),"Close",align = .center)
    y += 30.0
    hud_style.text_size = 16.0
    loop k in 0..r.lines.len():
        if hud_button(Rect(x,y,w,row),"{k+1}   {RT_WORDS[r.lines[k]]}",selected = r.focus == k,align = .left): chose = r.lines[k]
        y += row+gap
    hud_style = saved
    hint = if touch: "Tap a line to send it" else: "1-{r.lines.len()} to send   Y next   F send   Esc close"
    text(fit_text(hint,w,13),vec2(f32(x),f32(y+4.0)),13,rgba(1,0.97,0.9,0.6))
    set_font()
    if chose >= 0 or shut: rt_close(r)
    chose

# What a wingman says back: short and plain.
rt_answer = (kind: OrderKind, has_target: bool) -> str:
    match kind:
        .form_on_me: "Forming on you."
        .circle: "Circling here. We'll wait."
        .attack: if has_target: "Going for that one." else: "Which one? I can't see who you mean."
        .go_home: "Breaking off. Home."
        .lead_home: "Follow me. Home this way."
        _: ""

# The one who answers, and what they say: true to where they are. One of the flight far off says
# how far and which way ("On our way. Eight kilometres north of you."); "follow me" only from a
# leader in the player's sight (one farther off comes first, and says so); the flight all down at
# its base says that, and where the base lies.
struct RtReply:
    craft = -1                      # who answers (aircraft ID; -1: no one)
    number = 0                      # their number in the flight (1 the first)
    words = ""

# A lead-me-home being answered: whether its "follow me" has been said, for the word that comes
# later, the leader come in sight (or lost again).
struct RtWatch:
    tick = -1
    met = false

const RT_NEAR = 1500.0              # one of the flight this near: with the player, no need to say where

_RT_ONES: str[] = ["no","one","two","three","four","five","six","seven","eight","nine","ten","eleven","twelve","thirteen","fourteen","fifteen","sixteen","seventeen","eighteen","nineteen"]
_RT_TENS: str[] = ["","","twenty","thirty","forty","fifty","sixty","seventy","eighty","ninety"]
rt_number = (n: int) -> str:
    if n < 0 or n > 99: return "{n}"
    if n < 20: return _RT_ONES[n]
    if n%10 == 0: return _RT_TENS[n/10]
    "{_RT_TENS[n/10]}-{_RT_ONES[n%10]}"

# Where `there` lies from `here`, as said on the R/T: "eight kilometres north of you".
rt_where = (here: vec3, there: vec3) -> str:
    d = vec3(there.x-here.x,0,there.z-here.z)
    km = max(1,int(round(f64(length(d))/1000.0)))
    points = ["north","north-east","east","south-east","south","south-west","west","north-west"]
    k = int(round(atan2(f64(d.x),-f64(d.z))/(PI/4.0)))
    "{if km == 1: "a kilometre" else: "{rt_number(km)} kilometres"} {points[((k%8)+8)%8]} of you"

_rt_cap = (s: str) -> str: if s.len() == 0: s else: s[0..1].upper()+s[1..s.len()]

# One of a side's flight by its place in it: its number (1 the first; the player counted).
_rt_numbered = (b: Battle, side: int, index: int) -> int:
    n = 0
    loop i in 0..b.actors.len():
        if b.actors[i].side != side: continue
        n += 1
        if i == index: return n
    max(1,n)

# The answer to a word just sent (`heard`: how many give_order found to hear it; `base`: the
# name of the flight's base). No words: no one on the R/T.
rt_reply = (b: Battle, by: int, kind: OrderKind, has_target: bool, heard: int, base: str, watch: mut RtWatch) -> RtReply:
    me = combat_index(b,by)
    if me < 0: return RtReply()
    side = b.actors[me].side; at = b.actors[me].state.position
    if heard == 0:
        # (the flight all down and tied up: the first of them says so, and where)
        first = -1
        loop i in 0..b.actors.len():
            a = b.actors[i]
            if a.side != side or a.human or a.status != .flying or not a.present or not a.pilot.home_done: continue
            if first < 0 or a.pilot.home_turn < b.actors[first].pilot.home_turn: first = i
        if first < 0: return RtReply()
        there = b.actors[first].state.position
        far = f64(length(vec3(there.x-at.x,0,there.z-at.z)))
        return RtReply(b.actors[first].craft,_rt_numbered(b,side,first),if far < RT_NEAR: "We're down at {base}. Come in." else: "We're down at {base}, {rt_where(at,there)}.")
    # (the nearest of those up answers; leading home, the one who will lead)
    best = -1; near = 1e18
    loop i in 0..b.actors.len():
        a = b.actors[i]
        if a.side != side or a.human or a.status != .flying or not a.present or a.pilot.home_done: continue
        d = f64(length(a.state.position-at))
        if d < near: near = d; best = i
    if kind == .lead_home:
        lead = home_leader(b,side)
        if lead >= 0:
            l = b.actors[lead]
            # (the last of the flight already on the water or the end of its approach: no one to
            # come; it says where the base lies)
            if l.pilot.home_done or l.state.on_water or (l.pilot.plan.initialized and (l.pilot.plan.phase == .land or l.pilot.plan.phase == .taxi)):
                watch.tick = b.orders[side].tick; watch.met = true
                return RtReply(l.craft,_rt_numbered(b,side,lead),"We're landing at {base}, {rt_where(at,l.state.position)}.")
            best = lead; near = f64(length(l.state.position-at))
    if best < 0: return RtReply()
    there = b.actors[best].state.position
    wet = b.actors[me].state.on_water
    words = rt_answer(kind,has_target)
    if kind == .form_on_me:
        if near >= RT_NEAR: words = "On our way. {_rt_cap(rt_where(at,there))}."
        else if wet: words = "Circling over you till you're up."
    if kind == .circle and near >= RT_NEAR*2.0: words = "Coming to circle over you. {_rt_cap(rt_where(at,there))}."
    if kind == .lead_home:
        watch.tick = b.orders[side].tick
        watch.met = near < LEAD_SIGHT and not wet
        if wet: words = if near < RT_NEAR*2.0: "Circling over you. Follow me home when you're up." else: "Coming to you. {_rt_cap(rt_where(at,there))}. Follow me home when you're up."
        else if not watch.met: words = "Coming to you. {_rt_cap(rt_where(at,there))}. Then follow me home."
    RtReply(b.actors[best].craft,_rt_numbered(b,side,best),words)

# The leader's later word on a lead-me-home: "follow me" as it comes in sight of the player; that
# it has lost them, turning back. No words: nothing new.
rt_later = (b: Battle, by: int, watch: mut RtWatch) -> RtReply:
    me = combat_index(b,by)
    if me < 0: return RtReply()
    side = b.actors[me].side
    if side < 0 or side > 2: return RtReply()
    o = b.orders[side]
    if o.kind != .lead_home or o.by != by or o.tick != watch.tick: return RtReply()
    met = o.met >= 0
    if met == watch.met: return RtReply()
    watch.met = met
    lead = home_leader(b,side)
    if lead < 0: return RtReply()
    RtReply(b.actors[lead].craft,_rt_numbered(b,side,lead),if met: "Follow me. Home this way." else: "Lost sight of you. Coming back.")
