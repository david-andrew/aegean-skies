# The R/T to one's own flight: the radio-telephone's few set words, as a flight leader of the time
# had them (form on me, circle and wait, attack, break off and go home, lead me home), on a small
# pad by the radio. Opened with C (a controller's R/T button, D-pad left in the air; a tap on the
# R/T plate by the radio), then a number, a click or a tap on a line, or the R/T button again to
# step down the lines and F (the controller's A) to send. It closes when a word is sent, on
# Escape, or after a few idle seconds. Drawing and choosing only: combat.jo's give_order acts.
use 'combat.jo'
use 'hud.jo'

struct RtPad:
    open = false
    focus = 0
    since = 0.0                     # the last touch on it (s)
    took_mouse = false              # (the mouse was the camera's when it opened: given back after)

RT_WORDS = ["Form on me", "Circle here and wait", "Attack my target", "Break off, go home", "Lead me home"]
RT_KINDS: OrderKind[] = [.form_on_me, .circle, .attack, .go_home, .lead_home]
const RT_IDLE = 6.0

rt_open = (r: mut RtPad, now: f64):
    r.open = true; r.focus = 0; r.since = now

rt_close = (r: mut RtPad):
    r.open = false

# What the keys say this frame: -1 nothing, else the line chosen. `step`: the R/T key again;
# `send`: F or the controller's A; `number`: 1..5 (0 none); `escape`.
rt_keys = (r: mut RtPad, step: bool, send: bool, number: int, escape: bool, now: f64) -> int:
    if not r.open: return -1
    if escape or now-r.since > RT_IDLE: rt_close(r); return -1
    if number >= 1 and number <= RT_WORDS.len(): rt_close(r); return number-1
    if step: r.focus = (r.focus+1)%RT_WORDS.len(); r.since = now
    if send: rt_close(r); return r.focus
    -1

# The pad, at the left of the screen: each line a button (a click or a tap sends it). Returns the
# line clicked, or -1.
draw_rt_pad = (r: mut RtPad, fonts: Fonts, now: f64, touch: bool) -> int:
    global hud_style
    if not r.open: return -1
    sw = f64(screen_width()); sh = f64(screen_height())
    w = min(320.0, sw*0.4); row = 34.0; gap = 4.0
    x = 20.0; y = sh*0.30
    h = 30.0+f64(RT_WORDS.len())*(row+gap)+26.0
    rect_rounded(x-8.0,y-8.0,w+16.0,h+16.0,6,rgba(0.05,0.07,0.10,0.78))
    set_font(fonts.ui)
    text("R/T  to the flight",vec2(f32(x),f32(y)),18,rgba(1,0.97,0.9,0.95))
    y += 30.0
    chose = -1
    saved = hud_style
    hud_style.text_size = 16.0
    loop k in 0..RT_WORDS.len():
        if hud_button(Rect(x,y,w,row),"{k+1}   {RT_WORDS[k]}",selected = r.focus == k,align = .left): chose = k
        y += row+gap
    hud_style = saved
    hint = if touch: "Tap a line to send it" else: "1-5 to send   C next   F send   Esc close"
    text(fit_text(hint,w,13),vec2(f32(x),f32(y+4.0)),13,rgba(1,0.97,0.9,0.6))
    set_font()
    if chose >= 0: rt_close(r)
    chose

# What a wingman says back: short and plain.
rt_answer = (kind: OrderKind, has_target: bool) -> str:
    match kind:
        .form_on_me: "Forming on you."
        .circle: "Circling here. We'll wait."
        .attack: if has_target: "Going for that one." else: "Which one? I can't see who you mean."
        .go_home: "Breaking off. Home."
        .lead_home: "Follow me. Home this way."
        _: ""
