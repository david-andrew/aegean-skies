use 'depth_space.jo'
use 'cloud_depth.jo'
# The sea: one wide disc of rings around the camera, finer near it. Waves are worked out per
# pixel from a sum of swells; the water's color comes from its depth (a map of the sea floor made
# once from world.jo): deep cobalt in the open sea, turquoise over sand, see-through at the shore,
# with foam where it meets the land and the sun's glitter on it.

use 'world.jo'
use 'geography.jo'
use 'look.jo'
use 'render_space.jo'
use 'weather_scene.jo'

const DEPTH_MAP = 1024
const DEPTH_EXTENT = 24000.0        # the depth map's square, meters across (past it: open sea)

struct SeaVertex:
    pos: vec3

struct SeaParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    sky_top: vec3
    sky_horizon: vec3
    haze: vec3
    deep: vec3
    shallow: vec3
    fog: f32
    time: f32
    rough: f32                      # 0 a calm sea, 1 a rough one (weather)
    wind: vec4                      # the way it blows (x, z), its speed, and (w) the swell's height
    drift: vec2                     # how far the gusts have moved
    rush: vec4                      # the camera's velocity (x, y, z) and how strongly the sea streaks past (w)
    shade: vec4[32]                 # aircraft shadows on the sea: quads (corners a, b; c, d as x, z pairs)
    shade_alpha: vec4[4]            # each quad's darkness (four to a vec4)
    shade_n: f32
    depth: Texture
    world_depth: Texture
    local_depth: Texture
    local_area: vec4                # center x,z, extent, valid
    expanded: f32
    rays: mat4
    center: vec2
    residual: vec2
    flow: vec4                      # the near detail's extra drift (x, z m/s), its cycle (s), and (w) 1: the whole sea's look slides
    warp_a: vec4                    # (the speed trial's warp: render_space.jo)
    warp_b: vec4
    origin: vec3 = vec3(0,0,0)
    shade_bounds: vec4 = vec4(0,0,0,0)
    shade_pad: f32 = 1.0
    rain: f32 = 0.0
    swell_phase: vec4[6]
    ripple_phase: vec4[5]
    glint_phase: vec4
    opaque_depth: Texture
    reject_depth: f32 = 0
    mark_phase: vec4[3]             # fractional cell origin xy, integer cell identity zw

struct SeaOut:
    pos: vec4
    world: vec3

struct SeaDepthOut:
    pos:vec4
    world:vec3
    clip:vec4

# the swells: height and slope (dh/dx, dh/dz) at a point, running mostly with the wind. Each
# fades out where it is too short for the pixels to show it (dist: from the camera).
_swell = (p: vec2, t: f32, amp: f32, dist: f32, wd: vec2) -> vec3:
    # All six bands have reached exactly zero beyond the longest fade.
    if dist >= 2440.0: return vec3(0,0,0)
    h: f32 = 0.0
    dx: f32 = 0.0
    dz: f32 = 0.0
    turns: f32[6] = [0.0, 0.45, -0.5, 0.9, -0.25, 0.2]
    lens: f32[6] = [61.0, 37.0, 23.0, 13.0, 7.3, 4.1]
    loop k in 0..6:
        a = turns[k]
        d = vec2(wd.x * cos(a) - wd.y * sin(a), wd.x * sin(a) + wd.y * cos(a))
        len = lens[k]
        w = 6.2831853 / len
        fade = 1.0 - smoothstep(len * 9.0, len * 40.0, dist)
        hk = len * amp * fade
        ph = dot(d, p) * w - t * sqrt(9.8 * w)
        h += hk * sin(ph)
        c = hk * w * cos(ph)
        dx += c * d.x
        dz += c * d.y
    vec3(h, dx, dz)

sea_vs = (v: SeaVertex, u: SeaParams) -> SeaOut:
    # The chart origin snaps, but its residual moves continuously. A snap
    # must not resample the displaced near rings or move any procedural phase.
    p = v.pos.xz + u.residual
    r = length(p - u.cam.xz)
    near = 1.0 - smoothstep(80.0, 260.0, r)
    s = sea_swell(p,u,r)
    w = vec3(p.x, s.x * near, p.y)
    clip=u.view_proj * vec4(render_warped(w,u.cam,u.warp_a,u.warp_b),1)
    SeaOut(clip,w)

sea_depth_vs=(v:SeaVertex,u:SeaParams)->SeaDepthOut:
    i=sea_vs(v,u)
    SeaDepthOut(i.pos,i.world,i.pos)

# Wave directions/frequencies and the anchor/time phase are reduced on the CPU.
# Small local dot products retain sub-centimetre wave motion at every world corner.
sea_swell_band = (p: vec2,band: vec4,amp: f32,dist: f32) -> vec3:
    fade=1.0-smoothstep(band.w*9.0,band.w*40.0,dist)
    phase=dot(band.xy,p)+band.z
    height=band.w*amp*fade
    slope=height*cos(phase)
    vec3(height*sin(phase),slope*band.x,slope*band.y)

sea_swell = (p: vec2,u: SeaParams,dist: f32) -> vec3:
    if dist>=2440.0:return vec3(0,0,0)
    # Constant uniform indices avoid a per-pixel dynamic array loop on Intel.
    result=vec3(0,0,0)
    result += sea_swell_band(p,u.swell_phase[0],u.wind.w,dist)
    result += sea_swell_band(p,u.swell_phase[1],u.wind.w,dist)
    result += sea_swell_band(p,u.swell_phase[2],u.wind.w,dist)
    result += sea_swell_band(p,u.swell_phase[3],u.wind.w,dist)
    result += sea_swell_band(p,u.swell_phase[4],u.wind.w,dist)
    result += sea_swell_band(p,u.swell_phase[5],u.wind.w,dist)
    result

sea_ripple_band = (p: vec2,band: vec4,dist: f32) -> vec2:
    fade=1.0-smoothstep(band.w*14.0,band.w*60.0,dist)
    # The vector already contains tau/wavelength; recover its direction with
    # multiplication, preserving the original wind magnitude without sqrt.
    band.xy*(band.w*(0.07/6.28318530718)*cos(dot(band.xy,p)+band.z)*fade)

sea_ripples = (p: vec2,u: SeaParams,dist: f32) -> vec2:
    if dist>=186.0:return vec2(0,0)
    result=vec2(0,0)
    result += sea_ripple_band(p,u.ripple_phase[0],dist)
    result += sea_ripple_band(p,u.ripple_phase[1],dist)
    result += sea_ripple_band(p,u.ripple_phase[2],dist)
    result += sea_ripple_band(p,u.ripple_phase[3],dist)
    result += sea_ripple_band(p,u.ripple_phase[4],dist)
    result

# fine ripples raised by the wind (their slope), shorter than the swells, filtered by distance
_ripples = (p: vec2, t: f32, wd: vec2, dist: f32) -> vec2:
    if dist >= 186.0: return vec2(0,0)
    turns: f32[5] = [0.3, -0.35, 0.75, -0.8, 0.05]
    lens: f32[5] = [3.1, 2.3, 1.6, 1.15, 0.8]
    g = vec2(0, 0)
    loop k in 0..5:
        a = turns[k]
        d = vec2(wd.x * cos(a) - wd.y * sin(a), wd.x * sin(a) + wd.y * cos(a))
        w = 6.2831853 / lens[k]
        fade = 1.0 - smoothstep(lens[k] * 14.0, lens[k] * 60.0, dist)
        ph = dot(d, p) * w - t * sqrt(9.8 * w) * 1.1 + f32(k) * 1.7
        g = g + d * (cos(ph) * 0.07 * fade)
    g

# the painted crests, after the toon seas: thin pale strokes across the wind, curling and broken,
# drifting downwind
_strokes = (p: vec2, t: f32, wd: vec2, ws: f32) -> f32:
    side = vec2(-wd.y, wd.x)
    a = dot(p, wd)
    b = dot(p, side)
    warp = (vnoise(vec2(a * 0.02, b * 0.03)) - 0.5) * 18.0 + sin(b * 0.09 + a * 0.02) * 2.5
    ph = (a + warp - t * 2.4) / 9.0
    row = floor(ph)
    k = ph - row
    # pieces of crest along the row, each its own length, width, curl and brightness
    rl = 0.05 + 0.1 * hash21(vec2(row, 11.0))
    sl = b * rl + hash21(vec2(row, 3.0)) * 50.0
    seg = floor(sl)
    sf = sl - seg
    h1 = hash21(vec2(seg, row))
    h2 = hash21(vec2(seg + 7.0, row * 1.3))
    h3 = hash21(vec2(seg * 1.7, row + 5.0))
    on = step(0.62 - ws * 0.025, h1)
    big = step(0.8, h2) * smoothstep(3.0, 9.0, ws)
    curl = (sf - 0.5) * (sf - 0.5) * (0.08 + 0.14 * h3)
    kk = k - 0.06 - curl + (h3 - 0.5) * 0.05
    taper = sin(clamp((sf - 0.08) / 0.84, 0.0, 1.0) * 3.14159)
    w = (0.006 + 0.022 * taper) * (0.6 + 0.8 * h2) * (1.0 + 1.4 * big)
    band = smoothstep(-w * 0.6, 0.0, kk) * (1.0 - smoothstep(w * 0.5, w * 1.5, kk))
    # a whitecap trails foam behind its crest
    tail = big * smoothstep(-0.16, -0.01, kk) * (1.0 - smoothstep(-0.01, 0.0, kk)) * taper * 0.45
    clamp(max(band, tail) * on * (0.65 + 0.35 * h3), 0.0, 1.0)

# small marks on the water, fixed to the sea: flecks of foam (+) and dark ripple (-), sparse, in
# cells `size` meters across. The shutter: the mark seen through the stretch of sea [p - smear, p]
# that passed over this pixel while it was open (a capsule, so one smooth smear, not copies).
# (+ light, - dark, 0 none)
sea_fleck = (p: vec2, smear: vec2, size: f32, seed: f32, anchor: vec4) -> f32:
    best: f32 = 0.0
    loop k in 0..2:
        q = (p - smear * f32(k)) / size + anchor.xy
        cell = floor(q)+anchor.zw
        r1 = hash21(cell + vec2(41.0 + seed, 7.0))
        if r1 >= 0.6:
            r2 = hash21(cell + vec2(3.0, 59.0 + seed))
            r3 = hash21(cell + vec2(17.0 + seed, 23.0))
            # Centre relative to this sample; never form two huge positions
            # just to subtract them. The cell hash stays fixed across chart snaps.
            c = (vec2(0.25,0.25)+vec2(r2,r3)*0.5-fract(q))*size+smear*(1.0-f32(k))
            # (distance from the mark's center to the swept stretch)
            a = vec2(0,0)
            ab = smear
            t = clamp(dot(c - a, ab) / max(dot(ab, ab), 0.0001), 0.0, 1.0)
            d = length(c - (a + ab * t)) / size
            m = 1.0 - smoothstep(0.1, 0.17, d)
            v = if r1 > 0.82: m else: -m
            if abs(v) > abs(best): best = v
    best

# The original three circular detail sizes, with separate integer cell identity
# and local position. Translation cannot enlarge a mark or change its density.
sea_marks = (p: vec2, smear: vec2, dist: f32, wd: vec2, u: SeaParams) -> f32:
    sizes: f32[3] = [1.3,3.6,10.0]
    acc: f32 = 0.0
    loop o in 0..3:
        size = sizes[o]
        vis = smoothstep(dist*0.004,dist*0.009,size)
        if vis > 0.0:
            m = sea_fleck(p,smear,size,f32(o)*13.0,u.mark_phase[o])*vis
            if abs(m) > abs(acc): acc = m
    acc

# how much a point is in the aircraft shadows passed (0..1), with an edge a pixel or so soft
_shadowed = (p: vec2, u: SeaParams, aa: f32) -> f32:
    # Most water pixels cannot meet an aircraft shadow. Bounds include the
    # antialiased edge, so this only avoids work with an exactly zero result.
    pad = aa*u.shade_pad
    if p.x < u.shade_bounds.x-pad or p.y < u.shade_bounds.y-pad or p.x > u.shade_bounds.z+pad or p.y > u.shade_bounds.w+pad: return 0.0
    sh: f32 = 0.0
    loop q in 0..16:
        if f32(q) < u.shade_n:
            a = u.shade[q * 2].xy
            b = u.shade[q * 2].zw
            c = u.shade[q * 2 + 1].xy
            d = u.shade[q * 2 + 1].zw
            lo = min(min(a,b),min(c,d))-vec2(pad,pad)
            hi = max(max(a,b),max(c,d))+vec2(pad,pad)
            if p.x < lo.x or p.y < lo.y or p.x > hi.x or p.y > hi.y: continue
            area = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
            o: f32 = if area < 0.0: -1.0 else: 1.0
            e1 = ((b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x)) / max(length(b - a), 0.01) * o
            e2 = ((c.x - b.x) * (p.y - b.y) - (c.y - b.y) * (p.x - b.x)) / max(length(c - b), 0.01) * o
            e3 = ((d.x - c.x) * (p.y - c.y) - (d.y - c.y) * (p.x - c.x)) / max(length(d - c), 0.01) * o
            e4 = ((a.x - d.x) * (p.y - d.y) - (a.y - d.y) * (p.x - d.x)) / max(length(a - d), 0.01) * o
            m = min(min(e1, e2), min(e3, e4))
            al = u.shade_alpha[q / 4]
            k = if q % 4 == 0: al.x else: (if q % 4 == 1: al.y else: (if q % 4 == 2: al.z else: al.w))
            sh = max(sh, smoothstep(-aa, aa, m) * k)
    sh

# the painted crests where the swell actually crests: broken strokes along the height contour
# just below each crest, on its downwind face (the face the wind steepens), so they ride the
# waves one sees; more and whiter in a fresh wind
_crest_strokes = (p: vec2, s: vec3, t: f32, wd: vec2, ws: f32, amp: f32, dist: f32) -> f32:
    total = amp * 145.0                                  # (about the swells' height together)
    hn = s.x / max(total, 0.01)
    lvl = 0.42 + 0.12 * vnoise(p * 0.03)
    w = max(fwidth(hn) * 1.6, 0.012)
    line = 1.0 - smoothstep(w * 0.4, w * 1.6, abs(hn - lvl))
    # (the downwind face: the height falls away downwind)
    face = smoothstep(0.0, 0.03, -(s.y * wd.x + s.z * wd.y))
    # broken into strokes of their own lengths along the crest
    side = vec2(-wd.y, wd.x)
    b = dot(p, side) * 0.09 + vnoise(p * 0.02) * 3.0
    seg = floor(b)
    sf = b - seg
    r = hash21(vec2(seg, floor(dot(p, wd) * 0.05)))
    on = step(0.32 - ws * 0.025, r) * sin(clamp((sf - 0.1) / 0.8, 0.0, 1.0) * 3.14159)
    # whitecaps: the crest itself, foaming, when the wind is fresh
    cap = smoothstep(lvl + 0.18, lvl + 0.3, hn) * smoothstep(5.0, 10.0, ws) * step(0.6, r)
    clamp(line * face * on + cap * 0.6, 0.0, 1.0)

# the sun's glints: a sparse field of tiny facets, each tipped at random and re-tipped several
# times a second; one that sends the sun into the eye flashes as a point. Cells grow with distance
# (in steps of two) so a glint stays a pixel or two across.
# Conservative reflection bound for every possible random facet tilt. A unit
# normal perturbed by a vector of length <=r turns by at most asin(r). The
# reflected-light dot is <= (1+v.l)*(nf.h)^2-v.l. Reject only when even that
# bound cannot reach the glint's first smoothstep edge; no facets are thinned.
sea_glint_possible = (n: vec3,v: vec3,l: vec3,h: vec3,rough: f32) -> bool:
    r=(0.22+0.45*rough)*0.707107
    if r>=0.999:return true
    cosine=abs(dot(n,h))
    limit=sqrt(max(1.0-r*r,0.0))
    bound: f32=1.0
    if cosine<limit:bound=cosine*limit+sqrt(max(1.0-cosine*cosine,0.0))*r
    vl=dot(v,l)
    (1.0+vl)*bound*bound-vl>=0.9944

_glints = (p: vec2, n: vec3, v: vec3, l: vec3, dist: f32, t: f32, rough: f32, u: SeaParams) -> f32:
    base: f32 = 0.3
    lev = max(floor(log(max(dist * 0.0021, base) / base) * 1.442695), 0.0)
    size = base * pow(2.0, lev)
    anchor = sea_glint_anchor(u.glint_phase,pow(2.0,min(lev,15.0)))
    q = p / size+anchor.xy
    cell = floor(q)+anchor.zw
    f = fract(q)
    r1 = hash21(cell + vec2(lev * 31.0, 7.0))
    r2 = hash21(cell + vec2(13.0, lev * 17.0))
    tick = floor(t * (1.5 + 3.0 * r1) + r2 * 10.0)
    r3 = hash21(cell + vec2(5.0, 3.0 + tick))
    r4 = hash21(cell + vec2(9.0 + tick, 11.0))
    tilt = vec2(r3 - 0.5, r4 - 0.5) * (0.22 + 0.45 * rough)
    nf = normalize(n + vec3(tilt.x, 0, tilt.y))
    rl = dot(reflect(-v, nf), l)
    spot = 1.0 - smoothstep(0.1, 0.32, length(f - vec2(0.2, 0.2) - vec2(r1, r2) * 0.6))
    smoothstep(0.9945, 0.999, rl) * spot * (0.4 + 0.6 * r2)

# Optical colour falloff is separate from physical depth/shoreline opacity.
# The old 26 m turquoise ramp coloured the entire home approach like a cove.
# Enclosed bays retain their longer clear-water ramp; open shelves turn blue.
sea_shallow_mix = (depth: f32, shelter: f32) -> f32:
    clear = 1.0-smoothstep(0.5,mix(12.0,24.0,clamp(shelter,0.0,1.0)),depth)
    clear*clear

sea_depth_fs = (i: SeaDepthOut, u: SeaParams) -> vec4:
    if u.reject_depth>0.5:
        clip=i.clip
        uv=clip.xy/clip.w*0.5+vec2(0.5,0.5)
        packed=sample(u.opaque_depth,uv).xyz
        nearest=dot(packed,vec3(65536,256,1))*(255.0/16777215.0)
        # Allow two depth units for encode/pack rounding; the real depth test
        # still decides these boundary fragments after the unchanged material.
        if world_depth_encode(clip.w)>nearest+0.00000012:discard()
    sea_fs(SeaOut(i.pos,i.world),u)

sea_fs = (i: SeaOut, u: SeaParams) -> vec4:
    local = i.world.xz
    p = local+u.origin.xz
    dist = length(i.world - u.cam)
    # how deep it is here (the map: r = depth / 60 m), and so its color
    uv = (p + vec2(DEPTH_EXTENT * 0.5, DEPTH_EXTENT * 0.5)) / DEPTH_EXTENT
    dm = sample(u.depth, uv)
    shelter = dm.y
    depth = if uv.x > 0.0 and uv.x < 1.0 and uv.y > 0.0 and uv.y < 1.0: dm.x * 60.0 else: 60.0
    if u.expanded > 0.5 and (abs(p.x) >= 12000.0 or abs(p.y) >= 12000.0):
        shelter = 0.0
        depth = if abs(p.x) < 250000.0 and abs(p.y) < 200000.0: sample(u.world_depth, p / vec2(500000,400000) + vec2(0.5,0.5)).x * 60.0 else: 60.0
        near_uv = (p-u.local_area.xy)/max(u.local_area.z,1.0)+vec2(0.5,0.5)
        edge_dist = max(abs(near_uv.x-0.5),abs(near_uv.y-0.5))
        if u.local_area.w > 0.5 and edge_dist < 0.5:
            depth = mix(depth,sample(u.local_depth,near_uv).x*60.0,1.0-smoothstep(0.45,0.49,edge_dist))
            shelter = sample(u.local_depth,near_uv).y*(1.0-smoothstep(0.45,0.49,edge_dist))
    wd = u.wind.xy
    ws = u.wind.z
    g = mix(gust(p, u.drift), 0.5, smoothstep(2500.0, 12000.0, dist))
    rough = clamp(0.1 + ws / 12.0 * (0.45 + 0.9 * g), 0.0, 1.5)
    # going fast: the sea's fine detail near the camera streams past faster than the sea itself
    # (several times the true speed close by, the true speed some hundreds of meters out), so
    # the speed is felt where the eye reads it; the swells, the crests and everything far keep
    # the true speed. Two copies of the detail, each slid for a short while then crossfaded into
    # the other, so the slide never piles up into a smear.
    near = (1.0 - smoothstep(140.0, 420.0, dist)) * step(0.01, length(u.flow.xy))
    ph = u.time / u.flow.z
    pa = ph - floor(ph)
    ph2 = ph + 0.5
    pb = ph2 - floor(ph2)
    wa = 1.0 - abs(2.0 * pa - 1.0)
    wb = 1.0 - wa
    keep = 1.0 / sqrt(wa * wa + wb * wb)
    offa = u.flow.xy * ((pa - 0.5) * u.flow.z * near)
    offb = u.flow.xy * ((pb - 0.5) * u.flow.z * near)
    s = sea_swell(local,u,dist)
    sa = s
    sb = s
    whole = u.flow.w > 0.5 and near > 0.0
    if whole:
        # (the whole look slides: the swells' slopes, so their light and shade, and their crests;
        # their height, under the aircraft's floats, stays true)
        sa = sea_swell(local+offa,u,dist)
        sb = sea_swell(local+offb,u,dist)
        s = vec3(s.x, (sa.y * wa + sb.y * wb) * keep, (sa.z * wa + sb.z * wb) * keep)
    rp = sea_ripples(local+offa,u,dist) * rough
    if u.rain > 0.01 and dist < 90.0:
        q = p*1.4
        cell = floor(q); f = fract(q)-vec2(0.5,0.5)
        age = fract(u.time*1.7+hash21(cell))
        ring = sin((length(f)-age*0.7)*45.0)*exp(-abs(length(f)-age*0.7)*25.0)*(1.0-age)
        rp += f*(ring*u.rain*0.12*(1.0-smoothstep(45.0,90.0,dist)))
    if near > 0.0: rp = (rp * wa + sea_ripples(local+offb,u,dist) * (rough * wb)) * keep
    n = render_normal(normalize(vec3(-(s.y + rp.x), 1.0, -(s.z + rp.y))), i.world, u.cam)
    vdir = normalize(u.cam - render_world(i.world, u.cam))
    l = normalize(u.sun_dir)
    sh = 1.0 - smoothstep(0.5, 26.0, depth)              # 1 in the shallows
    clear_bay = shelter*(1.0-smoothstep(8.0,20.0,depth))*(1.0-u.rain*0.7)
    shallow = mix(u.shallow,vec3(0.13,0.63,0.43),clear_bay*0.68)
    body = mix(u.deep, shallow, sea_shallow_mix(depth,shelter))
    # the gusts darken the water they pass over
    body = body * (1.0 - 0.3 * g * clamp(ws / 8.0, 0.0, 1.0))
    ndl = max(dot(n, l), 0.0)
    c = body * (mix(u.sun, vec3(1, 1, 1), 0.45) * (0.7 + 0.3 * ndl) + u.sky_top * 0.25)
    # the sky in it, more at a glancing look (less where the gusts roughen it)
    fres = 0.02 + 0.98 * pow(1.0 - max(dot(n, vdir), 0.0), 5.0)
    rd = reflect(-vdir, n)
    skyc = mix(u.sky_horizon, u.sky_top, clamp(rd.y * 1.4, 0.0, 1.0))
    low = 1.0 - smoothstep(0.1, 0.45, l.y)
    c = mix(c, skyc, clamp(fres * (0.6 + 0.3 * low) * (1.0 - 0.3 * g), 0.0, 1.0))
    # the painted crests, near to middle distance, more in a fresh wind
    sfade = (1.0 - smoothstep(180.0, 650.0, dist)) * (1.0 - sh * 0.8)
    st = _crest_strokes(p, s, u.time, wd, ws, u.wind.w, dist)
    if whole: st = _crest_strokes(p + offa, sa, u.time, wd, ws, u.wind.w, dist) * wa + _crest_strokes(p + offb, sb, u.time, wd, ws, u.wind.w, dist) * wb
    st = st * sfade * clamp(0.45 + ws / 10.0, 0.0, 1.0)*smoothstep(0.1,2.0,ws)
    c = mix(c, mix(skyc, vec3(1, 1, 1), 0.55) * (u.sun * 0.85 + u.sky_top * 0.25), st * 0.85)
    # the sea's own marks, persistent, nearer and stronger the faster one goes over them
    rf = (1.0 - smoothstep(120.0, 450.0, dist)) * (0.35 + 0.65 * u.rush.w) * (1.0 - sh * 0.5)*smoothstep(0.1,2.0,ws)
    if rf > 0.01:
        smear = (u.rush.xz + u.flow.xy * near) * (0.6 / 60.0)
        rs = sea_marks(local+offa,smear,dist,wd,u)
        if near > 0.0:
            rb = sea_marks(local+offb,smear,dist,wd,u)
            rs = if abs(rs) * wa > abs(rb) * wb: rs * min(wa * keep, 1.0) else: rb * min(wb * keep, 1.0)
        c = mix(c, if rs > 0.0: mix(body, skyc, 0.6) * 1.3 + vec3(0.05, 0.07, 0.07) else: body * 0.6, abs(rs) * rf * 0.65)
    # the shadows of aircraft above
    shd: f32 = 0.0
    if u.shade_n > 0.0:
        shd = _shadowed(local, u, 0.08 + dist * 0.0015)
        c = mix(c, c * 0.42 + vec3(0.0, 0.02, 0.05), shd)
    # the sun: a soft sheen along its path, and the glints
    hv = normalize(l + vdir)
    nh = max(dot(n, hv), 0.0)
    day = smoothstep(-0.05, 0.12, l.y)
    variance = smoothstep(300.0, 3000.0, dist) * clamp(u.wind.w * 80.0, 0.0, 1.0)
    sheen = pow(nh, mix(90.0, 55.0, variance)) * 0.22 + pow(nh, mix(600.0, 160.0, variance)) * 0.5
    gl: f32=0.0
    if sea_glint_possible(n,vdir,l,hv,rough):
        gl = _glints(local+offa,n,vdir,l,dist,u.time,rough,u)
        if near>0.0:gl=gl*wa+_glints(local+offb,n,vdir,l,dist,u.time,rough,u)*wb
    c = c + u.sun * (sheen + gl * 14.0) * day * (1.0 - shd)*(1.0-u.rain*0.75)
    # Both shore terms are identically zero beyond 3 m depth / 5 km range.
    # Do not run their noise and trigonometry over every offshore pixel.
    foam: f32 = 0.0
    if depth < 3.0 and dist < 5000.0:
        fn = sin(p.x*0.9+sin(p.y*0.6)*2.0+u.time*1.2)*sin(p.y*1.1+sin(p.x*0.5)*2.0-u.time*0.9)
        wash = 0.6+max(s.x,0.0)*0.8+0.35*sin(u.time*1.4+vnoise(p*0.04)*6.0)
        edge = 1.0-smoothstep(0.12,wash+0.7+0.45*fn,depth)
        breaker = (1.0-smoothstep(0.15,0.65,abs(depth-wash-0.6)))*clamp(ws/10.0,0.15,0.85)
        foam = clamp(edge*(0.75+0.35*fn)+breaker*(0.5+0.5*fn),0.0,1.0)*(1.0-smoothstep(1500.0,5000.0,dist))
    c = mix(c, vec3(0.97, 0.98, 1.0) * (u.sun * 0.8 + u.sky_top * 0.3), foam * 0.85)
    # the water is clear: at the shore one sees the sand through it
    a = clamp(0.48+depth*0.12+fres*0.4+foam+gl,0.0,1.0)
    if clear_bay > 0.005:
        absorption = mix(0.12,0.055,clear_bay)
        clear_alpha = clamp(1.0-exp(-depth*absorption)*(1.0-fres*0.85)*0.95+foam+gl+u.rain*0.12,0.0,1.0)
        a = mix(a,clear_alpha,clear_bay)
    c = aerial(c, i.world, u.cam, u.haze, u.fog)
    vec4(c, a)

sea_sh: Shader
far_sea_sh: Shader
far_sea_tri: Mesh

struct FarSeaVertex:
    pos: vec2
struct FarSeaOut:
    pos: vec4
    ndc: vec2
far_sea_vs = (v: FarSeaVertex, u: SeaParams) -> FarSeaOut:
    FarSeaOut(vec4(v.pos, 1, 1), v.pos)
far_sea_fs = (i: FarSeaOut, u: SeaParams) -> vec4:
    dir = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    dist = sea_intersection(dir, u.cam.y)
    if dist < 14000.0: discard()
    world = vec3(u.cam.x + dir.x * dist, 0, u.cam.z + dir.z * dist)
    # The identical sea material at its actual surface point, not a sky tint.
    sea_fs(SeaOut(i.pos, world), u)


# rings around the camera: fine near it, coarse far out
build_sea_mesh = () -> Mesh:
    vs: SeaVertex[]
    idx: u32[]
    seg = 160
    radii: f64[] = [0.0]
    r = 1.5
    loop r < 16000.0:
        radii.push(r)
        r = r * 1.045 + 0.8
    radii.push(16000.0)
    loop k in 0..radii.len():
        loop s in 0..seg:
            a = f64(s) / f64(seg) * TAU
            vs.push(SeaVertex(vec3(f32(cos(a) * radii[k]), 0, f32(sin(a) * radii[k]))))
    loop k in 0..radii.len() - 1:
        loop s in 0..seg:
            a = u32(k * seg + s)
            b = u32(k * seg + (s + 1) % seg)
            c = a + u32(seg)
            d = b + u32(seg)
            idx.push(a); idx.push(b); idx.push(c)
            idx.push(b); idx.push(d); idx.push(c)
    mesh(vs, idx)

# the map of the sea floor's depth, for the water's color
build_depth_texture = () -> Texture:
    n = DEPTH_MAP
    rows = parallel_map([0..n), (j: int) -> f64[]:
        z = (f64(j) + 0.5) / f64(n) * DEPTH_EXTENT - DEPTH_EXTENT * 0.5
        [loop i in 0..n: height((f64(i) + 0.5) / f64(n) * DEPTH_EXTENT - DEPTH_EXTENT * 0.5, z)]
    )
    img = image(n, n)
    loop j in 0..n:
        loop i in 0..n:
            h = rows[j][i]
            d = clamp(-h / 60.0, 0.0, 1.0)
            img.set(i, j, vec4(f32(d), if h > 0.0: 1.0 else: 0.0, 0, 1))
    coast_shelter(img)
    result = texture(img, true)
    init_expanded_depth(result)
    result

# Reuse completed depth pixels to find bays enclosed on several sides. This
# adds no terrain queries or GPU samples; the otherwise unused green channel
# is published together with depth, never while a near map is half-built.
coast_shelter = (img: mut Image):
    loop j in 0..img.height:
        loop i in 0..img.width:
            c = img.get(i,j)
            if c.x > 0.35: continue
            enclosed: f32 = 0.0
            loop d in [vec2(6,0),vec2(-6,0),vec2(0,6),vec2(0,-6)]:
                q = img.get(clamp(i+int(d.x),0,img.width-1),clamp(j+int(d.y),0,img.height-1)).x
                enclosed += 1.0-smoothstep(0.005,0.06,q)
            c.y = smoothstep(0.8,2.7,enclosed)
            img.set(i,j,c)

# A fixed coarse map and one double-buffered near window. Partial rows are
# never published. The 23.4375 m near sampling matches the original depth map.
const NEAR_DEPTH_N = 256
const NEAR_DEPTH_EXTENT = 6000.0
const NEAR_DEPTH_ROWS = 8
expanded_depth: Texture
nearby_depth: Texture
nearby_spare: Texture
nearby_area = vec4(0,0,6000,0)
nearby_pending = vec2(0,0)
nearby_row = -1
nearby_image: Image

init_expanded_depth = (fallback: Texture):
    global expanded_depth, nearby_depth, nearby_spare, nearby_image
    expanded_depth = fallback; nearby_depth = fallback; nearby_spare = fallback
    if not geography_enabled: return
    img = image(500,400)
    loop j in 0..400:
        loop i in 0..500:
            h = new_land_base((f64(i)+0.5)*1000.0-250000.0,(f64(j)+0.5)*1000.0-200000.0).0
            img.set(i,j,vec4(f32(clamp(-h/60.0,0.0,1.0)),0,0,1))
    expanded_depth = texture(img,true)
    nearby_image = image(NEAR_DEPTH_N,NEAR_DEPTH_N)
    nearby_depth = texture(nearby_image,true)
    nearby_spare = texture(nearby_image,true)

update_nearby_depth = ():
    global nearby_depth,nearby_spare,nearby_area,nearby_pending,nearby_row,nearby_image
    if not geography_enabled: return
    cam = scene_camera().xz
    if abs(cam.x) < 14000.0 and abs(cam.y) < 14000.0: return
    if nearby_row < 0:
        if nearby_area.w > 0.5 and length(cam-nearby_area.xy) < 750.0: return
        nearby_pending = floor(cam/750.0)*750.0
        nearby_row = 0
    zone("world depth")
    loop j in nearby_row..min(nearby_row+NEAR_DEPTH_ROWS,NEAR_DEPTH_N):
        z = f64(nearby_pending.y)+(f64(j)+0.5)/f64(NEAR_DEPTH_N)*NEAR_DEPTH_EXTENT-NEAR_DEPTH_EXTENT*0.5
        loop i in 0..NEAR_DEPTH_N:
            x = f64(nearby_pending.x)+(f64(i)+0.5)/f64(NEAR_DEPTH_N)*NEAR_DEPTH_EXTENT-NEAR_DEPTH_EXTENT*0.5
            h = new_land_depth_height(x,z)
            nearby_image.set(i,j,vec4(f32(clamp(-h/60.0,0.0,1.0)),0,0,1))
    nearby_row += NEAR_DEPTH_ROWS
    if nearby_row >= NEAR_DEPTH_N:
        coast_shelter(nearby_image)
        update_texture(nearby_spare,nearby_image)
        old = nearby_depth; nearby_depth = nearby_spare; nearby_spare = old
        nearby_area = vec4(nearby_pending.x,nearby_pending.y,f32(NEAR_DEPTH_EXTENT),1)
        nearby_row = -1
    zone_end()

# a flat part's shadow on the sea: the four corners of a box's middle (local center c, half size h)
# placed by model, carried along the sunlight down to sea level
struct SeaShadows:
    quads: vec4[32]
    alpha: vec4[4]
    n = 0
    origin = vec3(0,0,0)

add_sea_shadow = (sh: mut SeaShadows, model: mat4, c: vec3, h: vec3, sun: vec3, alpha: f64):
    if sh.n >= 16: return
    s = normalize(sun)
    if s.y < 0.08: return
    if sh.n == 0: sh.origin = render_origin(scene_camera())
    local_model = render_model(model,sh.origin)
    corners = [vec3(-1, 0, -1), vec3(1, 0, -1), vec3(1, 0, 1), vec3(-1, 0, 1)]
    pts: vec2[]
    loop k in corners:
        w = transform_point(local_model, c + k * h)
        t = w.y / s.y
        pts.push(vec2(w.x - s.x * t, w.z - s.z * t))
    sh.quads[sh.n * 2] = vec4(pts[0].x, pts[0].y, pts[1].x, pts[1].y)
    sh.quads[sh.n * 2 + 1] = vec4(pts[2].x, pts[2].y, pts[3].x, pts[3].y)
    i = sh.n / 4
    a = f32(alpha)
    match sh.n % 4:
        0: sh.alpha[i].x = a
        1: sh.alpha[i].y = a
        2: sh.alpha[i].z = a
        _: sh.alpha[i].w = a
    sh.n += 1

# how rough the sea is for its wind (the pause menu's Sea: 0 glassy, 1 as the wind makes it, 3 heavy):
# the swells' height (which the aircraft and the boats ride too) and the whitecaps alike
sea_rough = 1.0

set_sea_rough = (r: f64):
    global sea_rough
    sea_rough = max(r, 0.0)

_swell_amp = (w: Wind) -> f64: (0.003 + 0.0011 * w.speed) * sea_rough * smoothstep(0.05,2.0,w.speed)

sea_params = (depth: Texture, L: Light, t: f64, w: Wind, cam_vel: vec3, shadows: SeaShadows) -> SeaParams:
    swell = _swell_amp(w)                       # (the swells' height for their length)
    ws = w.speed * sea_rough                    # (the wind as the sea's face shows it)
    cam = scene_camera()
    center = render_origin(cam).xz
    residual = vec2(f32(f64(cam.x) - f64(center.x)), f32(f64(cam.z) - f64(center.y)))
    p = SeaParams(scene_view_proj(), scene_camera(), L.sun_dir, L.sun, L.sky_top, L.sky_horizon, L.haze,
        L.sea_deep, L.sea_shallow, f32(L.fog_density), f32(t), f32(ws / 12.0), vec4(w.dir.x, w.dir.y, f32(ws), f32(swell)), w.drift, rush_of(cam_vel), shadows.quads, shadows.alpha, f32(shadows.n), depth, expanded_depth, nearby_depth, nearby_area, if geography_enabled: 1.0 else: 0.0, render_rays(scene_view_proj()), center, residual, scene_flow, scene_warp_a, scene_warp_b)
    p.origin = render_origin(p.cam)
    p.view_proj = render_view_proj(p.origin)
    p.cam = render_eye(p.origin)
    p.warp_a = render_anchor(p.warp_a,p.origin)
    offset = shadows.origin-p.origin
    loop k in 0..shadows.n*2: p.shade[k] += vec4(offset.x,offset.z,offset.x,offset.z)
    sea_phases(p,t)
    lo = vec2(1e20,1e20); hi = vec2(-1e20,-1e20)
    loop k in 0..shadows.n*2:
        q = p.shade[k]
        lo = min(lo,min(q.xy,q.zw)); hi = max(hi,max(q.xy,q.zw))
    p.shade_bounds = vec4(lo.x,lo.y,hi.x,hi.y)
    # Offset edge half-planes can extend farther than aa at acute corners.
    # A parallelogram's corner displacement is bounded by 2*aa/sin(angle).
    loop k in 0..shadows.n:
        ab = shadows.quads[k*2].zw-shadows.quads[k*2].xy
        bc = shadows.quads[k*2+1].xy-shadows.quads[k*2].zw
        p.shade_pad = max(p.shade_pad,2.0*length(ab)*length(bc)/max(abs(ab.x*bc.y-ab.y*bc.x),0.000001))
    p.rain = if weather_active: weather_here.rain else: 0.0
    p

sea_phases = (p: mut SeaParams,t: f64):
    turns = [0.0,0.45,-0.5,0.9,-0.25,0.2,0.3,-0.35,0.75,-0.8,0.05]
    lengths = [61.0,37.0,23.0,13.0,7.3,4.1,3.1,2.3,1.6,1.15,0.8]
    loop k in 0..11:
        a = turns[k]; len = lengths[k]; frequency = TAU/len
        dx = f64(p.wind.x)*cos(a)-f64(p.wind.y)*sin(a)
        dz = f64(p.wind.x)*sin(a)+f64(p.wind.y)*cos(a)
        wave = vec2(f32(dx*frequency),f32(dz*frequency))
        phase = f64(wave.x)*f64(p.origin.x)+f64(wave.y)*f64(p.origin.z)-t*sqrt(9.8*frequency)*(if k < 6: 1.0 else: 1.1)+(if k < 6: 0.0 else: f64(k-6)*1.7)
        band = vec4(wave,render_phase(phase,TAU),f32(len))
        if k < 6: p.swell_phase[k] = band
        else: p.ripple_phase[k-6] = band
    sizes: f32[3] = [1.3,3.6,10.0]
    loop k in 0..3: p.mark_phase[k] = sea_cell_anchor(p.origin.xz,f64(sizes[k]))
    p.glint_phase = sea_cell_anchor(p.origin.xz,f64(f32(0.3)))

# Coarser glint cells are powers of two of the finest lattice. Integer quotient
# and remainder stay exact within this world's bounds; only the fractional cell
# is rounded. Avoid a varying-index uniform-array fetch for every sea fragment.
sea_glint_anchor = (base: vec4,divisor: f32) -> vec4:
    cell = floor(base.zw/divisor)
    fraction = (base.zw-cell*divisor+base.xy)/divisor
    vec4(fraction,cell)

sea_cell_anchor = (origin: vec2,size: f64) -> vec4:
    x = f64(origin.x)/size; z = f64(origin.y)/size
    vec4(f32(x-floor(x)),f32(z-floor(z)),f32(floor(x)),f32(floor(z)))

draw_sea = (m: Mesh, depth: Texture, L: Light, t: f64, w: Wind, cam_vel: vec3 = vec3(0, 0, 0), shadows: SeaShadows = SeaShadows()):
    update_nearby_depth()
    p = sea_params(depth, L, t, w, cam_vel, shadows)
    # One material/pass: deep alpha is 1; the shallow alpha composites against
    # the already-drawn seabed. Both record the water endpoint for later wakes,
    # particles and geometry. Existing nearer clouds fail the depth test here.
    zone("sea surface")
    if world_log_depth_active() and cloud_scene_depth.id!=0:
        p.opaque_depth=snapshot_opaque_depth();p.reject_depth=1
    glDepthMask(1)
    glEnable(GL_CULL_FACE)
    draw(sea_sh, m, p)
    glDisable(GL_CULL_FACE)
    glDepthMask(0)
    zone_end()

draw_far_sea = (depth: Texture, L: Light, t: f64, w: Wind):
    p = sea_params(depth, L, t, w, vec3(0, 0, 0), SeaShadows())
    zone("sea horizon")
    glDepthMask(0)
    draw(far_sea_sh, far_sea_tri, p)
    glDepthMask(1)
    zone_end()

# how strongly the sea streaks past for a camera moving at vel (fast and low)
rush_of = (vel: vec3) -> vec4:
    sp = f64(length(vec3(vel.x, 0, vel.z)))
    hgt = f64(scene_camera().y)
    k = smoothstep(15.0, 60.0, sp) * (1.0 - smoothstep(30.0, 260.0, hgt))
    vec4(vel.x, vel.y, vel.z, f32(k))

# (the GPU programs: made once the window is open)
init_sea = ():
    global sea_sh, far_sea_sh, far_sea_tri
    far_sea_sh = make_background_shader(shader(far_sea_vs, far_sea_fs))
    far_sea_tri = mesh([FarSeaVertex(vec2(-1, -1)), FarSeaVertex(vec2(3, -1)), FarSeaVertex(vec2(-1, 3))])
    # Only logarithmic depth needs the extra clip varying and manual rejection.
    # Native reversed Z keeps the original material interface and hardware early Z.
    sea_sh = make_world_shader(if world_log_depth_active():shader(sea_depth_vs,sea_depth_fs) else:shader(sea_vs,sea_fs))

# the sea's surface where the eye sees it (the same swells the sea is drawn with): height and slope
swell_at = (x: f64, z: f64, t: f64) -> vec3:
    # No SeaParams/texture work in physics contacts. Match the uploaded wave
    # vectors, then perform the full spatial/time dot in double precision.
    turns = [0.0,0.45,-0.5,0.9,-0.25,0.2]
    lengths = [61.0,37.0,23.0,13.0,7.3,4.1]
    amp = _swell_amp(wind_now)
    result = vec3(0,0,0)
    loop k in 0..6:
        a = turns[k]; len = lengths[k]; frequency = TAU/len
        dx = f64(wind_now.dir.x)*cos(a)-f64(wind_now.dir.y)*sin(a)
        dz = f64(wind_now.dir.x)*sin(a)+f64(wind_now.dir.y)*cos(a)
        wave = vec2(f32(dx*frequency),f32(dz*frequency))
        phase = f64(wave.x)*x+f64(wave.y)*z-t*sqrt(9.8*frequency)
        h = len*amp
        result += vec3(f32(h*sin(phase)),f32(h*cos(phase)*f64(wave.x)),f32(h*cos(phase)*f64(wave.y)))
    result

# The six wavelengths sum to 145.4; every sine and fade is bounded by one.
# Pad the f32 amplitude/sum so this is conservative even at a crest.
swell_height_bound = () -> f64: f64(abs(f32(_swell_amp(wind_now))))*146.0+0.001

# a thing afloat at p riding the swell: lifted, and tilted with the water's slope
afloat = (p: vec3, t: f64) -> mat4:
    s = swell_at(f64(p.x), f64(p.z), t)
    translation(vec3(0, s.x, 0)) * translation(p) * rotation_x(f64(clamp(s.z, -0.3, 0.3)) * 0.6) * rotation_z(f64(clamp(-s.y, -0.3, 0.3)) * 0.6) * translation(-p)

# Compose buoyancy about the model's local root, never T(p)*R*T(-p)*T(p).
# The latter cancels two country-sized f32 translations on the CPU; keeping
# the pivot local avoids depending on that cancellation as the tilt changes.
afloat_transform = (at: mat4,t: f64) -> mat4:
    p=at[3].xyz
    s=swell_at(f64(p.x),f64(p.z),t)
    local=at;local[3]=vec4(0,0,0,1)
    tilt=rotation_x(f64(clamp(s.z,-0.3,0.3))*0.6)*rotation_z(f64(clamp(-s.y,-0.3,0.3))*0.6)
    result=tilt*local
    result[3]=vec4(p+vec3(0,s.x,0),1)
    result
