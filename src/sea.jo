use 'water_field.jo'
use 'surf.jo'
use 'baked_assets.jo'
use 'water_types.jo'
use 'depth_space.jo'
use 'cloud_depth.jo'
# The sea: one wide disc of rings around the camera, finer near it. Waves are worked out per
# pixel from a sum of swells; the water's color comes from its depth (a map of the sea floor made
# once from world.jo): deep cobalt in the open sea, turquoise over sand, see-through at the shore,
# with foam where it meets the land and the sun's glitter on it.

use 'world.jo'
use 'geography.jo'
use 'look.jo'
use 'celestial.jo'
use 'render_space.jo'
use 'weather_scene.jo'
use 'coast_atlas.jo'
use 'coast_pattern.jo'
use 'quality.jo'
use 'cloud_shadow_map.jo'
use 'tweaks.jo'
use 'sky_air.jo'

const DEPTH_MAP = 1024
# The open sea seen from height goes toward navy (the deep water's colour, so the shallows band,
# the flecks, glints and crests keep their look), from look.jo's AIR_DOWN_FROM to AIR_DOWN_FULL metres of the
# eye's height; the haze over the sea darkens a little with it. Tweaks "Brighter ocean" keeps the
# old teal.
const DEEP_SEA_NAVY = vec3(0.42, 0.4, 0.56)   # (from look.jo's AIR_DOWN_FROM to AIR_DOWN_FULL)
const DEPTH_EXTENT = 24000.0        # the depth map's square, meters across (past it: open sea)

struct SeaVertex:
    pos: vec3

struct SeaParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    sky_top: vec3
    sky_horizon: vec3
    haze: vec3
    deep: vec3
    shallow: vec3
    fog: f32
    time: f32
    rough: f32                      # 0 a calm sea, 1 a rough one (weather)
    wind: vec4                      # the way it blows (x, z), its speed, and (w) the swell's height
    drift: vec2                     # how far the gusts have moved
    rush: vec4                      # the camera's velocity (x, y, z) and how strongly the sea streaks past (w)
    shade: vec4[32]                 # aircraft shadows on the sea: quads (corners a, b; c, d as x, z pairs)
    shade_alpha: vec4[4]            # each quad's darkness (four to a vec4)
    shade_n: f32
    depth: Texture
    world_depth: Texture
    local_depth: Texture
    local_area: vec4                # center x,z, extent, valid
    expanded: f32
    rays: mat4
    center: vec2
    residual: vec2
    flow: vec4                      # the near detail's extra drift (x, z m/s), its cycle (s), and (w) 1: the whole sea's look slides
    warp_a: vec4                    # (the speed trial's warp: render_space.jo)
    warp_b: vec4
    origin: vec3 = vec3(0,0,0)
    shade_bounds: vec4 = vec4(0,0,0,0)
    shade_pad: f32 = 1.0
    rain: f32 = 0.0
    coast_near: Texture = Texture()
    coast_far: Texture = Texture()
    coast_near_area: vec4 = vec4(0,0,0,0)
    coast_far_area: vec4 = vec4(0,0,0,0)
    coast_roll: vec4 = vec4(0,0,0,0)
    swell_phase: vec4[6]
    swell_back: vec4[3]             # each swell band's reflected wave: cos, sin of twice its time phase, two bands a vec4 (sea_band_travel)
    swell_gain: vec4[2]             # each swell band's share for the wind (sea_state), bands 0-3 and 4-5; [1].z: 1 over the sea's stretch
    sea_storm: vec4 = vec4(0,0,2440,0) # storm 0..1, crest peaking (0..0.35), the swell's reach (m), its whole height (m)
    ripple_phase: vec4[5]
    ripple_back: vec4[3]            # (the same for the five ripple bands)
    glint_facets: Texture = Texture()
    specular_sun: vec4 = vec4(0,1,0,1)  # real disc direction and visible fraction
    glint_phase: vec4
    glint_pixel: f32 = 0.0016       # metres across a pixel per metre of distance (1 / the focal length in pixels)
    inland_phase:vec4=vec4(0,0,0,0)
    inland_depth: f32 = -1.0
    inland_opacity_depth: f32 = 2.0
    inland_chop: f32 = 0.0           # a lake's wind chop: the sea's swell slopes and crests, scaled
    inland_walls: vec4 = vec4(0,0,0,0)   # a walled canal (canal_render.jo): wall face's half width, wall top, facade top over the water; w 1 on
    moon: vec4 = vec4(0,0,0,0)       # the moon's direction and (w) its glitter's strength
    glint_gain: f32 = 14.0           # the glints' brightness over the sheen: 14 in clear air, less when the day's air
                                     # (day_air.jo) veils the sun, so they take its warm colour instead of clipping white
    glint_sun: vec3 = vec3(1, 1, 1)  # colour of the solar sheen and glitter path (follows the sunset palette)
    fleck_reference:vec3=vec3(0,0,0)
    opaque_depth: Texture
    reject_depth: f32 = 0
    far_z: f32 = 0.9999
    mark_phase: vec4[3]             # fractional cell origin xy, integer cell identity zw
    cloud_shadow: Texture = Texture()  # cloud_shadow_map.jo: the sun's glints and sheen go in cloud shadow
    storm_noise: Texture = Texture()   # (the storm sea's foam: four tiling noises, sea_storm_noise_image)
    cloud_area: vec4 = vec4(0,0,0,0)
    cloud_slope: vec4 = vec4(0,0,0,0)
    surf: vec4 = vec4(0,0,0,0)       # Surf (surf.jo): x on, y the sea's energy 0..1, w ships
    surf_ships: vec4[8]              # (surf.jo surf_ship_uniforms: the nearest ships' white water)
    surf_box: vec4 = vec4(0,0,0,0)   # (and the box round all of it, render-local xz min and max)
    harbour: vec4 = vec4(0,0,-2,-1)  # the harbour's shelter (sea_calm): render-local x, z, calm inside this radius, open sea from this one
    haze_tangent: vec3 = vec3(-1,0,0) # the sky's air at the horizon (sky_air.jo air_tangent): the far sea's haze nears it; x < 0 none

struct SeaOut:
    pos: vec4
    world: vec3
    current:vec2=vec2(0,0)
    water_depth:f32= -1.0
    water_chart:vec2=vec2(0,0)
    bank_impact:f32=0.0
    water_flow:vec2=vec2(0,0)
    sun_lost:f32=0.0                # cloud shadow (per vertex): no glints or sheen there
    calm:f32=0.0                    # the harbour's shelter (per vertex, sea_calm): it fades over 450 m

struct SeaDepthOut:
    pos:vec4
    world:vec3
    clip:vec4
    current:vec2=vec2(0,0)
    water_depth:f32= -1.0
    water_chart:vec2=vec2(0,0)
    bank_impact:f32=0.0
    water_flow:vec2=vec2(0,0)
    sun_lost:f32=0.0
    calm:f32=0.0

# the swells: height and slope (dh/dx, dh/dz) at a point, running mostly with the wind. Each
# fades out where it is too short for the pixels to show it (dist: from the camera).
_swell = (p: vec2, t: f32, amp: f32, dist: f32, wd: vec2) -> vec3:
    # All six bands have reached exactly zero beyond the longest fade.
    if dist >= 2440.0: return vec3(0,0,0)
    h: f32 = 0.0
    dx: f32 = 0.0
    dz: f32 = 0.0
    turns: f32[6] = [0.0, 0.45, -0.5, 0.9, -0.25, 0.2]
    lens: f32[6] = [61.0, 37.0, 23.0, 13.0, 7.3, 4.1]
    loop k in 0..6:
        a = turns[k]
        d = vec2(wd.x * cos(a) - wd.y * sin(a), wd.x * sin(a) + wd.y * cos(a))
        len = lens[k]
        w = 6.2831853 / len
        fade = 1.0 - smoothstep(len * 9.0, len * 40.0, dist)
        hk = len * amp * fade
        ph = dot(d, p) * w - t * sqrt(9.8 * w)
        h += hk * sin(ph)
        c = hk * w * cos(ph)
        dx += c * d.x
        dz += c * d.y
    vec3(h, dx, dz)

# Where each swell band can be. A wave runs at the deep-water speed it is drawn and ridden with,
# sqrt(g L / 2 pi), only where the water is deep enough for it: at a depth of a quarter of its
# length it has slowed by 4%, at a ninth by 30% (c^2 = g/k tanh(k d)), and shallower still it
# would have to crawl. So a band is whole from a quarter of its length of water, and gone by a
# ninth: the long, fast swells never run through a harbour's shallows or up a beach. And inside a
# harbour (calm 0..1, sea_calm) there is no fetch for a sea to grow in: only the shortest bands
# stay, low (`harbour`, that band's share there: SEA_HARBOUR_GAINS). The drawn sea and swell_at
# both use this, so the floats ride what is seen.
sea_band_keep = (len: f32, depth: f32, calm: f32, harbour: f32) -> f32:
    smoothstep(len*0.11, len*0.25, depth)*mix(1.0, harbour, calm)

# How much of a band still runs on, 0..1 (q): the rest stands, its reflection running back the
# other way. Nearing a shore a wave slows, c = sqrt(g/k tanh(k d)), to nothing at the waterline:
# there the water only laps in and out. The band is drawn and ridden as a forward wave of height
# (1+q)/2 and a reflected one of (1-q)/2. Their net drift (the forward energy less the reflected,
# 2q/(1+q^2) of the deep-water speed) is the real wave's speed in that depth when q is
# sqrt(2d/L): within 3% under and 13% over it, whole from half a length of water (the ripples,
# `reach` 0.5). A swell band is whole only from a quarter of its length of water and gone by a
# ninth (sea_band_keep), so it runs on whole from a quarter (sqrt(4d/L), `reach` 0.25): between,
# within 21% over the real speed, and the deep open sea has nothing to work out
# (tests/sea_speed_test.jo). Inside a harbour's basin the quays and the mole throw most of it
# back as well (SEA_HARBOUR_REFLECT of it at calm 1). The drawn sea and swell_at both use this.
const SEA_HARBOUR_REFLECT: f32 = 0.7
# (only the two short swell bands, 7.3 and 4.1 m, and the ripples: the four long ones are all but
# gone where it would matter, faded out over the shallows and next to nothing in a basin, and each
# band's reflection costs the drawn sea; bands from this one on)
const SEA_TRAVEL_BANDS = 4
sea_band_travel = (len: f32, depth: f32, calm: f32, reach: f32 = 0.25) -> f32:
    sqrt(clamp(depth/(reach*len),0.0,1.0))*(1.0-SEA_HARBOUR_REFLECT*calm)

# And over the last stretch before the waterline, the last three metres of water (some 15 to 30 m of
# an ordinary beach, as the depth map reads it, 23 m a texel), the water stills further than the waves' own slowing gives: the short waves
# spend themselves breaking and running up, and what is left is the swash running in and out. So
# the share that runs on eases to nothing there, the swell bands and the long ripples alike (the
# short ripples calm instead: sea_ripples), and the shore's water only laps (the drawn sea and
# swell_at the same).
const SEA_SHORE_STILL: f32 = 3.0
sea_shore_still = (depth: f32) -> f32: smoothstep(0.0, SEA_SHORE_STILL, depth)

# (in shaders) sea_band_travel for one band: x the depth over the sea's stretch, inv 1/(reach L)
# for its ordinary length (the same number; tests/sea_speed_test.jo holds the two together)
sea_band_travel_fast = (x: f32, inv: f32, calm: f32) -> f32:
    sqrt(min(x*inv,1.0))*(1.0-SEA_HARBOUR_REFLECT*calm)

# (in shaders) how far inside the harbour's shelter a point is: 1 in its basin, 0 on the open sea.
# Worked out at the sea's vertices and carried to the pixels (SeaOut.calm): it fades over 450 m.
sea_calm = (local: vec2, u: SeaParams) -> f32:
    1.0-smoothstep(u.harbour.z, u.harbour.w, length(local-u.harbour.xy))

# (in shaders) sea_band_keep for one band without a division: x the depth over the sea's stretch
# (so the bands have their ordinary lengths), inv 1/(0.14 L) for that length, loss what the
# harbour takes of the band (1 - its SEA_HARBOUR_GAINS). The same number as sea_band_keep's
# (tests/sea_speed_test.jo holds the two together).
sea_band_keep_fast = (x: f32, inv: f32, loss: f32, calm: f32) -> f32:
    t = clamp(x*inv-0.7857143, 0.0, 1.0)
    t*t*(3.0-2.0*t)*(1.0-loss*calm)

# A storm's seas break and lose their height over shallow water: none stands higher than about
# 0.6 of the depth (a harbour's lagoon or a shoal stays low while the gale's seas run outside).
# In proportion to the storm, so an ordinary sea is exactly as it was; swell_at does the same.
sea_shoal = (depth: f32, storm: f32, height: f32) -> f32:
    mix(1.0, smoothstep(0.0, 1.0, 0.6*depth/max(height, 0.1)), storm)

# (in the vertex shader: the depth map's coarse depth at p, m; open sea past its edges)
sea_depth_coarse = (p: vec2, u: SeaParams) -> f32:
    uv = (p + vec2(DEPTH_EXTENT * 0.5, DEPTH_EXTENT * 0.5)) / DEPTH_EXTENT
    depth = if uv.x > 0.0 and uv.x < 1.0 and uv.y > 0.0 and uv.y < 1.0: sample(u.depth, uv).x * 60.0 else: 60.0
    if u.expanded > 0.5 and (abs(p.x) >= 12000.0 or abs(p.y) >= 12000.0):
        depth = if abs(p.x) < 250000.0 and abs(p.y) < 200000.0: sample(u.world_depth, p / vec2(500000,400000) + vec2(0.5,0.5)).x * 60.0 else: 60.0
        # (and the finer map round the camera, as the water's colour reads it: sea_material)
        near_uv = (p-u.local_area.xy)/max(u.local_area.z,1.0)+vec2(0.5,0.5)
        edge_dist = max(abs(near_uv.x-0.5),abs(near_uv.y-0.5))
        if u.local_area.w > 0.5 and edge_dist < 0.5:
            depth = mix(depth,sample(u.local_depth,near_uv).x*60.0,1.0-smoothstep(0.45,0.49,edge_dist))
    depth

# (storm_water, a constant: the storm sea's own variant, sea_storm_shaders: its seas peaked and
# brought low over the shallows; off, exactly the ordinary sea's program)
sea_vs_of = (v: SeaVertex, u: SeaParams, storm_water: bool) -> SeaOut:
    # The chart origin snaps, but its residual moves continuously. A snap
    # must not resample the displaced near rings or move any procedural phase.
    p = v.pos.xz + u.residual
    r = length(p - u.cam.xz)
    near = 1.0 - smoothstep(80.0, 260.0, r)
    # (only the rings near the camera rise with the swell: the rest need neither it nor the depth)
    s = vec3(0,0,0)
    calm = sea_calm(p,u)
    if near > 0.0:
        depth = sea_depth_coarse(p+u.origin.xz,u)
        s = sea_swell(p,u,r,storm_water,depth,calm)
        if storm_water: s = s*sea_shoal(depth,u.sea_storm.x,u.sea_storm.w)
    w = vec3(p.x, s.x * near, p.y)
    clip=u.view_proj * vec4(render_warped(w,u.cam,u.warp_a,u.warp_b),1)
    # (the colour's shadow is the screen pass's, cloud_shadow.jo; only the sun's
    # reflections need the water's own knowledge, and coarsely)
    SeaOut(clip,w,sun_lost=cloud_shadow_vertex(u.cloud_shadow,u.cloud_area,u.cloud_slope,vec3(w.x,0,w.z)),calm=calm)

sea_vs = (v: SeaVertex, u: SeaParams) -> SeaOut: sea_vs_of(v,u,false)
sea_storm_vs = (v: SeaVertex, u: SeaParams) -> SeaOut: sea_vs_of(v,u,true)
sea_depth_vs=(v:SeaVertex,u:SeaParams)->SeaDepthOut:
    i=sea_vs(v,u)
    SeaDepthOut(i.pos,i.world,i.pos,sun_lost=i.sun_lost,calm=i.calm)
sea_storm_depth_vs=(v:SeaVertex,u:SeaParams)->SeaDepthOut:
    i=sea_storm_vs(v,u)
    SeaDepthOut(i.pos,i.world,i.pos,sun_lost=i.sun_lost,calm=i.calm)


# Wave directions/frequencies and the anchor/time phase are reduced on the CPU.
# Small local dot products retain sub-centimetre wave motion at every world corner.
# (travel: the share that runs on, sea_band_travel; back: the cos and sin of twice the band's
# time phase, so its reflection's phase is this one's plus that)
sea_swell_band = (p: vec2,band: vec4,amp: f32,dist: f32,peak: f32 = 0.0,travel: f32 = 1.0,back: vec2 = vec2(1,0)) -> vec3:
    fade=1.0-smoothstep(band.w*9.0,band.w*40.0,dist)
    phase=dot(band.xy,p)+band.z
    height=band.w*amp*fade
    sn=sin(phase);cs=cos(phase)
    # (a storm's swells: peaked crests and flatter troughs, a second harmonic as in a Stokes
    # wave, sea_wave_profile; peak 0 is the plain sine)
    f=vec2(sn,cs)
    if peak>0.0: f=vec2(sn+peak*(2.0*sn*sn-1.0),cs*(1.0+4.0*peak*sn))
    # (near a shore: the forward wave's share, and its reflection running back)
    if travel<1.0: f=f*(0.5+0.5*travel)+vec2(sn*back.x+cs*back.y,cs*back.x-sn*back.y)*(0.5-0.5*travel)
    slope=height*f.y
    vec3(height*f.x,slope*band.x,slope*band.y)

# (depth: the water's, m; calm: the harbour's shelter there, sea_calm. Each band is kept by
# sea_band_keep; the defaults are the open deep sea, every band whole)
sea_swell = (p: vec2,u: SeaParams,dist: f32,storm_water: bool = false,depth: f32 = 1000.0,calm: f32 = 0.0) -> vec3:
    if dist>=u.sea_storm.z:return vec3(0,0,0)
    # Constant uniform indices avoid a per-pixel dynamic array loop on Intel.
    result=vec3(0,0,0)
    a=u.wind.w;peak=if storm_water: u.sea_storm.y else: 0.0
    # Each band's share here (sea_band_keep). Out on the deep open sea, most of every picture,
    # all are whole and none is worked out: deeper than a quarter of the longest band and outside
    # any basin. Elsewhere the ramps without a division (sea_band_keep_fast): the depth over the
    # sea's stretch, against each band's ordinary length (1/(0.14 L) for 61, 37, 23, 13, 7.3, 4.1 m).
    # And the two short bands' share that still runs on (sea_band_travel; SEA_TRAVEL_BANDS): all of
    # it from a quarter of their length of water, so nothing more to work out on the deep open sea.
    k0: f32 = 1.0; k1: f32 = 1.0; k2: f32 = 1.0; k3: f32 = 1.0; k4: f32 = 1.0; k5: f32 = 1.0
    q4: f32 = 1.0; q5: f32 = 1.0
    x = depth*u.swell_gain[1].z
    if x < 15.25 or calm > 0.0:
        k0 = sea_band_keep_fast(x,0.11709602,1.0,calm)
        k1 = sea_band_keep_fast(x,0.19305019,1.0,calm)
        k2 = sea_band_keep_fast(x,0.31055901,1.0,calm)
        k3 = sea_band_keep_fast(x,0.54945055,1.0,calm)
        k4 = sea_band_keep_fast(x,0.97847358,0.78,calm)
        k5 = sea_band_keep_fast(x,1.74216028,0.4,calm)
        still = sea_shore_still(depth)
        q4 = sea_band_travel_fast(x,0.54794521,calm)*still
        q5 = sea_band_travel_fast(x,0.97560976,calm)*still
    result += sea_swell_band(p,u.swell_phase[0],a*u.swell_gain[0].x*k0,dist,peak)
    result += sea_swell_band(p,u.swell_phase[1],a*u.swell_gain[0].y*k1,dist,peak)
    result += sea_swell_band(p,u.swell_phase[2],a*u.swell_gain[0].z*k2,dist,peak)
    result += sea_swell_band(p,u.swell_phase[3],a*u.swell_gain[0].w*k3,dist,peak)
    result += sea_swell_band(p,u.swell_phase[4],a*u.swell_gain[1].x*k4,dist,peak,q4,u.swell_back[2].xy)
    result += sea_swell_band(p,u.swell_phase[5],a*u.swell_gain[1].y*k5,dist,peak,q5,u.swell_back[2].zw)
    result

sea_ripple_band = (p: vec2,band: vec4,dist: f32,travel: f32 = 1.0,back: vec2 = vec2(1,0)) -> vec2:
    fade=1.0-smoothstep(band.w*14.0,band.w*60.0,dist)
    phase=dot(band.xy,p)+band.z
    c=cos(phase)
    # (near a shore, as the swells: the forward ripple's share and its reflection, sea_band_travel)
    if travel<1.0: c=c*(0.5+0.5*travel)+(c*back.x-sin(phase)*back.y)*(0.5-0.5*travel)
    # The vector already contains tau/wavelength; recover its direction with
    # multiplication, preserving the original wind magnitude without sqrt.
    band.xy*(band.w*(0.07/6.28318530718)*c*fade)

# (depth, calm: as sea_swell's; the two longest ripples, 3.1 and 2.3 m, the fastest, slow toward a
# shore and stand in a basin the same way, whole from half their length of water: 1.55 m for the
# longer. The three short ones, slower and a pixel or two near, run on: a reflection each costs the
# drawn sea a sine)
sea_ripples = (p: vec2,u: SeaParams,dist: f32,depth: f32 = 1000.0,calm: f32 = 0.0) -> vec2:
    if dist>=186.0:return vec2(0,0)
    q0: f32 = 1.0; q1: f32 = 1.0; still: f32 = 1.0
    if depth < SEA_SHORE_STILL or calm > 0.0:
        still = sea_shore_still(depth)
        q0 = sea_band_travel_fast(depth,0.64516129,calm)*still
        q1 = sea_band_travel_fast(depth,0.86956522,calm)*still
    result=vec2(0,0)
    result += sea_ripple_band(p,u.ripple_phase[0],dist,q0,u.ripple_back[0].xy)
    result += sea_ripple_band(p,u.ripple_phase[1],dist,q1,u.ripple_back[0].zw)
    # (the short ones, over the shore's last stretch, calm instead: lower, down to three tenths at
    # the waterline, rather than a reflection each, which would cost a sine apiece)
    result += (sea_ripple_band(p,u.ripple_phase[2],dist)+sea_ripple_band(p,u.ripple_phase[3],dist)+sea_ripple_band(p,u.ripple_phase[4],dist))*(0.3+0.7*still)
    result

# fine ripples raised by the wind (their slope), shorter than the swells, filtered by distance
_ripples = (p: vec2, t: f32, wd: vec2, dist: f32) -> vec2:
    if dist >= 186.0: return vec2(0,0)
    turns: f32[5] = [0.3, -0.35, 0.75, -0.8, 0.05]
    lens: f32[5] = [3.1, 2.3, 1.6, 1.15, 0.8]
    g = vec2(0, 0)
    loop k in 0..5:
        a = turns[k]
        d = vec2(wd.x * cos(a) - wd.y * sin(a), wd.x * sin(a) + wd.y * cos(a))
        w = 6.2831853 / lens[k]
        fade = 1.0 - smoothstep(lens[k] * 14.0, lens[k] * 60.0, dist)
        ph = dot(d, p) * w - t * sqrt(9.8 * w) * 1.1 + f32(k) * 1.7
        g = g + d * (cos(ph) * 0.07 * fade)
    g

# the painted crests, after the toon seas: thin pale strokes across the wind, curling and broken,
# drifting downwind
_strokes = (p: vec2, t: f32, wd: vec2, ws: f32) -> f32:
    side = vec2(-wd.y, wd.x)
    a = dot(p, wd)
    b = dot(p, side)
    warp = (vnoise(vec2(a * 0.02, b * 0.03)) - 0.5) * 18.0 + sin(b * 0.09 + a * 0.02) * 2.5
    ph = (a + warp - t * 2.4) / 9.0
    row = floor(ph)
    k = ph - row
    # pieces of crest along the row, each its own length, width, curl and brightness
    rl = 0.05 + 0.1 * hash21(vec2(row, 11.0))
    sl = b * rl + hash21(vec2(row, 3.0)) * 50.0
    seg = floor(sl)
    sf = sl - seg
    h1 = hash21(vec2(seg, row))
    h2 = hash21(vec2(seg + 7.0, row * 1.3))
    h3 = hash21(vec2(seg * 1.7, row + 5.0))
    on = step(0.62 - ws * 0.025, h1)
    big = step(0.8, h2) * smoothstep(3.0, 9.0, ws)
    curl = (sf - 0.5) * (sf - 0.5) * (0.08 + 0.14 * h3)
    kk = k - 0.06 - curl + (h3 - 0.5) * 0.05
    taper = sin(clamp((sf - 0.08) / 0.84, 0.0, 1.0) * 3.14159)
    w = (0.006 + 0.022 * taper) * (0.6 + 0.8 * h2) * (1.0 + 1.4 * big)
    band = smoothstep(-w * 0.6, 0.0, kk) * (1.0 - smoothstep(w * 0.5, w * 1.5, kk))
    # a whitecap trails foam behind its crest
    tail = big * smoothstep(-0.16, -0.01, kk) * (1.0 - smoothstep(-0.01, 0.0, kk)) * taper * 0.45
    clamp(max(band, tail) * on * (0.65 + 0.35 * h3), 0.0, 1.0)

# small marks on the water, fixed to the sea: flecks of foam (+) and dark ripple (-), sparse, in
# cells `size` meters across. The shutter: the mark seen through the stretch of sea [p - smear, p]
# that passed over this pixel while it was open (a capsule, so one smooth smear, not copies).
# (+ light, - dark, 0 none)
sea_fleck = (p: vec2, smear: vec2, size: f32, seed: f32, anchor: vec4) -> f32:
    best: f32 = 0.0
    previous=vec2(1e30,1e30)
    loop k in 0..2:
        q = (p - smear * f32(k)) / size + anchor.xy
        cell = floor(q)+anchor.zw
        # Both shutter endpoints usually lie in the same cell. They describe
        # the same swept circle: do its hashes and distance evaluation once.
        if k==1 and cell.x==previous.x and cell.y==previous.y:continue
        previous=cell
        r1 = hash21(cell + vec2(41.0 + seed, 7.0))
        if r1 >= 0.6:
            r2 = hash21(cell + vec2(3.0, 59.0 + seed))
            r3 = hash21(cell + vec2(17.0 + seed, 23.0))
            # Centre relative to this sample; never form two huge positions
            # just to subtract them. The cell hash stays fixed across chart snaps.
            c = (vec2(0.25,0.25)+vec2(r2,r3)*0.5-fract(q))*size+smear*(1.0-f32(k))
            # (distance from the mark's center to the swept stretch)
            a = vec2(0,0)
            ab = smear
            t = clamp(dot(c - a, ab) / max(dot(ab, ab), 0.0001), 0.0, 1.0)
            d = length(c - (a + ab * t)) / size
            m = 1.0 - smoothstep(0.1, 0.17, d)
            v = if r1 > 0.82: m else: -m
            if abs(v) > abs(best): best = v
    best

# The original three circular detail sizes, with separate integer cell identity
# and local position. Translation cannot enlarge a mark or change its density.
sea_marks = (p: vec2, smear: vec2, dist: f32, wd: vec2, u: SeaParams) -> f32:
    sizes: f32[3] = [1.3,3.6,10.0]
    acc: f32 = 0.0
    loop o in 0..3:
        size = sizes[o]
        vis = smoothstep(dist*0.004,dist*0.009,size)
        if vis > 0.0:
            m = sea_fleck(p,smear,size,f32(o)*13.0,u.mark_phase[o])*vis
            if abs(m) > abs(acc): acc = m
    acc

# Two advected copies usually sample the same cell. Share only its immutable
# hashes; each copy keeps its own shutter distance and strongest signed mark.
sea_marks_pair=(a:vec2,b:vec2,smear:vec2,dist:f32,u:SeaParams)->vec2:
    sizes:f32[3]=[1.3,3.6,10.0]
    result=vec2(0,0)
    loop o in 0..3:
        size=sizes[o];vis=smoothstep(dist*0.004,dist*0.009,size)
        if vis<=0.0:continue
        anchor=u.mark_phase[o];seed=f32(o)*13.0
        hashed=vec2(1e30,1e30);random=vec3(0,0,0)
        loop phase in 0..2:
            point=if phase==0:a else:b
            previous=vec2(1e30,1e30);best:f32=0.0
            loop k in 0..2:
                q=(point-smear*f32(k))/size+anchor.xy
                cell=floor(q)+anchor.zw
                if k==1 and cell==previous:continue
                previous=cell
                if cell!=hashed:
                    random.x=hash21(cell+vec2(41.0+seed,7.0))
                    if random.x>=0.6:
                        random.y=hash21(cell+vec2(3.0,59.0+seed))
                        random.z=hash21(cell+vec2(17.0+seed,23.0))
                    hashed=cell
                if random.x>=0.6:
                    c=(vec2(0.25,0.25)+random.yz*0.5-fract(q))*size+smear*(1.0-f32(k))
                    t=clamp(dot(c,smear)/max(dot(smear,smear),0.0001),0.0,1.0)
                    d=length(c-smear*t)/size
                    m=1.0-smoothstep(0.1,0.17,d)
                    v=if random.x>0.82:m else:-m
                    if abs(v)>abs(best):best=v
            value=best*vis
            if phase==0:
                if abs(value)>abs(result.x):result.x=value
            else:
                if abs(value)>abs(result.y):result.y=value
    result

sea_fleck_color=(body:vec3,sky:vec3,signed_mark:f32)->vec3:
    if signed_mark>0.0:mix(body,sky,0.6)*1.3+vec3(0.05,0.07,0.07) else:body*0.6

water_fleck_relative_color=(water:vec3,reference:vec3,paint:vec3)->vec3:
    luminance=vec3(0.2126,0.7152,0.0722)
    water*(dot(paint,luminance)/max(dot(reference,luminance),0.00001))

# Permanent painted speed cues also exist on glassy water. Wind controls waves,
# crests and glints; it must never switch off the small coloured marks.
sea_detail_strength = (dist: f32,rush: f32,shallow: f32) -> f32:
    (1.0-smoothstep(120.0,450.0,dist))*(0.35+0.65*rush)*(1.0-shallow*0.5)

# how much a point is in the aircraft shadows passed (0..1), with an edge a pixel or so soft
_shadowed = (p: vec2, u: SeaParams, aa: f32) -> f32:
    # Most water pixels cannot meet an aircraft shadow. Bounds include the
    # antialiased edge, so this only avoids work with an exactly zero result.
    pad = aa*u.shade_pad
    if p.x < u.shade_bounds.x-pad or p.y < u.shade_bounds.y-pad or p.x > u.shade_bounds.z+pad or p.y > u.shade_bounds.w+pad: return 0.0
    sh: f32 = 0.0
    loop q in 0..16:
        if f32(q) < u.shade_n:
            a = u.shade[q * 2].xy
            b = u.shade[q * 2].zw
            c = u.shade[q * 2 + 1].xy
            d = u.shade[q * 2 + 1].zw
            lo = min(min(a,b),min(c,d))-vec2(pad,pad)
            hi = max(max(a,b),max(c,d))+vec2(pad,pad)
            if p.x < lo.x or p.y < lo.y or p.x > hi.x or p.y > hi.y: continue
            area = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
            o: f32 = if area < 0.0: -1.0 else: 1.0
            e1 = ((b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x)) / max(length(b - a), 0.01) * o
            e2 = ((c.x - b.x) * (p.y - b.y) - (c.y - b.y) * (p.x - b.x)) / max(length(c - b), 0.01) * o
            e3 = ((d.x - c.x) * (p.y - c.y) - (d.y - c.y) * (p.x - c.x)) / max(length(d - c), 0.01) * o
            e4 = ((a.x - d.x) * (p.y - d.y) - (a.y - d.y) * (p.x - d.x)) / max(length(a - d), 0.01) * o
            m = min(min(e1, e2), min(e3, e4))
            al = u.shade_alpha[q / 4]
            k = if q % 4 == 0: al.x else: (if q % 4 == 1: al.y else: (if q % 4 == 2: al.z else: al.w))
            sh = max(sh, smoothstep(-aa, aa, m) * k)
    sh

# the painted crests where the swell actually crests: broken strokes along the height contour
# just below each crest, on its downwind face (the face the wind steepens), so they ride the
# waves one sees; more and whiter in a fresh wind
_crest_strokes = (p: vec2, s: vec3, t: f32, wd: vec2, ws: f32, amp: f32, dist: f32, wet: f32 = 0.0) -> f32:
    total = amp * 145.0                                  # (about the swells' height together)
    hn = s.x / max(total, 0.01)
    lvl = 0.42 + mix(0.12,0.45,wet) * (vnoise(p * 0.03)-wet*0.35)
    w = max(fwidth(hn) * 1.6, 0.012)
    line = 1.0 - smoothstep(w * 0.4, w * 1.6, abs(hn - lvl))
    # (the downwind face: the height falls away downwind)
    face = smoothstep(0.0, 0.03, -(s.y * wd.x + s.z * wd.y))
    # broken into strokes of their own lengths along the crest
    side = vec2(-wd.y, wd.x)
    b = dot(p, side) * 0.09 + vnoise(p * 0.02) * 3.0
    seg = floor(b)
    sf = b - seg
    r = hash21(vec2(seg, floor(dot(p, wd) * 0.05)))
    on = step(0.32 - ws * 0.025+wet*0.35, r) * sin(clamp((sf - 0.1) / 0.8, 0.0, 1.0) * 3.14159)
    # whitecaps: the crest itself, foaming, when the wind is fresh
    cap = smoothstep(lvl + 0.18, lvl + 0.3, hn) * smoothstep(5.0, 10.0, ws+wet*6.0) * step(0.6+wet*0.22, r)
    clamp(line * face * on + cap * 0.6, 0.0, 1.0)

# The storm sea's foam noise: four independent smooth value noises, one a channel, each tiling
# every STORM_NOISE_CELLS cells, drawn once the first time a storm is up. The foam reads it with
# a few texture reads where it would otherwise hash four corners for each of five noises.
const STORM_NOISE_CELLS = 16
const STORM_NOISE_TEXELS = 8
const STORM_NOISE_SCALE: f32 = 0.0625    # (1/STORM_NOISE_CELLS: noise cells to the tile's uv)
sea_storm_noise_corner = (x: int, y: int, c: int) -> f32:
    h = sin(f64(x & (STORM_NOISE_CELLS-1))*12.9898+f64(y & (STORM_NOISE_CELLS-1))*78.233+f64(c)*37.719+0.5)*43758.5453
    f32(h-floor(h))
sea_storm_noise_image = () -> Image:
    size = STORM_NOISE_CELLS*STORM_NOISE_TEXELS
    img = image(size,size)
    loop y in 0..size:
        loop x in 0..size:
            cx = x/STORM_NOISE_TEXELS; cy = y/STORM_NOISE_TEXELS
            fx = (f32(x%STORM_NOISE_TEXELS)+0.5)/f32(STORM_NOISE_TEXELS); fy = (f32(y%STORM_NOISE_TEXELS)+0.5)/f32(STORM_NOISE_TEXELS)
            ux = fx*fx*(3.0-2.0*fx); uy = fy*fy*(3.0-2.0*fy)
            v = vec4(0,0,0,0)
            loop c in 0..4:
                a = sea_storm_noise_corner(cx,cy,c); b = sea_storm_noise_corner(cx+1,cy,c)
                d = sea_storm_noise_corner(cx,cy+1,c); e = sea_storm_noise_corner(cx+1,cy+1,c)
                n = (a+(b-a)*ux)*(1.0-uy)+(d+(e-d)*ux)*uy
                if c == 0: v.x = n
                else if c == 1: v.y = n
                else if c == 2: v.z = n
                else: v.w = n
            img.set(x,y,v)
    img

# A storm's foam on the sea (0..1) at p, with the swell s there (height, slopes) and the swells'
# whole height. Breaking crests: the top of each big swell white where it steepens downwind, in
# ragged patches. Behind them a dense marbled web: fine veins of foam (contours of two noises,
# a little longer along the wind than across it), bent by a slow warp and by the waves' own
# slopes so no line runs straight, with small patches where the veins gather; thick in the lee
# of the breaking crests and thinning between them. Veins about a pixel wide near; far off,
# their average.
sea_storm_foam = (p: vec2, s: vec3, wd: vec2, t: f32, height: f32, dist: f32, storm: f32, noise: Texture) -> f32:
    side = vec2(-wd.y, wd.x)
    a = dot(p, wd) - t*2.5
    b = dot(p, side)
    hn = s.x/max(height*0.5, 0.01)                     # (about -1 in a trough .. 1 on a crest)
    down = -(s.y*wd.x + s.z*wd.y)                      # (the downwind face falls away)
    q0 = vec2(a*0.05, b*0.125)
    w = max((fwidth(q0.x) + fwidth(q0.y))*0.45, 0.045)  # (a vein some decimetres wide, at least a pixel)
    fw = max((fwidth(p.x) + fwidth(p.y))*0.9*0.45, 0.035)  # (the fine net's lines, about a pixel)
    # (one slow noise both bends the web and says where along each crest it is breaking: patches
    # short downwind, long across it)
    warp = sample_lod(noise, (q0*0.31 + vec2(3.7, 1.9))*STORM_NOISE_SCALE, 0.0).w
    # (far off, where the tile's repeat every 16 cells, a kilometre downwind and 400 m across,
    # showed from height as a grid over the whole sea: an untiled noise as large, the patches'
    # places only, the foam's look the same)
    far = smoothstep(1200.0, 3500.0, dist)
    if far > 0.0: warp = mix(warp, vnoise(vec2(a*0.0155, b*0.0388) + vec2(7.1, 2.3)), far)
    crest = smoothstep(0.2, 0.6, hn + warp*0.5 - 0.25) * smoothstep(-0.04, 0.08, down + 0.08)
    crest = crest * smoothstep(0.44, 0.66, warp + 0.12*storm)
    # (and along the very top of each big sea a white line of foam, ragged, where the crest is
    # breaking into the wind's spray)
    crest = max(crest, smoothstep(0.7, 0.77, hn + (warp - 0.5)*0.35)*smoothstep(-0.1, 0.05, down + 0.1))
    # (how much foam lies here: most in the lee of the crests, least in the troughs between)
    lee = smoothstep(-0.7, 0.4, hn) * (0.55 + 0.45*smoothstep(-0.05, 0.1, down))
    cover = clamp(0.2 + 0.75*lee + 0.5*(warp - 0.5), 0.0, 1.0)
    near = 1.0 - smoothstep(200.0, 700.0, dist)
    web: f32 = 0.14 + 0.32*cover                          # (far: the web's average, no shimmer)
    if near > 0.0:
        q = q0 + vec2(warp*1.3, (warp - 0.5)*1.0) + vec2(dot(s.yz, wd), dot(s.yz, side))*2.5
        n1 = sample_lod(noise, q*STORM_NOISE_SCALE, 0.0).x
        # (a second family of veins turned about sixty degrees, crossing the first into a net)
        n2 = sample_lod(noise, (vec2(q.x*0.5 - q.y*0.87, q.x*0.87 + q.y*0.5)*1.7 + vec2(5.2, 8.1))*STORM_NOISE_SCALE, 0.0).y
        # (each family's veins broken into strands by the other's noise: torn, never smooth bands)
        v1 = (1.0 - smoothstep(w*0.5, w, abs(n1 - 0.5)))*smoothstep(0.28, 0.42, n2)
        v2 = (1.0 - smoothstep(w*0.5, w*1.2, abs(n2 - 0.5)))*smoothstep(0.3, 0.45, n1)
        # (where the veins gather, sheets of foam: more of them, and whiter, the thicker the cover)
        g = n1*0.5 + n2*0.5
        # Close by, white water is chaotic at every scale: four fine noises from one read (about
        # a metre a cell, drifting downwind) rag the sheets' edges, punch rounded holes and bubbles
        # through them, scatter small torn patches between them and draw a fine net of breaking
        # lines; past 120 m, or where there is next to no foam, they are left out.
        rag: f32 = 0.0; holes: f32 = 1.0; bits: f32 = 0.0; fine: f32 = 0.0
        if dist < 120.0 and cover > 0.12:
            close = 1.0 - smoothstep(60.0, 120.0, dist)
            hf = sample_lod(noise, (p*vec2(0.9, 0.9) + wd*(t*1.1) + vec2(11.3, 4.7))*STORM_NOISE_SCALE, 0.0)
            rag = (hf.w - 0.5)*0.16*close
            holes = mix(1.0, smoothstep(0.3, 0.38, hf.x), close)
            fine = (1.0 - smoothstep(fw*0.5, fw, abs(hf.z - 0.5)))*smoothstep(0.35, 0.5, hf.y)*close
            bits = smoothstep(0.7, 0.74, hf.y)*smoothstep(0.25, 0.6, cover)*close
        gathered = smoothstep(0.6 - 0.16*cover + rag, 0.64 - 0.14*cover + rag, g)*holes
        veins = max(v1, v2)*smoothstep(0.0, 0.3, cover + (n2 - 0.5)*0.4)*holes
        near_web = max(max(veins, gathered*smoothstep(0.15, 0.55, cover)), max(bits, fine*smoothstep(0.2, 0.6, cover)*0.85))
        web = mix(web, near_web, near)
    clamp(max(crest, web*0.9) * storm, 0.0, 1.0)

# Conservative reflection bound for every possible random facet tilt. A unit
# normal perturbed by a vector of length <=r turns by at most asin(r). The
# reflected-light dot is <= (1+v.l)*(nf.h)^2-v.l. Reject only when even that
# bound cannot reach the glint's first smoothstep edge; no facets are thinned.
sea_glint_possible = (n: vec3,v: vec3,l: vec3,h: vec3,rough: f32) -> bool:
    r=(0.22+0.45*rough)*0.5
    if r>=0.999:return true
    cosine=abs(dot(n,h))
    limit=sqrt(max(1.0-r*r,0.0))
    bound: f32=1.0
    if cosine<limit:bound=cosine*limit+sqrt(max(1.0-cosine*cosine,0.0))*r
    vl=dot(v,l)
    (1.0+vl)*bound*bound-vl>=GLINT_ACCEPT-0.0005

# A patch of wave facets, drawn once when the sea is initialized. Each cell
# seeds four independent centres anywhere inside it. Dashes and crescent lips
# extend across cell and tile edges. Red is their energy; the other channels
# carry energy-weighted orientation, tilt and phase, so filtering across an
# empty texel preserves the properties of the facet that supplied the light.
const GLINT_ACCEPT: f32 = 0.986
const GLINT_CELLS = 32
const GLINT_TEXELS = 8
const GLINT_TILE = GLINT_CELLS*GLINT_TEXELS
sea_facet_tile: Texture
sea_facet_image = () -> Image:
    img = image(GLINT_TILE,GLINT_TILE)
    loop row in 0..GLINT_CELLS/2:
        loop col in 0..GLINT_CELLS/2:
            r = rng(2129+row*7919+col*104729)
            loop k in 0..4:
                cx = (f64(col)+r.next_float())*2.0*GLINT_TEXELS
                cy = (f64(row)+r.next_float())*2.0*GLINT_TEXELS
                angle = r.next_float()*TAU
                ax = cos(angle); ay = sin(angle)
                large = r.next_float()>0.93
                width = (2.5+1.25*r.next_float())*(if large: 1.5 else: 1.0)
                height = width*(0.42+0.48*r.next_float())
                lip = r.next_float()>0.65
                strength = f32((0.35+0.5*r.next_float())*(if large: 1.17 else: 1.0))
                props = vec4(1,f32(r.next_float()),f32(r.next_float()),f32(r.next_float()))
                loop y in int(floor(cy-width))..int(ceil(cy+width))+1:
                    loop x in int(floor(cx-width))..int(ceil(cx+width))+1:
                        dx = f64(x)+0.5-cx; dy = f64(y)+0.5-cy
                        a = (dx*ax+dy*ay)/width
                        b = (dy*ax-dx*ay)/height
                        edge = max(1.0-a*a-b*b,0.0)
                        if lip: edge *= smoothstep(0.38,0.8,a*a+(b-0.58)*(b-0.58))
                        energy = strength*f32(edge*sqrt(edge))
                        u = x & (GLINT_TILE-1); v = y & (GLINT_TILE-1)
                        if energy>img.get(u,v).x: img.set(u,v,props*energy)
    img

# Equal-area rotations and offsets decorrelate successive octaves. Every
# octave samples the same distribution. Its projected cell area tracks the
# pixel footprint on the water, including foreshortening at grazing angles.
_glints = (p: vec2, n: vec3, v: vec3, l: vec3, dist: f32, t: f32, rough: f32, u: SeaParams) -> f32:
    px = dist*u.glint_pixel
    footprint = px/sqrt(max(v.y,0.012))
    lod = clamp(log(max(footprint*5.0/0.3,1.0))*1.442695,0.0,15.0)
    level = floor(lod)
    divisor = pow(2.0,level)
    anchor = sea_glint_anchor(u.glint_phase,divisor)
    # Both orientations repeat after 5 tiles (the rotation is 3/5,4/5).
    # Keep a multiple of two as well so the adjacent octave wraps identically.
    period:f32 = 10.0*f32(GLINT_CELLS)
    cell = anchor.zw-floor(anchor.zw/period)*period
    uv = (p/(0.3*divisor)+anchor.xy+cell)/f32(GLINT_CELLS)
    odd = fract(level*0.5)>0.25
    rotated = vec2(0.6*uv.x-0.8*uv.y,0.8*uv.x+0.6*uv.y)
    blend = fract(lod)
    # Give both representatives the same prefilter once the base facets are
    # subpixel. Averaging two different slope distributions biases the path
    # brightness at the handover. Close to the floats retain the full lip.
    mip = 0.75*min(footprint*(5.0/0.3),1.0)
    result:f32 = 0.0
    loop k in 0..2:
        coarse = k==1
        pos = if odd!=coarse: rotated else: uv
        scale = if coarse: 0.5 else: 1.0
        pos = pos*scale+vec2(0.393,0.719)*(level+f32(k))
        facet = sample_lod(u.glint_facets,pos,mip)
        props = facet.yzw/max(facet.x,0.0001)
        # Stagger the handover per facet. Complementary weights on the same
        # rank distribution preserve expected energy without a belt of half-lit dots.
        replace = smoothstep(0.0,1.0,(blend-props.z*0.70)/0.30)
        share = if coarse: replace else: 1.0-replace
        # Filtered rates would shear one glint apart as elapsed time grows.
        spin = props.x*TAU+t*2.3
        lean = props.y*props.y*0.5*(0.22+0.45*rough)
        normal = normalize(n+vec3(cos(spin)*lean,0,sin(spin)*lean))
        hit = smoothstep(GLINT_ACCEPT,0.999,dot(reflect(-v,normal),l))
        pulse = 0.52+0.48*sin(t*6.7+props.x*TAU+props.y*3.0)
        result += share*hit*facet.x*pulse
    result

# Optical colour falloff is separate from physical depth/shoreline opacity.
# Enclosed bays retain their longer clear-water ramp; open shelves turn blue.
# The shallows' own colour by depth, as the film paints a cove and as the Aegean looks from the
# air: a bright, clear aqua over the sand at the edge, turquoise-aqua, turquoise, then teal where
# it meets the deep blue. (Green comes only from the weed beneath, never the water.) Scaled by
# the hour's shallow colour against noon's, so dawn, dusk, night and overcast tint it as they
# tint the sea.
sea_shallow_ramp = (depth: f32, clear_bay: f32, palette: vec3) -> vec3:
    aqua = vec3(0.56, 0.92, 0.90); bright = vec3(0.24, 0.84, 0.86); turquoise = vec3(0.08, 0.68, 0.80); teal = vec3(0.04, 0.45, 0.66)
    c = mix(aqua, bright, smoothstep(0.2, 2.2, depth))
    c = mix(c, turquoise, smoothstep(2.0, 5.5, depth))
    c = mix(c, teal, smoothstep(5.5, 12.0, depth)*(1.0-clear_bay*0.3))
    c*clamp(palette/vec3(0.2, 0.78, 0.8), vec3(0,0,0), vec3(1.4,1.4,1.4))

sea_shallow_mix = (depth: f32, shelter: f32) -> f32:
    clear = 1.0-smoothstep(0.5,mix(12.0,24.0,clamp(shelter,0.0,1.0)),depth)
    clear*clear

sea_depth_hidden=(clip:vec4,u:SeaParams)->bool:
    if u.reject_depth<0.5:return false
    uv=clip.xy/clip.w*0.5+vec2(0.5,0.5)
    pixel = sample(u.opaque_depth, uv)
    stored = pixel.x
    when TARGET == "macos":
        if u.reject_depth > 1.5: stored = dot(pixel.xyz, vec3(65536,256,1)) * (255.0 / 16777215.0)
    world_depth_encode(clip.w) > stored + 0.00000012
sea_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    set_depth(world_depth_encode(1.0 / i.pos.w))
    sea_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow,i.sun_lost,i.calm),u)
coast_sea_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_sea_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow,i.sun_lost,i.calm),u)

# What a walled canal's water mirrors along rd: the dark stone wall, the trees and facades behind
# the parapet, or the sky over them (each wall a vertical plane at the canal's half width).
canal_mirror = (i: SeaOut, u: SeaParams, rd: vec3, skyc: vec3) -> vec3:
    d = normalize(i.current+vec2(0.00001,0))
    across = dot(rd.xz,vec2(-d.y,d.x))
    lat = i.water_chart.y
    gap = max(if across > 0.0: u.inland_walls.x-lat else: u.inland_walls.x+lat,0.0)
    per = rd.y/max(abs(across),0.002)
    light = u.sun*0.5+u.sky_top*0.45
    at_wall = gap*per
    soft = 0.15+gap*0.01
    stone = vec3(0.17,0.20,0.23)*light
    tree = vec3(0.06,0.16,0.12)*light
    along = i.water_chart.x+(gap+8.0)*dot(rd.xz,d)/max(abs(across),0.002)
    band = 0.9+0.12*step(0.5,fract(along/23.0))
    facade = vec3(0.70,0.67,0.58)*light*band
    at_tree = (gap+4.0)*per-u.inland_walls.y
    at_facade = (gap+8.0)*per
    over = mix(facade,skyc,smoothstep(u.inland_walls.z-soft,u.inland_walls.z+soft,at_facade))
    over = mix(over,tree,(smoothstep(1.0,2.0,at_tree)-smoothstep(7.0,9.0,at_tree))*0.75)
    mix(stone,over,smoothstep(u.inland_walls.y-soft,u.inland_walls.y+soft,at_wall))

sea_material = (i: SeaOut, u: SeaParams, refined: bool,inland:bool=false,fine_detail:bool=true,surf:bool=false,storm_water:bool=false) -> vec4:
    local = i.world.xz
    p = local+u.origin.xz
    dist = length(i.world - u.cam)
    # how deep it is here (the map: r = depth / 60 m), and so its color
    depth:f32=60.0;shelter:f32=0.0
    if inland:
        depth=if i.water_depth>=0.0:i.water_depth else:u.inland_depth
        shelter=0.8
    else:
        uv = (p + vec2(DEPTH_EXTENT * 0.5, DEPTH_EXTENT * 0.5)) / DEPTH_EXTENT
        dm = sample(u.depth, uv)
        shelter = dm.y
        depth = if uv.x > 0.0 and uv.x < 1.0 and uv.y > 0.0 and uv.y < 1.0: dm.x * 60.0 else: 60.0
        if u.expanded > 0.5 and (abs(p.x) >= 12000.0 or abs(p.y) >= 12000.0):
            shelter = 0.0
            depth = if abs(p.x) < 250000.0 and abs(p.y) < 200000.0: sample(u.world_depth, p / vec2(500000,400000) + vec2(0.5,0.5)).x * 60.0 else: 60.0
            near_uv = (p-u.local_area.xy)/max(u.local_area.z,1.0)+vec2(0.5,0.5)
            edge_dist = max(abs(near_uv.x-0.5),abs(near_uv.y-0.5))
            if u.local_area.w > 0.5 and edge_dist < 0.5:
                depth = mix(depth,sample(u.local_depth,near_uv).x*60.0,1.0-smoothstep(0.45,0.49,edge_dist))
                shelter = sample(u.local_depth,near_uv).y*(1.0-smoothstep(0.45,0.49,edge_dist))
    wd = u.wind.xy
    ws = u.wind.z
    g = mix(gust(p, u.drift), 0.5, smoothstep(2500.0, 12000.0, dist))
    rough = clamp(0.1 + ws / 12.0 * (0.45 + 0.9 * g), 0.0, 1.5)
    # going fast: the sea's fine detail near the camera streams past faster than the sea itself
    # (several times the true speed close by, the true speed some hundreds of meters out), so
    # the speed is felt where the eye reads it; the swells, the crests and everything far keep
    # the true speed. Two copies of the detail, each slid for a short while then crossfaded into
    # the other, so the slide never piles up into a smear.
    near = (1.0 - smoothstep(140.0, 420.0, dist)) * step(0.01, length(u.flow.xy))
    ph = u.time / u.flow.z
    pa = ph - floor(ph)
    ph2 = ph + 0.5
    pb = ph2 - floor(ph2)
    wa = 1.0 - abs(2.0 * pa - 1.0)
    wb = 1.0 - wa
    keep = 1.0 / sqrt(wa * wa + wb * wb)
    offa = u.flow.xy * ((pa - 0.5) * u.flow.z * near)
    offb = u.flow.xy * ((pb - 0.5) * u.flow.z * near)
    detail_a=local+offa;detail_b=local+offb
    detail_wa=wa;detail_wb=wb;detail_keep=keep
    detail_blend=near>0.0
    if inland:
        # Use the sea's undistorted world-metric field. A curved channel chart
        # shears circles at bends. Bound advection by the same two-phase cycle
        # as the sea so a varying current cannot accumulate that distortion.
        detail_a=local-i.current*((pa-0.5)*u.flow.z)
        detail_b=local-i.current*((pb-0.5)*u.flow.z)
        detail_blend=length(i.current)>0.0001
    # Inland marks are evaluated before the lighting terms. The result is the
    # same signed mark; fewer values are live across this loop on Intel GPUs.
    inland_marks:f32=0.0
    if fine_detail and inland and detail_blend and sea_detail_strength(dist,u.rush.w,0.0)>0.01:
        pair=sea_marks_pair(detail_a,detail_b,(u.rush.xz+u.flow.xy*near)*(0.6/60.0),dist,u)
        inland_marks=if abs(pair.x)*detail_wa>abs(pair.y)*detail_wb:pair.x*min(detail_wa*detail_keep,1.0) else:pair.y*min(detail_wb*detail_keep,1.0)
    calm = if inland: 0.0 else: i.calm
    s = if inland:vec3(0,0,0) else:sea_swell(local,u,dist,storm_water,depth,calm)
    # Open lake water carries a short wind chop: only its slopes (light, sky and
    # sun), never a height; a river's moving surface keeps its own marks.
    if inland and u.inland_chop>0.0:
        chop=sea_swell(local*2.3,u,dist)
        s=vec3(0,chop.y*u.inland_chop,chop.z*u.inland_chop)
    sa = s
    sb = s
    whole = not inland and u.flow.w > 0.5 and near > 0.0
    if whole:
        # (the whole look slides: the swells' slopes, so their light and shade, and their crests;
        # their height, under the aircraft's floats, stays true)
        sa = sea_swell(local+offa,u,dist,storm_water,depth,calm)
        sb = sea_swell(local+offb,u,dist,storm_water,depth,calm)
        s = vec3(s.x, (sa.y * wa + sb.y * wb) * keep, (sa.z * wa + sb.z * wb) * keep)
    if storm_water and not inland:
        shoal = sea_shoal(depth,u.sea_storm.x,u.sea_storm.w)
        s = s*shoal; sa = sa*shoal; sb = sb*shoal
    ripple_depth = if inland: 1000.0 else: depth
    rp = if fine_detail:sea_ripples(local+offa,u,dist,ripple_depth,calm)*rough else:vec2(0,0)
    if fine_detail and u.rain > 0.01 and dist < 90.0:
        q = p*1.4
        cell = floor(q); f = fract(q)-vec2(0.5,0.5)
        age = fract(u.time*1.7+hash21(cell))
        ring = sin((length(f)-age*0.7)*45.0)*exp(-abs(length(f)-age*0.7)*25.0)*(1.0-age)
        rp += f*(ring*u.rain*0.12*(1.0-smoothstep(45.0,90.0,dist)))
    if fine_detail and near > 0.0: rp = (rp * wa + sea_ripples(local+offb,u,dist,ripple_depth,calm) * (rough * wb)) * keep
    if fine_detail and inland and dist<186.0:
        d=normalize(i.current+vec2(0.00001,0));side=vec2(-d.y,d.x)
        along=dot(local,d);across=dot(local,side)
        fine=1.0-smoothstep(40.0,180.0,dist)
        # Dense current-aligned marks, plus fixed small standing ripples.
        rp+=d*(cos(along*8.0+u.inland_phase.x-u.time*6.4)*0.045*fine)
        rp+=side*(cos(across*19.0+u.inland_phase.y+sin(along*0.7+u.inland_phase.z))*0.035*fine)
        rp+=d*(cos(along*2.0+u.inland_phase.w)*0.035*(1.0-smoothstep(1.0,4.0,depth)))
    n = render_normal(normalize(vec3(-(s.y + rp.x), 1.0, -(s.z + rp.y))), i.world, u.cam)
    vdir = normalize(u.cam - render_world(i.world, u.cam))
    l = normalize(u.sun_dir)
    sh = 1.0 - smoothstep(0.5, 26.0, depth)              # 1 in the shallows
    clear_bay = shelter*(1.0-smoothstep(8.0,20.0,depth))*(1.0-u.rain*0.7)
    shallow = if inland:u.shallow else:sea_shallow_ramp(depth,clear_bay,u.shallow)
    body = mix(u.deep, shallow, sea_shallow_mix(depth,shelter))
    # the gusts darken the water they pass over
    body = body * (1.0 - 0.3 * g * clamp(ws / 8.0, 0.0, 1.0))
    storm = if inland or not storm_water: 0.0 else: u.sea_storm.x
    if storm > 0.0:
        # (a storm's water is dark and heavy: a deep cold teal, the blue drained from it)
        body = mix(body, vec3(0.07, 0.20, 0.22), storm*0.8)
    ndl = max(dot(n, l), 0.0)
    c = body * (mix(u.sun, vec3(1, 1, 1), 0.45) * (0.7 + 0.3 * ndl) + u.sky_top * 0.25)
    # the sky in it, more at a glancing look (less where the gusts roughen it)
    fres = 0.02 + 0.98 * pow(1.0 - max(dot(n, vdir), 0.0), 5.0)
    rd = reflect(-vdir, n)
    skyc = mix(u.sky_horizon, u.sky_top, clamp(rd.y * 1.4, 0.0, 1.0))
    low = 1.0 - smoothstep(0.1, 0.45, l.y)
    walled = inland and u.inland_walls.w > 0.5
    mirror = if walled: canal_mirror(i,u,rd,skyc) else: skyc
    # (a storm's water is rough and matte: the sky in it dulled toward the water's own grey, and
    # less of it, so the steep faces never turn to mirrors)
    if storm > 0.0: mirror = mix(mirror, mix(skyc, c, 0.5), storm*0.6)
    c = mix(c, mirror, clamp(fres * (0.6 + 0.3 * low) * (1.0 - 0.3 * g) * (1.0 - 0.45*storm), 0.0, 1.0))
    # the painted crests, near to middle distance, more in a fresh wind
    # Wet weather retains broken crest light at formation altitude. Reuse
    # the existing swell/crest field: no extra noise layer or near-field marks.
    # Below 180 m this is exactly the old detail, including its speed cues.
    wet_crests = smoothstep(0.02,0.28,u.rain)*smoothstep(180.0,420.0,dist)
    crest_fade = mix(1.0-smoothstep(180.0,650.0,dist),1.0-smoothstep(700.0,1900.0,dist),wet_crests)
    sfade = crest_fade*(1.0-sh*0.8)
    crest_amp = u.sea_storm.w/145.0*(1.0-wet_crests*smoothstep(400.0,1800.0,dist)*0.5)
    # (the crests at one call site, a loop the compiler cannot unroll: the whole sea's two offset
    # layers, or the one; three copies of _crest_strokes were a third of each sea, coast and
    # river program's link on a phone)
    st: f32 = 0.0
    crest_first = if whole: 1 else: 0
    crest_end = if whole: 3 else: if inland and u.inland_chop<=0.0: 0 else: 1
    # (a full storm's own breaking crests and foam take the strokes' place)
    if storm_water and storm >= 0.99: crest_end = crest_first
    loop k in crest_first..crest_end:
        cp = if k == 0: p else: if k == 1: p + offa else: p + offb
        cs = if k == 0: s else: if k == 1: sa else: sb
        camp = if k == 0: crest_amp*(if inland:u.inland_chop else:1.0) else: u.sea_storm.w/145.0
        one = _crest_strokes(cp, cs, u.time, wd, ws, camp, dist, if k == 0: wet_crests else: 0.0)
        st += if k == 0: one else: one * (if k == 1: wa else: wb)
    st = st * sfade * clamp(0.45 + ws / 10.0, 0.0, 1.0)*smoothstep(0.1,2.0,ws)*(if storm_water: 1.0-storm else: 1.0)
    c = mix(c, mix(skyc, vec3(1, 1, 1), 0.55) * (u.sun * 0.85 + u.sky_top * 0.25), st * 0.85)
    if storm > 0.0:
        # A storm's sea: breaking crests, and the foam they leave drawn out downwind into a
        # marbled net of streaks (sea_storm_foam). Foam is a cold off-white in the storm's light.
        sf = sea_storm_foam(p, s, wd, u.time, u.sea_storm.w, dist, storm, u.storm_noise)
        lum = dot(u.sun, vec3(0.3, 0.5, 0.2))*0.75 + dot(u.sky_top, vec3(0.3, 0.5, 0.2))*0.45
        # (light through the thin tops of the big seas: a cold green-teal)
        lift = clamp(s.x/max(u.sea_storm.w*0.5, 0.01), 0.0, 1.0)
        c = mix(c, vec3(0.10, 0.36, 0.36) * min(lum, 1.1), lift*lift*storm*0.45)
        c = mix(c, vec3(0.84, 0.89, 0.91) * min(lum*1.4, 1.15), sf)
    if inland and not walled:
        # Sky reflection remains Fresnel-driven; banks tint the grazing shallow view.
        bank_reflection=vec3(0.10,0.16,0.08)*(u.sky_horizon+u.sun*0.25)
        c=mix(c,bank_reflection,fres*(1.0-smoothstep(1.0,7.0,depth))*0.45)
    # the sea's own marks, persistent, nearer and stronger the faster one goes over them
    rf = sea_detail_strength(dist,u.rush.w,if inland:0.0 else:sh)
    if fine_detail and rf > 0.01:
        smear = (u.rush.xz + u.flow.xy * near) * (0.6 / 60.0)
        rs:f32=0.0
        if inland and detail_blend:rs=inland_marks
        else:
            rs=sea_marks(detail_a,smear,dist,wd,u)
            if detail_blend:
                rb = sea_marks(detail_b,smear,dist,wd,u)
                rs = if abs(rs) * detail_wa > abs(rb) * detail_wb: rs * min(detail_wa * detail_keep, 1.0) else: rb * min(detail_wb * detail_keep, 1.0)
        fleck=sea_fleck_color(body,skyc,rs)
        if inland:
            # Preserve the sea painter's relative light/dark contrast on the
            # darker river body instead of stamping absolute cyan sky colour.
            reference=u.fleck_reference*(1.0-0.3*g*clamp(ws/8.0,0.0,1.0))
            reference_c=reference*(mix(u.sun,vec3(1,1,1),0.45)*(0.7+0.3*ndl)+u.sky_top*0.25)
            reference_c=mix(reference_c,skyc,clamp(fres*(0.6+0.3*low)*(1.0-0.3*g),0.0,1.0))
            fleck=water_fleck_relative_color(c,reference_c,sea_fleck_color(reference,skyc,rs))
        c = mix(c,fleck,abs(rs)*rf*0.65)
    # the shadows of aircraft above
    shd: f32 = 0.0
    if u.shade_n > 0.0:
        shd = _shadowed(local, u, 0.08 + dist * 0.0015)
        c = mix(c, c * 0.42 + vec3(0.0, 0.02, 0.05), shd)
    # the sun: a soft sheen along its path, and the glints
    sun_l = u.specular_sun.xyz
    hv = normalize(sun_l + vdir)
    nh = max(dot(n, hv), 0.0)
    day = u.specular_sun.w
    variance = smoothstep(300.0, 3000.0, dist) * clamp(u.wind.w * 80.0, 0.0, 1.0)
    sheen = pow(nh, mix(90.0, 55.0, variance)) * 0.22 + pow(nh, mix(600.0, 160.0, variance)) * 0.5
    # Moonlight uses the same facets, with a silver tint and phase-dependent strength.
    moon_on = u.moon.w > 0.0
    ml = normalize(u.moon.xyz)
    mhv = normalize(ml + vdir)
    # (the glints at one call site, a loop the compiler cannot unroll: the sun's at one detail point
    # or two blended, then the moon's; three copies of _glints were a quarter of each sea, coast
    # and river program's link on a phone)
    # (under a full storm's overcast no glitter: not looked for at all)
    lit = not storm_water or storm < 0.99
    sun_glint = lit and day>0.0 and sea_glint_possible(n,vdir,sun_l,hv,rough)
    moon_glint = lit and moon_on and sea_glint_possible(n,vdir,ml,mhv,rough)
    gl: f32=0.0
    mgl: f32 = 0.0
    loop k in 0..(if moon_glint: 3 else: 2):
        if k == 0 and not sun_glint: continue
        if k == 1 and not (sun_glint and detail_blend): continue
        g = _glints(if k == 1: detail_b else: detail_a,n,vdir,if k == 2: ml else: sun_l,dist,u.time,rough,u)
        if k == 0: gl = g
        else if k == 1: gl = gl*detail_wa+g*detail_wb
        else: mgl = g
    sun_k = day * (1.0 - shd)*(1.0-u.rain*0.75)*(1.0-i.sun_lost)*(1.0-0.85*storm)
    c = c + u.glint_sun * (gl * u.glint_gain) * sun_k
    # (the sheen is added after the haze, below: the sun's path on the water is bright enough to
    # carry through more of it than the water's own colour does)
    sheen_c = u.glint_sun * sheen * sun_k
    if moon_on:
        mnh = max(dot(n, mhv), 0.0)
        msheen = pow(mnh, mix(90.0, 55.0, variance)) * 0.22 + pow(mnh, mix(600.0, 160.0, variance)) * 0.5
        c = c + vec3(0.78,0.84,0.95) * (msheen + mgl * 14.0) * u.moon.w * (1.0 - shd)*(1.0-u.rain*0.75)
    shore_depth = depth
    surf_depth = depth
    if refined and u.coast_near_area.w > 1.0:
        contact = coast_height_lookup(u.coast_near,u.coast_far,u.coast_near_area,u.coast_far_area,local,u.coast_roll)
        if contact.y > 0.99:
            shore_depth = coast_shore_depth(depth,max(0.0,i.world.y-contact.x))
            # (Surf's depth: the still sea over the ground, which does not ride the swell)
            if surf: surf_depth = mix(depth,max(0.0,-contact.x),1.0-smoothstep(2.0,3.5,-contact.x))
    # Both shore terms are identically zero beyond 3 m depth / 5 km range.
    # Do not run their noise and trigonometry over every offshore pixel.
    foam: f32 = 0.0
    # (Surf's screen-space widths, taken in uniform control flow: u.surf is the same
    # for every pixel)
    surf_pix: f32 = 0.0; surf_dw: f32 = 0.0; surf_fw: f32 = 0.0
    if surf:
        surf_pix = min(fwidth(p.x),fwidth(p.y)); surf_dw = fwidth(surf_depth); surf_fw = fwidth(shore_depth)
    # (Surf within its reach, 1.5 km, or 600 m on the low tier: beyond it the plain
    # shore foam takes over, crossfading)
    surf_w: f32 = 0.0
    if surf and not inland:
        reach = if u.surf.z > 0.5: 600.0 else: 1500.0
        surf_w = 1.0-smoothstep(reach*0.67,reach,dist)
        if surf_w > 0.0 and min(depth,surf_depth) < 3.0:
            foam = surf_sea_foam(p,u.time,surf_depth,surf_dw,u.surf.y,dist,surf_pix,shore_depth,surf_fw,u.surf.z > 0.5)*surf_w
    if surf_w < 1.0 and not inland and min(depth,shore_depth) < 3.0 and dist < 5000.0:
        # (a soft lace broken by drifting noise at two scales, never a regular sine weave)
        fn = (vnoise(p*0.55+vec2(u.time*0.35,-u.time*0.22))-0.5)*1.4+sin(p.x*1.7+p.y*1.1-u.time*1.1)*0.25
        wash = 0.6+max(s.x,0.0)*0.8+0.35*sin(u.time*1.4+vnoise(p*0.04)*6.0)
        edge = 1.0-smoothstep(0.12,wash+0.7+0.45*fn,shore_depth)
        breaker = (1.0-smoothstep(0.15,0.65,abs(depth-wash-0.6)))*clamp(ws/10.0,0.15,0.85)
        foam = max(foam,clamp(edge*(0.75+0.35*fn)+breaker*(0.5+0.5*fn),0.0,1.0)*(1.0-smoothstep(1500.0,5000.0,dist))*(1.0-surf_w))
    if inland and depth<1.4 and i.bank_impact>0.0:
        # Only an impinging current makes bank foam. Separate uneven patches,
        # with holes and drifting flecks, never a continuous shoreline contour.
        patches=smoothstep(0.48,0.72,vnoise(i.water_chart*vec2(0.11,0.3)))
        holes=smoothstep(0.30,0.65,vnoise(detail_a*1.3))
        foam=(1.0-smoothstep(0.1,1.4,depth))*i.bank_impact*patches*holes
    if surf and u.surf.w > 0.5 and not inland and dist < 1500.0 and local.x > u.surf_box.x and local.y > u.surf_box.y and local.x < u.surf_box.z and local.y < u.surf_box.w:
        # (Surf: the white water round the ships under way, surf.jo; only inside the box
        # round them all, and on the low tier the nearest ship's alone, without a loop)
        if u.surf.z > 0.5: foam = max(foam,surf_ship_foam(local,p,u.time,u.surf_ships[0],u.surf_ships[1],u.surf.y,dist,surf_pix,true))
        else:
            loop k in 0..4:
                if f32(k) < u.surf.w: foam = max(foam,surf_ship_foam(local,p,u.time,u.surf_ships[k*2],u.surf_ships[k*2+1],u.surf.y,dist,surf_pix,false))
    if surf and not inland:
        # (Surf's foam is opaque and painted: pale blue-white, its thinning edges a
        # little greyer)
        lum = dot(u.sun, vec3(0.3, 0.5, 0.2))
        c = mix(c, vec3(0.85, 0.90, 0.93) * min(lum * 0.8 + 0.2, 1.05), foam)
    else: c = mix(c, vec3(0.97, 0.98, 1.0) * (u.sun * 0.8 + u.sky_top * 0.3), foam * 0.85)
    # the water is clear: at the shore one sees the sand through it
    # (see-through at the waterline, closing smoothly with depth: the seabed reads through the
    # first metres instead of a milky film over it)
    a = clamp(1.0-exp(-depth*0.42)*0.9+fres*0.4+foam+gl*day,0.0,1.0)
    if not inland and clear_bay > 0.005:
        absorption = mix(0.12,0.055,clear_bay)
        clear_alpha = clamp(1.0-exp(-depth*absorption)*(1.0-fres*0.85)*0.95+foam+gl*day+u.rain*0.12,0.0,1.0)
        a = mix(a,clear_alpha,clear_bay)
    if inland:
        a=clamp(smoothstep(0.0,u.inland_opacity_depth,depth)+fres*0.4+foam+gl*day,0.0,1.0)
    haze = u.haze
    if not inland and u.haze_tangent.x >= 0.0: haze = air_tangent(u.haze,u.haze_tangent,i.world,u.cam)
    seen = aerial_seen(i.world, u.cam, u.fog)
    c = mix(c, haze, clamp(1.0 - seen, 0.0, 1.0))
    # (the sun's sheen through the haze: as it always was near, where the air hides little, and
    # far off a glitter path that carries on toward the horizon under a low sun instead of
    # drowning in the haze with the water: seen^0.4 for the haze's seen)
    c = c + sheen_c * pow(seen, 0.4)
    vec4(c, a)

sea_fs = (i: SeaOut,u: SeaParams) -> vec4: sea_material(i,u,false)
coast_sea_fs = (i: SeaOut,u: SeaParams) -> vec4: sea_material(i,u,true)
# (Surf's variants, made the first time it is needed; off, the sea is the plain shaders)
sea_surf_fs = (i: SeaOut,u: SeaParams) -> vec4: sea_material(i,u,false,surf=true)
coast_sea_surf_fs = (i: SeaOut,u: SeaParams) -> vec4: sea_material(i,u,true,surf=true)
sea_surf_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    set_depth(world_depth_encode(1.0 / i.pos.w))
    sea_surf_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow,i.sun_lost,i.calm),u)
coast_sea_surf_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    set_depth(world_depth_encode(1.0 / i.pos.w))
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_sea_surf_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow,i.sun_lost,i.calm),u)
sea_surf_sh: Shader
coast_sea_surf_sh: Shader
sea_surf_ready = false
sea_surf_shaders = ():
    global sea_surf_sh, coast_sea_surf_sh, sea_surf_ready
    if sea_surf_ready: return
    sea_surf_sh = make_shader(if world_logarithmic:shader(sea_depth_vs,sea_surf_depth_fs) else:shader(sea_vs,sea_surf_fs))
    coast_sea_surf_sh = make_shader(if world_logarithmic:shader(sea_depth_vs,coast_sea_surf_depth_fs) else:shader(sea_vs,coast_sea_surf_fs))
    sea_surf_ready = true
sea_storm_fs = (i: SeaOut,u: SeaParams) -> vec4: sea_material(i,u,false,storm_water=true)
coast_sea_storm_fs = (i: SeaOut,u: SeaParams) -> vec4: sea_material(i,u,true,storm_water=true)
sea_storm_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    set_depth(world_depth_encode(1.0 / i.pos.w))
    sea_storm_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow,i.sun_lost,i.calm),u)
coast_sea_storm_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_sea_storm_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow,i.sun_lost,i.calm),u)
# (the storm sea's programs, made the first time a storm is up)
sea_storm_sh: Shader
coast_sea_storm_sh: Shader
far_sea_storm_sh: Shader
sea_storm_ready = false
sea_storm_noise: Texture
sea_storm_shaders = ():
    global sea_storm_sh, coast_sea_storm_sh, far_sea_storm_sh, sea_storm_ready, sea_storm_noise
    if sea_storm_ready: return
    far_sea_storm_sh = make_shader(shader(far_sea_vs, far_sea_storm_fs))
    sea_storm_noise = texture(sea_storm_noise_image(),true)
    set_repeat(sea_storm_noise,true)
    sea_storm_sh = make_shader(if world_logarithmic:shader(sea_storm_depth_vs,sea_storm_depth_fs) else:shader(sea_storm_vs,sea_storm_fs))
    coast_sea_storm_sh = make_shader(if world_logarithmic:shader(sea_storm_depth_vs,coast_sea_storm_depth_fs) else:shader(sea_storm_vs,coast_sea_storm_fs))
    sea_storm_ready = true

sea_near_mesh: Mesh
coast_sea_sh: Shader
sea_sh: Shader
far_sea_sh: Shader
# the open sea from height (see DEEP_SEA_*): its deep colour and haze for the eye's height
sea_from_height = (p: mut SeaParams, L: Light):
    if tweaks.brighter_ocean: return
    rise = air_down_rise(f64(scene_camera().y))
    p.deep = L.sea_deep * mix(vec3(1, 1, 1), DEEP_SEA_NAVY, rise)
    p.haze = air_down(L.haze, f64(scene_camera().y))
far_sea_tri: Mesh

struct FarSeaVertex:
    pos: vec2
struct FarSeaOut:
    pos: vec4
    ndc: vec2
far_sea_vs = (v: FarSeaVertex, u: SeaParams) -> FarSeaOut:
    FarSeaOut(vec4(v.pos, u.far_z, 1), v.pos)
far_sea_at = (i: FarSeaOut, u: SeaParams, storm_water: bool) -> vec4:
    dir = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    # (the horizon's edge: how much of the pixel lies below the tangent, its alpha, so the line
    # is smooth where a pixel's centre alone drew it in stepped pixels, a staircase once tilted)
    h = max(u.cam.y, 0.001)
    r: f32 = EARTH_RADIUS
    tangent = sqrt(h * (2.0 * r + h))
    down = -dir.y
    cover = clamp((down - tangent / (r + h)) / max(fwidth(down), 0.000001) + 0.5, 0.0, 1.0)
    if cover <= 0.0: discard()
    dist = sea_intersection(dir, u.cam.y)
    # (a pixel the tangent crosses above its centre: the horizon's own point)
    if dist < 0.0: dist = tangent
    if dist < 14000.0: discard()
    world = vec3(u.cam.x + dir.x * dist, 0, u.cam.z + dir.z * dist)
    # The identical sea material at its actual surface point, not a sky tint; a storm's
    # sea its own (the near sea's program), so there is no ring where the two meet.
    c = sea_material(SeaOut(i.pos, world), u, false, storm_water=storm_water)
    vec4(c.xyz, c.w * cover)
far_sea_fs = (i: FarSeaOut, u: SeaParams) -> vec4: far_sea_at(i, u, false)
far_sea_storm_fs = (i: FarSeaOut, u: SeaParams) -> vec4: far_sea_at(i, u, true)


# rings around the camera: fine near it, coarse far out
build_sea_mesh = () -> Mesh:
    global sea_near_mesh
    close_idx: u32[]
    vs: SeaVertex[]
    idx: u32[]
    seg = 160
    radii: f64[] = [0.0]
    r = 1.5
    loop r < 16000.0:
        radii.push(r)
        r = r * 1.045 + 0.8
    radii.push(16000.0)
    loop k in 0..radii.len():
        loop s in 0..seg:
            a = f64(s) / f64(seg) * TAU
            vs.push(SeaVertex(vec3(f32(cos(a) * radii[k]), 0, f32(sin(a) * radii[k]))))
    loop k in 0..radii.len() - 1:
        loop s in 0..seg:
            a = u32(k * seg + s)
            b = u32(k * seg + (s + 1) % seg)
            c = a + u32(seg)
            d = b + u32(seg)
            if radii[k] < 620.0:
                close_idx.extend([a,b,c,b,d,c])
            else:
                idx.extend([a,b,c,b,d,c])
    sea_near_mesh = mesh(vs,close_idx)
    mesh(vs, idx)

# the map of the sea floor's depth, for the water's color (its image: depth in red, land in blue's
# place as green until coast_shelter turns green into bays' shelter)
build_depth_image = () -> Image:
    n = DEPTH_MAP
    rows = parallel_map([0..n), (j: int) -> f64[]:
        z = (f64(j) + 0.5) / f64(n) * DEPTH_EXTENT - DEPTH_EXTENT * 0.5
        [loop i in 0..n: height((f64(i) + 0.5) / f64(n) * DEPTH_EXTENT - DEPTH_EXTENT * 0.5, z)]
    )
    img = image(n, n)
    loop j in 0..n:
        loop i in 0..n:
            h = rows[j][i]
            d = clamp(-h / 60.0, 0.0, 1.0)
            img.set(i, j, vec4(f32(d), if h > 0.0: 1.0 else: 0.0, 0, 1))
    coast_shelter(img)
    img

# (baked by tools/bake.jo as assets/baked/sea-depth-v1.png, the same RGBA8 bytes, with
# sea-depth-v1.key: the key of the land it was made from, a coarse lattice of its heights. Made
# here when there is no bake or the land is not the one baked. About 0.7 s of a phone's start.)
const DEPTH_MAP_BAKE = "sea-depth-v1"
depth_map_key = () -> u64:
    samples: f64[]
    loop j in 0..64:
        z = (f64(j) + 0.5) / 64.0 * DEPTH_EXTENT - DEPTH_EXTENT * 0.5
        loop i in 0..64: samples.push(height((f64(i) + 0.5) / 64.0 * DEPTH_EXTENT - DEPTH_EXTENT * 0.5, z))
    hash((samples, DEPTH_MAP, DEPTH_EXTENT))
load_depth_image = () -> Image:
    if let png = baked_asset(DEPTH_MAP_BAKE + ".png"):
        if let key = baked_asset(DEPTH_MAP_BAKE + ".key"):
            if str_from_bytes(key) == "{depth_map_key()}":
                loaded = load_png(png)
                if loaded is Image and loaded.width == DEPTH_MAP and loaded.height == DEPTH_MAP: return loaded
    build_depth_image()

build_depth_texture = () -> Texture:
    result = texture(load_depth_image(), true)
    init_expanded_depth(result)
    result

# Reuse completed depth pixels to find bays enclosed on several sides. This
# adds no terrain queries or GPU samples; the otherwise unused green channel
# is published together with depth, never while a near map is half-built.
coast_shelter = (img: mut Image, first: int = 0, rows: int = 1000000):
    loop j in first..min(first+rows,img.height):
        loop i in 0..img.width:
            c = img.get(i,j)
            if c.x > 0.35: continue
            enclosed: f32 = 0.0
            loop d in [vec2(6,0),vec2(-6,0),vec2(0,6),vec2(0,-6)]:
                q = img.get(clamp(i+int(d.x),0,img.width-1),clamp(j+int(d.y),0,img.height-1)).x
                enclosed += 1.0-smoothstep(0.005,0.06,q)
            c.y = smoothstep(0.8,2.7,enclosed)
            img.set(i,j,c)

# A fixed coarse map and one double-buffered near window. Partial rows are
# never published. The 23.4375 m near sampling matches the original depth map.
const NEAR_DEPTH_N = 256
const NEAR_DEPTH_EXTENT = 6000.0
const NEAR_DEPTH_ROWS = 2
const NEAR_SHELTER_ROWS = 16
expanded_depth: Texture
nearby_depth: Texture
nearby_spare: Texture
nearby_area = vec4(0,0,6000,0)
nearby_pending = vec2(0,0)
nearby_row = -1
nearby_shelter_row = 0
nearby_image: Image

init_expanded_depth = (fallback: Texture):
    global expanded_depth, nearby_depth, nearby_spare, nearby_image
    expanded_depth = fallback; nearby_depth = fallback; nearby_spare = fallback
    if not geography_enabled: return
    img = image(500,400)
    loop j in 0..400:
        loop i in 0..500:
            h = new_land_base((f64(i)+0.5)*1000.0-250000.0,(f64(j)+0.5)*1000.0-200000.0).0
            img.set(i,j,vec4(f32(clamp(-h/60.0,0.0,1.0)),0,0,1))
    expanded_depth = texture(img,true)
    nearby_image = image(NEAR_DEPTH_N,NEAR_DEPTH_N)
    nearby_depth = texture(nearby_image,true)
    nearby_spare = texture(nearby_image,true)

update_nearby_depth = ():
    global nearby_depth,nearby_spare,nearby_area,nearby_pending,nearby_row,nearby_shelter_row,nearby_image
    if not geography_enabled: return
    cam = scene_camera().xz
    if abs(cam.x) < 14000.0 and abs(cam.y) < 14000.0: return
    if nearby_row < 0:
        if nearby_area.w > 0.5 and length(cam-nearby_area.xy) < 750.0: return
        # Nearest centre keeps a stationary camera within 531 m. Flooring
        # could leave it >750 m away and rebuild the same map every 32 frames.
        nearby_pending = floor(cam/750.0+vec2(0.5,0.5))*750.0
        nearby_row = 0
        nearby_shelter_row = 0
    zone("world depth")
    loop j in nearby_row..min(nearby_row+NEAR_DEPTH_ROWS,NEAR_DEPTH_N):
        z = f64(nearby_pending.y)+(f64(j)+0.5)/f64(NEAR_DEPTH_N)*NEAR_DEPTH_EXTENT-NEAR_DEPTH_EXTENT*0.5
        loop i in 0..NEAR_DEPTH_N:
            x = f64(nearby_pending.x)+(f64(i)+0.5)/f64(NEAR_DEPTH_N)*NEAR_DEPTH_EXTENT-NEAR_DEPTH_EXTENT*0.5
            h = new_land_depth_height(x,z)
            nearby_image.set(i,j,vec4(f32(clamp(-h/60.0,0.0,1.0)),0,0,1))
    if nearby_row < NEAR_DEPTH_N:
        nearby_row += NEAR_DEPTH_ROWS
    else:
        # Shelter reads only completed red/depth pixels and writes green, so
        # it can be sliced without changing the result or exposing partial data.
        coast_shelter(nearby_image,nearby_shelter_row,NEAR_SHELTER_ROWS)
        nearby_shelter_row += NEAR_SHELTER_ROWS
    if nearby_shelter_row >= NEAR_DEPTH_N:
        update_texture(nearby_spare,nearby_image)
        old = nearby_depth; nearby_depth = nearby_spare; nearby_spare = old
        nearby_area = vec4(nearby_pending.x,nearby_pending.y,f32(NEAR_DEPTH_EXTENT),1)
        nearby_row = -1
    zone_end()

# a flat part's shadow on the sea: the four corners of a box's middle (local center c, half size h)
# placed by model, carried along the sunlight down to sea level
struct SeaShadows:
    quads: vec4[32]
    alpha: vec4[4]
    n = 0
    origin = vec3(0,0,0)

add_sea_shadow = (sh: mut SeaShadows, model: mat4, c: vec3, h: vec3, sun: vec3, alpha: f64):
    if sh.n >= 16: return
    s = normalize(sun)
    if s.y < 0.08: return
    if sh.n == 0: sh.origin = render_origin(scene_camera())
    local_model = render_model(model,sh.origin)
    corners = [vec3(-1, 0, -1), vec3(1, 0, -1), vec3(1, 0, 1), vec3(-1, 0, 1)]
    pts: vec2[]
    loop k in corners:
        w = transform_point(local_model, c + k * h)
        t = w.y / s.y
        pts.push(vec2(w.x - s.x * t, w.z - s.z * t))
    sh.quads[sh.n * 2] = vec4(pts[0].x, pts[0].y, pts[1].x, pts[1].y)
    sh.quads[sh.n * 2 + 1] = vec4(pts[2].x, pts[2].y, pts[3].x, pts[3].y)
    i = sh.n / 4
    a = f32(alpha)
    match sh.n % 4:
        0: sh.alpha[i].x = a
        1: sh.alpha[i].y = a
        2: sh.alpha[i].z = a
        _: sh.alpha[i].w = a
    sh.n += 1

# how rough the sea is for its wind (the pause menu's Sea: 0 glassy, 1 as the wind makes it, 3 heavy):
# the swells' height (which the aircraft and the boats ride too) and the whitecaps alike
sea_rough = 1.0

set_sea_rough = (r: f64):
    global sea_rough
    sea_rough = max(r, 0.0)

_swell_amp = (w: Wind) -> f64: (0.003 + 0.0011 * w.speed) * sea_rough * smoothstep(0.05,2.0,w.speed)

# The sea for its wind and weather: how stormy (0 an ordinary sea .. 1 a full gale), the swell
# bands' lengths and shares, and the crests' sharpness. Shared by the drawn sea (sea_phases) and
# the physics (swell_at), so what is seen is what the floats ride.
#
# An ordinary sea's waves are as long as its wind makes them: a Pierson-Moskowitz spectrum peaks at
# about 0.83 U^2 m (30 m at 6 m/s) and has little in waves much longer, so the long, fast bands are
# only a low residual swell and the shorter, slower waves carry the near sea's look. A storm (a
# strong wind, or under a thunderstorm) is a different sea: the bands stretch to waves 150 m long,
# steeper, with peaked crests and long flat troughs.
SEA_LENGTHS = [61.0,37.0,23.0,13.0,7.3,4.1]
SEA_TURNS = [0.0,0.45,-0.5,0.9,-0.25,0.2]
# Each band's share inside a harbour (sea_band_keep; sea_swell passes the same numbers): with a few
# hundred metres of fetch at most, a wind raises waves a metre or three long and centimetres high
# (JONSWAP: at 9 m/s over 1 km, 2.6 m long and 0.15 m high), so the four long bands are gone (the
# 13 m one kept 3% until 2026-11-22, running through the basin unreflected) and the short ones lap
# low against the quay.
SEA_HARBOUR_GAINS: f32[6] = [0.0,0.0,0.0,0.0,0.22,0.6]

# The harbour whose shelter the sea has now: the one nearest the eye (harbour_shelter.jo sets it
# each frame; none: outer 0). Inside `inner` metres of its middle the water is a harbour's (calm
# 1); by `outer` it is the open sea again. One at a time is enough: harbours lie kilometres
# apart, and only the water near the eye is seen or ridden closely.
struct SeaHarbour:
    x = 0.0
    z = 0.0
    inner = 0.0
    outer = 0.0
sea_harbour = SeaHarbour()
set_sea_harbour = (h: SeaHarbour):
    global sea_harbour
    sea_harbour = h
# (on the CPU) the harbour's shelter at a point, as the shader's sea_calm
sea_calm_at = (x: f64, z: f64) -> f32:
    if sea_harbour.outer <= 0.0: return 0.0
    dx = x-sea_harbour.x; dz = z-sea_harbour.z
    f32(1.0-smoothstep(sea_harbour.inner,sea_harbour.outer,sqrt(dx*dx+dz*dz)))
struct SeaState:
    storm: f64 = 0.0
    stretch: f64 = 1.0
    peak: f64 = 0.0          # the crests' peaking: a second harmonic's share (sea_wave_profile)
    amp: f64 = 0.0
    lengths: f64[6]
    gains: f64[6]
    height: f64 = 0.0        # every band's height together (m): the crests' measure, and a bound
    reach: f64 = 2440.0      # beyond this the swells are flat (each band fades out by 40 lengths)
sea_storm_of = (w: Wind) -> f64:
    under = if weather_active: f64(weather_here.storm) else: 0.0
    clamp(max(smoothstep(13.0,22.0,w.speed*sea_rough),under*smoothstep(5.0,11.0,w.speed)),0.0,1.0)
sea_state = (w: Wind) -> SeaState:
    st = SeaState()
    st.storm = sea_storm_of(w)
    st.stretch = 1.0+1.4*st.storm
    st.peak = 0.35*st.storm
    st.amp = _swell_amp(w)*(1.0+0.5*st.storm)
    u = max(w.speed*sea_rough,0.5)
    peak = max(14.0,0.83*u*u)
    st.height = 0.0
    loop k in 0..6:
        len = SEA_LENGTHS[k]*st.stretch
        st.lengths[k] = len
        # (a residual long swell stays, a fifth as steep)
        g = max(0.2,exp(-0.625*(len/peak)*(len/peak)))
        st.gains[k] = g
        st.height += len*st.amp*g
    st.reach = st.lengths[0]*40.0
    st
sea_state_now: SeaState = sea_state(Wind())
# (the state for the wind blowing now, kept until the wind or the weather changes: swell_at is
# called many times a frame)
_state_key = vec4(-1,-1,-1,-1)
_state_kept: SeaState = sea_state(Wind())
sea_state_of_now = () -> SeaState:
    global _state_key, _state_kept
    under = if weather_active: weather_here.storm else: 0.0
    key = vec4(wind_now.dir.x, wind_now.dir.y, f32(wind_now.speed*sea_rough), f32(under))
    if key != _state_key:
        _state_key = key
        _state_kept = sea_state(wind_now)
    _state_kept
# A storm sea's sky (after weather_light): heavy overcast and low grey light whenever the sea is
# stormy, whatever the weather's own cover, and air thick with spray and rain, so the sea greys
# out past a few hundred metres but stays readable near; a thunderstorm's own cell fog is held to
# the same, so its sea is not lost. Above the weather (the deck, about 1.5 km) the light clears.
sea_storm_light = (L: Light, eye_y: f64) -> Light:
    k = sea_state_of_now().storm*(1.0-smoothstep(1200.0,2400.0,eye_y))
    if k <= 0.0: return L
    c = f32(smoothstep(0.0,1.0,k))
    out = L
    day = smoothstep(-0.12,0.35,L.sun_dir.y)
    glow = (1.0-smoothstep(0.05,0.55,L.sun_dir.y))*smoothstep(-0.2,0.0,L.sun_dir.y)
    day = max(day,glow*0.6)
    grey_sun = mix(vec3(0.08,0.10,0.15),vec3(0.52,0.56,0.60),day)
    grey_shade = mix(vec3(0.025,0.035,0.06),vec3(0.22,0.27,0.31),day)
    grey_air = mix(vec3(0.03,0.045,0.07),vec3(0.42,0.48,0.52),day)
    out.sun = mix(L.sun,grey_sun,c*0.9)
    out.shade = mix(L.shade,grey_shade,c*0.9)
    out.sky_top = mix(L.sky_top,grey_air*0.72,c*0.92)
    out.sky_horizon = mix(L.sky_horizon,grey_air,c*0.92)
    out.haze = mix(L.haze,grey_air*0.9,c*0.85)
    out.fog_density = mix(L.fog_density,clamp(L.fog_density,0.0016,0.0022),f64(c))
    out.afterglow.x *= 1.0-c*0.8
    out

# (the drawn sea's uniforms for a sea state)
sea_set_state = (p: mut SeaParams, st: SeaState):
    p.swell_gain[0] = vec4(f32(st.gains[0]),f32(st.gains[1]),f32(st.gains[2]),f32(st.gains[3]))
    p.swell_gain[1] = vec4(f32(st.gains[4]),f32(st.gains[5]),f32(1.0/st.stretch),0)
    p.sea_storm = vec4(f32(st.storm),f32(st.peak),f32(st.reach),f32(st.height))
# The crests' profile, as the shader draws it: sin for an ordinary sea; for a storm's, peaked.
sea_wave_profile = (phase: f64,peak: f64) -> vec2:
    sn = sin(phase); cs = cos(phase)
    vec2(f32(sn+peak*(2.0*sn*sn-1.0)),f32(cs*(1.0+4.0*peak*sn)))

sea_params = (depth: Texture, L: Light, t: f64, w: Wind, cam_vel: vec3, shadows: SeaShadows) -> SeaParams:
    global sea_state_now
    sea_state_now = sea_state(w)
    swell = sea_state_now.amp                   # (the swells' height for their length)
    ws = w.speed * sea_rough                    # (the wind as the sea's face shows it)
    cam = scene_camera()
    center = render_origin(cam).xz
    residual = vec2(f32(f64(cam.x) - f64(center.x)), f32(f64(cam.z) - f64(center.y)))
    p = SeaParams(scene_view_proj(), scene_camera(), L.sun_dir, L.sun, L.sky_top, L.sky_horizon, L.haze,
        L.sea_deep, L.sea_shallow, f32(L.fog_density), f32(t), f32(ws / 12.0), vec4(w.dir.x, w.dir.y, f32(ws), f32(swell)), w.drift, rush_of(cam_vel), shadows.quads, shadows.alpha, f32(shadows.n), depth, expanded_depth, nearby_depth, nearby_area, if geography_enabled: 1.0 else: 0.0, render_rays(scene_view_proj()), center, residual, scene_flow, scene_warp_a, scene_warp_b)
    p.haze_tangent = L.haze
    p.origin = render_origin(p.cam)
    p.view_proj = render_view_proj(p.origin)
    p.cam = render_eye(p.origin)
    p.warp_a = render_anchor(p.warp_a,p.origin)
    p.cloud_shadow = cloud_shadow_map(); p.cloud_area = cloud_shadow_area(p.origin,"sea"); p.cloud_slope = cloud_shadow_slope()
    offset = shadows.origin-p.origin
    loop k in 0..shadows.n*2: p.shade[k] += vec4(offset.x,offset.z,offset.x,offset.z)
    sea_phases(p,t)
    sea_set_state(p,sea_state_now)
    if sea_harbour.outer > 0.0:
        p.harbour = vec4(f32(sea_harbour.x-f64(p.origin.x)),f32(sea_harbour.z-f64(p.origin.z)),f32(sea_harbour.inner),f32(sea_harbour.outer))
    p.far_z = far_depth()
    # (the screen's focal length in pixels: the glints keep their size in pixels)
    vp = scene_view_proj()
    p.glint_pixel = 1.0/max(length(vec3(vp[0].y,vp[1].y,vp[2].y))*f32(screen_height())*0.5,1.0)
    lo = vec2(1e20,1e20); hi = vec2(-1e20,-1e20)
    loop k in 0..shadows.n*2:
        q = p.shade[k]
        lo = min(lo,min(q.xy,q.zw)); hi = max(hi,max(q.xy,q.zw))
    p.shade_bounds = vec4(lo.x,lo.y,hi.x,hi.y)
    # Offset edge half-planes can extend farther than aa at acute corners.
    # A parallelogram's corner displacement is bounded by 2*aa/sin(angle).
    loop k in 0..shadows.n:
        ab = shadows.quads[k*2].zw-shadows.quads[k*2].xy
        bc = shadows.quads[k*2+1].xy-shadows.quads[k*2].zw
        p.shade_pad = max(p.shade_pad,2.0*length(ab)*length(bc)/max(abs(ab.x*bc.y-ab.y*bc.x),0.000001))
    p.rain = if weather_active: weather_here.rain else: 0.0
    p.surf = surf_uniform()
    # (the low tier keeps the ships' bow spray but not the lace along their hulls)
    if tweaks.surf and render_quality.tier > 0:
        p.surf.w = f32(surf_ship_uniforms(p.origin,p.cam,p.surf_ships))
        p.surf_box = surf_ship_box(p.surf_ships,int(p.surf.w))
    p.surf.z = if render_quality.tier == 0: 1.0 else: 0.0
    p.coast_near = if coast_height_valid: coast_height_near.texture else: depth
    p.coast_far = if coast_height_valid: coast_height_far.texture else: depth
    p.coast_near_area = if coast_height_valid: coast_height_near_area else: vec4(0,0,0,0)
    p.coast_far_area = coast_height_far_area
    p.coast_roll = coast_height_roll
    # Use the same curved horizon and painted disc edge as the sky. Twilight's
    # diffuse water colour can still follow the glow after the actual disc sets.
    h = max(f64(cam.y),0.0)
    dip = acos(EARTH_RADIUS/(EARTH_RADIUS+h))
    sun = normalize(L.sun_dir); moon = normalize(L.moon_dir)
    p.specular_sun = vec4(sun,sea_disc_fraction(sun.y,dip))
    # A lit daytime Moon can catch a facet too, faint against the sunlit water.
    # (its track brightens as the Moon comes out as a light, from about sunset: celestial.jo moon_glow)
    lunar_contrast = mix(0.025,1.0,moon_glow(f64(sun.y)))
    p.moon = vec4(moon,f32(0.62*moon_illumination(sun,moon)*lunar_contrast)*sea_disc_fraction(moon.y,dip)*L.glare)
    # (the light that reaches the sea through the day's air: in dust and haze the glints dimmer and
    # unclipped, so they glitter in the low sun's own orange; exactly 14 in clear air)
    p.glint_gain = 14.0*L.glare
    p.glint_sun = if L.glint_sun.x >= 0.0: L.glint_sun else: L.sun
    p.glint_facets = sea_facet_tile
    if L.afterglow.x > 0.0 and glow_sea_share(L) > 0.0:
        g = glow_sea_sun(L)
        keep = (mix(L.sun,vec3(1,1,1),0.45)*0.7)/(mix(g.1,vec3(1,1,1),0.45)*0.76)
        p.sun_dir = g.0; p.sun = g.1
        p.glint_sun = mix(p.glint_sun, L.glow_sea * L.afterglow.x, glow_sea_share(L))
        p.deep = p.deep*keep; p.shallow = p.shallow*keep
    p

# Area of a circular segment. Evaluate once per draw; the last sliver
# vanishes exactly where the outer edge of the sky disc touches the horizon.
sea_disc_fraction = (height: f32,dip: f64) -> f32:
    radius = acos(f64(SKY_DISC_OUTER))
    y = (asin(clamp(f64(height),-1.0,1.0))+dip)/radius
    if y>=1.0: return 1.0
    if y<= -1.0: return 0.0
    f32((acos(-y)+y*sqrt(1.0-y*y))/PI)

sea_phases = (p: mut SeaParams,t: f64):
    turns = [0.0,0.45,-0.5,0.9,-0.25,0.2,0.3,-0.35,0.75,-0.8,0.05]
    lengths = [61.0,37.0,23.0,13.0,7.3,4.1,3.1,2.3,1.6,1.15,0.8]
    loop k in 0..11:
        a = turns[k]
        wl = if k < 6: sea_state_now.lengths[k] else: lengths[k]
        frequency = TAU/wl
        dx = f64(p.wind.x)*cos(a)-f64(p.wind.y)*sin(a)
        dz = f64(p.wind.x)*sin(a)+f64(p.wind.y)*cos(a)
        wave = vec2(f32(dx*frequency),f32(dz*frequency))
        turn = t*sqrt(9.8*frequency)*(if k < 6: 1.0 else: 1.1)
        phase = f64(wave.x)*f64(p.origin.x)+f64(wave.y)*f64(p.origin.z)-turn+(if k < 6: 0.0 else: f64(k-6)*1.7)
        band = vec4(wave,render_phase(phase,TAU),f32(wl))
        # (its reflection's phase is this one's plus twice the time's turn: sea_band_travel)
        back = render_phase(2.0*turn,TAU)
        bc = cos(back); bs = sin(back)
        j = if k < 6: k else: k-6
        v = if k < 6: p.swell_back[j/2] else: p.ripple_back[j/2]
        if j%2 == 0: v.x = bc; v.y = bs
        else: v.z = bc; v.w = bs
        if k < 6: p.swell_phase[k] = band; p.swell_back[j/2] = v
        else: p.ripple_phase[k-6] = band; p.ripple_back[j/2] = v
    sizes: f32[3] = [1.3,3.6,10.0]
    loop k in 0..3: p.mark_phase[k] = sea_cell_anchor(p.origin.xz,f64(sizes[k]))
    p.glint_phase = sea_cell_anchor(p.origin.xz,f64(f32(0.3)))

# Coarser glint cells are powers of two of the finest lattice. Integer quotient
# and remainder stay exact within this world's bounds; only the fractional cell
# is rounded. Avoid a varying-index uniform-array fetch for every sea fragment.
sea_glint_anchor = (base: vec4,divisor: f32) -> vec4:
    cell = floor(base.zw/divisor)
    fraction = (base.zw-cell*divisor+base.xy)/divisor
    vec4(fraction,cell)

sea_cell_anchor = (origin: vec2,size: f64) -> vec4:
    x = f64(origin.x)/size; z = f64(origin.y)/size
    vec4(f32(x-floor(x)),f32(z-floor(z)),f32(floor(x)),f32(floor(z)))

draw_sea = (m: Mesh, depth: Texture, L: Light, t: f64, w: Wind, cam_vel: vec3 = vec3(0, 0, 0), shadows: SeaShadows = SeaShadows()):
    update_nearby_depth()
    refresh_coast_height(scene_camera())
    p = sea_params(depth, L, t, w, cam_vel, shadows)
    sea_from_height(p, L)
    # One material/pass: deep alpha is 1; the shallow alpha composites against
    # the already-drawn seabed. Both record the water endpoint for later wakes,
    # particles and geometry. Existing nearer clouds fail the depth test here.
    zone("sea surface")
    if water_depth.id != 0:
        p.opaque_depth = water_depth; p.reject_depth = 1
        when TARGET == "macos":
            if not __vk and not __soft: p.reject_depth = 2
    depth_write(true)
    cull(.back)
    plain = sea_sh; coast = coast_sea_sh
    # (a storm's sea has its own programs; else Surf's, made the first time it is on)
    if p.sea_storm.x > 0.0:
        sea_storm_shaders()
        p.storm_noise = sea_storm_noise
        plain = sea_storm_sh; coast = coast_sea_storm_sh
    else if tweaks.surf and surf_needed(scene_camera(),p.surf.w > 0.5):
        sea_surf_shaders()
        plain = sea_surf_sh; coast = coast_sea_surf_sh
    draw(plain, m, p)
    draw(if coast_height_valid: coast else: plain,sea_near_mesh,p)
    cull(.none)
    depth_write(false)
    zone_end()

draw_far_sea = (depth: Texture, L: Light, t: f64, w: Wind):
    p = sea_params(depth, L, t, w, vec3(0, 0, 0), SeaShadows())
    sea_from_height(p, L)
    zone("sea horizon")
    depth_write(false)
    if p.sea_storm.x > 0.0:
        sea_storm_shaders()
        p.storm_noise = sea_storm_noise
        draw(far_sea_storm_sh, far_sea_tri, p)
    else: draw(far_sea_sh, far_sea_tri, p)
    depth_write(true)
    zone_end()

# how strongly the sea streaks past for a camera moving at vel (fast and low)
rush_of = (vel: vec3,water_level:f64=0.0) -> vec4:
    sp = f64(length(vec3(vel.x, 0, vel.z)))
    hgt = f64(scene_camera().y)-water_level
    k = smoothstep(15.0, 60.0, sp) * (1.0 - smoothstep(30.0, 260.0, hgt))
    vec4(vel.x, vel.y, vel.z, f32(k))

# (the GPU programs: made once the window is open)
init_sea = ():
    global sea_facet_tile
    sea_facet_tile = texture(sea_facet_image(),true)
    set_repeat(sea_facet_tile,true)
    set_mipmaps(sea_facet_tile,true)
    global sea_sh, far_sea_sh, far_sea_tri,coast_sea_sh
    far_sea_sh = make_shader(shader(far_sea_vs, far_sea_fs))
    far_sea_tri = mesh([FarSeaVertex(vec2(-1, -1)), FarSeaVertex(vec2(3, -1)), FarSeaVertex(vec2(-1, 3))])
    # Both optical-only and refined shore materials keep native hardware early Z;
    # WebGL's full-depth variants share the immutable opaque-depth rejection.
    sea_sh = make_shader(if world_logarithmic:shader(sea_depth_vs,sea_depth_fs) else:shader(sea_vs,sea_fs))
    coast_sea_sh = make_shader(if world_logarithmic:shader(sea_depth_vs,coast_sea_depth_fs) else:shader(sea_vs,coast_sea_fs))

# The water's depth for the swell's bands (swell_at, m): the sea floor on a 16 m lattice, each
# point worked out the first time it is asked for and kept, read bilinearly between them (the
# drawn sea reads its depth map the same way, 23 m a texel). The land's height itself costs
# several microseconds and swell_at is called hundreds of times a frame, mostly round the same
# few places. The same answer whatever is kept, so nothing depends on what was asked before.
const SWELL_DEPTH_CELL = 16.0
_swell_depths: {int: f32} = {}
_swell_depths_world = false
_swell_depth_corner = (i: int, j: int) -> f32:
    global _swell_depths
    key = (i+1048576)*2097152+j+1048576
    if key in _swell_depths: return _swell_depths[key]
    if _swell_depths.len() > 40000: _swell_depths = {}
    d = f32(max(-surface_height(f64(i)*SWELL_DEPTH_CELL,f64(j)*SWELL_DEPTH_CELL),0.0))
    _swell_depths[key] = d
    d
swell_depth = (x: f64, z: f64) -> f32:
    global _swell_depths, _swell_depths_world
    # (another world's land: tests load one after another)
    if _swell_depths_world != geography_enabled: _swell_depths = {}; _swell_depths_world = geography_enabled
    u = x/SWELL_DEPTH_CELL; v = z/SWELL_DEPTH_CELL
    i = int(floor(u)); j = int(floor(v))
    fu = f32(u-f64(i)); fv = f32(v-f64(j))
    mix(mix(_swell_depth_corner(i,j),_swell_depth_corner(i+1,j),fu),mix(_swell_depth_corner(i,j+1),_swell_depth_corner(i+1,j+1),fu),fv)

# the sea's surface where the eye sees it (the same swells the sea is drawn with): height and slope
swell_at = (x: f64, z: f64, t: f64) -> vec3:
    if geography_enabled:
        river=water_at(x,z)
        if river.wet and (river.kind==.lake or river.level>0.001): return vec3(f32(river.level),river.slope.x,river.slope.y)
    # No SeaParams/texture work in physics contacts. Match the uploaded wave
    # vectors, then perform the full spatial/time dot in double precision.
    st = sea_state_of_now()
    # (each band where the water is deep enough for it, and little of any inside a harbour:
    # sea_band_keep, as the drawn sea)
    depth = swell_depth(x,z); calm = sea_calm_at(x,z)
    result = vec3(0,0,0)
    loop k in 0..6:
        len = st.lengths[k]
        keep = sea_band_keep(f32(len),depth,calm,SEA_HARBOUR_GAINS[k])
        if keep <= 0.0: continue
        a = SEA_TURNS[k]; frequency = TAU/len
        dx = f64(wind_now.dir.x)*cos(a)-f64(wind_now.dir.y)*sin(a)
        dz = f64(wind_now.dir.x)*sin(a)+f64(wind_now.dir.y)*cos(a)
        wave = vec2(f32(dx*frequency),f32(dz*frequency))
        turn = t*sqrt(9.8*frequency)
        phase = f64(wave.x)*x+f64(wave.y)*z-turn
        h = len*st.amp*st.gains[k]*f64(keep)
        f = sea_wave_profile(phase,st.peak)
        # (near a shore part of it stands: the forward wave's share and its reflection, which runs
        # back the other way, sea_band_travel)
        q = if k >= SEA_TRAVEL_BANDS: f64(sea_band_travel(f32(len),depth,calm)*sea_shore_still(depth)) else: 1.0
        if q < 1.0:
            back = phase+2.0*turn
            f = vec2(f32(f64(f.x)*(0.5+0.5*q)+sin(back)*(0.5-0.5*q)),f32(f64(f.y)*(0.5+0.5*q)+cos(back)*(0.5-0.5*q)))
        result += vec3(f32(h*f64(f.x)),f32(h*f64(f.y)*f64(wave.x)),f32(h*f64(f.y)*f64(wave.y)))
    # (a storm's seas lose their height over shallow water, as the drawn sea's: sea_shoal)
    if st.storm > 0.0: result = result*sea_shoal(depth,f32(st.storm),f32(st.height))
    result

# The sea's short chop at a point, 0..1 (flight.jo env.chop: what a planing float strikes, in hops
# and slams): from a gentle breeze to a fresh one as the sea's face shows it (the Sea setting
# too), and a sixth of it in a harbour's basin, where no sea has the fetch to grow; none on inland water.
sea_chop_at = (x: f64, z: f64) -> f64:
    # (none on a river, a lake or a canal's water: no fetch, and their own surface)
    if geography_enabled and water_at(x,z).wet: return 0.0
    smoothstep(2.0, 12.0, wind_now.speed*sea_rough)*(1.0-0.85*f64(sea_calm_at(x,z)))

# The six wavelengths sum to 145.4; every sine and fade is bounded by one.
# Pad the f32 amplitude/sum so this is conservative even at a crest.
swell_height_bound = () -> f64: sea_state_of_now().height*(1.0+sea_state_of_now().peak)*1.001+0.001

# a thing afloat at p riding the swell: lifted, and tilted with the water's slope
afloat = (p: vec3, t: f64) -> mat4:
    s = swell_at(f64(p.x), f64(p.z), t)
    translation(vec3(0, s.x, 0)) * translation(p) * rotation_x(f64(clamp(s.z, -0.3, 0.3)) * 0.6) * rotation_z(f64(clamp(-s.y, -0.3, 0.3)) * 0.6) * translation(-p)

# Compose buoyancy about the model's local root, never T(p)*R*T(-p)*T(p).
# The latter cancels two country-sized f32 translations on the CPU; keeping
# the pivot local avoids depending on that cancellation as the tilt changes.
afloat_transform = (at: mat4,t: f64) -> mat4:
    p=at[3].xyz
    s=swell_at(f64(p.x),f64(p.z),t)
    local=at;local[3]=vec4(0,0,0,1)
    tilt=rotation_x(f64(clamp(s.z,-0.3,0.3))*0.6)*rotation_z(f64(clamp(-s.y,-0.3,0.3))*0.6)
    result=tilt*local
    result[3]=vec4(p+vec3(0,s.x,0),1)
    result
