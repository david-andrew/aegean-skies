use 'combat.jo'
use 'airsound.jo'

struct CombatAudio:
    guns: Sound[]
    hit: Sound = Sound([])
    open: Sound = Sound([])
    thump: Sound = Sound([])
    whizz: Sound = Sound([])
    splash: Sound = Sound([])
    fire_sound: Sound = Sound([])
    wind_sound: Sound = Sound([])
    fire = -1
    wind = -1

# Broadband reports: a short crack over a low, wide body thump, never a pitched oscillator.
# Eight fixed noise realizations per family keep playback cheap; choice is cosmetic randomness.
const GUN_VARIANTS = 8

gun_report = (kind: int, variant: int) -> Sound:
    r=rng(1931+kind*101+variant*7919)
    seconds=0.16+f64(kind)*0.045
    n=int(seconds*f64(MIX_RATE));samples=fill(f32(0),n*2)
    body=Biquad();crack=Biquad();air=Biquad()
    variation=0.94+r.next_float()*0.12
    bandpass(body,(if kind==0:180.0 else:if kind==1:125.0 else:85.0)*variation,0.65)
    lowpass(crack,(if kind==0:8500.0 else:if kind==1:6500.0 else:4800.0)*variation)
    highpass(air,950.0)
    peak=0.0
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE)
        noise=r.next_float()*2.0-1.0
        sharp=filt(air,filt(crack,noise))
        thump=filt(body,noise)
        attack=min(1.0,t/0.00018)
        tail=min(1.0,(seconds-t)/0.012)
        value=(sharp*exp(-t*(180.0-f64(kind)*32.0))*0.85+thump*exp(-t*(42.0-f64(kind)*9.0))*3.8)*attack*tail
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
        peak=max(peak,abs(value))
    gain=(0.78+r.next_float()*0.12)/max(peak,0.001)
    loop i in 0..samples.len():samples[i]*=f32(gain)
    Sound(samples)

combat_wave = (kind: int) -> Sound:
    if kind<3:return gun_report(kind,0)
    seconds = if kind==7 or kind==8: 0.28 else: if kind>=5: 2.0 else: if kind==4: 0.5 else: 0.18
    n=int(seconds*f64(MIX_RATE));samples=fill(f32(0),n*2)
    lp=0.0
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE)
        noise=sin(f64(i*7919%65521)*1.781)*sin(f64(i*1237%65519)*0.712)
        lp+=(noise-lp)*(if kind==6: 0.06 else: 0.28)
        value=0.0
        if kind==3:value=(noise*0.6+sin(t*TAU*260)*0.2)*exp(-t*45)
        else if kind==4:value=lp*sin(PI*t/seconds)*0.65
        else if kind==5:value=lp*(0.3+0.15*sin(t*TAU*3))+noise*pow(max(0.0,sin(t*TAU*17)),18.0)*0.2
        else if kind==7:value=(sin(TAU*(75*t-50*t*t))*0.6+lp*0.4)*exp(-t*19)
        else if kind==8:value=(lp*0.5+sin(TAU*(2200*t-2400*t*t))*0.15)*pow(sin(PI*t/seconds),3.0)
        else:value=lp*(0.45+0.1*sin(t*TAU*2))
        # Smooth noise-loop seams without affecting their full-level middle.
        if kind==5 or kind==6:value*=min(1.0,min(t,seconds-t)*40.0)
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
    Sound(samples)

# the fire's roar and the wind past a falling man: real noise (not a repeating pattern, which rang),
# made into seamless loops (no dip at the seam)
_noise_loop = (kind: int) -> Sound:
    seed_random(41 + kind)
    fade = MIX_RATE / 4
    n = 2 * MIX_RATE + fade
    m = fill(0.0, n)
    lp = 0.0
    lp2 = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        x = random(-1.0, 1.0)
        if kind == 5:
            # (a fire: a low roar that heaves, with crackles)
            lp += (x - lp) * 0.28
            crack = if random() < 0.0015: random(-1.0, 1.0) * 0.8 else: 0.0
            m[i] = lp * (0.3 + 0.12 * sin(t * TAU * 3.0)) + crack
        else:
            # (the wind: a soft, deep rush, gusting a little)
            lp += (x - lp) * 0.06
            lp2 += (lp - lp2) * 0.2
            m[i] = lp2 * (0.8 + 0.2 * sin(t * TAU * 0.5))
    seamless(m, fade, if kind == 5: 0.12 else: 0.1)

# Sky Barons' two very short broadband cracks. Listener-relative playback is intentional:
# the pilot hears a close pass even when the chase camera is fifty metres behind him.
near_miss_report = () -> Sound:
    mix([tone(2600.0,0.05,.noise,0.6,0.0005,0.04,0.3),tone(900.0,0.04,.noise,0.3,0.0005,0.03,0.4)])

water_report = () -> Sound:
    mix([tone(650.0,0.13,.noise,0.5,0.001,0.10,0.1),tone(140.0,0.09,.noise,0.45,0.001,0.07,0.2)])

start_combat_audio = () -> CombatAudio:
    a=CombatAudio(guns=[loop i in 0..3*GUN_VARIANTS:gun_report(i/GUN_VARIANTS,i%GUN_VARIANTS)],hit=combat_wave(3),open=combat_wave(4),fire_sound=_noise_loop(5),wind_sound=_noise_loop(6),thump=combat_wave(7),whizz=near_miss_report(),splash=water_report())
    a.fire=play(a.fire_sound,0,looping=true);a.wind=play(a.wind_sound,0,looping=true)
    a

combat_audio_events = (a: CombatAudio,events: CombatEvent[],ear: vec3,player:int = -1):
    count=0
    loop event in events:
        if event.kind==.hit and event.craft==player:
            play(a.hit,0.45);play(a.thump,0.65);continue
        if count>=8 or length(event.position-ear)>2500:continue
        match event.kind:
            .shot:play_at(a.guns[clamp(int(event.strength),0,2)*GUN_VARIANTS+random_int(0,GUN_VARIANTS)],event.position,0.28,180.0)
            .hit, .separated:play_at(a.hit,event.position,0.4,110.0)
            .splash:
                distance=f64(length(event.position-ear))
                if distance<100:play(a.splash,0.5*(1.0-distance/100.0),pitch=random(0.9,1.1))
            .bailed:play_at(a.open,event.position,0.35,80.0)
            _:continue
        count+=1

update_combat_audio = (a: CombatAudio,b: Battle,ear: vec3,person: int):
    fire=0.0;wind=0.0
    loop actor in b.actors:fire=max(fire,actor.fire/(1.0+f64(length(actor.state.position-ear))/40.0))
    loop d in b.descents:
        if d.person==person and (d.phase==.falling or d.phase==.canopy):wind=if d.phase==.canopy: 0.4 else: 0.7
    set_volume(a.fire,fire*0.35);set_volume(a.wind,wind)

hush_combat_audio = (a: CombatAudio):
    if a.fire>=0:set_volume(a.fire,0)
    if a.wind>=0:set_volume(a.wind,0)

# A short Doppler-like crack/swish at the swept closest point, once per projectile.
combat_audio_passes = (a:CombatAudio,points:vec3[]):
    loop p in points:play(a.whizz,0.5,pitch=random(0.9,1.1))
