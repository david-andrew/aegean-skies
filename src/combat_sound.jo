use 'combat.jo'
use 'airsound.jo'

# Ground fire, as heard down a canal between two walls of houses (built when a scenario has ground
# guns). Reports: rifle near, rifle far, machine gun near, machine gun far, two variants each.
struct GroundSounds:
    ready = false
    reports: Sound[]
    snaps: Sound[]
    spouts: Sound[]

struct CombatAudio:
    guns: Sound[]
    ground: GroundSounds = GroundSounds()
    hit: Sound = Sound([])
    open: Sound = Sound([])
    thump: Sound = Sound([])
    whizz: Sound = Sound([])
    splash: Sound = Sound([])
    wreck_splash: Sound = Sound([])
    fire_sound: Sound = Sound([])
    wind_sound: Sound = Sound([])
    fire = -1
    wind = -1

# Broadband reports: a short crack over a low, wide body thump, never a pitched oscillator.
# Eight fixed noise realizations per family keep playback cheap; choice is cosmetic randomness.
const GUN_VARIANTS = 8

gun_report = (kind: int, variant: int) -> Sound:
    r=rng(1931+kind*101+variant*7919)
    seconds=0.16+f64(kind)*0.045
    n=int(seconds*f64(MIX_RATE));samples=fill(f32(0),n*2)
    body=Biquad();crack=Biquad();air=Biquad()
    variation=0.94+r.next_float()*0.12
    bandpass(body,(if kind==0:180.0 else:if kind==1:125.0 else:85.0)*variation,0.65)
    lowpass(crack,(if kind==0:8500.0 else:if kind==1:6500.0 else:4800.0)*variation)
    highpass(air,950.0)
    peak=0.0
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE)
        noise=r.next_float()*2.0-1.0
        sharp=filt(air,filt(crack,noise))
        thump=filt(body,noise)
        attack=min(1.0,t/0.00018)
        tail=min(1.0,(seconds-t)/0.012)
        value=(sharp*exp(-t*(180.0-f64(kind)*32.0))*0.85+thump*exp(-t*(42.0-f64(kind)*9.0))*3.8)*attack*tail
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
        peak=max(peak,abs(value))
    gain=(0.78+r.next_float()*0.12)/max(peak,0.001)
    loop i in 0..samples.len():samples[i]*=f32(gain)
    Sound(samples)

combat_wave = (kind: int) -> Sound:
    if kind<3:return gun_report(kind,0)
    seconds = if kind==7 or kind==8: 0.28 else: if kind>=5: 2.0 else: if kind==4: 0.5 else: 0.18
    n=int(seconds*f64(MIX_RATE));samples=fill(f32(0),n*2)
    lp=0.0
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE)
        noise=sin(f64(i*7919%65521)*1.781)*sin(f64(i*1237%65519)*0.712)
        lp+=(noise-lp)*(if kind==6: 0.06 else: 0.28)
        value=0.0
        if kind==3:value=(noise*0.6+sin(t*TAU*260)*0.2)*exp(-t*45)
        else if kind==4:value=lp*sin(PI*t/seconds)*0.65
        else if kind==5:value=lp*(0.3+0.15*sin(t*TAU*3))+noise*pow(max(0.0,sin(t*TAU*17)),18.0)*0.2
        else if kind==7:value=(sin(TAU*(75*t-50*t*t))*0.6+lp*0.4)*exp(-t*19)
        else if kind==8:value=(lp*0.5+sin(TAU*(2200*t-2400*t*t))*0.15)*pow(sin(PI*t/seconds),3.0)
        else:value=lp*(0.45+0.1*sin(t*TAU*2))
        # Smooth noise-loop seams without affecting their full-level middle.
        if kind==5 or kind==6:value*=min(1.0,min(t,seconds-t)*40.0)
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
    Sound(samples)

# the fire's roar and the wind past a falling man: real noise (not a repeating pattern, which rang),
# made into seamless loops (no dip at the seam)
_noise_loop = (kind: int) -> Sound:
    seed_random(41 + kind)
    fade = MIX_RATE / 4
    n = 2 * MIX_RATE + fade
    m = fill(0.0, n)
    lp = 0.0
    lp2 = 0.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        x = random(-1.0, 1.0)
        if kind == 5:
            # (a fire: a low roar that heaves, with crackles)
            lp += (x - lp) * 0.28
            crack = if random() < 0.0015: random(-1.0, 1.0) * 0.8 else: 0.0
            m[i] = lp * (0.3 + 0.12 * sin(t * TAU * 3.0)) + crack
        else:
            # (the wind: a soft, deep rush, gusting a little)
            lp += (x - lp) * 0.06
            lp2 += (lp - lp2) * 0.2
            m[i] = lp2 * (0.8 + 0.2 * sin(t * TAU * 0.5))
    seamless(m, fade, if kind == 5: 0.12 else: 0.1)

# Sky Barons' two very short broadband cracks. Listener-relative playback is intentional:
# the pilot hears a close pass even when the chase camera is fifty metres behind him.
near_miss_report = () -> Sound:
    mix([tone(2600.0,0.05,.noise,0.6,0.0005,0.04,0.3),tone(900.0,0.04,.noise,0.3,0.0005,0.03,0.4)])

water_report = () -> Sound:
    mix([tone(650.0,0.13,.noise,0.5,0.001,0.10,0.1),tone(140.0,0.09,.noise,0.45,0.001,0.07,0.2)])

# A heavy hull impact is a low water thump followed by falling spray, distinct
# from a bullet's brief spit. Only the existing full-strength splash event uses it.
wreck_water_report = () -> Sound:
    seconds=1.6;n=int(seconds*f64(MIX_RATE));samples=fill(f32(0),n*2)
    r=rng(1947);body=Biquad();spray=Biquad()
    lowpass(body,180);bandpass(spray,1300,0.55)
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE);noise=r.next_float()*2-1
        value=filt(body,noise)*4.5*exp(-t*5.5)+filt(spray,noise)*0.35*exp(-t*2.6)
        value*=min(1.0,t/0.009)*min(1.0,(seconds-t)/0.04)
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
    Sound(samples)

const GROUND_VARIANTS = 2
const GROUND_REACH = 1600.0
const SPOUT_REACH = 140.0

# A ground gun's report down the canal. The direct sound: a rifle's sharp crack over a short body,
# a machine gun's duller, rounder one; with distance the air takes the top off. Then the flutter
# echo between the canal's two walls: slaps every tenth of a second or so, from either side in
# turn, each duller and weaker than the last; and a short diffuse tail off the town.
ground_report = (rifle: bool, far: bool, variant: int) -> Sound:
    r=rng(2203+(if rifle:0 else:50)+(if far:500 else:0)+variant*131)
    seconds=if far:1.25 else:1.0
    n=int(seconds*f64(MIX_RATE))
    dry=fill(0.0,n);crack=Biquad();body=Biquad();air=Biquad()
    lowpass(crack,(if rifle:9000.0 else:6500.0)*(if far:0.3 else:1.0))
    highpass(air,if rifle:1300.0 else:900.0)
    bandpass(body,(if rifle:230.0 else:150.0)*(0.95+r.next_float()*0.1),0.7)
    snap=if rifle:240.0 else:150.0
    loop i in 0..min(n,int(0.25*f64(MIX_RATE))):
        t=f64(i)/f64(MIX_RATE);noise=r.next_float()*2.0-1.0
        sharp=filt(air,filt(crack,noise))
        dry[i]=(sharp*exp(-t*snap)*(if far:0.5 else:1.0)+filt(body,noise)*exp(-t*(if rifle:38.0 else:30.0))*(if far:2.6 else:3.2))*min(1.0,t/0.0002)
    left=fill(0.0,n);right=fill(0.0,n)
    loop i in 0..n:left[i]=dry[i];right[i]=dry[i]
    # (the flutter: each slap is the last one dulled again)
    echo=dry;gap=0.0
    loop k in 1..8:
        dull=Biquad();lowpass(dull,(if far:2400.0 else:4200.0)*pow(0.78,f64(k)))
        loop i in 0..n:echo[i]=filt(dull,echo[i])
        gap+=0.092+0.02*r.next_float()
        offset=int((0.03+gap)*f64(MIX_RATE))
        gain=0.5*pow(0.66,f64(k-1))*(if far:1.15 else:1.0)
        side=if k%2==1:1.0 else:-1.0
        loop i in 0..n-offset:
            left[i+offset]+=echo[i]*gain*(1.0-0.35*side)
            right[i+offset]+=echo[i]*gain*(1.0+0.35*side)
    # (the diffuse tail off the town beyond)
    tail=Biquad();lowpass(tail,if far:700.0 else:1100.0)
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE)
        diffuse=filt(tail,r.next_float()*2.0-1.0)*0.16*exp(-t*4.2)*min(1.0,t/0.05)
        left[i]+=diffuse;right[i]+=diffuse*0.9
    peak=0.0
    loop i in 0..n:peak=max(peak,max(abs(left[i]),abs(right[i])))
    gain=0.82/max(peak,0.001)
    samples=fill(f32(0),n*2)
    loop i in 0..n:
        fade=min(1.0,(f64(n-i)/f64(MIX_RATE))/0.08)
        samples[i*2]=f32(left[i]*gain*fade);samples[i*2+1]=f32(right[i]*gain*fade)
    Sound(samples)

# A supersonic round passing close: the bow wave's sharp N-shaped snap (a few hundred
# microseconds), then a short tearing hiss as the air closes behind it.
bullet_snap = (variant: int) -> Sound:
    r=rng(3301+variant*17)
    n=int(0.12*f64(MIX_RATE));samples=fill(f32(0),n*2)
    edge=Biquad();highpass(edge,1500.0);hiss=Biquad();bandpass(hiss,3400.0+r.next_float()*800.0,1.1)
    width=0.0009+0.0004*r.next_float()
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE)
        wave=if t<width:1.0-2.0*t/width else:0.0
        value=filt(edge,wave)*0.95+filt(hiss,r.next_float()*2.0-1.0)*0.22*exp(-t*45.0)*min(1.0,t/0.002)
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
    Sound(samples)

# A round's spout: a short spit of spray and a small plunk of water, gone in a fifth of a second.
spout_report = (variant: int) -> Sound:
    r=rng(3407+variant*29)
    n=int(0.2*f64(MIX_RATE));samples=fill(f32(0),n*2)
    spray=Biquad();bandpass(spray,1700.0+r.next_float()*500.0,1.0);low=Biquad();bandpass(low,210.0,0.9)
    pitch=820.0+r.next_float()*160.0;phase=0.0
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE);noise=r.next_float()*2.0-1.0
        phase+=TAU*pitch*(1.0-0.45*min(1.0,t/0.04))/f64(MIX_RATE)
        value=filt(spray,noise)*0.5*exp(-t*32.0)+sin(phase)*0.22*exp(-t*70.0)+filt(low,noise)*0.9*exp(-t*38.0)
        value*=min(1.0,t/0.0015)
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
    Sound(samples)

prepare_ground_audio = (a: mut CombatAudio):
    if a.ground.ready:return
    g=GroundSounds(ready=true)
    loop rifle in [true,false]:
        loop far in [false,true]:
            loop v in 0..GROUND_VARIANTS:g.reports.push(ground_report(rifle,far,v))
    g.snaps=[loop v in 0..3:bullet_snap(v)]
    g.spouts=[loop v in 0..4:spout_report(v)]
    a.ground=g

# Which ground-gun report, how loud, and how late (sound's travel down the canal).
struct GroundCue:
    sound: int
    level: f64
    delay: f64

ground_shot_cue = (machine_gun: bool, distance: f64, variant: int) -> GroundCue:
    far=distance>180.0
    k=__reach_gain(distance,GROUND_REACH)
    GroundCue((if machine_gun:1 else:0)*GROUND_VARIANTS*2+(if far:GROUND_VARIANTS else:0)+variant%GROUND_VARIANTS,(if machine_gun:0.42 else:0.55)*k,distance/343.0)

spout_level = (distance: f64) -> f64: 0.42*__reach_gain(distance,SPOUT_REACH)

start_combat_audio = () -> CombatAudio:
    a=CombatAudio(guns=[loop i in 0..3*GUN_VARIANTS:gun_report(i/GUN_VARIANTS,i%GUN_VARIANTS)],hit=combat_wave(3),open=combat_wave(4),fire_sound=_noise_loop(5),wind_sound=_noise_loop(6),thump=combat_wave(7),whizz=near_miss_report(),splash=water_report(),wreck_splash=wreck_water_report())
    a.fire=play(a.fire_sound,0,looping=true);a.wind=play(a.wind_sound,0,looping=true)
    a

combat_audio_events = (a: CombatAudio,events: CombatEvent[],ear: vec3,player:int = -1):
    count=0
    loop event in events:
        if event.kind==.hit and event.craft==player:
            play(a.hit,0.45);play(a.thump,0.65);continue
        if count>=8 or length(event.position-ear)>2500:continue
        if event.kind==.shot and event.craft<0 and a.ground.ready:
            # (a ground gun down the canal: heard far, late by the sound's travel, with its echo)
            distance=f64(length(event.position-ear))
            cue=ground_shot_cue(event.strength>=1.0,distance,random_int(0,GROUND_VARIANTS))
            _,pan=__place_3d(event.position,GROUND_REACH)
            if cue.level>0.001:play(a.ground.reports[cue.sound],cue.level,pan,random(0.96,1.04),delay=cue.delay)
            count+=1
            continue
        match event.kind:
            .shot:play_at(a.guns[clamp(int(event.strength),0,2)*GUN_VARIANTS+random_int(0,GUN_VARIANTS)],event.position,0.28,180.0)
            .hit, .separated:play_at(a.hit,event.position,0.4,110.0)
            .splash:
                distance=f64(length(event.position-ear))
                if event.strength>=0.8 and distance<1400:
                    level,pan=__place_3d(event.position,1400)
                    play(a.wreck_splash,0.65*level,pan,delay=distance/343.0)
                else if a.ground.ready and distance<SPOUT_REACH:
                    _,pan=__place_3d(event.position,SPOUT_REACH)
                    play(a.ground.spouts[random_int(0,a.ground.spouts.len())],spout_level(distance),pan,random(0.9,1.12))
                else if distance<100:play(a.splash,0.5*(1.0-distance/100.0),pitch=random(0.9,1.1))
            .bailed:play_at(a.open,event.position,0.35,80.0)
            _:continue
        count+=1

update_combat_audio = (a: CombatAudio,b: Battle,ear: vec3,person: int):
    fire=0.0;wind=0.0
    loop actor in b.actors:if actor.present:fire=max(fire,actor.fire/(1.0+f64(length(actor.state.position-ear))/40.0))
    loop d in b.descents:
        if d.person==person and (d.phase==.falling or d.phase==.canopy):wind=if d.phase==.canopy: 0.4 else: 0.7
    set_volume(a.fire,fire*0.35);set_volume(a.wind,wind)

hush_combat_audio = (a: CombatAudio):
    if a.fire>=0:set_volume(a.fire,0)
    if a.wind>=0:set_volume(a.wind,0)

# A short Doppler-like crack/swish at the swept closest point, once per projectile.
combat_audio_passes = (a:CombatAudio,points:vec3[]):
    loop p in points:play(a.whizz,0.5,pitch=random(0.9,1.1))

# A ground gun's supersonic round past the pilot: its sharper snap, from the side it passed.
combat_audio_snaps = (a:CombatAudio,points:vec3[]):
    if not a.ground.ready:return
    loop p in points:
        _,pan=__place_3d(p,60.0)
        play(a.ground.snaps[random_int(0,a.ground.snaps.len())],0.55,pan,random(0.94,1.06))
