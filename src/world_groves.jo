use 'water_field.jo'
use 'thermal_sites.jo'
use 'airfields.jo'
use 'working_land_contact.jo'
use 'water_types.jo'
use 'walk_shapes.jo'
use 'town_sites.jo'
# Same meshes, shader, ecology thresholds and 26 m candidate grid as old groves.
# Only published canonical near tiles receive trees, so feet never ride coarse
# fallback triangles. Fixed 64-slot reuse bounds resident instance buffers.
use 'quality.jo'
use 'objects.jo'
use 'settlements.jo'
use 'geography.jo'
use 'look.jo'
use 'plants.jo'
use 'world_terrain.jo'
use 'world_source.jo'
use 'canopy.jo'
use 'crowns.jo'
use 'fields.jo'
use 'settlement_purpose.jo'

struct WorldGrove:
    key: int = -1
    used: int
    roads: int
    places: int
    grove: Grove
    crowns: InstanceBuffer[CrownClump]
    wood: InstanceBuffer[Instance3D]
    woods_buffer: InstanceBuffer[CrownClump]
    born: f64 = -100.0             # (when its trees and its woods were made: they fade in)
    woods_born: f64 = -100.0
    # (the woods' crowns, made a few rows of the canopy's cells a frame after the trees: wood_step)
    trees: CrownClump[] = []
    woods: CrownClump[] = []
    woods_next: int = -1           # the next row of the tile's canopy cells to make, from its first (-1: done)
    stand: f32[] = []
    ground: f32[] = []

world_groves: WorldGrove[]
world_grove_count = 0
world_grove_generated = 0

# The trees of one tile from the shared cell query (src/canopy.jo): the shader finds the same
# crowns again for the far canopy, so each tree stands on its painted crown. share: the cells
# kept as meshes (grove_keep under it; 1 all of them, as the canopy and the tests see them).
world_grove_lists = (x: int,z: int,share: f32 = 1.0) -> Instance3D[][]:
    ox,oz = world_tile_origin(x,z,0)
    lists: Instance3D[][] = [[],[],[]]
    # Global ecology cells belong to exactly one tile, including negative space.
    loop j in int(floor(oz/GROVE_CELL))..int(ceil((oz+224.0)/GROVE_CELL)):
        loop i in int(floor(ox/GROVE_CELL))..int(ceil((ox+224.0)/GROVE_CELL)):
            cell = vec2(f32(i),f32(j))
            lay = grove_layout(cell)
            wx = (f64(i)+f64(lay.x))*GROVE_CELL
            wz = (f64(j)+f64(lay.y))*GROVE_CELL
            if wx < ox or wx >= ox+224.0 or wz < oz or wz >= oz+224.0: continue
            if grove_keep(cell) >= share: continue
            if thermal_paved(vec2(f32(wx),f32(wz))) or working_paved(vec2(f32(wx),f32(wz))) or airfield_clear(vec2(f32(wx),f32(wz))) or settlement_urban(vec2(f32(wx),f32(wz))) or settlement_on_road(vec2(f32(wx),f32(wz))): continue
            h = world_source_surface(wx,wz)
            if h < 4.0 or h >= 2200.0 or water_at(wx,wz).wet: continue
            sl = world_source_slope(wx,wz)
            if sl > 0.7: continue
            # (the terrain's own grove field, which the far canopy reads)
            dens = grove_field(wx,wz)
            chance = grove_chances(cell)
            # (above the original islands' elevation range thinning out: no alpine species)
            kind = grove_kind_at(chance,f32(dens),f32(sl),f32(h))
            if kind < 0: continue
            scale = 0.75+0.55*f64(lay.z); shade = 0.85+0.27*chance.w
            m = translation(vec3(f32(wx),f32(h),f32(wz)))*rotation_y(f64(lay.w)*TAU)*scaling(scale)
            lists[kind].push(Instance3D(m,vec4(shade,shade*(0.95+0.1*lay.w),shade,1)))
            if kind == int(Tree.pine):
                sib = grove_sibling(cell)
                if sib.x >= 0.6: continue
                nx = wx+(f64(sib.y)*2.0-1.0)*GROVE_SIBLING_REACH; nz = wz+(f64(sib.z)*2.0-1.0)*GROVE_SIBLING_REACH
                nh = world_source_surface(nx,nz)
                if nh > 4.0 and not water_at(nx,nz).wet and not thermal_paved(vec2(f32(nx),f32(nz))) and not airfield_clear(vec2(f32(nx),f32(nz))) and not working_paved(vec2(f32(nx),f32(nz))) and not settlement_on_road(vec2(f32(nx),f32(nz))):
                    m2 = translation(vec3(f32(nx),f32(nh),f32(nz)))*rotation_y(f64(sib.y+lay.w)*TAU)*scaling(0.7+0.45*f64(sib.w))
                    lists[kind].push(Instance3D(m2,vec4(shade,shade,shade,1)))
    nature_grove(lists)

# A tile's grove made (or remade, its roads or places changed) in a slot: the least recently used
# beyond WORLD_GROVE_SLOTS, never one used this frame. -1 when every slot is in use.
const WORLD_GROVE_SLOTS = 192
# (an anchored set, the title shot's or the coming one's, keeps to this many, nearest its middle
# first: the two together always fit, so warming never waits on a slot)
const WORLD_GROVE_SHOT_MOST = 48
_world_grove_fill = (node: WorldTile) -> int:
    global world_groves
    ox,oz = world_tile_origin(node.x,node.z,0)
    found = -1
    loop k in 0..world_groves.len():
        if world_groves[k].key == node.key: found = k; break
    if found >= 0: pass
    else if world_groves.len() < WORLD_GROVE_SLOTS:
        empty: Instance3D[]
        no_crowns: CrownClump[]
        world_groves.push(WorldGrove(grove=Grove(vec2(0,0),160.0,[loop k in 0..PLANT_KINDS: instance_buffer(empty)]),crowns=instance_buffer(no_crowns),wood=instance_buffer(empty),woods_buffer=instance_buffer(no_crowns)))
        found = world_groves.len()-1
    else:
        oldest = world_frame
        loop k in 0..world_groves.len():
            if world_groves[k].used < oldest: oldest = world_groves[k].used; found = k
        if found < 0: return -1
    # (the tier's thinning by cell, so the far canopy knows which crowns have meshes)
    lists = world_grove_lists(node.x,node.z,grove_kept_share())
    solids: TownSite[]
    loop kind in 0..min(2,lists.len()):
        loop tree in lists[kind]:
            at=tree.model[3].xyz;scale=f64(length(tree.model[0].xyz))
            solids.push(TownSite(at,0,0.6*scale,0.6*scale,5*scale,0))
    walk_publish("worldgrove:{found}",solids)
    g = world_groves[found]
    clumps,wood = crowns_of_lists(lists)
    loop k in 0..PLANT_KINDS: set_instances(g.grove.kinds[k],lists[k])
    set_instances(g.crowns,clumps); set_instances(g.wood,wood)
    g.trees = clumps; g.woods = []
    no_woods: CrownClump[]
    set_instances(g.woods_buffer,no_woods)
    g.born = time(); g.woods_born = -100.0
    g.stand,g.ground = wood_grid(node,ox,oz)
    g.woods_next = -1
    loop v in g.stand:
        if v > 0.05:
            g.woods_next = 0
            break
    g.key = node.key; g.roads = _world_grove_roads(ox,oz); g.places = _world_grove_places(ox,oz); g.grove.center = vec2(f32(ox+112.0),f32(oz+112.0))
    world_groves[found] = g
    found

_world_grove_roads = (ox: f64,oz: f64) -> int: settlement_road_bins.get(road_bin(vec2(f32(ox+112.0),f32(oz+112.0))),[]).len()
_world_grove_places = (ox: f64,oz: f64) -> int: settlement_bins.get(geography_bin(ox+112.0,oz+112.0),[]).len()
_world_grove_slot = (node: WorldTile) -> int:
    ox,oz = world_tile_origin(node.x,node.z,0)
    loop k in 0..world_groves.len():
        if world_groves[k].key == node.key:
            if world_groves[k].roads != _world_grove_roads(ox,oz) or world_groves[k].places != _world_grove_places(ox,oz): return -1
            return k
    -1

# A fixed point the groves are reached from, instead of the moving camera (the title's shots: its
# middle, so the groves' edge stays still in the world while the camera moves), and how far; and
# the same for the coming view, while it is warmed.
world_grove_anchor: vec3? = none
world_grove_reach = 0.0
world_grove_next_anchor: vec3? = none
world_grove_next_reach = 0.0
_world_grove_near = (at: vec2, eye: vec3, anchor: vec3?, reach: f64) -> bool:
    if let a = anchor: return length(a.xz-at) <= f32(reach)
    # (a ring of tiles past the trees' reach made ahead, so none arrives in sight)
    length(eye.xz-at) <= f32(render_quality.grove_distance+224.0)

# The near tiles whose groves a selected tile shows: itself, at the finest level and settled; with
# an anchor, also the finest tiles under a coarser one within the reach (their trees stand on the
# true ground, where the coarser mesh is within a metre or two: far off, unseen), so trees don't
# arrive mid-shot as the terrain's finest level reaches them.
world_grove_visible = 0
_world_grove_tiles = (node: WorldTile,eye: vec3,anchor: vec3?,reach: f64) -> WorldTile[]:
    if node.high < 4.0 or node.low >= 2200.0: return []
    if node.level == 0:
        ox,oz = world_tile_origin(node.x,node.z,0)
        if anchor == none and node.lod != 0.0: return []
        return if _world_grove_near(vec2(f32(ox+112.0),f32(oz+112.0)),eye,anchor,reach): [node] else: []
    if anchor == none or node.level > 3: return []
    tiles: WorldTile[]
    n = 1 << node.level
    loop dz in 0..n:
        loop dx in 0..n:
            x = node.x*n+dx; z = node.z*n+dz
            ox,oz = world_tile_origin(x,z,0)
            if _world_grove_near(vec2(f32(ox+112.0),f32(oz+112.0)),eye,anchor,reach): tiles.push(WorldTile(key=world_tile_key(x,z,0),x=x,z=z,level=0,low=node.low,high=node.high))
    tiles

# an anchored set of tiles, nearest the anchor first, to WORLD_GROVE_SHOT_MOST
world_grove_capped = false
_world_grove_cap = (tiles: WorldTile[],anchor: vec3?) -> WorldTile[]:
    global world_grove_capped
    if let a = anchor:
        if tiles.len() <= WORLD_GROVE_SHOT_MOST: return tiles
        world_grove_capped = true
        kept = tiles
        kept.sort((w: WorldTile) -> f32:
            ox,oz = world_tile_origin(w.x,w.z,0)
            length(a.xz-vec2(f32(ox+112.0),f32(oz+112.0))))
        return kept[0..WORLD_GROVE_SHOT_MOST]
    tiles

# The groves of the tiles warmed for a coming view (world_warm), made ahead in the frames' one
# grove each, kept from the slots' reuse while asked for; how many are still to be made.
world_grove_warm_missing = 0
world_grove_warm_frame = -1
world_groves_warm = ():
    global world_groves,world_grove_generated,world_grove_warm_missing,world_grove_warm_frame
    world_grove_warm_missing = 0; world_grove_warm_frame = world_frame
    wanted: WorldTile[]
    keys: {int: bool} = {}
    loop n in 0..world_warm_selected.len():
        if world_warm_selected[n] >= world_tiles.len(): continue
        eye = world_warm_eyes[n]
        if f64(eye.y) > 2100.0: continue
        if abs(eye.x) < LEGACY_RESERVE-1000.0 and abs(eye.z) < LEGACY_RESERVE-1000.0: continue
        loop tile in _world_grove_tiles(world_tiles[world_warm_selected[n]],eye,world_grove_next_anchor,world_grove_next_reach):
            if not (tile.key in keys): keys[tile.key] = true; wanted.push(tile)
    loop tile in _world_grove_cap(wanted,world_grove_next_anchor):
        found = _world_grove_slot(tile)
        if found < 0:
            world_grove_warm_missing += 1
            if world_grove_generated >= 1: continue
            found = _world_grove_fill(tile)
            if found < 0: continue
            world_grove_generated += 1; world_grove_warm_missing -= 1
        g = world_groves[found]; g.used = world_frame; world_groves[found] = g
# the coming view's groves all made (as of this frame or the last)
world_groves_settled = () -> bool: world_warm_views.len() == 0 or (world_grove_warm_frame >= world_frame-1 and world_grove_warm_missing == 0)

draw_world_groves = (meshes: Mesh[],L: Light,t: f64):
    global world_groves,world_grove_count,world_grove_generated,world_grove_visible,wood_seeds
    if wood_seeds.len() == 0: wood_seeds = canopy_seeds()
    world_grove_count = 0; world_grove_generated = 0
    if not geography_enabled: return
    cam = scene_camera()
    if (abs(cam.x) < LEGACY_RESERVE-1000.0 and abs(cam.z) < LEGACY_RESERVE-1000.0) or cam.y > 2100.0:
        if world_warm_views.len() > 0: world_groves_warm()
        return
    zone("world groves")
    visible: Grove[]
    visible_crowns: InstanceBuffer[CrownClump][]
    visible_fades: f32[]
    now = time()
    visible_slots: int[]
    visible_wood: InstanceBuffer[Instance3D][]
    wanted: WorldTile[]
    loop tile_slot in world_selected:
        # Published domains already pass the terrain frustum test.
        loop tile in _world_grove_tiles(world_tiles[tile_slot],cam,world_grove_anchor,world_grove_reach): wanted.push(tile)
    loop tile in _world_grove_cap(wanted,world_grove_anchor):
        found = _world_grove_slot(tile)
        if found < 0:
            if world_grove_generated >= 1: continue
            found = _world_grove_fill(tile)
            if found < 0: continue
            world_grove_generated += 1
        g = world_groves[found]; g.used = world_frame; world_groves[found] = g
        loop kind in g.grove.kinds: world_grove_count += kind.count
        visible.push(g.grove)
        visible_crowns.push(g.crowns); visible_wood.push(g.wood)
        visible_fades.push(f32(clamp((now-g.born)/0.6,0.0,1.0)))
        visible_crowns.push(g.woods_buffer)
        visible_fades.push(f32(clamp((now-g.woods_born)/0.6,0.0,1.0)))
        visible_slots.push(found)
    world_grove_visible = visible.len()
    # (then the coming view's, with what is left of the frame's one)
    if world_warm_views.len() > 0: world_groves_warm()
    # (the woods' crowns, a millisecond's worth of rows a frame)
    zone("woods")
    wood_step(visible_slots,time()+0.001)
    zone_end()
    draw_groves(meshes,visible,L,t)
    zone("crowns")
    draw_crowns(visible_crowns,visible_fades,crown_params(L,t,render_quality.grove_distance))
    limb = crown_limb()
    p = obj_params(L,t)
    loop w in visible_wood:
        if w.count > 0: draw_instanced(crown_limb_sh,limb,w,p)
    zone_end()
    zone_end()

# The grove lists' trees as crowns (src/crowns.jo): pines, cypresses, bushes and olives become
# clumps on limbs (and a share of the lowland pines plane trees), their lists emptied so no mesh
# is drawn for them; oleanders and prickly pears keep their meshes.
crowns_of_lists = (lists: mut Instance3D[][]) -> (CrownClump[],Instance3D[]):
    clumps: CrownClump[]
    wood: Instance3D[]
    loop kind in 0..min(lists.len(),4):
        loop tree in lists[kind]:
            m = tree.model
            root = m[3].xyz
            scale = length(m[0].xyz)
            yaw = atan2(m[0].z,m[0].x)
            seed = hash21(floor(root.xz*4.0)+vec2(17.0,3.0))
            species = if kind == int(Tree.pine): CROWN_PINE else: if kind == int(Tree.cypress): CROWN_CYPRESS else: if kind == int(Tree.bush): CROWN_BUSH else: CROWN_OLIVE
            if species == CROWN_PINE and root.y < 120.0 and seed < 0.3: species = CROWN_PLANE
            crown_place(clumps,wood,species,root,yaw,scale,tree.color.x,seed)
        lists[kind] = []
    (clumps,wood)

crown_limb_cache: Mesh[] = []
crown_limb = () -> Mesh:
    global crown_limb_cache
    if crown_limb_cache.len() == 0: crown_limb_cache.push(crown_limb_mesh())
    crown_limb_cache[0]

# ---------------- the woods as crowns ----------------

# The stand cover at a point, computed whole (for a tile the terrain has not streamed: the title's
# anchored groves): wood_stand from the sources the terrain's tiles bake.
wood_stand_at = (x: f64,z: f64) -> f32:
    sy,ridge = world_source_sample(x,z)
    y = f32(sy)
    if y < 0.6: return 0.0
    nx = world_source_sample(x-5.0,z).0-world_source_sample(x+5.0,z).0
    nz = world_source_sample(x,z-5.0).0-world_source_sample(x,z+5.0).0
    n = normalize(vec3(f32(nx),10,f32(nz)))
    tx = f32(fbm(x*0.004+3.3,z*0.004,3))
    p = vec2(f32(x),f32(z))
    sr = length(n.xz)/max(n.y,0.1)
    orchard = orchard_cover(p,y,sr)
    stands = clamp(grove_pine_cover(tx,sr,y)*7.0,0.0,1.0)
    work = field_colour(working_landuse(p,sy,f64(sr)),p,y,1.0-n.y,stands,orchard,14.0,field_warp_cpu(p),field_palette)
    wood_stand(n,y,f32(ridge),tx,f32(noise(x*0.0011-3.3,z*0.0011)),p,work.w,orchard)

wood_seeds: CanopySeed[] = []

# A tile's woods: every crown of the painted canopy's sheet (src/canopy.jo, 9 m cells, two crowns
# to a cell) that the paint draws there (the stand cover above the crown's own draw), stood up as
# a few clumps of its own size: the same crowns the ground paints beyond the groves' reach.
# A tile's stand cover and ground on its 14 m grid, as the terrain's tile job made them; a tile
# not streamed yet (the title's anchored groves) works them out here.
wood_grid = (node: WorldTile,ox: f64,oz: f64) -> (f32[],f32[]):
    if foliage_off("woods"):
        empty: f32[] = []
        return (empty,empty)
    if world_cache.get(node.key,-1) >= 0 and world_tiles[world_cache[node.key]].stand.len() == 289:
        t = world_tiles[world_cache[node.key]]
        return (t.stand,t.cpu_heights)
    stand: f32[] = []
    ground: f32[] = []
    if foliage_off("woods"): return (stand,ground)
    loop j in 0..17:
        loop i in 0..17:
            x = ox+f64(i)*14.0; z = oz+f64(j)*14.0
            stand.push(wood_stand_at(x,z))
            ground.push(f32(world_source_surface(x,z)))
    (stand,ground)

# One row of the canopy's cells (9 m) of a tile's woods: every crown of the painted canopy's sheet
# (src/canopy.jo, two crowns to a cell) that the paint draws there (the stand cover above the
# crown's own draw), stood up as a few clumps of its own size: the same crowns the ground paints
# beyond the groves' reach.
wood_row = (out: mut CrownClump[],stand: f32[],ground: f32[],ox: f64,oz: f64,cz: int):
    global wood_seeds
    if wood_seeds.len() == 0: wood_seeds = canopy_seeds()
    if stand.len() != 289: return
    at = (g: f32[],x: f64,z: f64) -> f32:
        fx = clamp((x-ox)/14.0,0.0,15.999); fz = clamp((z-oz)/14.0,0.0,15.999)
        i = int(fx); j = int(fz); u = f32(fx-f64(i)); v = f32(fz-f64(j))
        a = g[j*17+i]; b = g[j*17+i+1]; c = g[(j+1)*17+i]; d = g[(j+1)*17+i+1]
        mix(mix(a,b,u),mix(c,d,u),v)
    loop cx in int(floor(ox/CANOPY_CELL))..int(ceil((ox+224.0)/CANOPY_CELL)):
        wx = ((cx%CANOPY_CELLS)+CANOPY_CELLS)%CANOPY_CELLS; wz = ((cz%CANOPY_CELLS)+CANOPY_CELLS)%CANOPY_CELLS
        loop k in 0..2:
            sd = wood_seeds[(wz*CANOPY_CELLS+wx)*2+k]
            x = (f64(cx)+f64(sd.shape.x))*CANOPY_CELL; z = (f64(cz)+f64(sd.shape.y))*CANOPY_CELL
            if x < ox or x >= ox+224.0 or z < oz or z >= oz+224.0: continue
            cover = at(stand,x,z)
            if cover <= sd.id: continue
            q = vec2(f32(x),f32(z))
            if settlement_urban(q) or settlement_on_road(q) or water_at(x,z).wet: continue
            closed = clamp((cover-0.6)*2.5,0.0,1.0)
            crown_wood(out,vec3(f32(x),at(ground,x,z),f32(z)),sd.shape.z*f32(CANOPY_CELL),sd.phase.w,fract(sd.id*7.13),closed,sd.id)

# The woods' crowns made a few rows a frame, the visible groves' first, until `until` (a time()):
# a tile's woods never cost one frame its whole making.
wood_step = (visible: int[],until: f64):
    global world_groves
    loop k in visible:
        g = world_groves[k]
        if g.woods_next < 0: continue
        ox = f64(g.grove.center.x)-112.0; oz = f64(g.grove.center.y)-112.0
        first = int(floor(oz/CANOPY_CELL))
        rows = int(ceil((oz+224.0)/CANOPY_CELL))-first
        loop g.woods_next >= 0 and time() < until:
            # (through a local: a struct field passed as `mut` was mutated in a copy, and the woods
            # stayed empty)
            made = g.woods
            wood_row(made,g.stand,g.ground,ox,oz,first+g.woods_next)
            g.woods = made
            g.woods_next += 1
            if g.woods_next >= rows:
                g.woods_next = -1
                set_instances(g.woods_buffer,g.woods)
                g.woods_born = time()
        world_groves[k] = g
        if time() >= until: return
