use 'water_field.jo'
use 'thermal_sites.jo'
use 'water_types.jo'
use 'walk_shapes.jo'
use 'town_sites.jo'
# Same meshes, shader, ecology thresholds and 26 m candidate grid as old groves.
# Only published canonical near tiles receive trees, so feet never ride coarse
# fallback triangles. Fixed 64-slot reuse bounds resident instance buffers.
use 'quality.jo'
use 'objects.jo'
use 'settlements.jo'
use 'geography.jo'
use 'look.jo'
use 'plants.jo'
use 'world_terrain.jo'
use 'world_source.jo'

struct WorldGrove:
    key: int = -1
    used: int
    roads: int
    places: int
    grove: Grove

world_groves: WorldGrove[]
world_grove_count = 0
world_grove_generated = 0

world_grove_lists = (x: int,z: int) -> Instance3D[][]:
    ox,oz = world_tile_origin(x,z,0)
    lists: Instance3D[][] = [[],[],[]]
    # Global ecology cells belong to exactly one tile, including negative space.
    loop j in int(floor(oz/26.0))..int(ceil((oz+224.0)/26.0)):
        loop i in int(floor(ox/26.0))..int(ceil((ox+224.0)/26.0)):
            r = rng((i*73856093 xor j*19349663 xor GEOGRAPHY_SEED) & 0x7FFFFFFF)
            wx = (f64(i)+r.next_float())*26.0
            wz = (f64(j)+r.next_float())*26.0
            if wx < ox or wx >= ox+224.0 or wz < oz or wz >= oz+224.0: continue
            if thermal_paved(vec2(f32(wx),f32(wz))) or settlement_urban(vec2(f32(wx),f32(wz))) or settlement_on_road(vec2(f32(wx),f32(wz))): continue
            h = world_source_surface(wx,wz)
            if h < 4.0 or h >= 2200.0 or water_at(wx,wz).wet: continue
            sl = world_source_slope(wx,wz)
            if sl > 0.7: continue
            dens = fbm(wx*0.006+3.3*3.0,wz*0.006,3)
            # Existing bare/bush behavior above the original islands' elevation
            # range: no new alpine tree species or palette.
            if r.next_float() < smoothstep(1500.0,2200.0,h): continue
            kind = grove_kind(sl,dens,1e9,r,false)
            if kind < 0: continue
            scale = geo_random(r,0.75,1.3); shade = f32(geo_random(r,0.85,1.12))
            m = translation(vec3(f32(wx),f32(h),f32(wz)))*rotation_y(geo_random(r,0.0,TAU))*scaling(scale)
            lists[kind].push(Instance3D(m,vec4(shade,shade*f32(geo_random(r,0.95,1.05)),shade,1)))
            if kind == int(Tree.pine) and r.next_float() < 0.6:
                nx = wx+geo_random(r,-9.0,9.0); nz = wz+geo_random(r,-9.0,9.0)
                nh = world_source_surface(nx,nz)
                if nh > 4.0 and not water_at(nx,nz).wet and not thermal_paved(vec2(f32(nx),f32(nz))) and not settlement_on_road(vec2(f32(nx),f32(nz))):
                    m2 = translation(vec3(f32(nx),f32(nh),f32(nz)))*rotation_y(geo_random(r,0.0,TAU))*scaling(geo_random(r,0.7,1.15))
                    lists[kind].push(Instance3D(m2,vec4(shade,shade,shade,1)))
    nature_grove(lists)

draw_world_groves = (meshes: Mesh[],L: Light,t: f64):
    global world_groves,world_grove_count,world_grove_generated
    world_grove_count = 0; world_grove_generated = 0
    if not geography_enabled: return
    cam = scene_camera()
    if (abs(cam.x) < LEGACY_RESERVE-1000.0 and abs(cam.z) < LEGACY_RESERVE-1000.0) or cam.y > 2100.0: return
    zone("world groves")
    visible: Grove[]
    loop tile_slot in world_selected:
        node = world_tiles[tile_slot]
        if node.level != 0 or node.lod != 0.0 or node.high < 4.0 or node.low >= 2200.0: continue
        ox,oz = world_tile_origin(node.x,node.z,0)
        if length(cam.xz-vec2(f32(ox+112.0),f32(oz+112.0))) > f32(render_quality.grove_distance): continue
        # Published domains already pass the terrain frustum test.
        found = -1
        loop k in 0..world_groves.len():
            if world_groves[k].key == node.key: found = k; break
        road_count = settlement_road_bins.get(road_bin(vec2(f32(ox+112.0),f32(oz+112.0))),[]).len()
        place_count = settlement_bins.get(geography_bin(ox+112.0,oz+112.0),[]).len()
        if found < 0 or world_groves[found].roads != road_count or world_groves[found].places != place_count:
            if world_grove_generated >= 1: continue
            if found >= 0: pass
            else if world_groves.len() < 64:
                empty: Instance3D[]
                world_groves.push(WorldGrove(grove=Grove(vec2(0,0),160.0,[loop k in 0..PLANT_KINDS: instance_buffer(empty)])))
                found = world_groves.len()-1
            else:
                oldest = world_frame
                loop k in 0..world_groves.len():
                    if world_groves[k].used < oldest: oldest = world_groves[k].used; found = k
                if found < 0: continue
            lists = thin_grove(world_grove_lists(node.x,node.z))
            solids: TownSite[]
            loop kind in 0..min(2,lists.len()):
                loop tree in lists[kind]:
                    at=tree.model[3].xyz;scale=f64(length(tree.model[0].xyz))
                    solids.push(TownSite(at,0,0.6*scale,0.6*scale,5*scale,0))
            walk_publish("worldgrove:{found}",solids)
            g = world_groves[found]
            loop k in 0..PLANT_KINDS: set_instances(g.grove.kinds[k],quality_trees(lists[k]))
            g.key = node.key; g.roads = road_count; g.places = place_count; g.grove.center = vec2(f32(ox+112.0),f32(oz+112.0))
            world_groves[found] = g
            world_grove_generated += 1
        g = world_groves[found]; g.used = world_frame; world_groves[found] = g
        loop kind in g.grove.kinds: world_grove_count += kind.count
        visible.push(g.grove)
    draw_groves(meshes,visible,L,t)
    zone_end()
