# Spray banks: the big, slow spray of a planing run, a touchdown or a bounce. Each float's spray
# curtains (src/splash.jo) are the sheet at the float; behind them, what they throw up rolls up
# and back into a wall of lobed, painted masses taller than the float is long at full planing,
# that hangs over the water for two to four seconds after the aircraft has gone, drifting and
# sinking downwind, and shrinks away (never fading).
#
# Presentation only: no forces, no emissions into the shared particles, no draws on the game's
# random numbers. Each puff's path is a closed form of its birth, so it is the same at any frame
# rate. Puffs live in world space (WorldPoint), so a bank stays where it was thrown.
use 'pilot.jo'
use 'flight.jo'
use 'flight_feedback.jo'
use 'planes.jo'
use 'damage.jo'
use 'world_point.jo'
use 'sea.jo'
use 'look.jo'
use 'quality.jo'
use 'render_space.jo'
use 'splash.jo'
use 'flight_effects.jo'

struct SprayPuff:
    at:WorldPoint          # where it was thrown, on the sea
    out:vec3               # the way it is thrown across the run (unit, level)
    along:vec3             # the run's heading (unit, level): the puff's long axis
    drift:vec3             # the wind's push (m/s, level)
    born:f64
    life:f64
    reach:f64              # how far out it is thrown (m)
    rise:f64               # how high its centre rises (m)
    carry:f64              # how far it is carried on along the run (m)
    size:vec3              # half-extents when full grown (across, up, along)
    phase:f64
struct SprayBank:
    puffs:SprayPuff[]
    credit:f64[8]          # per spray source: puffs owed
    wet:bool[7]            # per part: in the water last frame
    lift:f64[7]            # per part: how fast it was coming down when last in the air
    time:f64= -1.0
    serial=0
spray_bank=SprayBank()
# The kind of a bank's lobes: painted as the curtains' billows, drawn on their own mesh.
SPRAY_BIG=f32(2.45)

# The most puffs alive: the low tier (and phones) keep fewer and bigger.
spray_bank_cap=()->int:if render_quality.tier==0:120 else:if render_quality.tier==1:170 else:220

# A cheap hash for presentation (the game's random numbers are left alone).
spray_hash=(n:int)->f64:
    x=sin(f64(n)*12.9898+78.233)*43758.5453
    x-floor(x)

# The sea's state, 0 calm to 1 a fresh blow: rough water throws more and higher.
spray_sea=(w:Wind)->f64:smoothstep(3.0,13.0,w.speed)

# A float's length (m), from its contacts.
spray_part_length=(kind:Craft,model:CraftModel,part:int)->f64:
    lo=1e9;hi= -1e9
    loop p in model.contacts:
        if contact_part(kind,p)==part:lo=min(lo,f64(p.z));hi=max(hi,f64(p.z))
    if hi>lo:hi-lo else:2.0

spray_throw=(bank:mut SprayBank,at:WorldPoint,out:vec3,along:vec3,drift:vec3,t:f64,life:f64,reach:f64,rise:f64,carry:f64,size:vec3):
    if bank.puffs.len()>=spray_bank_cap():
        # (full: the oldest goes first, as it would have shrunk away soonest)
        oldest=0
        loop i in 1..bank.puffs.len():
            if bank.puffs[i].born<bank.puffs[oldest].born:oldest=i
        bank.puffs[oldest]=bank.puffs[bank.puffs.len()-1];bank.puffs.pop()
    bank.serial+=1
    bank.puffs.push(SprayPuff(at,out,along,drift,t,life,reach,rise,carry,size,spray_hash(bank.serial)*TAU*3.0))

# Where a puff is, and how big, at time t: thrown out and up fast, slowing (air drag), then
# hanging and sinking slowly while the wind carries it on. Grows from a third of its size as it
# rolls up, holds, then shrinks away over the last third of its life.
spray_puff_now=(p:SprayPuff,t:f64)->SprayPose:
    a=max(0.0,t-p.born)
    k=1.0-exp(-a/0.3)
    # (seated on the water: its base stays at or just under the sea, so a bank is a wall
    # standing on the water, never lumps hanging in the air; it settles as it shrinks)
    up=p.rise*(1.0-exp(-a/0.3))*(1.0-0.5*smoothstep(p.life*0.4,p.life,a))
    point=world_offset(p.at,p.out*f32(p.reach*k)+p.along*f32(p.carry*k)+p.drift*f32(a)+vec3(0,f32(up),0))
    grow=0.6+0.4*smoothstep(0.0,0.3,a)
    shrink=1.0-smoothstep(p.life*0.7,p.life,a)
    SprayPose(point,p.size*f32(grow*shrink),a)
struct SprayPose:
    point:WorldPoint
    size:vec3
    age:f64

# One frame of the bank: the old puffs age out, and each float in the water throws more.
# sheets are the curtains' smoothed state (splash_motion), targets this frame's raw wetness.
step_spray_bank=(bank:mut SprayBank,f:Flyer,model:CraftModel,sheets:SplashSheet[],targets:SplashSheet[],t:f64,w:Wind):
    dt=if bank.time<0.0 or t<bank.time:0.0 else:min(0.1,t-bank.time)
    if t<bank.time:bank=SprayBank()
    bank.time=t
    # (the dead ones out in place: a swap with the last, no new list each frame)
    i=0
    loop i<bank.puffs.len():
        if t-bank.puffs[i].born>=bank.puffs[i].life:
            bank.puffs[i]=bank.puffs[bank.puffs.len()-1];bank.puffs.pop()
        else:i+=1
    s=f.state
    sea=spray_sea(w)
    drift=vec3(w.dir.x,0,w.dir.y)*f32(w.speed*0.55)
    v=f64(length(s.velocity.xz))
    big=boat_spray_scale(f.kind)
    loop part in 0..7:
        sheet=sheets[part];now=targets[part]
        wet=now.amount>0.0
        # A float meeting the water while coming down: a touchdown (or the next of a bounce)
        # throws a burst all round it, bigger the harder it comes down and the faster it runs.
        if wet and not bank.wet[part] and sheet.run>0.05:
            sink=max(0.0,bank.lift[part])
            spray_burst(bank,f,model,part,now,t,sink,sea,drift)
        bank.wet[part]=wet
        bank.lift[part]=if wet:0.0 else: -f64(s.velocity.y)/pure_k(f.spec)
        if sheet.amount<0.05 or dt<=0.0:continue
        length=spray_part_length(f.kind,model,part)
        # (a flying boat's wingtip float digging in throws hard and to both sides)
        tip=is_boat(f.kind) and (part==int(PartId.left_float) or part==int(PartId.right_float))
        run=sheet.run
        strength=sheet.amount*smoothstep(0.05,0.85,run)*(1.0+0.6*sea)*(1.0+sheet.heave)*(if tip:1.4 else:1.0)
        if strength<0.05:continue
        # (one puff each time the float has run on by a little less than a puff's length, so the
        # bank is one continuous lumpy rope at any speed; small and low when only just planing)
        tall=spray_tall(length*big,run,strength,sea)
        # (at most fourteen a second from a float, the slow ones short-lived, so a twin-float run
        # keeps about a hundred alive)
        spacing=max(1.3,spray_radius(tall)*1.3)
        bank.credit[part]+=min(v/spacing,14.0)*dt
        loop bank.credit[part]>=1.0:
            bank.credit[part]-=1.0
            spray_run_puff(bank,sheet,length*big,run,strength,sea,tip,t,drift)
    spray_prop_mist(bank,f,model,t,dt,sea,drift)

# How tall a float's wall stands: taller than the float is long at full planing.
spray_tall=(length:f64,run:f64,strength:f64,sea:f64)->f64:length*(0.12+1.0*pow(run,1.6))*(0.85+0.35*sea)*clamp(strength,0.65,1.4)
spray_radius=(tall:f64)->f64:clamp(tall*0.42,0.45,2.4)

# A planing float's spray, thrown off its outer chine (both chines on a lone hull).
spray_run_puff=(bank:mut SprayBank,sheet:SplashSheet,length:f64,run:f64,strength:f64,sea:f64,tip:bool,t:f64,drift:vec3):
    h=spray_hash(bank.serial*7+3);h2=spray_hash(bank.serial*13+5);h3=spray_hash(bank.serial*5+11)
    side=if sheet.inner!=0.0 and not tip: -sheet.inner else:if h<0.5: -1.0 else:1.0
    along=splash_heading(-sheet.back)
    out=vec3(along.z,0,-along.x)*f32(-side)
    # (from the curtain's crest, a little aft of the float's step, at the sea)
    at=world_offset(sheet.root,sheet.back*f32(length*(0.25+0.35*h2))+out*f32(0.5+sheet.beam))
    at.y=f64(swell_at(at.x,at.z,t).x)
    # Taller than the float is long at full planing; lower and shorter when only just planing.
    # (now and then a bigger heap, so the bank has masses, not a row of equal balls)
    heap=if h3>0.8:1.35 else:0.8+0.4*h3
    tall=spray_tall(length,run,strength,sea)*heap
    life=1.8+1.8*run+1.2*h2+0.6*sea
    r=spray_radius(tall)
    size=vec3(f32(r*(0.8+0.3*h)),f32(r*(0.85+0.2*h3)),f32(r*(2.0+0.6*h2)))
    spray_throw(bank,at,out,along,drift,t,life,(1.5+3.5*run)*(0.8+0.4*h),f64(size.y)*0.75,length*0.15*run,size)
    # (a wall taller than one puff stands: more ride on top of it, each smaller and a little
    # further out, up to three)
    tiers=min(3,int(tall/(r*2.0)))
    base=f64(size.y)*0.75;top=size
    loop i in 0..tiers:
        base+=f64(top.y)*1.1;top=top*f32(0.78)
        spray_throw(bank,at,out,along,drift,t,life*(0.9-0.1*f64(i)),(1.5+3.5*run)*(0.95+0.2*f64(i)+0.3*h),base,length*0.15*run,top)

# A touchdown or bounce: a burst of lobes round the float that met the water.
spray_burst=(bank:mut SprayBank,f:Flyer,model:CraftModel,part:int,sheet:SplashSheet,t:f64,sink:f64,sea:f64,drift:vec3):
    length=spray_part_length(f.kind,model,part)*boat_spray_scale(f.kind)
    hard=clamp(sink/4.0,0.0,1.0)
    n=int(3.0+9.0*hard+3.0*sea)
    along=splash_heading(-sheet.back)
    across=vec3(along.z,0,-along.x)
    loop i in 0..n:
        bank.serial+=1
        h=spray_hash(bank.serial*3+1);h2=spray_hash(bank.serial*11+7)
        a=f64(i)/f64(n)*TAU+h
        out=normalize(across*f32(cos(a))+along*f32(0.6*sin(a)))
        if sheet.inner!=0.0 and f64(dot(out,across))*sheet.inner>0.3:out=normalize(out-across*f32(sheet.inner*1.2))
        at=world_offset(sheet.root,out*f32(0.6+sheet.beam))
        at.y=f64(swell_at(at.x,at.z,t).x)
        tall=min(length*(0.2+0.9*hard)*(0.7+0.6*h2)*(0.9+0.3*sea),8.0)
        r=spray_radius(tall)
        spray_throw(bank,at,out,along,drift,t,1.6+1.6*h2+1.2*hard,1.0+2.5*hard*h,f64(r*0.85)*0.75,0.0,vec3(f32(r),f32(r*0.85),f32(r*1.15)))

# In rough water a propeller low over the sea whips the crests into mist, blown aft by its wash.
spray_prop_mist=(bank:mut SprayBank,f:Flyer,model:CraftModel,t:f64,dt:f64,sea:f64,drift:vec3):
    s=f.state
    if dt<=0.0 or s.throttle<0.5 or sea<0.25 or s.crashed:return
    pose=craft_transform(f);rotation=pose;rotation[3]=vec4(0,0,0,1)
    anchor=flight_fx_anchor(f,pose)
    down=quat_rotate(s.orientation,vec3(0,-1,0))
    along=splash_heading(-quat_rotate(s.orientation,vec3(0,0,1)))
    loop i in 0..model.prop_hubs.len():
        hub=world_offset(anchor,transform_point(rotation,model.prop_hubs[i]))
        tip=world_offset(hub,down*f32(model.prop_radius))
        crest=f64(swell_at(tip.x,tip.z,t).x)
        clear=tip.y-crest
        # (within half a metre of the crests, worse the rougher it is)
        near=(1.0-smoothstep(0.0,0.5+0.8*sea,clear))*sea*f64(s.throttle)
        if near<0.05:continue
        bank.credit[7]+=near*14.0*dt
        loop bank.credit[7]>=1.0:
            bank.credit[7]-=1.0
            h=spray_hash(bank.serial*17+9)
            at=WorldPoint(tip.x,crest,tip.z)
            out=vec3(along.z,0,-along.x)*f32(if h<0.5: -1.0 else:1.0)
            r=0.35+0.3*h
            spray_throw(bank,at,out,along,drift,t,1.2+0.8*h,0.6+1.2*h,0.8+1.4*near,-6.0,vec3(f32(r),f32(r*0.8),f32(r*1.6)))

# The bank's bodies: one main lobe per puff, and a crown lobe on the bigger ones so the top edge
# is scalloped. Painted as the curtains' billows (two tones, lit tops, shaded undersides). A puff
# the camera is about to pass through shrinks away rather than filling the screen.
spray_bank_instances=(bank:SprayBank,origin:vec3,eye:vec3,t:f64,out:mut SplashInstance[]):
    loop p in bank.puffs:
        now=spray_puff_now(p,t)
        size=now.size
        if size.y<0.02:continue
        local=world_local(now.point,origin)
        # (the sea where it was thrown: it drifts a few metres at most, and its own swell is
        # less than its size, so no need to sample the waves again for every lobe every frame)
        sea=p.at.y
        # (sinking back, it shrinks into the water instead of being cut flat by it)
        under=clamp((sea-(now.point.y-f64(size.y)))/max(f64(size.y)*2.0,0.01),0.0,1.0)
        near=f64(length(local-eye))
        # (a lobe the camera is about to pass through shrinks away; beside the camera the walls
        # stand in full, as a spray wall filling the frame does)
        # (lower and thinner, but as long, so the bank stays one rope rather than separate balls)
        reach=f64(max(size.x,max(size.y,size.z)))
        give=smoothstep(reach*0.9+0.5,reach*1.8+3.0,near)
        # (and within the chase camera's few spans, lower: the walls frame the run beside it
        # without standing between the camera and the aircraft)
        low=mix(0.65,1.0,smoothstep(8.0,26.0,near))
        size*=vec3(f32(give),f32(give*low),f32(give))*f32(1.0-under)
        if size.y<0.02 or now.point.y+f64(size.y)<sea:continue
        roll=f32(p.phase+now.age*0.9)
        # (the big ones on the finer mesh, so a wall beside the camera keeps round lobes)
        kind=SPRAY_BIG
        out.push(SplashInstance(vec4(local,kind),vec4(size,roll),vec4(p.along,0)))
        if size.y>(if render_quality.tier==0:0.8 else:0.5):
            # (the crown: two or three lobes riding up out of the top, scalloping the bank's
            # upper edge; the inner face, toward the run, stays the flatter side)
            lobes=if render_quality.tier==0:1 else:if size.y>1.4:3 else:2
            loop k in 0..lobes:
                a=p.phase*1.7+f64(k)*2.1
                fa=(f64(k)+0.5)/f64(lobes)*2.0-1.0
                c=local+vec3(0,size.y*f32(0.5+0.12*sin(a)),0)+p.along*(size.z*f32(0.75*fa))+p.out*(size.x*f32(0.2+0.15*cos(a)))
                out.push(SplashInstance(vec4(c,kind),vec4(size*f32(0.5+0.08*sin(a*1.3)),roll+f32(k)*2.0+1.0),vec4(p.along,0)))
