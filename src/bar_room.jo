# The Hotel Ancora's bar room: the ground floor inside the hotel's walls, where the bar is of an
# evening and everything is when it rains. A stone arch across the room, the band's stand beyond it
# in a curtained corner with the piano, a long dark counter against a back bar of bottles with a
# mirror and a clock, tables under hanging lamps, palms in pots, and walls crowded with pictures,
# pinned papers, a propeller and a shelf of cups. Lit as a room is at night: warm pools under the
# lamps, deep brown corners (the light baked into the vertices' colours, as by day in the rain
# through the sea windows with the lamps lit). Built in the hotel's frame; drawn only with the camera
# inside, so it costs nothing outside.
#
# The places move, not the world: the terrace's places (src/bar_scene.jo HotelSpots) shift into the
# room when it is open, and whoever the world has at the terrace's tables, bar or stand is drawn at
# the same place in the room (room_place_folk). The world's band and patrons keep the terrace's
# places, so nothing in a save or a replay changes. The switch happens out of sight: never while the
# pilot sits at the hotel, and otherwise only with the camera well away (or on the way in).

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'walk_shapes.jo'
use 'town_sites.jo'
use 'bar_scene.jo'
from 'townsfolk.jo' import Folk

# ---------------- where things are (the hotel's frame) ----------------

const _RF = 1.22                    # the room's floor (DECK + 0.02, over the pier's stone)
const _RC = 5.05                    # its ceiling (DECK + 3.85)
const _RX = 10.7                    # the walls: x = +-_RX, z from _RZ0 to _RZ1
const _RZ0 = 6.3
const _RZ1 = 17.7

# The terrace's places, and where they are in the room: the bar along the land wall (the terrace's
# bar shifted, so the counter is still across from the stools the same way), the stand in the far
# corner behind the arch (the same way round), four tables and the pilot's by the sea window.
ROOM_BAR_SHIFT = vec3(6.2, 0, -12.0)
ROOM_STAGE_SHIFT = vec3(4.1, 0, -15.8)
TERRACE_TABLES = [vec3(-6.6, 0, 24.4), vec3(-2.2, 0, 24.4), vec3(2.2, 0, 24.4), vec3(6.6, 0, 24.4)]
ROOM_TABLES = [vec3(-3.6, 0, 15.0), vec3(-3.2, 0, 9.8), vec3(0.4, 0, 12.4), vec3(1.4, 0, 16.0)]
TERRACE_PLAYER_TABLE = vec3(10.6, 0, 27.6)
ROOM_PLAYER_TABLE = vec3(5.6, 0, 15.2)
_R_PASS = vec3(1.5, 0, 8.7)          # (the waiter waits by the counter's end)
ROOM_STAGE = vec3(-8.4, 0, 12.0)       # (the stand's middle: the terrace's, shifted)
_SEA_IN = vec3(0.0, 0, 17.0)         # (just inside each)
_SIDE_IN = vec3(10.0, 0, 15.0)
ROOM_ARCH_X = -5.4

_W_PLASTER = rgb(0.76, 0.69, 0.57)
_W_CEIL = rgb(0.6, 0.55, 0.47)
_W_WAINSCOT = rgb(0.3, 0.19, 0.11)
_W_BOARDS = rgb(0.47, 0.34, 0.23)
_W_DARK = rgb(0.24, 0.15, 0.09)
_W_WOOD = rgb(0.45, 0.29, 0.17)
_W_STONE = rgb(0.6, 0.54, 0.45)
_W_BRASS = rgb(0.72, 0.55, 0.27)
_W_GILT = rgb(0.66, 0.5, 0.24)
_W_CLOTH = rgb(0.9, 0.87, 0.8)
_W_CURTAIN = rgb(0.46, 0.13, 0.1)
_W_IRON = rgb(0.13, 0.13, 0.14)
_W_PAPER = rgb(0.86, 0.81, 0.68)
_W_MIRROR = rgb(0.4, 0.42, 0.41)
_W_PALM = rgb(0.25, 0.37, 0.17)
_W_POT = rgb(0.6, 0.36, 0.23)
_W_GLOW = rgba(1.0, 0.84, 0.56, 0.75)  # (alpha under 0.9: a lamp, lit)
_W_PANE = vec4(0.111, 0.222, 0.333, 1) # (a window's glass: night outside, or the rainy day)
_W_GLINT = vec4(0.111, 0.222, 0.334, 1) # (a lamp's reflection in it, at night)

# ---------------- the pieces ----------------

# a quad wound to face `n`
_bq = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, n: vec3, col: vec4):
    flip = f64(dot(cross(b - a, c - a), n)) < 0.0
    order = if flip: [a, c, b, a, d, c] else: [a, b, c, a, c, d]
    loop p in order: vs.push(Vertex3D(p, n, vec2(0, 0), col))

# A flat surface in tiles of about `tile` metres (so the baked light can pool on it), each tile's
# colour from `paint` (its row and column).
_bt = (vs: mut Vertex3D[], o: vec3, u: vec3, v: vec3, n: vec3, col: vec4, tile: f64, grain: int = 0):
    nu = max(1, int(f64(length(u)) / tile + 0.5)); nv = max(1, int(f64(length(v)) / tile + 0.5))
    du = u * f32(1.0 / f64(nu)); dv = v * f32(1.0 / f64(nv))
    loop i in 0..nu:
        loop j in 0..nv:
            p = o + u * f32(f64(i) / f64(nu)) + v * f32(f64(j) / f64(nv))
            k = if grain == 1: j else: if grain == 2: i * 7 + j * 13 else: 0
            jit = if grain == 0: 1.0 else: 0.92 + 0.16 * f64((k * 37 + 11) % 17) / 16.0
            c = vec4(f32(f64(col.x) * jit), f32(f64(col.y) * jit), f32(f64(col.z) * jit), col.w)
            _bq(vs, p, p + du, p + du + dv, p + dv, n, c)

# a box in pieces of about `piece` metres along its longest side, for the light to vary along it
_long_box = (vs: mut Vertex3D[], c: vec3, size: vec3, col: vec4, piece: f64 = 1.0):
    along_x = size.x >= size.z
    l = f64(if along_x: size.x else: size.z)
    n = max(1, int(l / piece + 0.5))
    loop k in 0..n:
        o = (f64(k) + 0.5) / f64(n) * l - l * 0.5
        if along_x: add_box(vs, c + vec3(f32(o), 0, 0), vec3(f32(l / f64(n)), size.y, size.z), col)
        else: add_box(vs, c + vec3(0, 0, f32(o)), vec3(size.x, size.y, f32(l / f64(n))), col)

# the way a thing hung on a wall faces (built facing +z)
_face = (n: vec3) -> f64: atan2(f64(n.x), f64(n.z))

_chair = (vs: mut Vertex3D[], at: vec3, toward: vec3):
    d = normalize(vec3(toward.x - at.x, 0, toward.z - at.z) + vec3(0.0001, 0, 0))
    m = translation(vec3(at.x, f32(_RF - 0.02), at.z)) * rotation_y(atan2(f64(d.x), f64(d.z)))
    add_box(vs, vec3(0, 0.45, 0), vec3(0.42, 0.04, 0.42), _W_WOOD, m)
    add_box(vs, vec3(0, 0.75, -0.2), vec3(0.42, 0.52, 0.04), _W_DARK, m)
    loop x in [-0.18, 0.18]:
        loop z in [-0.18, 0.18]: add_box(vs, vec3(f32(x), 0.22, f32(z)), vec3(0.035, 0.45, 0.035), _W_DARK, m)

_table = (vs: mut Vertex3D[], c: vec3, sx: f64, sz: f64):
    y = DECK + TABLE_TOP
    add_box(vs, vec3(c.x, f32(y - 0.02), c.z), vec3(f32(sx + 0.06), 0.04, f32(sz + 0.06)), _W_CLOTH)
    add_box(vs, vec3(c.x, f32(y - 0.16), c.z), vec3(f32(sx + 0.08), 0.24, f32(sz + 0.08)), rgb(0.86, 0.83, 0.76))
    add_cylinder(vs, vec3(c.x, f32(_RF - 0.02), c.z), 0.06, 0.62, _W_DARK, 6)
    add_cylinder(vs, vec3(c.x, f32(_RF - 0.02), c.z), 0.3, 0.04, _W_DARK, 8)

# a lamp hanging from the ceiling to `y`: its cord, a shade, the bulb's glow under it
_hanging = (vs: mut Vertex3D[], x: f64, y: f64, z: f64):
    add_cylinder(vs, vec3(f32(x), f32(y + 0.2), f32(z)), 0.008, _RC - y - 0.2, _W_IRON, 4)
    add_cylinder(vs, vec3(f32(x), f32(y), f32(z)), 0.26, 0.2, rgb(0.22, 0.3, 0.22), 10, 0.07)
    add_cylinder(vs, vec3(f32(x), f32(y - 0.02), f32(z)), 0.17, 0.06, _W_GLOW, 10, 0.2)

# a lamp on a wall: a bracket and a glass shade
_sconce = (vs: mut Vertex3D[], c: vec3, n: vec3):
    m = translation(c) * rotation_y(_face(n))
    add_box(vs, vec3(0, 0, 0.04), vec3(0.08, 0.18, 0.08), _W_BRASS, m)
    add_box(vs, vec3(0, 0.02, 0.16), vec3(0.03, 0.03, 0.2), _W_BRASS, m)
    add_cylinder(vs, vec3(0, 0.0, 0.26), 0.09, 0.2, _W_GLOW, 8, 0.06, m)

# A framed picture on a wall: `kind` 0 the sea under a sky, 1 an aircraft against the sky, 2 a
# photograph (a figure, sepia), 3 a chart of islands, 4 a group photograph.
_picture = (vs: mut Vertex3D[], c: vec3, n: vec3, w: f64, h: f64, kind: int, frame: vec4):
    m = translation(c) * rotation_y(_face(n))
    add_box(vs, vec3(0, 0, 0.02), vec3(f32(w), f32(h), 0.04), frame, m)
    iw = w - 0.1; ih = h - 0.1
    field = match kind:
        0: rgb(0.66, 0.64, 0.55)
        1: rgb(0.7, 0.69, 0.6)
        2: rgb(0.5, 0.42, 0.31)
        3: rgb(0.74, 0.67, 0.5)
        _: rgb(0.46, 0.4, 0.31)
    add_box(vs, vec3(0, 0, 0.045), vec3(f32(iw), f32(ih), 0.01), field, m)
    z = 0.052
    if kind == 0:
        add_box(vs, vec3(0, f32(-ih * 0.22), f32(z)), vec3(f32(iw), f32(ih * 0.44), 0.006), rgb(0.3, 0.38, 0.43), m)
        add_box(vs, vec3(f32(iw * 0.15), f32(-ih * 0.02), f32(z + 0.004)), vec3(f32(iw * 0.05), f32(ih * 0.3), 0.004), rgb(0.82, 0.78, 0.66), m)
    if kind == 1:
        # (a biplane, side on: fuselage, two wings, a tail)
        s = iw * 0.5
        add_box(vs, vec3(0, 0, f32(z)), vec3(f32(s), f32(ih * 0.06), 0.006), rgb(0.22, 0.2, 0.18), m)
        add_box(vs, vec3(f32(-s * 0.1), f32(ih * 0.09), f32(z)), vec3(f32(s * 0.42), f32(ih * 0.035), 0.006), rgb(0.22, 0.2, 0.18), m)
        add_box(vs, vec3(f32(-s * 0.1), f32(-ih * 0.05), f32(z)), vec3(f32(s * 0.42), f32(ih * 0.035), 0.006), rgb(0.22, 0.2, 0.18), m)
        add_box(vs, vec3(f32(s * 0.47), f32(ih * 0.06), f32(z)), vec3(f32(s * 0.08), f32(ih * 0.14), 0.006), rgb(0.22, 0.2, 0.18), m)
    if kind == 2 or kind == 4:
        loop k in 0..(if kind == 4: 4 else: 1):
            x = if kind == 4: (f64(k) - 1.5) * iw * 0.22 else: 0.0
            add_box(vs, vec3(f32(x), f32(-ih * 0.1), f32(z)), vec3(f32(iw * (if kind == 4: 0.14 else: 0.36)), f32(ih * 0.5), 0.006), rgb(0.66, 0.58, 0.45), m)
            add_box(vs, vec3(f32(x), f32(ih * 0.24), f32(z)), vec3(f32(iw * (if kind == 4: 0.08 else: 0.2)), f32(ih * (if kind == 4: 0.12 else: 0.22)), 0.006), rgb(0.72, 0.64, 0.5), m)
    if kind == 3:
        add_box(vs, vec3(0, 0, f32(z)), vec3(f32(iw * 0.9), f32(ih * 0.86), 0.004), rgb(0.5, 0.6, 0.62), m)
        loop k in 0..5:
            x = (f64((k * 37) % 9) / 9.0 - 0.45) * iw * 0.75; y = (f64((k * 53) % 7) / 7.0 - 0.42) * ih * 0.7
            add_box(vs, vec3(f32(x), f32(y), f32(z + 0.004)), vec3(f32(iw * (0.08 + 0.05 * f64(k % 3))), f32(ih * (0.06 + 0.04 * f64(k % 2))), 0.004), rgb(0.74, 0.64, 0.44), m)

# a crowd of small frames about `c` (photographs, a few pictures), as they gather on a bar's walls
_cluster = (vs: mut Vertex3D[], c: vec3, n: vec3, w: f64, h: f64, seed: int):
    side = vec3(n.z, 0, -n.x) * -1.0
    k = 0
    y = -h * 0.5
    loop y < h * 0.5 - 0.15:
        x = -w * 0.5 + 0.05 * f64((seed + k) % 3)
        row_h = 0.24 + 0.08 * f64((k * 3 + seed) % 3)
        loop x < w * 0.5 - 0.15:
            pw = 0.18 + 0.07 * f64((k * 5 + seed) % 4)
            ph = row_h - 0.04 * f64(k % 2)
            if x + pw > w * 0.5: break
            kind = [2, 4, 1, 2, 0, 3, 2, 4][(k * 7 + seed) % 8]
            frame = if (k + seed) % 3 == 0: _W_GILT else: _W_DARK
            _picture(vs, c + side * f32(x + pw * 0.5) + vec3(0, f32(y + ph * 0.5), 0), n, pw, ph, kind, frame)
            x += pw + 0.06 + 0.04 * f64(k % 2)
            k += 1
        y += row_h + 0.06

# pinned papers on a cork board: notices, a timetable, a photograph or two
_board = (vs: mut Vertex3D[], c: vec3, n: vec3, w: f64, h: f64):
    m = translation(c) * rotation_y(_face(n))
    add_box(vs, vec3(0, 0, 0.02), vec3(f32(w + 0.08), f32(h + 0.08), 0.04), _W_DARK, m)
    add_box(vs, vec3(0, 0, 0.045), vec3(f32(w), f32(h), 0.01), rgb(0.55, 0.4, 0.26), m)
    loop k in 0..11:
        x = (f64((k * 41) % 11) / 10.0 - 0.5) * w * 0.8
        y = (f64((k * 23) % 7) / 6.0 - 0.5) * h * 0.72
        pw = 0.16 + 0.08 * f64(k % 3); ph = 0.2 + 0.07 * f64((k + 1) % 3)
        col = if k % 5 == 2: rgb(0.4, 0.38, 0.34) else: if k % 4 == 1: rgb(0.8, 0.74, 0.58) else: _W_PAPER
        add_box(vs, vec3(0, 0, 0), vec3(f32(pw), f32(ph), 0.004), col, m * translation(vec3(f32(x), f32(y), f32(0.053 + 0.002 * f64(k % 3)))) * rotation_z(f64(k % 5 - 2) * 0.06))

_palm = (vs: mut Vertex3D[], at: vec3, size: f64, seed: int):
    base = vec3(at.x, f32(_RF - 0.02), at.z)
    add_cylinder(vs, base, 0.24 * size, 0.5 * size, _W_POT, 9, 0.3 * size)
    add_cylinder(vs, base + vec3(0, f32(0.48 * size), 0), 0.27 * size, 0.06, rgb(0.5, 0.3, 0.2), 9)
    top = base + vec3(0, f32(1.5 * size), 0)
    add_cylinder(vs, base + vec3(0, f32(0.5 * size), 0), 0.05 * size, 1.0 * size, rgb(0.36, 0.27, 0.17), 5, 0.035 * size)
    loop k in 0..9:
        a = f64(k) * 2.4 + f64(seed) * 0.7
        droop = 0.35 + 0.25 * f64((k + seed) % 3)
        col = if k % 2 == 0: _W_PALM else: rgb(0.19, 0.3, 0.14)
        add_box(vs, vec3(0, 0, f32(0.55 * size)), vec3(f32(0.2 * size), 0.02, f32(1.1 * size)), col, translation(top) * rotation_y(a) * rotation_x(droop))

_bottle = (vs: mut Vertex3D[], at: vec3, k: int):
    cols = [rgb(0.18, 0.32, 0.18), rgb(0.42, 0.24, 0.1), rgb(0.66, 0.66, 0.56), rgb(0.3, 0.16, 0.08), rgb(0.5, 0.14, 0.12), rgb(0.6, 0.48, 0.2)]
    h = 0.24 + 0.04 * f64((k * 7) % 3)
    col = cols[(k * 5 + k / 3) % cols.len()]
    add_cylinder(vs, at, 0.04, h, col, 5)
    add_cylinder(vs, at + vec3(0, f32(h), 0), 0.04, 0.05, col, 5, 0.014)
    add_cylinder(vs, at + vec3(0, f32(h + 0.05), 0), 0.014, 0.06, col, 4)

# ---------------- the room ----------------

build_bar_room = () -> Vertex3D[]:
    vs: Vertex3D[]
    w = _RX * 2.0; d = _RZ1 - _RZ0; hh = _RC - _RF
    # the floor in boards along the room, the ceiling, and the walls: dark wood to a rail, plaster above
    _bt(vs, vec3(f32(-_RX), f32(_RF), f32(_RZ0)), vec3(f32(w), 0, 0), vec3(0, 0, f32(d)), vec3(0, 1, 0), _W_BOARDS, 0.45, 1)
    _bt(vs, vec3(f32(-_RX), f32(_RC), f32(_RZ0)), vec3(f32(w), 0, 0), vec3(0, 0, f32(d)), vec3(0, -1, 0), _W_CEIL, 0.6)
    rail = 1.1
    walls = [(vec3(f32(-_RX), 0, f32(_RZ0)), vec3(f32(w), 0, 0), vec3(0, 0, 1)), (vec3(f32(-_RX), 0, f32(_RZ1)), vec3(f32(w), 0, 0), vec3(0, 0, -1)), (vec3(f32(-_RX), 0, f32(_RZ0)), vec3(0, 0, f32(d)), vec3(1, 0, 0)), (vec3(f32(_RX), 0, f32(_RZ0)), vec3(0, 0, f32(d)), vec3(-1, 0, 0))]
    # (the sea wall and the east wall each open in a doorway: the terrace's at x -0.8..0.8, the side
    # door's at z 14.4..15.6; the wall is laid either side of it and above it)
    door_top = HOTEL_DOOR_TOP
    loop k in 0..walls.len():
        wl = walls[k]
        o = wl.0 + vec3(0, f32(_RF), 0)
        total = f64(length(wl.1))
        dir = wl.1 * f32(1.0 / total)
        hole = if k == 1: vec2(f32(_RX - HOTEL_DOOR_HALF), f32(_RX + HOTEL_DOOR_HALF)) else: if k == 3: vec2(f32(14.4 - _RZ0), f32(15.6 - _RZ0)) else: vec2(-1, -1)
        spans = if hole.x < 0.0: [vec2(0, f32(total))] else: [vec2(0, hole.x), vec2(hole.y, f32(total))]
        loop sp in spans:
            a = o + dir * sp.x
            u = dir * (sp.y - sp.x)
            _bt(vs, a, u, vec3(0, f32(rail), 0), wl.2, _W_WAINSCOT, 0.4, 2)
            _bt(vs, a + vec3(0, f32(rail), 0), u, vec3(0, f32(hh - rail), 0), wl.2, _W_PLASTER, 0.4)
            # (the rail along the wainscot's top)
            mid = a + u * 0.5 + wl.2 * 0.02 + vec3(0, f32(rail), 0)
            size = if f64(abs(u.x)) > 0.1: vec3(u.x, 0.06, 0.05) else: vec3(0.05, 0.06, u.z)
            _long_box(vs, mid, vec3(f32(abs(f64(size.x))), size.y, f32(abs(f64(size.z)))), _W_DARK, 2.0)
        if hole.x >= 0.0:
            # (above the doorway, and its reveals through the wall: jambs and head, 0.3 m deep)
            a = o + dir * hole.x
            u = dir * (hole.y - hole.x)
            _bt(vs, a + vec3(0, f32(door_top), 0), u, vec3(0, f32(hh - door_top), 0), wl.2, _W_PLASTER, 0.4)
            out = wl.2 * -0.3
            # (the jambs 1.5 cm inside the opening: the walls' own ends are at its edges)
            _bt(vs, a + dir * 0.015, out, vec3(0, f32(door_top), 0), dir, _W_PLASTER, 0.3)
            _bt(vs, a + u - dir * 0.015, out, vec3(0, f32(door_top), 0), dir * -1.0, _W_PLASTER, 0.3)
            _bt(vs, a + vec3(0, f32(door_top), 0), u, out, vec3(0, -1, 0), _W_PLASTER, 0.3)
            # (a dark wood architrave round it inside)
            loop e in [0.0, 1.0]: add_box(vs, a + u * f32(e) + wl.2 * 0.03 + vec3(0, f32(door_top * 0.5), 0) + dir * f32(if e == 0.0: -0.05 else: 0.05), if f64(abs(dir.x)) > 0.5: vec3(0.1, f32(door_top + 0.1), 0.06) else: vec3(0.06, f32(door_top + 0.1), 0.1), _W_DARK)
            add_box(vs, a + u * 0.5 + wl.2 * 0.03 + vec3(0, f32(door_top + 0.05), 0), if f64(abs(dir.x)) > 0.5: vec3(f32(hole.y - hole.x + 0.2), 0.1, 0.06) else: vec3(0.06, 0.1, f32(hole.y - hole.x + 0.2)), _W_DARK)
    # beams across the ceiling
    loop x in [-9.6, -7.2, -3.0, -0.6, 1.8, 4.2, 6.6, 9.0]:
        _long_box(vs, vec3(f32(x), f32(_RC - 0.15), f32((_RZ0 + _RZ1) * 0.5)), vec3(0.24, 0.3, f32(d)), _W_DARK, 1.6)

    # the stone arch across the room: rough piers at the walls and a low elliptical arch between,
    # the wall above it plastered up to the ceiling
    loop pier in [(_RZ0, 7.5), (16.5, _RZ1)]:
        y = _RF
        k = 0
        loop y < _RC - 0.01:
            ch = min(0.32 + 0.1 * f64(k % 3), _RC - y)
            inset = if k % 2 == 0: 0.0 else: 0.04
            shade = 0.9 + 0.12 * f64((k * 7 + int(pier.0)) % 5) / 4.0
            col = vec4(f32(f64(_W_STONE.x) * shade), f32(f64(_W_STONE.y) * shade), f32(f64(_W_STONE.z) * shade), 1)
            add_box(vs, vec3(f32(ROOM_ARCH_X), f32(y + ch * 0.5), f32((pier.0 + pier.1) * 0.5)), vec3(f32(0.84 - inset), f32(ch - 0.01), f32(pier.1 - pier.0 - inset)), col)
            y += ch; k += 1
    spring = DECK + 2.25; rise = 1.35; half = 4.5; zc = 12.0
    segs = 18
    loop k in 0..segs:
        a0 = PI - PI * f64(k) / f64(segs); a1 = PI - PI * f64(k + 1) / f64(segs)
        p0 = vec2(f32(zc + half * cos(a0)), f32(spring + rise * sin(a0)))
        p1 = vec2(f32(zc + half * cos(a1)), f32(spring + rise * sin(a1)))
        mid = (p0 + p1) * 0.5
        dl = p1 - p0
        shade = 0.88 + 0.14 * f64((k * 5) % 4) / 3.0
        col = vec4(f32(f64(_W_STONE.x) * shade), f32(f64(_W_STONE.y) * shade), f32(f64(_W_STONE.z) * shade), 1)
        add_box(vs, vec3(0, 0, 0), vec3(0.86, 0.42, f32(f64(length(dl)) + 0.02)), col, translation(vec3(f32(ROOM_ARCH_X), mid.y + 0.21, mid.x)) * rotation_x(-atan2(f64(dl.y), f64(dl.x))))
        top = max(f64(p0.y), f64(p1.y)) + 0.35
        if top < _RC: add_box(vs, vec3(f32(ROOM_ARCH_X), f32((top + _RC) * 0.5), mid.x), vec3(0.8, f32(_RC - top), f32(abs(f64(dl.x)) + 0.01)), _W_PLASTER)

    # the band's stand in the far corner: a low platform, the upright piano against the wall, its
    # bench, the singer's microphone; a heavy curtain behind, on the end wall
    s = vec3(ROOM_STAGE.x, f32(DECK), ROOM_STAGE.z)
    _bt(vs, s + vec3(-2.1, 0.3, -2.8), vec3(4.2, 0, 0), vec3(0, 0, 5.6), vec3(0, 1, 0), rgb(0.4, 0.26, 0.16), 0.5, 1)
    loop side in [-1.0, 1.0]: _long_box(vs, s + vec3(0, 0.15, f32(side * 2.8)), vec3(4.2, 0.3, 0.02), _W_DARK, 1.0)
    _long_box(vs, s + vec3(2.1, 0.15, 0), vec3(0.02, 0.3, 5.6), _W_DARK, 1.0)
    stand_things(vs, s + vec3(0, 0.3, 0), _W_IRON)
    loop k in 0..17:
        z = 8.7 + f64(k) * 0.4
        col = if k % 2 == 0: _W_CURTAIN else: rgb(0.36, 0.1, 0.08)
        _long_box(vs, vec3(f32(-_RX + 0.08 + (if k % 2 == 0: 0.0 else: 0.06)), f32(_RF + 1.8), f32(z)), vec3(0.08, 3.56, 0.42), col, 0.9)
    _long_box(vs, vec3(f32(-_RX + 0.2), f32(_RC - 0.3), 12.0), vec3(0.12, 0.5, 7.2), rgb(0.38, 0.11, 0.09), 1.0)

    # the bar: a long dark counter with a pale top and a brass foot rail, stools; behind it a
    # cabinet, shelves of bottles either side of a gilt mirror, a clock above
    bc = vec3(f32(ROOM_BAR_SHIFT.x), 0, f32(20.0 + f64(ROOM_BAR_SHIFT.z)))
    _long_box(vs, vec3(bc.x, f32(DECK + 0.55), bc.z), vec3(8.0, 1.1, 0.7), rgb(0.28, 0.17, 0.1), 0.8)
    _long_box(vs, vec3(bc.x, f32(DECK + 1.12), bc.z), vec3(8.2, 0.05, 0.85), rgb(0.5, 0.49, 0.46), 0.8)
    _long_box(vs, vec3(bc.x, f32(DECK + 0.6), f32(f64(bc.z) + 0.36)), vec3(7.8, 0.12, 0.03), _W_DARK, 0.8)
    _long_box(vs, vec3(bc.x, f32(DECK + 0.18), f32(f64(bc.z) + 0.5)), vec3(8.0, 0.04, 0.04), _W_BRASS, 1.0)
    loop x in BAR_STOOLS_X:
        bar_stool(vs, vec3(f32(x + f64(ROOM_BAR_SHIFT.x)), f32(DECK), f32(20.85 + f64(ROOM_BAR_SHIFT.z))), _W_IRON)
    _long_box(vs, vec3(bc.x, f32(DECK + 0.5), f32(_RZ0 + 0.24)), vec3(8.2, 1.0, 0.48), _W_DARK, 0.8)
    _long_box(vs, vec3(bc.x, f32(DECK + 1.02), f32(_RZ0 + 0.26)), vec3(8.3, 0.04, 0.52), _W_WOOD, 0.8)
    add_box(vs, vec3(bc.x, f32(DECK + 1.95), f32(_RZ0 + 0.03)), vec3(1.75, 1.35, 0.05), _W_GILT)
    add_box(vs, vec3(bc.x, f32(DECK + 1.95), f32(_RZ0 + 0.06)), vec3(1.55, 1.15, 0.02), _W_MIRROR)
    # (the glass's sheen: two pale streaks across it)
    loop k in 0..2:
        add_box(vs, vec3(0, 0, 0), vec3(f32(0.05 + 0.05 * f64(k)), 1.15, 0.006), rgb(0.5, 0.52, 0.5), translation(vec3(f32(f64(bc.x) - 0.25 + f64(k) * 0.32), f32(DECK + 1.95), f32(_RZ0 + 0.075))) * rotation_z(0.5))
    loop shelf in 0..3:
        y = DECK + 1.42 + f64(shelf) * 0.42
        loop part in [-1.0, 1.0]:
            cx = f64(bc.x) + part * 2.6
            _long_box(vs, vec3(f32(cx), f32(y), f32(_RZ0 + 0.13)), vec3(2.9, 0.04, 0.26), _W_WOOD, 1.0)
            loop k in 0..9:
                _bottle(vs, vec3(f32(cx - 1.3 + f64(k) * 0.32), f32(y + 0.02), f32(_RZ0 + 0.14)), k + shelf * 9 + int(part + 1.0) * 31)
    # (the clock: a round face in a dark rim, its hands at a quarter to ten)
    cm = translation(vec3(bc.x, f32(DECK + 3.05), f32(_RZ0 + 0.02))) * rotation_x(PI * 0.5)
    add_cylinder(vs, vec3(0, 0, 0), 0.25, 0.06, _W_DARK, 14, -1.0, cm)
    add_cylinder(vs, vec3(0, 0.06, 0), 0.21, 0.01, rgb(0.88, 0.84, 0.72), 14, -1.0, cm)
    add_box(vs, vec3(-0.06, 0.075, -0.02), vec3(0.13, 0.008, 0.016), _W_IRON, cm * rotation_y(0.4))
    add_box(vs, vec3(0.0, 0.075, -0.08), vec3(0.016, 0.008, 0.17), _W_IRON, cm)
    # (on the counter: a siphon, glasses, a dish)
    loop k in 0..5:
        x = f64(bc.x) - 3.2 + f64(k) * 1.55
        add_cylinder(vs, vec3(f32(x), f32(DECK + 1.15), f32(f64(bc.z) - 0.15)), 0.035, 0.1, rgb(0.72, 0.74, 0.7), 6)
    add_cylinder(vs, vec3(f32(f64(bc.x) + 1.9), f32(DECK + 1.15), f32(f64(bc.z) - 0.2)), 0.05, 0.3, rgb(0.3, 0.42, 0.45), 7)

    # the tables under their lamps, with chairs; the pilot's small table by the sea window
    loop c in ROOM_TABLES:
        _table(vs, c, 0.95, 1.6)
        loop seat in [vec3(-0.85, 0, 0), vec3(0.85, 0, 0), vec3(0, 0, -1.25), vec3(0, 0, 1.25)]: _chair(vs, c + seat, c)
    _table(vs, ROOM_PLAYER_TABLE, 0.9, 0.9)
    loop dx in [0.85, -0.85]: _chair(vs, ROOM_PLAYER_TABLE + vec3(f32(dx), 0, 0), ROOM_PLAYER_TABLE)

    # palms in pots
    _palm(vs, vec3(-1.5, 0, 7.0), 1.0, 1)
    _palm(vs, vec3(10.1, 0, 17.05), 1.15, 2)
    _palm(vs, vec3(-4.3, 0, 17.05), 0.95, 3)
    _palm(vs, vec3(-7.1, 0, 16.7), 1.2, 4)

    # the sea wall: the doorway to the terrace (above), a window either side with curtains
    sea = vec3(0, 0, -1)
    zs = f32(_RZ1 - 0.02)
    loop x in [-8.2, 8.2]:
        add_box(vs, vec3(f32(x), f32(DECK + 1.6), zs), vec3(3.0, 2.6, 0.03), _W_PANE)
        # (the room's lamps, faint in the night glass)
        loop k in 0..2: add_box(vs, vec3(f32(x - 0.9 + f64(k) * 1.5), f32(DECK + 2.25 - 0.3 * f64(k)), f32(_RZ1 - 0.04)), vec3(0.2, 0.12, 0.01), _W_GLINT)
        loop dx in [-1.5, -0.5, 0.5, 1.5]: add_box(vs, vec3(f32(x + dx), f32(DECK + 1.6), f32(_RZ1 - 0.05)), vec3(0.08, 2.66, 0.08), _W_DARK)
        loop dy in [-1.3, 0.2, 1.3]: add_box(vs, vec3(f32(x), f32(DECK + 1.6 + dy), f32(_RZ1 - 0.05)), vec3(3.08, 0.08, 0.08), _W_DARK)
        loop side in [-1.0, 1.0]: _long_box(vs, vec3(f32(x + side * 1.75), f32(DECK + 1.75), f32(_RZ1 - 0.12)), vec3(0.5, 3.1, 0.1), rgb(0.55, 0.42, 0.24), 0.8)
    # the end walls' windows (the east, by the bar's end) and the side door
    add_box(vs, vec3(f32(_RX - 0.02), f32(DECK + 1.8), 9.0), vec3(0.03, 1.8, 1.1), _W_PANE)
    loop dz in [-0.58, 0.58]: add_box(vs, vec3(f32(_RX - 0.05), f32(DECK + 1.8), f32(9.0 + dz)), vec3(0.08, 1.9, 0.08), _W_DARK)
    # the land wall: the door to the hotel's hall, with a curtain across
    add_box(vs, vec3(0, f32(DECK + 1.35), f32(_RZ0 + 0.02)), vec3(1.5, 2.7, 0.03), rgb(0.1, 0.07, 0.05))
    _long_box(vs, vec3(0, f32(DECK + 1.4), f32(_RZ0 + 0.09)), vec3(1.4, 2.6, 0.06), rgb(0.42, 0.14, 0.11), 0.7)
    loop x in [-0.8, 0.8]: add_box(vs, vec3(f32(x), f32(DECK + 1.4), f32(_RZ0 + 0.05)), vec3(0.1, 2.8, 0.08), _W_DARK)

    # the walls covered with things
    land = vec3(0, 0, 1)
    zl = f32(_RZ0 + 0.01)
    _board(vs, vec3(-3.0, f32(DECK + 1.75), zl), land, 1.5, 0.95)
    _picture(vs, vec3(-1.6, f32(DECK + 2.2), zl), land, 0.45, 0.6, 2, _W_DARK)
    _picture(vs, vec3(-4.4, f32(DECK + 2.55), zl), land, 0.5, 0.4, 4, _W_GILT)
    # (a shelf of cups, races won)
    add_box(vs, vec3(-3.0, f32(DECK + 2.82), f32(_RZ0 + 0.12)), vec3(1.4, 0.04, 0.24), _W_WOOD)
    loop k in 0..4:
        x = -3.5 + f64(k) * 0.34
        add_cylinder(vs, vec3(f32(x), f32(DECK + 2.84), f32(_RZ0 + 0.13)), 0.05, 0.05, _W_DARK, 6)
        add_cylinder(vs, vec3(f32(x), f32(DECK + 2.89), f32(_RZ0 + 0.13)), 0.015, 0.08 + 0.03 * f64(k % 2), _W_BRASS, 5)
        add_cylinder(vs, vec3(f32(x), f32(DECK + 2.97 + 0.03 * f64(k % 2)), f32(_RZ0 + 0.13)), 0.03, 0.12, _W_BRASS, 7, 0.08)
    # (a propeller, its blades varnished, over the stand's end of the room)
    pm = translation(vec3(-8.0, f32(DECK + 2.7), f32(_RZ0 + 0.06))) * rotation_z(0.42)
    add_cylinder(vs, vec3(0, 0, 0), 0.09, 0.1, _W_BRASS, 8, -1.0, pm * rotation_x(PI * 0.5))
    loop side in [-1.0, 1.0]:
        add_box(vs, vec3(f32(side * 0.62), 0, 0), vec3(1.1, 0.13, 0.04), rgb(0.5, 0.31, 0.16), pm)
        add_box(vs, vec3(f32(side * 1.1), 0, 0), vec3(0.14, 0.135, 0.045), _W_BRASS, pm)
    _picture(vs, vec3(-9.7, f32(DECK + 1.75), zl), land, 0.62, 0.48, 1, _W_DARK)
    _picture(vs, vec3(-6.6, f32(DECK + 1.85), zl), land, 0.5, 0.68, 0, _W_GILT)
    _picture(vs, vec3(-6.9, f32(DECK + 2.95), zl), land, 0.4, 0.32, 2, _W_DARK)
    zsw = f32(_RZ1 - 0.01)
    _board(vs, vec3(-9.9, f32(DECK + 1.9), zsw), sea, 0.9, 1.1)
    _cluster(vs, vec3(-8.4, f32(DECK + 1.0), zl), land, 1.4, 0.55, 3)
    _cluster(vs, vec3(-3.6, f32(DECK + 2.3), zsw), sea, 1.9, 1.3, 5)
    _cluster(vs, vec3(3.9, f32(DECK + 2.25), zsw), sea, 1.7, 1.2, 9)
    east = vec3(-1, 0, 0)
    xe = f32(_RX - 0.01)
    _cluster(vs, vec3(xe, f32(DECK + 2.2), 16.5), east, 1.2, 1.4, 11)
    _cluster(vs, vec3(xe, f32(DECK + 3.05), 11.3), east, 1.4, 0.55, 13)
    _picture(vs, vec3(xe, f32(DECK + 2.0), 12.0), east, 1.5, 1.05, 3, _W_DARK)
    _picture(vs, vec3(xe, f32(DECK + 2.25), 10.4), east, 0.42, 0.55, 2, _W_GILT)
    _picture(vs, vec3(xe, f32(DECK + 1.8), 13.5), east, 0.5, 0.4, 1, _W_DARK)

    # the lamps: one over each table, two over the counter, two over the stand, on the walls
    loop c in ROOM_TABLES: _hanging(vs, f64(c.x), DECK + 2.5, f64(c.z))
    _hanging(vs, f64(ROOM_PLAYER_TABLE.x), DECK + 2.45, f64(ROOM_PLAYER_TABLE.z))
    loop x in [4.2, 8.2]: _hanging(vs, x, DECK + 2.55, f64(bc.z))
    loop z in [10.6, 13.4]: _hanging(vs, f64(ROOM_STAGE.x) + 0.4, DECK + 3.0, z)
    loop x in [-2.0, 2.0, -6.4, 6.4]: _sconce(vs, vec3(f32(x), f32(DECK + 2.3), f32(_RZ1)), sea)
    loop x in [-1.4, -8.8]: _sconce(vs, vec3(f32(x), f32(DECK + 2.35), f32(_RZ0)), land)
    loop z in [10.9, 14.2]: _sconce(vs, vec3(f32(_RX), f32(DECK + 2.3), f32(z)), east)
    vs

# what lights the room (the hotel's frame): xyz the lamp, w its strength (a hanging lamp's shade
# throws its light down; a wall lamp's, negative, all round)
_room_lamps = () -> vec4[]:
    out: vec4[]
    loop c in ROOM_TABLES: out.push(vec4(c.x, f32(DECK + 2.42), c.z, 1.25))
    out.push(vec4(ROOM_PLAYER_TABLE.x, f32(DECK + 2.37), ROOM_PLAYER_TABLE.z, 1.2))
    loop x in [4.2, 8.2]: out.push(vec4(f32(x), f32(DECK + 2.47), f32(20.0 + f64(ROOM_BAR_SHIFT.z)), 1.0))
    out.push(vec4(f32(ROOM_BAR_SHIFT.x), f32(DECK + 3.3), f32(_RZ0 + 0.9), 0.3))
    loop z in [10.6, 13.4]: out.push(vec4(f32(f64(ROOM_STAGE.x) + 0.4), f32(DECK + 2.92), f32(z), 1.2))
    loop x in [-2.0, 2.0, -6.4, 6.4]: out.push(vec4(f32(x), f32(DECK + 2.3), f32(_RZ1 - 0.3), -0.45))
    loop x in [-1.4, -8.8]: out.push(vec4(f32(x), f32(DECK + 2.35), f32(_RZ0 + 0.3), -0.45))
    loop z in [10.9, 14.2]: out.push(vec4(f32(_RX - 0.3), f32(DECK + 2.3), f32(z), -0.45))
    out
ROOM_LAMPS = _room_lamps()
# the windows, by day
ROOM_WINDOWS = [vec3(-8.2, 2.8, 17.4), vec3(8.2, 2.8, 17.4), vec3(0.0, 2.6, 17.4), vec3(10.4, 3.0, 9.0)]

# Each vertex's colour as the room is lit: of an evening (`day` false: the lamps' warm pools and
# the dark beyond them), or on a rainy day (the windows' grey light, the lamps lit too). Lamps'
# glowing shades keep their own colour; the windows' glass shows the night, or the day.
bake_bar_room = (vs: Vertex3D[], day: bool, centre: vec3 = vec3(0, 0, 0)) -> Vertex3D[]:
    out: Vertex3D[]
    warm = vec3(1.0, 0.85, 0.66)
    cool = vec3(0.72, 0.8, 0.9)
    amb = if day: vec3(0.17, 0.17, 0.18) else: vec3(0.09, 0.075, 0.06)
    lamp_k = if day: 3.4 else: 6.4
    loop v in vs:
        if v.color.w < 0.9:
            out.push(v)
            continue
        if v.color == _W_PANE or v.color == _W_GLINT:
            night = if v.color == _W_GLINT: rgb(0.24, 0.17, 0.1) else: rgb(0.04, 0.055, 0.09)
            out.push(Vertex3D(v.pos, v.normal, v.uv, if day: rgb(0.62, 0.66, 0.7) else: night))
            continue
        p = v.pos + centre
        n = v.normal
        light = amb * f32(0.85 + 0.15 * f64(n.y))
        loop l in ROOM_LAMPS:
            to = l.xyz - p
            d = f64(length(to))
            if d > 7.6: continue             # (beyond four reaches: under a two-hundredth)
            face = 0.22 + 0.78 * max(0.0, f64(dot(n, to / f32(max(d, 0.001)))))
            r = d / 1.9
            fall = 1.0 / ((1.0 + r * r) * (1.0 + r * r))
            # (under a shade: strongest straight down, little to the side, none up)
            cone = if f64(l.w) > 0.0: 0.12 + 0.88 * smoothstep(0.05, 0.75, f64(to.y) / max(d, 0.001)) else: 1.0
            light = light + warm * f32(lamp_k * abs(f64(l.w)) * fall * face * cone)
        if day:
            loop wv in ROOM_WINDOWS:
                to = wv - p
                d = f64(length(to))
                face = 0.3 + 0.7 * max(0.0, f64(dot(n, to / f32(max(d, 0.001)))))
                light = light + cool * f32(1.5 / (1.0 + (d / 3.2) * (d / 3.2)) * face)
        # (a soft shoulder, so a pool's middle doesn't burn out to a flat colour)
        top = max(f64(light.x), max(f64(light.y), f64(light.z)))
        c = v.color.xyz * light * f32(1.0 / (1.0 + 0.32 * top))
        out.push(Vertex3D(v.pos, v.normal, v.uv, vec4(min(c.x, 1.0), min(c.y, 1.0), min(c.z, 1.0), v.color.w)))
    out

# a ceiling fan's blades, about its hub (turned as it is drawn)
_fan = () -> Vertex3D[]:
    vs: Vertex3D[]
    add_cylinder(vs, vec3(0, 0, 0), 0.1, 0.14, _W_BRASS, 8)
    add_cylinder(vs, vec3(0, 0.14, 0), 0.015, _RC - (DECK + 3.3) - 0.14, _W_IRON, 4)
    loop k in 0..4:
        add_box(vs, vec3(0, 0, 0), vec3(0.16, 0.015, 0.75), _W_WOOD, rotation_y(f64(k) * PI * 0.5) * translation(vec3(0, 0.03, 0.47)) * rotation_z(0.12))
    vs
ROOM_FANS = [vec3(-1.4, 4.5, 12.4), vec3(3.6, 4.5, 11.6)]

# ---------------- the room's state ----------------

struct BarRoom:
    level = 0                       # 0 the terrace (as built), 1 the bar inside, 2 everything inside
    settled = false
    raw: Vertex3D[] = []            # (the room unlit, built when first seen)
    meshes: Mesh?[] = [none, none]  # (the evening's and the rainy day's, each baked when first wanted)
    fans: Mesh?[] = [none, none]
bar_room = BarRoom()

# What the weather wants: the terrace on any evening it isn't raining (its sky and the sea are its
# charm); everything inside while it rains (once in, until it has all but stopped). (1, the bar
# alone inside, is kept for AEGEAN_ROOM captures.)
room_level = (hour: f64, rain: f64, storm: f64, was: int) -> int:
    if let forced = env("AEGEAN_ROOM"): return clamp(int(to_float(forced) ?? 0.0), 0, 2)
    raining = if was == 2: rain > 0.06 or storm > 0.05 else: rain > 0.22 or storm > 0.15
    if raining: 2 else: 0

_rw = (f: mat4, d: vec3) -> vec3: (f * vec4(d, 0)).xyz

# Moves the hotel's places to fit `level` (from the terrace's, as built).
room_settle = (h: mut HotelScene, level: int):
    global bar_room
    if bar_room.settled and level == bar_room.level: return
    bar_room.settled = true
    bar_room.level = level
    if not h.ok: return
    # (the player's own table again, as built, its facing and axes too, before the level's places)
    hotel_take_table(h, hotel_table_count() - 1, 0)
    s = room_spots(h.built, h.frame, level)
    h.counter = s.counter; h.bar_back = s.bar_back; h.bar_rest = s.bar_rest; h.stools = s.stools
    h.seat = s.seat; h.table = s.table; h.waiter_serve = s.waiter_serve; h.waiter_pass = s.waiter_pass
    h.stage = s.stage

# The places for `level`, from the terrace's as built (`f` the hotel's frame).
room_spots = (b: HotelSpots, f: mat4, level: int) -> HotelSpots:
    out = b
    bar = if level >= 1: _rw(f, ROOM_BAR_SHIFT) else: vec3(0, 0, 0)
    out.counter = b.counter + bar; out.bar_back = b.bar_back + bar; out.bar_rest = b.bar_rest + bar
    out.stools = [loop s in b.stools: s + bar]
    inside = level == 2
    tab = if inside: _rw(f, ROOM_PLAYER_TABLE - TERRACE_PLAYER_TABLE) else: vec3(0, 0, 0)
    out.seat = b.seat + tab; out.table = b.table + tab; out.waiter_serve = b.waiter_serve + tab
    out.waiter_pass = if inside: transform_point(f, _R_PASS + vec3(0, f32(DECK), 0)) else: b.waiter_pass
    out.stage = b.stage + (if inside: _rw(f, ROOM_STAGE_SHIFT) else: vec3(0, 0, 0))
    out

# A frame's step: the places moved to what the hour and the weather want, out of sight (not while
# the pilot sits at the hotel; otherwise with the camera well away, or at first).
room_step = (h: mut HotelScene, hour: f64, rain: f64, storm: f64, seated: bool, cam: vec3):
    if not h.ok: return
    want = room_level(hour, rain, storm, bar_room.level)
    if want == bar_room.level and bar_room.settled: return
    if not seated and (not bar_room.settled or f64(length(cam - h.origin)) > 70.0): room_settle(h, want)

# Going in (by a door, a cut): the places as they should be now, whoever is watching.
room_go_in = (h: mut HotelScene, hour: f64, rain: f64, storm: f64):
    room_settle(h, room_level(hour, rain, storm, bar_room.level))

# ---------------- the way in and out ----------------

_flat = (a: vec3, b: vec3) -> f64: f64(length(vec2(a.x - b.x, a.z - b.z)))

# Where someone coming to a seat inside from outside first appears: just inside the door nearer them.
room_way_in = (h: HotelScene, seat: vec3, from: vec3) -> vec3:
    if not room_point_inside(h, seat) or room_point_inside(h, from): return from
    sea = transform_point(h.frame, _SEA_IN + vec3(0, f32(_RF), 0))
    side = transform_point(h.frame, _SIDE_IN + vec3(0, f32(_RF), 0))
    if _flat(from, sea) < _flat(from, side): sea else: side

# the room's floor, for walking heights (the walls are published as solids, open at the doorways)
room_floor_sites = (h: HotelScene) -> TownSite[]:
    yaw = atan2(f64(h.table_z.x), f64(h.table_z.z))
    # (the building's whole footprint, so the floor runs through the doorways' thickness too)
    [TownSite(transform_point(h.frame, vec3(0, f32(_RF), 12.0)), yaw, 22.0, 12.0, 0.1, 0)]

# What one can't walk through in the room (the hotel's frame): the tables, the counter and the
# back bar, the stand and its piano, the arch's piers, the palms. (Chairs and stools stay open:
# they are sat on.)
room_solids = (h: HotelScene) -> TownSite[]:
    yaw = atan2(f64(h.table_z.x), f64(h.table_z.z))
    box = (c: vec3, w: f64, d: f64, height: f64) -> TownSite: TownSite(transform_point(h.frame, vec3(c.x, f32(DECK), c.z)), yaw, w, d, height, 0)
    out: TownSite[]
    loop c in ROOM_TABLES: out.push(box(c, 0.95, 1.6, TABLE_TOP))
    out.push(box(ROOM_PLAYER_TABLE, 0.9, 0.9, TABLE_TOP))
    out.push(box(vec3(f32(ROOM_BAR_SHIFT.x), 0, f32(20.0 + f64(ROOM_BAR_SHIFT.z))), 8.2, 0.85, 1.15))
    out.push(box(vec3(f32(ROOM_BAR_SHIFT.x), 0, f32(_RZ0 + 0.24)), 8.3, 0.5, 2.8))
    out.push(box(ROOM_STAGE, 4.2, 5.6, 1.6))
    loop z in [6.9, 17.1]: out.push(box(vec3(f32(ROOM_ARCH_X), 0, f32(z)), 0.84, 1.2, 4.0))
    loop p in [vec3(-1.5, 0, 7.0), vec3(10.1, 0, 17.05), vec3(-4.3, 0, 17.05), vec3(-7.1, 0, 16.7)]: out.push(box(p, 0.6, 0.6, 2.0))
    out

# ---------------- the world's people, in the room ----------------

# From a place on the terrace (the hotel's frame) to the same place in the room: at a table, at the
# bar, by the stand. none: walking across the terrace (not drawn: going in).
room_shift_of = (q: vec3) -> vec3?:
    loop k in 0..4:
        if _flat(q, TERRACE_TABLES[k]) < 2.4: return ROOM_TABLES[k] - TERRACE_TABLES[k]
    if _flat(q, TERRACE_PLAYER_TABLE) < 1.6: return ROOM_PLAYER_TABLE - TERRACE_PLAYER_TABLE
    if f64(q.x) < -9.0 and f64(q.z) > 23.5: return ROOM_STAGE_SHIFT
    if f64(q.z) < 21.6 and abs(f64(q.x)) < 5.0: return ROOM_BAR_SHIFT
    none

# With everything inside, whoever the world has on the terrace is drawn (and found, talked to,
# invited) at the same place in the room.
room_place_folk = (folks: mut Folk[], h: HotelScene):
    if bar_room.level != 2 or not h.ok: return
    back = inverse(h.frame)
    loop mut f in folks:
        if not f.shown or f.place != 0: continue
        q = transform_point(back, f.pos)
        if f64(q.z) < 18.0 or f64(q.z) > 31.4 or abs(f64(q.x)) > 15.3 or f64(q.y) > 4.0: continue
        if let s = room_shift_of(q):
            f.pos = f.pos + _rw(h.frame, s)
            f.published = f.pos
        else: f.shown = false

# ---------------- drawn ----------------

# The light the room's baked colours are drawn in: flat, so they show as baked; the sun "below the
# horizon", so its lamps glow.
_room_mesh_light = (L: Light) -> Light:
    out = L
    out.sun_dir = normalize(vec3(0.2, -1.0, 0.3))
    out.sun = vec3(f32(1.0 / 1.02), 1.0, f32(1.0 / 0.94))
    out.shade = (vec3(1, 1, 1) - vec3(0.06, 0.07, 0.09)) * f32(1.0 / 1.12)
    out.fog_density = 0.0
    out

_room_mesh = (k: int) -> Mesh:
    global bar_room
    if let m = bar_room.meshes[k]: return m
    if bar_room.raw.len() == 0: bar_room.raw = build_bar_room()
    m = custom_mesh(bake_bar_room(bar_room.raw, k == 1))
    bar_room.meshes[k] = m
    bar_room.fans[k] = custom_mesh(bake_bar_room(_fan(), k == 1, ROOM_FANS[0]))
    m

# The room, whenever one is near enough to walk in or see into it through its doorways (lit for
# the evening, or by the day's light by day): within 30 m of its middle.
draw_bar_room = (h: HotelScene, L: Light, t: f64):
    if not h.ok or f64(length(scene_camera() - transform_point(h.frame, vec3(0, f32(DECK + 1.5), 12)))) > 30.0: return
    k = if f64(normalize(L.sun_dir).y) < 0.12: 0 else: 1
    room = _room_mesh(k)
    Lr = _room_mesh_light(L)
    p = obj_params(Lr, t, h.frame)
    p.wet = 0.0
    draw(obj_sh, room, p)
    if let fan = bar_room.fans[k]:
        loop c in ROOM_FANS:
            q = obj_params(Lr, t, h.frame * translation(c) * rotation_y(t * 2.1 + f64(c.x)))
            q.wet = 0.0
            draw(obj_sh, fan, q)
