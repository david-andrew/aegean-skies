# The Morse subtitle on the screen, in the style of the R/T's spoken lines (the notice card,
# hud.jo `prompt_card`: cream type on a dark rounded card, low and centred, above the gauges): what
# the key says in plain English, and beneath it, smaller, who sends it and the letters as received,
# with the dots and dashes of the character being sent after them, faint. The same place whether
# outside; it stacks with the other notices rather than over them. In the cockpit (the panel and
# cowl fill the foot of the screen) and on a phone upright (the thumbs' buttons do) it stands
# instead at the top, on the wing's fabric or the sky, under the buttons along the top.
# (src/morse_subtitles.jo follows each keying; what feeds it is below.)
use 'morse_subtitles.jo'
use 'hud.jo'
use 'touch.jo'

# What is heard leaves the loudspeaker a little after it leaves the game's mix (the sound device's
# own delay, not known here): the subtitle is held back this long behind the mix, so it is behind
# the heard key and never ahead of it. A lamp is seen, not heard: no delay.
const MORSE_EAR_DELAY = 0.05

# The card's edges: the notice cards' own (hud.jo prompt_card): 18 across and 10 up and down of the
# type, its bottom 226 above the screen's foot.
const MORSE_CARD_PAD_X = 18.0
const MORSE_CARD_PAD_Y = 10.0
const MORSE_CARD_RAISE = 226.0
const MORSE_CARD_TOP = 84.0         # the card's top where it stands at the top: under the clock's box and the compass

# Where a card `w` by `h` goes on a screen `sw` by `sh`: centred, standing `raise` above the foot
# and above any of the cards already drawn this frame (`drawn`) it would lie over; or, with `top`
# given (0 or more), at that height from the top, whatever else is drawn (nothing else stands there).
morse_strip_place = (sw: f64, sh: f64, w: f64, h: f64, raise: f64, drawn: Rect[] = [], top: f64 = -1.0) -> Rect:
    wide = min(w,sw-12.0)
    x = (sw-wide)*0.5
    y = if top >= 0.0: top else: prompt_card_stack(x,sh-raise-h,wide,h,drawn)
    Rect(f32(x),f32(clamp(y,4.0,max(4.0,sh-h-4.0))),f32(wide),f32(h))

_morse_wrap = (plain: str, room: f64, size: f64) -> str[]: if plain == "": [] else: wrap_text(plain,room,size)

# The dots and dashes as ink marks from `at` (the line's middle), `r` a dot's radius; the width inked.
_morse_ink = (code: str, at: vec2, r: f64, colour: vec4) -> f64:
    x = f64(at.x)
    loop j in 0..code.len():
        if code[j] == '-':
            rect_rounded(x,f64(at.y)-r,r*6.0,r*2.0,r,colour)
            x += r*6.0+r*2.2
        else:
            circle(vec2(f32(x+r),at.y),r,colour)
            x += r*2.0+r*2.2
    x-f64(at.x)

# Draw the subtitle `now`, faded as its keying stops. Sized for the whole message, so it does not
# grow as the words come.
draw_morse_strip = (fonts: Fonts, s: MorseSubtitle, now: f64, cockpit: bool = false):
    alpha = morse_shown(s,now)
    if alpha <= 0.0: return
    sw = f64(screen_width()); sh = f64(screen_height())
    set_font(fonts.ui)
    size = readable(22.0); small = max(12.5,size*0.62)
    line = s.line
    label = if line.label == "": "" else: "{line.label}  "
    # (as wide as the whole message needs: the plain reading, or the letters with a character's
    # marks; never wider than the notice cards)
    most = sw-56.0
    whole = s.whole
    text_w = min(most,max(150.0,max(text_width(whole,size),text_width(label+s.text.upper(),small)+small*3.6)))
    # (two lines of plain reading at most, its type narrowed to fit; the card keeps the height the
    # whole message needs)
    loop _morse_wrap(whole,text_w,size).len() > 2 and size > 13.0: size -= 1.0
    rows = max(1,min(2,_morse_wrap(whole,text_w,size).len()))
    ink_h = f64(rows)*size*1.2+small*1.5
    w = text_w+MORSE_CARD_PAD_X*2.0
    h = ink_h+MORSE_CARD_PAD_Y*2.0
    global prompt_cards_drawn, prompt_cards_frame
    if prompt_cards_frame != frame_number():
        prompt_cards_frame = frame_number(); prompt_cards_drawn = []
    # (in the cockpit, or on a phone upright: at the top, below the buttons along it where they reach)
    high = cockpit or narrow_aboard()
    top = if high: max(MORSE_CARD_TOP,pad_top_clear(sw*0.5-min(w,sw-12.0)*0.5,sw*0.5+min(w,sw-12.0)*0.5,true)+8.0) else: -1.0
    at = morse_strip_place(sw,sh,w,h,MORSE_CARD_RAISE,prompt_cards_drawn,top)
    if not high: prompt_cards_drawn.push(at)
    x = f64(at.x)+MORSE_CARD_PAD_X; y = f64(at.y)+MORSE_CARD_PAD_Y
    room = f64(at.w)-MORSE_CARD_PAD_X*2.0
    cream = rgba(1.0,0.97,0.9,f32(alpha))
    rect_rounded(f64(at.x),f64(at.y),f64(at.w),f64(at.h),8,rgba(0.08,0.1,0.14,f32(0.55*alpha)))
    # (until the first word of a message sent again is read, its last reading stays, faint)
    again = line.plain == "" and s.last.plain != ""
    lines = _morse_wrap(if again: s.last.plain else: line.plain,room,size)
    loop k in 0..min(rows,lines.len()):
        shown = if k == rows-1 and lines.len() > rows: fit_text(join(lines[k..lines.len()]," "),room,size) else: lines[k]
        text(shown,vec2(f32(x),f32(y+f64(k)*size*1.2)),size,if again: rgba(1.0,0.97,0.9,f32(0.38*alpha)) else: cream)
    ly = y+f64(rows)*size*1.2+small*0.2
    lx = x
    if label != "":
        text(label,vec2(f32(lx),f32(ly)),small,rgba(1.0,0.97,0.9,f32(0.72*alpha)))
        lx += text_width(label,small)
    # (the letters, and after them, a letter's gap on (a word's after a word), the marks)
    raw = fit_text(line.raw.trim(),room-(lx-x)-small*3.2,small)
    text(raw,vec2(f32(lx),f32(ly)),small,rgba(1.0,0.97,0.9,f32(0.52*alpha)))
    lx += text_width(raw,small)+(if raw == "": 0.0 else: if line.raw.ends_with(" "): small*0.7 else: small*0.35)
    _ = _morse_ink(line.keying,vec2(f32(lx),f32(ly+small*0.58)),small*0.19,rgba(1.0,0.97,0.9,f32(0.42*alpha)))
    set_font()

# ---------------------------------------------------------------- what feeds it
# A short keying with its own clock: the flight's cue under a line on the R/T, or a lamp's word.
struct MorseCue:
    key: str = ""
    label: str = ""
    text: str = ""
    since = 0.0                     # when its sound (or the lamp) began
    unit = 0.065                    # seconds to a Morse unit
    lead = 0.0                      # quiet before its first unit
    period = 0                      # units from one sending to the next (0: sent once)
    until = -1.0                    # followed until then
    coded = true                    # code to be read out (false: a plain word spelt, a lamp's)

# The wireless's subtitle and the flight's, and which cues have been taken up already.
struct MorseCaptions:
    wireless: MorseSubtitle
    flight: MorseSubtitle
    cue: MorseCue
    stations: MorseStation[]
    battle_sent = 0                 # BattleRadio.sent taken up
    homeward_at = -1000.0           # HomewardView.cue_at taken up

# The wireless keying `text` (RadioKeying's fields, src/radio.jo; "" when no Morse is on), a unit
# of it `unit_seconds` long.
morse_hear_wireless = (m: mut MorseCaptions, key: str, text: str, units: f64, period: int, signal: f64, now: f64, unit_seconds: f64 = 0.08):
    if text == "": return
    morse_follow(m.wireless,key,"",text,units-MORSE_EAR_DELAY/max(0.001,unit_seconds),period,signal,now,m.stations)

# A cue begun `now`: `text` keyed once at `unit` seconds a unit after `lead` (and shown a little
# after its end), or over and over every `period` units until `until`. `heard`: a sound (held back
# MORSE_EAR_DELAY), not a lamp.
# `coded` false: a plain word spelt out, shown as spelt.
morse_cue_start = (m: mut MorseCaptions, label: str, text: str, now: f64, unit: f64, lead: f64, period: int = 0, until: f64 = -1.0, coded: bool = true, heard: bool = true):
    wait = lead+(if heard: MORSE_EAR_DELAY else: 0.0)
    m.cue = MorseCue("{label}:{text}:{now}",label,text,now,unit,wait,period,
        if until >= 0.0: until else: now+wait+f64(morse_units(text))*unit+1.6,coded)

# Each frame: the cue under way followed (clearly received: the flight is near).
morse_cue_step = (m: mut MorseCaptions, now: f64):
    c = m.cue
    if c.key == "" or now >= c.until: return
    morse_follow(m.flight,c.key,c.label,c.text,(now-c.since-c.lead)/max(0.001,c.unit),c.period,1.0,now,[],c.coded)

# The cue cut short (out of the aircraft, a new flight).
morse_cue_stop = (m: mut MorseCaptions): m.cue = MorseCue()

# The subtitle to show `now`: the flight's while one is up, else the wireless's.
morse_showing = (m: MorseCaptions, now: f64) -> MorseSubtitle: if morse_shown(m.flight,now) > 0.0: m.flight else: m.wireless
