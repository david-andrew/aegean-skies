# The Morse subtitle on the screen: a slip of paper with what the key says in plain English, the
# letters as received smaller beneath, and the dots and dashes of the character being sent, inked
# as a register writes them. Beside the wireless in the cockpit (out to its right, level with it,
# clear of the panel's instruments and the gunsight); otherwise, and where there is no room beside
# it, at the subtitle spot: top centre, under the compass. And what feeds it: the wireless's own
# keying, and the flight's cues and lamp (src/morse_subtitles.jo follows each).
use 'morse_subtitles.jo'
use 'hud.jo'
use 'touch.jo'

const MORSE_STRIP_TOP = 64.0        # the subtitle spot's top: under the compass and its mark (hud.jo `compass`)
const MORSE_STRIP_MIN = 230.0       # the narrowest room beside the wireless worth using
# What is heard leaves the loudspeaker a little after it leaves the game's mix (the sound device's
# own delay, not known here): the slip is held back this long behind the mix, so it is behind the
# heard key and never ahead of it. A lamp is seen, not heard: no delay.
const MORSE_EAR_DELAY = 0.05

# Where a strip `w` wide at most and `h` tall goes on a screen `sw` by `sh`: beside the wireless
# (`beside`, its place on the screen in the cockpit) when the whole set shows and there is room to
# its right clear of everything in `avoid` (the touch controls); else the subtitle spot, `top`
# down. The width it gets is the rect's.
morse_strip_place = (sw: f64, sh: f64, w: f64, h: f64, beside: Rect?, top: f64, avoid: Rect[] = []) -> Rect:
    if let r = beside:
        x = f64(r.x+r.w)+14.0
        room = sw-10.0-x
        whole = f64(r.x) >= 0.0 and f64(r.y) >= 0.0 and f64(r.y+r.h) <= sh
        if whole and room >= min(w,MORSE_STRIP_MIN):
            at = Rect(f32(x),f32(clamp(f64(r.y)+f64(r.h)*0.5-h*0.5,8.0,sh-h-8.0)),f32(min(w,room)),f32(h))
            clear = true
            loop o in avoid:
                if at.x < o.x+o.w and o.x < at.x+at.w and at.y < o.y+o.h and o.y < at.y+at.h: clear = false
            if clear: return at
    wide = min(w,sw-24.0)
    Rect(f32((sw-wide)*0.5),f32(top),f32(wide),f32(h))

# The strip's type, and the plain reading wrapped to at most two lines of `room`.
struct MorseStripType:
    size = 16.0                     # the plain reading's
    small = 11.5                    # the letters'
    lines: str[]

_morse_wrap = (plain: str, room: f64, size: f64) -> str[]: if plain == "": [] else: wrap_text(plain,room,size)

# The dots and dashes as ink marks from `at` (the line's middle), `r` a dot's radius; the width inked.
_morse_ink = (code: str, at: vec2, r: f64, colour: vec4) -> f64:
    x = f64(at.x)
    loop j in 0..code.len():
        if code[j] == '-':
            rect_rounded(x,f64(at.y)-r,r*6.0,r*2.0,r,colour)
            x += r*6.0+r*2.2
        else:
            circle(vec2(f32(x+r),at.y),r,colour)
            x += r*2.0+r*2.2
    x-f64(at.x)

# Draw the subtitle `now`, faded as its keying stops: beside the wireless (`beside`, its place on
# the screen) or at the subtitle spot. Sized for the whole message, so it does not grow as the
# words come.
draw_morse_strip = (fonts: Fonts, s: MorseSubtitle, now: f64, beside: Rect? = none, aboard: bool = true):
    alpha = morse_shown(s,now)
    if alpha <= 0.0: return
    sw = f64(screen_width()); sh = f64(screen_height())
    set_font(fonts.ui)
    size = readable(16.0); small = max(11.5,size*0.72)
    pad_x = 11.0; pad_y = 7.0
    line = s.line
    label = if line.label == "": "" else: "{line.label}  "
    # (as wide as the whole message needs: the plain reading, or the letters with a character's marks)
    whole_plain = s.whole
    w = max(150.0,max(text_width(whole_plain,size),text_width(label+s.text.upper(),small)+small*3.6))+pad_x*2.0
    # (on a touch screen, under the buttons along the top where the strip reaches them)
    top = max(MORSE_STRIP_TOP,pad_top_clear(sw*0.5-min(w,sw-24.0)*0.5,sw*0.5+min(w,sw-24.0)*0.5,aboard)+4.0)
    # (two lines of plain reading at most; the strip keeps the height the whole message needs)
    spot = morse_strip_place(sw,sh,w,10.0,beside,top,touch_controls())
    room = f64(spot.w)-pad_x*2.0
    rows = max(1,min(2,_morse_wrap(whole_plain,room,size).len()))
    loop rows == 2 and _morse_wrap(whole_plain,room,size).len() > 2 and size > 12.0: size -= 1.0
    h = pad_y*2.0+f64(rows)*size*1.22+small*1.45
    at = morse_strip_place(sw,sh,w,h,beside,top,touch_controls())
    x = f64(at.x); y = f64(at.y)
    ink = rgba(0.12,0.10,0.08,f32(0.95*alpha))
    faint = rgba(0.12,0.10,0.08,f32(0.58*alpha))
    # (the slip: paper gone a little brown, as the wireless's dial card, a soft shadow under it, a
    # fine rule over the letters)
    rect_rounded(x+1.0,y+2.0,f64(at.w),h,3,rgba(0,0,0,f32(0.22*alpha)))
    rect_rounded(x,y,f64(at.w),h,3,rgba(0.90,0.85,0.71,f32(0.92*alpha)))
    rule = y+pad_y+f64(rows)*size*1.22+1.0
    rect(x+pad_x,rule,f64(at.w)-pad_x*2.0,1.0,rgba(0.45,0.33,0.16,f32(0.28*alpha)))
    # (until the first word of a message sent again is read, its last reading stays, faint)
    again = line.plain == "" and s.last.plain != ""
    lines = _morse_wrap(if again: s.last.plain else: line.plain,room,size)
    loop k in 0..min(rows,lines.len()):
        shown = if k == rows-1 and lines.len() > rows: fit_text(join(lines[k..lines.len()]," "),room,size) else: lines[k]
        text(shown,vec2(f32(x+pad_x),f32(y+pad_y+f64(k)*size*1.22)),size,if again: rgba(0.12,0.10,0.08,f32(0.34*alpha)) else: ink)
    ly = rule+small*0.32
    lx = x+pad_x
    if label != "":
        text(label,vec2(f32(lx),f32(ly)),small,rgba(0.45,0.33,0.16,f32(0.95*alpha)))
        lx += text_width(label,small)
    # (the letters, and after them, a letter's gap on (a word's after a word), the marks)
    raw = fit_text(line.raw.trim(),room-(lx-x-pad_x)-small*3.2,small)
    text(raw,vec2(f32(lx),f32(ly)),small,faint)
    lx += text_width(raw,small)+(if raw == "": 0.0 else: if line.raw.ends_with(" "): small*0.7 else: small*0.35)
    _ = _morse_ink(line.keying,vec2(f32(lx),f32(ly+small*0.58)),small*0.19,ink)
    set_font()

# ---------------------------------------------------------------- what feeds it
# A short keying with its own clock: the flight's cue under a line on the R/T, or a lamp's word.
struct MorseCue:
    key: str = ""
    label: str = ""
    text: str = ""
    since = 0.0                     # when its sound (or the lamp) began
    unit = 0.065                    # seconds to a Morse unit
    lead = 0.0                      # quiet before its first unit
    period = 0                      # units from one sending to the next (0: sent once)
    until = -1.0                    # followed until then
    coded = true                    # code to be read out (false: a plain word spelt, a lamp's)

# The wireless's subtitle and the flight's, and which cues have been taken up already.
struct MorseCaptions:
    wireless: MorseSubtitle
    flight: MorseSubtitle
    cue: MorseCue
    stations: MorseStation[]
    battle_sent = 0                 # BattleRadio.sent taken up
    homeward_at = -1000.0           # HomewardView.cue_at taken up

# The wireless keying `text` (RadioKeying's fields, src/radio.jo; "" when no Morse is on), a unit
# of it `unit_seconds` long.
morse_hear_wireless = (m: mut MorseCaptions, key: str, text: str, units: f64, period: int, signal: f64, now: f64, unit_seconds: f64 = 0.08):
    if text == "": return
    morse_follow(m.wireless,key,"",text,units-MORSE_EAR_DELAY/max(0.001,unit_seconds),period,signal,now,m.stations)

# A cue begun `now`: `text` keyed once at `unit` seconds a unit after `lead` (and shown a little
# after its end), or over and over every `period` units until `until`. `heard`: a sound (held back
# MORSE_EAR_DELAY), not a lamp.
# `coded` false: a plain word spelt out, shown as spelt.
morse_cue_start = (m: mut MorseCaptions, label: str, text: str, now: f64, unit: f64, lead: f64, period: int = 0, until: f64 = -1.0, coded: bool = true, heard: bool = true):
    wait = lead+(if heard: MORSE_EAR_DELAY else: 0.0)
    m.cue = MorseCue("{label}:{text}:{now}",label,text,now,unit,wait,period,
        if until >= 0.0: until else: now+wait+f64(morse_units(text))*unit+1.6,coded)

# Each frame: the cue under way followed (clearly received: the flight is near).
morse_cue_step = (m: mut MorseCaptions, now: f64):
    c = m.cue
    if c.key == "" or now >= c.until: return
    morse_follow(m.flight,c.key,c.label,c.text,(now-c.since-c.lead)/max(0.001,c.unit),c.period,1.0,now,[],c.coded)

# The cue cut short (out of the aircraft, a new flight).
morse_cue_stop = (m: mut MorseCaptions): m.cue = MorseCue()

# The subtitle to show `now`: the flight's while one is up, else the wireless's.
morse_showing = (m: MorseCaptions, now: f64) -> MorseSubtitle: if morse_shown(m.flight,now) > 0.0: m.flight else: m.wireless
