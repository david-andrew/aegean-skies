# The crowd bed: the sound of people in a square, on a quay or round a cafe's tables, made from
# nothing recorded. Fitted to CC0 and public-domain field recordings of Mediterranean and other
# squares, promenades, wharves and cafes (docs/crowd-reference.md lists them and the measures):
# the long-term spectrum, the loudness modulation from phrase to consonant rate, how voiced it
# is, how often something sharp stands out, and how alike the two ears hear it. The recordings
# themselves are never shipped or sampled; only the numbers in CrowdFit come from them.
#
# Three layers: a few talkers near enough to follow (still never words: syllables of invented
# consonants and vowels), more across the square, and the many beyond as a breathing noise; all
# of it through a short outdoor reverb among stone walls, with footsteps passing. Stereo, the two
# channels partly alike, as a square sounds. Its occasional louder voices and laughs are single
# events from the people actually there (src/ambience_scene.jo ambience_voices), not baked in,
# so the loop itself carries nothing to recognise.
use 'airsound.jo'

struct CrowdFit:
    near = 3                    # talkers near enough to follow
    mid = 5                     # talkers across the square
    far_level = 0.3             # the many beyond, as breathing noise, against the talkers
    rate_min = 4.2              # syllables a second
    rate_max = 7.0
    phrase_min = 0.8            # seconds a phrase runs
    phrase_max = 3.2
    pause_min = 0.2             # between phrases
    pause_max = 1.5
    breath = 0.65               # air through the voice
    jitter = 0.03               # pitch wobble from one period to the next
    shimmer = 0.1               # and its loudness
    plosive = 0.32              # how syllables begin (the rest on the vowel)
    fricative = 0.26
    sonorant = 0.22
    coda = 0.3                  # how many end on a consonant
    burst = 1.8                 # consonant strength
    swell = 0.85                # how far a talker's level falls and rises as a conversation goes
    rt60 = 0.75                 # seconds, the square's walls
    wet_near = 0.35             # reverb sends
    wet_mid = 0.6
    wet_far = 0.75
    share = 0.6                 # how much of the far layer both ears share
    spread = 0.8                # how far talkers sit to either side
    rumble = 3.0                # the low air of the place under it all (sea, feet, far work)
    steps = 2                   # people walking past within a loop
    low_db = 0.0                # the final fit to the references' long-term spectrum: shelves
    low_hz = 250.0
    high_db = -4.0
    high_hz = 3000.0
    clinks = false              # glasses and cups (a cafe)

# The harbour and the square (fitted: docs/crowd-reference.md), and a cafe's terrace: one more
# near, a smaller room, the tables.
CROWD_QUAY = CrowdFit()
CROWD_CAFE = CrowdFit(near = 4, rt60 = 0.55, wet_mid = 0.5, steps = 1, clinks = true)

crowd_unit = (state: mut u64) -> f64:
    state += (u64(0x9E3779B9)<<32 or u64(0x7F4A7C15))
    z = state
    z = (z xor (z>>30))*(u64(0xBF58476D)<<32 or u64(0x1CE4E5B9))
    z = (z xor (z>>27))*(u64(0x94D049BB)<<32 or u64(0x133111EB))
    f64((z xor (z>>31))>>11)/9007199254740992.0
crowd_between = (state: mut u64,lo: f64,hi: f64) -> f64: lo+(hi-lo)*crowd_unit(state)

# vowels (F1, F2): a e i o u and the unstressed schwa, the open ones commoner
CROWD_VOWELS = [vec2(760,1250),vec2(520,1820),vec2(320,2250),vec2(490,900),vec2(370,820),vec2(520,1450)]
CROWD_VOWEL_PICK = [0,0,1,1,5,5,2,3,4,0,1,5]

struct CrowdVoice:
    phase = 0.0
    period_pitch = 1.0          # this period's jittered pitch
    period_level = 1.0          # and loudness
    tilt = 0.0
    f1: Biquad
    f2: Biquad
    f3: Biquad
    f4: Biquad

# One talker's speech, a syllable at a time: phrases of syllables, the pitch falling through each
# phrase, every second or third syllable stressed. (crowd_talker_step: one syllable, or the pause
# after a phrase; resumable between any two.)
struct CrowdTalker:
    f0 = 0.0
    shift = 1.0
    speed = 1.0
    voice: CrowdVoice = CrowdVoice(f1 = Biquad(),f2 = Biquad(),f3 = Biquad(),f4 = Biquad())
    hiss: Biquad = Biquad()
    burst: Biquad = Biquad()
    air: Biquad = Biquad()
    t = 0.0
    end = 0.0
    speaking = false            # (within a phrase)
    phrase = 0.0
    begun = 0.0
    k = 0
    accent = 2
    said = 1.0

crowd_talker_begin = (rng: mut u64,fit: CrowdFit,female: bool,start: f64,end: f64) -> CrowdTalker:
    c = CrowdTalker(t = start,end = end)
    c.f0 = (if female: crowd_between(rng,185,235) else: crowd_between(rng,98,132))
    c.shift = if female: 1.15 else: 1.0
    c.speed = crowd_between(rng,fit.rate_min,fit.rate_max)
    bandpass(c.voice.f3,2650.0*c.shift,6.0); bandpass(c.voice.f4,3500.0*c.shift,5.0)
    bandpass(c.air,1800.0*c.shift,1.2)
    c

# true once the talker has finished
crowd_talker_step = (out: mut f64[],rng: mut u64,fit: CrowdFit,c: mut CrowdTalker) -> bool:
    if not c.speaking:
        if c.t >= c.end: return true
        c.phrase = crowd_between(rng,fit.phrase_min,fit.phrase_max)
        c.begun = c.t; c.k = 0; c.accent = 2+int(crowd_unit(rng)*1.999)
        c.said = crowd_between(rng,0.45,1.0)          # (some things said louder than others)
        c.speaking = true
    if c.t < c.begun+c.phrase and c.t < c.end:
        fall = 1.1-0.2*(c.t-c.begun)/c.phrase
        stressed = c.k%c.accent == 0
        length = (1.0/c.speed)*crowd_between(rng,0.7,1.3)*(if stressed: 1.25 else: 0.9)
        voice = c.voice; hiss = c.hiss; burst = c.burst; air = c.air
        crowd_syllable(out,rng,fit,voice,hiss,burst,air,c.t,length,c.f0*fall*(if stressed: 1.07 else: 1.0),(if stressed: 1.0 else: 0.7)*c.said,c.shift)
        c.voice = voice; c.hiss = hiss; c.burst = burst; c.air = air
        c.t += length; c.k += 1
        return false
    c.t += crowd_between(rng,fit.pause_min,fit.pause_max)
    c.speaking = false
    false

crowd_syllable = (out: mut f64[],rng: mut u64,fit: CrowdFit,v: mut CrowdVoice,hiss: mut Biquad,burst: mut Biquad,air: mut Biquad,at: f64,length: f64,f0: f64,loud: f64,shift: f64):
    rate = f64(MIX_RATE)
    start = int(at*rate); n = int(length*rate)
    pick = crowd_unit(rng)
    onset = if pick < fit.plosive: 1 else: if pick < fit.plosive+fit.fricative: 2 else: if pick < fit.plosive+fit.fricative+fit.sonorant: 3 else: 0
    voiced_from = 0; noise_to = 0; noise_level = 0.0
    if onset == 1:
        # a stop: closed, a burst, a breath of aspiration
        closed = int(crowd_between(rng,0.015,0.035)*rate)
        noise_to = closed+int(crowd_between(rng,0.008,0.016)*rate)
        bandpass(burst,[1100.0,2000.0,4200.0][int(crowd_unit(rng)*2.999)],1.5)
        voiced_from = noise_to+int(crowd_between(rng,0.008,0.03)*rate)
        noise_level = 0.8*fit.burst
    else if onset == 2:
        # a fricative: s, sh or f
        noise_to = int(crowd_between(rng,0.05,0.1)*rate)
        which = int(crowd_unit(rng)*2.999)
        bandpass(hiss,[5800.0,3200.0,1800.0][which],[2.0,2.5,0.7][which])
        voiced_from = noise_to-int(0.01*rate)
        noise_level = [0.45,0.4,0.2][which]*fit.burst
    vowel = CROWD_VOWELS[CROWD_VOWEL_PICK[int(crowd_unit(rng)*11.999)]]
    locus = vec2(f32(if onset == 3: 290.0 else: 330.0),f32(crowd_between(rng,1100,1900)))
    coda = crowd_unit(rng) < fit.coda
    coda_from = if coda: n-int(crowd_between(rng,0.03,0.06)*rate) else: n
    attack = 0.02*rate; release = 0.035*rate
    loop i in 0..n+int(0.02*rate):
        at_i = (start+i)%out.len()          # (round the loop: the last syllable ends in the first second)
        # formants glide from the consonant's place to the vowel over 35 ms, retuned each 1.3 ms
        if i%64 == 0:
            g = clamp(f64(i-voiced_from)/(0.035*rate),0.0,1.0)
            if onset == 3 and i < voiced_from+int(0.05*rate): g = 0.0
            if i >= coda_from: g = 1.0-clamp(f64(i-coda_from)/(0.02*rate),0.0,0.7)
            bandpass(v.f1,(f64(locus.x)+(f64(vowel.x)-f64(locus.x))*g)*shift,5.0)
            bandpass(v.f2,(f64(locus.y)+(f64(vowel.y)-f64(locus.y))*g)*shift,7.0)
        s = 0.0
        if i >= voiced_from and i < n:
            # the glottal source: a tilted ramp, its period and loudness wobbling, air in it
            v.phase += f0*v.period_pitch/rate
            if v.phase >= 1.0:
                v.phase -= 1.0
                v.period_pitch = 1.0+(crowd_unit(rng)-0.5)*2.0*fit.jitter
                v.period_level = 1.0+(crowd_unit(rng)-0.5)*2.0*fit.shimmer
            ramp = 2.0*v.phase-1.0
            v.tilt += (ramp-v.tilt)*0.35
            env = min(1.0,f64(i-voiced_from)/attack)*min(1.0,f64(n-i)/release)
            breath = (crowd_unit(rng)-0.5)*fit.breath*(1.2-v.phase)
            src = (v.tilt*v.period_level+breath)*env
            level = if onset == 3 and i < voiced_from+int(0.05*rate): 0.45 else: 1.0
            s = (filt(v.f1,src)+filt(v.f2,src)*0.55+filt(v.f3,src)*0.22+filt(v.f4,src)*0.1)*level*loud
        else:
            _ = filt(v.f1,0.0); _ = filt(v.f2,0.0); _ = filt(v.f3,0.0); _ = filt(v.f4,0.0)
        if onset == 1 and i < noise_to:
            if i >= noise_to-int(0.016*rate): s += filt(burst,crowd_unit(rng)-0.5)*noise_level*loud
        else if onset == 1 and i >= noise_to and i < voiced_from+int(0.01*rate):
            s += filt(air,crowd_unit(rng)-0.5)*0.35*loud
        if onset == 2 and i < noise_to:
            u = f64(i)/f64(max(1,noise_to))
            s += filt(hiss,crowd_unit(rng)-0.5)*noise_level*sin(PI*u)*loud
        if coda and i >= coda_from and i < n and crowd_unit(rng) < 1.0:
            s += filt(hiss,crowd_unit(rng)-0.5)*0.12*loud
        out[at_i] += s

# RBJ shelves, for the final fit of the long-term spectrum
crowd_shelf = (f: mut Biquad,freq: f64,db: f64,high: bool):
    a = pow(10.0,db/40.0)
    w = TAU*freq/f64(MIX_RATE); c = cos(w); s = sin(w)
    alpha = s/2.0*sqrt(2.0)
    root = 2.0*sqrt(a)*alpha
    if high:
        a0 = (a+1.0)-(a-1.0)*c+root
        f.b0 = a*((a+1.0)+(a-1.0)*c+root)/a0; f.b1 = -2.0*a*((a-1.0)+(a+1.0)*c)/a0; f.b2 = a*((a+1.0)+(a-1.0)*c-root)/a0
        f.a1 = 2.0*((a-1.0)-(a+1.0)*c)/a0; f.a2 = ((a+1.0)-(a-1.0)*c-root)/a0
    else:
        a0 = (a+1.0)+(a-1.0)*c+root
        f.b0 = a*((a+1.0)-(a-1.0)*c+root)/a0; f.b1 = 2.0*a*((a-1.0)-(a+1.0)*c)/a0; f.b2 = a*((a+1.0)-(a-1.0)*c-root)/a0
        f.a1 = -2.0*((a-1.0)+(a+1.0)*c)/a0; f.a2 = ((a+1.0)+(a-1.0)*c-root)/a0

struct CrowdBed:
    left: f64[]
    right: f64[]

# The bed, made a piece at a time (a game spreads its ambience over the first frames): each
# talker's syllables one by one, then its swell and its place in the mix; the many beyond, layer
# by layer; the low air; each walker's steps; each clink; each reverb comb and allpass, ear by
# ear; the shelves; the crests. Every long pass runs CROWD_CHUNK samples a step. The same
# arithmetic in the same order as made at once (crowd_bed), so the very same samples.
const CROWD_CHUNK = 4096
const CROWD_TALK = 0
const CROWD_TALKED = 1
const CROWD_FAR = 2
const CROWD_SHARE = 3
const CROWD_ADD_FAR = 4
const CROWD_RUMBLE = 5
const CROWD_STEPS = 6
const CROWD_CLINKS = 7
const CROWD_REVERB = 8
const CROWD_SHELVES = 9
const CROWD_LEVEL = 10
const CROWD_CRESTS = 11
const CROWD_MADE = 12
CROWD_COMBS = [0.0297,0.0371,0.0411,0.0437]
CROWD_ALLPASSES = [0.005,0.0017]

struct CrowdBuild:
    n = 0
    seed = 0
    fit: CrowdFit = CrowdFit()
    stage = CROWD_MADE
    rng = u64(0)
    l: f64[]
    r: f64[]
    send_l: f64[]
    send_r: f64[]
    voice: f64[]
    who = 0
    part = 0
    i = 0
    round = 0
    talking = false
    talker: CrowdTalker = CrowdTalker()
    level = 0.0
    knot = 0.0
    from = 0.0
    to = 0.0
    span = 0.0
    wet = 0.0
    gl = 0.0
    gr = 0.0
    total = 0.0
    talk = 0.0
    scale = 0.0
    far: f64[][]
    layer = 0
    fa: Biquad = Biquad()
    fb: Biquad = Biquad()
    fc: Biquad = Biquad()
    fd: Biquad = Biquad()
    slow = 0.0
    slow_to = 0.0
    fast = 0.0
    fast_to = 0.0
    walker = 0
    t = 0.0
    ear = 0
    element = 0
    line: f64[]
    at = 0
    damp = 0.0
    g = 0.0
    acc: f64[]
    result: f64[]
    wet_l: f64[]
    wet_r: f64[]
    knee = 0.0

crowd_begin = (n: int,seed: int,fit: CrowdFit) -> CrowdBuild:
    CrowdBuild(n = n,seed = seed,fit = fit,stage = CROWD_TALK,rng = u64(seed*1000003+5))

# Up to `steps` more pieces (a syllable, a walker, a clink or CROWD_CHUNK samples of a pass);
# true once the bed is made (crowd_bed_of then gives it).
crowd_run = (c: mut CrowdBuild,steps: int) -> bool:
    done = 0
    loop c.stage != CROWD_MADE and done < max(1,steps):
        crowd_piece(c)
        done += 1
    c.stage == CROWD_MADE

crowd_bed_of = (c: CrowdBuild) -> CrowdBed: CrowdBed(c.l,c.r)

# The bed made at once: the same pieces, all of them.
crowd_bed = (n: int,seed: int,fit: CrowdFit) -> CrowdBed:
    c = crowd_begin(n,seed,fit)
    loop not crowd_run(c,1000000): pass
    crowd_bed_of(c)

crowd_piece = (c: mut CrowdBuild):
    n = c.n; fit = c.fit; rate = f64(MIX_RATE); seconds = f64(n)/rate
    rng = c.rng
    end = min(n,c.i+CROWD_CHUNK)
    if c.stage == CROWD_TALK:
        # (the working buffers made a piece each)
        if c.l.len() == 0: c.l = fill(0.0,n); return
        if c.r.len() == 0: c.r = fill(0.0,n); return
        if c.send_l.len() == 0: c.send_l = fill(0.0,n); return
        if c.send_r.len() == 0: c.send_r = fill(0.0,n); return
        near = c.who < fit.near
        if not c.talking:
            c.voice = fill(0.0,n)
            # (each from its own moment; what runs past the end is wrapped into the start)
            female = crowd_unit(rng) < 0.5
            start = crowd_between(rng,0.0,1.2)
            c.talker = crowd_talker_begin(rng,fit,female,start,seconds)
            c.talking = true; c.part = 0
        else if c.part == 0:
            talker = c.talker
            if crowd_talker_step(c.voice,rng,fit,talker):
                c.level = if near: crowd_between(rng,0.7,1.0) else: crowd_between(rng,0.25,0.55)
                # (a conversation waxes and wanes: the talker's level wanders between knots 1-2.5 s apart)
                c.knot = 0.0; c.from = crowd_unit(rng); c.to = crowd_unit(rng); c.span = crowd_between(rng,1.0,2.5)
                c.part = 1; c.i = 0
            c.talker = talker
        else if c.part == 1:
            knot = c.knot; from = c.from; to = c.to; span = c.span
            loop i in c.i..end:
                u = (f64(i)/rate-knot)/span
                if u >= 1.0:
                    knot += span; from = to; to = crowd_unit(rng); span = crowd_between(rng,1.0,2.5); u = 0.0
                e = from+(to-from)*u*u*(3.0-2.0*u)
                c.voice[i] *= 1.0-fit.swell+fit.swell*e
            c.knot = knot; c.from = from; c.to = to; c.span = span; c.i = end
            if end >= n:
                c.wet = if near: fit.wet_near else: fit.wet_mid
                pan = crowd_between(rng,-fit.spread,fit.spread)
                c.gl = sqrt((1.0-pan)*0.5)*c.level; c.gr = sqrt((1.0+pan)*0.5)*c.level
                # (distance dulls the far side of the square)
                c.fa = Biquad(); lowpass(c.fa,if near: 9000.0 else: 3800.0)
                c.part = 2; c.i = 0
        else:
            dull = c.fa; wet = c.wet; gl = c.gl; gr = c.gr
            loop i in c.i..end:
                s = filt(dull,c.voice[i])
                c.l[i] += s*gl*(1.0-wet*0.5); c.r[i] += s*gr*(1.0-wet*0.5)
                c.send_l[i] += s*gl*wet; c.send_r[i] += s*gr*wet
            c.fa = dull; c.i = end
            if end >= n:
                c.talking = false; c.who += 1; c.voice = []; c.i = 0
                if c.who >= fit.near+fit.mid: c.stage = CROWD_TALKED; c.total = 0.0
    else if c.stage == CROWD_TALKED:
        loop i in c.i..end: c.total += c.l[i]*c.l[i]
        c.i = end
        if end >= n:
            c.talk = sqrt(c.total/f64(n))
            c.far = [fill(0.0,n),fill(0.0,n),fill(0.0,n)]
            c.layer = 0; c.stage = CROWD_FAR; c.i = 0
            crowd_far_begin(c,rng)
    else if c.stage == CROWD_FAR:
        # the many beyond: speech-shaped noise, its loudness breathing slowly and, faintly, at syllable rate
        low = c.fa; mid = c.fb; high = c.fc
        slow = c.slow; slow_to = c.slow_to; fast = c.fast; fast_to = c.fast_to
        loop i in c.i..end:
            if i%int(rate*0.4) == 0: slow_to = crowd_unit(rng)
            if i%int(rate*0.07) == 0: fast_to = crowd_unit(rng)
            slow += (slow_to-slow)*0.00012; fast += (fast_to-fast)*0.0012
            x = crowd_unit(rng)-0.5
            c.far[c.layer][i] += (filt(low,x)*0.9+filt(mid,x)*0.6+filt(high,x)*0.22)*(0.35+0.65*slow)*(0.8+0.4*fast)
        c.fa = low; c.fb = mid; c.fc = high
        c.slow = slow; c.slow_to = slow_to; c.fast = fast; c.fast_to = fast_to; c.i = end
        if end >= n:
            c.layer += 1; c.i = 0
            if c.layer < 3: crowd_far_begin(c,rng)
            else: c.stage = CROWD_SHARE; c.total = 0.0
    else if c.stage == CROWD_SHARE:
        loop i in c.i..end:
            c.far[0][i] = c.far[0][i]*(1.0-fit.share)+c.far[2][i]*fit.share; c.far[1][i] = c.far[1][i]*(1.0-fit.share)+c.far[2][i]*fit.share
            c.total += c.far[0][i]*c.far[0][i]
        c.i = end
        if end >= n:
            c.scale = fit.far_level*c.talk/max(sqrt(c.total/f64(n)),1e-9)
            c.stage = CROWD_ADD_FAR; c.i = 0
    else if c.stage == CROWD_ADD_FAR:
        scale = c.scale
        loop i in c.i..end:
            c.l[i] += c.far[0][i]*scale*(1.0-fit.wet_far*0.5); c.r[i] += c.far[1][i]*scale*(1.0-fit.wet_far*0.5)
            c.send_l[i] += c.far[0][i]*scale*fit.wet_far; c.send_r[i] += c.far[1][i]*scale*fit.wet_far
        c.i = end
        if end >= n:
            c.far = []; c.i = 0
            if fit.rumble > 0.0:
                c.fa = Biquad(); lowpass(c.fa,260.0); c.fb = Biquad(); lowpass(c.fb,260.0)
                c.fc = Biquad(); lowpass(c.fc,260.0)
                c.slow = 0.0; c.slow_to = 0.5; c.round = 0
                c.stage = CROWD_RUMBLE
            else: c.stage = CROWD_STEPS; c.walker = 0
    else if c.stage == CROWD_RUMBLE:
        # the low air of the place: deep, slowly wandering noise, much the same in both ears
        deep = c.fa; deeper = c.fb; side = c.fc; level = c.slow; level_to = c.slow_to
        loop i in c.i..end:
            if i%int(rate*0.6) == 0: level_to = crowd_unit(rng)
            level += (level_to-level)*0.00005
            common = filt(deeper,filt(deep,crowd_unit(rng)-0.5))
            own = filt(side,crowd_unit(rng)-0.5)
            if c.round == 1:
                g = fit.rumble*c.talk*8.0*(0.7+0.3*level)
                c.l[i] += (common*0.8+own*0.3)*g; c.r[i] += (common*0.8-own*0.3)*g
        c.fa = deep; c.fb = deeper; c.fc = side; c.slow = level; c.slow_to = level_to; c.i = end
        if end >= n:
            c.i = 0; c.round += 1
            if c.round == 2: c.stage = CROWD_STEPS; c.walker = 0
    else if c.stage == CROWD_STEPS:
        if c.walker < fit.steps:
            crowd_walker(c.l,c.r,rng)
            c.walker += 1
        else:
            c.stage = CROWD_CLINKS
            if fit.clinks: c.t = crowd_unit(rng)*0.4
    else if c.stage == CROWD_CLINKS:
        if fit.clinks and c.t < f64(n)/rate: c.t = crowd_clink(c.l,c.r,rng,c.t)
        else: c.stage = CROWD_REVERB; c.ear = 0; c.element = 0; crowd_reverb_begin(c)
    else if c.stage == CROWD_REVERB:
        crowd_reverb_piece(c,end)
    else if c.stage == CROWD_SHELVES:
        lo = c.fa; hi = c.fb; lo2 = c.fc; hi2 = c.fd
        loop i in c.i..end:
            a = filt(hi,filt(lo,c.l[i]+c.wet_l[i])); b = filt(hi2,filt(lo2,c.r[i]+c.wet_r[i]))
            if c.round == 1: c.l[i] = a; c.r[i] = b
        c.fa = lo; c.fb = hi; c.fc = lo2; c.fd = hi2; c.i = end
        if end >= n:
            c.i = 0; c.round += 1
            if c.round == 2: c.stage = CROWD_LEVEL; c.total = 0.0; c.wet_l = []; c.wet_r = []
    else if c.stage == CROWD_LEVEL:
        loop i in c.i..end: c.total += c.l[i]*c.l[i]+c.r[i]*c.r[i]
        c.i = end
        if end >= n:
            # crests rounded off at 3.5 times the bed's rms
            c.knee = sqrt(c.total/f64(2*n))*3.5
            c.i = 0; c.stage = if c.knee > 0.0: CROWD_CRESTS else: CROWD_MADE
    else if c.stage == CROWD_CRESTS:
        knee = c.knee
        loop i in c.i..end: c.l[i] = knee*tanh(c.l[i]/knee); c.r[i] = knee*tanh(c.r[i]/knee)
        c.i = end
        if end >= n: c.stage = CROWD_MADE; c.send_l = []; c.send_r = []
    c.rng = rng

crowd_far_begin = (c: mut CrowdBuild,rng: mut u64):
    c.fa = Biquad(); bandpass(c.fa,380.0,0.9); c.fb = Biquad(); bandpass(c.fb,1050.0,0.8); c.fc = Biquad(); bandpass(c.fc,2700.0,1.0)
    c.slow = 0.0; c.slow_to = crowd_unit(rng); c.fast = 0.0; c.fast_to = crowd_unit(rng)

# someone walking past on stone: heel and toe, nearer then farther
crowd_walker = (l: mut f64[],r: mut f64[],rng: mut u64):
    n = l.len(); rate = f64(MIX_RATE)
    count = 5+int(crowd_unit(rng)*5.999)
    pace = crowd_between(rng,0.48,0.62)
    t = crowd_unit(rng)*f64(n)/rate
    pan = crowd_between(rng,-0.8,0.8); drift = crowd_between(rng,-0.3,0.3)
    tick = Biquad(); bandpass(tick,crowd_between(rng,1800,3200),1.2)
    loop k in 0..count:
        near = sin(PI*(f64(k)+0.5)/f64(count))
        level = (0.15+0.35*near)*crowd_between(rng,0.7,1.0)
        start = int(t*rate)
        p = clamp(pan+drift*f64(k)/f64(count),-1.0,1.0)
        loop i in 0..int(rate*0.05):
            e = f64(i)/rate
            s = (filt(tick,crowd_unit(rng)-0.5)*exp(-e*350.0)*3.0+sin(TAU*95.0*e)*exp(-e*60.0)*0.4)*level
            at = (start+i)%n
            l[at] += s*sqrt((1.0-p)*0.5); r[at] += s*sqrt((1.0+p)*0.5)
        t += pace*crowd_between(rng,0.95,1.05)

# a glass or a cup on the tables (sometimes two together); the time of the next
crowd_clink = (l: mut f64[],r: mut f64[],rng: mut u64,t: f64) -> f64:
    n = l.len(); rate = f64(MIX_RATE)
    hz = crowd_between(rng,2100,3600)
    cup = crowd_unit(rng) < 0.3
    if cup: hz *= 0.55
    ring = crowd_between(rng,0.35,0.9)
    pan = crowd_between(rng,-0.7,0.7)
    twice = crowd_unit(rng) < 0.25
    loop hit in 0..(if twice: 2 else: 1):
        start = int((t+f64(hit)*crowd_between(rng,0.04,0.09))*rate)
        decay = if cup: 95.0 else: crowd_between(rng,55,90)
        loop k in 0..int(rate*0.09):
            e = f64(k)/rate
            s = (sin(TAU*hz*e)+sin(TAU*hz*1.62*e)*0.5)*exp(-e*decay)*min(1.0,e*4000.0)*ring*0.12
            at = (start+k)%n
            l[at] += s*sqrt((1.0-pan)*0.5); r[at] += s*sqrt((1.0+pan)*0.5)
    t+crowd_between(rng,0.25,1.55)

# A square's reverb: four damped combs and two allpasses (Schroeder) for each ear, each run round
# the loop twice so its tail wraps into the start; the right ear's delays a touch longer.
crowd_reverb_begin = (c: mut CrowdBuild):
    rate = f64(MIX_RATE); offset = if c.ear == 0: 0.0 else: 0.0023
    if c.element == 0: c.acc = fill(0.0,c.n)
    if c.element < 4:
        d = CROWD_COMBS[c.element]
        c.line = fill(0.0,int((d+offset)*rate)); c.at = 0; c.damp = 0.0
        c.g = pow(10.0,-3.0*(d+offset)/c.fit.rt60)
    else:
        c.line = fill(0.0,int((CROWD_ALLPASSES[c.element-4]+offset*0.1)*rate)); c.at = 0
        c.result = fill(0.0,c.n)
    c.round = 0; c.i = 0

crowd_reverb_piece = (c: mut CrowdBuild,end: int):
    size = c.line.len(); at = c.at
    if c.element < 4:
        damp = c.damp; g = c.g
        loop i in c.i..end:
            y = c.line[at]
            damp += (y-damp)*0.45
            c.line[at] = (if c.ear == 0: c.send_l[i] else: c.send_r[i])+damp*g
            at = (at+1)%size
            if c.round == 1: c.acc[i] += y*0.25
        c.damp = damp
    else:
        loop i in c.i..end:
            buffered = c.line[at]
            y = -0.7*c.acc[i]+buffered
            c.line[at] = c.acc[i]+0.7*y
            at = (at+1)%size
            if c.round == 1: c.result[i] = y
    c.at = at; c.i = end
    if end < c.n: return
    c.i = 0; c.round += 1
    if c.round < 2: return
    if c.element >= 4: c.acc = c.result; c.result = []
    c.element += 1
    if c.element < 6: crowd_reverb_begin(c); return
    if c.ear == 0: c.wet_l = c.acc
    else: c.wet_r = c.acc
    c.acc = []; c.line = []
    c.ear += 1; c.element = 0
    if c.ear < 2: crowd_reverb_begin(c); return
    c.fa = Biquad(); c.fb = Biquad(); c.fc = Biquad(); c.fd = Biquad()
    crowd_shelf(c.fa,c.fit.low_hz,c.fit.low_db,false); crowd_shelf(c.fb,c.fit.high_hz,c.fit.high_db,true)
    crowd_shelf(c.fc,c.fit.low_hz,c.fit.low_db,false); crowd_shelf(c.fd,c.fit.high_hz,c.fit.high_db,true)
    c.stage = CROWD_SHELVES; c.round = 0; c.i = 0

# A stereo loop at `rms`, seamless: the bed is already round, so no crossfade is needed.
crowd_sound = (bed: CrowdBed,rms: f64) -> Sound:
    n = bed.left.len()
    total = 0.0
    loop i in 0..n: total += bed.left[i]*bed.left[i]+bed.right[i]*bed.right[i]
    g = rms/max(sqrt(total/f64(2*n)),1e-9)
    out = fill(f32(0),n*2)
    loop i in 0..n:
        out[i*2] = f32(clamp(bed.left[i]*g,-0.45,0.45)); out[i*2+1] = f32(clamp(bed.right[i]*g,-0.45,0.45))
    Sound(out)
