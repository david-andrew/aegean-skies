# The crowd bed: the sound of people in a square, on a quay or round a cafe's tables, made from
# nothing recorded. Fitted to CC0 and public-domain field recordings of Mediterranean and other
# squares, promenades, wharves and cafes (docs/crowd-reference.md lists them and the measures):
# the long-term spectrum, the loudness modulation from phrase to consonant rate, how voiced it
# is, how often something sharp stands out, and how alike the two ears hear it. The recordings
# themselves are never shipped or sampled; only the numbers in CrowdFit come from them.
#
# Three layers: a few talkers near enough to follow (still never words: syllables of invented
# consonants and vowels), more across the square, and the many beyond as a breathing noise; all
# of it through a short outdoor reverb among stone walls, with footsteps passing. Stereo, the two
# channels partly alike, as a square sounds. Its occasional louder voices and laughs are single
# events from the people actually there (src/ambience_scene.jo ambience_voices), not baked in,
# so the loop itself carries nothing to recognise.
use 'airsound.jo'

struct CrowdFit:
    near = 3                    # talkers near enough to follow
    mid = 5                     # talkers across the square
    far_level = 0.3             # the many beyond, as breathing noise, against the talkers
    rate_min = 4.2              # syllables a second
    rate_max = 7.0
    phrase_min = 0.8            # seconds a phrase runs
    phrase_max = 3.2
    pause_min = 0.2             # between phrases
    pause_max = 1.5
    breath = 0.65               # air through the voice
    jitter = 0.03               # pitch wobble from one period to the next
    shimmer = 0.1               # and its loudness
    plosive = 0.32              # how syllables begin (the rest on the vowel)
    fricative = 0.26
    sonorant = 0.22
    coda = 0.3                  # how many end on a consonant
    burst = 1.8                 # consonant strength
    swell = 0.85                # how far a talker's level falls and rises as a conversation goes
    rt60 = 0.75                 # seconds, the square's walls
    wet_near = 0.35             # reverb sends
    wet_mid = 0.6
    wet_far = 0.75
    share = 0.6                 # how much of the far layer both ears share
    spread = 0.8                # how far talkers sit to either side
    rumble = 3.0                # the low air of the place under it all (sea, feet, far work)
    steps = 2                   # people walking past within a loop
    low_db = 0.0                # the final fit to the references' long-term spectrum: shelves
    low_hz = 250.0
    high_db = -4.0
    high_hz = 3000.0
    clinks = false              # glasses and cups (a cafe)

# The harbour and the square (fitted: docs/crowd-reference.md), and a cafe's terrace: one more
# near, a smaller room, the tables.
CROWD_QUAY = CrowdFit()
CROWD_CAFE = CrowdFit(near = 4, rt60 = 0.55, wet_mid = 0.5, steps = 1, clinks = true)

crowd_unit = (state: mut u64) -> f64:
    state += (u64(0x9E3779B9)<<32 or u64(0x7F4A7C15))
    z = state
    z = (z xor (z>>30))*(u64(0xBF58476D)<<32 or u64(0x1CE4E5B9))
    z = (z xor (z>>27))*(u64(0x94D049BB)<<32 or u64(0x133111EB))
    f64((z xor (z>>31))>>11)/9007199254740992.0
crowd_between = (state: mut u64,lo: f64,hi: f64) -> f64: lo+(hi-lo)*crowd_unit(state)

# vowels (F1, F2): a e i o u and the unstressed schwa, the open ones commoner
CROWD_VOWELS = [vec2(760,1250),vec2(520,1820),vec2(320,2250),vec2(490,900),vec2(370,820),vec2(520,1450)]
CROWD_VOWEL_PICK = [0,0,1,1,5,5,2,3,4,0,1,5]

struct CrowdVoice:
    phase = 0.0
    period_pitch = 1.0          # this period's jittered pitch
    period_level = 1.0          # and loudness
    tilt = 0.0
    f1: Biquad
    f2: Biquad
    f3: Biquad
    f4: Biquad

# One talker's speech into `out` (mono), from `start` to `end` seconds: phrases of syllables,
# the pitch falling through each phrase, every second or third syllable stressed.
crowd_talker = (out: mut f64[],rng: mut u64,fit: CrowdFit,female: bool,start: f64,end: f64):
    rate = f64(MIX_RATE)
    f0 = (if female: crowd_between(rng,185,235) else: crowd_between(rng,98,132))
    shift = if female: 1.15 else: 1.0
    speed = crowd_between(rng,fit.rate_min,fit.rate_max)
    voice = CrowdVoice(f1 = Biquad(),f2 = Biquad(),f3 = Biquad(),f4 = Biquad())
    bandpass(voice.f3,2650.0*shift,6.0); bandpass(voice.f4,3500.0*shift,5.0)
    hiss = Biquad(); burst = Biquad(); air = Biquad(); bandpass(air,1800.0*shift,1.2)
    t = start
    loop t < end:
        phrase = crowd_between(rng,fit.phrase_min,fit.phrase_max)
        begun = t; k = 0; accent = 2+int(crowd_unit(rng)*1.999)
        said = crowd_between(rng,0.45,1.0)          # (some things said louder than others)
        loop t < begun+phrase and t < end:
            fall = 1.1-0.2*(t-begun)/phrase
            stressed = k%accent == 0
            length = (1.0/speed)*crowd_between(rng,0.7,1.3)*(if stressed: 1.25 else: 0.9)
            crowd_syllable(out,rng,fit,voice,hiss,burst,air,t,length,f0*fall*(if stressed: 1.07 else: 1.0),(if stressed: 1.0 else: 0.7)*said,shift)
            t += length; k += 1
        t += crowd_between(rng,fit.pause_min,fit.pause_max)

crowd_syllable = (out: mut f64[],rng: mut u64,fit: CrowdFit,v: mut CrowdVoice,hiss: mut Biquad,burst: mut Biquad,air: mut Biquad,at: f64,length: f64,f0: f64,loud: f64,shift: f64):
    rate = f64(MIX_RATE)
    start = int(at*rate); n = int(length*rate)
    pick = crowd_unit(rng)
    onset = if pick < fit.plosive: 1 else: if pick < fit.plosive+fit.fricative: 2 else: if pick < fit.plosive+fit.fricative+fit.sonorant: 3 else: 0
    voiced_from = 0; noise_to = 0; noise_level = 0.0
    if onset == 1:
        # a stop: closed, a burst, a breath of aspiration
        closed = int(crowd_between(rng,0.015,0.035)*rate)
        noise_to = closed+int(crowd_between(rng,0.008,0.016)*rate)
        bandpass(burst,[1100.0,2000.0,4200.0][int(crowd_unit(rng)*2.999)],1.5)
        voiced_from = noise_to+int(crowd_between(rng,0.008,0.03)*rate)
        noise_level = 0.8*fit.burst
    else if onset == 2:
        # a fricative: s, sh or f
        noise_to = int(crowd_between(rng,0.05,0.1)*rate)
        which = int(crowd_unit(rng)*2.999)
        bandpass(hiss,[5800.0,3200.0,1800.0][which],[2.0,2.5,0.7][which])
        voiced_from = noise_to-int(0.01*rate)
        noise_level = [0.45,0.4,0.2][which]*fit.burst
    vowel = CROWD_VOWELS[CROWD_VOWEL_PICK[int(crowd_unit(rng)*11.999)]]
    locus = vec2(f32(if onset == 3: 290.0 else: 330.0),f32(crowd_between(rng,1100,1900)))
    coda = crowd_unit(rng) < fit.coda
    coda_from = if coda: n-int(crowd_between(rng,0.03,0.06)*rate) else: n
    attack = 0.02*rate; release = 0.035*rate
    loop i in 0..n+int(0.02*rate):
        at_i = (start+i)%out.len()          # (round the loop: the last syllable ends in the first second)
        # formants glide from the consonant's place to the vowel over 35 ms, retuned each 1.3 ms
        if i%64 == 0:
            g = clamp(f64(i-voiced_from)/(0.035*rate),0.0,1.0)
            if onset == 3 and i < voiced_from+int(0.05*rate): g = 0.0
            if i >= coda_from: g = 1.0-clamp(f64(i-coda_from)/(0.02*rate),0.0,0.7)
            bandpass(v.f1,(f64(locus.x)+(f64(vowel.x)-f64(locus.x))*g)*shift,5.0)
            bandpass(v.f2,(f64(locus.y)+(f64(vowel.y)-f64(locus.y))*g)*shift,7.0)
        s = 0.0
        if i >= voiced_from and i < n:
            # the glottal source: a tilted ramp, its period and loudness wobbling, air in it
            v.phase += f0*v.period_pitch/rate
            if v.phase >= 1.0:
                v.phase -= 1.0
                v.period_pitch = 1.0+(crowd_unit(rng)-0.5)*2.0*fit.jitter
                v.period_level = 1.0+(crowd_unit(rng)-0.5)*2.0*fit.shimmer
            ramp = 2.0*v.phase-1.0
            v.tilt += (ramp-v.tilt)*0.35
            env = min(1.0,f64(i-voiced_from)/attack)*min(1.0,f64(n-i)/release)
            breath = (crowd_unit(rng)-0.5)*fit.breath*(1.2-v.phase)
            src = (v.tilt*v.period_level+breath)*env
            level = if onset == 3 and i < voiced_from+int(0.05*rate): 0.45 else: 1.0
            s = (filt(v.f1,src)+filt(v.f2,src)*0.55+filt(v.f3,src)*0.22+filt(v.f4,src)*0.1)*level*loud
        else:
            _ = filt(v.f1,0.0); _ = filt(v.f2,0.0); _ = filt(v.f3,0.0); _ = filt(v.f4,0.0)
        if onset == 1 and i < noise_to:
            if i >= noise_to-int(0.016*rate): s += filt(burst,crowd_unit(rng)-0.5)*noise_level*loud
        else if onset == 1 and i >= noise_to and i < voiced_from+int(0.01*rate):
            s += filt(air,crowd_unit(rng)-0.5)*0.35*loud
        if onset == 2 and i < noise_to:
            u = f64(i)/f64(max(1,noise_to))
            s += filt(hiss,crowd_unit(rng)-0.5)*noise_level*sin(PI*u)*loud
        if coda and i >= coda_from and i < n and crowd_unit(rng) < 1.0:
            s += filt(hiss,crowd_unit(rng)-0.5)*0.12*loud
        out[at_i] += s

# the many beyond: speech-shaped noise, its loudness breathing slowly and, faintly, at syllable rate
crowd_far = (out: mut f64[],rng: mut u64):
    n = out.len(); rate = f64(MIX_RATE)
    low = Biquad(); bandpass(low,380.0,0.9); mid = Biquad(); bandpass(mid,1050.0,0.8); high = Biquad(); bandpass(high,2700.0,1.0)
    slow = 0.0; slow_to = crowd_unit(rng); fast = 0.0; fast_to = crowd_unit(rng)
    loop i in 0..n:
        if i%int(rate*0.4) == 0: slow_to = crowd_unit(rng)
        if i%int(rate*0.07) == 0: fast_to = crowd_unit(rng)
        slow += (slow_to-slow)*0.00012; fast += (fast_to-fast)*0.0012
        x = crowd_unit(rng)-0.5
        out[i] += (filt(low,x)*0.9+filt(mid,x)*0.6+filt(high,x)*0.22)*(0.35+0.65*slow)*(0.8+0.4*fast)

# people walking past on stone: heel and toe, nearer then farther
crowd_steps = (l: mut f64[],r: mut f64[],rng: mut u64,walkers: int):
    n = l.len(); rate = f64(MIX_RATE)
    loop w in 0..walkers:
        count = 5+int(crowd_unit(rng)*5.999)
        pace = crowd_between(rng,0.48,0.62)
        t = crowd_unit(rng)*f64(n)/rate
        pan = crowd_between(rng,-0.8,0.8); drift = crowd_between(rng,-0.3,0.3)
        tick = Biquad(); bandpass(tick,crowd_between(rng,1800,3200),1.2)
        loop k in 0..count:
            near = sin(PI*(f64(k)+0.5)/f64(count))
            level = (0.15+0.35*near)*crowd_between(rng,0.7,1.0)
            start = int(t*rate)
            p = clamp(pan+drift*f64(k)/f64(count),-1.0,1.0)
            loop i in 0..int(rate*0.05):
                e = f64(i)/rate
                s = (filt(tick,crowd_unit(rng)-0.5)*exp(-e*350.0)*3.0+sin(TAU*95.0*e)*exp(-e*60.0)*0.4)*level
                at = (start+i)%n
                l[at] += s*sqrt((1.0-p)*0.5); r[at] += s*sqrt((1.0+p)*0.5)
            t += pace*crowd_between(rng,0.95,1.05)

# glasses and cups on the tables, touched at uneven times
crowd_clinks = (l: mut f64[],r: mut f64[],rng: mut u64):
    n = l.len(); rate = f64(MIX_RATE)
    t = crowd_unit(rng)*0.4
    loop t < f64(n)/rate:
        hz = crowd_between(rng,2100,3600)
        cup = crowd_unit(rng) < 0.3
        if cup: hz *= 0.55
        ring = crowd_between(rng,0.35,0.9)
        pan = crowd_between(rng,-0.7,0.7)
        twice = crowd_unit(rng) < 0.25
        loop hit in 0..(if twice: 2 else: 1):
            start = int((t+f64(hit)*crowd_between(rng,0.04,0.09))*rate)
            decay = if cup: 95.0 else: crowd_between(rng,55,90)
            loop k in 0..int(rate*0.09):
                e = f64(k)/rate
                s = (sin(TAU*hz*e)+sin(TAU*hz*1.62*e)*0.5)*exp(-e*decay)*min(1.0,e*4000.0)*ring*0.12
                at = (start+k)%n
                l[at] += s*sqrt((1.0-pan)*0.5); r[at] += s*sqrt((1.0+pan)*0.5)
        t += crowd_between(rng,0.25,1.55)

# A square's reverb: four damped combs and two allpasses (Schroeder), run round the loop twice so
# its tail wraps into the start. `offset` detunes one ear's delays from the other's.
crowd_reverb = (x: f64[],rt60: f64,offset: f64) -> f64[]:
    n = x.len(); rate = f64(MIX_RATE)
    delays = [0.0297,0.0371,0.0411,0.0437]
    out = fill(0.0,n)
    loop d in delays:
        size = int((d+offset)*rate)
        line = fill(0.0,size); at = 0; damp = 0.0
        g = pow(10.0,-3.0*(d+offset)/rt60)
        loop round in 0..2:
            loop i in 0..n:
                y = line[at]
                damp += (y-damp)*0.45
                line[at] = x[i]+damp*g
                at = (at+1)%size
                if round == 1: out[i] += y*0.25
    loop d in [0.005,0.0017]:
        size = int((d+offset*0.1)*rate)
        line = fill(0.0,size); at = 0
        result = fill(0.0,n)
        loop round in 0..2:
            loop i in 0..n:
                buffered = line[at]
                y = -0.7*out[i]+buffered
                line[at] = out[i]+0.7*y
                at = (at+1)%size
                if round == 1: result[i] = y
        out = result
    out

# RBJ shelves, for the final fit of the long-term spectrum
crowd_shelf = (f: mut Biquad,freq: f64,db: f64,high: bool):
    a = pow(10.0,db/40.0)
    w = TAU*freq/f64(MIX_RATE); c = cos(w); s = sin(w)
    alpha = s/2.0*sqrt(2.0)
    root = 2.0*sqrt(a)*alpha
    if high:
        a0 = (a+1.0)-(a-1.0)*c+root
        f.b0 = a*((a+1.0)+(a-1.0)*c+root)/a0; f.b1 = -2.0*a*((a-1.0)+(a+1.0)*c)/a0; f.b2 = a*((a+1.0)+(a-1.0)*c-root)/a0
        f.a1 = 2.0*((a-1.0)-(a+1.0)*c)/a0; f.a2 = ((a+1.0)-(a-1.0)*c-root)/a0
    else:
        a0 = (a+1.0)+(a-1.0)*c+root
        f.b0 = a*((a+1.0)-(a-1.0)*c+root)/a0; f.b1 = 2.0*a*((a-1.0)-(a+1.0)*c)/a0; f.b2 = a*((a+1.0)-(a-1.0)*c-root)/a0
        f.a1 = -2.0*((a-1.0)+(a+1.0)*c)/a0; f.a2 = ((a+1.0)+(a-1.0)*c-root)/a0

struct CrowdBed:
    left: f64[]
    right: f64[]

# The bed, n samples a channel, seamless round its length (the caller crossfades `fade` more).
crowd_bed = (n: int,seed: int,fit: CrowdFit) -> CrowdBed:
    rate = f64(MIX_RATE); seconds = f64(n)/rate
    rng = u64(seed*1000003+5)
    l = fill(0.0,n); r = fill(0.0,n); send_l = fill(0.0,n); send_r = fill(0.0,n)
    loop who in 0..fit.near+fit.mid:
        near = who < fit.near
        voice = fill(0.0,n)
        # (each from its own moment; what runs past the end is wrapped into the start)
        crowd_talker(voice,rng,fit,crowd_unit(rng) < 0.5,crowd_between(rng,0.0,1.2),seconds)
        level = if near: crowd_between(rng,0.7,1.0) else: crowd_between(rng,0.25,0.55)
        # (a conversation waxes and wanes: the talker's level wanders between knots 1-2.5 s apart)
        knot = 0.0; from = crowd_unit(rng); to = crowd_unit(rng); span = crowd_between(rng,1.0,2.5)
        loop i in 0..n:
            u = (f64(i)/rate-knot)/span
            if u >= 1.0:
                knot += span; from = to; to = crowd_unit(rng); span = crowd_between(rng,1.0,2.5); u = 0.0
            e = from+(to-from)*u*u*(3.0-2.0*u)
            voice[i] *= 1.0-fit.swell+fit.swell*e
        wet = if near: fit.wet_near else: fit.wet_mid
        pan = crowd_between(rng,-fit.spread,fit.spread)
        gl = sqrt((1.0-pan)*0.5)*level; gr = sqrt((1.0+pan)*0.5)*level
        # (distance dulls the far side of the square)
        dull = Biquad(); lowpass(dull,if near: 9000.0 else: 3800.0)
        loop i in 0..n:
            s = filt(dull,voice[i])
            l[i] += s*gl*(1.0-wet*0.5); r[i] += s*gr*(1.0-wet*0.5)
            send_l[i] += s*gl*wet; send_r[i] += s*gr*wet
    total = 0.0
    loop v in l: total += v*v
    talk = sqrt(total/f64(n))
    far_l = fill(0.0,n); far_r = fill(0.0,n); far_both = fill(0.0,n)
    crowd_far(far_l,rng); crowd_far(far_r,rng); crowd_far(far_both,rng)
    loop i in 0..n:
        far_l[i] = far_l[i]*(1.0-fit.share)+far_both[i]*fit.share; far_r[i] = far_r[i]*(1.0-fit.share)+far_both[i]*fit.share
    total = 0.0
    loop v in far_l: total += v*v
    scale = fit.far_level*talk/max(sqrt(total/f64(n)),1e-9)
    loop i in 0..n:
        l[i] += far_l[i]*scale*(1.0-fit.wet_far*0.5); r[i] += far_r[i]*scale*(1.0-fit.wet_far*0.5)
        send_l[i] += far_l[i]*scale*fit.wet_far; send_r[i] += far_r[i]*scale*fit.wet_far
    # the low air of the place: deep, slowly wandering noise, much the same in both ears
    if fit.rumble > 0.0:
        deep = Biquad(); lowpass(deep,260.0); deeper = Biquad(); lowpass(deeper,260.0)
        side = Biquad(); lowpass(side,260.0)
        level = 0.0; level_to = 0.5
        loop round in 0..2:
            loop i in 0..n:
                if i%int(rate*0.6) == 0: level_to = crowd_unit(rng)
                level += (level_to-level)*0.00005
                common = filt(deeper,filt(deep,crowd_unit(rng)-0.5))
                own = filt(side,crowd_unit(rng)-0.5)
                if round == 1:
                    g = fit.rumble*talk*8.0*(0.7+0.3*level)
                    l[i] += (common*0.8+own*0.3)*g; r[i] += (common*0.8-own*0.3)*g
    crowd_steps(l,r,rng,fit.steps)
    if fit.clinks: crowd_clinks(l,r,rng)
    wet_l = crowd_reverb(send_l,fit.rt60,0.0); wet_r = crowd_reverb(send_r,fit.rt60,0.0023)
    lows = [Biquad(),Biquad()]; highs = [Biquad(),Biquad()]
    loop k in 0..2:
        crowd_shelf(lows[k],fit.low_hz,fit.low_db,false); crowd_shelf(highs[k],fit.high_hz,fit.high_db,true)
    # (warm the shelves round the loop first, so the seam carries no transient)
    loop round in 0..2:
        loop i in 0..n:
            a = filt(highs[0],filt(lows[0],l[i]+wet_l[i])); b = filt(highs[1],filt(lows[1],r[i]+wet_r[i]))
            if round == 1: l[i] = a; r[i] = b
    # crests rounded off at 3.5 times the bed's rms
    total = 0.0
    loop i in 0..n: total += l[i]*l[i]+r[i]*r[i]
    knee = sqrt(total/f64(2*n))*3.5
    if knee > 0.0:
        loop i in 0..n: l[i] = knee*tanh(l[i]/knee); r[i] = knee*tanh(r[i]/knee)
    CrowdBed(l,r)

# A stereo loop at `rms`, seamless: the bed is already round, so no crossfade is needed.
crowd_sound = (bed: CrowdBed,rms: f64) -> Sound:
    n = bed.left.len()
    total = 0.0
    loop i in 0..n: total += bed.left[i]*bed.left[i]+bed.right[i]*bed.right[i]
    g = rms/max(sqrt(total/f64(2*n)),1e-9)
    out = fill(f32(0),n*2)
    loop i in 0..n:
        out[i*2] = f32(clamp(bed.left[i]*g,-0.45,0.45)); out[i*2+1] = f32(clamp(bed.right[i]*g,-0.45,0.45))
    Sound(out)
