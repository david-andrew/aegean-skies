use 'targets.jo'
use 'hud.jo'
use 'render_space.jo'

# One unobtrusive marker, never a screen full of labels. Edge chevrons keep an aft target findable.
draw_view_target = (v:TargetView,fonts:Fonts):
    if v.selected<0 or v.selected>=v.items.len():return
    item=v.items[v.selected];eye=scene_camera()
    p=render_warped(item.position,eye,scene_warp_a,scene_warp_b)
    clip=scene_view_proj()*vec4(p,1)
    sw=f64(screen_width());sh=f64(screen_height())
    c=vec2(sw*0.5,sh*0.5)
    d=vec2(clip.x,-clip.y)/max(abs(clip.w),0.001)*vec2(sw*0.5,sh*0.5)
    edge=clip.w<=0 or abs(d.x)>sw*0.5-55 or abs(d.y)>sh*0.5-100
    if edge:
        if length(d)<0.001:d=vec2(0,1)
        d*=f32(min((sw*0.5-55)/max(0.001,abs(f64(d.x))),(sh*0.5-100)/max(0.001,abs(f64(d.y)))))
    at=c+d;color=if item.hostile:rgba(1,0.64,0.44,0.9) else:rgba(0.95,0.90,0.72,0.9)
    if edge:
        along=normalize(d);side=vec2(-along.y,along.x)
        line(at,at-along*9+side*5,1.5,color);line(at,at-along*9-side*5,1.5,color)
    else:
        loop sign in [-1.0,1.0]:
            x=at+vec2(sign*9,0)
            line(x+vec2(0,-6),x+vec2(0,6),1.2,color)
            line(x+vec2(0,-6),x+vec2(-sign*3,-6),1.2,color)
            line(x+vec2(0,6),x+vec2(-sign*3,6),1.2,color)
    label=item.name+(if v.looking:"  •" else:"")
    set_font(fonts.ui)
    x=clamp(f64(at.x),text_width(label,13)*0.5+8,sw-text_width(label,13)*0.5-8)
    text_centered(label,vec2(x+1,f64(at.y)+17),13,rgba(0.03,0.04,0.05,0.9))
    text_centered(label,vec2(x,f64(at.y)+16),13,color)
    set_font()
