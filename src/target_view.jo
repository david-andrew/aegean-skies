use 'targets.jo'
use 'hud.jo'
use 'render_space.jo'
use 'side_colours.jo'

# One unobtrusive marker, never a screen full of labels. Edge chevrons keep an aft target findable.
draw_view_target = (v:TargetView,fonts:Fonts):
    if v.selected<0 or v.selected>=v.items.len():return
    item=v.items[v.selected];eye=scene_camera()
    p=render_warped(item.position,eye,scene_warp_a,scene_warp_b)
    clip=scene_view_proj()*vec4(p,1)
    sw=f64(screen_width());sh=f64(screen_height())
    c=vec2(sw*0.5,sh*0.5)
    d=vec2(clip.x,-clip.y)/max(abs(clip.w),0.001)*vec2(sw*0.5,sh*0.5)
    edge=clip.w<=0 or abs(d.x)>sw*0.5-55 or abs(d.y)>sh*0.5-100
    if edge:
        if length(d)<0.001:d=vec2(0,1)
        d*=f32(min((sw*0.5-55)/max(0.001,abs(f64(d.x))),(sh*0.5-100)/max(0.001,abs(f64(d.y)))))
    at=c+d;color=side_colour(item.standing,0.9)
    if edge:
        along=normalize(d);side=vec2(-along.y,along.x)
        side_line(at,at-along*9+side*5,1.5,color);side_line(at,at-along*9-side*5,1.5,color)
        side_sign(at-along*20,item.standing,0.9)
    else: target_brackets(at,item.standing,0.9)
    label=item.name+(if v.looking:"  •" else:"")
    set_font(fonts.ui)
    x=clamp(f64(at.x),text_width(label,13)*0.5+8,sw-text_width(label,13)*0.5-8)
    target_name(label,vec2(x,f64(at.y)),color)
    set_font()

# The brackets round a target on the view, in its side's colour, its side's sign above them (not
# by colour alone).
target_brackets = (at: vec2, standing: Standing, alpha: f64):
    color=side_colour(standing,alpha)
    loop sign in [-1.0,1.0]:
        x=at+vec2(sign*9,0)
        side_line(x+vec2(0,-6),x+vec2(0,6),1.2,color)
        side_line(x+vec2(0,-6),x+vec2(-sign*3,-6),1.2,color)
        side_line(x+vec2(0,6),x+vec2(-sign*3,6),1.2,color)
    side_sign(at+vec2(0,-15),standing,alpha)

# Its name under them, over a dark outline (the font already set).
target_name = (label: str, at: vec2, color: vec4): side_text(label,vec2(f64(at.x),f64(at.y)+16),13,color)
