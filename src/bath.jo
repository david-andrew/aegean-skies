# Taking the waters at a hot spring (src/thermal_sites.jo's terraced baths): pay the keeper at
# the bathhouse door a few coins, change in the cabin, and sit in the hot pool among the bathers
# from the town while the steam drifts and time passes; out by the steps, change back. Opt-in
# leisure: nothing is needed, nothing measured. The bathers talk as people do in hot water: the
# weather, their aches, their work (the dialogue's own remarks), and now and then something
# worth knowing, a load someone wants carried (a lead). Springs like these were known and used
# in the islands of the time (Loutraki, Aidipsos, Ikaria, Methana), with plain bathhouses and a
# keeper taking a few lepta. Pure: the stages, the fee, what is said and when; the game draws
# the bathers, walks the pilot and keeps the world's ledger.

use 'living_types.jo'
use 'living_money.jo'

enum BathStage: none, to_cabin, changing, dressed, getting_in, soaking, getting_out, changing_out

const BATH_CENTS = 30               # thirty lepta for the waters
const BATH_CHANGE_SECONDS = 1.6     # (in the cabin: the pilot out of sight)
const BATH_IN_SECONDS = 1.4         # (down the steps and settling into the water)

struct Bath:
    stage: BathStage = .none
    site = -1                       # (THERMAL_SITES index)
    paid_day = -1                   # (the world's day the waters were paid for: good all that day)
    costume = false                 # (changed into a bathing costume)
    since = 0.0
    settle = 0.0                    # (0 standing at the pool's steps .. 1 sitting in the water)
    then_in = false                 # (changed, go on into the pool)
    bathers: int[]                  # (living-world people in the pool)
    speaker = -1
    line = ""
    line_until = 0.0
    next_line = 0.0
    lines_said = 0
    lead_said = false

# What the keeper says at the door, and his thanks.
bath_keeper_ask = (paid: bool) -> str: if paid: "You've paid for today. The cabin's on the left." else: "Thirty lepta for the waters. There's a cabin to change in."
bath_keeper_thanks = () -> str: "Mind the steps, they're slippery. Not too long in the hot one."

bath_paid_today = (b: Bath, day: int, site: int) -> bool: b.paid_day == day and b.site == site

# The small talk of hot water, between the dialogue's own remarks.
BATH_TALK = ["It does my back good, this.", "Hotter than yesterday, I'd say.",
    "My mother came here every spring. Swore by it.", "Don't stay in too long, it goes to your head.",
    "The steam's thick today.", "You're the flier, aren't you? We hear you go over.",
    "The doctor says twenty minutes. I never listen.", "Smell that? That's the sulphur. That's how you know it works."]

# Who speaks next: each bather in turn.
bath_next_speaker = (b: Bath) -> int: if b.bathers.len() == 0: -1 else: b.lines_said % b.bathers.len()

bath_line_due = (b: Bath, now: f64) -> bool: b.stage == .soaking and b.bathers.len() > 0 and now >= b.next_line

# The line: now and then a lead (something worth knowing, said once a soak), else the dialogue's
# remark for that person (their day, the weather) every other time, else the water's small talk.
bath_pick_line = (b: Bath, lead: str, remark: str) -> str:
    n = b.lines_said
    if lead != "" and not b.lead_said and n % 4 == 2: return "{lead}, I heard. If you're flying that way."
    if remark != "" and n % 2 == 1: return remark
    BATH_TALK[(n * 3) % BATH_TALK.len()]

bath_said = (b: mut Bath, speaker: int, line: str, now: f64):
    if line.ends_with(", I heard. If you're flying that way."): b.lead_said = true
    b.speaker = speaker; b.line = line; b.line_until = now + 6.0
    b.lines_said += 1
    b.next_line = now + 9.0 + f64(b.lines_said % 3) * 2.0

# Minutes of the world's clock a second of soaking passes: the afternoon goes by, unhurried.
const BATH_MINUTES_A_SECOND = 1.0

# The waters paid for: the player's coins to whoever keeps the bathhouse (the town's innkeeper, or
# the town's own account). False when he hasn't the coins.
bath_pay = (w: mut World, owner: int, place: int) -> bool: transfer(w, w.people[w.player].account, owner, BATH_CENTS, .rent, place)

# A lift to the springs paid for, set down at their harbour: their coins to the pilot (src/joyride.jo
# ride_lift_*). False when they haven't the coins.
lift_fare_pay = (w: mut World, person: int, cents: int, place: int) -> bool: transfer(w, w.people[person].account, w.people[w.player].account, cents, .trade, place)
