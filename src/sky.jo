use 'depth_space.jo'
use 'sky_air.jo'
# The sky: drawn behind everything as one screen-filling triangle. A deep blue overhead fading
# to a pale, luminous horizon; the sun's disc and its glow (golden and wide when it is low), and
# stars at night.

use 'look.jo'
use 'quality.jo'
use 'celestial.jo'
use 'paint.jo'
use 'render_space.jo'
use 'weather_scene.jo'

struct SkyVertex:
    pos: vec2

struct SkyParams:
    rays: mat4
    top: vec3
    horizon: vec3
    haze: vec3
    sea: vec3
    sun_dir: vec3
    sun: vec3
    night: f32
    time: f32
    altitude: f32
    moon_dir: vec3
    cirrus: f32
    planets:vec4[4]
    far_z: f32

struct SkyOut:
    pos: vec4
    ndc: vec2

sky_vs = (v: SkyVertex, u: SkyParams) -> SkyOut: SkyOut(vec4(v.pos, u.far_z, 1), v.pos)

sky_color = (dir: vec3, u: SkyParams) -> vec3:
    h = max(u.altitude, 0.0)
    dip = sqrt(h * (2.0 * f32(EARTH_RADIUS) + h)) / (f32(EARTH_RADIUS) + h)
    y = dir.y + dip
    l = normalize(u.sun_dir)
    sd = max(dot(dir, l), 0.0)
    # the gradient: deep overhead, a band of pale haze along the horizon
    c = sky_air_color(dir.y,u.altitude,l.y,u.top,u.horizon,u.haze)
    band = exp(-max(y, 0.0) * 28.0)
    # Warm forward scattering is confined to the solar side; the opposite
    # horizon retains the cool blue air rather than becoming uniformly orange.
    daylight = smoothstep(-0.12, 0.04, l.y)
    low_sun = (1.0 - smoothstep(0.05, 0.5, l.y)) * daylight
    warm = vec3(1.0, 0.51, 0.24)
    c = mix(c, u.top, low_sun * (1.0 - pow(sd, 3.0)) * band * 0.3)
    c += u.sun * (pow(sd, 6.0) * 0.14 + pow(sd, 40.0) * 0.22) * daylight
    c += warm * (pow(sd, 18.0) * low_sun * exp(-abs(y) * 5.0) * 0.2)
    c += u.sun * smoothstep(SKY_DISC_OUTER, SKY_DISC_INNER, sd) * 4.0 * daylight
    if u.night > 0.0:
        cell_pos = dir.xz / max(dir.y + 0.3, 0.03) * 240.0
        cell = floor(cell_pos)
        s = hash21(cell)
        # Derivatives must precede the per-star (nonuniform) branch on GLES.
        aa = max(length(vec2(fwidth(cell_pos.x), fwidth(cell_pos.y))), 0.02)
        if s > 0.989 and y > 0.0:
            point = vec2(hash21(cell + vec2(17, 5)), hash21(cell + vec2(3, 29))) * 0.6 + vec2(0.2, 0.2)
            d = length(fract(cell_pos) - point)
            # A compact antialiased point instead of a whole square noise cell.
            star = (1.0 - smoothstep(0.035, 0.035 + aa, d)) * min(1.0, 0.012 / (aa * aa))
            tw = 0.85 + 0.15 * sin(u.time * (1.3 + s) + s * 430.0)
            c += vec3(1, 0.97, 0.9) * (u.night * star * tw * smoothstep(0.0, 0.15, y) * 2.0)
    # Steady planet points precede the much fainter, twinkling star field in
    # twilight. Their apparent dots deliberately share the old small Moon's scale.
    if l.y < 0.12:
        loop k in 0..4:
            planet=u.planets[k]
            radius=if k==0:0.00465 else:if k==1:0.0038 else:0.0033
            d=length(dir-planet.xyz)/radius
            visible=1.0-smoothstep(if k==0:-0.04 else:-0.065,if k==0:0.12 else:0.065,l.y)
            visible*=smoothstep(0.0,0.025,y)*(1.0-smoothstep(0.35,1.2,dot(c,vec3(0.2126,0.7152,0.0722)))*0.8)
            # No time term: unlike stars these do not twinkle. A soft painted edge,
            # no lens flare rays or animated screen-space halos.
            point=(1.0-smoothstep(0.55,1.15,d))+exp(-d*d*1.8)*0.18
            tint=if k==2:vec3(1,0.73,0.57) else:if k==1:vec3(1,0.95,0.82) else:vec3(1,0.98,0.94)
            c+=tint*planet.w*visible*point
    # Moon disk: illuminate the near hemisphere with the same solar direction
    # used by terrain and clouds. Crescent orientation follows the Sun in 3D.
    moon = normalize(u.moon_dir)
    # (at night the Moon glows: a soft halo in the air about it, broader and fainter outward,
    # as bright as it is full)
    if u.night > 0.0 and y > -0.01 and moon.y > -0.02:
        ang = acos(clamp(dot(dir,moon),-1.0,1.0))
        full = clamp((1.0-dot(normalize(u.sun_dir),moon))*0.5,0.0,1.0)
        halo = exp(-ang*ang/(0.11*0.11))*0.10+exp(-ang*ang/(0.035*0.035))*0.16
        c += vec3(0.72,0.78,0.9)*halo*full*u.night*smoothstep(-0.02,0.06,moon.y)
    if dot(dir,moon)>SKY_DISC_OUTER and y > -0.01:
        right = normalize(cross(if abs(moon.y)>0.98:vec3(0,0,1) else:vec3(0,1,0), moon))
        up = cross(moon, right)
        radius: f32 = SKY_DISC_RADIUS
        xy = vec2(dot(dir, right), dot(dir, up)) / radius
        rr = dot(xy, xy)
        disk = smoothstep(SKY_DISC_OUTER,SKY_DISC_INNER,dot(dir,moon))
        normal = right * xy.x + up * xy.y - moon * sqrt(max(1.0 - rr, 0.0))
        lit = smoothstep(-0.03, 0.12, dot(normal, l))
        maria = 0.88 + 0.12 * vnoise(xy * 5.0 + vec2(11, 3))
        earthshine = 0.025 * u.night
        lunar = vec3(0.92, 0.94, 1.0) * (lit * 0.8 + earthshine) * maria
        # The sky lies in front of the Moon: by day its lit side is a pale, faintly
        # blue wash over the blue, low in contrast, softer toward the horizon where
        # more air lies in front, and its dark side is only sky. Toward night the
        # sky in front fades and the Moon takes its full night brightness.
        pale = mix(vec3(0.84, 0.88, 0.93), c, 0.3)
        day_moon = mix(c, pale, lit * maria * 0.6 * mix(0.5, 1.0, smoothstep(0.0, 0.25, y)))
        night_moon = c * (1.0 - u.night * 0.85) + lunar * 1.35
        c = mix(c, mix(day_moon, night_moon, u.night), disk * smoothstep(-0.01, 0.03, y))
    q = dir.xz/max(dir.y,0.025)*3.0+vec2(u.time*0.0007,0)
    feather_filter = 1.0-smoothstep(0.2,0.6,length(vec2(fwidth(q.x),fwidth(q.y))))
    if dir.y > 0.08 and u.cirrus > 0.0:
        curl = vnoise(q*0.7)
        filament = vnoise(vec2(q.x*0.45,q.y*5.0+curl*7.0))
        veil = smoothstep(0.62,0.9,filament)*smoothstep(0.45,0.8,curl)*u.cirrus*feather_filter*smoothstep(0.08,0.3,dir.y)
        c = mix(c,mix(u.haze,u.sun,0.4),veil*daylight*0.4)
    c

sky_fs = (i: SkyOut, u: SkyParams) -> vec4:
    dir = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    c = sky_color(dir,u)
    vec4(c*paint_paper(i.pos.xy),1)
sky_sh: Shader
sky_tri: Mesh

draw_sky = (L: Light, t: f64):
    night = f64(L.stars)
    # (the sky writes no depth: it is behind everything, however far)
    depth_write(false)
    draw(sky_sh, sky_tri, SkyParams(render_rays(scene_view_proj()), L.sky_top, L.sky_horizon, L.haze, L.sea_deep, L.sun_dir, L.sun, f32(night), f32(t), scene_camera().y, L.moon_dir,if weather_active: weather_here.cirrus else: 0.0,L.planets,far_depth()))
    if L.afterglow.x > 0.0: draw_glow_band(L)
    depth_write(true)

# ---------------- twilight's glow: a band of painted geometry ----------------
# The amber band low on the sun's side after sunset (look.jo Light.afterglow), drawn over the sky
# as a strip of the sky dome round the horizon: its colour and cover worked out at each vertex
# (72 bearings by 10 heights; the band is a smooth gradient) and blended in, the pixels only
# passing on what they are given. Any addition to the sky's or the sea's own shaders cost Intel
# GPUs half a millisecond, even a single blend; this costs next to nothing on every tier.
struct GlowVertex:
    at: vec2                        # x the bearing from the sun's (rad), y the height above the horizon (rad)

struct GlowParams:
    view_proj: mat4
    glow: vec4                      # Light.afterglow: strength, 1 / the band's height, the way to the sun (x, z)
    dip: f32                        # how far below level the horizon lies (the eye's height)
    far_z: f32

struct GlowOut:
    pos: vec4
    colour: vec4                    # premultiplied

glow_band_vs = (v: GlowVertex, u: GlowParams) -> GlowOut:
    bearing = atan2(u.glow.w, u.glow.z)+v.at.x
    e = v.at.y-u.dip
    dir = vec3(cos(e)*cos(bearing),sin(e),cos(e)*sin(bearing))
    clip = u.view_proj*vec4(dir,0)
    facing = cos(v.at.x)*0.5+0.5
    side = facing*facing*facing
    up = v.at.y*u.glow.y
    warm = mix(vec3(0.92,0.53,0.25),vec3(0.93,0.8,0.55),clamp(up*1.18-0.06,0.0,1.0))
    colour = mix(vec3(0.5,0.38,0.44),warm,clamp(facing*1.67-0.25,0.0,1.0))
    a = min(u.glow.x*exp(-up*0.9)*mix(0.22,0.97,side),0.97)
    GlowOut(vec4(clip.xy,clip.w*u.far_z,clip.w),vec4(colour*a,a))

glow_band_fs = (i: GlowOut, u: GlowParams) -> vec4: i.colour

const GLOW_BEARINGS = 72
GLOW_HEIGHTS = [0.0, 0.015, 0.04, 0.08, 0.13, 0.19, 0.27, 0.37, 0.5, 0.75]
glow_band_sh = Shader()
glow_band_mesh = Mesh()

build_glow_band = () -> Mesh:
    vs: GlowVertex[]
    idx: u32[]
    rows = GLOW_HEIGHTS.len()
    loop i in 0..GLOW_BEARINGS+1:
        a = (f64(i) / f64(GLOW_BEARINGS) * 2.0 - 1.0) * PI
        loop j in 0..rows: vs.push(GlowVertex(vec2(f32(a), f32(GLOW_HEIGHTS[j]))))
    loop i in 0..GLOW_BEARINGS:
        loop j in 0..rows-1:
            p = u32(i * rows + j); q = p + u32(rows)
            idx.extend([p, q, p + 1, p + 1, q, q + 1])
    mesh(vs, idx)

draw_glow_band = (L: Light):
    h = max(f64(scene_camera().y), 0.0)
    dip = sqrt(h * (2.0 * EARTH_RADIUS + h)) / (EARTH_RADIUS + h)
    cull(.none)
    blend(.premultiplied)
    draw(glow_band_sh, glow_band_mesh, GlowParams(scene_view_proj(), L.afterglow, f32(dip),far_depth()))
    blend(.alpha)

# (the GPU programs: made once the window is open)
init_sky = ():
    global sky_sh, sky_tri
    sky_sh = make_shader(shader(sky_vs, sky_fs))
    sky_tri = mesh([SkyVertex(vec2(-1, -1)), SkyVertex(vec2(3, -1)), SkyVertex(vec2(-1, 3))])
    global glow_band_sh, glow_band_mesh
    glow_band_sh = make_shader(shader(glow_band_vs, glow_band_fs))
    glow_band_mesh = build_glow_band()
