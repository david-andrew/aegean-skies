use 'depth_space.jo'
use 'sky_air.jo'
# The sky: drawn behind everything as one screen-filling triangle. A deep blue overhead fading
# to a pale, luminous horizon; the sun's disc and its glow (taking the day's sunset palette), and
# over it the night's lights (night_sky.jo: the Moon, the stars, the planets, the Milky Way).

use 'look.jo'
use 'day_air.jo'
use 'quality.jo'
use 'celestial.jo'
use 'paint.jo'
use 'render_space.jo'
use 'weather_scene.jo'
use 'night_sky.jo'

struct SkyVertex:
    pos: vec2

struct SkyParams:
    rays: mat4
    top: vec3
    horizon: vec3
    haze: vec3
    sea: vec3
    sun_dir: vec3
    sun: vec3
    time: f32
    altitude: f32
    cirrus: f32
    far_z: f32
    warm: vec3 = vec3(1.0, 0.51, 0.24)

struct SkyOut:
    pos: vec4
    ndc: vec2

sky_vs = (v: SkyVertex, u: SkyParams) -> SkyOut: SkyOut(vec4(v.pos, u.far_z, 1), v.pos)

sky_color = (dir: vec3, u: SkyParams) -> vec3:
    h = max(u.altitude, 0.0)
    dip = sqrt(h * (2.0 * f32(EARTH_RADIUS) + h)) / (f32(EARTH_RADIUS) + h)
    y = dir.y + dip
    l = normalize(u.sun_dir)
    sd = max(dot(dir, l), 0.0)
    # the gradient: deep overhead, a band of pale haze along the horizon
    c = sky_air_color(dir.y,u.altitude,l.y,u.top,u.horizon,u.haze)
    band = exp(-max(y, 0.0) * 28.0)
    # Warm forward scattering is confined to the solar side; the opposite
    # horizon retains the cool blue air rather than becoming uniformly orange.
    daylight = smoothstep(-0.12, 0.04, l.y)
    low_sun = (1.0 - smoothstep(0.05, 0.5, l.y)) * daylight
    c = mix(c, u.top, low_sun * (1.0 - pow(sd, 3.0)) * band * 0.3)
    c += u.sun * (pow(sd, 6.0) * 0.14 + pow(sd, 40.0) * 0.22) * daylight
    c += u.warm * (pow(sd, 18.0) * low_sun * exp(-abs(y) * 5.0) * 0.2)
    # (the sun's disc is its own small billboard over this: draw_sun_disc; the Moon, the stars, the
    # planets and the Milky Way are their own geometry too: night_sky.jo)
    q = dir.xz/max(dir.y,0.025)*3.0+vec2(u.time*0.0007,0)
    feather_filter = 1.0-smoothstep(0.2,0.6,length(vec2(fwidth(q.x),fwidth(q.y))))
    if dir.y > 0.08 and u.cirrus > 0.0:
        curl = vnoise(q*0.7)
        filament = vnoise(vec2(q.x*0.45,q.y*5.0+curl*7.0))
        veil = smoothstep(0.62,0.9,filament)*smoothstep(0.45,0.8,curl)*u.cirrus*feather_filter*smoothstep(0.08,0.3,dir.y)
        c = mix(c,mix(u.haze,u.sun,0.4),veil*daylight*0.4)
    c

sky_fs = (i: SkyOut, u: SkyParams) -> vec4:
    dir = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    c = sky_color(dir,u)
    vec4(c*paint_paper(i.pos.xy),1)
sky_sh: Shader
sky_tri: Mesh

draw_sky = (L: Light, t: f64):
    # (the night's air: what the twilight, the Moon, the haze and the cloud overhead let through)
    cover = if weather_active: f64(clamp(weather_here.deck*0.8+weather_here.rain*0.65,0.0,0.95)) else: 0.0
    air = night_air(L, cover, f64(scene_camera().y))
    # (the sky writes no depth: it is behind everything, however far)
    depth_write(false)
    draw(sky_sh, sky_tri, SkyParams(render_rays(scene_view_proj()), night_sky_top(L.sky_top, air), L.sky_horizon, L.haze, L.sea_deep, L.sun_dir, L.sun*L.glare, f32(t), scene_camera().y,if weather_active: weather_here.cirrus else: 0.0,far_depth(), L.sunset_warm))
    draw_night_stars(L, air, t)
    if L.afterglow.x > 0.0: draw_glow_band(L)
    if L.bishops_ring > 0.001: draw_bishops_ring(L)
    draw_night_moon(L, air)
    # (the disc over the glow band: the band is the air's glow about the sun, not in front of it)
    draw_sun_disc(L, t)
    depth_write(true)

# ---------------- twilight's glow: a band of painted geometry ----------------
# The twilight band low on the sun's side (look.jo Light.afterglow), drawn over the sky as a strip
# of the sky dome round the horizon: its colour and cover worked out at each vertex (72 bearings by
# 13 heights; the band is a smooth gradient) and blended in, the pixels only passing on what they are
# given. Any addition to the sky's or the sea's own shaders cost Intel GPUs half a millisecond, even
# a single blend; this costs next to nothing on every tier.
struct GlowVertex:
    at: vec2                        # x the bearing from the sun's (rad), y the height above the horizon (rad)

struct GlowParams:
    view_proj: mat4
    glow: vec4                      # Light.afterglow: strength, 1 / the band's height, the way to the sun (x, z)
    band_low: vec3                  # low horizon colour on the sun's side
    band_high: vec3                 # upper band colour on the sun's side
    band_belt: vec3                 # opposite horizon belt colour
    dip: f32                        # how far below level the horizon lies (the eye's height)
    far_z: f32

struct GlowOut:
    pos: vec4
    colour: vec4                    # premultiplied

# The band's colour and cover (premultiplied) at a bearing from the sun's and a height above the
# horizon (rad), for an explicit palette triple: fading to nothing at the zenith, so no top edge.
glow_band_colour_of = (at: vec2, glow: vec4, band_low: vec3, band_high: vec3, band_belt: vec3) -> vec4:
    facing = cos(at.x)*0.5+0.5
    side = facing*facing*facing
    up = at.y*glow.y
    warm = mix(band_low, band_high, clamp(up*1.18-0.06, 0.0, 1.0))
    colour = mix(band_belt, warm, clamp(facing*1.67-0.25, 0.0, 1.0))
    a = min(glow.x*exp(-up*0.9)*mix(0.22,0.97,side),0.97)*(1.0-smoothstep(0.75,1.5,at.y))
    vec4(colour*a,a)

# Baseline-palette helper (keeps tests/sky_seam_test.jo compatible).
glow_band_colour = (at: vec2, glow: vec4, sunset: f32) -> vec4:
    low = mix(vec3(0.92,0.53,0.25),vec3(1.0,0.42,0.12),sunset)
    high = mix(vec3(0.93,0.8,0.55),vec3(0.94,0.58,0.5),sunset)
    belt = mix(vec3(0.5,0.38,0.44),vec3(0.86,0.6,0.66),sunset)
    glow_band_colour_of(at, glow, low, high, belt)

glow_band_vs = (v: GlowVertex, u: GlowParams) -> GlowOut:
    bearing = atan2(u.glow.w, u.glow.z)+v.at.x
    e = v.at.y-u.dip
    dir = vec3(cos(e)*cos(bearing),sin(e),cos(e)*sin(bearing))
    clip = u.view_proj*vec4(dir,0)
    GlowOut(vec4(clip.xy,clip.w*u.far_z,clip.w),glow_band_colour_of(v.at,u.glow,u.band_low,u.band_high,u.band_belt))

# The band as its strip draws it at a bearing and height: straight between the strip's rows of
# vertices, and nothing above its top row (tests: the sky has no step from horizon to zenith).
glow_band_drawn_of = (at: vec2, glow: vec4, band_low: vec3, band_high: vec3, band_belt: vec3, heights: f64[]) -> vec4:
    n = heights.len()
    if f64(at.y) >= heights[n-1]: return vec4(0,0,0,0)
    loop j in 0..n-1:
        if f64(at.y) < heights[j+1]:
            t = f32((f64(at.y)-heights[j])/(heights[j+1]-heights[j]))
            return mix(glow_band_colour_of(vec2(at.x,f32(heights[j])),glow,band_low,band_high,band_belt),glow_band_colour_of(vec2(at.x,f32(heights[j+1])),glow,band_low,band_high,band_belt),t)
    vec4(0,0,0,0)

glow_band_drawn = (at: vec2, glow: vec4, sunset: f32, heights: f64[]) -> vec4:
    low = mix(vec3(0.92,0.53,0.25),vec3(1.0,0.42,0.12),sunset)
    high = mix(vec3(0.93,0.8,0.55),vec3(0.94,0.58,0.5),sunset)
    belt = mix(vec3(0.5,0.38,0.44),vec3(0.86,0.6,0.66),sunset)
    glow_band_drawn_of(at, glow, low, high, belt, heights)

glow_band_fs = (i: GlowOut, u: GlowParams) -> vec4: i.colour

const GLOW_BEARINGS = 72
# (to the zenith, where it has faded to nothing: stopped at 43 degrees its top edge showed in a
# view pitched up, a darker cap of plain sky above it)
GLOW_HEIGHTS = [0.0, 0.015, 0.04, 0.08, 0.13, 0.19, 0.27, 0.37, 0.5, 0.75, 1.0, 1.25, 1.5708]
glow_band_sh = Shader()
glow_band_mesh = Mesh()

build_glow_band = () -> Mesh:
    vs: GlowVertex[]
    idx: u32[]
    rows = GLOW_HEIGHTS.len()
    loop i in 0..GLOW_BEARINGS+1:
        a = (f64(i) / f64(GLOW_BEARINGS) * 2.0 - 1.0) * PI
        loop j in 0..rows: vs.push(GlowVertex(vec2(f32(a), f32(GLOW_HEIGHTS[j]))))
    loop i in 0..GLOW_BEARINGS:
        loop j in 0..rows-1:
            p = u32(i * rows + j); q = p + u32(rows)
            idx.extend([p, q, p + 1, p + 1, q, q + 1])
    mesh(vs, idx)

draw_glow_band = (L: Light):
    h = max(f64(scene_camera().y), 0.0)
    dip = sqrt(h * (2.0 * EARTH_RADIUS + h)) / (EARTH_RADIUS + h)
    cull(.none)
    blend(.premultiplied)
    draw(glow_band_sh, glow_band_mesh, GlowParams(scene_view_proj(), L.afterglow, L.glow_low, L.glow_high, L.glow_belt, f32(dip), far_depth()))
    blend(.alpha)

# ---------------- Bishop's ring: high-altitude volcanic aerosol ring ----------------
# A very broad, subdued ring (inner whitish-bluish region to ~22 deg, dusty reddish-brown outer
# coloration around 26-34 deg), drawn only on exceptional volcanic days as a vertex-coloured dome
# annulus centred on the sun: zero cost on ordinary days, negligible when present.
struct RingVertex:
    at: vec4                        # x azimuth around sun (rad), y angular radius (rad), z/w colour weights

struct RingParams:
    view_proj: mat4
    sun_dir: vec3
    strength: f32
    dip: f32
    far_z: f32

struct RingOut:
    pos: vec4
    colour: vec4

bishops_ring_vs = (v: RingVertex, u: RingParams) -> RingOut:
    s = normalize(u.sun_dir)
    right = normalize(cross(s, vec3(0, 1, 0)) + vec3(0.00001, 0, 0))
    up = cross(right, s)
    ca = cos(v.at.x); sa = sin(v.at.x)
    rad = v.at.y
    dir = normalize(s * cos(rad) + (right * ca + up * sa) * sin(rad))
    clip = u.view_proj * vec4(dir, 0)
    above = smoothstep(-0.01, 0.05, dir.y + u.dip)
    # Pale whitish-blue inner region (z), subdued reddish-brown volcanic outer rim (w)
    col = vec3(0.76, 0.80, 0.88) * v.at.z + vec3(0.68, 0.44, 0.40) * v.at.w
    a = (v.at.z * 0.14 + v.at.w * 0.22) * u.strength * above
    RingOut(vec4(clip.xy, clip.w * u.far_z, clip.w), vec4(col * a, a))

bishops_ring_fs = (i: RingOut, u: RingParams) -> vec4: i.colour

bishops_ring_sh = Shader()
bishops_ring_mesh = Mesh()

build_bishops_ring = () -> Mesh:
    vs: RingVertex[]
    idx: u32[]
    segs = 48
    # (angular radius in rad, inner whitish-blue weight, outer dusty rust-brown weight)
    rings = [
        vec3(0.14, 0.0, 0.0),
        vec3(0.28, 0.75, 0.0),
        vec3(0.38, 0.55, 0.35),
        vec3(0.47, 0.10, 1.0),
        vec3(0.58, 0.0, 0.55),
        vec3(0.72, 0.0, 0.0)
    ]
    rows = rings.len()
    loop i in 0..segs+1:
        a = f64(i) / f64(segs) * TAU
        loop j in 0..rows:
            r = rings[j]
            vs.push(RingVertex(vec4(f32(a), r.x, r.y, r.z)))
    loop i in 0..segs:
        loop j in 0..rows-1:
            p = u32(i * rows + j); q = p + u32(rows)
            idx.extend([p, q, p + 1, p + 1, q, q + 1])
    mesh(vs, idx)

draw_bishops_ring = (L: Light):
    s = normalize(L.sun_dir)
    h = max(f64(scene_camera().y), 0.0)
    dip = sqrt(h * (2.0 * EARTH_RADIUS + h)) / (EARTH_RADIUS + h)
    if f64(s.y) + dip < -0.02: return
    cull(.none)
    blend(.premultiplied)
    draw(bishops_ring_sh, bishops_ring_mesh, RingParams(scene_view_proj(), s, L.bishops_ring, f32(dip), far_depth()))
    blend(.alpha)

# ---------------- the sun's disc ----------------
# A small square of the sky round the sun, drawn over the sky (the sky's own shader keeps only the
# sun's glow). High up the disc is white. Low down it takes the day's sunset palette as distinct
# disc and aureole layers, and the air flattens it. Touching the water, the warm air over the sea
# bends its foot into wavering slices and joins it to its own upside-down image, a short neck
# into the horizon. On a clear sea horizon with an inversion, the final upper sliver can briefly
# show a green (or very rare blue) flash. Everything that differs by the sun's height is worked out
# on the CPU. The disc is its real size (celestial.jo SUN_DISC_RADIUS); the light about it keeps the
# reach it was painted with (in SKY_DISC_RADIUS units), so the sunsets' aureoles are as they were.
# In a solar eclipse (eclipse.jo) the Moon's disc takes its bite out of the Sun's; near totality its
# ragged limb leaves Baily's beads and the diamond ring, and in totality the corona stands round it.
struct SunVertex:
    at: vec2                        # the corner, in disc radii (y toward the zenith)

struct SunParams:
    view_proj: mat4
    sun_dir: vec3
    top: vec3                       # the disc's colour at its top
    foot: vec3                      # ... and at its foot
    shape: vec4                     # x the disc's centre over the visible horizon (disc radii), y how low (0 high, 1 on the water),
                                    # z the time (s), w the flattening (height / width)
    size: f32                       # the disc's radius over its height in the sky's (larger low down)
    soft: f32                       # its edge's extra softness (thick air)
    bloom: vec4                     # the aureole about the sun: its colour (xyz) and strength (w)
    halo: vec4                      # x post-set horizon glow strength; y aureole falloff scale (1 baseline, <1 broader);
                                    # z additive shine share (0.3 baseline); w the square's half size (painted radii)
    set_colour: vec3                # post-set horizon glow colour
    flash: vec4                     # horizon flash (green / blue / violet): colour (xyz) and strength (w, 0 off)
    corona: f32                     # faint WMO mist diffraction corona strength (0 off)
    far_z: f32
    eclipse: vec4 = vec4(0,0,0,0)   # Light.eclipse: the Moon's offset (xy, the Sun's radii), z its radius (0: no eclipse), w the share covered
    eclipse_look: vec4 = vec4(0,0,0,0) # x totality (the corona, 0..1), y the corona's seed, z the diamond ring, w Baily's beads
    disc: f32 = 0.169883            # the disc's radius in painted radii (celestial.jo sun_disc_share)

struct SunOut:
    pos: vec4
    at: vec2                        # in painted radii (SKY_DISC_RADIUS * size)

const SUN_QUAD: f32 = 1.6           # the square's half size, in painted radii (larger with a halo: SunParams.halo.w)
const CORONA_REACH: f32 = 15.0      # the corona's outer streamers, in the Sun's radii

sun_disc_vs = (v: SunVertex, u: SunParams) -> SunOut:
    s = normalize(u.sun_dir)
    right = normalize(cross(s, vec3(0,1,0)) + vec3(0.00001,0,0))
    up = cross(right, s)
    dir = s + (right*v.at.x + up*v.at.y)*(u.halo.w*SKY_DISC_RADIUS*u.size)
    clip = u.view_proj*vec4(dir,0)
    SunOut(vec4(clip.xy,clip.w*u.far_z,clip.w),v.at*u.halo.w)

# (in shaders) the corona's light at q (the Sun's radii from its centre, outside the disc): a bright
# inner corona falling off steeply, fine radial streamers all round, a few broad helmet streamers
# near its equator narrowing into long faint rays, and short plumes at its poles. The seed turns
# its axis and places the streamers, so each eclipse has its own.
corona_light = (q: vec2, seed: f32) -> f32:
    l = max(length(q), 0.0001)
    r = max(l, 1.0)
    dir = q / l
    tilt = seed * 2.39996
    pole = vec2(cos(tilt), sin(tilt))
    slat = dot(dir, pole)
    # (the rays bend a little away from the equator with height, as the field lines do)
    bend = (r - 1.0) * 0.035 * slat
    cb = cos(bend); sb = sin(bend)
    d2 = vec2(dir.x * cb - dir.y * sb, dir.x * sb + dir.y * cb)
    fine = vnoise(d2 * 15.0 + vec2(seed * 3.1, 7.0)) * 0.55 + vnoise(d2 * 37.0 + vec2(1.3, seed * 1.7)) * 0.45
    fine = 0.45 + fine * fine * 0.9
    inner = 1.2 * pow(r, -4.6)
    k = 0.55 * pow(r, -2.4) * (0.35 + 0.95 * fine)
    # (and the pearly glow it makes in the air about it, so it shows in a wide view)
    pearl = 0.06 * pow(r, -1.5)
    st: f32 = 0.0
    loop i in 0..5:
        fi = f32(i)
        h = fract(sin(seed * 12.9898 + fi * 78.233) * 43758.5453)
        g = fract(sin(seed * 39.3468 + fi * 11.135) * 24634.6345)
        # (mostly toward the equator, either side, one now and then at a high latitude)
        lat = (h - 0.5) * (if i == 4: 2.2 else: 0.9)
        side = if i % 2 == 0: 0.0 else: 3.14159
        ang = tilt + 1.5708 + side + lat
        sd = vec2(cos(ang), sin(ang))
        dist = length(d2 - sd)
        # (broad at the base, narrowing to a thin ray: a helmet and its stalk)
        width = (0.16 + 0.42 * exp(-(r - 1.0) * 0.8)) * (0.7 + 0.6 * g)
        reach = 4.0 + 9.0 * g
        st += (0.45 + 0.6 * g) * exp(-(dist / width) * (dist / width)) * pow(r, -1.3) * exp(-r / reach)
    plumes = pow(abs(slat), 5.0) * fine * 0.5 * pow(r, -4.5)
    inner + k + st * (0.55 + 0.7 * fine) + plumes + pearl

sun_disc_fs = (i: SunOut, u: SunParams) -> vec4:
    # (in the disc's own radii; i.at is in the painted radii the light about it is measured in)
    p = i.at / u.disc
    low = u.shape.y
    above = p.y+u.shape.x               # height over the horizon, in disc radii
    # (the warm air over the water: strongest just above it)
    heat = low*exp(-max(above,0.0)*2.4)
    x = p.x+(sin(p.y*23.0+u.shape.z*5.1)*0.05+sin(p.y*57.0-u.shape.z*7.7)*0.025)*heat
    # (the mirage: under a line just over the water, the disc's image upside down; eases to the
    # horizon itself as only the final upper sliver remains so the last sliver is not clipped away)
    m = 0.24*low*smoothstep(-0.55,-0.15,u.shape.x)-u.shape.x
    mirror = step(p.y,m)
    y = mix(p.y,2.0*m-p.y,mirror)
    d = length(vec2(x,y/u.shape.w))
    # (a disc a few pixels across: its edge never sharper than a pixel)
    aa = max(0.09+0.1*heat+u.soft, fwidth(d)*0.75)
    cover = 1.0-smoothstep(1.0-aa,1.0+aa,d)
    # (slices: thin gaps across the foot as the air bends it)
    cover *= 1.0-heat*0.75*smoothstep(0.55,0.95,sin(p.y*34.0+u.shape.z*1.9))
    cover *= (1.0-mirror*0.3)*smoothstep(-0.04,0.04,above)
    g = clamp(y/u.shape.w*0.5+0.5,0.0,1.0)
    c = mix(u.foot,u.top,g*g*(3.0-2.0*g))
    # (an eclipse: the Moon's disc before the Sun's, in the same flattened disc space; its limb is
    # ragged with mountains and valleys, which break the last sliver into beads)
    lit_share = 1.0-u.eclipse.w
    moon_in: f32 = 0.0
    q = vec2(p.x,p.y/u.shape.w)
    if u.eclipse.z > 0.0:
        mq = q-u.eclipse.xy
        dm = length(mq)
        md = mq/max(dm,0.0001)
        limb = u.eclipse.z*(1.0+0.006*(vnoise(md*11.0+vec2(u.eclipse_look.y,3.0))-0.5)+0.003*(vnoise(md*29.0+vec2(5.0,u.eclipse_look.y))-0.5))
        moon_in = 1.0-smoothstep(limb-aa,limb+aa,dm)
        cover *= 1.0-moon_in
    # (the light about it: the aureole covers the sky with its own colour rather than adding to it,
    # since added light only pales an orange horizon band; then a soft outer glow, faint horizon
    # streak, and once set the glow it leaves on the horizon; all of it measured in painted radii)
    open = (1.0-cover)*smoothstep(-0.04,0.04,above)
    out = max(d-1.0,0.0)*u.disc
    px = x*u.disc; py = y*u.disc; pabove = above*u.disc
    fw = max(u.halo.y, 0.25)
    streak = 0.1*exp(-abs(py)*4.0)*exp(-abs(px)*0.3)
    # (an eclipsed Sun's aureole fades with what is left of it, gone in totality)
    dim = pow(lit_share, 0.3)
    # (a saturated ring about one and a half radii wide at fw=1, broader when fw<1, then soft glow)
    ab = clamp(u.bloom.w*((1.0-smoothstep(0.35,1.6/fw,out))*0.9+exp(-out*0.45*fw)*0.32+streak),0.0,0.92)*open*dim
    # (once set: spread along the horizon about the sun's bearing, low over the water)
    aset = clamp(u.halo.x*exp(-px*px*0.012)*exp(-max(pabove,0.0)*0.4),0.0,0.85)*open*(1.0-ab)
    rgb = u.bloom.xyz*ab+u.set_colour*aset
    # (and a little light added right about the disc: bright suns shine; muted dust/cool discs less)
    rgb += u.bloom.xyz*(u.bloom.w*u.halo.z*exp(-out*2.0*fw))*open*dim
    # (faint WMO diffraction corona in mist: violet-blue inside, yellow-green middle, warm-red outer, <5 deg)
    if u.corona > 0.0:
        cv = exp(-pow((out - 0.55) / 0.34, 2.0))
        cg = exp(-pow((out - 1.05) / 0.38, 2.0))
        cr = exp(-pow((out - 1.62) / 0.45, 2.0))
        ccol = vec3(0.52, 0.56, 0.92) * cv + vec3(0.76, 0.88, 0.52) * cg + vec3(0.92, 0.52, 0.42) * cr
        ca = clamp((cv * 0.45 + cg * 0.40 + cr * 0.45) * u.corona * 0.36, 0.0, 0.35) * open * dim
        rgb += ccol * (ca * 0.72)
        ab = clamp(ab + ca * 0.35, 0.0, 0.95)
    # (horizon flash: strictly limited to the upper rim / final sliver, never recolouring the whole disc)
    if u.flash.w > 0.0:
        gf = clamp(p.y/u.shape.w*0.5+0.5,0.0,1.0)
        rim = smoothstep(0.70 - 0.36*u.flash.w, 0.92 - 0.28*u.flash.w, gf) * u.flash.w
        c = mix(c, u.flash.xyz, rim)
        fa = u.flash.w * 0.65 * exp(-out * 2.6) * smoothstep(0.50, 0.86, gf) * open
        rgb = mix(rgb, u.flash.xyz * max(ab + aset, 0.85), clamp(fa, 0.0, 0.9)) + u.flash.xyz * (fa * 0.35)
    a = cover+ab+aset
    if u.eclipse.z > 0.0:
        # (the diamond ring and Baily's beads: the last of the photosphere through the limb's valleys,
        # where the Sun's limb lies farthest from the Moon's centre)
        dn = -u.eclipse.xy/max(length(u.eclipse.xy),0.0001)
        if u.eclipse_look.z > 0.0 or u.eclipse_look.w > 0.0:
            r0 = q-dn
            dr = length(r0)*u.disc
            ar = abs(vec2(dot(r0,dn),dot(r0,vec2(-dn.y,dn.x))))*u.disc
            ring = u.eclipse_look.z*(exp(-dr*dr*90.0)*1.6+exp(-dr*5.0)*0.45+exp(-min(ar.x,ar.y)*60.0-max(ar.x,ar.y)*4.0)*0.5)
            beads: f32 = 0.0
            loop k in 0..4:
                t = (f32(k)-1.5)*0.42+sin(u.eclipse_look.y*3.7+f32(k)*2.1)*0.1
                bp = vec2(dn.x*cos(t)-dn.y*sin(t),dn.x*sin(t)+dn.y*cos(t))
                bd = length(q-bp)*u.disc
                beads += exp(-bd*bd*900.0)*(0.6+0.4*sin(f32(k)*5.3+u.eclipse_look.y))
            glow = ring+beads*u.eclipse_look.w*1.4
            rgb += vec3(1.0,0.97,0.93)*glow
            a += min(glow,1.0)*0.5
        # (totality: the corona round the black Moon, and the Moon a dark disc before it)
        if u.eclipse_look.x > 0.0:
            cl = corona_light(q,u.eclipse_look.y)*(1.0-moon_in)
            v = 1.0-exp(-cl*2.4)
            ccol = mix(vec3(0.66,0.72,0.96),vec3(1.0,0.99,0.97),smoothstep(0.25,0.95,v))
            rgb += ccol*v*u.eclipse_look.x
            a += v*0.75*u.eclipse_look.x
            # (the Moon: dark, lit only by the earthshine, darker than the sky about it)
            md = moon_in*u.eclipse_look.x*0.9
            rgb = rgb*(1.0-md)+vec3(0.035,0.037,0.045)*md
            a = a*(1.0-md)+md
        # (the edge of the square: nothing at its rim, whatever the corona reaches)
        rim = 1.0-smoothstep(u.halo.w*0.8,u.halo.w,max(abs(i.at.x),abs(i.at.y)))
        rgb *= rim
        a *= rim
    vec4(c*cover+rgb,a)

sun_disc_sh = Shader()
sun_disc_mesh = Mesh()

# The disc's look by the sun's height over the visible horizon (e, radians), the day's air
# (Light.turbidity, day_air.jo), the sunset palette (Light.sunset_kind), optional horizon flash,
# per-evening vividness (0 muted .. 1 bold), aureole spread scale, and faint mist corona.
const SUN_WHITE = vec3(1.0, 0.98, 0.93)
struct SunLook:
    top: vec3
    foot: vec3
    low: f32                        # how low (0 high, 1 on the water)
    flat: f32                       # height over width
    size: f32
    soft: f32
    bloom: vec4                     # aureole colour (xyz) and strength (w)
    halo: vec4                      # x post-set strength, y aureole falloff scale, z shine share, w quad half-size
    set_colour: vec3 = vec3(1.0, 0.22, 0.1)
    flash: vec4 = vec4(0, 0, 0, 0)
    corona: f32 = 0.0

# Horizon flash strength and colour from the top limb's remaining height over the visible horizon.
_horizon_flash_of = (e: f64, size: f32, flat: f32, flash_kind: int) -> vec4:
    if flash_kind <= 0: return vec4(0, 0, 0, 0)
    top_above = e / f64(sun_disc_radius() * size) + f64(flat)
    if top_above <= 0.01 or top_above >= 0.62: return vec4(0, 0, 0, 0)
    # Builds as the upper limb drops into the final sliver, peaks just before disappearance, gone below horizon
    strength = f32(smoothstep(0.62, 0.24, top_above) * smoothstep(0.01, 0.05, top_above))
    if flash_kind == 3:
        # Very rare violet flash: azure-blue rim sharpening to electric indigo-violet on the final sliver
        col = mix(vec3(0.36, 0.72, 1.00), vec3(0.62, 0.34, 1.00), f32(smoothstep(0.38, 0.14, top_above)))
        return vec4(col, strength)
    if flash_kind == 2:
        # Rare blue flash: yellow-green rim giving way to crisp azure-blue at the very last sliver
        col = mix(vec3(0.42, 0.92, 0.72), vec3(0.24, 0.72, 1.00), f32(smoothstep(0.40, 0.16, top_above)))
        return vec4(col, strength)
    # Green flash: yellow-green dispersion rim brightening to emerald green on the final sliver
    col = mix(vec3(0.74, 0.95, 0.32), vec3(0.24, 0.96, 0.40), f32(smoothstep(0.46, 0.18, top_above)))
    vec4(col, strength)

sun_disc_look = (e: f64, turbidity: f32 = 0.0, palette: int = 1, flash_kind: int = 0, vivid: f32 = 1.0, aureole_scale: f32 = 1.0, corona: f32 = 0.0) -> SunLook:
    r = e / f64(SKY_DISC_RADIUS)
    t = f64(turbidity)
    thick = max(t, 0.0)
    v = f32(clamp(f64(vivid), 0.0, 1.0))
    asc = f32(clamp(f64(aureole_scale), 0.6, 1.6))
    low = f32(1.0 - smoothstep(0.5, 6.0, r))
    flat = 1.0 - 0.2 * low
    gold = f32(1.0 - smoothstep(3.0, 14.0 + 6.0 * thick, r))
    reach = if t >= 0.0: 3.5 + 12.0 * min(thick, 1.0) else: 3.5 * (1.0 + t)
    red = f32(1.0 - smoothstep(0.5, reach, r))
    blood = f32(clamp((thick - 1.0) / 0.4, 0.0, 1.0) * (1.0 - smoothstep(1.0, 5.0, r)))
    size = f32(1.0 + 0.8 * (1.0 - smoothstep(0.0, 0.17, e)))
    set = f32(smoothstep(0.3, -0.8, r) * (1.0 - smoothstep(-1.5, -5.0, r)))

    # Palette 1 (SunsetPalette.red): exact existing red baseline at bold end (v=1),
    # softer muted orange-scarlet sunset at muted end (v=0).
    if palette == 1:
        top = mix(SUN_WHITE, vec3(1.0, 0.97, 0.78), gold)
        top = mix(top, vec3(1.0, 0.62, 0.26), red)
        foot = mix(SUN_WHITE, vec3(1.0, 0.86, 0.5), gold)
        foot = mix(foot, vec3(0.94, 0.3, 0.1), red)
        em = f32(clamp(thick * 1.25, 0.0, 1.0)) * red
        if thick > 0.0: em = max(em, f32(0.85 * (1.0 - smoothstep(2.6, 4.2, r))))
        emit = mix(vec3(1.0, 0.97, 0.93), vec3(1.0, 0.74, 0.7), blood)
        # At muted end, retain warm orange-scarlet disc readability with gentler aureole
        em_eff = em * mix(0.58, 1.0, v)
        top = mix(top, emit, em_eff)
        foot = mix(foot, emit, em_eff)
        size = mix(size, 0.7, em_eff)
        bloom_bold = mix(mix(vec3(1.0, 0.5, 0.2), vec3(1.0, 0.17, 0.2), red), vec3(1.0, 0.1, 0.17), blood)
        bloom_muted = mix(mix(vec3(0.94, 0.56, 0.28), vec3(0.92, 0.30, 0.24), red), vec3(0.82, 0.20, 0.22), blood)
        bloom_colour = mix(bloom_muted, bloom_bold, v)
        bloom_w = mix(0.58, 0.95, v) * em
        bloom = vec4(bloom_colour, bloom_w)
        halo_strength = mix(0.48, 0.75, v) * set * f32(1.0 + 0.4 * thick)
        fw = 1.0 / asc
        shine = mix(0.16, 0.3, v)
        quad = if halo_strength > 0.0: 22.0 else: if em > 0.0 or corona > 0.001: 11.0 * max(asc, 1.0) else: SUN_QUAD
        fl = _horizon_flash_of(e, size, flat, flash_kind)
        return SunLook(top, foot, low, flat, size, f32(0.1 * thick * f64(red)), bloom, vec4(halo_strength, fw, shine, quad), mix(vec3(0.88, 0.34, 0.18), vec3(1.0, 0.22, 0.1), v), fl, corona)

    # Shared elevation envelopes for the field guide's palettes
    warm_up = f32(1.0 - smoothstep(1.5, 11.0, r))           # ~17 deg down to ~2.5 deg
    near_hor = f32(1.0 - smoothstep(0.0, 4.8, r))           # ~7.5 deg down to horizon
    very_low = f32(1.0 - smoothstep(-0.3, 2.2, r))          # ~3.5 deg down to touching
    aerosol = f32(1.0 - smoothstep(2.0, 16.0, r))           # high aerosol reach (~25 deg down)
    soft = f32(0.08 * thick * f64(near_hor))
    top = SUN_WHITE
    foot = SUN_WHITE
    bloom_col = vec3(0.95, 0.72, 0.35)
    bloom_str: f32 = 0.0
    aura_fw: f32 = 0.85
    shine: f32 = 0.28
    set_col = vec3(0.95, 0.55, 0.22)
    halo_strength = 0.65 * set * f32(1.0 + 0.3 * thick)

    match palette:
        0:
            # Amber (clear maritime): Ivory (#FFF7E8) -> Pale yellow (#FFF0B2) -> Gold (#FFE085) -> Amber (#FFD080)
            # Crisp bright ivory-gold disc clearly separated from a deeper golden-amber aureole at every height (5 deg, 1-2 deg, touching), bold and muted.
            top_m = mix(mix(vec3(1.0, 0.99, 0.94), vec3(1.0, 0.98, 0.84), warm_up), vec3(1.0, 0.96, 0.76), near_hor)
            top_b = mix(mix(vec3(1.0, 0.99, 0.93), vec3(1.0, 0.98, 0.84), warm_up), vec3(1.0, 0.95, 0.74), near_hor)
            foot_m = mix(mix(vec3(1.0, 0.97, 0.88), vec3(1.0, 0.94, 0.72), warm_up), vec3(1.0, 0.88, 0.58), near_hor)
            foot_b = mix(mix(vec3(1.0, 0.97, 0.86), vec3(1.0, 0.93, 0.70), warm_up), vec3(1.0, 0.86, 0.54), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.98, 0.84, v), near_hor * 0.50)
            # Rich deeper golden-amber aureole wraps tightly around the luminous ivory-gold disc for crisp separation
            bc_m = mix(vec3(0.84, 0.50, 0.12), vec3(0.80, 0.38, 0.05), near_hor)
            bc_b = mix(vec3(0.94, 0.46, 0.04), vec3(0.92, 0.32, 0.02), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.80, 0.96, v) * max(near_hor, warm_up * 0.78)
            aura_fw = mix(0.88, 0.98, v)
            shine = mix(0.05, 0.12, v)
            soft = 0.0
            set_col = mix(vec3(0.88, 0.50, 0.12), vec3(0.98, 0.44, 0.04), v)
            halo_strength = mix(0.55, 0.82, v) * set
        2:
            # Peach (humid / coastal haze): Cream -> Peach (#FFD0AB) -> Salmon -> Coral (#FFAAA0)
            top_m = mix(mix(vec3(1.0, 0.96, 0.88), vec3(1.0, 0.86, 0.72), warm_up), vec3(1.0, 0.80, 0.66), very_low)
            top_b = mix(mix(vec3(1.0, 0.97, 0.90), vec3(1.0, 0.90, 0.76), warm_up), vec3(1.0, 0.86, 0.74), very_low)
            foot_m = mix(mix(vec3(1.0, 0.92, 0.80), vec3(1.0, 0.78, 0.64), warm_up), vec3(0.98, 0.66, 0.60), near_hor)
            foot_b = mix(mix(vec3(1.0, 0.93, 0.82), vec3(1.0, 0.82, 0.68), warm_up), vec3(1.0, 0.72, 0.64), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(1.02, 0.84, v), near_hor * 0.55)
            bc_m = mix(vec3(0.93, 0.58, 0.44), vec3(0.86, 0.47, 0.48), near_hor)
            bc_b = mix(vec3(1.00, 0.48, 0.34), vec3(0.98, 0.32, 0.36), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.68, 0.94, v) * max(near_hor, warm_up * 0.55)
            aura_fw = mix(0.64, 0.78, v)
            shine = mix(0.18, 0.30, v)
            soft = 0.08 * near_hor
            set_col = mix(vec3(0.92, 0.48, 0.42), vec3(1.00, 0.36, 0.32), v)
            halo_strength = mix(0.62, 0.86, v) * set
        3:
            # Crimson (hazy / dust extinction): Scarlet (#FF7664) -> Crimson (#CF3947) -> Burgundy (#8E2834)
            # Flat, sharply readable deep-red disc (distinct from red baseline's bright white core).
            top_m = mix(mix(vec3(0.98, 0.82, 0.72), vec3(0.92, 0.44, 0.38), aerosol * 0.85), vec3(0.81, 0.22, 0.28), near_hor)
            top_m = mix(top_m, vec3(0.64, 0.16, 0.22), blood)
            top_b = mix(mix(vec3(1.00, 0.86, 0.74), vec3(1.00, 0.42, 0.36), aerosol * 0.85), vec3(0.94, 0.20, 0.26), near_hor)
            top_b = mix(top_b, vec3(0.76, 0.12, 0.20), blood)
            foot_m = mix(mix(vec3(0.96, 0.72, 0.62), vec3(0.86, 0.30, 0.30), aerosol * 0.90), vec3(0.68, 0.16, 0.22), near_hor)
            foot_b = mix(mix(vec3(0.98, 0.74, 0.62), vec3(0.94, 0.24, 0.26), aerosol * 0.90), vec3(0.78, 0.10, 0.18), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.96, 0.82, v), near_hor * 0.6)
            bc_m = mix(vec3(0.74, 0.22, 0.23), vec3(0.60, 0.18, 0.18), max(near_hor, blood))
            bc_b = mix(vec3(0.90, 0.13, 0.18), vec3(0.84, 0.09, 0.16), max(near_hor, blood))
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.62, 0.92, v) * max(aerosol * 0.65, near_hor)
            aura_fw = mix(0.84, 0.94, v)
            shine = mix(0.10, 0.24, v)
            soft = 0.05 * near_hor
            set_col = mix(vec3(0.70, 0.20, 0.20), vec3(0.92, 0.10, 0.16), v)
            halo_strength = mix(0.60, 0.86, v) * set
        4:
            # Copper (Saharan dust): Copper (#C37752) -> Rust -> Dark reddish-brown in heavy dust (never neon).
            top_m = mix(mix(vec3(0.94, 0.86, 0.74), vec3(0.76, 0.48, 0.33), aerosol * 0.85), vec3(0.70, 0.36, 0.24), very_low)
            top_m = mix(top_m, vec3(0.50, 0.22, 0.18), blood)
            top_b = mix(mix(vec3(0.98, 0.88, 0.72), vec3(0.94, 0.56, 0.30), aerosol * 0.85), vec3(0.90, 0.44, 0.20), very_low)
            top_b = mix(top_b, vec3(0.64, 0.24, 0.16), blood)
            foot_m = mix(mix(vec3(0.90, 0.78, 0.64), vec3(0.72, 0.40, 0.26), aerosol * 0.90), vec3(0.62, 0.26, 0.18), near_hor)
            foot_m = mix(foot_m, vec3(0.42, 0.16, 0.14), blood)
            foot_b = mix(mix(vec3(0.94, 0.80, 0.62), vec3(0.88, 0.46, 0.22), aerosol * 0.90), vec3(0.80, 0.30, 0.14), near_hor)
            foot_b = mix(foot_b, vec3(0.54, 0.18, 0.12), blood)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.95, 0.84, v), near_hor * 0.6)
            bc_m = mix(vec3(0.64, 0.36, 0.23), vec3(0.54, 0.22, 0.16), max(very_low, blood))
            bc_b = mix(vec3(0.86, 0.38, 0.14), vec3(0.82, 0.24, 0.10), max(very_low, blood))
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.62, 0.92, v) * max(aerosol * 0.65, near_hor)
            aura_fw = mix(0.76, 0.88, v)
            shine = mix(0.08, 0.22, v)
            soft = 0.12 * max(aerosol * 0.6, near_hor)
            set_col = mix(vec3(0.66, 0.26, 0.18), vec3(0.88, 0.28, 0.10), v)
            halo_strength = mix(0.60, 0.84, v) * set
        5:
            # Rose (wildfire smoke / tonal rose): Coral -> Pale red -> Rose (#E9A2AF) -> Burgundy (#A84056)
            top_m = mix(mix(vec3(0.96, 0.88, 0.84), vec3(0.91, 0.64, 0.69), aerosol * 0.80), vec3(0.84, 0.50, 0.58), very_low)
            top_b = mix(mix(vec3(1.00, 0.92, 0.88), vec3(0.98, 0.68, 0.74), aerosol * 0.80), vec3(0.94, 0.52, 0.64), very_low)
            foot_m = mix(mix(vec3(0.94, 0.80, 0.76), vec3(0.84, 0.54, 0.60), aerosol * 0.85), vec3(0.66, 0.25, 0.34), near_hor)
            foot_b = mix(mix(vec3(0.98, 0.84, 0.80), vec3(0.92, 0.56, 0.64), aerosol * 0.85), vec3(0.82, 0.24, 0.40), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.92, 0.82, v), near_hor * 0.55)
            bc_m = mix(vec3(0.81, 0.46, 0.56), vec3(0.66, 0.28, 0.40), very_low)
            bc_b = mix(vec3(0.96, 0.34, 0.52), vec3(0.88, 0.18, 0.42), very_low)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.66, 0.94, v) * max(aerosol * 0.58, near_hor)
            aura_fw = mix(0.70, 0.84, v)
            shine = mix(0.12, 0.26, v)
            soft = 0.09 * near_hor
            set_col = mix(vec3(0.72, 0.32, 0.42), vec3(0.92, 0.22, 0.42), v)
            halo_strength = mix(0.64, 0.88, v) * set
        6:
            # Magenta glow (volcanic stratospheric): warm-white (#FFF0DB) / pale-rose (#F3CAD0) disc at BOTH ends;
            # wider glow carries rose aureole -> pink glow (#DC789E) -> vivid magenta (#B95599 -> bold fuchsia-magenta).
            top = mix(mix(vec3(1.0, 0.96, 0.90), vec3(1.0, 0.94, 0.86), warm_up), vec3(0.96, 0.82, 0.84), very_low)
            foot = mix(vec3(1.0, 0.94, 0.86), vec3(0.95, 0.79, 0.82), near_hor)
            size = mix(size, mix(0.88, 0.76, v), near_hor * 0.65)
            bc_m = mix(vec3(0.86, 0.47, 0.62), vec3(0.73, 0.33, 0.60), near_hor)
            bc_b = mix(vec3(0.96, 0.32, 0.64), vec3(0.94, 0.12, 0.62), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.78, 0.96, v) * max(near_hor, warm_up * 0.60)
            aura_fw = mix(0.62, 0.76, v)
            shine = mix(0.22, 0.34, v)
            set_col = mix(vec3(0.76, 0.32, 0.58), vec3(0.96, 0.14, 0.62), v)
            halo_strength = mix(0.78, 0.96, v) * set
        7:
            # Lilac halo (volcanic twilight): warm cream disc (#F6E0CC) at BOTH ends;
            # cool aureole -> cool lilac halo (#AA8CBF -> bold luminous violet-lilac) over warm horizon.
            top = mix(vec3(0.99, 0.96, 0.90), vec3(0.96, 0.88, 0.80), warm_up)
            foot = mix(vec3(0.98, 0.92, 0.84), vec3(0.95, 0.84, 0.74), near_hor)
            size = mix(size, mix(0.90, 0.78, v), near_hor * 0.60)
            bc_m = mix(vec3(0.66, 0.70, 0.82), vec3(0.67, 0.55, 0.75), near_hor)
            bc_b = mix(vec3(0.64, 0.66, 0.96), vec3(0.62, 0.34, 0.98), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.74, 0.95, v) * max(near_hor, warm_up * 0.58)
            aura_fw = mix(0.60, 0.74, v)
            shine = mix(0.18, 0.30, v)
            set_col = mix(vec3(0.64, 0.50, 0.78), vec3(0.62, 0.34, 0.98), v)
            halo_strength = mix(0.76, 0.95, v) * set
        8:
            # Blue sun (exceptional aged smoke): Cool aureole high -> unmistakable Blue (#92B8E5) -> Indigo (#8297CF).
            # Clearly blue at both muted and bold ends (bold = luminous cerulean/cobalt-indigo).
            top_m = mix(mix(vec3(0.94, 0.95, 0.96), vec3(0.55, 0.74, 0.94), aerosol * 0.94), vec3(0.46, 0.58, 0.88), very_low)
            top_b = mix(mix(vec3(0.96, 0.97, 1.00), vec3(0.58, 0.84, 1.00), aerosol * 0.95), vec3(0.42, 0.62, 1.00), very_low)
            foot_m = mix(mix(vec3(0.86, 0.90, 0.95), vec3(0.48, 0.66, 0.90), aerosol * 0.96), vec3(0.40, 0.50, 0.82), near_hor)
            foot_b = mix(mix(vec3(0.88, 0.93, 1.00), vec3(0.44, 0.70, 1.00), aerosol * 0.96), vec3(0.32, 0.44, 0.96), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.92, 0.78, v), near_hor * 0.55)
            bc_m = mix(vec3(0.42, 0.58, 0.78), vec3(0.36, 0.46, 0.70), near_hor)
            bc_b = mix(vec3(0.18, 0.56, 0.98), vec3(0.14, 0.36, 0.96), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.64, 0.95, v) * max(aerosol * 0.75, near_hor)
            aura_fw = mix(0.84, 0.94, v)
            shine = mix(0.10, 0.28, v)
            soft = 0.08 * max(aerosol * 0.5, near_hor)
            set_col = mix(vec3(0.36, 0.48, 0.68), vec3(0.16, 0.42, 0.96), v)
            halo_strength = mix(0.52, 0.84, v) * set
        9:
            # Purple sun (exceptional aged smoke): Lavender (#C8B5E2) -> Purple (#AA8FCC).
            # Clearly purple at both muted and bold ends (bold = luminous royal amethyst).
            top_m = mix(mix(vec3(0.92, 0.88, 0.96), vec3(0.76, 0.66, 0.90), aerosol * 0.94), vec3(0.64, 0.50, 0.84), very_low)
            top_b = mix(mix(vec3(0.96, 0.90, 1.00), vec3(0.84, 0.66, 1.00), aerosol * 0.95), vec3(0.70, 0.44, 1.00), very_low)
            foot_m = mix(mix(vec3(0.88, 0.82, 0.94), vec3(0.68, 0.56, 0.86), aerosol * 0.96), vec3(0.56, 0.42, 0.78), near_hor)
            foot_b = mix(mix(vec3(0.92, 0.84, 1.00), vec3(0.74, 0.50, 1.00), aerosol * 0.96), vec3(0.58, 0.28, 0.96), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.92, 0.78, v), near_hor * 0.55)
            bc_m = mix(vec3(0.56, 0.48, 0.72), vec3(0.46, 0.36, 0.64), near_hor)
            bc_b = mix(vec3(0.60, 0.26, 0.94), vec3(0.52, 0.14, 0.92), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.64, 0.95, v) * max(aerosol * 0.75, near_hor)
            aura_fw = mix(0.84, 0.94, v)
            shine = mix(0.10, 0.28, v)
            soft = 0.08 * max(aerosol * 0.5, near_hor)
            set_col = mix(vec3(0.46, 0.36, 0.60), vec3(0.56, 0.18, 0.94), v)
            halo_strength = mix(0.52, 0.84, v) * set
        10:
            # Blue-green sun (exceptional aged smoke): Blue-green / cyan-mint (#A1D2D1 / #739F9F).
            # Clearly turquoise/cyan-mint at both muted and bold ends.
            top_m = mix(mix(vec3(0.92, 0.96, 0.95), vec3(0.60, 0.84, 0.84), aerosol * 0.94), vec3(0.52, 0.78, 0.78), very_low)
            top_b = mix(mix(vec3(0.94, 1.00, 0.99), vec3(0.60, 0.98, 0.96), aerosol * 0.95), vec3(0.40, 0.92, 0.92), very_low)
            foot_m = mix(mix(vec3(0.86, 0.92, 0.92), vec3(0.54, 0.78, 0.78), aerosol * 0.96), vec3(0.44, 0.72, 0.74), near_hor)
            foot_b = mix(mix(vec3(0.88, 0.96, 0.96), vec3(0.44, 0.92, 0.92), aerosol * 0.96), vec3(0.24, 0.82, 0.84), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.92, 0.78, v), near_hor * 0.55)
            bc_m = mix(vec3(0.42, 0.64, 0.64), vec3(0.36, 0.58, 0.60), near_hor)
            bc_b = mix(vec3(0.14, 0.78, 0.80), vec3(0.08, 0.68, 0.74), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.64, 0.95, v) * max(aerosol * 0.75, near_hor)
            aura_fw = mix(0.84, 0.94, v)
            shine = mix(0.10, 0.28, v)
            soft = 0.08 * max(aerosol * 0.5, near_hor)
            set_col = mix(vec3(0.36, 0.58, 0.58), vec3(0.10, 0.74, 0.78), v)
            halo_strength = mix(0.52, 0.84, v) * set
        _:
            # Green sun (exceptional aged smoke): Pale green (#BCD6A7 / #8EA782) -> vivid jade-emerald.
            # Clearly green (not grey) at both muted and bold ends.
            top_m = mix(mix(vec3(0.90, 0.95, 0.88), vec3(0.70, 0.86, 0.60), aerosol * 0.94), vec3(0.62, 0.82, 0.54), very_low)
            top_b = mix(mix(vec3(0.92, 0.98, 0.88), vec3(0.74, 0.98, 0.54), aerosol * 0.95), vec3(0.54, 0.94, 0.44), very_low)
            foot_m = mix(mix(vec3(0.84, 0.91, 0.82), vec3(0.62, 0.80, 0.54), aerosol * 0.96), vec3(0.52, 0.74, 0.46), near_hor)
            foot_b = mix(mix(vec3(0.86, 0.95, 0.82), vec3(0.58, 0.92, 0.44), aerosol * 0.96), vec3(0.34, 0.84, 0.34), near_hor)
            top = mix(top_m, top_b, v)
            foot = mix(foot_m, foot_b, v)
            size = mix(size, mix(0.92, 0.78, v), near_hor * 0.55)
            bc_m = mix(vec3(0.48, 0.66, 0.42), vec3(0.40, 0.60, 0.38), near_hor)
            bc_b = mix(vec3(0.26, 0.82, 0.26), vec3(0.16, 0.72, 0.24), near_hor)
            bloom_col = mix(bc_m, bc_b, v)
            bloom_str = mix(0.64, 0.95, v) * max(aerosol * 0.75, near_hor)
            aura_fw = mix(0.84, 0.94, v)
            shine = mix(0.10, 0.28, v)
            soft = 0.08 * max(aerosol * 0.5, near_hor)
            set_col = mix(vec3(0.40, 0.58, 0.36), vec3(0.18, 0.78, 0.26), v)
            halo_strength = mix(0.52, 0.84, v) * set

    aura_fw = aura_fw / asc
    quad = if halo_strength > 0.0: 22.0 else: if bloom_str > 0.01 or corona > 0.001: 14.0 * max(asc, 1.0) else: SUN_QUAD
    fl = _horizon_flash_of(e, size, flat, flash_kind)
    SunLook(top, foot, low, flat, size, soft, vec4(bloom_col, bloom_str), vec4(halo_strength, aura_fw, shine, quad), set_col, fl, corona)

draw_sun_disc = (L: Light, t: f64):
    s = normalize(L.sun_dir)
    h = max(f64(scene_camera().y), 0.0)
    dip = sqrt(h * (2.0 * EARTH_RADIUS + h)) / (EARTH_RADIUS + h)
    e = asin(clamp(f64(s.y), -1.0, 1.0)) + dip
    if e < -5.0 * f64(SKY_DISC_RADIUS): return
    k = sun_disc_look(e, L.turbidity, L.sunset_kind, L.horizon_flash, L.sunset_vivid, L.aureole_scale, L.corona)
    halo = k.halo
    # (an eclipse: a square wide enough for the Moon's offset and, in totality, the corona's streamers)
    if L.eclipse.z > 0.0:
        reach = max(length(vec2(L.eclipse.x, L.eclipse.y)) + L.eclipse.z, if L.eclipse_look.x > 0.0: CORONA_REACH else: 2.0) * 1.15
        halo.w = max(halo.w, reach * sun_disc_share())
    cull(.none)
    blend(.premultiplied)
    draw(sun_disc_sh, sun_disc_mesh, SunParams(scene_view_proj(), s, k.top, k.foot, vec4(f32(e / f64(sun_disc_radius() * k.size)), k.low, f32(t % 1000.0), k.flat), k.size, k.soft, k.bloom, halo, k.set_colour, k.flash, k.corona, far_depth(), L.eclipse, L.eclipse_look, sun_disc_share()))
    blend(.alpha)

# (the GPU programs: made once the window is open)
init_sky = ():
    init_night_sky()
    global sky_sh, sky_tri
    sky_sh = make_shader(shader(sky_vs, sky_fs))
    sky_tri = mesh([SkyVertex(vec2(-1, -1)), SkyVertex(vec2(3, -1)), SkyVertex(vec2(-1, 3))])
    global glow_band_sh, glow_band_mesh
    glow_band_sh = make_shader(shader(glow_band_vs, glow_band_fs))
    glow_band_mesh = build_glow_band()
    global bishops_ring_sh, bishops_ring_mesh
    bishops_ring_sh = make_shader(shader(bishops_ring_vs, bishops_ring_fs))
    bishops_ring_mesh = build_bishops_ring()
    global sun_disc_sh, sun_disc_mesh
    sun_disc_sh = make_shader(shader(sun_disc_vs, sun_disc_fs))
    sun_disc_mesh = mesh([SunVertex(vec2(-1,-1)),SunVertex(vec2(1,-1)),SunVertex(vec2(1,1)),SunVertex(vec2(-1,1))], [u32(0),u32(1),u32(2),u32(0),u32(2),u32(3)])
