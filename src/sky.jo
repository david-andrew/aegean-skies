use 'depth_space.jo'
use 'sky_air.jo'
# The sky: drawn behind everything as one screen-filling triangle. A deep blue overhead fading
# to a pale, luminous horizon; the sun's disc and its glow (golden and wide when it is low), and
# over it the night's lights (night_sky.jo: the Moon, the stars, the planets, the Milky Way).

use 'look.jo'
use 'quality.jo'
use 'celestial.jo'
use 'paint.jo'
use 'render_space.jo'
use 'weather_scene.jo'
use 'night_sky.jo'

struct SkyVertex:
    pos: vec2

struct SkyParams:
    rays: mat4
    top: vec3
    horizon: vec3
    haze: vec3
    sea: vec3
    sun_dir: vec3
    sun: vec3
    time: f32
    altitude: f32
    cirrus: f32
    far_z: f32

struct SkyOut:
    pos: vec4
    ndc: vec2

sky_vs = (v: SkyVertex, u: SkyParams) -> SkyOut: SkyOut(vec4(v.pos, u.far_z, 1), v.pos)

sky_color = (dir: vec3, u: SkyParams) -> vec3:
    h = max(u.altitude, 0.0)
    dip = sqrt(h * (2.0 * f32(EARTH_RADIUS) + h)) / (f32(EARTH_RADIUS) + h)
    y = dir.y + dip
    l = normalize(u.sun_dir)
    sd = max(dot(dir, l), 0.0)
    # the gradient: deep overhead, a band of pale haze along the horizon
    c = sky_air_color(dir.y,u.altitude,l.y,u.top,u.horizon,u.haze)
    band = exp(-max(y, 0.0) * 28.0)
    # Warm forward scattering is confined to the solar side; the opposite
    # horizon retains the cool blue air rather than becoming uniformly orange.
    daylight = smoothstep(-0.12, 0.04, l.y)
    low_sun = (1.0 - smoothstep(0.05, 0.5, l.y)) * daylight
    warm = vec3(1.0, 0.51, 0.24)
    c = mix(c, u.top, low_sun * (1.0 - pow(sd, 3.0)) * band * 0.3)
    c += u.sun * (pow(sd, 6.0) * 0.14 + pow(sd, 40.0) * 0.22) * daylight
    c += warm * (pow(sd, 18.0) * low_sun * exp(-abs(y) * 5.0) * 0.2)
    # (the sun's disc is its own small billboard over this: draw_sun_disc; the Moon, the stars, the
    # planets and the Milky Way are their own geometry too: night_sky.jo)
    q = dir.xz/max(dir.y,0.025)*3.0+vec2(u.time*0.0007,0)
    feather_filter = 1.0-smoothstep(0.2,0.6,length(vec2(fwidth(q.x),fwidth(q.y))))
    if dir.y > 0.08 and u.cirrus > 0.0:
        curl = vnoise(q*0.7)
        filament = vnoise(vec2(q.x*0.45,q.y*5.0+curl*7.0))
        veil = smoothstep(0.62,0.9,filament)*smoothstep(0.45,0.8,curl)*u.cirrus*feather_filter*smoothstep(0.08,0.3,dir.y)
        c = mix(c,mix(u.haze,u.sun,0.4),veil*daylight*0.4)
    c

sky_fs = (i: SkyOut, u: SkyParams) -> vec4:
    dir = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    c = sky_color(dir,u)
    vec4(c*paint_paper(i.pos.xy),1)
sky_sh: Shader
sky_tri: Mesh

draw_sky = (L: Light, t: f64):
    # (the night's air: what the twilight, the Moon, the haze and the cloud overhead let through)
    cover = if weather_active: f64(clamp(weather_here.deck*0.8+weather_here.rain*0.65,0.0,0.95)) else: 0.0
    air = night_air(L, cover, f64(scene_camera().y))
    # (the sky writes no depth: it is behind everything, however far)
    depth_write(false)
    draw(sky_sh, sky_tri, SkyParams(render_rays(scene_view_proj()), night_sky_top(L.sky_top, air), L.sky_horizon, L.haze, L.sea_deep, L.sun_dir, L.sun*L.glare, f32(t), scene_camera().y,if weather_active: weather_here.cirrus else: 0.0,far_depth()))
    draw_night_stars(L, air, t)
    if L.afterglow.x > 0.0: draw_glow_band(L)
    draw_night_moon(L, air)
    # (the disc over the glow band: the band is the air's glow about the sun, not in front of it)
    draw_sun_disc(L, t)
    depth_write(true)

# ---------------- twilight's glow: a band of painted geometry ----------------
# The amber band low on the sun's side after sunset (look.jo Light.afterglow), drawn over the sky
# as a strip of the sky dome round the horizon: its colour and cover worked out at each vertex
# (72 bearings by 13 heights; the band is a smooth gradient) and blended in, the pixels only
# passing on what they are given. Any addition to the sky's or the sea's own shaders cost Intel
# GPUs half a millisecond, even a single blend; this costs next to nothing on every tier.
struct GlowVertex:
    at: vec2                        # x the bearing from the sun's (rad), y the height above the horizon (rad)

struct GlowParams:
    view_proj: mat4
    glow: vec4                      # Light.afterglow: strength, 1 / the band's height, the way to the sun (x, z)
    dip: f32                        # how far below level the horizon lies (the eye's height)
    sunset: f32                     # Light.sunset: the band redder while the sun is on the water
    far_z: f32

struct GlowOut:
    pos: vec4
    colour: vec4                    # premultiplied

# The band's colour and cover (premultiplied) at a bearing from the sun's and a height above the
# horizon (rad): fading to nothing at the zenith, so the strip has no top edge to show.
glow_band_colour = (at: vec2, glow: vec4, sunset: f32) -> vec4:
    facing = cos(at.x)*0.5+0.5
    side = facing*facing*facing
    up = at.y*glow.y
    # (while the sun is on the water: a deep orange low on its side through rose higher up, and
    # a pink belt round the rest of the horizon)
    warm = mix(mix(vec3(0.92,0.53,0.25),vec3(1.0,0.42,0.12),sunset),mix(vec3(0.93,0.8,0.55),vec3(0.94,0.58,0.5),sunset),clamp(up*1.18-0.06,0.0,1.0))
    colour = mix(mix(vec3(0.5,0.38,0.44),vec3(0.86,0.6,0.66),sunset),warm,clamp(facing*1.67-0.25,0.0,1.0))
    a = min(glow.x*exp(-up*0.9)*mix(0.22,0.97,side),0.97)*(1.0-smoothstep(0.75,1.5,at.y))
    vec4(colour*a,a)

glow_band_vs = (v: GlowVertex, u: GlowParams) -> GlowOut:
    bearing = atan2(u.glow.w, u.glow.z)+v.at.x
    e = v.at.y-u.dip
    dir = vec3(cos(e)*cos(bearing),sin(e),cos(e)*sin(bearing))
    clip = u.view_proj*vec4(dir,0)
    GlowOut(vec4(clip.xy,clip.w*u.far_z,clip.w),glow_band_colour(v.at,u.glow,u.sunset))

# The band as its strip draws it at a bearing and height: straight between the strip's rows of
# vertices, and nothing above its top row (tests: the sky has no step from horizon to zenith).
glow_band_drawn = (at: vec2, glow: vec4, sunset: f32, heights: f64[]) -> vec4:
    n = heights.len()
    if f64(at.y) >= heights[n-1]: return vec4(0,0,0,0)
    loop j in 0..n-1:
        if f64(at.y) < heights[j+1]:
            t = f32((f64(at.y)-heights[j])/(heights[j+1]-heights[j]))
            return mix(glow_band_colour(vec2(at.x,f32(heights[j])),glow,sunset),glow_band_colour(vec2(at.x,f32(heights[j+1])),glow,sunset),t)
    vec4(0,0,0,0)

glow_band_fs = (i: GlowOut, u: GlowParams) -> vec4: i.colour

const GLOW_BEARINGS = 72
# (to the zenith, where it has faded to nothing: stopped at 43 degrees its top edge showed in a
# view pitched up, a darker cap of plain sky above it)
GLOW_HEIGHTS = [0.0, 0.015, 0.04, 0.08, 0.13, 0.19, 0.27, 0.37, 0.5, 0.75, 1.0, 1.25, 1.5708]
glow_band_sh = Shader()
glow_band_mesh = Mesh()

build_glow_band = () -> Mesh:
    vs: GlowVertex[]
    idx: u32[]
    rows = GLOW_HEIGHTS.len()
    loop i in 0..GLOW_BEARINGS+1:
        a = (f64(i) / f64(GLOW_BEARINGS) * 2.0 - 1.0) * PI
        loop j in 0..rows: vs.push(GlowVertex(vec2(f32(a), f32(GLOW_HEIGHTS[j]))))
    loop i in 0..GLOW_BEARINGS:
        loop j in 0..rows-1:
            p = u32(i * rows + j); q = p + u32(rows)
            idx.extend([p, q, p + 1, p + 1, q, q + 1])
    mesh(vs, idx)

draw_glow_band = (L: Light):
    h = max(f64(scene_camera().y), 0.0)
    dip = sqrt(h * (2.0 * EARTH_RADIUS + h)) / (EARTH_RADIUS + h)
    cull(.none)
    blend(.premultiplied)
    draw(glow_band_sh, glow_band_mesh, GlowParams(scene_view_proj(), L.afterglow, f32(dip), L.sunset, far_depth()))
    blend(.alpha)

# ---------------- the sun's disc ----------------
# A small square of the sky round the sun, drawn over the sky (the sky's own shader keeps only the
# sun's glow). High up the disc is white. Low down it is graded, pale gold at its top to orange
# and red at its foot, and the air flattens it. Touching the water, the warm air over the sea
# bends its foot into wavering slices and joins it to its own upside-down image, a short neck
# into the horizon. Everything that differs by the sun's height is worked out on the CPU.
struct SunVertex:
    at: vec2                        # the corner, in disc radii (y toward the zenith)

struct SunParams:
    view_proj: mat4
    sun_dir: vec3
    top: vec3                       # the disc's colour at its top
    foot: vec3                      # ... and at its foot
    shape: vec4                     # x the disc's centre over the visible horizon (radii), y how low (0 high, 1 on the water),
                                    # z the time (s), w the flattening (height / width)
    size: f32                       # the disc's radius over its height in the sky's (larger low down)
    soft: f32                       # its edge's extra softness (thick air)
    bloom: vec4                     # the bloom about a reddened sun: its colour (xyz) and strength (w)
    halo: vec4                      # x the red glow's strength where it has set; w the square's half size (radii)
    far_z: f32

struct SunOut:
    pos: vec4
    at: vec2

const SUN_QUAD: f32 = 1.6           # the square's half size, in disc radii (larger with a halo: SunParams.halo.w)

sun_disc_vs = (v: SunVertex, u: SunParams) -> SunOut:
    s = normalize(u.sun_dir)
    right = normalize(cross(s, vec3(0,1,0)) + vec3(0.00001,0,0))
    up = cross(right, s)
    dir = s + (right*v.at.x + up*v.at.y)*(u.halo.w*SKY_DISC_RADIUS*u.size)
    clip = u.view_proj*vec4(dir,0)
    SunOut(vec4(clip.xy,clip.w*u.far_z,clip.w),v.at*u.halo.w)

sun_disc_fs = (i: SunOut, u: SunParams) -> vec4:
    p = i.at
    low = u.shape.y
    above = p.y+u.shape.x               # height over the horizon, in radii
    # (the warm air over the water: strongest just above it)
    heat = low*exp(-max(above,0.0)*2.4)
    x = p.x+(sin(p.y*23.0+u.shape.z*5.1)*0.05+sin(p.y*57.0-u.shape.z*7.7)*0.025)*heat
    # (the mirage: under a line just over the water, the disc's image upside down)
    m = 0.24*low-u.shape.x
    mirror = step(p.y,m)
    y = mix(p.y,2.0*m-p.y,mirror)
    d = length(vec2(x,y/u.shape.w))
    aa = 0.09+0.1*heat+u.soft
    cover = 1.0-smoothstep(1.0-aa,1.0+aa,d)
    # (slices: thin gaps across the foot as the air bends it)
    cover *= 1.0-heat*0.75*smoothstep(0.55,0.95,sin(p.y*34.0+u.shape.z*1.9))
    cover *= (1.0-mirror*0.3)*smoothstep(-0.04,0.04,above)
    g = clamp(y/u.shape.w*0.5+0.5,0.0,1.0)
    c = mix(u.foot,u.top,g*g*(3.0-2.0*g))
    # (the light about it, added: a reddened sun's tight saturated bloom and a wider soft glow, a
    # faint streak of it along the level, and once it has set the glow it leaves on the horizon)
    # (the bloom covers the sky with its own saturated colour rather than adding to it: added
    # light only paled the orange band it sits in)
    open = (1.0-cover)*smoothstep(-0.04,0.04,above)
    out = max(d-1.0,0.0)
    streak = 0.1*exp(-abs(y)*4.0)*exp(-abs(x)*0.3)
    # (a saturated ring about one and a half radii wide, then a soft glow: wide enough to read
    # at the game's normal view, not only close up)
    ab = clamp(u.bloom.w*((1.0-smoothstep(0.35,1.6,out))*0.9+exp(-out*0.45)*0.32+streak),0.0,0.92)*open
    # (once set: spread along the horizon about the sun's bearing, low over the water)
    aset = clamp(u.halo.x*exp(-x*x*0.012)*exp(-max(above,0.0)*0.4),0.0,0.85)*open*(1.0-ab)
    rgb = u.bloom.xyz*ab+vec3(1.0,0.22,0.1)*aset
    # (and a little light added right about the disc: it shines)
    rgb += u.bloom.xyz*(u.bloom.w*0.3*exp(-out*2.0))*open
    vec4(c*cover+rgb,cover+ab+aset)

sun_disc_sh = Shader()
sun_disc_mesh = Mesh()

# The disc's look by the sun's height over the visible horizon (e, radians) and the day's air
# (Light.turbidity, day_air.jo). Pale gold a few degrees up; reddening as it sinks (the longer path
# through the air); drawn larger low down, as the eye sees a low sun. In thick air the change starts
# higher, about 20 degrees up, and comes on gradually with the sky's. A reddened sun is an
# over-bright emitter: a small flat disc, all its colour in a tight red bloom about it. Once it
# has set a red glow stays on the horizon where it went down. In washed air it stays yellow almost
# to the water.
const SUN_WHITE = vec3(1.0, 0.98, 0.93)
struct SunLook:
    top: vec3
    foot: vec3
    low: f32                        # how low (0 high, 1 on the water)
    flat: f32                       # height over width
    size: f32
    soft: f32
    bloom: vec4
    halo: vec4
sun_disc_look = (e: f64, turbidity: f32 = 0.0) -> SunLook:
    r = e / f64(SKY_DISC_RADIUS)
    t = f64(turbidity)
    thick = max(t, 0.0)
    low = f32(1.0 - smoothstep(0.5, 6.0, r))
    gold = f32(1.0 - smoothstep(3.0, 14.0 + 6.0 * thick, r))
    # (the reddening from its reach down to the water, gradually: the baseline's 3.5 radii, in
    # dust 15.5, a first warmth about 20 degrees up)
    reach = if t >= 0.0: 3.5 + 12.0 * min(thick, 1.0) else: 3.5 * (1.0 + t)
    red = f32(1.0 - smoothstep(0.5, reach, r))
    blood = f32(clamp((thick - 1.0) / 0.4, 0.0, 1.0) * (1.0 - smoothstep(1.0, 5.0, r)))
    top = mix(SUN_WHITE, vec3(1.0, 0.97, 0.78), gold)
    top = mix(top, vec3(1.0, 0.62, 0.26), red)
    foot = mix(SUN_WHITE, vec3(1.0, 0.86, 0.5), gold)
    foot = mix(foot, vec3(0.94, 0.3, 0.1), red)
    size = f32(1.0 + 0.8 * (1.0 - smoothstep(0.0, 0.17, e)))
    # (in thick air a reddened sun is an over-bright emitter, as it is to the eye and in photographs:
    # small, one flat near-white colour, hot pink-red only in heavy dust near the water, and all
    # its colour in the bloom about it, a tight saturated red falling off quickly)
    em = f32(clamp(thick * 1.25, 0.0, 1.0)) * red
    # (under about 5 degrees on any day of thick air the ring is plain to see)
    if thick > 0.0: em = max(em, f32(0.85 * (1.0 - smoothstep(2.6, 4.2, r))))
    emit = mix(vec3(1.0, 0.97, 0.93), vec3(1.0, 0.74, 0.7), blood)
    top = mix(top, emit, em)
    foot = mix(foot, emit, em)
    size = mix(size, 0.7, em)
    bloom_colour = mix(mix(vec3(1.0, 0.5, 0.2), vec3(1.0, 0.17, 0.2), red), vec3(1.0, 0.1, 0.17), blood)
    bloom = vec4(bloom_colour, 0.95 * em)
    # (once set, a red glow at the horizon where it went down, fading over about 8 degrees; a
    # little stronger than a photograph shows, so it reads)
    set = f32(smoothstep(0.3, -0.8, r) * (1.0 - smoothstep(-1.5, -5.0, r)))
    halo_strength = 0.75 * set * f32(1.0 + 0.4 * thick)
    quad = if halo_strength > 0.0: 22.0 else: if em > 0.0: 11.0 else: SUN_QUAD
    halo = vec4(halo_strength, 0.0, 0.0, quad)
    SunLook(top, foot, low, 1.0 - 0.2 * low, size, f32(0.1 * thick * f64(red)), bloom, halo)

draw_sun_disc = (L: Light, t: f64):
    s = normalize(L.sun_dir)
    h = max(f64(scene_camera().y), 0.0)
    dip = sqrt(h * (2.0 * EARTH_RADIUS + h)) / (EARTH_RADIUS + h)
    e = asin(clamp(f64(s.y), -1.0, 1.0)) + dip
    if e < -5.0 * f64(SKY_DISC_RADIUS): return
    k = sun_disc_look(e, L.turbidity)
    cull(.none)
    blend(.premultiplied)
    draw(sun_disc_sh, sun_disc_mesh, SunParams(scene_view_proj(), s, k.top, k.foot, vec4(f32(e / f64(SKY_DISC_RADIUS * k.size)), k.low, f32(t % 1000.0), k.flat), k.size, k.soft, k.bloom, k.halo, far_depth()))
    blend(.alpha)

# (the GPU programs: made once the window is open)
init_sky = ():
    init_night_sky()
    global sky_sh, sky_tri
    sky_sh = make_shader(shader(sky_vs, sky_fs))
    sky_tri = mesh([SkyVertex(vec2(-1, -1)), SkyVertex(vec2(3, -1)), SkyVertex(vec2(-1, 3))])
    global glow_band_sh, glow_band_mesh
    glow_band_sh = make_shader(shader(glow_band_vs, glow_band_fs))
    glow_band_mesh = build_glow_band()
    global sun_disc_sh, sun_disc_mesh
    sun_disc_sh = make_shader(shader(sun_disc_vs, sun_disc_fs))
    sun_disc_mesh = mesh([SunVertex(vec2(-1,-1)),SunVertex(vec2(1,-1)),SunVertex(vec2(1,1)),SunVertex(vec2(-1,1))], [u32(0),u32(1),u32(2),u32(0),u32(2),u32(3)])
