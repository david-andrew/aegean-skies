# The sky: drawn behind everything as one screen-filling triangle. A deep blue overhead fading
# to a pale, luminous horizon; the sun's disc and its glow (golden and wide when it is low), and
# stars at night.

use 'look.jo'
use 'render_space.jo'
use 'weather_scene.jo'

struct SkyVertex:
    pos: vec2

struct SkyParams:
    rays: mat4
    top: vec3
    horizon: vec3
    haze: vec3
    sea: vec3
    sun_dir: vec3
    sun: vec3
    night: f32
    time: f32
    altitude: f32
    moon_dir: vec3
    cirrus: f32

struct SkyOut:
    pos: vec4
    ndc: vec2

sky_vs = (v: SkyVertex, u: SkyParams) -> SkyOut: SkyOut(vec4(v.pos, 0.9999, 1), v.pos)

sky_color = (dir: vec3, u: SkyParams) -> vec3:
    h = max(u.altitude, 0.0)
    dip = sqrt(h * (2.0 * f32(EARTH_RADIUS) + h)) / (f32(EARTH_RADIUS) + h)
    y = dir.y + dip
    l = normalize(u.sun_dir)
    sd = max(dot(dir, l), 0.0)
    # the gradient: deep overhead, a band of pale haze along the horizon
    g = pow(clamp(y, 0.0, 1.0), 0.5)
    c = mix(u.horizon, u.top, g)
    band = exp(-max(y, 0.0) * 28.0)
    c = mix(c, u.haze, band * 0.65)
    # Warm forward scattering is confined to the solar side; the opposite
    # horizon retains the cool blue air rather than becoming uniformly orange.
    daylight = smoothstep(-0.12, 0.04, l.y)
    low_sun = (1.0 - smoothstep(0.05, 0.5, l.y)) * daylight
    warm = vec3(1.0, 0.51, 0.24)
    c = mix(c, u.top, low_sun * (1.0 - pow(sd, 3.0)) * band * 0.3)
    c += u.sun * (pow(sd, 6.0) * 0.14 + pow(sd, 40.0) * 0.22) * daylight
    c += warm * (pow(sd, 18.0) * low_sun * exp(-abs(y) * 5.0) * 0.2)
    c += u.sun * smoothstep(0.99955, 0.9997, sd) * 4.0 * daylight
    q = dir.xz/max(dir.y,0.025)*3.0+vec2(u.time*0.0007,0)
    feather_filter = 1.0-smoothstep(0.2,0.6,length(vec2(fwidth(q.x),fwidth(q.y))))
    if dir.y > 0.08 and u.cirrus > 0.0:
        curl = vnoise(q*0.7)
        filament = vnoise(vec2(q.x*0.45,q.y*5.0+curl*7.0))
        veil = smoothstep(0.62,0.9,filament)*smoothstep(0.45,0.8,curl)*u.cirrus*feather_filter*smoothstep(0.08,0.3,dir.y)
        c = mix(c,mix(u.haze,u.sun,0.4),veil*daylight*0.4)
    if u.night > 0.0:
        cell_pos = dir.xz / max(dir.y + 0.3, 0.03) * 240.0
        cell = floor(cell_pos)
        s = hash21(cell)
        # Derivatives must precede the per-star (nonuniform) branch on GLES.
        aa = max(length(vec2(fwidth(cell_pos.x), fwidth(cell_pos.y))), 0.02)
        if s > 0.989 and y > 0.0:
            point = vec2(hash21(cell + vec2(17, 5)), hash21(cell + vec2(3, 29))) * 0.6 + vec2(0.2, 0.2)
            d = length(fract(cell_pos) - point)
            # A compact antialiased point instead of a whole square noise cell.
            star = (1.0 - smoothstep(0.035, 0.035 + aa, d)) * min(1.0, 0.012 / (aa * aa))
            tw = 0.85 + 0.15 * sin(u.time * (1.3 + s) + s * 430.0)
            c += vec3(1, 0.97, 0.9) * (u.night * star * tw * smoothstep(0.0, 0.15, y) * 2.0)
    # Moon disk: illuminate the near hemisphere with the same solar direction
    # used by terrain and clouds. Crescent orientation follows the Sun in 3D.
    moon = normalize(u.moon_dir)
    right = normalize(cross(vec3(0, 1, 0), moon))
    up = cross(moon, right)
    radius: f32 = 0.00465
    xy = vec2(dot(dir, right), dot(dir, up)) / radius
    rr = dot(xy, xy)
    edge = max(fwidth(rr), 0.01)
    if rr < 1.15 and dot(dir, moon) > 0.0 and y > -0.01:
        disk = 1.0 - smoothstep(1.0 - edge, 1.0 + edge, rr)
        normal = right * xy.x + up * xy.y - moon * sqrt(max(1.0 - rr, 0.0))
        lit = smoothstep(-0.03, 0.12, dot(normal, l))
        maria = 0.88 + 0.12 * vnoise(xy * 5.0 + vec2(11, 3))
        earthshine = 0.025 * u.night
        lunar = vec3(0.92, 0.94, 1.0) * (lit * 0.8 + earthshine) * maria
        # At daytime the atmosphere in front remains visible across the disk.
        c = mix(c, c * (1.0 - u.night * 0.85) + lunar, disk * smoothstep(-0.01, 0.03, y))
    c

sky_fs = (i: SkyOut, u: SkyParams) -> vec4:
    dir = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    vec4(sky_color(dir, u), 1)

sky_sh: Shader
sky_tri: Mesh

draw_sky = (L: Light, t: f64):
    night = clamp(0.05 - f64(L.sun_dir.y), 0.0, 0.3) / 0.3
    # (the sky writes no depth: it is behind everything, however far)
    glDepthMask(0)
    draw(sky_sh, sky_tri, SkyParams(render_rays(scene_view_proj()), L.sky_top, L.sky_horizon, L.haze, L.sea_deep, L.sun_dir, L.sun, f32(night), f32(t), scene_camera().y, L.moon_dir,if weather_active: weather_here.cirrus else: 0.0))
    glDepthMask(1)

# (the GPU programs: made once the window is open)
init_sky = ():
    global sky_sh, sky_tri
    sky_sh = make_shader(shader(sky_vs, sky_fs))
    sky_tri = mesh([SkyVertex(vec2(-1, -1)), SkyVertex(vec2(3, -1)), SkyVertex(vec2(-1, 3))])
