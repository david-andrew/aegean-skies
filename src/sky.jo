# The sky: drawn behind everything as one screen-filling triangle. A deep blue overhead fading
# to a pale, luminous horizon; the sun's disc and its glow (golden and wide when it is low), and
# stars at night.

use 'look.jo'
use 'render_space.jo'

struct SkyVertex:
    pos: vec2

struct SkyParams:
    rays: mat4
    top: vec3
    horizon: vec3
    haze: vec3
    sea: vec3
    sun_dir: vec3
    sun: vec3
    night: f32
    time: f32
    altitude: f32

struct SkyOut:
    pos: vec4
    ndc: vec2

sky_vs = (v: SkyVertex, u: SkyParams) -> SkyOut: SkyOut(vec4(v.pos, 0.9999, 1), v.pos)

sky_color = (dir: vec3, u: SkyParams) -> vec3:
    h = max(u.altitude, 0.0)
    dip = sqrt(h * (2.0 * f32(EARTH_RADIUS) + h)) / (f32(EARTH_RADIUS) + h)
    y = dir.y + dip
    l = normalize(u.sun_dir)
    sd = max(dot(dir, l), 0.0)
    # the gradient: deep overhead, a band of pale haze along the horizon
    g = pow(clamp(y, 0.0, 1.0), 0.5)
    c = mix(u.horizon, u.top, g)
    band = exp(-max(y, 0.0) * 28.0)
    c = mix(c, u.haze, band * 0.65)
    # the sun's side of the sky is warmer and brighter
    c = c + u.sun * (pow(sd, 6.0) * 0.18 + pow(sd, 40.0) * 0.25) * (0.4 + 0.6 * band)
    # the disc
    c = c + u.sun * smoothstep(0.99955, 0.9997, sd) * 4.0
    # Below the tangent horizon is still atmosphere. The spherical ocean pass
    # supplies water only where the view ray actually intersects the sea.
    if u.night > 0.0 and y > 0.0:
        cell = floor(dir.xz / (dir.y + 0.3) * 240.0)
        s = hash21(cell)
        if s > 0.996:
            # each star its own twinkle: its own rate and phase
            ph = hash21(cell + vec2(17.0, 5.0)) * 6.2832
            rate = 1.3 + 3.5 * hash21(cell + vec2(3.0, 29.0))
            tw = 0.65 + 0.35 * sin(u.time * rate + ph) * sin(u.time * rate * 0.37 + ph * 2.1)
            c = c + vec3(1, 0.97, 0.9) * (u.night * (s - 0.996) * 220.0 * tw)
    c

sky_fs = (i: SkyOut, u: SkyParams) -> vec4:
    dir = normalize((u.rays * vec4(i.ndc, 1, 0)).xyz)
    vec4(sky_color(dir, u), 1)

sky_sh: Shader
sky_tri: Mesh

draw_sky = (L: Light, t: f64):
    night = clamp(0.05 - f64(L.sun_dir.y), 0.0, 0.3) / 0.3
    # (the sky writes no depth: it is behind everything, however far)
    glDepthMask(0)
    draw(sky_sh, sky_tri, SkyParams(render_rays(scene_view_proj()), L.sky_top, L.sky_horizon, L.haze, L.sea_deep, L.sun_dir, L.sun, f32(night), f32(t), scene_camera().y))
    glDepthMask(1)

# (the GPU programs: made once the window is open)
init_sky = ():
    global sky_sh, sky_tri
    sky_sh = make_shader(shader(sky_vs, sky_fs))
    sky_tri = mesh([SkyVertex(vec2(-1, -1)), SkyVertex(vec2(3, -1)), SkyVertex(vec2(-1, 3))])
