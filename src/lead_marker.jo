# The lead marks, after Sky Barons' lead ring (skybarons.jo draw of `lead_from`, sim.jo): on every
# hostile in reach and on screen, where the rounds and it would meet. They read the physical guns:
# rounds leave at the Battle's muzzle speed plus the aircraft's own velocity, and fall under
# gravity; the target keeps its present velocity. View-only: nothing here aims, steers or fires.
use 'combat.jo'
use 'render_space.jo'

const LEAD_CONVERGE = 450.0         # the guns' convergence, where the gunsight ring is drawn

struct LeadMark:
    craft = -1
    target: vec3                    # where the target is drawn now
    aim: vec3                       # the gunsight's place: along the lead, at the convergence
    intercept: vec3                 # where the rounds and the target meet
    range = 0.0

# Sky Barons' lead_from: from `at` moving at v, to e moving at ev, rounds at `speed` relative to
# the shooter. The time of flight is refined twice; the drop is added back as aim above.
gun_lead = (at: vec3, v: vec3, e: vec3, ev: vec3, speed: f64) -> vec3:
    rel = e-at
    rv = ev-v
    t = f64(length(rel))/max(speed,1.0)
    loop _ in 0..2: t = f64(length(rel+rv*f32(t)))/max(speed,1.0)
    rel+rv*f32(t)+vec3(0,f32(4.905*t*t),0)

# The HUD's projection, the curved world's warp included (as the target marker draws).
hud_point = (p: vec3) -> vec2?:
    q = render_warped(p,scene_camera(),scene_warp_a,scene_warp_b)
    clip = scene_view_proj()*vec4(q,1)
    if clip.w <= 0.05: return none
    sw = f64(screen_width()); sh = f64(screen_height())
    at = vec2(f32(sw*0.5),f32(sh*0.5))+vec2(clip.x,-clip.y)/clip.w*vec2(f32(sw*0.5),f32(sh*0.5))
    if at.x < -200 or at.y < -200 or f64(at.x) > sw+200.0 or f64(at.y) > sh+200.0: return none
    at

# Every hostile flying within MARKS_REACH (Sky Barons' lead_reach), each with its lead.
const MARKS_REACH = 700.0
lead_marks = (b: Battle, player: int, at: vec3, velocity: vec3) -> LeadMark[]:
    out: LeadMark[]
    me = combat_index(b,player)
    if me < 0 or not b.enabled: return out
    side = b.actors[me].side
    loop i in 0..b.actors.len():
        a = b.actors[i]
        if i == me or not a.present or a.bailed or a.status != .flying or a.side == side: continue
        shown = combat_render_state(a,b.render_alpha).position
        distance = f64(length(shown-at))
        if distance >= MARKS_REACH or distance < 1.0: continue
        lead = gun_lead(at,velocity,shown,a.state.velocity,420.0*b.bullet_scale)
        out.push(LeadMark(a.craft,shown,at+normalize(lead)*f32(LEAD_CONVERGE),at+lead,distance))
    out

# Sky Barons' lead ring, as it draws it: a small ring, 6 px across the radius and 2 px thick, in
# the hostile's colour, where the rounds and the target would meet; only for a target on screen.
draw_lead_marks = (marks: LeadMark[]):
    sw = f64(screen_width()); sh = f64(screen_height())
    loop m in marks:
        if let t = hud_point(m.target):
            if f64(t.x) < 20.0 or f64(t.y) < 20.0 or f64(t.x) > sw-20.0 or f64(t.y) > sh-20.0: continue
            if let p = hud_point(m.intercept): ring(p,6,2,rgba(1,0.64,0.44,0.9))
