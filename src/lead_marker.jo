# The lead marker, after Sky Barons' lead ring (skybarons.jo draw of `lead_from`, sim.jo): where to
# put the gunsight so the rounds meet the target. It reads the physical guns: rounds leave at the
# Battle's muzzle speed plus the aircraft's own velocity, and fall under gravity; the target keeps
# its present velocity. View-only: nothing here aims, steers or fires.
use 'combat.jo'
use 'render_space.jo'

const LEAD_REACH = 1000.0           # metres; fades out over the last fifth
const LEAD_CONE = 0.906             # cos 25 degrees: "in the gun cone" when nothing is selected
const LEAD_CONVERGE = 450.0         # the guns' convergence, where the gunsight ring is drawn

struct LeadMark:
    craft = -1
    target: vec3                    # where the target is drawn now
    aim: vec3                       # the gunsight's place: along the lead, at the convergence
    intercept: vec3                 # where the rounds and the target meet
    range = 0.0
    strength = 0.0                  # 0..1, fading with range

# Sky Barons' lead_from: from `at` moving at v, to e moving at ev, rounds at `speed` relative to
# the shooter. The time of flight is refined twice; the drop is added back as aim above.
gun_lead = (at: vec3, v: vec3, e: vec3, ev: vec3, speed: f64) -> vec3:
    rel = e-at
    rv = ev-v
    t = f64(length(rel))/max(speed,1.0)
    loop _ in 0..2: t = f64(length(rel+rv*f32(t)))/max(speed,1.0)
    rel+rv*f32(t)+vec3(0,f32(4.905*t*t),0)

# The selected hostile when there is one in reach, else the nearest hostile in the gun cone.
lead_mark = (b: Battle, player: int, selected: int, at: vec3, velocity: vec3, nose: vec3) -> LeadMark?:
    me = combat_index(b,player)
    if me < 0 or not b.enabled: return none
    side = b.actors[me].side
    best = -1; nearest = LEAD_REACH
    loop i in 0..b.actors.len():
        a = b.actors[i]
        if i == me or not a.present or a.bailed or a.status != .flying or a.side == side: continue
        delta = combat_render_state(a,b.render_alpha).position-at
        distance = f64(length(delta))
        if distance >= LEAD_REACH or distance < 1.0: continue
        if a.craft == selected and dot(delta,nose) > 0: best = i; break
        if f64(dot(delta/f32(distance),nose)) >= LEAD_CONE and distance < nearest: best = i; nearest = distance
    if best < 0: return none
    a = b.actors[best]; shown = combat_render_state(a,b.render_alpha).position
    lead = gun_lead(at,velocity,shown,a.state.velocity,420.0*b.bullet_scale)
    distance = f64(length(shown-at))
    LeadMark(a.craft,shown,at+normalize(lead)*f32(LEAD_CONVERGE),at+lead,distance,1.0-smoothstep(LEAD_REACH*0.8,LEAD_REACH,distance))

# The HUD's projection, the curved world's warp included (as the target marker draws).
hud_point = (p: vec3) -> vec2?:
    q = render_warped(p,scene_camera(),scene_warp_a,scene_warp_b)
    clip = scene_view_proj()*vec4(q,1)
    if clip.w <= 0.05: return none
    sw = f64(screen_width()); sh = f64(screen_height())
    at = vec2(f32(sw*0.5),f32(sh*0.5))+vec2(clip.x,-clip.y)/clip.w*vec2(f32(sw*0.5),f32(sh*0.5))
    if at.x < -200 or at.y < -200 or f64(at.x) > sw+200.0 or f64(at.y) > sh+200.0: return none
    at

# A hostile-coloured ring with a dark rim (it reads over cloud, sea and sky alike), a centre dot,
# and a faint tie back to the target it belongs to. When the gunsight sits on it, it fills: fire.
draw_lead_mark = (m: LeadMark, sight: vec3):
    if m.strength <= 0.01: return
    if let p = hud_point(m.aim):
        k = f32(m.strength)
        on = false
        if let s = hud_point(sight): on = length(s-p) < 9.0
        if let t = hud_point(m.target):
            gap = length(p-t)
            if gap > 22.0:
                along = (p-t)/gap
                line(t+along*12.0,p-along*11.0,1.2,rgba(1,0.64,0.44,0.45*k))
        color = if on: rgba(1,0.93,0.72,k) else: rgba(1,0.64,0.44,0.95*k)
        ring(p,9,4.5,rgba(0.03,0.04,0.05,0.45*k))
        ring(p,9,if on: 3.0 else: 2.0,color)
        circle(p,if on: 3.0 else: 1.8,color)
