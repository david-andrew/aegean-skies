# The lead marks, after Sky Barons' lead ring (skybarons.jo draw of `lead_from`, sim.jo): on every
# hostile in reach and on screen, where the rounds and it would meet. They read the physical guns:
# rounds leave at the Battle's muzzle speed plus the aircraft's own velocity, and fall under
# gravity; the target keeps its present velocity. View-only: nothing here aims, steers or fires.
use 'combat.jo'
use 'render_space.jo'
use 'side_colours.jo'

const LEAD_CONVERGE = 450.0         # the guns' convergence, where the gunsight ring is drawn

struct LeadMark:
    craft = -1
    target: vec3                    # where the target is drawn now
    aim: vec3                       # the gunsight's place: along the lead, at the convergence
    intercept: vec3                 # where the rounds and the target meet
    range = 0.0

# Sky Barons' lead_from: from `at` moving at v, to e moving at ev, rounds at `speed` relative to
# the shooter. The time of flight is refined twice; the drop is added back as aim above.
gun_lead = (at: vec3, v: vec3, e: vec3, ev: vec3, speed: f64) -> vec3:
    rel = e-at
    rv = ev-v
    t = f64(length(rel))/max(speed,1.0)
    loop _ in 0..2: t = f64(length(rel+rv*f32(t)))/max(speed,1.0)
    rel+rv*f32(t)+vec3(0,f32(4.905*t*t),0)

# The HUD's projection, the curved world's warp included (as the target marker draws).
hud_point = (p: vec3) -> vec2?:
    q = render_warped(p,scene_camera(),scene_warp_a,scene_warp_b)
    clip = scene_view_proj()*vec4(q,1)
    if clip.w <= 0.05: return none
    sw = f64(screen_width()); sh = f64(screen_height())
    at = vec2(f32(sw*0.5),f32(sh*0.5))+vec2(clip.x,-clip.y)/clip.w*vec2(f32(sw*0.5),f32(sh*0.5))
    if at.x < -200 or at.y < -200 or f64(at.x) > sw+200.0 or f64(at.y) > sh+200.0: return none
    at

# Every hostile flying within MARKS_REACH (Sky Barons' lead_reach), each with its lead.
const MARKS_REACH = 700.0
lead_marks = (b: Battle, player: int, at: vec3, velocity: vec3) -> LeadMark[]:
    out: LeadMark[]
    me = combat_index(b,player)
    if me < 0 or not b.enabled: return out
    side = b.actors[me].side
    loop i in 0..b.actors.len():
        a = b.actors[i]
        if i == me or not a.present or a.bailed or a.status != .flying or a.side == side: continue
        shown = combat_render_state(a,b.render_alpha).position
        distance = f64(length(shown-at))
        if distance >= MARKS_REACH or distance < 1.0: continue
        lead = gun_lead(at,velocity,shown,a.state.velocity,420.0*b.bullet_scale)
        out.push(LeadMark(a.craft,shown,at+normalize(lead)*f32(LEAD_CONVERGE),at+lead,distance))
    out

# Sky Barons' lead ring, as it draws it with the markers plain: a small ring, 6 px across the
# radius and 2 px thick, in its quiet warm white (INK at 0.75), where the rounds and the target
# would meet; only for a target on screen.
draw_lead_marks = (marks: LeadMark[]):
    sw = f64(screen_width()); sh = f64(screen_height())
    loop m in marks:
        if let t = hud_point(m.target):
            if f64(t.x) < 20.0 or f64(t.y) < 20.0 or f64(t.x) > sw-20.0 or f64(t.y) > sh-20.0: continue
            if let p = hud_point(m.intercept): lead_ring(p)

# One lead ring on the view.
lead_ring = (p: vec2):
    ring(p,6,4,rgba(0.03,0.04,0.05,0.5))
    ring(p,6,2,side_colour(.enemy,0.75))
    # (the sides told by shape: an enemy's chevron over its ring, pointing down at it)
    if side_shapes(): side_sign(p-vec2(0,14),.enemy,0.75)

# The player's own flight, findable from however far off, on the way to the rally and home as in
# the fight, under orders or gone on ahead: a small chevron over each of them in the friends'
# colour, fading with range out to ALLY_REACH and kept, faint, beyond it (past where the eye finds
# an aircraft at all), the leader's doubled (the one to follow); none of them on screen, a pointer
# at the screen's edge toward the leader (else the nearest). Never lost with distance: one alive
# and in the battle is marked or pointed to, wherever it is. No mark on a place (the rally point,
# home, the tender): only on the aircraft themselves, and the leader says where on the radio.
const ALLY_REACH = 10000.0
const ALLY_NEAR = 400.0             # nearer than this (a formation), by eye alone

struct AllyMark:
    at: vec3
    range = 0.0
    leader = false

# The flight's leader: going home, the one leading it home; else the one the flight forms on.
ally_leader = (b: Battle, side: int) -> int:
    if side >= 0 and side < 3 and b.home_since[side] >= 0:
        lead = home_leader(b,side)
        if lead >= 0: return lead
    loop a in b.actors:
        if a.side == side and not a.human and a.present and a.status == .flying and a.pilot.leader >= 0:
            i = combat_index(b,a.pilot.leader)
            if i >= 0 and b.actors[i].status == .flying and b.actors[i].present: return i
    -1

ally_marks = (b: Battle, player: int, at: vec3) -> AllyMark[]:
    out: AllyMark[]
    me = combat_index(b,player)
    if me < 0 or not b.enabled: return out
    side = b.actors[me].side
    lead = ally_leader(b,side)
    loop i in 0..b.actors.len():
        a = b.actors[i]
        if i == me or not a.present or a.bailed or a.status != .flying or a.side != side: continue
        shown = combat_render_state(a,b.render_alpha).position
        d = f64(length(shown-at))
        if d < ALLY_NEAR: continue
        out.push(AllyMark(shown,d,i == lead))
    out

# How strongly a mark at `range` shows: full near, fading to a half at ALLY_REACH and no fainter
# beyond it (still to be found against a dark sky).
ally_alpha = (range: f64) -> f64: 0.9-0.4*clamp((range-2500.0)/(ALLY_REACH-2500.0),0.0,1.0)

# (`at`, `fwd`: the player's aircraft, its place and the way it points, for the pointer)
draw_ally_marks = (marks: AllyMark[], at: vec3, fwd: vec3):
    sw = f64(screen_width()); sh = f64(screen_height())
    seen = false; nearest = -1
    loop k in 0..marks.len():
        m = marks[k]
        if nearest < 0 or m.range < marks[nearest].range: nearest = k
        if let p = hud_point(m.at):
            if f64(p.x) < 12.0 or f64(p.y) < 30.0 or f64(p.x) > sw-12.0 or f64(p.y) > sh-12.0: continue
            seen = true
            ally_mark(p,side_colour(.ally,ally_alpha(m.range)),m.leader)
    if seen or nearest < 0: return
    loop k in 0..marks.len():
        if marks[k].leader: nearest = k
    # (none in sight: a small pointer at the edge, toward the nearest, as the aircraft lies: ahead
    # up, behind down, abeam to the side)
    f = normalize(vec3(fwd.x,0,fwd.z)+vec3(0.0001,0,0)); r = vec3(-f.z,0,f.x)
    delta = marks[nearest].at-at
    bearing = atan2(f64(dot(delta,r)),f64(dot(delta,f)))
    way = vec2(f32(sin(bearing)),f32(-cos(bearing)))
    # (inside the clear middle: under the compass, over the instruments along the bottom)
    mid = vec2(f32(sw*0.5),f32(sh*0.45))
    reach_x = sw*0.5-34.0
    reach_y = if f64(way.y) < 0.0: f64(mid.y)-74.0 else: max(40.0,sh-190.0-f64(mid.y))
    scale = min(reach_x/max(abs(f64(way.x)),0.001),reach_y/max(abs(f64(way.y)),0.001))
    tip = mid+way*f32(scale)
    # (bolder than a mark: it has to be seen at the edge of the eye)
    ally_pointer(tip,way,side_colour(.ally,max(0.8,ally_alpha(marks[nearest].range))))

# The mark over one of the flight at p on the view: a small chevron, the leader's doubled.
ally_mark = (p: vec2, c: vec4, leader: bool):
    top = p-vec2(0,14)
    if side_shapes():
        # (the sides told by shape: a friend's ring over each, the leader's doubled)
        side_ring(top-vec2(0,5),4.5,1.8,c)
        if leader: side_ring(top-vec2(0,5),8.5,1.6,c)
        return
    side_line(top-vec2(5,5),top,1.8,c)
    side_line(top+vec2(5,-5),top,1.8,c)
    # (the leader's doubled: the one to follow)
    if leader:
        side_line(top-vec2(5,11),top-vec2(0,6),1.8,c)
        side_line(top+vec2(5,-11),top-vec2(0,6),1.8,c)

# The pointer at the screen's edge toward the flight: its tip, the way it points.
ally_pointer = (tip: vec2, way: vec2, c: vec4):
    across = vec2(-way.y,way.x)
    side_line(tip,tip-way*18.0+across*10.0,2.8,c)
    side_line(tip,tip-way*18.0-across*10.0,2.8,c)
    # (the sides told by shape: a friend's ring behind the pointer)
    if side_shapes(): side_ring(tip-way*30.0,5.5,2.2,c)
