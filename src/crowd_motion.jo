use 'living_types.jo'
use 'objects.jo'
use 'living_far_types.jo'

# Steering changes direction, never the caller's travel budget. Actual world
# poses are used so scene folding cannot erase an avoidance manoeuvre.
crowd_walk = (w: World,towns: Town[],id: int,move: vec2) -> vec3:
    p=w.people[id].pose.pos
    budget=length(move)
    if budget<0.00001:return walk_step(towns,p,move)
    steering=move
    ids=[1..core_person_count(w))+w.far.near_people
    loop other_id in ids:
        other=w.people[other_id]
        if other.id==id or other.occupation==.player or person_vehicle_bound(w,other.id):continue
        delta=p.xz-other.pose.pos.xz;distance=length(delta)
        if distance>=1.0 or abs(p.y-other.pose.pos.y)>1.0:continue
        away=if distance>0.001:delta/distance else:vec2(if id<other.id: -1.0 else: 1.0,0)
        steering+=away*budget*f32((1.0-f64(distance))*1.5)
    if length(steering)>budget:steering=normalize(steering)*budget
    walk_step(towns,p,steering)
