use 'living_types.jo'
use 'objects.jo'
use 'living_far_types.jo'
use 'scene_hold.jo'

# Steering changes direction, never the caller's travel budget. Actual world
# poses are used so scene folding cannot erase an avoidance manoeuvre.
crowd_walk = (w: World,towns: Town[],id: int,move: vec2) -> vec3:
    p=w.people[id].pose.pos
    budget=length(move)
    if budget<0.00001:return walk_step(towns,p,move)
    steering=move
    ids=[1..core_person_count(w))+w.far.near_people
    loop other_id in ids:
        other=w.people[other_id]
        if other.id==id or other.occupation==.player or person_vehicle_bound(w,other.id):continue
        delta=p.xz-other.pose.pos.xz;distance=length(delta)
        if distance>=1.0 or abs(p.y-other.pose.pos.y)>1.0:continue
        away=if distance>0.001:delta/distance else:vec2(if id<other.id: -1.0 else: 1.0,0)
        steering+=away*budget*f32((1.0-f64(distance))*1.5)
    if length(steering)>budget:steering=normalize(steering)*budget
    walk_step(towns,p,steering)

# Step a person who is guiding the pilot to a door or landmark along `scene_guide.route`.
# Slows gently if the pilot falls behind so they stay within earshot.
scene_guide_step = (w: mut World, towns: Town[], person: int, observer: vec3, dt: f64):
    global scene_guide
    if not scene_guiding(person): return
    pos = w.people[person].pose.pos
    last_pt = if scene_guide.route.len() > 0: scene_guide.route[scene_guide.route.len() - 1] else: scene_guide.target
    if scene_guide.waypoint >= scene_guide.route.len() or f64(length(scene_guide.target.xz - pos.xz)) < 1.9 or f64(length(last_pt.xz - pos.xz)) < 0.7:
        scene_guide.arrived = true
        return
    delta = scene_guide.route[scene_guide.waypoint].xz - pos.xz
    dist = f64(length(delta))
    if dist < 0.45:
        scene_guide.waypoint += 1
        scene_guide.best_d = 1e9; scene_guide.stall_t = 0.0
        if scene_guide.waypoint >= scene_guide.route.len(): scene_guide.arrived = true
        return
    # Slow down if the pilot lags behind; pause gently if > 7 m back and look back toward them.
    gap = f64(length(observer.xz - pos.xz))
    if gap > 7.0:
        back = observer - pos
        if f64(length(back.xz)) > 0.3:
            yaw = approach_angle(pose_yaw(w.people[person].pose), atan2(f64(back.x), f64(back.z)), 5.0, dt)
            w.people[person].pose.rot = facing(vec3(f32(sin(yaw)), 0, f32(cos(yaw))))
        return
    if dist < scene_guide.best_d - 0.12:
        scene_guide.best_d = dist; scene_guide.stall_t = 0.0
    else:
        scene_guide.stall_t += dt
        if scene_guide.stall_t > 1.5:
            scene_guide.best_d = 1e9; scene_guide.stall_t = 0.0
            if scene_guide.waypoint + 1 < scene_guide.route.len(): scene_guide.waypoint += 1
            else: scene_guide.arrived = true
            return
    pace = if gap > 3.8: 0.65 else: 1.25
    step = delta * f32(min(1.0, pace * dt / dist))
    moved = crowd_walk(w, towns, person, step)
    if length(moved.xz - pos.xz) < 0.0001:
        moved = walk_step(towns, pos, step)
    if length(moved.xz - pos.xz) < 0.0001:
        if scene_guide.waypoint + 1 < scene_guide.route.len():
            scene_guide.waypoint += 1; scene_guide.best_d = 1e9; scene_guide.stall_t = 0.0
        else: scene_guide.arrived = true
        return
    w.people[person].pose.rot = facing(vec3(delta.x, 0, delta.y))
    w.people[person].pose.pos = moved
