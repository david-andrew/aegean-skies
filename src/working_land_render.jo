# Near working landscapes, tied to existing output rather than display stock.
# Far fields are the terrain material. At most four districts retain meshes.
use 'settlement_purpose.jo'
use 'settlements.jo'
use 'geography.jo'
use 'objects.jo'
use 'town_details.jo'
use 'town_sites.jo'
use 'town_region.jo'
use 'walk_shapes.jo'
use 'water_field.jo'
use 'plants.jo'
use 'look.jo'
use 'render_space.jo'
use 'world_point.jo'
use 'quality.jo'
use 'working_land_contact.jo'

struct WorkingBatch:
    id:int= -1
    tier:int= -1
    center:vec3
    mesh:Mesh=Mesh()
    olives:InstanceBuffer[Instance3D]?=none
working_batches=[WorkingBatch(),WorkingBatch(),WorkingBatch(),WorkingBatch()]

build_working_land=(s:WorldSettlement)->(Vertex3D[],Instance3D[]):
    vs:Vertex3D[];solids:TownSite[];olives:Instance3D[]
    wood=rgb(0.36,0.29,0.20);stone=rgb(0.71,0.65,0.51)
    purpose=settlement_purpose(s)
    loop plot in working_plots_cached(s):
        side=vec2(-plot.axis.y,plot.axis.x)
        # Vineyard stakes and cultivated olive rows are sparse close detail;
        # their broad aerial shapes stay in the terrain's cultivation field.
        if plot.crop!=2 and plot.crop!=3:continue
        rows=if render_quality.tier==0:3 else:5
        columns=if render_quality.tier==0:4 else:6
        loop row in 0..rows:
            loop column in 0..columns:
                p=plot.center+plot.axis*(f32(column)*12.0-f32(columns-1)*6.0)+side*(f32(row)*10.0-f32(rows-1)*5.0)
                h=place_ground(p)
                if h<4 or water_at(f64(p.x),f64(p.y)).wet or settlement_on_road(p) or length(settlement_avoid_buildings(p)-p)>0.1:continue
                at=vec3(p.x-s.center.x,f32(h)-s.center.y,p.y-s.center.z)
                if plot.crop==3:
                    olives.push(Instance3D(translation(at)*scaling(vec3(0.7,0.7,0.7)),vec4(1,1,1,1)))
                    solids.push(TownSite(vec3(p.x,f32(h),p.y),0,0.6,0.6,2.4,0))
                else:
                    add_cylinder(vs,at,0.045,1.25,wood,4,0.04)
                    add_sphere(vs,at+vec3(0,1.1,0),0.85,rgb(0.31,0.39,0.21),6,3)
    if let facility=working_facility(s):
        at=facility.at-s.center;m=translation(at)*rotation_y(facility.yaw)
        tint=town_region_color(s.seed,s.country)
        add_box(vs,vec3(0,-1.25,0),vec3(9.3,2.5,10.3),stone,m)
        site=working_building(s,facility);entry=site_entry(site)
        # Existing town stair mesh and contact share this exact entry profile.
        run=f64(length(entry.front-entry.outside))/f64(entry.steps)
        loop k in 0..entry.steps:
            p=mix(entry.outside,entry.front,(f32(k)+0.5)/f32(entry.steps))
            top=entry.bottom+(entry.top-entry.bottom)*f64(k+1)/f64(entry.steps)
            bottom=min(place_ground(p)-0.2,entry.bottom-0.2)
            add_box(vs,vec3(0,f32((top+bottom)*0.5)-s.center.y,0),vec3(f32(entry.width),f32(top-bottom),f32(run)),stone,translation(vec3(p.x-s.center.x,0,p.y-s.center.z))*rotation_y(facility.yaw))
        # Open-front work shelter: press or mill visible under a pitched roof.
        # It is a real building with thickness, no second coplanar wall trim.
        loop x in [-4.4,4.4]:add_box(vs,vec3(f32(x),2.0,0),vec3(0.45,4.0,10),tint,m)
        add_box(vs,vec3(0,2,-4.8),vec3(8.35,4,0.45),tint,m)
        add_gable(vs,vec3(0,4.0,0),9.8,11.0,if s.country==1:2.5 else:1.0,ROOFS[1],m)
        loop x in [-4.4,4.4]:add_box(vs,vec3(f32(x),1.9,4.7),vec3(0.35,3.8,0.35),wood,m)
        if purpose.facility==1:
            add_cylinder(vs,vec3(-1.4,0,0),1.8,0.4,stone,16,1.8,m)
            add_cylinder(vs,vec3(-1.4,0.4,0),1.45,0.3,stone*vec4(0.85,0.85,0.85,1),16,1.45,m)
            town_beam(vs,vec3(-1.4,0.8,0),vec3(2.4,0.8,0),0.08,wood,m)
        else if purpose.facility==2:
            add_cylinder(vs,vec3(0,0,0),1.4,0.4,stone,12,1.4,m)
            loop x in [-1.8,1.8]:add_box(vs,vec3(f32(x),1.5,0),vec3(0.24,3.0,0.24),wood,m)
            add_box(vs,vec3(0,2.8,0),vec3(4.0,0.3,0.3),wood,m)
            add_cylinder(vs,vec3(0,1,0),0.14,1.8,wood,6,0.14,m)
            add_cylinder(vs,vec3(0,0.75,0),1.1,0.18,wood,12,1.1,m)
        else:
            # Drying racks for the real tobacco/herb trade; no tradable crates
            # are fabricated here and no independent inventory is introduced.
            loop z in [-2.4,0.0,2.4]:
                loop x in [-2.0,2.0]:add_box(vs,vec3(f32(x),1.2,f32(z)),vec3(0.12,2.4,0.12),wood,m)
                loop y in [0.6,1.3,2.0]:add_box(vs,vec3(0,f32(y),f32(z)),vec3(4,0.08,1.0),wood,m)
                loop x in [-1.5,-0.5,0.5,1.5]:
                    add_sphere(vs,vec3(f32(x),1.5,f32(z)),0.35,if purpose.output==7:rgb(0.48,0.40,0.22) else:rgb(0.38,0.46,0.27),5,3,m)
        root=TownSite(facility.at,facility.yaw,9,10,4,0)
        loop x in [-4.4,4.4]:
            q=site_point(root,x,0);solids.push(TownSite(vec3(q.x,facility.at.y,q.y),facility.yaw,0.45,10,4,0))
        q=site_point(root,0,-4.8);solids.push(TownSite(vec3(q.x,facility.at.y,q.y),facility.yaw,8.35,0.45,4,0))
    walk_publish("working:{s.id}",solids)
    (vs,olives)

draw_working_land=(meshes:Mesh[],L:Light,t:f64):
    global working_batches
    cam=scene_camera();built=false
    loop k in 0..working_batches.len():
        batch=working_batches[k]
        if batch.id>=0 and length(cam.xz-batch.center.xz)>1400:
            walk_publish("working:{batch.id}",[]);working_batches[k].id= -1
    loop index in settlement_bins.get(geography_bin(f64(cam.x),f64(cam.z)),[]):
        s=world_settlements[index]
        if s.legacy>=0 or length(cam-s.center)>1000 or working_plots_cached(s).len()==0:continue
        slot= -1
        loop k in 0..working_batches.len():
            if working_batches[k].id==s.id:slot=k;break
        if slot<0:
            loop k in 0..working_batches.len():
                if working_batches[k].id<0:slot=k;break
        if slot<0:continue
        batch=working_batches[slot]
        if batch.id!=s.id or batch.tier!=render_quality.tier:
            if built:continue
            vertices,olives=build_working_land(s)
            if batch.olives!=none:set_instances(batch.olives!,olives)
            else:batch.olives=instance_buffer(olives)
            if batch.mesh.vao==0:batch.mesh=mesh(vertices)
            else:update_mesh(batch.mesh,vertices)
            batch.id=s.id;batch.tier=render_quality.tier;batch.center=s.center;working_batches[slot]=batch;built=true
        if batch.mesh.count>0:draw(obj_sh,batch.mesh,obj_params(L,t,anchor=world_point(batch.center)))

        if let buffer=batch.olives:
            if buffer.count>0:
                p=obj_params(L,t)
                # Matrices stay in the district chart, retaining centimetres
                # at far settlements without duplicating the shared olive mesh.
                p.instance_origin=p.origin-batch.center
                draw_instanced(obj_inst_sh,meshes[OLIVE],buffer,p)
