use 'living_guard.jo'
use 'living_types.jo'
use 'living_content.jo'
use 'living_checks.jo'
use 'living_commands.jo'
use 'living_delivery.jo'
use 'living_money.jo'
use 'living_life_checks.jo'
use 'living_maps.jo'
use 'living_far_checks.jo'
use 'living_war_checks.jo'
use 'living_save_codec.jo'
use 'living_work.jo'

error struct LivingSaveError:
    message: str

struct SaveHeader:
    schema = 1
    valid = false
    generation = 0
    terrain_key = 0
    cargo_version = 0
    encoding = 0

type SaveResult = SaveGame | LivingSaveError

ordered_map[K,V,O] = (source: {K: V}, key: (K) -> O) -> {K: V}:
    keys = source.keys()
    keys.sort(key)
    result: {K: V}
    loop id in keys: result[id] = source[id]
    result

# This copy exists only for canonical serialization at a save/test boundary.
canonical_world = (w: World) -> World:
    result = w
    result.war.peace_offers=ordered_map(w.war.peace_offers,(key: str): key)
    result.war.occupations=ordered_map(w.war.occupations,(place: int): place)
    result.war.missions = ordered_map(w.war.missions,(id: int): id)
    result.war.orders = ordered_map(w.war.orders,(id: int): id)
    result.war.contacts = ordered_map(w.war.contacts,(id: int): id)
    result.war.evidence = ordered_map(w.war.evidence,(id: int): id)
    result.war.heard = ordered_map(w.war.heard,(key: str): key)
    result.war.survivors = ordered_map(w.war.survivors,(id: int): id)
    result.war.reputation = ordered_map(w.war.reputation,(key: str): key)
    loop i in 0..result.war.units.len(): result.war.units[i].stock.roots = ordered_map(w.war.units[i].stock.roots,(root: int): root)
    result.far.accepted_requests=ordered_map(w.far.accepted_requests,(id: int): id)
    result.far.core_reports = ordered_map(w.far.core_reports,(id: int): id)
    result.far.air_registrations = ordered_map(w.far.air_registrations,(key: str): key)
    result.far.air_homes = ordered_map(w.far.air_homes,(id: int): id)
    result.far.air_berths = ordered_map(w.far.air_berths,(id: int): id)
    result.far.harbors = ordered_map(w.far.harbors,(id: int): id)
    result.far.commissions = ordered_map(w.far.commissions,(id: int): id)
    loop id in result.far.commissions.keys(): result.far.commissions[id].cargo.roots = ordered_map(w.far.commissions[id].cargo.roots,(root: int): root)
    result.far.districts = ordered_map(w.far.districts,(id: int): id)
    result.far.people = ordered_map(w.far.people,(id: int): id)
    result.far.journeys = ordered_map(w.far.journeys,(id: int): id)
    result.far.news = ordered_map(w.far.news,(id: int): id)
    loop id in result.far.districts.keys(): result.far.districts[id].stock.roots = ordered_map(w.far.districts[id].stock.roots,(root: int): root)
    loop id in result.far.people.keys(): result.far.people[id].stock.roots = ordered_map(w.far.people[id].stock.roots,(root: int): root)
    loop i in 0..result.far.vehicles.len():
        result.far.vehicles[i].cargo.roots = ordered_map(w.far.vehicles[i].cargo.roots,(root: int): root)
        result.far.vehicles[i].provisions.roots = ordered_map(w.far.vehicles[i].provisions.roots,(root: int): root)
    result.maps.features = ordered_map(w.maps.features,(id: str): id)
    result.maps.editions = ordered_map(w.maps.editions,(id: str): id)
    result.maps.shops = ordered_map(w.maps.shops,(id: str): id)
    result.maps.copies = ordered_map(w.maps.copies,(id: int): id)
    result.maps.selected = ordered_map(w.maps.selected,(id: int): id)
    result.maps.rewards = ordered_map(w.maps.rewards,(id: int): id)
    result.defaulted_people = ordered_map(w.defaulted_people,(id: int): id)
    result.last_local_raid = ordered_map(w.last_local_raid,(id: int): id)
    result.trips = ordered_map(w.trips,(id: int): id)
    result.jobs = ordered_map(w.jobs,(id: int): id)
    result.obligations = ordered_map(w.obligations,(id: int): id)
    result.events = ordered_map(w.events,(id: int): id)
    result.aftermath = ordered_map(w.aftermath,(id: int): id)
    result.encounters = ordered_map(w.encounters,(id: int): id)
    result.sea_routes = ordered_map(w.sea_routes,(id: int): id)
    result.route_cache = ordered_map(w.route_cache,(id: int): id)
    result.lost_property = ordered_map(w.lost_property,(id: int): id)
    result.bounty_handled = ordered_map(w.bounty_handled,(id: int): id)
    result.obligation_keys = ordered_map(w.obligation_keys,(key: str): key)
    result.quote_residual = ordered_map(w.quote_residual,(key: str): key)
    result.relationship_index = ordered_map(w.relationship_index,(key: RelationshipKey): (key.observer,key.other))
    result.reputation = ordered_map(w.reputation,(key: ReputationKey): (key.place,int(key.subject_kind),key.subject))
    result.receipts = ordered_map(w.receipts,(key: NewsReceiptKey): (key.receiver_kind,key.receiver,key.event))
    result.cargo = ordered_map(w.cargo,(id: int): id)
    result.cargo_sources = ordered_map(w.cargo_sources,(id: int): id)
    result.cargo_bins = ordered_map(w.cargo_bins,(key: str): key)
    result.cargo_source_keys = ordered_map(w.cargo_source_keys,(key: str): key)
    result.carriage = ordered_map(w.carriage,(id: int): id)
    result.boat_cargo = ordered_map(w.boat_cargo,(id: int): id)
    result.local_cargo_day = ordered_map(w.local_cargo_day,(id: int): id)
    result.place_contexts = ordered_map(w.place_contexts,(id: int): id)
    result.speech = ordered_map(w.speech,(id: int): id)
    result.daily_life = ordered_map(w.daily_life,(id: int): id)
    result.meetings = ordered_map(w.meetings,(id: int): id)
    result.stories = ordered_map(w.stories,(id: int): id)
    result.diplomatic_receipts = ordered_map(w.diplomatic_receipts,(id: int): id)
    loop id in result.maps.editions.keys(): result.maps.editions[id].feature_keys = ordered_map(w.maps.editions[id].feature_keys,(key: str): key)
    loop id in result.speech.keys():
        result.speech[id].acquaintance = ordered_map(w.speech[id].acquaintance,(other: int): other)
        result.speech[id].last_contact = ordered_map(w.speech[id].last_contact,(other: int): other)
    loop id in result.jobs.keys(): result.jobs[id].source_quantities = ordered_map(w.jobs[id].source_quantities,(source: int): source)
    result

canonical_text = (w: World) -> str: to_text(canonical_world(w))
canonical_hash = (w: World) -> u64: hash(canonical_text(w))

# Structural checks precede helpers that index arrays. Malformed saves return errors, not panics.
validate_save_world = (w: World) -> str:
    if w.far.populated and w.far.navigation_version!=1: return "old settlement routes require explicit migration; saved data retained"
    if w.far.populated and w.far.procurement_version!=1: return "old distant service agreements require explicit migration; saved data retained"
    if w.far.version<0 or w.far.version>1: return "unsupported settlement economy version"
    if w.cargo_version != 1: return "cargo content requires migration; old save preserved"
    if w.route_key_version < 0 or w.route_key_version > 1: return "unsupported route key version"
    if w.content_version != 1: return "unsupported content version; explicit key migration required"
    if w.cargo_harbors.len() != 6: return "invalid cargo harbor geometry"
    if (w.people.len() != 26 and not w.far.populated) or w.people.len()<26 or w.people.len()>4096 or w.places.len() != 6 or (w.aircraft.len()<8 or w.aircraft.len()>256) or w.factions.len() != 4 or w.goods.len() != 9 or w.harbors.len() != 6: return "invalid v1 content dimensions"
    if w.accounts.len() < 36 or w.tick < 0 or w.tick/120 != w.minute: return "invalid clock/accounts"
    loop i in 0..9:
        if w.goods[i].key != GOOD_DATA[i].key or w.goods[i].kind != GOOD_DATA[i].kind or w.goods[i].package_grams != GOOD_DATA[i].package_grams or w.goods[i].base_cents != GOOD_DATA[i].base_cents: return "good key/unit order requires migration"
    loop i in 0..6:
        if w.places[i].id != i or w.places[i].key != PLACE_KEYS[i] or w.harbors[i].place != i or w.harbors[i].docks.len() != (if i == 0: 3 else: 2): return "place/geometry key order requires migration"
        if w.places[i].market.account < 0 or w.places[i].market.account >= w.accounts.len(): return "market account missing"
    if w.outside_creditor_account < -1 or w.outside_creditor_account >= w.accounts.len(): return "invalid outside creditor account"
    seen_accounts: {str: bool}
    loop i in 0..w.accounts.len():
        if w.accounts[i].id != i or w.accounts[i].key in seen_accounts: return "invalid account identity/key"
        seen_accounts[w.accounts[i].key] = true
    loop _, j in w.jobs:
        if j.carried_reports.len()>12 or (j.carried_reports.len()>0 and j.cargo_mode!=.sealed): return "invalid dispatch contents"
        loop r in j.carried_reports:
            if not far_report_valid(w,r): return "invalid sealed public account"
        if j.buyer_account< -1 or j.buyer_account>=w.accounts.len() or j.sale_unit_cents<0 or j.sale_delivery_fee<0 or j.sale_payee< -1 or j.sale_payee>=w.accounts.len() or j.sale_revenue<0 or j.provenance.supply_roots.len()>64: return "invalid job agreement or supply provenance"
        agreement_error=work_provenance_error(w,j.provenance)
        if agreement_error!="": return agreement_error
    loop p in w.people:
        if p.far_boat>=0 and (p.far_boat>=w.far.vehicles.len() or not (p.id in w.far.vehicles[p.far_boat].passengers)): return "invalid named sea passage"
        if p.far_visit>=0 and (not (p.far_visit in w.far.districts) or p.far_home>=0 or p.place>=0): return "invalid sparse visitor"
        if p.id < 0 or p.id >= w.people.len() or p.account < 0 or p.account >= w.accounts.len() or p.place < -1 or p.place >= 6 or p.craft < -1 or p.craft >= w.aircraft.len() or p.faction < -1 or p.faction >= 4: return "invalid person reference"
        if p.far_home<0:
            if p.id>=core_person_count(w) or p.home<0 or p.home>=6: return "invalid core person home"
        else:
            if not w.far.populated or p.id<core_person_count(w) or not (p.id in w.far.people) or not (p.far_home in w.far.districts) or not (p.far_place in w.far.districts) or p.home!= -1 or p.place!= -1 or p.citizenship<0 or p.citizenship>=3: return "invalid far person reference"
        if p.trip >= 0 and not (p.trip in w.trips): return "person has missing trip"
        if not pose_valid(p.pose): return "invalid person pose"
        loop id in p.obligations:
            if not (id in w.obligations): return "person has missing obligation"
        loop id in p.relationship_ids:
            if id < 0 or id >= w.relationships.len() or w.relationships[id].observer != p.id: return "invalid relationship reference"
    loop c in w.aircraft:
        if int(c.kind) < 0 or int(c.kind) >= AIRFRAMES.len() or c.owner < 0 or c.owner >= w.people.len() or c.operator < -1 or c.operator >= w.people.len() or c.place < -1 or c.place >= 6: return "invalid aircraft reference"
        if c.port_place>=0:
            if not (c.port_place in w.place_contexts) or w.place_contexts[c.port_place].detailed>=0 or not w.place_contexts[c.port_place].aviation: return "invalid registry port call"
            if not finite_living_point(c.port_at) or not finite_living_point(c.port_loading) or length(c.port_at.xz-c.port_loading.xz)>25.0: return "invalid registry loading point"
        if c.dock < -1 or (c.place < 0 and c.dock >= 0) or (c.place >= 0 and c.dock >= w.harbors[c.place].docks.len()): return "invalid dock"
        if c.trip >= 0 and not (c.trip in w.trips): return "aircraft has missing trip"
        if c.repair_obligation >= 0 and not (c.repair_obligation in w.obligations): return "aircraft has missing repair"
        if not pose_valid(c.pose): return "invalid aircraft pose"
        loop id in c.job_manifests:
            if not (id in w.jobs): return "aircraft has missing manifest"
        loop p in c.passengers:
            if p < 0 or p >= w.people.len(): return "invalid passenger"
    loop id in w.active_trips:
        if not (id in w.trips): return "missing scheduled trip"
    loop id in w.active_jobs:
        if not (id in w.jobs): return "missing scheduled job"
    loop id in w.open_obligations:
        if not (id in w.obligations): return "missing scheduled obligation"
    loop id, t in w.trips:
        if t.actor < 0 or t.actor >= 26 or t.craft < -1 or t.craft >= w.aircraft.len() or t.route.len() < 2 or t.cruise_mm_per_sec <= 0: return "invalid trip"
        if t.segment_ticks.len() != 0 and t.segment_ticks.len() != t.route.len()-1: return "invalid segment schedule"
        loop point in t.route:
            if not is_finite(point.x) or not is_finite(point.y) or not is_finite(point.z): return "invalid route pose"
    loop id, j in w.jobs:
        if j.poster < 0 or j.poster >= 26 or j.carrier < -1 or j.carrier >= 26 or j.origin < 0 or j.origin >= 6 or j.destination < 0 or j.destination >= 6 or j.good < -1 or j.good >= 9 or j.escrow_account < 0 or j.escrow_account >= w.accounts.len(): return "invalid job reference"
        if j.reward_funder < -1 or j.reward_funder >= w.accounts.len() or (j.wet_charter and (j.charter_payer < 0 or j.charter_payer >= w.accounts.len())): return "invalid charter/funder account"
        if j.cargo_mode == .commodity and j.good < 0: return "commodity manifest missing good"
        if j.state == .claimed and (j.carrier < 0 or j.obligation < 0): return "claimed manifest missing owner"
        if j.quantity <= 0 or j.paid_cents < 0 or j.reward_cents < 0: return "invalid job amount"
        if not job_terminal(j.state) and j.obligation >= 0 and not (j.obligation in w.obligations): return "missing live delivery obligation"
    loop id, o in w.obligations:
        if o.debtor < 0 or o.debtor >= w.people.len() or o.creditor < -1 or o.creditor >= w.people.len() or o.creditor_account < 0 or o.creditor_account >= w.accounts.len(): return "invalid obligation reference"
        if o.craft < -1 or o.craft >= w.aircraft.len() or o.mechanic < -1 or o.mechanic >= w.people.len() or o.good < -1 or o.good >= 9 or o.amount_cents < 0: return "invalid obligation amount/service"
    loop e in w.relationships:
        if e.observer < 0 or e.observer >= w.people.len() or e.other < 0 or e.other >= w.people.len(): return "invalid relationship"
    loop _, a in w.aftermath:
        if a.owner < 0 or a.owner >= 26 or not inventory_valid(a.inventory): return "invalid aftermath ownership"
    loop task in w.public_boats:
        if task.person < 0 or task.person >= 26 or task.origin < 0 or task.origin >= 6 or task.destination < 0 or task.destination >= 6 or task.craft < -1 or task.craft >= w.aircraft.len() or task.account < 0 or task.account >= w.accounts.len() or task.fare <= 0: return "invalid public boat reservation"
        if task.state < 2 and not (task.trip in w.trips): return "public boat missing its journey"
    loop id, c in w.cargo:
        if id != c.id or c.quantity <= 0 or c.owner < 0 or c.owner >= w.people.len() or c.good < -1 or c.good >= GOOD_COUNT: return "invalid cargo identity/owner/contents"
        holder_ok = match c.store:
            .market, .boat: c.holder >= 0 and c.holder < w.places.len()
            .pocket: c.holder >= 0 and c.holder < w.people.len()
            .aircraft: c.holder >= 0 and c.holder < w.aircraft.len()
            .aftermath: c.holder in w.aftermath
            .lost_property: c.holder in w.lost_property
        if not holder_ok or c.place < -1 or c.place >= w.places.len(): return "invalid cargo custody/location"
        if not (c.source in w.cargo_sources) or (c.job >= 0 and not (c.job in w.jobs)): return "invalid cargo source/job"
        if c.person < -1 or c.person >= w.people.len() or c.where == .person and c.person < 0: return "invalid cargo carrier"
        if not is_finite(c.pos.x) or not is_finite(c.pos.y) or not is_finite(c.pos.z): return "invalid cargo position"
    loop id, task in w.carriage:
        if id != task.id or task.person < 0 or task.person >= w.people.len(): return "invalid carriage identity/person"
        if task.phase != .done and task.phase != .cancelled:
            if not (task.cargo in w.cargo) or not (task.job in w.jobs): return "invalid active carriage cargo/job"
        if task.waypoint < 0 or task.waypoint > task.route.len() or task.fee < 0 or task.escrow >= w.accounts.len(): return "invalid carriage route/payment"
    map_error = validate_maps(w)
    if map_error != "": return map_error
    life_error = validate_life(w)
    if life_error != "": return life_error
    war_error = validate_war(w)
    if war_error!="": return war_error
    far_error = validate_far(w)
    if far_error != "": return far_error
    errors = invariant_errors(w)
    if errors.len() > 0: return errors.join("; ")
    ""

header_for = (name: str) -> SaveHeader:
    raw = load_data(name)
    if raw == none: return SaveHeader()
    parsed = from_text[SaveHeader](raw!)
    if parsed is TextError: return SaveHeader()
    parsed

supported_save_header = (header: SaveHeader) -> bool:
    (header.schema==1 and header.encoding==0) or (header.schema==2 and header.encoding==1) or (header.schema==3 and (header.encoding==2 or header.encoding==3))

read_game_slot = (name: str, header: SaveHeader) -> SaveGame:
    if header.schema==1: return load_value(name,SaveGame())
    text=load_data(name) ?? return SaveGame()
    if header.schema==3:
        metadata=from_text[BinaryLivingSave](text)
        if metadata is TextError: return SaveGame()
        body=load_data(name+"-data") ?? return SaveGame()
        # Invalid pairs remain in place for diagnosis; don't duplicate a multi-megabyte
        # damaged body into browser storage that may already be near its quota.
        if let game=unpack_binary_living_save(metadata,body): return game
        return SaveGame()
    packed=from_text[PackedLivingSave](text)
    if packed is TextError:
        save_data(name+".bad",text); return SaveGame()
    if let game=unpack_living_save(packed): return game
    save_data(name+".bad",text)
    SaveGame()

load_game = (terrain_key: int, prefix: str = "world") -> SaveResult:
    a_name = "{prefix}-a"; b_name = "{prefix}-b"
    ah = header_for(a_name); bh = header_for(b_name)
    if (ah.valid and ah.cargo_version != 1) or (bh.valid and bh.cargo_version != 1): return LivingSaveError("cargo content requires migration; old slots left untouched")
    if (ah.valid and not supported_save_header(ah)) or (bh.valid and not supported_save_header(bh)): return LivingSaveError("unsupported save schema; both slots left untouched")
    a = read_game_slot(a_name,ah); b = read_game_slot(b_name,bh)
    av = a.valid and supported_save_header(ah) and a.terrain_key == terrain_key and validate_save_world(a.world) == ""
    bv = b.valid and supported_save_header(bh) and b.terrain_key == terrain_key and validate_save_world(b.world) == ""
    if not av and not bv: return LivingSaveError("no valid save slot for this terrain/schema; corrupt data preserved by load_value, no new game created")
    if av and (not bv or a.generation >= b.generation): return a
    b

const KEPT_BATTLE_SIGHTINGS = 24

# Cards are kept while their engagement is still fought (only a current contact can show one);
# declined contracts while the office still offers them; the chart's last few battles.
prune_war_presentation = (w: World, state: mut PresentationState):
    current: {int: bool}
    loop _, c in w.war.contacts: current[c.engagement] = true
    keys = state.battle_cards.keys()
    loop key in keys:
        if not (key in current): state.battle_cards.remove(key)
    ids = state.declined_missions.keys()
    loop id in ids:
        if not (id in w.war.missions) or w.war.missions[id].state != .open: state.declined_missions.remove(id)
    if state.battles_seen.len() > KEPT_BATTLE_SIGHTINGS: state.battles_seen = state.battles_seen[(state.battles_seen.len() - KEPT_BATTLE_SIGHTINGS)..state.battles_seen.len()]
    state.battle_cards = ordered_map(state.battle_cards,(key: int): key)
    state.declined_missions = ordered_map(state.declined_missions,(id: int): id)

save_game = (w: World, presentation: PresentationState, terrain_key: int, prefix: str = "world") -> int | LivingSaveError:
    validation = validate_save_world(w)
    if validation != "": return LivingSaveError(validation)
    loop _, contact in w.war.contacts:
        if contact.state==.physical and w.war.scene_tick!=w.tick: return LivingSaveError("checkpoint the full physical fleet and battle at this tick before save")
    # Coordinator must synchronize and fold scene bodies at a fixed tick before this call.
    # Their extra physics state is the coordinator's schema extension, never regenerated here.
    loop v in w.far.vehicles:
        if v.scene_owned: return LivingSaveError("synchronize/fold scene transport before save")
    loop c in w.aircraft:
        if c.move_owner == .scene: return LivingSaveError("synchronize/fold scene aircraft before save")
    loop p in w.people:
        if p.move_owner == .scene: return LivingSaveError("synchronize/fold scene people before save")
    a_name = "{prefix}-a"; b_name = "{prefix}-b"
    ah = header_for(a_name); bh = header_for(b_name)
    if (ah.valid and ah.cargo_version != 1) or (bh.valid and bh.cargo_version != 1): return LivingSaveError("cargo content requires migration; old slots left untouched")
    if (ah.valid and not supported_save_header(ah)) or (bh.valid and not supported_save_header(bh)): return LivingSaveError("unsupported save schema; refusing to overwrite either slot")
    if (ah.valid and ah.terrain_key != terrain_key) or (bh.valid and bh.terrain_key != terrain_key): return LivingSaveError("terrain migration required; existing slots left untouched")
    old = load_game(terrain_key,prefix)
    generation = 1
    target = a_name
    if old is SaveGame:
        generation = old.generation+1
        target = if ah.valid and ah.generation == old.generation: b_name else: a_name
    state = presentation
    bark_keys = state.bark_day.keys()
    loop key in bark_keys:
        if state.bark_day[key] < day_index(w.minute)-2: state.bark_day.remove(key)
    hail_ids = state.hailed_jobs.keys()
    loop id in hail_ids:
        if not (id in w.jobs): state.hailed_jobs.remove(id)
    state.bark_day = ordered_map(state.bark_day,(key: BarkKey): (key.speaker,key.event))
    state.hailed_jobs = ordered_map(state.hailed_jobs,(id: int): id)
    prune_war_presentation(w,state)
    game = SaveGame(schema=1,valid=true,generation=generation,terrain_key=terrain_key,world=canonical_world(w),presentation=state)
    packed=pack_binary_living_save(game)
    target_header=if target==a_name: ah else: bh
    if target_header.schema!=3:
        # Free the older text bank before adding its new binary body. The latest valid
        # bank is the OTHER one and is retained if either subsequent write fails.
        if not save_value(target,BinaryLivingSave(valid=false)): return LivingSaveError("write failed: {file_error()}; previous slot retained")
    if not save_data(target+"-data",packed.1): return LivingSaveError("write failed: {file_error()}; previous slot retained")
    if not save_value(target,packed.0): return LivingSaveError("header write failed: {file_error()}; previous slot retained")
    generation
