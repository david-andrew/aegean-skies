# Strict by default (including tests/headless tools). The game explicitly opts into recovery.
# Diagnostics are process-local and never change deterministic simulation/save state.
struct LivingFault:
    site: str
    context: str
    count = 1

_living_strict = true
_living_fault_epoch = 0
_living_faults: {str: LivingFault}

set_living_strict = (strict: bool):
    global _living_strict
    _living_strict = strict

living_strict = () -> bool: _living_strict
living_fault_epoch = () -> int: _living_fault_epoch
living_faults = () -> LivingFault[]: [loop _, fault in _living_faults: fault]

living_fault = (site: str, context: str = "") -> bool:
    global _living_fault_epoch, _living_faults
    _living_fault_epoch += 1
    if _living_strict: panic("living invariant {site}: {context}")
    if site in _living_faults:
        _living_faults[site].count += 1
    else if _living_faults.len()<512:
        _living_faults[site] = LivingFault(site,context)
        eprint("[living recovery] {site}: {context}; refusing this step (strict validation is off)")
    false

finite_living_point = (p: vec3) -> bool: is_finite(p.x) and is_finite(p.y) and is_finite(p.z)
