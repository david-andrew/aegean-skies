# Things on the islands: trees (instanced, by island), and the towns (houses, chapels, quays, one
# mesh per settlement), drawn with the same painted light as the ground.

use 'quality.jo'
use 'terrain_lod.jo'
use 'world.jo'
use 'geography.jo'
use 'world_source.jo'
use 'settlements.jo'
use 'settlement_ports.jo'
use 'look.jo'
use 'paint.jo'
use 'weather_scene.jo'
use 'plants.jo'
use 'render_space.jo'

# ---------------- the painted light for vertex-colored things ----------------

struct ObjParams:
    view_proj: mat4
    model: mat4
    tint: vec4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    sky: vec3
    shade: vec3
    haze: vec3
    fog: f32
    time: f32
    sway: f32                       # how much tall things move in the wind
    wind: vec4                      # the way it blows (x, z), its speed
    drift: vec2                     # how far its gusts have moved
    flex: vec4 = vec4(0, 0, 0, 0)   # an aircraft's airframe: wings bending (x), shaking (y), fluttering (z); its half span (w)
    warp_a: vec4                    # (the speed trial's warp: render_space.jo)
    warp_b: vec4
    wet: f32 = 0.0
    pigment: Texture = Texture()
    origin: vec3 = vec3(0,0,0)
    pigment_phase: vec4 = vec4(0,0,0,0)
    sway_phase: vec4 = vec4(0,0,0,0)

struct ObjOut:
    pos: vec4
    world: vec3
    normal: vec3
    color: vec4
    surface: vec3 = vec3(0,0,0) # opening UV / material: 1 foliage, 2 recess

# Shared by the original and streamed-town vertex paths as well as groves.
obj_surface = (v: Vertex3D, sway: f32 = 0.0) -> vec3:
    material = if v.uv.x >= 180.0 and v.uv.x <= 181.0: 2.0 else: if (sway > 0.0 or v.uv.x == 173.0) and v.color.y > v.color.x*1.15: 1.0 else: 0.0
    vec3(v.uv.x-180.0,v.uv.y,material)

obj_base_light = (i: ObjOut,u: ObjParams,n: vec3,ndl: f32) -> vec3:
    lit = paint_ramp(ndl,max(fwidth(ndl)*0.65,0.015))
    light = mix(u.shade*1.12+vec3(0.06,0.07,0.09)*min(u.sun,vec3(1,1,1)),u.sun*vec3(1.02,1.0,0.94),lit)
    # a little light from below, off the sea
    light = light + vec3(0.03, 0.06, 0.08) * min(u.sun,vec3(1,1,1)) * clamp(-n.y, 0.0, 1.0)
    i.color.xyz * light

obj_finish_light = (color: vec3,i: ObjOut,u: ObjParams,n: vec3) -> vec4:
    c = color
    if u.wet > 0.001:
        wet = u.wet*smoothstep(0.2,0.8,n.y)
        view = normalize(u.cam-i.world)
        sheen = pow(max(dot(reflect(-view,n),normalize(u.sun_dir)),0.0),42.0)
        c = c*(1.0-wet*0.24)+mix(u.sky,u.haze,0.5)*(wet*0.12)+u.sun*(wet*sheen*0.35)
    # (alpha below 1 marks what glows after dark: lamps, lit windows)
    if i.color.w < 0.9:
        # (by the sun's height, not its brightness: a rainy morning is dim, but nobody lights lamps)
        night = 1.0 - smoothstep(-0.04, 0.1, normalize(u.sun_dir).y)
        c = mix(c, vec3(1.0, 0.72, 0.38) * (1.6 + 0.4 * i.color.w), night)
    vec4(aerial(c, i.world, u.cam, u.haze, u.fog)*paint_paper(i.pos.xy), 1.0)

obj_light = (i: ObjOut,u: ObjParams) -> vec4:
    n = normalize(i.normal)
    ndl = dot(n,normalize(u.sun_dir))
    c = obj_base_light(i,u,n,ndl)
    # Subpixel crowns and distant roof washes converge to the base material.
    # Keep their texture work out of the heavily instanced distant groves.
    paint_near = 1.0-smoothstep(120.0,300.0,length(i.world-u.cam))
    if paint_near > 0.0:
        # A broad pigment wash rather than per-pixel speckle on walls and roofs.
        uv = (i.world.xz+vec2(i.world.y*0.7,i.world.y*0.43))/18.0+u.pigment_phase.xy
        foliage = i.surface.z > 0.5 and i.surface.z < 1.5
        if foliage: uv = i.world.xz/12.0+u.pigment_phase.zw+vec2(i.world.y*0.08,0)
        pigment = sample(u.pigment,uv)
        wash = pigment.w-0.5
        resolved = (1.0-smoothstep(0.04,0.14,max(fwidth(uv.x),fwidth(uv.y))))*paint_near
        roof = step(i.color.y*1.4,i.color.x)*step(i.color.z*1.3,i.color.x)
        c *= 1.0+wash*(0.28+roof*0.45)*resolved
        if foliage:
            # Existing rounded crown geometry, with smaller painted lobes inside it.
            leaf = pigment.xyz*2.0-vec3(1,1,1)
            # The crown's silhouette carries the crisp light boundary; soften
            # the small dabs inside it so adjacent lobes do not look cracked.
            dap = paint_ramp(dot(leaf,normalize(u.sun_dir)),0.18)
            c *= mix(vec3(1,1,1),vec3(mix(0.88,1.12,dap))*vec3(1.04,1.0,0.95),resolved)
    if i.surface.z > 1.5:
        # A painted top/side recess on the existing door/window triangles.
        edge = max(fwidth(i.surface.x),fwidth(i.surface.y))*1.2+0.015
        inset = smoothstep(0.10-edge,0.10+edge,i.surface.x)*(1.0-smoothstep(0.82-edge,0.82+edge,i.surface.y))
        c = mix(c*vec3(0.34,0.43,0.58),c,inset)
    if u.flex.w > 0.0:
        view = normalize(u.cam-i.world)
        rim = smoothstep(0.72,0.94,1.0-max(dot(n,view),0.0))*smoothstep(-0.15,0.25,ndl)
        c += i.color.xyz*u.sun*(rim*0.16)
    obj_finish_light(c,i,u,n)

obj_vs = (v: Vertex3D, u: ObjParams) -> ObjOut:
    p = v.pos
    if u.flex.w > 0.0:
        # an airframe working: the wings bow up under load and shake at their tips, the tail
        # surfaces and the wings' trailing edges flutter (all as a share of the half span out)
        out = clamp(abs(p.x) / u.flex.w, 0.0, 1.0)
        tip = out * out
        shake = sin(u.time * 47.0 + p.x * 1.3) * 0.6 + sin(u.time * 71.0 - p.x * 2.1) * 0.4
        tail = smoothstep(2.6, 4.4, p.z)
        trail = smoothstep(-0.2, 0.6, p.z) * (1.0 - tail) * out
        flutter = sin(u.time * 33.0 + p.x * 4.0 + p.z * 6.0) * (tail * 0.7 + trail * 0.5)
        p = p + vec3(flutter * u.flex.z * 0.15 * tail, tip * (u.flex.x + shake * u.flex.y) + flutter * u.flex.z * 0.12, 0)
    w = u.model * vec4(p, 1)
    # Baked town trees carry their original local height in a reserved UV tag.
    # Architecture shares this mesh but never receives the tag or bends.
    if v.uv.x == 173.0 and v.color.y > v.color.x*1.15:
        bend = max(v.uv.y,0.0)*u.wind.z*0.006*(0.3+0.7*gust(w.xz,u.drift))
        w += vec4(u.wind.x*bend,0,u.wind.y*bend,0)
    ObjOut(u.view_proj * w, w.xyz, (u.model * vec4(v.normal, 0)).xyz, v.color * u.tint,obj_surface(v))

obj_vs_inst = (v: Vertex3D, inst: Instance3D, u: ObjParams) -> ObjOut:
    w = render_model(inst.model,u.origin) * vec4(v.pos, 1)
    # Fade centimetres of crown motion before they become subpixel; distant
    # grove batches need neither gust noise nor sway trigonometry.
    sway = u.sway*(1.0-smoothstep(180.0,420.0,length(w.xyz-u.cam)))
    if sway > 0.0:
        g = gust(w.xz, u.drift)
        lean = sway * max(v.pos.y, 0.0) * 0.0035 * u.wind.z * (0.25 + 0.75 * g)
        ph = w.x * 0.05 + w.z * 0.04
        phase = ph+u.sway_phase.x
        sw = sway * max(v.pos.y, 0.0) * 0.004 * (0.5 + u.wind.z * 0.2) * (0.4 + g)
        w = w + vec4(u.wind.x * lean + sin(phase) * sw, -lean * 0.15, u.wind.y * lean + cos(ph * 0.8+u.sway_phase.y) * sw * 0.6, 0)
    ObjOut(u.view_proj * w, w.xyz, (inst.model * vec4(v.normal, 0)).xyz, v.color * inst.color,obj_surface(v,u.sway))

# A separate pipeline lets the driver eliminate unused pigment/recess varyings
# and all wind work for cells wholly beyond the resolved animation range.
obj_far_vs = (v: Vertex3D, inst: Instance3D, u: ObjParams) -> ObjOut:
    w = render_model(inst.model,u.origin) * vec4(v.pos, 1)
    ObjOut(u.view_proj*w,w.xyz,(inst.model*vec4(v.normal,0)).xyz,v.color*inst.color)
obj_far_fs = (i: ObjOut, u: ObjParams) -> vec4:
    n = normalize(i.normal)
    c = obj_base_light(i,u,n,dot(n,normalize(u.sun_dir)))
    obj_finish_light(c,i,u,n)

obj_fs = (i: ObjOut, u: ObjParams) -> vec4: obj_light(i, u)

obj_sh: Shader
obj_inst_sh: Shader
obj_far_sh: Shader

obj_params = (L: Light, t: f64, model: mat4 = mat4(), tint: vec4 = vec4(1, 1, 1, 1), sway: f64 = 0.0, flex: vec4 = vec4(0, 0, 0, 0)) -> ObjParams:
    p = ObjParams(scene_view_proj(), model, tint, scene_camera(), L.sun_dir, L.sun, L.sky_top, L.shade, L.haze, f32(L.fog_density), f32(t), f32(sway),
        vec4(wind_now.dir.x, wind_now.dir.y, f32(wind_now.speed), 0), wind_now.drift, flex, scene_warp_a, scene_warp_b,if weather_active: weather_here.rain else: 0.0)
    p.origin = render_origin(p.cam)
    p.view_proj = render_view_proj(p.origin)
    p.cam = render_eye(p.origin)
    p.model = render_model(model,p.origin)
    p.warp_a = render_anchor(p.warp_a,p.origin)
    p.drift -= p.origin.xz
    p.pigment_phase = vec4(render_phase(f64(p.origin.x)/18.0,1),render_phase(f64(p.origin.z)/18.0,1),render_phase(f64(p.origin.x)/12.0,1),render_phase(f64(p.origin.z)/12.0,1))
    phase = t*(1.1+0.15*f64(p.wind.z))+f64(p.origin.x)*0.05+f64(p.origin.z)*0.04
    grass_phase = t*(2.2+0.2*f64(p.wind.z))+f64(p.origin.x)*0.4+f64(p.origin.z)*0.3
    p.sway_phase = vec4(render_phase(phase,TAU),render_phase(phase*0.8,TAU),render_phase(grass_phase,TAU),0)
    p.pigment = paint_surface()
    p

# ---------------- building blocks ----------------

# a gabled roof over a w x d footprint, its ridge along x, from height y0 rising by rise
add_gable = (vs: mut Vertex3D[], c: vec3, w: f64, d: f64, rise: f64, col: vec4, m: mat4):
    hw = f32(w * 0.5 + 0.35)
    hd = f32(d * 0.5 + 0.35)
    r = f32(rise)
    a = vec3(-hw, 0, -hd) + c
    b = vec3(hw, 0, -hd) + c
    e = vec3(hw, 0, hd) + c
    f = vec3(-hw, 0, hd) + c
    ra = vec3(-hw, r, 0) + c
    rb = vec3(hw, r, 0) + c
    tri = (vs: mut Vertex3D[], p: vec3, q: vec3, s: vec3, k: vec4):
        pw = transform_point(m, p)
        qw = transform_point(m, q)
        sw = transform_point(m, s)
        n = normalize(cross(qw - pw, sw - pw))
        vs.push(Vertex3D(pw, n, vec2(0, 0), k))
        vs.push(Vertex3D(qw, n, vec2(0, 0), k))
        vs.push(Vertex3D(sw, n, vec2(0, 0), k))
    dark = vec4(col.x * 0.85, col.y * 0.85, col.z * 0.85, 1)
    # the two slopes (counter-clockwise seen from outside)
    tri(vs, a, ra, rb, col); tri(vs, a, rb, b, col)
    tri(vs, f, e, rb, col); tri(vs, f, rb, ra, col)
    # the gable ends
    tri(vs, a, f, ra, dark); tri(vs, b, rb, e, dark)

WALLS = [vec4(0.95, 0.93, 0.88, 1), vec4(0.93, 0.9, 0.82, 1), vec4(0.91, 0.76, 0.52, 1), vec4(0.93, 0.8, 0.72, 1), vec4(0.84, 0.86, 0.8, 1), vec4(0.97, 0.95, 0.9, 1)]
ROOFS = [vec4(0.74, 0.34, 0.2, 1), vec4(0.68, 0.3, 0.19, 1), vec4(0.78, 0.42, 0.26, 1), vec4(0.62, 0.28, 0.2, 1)]
DOORS = [vec4(0.18, 0.38, 0.62, 1), vec4(0.2, 0.45, 0.32, 1), vec4(0.45, 0.25, 0.15, 1), vec4(0.55, 0.62, 0.7, 1)]

# Mark the existing opening geometry; no extra draw calls or triangles.
add_painted_opening = (vs: mut Vertex3D[], c: vec3, size: vec3, color: vec4, m: mat4):
    opening: Vertex3D[]
    add_box(opening,c,size,color)
    loop source in opening:
        v = source
        v.uv = vec2(180.0+clamp((v.pos.x-c.x)/size.x+0.5,0.0,1.0),clamp((v.pos.y-c.y)/size.y+0.5,0.0,1.0))
        v.pos = transform_point(m,v.pos)
        v.normal = (m*vec4(v.normal,0)).xyz
        vs.push(v)

# a house: whitewashed or ochre walls, a terracotta roof, a door and windows on its front (+z)
add_house = (vs: mut Vertex3D[], m: mat4, w: f64, d: f64, h: f64, rng: int):
    wall = WALLS[rng % WALLS.len()]
    roof = ROOFS[(rng / 7) % ROOFS.len()]
    door = DOORS[(rng / 3) % DOORS.len()]
    add_box(vs, vec3(0, f32(h * 0.5 - 1.0), 0), vec3(f32(w), f32(h + 2.0), f32(d)), wall, m)
    if (rng / 11) % 4 == 0:
        # a flat roof with a low parapet
        add_box(vs, vec3(0, f32(h + 0.15), 0), vec3(f32(w + 0.3), 0.3, f32(d + 0.3)), wall, m)
    else:
        add_gable(vs, vec3(0, f32(h), 0), w, d, min(w, d) * 0.22, roof, m)
    # door and windows on the front, shutters on the floors above
    fz = f32(d * 0.5 + 0.06)
    add_painted_opening(vs, vec3(f32(-w * 0.2), 0.0, fz), vec3(1.7, 3.0, 0.12), door, m)
    floors = max(1, int(h / 4.0))
    loop fl in 0..floors:
        y = f32(2.0 + f64(fl) * 4.0)
        loop k in 0..max(1, int(w / 4.4)):
            x = f32(-w * 0.5 + 2.6 + f64(k) * 4.4)
            if fl == 0 and abs(f64(x) + w * 0.2) < 1.9: continue
            lit = (rng / 13 + k * 7 + fl * 3) % 3 == 0
            win = if lit: vec4(0.15, 0.17, 0.22, 0.5) else: (if fl == 0: vec4(0.15, 0.17, 0.22, 1) else: door)
            add_painted_opening(vs, vec3(x, y, fz), vec3(1.4, 1.9, 0.12), win, m)

# a chapel: white, a dome or a bell tower
add_chapel = (vs: mut Vertex3D[], m: mat4):
    white = vec4(0.97, 0.96, 0.93, 1)
    add_box(vs, vec3(0, 3.0, 0), vec3(9, 10, 14), white, m)
    add_gable(vs, vec3(0, 8.0, 0), 9.0, 14.0, 2.6, ROOFS[0], m * rotation_y(PI / 2))
    add_box(vs, vec3(0, 7.5, -8.5), vec3(4, 15, 4), white, m)
    add_cylinder(vs, vec3(0, 15.0, -8.5), 2.2, 3.5, vec4(0.25, 0.45, 0.72, 1), 10, 0.0, m)
    add_box(vs, vec3(0, 1.4, 7.06), vec3(2.2, 3.6, 0.12), vec4(0.35, 0.22, 0.12, 1), m)

# A stone quay; legacy decks default to 1.2 m, new harbor decks are explicit.
QUAY_TOP = 1.2
add_quay = (vs: mut Vertex3D[], a: vec2, b: vec2, width: f64, top: f64 = QUAY_TOP):
    d = b - a
    len = f64(length(d))
    yaw = atan2(f64(d.x), f64(d.y))
    mid = (a + b) * 0.5
    m = translation(vec3(mid.x, 0, mid.y)) * rotation_y(yaw)
    stone = vec4(0.8, 0.76, 0.68, 1)
    add_box(vs, vec3(0, f32(top * 0.5 - 3.0), 0), vec3(f32(width), f32(top + 6.0), f32(len)), stone, m)
    add_box(vs, vec3(0, f32(top + 0.04), 0), vec3(f32(width - 0.4), 0.1, f32(len - 0.4)), vec4(0.72, 0.68, 0.6, 1), m)
    # bollards along both edges
    k = 0.0
    loop k < len - 2.0:
        loop side in [-1.0, 1.0]:
            add_cylinder(vs, vec3(f32(side * (width * 0.5 - 0.5)), f32(top), f32(-len * 0.5 + 1.0 + k)), 0.25, 0.7, vec4(0.2, 0.2, 0.22, 1), 6, -1.0, m)
        k += 12.0

# (a triangle facing away from `inside`, whatever order its corners come in)
_tri_out = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4, inside: vec3):
    n = normalize(cross(b - a, c - a))
    if dot(n, (a + b + c) / 3.0 - inside) < 0.0:
        vs.push(Vertex3D(a, -n, vec2(0, 0), col)); vs.push(Vertex3D(c, -n, vec2(0, 0), col)); vs.push(Vertex3D(b, -n, vec2(0, 0), col))
    else:
        vs.push(Vertex3D(a, n, vec2(0, 0), col)); vs.push(Vertex3D(b, n, vec2(0, 0), col)); vs.push(Vertex3D(c, n, vec2(0, 0), col))

# a caique's hull, lofted through sections bow (-z) to stern (+z): the sheer rising to a pointed
# stem and sternpost, a V bottom; painted above, a band under the gunwale, dark below the water;
# a deck inside the gunwale. (In the boat's frame, the waterline at y = 0.)
_hull = (vs: mut Vertex3D[], m: mat4, len: f64, beam: f64, hull: vec4, band: vec4, bottom: vec4, deck: vec4):
    n = 9
    rows: vec3[][] = []
    loop k in 0..n + 1:
        u = f64(k) / f64(n)                         # 0 bow .. 1 stern
        z = (u - 0.5) * len
        e = abs(u - 0.5) * 2.0                      # 0 midships .. 1 at an end
        w = beam * 0.5 * (1.0 - pow(e, 2.2)) + 0.02
        top = 0.85 + 0.75 * pow(e, 2.5)             # the sheer, rising to bow and stern
        depth = 0.75 * (1.0 - 0.6 * pow(e, 3.0))
        # (the ring, port to starboard: gunwale, band's foot, waterline, chine, keel)
        rows.push([vec3(f32(-w), f32(top), f32(z)), vec3(f32(-w * 0.98), f32(top - 0.28), f32(z)), vec3(f32(-w * 0.9), 0.0, f32(z)),
            vec3(f32(-w * 0.55), f32(-depth * 0.7), f32(z)), vec3(0, f32(-depth), f32(z)),
            vec3(f32(w * 0.55), f32(-depth * 0.7), f32(z)), vec3(f32(w * 0.9), 0.0, f32(z)), vec3(f32(w * 0.98), f32(top - 0.28), f32(z)), vec3(f32(w), f32(top), f32(z))])
    cols = [band, hull, bottom, bottom, bottom, bottom, hull, band]
    loop k in 0..n:
        a = rows[k]
        b = rows[k + 1]
        loop i in 0..8:
            ins = vec3(0, f32(if i >= 2 and i <= 5: 0.2 else: 0.4), a[i].z * 0.5 + b[i].z * 0.5)
            pa = transform_point(m, a[i]); pb = transform_point(m, b[i]); pc = transform_point(m, b[i + 1]); pd = transform_point(m, a[i + 1])
            ip = transform_point(m, ins)
            _tri_out(vs, pa, pb, pc, cols[i], ip)
            _tri_out(vs, pa, pc, pd, cols[i], ip)
        # the deck, a little below the gunwale
        d0 = vec3(a[0].x * 0.92, a[0].y - 0.18, a[0].z); d1 = vec3(a[8].x * 0.92, a[8].y - 0.18, a[8].z)
        d2 = vec3(b[8].x * 0.92, b[8].y - 0.18, b[8].z); d3 = vec3(b[0].x * 0.92, b[0].y - 0.18, b[0].z)
        below = transform_point(m, vec3(0, -1.0, (a[0].z + b[0].z) * 0.5))
        _tri_out(vs, transform_point(m, d0), transform_point(m, d1), transform_point(m, d2), deck, below)
        _tri_out(vs, transform_point(m, d0), transform_point(m, d2), transform_point(m, d3), deck, below)

# a fishing caique (afloat at y = 0): its hull, a little cabin aft, a mast and boom; out at work
# its sail is set (a tan lateen-like sail, bellied, turned to the wind's side by `trim`), at the
# quay it is furled along the boom. Gives back the masthead (in the frame of m), for a flag.
add_boat = (vs: mut Vertex3D[], m: mat4, rng: int, sailing: bool = false, trim: f64 = 0.5) -> vec3:
    hulls = [rgb(0.25, 0.45, 0.62), rgb(0.92, 0.9, 0.84), rgb(0.7, 0.3, 0.2), rgb(0.3, 0.5, 0.35), rgb(0.9, 0.75, 0.35)]
    hull = hulls[rng % hulls.len()]
    band = hulls[(rng / 5 + 2) % hulls.len()]
    len = 7.5 + f64(rng % 4)
    beam = 2.5 + f64(rng % 3) * 0.2
    _hull(vs, m, len, beam, hull, band, rgb(0.35, 0.16, 0.12), rgb(0.62, 0.5, 0.36))
    # the cabin aft, its roof, a window
    add_box(vs, vec3(0, 1.35, f32(len * 0.18)), vec3(1.5, 1.2, 1.8), rgb(0.94, 0.92, 0.86), m)
    add_box(vs, vec3(0, 2.0, f32(len * 0.18)), vec3(1.7, 0.12, 2.0), band, m)
    add_box(vs, vec3(0, 1.5, f32(len * 0.18 - 0.91)), vec3(0.9, 0.45, 0.04), rgb(0.15, 0.17, 0.22), m)
    # the mast, forward of the cabin, and its boom
    mast_z = -len * 0.12
    mast_h = 6.0 + f64(rng % 3) * 0.6
    add_cylinder(vs, vec3(0, 0.6, f32(mast_z)), 0.09, mast_h, rgb(0.45, 0.32, 0.2), 6, 0.06, m)
    head = vec3(0, f32(0.6 + mast_h), f32(mast_z))
    sail = rgb(0.86, 0.72, 0.5)
    if sailing:
        # (the sail: from the masthead down to the boom, swung out to one side; two-sided)
        side = if rng % 2 == 0: 1.0 else: -1.0
        a = trim * side
        boom_len = len * 0.55
        tack = vec3(0, 1.6, f32(mast_z - 0.6))
        clew = vec3(f32(sin(a) * boom_len), 1.7, f32(mast_z + cos(a) * boom_len))
        top = head - vec3(0, 0.3, 0)
        add_cylinder(vs, vec3(0, 0, 0), 0.05, f64(length(clew - tack)), rgb(0.45, 0.32, 0.2), 5, -1.0, m * translation(tack) * _toward(clew - tack))
        belly = normalize(cross(clew - tack, top - tack)) * f32(0.35 * side)
        steps = 4
        loop r in 0..steps:
            u0 = f64(r) / f64(steps)
            u1 = f64(r + 1) / f64(steps)
            # (rows from the foot up; each bowed out at its middle)
            p0a = tack + (top - tack) * f32(u0); p0b = clew + (top - clew) * f32(u0)
            p1a = tack + (top - tack) * f32(u1); p1b = clew + (top - clew) * f32(u1)
            mid0 = (p0a + p0b) * 0.5 + belly * f32(1.0 - u0); mid1 = (p1a + p1b) * 0.5 + belly * f32(1.0 - u1)
            loop face in [1.0, -1.0]:
                o = belly * f32(-face * 4.0)
                _tri_out(vs, transform_point(m, p0a), transform_point(m, mid0), transform_point(m, mid1), sail, transform_point(m, mid0 + o))
                _tri_out(vs, transform_point(m, p0a), transform_point(m, mid1), transform_point(m, p1a), sail, transform_point(m, mid0 + o))
                _tri_out(vs, transform_point(m, mid0), transform_point(m, p0b), transform_point(m, p1b), sail, transform_point(m, mid0 + o))
                _tri_out(vs, transform_point(m, mid0), transform_point(m, p1b), transform_point(m, mid1), sail, transform_point(m, mid0 + o))
    else:
        # (furled: the boom along the boat with the sail bundled on it)
        add_box(vs, vec3(0, 1.75, f32(mast_z + len * 0.25)), vec3(0.3, 0.3, f32(len * 0.5)), sail, m)
    head

# (a turn that points +y along d: for a cylinder laid along d)
_toward = (d: vec3) -> mat4:
    y = normalize(d)
    x = normalize(cross(y, if abs(f64(y.z)) < 0.9: vec3(0, 0, 1) else: vec3(1, 0, 0)))
    z = cross(x, y)
    mat4(vec4(x, 0), vec4(y, 0), vec4(z, 0), vec4(0, 0, 0, 1))

# a lamp post on a quay
add_lamp = (vs: mut Vertex3D[], at: vec3):
    add_cylinder(vs, at, 0.07, 3.4, rgb(0.15, 0.15, 0.16), 6)
    add_box(vs, at + vec3(0, 3.55, 0), vec3(0.32, 0.4, 0.32), rgba(0.95, 0.85, 0.55, 0.8))
    add_box(vs, at + vec3(0, 3.8, 0), vec3(0.42, 0.08, 0.42), rgb(0.15, 0.15, 0.16))

# crates and barrels, stacked
add_cargo = (vs: mut Vertex3D[], m: mat4, rng: int):
    wood = rgb(0.6, 0.45, 0.28)
    loop k in 0..(2 + rng % 3):
        x = f32(f64(k % 2) * 1.0 - 0.5)
        y = f32(f64(k / 2) * 0.8)
        add_box(vs, vec3(x, 0.4 + y, f32(f64(k % 3) * 0.1)), vec3(0.9, 0.8, 0.9), if k % 3 == 2: rgb(0.52, 0.38, 0.24) else: wood, m)
    loop k in 0..(rng / 3 % 3):
        add_cylinder(vs, vec3(f32(-0.4 + f64(k) * 0.75), 0, 1.1), 0.34, 0.95, rgb(0.5, 0.32, 0.2), 8, -1.0, m)

# ---------------- towns ----------------

# a boat out on the water: its mesh (turned its way, at the origin), where it is, its masthead (in
# its own frame, for its flag)
struct Boat:
    mesh: Mesh
    at: vec3
    head: vec3

struct Town:
    name: str
    center: vec3                    # the waterfront, where the main quay starts
    out: vec2                       # the way out to sea
    docks: vec3[]                   # where a seaplane can moor (beside the quay, on the water)
    houses: vec3[]                  # house centers (for keeping trees away, and for people to go to)
    quays: Quay[]                   # where one can walk out over the water
    blocks: vec3[]                  # what one cannot walk through: x, z and a radius
    mesh: Mesh
    boats: Boat[]                   # moored along the quays, each its own mesh, to ride the swell
    far_mesh: Mesh                  # same house footprints, no doors/shutters at long range
    chapels: vec3[]                 # presentation anchors, not new simulation places

struct Quay:
    a: vec2
    b: vec2
    width: f32

_hash = (a: int, b: int) -> int:
    h = u64(a) * u64(0x9E3779B97F4A7C15) + u64(b) * u64(0xBF58476D1CE4E5B9)
    h = (h xor (h >> 31)) * u64(0x94D049BB133111EB)
    int((h xor (h >> 29)) & u64(0x7FFFFFFF))

build_town = (s: Settlement) -> Town:
    seed_random(s.seed)
    coast, out = coast_point(s.island, s.bearing)
    tangent = vec2(-out.y, out.x)
    vs: Vertex3D[]
    far_vs: Vertex3D[]
    houses: vec3[]
    chapels: vec3[]
    docks: vec3[]
    # the main quay: out from the shore, a seaplane moors on either side near its end
    qa = coast - out * 12.0
    qlen = if s.kind == .port: 70.0 else: if s.kind == .cove: 25.0 else: 45.0
    qb = coast + out * f32(qlen)
    quays: Quay[]
    blocks: vec3[]
    add_quay(vs, qa, qb, if s.kind == .port: 8.0 else: 5.0)
    quays.push(Quay(qa, qb, if s.kind == .port: 8.0 else: 5.0))
    loop side in [-1.0, 1.0]:
        p = coast + out * f32(qlen - 12.0) + tangent * f32(side * 10.0)
        docks.push(vec3(p.x, 0, p.y))
    if s.kind == .port:
        # a long waterfront along the shore, and a second pier
        add_quay(vs, coast - tangent * 90.0 - out * 2.0, coast + tangent * 90.0 - out * 2.0, 10.0)
        quays.push(Quay(coast - tangent * 90.0 - out * 2.0, coast + tangent * 90.0 - out * 2.0, 10.0))
        qc = coast + tangent * 80.0
        add_quay(vs, qc - out * 6.0, qc + out * 55.0, 6.0)
        quays.push(Quay(qc - out * 6.0, qc + out * 55.0, 6.0))
        p = qc + out * 45.0 + tangent * 9.0
        docks.push(vec3(p.x, 0, p.y))
    if s.kind == .hotel:
        # one grand house on its islet, facing the dock
        ic = ISLANDS[s.island].center
        m = translation(vec3(ic.x, f32(surface_height(f64(ic.x), f64(ic.y))), ic.y)) * rotation_y(atan2(f64(out.x), f64(out.y)))
        add_house(vs, m, 22.0, 16.0, 13.0, 3)
        add_box(vs, vec3(0, 16.0, 0), vec3(8, 6, 8), WALLS[3], m)
        add_gable(vs, vec3(0, 19.0, 0), 8.0, 8.0, 2.4, ROOFS[2], m)
        houses.push(vec3(ic.x, 0, ic.y))
        blocks.push(vec3(ic.x, ic.y, 11.5))
    else:
        # the houses: rows along the shore, one behind the other up the slope, side by side with
        # now and then an alley between; the chapel among them
        # (houses half as big again as life-sized ones: beside the people and the aircraft, ones
        # one could live in)
        row_gap = 19.0
        first = if s.kind == .monastery: 70.0 else: (if s.kind == .port: 18.0 else: 22.0)
        half = 40.0 + f64(s.size) * (if s.kind == .port: 2.8 else: 3.8)
        maxh = if s.kind == .monastery: 260.0 else: 90.0
        chapel_done = s.kind == .cove
        row = 0
        loop houses.len() < s.size and row < 14:
            inland = first + f64(row) * row_gap + random(-1.5, 1.5)
            along = -half + random(0.0, 6.0)
            # rows further up are shorter: the town tapers up the hill
            reach = half * (1.0 - 0.06 * f64(row))
            loop along < reach and houses.len() < s.size:
                w = random(8.5, 14.0)
                d = random(9.5, 13.5)
                # (the shore here: from out at sea, inland till dry ground; the rows follow it)
                base = coast + tangent * f32(along + w * 0.5)
                r = -80.0
                loop r < 260.0 and surface_height(f64(base.x - out.x * f32(r)), f64(base.y - out.y * f32(r))) < 1.2: r += 3.0
                c = base - out * f32(r + inland)
                h = surface_height(f64(c.x), f64(c.y))
                ok = h > 1.6 and h < maxh and slope_at(f64(c.x), f64(c.y)) < 0.6
                if not ok:
                    along += 5.0
                    continue
                yaw = atan2(f64(out.x), f64(out.y)) + random(-0.04, 0.04)
                # (stood on the lowest corner's ground, so no side floats)
                lo = h
                loop cx in [-1.0, 1.0]:
                    loop cz in [-1.0, 1.0]:
                        q = c + tangent * f32(cx * w * 0.5) - out * f32(cz * d * 0.5)
                        lo = min(lo, surface_height(f64(q.x), f64(q.y)))
                m = translation(vec3(c.x, f32(lo), c.y)) * rotation_y(yaw)
                if not chapel_done and row == 1 and along > -10.0:
                    add_chapel(vs, m * scaling(1.4))
                    chapels.push(vec3(c.x,f32(lo),c.y))
                    add_house_proxy(far_vs,m*scaling(1.4),9.0,14.0,10.0,0)
                    chapel_done = true
                    houses.push(vec3(c.x, f32(lo), c.y))
                    blocks.push(vec3(c.x, c.y, 10.5))
                    along += 17.0
                    continue
                storeys = if s.kind == .port and row < 2: random_int(2, 3) else: random_int(1, 2)
                hh = f64(storeys) * 4.0 + random(0.4, 1.5) + (h - lo)
                add_house(vs, m, w, d, hh, _hash(s.seed, houses.len()))
                add_house_proxy(far_vs,m,w,d,hh,_hash(s.seed,houses.len()))
                houses.push(vec3(c.x, f32(h), c.y))
                blocks.push(vec3(c.x, c.y, f32(min(w, d) * 0.55)))
                along += w + (if random() < 0.18: random(3.0, 5.0) else: random(0.0, 0.6))
            row += 1
    # the waterfront: fishing boats moored along the quays, crates and barrels, lamps
    boats: Boat[]
    if s.kind != .hotel:
        nboats = if s.kind == .port: 7 else: (if s.kind == .cove: 1 else: 4)
        loop k in 0..nboats:
            q = quays[k % quays.len()]
            dq = q.b - q.a
            ql = length(dq)
            u = random(0.15, 0.7)
            side = if k % 2 == 0: 1.0 else: -1.0
            nrm = vec2(-dq.y, dq.x) / ql
            bp = q.a + dq * f32(u) + nrm * f32(side * (f64(q.width) * 0.5 + 2.2))
            if surface_height(f64(bp.x), f64(bp.y)) > -1.2: continue
            bm = rotation_y(atan2(f64(dq.x), f64(dq.y)) + random(-0.08, 0.08))
            bvs: Vertex3D[]
            head = add_boat(bvs, bm, _hash(s.seed, 100 + k))
            # (moored clear of the quay: its own half-beam out from the edge, and a fender's gap)
            ext = 0.0
            loop v in bvs: ext = max(ext, abs(f64(v.pos.x * nrm.x + v.pos.z * nrm.y)))
            bp = q.a + dq * f32(u) + nrm * f32(side * (f64(q.width) * 0.5 + ext + 0.6))
            if surface_height(f64(bp.x), f64(bp.y)) > -1.2: continue
            boats.push(Boat(custom_mesh(bvs), vec3(bp.x, 0, bp.y), transform_point(bm, head)))
        loop q in quays:
            dq = q.b - q.a
            ql = f64(length(dq))
            nrm = vec2(-dq.y, dq.x) / f32(ql)
            # lamps along the quay; owned goods are separate scene records
            k = 8.0
            loop k < ql - 4.0:
                lp = q.a + dq * f32(k / ql) + nrm * f32(f64(q.width) * 0.5 - 0.6)
                add_lamp(vs, vec3(lp.x, f32(QUAY_TOP), lp.y))
                k += 26.0
            # Goods are drawn from owned living cargo records, never baked as decoration.
    if s.kind == .cove:
        # a hangar dug into the rock: a dark mouth with a wooden frame
        p = coast - out * 30.0
        h = surface_height(f64(p.x), f64(p.y))
        m = translation(vec3(p.x, f32(max(h, 1.0)), p.y)) * rotation_y(atan2(f64(out.x), f64(out.y)))
        add_box(vs, vec3(0, 4.0, 0), vec3(24, 10, 4), vec4(0.1, 0.09, 0.08, 1), m)
        add_box(vs, vec3(0, 9.5, 2.2), vec3(26, 1.2, 0.8), vec4(0.45, 0.3, 0.18, 1), m)
    Town(s.name, vec3(coast.x, f32(QUAY_TOP), coast.y), out, docks, houses, quays, blocks, custom_mesh(vs), boats, custom_mesh(if s.kind == .hotel: vs else: far_vs),chapels)

# ---------------- trees ----------------

enum Tree: pine, cypress, bush

# Keep the same grove population on low quality; simplify hidden crown rings
# instead of removing more trees. These helpers run only while building meshes.
tree_sides = (n: int) -> int: if render_quality.tier == 0: max(5,n-2) else: n
tree_rings = (n: int) -> int: if render_quality.tier == 0: max(2,n-3) else: if render_quality.tier == 1: max(3,n-1) else: n

grove_far_meshes: Mesh[]

build_tree_meshes = (simple: bool = false) -> Mesh[]:
    sides = (n: int) -> int: if simple: max(5,n-2) else: tree_sides(n)
    rings = (n: int) -> int: if simple: max(2,n-3) else: tree_rings(n)
    trunk = vec4(0.4, 0.28, 0.19, 1)
    # an umbrella pine: a leaning trunk forking near the top, a flat crown of overlapping clumps
    # with a darker underside where the light does not reach
    pine: Vertex3D[]
    add_cylinder(pine, vec3(0, -1, 0), 0.42, 8.0, trunk, 7, 0.3)
    add_cylinder(pine, vec3(0, 0, 0), 0.22, 2.4, trunk, 6, 0.12, translation(vec3(0,6.2,0))*rotation_z(0.5))
    add_cylinder(pine, vec3(0, 0, 0), 0.22, 2.4, trunk, 6, 0.12, translation(vec3(0,6.2,0))*rotation_z(-0.45) * rotation_y(1.3))
    dark = vec4(0.1, 0.22, 0.1, 1)
    mid = vec4(0.17, 0.33, 0.14, 1)
    light = vec4(0.24, 0.4, 0.17, 1)
    add_sphere(pine,vec3(0,0,0), 1.0, dark, sides(9), rings(5), translation(vec3(0, 7.4, 0))*scaling(vec3(4.6, 0.9, 4.6)))
    add_sphere(pine,vec3(0,0,0), 1.0, mid, sides(9), rings(5), translation(vec3(0, 8.1, 0))*scaling(vec3(4.8, 1.5, 4.8)))
    add_sphere(pine,vec3(0,0,0), 1.0, light, sides(8), rings(4), translation(vec3(1.7, 8.7, 0.9))*scaling(vec3(2.6, 1.2, 2.6)))
    add_sphere(pine,vec3(0,0,0), 1.0, mid, sides(8), rings(4), translation(vec3(-1.5, 8.6, -1.2))*scaling(vec3(2.4, 1.1, 2.4)))
    add_sphere(pine,vec3(0,0,0), 1.0, light, sides(7), rings(4), translation(vec3(-0.6, 9.0, 1.5))*scaling(vec3(1.8, 0.9, 1.8)))
    # a cypress: a dark flame, its trunk hidden low inside it
    cyp: Vertex3D[]
    add_cylinder(cyp, vec3(0, -1, 0), 0.32, 2.0, trunk, 5, 0.28)
    add_sphere(cyp,vec3(0,0,0), 1.0, vec4(0.06, 0.17, 0.09, 1), sides(8), rings(7), translation(vec3(0, 5.6, 0))*scaling(vec3(1.5, 6.0, 1.5)))
    add_sphere(cyp,vec3(0,0,0), 1.0, vec4(0.09, 0.21, 0.11, 1), sides(7), rings(6), translation(vec3(0.2, 7.8, 0.1))*scaling(vec3(1.1, 4.2, 1.1)))
    add_cylinder(cyp, vec3(0, 10.0, 0), 0.7, 3.2, vec4(0.08, 0.19, 0.1, 1), 7, 0.0)
    # a bush of the maquis: clumps on the ground
    bush: Vertex3D[]
    add_sphere(bush,vec3(0,0,0), 1.0, vec4(0.2, 0.32, 0.13, 1), sides(7), rings(4), translation(vec3(0, 0.5, 0))*scaling(vec3(2.4, 1.4, 2.2)))
    add_sphere(bush,vec3(0,0,0), 1.0, vec4(0.28, 0.39, 0.16, 1), sides(6), rings(3), translation(vec3(1.4, 0.35, 0.6))*scaling(vec3(1.5, 1.1, 1.5)))
    add_sphere(bush,vec3(0,0,0), 1.0, vec4(0.24, 0.36, 0.15, 1), sides(6), rings(3), translation(vec3(-1.0, 0.3, -0.7))*scaling(vec3(1.3, 0.9, 1.3)))
    [custom_mesh(pine), custom_mesh(cyp), custom_mesh(bush),custom_mesh(plant_vertices(OLIVE)),custom_mesh(plant_vertices(OLEANDER)),custom_mesh(plant_vertices(PRICKLY_PEAR))]

struct Grove:
    center: vec2
    reach: f64                      # beyond this distance from the camera (plus reach) it is not drawn
    kinds: InstanceBuffer[Instance3D][]
    bounds: vec4 = vec4(0,0,0,0) # center xyz and conservative sphere radius

# Shared ecology decisions. The legacy path keeps the exact global RNG draw
# order; streamed world tiles pass their own deterministic generator.
grove_chance = (r: mut Rng, legacy: bool) -> f64: if legacy: random() else: r.next_float()

grove_kind = (sl: f64,dens: f64,dh: f64,r: mut Rng,legacy: bool) -> int:
    if dh < 45.0 and grove_chance(r,legacy) < 0.3: return int(Tree.cypress)
    if sl < 0.45 and dens > 0.52 and grove_chance(r,legacy) < (dens-0.45)*2.2: return int(Tree.pine)
    if dens > 0.4 and grove_chance(r,legacy) < 0.35: return int(Tree.bush)
    -1

# trees over an island: groves where the noise says, cypresses near houses, bushes on rough ground
build_grove = (island: int, towns: Town[]) -> Grove[]:
    isl = ISLANDS[island]
    ext = isl.radius * 1.2 * f64(max(isl.stretch.x, isl.stretch.y))
    step = 26.0
    lists: Instance3D[][] = [[], [], []]
    n = int(ext * 2.0 / step)
    seed_random(int(isl.seed * 1000.0))
    unused_rng = rng(0)
    near_houses: vec3[]
    loop t in towns:
        loop hp in t.houses:
            if length(vec2(hp.x, hp.z) - isl.center) < f32(ext * 1.5): near_houses.push(hp)
    loop j in 0..n:
        loop i in 0..n:
            x = f64(isl.center.x) - ext + (f64(i) + random()) * step
            z = f64(isl.center.y) - ext + (f64(j) + random()) * step
            h = surface_height(x, z)
            if h < 4.0: continue
            sl = slope_at(x, z)
            if sl > 0.7: continue
            # how near a house (cypresses there; nothing right on top)
            dh = 1e9
            loop hp in near_houses: dh = min(dh, f64(length(vec2(hp.x, hp.z) - vec2(f32(x), f32(z)))))
            if dh < 9.0: continue
            dens = fbm(x * 0.006 + isl.seed * 3.0, z * 0.006, 3)
            kind = grove_kind(sl,dens,dh,unused_rng,true)
            if kind < 0: continue
            s = random(0.75, 1.3)
            shade = f32(random(0.85, 1.12))
            m = translation(vec3(f32(x), f32(h), f32(z))) * rotation_y(random(0.0, TAU)) * scaling(s)
            lists[kind].push(Instance3D(m, vec4(shade, shade * f32(random(0.95, 1.05)), shade, 1)))
            # pines grow in clumps: a neighbour or two
            if kind == int(Tree.pine) and random() < 0.6:
                ox = x + random(-9.0, 9.0)
                oz = z + random(-9.0, 9.0)
                oh = surface_height(ox, oz)
                if oh > 4.0:
                    m2 = translation(vec3(f32(ox), f32(oh), f32(oz))) * rotation_y(random(0.0, TAU)) * scaling(random(0.7, 1.15))
                    lists[kind].push(Instance3D(m2, vec4(shade, shade, shade, 1)))
    lists = nature_grove(lists,near_houses)
    lists = thin_grove(lists)
    # Keep generated trees and their order. Small resident cells let the CPU
    # reject off-screen trees before running their wind shader/geometry.
    cells: {int:Instance3D[][]} = {}
    loop kind in 0..lists.len():
        loop tree in lists[kind]:
            at = tree.model[3].xyz
            key = (int(floor(f64(at.x)/256.0))+2048)*4096+int(floor(f64(at.z)/256.0))+2048
            empty: Instance3D[][] = [loop k in 0..PLANT_KINDS: []]
            bucket = cells.get(key,empty)
            bucket[kind].push(tree)
            cells[key] = bucket
    result: Grove[]
    keys = cells.keys(); keys.sort()
    loop key in keys:
        bucket = cells[key]
        lo = vec3(1e9,1e9,1e9); hi = vec3(-1e9,-1e9,-1e9)
        loop kind in bucket:
            loop tree in kind:
                at = tree.model[3].xyz
                lo = min(lo,at-vec3(20,5,20)); hi = max(hi,at+vec3(20,100,20))
        center = (lo+hi)*0.5
        result.push(Grove(isl.center,ext,[loop kind in bucket: instance_buffer(kind)],vec4(center,f32(length(hi-lo)*0.5))))
    result

# Retarget existing candidates, never add trees or consume global random draws.
# Olives follow small constant-height terrace rows; the authoritative surface
# remains unchanged and their roots are resampled after each bounded move.
nature_grove = (source: Instance3D[][],houses: vec3[] = []) -> Instance3D[][]:
    lists: Instance3D[][] = [loop k in 0..PLANT_KINDS: []]
    occupied: {int:bool} = {}
    loop old in 0..source.len():
        loop original in source[old]:
            tree = original
            p = tree.model[3].xyz
            h = f32(place_ground(p.xz))
            kind = old
            if old != int(Tree.cypress) and h < 500.0:
                gx = f32((place_ground(p.xz+vec2(3,0))-place_ground(p.xz-vec2(3,0)))/6.0)
                gz = f32((place_ground(p.xz+vec2(0,3))-place_ground(p.xz-vec2(0,3)))/6.0)
                slope = length(vec2(gx,gz))
                if orchard_cover(p.xz,h,slope) > 0.35:
                    kind = OLIVE
                    target = floor(h/4.5+0.5)*4.5
                    shift = vec2(gx,gz)*((target-h)/max(slope*slope,0.01))
                    shift *= min(1.0,8.0/max(length(shift),0.001))
                    q = p.xz+shift
                    if slope < 0.08: q = floor(q/18.0+vec2(0.5,0.5))*18.0
                    safe = not settlement_urban(q) and not settlement_on_road(q)
                    loop house in houses:
                        if length(q-house.xz) < 9.0: safe = false
                    if safe and place_ground(q) > 4.0:
                        key = (int(floor(f64(q.x)/7.0))+65536)*131072+int(floor(f64(q.y)/7.0))+65536
                        if key in occupied: continue
                        occupied[key] = true
                        tree.model[3] = vec4(q.x,f32(place_ground(q)),q.y,1)
                else if old == int(Tree.bush):
                    near_road = false
                    loop d in [vec2(14,0),vec2(-14,0),vec2(0,14),vec2(0,-14)]:
                        if settlement_on_road(p.xz+d): near_road = true
                    loop house in houses:
                        if length(p.xz-house.xz) < 35.0: near_road = true
                    if near_road: kind = if hash21(p.xz) > 0.42: OLEANDER else: PRICKLY_PEAR
            lists[kind].push(tree)
    lists

thin_grove = (lists: Instance3D[][]) -> Instance3D[][]:
    result: Instance3D[][] = [loop k in 0..PLANT_KINDS: []]
    index = 0
    loop kind in 0..lists.len():
        loop tree in lists[kind]:
            if index%render_quality.tree_stride == 0: result[kind].push(tree)
            index += 1
    result

draw_groves = (meshes: Mesh[], groves: Grove[], L: Light, t: f64):
    zone("groves")
    cam = scene_camera()
    p = obj_params(L, t, sway = 1.0)
    planes = land_planes(scene_view_proj())
    loop g in groves:
        if f64(length(cam.xz - g.center)) > g.reach + render_quality.tree_distance: continue
        if g.bounds.w > 0:
            visible = true
            loop plane in planes:
                if dot(plane.xyz,g.bounds.xyz)+plane.w < -g.bounds.w: visible = false; break
            if not visible: continue
        # Beyond 900 m a crown spans only a few pixels. Keep every tree and
        # every crown lobe, but use the low-tier rings for distant cells.
        distant = g.bounds.w > 0 and length(cam-g.bounds.xyz)-g.bounds.w > 900.0 and grove_far_meshes.len() == meshes.len()
        still = g.bounds.w > 0 and length(cam-g.bounds.xyz)-g.bounds.w > 420.0
        loop k in 0..g.kinds.len():
            if g.kinds[k].count > 0: draw_instanced(if still: obj_far_sh else: obj_inst_sh,if distant: grove_far_meshes[k] else: meshes[k],g.kinds[k],p)
    zone_end()

draw_towns = (towns: Town[], L: Light, t: f64):
    p = obj_params(L, t)
    loop tw in towns:
        distance = length(scene_camera()-tw.center)
        if distance > 14000.0: continue
        draw(obj_sh,if distance > 1800.0 and tw.far_mesh.count > 0: tw.far_mesh else: tw.mesh,p)

# (the GPU programs: made once the window is open)
init_objects = ():
    global obj_sh, obj_inst_sh, obj_far_sh
    obj_sh = make_shader(shader(obj_vs, obj_fs))
    obj_inst_sh = make_shader(shader(obj_vs_inst, obj_fs))
    obj_far_sh = make_shader(shader(obj_far_vs,obj_far_fs))

# ---------------- walking ----------------

# the height one stands at, on the ground or on a quay
walk_height = (towns: Town[], x: f64, z: f64) -> f64:
    # Main-thread walking shares the exact canonical source memo used by towns.
    h = if geography_enabled and (abs(x)>=LEGACY_RESERVE or abs(z)>=LEGACY_RESERVE):world_source_surface(x,z) else:surface_height(x,z)
    p = vec2(f32(x), f32(z))
    loop tw in towns:
        if length(vec2(tw.center.x, tw.center.z) - p) > 400.0: continue
        loop q in tw.quays:
            d = q.b - q.a
            l = length(d)
            u = dot(p - q.a, d) / (l * l)
            if u < 0.0 or u > 1.0: continue
            off = abs(dot(p - q.a, vec2(-d.y, d.x) / l))
            if off <= q.width * 0.5: h = max(h, QUAY_TOP)
    port_quay_height_at(x,z,h)

# a step from p toward p + move, kept out of houses and out of the sea (deeper than the ankles)
walk_step = (towns: Town[], p: vec3, move: vec2) -> vec3:
    np = vec2(p.x, p.z) + move
    loop tw in towns:
        if length(vec2(tw.center.x, tw.center.z) - np) > 400.0: continue
        loop b in tw.blocks:
            d = np - vec2(b.x, b.y)
            l = length(d)
            if l < b.z + 0.35 and l > 0.001: np = vec2(b.x, b.y) + d / l * (b.z + 0.35)
    np = settlement_avoid_buildings(np)
    h = walk_height(towns, f64(np.x), f64(np.y))
    if h < -0.3: return p
    if h - f64(p.y) > 0.8: return p                # a wall or a quay's edge from below
    vec3(np.x, f32(h), np.y)

# fishing boats out at their work off each harbor, in water deep enough, sails set: each its own
# mesh, so each rides the swell where it is
build_fishing_fleet = (towns: Town[], seed: int) -> Boat[]:
    seed_random(seed)
    boats: Boat[]
    loop tw in towns:
        n = if tw.houses.len() > 20: 6 else: (if tw.houses.len() > 4: 4 else: 1)
        k = 0
        tries = 0
        loop k < n and tries < 60:
            tries += 1
            a = random(-1.2, 1.2)
            d = random(300.0, 1800.0)
            o = vec2(tw.out.x * f32(cos(a)) - tw.out.y * f32(sin(a)), tw.out.x * f32(sin(a)) + tw.out.y * f32(cos(a)))
            p = vec2(tw.center.x, tw.center.z) + o * f32(d)
            if surface_height(f64(p.x), f64(p.y)) > -5.0: continue
            m = rotation_y(random(0.0, TAU))
            vs: Vertex3D[]
            head = add_boat(vs, m, int(random() * 1000.0), true, random(0.35, 1.1))
            boats.push(Boat(custom_mesh(vs), vec3(p.x, 0, p.y), transform_point(m, head)))
            k += 1
    boats

# Public geometry helpers for streamed settlements; keep boat internals private.
object_toward = (d: vec3) -> mat4: _toward(d)
add_outward_triangle = (vs: mut Vertex3D[],a: vec3,b: vec3,c: vec3,col: vec4,inside: vec3):
    _tri_out(vs,a,b,c,col,inside)
add_beached_hull = (vs: mut Vertex3D[],m: mat4):
    _hull(vs,m,7.0,2.4,rgb(0.28,0.48,0.6),WALLS[0],ROOFS[0],rgb(0.55,0.42,0.28))

add_house_proxy = (vs: mut Vertex3D[],m: mat4,w: f64,d: f64,h: f64,seed: int):
    add_box(vs,vec3(0,f32(h*0.5-1.0),0),vec3(f32(w),f32(h+2.0),f32(d)),WALLS[seed%WALLS.len()],m)
    if (seed/11)%4 != 0: add_gable(vs,vec3(0,f32(h),0),w,d,min(w,d)*0.22,ROOFS[(seed/7)%ROOFS.len()],m)
    add_box(vs,vec3(0,f32(h*0.55),f32(d*0.5+0.05)),vec3(f32(w*0.35),1.5,0.08),rgba(0.15,0.17,0.22,0.5),m)

# An articulated/dynamic model composed entirely inside the current chart.
obj_local_params = (L: Light,t: f64,model: mat4) -> ObjParams:
    p=obj_params(L,t)
    p.model=model
    p

# Keep the fractional step through legacy collision broad-phase rounding. Only
# a real collision replaces that candidate; ground is queried at precise x/z.
walk_step_precise = (towns: Town[],p: WorldPoint,move: vec2) -> WorldPoint:
    x=p.x+f64(move.x);z=p.z+f64(move.y)
    candidate=vec2(f32(x),f32(z));np=candidate
    loop tw in towns:
        if length(tw.center.xz-np)>400:continue
        loop b in tw.blocks:
            d=np-vec2(b.x,b.y);l=length(d)
            if l<b.z+0.35 and l>0.001:np=vec2(b.x,b.y)+d/l*(b.z+0.35)
    np=settlement_avoid_buildings(np)
    if np.x!=candidate.x:x=f64(np.x)
    if np.y!=candidate.y:z=f64(np.y)
    h=walk_height(towns,x,z)
    if h < -0.3 or h-p.y > 0.8:return p
    WorldPoint(x,h,z)
