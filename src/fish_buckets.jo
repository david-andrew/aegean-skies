# The world's buckets, where they are kept: the player's own in his locker at his home port, and
# in each harbour town a few that belong to people who'd lend one (two fishermen, each by a boat
# moored at the quay; the chandler or the store, and the harbour office, by the counter). Put in
# place once, at the start of a game, and saved from then on (src/fishing.jo FishHold).
use 'living_types.jo'
use 'objects.jo'
use 'fishing.jo'
use 'fish_stall.jo'

# A spot on a quay's deck just in from its edge, nearest `near`: clear of the bollards and of
# the fish stall (a short way along the quay if need be).
_bucket_quay_spot = (towns: Town[], place: int, near: vec3) -> vec3:
    tw = towns[place]
    stall = fish_stall_place(towns, place)
    best = vec3(near.x, f32(walk_height(towns, f64(near.x), f64(near.z))), near.z); bd = 1e30
    loop q in tw.quays:
        line = q.b - q.a; ql = f64(length(line))
        if ql < 2.0: continue
        u = clamp(f64(dot(near.xz - q.a, line)) / (ql * ql), 0.0, 1.0)
        nrm = vec2(-line.y, line.x) / f32(ql)
        side = if f64(dot(near.xz - q.a, nrm)) >= 0.0: 1.0 else: -1.0
        loop step in [0.0, 1.0, -1.0, 2.0, -2.0, 3.0, -3.0]:
            v = clamp(u + step / ql, 0.02, 0.98)
            p = q.a + line * f32(v) + nrm * f32(side * (f64(q.width) * 0.5 - 0.9))
            clear = true
            # (the bollards stand every 12 m from a metre in, at the edges)
            along = v * ql - 1.0
            if abs(along - 12.0 * floor(along / 12.0 + 0.5)) < 0.8: clear = false
            if stall.found and f64(length(p - stall.at.xz)) < 2.6: clear = false
            if not clear: continue
            d = f64(length(p - near.xz))
            if d < bd:
                bd = d; best = vec3(p.x, f32(walk_height(towns, f64(p.x), f64(p.y))), p.y)
            break
    best

_seed_one = (h: mut FishHold, owner: int, place: int, at: vec3, yaw: f64):
    _ = fish_new_bucket(h, owner, place, BUCKET_HOME, at, yaw, at, yaw)

# Put every bucket where it is kept (once per game).
fish_seed_buckets = (h: mut FishHold, w: World, towns: Town[]):
    if h.seeded: return
    h.seeded = true
    # the player's own, in his locker at home
    home = w.people[w.player].home
    if home >= 0 and home < towns.len():
        locker = fish_locker_place(towns, home)
        if locker.found:
            _ = fish_new_bucket(h, w.player, home, BUCKET_LOCKER, fish_locker_shelf(locker), locker.yaw, fish_locker_shelf(locker), locker.yaw)
    loop place in 0..min(towns.len(), w.places.len()):
        tw = towns[place]
        if tw.quays.len() == 0: continue
        # two fishermen of the town, each with a bucket by a boat at the quay
        fishers = [loop p in w.people: if p.occupation == .fisher and p.home == place: p.id]
        loop k in 0..min(2, fishers.len()):
            near = if tw.boats.len() > 0: tw.boats[k % tw.boats.len()].at else: tw.center
            spot = _bucket_quay_spot(towns, place, near)
            _seed_one(h, fishers[k], place, spot, atan2(f64(tw.out.x), f64(tw.out.y)))
        # the chandler's (or the store's) and the harbour office's, beside the counter
        loop _, shop in w.maps.shops:
            if shop.place != place or shop.person < 0: continue
            if shop.kind != "chandler" and shop.kind != "general store" and shop.kind != "harbour office": continue
            side = vec3(-tw.out.y, 0, tw.out.x)
            at = shop.pos + side * 1.2
            _seed_one(h, shop.person, place, vec3(at.x, f32(walk_height(towns, f64(at.x), f64(at.z))), at.z), atan2(f64(tw.out.x), f64(tw.out.y)))

# Where a person keeps the bucket they'd lend, in their words.
fish_bucket_where_words = (w: World, owner: int) -> str:
    loop _, shop in w.maps.shops:
        if shop.person == owner:
            return if shop.kind == "harbour office": "by the office door" else: "by the counter"
    if owner >= 0 and owner < w.people.len() and w.people[owner].occupation == .fisher: "on the quay by my boat" else: "by my door"

# The shop where one buys a bucket, if this person keeps one (its key), else "".
fish_bucket_seller = (w: World, person: int) -> str:
    loop key, shop in w.maps.shops:
        if shop.person == person and (shop.kind == "chandler" or shop.kind == "general store"): return key
    ""
