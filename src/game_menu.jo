# The pause menu's Game page, as words: each saved-game slot's header turned into the lines the
# page shows. Reads only the cached slot headers (no World decoding), so it is cheap every frame.
use 'living_types.jo'
use 'calendar.jo'
use 'game_slots.jo'
use 'debugmenu.jo'

_GAME_MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
_GAME_WEEKDAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

# "Wednesday 5 June 1929, 14:20" (the world's local clock)
game_when = (minute: int) -> str:
    date = calendar_date(day_index(minute))
    m = local_minute(minute)
    "{_GAME_WEEKDAYS[date.weekday]} {date.day} {_GAME_MONTHS[date.month-1]} {date.year}, {m/60:02}:{m%60:02}"

# "4 lire", "9.50 lire"
game_lire = (cents: int) -> str:
    if cents % 100 == 0: "{cents/100} lire" else: "{cents/100}.{cents%100:02} lire"

game_row = (view: GameSlotView, active_slot: int) -> GameRow:
    row = GameRow(slot=view.slot, exists=view.exists, usable=view.exists and view.compatible, autosave=view.slot == active_slot)
    if not view.exists:
        row.problem = if view.error != "" and view.error != "Opening saved games.": view.error else: ""
        return row
    s = view.summary
    if s.minute >= 0:
        row.time = game_when(s.minute)
        parts: str[]
        if s.craft != "": parts.push(s.craft)
        if s.cents >= 0: parts.push(game_lire(s.cents))
        parts.push("day {day_index(s.minute)+1}")
        row.detail = parts.join(", ")
    named = s.place_name != "" and s.place >= 0
    row.place = if s.mode == "aboard": (if named: "Aboard at {s.place_name}" else: "Aboard, away from a town") else: (if named: s.place_name else: "Away from a town")
    if not view.compatible: row.problem = "Made by another version; it can't be loaded."
    row

game_rows = (views: GameSlotView[], active_slot: int) -> GameRow[]: [loop v in views: game_row(v, active_slot)]

