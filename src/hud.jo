use 'touch.jo'
use 'flight_instruments.jo'
# The cockpit's instruments and the screen's words: round dials with brass rims (airspeed,
# altitude, engine), a compass strip along the top, and small cards for prompts and notices.

struct Fonts:
    ui: Font
    title: Font

INK = rgba(0.12, 0.1, 0.08, 1)
CREAM = rgba(0.96, 0.93, 0.84, 1)
BRASS = rgba(0.78, 0.62, 0.32, 1)
BRASS_DARK = rgba(0.45, 0.33, 0.16, 1)

# a round dial: value over [lo, hi] along 300 degrees, ticks every `step`, numbers every `label`
dial = (fonts: Fonts, c: vec2, r: f64, value: f64, lo: f64, hi: f64, step: f64, label: f64, name: str, red: f64 = -1.0, scale: f64 = 1.0):
    circle(c + vec2(2, 3), r + 7, rgba(0, 0, 0, 0.3))
    circle(c, r + 7, BRASS_DARK)
    circle(c, r + 5, BRASS)
    circle(c, r, CREAM)
    a0 = PI * 0.75                   # (the start: lower left; clockwise to lower right)
    span = PI * 1.5
    at = (v: f64) -> f64: a0 + span * clamp((v - lo) / (hi - lo), 0.0, 1.0)
    if red > 0.0: arc(c, r - 6, 6, at(red), at(hi), rgba(0.75, 0.2, 0.15, 0.85))
    v = lo
    loop v <= hi + 0.001:
        a = at(v)
        d = vec2(f32(cos(a)), f32(sin(a)))
        major = abs(v / label - round(v / label)) < 0.001
        line(c + d * f32(r - (if major: 11.0 else: 6.0)), c + d * f32(r - 1.0), if major: 2.0 else: 1.2, INK)
        if major:
            set_font(fonts.ui)
            text_centered("{int(v / scale)}", c + d * f32(r - 22.0), r * 0.17, INK)
        v += step
    set_font(fonts.ui)
    text_centered(name, c + vec2(0, f32(r * 0.42)), r * 0.15, rgba(0.3, 0.25, 0.2, 1))
    a = at(value)
    d = vec2(f32(cos(a)), f32(sin(a)))
    side = vec2(-d.y, d.x)
    triangle(c + d * f32(r - 8.0), c + side * 3.5, c - side * 3.5, rgba(0.15, 0.12, 0.1, 1))
    triangle(c - d * f32(r * 0.18), c + side * 3.5, c - side * 3.5, rgba(0.15, 0.12, 0.1, 1))
    circle(c, 5, BRASS)
    set_font()

# the compass: a strip of headings across the top, the one flown under the middle
compass = (fonts: Fonts, cx: f64, y: f64, w: f64, heading: f64):
    rect_rounded(cx - w * 0.5 - 6, y - 4, w + 12, 40, 6, rgba(0.08, 0.08, 0.1, 0.45))
    deg = heading * 180.0 / PI
    names = {0: "N", 45: "NE", 90: "E", 135: "SE", 180: "S", 225: "SW", 270: "W", 315: "NW"}
    set_font(fonts.ui)
    k = int(floor((deg - 60.0) / 5.0)) * 5
    loop k <= int(deg + 60.0):
        x = cx + (f64(k) - deg) / 60.0 * w * 0.5
        a = 1.0 - abs(x - cx) / (w * 0.5)
        hd = ((k % 360) + 360) % 360
        if hd % 45 == 0:
            text_centered(names[hd], vec2(f32(x), f32(y + 22)), 18, rgba(1, 0.97, 0.9, f32(a)))
            line(vec2(f32(x), f32(y)), vec2(f32(x), f32(y + 9)), 2, rgba(1, 0.97, 0.9, f32(a)))
        else if hd % 15 == 0:
            line(vec2(f32(x), f32(y)), vec2(f32(x), f32(y + 7)), 1.5, rgba(1, 0.97, 0.9, f32(a * 0.8)))
        else:
            line(vec2(f32(x), f32(y)), vec2(f32(x), f32(y + 4)), 1, rgba(1, 0.97, 0.9, f32(a * 0.5)))
        k += 5
    triangle(vec2(f32(cx), f32(y + 38)), vec2(f32(cx - 7), f32(y + 46)), vec2(f32(cx + 7), f32(y + 46)), rgba(0.9, 0.3, 0.2, 1))
    set_font()

# a pocket compass held flat beside the map: its card swings so its N points to the north
# whichever way one faces (the top of the case is straight ahead)
pocket_compass = (fonts: Fonts, c: vec2, r: f64, heading: f64):
    circle(c + vec2(3, 4), r, rgba(0, 0, 0, 0.3))
    circle(c, r, BRASS_DARK)
    circle(c, r * 0.93, BRASS)
    circle(c, r * 0.84, rgba(0.95, 0.92, 0.82, 1))
    # (the bow: the case's ring at the top)
    ring(c + vec2(0, f32(-r * 1.05)), r * 0.14, 3, BRASS_DARK)
    set_font(fonts.ui)
    a = -heading                     # (north on the card, turned against one's heading)
    names = ["N", "E", "S", "W"]
    loop k in 0..4:
        ang = a + f64(k) * PI * 0.5
        d = vec2(f32(sin(ang)), f32(-cos(ang)))
        text_centered(names[k], c + d * f32(r * 0.62) - vec2(0, 8), if k == 0: 17 else: 14, if k == 0: rgba(0.6, 0.12, 0.08, 1) else: INK)
    loop k in 0..16:
        ang = a + f64(k) * PI / 8.0
        d = vec2(f32(sin(ang)), f32(-cos(ang)))
        line(c + d * f32(r * 0.76), c + d * f32(r * (if k % 4 == 0: 0.84 else: 0.81)), 1.2, INK)
    # (the needle: red to the north)
    d = vec2(f32(sin(a)), f32(-cos(a)))
    s2 = vec2(-d.y, d.x)
    triangle(c + d * f32(r * 0.5), c + s2 * 4.0, c - s2 * 4.0, rgb(0.75, 0.15, 0.1))
    triangle(c - d * f32(r * 0.5), c + s2 * 4.0, c - s2 * 4.0, rgba(0.2, 0.2, 0.22, 1))
    circle(c, 3, BRASS_DARK)
    # (the lubber mark: straight ahead)
    triangle(c + vec2(0, f32(-r * 0.86)), c + vec2(-5, f32(-r * 0.76)), c + vec2(5, f32(-r * 0.76)), rgba(0.15, 0.12, 0.1, 0.8))
    set_font()

# a narrow upright gauge: throttle, fuel
bar_gauge = (fonts: Fonts, x: f64, y: f64, h: f64, v: f64, name: str, col: vec4):
    rect_rounded(x - 3, y - 3, 22, h + 6, 4, BRASS_DARK)
    rect(x, y, 16, h, rgba(0.12, 0.12, 0.13, 1))
    fill = h * clamp(v, 0.0, 1.0)
    rect(x + 2, y + h - fill, 12, fill, col)
    set_font(fonts.ui)
    text_centered(name, vec2(f32(x + 8), f32(y + h + 14)), 13, rgba(1, 0.97, 0.9, 0.9), shadow = rgba(0, 0, 0, 0.5))
    set_font()

# the instruments together, in the lower left (speed in km/h, altitude in meters)
instruments = (fonts: Fonts, speed_ms: f64, alt_m: f64, rpm01: f64, throttle: f64, fuel01: f64, heading: f64, stall_ms: f64, max_ms: f64, attitude: FlightInstruments = FlightInstruments()):
    sh = f64(screen_height())
    sw = f64(screen_width())
    dial(fonts, vec2(92, f32(sh - 92)), 66, speed_ms * 3.6, 0.0, max(400.0, ceil(max_ms * 3.6 / 50.0) * 50.0), 10.0, 50.0, "km/h", -1.0)
    # the stall speed, marked in red at the low end
    a = PI * 0.75 + PI * 1.5 * clamp(stall_ms * 3.6 / max(400.0, ceil(max_ms * 3.6 / 50.0) * 50.0), 0.0, 1.0)
    arc(vec2(92, f32(sh - 92)), 60, 5, PI * 0.75, a, rgba(0.75, 0.2, 0.15, 0.7))
    dial(fonts, vec2(250, f32(sh - 92)), 66, alt_m, 0.0, 2000.0, 50.0, 250.0, "meters", -1.0)
    dial(fonts, vec2(380, f32(sh - 66)), 42, rpm01 * 2400.0, 0.0, 2800.0, 100.0, 500.0, "rpm", 2400.0, 100.0)
    bar_gauge(fonts, 450, sh - 140, 100, throttle, "throttle", rgba(0.85, 0.7, 0.35, 1))
    bar_gauge(fonts, 490, sh - 140, 100, fuel01, "fuel", if fuel01 < 0.15: rgba(0.85, 0.25, 0.2, 1) else: rgba(0.45, 0.7, 0.4, 1))
    gy=sh-(if sw>=800 and not pad.on:70.0 else:330.0)
    attitude_dial(fonts,vec2(sw-174,gy),48,attitude)
    turn_slip_dial(fonts,vec2(sw-64,gy),48,attitude)
    compass(fonts, sw * 0.5, 14, 420, heading)

# a line of words at the bottom of the screen, on a soft card
# (on a touch screen the keys mean nothing: "F  climb aboard your Gull" reads "Climb aboard your
# Gull", and the card itself is the button)
_touch_words = (s: str) -> str:
    t = s
    loop prefix in ["hold F  ", "F  ", "T  "]:
        if t.starts_with(prefix): t = t[prefix.len()..t.len()]
    t = t.replace("      Shift  open the throttle", "").replace("  R  to be towed home", "  Tap to be towed home")
    if t.len() > 0: t = t[0..1].upper() + t[1..t.len()]
    t

prompt_card = (fonts: Fonts, s: str, y_from_bottom: f64 = 90.0):
    shown = if pad.on: _touch_words(s) else: s
    set_font(fonts.ui)
    w = text_width(shown, 22)
    x = (f64(screen_width()) - w) * 0.5
    y = f64(screen_height()) - y_from_bottom
    rect_rounded(x - 18, y - 10, w + 36, 44, 8, rgba(0.08, 0.1, 0.14, 0.55))
    text(shown, vec2(f32(x), f32(y)), 22, rgba(1, 0.97, 0.9, 1))
    set_font()
    # (on a touch screen the card is the button: a finger on it does what it says)
    key: Key? = if s.starts_with("F ") or s.starts_with("hold F"): Key.f else if s.starts_with("T "): Key.t else if s.contains(" R "): Key.r else: none
    if let k = key: tap_card(Rect(x - 18, y - 10, w + 36, 44), k)

# the title, over the scene as the game starts: fades in, holds, fades out
title_card = (fonts: Fonts, age: f64):
    a = smoothstep(0.3, 1.8, age) * (1.0 - smoothstep(5.5, 7.5, age))
    if a <= 0.0: return
    cx = f64(screen_width()) * 0.5
    cy = f64(screen_height()) * 0.36
    set_font(fonts.title)
    # (as big as fits across the screen, on a phone held upright too)
    size = min(84.0, 84.0 * f64(screen_width()) * 0.88 / max(text_width("AEGEAN SKIES", 84), 1.0))
    text_centered("AEGEAN SKIES", vec2(f32(cx + 3), f32(cy + 4)), size, rgba(0.05, 0.08, 0.15, f32(a * 0.35)))
    text_centered("AEGEAN SKIES", vec2(f32(cx), f32(cy)), size, rgba(1, 0.97, 0.9, f32(a)))
    set_font()

# the keys, in a small card at the upper left
# every key and what it does, aboard and on foot (H): kept in one place, so it stays true
CONTROLS_AIR = [
    "Mouse  steer: the aircraft flies where the mouse points (click to capture it, Esc to let go)",
    "W S  pitch     A D  roll     Q E  rudder     (keys fly it directly)",
    "Shift / Z  throttle up / down (below idle: the air brake)",
    "Space or left click  fire the guns     G  guns safe / armed",
    "Right button  look around     V  cockpit view     Tab  next target     C  follow target",
    "T  jump out (a parachute)     X  wheels up / down (the Albatross)",
    "F  moor at a dock, step onto the quay     R  towed home, when wrecked or aground",
    "Space  water brake, on the water",
    ", .  tune the radio (and switch it on)     Shift , .  next station     /  radio on / off"]
CONTROLS_FOOT = [
    "W A S D  walk     Shift  run     Q E  turn the view     wheel  nearer / farther",
    "Click  look around with the mouse (Esc to let go)",
    "F  climb aboard, pick up / put down a crate, read the notices     hold F  haul in the line",
    "T  talk to someone near     1-9 or a click  choose what to say"]
CONTROLS_ANY = [
    "M  chart (Tab: the whole sea / the islands)     J  notebook",
    "P or F1  pause (the pause menu)     H  these keys     1 / 2  the hour back / forward"]
CONTROLS_TOUCH = [
    "Aboard: drag anywhere to look, and it flies where you look; the throttle slider on the left",
    "On foot: drag to look; hold Walk to walk, slide your thumb away to go faster, across to bear",
    "Tap a prompt card to do it; tap someone near to talk; two fingers pinch the view",
    "Pause menu, Options: tilt the phone to fine-tune the aim; invert up and down"]

controls_card = (fonts: Fonts, flying: bool):
    lines = (if pad.on: CONTROLS_TOUCH else: []) + (if flying: CONTROLS_AIR else: CONTROLS_FOOT) + CONTROLS_ANY
    set_font(fonts.ui)
    size = 16.0
    w = 0.0
    loop l in lines: w = max(w, text_width(l, size))
    sw = f64(screen_width())
    if w + 28.0 > sw - 20.0:
        size = size * (sw - 48.0) / w
        w = sw - 48.0
    rect_rounded(14, 14, w + 28, f64(lines.len()) * (size + 7.0) + 18.0, 8, rgba(0.08, 0.1, 0.14, 0.7))
    loop k in 0..lines.len(): text(lines[k], vec2(28, f32(24.0 + f64(k) * (size + 7.0))), size, rgba(1, 0.97, 0.9, 0.95))
    set_font()

# (a hint at the start: where the keys are)
keys_hint = (fonts: Fonts):
    if pad.on: return
    set_font(fonts.ui)
    s = "H  all the keys"
    w = text_width(s, 17)
    rect_rounded(14, 14, w + 28, 34, 8, rgba(0.08, 0.1, 0.14, 0.55))
    text(s, vec2(28, 22), 17, rgba(1, 0.97, 0.9, 0.95))
    set_font()

# Gyro attitude and the period needle-and-ball turn instrument share the brass dial family.
attitude_dial = (fonts: Fonts,c: vec2,r: f64,d: FlightInstruments):
    circle(c+vec2(2,3),r+7,rgba(0,0,0,0.3));circle(c,r+7,BRASS_DARK);circle(c,r+5,BRASS);circle(c,r,INK)
    loop sky in [false,true]:
        pts=horizon_half(d.pitch,d.bank,sky)
        color=if sky:rgb(0.29,0.51,0.65) else:rgb(0.43,0.28,0.16)
        loop j in 1..pts.len()-1:
            at=(p:vec2)->vec2:c+vec2(p.x,-p.y)*f32(r-2)
            triangle(at(pts[0]),at(pts[j]),at(pts[j+1]),color)
    loop degrees in [-20,-10,0,10,20]:
        y=(f64(degrees)*PI/180.0-d.pitch)*1.5
        if abs(y)>0.94:continue
        width=min(if degrees==0:0.92 else:0.24,sqrt(1.0-y*y)*0.95)
        point=(x:f64)->vec2:c+vec2((x*cos(d.bank)-y*sin(d.bank))*r,-(x*sin(d.bank)+y*cos(d.bank))*r)
        line(point(-width),point(width),1,CREAM)
    loop side in [-1.0,1.0]:
        line(c+vec2(side*r*0.17,0),c+vec2(side*r*0.64,0),3,CREAM)
        line(c+vec2(side*r*0.17,0),c+vec2(side*r*0.17,r*0.12),2,CREAM)
    circle(c,3,BRASS)
    loop degrees in [-60,-30,0,30,60]:
        a=f64(degrees)*PI/180.0
        line(c+vec2(sin(a)*r*0.83,-cos(a)*r*0.83),c+vec2(sin(a)*r*0.95,-cos(a)*r*0.95),2,CREAM)
    set_font(fonts.ui);text_centered("attitude",c+vec2(0,r+16),12,CREAM);set_font()

turn_slip_dial = (fonts: Fonts,c: vec2,r: f64,d: FlightInstruments):
    circle(c+vec2(2,3),r+7,rgba(0,0,0,0.3));circle(c,r+7,BRASS_DARK);circle(c,r+5,BRASS);circle(c,r,CREAM)
    rate=clamp(d.turn/(PI/60.0),-2.0,2.0)
    pivot=c+vec2(0,r*0.1);a=rate*0.24
    line(pivot,pivot+vec2(sin(a),-cos(a))*f32(r*0.75),3,INK);circle(pivot,4,BRASS)
    loop side in [-1.0,1.0]:
        line(c+vec2(side*r*0.18,-r*0.66),c+vec2(side*r*0.18,-r*0.81),2,INK)
    arc(c+vec2(0,-r*0.49),r*1.12,9,PI*0.31,PI*0.69,BRASS_DARK)
    ball=c+vec2(d.slip*r*0.48,r*(0.62-d.slip*d.slip*0.12))
    circle(ball,r*0.105,INK)
    loop side in [-1.0,1.0]:line(c+vec2(side*r*0.15,r*0.48),c+vec2(side*r*0.15,r*0.75),2,INK)
    set_font(fonts.ui);text_centered("2 MIN",c+vec2(0,-r*0.24),10,INK);text_centered("turn / slip",c+vec2(0,r+16),12,CREAM);set_font()
