# What the town's people wear: by their trade and their standing in the living world, in the
# clothes of the 1920s-30s Mediterranean (src/folk.jo's Outfit). Mostly pale and neutral, about one
# in five in a clear colour; hats are the crowd's texture (most men, about half the women).
# Fishermen in jerseys and caps, dockhands in shirtsleeves, shopkeepers in waistcoats and aprons,
# the well-to-do in light suits and boaters or good dresses and cloches, farmers and pressers in
# wide straw hats, the priest in a cassock, the patrol in tunics and kepis, flyers in leather and
# helmets; the hotel's staff and the band in theirs. Nothing here is drawn per frame: a person's
# figure is built once from what they wear.

use 'folk.jo'
use 'living_types.jo'

# (Who wears the woman's version of a trade is decided by the town's own record of its women,
# src/townsfolk.jo person_woman; walkers who aren't the world's people, by their seed.)

# ---- the palette (art direction: pale and neutral, a clear colour as an accent) ----
CREAM = vec4(0.76, 0.73, 0.65, 1)
STONE = vec4(0.6, 0.57, 0.51, 1)
GREYBROWN = vec4(0.42, 0.4, 0.36, 1)
NAVY = vec4(0.19, 0.22, 0.31, 1)
KHAKI = vec4(0.66, 0.58, 0.43, 1)
WHITE = vec4(0.9, 0.88, 0.82, 1)
LINEN = vec4(0.84, 0.81, 0.73, 1)
BLACK = vec4(0.15, 0.15, 0.15, 1)
WORK_BLUE = vec4(0.36, 0.42, 0.5, 1)
SHIRT_PALE = [vec4(0.88, 0.86, 0.8, 1), vec4(0.82, 0.8, 0.74, 1), vec4(0.78, 0.8, 0.82, 1)]
DRESS_PLAIN = [vec4(0.2, 0.22, 0.31, 1), vec4(0.6, 0.57, 0.51, 1), vec4(0.42, 0.4, 0.36, 1), vec4(0.76, 0.73, 0.65, 1), vec4(0.17, 0.17, 0.17, 1)]
DRESS_CLEAR = [vec4(0.6, 0.53, 0.68, 1), vec4(0.66, 0.74, 0.82, 1), vec4(0.86, 0.78, 0.5, 1), vec4(0.84, 0.68, 0.68, 1), vec4(0.56, 0.65, 0.5, 1)]
HAT_STRAW = vec4(0.84, 0.77, 0.56, 1)
HAT_FELT = [vec4(0.36, 0.33, 0.3, 1), vec4(0.5, 0.45, 0.38, 1), vec4(0.24, 0.24, 0.26, 1)]
HAT_CAP = [vec4(0.24, 0.25, 0.28, 1), vec4(0.4, 0.36, 0.3, 1), vec4(0.5, 0.48, 0.44, 1)]
HEADSCARF = [vec4(0.86, 0.84, 0.78, 1), vec4(0.2, 0.2, 0.22, 1), vec4(0.62, 0.5, 0.44, 1)]

_w = (xs: vec4[], k: int) -> vec4: xs[((k % xs.len()) + xs.len()) % xs.len()]
_r = (seed: int, k: int) -> int: ((seed * 7919 + k * 104729 + 13) / 7 % 1000 + 1000) % 1000

# A dress or a skirt, plain mostly and now and then in a clear colour.
_dress_colour = (seed: int) -> vec4: if _r(seed, 3) < 220: _w(DRESS_CLEAR, _r(seed, 4)) else: _w(DRESS_PLAIN, _r(seed, 5))

# A woman's hat or none: a cloche or a headscarf about half the time.
_her_hat = (o: mut Outfit, seed: int, scarf_likelier: bool):
    k = _r(seed, 6)
    if k < (if scarf_likelier: 450 else: 200): o.hat_kind = 5; o.hat = _w(HEADSCARF, _r(seed, 7))
    else if k < 520: o.hat_kind = 7; o.hat = _w(HAT_FELT, _r(seed, 8))

# What someone wears by day, from their trade, their purse (cents), age and seed; `skirt`: the
# trade's woman's version (a dress, or a blouse and skirt, a headscarf or a cloche). `country`:
# where they are from (0 the archipelago, 1 Kalyra, 2 Orenthia): Orenthia's people wear their own
# country's clothes (regional dress, below); the uniformed and the flyers dress alike everywhere.
outfit_for = (occupation: Occupation, seed: int, age: int, skirt: bool, cents: int, country: int = 0) -> Outfit:
    o = _outfit_common(occupation, seed, age, skirt, cents)
    if country == 2: return orenthian_outfit(o, occupation, seed, age, skirt, regional_dress)
    o

_outfit_common = (occupation: Occupation, seed: int, age: int, skirt: bool, cents: int) -> Outfit:
    well_off = cents >= 15000
    old = age >= 62
    # (the flying trades and the uniformed wear what the work wants, whoever they are)
    match occupation:
        .player, .courier, .racer:
            o = dress_outfit(.pilot, seed, age)
            return o
        .pirate:
            o = dress_outfit(.pilot, seed, age)
            o.top = _w([vec4(0.3, 0.26, 0.22, 1), vec4(0.26, 0.28, 0.24, 1)], _r(seed, 1)); o.scarf = vec4(0, 0, 0, 0)
            return o
        .patrol:
            return Outfit(.tunic, vec4(0.24, 0.32, 0.46, 1), legs = vec4(0.24, 0.32, 0.46, 1), hat_kind = 4, hat = vec4(0.2, 0.26, 0.38, 1), tie = BLACK, under = WHITE)
        .mechanic:
            return Outfit(.overalls, WORK_BLUE, under = _w(SHIRT_PALE, _r(seed, 1)), hat_kind = if _r(seed, 2) < 700: 1 else: 0, hat = _w(HAT_CAP, _r(seed, 3)), rolled = true)
        .priest:
            return Outfit(.cassock, BLACK, legs = BLACK, hat_kind = 9, hat = vec4(0.12, 0.12, 0.12, 1), long_skirt = true, stockings = BLACK, under = WHITE)
        .nurse:
            if skirt: return Outfit(.dress, WHITE, hat_kind = 5, hat = WHITE, apron = WHITE)
            return Outfit(.coat, WHITE, legs = STONE, under = WHITE)
        else: pass
    if skirt:
        if old: return Outfit(.dress, BLACK, hat_kind = 5, hat = _w([BLACK, WHITE], _r(seed, 1)), long_skirt = true, stockings = vec4(0.16, 0.16, 0.17, 1))
        match occupation:
            .innkeeper:
                return Outfit(.dress, _w([NAVY, GREYBROWN, vec4(0.42, 0.36, 0.42, 1)], _r(seed, 1)), apron = LINEN, long_apron = true)
            .hotelier:
                # (a drop-waist dress and a cloche)
                return Outfit(.dress, _w(DRESS_CLEAR, _r(seed, 1)), hat_kind = 7, hat = _w(HAT_FELT, _r(seed, 2)), sash = _w([NAVY, GREYBROWN, CREAM], _r(seed, 3)))
            .fisher:
                # (at the fish market: a headscarf, an apron, the sleeves rolled)
                return Outfit(.dress, _w(DRESS_PLAIN, _r(seed, 1)), apron = LINEN, rolled = true, hat_kind = 5, hat = _w(HEADSCARF, _r(seed, 7)))
            .oil_presser, .miller, .farmer:
                o = Outfit(.dress, _w(DRESS_PLAIN, _r(seed, 1)), apron = LINEN, rolled = true)
                _her_hat(o, seed, true)
                return o
            .merchant:
                if well_off:
                    # (well-to-do: a drop-waist dress, a cloche)
                    return Outfit(.dress, _dress_colour(seed), hat_kind = 7, hat = _w(HAT_FELT, _r(seed, 2)), sash = _w([NAVY, GREYBROWN, CREAM, BLACK], _r(seed, 3)))
                o = Outfit(.blouse, CREAM, under = _w(SHIRT_PALE, _r(seed, 1)), legs = _w([GREYBROWN, NAVY, STONE], _r(seed, 2)), apron = LINEN)
                _her_hat(o, seed, false)
                return o
            .clerk, .telegraphist, .teacher:
                o = Outfit(.blouse, CREAM, under = _w(SHIRT_PALE, _r(seed, 1)), legs = _w([NAVY, GREYBROWN, BLACK], _r(seed, 2)))
                if occupation == .teacher: o = Outfit(.dress, _dress_colour(seed))
                _her_hat(o, seed, false)
                return o
            else:
                o = Outfit(.dress, _dress_colour(seed))
                _her_hat(o, seed, false)
                return o
    # (men, and anyone in trousers)
    if well_off and (occupation == .merchant or occupation == .hotelier):
        # a light suit, a boater or a fedora with its band, two-tone shoes
        suit = _w([WHITE, CREAM, vec4(0.7, 0.68, 0.62, 1)], _r(seed, 1))
        boater = _r(seed, 2) < 600
        return Outfit(.coat, suit, legs = suit, hat_kind = if boater: 2 else: 6, hat = if boater: HAT_STRAW else: _w(HAT_FELT, _r(seed, 3)), band = _w([NAVY, vec4(0.45, 0.2, 0.18, 1), BLACK], _r(seed, 4)), tie = _w([vec4(0.45, 0.2, 0.18, 1), NAVY], _r(seed, 5)), shoes = _w([vec4(0.2, 0.15, 0.12, 1), vec4(0.85, 0.82, 0.76, 1)], _r(seed, 6)))
    if old:
        return Outfit(.coat, _w([GREYBROWN, BLACK, STONE], _r(seed, 1)), legs = _w([GREYBROWN, BLACK], _r(seed, 2)), hat_kind = if _r(seed, 3) < 500: 1 else: 6, hat = _w(HAT_FELT, _r(seed, 4)))
    match occupation:
        .fisher:
            o = dress_outfit(.fisher, seed, age)
            if _r(seed, 1) < 450: o.stripes = vec4(0, 0, 0, 0)
            if _r(seed, 2) < 200: o.hat_kind = 0
            return o
        .sailor:
            if _r(seed, 1) < 300: return Outfit(.whites, WHITE, legs = WHITE, hat_kind = 1, hat = NAVY, under = WHITE)
            return Outfit(.shirtsleeves, _w(SHIRT_PALE, _r(seed, 2)), under = _w(SHIRT_PALE, _r(seed, 2)), legs = _w([NAVY, GREYBROWN, KHAKI], _r(seed, 3)), hat_kind = if _r(seed, 4) < 750: 1 else: 0, hat = _w(HAT_CAP, _r(seed, 5)), rolled = true)
        .quartermaster:
            return Outfit(.coat, NAVY, legs = NAVY, hat_kind = 1, hat = NAVY)
        .oil_presser, .miller, .farmer:
            waist = _r(seed, 1) < 500
            return Outfit(if waist: Garb.waistcoat else: Garb.shirtsleeves, _w([STONE, GREYBROWN, KHAKI], _r(seed, 2)), under = _w(SHIRT_PALE, _r(seed, 3)), legs = _w([KHAKI, GREYBROWN, STONE], _r(seed, 4)), hat_kind = if _r(seed, 5) < 800: 8 else: 1, hat = HAT_STRAW, rolled = true)
        .merchant:
            # (a shopkeeper: waistcoat, shirtsleeves rolled, an apron; a cap or a boater)
            return Outfit(.waistcoat, _w([GREYBROWN, STONE, NAVY], _r(seed, 1)), under = _w(SHIRT_PALE, _r(seed, 2)), legs = _w([GREYBROWN, STONE], _r(seed, 3)), hat_kind = if _r(seed, 4) < 450: 1 else: (if _r(seed, 4) < 750: 2 else: 0), hat = if _r(seed, 4) < 450: _w(HAT_CAP, _r(seed, 5)) else: HAT_STRAW, band = NAVY, apron = LINEN, rolled = true)
        .innkeeper:
            return Outfit(.waistcoat, BLACK, under = WHITE, legs = GREYBROWN, apron = LINEN, long_apron = true, rolled = true)
        .clerk, .telegraphist, .teacher:
            boater = _r(seed, 1) < 450
            return Outfit(.coat, _w([GREYBROWN, NAVY, STONE, CREAM], _r(seed, 2)), legs = _w([GREYBROWN, NAVY, STONE], _r(seed, 3)), under = WHITE, tie = _w([vec4(0.45, 0.2, 0.18, 1), NAVY, BLACK], _r(seed, 4)), hat_kind = if boater: 2 else: (if _r(seed, 1) < 800: 6 else: 0), hat = if boater: HAT_STRAW else: _w(HAT_FELT, _r(seed, 5)), band = NAVY)
        else:
            return Outfit(.shirtsleeves, _w(SHIRT_PALE, _r(seed, 1)), under = _w(SHIRT_PALE, _r(seed, 1)), legs = _w([GREYBROWN, KHAKI, NAVY], _r(seed, 2)), hat_kind = if _r(seed, 3) < 650: 1 else: 0, hat = _w(HAT_CAP, _r(seed, 4)), rolled = true)

# The hotel band's players dressed for the evening (role: 0 the singer, 1 the pianist, 2 guitar or
# bass, 3 violin, mandolin or reeds).
evening_outfit = (role: int, seed: int, skirt: bool) -> Outfit:
    if skirt:
        # (an evening frock with a drop waist)
        return Outfit(.dress, _w([vec4(0.42, 0.22, 0.32, 1), vec4(0.17, 0.36, 0.38, 1), BLACK], role + _r(seed, 1)), sash = vec4(0.7, 0.62, 0.42, 1))
    match role:
        1: Outfit(.coat, BLACK, legs = BLACK, under = WHITE, tie = BLACK)
        2: Outfit(.waistcoat, BLACK, under = WHITE, legs = vec4(0.22, 0.22, 0.24, 1), tie = vec4(0.45, 0.2, 0.18, 1))
        _: Outfit(.coat, vec4(0.25, 0.25, 0.28, 1), legs = vec4(0.25, 0.25, 0.28, 1), under = WHITE, tie = NAVY)

# The hotel's staff.
waiter_outfit = () -> Outfit: Outfit(.whites, WHITE, legs = BLACK, under = WHITE, tie = BLACK, apron = WHITE, long_apron = true)
barkeep_outfit = () -> Outfit: Outfit(.waistcoat, BLACK, under = WHITE, legs = GREYBROWN, apron = LINEN, long_apron = true, rolled = true)
errand_boy_outfit = () -> Outfit: Outfit(.shirtsleeves, CREAM, under = CREAM, legs = GREYBROWN, hat_kind = 1, hat = _w(HAT_CAP, 1), rolled = true)

# Someone about the town who isn't one of the world's people (the background walkers): a mix of
# the trades, by their seed.
walker_outfit = (seed: int, age: int, country: int = 0) -> Outfit:
    trades = [Occupation.fisher, Occupation.merchant, Occupation.sailor, Occupation.clerk, Occupation.farmer, Occupation.fisher, Occupation.merchant]
    occ = trades[_r(seed, 11) % trades.len()]
    outfit_for(occ, seed, age, walker_woman(seed), if _r(seed, 12) < 150: 20000 else: 3000, country)

walker_woman = (seed: int) -> bool: ((seed / 3) % 2 + 2) % 2 == 1

# A child of the town, dressed as a child of the period (not in a trade): a boy in short trousers,
# a shirt and often a cap; a girl in a frock and a white pinafore, now and then a straw hat.
child_outfit = (girl: bool, seed: int) -> Outfit:
    if girl:
        o = Outfit(.dress, _w([vec4(0.66, 0.74, 0.82, 1), vec4(0.84, 0.7, 0.7, 1), vec4(0.86, 0.8, 0.56, 1), vec4(0.6, 0.66, 0.54, 1), CREAM, vec4(0.6, 0.53, 0.68, 1)], _r(seed, 1)), apron = WHITE, bib = true, stockings = vec4(0.82, 0.8, 0.76, 1))
        if _r(seed, 2) < 250: o.hat_kind = 8; o.hat = HAT_STRAW
        return o
    Outfit(.shirtsleeves, _w(SHIRT_PALE, _r(seed, 1)), under = _w(SHIRT_PALE, _r(seed, 1)), legs = _w([NAVY, GREYBROWN, STONE, KHAKI], _r(seed, 2)), shorts = true, rolled = true, hat_kind = if _r(seed, 3) < 600: 1 else: 0, hat = _w(HAT_CAP, _r(seed, 4)))

# ---- regional dress: Orenthia ----
# Orenthia is the eastern mainland: low white terraces with stair-head rooms, iron balconies, domed
# chapels with twin bells, olives, blue signs and globe lamps (docs/glossary "Regional character").
# Its people dress as the coast towns of the eastern Aegean and the Levant did in the 1920s-30s,
# built from the same garments as everyone else's. Three directions, put to the user; the first is
# the default and the others are a debug switch until the user chooses (AEGEAN_REGION_DRESS=sash,
# indigo or town; the World page's "Orenthian dress"):
#   0 sash      the coast town's own: a collarless shirt, a dark waistcoat and a broad cloth sash
#               wound round the waist over loose trousers, a brimless felt cap or a flat cap; the
#               women in long skirts with a long apron and a large white headscarf, the old in black
#   1 indigo    white and indigo, like the terraces and the signs: faded indigo cotton jackets and
#               trousers over white shirts, wide straw hats; the women in indigo or white with white
#               aprons and kerchiefs; a rust-red sash now and then
#   2 town      the port's best in a modernising country: dark three-piece suits, ties, felt hats and
#               flat caps; the women in long dark dresses, a cloche or a dark headscarf
REGIONAL_DRESS_NAMES = ["sash", "indigo", "town"]
_regional_dress_env = () -> int:
    v = env("AEGEAN_REGION_DRESS") ?? ""
    loop k in 0..REGIONAL_DRESS_NAMES.len():
        if v == REGIONAL_DRESS_NAMES[k] or v == "{k}": return k
    0
regional_dress = _regional_dress_env()
set_regional_dress = (k: int):
    global regional_dress
    regional_dress = ((k % 3) + 3) % 3

# the sash direction's palette: deep reds, madder browns, indigo, olive and a faded saffron
SASH_CLOTH = [vec4(0.52, 0.16, 0.14, 1), vec4(0.4, 0.22, 0.16, 1), vec4(0.22, 0.25, 0.4, 1), vec4(0.42, 0.42, 0.26, 1), vec4(0.72, 0.56, 0.26, 1)]
WAISTCOAT_DARK = [vec4(0.2, 0.17, 0.15, 1), vec4(0.17, 0.19, 0.27, 1), vec4(0.3, 0.17, 0.15, 1), vec4(0.24, 0.24, 0.2, 1)]
LOOSE_TROUSERS = [vec4(0.26, 0.24, 0.22, 1), vec4(0.34, 0.3, 0.25, 1), vec4(0.2, 0.21, 0.27, 1)]
LONG_SKIRT = [vec4(0.46, 0.2, 0.18, 1), vec4(0.22, 0.24, 0.36, 1), vec4(0.52, 0.42, 0.24, 1), vec4(0.36, 0.3, 0.34, 1), vec4(0.3, 0.34, 0.24, 1)]
INDIGO = [vec4(0.16, 0.22, 0.38, 1), vec4(0.24, 0.32, 0.48, 1), vec4(0.36, 0.44, 0.58, 1)]
RUST = vec4(0.6, 0.26, 0.16, 1)
TOWN_WOOL = [vec4(0.2, 0.2, 0.21, 1), vec4(0.3, 0.25, 0.2, 1), vec4(0.18, 0.21, 0.26, 1), vec4(0.24, 0.27, 0.22, 1)]
TOWN_FROCK = [vec4(0.2, 0.2, 0.22, 1), vec4(0.32, 0.22, 0.28, 1), vec4(0.18, 0.26, 0.24, 1), vec4(0.3, 0.26, 0.22, 1)]
const BRIMLESS_CAP = 10

# An Orenthian's day clothes from what their trade would wear anywhere (o): the flyers, the patrol,
# the priest, the nurse and the mechanic's overalls are the same everywhere.
orenthian_outfit = (o: Outfit, occupation: Occupation, seed: int, age: int, skirt: bool, direction: int) -> Outfit:
    match occupation:
        .player, .courier, .racer, .pirate, .patrol, .priest, .nurse, .mechanic: return o
        else: pass
    old = age >= 62
    match direction:
        1:
            if skirt:
                if old: return Outfit(.dress, BLACK, hat_kind = 5, hat = WHITE, long_skirt = true, stockings = vec4(0.16, 0.16, 0.17, 1))
                r = Outfit(.dress, if _r(seed, 21) < 600: _w(INDIGO, _r(seed, 22)) else: WHITE, apron = if _r(seed, 23) < 650: WHITE else: vec4(0, 0, 0, 0), rolled = true)
                if _r(seed, 24) < 550: r.hat_kind = 5; r.hat = if r.top == WHITE: _w(INDIGO, _r(seed, 25)) else: WHITE
                return r
            jacket = _r(seed, 21) < 500
            r = Outfit(if jacket: Garb.coat else: Garb.shirtsleeves, if jacket: _w(INDIGO, _r(seed, 22)) else: WHITE, under = WHITE, legs = _w(INDIGO, _r(seed, 23) + 1), rolled = not jacket)
            if _r(seed, 24) < 300: r.sash = RUST
            k = _r(seed, 25)
            if k < 550: r.hat_kind = 8; r.hat = HAT_STRAW
            else if k < 800: r.hat_kind = 1; r.hat = _w(INDIGO, _r(seed, 26))
            if old: r.garb = .coat; r.top = _w(INDIGO, 0); r.rolled = false
            return r
        2:
            if skirt:
                r = Outfit(.dress, _w(TOWN_FROCK, _r(seed, 21)), long_skirt = old or _r(seed, 22) < 600, stockings = vec4(0.2, 0.19, 0.19, 1))
                k = _r(seed, 23)
                if k < 420: r.hat_kind = 5; r.hat = _w([vec4(0.18, 0.18, 0.2, 1), vec4(0.3, 0.24, 0.24, 1), vec4(0.62, 0.58, 0.5, 1)], _r(seed, 24))
                else if k < 760: r.hat_kind = 7; r.hat = _w(HAT_FELT, _r(seed, 24))
                if occupation == .fisher or occupation == .farmer: r.apron = LINEN; r.rolled = true
                return r
            wool = _w(TOWN_WOOL, _r(seed, 21))
            r = Outfit(.coat, wool, legs = wool, under = WHITE, tie = _w([vec4(0.4, 0.18, 0.16, 1), BLACK, NAVY], _r(seed, 22)))
            if occupation == .fisher or occupation == .sailor or occupation == .farmer:
                r = Outfit(.waistcoat, wool, under = _w(SHIRT_PALE, _r(seed, 23)), legs = wool, rolled = true)
            k = _r(seed, 24)
            r.hat_kind = if k < 500: 6 else: (if k < 900: 1 else: 0)
            r.hat = if r.hat_kind == 6: _w(HAT_FELT, _r(seed, 25)) else: _w(HAT_CAP, _r(seed, 25))
            r.band = BLACK
            return r
        _:
            if skirt:
                if old: return Outfit(.dress, BLACK, hat_kind = 5, hat = _w([BLACK, WHITE], _r(seed, 21)), long_skirt = true, stockings = vec4(0.16, 0.16, 0.17, 1))
                r = Outfit(.dress, _w(LONG_SKIRT, _r(seed, 21)), long_skirt = true, apron = _w([LINEN, WHITE, vec4(0.62, 0.52, 0.36, 1)], _r(seed, 22)), long_apron = true, rolled = occupation == .fisher or occupation == .farmer, stockings = vec4(0.3, 0.26, 0.22, 1))
                # (the large white headscarf, most of them; a coloured one now and then)
                if _r(seed, 23) < 780: r.hat_kind = 5; r.hat = if _r(seed, 24) < 750: WHITE else: _w(SASH_CLOTH, _r(seed, 25))
                return r
            r = Outfit(.waistcoat, _w(WAISTCOAT_DARK, _r(seed, 21)), under = _w([WHITE, LINEN, vec4(0.86, 0.84, 0.78, 1)], _r(seed, 22)), legs = _w(LOOSE_TROUSERS, _r(seed, 23)), sash = _w(SASH_CLOTH, _r(seed, 24)), rolled = _r(seed, 25) < 500)
            if old: r.garb = .coat; r.top = _w([GREYBROWN, BLACK], _r(seed, 26)); r.rolled = false
            k = _r(seed, 27)
            if k < 450: r.hat_kind = BRIMLESS_CAP; r.hat = _w([vec4(0.22, 0.2, 0.2, 1), vec4(0.4, 0.3, 0.22, 1), vec4(0.5, 0.18, 0.16, 1)], _r(seed, 28))
            else if k < 800: r.hat_kind = 1; r.hat = _w(HAT_CAP, _r(seed, 28))
            return r
