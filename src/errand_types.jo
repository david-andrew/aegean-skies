# Errands: jobs of a kind the islands had in the 1920s and 30s, posted by the people whose work they
# are (src/errands.jo). Kept in the World (World.errands, by job), so what a job is (the mail, the
# morning papers, ice, sponges, the nurse to a sick child) is known to the board, the talk, the
# dock and the pilot's name, and saved with the game.

enum ErrandKind: mail, papers, ice, sponges, nurse

struct Errand:
    job: int
    kind: ErrandKind
    recipient = -1                  # who meets the aircraft and takes it (the passenger's host: nurse)
    child = ""                      # (nurse) the sick child's name
    posted: int                     # the minute it was posted
