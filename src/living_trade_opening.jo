# Founding voyage book: actual owned carriers/crew, actual paid loads and actual route poses.
# An established reciprocal service need not begin history with every boat at its A office.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_orders.jo'
use 'living_far_transport.jo'
use 'living_far_stock.jo'
use 'living_war.jo'
use 'living_guard.jo'
use 'living_transaction.jo'

opening_trade_score = (w: World,vehicle: int,origin: int,order: FarRestockOrder) -> (int,int):
    v=w.far.vehicles[vehicle]; d=w.far.districts[origin]; link=w.far.links[v.route]
    arrives=w.minute+(link.length_mm+v.speed_mm_sec*2-1)/(v.speed_mm_sec*2)
    result=(-1,0)
    loop good in 0..8:
        if d.prices[good]>order.price[good]: continue
        qty=min(counter_sale_available(w,origin,good),order_quantity_for_supplier(order,good,origin,arrives))
        qty=min(qty,min(v.capacity_grams*1000/w.goods[good].package_grams,max(0,w.accounts[order.account].cents-order.freight)*1000/max(1,d.prices[good])))
        if qty<FAR_MIN_PURCHASE: continue
        priority=if good==3 and order_urgent_food(order,origin,arrives)>0: 1 else: 0
        score=qty*d.prices[good]
        if priority>result.0 or (priority==result.0 and score>result.1): result=(priority,score)
    result

place_opening_voyage = (w: mut World,id: int,distance: int):
    j=w.far.journeys[id]; link=w.far.links[j.link]
    left=clamp(distance,0,link.length_mm-1); segment=0
    loop segment<link.points.len()-2:
        a=journey_route_point(link.points,j.forward,segment); b=journey_route_point(link.points,j.forward,segment+1)
        span=int(round(f64(length(b-a))*1000.0))
        if left<span: break
        left-=span; segment+=1
    a=journey_route_point(link.points,j.forward,segment); b=journey_route_point(link.points,j.forward,segment+1)
    span=max(1,int(round(f64(length(b-a))*1000.0)))
    left=min(left,span-1)
    w.far.journeys[id].segment=segment; w.far.journeys[id].progress_mm=left
    w.far.journeys[id].opening_progress_mm=distance
    w.far.journeys[id].last_tick=w.tick
    w.far.vehicles[j.vehicle].pos=mix(a,b,f32(f64(left)/f64(span)))
    w.far.vehicles[j.vehicle].velocity=if length(b-a)>0.001: normalize(b-a)*f32(f64(j.speed_mm_sec)/1000.0) else: vec3(0,0,0)
    w.far.journeys[id].provenance.cause="Opening voyage book: this paid load is bound for its agreed counter. "+j.provenance.cause

initialize_opening_trade = (w: mut World) -> int:
    if not w.far.populated or not w.far.opening_trade_pending or guard_blocked(): return 0
    # Never move a played/leased body, or reconstruct a voyage from a loaded old bank.
    untouched=w.minute==w.far.opening_minute and w.far.completed_journeys==0 and w.far.journeys.len()==0
    loop v in w.far.vehicles:
        if v.scene_owned: untouched=false
    w.far.opening_trade_pending=false
    if not untouched: return 0
    scope=guard_begin(w)
    # Reserve actual standing national hulls before merchants receive starting poses.
    if w.far.harbors.len()>0 and w.war.last_hour<0: war_minute(w)
    count=0
    loop vehicle in 0..w.far.vehicles.len():
        if guard_blocked(): break
        v=w.far.vehicles[vehicle]
        if v.duty!=.merchant or v.journey>=0 or v.cargo.roots.len()>0 or v.route<0: continue
        link=w.far.links[v.route]
        at_a=counter_restock_order(w,vehicle,link.b,true)
        at_b=counter_restock_order(w,vehicle,link.a,true)
        a=opening_trade_score(w,vehicle,link.a,at_a); b=opening_trade_score(w,vehicle,link.b,at_b)
        origin=if b.0>a.0 or (b.0==a.0 and b.1>a.1): link.b else: link.a
        best=if origin==link.a: a else: b
        if best.1<=0: continue
        before=w
        w.far.vehicles[vehicle].place=origin
        w.far.vehicles[vehicle].pos=if origin==link.a: link.points[0] else: link.points[link.points.len()-1]
        w.far.vehicles[vehicle].buying_order=if origin==link.a: at_a else: at_b
        w.far.vehicles[vehicle].next_departure=w.minute
        if not far_depart(w,vehicle): w=before; continue
        id=w.far.vehicles[vehicle].journey
        if w.far.journeys[id].survey: w=before; continue
        phase=200+int(mix64(w.seed xor u64(vehicle+491))%u64(601))
        place_opening_voyage(w,id,link.length_mm*phase/1000)
        count+=1
    failed=guard_failed(scope); guard_finish(w,scope)
    if failed: w.far.opening_trade_pending=false; return 0
    count
