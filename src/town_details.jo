# Shared street furniture: one mesh per kind, reused by every nearby district.
# These are scenery; display goods do not create tradable living cargo records.
use 'objects.jo'
use 'world.jo'
use 'settlements.jo'

const TOWN_PROP_COUNT = 18
# cafe, shop, pergola, bench, flowers, nets, cat, windmill, church, fountain,
# plane tree, motorcar, bicycle, terrace, beached boat, lighthouse, statue, cemetery

town_beam = (vs: mut Vertex3D[],a: vec3,b: vec3,radius: f64,col: vec4,m: mat4 = mat4()):
    add_cylinder(vs,vec3(0,0,0),radius,f64(length(b-a)),col,5,-1.0,m*translation(a)*object_toward(b-a))

town_prop_vertices = (kind: int) -> Vertex3D[]:
    vs: Vertex3D[]
    stone = rgb(0.72,0.68,0.57); wood = rgb(0.34,0.23,0.14); iron = rgb(0.14,0.2,0.19)
    white = WALLS[0]; leaf = rgb(0.23,0.39,0.15)
    if kind == 0: # tables, bentwood chairs and a striped canvas canopy
        loop x in [-2.0,2.0]:
            add_cylinder(vs,vec3(f32(x),0,0),0.12,0.85,iron,6)
            add_cylinder(vs,vec3(f32(x),0.85,0),0.85,0.09,white,10)
            loop z in [-1.25,1.25]:
                add_box(vs,vec3(f32(x),0.47,f32(z)),vec3(0.6,0.1,0.65),wood)
                add_box(vs,vec3(f32(x),0.88,f32(z*1.18)),vec3(0.6,0.7,0.08),wood)
                loop side in [-0.23,0.23]: town_beam(vs,vec3(f32(x+side),0,f32(z)),vec3(f32(x+side),0.47,f32(z)),0.035,wood)
        loop x in [-3.8,3.8]: town_beam(vs,vec3(f32(x),0,-1.8),vec3(f32(x),3.3,-1.8),0.07,wood)
        loop k in 0..10:
            add_box(vs,vec3(-3.6+f32(k)*0.8,3.25,-0.2),vec3(0.8,0.08,4.0),if k%2 == 0: white else: rgb(0.29,0.45,0.47),rotation_x(0.08))
    else if kind == 1: # shop awning and produce display
        loop k in 0..8:
            add_box(vs,vec3(-2.8+f32(k)*0.8,3.1,0),vec3(0.8,0.12,3),if k%2 == 0: white else: rgb(0.63,0.29,0.17),rotation_x(-0.12))
        add_box(vs,vec3(0,0.8,0),vec3(5.6,0.25,1.2),wood)
        loop k in 0..12:
            add_sphere(vs,vec3(-2.4+f32(k%6)*0.85,1.08,-0.3+f32(k/6)*0.6),0.32,if k%3 == 0: rgb(0.7,0.22,0.12) else: rgb(0.8,0.64,0.18),5,3)
    else if kind == 2: # vines, pergola and laundry across a courtyard
        loop x in [-3.0,3.0]:
            loop z in [-2.0,2.0]: town_beam(vs,vec3(f32(x),0,f32(z)),vec3(f32(x),3.1,f32(z)),0.10,wood)
        loop k in 0..7:
            add_box(vs,vec3(-3+f32(k),3.1,0),vec3(0.14,0.16,4.5),wood)
            if k%2 == 0: add_sphere(vs,vec3(0,0,0),1.0,leaf,6,3,translation(vec3(-3+f32(k),3.2,0))*scaling(vec3(1,0.3,2)))
        town_beam(vs,vec3(-3,2.7,2),vec3(3,2.7,2),0.022,wood)
        loop k in 0..4: add_box(vs,vec3(-2+f32(k)*1.2,2.1,2),vec3(0.8,1.1,0.04),if k%2 == 0: white else: rgb(0.34,0.47,0.62))
    else if kind == 3:
        add_box(vs,vec3(0,0.55,0),vec3(2.4,0.16,0.6),wood)
        add_box(vs,vec3(0,0.96,-0.3),vec3(2.4,0.7,0.12),wood)
        loop x in [-0.8,0.8]: add_box(vs,vec3(f32(x),0.25,0),vec3(0.12,0.5,0.6),iron)
    else if kind == 4:
        add_cylinder(vs,vec3(0,0,0),0.33,0.65,ROOFS[0],7,0.46)
        add_sphere(vs,vec3(0,0.85,0),0.5,leaf,6,3)
        loop k in 0..5: add_sphere(vs,vec3(f32(cos(f64(k)*1.3)*0.34),1.12,f32(sin(f64(k)*1.3)*0.34)),0.14,rgb(0.8,0.25,0.4),5,3)
    else if kind == 5:
        loop x in [-3.0,3.0]: town_beam(vs,vec3(f32(x),0,0),vec3(f32(x),2.6,0),0.1,wood)
        loop k in 0..13: town_beam(vs,vec3(-3+f32(k)*0.5,0.5,0.5),vec3(-3+f32(k)*0.5,2.5,0),0.016,rgb(0.45,0.39,0.25))
        loop k in 0..6: town_beam(vs,vec3(-3,0.5+f32(k)*0.4,0.5-f32(k)*0.1),vec3(3,0.5+f32(k)*0.4,0.5-f32(k)*0.1),0.016,rgb(0.45,0.39,0.25))
    else if kind == 6:
        add_sphere(vs,vec3(0,0,0),1.0,rgb(0.34,0.28,0.23),6,4,translation(vec3(0,0.3,0))*scaling(vec3(0.23,0.3,0.48)))
        add_sphere(vs,vec3(0,0.62,-0.32),0.22,rgb(0.34,0.28,0.23),6,4)
        loop x in [-0.12,0.12]: add_cylinder(vs,vec3(f32(x),0.75,-0.32),0.10,0.19,rgb(0.34,0.28,0.23),4,0.0)
        town_beam(vs,vec3(0,0.25,0.35),vec3(0.12,0.5,0.8),0.045,wood)
    else if kind == 7:
        add_cylinder(vs,vec3(0,-1,0),3.2,11.0,white,12,2.4)
        add_cylinder(vs,vec3(0,10,0),3.0,3.0,ROOFS[0],12,0.0)
        loop k in 0..6:
            m = translation(vec3(0,9,-2.5))*rotation_z(f64(k)*TAU/6.0)
            town_beam(vs,vec3(0,0,0),vec3(0,7,0),0.065,wood,m)
            add_box(vs,vec3(0.7,4.7,0),vec3(1.4,4.3,0.05),rgb(0.9,0.84,0.67),m)
    else if kind == 8:
        add_chapel(vs,mat4())
        add_sphere(vs,vec3(0,9.2,1),3.5,rgb(0.28,0.46,0.66),12,6)
        loop x in [-1.0,1.0]: add_box(vs,vec3(f32(x),13.5,-10.53),vec3(0.7,1.8,0.05),iron)
        town_beam(vs,vec3(0,12.0,1),vec3(0,14.4,1),0.09,white)
        town_beam(vs,vec3(-0.7,13.6,1),vec3(0.7,13.6,1),0.09,white)
    else if kind == 9:
        add_cylinder(vs,vec3(0,0,0),2.5,0.5,stone,12)
        add_cylinder(vs,vec3(0,0.5,0),2.1,0.04,rgb(0.25,0.55,0.59),12)
        add_cylinder(vs,vec3(0,0.5,0),0.3,1.7,stone,8)
        add_cylinder(vs,vec3(0,2.0,0),1.1,0.22,stone,10)
        add_sphere(vs,vec3(0,2.5,0),0.35,stone,8,4)
    else if kind == 10:
        town_beam(vs,vec3(0,0,0),vec3(0.4,7,0),0.6,rgb(0.55,0.52,0.39))
        loop k in 0..5:
            at = vec3(f32(cos(f64(k)*1.3)*3.2),7.4,f32(sin(f64(k)*1.3)*3.2))
            town_beam(vs,vec3(0.3,4.0,0),at,0.2,rgb(0.55,0.52,0.39))
            add_sphere(vs,vec3(0,0,0),1.0,if k%2 == 0: leaf else: rgb(0.31,0.44,0.16),8,4,translation(at)*scaling(vec3(3.8,2.0,3.8)))
    else if kind == 11:
        add_box(vs,vec3(0,0.9,0),vec3(1.8,0.8,3.9),rgb(0.14,0.23,0.22))
        add_box(vs,vec3(0,1.55,0.4),vec3(1.65,0.9,1.9),rgb(0.18,0.22,0.2))
        add_box(vs,vec3(0,1.63,-0.57),vec3(1.4,0.5,0.04),rgb(0.53,0.65,0.65))
        loop x in [-0.95,0.95]:
            loop z in [-1.2,1.2]: add_cylinder(vs,vec3(0,0,0),0.43,0.2,iron,10,-1.0,translation(vec3(f32(x),0.5,f32(z)))*rotation_z(PI/2.0))
    else if kind == 12:
        loop z in [-0.65,0.65]:
            loop k in 0..12:
                a = f64(k)*TAU/12.0; b = f64(k+1)*TAU/12.0
                town_beam(vs,vec3(0,f32(0.44+cos(a)*0.4),f32(z+sin(a)*0.4)),vec3(0,f32(0.44+cos(b)*0.4),f32(z+sin(b)*0.4)),0.035,iron)
        loop ab in [(vec3(0,0.44,-0.65),vec3(0,0.95,-0.3)),(vec3(0,0.95,-0.3),vec3(0,0.44,0.1)),(vec3(0,0.44,0.1),vec3(0,0.44,-0.65)),(vec3(0,0.44,0.65),vec3(0,1.15,0.45)),(vec3(0,1.0,0.4),vec3(0,0.95,-0.3))]: town_beam(vs,ab.0,ab.1,0.035,rgb(0.38,0.15,0.12))
        add_box(vs,vec3(0,1.05,-0.3),vec3(0.3,0.08,0.35),wood)
        town_beam(vs,vec3(-0.3,1.15,0.45),vec3(0.3,1.15,0.45),0.04,iron)
    else if kind == 13:
        add_box(vs,vec3(0,0.55,0),vec3(18,1.1,0.65),stone)
        loop k in 0..5:
            town_beam(vs,vec3(-7+f32(k)*3.5,0,2.5),vec3(-7+f32(k)*3.5,2.8,2.5),0.16,wood)
            add_sphere(vs,vec3(0,0,0),1.0,rgb(0.36,0.43,0.24),6,3,translation(vec3(-7+f32(k)*3.5,3.1,2.5))*scaling(vec3(2,1.4,1.8)))
    else if kind == 14:
        add_beached_hull(vs,rotation_z(0.18))
    else if kind == 15:
        add_cylinder(vs,vec3(0,-1,0),2.8,15,white,12,1.8)
        add_cylinder(vs,vec3(0,14,0),2.4,0.35,iron,12)
        add_cylinder(vs,vec3(0,14.4,0),1.5,2.0,rgba(0.95,0.85,0.55,0.5),10)
        add_cylinder(vs,vec3(0,16.4,0),2.0,1.8,ROOFS[0],12,0.0)
    else if kind == 16: # a small civic statue on a stone plinth
        add_box(vs,vec3(0,0.7,0),vec3(1.6,1.4,1.6),stone)
        add_cylinder(vs,vec3(0,1.4,0),0.45,1.8,rgb(0.35,0.42,0.34),7,0.25)
        add_sphere(vs,vec3(0,3.45,0),0.28,rgb(0.35,0.42,0.34),7,4)
        town_beam(vs,vec3(-0.2,2.7,0),vec3(-0.9,2.9,-0.25),0.12,rgb(0.35,0.42,0.34))
    if kind == 17:
        # One bounded chapel/cemetery grouping, shared by every district.
        loop x in [-4.0,4.0]:
            at = vec3(f32(x),0,0)
            add_cylinder(vs,at,0.22,2.0,rgb(0.34,0.28,0.2),5)
            add_sphere(vs,vec3(0,0,0),1.0,rgb(0.08,0.21,0.11),6,5,translation(at+vec3(0,4.7,0))*scaling(vec3(1.0,4.3,1.0)))
            add_cylinder(vs,at+vec3(0,7.2,0),0.55,2.5,rgb(0.09,0.23,0.12),6,0.0)
        loop k in 0..4:
            at = vec3(f32(k%2)*2.0-1.0,0.12,f32(k/2)*2.5+2.0)
            add_box(vs,at,vec3(0.9,0.22,1.6),stone)
            add_box(vs,at+vec3(0,0.6,-0.5),vec3(0.13,1.2,0.13),white)
            add_box(vs,at+vec3(0,0.83,-0.5),vec3(0.6,0.12,0.13),white)
    vs

# Clip roads against the canonical terrain triangles. A wide quad sampled only
# at its corners cuts through the hill between them (especially a town square).
# Clipped polygons conform exactly without dense uniform tessellation.
town_clip = (poly: vec2[],normal: vec2,offset: f64) -> vec2[]:
    result: vec2[]
    if poly.len() == 0: return result
    a = poly[poly.len()-1]; da = f64(dot(a,normal))+offset
    loop b in poly:
        db = f64(dot(b,normal))+offset
        if (da >= 0.0) != (db >= 0.0):
            result.push(mix(a,b,f32(da/(da-db))))
        if db >= 0.0: result.push(b)
        a = b; da = db
    result

town_path = (vs: mut Vertex3D[],a: vec2,b: vec2,width: f64,paved: bool):
    start=vs.len()
    len = f64(length(b-a))
    if len < 0.1: return
    direction = normalize(b-a); normal = vec2(-direction.y,direction.x)
    side = normal*f32(width*0.5)
    low = min(min(a-side,a+side),min(b-side,b+side))
    high = max(max(a-side,a+side),max(b-side,b+side))
    # Original meshes have per-island lattice origins; new terrain uses zero.
    ox = 0.0; oz = 0.0
    mid = (a+b)*0.5
    if abs(mid.x) < 20000.0 and abs(mid.y) < 20000.0:
        loop isl in ISLANDS:
            if island_height(isl,f64(mid.x),f64(mid.y)) <= 0.0: continue
            extent = mesh_extent(isl)
            ox = f64(isl.center.x)-extent; oz = f64(isl.center.y)-extent
            break
    # Work in a local frame for clipping; world-sized dot products lose the
    # centimetres that separate paving from the ground at 250 km coordinates.
    loop j in int(floor((f64(low.y)-oz)/14.0))..int(floor((f64(high.y)-oz)/14.0))+1:
        loop i in int(floor((f64(low.x)-ox)/14.0))..int(floor((f64(high.x)-ox)/14.0))+1:
            x = ox+f64(i)*14.0; z = oz+f64(j)*14.0
            corners = [vec2(f32(x),f32(z)),vec2(f32(x+14.0),f32(z)),vec2(f32(x),f32(z+14.0)),vec2(f32(x+14.0),f32(z+14.0))]
            hs = [loop p in corners: place_ground(p)]
            loop tri in [[0,1,2],[3,2,1]]:
                poly = [loop k in tri: corners[k]-a]
                poly = town_clip(poly,direction,0.0)
                poly = town_clip(poly,-direction,len)
                poly = town_clip(poly,normal,width*0.5)
                poly = town_clip(poly,-normal,width*0.5)
                if poly.len() < 3: continue
                points: vec3[]
                dry = true
                loop local in poly:
                    p = local+a
                    h = triangle_height(hs[0],hs[1],hs[2],hs[3],(f64(p.x)-x)/14.0,(f64(p.y)-z)/14.0)
                    if h < 0.2: dry = false
                    points.push(vec3(p.x,f32(h+0.12),p.y))
                if not dry: continue
                col = if paved: rgb(0.76,0.72,0.64) else: rgb(0.64,0.51,0.33)
                loop k in 1..points.len()-1:
                    if length(cross(points[k]-points[0],points[k+1]-points[0])) < 0.0001: continue
                    add_outward_triangle(vs,points[0],points[k],points[k+1],col,points[0]-vec3(0,2,0))
    # Small stair treads only on steep narrow alleys, never across a square.
    grade = abs(place_ground(b)-place_ground(a))/len
    if paved and width < 6.0 and grade > 0.22 and grade < 0.65:
        n = max(1,int(ceil(len/0.8)))
        loop k in 0..n:
            p = mix(a,b,f32((f64(k)+0.5)/f64(n)))
            h = place_ground(p)
            if h < 0.5: continue
            add_box(vs,vec3(0,-0.12,0),vec3(f32(width),0.42,f32(len/f64(n)*0.85)),rgb(0.72,0.68,0.60),translation(vec3(p.x,f32(h+0.1),p.y))*rotation_y(atan2(f64(direction.x),f64(direction.y))))

    if paved:
        loop k in start..vs.len(): vs[k].uv=vec2(183,0)
