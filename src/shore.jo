# Somewhere to step ashore to from an aircraft: a port's landing, else dry ground within 18 m.
# None out at sea, where there is nothing to step onto.
use 'settlement_ports.jo'
use 'objects.jo'
use 'water_field.jo'
use 'geography.jo'

shore_point = (towns: Town[], near: vec3) -> vec3?:
    if let landing=port_landing(near): return landing
    loop r in [5.0, 8.0, 12.0, 18.0]:
        loop k in 0..16:
            a = f64(k) / 16.0 * TAU
            c = near + vec3(f32(cos(a) * r), 0, f32(sin(a) * r))
            h = walk_height(towns, f64(c.x), f64(c.z))
            if h > (if geography_enabled:water_at(f64(c.x),f64(c.z)).level else:0.0)+0.5: return vec3(c.x, f32(h), c.z)
    none
