# A sheet of every mark that shows a side, drawn over the view as the game draws them (the
# target's brackets and name, the lead ring, the flight's marks and pointer, the rings over people
# in the water, the radio's speaker), in rows down the screen so each lies over sky, cloud and
# sea. For checking the colour-vision presets on captures (AEGEAN_CAPTURE_SIDES, then tools/colour_vision_view.jo):
# never drawn in play.
use 'hud.jo'
use 'side_colours.jo'
use 'target_view.jo'
use 'lead_marker.jo'
use 'rescue_view.jo'

SIDE_SAMPLE_STANDINGS = [Standing.enemy, Standing.ally, Standing.neutral]
SIDE_SAMPLE_NAMES = ["Enemy", "Friend", "Other"]

# One row of the sheet, its marks centred on y.
draw_side_sample_row = (fonts: Fonts, y: f64):
    sw = f64(screen_width())
    k = sw / 1280.0
    at = (x: f64) -> vec2: vec2(f32(x * k), f32(y))
    set_font(fonts.ui)
    # (a target of each side: brackets, sign, name)
    loop s in 0..3:
        target_brackets(at(80.0 + f64(s) * 95.0), SIDE_SAMPLE_STANDINGS[s], 0.9)
        target_name(SIDE_SAMPLE_NAMES[s], at(80.0 + f64(s) * 95.0), side_colour(SIDE_SAMPLE_STANDINGS[s], 0.9))
    # (an enemy's lead ring; one of the flight near and far, its leader, the pointer toward them)
    lead_ring(at(370.0))
    ally_mark(at(450.0) + vec2(0, 14), side_colour(.ally, ally_alpha(0.0)), false)
    ally_mark(at(510.0) + vec2(0, 14), side_colour(.ally, ally_alpha(ALLY_REACH)), false)
    ally_mark(at(570.0) + vec2(0, 14), side_colour(.ally, ally_alpha(0.0)), true)
    ally_pointer(at(670.0), vec2(1, 0), side_colour(.ally, 0.9))
    # (someone of each side in the water: ring, sign, words)
    loop s in 0..3:
        p = at(770.0 + f64(s) * 105.0)
        c = side_colour(SIDE_SAMPLE_STANDINGS[s], 0.95)
        rescue_ring(p, c)
        side_sign(p + vec2(0, -17), SIDE_SAMPLE_STANDINGS[s], 0.95)
        words = "{SIDE_SAMPLE_NAMES[s]}, 400 m"
        side_text(words, p + vec2(0, 26), 14, c)
    # (the radio's speaker, on its panel)
    who = "Leader:  "; said = "form on me"
    left = 1090.0 * k
    tw = text_width(who + said, 20)
    rect_rounded(left - 18.0, y - 20.0, tw + 36.0, 40.0, 8, rgba(0.06, 0.08, 0.10, 0.55))
    side_words(who, vec2(f32(left), f32(y) - 10.0), 20, side_colour(.ally))
    text(said, vec2(f32(left + text_width(who, 20)), f32(y) - 10.0), 20, rgba(1, 0.97, 0.9, 1))
    set_font()

# The sheet: `rows` rows, evenly down the view from under the compass to over the instruments.
draw_side_samples = (fonts: Fonts, rows: int = 4):
    sh = f64(screen_height())
    loop r in 0..rows: draw_side_sample_row(fonts, sh * (0.125 + 0.55 * f64(r) / f64(max(rows - 1, 1))))
