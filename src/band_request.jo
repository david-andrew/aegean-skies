# A number asked of the hotel's band (and tipped): played from `start` (a world tick on a boundary
# between numbers), after which the evening's set carries on where it was (src/bar_band.jo).
# Kept with the leisure state, so it is saved with the game.
struct BandRequest:
    index: int                      # into BAR_SET
    start: int                      # world tick
    by_player = true
