# The sandbox switches' one entry in the living world's books: the unlimited purse (src/sandbox.jo).
# Money that comes from nowhere in the world is entered as the outside's, in or out, exactly as
# the debugging panel's purse is, so the cash ledger still balances (living_money.money_balances)
# and a save made with the switch on is as valid as any other. Only the player's own account is
# written: nobody else's money, cargo or wear is touched by a switch.
use 'sandbox.jo'
import 'living_types.jo' as data

# The player's purse brought to what the switch makes it; the hold to keep (the game's, saved in
# its session).
sandbox_money_step = (w: mut data.World, h: PurseHold, on: bool) -> PurseHold:
    if w.player < 0 or w.player >= w.people.len(): return h
    a = w.people[w.player].account
    if a < 0 or a >= w.accounts.len(): return h
    have = w.accounts[a].cents
    want, hold = sandbox_purse(have, h, on)
    if want > have: w.ledger.external_in_cents += want - have
    else: w.ledger.external_out_cents += have - want
    w.accounts[a].cents = want
    hold
