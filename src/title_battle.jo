# The title's merge (a high shot's pace 4, src/title_shots.jo): the strait battle as its scenario
# opens it (src/scenarios.jo: the same two formations, pilots and engagement), flown by the
# battle's own AI and flight model (step_battle), a slice at a time in the frames of the shot
# before, and kept as tracks the shot replays: the formations close, pass through each other
# and break, and the shot ends before anyone is shot down.
use 'scenarios.jo'
use 'combat.jo'
use 'flight.jo'
use 'air_pilot.jo'
use 'planes.jo'
use 'title_shots.jo'

# (the ground under the fight, on a 50 m grid: the world's is dear to ask every tick)
title_battle_ground: {int: f64} = {}
_title_battle_ground = (ground: (f64, f64) -> f64, x: f64, z: f64) -> f64:
    global title_battle_ground
    key = int(floor(x / 50.0)) * 1000003 + int(floor(z / 50.0))
    if let h = title_battle_ground.get(key): return h
    h = ground(x, z)
    title_battle_ground[key] = h
    h

struct TitleBattling:
    battle: Battle
    begun = false
    tick = 0
    done = false
    first_shot = -1.0               # (seconds into the shot of the first round fired, and of the first aircraft down)
    first_down = -1.0

# the strait's two sides as the scenario opens them; the player's Gull (behind Kalyra's V) flown
# outside the battle's AI, as the player flies it, here straight on
const TITLE_PLAYER = 7
title_battle_open = (models: CraftModel[]) -> Battle:
    actors: Combatant[]
    loop side in 0..2:
        base = side * 8
        loop slot in 0..8:
            ws = strait_wing_slot(side, slot)
            a = strait_combatant(base + slot, base + slot, side, slot, base, if ws >= 0: base + ws else: -1, side == 0 and slot == TITLE_PLAYER, models)
            a.human = side == 0 and slot == TITLE_PLAYER; a.external = a.human; a.spec.player = a.human
            actors.push(a)
    strait_engagement(actors)

# Fly on until `until` (time()); true once the whole shot is flown.
title_battle_step = (shot: mut TitleShot, f: mut TitleBattling, models: CraftModel[], ground: (f64, f64) -> f64, until: f64) -> bool:
    global title_battle_ground
    if f.done: return true
    if not f.begun:
        f.battle = title_battle_open(models); f.begun = true; f.tick = 0
        title_battle_ground = {}
        shot.race = [loop a in f.battle.actors: TitleRaceTrack(model = a.model, kind = 0)]
        shot.rounds = []; shot.round_from = []; shot.shots = []; shot.shot_by = []; shot.shot_off = []; shot.round_scale = f.battle.bullet_scale
    env = FlightEnv(ground = (x: f64, z: f64) -> f64: _title_battle_ground(ground, x, z))
    start = int(shot.start * 60.0)
    total = start + int((shot.length + 1.0) * 60.0)
    loop f.tick < total:
        # (the player's Gull: straight on at the formation's height and pace)
        p = f.battle.actors[TITLE_PLAYER]
        hold = f64(strait_origin(0).y) + f64(p.pilot.formation_offset.y)
        c = air_waypoint_controls(p.spec, p.state, env, p.state.position + heading_vector(p.pilot.formation_heading) * 3000.0, hold, p.pilot.formation_speed)
        step(p.spec, p.state, c, env, COMBAT_DT)
        f.battle.actors[TITLE_PLAYER] = p
        # (the camera rides behind it: the pilots near it fly their full model)
        step_battle(f.battle, env, p.state.position)
        age = f64(f.tick - start) / 60.0
        loop e in f.battle.events:
            if e.kind == .shot and f.first_shot < 0.0: f.first_shot = age
            if e.kind == .shot and f.tick >= start and e.craft >= 0 and e.craft < f.battle.actors.len():
                shot.shots.push(vec4(e.position, f32(age))); shot.shot_by.push(e.craft); shot.shot_off.push(e.position - f.battle.actors[e.craft].state.position)
            if e.kind == .downed and f.first_down < 0.0: f.first_down = age
        if f.tick >= start:
            # (the rounds in the air, for the tracers)
            shot.round_from.push(shot.rounds.len())
            loop o in f.battle.rounds:
                if o.tracer: shot.rounds.push(TitleRound(at = o.position, velocity = o.velocity, age = o.age))
            loop i in 0..f.battle.actors.len():
                st = f.battle.actors[i].state
                shot.race[i].at.push(st.position); shot.race[i].turn.push(st.orientation); shot.race[i].velocity.push(st.velocity); shot.race[i].throttle.push(st.throttle)
        f.tick += 1
        if time() > until: return false
    shot.round_from.push(shot.rounds.len())
    f.done = true
    true
