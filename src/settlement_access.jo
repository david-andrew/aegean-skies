# Publish the validated living network to physical scenery. No new journeys,
# residents or route search: the catalogue's exact horizontal paths are authority.
use 'settlements.jo'
use 'living_far_types.jo'

access_catalog_stamp = -1
access_feeder_roads: int[]

publish_access_roads = (links:FarLink[]):
    global settlement_roads,world_settlements,access_catalog_stamp,access_feeder_roads
    if not settlement_registry_ready:return
    if access_catalog_stamp==settlement_generation:return
    access_feeder_roads=[]
    loop link in links:
        if link.mode!=.cart or link.points.len()<2:continue
        if not (link.a in settlement_by_id) or not (link.b in settlement_by_id):continue
        id=link.road
        if id<0:
            if not link.trail:continue
            id=settlement_roads.len()
            settlement_roads.push(SettlementRoad(link.a,link.b,[],1.8,true,vec4(0,0,0,0)))
            access_feeder_roads.push(id)
        else:
            if id>=settlement_roads.len():continue
            road=settlement_roads[id]
            if road.a!=link.a or road.b!=link.b:continue
        path=compact_place_route(link.points)
        lo=path[0].xz;hi=lo
        loop p in path:lo=min(lo,p.xz);hi=max(hi,p.xz)
        settlement_roads[id].points=path
        settlement_roads[id].bounds=vec4(lo.x,lo.y,hi.x,hi.y)
        settlement_roads[id].ready=true
        loop place in [link.a,link.b]:
            at=settlement_by_id[place]
            if not (id in world_settlements[at].roads):world_settlements[at].roads.push(id)
    loop i in 0..world_settlements.len():
        world_settlements[i].roads.sort()
        world_settlements[i].neighbors=[loop id in world_settlements[i].roads:if settlement_roads[id].points.len()>1:(if settlement_roads[id].a==world_settlements[i].id:settlement_roads[id].b else:settlement_roads[id].a)]
    index_settlement_roads()
    access_catalog_stamp=settlement_generation
    if env("AEGEAN_ACCESS_TRACE")!=none:print("ACCESS published generation={settlement_generation} roads={settlement_roads.len()} feeders={access_feeder_roads.len()}")
