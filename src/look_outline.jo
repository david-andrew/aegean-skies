# The look's highlight by the thing's own shape (glossary: Things to tap). The thing the view looks
# at on foot (aegean.jo foot_look), or the pointer is on in a room of a stay, is drawn a second
# time, alone, into a small mask: its meshes are drawn flat into a render target that covers only
# its rectangle on the screen. One pass over that rectangle then draws a thin white line just
# outside the mask's edge (a faint dark one under it), and the slow band of light with its flecks
# inside it. The mask keeps each pixel's nearest point of the thing (its own depth test), and the
# highlight is left out wherever the scene is nearer there (the pilot in front of it, a nearer
# thing): there only a faint line crosses him, a hint of it. Nothing is drawn or rendered when
# nothing is looked at.
#
# Every lookable thing has a kind (LookKind), and every kind a shape of its own (look_shape_of):
#   drawn   its own meshes, taken as the scene draws them: look_take, between look_capture(look_on(kind))
#           and look_capture(false) (a person, the aircraft, the tip jar);
#   part    a small mesh of the vertices it has in the larger mesh it is part of, made by the same
#           code that builds that mesh (a table in the hotel's one mesh), given with look_add;
#   proxy   a small mesh built to match what is seen, where the thing has no vertices of the mask's
#           kind (the hot pool's water), given with look_add.
# No kind is without one: the box's outline (aegean.jo draw_look) is only for the software
# renderer, which cannot draw the mask. tests/look_shape_test.jo holds every kind to this.
use 'render_space.jo'
use 'depth_space.jo'

# The kinds of thing that can be looked at. A new one is added here, given its shape in
# look_shape_of, and (a part or a proxy) its vertices in src/look_things.jo look_vertices.
enum LookKind:
    person              # (anyone about: their figure)
    cockpit             # (one's own aircraft, at the cockpit: "Climb aboard")
    engine              # (one's own aircraft, at the engine: "Work on her")
    hotel_table         # (a table on the hotel's terrace, or the pilot's in its bar room)
    bar_stool           # (the stool at the hotel's bar)
    hotel_door          # (the hotel's door: its desk, "Ask for a room", "Your room")
    barber_chair
    tip_jar             # (the band's)
    bandstand           # (its platform, the piano and the microphone on it)
    tavli_board         # (the coffee house's, closed on the table)
    paper               # (the day's, folded on the coffee house's table)
    coffee_table
    bath_keeper         # (the springs' keeper)
    hot_pool            # (the springs' hot pool: its water and the stone round it)
    room_bed            # (a stay's room: src/room_walk.jo's things)
    room_chair
    room_window
    room_door

enum LookShape: drawn, part, proxy

# How each kind gets its shape. (No default: a kind added without one does not compile.)
look_shape_of = (k: LookKind) -> LookShape:
    match k:
        .person: .drawn
        .cockpit: .drawn
        .engine: .drawn
        .hotel_table: .part
        .bar_stool: .part
        .hotel_door: .part
        .barber_chair: .part
        .tip_jar: .drawn
        .bandstand: .part
        .tavli_board: .drawn
        .paper: .drawn
        .coffee_table: .part
        .bath_keeper: .drawn
        .hot_pool: .proxy
        .room_bed: .part
        .room_chair: .part
        .room_window: .part
        .room_door: .part

# What is looked at this frame (set by the look before the frame is drawn), for the kinds the scene
# draws: it takes their meshes as it draws them.
look_capturing = false              # (while true, look_take keeps each mesh drawn)
look_now = -1                       # (the kind looked at, as its number; -1 nothing)
look_folk = -1                      # (the scene's folk looked at: draw_folk takes their figure)

look_set = (k: LookKind, folk: int = -1):
    global look_now, look_folk
    look_now = int(k); look_folk = folk

look_clear = ():
    global look_now, look_folk
    look_now = -1; look_folk = -1

look_on = (k: LookKind) -> bool: look_now == int(k)

look_meshes: Mesh[] = []
look_models: mat4[] = []            # (render space: about render_origin(scene_camera()))
look_taken_frame = -1

_look_keep = (m: Mesh, model: mat4):
    global look_meshes, look_models, look_taken_frame
    if look_taken_frame != frame_number():
        look_meshes = []; look_models = []
        look_taken_frame = frame_number()
    look_meshes.push(m); look_models.push(model)

# One mesh as the scene draws it, placed by its model (render space: an ObjParams' model), kept
# while capturing.
look_take = (m: Mesh, model: mat4):
    if look_capturing: _look_keep(m, model)

# One mesh of the thing's shape given straight to this frame's mask, placed by its model in the
# world (as obj_params takes it): a part's or a proxy's small mesh, or a prop's shared mesh with
# its own instance's model. It is not drawn in the scene. Whoever knows the thing keeps the mesh;
# call it for the thing looked at only, before draw_look_outline, any time in the frame.
look_add = (m: Mesh, model: mat4):
    _look_keep(m, render_model(model, render_origin(scene_camera())))

# (the scene, around the draw of the thing looked at: take it, then no more)
look_capture = (on: bool):
    global look_capturing
    look_capturing = on

# what was taken this frame
look_taken = () -> int: if look_taken_frame == frame_number(): look_meshes.len() else: 0

# ---------------- the mask ----------------
LOOK_MASK_RES = 384

struct LookMaskParams:
    vp: mat4
    model: mat4
    rect: vec4                      # (the mask's rectangle on the screen, ndc: centre x, y, half x, y)
    range: vec2                     # (the thing's nearest and farthest view depth, metres)

struct LookMaskOut:
    pos: vec4
    depth: f32                      # (view depth along the view, metres: the clip's w)

look_mask_vs = (v: Vertex3D, u: LookMaskParams) -> LookMaskOut:
    c = u.vp * (u.model * vec4(v.pos, 1))
    LookMaskOut(vec4((c.x - u.rect.x * c.w) / u.rect.z, (c.y - u.rect.y * c.w) / u.rect.w, c.z, c.w), c.w)

# Coverage in red; in green, where the thing is in its own depth range (0 nearest .. 1 farthest),
# so a filtered sample at the edge, divided by its coverage, is still a depth.
look_mask_fs = (i: LookMaskOut, u: LookMaskParams) -> vec4:
    vec4(1, clamp((i.depth - u.range.x) / max(u.range.y - u.range.x, 0.01), 0.0, 1.0), 0, 1)

# ---------------- the highlight ----------------
struct LookFxVertex:
    corner: vec2

struct LookFxParams:
    mask: Texture
    rect: vec4                      # (as the mask's)
    px: vec4                        # (the screen's pixels w, h; the line's half width and the under-edge's, px)
    band: vec4                      # (across the band, in screen pixels: its direction x, y; its middle; its half width)
    alpha: vec4                     # (the line, the under-edge, the band, the flecks)
    tick: f32
    scene: Texture                  # (the scene's depth, to leave out what is hidden)
    hide: vec4                      # (world_depth_params' two; 1 when the scene's depth is there; unused)
    range: vec2                     # (as the mask's)

struct LookFxOut:
    pos: vec4
    ndc: vec2

look_fx_vs = (v: LookFxVertex, u: LookFxParams) -> LookFxOut:
    ndc = u.rect.xy + (v.corner * 2.0 - vec2(1, 1)) * u.rect.zw
    LookFxOut(vec4(ndc, 0, 1), ndc)

look_fx_fs = (i: LookFxOut, u: LookFxParams) -> vec4:
    uv = (i.ndc - u.rect.xy) / u.rect.zw * 0.5 + vec2(0.5, 0.5)
    # (a screen pixel, in the mask's uv)
    d = vec2(1, 1) / (u.rect.zw * u.px.xy)
    own = sample(u.mask, uv)
    inside = smoothstep(0.3, 0.7, own.x)
    near: f32 = 0.0
    far: f32 = 0.0
    # (the thing's depth here, as a fraction of its range: its own, or out past its edge, the
    # nearest of it the ring finds)
    at: f32 = if own.x > 0.3: own.y / own.x else: 2.0
    # (well inside, no line: the ring's sixteen looks only near the edge and outside)
    if inside < 0.99:
        loop k in [0..8):
            a = f32(k) * 0.7853982
            o = vec2(cos(a), sin(a)) * d
            m1 = sample(u.mask, uv + o * u.px.z)
            m2 = sample(u.mask, uv + o * u.px.w)
            near = max(near, m1.x)
            far = max(far, m2.x)
            if m1.x > 0.3: at = min(at, m1.y / m1.x)
            if m2.x > 0.3: at = min(at, m2.y / m2.x)
    # (hidden: the scene here is nearer than the thing, by more than a little)
    seen: f32 = 1.0
    if u.hide.z > 0.5 and at < 1.5:
        raw = sample(u.scene, i.ndc * 0.5 + vec2(0.5, 0.5)).x
        if world_has_depth(raw, u.hide.xy):
            thing = u.range.x + at * (u.range.y - u.range.x)
            if world_depth_decode(raw, u.hide.xy) < thing * 0.97 - 0.12: seen = 0.0
    out = 1.0 - inside
    line = smoothstep(0.2, 0.55, near) * out
    under = smoothstep(0.2, 0.55, far) * out
    # (the band: a soft bar across the slant, down the screen; the flecks in it)
    sp = vec2((i.ndc.x * 0.5 + 0.5) * u.px.x, (0.5 - i.ndc.y * 0.5) * u.px.y)
    n = u.band.xy
    across = dot(sp, n)
    tent = max(0.0, 1.0 - abs(across - u.band.z) / u.band.w)
    along = dot(sp, vec2(n.y, -n.x))
    cell = vec2(floor(along / (6.0 * u.px.z)), floor(across / (1.6 * u.px.z)))
    h = hash21(cell + vec2(u.tick * 37.0, u.tick * 11.0))
    fleck = step(0.955, h) * tent * (0.35 + 0.65 * hash21(cell * 3.0 + vec2(u.tick * 5.0, 17.0)))
    # (hidden: the line faint, a hint of where it is; no band, flecks or under-edge there)
    white = clamp(u.alpha.x * line * (0.2 + 0.8 * seen) + (u.alpha.z * tent + u.alpha.w * fleck) * inside * seen, 0.0, 1.0)
    dark = u.alpha.y * under * seen
    a = white + dark * (1.0 - white)
    if a < 0.002: discard()
    vec4(vec3(1, 1, 1) * (white / a), a)

look_mask_sh = Shader()
look_fx_sh = Shader()
look_fx_quad = Mesh()
look_mask_target = RenderTarget()

# made with the rest at the start, so the first look doesn't wait on them
init_look_outline = ():
    global look_mask_sh, look_fx_sh
    if look_mask_sh.prog == 0: look_mask_sh = make_shader(shader(look_mask_vs, look_mask_fs))
    if look_fx_sh.prog == 0: look_fx_sh = make_shader(shader(look_fx_vs, look_fx_fs))

# Whether the mask can be drawn here (not the software renderer, which keeps the box's outline, and
# in a room the brighter redraw). AEGEAN_LOOK_SHAPE=0: as the software renderer has it (for
# measuring what the shape costs).
look_shape_on = env("AEGEAN_LOOK_SHAPE") != "0"
look_outline_available = () -> bool: look_shape_on and not __soft
# AEGEAN_LOOK_DEPTH=0: the highlight drawn over whatever is in front of the thing (as before)
look_depth_on = env("AEGEAN_LOOK_DEPTH") != "0"

# The rectangle (ndc: centre, half size) covering what was taken, a few pixels out for the line;
# none when nothing was taken or a mesh's size isn't known. Behind the eye: all of the screen.
look_rect = (vp: mat4, margin: vec2) -> vec4?:
    if look_taken() == 0: return none
    lo = vec2(1e9, 1e9); hi = vec2(-1e9, -1e9)
    loop k in 0..look_meshes.len():
        m = look_meshes[k]
        if m.radius < 0.0: return vec4(0, 0, 1, 1)
        mm = vp * look_models[k]
        loop c in 0..8:
            r = m.radius
            p = m.center + vec3(if c % 2 == 1: r else: -r, if (c / 2) % 2 == 1: r else: -r, if c / 4 == 1: r else: -r)
            q = mm * vec4(p, 1)
            if q.w <= 0.05: return vec4(0, 0, 1, 1)
            s = q.xy / q.w
            lo = vec2(min(lo.x, s.x), min(lo.y, s.y)); hi = vec2(max(hi.x, s.x), max(hi.y, s.y))
    lo = vec2(max(lo.x - margin.x, -1.0), max(lo.y - margin.y, -1.0))
    hi = vec2(min(hi.x + margin.x, 1.0), min(hi.y + margin.y, 1.0))
    if hi.x <= lo.x or hi.y <= lo.y: return none
    vec4((lo + hi) * 0.5, (hi - lo) * 0.5)

# The thing's nearest and farthest view depth (metres), from its meshes' bounding spheres.
look_range = (vp: mat4) -> vec2:
    lo = 1e9; hi = 0.0
    loop k in 0..look_meshes.len():
        m = look_meshes[k]; mm = look_models[k]
        r = f64(m.radius) * f64(max(length(mm[0].xyz), max(length(mm[1].xyz), length(mm[2].xyz))))
        w = f64((vp * (mm * vec4(m.center, 1))).w)
        lo = min(lo, w - r); hi = max(hi, w + r)
    vec2(f32(max(lo, 0.05)), f32(max(hi, lo + 0.1)))

# Draw the highlight of what was taken this frame (call in the 2D drawing, after the scene).
# `age` is how long it has been looked at (the band's place and the fade in), `unit` a 2D unit
# in screen pixels (the line's width goes by it). False when there was nothing to draw it by.
draw_look_outline = (age: f64, unit: f64) -> bool:
    global look_mask_sh, look_fx_sh, look_fx_quad, look_mask_target
    if not look_outline_available() or look_taken() == 0: return false
    pw = f64(__screen_px_w()); ph = f64(__screen_px_h())
    origin = render_origin(scene_camera())
    vp = render_view_proj(origin)
    lw = 1.5 * unit; uw = 3.2 * unit
    rr = look_rect(vp, vec2(f32((uw + 2.0) * 2.0 / pw), f32((uw + 2.0) * 2.0 / ph)))
    if rr == none: return false
    rect = rr!
    zone("look outline")
    init_look_outline()
    if look_fx_quad.count == 0 and look_fx_quad.index_count == 0:
        look_fx_quad = mesh([LookFxVertex(vec2(0, 0)), LookFxVertex(vec2(1, 0)), LookFxVertex(vec2(0, 1)), LookFxVertex(vec2(1, 1))], [u32(0), u32(1), u32(2), u32(2), u32(1), u32(3)])
    # (with a depth buffer of its own: each pixel keeps the thing's nearest point)
    if look_mask_target.texture.width != LOOK_MASK_RES: look_mask_target = render_target(LOOK_MASK_RES, LOOK_MASK_RES)
    range = look_range(vp)
    flush()
    st = __draw_state()
    cull(.none); blend(.none)
    glBindFramebuffer(GL_FRAMEBUFFER, u32(look_mask_target.fbo))
    glViewport(0, 0, i32(LOOK_MASK_RES), i32(LOOK_MASK_RES))
    depth_write(true); depth_test(.nearer)
    clear(vec4(0, 0, 0, 0)); clear_depth()
    loop k in 0..look_meshes.len(): draw(look_mask_sh, look_meshes[k], LookMaskParams(vp, look_models[k], rect, range))
    depth_test(.off); depth_write(false)
    __bind_current()
    blend(.alpha)
    # (the band: down the screen, slanted a little, across the rectangle and round again)
    n = normalize(vec2(0.32, 1.0))
    x0 = (f64(rect.x - rect.z) * 0.5 + 0.5) * pw; x1 = (f64(rect.x + rect.z) * 0.5 + 0.5) * pw
    y0 = (0.5 - f64(rect.y + rect.w) * 0.5) * ph; y1 = (0.5 - f64(rect.y - rect.w) * 0.5) * ph
    m0 = 1e9; m1 = -1e9
    loop c in [vec2(f32(x0), f32(y0)), vec2(f32(x1), f32(y0)), vec2(f32(x0), f32(y1)), vec2(f32(x1), f32(y1))]:
        u = f64(dot(c, n))
        m0 = min(m0, u); m1 = max(m1, u)
    w = clamp((m1 - m0) * 0.18, 8.0 * unit, 60.0 * unit)
    mid = m0 - w + (m1 - m0 + w * 2.0) * fract(age / 3.2)
    fade = clamp(age / 0.18, 0.0, 1.0)
    depth = scene_depth()
    hidden = look_depth_on and depth.id != 0
    ab = world_depth_params()
    p = LookFxParams(look_mask_target.texture, rect, vec4(f32(pw), f32(ph), f32(lw), f32(uw)), vec4(n.x, n.y, f32(mid), f32(w)), vec4(f32(0.75 * fade), f32(0.2 * fade), f32(0.22 * fade), f32(0.3 * fade)), f32(floor(age * 12.0)), if hidden: depth else: look_mask_target.texture, vec4(ab.x, ab.y, if hidden: 1.0 else: 0.0, 0.0), range)
    draw(look_fx_sh, look_fx_quad, p)
    __set_draw_state(st)
    zone_end()
    true
