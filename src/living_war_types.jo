# Strategic identities refer to existing registered hulls, people, routes and account balances.
use 'living_far_types.jo'
use 'living_mission_types.jo'
enum WarTask: patrol, convoy, blockade, occupy, withdraw, repair
enum WarContactState: pending, physical, resolved
struct WarUnit:
    id: int
    country: int
    vehicle = -1
    craft = -1
    account: int
    home: int
    strength = 0
    stock: FarStock
    order = -1
    last_pay_day = -1
    supplied_until = -1
    charter_until: int
    retired = false

struct WarOrder:
    id: int
    unit: int
    issuer: int
    task: WarTask
    target: int
    route: int[]
    leg = 0
    issued: int
    expires: int
    retry = 0
    blockade_reported = false
    arrived = false
    cancelled = false
    why: str

struct WarEvidence:
    news: int
    place: int
    aggressor: int
    affected: int
    state_backed: bool
    weight: int
    minute: int

struct WarContact:
    id: int
    a: int                           # WarUnit IDs, not a second hull
    b: int
    started: int
    resolves: int
    seed: u64
    probability: int                 # millionths, saved at actual contact
    state: WarContactState = .pending
    winner = -1
    pos: vec3
    reason: str
    engagement = -1
    shots: int[2]
    next_shot_tick: int[2]
    physical_seen = false

struct WarSurvivor:
    id: int
    unit: int
    vehicle = -1
    person = -1
    at: vec3
    country: int
    since: int
    deadline: int
    assigned_boat = -1
    pickup_tick = -1
    riding_vehicle = -1
    riding_craft = -1
    passengers: int[3]              # real rescued cohort members removed from their old crew
    rescued_total = 0
    rescuer = -1
    destination = -1
    resolved = false

struct WarState:
    version = 0
    missions: {int: WarMission}
    next_mission = 0
    units: WarUnit[]
    orders: {int: WarOrder}
    next_order = 0
    contacts: {int: WarContact}
    next_contact = 0
    evidence: {int: WarEvidence}
    heard: {str: bool}
    arrivals: int[]
    survivors: {int: WarSurvivor}
    next_survivor = 0
    rescue_receipts: WarRescueReceipt[]
    next_rescue_receipt = 0
    reputation: {str: int}             # citizen/country pair, independent of home/control
    rounds: WarShot[]
    round_serial = 0
    last_hour = -1
    last_day = -1
    dead_named: int[]
    outside_support = 0               # no implicit national reinforcements

# Persist only strategic-owned ordnance; no duplicate aircraft or crew in the physical layer.
struct WarShot:
    position: vec3
    velocity: vec3
    owner: int
    side: int
    damage: f64
    age: f64
    tracer: bool
    serial: int

struct WarRescueReceipt:
    id: int
    survivor: int
    actor: int
    place: int
    country: int
    people: int
    minute: int
