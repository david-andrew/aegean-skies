# The face points toward -z. The crown, temples and nape are one surface;
# only the tied lengths and the knot are separate pieces of the head mesh.

enum HairStyle: pinned, chignon, plait, waves, bob, twin_plaits

hair_style = (seed: int, age: int) -> HairStyle:
    if age >= 0 and age < 16: return .twin_plaits
    pick = (seed / 11) % 4
    if age >= 55: return if pick == 3: HairStyle.waves else: HairStyle.chignon
    match pick:
        0: if (seed / 44) % 2 == 0: HairStyle.pinned else: HairStyle.bob
        1: HairStyle.chignon
        2: HairStyle.plait
        _: HairStyle.waves

# Join two loops in the order front, right temple, nape, left temple. A single
# point closes a pole. Flat normals keep the small changes of plane visible.
_hair_strip = (v: mut Vertex3D[], upper: vec3[], lower: vec3[], col: vec4):
    n = max(upper.len(), lower.len())
    loop i in 0..n:
        j = (i + 1) % n
        a = upper[i % upper.len()]; b = upper[j % upper.len()]
        c = lower[i % lower.len()]; d = lower[j % lower.len()]
        if lower.len() > 1: _hair_triangle(v, a, d, c, col)
        if upper.len() > 1: _hair_triangle(v, a, b, d, col)

_hair_triangle = (v: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    normal = normalize(cross(b - a, c - a))
    loop p in [a, b, c]: v.push(Vertex3D(p, normal, vec2(0, 0), col))

# The front hem follows a side part above the brow. Behind the temples it
# goes all the way under the occiput. Hair and kerchief share that opening.
_hair_shell = (v: mut Vertex3D[], style: HairStyle, hat: int, col: vec4, skin: vec4 = vec4(0, 0, 0, 0), cloth: bool = false, torso_back: f64 = 0.25):
    tucked = hat != 0
    crown = if cloth: 0.207 else: if tucked: 0.186 else: 0.202
    radius = if cloth: 0.207 else: if tucked: 0.184 else: 0.193
    last = [vec3(if cloth: 0 else: -0.022, f32(1.7 + crown), 0.008)]
    segments = 12
    bands = if style == .waves and not cloth: 7 else: 4
    hairline: vec3[]
    cheek: vec3[]
    loop r in 1..bands + 1:
        t = f64(r) / f64(bands)
        ring: vec3[]
        loop j in 0..segments:
            a = TAU * f64(j) / f64(segments)
            side = sin(a); back = -cos(a)
            swept = smoothstep(-0.82, -0.08, back)
            neck = smoothstep(-0.04, 0.78, back)
            fringe = 0.085 * side + 0.09 * cos(2.0 * a + 0.8)
            # A forehead opening, a side lock at each ear and a lower nape.
            hem = if cloth: 0.98 + 1.08 * swept + 0.57 * neck else: 1.09 + fringe + 0.93 * swept + 0.74 * neck
            theta = t * hem
            if not cloth and r == bands:
                # Hair and face meet on this loop, including at the temples.
                # Only the face below the hairline is built.
                hairline.push(vec3(f32(side * 0.17 * sin(hem)), f32(1.70 + 0.17 * cos(hem)), f32(back * 0.17 * sin(hem))))
                jaw_angle = mix(hem, PI, 0.5)
                cheek.push(vec3(f32(side * 0.17 * sin(jaw_angle)), f32(1.70 + 0.17 * cos(jaw_angle)), f32(back * 0.17 * sin(jaw_angle))))
            x = side * radius * sin(theta) - 0.022 * (1.0 - t)
            z = back * (radius + 0.003) * sin(theta) + 0.008
            y = 1.70 + crown * cos(theta)
            if not cloth and style == .chignon and hat != 5:
                # Pull the temples back and narrow the gathered hair above the knot.
                gather = smoothstep(0.43, 1.0, t) * swept
                x *= 1.0 - 0.28 * gather
                z += 0.034 * gather
                y += 0.038 * gather * neck
            if not cloth and style == .bob:
                # A blunt turn under at the nape, angled down toward each jaw.
                fall = smoothstep(0.55, 1.0, t) * swept
                x = mix(x, side * 0.166, fall)
                z = mix(z, back * 0.142 + 0.022, fall)
                y = mix(y, 1.555 + 0.053 * neck - 0.008 * side, fall)
            if not cloth and style == .waves:
                # Three changes of direction between temple and shoulder. Their
                # crests cross the back obliquely and turn up again at the ends.
                fall = smoothstep(0.40, 0.88, t) * swept
                phase = (t - 0.45) * 22.0 + 1.65 * side + 0.55 * cos(3.0 * a)
                roll = cos(phase)
                width = 0.217 + 0.022 * roll - 0.018 * smoothstep(0.84, 1.0, t)
                across_back = smoothstep(-0.05, 0.38, back)
                x = mix(x, side * width + 0.016 * sin(phase), fall)
                z = mix(z, back * (0.196 + 0.022 * roll) + 0.026, fall)
                # At the shoulder the torso becomes a box. Lay the entire back
                # lock over that plane so no middle section disappears into it.
                clearance = smoothstep(0.56, 0.81, t) * across_back
                z = mix(z, torso_back + 0.039 + 0.010 * roll, clearance)
                hem_y = 1.478 - 0.063 * across_back + 0.014 * sin(phase) + 0.014 * cos(3.0 * a + 0.8)
                y = mix(y, mix(1.75, hem_y, (t - 0.43) / 0.57), fall)
            ring.push(vec3(f32(x), f32(y), f32(z)))
        if style == .waves and not cloth and r >= 4:
            loop j in 0..segments:
                k = (j + 1) % segments
                a = TAU * (f64(j) + 0.5) / f64(segments)
                side = sin(a); back = -cos(a)
                phase = (t - 0.5 / f64(bands) - 0.45) * 22.0 + 1.65 * side + 0.55 * cos(3 * a)
                factor = 1.0 + smoothstep(-0.74, 0.0, back) * (0.21 * cos(phase) - 0.04)
                shade = vec4(col.xyz * f32(factor), col.w)
                _hair_triangle(v, last[j], ring[k], ring[j], shade)
                _hair_triangle(v, last[j], last[k], ring[k], shade)
        else: _hair_strip(v, last, ring, col)
        last = ring
    # Turn the hem under into the head or the collar. Seen from below, this
    # gives the bob and the waves a solid edge too.
    if cloth:
        _hair_strip(v, last, [vec3(0, 1.60, 0.055)], col)
    else:
        _hair_strip(v, last, hairline, col)
        first = v.len()
        _hair_strip(v, hairline, cheek, skin)
        _hair_strip(v, cheek, [vec3(0, 1.53, 0)], skin)
        # Match the shared figures' spherical face normals on the exposed skin.
        loop i in first..v.len(): v[i].normal = normalize(v[i].pos - vec3(0, 1.70, 0))

# A tapering rope of five-sided sections; successive half turns make the
# alternating locks meet at the tips. The lower plait lies on the upper back.
_hair_plait = (v: mut Vertex3D[], x: f64, long: bool, back: f64, col: vec4, ribbon: vec4):
    n = if long: 8 else: 5
    prev = [vec3(f32(x), 1.655, 0.135)]
    loop i in 0..n + 2:
        t = f64(i) / f64(n + 1)
        half = (if long: 0.059 else: 0.044) * (1.0 - 0.71 * t)
        y = 1.635 - t * (if long: 0.57 else: 0.40)
        z = mix(0.153, back + 0.011, smoothstep(0.02, 0.31, t))
        cx = x + (if i % 2 == 0: -0.23 else: 0.23) * half
        ring: vec3[]
        loop j in 0..5:
            a = TAU * f64(j) / 5.0 + (if i % 2 == 0: 0.29 else: -0.29)
            ring.push(vec3(f32(cx + sin(a) * half), f32(y), f32(z - cos(a) * half * 0.79)))
        _hair_strip(v, prev, ring, if i == n: ribbon else: col)
        prev = ring
    _hair_strip(v, prev, [vec3(f32(x), f32(if long: 1.026 else: 1.205), f32(back + 0.013))], col)

# A low coil viewed along the back of the head. The offset inner whorl and
# folded edge catch light from behind as well as in profile.
_chignon = (v: mut Vertex3D[], col: vec4):
    root = [vec3(0, 1.58, 0.125)]
    widths = [0.087, 0.128, 0.102, 0.062, 0.030]
    heights = [0.047, 0.080, 0.067, 0.037, 0.019]
    depths = [0.155, 0.203, 0.251, 0.239, 0.263]
    tones = [0.72, 0.80, 1.14, 0.84, 1.12]
    loop r in 0..widths.len():
        ring: vec3[]
        loop j in 0..10:
            a = -TAU * f64(j) / 10.0 + 0.26 * f64(r)
            x = sin(a) * widths[r] - 0.003 * f64(r)
            y = cos(a) * heights[r] + 1.552 + 0.008 * sin(2.0 * a)
            ring.push(vec3(f32(x), f32(y), f32(depths[r] + 0.008 * sin(a))))
        _hair_strip(v, root, ring, vec4(col.xyz * f32(tones[r]), col.w))
        root = ring
    _hair_strip(v, root, [vec3(-0.010, 1.55, 0.253)], vec4(col.xyz * 0.76, col.w))

add_womens_head = (v: mut Vertex3D[], col: vec4, skin: vec4, style: HairStyle, hat: int, back: f64):
    _hair_shell(v, style, hat, col, skin, torso_back = back)
    if style == .chignon and hat != 5: _chignon(v, col)
    else if style == .pinned or style == .chignon:
        high = style == .pinned and hat == 0
        y = if high: 1.78 else: 1.58
        add_sphere(v, vec3(0, 0, 0), 1.0, col, 8, 3, translation(vec3(0, f32(y), if high: 0.171 else: 0.151)) * scaling(vec3(0.107, 0.074, 0.084)))
    else if style == .plait: _hair_plait(v, 0.0, true, back, col, rgb(0.45, 0.19, 0.16))
    else if style == .twin_plaits:
        loop side in [-1.0, 1.0]: _hair_plait(v, side * 0.103, false, back, col, rgb(0.62, 0.24, 0.22))

_hat_ring = (radius: f64, y: f64, tilt: f64, n: int, peak: f64 = 0.0) -> vec3[]:
    ring: vec3[]
    loop j in 0..n:
        a = TAU * f64(j) / f64(n)
        z = -cos(a) * (radius + peak * pow(max(cos(a), 0.0), 3.0))
        ring.push(vec3(f32(sin(a) * radius), f32(y + tilt * z), f32(z + 0.008)))
    ring

add_womens_hat = (v: mut Vertex3D[], style: HairStyle, kind: int, hat: vec4, band: vec4):
    if kind == 0: return
    if kind == 5:
        _hair_shell(v, style, kind, hat, cloth = true)
        # A folded triangle tied above the nape. The knot sits on the cloth,
        # leaving the cheek, fringe and the low dressing visible beneath it.
        add_sphere(v, vec3(0, 0, 0), 1.0, hat, 5, 2, translation(vec3(0.025, 1.608, 0.186)) * scaling(vec3(0.048, 0.033, 0.045)))
        loop side in [-1.0, 1.0]:
            a = vec3(0.025, 1.62, 0.19)
            b = vec3(f32(0.025 + 0.052 * side), 1.585, 0.217)
            c = vec3(f32(0.025 + 0.083 * side), f32(1.49 + side * 0.017), 0.218)
            _hair_triangle(v, a, b, c, hat); _hair_triangle(v, c, b, a, hat)
        return
    # All crowns share a seat on the compressed top of the coiffure. Wider
    # styles lift it slightly; the front of every brim clears the eyes.
    seat = 1.795 + (if style == .waves or style == .bob: 0.009 else: 0.0)
    tilt = if kind == 7 or kind == 1: 0.095 else: 0.045
    n = if kind == 2 or kind == 7 or kind == 8: 10 else: 8
    height = if kind == 4 or kind == 6: 0.147 else: if kind == 1: 0.105 else: 0.127
    r = if kind == 7: 0.192 else: 0.183
    rounded = kind == 1 or kind == 3 or kind == 7 or kind == 9
    top = _hat_ring(if rounded: 0.078 else: 0.148, seat + height, tilt, n)
    _hair_strip(v, [vec3(0, f32(seat + height + (if rounded: 0.012 else: 0)), 0.008)], top, hat)
    crown = _hat_ring(if rounded: r * 0.87 else: r * 0.98, seat + (if rounded: height * 0.74 else: 0.041), tilt, n)
    _hair_strip(v, top, crown, hat)
    tape = _hat_ring(r, seat + 0.019, tilt, n)
    _hair_strip(v, crown, tape, hat)
    seat_ring = _hat_ring(r + 0.002, seat, tilt, n)
    _hair_strip(v, tape, seat_ring, if band.w > 0 and kind != 3: band else: hat)
    if kind == 3:
        # The helmet has goggles over its brow, with a short leather flap at each ear.
        glass = rgb(0.51, 0.64, 0.66)
        loop side in [-1.0, 1.0]:
            add_sphere(v, vec3(0, 0, 0), 1.0, glass, 6, 2, translation(vec3(f32(side * 0.065), 1.826, -0.154)) * scaling(vec3(0.047, 0.032, 0.030)))
            add_box(v, vec3(f32(side * 0.177), 1.742, 0.017), vec3(0.026, 0.106, 0.082), hat)
    else:
        rim = match kind:
            2: 0.270
            6: 0.252
            7: 0.217
            8: 0.314
            9: 0.258
            _: r + 0.004
        peak = if kind == 1 or kind == 4: 0.074 else: 0.0
        y = seat - (if kind == 7: 0.018 else: 0.0)
        outer = _hat_ring(rim, y, tilt, n, peak)
        edge = _hat_ring(rim - 0.002, y - 0.009, tilt, n, peak)
        _hair_strip(v, seat_ring, outer, hat)
        _hair_strip(v, outer, edge, hat)
        _hair_strip(v, edge, _hat_ring(r - 0.006, seat - 0.008, tilt, n), hat)

# A rectangle with a slight bevel on each corner retains the silhouette of
# the crowd's original box head from both straight-on and diagonal views.
_crowd_hair_ring = (width: f64, front: f64, rear: f64, brow: f64, ear: f64, nape: f64) -> vec3[]:
    bevel = 0.009
    [vec3(f32(-width + bevel), f32(brow), f32(front)), vec3(f32(width - bevel), f32(brow), f32(front)),
     vec3(f32(width), f32(ear), f32(front + bevel)), vec3(f32(width), f32(nape), f32(rear - bevel)),
     vec3(f32(width - bevel), f32(nape), f32(rear)), vec3(f32(-width + bevel), f32(nape), f32(rear)),
     vec3(f32(-width), f32(nape), f32(rear - bevel)), vec3(f32(-width), f32(ear), f32(front + bevel))]

add_ambient_womens_head = (v: mut Vertex3D[], hip: f64, skin: vec4, hat: vec4, kerchief: bool):
    hair = rgb(0.20, 0.14, 0.10)
    # Exact stock face volume. Only the hairline opens around the face.
    add_box(v, vec3(0, f32(hip + 0.8), -0.01), vec3(0.2, 0.24, 0.22), skin)
    crown = _crowd_hair_ring(0.105, -0.122, 0.12, hip + 0.935, hip + 0.935, hip + 0.935)
    hem = _crowd_hair_ring(0.105, -0.123, 0.12, hip + 0.881, hip + 0.792, hip + 0.685)
    if not kerchief:
        if hat.w == 0: _hair_strip(v, [vec3(0, f32(hip + 0.935), 0)], crown, hair)
        _hair_strip(v, crown, hem, hair)
        return
    # Only a narrow fringe shows at the opening. The cloth supplies the crown.
    fringe = _crowd_hair_ring(0.104, -0.122, 0.115, hip + 0.895, hip + 0.806, hip + 0.72)
    _hair_triangle(v, fringe[0], hem[1], hem[0], hair)
    _hair_triangle(v, fringe[0], fringe[1], hem[1], hair)
    # The gathered cloth reveals hair below its back corners.
    loop j in 2..7:
        k = j + 1
        _hair_triangle(v, crown[j], crown[k], hem[k], hair)
        _hair_triangle(v, crown[j], hem[k], hem[j], hair)
    # The old kerchief was 0.24 wide, 0.28 tall and 0.24 deep. Keep its
    # broad crown, turn the cheek folds back, and tie the two ends at the nape.
    top = _crowd_hair_ring(0.110, -0.127, 0.134, hip + 0.97, hip + 0.97, hip + 0.97)
    fold = _crowd_hair_ring(0.120, -0.126, 0.14, hip + 0.905, hip + 0.88, hip + 0.91)
    edge = _crowd_hair_ring(0.116, -0.126, 0.13, hip + 0.894, hip + 0.766, hip + 0.69)
    # Bias the folds and take in the back edge toward the tied corner.
    top[0].y -= 0.014; top[7].y -= 0.014
    fold[0].y += 0.008; fold[1].y -= 0.006
    loop j in 3..7:
        edge[j].x *= 0.32
        edge[j].z = 0.149
        edge[j].y = f32(hip + 0.728)
    charcoal = vec4(hat.xyz * 1.48, 1)
    _hair_strip(v, [vec3(-0.016, f32(hip + 0.97), 0.02)], top, hat)
    _hair_strip(v, top, fold, hat)
    loop j in 0..fold.len():
        k = (j + 1) % fold.len()
        _hair_triangle(v, fold[j], fold[k], edge[k], if j % 3 == 0: charcoal else: hat)
        _hair_triangle(v, fold[j], edge[k], edge[j], charcoal)
    knot = vec3(0.022, f32(hip + 0.729), 0.15)
    add_sphere(v, vec3(0, 0, 0), 1, charcoal, 5, 2, translation(knot) * scaling(vec3(0.047, 0.033, 0.033)))
    loop side in [-1.0, 1.0]:
        b = knot + vec3(f32(side * 0.050), -0.023, 0.018)
        ridge = knot + vec3(f32(side * 0.034), -0.046, 0.029)
        tip = knot + vec3(f32(side * 0.075), f32(-0.099 + side * 0.014), 0.021)
        _hair_triangle(v, knot, b, ridge, hat); _hair_triangle(v, ridge, b, knot, hat)
        _hair_triangle(v, ridge, b, tip, charcoal); _hair_triangle(v, tip, b, ridge, charcoal)
