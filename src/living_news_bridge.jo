# Only public accounts actually received at one of the detailed markets cross the tier.
# Shared event identity/date survives the conversion; no far town reads the global core journal.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_news.jo'
use 'living_news.jo'

bridge_core_news = (w: mut World):
    if not w.far.populated: return
    loop place in 0..w.places.len():
        if not (place in w.far.districts): continue
        items=w.places[place].news
        items.sort((n: NewsItem): n.event)
        loop n in items:
            if n.private_fact or n.confidence<300 or w.minute-n.occurred_minute>=10080 or n.event<0: continue
            old=w.far.core_reports.get(n.event,FarReport(-1,0,0,place,"",""))
            if old.id>=0:
                r=old; r.learned_minute=w.minute
                r.confidence=min(r.confidence,n.confidence); r.hops=max(r.hops,n.hops)
                far_store_report(w,place,r)
                continue
            text=news_sentence(w,n)
            id=far_local_news(w,place,"core_{n.kind}",text,actor=n.reason.actor,other=n.reason.counterparty,country=-1,severity=n.severity)
            if id<0: continue
            r=far_news_snapshot(w.far.news[id],w.minute)
            r.occurred_minute=n.occurred_minute; r.source_person=n.source_person
            r.confidence=n.confidence; r.hops=n.hops
            w.far.news[id].minute=n.occurred_minute
            w.far.districts[place].reports=[loop item in w.far.districts[place].reports: if item.id!=id: item]
            far_store_report(w,place,r); w.far.core_reports[n.event]=r
    old=w.far.core_reports.keys(); old.sort()
    loop event in old:
        r=w.far.core_reports[event]
        if w.minute-r.occurred_minute>=10080 or w.far.core_reports.len()>512: w.far.core_reports.remove(event)
    # Existing detailed people learn these accounts only when really at the counter.
    loop person in 0..core_person_count(w):
        place=person_place(w,person)
        if place>=0 and place in w.far.districts: far_hear_counter(w,person,place)
