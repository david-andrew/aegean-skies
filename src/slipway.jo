# Neravessa's slipway launch: the aircraft waits on a timber cradle on the greased ways inside
# the workshop, engine ticking over; the chocks come away, it slides down into the canal and
# floats off the cradle with a splash; the yard's line and its own water rudder swing it round to
# the canal's heading, and the pilot has it. The cradle stays at the foot of the ways.
use 'canal_geometry.jo'
use 'river_data.jo'
use 'flight.jo'
use 'flight_v2.jo'
use 'pilot.jo'
use 'objects.jo'
use 'world_point.jo'
use 'world_particles.jo'
use 'render_space.jo'
use 'damage.jo'
use 'flight_feedback.jo'

const SLIP_START = 5.0              # the cradle's place in the shop before launch (wholly on the ways)
const SLIP_CRADLE = 0.64            # the cradle's chocks above the ways
const SLIP_HOLD = 0.9               # seconds on the chocks, engine running, before she goes
const SLIP_PULL = 1.45              # m/s^2 down the greased ways
const SLIP_SETTLE_MAX = 5.5         # seconds afloat at most before the pilot has her

enum SlipPhase: waiting, sliding, settling, done
struct SlipLaunch:
    active = false
    phase: SlipPhase = .waiting
    clock = 0.0
    z = SLIP_START                  # the cradle along the ways
    speed = 0.0
    settle = 0.0
    entered = false                 # the floats have met the water
    splash = false                  # they met it in this step (for the burst)

# The cradle's place for drawing; the normal world shows it waiting in the shop.
slip_cradle_z = SLIP_START

slip_heading = () -> f64:
    d = canal_world_dir(vec3(0,0,1),slip_frame())
    atan2(f64(d.x),-f64(d.z))

# The aircraft on the cradle at z: nose down the ways, floats on the chocks.
slip_pose = (f: mut Flyer, z: f64, speed: f64):
    pitch = -atan(slip_slope())
    q = quat_euler(pitch,-slip_heading(),0)
    base = slip_point(z)+quat_rotate(q,vec3(0,f32(SLIP_CRADLE+f.spec.float_height),0))
    f.state.position = base; f.state.precise_ready = false; f.state.published = base
    f.state.orientation = q
    f.state.velocity = quat_rotate(q,vec3(0,0,-f32(speed)))
    f.state.angular_velocity = vec3(0,0,0)
    f.state.on_water = false; f.state.moored = false; f.state.water_age = 0

start_slip_launch = (f: mut Flyer) -> SlipLaunch:
    init_canal_geometry()
    l = SlipLaunch(active=true)
    slip_pose(f,l.z,0.0)
    f.throttle = 0.22; f.state.throttle = 0.22
    f.aim_heading = slip_heading(); f.aim_climb = 0
    global slip_cradle_z
    slip_cradle_z = l.z
    l

# The yard hands over a steady aircraft facing down the canal: idle power, water rudder.
_settle_controls = (f: Flyer) -> Controls:
    err = angle_delta(canal_heading,heading(f.state))
    speed = f64(length(f.state.velocity))
    Controls(throttle=0.24,yaw=clamp(err*2.4,-1.0,1.0),water_brake=if speed > 3.5: 0.7 else: 0.0,assist=0.0)

# One step; true when the pilot has it.
step_slip_launch = (l: mut SlipLaunch, f: mut Flyer, dt: f64, t: f64) -> bool:
    global slip_cradle_z
    l.splash = false
    if not l.active: return true
    l.clock += dt
    if l.phase == .waiting or l.phase == .sliding:
        if l.phase == .waiting and l.clock >= SLIP_HOLD: l.phase = .sliding
        if l.phase == .sliding:
            l.speed += SLIP_PULL*dt
            l.z += l.speed*dt
        slip_cradle_z = min(l.z,SLIP_FOOT)
        if l.z >= SLIP_FOOT:
            # (off the cradle's end: she keeps her way, and the water takes her)
            slip_pose(f,SLIP_FOOT,l.speed)
            l.phase = .settling
        else:
            slip_pose(f,l.z,l.speed)
            f.state.time += dt
        f.prop_angle += dt*prop_rotation_speed(f.state,0.0)
        f.sea_t = t
        feel(f,dt)
        if l.phase != .settling: return false
    e = flight_env(t,f.state.position)
    step(f.spec,f.state,_settle_controls(f),e,dt)
    f.prop_angle += dt*prop_rotation_speed(f.state,f.feedback.speed)
    f.sea_t = t
    feel(f,dt,e.wind)
    if f.state.on_water and not l.entered: l.entered = true; l.splash = true
    if l.entered: l.settle += dt
    aligned = abs(angle_delta(canal_heading,heading(f.state))) < 0.3 and f64(length(f.state.velocity)) < 6.0
    if (l.settle > 1.4 and aligned) or l.settle > SLIP_SETTLE_MAX:
        l.phase = .done; l.active = false
        f.aim_heading = heading(f.state); f.aim_climb = 0; f.mouse_mode = false
        f.last = Controls(); f.throttle = 0.22
        return true
    false

# The floats' first touch: a burst of spray each side, under the aircraft's own splash bodies.
slip_splash = (f: Flyer, ps: mut WorldParticles):
    loop side in [-1.0,1.0]:
        p = craft_offset(f.state,quat_rotate(f.state.orientation,vec3(f32(side*1.7),-f32(f.spec.float_height),-1.0)))
        emit(ps,p,70,7.0,rgba(0.97,0.99,1.0,0.95),1.6,1.0,0.45,normalize(vec3(0,1,0)+quat_rotate(f.state.orientation,vec3(f32(side*0.6),0,0))))
        emit(ps,p,30,4.0,rgba(0.93,0.97,1.0,0.85),1.2,0.7,1.2,vec3(0,1,0))

# The cradle: two runners on the ways, cross beams, chocks shaped for a pair of floats.
slip_cradle_mesh = Mesh()
slip_cradle_ready = false
_slip_cradle_vertices = () -> Vertex3D[]:
    vs: Vertex3D[]
    timber = rgb(0.44,0.31,0.18); dark = rgb(0.27,0.19,0.11); iron = rgb(0.16,0.17,0.16)
    loop x in [-1.7,1.7]:
        add_box(vs,vec3(f32(x),0.36,0),vec3(0.34,0.22,6.2),dark)
        loop z in [-1.6,1.4]:
            add_box(vs,vec3(f32(x),0.58,f32(z)),vec3(0.95,0.14,0.42),timber)
            add_box(vs,vec3(f32(x*1.32),0.66,f32(z)),vec3(0.16,0.22,0.42),timber)
            add_box(vs,vec3(f32(x*0.68),0.66,f32(z)),vec3(0.16,0.22,0.42),timber)
    loop z in [-2.6,-0.1,2.4]:
        add_box(vs,vec3(0,0.52,f32(z)),vec3(4.2,0.16,0.3),timber)
    # (the haul ring the yard's line was shackled to)
    add_box(vs,vec3(0,0.42,3.25),vec3(0.5,0.12,0.12),iron)
    vs

draw_slip_cradle = (L: Light, t: f64):
    global slip_cradle_mesh,slip_cradle_ready
    if canal_solids.len() == 0: return
    at = slip_point(slip_cradle_z)
    if length(scene_camera()-at) > 900: return
    if not slip_cradle_ready:
        slip_cradle_mesh = mesh(_slip_cradle_vertices()); slip_cradle_ready = true
    turn = rotation_y(-slip_frame())*rotation_x(atan(slip_slope()))
    draw(obj_sh,slip_cradle_mesh,obj_params(L,t,turn,anchor=world_point(at)))

# The canal run's steering, used by the scenario tests and capture runs (never by play): follow the
# canal's stations until 45 m up, rudder on the water, as the original quay-side departure did, along
# the cut's line beside the lagoon's open water, where she lifts off (a turn out onto it at that speed
# on the water would dig a float in). The cut ends there, so then she turns and flies its line back
# over the town and its posts at the run's height, a pass over the irregulars who fired at her.
canal_run_controls = (f: Flyer, plan: mut FlightPlan, e: FlightEnv) -> Controls:
    if f.state.position.y < canal_launch.y+45.0:
        # (pursuing a point on the centre line a little ahead, further the faster: a pilot holding
        # the middle of the cut, as the bridges ask)
        target = canal_ahead(f.state.position,canal_lookahead(f64(length(f.state.velocity))))
        direction = normalize(vec3(target.x-f.state.position.x,0,target.y-f.state.position.z))
        plan.takeoff_heading = atan2(f64(direction.x),-f64(direction.z))
        plan.target = f.state.position+direction*5000.0
    else:
        # (a point 600 m back along the line: its bends flown wide)
        back = canal_behind(f.state.position,600.0)
        to = vec2(back.x-f.state.position.x,back.y-f.state.position.z)
        if length(to) > 1.0:
            line = normalize(to)
            plan.target = f.state.position+vec3(line.x,0,line.y)*5000.0
            # (on flight model v2 she is flown round by hand, as hard as the wing holds at her speed:
            # the autopilot's eased course would carry her out of the posts' reach before she was back)
            if fdm2_active(f.spec):
                climb = clamp((plan.altitude-f64(f.state.position.y))*0.005,-0.18,0.24)
                c = steer(f.spec,f.state,normalize(vec3(line.x,f32(climb),line.y)),vec3(0,0,0),true)
                c.roll = fdm2_bank_limit(f.spec,f.state,c.roll)
                c.pitch = fdm2_autopilot_pitch(f.spec,f.state,c.pitch,climb)
                c.throttle = 1.0
                return c
    controls = autopilot(f.spec,f.state,plan,e)
    if f.state.on_water:
        velocity_heading = atan2(f64(f.state.velocity.x),-f64(f.state.velocity.z))
        controls.yaw = clamp(angle_delta(plan.takeoff_heading,heading(f.state))*4.0+angle_delta(plan.takeoff_heading,velocity_heading)*2.0,-1.0,1.0)
    controls

# The point `back` metres back along the through-channel's centre line from the one nearest p.
canal_behind = (p: vec3, back: f64) -> vec2:
    k = canal_station(p)
    a = RIVER_NODES[k].xy; d = RIVER_NODES[k+1].xy-a
    at = a+d*clamp(dot(p.xz-a,d)/max(dot(d,d),0.001),0.0,1.0)
    left = back
    loop k >= CANAL_BEGIN:
        prev = RIVER_NODES[k].xy
        gap = f64(length(prev-at))
        if left <= gap and gap > 0.001: return at+normalize(prev-at)*f32(left)
        left -= gap; at = prev; k -= 1
    at

canal_run_plan = () -> FlightPlan:
    FlightPlan(takeoff_heading=canal_heading,target=canal_launch+heading_vector(canal_heading)*5000.0,altitude=f64(canal_launch.y)+180.0)
