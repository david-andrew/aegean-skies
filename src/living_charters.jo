use 'living_guard.jo'
use 'living_transaction.jo'
# Business charters may supply real fuel in kind. Reward escrow is never spent before arrival.
use 'living_types.jo'
use 'living_cargo.jo'
use 'living_money.jo'
use 'living_travel.jo'

charter_fuel_needed = (w: World, job: int, actor: int) -> int:
    c = w.people[actor].craft; origin = w.jobs[job].origin; dest = w.jobs[job].destination
    route = route_geometry(w,origin,dest,w.aircraft[c].pose.pos)
    total = route_fuel(route,w.aircraft[c].kind)
    home = w.people[actor].home
    if home != dest:
        back = route_geometry(w,dest,home,w.harbors[dest].buoy)
        total += route_fuel(back,w.aircraft[c].kind)
    max(0,(total+max(5000,total/5)-w.aircraft[c].fuel_ml+9)/10)

charter_feasible = (w: World, job: int, actor: int) -> bool:
    if not w.jobs[job].wet_charter or not travel_ready(w,actor,w.jobs[job].destination): return false
    c = w.people[actor].craft; place = w.jobs[job].origin
    milli = charter_fuel_needed(w,job,actor)
    if w.aircraft[c].fuel_ml+milli*10 > AIRFRAMES[int(w.aircraft[c].kind)].tank_ml: return false
    if available(w.places[place].market.inventory,4)+w.jobs[job].charter_reserved_milli < milli: return false
    payer = w.jobs[job].charter_payer
    if not account_valid(w,payer): return false
    if payer == w.places[place].market.account: return true
    key = "charter:{payer}:{place}"
    bill = (milli*w.places[place].market.price_cents[4]+w.quote_residual.get(key,0))/1000
    tax = if place == 5 or bill == 0: 0 else: max(1,bill*2/100)
    w.accounts[payer].cents >= bill+tax

_guarded_supply_charter_fuel = (w: mut World, job: int, actor: int) -> bool:
    if not charter_feasible(w,job,actor): return false
    c = w.people[actor].craft; place = w.jobs[job].origin
    milli = charter_fuel_needed(w,job,actor)
    own_reserve = w.jobs[job].charter_reserved_milli
    if own_reserve > 0:
        if not (release(w.places[place].market.inventory,4,own_reserve)):
            living_fault("living_charters.supply_charter_fuel.0",guard_context(w)+" job={job} actor={actor}")
            return false
        w.jobs[job].charter_reserved_milli = 0
    if milli == 0: return true
    payer = w.jobs[job].charter_payer; market = w.places[place].market.account
    bill = milli*w.places[place].market.price_cents[4]/1000
    if payer != market:
        key = "charter:{payer}:{place}"
        raw = milli*w.places[place].market.price_cents[4]+w.quote_residual.get(key,0)
        bill = raw/1000
        tax = if place == 5 or bill == 0: 0 else: max(1,bill*2/100)
        if bill > 0:
            if not (transfer(w,payer,market,bill,.fuel,job)):
                living_fault("living_charters.supply_charter_fuel.1",guard_context(w)+" job={job} actor={actor}")
                return false
        if tax > 0:
            if not (transfer(w,payer,w.factions[0].account,tax,.fine,job)):
                living_fault("living_charters.supply_charter_fuel.2",guard_context(w)+" job={job} actor={actor}")
                return false
        w.quote_residual[key] = raw%1000
    # A market's own operating stock draw has no cash sale to itself or artificial income.
    cargo_consume(w,.market,place,4,milli)
    w.places[place].market.inventory.qty[4] -= milli
    w.aircraft[c].fuel_ml += milli*10
    w.aircraft[c].revision += 1
    w.jobs[job].prepaid_fuel_ml += milli*10
    w.jobs[job].prepaid_fuel_cents += bill
    true


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
supply_charter_fuel = (w: mut World, job: int, actor: int) -> bool:
    if guard_blocked(): return false
    scope = guard_begin(w)
    result = _guarded_supply_charter_fuel(w,job,actor)
    failed = guard_failed(scope)
    guard_finish(w,scope)
    if failed: false else: result
