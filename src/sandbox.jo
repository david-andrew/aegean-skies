# The sandbox switches (docs/DESIGN.md, "Sandbox settings"): playing more freely, each a separate
# switch, each off unless the player turns it on (the Settings page, kept with the options). The
# simulation runs as it always does; a switch lifts only the player's own constraint, and nothing
# of anyone else's (their money, cargo or wear) is changed by one.
#
# Whoever charges the player for something asks here whether to, by the one switch that covers it:
#   sandbox.any_aircraft        any aircraft at any time (the pause menu's Aircraft page)
#   sandbox.unlimited_money     the purse never runs out (sandbox_purse)
#   sandbox.no_damage           the player's aircraft takes no damage
#   sandbox.no_fuel_use         her engine burns no fuel
#   sandbox.endless_ammunition  her guns never run dry

struct Sandbox:
    any_aircraft = false
    unlimited_money = false
    no_damage = false
    no_fuel_use = false
    endless_ammunition = false

sandbox = Sandbox()

set_sandbox = (s: Sandbox):
    global sandbox
    sandbox = s

# Any switch on: the game is being played as a sandbox.
sandbox_active = (s: Sandbox) -> bool:
    s.any_aircraft or s.unlimited_money or s.no_damage or s.no_fuel_use or s.endless_ammunition

# ---------------- unlimited money ----------------
#
# The purse is held at a level it never falls below: what is spent is made good from outside the
# world, so everyone paid is really paid and the books still balance (the outside's money is
# entered as such: src/sandbox_world.jo). What the player earns raises the level. Switched off,
# what was lent is taken back, and the purse is what was really earned: what it held before, and
# the earnings since; nothing spent meanwhile is charged.

const SANDBOX_PURSE_CENTS = 9999900     # ¤99,999: the least the purse is held at

# What the save keeps of it (GameSession.purse), so a game saved with the switch on and loaded
# with it off, or the other way, comes to the right purse.
struct PurseHold:
    held = -1                       # the level the purse is held at (-1: not held)
    lent = 0                        # how much of that level is the outside's, not the player's

# The purse `cents`, a frame on: what it should be now, and the hold. (The difference is the
# outside's to pay in or take back.)
sandbox_purse = (cents: int, h: PurseHold, on: bool) -> (int, PurseHold):
    if on:
        if h.held < 0:
            level = max(cents, SANDBOX_PURSE_CENTS)
            return (level, PurseHold(level, level - cents))
        # (earned since: the level rises with it; spent: made good)
        if cents > h.held: return (cents, PurseHold(cents, h.lent))
        return (h.held, h)
    if h.held < 0: return (cents, h)
    (max(0, max(cents, h.held) - h.lent), PurseHold())

# The purse that is really the player's own while it is held: the level less what was lent.
sandbox_own_cents = (cents: int, h: PurseHold) -> int:
    if h.held < 0: cents else: max(0, max(cents, h.held) - h.lent)

# ---------------- no fuel use ----------------

# The tank after a step of flying that left `after` in it, from `before`: nothing burnt with the
# switch on. (Fuel bought, given away or drained otherwise is not a step's burning, and stands.)
sandbox_fuel = (before: f64, after: f64, on: bool) -> f64:
    if on and after < before: before else: after
