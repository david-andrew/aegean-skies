# The Ierax: a Kalyran seaplane tender, a converted steamer of the 1920s (as several navies had
# them), anchored as a depot ship in the bight on the west coast of the island west of the strait,
# 25 km from it, in the lee of the island's southern cape. She carries fuel, ammunition and
# mechanics, a derrick aft for hoisting seaplanes in and out, and her seaplanes lie alongside on
# booms swung out from her seaward (port) side, the rest astern of her on a trot of buoys.
# She is the strait flight's forward base (combat's BattleHome for Kalyra: landing off her to
# seaward, moored in turn along the booms), and a place anyone may come to: moor alongside, take
# on fuel, be hoisted aboard and have her mechanics see to the aircraft, and her launch answers a
# call for help near her. Her place, her moorings and the hoist's path: aegean.jo acts.
use 'world_point.jo'
use 'aircraft_catalog.jo'
use 'flight.jo'
use 'vessel_types.jo'
use 'combat.jo'

const TENDER_ID = 680000001
TENDER_AT = vec3(112300,0,-71000)
const TENDER_YAW = PI                   # bow to the north, into the meltemi
const TENDER_NAME = "the Ierax"
const TENDER_BOOM = 24.0                # a boom's reach out from her side (m)
const TENDER_STEP = 22.0                # between moorings along the line
const TENDER_SLOTS = 10                 # four on the booms, six astern on buoys
const TENDER_REACH = 160.0              # near enough to her to be "at the tender"

tender_forward = () -> vec3: vec3(f32(sin(TENDER_YAW)),0,f32(cos(TENDER_YAW)))
# (the vessel models' convention: bow +z, port +x)
tender_port = () -> vec3: vec3(f32(cos(TENDER_YAW)),0,f32(-sin(TENDER_YAW)))
tender_local = (l: vec3) -> vec3: TENDER_AT+tender_port()*l.x+vec3(0,l.y,0)+tender_forward()*l.z

tender_vessel = () -> Vessel:
    v = Vessel(id = TENDER_ID, kind = .seaplane_tender, owner = 0, side = 1, position = TENDER_AT, yaw = TENDER_YAW, status = .anchored, external = true)
    v.precise = world_point(TENDER_AT); v.published = TENDER_AT; v.precise_ready = true
    v

# Mooring k along her seaward side (0 forward), at the boom ends and then astern on buoys: the
# water point (y 0).
tender_slot = (k: int) -> vec3:
    s = vessel_spec(.seaplane_tender)
    tender_local(vec3(f32(s.beam*0.5+TENDER_BOOM),0,f32(30.0-TENDER_STEP*f64(k))))

# Whether mooring k is on a boom (else a buoy).
tender_on_boom = (k: int) -> bool: k < 4

# The strait flight's base: the landing to seaward of her (west), the moorings along her side.
tender_home = (side: int) -> BattleHome:
    h = BattleHome(side,TENDER_AT+tender_port()*900.0,atan2(-f64(tender_port().x),f64(tender_port().z)),tender_slot(0),tender_slot(1)-tender_slot(0),place = -1,centre = TENDER_AT,out = tender_port())
    h.name = TENDER_NAME
    h.afloat = true
    # (the island she lies under has a ridge of 1,200 m between her and the strait: the way home is
    # round its low north end, out over the sea past its cape, as a seaplane would)
    h.via = [vec3(104000,0,-84000), vec3(117000,0,-90500), vec3(130000,0,-90000)]
    h

# The first mooring not taken (by anything within 9 m of it), or none.
tender_free_slot = (taken: vec3[]) -> int:
    loop k in 0..TENDER_SLOTS:
        p = tender_slot(k); free = true
        loop o in taken:
            if f64(length(vec3(o.x-p.x,0,o.z-p.z))) < 9.0: free = false
        if free: return k
    -1

near_tender = (p: vec3) -> bool: f64(length(vec3(p.x-TENDER_AT.x,0,p.z-TENDER_AT.z))) < vessel_spec(.seaplane_tender).length*0.5+TENDER_BOOM+TENDER_REACH

# Where a hoisted aircraft stands on her after deck, clear aft of her superstructure and funnels,
# short of the stern (its float bottoms at the deck).
tender_deck_spot = () -> vec3:
    s = vessel_spec(.seaplane_tender)
    z = -s.length*0.5+5.0
    section = vessel_deck_section(z,s.length,s.beam,s.deck,false)
    tender_local(vec3(0,section.y,f32(z)))

# The derrick's head, aft, swung out over her port side (vessel_models' derrick).
tender_derrick = () -> vec3:
    s = vessel_spec(.seaplane_tender)
    tender_local(vec3(f32(s.beam*1.1),f32(s.deck+s.beam*1.1),f32(-s.length*0.24)))

const HOIST_HOOK = 8.0                  # seconds: warped aft along her side under the derrick, the hook on
const HOIST_LIFT = 7.0                  # up out of the water to clear the rail
const HOIST_SWING = 6.0                 # swung in over the deck
const HOIST_DOWN = 3.0                  # set down on the chocks
hoist_seconds = () -> f64: HOIST_HOOK+HOIST_LIFT+HOIST_SWING+HOIST_DOWN

# The water under the derrick's head swung out, abreast of her after hatch: where the hoist takes
# an aircraft up from, and puts it down again.
tender_under_derrick = () -> vec3:
    s = vessel_spec(.seaplane_tender)
    tender_local(vec3(f32(s.beam*1.1),0,f32(-s.length*0.24)))

# Where the hoisted aircraft is `t` seconds into a hoist: warped from `start` (where it lay) to
# `from` (under the derrick), lifted, swung in and set down at `to` (on the deck); `down` runs it
# backwards (lowered over the side, ending under the derrick). The float bottoms' place (add the
# float height for the aircraft's own).
hoist_point = (start: vec3, from: vec3, to: vec3, t: f64, down: bool) -> vec3:
    u = if down: hoist_seconds()-t else: t
    clear = f64(to.y)+3.0
    if u <= HOIST_HOOK:
        if down: return from
        return lerp(start,from,f32(smoothstep(0.0,1.0,u/(HOIST_HOOK*0.8))))
    if u <= HOIST_HOOK+HOIST_LIFT:
        k = smoothstep(0.0,1.0,(u-HOIST_HOOK)/HOIST_LIFT)
        return vec3(from.x,f32(f64(from.y)+(clear-f64(from.y))*k),from.z)
    if u <= HOIST_HOOK+HOIST_LIFT+HOIST_SWING:
        k = smoothstep(0.0,1.0,(u-HOIST_HOOK-HOIST_LIFT)/HOIST_SWING)
        a = vec3(from.x,f32(clear),from.z); b = vec3(to.x,f32(clear),to.z)
        return lerp(a,b,f32(k))
    k = smoothstep(0.0,1.0,(u-HOIST_HOOK-HOIST_LIFT-HOIST_SWING)/HOIST_DOWN)
    vec3(to.x,f32(clear+(f64(to.y)-clear)*k),to.z)

# The call for help's mark for "the tender" where a harbour (settlement id) would be.
const TENDER_PLACE = -2

# Where her launch puts out from: astern of her.
tender_launch_at = () -> vec3: tender_local(vec3(0,0,f32(-vessel_spec(.seaplane_tender).length*0.5-20.0)))

# Where a tow ends: outboard of the first free mooring (the aircraft warped in to it from there).
tender_tow_end = (taken: vec3[]) -> vec2:
    k = max(0,tender_free_slot(taken))
    (tender_slot(k)+tender_port()*28.0).xz

# ---- going aboard her: off an aircraft at a boom's end or alongside, by her boat and up her
# Jacob's ladder; or off it on her deck, hoisted in ----

# A world point in her frame (x out to port, y up, z forward).
tender_local_of = (p: vec3) -> vec3:
    d = p-TENDER_AT
    vec3(dot(d,tender_port()),p.y,dot(d,tender_forward()))

# The boom whose end lies by `p` (within `reach` m; -1 none).
tender_boom_at = (p: vec3, reach: f64 = 10.0) -> int:
    loop k in 0..4:
        e = tender_slot(k)
        if f64(length(vec3(p.x-e.x,0,p.z-e.z))) < reach: return k
    -1

const TENDER_RAIL = 0.95                # her rail's height over her deck
const LADDER_FOOT = 0.55                # the Jacob's ladder's lowest rung over the water

# Her Jacob's ladder hung over her side abreast of `near` (on the side it lies), clear of her
# booms: its foot a little over the water against her hull, its head at her rail.
tender_ladder = (near: vec3) -> (vec3,vec3):
    s = vessel_spec(.seaplane_tender)
    l = tender_local_of(near)
    side = if f64(l.x) < 0.0: -1.0 else: 1.0
    z = clamp(f64(l.z),-s.length*0.43,s.length*0.43)
    # (between two booms, not under one)
    loop k in 0..(if side > 0: 4 else: 0):
        bz = 30.0-TENDER_STEP*f64(k)
        if abs(z-bz) < 4.0: z = bz+(if z >= bz: 4.0 else: -4.0)
    section = vessel_deck_section(z,s.length,s.beam,s.deck,false)
    x = f32(side)*(section.x+0.12)
    (tender_local(vec3(x,f32(LADDER_FOOT),f32(z))),tender_local(vec3(x,section.y+f32(TENDER_RAIL),f32(z))))

tender_direct_ladder = (p: vec3, span: f64) -> (vec3,vec3):
    at = tender_local_of(p)
    if at.x < 0: return tender_ladder(p)
    best = 43.5; gap = 1e9
    loop z in [-25.0,-3.0,19.0,43.5]:
        clear = true
        loop k in 0..4:
            if abs(z-(30.0-TENDER_STEP*f64(k))) < span*0.5+0.8: clear = false
        if clear and abs(z-f64(at.z)) < gap:
            best = z; gap = abs(z-f64(at.z))
    tender_ladder(tender_local(vec3(at.x,0,f32(best))))

# Where her boat lies at the ladder's foot: alongside her, its centre off her side, heading
# forward (a world turn, the vessels' convention: bow +z).
tender_boat_at_ladder = (ladder: (vec3,vec3), boat_beam: f64) -> vec3:
    l = tender_local_of(ladder.0)
    side = if f64(l.x) < 0.0: -1.0 else: 1.0
    tender_local(vec3(l.x+f32(side*(boat_beam*0.5+0.13)),0,l.z))

# Just inboard of her rail at the ladder's head, on her deck: where the one coming up is helped
# over, and where the hand helping them stands.
tender_inboard = (ladder: (vec3,vec3), by: f64) -> vec3:
    l = tender_local_of(ladder.1)
    side = if f64(l.x) < 0.0: -1.0 else: 1.0
    tender_local(vec3(l.x-f32(side*(by+0.12)),l.y-f32(TENDER_RAIL),l.z))

# Whether `p` is on her deck (inside her rails, clear of the stem and stern).
tender_local_deck = (x: f64, z: f64) -> f64?:
    s = vessel_spec(.seaplane_tender)
    section = vessel_deck_section(z,s.length,s.beam,s.deck,false)
    if abs(x) <= f64(section.x)-0.15 and abs(z) <= s.length*0.5-1.0: return f64(section.y)
    none

tender_on_deck = (p: vec3) -> bool:
    l = tender_local_of(p)
    tender_local_deck(f64(l.x),f64(l.z)) != none

# The height to walk at on her deck; none off it.
tender_deck_height = (x: f64, z: f64) -> f64?:
    l = tender_local_of(vec3(f32(x),0,f32(z)))
    tender_local_deck(f64(l.x),f64(l.z))

# Gone below: in at the door of her midships house (from the deck, in toward it).
tender_below = (p: vec3) -> bool:
    tender_local_below(tender_local_of(p))

tender_local_below = (l: vec3) -> bool:
    s = vessel_spec(.seaplane_tender)
    abs(f64(l.x)) < s.beam*0.38 and f64(l.z) > -s.length*0.07 and f64(l.z) < s.length*0.15

# Keep to the side deck until abreast of the midships house.
tender_deck_course = (p: vec3) -> vec3:
    s = vessel_spec(.seaplane_tender)
    side = if p.x < 0: -1.0 else: 1.0
    if f64(p.z) <= -s.length*0.06 or f64(p.z) >= s.length*0.14:
        rail = vessel_deck_section(f64(p.z),s.length,s.beam,s.deck,false)
        x = f32(side)*(rail.x-0.5)
        if abs(x-p.x)>0.5: return vec3(x,p.y,p.z)
        return vec3(x,p.y,f32(s.length*0.04))
    vec3(0,p.y,p.z)

# Off an aircraft afloat, in its own frame (+x starboard, -z forward), from `seat`: down onto a
# float's top (a flying boat's hull's) beside the cockpit, forward along it to its bow, where a boat
# lying ahead takes them off. `boat` its hull; `float_x` and `length` the aircraft's; `water` the
# water's height in the frame (minus its float height).
off_aircraft_path = (seat: vec3, boat: bool, float_x: f64, length: f64, water: f64) -> vec3[]:
    x = if boat: 0.0 else: float_x
    top = water+(if boat: 0.75 else: 0.32)
    bow = -length*(if boat: 0.47 else: 0.44)
    # (beside the cockpit on the float, or on the hull's deck just ahead of the cockpit)
    first = if boat: vec3(0,f32(top),f32(min(f64(seat.z)-0.9,bow+1.0))) else: vec3(f32(x),f32(top),seat.z)
    [seat,first,vec3(f32(x),f32(top),f32(bow+0.2))]

# A line brings the aircraft's bow in obliquely, with its wings clear of
# the plating. The float on the ship's side is the one the passenger uses.
tender_float_berth = (ladder: (vec3,vec3), prof: AircraftProfile, water: f64, seat: vec3) -> (vec3,f64,vec3[]):
    l = tender_local_of(ladder.0)
    side = if l.x < 0: -1 else: 1
    out = tender_port()*f32(side)
    fore = tender_forward()*f32(if l.z < 0: -1 else: 1)
    ahead = normalize(fore*0.22-out)
    heading = atan2(f64(ahead.x),-f64(ahead.z))
    right = vec3(-ahead.z,0,ahead.x)
    fx = if dot(right,out)>0: -prof.float_x else: prof.float_x
    path = off_aircraft_path(seat,prof.boat,fx,prof.length,water)
    bow = quat_rotate(quat_euler(0,-heading,0),path[2])
    at = ladder.0+out*0.80-vec3(bow.x,0,bow.z)
    (vec3(at.x,0,at.z),heading,path)

struct TenderBoatCourse:
    points: vec3[]
    distance: f64[]
    length = 0.0

_tender_curve = (p: vec3[],u: f64) -> vec3:
    w = f32(u); v = 1.0-w
    p[0]*(v*v*v)+p[1]*(3*v*v*w)+p[2]*(3*v*w*w)+p[3]*(w*w*w)

tender_boat_course = (start: vec3, arc: vec3, approach: vec3, finish: vec3) -> TenderBoatCourse:
    # Work in local metres so slow rowing is continuous far from the world origin.
    p = [loop q in [start,arc,approach,finish]: tender_local_of(q)]
    route = TenderBoatCourse(p,[0.0])
    before = p[0]
    loop k in 1..41:
        at = _tender_curve(p,f64(k)/40)
        route.length += f64(length(at-before))
        route.distance.push(route.length)
        before = at
    route

const TENDER_ROW_SPEED = 1.55

tender_row_pose = (route: TenderBoatCourse, age: f64, back: bool) -> (vec3,f64,f64):
    elapsed = clamp(age*TENDER_ROW_SPEED/max(route.length,0.01),0.0,1.0)
    at = route.length*smoothstep(0.0,1.0,elapsed)
    i = 0
    loop i < 39 and route.distance[i+1] < at: i += 1
    u = (f64(i)+clamp((at-route.distance[i])/max(0.0001,route.distance[i+1]-route.distance[i]),0.0,1.0))/40
    p = route.points
    w = f32(u); v = 1.0-w
    axis = (p[1]-p[0])*(v*v)+(p[2]-p[1])*(2*v*w)+(p[3]-p[2])*(w*w)
    # Back water off the float, then bring the bow round while clear of it.
    yaw = TENDER_YAW+atan2(f64(axis.x),f64(axis.z))
    if back: yaw += PI*(1.0-smoothstep(0.07,0.50,elapsed))
    (tender_local(_tender_curve(p,u)),yaw,6.0*elapsed*(1.0-elapsed)*TENDER_ROW_SPEED)
