# Questions carry their answer domain. No substring inference ("treated" is not "eat").
use 'life_types.jo'

ALL_VOICES: VoiceKind[] = [VoiceKind.salt,.shop,.formal,.guarded,.anxious,.wry,.warm,.measured,.plain,.devout,.brisk,.chatty,.eager,.elder]

question = (kind: QuestionKind, text: str, echo: str = "", open_topic: TalkTopic = .home) -> TalkQuestion:
    TalkQuestion(kind,text,if echo == "": text else: echo,open_topic)

# Compatibility for already saved questions and old greeting banks. Whole registered questions
# may follow an introduction; only an exact suffix matches, never a fragment inside a word.
question_details = (text: str) -> TalkQuestion:
    groups: (QuestionKind,str[])[] = [
        (.meal,["Have you eaten?","Have you had something to eat?","Have you eaten, or is that only for the fortunate?"]),
        (.day,["And you? How has the day treated you?","How did your day go?","Has your day gone well?","Would you call that a good day?","Have you had a sensible day, or an interesting one?","Would you call this a good day?","Did the day live up to its promises?","How did you get on?"]),
        (.route,["Where are you bound next?","Where does your next journey take you?","Where does the day take you next?","Where will your business take you next?","Where are you off to next?","Where do you go after this?"]),
        (.company,["Can you stop for a little company?","Have you time to talk?","Have you time to stop and talk?","Are you staying to talk?","Will you stop for a little company?","Can you spare a little time?","Have you a moment to sit?"]),
        (.news,["Have you any news from the crossings?","Have you heard anything on your travels?","Can you bring me any news?"]),
        (.business,["Have you come about work?","Have you business here?"])
    ]
    loop kind, entries in groups:
        loop entry in entries:
            if text.ends_with(entry): return question(kind,entry,open_topic=if kind == .news: TalkTopic.news else: TalkTopic.home)
    loop voice in ALL_VOICES:
        loop topic in [TalkTopic.greeting,.news]:
            loop q in followup_questions(voice,topic):
                if text.ends_with(q.text): return q
    # Unknown or ambiguous legacy wording expires, never a guessed meal/day/business answer.
    stop = (last_index_of(text,"?") ?? -1)
    tail = text
    if stop >= 0:
        before = text[0..stop]
        start = max((last_index_of(before,".") ?? -1),max((last_index_of(before,"!") ?? -1),(last_index_of(before,"?") ?? -1)))+1
        tail = trim(text[start..stop+1])
    question(.none,tail)

question_replies = (q: TalkQuestion, variant: int = 0) -> ReplyOption[]:
    warm = "I'd like to hear about your work."
    curt = "Another time. I should get on."
    open = "What is keeping you busy here?"
    match q.kind:
        .day:
            warm = if variant%2 == 0: "The day's treated me well, thank you." else: "A fair day so far. And it's better for a little company."
            curt = if variant%2 == 0: "It's been a long day." else: "I've had easier days."
        .meal:
            warm = if variant%2 == 0: "I've eaten, thank you." else: "Yes. I made time for a meal."
            curt = if variant%2 == 0: "Not yet." else: "I haven't stopped to eat."
            open = "Where would you go for something to eat?"
        .route:
            warm = "I've business here before I go anywhere."
            curt = "I haven't chosen my next crossing."
        .company:
            warm = if variant%2 == 0: "I can stay for a little company." else: "I've time to talk with you."
            curt = "Only a moment, I'm afraid."
        .news:
            warm = "Only the news you've just told me. I'm glad you did."
            curt = "I have no news worth passing on."
            open = "Tell me what you've heard."
        .business:
            warm = "I came to ask about your work."
            curt = "I'm only passing through."
        .work:
            warm = "I may be able to. Let me look at the load."
            curt = "I can't take this work."
            open = "How is your day otherwise?"
        .none: return []
    # Two or three substantive responses, plus an optional topic-opening fourth. Goodbye already
    # has its own UI action; don't spend a small-talk choice on the same exit a second time.
    if q.kind == .work: return [ReplyOption(.reassure,warm),ReplyOption(.decline,curt),ReplyOption(.open_topic,open)]
    result = [ReplyOption(.reassure,warm),ReplyOption(.decline,curt),ReplyOption(.ask_back,q.echo)]
    if variant%3 != 2: result.push(ReplyOption(.open_topic,open))
    result

# New questions are constructed with their domain and topic, not inferred from displayed prose.
followup_questions = (voice: VoiceKind, topic: TalkTopic) -> TalkQuestion[]:
    if topic==.news:
        words=match voice:
            .salt: "Any news from the other islands?"
            .shop: "Heard anything about trade?"
            .formal: "Have you any news from elsewhere?"
            .guarded: "What have you heard, then?"
            .anxious: "Have you heard anything yourself?"
            .warm: "Any news from your travels?"
            .measured: "What have you heard on your travels?"
            .wry: "Any news, beyond what's on the board?"
            .plain: "Heard anything?"
            .devout: "Have you news from the other towns?"
            .brisk: "Any news I should know?"
            .chatty: "Now, what have you heard?"
            .eager: "Have you seen anything out there?"
            .elder: "What's the news from elsewhere?"
        return [question(.news,words,open_topic=.news)]
    match voice:
        .salt: [question(.route,"Where are you making for?"),question(.day,"Fair flying today?"),question(.company,"Stopping a while?")]
        .shop: [question(.day,"Business good with you?"),question(.company,"Can you stop a minute?"),question(.route,"Where are you taking loads next?")]
        .formal: [question(.day,"Has your day gone well?"),question(.company,"Have you a moment?"),question(.route,"Where are you bound?")]
        .guarded: [question(.business,"Looking for work, are you?",open_topic=.work),question(.company,"Stopping, or passing through?"),question(.route,"Where are you going from here?")]
        .anxious: [question(.day,"Has it been a good day for you?"),question(.route,"Are you flying on today?"),question(.company,"Can you stay a minute?")]
        .warm: [question(.day,"Had a good day?"),question(.company,"Will you sit a while?"),question(.route,"Where are you off to next?")]
        .measured: [question(.day,"How has your day been?"),question(.company,"Have you time to talk?"),question(.route,"Where to next?")]
        .wry: [question(.day,"Has the day been kind to you?"),question(.company,"Got a minute to spare?"),question(.business,"Is it work you're after?",open_topic=.work)]
        .plain: [question(.day,"Been a long day?"),question(.route,"Where you off to?"),question(.company,"Stopping long?")]
        .devout: [question(.day,"Has the day been good to you?"),question(.company,"Will you stay and talk a little?"),question(.route,"Where does your road go next?")]
        .brisk: [question(.route,"Where are you flying to next?"),question(.day,"All well with you?"),question(.company,"Can you spare five minutes?")]
        .chatty: [question(.day,"So how's your day been, then?"),question(.company,"You'll stop for a chat, won't you?"),question(.route,"And where are you off to after this?")]
        .eager: [question(.route,"Where are you flying next?"),question(.day,"Good flying today?"),question(.business,"Are you looking for work?",open_topic=.work)]
        .elder: [question(.day,"And how are you keeping?"),question(.company,"Will you sit with me a while?"),question(.route,"Where are you going, then?")]
