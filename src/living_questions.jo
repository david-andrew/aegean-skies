# Questions carry their answer domain. No substring inference ("treated" is not "eat").
use 'life_types.jo'

question = (kind: QuestionKind, text: str, echo: str = "", open_topic: TalkTopic = .home) -> TalkQuestion:
    TalkQuestion(kind,text,if echo == "": text else: echo,open_topic)

# Compatibility for already saved questions and old greeting banks. Whole registered questions
# may follow an introduction; only an exact suffix matches, never a fragment inside a word.
question_details = (text: str) -> TalkQuestion:
    groups: (QuestionKind,str[])[] = [
        (.meal,["Have you eaten?","Have you had something to eat?","Have you eaten, or is that only for the fortunate?"]),
        (.day,["And you? How has the day treated you?","Have you been keeping well?","How has your journey treated you?","Have you had a sensible day, or an interesting one?","Would you call this a good day?","Did the day live up to its promises?","How did you get on?","You keeping well?","And how is it with you?","How do you find our town?","What would make the day better for you?"]),
        (.route,["Going out, or coming in?","Where does the day take you next?","Where will your business take you next?","Where are you off to next?","Where do you go after this?","Are you going somewhere?"]),
        (.company,["You've time to sit?","Can you spare a little time?","Will you be remaining here?","Do you intend to stay a while?","Do you have time for a proper conversation?","Do you mean to stay?","How long have you been standing there?","Are you staying long enough to be useful?","Will you stay a little, or have I frightened you off?","Will you stop for a little company?","Have you a moment to sit?","Are you staying for the evening?","Can you spare a little of your time?"]),
        (.news,["What did you hear yourself?","Who told you the other side of it?","Have you heard anything different?","What do people say where you've been?","Would you trust that account?","Has anyone spoken to you about it?","What would you make of that?","Can you add anything to what I heard?","Any good news, even borrowed?","What can you tell me that won't spoil my evening?","Any trouble you can safely tell me about?","Is there something you want to tell me?"]),
        (.business,["What are you after here?","Anyone waiting for you?","What's on your mind?","You found what you wanted?","What brings you to this part of town?","Is there something I can assist with?","Have you business still to conclude?","May I ask what you have in mind?","Have you found the person you sought?","Is there anything you wished to ask?","Who are you here to see?","What do you want from me?","Who's waiting for you?","Why are you asking?","Have you business here?","What's your side of it?","Do you know anyone here?","What did you come looking for?","What would you do in my place?","What have you managed to avoid doing?","What brought you to my fine establishment of standing about?","What brings you back this way?","Have you found what you came for?"])
    ]
    loop kind, entries in groups:
        loop entry in entries:
            if text.ends_with(entry): return question(kind,entry,open_topic=if kind == .news: TalkTopic.news else: TalkTopic.home)
    # Unknown legacy wording gets a neutral business response, never a guessed meal/day answer.
    stop = rfind(text,"?")
    tail = text
    if stop >= 0:
        before = text[0..stop]
        start = max(rfind(before,"."),max(rfind(before,"!"),rfind(before,"?")))+1
        tail = trim(text[start..stop+1])
    question(.none,tail)

question_replies = (q: TalkQuestion, variant: int = 0) -> ReplyOption[]:
    warm = "I'd like to hear about your work."
    curt = "Another time. I should get on."
    open = "What is keeping you busy here?"
    match q.kind:
        .day:
            warm = if variant%2 == 0: "The day's treated me well, thank you." else: "A fair day so far. And it's better for a little company."
            curt = if variant%2 == 0: "It's been a long day." else: "I've had easier days."
        .meal:
            warm = if variant%2 == 0: "I've eaten, thank you." else: "Yes. I made time for a meal."
            curt = if variant%2 == 0: "Not yet." else: "I haven't stopped to eat."
            open = "Where would you go for something to eat?"
        .route:
            warm = "I've business here before I go anywhere."
            curt = "I haven't chosen my next crossing."
        .company:
            warm = if variant%2 == 0: "I can stay for a little company." else: "I've time to talk with you."
            curt = "Only a moment, I'm afraid."
        .news:
            warm = "Only the news you've just told me. I'm glad you did."
            curt = "I have no news worth passing on."
            open = "Tell me what you've heard."
        .business:
            warm = "I came to ask about your work."
            curt = "I'm only passing through."
        .work:
            warm = "Tell me the cargo, destination and pay before I agree."
            curt = "I can't take this work."
            open = "What other work have you?"
        .none: return []
    # Two or three substantive responses, plus an optional topic-opening fourth. Goodbye already
    # has its own UI action; don't spend a small-talk choice on the same exit a second time.
    if q.kind == .work: return [ReplyOption(.reassure,warm),ReplyOption(.decline,curt),ReplyOption(.open_topic,open)]
    result = [ReplyOption(.reassure,warm),ReplyOption(.decline,curt),ReplyOption(.ask_back,q.echo)]
    if variant%3 != 2: result.push(ReplyOption(.open_topic,open))
    result

# New questions are constructed with their domain and topic, not inferred from displayed prose.
followup_questions = (voice: VoiceKind, topic: TalkTopic) -> TalkQuestion[]:
    if topic == .news:
        return [question(.news,"Have you any news from the crossings?",open_topic=.news),question(.news,"Have you heard anything on your travels?",open_topic=.news),question(.news,"Can you bring me any news?",open_topic=.news)]
    match voice:
        .salt: [question(.route,"Where are you bound next?"),question(.day,"How did your day go?"),question(.company,"Can you stop for a little company?")]
        .formal: [question(.day,"Has your day gone well?"),question(.company,"Have you time to talk?"),question(.route,"Where does your next journey take you?")]
        .guarded: [question(.business,"Have you come about work?",open_topic=.work),question(.company,"Are you staying to talk?"),question(.route,"Where are you bound next?")]
        .wry: [question(.day,"Would you call that a good day?"),question(.company,"Have you time to stop and talk?"),question(.business,"Have you come about work?",open_topic=.work)]
        else: [question(.day,"And you? How has the day treated you?"),question(.company,"Will you stop for a little company?"),question(.route,"Where do you go after this?")]
