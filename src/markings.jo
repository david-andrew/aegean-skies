# What can be painted on an aircraft besides its colours: national insignia, rudder stripes, a tail
# number and operator bars, and the colours offered for repainting. Data only, drawn by the kit
# (src/planes.jo: kit_wing_mark, kit_rudder), so every aircraft built through the kit wears them.
#
# Extending (other branches add here; nothing else needs to change):
# - an insignia: append to INSIGNIA (its `nation` says which types may wear it; "" any type);
# - rudder stripes: append to RUDDERS (likewise);
# - a type's nation: add its name (CRAFT_NAMES) to TYPE_NATIONS (several nations: several keys);
# - a livery for a type: make it the type's default (DEFAULT_LIVERIES), or list it for the type in
#   TYPE_LIVERIES, or give it a family in LIVERY_FAMILIES so every type of that family may wear it.
# Indices into INSIGNIA and RUDDERS are saved with a game: append, never reorder.

struct Insignia:
    key: str
    name: str
    shape: int                      # 0 rings (colours from the outside in), 1 a star on a disc
                                    # (disc, star, centre), 2 a cross (cross, edge), -1 none
    colours: vec4[]
    nation = ""                     # "" the game's own countries: any type; else that nation's types

_BLUE = rgb(0.14, 0.32, 0.63)
_CREAM = rgb(0.95, 0.92, 0.8)
_RED = rgb(0.72, 0.18, 0.13)
_WHITE = rgb(0.95, 0.94, 0.9)
_GREEN = rgb(0.1, 0.45, 0.22)
_ROYAL = rgb(0.14, 0.24, 0.55)
_PALE_BLUE = rgb(0.3, 0.55, 0.82)
_BLACK = rgb(0.08, 0.08, 0.09)

INSIGNIA: Insignia[] = [
    Insignia("none", "None", -1, []),
    Insignia("kalyra", "Kalyra", 0, [_BLUE, _CREAM, _BLUE]),
    Insignia("orenthia", "Orenthia", 0, [_RED, _CREAM, _RED]),
    Insignia("italy", "Italian", 0, [_RED, _WHITE, _GREEN], "italy"),
    Insignia("britain", "British", 0, [_ROYAL, _WHITE, _RED], "britain"),
    Insignia("greece", "Greek", 0, [rgb(0.1, 0.38, 0.7), _CREAM, rgb(0.1, 0.38, 0.7)], "greece"),
    Insignia("usa", "American", 1, [_ROYAL, _WHITE, _RED], "usa"),
    Insignia("germany", "German cross", 2, [_BLACK, _WHITE], "germany")
]
const INSIGNIA_NONE = 0
const INSIGNIA_KALYRA = 1
const INSIGNIA_ORENTHIA = 2
const INSIGNIA_GREECE = 5           # (a livery's marking 3: the Greek naval air service's)

struct RudderMark:
    key: str
    name: str
    colours: vec4[]                 # vertical stripes, front to back ([]: plain, the trim's accent)
    nation = ""

RUDDERS: RudderMark[] = [
    RudderMark("plain", "Plain", []),
    RudderMark("kalyra", "Kalyra", [_BLUE, _CREAM, _BLUE]),
    RudderMark("orenthia", "Orenthia", [_RED, _CREAM, _RED]),
    RudderMark("italy", "Italian tricolour", [_GREEN, _WHITE, rgb(0.78, 0.13, 0.12)], "italy"),
    RudderMark("britain", "British stripes", [_ROYAL, _WHITE, rgb(0.78, 0.13, 0.12)], "britain"),
    RudderMark("usa", "American stripes", [_ROYAL, _WHITE, rgb(0.78, 0.13, 0.12)], "usa"),
    RudderMark("greece", "Greek stripes", [_PALE_BLUE, _WHITE, _PALE_BLUE], "greece")
]

# The nations of the historical types (by name, as CRAFT_NAMES has them); the game's own types
# have none and wear the game's countries' marks.
TYPE_NATIONS: {str: str[]} = {
    "Macchi M.C.72": ["italy"], "Savoia-Marchetti S.65": ["italy"], "Piaggio P.7": ["italy"],
    "Macchi M.33": ["italy"], "Curtiss R3C-2": ["usa"], "Supermarine S.6B": ["britain"],
    "Sea Lion II": ["britain"], "S.55": ["italy", "greece"], "Do J Wal": ["germany", "italy"],
    "Do X": ["germany"], "H-4": ["usa"], "Sarafand": ["britain"],
    "Macchi M.5": ["italy"], "Hansa-Brandenburg CC": ["germany"], "Macchi M.7": ["italy"],
    "Fiat C.R.20": ["italy"],
    # (in Greek service: British-built, flown by the Hellenic Navy; the Greek-built Chelidon)
    "Sopwith Seaplane": ["greece", "britain"], "Sopwith Bat Boat": ["greece", "britain"],
    "Short 184": ["greece", "britain"], "KEA Chelidon": ["greece"],
    "Blackburn Velos": ["greece", "britain"], "Fairey IIIF": ["greece", "britain"]
}

# Liveries a type may wear besides its default and the civil ones (by type name: LIVERIES indices).
TYPE_LIVERIES: {str: int[]} = {}

# Liveries any type of a family may wear: the family is the family of the type's default livery.
# A livery not listed here is its own family: worn by the types whose default it is.
LIVERY_FAMILIES: {int: str} = {
    0: "civil", 1: "civil", 2: "civil", 3: "civil", 4: "civil", 5: "civil",
    6: "racer", 7: "racer", 8: "racer", 9: "racer",
    10: "boat", 11: "boat", 12: "boat", 13: "boat",
    14: "early", 15: "early", 16: "early", 17: "early", 18: "early",
    19: "greek", 20: "greek", 21: "greek", 22: "greek", 23: "greek"
}

# Colours offered when repainting, in period-plausible sets: dopes and lacquers.
struct Swatch:
    name: str
    colour: vec4

PALETTES: (str, Swatch[])[] = [
    ("Dopes", [Swatch("Doped linen", rgb(0.88, 0.84, 0.70)), Swatch("Aluminium dope", rgb(0.76, 0.77, 0.75)),
        Swatch("Cream", rgb(0.93, 0.89, 0.78)), Swatch("Clear varnish", rgb(0.70, 0.53, 0.33)),
        Swatch("Dark varnish", rgb(0.43, 0.27, 0.15)), Swatch("Field grey", rgb(0.50, 0.52, 0.45))]),
    ("Lacquers", [Swatch("Vermilion", rgb(0.78, 0.18, 0.12)), Swatch("Racing red", rgb(0.66, 0.1, 0.1)),
        Swatch("Navy", rgb(0.15, 0.2, 0.35)), Swatch("Schneider blue", rgb(0.2, 0.33, 0.62)),
        Swatch("Pale blue", rgb(0.56, 0.71, 0.82)), Swatch("Black", rgb(0.09, 0.09, 0.1))]),
    ("Trims", [Swatch("Gold", rgb(0.85, 0.7, 0.25)), Swatch("Ochre", rgb(0.86, 0.62, 0.22)),
        Swatch("Teal", rgb(0.12, 0.45, 0.5)), Swatch("Racing green", rgb(0.1, 0.38, 0.22)),
        Swatch("Olive", rgb(0.4, 0.42, 0.26)), Swatch("White", rgb(0.95, 0.94, 0.9))])
]

# ---------------- the player's own paint ----------------
# A repaint of the player's aircraft (src/aircraft_paint.jo works with it; saved with the game).

struct Paint:
    kind = -1                       # the type it was chosen for (-1: none; another type ignores it)
    livery = -1                     # the base livery (LIVERIES index; -1 the type's default)
    body: vec4 = vec4(0, 0, 0, 0)   # colours over the livery's (alpha 0: the livery's own)
    trim: vec4 = vec4(0, 0, 0, 0)
    wing: vec4 = vec4(0, 0, 0, 0)
    accent: vec4 = vec4(0, 0, 0, 0)
    insignia = -1                   # INSIGNIA index (-1: the livery's own)
    rudder = -1                     # RUDDERS index (-1: the type's own)
    number = ""                     # a tail number ("" none)
    bars = -1                       # operator bars: 1 on, 0 off (-1: the livery's own)

# ---------------- the letters of a tail number ----------------
# Block capitals five wide and seven high, a row a number (bit 4 the left column), for numbers
# painted on a fin: "I-BAUF", "K 12".

FONT_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-"
FONT_ROWS: int[][] = [
    [14,17,17,31,17,17,17], [30,17,17,30,17,17,30], [14,17,16,16,16,17,14], [30,17,17,17,17,17,30],
    [31,16,16,30,16,16,31], [31,16,16,30,16,16,16], [14,17,16,23,17,17,15], [17,17,17,31,17,17,17],
    [14,4,4,4,4,4,14], [7,2,2,2,2,18,12], [17,18,20,24,20,18,17], [16,16,16,16,16,16,31],
    [17,27,21,21,17,17,17], [17,25,21,19,17,17,17], [14,17,17,17,17,17,14], [30,17,17,30,16,16,16],
    [14,17,17,17,21,18,13], [30,17,17,30,20,18,17], [15,16,16,14,1,1,30], [31,4,4,4,4,4,4],
    [17,17,17,17,17,17,14], [17,17,17,17,17,10,4], [17,17,17,21,21,21,10], [17,17,10,4,10,17,17],
    [17,17,10,4,4,4,4], [31,1,2,4,8,16,31],
    [14,17,19,21,25,17,14], [4,12,4,4,4,4,14], [14,17,1,2,4,8,31], [31,2,4,2,1,17,14],
    [2,6,10,18,31,2,2], [31,16,30,1,1,17,14], [6,8,16,30,17,17,14], [31,1,2,4,8,8,8],
    [14,17,17,14,17,17,14], [14,17,17,15,1,2,12], [0,0,0,31,0,0,0]
]

# the rows of a character (a space, or one not in the font: none)
font_rows = (c: str) -> int[]:
    loop k in 0..FONT_CHARS.len():
        if FONT_CHARS[k..k + 1] == c: return FONT_ROWS[k]
    []

# A tail number as it can be painted: upper case, the font's characters and spaces, at most eight.
clean_number = (s: str) -> str:
    out = ""
    loop k in 0..s.len():
        c = s[k..k + 1].upper()
        if c == " " or font_rows(c).len() > 0: out = out + c
        if out.len() >= 8: break
    out.trim()

# ---------------- what a type may wear ----------------

type_nations = (name: str) -> str[]: if name in TYPE_NATIONS: TYPE_NATIONS[name] else: []

_worn_by = (nation: str, nations: str[]) -> bool: nation == "" or nation in nations

# The insignia a type of these nations may wear (indices into INSIGNIA): none, the game's two
# countries', and their own nation's.
insignia_for = (nations: str[]) -> int[]: [loop k in 0..INSIGNIA.len(): if _worn_by(INSIGNIA[k].nation, nations): k]
rudders_for = (nations: str[]) -> int[]: [loop k in 0..RUDDERS.len(): if _worn_by(RUDDERS[k].nation, nations): k]

livery_family = (k: int) -> str: if k in LIVERY_FAMILIES: LIVERY_FAMILIES[k] else: "own {k}"

# The liveries a type may wear (indices into LIVERIES, of `count`): its default first, then its
# period paints (`period`: the type's own list, such as the big boats'), the civil ones, those of its
# default's family, and any listed for it by name.
liveries_for = (name: str, default: int, count: int, period: int[] = []) -> int[]:
    out = [default]
    loop k in period:
        if k >= 0 and k < count and not (k in out): out.push(k)
    fam = livery_family(default)
    loop k in 0..count:
        if k in out: continue
        f = livery_family(k)
        if f == "civil" or f == fam: out.push(k)
    if name in TYPE_LIVERIES:
        loop k in TYPE_LIVERIES[name]:
            if k >= 0 and k < count and not (k in out): out.push(k)
    out
