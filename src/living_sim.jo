# Public headless clock. Import other living modules for commands/projections.
use 'living_types.jo'
use 'living_portage.jo'
use 'living_travel.jo'
use 'living_delivery.jo'
use 'living_events.jo'
use 'living_duties.jo'
use 'living_market.jo'
use 'living_choices.jo'
use 'living_claims.jo'
use 'living_jobs.jo'
use 'living_news.jo'
use 'living_weather.jo'
use 'living_pirates.jo'
use 'living_boats.jo'
use 'living_history.jo'
use 'living_services.jo'
use 'living_dispatch.jo'
use 'living_money.jo'

step_minute = (w: mut World):
    target = (w.tick / TICKS_PER_MINUTE + 1) * TICKS_PER_MINUTE
    w.tick = target; w.minute = target / TICKS_PER_MINUTE
    minute_rules(w)

# Scene clock commits physical outcomes at this tick before the minute's decisions.
# Headless step_minute uses exactly the same procedure.
minute_rules = (w: mut World):
    weather_minute(w)
    advance_workboats(w)
    carriage_abstract(w,w.tick)
    advance_trips(w,w.tick)
    flight_hazards(w)
    recovery_minute(w)
    advance_public_boats(w)
    service_recovery(w)
    update_people(w)
    advance_repairs(w)
    if local_minute(w.minute) == 0: accrue_interest(w)
    loop person in 1..w.people.len():
        if w.people[person].trip < 0 or w.people[person].occupation == .fisher: labor_minute(w,person)
    market_minute(w)
    check_deadlines(w)
    post_import_receipts(w)
    jobs_minute(w)
    maintain_supply_jobs(w)
    local_errands_minute(w)
    advance_loads(w)
    pirates_minute(w)
    choices_minute(w)
    news_minute(w)
    if local_minute(w.minute) == 0:
        scratch = PresentationState()
        prune_history(w,scratch)
    assert(money_balances(w) and goods_balance(w))

advance_ticks = (w: mut World, ticks: int):
    assert(ticks >= 0)
    if ticks == 0: return
    end = w.tick + ticks
    loop (w.tick / 120 + 1) * 120 <= end: step_minute(w)
    w.tick = end
    advance_trips(w,end)

advance_minutes = (w: mut World, minutes: int): advance_ticks(w,minutes * TICKS_PER_MINUTE)
