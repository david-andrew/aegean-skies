step_minute = (w: mut World):
    target = (w.tick / TICKS_PER_MINUTE + 1) * TICKS_PER_MINUTE
    w.tick = target; w.minute = target / TICKS_PER_MINUTE
    minute_rules(w)

# Scene clock commits physical outcomes at this tick before the minute's decisions.
# Headless step_minute uses exactly the same procedure.
# The minute's rules are ordered units (_minute_unit). minute_rules runs them all at once; a
# game may run them a few at a time over frames (minute_run_step) while nothing else touches
# the World: the same rules, in the same order, on the same World. Any fault ends the minute,
# whose guarded checkpoint then restores the World as before (recovery mode) or panics (strict).
# (districts, vehicles or journeys of the far check in one unit of a spread minute)
const FAR_CHECK_PIECES = 128
# Release play (recovery mode) checks the far registry as a rolling pass: about this many
# minutes for every record once, a share each minute, and the totals over all of them once at
# the pass's end; each minute also checks the records it changed (the districts its economy
# worked, the journeys it began). Strict runs (the tests) check everything every minute.
const FAR_ROLLING_MINUTES = 60
_far_rolling = FarCheck(route_points=false,rolling=true)
_far_rolling_share = 0
struct MinuteRun:
    active = false
    unit = 0
    economy_due = false
    index = 0                     # cursor inside a split phase
    ids: int[]                    # that phase's journeys or due vehicles
    scope: WorldGuard
    checking = false              # the far check of far_economy_begin, under way
    far_check: FarCheck

minute_run_begin = (w: mut World) -> MinuteRun:
    if guard_blocked(): return MinuteRun()
    MinuteRun(active=true,scope=guard_begin(w))

# Work on the minute for about budget_ms (at least one unit); true once it is complete.
minute_run_step = (w: mut World, run: mut MinuteRun, budget_ms: f64) -> bool:
    if not run.active: return true
    started=time()
    loop true:
        more=_minute_unit(w,run)
        if not more or guard_blocked():
            guard_finish(w,run.scope); run.active=false
            return true
        if (time()-started)*1000>=budget_ms: return false

# (this minute's share of the rolling far check: false when it found a fault, which the
# minute's checkpoint then undoes, the economy skipped as when the per-minute check refused)
_far_rolling_minute = (w: World, run: mut MinuteRun) -> bool:
    global _far_rolling, _far_rolling_share
    if _far_rolling.stage>=5 or _far_rolling_share<=0:
        _far_rolling = FarCheck(route_points=false,rolling=true)
        records = w.far.place_ids.len()+w.far.vehicles.len()+w.far.journeys.len()+24
        _far_rolling_share = max(16,(records+FAR_ROLLING_MINUTES-1)/FAR_ROLLING_MINUTES)
    error = far_reference_error(w)
    if error!="":
        living_fault("far.economy_state",guard_context(w)+" "+error)
        return false
    if far_check_step(w,_far_rolling,_far_rolling_share) and _far_rolling.error=="":
        _far_rolling.error = far_conservation_error(w)
        _far_rolling_share = 0
    if _far_rolling.error!="":
        living_fault("far.economy_state",guard_context(w)+" "+_far_rolling.error)
        _far_rolling_share = 0
        return false
    true

_guarded_minute_rules = (w: mut World):
    run=MinuteRun(active=true)
    loop _minute_unit(w,run) and not guard_blocked(): pass

# One unit of the minute's rules; false when the minute is over (complete, or refused).
# Units run in the order the rules always ran; split phases keep their own order.
_minute_unit = (w: mut World, run: mut MinuteRun) -> bool:
    k=run.unit; run.unit+=1
    if k==0:
        if not (money_balances(w) and goods_balance(w)):
            living_fault("minute_rules.preexisting_balance",guard_context(w)+" goods={stock_totals(w)} expected={[loop g in 0..GOOD_COUNT: w.goods_ledger.opening[g]+w.goods_ledger.created[g]-w.goods_ledger.consumed[g]]}")
            return false
        war_error=validate_war(w)
        if war_error!="":
            living_fault("war.minute_state",guard_context(w)+" "+war_error); return false
        run.economy_due=w.far.populated and w.far.last_minute<w.minute
        return true
    if k==1:
        # far_economy_minute, a place at a time. Its begin (far_economy_begin) is a far check,
        # itself run a few districts, vehicles or journeys at a time: the same checks in the
        # same order on a World nothing writes meanwhile, so the same verdict.
        if not w.far.populated or w.far.last_minute>=w.minute: run.unit=3; return true
        if not living_strict():
            if not _far_rolling_minute(w,run): run.unit=3
            else: run.index=w.minute%60
            return true
        if not run.checking:
            run.checking=true
            run.far_check=FarCheck()
        if not far_check_step(w,run.far_check,FAR_CHECK_PIECES): run.unit=1; return true
        run.checking=false
        if run.far_check.error!="":
            # (as far_economy_begin refusing: the fault, then on past the economy)
            living_fault("far.economy_state",guard_context(w)+" "+run.far_check.error); run.unit=3; return true
        run.index=w.minute%60
        return true
    if k==2:
        if run.index<w.far.place_ids.len():
            far_economy_place(w,run.index)
            if not living_strict() and run.index<w.far.place_ids.len():
                error=far_record_error(w,district=w.far.place_ids[run.index])
                if error!="": living_fault("far.economy_place",guard_context(w)+" "+error)
            run.index+=60; run.unit=2
        else: w.far.last_minute=w.minute
        return true
    if k==3:
        # Standing border charters buy existing local hulls before their first merchant sailing.
        if w.war.last_hour<0: war_minute(w)
        # far_transport_minute: journeys a few at a time, meals, then each due departure
        if far_transport_begin(w,run.economy_due): run.ids=far_advance_ids(w); run.index=0
        else: run.unit=7
        return true
    if k==4:
        last=min(run.index+16,run.ids.len())
        loop i in run.index..last: far_advance_journey(w,run.ids[i],w.tick)
        run.index=last
        if run.index<run.ids.len(): run.unit=4
        return true
    if k==5:
        far_crew_meals(w)
        run.ids=far_departures_due(w); run.index=0
        return true
    if k==6:
        if run.index<run.ids.len():
            vehicle=run.ids[run.index]
            far_depart(w,vehicle); run.index+=1; run.unit=6
            if not living_strict() and vehicle<w.far.vehicles.len() and w.far.vehicles[vehicle].journey>=0:
                error=far_record_error(w,vehicle=vehicle,journey=w.far.vehicles[vehicle].journey)
                if error!="": living_fault("far.departure",guard_context(w)+" "+error)
        return true
    if k==7: sea_rescue_minute(w); return true
    if k==8: far_commissions_minute(w); return true
    if k==9: far_people_minute(w); far_player_counter_news(w); return true
    if k==10: weather_minute(w); return true
    if k==11: adrift_minute(w); advance_workboats(w); return true
    if k==12:
        carriage_abstract(w,w.tick)
        advance_trips(w,w.tick)
        harbor_berths_minute(w)
        flight_hazards(w)
        return true
    if k==13: recovery_minute(w); return true
    if k==14: advance_public_boats(w); return true
    if k==15: service_recovery(w); return true
    if k==16: update_people(w); return true
    if k==17: advance_repairs(w); return true
    if k==18:
        if local_minute(w.minute) == 0: accrue_interest(w)
        loop person in 1..core_person_count(w):
            if w.people[person].trip < 0 or w.people[person].occupation == .fisher: labor_minute(w,person)
        market_minute(w)
        return true
    if k==19: check_deadlines(w); return true
    if k==20: post_import_receipts(w); return true
    if k==21: jobs_minute(w); errands_minute(w); return true
    if k==22: maintain_supply_jobs(w); return true
    if k==23: local_errands_minute(w); return true
    if k==24: advance_loads(w); return true
    if k==25: pirates_minute(w); return true
    if k==26: choices_minute(w); return true
    if k==27: life_minute(w); band_minute(w); return true
    if k==28: news_minute(w); bridge_core_news(w); return true
    if k==29: social_minute(w); far_social_minute(w); reputation_minute(w); return true
    if k==30: stories_minute(w); return true
    if k==31: countries_minute(w); return true
    if k==32:
        war_minute(w)
        war_peace_minute(w)
        war_force_notices(w)
        convoys_minute(w)
        begin_war_contacts(w)
        advance_war_contacts(w)
        privateers_minute(w)
        displacement_minute(w)
        missions_minute(w)
        mission_offices_minute(w)
        return true
    if k==33: map_rewards_minute(w); return true
    if k==34:
        if local_minute(w.minute) == 0:
            scratch = PresentationState()
            prune_history(w,scratch)
        if not (money_balances(w) and goods_balance(w)):
            living_fault("living_sim.minute_rules.0",guard_context(w)+" goods={stock_totals(w)} expected={[loop g in 0..GOOD_COUNT: w.goods_ledger.opening[g]+w.goods_ledger.created[g]-w.goods_ledger.consumed[g]]}")
        return false
    false

advance_ticks = (w: mut World, ticks: int):
    if not (ticks >= 0):
        living_fault("living_sim.advance_ticks.1",guard_context(w)+" ticks={ticks}")
        return
    if ticks == 0: return
    end = w.tick + ticks
    loop (w.tick / TICKS_PER_MINUTE + 1) * TICKS_PER_MINUTE <= end: step_minute(w)
    w.tick = end
    advance_trips(w,end)

advance_minutes = (w: mut World, minutes: int): advance_ticks(w,minutes * TICKS_PER_MINUTE)


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
minute_rules = (w: mut World):
    run=minute_run_begin(w)
    loop not minute_run_step(w,run,1e30): pass
