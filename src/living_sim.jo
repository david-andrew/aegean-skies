use 'living_guard.jo'
use 'living_transaction.jo'
# Public headless clock. Import other living modules for commands/projections.
use 'living_types.jo'
use 'living_portage.jo'
use 'living_travel.jo'
use 'living_delivery.jo'
use 'living_events.jo'
use 'living_duties.jo'
use 'living_market.jo'
use 'living_choices.jo'
use 'living_claims.jo'
use 'living_jobs.jo'
use 'living_news.jo'
use 'living_weather.jo'
use 'living_pirates.jo'
use 'living_boats.jo'
use 'living_history.jo'
use 'living_services.jo'
use 'living_dispatch.jo'
use 'living_money.jo'
use 'living_life.jo'
use 'living_social.jo'
use 'living_stories.jo'
use 'living_countries.jo'
use 'living_maps.jo'
use 'living_far_economy.jo'
use 'living_far_transport.jo'
use 'living_far_people.jo'
use 'living_commissions.jo'
use 'living_war.jo'
use 'living_war_contacts.jo'
use 'living_displacement.jo'
use 'living_missions.jo'
use 'living_sea_rescue.jo'
use 'living_far_news.jo'
use 'living_news_bridge.jo'
use 'living_far_social.jo'
use 'living_war_checks.jo'
use 'living_war_peace.jo'
use 'living_privateers.jo'
use 'living_convoys.jo'

step_minute = (w: mut World):
    target = (w.tick / TICKS_PER_MINUTE + 1) * TICKS_PER_MINUTE
    w.tick = target; w.minute = target / TICKS_PER_MINUTE
    minute_rules(w)

# Scene clock commits physical outcomes at this tick before the minute's decisions.
# Headless step_minute uses exactly the same procedure.
_guarded_minute_rules = (w: mut World):
    if not (money_balances(w) and goods_balance(w)):
        living_fault("minute_rules.preexisting_balance",guard_context(w)+" goods={stock_totals(w)} expected={[loop g in 0..GOOD_COUNT: w.goods_ledger.opening[g]+w.goods_ledger.created[g]-w.goods_ledger.consumed[g]]}")
        return
    war_error=validate_war(w)
    if war_error!="":
        living_fault("war.minute_state",guard_context(w)+" "+war_error); return
    far_economy_due=w.far.populated and w.far.last_minute<w.minute
    far_economy_minute(w)
    if guard_blocked(): return
    # Standing border charters buy existing local hulls before their first merchant sailing.
    if w.war.last_hour<0: war_minute(w)
    far_transport_minute(w,checked_economy=far_economy_due)
    sea_rescue_minute(w)
    if guard_blocked(): return
    far_commissions_minute(w)
    if guard_blocked(): return
    far_people_minute(w)
    far_player_counter_news(w)
    if guard_blocked(): return
    weather_minute(w)
    if guard_blocked(): return
    advance_workboats(w)
    if guard_blocked(): return
    carriage_abstract(w,w.tick)
    advance_trips(w,w.tick)
    harbor_berths_minute(w)
    flight_hazards(w)
    if guard_blocked(): return
    recovery_minute(w)
    if guard_blocked(): return
    advance_public_boats(w)
    if guard_blocked(): return
    service_recovery(w)
    if guard_blocked(): return
    update_people(w)
    if guard_blocked(): return
    advance_repairs(w)
    if guard_blocked(): return
    if local_minute(w.minute) == 0: accrue_interest(w)
    loop person in 1..core_person_count(w):
        if w.people[person].trip < 0 or w.people[person].occupation == .fisher: labor_minute(w,person)
    market_minute(w)
    if guard_blocked(): return
    check_deadlines(w)
    if guard_blocked(): return
    post_import_receipts(w)
    if guard_blocked(): return
    jobs_minute(w)
    if guard_blocked(): return
    maintain_supply_jobs(w)
    if guard_blocked(): return
    local_errands_minute(w)
    if guard_blocked(): return
    advance_loads(w)
    if guard_blocked(): return
    pirates_minute(w)
    if guard_blocked(): return
    choices_minute(w)
    if guard_blocked(): return
    life_minute(w)
    if guard_blocked(): return
    news_minute(w)
    bridge_core_news(w)
    if guard_blocked(): return
    social_minute(w)
    far_social_minute(w)
    if guard_blocked(): return
    stories_minute(w)
    if guard_blocked(): return
    countries_minute(w)
    if guard_blocked(): return
    war_minute(w)
    war_peace_minute(w)
    war_force_notices(w)
    convoys_minute(w)
    begin_war_contacts(w)
    advance_war_contacts(w)
    privateers_minute(w)
    displacement_minute(w)
    missions_minute(w)
    mission_offices_minute(w)
    if guard_blocked(): return
    map_rewards_minute(w)
    if guard_blocked(): return
    if local_minute(w.minute) == 0:
        scratch = PresentationState()
        prune_history(w,scratch)
    if not (money_balances(w) and goods_balance(w)):
        living_fault("living_sim.minute_rules.0",guard_context(w)+" goods={stock_totals(w)} expected={[loop g in 0..GOOD_COUNT: w.goods_ledger.opening[g]+w.goods_ledger.created[g]-w.goods_ledger.consumed[g]]}")
        return

advance_ticks = (w: mut World, ticks: int):
    if not (ticks >= 0):
        living_fault("living_sim.advance_ticks.1",guard_context(w)+" ticks={ticks}")
        return
    if ticks == 0: return
    end = w.tick + ticks
    loop (w.tick / 120 + 1) * 120 <= end: step_minute(w)
    w.tick = end
    advance_trips(w,end)

advance_minutes = (w: mut World, minutes: int): advance_ticks(w,minutes * TICKS_PER_MINUTE)


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
minute_rules = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_minute_rules(w)
    guard_finish(w,scope)
