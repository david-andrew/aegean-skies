# Save boundary validation; read-only projections must never repair or initialize state.
use 'living_types.jo'
use 'life_types.jo'

validate_life = (w: World) -> str:
    if w.life_version < 0 or w.life_version > 1: return "unsupported social life version"
    loop person, ledger in w.speech:
        if person < 0 or person >= w.people.len() or ledger.sequence < 0 or ledger.recent.len() > 64: return "invalid speech identity/history"
        if ledger.work_leads.len()>12: return "unbounded work referrals"
        loop lead in ledger.work_leads:
            if lead.heard_minute > w.minute or lead.poster < 0 or lead.poster >= w.people.len() or lead.source_person < 0 or lead.source_person >= w.people.len(): return "invalid work referral"
        if ledger.pending_listener < -1 or ledger.pending_listener >= w.people.len(): return "invalid conversation listener"
        loop line in ledger.recent:
            if line.minute > w.minute or line.listener < 0 or line.listener >= w.people.len() or line.text == "": return "invalid spoken line"
        loop other, count in ledger.acquaintance:
            if other < 0 or other >= w.people.len() or count < 0: return "invalid conversational acquaintance"
        loop other, minute in ledger.last_contact:
            if other < 0 or other >= w.people.len() or minute > w.minute: return "invalid conversation contact"
    loop person, intent in w.daily_life:
        if person != intent.person or person < 0 or person >= w.people.len() or person == w.player: return "invalid daily intent identity"
        if intent.place < -1 or intent.place >= w.places.len() or intent.last_tick > w.tick or intent.waypoint < 0 or intent.waypoint > intent.route.len(): return "invalid daily intent route/clock"
        if not is_finite(intent.target.x) or not is_finite(intent.target.y) or not is_finite(intent.target.z): return "invalid daily intent target"
    venue_keys: {str: bool}
    loop v in w.life_venues:
        if v.place < 0 or v.place >= w.places.len() or v.key == "" or v.capacity <= 0: return "invalid life venue"
        key = "{v.place}:{v.key}"
        if venue_keys.get(key,false): return "duplicate life venue key"
        venue_keys[key] = true
    max_meeting = -1
    loop id, meeting in w.meetings:
        max_meeting = max(max_meeting,id)
        if id != meeting.id or meeting.people.len() < 2 or meeting.place < 0 or meeting.place >= w.places.len(): return "invalid meeting identity/place"
        seen: {int: bool}
        loop person in meeting.people:
            if person < 0 or person >= w.people.len() or seen.get(person,false): return "invalid meeting participants"
            seen[person] = true
    active: {int: bool}
    loop id in w.active_meetings:
        if not (id in w.meetings) or not w.meetings[id].active or active.get(id,false): return "invalid active meeting index"
        active[id] = true
    loop id, meeting in w.meetings:
        if meeting.active and not active.get(id,false): return "active meeting missing from index"
    if w.next_meeting <= max_meeting: return "meeting counter rewound"
    household_ids: {int: bool}
    loop p in w.households:
        if p.id < 1000000 or household_ids.get(p.id,false) or p.guardian < 0 or p.guardian >= w.people.len() or p.age < 0 or p.age > 17 or p.home < 0 or p.home >= w.places.len(): return "invalid household resident"
        household_ids[p.id] = true
    max_story = -1
    loop id, story in w.stories:
        max_story = max(max_story,id)
        if id != story.id or story.place < 0 or story.place >= w.places.len() or story.actors.len() < 1: return "invalid life story"
        loop actor in story.actors:
            if actor < 0 or actor >= w.people.len(): return "invalid story actor"
        if not story.resolved and story.job >= 0 and not (story.job in w.jobs): return "live story lost its cargo job"
    if w.next_story <= max_story: return "story counter rewound"
    if w.place_country.len() != 0 and w.place_country.len() != w.places.len(): return "country mapping does not match detailed core"
    loop country in w.place_country:
        if country < -1 or country >= w.countries.len(): return "invalid settlement country"
    if w.place_catalog_version < 0: return "invalid catalog version"
    loop id, context in w.place_contexts:
        if id != context.id or id < 0 or id > 0x7fffffff or context.country < 0 or context.country >= w.countries.len() or context.name == "": return "invalid catalog identity/country"
        if context.detailed < -1 or context.detailed >= w.places.len(): return "invalid detailed catalog adapter"
        loop neighbor in context.neighbors:
            if not (neighbor in w.place_contexts): return "unknown catalog neighbor"
        loop v in context.venues:
            if v.place != id or v.key == "" or v.capacity < 1: return "invalid catalog landmark"
    country_keys: {str: bool}
    loop k in 0..w.countries.len():
        c = w.countries[k]
        if c.id != k or c.key == "" or c.key in country_keys or c.treasury_account < -1 or c.treasury_account >= w.accounts.len() or c.seat < -1 or c.seat >= w.places.len(): return "invalid country identity/treasury"
        country_keys[c.key] = true
        if c.capital_id >= 0 and (not (c.capital_id in w.place_contexts) or w.place_contexts[c.capital_id].country != c.id): return "invalid country capital"
    incident_ids: {int: bool}; max_incident = -1
    loop incident in w.border_incidents:
        if incident.id < 0 or incident_ids.get(incident.id,false) or incident.aggressor < 0 or incident.affected < 0 or incident.aggressor >= w.countries.len() or incident.affected >= w.countries.len() or incident.aggressor == incident.affected or incident.confidence < 600 or incident.weight < 1: return "invalid border incident"
        incident_ids[incident.id] = true; max_incident = max(max_incident,incident.id)
    if w.next_border_incident <= max_incident: return "incident counter rewound"
    relations: {int: bool}
    loop r in w.diplomacy:
        key = route_pair(r.a,r.b)
        if r.a < 0 or r.a >= r.b or r.b >= w.countries.len() or r.tension < 0 or r.tension > 1000 or relations.get(key,false) or r.evidence.len()>32: return "invalid diplomatic relation"
        relations[key] = true
    ""
