# Where each authored harbour town's fish stall stands: an open spot on a quay (between the
# bollards, its back to the edge, a clear lane left beside it) or, failing that, in the square at
# the quay's root. Chosen from the town's fixed geometry only (its quays, houses, stairs, square
# furniture, the harbour's own props and the Hotel Ancora), never from what the running game has
# published, so the game and the world audit find the same spot. Also the stall's solids: the
# trestle and its awning poles, for walkers to go round.
use 'world.jo'
use 'objects.jo'
use 'settlements.jo'
use 'walk_shapes.jo'
use 'water_field.jo'
use 'town_sites.jo'
use 'bar_scene.jo'

struct FishStall:
    found = false
    place = -1
    at: vec3                        # the foot of the stall, its middle
    yaw = 0.0                       # its front (the customers' side) faces (sin yaw, cos yaw)
    on_quay = false
    width = 2.3                     # (its footprint: the stall's, or the locker's)
    depth = 1.35

# (the stall's footprint in its own frame: the awning's reach over the table, front toward +z)
const STALL_WIDTH = 2.3
const STALL_DEPTH = 1.35
const STALL_CENTER_Z = 0.05
const STALL_MARGIN = 0.45           # (kept clear round it, besides walkers' own clearance)

fish_stall_front = (st: FishStall) -> vec3: vec3(f32(sin(st.yaw)), 0, f32(cos(st.yaw)))

# where a customer stands, before the counter
fish_stall_customer = (st: FishStall) -> vec3: st.at + fish_stall_front(st) * 1.5

fish_stall_box = (st: FishStall, grow: f64 = 0.0) -> TownSite:
    TownSite(st.at + fish_stall_front(st) * f32(if st.width == STALL_WIDTH: STALL_CENTER_Z else: 0.0), st.yaw, st.width + grow * 2.0, st.depth + grow * 2.0, 2.3, 0)

# What one walks into: the trestle table and the four awning poles (the awning overhead is clear).
fish_stall_solids = (st: FishStall) -> TownSite[]:
    if not st.found: return []
    point = (x: f64, z: f64) -> vec3:
        p = site_point(TownSite(st.at, st.yaw, 1, 1, 1, 0), x, z)
        vec3(p.x, st.at.y, p.y)
    out = [TownSite(point(0.0, 0.0), st.yaw, 2.0, 0.9, 0.95, 0)]
    loop x in [-1.05, 1.05]:
        loop z in [-0.5, 0.55]: out.push(TownSite(point(x, z), st.yaw, 0.12, 0.12, 2.2, 0))
    out

# points over the stall's footprint and a margin round it (only a little behind: its back may
# stand at a quay's edge)
fish_stall_points = (st: FishStall, grow: f64) -> vec2[]:
    box = fish_stall_box(st)
    back = min(grow, 0.2)
    out: vec2[]
    loop i in 0..5:
        loop j in 0..4:
            x = (f64(i) / 4.0 - 0.5) * (box.width + grow * 2.0)
            z = -box.depth * 0.5 - back + f64(j) / 3.0 * (box.depth + back + grow)
            out.push(site_point(box, x, z))
    out

_seg_distance = (p: vec2, a: vec2, b: vec2) -> f64:
    d = b - a
    l2 = f64(dot(d, d))
    u = if l2 < 0.0001: 0.0 else: clamp(f64(dot(p - a, d)) / l2, 0.0, 1.0)
    f64(length(p - (a + d * f32(u))))

# Fixed things a stall must keep clear of, as (x, z, radius) circles and (a, b, half width) paths.
struct StallKeep:
    spots: vec3[]                   # x, z, radius
    paths: vec4[]                   # a.x, a.z, b.x, b.z
    widths: f64[]                   # each path's half width
    hotel: TownSite[]               # the Hotel Ancora and its pier, whole

fish_stall_keep = (towns: Town[], place: int) -> StallKeep:
    k = StallKeep()
    tw = towns[place]
    out = vec3(tw.out.x, 0, tw.out.y); side = vec3(-tw.out.y, 0, tw.out.x); tangent = vec2(-tw.out.y, tw.out.x)
    # the harbour's notice board and its store
    board = town_board_spot(tw)
    k.spots.push(vec3(board.x, board.z, 2.5))
    store = town_store_spot(tw, tw.center - out * 8.0 + side + vec3(0, f32(QUAY_TOP) - tw.center.y, 0))
    k.spots.push(vec3(store.x, store.z, 3.0))
    # the goods stacked by the warehouse (living_cargo's stock spots, along the town's axis)
    a = tw.center - out * 8.0 + side
    k.paths.push(vec4(a.x, a.z, (a + out * 8.0).x, (a + out * 8.0).z)); k.widths.push(2.2)
    # each mooring's quay edge and the loading point beside it (left free for the aircraft)
    loop d in tw.docks:
        e = _quay_access(tw, d)
        k.spots.push(vec3(e.x, e.z, 5.5))
        offset = f64(dot(d - tw.center, side))
        l = d - side * f32(if offset < 0.0: -8.0 else: 8.0)
        k.spots.push(vec3(l.x, l.z, 3.5))
    # the quay lamps (the audit's own spacing) and the bollards along both edges
    loop q in tw.quays:
        dq = q.b - q.a; ql = f64(length(dq))
        if ql < 1.0: continue
        nrm = vec2(-dq.y, dq.x) / f32(ql)
        u = 8.0
        loop u < ql - 4.0:
            p = q.a + dq * f32(u / ql) + nrm * f32(f64(q.width) * 0.5 - 0.6)
            k.spots.push(vec3(p.x, p.y, 0.6))
            u += 26.0
        u = 1.0
        loop u < ql - 2.0:
            loop sd in [-1.0, 1.0]:
                p = q.a + dq * f32(u / ql) + nrm * f32(sd * (f64(q.width) * 0.5 - 0.5))
                k.spots.push(vec3(p.x, p.y, 0.35))
            u += 12.0
    # the stairs up the cliff, and the town's lanes and house frontages (paths, and the furniture
    # set along the frontages)
    loop stair in tw.stairs:
        loop i in 0..stair.len() - 1:
            k.paths.push(vec4(stair[i].x, stair[i].z, stair[i + 1].x, stair[i + 1].z)); k.widths.push(2.2)
    loop lane in site_lanes(tw.sites):
        k.paths.push(vec4(lane.a.x, lane.a.y, lane.b.x, lane.b.y)); k.widths.push(f64(lane.width) * 0.5)
    loop h in tw.houses:
        front = h.xz + tw.out * 8.0
        f0 = front - tangent * 6.0; f1 = front + tangent * 6.0
        k.paths.push(vec4(f0.x, f0.y, f1.x, f1.y)); k.widths.push(1.0)
        k.spots.push(vec3(front.x + tangent.x * 4.0, front.y + tangent.y * 4.0, 1.2))
        k.spots.push(vec3(front.x - tangent.x * 2.0, front.y - tangent.y * 2.0, 1.2))
    # the square's furniture at the quay root (world_towns' legacy plan)
    if place < world_settlements.len():
        root = tw.center.xz - tw.out * 18.0
        loop prop in place_square(world_settlements[place]).props:
            p = root + tangent * prop.local.x - tw.out * prop.local.y
            k.spots.push(vec3(p.x, p.y, f32(2.6 * prop.scale)))
    # the Hotel Ancora: its building, terrace and pier (Porto Vecchio)
    if place == 0:
        m = hotel_site(tw, (x: f64, z: f64) -> f64: surface_height(x, z))
        c = transform_point(m, vec3(0, 0, 16))
        k.hotel.push(TownSite(c, atan2(f64(m[2].x), f64(m[2].z)), 34.0, 34.0, 20.0, 0))
    k

# (the walkable quay edge nearest a mooring: as the world audit finds it)
_quay_access = (tw: Town, point: vec3) -> vec3:
    best = vec3(0, 0, 0); distance = 1e30
    loop q in tw.quays:
        line = q.b - q.a
        u = clamp(dot(point.xz - q.a, line) / dot(line, line), 0.0, 1.0)
        centre = q.a + line * u; across = point.xz - centre
        s = if length(across) > 0.01: normalize(across) else: vec2(1, 0)
        p = centre + s * max(0.0, q.width * 0.5 - 0.9)
        if f64(length(point.xz - p)) < distance:
            distance = f64(length(point.xz - p)); best = vec3(p.x, QUAY_TOP, p.y)
    best

# Open ground for a stall, from fixed geometry only: not the sea, not inside a house, a wall or
# the town's own buildings (the published, running-game solids are not consulted).
_stall_open = (towns: Town[], p: vec2, h: f64) -> bool:
    water = water_at(f64(p.x), f64(p.y))
    level = if water.wet: water.level else: 0.0
    if h < level + 0.4: return false
    loop site in walk_cell(p).sites:
        if f64(length(walk_site_exclude(site, p, h) - p)) > 0.05: return false
    loop tw in towns:
        if f64(length(tw.center.xz - p)) > 400.0: continue
        if tw.sites.len() > 0:
            loop s in tw.sites:
                if f64(length(p - s.at.xz)) < max(s.width, s.depth) + 1.0 and f64(length(walk_site_exclude(s, p, h) - p)) > 0.05: return false
        else:
            loop b in tw.blocks:
                if f64(length(p - vec2(b.x, b.y))) < f64(b.z) + 0.35: return false
    true

# What is wrong with a stall here ("" when nothing): open, level ground under it and round it,
# clear of the town's fixed things and paths, and open ground before it for customers.
fish_stall_trouble = (towns: Town[], st: FishStall, keep: StallKeep) -> str:
    h0 = walk_height(towns, f64(st.at.x), f64(st.at.z))
    loop p in fish_stall_points(st, STALL_MARGIN):
        h = walk_height(towns, f64(p.x), f64(p.y))
        if abs(h - h0) > 0.25: return "uneven"
        if not _stall_open(towns, p, h): return "blocked"
        loop s in keep.spots:
            if f64(length(p - s.xy)) < f64(s.z): return "crowding {s.z:.1f} m keep at {s.xy}"
        loop i in 0..keep.paths.len():
            q = keep.paths[i]
            if _seg_distance(p, q.xy, q.zw) < keep.widths[i]: return "on a path ({keep.widths[i]:.1f} m)"
        loop site in keep.hotel:
            if f64(length(walk_site_exclude(site, p, -100.0) - p)) > 0.05: return "the hotel"
    # (room before it: a customer at the counter, and a way past behind them)
    front = fish_stall_front(st)
    loop d in [1.2, 2.2, 3.2]:
        loop x in [-0.9, 0.0, 0.9]:
            q = st.at + front * f32(d) + vec3(f32(cos(st.yaw) * x), 0, f32(-sin(st.yaw) * x))
            h = walk_height(towns, f64(q.x), f64(q.z))
            if abs(h - h0) > 0.4 or not _stall_open(towns, q.xz, h): return "no room before it"
    ""

# The town's stall: the best open spot on its quays, nearest the town's waterfront, else in
# the square at the quay's root.
# Which towns keep a fish stall: every harbour town but the smugglers' cove (its short pier has
# room only for the moorings, the board and the store, and nobody sells fish openly there).
fish_stall_wanted = (place: int) -> bool: place >= 0 and place < SETTLEMENTS.len() and SETTLEMENTS[place].kind != .cove

fish_stall_place = (towns: Town[], place: int) -> FishStall:
    if place < 0 or place >= towns.len() or not fish_stall_wanted(place): return FishStall(place = place)
    tw = towns[place]
    keep = fish_stall_keep(towns, place)
    candidates: (f64, FishStall)[]
    # on the quays: between the bollards, the stall's back to one edge, facing across
    loop q in tw.quays:
        dq = q.b - q.a; ql = f64(length(dq))
        if ql < 10.0 or f64(q.width) < 4.9: continue
        nrm = vec2(-dq.y, dq.x) / f32(ql)
        along = 4.0
        loop along < ql - 3.0:
            loop sd in [-1.0, 1.0]:
                c = q.a + dq * f32(along / ql) + nrm * f32(sd * (f64(q.width) * 0.5 - 0.35 - STALL_DEPTH * 0.5))
                front = -nrm * f32(sd)
                h = walk_height(towns, f64(c.x), f64(c.y))
                candidates.push((f64(length(c - tw.center.xz)), FishStall(found = true, place = place, at = vec3(c.x, f32(h), c.y), yaw = atan2(f64(front.x), f64(front.y)), on_quay = true)))
            along += 3.0
    # in the square at the quay's root, facing its middle
    root = tw.center.xz - tw.out * 18.0
    tangent = vec2(-tw.out.y, tw.out.x)
    loop j in -2..3:
        loop i in -4..5:
            c = root + tangent * f32(f64(i) * 3.0) - tw.out * f32(f64(j) * 3.0)
            toward = root - c
            front = if f64(length(toward)) > 1.0: normalize(toward) else: tw.out
            h = walk_height(towns, f64(c.x), f64(c.y))
            candidates.push((40.0 + f64(length(c - root)), FishStall(found = true, place = place, at = vec3(c.x, f32(h), c.y), yaw = atan2(f64(front.x), f64(front.y)), on_quay = false)))
    candidates.sort((c: (f64, FishStall)): c.0)
    loop c in candidates:
        if fish_stall_trouble(towns, c.1, keep) == "": return c.1
    FishStall(place = place)

# ---------------- the player's locker ----------------

const LOCKER_WIDTH = 1.1
const LOCKER_DEPTH = 0.65

# The player's own locker for his things (a bucket to begin with): a slatted wooden locker on the
# quay of his home port, as near his mooring as there's open ground, its back to the quay's edge,
# clear of the fish stall. Found as the stall is, from fixed geometry only.
fish_locker_place = (towns: Town[], place: int) -> FishStall:
    if place < 0 or place >= towns.len() or towns[place].docks.len() == 0: return FishStall(place = place)
    tw = towns[place]
    keep = fish_stall_keep(towns, place)
    stall = fish_stall_place(towns, place)
    if stall.found: keep.spots.push(vec3(stall.at.x, stall.at.z, 3.5))
    # (clear of a moored aircraft's wings over the quay)
    loop d in tw.docks: keep.spots.push(vec3(d.x, d.z, 10.0))
    moor = _quay_access(tw, tw.docks[0])
    candidates: (f64, FishStall)[]
    loop q in tw.quays:
        dq = q.b - q.a; ql = f64(length(dq))
        if ql < 6.0 or f64(q.width) < 4.9: continue
        nrm = vec2(-dq.y, dq.x) / f32(ql)
        along = 3.0
        loop along < ql - 2.0:
            loop sd in [-1.0, 1.0]:
                c = q.a + dq * f32(along / ql) + nrm * f32(sd * (f64(q.width) * 0.5 - 0.3 - LOCKER_DEPTH * 0.5))
                front = -nrm * f32(sd)
                h = walk_height(towns, f64(c.x), f64(c.y))
                candidates.push((f64(length(c - moor.xz)), FishStall(found = true, place = place, at = vec3(c.x, f32(h), c.y), yaw = atan2(f64(front.x), f64(front.y)), on_quay = true, width = LOCKER_WIDTH, depth = LOCKER_DEPTH)))
            along += 1.5
    candidates.sort((c: (f64, FishStall)): c.0)
    loop c in candidates:
        if fish_stall_trouble(towns, c.1, keep) == "": return c.1
    FishStall(place = place, width = LOCKER_WIDTH, depth = LOCKER_DEPTH)

# where something kept in the locker stands (its bottom shelf), and the locker's solid
fish_locker_shelf = (l: FishStall) -> vec3: l.at + vec3(0, 0.12, 0)
fish_locker_solids = (l: FishStall) -> TownSite[]: if l.found: [TownSite(l.at, l.yaw, LOCKER_WIDTH, LOCKER_DEPTH, 1.4, 0)] else: []
