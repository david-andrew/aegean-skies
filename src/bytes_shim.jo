# The World in the binary form for saves (slot encoding 4): written by world_to_bytes or a stepped
# WorldWriter, read by world_from_bytes. Until Sloppy's release of to_bytes/from_bytes/byte_writer
# for any value (0.37.5's to_bytes takes plain data only), these use the text form inside, so the
# game's side of a binary save (the encoding, its migration from text, the tests) runs now; when
# the release lands, each becomes the library call it names and nothing else changes. Nothing is
# saved through the stand-in outside the tests: save_binary stays off until then.
use 'living_types.jo'

world_to_bytes = (w: World) -> u8[]: bytes(to_text(w))                       # to_bytes(w)
world_from_bytes = (b: u8[]) -> World | TextError: from_text[World](str_from_bytes(b))   # from_bytes[World](b)

# (byte_writer(w), stepped: step(seconds) true when done, result() the bytes)
struct WorldWriter:
    out: u8[]
    done = false
world_writer = (w: World) -> WorldWriter: WorldWriter(world_to_bytes(w), true)
step = (w: mut WorldWriter, seconds: f64) -> bool: w.done
result = (w: mut WorldWriter) -> u8[]: w.out
