# Neravessa's look: the builders canal_render.jo bakes into the city's batches. A deep stone cut with
# parapets, promenades, trees and lamps; muted 4-6 storey facades with shutters, cornices and
# darker roof pitches; stone arch and iron bridges; domes, bell towers and works chimneys behind.
# All procedural: boxes, quads and cylinders in vertex colour, lit by the shared painted light.
use 'canal_geometry.jo'
use 'objects.jo'
use 'river_data.jo'
use 'town_details.jo'

# ---------------- palette (vertex colours, before the painted light) ----------------

# Facades are muted cream, grey and stone; one in six or seven is an ochre, pink or rust accent.
CANAL_WALLS=[rgb(0.88,0.85,0.77),rgb(0.78,0.80,0.75),rgb(0.70,0.69,0.64),rgb(0.84,0.79,0.68),rgb(0.74,0.76,0.76),rgb(0.82,0.79,0.74),rgb(0.86,0.84,0.79)]
CANAL_ACCENTS=[rgb(0.90,0.70,0.42),rgb(0.88,0.66,0.58),rgb(0.70,0.42,0.30),rgb(0.64,0.71,0.56)]
CANAL_SHUTTERS=[rgb(0.27,0.40,0.31),rgb(0.44,0.51,0.44),rgb(0.36,0.46,0.55),rgb(0.42,0.32,0.24),rgb(0.55,0.58,0.52)]
CANAL_TILE=rgb(0.70,0.37,0.23)
CANAL_SLATE=rgb(0.33,0.36,0.41)
CANAL_ZINC=rgb(0.52,0.54,0.55)
CANAL_TRIM=rgb(0.90,0.88,0.82)
CANAL_BASE=rgb(0.60,0.58,0.53)
CANAL_GLASS=rgb(0.16,0.19,0.23)
CANAL_WALL_STONE=rgb(0.21,0.24,0.28)
CANAL_WET_STONE=rgb(0.17,0.21,0.22)
CANAL_COPING=rgb(0.55,0.55,0.52)
CANAL_PAVING=rgb(0.56,0.55,0.51)
CANAL_BRIDGE_STONE=rgb(0.60,0.60,0.57)
CANAL_SOFFIT=rgb(0.40,0.40,0.38)
CANAL_IRON=rgb(0.19,0.23,0.23)
CANAL_BRICK=rgb(0.56,0.31,0.23)
CANAL_TIMBER=rgb(0.45,0.25,0.19)
CANAL_COPPER=rgb(0.42,0.58,0.52)
# Trees: three values per clump (lit crown, mid, underside), as round lobes.
CANAL_LEAF=[rgb(0.27,0.48,0.30),rgb(0.13,0.36,0.28),rgb(0.07,0.22,0.17)]

canal_hash=(n:int)->int:
    x=(n*1103515245+12345)%2147483648
    if x<0:x=-x
    (x/65536)%32768

# A proper (unmirrored) frame: local x along ax, y up, z along ax x up, origin o.
canal_frame=(o:vec3,ax:vec2)->mat4:
    x=normalize(ax);z=vec2(-x.y,x.x)
    mat4(vec4(x.x,0,x.y,0),vec4(0,1,0,0),vec4(z.x,0,z.y,0),vec4(o,1))
# A frame whose local +z points along toward (local x is then along the canal for a facade).
canal_facing=(o:vec3,toward:vec2)->mat4:
    t=normalize(toward)
    canal_frame(o,vec2(t.y,-t.x))

# A triangle and a quad (counter-clockwise from the side they face), transformed by m, uvs per corner.
canal_tri=(vs:mut Vertex3D[],p:vec3,q:vec3,r:vec3,col:vec4,m:mat4,up:vec2=vec2(0,0),uq:vec2=vec2(0,0),ur:vec2=vec2(0,0)):
    pw=transform_point(m,p);qw=transform_point(m,q);rw=transform_point(m,r)
    n=normalize(cross(qw-pw,rw-pw))
    vs.push(Vertex3D(pw,n,up,col));vs.push(Vertex3D(qw,n,uq,col));vs.push(Vertex3D(rw,n,ur,col))
canal_quad=(vs:mut Vertex3D[],a:vec3,b:vec3,c:vec3,d:vec3,col:vec4,m:mat4,ua:vec2=vec2(0,0),ub:vec2=vec2(0,0),uc:vec2=vec2(0,0),ud:vec2=vec2(0,0)):
    canal_tri(vs,a,b,c,col,m,ua,ub,uc);canal_tri(vs,a,c,d,col,m,ua,uc,ud)
# A rectangle on a +z face at depth z: centre (x, y), size (w, h).
canal_panel=(vs:mut Vertex3D[],x:f64,y:f64,z:f64,w:f64,h:f64,col:vec4,m:mat4,uv:vec2=vec2(0,0)):
    x0=f32(x-w*0.5);x1=f32(x+w*0.5);y0=f32(y-h*0.5);y1=f32(y+h*0.5);zz=f32(z)
    canal_quad(vs,vec3(x0,y0,zz),vec3(x1,y0,zz),vec3(x1,y1,zz),vec3(x0,y1,zz),col,m,uv,uv,uv,uv)
# A window or door: a quad tagged for the painted recess (dark top and side inside its frame).
canal_opening=(vs:mut Vertex3D[],x:f64,y:f64,z:f64,w:f64,h:f64,col:vec4,m:mat4):
    x0=f32(x-w*0.5);x1=f32(x+w*0.5);y0=f32(y-h*0.5);y1=f32(y+h*0.5);zz=f32(z)
    canal_quad(vs,vec3(x0,y0,zz),vec3(x1,y0,zz),vec3(x1,y1,zz),vec3(x0,y1,zz),col,m,vec2(180,0),vec2(181,0),vec2(181,1),vec2(180,1))
canal_plaster=(vs:mut Vertex3D[],c:vec3,size:vec3,col:vec4,m:mat4):
    start=vs.len()
    add_box(vs,c,size,col,m)
    loop k in start..vs.len():vs[k].uv=vec2(182,0)

# Roof pitches facing north (the world's -z) are painted darker: the film's lit and shaded pitch.
canal_pitch=(col:vec4,m:mat4,n:vec3)->vec4:
    w=(m*vec4(n,0)).xyz
    shade=if f64(w.z)< -0.15:0.74 else:if f64(w.z)<0.15:0.86 else:1.0
    vec4(col.x*f32(shade),col.y*f32(shade),col.z*f32(shade),col.w)

# A hipped roof over a w x d footprint (ridge along x) from height y, rising by rise.
canal_hip=(vs:mut Vertex3D[],w:f64,d:f64,y:f64,rise:f64,col:vec4,m:mat4,eave:f64=0.45):
    hw=f32(w*0.5+eave);hd=f32(d*0.5+eave);yy=f32(y);top=f32(y+rise)
    ridge=f32(max(0.0,w*0.5-d*0.5))
    a=vec3(-hw,yy,-hd);b=vec3(hw,yy,-hd);c=vec3(hw,yy,hd);e=vec3(-hw,yy,hd)
    ra=vec3(-ridge,top,0);rb=vec3(ridge,top,0)
    canal_tri(vs,e,c,rb,canal_pitch(col,m,vec3(0,0.6,0.8)),m);canal_tri(vs,e,rb,ra,canal_pitch(col,m,vec3(0,0.6,0.8)),m)
    canal_tri(vs,b,a,ra,canal_pitch(col,m,vec3(0,0.6,-0.8)),m);canal_tri(vs,b,ra,rb,canal_pitch(col,m,vec3(0,0.6,-0.8)),m)
    canal_tri(vs,a,e,ra,canal_pitch(col,m,vec3(-0.8,0.6,0)),m);canal_tri(vs,c,b,rb,canal_pitch(col,m,vec3(0.8,0.6,0)),m)
# A mansard: a steep slate skirt from y up to y+rise, set in by inset, and a flat top.
canal_mansard=(vs:mut Vertex3D[],w:f64,d:f64,y:f64,rise:f64,inset:f64,m:mat4):
    hw=f32(w*0.5+0.2);hd=f32(d*0.5+0.2);iw=f32(w*0.5-inset);id=f32(d*0.5-inset);y0=f32(y);y1=f32(y+rise)
    lo=[vec3(-hw,y0,hd),vec3(hw,y0,hd),vec3(hw,y0,-hd),vec3(-hw,y0,-hd)]
    hi=[vec3(-iw,y1,id),vec3(iw,y1,id),vec3(iw,y1,-id),vec3(-iw,y1,-id)]
    normals=[vec3(0,0.3,1),vec3(1,0.3,0),vec3(0,0.3,-1),vec3(-1,0.3,0)]
    loop k in 0..4:
        j=(k+1)%4
        canal_quad(vs,lo[k],lo[j],hi[j],hi[k],canal_pitch(CANAL_SLATE,m,normals[k]),m)
    canal_quad(vs,hi[0],hi[1],hi[2],hi[3],rgb(0.38,0.40,0.43),m)
# A chimney stack on a roof.
canal_stack=(vs:mut Vertex3D[],x:f64,y:f64,z:f64,col:vec4,m:mat4):
    add_box(vs,vec3(f32(x),f32(y+0.9),f32(z)),vec3(0.9,1.8,0.7),col,m)
    add_box(vs,vec3(f32(x),f32(y+1.9),f32(z)),vec3(1.1,0.2,0.9),rgb(0.40,0.38,0.36),m)

# ---------------- facades ----------------

# A city block in its own frame: x along the street front (w), z toward the canal (front at +d/2),
# y up from its ground. detail 0: the far proxy; 1: openings and trim; 2: shutters, sills and
# balconies too (the front row). works: a warehouse or works on the wall. flat: a flat roof with a
# low parapet (canal_ground_fire.jo's riflemen stand on these, 0.3 m over the block's top).
canal_block=(vs:mut Vertex3D[],m:mat4,w:f64,d:f64,h:f64,seed:int,detail:int,flat:bool,works:bool):
    hs=canal_hash(seed)
    wall=if works:(if hs%3==0:CANAL_BRICK else:CANAL_WALLS[(hs/3)%3+1]) else:if hs%7==0:CANAL_ACCENTS[(hs/7)%CANAL_ACCENTS.len()] else:CANAL_WALLS[(hs/5)%CANAL_WALLS.len()]
    shutter=CANAL_SHUTTERS[(hs/11)%CANAL_SHUTTERS.len()]
    fz=d*0.5
    canal_plaster(vs,vec3(0,f32(h*0.5-1.0),0),vec3(f32(w),f32(h+2.0),f32(d)),wall,m)
    # The roof: flat with a parapet, a slate mansard, a hipped tile roof, or a works' low zinc one.
    roofing=if flat:0 else:if works:3 else:if (hs/13)%5<2:1 else:2
    if roofing==0:canal_plaster(vs,vec3(0,f32(h+0.15),0),vec3(f32(w+0.3),0.3,f32(d+0.3)),wall,m)
    else if roofing==1:canal_mansard(vs,w,d,h,3.0,1.3,m)
    else if roofing==2:canal_hip(vs,w,d,h,min(w,d)*0.24,if (hs/17)%6==0:rgb(0.62,0.40,0.32) else:CANAL_TILE,m)
    else:canal_hip(vs,w,d,h,min(w,d)*0.14,CANAL_ZINC,m,0.3)
    if detail==0:
        # (the far proxy: a band of dark windows across the front)
        canal_panel(vs,0,h*0.55,fz+0.05,w*0.8,h*0.45,rgba(0.14,0.16,0.20,0.5),m)
        return
    # Base course, string course and cornice: the facade's horizontal depth.
    ground_floor=if works:6.6 else:4.6
    add_box(vs,vec3(0,f32(ground_floor*0.5-0.6),f32(fz+0.06)),vec3(f32(w+0.12),f32(ground_floor+1.2),0.12),if works:wall else:CANAL_BASE,m)
    add_box(vs,vec3(0,f32(ground_floor),f32(fz+0.12)),vec3(f32(w+0.2),0.22,0.25),CANAL_TRIM,m)
    if roofing!=3:
        add_box(vs,vec3(0,f32(h-0.25),0),vec3(f32(w+0.9),0.5,f32(d+0.9)),CANAL_TRIM,m)
        add_box(vs,vec3(0,f32(h-0.7),f32(fz+0.08)),vec3(f32(w+0.2),0.4,0.16),vec4(wall.x*0.92,wall.y*0.92,wall.z*0.92,1),m)
    # Openings on the front: arched shop fronts and doors below, framed windows above.
    storey=if works:4.4 else:3.5
    floors=max(1,int((h-ground_floor)/storey+0.01))
    bays=max(2,int(w/(if works:4.6 else:3.4)))
    spacing=w/f64(bays)
    balcony=detail>=2 and not works and (hs/19)%5<2
    shutters=detail>=2 and not works and (hs/23)%5<3
    loop k in 0..bays:
        x=-w*0.5+spacing*(f64(k)+0.5)
        door=(k+hs)%3==0
        if works:canal_opening(vs,x,2.4,fz+0.14,spacing*0.62,4.4,rgb(0.20,0.18,0.16),m)
        else:canal_opening(vs,x,if door:1.55 else:1.9,fz+0.14,if door:1.6 else:2.0,if door:3.1 else:2.2,if door:rgb(0.26,0.20,0.15) else:CANAL_GLASS,m)
        loop f in 0..floors:
            y=ground_floor+storey*f64(f)+1.7
            lit=canal_hash(seed*31+k*7+f*13)%7==0
            closed=shutters and canal_hash(seed*17+k*5+f*3)%4==0
            ww=if works:1.8 else:1.15
            wh=if works:2.4 else:if f==0 and balcony:2.2 else:1.8
            if closed:canal_panel(vs,x,y,fz+0.04,ww+0.1,wh,shutter,m)
            else:
                canal_panel(vs,x,y,fz+0.025,ww+0.36,wh+0.3,CANAL_TRIM,m)
                canal_opening(vs,x,y,fz+0.04,ww,wh,if lit:rgba(0.16,0.19,0.23,0.5) else:CANAL_GLASS,m)
            if detail<2:continue
            if shutters and not closed:
                canal_panel(vs,x-ww*0.5-0.33,y,fz+0.05,0.6,wh,shutter,m)
                canal_panel(vs,x+ww*0.5+0.33,y,fz+0.05,0.6,wh,shutter,m)
            # sill and lintel
            canal_panel(vs,x,y-wh*0.5-0.07,fz+0.2,ww+0.4,0.14,CANAL_TRIM,m)
            if not works:canal_panel(vs,x,y+wh*0.5+0.18,fz+0.03,ww+0.3,0.3,CANAL_TRIM,m)
            if balcony and f==0:
                add_box(vs,vec3(f32(x),f32(y-wh*0.5-0.08),f32(fz+0.45)),vec3(f32(ww+0.9),0.16,0.9),CANAL_TRIM,m)
                add_box(vs,vec3(f32(x),f32(y-wh*0.5+0.9),f32(fz+0.86)),vec3(f32(ww+0.9),0.06,0.06),CANAL_IRON,m)
                add_box(vs,vec3(f32(x),f32(y-wh*0.5+0.45),f32(fz+0.86)),vec3(f32(ww+0.8),0.8,0.02),vec4(CANAL_IRON.x,CANAL_IRON.y,CANAL_IRON.z,1),m)
    # Openings on the two ends (seen across squares and down the canal).
    side_bays=max(1,int(d/4.2))
    loop end in [-1.0,1.0]:
        turn=m*rotation_y(end*PI*0.5)
        loop k in 0..side_bays:
            x=-d*0.5+d/f64(side_bays)*(f64(k)+0.5)
            loop f in 0..floors:
                if (k+f+seed)%2==0:canal_opening(vs,x,ground_floor+storey*f64(f)+1.7,w*0.5+0.04,1.1,1.7,CANAL_GLASS,turn)
    # Stains under the cornice and at the base: one or two per facade.
    if detail>=2:
        stain=vec4(wall.x*0.86,wall.y*0.86,wall.z*0.84,1)
        canal_panel(vs,-w*0.25+f64(hs%5),h-2.4,fz+0.02,2.2+f64(hs%3),2.6,stain,m)
        if hs%2==0:canal_panel(vs,w*0.3-f64(hs%4),ground_floor+1.2,fz+0.02,3.0,1.5,stain,m)
    # Chimney stacks.
    if roofing!=0:
        loop c in 0..1+hs%2:
            canal_stack(vs,(f64(c)-0.5)*w*0.5,h+(if roofing==1:2.6 else:min(w,d)*0.12),-d*0.2,rgb(0.62,0.55,0.48),m)
    # A shop awning on some ground floors facing the water.
    if detail>=2 and not works and hs%4==1:
        x=-w*0.5+spacing*(f64(hs%bays)+0.5)
        canal_quad(vs,vec3(f32(x-1.3),3.6,f32(fz+0.1)),vec3(f32(x-1.3),3.0,f32(fz+1.5)),vec3(f32(x+1.3),3.0,f32(fz+1.5)),vec3(f32(x+1.3),3.6,f32(fz+0.1)),
            if hs%8==1:rgb(0.55,0.30,0.24) else:rgb(0.36,0.45,0.40),m)

# ---------------- skyline ----------------

# A domed church: nave, drum, a copper or lead dome, and a lantern.
canal_church=(vs:mut Vertex3D[],m:mat4,seed:int):
    wall=CANAL_WALLS[seed%3]
    canal_plaster(vs,vec3(0,6,0),vec3(14,14,22),wall,m)
    canal_hip(vs,14,22,13,3.4,CANAL_TILE,m)
    add_box(vs,vec3(0,12.9,0),vec3(15,0.6,23),CANAL_TRIM,m)
    canal_opening(vs,0,3.2,11.05,3.0,5.0,rgb(0.24,0.19,0.15),m*rotation_y(0))
    add_cylinder(vs,vec3(0,13,0),5.6,6.0,wall,12,-1.0,m)
    add_cylinder(vs,vec3(0,18.8,0),6.0,0.6,CANAL_TRIM,12,-1.0,m)
    dome=if seed%2==0:CANAL_COPPER else:rgb(0.48,0.50,0.53)
    loop r in 0..4:
        a0=PI*0.5*f64(r)/4.0;a1=PI*0.5*f64(r+1)/4.0
        add_cylinder(vs,vec3(0,f32(19.4+sin(a0)*5.8),0),5.8*cos(a0),5.8*(sin(a1)-sin(a0)),dome,12,5.8*cos(a1),m)
    add_cylinder(vs,vec3(0,25.2,0),0.9,2.4,CANAL_TRIM,6,-1.0,m)
    add_cylinder(vs,vec3(0,27.6,0),1.0,1.6,dome,6,0.0,m)

# A bell tower: a square stone shaft, dark belfry openings and a pyramid or spire.
canal_tower=(vs:mut Vertex3D[],base:vec3,top:f64,m:mat4,seed:int):
    shaft=if seed%3==0:CANAL_BRICK else:rgb(0.80,0.76,0.66)
    height=top-f64(base.y)
    canal_plaster(vs,base+vec3(0,f32(height*0.5),0),vec3(5.2,f32(height),5.2),shaft,m)
    loop face in 0..4:
        turn=m*translation(base)*rotation_y(f64(face)*PI*0.5)
        canal_opening(vs,0,height-3.4,2.64,1.5,3.0,CANAL_GLASS,turn)
    add_box(vs,base+vec3(0,f32(height-1.2),0),vec3(5.9,0.4,5.9),CANAL_TRIM,m)
    add_box(vs,base+vec3(0,f32(height+0.2),0),vec3(5.9,0.4,5.9),CANAL_TRIM,m)
    if seed%2==0:add_cylinder(vs,base+vec3(0,f32(height+0.4),0),3.6,7.5,if seed%4==0:CANAL_COPPER else:CANAL_SLATE,4,0.0,m*translation(base)*rotation_y(PI*0.25)*translation(-base))
    else:add_cylinder(vs,base+vec3(0,f32(height+0.4),0),3.7,3.2,CANAL_TILE,4,0.0,m*translation(base)*rotation_y(PI*0.25)*translation(-base))

# A works chimney: tapered brick with a dark band at its crown.
canal_chimney=(vs:mut Vertex3D[],base:vec3,height:f64,m:mat4):
    add_cylinder(vs,base,1.3,height-1.2,CANAL_BRICK,8,0.85,m)
    add_cylinder(vs,base+vec3(0,f32(height-1.2),0),1.0,1.2,rgb(0.22,0.18,0.16),8,-1.0,m)

# ---------------- the banks ----------------

# A plane tree: pale trunk and a broad crown of round lobes in three values (lit top, mid, dark
# underside). uv (173, 0) marks foliage for the painted dabs without any wind bend.
canal_tree=(vs:mut Vertex3D[],at:vec3,seed:int,poplar:bool=false,detail:bool=true):
    add_cylinder(vs,at,if poplar:0.22 else:0.32,if poplar:9.0 else:5.6,rgb(0.52,0.50,0.42),if detail:6 else:4,0.14)
    start=vs.len()
    rings=if detail:3 else:2
    segments=if detail:6 else:5
    if poplar:
        add_sphere(vs,vec3(0,0,0),1.0,CANAL_LEAF[1],segments,rings+1,translation(at+vec3(0,9.5,0))*scaling(vec3(2.0,6.5,2.0)))
        add_sphere(vs,vec3(0,0,0),1.0,CANAL_LEAF[0],segments,rings,translation(at+vec3(0.4,11.5,0.3))*scaling(vec3(1.5,4.0,1.4)))
    else:
        add_sphere(vs,vec3(0,0,0),1.0,CANAL_LEAF[2],segments,rings,translation(at+vec3(0,6.2,0))*scaling(vec3(4.6,2.2,4.4)))
        lobes=if detail:4 else:3
        loop j in 0..lobes:
            a=f64(j)*TAU/f64(lobes)+f64(seed%7)
            r=2.2+f64((seed+j)%3)*0.4
            col=if j%2==0:CANAL_LEAF[1] else:CANAL_LEAF[0]
            add_sphere(vs,vec3(0,0,0),1.0,col,segments,rings,translation(at+vec3(f32(cos(a)*r),f32(7.4+f64(j%2)*0.8),f32(sin(a)*r)))*scaling(vec3(2.8,2.3,2.7)))
        add_sphere(vs,vec3(0,0,0),1.0,CANAL_LEAF[0],segments,rings,translation(at+vec3(0.3,9.2,-0.2))*scaling(vec3(2.6,1.9,2.5)))
    loop k in start..vs.len():vs[k].uv=vec2(173,0)

# A cast-iron lamp: base, fluted post, a lantern that glows after dark, a cap.
canal_lamp=(vs:mut Vertex3D[],at:vec3):
    add_box(vs,at+vec3(0,0.25,0),vec3(0.42,0.5,0.42),CANAL_IRON)
    add_cylinder(vs,at+vec3(0,0.5,0),0.09,3.6,CANAL_IRON,5,0.06)
    add_box(vs,at+vec3(0,4.3,0),vec3(0.42,0.6,0.42),rgba(0.95,0.86,0.58,0.8))
    add_cylinder(vs,at+vec3(0,4.6,0),0.34,0.38,CANAL_IRON,4,0.0)

# A standing figure in pale, neutral clothes; some with a hat.
canal_figure=(vs:mut Vertex3D[],at:vec3,facing:vec2,given:int):
    seed=abs(given)
    m=canal_facing(at,facing)
    coats=[rgb(0.82,0.79,0.70),rgb(0.40,0.40,0.42),rgb(0.62,0.58,0.50),rgb(0.30,0.32,0.38),rgb(0.70,0.64,0.58)]
    coat=coats[seed%coats.len()]
    add_box(vs,vec3(-0.12,0.42,0),vec3(0.16,0.84,0.18),rgb(0.24,0.23,0.24),m)
    add_box(vs,vec3(0.12,0.42,0),vec3(0.16,0.84,0.18),rgb(0.24,0.23,0.24),m)
    add_box(vs,vec3(0,1.2,0),vec3(0.46,0.76,0.28),coat,m)
    add_sphere(vs,vec3(0,1.75,0),0.13,rgb(0.80,0.62,0.50),6,3,m)
    if seed%3!=0:add_cylinder(vs,vec3(0,1.84,0),0.2,0.08,if seed%2==0:rgb(0.86,0.80,0.62) else:rgb(0.26,0.25,0.25),8,0.13,m)

# A wall's length: dark stone face with a wet band at the water and coursed joints, its coping or
# parapet, the street's paving behind, and the drop at the street's back edge.
canal_bank_mesh=(vs:mut Vertex3D[],bank:CanalBank,origin:vec3,along0:f64):
    water=f32(bank.water);street=f32(bank.street)
    base=water-1.0
    a=vec3(bank.a.x-origin.x,0,bank.a.y-origin.z);b=vec3(bank.b.x-origin.x,0,bank.b.y-origin.z)
    out=vec3(bank.out.x,0,bank.out.y)
    # (a to b runs with the street on its left-hand normal, whichever bank this is)
    if f64(dot(vec2(-(b-a).z,(b-a).x),out.xz))<0.0:
        t=a;a=b;b=t
    length=f64(length(b-a))
    m=mat4()
    dir=normalize(b-a)
    face=(t0:f64,t1:f64,top0:f32,top1:f32,across:f32,col:vec4)->(f64,f64,f32,f32,f32,vec4):(t0,t1,top0,top1,across,col)
    faces:(f64,f64,f32,f32,f32,vec4)[]
    # A stair down to the water cuts the face: its flight, landing and the recess's back wall.
    cut=bank.stair.z!=0.0
    ta=0.0;tf=0.0;tl=0.0
    if cut:
        od=normalize(bank.b-bank.a);centre=(bank.a+bank.b)*0.5
        param=(t:f32)->f64:
            q=centre+od*t
            f64(dot(vec3(q.x-origin.x,0,q.y-origin.z)-a,dir))
        ta=param(bank.stair.x);tf=param(bank.stair.y);tl=param(bank.stair.z)
        lo=min(ta,tl);hi=max(ta,tl)
        landing=water+0.45
        faces=[face(0.0,lo,street,street,0.0,CANAL_WALL_STONE),face(hi,length,street,street,0.0,CANAL_WALL_STONE),
            face(min(ta,tf),max(ta,tf),if ta<tf:street else:landing,if ta<tf:landing else:street,0.0,CANAL_WALL_STONE),
            face(min(tf,tl),max(tf,tl),landing,landing,0.0,CANAL_WALL_STONE),face(min(ta,tl),max(ta,tl),street,street,1.8,CANAL_WALL_STONE)]
    else:faces=[face(0.0,length,street,street,0.0,CANAL_WALL_STONE)]
    loop f in faces:
        # (each face leans back 0.3 m over its height)
        t0,t1,top0,top1,across,col=f
        p0=a+dir*f32(t0)+out*across;p1=a+dir*f32(t1)+out*across
        l0=out*(0.3*(top0-base)/(street-base));l1=out*(0.3*(top1-base)/(street-base))
        ua=f32(184.0+(along0+t0)/1024.0);ub=f32(184.0+(along0+t1)/1024.0)
        canal_quad(vs,p1+vec3(0,base,0),p0+vec3(0,base,0),p0+l0+vec3(0,top0,0),p1+l1+vec3(0,top1,0),col,m,vec2(ub,base),vec2(ua,base),vec2(ua,top0),vec2(ub,top1))
    u0=f32(184.0+along0/1024.0);u1=f32(184.0+(along0+length)/1024.0)
    lean=out*0.3
    canal_quad(vs,b+vec3(0,base,0)-out*0.02,a+vec3(0,base,0)-out*0.02,a+vec3(0,water+0.7,0)-out*0.02,b+vec3(0,water+0.7,0)-out*0.02,CANAL_WET_STONE,m)
    inner=out*f32(bank.terrace)
    # The street's paving, and the drop at its back to the town's lanes behind.
    canal_quad(vs,a+lean+vec3(0,street,0),a+inner+vec3(0,street,0),b+inner+vec3(0,street,0),b+lean+vec3(0,street,0),CANAL_PAVING,m,vec2(183,0),vec2(183,0),vec2(183,0),vec2(183,0))
    canal_quad(vs,b+inner+vec3(0,street,0),a+inner+vec3(0,street,0),a+inner+vec3(0,street-3.2,0),b+inner+vec3(0,street-3.2,0),CANAL_WALL_STONE,m,
        vec2(u1,street),vec2(u0,street),vec2(u0,street-3.2),vec2(u1,street-3.2))
    mid=(a+b)*0.5
    frame=canal_frame(mid,dir.xz)
    # (in the frame: x along the wall, z out from the canal into the street)
    if bank.parapet:
        pieces:(f64,f64)[]=if cut:[(-length*0.5,min(ta,tl)-length*0.5),(max(ta,tl)-length*0.5,length*0.5)] else:[(-length*0.5,length*0.5)]
        loop piece in pieces:
            c=f32((piece.0+piece.1)*0.5);l=f32(piece.1-piece.0+0.06)
            add_box(vs,vec3(c,street+0.5,0.55),vec3(l,1.0,0.5),CANAL_BRIDGE_STONE,frame)
            add_box(vs,vec3(c,street+1.06,0.55),vec3(l,0.12,0.62),CANAL_COPING,frame)
    else:
        add_box(vs,vec3(0,street+0.08,0.6),vec3(f32(length+0.06),0.16,1.4),CANAL_COPING,frame)
        if bank.front==2:
            # (the yard's iron rail along its low quay)
            add_box(vs,vec3(0,street+1.0,0.3),vec3(f32(length),0.06,0.06),CANAL_IRON,frame)
            k=0
            loop k<int(length/2.5):
                add_box(vs,vec3(f32(-length*0.5+(f64(k)+0.5)*2.5),street+0.5,0.3),vec3(0.06,1.0,0.06),CANAL_IRON,frame)
                k+=1
    # Mooring rings on the wall's face, a little over the water.
    k=0
    loop k<int(length/9.0):
        x=-length*0.5+(f64(k)+0.5)*9.0
        # (the face is the frame's -z side: a ring's dark plate on it, seen from the water)
        turn=frame*rotation_y(PI)
        canal_panel(vs,-x,f64(water)+1.1,0.06,0.36,0.36,CANAL_IRON,turn)
        k+=1

# The street's furniture on a promenade: a plane tree a segment, a lamp on the parapet every other,
# a bench, and now and then someone looking at the water.
canal_promenade=(near:mut Vertex3D[],far:mut Vertex3D[],bank:CanalBank,origin:vec3):
    if bank.front!=0 and bank.front!=4:return
    a=vec3(bank.a.x-origin.x,0,bank.a.y-origin.z);b=vec3(bank.b.x-origin.x,0,bank.b.y-origin.z)
    out=vec3(bank.out.x,0,bank.out.y);street=f32(bank.street)
    mid=(a+b)*0.5;dir=normalize(b-a)
    seed=abs(bank.local*3+(if bank.sign>0.0:1 else:0))+(if bank.local<0:int(abs(bank.a.x)) else:0)
    arm=bank.local<0
    if bank.front==0 and (not arm or canal_hash(seed)%3==0):
        tree=mid+out*4.2+vec3(0,street,0)
        poplar=canal_hash(seed)%5==0
        canal_tree(near,tree,seed,poplar)
        canal_tree(far,tree,seed,poplar,false)
    if (not arm and bank.local%2==0) or (arm and canal_hash(seed*3)%4==0):canal_lamp(near,a+out*0.55+vec3(0,street+1.1,0))
    if arm:return
    if canal_hash(seed*5)%3==0 and bank.front==0:
        bench=canal_frame(mid+dir*6.0+out*6.6+vec3(0,street,0),dir.xz)
        add_box(near,vec3(0,0.45,0),vec3(1.9,0.08,0.5),rgb(0.38,0.30,0.22),bench)
        add_box(near,vec3(0,0.8,0.24),vec3(1.9,0.5,0.06),rgb(0.38,0.30,0.22),bench)
        add_box(near,vec3(-0.85,0.22,0),vec3(0.08,0.44,0.45),CANAL_IRON,bench)
        add_box(near,vec3(0.85,0.22,0),vec3(0.08,0.44,0.45),CANAL_IRON,bench)
    if canal_hash(seed*7)%4==0:
        canal_figure(near,mid-dir*4.0+out*1.2+vec3(0,street,0),-out.xz,seed)
    if canal_hash(seed*11)%6==0:
        canal_figure(near,mid+dir*2.0+out*5.4+vec3(0,street,0),dir.xz,seed+1)
        canal_figure(near,mid+dir*2.7+out*5.6+vec3(0,street,0),-dir.xz,seed+2)

# ---------------- bridges ----------------

# A balustrade from x0 to x1 along the frame's x at depth z, following top(x): plinth, rail and
# balusters (quads, both faces).
canal_balustrade=(vs:mut Vertex3D[],bridge:CanalBridge,width:f64,x0:f64,x1:f64,z:f64,frame:mat4,stone:vec4):
    steps=12
    loop j in 0..steps:
        xa=x0+(x1-x0)*f64(j)/f64(steps);xb=x0+(x1-x0)*f64(j+1)/f64(steps)
        ya=f32(canal_bridge_top(bridge,xa,width));yb=f32(canal_bridge_top(bridge,xb,width))
        loop face in [-1.0,1.0]:
            zz=f32(z+face*0.22)
            p=vec3(f32(xa),ya,zz);q=vec3(f32(xb),yb,zz)
            lo=[p,q,q+vec3(0,0.25,0),p+vec3(0,0.25,0)]
            hi=[p+vec3(0,0.9,0),q+vec3(0,0.9,0),q+vec3(0,1.1,0),p+vec3(0,1.1,0)]
            if face>0.0:
                canal_quad(vs,lo[0],lo[1],lo[2],lo[3],stone,frame);canal_quad(vs,hi[0],hi[1],hi[2],hi[3],stone,frame)
            else:
                canal_quad(vs,lo[1],lo[0],lo[3],lo[2],stone,frame);canal_quad(vs,hi[1],hi[0],hi[3],hi[2],stone,frame)
        top=vec3(f32(xa),ya+1.1,f32(z-0.24));top2=vec3(f32(xb),yb+1.1,f32(z-0.24))
        canal_quad(vs,top,top+vec3(0,0,0.48),top2+vec3(0,0,0.48),top2,stone,frame)
        loop k in 0..3:
            x=f32(xa+(xb-xa)*(f64(k)+0.5)/3.0);y=f32(canal_bridge_top(bridge,f64(x),width))
            add_box(vs,vec3(x,y+0.57,f32(z)),vec3(0.13,0.66,0.13),stone,frame)

canal_bridge_mesh=(near:mut Vertex3D[],far:mut Vertex3D[],bridge:CanalBridge,origin:vec3):
    index=CANAL_BEGIN+bridge.local
    a=RIVER_NODES[index];b=RIVER_NODES[index+1]
    dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
    width=f64(a.w);water=f64(a.z);half=canal_bridge_half(bridge);reach=canal_bridge_reach(bridge)
    # (the bridge's frame: x across the canal along side, y over the water, z along the canal)
    frame=canal_frame(vec3(a.x-origin.x,f32(water),a.y-origin.z),side)
    span=width+reach
    if bridge.kind==CANAL_STONE:
        stone=CANAL_BRIDGE_STONE
        n=16
        loop j in 0..n:
            xa=-width+2.0*width*f64(j)/f64(n);xb=-width+2.0*width*f64(j+1)/f64(n)
            ua=f32(canal_bridge_under(bridge,xa,width));ub=f32(canal_bridge_under(bridge,xb,width))
            ta=f32(canal_bridge_top(bridge,xa,width));tb=f32(canal_bridge_top(bridge,xb,width))
            fa=f32(xa);fb=f32(xb);hz=f32(half)
            # the barrel's soffit (seen from below), the two faces, and the ring of voussoirs
            canal_quad(near,vec3(fa,ua,-hz),vec3(fb,ub,-hz),vec3(fb,ub,hz),vec3(fa,ua,hz),CANAL_SOFFIT,frame)
            canal_quad(far,vec3(fa,ua,-hz),vec3(fb,ub,-hz),vec3(fb,ub,hz),vec3(fa,ua,hz),CANAL_SOFFIT,frame)
            loop face in [-1.0,1.0]:
                z=f32(face*half)
                ring=f32(0.85)
                if face>0.0:
                    canal_quad(near,vec3(fa,ua,z),vec3(fb,ub,z),vec3(fb,tb,z),vec3(fa,ta,z),stone,frame,vec2(f32(184.0+xa/1024.0),ua),vec2(f32(184.0+xb/1024.0),ub),vec2(f32(184.0+xb/1024.0),tb),vec2(f32(184.0+xa/1024.0),ta))
                    canal_quad(far,vec3(fa,ua,z),vec3(fb,ub,z),vec3(fb,tb,z),vec3(fa,ta,z),stone,frame)
                    canal_quad(near,vec3(fa,ua,z+0.08),vec3(fb,ub,z+0.08),vec3(fb,ub+ring,z+0.08),vec3(fa,ua+ring,z+0.08),rgb(0.74,0.71,0.63),frame)
                else:
                    canal_quad(near,vec3(fb,ub,z),vec3(fa,ua,z),vec3(fa,ta,z),vec3(fb,tb,z),stone,frame,vec2(f32(184.0+xb/1024.0),ub),vec2(f32(184.0+xa/1024.0),ua),vec2(f32(184.0+xa/1024.0),ta),vec2(f32(184.0+xb/1024.0),tb))
                    canal_quad(far,vec3(fb,ub,z),vec3(fa,ua,z),vec3(fa,ta,z),vec3(fb,tb,z),stone,frame)
                    canal_quad(near,vec3(fb,ub,z-0.08),vec3(fa,ua,z-0.08),vec3(fa,ua+ring,z-0.08),vec3(fb,ub+ring,z-0.08),rgb(0.74,0.71,0.63),frame)
        # the road over it, onto the abutments either side
        m=16
        loop j in 0..m:
            xa=-span+2.0*span*f64(j)/f64(m);xb=-span+2.0*span*f64(j+1)/f64(m)
            ta=f32(canal_bridge_top(bridge,xa,width));tb=f32(canal_bridge_top(bridge,xb,width))
            hz=f32(half)
            canal_quad(near,vec3(f32(xa),ta,hz),vec3(f32(xb),tb,hz),vec3(f32(xb),tb,-hz),vec3(f32(xa),ta,-hz),CANAL_PAVING,frame,vec2(183,0),vec2(183,0),vec2(183,0),vec2(183,0))
            canal_quad(far,vec3(f32(xa),ta,hz),vec3(f32(xb),tb,hz),vec3(f32(xb),tb,-hz),vec3(f32(xa),ta,-hz),CANAL_PAVING,frame)
        # abutment faces over the street, the keystones, pilasters framing the arch on the walls
        loop sign in [-1.0,1.0]:
            x0=f32(sign*width);x1=f32(sign*span);t=f32(canal_bridge_top(bridge,width,width))
            loop face in [-1.0,1.0]:
                add_box(near,vec3((x0+x1)*0.5,f32((CANAL_STREET-1.0+f64(t))*0.5),f32(face*half)),vec3(abs(x1-x0),f32(f64(t)-CANAL_STREET+1.0),0.2),stone,frame)
                add_box(near,vec3(f32(sign*(width-0.4)),f32((f64(t)-1.0)*0.5),f32(face*(half+0.15))),vec3(1.0,f32(f64(t)+1.0),0.5),rgb(0.70,0.67,0.59),frame)
            canal_balustrade(near,bridge,width,-span,span,sign*(half-0.25),frame,stone)
            canal_lamp(near,transform_point(frame,vec3(x1-f32(sign*0.6),t,f32(sign*(half-0.3)))))
        loop face in [-1.0,1.0]:
            add_box(near,vec3(0,f32(bridge.crown+0.45),f32(face*(half+0.12))),vec3(1.0,1.1,0.3),rgb(0.78,0.75,0.67),frame)
        canal_figure(near,transform_point(frame,vec3(f32(width*0.3),f32(canal_bridge_top(bridge,width*0.3,width)),f32(half-0.9))),(frame*vec4(0,0,1,0)).xz,bridge.local)
        if bridge.local%2==0:canal_figure(near,transform_point(frame,vec3(f32(-width*0.4),f32(canal_bridge_top(bridge,width*0.4,width)),f32(-half+0.9))),(frame*vec4(0,0,-1,0)).xz,bridge.local+3)
        return
    iron=CANAL_IRON
    top=f32(bridge.deck)
    if bridge.kind==CANAL_PIPES:
        # two big pipes on a lattice girder, carried by towers on the walls
        loop p in [-0.45,0.45]:
            add_cylinder(near,vec3(0,0,0),0.5,f64(span*2.0),rgb(0.36,0.38,0.38),8,-1.0,frame*translation(vec3(f32(-span),f32(bridge.crown+0.55+p*0.4),f32(p)))*rotation_z(-PI*0.5))
            add_cylinder(far,vec3(0,0,0),0.5,f64(span*2.0),rgb(0.36,0.38,0.38),6,-1.0,frame*translation(vec3(f32(-span),f32(bridge.crown+0.55+p*0.4),f32(p)))*rotation_z(-PI*0.5))
        add_box(near,vec3(0,f32(bridge.crown-0.2),0),vec3(f32(span*2.0),0.25,1.6),iron,frame)
        loop sign in [-1.0,1.0]:
            add_box(near,vec3(f32(sign*(width+1.2)),f32((bridge.crown+1.5)*0.5),0),vec3(1.6,f32(bridge.crown+1.5),1.6),rgb(0.40,0.38,0.35),frame)
        j=0
        loop j<int(width):
            x=-width+f64(j)*2.0
            town_beam(near,vec3(f32(x),f32(bridge.crown-0.2),-0.7),vec3(f32(x+2.0),f32(bridge.crown+0.4),-0.7),0.05,iron,frame)
            town_beam(near,vec3(f32(x),f32(bridge.crown-0.2),0.7),vec3(f32(x+2.0),f32(bridge.crown+0.4),0.7),0.05,iron,frame)
            j+=1
        return
    # an iron deck; a truss's girders either side, or a footbridge's lattice rails
    thick=f32(if bridge.kind==CANAL_TRUSS:0.8 else:0.5)
    add_box(near,vec3(0,top-thick*0.5,0),vec3(f32(span*2.0),thick,f32(half*2.0)),iron,frame)
    add_box(far,vec3(0,top-thick*0.5,0),vec3(f32(span*2.0),thick,f32(half*2.0)),iron,frame)
    canal_quad(near,vec3(f32(-span),top+0.01,f32(half)),vec3(f32(span),top+0.01,f32(half)),vec3(f32(span),top+0.01,f32(-half)),vec3(f32(-span),top+0.01,f32(-half)),rgb(0.46,0.42,0.36),frame)
    rail=f32(if bridge.kind==CANAL_TRUSS:3.2 else:1.1)
    bay=if bridge.kind==CANAL_TRUSS:3.0 else:1.4
    loop face in [-1.0,1.0]:
        z=f32(face*(half-0.1))
        add_box(near,vec3(0,top+rail,z),vec3(f32(span*2.0),0.16,0.2),iron,frame)
        add_box(far,vec3(0,top+rail*0.5,z),vec3(f32(span*2.0),rail,0.08),iron,frame)
        add_box(near,vec3(0,top+0.1,z),vec3(f32(span*2.0),0.2,0.2),iron,frame)
        j=0
        loop f64(j)*bay<span*2.0:
            x=-span+f64(j)*bay
            add_box(near,vec3(f32(x),top+rail*0.5,z),vec3(0.12,rail,0.12),iron,frame)
            up=if j%2==0:f64(rail) else:0.1
            down=if j%2==0:0.1 else:f64(rail)
            town_beam(near,vec3(f32(x),top+f32(down),z),vec3(f32(x+bay),top+f32(up),z),0.05,iron,frame)
            j+=1
    loop sign in [-1.0,1.0]:
        canal_lamp(near,transform_point(frame,vec3(f32(sign*(width+reach-0.5)),top,f32(half-0.4))))
        if bridge.kind==CANAL_TRUSS:
            # (masonry piers on the walls carry the girders)
            add_box(near,vec3(f32(sign*(width+1.0)),f32((f64(top)-0.8)*0.5),0),vec3(2.0,f32(f64(top)-0.8+1.0),f32(half*2.0+0.6)),CANAL_BRIDGE_STONE,frame)
    canal_figure(near,transform_point(frame,vec3(f32(width*0.2),top,f32(half-0.7))),(frame*vec4(0,0,1,0)).xz,bridge.local)
