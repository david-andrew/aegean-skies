# Original short plucked phrases. Only a present, arrived musician can be heard.
# Cosmetic sound phase never reads or advances the world's random streams.
use 'living_types.jo'
use 'life_types.jo'

struct LifeAudio:
    notes: Sound[]
    last_beat = -1

build_life_audio = () -> LifeAudio:
    result = LifeAudio()
    if env("SLOPPY_NO_AUDIO") != none: return result
    loop semitone in [0,2,3,5,7,9,10,12]:
        hz = 293.6648*pow(2.0,f64(semitone)/12.0)
        samples = fill(f32(0),int(f64(MIX_RATE)*0.75)*2)
        loop k in 0..samples.len()/2:
            t = f64(k)/f64(MIX_RATE)
            v = 0.0
            loop harmonic in 1..7:
                v += sin(TAU*hz*f64(harmonic)*t)*exp(-t*(5.0+f64(harmonic)*1.5))/pow(f64(harmonic),1.3)
            v *= min(1.0,t*1200.0)*0.26
            samples[k*2] = f32(v); samples[k*2+1] = f32(v)
        result.notes.push(Sound(samples))
    result

update_life_audio = (sound: mut LifeAudio, w: World, listener: vec3, t: f64):
    if sound.notes.len() == 0: return
    beat = int(t*3.0)
    if beat == sound.last_beat: return
    sound.last_beat = beat
    # At most the closest performer, one short note per beat; no distant square sound pool.
    best = -1; distance = 70.0
    loop person, intent in w.daily_life:
        p = w.people[person]
        if p.place < 0 or p.trip >= 0 or p.carriage >= 0 or intent.activity != .play or not intent.arrived: continue
        d = f64(length(p.pose.pos-listener))
        if d < distance or d == distance and person < best: distance = d; best = person
    if best < 0: return
    phrase = [0,2,4,2,1,3,5,3,2,4,6,4,3,2,1,-1]
    note = phrase[(beat+best*3)%phrase.len()]
    if note >= 0: play_at(sound.notes[note],w.people[best].pose.pos+vec3(0,1.2,0),0.20,70.0)
