# Original short plucked phrases. Only a present, arrived musician can be heard.
# Cosmetic sound phase never reads or advances the world's random streams.
use 'living_types.jo'
use 'life_types.jo'
use 'ambience_synth.jo'

struct LifeNote:
    voice: int
    expires: f64
    pos: vec3
    soft: f64

struct LifeAudio:
    notes: Sound[]
    reflections: Sound[]
    soft: Sound[]
    soft_reflections: Sound[]
    voices: LifeNote[]
    last_beat = -1

make_life_note = (semitone: int) -> Sound:
    hz = 293.6648*pow(2.0,f64(semitone)/12.0)
    samples = fill(f32(0),int(f64(MIX_RATE)*0.75)*2)
    loop k in 0..samples.len()/2:
        t = f64(k)/f64(MIX_RATE)
        v = 0.0
        loop harmonic in 1..7:
            v += sin(TAU*hz*f64(harmonic)*t)*exp(-t*(5.0+f64(harmonic)*1.5))/pow(f64(harmonic),1.3)
        v *= min(1.0,t*1200.0)*0.26
        samples[k*2] = f32(v); samples[k*2+1] = f32(v)
    Sound(samples)

build_life_audio = () -> LifeAudio:
    result = LifeAudio()
    if env("SLOPPY_NO_AUDIO") != none: return result
    loop semitone in [0,2,3,5,7,9,10,12]:
        note = make_life_note(semitone)
        reflected = ambience_square_reverb(note)
        result.notes.push(note); result.reflections.push(reflected)
        result.soft.push(ambience_soften(note)); result.soft_reflections.push(ambience_soften(reflected))
    result

hush_life_audio = (sound: mut LifeAudio):
    loop note in sound.voices: stop(note.voice)
    sound.voices = []; sound.last_beat = -1

update_life_audio = (sound: mut LifeAudio, w: World, listener: vec3, t: f64,enabled: bool = true,flying: bool = false,obstruction: (vec3,vec3) -> f64 = (a: vec3,b: vec3) -> f64: 0.0):
    if not enabled: hush_life_audio(sound); return
    alive: LifeNote[]
    loop note in sound.voices:
        if t >= note.expires: stop(note.voice)
        else:
            move_sound(note.voice,note.pos,(if flying: 0.012 else: 0.17)*(1-note.soft*0.72),70.0)
            alive.push(note)
    sound.voices = alive
    if sound.notes.len() == 0: return
    beat = int(t*3.0)
    if beat == sound.last_beat: return
    sound.last_beat = beat
    # At most the closest performer, one short note per beat; no distant square sound pool.
    best = -1; distance = 70.0
    loop person, intent in w.daily_life:
        p = w.people[person]
        if p.place < 0 or p.trip >= 0 or p.carriage >= 0 or intent.activity != .play or not intent.arrived: continue
        d = f64(length(p.pose.pos-listener))
        if d < distance or d == distance and person < best: distance = d; best = person
    if best < 0: return
    phrase = [0,2,4,2,1,3,5,3,2,4,6,4,3,2,1,-1]
    note = phrase[(beat+best*3)%phrase.len()]
    if note >= 0 and sound.voices.len() < 3:
        at = w.people[best].pose.pos+vec3(0,1.2,0)
        square = w.daily_life[best].venue == .square
        blocked = obstruction(at,listener)
        sample = if square: (if blocked > 0.4: sound.soft_reflections[note] else: sound.reflections[note]) else: (if blocked > 0.4: sound.soft[note] else: sound.notes[note])
        gain = (if flying: 0.012 else: 0.17)*(1.0-blocked*0.72)
        id = play_at(sample,at,gain,70.0)
        sound.voices.push(LifeNote(id,t+0.92,at,blocked))
