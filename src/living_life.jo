use 'world_point.jo'
# Minute-scale daily destinations and one saved walking plan, shared by near/far simulation.
use 'living_types.jo'
use 'life_types.jo'
use 'living_life_seed.jo'
use 'living_conditions.jo'
use 'living_portage.jo'
use 'living_boats.jo'
use 'living_calendar.jo'

life_free = (w: World, person: int) -> bool:
    if w.people[person].far_home>=0: return false
    p = w.people[person]
    if person == w.player or p.place < 0 or p.trip >= 0 or p.carriage >= 0 or p.carrying >= 0 or p.injured_until > w.minute or p.state == .departed: return false
    if p.local_work_escrow >= 0 or p.action.purpose == .repair or p.action.activity == .raid or p.action.activity == .patrol or p.action.activity == .fulfill: return false
    loop id in w.active_jobs:
        if w.jobs[id].carrier == person and w.jobs[id].state == .claimed: return false
    not (p.action.activity == .work and (p.action.purpose == .trade or p.action.purpose == .salvage))

life_mood = (w: World, person: int) -> int:
    p = w.people[person]
    value = 200-p.fatigue/2-p.alone_minutes/20+draw1000000(w.seed,112,person,day_index(w.minute))%61-30
    if p.injured_until > w.minute: value -= 400
    loop id in p.obligations:
        if not (id in w.obligations): continue
        o = w.obligations[id]
        if o.debtor == person and (o.state == .open or o.state == .blocked) and o.due_minute < w.minute and o.amount_cents > w.accounts[p.account].cents: value -= 180
    if p.id in w.daily_life and w.daily_life[p.id].meeting >= 0: value += 100
    clamp(value,-1000,1000)

life_daily_goal = (w: World, person: int) -> DailyIntent:
    p = w.people[person]
    intent = w.daily_life.get(person,DailyIntent(person,p.place))
    intent.place = p.place; intent.mood = life_mood(w,person)
    intent.mobility = .walking; intent.companion = -1
    clock = local_minute(w.minute); day = day_index(w.minute)
    rough = p.place >= 0 and (w.places[p.place].harbor_closed or weather_severity(w,p.pose.pos) >= 350)
    intent.until_minute = w.minute+15
    if p.injured_until > w.minute:
        intent.venue = .home; intent.activity = .rest; intent.reason = "I have been told to rest."
        intent.target = p.pose.pos; intent.arrived = true
        return intent
    if not life_free(w,person):
        intent.venue = if p.action.purpose == .repair: VenueKind.workshop else: VenueKind.quay
        intent.activity = .work; intent.reason = "I've something to finish first."
        intent.target = p.pose.pos; intent.arrived = true
        return intent
    if p.action.activity == .work:
        intent.venue = match p.occupation:
            .oil_presser, .miller: VenueKind.fields
            .priest: .church
            .teacher: .school
            .nurse: .home
            .mechanic: .workshop
            else: .quay
        intent.activity = .work; intent.reason = "This is where people expect to find me at this hour."
    else if rough:
        intent.venue = .shelter; intent.activity = .rest; intent.reason = "I can wait until the weather is kinder."
    else if clock < 300 or clock >= 1380:
        intent.venue = .home; intent.activity = .sleep; intent.reason = "The rest can wait until morning."
    else if day%7 == 6 and clock >= 600 and clock < 660:
        intent.venue = .church; intent.activity = .pray; intent.reason = "It's Sunday. I mean to keep a little of it."
    else if capital_feast_active(w,p.place,w.minute):
        intent.venue = .square; intent.activity = .listen; intent.reason = "The capital feast is in the square this evening."
    else if (day+1)%14 == 0 and clock >= 1020 and clock < 1260:
        intent.venue = .square; intent.activity = .listen; intent.reason = "It's the harbour blessing. There will be people in the square."
    else if clock >= 780 and clock < 900:
        intent.venue = .home; intent.activity = .rest; intent.reason = "A little quiet after the meal."
    else if p.occupation == .fisher and clock >= 300 and clock < 360:
        intent.venue = .quay; intent.activity = .work; intent.reason = "I want to be ready before the light comes."
    else if clock >= 420 and clock < 750:
        if p.occupation == .merchant or p.occupation == .quartermaster or p.occupation == .fisher:
            intent.venue = .market; intent.activity = .work; intent.reason = "The morning is when people bring their business."
        else if p.occupation == .mechanic:
            intent.venue = .workshop; intent.activity = .work; intent.reason = "There is always something to mend."
        else if p.occupation == .priest:
            intent.venue = .church; intent.activity = .work; intent.reason = "People know to find me by the church."
        else if p.occupation == .teacher:
            intent.venue = .school; intent.activity = .work; intent.reason = "The children will have questions enough without waiting for me."
        else:
            intent.venue = .quay; intent.activity = .wait; intent.reason = "I have a little business by the water."
    else if clock >= 1080 and clock < 1320 and (person == 4 or person == 13) and day%3 == person%3:
        intent.venue = .square; intent.activity = .play; intent.reason = "I have brought my instrument. Stay for a tune, if you like."
    else if clock >= 1080 and clock < 1170:
        intent.venue = .square; intent.activity = .stroll; intent.reason = "I want a walk before I sit down."
    else if clock >= 1170 and clock < 1320:
        intent.venue = if p.traits.sociability >= 600: VenueKind.cafe else: VenueKind.square
        intent.activity = .talk; intent.reason = "I'd like a little company before going home."
        if (person == 4 or person == 13) and day%3 == person%3:
            intent.venue = .square; intent.activity = .play; intent.reason = "I've brought my instrument. An evening ought to have a tune."
        else if p.traits.sociability < 450:
            intent.activity = .listen; intent.reason = "I don't mind listening from the edge of things."
    else if clock >= 1320:
        intent.venue = .home; intent.activity = .sleep; intent.reason = "I've had enough of the day."
    else:
        intent.venue = if p.occupation == .oil_presser or p.occupation == .miller: VenueKind.fields else: VenueKind.cafe
        intent.activity = if intent.venue == .fields: LifeActivity.work else: LifeActivity.talk
        intent.reason = if intent.venue == .fields: "I want to see how things stand outside town." else: "There's time for a word before the next thing."
    if person == 10 or person == 15 or person == 21:
        if not rough and intent.activity != .sleep and intent.activity != .rest: intent.mobility = .bicycle
    # An actual social engagement is a short commitment, not an all-day readiness lock.
    if not rough and intent.meeting >= 0 and intent.meeting in w.meetings:
        meeting = w.meetings[intent.meeting]
        if meeting.active and meeting.until_minute > w.minute:
            intent.venue = meeting.venue
            intent.activity = if intent.activity == .play: LifeActivity.play else: LifeActivity.talk
            intent.reason = "I've stopped to speak with someone."
            intent.until_minute = meeting.until_minute
    intent

set_life_destination = (w: mut World, person: int, desired: DailyIntent):
    old = w.daily_life[person]; next = desired
    if not life_free(w,person):
        next.route.clear(); next.waypoint = 0; next.last_tick = w.tick
        next.anchor = ""; next.blocked = ""; w.daily_life[person] = next; return
    chosen = choose_life_venue(w,next.place,next.venue,person)
    if chosen == none: chosen = choose_life_venue(w,next.place,.quay,person)
    if chosen == none:
        next.blocked = "There is nowhere suitable nearby."; next.last_tick = w.tick
        w.daily_life[person] = next; return
    site = chosen!
    # Friends use nearby slots of the same facility, rather than all occupying one point.
    side = vec3(-site.facing.z,0,site.facing.x)
    rank = 0
    loop other in w.people:
        if other.id > 0 and other.id < person and other.place == next.place: rank += 1
    slot = rank%max(1,site.capacity); row = rank/max(1,site.capacity)
    target = site.pos+side*f32((f64(slot)-f64(site.capacity-1)*0.5)*1.15)-site.facing*f32(f64(row)*1.35)
    if next.venue == .square or next.venue == .cafe:
        # Small conversational knots with room between them; quay work retains linear slots.
        corners = [vec2(-0.85,0),vec2(0.85,0),vec2(0,-1.25),vec2(0,1.25)]
        local = corners[rank%4]; cluster = rank/4
        target = site.pos+side*f32(f64(cluster-1)*4.4+f64(local.x))+site.facing*local.y
    if old.place != next.place or old.anchor != site.key or length(old.target-target) > 0.5 or (old.route.len() == 0 and old.blocked == ""):
        next.anchor = site.key; next.target = target
        next.route = cargo_walk_route(w,next.place,w.people[person].pose.pos,target)
        next.waypoint = 1; next.path_revision = old.path_revision+1
        next.blocked = ""; next.arrived = length(w.people[person].pose.pos-target) < 0.3
        next.since_minute = w.minute; next.last_tick = w.tick
    else:
        next.target = old.target; next.route = old.route; next.waypoint = old.waypoint
        next.last_tick = old.last_tick; next.arrived = old.arrived; next.path_revision = old.path_revision
    w.daily_life[person] = next

advance_life_motion = (w: mut World, target_tick: int, only_person: int = -1):
    people = if only_person >= 0: [only_person] else: w.daily_life.keys()
    people.sort()
    loop person in people:
        intent = w.daily_life[person]
        if not life_free(w,person) or w.people[person].move_owner == .scene: continue
        ticks = max(0,target_tick-intent.last_tick); w.daily_life[person].last_tick = target_tick
        if intent.arrived or intent.blocked != "": continue
        budget = f64(ticks)/60.0*(if intent.mobility == .bicycle: 3.4 else: 1.25)
        loop budget > 0 and w.daily_life[person].waypoint < intent.route.len():
            waypoint = w.daily_life[person].waypoint; target = intent.route[waypoint]
            point=pose_point(w.people[person].pose)
            delta = world_delta(world_point(target),point); distance = f64(length(delta))
            used = min(budget,distance)
            if distance > 0.001:
                place_pose(w.people[person].pose,world_offset(point,delta*f32(used/distance)))
                w.people[person].pose.rot = facing(delta)
            budget -= used
            if distance <= used+0.001: w.daily_life[person].waypoint += 1
            else: break
        if w.daily_life[person].waypoint >= intent.route.len(): w.daily_life[person].arrived = true

household_minute = (w: mut World):
    clock = local_minute(w.minute); sunday = day_index(w.minute)%7 == 6
    loop k in 0..w.households.len():
        advance_household_motion(w,k,w.tick)
        p = w.households[k]
        rough = w.places[p.home].harbor_closed or weather_severity(w,p.pose) >= 350
        venue = if rough or clock < 420 or clock >= 1260 or clock >= 780 and clock < 900: VenueKind.home else: if sunday and clock >= 600 and clock < 660: VenueKind.church else: if not sunday and clock >= 480 and clock < 780: VenueKind.school else: if clock >= 1020: VenueKind.square else: VenueKind.quay
        activity = if venue == .home: LifeActivity.sleep else: if venue == .school: LifeActivity.listen else: if venue == .church: LifeActivity.pray else: LifeActivity.stroll
        site = choose_life_venue(w,p.home,venue,p.guardian)
        if site == none: continue
        target = site!.pos+vec3(f32(f64(k%3)-1.0),0,f32(f64(k%2)*1.2))
        if venue != p.venue or length(target-p.target)>0.5:
            w.households[k].venue = venue; w.households[k].target = target; w.households[k].activity = activity
            w.households[k].route = cargo_walk_route(w,p.home,p.pose,target); w.households[k].waypoint = 1
            w.households[k].path_revision += 1
            w.households[k].blocked = false
        advance_household_motion(w,k,w.tick)

# One movement lease and one elapsed interval, shared with the scene adapter.
advance_household_motion = (w: mut World, k: int, target_tick: int):
    p = w.households[k]
    if p.scene_owned: return
    budget = f64(max(0,target_tick-p.last_tick))/60.0*1.1
    w.households[k].last_tick = target_tick
    if p.blocked: return
    loop budget > 0 and w.households[k].waypoint < w.households[k].route.len():
        index = w.households[k].waypoint; q = w.households[k].route[index]
        distance = f64(length(q-w.households[k].pose)); step = min(budget,distance)
        if distance > 0.001: w.households[k].pose = lerp(w.households[k].pose,q,f32(step/distance))
        budget -= step
        if distance <= step+0.001: w.households[k].waypoint += 1
        else: break

life_minute = (w: mut World):
    initialize_life(w)
    # Finish the previous minute under its existing owner/plan before choosing another destination.
    advance_life_motion(w,w.tick)
    if local_minute(w.minute) >= 330 and local_minute(w.minute) < 360:
        loop p in w.people:
            if p.occupation == .fisher and life_free(w,p.id) and p.place == p.home and not p.vice_active: begin_fishing(w,p.id)
    loop person in 1..core_person_count(w): set_life_destination(w,person,life_daily_goal(w,person))
    household_minute(w)
