# Transactions for coordinator-owned scene bodies. No Pool, materialization or UI adapter here.
use 'living_types.jo'
use 'living_money.jo'
use 'living_travel.jo'
use 'living_weather.jo'

pose_valid = (p: Pose) -> bool:
    is_finite(p.pos.x) and is_finite(p.pos.y) and is_finite(p.pos.z) and is_finite(p.vel.x) and is_finite(p.vel.y) and is_finite(p.vel.z) and is_finite(p.rot.x) and is_finite(p.rot.y) and is_finite(p.rot.z) and is_finite(p.rot.w) and length(p.vel) < 1000.0 and length(p.rot) > 0.5 and length(p.rot) < 1.5

# Return new revision or -1. Physics has already spent this fuel; account it once, never twice.
commit_scene_motion = (w: mut World, craft: int, revision: int, tick: int, pose: Pose, fuel_ml: int, hull: int, engine: int, resolved_incident: bool = false) -> int:
    if craft < 0 or craft >= w.aircraft.len() or tick != w.tick or not pose_valid(pose): return -1
    if w.aircraft[craft].move_owner != .scene or w.aircraft[craft].revision != revision or tick <= w.aircraft[craft].last_scene_tick: return -1
    if fuel_ml < 0 or fuel_ml > w.aircraft[craft].fuel_ml or hull < 0 or hull > w.aircraft[craft].hull or engine < 0 or engine > w.aircraft[craft].engine: return -1
    trip_id = w.aircraft[craft].trip
    if resolved_incident and trip_id >= 0: w.trips[trip_id].incident_resolved = true
    burn_fuel(w,craft,w.aircraft[craft].fuel_ml-fuel_ml)
    w.aircraft[craft].pose = pose; w.aircraft[craft].hull = hull; w.aircraft[craft].engine = engine
    w.aircraft[craft].last_scene_tick = tick; w.aircraft[craft].revision += 1
    if hull == 0 or fuel_ml == 0:
        trip = w.aircraft[craft].trip
        reason = if trip >= 0: w.trips[trip].reason else: Reason(purpose=.rescue,actor=w.aircraft[craft].owner)
        ditch(w,craft,reason)
    w.aircraft[craft].revision

query_scene_requests = (w: World) -> AirborneTrip[]: query_airborne(w)
