# Read-only presentation measurements. Never supplies controls, forces or attitudes to flight.
# Horizontal water speed follows the same taxi/scale transition as the contact solver.
use 'flight.jo'

struct FlightFeedback:
    ready = false
    previous_right = vec3(1,0,0)
    previous_vy = 0.0
    speed = 0.0
    water = 0.0
    slap = 0.0
    slap_hit = 0.0
    slap_quiet = 0.0
    climb = 0.0
    glide = 0.0
    buffet = 0.0
    roll = 0.0
    roll_lead = 0.0
    spray_credit = 0.0
    lens = 0.0

water_run_speed = (k: CraftSpec, s: CraftState) -> f64:
    v = f64(length(s.velocity.xz))
    v / (1.0 + (pure_k(k)-1.0)*smoothstep(6.0,25.0,v))

feedback_step = (f: mut FlightFeedback, k: CraftSpec, s: CraftState, load: f64, dt: f64):
    if dt <= 0: return
    h = min(dt,0.1)
    right = quat_rotate(s.orientation,vec3(1,0,0))
    up = quat_rotate(s.orientation,vec3(0,1,0))
    rate = if f.ready: atan2(f64(dot(f.previous_right,up)),f64(dot(f.previous_right,right)))/dt else: 0.0
    f.speed = true_speed(k,f64(length(s.velocity)))
    wet = s.on_water and not s.moored and not s.crashed and not s.capsized
    water = if wet: smoothstep(3.0,k.stall_speed*1.1,water_run_speed(k,s)) else: 0.0
    f.water += (water-f.water)*(1.0-exp(-18.0*h))
    # Wave slap is a measured upward impulse, not a timed camera shake. Touchdown damage
    # still uses the solver's contact work; this only lets elastic contacts be heard too.
    f.slap_hit = 0.0
    f.slap_quiet = max(0.0,f.slap_quiet-h)
    acceleration = if f.ready and wet: max(0.0,(f64(s.velocity.y)-f.previous_vy)/dt) else: 0.0
    if acceleration > 8.0 and f.slap_quiet <= 0 and water > 0.03:
        f.slap_hit = smoothstep(8.0,55.0,acceleration)
        f.slap_quiet = 0.16
    f.slap = max(f.slap*exp(-9.0*h),f.slap_hit)
    airborne = not s.on_water and not s.moored and not s.crashed and not s.capsized
    climb = if airborne: s.throttle*smoothstep(1.0,13.0,f64(s.velocity.y))*smoothstep(10.0,35.0,f.speed) else: 0.0
    glide = if airborne: (1.0-smoothstep(0.08,0.3,s.throttle))*smoothstep(18.0,65.0,f.speed) else: 0.0
    f.climb += (climb-f.climb)*(1.0-exp(-3.0*h))
    f.glide += (glide-f.glide)*(1.0-exp(-3.0*h))
    separated = max(f64(s.wing_separation.x),f64(s.wing_separation.y))
    buffet = if airborne: max(if s.stalled: 0.45 else: 0.0,max(separated,smoothstep(k.stall_angle*0.75,k.stall_angle,abs(s.aoa)))*0.75)*smoothstep(3.0,12.0,f.speed) else: 0.0
    f.buffet += (buffet-f.buffet)*(1.0-exp(-12.0*h))
    f.roll += ((if airborne: rate else: 0.0)-f.roll)*(1.0-exp(-9.0*h))
    # Camera-only whip; zero at ordinary bank-entry rates and bounded to 3 degrees.
    lead = -0.052*tanh(f.roll*0.45)*smoothstep(0.6,2.2,abs(f.roll))
    f.roll_lead += (lead-f.roll_lead)*(1.0-exp(-12.0*h))
    f.lens = max(f.lens*exp(-1.8*h),f.slap_hit*water)
    f.previous_vy = f64(s.velocity.y)
    f.previous_right = right
    f.ready = true

# Pitch modifier shared by the running mixer and the offline listening samples.
loaded_engine_note = (base: f64, climb: f64) -> f64: base*(1.0-0.12*clamp(climb,0.0,1.0))

prop_rotation_speed = (s: CraftState,speed: f64) -> f64:
    if s.fuel > 0 and not s.crashed: 8.0+70.0*s.throttle else: speed*0.65
