# Read-only presentation measurements. Never supplies controls, forces or attitudes to flight.
# Horizontal water speed follows the same taxi/scale transition as the contact solver.
use 'flight.jo'
use 'tweaks.jo'
use 'water_field.jo'
use 'geography.jo'
use 'damage.jo'
use 'hydrofoil.jo'

struct FlightFeedback:
    ready = false
    powered = false
    previous_right = vec3(1,0,0)
    previous_vy = 0.0
    speed = 0.0
    water = 0.0
    slap = 0.0
    slap_hit = 0.0
    slap_quiet = 0.0
    climb = 0.0
    glide = 0.0
    buffet = 0.0
    roll = 0.0
    roll_lead = 0.0
    spray_credit = 0.0
    blade_credit = 0.0              # (the hydrofoil racer's propeller blades cutting the sea)
    lens = 0.0

water_run_speed = (k: CraftSpec, s: CraftState) -> f64:
    v = f64(length(s.velocity.xz))
    scale=1.0+(pure_k(k)-1.0)*smoothstep(6.0,25.0,v)
    flow=if geography_enabled:water_current(craft_point(s).x,craft_point(s).z).xz else:vec2(0,0)
    f64(length(s.velocity.xz/f32(scale)-flow))

feedback_step = (f: mut FlightFeedback, k: CraftSpec, s: CraftState, load: f64, dt: f64,wind:vec3=vec3(0,0,0)):
    if dt <= 0: return
    h = min(dt,0.1)
    right = quat_rotate(s.orientation,vec3(1,0,0))
    up = quat_rotate(s.orientation,vec3(0,1,0))
    rate = if f.ready: atan2(f64(dot(f.previous_right,up)),f64(dot(f.previous_right,right)))/dt else: 0.0
    f.powered=s.fuel>0 and not s.crashed and not s.capsized and part_health(s.damage,.engine)>0
    f.speed = true_speed(k,f64(length(s.velocity-wind)))
    wet = s.on_water and not s.moored and not s.crashed and not s.capsized
    water = if wet: smoothstep(3.0,k.stall_speed*1.1,water_run_speed(k,s)) else: 0.0
    f.water += (water-f.water)*(1.0-exp(-18.0*h))
    # Wave slap is a measured upward impulse, not a timed camera shake. Touchdown damage
    # still uses the solver's contact work; this only lets elastic contacts be heard too.
    f.slap_hit = 0.0
    f.slap_quiet = max(0.0,f.slap_quiet-h)
    acceleration = if f.ready and wet: max(0.0,(f64(s.velocity.y)-f.previous_vy)/dt) else: 0.0
    if acceleration > 8.0 and f.slap_quiet <= 0 and water > 0.03:
        f.slap_hit = smoothstep(8.0,55.0,acceleration)
        f.slap_quiet = 0.16
    f.slap = max(f.slap*exp(-9.0*h),f.slap_hit)
    airborne = not s.on_water and not s.moored and not s.crashed and not s.capsized
    climb = if airborne: s.throttle*smoothstep(1.0,13.0,true_speed(k,max(0.0,f64(s.velocity.y))))*smoothstep(10.0,35.0,f.speed) else: 0.0
    glide = if airborne: (1.0-smoothstep(0.08,0.3,s.throttle))*smoothstep(18.0,65.0,f.speed) else: 0.0
    f.climb += (climb-f.climb)*(1.0-exp(-3.0*h))
    f.glide += (glide-f.glide)*(1.0-exp(-3.0*h))
    separated = max(f64(s.wing_separation.x),f64(s.wing_separation.y))
    buffet = if airborne: max(if s.stalled: 0.45 else: 0.0,max(separated,smoothstep(k.stall_angle*0.75,k.stall_angle,abs(s.aoa)))*0.75)*smoothstep(3.0,12.0,f.speed) else: 0.0
    f.buffet += (buffet-f.buffet)*(1.0-exp(-12.0*h))
    f.roll += ((if airborne: rate else: 0.0)-f.roll)*(1.0-exp(-9.0*h))
    # Camera-only whip; zero at ordinary bank-entry rates and bounded to 3 degrees.
    lead = -0.052*tanh(f.roll*0.45)*smoothstep(0.6,2.2,abs(f.roll))
    f.roll_lead += (lead-f.roll_lead)*(1.0-exp(-12.0*h))
    f.lens = max(f.lens*exp(-1.8*h),f.slap_hit*water)
    f.previous_vy = f64(s.velocity.y)
    f.previous_right = right
    f.ready = true

# Pitch modifier shared by the running mixer and the offline listening samples.
loaded_engine_note = (base: f64, climb: f64) -> f64: base*(1.0-0.12*clamp(climb,0.0,1.0))

# The speed a propeller's disc and arcs are drawn for (prop_disc.jo): the turn itself, but for the
# hydrofoil racer's declutched air propeller, whose solid blades whirl with no disc until the clutch.
prop_disc_speed = (s: CraftState,speed: f64) -> f64: foil_disc_speed(s.foil,prop_rotation_speed(s,speed))

prop_rotation_speed = (s: CraftState,speed: f64) -> f64:
    # (the hydrofoil racer's air propeller windmills slowly while declutched; every other craft's
    # foil drive is all air (src/hydrofoil.jo foil_prop_speed))
    if s.fuel > 0 and not s.crashed: foil_prop_speed(s.foil,8.0+70.0*s.throttle) else: speed*0.65

# Weather has no relative-humidity field. Use explicit wet-air evidence instead:
# a cool sea boundary layer, low overcast, rain or fog. Clear inland/high air stays dry.
vapour_dampness=(altitude:f64,over_sea:bool,hour:f64,deck:f64,rain:f64,fog:f64)->f64:
    cool=max(1.0-smoothstep(8.0,11.0,hour),smoothstep(16.5,19.0,hour))
    low=1.0-smoothstep(120.0,650.0,altitude)
    marine=if over_sea:low*(0.35+0.65*cool) else:0.0
    max(marine,max(deck*low,max(rain,fog*low)))

vapour_strength=(speed:f64,load:f64,damp:f64)->f64:
    smoothstep(35.0,50.0,speed)*smoothstep(0.65,0.95,damp)*smoothstep(2.8,6.0,load)

# How an airframe is working, for drawing it (objects.jo obj_vs; any aircraft: the player's, the
# others in the air, the title's): the wings bowing with the load, shaking with the engine and the
# air and buffeting in a hard pull at speed, fluttering at speed; and its half span.
airframe_cues = (k: CraftSpec, velocity: vec3, load: f64, on_water: bool, throttle: f64) -> vec4:
    vis = f64(length(velocity))
    pure = tweaks.pure_scale
    sp = if pure: vis / k.handling_scale else: vis
    bow = if on_water: 0.0 else: clamp((load - 1.0) * 0.045, -0.06, 0.3)
    # (by the drawn speed; under the pure scale, the true speed being low, they come on sooner)
    shake = throttle * 0.012 + (if pure: smoothstep(12.0, 75.0, sp) else: smoothstep(25.0, 95.0, sp)) * 0.04
    # (the buffet of a hard pull at speed: the wings shaking in the air they are working)
    if not on_water: shake += smoothstep(2.5, 7.0, load) * smoothstep(25.0, 45.0, true_speed(k, vis)) * 0.05
    flutter = (if pure: smoothstep(25.0, 80.0, sp) else: smoothstep(40.0, 100.0, sp)) * (0.4 + 0.6 * smoothstep(1.5, 4.0, load))
    if on_water: shake += smoothstep(5.0, 40.0, sp) * 0.04
    vec4(f32(bow), f32(shake), f32(flutter), f32(k.span * 0.5))

# How hard an airframe's skin ripples (0..1): with the dynamic pressure on it (its true speed
# squared), from about 25 m/s, full by 45: the fabric between the ribs and the flying surfaces
# working in the air (objects.jo's shading of it)
airframe_ripple = (k: CraftSpec, velocity: vec3) -> f64:
    v = true_speed(k, f64(length(velocity)))
    clamp((v * v - 625.0) / (2025.0 - 625.0), 0.0, 1.0)

# the load on an aircraft's wings from how fast its nose is pulling round (body pitch rate) at its
# true speed, as the game's feel measures it: for aircraft whose load nobody keeps
airframe_load = (k: CraftSpec, s: CraftState) -> f64: 1.0 + abs(f64(s.angular_velocity.x)) * true_speed(k, f64(length(s.velocity))) / 9.81

# How hard an aircraft's downwash and prop wash work the water `gap` metres under it (0 none ..
# 1 churning): within about a span at ordinary speeds, and further down the faster it goes, a
# racer skimming the sea at 10 m streaking it as it passes.
skim_amount = (k: CraftSpec, gap: f64, velocity: vec3) -> f64:
    reach = mix(min(k.span * 0.6, 6.0), 14.0, smoothstep(35.0, 50.0, true_speed(k, f64(length(velocity)))))
    (1.0 - smoothstep(0.5, reach, gap)) * smoothstep(28.0, 60.0, f64(length(velocity)) / pure_k(k))
