use 'coast_mesh.jo'
use 'coast_field.jo'
use 'world_point.jo'
# Opt-in diagnostics for real on-foot capture runs. No work on the normal path.
use 'world_terrain.jo'
use 'world.jo'
use 'objects.jo'
use 'render_space.jo'
use 'world_source.jo'
use 'world_towns.jo'
use 'settlements.jo'

# CPU reconstruction of the selected tile's interior height, using the same
# fixed-height samples and triangular interpolation as the uploaded atlas.
# A contact point near a coarse tile edge is flagged by the level/lod fields.
selected_ground = (x: f64,z: f64) -> (f64,int,f64):
    # Reconstruct the actual selected refinement triangle before falling back
    # to the canonical tile. Source contact queries alone would hide LOD errors.
    if coast_enabled:
        loop entry in coast_cache_current:
            local=vec2(f32(x-f64(entry.origin.x)),f32(z-f64(entry.origin.z)))
            loop level in 0..entry.batches.len():
                loop inst in entry.batches[level]:
                    f=(local-inst.origin)/14.0
                    a=inst.region.xy;b=a+vec2(inst.region.z,inst.region.z)
                    if f.x<a.x or f.y<a.y or f.x>=b.x or f.y>=b.y:continue
                    step=inst.region.z/f32(1<<level)
                    cell=floor((f-a)/step)*step+a
                    hs=vec4(coast_mesh_height(inst,cell),coast_mesh_height(inst,cell+vec2(step,0)),coast_mesh_height(inst,cell+vec2(0,step)),coast_mesh_height(inst,cell+vec2(step,step)))
                    return (f64(coast_triangle(hs,(f-cell)/step)),0,0.0)
    # Prefer pinned contact tiles over the clipped coarse ancestor.
    ordered=world_contact_slots+world_selected
    loop slot in ordered:
        node=world_tiles[slot]
        ox,oz=world_tile_origin(node.x,node.z,node.level)
        size=world_tile_size(node.level)
        if x<ox or z<oz or x>=ox+size or z>=oz+size:continue
        relative=clamp(node.lod-f64(node.level),0.0,3.0)
        heights: f64[]
        loop level in [floor(relative),min(floor(relative)+1.0,4.0)]:
            step=14.0*f64(1<<node.level)*pow(2.0,level)
            ax=ox+floor((x-ox)/step)*step;az=oz+floor((z-oz)/step)*step
            a=round(world_source_sample(ax,az).0*4096.0)/4096.0
            b=round(world_source_sample(ax+step,az).0*4096.0)/4096.0
            c=round(world_source_sample(ax,az+step).0*4096.0)/4096.0
            d=round(world_source_sample(ax+step,az+step).0*4096.0)/4096.0
            heights.push(triangle_height(a,b,c,d,(x-ax)/step,(z-az)/step))
        return (mix(heights[0],heights[1],relative-floor(relative)),node.level,node.lod)
    (0.0,-1,-1.0)

trace_walk_precision = (point: WorldPoint,follow: FollowCamera,frame: FollowFrame,towns: Town[]):
    if env("AEGEAN_WALK_TRACE")==none:return
    origin=render_origin(scene_camera())
    foot=world_local(point,origin)
    clip=render_view_proj(origin)*vec4(render_world(foot,render_eye(origin)),1)
    # Float subtraction of two large clip matrices is deliberately absent.
    height,level,lod=selected_ground(point.x,point.z)
    canonical=surface_height(point.x,point.z)
    contact=walk_height(towns,point.x,point.z)
    props=0;prop_gap=0.0
    loop district in world_town_slots:
        loop group in district.props:
            loop inst in group:
                p=inst.model[3].xyz
                if length(p.xz-world_vec(point).xz)>70.0:continue
                ground,lev,morph=selected_ground(f64(p.x),f64(p.z))
                if lev<0:continue
                props+=1
                prop_gap=max(prop_gap,abs(f64(p.y)-0.04-ground))
    print("WALK {frame_number()} {point.x:.9} {point.y:.9} {point.z:.9} {clip.x/clip.w:.9} {clip.y/clip.w:.9} {position(follow).x:.9} {position(follow).z:.9} {point.y-contact:.9} {height-canonical:.9} {level} {lod:.6} {props} {prop_gap:.9}")
    print("CLOSE {frame_number()} {close_town_sites} {close_town_instances} {close_town_prop_count} {close_town_local_bound:.6} {close_town_prop_gap:.9}")

    drawn_gap=0.0
    loop root in close_town_prop_roots:
        ground,lev,morph=selected_ground(f64(root.x)+f64(close_town_origin.x),f64(root.z)+f64(close_town_origin.z))
        if lev>=0:drawn_gap=max(drawn_gap,abs(f64(root.y)+f64(close_town_origin.y)-0.12-ground))
    print("CLOSE_DRAW {frame_number()} {close_town_prop_roots.len()} {drawn_gap:.9}")
