# The Hotel Ancora: a two-storey hotel on a stone pier off the Porto Vecchio waterfront, with a
# plank terrace on piles over the water (tables, a bar under a striped awning, lanterns on wires,
# a little bandstand), and the coffee house's tables at the town's cafe. Built from boxes in the
# hotel's own frame (local +z out to sea, +x along the shore); the walkable deck is published as
# quays, so the building itself, standing over water, can't be walked into.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'folk.jo'
use 'life_types.jo'
use 'leisure_menu.jo'
use 'leisure.jo'
use 'town_details.jo'
use 'town_sites.jo'
use 'walk_shapes.jo'
use 'live_source.jo'
use 'live_notes.jo'
use 'musician_pose.jo'
use 'wardrobe.jo'

# The places one sits, stands, serves and plays, as the hotel moves them: on the terrace as built,
# or in its bar room of an evening and in the rain (src/bar_room.jo).
struct HotelSpots:
    seat: vec3 = vec3(0, 0, 0)
    table: vec3 = vec3(0, 0, 0)
    stage: vec3 = vec3(0, 0, 0)
    counter: vec3 = vec3(0, 0, 0)
    waiter_pass: vec3 = vec3(0, 0, 0)
    waiter_serve: vec3 = vec3(0, 0, 0)
    bar_back: vec3 = vec3(0, 0, 0)
    bar_rest: vec3 = vec3(0, 0, 0)
    stools: vec3[] = []

struct HotelScene:
    ok = false
    frame: mat4                     # local to world
    origin: vec3
    mesh: Mesh
    quays: Quay[]
    venue: LifeVenue                # the terrace, as a daily-life cafe venue
    seat: vec3                      # the player's chair (world, at deck height)
    seat_yaw = 0.0                  # (facing (sin, cos), as the player's yaw)
    table: vec3                     # the player's table top (world)
    table_x: vec3                   # (its local axes in the world, for putting things down)
    table_z: vec3
    stage: vec3                     # the bandstand (world, at its floor)
    stage_out: vec3                 # the way the band faces
    counter: vec3                   # the bar, where one orders standing
    desk: vec3                      # the hotel's door (rooms)
    tables: vec3[]                  # all the terrace tables (world, top centres)
    barber_seat: vec3               # the barber's chair on the waterfront walk, by the hotel's wall
    barber_yaw = 0.0                # (facing the mirror)
    barber_mirror: vec3             # the mirror's middle (world)
    waiter_pass: vec3               # where the terrace's waiter waits for orders, at the bar's end
    waiter_serve: vec3              # where he stands to serve the player's table
    bar_back: vec3                  # the barkeep's place behind the counter, in front of the pilot
    bar_rest: vec3                  # (where he leans when he is not serving)
    bar_yaw = 0.0                   # (the way one faces the bar, standing at it)
    stools: vec3[]                  # the bar's stools (world, on the deck), left to right
    built: HotelSpots = HotelSpots() # (the terrace's, as built: the world's band and patrons go by these)

BAR_STOOLS_X = [-3.2, -1.1, 1.1, 3.2]
const STOOL_LIFT = 0.2               # (a stool's seat above a chair's: a figure seated on one is raised)
DECK = 1.2                          # the deck's top: the quays' height, flush with the waterfront
TABLE_TOP = 0.76

_H_PLASTER = rgb(0.94, 0.87, 0.72)
_H_STONE = rgb(0.72, 0.68, 0.6)
_H_WOOD = rgb(0.55, 0.42, 0.29)
_H_WOOD2 = rgb(0.6, 0.47, 0.33)
_H_PILE = rgb(0.28, 0.21, 0.15)
_H_SHUTTER = rgb(0.23, 0.44, 0.36)
_H_WHITE = rgb(0.93, 0.93, 0.89)
_H_CLOTH = rgb(0.97, 0.96, 0.93)
_H_CHAIR = rgb(0.3, 0.19, 0.11)
_H_IRON = rgb(0.14, 0.15, 0.15)
_H_GLASS = rgb(0.2, 0.24, 0.3)
_H_GLOW = rgba(1.0, 0.86, 0.6, 0.75)

# where the player's table and the four terrace tables stand, in the hotel's frame
_PLAYER_TABLE = vec3(10.6, 0, 27.6)
_TABLE_X = [-6.6, -2.2, 2.2, 6.6]
_TABLE_Z = 24.4
_STAGE = vec3(-12.5, 0, 27.8)

_wl = (h: HotelScene, p: vec3) -> vec3: transform_point(h.frame, p)
_wd = (h: HotelScene, d: vec3) -> vec3: normalize((h.frame * vec4(d, 0)).xyz)

# ---------------- choosing the spot ----------------

# Along the waterfront, the first spot (trying the far end from the second pier first) where the
# whole pier stands in water at least waist deep, clear of moored boats and seaplane docks.
_site_frame = (tw: Town, along: f64) -> mat4:
    coast = vec2(tw.center.x, tw.center.z)
    tangent = vec2(-tw.out.y, tw.out.x)
    root = coast + tangent * f32(along) - tw.out * 2.0
    translation(vec3(root.x, 0, root.y)) * rotation_y(atan2(f64(tw.out.x), f64(tw.out.y)))

_site_score = (tw: Town, m: mat4, depth: (f64, f64) -> f64) -> f64:
    score = 0.0
    loop p in [vec3(0,0,9), vec3(-10,0,12), vec3(10,0,12), vec3(0,0,24), vec3(-14,0,30), vec3(14,0,30), vec3(-14,0,8), vec3(14,0,8), vec3(0,0,31)]:
        q = transform_point(m, p)
        h = depth(f64(q.x), f64(q.z))
        if h > -0.6: score += 10.0 + h
    loop b in tw.boats:
        loop p in [vec3(0,0,16), vec3(-12,0,16), vec3(12,0,16), vec3(0,0,28)]:
            if length(transform_point(m, p).xz - b.at.xz) < 14.0: score += 50.0
    loop d in tw.docks:
        if length(transform_point(m, vec3(0,0,16)).xz - d.xz) < 34.0: score += 80.0
    score

hotel_site = (tw: Town, depth: (f64, f64) -> f64) -> mat4:
    best = _site_frame(tw, -60.0)
    best_score = 1000000.0
    loop along in [-60.0, -54.0, -66.0, -48.0, -72.0, -42.0, 50.0, 44.0, 38.0, -36.0, 32.0]:
        m = _site_frame(tw, along)
        s = _site_score(tw, m, depth)
        if s < best_score - 0.01:
            best_score = s; best = m
        if s <= 0.0: break
    best

# ---------------- the building and the terrace ----------------

_deck_rect = (vs: mut Vertex3D[], x0: f64, x1: f64, z0: f64, z1: f64, along_x: bool):
    # planks in two shades, running along the longer way of the walk
    if along_x:
        z = z0
        k = 0
        loop z < z1 - 0.01:
            w = min(0.5, z1 - z)
            add_box(vs, vec3(f32((x0 + x1) * 0.5), f32(DECK - 0.08), f32(z + w * 0.5)), vec3(f32(x1 - x0), 0.16, f32(w - 0.03)), if k % 2 == 0: _H_WOOD else: _H_WOOD2)
            z += 0.5; k += 1
    else:
        x = x0
        k = 0
        loop x < x1 - 0.01:
            w = min(0.5, x1 - x)
            add_box(vs, vec3(f32(x + w * 0.5), f32(DECK - 0.08), f32((z0 + z1) * 0.5)), vec3(f32(w - 0.03), 0.16, f32(z1 - z0)), if k % 2 == 0: _H_WOOD else: _H_WOOD2)
            x += 0.5; k += 1
    # the joists under it, and the piles down into the sea
    add_box(vs, vec3(f32((x0 + x1) * 0.5), f32(DECK - 0.3), f32((z0 + z1) * 0.5)), vec3(f32(x1 - x0 - 0.1), 0.28, f32(z1 - z0 - 0.1)), _H_PILE)
    px = x0 + 0.3
    loop px <= x1 - 0.2:
        pz = z0 + 0.3
        loop pz <= z1 - 0.2:
            add_cylinder(vs, vec3(f32(px), -4.0, f32(pz)), 0.17, DECK - 0.3 + 4.0, _H_PILE, 6)
            pz += 3.0
        px += 3.0

_rail = (vs: mut Vertex3D[], a: vec3, b: vec3):
    d = b - a
    n = max(1, int(f64(length(d)) / 1.4))
    loop k in 0..(n + 1):
        p = a + d * f32(f64(k) / f64(n))
        add_box(vs, p + vec3(0, f32(DECK + 0.5), 0), vec3(0.07, 1.0, 0.07), _H_WHITE)
    town_beam(vs, a + vec3(0, f32(DECK + 1.0), 0), b + vec3(0, f32(DECK + 1.0), 0), 0.045, _H_WHITE)
    town_beam(vs, a + vec3(0, f32(DECK + 0.5), 0), b + vec3(0, f32(DECK + 0.5), 0), 0.025, _H_WHITE)

_chair = (vs: mut Vertex3D[], at: vec3, toward: vec3):
    f = normalize(vec3(toward.x - at.x, 0, toward.z - at.z) + vec3(0.0001, 0, 0))
    m = translation(at) * rotation_y(atan2(f64(f.x), f64(f.z)))
    add_box(vs, vec3(0, f32(DECK + 0.46), 0), vec3(0.42, 0.05, 0.42), _H_CHAIR, m)
    add_box(vs, vec3(0, f32(DECK + 0.8), -0.2), vec3(0.4, 0.62, 0.04), _H_CHAIR, m)
    loop x in [-0.18, 0.18]:
        loop z in [-0.18, 0.18]:
            add_box(vs, vec3(f32(x), f32(DECK + 0.22), f32(z)), vec3(0.035, 0.46, 0.035), _H_CHAIR, m)

_table = (vs: mut Vertex3D[], at: vec3, sx: f64, sz: f64):
    add_box(vs, at + vec3(0, f32(DECK + TABLE_TOP - 0.02), 0), vec3(f32(sx), 0.04, f32(sz)), _H_CLOTH)
    add_box(vs, at + vec3(0, f32(DECK + TABLE_TOP - 0.12), 0), vec3(f32(sx + 0.02), 0.18, f32(sz + 0.02)), _H_CLOTH)
    add_cylinder(vs, at + vec3(0, f32(DECK), 0), 0.05, TABLE_TOP - 0.04, _H_IRON, 6)
    add_cylinder(vs, at + vec3(0, f32(DECK), 0), 0.28, 0.04, _H_IRON, 8)

_lantern_string = (vs: mut Vertex3D[], a: vec3, b: vec3, sag: f64, lanterns: int, seed: int):
    prev = a
    n = 8
    loop k in 1..(n + 1):
        u = f64(k) / f64(n)
        p = a + (b - a) * f32(u) - vec3(0, f32(sag * 4.0 * u * (1.0 - u)), 0)
        town_beam(vs, prev, p, 0.012, _H_IRON)
        prev = p
    colours = [rgba(0.95, 0.45, 0.25, 0.7), rgba(0.98, 0.85, 0.45, 0.7), rgba(0.55, 0.8, 0.5, 0.7), rgba(0.98, 0.7, 0.4, 0.7)]
    loop k in 1..(lanterns + 1):
        u = f64(k) / f64(lanterns + 1)
        p = a + (b - a) * f32(u) - vec3(0, f32(sag * 4.0 * u * (1.0 - u) + 0.18), 0)
        add_sphere(vs, p, 0.1, colours[(k + seed) % colours.len()], 6, 4)


# The name boards' gilt letters, from a 5 by 7 pixel font (only the letters the hotel needs).
_GLYPHS: {str: str[]} = {
    "A": [" ### ", "#   #", "#   #", "#####", "#   #", "#   #", "#   #"],
    "C": [" ####", "#    ", "#    ", "#    ", "#    ", "#    ", " ####"],
    "E": ["#####", "#    ", "#    ", "#### ", "#    ", "#    ", "#####"],
    "H": ["#   #", "#   #", "#   #", "#####", "#   #", "#   #", "#   #"],
    "L": ["#    ", "#    ", "#    ", "#    ", "#    ", "#    ", "#####"],
    "N": ["#   #", "##  #", "# # #", "#  ##", "#   #", "#   #", "#   #"],
    "O": [" ### ", "#   #", "#   #", "#   #", "#   #", "#   #", " ### "],
    "R": ["#### ", "#   #", "#   #", "#### ", "# #  ", "#  # ", "#   #"],
    "T": ["#####", "  #  ", "  #  ", "  #  ", "  #  ", "  #  ", "  #  "]
}

# Text centred at `centre` on a board facing +z (facing = 1: read from the sea) or -z (facing =
# -1: read from the quay); each lit pixel run is one small box standing proud of the board.
_lettering = (vs: mut Vertex3D[], words: str, centre: vec3, pixel: f64, facing: f64, colour: vec4):
    columns = words.len() * 6 - 1
    loop k in 0..words.len():
        glyph = _GLYPHS.get(words[k..k + 1], [])
        loop row in 0..glyph.len():
            line = glyph[row]
            col = 0
            loop col < 5:
                if line[col..col + 1] != "#":
                    col += 1
                    continue
                run = 0
                loop col + run < 5 and line[col + run..col + run + 1] == "#": run += 1
                left = f64(k * 6 + col) - f64(columns) * 0.5
                mid = (left + f64(run) * 0.5) * pixel
                x = facing * mid
                y = (3.0 - f64(row)) * pixel
                add_box(vs, centre + vec3(f32(x), f32(y), f32(facing * 0.012)), vec3(f32(f64(run) * pixel * 0.92), f32(pixel * 0.86), 0.025), colour)
                col += run

# the hotel (static), in the frame chosen by hotel_site
build_hotel = (frame: mat4) -> HotelScene:
    vs: Vertex3D[]
    h = HotelScene(frame = frame)
    h.origin = transform_point(frame, vec3(0, 0, 0))
    # the deck: a strip along the waterfront, walks either side of the building, the terrace
    _deck_rect(vs, -15.0, 15.0, 1.0, 6.0, true)
    _deck_rect(vs, 11.0, 15.0, 6.0, 18.0, false)
    _deck_rect(vs, -15.0, -11.0, 6.0, 18.0, false)
    _deck_rect(vs, -15.0, 15.0, 18.0, 31.0, true)
    # the stone pier under the building
    add_box(vs, vec3(0, f32((DECK - 4.0) * 0.5), 12), vec3(22, f32(DECK + 4.0), 12), _H_STONE)
    # (a kerb round the walls' foot: inside them is the bar room's floor, src/bar_room.jo)
    loop z in [6.0, 18.0]: add_box(vs, vec3(0, f32(DECK + 0.1), f32(z)), vec3(22.3, 0.2, 0.3), rgb(0.8, 0.76, 0.68))
    loop x in [-11.0, 11.0]: add_box(vs, vec3(f32(x), f32(DECK + 0.1), 12), vec3(0.3, 0.2, 12.3), rgb(0.8, 0.76, 0.68))
    # the walls: two storeys of warm plaster, a cornice, a terracotta roof and two chimneys
    add_plaster_box(vs, vec3(0, f32(DECK + 4.0), 12), vec3(22, 8.0, 12), _H_PLASTER, mat4())
    add_box(vs, vec3(0, f32(DECK + 4.1), 12), vec3(22.25, 0.22, 12.25), _H_WHITE)
    add_box(vs, vec3(0, f32(DECK + 8.05), 12), vec3(22.6, 0.3, 12.6), _H_WHITE)
    add_gable(vs, vec3(0, f32(DECK + 8.2), 12), 22.0, 12.0, 3.0, ROOFS[0], mat4())
    loop x in [-6.0, 7.0]: add_box(vs, vec3(f32(x), f32(DECK + 11.0), 10.5), vec3(0.9, 2.0, 0.9), _H_PLASTER)
    # the sea side: a door to the bar between two great windows, shelves of bottles either side,
    # then a balcony along the rooms upstairs with shuttered French windows
    add_painted_opening(vs, vec3(0, f32(DECK + 1.35), 18.02), vec3(1.6, 2.7, 0.08), _H_GLASS, mat4())
    add_box(vs, vec3(0, f32(DECK + 1.35), 18.06), vec3(1.2, 2.2, 0.03), _H_GLOW)
    loop x in [-8.2, 8.2]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 1.6), 18.02), vec3(3.0, 2.6, 0.08), _H_GLASS, mat4())
        add_box(vs, vec3(f32(x), f32(DECK + 1.6), 18.06), vec3(2.6, 2.1, 0.03), rgba(0.95, 0.8, 0.55, 0.82))
    loop side in [-1.0, 1.0]:
        loop shelf in 0..3:
            y = DECK + 1.1 + f64(shelf) * 0.55
            add_box(vs, vec3(f32(side * 3.3), f32(y), 18.15), vec3(3.4, 0.05, 0.28), _H_CHAIR)
            loop k in 0..9:
                col = if (k + shelf) % 3 == 0: rgb(0.2, 0.36, 0.2) else: if (k + shelf) % 3 == 1: rgb(0.45, 0.25, 0.12) else: rgb(0.7, 0.72, 0.6)
                add_cylinder(vs, vec3(f32(side * 3.3 - 1.5 + f64(k) * 0.37), f32(y + 0.03), 18.18), 0.05, 0.3 + f64((k * 7 + shelf) % 3) * 0.05, col, 5)
    add_box(vs, vec3(0, f32(DECK + 4.55), 18.75), vec3(22.4, 0.18, 1.5), _H_WHITE)
    _rail(vs, vec3(-11.1, 4.64, 19.45), vec3(11.1, 4.64, 19.45))
    loop x in [-8.0, -4.0, 0.0, 4.0, 8.0]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 5.9), 18.02), vec3(1.3, 2.3, 0.08), _H_GLASS, mat4())
        if x == -4.0 or x == 8.0: add_box(vs, vec3(f32(x), f32(DECK + 5.9), 18.05), vec3(1.0, 1.9, 0.03), rgba(0.95, 0.8, 0.55, 0.85))
        loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(x + side * 1.05), f32(DECK + 5.9), 18.06), vec3(0.62, 2.3, 0.06), _H_SHUTTER)
    # the name board along the balcony's front, dark green with a gilt edge
    add_box(vs, vec3(0, f32(DECK + 4.45), 19.52), vec3(7.0, 0.5, 0.06), rgb(0.16, 0.3, 0.24))
    _lettering(vs, "HOTEL ANCORA", vec3(0, f32(DECK + 4.45), 19.56), 0.055, 1.0, rgb(0.9, 0.75, 0.38))
    # the land side: the hotel's door with a lamp either side, windows, and its name board
    add_painted_opening(vs, vec3(0, f32(DECK + 1.4), 5.98), vec3(2.0, 2.8, 0.08), rgb(0.35, 0.22, 0.12), mat4())
    loop x in [-1.6, 1.6]: add_box(vs, vec3(f32(x), f32(DECK + 2.6), 5.8), vec3(0.28, 0.4, 0.28), _H_GLOW)
    add_box(vs, vec3(0, f32(DECK + 3.4), 5.95), vec3(6.0, 0.55, 0.06), rgb(0.16, 0.3, 0.24))
    _lettering(vs, "HOTEL ANCORA", vec3(0, f32(DECK + 3.4), 5.91), 0.06, -1.0, rgb(0.9, 0.75, 0.38))
    loop x in [-8.0, -4.5, 4.5, 8.0]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 1.7), 5.98), vec3(1.2, 1.8, 0.08), _H_GLASS, mat4())
        loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(x + side * 0.95), f32(DECK + 1.7), 5.94), vec3(0.55, 1.8, 0.06), _H_SHUTTER)
    loop x in [-8.0, -4.0, 0.0, 4.0, 8.0]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 6.0), 5.98), vec3(1.2, 1.9, 0.08), _H_GLASS, mat4())
        if x == 0.0 or x == -8.0: add_box(vs, vec3(f32(x), f32(DECK + 6.0), 5.95), vec3(0.9, 1.5, 0.03), rgba(0.95, 0.8, 0.55, 0.85))
        loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(x + side * 0.95), f32(DECK + 6.0), 5.94), vec3(0.55, 1.9, 0.06), _H_SHUTTER)
    # the barber's corner on the walk: a mirror in a gilt frame on the wall between the windows,
    # a shelf of bottles and a brush, a small board, and his chair facing the glass
    _BX = 6.25
    add_box(vs, vec3(f32(_BX), f32(DECK + 1.62), 5.93), vec3(0.78, 0.98, 0.05), rgb(0.72, 0.56, 0.24))
    add_box(vs, vec3(f32(_BX), f32(DECK + 1.62), 5.9), vec3(0.64, 0.84, 0.03), rgb(0.62, 0.68, 0.7))
    add_box(vs, vec3(f32(_BX), f32(DECK + 1.07), 5.84), vec3(0.8, 0.04, 0.2), _H_WOOD)
    loop k in 0..4: add_cylinder(vs, vec3(f32(_BX - 0.28 + f64(k) * 0.17), f32(DECK + 1.09), 5.85), 0.025 + 0.006 * f64(k % 2), 0.16 + 0.03 * f64(k % 3), [rgb(0.3, 0.55, 0.42), rgb(0.75, 0.6, 0.3), rgb(0.85, 0.85, 0.82), rgb(0.5, 0.25, 0.2)][k], 6)
    add_box(vs, vec3(f32(_BX), f32(DECK + 2.32), 5.95), vec3(0.9, 0.24, 0.05), rgb(0.16, 0.3, 0.24))
    _lettering(vs, "BARBER", vec3(f32(_BX), f32(DECK + 2.32), 5.91), 0.035, -1.0, rgb(0.9, 0.75, 0.38))
    # (the chair: a padded seat and back on an iron stand, a footrest)
    add_box(vs, vec3(f32(_BX), f32(DECK + 0.25), 4.55), vec3(0.12, 0.5, 0.12), _H_IRON)
    add_box(vs, vec3(f32(_BX), f32(DECK + 0.52), 4.55), vec3(0.58, 0.1, 0.56), rgb(0.42, 0.12, 0.1))
    add_box(vs, vec3(f32(_BX), f32(DECK + 0.95), 4.25), vec3(0.56, 0.8, 0.08), rgb(0.42, 0.12, 0.1))
    loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(_BX + side * 0.3), f32(DECK + 0.7), 4.55), vec3(0.06, 0.06, 0.5), _H_CHAIR)
    add_box(vs, vec3(f32(_BX), f32(DECK + 0.12), 5.0), vec3(0.4, 0.04, 0.2), _H_IRON)
    # the ends: a window a floor, shutters
    loop side in [-1.0, 1.0]:
        loop z in [9.0, 15.0]:
            loop y in [1.8, 6.0]:
                if side > 0.0 and z == 15.0 and y == 1.8:
                    # (the bar room's side door, off the walk, with a lamp over it)
                    add_painted_opening(vs, vec3(11.02, f32(DECK + 1.35), 15.0), vec3(0.08, 2.7, 1.2), rgb(0.35, 0.22, 0.12), mat4())
                    add_box(vs, vec3(11.12, f32(DECK + 2.95), 15.0), vec3(0.24, 0.32, 0.24), _H_GLOW)
                    continue
                add_painted_opening(vs, vec3(f32(side * 11.02), f32(DECK + y), f32(z)), vec3(0.08, 1.8, 1.1), _H_GLASS, mat4())
                loop s in [-1.0, 1.0]: add_box(vs, vec3(f32(side * 11.06), f32(DECK + y), f32(z + s * 0.85)), vec3(0.06, 1.8, 0.5), _H_SHUTTER)
    # bougainvillea up the sea-side corners
    loop side in [-1.0, 1.0]:
        loop k in 0..9:
            p = vec3(f32(side * (10.4 - f64(k % 3) * 0.35)), f32(DECK + 0.6 + f64(k) * 0.55), f32(18.3 + f64(k % 2) * 0.2))
            add_sphere(vs, p, 0.5 + f64(k % 3) * 0.12, if k % 2 == 0: rgb(0.78, 0.18, 0.46) else: rgb(0.3, 0.48, 0.22), 6, 4)
    # the bar: a zinc-topped counter in front of the door, under a striped awning on poles
    add_box(vs, vec3(0, f32(DECK + 0.55), 20.0), vec3(8.0, 1.1, 0.7), rgb(0.42, 0.26, 0.15))
    add_box(vs, vec3(0, f32(DECK + 1.12), 20.0), vec3(8.2, 0.05, 0.85), rgb(0.66, 0.67, 0.66))
    loop x in BAR_STOOLS_X:
        add_cylinder(vs, vec3(f32(x), f32(DECK), 20.85), 0.03, 0.72, _H_IRON, 5)
        add_cylinder(vs, vec3(f32(x), f32(DECK + 0.72), 20.85), 0.2, 0.06, _H_CHAIR, 8)
    loop k in 0..13:
        x = -10.4 + f64(k) * 1.6
        stripe = if k % 2 == 0: _H_WHITE else: rgb(0.2, 0.42, 0.55)
        add_box(vs, vec3(0, 0, 0), vec3(1.6, 0.05, 3.6), stripe, translation(vec3(f32(x + 0.8), f32(DECK + 3.15), 19.7)) * rotation_x(0.22))
    loop x in [-10.0, 10.0]: add_cylinder(vs, vec3(f32(x), f32(DECK), 21.4), 0.05, 2.75, _H_IRON, 6)
    # railings round the terrace and the walks
    _rail(vs, vec3(-15, 0, 31), vec3(15, 0, 31))
    _rail(vs, vec3(15, 0, 6), vec3(15, 0, 31))
    _rail(vs, vec3(-15, 0, 6), vec3(-15, 0, 31))
    _rail(vs, vec3(15, 0, 1), vec3(15, 0, 6))
    _rail(vs, vec3(-15, 0, 1), vec3(-15, 0, 6))
    # the tables: four for whoever comes of an evening, one by the rail for the player
    tables: vec3[]
    loop x in _TABLE_X:
        c = vec3(f32(x), 0, f32(_TABLE_Z))
        _table(vs, c, 0.95, 1.6)
        tables.push(c)
        loop seat in [vec3(-0.85, 0, 0), vec3(0.85, 0, 0), vec3(0, 0, -1.25), vec3(0, 0, 1.25)]: _chair(vs, c + seat, c)
    _table(vs, _PLAYER_TABLE, 0.9, 0.9)
    tables.push(_PLAYER_TABLE)
    loop dx in [0.85, -0.85]: _chair(vs, _PLAYER_TABLE + vec3(f32(dx), 0, 0), _PLAYER_TABLE)
    # pots of geraniums and a lemon tree in a tub
    loop p in [vec3(-14.2, 0, 19.0), vec3(14.2, 0, 19.0), vec3(14.2, 0, 30.2), vec3(-9.6, 0, 30.3), vec3(4.4, 0, 30.3)]:
        add_cylinder(vs, p + vec3(0, f32(DECK), 0), 0.32, 0.55, ROOFS[2], 7, 0.42)
        add_sphere(vs, p + vec3(0, f32(DECK + 0.85), 0), 0.45, rgb(0.27, 0.45, 0.2), 6, 3)
        loop k in 0..4: add_sphere(vs, p + vec3(f32(cos(f64(k) * 1.7) * 0.3), f32(DECK + 1.1), f32(sin(f64(k) * 1.7) * 0.3)), 0.12, rgb(0.88, 0.2, 0.18), 5, 3)
    # the bandstand: a low platform, an upright piano, a microphone on its stand
    add_box(vs, _STAGE + vec3(0, f32(DECK + 0.15), 0), vec3(4.2, 0.3, 5.6), rgb(0.45, 0.3, 0.2))
    add_box(vs, _STAGE + vec3(-1.6, f32(DECK + 0.3 + 0.65), -1.5), vec3(0.62, 1.3, 1.5), rgb(0.16, 0.09, 0.06))
    add_box(vs, _STAGE + vec3(-1.18, f32(DECK + 0.3 + 0.72), -1.5), vec3(0.28, 0.06, 1.34), rgb(0.95, 0.93, 0.88))
    add_box(vs, _STAGE + vec3(-0.9, f32(DECK + 0.3 + 0.25), -1.5), vec3(0.4, 0.5, 0.8), rgb(0.16, 0.09, 0.06))
    add_cylinder(vs, _STAGE + vec3(1.2, f32(DECK + 0.3), 0.3), 0.025, 1.45, _H_IRON, 5)
    add_box(vs, _STAGE + vec3(1.2, f32(DECK + 0.3 + 1.5), 0.3), vec3(0.09, 0.14, 0.06), rgb(0.7, 0.7, 0.68))
    # lanterns on wires from the balcony's front out to tall posts at the rail, above head height
    loop x in [-15.0, -5.0, 5.0, 15.0]: add_cylinder(vs, vec3(f32(x), f32(DECK), 31.0), 0.06, 4.3, _H_IRON, 6)
    _lantern_string(vs, vec3(-10.5, f32(DECK + 4.45), 19.5), vec3(-15, f32(DECK + 4.25), 31), 0.6, 6, 0)
    _lantern_string(vs, vec3(-3.5, f32(DECK + 4.45), 19.5), vec3(-5, f32(DECK + 4.25), 31), 0.6, 6, 1)
    _lantern_string(vs, vec3(3.5, f32(DECK + 4.45), 19.5), vec3(5, f32(DECK + 4.25), 31), 0.6, 6, 2)
    _lantern_string(vs, vec3(10.5, f32(DECK + 4.45), 19.5), vec3(15, f32(DECK + 4.25), 31), 0.6, 6, 3)
    _lantern_string(vs, vec3(-15, f32(DECK + 4.25), 31), vec3(15, f32(DECK + 4.25), 31), 0.7, 14, 0)
    h.mesh = custom_mesh(vs)
    # the walkable deck, as quays (world)
    q = (a: vec3, b: vec3, w: f64) -> Quay: Quay(transform_point(frame, a).xz, transform_point(frame, b).xz, f32(w))
    h.quays = [q(vec3(-15, 0, 3.5), vec3(15, 0, 3.5), 5.0), q(vec3(13, 0, 1), vec3(13, 0, 31), 4.0), q(vec3(-13, 0, 1), vec3(-13, 0, 31), 4.0), q(vec3(-15, 0, 24.5), vec3(15, 0, 24.5), 13.0)]
    # the terrace as a daily-life venue: its tables spread along local x
    x_world = _wd(h, vec3(1, 0, 0))
    facing = vec3(x_world.z, 0, -x_world.x)
    h.venue = LifeVenue(0, "hotel-ancora" + TERRACE_VENUE_SUFFIX, .cafe, _wl(h, vec3(f32(_TABLE_X[1]), f32(DECK), f32(_TABLE_Z))), facing = facing, capacity = 16, covered = false, prop_pos = _wl(h, vec3(0, f32(DECK), 19.1)))
    h.seat = _wl(h, _PLAYER_TABLE + vec3(0.85, f32(DECK), 0))
    toward = _wd(h, vec3(-1, 0, 0))
    h.seat_yaw = atan2(f64(toward.x), f64(toward.z))
    h.table = _wl(h, _PLAYER_TABLE + vec3(0, f32(DECK + TABLE_TOP), 0))
    h.table_x = x_world; h.table_z = _wd(h, vec3(0, 0, 1))
    h.stage = _wl(h, _STAGE + vec3(0, f32(DECK + 0.3), 0))
    h.stage_out = x_world
    h.counter = _wl(h, vec3(0, f32(DECK), 21.0))
    h.desk = _wl(h, vec3(0, f32(DECK), 4.6))
    h.tables = [loop c in tables: _wl(h, c + vec3(0, f32(DECK + TABLE_TOP), 0))]
    h.barber_seat = _wl(h, vec3(6.25, f32(DECK), 4.62))
    to_glass = _wd(h, vec3(0, 0, 1))
    h.barber_yaw = atan2(f64(to_glass.x), f64(to_glass.z))
    h.barber_mirror = _wl(h, vec3(6.25, f32(DECK + 1.62), 5.88))
    h.waiter_pass = _wl(h, vec3(4.85, f32(DECK), 20.8))
    h.waiter_serve = _wl(h, _PLAYER_TABLE + vec3(-0.15, f32(DECK), -0.85))
    # (the pilot takes the second stool; the barkeep serves across the counter from it)
    h.stools = [loop x in BAR_STOOLS_X: _wl(h, vec3(f32(x), f32(DECK), 20.85))]
    h.bar_back = _wl(h, vec3(f32(BAR_STOOLS_X[1]), f32(DECK), 19.05))
    h.bar_rest = _wl(h, vec3(-2.4, f32(DECK), 19.0))
    to_bar = _wd(h, vec3(0, 0, -1))
    h.bar_yaw = atan2(f64(to_bar.x), f64(to_bar.z))
    h.built = hotel_spots(h)
    h.ok = true
    h

# the places as they are now
hotel_spots = (h: HotelScene) -> HotelSpots: HotelSpots(h.seat, h.table, h.stage, h.counter, h.waiter_pass, h.waiter_serve, h.bar_back, h.bar_rest, h.stools)

# the hotel with its places put back on the terrace, as built (for what the world is told)
hotel_as_built = (h: HotelScene) -> HotelScene:
    out = h
    b = h.built
    out.seat = b.seat; out.table = b.table; out.stage = b.stage; out.counter = b.counter
    out.waiter_pass = b.waiter_pass; out.waiter_serve = b.waiter_serve; out.bar_back = b.bar_back; out.bar_rest = b.bar_rest; out.stools = b.stools
    out

# What one can't walk through on the terrace: the tables, the bar, the bandstand and its piano,
# the pots and the posts (the chairs are where people sit, so they stay open).
hotel_solids = (h: HotelScene) -> TownSite[]:
    yaw = atan2(f64(h.table_z.x), f64(h.table_z.z))
    box = (c: vec3, w: f64, d: f64, height: f64) -> TownSite: TownSite(_wl(h, c + vec3(0, f32(DECK), 0)), yaw, w, d, height, 0)
    out: TownSite[]
    loop x in _TABLE_X: out.push(box(vec3(f32(x), 0, f32(_TABLE_Z)), 0.95, 1.6, TABLE_TOP))
    out.push(box(_PLAYER_TABLE, 0.9, 0.9, TABLE_TOP))
    out.push(box(vec3(0, 0, 20.0), 8.2, 0.85, 1.15))
    out.push(box(_STAGE, 4.2, 5.6, 0.35))
    loop p in [vec3(-14.2, 0, 19.0), vec3(14.2, 0, 19.0), vec3(14.2, 0, 30.2), vec3(-9.6, 0, 30.3), vec3(4.4, 0, 30.3)]: out.push(box(p, 0.7, 0.7, 1.0))
    loop x in [-10.0, 10.0]: out.push(box(vec3(f32(x), 0, 21.4), 0.15, 0.15, 2.7))
    # (the building's walls: the bar room inside is sat in, not walked into)
    out.push(box(vec3(0, 0, 6.0), 22.4, 0.5, 8.0)); out.push(box(vec3(0, 0, 18.0), 22.4, 0.5, 8.0))
    loop x in [-11.0, 11.0]: out.push(box(vec3(f32(x), 0, 12), 0.5, 12.4, 8.0))
    out

draw_hotel = (h: HotelScene, L: Light, t: f64):
    if not h.ok or length(h.origin - scene_camera()) > 3500.0: return
    draw(obj_sh, h.mesh, obj_params(L, t, h.frame))

# ---------------- the band ----------------

struct Band:
    singer: Figure
    pianist: Figure
    bassist: Figure
    reeds: Figure
    kit: InstrumentKit

make_band = () -> Band:
    # (stand-ins for captures and a band not yet in the town: in evening clothes, src/wardrobe.jo)
    Band(build_outfit_figure(evening_outfit(0, 911, true), 911, age = 31), build_outfit_figure(evening_outfit(1, 417, false), 417, age = 52, mustache = 1), build_outfit_figure(evening_outfit(2, 233, false), 233, age = 40), build_outfit_figure(evening_outfit(3, 79, false), 79, age = 27), make_instrument_kit())

# Who stands (or sits) where on the stand, and what they play, for a line-up: the pianist alone,
# the dance band, the tango trio, the island pair, the pianist with a violinist, a guitar and a
# mandolin, or a violin and a guitar; and the singer when she sings.
struct BandSpot:
    who: int                        # 0 the singer, 1 the pianist, 2 the bassist, 3 the reeds
    instrument: int                 # the part played (MusicInstrument, 14 the singer's line), -1 none
    pos: vec3
    yaw: f64
    seated = false

# (also where each part's player is, for whatever is shown over them)
band_spots = (h: HotelScene, lineup: int, singing: bool) -> BandSpot[]:
    x = h.stage_out
    z = h.table_z
    out = atan2(f64(x.x), f64(x.z))
    spots: BandSpot[]
    piano_seat = h.stage - x * 0.8 - z * 1.5
    if lineup <= 4: spots.push(BandSpot(1, 6, piano_seat, out + PI, true))
    else: spots.push(BandSpot(1, -1, piano_seat + x * 0.35, out + 0.5, true))
    if lineup == 1 or lineup == 2: spots.push(BandSpot(2, 13, h.stage - x * 0.9 + z * 0.6, out + 0.4))
    if lineup == 1: spots.push(BandSpot(3, 4, h.stage + x * 0.1 + z * 2.0, out - 0.3))
    if lineup == 2 or lineup == 3: spots.push(BandSpot(3, 9, h.stage + x * 0.1 + z * 2.0, out - 0.3))
    if lineup == 3: spots.push(BandSpot(2, 8, h.stage - x * 0.2 + z * 0.4, out + 0.2))
    if lineup == 4 or lineup == 6: spots.push(BandSpot(3, 0, h.stage + x * 0.2 + z * 1.6, out - 0.35))
    if lineup == 5 or lineup == 6: spots.push(BandSpot(2, 7, h.stage - x * 0.2 + z * 0.4, out, true))
    if lineup == 5: spots.push(BandSpot(3, 8, h.stage + x * 0.3 + z * 1.8, out - 0.3))
    if singing: spots.push(BandSpot(0, 14, h.stage + x * 0.9 + z * 0.3, out))
    spots

# The band on its stand, each player playing their part of what is heard (`perf`, its motions and
# clock made from the band's note feed).
draw_band = (h: HotelScene, b: Band, L: Light, t: f64, lineup: int, singing: bool, perf: Performance):
    if not h.ok or length(h.stage - scene_camera()) > 160.0: return
    ms = perf.seconds
    # (the piano's keys, close enough to be seen as keys)
    if length(h.stage - scene_camera()) < 25.0:
        draw(obj_sh, b.kit.keys, obj_params(L, t, band_keys_at(h)))
    loop s in band_spots(h, lineup, singing):
        fig = match s.who:
            0: b.singer
            1: b.pianist
            2: b.bassist
            _: b.reeds
        if s.instrument < 0:
            draw_figure(fig, s.pos, s.yaw, 0.0, 0.0, L, t, posture = 1)
            continue
        draw_band_player(b, s, fig, perf, ms, L, t)

# One player at their place on the stand, playing their part at `ms` seconds into it (before the
# first note, or for a negative `ms`: holding the instrument ready).
draw_band_player = (b: Band, s: BandSpot, fig: Figure, perf: Performance, ms: f64, L: Light, t: f64) -> void:
    p = Player(fig, translation(s.pos) * rotation_y(s.yaw + PI), f64(s.who) * 1.7)
    m = perform_motion(perf, s.instrument)
    if s.seated and s.instrument != 6: draw(obj_sh, b.kit.stool, obj_params(L, t, translation(s.pos) * rotation_y(s.yaw)))
    match s.instrument:
        0: play_violin(p, m, ms, b.kit, L, t)
        4: play_clarinet(p, m, ms, b.kit, L, t)
        6: play_piano(p, m, ms, vec3(0, 0.77, 0.34), KEYBOARD_WIDTH, b.kit, L, t)
        7: play_plucked(p, m, ms, 0, true, b.kit, L, t)
        8: play_plucked(p, m, ms, if s.who == 2: 2 else: 1, false, b.kit, L, t)
        9: play_accordion(p, m, ms, b.kit, L, t)
        13: play_bass(p, m, ms, b.kit, L, t)
        _: play_singer(p, m, ms, b.kit, L, t)

# Where the stand is, in the hotel's own frame: its middle and half its size (along the shore,
# across), and its floor above the deck.
band_stand_world = (h: HotelScene, along: f64, across: f64, up: f64) -> vec3: h.stage + h.stage_out * f32(along) + h.table_z * f32(across) + vec3(0, f32(up - 0.3), 0)
# The piano's keys (and its lid over them): front edge toward the pianist.
band_keys_at = (h: HotelScene) -> mat4: h.frame * translation(transform_point(inverse(h.frame), h.stage) + vec3(-1.04, 0.751, -1.5))
const STAND_HALF_OUT = 2.1
const STAND_HALF_ALONG = 2.8
const STAND_HEIGHT = 0.3

# ---------------- what's on the table ----------------

# The same things in two parts, so they can be drunk and eaten: the vessel (the glass, the cup,
# the plate) and what is in it (the wine, the coffee, the food), which goes down as it goes.
# `base`: the height the contents shrink toward; `whole`: they shrink all round (food on a plate,
# soup in a bowl) rather than only in height (a glass's level).
struct ServeParts:
    vessel: Mesh[]
    content: Mesh[]
    base: f64[]
    whole: bool[]
    pale: Mesh                      # (a white wine in the wine glass)

build_serve_parts = () -> ServeParts:
    glass = rgba(0.86, 0.92, 0.95, 1)
    out = ServeParts()
    loop k in 0..12:
        vs: Vertex3D[]
        cs: Vertex3D[]
        base = 0.0; whole = false
        match Serve(k):
            .tumbler:
                add_cylinder(vs, vec3(0, 0, 0), 0.04, 0.085, glass, 8)
                add_cylinder(cs, vec3(0, 0.008, 0), 0.0415, 0.045, rgb(0.78, 0.5, 0.18), 8)
                base = 0.008
            .mug:
                add_cylinder(vs, vec3(0, 0, 0), 0.045, 0.152, glass, 8)
                add_box(vs, vec3(0.056, 0.07, 0), vec3(0.018, 0.075, 0.015), glass)
                add_cylinder(cs, vec3(0, 0.012, 0), 0.0465, 0.11, rgb(0.9, 0.66, 0.18), 8)
                add_cylinder(cs, vec3(0, 0.122, 0), 0.0465, 0.028, rgb(0.98, 0.96, 0.9), 8)
                base = 0.012
            .wine_glass:
                add_cylinder(vs, vec3(0, 0, 0), 0.035, 0.005, glass, 8)
                add_cylinder(vs, vec3(0, 0, 0), 0.006, 0.09, glass, 5)
                add_cylinder(vs, vec3(0, 0.09, 0), 0.025, 0.075, glass, 8, 0.042)
                add_cylinder(cs, vec3(0, 0.09, 0), 0.0265, 0.06, rgb(0.5, 0.08, 0.12), 8, 0.0405)
                base = 0.09
            .coupe:
                add_cylinder(vs, vec3(0, 0, 0), 0.03, 0.005, glass, 8)
                add_cylinder(vs, vec3(0, 0, 0), 0.006, 0.09, glass, 5)
                add_cylinder(vs, vec3(0, 0.09, 0), 0.02, 0.038, glass, 8, 0.056)
                add_cylinder(cs, vec3(0, 0.09, 0), 0.0215, 0.032, rgb(0.62, 0.68, 0.92), 8, 0.0565)
                base = 0.09
            .cup:
                add_cylinder(vs, vec3(0, 0, 0), 0.06, 0.01, rgb(0.97, 0.96, 0.93), 10)
                add_cylinder(vs, vec3(0, 0.01, 0), 0.03, 0.05, rgb(0.97, 0.96, 0.93), 8, 0.035)
                add_cylinder(cs, vec3(0, 0.012, 0), 0.0305, 0.049, rgb(0.3, 0.17, 0.08), 8, 0.0345)
                base = 0.012
            .small_glass:
                add_cylinder(vs, vec3(0, 0, 0), 0.025, 0.08, glass, 8)
                add_cylinder(cs, vec3(0, 0.006, 0), 0.0265, 0.048, rgb(0.94, 0.94, 0.9), 8)
                base = 0.006
            .bottle:
                add_cylinder(vs, vec3(0, 0, 0), 0.04, 0.2, rgb(0.18, 0.34, 0.18), 8)
                add_cylinder(vs, vec3(0, 0.2, 0), 0.04, 0.06, rgb(0.18, 0.34, 0.18), 8, 0.014)
                add_cylinder(vs, vec3(0, 0.26, 0), 0.014, 0.05, rgb(0.18, 0.34, 0.18), 6)
                add_cylinder(vs, vec3(0, 0.08, 0), 0.041, 0.07, rgb(0.92, 0.88, 0.78), 8)
            .plate:
                # (the hotel's china: a blue band round the rim, so a plate reads on a white cloth)
                add_cylinder(vs, vec3(0, 0, 0), 0.13, 0.014, rgb(0.2, 0.32, 0.6), 16)
                add_cylinder(vs, vec3(0, 0.002, 0), 0.112, 0.014, rgb(0.97, 0.96, 0.93), 16)
                add_cylinder(vs, vec3(0, 0.003, 0), 0.098, 0.014, rgb(0.2, 0.32, 0.6), 16)
                add_cylinder(vs, vec3(0, 0.004, 0), 0.094, 0.014, rgb(0.97, 0.96, 0.93), 16)
                add_sphere(cs, vec3(0, 0.03, 0), 1.0, rgb(0.78, 0.55, 0.3), 7, 3, translation(vec3(0, 0.025, 0)) * scaling(vec3(0.08, 0.03, 0.06)))
                add_sphere(cs, vec3(0.05, 0.03, 0.04), 0.025, rgb(0.35, 0.55, 0.22), 5, 3)
                add_sphere(cs, vec3(-0.05, 0.03, -0.03), 0.022, rgb(0.85, 0.82, 0.3), 5, 3)
                base = 0.015; whole = true
            .bowl:
                add_cylinder(vs, vec3(0, 0, 0), 0.05, 0.05, rgb(0.93, 0.9, 0.82), 10, 0.08)
                add_cylinder(vs, vec3(0, 0.043, 0), 0.0745, 0.008, rgb(0.2, 0.32, 0.6), 12, 0.0805)
                add_cylinder(cs, vec3(0, 0.044, 0), 0.075, 0.006, rgb(0.55, 0.42, 0.2), 10)
                base = 0.01; whole = true
            .flute:
                add_cylinder(vs, vec3(0, 0, 0), 0.03, 0.005, glass, 8)
                add_cylinder(vs, vec3(0, 0, 0), 0.006, 0.08, glass, 5)
                add_cylinder(vs, vec3(0, 0.08, 0), 0.018, 0.125, glass, 8, 0.025)
                add_cylinder(cs, vec3(0, 0.08, 0), 0.0195, 0.11, rgb(0.95, 0.85, 0.5), 8, 0.0255)
                base = 0.08
            .tall_glass:
                add_cylinder(vs, vec3(0, 0, 0), 0.032, 0.163, glass, 8)
                add_cylinder(cs, vec3(0, 0.008, 0), 0.0335, 0.125, rgb(0.95, 0.72, 0.28), 8)
                base = 0.008
            .pot:
                add_cylinder(vs, vec3(0, 0, 0), 0.06, 0.12, rgb(0.62, 0.62, 0.6), 8, 0.04)
        out.vessel.push(custom_mesh(vs))
        out.content.push(custom_mesh(if cs.len() > 0: cs else: [Vertex3D(), Vertex3D(), Vertex3D()]))
        out.base.push(base); out.whole.push(whole)
    pv: Vertex3D[]
    add_cylinder(pv, vec3(0, 0.09, 0), 0.0265, 0.06, rgb(0.93, 0.85, 0.5), 8, 0.0405)
    out.pale = custom_mesh(pv)
    out

# One thing as it stands (or as it is held): the vessel, and what is left in it.
draw_serving = (parts: ServeParts, s: Served, at: mat4, L: Light, t: f64):
    k = int(s.item.serve)
    draw(obj_sh, parts.vessel[k], obj_params(L, t, at))
    if s.amount <= 0.0 or (k == int(Serve.bottle) or k == int(Serve.pot)): return
    a = clamp(s.amount, 0.0, 1.0)
    b = f32(parts.base[k])
    shrink = if parts.whole[k]: scaling(vec3(f32(sqrt(a)), f32(sqrt(a)), f32(sqrt(a)))) else: scaling(vec3(1, f32(a), 1))
    n = s.item.name.lower(); g = s.item.group.lower()
    pale = k == int(Serve.wine_glass) and (n.contains("white") or g.contains("white") or n.contains("retsina") or g.contains("sweet") or n.contains("muscat"))
    draw(obj_sh, if pale: parts.pale else: parts.content[k], obj_params(L, t, at * translation(vec3(0, b, 0)) * shrink * translation(vec3(0, -b, 0))))

# ---------------- the coffee house ----------------

struct CoffeeHouse:
    ok = false
    frame: mat4
    mesh: Mesh
    seat: vec3
    seat_yaw = 0.0
    table: vec3
    table_x: vec3
    table_z: vec3

# The town's cafe venue gets its tables, chairs and striped canopy (the shared street-furniture
# kind), facing the way the venue faces.
build_coffee_house = (at: vec3, facing: vec3) -> CoffeeHouse:
    f = normalize(vec3(facing.x, 0, facing.z) + vec3(0.0001, 0, 0))
    m = translation(at) * rotation_y(atan2(f64(f.x), f64(f.z)))
    c = CoffeeHouse(frame = m, mesh = custom_mesh(town_prop_vertices(0)), ok = true)
    c.seat = transform_point(m, vec3(2.0, 0, 1.25))
    c.table = transform_point(m, vec3(2.0, 0.9, 0))
    c.table_x = normalize((m * vec4(1, 0, 0, 0)).xyz)
    c.table_z = normalize((m * vec4(0, 0, 1, 0)).xyz)
    toward = normalize((m * vec4(0, 0, -1, 0)).xyz)
    c.seat_yaw = atan2(f64(toward.x), f64(toward.z))
    c

draw_coffee_house = (c: CoffeeHouse, L: Light, t: f64):
    if not c.ok or length(transform_point(c.frame, vec3(0, 0, 0)) - scene_camera()) > 900.0: return
    draw(obj_sh, c.mesh, obj_params(L, t, c.frame))

# After dark, the lanterns and the lit windows throw a warm light on the terrace and whoever is on
# it: things near the hotel (or the coffee house) are drawn with a warm fill added to the shade.
leisure_light = (L: Light, h: HotelScene, other: vec3 = vec3(0, -10000, 0)) -> Light:
    if room_camera_inside(h): return room_figure_light(L)
    night = 1.0 - smoothstep(-0.04, 0.12, f64(normalize(L.sun_dir).y))
    if night <= 0.0 or not h.ok: return L
    cam = scene_camera()
    near = max(1.0 - smoothstep(45.0, 90.0, f64(length(cam - h.stage))), 1.0 - smoothstep(25.0, 50.0, f64(length(cam - other))))
    if near <= 0.0: return L
    out = L
    k = f32(night * near)
    out.shade = L.shade + vec3(0.42, 0.3, 0.16) * k
    out.sun = L.sun + vec3(0.1, 0.07, 0.03) * k
    out

# ---------------- how the band is heard ----------------

# the building's solid body, in the hotel's frame (its ground floor door on the terrace side)
HOTEL_BODY_LO = vec3(-11, -1, 6)
HOTEL_BODY_HI = vec3(11, 12.4, 18)
HOTEL_TERRACE_LO = vec3(-15.2, 0, 18)
HOTEL_TERRACE_HI = vec3(15.2, 6.5, 31.3)

# Between an ear and the band: the hotel's own walls (when the listener is round the land side),
# with whatever else the town puts in the way (`other`, 0..1).
hotel_occlusion = (h: HotelScene, ear: vec3, source: vec3, other: f64 = 0.0) -> f64:
    if not h.ok: return other
    back = inverse(h.frame)
    a = transform_point(back, ear); b = transform_point(back, source)
    # (both inside, in the bar room: its walls are around them, not between)
    walls = if inside_box(a, HOTEL_BODY_LO, HOTEL_BODY_HI) and inside_box(b, HOTEL_BODY_LO, HOTEL_BODY_HI): 0.0 else: if box_blocks(a, b, HOTEL_BODY_LO, HOTEL_BODY_HI): 0.85 else: 0.0
    max(walls, other)

hotel_zone = (h: HotelScene, ear: vec3) -> ListenZone:
    if not h.ok: return .open
    p = transform_point(inverse(h.frame), ear)
    if inside_box(p, HOTEL_BODY_LO, HOTEL_BODY_HI): return .indoors
    if inside_box(p, HOTEL_TERRACE_LO, HOTEL_TERRACE_HI): return .terrace
    .open

# The band as the camera hears it.
band_hearing = (h: HotelScene, ear: vec3, forward: vec3, other: f64 = 0.0) -> LiveHearing:
    source = h.stage + h.stage_out * 0.4 + vec3(0, 1.2, 0)
    live_hearing(ear, forward, source, hotel_occlusion(h, ear, source, other), hotel_zone(h, ear))

# ---------------- the bar room, from inside ----------------

# The bar room: the ground floor inside the walls (hotel frame), floor to ceiling.
ROOM_LO = vec3(-10.7, 0.7, 6.3)
ROOM_HI = vec3(10.7, 5.05, 17.7)

room_point_inside = (h: HotelScene, p: vec3) -> bool: h.ok and inside_box(transform_point(inverse(h.frame), p), ROOM_LO, ROOM_HI)
room_camera_inside = (h: HotelScene) -> bool: room_point_inside(h, scene_camera())

# The light people are drawn in, in the bar room: lamps overhead, warm and dim, deep brown shade.
room_figure_light = (L: Light) -> Light:
    out = L
    out.sun_dir = normalize(vec3(0.25, 0.9, 0.35))
    out.sun = vec3(1.12, 0.94, 0.73)
    out.shade = vec3(0.4, 0.32, 0.24)
    out.fog_density = 0.0
    out
