# The Hotel Ancora: a two-storey hotel on a stone pier off the Porto Vecchio waterfront, with a
# plank terrace on piles over the water (tables, a bar under a striped awning, lanterns on wires,
# a little bandstand), and the coffee house's tables at the town's cafe. Built from boxes in the
# hotel's own frame (local +z out to sea, +x along the shore); the walkable deck is published as
# quays, so the building itself, standing over water, can't be walked into.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'folk.jo'
use 'life_types.jo'
use 'leisure_menu.jo'
use 'leisure.jo'
use 'town_details.jo'

struct HotelScene:
    ok = false
    frame: mat4                     # local to world
    origin: vec3
    mesh: Mesh
    quays: Quay[]
    venue: LifeVenue                # the terrace, as a daily-life cafe venue
    seat: vec3                      # the player's chair (world, at deck height)
    seat_yaw = 0.0                  # (facing (sin, cos), as the player's yaw)
    table: vec3                     # the player's table top (world)
    table_x: vec3                   # (its local axes in the world, for putting things down)
    table_z: vec3
    stage: vec3                     # the bandstand (world, at its floor)
    stage_out: vec3                 # the way the band faces
    counter: vec3                   # the bar, where one orders standing
    desk: vec3                      # the hotel's door (rooms)
    tables: vec3[]                  # all the terrace tables (world, top centres)

DECK = 1.2                          # the deck's top: the quays' height, flush with the waterfront
TABLE_TOP = 0.76

_H_PLASTER = rgb(0.94, 0.87, 0.72)
_H_STONE = rgb(0.72, 0.68, 0.6)
_H_WOOD = rgb(0.55, 0.42, 0.29)
_H_WOOD2 = rgb(0.6, 0.47, 0.33)
_H_PILE = rgb(0.28, 0.21, 0.15)
_H_SHUTTER = rgb(0.23, 0.44, 0.36)
_H_WHITE = rgb(0.93, 0.93, 0.89)
_H_CLOTH = rgb(0.97, 0.96, 0.93)
_H_CHAIR = rgb(0.3, 0.19, 0.11)
_H_IRON = rgb(0.14, 0.15, 0.15)
_H_GLASS = rgb(0.2, 0.24, 0.3)
_H_GLOW = rgba(1.0, 0.86, 0.6, 0.75)

# where the player's table and the four terrace tables stand, in the hotel's frame
_PLAYER_TABLE = vec3(10.6, 0, 27.6)
_TABLE_X = [-6.6, -2.2, 2.2, 6.6]
_TABLE_Z = 24.4
_STAGE = vec3(-12.5, 0, 27.8)

_wl = (h: HotelScene, p: vec3) -> vec3: transform_point(h.frame, p)
_wd = (h: HotelScene, d: vec3) -> vec3: normalize((h.frame * vec4(d, 0)).xyz)

# ---------------- choosing the spot ----------------

# Along the waterfront, the first spot (trying the far end from the second pier first) where the
# whole pier stands in water at least waist deep, clear of moored boats and seaplane docks.
_site_frame = (tw: Town, along: f64) -> mat4:
    coast = vec2(tw.center.x, tw.center.z)
    tangent = vec2(-tw.out.y, tw.out.x)
    root = coast + tangent * f32(along) - tw.out * 2.0
    translation(vec3(root.x, 0, root.y)) * rotation_y(atan2(f64(tw.out.x), f64(tw.out.y)))

_site_score = (tw: Town, m: mat4, depth: (f64, f64) -> f64) -> f64:
    score = 0.0
    loop p in [vec3(0,0,9), vec3(-10,0,12), vec3(10,0,12), vec3(0,0,24), vec3(-14,0,30), vec3(14,0,30), vec3(-14,0,8), vec3(14,0,8), vec3(0,0,31)]:
        q = transform_point(m, p)
        h = depth(f64(q.x), f64(q.z))
        if h > -0.6: score += 10.0 + h
    loop b in tw.boats:
        loop p in [vec3(0,0,16), vec3(-12,0,16), vec3(12,0,16), vec3(0,0,28)]:
            if length(transform_point(m, p).xz - b.at.xz) < 14.0: score += 50.0
    loop d in tw.docks:
        if length(transform_point(m, vec3(0,0,16)).xz - d.xz) < 34.0: score += 80.0
    score

hotel_site = (tw: Town, depth: (f64, f64) -> f64) -> mat4:
    best = _site_frame(tw, -60.0)
    best_score = 1000000.0
    loop along in [-60.0, -54.0, -66.0, -48.0, -72.0, -42.0, 50.0, 44.0, 38.0, -36.0, 32.0]:
        m = _site_frame(tw, along)
        s = _site_score(tw, m, depth)
        if s < best_score - 0.01:
            best_score = s; best = m
        if s <= 0.0: break
    best

# ---------------- the building and the terrace ----------------

_deck_rect = (vs: mut Vertex3D[], x0: f64, x1: f64, z0: f64, z1: f64, along_x: bool):
    # planks in two shades, running along the longer way of the walk
    if along_x:
        z = z0
        k = 0
        loop z < z1 - 0.01:
            w = min(0.5, z1 - z)
            add_box(vs, vec3(f32((x0 + x1) * 0.5), f32(DECK - 0.08), f32(z + w * 0.5)), vec3(f32(x1 - x0), 0.16, f32(w - 0.03)), if k % 2 == 0: _H_WOOD else: _H_WOOD2)
            z += 0.5; k += 1
    else:
        x = x0
        k = 0
        loop x < x1 - 0.01:
            w = min(0.5, x1 - x)
            add_box(vs, vec3(f32(x + w * 0.5), f32(DECK - 0.08), f32((z0 + z1) * 0.5)), vec3(f32(w - 0.03), 0.16, f32(z1 - z0)), if k % 2 == 0: _H_WOOD else: _H_WOOD2)
            x += 0.5; k += 1
    # the joists under it, and the piles down into the sea
    add_box(vs, vec3(f32((x0 + x1) * 0.5), f32(DECK - 0.3), f32((z0 + z1) * 0.5)), vec3(f32(x1 - x0 - 0.1), 0.28, f32(z1 - z0 - 0.1)), _H_PILE)
    px = x0 + 0.3
    loop px <= x1 - 0.2:
        pz = z0 + 0.3
        loop pz <= z1 - 0.2:
            add_cylinder(vs, vec3(f32(px), -4.0, f32(pz)), 0.17, DECK - 0.3 + 4.0, _H_PILE, 6)
            pz += 3.0
        px += 3.0

_rail = (vs: mut Vertex3D[], a: vec3, b: vec3):
    d = b - a
    n = max(1, int(f64(length(d)) / 1.4))
    loop k in 0..(n + 1):
        p = a + d * f32(f64(k) / f64(n))
        add_box(vs, p + vec3(0, f32(DECK + 0.5), 0), vec3(0.07, 1.0, 0.07), _H_WHITE)
    town_beam(vs, a + vec3(0, f32(DECK + 1.0), 0), b + vec3(0, f32(DECK + 1.0), 0), 0.045, _H_WHITE)
    town_beam(vs, a + vec3(0, f32(DECK + 0.5), 0), b + vec3(0, f32(DECK + 0.5), 0), 0.025, _H_WHITE)

_chair = (vs: mut Vertex3D[], at: vec3, toward: vec3):
    f = normalize(vec3(toward.x - at.x, 0, toward.z - at.z) + vec3(0.0001, 0, 0))
    m = translation(at) * rotation_y(atan2(f64(f.x), f64(f.z)))
    add_box(vs, vec3(0, f32(DECK + 0.46), 0), vec3(0.42, 0.05, 0.42), _H_CHAIR, m)
    add_box(vs, vec3(0, f32(DECK + 0.8), -0.2), vec3(0.4, 0.62, 0.04), _H_CHAIR, m)
    loop x in [-0.18, 0.18]:
        loop z in [-0.18, 0.18]:
            add_box(vs, vec3(f32(x), f32(DECK + 0.22), f32(z)), vec3(0.035, 0.46, 0.035), _H_CHAIR, m)

_table = (vs: mut Vertex3D[], at: vec3, sx: f64, sz: f64):
    add_box(vs, at + vec3(0, f32(DECK + TABLE_TOP - 0.02), 0), vec3(f32(sx), 0.04, f32(sz)), _H_CLOTH)
    add_box(vs, at + vec3(0, f32(DECK + TABLE_TOP - 0.12), 0), vec3(f32(sx + 0.02), 0.18, f32(sz + 0.02)), _H_CLOTH)
    add_cylinder(vs, at + vec3(0, f32(DECK), 0), 0.05, TABLE_TOP - 0.04, _H_IRON, 6)
    add_cylinder(vs, at + vec3(0, f32(DECK), 0), 0.28, 0.04, _H_IRON, 8)

_lantern_string = (vs: mut Vertex3D[], a: vec3, b: vec3, sag: f64, lanterns: int, seed: int):
    prev = a
    n = 8
    loop k in 1..(n + 1):
        u = f64(k) / f64(n)
        p = a + (b - a) * f32(u) - vec3(0, f32(sag * 4.0 * u * (1.0 - u)), 0)
        town_beam(vs, prev, p, 0.012, _H_IRON)
        prev = p
    colours = [rgba(0.95, 0.45, 0.25, 0.7), rgba(0.98, 0.85, 0.45, 0.7), rgba(0.55, 0.8, 0.5, 0.7), rgba(0.98, 0.7, 0.4, 0.7)]
    loop k in 1..(lanterns + 1):
        u = f64(k) / f64(lanterns + 1)
        p = a + (b - a) * f32(u) - vec3(0, f32(sag * 4.0 * u * (1.0 - u) + 0.18), 0)
        add_sphere(vs, p, 0.13, colours[(k + seed) % colours.len()], 6, 4)

# the hotel (static), in the frame chosen by hotel_site
build_hotel = (frame: mat4) -> HotelScene:
    vs: Vertex3D[]
    h = HotelScene(frame = frame)
    h.origin = transform_point(frame, vec3(0, 0, 0))
    # the deck: a strip along the waterfront, walks either side of the building, the terrace
    _deck_rect(vs, -15.0, 15.0, 1.0, 6.0, true)
    _deck_rect(vs, 11.0, 15.0, 6.0, 18.0, false)
    _deck_rect(vs, -15.0, -11.0, 6.0, 18.0, false)
    _deck_rect(vs, -15.0, 15.0, 18.0, 31.0, true)
    # the stone pier under the building
    add_box(vs, vec3(0, f32((DECK - 4.0) * 0.5), 12), vec3(22, f32(DECK + 4.0), 12), _H_STONE)
    add_box(vs, vec3(0, f32(DECK + 0.1), 12), vec3(22.3, 0.2, 12.3), rgb(0.8, 0.76, 0.68))
    # the walls: two storeys of warm plaster, a cornice, a terracotta roof and two chimneys
    add_plaster_box(vs, vec3(0, f32(DECK + 4.0), 12), vec3(22, 8.0, 12), _H_PLASTER, mat4())
    add_box(vs, vec3(0, f32(DECK + 4.1), 12), vec3(22.25, 0.22, 12.25), _H_WHITE)
    add_box(vs, vec3(0, f32(DECK + 8.05), 12), vec3(22.6, 0.3, 12.6), _H_WHITE)
    add_gable(vs, vec3(0, f32(DECK + 8.2), 12), 22.0, 12.0, 3.0, ROOFS[0], mat4())
    loop x in [-6.0, 7.0]: add_box(vs, vec3(f32(x), f32(DECK + 11.0), 10.5), vec3(0.9, 2.0, 0.9), _H_PLASTER)
    # the sea side: a door to the bar between two great windows, shelves of bottles either side,
    # then a balcony along the rooms upstairs with shuttered French windows
    add_painted_opening(vs, vec3(0, f32(DECK + 1.35), 18.02), vec3(1.6, 2.7, 0.08), _H_GLASS, mat4())
    add_box(vs, vec3(0, f32(DECK + 1.35), 18.06), vec3(1.2, 2.2, 0.03), _H_GLOW)
    loop x in [-8.2, 8.2]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 1.6), 18.02), vec3(3.0, 2.6, 0.08), _H_GLASS, mat4())
        add_box(vs, vec3(f32(x), f32(DECK + 1.6), 18.06), vec3(2.6, 2.1, 0.03), rgba(0.95, 0.8, 0.55, 0.82))
    loop side in [-1.0, 1.0]:
        loop shelf in 0..3:
            y = DECK + 1.1 + f64(shelf) * 0.55
            add_box(vs, vec3(f32(side * 3.3), f32(y), 18.15), vec3(3.4, 0.05, 0.28), _H_CHAIR)
            loop k in 0..9:
                col = if (k + shelf) % 3 == 0: rgb(0.2, 0.36, 0.2) else: if (k + shelf) % 3 == 1: rgb(0.45, 0.25, 0.12) else: rgb(0.7, 0.72, 0.6)
                add_cylinder(vs, vec3(f32(side * 3.3 - 1.5 + f64(k) * 0.37), f32(y + 0.03), 18.18), 0.05, 0.3 + f64((k * 7 + shelf) % 3) * 0.05, col, 5)
    add_box(vs, vec3(0, f32(DECK + 4.55), 18.75), vec3(22.4, 0.18, 1.5), _H_WHITE)
    _rail(vs, vec3(-11.1, 4.64, 19.45), vec3(11.1, 4.64, 19.45))
    loop x in [-8.0, -4.0, 0.0, 4.0, 8.0]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 5.9), 18.02), vec3(1.3, 2.3, 0.08), _H_GLASS, mat4())
        if x == -4.0 or x == 8.0: add_box(vs, vec3(f32(x), f32(DECK + 5.9), 18.05), vec3(1.0, 1.9, 0.03), rgba(0.95, 0.8, 0.55, 0.85))
        loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(x + side * 1.05), f32(DECK + 5.9), 18.06), vec3(0.62, 2.3, 0.06), _H_SHUTTER)
    # the name board along the balcony's front, dark green with a gilt edge
    add_box(vs, vec3(0, f32(DECK + 4.45), 19.52), vec3(7.0, 0.5, 0.06), rgb(0.16, 0.3, 0.24))
    add_box(vs, vec3(0, f32(DECK + 4.45), 19.55), vec3(6.4, 0.08, 0.02), rgb(0.85, 0.7, 0.35))
    # the land side: the hotel's door with a lamp either side, windows, and its name board
    add_painted_opening(vs, vec3(0, f32(DECK + 1.4), 5.98), vec3(2.0, 2.8, 0.08), rgb(0.35, 0.22, 0.12), mat4())
    loop x in [-1.6, 1.6]: add_box(vs, vec3(f32(x), f32(DECK + 2.6), 5.8), vec3(0.28, 0.4, 0.28), _H_GLOW)
    add_box(vs, vec3(0, f32(DECK + 3.4), 5.95), vec3(6.0, 0.55, 0.06), rgb(0.16, 0.3, 0.24))
    loop x in [-8.0, -4.5, 4.5, 8.0]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 1.7), 5.98), vec3(1.2, 1.8, 0.08), _H_GLASS, mat4())
        loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(x + side * 0.95), f32(DECK + 1.7), 5.94), vec3(0.55, 1.8, 0.06), _H_SHUTTER)
    loop x in [-8.0, -4.0, 0.0, 4.0, 8.0]:
        add_painted_opening(vs, vec3(f32(x), f32(DECK + 6.0), 5.98), vec3(1.2, 1.9, 0.08), _H_GLASS, mat4())
        if x == 0.0 or x == -8.0: add_box(vs, vec3(f32(x), f32(DECK + 6.0), 5.95), vec3(0.9, 1.5, 0.03), rgba(0.95, 0.8, 0.55, 0.85))
        loop side in [-1.0, 1.0]: add_box(vs, vec3(f32(x + side * 0.95), f32(DECK + 6.0), 5.94), vec3(0.55, 1.9, 0.06), _H_SHUTTER)
    # the ends: a window a floor, shutters
    loop side in [-1.0, 1.0]:
        loop z in [9.0, 15.0]:
            loop y in [1.8, 6.0]:
                add_painted_opening(vs, vec3(f32(side * 11.02), f32(DECK + y), f32(z)), vec3(0.08, 1.8, 1.1), _H_GLASS, mat4())
                loop s in [-1.0, 1.0]: add_box(vs, vec3(f32(side * 11.06), f32(DECK + y), f32(z + s * 0.85)), vec3(0.06, 1.8, 0.5), _H_SHUTTER)
    # bougainvillea up the sea-side corners
    loop side in [-1.0, 1.0]:
        loop k in 0..9:
            p = vec3(f32(side * (10.4 - f64(k % 3) * 0.35)), f32(DECK + 0.6 + f64(k) * 0.55), f32(18.3 + f64(k % 2) * 0.2))
            add_sphere(vs, p, 0.5 + f64(k % 3) * 0.12, if k % 2 == 0: rgb(0.78, 0.18, 0.46) else: rgb(0.3, 0.48, 0.22), 6, 4)
    # the bar: a zinc-topped counter in front of the door, under a striped awning on poles
    add_box(vs, vec3(0, f32(DECK + 0.55), 20.0), vec3(8.0, 1.1, 0.7), rgb(0.42, 0.26, 0.15))
    add_box(vs, vec3(0, f32(DECK + 1.12), 20.0), vec3(8.2, 0.05, 0.85), rgb(0.66, 0.67, 0.66))
    loop x in [-3.2, -1.1, 1.1, 3.2]:
        add_cylinder(vs, vec3(f32(x), f32(DECK), 20.85), 0.03, 0.72, _H_IRON, 5)
        add_cylinder(vs, vec3(f32(x), f32(DECK + 0.72), 20.85), 0.2, 0.06, _H_CHAIR, 8)
    loop k in 0..13:
        x = -10.4 + f64(k) * 1.6
        stripe = if k % 2 == 0: _H_WHITE else: rgb(0.2, 0.42, 0.55)
        add_box(vs, vec3(0, 0, 0), vec3(1.6, 0.05, 3.6), stripe, translation(vec3(f32(x + 0.8), f32(DECK + 3.15), 19.7)) * rotation_x(0.22))
    loop x in [-10.0, 10.0]: add_cylinder(vs, vec3(f32(x), f32(DECK), 21.4), 0.05, 2.75, _H_IRON, 6)
    # railings round the terrace and the walks
    _rail(vs, vec3(-15, 0, 31), vec3(15, 0, 31))
    _rail(vs, vec3(15, 0, 6), vec3(15, 0, 31))
    _rail(vs, vec3(-15, 0, 6), vec3(-15, 0, 31))
    _rail(vs, vec3(15, 0, 1), vec3(15, 0, 6))
    _rail(vs, vec3(-15, 0, 1), vec3(-15, 0, 6))
    # the tables: four for whoever comes of an evening, one by the rail for the player
    tables: vec3[]
    loop x in _TABLE_X:
        c = vec3(f32(x), 0, f32(_TABLE_Z))
        _table(vs, c, 0.95, 1.6)
        tables.push(c)
        loop seat in [vec3(-0.85, 0, 0), vec3(0.85, 0, 0), vec3(0, 0, -1.25), vec3(0, 0, 1.25)]: _chair(vs, c + seat, c)
    _table(vs, _PLAYER_TABLE, 0.9, 0.9)
    tables.push(_PLAYER_TABLE)
    loop dx in [0.85, -0.85]: _chair(vs, _PLAYER_TABLE + vec3(f32(dx), 0, 0), _PLAYER_TABLE)
    # pots of geraniums and a lemon tree in a tub
    loop p in [vec3(-14.2, 0, 19.0), vec3(14.2, 0, 19.0), vec3(14.2, 0, 30.2), vec3(-9.6, 0, 30.3), vec3(4.4, 0, 30.3)]:
        add_cylinder(vs, p + vec3(0, f32(DECK), 0), 0.32, 0.55, ROOFS[2], 7, 0.42)
        add_sphere(vs, p + vec3(0, f32(DECK + 0.85), 0), 0.45, rgb(0.27, 0.45, 0.2), 6, 3)
        loop k in 0..4: add_sphere(vs, p + vec3(f32(cos(f64(k) * 1.7) * 0.3), f32(DECK + 1.1), f32(sin(f64(k) * 1.7) * 0.3)), 0.12, rgb(0.88, 0.2, 0.18), 5, 3)
    # the bandstand: a low platform, an upright piano, a microphone on its stand
    add_box(vs, _STAGE + vec3(0, f32(DECK + 0.15), 0), vec3(4.2, 0.3, 5.6), rgb(0.45, 0.3, 0.2))
    add_box(vs, _STAGE + vec3(-1.6, f32(DECK + 0.3 + 0.65), -1.5), vec3(0.62, 1.3, 1.5), rgb(0.16, 0.09, 0.06))
    add_box(vs, _STAGE + vec3(-1.18, f32(DECK + 0.3 + 0.72), -1.5), vec3(0.28, 0.06, 1.34), rgb(0.95, 0.93, 0.88))
    add_box(vs, _STAGE + vec3(-0.9, f32(DECK + 0.3 + 0.25), -1.5), vec3(0.4, 0.5, 0.8), rgb(0.16, 0.09, 0.06))
    add_cylinder(vs, _STAGE + vec3(1.2, f32(DECK + 0.3), 0.3), 0.025, 1.45, _H_IRON, 5)
    add_box(vs, _STAGE + vec3(1.2, f32(DECK + 0.3 + 1.5), 0.3), vec3(0.09, 0.14, 0.06), rgb(0.7, 0.7, 0.68))
    # lanterns on wires from the awning's poles out to posts at the rail
    loop x in [-15.0, -5.0, 5.0, 15.0]: add_cylinder(vs, vec3(f32(x), f32(DECK), 31.0), 0.06, 3.6, _H_IRON, 6)
    _lantern_string(vs, vec3(-10.0, f32(DECK + 2.75), 21.4), vec3(-15, f32(DECK + 3.6), 31), 0.5, 5, 0)
    _lantern_string(vs, vec3(-10.0, f32(DECK + 2.75), 21.4), vec3(-5, f32(DECK + 3.6), 31), 0.5, 5, 1)
    _lantern_string(vs, vec3(10.0, f32(DECK + 2.75), 21.4), vec3(5, f32(DECK + 3.6), 31), 0.5, 5, 2)
    _lantern_string(vs, vec3(10.0, f32(DECK + 2.75), 21.4), vec3(15, f32(DECK + 3.6), 31), 0.5, 5, 3)
    _lantern_string(vs, vec3(-5, f32(DECK + 3.6), 31), vec3(5, f32(DECK + 3.6), 31), 0.45, 4, 0)
    h.mesh = custom_mesh(vs)
    # the walkable deck, as quays (world)
    q = (a: vec3, b: vec3, w: f64) -> Quay: Quay(transform_point(frame, a).xz, transform_point(frame, b).xz, f32(w))
    h.quays = [q(vec3(-15, 0, 3.5), vec3(15, 0, 3.5), 5.0), q(vec3(13, 0, 1), vec3(13, 0, 31), 4.0), q(vec3(-13, 0, 1), vec3(-13, 0, 31), 4.0), q(vec3(-15, 0, 24.5), vec3(15, 0, 24.5), 13.0)]
    # the terrace as a daily-life venue: its tables spread along local x
    x_world = _wd(h, vec3(1, 0, 0))
    facing = vec3(x_world.z, 0, -x_world.x)
    h.venue = LifeVenue(0, "hotel-ancora" + TERRACE_VENUE_SUFFIX, .cafe, _wl(h, vec3(f32(_TABLE_X[1]), f32(DECK), f32(_TABLE_Z))), facing = facing, capacity = 16, covered = false, prop_pos = _wl(h, vec3(0, f32(DECK), 19.1)))
    h.seat = _wl(h, _PLAYER_TABLE + vec3(0.85, f32(DECK), 0))
    toward = _wd(h, vec3(-1, 0, 0))
    h.seat_yaw = atan2(f64(toward.x), f64(toward.z))
    h.table = _wl(h, _PLAYER_TABLE + vec3(0, f32(DECK + TABLE_TOP), 0))
    h.table_x = x_world; h.table_z = _wd(h, vec3(0, 0, 1))
    h.stage = _wl(h, _STAGE + vec3(0, f32(DECK + 0.3), 0))
    h.stage_out = x_world
    h.counter = _wl(h, vec3(0, f32(DECK), 21.0))
    h.desk = _wl(h, vec3(0, f32(DECK), 4.6))
    h.tables = [loop c in tables: _wl(h, c + vec3(0, f32(DECK + TABLE_TOP), 0))]
    h.ok = true
    h

draw_hotel = (h: HotelScene, L: Light, t: f64):
    if not h.ok or length(h.origin - scene_camera()) > 6000.0: return
    draw(obj_sh, h.mesh, obj_params(L, t, h.frame))

# ---------------- the band ----------------

struct Band:
    singer: Figure
    pianist: Figure
    bassist: Figure
    reeds: Figure
    bass: Mesh
    clarinet: Mesh
    accordion: Mesh

make_band = () -> Band:
    bass = custom_mesh(():
        vs: Vertex3D[]
        add_sphere(vs, vec3(0, 0.55, 0), 1.0, rgb(0.45, 0.22, 0.1), 8, 5, scaling(vec3(0.34, 0.55, 0.14)) * translation(vec3(0, 1.0, 0)))
        add_box(vs, vec3(0, 1.45, 0.02), vec3(0.06, 0.9, 0.05), rgb(0.08, 0.06, 0.05))
        add_box(vs, vec3(0, 1.95, 0.0), vec3(0.08, 0.14, 0.08), rgb(0.3, 0.16, 0.08))
        vs
    ())
    clarinet = custom_mesh(():
        vs: Vertex3D[]
        add_cylinder(vs, vec3(0, 0, 0), 0.018, 0.62, rgb(0.06, 0.05, 0.05), 6, 0.03)
        vs
    ())
    accordion = custom_mesh(():
        vs: Vertex3D[]
        add_box(vs, vec3(0, 0, 0), vec3(0.42, 0.36, 0.2), rgb(0.6, 0.12, 0.12))
        add_box(vs, vec3(0.22, 0, 0), vec3(0.03, 0.34, 0.18), rgb(0.95, 0.93, 0.85))
        vs
    ())
    Band(build_figure(.dress, 911, age = 31), build_figure(.merchant, 417, age = 52, mustache = 1), build_figure(.merchant, 233, age = 40), build_figure(.fisher, 79, age = 27), bass, clarinet, accordion)

# The band on its stand (playing: from the evening's first number to its last). The piece decides
# the line-up: the dance band, the tango trio, the bouzouki pair, or the pianist alone.
draw_band = (h: HotelScene, b: Band, L: Light, t: f64, lineup: int, singing: bool):
    if not h.ok or length(h.stage - scene_camera()) > 160.0: return
    x = h.stage_out
    z = h.table_z
    yaw_out = atan2(f64(x.x), f64(x.z))
    piano_seat = h.stage - x * 0.75 - z * 1.5
    draw_figure(b.pianist, piano_seat, yaw_out + PI, 0.0, 0.0, L, t, performing = true, posture = 1)
    if lineup == 1 or lineup == 2:
        # the double bass, stood up beside its player
        bp = h.stage - x * 0.9 + z * 0.6
        draw_figure(b.bassist, bp, yaw_out + 0.4, 0.0, 0.0, L, t, performing = true)
        draw(obj_sh, b.bass, obj_params(L, t, translation(bp + x * 0.45 + z * 0.15) * rotation_y(yaw_out) * rotation_x(-0.12)))
    if lineup >= 1:
        rp = h.stage + x * 0.1 + z * 2.0
        draw_figure(b.reeds, rp, yaw_out - 0.3, 0.0, 0.0, L, t, performing = true)
        if lineup == 1:
            draw(obj_sh, b.clarinet, obj_params(L, t, translation(rp + vec3(0, 1.05, 0) + x * 0.3) * rotation_y(yaw_out) * rotation_x(2.4 + sin(t * 2.0) * 0.08)))
        else:
            draw(obj_sh, b.accordion, obj_params(L, t, translation(rp + vec3(0, 1.15, 0) + x * 0.28) * rotation_y(yaw_out + PI * 0.5) * scaling(vec3(1.0 + sin(t * 3.0) * 0.12, 1, 1))))
    if singing:
        sp = h.stage + x * 0.9 + z * 0.3
        sway = sin(t * 1.3) * 0.12
        draw_figure(b.singer, sp, yaw_out + sway, 0.0, 0.0, L, t, wave = 0.25 + 0.2 * sin(t * 0.7))

# ---------------- what's on the table ----------------

# One small mesh per way of serving, at the table's height, centred on its spot.
build_serve_meshes = () -> Mesh[]:
    glass = rgba(0.86, 0.92, 0.95, 1)
    out: Mesh[]
    loop k in 0..12:
        vs: Vertex3D[]
        match Serve(k):
            .tumbler:
                add_cylinder(vs, vec3(0, 0, 0), 0.04, 0.085, glass, 8)
                add_cylinder(vs, vec3(0, 0.005, 0), 0.036, 0.05, rgb(0.72, 0.45, 0.16), 8)
            .mug:
                add_cylinder(vs, vec3(0, 0, 0), 0.045, 0.15, glass, 8)
                add_cylinder(vs, vec3(0, 0.005, 0), 0.041, 0.12, rgb(0.85, 0.62, 0.2), 8)
                add_cylinder(vs, vec3(0, 0.125, 0), 0.043, 0.03, rgb(0.98, 0.96, 0.9), 8)
                add_box(vs, vec3(0.055, 0.075, 0), vec3(0.02, 0.07, 0.015), glass)
            .wine_glass:
                add_cylinder(vs, vec3(0, 0, 0), 0.035, 0.005, glass, 8)
                add_cylinder(vs, vec3(0, 0, 0), 0.006, 0.09, glass, 5)
                add_cylinder(vs, vec3(0, 0.09, 0), 0.025, 0.07, rgb(0.5, 0.08, 0.12), 8, 0.04)
            .coupe:
                add_cylinder(vs, vec3(0, 0, 0), 0.03, 0.005, glass, 8)
                add_cylinder(vs, vec3(0, 0, 0), 0.006, 0.09, glass, 5)
                add_cylinder(vs, vec3(0, 0.09, 0), 0.02, 0.035, rgb(0.62, 0.68, 0.92), 8, 0.055)
            .cup:
                add_cylinder(vs, vec3(0, 0, 0), 0.06, 0.01, rgb(0.97, 0.96, 0.93), 10)
                add_cylinder(vs, vec3(0, 0.01, 0), 0.03, 0.05, rgb(0.97, 0.96, 0.93), 8, 0.035)
                add_cylinder(vs, vec3(0, 0.055, 0), 0.031, 0.006, rgb(0.3, 0.17, 0.08), 8)
            .small_glass:
                add_cylinder(vs, vec3(0, 0, 0), 0.025, 0.08, glass, 8)
                add_cylinder(vs, vec3(0, 0.003, 0), 0.022, 0.05, rgb(0.92, 0.92, 0.88), 8)
            .bottle:
                add_cylinder(vs, vec3(0, 0, 0), 0.04, 0.2, rgb(0.18, 0.34, 0.18), 8)
                add_cylinder(vs, vec3(0, 0.2, 0), 0.04, 0.06, rgb(0.18, 0.34, 0.18), 8, 0.014)
                add_cylinder(vs, vec3(0, 0.26, 0), 0.014, 0.05, rgb(0.18, 0.34, 0.18), 6)
                add_cylinder(vs, vec3(0, 0.08, 0), 0.041, 0.07, rgb(0.92, 0.88, 0.78), 8)
            .plate:
                add_cylinder(vs, vec3(0, 0, 0), 0.13, 0.015, rgb(0.97, 0.96, 0.93), 12)
                add_sphere(vs, vec3(0, 0.03, 0), 1.0, rgb(0.78, 0.55, 0.3), 7, 3, translation(vec3(0, 0.025, 0)) * scaling(vec3(0.08, 0.03, 0.06)))
                add_sphere(vs, vec3(0.05, 0.03, 0.04), 0.025, rgb(0.35, 0.55, 0.22), 5, 3)
                add_sphere(vs, vec3(-0.05, 0.03, -0.03), 0.022, rgb(0.85, 0.82, 0.3), 5, 3)
            .bowl:
                add_cylinder(vs, vec3(0, 0, 0), 0.05, 0.05, rgb(0.93, 0.9, 0.82), 10, 0.08)
                add_cylinder(vs, vec3(0, 0.045, 0), 0.075, 0.006, rgb(0.55, 0.42, 0.2), 10)
            .flute:
                add_cylinder(vs, vec3(0, 0, 0), 0.03, 0.005, glass, 8)
                add_cylinder(vs, vec3(0, 0, 0), 0.006, 0.08, glass, 5)
                add_cylinder(vs, vec3(0, 0.08, 0), 0.018, 0.12, rgb(0.95, 0.85, 0.5), 8, 0.024)
            .tall_glass:
                add_cylinder(vs, vec3(0, 0, 0), 0.032, 0.16, glass, 8)
                add_cylinder(vs, vec3(0, 0.005, 0), 0.029, 0.13, rgb(0.95, 0.75, 0.3), 8)
            .pot:
                add_cylinder(vs, vec3(0, 0, 0), 0.06, 0.12, rgb(0.62, 0.62, 0.6), 8, 0.04)
        out.push(custom_mesh(vs))
    out

# spots on the player's table for up to six things
_TABLE_SPOTS = [vec2(-0.2, -0.22), vec2(0.18, -0.2), vec2(-0.05, 0.05), vec2(0.22, 0.18), vec2(-0.24, 0.24), vec2(0.04, -0.32)]

draw_served = (h: HotelScene, meshes: Mesh[], served: Served[], L: Light, t: f64, top: vec3 = vec3(0,0,0), ax: vec3 = vec3(0,0,0), az: vec3 = vec3(0,0,0)):
    if not h.ok: return
    centre = if length(ax) > 0.1: top else: h.table
    x = if length(ax) > 0.1: ax else: h.table_x
    z = if length(az) > 0.1: az else: h.table_z
    loop s in served:
        spot = _TABLE_SPOTS[s.seat % _TABLE_SPOTS.len()]
        # (a dish arriving slides in from the edge over its first second)
        p = centre + x * spot.x + z * spot.y
        draw(obj_sh, meshes[int(s.item.serve)], obj_params(L, t, translation(p) * rotation_y(f64(s.seat) * 1.3)))

# ---------------- the coffee house ----------------

struct CoffeeHouse:
    ok = false
    frame: mat4
    mesh: Mesh
    seat: vec3
    seat_yaw = 0.0
    table: vec3
    table_x: vec3
    table_z: vec3

# The town's cafe venue gets its tables, chairs and striped canopy (the shared street-furniture
# kind), facing the way the venue faces.
build_coffee_house = (at: vec3, facing: vec3) -> CoffeeHouse:
    f = normalize(vec3(facing.x, 0, facing.z) + vec3(0.0001, 0, 0))
    m = translation(at) * rotation_y(atan2(f64(f.x), f64(f.z)))
    c = CoffeeHouse(frame = m, mesh = custom_mesh(town_prop_vertices(0)), ok = true)
    c.seat = transform_point(m, vec3(2.0, 0, 1.25))
    c.table = transform_point(m, vec3(2.0, 0.9, 0))
    c.table_x = normalize((m * vec4(1, 0, 0, 0)).xyz)
    c.table_z = normalize((m * vec4(0, 0, 1, 0)).xyz)
    toward = normalize((m * vec4(0, 0, -1, 0)).xyz)
    c.seat_yaw = atan2(f64(toward.x), f64(toward.z))
    c

draw_coffee_house = (c: CoffeeHouse, L: Light, t: f64):
    if not c.ok or length(transform_point(c.frame, vec3(0, 0, 0)) - scene_camera()) > 900.0: return
    draw(obj_sh, c.mesh, obj_params(L, t, c.frame))
