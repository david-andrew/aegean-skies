# The dolphins drawn (src/dolphins.jo): a short-beaked common dolphin made in code, its body and
# its tail stock with the flukes as two instanced parts, the tail beating up and down from its root,
# the whole pitched along its swimming and cut at the sea's surface (what is under the water is not
# drawn through it); and the drops of spray thrown up as it surfaces and falls back in.
use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'quality.jo'
use 'wildlife.jo'
use 'wildlife_view.jo'
use 'dolphins.jo'

struct DolphinMeshes:
    body: Mesh
    tail: Mesh
    drop: Mesh
    ready = false

# (a fin: both faces of a thin triangle)
_fin = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    vs.push(Vertex3D(a, n, vec2(0, 0), col)); vs.push(Vertex3D(b, n, vec2(0, 0), col)); vs.push(Vertex3D(c, n, vec2(0, 0), col))
    vs.push(Vertex3D(a, -n, vec2(0, 0), col)); vs.push(Vertex3D(c, -n, vec2(0, 0), col)); vs.push(Vertex3D(b, -n, vec2(0, 0), col))

_dell = (vs: mut Vertex3D[], at: vec3, size: vec3, col: vec4, seg: int = 8, rings: int = 5):
    add_sphere(vs, vec3(0, 0, 0), 1.0, col, seg, rings, translation(at) * scaling(size))

# A common dolphin about 2 m long, its centre at the origin, the beak toward -z: a dark grey cape
# over the back, the tan-yellow hourglass patch on the forward flank and the paler grey behind it,
# a white belly, a tall swept dorsal fin, dark flippers; the tail stock and flukes apart, from their
# root at z = 0.42.
build_dolphin_meshes = () -> DolphinMeshes:
    cape = rgb(0.2, 0.22, 0.26); tan = rgb(0.8, 0.68, 0.42); grey = rgb(0.56, 0.58, 0.6); belly = rgb(0.93, 0.92, 0.88)
    b: Vertex3D[]
    _dell(b, vec3(0, -0.02, -0.05), vec3(0.19, 0.2, 0.56), grey, 10, 6)
    _dell(b, vec3(0, -0.07, -0.08), vec3(0.17, 0.15, 0.5), belly, 9, 5)
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        _dell(b, vec3(sx * 0.07, -0.01, -0.22), vec3(0.13, 0.12, 0.27), tan, 8, 5)
    _dell(b, vec3(0, 0.05, -0.02), vec3(0.16, 0.16, 0.55), cape, 10, 6)
    # the melon and the beak
    _dell(b, vec3(0, 0.0, -0.55), vec3(0.13, 0.13, 0.15), cape, 8, 5)
    _dell(b, vec3(0, -0.04, -0.55), vec3(0.12, 0.1, 0.13), belly, 7, 4)
    _dell(b, vec3(0, -0.03, -0.76), vec3(0.045, 0.04, 0.12), cape, 6, 4)
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        add_box(b, vec3(sx * 0.1, 0.02, -0.6), vec3(0.015, 0.02, 0.02), rgb(0.05, 0.05, 0.06))
        # flippers, swept back and down
        _fin(b, vec3(sx * 0.13, -0.06, -0.34), vec3(sx * 0.33, -0.18, -0.12), vec3(sx * 0.13, -0.08, -0.22), cape)
    # the dorsal fin, tall and swept back
    _fin(b, vec3(0, 0.17, -0.12), vec3(0, 0.42, 0.14), vec3(0, 0.17, 0.12), cape)
    _fin(b, vec3(0, 0.17, 0.12), vec3(0, 0.42, 0.14), vec3(0, 0.2, 0.18), cape)
    t: Vertex3D[]
    # the tail stock narrowing back from its root, and the flukes
    add_sphere(t, vec3(0, 0, 0), 1.0, grey, 8, 4, translation(vec3(0, 0.0, 0.22)) * scaling(vec3(0.1, 0.12, 0.3)))
    add_sphere(t, vec3(0, 0, 0), 1.0, cape, 8, 4, translation(vec3(0, 0.03, 0.22)) * scaling(vec3(0.08, 0.1, 0.29)))
    _fin(t, vec3(0, 0, 0.45), vec3(0.3, 0, 0.66), vec3(0.08, 0, 0.66), cape)
    _fin(t, vec3(0, 0, 0.45), vec3(-0.08, 0, 0.66), vec3(-0.3, 0, 0.66), cape)
    _fin(t, vec3(0, 0, 0.45), vec3(0.08, 0, 0.66), vec3(-0.08, 0, 0.66), cape)
    d: Vertex3D[]
    add_sphere(d, vec3(0, 0, 0), 1.0, rgb(0.95, 0.97, 1.0), 5, 3)
    DolphinMeshes(custom_mesh(b), custom_mesh(t), custom_mesh(d), true)

dolphin_meshes = DolphinMeshes()
_dol_bodies: Instance3D[]
_dol_tails: Instance3D[]
_dol_drops: Instance3D[]

draw_dolphins = (d: Dolphins, L: Light, t: f64):
    if d.pods.len() == 0 and d.spray.len() == 0: return
    global dolphin_meshes, _dol_bodies, _dol_tails, _dol_drops
    wild_view_init()
    if not dolphin_meshes.ready: dolphin_meshes = build_dolphin_meshes()
    cam = scene_camera(); origin = render_origin(cam)
    far = if render_quality.tier == 0: 300.0 else: 550.0
    clear(_dol_bodies); clear(_dol_tails); clear(_dol_drops)
    loop p in d.pods:
        if f64(length(p.centre - cam.xz)) > far + 30.0: continue
        loop dol in p.dolphins:
            dist = f64(length(dol.pos - cam))
            # (deep under the water nothing shows: the cut would leave nothing)
            if dist > far or dol.pos.y < -0.75 * f32(dol.size): continue
            level = if dist < 160.0: wild_swell(f64(dol.pos.x), f64(dol.pos.z), t) else: 0.0
            hs = f64(length(dol.vel.xz))
            yaw = if hs > 0.2: atan2(f64(dol.vel.x), f64(dol.vel.z)) else: p.heading
            pitch = atan2(f64(dol.vel.y), max(hs, 0.5))
            # (a little roll as it turns, and the swell lifting it as it lifts the sea)
            body = translation(dol.pos - origin + vec3(0, f32(level), 0)) * rotation_y(yaw + PI) * rotation_x(pitch) * scaling(vec3(f32(dol.size), f32(dol.size), f32(dol.size)))
            cut = vec4(1, 1, 1, f32(level - 0.01))
            _dol_bodies.push(Instance3D(body, cut))
            beat = sin(dol.beat) * 0.32 + pitch * 0.4
            _dol_tails.push(Instance3D(body * translation(vec3(0, 0, 0.42)) * rotation_x(beat), cut))
    loop s in d.spray:
        if f64(length(s.pos - cam)) > far * 0.6: continue
        age = d.time - s.born
        k = f32(s.size * max(0.0, 1.0 - age / 2.5))
        _dol_drops.push(Instance3D(translation(s.pos - origin) * scaling(vec3(k, k, k)), vec4(1, 1, 1, -100000)))
    p = local_instance_params(L, t)
    if _dol_bodies.len() > 0: draw_instanced(wild_sh, dolphin_meshes.body, _dol_bodies, p)
    if _dol_tails.len() > 0: draw_instanced(wild_sh, dolphin_meshes.tail, _dol_tails, p)
    if _dol_drops.len() > 0: draw_instanced(wild_sh, dolphin_meshes.drop, _dol_drops, p)
