# Explicit save-boundary extension: pending navigation, ship events/survivors, physical guns,
# bullets, fire, pilot decisions and descents all belong to the same fixed-tick checkpoint.
# No per-frame World copy. Bindings/graphics/audio caches are rebuilt after restore.
use 'living_types.jo'
use 'vessel_types.jo'
use 'combat.jo'

struct WarSceneCheckpoint:
    version = 1
    tick: int
    fleet: VesselFleet
    battle: Battle

checkpoint_war_scene = (w: mut World, fleet: VesselFleet, battle: Battle):
    w.war.scene_checkpoint=to_text(WarSceneCheckpoint(tick=w.tick,fleet=fleet,battle=battle))
    w.war.scene_tick=w.tick

restore_war_scene = (w: World, fleet: mut VesselFleet, battle: mut Battle) -> bool:
    if w.war.scene_checkpoint=="" or w.war.scene_tick!=w.tick: return false
    saved=from_text[WarSceneCheckpoint](w.war.scene_checkpoint)
    if saved is TextError: return false
    if saved.version!=1 or saved.tick!=w.tick or saved.fleet.ships.len()>VESSEL_LIMIT or saved.fleet.lanes.len()>SEA_LANE_LIMIT or saved.battle.actors.len()>COMBAT_MAX_CRAFT or saved.battle.rounds.len()>COMBAT_MAX_ROUNDS or saved.battle.descents.len()>COMBAT_MAX_CRAFT: return false
    fleet=saved.fleet; battle=saved.battle
    true
