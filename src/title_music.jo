use 'music_audition.jo'
use 'music_synth.jo'

const TITLE_MUSIC_PIECE = 26           # Ravel, Daphnis et Chloé: Lever du jour
const TITLE_MUSIC_FROM = 28.9         # just before the harp pickup
const TITLE_MUSIC_TO = 105.75         # after the swell settles, before the next phrase
const TITLE_MUSIC_VOLUME = 0.6

# Keep the harp and winds below the swell's level. The short opening fade covers
# the seek and the last chord trails away before the next phrase.
title_music_gain = (seconds: f64) -> f64:
    age = seconds-TITLE_MUSIC_FROM
    level = mix(0.65,1.0,smoothstep(1.0,28.0,age))
    level*smoothstep(0.0,0.22,age)*(1.0-smoothstep(100.7,TITLE_MUSIC_TO,seconds))

make_title_music = () -> MusicAudition:
    MusicAudition(piece = TITLE_MUSIC_PIECE, position = TITLE_MUSIC_FROM, volume = TITLE_MUSIC_VOLUME,
        lead = 1.2, blocks = 3, end_frame = int(TITLE_MUSIC_TO*f64(MUSIC_RATE)), gain_at = title_music_gain)
