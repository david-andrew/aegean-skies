use 'music_audition.jo'
use 'music_synth.jo'

# Dvorak, Symphony No. 9 in E minor, Op. 95 "From the New World", II: Largo
# (127 bars, 763.3 s / 12:43; source: julian9284 score 4285886, CC0 1.0, data/music/SOURCES.md).
# Played whole from its opening wind and brass chords through the cor anglais theme, the C-sharp
# minor middle section, the pastoral episode, the full-orchestra climax and the quiet close on
# low strings; loops with a natural silent pause after the last chord has died away.
const TITLE_MUSIC_PIECE = 13
const TITLE_MUSIC_FROM = 0.0
const TITLE_MUSIC_TO = 763.341        # full score (12,213,456 frames; last chord ends 761.34 s + 2 s hall tail)
const TITLE_MUSIC_GAP = 4.0           # natural silence between the close and the restart
const TITLE_MUSIC_VOLUME = 0.6
const TITLE_MUSIC_LEVEL = 1.12        # (the cue at the title's loudness: -25.4 LUFS over its first minute)

# The receiver levels its programme, which flattens the Largo's ~20 dB dynamic range to ~3 dB, so
# the score's dynamics (compressed to a comfortable ~11 LU listening range) are re-applied after
# it from the score's markings and the measured unlevelled render: (seconds, dB) breakpoints.
TITLE_MUSIC_CURVE: vec2[] = [
    vec2(0.0, -5.5),     # bars 1-2: opening wind & brass chords, pp
    vec2(5.5, -5.0),     # bar 2: still pp before crescendo
    vec2(12.0, -0.5),    # bars 3-4: brass crescendo to mf/f
    vec2(21.0, 1.5),     # bar 4-5: opening brass & timpani peak, f
    vec2(24.5, 1.0),     # bar 5: dim.
    vec2(28.0, -2.0),    # bars 5-6: muted strings enter pp
    vec2(36.0, -1.8),    # bar 7: cor anglais solo tune (p over pp strings)
    vec2(108.0, -1.8),   # bar 18: end of cor anglais statement
    vec2(114.0, -3.8),   # bar 19: quiet woodwind transition, pp
    vec2(134.0, -4.0),   # bar 22: hushed before brass return
    vec2(142.0, 1.5),    # bar 24: brass & winds crescendo f
    vec2(150.0, 3.2),    # bars 25-26: grand brass & timpani swell, ff
    vec2(156.5, 0.8),    # bar 27: subsiding into strings
    vec2(162.0, 0.2),    # bars 27-35: full strings singing theme, mf
    vec2(205.0, 0.2),    # bar 35: end of strings statement
    vec2(212.0, -1.8),   # bar 36: cor anglais echo, p
    vec2(232.0, -2.0),   # bar 39: fading to close of section A
    vec2(238.0, -4.0),   # bar 40: hushed brass & strings cadence, pp
    vec2(268.0, -4.2),   # bar 46: Un poco piu mosso begins pp
    vec2(275.0, -4.2),   # bar 47: trembling strings pp
    vec2(282.0, 0.2),    # bar 48: first C# minor wave, mf
    vec2(306.0, 0.2),    # bar 52: building wave
    vec2(313.0, 1.5),    # bar 53: wave crest, f
    vec2(321.0, -3.2),   # bar 54: quiet clarinet/strings episode, pp
    vec2(346.0, -3.2),   # bar 58: still pp
    vec2(353.0, -0.5),   # bar 60: warm wind/string swell, mf
    vec2(361.0, -0.8),   # bar 61: easing
    vec2(368.0, -3.2),   # bar 62: quiet dip before surge
    vec2(383.0, -3.0),   # bar 65: gathering momentum
    vec2(391.0, 1.2),    # bar 66: passionate middle-section surge, f
    vec2(405.0, -0.2),   # bar 68: brief breath
    vec2(418.0, 1.8),    # bar 70: peak of middle surge, f
    vec2(425.0, 1.0),    # bar 71: crest end
    vec2(429.0, -4.0),   # bar 72: Meno mosso, sudden pp walking bass
    vec2(494.0, -4.2),   # bar 83: pastoral pp throughout
    vec2(503.0, -1.5),   # bar 84: gentle mp warm swell
    vec2(513.0, -4.0),   # bar 86: back to pp
    vec2(544.0, -3.8),   # bar 91: woodwind birdsong trills, pp->p
    vec2(554.0, 0.5),    # bar 93: rapid crescendo, mf->f
    vec2(568.0, 2.5),    # bar 95: full orchestra erupts
    vec2(574.0, 4.0),    # bar 96: monumental ff climax (1st-movement motto)
    vec2(592.0, 3.8),    # bar 99: sustaining ff climax
    vec2(598.0, -1.5),   # bar 100: subito pullback into A'
    vec2(605.0, -1.8),   # bar 101: cor anglais return, p
    vec2(621.0, -2.0),   # bar 104: theme fades
    vec2(627.0, -4.2),   # bar 105: halting solo strings, pp/ppp
    vec2(674.0, -4.2),   # bar 113: fragile solo strings
    vec2(684.0, -2.5),   # bar 114: warm clarinet/bassoon cadence, p
    vec2(695.0, -4.0),   # bar 116: receding strings, pp
    vec2(713.0, -5.0),   # bar 120: coda brass chords enter ppp
    vec2(721.0, -4.5),   # bar 121: beginning final swell
    vec2(731.0, 1.5),    # bar 122-123: final solemn brass & timpani f
    vec2(738.0, 0.8),    # bar 123: subsiding
    vec2(743.0, -2.5),   # bar 124: ascending strings, p->pp
    vec2(752.0, -4.2),   # bar 125-126: high chord dies away
    vec2(756.0, -5.5),   # bar 126-127: final two ppp low Db chords
    vec2(761.3, -6.0)    # bar 127: last chord ends; hall tail fades cleanly to silence
]

title_music_curve_db = (seconds: f64) -> f64:
    n = TITLE_MUSIC_CURVE.len()
    if seconds <= f64(TITLE_MUSIC_CURVE[0].x): return f64(TITLE_MUSIC_CURVE[0].y)
    loop i in 0..n - 1:
        a = TITLE_MUSIC_CURVE[i]; b = TITLE_MUSIC_CURVE[i + 1]
        if seconds <= f64(b.x):
            return f64(a.y) + (f64(b.y) - f64(a.y)) * smoothstep(f64(a.x), f64(b.x), seconds)
    f64(TITLE_MUSIC_CURVE[n - 1].y)

title_music_gain = (seconds: f64) -> f64:
    db = title_music_curve_db(seconds)
    TITLE_MUSIC_LEVEL * pow(10.0, db / 20.0) * smoothstep(0.0, 0.15, seconds) * (1.0 - smoothstep(761.3, TITLE_MUSIC_TO, seconds))

make_title_music = () -> MusicAudition:
    MusicAudition(piece = TITLE_MUSIC_PIECE, position = TITLE_MUSIC_FROM, volume = TITLE_MUSIC_VOLUME,
        lead = 1.2, blocks = 3, end_frame = 0, loop_gap = TITLE_MUSIC_GAP, loop_from = TITLE_MUSIC_FROM,
        gain_at = title_music_gain)
