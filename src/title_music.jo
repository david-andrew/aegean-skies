use 'music_audition.jo'
use 'music_synth.jo'

# Ravel, Daphnis et Chloé, Part III: Lever du jour, from rehearsal 155 to the bar before 158
# (19 bars, 73.2 s at the score's crotchet = 50; data/music/SOURCES.md). The brooks murmur in
# flutes, clarinets and harps; the rising figure climbs from the basses; the theme enters forte
# at 157 (54 s) and sinks away, and the cue ends with the phrase.
const TITLE_MUSIC_PIECE = 113
const TITLE_MUSIC_FROM = 0.0
const TITLE_MUSIC_TO = 77.0           # the last chord has died away
const TITLE_MUSIC_VOLUME = 0.6
const TITLE_MUSIC_LEVEL = 1.70        # (the cue at the title's loudness: -25.4 LUFS over its first minute)

# The receiver levels its programme, which would flatten the score's dynamics, so they are carried
# here, after it: the pp murmuring 6.5 dB under the forte, rising with the printed crescendo from
# 156 (28 s) to 157 (54 s), and falling away over the last three bars to the final fade.
title_music_gain = (seconds: f64) -> f64:
    db = -6.5+6.5*smoothstep(28.0,54.0,seconds)-3.0*smoothstep(61.2,64.8,seconds)-2.5*smoothstep(64.8,68.4,seconds)-1.5*smoothstep(68.4,72.0,seconds)
    TITLE_MUSIC_LEVEL*pow(10.0,db/20.0)*smoothstep(0.0,0.05,seconds)*(1.0-smoothstep(71.5,TITLE_MUSIC_TO,seconds))

make_title_music = () -> MusicAudition:
    MusicAudition(piece = TITLE_MUSIC_PIECE, position = TITLE_MUSIC_FROM, volume = TITLE_MUSIC_VOLUME,
        lead = 1.2, blocks = 3, end_frame = int(TITLE_MUSIC_TO*f64(MUSIC_RATE)), gain_at = title_music_gain)
