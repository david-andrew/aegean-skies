# The panels for the optional activities, in the paper style of the other counters: the menu (food
# and a very long drinks list, by section, with a search line), the bar along the bottom while one
# sits, the choice of when to wake, working on the aircraft, and the card while time passes. Each
# draws itself from plain data and says what was chosen; the game decides what that means.

use 'phoenix.jo'
use 'touch.jo'
use 'menu_nav.jo'
use 'hud.jo'
use 'touch.jo'
use 'panels.jo'
use 'leisure_menu.jo'

# (the mouse in the panel's own units: panels are drawn larger on small screens)
_lv_over = (r: Rect) -> bool: contains(r, screen_to_world(mouse_pos()))
_lv_click = (r: Rect) -> bool: nav_hit(r, mouse_pressed(.left) and contains(r, screen_to_world(mouse_pos())))

_lv_chip = (r: Rect, label: str, selected: bool, size: f64 = 16.0) -> bool:
    fill = if selected: rgba(0.42, 0.29, 0.17, 1) else: if _lv_over(r): rgba(0.85, 0.74, 0.5, 0.6) else: rgba(0.88, 0.82, 0.68, 1)
    rect_rounded(r.x, r.y, r.w, r.h, r.h * 0.5, fill)
    ptext_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, if selected: rgba(1, 0.97, 0.9, 1) else: rgba(0.32, 0.2, 0.1, 1))
    _lv_click(r)

_lv_button = (r: Rect, label: str, enabled: bool = true, size: f64 = 16.0) -> bool:
    rect_rounded(r.x, r.y, r.w, r.h, 5, if not enabled: rgba(0.7, 0.68, 0.6, 1) else: if _lv_over(r): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1))
    ptext_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, rgba(1, 0.97, 0.9, 1))
    enabled and _lv_click(r)

_lv_panel = (x: f64, y: f64, w: f64, h: f64):
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)

# ---------------- the menu ----------------

struct MenuView:
    section = 0                     # 0: everything; else the section's number, from 1
    query = ""
    scroll = 0
    remark = ""                     # the keeper's last word, and what was brought
    line = ""
    fresh = false                   # (just opened: the key that opened it isn't typed)

struct MenuResult:
    order = -1                      # the item ordered this frame (index into the items)
    closed = false

# The menu of a place: its name, what kind of place, the items and their prices, one's money.
menu_panel = (fonts: Fonts, v: mut MenuView, place: str, kind: str, keeper: str, items: MenuItem[], prices: int[], cents: int) -> MenuResult:
    res = MenuResult()
    # (drawn larger on a small screen, so its type reads: laid out in the screen's units over kz)
    kz = readable_k(15.0)
    push_transform(); scale(kz, kz)
    sw = f64(screen_width()) / kz; sh = f64(screen_height()) / kz
    # typing goes into the search line (letters, digits, spaces); Backspace takes one back
    typed = text_input()
    if v.fresh:
        v.fresh = false; typed = ""
    if typed != "":
        v.query = (v.query + typed)
        if v.query.len() > 28: v.query = v.query[0..28]
        v.scroll = 0
    if key_typed(.backspace) and v.query.len() > 0:
        v.query = v.query[0..v.query.len() - 1]; v.scroll = 0
    if mkey(.escape): res.closed = true
    sections = menu_sections(items)
    w = min(860.0, sw - 24.0)
    x = (sw - w) * 0.5
    top = max(12.0, pad_top_clear((x) * kz, (x + w) * kz) / kz + 6.0)
    h = if sh > 900.0: sh - top - 24.0 else: min(sh - top - 12.0, 700.0)
    y = top + max(0.0, (sh - top - 12.0 - h) * 0.5)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.4))
    _lv_panel(x, y, w, h)
    set_font(fonts.title)
    ptext(fit_text(place, w - 120, 26), vec2(f32(x + 26), f32(y + 18)), 26, INK)
    set_font(fonts.ui)
    ptext(fit_text("{kind}; {keeper} serving", w - 90, 15), vec2(f32(x + 26), f32(y + 52)), 15, LIGHT_INK)
    close = Rect(x + w - 44, y + 12, 32, 32)
    ptext_centered("×", vec2(f32(close.x + 16), f32(close.y + 14)), 30, if _lv_over(close): INK else: LIGHT_INK)
    if _lv_click(close): res.closed = true
    # the sections, as chips that wrap onto as many rows as they need
    cy = y + 78.0
    cx = x + 22.0
    chip_h = 28.0
    labels = ["All"] + [loop s in sections: s.replace("Coffee, tea and soft drinks", "Coffee and soft").replace("Fortified, vermouth and aperitifs", "Aperitifs").replace("Ouzo, tsipouro and anise", "Ouzo and anise").replace("Gin, rum, vodka and others", "Gin, rum, vodka").replace("Brandy and eaux-de-vie", "Brandy").replace("Liqueurs and amari", "Liqueurs")]
    loop k in 0..labels.len():
        cw = ptext_width(labels[k], 15) + 22.0
        if cx + cw > x + w - 22.0:
            cx = x + 22.0; cy += chip_h + 6.0
        if _lv_chip(Rect(cx, cy, cw, chip_h), labels[k], v.section == k, 15.0):
            v.section = k; v.scroll = 0
        cx += cw + 6.0
    cy += chip_h + 10.0
    # the search line
    sr = Rect(x + 22, cy, w - 44, 32)
    rect_rounded(sr.x, sr.y, sr.w, sr.h, 6, rgba(1, 1, 1, 0.55))
    cursor = if int(elapsed() * 2.0) % 2 == 0: "|" else: ""
    shown = if v.query == "": (if pad.on: "search: type a name, a grape, a country" else: "type to search: a name, a grape, a country, a year") else: v.query + cursor
    ptext(fit_text(shown, sr.w - 60, 17), vec2(f32(sr.x + 12), f32(sr.y + 6)), 17, if v.query == "": LIGHT_INK else: INK)
    if v.query != "":
        clear = Rect(sr.x + sr.w - 34, sr.y + 2, 30, 28)
        ptext_centered("×", vec2(f32(clear.x + 15), f32(clear.y + 13)), 24, if _lv_over(clear): INK else: LIGHT_INK)
        if _lv_click(clear): v.query = ""; v.scroll = 0
    cy += 42.0
    # the rows that match, a page at a time
    section = if v.section > 0 and v.section <= sections.len(): sections[v.section - 1] else: ""
    matches = menu_search(items, section, v.query)
    footer = 74.0 + (if v.remark != "" or v.line != "": 26.0 else: 0.0)
    row_h = 46.0
    per = max(1, int((y + h - footer - cy) / row_h))
    most = max(0, matches.len() - per)
    if mouse_wheel() != 0.0 and _lv_over(Rect(x, cy, w, per * row_h)): v.scroll = clamp(v.scroll - int(mouse_wheel()) * 3, 0, most)
    if mkey(.down): v.scroll = min(most, v.scroll + 1)
    if mkey(.up): v.scroll = max(0, v.scroll - 1)
    if mkey(.page_down): v.scroll = min(most, v.scroll + per)
    if mkey(.page_up): v.scroll = max(0, v.scroll - per)
    v.scroll = clamp(v.scroll, 0, most)
    if matches.len() == 0: ptext("Nothing by that name. The keeper shrugs.", vec2(f32(x + 30), f32(cy + 14)), 18, LIGHT_INK)
    bw = 84.0
    loop r in 0..per:
        k = v.scroll + r
        if k >= matches.len(): break
        d = items[matches[k]]
        price = prices[matches[k]]
        ry = cy + f64(r) * row_h
        if r % 2 == 1: rect(x + 18, ry - 4, w - 36, row_h, rgba(0.86, 0.8, 0.66, 0.35))
        name_w = w - bw - 150.0
        ptext(fit_text(d.name, name_w, 18), vec2(f32(x + 28), f32(ry)), 18, INK)
        sub = if d.note != "": "{d.group}: {d.note}" else: d.group
        ptext(fit_text(sub, name_w, 14), vec2(f32(x + 28), f32(ry + 22)), 14, LIGHT_INK)
        pt = phoenix_text(price)
        ptext(pt, vec2(f32(x + w - 40 - bw - ptext_width(pt, 17)), f32(ry + 8)), 17, INK)
        b = Rect(x + w - 30 - bw, ry + 3, bw, 32)
        if _lv_button(b, "order", cents >= price, 15.0): res.order = matches[k]
    # the page arrows (for a finger), and how far down the list one is
    py = y + h - footer + 4.0
    if matches.len() > per:
        up = Rect(x + w * 0.5 - 92, py, 56, 28)
        dn = Rect(x + w * 0.5 + 36, py, 56, 28)
        if _lv_chip(up, "up", false, 15.0): v.scroll = max(0, v.scroll - per)
        if _lv_chip(dn, "down", false, 15.0): v.scroll = min(most, v.scroll + per)
        ptext_centered("{v.scroll + 1}-{min(matches.len(), v.scroll + per)} of {matches.len()}", vec2(f32(x + w * 0.5), f32(py + 14)), 14, LIGHT_INK)
    fy = y + h - 40.0
    line(vec2(f32(x + 24), f32(fy - 8)), vec2(f32(x + w - 24), f32(fy - 8)), 1.5, PAPER_DARK)
    if v.remark != "" or v.line != "":
        said = if v.remark != "": "{keeper}: \"{v.remark}\"" else: v.line
        ptext(fit_text(said, w - 60, 16), vec2(f32(x + 28), f32(fy - 34)), 16, STAMP)
    ptext(phoenix_text(cents), vec2(f32(x + 28), f32(fy)), 19, INK)
    if v.line != "" and v.remark != "": ptext(fit_text(v.line, w - 220, 15), vec2(f32(x + w - 30 - ptext_width(fit_text(v.line, w - 220, 15), 15)), f32(fy + 3)), 15, LIGHT_INK)
    set_font()
    pop_transform()
    res

# ---------------- sitting ----------------

struct SitResult:
    choice = -1                     # index into the actions offered

# Along the bottom while one sits: where, what is playing, and the things one can do.
sitting_bar = (fonts: Fonts, place: str, playing: str, actions: str[]) -> SitResult:
    res = SitResult()
    # (drawn larger on a small screen, so its type reads)
    kz = readable_k(15.0)
    push_transform(); scale(kz, kz)
    sw = f64(screen_width()) / kz; sh = f64(screen_height()) / kz
    set_font(fonts.ui)
    size = 17.0
    widths = [loop a in actions: ptext_width(a, size) + 30.0]
    total = 0.0
    loop wv in widths: total += wv + 8.0
    rows = if total > sw - 40.0: 2 else: 1
    h = 54.0 + f64(rows) * 40.0 + (if playing != "": 22.0 else: 0.0)
    y = sh - h - 12.0
    w = min(sw - 24.0, max(total + 40.0, 420.0))
    if rows == 2: w = sw - 24.0
    x = (sw - w) * 0.5
    rect_rounded(x + 3, y + 4, w, h, 10, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 10, rgba(0.95, 0.91, 0.8, 0.94))
    set_font(fonts.title)
    ptext(fit_text(place, w - 40, 20), vec2(f32(x + 20), f32(y + 10)), 20, INK)
    set_font(fonts.ui)
    if playing != "": ptext(fit_text(playing, w - 40, 15), vec2(f32(x + 20), f32(y + 36)), 15, LIGHT_INK)
    by = y + h - f64(rows) * 40.0 - 8.0
    bx = x + 20.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6]
    loop k in 0..actions.len():
        if bx + widths[k] > x + w - 16.0:
            bx = x + 20.0; by += 40.0
        r = Rect(bx, by, widths[k], 32)
        if _lv_chip(r, if pad.on: actions[k] else: "{k + 1}  {actions[k]}", false, size): res.choice = k
        if k < keys.len() and key_pressed(keys[k]): res.choice = k
        bx += widths[k] + 8.0
    set_font()
    pop_transform()
    res

# ---------------- choices: rest, a spare room, the aircraft ----------------

struct ChoiceResult:
    choice = -1
    closed = false

# A short list of choices on paper, with a line said above them (who and what).
choice_panel = (fonts: Fonts, title: str, sub: str, said: str, choices: str[]) -> ChoiceResult:
    res = ChoiceResult()
    # (drawn larger on a small screen, so its type reads: laid out in the screen's units over kz)
    kz = readable_k(15.0)
    push_transform(); scale(kz, kz)
    sw = f64(screen_width()) / kz; sh = f64(screen_height()) / kz
    w = min(640.0, sw - 32.0)
    set_font(fonts.ui)
    lines = if said != "": wrap_text(said, w - 60, 18) else: []
    h = 92.0 + f64(lines.len()) * 24.0 + f64(choices.len()) * 40.0 + 20.0
    x = (sw - w) * 0.5
    y = max(12.0, (sh - h) * 0.5)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.35))
    _lv_panel(x, y, w, h)
    set_font(fonts.title)
    ptext(fit_text(title, w - 90, 24), vec2(f32(x + 26), f32(y + 18)), 24, INK)
    set_font(fonts.ui)
    if sub != "": ptext(fit_text(sub, w - 60, 15), vec2(f32(x + 26), f32(y + 50)), 15, LIGHT_INK)
    close = Rect(x + w - 44, y + 12, 32, 32)
    ptext_centered("×", vec2(f32(close.x + 16), f32(close.y + 14)), 30, if _lv_over(close): INK else: LIGHT_INK)
    if _lv_click(close) or mkey(.escape): res.closed = true
    ly = y + 78.0
    loop k in 0..lines.len(): ptext(lines[k], vec2(f32(x + 28), f32(ly + f64(k) * 24.0)), 18, INK)
    cy = ly + f64(lines.len()) * 24.0 + 10.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8]
    loop k in 0..choices.len():
        r = Rect(x + 20, cy + f64(k) * 40.0, w - 40, 34)
        if _lv_over(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        ptext(fit_text(if pad.on: choices[k] else: "{k + 1}.  {choices[k]}", r.w - 20, 18), vec2(f32(r.x + 10), f32(r.y + 7)), 18, rgba(0.32, 0.2, 0.1, 1))
        if _lv_click(r): res.choice = k
        if k < keys.len() and key_pressed(keys[k]): res.choice = k
    set_font()
    pop_transform()
    res

# ---------------- time passing ----------------

# The screen darkens while time passes (sleeping, lingering, working): what is happening and the
# clock running on. `fade` 0..1.
time_card = (fonts: Fonts, doing: str, clock: str, fade: f64):
    sw = f64(screen_width()); sh = f64(screen_height())
    rect(0, 0, sw, sh, rgba(0.02, 0.03, 0.05, f32(0.88 * fade)))
    if fade < 0.3: return
    a = f32(clamp((fade - 0.3) / 0.4, 0.0, 1.0))
    set_font(fonts.title)
    ptext_centered(clock, vec2(f32(sw * 0.5), f32(sh * 0.45)), 44, rgba(1, 0.95, 0.82, a))
    set_font(fonts.ui)
    ptext_centered(doing, vec2(f32(sw * 0.5), f32(sh * 0.45 + 46)), 20, rgba(1, 0.95, 0.82, a * 0.85))
    set_font()

# ---------------- the bill of fare ----------------
# What a place offers, as it would show it: a printed card at the hotel (a double rule, the
# dishes of the day), a chalkboard at the coffee house. A handful of things with their prices.
# Its last line is the house's ordinary "other wines and spirits on request": ask (click it, or 0)
# and the keeper brings out the whole book.

struct BillResult:
    order = -1                      # the line ordered this frame (index into the items given)
    closed = false
    secret = false                  # asked for the rest

struct BillSection:
    title: str
    first: int                      # (the items from here...)
    count: int

bill_of_fare = (fonts: Fonts, place: str, chalk: bool, sections: BillSection[], items: MenuItem[], prices: int[], cents: int, said: str, ask_line: str) -> BillResult:
    res = BillResult()
    sw = f64(screen_width()); sh = f64(screen_height())
    row_h = if pad.on: 36.0 else: 30.0
    w = min(520.0, sw - 24.0)
    said_h = if said != "": 22.0 * f64(wrap_text(said, w - 60, 15).len()) + 6.0 else: 0.0
    h = min(sh - 20.0, 96.0 + f64(sections.len()) * row_h * 1.35 + f64(items.len()) * row_h + (if pad.on: 38.0 else: row_h) + said_h + 44.0)
    x = (sw - w) * 0.5
    top = max(10.0, pad_top_clear(x, x + w) + 4.0)
    y = top + max(0.0, (sh - top - 10.0 - h) * 0.5)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.35))
    ink = if chalk: rgba(0.95, 0.94, 0.88, 0.92) else: INK
    faint = if chalk: rgba(0.95, 0.94, 0.88, 0.6) else: LIGHT_INK
    if chalk:
        # (a blackboard in a wooden frame)
        rect_rounded(x - 10 + 4, y - 10 + 6, w + 20, h + 20, 6, rgba(0, 0, 0, 0.3))
        rect_rounded(x - 10, y - 10, w + 20, h + 20, 6, rgba(0.42, 0.29, 0.17, 1))
        rect(x, y, w, h, rgba(0.13, 0.17, 0.15, 1))
        loop k in 0..9: line(vec2(f32(x + 20 + f64(k) * w * 0.11), f32(y + 8 + f64(k % 3) * h * 0.3)), vec2(f32(x + 60 + f64(k) * w * 0.11), f32(y + 16 + f64(k % 3) * h * 0.3)), 6.0, rgba(1, 1, 1, 0.025))
    else:
        rect(x + 4, y + 6, w, h, rgba(0, 0, 0, 0.3))
        rect(x, y, w, h, rgba(0.97, 0.94, 0.85, 1))
        rect_outline(x + 10, y + 10, w - 20, h - 20, 2.0, INK)
        rect_outline(x + 15, y + 15, w - 30, h - 30, 1.0, INK)
    set_font(fonts.title)
    ptext_centered(place.upper(), vec2(f32(x + w * 0.5), f32(y + 40)), if w < 420.0: 24 else: 28, ink)
    set_font(fonts.ui)
    ptext_centered(if chalk: "Today" else: "Bill of Fare", vec2(f32(x + w * 0.5), f32(y + 70)), 15, faint)
    close = Rect(x + w - 42, y + 18, 28, 28)
    ptext_centered("×", vec2(f32(close.x + 14), f32(close.y + 12)), 26, if contains(close, mouse_pos()): ink else: faint)
    if mouse_pressed(.left) and contains(close, mouse_pos()) or mkey(.escape): res.closed = true
    cy = y + 96.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8, .n9]
    k = 0
    loop sec in sections:
        set_font(fonts.title)
        ptext_centered(sec.title, vec2(f32(x + w * 0.5), f32(cy)), 16, ink)
        set_font(fonts.ui)
        cy += row_h * 0.95
        loop i in sec.first..sec.first + sec.count:
            d = items[i]
            r = Rect(x + 24, cy - 4, w - 48, row_h - 2)
            over = contains(r, mouse_pos())
            if over: rect_rounded(r.x, r.y, r.w, r.h, 4, if chalk: rgba(1, 1, 1, 0.08) else: rgba(0.85, 0.74, 0.5, 0.35))
            name = if pad.on: d.name else: "{k + 1}  {d.name}"
            price = phoenix_text(prices[i])
            nw = ptext_width(fit_text(name, w * 0.62, 16), 16)
            ptext(fit_text(name, w * 0.62, 16), vec2(f32(x + 32), f32(cy)), 16, if cents >= prices[i]: ink else: faint)
            pw = ptext_width(price, 16)
            ptext(price, vec2(f32(x + w - 32 - pw), f32(cy)), 16, ink)
            # (dotted leaders from the name to the price)
            dx = x + 40.0 + nw
            loop dx < x + w - 40.0 - pw:
                circle(vec2(f32(dx), f32(cy + 12)), 1.0, faint); dx += 7.0
            if nav_hit(r, over and mouse_pressed(.left)) or (k < keys.len() and key_pressed(keys[k])): res.order = i
            cy += row_h
            k += 1
        cy += row_h * 0.4
    # the house's ordinary line at the foot: a regular knows to ask
    # (faint, but a full finger's height and the card's width on a touch screen)
    ask_h = if pad.on: 46.0 else: row_h
    ask = Rect(x + 16, cy - (if pad.on: 8.0 else: 0.0), w - 32, ask_h)
    over = contains(ask, mouse_pos())
    ptext_centered(ask_line, vec2(f32(x + w * 0.5), f32(ask.y + ask_h * 0.5 - 4.0)), 13, if over: ink else: faint)
    cy = ask.y + ask_h - row_h
    if nav_hit(ask, over and mouse_pressed(.left)) or key_pressed(.n0): res.secret = true
    if said != "":
        loop l in wrap_text(said, w - 60, 15):
            cy += 22.0
            ptext_centered(l, vec2(f32(x + w * 0.5), f32(cy + 12)), 15, if chalk: rgba(0.98, 0.85, 0.6, 0.95) else: STAMP)
    ptext(phoenix_text(cents), vec2(f32(x + 28), f32(y + h - 34)), 15, faint)
    set_font()
    res

# ---------------- at the table ----------------
# Along the bottom while one sits (or stands at the bar): where, what is playing, the things in
# front of one (hold 1, 2, 3... or the button: lift it and drink, or eat; let go and it stays in
# hand) and the things one can do, each on a letter.

struct TableBarResult:
    action = -1                     # the action chosen this frame (index into the actions)
    item = -1                       # the thing on the table taken up this frame
    down = false                    # (the held thing's key or button is held: drinking, eating)

_letter_key = (c: str) -> Key:
    match c:
        "M": .m
        "W": .w
        "P": .p
        "N": .n
        "S": .s
        "R": .r
        "C": .c
        "T": .t
        "B": .b
        "G": .g
        "K": .k
        else: .escape

table_bar = (fonts: Fonts, place: str, playing: str, things: str[], held: int, actions: str[], letters: str[]) -> TableBarResult:
    res = TableBarResult()
    sw = f64(screen_width()); sh = f64(screen_height())
    set_font(fonts.ui)
    size = 16.0
    lay = (labels: str[]) -> Rect[]:
        out: Rect[]
        bx = 0.0; by = 0.0
        loop l in labels:
            cw = ptext_width(l, size) + 28.0
            if bx > 0.0 and bx + cw > sw - 64.0:
                bx = 0.0; by += 38.0
            out.push(Rect(bx, by, cw, 32))
            bx += cw + 8.0
        out
    thing_labels = [loop k in 0..things.len(): (if pad.on: things[k] else: "{k + 1}  {things[k]}")]
    action_labels = [loop k in 0..actions.len(): (if pad.on: actions[k] else: "{letters[k]}  {actions[k]}")]
    tr = lay(thing_labels); ar = lay(action_labels)
    th = if tr.len() > 0: f64(tr[tr.len() - 1].y) + 38.0 else: 0.0
    ah = if ar.len() > 0: f64(ar[ar.len() - 1].y) + 38.0 else: 0.0
    h = 50.0 + th + ah + (if playing != "": 22.0 else: 0.0) + (if things.len() > 0: 22.0 else: 0.0)
    w = sw - 24.0
    x = 12.0
    y = sh - h - 12.0
    rect_rounded(x + 3, y + 4, w, h, 10, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 10, rgba(0.95, 0.91, 0.8, 0.94))
    set_font(fonts.title)
    ptext(fit_text(place, w - 40, 20), vec2(f32(x + 20), f32(y + 10)), 20, INK)
    set_font(fonts.ui)
    cy = y + 36.0
    if playing != "":
        ptext(fit_text(playing, w - 40, 14), vec2(f32(x + 20), f32(cy)), 14, LIGHT_INK); cy += 22.0
    if things.len() > 0:
        ptext(if pad.on: "On the table: hold one to drink or eat" else: "On the table: hold its number to drink or eat; Esc puts it down", vec2(f32(x + 20), f32(cy)), 13, LIGHT_INK)
        cy += 20.0
        keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6]
        loop k in 0..tr.len():
            r = Rect(x + 20 + tr[k].x, cy + tr[k].y, tr[k].w, tr[k].h)
            over = contains(r, mouse_pos())
            in_hand = k == held
            rect_rounded(r.x, r.y, r.w, r.h, r.h * 0.5, if in_hand: rgba(0.42, 0.29, 0.17, 1) else: if over: rgba(0.85, 0.74, 0.5, 0.6) else: rgba(0.88, 0.82, 0.68, 1))
            ptext_centered(thing_labels[k], vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, if in_hand: rgba(1, 0.97, 0.9, 1) else: rgba(0.32, 0.2, 0.1, 1))
            if nav_hit(r, over and mouse_pressed(.left)) or (k < keys.len() and key_pressed(keys[k])): res.item = k
            if k == held or res.item == k:
                if (over and mouse_down(.left)) or (k < keys.len() and key_down(keys[k])): res.down = true
        cy += th
    loop k in 0..ar.len():
        r = Rect(x + 20 + ar[k].x, cy + ar[k].y, ar[k].w, ar[k].h)
        if _lv_chip(r, action_labels[k], false, size): res.action = k
        if letters[k] != "Esc" and key_pressed(_letter_key(letters[k])): res.action = k
    set_font()
    res
