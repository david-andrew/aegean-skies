# The panels for the optional activities, in the paper style of the other counters: the menu (food
# and a very long drinks list, by section, with a search line), the bar along the bottom while one
# sits, the choice of when to wake, working on the aircraft, and the card while time passes. Each
# draws itself from plain data and says what was chosen; the game decides what that means.

use 'hud.jo'
use 'touch.jo'
use 'panels.jo'
use 'leisure_menu.jo'

_lv_over = (r: Rect) -> bool: contains(r, mouse_pos())
_lv_click = (r: Rect) -> bool: mouse_pressed(.left) and contains(r, mouse_pos())

_lv_chip = (r: Rect, label: str, selected: bool, size: f64 = 16.0) -> bool:
    fill = if selected: rgba(0.42, 0.29, 0.17, 1) else: if _lv_over(r): rgba(0.85, 0.74, 0.5, 0.6) else: rgba(0.88, 0.82, 0.68, 1)
    rect_rounded(r.x, r.y, r.w, r.h, r.h * 0.5, fill)
    text_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, if selected: rgba(1, 0.97, 0.9, 1) else: rgba(0.32, 0.2, 0.1, 1))
    _lv_click(r)

_lv_button = (r: Rect, label: str, enabled: bool = true, size: f64 = 16.0) -> bool:
    rect_rounded(r.x, r.y, r.w, r.h, 5, if not enabled: rgba(0.7, 0.68, 0.6, 1) else: if _lv_over(r): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1))
    text_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, rgba(1, 0.97, 0.9, 1))
    enabled and _lv_click(r)

_lv_panel = (x: f64, y: f64, w: f64, h: f64):
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)

# ---------------- the menu ----------------

struct MenuView:
    section = 0                     # 0: everything; else the section's number, from 1
    query = ""
    scroll = 0
    remark = ""                     # the keeper's last word, and what was brought
    line = ""
    fresh = false                   # (just opened: the key that opened it isn't typed)

struct MenuResult:
    order = -1                      # the item ordered this frame (index into the items)
    closed = false

# The menu of a place: its name, what kind of place, the items and their prices, one's money.
menu_panel = (fonts: Fonts, v: mut MenuView, place: str, kind: str, keeper: str, items: MenuItem[], prices: int[], cents: int) -> MenuResult:
    res = MenuResult()
    sw = f64(screen_width()); sh = f64(screen_height())
    # typing goes into the search line (letters, digits, spaces); Backspace takes one back
    typed = text_input()
    if v.fresh:
        v.fresh = false; typed = ""
    if typed != "":
        v.query = (v.query + typed)
        if v.query.len() > 28: v.query = v.query[0..28]
        v.scroll = 0
    if key_typed(.backspace) and v.query.len() > 0:
        v.query = v.query[0..v.query.len() - 1]; v.scroll = 0
    if key_pressed(.escape): res.closed = true
    sections = menu_sections(items)
    w = min(860.0, sw - 24.0)
    x = (sw - w) * 0.5
    top = max(12.0, pad_top_clear(x, x + w) + 6.0)
    h = if sh > 900.0: sh - top - 24.0 else: min(sh - top - 12.0, 700.0)
    y = top + max(0.0, (sh - top - 12.0 - h) * 0.5)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.4))
    _lv_panel(x, y, w, h)
    set_font(fonts.title)
    text(fit_text(place, w - 120, 26), vec2(f32(x + 26), f32(y + 18)), 26, INK)
    set_font(fonts.ui)
    text(fit_text("{kind}; {keeper} serving", w - 90, 15), vec2(f32(x + 26), f32(y + 52)), 15, LIGHT_INK)
    close = Rect(x + w - 44, y + 12, 32, 32)
    text_centered("×", vec2(f32(close.x + 16), f32(close.y + 14)), 30, if _lv_over(close): INK else: LIGHT_INK)
    if _lv_click(close): res.closed = true
    # the sections, as chips that wrap onto as many rows as they need
    cy = y + 78.0
    cx = x + 22.0
    chip_h = 28.0
    labels = ["All"] + [loop s in sections: s.replace("Coffee, tea and soft drinks", "Coffee and soft").replace("Fortified, vermouth and aperitifs", "Aperitifs").replace("Ouzo, tsipouro and anise", "Ouzo and anise").replace("Gin, rum, vodka and others", "Gin, rum, vodka").replace("Brandy and eaux-de-vie", "Brandy").replace("Liqueurs and amari", "Liqueurs")]
    loop k in 0..labels.len():
        cw = text_width(labels[k], 15) + 22.0
        if cx + cw > x + w - 22.0:
            cx = x + 22.0; cy += chip_h + 6.0
        if _lv_chip(Rect(cx, cy, cw, chip_h), labels[k], v.section == k, 15.0):
            v.section = k; v.scroll = 0
        cx += cw + 6.0
    cy += chip_h + 10.0
    # the search line
    sr = Rect(x + 22, cy, w - 44, 32)
    rect_rounded(sr.x, sr.y, sr.w, sr.h, 6, rgba(1, 1, 1, 0.55))
    cursor = if int(elapsed() * 2.0) % 2 == 0: "|" else: ""
    shown = if v.query == "": (if pad.on: "search: type a name, a grape, a country" else: "type to search: a name, a grape, a country, a year") else: v.query + cursor
    text(fit_text(shown, sr.w - 60, 17), vec2(f32(sr.x + 12), f32(sr.y + 6)), 17, if v.query == "": LIGHT_INK else: INK)
    if v.query != "":
        clear = Rect(sr.x + sr.w - 34, sr.y + 2, 30, 28)
        text_centered("×", vec2(f32(clear.x + 15), f32(clear.y + 13)), 24, if _lv_over(clear): INK else: LIGHT_INK)
        if _lv_click(clear): v.query = ""; v.scroll = 0
    cy += 42.0
    # the rows that match, a page at a time
    section = if v.section > 0 and v.section <= sections.len(): sections[v.section - 1] else: ""
    matches = menu_search(items, section, v.query)
    footer = 74.0 + (if v.remark != "" or v.line != "": 26.0 else: 0.0)
    row_h = 46.0
    per = max(1, int((y + h - footer - cy) / row_h))
    most = max(0, matches.len() - per)
    if mouse_wheel() != 0.0 and _lv_over(Rect(x, cy, w, per * row_h)): v.scroll = clamp(v.scroll - int(mouse_wheel()) * 3, 0, most)
    if key_pressed(.down): v.scroll = min(most, v.scroll + 1)
    if key_pressed(.up): v.scroll = max(0, v.scroll - 1)
    if key_pressed(.page_down): v.scroll = min(most, v.scroll + per)
    if key_pressed(.page_up): v.scroll = max(0, v.scroll - per)
    v.scroll = clamp(v.scroll, 0, most)
    if matches.len() == 0: text("Nothing by that name. The keeper shrugs.", vec2(f32(x + 30), f32(cy + 14)), 18, LIGHT_INK)
    bw = 84.0
    loop r in 0..per:
        k = v.scroll + r
        if k >= matches.len(): break
        d = items[matches[k]]
        price = prices[matches[k]]
        ry = cy + f64(r) * row_h
        if r % 2 == 1: rect(x + 18, ry - 4, w - 36, row_h, rgba(0.86, 0.8, 0.66, 0.35))
        name_w = w - bw - 150.0
        text(fit_text(d.name, name_w, 18), vec2(f32(x + 28), f32(ry)), 18, INK)
        sub = if d.note != "": "{d.group}: {d.note}" else: d.group
        text(fit_text(sub, name_w, 14), vec2(f32(x + 28), f32(ry + 22)), 14, LIGHT_INK)
        pt = lire_short(price)
        text(pt, vec2(f32(x + w - 40 - bw - text_width(pt, 17)), f32(ry + 8)), 17, INK)
        b = Rect(x + w - 30 - bw, ry + 3, bw, 32)
        if _lv_button(b, "order", cents >= price, 15.0): res.order = matches[k]
    # the page arrows (for a finger), and how far down the list one is
    py = y + h - footer + 4.0
    if matches.len() > per:
        up = Rect(x + w * 0.5 - 92, py, 56, 28)
        dn = Rect(x + w * 0.5 + 36, py, 56, 28)
        if _lv_chip(up, "up", false, 15.0): v.scroll = max(0, v.scroll - per)
        if _lv_chip(dn, "down", false, 15.0): v.scroll = min(most, v.scroll + per)
        text_centered("{v.scroll + 1}-{min(matches.len(), v.scroll + per)} of {matches.len()}", vec2(f32(x + w * 0.5), f32(py + 14)), 14, LIGHT_INK)
    fy = y + h - 40.0
    line(vec2(f32(x + 24), f32(fy - 8)), vec2(f32(x + w - 24), f32(fy - 8)), 1.5, PAPER_DARK)
    if v.remark != "" or v.line != "":
        said = if v.remark != "": "{keeper}: \"{v.remark}\"" else: v.line
        text(fit_text(said, w - 60, 16), vec2(f32(x + 28), f32(fy - 34)), 16, STAMP)
    text(lire_short(cents), vec2(f32(x + 28), f32(fy)), 19, INK)
    if v.line != "" and v.remark != "": text(fit_text(v.line, w - 220, 15), vec2(f32(x + w - 30 - text_width(fit_text(v.line, w - 220, 15), 15)), f32(fy + 3)), 15, LIGHT_INK)
    set_font()
    res

lire_short = (cents: int) -> str:
    if cents % 100 == 0: "{cents / 100} lire" else: "{cents / 100}.{(cents % 100):02} lire"

# ---------------- sitting ----------------

struct SitResult:
    choice = -1                     # index into the actions offered

# Along the bottom while one sits: where, what is playing, and the things one can do.
sitting_bar = (fonts: Fonts, place: str, playing: str, actions: str[]) -> SitResult:
    res = SitResult()
    sw = f64(screen_width()); sh = f64(screen_height())
    set_font(fonts.ui)
    size = 17.0
    widths = [loop a in actions: text_width(a, size) + 30.0]
    total = 0.0
    loop wv in widths: total += wv + 8.0
    rows = if total > sw - 40.0: 2 else: 1
    h = 54.0 + f64(rows) * 40.0 + (if playing != "": 22.0 else: 0.0)
    y = sh - h - 12.0
    w = min(sw - 24.0, max(total + 40.0, 420.0))
    if rows == 2: w = sw - 24.0
    x = (sw - w) * 0.5
    rect_rounded(x + 3, y + 4, w, h, 10, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 10, rgba(0.95, 0.91, 0.8, 0.94))
    set_font(fonts.title)
    text(fit_text(place, w - 40, 20), vec2(f32(x + 20), f32(y + 10)), 20, INK)
    set_font(fonts.ui)
    if playing != "": text(fit_text(playing, w - 40, 15), vec2(f32(x + 20), f32(y + 36)), 15, LIGHT_INK)
    by = y + h - f64(rows) * 40.0 - 8.0
    bx = x + 20.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6]
    loop k in 0..actions.len():
        if bx + widths[k] > x + w - 16.0:
            bx = x + 20.0; by += 40.0
        r = Rect(bx, by, widths[k], 32)
        if _lv_chip(r, if pad.on: actions[k] else: "{k + 1}  {actions[k]}", false, size): res.choice = k
        if k < keys.len() and key_pressed(keys[k]): res.choice = k
        bx += widths[k] + 8.0
    set_font()
    res

# ---------------- choices: rest, a spare room, the aircraft ----------------

struct ChoiceResult:
    choice = -1
    closed = false

# A short list of choices on paper, with a line said above them (who and what).
choice_panel = (fonts: Fonts, title: str, sub: str, said: str, choices: str[]) -> ChoiceResult:
    res = ChoiceResult()
    sw = f64(screen_width()); sh = f64(screen_height())
    w = min(640.0, sw - 32.0)
    set_font(fonts.ui)
    lines = if said != "": wrap_text(said, w - 60, 18) else: []
    h = 92.0 + f64(lines.len()) * 24.0 + f64(choices.len()) * 40.0 + 20.0
    x = (sw - w) * 0.5
    y = max(12.0, (sh - h) * 0.5)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.35))
    _lv_panel(x, y, w, h)
    set_font(fonts.title)
    text(fit_text(title, w - 90, 24), vec2(f32(x + 26), f32(y + 18)), 24, INK)
    set_font(fonts.ui)
    if sub != "": text(fit_text(sub, w - 60, 15), vec2(f32(x + 26), f32(y + 50)), 15, LIGHT_INK)
    close = Rect(x + w - 44, y + 12, 32, 32)
    text_centered("×", vec2(f32(close.x + 16), f32(close.y + 14)), 30, if _lv_over(close): INK else: LIGHT_INK)
    if _lv_click(close) or key_pressed(.escape): res.closed = true
    ly = y + 78.0
    loop k in 0..lines.len(): text(lines[k], vec2(f32(x + 28), f32(ly + f64(k) * 24.0)), 18, INK)
    cy = ly + f64(lines.len()) * 24.0 + 10.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8]
    loop k in 0..choices.len():
        r = Rect(x + 20, cy + f64(k) * 40.0, w - 40, 34)
        if _lv_over(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        text(fit_text(if pad.on: choices[k] else: "{k + 1}.  {choices[k]}", r.w - 20, 18), vec2(f32(r.x + 10), f32(r.y + 7)), 18, rgba(0.32, 0.2, 0.1, 1))
        if _lv_click(r): res.choice = k
        if k < keys.len() and key_pressed(keys[k]): res.choice = k
    set_font()
    res

# ---------------- time passing ----------------

# The screen darkens while time passes (sleeping, lingering, working): what is happening and the
# clock running on. `fade` 0..1.
time_card = (fonts: Fonts, doing: str, clock: str, fade: f64):
    sw = f64(screen_width()); sh = f64(screen_height())
    rect(0, 0, sw, sh, rgba(0.02, 0.03, 0.05, f32(0.88 * fade)))
    if fade < 0.3: return
    a = f32(clamp((fade - 0.3) / 0.4, 0.0, 1.0))
    set_font(fonts.title)
    text_centered(clock, vec2(f32(sw * 0.5), f32(sh * 0.45)), 44, rgba(1, 0.95, 0.82, a))
    set_font(fonts.ui)
    text_centered(doing, vec2(f32(sw * 0.5), f32(sh * 0.45 + 46)), 20, rgba(1, 0.95, 0.82, a * 0.85))
    set_font()
