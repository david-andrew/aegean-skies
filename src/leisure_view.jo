# The panels for the optional activities, in the paper style of the other counters: the menu (food
# and a very long drinks list, by section, with a search line), the bar along the bottom while one
# sits, the choice of when to wake, working on the aircraft, and the card while time passes. Each
# draws itself from plain data and says what was chosen; the game decides what that means.

use 'phoenix.jo'
use 'touch.jo'
use 'hud.jo'
use 'touch.jo'
use 'panels.jo'
use 'leisure_menu.jo'
use 'speech_stream.jo'
use 'spoken_view.jo'

# (the mouse in the panel's own units: panels are drawn larger on small screens)
_lv_wheel_rows = 0.0               # (the bill of fare's wheel: a part of a row not yet scrolled)
_lv_over = (r: Rect) -> bool: contains(r, screen_to_world(mouse_pos()))
_lv_click = (r: Rect) -> bool: pad_hit(r, mouse_pressed(.left) and contains(r, screen_to_world(mouse_pos())))

_lv_chip = (r: Rect, label: str, selected: bool, size: f64 = 16.0) -> bool:
    fill = if selected: rgba(0.42, 0.29, 0.17, 1) else: if _lv_over(r): rgba(0.85, 0.74, 0.5, 0.6) else: rgba(0.88, 0.82, 0.68, 1)
    rect_rounded(r.x, r.y, r.w, r.h, r.h * 0.5, fill)
    ptext_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, if selected: rgba(1, 0.97, 0.9, 1) else: rgba(0.32, 0.2, 0.1, 1))
    _lv_click(r)

_lv_button = (r: Rect, label: str, enabled: bool = true, size: f64 = 16.0) -> bool:
    rect_rounded(r.x, r.y, r.w, r.h, 5, if not enabled: rgba(0.7, 0.68, 0.6, 1) else: if _lv_over(r): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1))
    ptext_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, rgba(1, 0.97, 0.9, 1))
    enabled and _lv_click(r)

# (the bill of fare's rows drawn by a finger: where it went down, the row then, and whether it has
# moved enough to be a drag rather than a tap)
_lv_drag_on = false
_lv_drag_y = 0.0
_lv_drag_from = 0
_lv_dragged = false

# An order button: a click, or on a touch screen a finger lifted from it without having dragged.
_lv_order = (r: Rect, enabled: bool) -> bool:
    if not pad.on: return _lv_button(r, "order", enabled, 15.0)
    rect_rounded(r.x, r.y, r.w, r.h, 5, if not enabled: rgba(0.7, 0.68, 0.6, 1) else: if _lv_over(r) and mouse_down(.left) and not _lv_dragged: rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1))
    ptext_centered("order", vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), 15.0, rgba(1, 0.97, 0.9, 1))
    enabled and pad_hit(r, mouse_released(.left) and not _lv_dragged and _lv_over(r))

_lv_panel = (x: f64, y: f64, w: f64, h: f64):
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)

# ---------------- the menu ----------------

struct MenuView:
    section = 0                     # 0: everything; else the section's number, from 1
    query = ""
    scroll = 0
    remark = ""                     # the keeper's last word, and what was brought
    line = ""
    refused = false                 # (the line says why not: in the stamp's red; else plain ink)
    fresh = false                   # (just opened: the key that opened it isn't typed)

struct MenuResult:
    order = -1                      # the item ordered this frame (index into the items)
    closed = false

# The menu of a place: its name, what kind of place, the items and their prices, one's money.
menu_panel = (fonts: Fonts, v: mut MenuView, place: str, kind: str, keeper: str, items: MenuItem[], prices: int[], cents: int) -> MenuResult:
    res = MenuResult()
    # (drawn larger on a small screen, so its type reads: laid out in the screen's units over kz;
    # on a screen too short for its heading, sections, search and two rows, smaller to fit)
    kz = min(readable_k(15.0), f64(screen_height()) / 400.0)
    push_transform(); scale(kz, kz)
    sw = f64(screen_width()) / kz; sh = f64(screen_height()) / kz
    # typing goes into the search line (letters, digits, spaces); Backspace takes one back (on a
    # touch screen, the line is a text field: a tap on it brings up the phone's keyboard)
    typed = if pad.on: "" else: text_input()
    if v.fresh:
        v.fresh = false; typed = ""
    if typed != "":
        v.query = (v.query + typed)
        if v.query.len() > 28: v.query = v.query[0..28]
        v.scroll = 0
    if not pad.on and key_typed(.backspace) and v.query.len() > 0:
        v.query = v.query[0..v.query.len() - 1]; v.scroll = 0
    if mkey(.escape): res.closed = true
    sections = menu_sections(items)
    w = min(860.0, sw - 24.0)
    x = (sw - w) * 0.5
    top = max(12.0, pad_top_clear((x) * kz, (x + w) * kz) / kz + 6.0)
    h = if sh > 900.0: sh - top - 24.0 else: min(sh - top - 12.0, 700.0)
    y = top + max(0.0, (sh - top - 12.0 - h) * 0.5)
    shade_screen(rgba(0.03, 0.04, 0.06, 0.4), kz)
    _lv_panel(x, y, w, h)
    set_font(fonts.title)
    ptext(fit_text(place, w - 120, 26), vec2(f32(x + 26), f32(y + 18)), 26, INK)
    set_font(fonts.ui)
    ptext(fit_text("{kind}; {keeper} serving", w - 90, 15), vec2(f32(x + 26), f32(y + 52)), 15, LIGHT_INK)
    close = Rect(x + w - 44, y + 12, 32, 32)
    ptext_centered("×", vec2(f32(close.x + 16), f32(close.y + 14)), 30, if _lv_over(close): INK else: LIGHT_INK)
    if _lv_click(close): res.closed = true
    # the sections, as chips that wrap onto as many rows as they need
    cy = y + 78.0
    cx = x + 22.0
    chip_h = tap_size(28.0, kz)     # (44 points tall at least on a touch screen, as every tap here)
    labels = ["All"] + [loop s in sections: s.replace("Coffee, tea and soft drinks", "Coffee and soft").replace("Fortified, vermouth and aperitifs", "Aperitifs").replace("Ouzo, tsipouro and anise", "Ouzo and anise").replace("Gin, rum, vodka and others", "Gin, rum, vodka").replace("Brandy and eaux-de-vie", "Brandy").replace("Liqueurs and amari", "Liqueurs")]
    loop k in 0..labels.len():
        cw = ptext_width(labels[k], 15) + 22.0
        if cx + cw > x + w - 22.0:
            cx = x + 22.0; cy += chip_h + 6.0
        if _lv_chip(Rect(cx, cy, cw, chip_h), labels[k], v.section == k, 15.0):
            v.section = k; v.scroll = 0
        cx += cw + 6.0
    cy += chip_h + 10.0
    # the search line
    sr = Rect(x + 22, cy, w - 44, tap_size(32.0, kz))
    if pad.on:
        q = paper_field(sr, v.query, "menu-search", 28, "search: a name, a grape, a country")
        if q != v.query: v.query = q; v.scroll = 0
    else:
        rect_rounded(sr.x, sr.y, sr.w, sr.h, 6, rgba(1, 1, 1, 0.55))
        cursor = if int(elapsed() * 2.0) % 2 == 0: "|" else: ""
        shown = if v.query == "": "type to search: a name, a grape, a country, a year" else: v.query + cursor
        ptext(fit_text(shown, sr.w - 60, 17), vec2(f32(sr.x + 12), f32(sr.y + 6)), 17, if v.query == "": LIGHT_INK else: INK)
    if v.query != "" and not pad.on:
        clear = Rect(sr.x + sr.w - 34, sr.y + 2, 30, 28)
        ptext_centered("×", vec2(f32(clear.x + 15), f32(clear.y + 13)), 24, if _lv_over(clear): INK else: LIGHT_INK)
        if _lv_click(clear): v.query = ""; v.scroll = 0
    cy += sr.h + 10.0
    # the rows that match, a page at a time
    section = if v.section > 0 and v.section <= sections.len(): sections[v.section - 1] else: ""
    matches = menu_search(items, section, v.query)
    footer = 46.0 + tap_size(28.0, kz) + (if v.remark != "" or v.line != "": 32.0 else: 0.0)
    order_h = tap_size(32.0, kz)
    row_h = max(46.0, order_h + 10.0)
    per = max(1, int((y + h - footer - cy) / row_h))
    # (a short screen, fewer than three rows: the pager goes up onto the purse's line, a row more)
    compact = per < 3
    if compact:
        footer = 46.0 + (if v.remark != "" or v.line != "": 32.0 else: 0.0)
        per = max(1, int((y + h - footer - cy) / row_h))
    most = max(0, matches.len() - per)
    # (the wheel's rows: a part of a notch kept until it makes a whole row)
    if mouse_wheel() != 0.0 and _lv_over(Rect(x, cy, w, per * row_h)):
        global _lv_wheel_rows
        _lv_wheel_rows += mouse_wheel() * 3.0
        rows = int(_lv_wheel_rows)
        _lv_wheel_rows -= f64(rows)
        v.scroll = clamp(v.scroll - rows, 0, most)
    # (a finger drawn up or down the rows moves them, a row per row's height; on a touch screen an
    # order is taken when the finger lifts from its button unmoved, so a drag never orders)
    rows_box = Rect(x, cy - 4, w, per * row_h)
    m = screen_to_world(mouse_pos())
    if mouse_pressed(.left) and contains(rows_box, m):
        global _lv_drag_on, _lv_drag_y, _lv_drag_from, _lv_dragged
        _lv_drag_on = true; _lv_drag_y = f64(m.y); _lv_drag_from = v.scroll; _lv_dragged = false
    if _lv_drag_on and mouse_down(.left):
        moved = f64(m.y) - _lv_drag_y
        if abs(moved) > 12.0: _lv_dragged = true
        if _lv_dragged: v.scroll = clamp(_lv_drag_from - int(round(moved / row_h)), 0, most)
    if not mouse_down(.left) and not mouse_released(.left): _lv_drag_on = false
    if mkey(.down): v.scroll = min(most, v.scroll + 1)
    if mkey(.up): v.scroll = max(0, v.scroll - 1)
    if mkey(.page_down): v.scroll = min(most, v.scroll + per)
    if mkey(.page_up): v.scroll = max(0, v.scroll - per)
    v.scroll = clamp(v.scroll, 0, most)
    if matches.len() == 0: ptext("Nothing by that name. The keeper shrugs.", vec2(f32(x + 30), f32(cy + 14)), 18, LIGHT_INK)
    bw = 84.0
    loop r in 0..per:
        k = v.scroll + r
        if k >= matches.len(): break
        d = items[matches[k]]
        price = prices[matches[k]]
        ry = cy + f64(r) * row_h
        if r % 2 == 1: rect(x + 18, ry - 4, w - 36, row_h, rgba(0.86, 0.8, 0.66, 0.35))
        name_w = w - bw - 150.0
        ptext(fit_text(d.name, name_w, 18), vec2(f32(x + 28), f32(ry)), 18, INK)
        sub = if d.note != "": "{d.group}: {d.note}" else: d.group
        ptext(fit_text(sub, name_w, 14), vec2(f32(x + 28), f32(ry + 22)), 14, LIGHT_INK)
        pt = phoenix_text(price)
        ptext(pt, vec2(f32(x + w - 40 - bw - ptext_width(pt, 17)), f32(ry + 8)), 17, INK)
        b = Rect(x + w - 30 - bw, ry + 3, bw, order_h)
        if _lv_order(b, cents >= price): res.order = matches[k]
    # the page arrows (for a finger), and how far down the list one is
    py = if compact: y + h - 40.0 - tap_size(28.0, kz) * 0.5 + 10.0 else: y + h - footer + 4.0
    if matches.len() > per:
        pg = tap_size(28.0, kz)
        pcx = if compact: x + w - 170.0 else: x + w * 0.5     # (compact: at the purse line's right)
        up = Rect(pcx - 92, py, 56, pg)
        dn = Rect(pcx + 36, py, 56, pg)
        if _lv_chip(up, "up", false, 15.0): v.scroll = max(0, v.scroll - per)
        if _lv_chip(dn, "down", false, 15.0): v.scroll = min(most, v.scroll + per)
        ptext_centered("{v.scroll + 1}-{min(matches.len(), v.scroll + per)} of {matches.len()}", vec2(f32(pcx), f32(py + pg * 0.5)), 14, LIGHT_INK)
    fy = y + h - 40.0
    line(vec2(f32(x + 24), f32(fy - 8)), vec2(f32(x + w - 24), f32(fy - 8)), 1.5, PAPER_DARK)
    if v.remark != "" or v.line != "":
        # (what was brought, or why not; the keeper's word on it is over whoever serves, in the
        # world: aegean.jo's draw_keeper_word)
        if v.line != "": ptext(fit_text(v.line, w - 60, 16), vec2(f32(x + 28), f32(fy - 34)), 16, if not v.refused: INK else: STAMP)
    ptext(purse_text(cents), vec2(f32(x + 28), f32(fy)), 19, INK)
    set_font()
    pop_transform()
    res

# ---------------- sitting ----------------

struct SitResult:
    choice = -1                     # index into the actions offered

# Along the bottom while one sits: where, what is playing, and the things one can do.
sitting_bar = (fonts: Fonts, place: str, playing: str, actions: str[]) -> SitResult:
    res = SitResult()
    # (drawn larger on a small screen, so its type reads)
    kz = readable_k(15.0)
    push_transform(); scale(kz, kz)
    sw = f64(screen_width()) / kz; sh = f64(screen_height()) / kz
    set_font(fonts.ui)
    size = 17.0
    widths = [loop a in actions: ptext_width(a, size) + 30.0]
    total = 0.0
    loop wv in widths: total += wv + 8.0
    rows = if total > sw - 40.0: 2 else: 1
    # (as wide as its line needs, up to the screen; a line longer still wraps, up to three)
    w = min(sw - 24.0, max(max(total + 40.0, 420.0), if playing != "": ptext_width(playing, 15.0) + 40.0 else: 0.0))
    if rows == 2: w = sw - 24.0
    lines = if playing != "": wrap_text(playing, w - 40.0, 15.0) else: []
    if lines.len() > 3: lines = [lines[0], lines[1], fit_text(join(lines[2..lines.len()], " "), w - 40.0, 15.0)]
    # (a finger's chips: 44 points tall at least on a touch screen)
    chip_h = tap_size(32.0, kz); step = chip_h + 8.0
    h = 54.0 + f64(rows) * step + 22.0 * f64(lines.len())
    y = sh - h - 12.0
    x = (sw - w) * 0.5
    rect_rounded(x + 3, y + 4, w, h, 10, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 10, rgba(0.95, 0.91, 0.8, 0.94))
    set_font(fonts.title)
    ptext(fit_text(place, w - 40, 20), vec2(f32(x + 20), f32(y + 10)), 20, INK)
    set_font(fonts.ui)
    loop k in 0..lines.len(): ptext(lines[k], vec2(f32(x + 20), f32(y + 36.0 + 20.0 * f64(k))), 15, LIGHT_INK)
    by = y + h - f64(rows) * step - 8.0
    bx = x + 20.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6]
    loop k in 0..actions.len():
        if bx + widths[k] > x + w - 16.0:
            bx = x + 20.0; by += step
        r = Rect(bx, by, widths[k], chip_h)
        if _lv_chip(r, if pad.on: actions[k] else: "{k + 1}  {actions[k]}", false, size): res.choice = k
        if k < keys.len() and key_pressed(keys[k]): res.choice = k
        bx += widths[k] + 8.0
    set_font()
    pop_transform()
    res

# ---------------- choices: rest, a spare room, the aircraft ----------------

struct ChoiceResult:
    choice = -1
    closed = false

# A short list of choices on paper, with a line said above them (who and what).
# `spoken`: the line is someone's words (a desk, a host, a keeper): it arrives as it is said, and
# the choices come once it is whole (src/spoken_view.jo); a line that only tells what happened is
# there at once.
choice_panel = (fonts: Fonts, title: str, sub: str, said: str, choices: str[], spoken: bool = false) -> ChoiceResult:
    res = ChoiceResult()
    # (drawn larger on a small screen, so its type reads: laid out in the screen's units over kz)
    kz = readable_k(15.0)
    push_transform(); scale(kz, kz)
    sw = f64(screen_width()) / kz; sh = f64(screen_height()) / kz
    w = min(640.0, sw - 32.0)
    set_font(fonts.ui)
    lines = if said != "": wrap_text(said, w - 60, 18) else: []
    h = 92.0 + f64(lines.len()) * 24.0 + f64(choices.len()) * 40.0 + 20.0
    x = (sw - w) * 0.5
    y = max(12.0, (sh - h) * 0.5)
    shade_screen(rgba(0.03, 0.04, 0.06, 0.35), kz)
    _lv_panel(x, y, w, h)
    set_font(fonts.title)
    ptext(fit_text(title, w - 90, 24), vec2(f32(x + 26), f32(y + 18)), 24, INK)
    set_font(fonts.ui)
    if sub != "": ptext(fit_text(sub, w - 60, 15), vec2(f32(x + 26), f32(y + 50)), 15, LIGHT_INK)
    close = Rect(x + w - 44, y + 12, 32, 32)
    ptext_centered("×", vec2(f32(close.x + 16), f32(close.y + 14)), 30, if _lv_over(close): INK else: LIGHT_INK)
    if _lv_click(close) or mkey(.escape): res.closed = true
    ly = y + 78.0
    heard = if spoken and said != "": spoken_line("desk", said, pressed = mouse_pressed(.left) and _lv_over(Rect(x, y, w, h)) and not _lv_over(close)) else: Said()
    counts = spoken_line_counts(lines, heard.shown)
    loop k in 0..lines.len():
        if counts[k] != 0: ptext(lines[k], vec2(f32(x + 28), f32(ly + f64(k) * 24.0)), 18, INK, chars = counts[k])
    cy = ly + f64(lines.len()) * 24.0 + 10.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8]
    fade = f32(said_fade(heard))
    loop k in 0..choices.len():
        if not heard.done: break
        r = Rect(x + 20, cy + f64(k) * 40.0, w - 40, 34)
        if heard.ready and _lv_over(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        ptext(fit_text(if pad.on: choices[k] else: "{k + 1}.  {choices[k]}", r.w - 20, 18), vec2(f32(r.x + 10), f32(r.y + 7)), 18, rgba(0.32, 0.2, 0.1, fade))
        if not heard.ready: continue
        if _lv_click(r): res.choice = k
        if k < keys.len() and key_pressed(keys[k]): res.choice = k
    set_font()
    pop_transform()
    res

# ---------------- time passing ----------------

# The screen darkens while time passes (sleeping, lingering, working): what is happening and the
# clock running on. `fade` 0..1.
time_card = (fonts: Fonts, doing: str, clock: str, fade: f64):
    sw = f64(screen_width()); sh = f64(screen_height())
    shade_screen(rgba(0.02, 0.03, 0.05, f32(0.88 * fade)))
    if fade < 0.3: return
    a = f32(clamp((fade - 0.3) / 0.4, 0.0, 1.0))
    set_font(fonts.title)
    ptext_centered(clock, vec2(f32(sw * 0.5), f32(sh * 0.45)), 44, rgba(1, 0.95, 0.82, a))
    set_font(fonts.ui)
    ptext_centered(doing, vec2(f32(sw * 0.5), f32(sh * 0.45 + 46)), 20, rgba(1, 0.95, 0.82, a * 0.85))
    set_font()

# ---------------- the bill of fare ----------------
# What a place offers, as it would show it: a printed card at the hotel (a double rule, the
# dishes of the day), a chalkboard at the coffee house. A handful of things with their prices.
# Its last line is the house's ordinary "other wines and spirits on request": ask (click it, or 0)
# and the keeper brings out the whole book.

struct BillResult:
    order = -1                      # the line ordered this frame (index into the items given)
    closed = false
    secret = false                  # asked for the rest

struct BillSection:
    title: str
    first: int                      # (the items from here...)
    count: int

bill_of_fare = (fonts: Fonts, place: str, chalk: bool, sections: BillSection[], items: MenuItem[], prices: int[], cents: int, said: str, ask_line: str) -> BillResult:
    res = BillResult()
    sw = f64(screen_width()); sh = f64(screen_height())
    row_h = if pad.on: 36.0 else: 30.0
    w = min(520.0, sw - 24.0)
    said_h = if said != "": 22.0 * f64(wrap_text(said, w - 60, 15).len()) + 6.0 else: 0.0
    h = min(sh - 20.0, 96.0 + f64(sections.len()) * row_h * 1.35 + f64(items.len()) * row_h + (if pad.on: 38.0 else: row_h) + said_h + 44.0)
    x = (sw - w) * 0.5
    top = max(10.0, pad_top_clear(x, x + w) + 4.0)
    y = top + max(0.0, (sh - top - 10.0 - h) * 0.5)
    shade_screen(rgba(0.03, 0.04, 0.06, 0.35))
    ink = if chalk: rgba(0.95, 0.94, 0.88, 0.92) else: INK
    faint = if chalk: rgba(0.95, 0.94, 0.88, 0.6) else: LIGHT_INK
    if chalk:
        # (a blackboard in a wooden frame)
        rect_rounded(x - 10 + 4, y - 10 + 6, w + 20, h + 20, 6, rgba(0, 0, 0, 0.3))
        rect_rounded(x - 10, y - 10, w + 20, h + 20, 6, rgba(0.42, 0.29, 0.17, 1))
        rect(x, y, w, h, rgba(0.13, 0.17, 0.15, 1))
        loop k in 0..9: line(vec2(f32(x + 20 + f64(k) * w * 0.11), f32(y + 8 + f64(k % 3) * h * 0.3)), vec2(f32(x + 60 + f64(k) * w * 0.11), f32(y + 16 + f64(k % 3) * h * 0.3)), 6.0, rgba(1, 1, 1, 0.025))
    else:
        rect(x + 4, y + 6, w, h, rgba(0, 0, 0, 0.3))
        rect(x, y, w, h, rgba(0.97, 0.94, 0.85, 1))
        rect_outline(x + 10, y + 10, w - 20, h - 20, 2.0, INK)
        rect_outline(x + 15, y + 15, w - 30, h - 30, 1.0, INK)
    set_font(fonts.title)
    ptext_centered(place.upper(), vec2(f32(x + w * 0.5), f32(y + 40)), if w < 420.0: 24 else: 28, ink)
    set_font(fonts.ui)
    ptext_centered(if chalk: "Today" else: "Bill of Fare", vec2(f32(x + w * 0.5), f32(y + 70)), 15, faint)
    close = Rect(x + w - 42, y + 18, 28, 28)
    ptext_centered("×", vec2(f32(close.x + 14), f32(close.y + 12)), 26, if contains(close, mouse_pos()): ink else: faint)
    if mouse_pressed(.left) and contains(close, mouse_pos()) or mkey(.escape): res.closed = true
    cy = y + 96.0
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8, .n9]
    k = 0
    loop sec in sections:
        set_font(fonts.title)
        ptext_centered(sec.title, vec2(f32(x + w * 0.5), f32(cy)), 16, ink)
        set_font(fonts.ui)
        cy += row_h * 0.95
        loop i in sec.first..sec.first + sec.count:
            d = items[i]
            r = Rect(x + 24, cy - 4, w - 48, row_h - 2)
            over = contains(r, mouse_pos())
            if over: rect_rounded(r.x, r.y, r.w, r.h, 4, if chalk: rgba(1, 1, 1, 0.08) else: rgba(0.85, 0.74, 0.5, 0.35))
            name = if pad.on: d.name else: "{k + 1}  {d.name}"
            price = phoenix_text(prices[i])
            nw = ptext_width(fit_text(name, w * 0.62, 16), 16)
            ptext(fit_text(name, w * 0.62, 16), vec2(f32(x + 32), f32(cy)), 16, if cents >= prices[i]: ink else: faint)
            pw = ptext_width(price, 16)
            ptext(price, vec2(f32(x + w - 32 - pw), f32(cy)), 16, ink)
            # (dotted leaders from the name to the price)
            dx = x + 40.0 + nw
            loop dx < x + w - 40.0 - pw:
                circle(vec2(f32(dx), f32(cy + 12)), 1.0, faint); dx += 7.0
            if pad_hit(r, over and mouse_pressed(.left)) or (k < keys.len() and key_pressed(keys[k])): res.order = i
            cy += row_h
            k += 1
        cy += row_h * 0.4
    # the house's ordinary line at the foot: a regular knows to ask
    # (faint, but a full finger's height and the card's width on a touch screen)
    ask_h = if pad.on: 46.0 else: row_h
    ask = Rect(x + 16, cy - (if pad.on: 8.0 else: 0.0), w - 32, ask_h)
    over = contains(ask, mouse_pos())
    ptext_centered(ask_line, vec2(f32(x + w * 0.5), f32(ask.y + ask_h * 0.5 - 4.0)), 13, if over: ink else: faint)
    cy = ask.y + ask_h - row_h
    if pad_hit(ask, over and mouse_pressed(.left)) or key_pressed(.n0): res.secret = true
    if said != "":
        # (what was brought, and the keeper's word with it, arriving as it is said)
        said_lines = wrap_text(said, w - 60, 15)
        counts = spoken_line_counts(said_lines, spoken_heard("bar", said).shown)
        loop k in 0..said_lines.len():
            cy += 22.0
            l = said_lines[k]
            if counts[k] != 0: ptext(l, vec2(f32(x + w * 0.5 - ptext_width(l, 15) * 0.5), f32(cy + 12.0 - 15.0 * 0.625)), 15, if chalk: rgba(0.98, 0.85, 0.6, 0.95) else: STAMP, chars = counts[k])
    ptext(purse_text(cents), vec2(f32(x + 28), f32(y + h - 34)), 15, faint)
    set_font()
    res

# ---------------- at the table ----------------
# What the table's keys and buttons asked for this frame (seat_pills, and the keys, in aegean.jo):
# a thing taken up, and whether its key or button is held (drinking, eating).

struct TableBarResult:
    action = -1                     # the action chosen this frame (index into the actions)
    item = -1                       # the thing on the table taken up this frame
    down = false                    # (the held thing's key or button is held: drinking, eating)
    area: Rect = Rect(0, 0, 0, 0)   # (where the bar is on the screen: a drag begun there is its own)

_letter_key = (c: str) -> Key:
    match c:
        "M": .m
        "W": .w
        "P": .p
        "N": .n
        "S": .s
        "R": .r
        "C": .c
        "T": .t
        "B": .b
        "G": .g
        "K": .k
        else: .escape

# ---------------- sending for a musician ----------------

struct FetchResult:
    choice = -1                     # 0 send the boy, 1 another number, 2 never mind
    closed = false

_lv_plain = (r: Rect, label: str, size: f64 = 16.0) -> bool:
    rect_rounded(r.x, r.y, r.w, r.h, 5, if _lv_over(r): rgba(0.85, 0.74, 0.5, 0.75) else: rgba(0.88, 0.82, 0.68, 1))
    rect_rounded_outline(r.x, r.y, r.w, r.h, 5, 1.2, PAPER_DARK)
    ptext_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), size, rgba(0.32, 0.2, 0.1, 1))
    _lv_click(r)

# A number asked for whose players aren't all here: who is missing (`said`, a line or two), and
# three buttons: send the house's boy for them (`send`: the label with the tip), choose another
# number, never mind. Keys: Enter or 1 sends, 2 another, 3 or Escape never mind.
fetch_panel = (fonts: Fonts, title: str, sub: str, said: str, send: str, can_send: bool) -> FetchResult:
    res = FetchResult()
    kz = readable_k(15.0)
    push_transform(); scale(kz, kz)
    sw = f64(screen_width()) / kz; sh = f64(screen_height()) / kz
    w = min(600.0, sw - 32.0)
    set_font(fonts.ui)
    lines = if said != "": wrap_text(said, w - 60, 18) else: []
    narrow = w < 470.0
    rows = if narrow: 3 else: 2
    h = 96.0 + f64(lines.len()) * 24.0 + f64(rows) * 50.0 + 24.0
    x = (sw - w) * 0.5
    y = max(12.0, (sh - h) * 0.5)
    shade_screen(rgba(0.03, 0.04, 0.06, 0.4), kz)
    _lv_panel(x, y, w, h)
    set_font(fonts.title)
    ptext(fit_text(title, w - 90, 24), vec2(f32(x + 26), f32(y + 18)), 24, INK)
    set_font(fonts.ui)
    if sub != "": ptext(fit_text(sub, w - 60, 15), vec2(f32(x + 26), f32(y + 50)), 15, LIGHT_INK)
    close = Rect(x + w - 44, y + 12, 32, 32)
    ptext_centered("×", vec2(f32(close.x + 16), f32(close.y + 14)), 30, if _lv_over(close): INK else: LIGHT_INK)
    if _lv_click(close) or mkey(.escape): res.closed = true
    ly = y + 80.0
    loop k in 0..lines.len(): ptext(lines[k], vec2(f32(x + 28), f32(ly + f64(k) * 24.0)), 18, INK)
    by = ly + f64(lines.len()) * 24.0 + 12.0
    # (the boy's errand across the panel; another number and never mind side by side under it)
    if _lv_button(Rect(x + 24, by, w - 48, 40), fit_text(send, w - 70, 17), can_send, 17.0): res.choice = 0
    half = (w - 60.0) * 0.5
    r1 = if narrow: Rect(x + 24, by + 50, w - 48, 38) else: Rect(x + 24, by + 50, half, 38)
    r2 = if narrow: Rect(x + 24, by + 98, w - 48, 38) else: Rect(x + 36 + half, by + 50, half, 38)
    if _lv_plain(r1, "Ask for another number"): res.choice = 1
    if _lv_plain(r2, "Never mind"): res.choice = 2
    if can_send and (key_pressed(.enter) or key_pressed(.n1)): res.choice = 0
    if key_pressed(.n2): res.choice = 1
    if key_pressed(.n3): res.choice = 2
    set_font()
    pop_transform()
    res

# ---------------- seated: buttons beside their things ----------------
# No panel while one sits: a small pill beside each thing that needs one (each dish or glass on
# the table, the menu card, the pilot himself for getting up and waiting), in the talk replies'
# style (a paper pill, a dark round badge with its key), a short leader line to the thing. A
# dish's pill is a bar too, filled as far as there is still of it; the one in hand is ringed.

struct SeatPill:
    at: vec2                        # (the thing, on the screen: the pill stands beside it)
    label: str
    badge: str                      # (its key: "1", "M", "Esc")
    fill = -1.0                     # (0..1: how much is left; below 0, no bar)
    quiet = false                   # (the pilot's own: a little fainter)
    ring = false                    # (in hand)
    side = 0                        # (-1 to the left of it, 1 to the right, 0 whichever fits)

struct SeatPillResult:
    pressed = -1                    # (the pill clicked or tapped this frame)
    down = -1                       # (the pill held down: a mouse button or a finger on it)
    rects: Rect[]                   # (where they are: a drag begun on one is its own)

_pill_cross = (a: Rect, b: Rect, gap: f64 = 4.0) -> bool: f64(a.x) < f64(b.x + b.w) + gap and f64(b.x) < f64(a.x + a.w) + gap and f64(a.y) < f64(b.y + b.h) + gap and f64(b.y) < f64(a.y + a.h) + gap

seat_pills = (fonts: Fonts, pills: SeatPill[], keep_off: Rect[] = []) -> SeatPillResult:
    res = SeatPillResult()
    sw = f64(screen_width()); sh = f64(screen_height())
    set_font(fonts.ui)
    u = readable_k(15.0)
    size = 15.0 * u; num = 12.0 * u
    h = tap_size(28.0 * u); badge = 20.0 * u
    reach = 26.0 * u
    gap = 8.0 * u
    placed: Rect[]
    loop o in keep_off: placed.push(o)
    # (and never over a thing one of them is for)
    loop pl in pills: placed.push(Rect(f64(pl.at.x) - 14.0 * u, f64(pl.at.y) - 14.0 * u, 28.0 * u, 28.0 * u))
    # (the middle of the things they stand beside: each goes out on its own side of it)
    mid_x = 0.0
    loop pl in pills: mid_x += f64(pl.at.x)
    if pills.len() > 0: mid_x = mid_x / f64(pills.len())
    m = mouse_pos()
    loop k in 0..pills.len():
        pl = pills[k]
        res.rects.push(Rect(0, 0, 0, 0))
        sp = pl.at
        if true:
            ax = f64(sp.x); ay = f64(sp.y)
            if ax < -40.0 or ax > sw + 40.0 or ay < -40.0 or ay > sh + 40.0: continue
            w = ptext_width(pl.label, size) + badge + 22.0 * u
            # (beside it, out on the side away from the others' middle (or the side asked), farther
            # out along a leader line until it is clear of every pill already placed: never over one)
            right_first = if pl.side != 0: pl.side > 0 else: ax >= mid_x
            best = Rect(clamp(ax + reach, 6.0, max(6.0, sw - w - 6.0)), clamp(ay - h * 0.5, 6.0, max(6.0, sh - h - 6.0)), w, h)
            found = false
            dirs = [vec2(1.0, 0.0), vec2(0.87, -0.5), vec2(0.87, 0.5), vec2(0.5, -0.87), vec2(0.5, 0.87)]
            loop ring in 0..5:
                if found: break
                rr = reach * [1.0, 1.7, 2.5, 3.4, 4.6][ring]
                loop sidek in 0..2:
                    if found: break
                    sgn = if (sidek == 0) == right_first: 1.0 else: -1.0
                    loop dv in dirs:
                        if found: break
                        px = ax + f64(dv.x) * sgn * rr; py = ay + f64(dv.y) * rr
                        x = if sgn > 0.0: px else: px - w
                        y = py - h * 0.5
                        r = Rect(x, y, w, h)
                        if x < 6.0 or x + w > sw - 6.0 or y < 6.0 or y + h > sh - 6.0: continue
                        clear = true
                        loop o in placed:
                            if _pill_cross(r, o, gap): clear = false
                        if clear:
                            best = r; found = true
            placed.push(best)
            res.rects[k] = best
            r = best
            # (the leader: from a small dot on the thing to the pill's near edge)
            ex = clamp(ax, f64(r.x) + h * 0.5, f64(r.x + r.w) - h * 0.5)
            ey = clamp(ay, f64(r.y), f64(r.y + r.h))
            if ax < f64(r.x): ex = f64(r.x)
            else if ax > f64(r.x + r.w): ex = f64(r.x + r.w)
            line(vec2(f32(ax), f32(ay)), vec2(f32(ex), f32(ey)), 1.4 * u, rgba(1.0, 0.96, 0.86, 0.8))
            circle(vec2(f32(ax), f32(ay)), f32(2.6 * u), rgba(1.0, 0.96, 0.86, 0.9))
            over = contains(r, m)
            round = h * 0.5
            rect_rounded(r.x + 2, r.y + 3, r.w, r.h, round, rgba(0, 0, 0, 0.16))
            rect_rounded(r.x, r.y, r.w, r.h, round, if over: rgba(1.0, 0.97, 0.86, 0.98) else: if pl.quiet: rgba(0.9, 0.86, 0.76, 0.86) else: rgba(0.96, 0.92, 0.8, 0.95))
            if pl.fill >= 0.0 and pl.fill > 0.0:
                fw = max(h, f64(r.w) * clamp(pl.fill, 0.0, 1.0))
                rect_rounded(r.x, r.y, f32(fw), r.h, round, if pl.ring: rgba(0.83, 0.64, 0.36, 0.95) else: rgba(0.86, 0.76, 0.56, 0.95))
            if over or pl.ring: rect_rounded_outline(r.x, r.y, r.w, r.h, round, if pl.ring: 2.2 else: 1.5, rgba(0.42, 0.29, 0.17, 0.9))
            bx = f64(r.x) + 5.0 * u + badge * 0.5; by = f64(r.y) + h * 0.5
            circle(vec2(f32(bx), f32(by)), f32(badge * 0.5), rgba(0.42, 0.29, 0.17, if pl.quiet: 0.6 else: 0.88))
            ptext_centered(pl.badge, vec2(f32(bx), f32(by)), if pl.badge.len() > 1: num * 0.8 else: num, rgba(1, 0.96, 0.86, 1))
            ptext(pl.label, vec2(f32(f64(r.x) + badge + 12.0 * u), f32(f64(r.y) + (h - size) * 0.5 - 1.0)), size, rgba(0.3, 0.19, 0.09, 1))
            if pad_hit(r, over and mouse_pressed(.left)): res.pressed = k
            if over and mouse_down(.left): res.down = k
    set_font()
    res
