# Deterministic, SI-unit seaplane simulation. No graphics, devices, clock, or random input.
# Sky Barons sim.jo fly_air/steer inspired the rate controls, low-speed authority floor,
# stall nose drop, bank coordination and pull drag. Forces replace its velocity steering:
# lift does no work, gravity trades height for speed, water dissipates energy.
from 'planes.jo' import Craft, PartId, PartSpec, craft_parts, craft_wing_contacts, contact_part
use 'damage.jo'
use 'tweaks.jo'

const FLIGHT_G = 9.81

struct CraftSpec:
    kind: Craft
    handling_scale = 1.0            # (turn as though at speed / this: craft_spec's speed scale)
    player = false                  # (the player's own: the pure-scale trial applies only to it)
    mass = 1400.0
    inertia = vec3(5200, 7500, 4200)   # body x=pitch, y=yaw, z=roll; kg m²
    wing_area = 30.0
    span = 11.0
    stall_speed = 24.0
    cruise_speed = 50.0
    max_speed = 62.0
    cl0 = 0.3
    lift_slope = 4.8                 # per radian
    cl_max = 1.4
    stall_angle = 0.24
    cd0 = 0.045
    induced_drag = 0.07
    max_thrust = 7000.0              # N, sea-level static
    thrust_speed = 50.0              # thrust = static / (1 + (airspeed / this)^2)
    pitch_rate = 0.75                # rad/s, full authority
    roll_rate = 1.3
    yaw_rate = 0.45
    response = 6.0                  # angular-rate response / second
    grip = 1.6                      # side-slip damping / second
    parts: PartSpec[]
    contacts: vec3[]
    wing_contacts = [vec3(-4.7, -0.31, -0.3), vec3(4.7, -0.31, -0.3), vec3(-5.5, 1.55, -0.55), vec3(5.5, 1.55, -0.55)]
    volumes: f64[]                   # displaced m³ at 1 m immersion, per contact
    float_height = 2.0               # calm-water equilibrium CG height
    fuel_capacity = 180.0           # kg; mass above includes nominal load (fuel not re-weighed)
    fuel_burn = 0.025                # kg/s at full throttle
    spool_time = 1.5
    # (the air, after Sky Barons' fly_air: thrust as an acceleration, drag on speed squared,
    # how quickly the way it goes turns to follow the nose)
    arc_thrust = 12.0
    arc_drag = 0.0031
    arc_grip = 2.3

# Positive pitch = nose up (+body x). Positive roll = right wing down (-body z).
# Positive yaw = nose right (-body y). Heading 0 is north/-z, +PI/2 east/+x.
# assist 0 disables horizon trim/level; 1 gives a mild keyboard assist. trim is radians.
# water_brake is hydrodynamic braking; airbrake adds slip drag (both 0..1).
# anchor requests mooring only when slow/wet; moor() takes a CG point, not a sea-level point.
struct Controls:
    pitch = 0.0
    roll = 0.0
    yaw = 0.0
    throttle = 0.0
    assist = 1.0
    trim = 0.0
    water_brake = 0.0
    airbrake = 0.0                 # landing drag: abstracts a deliberate forward slip, no extra lift
    anchor = false

struct CraftState:
    position = vec3(0, 3, 0)
    velocity = vec3(0, 0, 0)
    orientation = vec4(0, 0, 0, 1)
    angular_velocity = vec3(0, 0, 0) # body axes, rad/s
    throttle = 0.0
    fuel = 180.0
    damage: DamageState = DamageState()
    hull_damage = 0.0               # compatibility telemetry: mass-weighted structural damage
    engine_damage = 0.0
    on_water = false
    planing = false
    beached = false
    crashed = false
    capsized = false
    moored = false
    mooring_point = vec3(0, 0, 0)    # CG anchor, not waterline
    mooring_orientation = vec4(0, 0, 0, 1)
    time = 0.0                     # local simulation clock, wave phase = time + env.wave_time
    aoa = 0.0                      # telemetry, radians
    airspeed = 0.0
    stalled = false
    water_age = 1.0                 # time since last wet contact; a fresh airborne state can impact

struct FlightEnv:
    wind = vec3(0, 0, 0)            # air velocity in world frame, m/s
    current = vec3(0, 0, 0)         # water velocity; sea vertical_speed is added to its y
    wave_height = 0.0               # amplitude in m (0..1.5 supported)
    wave_length = 35.0
    wave_time = 0.0                 # shared world time offset; keep fixed during a step
    density = 1.225
    ground: (f64, f64) -> f64 = (x: f64, z: f64) -> f64: -1000.0
    # (a sea of the caller's own: height and slope (dh/dx, dh/dz) at a point; used when has_swell)
    swell: (f64, f64) -> vec3 = (x: f64, z: f64) -> vec3: vec3(0, 0, 0)
    has_swell = false

struct SeaSample:
    height: f64
    normal: vec3
    vertical_speed: f64

sea_surface = (env: FlightEnv, x: f64, z: f64, t: f64) -> SeaSample:
    if env.has_swell:
        s = env.swell(x, z)
        # (the floats feel the swell's height fully but its slope only gently: a hull spans it)
        return SeaSample(f64(s.x), normalize(vec3(-s.y * 0.35, 1, -s.z * 0.35)), 0.0)
    a = clamp(env.wave_height, 0.0, 1.5)
    if a == 0.0: return SeaSample(0.0, vec3(0, 1, 0), 0.0)
    k = 2.0 * PI / max(env.wave_length, 8.0)
    w = sqrt(FLIGHT_G * k)
    p = k * (x * 0.8 + z * 0.6) - w * (t + env.wave_time)
    q = k * (x * -0.6 + z * 0.8) * 1.7 - w * 1.3 * (t + env.wave_time)
    dx = a * k * (0.8 * cos(p) - 0.306 * cos(q))
    dz = a * k * (0.6 * cos(p) + 0.408 * cos(q))
    SeaSample(a * (sin(p) + 0.3 * sin(q)), normalize(vec3(-dx, 1, -dz)), -a * w * (cos(p) + 0.39 * cos(q)))

# the "true speed": the speed as it would be in the world as designed (the speedometer's, the
# sounds', the airframe's flexing and the cloth's, the harm of a crash, the handling). The same as
# the speed drawn up to a little past the stall (taxiing, taking off and landing are as designed);
# above that the extra the speed scale gives is taken off, so the drawn top speed reads as the
# designed top speed. (The speed drawn, the "visual speed", is the state's velocity.)
true_speed = (k: CraftSpec, v: f64) -> f64:
    # (as it was: simply the drawn speed / the scale; the curve is a trial, Tweaks)
    if not tweaks.true_curve: return v / max(k.handling_scale, 1.0)
    if k.handling_scale <= 1.0001: return v
    knee = k.stall_speed * 1.3
    if v <= knee: return v
    top = k.max_speed / k.handling_scale
    knee + (v - knee) * (top - knee) / max(k.max_speed - knee, 1.0)

# (the pure speed scale, a trial (Tweaks): the drawn speed / this is the true speed the aircraft's
# lift, stall, handling and the water's forces go by, while its acceleration stays as drawn)
pure_k = (k: CraftSpec) -> f64: if tweaks.pure_scale and k.player: max(k.handling_scale, 1.0) else: 1.0

# how many times faster than designed every aircraft flies, drawn (the pause menu's Speed scale)
speed_scale = 1.0
set_speed_scale = (k: f64):
    global speed_scale
    speed_scale = k

craft_spec = (kind: Craft, contacts: vec3[]) -> CraftSpec:
    s = CraftSpec(kind = kind, contacts = contacts)
    match kind:
        .gull:
            s.stall_speed = 28; s.cruise_speed = 66; s.max_speed = 85
            s.pitch_rate = 1.5; s.roll_rate = 3.2; s.yaw_rate = 0.55
            s.arc_thrust = 15.5; s.arc_drag = 0.00215; s.arc_grip = 2.9
        .heron:
            s.mass = 3200; s.inertia = vec3(20000, 31000, 25000)
            s.wing_area = 52; s.span = 16.5; s.stall_speed = 30; s.cruise_speed = 62; s.max_speed = 76
            s.cd0 = 0.057; s.pitch_rate = 0.5; s.roll_rate = 0.65; s.yaw_rate = 0.3; s.response = 4
            s.wing_contacts = [vec3(-8.25, 2.3, -1.4), vec3(8.25, 2.3, -1.4)]
            s.fuel_capacity = 400; s.fuel_burn = 0.052
            s.pitch_rate = 0.8; s.roll_rate = 1.35; s.yaw_rate = 0.35
            s.arc_thrust = 11.0; s.arc_drag = 0.0019; s.arc_grip = 2.0
        .corsair:
            s.mass = 1700; s.inertia = vec3(5600, 8000, 4500)
            s.wing_area = 29; s.span = 9.6; s.stall_speed = 31; s.cruise_speed = 74; s.max_speed = 96
            s.cd0 = 0.043; s.pitch_rate = 1.0; s.roll_rate = 1.9; s.yaw_rate = 0.6; s.response = 7
            s.wing_contacts = [vec3(-4.2, -0.39, -0.4), vec3(4.2, -0.39, -0.4), vec3(-4.8, 1.5, -0.6), vec3(4.8, 1.5, -0.6)]
            s.fuel_capacity = 230; s.fuel_burn = 0.038
            s.pitch_rate = 1.7; s.roll_rate = 3.8; s.yaw_rate = 0.65
            s.arc_thrust = 18.0; s.arc_drag = 0.00195; s.arc_grip = 3.2
        .falco:
            s.mass = 1200; s.inertia = vec3(3800, 6000, 3000)
            s.wing_area = 16; s.span = 9.2; s.stall_speed = 38; s.cruise_speed = 98; s.max_speed = 125
            s.cd0 = 0.028; s.induced_drag = 0.055; s.pitch_rate = 1.25; s.roll_rate = 2.25; s.yaw_rate = 0.55; s.response = 9
            s.wing_contacts = [vec3(-4.6, -0.07, -0.6), vec3(4.6, -0.07, -0.6)]
            s.fuel_capacity = 160; s.fuel_burn = 0.034
            s.pitch_rate = 1.8; s.roll_rate = 4.2; s.yaw_rate = 0.6
            s.arc_thrust = 22.0; s.arc_drag = 0.0014; s.arc_grip = 3.4
    s.cl0 = s.mass * FLIGHT_G / (0.5 * 1.225 * s.wing_area * s.cruise_speed * s.cruise_speed)
    s.cl_max = s.mass * FLIGHT_G / (0.5 * 1.225 * s.wing_area * s.stall_speed * s.stall_speed)
    s.stall_angle = (s.cl_max - s.cl0) / s.lift_slope
    s.thrust_speed = s.max_speed * 0.85
    qmax = 0.5 * 1.225 * s.max_speed * s.max_speed * s.wing_area
    cl = s.mass * FLIGHT_G / qmax
    s.max_thrust = qmax * (s.cd0 + s.induced_drag * cl * cl) * (1.0 + (s.max_speed / s.thrust_speed)^2)
    # Calibrate load shares to the supplied geometry, with zero static fore/aft moment.
    # High auxiliary floats engage only when rolled. Empty contacts get a small safe hull.
    if s.contacts.len() == 0:
        s.contacts = [vec3(-1, -1, -2), vec3(1, -1, -2), vec3(-1, -1, 2), vec3(1, -1, 2)]
    bottom = 0.0
    loop p in s.contacts: bottom = min(bottom, f64(p.y))
    s.float_height = -bottom - (if kind == .heron: 0.55 else: 0.35)
    nf = 0; na = 0; zf = 0.0; za = 0.0
    loop p in s.contacts:
        if -s.float_height - f64(p.y) > 0.04:
            if p.z < 0: nf += 1; zf += f64(p.z)
            else: na += 1; za += f64(p.z)
    zf /= max(nf, 1); za /= max(na, 1)
    front_share = if nf > 0 and na > 0: za / max(za - zf, 0.1) else: 0.5
    loop p in s.contacts:
        depth = -s.float_height - f64(p.y)
        share = if p.z < 0: front_share / max(nf, 1) else: (1.0 - front_share) / max(na, 1)
        s.volumes.push(if depth > 0.04: s.mass / 1000.0 * share / depth else: s.mass / 1000.0 * 0.08)
    s.wing_contacts = craft_wing_contacts(kind)
    s.parts = craft_parts(kind, s.contacts)
    # (the speed scale: true cruise and top speeds this many times the designed ones (less drag,
    # so the same thrust keeps going), the takeoff, landing and water left as designed, and the
    # handling kept at the designed turn rates: _fly_air and _substep turn as though at speed / k)
    s.cruise_speed *= speed_scale
    s.max_speed *= speed_scale
    s.arc_drag /= speed_scale * speed_scale
    s.handling_scale = speed_scale
    s

forward = (s: CraftState) -> vec3: quat_rotate(s.orientation, vec3(0, 0, -1))
heading = (s: CraftState) -> f64:
    f = forward(s)
    atan2(f64(f.x), -f64(f.z))
heading_vector = (h: f64) -> vec3: vec3(sin(h), 0, -cos(h))
angle_delta = (a: f64, b: f64) -> f64: atan2(sin(a - b), cos(a - b))
water_start = (spec: CraftSpec, at: vec3, h: f64 = 0.0) -> CraftState:
    CraftState(position = vec3(at.x, at.y + f32(spec.float_height), at.z), orientation = quat_euler(0, -h, 0), fuel = spec.fuel_capacity, on_water = true, water_age = 0.0)

trim_aoa = (spec: CraftSpec, speed: f64, density: f64 = 1.225) -> f64:
    cl = spec.mass * FLIGHT_G / max(0.5 * density * spec.wing_area * speed * speed, 1.0)
    clamp((cl - spec.cl0) / spec.lift_slope, -0.08, spec.stall_angle * 0.92)
lift_coefficient = (spec: CraftSpec, aoa: f64) -> f64:
    cl = spec.cl0 + spec.lift_slope * aoa
    peak = if cl >= 0: spec.cl_max else: spec.cl_max * 0.8
    if abs(cl) <= peak: return cl
    # Continuous break: separated flow retains some lift, and substantial drag.
    sign(cl) * peak * max(0.18, 1.0 - (abs(cl) - peak) / (peak * 1.4))
cruise_throttle = (spec: CraftSpec, speed: f64, density: f64 = 1.225) -> f64:
    q = max(0.5 * density * speed * speed * spec.wing_area, 1.0)
    cl = spec.mass * FLIGHT_G / q
    clamp(q * (spec.cd0 + spec.induced_drag * cl * cl) * (1.0 + (speed / spec.thrust_speed)^2) / spec.max_thrust, 0.0, 1.0)

moor = (state: mut CraftState, point: vec3, h: f64):
    state.moored = true; state.mooring_point = point; state.mooring_orientation = quat_euler(0, -h, 0)
    state.position = point; state.orientation = state.mooring_orientation
    state.velocity = vec3(0, 0, 0); state.angular_velocity = vec3(0, 0, 0); state.throttle = 0
unmoor = (state: mut CraftState): state.moored = false

# Public step accepts 0 < dt <= 0.25 s and consumes all of it; larger pauses are clamped.
# Identical 120 Hz substeps at 30/60 Hz. Do not advance env.wave_time as well as state.time.
step = (spec: CraftSpec, state: mut CraftState, ctl: Controls, env: FlightEnv, dt: f64):
    state.damage.events.clear()
    if dt <= 0: return
    n = max(1, int(ceil(min(dt, 0.25) * 120.0)))
    h = min(dt, 0.25) / f64(n)
    loop i in 0..n:
        first_piece = state.damage.debris.len()
        _substep(spec, state, ctl, env, h)
        # Separation occurs at the end of the resolving substep: a new piece inherits the
        # velocity/spin AFTER its impulse, so it tumbles with the strike, not the pre-hit pose.
        loop j in first_piece..state.damage.debris.len():
            id = int(state.damage.debris[j].part)
            arm = quat_rotate(state.orientation, spec.parts[id].attachment)
            spin = quat_rotate(state.orientation, state.angular_velocity)
            state.damage.debris[j].position = state.position + arm
            state.damage.debris[j].orientation = state.orientation
            state.damage.debris[j].velocity = state.velocity + cross(spin, arm)
            state.damage.debris[j].angular_velocity = spin
        _damage_summary(spec, state)
        loop j in 0..state.damage.debris.len():
            b = state.damage.debris[j]
            sea = sea_surface(env, f64(b.position.x), f64(b.position.z), state.time)
            debris_step(state.damage, j, sea.height, sea.normal, env.current + vec3(0, sea.vertical_speed, 0), env.ground(f64(b.position.x), f64(b.position.z)), h)
        j = state.damage.debris.len() - 1
        loop j >= 0:
            if state.damage.debris[j].age >= state.damage.debris[j].lifetime: state.damage.debris.remove_at(j)
            j -= 1

# Scalar fields remain available to the HUD/pilot/autopilot, but never decide impact damage.
_damage_summary = (k: CraftSpec, s: mut CraftState):
    total = 0.0
    loop i in 0..k.parts.len(): total += k.parts[i].mass_share * (1.0 - s.damage.parts[i].health)
    s.hull_damage = clamp(total, 0.0, 1.0)
    s.engine_damage = 1.0 - part_health(s.damage, .engine)
    # (a worn engine runs clean; smoke only once it is really hurt, thicker the worse)
    s.damage.smoke = if s.damage.parts[1].attached: max(0.0, (s.engine_damage - 0.35) / 0.65) * (0.25 + 0.75 * s.throttle) else: 0.0
    if s.damage.parts[0].health < 0.15 or not s.damage.parts[2].attached or not s.damage.parts[3].attached: s.crashed = true

_contact_mass = (k: CraftSpec, s: CraftState, arm: vec3, direction: vec3) -> f64:
    n = if length(direction) > 0.001: normalize(direction) else: vec3(0, 1, 0)
    lever = quat_rotate(quat_inverse(s.orientation), cross(arm, n))
    ratio = mass_fraction(k.parts, s.damage)
    1.0 / (1.0 / (k.mass * ratio) + f64(lever.x * lever.x) / (k.inertia.x * ratio) + f64(lever.y * lever.y) / (k.inertia.y * ratio) + f64(lever.z * lever.z) / (k.inertia.z * ratio))

_contact_load = (k: CraftSpec, s: mut CraftState, id: int, point: vec3, normal: vec3, relative: vec3, impulse: vec3, elastic: f64, kind: ImpactKind):
    # (the harm judged at the true speed: an aircraft the speed scale makes faster hits no harder
    # for it; the bounce itself stays as it is)
    v = f64(length(s.velocity))
    # (pure scale: the velocities here are already the true ones)
    r = f32(if tweaks.pure_scale: 1.0 else: (if v > 0.1: true_speed(k, v) / v else: 1.0))
    contact_damage(s.damage, k.parts, k.parts[id].id, point, normal, relative * r, impulse * r, elastic, kind, k.mass, s.position, s.orientation, s.velocity, s.angular_velocity)

_terrain_contact = (k: CraftSpec, s: mut CraftState, e: FlightEnv, id: int, arm: vec3, point: vec3, height: f64, force: mut vec3, torque: mut vec3, dt: f64):
    x = f64(point.x); z = f64(point.z)
    n = normalize(vec3(e.ground(x - 0.25, z) - e.ground(x + 0.25, z), 0.5, e.ground(x, z - 0.25) - e.ground(x, z + 0.25)))
    relative = s.velocity + cross(quat_rotate(s.orientation, s.angular_velocity), arm)
    vn = f64(dot(relative, n))
    effective = _contact_mass(k, s, arm, n)
    # A finite spring stroke plus velocity damping, never an instantaneous whole-craft stop.
    load = effective * max(0.0, min(height - f64(point.y), 0.5) * 900.0 - vn * 35.0)
    normal_j = n * f32(load * dt)
    tangent = relative - n * f32(vn)
    friction = vec3(0, 0, 0)
    if length(tangent) > 0.001:
        friction = -normalize(tangent) * f32(min(load * dt * 0.65, f64(length(tangent)) * _contact_mass(k, s, arm, tangent) * 0.4))
    b = (normal_j + friction) / f32(dt)
    force += b
    torque += quat_rotate(quat_inverse(s.orientation), cross(arm, b))
    _contact_load(k, s, id, point, n, relative, normal_j, 3.0, .crunch)
    _contact_load(k, s, id, point, n, relative, friction, 3.0, .scrape)

# whether every float, hull point and wing tip is at least `margin` clear of the sea and the land
_clear_of_water = (k: CraftSpec, s: CraftState, e: FlightEnv, margin: f64) -> bool:
    if s.on_water and s.water_age < 0.12: return false
    loop i in 0..k.parts.len():
        if not s.damage.parts[i].attached: continue
        loop group in [k.parts[i].contacts, k.parts[i].wing_contacts, k.parts[i].strikes]:
            loop pt in group:
                p = s.position + quat_rotate(s.orientation, pt)
                sea = sea_surface(e, f64(p.x), f64(p.z), s.time)
                if f64(p.y) < max(sea.height, e.ground(f64(p.x), f64(p.z))) + margin: return false
    true

# Flight in the air, Sky Barons' fly_air as it is (sim.jo): the stick turns the aircraft at its
# rates (less when slow); slow, the nose falls toward the way it goes and down; banked, the nose
# falls and it turns toward the lower wing; the engine pushes, drag (more when pulling hard)
# holds back, climbing costs speed and diving gains it; the way it goes turns to follow the nose
# (hardly at all when stalled); what the wings do not hold up falls. Wind carries it along.
# (debugging: 0 turns the air's drag off, for every aircraft)
flight_drag_scale = 1.0
set_drag_scale = (x: f64):
    global flight_drag_scale
    flight_drag_scale = x

_fly_air = (k: CraftSpec, s: mut CraftState, c: Controls, e: FlightEnv, dt: f64):
    s.on_water = false
    s.beached = false
    s.planing = false
    s.water_age += dt
    mass = mass_fraction(k.parts, s.damage)
    left = wing_lift(s.damage, .left_wing); right = wing_lift(s.damage, .right_wing)
    wings = (left + right) * 0.5
    tail = part_health(s.damage, .tail)
    engine = if s.fuel > 0 and not s.capsized: part_health(s.damage, .engine) else: 0.0
    # (a damaged engine gives less power, more so the worse it is; dead at none)
    power = if engine <= 0.0: 0.0 else: 0.3 + 0.7 * engine
    s.throttle = move_toward(s.throttle, clamp(c.throttle, 0.0, 1.0) * power, dt / k.spool_time)
    s.throttle = min(s.throttle, power)
    s.fuel = max(0.0, s.fuel - k.fuel_burn * s.throttle * dt)
    wind = e.wind
    air = s.velocity - wind
    speed = f64(length(air))
    s.airspeed = speed
    # (lift, the stall, control and rough air go by the true speed; the same as the drawn one but
    # under the pure scale)
    ts = speed / pure_k(k)
    auth = clamp(ts / (k.stall_speed * 1.45), 0.25, 1.0) * (0.25 + 0.75 * wings)
    # (the propeller's wash over the tail keeps the rudder and elevator working when slow, with
    # the throttle open: a hammerhead's pivot at the top)
    wash = max(auth, 0.7 * s.throttle) * (0.15 + 0.85 * tail)
    q = s.orientation
    # Asymmetric lift and torn skin act even with the stick centered. Keep impact momentum
    # through the arcade/contact boundary; only an intact airframe follows the original rates.
    if s.hull_damage > 0.000001:
        imbalance = right - left
        a = clamp(speed / k.stall_speed, 0.0, 3.0)
        loss_torque = vec3((1.0 - tail) * sin(s.time * 5.0) * a, imbalance * 0.45 * a, imbalance * 4.0 * a)
        s.angular_velocity = (s.angular_velocity + loss_torque * f32(dt)) / f32(1.0 + 3.0 * dt)
        spin = f64(length(s.angular_velocity))
        if spin > 0.00001: q = quat_mul(q, quat_axis_angle(s.angular_velocity, spin * dt))
    else: s.angular_velocity = vec3(0, 0, 0)
    # rough air: gusts and the eddies off the sea and the cliffs knock it about, more fast and low
    hgt = f64(s.position.y) - max(e.ground(f64(s.position.x), f64(s.position.z)), 0.0)
    rough = (0.12 + f64(length(e.wind)) / 14.0) * (0.35 + 0.65 * (1.0 - f64(smoothstep(10.0, 150.0, hgt)))) * f64(smoothstep(10.0, 70.0, ts))
    tt = s.time
    bump_p = (noise(tt * 2.1, 3.0) - 0.5) * 0.7 + (noise(tt * 7.3, 11.0) - 0.5) * 0.3
    bump_r = (noise(tt * 1.7, 23.0) - 0.5) * 0.7 + (noise(tt * 6.1, 31.0) - 0.5) * 0.3
    q = quat_mul(q, quat_axis_angle(vec3(1, 0, 0), bump_p * rough * 0.35 * dt))
    q = quat_mul(q, quat_axis_angle(vec3(0, 0, 1), bump_r * rough * 0.8 * dt))
    # (the wings can only pull so many g: fast, the nose comes round slower, and pulling out of a
    # steep dive takes room)
    g_lim = 6.0 * FLIGHT_G / max(true_speed(k, speed), 1.0)
    q = quat_mul(q, quat_axis_angle(vec3(1, 0, 0), clamp(c.pitch, -1.0, 1.0) * min(k.pitch_rate * wash, g_lim) * dt))
    q = quat_mul(q, quat_axis_angle(vec3(0, 0, 1), -clamp(c.roll, -1.0, 1.0) * k.roll_rate * auth * dt))
    q = quat_mul(q, quat_axis_angle(vec3(0, 1, 0), -clamp(c.yaw, -1.0, 1.0) * k.yaw_rate * 1.6 * wash * dt))
    fwd = quat_rotate(q, vec3(0, 0, -1))
    vdir = fwd
    if speed > 0.1: vdir = air * f32(1.0 / speed)
    # (near the water the wings hold it up at lower speeds: ground effect, within about a span)
    below = sea_surface(e, f64(s.position.x), f64(s.position.z), s.time).height
    gap = f64(s.position.y) - k.float_height - max(below, e.ground(f64(s.position.x), f64(s.position.z)))
    ge = 1.0 - f64(smoothstep(0.0, k.span * 0.8, gap))
    stall = k.stall_speed * sqrt(mass / max(wings, 0.12)) * (1.0 - 0.3 * ge)
    lift = f64(smoothstep(stall * 0.75, stall * 1.15, ts)) * wings
    s.stalled = lift < 0.999
    if lift < 1.0:
        axis = cross(fwd, normalize(vdir + vec3(0, -0.7, 0)))
        if length(axis) > 0.001: q = quat_mul(quat_axis_angle(axis, (1.0 - lift) * 1.6 * dt), q)
    tilt = 1.0 - max(f64(quat_rotate(q, vec3(0, 1, 0)).y), 0.0)
    axis = cross(quat_rotate(q, vec3(0, 0, -1)), vec3(0, -1, 0))
    if length(axis) > 0.001: q = quat_mul(quat_axis_angle(normalize(axis), tilt * lift * 0.5 * k.yaw_rate * dt), q)
    up_now = quat_rotate(q, vec3(0, 1, 0))
    f_now = quat_rotate(q, vec3(0, 0, -1))
    flat = vec3(f_now.x, 0, f_now.z)
    if length(flat) > 0.05:
        flat = normalize(flat)
        lean = f64(dot(up_now, vec3(-flat.z, 0, flat.x)))
        q = quat_mul(quat_axis_angle(vec3(0, 1, 0), -lean * lift * 0.5 * k.yaw_rate * dt), q)
    # (trimmed for cruise: faster than that the wings lift the nose a little, slower they let it
    # sink; with the wings near level, a dive eases out by itself, as a real aircraft's does)
    up_t = quat_rotate(q, vec3(0, 1, 0))
    rt = quat_rotate(q, vec3(1, 0, 0))
    # (how much the lift is in the vertical plane, wings not on their side, not upside down)
    upright = (1.0 - abs(f64(rt.y))) * (if up_t.y < -0.3 and abs(f64(quat_rotate(q, vec3(0, 0, -1)).y)) < 0.7: 0.0 else: 1.0)
    v_ref = max(sqrt(k.arc_thrust * max(s.throttle, 0.0) / k.arc_drag), k.stall_speed * 1.35 * pure_k(k))
    path = f64(vdir.y)
    trim = clamp((speed / v_ref - 1.0) * 0.25 - path * 0.6, -0.25, 0.45) * lift * upright
    q = quat_mul(q, quat_axis_angle(vec3(1, 0, 0), trim * tail * dt))
    s.orientation = normalize(q)
    fwd = quat_rotate(s.orientation, vec3(0, 0, -1))
    up = quat_rotate(s.orientation, vec3(0, 1, 0))
    s.aoa = asin(clamp(f64(dot(cross(vdir, fwd), quat_rotate(s.orientation, vec3(1, 0, 0)))), -1.0, 1.0))
    thin = clamp((2400.0 - f64(s.position.y)) / 800.0, 0.0, 1.0)
    pull = abs(clamp(c.pitch, -1.0, 1.0)) * auth
    drag = k.arc_drag * (1.0 + 2.5 * clamp(c.airbrake, 0.0, 1.0)) * (1.0 + 0.5 * s.hull_damage + 1.6 * abs(left - right)) / mass
    # (gravity along the way it goes trades speed for height and back; pulling hard costs a little
    # more drag; with no drag, a loop or a zoom climb gives back all it took)
    acc = k.arc_thrust * s.throttle * thin / mass - drag * flight_drag_scale * speed * speed * (1.0 + 0.35 * pull) - FLIGHT_G * f64(vdir.y)
    speed = max(speed + acc * dt, 0.0)
    # (the way it goes follows the nose; at a drawn speed many times the true one, it follows
    # quicker, so the turn isn't a long slide)
    ratio = if tweaks.quick_grip and speed > 1.0: speed / max(true_speed(k, speed), 1.0) else: 1.0
    t = min(k.arc_grip * sqrt(ratio) * lift * dt, 1.0)
    vdir = normalize(vdir + (fwd - vdir) * f32(t))
    air = vdir * f32(speed)
    level = max(f64(up.y), 0.0)
    sag = FLIGHT_G * (1.0 - lift) + FLIGHT_G * lift * (1.0 - level)
    # (what the wings do not hold up bends the way down; only across it: gravity along it has
    # already been counted in the speed)
    sv = vec3(0, f32(-sag), 0)
    sv = sv - vdir * dot(sv, vdir)
    air += sv * f32(dt)
    air.y += f32((noise(tt * 3.3, 41.0) - 0.5) * rough * 6.0 * dt)
    s.velocity = air + wind
    s.position += s.velocity * f32(dt)

# Sky Barons' steer (sim.jo): stick and rudder that turn the aircraft toward a direction: far off,
# rolled toward it and pulled; nearly there (or a little below), small corrections with the wings
# level; between, some of each. Each correction closes on the aim in about a sixth of a second.
steer = (k: CraftSpec, s: CraftState, want: vec3) -> Controls:
    l = quat_rotate(quat_inverse(s.orientation), normalize(want))     # (-z ahead, +x right, +y up)
    ahead = f64(-l.z)
    a = max(ahead, 0.1)
    right = quat_rotate(s.orientation, vec3(1, 0, 0))
    up = quat_rotate(s.orientation, vec3(0, 1, 0))
    rate = 6.0
    pr = max(k.pitch_rate, 0.1)
    yr = max(k.yaw_rate, 0.1)
    rr = max(k.roll_rate, 0.1)
    near_pitch = clamp(f64(l.y) / a * rate / pr, -1.0, 1.0)
    near_yaw = clamp(f64(l.x) / a * rate / yr * 0.4, -1.0, 1.0)
    near_roll = clamp((f64(right.y) * 1.6 + f64(l.x) / a * 4.0) * 2.6 / rr, -1.0, 1.0)
    err = atan2(f64(l.x), f64(l.y))
    off = acos(clamp(ahead, -1.0, 1.0))
    far_roll = clamp(err * 2.0 * min(1.0, 3.6 / rr), -1.0, 1.0)
    far_pitch = (if abs(err) < 1.2: clamp(off * 3.0, 0.0, 1.0) else: 0.2) * min(1.0, 2.4 / pr)
    blend = f64(smoothstep(0.94, 0.995, ahead))
    if l.y < 0.0 and abs(f64(l.x)) < 0.5 * abs(f64(l.y)) + 0.05: blend = max(blend, f64(smoothstep(0.7, 0.85, ahead)))
    c = Controls(assist = 0.0)
    c.pitch = far_pitch + (near_pitch - far_pitch) * blend
    c.roll = far_roll + (near_roll - far_roll) * blend
    c.yaw = near_yaw * blend
    if abs(f64(right.y)) > 0.05:
        tilt = 1.0 - max(f64(up.y), 0.0)
        hold = min(0.5 * tilt / abs(f64(right.y)), 1.0) * (if right.y < 0.0: -1.0 else: 1.0)
        c.yaw = clamp(c.yaw + hold, -1.0, 1.0)
    c

_substep = (k: CraftSpec, s: mut CraftState, c: Controls, e: FlightEnv, dt: f64):
    s.time += dt
    if c.anchor and s.on_water and length(s.velocity) < 0.8 and not s.crashed: moor(s, s.position, heading(s))
    if s.moored:
        s.position = s.mooring_point; s.orientation = s.mooring_orientation
        s.velocity = vec3(0, 0, 0); s.angular_velocity = vec3(0, 0, 0); s.throttle = 0
        return
    if _clear_of_water(k, s, e, max(0.6, f64(length(s.velocity)) * dt + f64(length(s.angular_velocity)) * k.span * dt)):
        _fly_air(k, s, c, e, dt)
        return
    # (pure scale: the forces are worked out from the true velocity (the drawn one / the scale, along
    # the water; its rise and fall as they are), and their acceleration given to the drawn one, so
    # it takes as long as ever to gain speed, and must be going the scale's times faster to lift)
    # (at taxiing speeds, about the docks, as ever: the scale comes in from a brisk taxi to the run)
    pk0 = pure_k(k)
    v_vis = vec3(s.velocity.x, s.velocity.y, s.velocity.z)
    pk = 1.0 + (pk0 - 1.0) * f64(smoothstep(6.0, 25.0, f64(length(vec3(v_vis.x, 0, v_vis.z)))))
    if pk > 1.0001: s.velocity = vec3(v_vis.x / f32(pk), v_vis.y, v_vis.z / f32(pk))
    v_true0 = vec3(s.velocity.x, s.velocity.y, s.velocity.z)
    halted = false
    mass_ratio = mass_fraction(k.parts, s.damage)
    mass = k.mass * mass_ratio
    left = wing_lift(s.damage, .left_wing); right = wing_lift(s.damage, .right_wing)
    wings = (left + right) * 0.5
    tail = part_health(s.damage, .tail)
    f = forward(s); u = quat_rotate(s.orientation, vec3(0, 1, 0)); r = quat_rotate(s.orientation, vec3(1, 0, 0))
    air = s.velocity - e.wind
    speed = f64(length(air)); vf = f64(dot(air, f)); vu = f64(dot(air, u)); vr = f64(dot(air, r))
    s.airspeed = speed
    s.aoa = atan2(-vu, max(vf, 0.1))
    s.stalled = speed < k.stall_speed or abs(s.aoa) > k.stall_angle or vf < 0
    engine = if s.fuel > 0 and not s.capsized: part_health(s.damage, .engine) else: 0.0
    power = if engine <= 0.0: 0.0 else: 0.3 + 0.7 * engine
    target_throttle = clamp(c.throttle, 0.0, 1.0) * power
    s.throttle = min(power, move_toward(s.throttle, target_throttle, dt / k.spool_time))
    s.fuel = max(0.0, s.fuel - k.fuel_burn * s.throttle * dt)
    rho = max(e.density, 0.05)
    q = 0.5 * rho * speed * speed
    cl = lift_coefficient(k, s.aoa) * wings
    if vf < 0: cl = 0
    separation = smoothstep(k.stall_angle, k.stall_angle + 0.3, abs(s.aoa))
    cd = k.cd0 * (1.0 + 4.0 * clamp(c.airbrake, 0.0, 1.0) + 3.0 * abs(left - right)) + k.induced_drag * cl * cl + 0.7 * f64(separation) + k.cd0 * 0.9 * abs(clamp(c.pitch, -1.0, 1.0))
    adir = if speed > 0.01: air / f32(speed) else: f
    lift_dir = cross(r, adir)
    if length(lift_dir) > 0.001: lift_dir = normalize(lift_dir)
    else: lift_dir = u
    force = lift_dir * f32(q * k.wing_area * cl) - adir * f32(q * k.wing_area * cd) + vec3(0, -mass * FLIGHT_G, 0)
    thin = clamp(1.0 - max(f64(s.position.y), 0.0) / 10000.0, 0.25, 1.0)
    force += f * f32(k.max_thrust * s.throttle * thin / (1.0 + (speed / k.thrust_speed)^2))
    grip = f64(smoothstep(k.stall_speed * 0.65, k.stall_speed * 1.25, speed)) * (1.0 - 0.75 * f64(separation))
    force -= r * f32(vr * k.mass * k.grip * grip)
    auth = clamp(speed / (k.stall_speed * 1.45), 0.2, 1.0)
    bank = atan2(-f64(r.y), f64(u.y))
    pitch = asin(clamp(f64(f.y), -1.0, 1.0))
    pr = clamp(c.pitch, -1.0, 1.0) * k.pitch_rate * auth
    rr = -clamp(c.roll, -1.0, 1.0) * k.roll_rate * auth
    yr = -clamp(c.yaw, -1.0, 1.0) * k.yaw_rate * auth
    if not s.on_water:
        # Coordinated bank turn matches the sideways component of wing lift.
        yr -= FLIGHT_G / max(if pk > 1.0001: speed else: true_speed(k, speed), k.stall_speed) * clamp(tan(bank), -2.0, 2.0) * grip
        yr -= clamp(vr / max(speed, 1.0), -0.6, 0.6) * 0.65
        assist = clamp(c.assist, 0.0, 1.0)
        if abs(c.pitch) < 0.02:
            pr += clamp((trim_aoa(k, speed, rho) + c.trim - pitch) * 0.9 - f64(s.velocity.y) * 0.018, -0.22, 0.22) * assist
        if abs(c.roll) < 0.02: rr += clamp(bank * 0.8, -0.45, 0.45) * assist
        # Recoverable nose drop, not an artificial speed boost; unloading restores the wing.
        stall = max(1.0 - f64(smoothstep(k.stall_speed * 0.65, k.stall_speed * 1.1, speed)), f64(separation))
        pr -= stall * clamp(s.aoa + 0.15, 0.0, 0.7) * 1.7
    pr *= 0.15 + 0.85 * tail; yr *= 0.15 + 0.85 * tail; rr *= 0.2 + 0.8 * wings
    torque = vec3((1.0 - tail) * sin(s.time * 5.0) * k.inertia.x, (right - left) * q * k.wing_area * 0.04, (right - left) * q * k.wing_area * k.span * 0.12)
    wet = 0.0; ground_hit = false
    water_velocity = s.velocity - e.current
    flat_f = vec3(f.x, 0, f.z)
    if length(flat_f) < 0.001: flat_f = vec3(0, 0, -1)
    else: flat_f = normalize(flat_f)
    flat_r = vec3(-flat_f.z, 0, flat_f.x)
    water_speed = f64(dot(water_velocity, flat_f))
    plane = f64(smoothstep(k.stall_speed * 0.35, k.stall_speed * 0.95, abs(water_speed)))
    omega_world = quat_rotate(s.orientation, s.angular_velocity)
    # Each buoyant point carries its own normal, lateral and digging load. Removing a float
    # removes its support and drag. Undamaged forward planing retains the calibrated old force.
    hump = 1.0 + 0.8 * exp(-((abs(water_speed) - 9.0) / 5.0)^2)
    drag = (0.10 * water_speed + 0.007 * water_speed * abs(water_speed)) * hump * (1.0 - 0.85 * plane)
    drag += clamp(c.water_brake, 0.0, 1.0) * water_speed * 0.65
    loop i in 0..k.contacts.len():
        id = contact_part(k.kind, k.contacts[i])
        if not s.damage.parts[id].attached: continue
        arm = quat_rotate(s.orientation, k.contacts[i])
        p = s.position + arm
        sea = sea_surface(e, f64(p.x), f64(p.z), s.time)
        land = e.ground(f64(p.x), f64(p.z))
        if land >= sea.height - 0.05 and f64(p.y) < land:
            _terrain_contact(k, s, e, id, arm, p, land, force, torque, dt)
            ground_hit = true
        depth = sea.height - f64(p.y)
        if depth > 0 and land < sea.height - 0.05:
            contact_v = s.velocity + cross(omega_world, arm) - e.current - vec3(0, sea.vertical_speed, 0)
            vn = f64(dot(contact_v, sea.normal))
            health = s.damage.parts[id].health
            stiffness = 1000.0 * FLIGHT_G * k.volumes[i] * (0.15 + 0.85 * health)
            damper = 1.3 * sqrt(stiffness * mass / f64(k.contacts.len()))
            buoyancy = clamp(stiffness * min(depth, 1.5) - damper * vn, 0.0, mass * FLIGHT_G * 3.0)
            b = sea.normal * f32(buoyancy)
            share = clamp(depth / 0.16, 0.0, 1.0) / f64(k.contacts.len())
            # The normal spring's work, not all support force, determines crushing damage.
            # (crushing comes from sinking into the water, not from running fast along it)
            _contact_load(k, s, id, p, sea.normal, vec3(0, min(contact_v.y, 0.0), 0), b * f32(dt), 6.5, .splash)
            local_side = f64(dot(contact_v, flat_r))
            shear = -flat_r * f32(k.mass * local_side * (3.0 + 0.10 * abs(water_speed)) * share)
            _contact_load(k, s, id, p, sea.normal, contact_v, shear * f32(dt), 8.0, .splash)
            # A bow/keel presented across the flow digs in. Level high-speed planing does not.
            across = max(0.0, abs(f64(dot(contact_v, u))) - 5.5)
            dig = -contact_v * f32(min(k.mass * across * 0.12 * share, mass / dt * share))
            _contact_load(k, s, id, p, sea.normal, contact_v, dig * f32(dt), 5.5, .splash)
            force += b + shear + dig - flat_f * f32(k.mass * drag * share)
            # Keep the original intact, low-slip taxi balance. Only the excess shear and
            # digging load transmit overturning moments, representing the keel catching.
            catch = clamp((abs(local_side) - 8.0) / 12.0, 0.0, 1.0)
            torque += quat_rotate(quat_inverse(s.orientation), cross(arm, b + shear * f32(catch) + dig))
            wet += share
    # Wing tips and exposed engine/body/tail also resolve actual contact impulses.
    loop id in 0..k.parts.len():
        if not s.damage.parts[id].attached: continue
        loop group in [k.parts[id].wing_contacts, k.parts[id].strikes]:
            loop point in group:
                if not s.damage.parts[id].attached: break
                arm = quat_rotate(s.orientation, point)
                p = s.position + arm
                sea = sea_surface(e, f64(p.x), f64(p.z), s.time)
                land = e.ground(f64(p.x), f64(p.z))
                if land >= sea.height - 0.05 and f64(p.y) < land:
                    _terrain_contact(k, s, e, id, arm, p, land, force, torque, dt)
                    ground_hit = true
                if f64(p.y) < sea.height and land < sea.height - 0.05:
                    relative = s.velocity + cross(omega_world, arm) - e.current - vec3(0, sea.vertical_speed, 0)
                    vn = f64(dot(relative, sea.normal))
                    depth = sea.height - f64(p.y)
                    normal_load = clamp(depth * mass * 12.0 - vn * mass * 0.5, 0.0, mass * 25.0)
                    # Broad panel / cowl in water: quadratic drag, capped at the contact's
                    # effective stopping impulse. Its lever arm supplies the cartwheel.
                    drag_load = min(180.0 * f64(length(relative)) * min(depth, 0.6), _contact_mass(k, s, arm, relative) / dt * 0.6)
                    b = sea.normal * f32(normal_load) - relative * f32(drag_load)
                    force += b
                    torque += quat_rotate(quat_inverse(s.orientation), cross(arm, b))
                    _contact_load(k, s, id, p, sea.normal, relative, b * f32(dt), 4.0, .splash)
                    wet += 0.03
    wet = min(wet, 1.0)
    if wet > 0:
        s.water_age = 0
        force += vec3(0, k.mass * FLIGHT_G * 0.45 * plane * wet, 0)
        # Air pushes the exposed hull; small leeway, strong keel resistance, weathercock yaw.
        force += (e.wind - s.velocity) * f32(k.mass * 0.012 * wet)
        yr = -clamp(c.yaw, -1.0, 1.0) * 0.5 * clamp(abs(water_speed) / 3.0 + s.throttle * 0.4, 0.0, 1.0)
        wind_side = f64(dot(e.wind - e.current, flat_r))
        yr += wind_side * 0.008 * wet
        # Water attitude damping stops porpoising; rate controls cannot roll a resting hull.
        pr *= plane * 0.6; rr *= 0.12
        pr -= pitch * 1.7 * wet
        support = min(part_health(s.damage, .left_float), part_health(s.damage, .right_float))
        rr += bank * 2.0 * wet * support
    else: s.water_age += dt
    s.on_water = wet > 0 or (s.on_water and s.water_age < 0.12)
    s.planing = wet > 0 and plane > 0.5
    if wet > 0 and u.y < 0.0:
        s.capsized = true; s.crashed = true
    if s.capsized:
        pr = 0; rr = 0; yr = 0
    # Low-energy beaching settles; a moving wreck keeps its momentum and can tumble/slide.
    s.beached = ground_hit
    if ground_hit and length(s.velocity) < 2.5 and length(s.angular_velocity) < 0.5:
        s.velocity = vec3(0, 0, 0); s.angular_velocity = vec3(0, 0, 0); s.throttle = 0
        halted = true
        return
    # Bounded contact torques and implicit rate damping: stable even at asymmetric contact.
    integrity = min(wings, min(tail, min(part_health(s.damage, .left_float), part_health(s.damage, .right_float))))
    response = (k.response + wet * 5.0) * (0.12 + 0.88 * integrity)
    desired = vec3(pr, yr, rr)
    angular_accel = vec3(torque.x / (k.inertia.x * mass_ratio), torque.y / (k.inertia.y * mass_ratio), torque.z / (k.inertia.z * mass_ratio))
    angular_accel = clamp(angular_accel, -60.0, 60.0)
    s.angular_velocity = (s.angular_velocity + (desired * f32(response) + angular_accel) * f32(dt)) / f32(1.0 + response * dt)
    rotation = length(s.angular_velocity)
    if rotation > 0.00001:
        s.orientation = normalize(quat_mul(s.orientation, quat_axis_angle(s.angular_velocity, f64(rotation) * dt)))
    s.velocity += force * f32(dt / mass)
    if pk > 1.0001 and not halted: s.velocity = v_vis + (s.velocity - v_true0)
    s.position += s.velocity * f32(dt)

# Plan is the autopilot's only mutable memory; state is read-only. Call once per game tick,
# then step with the returned controls. A new FlightPlan starts a new trip; unmoor first.
# The terrain probe is sampled at 100 m: it is not obstacle/dock/traffic pathfinding.
# Provide an open-water departure area, approach corridor, touchdown and taxi target.
# Terrain lookahead and a departure loiter handle broad ridges; narrow cliffs need routing.
# Failed trips are explicit (.failed); callers can reroute. Up to three go-arounds.
enum FlightPhase: takeoff, climb, cruise, descend, land, taxi, done, failed
struct FlightPlan:
    target = vec3(0, 0, -5000)        # desired water touchdown x/z (y ignored)
    taxi_target = vec3(0, 0, -5100)   # dock approach point x/z
    altitude = 180.0                 # MSL cruise altitude
    speed = 0.0                     # 0 = craft's cruise speed
    takeoff_heading = 0.0
    landing_heading: f64? = none     # none = into wind; calm = takeoff heading
    phase: FlightPhase = .takeoff
    initialized = false
    approach_heading = 0.0           # captured at departure, stable in gusts
    approach_distance = 1800.0
    clearance_altitude = 0.0        # highest terrain on departure-to-destination corridor
    go_arounds = 0
    touchdown = vec3(0, 0, 0)        # recorded first landing contact

_air_controls = (k: CraftSpec, s: CraftState, e: FlightEnv, direction: vec3, altitude: f64, speed: f64) -> Controls:
    airspeed = f64(length(s.velocity - e.wind))
    d = normalize(vec3(direction.x, 0, direction.z))
    # (a gentle bank at most: no more than a quarter turn of error is asked for at once)
    h = atan2(f64(d.x), -f64(d.z))
    err = clamp(angle_delta(h, heading(s)), -0.6, 0.6)
    d = heading_vector(heading(s) + err)
    climb = clamp((altitude - f64(s.position.y)) * 0.005, -0.18, 0.24)
    if airspeed < k.stall_speed * 1.2 * pure_k(k): climb = min(climb, -0.02)
    want = normalize(d + vec3(0, f32(climb), 0))
    c = steer(k, s, want)
    c.roll = clamp(c.roll, -0.8, 0.8)
    c.airbrake = clamp((airspeed - speed - 2.0) * 0.12, 0.0, 1.0)
    target_v = sqrt(max(k.arc_thrust / k.arc_drag, 1.0))
    base = clamp((speed / target_v) ^ 2.0, 0.2, 1.0)
    c.throttle = clamp(base + (speed - airspeed) * 0.08 + max(climb, 0.0) * 2.0, 0.0, 1.0)
    c

_terrain_altitude = (s: CraftState, dir: vec3, e: FlightEnv, desired: f64, reach: f64 = 1600.0) -> f64:
    alt = desired
    # Look well beyond braking distance (on an approach: only as far as the touchdown and the
    # run out after it, so a harbor's own shore beyond does not wave the landing off).
    # Includes the present point and both wing corridors.
    loop i in 0..17:
        d = f64(i) * 100.0
        if d > reach: break
        p = s.position + dir * f32(d)
        side = vec3(-dir.z, 0, dir.x)
        loop j in [-1.0, 0.0, 1.0]:
            q = p + side * f32(j * 30.0)
            ground = e.ground(f64(q.x), f64(q.z))
            if ground > 0: alt = max(alt, ground + 90.0)
    alt

autopilot = (spec: CraftSpec, state: CraftState, plan: mut FlightPlan, env: FlightEnv) -> Controls:
    if state.crashed or state.beached or state.fuel <= 0:
        plan.phase = .failed
        return Controls(throttle = 0.0, water_brake = 1.0)
    if not plan.initialized:
        wind = vec3(env.wind.x, 0, env.wind.z)
        plan.approach_heading = plan.landing_heading ?? (if length(wind) > 1.0: atan2(-f64(wind.x), f64(wind.z)) else: plan.takeoff_heading)
        plan.approach_distance = max(1800.0, plan.altitude / 0.065 + 500.0)
        plan.clearance_altitude = plan.altitude
        route = plan.target - state.position
        route.y = 0
        samples = max(1, int(ceil(f64(length(route)) / 100.0)))
        loop i in 0..samples + 1:
            p = state.position + route * f32(f64(i) / f64(samples))
            ground = env.ground(f64(p.x), f64(p.z))
            if ground > 0: plan.clearance_altitude = max(plan.clearance_altitude, ground + 100.0)
        plan.initialized = true
    p = state.position
    speed = f64(length(state.velocity - env.wind))
    hdir = heading_vector(plan.approach_heading)
    fix = plan.target - hdir * f32(plan.approach_distance)
    # (its stall-based speeds as drawn: under the pure scale the scale's times faster)
    vs = pure_k(spec)
    cruise_speed = if plan.speed > 0: max(plan.speed, spec.stall_speed * 1.35 * vs) else: spec.cruise_speed
    if plan.phase == .takeoff:
        if not state.on_water and p.y > spec.float_height + 8: plan.phase = .climb
        else:
            c = Controls(throttle = 1.0, assist = 0.0)
            c.yaw = clamp(angle_delta(plan.takeoff_heading, heading(state)) * 2.0, -1.0, 1.0)
            pitch = asin(clamp(f64(forward(state).y), -1.0, 1.0))
            c.pitch = clamp(((if speed > spec.stall_speed * 0.9 * vs: 0.16 else: 0.025) - pitch) * 3.0 / spec.pitch_rate, -0.5, 0.6)
            return c
    if plan.phase == .climb or plan.phase == .cruise:
        if plan.phase == .climb and plan.clearance_altitude > plan.altitude + 10 and p.y < plan.clearance_altitude - 10:
            # Climb in a compact departure circle before committing to a high ridge.
            dir = heading_vector(heading(state) + 0.45)
            return _air_controls(spec, state, env, dir, plan.clearance_altitude + 80.0, spec.stall_speed * 1.5 * vs)
        delta = vec3(fix.x - p.x, 0, fix.z - p.z)
        d = f64(length(delta))
        dir = if d > 1: delta / f32(d) else: hdir
        alt = _terrain_altitude(state, dir, env, plan.altitude)
        if plan.phase == .climb and p.y > plan.altitude - 15: plan.phase = .cruise
        if d < max(220.0, speed * 5.0): plan.phase = .descend
        arrival_speed = if d < 1200: spec.stall_speed * 1.4 * vs else: cruise_speed
        return _air_controls(spec, state, env, dir, alt, arrival_speed)
    if plan.phase == .descend or plan.phase == .land:
        delta = plan.target - p
        along = f64(dot(delta, hdir))
        side = vec3(-hdir.z, 0, hdir.x)
        cross_track = f64(dot(delta, side))
        aim = hdir * 350.0 + side * f32(clamp(cross_track, -200.0, 200.0))
        dir = normalize(aim)
        alt = min(plan.altitude, spec.float_height + max(0.0, along - 100.0) * 0.065)
        terrain_alt = _terrain_altitude(state, dir, env, alt, max(along, 0.0) + 250.0)
        if along < -350 or (along < 400 and abs(cross_track) > 250) or (along < 450 and terrain_alt > alt + 30):
            plan.go_arounds += 1
            plan.phase = if plan.go_arounds > 3: .failed else: .climb
            return _air_controls(spec, state, env, dir, max(terrain_alt, plan.altitude), cruise_speed)
        if along < 450: plan.phase = .land
        c = _air_controls(spec, state, env, dir, terrain_alt, spec.stall_speed * 1.30 * vs)
        if plan.phase == .land:
            # The flare: steer for a sink rate that eases off near the water, at the slowest safe
            # speed, the throttle closed in the last few meters.
            hgt = f64(p.y) - spec.float_height
            sink = clamp(hgt * 0.3, 0.7, 4.5)
            sp = max(speed, spec.stall_speed * vs)
            want = normalize(dir + vec3(0, f32(-sink / sp), 0))
            c2 = steer(spec, state, want)
            c.pitch = c2.pitch
            c.roll = clamp(c2.roll, -0.5, 0.5)
            c.yaw = c2.yaw
            c.throttle = if hgt < 4.0: 0.0 else: clamp(c.throttle, 0.15, 0.6)
        if state.on_water:
            plan.touchdown = state.position; plan.phase = .taxi
        return c
    if plan.phase == .taxi:
        delta = vec3(plan.taxi_target.x - p.x, 0, plan.taxi_target.z - p.z)
        d = f64(length(delta)); v = f64(length(vec3(state.velocity.x, 0, state.velocity.z)))
        if d < 4 and v < 0.65:
            plan.phase = .done
            return Controls(water_brake = 1.0, anchor = true)
        h = atan2(f64(delta.x), -f64(delta.z)); err = angle_delta(h, heading(state))
        want = min(5.0, sqrt(max(d - 1.0, 0.0) * 1.2))
        if abs(err) > 0.7: want = min(want, 1.8)
        c = Controls(assist = 0.0)
        c.yaw = clamp(err * 2.0, -1.0, 1.0)
        c.throttle = clamp((want - v) * 0.12 + 0.08, 0.0, 0.25)
        c.water_brake = if v > want + 0.2: 1.0 else: 0.0
        return c
    Controls(throttle = 0.0, water_brake = 1.0, anchor = plan.phase == .done)
