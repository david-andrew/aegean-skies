# Bounded, read-only world sound scheduler/mixer. Cosmetic state is never saved in World.
use 'ambience_synth.jo'
use 'calendar.jo'
import 'living_types.jo' as life
import 'living_conditions.jo' as conditions
use 'lightning.jo'
use 'vessel_types.jo'

const AMBIENCE_LOOPS = 6
const AMBIENCE_HITS = 8
const AMBIENCE_PENDING = 32
struct AmbienceSource:
    key: int
    kind: AmbienceKind
    pos: vec3
    gain: f64
    reach: f64
    soft: f64 = 0.0
    pitch: f64 = 1.0
    variant = 0                     # which take of an event (ambience_variants)
struct AmbienceEvent:
    source: AmbienceSource
    due: f64
    screened = false
struct AmbienceVoice:
    source: AmbienceSource
    direct = -1
    muffled = -1
    level = 0.0
    expires = 0.0
struct Ambience:
    enabled: bool[] = fill(true,AMBIENCE_CATEGORIES)
    sounds: Sound[]
    soft: Sound[]                   # (at a quarter of the rate: ambience_soften_bank)
    first: int[]                    # each kind's first take in sounds (empty: one take each, by kind)
    loops: AmbienceVoice[]
    hits: AmbienceVoice[]
    pending: AmbienceEvent[]
    sources: AmbienceSource[]
    last_time = -1.0
    last_bell_minute = -1
    refresh = 0.0
    muted = false
    active = false
    playback = false
    duck = 1.0                      # live music close by hushes the background (the cafe's own murmur excepted)
    # (for play the instruments are made after the first frame, a few milliseconds a frame:
    # which kinds are made, the take being made and how far it has got)
    ready: bool[]
    next_take = 0
    next_kind = AMBIENCE_KINDS      # (a place in AMBIENCE_BUILD_ORDER)
    making = 0                      # 0 its sound, 1 its finish, 2 its half-rate copy, 3 its muffled copy, 4 the next begun
    whole: Sound = Sound()
    build: AmbienceBuild = AmbienceBuild()
    copy: CopyBuild = CopyBuild()

build_ambience = (render_only: bool = false) -> Ambience:
    a = Ambience(active=render_only or env("SLOPPY_NO_AUDIO") == none,playback=not render_only and env("SLOPPY_NO_AUDIO") == none)
    if not a.active: return a
    if a.playback:
        # (heard in play: nothing here delays the first frame; ambience_build_step makes them)
        ambience_build_later(a)
        return a
    loop k in 0..AMBIENCE_KINDS:
        a.first.push(a.sounds.len())
        loop take in 0..ambience_variants(AmbienceKind(k)):
            s = make_ambience(AmbienceKind(k),take+1)
            a.sounds.push(ambience_decimate(s,ambience_rate_step(AmbienceKind(k)))); a.soft.push(ambience_soften_bank(s))
    a.ready = fill(true,AMBIENCE_KINDS); a.next_kind = AMBIENCE_KINDS
    a

ambience_build_later = (a: mut Ambience):
    a.first = []; total = 0
    loop k in 0..AMBIENCE_KINDS:
        a.first.push(total); total += ambience_variants(AmbienceKind(k))
    a.sounds = fill(Sound(),total); a.soft = fill(Sound(),total)
    a.ready = fill(false,AMBIENCE_KINDS)
    a.next_kind = 0; a.next_take = 0; a.making = 0
    a.build = ambience_build_begin(AMBIENCE_BUILD_ORDER[0],1)

# Makes the instruments still to be made, for about `budget_ms` this frame: the same sounds
# build_ambience would have made at once (they draw on no shared random numbers). Each take is
# made in slices (a crowd bed piece by piece), then finished, then its half-rate copy and its
# muffled copy are made in slices too: no piece of it takes long.
const AMBIENCE_BUILD_SLICE = 1024
# (what is heard soonest is made first: a fresh game starts on a quay by the sea)
AMBIENCE_BUILD_ORDER = [AmbienceKind.beach,.murmur,.wave,.rope,.rigging,.gull,.hammer,.bell,.greet,.laugh,.call,.ask,.answer,.cafe,.ship_engine,.luff,.dog,.cliff,.surge,.trees,.grass,.cicada,.songbird,.spring,.goat,.donkey,.cricket,.owl,.whistle,.rain_sea,.rain_roof,.thunder]
const AMBIENCE_COPY_SLICE = 8192
ambience_build_step = (a: mut Ambience,budget_ms: f64):
    began = time()
    # (at least one piece a frame, however small the budget)
    loop a.next_kind < AMBIENCE_KINDS:
        ambience_build_piece(a)
        if (time()-began)*1000.0 >= budget_ms: return

# One piece of the making: a slice of a take's sound, its finish, or a slice of one of its copies.
ambience_build_piece = (a: mut Ambience):
    if a.next_kind >= AMBIENCE_KINDS: return
    kind = AMBIENCE_BUILD_ORDER[a.next_kind]
    at = a.first[int(kind)]+a.next_take
    if a.making == 0:
        if ambience_build_run(a.build,AMBIENCE_BUILD_SLICE): a.making = 1
    else if a.making == 1:
        a.whole = ambience_build_finish(a.build); a.build = AmbienceBuild()
        step = ambience_rate_step(kind)
        if step <= 1: a.sounds[at] = a.whole; a.making = 3; a.copy = ambience_soften_begin(a.whole)
        else: a.making = 2; a.copy = ambience_copy_begin(a.whole,step,f64(MIX_RATE)/f64(step)*0.42,f64(MIX_RATE)/f64(step)*0.42)
    else if a.making == 2:
        if ambience_copy_run(a.copy,AMBIENCE_COPY_SLICE):
            a.sounds[at] = Sound(a.copy.out); a.making = 3; a.copy = ambience_soften_begin(a.whole)
    else if a.making == 3:
        if ambience_copy_run(a.copy,AMBIENCE_COPY_SLICE):
            a.soft[at] = Sound(a.copy.out); a.copy = CopyBuild(); a.whole = Sound()
            a.next_take += 1
            if a.next_take >= ambience_variants(kind):
                a.ready[int(kind)] = true; a.next_kind += 1; a.next_take = 0
            a.making = 4
    else:
        # (the next take begun, a piece of its own)
        a.build = ambience_build_begin(kind,a.next_take+1); a.making = 0

ambience_ready = (a: Ambience,kind: AmbienceKind) -> bool: int(kind) < a.ready.len() and a.ready[int(kind)]

# the playback pitch of a take: the bank's rate made up (the muffled copies at a quarter)
ambience_step = (a: Ambience,kind: AmbienceKind,muffled: bool) -> f64:
    if a.first.len() == 0: return 1.0
    if muffled: f64(AMBIENCE_SOFT_STEP) else: f64(ambience_rate_step(kind))
ambience_take = (a: Ambience,s: AmbienceSource) -> int:
    if a.first.len() == 0: return int(s.kind)
    a.first[int(s.kind)]+s.variant%ambience_variants(s.kind)

# 0..1 from a key, a count and a salt: the same answer every time, unrelated across keys
ambience_hash = (key: int,n: int,salt: int) -> f64:
    state = u64((key*1000003+n*7919+salt*104729+12345) and 0x7fffffffffffffff)
    ambience_unit(state)

# The cell of an uneven event if one falls between the last scan and this one, else -1. Time is
# cut in cells of `seconds` and each holds one event at its own hashed moment, so the gaps run
# from almost nothing to nearly twice `seconds`, never a beat (a fixed period, the old way, was
# heard as a metronome: hull hammering every 4.7 s to the frame).
ambience_due = (previous: f64,now: f64,key: int,seconds: f64) -> int:
    if previous < 0 or now <= previous or now-previous > 1.5 or seconds <= 0: return -1
    loop c in int(floor(previous/seconds))..int(floor(now/seconds))+1:
        at = (f64(c)+ambience_hash(key,c,1))*seconds
        if at > previous and at <= now: return c
    -1

ambience_score = (s: AmbienceSource,listener: vec3) -> f64:
    s.gain*pow(max(0.0,1.0-f64(length(s.pos-listener))/max(1.0,s.reach)),2.0)*(1.0-0.72*s.soft)
ambience_offer = (list: mut AmbienceSource[],s: AmbienceSource,listener: vec3,limit: int = AMBIENCE_LOOPS):
    if s.gain <= 0.001 or ambience_score(s,listener) < 0.00005: return
    # Keep the nearest/loudest source of each loop instrument. Nine habitat cells
    # must not fill all six slots with the same cricket or grass buffer.
    if limit == AMBIENCE_LOOPS:
        loop k in 0..list.len():
            if list[k].kind == s.kind:
                if ambience_score(s,listener) > ambience_score(list[k],listener): list[k] = s
                return
    if list.len() < limit: list.push(s); return
    worst = 0
    loop k in 1..list.len():
        if ambience_score(list[k],listener) < ambience_score(list[worst],listener): worst = k
    if ambience_score(s,listener) > ambience_score(list[worst],listener): list[worst] = s

# Up, out and about: not the player, travelling, carried, gone, resting, asleep or at home.
ambience_awake = (w: life.World,p: life.Person) -> bool:
    if p.id == w.player or p.trip >= 0 or p.carriage >= 0 or p.state == .departed or p.state == .resting: return false
    if p.id in w.far.people:
        resident = w.far.people[p.id]
        if resident.anchor == resident.home_key and length(p.pose.pos-resident.home_pos) < 4: return false
    if p.id in w.daily_life:
        a = w.daily_life[p.id]
        if a.activity == .sleep or a.activity == .rest: return false
    true
ambience_people = (w: life.World,listener: vec3) -> vec3[]:
    points: vec3[]
    loop p in w.people:
        if length(p.pose.pos-listener) > 250 or not ambience_awake(w,p): continue
        points.push(p.pose.pos)
    loop h in w.households:
        if h.activity != .sleep and h.activity != .rest and length(h.pose-listener) <= 250: points.push(h.pose)
    points
ambience_count = (people: vec3[],at: vec3,radius: f64) -> int:
    count = 0
    loop p in people:
        if length(p-at) <= f32(radius): count += 1
    count
ambience_present = (w: life.World,at: vec3,radius: f64) -> int:
    ambience_count(ambience_people(w,at),at,radius)

ambience_queue = (a: mut Ambience,s: AmbienceSource,due: f64,listener: vec3):
    if not a.enabled[ambience_category(s.kind)] or ambience_score(s,listener) < 0.00005: return
    if a.pending.len() < AMBIENCE_PENDING: a.pending.push(AmbienceEvent(s,due))

# Exact hour boundary (world minute uses the saved 09:30 epoch); never replay a backlog.
ambience_bell_count = (minute: int) -> int:
    clock = life.local_minute(minute)
    if clock%60 != 0: return 0
    hour = clock/60
    if hour == 9 and calendar_service_day(life.day_index(minute)): return 16
    if hour%12 == 0: 12 else: hour%12
ambience_bells = (a: mut Ambience,churches: AmbienceSource[],minute: int,now: f64,listener: vec3):
    count = ambience_bell_count(minute)
    if count == 0 or a.last_bell_minute == minute: return
    # Audible time and calendar time differ while taking the waters. Several
    # scans can see one hour boundary; schedule that peal only once.
    a.last_bell_minute = minute
    # The nearest church, with a bounded queue shared across every event source.
    closest: AmbienceSource[]
    loop s in churches: ambience_offer(closest,s,listener,1)
    loop s in closest:
        loop k in 0..count:
            hit = s
            if count == 16: hit.pitch = [1.0,1.25,1.5,1.25][k%4]
            ambience_queue(a,hit,now+f64(k)*(if count == 16: 0.9 else: 1.0)+f64(s.key%7)*0.025,listener)

# Thunder from the strikes that are seen (lightning.jo): each strike's channel,
# heard after the distance at the speed of sound. Distance is physical metres.
ambience_thunder = (a: mut Ambience,w: life.World,previous: f64,now: f64,listener: vec3):
    if previous < 0 or now <= previous or now-previous > 1.0: return
    loop s in lightning_strikes_between(w.weather,previous,now):
        pos = vec3(f32(s.center.x),if s.ground: 400.0 else: 900.0,f32(s.center.z))
        distance = f64(length(pos-listener))
        if distance > 14000: continue
        loud = (if s.ground: 0.45 else: 0.3)*f64(s.weight)
        ambience_queue(a,AmbienceSource(s.key,.thunder,pos,loud,14000,soft=clamp(distance/6000,0.0,1.0)),s.time+distance/343.0,listener)

ambience_ship_source = (v: Vessel,wind: vec3) -> AmbienceSource?:
    if v.status != .underway or v.speed < 0.15: return none
    spec = vessel_spec(v.kind)
    if v.kind == .rowboat: return none
    if spec.sail:
        relative = wind-v.velocity
        forward = vec3(f32(sin(v.yaw)),0,f32(cos(v.yaw)))
        speed = f64(length(relative))
        # Luffing strongest near head-to-wind, with a quiet cloth bed on other points.
        luff = if speed > 0.1: max(0.0,-f64(dot(relative/ f32(speed),forward))) else: 0.0
        return AmbienceSource(8000000+v.id,.luff,v.position+vec3(0,3,0),clamp(speed/12,0.0,1.0)*(0.025+0.08*luff),120)
    AmbienceSource(8000000+v.id,.ship_engine,v.position+vec3(0,2,0),0.09*clamp(v.speed/max(spec.speed,0.1),0.15,1.0),if spec.steam: 450 else: 180,pitch=0.7+v.speed/max(spec.speed,0.1)*0.5)

ambience_stop_voice = (v: AmbienceVoice):
    if v.direct >= 0: stop(v.direct)
    if v.muffled >= 0: stop(v.muffled)
ambience_hush = (a: mut Ambience):
    loop v in a.loops: ambience_stop_voice(v)
    loop v in a.hits: ambience_stop_voice(v)
    a.loops = []; a.hits = []; a.pending = []; a.sources = []
    a.last_time = -1; a.refresh = 0; a.muted = true

# All loop gains share a conservative peak budget. One-shots have a separate capped
# budget and at most four voices. Engine comparison is measured by the sample tool.
ambience_mix = (a: mut Ambience,listener: vec3,dt: f64,now: f64,flying: bool):
    if not a.active or not a.playback: return
    loop_budget = if flying: 0.055 else: 0.65
    hit_budget = if flying: 0.035 else: 0.42
    next: AmbienceVoice[]
    loop v in a.loops:
        source: AmbienceSource? = none
        loop s in a.sources:
            if s.key == v.source.key and s.kind == v.source.kind and a.enabled[ambience_category(s.kind)]: source = s; break
        target = if source != none: source!.gain else: 0.0
        voice = v
        if source != none: voice.source = source!
        voice.level += (target-voice.level)*min(1.0,dt*4.0)
        if source == none and voice.level < 0.0005: ambience_stop_voice(voice)
        else: next.push(voice)
    a.loops = next
    loop s in a.sources:
        if not a.enabled[ambience_category(s.kind)]: continue
        exists = false
        loop v in a.loops:
            if v.source.key == s.key and v.source.kind == s.kind: exists = true
        if exists or a.loops.len() >= AMBIENCE_LOOPS or not ambience_ready(a,s.kind): continue
        direct = play_at(a.sounds[ambience_take(a,s)],s.pos,0.0,s.reach,pitch=s.pitch*ambience_step(a,s.kind,false),looping=true)
        soft = play_at(a.soft[ambience_take(a,s)],s.pos,0.0,s.reach,pitch=s.pitch*ambience_step(a,s.kind,true),looping=true)
        a.loops.push(AmbienceVoice(s,direct,soft))
    total = 0.0
    loop v in a.loops: total += v.level
    scale = min(1.0,loop_budget/max(total,0.0001))
    loop v in a.loops:
        gain = v.level*scale*(1.0-0.72*v.source.soft)*(if v.source.kind == .cafe: 1.0 else: a.duck)
        move_sound(v.direct,v.source.pos,gain*(1.0-v.source.soft),v.source.reach)
        move_sound(v.muffled,v.source.pos,gain*v.source.soft,v.source.reach)
        set_pitch(v.direct,v.source.pitch*ambience_step(a,v.source.kind,false)); set_pitch(v.muffled,v.source.pitch*ambience_step(a,v.source.kind,true))
    live: AmbienceVoice[]
    loop v in a.hits:
        if now >= v.expires or not a.enabled[ambience_category(v.source.kind)]: ambience_stop_voice(v)
        else: live.push(v)
    a.hits = live
    waiting: AmbienceEvent[]
    loop e in a.pending:
        if not a.enabled[ambience_category(e.source.kind)]: continue
        if e.due > now: waiting.push(e); continue
        if now-e.due > 0.3 or a.hits.len() >= AMBIENCE_HITS or not ambience_ready(a,e.source.kind): continue
        s = e.source
        if ambience_score(s,listener) <= 0.00005: continue
        muffled = s.soft > 0.45
        sample = if muffled: a.soft[ambience_take(a,s)] else: a.sounds[ambience_take(a,s)]
        voice = play_at(sample,s.pos,0.0,s.reach,pitch=s.pitch*ambience_step(a,s.kind,muffled))
        a.hits.push(AmbienceVoice(s,voice,expires=now+ambience_seconds(s.kind)/s.pitch))
    a.pending = waiting
    # Update every active hit too: flight/teleport/mute cannot leave a loud old tail.
    loop v in a.hits:
        gain = min(v.source.gain,hit_budget/f64(max(1,a.hits.len())))*(1.0-0.72*v.source.soft)*a.duck
        move_sound(v.direct,v.source.pos,gain,v.source.reach)
