use 'water_field.jo'
use 'water_types.jo'
use 'geography.jo'
use 'world_point.jo'
use 'depth_space.jo'
# Wakes: what an aircraft leaves on the sea. Each craft keeps the points it passed; drawn from
# them is a strip of mesh a little above the water, shaped and shaded as a wake: two raised
# ridges spreading out from the track at the Kelvin angle (they go on spreading as the wake ages),
# breaking into foam lines where they are steepest, faint transverse waves between them, and a
# churned center that fades. Skimming fast just over the water, the downwash churns a fainter
# track of its own.

use 'look.jo'
use 'render_space.jo'

const WAKE_EVERY = 0.15             # seconds between points
const WAKE_LIFE = 40.0              # seconds a point lasts
const KELVIN = 0.354                # tan 19.47 degrees: how fast the arms open behind the hull

struct WakePoint:
    pos: WorldPoint
    side: vec2                      # unit, across the track
    born: f64
    width: f32                      # how wide the hull or floats are
    strength: f32                   # how hard it was churned (0..1)
    speed: f32                      # how fast it was going then (sets how fast the arms spread)
    skim: f32                       # 0: the floats in the water; 1: only the downwash touching it

struct WakeTrail:
    pts: WakePoint[]
    last = -1.0
    broken = true                   # (the next point starts a new stretch)

# a craft at pos with velocity vel: on the water (or skimming just above it, `skim` 0..1)
wake_step = (w: mut WakeTrail, pos: WorldPoint, vel: vec3, on_water: bool, width: f64, t: f64, skim: f64 = 0.0):
    loop w.pts.len() > 0 and t - w.pts[0].born > WAKE_LIFE: w.pts.remove_at(0)
    flow=if geography_enabled:water_current(pos.x,pos.z) else:vec3(0,0,0)
    v = vec2(vel.x-flow.x, vel.z-flow.z)
    sp = f64(length(v))
    touching = on_water or skim > 0.02
    if not touching or sp < 1.0:
        w.broken = true
        return
    if t - w.last < WAKE_EVERY: return
    w.last = t
    d = v / f32(sp)
    strength = f32(clamp(sp / 22.0, 0.12, 1.0) * (if on_water: 1.0 else: skim * 0.6))
    sk = f32(if on_water: 0.0 else: skim)
    if w.broken and w.pts.len() > 0:
        # a gap: points of no strength, so the strip does not join the old stretch to the new
        p = w.pts[w.pts.len() - 1]
        w.pts.push(WakePoint(p.pos, p.side, p.born, p.width, 0.0, p.speed, p.skim))
        w.pts.push(WakePoint(pos, vec2(-d.y, d.x), t, f32(width), 0.0, f32(sp), sk))
    w.broken = false
    w.pts.push(WakePoint(pos, vec2(-d.y, d.x), t, f32(width), strength, f32(sp), sk))

# (a wake's vertices are the engine's own Vertex3D: uv carries x across (-1.3..1.3: the arms at
# +-1) and the age (s); color, whose parts are kept between 0 and 1, the strength, whether it is a
# skimming wake, and the arms' half-width over 64 m)

struct WakeParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    sky: vec3
    haze: vec3
    fog: f32
    time: f32
    warp_a: vec4                    # (the speed trial's warp: render_space.jo)
    warp_b: vec4
    phase: f32 = 0.0

struct WakeOut:
    pos: vec4
    world: vec3
    normal: vec3
    data: vec4

# (four floats per vertex beyond position and normal: a fifth varying did not arrive)
wake_vs = (v: Vertex3D, u: WakeParams) -> WakeOut: WakeOut(u.view_proj * vec4(v.pos, 1), v.pos, v.normal, vec4(v.uv.x, v.uv.y, if v.color.y > 0.5: -v.color.x else: v.color.x, v.color.z * 64.0))

wake_fs = (i: WakeOut, u: WakeParams) -> vec4:
    x = i.data.x
    ax = abs(x)
    age = i.data.y
    s = abs(i.data.z)
    life = 1.0 - smoothstep(0.0, WAKE_LIFE, age)
    skim: f32 = if i.data.z < 0.0: 1.0 else: 0.0
    meters = ax * i.data.w
    along = dot(i.world.xz, vec2(0.7, 0.7))+u.phase
    arms = 1.0 - skim
    # the arms: a foam line on each ridge, broken here and there, thinning with age
    ridge = exp(-((ax - 1.0) / 0.07) * ((ax - 1.0) / 0.07))
    breakup = smoothstep(0.25, 0.7, vnoise(vec2(along * 0.35, x * 4.0 + age * 0.2)) + 0.35 * exp(-age / 6.0))
    foam = ridge * breakup * exp(-age / 14.0) * arms
    # faint transverse waves between the arms
    tw = sin(along * 0.9 - age * 1.6) * 0.5 + 0.5
    trans = smoothstep(0.85, 1.0, tw) * (1.0 - smoothstep(0.75, 0.95, ax)) * smoothstep(0.2, 0.5, ax) * exp(-age / 8.0) * arms
    # the churned water behind each float (or the hull): broken foam in two lanes, brief
    lane = abs(meters - 1.55 * (1.0 - skim))
    lw = 0.7 + age * 0.4 + 1.5 * skim
    fl = vnoise(vec2(along * 1.4, meters * 2.2 + age * 0.7)) * 0.6 + vnoise(vec2(along * 3.1, meters * 5.0)) * 0.4
    churn = (1.0 - smoothstep(lw * 0.5, lw, lane)) * exp(-age / (2.0 + 3.0 * skim)) * smoothstep(0.42, 0.62, fl)
    a = clamp(foam * 0.9 + trans * 0.15 + churn * 0.75, 0.0, 1.0) * s * life
    if a < 0.01: discard()
    # lit as raised water: the ridge's sunward face brighter
    n = normalize(i.normal)
    lit = 0.8 + 0.3 * clamp(dot(n, normalize(u.sun_dir)), -1.0, 1.0)
    c = vec3(0.96, 0.98, 1.0) * (u.sun * 0.8 + u.sky * 0.35) * lit
    vec4(aerial(c, i.world, u.cam, u.haze, u.fog), a * 0.9)

wake_sh: Shader
wake_mesh: Mesh
wake_ready = false

init_wake = ():
    global wake_sh, wake_mesh, wake_ready
    wake_sh = make_world_shader(shader(wake_vs, wake_fs))
    z = Vertex3D(vec3(0, 0, 0), vec3(0, 1, 0), vec2(0, 0), vec4(0, 0, 0, 0))
    wake_mesh = mesh([z, z, z])
    wake_ready = true

# the strip's cross-section: where the columns sit (in arm widths), denser at the ridges
COLS: f32[11] = [-1.3, -1.1, -1.0, -0.9, -0.5, 0.0, 0.5, 0.9, 1.0, 1.1, 1.3]

# how high the wake stands at x across (in arm widths), for a point of this age and strength
_profile = (x: f32, age: f64, s: f32, skim: f32) -> f32:
    ax = abs(x)
    ridge = exp(-((ax - 1.0) / 0.12) * ((ax - 1.0) / 0.12)) * (1.0 - skim)
    mid = (1.0 - smoothstep(0.0, 0.5, ax)) * 0.4
    (ridge * 0.35 + mid * 0.12) * s * f32(exp(-age / 9.0))

# The cross-section never changes. Separate it from the per-point age fade;
# rebuilding every quad used to evaluate these exponentials 120 times per
# segment, including the wakes of distant aircraft after clubs start flying.
wake_sections: vec4[] = [loop x in COLS: vec4(_profile(x,0,1,0),(_profile(x+0.05,0,1,0)-_profile(x-0.05,0,1,0))/0.1,_profile(x,0,1,1),(_profile(x+0.05,0,1,1)-_profile(x-0.05,0,1,1))/0.1)]

wake_row = (p: WakePoint, life: f64, origin: vec3) -> Vertex3D[]:
    o = f64(p.width)+min(life*f64(p.speed)*KELVIN,25.0)+life*0.25
    amplitude = p.strength*f32(exp(-life/9.0))
    flow=if geography_enabled:water_current(p.pos.x,p.pos.z) else:vec3(0,0,0)
    local = world_local(p.pos,origin).xz+flow.xz*f32(life)
    row: Vertex3D[]
    loop c in 0..COLS.len():
        section = wake_sections[c]
        hgt = mix(section.x,section.z,p.skim)*amplitude
        dx = mix(section.y,section.w,p.skim)*amplitude/f32(o)
        q = local+p.side*f32(f64(COLS[c])*o)
        inland=if geography_enabled:water_at(f64(q.x)+f64(origin.x),f64(q.y)+f64(origin.z)) else:WaterSample()
        level=if inland.wet:f32(inland.level) else:0.0
        n = normalize(vec3(0,1,0)-vec3(p.side.x,0,p.side.y)*dx)
        row.push(Vertex3D(vec3(q.x,level+0.05+hgt-origin.y,q.y),n,vec2(COLS[c],f32(life)),vec4(p.strength,if p.skim>0.5:1.0 else:0.0,f32(min(o/64.0,1.0)),1)))
    row

draw_wakes = (trails: WakeTrail[], L: Light, t: f64, target: Mesh? = none):
    if not wake_ready: return
    origin = render_origin(scene_camera())
    vs: Vertex3D[]
    loop w in trails:
        if w.pts.len()<2:continue
        row = wake_row(w.pts[0],t-w.pts[0].born,origin)
        loop k in 0..w.pts.len() - 1:
            a = w.pts[k]
            b = w.pts[k + 1]
            previous = row
            row = wake_row(b,t-b.born,origin)
            if a.strength <= 0.0 and b.strength <= 0.0: continue
            loop c in 0..COLS.len() - 1:
                a0 = previous[c]; a1 = previous[c+1]
                b0 = row[c]; b1 = row[c+1]
                vs.push(a0); vs.push(b0); vs.push(a1)
                vs.push(a1); vs.push(b0); vs.push(b1)
    if vs.len() < 3: return
    output = target ?? wake_mesh
    update_mesh(output, vs)
    draw(wake_sh, output, WakeParams(render_view_proj(origin), render_eye(origin), L.sun_dir, L.sun, L.sky_top, L.haze, f32(L.fog_density), f32(t), render_anchor(scene_warp_a,origin), scene_warp_b,f32((f64(origin.x)+f64(origin.z))*0.7)))

wake_step=(w:mut WakeTrail,pos:vec3,vel:vec3,on_water:bool,width:f64,t:f64,skim:f64=0.0):wake_step(w,world_point(pos),vel,on_water,width,t,skim)
