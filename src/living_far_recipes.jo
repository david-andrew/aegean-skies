# Industrial input ratios shared by production and the counter's real procurement goal.
const FAR_STAPLE_DAILY = 28
const FAR_DAILY_FOOD: int[9] = [35,8,8,FAR_STAPLE_DAILY,0,0,1,2,0]

far_input = (good: int) -> int:
    if good==5: 4 else: if good==8: 5 else: if good==6: 1 else: -1

far_input_divisor = (good: int) -> int: if good==5: 10 else: 2
