# Short military-network cues for the strait scenario, entirely synthesized.
# Reads real formation/fire/distress state; never writes Battle or World.
use 'combat.jo'
use 'radio_synth.jo'
use 'airsound.jo'

struct BattleRadio:
    bank: Sound[]
    voice = -1
    last_tick = -1
    next_tick = 0
    check_sent = false
    contact_sent = false
    distress_sent = false
    volume = 0.20

battle_radio_wave = (text: str,seed: int) -> Sound:
    code=radio_morse(text)
    unit=0.065; seconds=f64(code.len())*unit+0.18
    n=int(seconds*f64(MIX_RATE)); samples=fill(f32(0),n*2)
    r=rng(seed); hp=Biquad();lp=Biquad()
    highpass(hp,400);lowpass(lp,2600)
    loop i in 0..n:
        t=f64(i)/f64(MIX_RATE);k=int(max(0.0,t-0.09)/unit)
        on=t>=0.09 and k<code.len() and code[k]
        # Five millisecond key ramps avoid digital clicks; the carrier has a
        # little air and drift, not an imitation of intelligible speech.
        edge=if on: (if k>0 and code[k-1]:1.0 else:min(1.0,(t-0.09-f64(k)*unit)/0.005)) else: 0.0
        tail=if on: (if k+1<code.len() and code[k+1]:1.0 else:min(1.0,(unit-(t-0.09-f64(k)*unit))/0.005)) else: 0.0
        noise=r.next_float()*2-1
        carrier=sin(TAU*(670*t+0.22*sin(t*3.7)))*0.48*edge*tail
        env=min(1.0,t/0.015)*min(1.0,(seconds-t)/0.035)
        value=filt(lp,filt(hp,carrier+noise*0.055))*env
        samples[i*2]=f32(value);samples[i*2+1]=f32(value)
    Sound(samples)

battle_radio_cue = (s: mut BattleRadio,b: Battle,person: int) -> int:
    if b.tick<s.last_tick:
        s.check_sent=false;s.contact_sent=false;s.distress_sent=false;s.next_tick=0
    s.last_tick=b.tick
    human= -1
    loop i in 0..b.actors.len():
        if b.actors[i].person==person and b.actors[i].present: human=i;break
    if human<0 or b.finished or b.tick<s.next_tick:return -1
    player=b.actors[human];friends=0;shots=0;hostile=false
    loop a in b.actors:
        if not a.present or a.status==.escaped:continue
        if length(a.state.position-player.state.position)>7000:continue
        if a.side==player.side:
            friends+=1;shots+=a.gun.shots
        else:hostile=true
    cue= -1
    if not s.distress_sent and (player.bailed or player.status==.wreck):
        s.distress_sent=true;cue=2
    else if hostile and friends>=2:
        if not s.contact_sent and shots>0:s.contact_sent=true;cue=1
        else if not s.check_sent and b.tick>=90:s.check_sent=true;cue=0
    if cue>=0:s.next_tick=b.tick+480
    cue

hush_battle_radio = (s: mut BattleRadio):
    if s.voice>=0:stop(s.voice);s.voice= -1

prepare_battle_radio = (s: mut BattleRadio):
    if s.bank.len()==0:s.bank=[battle_radio_wave("VV",1931),battle_radio_wave("R",1932),battle_radio_wave("SOS",1933)]

update_battle_radio = (s: mut BattleRadio,b: Battle,person: int,active: bool):
    if not active:
        hush_battle_radio(s)
        s.last_tick= -1;s.next_tick=0;s.check_sent=false;s.contact_sent=false;s.distress_sent=false
        return
    cue=battle_radio_cue(s,b,person)
    if cue<0:return
    prepare_battle_radio(s)
    hush_battle_radio(s)
    s.voice=play(s.bank[cue],s.volume,pan= -0.12)
