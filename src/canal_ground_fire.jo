# The canal takeoff's ground fire: Orenthian irregulars along the run out of Neravessa, on roofs,
# bridges and the promenades. They belong to the scenario's Battle (no living-world people). Each
# post is placed from the canal city's own solids, so it stands on a real roof, deck or quay.
use 'canal_geometry.jo'
use 'river_data.jo'
use 'combat.jo'
use 'flight.jo'

struct CanalPost:
    local: int                      # canal node offset from CANAL_BEGIN
    sign: f64                       # which bank (+1 the workshop's)
    place: int                      # 0 roof, 1 promenade, 2 bridge deck, 3 a bridge's stair head
    kind: GroundGunKind

# Spread along the whole run: the water run passes stations 22-66 in about 25 s, then the climb.
CANAL_POSTS = [CanalPost(25,-1.0,0,.rifle),CanalPost(33,1.0,1,.rifle),CanalPost(38,1.0,3,.machine_gun),
    CanalPost(43,1.0,0,.rifle),CanalPost(46,-1.0,0,.machine_gun),CanalPost(50,-1.0,0,.rifle),
    CanalPost(56,-1.0,2,.rifle),CanalPost(59,1.0,1,.rifle),CanalPost(63,1.0,0,.machine_gun),CanalPost(67,-1.0,0,.rifle)]

# A roof's top, its canal edge pulled in a little: the nearest flat-roofed building block (kinds 1
# and 10; a quarter of the city's houses have a flat roof with a low parapet, chosen by the same
# seed canal_render.jo draws them with) to the front row's place. A man stands on the parapet slab.
canal_roof = (local: int, sign: f64) -> vec3?:
    a = RIVER_NODES[CANAL_BEGIN+local]; b = RIVER_NODES[CANAL_BEGIN+local+1]
    dir = normalize(b.xy-a.xy); side = vec2(-dir.y,dir.x); mid = (a+b)*0.5
    want = mid.xy+side*f32(sign*(f64(mid.w)+16.0))
    best = -1; nearest = 80.0
    loop i in 0..canal_solids.len():
        box = canal_solids[i]
        if (box.kind != 1 and box.kind != 10) or not canal_flat_roof(i): continue
        # (the front two rows, on this bank, overlooking the water)
        across = f64(dot(box.center.xz-mid.xy,side))*sign
        if across < f64(mid.w) or across > f64(mid.w)+48.0: continue
        d = f64(length(box.center.xz-want))
        if d < nearest: best = i; nearest = d
    if best < 0: return none
    box = canal_solids[best]
    toward = -side*f32(sign)
    top = box.center.xz+toward*(box.half.x-1.4)
    vec3(top.x,box.center.y+box.half.y+0.3,top.y)

# Where post p stands (its feet) and the way it faces (toward the water).
canal_post_spot = (p: CanalPost) -> (vec3,f64)?:
    a = RIVER_NODES[CANAL_BEGIN+p.local]; b = RIVER_NODES[CANAL_BEGIN+p.local+1]
    dir = normalize(b.xy-a.xy); side = vec2(-dir.y,dir.x); mid = (a+b)*0.5
    toward = -side*f32(p.sign)
    facing = atan2(f64(toward.x),-f64(toward.y))
    water = f64(mid.z)
    if p.place == 0:
        if let roof = canal_roof(p.local,p.sign): return (roof,facing)
        return none
    if p.place == 1:
        q = mid.xy+side*f32(p.sign*(f64(mid.w)+1.6))
        return (vec3(q.x,f32(water+CANAL_STREET),q.y),facing)
    back = atan2(f64(-dir.x),f64(dir.y))
    if p.place == 3:
        # (the head of the approach stair, just past the deck's end and clear of an iron
        # bridge's truss; standing on whatever step is there)
        q = a.xy+vec2(-dir.y,dir.x)*f32(p.sign*(f64(a.w)+6.0))
        top = canal_floor(f64(q.x),f64(q.y),water+30.0)
        if top < water: return none
        return (vec3(q.x,f32(top),q.y),back)
    # (a bridge deck: its top follows the bridge's profile; a little off the centre line)
    k = canal_bridge_index(p.local)
    if k < 0: return none
    x = f64(a.w)*0.55*p.sign
    q = a.xy+vec2(-dir.y,dir.x)*f32(x)
    (vec3(q.x,f32(f64(a.z)+canal_bridge_top(CANAL_BRIDGES[k],x,f64(a.w))),q.y),back)

# The posts, holding fire until `wake` (the slipway launch and hand-over come first).
canal_ground_fire = (side: int, wake: int) -> GroundGun[]:
    init_canal_geometry()
    result: GroundGun[]
    loop k in 0..CANAL_POSTS.len():
        p = CANAL_POSTS[k]
        if let spot = canal_post_spot(p):
            foot, facing = spot
            rifle = p.kind == .rifle
            muzzle = foot+vec3(0,if rifle: 1.45 else: 0.48,0)
            g = GroundGun(-1000-k,side,muzzle,p.kind,facing,reach=if rifle: 560.0 else: 760.0,skill=if rifle: 0.3 else: 0.22,
                health=if rifle: 1.0 else: 2.0,wake=wake+k*7,arc=if rifle: PI else: 1.9,half=if rifle: vec3(0.45,0.9,0.45) else: vec3(1.5,0.7,1.5))
            g.aim = heading_vector(facing)
            result.push(g)
    result
