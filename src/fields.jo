# The farmed land: a patchwork of straight-edged fields over the gentle country, each one flat
# crop colour, with hedgerows and tree lines along a share of their edges that cast a shadow
# onto the field on the side away from the sun (the film's farmland reads as solid land through
# exactly this: flat parcels of many greens and straw, dark boundaries, hard shadow strips).
#
# Districts (about 700 m, their edges warped so no grid shows from the air) each have their own
# field direction and sizes; inside one, staggered rows of rectangular fields. Everything comes
# from integer cell hashes (hash21), the same on the CPU and the GPU.
use 'look.jo'

const FIELD_DISTRICT = 500.0

# The fields' palette: 1 the green valleys (the film's farmland), 0 the dry straw summer
# (docs/ART.md). A switch until the look is decided: AEGEAN_FIELD_PALETTE=dry.
field_palette: f32 = if env("AEGEAN_FIELD_PALETTE") == "dry": 0.0 else: 1.0

struct FieldCell:
    crop: vec4 = vec4(0,0,0,0)      # (crop hash, tone hash, striped 0/1, row phase)
    along: vec2 = vec2(1,0)         # the field's long direction (world xz)
    local: vec2 = vec2(0,0)         # the point in the field's frame (metres from its corner)
    size: vec2 = vec2(100,60)       # the field's length and width
    edge: vec4 = vec4(1e3,1e3,1e3,1e3)  # distance to its four sides: start, end, below, above
    hedge: vec4 = vec4(0,0,0,0)     # a hedgerow on each side (0/1), the same order
    lane: f32 = 1e3                 # distance to the district's edge (a lane with hedges)

# The field under a ground point (absolute world xz). warp: a smooth noise in [-1, 1]^2.
field_at = (p: vec2,warp: vec2) -> FieldCell:
    q = p+warp*180.0
    district = floor(q/FIELD_DISTRICT)
    d = vec4(hash21(district+vec2(4091.0,-2287.0)),hash21(district+vec2(-773.0,9137.0)),hash21(district+vec2(1777.0,331.0)),hash21(district+vec2(-5039.0,-4421.0)))
    angle = d.x*3.14159
    along = vec2(cos(angle),sin(angle))
    across = vec2(-along.y,along.x)
    o = q-(district+vec2(0.5,0.5))*FIELD_DISTRICT
    l = vec2(dot(o,along),dot(o,across))+vec2(2000.0,2000.0)
    width = 30.0+d.y*45.0
    row = floor(l.y/width)
    r = hash21(district*31.0+vec2(row,17.0))
    length = width*(1.1+r*1.5)
    x = l.x+r*length
    col = floor(x/length)
    c = hash21(district*17.0+vec2(col,row*7.0+3.0))
    t = hash21(district*13.0+vec2(col*5.0+1.0,row))
    lx = x-col*length; ly = l.y-row*width
    e = vec4(lx,length-lx,ly,width-ly)
    # hedgerows: on about half the row edges (long sides) and a third of the ends, more where
    # the district is pasture (d.w high); a district's edge is a lane
    hl = hash21(district*7.0+vec2(row,91.0))
    hu = hash21(district*7.0+vec2(row+1.0,91.0))
    hs = hash21(district*11.0+vec2(col+row*57.0,5.0))
    he = hash21(district*11.0+vec2(col+1.0+row*57.0,5.0))
    hedge = vec4(step(hs,0.25+d.w*0.3),step(he,0.25+d.w*0.3),step(hl,0.4+d.w*0.4),step(hu,0.4+d.w*0.4))
    f = fract(q/FIELD_DISTRICT)
    lane = min(min(f.x,1.0-f.x),min(f.y,1.0-f.y))*FIELD_DISTRICT
    FieldCell(vec4(c,t,step(0.78,fract(c*7.3)),fract(t*3.1)),along,vec2(lx,ly),vec2(length,width),e,hedge,lane)

# A field's crop colour. green: the palette (1 the green valleys, 0 the dry straw summer).
field_crop = (cell: FieldCell,green: f32,footprint: f32) -> vec3:
    k = cell.crop.x
    tone = cell.crop.y
    lush = mix(vec3(0.36,0.52,0.22),vec3(0.24,0.42,0.18),tone)
    if k < 0.18: lush = mix(vec3(0.52,0.58,0.27),vec3(0.46,0.55,0.25),tone)
    else if k < 0.32: lush = mix(vec3(0.70,0.62,0.36),vec3(0.62,0.55,0.32),tone)
    else if k < 0.42: lush = mix(vec3(0.56,0.46,0.32),vec3(0.50,0.41,0.29),tone)
    else if k < 0.58: lush = mix(vec3(0.40,0.49,0.29),vec3(0.33,0.44,0.26),tone)
    dry = mix(vec3(0.70,0.60,0.35),vec3(0.62,0.53,0.31),tone)
    if k < 0.20: dry = mix(vec3(0.55,0.45,0.30),vec3(0.50,0.41,0.28),tone)
    else if k < 0.34: dry = mix(vec3(0.46,0.47,0.30),vec3(0.40,0.43,0.28),tone)
    else if k < 0.46: dry = mix(vec3(0.76,0.66,0.40),vec3(0.70,0.61,0.37),tone)
    col = mix(dry,lush,green)
    if k > 0.85 and cell.crop.z > 0.5: col = mix(vec3(0.46,0.47,0.31),vec3(0.40,0.44,0.29),tone)
    # (a slight lean of tone across each field, as a painter lays it)
    col *= 0.95+0.1*(cell.local.x/cell.size.x)*(cell.crop.w-0.5)*2.0
    # rows of vines or orchard trees on some fields, painted at ten metres, faded before they alias
    if cell.crop.z > 0.5:
        rows = 0.5+0.5*sin(cell.local.y*0.63+cell.crop.w*6.28)
        col *= 1.0-0.2*rows*clamp((4.0-footprint)/2.0,0.0,1.0)
    col

# The hedgerows and their shadows over a point: (hedge cover, shadow, lit fringe) in [0, 1].
# light: the canopy's modelling light (held low at every hour, so the shadows read at noon too).
# A tree line of height h casts its shadow h/tan(elevation) across the field on the side away
# from the light, by the share of the light's bearing across the line.
field_hedges = (cell: FieldCell,light: vec4,footprint: f32) -> vec3:
    soft = max(0.8,footprint*0.7)
    h = vec2(light.x,light.z)
    sa = dot(h,cell.along)/max(length(h),0.001)                       # light along the field
    sc = dot(h,vec2(-cell.along.y,cell.along.x))/max(length(h),0.001)  # light across it
    reach = 10.0/max(light.y,0.25)*light.w
    cover: f32 = 0.0
    shadow: f32 = 0.0
    fringe: f32 = 0.0
    loop k in 0..4:
        on = if k == 0: cell.hedge.x else: if k == 1: cell.hedge.y else: if k == 2: cell.hedge.z else: cell.hedge.w
        if on < 0.5: continue
        dist = if k == 0: cell.edge.x else: if k == 1: cell.edge.y else: if k == 2: cell.edge.z else: cell.edge.w
        # (the line's crowns: its edge scalloped every few metres)
        run = if k < 2: cell.local.y else: cell.local.x
        half = 2.6+1.6*abs(sin(run*0.55+on*3.0))*abs(sin(run*0.23+1.7))
        here = 1.0-clamp((dist-half)/soft,0.0,1.0)
        toward = if k == 0: -sa else: if k == 1: sa else: if k == 2: -sc else: sc
        cover = max(cover,here)
        # (the crown's face toward the light is lit, the field-side face away from it is not)
        fringe = max(fringe,here*clamp(-toward*2.0,0.0,1.0)*clamp((dist-half*0.3)/max(half*0.7,0.5),0.0,1.0))
        shadow = max(shadow,(1.0-clamp((dist-half-reach*max(toward,0.0))/soft,0.0,1.0))*step(0.05,toward))
    # the lane round the district: a pale track between two hedgerows
    lane_hedge = 1.0-clamp((abs(cell.lane-5.5)-2.2)/soft,0.0,1.0)
    cover = max(cover,lane_hedge)
    vec3(cover,shadow*(1.0-cover),fringe)

# The lane's track: 0 to 1 within a couple of metres of the district's edge.
field_lane = (cell: FieldCell,footprint: f32) -> f32: 1.0-clamp((cell.lane-1.8)/max(0.8,footprint*0.7),0.0,1.0)

# Where the land is farmed: gentle ground, below the hills' scrub, above the shore.
field_share = (slope: f32,height: f32,woody: f32) -> f32:
    clamp((0.26-slope)*8.0,0.0,1.0)*clamp((850.0-height)/250.0,0.0,1.0)*clamp((height-4.0)*0.5,0.0,1.0)*clamp(1.0-woody*1.3,0.0,1.0)
