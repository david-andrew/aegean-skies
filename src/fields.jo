# The farmed land: a patchwork of straight-edged fields over the gentle country, each one flat
# crop colour, with hedgerows and tree lines along a share of their edges that cast a shadow
# onto the field on the side away from the sun (the film's farmland reads as solid land through
# exactly this: flat parcels of many greens and straw, dark boundaries, hard shadow strips).
#
# Districts (500 m, their edges warped so no grid shows from the air) each have their own
# field direction and sizes; inside one, staggered rows of rectangular fields. Everything comes
# from integer cell hashes (hash21), the same on the CPU and the GPU.
use 'look.jo'
use 'coast_pattern.jo'
use 'canopy.jo'

const FIELD_DISTRICT = 500.0

# The fields' palette: 1 the green valleys (the film's farmland), 0 the dry straw summer
# (docs/ART.md). A switch until the look is decided: AEGEAN_FIELD_PALETTE=dry.
field_palette: f32 = if env("AEGEAN_FIELD_PALETTE") == "dry": 0.0 else: 1.0

struct FieldCell:
    crop: vec4 = vec4(0,0,0,0)      # (crop hash, tone hash, striped 0/1, row phase)
    along: vec2 = vec2(1,0)         # the field's long direction (world xz)
    local: vec2 = vec2(0,0)         # the point in the field's frame (metres from its corner)
    size: vec2 = vec2(100,60)       # the field's length and width
    edge: vec4 = vec4(1e3,1e3,1e3,1e3)  # distance to its four sides: start, end, below, above
    hedge: vec4 = vec4(0,0,0,0)     # a hedgerow on each side (0/1), the same order
    lane: f32 = 1e3                 # distance to the district's edge (a lane)
    lane_hedge: f32 = 0.0           # a hedgerow along this district's side of the lane (hash)

# The field under a ground point (absolute world xz). warp: a smooth noise in [-1, 1]^2.
field_at = (p: vec2,warp: vec2) -> FieldCell:
    q = p+warp*180.0
    district = floor(q/FIELD_DISTRICT)
    # (one hash split into four 6-bit fields per district, row and field: half the hashes)
    d = grove_bits(hash21(district+vec2(4091.0,-2287.0)))
    angle = d.x*3.14159
    along = vec2(cos(angle),sin(angle))
    across = vec2(-along.y,along.x)
    o = q-(district+vec2(0.5,0.5))*FIELD_DISTRICT
    l = vec2(dot(o,along),dot(o,across))+vec2(2000.0,2000.0)
    width = 30.0+d.y*45.0
    row = floor(l.y/width)
    rb = grove_bits(hash21(district*31.0+vec2(row,17.0)))
    r = rb.x
    length = width*(1.1+r*1.5)
    x = l.x+r*length
    col = floor(x/length)
    cb = grove_bits(hash21(district*17.0+vec2(col,row*7.0+3.0)))
    c = cb.x; t = cb.y
    lx = x-col*length; ly = l.y-row*width
    e = vec4(lx,length-lx,ly,width-ly)
    # hedgerows: on about half the row edges (long sides) and a third of the ends, more where
    # the district is pasture (d.w high); a district's edge is a lane
    hl = rb.y
    hu = grove_bits(hash21(district*31.0+vec2(row+1.0,17.0))).y
    hs = cb.w
    he = grove_bits(hash21(district*17.0+vec2(col+1.0,row*7.0+3.0))).w
    hedge = vec4(step(hs,0.25+d.w*0.3),step(he,0.25+d.w*0.3),step(hl,0.4+d.w*0.4),step(hu,0.4+d.w*0.4))
    f = fract(q/FIELD_DISTRICT)
    lane = min(min(f.x,1.0-f.x),min(f.y,1.0-f.y))*FIELD_DISTRICT
    FieldCell(vec4(c,t,step(0.78,cb.z),fract(t*3.1+cb.z)),along,vec2(lx,ly),vec2(length,width),e,hedge,lane,d.z)

# Where the land is farmed: gentle ground, below the hills' scrub, above the shore.
field_share = (slope: f32,height: f32,woody: f32) -> f32:
    clamp((0.26-slope)*8.0,0.0,1.0)*clamp((850.0-height)/250.0,0.0,1.0)*clamp((height-4.0)*0.5,0.0,1.0)*clamp(1.0-woody*1.3,0.0,1.0)

# ---------------- the fields' colour, per terrain sample ----------------
# The terrain's working channel holds each sample's field colour and share on every tier (the
# hedgerows, lanes and edges come from the field map, src/field_map.jo): a field's crop class
# (x straw and corn, y vines, z olives, w pasture and greens), its weight carrying its tone,
# turned into colour by field_crop_low. Soft field edges at the samples' spacing; the field map's
# edge lines and hedgerows draw the crisp ones.

# The warp noise the shader reads from the coast pattern texture at world/6000, read on the CPU.
field_warp_cpu = (p: vec2) -> vec2:
    q = p/6000.0*512.0
    x = int(floor(q.x)); z = int(floor(q.y)); f = q-floor(q)
    a = coast_pattern_pixel(x,z).xy; b = coast_pattern_pixel(x+1,z).xy
    c = coast_pattern_pixel(x,z+1).xy; d = coast_pattern_pixel(x+1,z+1).xy
    mix(mix(a,b,f.x),mix(c,d,f.x),f.y)/1.01

# One point's baked crop weights (zero where not farmed).
_field_sample = (p: vec2,share: f32,orchard: f32,warp: vec2) -> vec4:
    cell = field_at(p,warp)
    k = cell.crop.x
    tone = (0.55+0.45*cell.crop.y)*share
    if orchard > 0.35 and k < 0.7: return vec4(0,0,tone,0)
    if cell.crop.z > 0.5: return if k > 0.85: vec4(0,0,tone,0) else: vec4(0,tone,0,0)
    if k < 0.32: return vec4(tone,0,0,0)
    vec4(0,0,0,tone)

# A world-tile sample's baked field (zero where the land is not farmed). slope: 1 - normal.y.
# spacing: the samples' spacing; at 56 m (level 2) a 2x2 box average of 28 m sub-samples keeps
# district-scale patchwork intact without aliasing smears, while coarser tiles bake the mean.
field_bake = (p: vec2,height: f32,slope: f32,stands: f32,orchard: f32,spacing: f32,warp: vec2) -> vec4:
    share = field_share(slope,height,stands)
    if share <= 0.01: return vec4(0,0,0,0)
    if spacing > 64.0:
        mean = if orchard > 0.35: vec4(0.1,0.05,0.6,0.25) else: vec4(0.32,0.12,0.1,0.46)
        return mean*0.78*share
    if spacing > 40.0:
        return (_field_sample(p+vec2(-14.0,-14.0),share,orchard,warp)+_field_sample(p+vec2(14.0,-14.0),share,orchard,warp)+_field_sample(p+vec2(-14.0,14.0),share,orchard,warp)+_field_sample(p+vec2(14.0,14.0),share,orchard,warp))*0.25
    _field_sample(p,share,orchard,warp)

# The baked fields' colour: the crop palette by class, the weight carrying its tone. green: the
# palette (1 the green valleys, 0 the dry straw summer).
field_crop_low = (w: vec4,green: f32) -> vec3:
    total = max(w.x+w.y+w.z+w.w,0.001)
    tone = clamp((total-0.55)/0.45,0.0,1.0)
    corn = mix(mix(vec3(0.84,0.75,0.45),vec3(0.75,0.66,0.39),tone),mix(vec3(0.80,0.75,0.44),vec3(0.60,0.71,0.39),tone),green*step(0.45,tone))
    vines = mix(vec3(0.48,0.60,0.34),vec3(0.37,0.52,0.30),tone)
    olives = mix(vec3(0.58,0.63,0.41),vec3(0.48,0.56,0.37),tone)
    pasture = mix(mix(vec3(0.72,0.64,0.38),vec3(0.55,0.60,0.36),tone),mix(vec3(0.49,0.67,0.36),vec3(0.37,0.56,0.34),tone),green)
    (corn*w.x+vines*w.y+olives*w.z+pasture*w.w)/total

# A sample's field colour (rgb) and share (a), as the terrain's working channel holds it on every
# tier: baked on the CPU for the new world's tiles, the old islands' tiles (src/terrain_lod.jo
# island_working) and each grass cell. work: a settlement's working land (crop weights), zero elsewhere.
field_colour = (work: vec4,p: vec2,height: f32,slope: f32,stands: f32,orchard: f32,spacing: f32,warp: vec2,green: f32) -> vec4:
    w = if work == vec4(0,0,0,0): field_bake(p,height,slope,stands,orchard,spacing,warp) else: work
    total = w.x+w.y+w.z+w.w
    if total > 0.001: vec4(field_crop_low(w,green),clamp(total*1.6,0.0,1.0)*0.86) else: vec4(0,0,0,0)
