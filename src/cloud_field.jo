use 'cloud_density.jo'
# Persistent world cells. Identity depends on seed/cell, never camera position or
# render quality. The outer ring fades before cells enter/leave the cache.
use 'cloud_volume.jo'
use 'weather_scene.jo'
use 'world.jo'
use 'geography.jo'
import 'living_conditions.jo' as weather
const CLOUD_CELL = 6500.0
const CLOUD_RANGE = 150000.0
const CLOUD_LOCAL_RANGE = 70000.0
const CLOUD_BANK_CELL = 26000.0
const CLOUD_BANK_CHANCE = 0.22
cloud_bank_x = -999999
cloud_bank_z = -999999
cloud_bank_cache: CloudVolume[]
cloud_field_x = -999999
cloud_field_z = -999999
cloud_field_cache: CloudVolume[]

# A finite multiplicative cascade, with equal-area population per size octave.
# Centres and occupancy share coarse weather structure rather than one grid of
# similarly sized puffs. Every octave is deterministic in world space.
cloud_scale = (level: int) -> f64: 1625.0*pow(4.0,f64(level))
cloud_scale_range = (level: int) -> f64: if level == 0: 16000.0 else: if level == 1: CLOUD_LOCAL_RANGE else: CLOUD_RANGE
cloud_octave = (x: int,z: int,level: int) -> CloudVolume?:
    cell = cloud_scale(level)
    r = rng(701+x*73856093+z*19349663+level*83492791)
    cx = (f64(x)+0.5+(r.next_float()-0.5)*0.78)*cell
    cz = (f64(z)+0.5+(r.next_float()-0.5)*0.78)*cell
    mass = 1.0
    loop octave in 0..4:
        scale = 104000.0/pow(2.0,f64(octave))
        mass *= 0.55+noise(cx/scale+31.0,cz/scale-19.0)*0.9
    if r.next_float() > min(0.65,0.30*mass): return none
    width = cell*0.16*pow(2.7,r.next_float())
    depth = width*(0.65+r.next_float()*0.35)
    # The largest octave usually spreads as banks, but carries occasional deep
    # connected towers too. No arbitrary visibility-dependent reseeding.
    tower = level < 2 or r.next_float() < 0.24
    height = if tower: min(6500.0,width*(0.8+r.next_float()*1.8)) else: 550.0+r.next_float()*1000.0
    base = 650.0+noise(cx/60000.0,cz/60000.0)*300.0
    CloudVolume(vec3(f32(cx),f32(base+height*CLOUD_BASE),f32(cz)),vec3(f32(width),f32(height),f32(depth)),f32(if tower: floor(r.next_float()*2.0) else: 2.0+floor(r.next_float()*2.0)),f32(r.next_float()*TAU),f32(r.next_float()))

cloud_cell = (x: int,z: int) -> CloudVolume?: cloud_octave(x,z,1)
cloud_level_x: int[] = [-999999,-999999,-999999]
cloud_level_z: int[] = [-999999,-999999,-999999]
cloud_level_cache: CloudVolume[][] = [[],[],[]]

# Stable geography-derived heating: sampled once per cell cache build, never
# per fragment/frame. Island groups seed afternoon lines even over nearby water.
cloud_heating = (p: vec2) -> f32:
    heat: f32 = 0.0
    loop isl in ISLANDS:
        heat = max(heat,1.0-smoothstep(f32(isl.radius),f32(isl.radius+6000.0),length(p-isl.center)))
    if geography_enabled:
        loop offset in [vec2(0,0),vec2(-2500,0),vec2(2500,0),vec2(0,-2500),vec2(0,2500)]:
            q = p+offset
            heat = max(heat,f32(smoothstep(0.0,120.0,new_land_base(f64(q.x),f64(q.y)).0)))
    heat

cloud_bank = (x: int,z: int,drift: vec2 = vec2(0,0), heating: bool = true) -> CloudVolume?:
    r = rng(1701+x*73856093+z*19349663)
    if r.next_float() > CLOUD_BANK_CHANCE: return none
    p = vec2(f32((f64(x)+0.5)*CLOUD_BANK_CELL),f32((f64(z)+0.5)*CLOUD_BANK_CELL))
    heat = if heating: cloud_heating(p+drift) else: 0.0
    tone = f32(r.next_float())
    height = 700.0+tone*900.0
    extent = vec3(f32(6500.0+r.next_float()*2200.0),height,f32(3900.0+r.next_float()*1800.0))
    CloudVolume(vec3(p.x,950+height*CLOUD_BASE,p.y),extent,if tone < 0.45: 2.0 else: 3.0, f32(r.next_float()*TAU),tone,thermal=heat)

cloud_evolve = (source: CloudVolume,air: weather.WeatherAir,seconds: f64) -> CloudVolume:
    v = source
    phase = f32(fract(seconds/(1000.0+f64(v.tone)*800.0)+f64(v.tone)))
    rise = smoothstep(0.02,0.38,phase)
    spread = smoothstep(0.55,0.94,phase)
    alive = smoothstep(0.0,0.06,phase)*(1.0-smoothstep(0.92,1.0,phase))
    heating = f32(smoothstep(9.0,15.0,weather_hour_now)*(1.0-smoothstep(17.0,20.0,weather_hour_now)))*v.thermal
    amount = air.cloud+heating*0.22
    v.weather.x = clamp((amount-v.tone*0.42)*4.0,0.0,1.0)*alive*(1.0-smoothstep(0.2,0.75,air.deck))
    tall = smoothstep(0.55,0.95,v.tone)*max(air.towers,heating*0.65)
    v.extent.xz *= 0.65+rise*0.3+spread*0.12
    v.extent.y *= (0.15+rise*0.85)*(1.0-spread*0.62)*(0.95+tall*1.45)
    # Strong heating grows a cauliflower mass, not a vertically stretched needle.
    v.extent.y = min(v.extent.y,6500.0)
    v.extent.x = max(v.extent.x,v.extent.y*0.48)
    v.extent.z = max(v.extent.z,v.extent.y*0.38)
    v.center.y = air.ceiling+v.extent.y*f32(CLOUD_BASE)
    v.weather.y = air.storm
    v.growth = vec4((1.0-rise)*0.075+spread*0.10,f32(seconds*0.005)+v.tone*6.28,0.018*rise,spread*0.035)
    v

world_clouds = (cam: vec3, drift: vec2) -> CloudVolume[]:
    global cloud_level_x,cloud_level_z,cloud_level_cache
    result: CloudVolume[]
    loop level in 0..3:
        cell = cloud_scale(level); reach = cloud_scale_range(level)
        x = int(floor(f64(cam.x-drift.x)/cell)); z = int(floor(f64(cam.z-drift.y)/cell))
        if x != cloud_level_x[level] or z != cloud_level_z[level]:
            cache: CloudVolume[]
            radius = int(ceil(reach/cell))+1
            loop iz in z-radius..z+radius+1:
                loop ix in x-radius..x+radius+1:
                    if let source = cloud_octave(ix,iz,level):
                        v = source; v.thermal = cloud_heating(v.center.xz+drift)
                        cache.push(v)
            cloud_level_cache[level] = cache
            cloud_level_x[level] = x; cloud_level_z[level] = z
        loop source in cloud_level_cache[level]:
            v = source; v.center += vec3(drift.x,0,drift.y)
            distance = length(v.center.xz-cam.xz)
            if distance >= f32(reach): continue
            if weather_active: v = cloud_evolve(v,weather_at_point(v.center),weather_seconds)
            v.weather.x *= 1.0-smoothstep(f32(reach*0.72),f32(reach),distance)
            if v.weather.x >= 0.005: result.push(v)
    if weather_active:
        loop cell in weather_cells:
            # Match the shared field between minute updates, so fronts move
            # continuously instead of jumping once every two play seconds.
            center = cell.center+cell.velocity_milli_m_per_minute*f32((weather_minute_now-floor(weather_minute_now))/1000.0)
            life = weather.weather_weight(cell,weather_minute_now,vec3(center.x,0,center.y))
            if life < 0.005: continue
            radius = f32(cell.radius_m)
            base: f32 = 700.0
            if cell.kind == .overcast or cell.kind == .squall:
                # The same ellipse as the simulation; bounded, climbable deck.
                result.push(CloudVolume(vec3(center.x,base+250.0,center.y),vec3(radius*cell.aspect.x/0.83,500,radius*cell.aspect.y/0.64),4,weather=vec2(life,0.4)))
            if cell.kind == .storm:
                # A dark anvil and rising column at the saved storm center.
                result.push(CloudVolume(vec3(center.x,3000,center.y),vec3(max(4000.0,min(radius,5500.0)),4000,max(3200.0,min(radius,4500.0))),5,weather=vec2(life,1),growth=vec4(0,f32(weather_seconds*0.004)+f32(cell.id),0.025,0.035)))
            if cell.kind == .squall or cell.kind == .storm:
                result.push(CloudVolume(vec3(center.x,base*0.35,center.y),vec3(radius*cell.aspect.x/0.83,base*0.7,radius*cell.aspect.y/0.64),6,weather=vec2(life*f32(cell.severity)/1000.0,1)))
            if cell.kind == .fog:
                result.push(CloudVolume(vec3(center.x,40,center.y),vec3(radius*cell.aspect.x/0.83,100,radius*cell.aspect.y/0.64),7,weather=vec2(life,0)))
    result
