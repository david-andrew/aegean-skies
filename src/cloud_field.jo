use 'look.jo'
use 'world_point.jo'
use 'cloud_density.jo'
# Persistent world cells. Identity depends on seed/cell, never camera position or
# render quality. The outer ring fades before cells enter/leave the cache.
use 'cloud_volume.jo'
use 'weather_scene.jo'
use 'lightning.jo'
use 'world.jo'
use 'geography.jo'
use 'render_space.jo'
import 'living_conditions.jo' as weather
const CLOUD_CELL = 6500.0
const CLOUD_RANGE = 150000.0
const CLOUD_LOCAL_RANGE = 70000.0
cloud_field_x = -999999
cloud_field_z = -999999
cloud_field_cache: CloudVolume[]

# Three size octaves of persistent world cells. A cell places a small group
# (a clump of fair-weather cells, a cloud with satellites, a street) whose
# members share the air mass's condensation level. Occupancy follows a coarse
# clumping cascade and wind-aligned streets, so clouds gather in clusters and
# rows with clear lanes between, as a cumulus field seen from above.
cloud_scale = (level: int) -> f64: 1625.0*pow(4.0,f64(level))
cloud_scale_range = (level: int) -> f64: if level == 0: 13000.0 else: if level == 1: CLOUD_LOCAL_RANGE else: CLOUD_RANGE

# Shape codes: 0 small/flat forms, 1 heaped, 2 towers, 3 masses (5 anvil).
cloud_shape_code = (stamp: int) -> f32:
    kind = cloud_stamp_kind(stamp)
    if kind == CLOUD_CONGESTUS or kind == CLOUD_TWIN: return 2.0
    if kind == CLOUD_MASS: return 3.0
    if kind == CLOUD_ANVIL: return 5.0
    if stamp >= 8: 1.0 else: 0.0

# Uniform scale from the form's own proportions; only the depth varies a little.
cloud_extent = (stamp: int, half_width: f64, depth: f64 = 1.0) -> vec3:
    a = cloud_stamp_aspect(stamp)
    vec3(f32(half_width),f32(half_width*f64(a.y)),f32(half_width*f64(a.z)*depth))

cloud_place = (r: mut Rng, x: f64, z: f64, half_width: f64, stamp: int, tone: f64, heading: f64, alt: int = -1) -> CloudVolume:
    extent = cloud_extent(stamp,half_width,0.9+r.next_float()*0.2)
    base = 650.0+noise(x/60000.0,z/60000.0)*300.0
    mirror: f32 = if r.next_float() < 0.5: -1.0 else: 1.0
    CloudVolume(vec3(f32(x),f32(base+f64(extent.y)*CLOUD_BASE),f32(z)),extent,cloud_shape_code(stamp),f32(heading),f32(tone),stamp=f32(stamp),mirror=mirror,alt=f32(alt))

cloud_pick = (r: mut Rng, kind: int, group_lo: int, group_hi: int) -> int:
    stamps = cloud_stamps_of(kind,group_lo,group_hi)
    stamps[r.next_int(0,stamps.len())]

# Small sizes are common and large ones rare (a power law within each octave).
cloud_size = (r: mut Rng, lo: f64, hi: f64) -> f64: lo*pow(hi/lo,pow(r.next_float(),1.7))

cloud_octave_group = (x: int,z: int,level: int) -> CloudVolume[]:
    result: CloudVolume[]
    cell = cloud_scale(level)
    r = rng(701+x*73856093+z*19349663+level*83492791)
    cx = (f64(x)+0.5+(r.next_float()-0.5)*0.78)*cell
    cz = (f64(z)+0.5+(r.next_float()-0.5)*0.78)*cell
    mass = 1.0
    loop octave in 0..4:
        scale = 104000.0/pow(2.0,f64(octave))
        mass *= 0.55+noise(cx/scale+31.0,cz/scale-19.0)*0.9
    # Streets: rows along the prevailing northerly, a few kilometres apart.
    street = noise(cx/3400.0+7.0,cz/16000.0-3.0)
    chance = min(0.85,(if level == 0: 0.55 else: if level == 1: 0.42 else: 0.30)*mass*(0.3+street*1.4))
    if r.next_float() > chance: return result
    tone = r.next_float()
    heading = (noise(cx/40000.0,cz/40000.0)-0.5)*1.2+(r.next_float()-0.5)*0.8
    if level == 0:
        # A clump of one to four small fair-weather clouds.
        n = 2+r.next_int(0,4)
        loop k in 0..n:
            hw = cloud_size(r,110.0,460.0)
            px = cx+(r.next_float()-0.5)*cell*0.55; pz = cz+(r.next_float()-0.5)*cell*0.7
            kind = if r.next_float() < 0.18: CLOUD_FRACTUS else: if r.next_float() < 0.3: CLOUD_CLUSTER else: CLOUD_HUMILIS
            t = fract(tone+f64(k)*0.137)
            if t > 0.55 and kind == CLOUD_HUMILIS:
                # Some grow into small towers while the air builds them.
                result.push(cloud_place(r,px,pz,hw*1.5,cloud_pick(r,CLOUD_CONGESTUS,4,6),t,heading,cloud_pick(r,CLOUD_HUMILIS,0,2)))
            else:
                result.push(cloud_place(r,px,pz,hw,cloud_pick(r,kind,0,2),t,heading+(r.next_float()-0.5)*1.5))
    if level == 1:
        # A main cloud with satellites. A heaped cell grows into a tower while
        # the air builds towers (cloud_evolve), the higher its tone the sooner.
        if tone > 0.3:
            hw = 1100.0+r.next_float()*1200.0
            tower = cloud_pick(r,if r.next_float() < 0.2: CLOUD_TWIN else: CLOUD_CONGESTUS,4,6)
            heaped = cloud_pick(r,if r.next_float() < 0.3: CLOUD_CLUSTER else: CLOUD_MEDIOCRIS,2,4)
            result.push(cloud_place(r,cx,cz,hw,tower,tone,heading,heaped))
        else:
            hw = cloud_size(r,500.0,1400.0)
            result.push(cloud_place(r,cx,cz,hw,cloud_pick(r,if r.next_float() < 0.4: CLOUD_CLUSTER else: CLOUD_HUMILIS,0,2),tone,heading))
        loop k in 0..r.next_int(0,3):
            ang = r.next_float()*TAU; d = cell*(0.12+r.next_float()*0.15)
            result.push(cloud_place(r,cx+cos(ang)*d,cz+sin(ang)*d,cloud_size(r,220.0,600.0),cloud_pick(r,CLOUD_HUMILIS,0,2),fract(tone*0.5+0.11*f64(k)),heading))
    if level == 2:
        if tone < 0.22:
            # A large mass, or a big congestus, standing over the field.
            hw = cloud_size(r,2600.0,4200.0)
            stamp = if r.next_float() < 0.5: cloud_pick(r,CLOUD_MASS,6,7) else: cloud_pick(r,CLOUD_CONGESTUS,4,6)
            if stamp < 24: hw *= 0.75
            result.push(cloud_place(r,cx,cz,hw,stamp,tone,heading))
        else:
            # A street: heaped cells and clumps in a row along the heading.
            n = 3+r.next_int(0,5)
            along = vec2(f32(sin(heading)),f32(cos(heading)))
            t = -f64(n)*0.5
            loop k in 0..n:
                hw = cloud_size(r,900.0,2600.0)
                kind = if r.next_float() < 0.45: CLOUD_CLUSTER else: if r.next_float() < 0.5: CLOUD_MEDIOCRIS else: CLOUD_HUMILIS
                group_lo = if kind == CLOUD_HUMILIS: 0 else: 2
                stamp = cloud_pick(r,kind,group_lo,group_lo+2)
                side = (r.next_float()-0.5)*hw*1.2
                px = cx+f64(along.x)*t*2200.0+f64(along.y)*side
                pz = cz+f64(along.y)*t*2200.0-f64(along.x)*side
                result.push(cloud_place(r,px,pz,hw,stamp,fract(tone+f64(k)*0.071),heading+(r.next_float()-0.5)*0.6))
                t += 0.7+r.next_float()*0.8
    result

cloud_cell = (x: int,z: int) -> CloudVolume?:
    group = cloud_octave_group(x,z,1)
    if group.len() == 0: return none
    group[0]
cloud_level_x: int[] = [-999999,-999999,-999999]
cloud_level_z: int[] = [-999999,-999999,-999999]
cloud_level_cache: CloudVolume[][] = [[],[],[]]

# Stable geography-derived heating: sampled once per cell cache build, never
# per fragment/frame. Island groups seed afternoon lines even over nearby water.
cloud_heating = (p: vec2) -> f32:
    heat: f32 = 0.0
    loop isl in ISLANDS:
        heat = max(heat,1.0-smoothstep(f32(isl.radius),f32(isl.radius+6000.0),length(p-isl.center)))
    if geography_enabled:
        loop offset in [vec2(0,0),vec2(-2500,0),vec2(2500,0),vec2(0,-2500),vec2(0,2500)]:
            q = p+offset
            heat = max(heat,f32(smoothstep(0.0,120.0,new_land_base(f64(q.x),f64(q.y)).0)))
    heat

# How strongly the air builds this cell into a tower (0.3 and above: a tower).
cloud_tall = (v: CloudVolume,air: weather.WeatherAir) -> f32:
    heating = f32(smoothstep(9.0,15.0,weather_hour_now)*(1.0-smoothstep(17.0,20.0,weather_hour_now)))*v.thermal
    max(air.towers,heating*0.45)*(0.35+0.65*smoothstep(0.3,0.9,v.tone))

# A cell with a tower form: which forms show. Between the two bands the tower
# grows out of the heaped cloud while the heaped one wears away inside it.
const CLOUD_HEAPED_GONE = 0.44
const CLOUD_TOWER_FROM = 0.24
cloud_forms_shown = (v: CloudVolume,air: weather.WeatherAir,known_tall: f32 = -1.0) -> ivec2:
    if v.alt < 0.0: return ivec2(1,0)
    tall = if known_tall >= 0.0: known_tall else: cloud_tall(v,air)
    ivec2(if tall < CLOUD_HEAPED_GONE: 1 else: 0,if tall > CLOUD_TOWER_FROM: 1 else: 0)

# form: 0 the cell's own (a tower if it has one), 1 its heaped form.
cloud_evolve = (source: CloudVolume,air: weather.WeatherAir,seconds: f64,form: int = -1,known_tall: f32 = -1.0) -> CloudVolume:
    v = source
    phase = f32(fract(seconds/(1000.0+f64(v.tone)*800.0)+f64(v.tone)))
    rise = smoothstep(0.02,0.38,phase)
    spread = smoothstep(0.55,0.94,phase)
    alive = smoothstep(0.0,0.06,phase)*(1.0-smoothstep(0.92,1.0,phase))
    heating = f32(smoothstep(9.0,15.0,weather_hour_now)*(1.0-smoothstep(17.0,20.0,weather_hour_now)))*v.thermal
    amount = air.cloud+heating*0.22
    v.weather.x = clamp((amount-v.tone*0.42)*4.0,0.0,1.0)*alive*(1.0-smoothstep(0.2,0.75,air.deck))
    tall = if known_tall >= 0.0: known_tall else: cloud_tall(v,air)
    # A cloud swells and wears away at its own proportions; nothing stretches.
    erosion = (1.0-rise)*0.075+spread*0.10
    if v.alt >= 0.0:
        # A tower stands while the air builds towers; otherwise its cell holds a
        # heaped cloud. In between, the tower rises out of the heaped one.
        heaped = if form >= 0: form == 1 else: tall < (CLOUD_TOWER_FROM+CLOUD_HEAPED_GONE)*0.5
        if heaped:
            depth = v.extent.z/max(v.extent.x*cloud_stamp_aspect(int(v.stamp)).z,1.0)
            v.stamp = v.alt; v.shape = cloud_shape_code(int(v.alt))
            v.extent = cloud_extent(int(v.alt),f64(v.extent.x)*0.62,f64(depth))
            erosion += smoothstep(0.3,CLOUD_HEAPED_GONE,tall)*0.3
        else:
            # The tower rises at its own proportions from inside the heaped
            # cloud: it grows (a wearing-away tower turns to a skeleton of holes).
            g = smoothstep(CLOUD_TOWER_FROM,0.46,tall)
            v.extent *= 0.4+0.6*g
            erosion += (1.0-smoothstep(0.0,0.5,g))*0.3
    v.extent *= 0.72+rise*0.24+spread*0.1
    v.center.y = air.ceiling+v.extent.y*f32(CLOUD_BASE)
    v.weather.y = air.storm
    v.growth = vec4(erosion,f32(seconds*0.005)+v.tone*6.28,0.018*rise,spread*0.035)
    v

# Which clouds the frame needs: those that can be in view (a cone around the
# camera's forward, conservative for the cloud's size and the curved horizon)
# or that can shadow the shadow map. Only these are evolved each frame.
struct CloudCull:
    active: bool = false
    forward: vec3 = vec3(0,0,-1)
    cos_view: f32 = 0.35
    k: vec2 = vec2(0,0)             # the sun projection (cloud_shadow_k)
    shadow: vec2 = vec2(0,0)        # the shadow map's centre (absolute)
    half: f32 = 0.0                 # its half size; 0 without shadows
cloud_cull = CloudCull()

cloud_needed = (c: vec3, radius: f32, cam: vec3) -> bool:
    if not cloud_cull.active: return true
    d = c-cam
    distance = length(d)
    r = radius+distance*distance/(2.0*f32(EARTH_RADIUS))
    if distance < r or dot(d,cloud_cull.forward)+r >= (distance-r)*cloud_cull.cos_view: return true
    if cloud_cull.half <= 0.0: return false
    m = c.xz-cloud_cull.k*c.y-cloud_cull.shadow
    max(abs(m.x),abs(m.y)) <= cloud_cull.half+r*(1.0+length(cloud_cull.k))

# AEGEAN_CLOUD_TIMELAPSE=k runs the clouds' drift and lives k times faster
# (developer clips of moving shadows); the world's clock is unchanged.
cloud_timelapse = to_float(env("AEGEAN_CLOUD_TIMELAPSE") ?? "1") ?? 1.0

cloud_level_air: weather.WeatherAir[][] = [[],[],[]]
cloud_level_air_age: int[][] = [[],[],[]]
cloud_world_calls = 0
world_clouds = (cam: vec3, wind: WorldPoint) -> CloudVolume[]:
    global cloud_level_x,cloud_level_z,cloud_level_cache,cloud_level_air,cloud_level_air_age,cloud_world_calls
    cloud_world_calls += 1
    movement = WorldPoint(wind.x*cloud_timelapse,wind.y,wind.z*cloud_timelapse)
    seconds = weather_seconds*cloud_timelapse
    drift=world_vec(movement).xz
    result: CloudVolume[]
    loop level in 0..3:
        cell = cloud_scale(level); reach = cloud_scale_range(level)
        x = int(floor((f64(cam.x)-movement.x)/cell)); z = int(floor((f64(cam.z)-movement.z)/cell))
        if x != cloud_level_x[level] or z != cloud_level_z[level]:
            cache: CloudVolume[]
            radius = int(ceil(reach/cell))+1
            loop iz in z-radius..z+radius+1:
                loop ix in x-radius..x+radius+1:
                    loop source in cloud_octave_group(ix,iz,level):
                        v = source; v.thermal = cloud_heating(v.center.xz+drift)
                        cache.push(v)
            cloud_level_cache[level] = cache
            cloud_level_air[level] = fill(weather.WeatherAir(),cache.len())
            cloud_level_air_age[level] = fill(-1,cache.len())
            cloud_level_x[level] = x; cloud_level_z[level] = z
        loop k in 0.. and source in cloud_level_cache[level]:
            # (cull on the bare position before copying the record)
            precise = WorldPoint(f64(source.center.x)+movement.x,f64(source.center.y),f64(source.center.z)+movement.z)
            center = world_vec(precise)
            distance = length(center.xz-cam.xz)
            if distance >= f32(reach): continue
            # (a grown cloud is at most 1.06 of its placed size; towers 1.0)
            if not cloud_needed(center,length(source.extent)*1.2+300.0,cam): continue
            v = source
            v.precise = precise; v.center = center
            if weather_active:
                # The air over a cloud changes over minutes: each is looked up
                # again one call in sixteen (in turn), not every frame.
                if cloud_level_air_age[level][k] < 0 or (k+cloud_world_calls)%16 == 0:
                    cloud_level_air[level][k] = weather_at_point(v.center)
                    cloud_level_air_age[level][k] = 0
                air = cloud_level_air[level][k]
                tall = if v.alt >= 0.0: cloud_tall(v,air) else: 0.0
                shown = cloud_forms_shown(v,air,tall)
                if shown.x == 1 and shown.y == 1:
                    # (the heaped form, still wearing away inside the rising tower)
                    h = cloud_evolve(v,air,seconds,1,tall)
                    h.weather.x *= 1.0-smoothstep(f32(reach*0.72),f32(reach),distance)
                    if h.weather.x >= 0.005: result.push(h)
                v = cloud_evolve(v,air,seconds,if shown.y == 1: 0 else: 1,tall)
            v.weather.x *= 1.0-smoothstep(f32(reach*0.72),f32(reach),distance)
            # A cloud a pixel or two wide adds nothing but a full ray march: fade
            # clouds out by apparent size (half width over distance) when culling
            # for a view; their shadows stay with the larger, nearer clouds.
            if cloud_cull.active: v.weather.x *= smoothstep(0.0025,0.005,v.extent.x/max(length(v.center-cam),1.0))
            if v.weather.x >= 0.005: result.push(v)
    if weather_active:
        loop cell in weather_cells:
            # Match the shared field between minute updates, so fronts move
            # continuously instead of jumping once every two play seconds.
            point=weather.weather_center(cell,weather_minute_now)
            center=world_vec(point).xz
            life = weather.weather_weight(cell,weather_minute_now,vec3(center.x,0,center.y))
            if life < 0.005: continue
            radius = f32(cell.radius_m)
            base: f32 = 700.0
            if cell.kind == .overcast or cell.kind == .squall:
                # The same ellipse as the simulation; bounded, climbable deck.
                result.push(CloudVolume(vec3(center.x,base+250.0,center.y),vec3(radius*cell.aspect.x/0.83,500,radius*cell.aspect.y/0.64),4,weather=vec2(life,0.4),precise=point))
            if cell.kind == .storm:
                loop v in storm_system_clouds(cell,point,center,life): result.push(v)
            if cell.kind == .squall or cell.kind == .storm:
                # (a storm's own shafts carry its rain: its veil is thinner)
                result.push(CloudVolume(vec3(center.x,base*0.35,center.y),vec3(radius*cell.aspect.x/0.83,base*0.7,radius*cell.aspect.y/0.64),6,weather=vec2(life*f32(cell.severity)/1000.0*(if cell.kind == .storm: 0.35 else: 1.0),1),precise=point))
            if cell.kind == .storm:
                # Its rain shafts, from the system's base (STORM_BASE) to the sea.
                downwind = f32(atan2(f64(cell.wind_milli_m_per_sec.y),f64(cell.wind_milli_m_per_sec.x)))
                result.push(CloudVolume(vec3(center.x,507.0,center.y),vec3(radius*cell.aspect.x/0.83,860,radius*cell.aspect.y/0.64),8,heading=downwind,weather=vec2(life*f32(cell.severity)/1000.0,1),precise=point))
            if cell.kind == .fog:
                result.push(CloudVolume(vec3(center.x,40,center.y),vec3(radius*cell.aspect.x/0.83,100,radius*cell.aspect.y/0.64),7,weather=vec2(life,0),precise=point))
    # Stratus slivers: thin, flat, faintly lit bands just above the cumulus bases,
    # long along the wind (weather kind 13). The film's cheap device for depth.
    # Fixed in the world on a 50 km grid near the camera; none under a deck or storm.
    amount = if weather_active: clamp(weather_here.cloud*1.3,0.0,1.0)*(1.0-smoothstep(0.2,0.5,max(weather_here.deck,weather_here.storm))) else: 0.5
    if amount > 0.02:
        grid = vec2(f32(round(f64(cam.x)/50000.0)*50000.0),f32(round(f64(cam.z)/50000.0)*50000.0))
        level = (if weather_active: weather_here.ceiling else: 950.0)+350.0
        result.push(CloudVolume(vec3(grid.x,level,grid.y),vec3(60000,70,60000),13,heading=f32(atan2(f64(wind_now.dir.y),f64(wind_now.dir.x))),weather=vec2(amount,0),precise=WorldPoint(f64(grid.x),f64(level),f64(grid.y))))
    result

world_clouds=(cam:vec3,drift:vec2)->CloudVolume[]:world_clouds(cam,WorldPoint(drift.x,0,drift.y))

# The cloud bodies near the camera whose air is rough inside them
# (weather_turbulence): mild in fair cumulus, violent in a thunderstorm.
cloud_weather_bodies = (clouds: CloudVolume[], eye: vec3):
    global weather_bodies
    weather_bodies = []
    at = world_point(eye)
    loop v in clouds:
        if (v.shape >= 4.0 and v.shape != 5.0) or v.weather.x < 0.3: continue
        point = cloud_point(v)
        if length(world_delta(at,point)) > length(v.extent)+3000.0: continue
        weather_bodies.push(WeatherBody(point,v.extent,vec2(cos(v.heading),sin(v.heading)),(0.12+0.88*v.weather.y)*v.weather.x))

# A thunderstorm system (lightning.jo lays it out), drawn as few large pieces:
# - a dark deck from a low base (1150 m) to above the highest an aircraft can
#   climb, without gaps: inside the system there is no clear air to fly in;
# - a shelf cloud, tiered and rolled, along its leading (downwind) edge;
# - four embedded cells at their stages: towers, a mature anvil, a dissipating
#   mass, their tops near 10 km;
# - one wide anvil canopy aloft, spread downwind;
# - (the rain curtains and shafts under it are added by world_clouds).
const STORM_BASE: f32 = 1150.0
storm_system_clouds = (cell: wt.Weather, point: WorldPoint, center: vec2, life: f32) -> CloudVolume[]:
    out: CloudVolume[]
    box = storm_box(cell)
    a = storm_downwind(cell)
    down = vec2(f32(cos(a)),f32(sin(a)))
    at = (offset: vec2) -> WorldPoint: WorldPoint(point.x+f64(offset.x),0,point.z+f64(offset.y))
    # The deck: weather kind 10, a storm's deck (kind 4 without gaps).
    out.push(CloudVolume(vec3(center.x,STORM_BASE+1000.0,center.y),vec3(box.x*1.05,2000,box.y*1.05),10,heading=f32(a),weather=vec2(life,1),precise=point))
    # The canopy (weather kind 11, a painted plate), spread downwind of the cells
    # at the height their tops flatten out.
    lead = down*f32(cell.radius_m)*0.35
    out.push(CloudVolume(vec3(center.x+lead.x,9300,center.y+lead.y),vec3(f32(cell.radius_m)*1.25,900,f32(cell.radius_m)*1.05),11,heading=f32(a),weather=vec2(life,0.6),precise=at(lead)))
    # The cells.
    loop c in storm_cells(cell):
        stamp = if c.stage == 1: 24+cell.id%2 else: if c.stage == 0: 16+(cell.id+int(c.half_width))%7 else: 26+cell.id%2
        extent = cloud_extent(stamp,c.half_width)
        out.push(CloudVolume(vec3(center.x+c.offset.x,STORM_BASE+extent.y*f32(CLOUD_BASE),center.y+c.offset.y),extent,5,heading=f32(a)+f32(c.half_width*0.001),weather=vec2(life,1),growth=vec4(0,f32(weather_seconds*0.004)+f32(cell.id+int(c.half_width)),0.025,0.035),precise=at(c.offset),stamp=f32(stamp)))
    # The shelf cloud: weather kind 9, an analytic tiered roll along the leading
    # edge (its local x runs along the edge, its local -z faces downwind).
    edge = down*(f32(cell.radius_m)*0.82)
    out.push(CloudVolume(vec3(center.x+edge.x,STORM_BASE-150.0,center.y+edge.y),vec3(f32(cell.radius_m)*0.9,650,2600),9,heading=f32(a)+f32(PI*0.5),weather=vec2(life,1),precise=at(edge)))
    out
