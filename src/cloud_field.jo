# Persistent world cells. Identity depends on seed/cell, never camera position or
# render quality. The outer ring fades before cells enter/leave the cache.
use 'cloud_volume.jo'
const CLOUD_CELL = 6500.0
const CLOUD_RANGE = 150000.0
cloud_field_x = -999999
cloud_field_z = -999999
cloud_field_cache: CloudVolume[]

cloud_cell = (x: int, z: int) -> CloudVolume?:
    r = rng(701 + x * 73856093 + z * 19349663)
    # Broad, coherent weather bands with breaks, rather than white noise coverage.
    band = noise(f64(x) * 0.13 + 31.0, f64(z) * 0.11 - 19.0)
    if r.next_float() > 0.25 + band * 0.7: return none
    cx = (f64(x) + 0.5) * CLOUD_CELL + (r.next_float() - 0.5) * 600.0
    cz = (f64(z) + 0.5) * CLOUD_CELL + (r.next_float() - 0.5) * 600.0
    width = 1500.0 + r.next_float() * 800.0
    depth = 1100.0 + r.next_float() * 600.0
    tall = r.next_float() < 0.13
    height = if tall: 1500.0 + r.next_float() * 700.0 else: 460.0 + r.next_float() * 700.0
    base = 650.0 + noise(cx / 60000.0, cz / 60000.0) * 300.0
    # Rotated full boxes fit disjoint horizontal cells, avoiding interpenetrating
    # formation layers. Each stamp's lobes already form a whole bank.
    CloudVolume(vec3(f32(cx), f32(base + height * 0.62), f32(cz)), vec3(f32(width), f32(height), f32(depth)), f32(floor(r.next_float() * 4.0)), f32(r.next_float() * TAU), f32(r.next_float()))

world_clouds = (cam: vec3, drift: vec2) -> CloudVolume[]:
    global cloud_field_x, cloud_field_z, cloud_field_cache
    x = int(floor(f64(cam.x - drift.x) / CLOUD_CELL))
    z = int(floor(f64(cam.z - drift.y) / CLOUD_CELL))
    if x != cloud_field_x or z != cloud_field_z:
        cloud_field_cache.clear()
        radius = int(ceil(CLOUD_RANGE / CLOUD_CELL)) + 1
        loop iz in z - radius..z + radius + 1:
            loop ix in x - radius..x + radius + 1:
                v = cloud_cell(ix, iz)
                if v != none: cloud_field_cache.push(v!)
        cloud_field_x = x; cloud_field_z = z
    result: CloudVolume[]
    loop source in cloud_field_cache:
        v = source
        v.center += vec3(drift.x, 0, drift.y)
        if length(v.center.xz - cam.xz) < f32(CLOUD_RANGE): result.push(v)
    result
