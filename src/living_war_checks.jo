use 'living_types.jo'
use 'living_money.jo'
use 'living_guard.jo'

validate_war = (w: World) -> str:
    if w.war.version<0 or w.war.version>1 or w.war.units.len()>24 or w.war.orders.len()>48 or w.war.contacts.len()>64 or w.war.evidence.len()>128 or w.war.heard.len()>512 or w.war.arrivals.len()>128 or w.war.survivors.len()>64 or w.war.missions.len()>96 or w.war.rescue_receipts.len()>256: return "invalid war dimensions/version"
    if w.war.occupations_total<0 or w.war.prizes_total<0 or w.war.prizes_sold<0 or w.war.prizes_sold>w.war.prizes_total: return "invalid war outcome counters"
    if w.war.convoys_formed<0 or w.war.convoys_delivered<0 or w.war.convoys_delivered>w.war.convoys_formed: return "invalid convoy outcome counters"
    if w.war.scene_tick>w.tick or w.war.scene_checkpoint.len()>32000000: return "invalid physical war checkpoint"
    if w.war.version==0:
        if w.war.units.len()>0 or w.war.orders.len()>0 or w.war.contacts.len()>0: return "uninitialized war orders"
        return ""
    if not w.far.populated: return "war without funded districts"
    if w.war.peace_offers.len()>6: return "unbounded peace offers"
    loop key, r in w.war.peace_offers:
        if key.len()>40 or r.kind!="ceasefire_request" or not r.state_backed or r.country<0 or r.country>=3 or r.other_country<0 or r.other_country>=3 or r.country==r.other_country or not (r.origin in w.far.districts) or r.id<0 or r.id>=w.far.next_news or r.occurred_minute>w.minute: return "invalid signed ceasefire offer"
    if w.war.occupations.len()>24: return "unbounded occupied administrations"
    loop place, o in w.war.occupations:
        if place!=o.place or not (place in w.far.districts) or o.country<0 or o.country>=3 or o.prior<0 or o.prior>=3 or o.unit<0 or o.unit>=w.war.units.len() or o.since>w.minute: return "invalid occupation custody"
    loop id, m in w.war.missions:
        if m.target_journey< -1 or m.target_journey>=w.far.next_journey: return "invalid escort voyage identity"
        if id!=m.id or id<0 or id>=w.war.next_mission or m.country<0 or m.country>=3 or not (m.origin in w.far.districts) or not (m.destination in w.far.districts) or not account_valid(w,m.escrow) or m.carrier< -1 or m.carrier>=w.people.len() or m.reward<=0 or m.paid<0 or m.paid>m.reward or m.posted>w.minute or m.deadline<m.posted or m.last_tick>w.tick or m.progress_ticks<0 or m.required_ticks<1 or m.progress_ticks>m.required_ticks or m.observed_controller< -1 or m.observed_controller>=3 or m.observed_minute>w.minute: return "invalid military commission"
        if m.state==.claimed and m.carrier<0: return "military commission missing carrier"
        if m.state==.open or m.state==.claimed:
            if m.commission>=0 and not (m.commission in w.far.commissions): return "military commission missing consignment"
            if m.kind==.rescue and not (m.target in w.war.survivors): return "military commission missing survivor"
            if m.kind==.escort and (m.target<0 or m.target>=w.far.vehicles.len()): return "military commission missing convoy"
            if m.kind==.reconnaissance and not (m.target in w.far.districts): return "military commission missing observation place"
    previous= -1
    loop r in w.war.rescue_receipts:
        if r.id<=previous or r.id>=w.war.next_rescue_receipt or r.actor<0 or r.actor>=w.people.len() or not (r.place in w.far.districts) or r.country<0 or r.country>=3 or r.people<=0 or r.minute>w.minute: return "invalid rescue delivery receipt"
        previous=r.id
    if w.war.rounds.len()>128: return "unbounded national ordnance"
    seen_rounds: {int: bool}
    loop r in w.war.rounds:
        if not finite_living_point(r.position) or not finite_living_point(r.velocity) or r.age<0 or r.age>3 or r.damage<=0 or r.damage>1 or r.serial<0 or r.serial>=w.war.round_serial or r.serial in seen_rounds: return "invalid national ordnance"
        seen_rounds[r.serial]=true
    used: {int: bool}
    convoy_merchants: {int: bool}
    loop k in 0..w.war.units.len():
        u=w.war.units[k]
        if u.id!=k or u.country<0 or u.country>=3 or not account_valid(w,u.account) or not (u.home in w.far.districts) or u.vehicle< -1 or u.vehicle>=w.far.vehicles.len() or u.craft< -1 or u.craft>=w.aircraft.len() or u.strength<0 or u.letter_enemy< -1 or u.letter_enemy>=3: return "invalid war unit"
        if u.vehicle>=0:
            if u.vehicle in used: return "duplicate requisitioned hull"
            used[u.vehicle]=true
        if let group=u.convoy:
            if u.vehicle<0 or group.merchant<0 or group.merchant>=w.far.vehicles.len() or group.merchant==u.vehicle or group.merchant in convoy_merchants or group.voyage<0 or group.voyage>=w.far.next_journey or group.escort_voyage<0 or group.escort_voyage>=w.far.next_journey or not (group.origin in w.far.districts) or not (group.destination in w.far.districts) or group.formed>w.minute or group.deadline<group.formed or group.fee<0 or not account_valid(w,group.payer) or group.reason.len()>4096: return "invalid convoy agreement"
            convoy_merchants[group.merchant]=true
            if group.escort_voyage in w.far.journeys:
                j=w.far.journeys[group.escort_voyage]
                if j.vehicle!=u.vehicle or j.follow_vehicle!=group.merchant or j.follow_voyage!=group.voyage: return "invalid convoy movement owner"
        if u.order>=0 and (not (u.order in w.war.orders) or w.war.orders[u.order].unit!=k): return "war unit missing order"
    loop id, o in w.war.orders:
        if id!=o.id or id<0 or id>=w.war.next_order or o.unit<0 or o.unit>=w.war.units.len() or o.issuer!=w.war.units[o.unit].country or not (o.target in w.far.districts) or o.route.len()>64 or o.leg<0 or o.leg>o.route.len() or o.issued>w.minute or o.expires<o.issued: return "invalid national order"
        loop link in o.route:
            if link<0 or link>=w.far.links.len(): return "national order missing route"
    loop id, c in w.war.contacts:
        if id!=c.id or id<0 or id>=w.war.next_contact or c.a<0 or c.a>=w.war.units.len() or c.b<0 or c.b>=w.war.units.len() or c.a==c.b or c.probability<0 or c.probability>1000000 or c.started>w.minute or c.resolves<c.started or not finite_living_point(c.pos): return "invalid war contact"
    loop id, e in w.war.evidence:
        if id!=e.news or id<0 or id>=w.far.next_news or not (e.place in w.far.districts) or e.aggressor<0 or e.aggressor>=3 or e.affected<0 or e.affected>=3 or e.aggressor==e.affected or e.minute>w.minute or e.weight<1 or e.weight>150: return "invalid national evidence"
    loop _, s in w.war.survivors:
        if s.unit< -1 or s.unit>=w.war.units.len() or s.vehicle< -1 or s.vehicle>=w.far.vehicles.len() or s.person< -1 or s.person>=w.people.len() or s.riding_vehicle< -1 or s.riding_vehicle>=w.far.vehicles.len() or s.assigned_boat< -1 or s.assigned_boat>=w.far.vehicles.len() or s.riding_craft< -1 or s.riding_craft>=w.aircraft.len() or s.country<0 or s.country>=3 or s.since>w.minute or s.deadline<s.since or not finite_living_point(s.at): return "invalid war survivor"
    ""
