# Main/render-thread-only memo of the pure authoritative 8 m source. Physics
# and parallel chart/source tasks use the pure functions in geography.jo.
use 'geography.jo'
use 'coast_field.jo'

const WORLD_SOURCE_SLOTS = 8192
struct WorldSourcePoint:
    key: int = -1
    h: f64
    ridge: f64

world_source_points: WorldSourcePoint[]
world_source_revision = -1
world_source_misses = 0

world_source_point = (ix: int,iz: int) -> WorldSourcePoint:
    global world_source_points,world_source_revision,world_source_misses
    if world_source_revision != geography_revision:
        world_source_points = [loop i in 0..WORLD_SOURCE_SLOTS: WorldSourcePoint()]
        world_source_revision = geography_revision
    key = (ix+65536)*131072+iz+65536
    slot = (ix*73856093 xor iz*19349663) & (WORLD_SOURCE_SLOTS-1)
    p = world_source_points[slot]
    if p.key == key: return p
    h,ridge = new_land_sample(f64(ix)*8.0,f64(iz)*8.0)
    p = WorldSourcePoint(key,round(h*4096.0)/4096.0,ridge)
    world_source_points[slot] = p
    world_source_misses += 1
    p

world_source_sample = (x: f64,z: f64) -> (f64,f64):
    ix = int(floor(x/8.0)); iz = int(floor(z/8.0))
    u = (x-f64(ix)*8.0)/8.0; v = (z-f64(iz)*8.0)/8.0
    a = world_source_point(ix,iz); b = world_source_point(ix+1,iz)
    c = world_source_point(ix,iz+1); d = world_source_point(ix+1,iz+1)
    (mix(mix(a.h,b.h,u),mix(c.h,d.h,u),v),mix(mix(a.ridge,b.ridge,u),mix(c.ridge,d.ridge,u),v))

world_source_surface = (x: f64,z: f64) -> f64:
    ax = floor(x/14.0)*14.0; az = floor(z/14.0)*14.0
    a = round(world_source_sample(ax,az).0*4096.0)/4096.0
    b = round(world_source_sample(ax+14.0,az).0*4096.0)/4096.0
    c = round(world_source_sample(ax,az+14.0).0*4096.0)/4096.0
    d = round(world_source_sample(ax+14.0,az+14.0).0*4096.0)/4096.0
    u = (x-ax)/14.0; v = (z-az)/14.0
    h = if u+v <= 1.0: a+u*(b-a)+v*(c-a) else: d+(1.0-u)*(c-d)+(1.0-v)*(b-d)
    if coast_weight(f32(h)) > 0.0: coast_contact(a,b,c,d,u,v,ax,az) else: h

# Same 3 m ecology slope footprint as world.jo:slope_at, using the memoized
# authority on new land instead of re-running the pure query for every tree.
world_source_slope = (x: f64,z: f64) -> f64:
    gx = (world_source_sample(x+3.0,z).0-world_source_sample(x-3.0,z).0)/6.0
    gz = (world_source_sample(x,z+3.0).0-world_source_sample(x,z-3.0).0)/6.0
    sqrt(gx*gx+gz*gz)
