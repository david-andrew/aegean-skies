# Arsenal work is a paid conversion of existing workshop inputs, not an encounter-spawned
# gun or reinforcement. The treasury funds workers; parts and fuel lose their original roots
# through the same production ledger used by every other far-world industry.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_stock.jo'
use 'living_money.jo'
use 'living_far_news.jo'
use 'living_guard.jo'
use 'living_transaction.jo'

war_industry_minute = (w: mut World):
    if not w.far.populated or w.minute%360!=0: return
    bases: {int: int}
    loop c in w.countries:
        place=if c.capital_id>=0: c.capital_id else: c.seat
        if place>=0: bases[place]=c.id
    loop u in w.war.units:
        if not u.retired: bases[u.home]=u.country
    ids=bases.keys(); ids.sort()
    loop place in ids:
        if not (place in w.far.districts): continue
        country=bases[place]; d=w.far.districts[place]
        if d.controller!=country or d.workers[country]<3 or far_market_qty(w,place,8)>=2000: continue
        # 15kg of machined parts + furnace fuel -> 15kg of arms/ammunition. Finite
        # private parts output already consumed its finite ore, wages and source inputs.
        if far_market_qty(w,place,5)<1500 or far_market_qty(w,place,4)<100 or w.accounts[w.far.treasury[country]].cents<300: continue
        key="far:{place}:8:false"; root=w.cargo_source_keys.get(key,-1)
        if d.core<0 and not (root in d.stock.roots) and d.stock.roots.len()>=FAR_MAX_STOCK_ROOTS: continue
        if not transfer(w,w.far.treasury[country],d.household_account,300,.wage,place): continue
        parts=far_take_market(w,place,5,1500); fuel=far_take_market(w,place,4,100)
        far_use(w,parts); far_use(w,fuel)
        if not far_produce(w,place,8,1000): living_fault("war.arsenal_output",guard_context(w)+" place={place}"); return
        far_local_news(w,place,"arsenal","The workshop at {w.place_contexts[place].name} filled a paid government order using its actual parts and furnace fuel.",country=country,severity=180)
