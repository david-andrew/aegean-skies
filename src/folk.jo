# People, as they look: chunky low-poly figures (a body, a head, a hat, arms and legs that swing as
# they walk), dressed from a seed: fishermen in caps and striped shirts, merchants in suits and
# boaters, pilots in leather jackets and goggles, policemen in blue, women in dresses and
# headscarves, old women in black.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'

enum Dress:
    fisher
    merchant
    pilot
    police
    dress           # a woman in a dress
    widow           # an old woman in black
    worker          # overalls (mechanics, dockers)

struct Figure:
    torso: Mesh
    head: Mesh
    arm: Mesh
    leg: Mesh
    height: f32                     # scale
    resting_leg: Mesh
    resting_torso: Mesh
    upper: Mesh                     # (the arm in two, for a bent elbow: shoulder to elbow,
    fore: Mesh                      # and elbow to hand, each hanging from its joint at 0)
    back = f32(0.21)                # how far the back stands behind the spine (unscaled), for
                                    # whatever hangs down it (the pilot's scarf)

SKIN = [rgb(0.96, 0.8, 0.68), rgb(0.88, 0.68, 0.52), rgb(0.74, 0.54, 0.4), rgb(0.95, 0.78, 0.7)]
HAIR = [rgb(0.15, 0.1, 0.08), rgb(0.35, 0.2, 0.1), rgb(0.6, 0.35, 0.15), rgb(0.55, 0.5, 0.45), rgb(0.85, 0.82, 0.78)]

_pick = (xs: vec4[], k: int) -> vec4: xs[k % xs.len()]

# the player's pilot: a dark brown handlebar
PILOT_MUSTACHE = rgb(0.2, 0.12, 0.07)

# Mustaches: none, a handlebar (full, with upturned curled tips), a walrus (heavy, drooping over the
# mouth) or a neat chevron. Some grown men wear one, chosen from the seed; grey or white on the old.
enum Mustache: none, handlebar, walrus, chevron

mustache_of = (dress: Dress, seed: int, age: int = -1) -> Mustache:
    if dress == .dress or dress == .widow or (age >= 0 and age < 20): return .none
    r = seed * 7919 + 13
    if (r / 37) % 100 >= 38: return .none
    [Mustache.handlebar, Mustache.walrus, Mustache.chevron][(r / 41) % 3]

# the mustache's colour: the hair's, greying with age
mustache_color = (hair: vec4, age: int) -> vec4:
    if age >= 68: return rgb(0.74, 0.72, 0.68)
    if age >= 55: return mix(hair, rgb(0.62, 0.6, 0.57), 0.7)
    hair

# one side of a mustache (side +1 or -1) as a chain of flattened lobes over the face's curve:
# each point is (across, height, thickness), across and height on the face, which faces -z
_mustache_chain = (h: mut Vertex3D[], pts: vec3[], side: f64, col: vec4, overlap: f64 = 1.35):
    centre = vec3(0, 1.7, 0)
    on_face = (q: vec3) -> vec3:
        dy = f64(q.y) - 1.7
        depth = sqrt(max(0.0289 - f64(q.x * q.x) - dy * dy, 0.0064))
        vec3(f32(f64(q.x) * side), q.y, f32(-depth - 0.006 - f64(q.z) * 0.45))
    loop k in 0..pts.len() - 1:
        a = on_face(pts[k]); b = on_face(pts[k + 1])
        mid = (a + b) * 0.5
        out = normalize(mid - centre)
        half = f64(length(b - a)) * 0.5
        thick = f64(pts[k].z + pts[k + 1].z) * 0.5
        add_sphere(h, vec3(0, 0, 0), 1.0, col, 6, 4, translation(mid) * facing(b - a, out) * scaling(vec3(f32(thick * 0.5), f32(thick * 0.36), f32(half * overlap))))

add_mustache = (h: mut Vertex3D[], style: Mustache, col: vec4):
    pts: vec3[] = match style:
        .handlebar: [vec3(0, 1.645, 0.05), vec3(0.045, 1.64, 0.062), vec3(0.09, 1.632, 0.058), vec3(0.128, 1.636, 0.046), vec3(0.158, 1.652, 0.035), vec3(0.177, 1.676, 0.027), vec3(0.179, 1.702, 0.021), vec3(0.164, 1.717, 0.017)]
        .walrus: [vec3(0, 1.645, 0.07), vec3(0.06, 1.634, 0.078), vec3(0.105, 1.6, 0.062), vec3(0.122, 1.562, 0.044)]
        .chevron: [vec3(0, 1.642, 0.044), vec3(0.048, 1.636, 0.044), vec3(0.088, 1.624, 0.034)]
        _: []
    if pts.len() == 0: return
    loop side in [-1.0, 1.0]:
        _mustache_chain(h, pts, side, col, if style == .walrus: 1.75 else: if style == .chevron: 1.5 else: 1.35)
        # (and brows to match, a little heavier on the handlebar)
        brow = if style == .handlebar: 0.026 else: 0.02
        add_box(h, vec3(0, 0, 0), vec3(0.078, f32(brow), 0.022), col, translation(vec3(f32(side * 0.064), 1.768, -0.152)) * rotation_z(side * -0.12))

# ---------------- what people wear ----------------
# Clothes of the 1920s-30s Mediterranean, by trade and standing (src/wardrobe.jo chooses them for
# the town's people): mostly pale and neutral, a clear colour now and then, and hats as the crowd's
# texture. Built once into each person's figure (no extra draws).

enum Garb: coat, shirtsleeves, waistcoat, overalls, cassock, jersey, dress, blouse, flight, tunic, whites

# hat kinds: 0 none, 1 flat cap, 2 boater, 3 flying helmet, 4 kepi, 5 headscarf, 6 fedora,
# 7 cloche, 8 wide straw hat, 9 priest's round hat
struct Outfit:
    garb: Garb = .coat
    top: vec4 = vec4(0.6, 0.58, 0.54, 1)      # the jacket, waistcoat, jersey, overalls, dress
    under: vec4 = vec4(0.88, 0.86, 0.8, 1)    # the shirt or blouse beneath (and rolled sleeves)
    legs: vec4 = vec4(0.32, 0.31, 0.3, 1)     # trousers, or the skirt of a blouse and skirt
    hat_kind = 0
    hat: vec4 = vec4(0.3, 0.28, 0.25, 1)
    band: vec4 = vec4(0, 0, 0, 0)             # (a hat's band, when it has one)
    apron: vec4 = vec4(0, 0, 0, 0)            # an apron, when worn (w 1)
    long_apron = false                        # (to the shin, the waiter's and the barkeep's)
    tie: vec4 = vec4(0, 0, 0, 0)
    scarf: vec4 = vec4(0, 0, 0, 0)            # (round the neck: the pilot's white one)
    stripes: vec4 = vec4(0, 0, 0, 0)          # (a jersey's bands)
    sash: vec4 = vec4(0, 0, 0, 0)             # (a dress's low waist: the drop-waist frock's sash)
    rolled = false                            # sleeves rolled to the elbow
    long_skirt = false                        # to the ankle (older women, the cassock)
    stockings: vec4 = vec4(0.66, 0.56, 0.47, 1)     # (tan, below a hem above the ankle)
    shoes: vec4 = vec4(0.2, 0.15, 0.12, 1)
    bald = false                              # (the helmet's wearer: the hair sinks into the collar)
    shorts = false                            # (a boy's: bare knees, socks)
    bib = false                               # (the apron has a bib: a girl's pinafore)
    socks: vec4 = vec4(0.3, 0.29, 0.28, 1)

_skirted = (o: Outfit) -> bool: o.garb == .dress or o.garb == .blouse or o.garb == .cassock

# What the old dress kinds wear now (for those not dressed by the wardrobe: the player's pilot,
# the band's stand-ins, the children, swimmers): the same roles, in the muted period palette.
dress_outfit = (dress: Dress, seed: int, age: int = -1) -> Outfit:
    r = seed * 7919 + 13
    match dress:
        .fisher: Outfit(.jersey, _pick([rgb(0.27, 0.32, 0.45), rgb(0.62, 0.6, 0.55), rgb(0.45, 0.4, 0.34), rgb(0.42, 0.46, 0.4)], r / 7), legs = _pick([rgb(0.36, 0.32, 0.27), rgb(0.27, 0.29, 0.36)], r / 11), hat_kind = 1, hat = _pick([rgb(0.22, 0.23, 0.28), rgb(0.42, 0.33, 0.25)], r / 13), stripes = rgb(0.86, 0.85, 0.8), rolled = true)
        .merchant: Outfit(.coat, _pick([rgb(0.8, 0.77, 0.69), rgb(0.36, 0.34, 0.31), rgb(0.55, 0.49, 0.42)], r / 7), legs = _pick([rgb(0.8, 0.77, 0.69), rgb(0.36, 0.34, 0.31), rgb(0.55, 0.49, 0.42)], r / 7), hat_kind = if (r / 17) % 2 == 0: 2 else: 6, hat = if (r / 17) % 2 == 0: rgb(0.86, 0.8, 0.6) else: rgb(0.4, 0.35, 0.3), band = rgb(0.25, 0.22, 0.2), tie = rgb(0.45, 0.2, 0.18))
        .pilot: Outfit(.flight, _pick([rgb(0.45, 0.32, 0.22), rgb(0.58, 0.5, 0.38), rgb(0.25, 0.27, 0.32)], r / 7), legs = rgb(0.52, 0.47, 0.37), hat_kind = 3, hat = rgb(0.4, 0.29, 0.19), scarf = rgb(0.94, 0.93, 0.89), bald = true)
        .police: Outfit(.tunic, rgb(0.18, 0.22, 0.34), legs = rgb(0.18, 0.22, 0.34), hat_kind = 4, hat = rgb(0.14, 0.17, 0.28), tie = rgb(0.12, 0.12, 0.14))
        .dress: Outfit(.dress, _pick([rgb(0.82, 0.7, 0.68), rgb(0.64, 0.72, 0.8), rgb(0.86, 0.8, 0.6), rgb(0.6, 0.66, 0.54), rgb(0.6, 0.53, 0.66), rgb(0.2, 0.22, 0.3)], r / 7), hat_kind = if (r / 19) % 3 == 0: 7 else: 0, hat = rgb(0.5, 0.42, 0.36))
        .widow: Outfit(.dress, rgb(0.13, 0.13, 0.14), hat_kind = 5, hat = rgb(0.11, 0.11, 0.12), long_skirt = true, stockings = rgb(0.15, 0.15, 0.16))
        .worker: Outfit(.overalls, rgb(0.34, 0.4, 0.48), under = rgb(0.78, 0.76, 0.7), legs = rgb(0.34, 0.4, 0.48), hat_kind = if (r / 23) % 2 == 0: 1 else: 0, hat = rgb(0.3, 0.3, 0.32), rolled = true)

build_figure = (dress: Dress, seed: int, age: int = -1, mustache: int = -1, mustache_tint: vec4 = vec4(0, 0, 0, 0),bathing:bool=false) -> Figure:
    build_outfit_figure(dress_outfit(dress, seed, age), seed, age, mustache, mustache_tint, bathing)

build_outfit_figure = (o: Outfit, seed: int, age: int = -1, mustache: int = -1, mustache_tint: vec4 = vec4(0, 0, 0, 0),bathing:bool=false) -> Figure:
    r = seed * 7919 + 13
    skin = _pick(SKIN, r / 3)
    hair = _pick(HAIR, r / 5)
    # (where the age is known: no grey heads on the young, no dark ones on the old)
    if age >= 0 and age < 45: hair = _pick(HAIR[0..3], r / 5)
    if age >= 62: hair = _pick(HAIR[3..5], r / 5)
    skirt = _skirted(o) and not bathing
    # what each part shows: the body's front, the arms (sleeve, and below a rolled one, skin)
    body = if o.garb == .shirtsleeves or o.garb == .blouse: o.under else: o.top
    sleeve = if o.garb == .shirtsleeves or o.garb == .waistcoat or o.garb == .overalls or o.garb == .blouse: o.under else: o.top
    lower_arm = if o.rolled and not bathing: skin else: sleeve
    trousers = if o.garb == .overalls: o.top else: o.legs
    skirt_col = if o.garb == .blouse: o.legs else: o.top
    hat_kind = o.hat_kind
    if bathing:
        body = skin; sleeve = skin; lower_arm = skin; trousers = rgb(0.19,0.25,0.32); hat_kind = 0
    # the body: hips at y = 0.95, shoulders at 1.45; a bigger belly on some
    belly = f32(0.18 + f64((r / 29) % 4) * 0.025)
    t: Vertex3D[]
    add_box(t, vec3(0, 1.2, 0), vec3(0.5, 0.55, belly * 2.0 + 0.06), body)
    add_box(t, vec3(0, 1.43, 0), vec3(0.56, 0.1, 0.3), body)
    front = -belly - 0.03
    if not bathing:
        match o.garb:
            .coat, .tunic:
                # (the shirt's collar in the coat's opening)
                add_box(t, vec3(0, 1.425, f32(front - 0.004)), vec3(0.1, 0.07, 0.02), o.under)
                add_box(t, vec3(0, 1.36, f32(front - 0.002)), vec3(0.05, 0.08, 0.02), o.under)
            .waistcoat:
                # (the waistcoat over the shirt: its front and back, the shirt's sleeves)
                add_box(t, vec3(0, 1.17, 0), vec3(0.52, 0.42, belly * 2.0 + 0.08), o.top)
                add_box(t, vec3(0, 1.36, f32(front - 0.012)), vec3(0.07, 0.14, 0.02), o.under)
            .overalls:
                # (the bib and its straps over the shirt)
                add_box(t, vec3(0, 1.12, f32(front - 0.004)), vec3(0.34, 0.36, 0.02), o.top)
                loop sd in [-1.0, 1.0]: add_box(t, vec3(f32(sd * 0.12), 1.36, 0), vec3(0.06, 0.16, belly * 2.0 + 0.09), o.top)
            else: pass
        if o.garb == .tunic: add_box(t, vec3(0, 1.0, 0), vec3(0.52, 0.06, belly * 2.0 + 0.08), rgb(0.12, 0.1, 0.09))   # a belt
        if o.stripes.w > 0.0:
            loop k in 0..3: add_box(t, vec3(0, f32(1.05 + f64(k) * 0.14), 0), vec3(0.51, 0.04, belly * 2.0 + 0.07), o.stripes)
        if o.scarf.w > 0.0:
            add_box(t, vec3(0, 1.42, -0.05), vec3(0.3, 0.06, 0.3), o.scarf)        # a white scarf,
            add_cylinder(t, vec3(0, 1.565, 0), 0.158, 0.07, o.scarf, 12, 0.145)  # wrapped round the neck, where the head meets the helmet's roll
        if o.tie.w > 0.0:
            add_box(t, vec3(0, 1.3, f32(-belly - 0.012)), vec3(0.06, 0.22, 0.02), o.tie)              # a tie
    rest_t=t
    if skirt:
        add_box(rest_t,vec3(0,0.84,-0.18),vec3(0.60,0.30,0.65),skirt_col)
        add_box(rest_t,vec3(0,if o.long_skirt: 0.5 else: 0.60,-0.46),vec3(0.56,if o.long_skirt: 0.56 else: 0.36,0.09),skirt_col)
    if skirt:
        # (a flared skirt from the waist to a hem above the ankle, or to the ankle for the long one:
        # a different silhouette from trousers at twenty or forty metres)
        if o.long_skirt: add_cylinder(t, vec3(0, 0.09, 0), 0.37, 0.88, skirt_col, 10, 0.2)
        else: add_cylinder(t, vec3(0, 0.2, 0), 0.36, 0.77, skirt_col, 10, 0.2)
    else: add_box(t, vec3(0, 0.88, 0), vec3(0.38, 0.16, 0.24), trousers)
    if o.sash.w > 0.0 and skirt:
        # (the drop waist: a sash low on the hips, where the skirt begins)
        add_box(t, vec3(0, 0.9, 0), vec3(0.54, 0.07, belly * 2.0 + 0.1), o.sash)
    if o.apron.w > 0.0 and not bathing:
        # (an apron from the waist: to the knee, or the long one to the shin)
        top_y = 1.05
        bottom = if o.long_apron: 0.32 else: 0.62
        add_box(t, vec3(0, f32((top_y + bottom) * 0.5), f32(front - (if skirt: 0.12 else: 0.02))), vec3(0.4, f32(top_y - bottom), 0.02), o.apron)
        add_box(rest_t, vec3(0, 0.86, f32(front - 0.02)), vec3(0.4, 0.26, 0.02), o.apron)
        if o.bib:
            # (a pinafore's bib and straps over the frock)
            add_box(t, vec3(0, 1.2, f32(front - 0.006)), vec3(0.3, 0.3, 0.02), o.apron)
            loop sd in [-1.0, 1.0]: add_box(t, vec3(f32(sd * 0.13), 1.4, 0), vec3(0.06, 0.08, belly * 2.0 + 0.09), o.apron)
    h: Vertex3D[]
    add_box(h, vec3(0, 1.53, 0), vec3(0.1, 0.08, 0.1), skin)                          # the neck
    add_sphere(h, vec3(0, 1.7, 0), 0.17, skin, 8, 5)
    add_box(h, vec3(-0.06, 1.73, -0.155), vec3(0.03, 0.035, 0.02), rgb(0.1, 0.08, 0.08))
    add_box(h, vec3(0.06, 1.73, -0.155), vec3(0.03, 0.035, 0.02), rgb(0.1, 0.08, 0.08))
    add_sphere(h, vec3(0, 1.67, -0.16), 0.045, skin, 5, 3)                             # the nose
    # (each scaled about its own center, not the feet: the hair on the head, the helmet over it)
    # (pilots keep their bald heads: the hair, scaled about the feet, sinks into the collar)
    if o.bald: add_sphere(h, vec3(0, 1.76, 0.03), 0.172, hair, 8, 4, scaling(vec3(1.0, 0.7, 1.05)))
    else: add_sphere(h, vec3(0, 0, 0), 0.172, hair, 8, 4, translation(vec3(0, 1.76, 0.03)) * scaling(vec3(1.0, 0.7, 1.05)))
    hat = o.hat
    match hat_kind:
        1:
            add_cylinder(h, vec3(0, 1.78, 0.01), 0.16, 0.1, hat, 8)
            add_box(h, vec3(0, 1.8, -0.15), vec3(0.22, 0.02, 0.12), hat)
        2:
            add_cylinder(h, vec3(0, 1.79, 0), 0.28, 0.02, hat, 10)
            add_cylinder(h, vec3(0, 1.79, 0), 0.16, 0.1, hat, 10)
            add_cylinder(h, vec3(0, 1.84, 0), 0.165, 0.025, if o.band.w > 0.0: o.band else: rgb(0.55, 0.2, 0.18), 10)
        3:
            # (the flying helmet worn low, a leather roll round the neck that makes him look stout,
            # the goggles up on the bald head)
            add_sphere(h, vec3(0, 1.75, 0.02), 0.19, hat, 8, 5, scaling(vec3(1.0, 0.85, 1.05)))
            add_box(h, vec3(0, 1.82, -0.15), vec3(0.26, 0.06, 0.04), rgb(0.25, 0.25, 0.25))
            add_sphere(h, vec3(-0.06, 1.83, -0.17), 0.04, rgb(0.6, 0.8, 0.85), 5, 3)
            add_sphere(h, vec3(0.06, 1.83, -0.17), 0.04, rgb(0.6, 0.8, 0.85), 5, 3)
        4:
            add_cylinder(h, vec3(0, 1.76, 0), 0.155, 0.16, hat, 8)
            add_box(h, vec3(0, 1.78, -0.15), vec3(0.2, 0.02, 0.1), rgb(0.1, 0.1, 0.1))
        5:
            add_sphere(h, vec3(0, 0, 0), 0.175, hat, 8, 5, translation(vec3(0, 1.72, 0.02)) * scaling(vec3(1.0, 1.0, 1.05)))
        6:
            add_cylinder(h, vec3(0, 1.78, 0), 0.25, 0.02, hat, 10)
            add_cylinder(h, vec3(0, 1.78, 0), 0.15, 0.14, hat, 10, 0.13)
            if o.band.w > 0.0: add_cylinder(h, vec3(0, 1.8, 0), 0.153, 0.03, o.band, 10)
        7:
            # (a cloche: close round the head, a narrow brim turned down)
            add_sphere(h, vec3(0, 0, 0), 0.185, hat, 8, 4, translation(vec3(0, 1.77, 0.01)) * scaling(vec3(1.0, 0.72, 1.04)))
            add_cylinder(h, vec3(0, 1.69, 0.01), 0.2, 0.03, hat, 10, 0.19)
        8:
            # (a wide straw hat for the fields)
            add_cylinder(h, vec3(0, 1.79, 0), 0.34, 0.02, hat, 10)
            add_cylinder(h, vec3(0, 1.79, 0), 0.15, 0.12, hat, 10, 0.12)
        9:
            # (a priest's round hat: a wide flat brim, a low round crown)
            add_cylinder(h, vec3(0, 1.8, 0), 0.3, 0.025, hat, 12)
            add_sphere(h, vec3(0, 0, 0), 0.15, hat, 8, 4, translation(vec3(0, 1.83, 0)) * scaling(vec3(1.0, 0.55, 1.0)))
        _: pass
    # (mustache -1: from the seed; otherwise the style asked for)
    style = if mustache < 0: (if skirt: Mustache.none else: mustache_of(.merchant, seed, age)) else: [Mustache.none, Mustache.handlebar, Mustache.walrus, Mustache.chevron][mustache % 4]
    add_mustache(h, style, if mustache_tint.w > 0.0: mustache_tint else: mustache_color(hair, age))
    a: Vertex3D[]
    add_box(a, vec3(0, -0.14, 0), vec3(0.13, 0.28, 0.14), sleeve)                     # (hangs from the shoulder at 0)
    add_box(a, vec3(0, -0.42, 0), vec3(0.125, 0.28, 0.135), lower_arm)
    add_sphere(a, vec3(0, -0.6, 0), 0.06, skin, 5, 3)
    ua: Vertex3D[]
    add_box(ua, vec3(0, -0.155, 0), vec3(0.13, 0.31, 0.14), sleeve)
    fa: Vertex3D[]
    add_box(fa, vec3(0, -0.13, 0), vec3(0.12, 0.29, 0.13), lower_arm)
    add_sphere(fa, vec3(0, -0.3, 0), 0.06, skin, 5, 3)
    l: Vertex3D[]
    if o.shorts and not skirt and not bathing:
        # (short trousers to the knee, bare shins, socks)
        add_box(l, vec3(0, -0.17, 0), vec3(0.18, 0.34, 0.19), trousers)
        add_box(l, vec3(0, -0.5, 0), vec3(0.15, 0.32, 0.16), skin)
        add_box(l, vec3(0, -0.74, 0), vec3(0.155, 0.16, 0.165), o.socks)
    else: add_box(l, vec3(0, -0.42, 0), vec3(0.17, 0.84, 0.18), if skirt: o.stockings else: trousers)
    add_box(l, vec3(0, -0.86, -0.04), vec3(0.15, 0.08, 0.24), o.shoes)
    rest: Vertex3D[]
    leg_color=if bathing:skin else:if skirt: o.stockings else: trousers
    add_box(rest,vec3(0,0,-0.20),vec3(0.17,0.18,0.44),leg_color)
    add_box(rest,vec3(0,-0.25,-0.40),vec3(0.16,0.50,0.17),if o.shorts and not skirt and not bathing: skin else: leg_color)
    add_box(rest,vec3(0,-0.54,-0.46),vec3(0.15,0.08,0.24),if bathing:skin else:o.shoes)
    s = f32(0.92 + f64((r / 31) % 5) * 0.035)
    torso=custom_mesh(t)
    Figure(torso, custom_mesh(h), custom_mesh(a), custom_mesh(l), s,custom_mesh(rest),if skirt: custom_mesh(rest_t) else: torso, custom_mesh(ua), custom_mesh(fa), belly + 0.03)

# a figure standing at pos, facing yaw (turned as the world's rotation_y), mid-stride at phase
# (radians; the legs swing with it), stride 0..1 (how much they swing: 0 standing)
# (arms: each arm's swing from the shoulder, left then right, in place of the posture's or the
# walk's: a gesture, a glass, a fish shown off, a bucket by its handle; below -5: their own)
draw_figure = (f: Figure, pos: vec3, yaw: f64, phase: f64, stride: f64, L: Light, t: f64, wave: f64 = 0.0, carrying: bool = false, cycling: bool = false, performing: bool = false, offset: vec3 = vec3(0,0,0),posture: int = 0,lean: f64 = 0.0,arms: vec2 = vec2(-9,-9),bounce: f64 = 0.0,spread: f64 = 0.0,elbows: vec2 = vec2(0,0),reach: f64 = 0.0,twist: f64 = 0.0):
    draw_figure_at(f, translation(pos) * rotation_y(yaw + PI), phase, stride, L, t, wave, carrying=carrying,cycling=cycling,performing=performing,offset=offset,posture=posture,lean=lean,arms=arms,bounce=bounce,spread=spread,elbows=elbows,reach=reach,twist=twist)

# Where the hand at the end of an arm is, in the figure's own frame (unscaled), as drawn above for
# a standing (posture 0) or seated (posture 1) figure: for things held in it.
figure_hand_local = (f: Figure, posture: int, angle: f64, side: f64, spread: f64, bend: f64 = 0.0, reach: f64 = 0.0, twist: f64 = 0.0) -> vec3:
    drop = if posture == 1: 0.58 / f64(f.height) - 0.86 else: 0.0
    arm = translation(vec3(f32(side * 0.32), f32(1.43 + drop), 0)) * rotation_x(angle) * rotation_z(side * (0.18 + spread) - (if side > 0.0: reach else: 0.0))
    if bend != 0.0: transform_point(arm * translation(vec3(0, -0.3, 0)) * rotation_y(if side > 0.0: twist else: 0.0) * rotation_x(bend), vec3(0, -0.3, 0))
    else: transform_point(arm, vec3(0, -0.6, 0))

# (posture 5) a swimmer: the body tipped forward about the hips by `lean` radians (1.35 lies along
# the water, a little less treads it upright), the arms turning over in a crawl at `phase`, the legs
# kicking; stride 0..1 is the effort (0 treading water: the arms scull instead)
_draw_swimmer = (f: Figure, base: mat4, phase: f64, effort: f64, L: Light, t: f64, lean: f64):
    body = base * translation(vec3(0, 0.9, 0)) * rotation_x(-lean) * translation(vec3(0, -0.9, 0))
    draw(obj_sh, f.torso, obj_local_params(L, t, body))
    draw(obj_sh, f.head, obj_local_params(L, t, body))
    loop side in [-1.0, 1.0]:
        kick = sin(phase * 2.0 + side * 1.6) * (0.15 + 0.25 * effort)
        leg = body * translation(vec3(f32(side * 0.12), 0.86, 0)) * rotation_x(kick)
        draw(obj_sh, f.leg, obj_local_params(L, t, leg))
        # (a crawl: each arm goes right over, forward above the head and back through the water, the two
        # half a turn apart; treading, a slow scull)
        angle = if effort > 0.05: -phase + (if side > 0.0: 0.0 else: PI) else: 1.3 + sin(t * 1.7 + side) * 0.35
        arm = body * translation(vec3(f32(side * 0.32), 1.43, 0)) * rotation_x(angle) * rotation_z(side * (if effort > 0.05: 0.12 else: 0.5))
        draw(obj_sh, f.arm, obj_local_params(L, t, arm))

# (posture 6) lying on one's back on the ground, hands on the chest, looking up: the body laid
# back about the hips, its feet toward where the figure faced
_draw_lying_back = (f: Figure, base: mat4, L: Light, t: f64):
    body = base * translation(vec3(0, 0.16, 0)) * rotation_x(1.5) * translation(vec3(0, -0.9, 0))
    draw(obj_sh, f.torso, obj_local_params(L, t, body))
    draw(obj_sh, f.head, obj_local_params(L, t, body))
    loop side in [-1.0, 1.0]:
        leg = body * translation(vec3(f32(side * 0.12), 0.86, 0)) * rotation_x(side * 0.06)
        draw(obj_sh, f.leg, obj_local_params(L, t, leg))
        arm = body * translation(vec3(f32(side * 0.32), 1.43, 0)) * rotation_x(0.35 + sin(t * 0.4 + side) * 0.02) * rotation_z(side * -0.35)
        draw(obj_sh, f.arm, obj_local_params(L, t, arm))

# Where a standing figure's hand is (side -1 left, 1 right), as a transform in the render's own
# space (as draw_figure places an arm given its angle: opened out 0.18), its arm swung by `angle`;
# the palm at its origin.
figure_hand = (f: Figure, pos: vec3, yaw: f64, phase: f64, stride: f64, side: f64, angle: f64, offset: vec3 = vec3(0,0,0)) -> mat4:
    base = render_model(translation(pos) * rotation_y(yaw + PI),render_origin(scene_camera()))
    base[3] += vec4(offset,0)
    base = base * scaling(f64(f.height))
    bob = abs(sin(phase)) * 0.03 * stride
    base * translation(vec3(f32(side * 0.32), f32(1.43 + bob), 0)) * rotation_x(angle) * rotation_z(side * 0.18) * translation(vec3(0, -0.6, 0))

# where the torso (and the head on it) is, in the figure's own scaled frame: bobbing a little as
# it walks, lower when sitting, leaning in some postures. Whatever is worn on the torso (the pilot's
# scarf) goes on by the same transform.
figure_pose = (f: Figure, phase: f64, stride: f64, posture: int = 0) -> mat4:
    if posture==1: return translation(vec3(0,0.58/f.height-0.86,0))
    if posture==3: return rotation_x(-0.12)
    # (posture 4: down on the left knee, leaning forward, the right hand stroking something on the
    # ground before him: a cat)
    if posture==4: return translation(vec3(0,0.55/f.height-0.86,0))*translation(vec3(0,0.9,0))*rotation_x(-0.8)*translation(vec3(0,-0.9,0))
    translation(vec3(0, f32(abs(sin(phase)) * 0.03 * stride), 0))

# a figure placed by a whole transform (seated in a cockpit, turning and rolling with it); it faces -z
# (arms: angles for the left and right arms, overriding the posture's: a gesture; -9 leaves them;
# bounce: the body lifted a little, as in a laugh or a shrug; spread: the arms opened out sideways)
draw_figure_at = (f: Figure, at: mat4, phase: f64, stride: f64, L: Light, t: f64, wave: f64 = 0.0, seated: bool = false, carrying: bool = false, cycling: bool = false, performing: bool = false, offset: vec3 = vec3(0,0,0),posture: int = 0,lean: f64 = 0.0,arms: vec2 = vec2(-9,-9),bounce: f64 = 0.0,spread: f64 = 0.0,elbows: vec2 = vec2(0,0),reach: f64 = 0.0,twist: f64 = 0.0):
    base = render_model(at,render_origin(scene_camera()))
    base[3] += vec4(offset,0)
    base = base * scaling(f64(f.height))
    if posture == 5:
        _draw_swimmer(f, base, phase, stride, L, t, lean)
        return
    if posture == 6:
        _draw_lying_back(f, base, L, t)
        return
    sw = sin(phase) * 0.6 * stride
    # (bounce: lifted a little more, in a laugh or a shrug)
    body = base * figure_pose(f, phase, stride, posture) * translation(vec3(0, f32(bounce), 0))
    hips=base*translation(vec3(0,0.55/f.height-0.86,0))
    draw(obj_sh, if posture==1: f.resting_torso else: f.torso, obj_local_params(L, t, body))
    draw(obj_sh, f.head, obj_local_params(L, t, body))
    loop side in [-1.0, 1.0]:
        if not seated:              # (seated in a cockpit, the legs are out of sight)
            leg = (if posture==3: base else: if posture==4: hips else: body) * translation(vec3(f32(side * 0.12), 0.86, 0)) * rotation_x(if cycling: 0.65+sin(phase+side*PI*0.5)*0.25 else: if posture==4: (if side>0: 0.0 else: -PI*0.5) else: sw * side)*rotation_z(if posture==4: side*0.1 else: 0.0)
            if posture==1 or posture==4: leg=leg*scaling(vec3(1,1/f.height,1))
            draw(obj_sh, if posture==1 or posture==4: f.resting_leg else: f.leg, obj_local_params(L, t, leg))
        lift = if side > 0.0 and wave > 0.0: -2.6 * wave else: 0.0
        angle=if posture==4: (if side>0: 1.05+sin(t*3.1)*0.14 else: 0.9) else: if posture==1: 0.85 else: if posture==2: 2.35+sin(t*1.4+side)*0.18 else: if posture==3: 1.0+sin(t*1.1)*0.12 else: if carrying: 1.15 else: if cycling: 0.95 else: if performing: 1.1+sin(t*11.0)*0.08*(if side>0: 1.0 else: 0.0) else: -sw * side * 0.8 + lift
        given = if side < 0.0: f64(arms.x) else: f64(arms.y)
        if given > -5.0: angle = given
        # (`spread` opens both arms; `reach` brings the right one in across the body)
        arm = body * translation(vec3(f32(side * 0.32), 1.43, 0)) * rotation_x(angle) * rotation_z(side * ((if given > -5.0: 0.18 else: 0.08) + spread) - (if side > 0.0: reach else: 0.0))
        bend = if side < 0.0: f64(elbows.x) else: f64(elbows.y)
        if bend != 0.0:
            draw(obj_sh, f.upper, obj_local_params(L, t, arm))
            draw(obj_sh, f.fore, obj_local_params(L, t, arm * translation(vec3(0, -0.3, 0)) * rotation_y(if side > 0.0: twist else: 0.0) * rotation_x(bend)))
        else: draw(obj_sh, f.arm, obj_local_params(L, t, arm))
