# People, as they look: chunky low-poly figures (a body, a head, a hat, arms and legs that swing as
# they walk), dressed from a seed: fishermen in caps and striped shirts, merchants in suits and
# boaters, pilots in leather jackets and goggles, policemen in blue, women in dresses and
# headscarves, old women in black.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'

enum Dress:
    fisher
    merchant
    pilot
    police
    dress           # a woman in a dress
    widow           # an old woman in black
    worker          # overalls (mechanics, dockers)

struct Figure:
    torso: Mesh
    head: Mesh
    arm: Mesh
    leg: Mesh
    height: f32                     # scale
    resting_leg: Mesh
    resting_torso: Mesh

SKIN = [rgb(0.96, 0.8, 0.68), rgb(0.88, 0.68, 0.52), rgb(0.74, 0.54, 0.4), rgb(0.95, 0.78, 0.7)]
HAIR = [rgb(0.15, 0.1, 0.08), rgb(0.35, 0.2, 0.1), rgb(0.6, 0.35, 0.15), rgb(0.55, 0.5, 0.45), rgb(0.85, 0.82, 0.78)]

_pick = (xs: vec4[], k: int) -> vec4: xs[k % xs.len()]

# the player's pilot: a dark brown handlebar
PILOT_MUSTACHE = rgb(0.2, 0.12, 0.07)

# Mustaches: none, a handlebar (full, with upturned curled tips), a walrus (heavy, drooping over the
# mouth) or a neat chevron. Some grown men wear one, chosen from the seed; grey or white on the old.
enum Mustache: none, handlebar, walrus, chevron

mustache_of = (dress: Dress, seed: int, age: int = -1) -> Mustache:
    if dress == .dress or dress == .widow or (age >= 0 and age < 20): return .none
    r = seed * 7919 + 13
    if (r / 37) % 100 >= 38: return .none
    [Mustache.handlebar, Mustache.walrus, Mustache.chevron][(r / 41) % 3]

# the mustache's colour: the hair's, greying with age
mustache_color = (hair: vec4, age: int) -> vec4:
    if age >= 68: return rgb(0.74, 0.72, 0.68)
    if age >= 55: return mix(hair, rgb(0.62, 0.6, 0.57), 0.7)
    hair

# one side of a mustache (side +1 or -1) as a chain of flattened lobes over the face's curve:
# each point is (across, height, thickness), across and height on the face, which faces -z
_mustache_chain = (h: mut Vertex3D[], pts: vec3[], side: f64, col: vec4, overlap: f64 = 1.35):
    centre = vec3(0, 1.7, 0)
    on_face = (q: vec3) -> vec3:
        dy = f64(q.y) - 1.7
        depth = sqrt(max(0.0289 - f64(q.x * q.x) - dy * dy, 0.0064))
        vec3(f32(f64(q.x) * side), q.y, f32(-depth - 0.006 - f64(q.z) * 0.45))
    loop k in 0..pts.len() - 1:
        a = on_face(pts[k]); b = on_face(pts[k + 1])
        mid = (a + b) * 0.5
        out = normalize(mid - centre)
        half = f64(length(b - a)) * 0.5
        thick = f64(pts[k].z + pts[k + 1].z) * 0.5
        add_sphere(h, vec3(0, 0, 0), 1.0, col, 6, 4, translation(mid) * facing(b - a, out) * scaling(vec3(f32(thick * 0.5), f32(thick * 0.36), f32(half * overlap))))

add_mustache = (h: mut Vertex3D[], style: Mustache, col: vec4):
    pts: vec3[] = match style:
        .handlebar: [vec3(0, 1.645, 0.05), vec3(0.045, 1.64, 0.062), vec3(0.09, 1.632, 0.058), vec3(0.128, 1.636, 0.046), vec3(0.158, 1.652, 0.035), vec3(0.177, 1.676, 0.027), vec3(0.179, 1.702, 0.021), vec3(0.164, 1.717, 0.017)]
        .walrus: [vec3(0, 1.645, 0.07), vec3(0.06, 1.634, 0.078), vec3(0.105, 1.6, 0.062), vec3(0.122, 1.562, 0.044)]
        .chevron: [vec3(0, 1.642, 0.044), vec3(0.048, 1.636, 0.044), vec3(0.088, 1.624, 0.034)]
        _: []
    if pts.len() == 0: return
    loop side in [-1.0, 1.0]:
        _mustache_chain(h, pts, side, col, if style == .walrus: 1.75 else: if style == .chevron: 1.5 else: 1.35)
        # (and brows to match, a little heavier on the handlebar)
        brow = if style == .handlebar: 0.026 else: 0.02
        add_box(h, vec3(0, 0, 0), vec3(0.078, f32(brow), 0.022), col, translation(vec3(f32(side * 0.064), 1.768, -0.152)) * rotation_z(side * -0.12))

build_figure = (dress: Dress, seed: int, age: int = -1, mustache: int = -1, mustache_tint: vec4 = vec4(0, 0, 0, 0)) -> Figure:
    r = seed * 7919 + 13
    skin = _pick(SKIN, r / 3)
    hair = _pick(HAIR, r / 5)
    # (where the age is known: no grey heads on the young, no dark ones on the old)
    if age >= 0 and age < 45: hair = _pick(HAIR[0..3], r / 5)
    if age >= 62: hair = _pick(HAIR[3..5], r / 5)
    shirt = rgb(0.9, 0.9, 0.86)
    trousers = rgb(0.3, 0.3, 0.34)
    jacket = shirt
    hat = rgba(0, 0, 0, 0)
    hat_kind = 0                    # 0 none, 1 cap, 2 boater, 3 flying helmet, 4 kepi, 5 scarf, 6 fedora
    skirt = false
    match dress:
        .fisher:
            shirt = _pick([rgb(0.25, 0.35, 0.6), rgb(0.85, 0.85, 0.8), rgb(0.6, 0.25, 0.2), rgb(0.45, 0.5, 0.4)], r / 7)
            trousers = _pick([rgb(0.35, 0.3, 0.25), rgb(0.25, 0.28, 0.4)], r / 11)
            jacket = shirt
            hat = _pick([rgb(0.2, 0.22, 0.3), rgb(0.5, 0.3, 0.2)], r / 13)
            hat_kind = 1
        .merchant:
            jacket = _pick([rgb(0.9, 0.86, 0.75), rgb(0.35, 0.33, 0.3), rgb(0.55, 0.45, 0.35)], r / 7)
            trousers = jacket
            hat = rgb(0.92, 0.86, 0.6)
            hat_kind = if (r / 17) % 2 == 0: 2 else: 6
            if hat_kind == 6: hat = rgb(0.4, 0.33, 0.28)
        .pilot:
            jacket = _pick([rgb(0.45, 0.3, 0.2), rgb(0.6, 0.5, 0.35), rgb(0.2, 0.25, 0.35)], r / 7)
            trousers = rgb(0.5, 0.45, 0.35)
            hat = rgb(0.4, 0.28, 0.18)
            hat_kind = 3
        .police:
            jacket = rgb(0.15, 0.2, 0.38)
            trousers = jacket
            hat = rgb(0.12, 0.15, 0.3)
            hat_kind = 4
        .dress:
            jacket = _pick([rgb(0.95, 0.75, 0.7), rgb(0.6, 0.75, 0.9), rgb(0.95, 0.9, 0.7), rgb(0.7, 0.85, 0.7)], r / 7)
            trousers = jacket
            skirt = true
            if (r / 19) % 3 == 0:
                hat = rgb(0.95, 0.95, 0.9)
                hat_kind = 2
        .widow:
            jacket = rgb(0.12, 0.12, 0.14)
            trousers = jacket
            skirt = true
            hat = rgb(0.1, 0.1, 0.12)
            hat_kind = 5
        .worker:
            jacket = rgb(0.3, 0.38, 0.5)
            trousers = jacket
            hat = rgb(0.3, 0.3, 0.32)
            hat_kind = if (r / 23) % 2 == 0: 1 else: 0
    # the body: hips at y = 0.95, shoulders at 1.45; a bigger belly on some
    belly = f32(0.18 + f64((r / 29) % 4) * 0.025)
    t: Vertex3D[]
    add_box(t, vec3(0, 1.2, 0), vec3(0.5, 0.55, belly * 2.0 + 0.06), jacket)
    add_box(t, vec3(0, 1.43, 0), vec3(0.56, 0.1, 0.3), jacket)
    rest_t=t
    if skirt:
        add_box(rest_t,vec3(0,0.84,-0.18),vec3(0.60,0.30,0.65),jacket)
        add_box(rest_t,vec3(0,0.60,-0.46),vec3(0.56,0.36,0.09),jacket)
    if skirt: add_cylinder(t, vec3(0, 0.35, 0), 0.32, 0.62, jacket, 8, 0.2)
    else: add_box(t, vec3(0, 0.88, 0), vec3(0.38, 0.16, 0.24), trousers)
    if dress == .fisher:
        loop k in 0..3: add_box(t, vec3(0, f32(1.05 + f64(k) * 0.14), 0), vec3(0.51, 0.04, belly * 2.0 + 0.07), rgb(0.92, 0.92, 0.88))
    if dress == .pilot:
        add_box(t, vec3(0, 1.42, -0.05), vec3(0.3, 0.06, 0.3), rgb(0.95, 0.95, 0.92))        # a white scarf,
        add_cylinder(t, vec3(0, 1.565, 0), 0.158, 0.07, rgb(0.95, 0.95, 0.92), 12, 0.145)  # wrapped round the neck, where the head meets the helmet's roll
    if dress == .merchant or dress == .police:
        add_box(t, vec3(0, 1.3, f32(-belly - 0.012)), vec3(0.06, 0.22, 0.02), rgb(0.6, 0.15, 0.15))              # a tie
    h: Vertex3D[]
    add_box(h, vec3(0, 1.53, 0), vec3(0.1, 0.08, 0.1), skin)                          # the neck
    add_sphere(h, vec3(0, 1.7, 0), 0.17, skin, 8, 5)
    add_box(h, vec3(-0.06, 1.73, -0.155), vec3(0.03, 0.035, 0.02), rgb(0.1, 0.08, 0.08))
    add_box(h, vec3(0.06, 1.73, -0.155), vec3(0.03, 0.035, 0.02), rgb(0.1, 0.08, 0.08))
    add_sphere(h, vec3(0, 1.67, -0.16), 0.045, skin, 5, 3)                             # the nose
    # (each scaled about its own center, not the feet: the hair on the head, the helmet over it)
    # (pilots keep their bald heads: the hair, scaled about the feet, sinks into the collar)
    if dress == .pilot: add_sphere(h, vec3(0, 1.76, 0.03), 0.172, hair, 8, 4, scaling(vec3(1.0, 0.7, 1.05)))
    else: add_sphere(h, vec3(0, 0, 0), 0.172, hair, 8, 4, translation(vec3(0, 1.76, 0.03)) * scaling(vec3(1.0, 0.7, 1.05)))
    match hat_kind:
        1:
            add_cylinder(h, vec3(0, 1.78, 0.01), 0.16, 0.1, hat, 8)
            add_box(h, vec3(0, 1.8, -0.15), vec3(0.22, 0.02, 0.12), hat)
        2:
            add_cylinder(h, vec3(0, 1.79, 0), 0.28, 0.02, hat, 10)
            add_cylinder(h, vec3(0, 1.79, 0), 0.16, 0.1, hat, 10)
            add_cylinder(h, vec3(0, 1.84, 0), 0.165, 0.025, rgb(0.6, 0.15, 0.15), 10)
        3:
            # (the flying helmet worn low, a leather roll round the neck that makes him look stout,
            # the goggles up on the bald head)
            add_sphere(h, vec3(0, 1.75, 0.02), 0.19, hat, 8, 5, scaling(vec3(1.0, 0.85, 1.05)))
            add_box(h, vec3(0, 1.82, -0.15), vec3(0.26, 0.06, 0.04), rgb(0.25, 0.25, 0.25))
            add_sphere(h, vec3(-0.06, 1.83, -0.17), 0.04, rgb(0.6, 0.8, 0.85), 5, 3)
            add_sphere(h, vec3(0.06, 1.83, -0.17), 0.04, rgb(0.6, 0.8, 0.85), 5, 3)
        4:
            add_cylinder(h, vec3(0, 1.76, 0), 0.155, 0.16, hat, 8)
            add_box(h, vec3(0, 1.78, -0.15), vec3(0.2, 0.02, 0.1), rgb(0.1, 0.1, 0.1))
        5:
            add_sphere(h, vec3(0, 0, 0), 0.175, hat, 8, 5, translation(vec3(0, 1.72, 0.02)) * scaling(vec3(1.0, 1.0, 1.05)))
        6:
            add_cylinder(h, vec3(0, 1.78, 0), 0.25, 0.02, hat, 10)
            add_cylinder(h, vec3(0, 1.78, 0), 0.15, 0.14, hat, 10, 0.13)
        _: pass
    # (mustache -1: from the seed; otherwise the style asked for)
    style = if mustache < 0: mustache_of(dress, seed, age) else: [Mustache.none, Mustache.handlebar, Mustache.walrus, Mustache.chevron][mustache % 4]
    add_mustache(h, style, if mustache_tint.w > 0.0: mustache_tint else: mustache_color(hair, age))
    a: Vertex3D[]
    add_box(a, vec3(0, -0.28, 0), vec3(0.13, 0.56, 0.14), jacket)                     # (hangs from the shoulder at 0)
    add_sphere(a, vec3(0, -0.6, 0), 0.06, skin, 5, 3)
    l: Vertex3D[]
    add_box(l, vec3(0, -0.42, 0), vec3(0.17, 0.84, 0.18), if skirt: rgb(0.85, 0.8, 0.75) else: trousers)
    add_box(l, vec3(0, -0.86, -0.04), vec3(0.15, 0.08, 0.24), rgb(0.2, 0.15, 0.12))
    rest: Vertex3D[]
    leg_color=if skirt: rgb(0.85,0.8,0.75) else: trousers
    add_box(rest,vec3(0,0,-0.20),vec3(0.17,0.18,0.44),leg_color)
    add_box(rest,vec3(0,-0.25,-0.40),vec3(0.16,0.50,0.17),leg_color)
    add_box(rest,vec3(0,-0.54,-0.46),vec3(0.15,0.08,0.24),rgb(0.2,0.15,0.12))
    s = f32(0.92 + f64((r / 31) % 5) * 0.035)
    torso=custom_mesh(t)
    Figure(torso, custom_mesh(h), custom_mesh(a), custom_mesh(l), s,custom_mesh(rest),if skirt: custom_mesh(rest_t) else: torso)

# a figure standing at pos, facing yaw (turned as the world's rotation_y), mid-stride at phase
# (radians; the legs swing with it), stride 0..1 (how much they swing: 0 standing)
draw_figure = (f: Figure, pos: vec3, yaw: f64, phase: f64, stride: f64, L: Light, t: f64, wave: f64 = 0.0, carrying: bool = false, cycling: bool = false, performing: bool = false, offset: vec3 = vec3(0,0,0),posture: int = 0):
    draw_figure_at(f, translation(pos) * rotation_y(yaw + PI), phase, stride, L, t, wave, carrying=carrying,cycling=cycling,performing=performing,offset=offset,posture=posture)

# a figure placed by a whole transform (seated in a cockpit, turning and rolling with it); it faces -z
draw_figure_at = (f: Figure, at: mat4, phase: f64, stride: f64, L: Light, t: f64, wave: f64 = 0.0, seated: bool = false, carrying: bool = false, cycling: bool = false, performing: bool = false, offset: vec3 = vec3(0,0,0),posture: int = 0):
    base = render_model(at,render_origin(scene_camera()))
    base[3] += vec4(offset,0)
    base = base * scaling(f64(f.height))
    sw = sin(phase) * 0.6 * stride
    bob = abs(sin(phase)) * 0.03 * stride
    body = base * translation(vec3(0, f32(bob), 0))
    if posture==1: body=base*translation(vec3(0,0.58/f.height-0.86,0))
    if posture==3: body=base*rotation_x(-0.12)
    draw(obj_sh, if posture==1: f.resting_torso else: f.torso, obj_local_params(L, t, body))
    draw(obj_sh, f.head, obj_local_params(L, t, body))
    loop side in [-1.0, 1.0]:
        if not seated:              # (seated in a cockpit, the legs are out of sight)
            leg = (if posture==3: base else: body) * translation(vec3(f32(side * 0.12), 0.86, 0)) * rotation_x(if cycling: 0.65+sin(phase+side*PI*0.5)*0.25 else: sw * side)
            if posture==1: leg=leg*scaling(vec3(1,1/f.height,1))
            draw(obj_sh, if posture==1: f.resting_leg else: f.leg, obj_local_params(L, t, leg))
        lift = if side > 0.0 and wave > 0.0: -2.6 * wave else: 0.0
        angle=if posture==1: 0.85 else: if posture==2: 2.35+sin(t*1.4+side)*0.18 else: if posture==3: 1.0+sin(t*1.1)*0.12 else: if carrying: 1.15 else: if cycling: 0.95 else: if performing: 1.1+sin(t*11.0)*0.08*(if side>0: 1.0 else: 0.0) else: -sw * side * 0.8 + lift
        arm = body * translation(vec3(f32(side * 0.32), 1.43, 0)) * rotation_x(angle) * rotation_z(side * 0.08)
        draw(obj_sh, f.arm, obj_local_params(L, t, arm))
