# People, as they look: chunky low-poly figures (a body, a head, a hat, arms and legs that swing as
# they walk), dressed from a seed: fishermen in caps and striped shirts, merchants in suits and
# boaters, pilots in leather jackets and goggles, policemen in blue, women in dresses and
# headscarves, old women in black.

use 'look.jo'
use 'objects.jo'

enum Dress:
    fisher
    merchant
    pilot
    police
    dress           # a woman in a dress
    widow           # an old woman in black
    worker          # overalls (mechanics, dockers)

struct Figure:
    torso: Mesh
    head: Mesh
    arm: Mesh
    leg: Mesh
    height: f32                     # scale

SKIN = [rgb(0.96, 0.8, 0.68), rgb(0.88, 0.68, 0.52), rgb(0.74, 0.54, 0.4), rgb(0.95, 0.78, 0.7)]
HAIR = [rgb(0.15, 0.1, 0.08), rgb(0.35, 0.2, 0.1), rgb(0.6, 0.35, 0.15), rgb(0.55, 0.5, 0.45), rgb(0.85, 0.82, 0.78)]

_pick = (xs: vec4[], k: int) -> vec4: xs[k % xs.len()]

build_figure = (dress: Dress, seed: int) -> Figure:
    r = seed * 7919 + 13
    skin = _pick(SKIN, r / 3)
    hair = _pick(HAIR, r / 5)
    shirt = rgb(0.9, 0.9, 0.86)
    trousers = rgb(0.3, 0.3, 0.34)
    jacket = shirt
    hat = rgba(0, 0, 0, 0)
    hat_kind = 0                    # 0 none, 1 cap, 2 boater, 3 flying helmet, 4 kepi, 5 scarf, 6 fedora
    skirt = false
    match dress:
        .fisher:
            shirt = _pick([rgb(0.25, 0.35, 0.6), rgb(0.85, 0.85, 0.8), rgb(0.6, 0.25, 0.2), rgb(0.45, 0.5, 0.4)], r / 7)
            trousers = _pick([rgb(0.35, 0.3, 0.25), rgb(0.25, 0.28, 0.4)], r / 11)
            jacket = shirt
            hat = _pick([rgb(0.2, 0.22, 0.3), rgb(0.5, 0.3, 0.2)], r / 13)
            hat_kind = 1
        .merchant:
            jacket = _pick([rgb(0.9, 0.86, 0.75), rgb(0.35, 0.33, 0.3), rgb(0.55, 0.45, 0.35)], r / 7)
            trousers = jacket
            hat = rgb(0.92, 0.86, 0.6)
            hat_kind = if (r / 17) % 2 == 0: 2 else: 6
            if hat_kind == 6: hat = rgb(0.4, 0.33, 0.28)
        .pilot:
            jacket = _pick([rgb(0.45, 0.3, 0.2), rgb(0.6, 0.5, 0.35), rgb(0.2, 0.25, 0.35)], r / 7)
            trousers = rgb(0.5, 0.45, 0.35)
            hat = rgb(0.4, 0.28, 0.18)
            hat_kind = 3
        .police:
            jacket = rgb(0.15, 0.2, 0.38)
            trousers = jacket
            hat = rgb(0.12, 0.15, 0.3)
            hat_kind = 4
        .dress:
            jacket = _pick([rgb(0.95, 0.75, 0.7), rgb(0.6, 0.75, 0.9), rgb(0.95, 0.9, 0.7), rgb(0.7, 0.85, 0.7)], r / 7)
            trousers = jacket
            skirt = true
            if (r / 19) % 3 == 0:
                hat = rgb(0.95, 0.95, 0.9)
                hat_kind = 2
        .widow:
            jacket = rgb(0.12, 0.12, 0.14)
            trousers = jacket
            skirt = true
            hat = rgb(0.1, 0.1, 0.12)
            hat_kind = 5
        .worker:
            jacket = rgb(0.3, 0.38, 0.5)
            trousers = jacket
            hat = rgb(0.3, 0.3, 0.32)
            hat_kind = if (r / 23) % 2 == 0: 1 else: 0
    # the body: hips at y = 0.95, shoulders at 1.45; a bigger belly on some
    belly = f32(0.18 + f64((r / 29) % 4) * 0.025)
    t: Vertex3D[]
    add_box(t, vec3(0, 1.2, 0), vec3(0.5, 0.55, belly * 2.0 + 0.06), jacket)
    add_box(t, vec3(0, 1.43, 0), vec3(0.56, 0.1, 0.3), jacket)
    if skirt: add_cylinder(t, vec3(0, 0.35, 0), 0.32, 0.62, jacket, 8, 0.2)
    else: add_box(t, vec3(0, 0.88, 0), vec3(0.38, 0.16, 0.24), trousers)
    if dress == .fisher:
        loop k in 0..3: add_box(t, vec3(0, f32(1.05 + f64(k) * 0.14), 0), vec3(0.51, 0.04, belly * 2.0 + 0.07), rgb(0.92, 0.92, 0.88))
    if dress == .pilot:
        add_box(t, vec3(0, 1.42, -0.05), vec3(0.3, 0.06, 0.3), rgb(0.95, 0.95, 0.92))        # a white scarf,
        add_cylinder(t, vec3(0, 1.45, 0), 0.125, 0.11, rgb(0.95, 0.95, 0.92), 10, 0.1)     # wrapped round the neck
    if dress == .merchant or dress == .police:
        add_box(t, vec3(0, 1.3, f32(-belly - 0.012)), vec3(0.06, 0.22, 0.02), rgb(0.6, 0.15, 0.15))              # a tie
    h: Vertex3D[]
    add_box(h, vec3(0, 1.53, 0), vec3(0.1, 0.08, 0.1), skin)                          # the neck
    add_sphere(h, vec3(0, 1.7, 0), 0.17, skin, 8, 5)
    add_box(h, vec3(-0.06, 1.73, -0.155), vec3(0.03, 0.035, 0.02), rgb(0.1, 0.08, 0.08))
    add_box(h, vec3(0.06, 1.73, -0.155), vec3(0.03, 0.035, 0.02), rgb(0.1, 0.08, 0.08))
    add_sphere(h, vec3(0, 1.67, -0.16), 0.045, skin, 5, 3)                             # the nose
    # (each scaled about its own center, not the feet: the hair on the head, the helmet over it)
    add_sphere(h, vec3(0, 0, 0), 0.172, hair, 8, 4, translation(vec3(0, 1.76, 0.03)) * scaling(vec3(1.0, 0.7, 1.05)))
    match hat_kind:
        1:
            add_cylinder(h, vec3(0, 1.78, 0.01), 0.16, 0.1, hat, 8)
            add_box(h, vec3(0, 1.8, -0.15), vec3(0.22, 0.02, 0.12), hat)
        2:
            add_cylinder(h, vec3(0, 1.79, 0), 0.28, 0.02, hat, 10)
            add_cylinder(h, vec3(0, 1.79, 0), 0.16, 0.1, hat, 10)
            add_cylinder(h, vec3(0, 1.84, 0), 0.165, 0.025, rgb(0.6, 0.15, 0.15), 10)
        3:
            add_sphere(h, vec3(0, 0, 0), 0.19, hat, 8, 5, translation(vec3(0, 1.75, 0.02)) * scaling(vec3(1.0, 0.85, 1.05)))
            add_box(h, vec3(0, 1.82, -0.15), vec3(0.26, 0.06, 0.04), rgb(0.25, 0.25, 0.25))
            add_sphere(h, vec3(-0.06, 1.83, -0.17), 0.04, rgb(0.6, 0.8, 0.85), 5, 3)
            add_sphere(h, vec3(0.06, 1.83, -0.17), 0.04, rgb(0.6, 0.8, 0.85), 5, 3)
        4:
            add_cylinder(h, vec3(0, 1.76, 0), 0.155, 0.16, hat, 8)
            add_box(h, vec3(0, 1.78, -0.15), vec3(0.2, 0.02, 0.1), rgb(0.1, 0.1, 0.1))
        5:
            add_sphere(h, vec3(0, 0, 0), 0.175, hat, 8, 5, translation(vec3(0, 1.72, 0.02)) * scaling(vec3(1.0, 1.0, 1.05)))
        6:
            add_cylinder(h, vec3(0, 1.78, 0), 0.25, 0.02, hat, 10)
            add_cylinder(h, vec3(0, 1.78, 0), 0.15, 0.14, hat, 10, 0.13)
        _: pass
    a: Vertex3D[]
    add_box(a, vec3(0, -0.28, 0), vec3(0.13, 0.56, 0.14), jacket)                     # (hangs from the shoulder at 0)
    add_sphere(a, vec3(0, -0.6, 0), 0.06, skin, 5, 3)
    l: Vertex3D[]
    add_box(l, vec3(0, -0.42, 0), vec3(0.17, 0.84, 0.18), if skirt: rgb(0.85, 0.8, 0.75) else: trousers)
    add_box(l, vec3(0, -0.86, -0.04), vec3(0.15, 0.08, 0.24), rgb(0.2, 0.15, 0.12))
    s = f32(0.92 + f64((r / 31) % 5) * 0.035)
    Figure(custom_mesh(t), custom_mesh(h), custom_mesh(a), custom_mesh(l), s)

# a figure standing at pos, facing yaw (turned as the world's rotation_y), mid-stride at phase
# (radians; the legs swing with it), stride 0..1 (how much they swing: 0 standing)
draw_figure = (f: Figure, pos: vec3, yaw: f64, phase: f64, stride: f64, L: Light, t: f64, wave: f64 = 0.0):
    draw_figure_at(f, translation(pos) * rotation_y(yaw + PI), phase, stride, L, t, wave)

# a figure placed by a whole transform (seated in a cockpit, turning and rolling with it); it faces -z
draw_figure_at = (f: Figure, at: mat4, phase: f64, stride: f64, L: Light, t: f64, wave: f64 = 0.0, seated: bool = false):
    base = at * scaling(f64(f.height))
    sw = sin(phase) * 0.6 * stride
    bob = abs(sin(phase)) * 0.03 * stride
    body = base * translation(vec3(0, f32(bob), 0))
    draw(obj_sh, f.torso, obj_params(L, t, body))
    draw(obj_sh, f.head, obj_params(L, t, body))
    loop side in [-1.0, 1.0]:
        if not seated:              # (seated in a cockpit, the legs are out of sight)
            leg = body * translation(vec3(f32(side * 0.12), 0.86, 0)) * rotation_x(sw * side)
            draw(obj_sh, f.leg, obj_params(L, t, leg))
        lift = if side > 0.0 and wave > 0.0: -2.6 * wave else: 0.0
        arm = body * translation(vec3(f32(side * 0.32), 1.43, 0)) * rotation_x(-sw * side * 0.8 + lift) * rotation_z(side * 0.08)
        draw(obj_sh, f.arm, obj_params(L, t, arm))
