# The note feed: what a live music source is playing, note by note, as it is heard, for anything
# that shows the music rather than plays it (the musicians' hands and bows in
# src/musician_pose.jo, notes floating over a source). One feed per source, held by whoever uses
# it: loaded with the note events the synthesizer plays when a piece starts, then stepped to the
# frame being heard, it gives the notes that started since the last step, in order (a seek or a
# skip re-syncs it without a burst of old notes). The loaded notes stay readable in `notes`,
# sorted by start, for whoever needs to look ahead.

use 'music_synth.jo'

struct LiveNote:
    start: int                      # frame (MUSIC_RATE) into the piece
    pitch: int                      # MIDI
    part: int                       # the instrument (MusicInstrument; 14 for a singer's line)
    velocity: f64                   # 0..1
    length: f64                     # seconds
    melody: bool                    # (on the part that carries the tune)

struct LiveNoteFeed:
    notes: LiveNote[]               # by start
    next = 0                        # (the first not yet given)
    frame = -1                      # (the frame last stepped to; -1: not yet)

live_notes_load = (feed: mut LiveNoteFeed, events: MusicEvent[], melody_part: int):
    feed.notes = []
    # (velocity against the piece's loudest note: the scores' gains run past 1)
    loudest = 0.0
    loop e in events: loudest = max(loudest, if e.peak_gain >= 0.0: max(e.gain, e.peak_gain) else: e.gain)
    loop e in events:
        top = if e.peak_gain >= 0.0: max(e.gain, e.peak_gain) else: e.gain
        feed.notes.push(LiveNote(e.start, e.pitch, e.instrument, if loudest > 0.0: clamp(top / loudest, 0.0, 1.0) else: 0.5, f64(e.duration) / f64(MUSIC_RATE), e.instrument == melody_part))
    feed.notes.sort((n: LiveNote): (n.start, n.part, n.pitch))
    feed.next = 0; feed.frame = -1

live_notes_step = (feed: mut LiveNoteFeed, heard_frame: int) -> LiveNote[]:
    out: LiveNote[]
    jumped = feed.frame < 0 or heard_frame < feed.frame or heard_frame - feed.frame > MUSIC_RATE / 4
    if jumped:
        lo = 0; hi = feed.notes.len()
        loop lo < hi:
            mid = (lo + hi) / 2
            if feed.notes[mid].start <= heard_frame: lo = mid + 1
            else: hi = mid
        feed.next = lo
    else:
        loop feed.next < feed.notes.len() and feed.notes[feed.next].start <= heard_frame:
            out.push(feed.notes[feed.next]); feed.next += 1
    feed.frame = heard_frame
    out

live_notes_heard_frame = (rendered: int, queued: int) -> int: max(0, rendered - queued)

live_notes_clock_frame = (seconds: f64) -> int: int(floor(seconds * f64(MUSIC_RATE)))
