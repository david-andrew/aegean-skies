# Record, transmitter and receiver are separate states. All signals, including dust and
# atmospheric events, are synthesized here. Fixed storage; no external media input.
const CHANNEL_RATE = 16000

struct ChannelFilter:
    b0 = 0.0
    b1 = 0.0
    b2 = 0.0
    a1 = 0.0
    a2 = 0.0
    x1 = 0.0
    x2 = 0.0
    y1 = 0.0
    y2 = 0.0

channel_filter = (hz: f64, kind: int, q: f64 = 0.70710678) -> ChannelFilter:
    w = TAU*hz/f64(CHANNEL_RATE); c = cos(w); a = sin(w)/(2.0*q); d = 1.0+a
    b = (if kind == 1: 1.0+c else: 1.0-c)/(2.0*d)
    if kind == 2: return ChannelFilter(a/d,0,-a/d,-2*c/d,(1-a)/d)
    ChannelFilter(b,(if kind == 1: -2.0 else: 2.0)*b,b,-2*c/d,(1-a)/d)

channel_filter_sample = (f: mut ChannelFilter, x: f64) -> f64:
    y = f.b0*x+f.b1*f.x1+f.b2*f.x2-f.a1*f.y1-f.a2*f.y2
    f.x2=f.x1; f.x1=x; f.y2=f.y1; f.y1=y
    y

struct RadioChain:
    cursor = 0
    rng: u64 = 4567
    sine: f64[]
    delay: f64[]
    record_hp: ChannelFilter = channel_filter(220,1)
    record_lp: ChannelFilter = channel_filter(3600,0)
    horn: ChannelFilter = channel_filter(850,2,1.4)
    groove: ChannelFilter = channel_filter(2300,2,0.8)
    input_hp: ChannelFilter = channel_filter(150,1)
    thin_hp: ChannelFilter = channel_filter(430,1)
    bright: ChannelFilter = channel_filter(4300,0)
    dull: ChannelFilter = channel_filter(1450,0)
    cabinet: ChannelFilter = channel_filter(270,2,1.2)
    mid: ChannelFilter = channel_filter(1050,2,0.9)
    speaker: ChannelFilter = channel_filter(4500,0)
    noise_hp: ChannelFilter = channel_filter(170,1)
    noise_lp: ChannelFilter = channel_filter(4800,0)
    dust: ChannelFilter = channel_filter(2750,2,1.0)
    rustle: ChannelFilter = channel_filter(900,2,0.8)
    rf_hp: ChannelFilter = channel_filter(300,1)
    rf_lp: ChannelFilter = channel_filter(3000,0)
    hiss_low = 0.0
    hiss_deep = 0.0
    static_low = 0.0
    previous = 0.0
    envelope = 0.0
    agc = 1.0
    strength = 1.0
    detuning = 0.0
    night = 0.0
    record = 0.0
    cluster = 0.0
    pop = 0.0
    tick_phase = 0.0
    wow_phase = 0.0
    flutter_phase = 0.0
    fade_phase = 0.0
    slow_phase = 0.0
    whistle_phase = 0.0
    clicks = 0
    clusters = 0

make_radio_chain = (seed: int = 0, seconds: f64 = 0) -> RadioChain:
    RadioChain(cursor=max(0,int(seconds*f64(CHANNEL_RATE))),rng=u64(4567+max(0,seed)*7919),
        sine=[loop i in 0..1024: sin(TAU*f64(i)/1024.0)],delay=fill(0.0,256),
        tick_phase=(seconds*1.3)%1.0,wow_phase=(seconds*1.3)%1.0,flutter_phase=(seconds*7.7)%1.0,
        fade_phase=(seconds*0.173)%1.0,slow_phase=(seconds*0.037)%1.0)

channel_sine = (sine: f64[], phase: f64) -> f64:
    p=phase*1024.0; whole=int(p); i=whole%1024
    # Receiver phases are nonnegative; truncation is exactly floor here.
    sine[i]+(sine[(i+1)%1024]-sine[i])*(p-f64(whole))

channel_random = (c: mut RadioChain) -> f64:
    c.rng=(c.rng*u64(1664525)+u64(1013904223)) & u64(0xffffffff)
    # The 32-bit integer scales exactly by 2^-32, with no division rounding.
    f64(c.rng)*0.00000000023283064365386962890625

radio_chain_sample = (c: mut RadioChain, source: f64, strength: f64, detuning: f64, record: f64, night: f64 = 0.0) -> f64:
    if c.delay.len() == 0: c=make_radio_chain()
    # No abrupt changes when the tuning knob, reception or record setting changes.
    c.strength+=(clamp(strength,0.0,1.0)-c.strength)*0.0015
    c.detuning+=(clamp(detuning,-30.0,30.0)-c.detuning)*0.002
    c.record+=(clamp(record,0.0,1.0)-c.record)*0.0015
    c.night+=(clamp(night,0.0,1.0)-c.night)*0.0002
    white=channel_random(c)*2.0-1.0
    weakness=1.0-c.strength
    # Overlapping packets of small contacts, never a rare high-amplitude pop.
    # A slowly relaxing density produces the irregular crumple of a rough surface.
    c.cluster*=0.9994
    if channel_random(c)<12.0/f64(CHANNEL_RATE):
        c.cluster=max(c.cluster,0.15+0.85*channel_random(c))
        c.clusters+=1
    # Unit phases use the same truncated-remainder arithmetic without dividing by one.
    c.tick_phase+=1.3/f64(CHANNEL_RATE); c.tick_phase-=f64(int(c.tick_phase))
    density=(140.0+500.0*c.record+1800.0*weakness*weakness)*(0.3+1.4*c.cluster)
    density*=1.0+0.06*c.record*channel_sine(c.sine,c.tick_phase)
    impulse=0.0
    if channel_random(c)<density/f64(CHANNEL_RATE):
        u=channel_random(c)
        impulse=(0.010+0.030*u*u)*(if white<0: -1.0 else: 1.0)
        c.clicks+=1
    c.pop=c.pop*0.42+impulse
    grit=channel_filter_sample(c.rustle,c.pop)*0.65+channel_filter_sample(c.dust,c.pop)*0.35
    # Mixed relaxation times give shellac a falling spectrum instead of white hiss.
    c.hiss_low+=(white-c.hiss_low)*0.18
    c.hiss_deep+=(white-c.hiss_deep)*0.018
    shellac=channel_filter_sample(c.noise_lp,channel_filter_sample(c.noise_hp,c.hiss_low*0.7+c.hiss_deep*0.5+white*0.18))
    c.wow_phase+=1.3/f64(CHANNEL_RATE); c.wow_phase-=f64(int(c.wow_phase))
    c.flutter_phase+=7.7/f64(CHANNEL_RATE); c.flutter_phase-=f64(int(c.flutter_phase))
    # Fractional-delay derivative gives ~0.16% wow plus ~0.045% flutter at full wear.
    delay=48.0+c.record*(3.1*channel_sine(c.sine,c.wow_phase)+0.15*channel_sine(c.sine,c.flutter_phase))
    write=c.cursor%256; c.delay[write]=source
    at=f64(write)-delay+256.0
    # Smoothed wear keeps this address in [204,467): one exact power-of-two wrap.
    if at>=256.0:at-=256.0
    i=int(at); f=at-f64(i)
    worn=c.delay[i]*(1.0-f)+c.delay[(i+1)%256]*f
    slope=worn-c.previous; c.previous=worn
    # The high-frequency groove component overloads first on loud cuts.
    edge=channel_filter_sample(c.groove,worn)
    worn += c.record*(0.35*edge*abs(edge)+0.18*slope*abs(worn))
    worn=channel_filter_sample(c.record_lp,channel_filter_sample(c.record_hp,worn))
    worn+=channel_filter_sample(c.horn,worn)*0.30
    worn+=shellac*0.032+grit
    # The dry path shares the nominal delay; the worn path adds a small pitch wobble.
    dry=c.delay[(write+256-48)%256]
    value=dry*(1.0-c.record)+worn*c.record
    c.envelope+=(abs(value)-c.envelope)*(if abs(value)>c.envelope: 0.004 else: 0.00012)
    wanted=clamp(0.14/(0.045+c.envelope),0.55,1.8)
    c.agc+=(wanted-c.agc)*(if wanted<c.agc: 0.002 else: 0.00010)
    value*=c.agc
    # Audio-stage asymmetry is followed by DC blocking, as in a capacitor-coupled set.
    drive=1.3+abs(c.detuning)*0.10
    value=value/(1.0+abs(value)*drive)+0.10*value*value
    full=channel_filter_sample(c.input_hp,value)
    thin=channel_filter_sample(c.thin_hp,value)
    off=clamp(abs(c.detuning)/18.0,0.0,1.0)
    value=full*(1.0-off)+thin*off
    bright=channel_filter_sample(c.bright,value)
    dull=channel_filter_sample(c.dull,value)
    c.fade_phase+=0.173/f64(CHANNEL_RATE); c.fade_phase-=f64(int(c.fade_phase))
    c.slow_phase+=0.037/f64(CHANNEL_RATE); c.slow_phase-=f64(int(c.slow_phase))
    fade=0.55+0.30*channel_sine(c.sine,c.fade_phase)+0.15*channel_sine(c.sine,c.slow_phase)
    treble=clamp(1.0-weakness*(0.35+0.55*fade)-off*0.65,0.05,1.0)
    value=(bright*treble+dull*(1.0-treble))*c.strength*(1.0+weakness*0.30)*(1.0-weakness*fade*0.35)
    # The original receiver's 300–3000 Hz noise band is the base, with much less
    # white hiss at weak reception. Dense micro-crackle carries most of the texture.
    base=channel_filter_sample(c.rf_lp,channel_filter_sample(c.rf_hp,white))
    static=base*(0.003+0.025*weakness)*(1.0-0.65*weakness)*(1.0+0.12*c.night)
    static+=grit*weakness*(1.5+2.0*weakness)*(1.0+0.30*c.night)
    # Adjacent-carrier heterodyne grows near the station edge, never at its center.
    c.whistle_phase+=(620.0+abs(c.detuning)*115.0)/f64(CHANNEL_RATE); c.whistle_phase-=f64(int(c.whistle_phase))
    heterodyne=channel_sine(c.sine,c.whistle_phase)*0.018*min(1.0,off*2.0)*(0.4+weakness)
    value+=static+heterodyne
    value+=channel_filter_sample(c.cabinet,value)*0.18+channel_filter_sample(c.mid,value)*0.14
    value=channel_filter_sample(c.speaker,value)*1.65
    if abs(value)>0.70:
        magnitude=0.70+0.25*(1.0-exp(-(abs(value)-0.70)/0.25))
        value=if value<0: -magnitude else: magnitude
    c.cursor+=1
    value
