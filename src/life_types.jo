# Saved social life data. Geometry, rendering and UI are consumers of these records.
# No World import: the economic core can include this schema without a dependency cycle.
enum VoiceKind: salt, shop, formal, anxious, warm, measured, wry, guarded, plain, devout, brisk, chatty, eager, elder
enum TalkTopic: greeting, work, news, weather, market, home, people, troubles, music, farewell
enum TalkReply: reassure, decline, ask_back, discreet, tease, leave, open_topic
enum QuestionKind: none, day, meal, route, company, news, business, work

struct TalkQuestion:
    kind: QuestionKind
    text: str
    echo: str
    open_topic: TalkTopic = .home
enum VenueKind: home, quay, market, cafe, church, square, fields, workshop, shelter, school, seat, laundry, oven, alley
enum LifeActivity: work, rest, talk, listen, play, pray, stroll, wait, sleep, sit, wash, bake
enum LifeMobility: walking, bicycle

struct TalkOption:
    topic: TalkTopic
    label: str
    subject = -1
    event = -1
    job = -1

struct ReplyOption:
    reply: TalkReply
    label: str

struct SpokenLine:
    key: str
    text: str
    minute: int
    listener: int
    topic: TalkTopic

struct WorkLead:
    job: int
    poster: int
    origin: int
    destination: int
    good: int
    quantity: int
    reward_cents: int
    heard_minute: int
    source_person: int
    on_foot: bool

struct WorkOffer:
    job: int
    poster: int
    own: bool
    source_person: int
    heard_minute: int
    label: str
    commission = -1
    mission = -1

struct SpeechLedger:
    work_leads: WorkLead[]           # <=12 personally heard offers, with original date/source
    sequence = 0
    recent: SpokenLine[]             # <= 64; no exact repetition during the recent window
    acquaintance: {int: int}         # actual conversation counts, not proximity reads
    last_contact: {int: int}
    pending_listener = -1
    pending_question = ""
    pending_kind: QuestionKind = .none
    pending_echo = ""
    pending_open_topic: TalkTopic = .home
    question_minute = -1
    last_reply_minute = -100000

struct ConversationTurn:
    speaker: int
    listener: int
    topic: TalkTopic
    text = ""
    question = ""
    question_kind: QuestionKind = .none
    replies: ReplyOption[]
    source_event = -1
    source_person = -1
    confidence = 1000
    private = false
    job = -1
    exhausted = false
    far_news = -1
    commission = -1
    mission = -1

# A hotel terrace published by the scene as a cafe venue: pilots and the keeper go there of an
# evening (src/living_life.jo); the key ends with this.
const TERRACE_VENUE_SUFFIX = ":terrace"

struct LifeVenue:
    place: int                      # current detailed-core place ID
    key: str                        # stable local anchor key, supplied by town data
    kind: VenueKind
    pos: vec3
    facing = vec3(0,0,-1)
    capacity = 4
    covered = false
    prop_pos: vec3 = vec3(0,0,0)     # optional physical fixture origin, supplied by town geometry
    prop_yaw = 0.0

struct DailyIntent:
    person: int
    place: int
    venue: VenueKind = .home
    anchor = ""
    activity: LifeActivity = .wait
    mobility: LifeMobility = .walking
    reason = ""
    companion = -1
    meeting = -1
    since_minute = 0
    until_minute = 0
    target: vec3 = vec3(0,0,0)
    route: vec3[]
    waypoint = 0
    last_tick = 0
    path_revision = 0
    routed_revision = -1
    blocked = ""
    scene_owned = false
    arrived = false
    mood = 0                        # -1000..1000, derived from actual circumstances

struct SocialMeeting:
    id: int
    place: int
    venue: VenueKind
    people: int[]
    start_minute: int
    until_minute: int
    last_exchange_minute = -1
    reason = ""
    active = true

# Named household residents share their town's background headcount, not the economic roster.
# They have no invented wallet, cargo, aircraft or independent production rate.
struct HouseholdResident:
    id: int
    name: str
    age: int
    home: int
    guardian: int
    pose: vec3
    target: vec3
    venue: VenueKind = .home
    activity: LifeActivity = .sleep
    last_tick = 0
    scene_owned = false
    route: vec3[]
    waypoint = 0
    path_revision = 0
    routed_revision = -1
    blocked = false

# Story state records causes and consequences. It never grants goods, cash or outcomes.
enum LifeStoryKind: courtship, feud, missing_boat, debt, household
struct LifeStory:
    id: int
    kind: LifeStoryKind
    actors: int[]
    place: int
    stage = 0
    since_minute: int
    changed_minute: int
    next_check_minute: int
    meetings = 0
    last_meeting_day = -1
    evidence_event = -1
    obligation = -1
    job = -1
    resolved = false
    outcome = ""

# Sparse national evidence is independent of detailed Town meshes and economic core indexes.
enum BorderIncidentKind: intrusion, seizure, attack, rescue, reprisal
enum CrisisStage: calm, strained, mobilizing, blockade, war, armistice
struct CountryRecord:
    id: int
    key: str
    name: str
    treasury_account = -1            # no war spending until a real funded account is attached
    seat = -1                       # detailed economic core index, if an authority is attached
    capital_id = -1                 # stable sparse registry ID; never used as an array subscript
    authority_faction = -1

struct BorderIncident:
    id: int
    event: int                      # actual evidence; never an invented calendar incident
    occurred_minute: int
    aggressor: int
    affected: int
    kind: BorderIncidentKind
    confidence: int
    weight: int
    source_person: int
    state_backed = false

struct DiplomaticRelation:
    a: int
    b: int
    tension = 0
    stage: CrisisStage = .calm
    last_incident_minute = -1
    last_review_day = -1
    evidence: int[]
    incident_news: int[]             # sparse FarNews evidence; distinct ID namespace
    last_armistice_minute = -1       # a signed settlement closes earlier incidents
    last_armistice_news = -1         # FarNews ordering within that same minute
    last_armistice_event = -1        # separate core Event namespace

struct SpeechCandidate:
    key: str
    text: str
    priority = 100
    event = -1
    source_person = -1
    confidence = 1000
    private = false
    job = -1
    far_news = -1
    commission = -1
    mission = -1
    ask: TalkQuestion = TalkQuestion(.none,"","")

# Saved identity/venue context for the abstract far-world tier, without fictional actors/stock.
struct LifePlaceContext:
    id: int
    name: str
    country: int
    region: int
    center: vec3
    aviation = false
    detailed = -1
    neighbors: int[]
    venues: LifeVenue[]

# ---------------- the hotel's band, as people ----------------
# The Hotel Ancora's musicians are townspeople with the rest of their day (src/band_life.jo): of an
# evening they come to the terrace, sit at their table, walk to the stand when a number needs them,
# step up, play, put the instrument away and step down. The number waits for its players.

# A number of the set as the world knows it (published by the scene: the hotel's geometry, the
# music's length): who plays it and where. Roles: 0 the singer, 1 the pianist, 2 guitar or bass,
# 3 violin, mandolin or reeds.
struct BandNumber:
    ticks = 0                       # its length
    roles: int[]                    # who it needs
    spots: vec3[]                   # where each role plays, on the stand (by role, four)
    steps: vec3[]                   # where each steps up, on the terrace's deck at the stand's edge
    yaws: f64[]                     # the way each faces, playing

struct BandState:
    numbers: BandNumber[]           # the set (none: no band here)
    opens = 1140                    # the evening's music, local minutes
    closes = 1410
    gap = 420                       # ticks between numbers
    evening = -1                    # the day the state is for
    played = 0                      # numbers of the set played this evening (the set goes on from here)
    index = -1                      # the number now, playing or waiting for its players (-1: none)
    request = false                 # (it was asked for)
    last = -1                       # (the number whose places the called are in, between numbers)
    start = -1                      # the tick it starts (-1: its players aren't all up yet)
    ends = -1
    rest_until = -1                 # (no number chosen before this tick: the pause between numbers)
    called: int[]                   # people called to the stand for it
    roles: int[]                    # (their roles)
    up: int[]                       # the tick each stepped up (-1: still on the way)
    packing: int[]                  # people putting their instrument away and stepping down
    packing_role: int[]
    packing_number: int[]           # (the number whose place they leave)
    packing_until: int[]            # (the tick they are down)
    queue: int[]                    # numbers asked for, in order
    fetched: int[]                  # musicians sent for
    fetched_minute: int[]           # (when)
