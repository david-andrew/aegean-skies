# Streaming builders (towns, terrain tiles, grass) each take a slice of every frame. While
# frames are quick each takes its full slice; as the time between frames nears 45 ms the
# slices shrink, down to a millisecond, so a slow machine's frames stay clear of 50 ms while
# the work still moves on. Without build_slice_tick (tools, tests) slices are whole.
const BUILD_SLICE_TARGET = 0.045
build_slice_interval = 0.0        # (smoothed, seconds)
build_slice_at = -1.0

# Once a frame, at its start.
build_slice_tick = ():
    global build_slice_interval,build_slice_at
    now = time()
    if build_slice_at >= 0.0:
        dt = min(now-build_slice_at,0.25)
        build_slice_interval = if build_slice_interval <= 0.0: dt else: build_slice_interval*0.8+dt*0.2
    build_slice_at = now

build_slice = (full: f64) -> f64:
    if build_slice_interval <= 0.0: return full
    clamp(BUILD_SLICE_TARGET-build_slice_interval,0.001,full)
