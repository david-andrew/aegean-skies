use 'music_data.jo'
use 'radio_synth.jo'
# Read-only broadcast copy. News comes from a station's public received-news queue, never the
# global event log, private knowledge or unvisited cargo. No facts are taught to NPCs here.
use 'radio.jo'
import 'living_types.jo' as world_data
import 'living_text.jo' as words
import 'living_conditions.jo' as conditions

radio_news_place = (w: world_data.World, station: RadioStation) -> int:
    if station.country >= 0:
        if station.country < w.countries.len():
            seat = w.countries[station.country].seat
            if seat >= 0 and seat < w.places.len(): return seat
        loop i in 0..min(w.places.len(),w.place_country.len()):
            if w.place_country[i] == station.country: return i
        return -1
    if station.home >= 0 and station.home < w.places.len(): station.home else: -1

radio_public_news = (w: world_data.World, station: RadioStation) -> RadioContent:
    result = RadioContent("News bulletin","No fresh verified reports have reached this station.","{station.callsign} QRU")
    home = radio_news_place(w,station)
    if home < 0: return result
    best = -1; score = -1
    loop i in 0..w.places[home].news.len():
        n = w.places[home].news[i]
        age = w.minute-n.occurred_minute
        if n.private_fact or n.event < 0 or n.confidence < 600 or n.hops > 4 or age < 0 or age >= 1440 or n.learned_minute > w.minute: continue
        # Quiet contact and private commercial motives are not broadcast material.
        if n.kind == .met: continue
        value = n.severity*n.confidence*(1440-age)/1440
        if value > score or (value == score and best >= 0 and n.event > w.places[home].news[best].event): best = i; score = value
    if best < 0: return result
    n = w.places[home].news[best]
    actor = words.person_name(w,n.reason.actor)
    place = words.place_name(n.origin)
    uncertain = if n.confidence < 1000: "An unconfirmed report: " else: "The harbor office reports: "
    headline = match n.kind:
        .raid, .theft: "An attack on cargo was reported near {place}."
        .rescue: "A rescue was reported near {place}."
        .ditch: "An aircraft came down near {place}."
        .closure: "The harbor at {place} was closed by weather."
        .shortage: "A shortage was reported at {place}."
        .delivery: "{actor} delivered goods at {place}."
        .repair: "{actor}'s aircraft was serviced at {place}."
        .arrived: "{actor} arrived at {place}."
        .departed: "{actor} departed from {place}."
        .fine: "The harbor authority issued a fine at {place}."
        else: "The harbor office at {place} reports {n.kind}."
    # Date is occurrence time, not retelling time. No assertion that yesterday's closure is current.
    stamp = radio_local_minute(n.occurred_minute)
    result.text = "{uncertain}{headline} Report time {stamp/60:02}:{stamp%60:02}; {w.minute-n.occurred_minute} game minutes ago."
    code = match n.kind:
        .raid, .theft: "ATK"
        .rescue: "RES"
        .ditch: "DITCH"
        .closure: "SHUT"
        .shortage: "LOW"
        .delivery: "DLV"
        .repair: "FIX"
        .arrived: "ARR"
        .departed: "DEP"
        .fine: "FINE"
        else: "NEWS"
    result.code = "{station.callsign} {code}"
    result.event = n.event; result.occurred_minute = n.occurred_minute; result.confidence = n.confidence
    result

radio_weather_content = (w: world_data.World, station: RadioStation, shipping: bool) -> RadioContent:
    # Official service observations at public harbors, not a prediction of future weather cells.
    place = if station.home >= 0 and station.home < w.harbors.len(): station.home else: if w.harbors.len() > 0: 0 else: -1
    if place < 0: return RadioContent("Maritime service","No harbor observations available.","SEA QRU")
    if shipping:
        closed: str[]
        loop p in 0..w.places.len():
            if w.places[p].harbor_closed: closed.push(words.place_name(p))
        if closed.len() > 0:
            return RadioContent("Shipping notices","Harbor closures in effect: {join(closed,", ")}. Vessels should await the harbor signal.","SEA PORT SHUT")
        return RadioContent("Shipping notices","No harbor closure orders are in effect. Keep the marked channels clear and obey the harbor signal.","SEA PORT OPEN")
    pos = w.harbors[place].center
    severity = conditions.weather_severity(w,pos)
    wind = conditions.wind_at(w,pos)
    # wind_at is the direction the air travels; reports name the direction it comes FROM.
    from = if abs(wind.x) > abs(wind.z): (if wind.x > 0: "west" else: "east") else: (if wind.z > 0: "north" else: "south")
    speed = f64(length(wind))
    weather = if severity >= 800: "storm conditions" else: if severity >= 400: "squalls" else: "fair conditions"
    RadioContent("Weather observations","At {words.place_name(place)}: {weather}; wind from the {from}, {speed:.0} metres per second. This is an observation, not a forecast.","SEA {if severity >= 800: "STORM" else: if severity >= 400: "SQUALL" else: "FAIR"}")

radio_content = (w: world_data.World, station: RadioStation, programme: RadioProgramme) -> RadioContent:
    match programme:
        .news: radio_public_news(w,station)
        .weather: radio_weather_content(w,station,false)
        .shipping: radio_weather_content(w,station,true)
        .editorial:
            slogan = match station.country:
                0: "From island to island, our strength is the work we share. Buy from your harbor; keep the sea lanes open."
                1: "Kalyra's workshops and farms are the nation's pride. Steady work today builds a stronger tomorrow."
                else: "Orenthia calls for discipline and public service. Stand together; honor the crews who carry our trade."
            RadioContent("State editorial","{station.name}: {slogan}","{station.callsign} CIV")
        .advert: RadioContent("Paid announcement","Blue Lantern coffee: a warm cup on a cold pier. Ask for the blue tin at your grocer's. A fictional sponsor.","BLU AD")
        .quiz: RadioContent("Night Gull quiz","Which travels farther after sunset: our radio signal or a harbor clerk's promise? The radio signal. No prizes, friends, only another tune.","GUL QUIZ")
        .music:
            style = radio_music_style(station,w.minute)
            seed = max(0,(w.minute+570)/30)*7+station.id
            piece = MUSIC_PIECES[radio_piece(style,seed)]
            RadioContent(piece.title,piece.composer+" — performed by the station orchestra.","")
        else: RadioContent()

# Content changes at five-game-minute bulletin boundaries (fifteen for maritime), or on tuning. This keeps
# one intelligible Morse message together while the world continues ticking behind it.
struct RadioBulletinCache:
    slot = -1000000
    station = -2
    programme: RadioProgramme = .off_air

radio_update_content = (r: mut Radio, cache: mut RadioBulletinCache, w: world_data.World):
    span = if r.programme == .weather or r.programme == .shipping: 15 else: 5
    slot = (w.minute+570)/span
    if cache.slot == slot and cache.station == r.station and cache.programme == r.programme: return
    cache.slot = slot; cache.station = r.station; cache.programme = r.programme
    r.content = if r.station >= 0: radio_content(w,r.stations[r.station],r.programme) else: RadioContent()

# Prepare fixed transmitter heights once after world height data is loaded. No terrain calls
# per audio sample; the runtime only samples the selected path at 2 Hz.
radio_place_transmitters = (r: mut Radio, ground: (f64,f64) -> f64):
    loop k in 0..r.stations.len():
        p = r.stations[k].transmitter
        r.stations[k].transmitter.y = f32(max(0.0,ground(f64(p.x),f64(p.z)))+65.0)
