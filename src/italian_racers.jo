# The three Italian racers of 1929-31, built part by part in the same painted low-poly kit as the
# others (planes.jo's frame: forward -z, right +x, up +y, metres, origin near the CG):
#   Macchi M.C.72         twin floats, a long nose, a coaxial pair of contra-rotating props
#   Savoia-Marchetti S.65 a short nacelle, engines fore and aft (tractor and pusher), twin booms
#   Piaggio P.7           a sealed hull floating low, wings on the water, three hydrofoils and a
#                         water screw under the tail
# Each builds into planes.jo's seven part bins (body, engine, left/right wing, left/right float,
# tail); the P.7's "floats" are its two forward hydrofoils. The livery's body is the racing red,
# its trim the cream and its accent the green of the tricolour on the rudders.
use 'look.jo'
use 'aircraft_catalog.jo'
use 'hydrofoil.jo'

struct RacerSection:
    z: f64
    w: f64
    top: f64
    bottom: f64
    keel: f64 = 0.0

struct RacerBuild:
    bins: Vertex3D[][]
    hubs: vec3[]
    spins: f64[]
    contacts: vec3[]
    cockpit: vec3
    exit: vec3
    shade: vec3[]

const BRASS = vec4(0.70, 0.53, 0.27, 1.0)      # the surface radiators: flat copper-brass tubes
const DARK = vec4(0.13, 0.12, 0.11, 1.0)
const METAL = vec4(0.52, 0.53, 0.54, 1.0)
const GLASS = vec4(0.66, 0.8, 0.84, 1.0)

_t = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    vs.push(Vertex3D(a, n, vec2(0, 0), col)); vs.push(Vertex3D(b, n, vec2(0, 0), col)); vs.push(Vertex3D(c, n, vec2(0, 0), col))

_q = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, col: vec4):
    _t(vs, a, b, c, col); _t(vs, a, c, d, col)

# a quad seen from both sides (a fin, a thin plate)
_plate = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, col: vec4):
    _q(vs, a, b, c, d, col); _q(vs, a, d, c, b, col)

_bx = (vs: mut Vertex3D[], c: vec3, h: vec3, col: vec4, m: mat4 = mat4()):
    add_box(vs, c, h * 2.0, col, m)

_st = (vs: mut Vertex3D[], a: vec3, b: vec3, r: f64, col: vec4, flat: f64 = 1.0):
    d = b - a
    _bx(vs, vec3(0, 0, 0), vec3(f32(r), f32(r * flat), f32(f64(length(d)) * 0.5)), col, translation((a + b) * 0.5) * facing(d))

# A body lofted through eight-sided sections, as planes.jo's loft (a V keel when keel > 0).
_loft = (vs: mut Vertex3D[], secs: RacerSection[], center: vec3, col: vec4, under: vec4):
    ring = (s: RacerSection) -> vec3[]:
        c = center + vec3(0, 0, s.z); w = s.w
        [c + vec3(-w * 0.55, s.top, 0), c + vec3(w * 0.55, s.top, 0), c + vec3(w, s.top * 0.45, 0),
         c + vec3(w, -s.bottom * 0.5, 0), c + vec3(w * 0.5, -s.bottom, 0), c + vec3(0, -s.bottom - s.keel, 0),
         c + vec3(-w * 0.5, -s.bottom, 0), c + vec3(-w, -s.bottom * 0.5, 0), c + vec3(-w, s.top * 0.45, 0)]
    loop k in 0..secs.len() - 1:
        a = ring(secs[k]); b = ring(secs[k + 1])
        loop i in 0..a.len():
            j = (i + 1) % a.len()
            _q(vs, a[i], b[i], b[j], a[j], if i >= 3 and i <= 6: under else: col)
    loop e in [0, secs.len() - 1]:
        r = ring(secs[e]); c = center + vec3(0, 0, secs[e].z)
        loop i in 0..r.len():
            j = (i + 1) % r.len()
            if e == 0: _t(vs, c, r[i], r[j], col) else: _t(vs, c, r[j], r[i], col)

_float = (vs: mut Vertex3D[], c: vec3, len: f64, w: f64, col: vec4, under: vec4):
    l = len; h = w
    _loft(vs, [RacerSection(-l * 0.5, h * 0.22, h * 0.32, h * 0.1), RacerSection(-l * 0.36, h * 0.9, h * 0.66, h * 0.55, h * 0.2),
        RacerSection(-l * 0.04, h, h * 0.72, h * 0.75, h * 0.25), RacerSection(l * 0.05, h, h * 0.72, h * 0.75, h * 0.25),
        RacerSection(l * 0.07, h * 0.94, h * 0.7, h * 0.45, h * 0.15), RacerSection(l * 0.5, h * 0.22, h * 0.4, h * 0.08)], c, col, under)

# A thin metal monoplane wing, tapered with rounded tips: a ridge at a third of the chord, a sharp
# trailing edge. `radiator` (0..1 of the semispan) lays the flat brass radiator over the upper
# surface out to that station; `owner` gives each half its bin.
_wing_station = (c: vec3, side: f64, u: f64, span: f64, chord: f64, w: f64, thick: f64, dihedral: f64) -> vec3[]:
    x = side * u * span * 0.5
    y = u * span * 0.5 * dihedral
    hz = chord * w * 0.5
    t = thick * (0.55 + 0.45 * w)
    o = c + vec3(x, y, 0)
    # leading edge, ridge top, trailing edge, ridge bottom
    [o + vec3(0, t * 0.35, -hz), o + vec3(0, t, -hz * 0.3), o + vec3(0, 0, hz), o + vec3(0, -t * 0.25, -hz * 0.3)]

_racer_wing = (bins: mut Vertex3D[][], c: vec3, span: f64, chord: f64, taper: f64, thick: f64, col: vec4, tip: vec4, radiator: f64 = 0.0, dihedral: f64 = 0.04, left: int = 2, right: int = 3):
    us = [0.0, 0.5, 0.82, 0.95, 1.0]
    ws = [1.0, 0.5 + 0.5 * taper, taper, taper * 0.7, taper * 0.28]
    loop side in [-1.0, 1.0]:
        id = if side < 0: left else: right
        loop i in 0..us.len() - 1:
            a = _wing_station(c, side, us[i], span, chord, ws[i], thick, dihedral)
            b = _wing_station(c, side, us[i + 1], span, chord, ws[i + 1], thick, dihedral)
            k = if i >= 3: tip else: col
            loop j in 0..4:
                n = (j + 1) % 4
                if side > 0: _q(bins[id], a[j], a[n], b[n], b[j], k) else: _q(bins[id], a[j], b[j], b[n], a[n], k)
            if i == us.len() - 2:
                if side > 0: _q(bins[id], b[0], b[1], b[2], b[3], k) else: _q(bins[id], b[0], b[3], b[2], b[1], k)
        if radiator > 0.0:
            # (2 cm proud of the skin: one flat panel each side of the ridge)
            r0 = 0.09; r1 = radiator
            a = _wing_station(c, side, r0, span, chord, 1.0 - (1.0 - ws[1]) * r0 / 0.5, thick, dihedral)
            b = _wing_station(c, side, r1, span, chord, if r1 <= 0.5: 1.0 - (1.0 - ws[1]) * r1 / 0.5 else: ws[1] + (ws[2] - ws[1]) * (r1 - 0.5) / 0.32, thick, dihedral)
            up = vec3(0, 0.02, 0)
            fa = a[0] * 0.8 + a[1] * 0.2 + up; fb = b[0] * 0.8 + b[1] * 0.2 + up
            ra = a[2] * 0.85 + a[1] * 0.15 + up; rb = b[2] * 0.85 + b[1] * 0.15 + up
            if side > 0:
                _q(bins[id], fa, a[1] + up, b[1] + up, fb, BRASS); _q(bins[id], a[1] + up, ra, rb, b[1] + up, BRASS)
            else:
                _q(bins[id], fa, fb, b[1] + up, a[1] + up, BRASS); _q(bins[id], a[1] + up, b[1] + up, rb, ra, BRASS)

# A tail surface: a tapered flat plate pair (top and bottom faces), for tailplanes and foils.
_tail_plane = (vs: mut Vertex3D[], c: vec3, span: f64, chord: f64, taper: f64, col: vec4, thick: f64 = 0.06, dihedral: f64 = 0.0):
    loop side in [-1.0, 1.0]:
        tip = c + vec3(side * span * 0.5, span * 0.5 * dihedral, chord * (1.0 - taper) * 0.25)
        a = c + vec3(0, 0, -chord * 0.5); b = c + vec3(0, 0, chord * 0.5)
        d = tip + vec3(0, 0, -chord * taper * 0.5); e = tip + vec3(0, 0, chord * taper * 0.5)
        h = vec3(0, thick * 0.5, 0)
        if side > 0:
            _q(vs, a + h, d + h, e + h, b + h, col); _q(vs, a - h, b - h, e - h, d - h, col)
            _q(vs, a + h, a - h, d - h, d + h, col); _q(vs, d + h, d - h, e - h, e + h, col); _q(vs, e + h, e - h, b - h, b + h, col)
        else:
            _q(vs, a + h, b + h, e + h, d + h, col); _q(vs, a - h, d - h, e - h, b - h, col)
            _q(vs, a + h, d + h, d - h, a - h, col); _q(vs, d + h, e + h, e - h, d - h, col); _q(vs, e + h, b + h, b - h, e - h, col)

# A fin and rudder from the root (base, z0..z1) up to the top (z2..z3), the rudder in three upright
# stripes, green, white and red, front to back; a little thickness so both sides shade.
_fin = (vs: mut Vertex3D[], x: f64, base: f64, top: f64, z0: f64, z1: f64, z2: f64, z3: f64, body: vec4, lv_trim: vec4, lv_accent: vec4, lv_body: vec4, down: bool = false):
    s = if down: -1.0 else: 1.0
    hw = 0.035
    split = 0.55
    loop side in [-1.0, 1.0]:
        o = vec3(x + side * hw, 0, 0)
        p0 = o + vec3(0, base, z0); p1 = o + vec3(0, base, z0 + (z1 - z0) * split)
        p2 = o + vec3(0, top, z2 + (z3 - z2) * split); p3 = o + vec3(0, top, z2)
        if side * s > 0: _q(vs, p0, p3, p2, p1, body) else: _q(vs, p0, p1, p2, p3, body)
        # the rudder: three stripes across its chord
        cols = [lv_accent, lv_trim, lv_body]
        loop k in 0..3:
            f0 = split + (1.0 - split) * f64(k) / 3.0; f1 = split + (1.0 - split) * f64(k + 1) / 3.0
            a = o + vec3(0, base, z0 + (z1 - z0) * f0); b = o + vec3(0, base, z0 + (z1 - z0) * f1)
            c = o + vec3(0, top, z2 + (z3 - z2) * f1); d = o + vec3(0, top, z2 + (z3 - z2) * f0)
            if side * s > 0: _q(vs, a, d, c, b, cols[k]) else: _q(vs, a, b, c, d, cols[k])
    # the edges
    a = vec3(x, base, z0); b = vec3(x, top, z2); c = vec3(x, top, z3); d = vec3(x, base, z1)
    h = vec3(hw, 0, 0)
    _q(vs, a - h, a + h, b + h, b - h, body); _q(vs, b - h, b + h, c + h, c - h, body); _q(vs, c - h, c + h, d + h, d - h, lv_body)
    if down: _q(vs, b - h, c - h, c + h, b + h, body)

_cockpit = (vs: mut Vertex3D[], c: vec3, trim: vec4):
    _bx(vs, c, vec3(0.28, 0.025, 0.4), DARK)
    loop side in [-1.0, 1.0]: _st(vs, c + vec3(side * 0.3, 0.03, -0.4), c + vec3(side * 0.3, 0.03, 0.4), 0.03, trim)
    _st(vs, c + vec3(-0.3, 0.03, 0.4), c + vec3(0.3, 0.03, 0.4), 0.03, trim)
    # a small racing windscreen, raked back
    _q(vs, c + vec3(-0.24, 0.02, -0.42), c + vec3(0.24, 0.02, -0.42), c + vec3(0.2, 0.22, -0.3), c + vec3(-0.2, 0.22, -0.3), GLASS)
    _q(vs, c + vec3(-0.24, 0.02, -0.42), c + vec3(-0.2, 0.22, -0.3), c + vec3(0.2, 0.22, -0.3), c + vec3(0.24, 0.02, -0.42), GLASS)

_exhausts = (vs: mut Vertex3D[], x: f64, y: f64, z0: f64, z1: f64, count: int):
    loop j in 0..count:
        z = z0 + (z1 - z0) * f64(j) / f64(max(count - 1, 1))
        loop side in [-1.0, 1.0]:
            _bx(vs, vec3(side * x, y, z), vec3(0.05, 0.035, 0.05), DARK)

_spinner = (vs: mut Vertex3D[], tip: vec3, base_z: f64, r: f64, col: vec4):
    # a cone from base_z out to the tip (either way along z)
    dz = f64(tip.z) - base_z
    m = translation(vec3(tip.x, tip.y, f32(base_z))) * rotation_x(if dz < 0: -PI / 2 else: PI / 2)
    add_cylinder(vs, vec3(0, 0, 0), r, abs(dz), col, 10, 0.0, m)

# A propeller with its blades' twist of either hand: contra-rotating and pusher props (spin -1)
# are mirror images of the tractor's, so each one's blades meet the air the right way round.
racer_prop = (radius: f64, blades: int, hand: f64) -> Mesh:
    vs: Vertex3D[]
    loop b in 0..blades:
        m = rotation_z(f64(b) / f64(blades) * TAU)
        _bx(vs, vec3(0, f32(radius * 0.46), 0), vec3(0.085, f32(radius * 0.44), 0.028), vec4(0.6, 0.6, 0.6, 1.0), m * rotation_y(0.35 * hand))
        _bx(vs, vec3(0, f32(radius * 0.92), 0), vec3(0.09, f32(radius * 0.08), 0.03), vec4(0.85, 0.8, 0.6, 1.0), m * rotation_y(0.35 * hand))
    custom_mesh(vs)

_shade = (out: mut vec3[], c: vec3, h: vec3):
    out.push(c); out.push(h)

# ---------------- Macchi M.C.72 ----------------

_mc72 = (p: AircraftProfile, body: vec4, trim: vec4, accent: vec4) -> RacerBuild:
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    under = body * 0.82; under.w = 1.0
    # The long nose of the AS.6, the cockpit far aft of the wing, the fuselage tapering to the tail.
    _loft(bins[0], [RacerSection(-4.15, 0.22, 0.24, 0.24), RacerSection(-3.95, 0.4, 0.42, 0.42), RacerSection(-3.2, 0.46, 0.5, 0.5),
        RacerSection(-1.0, 0.5, 0.55, 0.55), RacerSection(0.6, 0.47, 0.56, 0.5), RacerSection(1.6, 0.4, 0.55, 0.42),
        RacerSection(2.6, 0.28, 0.42, 0.3)], vec3(0, 0, 0), body, under)
    _loft(bins[6], [RacerSection(2.6, 0.28, 0.42, 0.3), RacerSection(4.2, 0.06, 0.32, 0.08)], vec3(0, 0, 0), body, under)
    # the oil tank's bare metal ring behind the spinner, and the two rows of exhaust stubs
    add_cylinder(bins[1], vec3(0, 0, 0), 0.43, 0.22, METAL, 12, 0.43, translation(vec3(0, 0, -3.95)) * rotation_x(PI / 2))
    _exhausts(bins[1], 0.47, 0.2, -3.5, -1.5, 8)
    _exhausts(bins[1], 0.47, 0.02, -3.45, -1.45, 8)
    # the headrest fairing behind the cockpit
    _loft(bins[0], [RacerSection(1.45, 0.17, 0.2, 0.01), RacerSection(2.9, 0.04, 0.03, 0.01)], vec3(0, 0.5, 0), body, body)
    seat = vec3(0, 0.52, p.cockpit_z)
    _cockpit(bins[0], seat, trim)
    # the wing, its radiators over most of the upper surface
    _racer_wing(bins, vec3(0, p.wing_y, -0.4), p.span, p.chord, p.taper, 0.16, body, trim, 0.8)
    # the tail: a braced tailplane, the fin and rudder, a small fin below
    _tail_plane(bins[6], vec3(0, 0.18, 3.75), 3.1, 0.95, 0.6, body)
    _fin(bins[6], 0.0, 0.25, 1.35, 3.25, 4.25, 3.8, 4.35, body, trim, accent, body)
    _fin(bins[6], 0.0, -0.05, -0.55, 3.6, 4.2, 3.95, 4.25, body, trim, accent, body, down = true)
    # floats, carrying radiators on their outer sides, and the struts (radiators too)
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        fx = side * p.float_x
        _float(bins[id], vec3(fx, p.float_y, -0.5), 6.5, 0.42, body, under)
        loop k in 0..3:
            z = -1.9 + f64(k) * 1.15
            _bx(bins[id], vec3(fx + side * 0.405, p.float_y + 0.02, z), vec3(0.012, 0.13, 0.48), BRASS)
        loop z in [-1.55, 0.55]:
            _st(bins[id], vec3(fx, p.float_y + 0.28, z), vec3(side * 0.38, -0.45, z + 0.1), 0.05, BRASS, 0.45)
            _st(bins[id], vec3(fx, p.float_y + 0.28, z), vec3(fx * 1.15, p.wing_y - 0.04, z + 0.15), 0.035, BRASS, 0.5)
        # bracing wires from the float bows to the wing and across
        _st(bins[id], vec3(fx, p.float_y + 0.25, -2.6), vec3(side * 2.6, p.wing_y - 0.03, -0.6), 0.012, METAL)
        _st(bins[id], vec3(fx, p.float_y + 0.25, -1.55), vec3(-fx * 0.9, -0.5, -1.4), 0.012, METAL)
    # the spinner over the two hubs; front rotor and the rear one just behind it
    _spinner(bins[1], vec3(0, 0, -5.0), -4.15, 0.24, METAL)
    hubs = italian_racer_hubs(p)
    contacts: vec3[]
    loop z in [-2.75, -0.5, 1.4]:
        loop side in [-1.0, 1.0]: contacts.push(vec3(side * p.float_x, p.float_y - (if z == -0.5: 0.5 else: 0.4), z))
    shade: vec3[]
    _shade(shade, vec3(0, 0, -0.3), vec3(0.5, 0.5, 4.3))
    _shade(shade, vec3(0, p.wing_y, -0.4), vec3(p.span * 0.5, 0.08, p.chord * 0.5))
    _shade(shade, vec3(-p.float_x, p.float_y, -0.5), vec3(0.42, 0.3, 3.25))
    _shade(shade, vec3(p.float_x, p.float_y, -0.5), vec3(0.42, 0.3, 3.25))
    _shade(shade, vec3(0, 0.18, 3.75), vec3(1.55, 0.05, 0.45))
    RacerBuild(bins, hubs, [1.0, -1.0], contacts, seat + vec3(0, 0.36, 0), vec3(p.float_x, p.float_y + 0.42, -0.5), shade)

# ---------------- Savoia-Marchetti S.65 ----------------

_s65 = (p: AircraftProfile, body: vec4, trim: vec4, accent: vec4) -> RacerBuild:
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    under = body * 0.82; under.w = 1.0
    # The nacelle: the front engine, the pilot between, the rear engine and its pusher.
    _loft(bins[0], [RacerSection(-3.25, 0.2, 0.22, 0.22), RacerSection(-3.05, 0.4, 0.42, 0.42), RacerSection(-1.3, 0.5, 0.55, 0.52),
        RacerSection(0.3, 0.5, 0.6, 0.52), RacerSection(1.85, 0.36, 0.42, 0.4), RacerSection(2.2, 0.22, 0.24, 0.24)], vec3(0, 0, 0), body, under)
    add_cylinder(bins[1], vec3(0, 0, 0), 0.41, 0.18, METAL, 12, 0.41, translation(vec3(0, 0, -3.1)) * rotation_x(PI / 2))
    _exhausts(bins[1], 0.5, 0.18, -2.75, -1.5, 6)
    _exhausts(bins[1], 0.5, 0.18, 0.55, 1.6, 6)
    # a hump behind the cockpit over the rear engine's top
    _loft(bins[0], [RacerSection(0.0, 0.2, 0.18, 0.01), RacerSection(1.3, 0.1, 0.05, 0.01)], vec3(0, 0.56, 0), body, body)
    seat = vec3(0, 0.56, p.cockpit_z)
    _cockpit(bins[0], seat, trim)
    _racer_wing(bins, vec3(0, p.wing_y, -0.35), p.span, p.chord, p.taper, 0.15, body, trim, 0.7)
    # twin booms from the wing's trailing edge to the tail, the tailplane between, twin fins
    tail_z = 4.75
    loop side in [-1.0, 1.0]:
        bx = side * p.float_x
        _loft(bins[6], [RacerSection(0.0, 0.13, 0.14, 0.14), RacerSection(2.0, 0.11, 0.12, 0.12), RacerSection(tail_z + 0.55, 0.06, 0.08, 0.08)],
            vec3(bx, 0.0, 0.0), body, under)
        _st(bins[6], vec3(bx, p.wing_y + 0.05, 0.25), vec3(bx, -0.05, 0.6), 0.06, body)
        _fin(bins[6], bx, 0.08, 1.05, tail_z - 0.45, tail_z + 0.45, tail_z - 0.05, tail_z + 0.5, body, trim, accent, body)
    _tail_plane(bins[6], vec3(0, 0.12, tail_z), 2.0 * p.float_x + 0.9, 0.78, 0.75, body)
    # long floats running far aft, struts to the nacelle and wing, a strut up to each boom
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        fx = side * p.float_x
        _float(bins[id], vec3(fx, p.float_y, 0.3), 7.0, 0.4, body, under)
        loop z in [-1.45, 0.55]:
            _st(bins[id], vec3(fx, p.float_y + 0.27, z), vec3(side * 0.4, -0.42, z + 0.1), 0.045, under, 0.5)
            _st(bins[id], vec3(fx, p.float_y + 0.27, z), vec3(fx, p.wing_y - 0.04, z + 0.1), 0.04, under, 0.5)
        _st(bins[id], vec3(fx, p.float_y + 0.2, 3.35), vec3(fx, -0.08, 3.6), 0.04, under, 0.5)
        _st(bins[id], vec3(fx, p.float_y + 0.25, -2.6), vec3(side * 2.4, p.wing_y - 0.03, -0.5), 0.012, METAL)
    _spinner(bins[1], vec3(0, 0, -3.75), -3.25, 0.2, accent)
    _spinner(bins[1], vec3(0, 0, 2.75), 2.2, 0.2, accent)
    hubs = italian_racer_hubs(p)
    contacts: vec3[]
    loop z in [-2.65, 0.1, 3.0]:
        loop side in [-1.0, 1.0]: contacts.push(vec3(side * p.float_x, p.float_y - (if z == 0.1: 0.48 else: 0.38), z))
    shade: vec3[]
    _shade(shade, vec3(0, 0, -0.5), vec3(0.5, 0.5, 2.75))
    _shade(shade, vec3(0, p.wing_y, -0.35), vec3(p.span * 0.5, 0.08, p.chord * 0.5))
    _shade(shade, vec3(-p.float_x, p.float_y, 0.3), vec3(0.4, 0.3, 3.5))
    _shade(shade, vec3(p.float_x, p.float_y, 0.3), vec3(0.4, 0.3, 3.5))
    _shade(shade, vec3(0, 0.12, tail_z), vec3(p.float_x + 0.45, 0.05, 0.39))
    RacerBuild(bins, hubs, [1.0, -1.0], contacts, seat + vec3(0, 0.36, 0), vec3(p.float_x, p.float_y + 0.4, 0.3), shade)

# ---------------- Piaggio P.7 ----------------

_p7 = (p: AircraftProfile, body: vec4, trim: vec4, accent: vec4) -> RacerBuild:
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    under = body * 0.8; under.w = 1.0
    # A sealed, rounded racing hull, deepest under the wing; its lower half sits in the water.
    _loft(bins[0], [RacerSection(-4.35, 0.17, 0.2, 0.2), RacerSection(-4.1, 0.36, 0.4, 0.42), RacerSection(-2.5, 0.48, 0.5, 0.55),
        RacerSection(-0.5, 0.5, 0.52, 0.56, 0.04), RacerSection(1.4, 0.42, 0.5, 0.5, 0.02), RacerSection(2.8, 0.26, 0.36, 0.32)], vec3(0, 0, 0), body, under)
    _loft(bins[6], [RacerSection(2.8, 0.26, 0.36, 0.32), RacerSection(4.35, 0.06, 0.3, 0.12)], vec3(0, 0, 0), body, under)
    add_cylinder(bins[1], vec3(0, 0, 0), 0.38, 0.16, METAL, 12, 0.38, translation(vec3(0, 0, -4.15)) * rotation_x(PI / 2))
    _exhausts(bins[1], 0.48, 0.2, -3.8, -2.2, 6)
    _loft(bins[0], [RacerSection(1.4, 0.16, 0.18, 0.01), RacerSection(2.9, 0.04, 0.03, 0.01)], vec3(0, 0.48, 0), body, body)
    seat = vec3(0, 0.5, p.cockpit_z)
    _cockpit(bins[0], seat, trim)
    _racer_wing(bins, vec3(0, p.wing_y, -0.2), p.span, p.chord, p.taper, 0.15, body, trim, 0.0, 0.03)
    _tail_plane(bins[6], vec3(0, 0.22, 3.85), 2.4, 0.8, 0.6, body)
    _fin(bins[6], 0.0, 0.28, 1.25, 3.4, 4.3, 3.9, 4.4, body, trim, accent, body)
    # The hydrofoils, at P7_FOILS' points (the physics' own): the two forward ones each on a pair
    # of struts from the hull's underside, just ahead of the wing; the small one under the tail, on
    # the strut that also carries the water screw's shaft.
    foils = P7_FOILS
    loop i in 0..2:
        f = foils[i]
        side = if f.point.x < 0: -1.0 else: 1.0
        id = if side < 0: 4 else: 5
        _tail_plane(bins[id], f.point, f.span, f.chord, 0.7, METAL, 0.04, -0.12)
        loop dz in [-0.1, 0.12]:
            _st(bins[id], f.point + vec3(-side * f.span * 0.2, 0.02, dz), vec3(side * 0.3, -0.48, f64(f.point.z) + dz - 0.05), 0.035, METAL, 0.4)
            _st(bins[id], f.point + vec3(side * f.span * 0.35, 0.03, dz), vec3(side * 0.45, -0.3, f64(f.point.z) + dz), 0.025, METAL, 0.4)
    rear = foils[2]
    _tail_plane(bins[6], rear.point, rear.span, rear.chord, 0.75, METAL, 0.035)
    _st(bins[6], rear.point + vec3(0, 0.02, -0.05), vec3(0, -0.2, f64(rear.point.z) - 0.25), 0.045, METAL, 0.35)
    # the water screw: a small three-bladed bronze screw behind the tail foil, on its shaft
    screw = P7_SCREW
    _st(bins[6], rear.point + vec3(0, 0.02, 0.08), screw, 0.03, METAL)
    loop b in 0..3:
        a = f64(b) * TAU / 3.0
        m = translation(screw) * rotation_z(a) * rotation_y(0.5)
        _bx(bins[6], vec3(0, 0.12, 0), vec3(0.06, 0.1, 0.012), vec4(0.62, 0.45, 0.22, 1.0), m)
    _spinner(bins[1], vec3(0, 0, -4.75), -4.35, 0.18, accent)
    hubs = italian_racer_hubs(p)
    # the hull's keel and chines; the wing tips' undersides hold her level at rest
    contacts = [vec3(0, -0.6, -2.6), vec3(-0.4, -0.5, -1.4), vec3(0.4, -0.5, -1.4), vec3(0, -0.6, 0.0),
        vec3(-0.4, -0.48, 0.9), vec3(0.4, -0.48, 0.9), vec3(0, -0.36, 2.6),
        vec3(-p.float_x, p.float_y, -0.2), vec3(p.float_x, p.float_y, -0.2)]
    shade: vec3[]
    _shade(shade, vec3(0, 0, 0), vec3(0.5, 0.5, 4.4))
    _shade(shade, vec3(0, p.wing_y, -0.2), vec3(p.span * 0.5, 0.08, p.chord * 0.5))
    _shade(shade, vec3(0, 0.22, 3.85), vec3(1.2, 0.05, 0.4))
    RacerBuild(bins, hubs, [1.0], contacts, seat + vec3(0, 0.36, 0), vec3(0.5, 0.45, 0.0), shade)

# The propeller hubs (CPU-only, for the physics' strike points too): the M.C.72's front rotor and
# the one just behind it, turning the other way; the S.65's tractor and pusher; the P.7's one.
italian_racer_hubs = (p: AircraftProfile) -> vec3[]:
    if p.contra: return [vec3(0, 0, -4.72), vec3(0, 0, -4.38)]
    if p.push_pull: return [vec3(0, 0, -3.5), vec3(0, 0, p.rear_z)]
    [vec3(0, 0, -4.55)]

# The racer's build, if `role` names one of these three (the profile's role is the key, so this
# file needs no Craft enum); none otherwise.
build_italian_racer = (p: AircraftProfile, body: vec4, trim: vec4, accent: vec4) -> RacerBuild?:
    if p.contra: return _mc72(p, body, trim, accent)
    if p.push_pull: return _s65(p, body, trim, accent)
    if p.hydrofoil: return _p7(p, body, trim, accent)
    none
