# Aircraft in Greek service: the Sopwith Greek Seaplane (1914, a twin-float pusher of the Hellenic
# Naval Air Service), the Sopwith Bat Boat Type 2 (1914, a pusher flying boat, here amphibian with
# wheels that fold, as the 1913 Type 1A's did), the Short Type 184 (1915, the twin-float torpedo
# seaplane of the Aegean, Ben-my-Chree and Mudros, and the Hellenic Navy) and the KEA Chelidon
# (1927, the Phaleron factory's two-seat trainer, a landplane). Built from the kit in planes.jo in the
# same frame and seven damage bins as aircraft_early.jo: 0 fuselage/hull/nacelle, 1 engine, 2/3
# left/right wings, 4/5 floats or wheels, 6 tail.
use 'planes.jo'
use 'aircraft_catalog.jo'

is_greek_craft = (kind: Craft) -> bool:
    kind == .sopwith_greek or kind == .sopwith_bat_boat or kind == .short_184 or kind == .kea_chelidon

# Wheels: the Chelidon's (a landplane: two mains and the tail skid) and the Bat Boat's folding pair
# with the skid under its stern. A little inside the tyres, as the C.R.20's.
greek_gear_contacts = (kind: Craft) -> vec3[]:
    if kind == .kea_chelidon: return [vec3(-0.75, -1.39, -0.95), vec3(0.75, -1.39, -0.95), vec3(0, -0.3, 2.72)]
    if kind == .sopwith_bat_boat: return [vec3(-1.05, -1.28, -1.0), vec3(1.05, -1.28, -1.0), vec3(0, -0.8, 1.55)]
    []

_gshade = (c: vec4, k: f64) -> vec4: vec4(c.x * f32(k), c.y * f32(k), c.z * f32(k), c.w)
const G_WOOD = vec4(0.45, 0.31, 0.18, 1)
const G_WIRE = vec4(0.22, 0.22, 0.21, 1)
const G_METAL = vec4(0.38, 0.38, 0.36, 1)
const G_DARK = vec4(0.14, 0.13, 0.12, 1)

_gwing = (bins: mut Vertex3D[][], kind: Craft, lv: Livery, c: vec3, span: f64, chord: f64, taper: f64, marks: bool):
    wing: Vertex3D[]
    kit_fabric_wing(wing, c, span, chord, taper, lv)
    kit_split_wings(bins, wing, kind)
    if marks:
        loop side in [-1.0, 1.0]: kit_wing_mark(bins[if side < 0: 2 else: 3], vec3(f32(side * span * 0.36), c.y + 0.205, c.z), lv, min(0.5, chord * 0.26))

# Interplane bays: upright pairs at the stations given (out from the centre), crossed wires in the
# front plane of each bay (the rear plane's hide behind them).
_gbays = (bins: mut Vertex3D[][], stations: f64[], lower_y: f64, upper_y: f64, front: f64, rear: f64, r: f64):
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        loop k in 0..stations.len():
            loop z in [front, rear]: kit_strut(bins[id], vec3(f32(side * stations[k]), f32(lower_y + 0.04), f32(z)), vec3(f32(side * stations[k]), f32(upper_y - 0.01), f32(z)), r, G_WOOD)
            if k > 0:
                a = stations[k - 1]; b = stations[k]
                kit_strut(bins[id], vec3(f32(side * a), f32(lower_y + 0.05), f32(front)), vec3(f32(side * b), f32(upper_y), f32(front)), 0.01, G_WIRE)
                kit_strut(bins[id], vec3(f32(side * b), f32(lower_y + 0.05), f32(front)), vec3(f32(side * a), f32(upper_y), f32(front)), 0.01, G_WIRE)

# An exposed radial: crankcase, `n` cylinders round it (two rows when `rows` is 2), facing -z
# (tractor) or +z (pusher). Bin 1.
_gradial = (vs: mut Vertex3D[], c: vec3, r: f64, n: int, rows: int, pusher: bool, lv: Livery):
    m = translation(c) * rotation_x(PI / 2)
    add_cylinder(vs, vec3(0, -0.18, 0), r * 0.36, 0.36, G_METAL, 10, -1.0, m)
    loop row in 0..rows:
        dz = (f64(row) - f64(rows - 1) * 0.5) * 0.17 * (if pusher: -1.0 else: 1.0)
        loop j in 0..n:
            a = (f64(j) + f64(row) * 0.5) * TAU / f64(n)
            kit_strut(vs, c + vec3(f32(cos(a) * r * 0.32), f32(sin(a) * r * 0.32), f32(dz)), c + vec3(f32(cos(a) * r), f32(sin(a) * r), f32(dz)), r * 0.15, vec4(0.5, 0.49, 0.46, 1))
    kit_spinner(vs, c + vec3(0, 0, f32(if pusher: 0.22 else: -0.22)), 0.1, lv.accent, pusher)

# A small stepped float (the kit's) on two struts to the wing above; bins 4/5 by side.
_gfloat = (bins: mut Vertex3D[][], c: vec3, len: f64, w: f64, lv: Livery, up: f64):
    id = if c.x < 0: 4 else: 5
    kit_float(bins[id], c, len, w, lv.body, _gshade(lv.body, 0.6))
    loop dz in [-len * 0.25, len * 0.2]: kit_strut(bins[id], c + vec3(0, f32(w * 0.6), f32(dz)), vec3(c.x, f32(up), c.z + f32(dz)), 0.03, G_WOOD)

# A wheel: tyre and hub across x at `c`, radius r.
_gwheel = (vs: mut Vertex3D[], c: vec3, r: f64, lv: Livery):
    m = translation(c) * rotation_z(PI / 2)
    add_cylinder(vs, vec3(0, -0.06, 0), r, 0.12, vec4(0.1, 0.1, 0.09, 1), 14, -1.0, m)
    add_cylinder(vs, vec3(0, -0.07, 0), r * 0.55, 0.14, lv.trim, 10, -1.0, m)

# A tail on four open booms from the wings' trailing edges, converging behind the propeller: the
# tailplane, and a rudder (with a fin when `fin`), in the accent with a white band. Bin 6.
_gboom_tail = (vs: mut Vertex3D[], lv: Livery, roots: vec3[], tail_z: f64, tail_y: f64, span: f64, chord: f64, fin: bool):
    loop r in roots:
        end = vec3(f32(if r.x < 0: -0.22 else: 0.22), f32(tail_y + (if f64(r.y) > tail_y + 0.4: 0.42 else: -0.12)), f32(tail_z))
        kit_strut(vs, r, end, 0.035, G_WOOD)
    # (uprights and wires between the booms, every metre and a half)
    loop k in 1..4:
        u = f32(k) / 4.0
        loop side in [-1.0, 1.0]:
            up = [loop r in roots: if f64(r.x) * side > 0 and f64(r.y) > tail_y + 0.4: r]
            lo = [loop r in roots: if f64(r.x) * side > 0 and f64(r.y) <= tail_y + 0.4: r]
            if up.len() == 0 or lo.len() == 0: continue
            a = up[0] + (vec3(f32(side * 0.22), f32(tail_y + 0.42), f32(tail_z)) - up[0]) * u
            b = lo[0] + (vec3(f32(side * 0.22), f32(tail_y - 0.12), f32(tail_z)) - lo[0]) * u
            kit_strut(vs, a, b, 0.022, G_WOOD)
    kit_fabric_wing(vs, vec3(0, f32(tail_y), f32(tail_z)), span, chord, 0.85, lv)
    if fin: kit_box(vs, vec3(0, f32(tail_y + 0.5), f32(tail_z + chord * 0.1)), vec3(0.04, 0.45, f32(chord * 0.32)), lv.body)
    rz = tail_z + chord * 0.55
    kit_box(vs, vec3(0, f32(tail_y + 0.35), f32(rz)), vec3(0.045, 0.75, 0.24), lv.accent)
    kit_box(vs, vec3(0, f32(tail_y + 0.35), f32(rz)), vec3(0.047, 0.14, 0.245), vec4(0.94, 0.93, 0.88, 1))

_gfinish = (bins: Vertex3D[][], kind: Craft, hub: vec3, contacts: vec3[], seats: vec3[], exit: vec3, shade: vec3[], radius: f64, wheels: CraftWheel[] = []) -> CraftModel:
    vs: Vertex3D[]
    loop bin in bins: vs.extend(bin)
    model = CraftModel(custom_mesh(vs), build_prop(radius, 2), hub, contacts, seats[0], exit, shade, prop_hubs = [hub], cockpits = seats, wheels = wheels, prop_radius = radius, prop_blades = 2)
    finish_craft_model(model, bins, kind)

# ---- the Sopwith Greek Seaplane (1914) ----
# A four-bay pusher on two long floats: a short nacelle for two (the observer ahead), the Anzani
# radial pushing from its back between the wings, the tail on four booms, a tail float under it.
_sopwith_greek = (lv: Livery) -> CraftModel:
    kind = Craft.sopwith_greek; p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    upper_y = p.wing_y; lower_y = p.wing_y - 1.9; wz = -0.2
    loft(bins[0], [Section(-3.0, 0.12, 0.2, 0.15), Section(-2.6, 0.38, 0.38, 0.32), Section(-1.2, 0.45, 0.45, 0.4), Section(0.2, 0.42, 0.42, 0.38), Section(0.55, 0.3, 0.3, 0.28)], vec3(0, 0.15, 0), lv.body, _gshade(lv.body, 0.8))
    seats: vec3[]
    loop j in 0..2:
        c = vec3(0, 0.62, f32(p.cockpit_z + f64(j) * 1.3))
        kit_cockpit(bins[0], c, lv); seats.push(c + vec3(0, 0.38, 0))
    kit_strut(bins[0], vec3(0, 0.75, f32(p.cockpit_z - 0.35)), vec3(0, 1.15, f32(p.cockpit_z - 0.15)), 0.03, G_DARK)   # (the observer's Lewis)
    _gwing(bins, kind, lv, vec3(0, f32(upper_y), f32(wz)), p.span, p.chord, p.taper, true)
    _gwing(bins, kind, lv, vec3(0, f32(lower_y), f32(wz)), p.span * p.lower_span, p.chord, p.taper, false)
    front = wz - p.chord * 0.32; rear = wz + p.chord * 0.28
    _gbays(bins, [0.6, 2.4, 4.2, 5.95, p.span * p.lower_span * 0.48], lower_y, upper_y, front, rear, 0.032)
    # the nacelle on its own struts to the lower wing
    loop side in [-1.0, 1.0]:
        loop z in [-1.4, 0.0]: kit_strut(bins[0], vec3(f32(side * 0.3), -0.2, f32(z)), vec3(f32(side * 0.55), f32(lower_y + 0.05), f32(z)), 0.03, G_METAL)
    # the Anzani at the nacelle's back
    engine = vec3(0, f32(p.engine_y), f32(p.engine_z))
    _gradial(bins[1], engine, 0.46, 5, 2, true, lv)
    hub = vec3(0, f32(p.engine_y), f32(p.engine_z + 0.65))
    kit_strut(bins[1], engine, hub, 0.05, G_METAL)
    # twin main floats, braced to the lower wing, and the tail float
    loop side in [-1.0, 1.0]:
        fc = vec3(f32(side * p.float_x), f32(p.float_y), -0.9)
        _gfloat(bins, fc, 4.2, 0.32, lv, lower_y - 0.02)
        kit_strut(bins[if side < 0: 4 else: 5], fc + vec3(0, 0.2, -1.6), vec3(f32(side * 0.4), -0.15, -1.9), 0.03, G_WOOD)
    tail_z = 6.4; tail_y = 0.55
    roots = [vec3(-1.75, f32(upper_y - 0.02), 0.55), vec3(1.75, f32(upper_y - 0.02), 0.55), vec3(-1.75, f32(lower_y + 0.02), 0.55), vec3(1.75, f32(lower_y + 0.02), 0.55)]
    _gboom_tail(bins[6], lv, roots, tail_z, tail_y, 3.4, 1.0, false)
    tf = vec3(0, -1.55, 5.9)
    kit_float(bins[6], tf, 1.1, 0.16, lv.body, _gshade(lv.body, 0.6))
    loop side in [-1.0, 1.0]: kit_strut(bins[6], tf + vec3(f32(side * 0.08), 0.1, 0), vec3(f32(side * 0.3), f32(tail_y - 0.05), 5.75), 0.025, G_WOOD)
    contacts: vec3[]
    loop side in [-1.0, 1.0]:
        loop z in [-2.7, -0.9, 0.9]: contacts.push(vec3(f32(side * p.float_x), f32(p.float_y - (if z == -0.9: 0.34 else: 0.3)), f32(z)))
        contacts.push(vec3(f32(side * 0.12), -1.69, 5.9))
    shade = [vec3(0, 0.15, -1.2), vec3(0.45, 0.45, 1.8), vec3(0, f32(upper_y), f32(wz)), vec3(f32(p.span * 0.5), 0.08, f32(p.chord * 0.5)),
        vec3(-p.float_x, p.float_y, -0.9), vec3(0.32, 0.3, 2.1), vec3(p.float_x, p.float_y, -0.9), vec3(0.32, 0.3, 2.1), vec3(0, f32(tail_y), f32(tail_z)), vec3(1.7, 0.08, 0.5)]
    _gfinish(bins, kind, hub, contacts, seats, vec3(f32(p.float_x), f32(p.float_y + 0.35), -0.9), shade, p.prop_radius)

# ---- the Sopwith Bat Boat Type 2 (1914) ----
# A short sewn-plywood (Consuta) hull with two seats side by side, a two-bay pusher biplane with
# the Salmson's two rows of cylinders between the wings and its radiators beside them, the tail on
# open booms with no fixed fin, small floats under the lower wing, and wheels that fold up beside the
# hull (an amphibian, as the Type 1A of 1913 was), with a skid under the stern.
_bat_boat = (lv: Livery) -> CraftModel:
    kind = Craft.sopwith_bat_boat; p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    w = f32(p.width)
    hull = [Section(-4.0, 0.08, 0.36, 0.0, 0.0), Section(-3.6, 0.38, 0.5, 0.3, 0.06), Section(-2.8, 0.52, 0.56, 0.5, 0.14),
        Section(-1.4, 0.55, 0.56, 0.55, 0.17), Section(0.1, 0.55, 0.54, 0.55, 0.17), Section(0.13, 0.48, 0.52, 0.34, 0.08), Section(1.8, 0.16, 0.42, -0.02, 0.0)]
    loft(bins[0], hull, vec3(0, 0, 0), lv.body, _gshade(lv.body, 0.55))
    # (copper-sewn planking: thin dark seams along the sides)
    loop side in [-1.0, 1.0]:
        loop k in 0..3: kit_strut(bins[0], vec3(f32(side * 0.5), f32(0.35 - f64(k) * 0.28), -2.7), vec3(f32(side * 0.53), f32(0.33 - f64(k) * 0.3), 0.05), 0.008, _gshade(lv.body, 0.6))
    kit_box(bins[0], vec3(0, 0.555, -2.3), vec3(0.46, 0.02, 0.4), G_DARK)
    kit_box(bins[0], vec3(0, 0.68, -2.72), vec3(0.44, 0.1, 0.02), vec4(0.63, 0.79, 0.83, 1))
    seats = [vec3(-0.25, 0.96, -2.25), vec3(0.25, 0.96, -2.25)]
    upper_y = p.wing_y; lower_y = p.wing_y - 1.9; wz = -0.6
    _gwing(bins, kind, lv, vec3(0, f32(upper_y), f32(wz)), p.span, p.chord, p.taper, true)
    _gwing(bins, kind, lv, vec3(0, f32(lower_y), f32(wz)), p.span * p.lower_span, p.chord, p.taper, false)
    front = wz - p.chord * 0.32; rear = wz + p.chord * 0.28
    _gbays(bins, [0.7, 4.0, p.span * p.lower_span * 0.47], lower_y, upper_y, front, rear, 0.035)
    loop side in [-1.0, 1.0]:
        loop z in [front, rear]: kit_strut(bins[0], vec3(f32(side * 0.45), 0.5, f32(z)), vec3(f32(side * 0.7), f32(lower_y + 0.04), f32(z)), 0.035, G_WOOD)
    # the Salmson and its radiators, on bearers from the hull and the upper wing
    engine = vec3(0, f32(p.engine_y), f32(p.engine_z))
    _gradial(bins[1], engine, 0.42, 7, 2, true, lv)
    loop side in [-1.0, 1.0]:
        kit_box(bins[1], engine + vec3(f32(side * 0.62), 0.05, -0.15), vec3(0.06, 0.38, 0.32), vec4(0.24, 0.26, 0.25, 1))
        loop dz in [-0.35, 0.2]:
            kit_strut(bins[1], vec3(f32(side * 0.3), 0.54, f32(p.engine_z + dz)), engine + vec3(f32(side * 0.12), -0.2, f32(dz)), 0.035, G_METAL)
            kit_strut(bins[1], engine + vec3(f32(side * 0.12), 0.2, f32(dz)), vec3(f32(side * 0.35), f32(upper_y - 0.02), f32(p.engine_z + dz)), 0.03, G_METAL)
    hub = vec3(0, f32(p.engine_y), f32(p.engine_z + 0.65))
    kit_strut(bins[1], engine, hub, 0.05, G_METAL)
    loop side in [-1.0, 1.0]: _gfloat(bins, vec3(f32(side * p.float_x), f32(p.float_y), -0.6), 1.0, 0.16, lv, lower_y - 0.02)
    tail_z = 6.6; tail_y = 1.0
    roots = [vec3(-1.45, f32(upper_y - 0.02), 0.45), vec3(1.45, f32(upper_y - 0.02), 0.45), vec3(-1.45, f32(lower_y + 0.02), 0.45), vec3(1.45, f32(lower_y + 0.02), 0.45)]
    _gboom_tail(bins[6], lv, roots, tail_z, tail_y, 3.6, 1.1, false)
    # (the stern skid)
    kit_strut(bins[0], vec3(0, -0.1, 1.42), vec3(0, -0.8, 1.6), 0.035, G_METAL)
    # the folding wheels: each swings up beside the hull about a hinge on its side
    wheels: CraftWheel[]
    loop side in [-1.0, 1.0]:
        hinge = vec3(f32(side * p.width), 0.1, -1.0)
        centre = vec3(f32(side * 0.5), -1.05, 0)
        wheel: Vertex3D[]
        kit_strut(wheel, vec3(0, 0, -0.25), centre, 0.04, G_METAL)
        kit_strut(wheel, vec3(0, 0, 0.25), centre, 0.04, G_METAL)
        _gwheel(wheel, centre, 0.4, lv)
        wheels.push(CraftWheel(custom_mesh(wheel), hinge, side * PI / 2))
    contacts = [vec3(-0.28, -0.55, -2.8), vec3(0.28, -0.55, -2.8), vec3(-0.28, -0.55, 0.0), vec3(0.28, -0.55, 0.0),
        vec3(0, -0.72, -2.5), vec3(0, -0.72, 0.05), vec3(0, -0.15, 1.5),
        vec3(-p.float_x, p.float_y - 0.22, -0.6), vec3(p.float_x, p.float_y - 0.22, -0.6)]
    shade = [vec3(0, 0, -1.1), vec3(0.55, 0.5, 2.9), vec3(0, f32(upper_y), f32(wz)), vec3(f32(p.span * 0.5), 0.08, f32(p.chord * 0.5)),
        vec3(0, f32(tail_y), f32(tail_z)), vec3(1.8, 0.08, 0.55)]
    _gfinish(bins, kind, hub, contacts, seats, vec3(0.6, 0.55, -1.2), shade, p.prop_radius, wheels)

# ---- the Short Type 184 (1915) ----
# A big three-bay tractor biplane on two long unstepped floats with arched cross-tubes, a tail float
# and air bags under the wing tips; the Sunbeam's two banks of cylinders in the nose with the tall
# radiator standing behind them in front of the upper wing, its exhaust over the wing; the observer's
# ring and Lewis behind the pilot; a 14-inch torpedo slung between the floats.
_short_184 = (lv: Livery) -> CraftModel:
    kind = Craft.short_184; p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    cowl = vec4(0.62, 0.63, 0.6, 1)
    loft(bins[1], [Section(-5.45, 0.34, 0.36, 0.38), Section(-4.9, 0.5, 0.5, 0.52), Section(-3.7, 0.55, 0.55, 0.56)], vec3(0, 0, 0), cowl, cowl)
    loft(bins[0], [Section(-3.7, 0.55, 0.55, 0.56), Section(-1.0, 0.55, 0.55, 0.55), Section(1.5, 0.45, 0.48, 0.42), Section(4.0, 0.28, 0.36, 0.22)], vec3(0, 0, 0), lv.body, _gshade(lv.body, 0.85))
    loft(bins[6], [Section(4.0, 0.28, 0.36, 0.22), Section(6.95, 0.06, 0.22, 0.04)], vec3(0, 0, 0), lv.body, _gshade(lv.body, 0.85))
    # the Sunbeam: twin banks of cylinder blocks along the nose, the radiator behind, the exhaust
    loop side in [-1.0, 1.0]:
        loop j in 0..6:
            kit_box(bins[1], vec3(f32(side * 0.36), 0.55, f32(-5.1 + f64(j) * 0.24)), vec3(0.1, 0.12, 0.1), vec4(0.48, 0.48, 0.46, 1), rotation_z(-side * 0.5))
    kit_box(bins[1], vec3(0, 1.15, -3.45), vec3(0.42, 0.62, 0.14), vec4(0.22, 0.24, 0.23, 1))
    kit_box(bins[1], vec3(0, 1.8, -3.45), vec3(0.45, 0.05, 0.16), lv.trim)
    kit_strut(bins[1], vec3(0.32, 0.62, -3.9), vec3(0.32, 2.35, -3.3), 0.05, G_DARK)
    kit_strut(bins[1], vec3(0.32, 2.35, -3.3), vec3(0.32, 2.45, -1.6), 0.05, G_DARK)
    kit_spinner(bins[1], vec3(0, 0, -5.65), 0.16, lv.trim)
    seats: vec3[]
    loop j in 0..2:
        c = vec3(0, 0.575, f32(p.cockpit_z + f64(j) * 1.35))
        kit_cockpit(bins[0], c, lv); seats.push(c + vec3(0, 0.38, 0))
    # the observer's ring and Lewis
    ring = vec3(0, 0.68, f32(p.cockpit_z + 1.35))
    loop i in 0..12:
        a = f64(i) * TAU / 12.0; b = f64(i + 1) * TAU / 12.0
        kit_strut(bins[0], ring + vec3(f32(cos(a) * 0.46), 0, f32(sin(a) * 0.46)), ring + vec3(f32(cos(b) * 0.46), 0, f32(sin(b) * 0.46)), 0.03, G_METAL)
    kit_strut(bins[0], ring + vec3(0, 0.2, 0.2), ring + vec3(0, 0.36, 1.15), 0.035, G_DARK)
    upper_y = p.wing_y; lower_y = p.wing_y - 1.9; wz = -1.1
    _gwing(bins, kind, lv, vec3(0, f32(upper_y), f32(wz)), p.span, p.chord, p.taper, true)
    _gwing(bins, kind, lv, vec3(0, f32(lower_y), f32(wz)), p.span * p.lower_span, p.chord, p.taper, false)
    front = wz - p.chord * 0.32; rear = wz + p.chord * 0.28
    _gbays(bins, [0.6, 2.9, 5.9, p.span * p.lower_span * 0.47], lower_y, upper_y, front, rear, 0.04)
    loop side in [-1.0, 1.0]:
        loop z in [front, rear]: kit_strut(bins[0], vec3(f32(side * 0.4), 0.52, f32(z)), vec3(f32(side * 0.6), f32(upper_y - 0.02), f32(z)), 0.035, G_METAL)
    # wing-tip air bags
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        tip = vec3(f32(side * p.span * p.lower_span * 0.47), f32(lower_y - 0.32), f32(wz))
        add_cylinder(bins[id], vec3(0, -0.5, 0), 0.17, 1.0, vec4(0.32, 0.3, 0.27, 1), 8, -1.0, translation(tip) * rotation_x(PI / 2))
        kit_strut(bins[id], tip + vec3(0, 0.12, 0), tip + vec3(0, 0.3, 0), 0.03, G_WOOD)
    # the floats, their struts and arched cross-tubes, the tail float
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        fc = vec3(f32(side * p.float_x), f32(p.float_y), -1.4)
        kit_float(bins[id], fc, 5.0, 0.42, lv.trim, _gshade(lv.trim, 0.6))
        loop z in [-2.9, -0.6]:
            kit_strut(bins[id], vec3(fc.x, f32(p.float_y + 0.3), f32(z)), vec3(f32(side * 0.5), -0.5, f32(z)), 0.04, G_WOOD)
            kit_strut(bins[id], vec3(fc.x, f32(p.float_y + 0.3), f32(z)), vec3(fc.x, f32(lower_y - 0.02), f32(z + 0.2)), 0.035, G_WOOD)
    loop z in [-2.9, -0.6]:
        loop k in 0..4:
            x0 = -p.float_x + f64(k) * p.float_x * 0.5; x1 = x0 + p.float_x * 0.5
            y0 = p.float_y + 0.3 + sin(PI * f64(k) / 4.0) * 0.55; y1 = p.float_y + 0.3 + sin(PI * f64(k + 1) / 4.0) * 0.55
            kit_strut(bins[0], vec3(f32(x0), f32(y0), f32(z)), vec3(f32(x1), f32(y1), f32(z)), 0.035, G_METAL)
    tf = vec3(0, -1.95, 5.6)
    kit_float(bins[6], tf, 1.6, 0.25, lv.trim, _gshade(lv.trim, 0.6))
    loop dz in [-0.4, 0.35]: kit_strut(bins[6], tf + vec3(0, 0.15, f32(dz)), vec3(0, -0.2, f32(5.6 + dz)), 0.035, G_WOOD)
    # the torpedo, slung between the floats
    tc = vec3(0, -1.2, -1.3)
    add_cylinder(bins[0], vec3(0, -2.2, 0), 0.18, 4.4, vec4(0.3, 0.32, 0.31, 1), 10, -1.0, translation(tc) * rotation_x(PI / 2))
    add_cylinder(bins[0], vec3(0, 2.2, 0), 0.18, 0.4, vec4(0.62, 0.55, 0.3, 1), 10, 0.02, translation(tc) * rotation_x(-PI / 2))
    loop k in 0..4: kit_box(bins[0], tc + vec3(0, 0, 2.05), vec3(0.02, 0.22, 0.12), G_DARK, rotation_z(f64(k) * PI / 4.0))
    loop z in [-2.0, -0.6]: kit_strut(bins[0], tc + vec3(0, 0.15, f32(z + 1.3)), vec3(0, -0.52, f32(z)), 0.03, G_METAL)
    # tail: tailplane, fin and rudder
    kit_fabric_wing(bins[6], vec3(0, 0.25, 6.2), 5.0, 1.4, 0.8, lv)
    kit_box(bins[6], vec3(0, 0.75, 6.4), vec3(0.04, 0.5, 0.42), lv.body)
    kit_box(bins[6], vec3(0, 0.7, 6.95), vec3(0.045, 0.62, 0.2), lv.accent)
    kit_box(bins[6], vec3(0, 0.7, 6.95), vec3(0.047, 0.12, 0.205), vec4(0.94, 0.93, 0.88, 1))
    hub = vec3(0, f32(p.engine_y), f32(p.engine_z - 0.65))
    contacts: vec3[]
    loop side in [-1.0, 1.0]:
        loop z in [-3.4, -1.4, 0.6]: contacts.push(vec3(f32(side * p.float_x), f32(p.float_y - (if z == -1.4: 0.44 else: 0.38)), f32(z)))
        contacts.push(vec3(f32(side * 0.15), -2.18, 5.6))
    shade = [vec3(0, 0, 0.6), vec3(0.55, 0.5, 6.2), vec3(0, f32(upper_y), f32(wz)), vec3(f32(p.span * 0.5), 0.08, f32(p.chord * 0.5)),
        vec3(-p.float_x, p.float_y, -1.4), vec3(0.42, 0.35, 2.5), vec3(p.float_x, p.float_y, -1.4), vec3(0.42, 0.35, 2.5), vec3(0, 0.25, 6.2), vec3(2.5, 0.08, 0.7)]
    _gfinish(bins, kind, hub, contacts, seats, vec3(f32(p.float_x), f32(p.float_y + 0.45), -1.4), shade, p.prop_radius)

# ---- the KEA Chelidon (1927) ----
# A small two-seat trainer from the Phaleron factory: the Salmson's nine cylinders bare in a round
# nose, two open cockpits one behind the other, a single-bay biplane on N struts, split-axle wheels
# on V legs and a tail skid. A landplane (it could take floats; it flew on wheels): its contacts are
# the belly's, which only meet the water in a ditching.
_kea_chelidon = (lv: Livery) -> CraftModel:
    kind = Craft.kea_chelidon; p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    loft(bins[1], [Section(-2.6, 0.34, 0.36, 0.36), Section(-2.15, 0.42, 0.44, 0.44)], vec3(0, 0, 0), lv.trim, lv.trim)
    loft(bins[0], [Section(-2.15, 0.42, 0.44, 0.44), Section(-0.6, 0.42, 0.46, 0.42), Section(0.9, 0.34, 0.4, 0.32), Section(1.7, 0.22, 0.32, 0.18)], vec3(0, 0, 0), lv.body, _gshade(lv.body, 0.85))
    loft(bins[6], [Section(1.7, 0.22, 0.32, 0.18), Section(2.9, 0.04, 0.22, 0.02)], vec3(0, 0, 0), lv.body, _gshade(lv.body, 0.85))
    _gradial(bins[1], vec3(0, 0, f32(p.engine_z)), 0.42, 9, 1, false, lv)
    hub = vec3(0, f32(p.engine_y), f32(p.engine_z - 0.65))
    kit_strut(bins[1], vec3(0, 0, f32(p.engine_z)), hub, 0.05, G_METAL)
    seats: vec3[]
    loop j in 0..2:
        c = vec3(0, 0.455, f32(p.cockpit_z + f64(j) * 1.3))
        kit_cockpit(bins[0], c, lv); seats.push(c + vec3(0, 0.38, 0))
    upper_y = p.wing_y; lower_y = p.wing_y - 1.9; wz = -0.85
    _gwing(bins, kind, lv, vec3(0, f32(upper_y), f32(wz)), p.span, p.chord, p.taper, true)
    _gwing(bins, kind, lv, vec3(0, f32(lower_y), -0.6), p.span * p.lower_span, p.chord * 0.9, p.taper, false)
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        x = p.span * p.lower_span * 0.4
        # N struts and their wire, the cabane, the lower wing's roots under the fuselage
        kit_strut(bins[id], vec3(f32(side * x), f32(lower_y + 0.04), -1.0), vec3(f32(side * x), f32(upper_y - 0.01), -1.3), 0.03, G_WOOD)
        kit_strut(bins[id], vec3(f32(side * x), f32(lower_y + 0.04), -0.25), vec3(f32(side * x), f32(upper_y - 0.01), -0.5), 0.03, G_WOOD)
        kit_strut(bins[id], vec3(f32(side * x), f32(lower_y + 0.04), -0.25), vec3(f32(side * x), f32(upper_y - 0.01), -1.3), 0.025, G_WOOD)
        kit_strut(bins[id], vec3(f32(side * 0.45), f32(lower_y + 0.05), -1.0), vec3(f32(side * x), f32(upper_y), -1.3), 0.009, G_WIRE)
        loop pz in [(-1.3, -1.3), (-0.45, -0.5)]: kit_strut(bins[0], vec3(f32(side * 0.3), 0.42, f32(pz.0)), vec3(f32(side * 0.5), f32(upper_y - 0.02), f32(pz.1)), 0.03, G_METAL)
        loop pz in [-1.0, -0.25]: kit_strut(bins[0], vec3(f32(side * 0.3), -0.42, f32(pz)), vec3(f32(side * 0.42), f32(lower_y + 0.03), f32(pz)), 0.03, G_METAL)
        # undercarriage
        wid = if side < 0: 4 else: 5
        axle = vec3(f32(side * p.float_x), f32(p.float_y), -0.95)
        loop z in [-1.35, -0.55]: kit_strut(bins[wid], vec3(f32(side * 0.25), -0.42, f32(z)), axle, 0.035, G_METAL)
        kit_strut(bins[wid], vec3(f32(side * 0.05), -0.55, -0.95), axle, 0.025, G_METAL)
        _gwheel(bins[wid], axle, 0.33, lv)
    # tail: tailplane, fin, rudder, skid
    kit_fabric_wing(bins[6], vec3(0, 0.1, 2.55), 2.6, 0.75, 0.75, lv)
    kit_box(bins[6], vec3(0, 0.5, 2.62), vec3(0.035, 0.38, 0.24), lv.body)
    kit_box(bins[6], vec3(0, 0.45, 2.98), vec3(0.04, 0.46, 0.15), lv.accent)
    kit_box(bins[6], vec3(0, 0.45, 2.98), vec3(0.042, 0.09, 0.155), vec4(0.94, 0.93, 0.88, 1))
    kit_strut(bins[6], vec3(0, -0.04, 2.5), vec3(0, -0.34, 2.75), 0.03, G_METAL)
    belly = [vec3(-0.3, -0.44, -1.6), vec3(0.3, -0.44, -1.6), vec3(-0.3, -0.42, -0.2), vec3(0.3, -0.42, -0.2), vec3(-0.2, -0.25, 1.1), vec3(0.2, -0.25, 1.1)]
    shade = [vec3(0, 0, -0.1), vec3(0.42, 0.44, 2.75), vec3(0, f32(upper_y), f32(wz)), vec3(f32(p.span * 0.5), 0.08, f32(p.chord * 0.5)),
        vec3(0, 0.1, 2.55), vec3(1.3, 0.08, 0.38)]
    _gfinish(bins, kind, hub, belly, seats, vec3(0.8, f32(lower_y + 0.1), -0.5), shade, p.prop_radius)

build_greek_craft = (kind: Craft, lv: Livery) -> CraftModel:
    if kind == .sopwith_bat_boat: return _bat_boat(lv)
    if kind == .short_184: return _short_184(lv)
    if kind == .kea_chelidon: return _kea_chelidon(lv)
    _sopwith_greek(lv)
