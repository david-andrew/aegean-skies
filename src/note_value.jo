# A played note's written value (whole, half, quarter, eighth, sixteenth, dotted or not) from how
# long it lasts against the score's quarter note: in MIDI terms its ticks over the ticks a quarter
# (PPQ), or its seconds over the quarter's seconds (the tempo, microseconds a quarter). The length
# is snapped to the nearest value in log-time (so a note half-way, by ratio, between a quarter and
# a dotted quarter goes to the nearer), dotted values (one and a half of the plain) counting as
# values of their own; longer than a whole is a whole, shorter than a sixteenth a sixteenth.
# For the notes that rise from music played in the world (src/note_cue.jo).

use 'music_tempo.jo'
use 'music_synth.jo'
use 'live_notes.jo'

# whole 0, half 1, quarter 2, eighth 3, sixteenth 4
struct NoteValue:
    kind = 2
    dotted = false

const NOTE_WHOLE = 0
const NOTE_HALF = 1
const NOTE_QUARTER = 2
const NOTE_EIGHTH = 3
const NOTE_SIXTEENTH = 4

# A value's length in quarter notes.
note_value_quarters = (v: NoteValue) -> f64:
    plain = pow(2.0, f64(2 - v.kind))
    if v.dotted: plain * 1.5 else: plain

# The value nearest a length in quarter notes (nearest by ratio).
note_value_of = (quarters: f64) -> NoteValue:
    if not (quarters > 0.0): return NoteValue(NOTE_SIXTEENTH)
    best = NoteValue(NOTE_SIXTEENTH)
    off = 1e9
    loop kind in 0..5:
        loop dotted in [false, true]:
            # (no dotted whole: a whole is the longest shown)
            if kind == NOTE_WHOLE and dotted: continue
            v = NoteValue(kind, dotted)
            d = abs(log(quarters / note_value_quarters(v)))
            if d < off: off = d; best = v
    best

# From MIDI ticks and the ticks a quarter note (PPQ).
note_value_ticks = (ticks: int, ppq: int) -> NoteValue: note_value_of(f64(ticks) / f64(max(ppq, 1)))

# From seconds and the tempo (microseconds a quarter note, MIDI's set-tempo).
note_value_tempo = (seconds: f64, tempo_us: f64) -> NoteValue: note_value_of(seconds * 1.0e6 / max(tempo_us, 1.0))

# From seconds and the quarter note's seconds.
note_value_seconds = (seconds: f64, quarter: f64) -> NoteValue: note_value_of(seconds / max(quarter, 0.001))

# The quarter note's seconds at a second of a catalogue piece as played (MUSIC_TEMPO), or `none`
# where the piece has no score.
music_quarter_at = (piece: int, second: f64) -> f64?:
    if piece < 0 or piece >= MUSIC_TEMPO.len() or MUSIC_TEMPO[piece].len() == 0: return none
    steps = MUSIC_TEMPO[piece]
    q = f64(steps[0].y)
    loop s in steps:
        if f64(s.x) <= second: q = f64(s.y)
    q

# The quarter note's seconds where a note of a piece was played.
music_quarter_of = (piece: int, n: LiveNote) -> f64?: music_quarter_at(piece, f64(n.start) / f64(MUSIC_RATE))
