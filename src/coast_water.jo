# The sea reads canonical heights, then the SAME fine triangulation as ground.
# Legacy islands reuse their resident atlas. New land gets a bounded, atomically
# published 896 m local atlas (16.5 KiB), with four rows of work per frame.
use 'coast_field.jo'
use 'coast_mesh.jo'
use 'terrain_lod.jo'
use 'world_source.jo'
use 'geography.jo'

coast_water_map: Texture
coast_water_area = vec4(0,0,0,0)   # origin x,z and grid dimensions, not extent
coast_water_new: Texture
coast_water_image: Image
coast_water_pending = vec2(0,0)
coast_water_ready = vec2(0,0)
coast_water_row = -1
coast_water_valid = false
const COAST_WATER_N = 65

update_coast_water = (cam: vec3,focal: f64):
    global coast_water_map,coast_water_area,coast_water_new,coast_water_image,coast_water_pending,coast_water_ready,coast_water_row,coast_water_valid
    coast_water_area = vec4(0,0,0,0)
    if not coast_enabled or f64(cam.y) > 213.0+focal*0.5: return
    if abs(cam.x) < 20000.0 and abs(cam.z) < 20000.0:
        best = 1e20
        loop tile in terrain_tiles:
            dx = max(max(tile.x-f64(cam.x),f64(cam.x)-tile.x-f64(tile.heights.width-1)*14.0),0.0)
            dz = max(max(tile.z-f64(cam.z),f64(cam.z)-tile.z-f64(tile.heights.height-1)*14.0),0.0)
            distance = dx*dx+dz*dz
            if distance >= best or distance > 500.0*500.0: continue
            best = distance
            coast_water_map = tile.heights
            coast_water_area = vec4(f32(tile.x),f32(tile.z),f32(tile.heights.width),f32(tile.heights.height))
        return
    if not geography_enabled: return
    if coast_water_new.id == 0:
        coast_water_image = image(COAST_WATER_N,COAST_WATER_N)
        coast_water_new = texture(coast_water_image,false)
    if coast_water_row < 0 and (not coast_water_valid or length(cam.xz-(coast_water_ready+vec2(448,448))) > 160.0):
        coast_water_pending = floor(cam.xz/224.0)*224.0-vec2(336,336)
        coast_water_row = 0
    if coast_water_row >= 0:
        loop j in coast_water_row..min(coast_water_row+4,COAST_WATER_N):
            loop i in 0..COAST_WATER_N:
                x = f64(coast_water_pending.x)+f64(i)*14.0
                z = f64(coast_water_pending.y)+f64(j)*14.0
                value = int(round((world_source_sample(x,z).0+64.0)*4096.0))
                a = (j*COAST_WATER_N+i)*4
                coast_water_image.pixels[a] = u8(value & 255)
                coast_water_image.pixels[a+1] = u8((value>>8)&255)
                coast_water_image.pixels[a+2] = u8((value>>16)&255)
                coast_water_image.pixels[a+3] = 255
        coast_water_row += 4
        if coast_water_row >= COAST_WATER_N:
            update_texture(coast_water_new,coast_water_image)
            coast_water_ready = coast_water_pending
            coast_water_valid = true
            coast_water_row = -1
    if coast_water_valid:
        coast_water_map = coast_water_new
        coast_water_area = vec4(coast_water_ready.x,coast_water_ready.y,f32(COAST_WATER_N),f32(COAST_WATER_N))

coast_water_value = (t: Texture,p: vec2) -> f32:
    dot(texel(t,ivec2(p)).xyz,vec3(255.0,65280.0,16711680.0))/4096.0-64.0

# Shader counterpart of the CPU cell selector; fixed bounds make adjacent
# patches and the sea choose the same state without another height lookup.
coast_water_level = (origin: vec2,h: vec4,cam: vec3,focal: f32) -> f32:
    low = min(min(h.x,h.y),min(h.z,h.w))
    high = max(max(h.x,h.y),max(h.z,h.w))
    if high <= -10.0 or low >= 192.0: return 0.0
    q = max(max(origin-cam.xz,cam.xz-origin-vec2(14,14)),vec2(0,0))
    dy = max(max(-10.0-cam.y,cam.y-192.0),0.0)
    clamp(log2(14.0*min(focal,f32(COAST_MAX_FOCAL))/(28.0*max(sqrt(dot(q,q)+dy*dy)-21.0,0.25))),0.0,6.0)

coast_water_height = (t: Texture,area: vec4,p: vec2,cam: vec3,focal: f32,pattern: Texture) -> f32:
    grid = (p-area.xy)/14.0
    cell = floor(grid); f = grid-cell
    h = vec4(coast_water_value(t,cell),coast_water_value(t,cell+vec2(1,0)),coast_water_value(t,cell+vec2(0,1)),coast_water_value(t,cell+vec2(1,1)))
    origin = area.xy+cell*14.0
    level = coast_water_level(origin,h,cam,focal)
    n = pow(2.0,ceil(level))
    # Most fragments lie inside the cell's unconstrained triangles. Only the
    # boundary strip needs the same shared-edge reconstruction as the mesh.
    if min(min(f.x,f.y),min(1.0-f.x,1.0-f.y)) < 1.0/n and level > 0.0:
        bound = vec4(-10,192,-10,192)
        edges = min(vec4(level,level,level,level),vec4(coast_water_level(origin-vec2(14,0),bound,cam,focal),coast_water_level(origin+vec2(14,0),bound,cam,focal),coast_water_level(origin-vec2(0,14),bound,cam,focal),coast_water_level(origin+vec2(0,14),bound,cam,focal)))
        inst = CoastInstance(vec2(0,0),origin,cell,h,level,edges)
        a = min(floor(f*n),vec2(n-1.0,n-1.0))/n
        s = 1.0/n
        heights = vec4(coast_gpu_height(inst,a,pattern),coast_gpu_height(inst,a+vec2(s,0),pattern),coast_gpu_height(inst,a+vec2(0,s),pattern),coast_gpu_height(inst,a+vec2(s,s),pattern))
        return coast_triangle(heights,(f-a)*n)
    coast_gpu_morphed(h,f,origin,level,pattern)
