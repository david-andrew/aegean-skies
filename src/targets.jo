# A small view-only shortlist. No control, autopilot or flight state is writable here.
const TARGET_LIMIT = 6
struct ViewTarget:
    kind: int                     # 0 aircraft, 1 quay, 2 ship, 3 landmark
    id: int
    name: str
    position: vec3
    rank: int
    score: f64
    hostile = false

struct TargetView:
    items: ViewTarget[]
    selected = -1
    looking = false
    weight = 0.0
    bearing: vec3 = vec3(0,0,-1)
    held = 0.0
    long_press = false

same_target = (a:ViewTarget,b:ViewTarget)->bool:a.kind==b.kind and a.id==b.id

offer_target = (items:mut ViewTarget[],candidate:ViewTarget,limit:int = TARGET_LIMIT):
    loop old in items:if same_target(old,candidate):return
    items.push(candidate)
    if limit==0:return
    items.sort((a:ViewTarget)->f64:f64(a.rank)*1000000.0+a.score)
    if limit>0 and items.len()>limit:items.pop()

refresh_targets = (v:mut TargetView,items:ViewTarget[]):
    old:ViewTarget?=if v.selected>=0 and v.selected<v.items.len():v.items[v.selected] else:none
    v.items=items;v.selected=-1
    if let previous=old:
        found=false
        loop i in 0..items.len():
            if same_target(previous,items[i]):v.selected=i;found=true;break
        if not found:v.looking=false
    if v.selected<0:v.looking=false

cycle_target = (v:mut TargetView):
    if v.items.len()==0:return
    v.selected=(v.selected+1)%v.items.len()

toggle_target = (v:mut TargetView):
    if v.selected<0 and v.items.len()>0:v.selected=0
    if v.selected>=0:v.looking=not v.looking

# A touch owns its gesture until release: a long hold never also cycles.
target_touch = (v:mut TargetView,down:bool,dt:f64):
    if down:
        v.held+=max(0.0,dt)
        if v.held>=0.45 and not v.long_press:toggle_target(v);v.long_press=true
    else:
        if v.held>0 and not v.long_press:cycle_target(v)
        v.held=0;v.long_press=false

# Interpolate bearings in azimuth/elevation, including the directly-behind case.
blend_bearing = (a:vec3,b:vec3,weight:f64)->vec3:
    if weight<=0:return a
    if length(b)<0.001:return a
    p=normalize(a);q=normalize(b)
    ah=atan2(f64(p.x),-f64(p.z));bh=atan2(f64(q.x),-f64(q.z))
    h=ah+atan2(sin(bh-ah),cos(bh-ah))*weight
    pitch=lerp(asin(clamp(f64(p.y),-1.0,1.0)),asin(clamp(f64(q.y),-1.0,1.0)),weight)
    vec3(sin(h)*cos(pitch),sin(pitch),-cos(h)*cos(pitch))

step_target_view = (v:mut TargetView,eye:vec3,normal:vec3,dt:f64):
    if v.weight<0.001:v.bearing=normal
    if v.looking and v.selected>=0:
        direction=v.items[v.selected].position-eye
        v.bearing=blend_bearing(v.bearing,direction,1.0-exp(-12.0*dt))
    v.weight+=( (if v.looking:1.0 else:0.0)-v.weight)*(1.0-exp(-10.0*dt))
