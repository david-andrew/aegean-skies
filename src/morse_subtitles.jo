# Subtitles for Morse: what a keyed message says, shown as it is keyed. Whatever sends Morse (the
# cockpit wireless's bulletins, the flight's short cues, a lamp) gives the text, where in it the
# keying has reached at the ear, and how well it is received; this keeps what has been heard so
# far, letter by letter, and reads it in plain words. A letter shows only once its last dot or dash
# has sounded, and a word's plain reading once the gap after it has passed: never ahead of the key.
# Letters keyed while the signal is under MORSE_READABLE are lost (shown as a gap). No drawing and
# no sound here: src/morse_strip.jo draws it.
use 'radio_synth.jo'

const MORSE_READABLE = 0.20         # the wanted signal's gain (radio_signal_gain) a letter can be read at
const MORSE_GAP = "_"               # a letter lost to static, in the letters as received
const MORSE_GARBLED = "…"           # a word with letters lost or missed, in the plain reading
const MORSE_WORD_GAP = 1            # units of silence past a letter's own gap that make a word's end known

# One keyed character: its dots and dashes, and the units of the message (radio_morse's) it is
# keyed over, `to` the unit after its last element. A word break (`char` " ") is known
# MORSE_WORD_GAP units into its silence.
struct MorseMark:
    char: str
    code: str = ""
    from = 0
    to = 0

# The message laid out as radio_morse keys it (the same cap, the same breaks), a break after the
# last word too; and the length of the whole in units.
morse_marks = (text: str) -> MorseMark[]:
    out: MorseMark[]
    unit = 0
    used = 0
    u = text.upper()
    loop i in 0..u.len():
        if used >= 96: break
        used += 1
        c = u[i]
        index = if c >= 'A' and c <= 'Z': int(c)-int('A') else: if c >= '0' and c <= '9': 26+int(c)-int('0') else: -1
        if index < 0:
            out.push(MorseMark(" ", "", unit, unit+MORSE_WORD_GAP))
            unit += 4
            continue
        code = RADIO_MORSE[index]
        from = unit
        loop j in 0..code.len():
            unit += if code[j] == '-': 3 else: 1
            if j+1 < code.len(): unit += 1
        out.push(MorseMark(u[i..i+1], code, from, unit))
        unit += 3
    if out.len() > 0 and out[out.len()-1].char != " ": out.push(MorseMark(" ", "", unit, unit+MORSE_WORD_GAP))
    out

# (radio_morse's length for the same text: the message's period when it is keyed over and over)
morse_units = (text: str) -> int: radio_morse_units(text)

# The dots and dashes of a character whose keying has run `into` units: each as it ends.
morse_keyed = (m: MorseMark, into: int) -> str:
    out = ""
    unit = 0
    loop j in 0..m.code.len():
        unit += if m.code[j] == '-': 3 else: 1
        if unit > into: break
        out += m.code[j..j+1]
        unit += 1
    out

# ---------------------------------------------------------------- in plain words
# A code word (or a few together) and how it reads. `leads`: the reading runs straight on into the
# next word ("this is" SXA) instead of a comma.
struct MorseWord:
    code: str
    plain: str
    leads = false

# Prosigns, Q codes and the working abbreviations of the 1920s and 30s, and the short words the
# stations here key (src/radio_content.jo; src/battle_radio.jo, src/homeward_view.jo).
MORSE_WORDS = [
    # calling and answering
    MorseWord("CQ", "calling all stations"), MorseWord("DE", "this is", true), MorseWord("K", "go ahead"),
    MorseWord("KN", "go ahead, the station called only"), MorseWord("R", "received"), MorseWord("AR", "end of message"),
    MorseWord("SK", "end of work"), MorseWord("CL", "closing down"), MorseWord("AS", "wait"), MorseWord("BT", "break"),
    MorseWord("VV", "testing"), MorseWord("VVV", "testing"), MorseWord("VA", "end of work"),
    # distress, urgency, safety
    MorseWord("SOS", "distress call"), MorseWord("XXX", "urgent message"), MorseWord("TTT", "safety warning"),
    # Q codes
    MorseWord("QRA", "the name of this station is", true), MorseWord("QRK", "your signals are readable"),
    MorseWord("QRM", "there is interference"), MorseWord("QRN", "there is static"), MorseWord("QRQ", "send faster"),
    MorseWord("QRS", "send more slowly"), MorseWord("QRT", "stop sending"), MorseWord("QRU", "nothing to report"),
    MorseWord("QRV", "ready"), MorseWord("QRX", "stand by"), MorseWord("QRZ", "who is calling"),
    MorseWord("QSA", "your signals are strong"), MorseWord("QSB", "your signals are fading"), MorseWord("QSL", "receipt acknowledged"),
    MorseWord("QSO", "in touch with", true), MorseWord("QSY", "change wavelength"), MorseWord("QTH", "my position is", true),
    MorseWord("QTR", "the time is", true), MorseWord("QTE", "your bearing is", true), MorseWord("QAM", "the weather report is", true),
    # the operators' short words
    MorseWord("WX", "weather"), MorseWord("MSG", "message"), MorseWord("NIL", "nothing"), MorseWord("RPT", "repeat"),
    MorseWord("CFM", "confirm"), MorseWord("PSE", "please"), MorseWord("TU", "thank you"), MorseWord("OK", "all correct"),
    MorseWord("C", "yes"), MorseWord("N", "no"), MorseWord("73", "best regards"),
    # the maritime service's observations and notices
    MorseWord("PORT OPEN", "harbours open"), MorseWord("PORT SHUT", "harbour closures in effect"), MorseWord("PORT", "harbours"),
    MorseWord("OPEN", "open"), MorseWord("FAIR", "fair weather"), MorseWord("SQUALL", "squalls"), MorseWord("STORM", "storm conditions"),
    # the news, a word to a bulletin
    MorseWord("ATK", "an attack on cargo reported"), MorseWord("RES", "a rescue reported"), MorseWord("AIR", "an aircraft shot down"),
    MorseWord("DITCH", "an aircraft down at sea"), MorseWord("SHUT", "a harbour closed by weather"), MorseWord("LOW", "a shortage reported"),
    MorseWord("DLV", "goods delivered"), MorseWord("FIX", "an aircraft serviced"), MorseWord("ARR", "an arrival"),
    MorseWord("DEP", "a departure"), MorseWord("FINE", "a fine issued"), MorseWord("NEWS", "news received"),
    MorseWord("CIV", "a word from the state"), MorseWord("AD", "a paid announcement"), MorseWord("QUIZ", "the quiz")]

_morse_word = (code: str) -> MorseWord?:
    loop w in MORSE_WORDS:
        if w.code == code: return w
    none

# A station's call sign and its name: the sender names itself first ("SEA ..." reads "Aegean
# Maritime Service: ...").
struct MorseStation:
    callsign: str
    name: str

# The keyed text's words (letters and figures; anything else breaks a word).
morse_split = (text: str) -> str[]:
    out: str[]
    word = ""
    u = text.upper()
    loop i in 0..u.len():
        c = u[i]
        if (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9'): word += u[i..i+1]
        else:
            # (a garbled word is kept as it is)
            if u[i..i+1] == MORSE_GARBLED: word += MORSE_GARBLED
            else if word != "":
                out.push(word); word = ""
    if word != "": out.push(word)
    out

_capital = (s: str) -> str: if s.len() == 0: s else: s[0..1].upper()+s[1..s.len()]

# The words in plain English: each code word read out, two together where they make one notice
# ("PORT OPEN"), a word sent over and over read once, a call sign first as the station's name.
# What is not a code word stays as keyed (a call sign, a name).
morse_plain_words = (words: str[], stations: MorseStation[] = []) -> str:
    out = ""
    last = ""
    leads = false
    named = false                   # the reading so far is only the sender's name
    i = 0
    loop i < words.len():
        piece = words[i]; runs = false; name = false; took = 1
        pair: MorseWord? = if i+1 < words.len(): _morse_word("{words[i]} {words[i+1]}") else: none
        if let p = pair:
            piece = p.plain; runs = p.leads; took = 2
        else if let w = _morse_word(words[i]):
            piece = w.plain; runs = w.leads
        else:
            loop s in stations:
                # (its own name where the sender gives it first, or after "this is")
                if s.callsign == words[i] and (i == 0 or leads): piece = s.name; name = i == 0
        i += took
        if piece == last: continue
        out = if out == "": piece else: if leads: "{out} {piece}" else: if named: "{out}: {piece}" else: "{out}, {piece}"
        last = piece; leads = runs; named = name
    _capital(out)

morse_plain = (text: str, stations: MorseStation[] = []) -> str: morse_plain_words(morse_split(text), stations)

# ---------------------------------------------------------------- following the key
# What the strip shows: the words in plain English so far, the letters as received beneath, and
# the dots and dashes of the character being keyed.
struct MorseLine:
    plain: str = ""
    raw: str = ""
    keying: str = ""
    label: str = ""                 # who sends it ("Wireless", "R/T", "Lamp")
    held = false                    # the last sending whole, kept until the next has a letter

enum MorseGot: pending, heard, lost, missed

struct MorseSubtitle:
    key: str = ""                   # what is followed (the sender and its text): a new one starts afresh
    label: str = ""
    text: str = ""                  # the message keyed
    whole: str = ""                 # and its plain reading whole (the strip is sized for it)
    read = -1                       # how many characters the line was last read at
    coded = true                    # code words read out (false: plain words spelt, as a lamp's: shown as spelt)
    marks: MorseMark[]
    got: MorseGot[]                 # each character of this sending
    done = 0                        # how many of them the keying has passed
    sending = -1                    # which repeat of the message
    at = 0.0                        # units into the sending at the ear, last fed
    worst = 2.0                     # the weakest signal while the character now keyed was sent
    stations: MorseStation[]
    last: MorseLine                 # the sending before, whole
    line: MorseLine
    fed = -1000.0                   # when it was last fed (s): the strip fades once the keying stops

# Plain words spelt out letter by letter (a lamp's "FORM"): as spelt, in ordinary letters.
morse_spelt = (words: str[]) -> str: _capital(join(words," ").lower())

# A plain reading and the letters of the characters received so far.
_morse_read = (s: MorseSubtitle) -> MorseLine:
    raw = ""
    words: str[]
    word = ""; broken = false; any = false
    loop k in 0..s.done:
        m = s.marks[k]
        if m.char == " ":
            if any:
                words.push(if broken: MORSE_GARBLED else: word)
                if s.got[k] != .missed and raw != "" and not raw.ends_with(" "): raw += " "
            word = ""; broken = false; any = false
            continue
        match s.got[k]:
            .heard:
                raw += m.char; word += m.char; any = true
            .lost:
                raw += MORSE_GAP; broken = true; any = true
            # (before the dial came to the station: the rest of that word is not a word)
            else: broken = true
    line = MorseLine(label = s.label)
    line.plain = if s.coded: morse_plain_words(words, s.stations) else: morse_spelt(words)
    line.raw = raw
    line

# Follow a message keyed from its start `units` Morse units ago at the ear (over and over every
# `period` units, or once when `period` is 0), received with `signal` now (radio_signal_gain; 1 for
# a sender that is always clear). `now` in seconds, for the strip's fading. Coming to a message
# part way through, what was keyed before is missed.
# `coded` false: the text is plain words spelt out (a lamp's), not code to be read.
morse_follow = (s: mut MorseSubtitle, key: str, label: str, text: str, units: f64, period: int, signal: f64, now: f64, stations: MorseStation[] = [], coded: bool = true):
    fresh = key != s.key
    if fresh:
        s.key = key; s.text = text; s.marks = morse_marks(text); s.sending = -1
        s.coded = coded
        s.whole = if coded: morse_plain(text,stations) else: morse_spelt(morse_split(text))
        s.read = -1
        s.last = MorseLine(); s.line = MorseLine()
    s.label = label; s.stations = stations; s.fed = now
    if s.marks.len() == 0 or units < 0.0:
        s.line = MorseLine(label = label); s.read = -1
        return
    sending = if period > 0: int(floor(units/f64(period))) else: 0
    at = if period > 0: units-f64(sending)*f64(period) else: units
    # (the dial come back, the stream begun again: what the jump passed over was not heard)
    jumped = fresh or sending < s.sending or (sending == s.sending and (at < s.at or at > s.at+12.0)) or sending > s.sending+1
    if sending != s.sending or jumped:
        # (the sending before stays up, whole, until this one has a letter)
        if not jumped and s.done > 0: s.last = _morse_read(s); s.last.held = true
        else if jumped: s.last = MorseLine()
        s.got = [loop m in s.marks: MorseGot.pending]
        s.done = 0; s.worst = 2.0; s.sending = sending; s.read = -1
        if jumped:
            # (a character already well begun is missed with those before it)
            loop s.done < s.marks.len() and f64(s.marks[s.done].from) < at-0.5:
                s.got[s.done] = .missed; s.done += 1
    s.at = at
    loop s.done < s.marks.len() and at >= f64(s.marks[s.done].to):
        m = s.marks[s.done]
        s.got[s.done] = if m.char == " " or min(s.worst, signal) >= MORSE_READABLE: MorseGot.heard else: MorseGot.lost
        s.done += 1; s.worst = 2.0
    keying = ""
    if s.done < s.marks.len() and at >= f64(s.marks[s.done].from):
        s.worst = min(s.worst, signal)
        if s.worst >= MORSE_READABLE: keying = morse_keyed(s.marks[s.done], int(floor(at))-s.marks[s.done].from)
    heard = false
    loop k in 0..s.done:
        if s.got[k] == .heard or s.got[k] == .lost: heard = true
    if heard or s.last.raw == "":
        # (read again only when another character has been passed)
        if s.read != s.done or s.line.held:
            s.line = _morse_read(s); s.read = s.done
        s.line.keying = keying; s.line.label = label
    else: s.line = s.last

# How strongly the strip shows `now`: whole while fed, gone `MORSE_FADE` seconds after the keying
# stops (the dial moved off, the signal gone, the set switched off).
const MORSE_FADE = 0.6
morse_shown = (s: MorseSubtitle, now: f64) -> f64:
    if s.key == "" or (s.line.raw == "" and s.line.keying == "" and s.line.plain == ""): return 0.0
    clamp(1.0-(now-s.fed-0.1)/MORSE_FADE, 0.0, 1.0)

# The keying over: nothing more is shown (a new world, the pause before a new flight).
morse_clear = (s: mut MorseSubtitle):
    s.key = ""; s.text = ""; s.whole = ""; s.read = -1; s.line = MorseLine(); s.last = MorseLine(); s.sending = -1; s.done = 0; s.fed = -1000.0
