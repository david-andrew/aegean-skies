# A pilot in the water after a bail-out or a ditching, as the player sees them: chest-deep on the
# swell the sea is drawn with, in a yellow life vest, waving at an aircraft that comes near, and a
# patch of green marker dye spreading round them on the water (an airman's sea marker), so a
# survivor can be found from the air. Drawing only: where they are is the Descent's.
use 'bailout.jo'
use 'render_space.jo'
use 'world_point.jo'
use 'world_blend.jo'
use 'folk.jo'
use 'objects.jo'
use 'sea.jo'
use 'look.jo'

const DYE_GROW = 0.22               # metres a second the patch spreads by
const DYE_MOST = 16.0               # its widest
const SWIM_DEPTH_DRAWN = 1.32       # the figure's feet below the water: the shoulders awash

survivor_vest_mesh = Mesh()
survivor_vest_ready = false
survivor_dye_mesh = Mesh()
survivor_dye_ready = false

# The vest: a padded yellow collar and front, round a figure's chest (a standing figure's frame).
_vest_vertices = () -> Vertex3D[]:
    vs: Vertex3D[]
    yellow = rgb(0.93,0.74,0.16); shade = rgb(0.80,0.60,0.10)
    add_box(vs,vec3(0,1.33,0.0),vec3(0.46,0.26,0.30),yellow)
    add_box(vs,vec3(0,1.50,0.0),vec3(0.36,0.10,0.26),shade)
    add_box(vs,vec3(-0.12,1.28,-0.17),vec3(0.14,0.18,0.06),shade)
    add_box(vs,vec3(0.12,1.28,-0.17),vec3(0.14,0.18,0.06),shade)
    vs

# How long this survivor has been in the water (s).
survivor_wet = (d: Descent) -> f64: max(0.0,d.age-max(0.0,d.wet))

# The frame a swimmer is drawn in: on the swell at their place, turned to `yaw`, bobbing a little.
swimmer_frame = (d: Descent, t: f64, yaw: f64) -> mat4:
    at = descent_point(d)
    s = swell_at(at.x,at.z,t)
    bob = sin(t*1.7+f64(d.person)*0.7)*0.06
    translation(vec3(d.position.x,f32(f64(s.x)-SWIM_DEPTH_DRAWN+bob),d.position.z))*rotation_y(yaw)*rotation_z(f32(sin(t*0.9+f64(d.person))*0.06))

# A survivor's figure, vest and all; waving (an arm up and over) when `waving`, else treading water.
draw_swimmer = (fig: Figure, d: Descent, L: Light, t: f64, toward: vec3, waving: bool):
    global survivor_vest_mesh, survivor_vest_ready
    if not survivor_vest_ready:
        survivor_vest_mesh = mesh(_vest_vertices()); survivor_vest_ready = true
    look = toward-d.position
    yaw = if length(vec2(look.x,look.z)) > 1.0: atan2(f64(look.x),f64(look.z))+PI else: d.yaw
    at = swimmer_frame(d,t,yaw)
    wave = if waving: 0.75+0.25*sin(t*6.0+f64(d.person)) else: 0.12+0.06*sin(t*2.2+f64(d.person))
    local = at; local[3] = vec4(0,0,0,1)
    draw_figure_at(fig,at,t*1.4,0.0,L,t,wave=wave,offset=world_residual(descent_point(d)))
    draw(obj_sh,survivor_vest_mesh,obj_params(L,t,local,anchor=world_offset(descent_point(d),at[3].xyz-d.position)))

# The marker dye round every swimmer within `reach` of the camera: a soft-edged green patch,
# a few overlapping turned squares (it reads as round at a glance) on the swell, spreading.
draw_survivor_dye = (descents: Descent[], t: f64, reach: f64 = 6000.0):
    global survivor_dye_mesh, survivor_dye_ready
    origin = render_origin(scene_camera())
    patches: Instance3D[]
    loop d in descents:
        if d.phase != .swimming or d.released: continue
        if f64(length(d.position-scene_camera())) > reach: continue
        r = min(DYE_MOST,2.5+survivor_wet(d)*DYE_GROW)
        at = descent_point(d)
        level = f64(swell_at(at.x,at.z,t).x)+0.05
        centre = world_local(WorldPoint(at.x,level,at.z),origin)
        loop k in 0..4:
            turn = f64(k)*0.3927+f64(d.person%7)*0.2
            # (an inner bright patch and a wider pale one)
            loop ring in 0..2:
                size = f32(2.0*r*(if ring == 0: 0.62 else: 1.0))
                alpha = f32(if ring == 0: 0.30 else: 0.16)
                patches.push(instance(translation(centre)*rotation_y(f32(turn))*scaling(vec3(size,0.02,size)),rgba(0.42,0.86,0.36,alpha)))
    if patches.len() == 0: return
    if not survivor_dye_ready:
        survivor_dye_mesh = cube_mesh(1.0); survivor_dye_ready = true
    draw_custom((): draw_world_blend(survivor_dye_mesh,patches,origin,0.35),transparent=true)
