# A pilot in the water after a bail-out or a ditching, as the player sees them: chest-deep on the
# swell the sea is drawn with, in a life vest of the late 1920s (kapok in buff canvas pockets: the
# bright yellow came a decade and more later), waving at an aircraft that comes near. The HUD's
# mark finds them from the air. Drawing only: where they are is the Descent's.
use 'bailout.jo'
use 'render_space.jo'
use 'world_point.jo'
use 'world_blend.jo'
use 'folk.jo'
use 'objects.jo'
use 'sea.jo'
use 'look.jo'

const SWIM_DEPTH_DRAWN = 1.32       # the figure's feet below the water: the shoulders awash

survivor_vest_mesh = Mesh()
survivor_vest_ready = false

# The vest: kapok sewn into buff canvas pockets, front and back panels round a figure's chest (a
# standing figure's frame), the pockets' seams darker, tied with webbing straps.
_vest_vertices = () -> Vertex3D[]:
    vs: Vertex3D[]
    canvas = rgb(0.74,0.67,0.52); seam = rgb(0.55,0.49,0.37); strap = rgb(0.42,0.36,0.27)
    loop z in [-0.16,0.16]:
        # (two rows of pockets each side)
        loop row in [1.24,1.42]:
            loop x in [-0.12,0.12]:
                add_box(vs,vec3(f32(x),f32(row),f32(z)),vec3(0.21,0.16,0.07),canvas)
        add_box(vs,vec3(0,1.33,f32(z*1.02)),vec3(0.03,0.36,0.072),seam)
    add_box(vs,vec3(0,1.33,0),vec3(0.46,0.05,0.34),strap)
    add_box(vs,vec3(0,1.53,0),vec3(0.30,0.06,0.28),seam)
    vs

# How long this survivor has been in the water (s).
survivor_wet = (d: Descent) -> f64: max(0.0,d.age-max(0.0,d.wet))

# The frame a swimmer is drawn in: on the swell at their place, turned to `yaw`, bobbing a little.
swimmer_frame = (d: Descent, t: f64, yaw: f64) -> mat4:
    at = descent_point(d)
    s = swell_at(at.x,at.z,t)
    bob = sin(t*1.7+f64(d.person)*0.7)*0.06
    translation(vec3(d.position.x,f32(f64(s.x)-SWIM_DEPTH_DRAWN+bob),d.position.z))*rotation_y(yaw)*rotation_z(f32(sin(t*0.9+f64(d.person))*0.06))

# A survivor's figure, vest and all; waving (an arm up and over) when `waving`, else treading water.
draw_swimmer = (fig: Figure, d: Descent, L: Light, t: f64, toward: vec3, waving: bool):
    global survivor_vest_mesh, survivor_vest_ready
    if not survivor_vest_ready:
        survivor_vest_mesh = mesh(_vest_vertices()); survivor_vest_ready = true
    look = toward-d.position
    yaw = if length(vec2(look.x,look.z)) > 1.0: atan2(f64(look.x),f64(look.z))+PI else: d.yaw
    at = swimmer_frame(d,t,yaw)
    wave = if waving: 0.75+0.25*sin(t*6.0+f64(d.person)) else: 0.12+0.06*sin(t*2.2+f64(d.person))
    local = at; local[3] = vec4(0,0,0,1)
    draw_figure_at(fig,at,t*1.4,0.0,L,t,wave=wave,offset=world_residual(descent_point(d)))
    draw(obj_sh,survivor_vest_mesh,obj_params(L,t,local,anchor=world_offset(descent_point(d),at[3].xyz-d.position)))
