# What has the screen: the game's panels (`Ui`) and the overlays beside them, and the one rule for
# the mouse wheel: while any menu, panel or overlay is open the wheel is its own (a panel that
# scrolls, scrolls) and never brings a camera nearer or farther. A new panel is covered by being a
# `Ui` state, or one more flag here.

enum Ui: none, talk, board, handling, trade, contract, maps, fuel, leisure, workshop
const UI_STATES = 10

struct Overlays:
    ui: Ui = .none
    paused = false                  # the pause menu (and its pages)
    notebook = false
    chart = false                   # the chart and its maps
    skip = false                    # time passing (the card with the clock)
    sitting = false                 # at a table, or on a stool at the bar, with its card
    seat_view = false               # (sitting with only the table's own bar along the bottom: the
                                    # view about the seat is the player's to turn and zoom)

overlays_open = (o: Overlays) -> bool:
    if o.paused or o.notebook or o.chart or o.skip: return true
    if o.seat_view: return false
    o.ui != .none or o.sitting

# A camera's distance after a step that may have read the wheel: the step's, or as it was before
# when something is open.
wheel_kept = (stepped: f64, before: f64, open: bool) -> f64: if open: before else: stepped

# ---------------- turning the view about a seat ----------------
# Seated (a table, a stool) or in a room (a stay), the view turns from where it is: each drag,
# finger or mouse, and the stick add to the yaw and pitch, never starting again from a base. The
# first frame of a press brings no turn: a touch screen's mouse jumps there from wherever the last
# touch ended, and that jump is not a drag.
struct ViewTurn:
    yaw = 0.0
    pitch = 0.0

view_turn = (v: ViewTurn, drag: vec2, pressed_now: bool, stick: vec2, dt: f64, up: f64, lo: f64, hi: f64, touch: bool = false) -> ViewTurn:
    d = if pressed_now: vec2(0, 0) else: drag
    gx = if touch: touch_look_gain() else: 0.005
    gy = if touch: touch_look_gain() * TOUCH_LOOK_PITCH else: 0.004
    ViewTurn(v.yaw - f64(d.x) * gx - f64(stick.x) * 2.2 * dt, clamp(v.pitch + (f64(d.y) * gy + f64(stick.y) * 1.6 * dt) * up, lo, hi))

# A finger's drag turns a view (on foot, seated, in a room, lying back under the sky) by the screen,
# not by its pixels: a swipe across the whole width turns it half round, whatever the phone's size
# or density (the screen's units are its own: 1067 across a phone on its side, fewer upright); up
# and down a little less. (The mouse keeps its own: its drags are pixels, read as usual.)
const TOUCH_LOOK_PER_WIDTH = 3.14159
const TOUCH_LOOK_PITCH = 0.7
touch_look_gain = () -> f64: TOUCH_LOOK_PER_WIDTH / max(f64(screen_width()), 1.0)

# The wheel's one speed. Sloppy's set_wheel_scale makes a notch count for less in mouse_wheel, so
# every list, text box and zoom that reads it follows the Options page's Scroll speed; x1 there is
# WHEEL_BASE of a notch (a whole notch was too much, in menus and for zooming alike).
const WHEEL_BASE = 0.5
apply_scroll_speed = (speed: f64): set_wheel_scale(WHEEL_BASE * clamp(speed, 0.2, 4.0))

# A camera's zoom: a notch (at a wheel scale of 1) takes the distance to WHEEL_ZOOM of what it was,
# spread over a few frames. wheel_zoom_step reads the wheel once a frame (not while anything is
# open); the camera that has the wheel multiplies its distance by wheel_zoom().
const WHEEL_ZOOM = 0.92
const WHEEL_ZOOM_SECONDS = 0.04     # (how quickly a notch's zoom is taken up: about 0.1 s in all)
_zoom_left = 0.0                    # (the zoom still to come, as a logarithm)
_zoom_now = 1.0
wheel_zoom_step = (dt: f64, open: bool): wheel_zoom_take(mouse_wheel(), dt, open)
# (a frame's notches, as wheel_zoom_step reads them)
wheel_zoom_take = (notches: f64, dt: f64, open: bool):
    global _zoom_left, _zoom_now
    _zoom_left = if open: 0.0 else: _zoom_left + clamp(notches, -3.0, 3.0) * log(WHEEL_ZOOM)
    take = if abs(_zoom_left) < 0.0005: _zoom_left else: _zoom_left * (1.0 - exp(-max(dt, 0.0) / WHEEL_ZOOM_SECONDS))
    _zoom_left -= take
    _zoom_now = exp(take)
wheel_zoom = () -> f64: _zoom_now
