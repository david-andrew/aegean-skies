use 'terrain_lod.jo'
use 'depth_space.jo'
use 'geography.jo'
# Procedural riparian corridor, attached to the authoritative carved surface.
use 'river_data.jo'
use 'river_field.jo'
use 'world.jo'
use 'world_source.jo'
use 'world_point.jo'
use 'objects.jo'
use 'plants.jo'
use 'look.jo'
use 'render_space.jo'
use 'quality.jo'
struct RiverBankBatch:
    center:vec3
    distant:Mesh
    plants:Mesh
    ready=false
    bounds:vec3=vec3(0,0,0)
    radius:f64=0.0
river_bank_batches:RiverBankBatch[]
river_bank_far_sh:Shader

river_tree=(vs:mut Vertex3D[],at:vec3,kind:int,seed:f64,detail:bool=true):
    wood=rgb(0.38,0.36,0.28)
    if not detail:
        add_cylinder(vs,at,0.22,if kind==0:9.0 else:5.0,wood,4,0.08)
        if kind==0:
            add_sphere(vs,vec3(0,0,0),1.0,rgb(0.25,0.40,0.16),4,2,translation(at+vec3(0,9,0))*scaling(vec3(1.8,5.0,1.6)))
        else:
            loop j in 0..3:
                angle=f64(j)*TAU/3.0+seed
                add_sphere(vs,vec3(0,0,0),1.0,rgb(0.23,0.39,0.15),4,2,translation(at+vec3(cos(angle)*2.1,6,sin(angle)*2.1))*scaling(vec3(3.4,2.2,3.0)))
        return
    if kind==0:
        # Upright poplar, clustered narrow crowns and exposed pale trunk.
        add_cylinder(vs,at,0.20,10.0,wood,5,0.08)
        loop j in 0..3:
            add_sphere(vs,at+vec3(f32(sin(seed+f64(j))*0.5),f32(6+j*2),0),1.0,rgb(0.20+0.025*f64(j),0.37+0.02*f64(j),0.13),5,3,translation(at)*scaling(vec3(1,1,1))*translation(-at))
            # Tall lobes retain a recognisable silhouette at low detail.
            add_sphere(vs,vec3(0,0,0),1.0,rgb(0.25,0.40,0.16),5,3,translation(at+vec3(0,f32(8+j),0))*scaling(vec3(1.6,3.0,1.4)))
    else:
        # Plane tree: spreading limbs and broad, irregular lobed canopy.
        add_cylinder(vs,at,0.38,5.5,wood,6,0.16)
        loop j in 0..5:
            a=f64(j)*TAU/5.0+seed
            c=at+vec3(f32(cos(a)*2.4),f32(5.0+f64(j%2)),f32(sin(a)*2.4))
            add_sphere(vs,vec3(0,0,0),1.0,rgb(0.20+f64(j%3)*0.035,0.36+f64(j%3)*0.025,0.13),6,3,translation(c)*scaling(vec3(3.2,2.1,2.8)))

init_river_banks=():
    global river_bank_batches,river_bank_far_sh
    river_bank_far_sh=make_world_shader(shader(obj_vs,obj_far_fs))
    loop group in 0..(RIVER_NODES.len()-2)/4+1:
        c=RIVER_NODES[min(group*4+2,RIVER_NODES.len()-1)]
        river_bank_batches.push(RiverBankBatch(vec3(c.x,0,c.y),Mesh(),Mesh()))

build_river_bank=(group:int)->RiverBankBatch:
    first=group*4;finish=min(first+4,RIVER_NODES.len()-1)
    c=RIVER_NODES[(first+finish)/2];origin=vec3(c.x,0,c.y)
    plants:Vertex3D[]
    distant:Vertex3D[]
    loop i in first..finish:
        if RIVER_BREAKS.contains(i) or i>=CANAL_BEGIN:continue
        a=RIVER_NODES[i];b=RIVER_NODES[i+1]
        dir=normalize(b.xy-a.xy);side=vec2(-dir.y,dir.x)
        loop j in 0..16:
            u=f64(j)/16.0
            pa=mix(a.xy,b.xy,f32(u))
            wa=mix(a.w,b.w,f32(u))
            loop sign in [-1.0,1.0]:
                seed=f64(i*19+j*7)+sign*5.0
                p=pa+side*wa*f32(sign*(1.19+0.12*noise(seed,3.0)))
                h=world_source_surface(f64(p.x),f64(p.y))
                r=river_at(f64(p.x),f64(p.y))
                at=vec3(p.x-origin.x,f32(h),p.y-origin.z)
                if h>r.level+0.5:
                    river_tree(plants,at,if i%3==0:0 else:1,seed)
                    river_tree(distant,at,if i%3==0:0 else:1,seed,false)
                if h>r.level+0.1 and j%4==1:
                    loop vertex in plant_vertices(OLEANDER):
                        vtx=vertex;vtx.pos+=at;plants.push(vtx)
                # Locate the actual waterline separately from the higher tree bank.
                # The inside and outside of a bend have different carved profiles.
                loop reed in 0..4:
                    rp=pa+dir*f32(reed)*2.0
                    lo=wa*0.4;hi=wa*1.5
                    level=mix(a.z,b.z,f32(u))
                    loop search in 0..7:
                        reach=(lo+hi)*0.5
                        probe=rp+side*f32(sign)*reach
                        if world_source_surface(f64(probe.x),f64(probe.y))>f64(level)+0.12:hi=reach
                        else:lo=reach
                    rp+=side*f32(sign)*hi
                    rh=world_source_surface(f64(rp.x),f64(rp.y))
                    rat=vec3(rp.x-origin.x,f32(rh),rp.y-origin.z)
                    loop stem in 0..3:
                        off=vec3(f32(sin(seed+f64(stem)))*0.4,0,f32(cos(seed+f64(stem)))*0.4)
                        add_cylinder(plants,rat+off,0.055,1.4+noise(seed,f64(reed)),rgb(0.28,0.39,0.14),3,0.015)
    low=vec3(1e9,1e9,1e9);high=vec3(-1e9,-1e9,-1e9)
    loop v in plants:low=min(low,v.pos);high=max(high,v.pos)
    loop v in distant:low=min(low,v.pos);high=max(high,v.pos)
    bounds=if plants.len()+distant.len()>0:(low+high)*0.5 else:vec3(0,0,0)
    radius=if plants.len()+distant.len()>0:f64(length(high-low))*0.5 else:0.0
    RiverBankBatch(origin,if distant.len()>0:mesh(distant) else:Mesh(),if plants.len()>0:mesh(plants) else:Mesh(),true,origin+bounds,radius)

draw_river_banks=(L:Light,t:f64):
    global river_bank_batches
    if not geography_enabled:return
    cam=scene_camera()
    if cam.x<RIVER_BOUNDS.x-8000 or cam.x>RIVER_BOUNDS.z+8000 or cam.z<RIVER_BOUNDS.y-8000 or cam.z>RIVER_BOUNDS.w+8000:return
    zone("river banks")
    generated=false
    planes=land_planes(scene_view_proj())
    loop i in 0..river_bank_batches.len():
        batch=river_bank_batches[i]
        d=length(cam.xz-batch.center.xz)
        if d>=3500:continue
        if not batch.ready:
            if generated:continue
            batch=build_river_bank(i);river_bank_batches[i]=batch;generated=true
        # Cull the actual complete mesh, including the bank slope and tall crowns.
        # Curvature enlarges the sphere by a conservative sag bound.
        warped=render_world(batch.bounds,cam)
        radius=batch.radius+d*batch.radius/EARTH_RADIUS+batch.radius*batch.radius/EARTH_RADIUS+1.0
        visible=true
        loop plane in planes:
            if f64(dot(plane.xyz,warped)+plane.w)< -radius:visible=false
        if not visible:continue
        p=obj_params(L,t,anchor=world_point(batch.center))
        if d<3500:
            geometry=if d<(if render_quality.tier==0:450 else:900):batch.plants else:batch.distant
            if geometry.count>0:draw(if f64(length(cam-batch.bounds))-batch.radius>300.0:river_bank_far_sh else:obj_sh,geometry,p)
    zone_end()
