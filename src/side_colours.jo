# The colours that tell sides apart, wherever the game marks them: enemies warm (red-orange),
# friends cool (blue), everyone else a neutral cream. Every marker that shows a side takes its
# colour from here and nowhere else (lead rings, the target brackets and their names, people in
# the water, the formation's place, the radio's speakers), so the colour-blind setting swaps the
# whole set at once (the Settings page's Accessibility section: set_colour_vision).

enum Standing: neutral, ally, enemy

# How the player tells colours apart (Options.colour_vision). Each preset is its own set of
# colours for the player to see, never a filter over the picture; the simulation of an eye is
# only how each set is checked (src/colour_vision.jo, tests/colour_vision_test.jo,
# docs/accessibility.md):
#   standard     enemy red-orange, friend blue, others cream; firm like the presets (a whole
#                halo, a pixel heavier, names on a wide outline), so its marks and names keep
#                their contrast on the grounds between light and dark
#   red_green    (protanopia, deuteranopia) enemy orange against friend blue, never red against
#                green: Okabe and Ito's orange, the standard friend's blue
#   blue_yellow  (tritanopia) enemy orange against friend teal. The teal is a bright one: the
#                game's sky is teal itself, and the palettes' quieter teals sink into it
#   monochrome   (no colour at all) the sides by shape on every mark (a chevron an enemy's, a ring
#                a friend's, a dot anyone else's) and by lightness: enemy white, friend dark,
#                others between
# In the three presets one side is a dark mark in a pale halo, where the others are light marks
# in a dark one (others in the colour presets, friends with no colour): a difference no eye
# loses, which puts the weakest pair of each preset far past the 20 the tests ask.
enum ColourVision: standard, red_green, blue_yellow, monochrome

COLOUR_VISIONS = [ColourVision.standard, ColourVision.red_green, ColourVision.blue_yellow, ColourVision.monochrome]
# (as the Settings page names them)
COLOUR_VISION_LABELS = ["Standard", "Red-green", "Blue-yellow", "No colour"]

# Colours taken from the established colour-blind-safe sets (docs/accessibility.md has the sources).
const OKABE_ITO_ORANGE = rgba(0.902, 0.624, 0.0, 1.0)       # #E69F00
const SIDE_DARK = rgba(0.05, 0.05, 0.06, 1.0)               # a dark mark's ink

struct SidePalette:
    enemy: vec4 = rgba(1.0,0.47,0.32,1.0)
    ally: vec4 = rgba(0.46,0.72,1.0,1.0)
    neutral: vec4 = rgba(0.95,0.90,0.72,1.0)
    shapes = false                  # every mark carries its side's shape too, not only the target's and a survivor's
    halo = 0.7                      # how strong the halo under a side's line is
    dark: vec4 = rgba(0.03, 0.04, 0.05, 1.0)    # the halo under a light mark
    pale: vec4 = rgba(1.0, 1.0, 1.0, 1.0)       # the halo under a dark mark
    firm = false                    # marks at full strength (a mark asked for at 0.9 is drawn whole), the
                                    # halo whole under them, and names over a halo wide enough to be their
                                    # ground: what the contrast figures of the presets are for

side_palette_for = (v: ColourVision) -> SidePalette:
    match v:
        .standard: SidePalette(halo = 1.0, dark = rgba(0,0,0,1), firm = true)
        .red_green: SidePalette(enemy = OKABE_ITO_ORANGE, ally = rgba(0.46,0.72,1.0,1.0), neutral = SIDE_DARK, halo = 1.0, dark = rgba(0,0,0,1), firm = true)
        .blue_yellow: SidePalette(enemy = OKABE_ITO_ORANGE, ally = rgba(0.05,1.0,0.85,1.0), neutral = SIDE_DARK, halo = 1.0, dark = rgba(0,0,0,1), firm = true)
        .monochrome: SidePalette(enemy = rgba(1.0,1.0,1.0,1.0), ally = rgba(0.05,0.09,0.22,1.0), neutral = rgba(0.66,0.66,0.66,1.0), shapes = true, halo = 1.0, dark = rgba(0,0,0,1), firm = true)

colour_vision = ColourVision.standard
side_palette = SidePalette()

set_side_palette = (p: SidePalette):
    global side_palette
    side_palette = p

# The setting: the sides' palette, and the chart's country inks (below), swapped together.
# `shapes`: every mark carries its side's shape in this preset too (always so with no colour).
set_colour_vision = (v: ColourVision, shapes: bool = false):
    global colour_vision
    colour_vision = v
    p = side_palette_for(v)
    p.shapes = p.shapes or shapes
    set_side_palette(p)

# The inks a country is drawn in on the war chart (src/war_view.jo): nations, not sides, over the
# chart's cream paper, its pale blue sea and its green and tan land. Standard: red, blue, green.
# Red-green and blue-yellow: Okabe and Ito's orange and blue, and black, the three of their set
# that stay furthest apart for every kind of dichromat (38 or more in CIEDE2000) while standing
# off the paper, the sea and the land. No colour: three dark steps of lightness, all darker than
# the land so each shows on it; lightness alone cannot part three inks widely on a chart of
# many tones, so the chart hatches each country's ground its own way too (country_hatch), and
# every mark's words name its country.
country_ink_for = (v: ColourVision, country: int, a: f64 = 1.0) -> vec4:
    c = match v:
        .standard: (match country:
            1: vec3(0.64, 0.16, 0.11)
            2: vec3(0.14, 0.25, 0.52)
            _: vec3(0.27, 0.4, 0.2))
        .red_green, .blue_yellow: (match country:
            1: vec3(0.902, 0.624, 0.0)      # Okabe-Ito orange, #E69F00
            2: vec3(0.0, 0.447, 0.698)      # Okabe-Ito blue, #0072B2
            _: vec3(0.0, 0.0, 0.0))
        .monochrome: (match country:
            1: vec3(0.05, 0.04, 0.04)
            2: vec3(0.11, 0.18, 0.36)
            _: vec3(0.34, 0.32, 0.28))
    vec4(c.x, c.y, c.z, f32(a))

# Which way a country's held ground is hatched on the chart: all one way (0, rising to the
# right) unless the sides are told by shape, then each country's its own: 1 rising, 2 falling,
# any other level.
country_hatch = (country: int) -> int:
    if not side_palette.shapes: return 0
    match country:
        1: 0
        2: 1
        _: 2

side_colour = (s: Standing, alpha: f64 = 1.0) -> vec4:
    c = match s:
        .enemy: side_palette.enemy
        .ally: side_palette.ally
        .neutral: side_palette.neutral
    # (a firm palette: the marks at full strength; one fading in or out, or far off, still fades)
    a = if side_palette.firm: min(1.0, alpha / 0.9) else: alpha
    vec4(c.x,c.y,c.z,f32(f64(c.w)*a))

# Two in the same fight: the same side, friends; otherwise enemies (sides below 0: no side).
battle_standing = (mine: int, theirs: int) -> Standing:
    if mine < 0 or theirs < 0: return .neutral
    if mine == theirs: .ally else: .enemy

# A person of `country` as the player's country sees them: their own people friends, a country
# at war with it an enemy, anyone else neutral.
country_standing = (mine: int, country: int, at_war: bool) -> Standing:
    if mine < 0 or country < 0: return .neutral
    if country == mine: return .ally
    if at_war: .enemy else: .neutral

# A dark colour (one whose mark takes the pale halo): relative luminance under 0.18, the middle
# grey that is as far from white as from black in contrast.
side_is_dark = (c: vec4) -> bool:
    lin = (x: f32) -> f64: if f64(x) <= 0.04045: f64(x) / 12.92 else: pow((f64(x) + 0.055) / 1.055, 2.4)
    0.2126 * lin(c.x) + 0.7152 * lin(c.y) + 0.0722 * lin(c.z) < 0.18

# The halo under a mark of colour c in palette p: dark under a light mark, pale under a dark one,
# as strong as the palette makes it. Two tones 9:1 apart keep 3:1 with one or the other against
# any ground (WCAG 2.2, 1.4.11), which is what the presets' halos are for.
palette_halo = (p: SidePalette, c: vec4) -> vec4:
    ink = if side_is_dark(c): p.pale else: p.dark
    vec4(ink.x, ink.y, ink.z, f32(clamp(p.halo * f64(c.w), 0.0, 1.0)))

side_halo = (c: vec4) -> vec4: palette_halo(side_palette, c)

# A side's line on the view, over a thin halo, so a friend's blue reads against a bright sky
# (blue on blue: ΔE about 10) and an enemy's against the sea.
# (in a firm palette the line itself is a pixel heavier, so the mark reads by its own tone, not
# its halo's: a hairline in a halo twice its width looks like the halo)
side_line = (a: vec2, b: vec2, w: f64, c: vec4):
    core = w + _firm_weight()
    line(a, b, core + 2.0, side_halo(c))
    line(a, b, core, c)

_firm_weight = () -> f64: if side_palette.firm: 1.0 else: 0.0

# A side's words on the view (a target's name, a survivor's), centred at `at`, in its colour
# over an outline all round: a pale name reads on lit cloud, where a shadow to one side left it
# washed out. In a firm palette the outline is over a pixel and a half wide, enough to fill the letters'
# insides: by WCAG's reckoning the name's ground is then the outline itself, and its contrast
# (4.5:1 or better: 1.4.3) holds whatever lies behind.
side_text = (words: str, at: vec2, size: f64, c: vec4):
    _side_outline(words, at, size, c, true)
    text_centered(words, at, size, c)

# The same from its left end (the radio's speaker, the Settings page's legend).
side_words = (words: str, at: vec2, size: f64, c: vec4):
    _side_outline(words, at, size, c, false)
    text(words, at, size, c)

_side_outline = (words: str, at: vec2, size: f64, c: vec4, centred: bool):
    ink = side_halo(c)
    if not side_palette.firm: ink = vec4(ink.x, ink.y, ink.z, f32(0.9 * f64(c.w)))
    offsets = [vec2(1, 1), vec2(-1, 1), vec2(1, -1), vec2(-1, -1)]
    if side_palette.firm: offsets = [vec2(1.6, 0), vec2(-1.6, 0), vec2(0, 1.6), vec2(0, -1.6), vec2(1.2, 1.2), vec2(-1.2, 1.2), vec2(1.2, -1.2), vec2(-1.2, -1.2)]
    loop o in offsets:
        if centred: text_centered(words, at + o, size, ink) else: text(words, at + o, size, ink)

# A side's ring on the view, over the same halo.
side_ring = (p: vec2, radius: f64, w: f64, c: vec4):
    core = w + _firm_weight()
    ring(p, radius, core + 2.0, side_halo(c))
    ring(p, radius, core, c)

# The side's own sign beside its colour, so the side never rests on colour alone (in grey, an
# enemy's red-orange and a friend's blue are the same light): an enemy's a chevron pointing down
# at it, a friend's a ring, anyone else's a dot.
side_sign = (p: vec2, s: Standing, alpha: f64 = 1.0):
    c = side_colour(s, alpha)
    match s:
        .enemy:
            side_line(p + vec2(-5, -4), p + vec2(0, 2), 1.8, c)
            side_line(p + vec2(5, -4), p + vec2(0, 2), 1.8, c)
        .ally: side_ring(p, 4.5, 1.8, c)
        .neutral:
            circle(p, 3.2 + _firm_weight(), side_halo(c))
            circle(p, 2.2 + _firm_weight(), c)

# With the sides told by shape (SidePalette.shapes: the setting for no colour at all), the marks
# that are otherwise one shape in a side's colour carry the side's sign as well.
side_shapes = () -> bool: side_palette.shapes
