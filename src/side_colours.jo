# The colours that tell sides apart, wherever the game marks them: enemies warm (red-orange),
# friends cool (blue), everyone else a neutral cream. Every marker that shows a side takes its
# colour from here and nowhere else (lead rings, the target brackets and their names, people in
# the water, the formation's place, the radio's speakers), so the colour-blind setting swaps the
# whole set at once (the Settings page's Accessibility section: set_colour_vision).

enum Standing: neutral, ally, enemy

# How the player tells colours apart (Options.colour_vision). Each has its own palette, checked
# under a simulation of the eye it is for (src/colour_vision.jo, tests/colour_vision_test.jo):
#   standard     enemy red-orange, friend blue, others cream
#   red_green    (protanopia, deuteranopia) enemy orange against friend blue, never red against
#                green; others near white, clear of the orange
#   blue_yellow  (tritanopia) enemy red against friend teal; others white
#   monochrome   (no colour at all) the sides by shape on every mark (a chevron an enemy's, a ring
#                a friend's, a dot anyone else's) and by lightness as far as it goes: enemy
#                lightest, friend darkest, all three light enough to read on the sea (a friend
#                darker than this is lost on deep water)
enum ColourVision: standard, red_green, blue_yellow, monochrome

COLOUR_VISIONS = [ColourVision.standard, ColourVision.red_green, ColourVision.blue_yellow, ColourVision.monochrome]
# (as the Settings page names them)
COLOUR_VISION_LABELS = ["Standard", "Red-green", "Blue-yellow", "No colour"]

struct SidePalette:
    enemy: vec4 = rgba(1.0,0.47,0.32,1.0)
    ally: vec4 = rgba(0.46,0.72,1.0,1.0)
    neutral: vec4 = rgba(0.95,0.90,0.72,1.0)
    shapes = false                  # every mark carries its side's shape too, not only the target's and a survivor's
    halo = 0.7                      # how dark the halo under a side's line is

side_palette_for = (v: ColourVision) -> SidePalette:
    match v:
        .standard: SidePalette()
        .red_green: SidePalette(enemy = rgba(1.0,0.58,0.0,1.0), ally = rgba(0.30,0.52,1.0,1.0), neutral = rgba(0.97,0.97,0.97,1.0))
        .blue_yellow: SidePalette(enemy = rgba(0.95,0.22,0.22,1.0), ally = rgba(0.25,0.90,0.80,1.0), neutral = rgba(1.0,1.0,1.0,1.0))
        .monochrome: SidePalette(enemy = rgba(1.0,0.98,0.80,1.0), ally = rgba(0.42,0.62,0.95,1.0), neutral = rgba(0.80,0.80,0.80,1.0), shapes = true, halo = 0.95)

colour_vision = ColourVision.standard
side_palette = SidePalette()

set_side_palette = (p: SidePalette):
    global side_palette
    side_palette = p

# The setting: the sides' palette, and the chart's country inks (below), swapped together.
set_colour_vision = (v: ColourVision):
    global colour_vision
    colour_vision = v
    set_side_palette(side_palette_for(v))

# The inks a country is drawn in on the war chart (src/war_view.jo): nations, not sides, over the
# chart's cream paper, its pale blue sea and its green and tan land. Standard: red, blue, green.
# Red-green: orange, blue, near black (red and green are one colour to that eye). Blue-yellow:
# red, dark teal, near black (blue and green are one, and a lighter teal is lost on the chart's
# sea). No colour: three dark steps of lightness, all darker than the land so each shows on it;
# the steps are small, so the chart hatches each country's ground its own way too
# (country_hatch), and every mark's words name its country.
country_ink_for = (v: ColourVision, country: int, a: f64 = 1.0) -> vec4:
    c = match v:
        .standard: (match country:
            1: vec3(0.64, 0.16, 0.11)
            2: vec3(0.14, 0.25, 0.52)
            _: vec3(0.27, 0.4, 0.2))
        .red_green: (match country:
            1: vec3(0.90, 0.50, 0.0)
            2: vec3(0.08, 0.18, 0.60)
            _: vec3(0.15, 0.15, 0.15))
        .blue_yellow: (match country:
            1: vec3(0.78, 0.08, 0.08)
            2: vec3(0.0, 0.36, 0.34)
            _: vec3(0.12, 0.11, 0.11))
        .monochrome: (match country:
            1: vec3(0.05, 0.04, 0.04)
            2: vec3(0.11, 0.18, 0.36)
            _: vec3(0.34, 0.32, 0.28))
    vec4(c.x, c.y, c.z, f32(a))

# Which way a country's held ground is hatched on the chart: all one way (0, rising to the
# right) unless the sides are told by shape, then each country's its own: 1 rising, 2 falling,
# any other level.
country_hatch = (country: int) -> int:
    if not side_palette.shapes: return 0
    match country:
        1: 0
        2: 1
        _: 2

side_colour = (s: Standing, alpha: f64 = 1.0) -> vec4:
    c = match s:
        .enemy: side_palette.enemy
        .ally: side_palette.ally
        .neutral: side_palette.neutral
    vec4(c.x,c.y,c.z,f32(f64(c.w)*alpha))

# Two in the same fight: the same side, friends; otherwise enemies (sides below 0: no side).
battle_standing = (mine: int, theirs: int) -> Standing:
    if mine < 0 or theirs < 0: return .neutral
    if mine == theirs: .ally else: .enemy

# A person of `country` as the player's country sees them: their own people friends, a country
# at war with it an enemy, anyone else neutral.
country_standing = (mine: int, country: int, at_war: bool) -> Standing:
    if mine < 0 or country < 0: return .neutral
    if country == mine: return .ally
    if at_war: .enemy else: .neutral

# A side's line on the view, over a thin dark halo, so a friend's blue reads against a bright sky
# (blue on blue: ΔE about 10) and an enemy's against the sea.
# (the halo: side_palette.halo, darker where lightness alone tells the sides)
side_line = (a: vec2, b: vec2, w: f64, c: vec4):
    line(a, b, w + 2.0, rgba(0.03, 0.04, 0.05, f32(side_palette.halo * f64(c.w))))
    line(a, b, w, c)

# A side's words on the view (a target's name, a survivor's), centred at `at`, in its colour
# over a dark outline all round: a pale name reads on lit cloud, where a shadow to one side
# left it washed out.
side_text = (words: str, at: vec2, size: f64, c: vec4):
    dark = rgba(0.03, 0.04, 0.05, f32(0.9 * f64(c.w)))
    loop o in [vec2(1, 1), vec2(-1, 1), vec2(1, -1), vec2(-1, -1)]: text_centered(words, at + o, size, dark)
    text_centered(words, at, size, c)

# A side's ring on the view, over the same halo.
side_ring = (p: vec2, radius: f64, w: f64, c: vec4):
    ring(p, radius, w + 2.0, rgba(0.03, 0.04, 0.05, f32(side_palette.halo * f64(c.w))))
    ring(p, radius, w, c)

# The side's own sign beside its colour, so the side never rests on colour alone (in grey, an
# enemy's red-orange and a friend's blue are the same light: ΔE about 7): an enemy's a chevron
# pointing down at it, a friend's a ring, anyone else's a dot.
side_sign = (p: vec2, s: Standing, alpha: f64 = 1.0):
    c = side_colour(s, alpha)
    halo = rgba(0.03, 0.04, 0.05, f32(side_palette.halo * alpha))
    match s:
        .enemy:
            side_line(p + vec2(-5, -4), p + vec2(0, 2), 1.8, c)
            side_line(p + vec2(5, -4), p + vec2(0, 2), 1.8, c)
        .ally:
            ring(p, 4.5, 3.8, halo)
            ring(p, 4.5, 1.8, c)
        .neutral:
            circle(p, 3.2, halo)
            circle(p, 2.2, c)

# With the sides told by shape (SidePalette.shapes: the setting for no colour at all), the marks
# that are otherwise one shape in a side's colour carry the side's sign as well.
side_shapes = () -> bool: side_palette.shapes
