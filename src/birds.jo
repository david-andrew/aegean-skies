# Gulls: flocks wheeling along the coasts and over the harbors, each bird a little body and two
# wings that beat and glide. Something near to rush past when flying low, and life along the shore.

use 'world.jo'
use 'look.jo'
use 'render_space.jo'
use 'objects.jo'

struct Flock:
    center: vec3                    # what they circle
    radius: f64
    count: int
    speed: f64                      # radians a second round the circle
    seed: f64

struct BirdParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    sky: vec3
    shade: vec3
    haze: vec3
    fog: f32
    time: f32
    warp_a: vec4                    # (the speed trial's warp: render_space.jo)
    warp_b: vec4

bird_vs = (v: Vertex3D, inst: Instance3D, u: BirdParams) -> ObjOut:
    # (uv.x: how far out on a wing; inst.color.w: the bird's own beat)
    ph = u.time * 9.0 + inst.color.w * 37.0
    glide = smoothstep(0.2, 0.6, sin(u.time * 0.7 + inst.color.w * 13.0))
    beat = sin(ph) * (1.0 - glide * 0.85)
    p = v.pos + vec3(0, beat * 0.45 * v.uv.x * v.uv.x + v.uv.x * 0.08, 0)
    w = inst.model * vec4(p, 1)
    ObjOut(u.view_proj * w, w.xyz, (inst.model * vec4(v.normal, 0)).xyz, vec4(v.color.xyz, 1))

bird_fs = (i: ObjOut, u: BirdParams) -> vec4:
    n = normalize(i.normal)
    lit = cel(abs(dot(n, normalize(u.sun_dir))))
    c = i.color.xyz * (u.sun * lit + mix(u.shade, u.sky, 0.4) * 0.9)
    vec4(aerial(c, i.world, u.cam, u.haze, u.fog), 1)

bird_sh: Shader

init_birds = ():
    global bird_sh
    bird_sh = make_shader(shader(bird_vs, bird_fs))

# a gull, its beak along -z, about 1.3 m across the wings
build_bird = () -> Mesh:
    vs: Vertex3D[]
    white = vec4(0.97, 0.97, 0.95, 1)
    grey = vec4(0.62, 0.66, 0.7, 1)
    tip = vec4(0.15, 0.15, 0.17, 1)
    add_sphere(vs, vec3(0, 0, 0), 1.0, white, 6, 4, scaling(vec3(0.09, 0.08, 0.26)))
    tri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, out: f32, col: vec4):
        n = vec3(0, 1, 0)
        vs.push(Vertex3D(a, n, vec2(if a.x == 0.0: 0.0 else: out, 0), col))
        vs.push(Vertex3D(b, n, vec2(if b.x == 0.0: 0.0 else: out, 0), col))
        vs.push(Vertex3D(c, n, vec2(if c.x == 0.0: 0.0 else: out, 0), col))
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        # inner wing (grey), outer wing with a dark tip; uv.x grows toward the tip for the beat
        tri(vs, vec3(0, 0, -0.08), vec3(0.32 * sx, 0.02, -0.05), vec3(0, 0, 0.1), 0.5, grey)
        tri(vs, vec3(0.32 * sx, 0.02, -0.05), vec3(0.32 * sx, 0.02, 0.1), vec3(0, 0, 0.1), 0.5, grey)
        tri(vs, vec3(0.32 * sx, 0.02, -0.05), vec3(0.66 * sx, 0.0, 0.06), vec3(0.32 * sx, 0.02, 0.1), 1.0, tip)
    custom_mesh(vs)

# flocks along every inhabited island's coast, and over the harbors
build_flocks = (towns: Town[], seed: int) -> Flock[]:
    seed_random(seed)
    flocks: Flock[]
    loop tw in towns:
        flocks.push(Flock(tw.center + vec3(tw.out.x, 0, tw.out.y) * 60.0 + vec3(0, 22, 0), 45.0, 6 + random_int(0, 6), 0.35, random()))
    loop k in 0..ISLANDS.len():
        isl = ISLANDS[k]
        loop j in 0..(if isl.radius > 600.0: 4 else: 1):
            c, out = coast_point(k, random(0.0, TAU))
            alt = random(14.0, 70.0)
            flocks.push(Flock(vec3(c.x, f32(alt), c.y) + vec3(out.x, 0, out.y) * f32(random(20.0, 160.0)), random(25.0, 90.0), 4 + random_int(0, 9), random(0.2, 0.5) * (if random() < 0.5: -1.0 else: 1.0), random()))
    flocks

# where each bird is now (only the flocks near the camera)
bird_instances = (flocks: Flock[], cam: vec3, t: f64) -> Instance3D[]:
    out: Instance3D[]
    loop f in flocks:
        if length(f.center - cam) > 2500.0: continue
        loop b in 0..f.count:
            r = f.seed * 100.0 + f64(b) * 7.31
            ang = t * f.speed + f64(b) * TAU / f64(f.count) + sin(t * 0.3 + r) * 0.4
            rad = f.radius * (0.6 + 0.4 * sin(r * 1.7 + t * 0.13))
            y = sin(t * 0.5 + r) * 6.0 + f64(b % 3) * 2.0
            p = f.center + vec3(f32(cos(ang) * rad), f32(y), f32(sin(ang) * rad))
            # facing along the circle, banked into it
            dir = vec3(f32(-sin(ang)), 0, f32(cos(ang))) * f32(if f.speed < 0.0: -1.0 else: 1.0)
            m = translation(p) * facing(dir) * rotation_z(if f.speed < 0.0: -0.3 else: 0.3)
            out.push(Instance3D(m, vec4(1, 1, 1, f32((r * 0.37) % 1.0))))
    out

draw_birds = (bird: Mesh, flocks: Flock[], L: Light, t: f64):
    inst = bird_instances(flocks, scene_camera(), t)
    if inst.len() == 0: return
    draw_instanced(bird_sh, bird, inst, BirdParams(scene_view_proj(), scene_camera(), L.sun_dir, L.sun, L.sky_top, L.shade, L.haze, f32(L.fog_density), f32(t), scene_warp_a, scene_warp_b))
