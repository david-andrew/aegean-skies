# Capital clubs own physical flying only. Identity, sponsorship, parts, fuel and berths come
# from the living world's guarded APIs. A club is never a second aircraft/person registry.
use 'phoenix.jo'
use 'air_race.jo'
use 'air_classes.jo'
use 'air_pilot.jo'
use 'flight.jo'
use 'planes.jo'
use 'traffic.jo'
use 'world.jo'
use 'flight_ground.jo'
use 'air_arm.jo'
use 'airfields.jo'
import 'living_types.jo' as data
import 'living_calendar.jo' as calendar
import 'living_far_aircraft.jo' as registry
import 'living_scene.jo' as scene
import 'living_conditions.jo' as conditions
import 'living_money.jo' as money

club_spec = (p: AirClubPilot, w: data.World, models: CraftModel[]) -> CraftSpec:
    kind = Craft(int(w.aircraft[p.craft].kind)); spec = craft_spec(kind, models[p.model].contacts)
    spec.fuel_capacity = f64(data.AIRFRAMES[int(kind)].tank_ml) / 1000.0
    spec.fuel_burn = f64(data.AIRFRAMES[int(kind)].burn_ml_sec) / 1000.0
    spec

club_index = (events: AirEvents, craft: int) -> int:
    loop i in 0..events.pilots.len(): if events.pilots[i].craft == craft: return i
    -1

air_meet_index = (events: AirEvents, id: int) -> int:
    loop i in 0..events.meets.len(): if events.meets[i].id == id: return i
    -1

# A meet's stable ID: the club class keeps its original capital * 100000 + day (saves).
air_meet_id = (capital: int, day: int, c: AirClass) -> int: capital * 100000 + day + (if c == .schneider: 50000 else: 0)

# The class a club aircraft races in (the club class for anything unlisted).
club_class = (w: data.World, craft: int) -> AirClass: air_class_of(Craft(int(w.aircraft[craft].kind))) ?? .club

# Whether a capital's club fields an aircraft of this class: the club class is always held (the
# player may race alone, as before); the Schneider race only when the club has a racer for it.
club_fields = (events: AirEvents, w: data.World, capital: int, c: AirClass) -> bool:
    if c == .club: return true
    loop p in events.pilots:
        if p.capital == capital and club_class(w, p.craft) == c: return true
    false

# How near a meet's harbour a position is, for entries and drawing: the start gate's distance,
# with room for a larger course.
air_meet_near = (meet: AirMeet, position: vec3, reach: f64 = 12000.0) -> bool:
    meet.gates.len() > 0 and f64(length(meet.gates[0].center - position)) < reach * max(meet.scale, 1.0)

# A club slot's registration key: club-class slots keep their original keys (saves); the
# Schneider slots have their own.
_club_key = (capital: int, c: AirClass, slot: int) -> str: if c == .schneider: "air-club:{capital}:s{slot}" else: "air-club:{capital}:{slot}"

# Call once a minute after the world's clock. Failed purchases remain failures, not free
# replacement aircraft. Two club purchases each spend at most 5% of today's household purse.
prepare_air_events = (events: mut AirEvents, w: mut data.World, models: CraftModel[], ground: (f64, f64) -> f64 = flight_surface_height):
    if events.last_minute == w.minute or not w.far.populated: return
    events.last_minute = w.minute
    day = data.day_index(w.minute)
    # Retain a month of results, bounded independently of frame rate or visits.
    events.meets = [loop meet in events.meets: if day - meet.day <= 28: meet]
    loop ci in 0..w.countries.len():
        capital = w.countries[ci].capital_id
        if not (capital in w.far.harbors) or not (capital in w.far.districts): continue
        harbor = w.far.harbors[capital]; district = w.far.districts[capital]
        funder = district.household_account
        # (the capital's flying club keeps its own cohort of pilots, air_classes.jo)
        if district.pilot_slots < AIR_CLUB_PILOTS: w.far.districts[capital].pilot_slots = AIR_CLUB_PILOTS
        # The club's fleet by class: two club-class slots, then three Schneider slots from the
        # country's racing tradition, each the newest type the purse allows (air_classes.jo).
        slots: (AirClass, int, data.Airframe[], int)[] = [(.club, 0, CLUB_LINES[0], 0), (.club, 1, CLUB_LINES[1], 0)]
        loop k in 0..3: slots.push((.schneider, k, SCHNEIDER_LINES[ci % 2], k))
        loop sl in slots:
            key = _club_key(capital, sl.0, sl.1)
            # Registered ownership is permanent; never recreate a destroyed or sold aircraft.
            existing = w.far.air_registrations.get(key, -1)
            kind = data.Airframe.swift
            if existing < 0:
                kind = air_club_pick(sl.2, sl.3, w.accounts[funder].cents) ?? continue
            registration = registry.register_far_aircraft(w, capital, kind, funder, key)
            if registration.craft < 0: continue
            id = registration.craft
            if club_index(events, id) >= 0: continue
            model = default_craft_model(Craft(int(w.aircraft[id].kind)))
            w.aircraft[id].model_index = model
            spec = craft_spec(Craft(int(w.aircraft[id].kind)), models[model].contacts)
            body = water_start(spec, w.aircraft[id].pose.pos, atan2(f64(harbor.out.x), -f64(harbor.out.z)))
            body.fuel = f64(w.aircraft[id].fuel_ml) / 1000.0; moor(body, body.position, heading(body))
            pilot = AirClubPilot(id, registration.person, capital, model, body, FlightPlan(), last_tick = w.tick)
            if w.aircraft[id].scene_extension != "":
                saved = from_text[AirClubPilot](w.aircraft[id].scene_extension)
                if saved is AirClubPilot and saved.craft == id and saved.person == registration.person: pilot = saved
            events.pilots.push(pilot)
        if not calendar.capital_feast_day(capital, day): continue
        # A feast day holds a meet for each class: the Schneider race late in the morning, the
        # club race at five.
        loop race_class in [AirClass.club, AirClass.schneider]:
            id = air_meet_id(capital, day, race_class)
            if air_meet_index(events, id) >= 0 or not club_fields(events, w, capital, race_class): continue
            center = w.place_contexts[capital].center
            gates: AirGate[]; scale = 1.0
            loop k in air_class_scales(race_class):
                if gates.len() == 0:
                    gates = air_course(center, harbor.out, ground, k); scale = k
            if gates.len() == 0: continue
            start = (day * 1440 + air_class_start(race_class) - data.EPOCH_LOCAL_MINUTE) * data.TICKS_PER_MINUTE
            meet = AirMeet(id, capital, day, w.place_contexts[capital].name + " air meeting", gates,
                race_tick = start, display_tick = start + air_class_racing_minutes(race_class) * data.TICKS_PER_MINUTE, end_tick = start + air_class_meet_minutes(race_class) * data.TICKS_PER_MINUTE,
                race_class = race_class, scale = scale)
            # Venue data counts residents but never instantiates named people a second time.
            loop gathering in calendar.capital_gatherings(w, start / data.TICKS_PER_MINUTE):
                if gathering.place == capital: meet.audience = min(48, gathering.cohort_people)
            if harbor.quays.len() > 0:
                right = vec3(-harbor.out.z, 0, harbor.out.x)
                meet.quay_a = harbor.quays[0] - right * 12.0; meet.quay_b = harbor.quays[0] + right * 12.0
            loop pilot in events.pilots:
                if pilot.capital == capital and club_class(w, pilot.craft) == race_class: enter_air_meet(meet, pilot.craft, pilot.person, false, w.tick)
            events.meets.push(meet)

struct AirEntryResult:
    accepted = false
    reason = ""

# The entry fee goes to the host capital's household purse, through the ledger like any purchase.
AIR_MEET_FEE_CENTS = 2000
# (by class: the club fee above; the Schneider class's is higher, air_classes.jo)
air_meet_fee = (meet: AirMeet) -> int: air_class_fee(meet.race_class)

air_meet_fee_account = (w: data.World, capital: int) -> int:
    if capital in w.far.districts: w.far.districts[capital].household_account else: -1

enter_player_air_meet = (events: mut AirEvents, w: mut data.World, meet_id: int) -> AirEntryResult:
    i = air_meet_index(events, meet_id)
    if i < 0: return AirEntryResult(reason = "No meeting is scheduled here.")
    c = w.people[w.player].craft
    if c < 0: return AirEntryResult(reason = "An aircraft is needed.")
    body = w.aircraft[c]
    meet = events.meets[i]
    if (air_class_of(Craft(int(body.kind))) ?? .club) != meet.race_class or air_class_of(Craft(int(body.kind))) == none:
        return AirEntryResult(reason = "This is a {AIR_CLASS_NAMES[int(meet.race_class)].lower()} race: it needs {air_class_eligible(meet.race_class)}.")
    if body.hull < 700 or body.engine < 700 or body.fuel_ml < 10000: return AirEntryResult(reason = "Repair and refuel before entering.")
    if not air_meet_near(meet, body.pose.pos): return AirEntryResult(reason = "Enter at the host harbour.")
    if meet.phase != .registration or w.tick >= meet.race_tick or meet.entries.len() >= 8: return AirEntryResult(reason = "Entries are closed.")
    loop entry in meet.entries: if entry.craft == c or entry.person == w.player: return AirEntryResult(reason = "Already entered.")
    payer = w.people[w.player].account; purse = air_meet_fee_account(w, meet.capital)
    fee = air_meet_fee(meet)
    if payer < 0 or purse < 0 or w.accounts[payer].cents < fee: return AirEntryResult(reason = "The entry fee is {phoenix_text(fee)}.")
    if not money.transfer(w, payer, purse, fee, .trade): return AirEntryResult(reason = "The entry fee is {phoenix_text(fee)}.")
    if not enter_air_meet(events.meets[i], c, w.player, true, w.tick):
        # (refused after the fee moved: the same purse gives it back, so no lepton is made or lost)
        _ = money.transfer(w, purse, payer, fee, .refund)
        return AirEntryResult(reason = "Entries are closed.")
    loop mut entry in events.meets[i].entries:
        if entry.person == w.player and entry.human: entry.fee = fee
    AirEntryResult(true, "")

# The fee the club returns on withdrawal now, by the meet's rule (0 once the race has begun).
air_withdraw_refund = (meet: AirMeet, entry: AirEntry, tick: int) -> int:
    if meet.phase != .registration or tick >= meet.race_tick: return 0
    entry.fee * clamp(meet.withdraw_refund, 0, 100) / 100

# The player withdraws from a meet. Before the start the entry is struck off and the fee
# returned by the meet's rule, from the purse it was paid into; once racing, they are
# recorded as withdrawn and the fee is kept. A purse that cannot pay changes nothing.
withdraw_player_air_meet = (events: mut AirEvents, w: mut data.World, meet_id: int) -> AirEntryResult:
    i = air_meet_index(events, meet_id)
    if i < 0: return AirEntryResult(reason = "No meeting is scheduled here.")
    meet = events.meets[i]
    entry = player_air_entry(meet, w.player) ?? return AirEntryResult(reason = "You are not entered.")
    if entry.finished_tick >= 0 or entry.disqualified or meet.phase == .finished or meet.phase == .cancelled: return AirEntryResult(reason = "The race is over.")
    back = air_withdraw_refund(meet, entry, w.tick)
    if back > 0:
        payer = w.people[w.player].account; purse = air_meet_fee_account(w, meet.capital)
        if payer < 0 or purse < 0 or not money.transfer(w, purse, payer, back, .refund): return AirEntryResult(reason = "The club cannot return the fee just now.")
    if meet.phase == .registration and w.tick < meet.race_tick:
        events.meets[i].entries = [loop e in meet.entries: if not (e.person == w.player and e.human): e]
    else:
        loop mut e in events.meets[i].entries:
            if e.person == w.player and e.human: e.disqualified = true; e.fee = 0
    AirEntryResult(true, "")

# A meeting called off returns the entry fees still held, by its rule.
refund_cancelled_air_meet = (meet: mut AirMeet, w: mut data.World):
    if meet.phase != .cancelled: return
    purse = air_meet_fee_account(w, meet.capital)
    loop mut entry in meet.entries:
        if not entry.human or entry.fee <= 0 or entry.person < 0 or entry.person >= w.people.len(): continue
        back = entry.fee * clamp(meet.withdraw_refund, 0, 100) / 100
        payer = w.people[entry.person].account
        if back > 0 and (purse < 0 or payer < 0 or not money.transfer(w, purse, payer, back, .refund)): continue
        entry.fee = 0

# The player's own entry in a meet, or none.
player_air_entry = (meet: AirMeet, person: int) -> AirEntry?:
    loop entry in meet.entries: if entry.person == person and entry.human: return entry
    none

withdraw_air_meet = (events: mut AirEvents, meet_id: int, craft: int) -> bool:
    i = air_meet_index(events, meet_id)
    if i < 0: return false
    loop mut entry in events.meets[i].entries:
        if entry.craft == craft and entry.finished_tick < 0: entry.disqualified = true; return true
    false

nearby_air_meets = (events: AirEvents, position: vec3) -> AirMeet[]:
    [loop meet in events.meets: if air_meet_near(meet, position, 15000.0): meet]

# Display is a broad horizontal figure eight, staggered in height and phase, with wing
# greetings on the straight passes. It uses control inputs, never animated aircraft poses.
air_display_task = (pilot: AirClubPilot, center: vec3, out: vec3, tick: int, speed: f64) -> AirTask:
    a = f64(tick) / 60.0 / 12.0 + f64(pilot.craft % 2) * PI
    side = vec3(-out.z, 0, out.x); radius = max(650.0, speed * 7.0)
    at = center + side * f32(sin(a) * radius) + out * f32(sin(a * 2.0) * radius * 0.42)
    AirTask(pilot.craft, at, 260 + f64(pilot.craft % 2) * 80.0, 0.95)

# One club pilot's tick of flight (what update_air_events runs for each tick since the last; a
# held tick, while a world minute is in progress, runs it too): the World only read.
_club_tick = (events: mut AirEvents, p: mut AirClubPilot, w: data.World, spec: CraftSpec, out: vec3, contacts: AirContact[], e: FlightEnv, tick: int):
    mi = air_meet_index(events, p.meet)
    returning = if p.meet >= 0: mi < 0 or events.meets[mi].phase == .finished or events.meets[mi].phase == .cancelled else: tick >= p.practice_until
    returning = returning or p.state.fuel < 22.0
    approach_busy = false
    # (one already down, taxiing, or on its final approach keeps it)
    if returning and not p.state.on_water and p.plan.phase != .land and p.plan.phase != .taxi and p.plan.phase != .done:
        loop other in events.pilots:
            if other.craft < p.craft and other.capital == p.capital and other.active and not other.state.on_water:
                # (only a clubmate coming home too has the approach; one going out to its
                # own class's race does not hold this one up)
                mo = air_meet_index(events, other.meet)
                other_home = if other.meet >= 0: mo < 0 or events.meets[mo].phase == .finished or events.meets[mo].phase == .cancelled else: tick >= other.practice_until
                if other_home or other.state.fuel < 22.0: approach_busy = true
    if tick >= p.next_think:
        p.next_think = tick + 6
        air_think(p.air, AirProfile(temperament = .racer, altitude = 260, pace = min(1.0, 140.0 / spec.cruise_speed)), p.craft, p.capital, p.state, spec, p.plan.target, contacts, [], -1, tick, e)
        if p.departing:
            taxi = FlightPlan(phase = .taxi, initialized = true, taxi_target = if p.air.avoiding: p.air.aim else: p.departure)
            p.controls = air_autopilot(spec, p.state, taxi, e); p.controls.anchor = false
            if length((p.state.position - p.departure).xz) < 8 and length(p.state.velocity) < 1:
                p.departing = false; p.plan.phase = .takeoff
        else if p.plan.phase == .takeoff or p.plan.phase == .climb or (returning and not approach_busy):
            p.controls = air_autopilot(spec, p.state, p.plan, e)
        else:
            task = air_display_task(p, w.place_contexts[p.capital].center + out * 2200.0, out, tick, spec.cruise_speed)
            pace = min(spec.cruise_speed, 140.0)
            if mi >= 0:
                loop entry in events.meets[mi].entries:
                    if entry.craft == p.craft:
                        if let race = air_race_task(events.meets[mi], entry, p.state.position):
                            task = race
                            # (staggered heights; the fast class lower, well under its ceiling)
                            task.altitude = if events.meets[mi].race_class == .schneider: 140.0 + f64(p.craft % 2) * 70.0 else: 130 + f64(p.craft % 2) * 140.0
                            pace = air_class_pace(events.meets[mi].race_class, spec.cruise_speed, spec.max_speed, events.meets[mi].scale)
            if approach_busy: task.altitude = 400; task.aim += out * 1500.0; task.pace = 0.60
            p.controls = air_waypoint_controls(spec, p.state, e, task.aim, task.altitude, pace * task.pace)
            if mi >= 0 and events.meets[mi].phase == .display: p.controls.roll += sin(f64(tick) / 60.0 * 2.0) * 0.18
        if p.air.avoiding:
            if p.state.on_water:
                if p.air.yield_water: p.controls.throttle = 0; p.controls.water_brake = 1.0
            else: p.controls = air_waypoint_controls(spec, p.state, e, p.air.aim, p.air.altitude, p.air.speed)
    if p.plan.phase == .failed and p.state.on_water and not p.state.crashed and not p.state.beached and p.state.fuel > 0: p.plan.phase = .taxi
    step(spec, p.state, p.controls, e, 1.0 / 60.0)
    p.prop += (8 + 70 * p.state.throttle) / 60.0
    if mi >= 0: sample_air_entry(events.meets[mi], p.craft, p.state.position, tick, not p.state.crashed)

# A held frame's flight for the club pilots and the air arm (a world minute in progress): each
# pilot in the air flies the scene's ticks up to `tick`, ahead of the World's, the World only
# read; update_air_events commits where they are once the World has caught up. `other_air`
# carries the player and the scene's traffic where they are now (the World's poses wait).
step_air_events_held = (events: mut AirEvents, w: data.World, models: CraftModel[], tick: int, other_air: AirContact[] = [], ground: (f64, f64) -> f64 = flight_surface_height):
    contacts = other_air + [loop p in events.pilots: AirContact(p.craft, p.state.position, p.state.velocity, p.capital, p.state.on_water, p.state.moored)]
    loop k in 0..events.pilots.len():
        p = events.pilots[k]
        if not p.active or p.last_tick >= tick or w.aircraft[p.craft].owner != p.person: continue
        spec = club_spec(p, w, models)
        e = FlightEnv(ground = ground, wind = conditions.wind_at(w, p.state.position))
        loop t in max(p.last_tick + 1, tick - 14)..tick + 1: _club_tick(events, p, w, spec, w.far.harbors[p.capital].out, contacts, e, t)
        p.last_tick = tick
        events.pilots[k] = p
    step_air_arm_held(events, w, models, tick, (x: f64, z: f64) -> f64: ground(x, z) + airfield_turf(x, z))

# Commit one pose per world tick, after integrating any batched render-frame interval. These
# sparse flights have no core Trip: the capital/meeting lives in AirEvents, not a core index.
# Club aircraft run on the same main thread as traffic. Share its exact bounded
# contact memo: six active club aircraft otherwise reconstruct mainland source
# corners on every physics substep, amplifying minute-boundary update spikes.
update_air_events = (events: mut AirEvents, w: mut data.World, models: CraftModel[], observer: vec3, player_aboard: bool = true, other_air: AirContact[] = [], ground: (f64, f64) -> f64 = flight_surface_height):
    prepare_air_events(events, w, models, ground)
    loop mut meet in events.meets:
        safe = conditions.weather_severity(w, meet.gates[0].center) < 650
        advance_air_meet(meet, w.tick, safe)
        refund_cancelled_air_meet(meet, w)
        loop entry in meet.entries:
            if entry.human:
                c = w.aircraft[entry.craft]
                sample_air_entry(meet, entry.craft, c.pose.pos, w.tick, c.hull > 0 and (entry.started_tick < 0 or player_aboard))
    contacts = other_air + [loop p in events.pilots: AirContact(p.craft, p.state.position, p.state.velocity, p.capital, p.state.on_water, p.state.moored)]
    pc = w.people[w.player].craft
    if pc >= 0: contacts.push(AirContact(pc, w.aircraft[pc].pose.pos, w.aircraft[pc].pose.vel, parked = w.aircraft[pc].state == .moored))
    launches=0
    loop k in 0..events.pilots.len():
        p = events.pilots[k]; c = w.aircraft[p.craft]; h = w.far.harbors[p.capital]
        if c.owner != p.person or w.people[p.person].craft != p.craft:
            p.active = false; w.far.people[p.person].vehicle = -1; events.pilots[k] = p
            loop mut meet in events.meets:
                loop mut entry in meet.entries:
                    if entry.craft == p.craft and entry.finished_tick < 0: entry.disqualified = true
            continue
        spec = club_spec(p, w, models)
        # (a pilot that flew held ticks ahead of the World waits for it)
        if p.last_tick >= w.tick: continue
        meeting = -1; racing_class = club_class(w, p.craft)
        loop i in 0..events.meets.len():
            m = events.meets[i]
            if m.capital == p.capital and m.race_class == racing_class and m.phase != .finished and m.phase != .cancelled and w.tick >= m.race_tick - 120 * data.TICKS_PER_MINUTE: meeting = i
        clock = data.local_minute(w.minute); day = data.day_index(w.minute)
        # (the Schneider racers fly only for their meets: no morning practice circuits)
        # (and none on a race day: the club flies its races)
        race_day = false
        loop m in events.meets: if m.capital == p.capital and m.day == day: race_day = true
        practice = meeting < 0 and not race_day and racing_class == .club and clock >= 600 and clock < 660 and p.practice_day != day
        launch_meet = meeting >= 0 and p.meet != events.meets[meeting].id
        if not p.active and (launch_meet or practice) and not p.state.crashed and c.engine > 700:
            # Morning practice and meet preparation can make every club ready
            # on the same minute boundary. Bound cold planning/refill work;
            # keep it off the economic minute frame. Failed preparations back off
            # so they cannot starve later pilots.
            if launches>=1 or w.tick<p.launch_retry_tick or w.tick/data.TICKS_PER_MINUTE!=p.last_tick/data.TICKS_PER_MINUTE:
                p.last_tick=w.tick;events.pilots[k]=p;continue
            launches+=1;p.launch_retry_tick=w.tick+60
            funder = w.far.districts[p.capital].household_account
            # A finite refill from the market; fuel starvation cancels the sortie.
            registry.fill_far_tank(w, p.craft, p.capital, 45000 - c.fuel_ml, funder)
            c = w.aircraft[p.craft]
            p.state.fuel = f64(c.fuel_ml) / 1000.0
            if c.fuel_ml < 40000: p.last_tick = w.tick; events.pilots[k] = p; continue
            dock = registry.reserve_far_berth(w, p.craft, p.capital)
            if dock < 0: p.last_tick = w.tick; events.pilots[k] = p; continue
            runway = air_runway(w.place_contexts[p.capital].center, h.out, conditions.wind_at(w, p.state.position), ground, 220)
            if not runway.valid: p.last_tick = w.tick; events.pilots[k] = p; continue
            p.plan = FlightPlan(target = runway.touchdown, taxi_target = h.docks[dock], altitude = 220,
                takeoff_heading = runway.heading, landing_heading = runway.heading, speed = spec.stall_speed * (if racing_class == .schneider: 1.8 else: 1.5))
            p.departure = runway.start; p.departing = true; p.active = true; p.waypoint = 0
            p.state.fuel = f64(c.fuel_ml) / 1000.0; unmoor(p.state)
            p.meet = if meeting >= 0: events.meets[meeting].id else: -1
            if practice: p.practice_day = day; p.practice_until = w.tick + 60 * 240
            w.aircraft[p.craft].move_owner = .scene; w.aircraft[p.craft].revision += 1
            w.far.people[p.person].vehicle = p.craft
        elapsed = clamp(w.tick - p.last_tick, 0, 15); p.last_tick = w.tick
        if not p.active: events.pilots[k] = p; continue
        e = FlightEnv(ground = ground, wind = conditions.wind_at(w, p.state.position))
        loop n in 0..elapsed: _club_tick(events, p, w, spec, h.out, contacts, e, w.tick - elapsed + n + 1)
        phase = if p.state.crashed: data.CraftState.wrecked else: if p.state.moored: data.CraftState.moored else: if p.state.on_water: data.CraftState.taxi else: data.CraftState.airborne
        revision = scene.scene_motion(w, p.craft, w.aircraft[p.craft].revision, data.Pose(pos = p.state.position, vel = p.state.velocity, rot = p.state.orientation, throttle = int(p.state.throttle * 1000)),
            max(0, int(round(p.state.fuel * 1000))), max(0, int((1.0 - p.state.hull_damage) * 1000)), max(0, int((1.0 - p.state.engine_damage) * 1000)), phase, false, false)
        if revision >= 0: w.aircraft[p.craft].state = phase
        w.people[p.person].pose.pos = p.state.position
        if p.state.moored or p.state.crashed:
            p.active = false; w.aircraft[p.craft].move_owner = .abstract_world
            if p.state.moored:
                w.far.people[p.person].vehicle = -1
                berth = w.far.air_berths[p.craft]
                w.people[p.person].pose.pos = h.quays[berth.dock]
            # A wreck keeps its occupant bound until the living rescue owner takes over.
        events.pilots[k] = p
    # (the aerodromes' fighters, on the same ground the player's wheels meet: the turf on it)
    update_air_arm(events, w, models, (x: f64, z: f64) -> f64: ground(x, z) + airfield_turf(x, z))

air_event_traffic = (events: AirEvents, w: data.World, models: CraftModel[]) -> Traffic[]:
    result: Traffic[]
    loop p in events.arm:
        f = AIRFIELDS[clamp(p.field, 0, AIRFIELDS.len() - 1)]
        town = if f.place in w.place_contexts: w.place_contexts[f.place].name else: "the town"
        why = if p.phase == .parked: "Standing at {f.name}" else: (if p.mission == 0: "Air arm circuits at {f.name}" else: "Air arm display over {town}")
        result.push(Traffic(craft = p.craft, person = p.person, name = w.people[p.person].name, why = why,
            reason = data.Reason(purpose = .patrol, actor = p.person), kind = .fiat_cr20, model = p.model, spec = arm_spec(p, models), state = p.state, plan = FlightPlan(), town = -1, dock = -1,
            flying = p.phase != .parked, materialized = true, prop_angle = p.prop))
    loop p in events.pilots:
        kind = Craft(int(w.aircraft[p.craft].kind))
        result.push(Traffic(craft = p.craft, person = p.person, name = w.people[p.person].name, why = if p.meet >= 0: "Flying at the capital air meeting" else: "Flying a local club circuit",
            reason = data.Reason(purpose = .visit, actor = p.person), kind = kind, model = p.model, spec = club_spec(p, w, models), state = p.state, plan = p.plan, town = -1, dock = -1,
            flying = p.active, materialized = p.active, prop_angle = p.prop))
    result

# Save this alongside the world at the save boundary, not on the render/physics path.
# Restoring the AirEvents value preserves race progress and sampled gate segments.
snapshot_air_events = (events: AirEvents, w: mut data.World) -> str:
    loop p in events.pilots:
        w.aircraft[p.craft].scene_extension = to_text(p)
        w.aircraft[p.craft].scene_extension_tick = w.tick
    loop p in events.arm:
        w.aircraft[p.craft].scene_extension = to_text(p)
        w.aircraft[p.craft].scene_extension_tick = w.tick
    to_text(events)
