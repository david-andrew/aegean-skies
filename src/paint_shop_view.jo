# The paint shop's own panel: the painter's card (their name, the price and the time for what is
# changed) over the paint's four tabs (src/aircraft_paint_view.jo). At the side of a screen wider
# than tall, along the bottom of one held upright, so the aircraft at the berth stays in sight
# beside it; what does not fit scrolls. The game opens it when the painter is asked, orders or
# leaves by what it returns, and turns the view about the aircraft with drags beside it.

use 'phoenix.jo'
use 'touch.jo'
use 'hud.jo'
use 'panels.jo'
use 'planes.jo'
use 'markings.jo'
use 'aircraft_paint.jo'
use 'aircraft_paint_view.jo'

struct PaintPanel:
    rect: Rect = Rect(0, 0, 0, 0)   # where it was last drawn, in the screen's own units (beside it is the scene)
    height = 0.0                    # (the tabs' height when last drawn: what scrolls)
    upright = false                 # (along the bottom of a screen taller than wide)
    order_at: vec2 = vec2(0, 0)     # (the middle of "Have her painted", and where the tabs begin and how wide: the screen's units)
    tabs_at: vec2 = vec2(0, 0)
    tabs_w = 0.0

struct PaintPanelResult:
    order = false
    leave = false

const PSV_ROW = 30.0

# Whether a point of the screen is on the panel (a click or a drag there is the panel's).
paint_panel_over = (st: PaintPanel, at: vec2) -> bool:
    f64(at.x) >= f64(st.rect.x) and f64(at.x) <= f64(st.rect.x) + f64(st.rect.w) and f64(at.y) >= f64(st.rect.y) and f64(at.y) <= f64(st.rect.y) + f64(st.rect.h)

# The part of the screen the panel leaves to the aircraft: (how far its middle is from the
# screen's, as a fraction of the screen's width and of its height).
paint_panel_shift = (st: PaintPanel) -> vec2:
    sw = max(f64(screen_width()), 1.0); sh = max(f64(screen_height()), 1.0)
    # (no panel on the screen: the whole of it is hers)
    if f64(st.rect.w) <= 0.0 or f64(st.rect.h) <= 0.0: return vec2(0, 0)
    if st.upright: return vec2(0, f32(-(sh - f64(st.rect.y)) * 0.5 / sh))
    vec2(f32(-(sw - f64(st.rect.x)) * 0.5 / sw), 0)

paint_shop_panel = (fonts: Fonts, st: mut PaintPanel, pg: mut PaintPage, p: mut Paint, s: PaintSupport, kind: int, shop: PaintShopView, where: str) -> PaintPanelResult:
    global hud_style
    res = PaintPanelResult()
    saved = hud_style
    hud_style.text_size = 16.0
    hud_style.panel = rgba(0.06, 0.08, 0.12, 0.9)
    hud_style.button = rgba(0.14, 0.17, 0.22, 1)
    hud_style.hover = rgba(0.22, 0.27, 0.34, 1)
    kz = readable_k(16.0)
    push_transform()
    scale(kz, kz)
    sw = f64(screen_width()) / kz
    sh = f64(screen_height()) / kz
    st.upright = sh > sw
    pw = if st.upright: sw - 24.0 else: min(400.0 * (if pad.on: 1.15 else: 1.0), sw * 0.5)
    x = if st.upright: 12.0 else: sw - pw - 16.0
    w = pw - 24.0
    cx = x + 12.0
    # the painter's card: who, and the price and the time for what is changed
    quote = if shop.items.len() == 0: "Nothing changed yet" else: "{phoenix_text(shop.cents)}, dry in {paint_minutes_words(shop.minutes)}"
    detail = if shop.refusal != "" and shop.items.len() > 0: shop.refusal else: if shop.items.len() > 0: "For " + join(shop.items, ", ") + "." else: "Choose her paint; the price follows what is changed."
    set_font(fonts.ui)
    lines = wrap_text(detail, w - 20.0, 13)
    if lines.len() > 2:
        lines = [lines[0], fit_text(lines[1] + " " + lines[2], w - 20.0, 13)]
    card_h = 84.0 + f64(lines.len()) * 17.0
    # (upright, along the bottom: as tall as the card and the chosen tab need, leaving the aircraft
    # at least a quarter of the screen above it)
    need = 8.0 + card_h + 8.0 + PSV_ROW + 10.0 + st.height + 12.0
    top = if st.upright: clamp(sh - 12.0 - need, sh * 0.26, sh * 0.42) else: max(16.0, pad_top_clear(x * kz, (x + pw) * kz) / kz)
    ph = sh - top - (if st.upright: 12.0 else: 16.0)
    st.rect = Rect(x * kz, top * kz, pw * kz, ph * kz)
    hud_nav(true, "paint-shop")
    hud_panel(Rect(x, top, pw, ph))
    rect_rounded(x + 8.0, top + 8.0, pw - 16.0, card_h, 6, PAPER)
    rect_rounded_outline(x + 12.0, top + 12.0, pw - 24.0, card_h - 8.0, 4, 1.2, PAPER_DARK)
    set_font(fonts.title)
    ptext(fit_text(shop.who, w - 20.0, 22), vec2(f32(cx + 10.0), f32(top + 20.0)), 22, INK)
    set_font(fonts.ui)
    ptext(fit_text("paints aircraft at {where}", w - 20.0, 13), vec2(f32(cx + 10.0), f32(top + 46.0)), 13, LIGHT_INK)
    ptext(fit_text(quote, w - 20.0, 17), vec2(f32(cx + 10.0), f32(top + 66.0)), 17, INK, sign = INK)
    ly = top + 90.0
    loop l in lines:
        ptext(l, vec2(f32(cx + 10.0), f32(ly)), 13, if shop.refusal != "" and shop.items.len() > 0: STAMP else: LIGHT_INK)
        ly += 17.0
    cy = top + 8.0 + card_h + 8.0
    half = (w - 6.0) * 0.5
    if hud_button(Rect(cx, cy, half, PSV_ROW), if ptext_width("Have her painted", hud_style.text_size) + 16.0 > half: "Paint her" else: "Have her painted", enabled = shop.refusal == ""): res.order = true
    if hud_button(Rect(cx + half + 6.0, cy, half, PSV_ROW), "Leave it"): res.leave = true
    st.order_at = vec2(f32((cx + half * 0.5) * kz), f32((cy + PSV_ROW * 0.5) * kz))
    cy += PSV_ROW + 10.0
    st.tabs_at = vec2(f32(cx * kz), f32(cy * kz)); st.tabs_w = w * kz
    # the paint's tabs, scrolled where they are taller than the room
    avail = top + ph - 10.0 - cy
    off = 0.0
    scrolling = st.height > avail + 1.0
    if scrolling:
        box = Rect(x, cy, pw, avail)
        off = hud_scroll(box, st.height, "paint-shop")
        clip(box)
    st.height = paint_tabs(pg, p, s, kind, cx, cy - off, w)
    if scrolling: no_clip()
    pop_transform()
    hud_style = saved
    if mkey(.escape): res.leave = true
    res
