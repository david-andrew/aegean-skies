# The receiver side of cloud shadows (cloud_shadow.jo draws the map): the
# shared sun projection, the map's placement, and the sample every ground,
# water and building shader takes. No dependencies, so any shader can use it.
const CLOUD_SHADOW_MIN_SUN = 0.12

# The projection shared by the map and every receiver.
cloud_shadow_k = (sun_dir: vec3) -> vec2:
    s = normalize(sun_dir)
    s.xz/max(s.y,f32(CLOUD_SHADOW_MIN_SUN))

# The map's center (absolute, projected) and size; receivers' areas are
# relative to their own chart origin.
cloud_shadow_x: f64 = 0.0
cloud_shadow_z: f64 = 0.0
cloud_shadow_half: f64 = 20000.0
cloud_shadow_strength: f32 = 0.0
cloud_shadow_base: f32 = 950.0     # the condensation level near the camera
cloud_shadow_target = RenderTarget()

cloud_shadow_map = () -> Texture: cloud_shadow_target.texture

# (map center x, z relative to `origin`, 1/(map size), cloud base (whole
# metres) + strength (fraction)). The map holds coverage only; things well
# above the cloud bases (aircraft over the field, high peaks) are not shaded.
cloud_shadow_area = (origin: vec3) -> vec4:
    if cloud_shadow_strength <= 0.0: return vec4(0,0,0,0)
    vec4(f32(cloud_shadow_x-f64(origin.x)),f32(cloud_shadow_z-f64(origin.z)),f32(0.5/cloud_shadow_half),floor(clamp(cloud_shadow_base,0.0,9000.0))+min(cloud_shadow_strength,1.0)*0.999)

# How much of the sun a point (chart-local, true height) has lost to clouds.
cloud_shadow_at = (map: Texture, area: vec4, world: vec3, sun_dir: vec3) -> f32:
    if area.w <= 0.0: return 0.0
    base = floor(area.w); strength = (area.w-base)/0.999
    strength *= 1.0-smoothstep(base+400.0,base+1800.0,world.y)
    if strength <= 0.0: return 0.0
    m = world.xz-cloud_shadow_k(sun_dir)*max(world.y,0.0)-area.xy
    uv = m*area.z+vec2(0.5,0.5)
    edge = max(abs(uv.x-0.5),abs(uv.y-0.5))
    if edge >= 0.5: return 0.0
    sample(map,uv).x*strength*(1.0-smoothstep(0.38,0.5,edge))

