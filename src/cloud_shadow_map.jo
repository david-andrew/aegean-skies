use 'look.jo'
# The receiver side of cloud shadows (cloud_shadow.jo draws the map): the
# shared sun projection, the map's placement, and the sample every ground,
# water and building shader takes. No dependencies, so any shader can use it.
const CLOUD_SHADOW_MIN_SUN = 0.12

# The projection shared by the map and every receiver.
cloud_shadow_k = (sun_dir: vec3) -> vec2:
    s = normalize(sun_dir)
    s.xz/max(s.y,f32(CLOUD_SHADOW_MIN_SUN))

# The map's center (absolute, projected) and size; receivers' areas are
# relative to their own chart origin.
cloud_shadow_x: f64 = 0.0
cloud_shadow_z: f64 = 0.0
cloud_shadow_half: f64 = 20000.0
cloud_shadow_strength: f32 = 0.0
cloud_shadow_base: f32 = 950.0     # the condensation level near the camera
cloud_shadow_target = RenderTarget()

cloud_shadow_map = () -> Texture: cloud_shadow_target.texture

# The map's size by quality tier: (half size in metres, pixels): 73 m texels on
# low, 56 on medium, 31 on high. (Each redraw draws every cloud with four taps a
# texel; at 1024 px on medium that burst cost redfox about 0.4 ms a frame.)
cloud_shadow_half_for = (tier: int) -> f64: if tier == 0: 14000.0 else: if tier == 1: 18000.0 else: 24000.0
cloud_shadow_res_for = (tier: int) -> int: if tier == 0: 384 else: if tier == 1: 640 else: 1536

# Its centre: ahead of the view, snapped to whole texels so edges never crawl.
cloud_shadow_center = (eye_x: f64, eye_z: f64, ahead: vec2, tier: int) -> vec2:
    half = cloud_shadow_half_for(tier)
    texel = half*2.0/f64(cloud_shadow_res_for(tier))
    vec2(f32(floor((eye_x+f64(ahead.x)*half*0.4)/texel)*texel),f32(floor((eye_z+f64(ahead.y)*half*0.4)/texel)*texel))

# A receiver's placement of the map, precomputed so a pixel pays two
# multiply-adds, one fetch and a linear edge fade:
# area = (uv offset relative to `origin`, uv per metre, strength);
# slope = (the sun projection in uv per metre of height, the height where shadows
# end (well above the cloud bases: aircraft over the field, high peaks), its
# fade per metre). The map holds coverage only, no heights.
# AEGEAN_CLOUD_SHADOW_SKIP=ground,grass,obj,sea leaves those receivers unshaded
# (developer cost measurements).
cloud_shadow_skip = env("AEGEAN_CLOUD_SHADOW_SKIP") ?? ""
cloud_shadow_area = (origin: vec3, receiver: str = "") -> vec4:
    if cloud_shadow_strength <= 0.0: return vec4(0,0,0,0)
    if receiver != "" and index_of(cloud_shadow_skip,receiver) != none: return vec4(0,0,0,0)
    scale = 0.5/cloud_shadow_half
    vec4(f32(0.5-(cloud_shadow_x-f64(origin.x))*scale),f32(0.5-(cloud_shadow_z-f64(origin.z))*scale),f32(scale),min(cloud_shadow_strength,1.0))
cloud_shadow_sun_k = vec2(0,0)
cloud_shadow_slope = () -> vec4:
    scale = f32(0.5/cloud_shadow_half)
    vec4(cloud_shadow_sun_k.x*scale,cloud_shadow_sun_k.y*scale,cloud_shadow_base+1800.0,1.0/1400.0)

# Per vertex: the map coordinate and the strength there. The coordinate is
# linear in position, so interpolated it is exact at every pixel; the pixel
# then pays one fetch (cloud_shadow_fetch). The map fades to nothing at its
# edges itself (cloud_shadow.jo).
cloud_shadow_uv = (area: vec4, slope: vec4, world: vec3) -> vec3:
    if area.w <= 0.0: return vec3(0,0,0)
    vec3(world.xz*area.z+area.xy-slope.xy*max(world.y,0.0),clamp((slope.z-world.y)*slope.w,0.0,area.w))
# Per vertex, fetched there: the pixel only multiplies by one interpolated value.
# (On Intel GPUs a fetch in the large ground and building pixel shaders cost them
# their SIMD16 compile; the map's 35-73 m texels are coarser than near vertices.)
cloud_shadow_vertex = (map: Texture, area: vec4, slope: vec4, world: vec3) -> f32:
    cloud_shadow_fetch(map,cloud_shadow_uv(area,slope,world))
cloud_shadow_fetch = (map: Texture, s: vec3) -> f32:
    if s.z <= 0.0: return 0.0
    sample(map,s.xy).y*s.z

# At a point (chart-local, true height): x the outline's coverage ramp, to be
# sharpened by cloud_shadow_edge; y how much of the sun a full shadow takes.
cloud_shadow_at = (map: Texture, area: vec4, slope: vec4, world: vec3) -> vec2:
    if area.w <= 0.0: return vec2(0,0)
    uv = world.xz*area.z+area.xy-slope.xy*max(world.y,0.0)
    edge = max(abs(uv.x-0.5),abs(uv.y-0.5))
    m = sample(map,uv)
    strength = clamp(m.y/max(m.x,0.05),0.0,1.0)*clamp((slope.z-world.y)*slope.w,0.0,area.w)*clamp((0.5-edge)*8.0,0.0,1.0)
    vec2(m.x,strength)

# The crisp edge from the coverage ramp: a quick transition with a hint of
# softness, never narrower than the ramp's change across a pixel (`change`,
# its screen derivative), which would stair-step.
cloud_shadow_edge = (cover: f32, change: f32) -> f32:
    e = max(0.035,change*0.75)
    smoothstep(0.5-e,0.5+e,cover)

# A broken overcast (weather kind 12): rows of soft rolls 1.5 km apart, long
# along the wind, each wandering, thickening and thinning along its length and
# tearing open where it thins; rounded undersides, billowed all over. A
# conservative distance in metres in the deck's frame (x along the rows, y up
# from the deck's base). The deck draws it as a painted body; the shadow pass
# and the sea's glints read its cover, so the sun's patches lie under its tears.
const BROKEN_ROW: f32 = 1500.0
broken_rolls_distance = (m: vec3) -> f32:
    d: f32 = 100000.0
    k0 = floor(m.z/BROKEN_ROW-0.5)
    loop j in 0..2:
        k = k0+f32(j)
        zc = (k+0.5)*BROKEN_ROW+(vnoise(vec2(k*7.3,m.x/6000.0))-0.5)*500.0
        t = vnoise(vec2(m.x/1400.0,k*3.1))*0.6+vnoise(vec2(m.x/520.0,k*5.7+2.0))*0.4
        # (thick rolls overlapping their neighbours, torn only where they thin most)
        w = smoothstep(0.16,0.46,t)
        rz = BROKEN_ROW*0.64*w+1.0
        ry = 300.0*w+1.0
        q = vec2((m.z-zc)/rz,(m.y-(170.0+90.0*w))/ry)
        d = min(d,(length(q)-1.0)*min(rz,ry))
    # (billows at two sizes all over, so the bellies' paint breaks into lumps)
    d-(vnoise(m.xz/260.0+vec2(m.y/200.0,0.0))-0.5)*150.0-(vnoise(m.xz/110.0+vec2(3.1,m.y/90.0))-0.5)*70.0
broken_rolls_cover = (m: vec2) -> f32: smoothstep(60.0,-60.0,broken_rolls_distance(vec3(m.x,200.0,m.y)))
broken_rolls_gradient = (m: vec3) -> vec3:
    h: f32 = 30.0
    vec3(broken_rolls_distance(m+vec3(h,0,0))-broken_rolls_distance(m-vec3(h,0,0)),broken_rolls_distance(m+vec3(0,h,0))-broken_rolls_distance(m-vec3(0,h,0)),broken_rolls_distance(m+vec3(0,0,h))-broken_rolls_distance(m-vec3(0,0,h)))

# The frame's broken overcast (draw_cloud_volumes sets them): its centre x, z
# (chart-local), its middle height, the shadow's strength; its heading's cos,
# sin and the sun's k.
cloud_shadow_deck = vec4(0,0,0,0)
cloud_shadow_deck_frame = vec4(1,0,0,0)
# How much of the sun a point loses under it (0 where none).
broken_deck_shadow = (deck: vec4, frame: vec4, p: vec3, cam: vec3) -> vec2:
    if deck.w <= 0.0 or p.y >= deck.z: return vec2(0,0)
    at = p.xz+frame.zw*(deck.z-p.y)
    # (near the camera the deck is drawn as cloud bodies, which cast their own shadows
    # through the map; the band layer's shadow begins where the layer is drawn)
    near = smoothstep(11000.0,14000.0,length(at-cam.xz))
    if near <= 0.0: return vec2(0,0)
    q = at-deck.xy
    c = broken_rolls_cover(vec2(q.x*frame.x+q.y*frame.y,-q.x*frame.y+q.y*frame.x))
    vec2(c*near,deck.w)
