# Startup rendering budgets only. Canonical terrain, simulation and controls do
# not depend on these. AEGEAN_QUALITY=low/medium/high also works in native runs.
struct RenderQuality:
    tier: int = 2
    cloud_fields: int = 70
    cloud_sides: int = 12
    cloud_rings: int = 7
    tree_stride: int = 1
    tree_distance: f64 = 9000.0
    grove_distance: f64 = 700.0
    grass_radius: f64 = 42.0
    terrain_error: f64 = 1.0
    terrain_detail: f64 = 1.5

render_quality = RenderQuality()

quality_profile = (tier: int) -> RenderQuality:
    if tier == 0: return RenderQuality(0,28,6,4,3,2500.0,450.0,24.0,2.0,1.0)
    if tier == 1: return RenderQuality(1,45,8,5,2,5000.0,550.0,32.0,1.5,1.2)
    RenderQuality()

when TARGET == "wasm":
    extern __aegean_quality = () -> i32
    extern __aegean_scene_scale = () -> f64

# Called at startup and after drawing: the next frame binds its low-resolution
# canvas before update(). Changing it mid-frame would resize an active target.
quality_next_frame = ():
    when TARGET == "wasm": render_scale(__aegean_scene_scale())

init_quality = ():
    global render_quality
    tier = 2
    when TARGET == "wasm": tier = int(__aegean_quality())
    mode = env("AEGEAN_QUALITY") ?? "auto"
    if mode == "low": tier = 0
    else if mode == "medium": tier = 1
    else if mode == "high": tier = 2
    render_quality = quality_profile(tier)
    quality_next_frame()
    print("render quality {tier}: tree stride {render_quality.tree_stride}")

quality_trees = (trees: Instance3D[]) -> Instance3D[]:
    if render_quality.tree_stride == 1: return trees
    # Thin after generation, keeping both the global RNG and spatial coverage.
    [loop k in 0..trees.len(): if k % render_quality.tree_stride == 0: trees[k]]
