# The world audit's airfield checks (world_audit_run.jo): a strip level and dry enough to roll on,
# approaches clear off both ends, no town or road across the field, and everything placed on it
# (hangar doors, the office door, the fuel point, the stands, the windsock masts) standing on
# ground a person can reach.
use 'airfields.jo'
use 'world_audit.jo'
use 'flight_ground.jo'
use 'water_field.jo'
use 'settlements.jo'
use 'objects.jo'

const AIRFIELD_AUDIT_ROUGH = 1.0     # metres off the strip's best-fit plane
const AIRFIELD_AUDIT_GRADE = 0.02    # along the strip
const AIRFIELD_AUDIT_GLIDE = 20.0    # approach slope, 1 in this, for 1500 m off each end

audit_airfield = (towns: Town[], result: mut AuditFinding[], k: int):
    f = AIRFIELDS[k]
    ground = (p: vec2) -> f64: flight_surface_height(f64(p.x), f64(p.y)) + airfield_turf(f64(p.x), f64(p.y))
    # the strip: three lanes sampled every 10 m, fitted by a plane along and across
    ts: f64[]; ls: f64[]; hs: f64[]
    wet = 0
    loop lane in [-f.half_width * 0.7, 0.0, f.half_width * 0.7]:
        u = -f.half_length
        loop u <= f.half_length:
            p = airfield_world(f, u, lane)
            if water_at(f64(p.x), f64(p.y)).wet: wet += 1
            ts.push(u); ls.push(lane); hs.push(ground(p))
            u += 10.0
    n = f64(ts.len()); st = 0.0; sl = 0.0; sh = 0.0; stt = 0.0; sll = 0.0; sth = 0.0; slh = 0.0
    loop i in 0..ts.len():
        st += ts[i]; sl += ls[i]; sh += hs[i]; stt += ts[i] * ts[i]; sll += ls[i] * ls[i]; sth += ts[i] * hs[i]; slh += ls[i] * hs[i]
    b = (sth - st * sh / n) / max(stt - st * st / n, 1.0); d = (slh - sl * sh / n) / max(sll - sl * sl / n, 1.0); a = (sh - b * st - d * sl) / n
    rough = 0.0; worst = 0
    loop i in 0..ts.len():
        r = abs(hs[i] - (a + b * ts[i] + d * ls[i]))
        if r > rough: rough = r; worst = i
    centre = airfield_point(f, 0.0, 0.0)
    if wet > 0: result.push(AuditFinding(true, 400.0, "airfield strip in water", k, f.name, centre, "{wet} strip samples are in a river or lake", audit_key("airfield-wet", k, 0)))
    if rough > AIRFIELD_AUDIT_ROUGH or abs(b) > AIRFIELD_AUDIT_GRADE:
        result.push(AuditFinding(true, 300.0 + rough * 50.0, "airfield strip uneven", k, f.name, airfield_point(f, ts[worst], ls[worst]),
            "{rough:.2f} m off level at worst, grade {b * 100.0:.2f}% along, {d * 100.0:.2f}% across", audit_key("airfield-level", k, 0)))
    # approaches: below the glide line off both ends
    loop e in [-1.0, 1.0]:
        loop step in 1..31:
            out = f64(step) * 50.0
            p = airfield_world(f, e * (f.half_length + out), 0.0)
            limit = a + e * b * f.half_length + out / AIRFIELD_AUDIT_GLIDE
            if ground(p) > limit:
                result.push(AuditFinding(true, 250.0 + ground(p) - limit, "airfield approach blocked", k, f.name, vec3(p.x, f32(ground(p)), p.y),
                    "ground {ground(p) - limit:.1f} m above the 1:{AIRFIELD_AUDIT_GLIDE:.0f} approach {out:.0f} m off the end behind {if e < 0: "its start" else: "its far end"}", audit_key("airfield-approach", k, if e < 0: 0 else: 1)))
                break
    # nothing of a town or its roads across the field
    crossed = 0; at = centre
    u = -f.half_length - AIRFIELD_CLEAR_U
    loop u <= f.half_length + AIRFIELD_CLEAR_U:
        v = -AIRFIELD_CLEAR_LEFT
        loop v <= AIRFIELD_CLEAR_RIGHT:
            p = airfield_world(f, u, v)
            if settlement_urban(p) or settlement_on_road(p):
                crossed += 1; at = vec3(p.x, f32(ground(p)), p.y)
            v += 20.0
        u += 20.0
    if crossed > 0: result.push(AuditFinding(true, 200.0 + f64(crossed), "airfield crossed by a town or road", k, f.name, at, "{crossed} field samples on houses or a road", audit_key("airfield-clear", k, 0)))
    # the buildings' doors, the fuel point, the stands, the windsock masts
    layout = airfield_layout(f)
    loop i in 0..layout.buildings.len():
        bd = layout.buildings[i]
        fl = airfield_floor(f, bd)
        door = airfield_world(f, bd.u, bd.v + bd.depth * 0.5 - 1.0)
        audit_prop(towns, result, "airfield building door", k, f.name, i, vec3(door.x, f32(fl), door.y), 0.5)
        low = 1e9
        loop du in [-0.5, 0.5]:
            loop dv in [-0.5, 0.5]: low = min(low, ground(airfield_world(f, bd.u + du * bd.width, bd.v + dv * bd.depth)))
        if fl - low > 2.5: result.push(AuditFinding(false, 15.0 + fl - low, "airfield building on a slope", k, f.name, vec3(door.x, f32(fl), door.y), "floor {fl - low:.1f} m above the lowest ground under it", audit_key("airfield-plinth", k, i)))
    audit_prop(towns, result, "airfield fuel point", k, f.name, 0, airfield_point(f, f64(layout.fuel.x), f64(layout.fuel.y)), 0.8)
    loop i in 0..layout.stands.len(): audit_prop(towns, result, "airfield stand", k, f.name, i, airfield_stand(f, i), 3.0)
    loop i in 0..airfield_socks(f).len(): audit_prop(towns, result, "airfield windsock", k, f.name, i, airfield_point(f, f64(airfield_socks(f)[i].x), f64(airfield_socks(f)[i].y)), 0.4)
