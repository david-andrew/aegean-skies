# A small contour/material field for the nearest lake. Never paints an analytic
# oval: signed bank distance comes from the same sampled original relief.
use 'lake_data.jo'
use 'lake_field.jo'
struct LakeMaterial:
    id:int= -1
    map:Texture
lake_material_cache:LakeMaterial[]=[LakeMaterial(),LakeMaterial(),LakeMaterial(),LakeMaterial()]
lake_material_cursor=0
lake_material_texture=(id:int)->Texture:
    global lake_material_cache,lake_material_cursor
    loop item in lake_material_cache:
        if item.id==id:return item.map
    lake=SETTLEMENT_LAKES[id];img=image(lake.nx,lake.nz)
    loop j in 0..lake.nz:
        loop i in 0..lake.nx:
            x=f64(lake.origin.x)+f64(i)*lake.step;z=f64(lake.origin.y)+f64(j)*lake.step
            depth=lake_depth(lake,x,z)
            dx=(lake_depth(lake,x+lake.step,z)-lake_depth(lake,x-lake.step,z))/(lake.step*2.0)
            dz=(lake_depth(lake,x,z+lake.step)-lake_depth(lake,x,z-lake.step))/(lake.step*2.0)
            slope=sqrt(dx*dx+dz*dz)
            distance=clamp(depth/max(slope,0.002),-64.0,64.0)
            patch=0.5+noise(x*0.012,z*0.012)*0.5
            if i<2 or j<2 or i>=lake.nx-2 or j>=lake.nz-2:patch=0.0
            img.set(i,j,vec4(f32(distance/128.0+0.5),f32(patch),f32(clamp(slope*5.0,0.0,1.0)),1))
    slot=lake_material_cursor%lake_material_cache.len();lake_material_cursor+=1
    map=lake_material_cache[slot].map
    if map.id!=0:free_texture(map)
    map=texture(img,true)
    lake_material_cache[slot]=LakeMaterial(id,map)
    map
