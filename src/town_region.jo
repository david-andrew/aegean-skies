# Building tradition is presentation metadata, never a new place/person ID.
# Kalyra: taller limewashed masonry, clay roofs, green/ochre joinery.
# Orenthia: lower chalk-white courtyard houses, roof terraces, blue joinery.
# Country zero retains the original island palette and proportions.
town_roof_flat = (seed: int,country: int) -> bool:
    if country==1: seed%8==0 else: if country==2: seed%8!=0 else: seed%4==0

town_floor_height = (country: int) -> f64:
    if country==1: 4.5 else: if country==2: 3.3 else: 4.0

town_region_color = (seed: int,country: int) -> vec4:
    palette=if country==1: [vec4(1,0.90,0.72,1),vec4(0.96,0.84,0.68,1),vec4(1,0.86,0.78,1),vec4(0.94,0.91,0.80,1)] else: [vec4(1,1,1,1),vec4(0.98,0.99,0.96,1),vec4(1,0.98,0.94,1),vec4(0.95,0.98,0.99,1)]
    palette[(seed/17)%palette.len()]

town_joinery = (seed: int,country: int) -> int:
    if country==1: (if seed%4==0: 2 else: 1) else: if country==2: (if seed%5==0: 1 else: 0) else: (seed/19)%3

# The harbour buildings dominate an arrival view: their silhouettes carry the
# same tradition as the homes, rather than identical red-roofed sheds everywhere.
town_service_flat = (seed: int,country: int,warehouse: bool) -> bool:
    if country==2: true else: if warehouse: false else: town_roof_flat(seed,country)
