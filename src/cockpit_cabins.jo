# Each aircraft's cockpit arrangement, from the type's real layout: an open cockpit for one, open
# cockpits in tandem, an open cockpit for two side by side, or an enclosed cabin (a flight deck)
# with glazed windscreen and side windows. Cabins are modelled from the inside (every face wound
# toward the pilot, so the roof, sides and rear read at any head angle) and given a matching
# outside shell. Craft coordinates throughout: forward -z, right +x, up +y, metres.
#
# The head-look reads each type's comfortable limits here (cockpit_look); rain on the glass can
# use cockpit_glass (each pane's four corners, in the same frame as the interior).
use 'planes.jo'
use 'cockpit_cutout.jo'

enum CockpitKind: open_single, open_tandem, side_by_side, cabin

# How far the pilot's head turns from straight ahead, radians: either way, up and down. Open
# cockpits look back over the shoulder; a cabin's rear bulkhead and roof stop the eye sooner.
struct CockpitLook:
    yaw = 2.6
    up = 1.15
    down = 0.9

struct CockpitLayout:
    kind: CockpitKind = .open_single
    look: CockpitLook = CockpitLook()
    seats: f64[] = []           # seat x's, pilot first (side by side, or the cabin's seats)
    eye = vec3(0, 0, 0)         # cabins: the pilot's eye (zero: the open cockpit's default)
    cx = 0.0                    # the cabin's (or shared opening's) centre line
    hw = 0.6                    # inside half width at the sills
    floor = 0.0
    sill = 0.0                  # the windscreen's foot and the side windows' sills
    roof = 0.0                  # the ceiling at the centre line
    front = 0.0                 # the windscreen's foot, z
    rake = 0.38                 # its head lies this far aft of its foot
    rear = 0.0                  # the rear bulkhead, z
    aft = 0.0                   # the outside shell runs aft to here (a deckhouse behind the bridge)
    base = 0.0                  # the outside shell's foot, sunk in the hull's deck
    panes = 4                   # windscreen panes across
    windows = 2                 # side windows each side, beside the pilots
    panel_x = 0.0               # the flying instruments' centre line
    wheel = false               # a control wheel on a column (else a stick)
    levers = 1                  # throttle levers on the quadrant
    gauges = 0                  # engine gauges on the centre panel
    copilot_dials = false       # a second airspeed and altimeter before the right-hand seat
    metal = false               # painted metal panelling (else varnished wood)
    open_hw = 0.51              # side by side, open: the shared opening's half width (centre cx)
    engineer = false            # a flight engineer's board on the rear bulkhead, his seat before it

# A cabin from the pilot's eye: the windscreen's foot 1.27 m ahead and 0.24 m below the eye (the
# panel under it, its gauges as far off as the open cockpit's), the ceiling 0.4 m over the eye,
# the floor a seated eye height (1.15 m) below.
_cabin = (eye: vec3, seats: f64[], hw: f64, rear: f64, base: f64, look: CockpitLook, panes: int = 4, windows: int = 2, cx: f64 = 0.0, panel_x: f64 = 1e9, wheel: bool = true, levers: int = 1, gauges: int = 0, copilot: bool = false, metal: bool = false, aft: f64 = 0.0, rake: f64 = 0.45, engineer: bool = false) -> CockpitLayout:
    y = f64(eye.y); z = f64(eye.z)
    CockpitLayout(.cabin, look, seats, eye, cx, hw, y - 1.15, y - 0.24, y + 0.40, z - 1.27, rake, rear, if aft == 0.0: rear else: aft, base,
        panes, windows, if panel_x > 1e8: f64(eye.x) else: panel_x, wheel, levers, gauges, copilot, metal, engineer = engineer)

CABIN_LOOK = CockpitLook(2.25, 0.95, 0.85)

cockpit_layout = (kind: Craft) -> CockpitLayout:
    p = aircraft_profile(kind)
    match kind:
        # The Heron: a small passenger boat; her pilot and mechanic side by side in a glazed cabin
        # ahead of the wing, a varnished panel shared between them.
        .heron: _cabin(vec3(-0.3, 1.5, -3.25), [-0.3, 0.3], 0.62, -2.55, 0.45, CABIN_LOOK, panes = 3, windows = 2, panel_x = 0.0)
        # The Pelican, a twin-engined liner, and the Albatross, a cargo amphibian: two pilots side by
        # side in a raised glazed cockpit forward on the hull, two throttles between them.
        .pelican: _cabin(vec3(-0.45, 2.0, -4.6), [-0.45, 0.45], 0.95, -3.55, 0.9, CABIN_LOOK, levers = 2, gauges = 2, copilot = true)
        .albatross: _cabin(vec3(-0.45, 2.05, -4.1), [-0.45, 0.45], 0.97, -3.05, 0.95, CABIN_LOOK, levers = 2, gauges = 2, copilot = true, metal = true)
        # The Short Sarafand (1932): an enclosed cockpit high in the bow, two pilots side by side,
        # three pairs of Buzzards controlled from a quadrant between them.
        .short_sarafand: _cabin(vec3(-0.5, 3.15, -9.35), [-0.5, 0.5], 1.05, -8.1, 1.35, CABIN_LOOK, panes = 4, windows = 2, levers = 6, gauges = 6, copilot = true, metal = true, aft = -7.4)
        # The Dornier Do X (1929): the bridge on the top deck forward, two pilots at wheels before a
        # broad panel; the engineer ran the twelve engines from his own station in the wing, so the
        # pilots' quadrant carries six master levers, one for each push-pull pair.
        .dornier_dox: _cabin(vec3(-0.6, 4.0, -13.6), [-0.6, 0.6], 1.2, -12.6, 2.45, CABIN_LOOK, panes = 6, windows = 2, levers = 6, gauges = 6, copilot = true, metal = true, aft = -10.0)
        # The Hughes H-4 (1947): a flight deck at the front of the upper deck's hump, two pilots and
        # eight throttles; the engineer's panels behind them.
        .hughes_h4: _cabin(vec3(-1.0, 6.6, -24.6), [-1.0, 1.0], 1.75, -22.2, 6.0, CockpitLook(2.4, 0.9, 0.8), panes = 6, windows = 3, levers = 8, gauges = 8, copilot = true, metal = true, aft = -21.4, engineer = true)
        # Open cockpits for two side by side: the S.55's in the wing's leading edge, the Wal's ahead
        # of the wing (both flown with wheels), the Donnet-Lévêque's in its little hull.
        .sm_s55: CockpitLayout(.side_by_side, seats = [-0.62, 0.62], cx = 0.0, panel_x = -0.62, wheel = true, levers = 2, open_hw = 1.25)
        .dornier_wal: CockpitLayout(.side_by_side, seats = [-0.35, 0.35], cx = 0.0, panel_x = 0.0, wheel = true, levers = 2, open_hw = 0.75)
        .donnet_leveque: CockpitLayout(.side_by_side, seats = [-0.27, 0.27], cx = 0.0, panel_x = 0.0, open_hw = 0.6)
        _: CockpitLayout(if p.cockpit_count > 1: .open_tandem else: .open_single)

is_cabin = (kind: Craft) -> bool: cockpit_layout(kind).kind == .cabin
cockpit_look = (kind: Craft) -> CockpitLook: cockpit_layout(kind).look

# The default eye over the seat (the open cockpits'); a cabin's eye is its layout's.
COCKPIT_EYE = vec3(0, 0.16, 0.40)
cockpit_eye_offset = (kind: Craft, seat: vec3) -> vec3:
    l = cockpit_layout(kind)
    if l.kind == .cabin: l.eye - seat else: COCKPIT_EYE

# The cockpit's drawing frame (the "virtual seat"): the eye less the default eye offset, so the
# open cockpits' seat frame is unchanged and a cabin's instruments sit where the open panel's do.
cockpit_origin = (l: CockpitLayout) -> vec3: l.eye - COCKPIT_EYE

# Where the flying instruments sit in a cabin, against the open cockpit's panel (drawing frame).
cockpit_cluster_shift = (kind: Craft) -> vec3:
    l = cockpit_layout(kind)
    if l.kind == .side_by_side: return vec3(f32(l.panel_x - l.seats[0]), 0, 0)
    if l.kind != .cabin: return vec3(0, 0, 0)
    vec3(f32(l.panel_x - f64(l.eye.x)), 0, f32(l.front + 1.27 - f64(l.eye.z)))

# The outside hull cut away for the cockpit view: a cabin's whole volume (its outside shell, the
# deck through it and any glazing boxes), so the interior alone is seen from the seats.
cockpit_cut_box = (kind: Craft, seat: vec3) -> (vec3, vec3):
    l = cockpit_layout(kind)
    if l.kind == .cabin:
        return (vec3(f32(l.cx - l.hw - 0.2), f32(l.floor - 0.05), f32(l.front - 0.65)), vec3(f32(l.cx + l.hw + 0.2), f32(l.roof + 0.35), f32(l.rear + 0.12)))
    if l.kind == .side_by_side:
        return (vec3(f32(l.cx - l.open_hw - 0.02), seat.y - 1.0, seat.z - 0.86), vec3(f32(l.cx + l.open_hw + 0.02), seat.y + 0.45, seat.z + 0.95))
    (seat - vec3(0.53, 1.0, 0.86), seat + vec3(0.53, 0.45, 0.95))

# ---------------- shared shapes ----------------

# The windscreen's plan: a shallow bow forward at the centre (z at x, foot or head).
_screen_z = (l: CockpitLayout, x: f64, head: bool) -> f64:
    w = if head: l.hw * 0.9 else: l.hw
    u = clamp((x - l.cx) / w, -1.0, 1.0)
    (if head: l.front + l.rake else: l.front) + 0.08 * u * u

# The sides' window band for window k: its front edge at the sill and at the eave, its back edge.
# The first window's front follows the windscreen's raked corner post.
_window_span = (l: CockpitLayout, k: int) -> (f64, f64, f64):
    z0 = l.front + l.rake + 0.2
    z1 = l.rear - 0.22
    step = (z1 - z0) / f64(l.windows)
    back = z0 + step * f64(k + 1) - 0.04
    if k == 0: return (l.front + 0.17, l.front + l.rake + 0.15, back)
    (z0 + step * f64(k) + 0.04, z0 + step * f64(k) + 0.04, back)

# Windscreen pane corners (foot left, foot right, head right, head left), craft coordinates.
_pane = (l: CockpitLayout, k: int) -> vec3[]:
    a = l.cx - l.hw + 2.0 * l.hw * f64(k) / f64(l.panes)
    b = l.cx - l.hw + 2.0 * l.hw * f64(k + 1) / f64(l.panes)
    eave = l.roof - 0.12
    ha = l.cx + (a - l.cx) * 0.9; hb = l.cx + (b - l.cx) * 0.9
    [vec3(f32(a), f32(l.sill), f32(_screen_z(l, a, false))), vec3(f32(b), f32(l.sill), f32(_screen_z(l, b, false))),
        vec3(f32(hb), f32(eave), f32(_screen_z(l, hb, true))), vec3(f32(ha), f32(eave), f32(_screen_z(l, ha, true)))]

# The glazing a pilot looks through, for rain on the glass: each pane's corners in the cockpit's
# drawing frame (relative*translation(cockpit_eye_local(model) - COCKPIT_EYE)). Windscreen first,
# then the side windows, left then right. Empty for open cockpits (their screens are the frame's).
cockpit_glass = (kind: Craft) -> vec3[][]:
    l = cockpit_layout(kind)
    out: vec3[][]
    if l.kind != .cabin: return out
    o = cockpit_origin(l)
    loop k in 0..l.panes: out.push([loop c in _pane(l, k): c - o])
    eave = l.roof - 0.12
    loop side in [-1.0, 1.0]:
        loop k in 0..l.windows:
            s = _window_span(l, k)
            x0 = l.cx + side * l.hw; x1 = l.cx + side * l.hw * 0.9
            out.push([vec3(f32(x0), f32(l.sill), f32(s.0)) - o, vec3(f32(x0), f32(l.sill), f32(s.2)) - o,
                vec3(f32(x1), f32(eave), f32(s.2)) - o, vec3(f32(x1), f32(eave), f32(s.1)) - o])
    out

# A flat face of two triangles, its normal turned toward `toward` (inside faces toward the cabin,
# outside faces away from it).
_face = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, col: vec4, toward: vec3, away: bool = false):
    n = normalize(cross(b - a, c - a) + vec3(0.0000001, 0, 0))
    mid = (a + b + c + d) * 0.25
    facing = dot(n, toward - mid) >= 0
    if facing == away: n = -n
    loop q in [a, b, c, a, c, d]: vs.push(Vertex3D(q, n, vec2(0, 0), col))

cabin_face = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, col: vec4, toward: vec3): _face(vs, a, b, c, d, col, toward)

_tri_face = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4, toward: vec3, away: bool = false):
    n = normalize(cross(b - a, c - a) + vec3(0.0000001, 0, 0))
    mid = (a + b + c) / 3.0
    if (dot(n, toward - mid) >= 0) == away: n = -n
    loop q in [a, b, c]: vs.push(Vertex3D(q, n, vec2(0, 0), col))

_bar = (vs: mut Vertex3D[], a: vec3, b: vec3, r: f64, col: vec4):
    d = b - a
    if length(d) < 0.001: return
    add_box(vs, vec3(0, 0, 0), vec3(f32(r * 2.0), f32(r * 2.0), length(d)), col, translation((a + b) * 0.5) * facing(d))

_v = (x: f64, y: f64, z: f64) -> vec3: vec3(f32(x), f32(y), f32(z))

# A darker shade of a paint. (Only the colour: an alpha below 0.9 marks what glows after dark.)
paint_dim = (c: vec4, k: f64) -> vec4: vec4(c.xyz * f32(k), c.w)

# ---------------- the cabin seen from inside ----------------

struct CabinPaint:
    wall: vec4                  # the lower walls' panelling
    upper: vec4                 # the window band's posts and the bulkhead
    ceiling: vec4
    rib: vec4
    frame: vec4                 # window frames
    floor: vec4
    panel: vec4
    leather: vec4

cabin_paint = (l: CockpitLayout) -> CabinPaint:
    if l.metal:
        CabinPaint(rgb(0.30, 0.35, 0.31), rgb(0.40, 0.44, 0.39), rgb(0.66, 0.65, 0.58), rgb(0.32, 0.34, 0.31),
            rgb(0.17, 0.19, 0.17), rgb(0.20, 0.19, 0.17), rgb(0.13, 0.14, 0.13), rgb(0.27, 0.13, 0.06))
    else:
        CabinPaint(rgb(0.42, 0.22, 0.09), rgb(0.50, 0.29, 0.13), rgb(0.80, 0.75, 0.62), rgb(0.40, 0.23, 0.11),
            rgb(0.26, 0.14, 0.06), rgb(0.24, 0.15, 0.08), rgb(0.45, 0.23, 0.09), rgb(0.29, 0.13, 0.05))

# A seat: cushion, a low back (below the shoulders: the view back over it), a frame.
_cabin_seat = (vs: mut Vertex3D[], l: CockpitLayout, x: f64, c: CabinPaint):
    z = f64(l.eye.z)
    add_box(vs, _v(x, l.floor + 0.42, z + 0.12), _v(0.46, 0.09, 0.46), c.leather)
    add_box(vs, _v(x, l.floor + 0.70, z + 0.36), _v(0.44, 0.52, 0.08), c.leather)
    _bar(vs, _v(x - 0.2, l.floor, z + 0.12), _v(x - 0.2, l.floor + 0.38, z + 0.12), 0.02, rgb(0.2, 0.2, 0.19))
    _bar(vs, _v(x + 0.2, l.floor, z + 0.12), _v(x + 0.2, l.floor + 0.38, z + 0.12), 0.02, rgb(0.2, 0.2, 0.19))
    # (stitched seams across the back)
    loop k in 0..3: add_box(vs, _v(x, l.floor + 0.54 + f64(k) * 0.14, z + 0.315), _v(0.42, 0.008, 0.01), paint_dim(c.leather, 0.75))

# The whole interior, in craft coordinates.
cabin_interior_craft = (l: CockpitLayout) -> Vertex3D[]:
    vs: Vertex3D[]
    c = cabin_paint(l)
    eave = l.roof - 0.12
    inside = _v(l.cx, (l.floor + l.roof) * 0.5, (l.front + l.rear) * 0.5)
    brass = rgb(0.64, 0.49, 0.26)
    fw = l.front - 0.5          # the footwell's end, under the panel
    pb = f64(l.eye.y) - 0.88    # the panel's bottom edge
    pz = l.front + 0.12         # the panel's face
    # Floor boards (or tread plate) from the footwell back to the bulkhead.
    _face(vs, _v(l.cx - l.hw * 0.9, l.floor, fw), _v(l.cx + l.hw * 0.9, l.floor, fw), _v(l.cx + l.hw * 0.9, l.floor, l.rear), _v(l.cx - l.hw * 0.9, l.floor, l.rear), c.floor, inside)
    loop k in 1..int(l.hw * 2.0 / 0.14):
        x = l.cx - l.hw * 0.9 + f64(k) * 0.14
        if x > l.cx + l.hw * 0.88: break
        add_box(vs, _v(x, l.floor + 0.002, (fw + l.rear) * 0.5), _v(0.006, 0.004, l.rear - fw), paint_dim(c.floor, 0.7))
    loop side in [-1.0, 1.0]:
        x0 = l.cx + side * l.hw * 0.9; x1 = l.cx + side * l.hw; x2 = l.cx + side * l.hw * 0.9
        # the lower wall: floor chine, then upright to the sill
        _face(vs, _v(x0, l.floor, fw), _v(x1, l.floor + 0.25, fw), _v(x1, l.floor + 0.25, l.rear), _v(x0, l.floor, l.rear), c.wall, inside)
        _face(vs, _v(x1, l.floor + 0.25, fw), _v(x1, l.sill, l.front), _v(x1, l.sill, l.rear), _v(x1, l.floor + 0.25, l.rear), c.wall, inside)
        # panelling battens and a capping rail at the sill
        loop k in 0..int((l.rear - l.front) / 0.42):
            z = l.front + 0.3 + f64(k) * 0.42
            if z > l.rear - 0.1: break
            _bar(vs, _v(x1 - side * 0.012, l.floor + 0.3, z), _v(x1 - side * 0.012, l.sill - 0.04, z), 0.012, paint_dim(c.wall, 0.78))
        _bar(vs, _v(x1 - side * 0.03, l.sill - 0.015, l.front), _v(x1 - side * 0.03, l.sill - 0.015, l.rear), 0.03, c.frame)
        # the window band: posts between the windows, the windows' frames
        prev = _screen_z(l, x1, false)
        prev_head = _screen_z(l, x2, true)
        loop k in 0..l.windows + 1:
            s = if k < l.windows: _window_span(l, k) else: (l.rear, l.rear, l.rear)
            _face(vs, _v(x1, l.sill, prev), _v(x1, l.sill, s.0), _v(x2, eave, s.1), _v(x2, eave, prev_head), c.upper, inside)
            if k < l.windows:
                _bar(vs, _v(x1 - side * 0.02, l.sill, s.0), _v(x2 - side * 0.02, eave, s.1), 0.018, c.frame)
                _bar(vs, _v(x1 - side * 0.02, l.sill, s.2), _v(x2 - side * 0.02, eave, s.2), 0.018, c.frame)
                _bar(vs, _v(x1 - side * 0.02, l.sill + 0.01, s.0), _v(x1 - side * 0.02, l.sill + 0.01, s.2), 0.018, c.frame)
                _bar(vs, _v(x2 - side * 0.02, eave - 0.012, s.1), _v(x2 - side * 0.02, eave - 0.012, s.2), 0.018, c.frame)
                prev = s.2; prev_head = s.2
        # the roof's side, from the eave up to the crown, ahead to the windscreen's head
        zh = _screen_z(l, x2, true)
        _face(vs, _v(x2, eave, zh), _v(l.cx, l.roof, l.front + l.rake), _v(l.cx, l.roof, l.rear), _v(x2, eave, l.rear), c.ceiling, inside)
    # Ceiling ribs and a lamp over the pilots' heads (its glass glows after dark).
    loop k in 0..int((l.rear - l.front - l.rake) / 0.38) + 1:
        z = l.front + l.rake + 0.12 + f64(k) * 0.38
        if z > l.rear - 0.05: break
        loop side in [-1.0, 1.0]:
            x2 = l.cx + side * l.hw * 0.9
            _bar(vs, _v(x2 - side * 0.01, eave - 0.01, z), _v(l.cx, l.roof - 0.015, z), 0.016, c.rib)
    lamp = _v(l.cx, l.roof - 0.02, f64(l.eye.z) - 0.25)
    add_cylinder(vs, vec3(0, 0, 0), 0.07, 0.04, brass, 10, transform = translation(lamp - vec3(0, 0.04, 0)))
    add_sphere(vs, lamp - vec3(0, 0.045, 0), 0.05, rgba(0.95, 0.88, 0.7, 0.6), 8, 4)
    # The windscreen: posts, the sill rail and the header, with a bowed shelf over the panel.
    loop k in 0..l.panes + 1:
        a = l.cx - l.hw + 2.0 * l.hw * f64(k) / f64(l.panes)
        h = l.cx + (a - l.cx) * 0.9
        r = if k == 0 or k == l.panes: 0.03 else: 0.022
        _bar(vs, _v(a, l.sill, _screen_z(l, a, false) + 0.01), _v(h, eave, _screen_z(l, h, true) + 0.01), r, c.frame)
    loop k in 0..l.panes:
        q = _pane(l, k)
        _bar(vs, q[0] + vec3(0, 0.012, 0.012), q[1] + vec3(0, 0.012, 0.012), 0.02, c.frame)
        _bar(vs, q[3] + vec3(0, -0.012, 0.012), q[2] + vec3(0, -0.012, 0.012), 0.024, c.frame)
        # the cap over the header, up to the crown
        _tri_face(vs, q[3], q[2], _v(l.cx, l.roof, l.front + l.rake), c.ceiling, inside)
    # (the coaming shelf: from the glass's foot back over the panel's top edge)
    steps = 8
    loop k in 0..steps:
        a = l.cx - l.hw + 2.0 * l.hw * f64(k) / f64(steps); b = l.cx - l.hw + 2.0 * l.hw * f64(k + 1) / f64(steps)
        _face(vs, _v(a, l.sill, _screen_z(l, a, false)), _v(b, l.sill, _screen_z(l, b, false)), _v(b, l.sill, pz + 0.04), _v(a, l.sill, pz + 0.04), paint_dim(c.panel, 0.8), l.eye)
    _bar(vs, _v(l.cx - l.hw, l.sill - 0.01, pz + 0.04), _v(l.cx + l.hw, l.sill - 0.01, pz + 0.04), 0.018, c.frame)
    # The panel, full width, and the footwell under it to a bulkhead.
    _face(vs, _v(l.cx - l.hw, pb, pz), _v(l.cx + l.hw, pb, pz), _v(l.cx + l.hw, l.sill, pz), _v(l.cx - l.hw, l.sill, pz), c.panel, inside)
    loop side in [-1.0, 1.0]:
        _face(vs, _v(l.cx + side * l.hw, pb, pz), _v(l.cx + side * l.hw, l.sill, pz), _v(l.cx + side * l.hw, l.sill, l.front), _v(l.cx + side * l.hw, pb, l.front), c.panel, inside)
    _face(vs, _v(l.cx - l.hw, pb, pz), _v(l.cx + l.hw, pb, pz), _v(l.cx + l.hw, pb, fw), _v(l.cx - l.hw, pb, fw), paint_dim(c.panel, 0.6), _v(l.cx, l.floor, fw + 0.2))
    _face(vs, _v(l.cx - l.hw, l.floor, fw), _v(l.cx + l.hw, l.floor, fw), _v(l.cx + l.hw, pb, fw), _v(l.cx - l.hw, pb, fw), paint_dim(c.wall, 0.55), inside)
    # (the panel's grain or rivets, and its edge beading)
    if l.metal:
        loop x in [l.cx - l.hw + 0.05, l.cx + l.hw - 0.05]:
            loop k in 0..int((l.sill - pb) / 0.1):
                add_box(vs, _v(x, pb + 0.05 + f64(k) * 0.1, pz + 0.004), _v(0.012, 0.012, 0.006), rgb(0.3, 0.3, 0.28))
    else:
        loop k in 0..int((l.sill - pb) / 0.035):
            y = pb + 0.02 + f64(k) * 0.035
            add_box(vs, _v(l.cx, y, pz + 0.002), _v(l.hw * 1.96, 0.003, 0.002), paint_dim(c.panel, 0.78))
    _bar(vs, _v(l.cx - l.hw, pb, pz + 0.01), _v(l.cx + l.hw, pb, pz + 0.01), 0.015, c.frame)
    # Rudder pedals before each seat.
    loop x in l.seats:
        loop side in [-1.0, 1.0]:
            add_box(vs, _v(x + side * 0.13, l.floor + 0.16, l.front - 0.25), _v(0.09, 0.2, 0.03), rgb(0.22, 0.22, 0.21), rotation_x(0.0))
        _bar(vs, _v(x - 0.16, l.floor + 0.08, l.front - 0.22), _v(x + 0.16, l.floor + 0.08, l.front - 0.22), 0.015, brass)
    # The throttle quadrant's pedestal between the seats (its levers move: drawn with the dials).
    qx = if l.seats.len() > 1: (l.seats[0] + l.seats[1]) * 0.5 else: l.cx + 0.3
    qw = 0.05 * f64(l.levers) + 0.08
    qy = f64(l.eye.y) - 0.71; qz = f64(l.eye.z) - 0.40
    add_box(vs, _v(qx, (l.floor + qy) * 0.5, qz), _v(qw, qy - l.floor, 0.4), rgb(0.15, 0.16, 0.15))
    add_box(vs, _v(qx, qy + 0.01, qz), _v(qw + 0.02, 0.02, 0.42), paint_dim(brass, 0.8))
    loop k in 0..l.levers:
        x = qx - qw * 0.5 + 0.06 + f64(k) * 0.05
        add_box(vs, _v(x, qy + 0.025, qz), _v(0.014, 0.006, 0.3), rgb(0.06, 0.06, 0.06))
    # Seats: the pilot's and the right-hand one.
    loop x in l.seats: _cabin_seat(vs, l, x, c)
    # The rear bulkhead and its door through to the hull behind.
    loop side in [-1.0, 1.0]:
        x0 = l.cx + side * l.hw * 0.9; x1 = l.cx + side * l.hw; x2 = l.cx + side * l.hw * 0.9
        _face(vs, _v(l.cx, l.floor, l.rear), _v(x0, l.floor, l.rear), _v(x1, l.floor + 0.25, l.rear), _v(l.cx, l.floor + 0.25, l.rear), c.upper, inside)
        _face(vs, _v(l.cx, l.floor + 0.25, l.rear), _v(x1, l.floor + 0.25, l.rear), _v(x1, l.sill, l.rear), _v(l.cx, l.sill, l.rear), c.upper, inside)
        _face(vs, _v(l.cx, l.sill, l.rear), _v(x1, l.sill, l.rear), _v(x2, eave, l.rear), _v(l.cx, eave, l.rear), c.upper, inside)
        _tri_face(vs, _v(l.cx, eave, l.rear), _v(x2, eave, l.rear), _v(l.cx, l.roof, l.rear), c.upper, inside)
    dx = if l.seats.len() > 1: (l.seats[0] + l.seats[1]) * 0.5 else: l.cx
    add_box(vs, _v(dx, l.floor + 0.85, l.rear - 0.012), _v(0.56, 1.6, 0.02), c.wall)
    add_box(vs, _v(dx, l.floor + 0.85, l.rear - 0.02), _v(0.48, 1.52, 0.02), paint_dim(c.wall, 0.82))
    add_sphere(vs, _v(dx + 0.19, l.floor + 0.95, l.rear - 0.045), 0.025, brass, 6, 3)
    # (a chart board and a fire extinguisher on the bulkhead, to read as a working deck)
    add_box(vs, _v(l.cx - l.hw * 0.7, l.sill - 0.15, l.rear - 0.03), _v(0.36, 0.26, 0.02), rgb(0.82, 0.78, 0.64))
    if l.engineer:
        # The flight engineer's board across the right of the bulkhead: rows of engine gauges (a
        # set for each engine), fuel and oil, his own throttles below, his seat facing it.
        x0 = dx + 0.42; x1 = l.cx + l.hw * 0.86
        y0 = l.sill - 0.5; y1 = eave - 0.06
        add_box(vs, _v((x0 + x1) * 0.5, (y0 + y1) * 0.5, l.rear - 0.03), _v(x1 - x0, y1 - y0, 0.03), c.panel)
        cols = int((x1 - x0 - 0.06) / 0.13)
        rows = int((y1 - y0 - 0.06) / 0.13)
        loop i in 0..cols:
            loop j in 0..rows:
                at = _v(x0 + 0.1 + f64(i) * 0.13, y1 - 0.1 - f64(j) * 0.13, l.rear - 0.05)
                add_cylinder(vs, vec3(0, 0, 0), 0.052, 0.012, brass, 12, transform = translation(at) * rotation_x(-PI * 0.5))
                add_cylinder(vs, vec3(0, 0, 0), 0.045, 0.014, rgb(0.035, 0.045, 0.04), 12, transform = translation(at) * rotation_x(-PI * 0.5))
                a = 0.6 + sin(f64(i * 7 + j * 3)) * 0.9
                _bar(vs, at + _v(0, 0, -0.016), at + _v(cos(a) * 0.035, sin(a) * 0.035, -0.016), 0.003, rgba(0.94, 0.87, 0.66, 0.2))
        add_box(vs, _v((x0 + x1) * 0.5, l.floor + 0.62, l.rear - 0.22), _v(x1 - x0, 0.06, 0.4), c.panel)
        loop k in 0..8: _bar(vs, _v(x0 + 0.15 + f64(k) * (x1 - x0 - 0.3) / 7.0, l.floor + 0.65, l.rear - 0.25), _v(x0 + 0.15 + f64(k) * (x1 - x0 - 0.3) / 7.0, l.floor + 0.8, l.rear - 0.35), 0.008, rgb(0.55, 0.08, 0.05))
        sx = (x0 + x1) * 0.5
        add_box(vs, _v(sx, l.floor + 0.42, l.rear - 0.85), _v(0.46, 0.09, 0.46), c.leather)
        add_box(vs, _v(sx, l.floor + 0.7, l.rear - 1.1), _v(0.44, 0.5, 0.08), c.leather)
        _bar(vs, _v(sx, l.floor, l.rear - 0.85), _v(sx, l.floor + 0.38, l.rear - 0.85), 0.03, rgb(0.2, 0.2, 0.19))
    add_cylinder(vs, vec3(0, 0, 0), 0.05, 0.36, rgb(0.62, 0.12, 0.08), 8, transform = translation(_v(l.cx + l.hw * 0.72, l.floor + 0.3, l.rear - 0.08)))
    vs

# The interior in the cockpit's drawing frame.
cabin_interior = (l: CockpitLayout) -> Vertex3D[]:
    o = cockpit_origin(l)
    out = cabin_interior_craft(l)
    loop i in 0..out.len(): out[i].pos = out[i].pos - o
    out

# ---------------- the cabin seen from outside ----------------

# The deckhouse over the cabin: sides, roof, a raked windscreen of dark glass and framing, and
# window panes matching the inside ones (each 6 mm proud of the skin).
cabin_exterior = (vs: mut Vertex3D[], l: CockpitLayout, paint: vec4, trim: vec4):
    t = 0.05
    glass = rgb(0.2, 0.27, 0.32)
    eave = l.roof - 0.12 + t
    top = l.roof + t
    sill = l.sill
    zs = l.front - t; zh = l.front + l.rake - t
    nose = l.front - 0.6
    centre = _v(l.cx, (l.base + l.roof) * 0.5, (l.front + l.aft) * 0.5)
    W = l.hw + t; Wh = l.hw * 0.9 + t
    loop side in [-1.0, 1.0]:
        x = l.cx + side * W; xh = l.cx + side * Wh
        _face(vs, _v(x, l.base, nose), _v(x, sill, zs), _v(x, sill, l.aft), _v(x, l.base, l.aft), paint, centre, away = true)
        _face(vs, _v(x, sill, zs), _v(xh, eave, zh), _v(xh, eave, l.aft), _v(x, sill, l.aft), paint, centre, away = true)
        _face(vs, _v(xh, eave, zh), _v(l.cx, top, zh), _v(l.cx, top, l.aft), _v(xh, eave, l.aft), paint, centre, away = true)
        loop k in 0..l.windows:
            s = _window_span(l, k)
            u = 0.06
            _face(vs, _v(x + side * 0.006, sill + u, s.0), _v(x + side * 0.006, sill + u, s.2), _v(xh + side * 0.006, eave - u, s.2), _v(xh + side * 0.006, eave - u, s.1), glass, centre, away = true)
        # (a deckhouse aft of the bridge keeps a row of smaller windows)
        if l.aft > l.rear + 0.8:
            n = int((l.aft - l.rear) / 0.9)
            loop k in 0..n:
                z0 = l.rear + 0.2 + f64(k) * 0.9
                _face(vs, _v(x + side * 0.006, sill + 0.08, z0), _v(x + side * 0.006, sill + 0.08, z0 + 0.55), _v(xh + side * 0.006, eave - 0.08, z0 + 0.55), _v(xh + side * 0.006, eave - 0.08, z0), glass, centre, away = true)
    # the scuttle before the windscreen, the windscreen and the cap over its head
    _face(vs, _v(l.cx - W, l.base, nose), _v(l.cx + W, l.base, nose), _v(l.cx + W, sill, zs), _v(l.cx - W, sill, zs), paint, centre, away = true)
    _face(vs, _v(l.cx - W, sill, zs), _v(l.cx + W, sill, zs), _v(l.cx + Wh, eave, zh), _v(l.cx - Wh, eave, zh), glass, centre, away = true)
    _tri_face(vs, _v(l.cx - Wh, eave, zh), _v(l.cx + Wh, eave, zh), _v(l.cx, top, zh), paint, centre, away = true)
    loop k in 0..l.panes + 1:
        a = l.cx - W + 2.0 * W * f64(k) / f64(l.panes)
        h = l.cx + (a - l.cx) * Wh / W
        _bar(vs, _v(a, sill, zs - 0.012), _v(h, eave, zh - 0.012), 0.025, trim)
    _bar(vs, _v(l.cx - W, sill, zs - 0.012), _v(l.cx + W, sill, zs - 0.012), 0.025, trim)
    _bar(vs, _v(l.cx - Wh, eave, zh - 0.012), _v(l.cx + Wh, eave, zh - 0.012), 0.025, trim)
    # the after end
    loop side in [-1.0, 1.0]:
        x = l.cx + side * W; xh = l.cx + side * Wh
        _face(vs, _v(l.cx, l.base, l.aft), _v(x, l.base, l.aft), _v(x, sill, l.aft), _v(l.cx, sill, l.aft), paint, centre, away = true)
        _face(vs, _v(l.cx, sill, l.aft), _v(x, sill, l.aft), _v(xh, eave, l.aft), _v(l.cx, eave, l.aft), paint, centre, away = true)
        _tri_face(vs, _v(l.cx, eave, l.aft), _v(xh, eave, l.aft), _v(l.cx, top, l.aft), paint, centre, away = true)

# The model's first-person body (the hull cut away round the cockpit) and its pilot's eye.
fit_cockpit = (model: CraftModel, body: Vertex3D[], kind: Craft) -> CraftModel:
    m = model
    box = cockpit_cut_box(kind, m.cockpit)
    m.cockpit_body = custom_mesh(cockpit_cutout(body, m.cockpit, box.0, box.1))
    m.eye = cockpit_eye_offset(kind, m.cockpit)
    m.panel = cockpit_cluster_shift(kind)
    m
