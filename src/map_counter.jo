# A map seller's counter: the sheets on sale there with their prices, and any sheet promised to the
# player for an errand. Draws from plain rows and says what was chosen; the game makes the actual
# purchase through the living world's ledger (living_maps.buy_map / claim_map_reward).

use 'hud.jo'
use 'panels.jo'
import 'living_types.jo' as data
import 'living_map_types.jo' as paper
import 'living_maps.jo' as paper_maps
use 'living_content.jo'

_over = (r: Rect) -> bool: contains(r, mouse_pos())
_click = (r: Rect) -> bool: mouse_pressed(.left) and contains(r, mouse_pos())

struct MapRow:
    copy = -1                       # the sheet on the counter (for sale)
    job = -1                        # the errand it was promised for (a reward), else -1
    title: str
    detail: str                     # "sea chart, 1:50,000" (the year too, when the title lacks it)
    price_cents = 0
    have = false                    # one already owns this edition
    ready = true                    # a reward: the errand is done, so it can be collected
    note = ""                       # a reward: what it was promised for

struct MapCounterResult:
    buy = -1                        # the copy to buy
    collect = -1                    # the job whose promised sheet to collect
    closed = false

# "4 lire", "9.50 lire"
lire_text = (cents: int) -> str:
    if cents % 100 == 0: "{cents / 100} lire" else: "{f64(cents) / 100.0:.2} lire"

_thousands = (n: int) -> str:
    s = "{n}"
    out = ""
    loop k in 0..s.len():
        if k > 0 and (s.len() - k) % 3 == 0: out = out + ","
        out = out + s[k..k + 1]
    out

map_kind_words = (k: paper.MapKind) -> str:
    match k:
        .nautical: "sea chart"
        .road: "road map"
        .tourist: "visitor's map"
        .military: "military sheet"

map_detail_text = (m: paper.PaperMap) -> str:
    year = if m.title.contains("{m.year}"): "" else: ", {m.year}"
    "{map_kind_words(m.kind)}{year}, 1:{_thousands(m.scale)}"

# What the counter shows the player: rewards promised to them here first, then the stock on sale
# (one line per edition, the cheapest copy).
map_counter_rows = (w: data.World, shop: str, person: int) -> MapRow[]:
    rows: MapRow[]
    owned: {str: bool}
    loop _, c in w.maps.copies:
        if c.holder == .person and c.person == person: owned[c.edition] = true
    jobs = w.maps.rewards.keys(); jobs.sort()
    loop job in jobs:
        copy = w.maps.rewards[job]
        if not (job in w.jobs) or not (copy in w.maps.copies): continue
        j = w.jobs[job]; c = w.maps.copies[copy]
        if c.shop != shop or j.carrier != person or (j.state != .claimed and j.state != .delivered): continue
        if not (c.edition in w.maps.editions): continue
        m = w.maps.editions[c.edition]
        rows.push(MapRow(copy, job, m.title, map_detail_text(m), have = owned.get(c.edition, false), ready = j.state == .delivered, note = "promised for the errand to {PLACE_NAMES[j.destination]}"))
    seen: {str: int}
    loop o in paper_maps.map_offers(w, shop, person):
        if not (o.edition in w.maps.editions): continue
        m = w.maps.editions[o.edition]
        if o.edition in seen:
            k = seen[o.edition]
            if o.price_cents < rows[k].price_cents: rows[k].copy = o.copy; rows[k].price_cents = o.price_cents
            continue
        seen[o.edition] = rows.len()
        rows.push(MapRow(o.copy, -1, m.title, map_detail_text(m), o.price_cents, owned.get(o.edition, false)))
    rows

map_counter = (fonts: Fonts, seller: str, kind: str, place: str, rows: MapRow[], cents: int) -> MapCounterResult:
    res = MapCounterResult()
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(760.0, sw - 32.0)
    row_h = 50.0
    shown = max(1, min(rows.len(), int((sh - 200.0) / row_h)))
    h = 128.0 + f64(shown) * row_h + 56.0
    x = (sw - w) * 0.5
    y = max(12.0, (sh - h) * 0.5)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.4))
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)
    set_font(fonts.title)
    text(fit_text(seller, w - 200, 26), vec2(f32(x + 30), f32(y + 22)), 26, INK)
    set_font(fonts.ui)
    text("{kind}, {place}", vec2(f32(x + 30), f32(y + 58)), 16, LIGHT_INK)
    close = Rect(x + w - 44, y + 14, 30, 30)
    text_centered("×", vec2(f32(close.x + 15), f32(close.y + 13)), 30, if _over(close): INK else: LIGHT_INK)
    if _click(close) or key_pressed(.escape): res.closed = true
    hy = y + 90.0
    line(vec2(f32(x + 24), f32(hy)), vec2(f32(x + w - 24), f32(hy)), 1.5, PAPER_DARK)
    bw = 92.0
    if rows.len() == 0: text("No maps on the counter.", vec2(f32(x + 30), f32(hy + 18)), 19, LIGHT_INK)
    loop k in 0..shown:
        if k >= rows.len(): break
        r = rows[k]
        ry = hy + 12.0 + f64(k) * row_h
        reward = r.job >= 0
        text(fit_text(r.title, w - bw - 170, 19), vec2(f32(x + 30), f32(ry)), 19, INK)
        sub = if reward: r.note else: r.detail
        if r.have: sub = sub + "; you have one"
        text(fit_text(sub, w - bw - 170, 15), vec2(f32(x + 30), f32(ry + 22)), 15, LIGHT_INK)
        price = if reward: "promised" else: lire_text(r.price_cents)
        text(price, vec2(f32(x + w - 40 - bw - text_width(price, 18)), f32(ry + 8)), 18, if reward: STAMP else: INK)
        b = Rect(x + w - 30 - bw, ry + 2, bw, 32)
        can = if reward: r.ready else: cents >= r.price_cents
        label = if reward: (if r.ready: "collect" else: "after the errand") else: "buy"
        if reward and not r.ready:
            text(label, vec2(f32(b.x + b.w - text_width(label, 14)), f32(b.y + 9)), 14, LIGHT_INK)
        else:
            rect_rounded(b.x, b.y, b.w, b.h, 5, if can: (if _over(b): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1)) else: rgba(0.7, 0.68, 0.6, 1))
            text_centered(label, vec2(f32(b.x + b.w * 0.5), f32(b.y + 16)), 16, rgba(1, 0.97, 0.9, 1))
            if can and _click(b):
                if reward: res.collect = r.job else: res.buy = r.copy
    if rows.len() > shown: text("and {rows.len() - shown} more", vec2(f32(x + 30), f32(hy + 12.0 + f64(shown) * row_h - 6.0)), 14, LIGHT_INK)
    fy = y + h - 44.0
    line(vec2(f32(x + 24), f32(fy - 10)), vec2(f32(x + w - 24), f32(fy - 10)), 1.5, PAPER_DARK)
    text(lire_text(cents), vec2(f32(x + 30), f32(fy)), 20, INK)
    set_font()
    res
