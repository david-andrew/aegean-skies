# The shapes of the lookable things that have no mesh of their own in the scene (glossary: Things
# to tap; src/look_outline.jo): each a part of a larger mesh (a table in the hotel's one mesh, a
# bed in a room's), or with no vertices of the mask's kind at all (a pool's water). Their vertices
# come from the code that builds them into the larger mesh, so the highlight is the thing's own
# shape; each small mesh is made when first looked at and kept.
#
# A new lookable kind: add it to LookKind and look_shape_of (src/look_outline.jo); a part or a proxy
# gets its vertices in look_vertices here and its count in look_parts; a drawn one is taken where
# the scene draws it. tests/look_shape_test.jo fails for a kind left without.
use 'look_outline.jo'
use 'bar_scene.jo'
use 'bar_room.jo'
use 'town_details.jo'
use 'thermal_sites.jo'
use 'thermal_render.jo'
use 'stay.jo'
use 'stay_scene.jo'
use 'room_walk.jo'

const ROOM_TRADES = 5               # (src/stay_scene.jo trade_of: 0..4)

# How many there are of a kind with vertices here (`part` below: 0 up to this), 0 for a drawn kind.
look_parts = (k: LookKind) -> int:
    if look_shape_of(k) == .drawn: return 0
    match k:
        .hotel_table: hotel_table_count()
        .bar_stool: BAR_STOOLS_X.len()
        .coffee_table: CAFE_TABLE_X.len()
        .hot_pool: THERMAL_SITES.len()
        # (the hotel's room, then a family's house for each trade; only the hotel's has the window)
        .room_bed, .room_chair, .room_door: 1 + ROOM_TRADES
        else: 1

# A thing's own vertices, in the frame of what it is part of: the hotel's (a table, the stool,
# the door, the barber's chair, the bandstand: in the bar room they stand shifted, and are placed
# so); the coffee house's (its table); a springs' site's, turned as the site is (the hot pool); a
# room's (the bed, the chair, the window, the door: `part` 0 the hotel's room, 1 + trade a
# family's house). Empty for a kind the scene draws itself.
look_vertices = (k: LookKind, part: int = 0) -> Vertex3D[]:
    match k:
        .hotel_table: hotel_table_vertices(part)
        .bar_stool: hotel_stool_vertices(part)
        .hotel_door: hotel_door_vertices()
        .barber_chair: barber_chair_vertices()
        .bandstand: bandstand_vertices()
        .coffee_table: cafe_table_vertices(part)
        .hot_pool: thermal_pool_shape(THERMAL_SITES[clamp(part, 0, THERMAL_SITES.len() - 1)])
        .room_bed: room_thing_vertices(part, .bed)
        .room_chair: room_thing_vertices(part, .chair)
        .room_window: room_thing_vertices(part, .window)
        .room_door: room_thing_vertices(part, .door)
        else: []

# ---------------- a room's things ----------------

room_look_kind = (thing: RoomThing) -> LookKind:
    match thing:
        .bed: .room_bed
        .chair: .room_chair
        .window: .room_window
        .door: .room_door

# One of a room's things by its vertices in the room (cut by the ranges the room's builder
# records: the game's own meshes of them, StayRooms' hotel_things and family_things, are cut the
# same way). `room` 0 the hotel's, 1 + trade a family's house.
room_thing_vertices = (room: int, thing: RoomThing) -> Vertex3D[]:
    ranges: int[]
    vs = if room <= 0: build_hotel_room(ranges) else: build_family_house(room - 1, ranges)
    objs = room_objects(if room <= 0: StayKind.hotel else: StayKind.family)
    loop k in 0..objs.len():
        if objs[k].thing == thing and k * 2 + 1 < ranges.len(): return [loop i in ranges[k * 2]..ranges[k * 2 + 1]: vs[i]]
    []

# ---------------- the meshes, kept ----------------
look_meshes_kept: {str: Mesh} = {}

# A part's or a proxy's small mesh (made when first asked for).
look_mesh = (k: LookKind, part: int = 0) -> Mesh:
    global look_meshes_kept
    key = "{k} {part}"
    if let m = look_meshes_kept.get(key): return m
    m = custom_mesh(look_vertices(k, part))
    look_meshes_kept[key] = m
    m
