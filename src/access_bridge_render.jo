use 'access_bridges.jo'
use 'objects.jo'
use 'world_source.jo'
use 'look.jo'
use 'render_space.jo'
use 'world_point.jo'
access_bridge_meshes:Mesh[]
build_access_bridge=(bridge:AccessBridge)->Vertex3D[]:
    vs:Vertex3D[];delta=bridge.b-bridge.a;length=f64(length(delta.xz));axis=normalize(delta.xz);side=vec2(-axis.y,axis.x)
    stone=rgb(0.68,0.65,0.55)
    # Three arches with real openings; piers continue to the canonical riverbed.
    count=96;span=length/3.0;step=length/f64(count)
    loop k in 0..count:
        u=(f64(k)+0.5)/f64(count);center=delta*f32(u);top=f64(center.y)
        station=u*length;arch=(station%span)/span
        underside=top-2.0-25.0*(1.0-sqrt(max(0.0,1.0-pow(arch*2.0-1.0,2.0))))
        p=bridge.a+center;ground=world_source_surface(f64(p.x),f64(p.z))-f64(bridge.a.y)
        bottom=max(ground-0.2,underside)
        m=translation(vec3(center.x,0,center.z))*rotation_y(atan2(f64(axis.x),f64(axis.y)))
        if bottom<top:add_box(vs,vec3(0,f32((top+bottom)*0.5),0),vec3(f32(bridge.width),f32(top-bottom),f32(step)),stone,m)
        loop sign in [-1.0,1.0]:
            add_box(vs,vec3(f32(sign*(bridge.width*0.5-0.2)),f32(top+0.5),0),vec3(0.4,1.0,f32(step)),stone,m)
    loop k in 0..4:
        u=f64(k)/3;center=delta*f32(u);p=bridge.a+center
        ground=world_source_surface(f64(p.x),f64(p.z))-f64(bridge.a.y)-0.5;top=f64(center.y)-1.0
        if ground<top:add_box(vs,vec3(0,f32((top+ground)*0.5),0),vec3(f32(bridge.width+0.5),f32(top-ground),4.0),stone,translation(vec3(center.x,0,center.z))*rotation_y(atan2(f64(axis.x),f64(axis.y))))
    vs
draw_access_bridges=(L:Light,t:f64):
    global access_bridge_meshes
    near=false
    loop b in ACCESS_BRIDGES:
        if length(scene_camera()-(b.a+b.b)*0.5)<3500:near=true
    if not near:return
    if access_bridge_meshes.len()==0:access_bridge_meshes=[loop b in ACCESS_BRIDGES:mesh(build_access_bridge(b))]
    loop k in 0..ACCESS_BRIDGES.len():
        b=ACCESS_BRIDGES[k]
        if length(scene_camera()-(b.a+b.b)*0.5)<3500:draw(obj_sh,access_bridge_meshes[k],obj_params(L,t,anchor=world_point(b.a)))
