# Loose cloth: the pilot's scarf (always on him), a streamer on each side's wing strut. In
# the wind of flight cloth streams straight back from where it is tied, taut near the knot; the
# flutter is a wave running down it toward the free end, growing as it goes, quicker and more
# violent the faster the air, the very end whipping about. Made fresh each frame from the airflow
# (no state to settle), as a two-sided ribbon.

use 'look.jo'
use 'objects.jo'
use 'render_space.jo'
use 'tweaks.jo'

struct Cloth:
    at: vec3                        # where it is tied, in the aircraft's frame
    length: f64
    width: f64
    color: vec4
    stripe: vec4                    # a second color, in bands along it
    seed: f64
    drape = vec3(0, 0, 0)           # (in its frame) the way it falls in still air and never blows
                                    # against, past its wearer (none: it falls straight down)

# A wearer's torso for worn cloth to stay out of, in the wearer's own frame (unscaled figure units:
# facing -z, the feet at 0, the shoulders' top at 1.48): the torso as a box from the hips to the
# shoulders, its back `back` behind the spine; and how low down the back the cloth may hang
# (`floor`) before what's left of it lifts away from him.
struct ClothWearer:
    frame: mat4                     # the wearer's frame (to where the knots are)
    back: f64
    floor = 1.04                    # (the jacket's hem is at 0.93)

const _WEAR_HALF = 0.28             # (half the shoulders' width)
const _WEAR_TOP = 1.48
const _WEAR_BOTTOM = 0.9
const _WEAR_GAP = 0.035             # (kept between the cloth's middle and him: its twist, its flutter)
const _WEAR_EDGE = 0.01             # (and between its edges and him)

# a point along the middle of the cloth (in the wearer's frame) hanging no lower than the floor:
# (still, it hangs down his back no lower than that; the rest of it bends out behind him, softly,
# as cloth stiff enough to hold its folds; or out to whichever side it hangs on)
_above_floor = (q: vec3, w: ClothWearer) -> vec3:
    if f64(q.y) >= w.floor: return q
    drop = w.floor - f64(q.y)
    soft = 0.08 * (1.0 - exp(-drop / 0.08))
    away = vec2(q.x, q.z)
    dir = if length(away) > 0.05: normalize(away) else: vec2(0, 1)
    vec3(q.x + dir.x * f32(drop - soft), f32(w.floor - soft), q.z + dir.y * f32(drop - soft))

# a point of the cloth (in the wearer's frame) never inside his torso: out through whichever face
# of it is nearest (`gap`: kept clear of it)
_outside_torso = (q: vec3, w: ClothWearer, gap: f64) -> vec3:
    out = q
    hw = _WEAR_HALF + gap
    depth = w.back + gap
    top = _WEAR_TOP + gap
    if abs(f64(out.x)) < hw and abs(f64(out.z)) < depth and f64(out.y) > _WEAR_BOTTOM - gap and f64(out.y) < top:
        to_back = depth - abs(f64(out.z))
        to_side = hw - abs(f64(out.x))
        to_top = top - f64(out.y)
        if to_back <= to_side and to_back <= to_top: out.z = f32(if out.z >= 0.0: depth else: -depth)
        else if to_side <= to_top: out.x = f32(if out.x >= 0.0: hw else: -hw)
        else: out.y = f32(top)
    out

# a point of the cloth (where the knots are) kept off its wearer (`on`: his frame; `off`, its
# inverse); untouched where it's clear of him
_kept_off = (p: vec3, on: mat4, off: mat4, w: ClothWearer, gap: f64, hangs: bool = false) -> vec3:
    q = transform_point(off, p)
    k = _outside_torso(if hangs: _above_floor(q, w) else: q, w, gap)
    if k == q: p else: transform_point(on, k)

# the ribbon's vertices for one piece of cloth: tied at `knot` (world), the air flowing past at
# `air` (world velocity of the air relative to the aircraft), up for the aircraft `up`
# (`top`: the air's speed at which it is at its wildest; the flutter builds to it all the way)
# (`wearer`: worn on someone, kept outside him)
cloth_vertices = (vs: mut Vertex3D[], c: Cloth, knot: vec3, air: vec3, up: vec3, t: f64, drape: vec3 = vec3(0, 0, 0), top: f64 = 95.0, wearer: ClothWearer? = none, sun: vec3 = vec3(0, 1, 0)):
    sp = f64(length(air))
    flow = if sp > 0.5: air / f32(sp) else: vec3(0, -1, 0)
    hang = vec3(0, -1, 0)
    if length(drape) > 0.01:
        d = normalize(drape)
        # (worn: in still air it falls down the wearer's back, turning as they turn; and the air
        # can't blow it through them: blown from behind, it swings out to the side instead)
        hang = normalize(vec3(0, -1, 0) + d * 1.1)
        into = f64(dot(flow, d))
        if into < 0.15:
            across = flow - d * f32(into)
            if length(across) < 0.3: across = normalize(cross(d, up) + vec3(0.0001, 0, 0))
            flow = normalize(normalize(across) + d * 0.15)
    # (slow, it hangs: gravity wins; fast, it streams with the air)
    stream = smoothstep(2.0, 20.0, sp)
    back = normalize(flow * f32(stream) + hang * f32(1.0 - stream))
    side = normalize(cross(back, up) + vec3(0.0001, 0, 0))
    normal = normalize(cross(side, back))
    n = 12
    on = if let w = wearer: w.frame else: mat4()
    off = inverse(on)
    pa = Vertex3D(knot, normal, vec2(0, 0), c.color)
    pb = pa
    r = top / 95.0
    fl = min(sp / r, 95.0)                      # (past this the flutter would strobe)
    freq = 2.0 + fl * 0.32                      # flaps a second
    kwave = 2.2 + fl * 0.03                     # waves along it
    amp = c.length * (0.04 + 0.11 * smoothstep(5.0, 60.0 * r, sp))
    loop k in 0..n + 1:
        u = f64(k) / f64(n)
        # the flutter: a wave running down the cloth, growing toward the free end, with a little
        # chaos at the end that grows with speed
        ph = t * freq * TAU - u * kwave * TAU + c.seed * 7.0
        grow = u * u
        chaos = (noise(t * freq * 0.9 + c.seed * 13.0, u * 3.0) - 0.5) * 2.0 * u * u * u * smoothstep(20.0, 80.0 * r, sp)
        lat = (sin(ph) * grow + chaos * 0.6) * amp
        vert = (sin(ph * 0.5 + 1.3) * grow * 0.4 + chaos * 0.3) * amp
        p = knot + back * f32(u * c.length) + normal * f32(lat) + side * f32(vert)
        if let w = wearer: p = _kept_off(p, on, off, w, _WEAR_GAP, true)
        # the ribbon's two edges, twisting a little as it flutters
        tw = sin(ph * 0.7) * 0.5 * u
        across = normalize(side * f32(cos(tw)) + normal * f32(sin(tw))) * f32(c.width * 0.5 * (1.0 - 0.35 * u))
        col = if (k / 2) % 2 == 0: c.color else: c.stripe
        pl = p - across
        pr = p + across
        if let w = wearer:
            pl = _kept_off(pl, on, off, w, _WEAR_EDGE)
            pr = _kept_off(pr, on, off, w, _WEAR_EDGE)
        a = Vertex3D(pl, normal, vec2(f32(u), 0), col)
        b = Vertex3D(pr, normal, vec2(f32(u), 1), col)
        if k > 0:
            # (front and back faces; only whole triangles go in the list)
            _two_sided(vs, pa, a, pb, normal, sun)
            _two_sided(vs, pb, a, b, normal, sun)
        pa = a
        pb = b

# a triangle seen from both sides, each face wound counterclockwise toward its own normal (the
# mesh is refilled each frame, so the winding is set here): whichever side is toward the eye is
# drawn, lit by its own normal. (After dark the sun is below the horizon and would light the
# undersides from below, cold and blue, as nothing on the wearer is: a face turned down is lit as
# if turned up instead. The change grows from nothing as the sun sets, so there's no jump.)
_two_sided = (vs: mut Vertex3D[], p: Vertex3D, q: Vertex3D, r: Vertex3D, normal: vec3, sun: vec3 = vec3(0, 1, 0)):
    fwd = dot(cross(q.pos - p.pos, r.pos - p.pos), normal) >= 0.0
    a = if fwd: q else: r
    b = if fwd: r else: q
    front = _lit_normal(normal, sun)
    rear = _lit_normal(-normal, sun)
    vs.push(Vertex3D(p.pos, front, p.uv, p.color)); vs.push(Vertex3D(a.pos, front, a.uv, a.color)); vs.push(Vertex3D(b.pos, front, b.uv, b.color))
    vs.push(Vertex3D(p.pos, rear, p.uv, p.color)); vs.push(Vertex3D(b.pos, rear, b.uv, b.color)); vs.push(Vertex3D(a.pos, rear, a.uv, a.color))

_lit_normal = (n: vec3, sun: vec3) -> vec3: if sun.y < 0.0 and n.y < 0.0: vec3(n.x, -n.y, n.z) else: n

# the streamers on an aircraft (in its frame), one each side, tied where its own struts give
# (`ties`: its CraftModel's streamers, found by planes.jo from its struts; none, none drawn)
cloths_for = (ties: vec3[]) -> Cloth[]:
    red = rgb(0.9, 0.2, 0.15)
    cream = rgb(0.95, 0.92, 0.85)
    [loop k in 0..ties.len(): Cloth(ties[k], 2.7, 0.14, red, cream, 2.0 + f64(k))]

# the pilot's own white silk scarf, wrapped round his neck and knotted behind, its two ends hanging
# out over his back (in the figure's frame: it faces -z, its feet at 0, the shoulders 1.45 up)
pilot_scarf = (length: f64 = 1.1) -> Cloth[]:
    white = rgb(0.96, 0.95, 0.91)
    shade = rgb(0.86, 0.85, 0.8)
    down_back = vec3(0, -0.12, 1)
    [Cloth(vec3(0.08, 1.59, 0.15), length, 0.13, white, shade, 1.0, down_back), Cloth(vec3(-0.07, 1.58, 0.15), length * 0.78, 0.11, white, shade, 4.0, down_back)]

struct ClothMesh:
    mesh: Mesh
    ready = false

# (`back` above 0: worn on a figure whose frame `at` is, its back that far behind its spine)
draw_cloths = (cm: mut ClothMesh, cloths: Cloth[], at: mat4, air: vec3, L: Light, t: f64, top: f64 = 95.0, offset: vec3 = vec3(0,0,0), back: f64 = 0.0):
    vs: Vertex3D[]
    origin = render_origin(scene_camera())
    local = render_model(at,origin)
    local[3] += vec4(offset,0)
    up = transform_dir(at, vec3(0, 1, 0))
    wearer: ClothWearer? = if back > 0.0: ClothWearer(local, back) else: none
    loop c in cloths: cloth_vertices(vs, c, transform_point(local, c.at), air, up, t, transform_dir(at, c.drape), top, wearer, normalize(L.sun_dir))
    if vs.len() < 3: return
    if not cm.ready:
        cm.mesh = custom_mesh(vs)
        cm.ready = true
    else: update_mesh(cm.mesh, vs)
    params = obj_params(L,t)
    params.model = mat4()
    draw(obj_sh, cm.mesh, params)
