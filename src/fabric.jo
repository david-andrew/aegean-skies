use 'depth_space.jo'
# Loose cloth: the pilot's scarf (always on him), a streamer on each side's wing strut. In
# the wind of flight cloth streams straight back from where it is tied, taut near the knot; the
# flutter is a wave running down it toward the free end, growing as it goes, quicker and more
# violent the faster the air, the very end whipping about. Made fresh each frame from the airflow
# (no state to settle), as a two-sided ribbon.

use 'look.jo'
use 'objects.jo'
use 'render_space.jo'
use 'tweaks.jo'

struct Cloth:
    at: vec3                        # where it is tied, in the aircraft's frame
    length: f64
    width: f64
    color: vec4
    stripe: vec4                    # a second color, in bands along it
    seed: f64
    drape = vec3(0, 0, 0)           # (in its frame) the way it falls in still air and never blows
                                    # against, past its wearer (none: it falls straight down)

# the ribbon's vertices for one piece of cloth: tied at `knot` (world), the air flowing past at
# `air` (world velocity of the air relative to the aircraft), up for the aircraft `up`
# (`top`: the air's speed at which it is at its wildest; the flutter builds to it all the way)
cloth_vertices = (vs: mut Vertex3D[], c: Cloth, knot: vec3, air: vec3, up: vec3, t: f64, drape: vec3 = vec3(0, 0, 0), top: f64 = 95.0):
    sp = f64(length(air))
    flow = if sp > 0.5: air / f32(sp) else: vec3(0, -1, 0)
    hang = vec3(0, -1, 0)
    if length(drape) > 0.01:
        d = normalize(drape)
        # (worn: in still air it falls down the wearer's back, turning as they turn; and the air
        # can't blow it through them: blown from behind, it swings out to the side instead)
        hang = normalize(vec3(0, -1, 0) + d * 1.1)
        into = f64(dot(flow, d))
        if into < 0.15:
            across = flow - d * f32(into)
            if length(across) < 0.3: across = normalize(cross(d, up) + vec3(0.0001, 0, 0))
            flow = normalize(normalize(across) + d * 0.15)
    # (slow, it hangs: gravity wins; fast, it streams with the air)
    stream = smoothstep(2.0, 20.0, sp)
    back = normalize(flow * f32(stream) + hang * f32(1.0 - stream))
    side = normalize(cross(back, up) + vec3(0.0001, 0, 0))
    normal = normalize(cross(side, back))
    n = 12
    pa = Vertex3D(knot, normal, vec2(0, 0), c.color)
    pb = pa
    r = top / 95.0
    fl = min(sp / r, 95.0)                      # (past this the flutter would strobe)
    # (a trial, Tweaks: by the true speed, slower and gentler)
    gentle = tweaks.cloth_true
    freq = if gentle: 1.5 + fl * 0.18 else: 2.0 + fl * 0.32      # flaps a second
    kwave = 2.2 + fl * 0.03                     # waves along it
    amp = c.length * (0.04 + 0.11 * (if gentle: smoothstep(10.0, 90.0, sp) else: smoothstep(5.0, 60.0 * r, sp)))
    loop k in 0..n + 1:
        u = f64(k) / f64(n)
        # the flutter: a wave running down the cloth, growing toward the free end, with a little
        # chaos at the end that grows with speed
        ph = t * freq * TAU - u * kwave * TAU + c.seed * 7.0
        grow = u * u
        chaos = (noise(t * freq * 0.9 + c.seed * 13.0, u * 3.0) - 0.5) * 2.0 * u * u * u * (if gentle: smoothstep(45.0, 110.0, sp) else: smoothstep(20.0, 80.0 * r, sp))
        lat = (sin(ph) * grow + chaos * 0.6) * amp
        vert = (sin(ph * 0.5 + 1.3) * grow * 0.4 + chaos * 0.3) * amp
        p = knot + back * f32(u * c.length) + normal * f32(lat) + side * f32(vert)
        # the ribbon's two edges, twisting a little as it flutters
        tw = sin(ph * 0.7) * 0.5 * u
        across = normalize(side * f32(cos(tw)) + normal * f32(sin(tw))) * f32(c.width * 0.5 * (1.0 - 0.35 * u))
        col = if (k / 2) % 2 == 0: c.color else: c.stripe
        a = Vertex3D(p - across, normal, vec2(f32(u), 0), col)
        b = Vertex3D(p + across, normal, vec2(f32(u), 1), col)
        if k > 0:
            # (front and back faces; only whole triangles go in the list)
            _two_sided(vs, pa, a, pb, normal)
            _two_sided(vs, pb, a, b, normal)
        pa = a
        pb = b

# a triangle seen from both sides, each face wound counterclockwise toward its own normal (the
# mesh is refilled each frame, so the winding is set here)
_two_sided = (vs: mut Vertex3D[], p: Vertex3D, q: Vertex3D, r: Vertex3D, normal: vec3):
    fwd = dot(cross(q.pos - p.pos, r.pos - p.pos), normal) >= 0.0
    a = if fwd: q else: r
    b = if fwd: r else: q
    vs.push(Vertex3D(p.pos, normal, p.uv, p.color)); vs.push(Vertex3D(a.pos, normal, a.uv, a.color)); vs.push(Vertex3D(b.pos, normal, b.uv, b.color))
    vs.push(Vertex3D(p.pos, -normal, p.uv, p.color)); vs.push(Vertex3D(b.pos, -normal, b.uv, b.color)); vs.push(Vertex3D(a.pos, -normal, a.uv, a.color))

# the streamers on each kind of aircraft (in its frame), one each side, tied halfway up a strut
# that holds the wings: the Gull's rear interplane struts, the Heron's long wing struts, the
# Corsair's interplane struts, the Falco's float struts under its low wing
cloths_for = (kind: int) -> Cloth[]:
    at = match kind:
        0: vec3(3.38, 0.53, 0.12)
        1: vec3(2.8, 1.1, -1.4)
        2: vec3(2.9, 0.46, -0.95)
        _: vec3(1.1, -1.07, -1.4)
    red = rgb(0.9, 0.2, 0.15)
    cream = rgb(0.95, 0.92, 0.85)
    [Cloth(vec3(-at.x, at.y, at.z), 2.7, 0.14, red, cream, 2.0), Cloth(at, 2.7, 0.14, red, cream, 3.0)]

# the pilot's own white silk scarf, wrapped round his neck and knotted behind, its two ends hanging
# out over his back (in the figure's frame: it faces -z, its feet at 0, the shoulders 1.45 up)
pilot_scarf = (length: f64 = 1.1) -> Cloth[]:
    white = rgb(0.96, 0.95, 0.91)
    shade = rgb(0.86, 0.85, 0.8)
    down_back = vec3(0, -0.12, 1)
    [Cloth(vec3(0.08, 1.59, 0.15), length, 0.13, white, shade, 1.0, down_back), Cloth(vec3(-0.07, 1.58, 0.15), length * 0.78, 0.11, white, shade, 4.0, down_back)]

struct ClothMesh:
    mesh: Mesh
    ready = false

draw_cloths = (cm: mut ClothMesh, cloths: Cloth[], at: mat4, air: vec3, L: Light, t: f64, top: f64 = 95.0, offset: vec3 = vec3(0,0,0)):
    vs: Vertex3D[]
    origin = render_origin(scene_camera())
    local = render_model(at,origin)
    local[3] += vec4(offset,0)
    up = transform_dir(at, vec3(0, 1, 0))
    loop c in cloths: cloth_vertices(vs, c, transform_point(local, c.at), air, up, t, transform_dir(at, c.drape), top)
    if vs.len() < 3: return
    if not cm.ready:
        cm.mesh = custom_mesh(vs)
        cm.ready = true
    else: update_mesh(cm.mesh, vs)
    params = obj_params(L,t)
    params.model = mat4()
    draw_world(obj_sh, cm.mesh, params)
