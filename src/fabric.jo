# Loose cloth on an aircraft: the pilot's scarf, a streamer on a strut, a pennant on the tail. In
# the wind of flight cloth streams straight back from where it is tied, taut near the knot; the
# flutter is a wave running down it toward the free end, growing as it goes, quicker and more
# violent the faster the air, the very end whipping about. Made fresh each frame from the airflow
# (no state to settle), as a two-sided ribbon.

use 'look.jo'
use 'objects.jo'

struct Cloth:
    at: vec3                        # where it is tied, in the aircraft's frame
    length: f64
    width: f64
    color: vec4
    stripe: vec4                    # a second color, in bands along it
    seed: f64

# the ribbon's vertices for one piece of cloth: tied at `knot` (world), the air flowing past at
# `air` (world velocity of the air relative to the aircraft), up for the aircraft `up`
cloth_vertices = (vs: mut Vertex3D[], c: Cloth, knot: vec3, air: vec3, up: vec3, t: f64):
    sp = f64(length(air))
    flow = if sp > 0.5: air / f32(sp) else: vec3(0, -1, 0)
    # (slow, it hangs: gravity wins; fast, it streams with the air)
    stream = smoothstep(2.0, 20.0, sp)
    back = normalize(flow * f32(stream) + vec3(0, -1, 0) * f32(1.0 - stream))
    side = normalize(cross(back, up) + vec3(0.0001, 0, 0))
    normal = normalize(cross(side, back))
    n = 12
    freq = 2.0 + sp * 0.32                      # flaps a second
    kwave = 2.2 + sp * 0.03                     # waves along it
    amp = c.length * (0.04 + 0.11 * smoothstep(5.0, 60.0, sp))
    loop k in 0..n + 1:
        u = f64(k) / f64(n)
        # the flutter: a wave running down the cloth, growing toward the free end, with a little
        # chaos at the end that grows with speed
        ph = t * freq * TAU - u * kwave * TAU + c.seed * 7.0
        grow = u * u
        chaos = (noise(t * freq * 0.9 + c.seed * 13.0, u * 3.0) - 0.5) * 2.0 * u * u * u * smoothstep(20.0, 80.0, sp)
        lat = (sin(ph) * grow + chaos * 0.6) * amp
        vert = (sin(ph * 0.5 + 1.3) * grow * 0.4 + chaos * 0.3) * amp
        p = knot + back * f32(u * c.length) + normal * f32(lat) + side * f32(vert)
        # the ribbon's two edges, twisting a little as it flutters
        tw = sin(ph * 0.7) * 0.5 * u
        across = normalize(side * f32(cos(tw)) + normal * f32(sin(tw))) * f32(c.width * 0.5 * (1.0 - 0.35 * u))
        col = if (k / 2) % 2 == 0: c.color else: c.stripe
        a = Vertex3D(p - across, normal, vec2(f32(u), 0), col)
        b = Vertex3D(p + across, normal, vec2(f32(u), 1), col)
        if k > 0:
            pa = vs[vs.len() - 2]
            pb = vs[vs.len() - 1]
            # (front and back faces)
            vs.push(pa); vs.push(a); vs.push(pb)
            vs.push(pb); vs.push(a); vs.push(b)
            na = Vertex3D(pa.pos, -normal, pa.uv, pa.color)
            nb = Vertex3D(pb.pos, -normal, pb.uv, pb.color)
            vs.push(na); vs.push(nb); vs.push(Vertex3D(a.pos, -normal, a.uv, a.color))
            vs.push(nb); vs.push(Vertex3D(b.pos, -normal, b.uv, b.color)); vs.push(Vertex3D(a.pos, -normal, a.uv, a.color))
        vs.push(a)
        vs.push(b)

# the cloth on each kind of aircraft (in its frame): the pilot's scarf at the cockpit, a streamer on
# an outer strut, a pennant at the top of the fin
cloths_for = (cockpit: vec3, kind: int) -> Cloth[]:
    scarf = Cloth(cockpit + vec3(0.12, -0.2, 0.15), 1.1, 0.16, rgb(0.85, 0.12, 0.1), rgb(0.95, 0.92, 0.85), 1.0)
    out: Cloth[] = [scarf]
    match kind:
        0: out.push(Cloth(vec3(3.4, 1.5, -1.1), 0.9, 0.07, rgb(0.9, 0.2, 0.15), rgb(0.95, 0.92, 0.85), 2.0))
        1: out.push(Cloth(vec3(0, 2.9, 6.1), 1.4, 0.22, rgb(0.15, 0.3, 0.6), rgb(0.95, 0.92, 0.85), 3.0))
        2: out.push(Cloth(vec3(0, 1.75, 3.95), 1.1, 0.2, rgb(0.1, 0.1, 0.1), rgb(0.85, 0.15, 0.1), 4.0))
        _: out.push(Cloth(vec3(0, 1.45, 4.5), 0.9, 0.16, rgb(0.9, 0.2, 0.15), rgb(0.95, 0.92, 0.85), 5.0))
    out

struct ClothMesh:
    mesh: Mesh
    ready = false

draw_cloths = (cm: mut ClothMesh, cloths: Cloth[], at: mat4, air: vec3, L: Light, t: f64):
    vs: Vertex3D[]
    up = transform_dir(at, vec3(0, 1, 0))
    loop c in cloths: cloth_vertices(vs, c, transform_point(at, c.at), air, up, t)
    if vs.len() < 3: return
    if not cm.ready:
        cm.mesh = custom_mesh(vs)
        cm.ready = true
    else: update_mesh(cm.mesh, vs)
    draw(obj_sh, cm.mesh, obj_params(L, t))
