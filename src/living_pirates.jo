use 'living_types.jo'
use 'living_money.jo'
use 'living_travel.jo'
use 'living_choices.jo'
use 'living_events.jo'
use 'living_news.jo'
use 'living_weather.jo'
use 'living_seed.jo'
use 'living_duties.jo'

# Predict only from an announced, dated manifest. No query of hidden future claims.
raid_prediction = (w: World, intel: Reason) -> (vec3, int):
    a = w.harbors[intel.origin]; b = w.harbors[intel.destination]
    start = a.center+a.out*1500.0+vec3(0,500,0)
    end = b.center+b.out*1500.0+vec3(0,500,0)
    cove = w.harbors[5].center+w.harbors[5].out*1500.0+vec3(0,500,0)
    lane = end-start
    fraction = clamp(f64(dot(cove-start,lane))/max(1.0,f64(dot(lane,lane))),0.15,0.85)
    point = lerp(start,end,f32(fraction))
    # Departure taxi plus the climb to the outer lane, then half the cruise leg.
    seconds = f64(length(a.center+a.out*100.0-(a.center+a.out*1500.0+vec3(0,500,0))))/55.0
    seconds += f64(length(point-(a.center+a.out*1500.0+vec3(0,500,0))))/55.0
    eta = intel.due_minute+10+int(ceil(seconds/2.0))
    (point,eta)

raid_route = (w: World, point: vec3) -> vec3[]:
    c = w.people[22].craft; h = w.harbors[5]
    # Search is a real small circuit flown at cruise, at most 60 minutes, with return fuel.
    route = [w.aircraft[c].pose.pos,h.center+h.out*100.0,h.center+h.out*250.0+vec3(0,500,0),point]
    loop orbit in 0..1:
        loop corner in [vec3(300,0,0),vec3(0,0,300),vec3(-300,0,0),vec3(0,0,-300),vec3(0,0,0)]: route.push(point+corner)
    route.push(h.center+h.out*250.0+vec3(0,500,0))
    route.push(h.center+h.out*250.0+vec3(0,150,0)); route.push(h.buoy)
    route

plan_captain = (w: mut World):
    p = 22; c = w.people[p].craft
    if w.people[p].trip >= 0 or w.people[p].place != 5 or w.people[p].injured_until > w.minute: return
    if w.factions[3].last_raid_day == day_index(w.minute) or w.minute < w.factions[3].raid_cooldown_until: return
    pressure = w.accounts[w.factions[3].account].cents < 12000
    loop o in w.factions[3].supply_obligations:
        if obligation_live(w.obligations[o].state) and w.obligations[o].due_minute <= w.minute+360: pressure = true
    if not pressure: return
    # Maintain one saved plan until its prediction expires; observation doesn't resample it.
    if w.factions[3].raid_plan_minute < 0:
        best = Reason(); found = false
        loop n in w.people[p].news:
            r = n.reason
            if r.purpose != .delivery or r.good < 0 or r.origin < 0 or r.destination < 0: continue
            if n.confidence < 300 or w.minute-n.occurred_minute > 720 or r.quantity*w.goods[r.good].base_cents/1000 < 3000: continue
            point, eta = raid_prediction(w,r)
            if eta < w.minute or eta > w.minute+180: continue
            best = r; found = true; break
        if not found: return
        point, eta = raid_prediction(w,best)
        route = raid_route(w,point)
        need = route_fuel(route,w.aircraft[c].kind)+1600
        if w.aircraft[c].fuel_ml < need+max(5000,need/5): return
        loot_value = min(4000,best.quantity*w.goods[best.good].base_cents*40/100000)
        loot_qty = loot_value*1000/w.goods[best.good].base_cents
        resale = loot_qty*w.places[5].market.price_cents[best.good]/1000
        expected_net = resale*62/100 - need*w.places[5].market.price_cents[4]/10000-300
        if expected_net <= 0: return
        refresh_pressures(w,p)
        # Provision pressure is the actual faction need, not a fabricated private debt.
        w.people[p].pressures.duty = max(w.people[p].pressures.duty,600)
        raid = Candidate(activity=.raid,purpose=.raid,net_cents=expected_net,duty=0.6,rest=-0.2,company=0.1,greed=clamp(f64(expected_net)/2000.0,0.0,1.0),risk=0.8,illegal=1.0,probability=0.62,exposure_cents=600,minutes=(route_duration(route,65000)+119)/120)
        rest = Candidate(activity=.rest,purpose=.visit,rest=1.0)
        if candidate_score(w,p,raid,701) <= candidate_score(w,p,rest,702): return
        outward = 10+route_minutes(f64(length(route[2]-route[1])+length(point-route[2])),65)
        launch = max(w.minute,eta-outward)
        w.factions[3].raid_plan = best; w.factions[3].raid_plan_minute = launch
        w.people[p].action = Action(activity=.raid,purpose=.raid,reason=Reason(purpose=.raid,actor=p,beneficiary=25,counterparty=best.actor,origin=5,destination=5,good=best.good,quantity=best.quantity,source_event=best.source_event),end_minute=launch,retry_minute=launch)
        w.people[p].next_decision_minute = launch
    if w.minute < w.factions[3].raid_plan_minute: return
    point, eta = raid_prediction(w,w.factions[3].raid_plan)
    route = raid_route(w,point)
    reason = w.people[p].action.reason
    reason.actor = p; reason.purpose = .raid; reason.counterparty = w.factions[3].raid_plan.actor
    reason.origin = 5; reason.destination = 5; reason.beneficiary = 25
    trip = launch_route(w,p,5,route,reason)
    if trip < 0:
        w.factions[3].raid_plan_minute = w.minute+60
        w.people[p].action.end_minute = w.minute+60; w.people[p].action.retry_minute = w.minute+60
        return
    w.factions[3].raid_trip = trip; w.factions[3].last_raid_day = day_index(w.minute)
    w.factions[3].raid_plan_minute = -1; w.raid_departures += 1

swept_separation = (a0: vec3, a1: vec3, b0: vec3, b1: vec3) -> f64:
    d = a0-b0; v = (a1-b1)-d
    denom = f64(dot(v,v))
    t = if denom > 0.0: clamp(-f64(dot(d,v))/denom,0.0,1.0) else: 0.0
    f64(length(d+v*f32(t)))

begin_encounters = (w: mut World):
    raid = w.factions[3].raid_trip
    if raid < 0 or not (raid in w.trips) or w.trips[raid].state != .active or w.trips[raid].encounter >= 0: return
    raider = w.trips[raid].craft
    if w.aircraft[raider].move_owner == .scene: return
    loop victim in w.active_trips:
        if victim == raid or w.trips[victim].craft < 0 or w.trips[victim].reason.purpose == .raid or w.trips[victim].reason.purpose == .patrol: continue
        craft = w.trips[victim].craft
        if w.aircraft[craft].move_owner == .scene or w.trips[victim].encounter >= 0: continue
        if w.people[w.trips[victim].actor].faction == 3: continue
        if swept_separation(w.aircraft[raider].previous_pos,w.aircraft[raider].pose.pos,w.aircraft[craft].previous_pos,w.aircraft[craft].pose.pos) > 800.0: continue
        # Search must reach its known lane; no long-distance target selection.
        id = w.next_encounter; w.next_encounter += 1
        w.encounters[id] = Encounter(id=id,raider_trip=raid,victim_trip=victim,started_tick=w.tick,deadline_tick=w.tick+1200)
        w.trips[raid].encounter = id; w.trips[victim].encounter = id
        w.trips[raid].eta_tick += 1200; w.trips[victim].eta_tick += 1200
        break

loot_cargo = (w: mut World, raider: int, victim: int) -> int:
    total = 0
    loop g in 0..GOOD_COUNT: total += w.aircraft[victim].cargo.qty[g]*w.goods[g].base_cents
    budget = min(4000000,total*40/100) # milli-cent, exact fractional cargo valuation
    original = budget
    capacity = max(0,AIRFRAMES[int(w.aircraft[raider].kind)].cargo_grams-craft_grams(w,raider))
    loop g in 0..GOOD_COUNT:
        qty = min(w.aircraft[victim].cargo.qty[g],budget/max(1,w.goods[g].base_cents))
        qty = min(qty,capacity*1000/w.goods[g].package_grams)
        if qty <= 0: continue
        reserved_loss = max(0,qty-available(w.aircraft[victim].cargo,g))
        w.aircraft[victim].cargo.qty[g] -= qty; w.aircraft[victim].cargo.reserved[g] -= reserved_loss
        w.aircraft[raider].cargo.qty[g] += qty
        budget -= qty*w.goods[g].base_cents
        capacity -= qty*w.goods[g].package_grams/1000
        loop job in w.aircraft[victim].job_manifests:
            if reserved_loss <= 0: break
            if w.jobs[job].good != g: continue
            n = min(reserved_loss,w.jobs[job].loaded_quantity-w.jobs[job].delivered_quantity-w.jobs[job].lost_quantity)
            w.jobs[job].lost_quantity += n; reserved_loss -= n
    (original-budget)/1000

finish_encounter = (w: mut World, id: int, success: bool) -> bool:
    if not (id in w.encounters) or w.encounters[id].resolved: return false
    r = w.encounters[id].raider_trip; v = w.encounters[id].victim_trip
    raider = w.trips[r].craft; victim = w.trips[v].craft
    if raider < 0 or victim < 0: return false
    w.encounters[id].resolved = true
    harm = 0
    if success:
        harm = loot_cargo(w,raider,victim)
        if harm == 0:
            actor = w.trips[v].actor
            cents = min(4000,w.accounts[w.people[actor].account].cents*40/100)
            if cents > 0:
                assert(transfer(w,w.people[actor].account,w.people[w.trips[r].actor].account,cents,.theft,id))
                harm = cents
        w.aircraft[victim].hull = max(0,w.aircraft[victim].hull-100)
        w.aircraft[raider].hull = max(0,w.aircraft[raider].hull-50)
    else:
        w.aircraft[raider].engine = max(0,w.aircraft[raider].engine-100)
        w.aircraft[victim].engine = max(0,w.aircraft[victim].engine-50)
    reason = w.trips[r].reason
    reason.actor = w.trips[r].actor; reason.counterparty = w.trips[v].actor; reason.origin = w.trips[v].origin
    reason.quantity = harm; reason.source_event = -1
    event = emit_event(w,.raid,-1,w.trips[r].actor,w.trips[v].actor,reason,harm,false,w.aircraft[raider].pose.pos)
    w.encounters[id].outcome_event = event
    w.factions[3].raid_cooldown_until = w.minute+1080
    if success and w.aircraft[victim].hull < 500 and draw1000000(w.seed,60,id,w.encounters[id].started_tick/120,1) < 100000:
        ditch(w,victim,w.trips[v].reason)
    # Contact ends the search. Fly the remaining way home from the actual encounter pose.
    h = w.harbors[5]
    w.trips[r].route = [w.aircraft[raider].pose.pos,h.center+h.out*1500.0+vec3(0,500,0),h.center+h.out*250.0+vec3(0,150,0),h.buoy]
    w.trips[r].segment = 0; w.trips[r].segment_elapsed_ticks = 0; w.trips[r].segment_mm = 0
    w.trips[r].last_tick = w.tick; configure_trip_timing(w,r,false)
    true

advance_encounters = (w: mut World):
    ids: int[]
    loop id, _ in w.encounters: ids.push(id)
    ids.sort()
    loop id in ids:
        if w.encounters[id].resolved: continue
        r = w.encounters[id].raider_trip; v = w.encounters[id].victim_trip
        rc = w.trips[r].craft; vc = w.trips[v].craft
        if w.aircraft[rc].move_owner == .scene or w.aircraft[vc].move_owner == .scene: continue
        if w.tick > w.encounters[id].started_tick:
            burn_fuel(w,rc,AIRFRAMES[int(w.aircraft[rc].kind)].burn_ml_sec*2)
            burn_fuel(w,vc,AIRFRAMES[int(w.aircraft[vc].kind)].burn_ml_sec*2)
        if w.tick < w.encounters[id].deadline_tick: continue
        patrol = (w.factions[0].patrol_until >= w.minute and length(w.factions[0].patrol_pos-w.aircraft[rc].pose.pos) <= 2000)
        probability = clamp(0.55+0.20*(f64(w.people[w.trips[r].actor].traits.boldness)/1000.0-0.5)+0.15*f64(w.aircraft[rc].engine-w.aircraft[vc].engine)/1000.0-(if patrol: 0.25 else: 0.0),0.15,0.80)
        success = f64(draw1000000(w.seed,60,id,w.encounters[id].started_tick/120))/1000000.0 < probability
        finish_encounter(w,id,success)

authority_response = (w: mut World):
    loop n in w.places[0].news:
        if n.kind != .raid or n.severity < 500 or n.reason.actor < 0 or n.event in w.bounty_handled: continue
        w.bounty_handled[n.event] = true
        if w.factions[0].bounty_cents == 0 or w.factions[0].bounty_claimed:
            amount = min(4000,w.accounts[w.factions[0].account].cents)
            escrow = if amount > 0: fund_escrow(w,w.factions[0].account,amount,"bounty-{n.event}") else: -1
            w.factions[0].bounty_cents = amount; w.factions[0].bounty_escrow = escrow
            w.factions[0].bounty_event = n.event; w.factions[0].bounty_target = n.reason.actor; w.factions[0].bounty_claimed = false
        w.factions[0].next_patrol_minute = w.minute
        source = n.event
        if source in w.events: w.factions[0].patrol_pos = w.events[source].pos
        else: w.factions[0].patrol_pos = w.harbors[max(0,n.reason.origin)].safe_water
        # Pending patrol is a funded, local response, not a global omniscient pursuit.
        reason = Reason(purpose=.patrol,actor=9,counterparty=n.reason.actor,origin=0,destination=0,source_event=n.event,amount_cents=w.factions[0].bounty_cents)
        w.people[9].action = Action(activity=.patrol,purpose=.patrol,reason=reason,end_minute=w.minute+60,retry_minute=w.minute)
        w.people[9].next_decision_minute = w.minute+60
        break
    if w.factions[0].bounty_event >= 0 and not w.factions[0].bounty_claimed and w.factions[0].last_patrol_day < day_index(w.minute) and w.people[9].trip < 0 and w.people[9].place == 0 and local_minute(w.minute) >= 480 and local_minute(w.minute) < 1080:
        w.people[9].action = Action(activity=.patrol,purpose=.patrol,reason=Reason(purpose=.patrol,actor=9,counterparty=w.factions[0].bounty_target,origin=0,destination=0,source_event=w.factions[0].bounty_event),end_minute=w.minute+60)
    if w.people[9].action.activity != .patrol or w.people[9].trip >= 0 or w.people[9].place != 0: return
    if local_minute(w.minute) < 360 or local_minute(w.minute) >= 1200:
        w.people[9].action.retry_minute = w.minute+60
        w.people[9].action.end_minute = w.minute+60
        w.people[9].action.failure_code = "night patrol waits for daylight; recheck in 60 minutes"
        return
    if w.minute < w.factions[0].next_patrol_minute: return
    h = w.harbors[0]; point = w.factions[0].patrol_pos; point.y = max(point.y,500.0)
    route = [w.aircraft[4].pose.pos,h.center+h.out*100.0,h.center+h.out*1500.0+vec3(0,500,0),point,h.center+h.out*1500.0+vec3(0,500,0),h.center+h.out*250.0+vec3(0,150,0),h.buoy]
    needed = route_fuel(route,w.aircraft[4].kind)
    if w.aircraft[4].fuel_ml < needed+max(5000,needed/5):
        milli = max(0,(needed+max(5000,needed/5)-w.aircraft[4].fuel_ml+9)/10)
        bill = milli*w.places[0].market.price_cents[4]/1000
        allowance = bill+max(1,bill*2/100)
        if allowance > 0 and available(w.places[0].market.inventory,4) >= milli and w.accounts[w.factions[0].account].cents >= allowance:
            # Validate stock/capacity before granting the one purchase allowance.
            assert(transfer(w,w.factions[0].account,w.people[9].account,allowance,.fuel))
            assert(trade(w,9,0,4,milli,true,4))
            assert(fill_from_cargo(w,4,milli))
    trip = launch_route(w,9,0,route,w.people[9].action.reason)
    if trip >= 0:
        w.patrol_departures += 1
        w.factions[0].last_patrol_day = day_index(w.minute)
    else:
        w.factions[0].next_patrol_minute = w.minute+60
        w.people[9].action.retry_minute = w.minute+60
        w.people[9].action.end_minute = w.minute+60
        w.people[9].action.failure_code = "patrol needs fuel, open water or a mechanic"

crew_recovery = (w: mut World):
    worker = w.factions[3].salvage_person
    if worker >= 0 and w.minute >= w.factions[3].salvage_until:
        # A named sixty-minute harbor salvage service, bought by the outside sector.
        if w.people[worker].place == 5 and w.people[worker].injured_until <= w.minute:
            assert(transfer(w,-1,w.people[worker].account,1200,.outside_export))
        w.factions[3].salvage_person = -1
        w.people[worker].action.activity = .wait
        w.people[worker].next_decision_minute = w.minute
    if w.factions[3].salvage_person < 0 and w.factions[3].last_salvage_day != day_index(w.minute) and local_minute(w.minute) >= 540 and local_minute(w.minute) < 1020:
        broken = w.aircraft[7].engine < 350 or w.aircraft[6].engine < 350 or w.aircraft[6].fuel_ml < 22000
        if broken and w.people[23].place == 5 and w.people[23].trip < 0 and w.people[23].injured_until <= w.minute:
            w.factions[3].salvage_person = 23; w.factions[3].salvage_until = w.minute+60
            w.factions[3].last_salvage_day = day_index(w.minute)
            w.people[23].action = Action(activity=.work,purpose=.salvage,reason=Reason(purpose=.salvage,actor=23,origin=5,destination=5,amount_cents=1200),end_minute=w.minute+60)
            w.people[23].next_decision_minute = w.minute+60
    if w.people[22].place != 5 or w.people[22].trip >= 0: return
    c = w.people[22].craft
    # All loot is sold into the real cove till, subject to its cash/capacity.
    loop g in 0..GOOD_COUNT:
        qty = min(10000,available(w.aircraft[c].cargo,g))
        if qty > 0: trade(w,22,5,g,qty,false,c)
    if w.aircraft[c].fuel_ml < 27000:
        qty = min(3000,min(available(w.places[5].market.inventory,4),(30000-w.aircraft[c].fuel_ml)/10))
        if qty > 0 and trade(w,22,5,4,qty,true,c): fill_from_cargo(w,c,qty)
    if w.aircraft[c].engine < 350 or w.aircraft[c].fuel_ml < 22000:
        day = day_index(w.minute)
        if day-w.factions[3].last_credit_day >= 7:
            assert(transfer(w,-1,w.factions[3].account,4000,.subsidy))
            obligation = seed_obligation(w,"crew-credit-{day}",22,25,.debt,w.minute+1440,w.minute+2880,4000,5)
            w.obligations[obligation].creditor_account = w.factions[3].account
            w.factions[3].last_credit_day = day
        # A limited actual advance from the crew purse; no negative wallet or fabricated fuel.
        cash = min(4000,w.accounts[w.factions[3].account].cents)
        if cash > 0 and w.accounts[22].cents < 2000: transfer(w,w.factions[3].account,w.people[22].account,cash,.debt)

pirates_minute = (w: mut World):
    begin_encounters(w)
    advance_encounters(w)
    authority_response(w)
    crew_recovery(w)
    plan_captain(w)
    # Returning patrol/search creates an actual outcome even when the prey was absent.
    loop p in [9,22]:
        c = w.people[p].craft
        if w.people[p].trip >= 0 or w.aircraft[c].trip >= 0: continue
        r = w.people[p].action.reason
        if p == 9 and r.purpose == .patrol and w.people[p].action.activity == .wait:
            w.factions[0].patrol_until = w.minute+1440
            emit_event(w,.patrol,w.people[p].place,p,r.counterparty,r)
            w.people[p].action.reason.purpose = .visit
        if p == 22 and r.purpose == .raid and w.people[p].action.activity == .wait:
            if w.factions[3].raid_trip >= 0 and w.trips[w.factions[3].raid_trip].encounter < 0:
                emit_event(w,.raid,5,p,-1,r)
            w.people[p].action.reason.purpose = .visit

# Scene outcomes supply direct witnessed custody evidence. Wreck discovery isn't custody.
claim_bounty = (w: mut World, claimant: int, craft: int, evidence: int) -> bool:
    f = 0
    if claimant < 0 or claimant >= w.people.len() or craft < 0 or craft >= w.aircraft.len() or not (evidence in w.events): return false
    if w.factions[f].bounty_claimed or w.factions[f].bounty_cents <= 0: return false
    target = w.factions[f].bounty_target
    e = w.events[evidence]
    if e.kind != .patrol or e.reason.source_event != w.factions[f].bounty_event or e.target != target: return false
    if not (9 in e.witnesses) or not (claimant in e.witnesses) or not (target in e.witnesses): return false
    if w.aircraft[craft].owner != target or w.aircraft[craft].place != 0 or w.aircraft[craft].held_by_faction != 0 or w.aircraft[craft].state != .workshop: return false
    if w.people[target].place != 0 or w.people[claimant].place != 0: return false
    escrow = w.factions[f].bounty_escrow
    amount = w.factions[f].bounty_cents
    if escrow < 0 or w.accounts[escrow].cents < amount: return false
    w.factions[f].bounty_claimed = true
    assert(transfer(w,escrow,w.people[claimant].account,amount,.reward,evidence))
    w.factions[f].bounty_cents = 0
    true
