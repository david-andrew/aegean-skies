# Licensed scores and procedural instruments; see data/music/SOURCES.md.
use 'music_data.jo'
use 'music_synth.jo'
use 'singer.jo'
use 'radio_chain.jo'
use 'radio_station.jo'
use 'voice_text.jo'
use 'voice_synth.jo'
use 'radio_studio.jo'
# One mono 16 kHz stream, bounded blocks. No game/global RNG is touched.
const RADIO_RATE = 16000
const RADIO_TABLE = 1024
const RADIO_BLOCK = 800             # <= 50 ms per render call
# How worn the announcer's broadcast is (radio_studio.jo, radio_chain.jo `wear`): 0 the original
# settings, 1 the most a bulletin is degraded.
const RADIO_SPEECH_WEAR = 0.45

enum RadioStyle: foxtrot, tango, waltz, bouzouki, march, choir, morse, classical, speech

struct RadioFilter:
    b0 = 0.0
    b1 = 0.0
    b2 = 0.0
    a1 = 0.0
    a2 = 0.0
    x1 = 0.0
    x2 = 0.0
    y1 = 0.0
    y2 = 0.0

radio_filter = (hz: f64, high: bool) -> RadioFilter:
    w = TAU * hz / f64(RADIO_RATE)
    c = cos(w); a = sin(w) / (2.0 * 0.70710678); d = 1.0 + a
    b = (if high: 1.0 + c else: 1.0 - c) / (2.0 * d)
    RadioFilter(b, (if high: -2.0 else: 2.0) * b, b, -2.0*c/d, (1.0-a)/d)

radio_filter_sample = (f: mut RadioFilter, x: f64) -> f64:
    y = f.b0*x + f.b1*f.x1 + f.b2*f.x2 - f.a1*f.y1 - f.a2*f.y2
    f.x2 = f.x1; f.x1 = x; f.y2 = f.y1; f.y1 = y
    y

struct RadioSynth:
    sine: f32[]
    music: MusicSynth = MusicSynth()
    music_ready = false
    sings = false                    # the piece on is a song: her voice over it (src/singer.jo)
    singing = true                   # (false: a song plays as scored, its instrument's tune and no voice: the tools' comparison)
    singer: Singer = Singer()
    style: RadioStyle = .foxtrot
    seed = 0
    channel = -1                     # the station (src/radio.jo RadioStation.id), for its playlist
    cursor = 0
    rng: u64 = 1729
    hp: RadioFilter = radio_filter(300, true)
    lp: RadioFilter = radio_filter(3000, false)
    morse: bool[]
    morse_origin = 0
    morse_unit = 1280                # 80 ms: 15 words/minute PARIS timing
    strength = 0.0
    whistle = 0.0
    crackle = 0.0
    fade_phase = 0.0
    whistle_phase = 0.0
    chain: RadioChain = RadioChain()
    station: StationLevel = StationLevel()
    record_mix = 0.0
    night = 0.0
    # The announcer (src/voice_text.jo, src/voice_synth.jo). A bulletin repeats on the world
    # clock with the given period, as the Morse loop did; silence fills the rest of a period.
    voice_bank: VoiceBank
    voice_tried = false              # loading was attempted (the data file may be absent)
    voice: VoiceSynth
    speech_text: str = ""
    speech_origin = 0                # sample where the current period began
    speech_period = 160000           # samples
    speech_seed = 0
    studio: Studio
    speech_colour = 0.0

# The receiver only needs a sine for its Morse tone, fading and tuning whistle.
make_radio_synth = () -> RadioSynth:
    RadioSynth(sine=[loop i in 0..RADIO_TABLE: f32(sin(TAU*f64(i)/f64(RADIO_TABLE))*0.48)])

# Prepare bounded storage and hot paths during world loading, before first play.
# Discard the tiny procedural warmup; subsequent programme selection resets all audible
# state. This opens no stream/device and retains no reference or pre-rendered programme.
# Load the announcer once; without its data file (AEGEAN_VOICE_DATA) speech stays off.
radio_voice_prepare = (s: mut RadioSynth):
    if s.voice_tried: return
    s.voice_tried = true
    s.voice_bank = voice_load()
    if not s.voice_bank.ready: return
    s.voice = make_voice_synth(s.voice_bank)
    # Warm the text stage and the vocoder during loading (first-run costs in the browser), then
    # discard: the first real bulletin starts from a clean state.
    warm = voice_plan(s.voice_bank,"Here is the news at 09:30.",VoiceStyle(),0)
    voice_start(s.voice,warm,0,0)
    _ = voice_render(s.voice,800)
    voice_start(s.voice,VoicePlan(),0,0)

radio_synth_prepare = (s: mut RadioSynth):
    radio_voice_prepare(s)
    if s.music_ready: return
    s.music = make_music_synth(); s.music_ready = true
    s.music.events = [MusicEvent(0,1600,60,0,0.6,0.6),MusicEvent(0,1600,60,6,0.6,0.6)]
    s.music.frames = 128
    s.chain = make_radio_chain(0,0)
    _ = radio_render(s,128,1,0)
    s.music.piece = -1; s.music.events = []; s.music.frames = 1
    music_seek(s.music,0)
    s.strength = 0
    radio_synth_program(s,.morse,0,0)

# Each style's pieces (MUSIC_PIECES): a station plays its style's pieces one after another on the
# world clock, each heard whole from its start (radio_cue). The island stations (Archipelago Radio,
# Radio Dawn) play the island dance and the Greek songs; the cafe stations add the songs and the accordion.
radio_pool = (style: RadioStyle, station: int = -1) -> int[]:
    match style:
        .classical: [0,13,44,45,46,47,48,49,67,88,14,15,50,70,16,17,1,18,90,19,20,51,74,21,22,78,52,23,24,54,87,25,26,82,85,55,56,57,68,89,27,12,28,75,59,29,60,79,61,63,91,64,69,71,72,76,77,80,73,83,92,101,93,95,94,96,97,99,98,100,102,114]
        .foxtrot: [2]
        .tango: [3,38]
        .march: [4,32,33,58]
        # (Cafe Aman: the Greek songs among the cafe's; the island stations: Ikariotikos and the
        # Greek songs of the 1877 collection)
        .bouzouki: if station == 11: [5,103,109,34,104,105,110,35,106,107,111,108,112] else: if station >= 7: [34,5,35,36,103,37,39,65,40,109,66] else: [5,103,104,105,106,107,108,109,110]
        .choir: [41,42,86,43,62,24]
        .waltz: [6,30,81,31,23,84,53]
        else: [0]

struct RadioCue:
    piece = 0
    at = 0.0                         # seconds into it

_piece_seconds = (piece: int) -> f64: f64(MUSIC_PIECES[piece].frames)/f64(MUSIC_RATE)

# Where the station's round of its style's pieces is at this moment of the world clock (each
# station starts its round at its own place).
radio_cue = (style: RadioStyle, station: int, seconds: f64) -> RadioCue:
    pool = radio_pool(style,station)
    total = 0.0
    loop k in pool: total += _piece_seconds(k)
    t = seconds+f64(max(0,station))*1913.0
    t = t-floor(t/total)*total
    loop k in pool:
        span = _piece_seconds(k)
        if t < span: return RadioCue(k,t)
        t -= span
    RadioCue(pool[0],0.0)

# The piece after this one in the station's round.
radio_next_piece = (style: RadioStyle, station: int, piece: int) -> int:
    pool = radio_pool(style,station)
    loop k in 0..pool.len():
        if pool[k] == piece: return pool[(k+1)%pool.len()]
    pool[0]

# (The piece on now, for the programme's title.)
radio_piece = (style: RadioStyle, station: int, seconds: f64) -> int: radio_cue(style,station,seconds).piece

# The programme decides the piano: the classical (concert) programme the grand, the popular and
# dance programmes the honky-tonk upright.
# The station's round at this moment (radio_cue).
radio_music_on_air = (s: mut RadioSynth, seconds: f64):
    cue = radio_cue(s.style,s.channel,seconds)
    radio_music_load(s,cue.piece,cue.at)

# One piece, this far into it (wrapping round): auditions and the tools.
radio_music_program = (s: mut RadioSynth, piece: int, seconds: f64):
    radio_music_load(s,piece,seconds%_piece_seconds(piece))

radio_music_load = (s: mut RadioSynth, piece: int, at: f64):
    if not s.music_ready:
        s.music = make_music_synth(); s.music_ready = true
    music_set_piano(s.music, s.style != .classical)
    before = s.music.piece
    music_load(s.music,piece)
    # (a song: her line taken from the freshly loaded score; a piece loaded already has it taken)
    if before != s.music.piece:
        s.sings = s.singing and singer_sings(piece)
        if s.sings: s.singer = singer_take_line(s.music,piece)
    record_levels = [0.35,0.15,0.80,0.70,0.50,0.10,0.60]
    s.record_mix = if piece < record_levels.len(): record_levels[max(0,piece)] else: 0.35
    music_seek(s.music,at)
    if s.sings: singer_seek(s.singer,s.music.cursor)

# A spoken bulletin: plan the words once, then find where in its period the world clock is.
radio_speech_program = (s: mut RadioSynth, text: str, voice: VoiceStyle, span: f64, seconds: f64):
    radio_voice_prepare(s)
    if not s.voice_bank.ready:
        # No announcer data: a silent programme (radio_play chooses Morse instead).
        s.speech_period = max(VOICE_HOP,int(max(1.0,span)*f64(RADIO_RATE)))
        s.speech_origin = s.cursor
        voice_start(s.voice,VoicePlan(),0,0)
        return
    plan = voice_plan(s.voice_bank,text,voice,s.seed)
    s.studio = make_studio(RADIO_SPEECH_WEAR)
    s.speech_colour = clamp(voice.colour,0.0,1.0)
    s.record_mix = clamp(voice.record,0.0,1.0)
    period = ceil((plan.seconds+1.5)/max(1.0,span))*max(1.0,span)
    s.speech_period = max(VOICE_HOP,int(period*f64(RADIO_RATE)))
    s.speech_origin = int((floor((seconds+1140.0)/period)*period-1140.0)*f64(RADIO_RATE))
    s.speech_text = text
    s.speech_seed = s.seed
    voice_start(s.voice,plan,max(0,s.cursor-s.speech_origin),s.seed)

# The next count samples of the bulletin loop (dry voice, before the station and the receiver).
# Gaps carry a -140 dB dither: exact zeros let the receiver's filters decay into subnormal
# floats, which cost several times a normal sample on x86 and in wasm.
radio_speech_block = (s: mut RadioSynth, count: int) -> f64[]:
    out = fill(0.0,max(0,count))
    loop k in 0..out.len(): out[k] = (radio_noise(s))*1e-7
    i = 0
    total = s.voice.plan.count*VOICE_HOP
    loop i < out.len():
        position = s.cursor+i-s.speech_origin
        if position >= s.speech_period:
            s.speech_origin += s.speech_period
            continue
        if position < 0 or position >= total:
            i += if position < 0: min(out.len()-i,-position) else: min(out.len()-i,s.speech_period-position)
            continue
        if s.voice.cursor != position: voice_start(s.voice,s.voice.plan,position,s.speech_seed)
        n = min(out.len()-i,total-position)
        chunk = voice_render(s.voice,n)
        loop k in 0..n: out[i+k] += chunk[k]
        i += n
    out

radio_synth_program = (s: mut RadioSynth, style: RadioStyle, seed: int, seconds: f64, morse: bool[] = [], text: str = "", voice: VoiceStyle = VoiceStyle(), span: f64 = 10.0, station: int = -1):
    s.style = style; s.seed = max(0,seed); s.channel = station
    s.cursor = max(0,int(seconds*f64(RADIO_RATE)))
    s.morse = morse
    s.hp = radio_filter(300,true); s.lp = radio_filter(3000,false)
    s.rng = u64(1729 + s.seed*31 + s.cursor%1000003)
    s.crackle = 0; s.fade_phase = 0; s.whistle_phase = 0
    s.chain = make_radio_chain(seed,seconds,if style == .speech: RADIO_SPEECH_WEAR else: 0.0)
    s.station = StationLevel()
    s.chain.strength = clamp(s.strength,0.0,1.0)
    s.record_mix = 0
    if style == .speech: radio_speech_program(s,text,voice,span,seconds)
    else if style != .morse: radio_music_on_air(s,seconds)

radio_noise = (s: mut RadioSynth) -> f64:
    s.rng = (s.rng*u64(1664525)+u64(1013904223)) & u64(0xffffffff)
    f64(s.rng)/2147483648.0-1.0

radio_osc = (s: RadioSynth, phase: f64) -> f64:
    p = phase*f64(RADIO_TABLE)
    k = int(p)%RADIO_TABLE
    a = f64(s.sine[k]); b = f64(s.sine[(k+1)%RADIO_TABLE])
    a+(b-a)*(p-floor(p))

# Return raw mono PCM for either a live stream or an offline file. Work is always bounded.
radio_render = (s: mut RadioSynth, count: int, strength: f64 = 1.0, detuning: f64 = 0.0, dry: bool = false, levelling: bool = true) -> f32[]:
    out = fill(f32(0),clamp(count,0,RADIO_BLOCK))
    if out.len() == 0: return out
    target = clamp(strength,0.0,1.0)
    programme: f64[]
    if s.style == .speech:
        programme = radio_speech_block(s,out.len())
        if not dry: studio_block(s.studio,programme,s.speech_colour)
    else if s.style != .morse:
        if not s.music_ready: radio_music_on_air(s,f64(s.cursor)/f64(RADIO_RATE))
        # (at a piece's end, the next in the station's round, from its start)
        loop programme.len() < out.len():
            if s.music.cursor >= s.music.frames: radio_music_load(s,radio_next_piece(s.style,s.channel,s.music.piece),0.0)
            part = music_render(s.music,min(out.len()-programme.len(),s.music.frames-s.music.cursor))
            if part.len() == 0: break
            if s.sings:
                # (her voice, against the piece as loud as the piece's own level)
                voice = singer_render(s.singer,part.len())
                weight = MUSIC_PIECES[s.music.piece].sung_gain*MUSIC_PIECES[s.music.piece].level
                loop k in 0..part.len(): part[k] += voice[k]*weight
            loop v in part: programme.push(v)
        loop programme.len() < out.len(): programme.push(0.0)
    if not dry and levelling and s.style != .morse:station_level_block(s.station,programme)
    loop i in 0..out.len():
        value = 0.0
        if s.style == .morse:
            morse_cursor = max(0,s.cursor-s.morse_origin)
            unit = morse_cursor/s.morse_unit
            if s.morse.len() > 0 and s.morse[unit%s.morse.len()]:
                a = morse_cursor%s.morse_unit
                current = unit%s.morse.len()
                previous = (current+s.morse.len()-1)%s.morse.len()
                next = (current+1)%s.morse.len()
                attack = if s.morse[previous]: 1.0 else: min(1.0,f64(a)/80.0)
                release = if s.morse[next]: 1.0 else: min(1.0,f64(s.morse_unit-a)/80.0)
                envelope = min(attack,release)
                value = radio_osc(s,(f64(s.cursor)*720.0/f64(RADIO_RATE))%1.0)*0.65*envelope
        else:
            value = programme[i]
        s.strength += (target-s.strength)*0.002
        if not dry:
            if levelling and s.style == .morse:value=station_level(s.station,value)
            value = radio_chain_sample(s.chain,value,target,detuning,if s.style == .morse: 0.0 else: s.record_mix,s.night)
        out[i] = f32(clamp(value,-0.95,0.95))
        s.cursor += 1
    out

# ITU letters/digits, actual text keyed with 1/3/7-unit timing. Unknown punctuation is a word
# break; cap the message so world-generated names can never allocate an unbounded audio queue.
RADIO_MORSE = [".-","-...","-.-.","-..",".","..-.","--.","....","..",".---","-.-",".-..","--","-.","---",".--.","--.-",".-.","...","-","..-","...-",".--","-..-","-.--","--..","-----",".----","..---","...--","....-",".....","-....","--...","---..","----."]
radio_morse = (text: str) -> bool[]:
    out: bool[]
    used = 0
    loop c in text.upper():
        if used >= 96: break
        used += 1
        index = if c >= 'A' and c <= 'Z': int(c)-int('A') else: if c >= '0' and c <= '9': 26+int(c)-int('0') else: -1
        if index < 0:
            # The previous letter already supplied 3 silent units.
            loop j in 0..4: out.push(false)
            continue
        code = RADIO_MORSE[index]
        loop j in 0..code.len():
            loop n in 0..(if code[j] == '-': 3 else: 1): out.push(true)
            if j+1 < code.len(): out.push(false)
        loop j in 0..3: out.push(false)
    loop j in 0..4: out.push(false)
    out

# radio_morse's length for a text, in units, without making the key: for whoever follows the
# keying each frame (src/morse_subtitles.jo).
radio_morse_units = (text: str) -> int:
    units = 0
    used = 0
    loop c in text.upper():
        if used >= 96: break
        used += 1
        index = if c >= 'A' and c <= 'Z': int(c)-int('A') else: if c >= '0' and c <= '9': 26+int(c)-int('0') else: -1
        if index < 0:
            units += 4
            continue
        code = RADIO_MORSE[index]
        loop j in 0..code.len(): units += if code[j] == '-': 3 else: 1
        units += code.len()-1+3
    units+4
