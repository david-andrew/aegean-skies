# Licensed scores and procedural instruments; see data/music/SOURCES.md.
use 'music_synth.jo'
use 'radio_chain.jo'
use 'radio_station.jo'
# One mono 16 kHz stream, bounded blocks. No game/global RNG is touched.
const RADIO_RATE = 16000
const RADIO_TABLE = 1024
const RADIO_BLOCK = 800             # <= 50 ms per render call

enum RadioStyle: foxtrot, tango, waltz, bouzouki, march, choir, morse, classical

struct RadioFilter:
    b0 = 0.0
    b1 = 0.0
    b2 = 0.0
    a1 = 0.0
    a2 = 0.0
    x1 = 0.0
    x2 = 0.0
    y1 = 0.0
    y2 = 0.0

radio_filter = (hz: f64, high: bool) -> RadioFilter:
    w = TAU * hz / f64(RADIO_RATE)
    c = cos(w); a = sin(w) / (2.0 * 0.70710678); d = 1.0 + a
    b = (if high: 1.0 + c else: 1.0 - c) / (2.0 * d)
    RadioFilter(b, (if high: -2.0 else: 2.0) * b, b, -2.0*c/d, (1.0-a)/d)

radio_filter_sample = (f: mut RadioFilter, x: f64) -> f64:
    y = f.b0*x + f.b1*f.x1 + f.b2*f.x2 - f.a1*f.y1 - f.a2*f.y2
    f.x2 = f.x1; f.x1 = x; f.y2 = f.y1; f.y1 = y
    y

struct RadioSynth:
    sine: f32[]
    music: MusicSynth = MusicSynth()
    music_ready = false
    style: RadioStyle = .foxtrot
    seed = 0
    cursor = 0
    rng: u64 = 1729
    hp: RadioFilter = radio_filter(300, true)
    lp: RadioFilter = radio_filter(3000, false)
    morse: bool[]
    morse_origin = 0
    morse_unit = 1280                # 80 ms: 15 words/minute PARIS timing
    strength = 0.0
    whistle = 0.0
    crackle = 0.0
    fade_phase = 0.0
    whistle_phase = 0.0
    chain: RadioChain = RadioChain()
    station: StationLevel = StationLevel()
    record_mix = 0.0
    night = 0.0

# The receiver only needs a sine for its Morse tone, fading and tuning whistle.
make_radio_synth = () -> RadioSynth:
    RadioSynth(sine=[loop i in 0..RADIO_TABLE: f32(sin(TAU*f64(i)/f64(RADIO_TABLE))*0.48)])

# Prepare bounded storage and hot paths during world loading, before first play.
# Discard the tiny procedural warmup; subsequent programme selection resets all audible
# state. This opens no stream/device and retains no reference or pre-rendered programme.
radio_synth_prepare = (s: mut RadioSynth):
    if s.music_ready: return
    s.music = make_music_synth(); s.music_ready = true
    s.music.events = [MusicEvent(0,1600,60,0,0.6,0.6),MusicEvent(0,1600,60,6,0.6,0.6)]
    s.music.frames = 128
    s.chain = make_radio_chain(0,0)
    _ = radio_render(s,128,1,0)
    s.music.piece = -1; s.music.events = []; s.music.frames = 1
    music_seek(s.music,0)
    s.strength = 0
    radio_synth_program(s,.morse,0,0)

# The legacy choir slot now carries quiet instrumental island music, never fake speech.
radio_piece = (style: RadioStyle, seed: int) -> int:
    match style:
        .classical: if (max(0,seed)/336)%2 == 0: 0 else: 1
        .foxtrot: 2
        .tango: 3
        .march: 4
        .bouzouki, .choir: 5
        .waltz: 6
        else: 0

radio_music_program = (s: mut RadioSynth, piece: int, seconds: f64):
    if not s.music_ready:
        s.music = make_music_synth(); s.music_ready = true
    music_load(s.music,piece)
    record_levels = [0.35,0.15,0.80,0.70,0.50,0.10,0.60]
    s.record_mix = record_levels[clamp(piece,0,record_levels.len()-1)]
    music_seek(s.music,seconds%(f64(s.music.frames)/f64(MUSIC_RATE)))

radio_synth_program = (s: mut RadioSynth, style: RadioStyle, seed: int, seconds: f64, morse: bool[] = []):
    s.style = style; s.seed = max(0,seed)
    s.cursor = max(0,int(seconds*f64(RADIO_RATE)))
    s.morse = morse
    s.hp = radio_filter(300,true); s.lp = radio_filter(3000,false)
    s.rng = u64(1729 + s.seed*31 + s.cursor%1000003)
    s.crackle = 0; s.fade_phase = 0; s.whistle_phase = 0
    s.chain = make_radio_chain(seed,seconds)
    s.station = StationLevel()
    s.chain.strength = clamp(s.strength,0.0,1.0)
    s.record_mix = 0
    if style != .morse: radio_music_program(s,radio_piece(style,seed),seconds)

radio_noise = (s: mut RadioSynth) -> f64:
    s.rng = (s.rng*u64(1664525)+u64(1013904223)) & u64(0xffffffff)
    f64(s.rng)/2147483648.0-1.0

radio_osc = (s: RadioSynth, phase: f64) -> f64:
    p = phase*f64(RADIO_TABLE)
    k = int(p)%RADIO_TABLE
    a = f64(s.sine[k]); b = f64(s.sine[(k+1)%RADIO_TABLE])
    a+(b-a)*(p-floor(p))

# Return raw mono PCM for either a live stream or an offline file. Work is always bounded.
radio_render = (s: mut RadioSynth, count: int, strength: f64 = 1.0, detuning: f64 = 0.0, dry: bool = false, levelling: bool = true) -> f32[]:
    out = fill(f32(0),clamp(count,0,RADIO_BLOCK))
    if out.len() == 0: return out
    target = clamp(strength,0.0,1.0)
    programme: f64[]
    if s.style != .morse:
        if not s.music_ready: radio_music_program(s,radio_piece(s.style,s.seed),f64(s.cursor)/f64(RADIO_RATE))
        if s.music.cursor >= s.music.frames: music_seek(s.music,0)
        first = min(out.len(),s.music.frames-s.music.cursor)
        programme = music_render(s.music,first)
        if first < out.len():
            music_seek(s.music,0)
            tail = music_render(s.music,out.len()-first)
            loop v in tail: programme.push(v)
    if not dry and levelling and s.style != .morse:station_level_block(s.station,programme)
    loop i in 0..out.len():
        value = 0.0
        if s.style == .morse:
            morse_cursor = max(0,s.cursor-s.morse_origin)
            unit = morse_cursor/s.morse_unit
            if s.morse.len() > 0 and s.morse[unit%s.morse.len()]:
                a = morse_cursor%s.morse_unit
                current = unit%s.morse.len()
                previous = (current+s.morse.len()-1)%s.morse.len()
                next = (current+1)%s.morse.len()
                attack = if s.morse[previous]: 1.0 else: min(1.0,f64(a)/80.0)
                release = if s.morse[next]: 1.0 else: min(1.0,f64(s.morse_unit-a)/80.0)
                envelope = min(attack,release)
                value = radio_osc(s,(f64(s.cursor)*720.0/f64(RADIO_RATE))%1.0)*0.65*envelope
        else:
            value = programme[i]
        s.strength += (target-s.strength)*0.002
        if not dry:
            if levelling and s.style == .morse:value=station_level(s.station,value)
            value = radio_chain_sample(s.chain,value,target,detuning,if s.style == .morse: 0.0 else: s.record_mix,s.night)
        out[i] = f32(clamp(value,-0.95,0.95))
        s.cursor += 1
    out

# ITU letters/digits, actual text keyed with 1/3/7-unit timing. Unknown punctuation is a word
# break; cap the message so world-generated names can never allocate an unbounded audio queue.
RADIO_MORSE = [".-","-...","-.-.","-..",".","..-.","--.","....","..",".---","-.-",".-..","--","-.","---",".--.","--.-",".-.","...","-","..-","...-",".--","-..-","-.--","--..","-----",".----","..---","...--","....-",".....","-....","--...","---..","----."]
radio_morse = (text: str) -> bool[]:
    out: bool[]
    used = 0
    loop c in text.upper():
        if used >= 96: break
        used += 1
        index = if c >= 'A' and c <= 'Z': int(c)-int('A') else: if c >= '0' and c <= '9': 26+int(c)-int('0') else: -1
        if index < 0:
            # The previous letter already supplied 3 silent units.
            loop j in 0..4: out.push(false)
            continue
        code = RADIO_MORSE[index]
        loop j in 0..code.len():
            loop n in 0..(if code[j] == '-': 3 else: 1): out.push(true)
            if j+1 < code.len(): out.push(false)
        loop j in 0..3: out.push(false)
    loop j in 0..4: out.push(false)
    out
