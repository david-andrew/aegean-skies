# One procedural pigment sheet and paper tooth for the painted world. Generated
# from integer cell identities at startup; no image assets or temporal noise.
use 'look.jo'

paint_ramp = (ndl: f32, aa: f32 = 0.015) -> f32:
    edge = max(0.018,aa)
    smoothstep(0.03-edge,0.03+edge,ndl)*0.78+smoothstep(0.62-edge,0.62+edge,ndl)*0.22

# High-albedo plaster has a pale, slightly cool ambient, scaled by the same
# weather/hour light as every other material. Not a colour-key for white paint.
paint_plaster_fill = (sun: vec3, shade: vec3) -> vec3:
    ambient = mix(vec3(dot(shade,vec3(0.22,0.62,0.16))),shade,0.2)
    ambient*0.8+vec3(dot(sun,vec3(0.22,0.62,0.16)))*vec3(0.31,0.33,0.36)

paint_paper = (pixel: vec2) -> f32:
    p = floor(pixel*0.65)
    grain = fract(vec3(p.x,p.y,p.x)*0.1031)
    grain += vec3(dot(grain,grain.yzx+vec3(33.33,33.33,33.33)))
    1.0+(fract((grain.x+grain.y)*grain.z)-0.5)*0.06

# Overlapping crown lobes at varied radii and spacing. Wrapped hashes
# make the 16-cell tile seamless; RGB stores a rounded crown normal, A a wash.
paint_sheet_pixel = (p: vec2) -> vec4:
    cell = floor(p)
    height: f32 = 0.0; normal = vec3(0,1,0)
    loop z in -1..2:
        loop x in -1..2:
            c = cell+vec2(f32(x),f32(z))
            wrapped = c-floor(c/16.0)*16.0
            h = hash21(wrapped+vec2(17,43)); j = hash21(wrapped+vec2(51,7))
            center = c+vec2(0.5,0.5)+(vec2(h,j)-vec2(0.5,0.5))*0.8
            q = (p-center)/(0.48+h*0.5)
            cap = sqrt(max(0.0,1.0-dot(q,q)))
            if cap > height: height = cap; normal = vec3(q.x,cap,q.y)
    wave = sin(p.x*TAU/16.0*3.0+sin(p.y*TAU/16.0*2.0))*0.5+sin((p.x+p.y)*TAU/16.0*5.0)*0.25
    vec4(normal*0.5+vec3(0.5,0.5,0.5),0.5+wave*0.25)

paint_surface_image = () -> Image:
    img = image(256,256)
    loop y in 0..256:
        loop x in 0..256: img.set(x,y,paint_sheet_pixel((vec2(f32(x),f32(y))+vec2(0.5,0.5))/16.0))
    img

paint_tex: Texture
paint_surface = () -> Texture:
    global paint_tex
    if paint_tex.id == 0:
        paint_tex = texture(paint_surface_image(),true)
        set_repeat(paint_tex,true)
    paint_tex
