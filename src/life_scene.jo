use 'crowd_motion.jo'
use 'living_domestic.jo'
use 'living_guard.jo'
use 'living_transaction.jo'
# Scene consumer of semantic life intents. Geometry publication and motion leases are explicit.
use 'living_types.jo'
use 'life_types.jo'
use 'living_life_seed.jo'
use 'living_life.jo'
use 'objects.jo'
use 'settlements.jo'
use 'living_place_context.jo'
import 'cargo_scene.jo' as navigation
import 'map_scene.jo' as paper_maps
import 'far_scene.jo' as far_places
use 'ports_scene.jo'
use 'town_life_scene.jo'

_life_ground = (towns: Town[], p: vec3) -> vec3: vec3(p.x,f32(walk_height(towns,p.x,p.z)),p.z)

_free_spot = (towns: Town[], tw: Town, candidate: vec3, fallback: vec3) -> vec3:
    p = _life_ground(towns,candidate)
    if p.y < 0.5: return fallback
    loop block in tw.blocks:
        if length(p.xz-vec2(block.x,block.y)) < block.z+1.0: return fallback
    p

# Only legacy fallback anchors are replaced. A published town catalog owns its own keys/venues.
configure_life_scene = (w: mut World, towns: Town[], force: bool = false):
    initialize_life(w)
    if settlement_registry_ready and (w.place_catalog_version != SETTLEMENT_VERSION or w.place_contexts.len()!=world_settlements.len()) and world_settlements.len() > 0: publish_settlement_life(w)
    if settlement_registry_ready and w.maps.catalog_version < SETTLEMENT_VERSION and world_settlements.len()>6: paper_maps.publish_settlement_maps(w)
    if not w.far.populated: far_places.configure_far_economy(w)
    if w.far.populated and w.far.harbors.len()==0: far_places.configure_far_harbors(w)
    loop place in 0..min(towns.len(),w.harbors.len()):
        authored = false; configured = false
        loop v in w.life_venues:
            if v.place == place and not v.key.starts_with("legacy:") and not v.key.starts_with("street:"): authored = true
            if v.place == place and v.key.starts_with("legacy:{place}:scene:"): configured = true
        if authored or configured and not force: continue
        tw = towns[place]; out = vec3(tw.out.x,0,tw.out.y); side = vec3(-out.z,0,out.x)
        warehouse = _life_ground(towns,w.cargo_harbors[place].warehouse)
        homes = w.cargo_harbors[place].homes
        if homes.len() == 0: homes = [warehouse]
        supplied: LifeVenue[]
        loop k in 0..homes.len(): supplied.push(LifeVenue(place,"legacy:{place}:scene:home:{k}",.home,homes[k],facing=out,capacity=2,covered=true))
        quay = if w.cargo_harbors[place].loading.len()>0: w.cargo_harbors[place].loading[0]-out*8.0 else: warehouse
        supplied.push(LifeVenue(place,"legacy:{place}:scene:quay",.quay,_life_ground(towns,quay),facing=out,capacity=4))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:market",.market,warehouse,facing=out,capacity=8))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:square",.square,_free_spot(towns,tw,tw.center-out*15.0-side*10.0,warehouse),facing=out,capacity=8))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:cafe",.cafe,_free_spot(towns,tw,tw.center-out*18.0+side*12.0,_free_spot(towns,tw,tw.center-out*15.0-side*10.0,warehouse)),facing=out,capacity=6,covered=true))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:church",.church,homes[3%homes.len()],facing=out,capacity=6,covered=true))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:school",.school,homes[4%homes.len()],facing=out,capacity=4,covered=true))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:workshop",.workshop,homes[1%homes.len()],facing=out,capacity=3))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:shelter",.shelter,homes[0],facing=out,capacity=3,covered=true))
        supplied.push(LifeVenue(place,"legacy:{place}:scene:fields",.fields,_free_spot(towns,tw,warehouse-out*30.0+side*15.0,homes[0]),facing=out,capacity=4))
        set_life_venues(w,place,supplied)
        # Geometry provides height, never a different street/goal or a new actor identity.
        loop person in 1..core_person_count(w):
            if w.people[person].place == place and life_free(w,person): w.people[person].pose.pos = _life_ground(towns,w.people[person].pose.pos)
        loop k in 0..w.households.len():
            if w.households[k].home == place: w.households[k].pose = _life_ground(towns,w.households[k].pose)
    configure_town_fixtures(w,towns)

step_life_scene = (w: mut World, towns: Town[], observer: vec3, dt: f64, nav_budget: int = 1) -> int:
    if towns.len() == 0: return 0
    prepare_port_venues(w,observer)
    prepare_far_fixtures(w,observer)
    paths_started = far_places.step_far_people_scene(w,towns,observer,dt,nav_budget)
    initialize_life(w)
    ids = [1..core_person_count(w))
    loop person in ids:
        if not (person in w.daily_life):
            living_fault("life_scene.missing_intent",guard_context(w)+" person={person}")
            w.daily_life[person] = DailyIntent(person,w.people[person].place,target=w.people[person].pose.pos,last_tick=w.tick)
            continue
        intent = w.daily_life[person]; p = w.people[person]
        if intent.companion>=w.people.len() or intent.companion< -1 or intent.waypoint<0 or not finite_living_point(intent.target):
            living_fault("life_scene.invalid_intent",guard_context(w)+" person={person} companion={intent.companion} waypoint={intent.waypoint} target={intent.target}")
            w.daily_life[person].blocked = "The daily walking route needs to be replanned."
            continue
        if not life_free(w,person):
            if intent.scene_owned:
                w.daily_life[person].scene_owned = false
                if p.carriage < 0: w.people[person].move_owner = .abstract_world
            continue
        near = length(p.pose.pos-observer) < (if intent.scene_owned: 360.0 else: 300.0)
        if not near:
            if intent.scene_owned:
                w.daily_life[person].scene_owned = false; w.people[person].move_owner = .abstract_world
                w.daily_life[person].last_tick = w.tick-1
            continue
        if not intent.scene_owned:
            # Complete only the unowned interval before this tick, then lease the current tick.
            advance_life_motion(w,w.tick-1,person)
            w.daily_life[person].scene_owned = true; w.people[person].move_owner = .scene
        w.daily_life[person].last_tick = w.tick
        intent = w.daily_life[person]
        if intent.arrived:
            if intent.companion >= 0 and w.people[intent.companion].place == p.place:
                delta = w.people[intent.companion].pose.pos-p.pose.pos
                if length(delta)>0.1: w.people[person].pose.rot = facing(delta)
            continue
        if intent.blocked != "": continue
        if intent.routed_revision != intent.path_revision:
            if paths_started >= nav_budget: continue
            paths_started += 1
            path = navigation.cargo_walk_path(towns,w.people[person].pose.pos,intent.target)
            w.daily_life[person].routed_revision = intent.path_revision
            if path.len() == 0:
                w.daily_life[person].blocked = "The walking route is obstructed."
                w.daily_life[person].route.clear(); w.daily_life[person].waypoint = 0
                continue
            w.daily_life[person].route = path; w.daily_life[person].waypoint = 1
        intent = w.daily_life[person]
        if intent.waypoint >= intent.route.len(): w.daily_life[person].arrived = true; continue
        delta = intent.route[intent.waypoint].xz-w.people[person].pose.pos.xz
        distance = f64(length(delta))
        if distance < 0.10:
            w.daily_life[person].waypoint += 1
            if w.daily_life[person].waypoint >= intent.route.len(): w.daily_life[person].arrived = true
            continue
        speed = if intent.mobility == .bicycle: 3.4 else: 1.25
        moved = crowd_walk(w,towns,person,delta*f32(min(1.0,speed*dt/distance)))
        if length(moved.xz-w.people[person].pose.pos.xz) < 0.0001:
            w.daily_life[person].blocked = "The walking route is obstructed."
            continue
        w.people[person].pose.rot = facing(vec3(delta.x,0,delta.y))
        w.people[person].pose.pos = moved
        if intent.meeting >= 0 and intent.companion >= 0:
            other = w.people[intent.companion].pose.pos-moved
            if length(other)>0.1: w.people[person].pose.rot = facing(other)
    loop k in 0..w.households.len():
        p = w.households[k]
        near = length(p.pose-observer)<(if p.scene_owned: 360.0 else: 300.0)
        if not near:
            if p.scene_owned: w.households[k].scene_owned = false; w.households[k].last_tick = w.tick-1
            continue
        if not p.scene_owned: advance_household_motion(w,k,w.tick-1)
        w.households[k].scene_owned = true; w.households[k].last_tick = w.tick
        p = w.households[k]
        if p.blocked: continue
        if p.routed_revision != p.path_revision:
            if paths_started >= nav_budget: continue
            paths_started += 1
            path = navigation.cargo_walk_path(towns,p.pose,p.target)
            w.households[k].routed_revision = p.path_revision
            w.households[k].route = path; w.households[k].waypoint = if path.len()>0: 1 else: 0
            if path.len()==0: w.households[k].blocked = true; continue
        p = w.households[k]
        if p.waypoint >= p.route.len(): continue
        delta = p.route[p.waypoint].xz-p.pose.xz; distance = f64(length(delta))
        if distance<0.10: w.households[k].waypoint += 1; continue
        moved = walk_step(towns,p.pose,delta*f32(min(1.0,1.1*dt/distance)))
        w.households[k].pose = moved
        if length(moved.xz-p.pose.xz)<0.0001: w.households[k].blocked = true

    separate_life_people(w,towns,observer,dt)
    paths_started

# Resolve actual leased poses, including newly materialized and idle people.
# Rendering and save folding therefore see the same separated positions.
separate_life_people = (w: mut World,towns: Town[],observer: vec3,dt: f64):
    ids: int[]
    loop p in w.people:
        if p.occupation==.player or person_vehicle_bound(w,p.id) or length(p.pose.pos-observer)>360:continue
        if p.id in w.far.people:
            if not w.far.people[p.id].scene_owned:continue
        else:
            if not (p.id in w.daily_life) or not w.daily_life[p.id].scene_owned or not w.daily_life[p.id].arrived:continue
        if active_domestic(w,p.id)!=none:continue
        ids.push(p.id)
    loop iteration in 0..4:
        loop a in 0..ids.len():
            loop b in a+1..ids.len():
                i=ids[a];j=ids[b]
                p=w.people[i].pose.pos;q=w.people[j].pose.pos
                if abs(p.y-q.y)>1.0:continue
                delta=p.xz-q.xz;distance=f64(length(delta))
                if distance>=0.65:continue
                direction=if distance>0.001:delta/f32(distance) else:vec2(1,0)
                push=direction*f32(min((0.65-distance)*0.51,max(0.0,dt)*0.25))
                w.people[i].pose.pos=walk_step(towns,p,push)
                w.people[j].pose.pos=walk_step(towns,q,-push)

fold_life_for_save = (w: mut World):
    far_places.fold_far_people(w)
    ids = w.daily_life.keys()
    loop person in ids:
        if not w.daily_life[person].scene_owned: continue
        w.daily_life[person].scene_owned = false; w.daily_life[person].last_tick = w.tick
        if w.people[person].carriage < 0: w.people[person].move_owner = .abstract_world
    loop k in 0..w.households.len():
        w.households[k].scene_owned = false; w.households[k].last_tick = w.tick

# Called after init_world_towns. Inlands get venues and country context, never fake aircraft docks.
_guarded_publish_settlement_life = (w: mut World):
    contexts: LifePlaceContext[]; capitals = [-1,-1,-1]
    loop s in world_settlements:
        venues: LifeVenue[]
        loop landmark in place_landmarks(s):
            kind: VenueKind? = match landmark.kind:
                "square": VenueKind.square
                "cafe": VenueKind.cafe
                "church", "cloister": VenueKind.church
                "olive terrace": VenueKind.fields
                "farmhouse": VenueKind.home
                "warehouse": VenueKind.market
                _: none
            if kind != none: venues.push(LifeVenue(s.id,"registry:{s.id}:{landmark.kind}:{venues.len()}",kind!,landmark.at,capacity=if s.kind == .capital: 16 else: 6,covered=kind == .cafe or kind == .church or kind == .home))
        contexts.push(LifePlaceContext(s.id,s.name,s.country,s.region,s.center,s.harbor.len()>0,s.legacy,s.neighbors,venues))
        if s.kind == .capital and (capitals[s.country] < 0 or s.id < capitals[s.country]): capitals[s.country] = s.id
    if not (publish_place_contexts(w,SETTLEMENT_VERSION,contexts,capitals)):
        living_fault("life_scene.publish_settlement_life.0",guard_context(w))
        return
    paper_maps.publish_settlement_maps(w)


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
publish_settlement_life = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_publish_settlement_life(w)
    guard_finish(w,scope)
