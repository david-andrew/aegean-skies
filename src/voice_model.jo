# The announcer's prosody model: phone durations, intonation shapes, microprosody, vocal effort,
# fricative caps and pauses. The fitted numbers live in the announcer data file (read from the
# AEGEAN_VOICE_DATA path, kept outside the repository until a final voice is approved; written by
# tools/voice_world/pack.py from tools/voice_world/prosody_fit.py). The defaults below are neutral
# placeholders, generic and not measured from any speaker, so that the code is complete without it.

const VOICE_PHONE_COUNT = 44         # 39 ARPAbet phones + pause + 4 reduced vowels (AX IX AXR IYX)
const VOICE_DURATION_FACTORS = 9     # see voice_phone_durations
const VOICE_ACCENT_POINTS = 13
const VOICE_TUNE_FEATURES = 43       # see voice_syllable_features

struct VoiceModel:
    measured = false                 # true when the numbers came from a data file
    # Median-like duration (ms) per phone at the reference rate, before the factors.
    duration_ms: f64[] = [0.0, 90,90,65,90,130,120,75,90,95,65,85,95,140,65,90, 55,75,50,45,60,50,55,70,65,65,60,60,70,60,60,70,75,55,55,50,65,60,60,55, 55,55,65,70]
    # function word, word-final, word-initial, consonant cluster, 2 syllables, 3+ syllables,
    # phrase-final vowel, phrase-final consonant, stressed full vowel (multipliers)
    duration_factors: f64[] = [0.8,1.1,1.15,0.9,0.95,0.9,1.3,1.05,1.1]
    # d log duration / d log speaking rate: stressed vowel, unstressed vowel, onset, coda
    elasticity: f64[] = [-0.6,-0.8,-0.4,-0.35]
    reference_rate = 5.5             # syllables per second within phrases
    # Fricative caps (ms): anywhere, word-final, phrase-final; VOICE_PHONE_COUNT each (0: none).
    fricative_cap_ms: f64[]
    # Phrase arc over normalised time (10 points), for a phrase ending in a full stop and others.
    arc_stop: f64[] = [0.5,0.6,0.5,0.3,0.2,0.0,-0.2,-0.4,-0.8,-1.5]
    arc_other: f64[] = [0.3,0.4,0.3,0.2,0.1,0.0,0.0,0.1,0.2,0.3]
    # Accent shapes (st) by lag from the stressed vowel's onset: first, middle, nuclear accent.
    accent_first: f64[] = [0,0,0,-0.3,0.5,1.5,1.5,1.0,0.5,0.2,0,0,0]
    accent_middle: f64[] = [0,0,0,-0.3,0.4,1.2,1.2,0.8,0.4,0.1,0,0,0]
    accent_nuclear: f64[] = [0,0,0,-0.3,0.4,1.2,0.6,0.0,-0.5,-0.6,-0.5,-0.4,-0.3]
    accent_lag0 = -0.2               # seconds of the first lag point
    accent_lag_step = 0.05
    # st inside voiced obstruents; at vowel onsets after voiceless / voiced obstruents.
    micro: f64[] = [-1.0,0.0,0.0]
    level_st = 7.0                   # phrase level, semitones re 100 Hz
    level_spread = 1.5               # spread of phrase levels (interquartile, st)
    level_index: f64[] = [0.0,0.0,0.0]   # by phrase position in its sentence
    effort: f64[]                    # mel-cepstral change per semitone of raised voice
    pause_comma = 0.15               # seconds at the reference rate
    pause_stop = 0.45
    pause_breath = 0.15
    # How the fitted shapes are rendered: widening around each phrase level, the soft limit (st)
    # around the register, and the voicing fraction above which a frame is voiced.
    shape_gain = 1.6
    pitch_limit = 7.0
    voicing = 0.5
    # Each genre's delivery fitted to a speaker (speed, pitch st, range, pause scale), by the genre
    # VoiceStyle.genre names; a genre without one keeps the station's hand-set style.
    styles: {str: f64[]}
    # Sentence intonation and energy learned from a speaker (tools/voice_world/intonation.py): per
    # syllable, weights on VOICE_TUNE_FEATURES features for the pitch level (st re the line), its
    # slope through the vowel (st/s) and its energy (log power re the line, after the vowel's own
    # intrinsic level, tune_intrinsic per phone). Empty: the superposition model above.
    tune_pitch: f64[]
    tune_slope: f64[]
    tune_energy: f64[]
    tune_intrinsic: f64[]
    # Each genre's vocal effort as the speaker's own spectral change (mel-cepstrum, c1 up) against
    # their plain reading, added to voiced frames.
    tilts: {str: f64[]}
    # Sustain: a voiced frame stays within this much (log power) of its line's vowel level, so
    # voicing carries through between sounds as the speaker's does (fitted by synthesis).
    sustain = 9.0
    # A line's intended energy (VoiceStyle.energy) against its genre's usual one (energy_refs, the
    # mean energy of the speaker's takes of it): per step, pitch (st), log range, log speed and tilt
    # (dB/octave), measured from the speaker's takes at each energy.
    energy_effect: f64[]
    energy_refs: {str: f64}

# Copy one named list from the data file into the model; unknown names are ignored.
voice_model_set = (m: mut VoiceModel, name: str, v: f64[]):
    if name == "duration_ms" and v.len() == VOICE_PHONE_COUNT: m.duration_ms = v
    else if name == "duration_factors" and v.len() == VOICE_DURATION_FACTORS: m.duration_factors = v
    else if name == "elasticity" and v.len() == 4: m.elasticity = v
    else if name == "reference_rate" and v.len() == 1: m.reference_rate = v[0]
    else if name == "fricative_cap_ms" and v.len() == 3*VOICE_PHONE_COUNT: m.fricative_cap_ms = v
    else if name == "arc_stop" and v.len() == 10: m.arc_stop = v
    else if name == "arc_other" and v.len() == 10: m.arc_other = v
    else if name == "accent_first" and v.len() == VOICE_ACCENT_POINTS: m.accent_first = v
    else if name == "accent_middle" and v.len() == VOICE_ACCENT_POINTS: m.accent_middle = v
    else if name == "accent_nuclear" and v.len() == VOICE_ACCENT_POINTS: m.accent_nuclear = v
    else if name == "accent_lags" and v.len() == 2: m.accent_lag0 = v[0]; m.accent_lag_step = v[1]
    else if name == "micro" and v.len() == 3: m.micro = v
    else if name == "level" and v.len() == 5:
        m.level_st = v[0]; m.level_spread = v[1]; m.level_index = [v[2],v[3],v[4]]
    else if name == "effort": m.effort = v
    else if name == "pauses" and v.len() == 3:
        m.pause_comma = v[0]; m.pause_stop = v[1]; m.pause_breath = v[2]
    else if name == "shape" and v.len() == 3:
        m.shape_gain = v[0]; m.pitch_limit = v[1]; m.voicing = v[2]
    else if name.starts_with("style_") and v.len() == 4: m.styles[name[6..name.len()]] = v
    else if name.starts_with("tilt_"): m.tilts[name[5..name.len()]] = v
    else if name == "sustain" and v.len() == 1: m.sustain = v[0]
    else if name == "energy_effect" and v.len() == 4: m.energy_effect = v
    else if name.starts_with("energy_ref_") and v.len() == 1: m.energy_refs[name[11..name.len()]] = v[0]
    else if name == "tune_pitch" and v.len() == VOICE_TUNE_FEATURES: m.tune_pitch = v
    else if name == "tune_slope" and v.len() == VOICE_TUNE_FEATURES: m.tune_slope = v
    else if name == "tune_energy" and v.len() == VOICE_TUNE_FEATURES: m.tune_energy = v
    else if name == "tune_intrinsic" and v.len() == VOICE_PHONE_COUNT: m.tune_intrinsic = v

# Linear interpolation in a table at a fractional index (clamped).
voice_table = (t: f64[], x: f64) -> f64:
    if t.len() == 0: return 0.0
    u = clamp(x,0.0,f64(t.len()-1))
    i = min(int(u),t.len()-2)
    if i < 0: return t[0]
    t[i]+(t[i+1]-t[i])*(u-f64(i))
