# Prosody constants for the announcer. Neutral placeholder values (generic, not measured from
# any speaker); the fitted numbers are kept outside the repository until a final voice is approved.

const VOICE_SYLLABLES_PER_SECOND = 5.5
const VOICE_F0_MEDIAN = 150.0
const VOICE_F0_LOW = 110.0
const VOICE_F0_HIGH = 200.0
const VOICE_PHRASE_START = 7.0
const VOICE_PHRASE_SPREAD = 1.5
const VOICE_DECLINATION = -0.5
const VOICE_ACCENT = 2.0
const VOICE_ACCENT_SPREAD = 1.0
const VOICE_ACCENT_PEAK = 0.5
const VOICE_FINAL_FALL = -2.0
const VOICE_CONTINUATION = 0.5
const VOICE_PAUSE_COMMA = 0.15
const VOICE_PAUSE_STOP = 0.45
const VOICE_FINAL_LENGTHENING = 1.15

