use 'geography.jo'
use 'lake_data.jo'
# Bounded, lazy bank vegetation. Tree and reed candidates follow the same contour
# field as physical water; wetland patches leave beaches and rocky banks open.
use 'lake_field.jo'
use 'river_banks.jo'
use 'world_source.jo'
use 'settlements.jo'
use 'objects.jo'
use 'look.jo'
use 'render_space.jo'
use 'quality.jo'
use 'world_point.jo'
struct LakeBankBatch:
    id:int= -1
    tier:int= -1
    center:vec3
    trees:Mesh=Mesh()
    reeds:Mesh=Mesh()
lake_bank_batches:LakeBankBatch[]=[LakeBankBatch(),LakeBankBatch(),LakeBankBatch(),LakeBankBatch()]

build_lake_bank=(id:int,old:LakeBankBatch)->LakeBankBatch:
    lake=SETTLEMENT_LAKES[id];center=vec3(lake.center.x,0,lake.center.y)
    trees:Vertex3D[];reeds:Vertex3D[]
    # The same candidates exist on all tiers; low omits alternate trees and reed
    # stalks, not entire stretches of bank or every plant near a town.
    loop j in 1..lake.nz-1:
        loop i in 1..lake.nx-1:
            seed=place_hash(lake.id,i+j*lake.nx)
            p=lake.origin+(vec2(f32(i),f32(j))+vec2(f32(seed%100)/200.0,f32((seed/100)%100)/200.0))*f32(lake.step)
            depth=lake_depth(lake,f64(p.x),f64(p.y))
            if depth< -2.8 or depth>0.6:continue
            patch=noise(f64(p.x)*0.009,f64(p.y)*0.009)
            if patch<0.04:continue
            if settlement_urban(p) or settlement_on_road(p):continue
            h=world_source_surface(f64(p.x),f64(p.y));at=vec3(p.x-center.x,f32(h),p.y-center.z)
            if depth< -0.3 and h>lake.level+0.2 and i%2==0 and j%2==0 and seed%3!=0:
                if render_quality.tier>0 or seed%2==0:river_tree(trees,at,if seed%4==0:1 else:0,f64(seed%100),false)
            if depth> -0.14 and h<lake.level+0.3 and seed%2==0:
                loop k in 0..(if render_quality.tier==0:3 else:7):
                    delta=vec3(sin(f64(seed+k)*1.7)*2.4,0,cos(f64(seed+k)*2.3)*2.4)
                    height=1.3+f64((seed+k)%9)*0.11
                    add_cylinder(reeds,at+delta,0.045,height,rgb(0.32,0.39,0.17),3,0.009)
                    if k%3==0:add_cylinder(reeds,at+delta+vec3(0,f32(height-0.2),0),0.07,0.23,rgb(0.32,0.22,0.12),3,0.065)
    batch=old;batch.id=id;batch.tier=render_quality.tier;batch.center=center
    if batch.trees.vao==0:batch.trees=mesh(trees)
    else:update_mesh(batch.trees,trees)
    if batch.reeds.vao==0:batch.reeds=mesh(reeds)
    else:update_mesh(batch.reeds,reeds)
    batch

draw_lake_banks=(L:Light,t:f64):
    global lake_bank_batches
    if not geography_enabled:return
    cam=scene_camera();generated=false
    loop slot in 0..lake_bank_batches.len():
        if lake_bank_batches[slot].id>=0 and length(cam.xz-lake_bank_batches[slot].center.xz)>6500:lake_bank_batches[slot].id= -1
    loop id in 0..SETTLEMENT_LAKES.len():
        if length(cam.xz-SETTLEMENT_LAKES[id].center)>5500:continue
        slot= -1
        loop k in 0..lake_bank_batches.len():
            if lake_bank_batches[k].id==id:slot=k;break
        if slot<0:
            loop k in 0..lake_bank_batches.len():
                if lake_bank_batches[k].id<0:slot=k;break
        if slot<0:continue
        batch=lake_bank_batches[slot]
        if batch.id!=id or batch.tier!=render_quality.tier:
            if generated:continue
            batch=build_lake_bank(id,batch);lake_bank_batches[slot]=batch;generated=true
        p=obj_params(L,t,anchor=world_point(batch.center))
        if batch.trees.count>0:draw(river_bank_far_sh,batch.trees,p)
        if length(cam.xz-batch.center.xz)<2400 and batch.reeds.count>0:draw(obj_sh,batch.reeds,p)
