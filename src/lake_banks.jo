use 'geography.jo'
use 'lake_data.jo'
# Bounded, lazy bank vegetation. Tree and reed candidates follow the same contour
# field as physical water; wetland patches leave beaches and rocky banks open.
use 'lake_field.jo'
use 'lake_channels.jo'
use 'lake_channels_data.jo'
use 'river_banks.jo'
use 'world_source.jo'
use 'settlements.jo'
use 'objects.jo'
use 'look.jo'
use 'render_space.jo'
use 'quality.jo'
use 'world_point.jo'
struct LakeBankBatch:
    id:int= -1
    tier:int= -1
    center:vec3
    trees:InstanceBuffer[RiverBankInstance][]
    reeds:Mesh=Mesh()
lake_bank_batches:LakeBankBatch[]=[LakeBankBatch(),LakeBankBatch(),LakeBankBatch(),LakeBankBatch()]

build_lake_bank=(id:int,old:LakeBankBatch)->LakeBankBatch:
    lake=SETTLEMENT_LAKES[id];center=vec3(lake.center.x,0,lake.center.y)
    trees:RiverBankInstance[][]=[[],[]];reeds:Vertex3D[]
    # The same candidates exist on all tiers; low omits alternate trees and reed
    # stalks, not entire stretches of bank or every plant near a town.
    loop j in 1..lake.nz-1:
        loop i in 1..lake.nx-1:
            seed=place_hash(lake.id,i+j*lake.nx)
            p=lake.origin+(vec2(f32(i),f32(j))+vec2(f32(seed%100)/200.0,f32((seed/100)%100)/200.0))*f32(lake.step)
            depth=lake_depth(lake,f64(p.x),f64(p.y))
            if depth< -2.8 or depth>0.6:continue
            patch=noise(f64(p.x)*0.009,f64(p.y)*0.009)
            if patch<0.04:continue
            if settlement_urban(p) or settlement_on_road(p):continue
            h=world_source_surface(f64(p.x),f64(p.y));at=vec3(p.x-center.x,f32(h),p.y-center.z)
            # Stands of plane and poplar in places along the shore, read from the
            # air as dark clumps; open grassy or pebbly banks between them.
            stand=noise(f64(p.x)*0.0055+3.1,f64(p.y)*0.0055-1.7)
            # The town's waterfront is open to the lake: no grove screens it.
            frontage=f64(length(p-lake.shore))<260.0 or f64(length(p-lake.town.xz))<320.0
            if depth< -0.3 and h>lake.level+0.2 and not frontage:
                count=if stand>0.22:(if seed%3==0:2 else:1) else:(if i%2==0 and j%2==0 and seed%3!=0:1 else:0)
                loop n in 0..count:
                    if render_quality.tier==0 and (seed+n)%2==1:continue
                    kind=if (seed+n)%4==0:1 else:0
                    phase=f64((seed+n*37)%100)
                    offset=vec3(f32(sin(f64(seed+n)*2.1))*5.0,0,f32(cos(f64(seed+n)*1.3))*5.0)
                    q=at+offset;q.y=f32(world_source_surface(f64(q.x+center.x),f64(q.z+center.z)))
                    if lake_depth(lake,f64(q.x+center.x),f64(q.z+center.z))> -0.3:continue
                    trees[kind].push(RiverBankInstance(q,vec4(cos(phase),sin(phase),f32(kind),1)))
            if depth> -0.14 and h<lake.level+0.3 and (seed%2==0 or patch>0.35):
                loop k in 0..(if render_quality.tier==0:4 else:9):
                    delta=vec3(sin(f64(seed+k)*1.7)*2.4,0,cos(f64(seed+k)*2.3)*2.4)
                    height=1.3+f64((seed+k)%9)*0.11
                    add_cylinder(reeds,at+delta,0.045,height,rgb(0.32,0.39,0.17),3,0.009)
                    if k%3==0:add_cylinder(reeds,at+delta+vec3(0,f32(height-0.2),0),0.07,0.23,rgb(0.32,0.22,0.12),3,0.065)
    # The inflow and outflow streams are lined with trees, so their courses
    # read across the fields from the air.
    loop channel in LAKE_CHANNELS:
        if channel.id!=lake.id:continue
        d=channel.b.xy-channel.a.xy;span=f64(length(d))
        if span<1.0:continue
        dir=d/f32(span);side=vec2(-dir.y,dir.x)
        loop k in 0..int(span/9.0)+1:
            seed=place_hash(lake.id+7,int(channel.a.x)+k*131)
            if seed%5==0:continue
            loop sign in [-1.0,1.0]:
                if render_quality.tier==0 and (seed+int(sign))%2==0:continue
                q=channel.a.xy+dir*f32(f64(k)*9.0+f64(seed%5))+side*f32(sign*(f64(channel.a.w)*LAKE_STREAM_WIDTH+3.0+f64(seed%4)))
                if lake_depth(lake,f64(q.x),f64(q.y))> -0.3 or lake_channel_at(f64(q.x),f64(q.y)).wet:continue
                at=vec3(q.x-center.x,f32(world_source_surface(f64(q.x),f64(q.y))),q.y-center.z)
                kind=if seed%3==0:1 else:0
                phase=f64(seed%100)
                trees[kind].push(RiverBankInstance(at,vec4(cos(phase),sin(phase),f32(kind),1)))
    batch=old;batch.id=id;batch.tier=render_quality.tier;batch.center=center
    if batch.trees.len()==0:
        batch.trees=[loop kind in 0..2:instance_buffer(trees[kind])]
    else:
        loop kind in 0..2:set_instances(batch.trees[kind],trees[kind])
    if batch.reeds.vao==0:batch.reeds=mesh(reeds)
    else:update_mesh(batch.reeds,reeds)
    batch

draw_lake_banks=(L:Light,t:f64):
    global lake_bank_batches
    if not geography_enabled:return
    cam=scene_camera();generated=false
    loop slot in 0..lake_bank_batches.len():
        if lake_bank_batches[slot].id>=0 and length(cam.xz-lake_bank_batches[slot].center.xz)>6500:lake_bank_batches[slot].id= -1
    loop id in 0..SETTLEMENT_LAKES.len():
        if length(cam.xz-SETTLEMENT_LAKES[id].center)>5500:continue
        slot= -1
        loop k in 0..lake_bank_batches.len():
            if lake_bank_batches[k].id==id:slot=k;break
        if slot<0:
            loop k in 0..lake_bank_batches.len():
                if lake_bank_batches[k].id<0:slot=k;break
        if slot<0:continue
        batch=lake_bank_batches[slot]
        if batch.id!=id or batch.tier!=render_quality.tier:
            if generated:continue
            batch=build_lake_bank(id,batch);lake_bank_batches[slot]=batch;generated=true
        p=obj_params(L,t,anchor=world_point(batch.center))
        # Shared river vegetation uses an instanced vertex shader. Keep only
        # positions and crown phases here, never duplicate tree vertices.
        loop kind in 0..batch.trees.len():
            if batch.trees[kind].count>0:draw_instanced(river_bank_far_sh,river_bank_far[kind],batch.trees[kind],p)
        if length(cam.xz-batch.center.xz)<2400 and batch.reeds.count>0:draw(obj_sh,batch.reeds,p)
