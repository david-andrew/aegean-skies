# A harbour's shelter for the sea (sea.jo: sea_harbour, sea_calm). A harbour is where the quays,
# the mole and the land keep the open sea out and leave a wind no fetch to raise one: the water
# among its docks only laps. Each frame the harbour nearest the eye gives the sea its basin: the
# middle a little way off its docks, calm out past the docks, the buoy and the mole's end, and the
# open sea's full state again some 450 m further out (so a seaplane still alights on the true sea
# outside and taxies in to quiet water). The drawn sea and swell_at read the same basin.
use 'settlements.jo'
use 'geography.jo'
use 'sea.jo'

const HARBOUR_SHELTER_FADE = 450.0  # from the basin's edge out to the open sea's full state, m

# the basin of a settlement's sea harbour (none for a lake port or a place without docks)
harbour_basin = (s: WorldSettlement) -> SeaHarbour:
    if s.harbor.len() == 0 or abs(f64(s.harbor[0].at.y)) > 0.5: return SeaHarbour()
    mid = vec2(0,0)
    loop d in s.harbor: mid += d.at.xz
    mid = mid/f32(s.harbor.len())+s.out*60.0
    reach = 0.0
    loop d in s.harbor:
        reach = max(reach,f64(length(d.at.xz-mid)))
        reach = max(reach,f64(length(d.buoy.xz-mid)))
    # (the mole runs 75 m out from the quay's end, 175 m at a capital: settlement_ports.jo)
    inner = reach+(if s.kind == .capital: 200.0 else: 110.0)
    SeaHarbour(f64(mid.x),f64(mid.y),inner,inner+HARBOUR_SHELTER_FADE)

# the basin whose shelter reaches a point, the nearest if several do (none: outer 0)
harbour_shelter_at = (p: vec2) -> SeaHarbour:
    best = SeaHarbour(); near = 1e18
    seen: int[]
    loop corner in [vec2(-900,-900),vec2(900,-900),vec2(-900,900),vec2(900,900)]:
        bin = geography_bin(f64(p.x+corner.x),f64(p.y+corner.y))
        if bin in seen: continue
        seen.push(bin)
        loop index in settlement_bins.get(bin,[]):
            s = world_settlements[index]
            if s.harbor.len() == 0 or f64(length(s.harbor[0].at.xz-p)) > 2500.0: continue
            h = harbour_basin(s)
            if h.outer <= 0.0: continue
            d = sqrt((f64(p.x)-h.x)*(f64(p.x)-h.x)+(f64(p.y)-h.z)*(f64(p.y)-h.z))
            if d < h.outer and d < near: near = d; best = h
    best

# Each frame, for the eye: looked up again only when it has moved 40 m.
_shelter_from = vec2(1e18,1e18)
harbour_shelter_step = (eye: vec3):
    global _shelter_from
    if length(eye.xz-_shelter_from) < 40.0: return
    _shelter_from = eye.xz
    set_sea_harbour(harbour_shelter_at(eye.xz))
