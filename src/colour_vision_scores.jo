# The scores the colour presets are held to (tests/colour_vision_test.jo) and reported by
# (tools/colour_vision_report.jo), in one place so the test and the report cannot disagree.
# docs/accessibility.md says what each is, where its threshold comes from and how to run them.
use 'colour_vision.jo'
use 'side_colours.jo'

# What lies behind a mark, measured on captures of the game in fair weather and over an overcast
# (AEGEAN_CAPTURE_SIDES, then `tools/colour_vision_view.jo <capture> sample x y`): the sea near
# and far, the sky high, low and at the horizon, cloud lit, in shade and in shadow, the sky over
# a cloud deck.
struct Ground:
    name: str
    colour: vec4

GROUNDS = [Ground("deep sea", rgba(0.07, 0.23, 0.38, 1)), Ground("far sea", rgba(0.19, 0.36, 0.49, 1)), Ground("high sky", rgba(0.22, 0.56, 0.64, 1)),
    Ground("low sky", rgba(0.31, 0.63, 0.70, 1)), Ground("horizon", rgba(0.47, 0.60, 0.65, 1)), Ground("lit cloud", rgba(0.90, 0.82, 0.68, 1)),
    Ground("cloud shade", rgba(0.75, 0.72, 0.65, 1)), Ground("sky over cloud", rgba(0.28, 0.41, 0.47, 1)), Ground("cloud in shadow", rgba(0.44, 0.44, 0.44, 1))]

# The war chart's grounds, measured on a capture of the Kalamos channel chart: its paper, its
# sea, its land light and dark.
CHART_GROUNDS = [Ground("paper", rgba(0.93, 0.88, 0.76, 1)), Ground("chart sea", rgba(0.51, 0.64, 0.70, 1)),
    Ground("land", rgba(0.54, 0.56, 0.37, 1)), Ground("dark land", rgba(0.46, 0.50, 0.33, 1))]

# The thresholds (docs/accessibility.md, "The thresholds").
const SIDES_APART = 20.0            # between two sides: CIEDE2000, and CAM02-UCS (Petroff 2021's minimum)
const LIGHTNESS_APART = 5.0         # between two sides with no colour: CAM02-UCS lightness (Petroff 2021)
const MARK_OFF_GROUND = 15.0        # a mark against what is behind it: CIEDE2000, by its colour or its halo
const MARK_CONTRAST = 3.0           # a mark against what is behind it: WCAG 2.2 SC 1.4.11
const NAME_CONTRAST = 4.5           # a name against its ground: WCAG 2.2 SC 1.4.3

palette_sides = (p: SidePalette) -> vec4[]: [p.enemy, p.ally, p.neutral]
SIDE_NAMES = ["enemy", "friend", "other"]

# A score and where it is weakest.
struct Score:
    value = 0.0
    at = ""

_least = (s: Score, value: f64, at: str) -> Score: if value < s.value: Score(value, at) else: s

# The least CIEDE2000 between two of the palette's sides, as an eye sees them.
sides_2000 = (p: SidePalette, e: Eye) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        loop j in i + 1..3: out = _least(out, seen_2000(c[i], c[j], e), "{SIDE_NAMES[i]}/{SIDE_NAMES[j]}")
    out

# The least CAM02-UCS distance between two of its sides.
sides_ucs = (p: SidePalette, e: Eye) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        loop j in i + 1..3: out = _least(out, seen_ucs(c[i], c[j], e), "{SIDE_NAMES[i]}/{SIDE_NAMES[j]}")
    out

# The least difference in lightness (CAM02-UCS J') between two of its sides.
sides_lightness = (p: SidePalette, e: Eye) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        loop j in i + 1..3: out = _least(out, seen_lightness(c[i], c[j], e), "{SIDE_NAMES[i]}/{SIDE_NAMES[j]}")
    out

# A mark as it is drawn at its usual strength (asked for at 0.9) on a ground: its line's colour
# and its halo's, each laid over the ground.
_drawn = (p: SidePalette, c: vec4, ground: vec4) -> (vec4, vec4):
    strength = if p.firm: 1.0 else: 0.9
    line = vec4(c.x, c.y, c.z, f32(strength))
    (colour_over(line, ground), colour_over(palette_halo(p, line), ground))

# The least CIEDE2000 between a side's colour alone and a ground.
colour_off_ground = (p: SidePalette, e: Eye, grounds: Ground[] = GROUNDS) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        loop g in grounds: out = _least(out, seen_2000(_drawn(p, c[i], g.colour).0, g.colour, e), "{SIDE_NAMES[i]} on {g.name}")
    out

# The least a mark stands off a ground in CIEDE2000: by its line, or else by its halo with the
# line standing off the halo.
mark_off_ground = (p: SidePalette, e: Eye, grounds: Ground[] = GROUNDS) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        loop g in grounds:
            d = _drawn(p, c[i], g.colour)
            by_line = seen_2000(d.0, g.colour, e)
            by_halo = min(seen_2000(d.1, g.colour, e), seen_2000(d.0, d.1, e))
            out = _least(out, max(by_line, by_halo), "{SIDE_NAMES[i]} on {g.name}")
    out

# The least contrast ratio a mark keeps with a ground (WCAG 1.4.11): its line's, or else its
# halo's with the line's against the halo.
mark_contrast = (p: SidePalette, e: Eye, grounds: Ground[] = GROUNDS) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        loop g in grounds:
            d = _drawn(p, c[i], g.colour)
            by_line = seen_contrast(d.0, g.colour, e)
            by_halo = min(seen_contrast(d.1, g.colour, e), seen_contrast(d.0, d.1, e))
            out = _least(out, max(by_line, by_halo), "{SIDE_NAMES[i]} on {g.name}")
    out

# The least contrast between a mark's two tones, whatever is behind: 9:1 guarantees 3:1 with
# one or the other against any ground at all.
tones_contrast = (p: SidePalette, e: Eye) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        ink = palette_halo(p, c[i])
        out = _least(out, seen_contrast(c[i], vec4(ink.x, ink.y, ink.z, 1.0), e), SIDE_NAMES[i])
    out

# The least contrast a side's name has (WCAG 1.4.3). In a firm palette the name's outline is wide
# enough to be its ground, whatever lies behind; otherwise the outline is narrow, which WCAG
# counts as part of the letter, so the name is taken as the better of its fill and its outline
# against each ground.
name_contrast = (p: SidePalette, e: Eye, grounds: Ground[] = GROUNDS) -> Score:
    c = palette_sides(p)
    out = Score(1e9)
    loop i in 0..3:
        ink = palette_halo(p, c[i])
        if p.firm:
            out = _least(out, seen_contrast(c[i], vec4(ink.x, ink.y, ink.z, 1.0), e), SIDE_NAMES[i])
            continue
        loop g in grounds:
            fill = colour_over(vec4(c[i].x, c[i].y, c[i].z, 0.9), g.colour)
            edge = colour_over(vec4(ink.x, ink.y, ink.z, 0.81), g.colour)
            out = _least(out, max(seen_contrast(fill, g.colour, e), seen_contrast(edge, g.colour, e)), "{SIDE_NAMES[i]} on {g.name}")
    out

# The eyes a preset is for: every model of each.
preset_eyes = (v: ColourVision) -> Eye[]:
    match v:
        .standard: [Eye()]
        .red_green: [Eye(.protan, .machado), Eye(.protan, .brettel), Eye(.deutan, .machado), Eye(.deutan, .brettel)]
        .blue_yellow: [Eye(.tritan, .machado), Eye(.tritan, .brettel)]
        .monochrome: [Eye(.achromat, .machado)]

# The chart's three country inks in a preset, and the least CIEDE2000 between two of them and
# between one and a ground of the chart.
chart_inks = (v: ColourVision) -> vec4[]: [country_ink_for(v, 1), country_ink_for(v, 2), country_ink_for(v, 0)]
INK_NAMES = ["ink 1", "ink 2", "other ink"]

inks_2000 = (inks: vec4[], e: Eye) -> Score:
    out = Score(1e9)
    loop i in 0..3:
        loop j in i + 1..3: out = _least(out, seen_2000(inks[i], inks[j], e), "{INK_NAMES[i]}/{INK_NAMES[j]}")
    out

inks_off_ground = (inks: vec4[], e: Eye, ground: Ground) -> Score:
    out = Score(1e9)
    loop i in 0..3: out = _least(out, seen_2000(inks[i], ground.colour, e), "{INK_NAMES[i]} on {ground.name}")
    out
