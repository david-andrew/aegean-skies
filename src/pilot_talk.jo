# The pilot's small talk (the option "Your pilot makes small talk", on by default): when someone
# passes a remark to him (the one sat with him, someone in the street), he sometimes answers on his
# own, briefly, from what he has actually done: the deeds the world knows (src/reputation.jo), and
# the day's doings the scene notes (a flight and its weather, tavli, a swim, a catch). Never about
# plans or what comes next: that is the player's to decide. One detail at most, the rest
# understood, as people talk. Pure: the scene says what was said and when; this chooses words.
use 'living_types.jo'
use 'life_types.jo'
use 'reputation_types.jo'
use 'reputation.jo'
use 'pilot_day_types.jo'
use 'errand_words.jo'

const DOINGS_KEPT = 16

# Notes a doing (the newest last; the oldest go).
pilot_did = (doings: mut Doing[], d: Doing):
    doings.push(d)
    if doings.len() > DOINGS_KEPT: doings.remove_at(0)

# Plain words about the hour something happened: "this morning", "earlier", "last night".
_when = (w: World, minute: int) -> str:
    if day_index(minute) != day_index(w.minute):
        return if local_minute(minute) >= 18*60: "last night" else: "yesterday"
    h = local_minute(minute)/60
    now_h = local_minute(w.minute)/60
    if h < 12 and now_h >= 12: return "this morning"
    if w.minute-minute < 90: return "just now"
    "earlier"

_place_word = (n: int) -> str:
    words = ["","first","second","third","fourth","fifth","sixth","seventh","eighth"]
    if n > 0 and n < words.len(): words[n] else: "{n}th"

_first_of = (w: World, p: int) -> str: if p >= 0 and p < w.people.len(): split(w.people[p].name," ")[0] else: "them"

_pick = (lines: str[], seq: int) -> str: if lines.len() == 0: "" else: lines[((seq%lines.len())+lines.len())%lines.len()]

# His answer to a remark about one of his deeds: modest, short.
pilot_on_deed = (d: RepDeed, seq: int) -> str:
    storm = d.storm >= 600
    lines = match d.kind:
        .rescued_foe, .rescued_friend, .rescued_survivors: if storm: ["Wet, mostly.","Wasn't much choice.","I was wetter than he was."] else: ["Anyone would have.","He'd have done the same.","Wasn't much to it."]
        .shot_down: ["It was him or me.","I'd rather not talk about it."]
        .flew_home_in_formation: ["We all got back. That's what counts.","Nobody left behind."]
        .left_the_fight: ["Mm.","It wasn't like that."]
        .found_boat: ["Glad they're home.","Anyone would have gone looking."]
        .raced: if d.rank == 1: ["The machine did the work.","Lucky with the wind."] else: ["The others were quicker.","It was a good race."]
        .job_done: ["Only a few crates.","It was on the way."]
        .job_late: ["The weather had other ideas.","Mm. It got there."]
        .job_failed: ["Not my finest.","Mm."]
        .debt_paid: ["Fair's fair.","A debt's a debt."]
        .debt_defaulted: ["Mm."]
        else: []
    _pick(lines,seq)

# The newest flight today, if any.
_last_flight = (w: World, doings: Doing[]) -> Doing?:
    loop i in 0..doings.len():
        d = doings[doings.len()-1-i]
        if d.kind == .flew and d.minute <= w.minute and w.minute-d.minute < 12*60: return d
    none

# His answer about the weather: the air on his last flight, or the day as it is down here.
pilot_on_weather = (w: World, doings: Doing[], rain_here: bool, wind_here: f64, seq: int) -> str:
    if let f = _last_flight(w,doings):
        lines = if f.rough >= 3: ["Got caught in it out there. Wet.","Rough as anything up there.","Saw the worst of it from the air."] else: if f.rough == 2: ["Bumpy up there {_when(w,f.minute)}.","Lumpy over the water.","The air was all over the place."] else: if f.rough == 1: ["A bit of a breeze up there.","Bit of a crosswind coming in."] else: ["Smooth enough up there.","Like glass, {_when(w,f.minute)}.","Not a bump all the way."]
        return _pick(lines,seq)
    lines = if rain_here: ["Wet enough down here.","Not flying weather."] else: if wind_here >= 9.0: ["Blowing a bit.","Lively out there."] else: ["Nice enough.","Can't complain.","Fine day for it."]
    _pick(lines,seq)

# The deed of his the world remembers from today, if any (a delivery, a rescue, a fight).
_todays_deed = (w: World) -> RepDeed?:
    best: RepDeed? = none
    loop d in w.rep.deeds:
        if rep_small(d.kind) or w.minute-d.minute > 12*60 or w.minute < d.minute: continue
        if best == none or d.minute >= best!.minute: best = d
    best

# His answer about his day: one thing he did today, or nothing much.
pilot_on_day = (w: World, doings: Doing[], seq: int) -> str:
    # (what the world knows he did, if it was today and is newer than what the scene noted)
    newest = -1
    loop i in 0..doings.len():
        d = doings[doings.len()-1-i]
        if d.minute <= w.minute and w.minute-d.minute < 12*60 and d.kind != .flew: newest = doings.len()-1-i; break
    if let deed = _todays_deed(w):
        if newest < 0 or deed.minute >= doings[newest].minute:
            if deed.kind == .job_done and deed.job >= 0:
                if let e = errand_of(w,deed.job): return _pick(errand_day(w,e,_when(w,deed.minute)),seq)
            at = _when(w,deed.minute)
            lines = match deed.kind:
                .found_boat: ["Found {_first_of(w,deed.other)} off {rep_town_name(w,deed.near)}.","Went looking for a boat {at}. Found it."]
                .raced: if deed.rank == 1: ["Won the race at {rep_town_name(w,deed.town)}.","Raced {at}. Won, as it happens."] else: if deed.rank > 0: ["Raced at {rep_town_name(w,deed.town)}. Came {_place_word(deed.rank)}.","Raced {at}. Not last."] else: ["Raced at {rep_town_name(w,deed.town)}. Didn't finish.","Raced {at}. Let's not talk about it."]
                .job_done: ["Took a load across {at}.","Busy. Freight, mostly."]
                .job_late: ["Long one. Ran late with a load.","Busy, and behind."]
                .job_failed: ["Not a good one.","Could've gone better."]
                .rescued_foe, .rescued_friend, .rescued_survivors: ["Pulled a fellow out of the water {at}.","Long day. Wet one."]
                .shot_down: ["Long day.","Busy. I'd rather not say."]
                .flew_home_in_formation: ["Long day. We all got back.","Busy. Tired."]
                .debt_paid: ["Settled up with someone {at}. Feels good.","Quiet. Squared a debt."]
                else: ["Can't complain."]
            return _pick(lines,seq)
    if newest >= 0:
        d = doings[newest]; at = _when(w,d.minute)
        lines = match d.kind:
            .tavli_won: if d.who != "": ["Beat {d.who} at tavli {at}.","Won at tavli, for once."] else: ["Won at tavli, for once."]
            .tavli_lost: ["Lost at tavli. Again.","Tavli. Don't ask."]
            .swam: ["Had a swim {at}.","Went in off the dock. Cold."]
            .fished: ["Caught fish off the dock.","Fished a while {at}."]
            .sold_catch: ["Sold a few fish {at}.","Fish, mostly."]
            .shave: ["Had a shave.","Got the moustache seen to."]
            .stars: ["Lay out under the stars a while.","Quiet. Watched the stars."]
            .ride: if d.who != "": ["Took {d.who} up {at}.","Gave {d.who} a spin round the island."] else: ["Took someone up for a spin."]
            .rescued, .set_ashore: ["Pulled someone out of the water {at}.","Wet one."]
            .battle: ["Long day.","Saw a fight out there. Rather not talk about it."]
            .flew: ["Flew a bit."]
        return _pick(lines,seq)
    if let f = _last_flight(w,doings):
        return _pick(if f.where != "": ["Flew over from {f.where}.","Been flying."] else: ["Been flying.","Up and down all day."],seq)
    _pick(["Quiet one.","Can't complain.","Same as ever."],seq)

# How rough a flight's air was, from the weather met on it (storm and rain 0..1, wind m/s).
flight_rough = (storm: f64, rain: f64, wind: f64) -> int:
    if storm >= 0.5: 3 else: if storm >= 0.15 or wind >= 14.0: 2 else: if wind >= 8.0 or rain >= 0.3: 1 else: 0
