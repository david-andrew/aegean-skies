# Someone the scene holds where they stand: the person the pilot is talking with. The scene's
# walkers (src/life_scene.jo's daily walkers, src/far_scene.jo's far people, src/cargo_scene.jo's
# porters) keep their movement
# lease on a held person and do not step them: their saved plan (the day's intent, its route and
# where along it they are) is untouched, so let go they walk on from where they stood. Held, a
# person standing turns to face whoever they are talking with. Nothing here is saved: a save
# folds the leases as ever, with the person's actual pose.
use 'living_types.jo'

scene_held = -1                     # the person held (-1: nobody)
scene_held_toward = vec3(0, 0, 0)   # whom they are talking with: where they turn to
scene_held_turns = true             # (false: seated or at a fixture, which faces them its own way)

scene_hold = (person: int, toward: vec3, turns: bool = true):
    global scene_held, scene_held_toward, scene_held_turns
    scene_held = person; scene_held_toward = toward; scene_held_turns = turns

scene_release = ():
    global scene_held
    scene_held = -1

# Someone with somewhere to be, talking as they go: the walkers keep them walking, at a talking
# pace, a little under their own, so the pilot can walk alongside.
const SCENE_TALK_PACE = 0.8
scene_paced = -1
scene_walk_with = (person: int):
    global scene_paced
    scene_paced = person
scene_walk_free = ():
    global scene_paced
    scene_paced = -1
scene_pace = (person: int) -> f64: if person >= 0 and person == scene_paced: SCENE_TALK_PACE else: 1.0

scene_holds = (person: int) -> bool: person >= 0 and person == scene_held

# Someone walking the pilot to a door or landmark: non-saved scene state, so their saved daily
# intent stays untouched and resumes once guiding ends or is cancelled.
struct SceneGuide:
    person = -1
    target: vec3 = vec3(0, 0, 0)
    route: vec3[] = []
    waypoint = 0
    arrived = false
    best_d = 1e9
    stall_t = 0.0

scene_guide = SceneGuide()

scene_guide_start = (person: int, target: vec3, route: vec3[]):
    global scene_guide
    scene_guide = SceneGuide(person, target, route, if route.len() > 1: 1 else: 0, route.len() == 0, 1e9, 0.0)

scene_guide_stop = ():
    global scene_guide
    scene_guide = SceneGuide()

scene_guiding = (person: int) -> bool: person >= 0 and scene_guide.person == person and not scene_guide.arrived
scene_guide_arrived = (person: int) -> bool: person >= 0 and scene_guide.person == person and scene_guide.arrived

# The way a pose faces, as an angle about the vertical (the way the townsfolk are drawn).
pose_yaw = (pose: Pose) -> f64:
    nose = quat_rotate(pose.rot, vec3(0, 0, -1))
    atan2(f64(nose.x), f64(nose.z))

# A held person's frame: no step, a turn toward `scene_held_toward` at an easy rate.
scene_hold_step = (w: mut World, person: int, dt: f64):
    if not scene_held_turns: return
    to = scene_held_toward - w.people[person].pose.pos
    if length(to.xz) < 0.3: return
    yaw = approach_angle(pose_yaw(w.people[person].pose), atan2(f64(to.x), f64(to.z)), 7.0, dt)
    w.people[person].pose.rot = facing(vec3(f32(sin(yaw)), 0, f32(cos(yaw))))
