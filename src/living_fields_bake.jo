# Offline land register. Unique physical cells, never a food-order-created area.
use 'settlements.jo'
use 'living_far_types.jo'

use 'living_field_land.jo'

field_arable_cell = (center: vec2,places: WorldSettlement[]) -> bool:
    # Keep whole fields outside towns/working yards; low, dry, gentle canonical ground.
    loop s in places:
        if length(s.center.xz-center)<f32(s.radius+710): return false
    low=1000000.0; high= -1000000.0
    loop z in 0..5:
        previous=0.0
        loop x in 0..5:
            at=center+vec2(f32(x*250-500),f32(z*250-500)); h=place_ground(at)
            if h<2.0 or h>300.0: return false
            low=min(low,h); high=max(high,h)
            if x>0 and abs(h-previous)>30.0: return false
            if z>0 and abs(h-place_ground(at-vec2(0,250)))>30.0: return false
            previous=h
    high-low<=100.0

bake_field_land = (seeds: mut FarPlaceSeed[],places: WorldSettlement[]) -> int:
    candidates: {int: (f64,int)}
    loop s in places:
        x=int(floor(f64(s.center.x)/f64(FIELD_CELL_METRES))); z=int(floor(f64(s.center.z)/f64(FIELD_CELL_METRES)))
        loop dz in -6..7:
            loop dx in -6..7:
                gx=x+dx; gz=z+dz
                if gx< -512 or gx>=512 or gz< -512 or gz>=512: continue
                id=field_cell_id(gx,gz); distance=f64(length(field_cell_center(id)-s.center.xz))
                if distance>6000: continue
                old=candidates.get(id,(1000000000.0,2147483647))
                if distance<old.0 or (distance==old.0 and s.id<old.1): candidates[id]=(distance,s.id)
    # Prefer each owner's nearest cells; cells are globally unique before any allocation.
    ranked: (f64,int,int)[]
    loop id, owner in candidates: ranked.push((owner.0,id,owner.1))
    ranked.sort()
    index: {int: int}
    loop k in 0..seeds.len(): index[seeds[k].id]=k
    total=0
    loop item in ranked:
        k=index[item.2]
        if seeds[k].fields.len()>=FIELD_PARCELS_PER_PLACE: continue
        center=field_cell_center(item.1)
        if not field_arable_cell(center,places): continue
        seeds[k].fields.push(FarFieldLand(item.1,place_point(center),FIELD_CELL_METRES,FIELD_CELL_METRES*FIELD_CELL_METRES/100)); total+=1
    loop k in 0..seeds.len(): seeds[k].fields.sort((f: FarFieldLand): f.id)
    eprint("FIELD_BAKE parcels={total} area_hectares={total*100} places_with_land={[loop s in seeds: if s.fields.len()>0: s.id].len()} capitals={[loop s in seeds: if s.id==10001 or s.id==10003: (s.id,s.fields.len())]}")
    total
