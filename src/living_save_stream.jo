# canonical_text(w), written a few milliseconds at a time for a game's save. The template
# is the canonical World with its largest containers cut to their first element; those
# are then written element by element (save_stream.jo). Byte for byte the same text as
# canonical_text (tests/living_save_stream.jo checks it on real worlds).
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_map_types.jo'
use 'life_types.jo'
use 'living_save.jo'
use 'save_stream.jo'

_int_keys[V] = (m: {int: V}) -> int[]:
    keys=m.keys(); keys.sort((id: int): id); keys

_str_keys[V] = (m: {str: V}) -> str[]:
    keys=m.keys(); keys.sort((key: str): key); keys

_first_map[K,V] = (m: {K: V}, keys: K[]) -> {K: V}:
    result: {K: V}
    if keys.len()>0: result[keys[0]]=m[keys[0]]
    result

_first_array[T] = (xs: T[]) -> T[]: if xs.len()>0: [xs[0]] else: []

# The template and its parts, made in three short calls (world_text_build_step) so no
# frame does the whole template. `stream` is ready once the build is done.
struct WorldTextBuild:
    world: World
    stage = 0
    canonical: World
    template = ""
    stream: TextStream
    done = false

world_text_build = (w: World) -> WorldTextBuild: WorldTextBuild(world=w,canonical=w)

world_text_build_step = (b: mut WorldTextBuild) -> bool:
    if b.done: return true
    w=b.world
    if b.stage==0:
        t=w
        t.far.districts=_first_map(w.far.districts,_int_keys(w.far.districts)); t.far.journeys=_first_map(w.far.journeys,_int_keys(w.far.journeys))
        t.far.news=_first_map(w.far.news,_int_keys(w.far.news)); t.far.harbors=_first_map(w.far.harbors,_int_keys(w.far.harbors))
        t.far.vehicles=_first_array(w.far.vehicles); t.far.links=_first_array(w.far.links)
        t.cargo_sources=_first_map(w.cargo_sources,_int_keys(w.cargo_sources)); t.place_contexts=_first_map(w.place_contexts,_int_keys(w.place_contexts))
        t.cargo_source_keys=_first_map(w.cargo_source_keys,_str_keys(w.cargo_source_keys)); t.obligations=_first_map(w.obligations,_int_keys(w.obligations))
        t.maps.editions=_first_map(w.maps.editions,_str_keys(w.maps.editions)); t.maps.features=_first_map(w.maps.features,_str_keys(w.maps.features))
        t.ledger.recent=_first_array(w.ledger.recent); t.people=_first_array(w.people); t.accounts=_first_array(w.accounts)
        t.life_venues=_first_array(w.life_venues); t.relationships=_first_array(w.relationships)
        b.canonical=canonical_world(t); b.stage=1
        return false
    if b.stage==1:
        b.template=to_text(b.canonical); b.stage=2
        return false
    c=b.canonical
    parts: TextPart[]
    if w.far.districts.len()>0: parts.push(map_text_part(to_text(c.far.districts),w.far.districts,_int_keys(w.far.districts),canonical_far_district))
    if w.far.journeys.len()>0: parts.push(map_text_part(to_text(c.far.journeys),w.far.journeys,_int_keys(w.far.journeys),(x: FarJourney) -> FarJourney: x))
    if w.far.news.len()>0: parts.push(map_text_part(to_text(c.far.news),w.far.news,_int_keys(w.far.news),(x: FarNews) -> FarNews: x))
    if w.far.harbors.len()>0: parts.push(map_text_part(to_text(c.far.harbors),w.far.harbors,_int_keys(w.far.harbors),(x: FarHarbor) -> FarHarbor: x))
    if w.far.vehicles.len()>0: parts.push(array_text_part(to_text(c.far.vehicles),w.far.vehicles,canonical_far_vehicle))
    if w.far.links.len()>0: parts.push(array_text_part(to_text(c.far.links),w.far.links,(x: FarLink) -> FarLink: x))
    if w.cargo_sources.len()>0: parts.push(map_text_part(to_text(c.cargo_sources),w.cargo_sources,_int_keys(w.cargo_sources),(x: CargoSource) -> CargoSource: x))
    if w.place_contexts.len()>0: parts.push(map_text_part(to_text(c.place_contexts),w.place_contexts,_int_keys(w.place_contexts),(x: LifePlaceContext) -> LifePlaceContext: x))
    if w.cargo_source_keys.len()>0: parts.push(map_text_part(to_text(c.cargo_source_keys),w.cargo_source_keys,_str_keys(w.cargo_source_keys),(x: int) -> int: x))
    if w.obligations.len()>0: parts.push(map_text_part(to_text(c.obligations),w.obligations,_int_keys(w.obligations),(x: Obligation) -> Obligation: x))
    if w.maps.editions.len()>0: parts.push(map_text_part(to_text(c.maps.editions),w.maps.editions,_str_keys(w.maps.editions),canonical_map_edition))
    if w.maps.features.len()>0: parts.push(map_text_part(to_text(c.maps.features),w.maps.features,_str_keys(w.maps.features),(x: MapFeature) -> MapFeature: x))
    if w.ledger.recent.len()>0: parts.push(array_text_part(to_text(c.ledger.recent),w.ledger.recent,(x: MoneyEntry) -> MoneyEntry: x))
    if w.people.len()>0: parts.push(array_text_part(to_text(c.people),w.people,(x: Person) -> Person: x))
    if w.accounts.len()>0: parts.push(array_text_part(to_text(c.accounts),w.accounts,(x: Account) -> Account: x))
    if w.life_venues.len()>0: parts.push(array_text_part(to_text(c.life_venues),w.life_venues,(x: LifeVenue) -> LifeVenue: x))
    if w.relationships.len()>0: parts.push(array_text_part(to_text(c.relationships),w.relationships,(x: Relationship) -> Relationship: x))
    b.stream=text_stream(b.template,parts,18000000)
    b.canonical=World(); b.template=""; b.done=true
    true

# All at once (tests and tools): the same stream world_text_build_step makes.
world_text_stream = (w: World) -> TextStream:
    b=world_text_build(w)
    loop not world_text_build_step(b): pass
    b.stream
