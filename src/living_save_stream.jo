# canonical_text(w), written a few milliseconds at a time for a game's save. The template
# is the canonical World with its largest containers cut to their first element; those
# are then written element by element (save_stream.jo). Byte for byte the same text as
# canonical_text (tests/living_save_stream.jo checks it on real worlds).
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_map_types.jo'
use 'life_types.jo'
use 'living_save.jo'
use 'save_stream.jo'

_int_keys[V] = (m: {int: V}) -> int[]:
    keys=m.keys(); keys.sort((id: int): id); keys

_str_keys[V] = (m: {str: V}) -> str[]:
    keys=m.keys(); keys.sort((key: str): key); keys

_first_map[K,V] = (m: {K: V}, keys: K[]) -> {K: V}:
    result: {K: V}
    if keys.len()>0: result[keys[0]]=m[keys[0]]
    result

_first_array[T] = (xs: T[]) -> T[]: if xs.len()>0: [xs[0]] else: []

# The template and its parts, made in short steps (world_text_build_step) so no frame does
# much of the template: one step per large container (its keys sorted once, cut to one
# element in the template), one to make the template canonical, one to write it, one per
# container to write its marker. `stream` is ready once the build is done.
const WORLD_TEXT_PARTS = 17
struct WorldTextBuild:
    world: World
    stage = 0
    cut: World                    # the World with its large containers cut to one element
    ikeys: int[][]                # each container's keys in written order (int-keyed maps)
    skeys: str[][]                # (str-keyed maps)
    canonical: World
    template = ""
    parts: TextPart[]
    stream: TextStream
    done = false

# The text buffer is reserved once, at the size the last save's text had (at least 18 MB), so
# a save does not grow it through a chain of doublings: in a browser each new large block
# grows the page's memory, which can bring a full garbage collection with it mid-game.
_world_text_last = 18000000
world_text_reserve = () -> int: _world_text_last+_world_text_last/10
note_world_text_size = (bytes: int):
    global _world_text_last
    _world_text_last = max(_world_text_last,bytes)

world_text_build = (w: World) -> WorldTextBuild:
    WorldTextBuild(world=w,cut=w,canonical=w,ikeys=[loop _ in 0..WORLD_TEXT_PARTS: []],skeys=[loop _ in 0..WORLD_TEXT_PARTS: []])

# Container i: sort its keys and cut it in the template World.
_cut_part = (b: mut WorldTextBuild, i: int):
    w=b.world
    if i==0: b.ikeys[i]=_int_keys(w.far.districts); b.cut.far.districts=_first_map(w.far.districts,b.ikeys[i])
    else if i==1: b.ikeys[i]=_int_keys(w.far.journeys); b.cut.far.journeys=_first_map(w.far.journeys,b.ikeys[i])
    else if i==2: b.ikeys[i]=_int_keys(w.far.news); b.cut.far.news=_first_map(w.far.news,b.ikeys[i])
    else if i==3: b.ikeys[i]=_int_keys(w.far.harbors); b.cut.far.harbors=_first_map(w.far.harbors,b.ikeys[i])
    else if i==4: b.cut.far.vehicles=_first_array(w.far.vehicles)
    else if i==5: b.cut.far.links=_first_array(w.far.links)
    else if i==6: b.ikeys[i]=_int_keys(w.cargo_sources); b.cut.cargo_sources=_first_map(w.cargo_sources,b.ikeys[i])
    else if i==7: b.ikeys[i]=_int_keys(w.place_contexts); b.cut.place_contexts=_first_map(w.place_contexts,b.ikeys[i])
    else if i==8: b.skeys[i]=_str_keys(w.cargo_source_keys); b.cut.cargo_source_keys=_first_map(w.cargo_source_keys,b.skeys[i])
    else if i==9: b.ikeys[i]=_int_keys(w.obligations); b.cut.obligations=_first_map(w.obligations,b.ikeys[i])
    else if i==10: b.skeys[i]=_str_keys(w.maps.editions); b.cut.maps.editions=_first_map(w.maps.editions,b.skeys[i])
    else if i==11: b.skeys[i]=_str_keys(w.maps.features); b.cut.maps.features=_first_map(w.maps.features,b.skeys[i])
    else if i==12: b.cut.ledger.recent=_first_array(w.ledger.recent)
    else if i==13: b.cut.people=_first_array(w.people)
    else if i==14: b.cut.accounts=_first_array(w.accounts)
    else if i==15: b.cut.life_venues=_first_array(w.life_venues)
    else: b.cut.relationships=_first_array(w.relationships)

# Container i's part: its one-element text in the canonical template, and its full pieces.
_text_part = (b: WorldTextBuild, i: int) -> TextPart?:
    w=b.world; c=b.canonical
    if i==0: return if w.far.districts.len()>0: map_text_part(to_text(c.far.districts),w.far.districts,b.ikeys[i],canonical_far_district) else: none
    if i==1: return if w.far.journeys.len()>0: map_text_part(to_text(c.far.journeys),w.far.journeys,b.ikeys[i],(x: FarJourney) -> FarJourney: x) else: none
    if i==2: return if w.far.news.len()>0: map_text_part(to_text(c.far.news),w.far.news,b.ikeys[i],(x: FarNews) -> FarNews: x) else: none
    if i==3: return if w.far.harbors.len()>0: map_text_part(to_text(c.far.harbors),w.far.harbors,b.ikeys[i],(x: FarHarbor) -> FarHarbor: x) else: none
    if i==4: return if w.far.vehicles.len()>0: array_text_part(to_text(c.far.vehicles),w.far.vehicles,canonical_far_vehicle) else: none
    if i==5: return if w.far.links.len()>0: array_text_part(to_text(c.far.links),w.far.links,(x: FarLink) -> FarLink: x) else: none
    if i==6: return if w.cargo_sources.len()>0: map_text_part(to_text(c.cargo_sources),w.cargo_sources,b.ikeys[i],(x: CargoSource) -> CargoSource: x) else: none
    if i==7: return if w.place_contexts.len()>0: map_text_part(to_text(c.place_contexts),w.place_contexts,b.ikeys[i],(x: LifePlaceContext) -> LifePlaceContext: x) else: none
    if i==8: return if w.cargo_source_keys.len()>0: map_text_part(to_text(c.cargo_source_keys),w.cargo_source_keys,b.skeys[i],(x: int) -> int: x) else: none
    if i==9: return if w.obligations.len()>0: map_text_part(to_text(c.obligations),w.obligations,b.ikeys[i],(x: Obligation) -> Obligation: x) else: none
    if i==10: return if w.maps.editions.len()>0: map_text_part(to_text(c.maps.editions),w.maps.editions,b.skeys[i],canonical_map_edition) else: none
    if i==11: return if w.maps.features.len()>0: map_text_part(to_text(c.maps.features),w.maps.features,b.skeys[i],(x: MapFeature) -> MapFeature: x) else: none
    if i==12: return if w.ledger.recent.len()>0: array_text_part(to_text(c.ledger.recent),w.ledger.recent,(x: MoneyEntry) -> MoneyEntry: x) else: none
    if i==13: return if w.people.len()>0: array_text_part(to_text(c.people),w.people,(x: Person) -> Person: x) else: none
    if i==14: return if w.accounts.len()>0: array_text_part(to_text(c.accounts),w.accounts,(x: Account) -> Account: x) else: none
    if i==15: return if w.life_venues.len()>0: array_text_part(to_text(c.life_venues),w.life_venues,(x: LifeVenue) -> LifeVenue: x) else: none
    if w.relationships.len()>0: array_text_part(to_text(c.relationships),w.relationships,(x: Relationship) -> Relationship: x) else: none

world_text_build_step = (b: mut WorldTextBuild) -> bool:
    if b.done: return true
    k=b.stage; b.stage+=1
    if k<WORLD_TEXT_PARTS: _cut_part(b,k); return false
    if k==WORLD_TEXT_PARTS: b.canonical=canonical_world(b.cut); b.cut=World(); return false
    if k==WORLD_TEXT_PARTS+1: b.template=to_text(b.canonical); return false
    i=k-WORLD_TEXT_PARTS-2
    if i<WORLD_TEXT_PARTS:
        if let part=_text_part(b,i): b.parts.push(part)
        return false
    b.stream=text_stream(b.template,b.parts,world_text_reserve())
    b.canonical=World(); b.template=""; b.parts=[]; b.done=true
    true

# All at once (tests and tools): the same stream world_text_build_step makes.
world_text_stream = (w: World) -> TextStream:
    b=world_text_build(w)
    loop not world_text_build_step(b): pass
    b.stream
