use 'depth_space.jo'
use 'world_point.jo'
# The aircraft, as low-poly meshes built from parts: lofted fuselages, hulls and floats, wings
# with struts, the engine and its propeller (a separate mesh that turns). Flat-shaded, colored by
# a livery. The frame: forward is -z, right +x, up +y, in meters, the origin near the center of
# gravity. Contact points (where floats or hull meet the water) are given for the flight model.

use 'look.jo'
use 'cockpit_cutout.jo'
from 'objects.jo' import obj_sh, obj_params

use 'aircraft_catalog.jo'

enum Craft:
    gull, heron, corsair, falco
    tern, petrel, osprey, swift, pelican, kite, ibis, kestrel, minnow, albatross, cormorant, kingfisher

CRAFT_NAMES = ["Gull", "Heron", "Corsair", "Falco", "Tern", "Petrel", "Osprey", "Swift",
    "Pelican", "Kite", "Ibis", "Kestrel", "Minnow", "Albatross", "Cormorant", "Kingfisher"]

aircraft_profile = (kind: Craft) -> AircraftProfile: AIRCRAFT[int(kind)]
is_boat = (kind: Craft) -> bool: AIRCRAFT[int(kind)].boat

# Catalog-backed model IDs are appended after the original twelve meshes/liveries.
# Do not interpret a saved model_index as a Craft ID.
default_craft_model = (kind: Craft) -> int: if int(kind) < 4: int(kind) else: 12 + int(kind) - 4


struct Livery:
    body: vec4
    trim: vec4
    wing: vec4
    accent: vec4                    # stripes on the rudder, the cowling
    marking: int = 0                # 0 civilian bars, 1 blue/white country, 2 red/cream country

LIVERIES = [
    Livery(rgb(0.93, 0.89, 0.78), rgb(0.12, 0.45, 0.5), rgb(0.9, 0.86, 0.74), rgb(0.78, 0.2, 0.15)),      # cream and teal
    Livery(rgb(0.78, 0.18, 0.12), rgb(0.95, 0.9, 0.8), rgb(0.8, 0.2, 0.14), rgb(0.15, 0.5, 0.3)),         # red
    Livery(rgb(0.15, 0.2, 0.35), rgb(0.85, 0.7, 0.25), rgb(0.18, 0.24, 0.4), rgb(0.9, 0.9, 0.85), 2),     # navy and gold
    Livery(rgb(0.4, 0.42, 0.26), rgb(0.55, 0.38, 0.22), rgb(0.45, 0.46, 0.3), rgb(0.85, 0.75, 0.3)),      # olive (pirates)
    Livery(rgb(0.9, 0.9, 0.88), rgb(0.2, 0.3, 0.6), rgb(0.92, 0.92, 0.9), rgb(0.2, 0.3, 0.6), 1),         # white and blue (police)
    Livery(rgb(0.86, 0.62, 0.22), rgb(0.35, 0.22, 0.14), rgb(0.88, 0.66, 0.26), rgb(0.6, 0.15, 0.12)),    # ochre
]

LIVERY_NAMES = ["Island Post", "Vermilion Racing", "Royal Airmail", "Olive Privateer", "Harbor Patrol", "Ochre Coastal"]

struct CraftModel:
    body: Mesh
    prop: Mesh
    prop_at: vec3                   # the propeller's hub
    contacts: vec3[]                # points on the float or hull bottoms (the flight model's water contacts)
    cockpit: vec3                   # the pilot's head
    exit: vec3                      # where one steps off (onto a float, or the hull's deck)
    shade: vec3[] = []              # flat parts for its shadow on the sea: center, half size, by pairs
    prop_hubs: vec3[] = []           # all hubs; empty keeps the original single prop_at
    cockpits: vec3[] = []            # pilot first, observer/gunner second
    wheels: CraftWheel[] = []       # optional folding beaching gear, attached to the hull
    cockpit_wings: Mesh[] = []
    cockpit_body: Mesh = Mesh()     # clipped first-person fuselage; exterior retains original
    parts: CraftPart[] = []         # stable PartId order; legacy body remains the whole mesh

struct CraftWheel:
    mesh: Mesh
    hinge: vec3
    fold: f64

wheel_frame = (wheel: CraftWheel, extension: f64) -> mat4:
    translation(wheel.hinge)*rotation_z(wheel.fold*(1.0-clamp(extension,0.0,1.0)))

craft_gear_contacts = (kind: Craft) -> vec3[]:
    p = aircraft_profile(kind)
    if not p.amphibian: return []
    y = -p.width*1.3-1.2
    [vec3(-p.width-0.4,y,-1.2),vec3(p.width+0.4,y,-1.2),vec3(0,y,p.length*0.4)]

# Stable indices shared by model, physics, damage and drawing. Left is local -X.
enum PartId: body, engine, left_wing, right_wing, left_float, right_float, tail

struct PartSpec:
    id: PartId
    name: str
    attachment: vec3                # pivot in craft space, axes parallel to the craft
    mass_share: f64
    strength: f64                   # joules of destructive contact work before separation
    buoyancy: f64                   # debris displaced volume / mass, relative to water
    contacts: vec3[]                # original buoyancy contacts, in craft space
    wing_contacts: vec3[]
    strikes: vec3[]                 # hull / engine / tail collision probes

struct CraftPart:
    spec: PartSpec
    mesh: Mesh                     # craft-space vertices: preserves obj_vs flex exactly
    frame: mat4 = mat4()            # mesh -> craft (identity); attachment is the tumble pivot

contact_part = (kind: Craft, p: vec3, wing: bool = false) -> int:
    if wing: return if p.x < 0: int(PartId.left_wing) else: int(PartId.right_wing)
    if int(kind) >= 4 and is_boat(kind) and abs(p.x) < aircraft_profile(kind).width * 1.6: return int(PartId.body)
    if kind == .heron and abs(p.x) < 3: return if p.z >= 3.5: int(PartId.tail) else: int(PartId.body)
    if p.x < 0: int(PartId.left_float) else: int(PartId.right_float)

craft_wing_contacts = (kind: Craft) -> vec3[]:
    if int(kind) >= 4:
        p = aircraft_profile(kind)
        out: vec3[]
        loop level in 0..p.decks:
            span = p.span * (if level == 0: 1.0 else: p.lower_span)
            y = p.wing_y - f64(level) * (if p.decks == 3: 1.25 else: 1.9)
            loop side in [-1.0, 1.0]: out.push(vec3(side * span * 0.5, y, -0.65))
        return out
    match kind:
        .gull: [vec3(-4.7, -0.31, -0.3), vec3(4.7, -0.31, -0.3), vec3(-5.5, 1.55, -0.55), vec3(5.5, 1.55, -0.55)]
        .heron: [vec3(-8.25, 2.3, -1.4), vec3(8.25, 2.3, -1.4)]
        .corsair: [vec3(-4.2, -0.39, -0.4), vec3(4.2, -0.39, -0.4), vec3(-4.8, 1.5, -0.6), vec3(4.8, 1.5, -0.6)]
        .falco: [vec3(-4.6, -0.07, -0.6), vec3(4.6, -0.07, -0.6)]

        _: []

# CPU-only: craft_spec can use the same attachment/contact data without building GPU meshes.
craft_parts = (kind: Craft, contacts: vec3[]) -> PartSpec[]:
    if int(kind) >= 4: return _catalog_parts(kind, contacts)
    scale = if kind == .heron: 3200.0 / 1400.0 else: (if kind == .corsair: 1700.0 / 1400.0 else: (if kind == .falco: 1200.0 / 1400.0 else: 1.0))
    nose = if kind == .heron: vec3(0, 3.35, -2.0) else: (if kind == .falco: vec3(0, 0, -3.5) else: vec3(0, 0, -3.3))
    tail = if kind == .heron: vec3(0, 1.2, 5.6) else: (if kind == .corsair: vec3(0, 0.3, 3.5) else: vec3(0, 0.25, 4.0))
    fx = if kind == .heron: 6.6 else: (if kind == .corsair: 1.45 else: (if kind == .falco: 1.3 else: 1.55))
    fy = if kind == .heron: 1.0 else: -2.0
    wy = if kind == .heron: 2.3 else: 0.5
    ps = [PartSpec(.body, if kind == .heron: "hull" else: "fuselage", vec3(0, 0, 0), 0.42, 100000, 1.15),
          PartSpec(.engine, "engine", nose, 0.18, 45000, 0.15),
          PartSpec(.left_wing, "left wing", vec3(-0.6, wy, -0.6), 0.10, 32000, 2.0),
          PartSpec(.right_wing, "right wing", vec3(0.6, wy, -0.6), 0.10, 32000, 2.0),
          PartSpec(.left_float, "left float", vec3(-fx, fy, -0.4), 0.065, 16000, 2.8),
          PartSpec(.right_float, "right float", vec3(fx, fy, -0.4), 0.065, 16000, 2.8),
          PartSpec(.tail, "tail", tail, 0.07, 22000, 1.6)]
    if kind == .heron:
        ps[0].mass_share = 0.50
        ps[2].mass_share = 0.11; ps[3].mass_share = 0.11
        ps[4].mass_share = 0.015; ps[5].mass_share = 0.015
        ps[4].strength = 6000; ps[5].strength = 6000
    # (sturdier than first set: a firm landing or a touch of the water at speed is not a wreck)
    loop i in 0..ps.len(): ps[i].strength *= scale * 1.5
    loop p in contacts: ps[contact_part(kind, p)].contacts.push(p)
    loop p in craft_wing_contacts(kind): ps[contact_part(kind, p, true)].wing_contacts.push(p)
    ps[0].strikes = if kind == .heron: [vec3(0, 0, -5.6), vec3(-1, -0.5, 0), vec3(1, -0.5, 0), vec3(0, 1, 0)] else: [vec3(-0.55, -0.6, 0), vec3(0.55, -0.6, 0), vec3(0, 0.7, 0)]
    ps[1].strikes = [nose + vec3(0, 0, -0.9), nose + vec3(0, -0.45, 0)]
    ps[6].strikes = [tail + vec3(-1.5, 0, 0), tail + vec3(1.5, 0, 0), tail + vec3(0, 0.7, 0.4)]
    ps

# Copy emitted triangles unchanged into their owner's mesh. No tessellation, added caps or
# vertex translations: the union is byte-for-byte the original colored/normed triangle soup.
_part_range = (bins: mut Vertex3D[][], vs: Vertex3D[], start: int, owner: int, kind: Craft):
    loop tri in start / 3..vs.len() / 3:
        i = tri * 3
        id = owner
        if owner == -1: id = if vs[i].pos.x + vs[i + 1].pos.x + vs[i + 2].pos.x < 0: 2 else: 3
        if owner == 0:
            aft = if kind == .heron: 3.5 else: (if kind == .corsair: 2.4 else: (if kind == .falco: 3.2 else: 2.6))
            if min(vs[i].pos.z, min(vs[i + 1].pos.z, vs[i + 2].pos.z)) >= aft: id = 6
            if kind == .falco and max(vs[i].pos.z, max(vs[i + 1].pos.z, vs[i + 2].pos.z)) <= -2.0: id = 1
        bins[id].extend(vs[i..i + 3])

_finish_craft = (model: CraftModel, bins: Vertex3D[][], kind: Craft) -> CraftModel:
    m = model
    if m.prop_hubs.len() == 0: m.prop_hubs = [m.prop_at]
    if m.cockpits.len() == 0: m.cockpits = [m.cockpit]
    m.cockpit_body=custom_mesh(cockpit_cutout(bins[0],m.cockpit))
    loop wing in [2,3]:
        p=aircraft_profile(kind);side=if wing==2:-1.0 else:1.0
        starts:vec3[];ends:vec3[]
        if kind==.gull:
            starts=[vec3(side*0.35,0.5,-0.9),vec3(side*0.35,0.5,-0.1)]
            ends=[vec3(side*0.5,1.45,-0.9),vec3(side*0.5,1.45,-0.2)]
        if int(kind)>=4 and p.wing_y>p.width:
            starts=[vec3(side*p.width*0.6,p.width,-1.1),vec3(side*p.width*0.6,p.width,-0.2)]
            ends=[vec3(side*0.7,p.wing_y,-1.1),vec3(side*0.7,p.wing_y,-0.2)]
        close=if starts.len()>0:cockpit_cabanes(bins[wing],starts,ends) else:bins[wing]
        # Fine fabric ribs make the overhead plane read as a wing, rather than a flat sky band.
        y=if kind==.gull:1.463 else:if kind==.corsair:1.403 else:p.wing_y-0.10
        z=if kind==.heron:-1.4 else:-0.6
        if p.wing_y>f64(m.cockpit.y)+0.2:
            loop rib in 1..int(p.span/0.9):
                x=f64(rib)*0.45*(if wing==2:-1.0 else:1.0)
                if abs(x)>p.span*0.47:continue
                add_box(close,vec3(x,y,z),vec3(0.012,0.006,p.chord*0.9),rgb(0.56,0.43,0.27))
        m.cockpit_wings.push(custom_mesh(close))
    specs = craft_parts(kind, m.contacts)
    loop i in 0..7: m.parts.push(CraftPart(specs[i], custom_mesh(bins[i])))
    m

# ---------------- flat-shaded parts ----------------

_tri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    vs.push(Vertex3D(a, n, vec2(0, 0), col))
    vs.push(Vertex3D(b, n, vec2(0, 0), col))
    vs.push(Vertex3D(c, n, vec2(0, 0), col))

_quad = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, col: vec4):
    _tri(vs, a, b, c, col)
    _tri(vs, a, c, d, col)

struct Section:
    z: f32                          # along the length (forward is -z)
    w: f32                          # half width
    top: f32                        # above the axis
    bottom: f32                     # below it
    keel: f32 = 0.0                 # a V bottom: how far the keel line drops below the chines

# a body lofted through sections: eight sides (a rounded box), or a boat hull with a V bottom
loft = (vs: mut Vertex3D[], secs: Section[], center: vec3, col: vec4, bottom_col: vec4):
    ring = (s: Section) -> vec3[]:
        w = s.w
        c = center + vec3(0, 0, s.z)
        [c + vec3(0, s.top, 0) + vec3(-w * 0.55, 0, 0), c + vec3(w * 0.55, s.top, 0), c + vec3(w, s.top * 0.45, 0),
         c + vec3(w, -s.bottom * 0.5, 0), c + vec3(w * 0.5, -s.bottom, 0), c + vec3(0, -s.bottom - s.keel, 0),
         c + vec3(-w * 0.5, -s.bottom, 0), c + vec3(-w, -s.bottom * 0.5, 0), c + vec3(-w, s.top * 0.45, 0)]
    loop k in 0..secs.len() - 1:
        a = ring(secs[k])
        b = ring(secs[k + 1])
        m = a.len()
        loop i in 0..m:
            j = (i + 1) % m
            under = i >= 3 and i <= 6
            # (a ring goes round clockwise seen from the front; quads face outward)
            _quad(vs, a[i], b[i], b[j], a[j], if under: bottom_col else: col)
    # caps
    loop e in [0, secs.len() - 1]:
        r = ring(secs[e])
        c = center + vec3(0, 0, secs[e].z)
        loop i in 0..r.len():
            j = (i + 1) % r.len()
            if e == 0: _tri(vs, c, r[i], r[j], col) else: _tri(vs, c, r[j], r[i], col)

# a box from its center and half-sizes, turned by m
_box = (vs: mut Vertex3D[], c: vec3, h: vec3, col: vec4, m: mat4 = mat4()):
    add_box(vs, c, h * 2.0, col, m)

# a wing: a thin box, with a little taper at the tips and a stripe of the trim near them
_wing = (vs: mut Vertex3D[], c: vec3, span: f64, chord: f64, thick: f64, col: vec4, tip: vec4, dihedral: f64 = 0.0):
    half = span * 0.5
    loop side in [-1.0, 1.0]:
        m = translation(c) * rotation_z(side * dihedral)
        # (the panel and its painted tip side by side, not one inside the other: no flicker)
        inner = half - 0.87
        _box(vs, vec3(f32(side * inner * 0.5), 0, 0), vec3(f32(inner * 0.5), f32(thick * 0.5), f32(chord * 0.5)), col, m)
        _box(vs, vec3(f32(side * (half - 0.435)), 0, 0), vec3(0.435, f32(thick * 0.5), f32(chord * 0.5)), tip, m)

# a strut between two points
_strut = (vs: mut Vertex3D[], a: vec3, b: vec3, r: f64, col: vec4):
    d = b - a
    len = f64(length(d))
    m = translation((a + b) * 0.5) * facing(d)
    _box(vs, vec3(0, 0, 0), vec3(f32(r), f32(r), f32(len * 0.5)), col, m)

# a float: pointed bow, a step under the middle, tapering stern
_float = (vs: mut Vertex3D[], c: vec3, len: f64, w: f64, col: vec4, under: vec4):
    l = f32(len)
    hw = f32(w)
    secs = [Section(-l * 0.5, hw * 0.25, hw * 0.35, hw * 0.1), Section(-l * 0.38, hw * 0.9, hw * 0.65, hw * 0.55, hw * 0.2),
            Section(-l * 0.05, hw, hw * 0.7, hw * 0.75, hw * 0.25), Section(l * 0.06, hw, hw * 0.7, hw * 0.75, hw * 0.25),
            Section(l * 0.08, hw * 0.95, hw * 0.68, hw * 0.45, hw * 0.15), Section(l * 0.5, hw * 0.3, hw * 0.45, hw * 0.1)]
    loft(vs, secs, c, col, under)

_engine = (vs: mut Vertex3D[], c: vec3, r: f64, len: f64, cowl: vec4):
    m = translation(c) * rotation_x(PI / 2)
    add_cylinder(vs, vec3(0, f32(-len * 0.5), 0), r, len, cowl, 12, r * 0.92, m)
    # cylinder heads round the cowling's front
    dark = rgb(0.22, 0.2, 0.2)
    add_cylinder(vs, vec3(0, f32(-len * 0.5 - 0.05), 0), r * 0.82, 0.08, dark, 12, -1.0, m)

_spinner = (vs: mut Vertex3D[], c: vec3, r: f64, col: vec4, pusher: bool = false):
    m = translation(c) * rotation_x(if pusher: PI / 2 else: -PI / 2)
    add_cylinder(vs, vec3(0, 0, 0), r, r * 1.6, col, 8, 0.0, m)

build_prop = (radius: f64, blades: int) -> Mesh:
    vs: Vertex3D[]
    wood = rgb(0.45, 0.28, 0.16)
    loop b in 0..blades:
        m = rotation_z(f64(b) / f64(blades) * TAU)
        # (the blade ends inside its painted tip, so no two faces lie in one plane)
        _box(vs, vec3(0, f32(radius * 0.46), 0), vec3(0.09, f32(radius * 0.44), 0.03), wood, m * rotation_y(0.35))
        _box(vs, vec3(0, f32(radius * 0.92), 0), vec3(0.095, f32(radius * 0.08), 0.032), rgb(0.85, 0.8, 0.6), m * rotation_y(0.35))
    custom_mesh(vs)

# A tapered fabric wing with rounded tips, cambered upper faces and a thinner trailing edge.
# Five span stations keep the silhouette legible without a texture or a large triangle budget.
_fabric_wing = (vs: mut Vertex3D[], c: vec3, span: f64, chord: f64, taper: f64, lv: Livery):
    loop side in [-1.0, 1.0]:
        us = [0.0, 0.72, 0.91, 0.98, 1.0]
        widths = [1.0, 0.95, taper, taper * 0.72, taper * 0.35]
        loop i in 0..us.len() - 1:
            x0 = side * us[i] * span * 0.5; x1 = side * us[i + 1] * span * 0.5
            y0 = us[i] * 0.12; y1 = us[i + 1] * 0.12
            z0 = chord * widths[i] * 0.5; z1 = chord * widths[i + 1] * 0.5
            a = c + vec3(x0, y0, -z0); b = c + vec3(x1, y1, -z1)
            d = c + vec3(x0, y0 + 0.11, -z0 * 0.35); e = c + vec3(x1, y1 + 0.11, -z1 * 0.35)
            f = c + vec3(x0, y0 - 0.02, z0); g = c + vec3(x1, y1 - 0.02, z1)
            col = if i >= 2: lv.trim else: lv.wing
            if side > 0:
                _quad(vs, a, d, e, b, col); _quad(vs, d, f, g, e, col); _quad(vs, a, b, g, f, col)
            else:
                _quad(vs, a, b, e, d, col); _quad(vs, d, e, g, f, col); _quad(vs, a, f, g, b, col)
            if i == us.len() - 2:
                if side > 0: _tri(vs, b, e, g, col) else: _tri(vs, b, g, e, col)

_cockpit = (vs: mut Vertex3D[], c: vec3, lv: Livery):
    # A dark well, raised coaming and three-sided windscreen; no transparent sorting needed.
    _box(vs, c, vec3(0.33, 0.025, 0.43), rgb(0.12, 0.11, 0.1))
    loop side in [-1.0, 1.0]:
        _strut(vs, c + vec3(side * 0.35, 0.03, -0.43), c + vec3(side * 0.35, 0.03, 0.43), 0.035, lv.trim)
    _box(vs, c + vec3(0, 0.12, -0.44), vec3(0.3, 0.12, 0.025), rgb(0.63, 0.79, 0.83))
    _strut(vs, c + vec3(-0.35, 0.03, 0.44), c + vec3(0.35, 0.03, 0.44), 0.035, lv.trim)

_gun_ring = (vs: mut Vertex3D[], c: vec3):
    metal = rgb(0.23, 0.25, 0.24)
    loop i in 0..12:
        a = f64(i) * TAU / 12.0; b = f64(i + 1) * TAU / 12.0
        _strut(vs, c + vec3(cos(a) * 0.46, 0, sin(a) * 0.46), c + vec3(cos(b) * 0.46, 0, sin(b) * 0.46), 0.035, metal)
    _strut(vs, c + vec3(0, 0, 0.3), c + vec3(0, 0.25, 0.5), 0.04, metal)
    _strut(vs, c + vec3(0, 0.25, 0.2), c + vec3(0, 0.38, 1.2), 0.035, metal)

# Two country roundels and civilian operator bars; no texture atlas or additional material.
_wing_mark = (vs: mut Vertex3D[], c: vec3, lv: Livery, radius: f64):
    if lv.marking == 0:
        loop dz in [-0.12,0.12]: _box(vs,c+vec3(0,0,dz),vec3(radius,0.008,0.045),lv.accent)
        return
    outer = if lv.marking == 1: rgb(0.14,0.32,0.63) else: rgb(0.72,0.18,0.13)
    colors = [outer,rgb(0.95,0.92,0.8),outer]
    # Annuli share their edges: no coincident colored discs and no z-fighting.
    loop band in 0..3:
        r0 = radius*f64(3-band)/3.0; r1 = radius*f64(2-band)/3.0
        loop j in 0..16:
            a = TAU*f64(j)/16.0; b = TAU*f64(j+1)/16.0
            pa = c+vec3(cos(a)*r0,0,sin(a)*r0); pb = c+vec3(cos(b)*r0,0,sin(b)*r0)
            if band == 2: _tri(vs,c,pb,pa,colors[band])
            else: _quad(vs,pa,c+vec3(cos(a)*r1,0,sin(a)*r1),c+vec3(cos(b)*r1,0,sin(b)*r1),pb,colors[band])

_catalog_hubs = (p: AircraftProfile) -> vec3[]:
    z = p.engine_z + (if p.pusher: 0.65 else: -0.65)
    if p.engine_x > 0: [vec3(-p.engine_x, p.engine_y, z), vec3(p.engine_x, p.engine_y, z)]
    else: [vec3(0, p.engine_y, z)]

catalog_contacts = (kind: Craft) -> vec3[]:
    p = aircraft_profile(kind)
    out: vec3[]
    if p.boat:
        # Wide chines, a keel and an aft step. Tip floats are above the static waterline.
        loop side in [-1.0, 1.0]:
            out.push(vec3(side * p.width * 0.5, -p.width * 1.05, -p.length * 0.25))
            out.push(vec3(side * p.width * 0.5, -p.width * 1.05, p.length * 0.04))
        out.push(vec3(0, -p.width * 1.3, -p.length * 0.36))
        out.push(vec3(0, -p.width * 1.3, p.length * 0.04))
        out.push(vec3(0, -p.width * 0.5, p.length * 0.32))
        loop side in [-1.0, 1.0]: out.push(vec3(side * p.float_x, p.float_y - 0.22, -0.65))
    else:
        loop z in [-p.length * 0.35, -0.35, p.length * 0.29]:
            loop side in [-1.0, 1.0]: out.push(vec3(side * p.float_x, p.float_y - (if z == -0.35: 0.45 else: 0.35), z))
    out

_catalog_parts = (kind: Craft, contacts: vec3[]) -> PartSpec[]:
    p = aircraft_profile(kind)
    tail = vec3(0, if p.boat: p.width * 1.1 else: 0.3, p.length * 0.42)
    ps = [PartSpec(.body, if p.boat: "stepped hull" else: "fuselage", vec3(0, 0, 0), 0.42, 150000, 1.15),
        PartSpec(.engine, if p.engine_x > 0: "engine pair" else: "engine", vec3(0, p.engine_y, p.engine_z), 0.18, 67500, 0.15),
        PartSpec(.left_wing, "left wings", vec3(-p.width, p.wing_y, -0.65), 0.10, 48000, 2.0),
        PartSpec(.right_wing, "right wings", vec3(p.width, p.wing_y, -0.65), 0.10, 48000, 2.0),
        PartSpec(.left_float, "port float", vec3(-p.float_x, p.float_y, -0.35), 0.065, 24000, 2.8),
        PartSpec(.right_float, "starboard float", vec3(p.float_x, p.float_y, -0.35), 0.065, 24000, 2.8),
        PartSpec(.tail, "tail", tail, 0.07, 33000, 1.6)]
    if p.boat:
        ps[0].mass_share = 0.50
        ps[2].mass_share = 0.11; ps[3].mass_share = 0.11
        ps[4].mass_share = 0.015; ps[5].mass_share = 0.015
        ps[4].strength = 9000; ps[5].strength = 9000
    loop i in 0..ps.len(): ps[i].strength *= p.mass / 1400.0
    loop c in contacts: ps[contact_part(kind, c)].contacts.push(c)
    loop c in craft_wing_contacts(kind): ps[contact_part(kind, c, true)].wing_contacts.push(c)
    ps[0].strikes = [vec3(-p.width, 0, 0), vec3(p.width, 0, 0), vec3(0, p.width, -p.length * 0.45)]
    loop hub in _catalog_hubs(p): ps[1].strikes.push(hub)
    ps[6].strikes = [tail + vec3(-p.span * 0.15, 0, 0), tail + vec3(p.span * 0.15, 0, 0), tail + vec3(0, 1.2, 0)]
    ps

_build_catalog_craft = (kind: Craft, lv: Livery) -> CraftModel:
    p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    metal = rgb(0.35, 0.36, 0.34); dark = rgb(0.14, 0.13, 0.12)
    w = f32(p.width); l = f32(p.length)
    # The aft fuselage is explicitly owned by the tail bin; every emitted triangle has one owner.
    if p.boat:
        loft(bins[0], [Section(-l*0.5,w*0.16,w*0.5,w*0.2), Section(-l*0.37,w*0.85,w,w*0.8,w*0.3),
            Section(-l*0.23,w,w,w*0.9,w*0.4), Section(l*0.04,w,w,w*0.9,w*0.4),
            Section(l*0.055,w*0.95,w,w*0.5,w*0.2), Section(l*0.3,w*0.5,w*0.85,w*0.3)], vec3(0,0,0),lv.body,lv.trim)
        loft(bins[6], [Section(l*0.3,w*0.5,w*0.85,w*0.3),Section(l*0.5,w*0.08,w*0.65,w*0.05)],vec3(0,0,0),lv.body,lv.trim)
        if p.engine_x > 0:
            loop side in [-1.0, 1.0]:
                loop j in 0..5: _box(bins[0], vec3(side*p.width*1.005,p.width*0.53,-p.length*0.22+f64(j)*0.9),vec3(0.018,0.23,0.27),rgb(0.2,0.28,0.31))
    else:
        loft(bins[0], [Section(-l*0.45,w*0.7,w*0.75,w*0.75),Section(-l*0.28,w,w,w),
            Section(l*0.08,w*0.9,w,w*0.85),Section(l*0.3,w*0.48,w*0.6,w*0.5)],vec3(0,0,0),lv.body,lv.trim)
        loft(bins[6], [Section(l*0.3,w*0.48,w*0.6,w*0.5),Section(l*0.5,w*0.1,w*0.4,w*0.1)],vec3(0,0,0),lv.body,lv.trim)
    seats: vec3[]
    loop j in 0..p.cockpit_count:
        c = vec3(0,p.width+0.025,p.cockpit_z+f64(j)*1.35)
        _cockpit(bins[0],c,lv); seats.push(c+vec3(0,0.38,0))
        if p.gunner and j == 1: _gun_ring(bins[0],c+vec3(0,0.1,0))
    shade = [vec3(0,0,0),vec3(p.width,p.width,p.length*0.5)]
    loop level in 0..p.decks:
        span = p.span * (if level == 0: 1.0 else: p.lower_span)
        y = p.wing_y - f64(level) * (if p.decks == 3: 1.25 else: 1.9)
        chord = p.chord * (if level > 0 and p.lower_span < 0.7: 0.65 else: 1.0)
        wing: Vertex3D[]
        _fabric_wing(wing,vec3(0,y,-0.65),span,chord,p.taper,lv)
        _part_range(bins,wing,0,-1,kind)
        shade.push(vec3(0,y,-0.65)); shade.push(vec3(span*0.5,0.08,chord*0.5))
        loop side in [-1.0,1.0]:
            id = if side < 0: 2 else: 3
            if level == 0: _wing_mark(bins[id],vec3(side*span*0.29,y+0.205,-0.65),lv,min(0.45,chord*0.25))
            x = side * span * 0.31
            low = if level+1 < p.decks: y-(if p.decks == 3: 1.25 else: 1.9) else: p.width*0.5
            lx = if level+1 < p.decks: x*p.lower_span else: side*p.width
            loop dz in [-0.5,0.5]: _strut(bins[id],vec3(lx,low,-0.65+dz),vec3(x,y,-0.65+dz),0.045,lv.trim)
            # crossed tension wires, dark and thinner than the timber compression struts
            if level+1 < p.decks:
                _strut(bins[id],vec3(side*p.width,low,-1.15),vec3(x,y,-1.15),0.012,metal)
                _strut(bins[id],vec3(lx,low,-1.15),vec3(side*p.width,y,-1.15),0.012,metal)
            if level == 0 and p.wing_y > p.width:
                _strut(bins[id],vec3(side*p.width*0.6,p.width,-1.1),vec3(side*0.7,y,-1.1),0.04,metal)
                _strut(bins[id],vec3(side*p.width*0.6,p.width,-0.2),vec3(side*0.7,y,-0.2),0.04,metal)
    loop side in [-1.0,1.0]:
        id = if side < 0: 4 else: 5
        fx = side*p.float_x
        flen = if p.boat: 2.3 else: p.length*0.76
        fw = if p.boat: 0.22 else: min(0.44,p.width*0.7)
        _float(bins[id],vec3(fx,p.float_y,-0.35),flen,fw,lv.body,lv.trim)
        loop z in [-1.2,0.4]:
            _strut(bins[id],vec3(fx,p.float_y+fw*0.6,z),vec3(if p.boat: fx else: side*p.width*0.7,if p.boat: p.wing_y else: -p.width*0.6,z),0.045,metal)
        shade.push(vec3(fx,p.float_y,-0.35)); shade.push(vec3(fw,fw,flen*0.5))
    tail_y = if p.boat: p.width*1.1 else: 0.3
    _fabric_wing(bins[6],vec3(0,tail_y,p.length*0.42),p.span*0.3,p.chord*0.58,0.5,lv)
    _box(bins[6],vec3(0,tail_y+0.65,p.length*0.44),vec3(0.055,0.7,p.chord*0.3),lv.body)
    _box(bins[6],vec3(0,tail_y+0.68,p.length*0.44+p.chord*0.22),vec3(0.06,0.57,p.chord*0.09),lv.accent)
    shade.push(vec3(0,tail_y,p.length*0.42)); shade.push(vec3(p.span*0.15,0.08,p.chord*0.29))
    hubs = _catalog_hubs(p)
    loop hub in hubs:
        c = vec3(hub.x,p.engine_y,p.engine_z)
        if p.boat:
            loop side in [-1.0,1.0]:
                _strut(bins[1],c+vec3(side*0.22,-0.3,0.3),vec3(c.x+side*0.7,p.width,-0.3),0.055,metal)
        if p.voice == .inline:
            loft(bins[1],[Section(-0.6,0.3,0.35,0.32),Section(0.5,0.36,0.4,0.35),Section(0.75,0.2,0.25,0.25)],c,lv.trim,metal)
            _box(bins[1],c+vec3(0,0.46,0),vec3(0.28,0.1,0.4),metal)
            loop j in 0..6: _strut(bins[1],c+vec3(0.32,0.2,-0.42+f64(j)*0.16),c+vec3(0.46,0.4,-0.42+f64(j)*0.16),0.035,dark)
        else:
            _engine(bins[1],c,0.48,0.65,lv.accent)
            loop j in 0..7:
                a = f64(j)*TAU/7.0
                _strut(bins[1],c+vec3(cos(a)*0.34,sin(a)*0.34,-0.3),c+vec3(cos(a)*0.61,sin(a)*0.61,-0.3),0.09,metal)
        _spinner(bins[1],hub,0.14,lv.accent,p.pusher)
    wheels: CraftWheel[]
    if p.amphibian:
        loop side in [-1.0,1.0]:
            hinge = vec3(side*p.width,0.3,-1.2)
            center = vec3(side*0.4,-p.width*1.3-0.9,0)
            wheel: Vertex3D[]
            _strut(wheel,vec3(0,0,0),center,0.085,metal)
            add_cylinder(wheel,vec3(0,-0.12,0),0.6,0.24,dark,12,-1.0,translation(center)*rotation_z(PI/2))
            add_cylinder(wheel,vec3(0,-0.13,0),0.22,0.26,metal,10,-1.0,translation(center)*rotation_z(PI/2))
            wheels.push(CraftWheel(custom_mesh(wheel),hinge,side*PI/2))
        wheel: Vertex3D[]
        _strut(wheel,vec3(0,0,0),vec3(0,-p.width*1.3-0.9,0),0.05,metal)
        add_cylinder(wheel,vec3(0,-0.09,0),0.3,0.18,dark,10,-1.0,translation(vec3(0,-p.width*1.3-0.9,0))*rotation_z(PI/2))
        wheels.push(CraftWheel(custom_mesh(wheel),vec3(0,0,p.length*0.4),PI/2))
    vs: Vertex3D[]
    loop bin in bins: vs.extend(bin)
    model = CraftModel(custom_mesh(vs),build_prop(p.prop_radius,if p.engine_x > 0: 4 else: 2),hubs[0],catalog_contacts(kind),seats[0],
        if p.boat: vec3(p.width*0.7,p.width,-1) else: vec3(p.float_x,p.float_y+0.4,-0.35),shade,prop_hubs=hubs,cockpits=seats,wheels=wheels)
    _finish_craft(model,bins,kind)

# ---------------- the craft ----------------

build_craft = (kind: Craft, lv: Livery) -> CraftModel:
    if int(kind) >= 4: return _build_catalog_craft(kind, lv)
    vs: Vertex3D[]
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    dark = rgb(0.14, 0.13, 0.13)
    metal = rgb(0.55, 0.55, 0.56)
    under = vec4(lv.body.x * 0.8, lv.body.y * 0.8, lv.body.z * 0.8, 1)
    match kind:
        .gull:
            mark = vs.len()
            loft(vs, [Section(-3.5, 0.5, 0.5, 0.5), Section(-2.9, 0.58, 0.6, 0.58), Section(-1.2, 0.6, 0.68, 0.62),
                      Section(0.6, 0.55, 0.6, 0.58), Section(2.6, 0.32, 0.45, 0.38), Section(4.5, 0.08, 0.32, 0.08)], vec3(0, 0, 0), lv.body, under)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.62, 0.35), vec3(0.42, 0.05, 0.55), dark)                       # the cockpit
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.78, -0.25), vec3(0.4, 0.14, 0.02), rgba(0.7, 0.85, 0.9, 1))     # its windscreen
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.0, -0.6), vec3(0.61, 0.08, 0.9), lv.trim)                     # a band along the side
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _wing(vs, vec3(0, 1.55, -0.55), 11.0, 1.55, 0.16, lv.wing, lv.trim)
            _part_range(bins, vs, mark, -1, kind)
            mark = vs.len()
            _wing(vs, vec3(0, -0.5, -0.3), 9.4, 1.4, 0.14, lv.wing, lv.trim, 0.04)
            _part_range(bins, vs, mark, -1, kind)
            loop side in [-1.0, 1.0]:
                x = f32(side * 3.3)
                mark = vs.len()
                _strut(vs, vec3(x, -0.38, -0.85), vec3(x * 1.05, 1.45, -1.1), 0.05, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(x, -0.38, 0.25), vec3(x * 1.05, 1.45, 0.0), 0.05, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.35), 0.5, -0.9), vec3(f32(side * 0.5), 1.45, -0.9), 0.04, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.35), 0.5, -0.1), vec3(f32(side * 0.5), 1.45, -0.2), 0.04, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                fx = f32(side * 1.55)
                mark = vs.len()
                _float(vs, vec3(fx, -2.05, -0.4), 6.4, 0.42, lv.body, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, -1.3), vec3(f32(side * 0.45), -0.55, -1.2), 0.05, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, 0.5), vec3(f32(side * 0.45), -0.55, 0.4), 0.05, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, -0.4), vec3(fx * 0.9, -0.55, -0.4), 0.04, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.25, 4.0), vec3(1.7, 0.05, 0.45), lv.wing)                      # the tailplane
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.9, 4.15), vec3(0.05, 0.75, 0.42), lv.body)                     # the fin
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.95, 4.42), vec3(0.06, 0.6, 0.12), lv.accent)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _engine(vs, vec3(0, 0, -3.6), 0.62, 0.45, metal)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _spinner(vs, vec3(0, 0, -3.85), 0.16, lv.accent)
            _part_range(bins, vs, mark, 1, kind)
            contacts = [vec3(-1.55, -2.45, -3.2), vec3(1.55, -2.45, -3.2), vec3(-1.55, -2.55, -0.4), vec3(1.55, -2.55, -0.4), vec3(-1.55, -2.35, 2.6), vec3(1.55, -2.35, 2.6)]
            return _finish_craft(CraftModel(custom_mesh(vs), build_prop(1.25, 2), vec3(0, 0, -3.95), contacts, vec3(0, 1.0, 0.35), vec3(1.55, -1.7, -0.4), [vec3(0, 0, 0.5), vec3(0.55, 0.6, 4.0), vec3(0, 1.55, -0.55), vec3(5.5, 0.08, 0.78), vec3(0, -0.5, -0.3), vec3(4.7, 0.07, 0.7), vec3(-1.55, -2.05, -0.4), vec3(0.42, 0.3, 3.2), vec3(1.55, -2.05, -0.4), vec3(0.42, 0.3, 3.2), vec3(0, 0.25, 4.0), vec3(1.7, 0.05, 0.45)]), bins, kind)
        .heron:
            mark = vs.len()
            loft(vs, [Section(-5.6, 0.25, 0.3, 0.3, 0.1), Section(-5.0, 0.8, 0.75, 0.6, 0.35), Section(-3.0, 1.0, 1.0, 0.8, 0.45),
                      Section(0.4, 1.0, 1.0, 0.8, 0.45), Section(0.5, 0.95, 0.98, 0.55, 0.25), Section(3.5, 0.6, 0.85, 0.3, 0.1),
                      Section(6.2, 0.15, 0.6, 0.05)], vec3(0, 0, 0), lv.body, lv.trim)
            _part_range(bins, vs, mark, 0, kind)
            loop k in 0..4:
                mark = vs.len()
                _box(vs, vec3(-1.01, 0.45, f32(-2.4 + f64(k) * 0.9)), vec3(0.02, 0.2, 0.25), rgba(0.2, 0.25, 0.3, 1))
                _part_range(bins, vs, mark, 0, kind)
                mark = vs.len()
                _box(vs, vec3(1.01, 0.45, f32(-2.4 + f64(k) * 0.9)), vec3(0.02, 0.2, 0.25), rgba(0.2, 0.25, 0.3, 1))
                _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 1.02, -3.4), vec3(0.6, 0.06, 0.5), dark)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _wing(vs, vec3(0, 2.3, -1.4), 16.5, 2.2, 0.2, lv.wing, lv.accent)
            _part_range(bins, vs, mark, -1, kind)
            loop side in [-1.0, 1.0]:
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.8), 0.9, -2.2), vec3(f32(side * 2.4), 2.2, -2.0), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.8), 0.9, -0.6), vec3(f32(side * 2.4), 2.2, -0.8), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 1.0), 0.0, -1.4), vec3(f32(side * 4.6), 2.2, -1.4), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                fx = f32(side * 6.6)
                mark = vs.len()
                _float(vs, vec3(fx, 1.0, -1.3), 2.0, 0.22, lv.body, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, 1.2, -1.3), vec3(fx, 2.2, -1.3), 0.05, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
            # the engine on its pylon above the wing
            mark = vs.len()
            _strut(vs, vec3(0, 2.35, -1.8), vec3(0, 3.1, -1.6), 0.12, lv.trim)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _strut(vs, vec3(-0.4, 2.35, -1.0), vec3(0, 3.1, -1.6), 0.06, metal)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _strut(vs, vec3(0.4, 2.35, -1.0), vec3(0, 3.1, -1.6), 0.06, metal)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            loft(vs, [Section(-2.8, 0.42, 0.42, 0.42), Section(-2.2, 0.48, 0.48, 0.48), Section(-0.4, 0.4, 0.4, 0.4), Section(0.3, 0.12, 0.12, 0.12)], vec3(0, 3.35, -0.6), lv.trim, lv.trim)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _spinner(vs, vec3(0, 3.35, -3.5), 0.2, lv.accent)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _box(vs, vec3(0, 1.2, 5.6), vec3(2.3, 0.06, 0.55), lv.wing)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 1.9, 5.7), vec3(0.06, 1.0, 0.55), lv.body)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 2.0, 6.05), vec3(0.07, 0.8, 0.14), lv.accent)
            _part_range(bins, vs, mark, 6, kind)
            contacts = [vec3(0, -1.2, -4.6), vec3(-0.9, -0.85, -3.0), vec3(0.9, -0.85, -3.0), vec3(0, -1.25, 0.3), vec3(-0.9, -0.8, 0.3), vec3(0.9, -0.8, 0.3), vec3(0, -0.4, 4.5), vec3(-6.6, 0.75, -1.3), vec3(6.6, 0.75, -1.3)]
            return _finish_craft(CraftModel(custom_mesh(vs), build_prop(1.4, 3), vec3(0, 3.35, -3.65), contacts, vec3(0, 1.4, -3.4), vec3(0, 1.05, -1.0), [vec3(0, 0, 0.3), vec3(1.0, 0.8, 5.9), vec3(0, 2.3, -1.4), vec3(8.25, 0.1, 1.1), vec3(0, 1.2, 5.6), vec3(2.3, 0.06, 0.55), vec3(0, 3.35, -1.2), vec3(0.45, 0.45, 1.5)]), bins, kind)
        .corsair:
            mark = vs.len()
            loft(vs, [Section(-3.2, 0.65, 0.62, 0.62), Section(-2.6, 0.7, 0.7, 0.7), Section(-0.8, 0.68, 0.75, 0.7),
                      Section(0.8, 0.6, 0.65, 0.62), Section(2.4, 0.35, 0.48, 0.4), Section(3.9, 0.1, 0.36, 0.08)], vec3(0, 0, 0), lv.body, under)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.72, 0.4), vec3(0.46, 0.06, 0.55), dark)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _wing(vs, vec3(0, 1.5, -0.6), 9.6, 1.5, 0.18, lv.wing, lv.accent)
            _part_range(bins, vs, mark, -1, kind)
            mark = vs.len()
            _wing(vs, vec3(0, -0.6, -0.4), 8.4, 1.35, 0.16, lv.wing, lv.accent, 0.05)
            _part_range(bins, vs, mark, -1, kind)
            # guns on the upper wing
            loop side in [-1.0, 1.0]:
                mark = vs.len()
                _box(vs, vec3(f32(side * 0.6), 1.72, -1.2), vec3(0.06, 0.06, 0.7), dark)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
            loop side in [-1.0, 1.0]:
                x = f32(side * 2.9)
                mark = vs.len()
                _strut(vs, vec3(x, -0.48, -0.9), vec3(x, 1.4, -1.0), 0.06, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(x, -0.48, 0.2), vec3(x, 1.4, 0.0), 0.06, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                fx = f32(side * 1.45)
                mark = vs.len()
                _float(vs, vec3(fx, -2.1, -0.3), 5.8, 0.44, lv.trim, dark)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.8, -1.2), vec3(f32(side * 0.5), -0.6, -1.0), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.8, 0.5), vec3(f32(side * 0.5), -0.6, 0.4), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.3, 3.5), vec3(1.6, 0.05, 0.45), lv.wing)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.95, 3.6), vec3(0.06, 0.75, 0.45), lv.body)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 1.0, 3.9), vec3(0.07, 0.6, 0.14), lv.accent)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _engine(vs, vec3(0, 0, -3.3), 0.78, 0.55, lv.accent)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _spinner(vs, vec3(0, 0, -3.6), 0.2, metal)
            _part_range(bins, vs, mark, 1, kind)
            contacts = [vec3(-1.45, -2.5, -3.0), vec3(1.45, -2.5, -3.0), vec3(-1.45, -2.6, -0.3), vec3(1.45, -2.6, -0.3), vec3(-1.45, -2.4, 2.4), vec3(1.45, -2.4, 2.4)]
            return _finish_craft(CraftModel(custom_mesh(vs), build_prop(1.3, 3), vec3(0, 0, -3.7), contacts, vec3(0, 1.1, 0.4), vec3(1.45, -1.75, -0.3), [vec3(0, 0, 0.3), vec3(0.65, 0.65, 3.6), vec3(0, 1.5, -0.6), vec3(4.8, 0.09, 0.75), vec3(0, -0.6, -0.4), vec3(4.2, 0.08, 0.68), vec3(-1.45, -2.1, -0.3), vec3(0.44, 0.3, 2.9), vec3(1.45, -2.1, -0.3), vec3(0.44, 0.3, 2.9), vec3(0, 0.3, 3.5), vec3(1.6, 0.05, 0.45)]), bins, kind)
        .falco:
            mark = vs.len()
            loft(vs, [Section(-4.4, 0.18, 0.2, 0.2), Section(-4.0, 0.45, 0.45, 0.42), Section(-2.0, 0.55, 0.55, 0.5),
                      Section(0.4, 0.52, 0.62, 0.48), Section(1.2, 0.45, 0.5, 0.42), Section(3.2, 0.22, 0.32, 0.22), Section(4.6, 0.06, 0.26, 0.06)], vec3(0, 0, 0), lv.body, under)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.58, 0.55), vec3(0.34, 0.05, 0.45), dark)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.7, 0.05), vec3(0.32, 0.12, 0.02), rgba(0.7, 0.85, 0.9, 1))
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.3, -2.0), vec3(0.56, 0.05, 1.6), lv.accent)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _wing(vs, vec3(0, -0.35, -0.6), 9.2, 1.45, 0.14, lv.wing, lv.trim, 0.06)
            _part_range(bins, vs, mark, -1, kind)
            loop side in [-1.0, 1.0]:
                fx = f32(side * 1.3)
                mark = vs.len()
                _float(vs, vec3(fx, -2.0, -0.7), 6.6, 0.36, lv.body, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, -1.7), vec3(f32(side * 0.9), -0.4, -1.1), 0.05, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, 0.2), vec3(f32(side * 0.9), -0.4, -0.1), 0.05, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.1, 4.1), vec3(1.5, 0.04, 0.4), lv.wing)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.75, 4.15), vec3(0.05, 0.7, 0.42), lv.body)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.8, 4.46), vec3(0.06, 0.55, 0.13), lv.trim)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _spinner(vs, vec3(0, 0, -4.55), 0.18, lv.trim)
            _part_range(bins, vs, mark, 1, kind)
            contacts = [vec3(-1.3, -2.35, -3.6), vec3(1.3, -2.35, -3.6), vec3(-1.3, -2.45, -0.7), vec3(1.3, -2.45, -0.7), vec3(-1.3, -2.3, 2.4), vec3(1.3, -2.3, 2.4)]
            return _finish_craft(CraftModel(custom_mesh(vs), build_prop(1.15, 2), vec3(0, 0, -4.7), contacts, vec3(0, 0.9, 0.55), vec3(1.3, -1.65, -0.7), [vec3(0, 0, 0.0), vec3(0.5, 0.5, 4.5), vec3(0, -0.35, -0.6), vec3(4.6, 0.07, 0.72), vec3(-1.3, -2.0, -0.7), vec3(0.36, 0.3, 3.3), vec3(1.3, -2.0, -0.7), vec3(0.36, 0.3, 3.3), vec3(0, 0.1, 4.1), vec3(1.5, 0.04, 0.4)]), bins, kind)
        _: return _build_catalog_craft(kind, lv)

# Runtime keeps the original twelve paint/model slots; new kinds occupy append-only slots.
DEFAULT_LIVERIES = [0,5,3,1,0,5,4,1,2,5,0,3,1,5,4,2]

extend_craft_models = (models: mut CraftModel[]):
    loop id in 4..CRAFT_NAMES.len():
        if models.len() <= default_craft_model(Craft(id)):
            models.push(build_craft(Craft(id), LIVERIES[DEFAULT_LIVERIES[id]]))

build_craft_models = () -> CraftModel[]:
    models = [build_craft(.gull,LIVERIES[0]),build_craft(.heron,LIVERIES[5]),build_craft(.corsair,LIVERIES[3]),build_craft(.falco,LIVERIES[1]),
        build_craft(.gull,LIVERIES[1]),build_craft(.gull,LIVERIES[2]),build_craft(.heron,LIVERIES[4]),build_craft(.gull,LIVERIES[4]),
        build_craft(.heron,LIVERIES[2]),build_craft(.gull,LIVERIES[5]),build_craft(.falco,LIVERIES[3]),build_craft(.corsair,LIVERIES[4])]
    extend_craft_models(models)
    models

draw_craft_props = (model: CraftModel, L: Light, t: f64, at: mat4, angle: f64, anchor: WorldPoint?=none):
    loop i in 0..model.prop_hubs.len():
        draw_world(obj_sh,model.prop,obj_params(L,t,at*translation(model.prop_hubs[i])*rotation_z(angle+f64(i)*0.8),anchor=anchor))

draw_craft_gear = (model: CraftModel, L: Light, t: f64, at: mat4, extension: f64 = 0.0, anchor: WorldPoint?=none):
    loop wheel in model.wheels: draw_world(obj_sh,wheel.mesh,obj_params(L,t,at*wheel_frame(wheel,extension),anchor=anchor))
