# The aircraft, as low-poly meshes built from parts: lofted fuselages, hulls and floats, wings
# with struts, the engine and its propeller (a separate mesh that turns). Flat-shaded, colored by
# a livery. The frame: forward is -z, right +x, up +y, in meters, the origin near the center of
# gravity. Contact points (where floats or hull meet the water) are given for the flight model.

use 'look.jo'

enum Craft:
    gull            # twin-float utility biplane: the everyday aircraft of couriers and the player
    heron           # flying boat: a hull, a high wing, an engine on a pylon: cargo and passengers
    corsair         # a stubby float biplane with a big engine and guns: pirates' favourite
    falco           # a slim float monoplane racer: fast, nervous

CRAFT_NAMES = ["Gull", "Heron", "Corsair", "Falco"]

struct Livery:
    body: vec4
    trim: vec4
    wing: vec4
    accent: vec4                    # stripes on the rudder, the cowling

LIVERIES = [
    Livery(rgb(0.93, 0.89, 0.78), rgb(0.12, 0.45, 0.5), rgb(0.9, 0.86, 0.74), rgb(0.78, 0.2, 0.15)),      # cream and teal
    Livery(rgb(0.78, 0.18, 0.12), rgb(0.95, 0.9, 0.8), rgb(0.8, 0.2, 0.14), rgb(0.15, 0.5, 0.3)),         # red
    Livery(rgb(0.15, 0.2, 0.35), rgb(0.85, 0.7, 0.25), rgb(0.18, 0.24, 0.4), rgb(0.9, 0.9, 0.85)),        # navy and gold
    Livery(rgb(0.4, 0.42, 0.26), rgb(0.55, 0.38, 0.22), rgb(0.45, 0.46, 0.3), rgb(0.85, 0.75, 0.3)),      # olive (pirates)
    Livery(rgb(0.9, 0.9, 0.88), rgb(0.2, 0.3, 0.6), rgb(0.92, 0.92, 0.9), rgb(0.2, 0.3, 0.6)),            # white and blue (police)
    Livery(rgb(0.86, 0.62, 0.22), rgb(0.35, 0.22, 0.14), rgb(0.88, 0.66, 0.26), rgb(0.6, 0.15, 0.12)),    # ochre
]

struct CraftModel:
    body: Mesh
    prop: Mesh
    prop_at: vec3                   # the propeller's hub
    contacts: vec3[]                # points on the float or hull bottoms (the flight model's water contacts)
    cockpit: vec3                   # the pilot's head
    exit: vec3                      # where one steps off (onto a float, or the hull's deck)
    shade: vec3[] = []              # flat parts for its shadow on the sea: center, half size, by pairs
    parts: CraftPart[] = []         # stable PartId order; legacy body remains the whole mesh

# Stable indices shared by model, physics, damage and drawing. Left is local -X.
enum PartId: body, engine, left_wing, right_wing, left_float, right_float, tail

struct PartSpec:
    id: PartId
    name: str
    attachment: vec3                # pivot in craft space, axes parallel to the craft
    mass_share: f64
    strength: f64                   # joules of destructive contact work before separation
    buoyancy: f64                   # debris displaced volume / mass, relative to water
    contacts: vec3[]                # original buoyancy contacts, in craft space
    wing_contacts: vec3[]
    strikes: vec3[]                 # hull / engine / tail collision probes

struct CraftPart:
    spec: PartSpec
    mesh: Mesh                     # craft-space vertices: preserves obj_vs flex exactly
    frame: mat4 = mat4()            # mesh -> craft (identity); attachment is the tumble pivot

contact_part = (kind: Craft, p: vec3, wing: bool = false) -> int:
    if wing: return if p.x < 0: int(PartId.left_wing) else: int(PartId.right_wing)
    if kind == .heron and abs(p.x) < 3: return if p.z >= 3.5: int(PartId.tail) else: int(PartId.body)
    if p.x < 0: int(PartId.left_float) else: int(PartId.right_float)

craft_wing_contacts = (kind: Craft) -> vec3[]: match kind:
    .gull: [vec3(-4.7, -0.31, -0.3), vec3(4.7, -0.31, -0.3), vec3(-5.5, 1.55, -0.55), vec3(5.5, 1.55, -0.55)]
    .heron: [vec3(-8.25, 2.3, -1.4), vec3(8.25, 2.3, -1.4)]
    .corsair: [vec3(-4.2, -0.39, -0.4), vec3(4.2, -0.39, -0.4), vec3(-4.8, 1.5, -0.6), vec3(4.8, 1.5, -0.6)]
    .falco: [vec3(-4.6, -0.07, -0.6), vec3(4.6, -0.07, -0.6)]

# CPU-only: craft_spec can use the same attachment/contact data without building GPU meshes.
craft_parts = (kind: Craft, contacts: vec3[]) -> PartSpec[]:
    scale = if kind == .heron: 3200.0 / 1400.0 else: (if kind == .corsair: 1700.0 / 1400.0 else: (if kind == .falco: 1200.0 / 1400.0 else: 1.0))
    nose = if kind == .heron: vec3(0, 3.35, -2.0) else: (if kind == .falco: vec3(0, 0, -3.5) else: vec3(0, 0, -3.3))
    tail = if kind == .heron: vec3(0, 1.2, 5.6) else: (if kind == .corsair: vec3(0, 0.3, 3.5) else: vec3(0, 0.25, 4.0))
    fx = if kind == .heron: 6.6 else: (if kind == .corsair: 1.45 else: (if kind == .falco: 1.3 else: 1.55))
    fy = if kind == .heron: 1.0 else: -2.0
    wy = if kind == .heron: 2.3 else: 0.5
    ps = [PartSpec(.body, if kind == .heron: "hull" else: "fuselage", vec3(0, 0, 0), 0.42, 100000, 1.15),
          PartSpec(.engine, "engine", nose, 0.18, 45000, 0.15),
          PartSpec(.left_wing, "left wing", vec3(-0.6, wy, -0.6), 0.10, 32000, 2.0),
          PartSpec(.right_wing, "right wing", vec3(0.6, wy, -0.6), 0.10, 32000, 2.0),
          PartSpec(.left_float, "left float", vec3(-fx, fy, -0.4), 0.065, 16000, 2.8),
          PartSpec(.right_float, "right float", vec3(fx, fy, -0.4), 0.065, 16000, 2.8),
          PartSpec(.tail, "tail", tail, 0.07, 22000, 1.6)]
    if kind == .heron:
        ps[0].mass_share = 0.50
        ps[2].mass_share = 0.11; ps[3].mass_share = 0.11
        ps[4].mass_share = 0.015; ps[5].mass_share = 0.015
        ps[4].strength = 6000; ps[5].strength = 6000
    loop i in 0..ps.len(): ps[i].strength *= scale
    loop p in contacts: ps[contact_part(kind, p)].contacts.push(p)
    loop p in craft_wing_contacts(kind): ps[contact_part(kind, p, true)].wing_contacts.push(p)
    ps[0].strikes = if kind == .heron: [vec3(0, 0, -5.6), vec3(-1, -0.5, 0), vec3(1, -0.5, 0), vec3(0, 1, 0)] else: [vec3(-0.55, -0.6, 0), vec3(0.55, -0.6, 0), vec3(0, 0.7, 0)]
    ps[1].strikes = [nose + vec3(0, 0, -0.9), nose + vec3(0, -0.45, 0)]
    ps[6].strikes = [tail + vec3(-1.5, 0, 0), tail + vec3(1.5, 0, 0), tail + vec3(0, 0.7, 0.4)]
    ps

# Copy emitted triangles unchanged into their owner's mesh. No tessellation, added caps or
# vertex translations: the union is byte-for-byte the original colored/normed triangle soup.
_part_range = (bins: mut Vertex3D[][], vs: Vertex3D[], start: int, owner: int, kind: Craft):
    loop tri in start / 3..vs.len() / 3:
        i = tri * 3
        id = owner
        if owner == -1: id = if vs[i].pos.x + vs[i + 1].pos.x + vs[i + 2].pos.x < 0: 2 else: 3
        if owner == 0:
            aft = if kind == .heron: 3.5 else: (if kind == .corsair: 2.4 else: (if kind == .falco: 3.2 else: 2.6))
            if min(vs[i].pos.z, min(vs[i + 1].pos.z, vs[i + 2].pos.z)) >= aft: id = 6
            if kind == .falco and max(vs[i].pos.z, max(vs[i + 1].pos.z, vs[i + 2].pos.z)) <= -2.0: id = 1
        bins[id].extend(vs[i..i + 3])

_finish_craft = (model: CraftModel, bins: Vertex3D[][], kind: Craft) -> CraftModel:
    m = model
    specs = craft_parts(kind, m.contacts)
    loop i in 0..7: m.parts.push(CraftPart(specs[i], custom_mesh(bins[i])))
    m

# ---------------- flat-shaded parts ----------------

_tri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    vs.push(Vertex3D(a, n, vec2(0, 0), col))
    vs.push(Vertex3D(b, n, vec2(0, 0), col))
    vs.push(Vertex3D(c, n, vec2(0, 0), col))

_quad = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, col: vec4):
    _tri(vs, a, b, c, col)
    _tri(vs, a, c, d, col)

struct Section:
    z: f32                          # along the length (forward is -z)
    w: f32                          # half width
    top: f32                        # above the axis
    bottom: f32                     # below it
    keel: f32 = 0.0                 # a V bottom: how far the keel line drops below the chines

# a body lofted through sections: eight sides (a rounded box), or a boat hull with a V bottom
loft = (vs: mut Vertex3D[], secs: Section[], center: vec3, col: vec4, bottom_col: vec4):
    ring = (s: Section) -> vec3[]:
        w = s.w
        c = center + vec3(0, 0, s.z)
        [c + vec3(0, s.top, 0) + vec3(-w * 0.55, 0, 0), c + vec3(w * 0.55, s.top, 0), c + vec3(w, s.top * 0.45, 0),
         c + vec3(w, -s.bottom * 0.5, 0), c + vec3(w * 0.5, -s.bottom, 0), c + vec3(0, -s.bottom - s.keel, 0),
         c + vec3(-w * 0.5, -s.bottom, 0), c + vec3(-w, -s.bottom * 0.5, 0), c + vec3(-w, s.top * 0.45, 0)]
    loop k in 0..secs.len() - 1:
        a = ring(secs[k])
        b = ring(secs[k + 1])
        m = a.len()
        loop i in 0..m:
            j = (i + 1) % m
            under = i >= 3 and i <= 6
            # (a ring goes round clockwise seen from the front; quads face outward)
            _quad(vs, a[i], b[i], b[j], a[j], if under: bottom_col else: col)
    # caps
    loop e in [0, secs.len() - 1]:
        r = ring(secs[e])
        c = center + vec3(0, 0, secs[e].z)
        loop i in 0..r.len():
            j = (i + 1) % r.len()
            if e == 0: _tri(vs, c, r[i], r[j], col) else: _tri(vs, c, r[j], r[i], col)

# a box from its center and half-sizes, turned by m
_box = (vs: mut Vertex3D[], c: vec3, h: vec3, col: vec4, m: mat4 = mat4()):
    add_box(vs, c, h * 2.0, col, m)

# a wing: a thin box, with a little taper at the tips and a stripe of the trim near them
_wing = (vs: mut Vertex3D[], c: vec3, span: f64, chord: f64, thick: f64, col: vec4, tip: vec4, dihedral: f64 = 0.0):
    half = span * 0.5
    loop side in [-1.0, 1.0]:
        m = translation(c) * rotation_z(side * dihedral)
        _box(vs, vec3(f32(side * half * 0.5), 0, 0), vec3(f32(half * 0.5), f32(thick * 0.5), f32(chord * 0.5)), col, m)
        _box(vs, vec3(f32(side * (half - 0.45)), 0.01, 0), vec3(0.42, f32(thick * 0.52), f32(chord * 0.505)), tip, m)

# a strut between two points
_strut = (vs: mut Vertex3D[], a: vec3, b: vec3, r: f64, col: vec4):
    d = b - a
    len = f64(length(d))
    m = translation((a + b) * 0.5) * facing(d)
    _box(vs, vec3(0, 0, 0), vec3(f32(r), f32(r), f32(len * 0.5)), col, m)

# a float: pointed bow, a step under the middle, tapering stern
_float = (vs: mut Vertex3D[], c: vec3, len: f64, w: f64, col: vec4, under: vec4):
    l = f32(len)
    hw = f32(w)
    secs = [Section(-l * 0.5, hw * 0.25, hw * 0.35, hw * 0.1), Section(-l * 0.38, hw * 0.9, hw * 0.65, hw * 0.55, hw * 0.2),
            Section(-l * 0.05, hw, hw * 0.7, hw * 0.75, hw * 0.25), Section(l * 0.06, hw, hw * 0.7, hw * 0.75, hw * 0.25),
            Section(l * 0.08, hw * 0.95, hw * 0.68, hw * 0.45, hw * 0.15), Section(l * 0.5, hw * 0.3, hw * 0.45, hw * 0.1)]
    loft(vs, secs, c, col, under)

_engine = (vs: mut Vertex3D[], c: vec3, r: f64, len: f64, cowl: vec4):
    m = translation(c) * rotation_x(PI / 2)
    add_cylinder(vs, vec3(0, f32(-len * 0.5), 0), r, len, cowl, 12, r * 0.92, m)
    # cylinder heads round the cowling's front
    dark = rgb(0.22, 0.2, 0.2)
    add_cylinder(vs, vec3(0, f32(-len * 0.5 - 0.05), 0), r * 0.82, 0.08, dark, 12, -1.0, m)

_spinner = (vs: mut Vertex3D[], c: vec3, r: f64, col: vec4):
    m = translation(c) * rotation_x(-PI / 2)
    add_cylinder(vs, vec3(0, 0, 0), r, r * 1.6, col, 8, 0.0, m)

build_prop = (radius: f64, blades: int) -> Mesh:
    vs: Vertex3D[]
    wood = rgb(0.45, 0.28, 0.16)
    loop b in 0..blades:
        m = rotation_z(f64(b) / f64(blades) * TAU)
        _box(vs, vec3(0, f32(radius * 0.5), 0), vec3(0.09, f32(radius * 0.5), 0.03), wood, m * rotation_y(0.35))
        _box(vs, vec3(0, f32(radius * 0.92), 0), vec3(0.095, f32(radius * 0.08), 0.032), rgb(0.85, 0.8, 0.6), m * rotation_y(0.35))
    custom_mesh(vs)

# ---------------- the craft ----------------

build_craft = (kind: Craft, lv: Livery) -> CraftModel:
    vs: Vertex3D[]
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    dark = rgb(0.14, 0.13, 0.13)
    metal = rgb(0.55, 0.55, 0.56)
    under = vec4(lv.body.x * 0.8, lv.body.y * 0.8, lv.body.z * 0.8, 1)
    match kind:
        .gull:
            mark = vs.len()
            loft(vs, [Section(-3.5, 0.5, 0.5, 0.5), Section(-2.9, 0.58, 0.6, 0.58), Section(-1.2, 0.6, 0.68, 0.62),
                      Section(0.6, 0.55, 0.6, 0.58), Section(2.6, 0.32, 0.45, 0.38), Section(4.5, 0.08, 0.32, 0.08)], vec3(0, 0, 0), lv.body, under)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.62, 0.35), vec3(0.42, 0.05, 0.55), dark)                       # the cockpit
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.78, -0.25), vec3(0.4, 0.14, 0.02), rgba(0.7, 0.85, 0.9, 1))     # its windscreen
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.0, -0.6), vec3(0.61, 0.08, 0.9), lv.trim)                     # a band along the side
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _wing(vs, vec3(0, 1.55, -0.55), 11.0, 1.55, 0.16, lv.wing, lv.trim)
            _part_range(bins, vs, mark, -1, kind)
            mark = vs.len()
            _wing(vs, vec3(0, -0.5, -0.3), 9.4, 1.4, 0.14, lv.wing, lv.trim, 0.04)
            _part_range(bins, vs, mark, -1, kind)
            loop side in [-1.0, 1.0]:
                x = f32(side * 3.3)
                mark = vs.len()
                _strut(vs, vec3(x, -0.38, -0.85), vec3(x * 1.05, 1.45, -1.1), 0.05, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(x, -0.38, 0.25), vec3(x * 1.05, 1.45, 0.0), 0.05, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.35), 0.5, -0.9), vec3(f32(side * 0.5), 1.45, -0.9), 0.04, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.35), 0.5, -0.1), vec3(f32(side * 0.5), 1.45, -0.2), 0.04, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                fx = f32(side * 1.55)
                mark = vs.len()
                _float(vs, vec3(fx, -2.05, -0.4), 6.4, 0.42, lv.body, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, -1.3), vec3(f32(side * 0.45), -0.55, -1.2), 0.05, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, 0.5), vec3(f32(side * 0.45), -0.55, 0.4), 0.05, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, -1.75, -0.4), vec3(fx * 0.9, -0.55, -0.4), 0.04, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.25, 4.0), vec3(1.7, 0.05, 0.45), lv.wing)                      # the tailplane
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.9, 4.15), vec3(0.05, 0.75, 0.42), lv.body)                     # the fin
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _box(vs, vec3(0, 0.95, 4.42), vec3(0.06, 0.6, 0.12), lv.accent)
            _part_range(bins, vs, mark, 6, kind)
            mark = vs.len()
            _engine(vs, vec3(0, 0, -3.6), 0.62, 0.45, metal)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _spinner(vs, vec3(0, 0, -3.85), 0.16, lv.accent)
            _part_range(bins, vs, mark, 1, kind)
            contacts = [vec3(-1.55, -2.45, -3.2), vec3(1.55, -2.45, -3.2), vec3(-1.55, -2.55, -0.4), vec3(1.55, -2.55, -0.4), vec3(-1.55, -2.35, 2.6), vec3(1.55, -2.35, 2.6)]
            return _finish_craft(CraftModel(custom_mesh(vs), build_prop(1.25, 2), vec3(0, 0, -3.95), contacts, vec3(0, 1.0, 0.35), vec3(1.55, -1.7, -0.4), [vec3(0, 0, 0.5), vec3(0.55, 0.6, 4.0), vec3(0, 1.55, -0.55), vec3(5.5, 0.08, 0.78), vec3(0, -0.5, -0.3), vec3(4.7, 0.07, 0.7), vec3(-1.55, -2.05, -0.4), vec3(0.42, 0.3, 3.2), vec3(1.55, -2.05, -0.4), vec3(0.42, 0.3, 3.2), vec3(0, 0.25, 4.0), vec3(1.7, 0.05, 0.45)]), bins, kind)
        .heron:
            mark = vs.len()
            loft(vs, [Section(-5.6, 0.25, 0.3, 0.3, 0.1), Section(-5.0, 0.8, 0.75, 0.6, 0.35), Section(-3.0, 1.0, 1.0, 0.8, 0.45),
                      Section(0.4, 1.0, 1.0, 0.8, 0.45), Section(0.5, 0.95, 0.98, 0.55, 0.25), Section(3.5, 0.6, 0.85, 0.3, 0.1),
                      Section(6.2, 0.15, 0.6, 0.05)], vec3(0, 0, 0), lv.body, lv.trim)
            _part_range(bins, vs, mark, 0, kind)
            loop k in 0..4:
                mark = vs.len()
                _box(vs, vec3(-1.01, 0.45, f32(-2.4 + f64(k) * 0.9)), vec3(0.02, 0.2, 0.25), rgba(0.2, 0.25, 0.3, 1))
                _part_range(bins, vs, mark, 0, kind)
                mark = vs.len()
                _box(vs, vec3(1.01, 0.45, f32(-2.4 + f64(k) * 0.9)), vec3(0.02, 0.2, 0.25), rgba(0.2, 0.25, 0.3, 1))
                _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _box(vs, vec3(0, 1.02, -3.4), vec3(0.6, 0.06, 0.5), dark)
            _part_range(bins, vs, mark, 0, kind)
            mark = vs.len()
            _wing(vs, vec3(0, 2.3, -1.4), 16.5, 2.2, 0.2, lv.wing, lv.accent)
            _part_range(bins, vs, mark, -1, kind)
            loop side in [-1.0, 1.0]:
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.8), 0.9, -2.2), vec3(f32(side * 2.4), 2.2, -2.0), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 0.8), 0.9, -0.6), vec3(f32(side * 2.4), 2.2, -0.8), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                mark = vs.len()
                _strut(vs, vec3(f32(side * 1.0), 0.0, -1.4), vec3(f32(side * 4.6), 2.2, -1.4), 0.06, metal)
                _part_range(bins, vs, mark, if side < 0: 2 else: 3, kind)
                fx = f32(side * 6.6)
                mark = vs.len()
                _float(vs, vec3(fx, 1.0, -1.3), 2.0, 0.22, lv.body, lv.trim)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
                mark = vs.len()
                _strut(vs, vec3(fx, 1.2, -1.3), vec3(fx, 2.2, -1.3), 0.05, metal)
                _part_range(bins, vs, mark, if side < 0: 4 else: 5, kind)
            # the engine on its pylon above the wing
            mark = vs.len()
            _strut(vs, vec3(0, 2.35, -1.8), vec3(0, 3.1, -1.6), 0.12, lv.trim)
            _part_range(bins, vs, mark, 1, kind)
            mark = vs.len()
            _strut(vs, vec3(-0.4, 2.35, -1.0), vec3(0, 3.1, -1.6), 0.06, metal)
