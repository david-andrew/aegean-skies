# A stepped landing path is laid as stone steps where it is steep, a kalderimi
# down to the cove; gentle stretches stay a beaten path. The steps are walking
# contact as well as scenery, so the treads you see are the ones you climb.
use 'landing_access.jo'
use 'landing_access_types.jo'
use 'stairways.jo'
use 'settlements.jo'

const LANDING_STEP_GRADE=0.28
const LANDING_STEP_WIDTH=1.6

struct LandingStairs:
    runs:vec3[][]
    bounds:vec4

landing_stairs_cache:{int:LandingStairs}={}
landing_stairs_ready=false

# Consecutive steep segments of the surveyed route, as stairway centrelines.
landing_stair_runs=(landing:LandingAccess)->vec3[][]:
    runs:vec3[][];current:vec3[]
    loop k in 1..landing.route.len():
        a=landing.route[k-1];b=landing.route[k];run=f64(length(b.xz-a.xz))
        steep=run>0.01 and abs(f64(b.y-a.y))/run>LANDING_STEP_GRADE
        if steep:
            # Steps follow the slope itself: a straight line between survey
            # points 70 m apart would bury the treads under any bulge.
            if current.len()==0:current.push(vec3(a.x,f32(place_ground(a.xz)),a.z))
            n=max(1,int(ceil(run/3.0)))
            loop j in 1..n+1:
                q=mix(a.xz,b.xz,f32(j)/f32(n));current.push(vec3(q.x,f32(place_ground(q)),q.y))
        else if current.len()>1:runs.push(current);current=[]
    if current.len()>1:runs.push(current)
    runs

landing_stairs_all=()->{int:LandingStairs}:
    global landing_stairs_cache,landing_stairs_ready
    if landing_stairs_ready:return landing_stairs_cache
    loop id in landing_access_ids():
        landing=landing_access(id)
        if not landing.stepped:continue
        runs=landing_stair_runs(landing)
        if runs.len()==0:continue
        low=runs[0][0].xz;high=low
        loop run in runs:
            loop q in run:low=min(low,q.xz);high=max(high,q.xz)
        landing_stairs_cache[id]=LandingStairs(runs,vec4(low.x-2,low.y-2,high.x+2,high.y+2))
    landing_stairs_ready=true
    landing_stairs_cache

landing_stair_height=(p:vec2,ground:f64)->f64:
    result=ground
    loop _,stairs in landing_stairs_all():
        b=stairs.bounds
        if p.x<b.x or p.y<b.y or p.x>b.z or p.y>b.w:continue
        loop run in stairs.runs:result=stair_height(run,LANDING_STEP_WIDTH,p,result)
    result

add_landing_stairs_mesh=(vs:mut Vertex3D[],id:int):
    stairs=landing_stairs_all()
    if not (id in stairs):return
    ground=(x:f64,z:f64)->f64:place_ground(vec2(f32(x),f32(z)))
    loop run in stairs[id].runs:add_stairway_mesh(vs,run,LANDING_STEP_WIDTH,ground,rgb(0.70,0.66,0.57))
