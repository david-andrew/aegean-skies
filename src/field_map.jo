# The field map: the farmland as it looks from the air, painted once into a texture around the
# camera, so the ground shader reads a field's colour, its hedgerows, lanes and edges and the
# hedges' shadows with one texture sample instead of working out districts, rows and hedges for
# every pixel (one look on every tier, at about low's cost).
#
# A world-anchored wrap-around texture (2048 texels of 3 m, about 6 km square): texel i holds
# world texel I with i = I mod 2048, so it is read with repeat addressing at world/span. It is
# kept in 64-texel blocks drawn by a small GPU pass (src/fields.jo field_at per texel), nearest
# the camera first and a few dozen a frame: the window the ground reads is the square of blocks
# round the camera all drawn. RGB: the field's paint (field_paint: its crop colour, a lane's
# pale track, a darker line where fields meet, the hedgerows' scalloped crowns); A: a
# hedgerow's shadow under the canopy light (held low). Mipmapped, so far off a hedge becomes a
# soft dark line and the fields their mean, never a shimmer. When the light's bearing turns,
# the blocks are redrawn the same way, their old shadows standing meanwhile. Where a field is
# at all comes from the terrain (field_share, the working channel's share), as does the colour
# beyond the window (its rgb).
use 'fields.jo'
use 'coast_pattern.jo'
use 'quality.jo'

const FIELD_MAP_SIZE = 2048
const FIELD_MAP_TEXEL = 3.0
const FIELD_MAP_BLOCK = 64
const FIELD_MAP_BLOCKS = 32       # FIELD_MAP_SIZE / FIELD_MAP_BLOCK
const FIELD_MAP_PER_FRAME = 48    # blocks drawn a frame at most (about 200 000 texels)

struct FieldMapVertex:
    corner: vec2

struct FieldMapBlock:
    rect: vec4                      # the block's map uv rectangle
    world: vec4                     # its world x, z (the min corner) and size (metres)

struct FieldMapParams:
    pattern: Texture                # the coast pattern (the fields' warp noise)
    light: vec4                     # toward the light (x, z, unit), the palette (src/fields.jo field_palette), a hedge's shadow length (m)

struct FieldMapOut:
    pos: vec4
    world: vec2

field_map_vs = (v: FieldMapVertex,inst: FieldMapBlock,u: FieldMapParams) -> FieldMapOut:
    uv = mix(inst.rect.xy,inst.rect.zw,v.corner)
    FieldMapOut(vec4(uv*2.0-vec2(1,1),0,1),inst.world.xy+v.corner*inst.world.zw)

# A field's layout at a point: (hedge cover, lane track, field edge).
field_layout = (cell: FieldCell) -> vec3:
    hedge: f32 = 0.0
    loop axis in 0..2:
        first = if axis == 0: cell.edge.x < cell.edge.y else: cell.edge.z < cell.edge.w
        on = if axis == 0: (if first: cell.hedge.x else: cell.hedge.y) else: (if first: cell.hedge.z else: cell.hedge.w)
        if on < 0.5: continue
        dist = if axis == 0: min(cell.edge.x,cell.edge.y) else: min(cell.edge.z,cell.edge.w)
        run = if axis == 0: cell.local.y else: cell.local.x
        half = 2.6+1.6*abs(fract(run*0.09)-0.5)*abs(fract(run*0.037+0.3)-0.5)*8.0
        hedge = max(hedge,1.0-clamp((dist-half)/1.5,0.0,1.0))
    lane_hedge = (1.0-clamp((abs(cell.lane-4.5)-1.8)/1.5,0.0,1.0))*step(0.5,cell.lane_hedge)
    hedge = max(hedge,lane_hedge)
    lane = 1.0-clamp((cell.lane-1.8)/1.5,0.0,1.0)
    edge = 1.0-clamp((min(min(cell.edge.x,cell.edge.y),min(cell.edge.z,cell.edge.w))-0.6)/1.2,0.0,1.0)
    vec3(hedge,lane*(1.0-hedge),edge*(1.0-hedge))

field_map_fs = (i: FieldMapOut,u: FieldMapParams) -> vec4:
    cell = field_at(i.world,sample(u.pattern,i.world/6000.0).xy*2.0-vec2(1,1))
    l = field_layout(cell)
    c = field_paint(cell,i.world,u.light.z)
    c = mix(c,vec3(0.74,0.67,0.50),l.y)
    c *= 1.0-l.z*0.22
    c = mix(c,mix(vec3(0.09,0.20,0.11),vec3(0.16,0.29,0.14),hash21(floor(i.world/7.0))),l.x)
    # (the hedge that far toward the light shades this point)
    sun = i.world+u.light.xy*u.light.w
    cast = field_layout(field_at(sun,sample(u.pattern,sun/6000.0).xy*2.0-vec2(1,1))).x
    vec4(c,cast*(1.0-l.x))

field_map_target = RenderTarget()
field_map_sh: Shader
field_map_quad: Mesh
field_map_blocks_buffer: InstanceBuffer[FieldMapBlock]
field_map_ready = false
# (which world block each wrap-around slot holds: slot = block mod 16 on each axis)
field_map_slots: ivec2[] = []
field_map_frame = -1
field_map_window = vec4(0,0,0,0)    # world min x, z of the valid window, its size; 0 size: none
field_map_light = vec4(0,0,0,0)     # the light the map's shadows were drawn under
field_map_lit: int[] = []           # the light each slot was drawn under (field_map_light_count)
field_map_light_count = 0

field_map_span = () -> f64: f64(FIELD_MAP_SIZE)*FIELD_MAP_TEXEL

# Bring the map to the camera: the blocks of the 16 x 16 window round it that the wrap-around
# slots don't hold yet are drawn (a row or column of them as the camera crosses a block, all of
# them after a jump). Once a frame, before the ground is drawn.
update_field_map = (cam: vec3,canopy: vec4):
    global field_map_target,field_map_sh,field_map_quad,field_map_blocks_buffer,field_map_ready
    global field_map_slots,field_map_frame,field_map_window,field_map_light,field_map_lit,field_map_light_count
    if field_map_frame == frame_number(): return
    field_map_frame = frame_number()
    if __soft: field_map_window = vec4(0,0,0,0); return
    if not field_map_ready:
        field_map_sh = make_shader(shader(field_map_vs,field_map_fs))
        field_map_quad = mesh([FieldMapVertex(vec2(0,0)),FieldMapVertex(vec2(1,0)),FieldMapVertex(vec2(0,1)),FieldMapVertex(vec2(1,1))],[u32(0),u32(1),u32(2),u32(2),u32(1),u32(3)])
        empty: FieldMapBlock[]
        field_map_blocks_buffer = instance_buffer(empty)
        tex = texture(image(FIELD_MAP_SIZE,FIELD_MAP_SIZE),true)
        set_repeat(tex,true)
        fbo = gl_create_framebuffer()
        glBindFramebuffer(GL_FRAMEBUFFER,u32(fbo))
        glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,u32(tex.id),0)
        field_map_target = RenderTarget(tex,fbo,0)
        field_map_slots = [loop k in 0..FIELD_MAP_BLOCKS*FIELD_MAP_BLOCKS: ivec2(-999999,-999999)]
        field_map_lit = fill(0,FIELD_MAP_BLOCKS*FIELD_MAP_BLOCKS)
        field_map_ready = true
    # (the shadows' light: the canopy light's bearing, held low; a turn of a few degrees and the
    # blocks are redrawn, their old shadows standing meanwhile)
    h = vec2(canopy.x,canopy.z)
    toward = if length(h) > 0.001: normalize(h) else: vec2(0,1)
    light = vec4(toward.x,toward.y,field_palette,6.0/max(canopy.y,0.3)*canopy.w)
    if dot(light.xy,field_map_light.xy) < 0.9986 or abs(light.w-field_map_light.w) > 0.5:
        field_map_light = light; field_map_light_count += 1
    block_m = f64(FIELD_MAP_BLOCK)*FIELD_MAP_TEXEL
    half = FIELD_MAP_BLOCKS/2
    cx = int(floor(f64(cam.x)/block_m)); cz = int(floor(f64(cam.z)/block_m))
    # ring by ring out from the camera's block: the ones a slot doesn't hold are drawn (a few dozen
    # a frame), then the stale-lit ones; the window is the rings all held
    blocks: FieldMapBlock[]
    held = -1
    loop ring in 0..half+1:
        whole = true
        loop j in -ring..ring+1:
            loop i in -ring..ring+1:
                if max(abs(i),abs(j)) != ring or i >= half or j >= half: continue
                wb = ivec2(cx+i,cz+j)
                sx = ((wb.x%FIELD_MAP_BLOCKS)+FIELD_MAP_BLOCKS)%FIELD_MAP_BLOCKS
                sz = ((wb.y%FIELD_MAP_BLOCKS)+FIELD_MAP_BLOCKS)%FIELD_MAP_BLOCKS
                slot = sz*FIELD_MAP_BLOCKS+sx
                there = field_map_slots[slot] == wb
                if there and field_map_lit[slot] == field_map_light_count: continue
                if blocks.len() >= FIELD_MAP_PER_FRAME:
                    if not there: whole = false
                    continue
                field_map_slots[slot] = wb; field_map_lit[slot] = field_map_light_count
                r = f32(1.0/f64(FIELD_MAP_BLOCKS))
                blocks.push(FieldMapBlock(vec4(f32(sx)*r,f32(sz)*r,f32(sx+1)*r,f32(sz+1)*r),vec4(f32(f64(wb.x)*block_m),f32(f64(wb.y)*block_m),f32(block_m),f32(block_m))))
        if not whole: break
        held = ring
    # (the last ring is cut short on its high side: the window has an even number of blocks)
    lo = min(held,half); hi = min(held+1,half)
    field_map_window = if held < 0: vec4(0,0,0,f32(field_map_span())) else: vec4(f32(f64(cx-lo)*block_m),f32(f64(cz-lo)*block_m),f32(f64(lo+hi)*block_m),f32(field_map_span()))
    if blocks.len() == 0: return
    zone("field map")
    set_instances(field_map_blocks_buffer,blocks)
    glBindFramebuffer(GL_FRAMEBUFFER,u32(field_map_target.fbo))
    glViewport(0,0,i32(FIELD_MAP_SIZE),i32(FIELD_MAP_SIZE))
    glDisable(GL_DEPTH_TEST); glDepthMask(0); glDisable(GL_CULL_FACE); glDisable(GL_BLEND)
    draw_instanced(field_map_sh,field_map_quad,field_map_blocks_buffer,FieldMapParams(coast_pattern_texture,field_map_light))
    # (back to what the frame draws into: the post effects' picture, or the screen without them)
    __bind_current()
    glEnable(GL_DEPTH_TEST); glDepthMask(1)
    glEnable(GL_BLEND); glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA)
    set_mipmaps(field_map_target.texture,true)
    zone_end()

# The map for a ground draw: its texture (a 1x1 stand-in before the first update) and window.
field_map_texture = () -> Texture: if field_map_ready: field_map_target.texture else: unread_field_map()
field_map_unread: Texture = Texture()
unread_field_map = () -> Texture:
    global field_map_unread
    if field_map_unread.id == 0: field_map_unread = texture(image(1,1),false)
    field_map_unread
