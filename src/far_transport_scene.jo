# Existing economic sea journeys materialized through the vessel API. The saved far journey
# remains the motion owner; external=true prevents a second vessel integrator. Damage stops
# that journey at its actual pose until the strategic outcome transaction consumes it.
use 'vessel_types.jo'
use 'vessels.jo'
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_transport.jo'
use 'living_guard.jo'
use 'living_scene_surface.jo'

const FAR_VESSEL_BASE = 600000000
const FAR_NEAR_SHIPS = 16

far_scene_hull_radius = (kind: VesselKind) -> f64:
    spec=vessel_spec(kind)
    sqrt(spec.length*spec.length+spec.beam*spec.beam)*0.5

const FAR_SCENE_REACH = 12000.0      # (metres from the observer: a coaster takes a hull inside this)
const FAR_SCENE_LEAVE = 12500.0      # (and gives it up outside this: no in and out at the edge)
const FAR_SCENE_CLEAR = 4.0          # (metres of water wanted round a hull newly taken)

# Where a far ship is at this tick. One the scene moves (a lease) is there already. One the
# world's minute moves was put where it was at its journey's last tick and has sailed on since,
# up to a world minute (13 m at a coaster's speed): compared where the minute left it, a ship
# 26 m astern of a leased one seemed to drop back clear of it and close up again every minute.
far_scene_ship_now = (w: World, v: FarVehicle) -> vec3:
    if v.scene_owned or v.journey<0 or v.battle>=0 or v.motion_blocked!="" or not (v.journey in w.far.journeys): return v.pos
    age=w.tick-w.far.journeys[v.journey].last_tick
    # (a journey nothing has moved for two minutes is held where it is, whatever its velocity says)
    if age<=0 or age>240: return v.pos
    v.pos+v.velocity*f32(f64(age)/60.0)

# Coasters put out a world minute apart and sail the same water 13 m apart, three or four from
# one port, and several reciprocal services can share an abstract anchorage: the far economy
# keeps no distance between its ships. The scene gives hulls only to ships whose footprints are
# distinct, rather than drawing and colliding several in the same water; the others keep their
# actual goods and abstract ownership, and none is offset or teleported.
# Which of them have the hulls must not change while they sail in company. A hull once taken is
# kept until its ship leaves the reach or actually fouls another hull; a ship without one takes
# one only clear of every hull kept. (Chosen afresh each quarter second from the nearest outward,
# the choice changed with every turn of the observer and every world minute: two hulls 39 m apart
# became the one ship between them and then two again, and one 26 m off came and went.)
# (`hidden`: a ship the scene stands another hull in for, radio_help.jo's rescuer: not drawn)
far_scene_ship_candidates = (fleet: VesselFleet, w: World, observer: vec3, max_ships: int, hidden: int = -1) -> int[]:
    if max_ships<=0: return []
    leased: {int: bool}
    occupied: (vec3,f64)[]
    loop ship in fleet.ships:
        if ship.id>=FAR_VESSEL_BASE and ship.id<FAR_VESSEL_BASE+2048: leased[ship.id-FAR_VESSEL_BASE]=true
        else if ship.status!=.sunk: occupied.push((ship.position,far_scene_hull_radius(ship.kind)))
    candidates: int[]; now: {int: vec3}; away: {int: f64}
    loop v in w.far.vehicles:
        # (a minute's sailing at most from where it was put: the far ones need no nearer look)
        if v.kind!=.ship or v.hull<=0 or v.id==hidden or f64(length(v.pos-observer))>FAR_SCENE_LEAVE+50.0: continue
        at=far_scene_ship_now(w,v); d=f64(length(at-observer))
        if d<(if v.id in leased: FAR_SCENE_LEAVE else: FAR_SCENE_REACH): candidates.push(v.id); now[v.id]=at; away[v.id]=d
    positions=w.far.vehicles
    # Keep both sides of an active nearby contact ahead of idle traffic.
    last_contact=w.war.next_contact
    nearest=(id: int) -> (int,f64,int): (if positions[id].battle>=0 and away[id]<6000: positions[id].battle else: last_contact,away[id],id)
    candidates.sort(nearest)
    # The order hulls are given in: a nearby contact's two sides, then the hulls already out,
    # then the ships without one; each nearest first.
    order=candidates
    order.sort((id: int): (if positions[id].battle>=0 and away[id]<6000: 0 else: if id in leased: 1 else: 2,nearest(id)))
    chosen: {int: bool}; radius=far_scene_hull_radius(.trehantiri)
    loop id in order:
        margin=if id in leased: 0.0 else: FAR_SCENE_CLEAR
        clear=true
        loop circle in occupied:
            if f64(length(now[id].xz-circle.0.xz))<radius+circle.1+margin: clear=false; break
        if not clear: continue
        chosen[id]=true; occupied.push((now[id],radius))
    # (more of them than the scene's bound: the nearest have the hulls, as before)
    result: int[]
    loop id in candidates:
        if id in chosen and result.len()<min(max_ships,FAR_NEAR_SHIPS): result.push(id)
    result

sync_far_vessels = (fleet: mut VesselFleet, w: mut World, observer: vec3, max_ships: int = FAR_NEAR_SHIPS, refresh: bool = true, hidden: int = -1):
    if not w.far.populated: return
    prepare_scene_surface()
    # Admission is a bounded quarter-second scene query in the game. Existing leases
    # still move and commit damage every frame; leaving view always folds immediately.
    candidates: int[]
    if refresh: candidates=far_scene_ship_candidates(fleet,w,observer,max_ships,hidden)
    else:
        loop ship in fleet.ships:
            id=ship.id-FAR_VESSEL_BASE
            if candidates.len()<min(max_ships,FAR_NEAR_SHIPS) and id>=0 and id!=hidden and id<w.far.vehicles.len() and w.far.vehicles[id].hull>0 and length(w.far.vehicles[id].pos-observer)<FAR_SCENE_LEAVE: candidates.push(id)
    old: int[]
    loop ship in fleet.ships:
        if ship.id>=FAR_VESSEL_BASE and ship.id<FAR_VESSEL_BASE+2048 and not ((ship.id-FAR_VESSEL_BASE) in candidates): old.push(ship.id)
    loop id in old:
        k=vessel_index(fleet,id); v=id-FAR_VESSEL_BASE
        if k<0 or v>=w.far.vehicles.len(): continue
        ship=fleet.ships[k]; body=w.far.vehicles[v]
        # Fold damage even when this is the first frame out of view. A newer explicit
        # coarse repair still owns its revision over an older physical body.
        if ship.seen_tick>=body.revision and ship.health*1000.0<f64(body.hull)-1:
            w.far.vehicles[v].hull=max(0,int(round(ship.health*1000.0)))
            w.far.vehicles[v].pos=ship.position; w.far.vehicles[v].velocity=vec3(0,0,0)
            w.far.vehicles[v].motion_blocked="Physical damage stopped this same hull."
        w.far.vehicles[v].scene_extension=to_text(fleet.ships[k])
        w.far.vehicles[v].scene_owned=false
        if w.far.vehicles[v].journey>=0: w.far.journeys[w.far.vehicles[v].journey].last_tick=w.tick
        retire_vessel(fleet,id)
    loop id in candidates:
        v=w.far.vehicles[id]; body=FAR_VESSEL_BASE+id
        k=vessel_index(fleet,body)
        if k<0:
            ship=Vessel(id=body,kind=.trehantiri,owner=v.account,side=200+v.citizen,position=v.pos,external=true,status=.anchored)
            if v.scene_extension!="":
                saved=from_text[Vessel](v.scene_extension)
                if saved is Vessel and saved.id==body: ship=saved
            if length(v.velocity)>0.01: ship.yaw=atan2(f64(v.velocity.x),f64(v.velocity.z))
            if not vessel_footprint_using(ship,v.pos.xz,ship.yaw,scene_depth_ok): continue
            # The hull is the economic coaster, with account-title ownership and cohort crew.
            # No synthetic Person IDs are inserted into crew; strategic rescue retains cohorts.
            if not spawn_vessel(fleet,ship): continue
            k=vessel_index(fleet,body)
        ship=fleet.ships[k]
        if v.revision>ship.seen_tick:
            ship.health=f64(v.hull)/1000.0; ship.seen_tick=v.revision
            if v.motion_blocked=="": ship.fire=0; ship.flooding=0
            fleet.ships[k]=ship
        if ship.health*1000.0<f64(v.hull)-1:
            w.far.vehicles[id].hull=max(0,int(round(ship.health*1000.0)))
            w.far.vehicles[id].pos=ship.position
            w.far.vehicles[id].velocity=vec3(0,0,0)
            w.far.vehicles[id].motion_blocked="Physical damage stopped this same hull."
            w.far.vehicles[id].scene_owned=true
            if v.journey>=0: w.far.journeys[v.journey].last_tick=w.tick
            w.far.vehicles[id].scene_extension=to_text(ship)
            # A hit changes the same physical hull; the war/recovery layer owns its outcome.
            continue
        if v.motion_blocked=="":
            if v.journey<0 and v.scene_owned and ship.position==v.pos and ship.velocity==v.velocity and ship.status==.anchored and ship.external: continue
            w.far.vehicles[id].scene_owned=true
            # The adapter owns the saved route interval near the player. The abstract minute
            # skips this lease; the vessel is external and cannot integrate it a second time.
            far_advance_transport(w,w.tick,id,true,(pos: vec3,velocity: vec3) -> bool:
                yaw=if length(velocity)>0.01: atan2(f64(velocity.x),f64(velocity.z)) else: ship.yaw
                vessel_footprint_using(ship,pos.xz,yaw,scene_depth_ok))
            v=w.far.vehicles[id]
            ship.position=v.pos; ship.velocity=v.velocity
            ship.speed=f64(length(v.velocity))
            if ship.speed>0.01: ship.yaw=atan2(f64(v.velocity.x),f64(v.velocity.z))
            ship.status=if v.journey>=0: VesselStatus.underway else: .anchored
            ship.external=true
            fleet.ships[k]=ship
