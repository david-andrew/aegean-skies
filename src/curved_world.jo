# Adapt existing shaders at their position boundary. This deliberately calls the
# original vertex/fragment functions so concurrent material/wake work is kept.
# Every material still receives FLAT world coordinates for phase and placement.
use 'render_space.jo'
use 'look.jo'
use 'objects.jo'
use 'grass.jo'
use 'birds.jo'
use 'clouds.jo'
use 'wake.jo'
use 'trails.jo'
use 'shadow.jo'

curved_obj_vs = (v: Vertex3D, u: ObjParams) -> ObjOut:
    o = obj_vs(v, u)
    o.pos = u.view_proj * vec4(render_warped(o.world, u.cam, u.warp_a, u.warp_b), 1)
    o.normal = render_normal(o.normal, o.world, u.cam)
    o
curved_obj_inst = (v: Vertex3D, inst: Instance3D, u: ObjParams) -> ObjOut:
    o = obj_vs_inst(v, inst, u)
    o.pos = u.view_proj * vec4(render_warped(o.world, u.cam, u.warp_a, u.warp_b), 1)
    o.normal = render_normal(o.normal, o.world, u.cam)
    o
curved_obj_fs = (i: ObjOut, u: ObjParams) -> vec4:
    if behind_sea(i.world, u.cam): discard()
    obj_fs(i, u)
curved_grass_vs = (v: Vertex3D, inst: Instance3D, u: ObjParams) -> ObjOut:
    o = grass_vs(v, inst, u)
    o.pos = u.view_proj * vec4(render_warped(o.world, u.cam, u.warp_a, u.warp_b), 1)
    o.normal = render_normal(o.normal, o.world, u.cam)
    o
curved_bird_vs = (v: Vertex3D, inst: Instance3D, u: BirdParams) -> ObjOut:
    o = bird_vs(v, inst, u)
    o.pos = u.view_proj * vec4(render_warped(o.world, u.cam, u.warp_a, u.warp_b), 1)
    o.normal = render_normal(o.normal, o.world, u.cam)
    o
curved_bird_fs = (i: ObjOut, u: BirdParams) -> vec4:
    if behind_sea(i.world, u.cam): discard()
    bird_fs(i, u)
curved_cloud_vs = (v: Vertex3D, inst: Puff, u: CloudParams) -> CloudOut:
    o = cloud_vs(v, inst, u)
    o.pos = u.view_proj * vec4(render_warped(o.world, u.cam, u.warp_a, u.warp_b), 1)
    o.normal = render_normal(o.normal, o.world, u.cam)
    o
curved_cloud_fs = (i: CloudOut, u: CloudParams) -> vec4:
    if behind_sea(i.world, u.cam): discard()
    cloud_fs(i, u)
curved_wake_vs = (v: Vertex3D, u: WakeParams) -> WakeOut:
    o = wake_vs(v, u)
    o.pos = u.view_proj * vec4(render_warped(o.world, u.cam, u.warp_a, u.warp_b), 1)
    o.normal = render_normal(o.normal, o.world, u.cam)
    o
curved_trail_vs = (v: TrailVertex, u: TrailParams) -> TrailOut:
    o = trail_vs(v, u)
    o.pos = u.view_proj * vec4(render_warped(o.world, u.cam, u.warp_a, u.warp_b), 1)
    o

# ShadowParams has no camera; extend it locally instead of changing the shadow material.
struct CurvedShadowParams:
    original: ShadowParams
    cam: vec3
    warp_a: vec4
    warp_b: vec4
curved_shadow_vs = (v: Vertex3D, u: CurvedShadowParams) -> ShadowOut:
    w = u.original.model * vec4(v.pos, 1)
    s = normalize(u.original.sun)
    t = (w.y - u.original.ground) / max(s.y, 0.2)
    p = vec3(w.x - s.x * t, u.original.ground + 0.07, w.z - s.z * t)
    ShadowOut(u.original.view_proj * vec4(render_warped(p, u.cam, u.warp_a, u.warp_b), 1))
curved_shadow_fs = (i: ShadowOut, u: CurvedShadowParams) -> vec4: u.original.color

# Standard meshes (the mooring line) use the same chart, too.
curved_lit_vs = (v: Vertex3D, u: LitParams) -> LitOut:
    o = lit_vs(v, u)
    o.pos = u.view_proj * vec4(render_world(o.world, u.cam_pos), 1)
    o.normal = render_normal(o.normal, o.world, u.cam_pos)
    o

curved_lit_inst = (v: Vertex3D, inst: Instance3D, u: LitParams) -> LitOut:
    o = lit_vs_inst(v, inst, u)
    o.pos = u.view_proj * vec4(render_world(o.world, u.cam_pos), 1)
    o.normal = render_normal(o.normal, o.world, u.cam_pos)
    o
curved_lit_skin = (v: SkinVertex3D, u: LitParams) -> LitOut:
    o = lit_vs_skin(v, u)
    o.pos = u.view_proj * vec4(render_world(o.world, u.cam_pos), 1)
    o.normal = render_normal(o.normal, o.world, u.cam_pos)
    o
curved_lit_fs = (i: LitOut, u: LitParams) -> vec4:
    if behind_sea(i.world, u.cam_pos): discard()
    lit_fs(i, u)

curved_shadow_sh: Shader

init_curved_world = ():
    global obj_sh, obj_inst_sh, grass_sh, bird_sh, cloud_sh, wake_sh, trail_sh, curved_shadow_sh, __lit, __lit_inst, __lit_skin
    # The engine lazily initializes standard shaders; initialize before replacing
    # these three handles so its first 3D pass cannot overwrite the chart.
    __3d_init()
    obj_sh = make_shader(shader(curved_obj_vs, curved_obj_fs))
    obj_inst_sh = make_shader(shader(curved_obj_inst, curved_obj_fs))
    grass_sh = make_shader(shader(curved_grass_vs, curved_obj_fs))
    bird_sh = make_shader(shader(curved_bird_vs, curved_bird_fs))
    cloud_sh = make_shader(shader(curved_cloud_vs, curved_cloud_fs))
    wake_sh = make_shader(shader(curved_wake_vs, wake_fs))
    trail_sh = make_shader(shader(curved_trail_vs, trail_fs))
    curved_shadow_sh = make_shader(shader(curved_shadow_vs, curved_shadow_fs))
    __lit = make_shader(shader(curved_lit_vs, curved_lit_fs))
    __lit_inst = make_shader(shader(curved_lit_inst, curved_lit_fs))
    __lit_skin = make_shader(shader(curved_lit_skin, curved_lit_fs))

draw_curved_particles = (ps: Particles3D, glow: bool):
    bent = ps
    cam = scene_camera()
    loop mut p in bent.items: p.pos = render_warped(p.pos, cam, scene_warp_a, scene_warp_b)
    bent.draw(glow)

draw_curved_shadow = (m: Mesh, model: mat4, g: f64, height: f64, L: Light):
    if L.sun_dir.y < 0.05: return
    a = 0.42 * (1.0 - smoothstep(60.0, 420.0, height)) * smoothstep(0.05, 0.2, f64(L.sun_dir.y))
    if a < 0.01: return
    glDepthMask(1)
    glDepthFunc(GL_LESS)
    p = ShadowParams(scene_view_proj(), model, L.sun_dir, f32(g), vec4(0.0, 0.05, 0.12, f32(a)))
    draw(curved_shadow_sh, m, CurvedShadowParams(p, scene_camera(), scene_warp_a, scene_warp_b))
    glDepthFunc(GL_LEQUAL)
    glDepthMask(0)
