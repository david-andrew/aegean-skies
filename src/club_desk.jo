# The flying club's table on the quay of a capital's air meeting: a trestle table with the entry
# sheet and a cash box, the club's flag on a pole beside it, and the club's clerk behind it, from
# the morning of the meeting day until the race starts. Entries are taken there, on foot at the
# table: the race is found by going to the quay, not offered from the sky.
use 'air_race.jo'
use 'objects.jo'
use 'look.jo'

const CLUB_DESK_REACH = 4.0         # metres from the table to give one's name

struct ClubDeskView:
    desk: Mesh
    ready = false

# Where the table stands for a meet: on its quay, inland of the spectators' line, at the middle (none
# when the meet has no quay).
club_desk_at = (meet: AirMeet) -> vec3?:
    along = meet.quay_b-meet.quay_a
    if f64(length(along)) < 1.0: return none
    dir = normalize(along); inland = vec3(-dir.z,0,dir.x)
    (meet.quay_a+meet.quay_b)*0.5+inland*3.5

# The way the clerk faces (out over the table toward the water) as a yaw.
club_desk_yaw = (meet: AirMeet) -> f64:
    dir = normalize(meet.quay_b-meet.quay_a+vec3(0.0001,0,0)); inland = vec3(-dir.z,0,dir.x)
    atan2(f64(-inland.x),f64(-inland.z))

# Open for entries: before the race starts.
club_desk_open = (meet: AirMeet, tick: int) -> bool: meet.phase == .registration and tick < meet.race_tick and meet.gates.len() > 0

club_desk_near = (meet: AirMeet, position: vec3) -> bool:
    if let at = club_desk_at(meet): f64(length(vec2(at.x-position.x,at.z-position.z))) < CLUB_DESK_REACH else: false

make_club_desk = () -> ClubDeskView:
    vs: Vertex3D[]
    wood = rgb(0.45,0.32,0.19); cloth = rgb(0.86,0.83,0.74)
    # (the trestle table, a cloth over it, the entry sheet and the cash box on it)
    add_box(vs,vec3(0,0.74,0),vec3(1.8,0.06,0.8),cloth)
    loop x in [-0.75,0.75]:
        loop z in [-0.3,0.3]: add_box(vs,vec3(f32(x),0.36,f32(z)),vec3(0.06,0.72,0.06),wood)
    add_box(vs,vec3(-0.3,0.78,0.05),vec3(0.42,0.01,0.3),rgb(0.97,0.96,0.9))
    add_box(vs,vec3(0.5,0.84,-0.05),vec3(0.36,0.16,0.24),rgb(0.30,0.20,0.12))
    # (the club's pennant on its pole: a long maroon streamer narrowing to its tail, a cream edge)
    add_box(vs,vec3(1.3,1.7,-0.3),vec3(0.06,3.4,0.06),wood)
    maroon = rgb(0.45,0.10,0.12)
    loop k in 0..4:
        x = 1.33+f64(k)*0.36+0.18
        hgt = 0.62-f64(k)*0.13
        add_box(vs,vec3(f32(x),3.1,-0.3),vec3(0.36,f32(hgt),0.02),maroon)
    add_box(vs,vec3(1.36,3.1,-0.29),vec3(0.06,0.64,0.02),rgb(0.93,0.89,0.72))
    ClubDeskView(custom_mesh(vs),true)

# The tables of the meets open for entries near `observer`.
club_desks = (events: AirEvents, tick: int, observer: vec3) -> (vec3,f64)[]:
    out: (vec3,f64)[]
    loop meet in events.meets:
        if not club_desk_open(meet,tick): continue
        if let at = club_desk_at(meet):
            if f64(length(at-observer)) < 600.0: out.push((at,club_desk_yaw(meet)))
    out

draw_club_desks = (view: ClubDeskView, desks: (vec3,f64)[], L: Light, t: f64):
    loop d in desks: draw(obj_sh,view.desk,obj_params(L,t,translation(d.0)*rotation_y(d.1)))
