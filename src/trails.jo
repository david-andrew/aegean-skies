# Vapor trails: a thin white stream off each wingtip while the wings pull hard in damp air, a
# ribbon facing the camera that thins and fades behind the aircraft.

use 'look.jo'
use 'render_space.jo'

const TRAIL_LIFE = 2.2

struct TrailPoint:
    pos: vec3
    born: f64
    strength: f32

struct Trail:
    pts: TrailPoint[]
    on = false

# add the wingtip's place now (strength 0..1: how hard it is pulling); a gap when it stops
trail_step = (tr: mut Trail, pos: vec3, strength: f64, t: f64):
    loop tr.pts.len() > 0 and t - tr.pts[0].born > TRAIL_LIFE: tr.pts.remove_at(0)
    if strength <= 0.0:
        if tr.on and tr.pts.len() > 0:
            p = tr.pts[tr.pts.len() - 1]
            tr.pts.push(TrailPoint(p.pos, p.born, 0.0))
        tr.on = false
        return
    if not tr.on and tr.pts.len() > 0: tr.pts.push(TrailPoint(pos, t, 0.0))
    tr.on = true
    tr.pts.push(TrailPoint(pos, t, f32(strength)))

struct TrailVertex:
    pos: vec3
    data: vec4                      # x across (-1..1), y age, z strength

struct TrailParams:
    view_proj: mat4
    cam: vec3
    sun: vec3
    sky: vec3
    haze: vec3
    fog: f32
    warp_a: vec4                    # (the speed trial's warp: render_space.jo)
    warp_b: vec4

struct TrailOut:
    pos: vec4
    world: vec3
    data: vec4

trail_vs = (v: TrailVertex, u: TrailParams) -> TrailOut: TrailOut(u.view_proj * vec4(v.pos, 1), v.pos, v.data)

trail_fs = (i: TrailOut, u: TrailParams) -> vec4:
    across = abs(i.data.x)
    fade = (1.0 - smoothstep(0.0, TRAIL_LIFE, i.data.y)) * i.data.z
    a = (1.0 - smoothstep(0.2, 1.0, across)) * fade * 0.75
    if a < 0.01: discard()
    c = vec3(1, 1, 1) * (u.sun * 0.8 + u.sky * 0.4)
    vec4(aerial(c, i.world, u.cam, u.haze, u.fog), a)

trail_sh: Shader
trail_mesh: Mesh
trail_ready = false

init_trails = ():
    global trail_sh, trail_mesh, trail_ready
    trail_sh = make_shader(shader(trail_vs, trail_fs))
    trail_mesh = mesh([TrailVertex(vec3(0, 0, 0), vec4(0, 0, 0, 0)), TrailVertex(vec3(0, 0, 0), vec4(0, 0, 0, 0)), TrailVertex(vec3(0, 0, 0), vec4(0, 0, 0, 0))])
    trail_ready = true

draw_trails = (trails: Trail[], L: Light, t: f64):
    if not trail_ready: return
    cam = scene_camera()
    vs: TrailVertex[]
    loop tr in trails:
        loop k in 0..tr.pts.len() - 1:
            a = tr.pts[k]
            b = tr.pts[k + 1]
            if a.strength <= 0.0 and b.strength <= 0.0: continue
            d = b.pos - a.pos
            if length(d) < 0.001: continue
            view = normalize((a.pos + b.pos) * 0.5 - cam)
            side = normalize(cross(d, view))
            la = t - a.born
            lb = t - b.born
            wa = f32(0.07 + la * 0.25)
            wb = f32(0.07 + lb * 0.25)
            a0 = TrailVertex(a.pos - side * wa, vec4(-1, f32(la), a.strength, 0))
            a1 = TrailVertex(a.pos + side * wa, vec4(1, f32(la), a.strength, 0))
            b0 = TrailVertex(b.pos - side * wb, vec4(-1, f32(lb), b.strength, 0))
            b1 = TrailVertex(b.pos + side * wb, vec4(1, f32(lb), b.strength, 0))
            vs.push(a0); vs.push(b0); vs.push(a1)
            vs.push(a1); vs.push(b0); vs.push(b1)
    if vs.len() < 3: return
    update_mesh(trail_mesh, vs)
    draw(trail_sh, trail_mesh, TrailParams(scene_view_proj(), cam, L.sun, L.sky_top, L.haze, f32(L.fog_density), scene_warp_a, scene_warp_b))
