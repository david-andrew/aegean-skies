# Score-driven procedural orchestra. No recordings or soundfonts. Fixed 64-voice ceiling;
# only the selected score is decoded. Reverb storage and waveform tables are bounded.
use 'music_data.jo'
use 'music_models.jo'
const MUSIC_RATE = 16000
const MUSIC_TABLE = 512
const MUSIC_VOICES = 64
const MUSIC_KINDS = MUSIC_MODEL_KINDS
# Exact f64 bodies: 64 half-second prefixes use 4 MiB. No velocity quantization.
const MUSIC_BODY_SLOTS = 64
const MUSIC_BODY_FRAMES = 8192
const MUSIC_RENDER_BLOCK = 128

enum MusicInstrument: strings, brass, flute, oboe, clarinet, bassoon, piano, harp, bouzouki, accordion, banjo, timpani, drums, bass, choir, trumpet

struct MusicEvent:
    start: int
    duration: int
    pitch: int
    instrument: int
    gain: f64
    end_gain: f64
    peak_gain = -1.0
    peak_fraction = 0.4
    mix_gain = 1.0
    mix_end_gain = 1.0
    section = -1                  # optional score desk; -1 keeps the previous source

struct MusicVoice:
    active = false
    instrument: MusicInstrument = .strings
    partials = 0
    body = -1
    mode = 0                       # harmonic bow/wind source, or decaying string/membrane modes
    age = 0
    duration = 1
    release = 800
    phase = 0.0
    phase2 = 0.0
    phase3 = 0.0
    increment = 0.0
    gain = 0.0
    gain_step = 0.0
    peak_age = 0
    late_step = 0.0
    tone_low = 0.0
    peak_level = 1.0
    attack_env = 0.0
    attack_rate = 0.99
    gate = 1.0
    release_rate = 0.99
    morph = 1.0
    vibrato = 0.0
    vibrato_step = 0.0
    vibrato_depth = 0.0
    noise = 0.0
    transient = 0.0
    noise_low = 0.0
    noise_body = 0.0
    noise_hz = 0.2
    noise_rng: u64 = 17
    noise_env = 1.0
    noise_decay = 1.0
    tremor = 0.0

struct MusicMode:
    y1 = 0.0
    y2 = 0.0
    coefficient = 0.0
    fast = 0.0
    slow = 0.0
    decay_fast = 0.0
    decay_slow = 0.0

# Independent lip state only used by the solo trumpet; other voices keep their
# original source, noise sequence and storage layout.
struct MusicLip:
    rng: u64 = 23
    target = 0.0
    motion = 0.0

struct MusicBody:
    used = false
    instrument = 0
    pitch = 0
    velocity = 0.0
    origin = 0                    # analytic seek initialization is distinct from replay
    length = 0
    partials = 0
    stamp = 0

struct MusicSynth:
    piece = -1
    events: MusicEvent[]
    next = 0
    cursor = 0
    frames = 1
    lookback = 0
    voices: MusicVoice[]
    lips: MusicLip[]
    concert_hall = false
    hall_early: f64[]
    hall_feedback: f64[]
    models: MusicModels = MusicModels()
    sine: f64[]
    waves: f32[]
    modes: MusicMode[]
    cache_enabled = true
    wave_keys: MusicBody[]
    wave_cache: f32[]
    wave_hits = 0
    wave_misses = 0
    bodies: MusicBody[]
    body_samples: f64[]
    body_modes: MusicMode[]
    body_work: f64[]
    body_clock = 0
    body_hits = 0
    body_misses = 0
    body_frames = 0
    pitches: f64[]
    delays: f64[][]
    damp: f64[]
    reverb_at = 0
    fade = 0
    stolen = 0
    gain = 1.0
    wet = 0.18

music_u32 = (b: u8[], at: int) -> int:
    int(b[at])+int(b[at+1])*256+int(b[at+2])*65536+int(b[at+3])*16777216

make_music_synth = () -> MusicSynth:
    s = MusicSynth()
    s.models = make_music_models()
    s.pitches = [loop n in 0..128: 440.0*pow(2.0,f64(n-69)/12.0)]
    s.voices = fill(MusicVoice(),MUSIC_VOICES)
    s.lips = fill(MusicLip(),MUSIC_VOICES)
    s.sine = [loop i in 0..MUSIC_TABLE: sin(TAU*f64(i)/f64(MUSIC_TABLE))]
    s.waves = fill(f32(0),MUSIC_VOICES*2*MUSIC_TABLE)
    s.modes = fill(MusicMode(),MUSIC_VOICES*MUSIC_PARTIALS)
    s.wave_keys = fill(MusicBody(),MUSIC_BODY_SLOTS)
    s.wave_cache = fill(f32(0),MUSIC_BODY_SLOTS*2*MUSIC_TABLE)
    s.bodies = fill(MusicBody(),MUSIC_BODY_SLOTS)
    s.body_samples = fill(0.0,MUSIC_BODY_SLOTS*MUSIC_BODY_FRAMES)
    s.body_modes = fill(MusicMode(),MUSIC_BODY_SLOTS*MUSIC_PARTIALS)
    s.body_work = fill(0.0,MUSIC_RENDER_BLOCK)
    s.delays = [fill(0.0,479),fill(0.0,631),fill(0.0,797),fill(0.0,941),fill(0.0,89),fill(0.0,127)]
    s.damp = fill(0.0,4)
    s

music_sine = (sine: f64[], phase: f64) -> f64:
    p = (phase-f64(int(phase)))*f64(MUSIC_TABLE); i = int(p)
    sine[i]+(sine[(i+1)%MUSIC_TABLE]-sine[i])*(p-f64(i))

music_load = (s: mut MusicSynth, piece: int):
    if piece == s.piece: return
    s.events = []
    s.piece = clamp(piece,0,MUSIC_PIECES.len()-1)
    concert = s.piece == 0 or s.piece == 1
    if concert != s.concert_hall:
        s.concert_hall = concert
        lengths = if concert: [1499,1747,1999,2239,239,379] else: [479,631,797,941,89,127]
        s.delays = [loop length in lengths: fill(0.0,length)]
        s.hall_early = if concert: fill(0.0,2048) else: []
        # Equal low-frequency T60 across the unequal prime delays; highs die sooner.
        s.hall_feedback = [loop k in 0..4: exp(-6.907755278982137*f64(lengths[k])/(3.0*f64(MUSIC_RATE)))]
    # Fixed orchestra balances; retain each score's internal dynamic range.
    balances = [0.70,0.90,0.40,0.70,0.22,1.2,0.55,0.60,0.60,0.38,0.85,0.30]
    s.gain = balances[s.piece]
    if let b = inflate(music_bytes(s.piece)):
        assert(b.len() >= 16 and b[0] == 77 and b[1] == 85 and b[2] == 83 and (b[3] >= 49 and b[3] <= 52))
        count = music_u32(b,4)
        stride = if b[3] >= 51: 16 else: if b[3] == 50: 14 else: 12
        assert(count <= 50000 and b.len() == 16+count*stride)
        s.frames = music_u32(b,8); s.lookback = music_u32(b,12)
        loop i in 0..count:
            at = 16+i*stride
            s.events.push(MusicEvent(music_u32(b,at),music_u32(b,at+4),int(b[at+8]),if b[3] == 52:int(b[at+9]) & 15 else:int(b[at+9]),f64(b[at+10])/100.0,f64(b[at+11])/100.0,if b[3] == 50: f64(b[at+12])/100.0 else: -1.0,if b[3] == 50: f64(b[at+13])/100.0 else: 0.4,if b[3] >= 51: f64(int(b[at+12])+int(b[at+13])*256)/4096.0 else: 1.0,if b[3] >= 51: f64(int(b[at+14])+int(b[at+15])*256)/4096.0 else: 1.0,if b[3] == 52:int(b[at+9])/16-1 else:-1))
    assert(s.events.len() > 0)

music_start = (s: mut MusicSynth, e: MusicEvent, age: int):
    kind = MusicInstrument(e.instrument)
    velocity = clamp((if e.peak_gain >= 0: max(e.gain,max(e.peak_gain,e.end_gain)) else: e.gain)*127.0,1.0,127.0)
    blend = music_blend(s.models,e.instrument,e.pitch,velocity)
    models = s.models
    parameter = (field: int) -> f64: music_parameter(models,blend,field)
    release = max(400,int(parameter(1)*3.0*f64(MUSIC_RATE)))
    if age >= e.duration+release: return
    slot = -1; oldest = -1
    loop k in 0..s.voices.len():
        if not s.voices[k].active: slot = k; break
        if s.voices[k].age > oldest: oldest = s.voices[k].age; slot = k
    if s.voices[slot].active: s.stolen += 1
    hz = s.pitches[clamp(e.pitch,0,127)]
    mode = if kind == .piano or kind == .timpani or kind == .drums or kind == .harp or kind == .bouzouki or kind == .banjo or kind == .bass: 1 else: 0
    attack = min(parameter(0),max(0.004,f64(e.duration)/f64(MUSIC_RATE)*0.35))
    loudness = parameter(7)*(if velocity < 45: pow(velocity/45.0,1.5) else: if velocity > 115: pow(velocity/115.0,1.4) else: 1.0)
    balances = [1.0,0.9,0.75,0.85,0.9,0.9,1.1,1.0,0.9,0.9,0.8,1.1,0.8,1.15,0.8,0.90]
    gain = 0.12*loudness*balances[e.instrument]
    end_gain = gain*clamp(e.end_gain/max(0.01,e.gain),0.15,3.0)
    if e.mix_gain != 1.0 or e.mix_end_gain != 1.0:
        gain *= e.mix_gain; end_gain *= e.mix_end_gain
    peak_age = e.duration
    first_step = (end_gain-gain)/f64(e.duration)
    late_step = 0.0
    initial = gain+first_step*f64(min(age,e.duration))
    peak_level = gain
    if e.peak_gain >= 0:
        peak_age = clamp(int(e.peak_fraction*f64(e.duration)),1,max(1,e.duration-1))
        top = max(e.gain,max(e.peak_gain,e.end_gain))
        start_level = gain*pow(2.0,(e.gain-top)*127.0/36.0)
        peak_level = gain*pow(2.0,(e.peak_gain-top)*127.0/36.0)
        end_level = gain*pow(2.0,(e.end_gain-top)*127.0/36.0)
        first_step = (peak_level-start_level)/f64(peak_age)
        late_step = (end_level-peak_level)/f64(max(1,e.duration-peak_age))
        initial = if age < peak_age: start_level+first_step*f64(age) else: peak_level+late_step*f64(min(age,e.duration)-peak_age)
    phase = f64(age)*hz/f64(MUSIC_RATE)
    phase_offset = f64((e.start*13+e.pitch*7919+e.instrument*101)%65536)/65536.0
    n = MusicVoice(active=true,instrument=kind,mode=mode,age=age,duration=e.duration,release=release,
        phase=(phase+phase_offset)%1.0,phase2=(phase*1.0031+phase_offset+0.31)%1.0,phase3=(phase*0.9963+phase_offset+0.67)%1.0,
        increment=hz/f64(MUSIC_RATE),gain=initial,gain_step=if age < peak_age: first_step else: late_step,peak_age=peak_age,late_step=late_step,peak_level=peak_level,
        attack_env=1.0-exp(-1.897*f64(age)/(attack*f64(MUSIC_RATE))),attack_rate=exp(-1.897/(attack*f64(MUSIC_RATE))),
        gate=exp(-6.9078*f64(max(0,age-e.duration))/f64(release)),release_rate=exp(-6.9078/f64(release)),
        morph=exp(-f64(age)/(0.25*f64(MUSIC_RATE))),vibrato=(phase_offset+f64(age)*parameter(5)/f64(MUSIC_RATE))%1.0,
        vibrato_step=parameter(5)/f64(MUSIC_RATE),vibrato_depth=pow(2.0,parameter(6)/1200.0)-1.0,
        noise=parameter(2),transient=parameter(3),noise_rng=u64(17+e.start+e.pitch*7919+slot*31),
        noise_env=exp(-f64(age)*(if mode == 0: 0.0 else: if kind == .drums or kind == .timpani: max(2.0,parameter(8)) else: 4.0)/f64(MUSIC_RATE)),
        noise_decay=exp(-(if mode == 0: 0.0 else: if kind == .drums or kind == .timpani: max(2.0,parameter(8)) else: 4.0)/f64(MUSIC_RATE)),noise_hz=if kind == .drums: 0.72 else: if kind == .strings: 0.28 else: 0.42)
    if kind == .strings and e.section >= 1:
        # Broad score effort drives a tiny sharpward desk bias. No new audio-rate
        # oscillator: the existing unequal player vibratos also supply faint tremor.
        intensity = clamp((max(e.gain*e.mix_gain,e.end_gain*e.mix_end_gain)-0.40)/0.40,0.0,1.0)
        if intensity > 0.0:
            desk = clamp(e.section,1,5)
            seconds = f64(e.start)/f64(MUSIC_RATE)
            cents = [0.0,2.0,2.4,1.4,1.8,1.1][desk]*intensity
            ratio = pow(2.0,cents/1200.0)
            n.increment *= ratio
            n.phase = (phase*ratio+phase_offset)%1.0
            n.phase2 = (phase*ratio*1.0031+phase_offset+0.31)%1.0
            n.phase3 = (phase*ratio*0.9963+phase_offset+0.67)%1.0
            n.vibrato = (n.vibrato+f64(desk)*0.113)%1.0
            n.vibrato_step *= 0.97+0.012*f64(desk)+0.025*sin(seconds*0.27+f64(desk))
            n.vibrato_depth *= 1.0+intensity*(0.10+0.08*sin(seconds*0.19+f64(desk)*0.8))
            n.tremor = 0.0035*intensity
    cached = if s.cache_enabled: music_cached_key(if mode == 0: s.wave_keys else: s.bodies,e.instrument,e.pitch,velocity,if mode == 0: 0 else: age) else: -1
    if cached >= 0:
        s.body_clock += 1
        if mode == 0:
            s.wave_keys[cached].stamp = s.body_clock
            s.wave_hits += 1
            loop i in 0..2*MUSIC_TABLE: s.waves[slot*2*MUSIC_TABLE+i] = s.wave_cache[cached*2*MUSIC_TABLE+i]
        else:
            n.body = cached; n.partials = s.bodies[cached].partials
            s.bodies[cached].stamp = s.body_clock
            s.body_hits += 1
    else:
        inharmonicity = parameter(4)
        if mode == 0:
            # Construct fresh analytic cycles from magnitudes. No measured phase is used.
            loop i in 0..MUSIC_TABLE*2: s.waves[slot*MUSIC_TABLE*2+i] = 0
        loop h in 0..MUSIC_PARTIALS:
            first = parameter(10+h); second = parameter(42+h)
            fast = parameter(74+h); slow = parameter(106+h)
            ratio = parameter(138+h)
            f = hz*ratio*sqrt(1.0+inharmonicity*ratio*ratio)
            # Coherent odd modes create a closed-bore reed pulse; brass uses a sharper
            # asymmetric source. These phases are analytic choices, never recorded phases.
            phi = if kind == .clarinet: 0.0 else: if kind == .trumpet: f64(h)*0.027 else: f64((h*173+e.instrument*67+e.pitch*19)%512)/512.0
            if f > 7100 or ratio < 0.1: first = 0; second = 0
            if mode == 1:
                if first+second < 0.000001: continue
                at = slot*MUSIC_PARTIALS+n.partials
                n.partials += 1
                s.modes[at] = MusicMode(
                    sin(TAU*(f*f64(age-1)/f64(MUSIC_RATE)+phi)),
                    sin(TAU*(f*f64(age-2)/f64(MUSIC_RATE)+phi)),
                    2.0*cos(TAU*min(f,7100.0)/f64(MUSIC_RATE)),
                    first*exp(-fast*f64(age)/f64(MUSIC_RATE)),
                    second*exp(-slow*f64(age)/f64(MUSIC_RATE)),
                    exp(-fast/f64(MUSIC_RATE)),exp(-slow/f64(MUSIC_RATE)))
            else if mode == 0:
                if first+second < 0.0001: continue
                offset = int(phi*f64(MUSIC_TABLE))
                loop i in 0..MUSIC_TABLE:
                    value = s.sine[(i*(h+1)+offset)%MUSIC_TABLE]
                    s.waves[slot*2*MUSIC_TABLE+i] += f32(value*first)
                    s.waves[(slot*2+1)*MUSIC_TABLE+i] += f32(value*second)
        if s.cache_enabled:
            if mode == 1: n.body = music_body_acquire(s,e.instrument,e.pitch,velocity,age,slot,n.partials)
            else:
                selected = 0
                loop i in 1..MUSIC_BODY_SLOTS:
                    if s.wave_keys[i].stamp < s.wave_keys[selected].stamp: selected = i
                s.body_clock += 1; s.wave_misses += 1
                s.wave_keys[selected] = MusicBody(true,e.instrument,e.pitch,velocity,0,0,0,s.body_clock)
                loop i in 0..2*MUSIC_TABLE: s.wave_cache[selected*2*MUSIC_TABLE+i] = s.waves[slot*2*MUSIC_TABLE+i]
    if kind == .trumpet:
        s.lips[slot] = MusicLip(u64(23+e.start+e.pitch*1543+slot*43),0,0)
    s.voices[slot] = n

# Binary search plus at most the longest note's overlap window. No replay from bar one.
# Seeking intentionally clears the hall tail; a 10 ms fade suppresses the discontinuity.
music_seek = (s: mut MusicSynth, seconds: f64):
    s.cursor = clamp(int(seconds*f64(MUSIC_RATE)),0,s.frames)
    s.voices = fill(MusicVoice(),MUSIC_VOICES)
    s.next = 0; s.fade = 0; s.stolen = 0
    loop k in 0..s.delays.len(): s.delays[k] = fill(0.0,s.delays[k].len())
    s.damp = fill(0.0,4); s.reverb_at = 0
    s.hall_early = fill(0.0,s.hall_early.len())
    low = 0; high = s.events.len()
    earliest = s.cursor-s.lookback
    loop low < high:
        middle = (low+high)/2
        if s.events[middle].start < earliest: low = middle+1
        else: high = middle
    s.next = low
    loop s.next < s.events.len() and s.events[s.next].start < s.cursor:
        e = s.events[s.next]
        music_start(s,e,s.cursor-e.start)
        s.next += 1

music_osc = (waves: f32[], slot: int, phase: f64, morph: f64) -> f64:
    p = phase*f64(MUSIC_TABLE); i = int(p); f = p-f64(i)
    at = slot*2*MUSIC_TABLE
    a = f64(waves[at+i])*(1.0-f)+f64(waves[at+(i+1)%MUSIC_TABLE])*f
    at += MUSIC_TABLE
    b = f64(waves[at+i])*(1.0-f)+f64(waves[at+(i+1)%MUSIC_TABLE])*f
    a*morph+b*(1.0-morph)

music_cached_key = (keys: MusicBody[], kind: int, pitch: int, velocity: f64, origin: int) -> int:
    loop k in 0..keys.len():
        b = keys[k]
        if b.used and b.instrument == kind and b.pitch == pitch and b.velocity == velocity and b.origin == origin: return k
    -1

# Pin entries only while a voice reads their prefix. Eviction never changes a live
# recurrence: at the prefix boundary its exact end state transfers back to the voice.
music_body_acquire = (s: mut MusicSynth, kind: int, pitch: int, velocity: f64, origin: int, voice: int, partials: int) -> int:
    s.body_clock += 1
    selected = -1; oldest = s.body_clock+1
    loop k in 0..MUSIC_BODY_SLOTS:
        pinned = false
        loop v in 0..MUSIC_VOICES:
            if v != voice and s.voices[v].active and s.voices[v].body == k: pinned = true; break
        if not pinned and (not s.bodies[k].used or s.bodies[k].stamp < oldest):
            selected = k; oldest = s.bodies[k].stamp
            if not s.bodies[k].used: break
    if selected < 0: return -1
    s.bodies[selected] = MusicBody(true,kind,pitch,velocity,origin,0,partials,s.body_clock)
    loop h in 0..partials: s.body_modes[selected*MUSIC_PARTIALS+h] = s.modes[voice*MUSIC_PARTIALS+h]
    s.body_misses += 1
    selected

# Interchange the independent sample/partial loops without changing any sample's
# summation order or recurrence arithmetic. No lookahead exceeds 128 samples.
# Two independent recurrences hide multiply latency on native CPUs. Add each term
# separately, in the original partial order; no reassociation or fused multiply-add.
music_mode_pair = (modes: mut MusicMode[], at: int, values: *f64, count: int) -> bool:
    a=modes[at];b=modes[at+1]
    lower_a=a.fast*(1.0-f64(count)*(1.0-a.decay_fast))+a.slow*(1.0-f64(count)*(1.0-a.decay_slow))
    lower_b=b.fast*(1.0-f64(count)*(1.0-b.decay_fast))+b.slow*(1.0-f64(count)*(1.0-b.decay_slow))
    if min(lower_a,lower_b)<0.000002:return false
    a1=a.y1;a2=a.y2;ac=a.coefficient;af=a.fast;aslow=a.slow;adf=a.decay_fast;ads=a.decay_slow
    b1=b.y1;b2=b.y2;bc=b.coefficient;bf=b.fast;bslow=b.slow;bdf=b.decay_fast;bds=b.decay_slow
    loop i in 0..count:
        ay=ac*a1-a2
        a2=a1;a1=ay
        value=values[i]+ay*(af+aslow)
        af*=adf;aslow*=ads
        by=bc*b1-b2
        b2=b1;b1=by
        value+=by*(bf+bslow)
        bf*=bdf;bslow*=bds
        values[i]=value
    modes[at]=MusicMode(a1,a2,ac,af,aslow,adf,ads)
    modes[at+1]=MusicMode(b1,b2,bc,bf,bslow,bdf,bds)
    true

music_modes_render = (modes: mut MusicMode[], base: int, partials: int, out: mut f64[], at: int, count: int):
    assert(count >= 0 and count <= MUSIC_RENDER_BLOCK and at >= 0 and at <= out.len() and count <= out.len()-at)
    # Fixed, checked span. data unshares before taking the pointer; neither array
    # resizes or escapes while it is held. This also works in wasm linear memory.
    values = data(out)+at
    loop i in 0..count: values[i] = 0
    h = 0
    loop h < partials:
        when ARCH == "x86_64":
            if h+1 < partials and music_mode_pair(modes,base+h,values,count):
                h += 2
                continue
        m = modes[base+h]
        y1 = m.y1; y2 = m.y2; coefficient = m.coefficient
        fast = m.fast; slow = m.slow
        decay_fast = m.decay_fast; decay_slow = m.decay_slow
        # Bernoulli's inequality bounds the decay below for this short block.
        # A full 1e-6 margin dwarfs rounding error: the usual loud-mode path needs
        # no per-sample cutoff branch. The quiet tail keeps the original cutoff.
        lower = fast*(1.0-f64(count)*(1.0-decay_fast))+slow*(1.0-f64(count)*(1.0-decay_slow))
        if lower >= 0.000002:
            loop i in 0..count:
                y = coefficient*y1-y2
                y2 = y1; y1 = y
                values[i] += y*(fast+slow)
                fast *= decay_fast; slow *= decay_slow
        else:
            loop i in 0..count:
                if fast+slow < 0.000001: break
                y = coefficient*y1-y2
                y2 = y1; y1 = y
                values[i] += y*(fast+slow)
                fast *= decay_fast; slow *= decay_slow
        modes[base+h] = MusicMode(y1,y2,coefficient,fast,slow,decay_fast,decay_slow)
        h += 1

# Slowly smoothed cycle-to-cycle pressure variation, not a repeated vibrato LFO.
# The dedicated path adds no per-sample noise/jitter work to other instruments.
music_trumpet_render = (s: mut MusicSynth, k: int, n: mut MusicVoice, count: int):
    lip = s.lips[k]
    phase = n.phase; vibrato = n.vibrato; morph = n.morph; age = n.age
    waves = s.waves; sine = s.sine
    loop i in 0..count:
        lip.motion += (lip.target-lip.motion)*0.012
        s.body_work[i] = music_osc(waves,k,phase,morph)*(1.0+0.012*lip.motion)
        vib = music_sine(sine,vibrato)
        depth = n.vibrato_depth*min(1.0,f64(age)/4000.0)
        scoop = 0.009*max(0.0,1.0-f64(age)/400.0)
        phase += n.increment*(1.0+vib*depth+scoop+0.004*lip.motion)
        if phase >= 1.0:
            phase -= f64(int(phase))
            lip.rng = (lip.rng*u64(1664525)+u64(1013904223)) & u64(0xffffffff)
            lip.target = f64(lip.rng)*0.0000000004656612873077392578125-1.0
        vibrato += n.vibrato_step; vibrato -= f64(int(vibrato))
        morph *= 0.999750031; age += 1
    n.phase = phase; n.vibrato = vibrato; n.morph = morph
    s.lips[k] = lip

music_wind_render = (s: mut MusicSynth, k: int, n: mut MusicVoice, count: int):
    if n.instrument == .trumpet: music_trumpet_render(s,k,n,count); return
    kind = n.instrument
    phase = n.phase; phase2 = n.phase2; phase3 = n.phase3
    vibrato = n.vibrato; morph = n.morph
    age = n.age
    increment = n.increment; vibrato_depth = n.vibrato_depth; vibrato_step = n.vibrato_step; tremor = n.tremor
    waves = s.waves; sine = s.sine
    loop i in 0..count:
        v = music_osc(waves,k,phase,morph)
        if kind == .strings or kind == .accordion or kind == .choir:
            v = (v+music_osc(waves,k,phase2,morph)+music_osc(waves,k,phase3,morph))*0.5773503
        vib = music_sine(sine,vibrato)
        s.body_work[i] = if tremor > 0.0:v*(1.0+tremor*vib) else:v
        depth = vibrato_depth*min(1.0,f64(age)/4000.0)
        scoop = if kind == .trumpet: 0.009*max(0.0,1.0-f64(age)/400.0) else: if kind == .brass or kind == .oboe: -0.004*max(0.0,1.0-f64(age)/500.0) else: 0.0
        inc = increment*(1.0+vib*depth+scoop)
        phase += inc; phase -= f64(int(phase))
        if kind == .strings or kind == .accordion or kind == .choir:
            phase2 += increment*(1.0031+music_sine(sine,vibrato*1.071+0.3)*depth*0.8); phase2 -= f64(int(phase2))
            phase3 += increment*(0.9963+music_sine(sine,vibrato*0.937+0.6)*depth*1.1); phase3 -= f64(int(phase3))
        vibrato += vibrato_step; vibrato -= f64(int(vibrato))
        morph *= 0.999750031
        age += 1
    n.phase = phase; n.phase2 = phase2; n.phase3 = phase3
    n.vibrato = vibrato; n.morph = morph

music_voice_render = (s: mut MusicSynth, k: int, out: mut f64[], at: int, count: int):
    n = s.voices[k]
    requested = count
    let count = min(count,n.duration+n.release-n.age)
    if count <= 0:
        s.voices[k].active = false
        return
    if n.mode == 1:
        if n.body >= 0:
            b = s.bodies[n.body]
            offset = n.age-b.origin
            if offset >= MUSIC_BODY_FRAMES:
                loop h in 0..n.partials: s.modes[k*MUSIC_PARTIALS+h] = s.body_modes[n.body*MUSIC_PARTIALS+h]
                n.body = -1
            else:
                # The outer renderer splits at cache-prefix ends, so no voice crosses
                # a boundary here. Build only a small missing suffix, never a note.
                required = offset+count
                if required > b.length:
                    missing = required-b.length
                    music_modes_render(s.body_modes,n.body*MUSIC_PARTIALS,b.partials,s.body_samples,n.body*MUSIC_BODY_FRAMES+b.length,missing)
                    s.bodies[n.body].length = required
                    s.body_frames += missing
        if n.body < 0: music_modes_render(s.modes,k*MUSIC_PARTIALS,n.partials,s.body_work,0,count)
    if n.mode == 0: music_wind_render(s,k,n,count)
    body_at = if n.body >= 0: n.body*MUSIC_BODY_FRAMES+n.age-s.bodies[n.body].origin else: 0
    kind = n.instrument
    noise_rng = n.noise_rng
    noise_low = n.noise_low
    noise_hz = n.noise_hz
    noise_body = n.noise_body
    noise = n.noise
    transient = n.transient
    age = n.age
    noise_env = n.noise_env
    tone_low = n.tone_low
    gain = n.gain
    peak_level = n.peak_level
    attack_env = n.attack_env
    gate = n.gate
    attack_rate = n.attack_rate
    noise_decay = n.noise_decay
    duration = n.duration
    release_rate = n.release_rate
    peak_age = n.peak_age
    gain_step = n.gain_step
    late_step = n.late_step
    # Check the two contiguous spans once. These arrays do not resize or escape
    # during the loop; only the destination span is written.
    assert(at >= 0 and at <= out.len() and count <= out.len()-at)
    assert(body_at >= 0 and count <= MUSIC_RENDER_BLOCK)
    assert(if n.body >= 0: body_at <= s.body_samples.len()-count else: count <= s.body_work.len())
    samples = if n.body >= 0: data(s.body_samples)+body_at else: data(s.body_work)
    mixed = data(out)+at
    loop i in 0..count:
        v = samples[i]
        noise_rng = (noise_rng*u64(1664525)+u64(1013904223)) & u64(0xffffffff)
        # Exact power-of-two scale for a 32-bit integer; avoids a hardware divide.
        local_noise = f64(int(noise_rng))*0.0000000004656612873077392578125-1.0
        noise_low += (local_noise-noise_low)*noise_hz
        noise_body += (noise_low-noise_body)*0.035
        texture = noise_low-noise_body
        transient_shape = if age < 600: 1.0-f64(age)/600.0 else: 0.0
        v += texture*(noise+transient*transient_shape)*noise_env
        if kind == .drums or kind == .timpani:
            v += texture*transient*noise_env
        if kind == .trumpet:
            # A faint turbulent component above the existing reed/breath lowpass.
            v += (local_noise-noise_low)*0.018
            tone_low += (v-tone_low)*0.42
            brightness = clamp(gain/max(peak_level,0.0001),0.4,1.0)
            v = tone_low+(v-tone_low)*(0.55+brightness*0.45)
        mixed[i] += v*attack_env*gate*gain
        attack_env = 1.0-(1.0-attack_env)*attack_rate
        noise_env *= noise_decay
        if age >= duration: gate *= release_rate
        if age == peak_age: gain_step = late_step
        if age < duration: gain += gain_step
        age += 1
    n.noise_rng = noise_rng
    n.noise_low = noise_low
    n.noise_body = noise_body
    n.age = age
    n.noise_env = noise_env
    n.tone_low = tone_low
    n.gain = gain
    n.attack_env = attack_env
    n.gate = gate
    n.gain_step = gain_step
    if count < requested: n.active = false
    s.voices[k] = n

# Larger orchestral room, using the same bounded four-comb/two-allpass topology.
# Three early arrivals establish space before the denser, high-frequency-damped tail.
music_concert_hall_sample = (s: mut MusicSynth, value: f64) -> f64:
    write = s.reverb_at%2048
    s.hall_early[write] = value
    early = s.hall_early[(write+2048-417)%2048]*0.45+s.hall_early[(write+2048-683)%2048]*0.32+s.hall_early[(write+2048-1061)%2048]*0.23
    if s.piece == 1:
        early = s.hall_early[(write+2048-193)%2048]*0.25+s.hall_early[(write+2048-307)%2048]*0.20+s.hall_early[(write+2048-479)%2048]*0.18+s.hall_early[(write+2048-653)%2048]*0.15+s.hall_early[(write+2048-887)%2048]*0.12+s.hall_early[(write+2048-1187)%2048]*0.10
    hall = 0.0
    loop k in 0..4:
        at = s.reverb_at%s.delays[k].len()
        delayed = s.delays[k][at]
        s.damp[k] += (delayed-s.damp[k])*0.28
        s.delays[k][at] = value+s.damp[k]*s.hall_feedback[k]
        hall += delayed*0.25
    # Diffuse the stronger early field under the solo; leave late feedback unchanged.
    if s.piece == 1:hall = hall*1.8+early*2.4
    loop k in 4..6:
        at = s.reverb_at%s.delays[k].len()
        delayed = s.delays[k][at]
        v = hall
        hall = delayed-v*0.5
        s.delays[k][at] = v+hall*0.5
    s.reverb_at += 1; s.cursor += 1; s.fade = min(160,s.fade+1)
    reflected = if s.piece == 1:hall else:hall*1.8+early*0.4
    mixed = (value+reflected*s.wet)*s.gain
    mixed/(1.0+abs(mixed)*0.28)*f64(s.fade)/160.0

music_hall_sample = (s: mut MusicSynth, value: f64) -> f64:
    hall = 0.0
    loop k in 0..4:
        at = s.reverb_at%s.delays[k].len()
        delayed = s.delays[k][at]
        s.damp[k] += (delayed-s.damp[k])*0.35
        s.delays[k][at] = value+s.damp[k]*0.76
        hall += delayed*0.25
    loop k in 4..6:
        at = s.reverb_at%s.delays[k].len()
        delayed = s.delays[k][at]
        v = hall
        hall = delayed-v*0.5
        s.delays[k][at] = v+hall*0.5
    s.reverb_at += 1; s.cursor += 1; s.fade = min(160,s.fade+1)
    mixed = (value+hall*s.wet)*s.gain
    mixed/(1.0+abs(mixed)*0.28)*f64(s.fade)/160.0

# Give the first harp entries room, then restore the accepted balance exactly.
# Gain follows performed time, so seeking and block partitioning agree.
music_opening_strings_gain = (frame: int) -> f64:
    u = clamp((f64(frame)/f64(MUSIC_RATE)-4.5)/4.5,0.0,1.0)
    0.251188643150958+(1.0-0.251188643150958)*u*u*(3.0-2.0*u)

# Same slot-order mix and per-voice arithmetic as the scalar renderer. Event
# boundaries preserve stealing and note starts; block partition changes no samples.
music_render = (s: mut MusicSynth, count: int) -> f64[]:
    out = fill(0.0,clamp(count,0,800))
    at = 0
    opening = s.piece == 0 and s.cursor < 9*MUSIC_RATE
    # Two short temporary spans only during the opening; no added voice state or
    # recurring work after it. Keep the original slot-order sum and source effort.
    opening_work = if opening:fill(0.0,MUSIC_RENDER_BLOCK) else:[]
    opening_gain = if opening:fill(0.0,MUSIC_RENDER_BLOCK) else:[]
    loop at < out.len() and s.cursor < s.frames:
        loop s.next < s.events.len() and s.events[s.next].start <= s.cursor:
            music_start(s,s.events[s.next],s.cursor-s.events[s.next].start)
            s.next += 1
        n = min(MUSIC_RENDER_BLOCK,min(out.len()-at,s.frames-s.cursor))
        if s.next < s.events.len(): n = min(n,s.events[s.next].start-s.cursor)
        loop k in 0..MUSIC_VOICES:
            v = s.voices[k]
            if v.active and v.body >= 0:
                left = MUSIC_BODY_FRAMES-(v.age-s.bodies[v.body].origin)
                if left > 0: n = min(n,left)
        if opening and s.cursor < 9*MUSIC_RATE:
            loop i in 0..n:opening_gain[i]=music_opening_strings_gain(s.cursor+i)
            loop k in 0..MUSIC_VOICES:
                if not s.voices[k].active:continue
                if s.voices[k].instrument == .strings:
                    loop i in 0..n:opening_work[i]=0
                    music_voice_render(s,k,opening_work,0,n)
                    loop i in 0..n:out[at+i]+=opening_work[i]*opening_gain[i]
                else:music_voice_render(s,k,out,at,n)
        else:
            loop k in 0..MUSIC_VOICES:
                if s.voices[k].active: music_voice_render(s,k,out,at,n)
        if s.concert_hall:
            loop i in 0..n: out[at+i] = music_concert_hall_sample(s,out[at+i])
        else:
            loop i in 0..n: out[at+i] = music_hall_sample(s,out[at+i])
        at += n
    out

music_sample = (s: mut MusicSynth) -> f64:
    music_render(s,1)[0]
