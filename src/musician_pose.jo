# Musicians who hold their instruments and play what is heard: the violinist's bow drawn one way
# then the other on each note, the pianist's hands over the part of the keyboard their notes are
# in, plucking hands on the guitar, the mandolin and the bouzouki, the accordion's bellows breathing
# with the phrases, a clarinet lifting into a phrase, a singer's mouth open on the sung notes.
# Everything is read from a source's note feed (src/live_notes.jo: the notes the synthesizer plays)
# at the frame being heard, so the motion is in step with the sound.
#
# The figures are the townsfolk's (src/folk.jo), drawn here with arms in two (shoulder to elbow,
# elbow to hand) that reach for where the hands must be, the elbow toward a pole.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'folk.jo'
use 'music_synth.jo'
use 'live_notes.jo'
use 'street_phrase.jo'

# ---------------- the instruments ----------------

struct InstrumentKit:
    violin: Mesh                    # chin end at 0, along +x to the scroll, top +y
    bow: Mesh                       # frog at 0, the stick along -x to the tip
    guitar: Mesh                    # sound hole at 0, neck along +x, face +z
    mandolin: Mesh
    bouzouki: Mesh
    box_right: Mesh                 # the accordion's treble end (keys on its front, -z)
    box_left: Mesh                  # its bass end
    bellows: Mesh                   # (a unit width along x, centred)
    clarinet: Mesh                  # mouthpiece at 0, along +y to the bell
    bass: Mesh                      # the double bass, on the floor at 0, face +z
    mouth: Mesh                     # (a unit box)
    stool: Mesh                     # (for a seated player, its seat 0.52 m up)
    keys: Mesh                      # a piano's 88 keys: front edge at 0 (the player at +x), the low
                                    # end toward +z, tops at 0 and up

const KEYBOARD_WIDTH = 1.22          # (88 keys, metres)
const BOW_FROG = 0.1                # (the stretch of the bow that is used, from the frog)
const BOW_TIP = 0.48

make_instrument_kit = () -> InstrumentKit:
    wood = rgb(0.55, 0.27, 0.1)
    light = rgb(0.72, 0.5, 0.26)
    dark = rgb(0.08, 0.06, 0.05)
    ivory = rgb(0.95, 0.93, 0.86)
    violin = custom_mesh(():
        vs: Vertex3D[]
        # (two bouts and a waist, a dark fingerboard, the scroll)
        add_sphere(vs, vec3(0.1, 0, 0), 1.0, wood, 7, 4, translation(vec3(0.1, 0, 0)) * scaling(vec3(0.1, 0.035, 0.1)))
        add_sphere(vs, vec3(0, 0, 0), 1.0, wood, 7, 4, translation(vec3(0.26, 0, 0)) * scaling(vec3(0.09, 0.033, 0.085)))
        add_box(vs, vec3(0.18, 0.008, 0), vec3(0.08, 0.05, 0.11), wood)
        add_box(vs, vec3(0.35, 0.042, 0), vec3(0.26, 0.016, 0.028), dark)
        add_box(vs, vec3(0.5, 0.03, 0), vec3(0.06, 0.03, 0.024), wood)
        add_sphere(vs, vec3(0.555, 0.035, 0), 0.022, wood, 5, 3)
        add_box(vs, vec3(0.03, 0.04, -0.035), vec3(0.06, 0.012, 0.05), dark)         # the chin rest
        add_box(vs, vec3(0.17, 0.05, 0), vec3(0.008, 0.03, 0.05), ivory)            # the bridge
        vs
    ())
    bow = custom_mesh(():
        vs: Vertex3D[]
        add_box(vs, vec3(-0.35, 0.012, 0), vec3(0.7, 0.008, 0.008), rgb(0.3, 0.17, 0.08))
        add_box(vs, vec3(-0.35, 0, 0), vec3(0.66, 0.004, 0.012), rgb(0.9, 0.88, 0.8))
        add_box(vs, vec3(-0.015, 0.0, 0), vec3(0.05, 0.03, 0.016), dark)              # the frog
        vs
    ())
    guitar = custom_mesh(():
        vs: Vertex3D[]
        add_sphere(vs, vec3(0, 0, 0), 1.0, light, 8, 4, translation(vec3(-0.03, 0, 0)) * scaling(vec3(0.15, 0.15, 0.05)))
        add_sphere(vs, vec3(0, 0, 0), 1.0, light, 8, 4, translation(vec3(-0.2, 0, 0)) * scaling(vec3(0.15, 0.19, 0.05)))
        add_cylinder(vs, vec3(0, 0, 0.045), 0.045, 0.012, dark, 8, -1.0, rotation_x(PI * 0.5))
        add_box(vs, vec3(-0.27, 0, 0.05), vec3(0.04, 0.12, 0.012), dark)              # the bridge
        add_box(vs, vec3(0.32, 0, 0.03), vec3(0.5, 0.055, 0.025), dark)
        add_box(vs, vec3(0.62, 0, 0.02), vec3(0.12, 0.075, 0.025), rgb(0.35, 0.2, 0.1))
        vs
    ())
    mandolin = custom_mesh(():
        vs: Vertex3D[]
        add_sphere(vs, vec3(0, 0, 0), 1.0, rgb(0.5, 0.25, 0.1), 8, 4, translation(vec3(-0.06, 0, -0.02)) * scaling(vec3(0.15, 0.12, 0.07)))
        add_cylinder(vs, vec3(0, 0, 0.045), 0.03, 0.01, dark, 8, -1.0, rotation_x(PI * 0.5))
        add_box(vs, vec3(0.2, 0, 0.035), vec3(0.26, 0.04, 0.02), dark)
        add_box(vs, vec3(0.36, 0, 0.03), vec3(0.08, 0.055, 0.02), rgb(0.35, 0.2, 0.1))
        vs
    ())
    bouzouki = custom_mesh(():
        vs: Vertex3D[]
        add_sphere(vs, vec3(0, 0, 0), 1.0, rgb(0.62, 0.36, 0.16), 8, 4, translation(vec3(-0.08, 0, -0.03)) * scaling(vec3(0.17, 0.13, 0.09)))
        add_box(vs, vec3(-0.08, 0, 0.055), vec3(0.3, 0.2, 0.01), rgb(0.85, 0.72, 0.5))      # the soundboard
        add_cylinder(vs, vec3(0, 0, 0.06), 0.03, 0.01, dark, 8, -1.0, rotation_x(PI * 0.5))
        add_box(vs, vec3(0.32, 0, 0.04), vec3(0.5, 0.04, 0.02), dark)
        add_box(vs, vec3(0.6, 0, 0.035), vec3(0.08, 0.055, 0.02), rgb(0.35, 0.2, 0.1))
        vs
    ())
    red = rgb(0.6, 0.12, 0.12)
    box_right = custom_mesh(():
        vs: Vertex3D[]
        add_box(vs, vec3(0, 0, 0), vec3(0.08, 0.38, 0.2), red)
        add_box(vs, vec3(0.012, 0, -0.103), vec3(0.05, 0.34, 0.008), ivory)
        loop k in 0..9: add_box(vs, vec3(0.022, f32(-0.15 + f64(k) * 0.037), -0.109), vec3(0.03, 0.018, 0.006), dark)
        vs
    ())
    box_left = custom_mesh(():
        vs: Vertex3D[]
        add_box(vs, vec3(0, 0, 0), vec3(0.07, 0.36, 0.2), red)
        loop k in 0..12: add_sphere(vs, vec3(f32(-0.04), f32(-0.13 + f64(k % 6) * 0.05), f32(-0.05 + f64(k / 6) * 0.05)), 0.01, ivory, 4, 2)
        add_box(vs, vec3(-0.045, 0, 0), vec3(0.01, 0.3, 0.05), rgb(0.25, 0.15, 0.1))   # the strap
        vs
    ())
    bellows = custom_mesh(():
        vs: Vertex3D[]
        loop k in 0..8:
            add_box(vs, vec3(f32(-0.5 + (f64(k) + 0.5) / 8.0), 0, 0), vec3(0.07, 0.35, 0.19), if k % 2 == 0: rgb(0.12, 0.1, 0.1) else: rgb(0.85, 0.82, 0.75))
        vs
    ())
    clarinet = custom_mesh(():
        vs: Vertex3D[]
        add_cylinder(vs, vec3(0, 0, 0), 0.016, 0.56, rgb(0.06, 0.05, 0.05), 6)
        add_cylinder(vs, vec3(0, 0.56, 0), 0.016, 0.07, rgb(0.06, 0.05, 0.05), 6, 0.036)
        loop k in 0..4: add_cylinder(vs, vec3(0, f32(0.1 + f64(k) * 0.13), 0), 0.018, 0.012, rgb(0.75, 0.75, 0.72), 6)
        vs
    ())
    bass = custom_mesh(():
        vs: Vertex3D[]
        add_sphere(vs, vec3(0, 0, 0), 1.0, rgb(0.45, 0.22, 0.1), 8, 5, translation(vec3(0, 0.62, 0)) * scaling(vec3(0.34, 0.36, 0.12)))
        add_sphere(vs, vec3(0, 0, 0), 1.0, rgb(0.45, 0.22, 0.1), 8, 5, translation(vec3(0, 1.0, 0)) * scaling(vec3(0.27, 0.3, 0.12)))
        add_box(vs, vec3(0, 1.45, 0.11), vec3(0.06, 0.9, 0.04), dark)
        add_box(vs, vec3(0, 1.95, 0.06), vec3(0.08, 0.14, 0.08), rgb(0.3, 0.16, 0.08))
        add_box(vs, vec3(0, 0.75, 0.13), vec3(0.12, 0.06, 0.02), ivory)                   # the bridge
        add_cylinder(vs, vec3(0, -0.02, 0), 0.01, 0.3, rgb(0.5, 0.5, 0.5), 4)           # the endpin
        vs
    ())
    mouth = custom_mesh(():
        vs: Vertex3D[]
        add_box(vs, vec3(0, 0, 0), vec3(1, 1, 1), rgb(0.25, 0.06, 0.06))
        vs
    ())
    stool = custom_mesh((): 
        vs: Vertex3D[]
        add_cylinder(vs, vec3(0, 0.46, 0), 0.19, 0.05, rgb(0.3, 0.19, 0.11), 8)
        loop k in 0..4:
            a = f64(k) * PI * 0.5 + PI * 0.25
            add_box(vs, vec3(f32(cos(a) * 0.12), 0.23, f32(sin(a) * 0.12)), vec3(0.035, 0.46, 0.035), rgb(0.25, 0.15, 0.09))
        vs
    ())
    keys = custom_mesh((): 
        vs: Vertex3D[]
        w = KEYBOARD_WIDTH / 52.0
        white = 0
        loop n in 21..109:
            pc = n % 12
            if pc == 1 or pc == 3 or pc == 6 or pc == 8 or pc == 10:
                # (a black key, raised, short, on the line between the white keys either side)
                add_box(vs, vec3(-0.085, 0.012, f32(KEYBOARD_WIDTH * 0.5 - f64(white) * w)), vec3(0.09, 0.014, f32(w * 0.55)), rgb(0.06, 0.05, 0.05))
            else:
                add_box(vs, vec3(-0.065, 0.004, f32(KEYBOARD_WIDTH * 0.5 - (f64(white) + 0.5) * w)), vec3(0.13, 0.012, f32(w * 0.9)), rgb(0.96, 0.94, 0.88))
                white += 1
        vs
    ())
    InstrumentKit(violin, bow, guitar, mandolin, bouzouki, box_right, box_left, bellows, clarinet, bass, mouth, stool, keys)

# ---------------- the figure, posed ----------------

struct Rig:
    seated = false
    lean = 0.0                      # forward, about the hips (radians)
    tilt = 0.0                      # sideways, toward the figure's left
    turn = 0.0                      # the shoulders turned about the spine, toward the left
    head_tilt = 0.0                 # (toward the left)
    head_nod = 0.0                  # (down)
    left = vec3(-0.3, 0.85, 0)      # where the hands are: the hips frame (the figure's own units:
    right = vec3(0.3, 0.85, 0)      # feet at 0 standing, facing -z, its right toward +x)
    left_pole = vec3(-0.4, -1, 0.3) # (which way each elbow points)
    right_pole = vec3(0.4, -1, 0.3)
    mouth = -1.0                    # how far open, 0..1 (-1: none drawn)

const ARM_SEGMENT = 0.34            # shoulder to elbow, elbow to the hand's middle (a little
                                    # longer than the walking figure's, whose arms are short for
                                    # its shoulders: a player's hands must reach the instrument)

# How far the hips frame is lifted from the feet (seated: the hips on a chair 0.58 m up).
rig_drop = (f: Figure, seated: bool) -> f64: if seated: 0.58 / f64(f.height) - 0.86 else: 0.0

# The trunk's turn about the hips.
rig_trunk = (r: Rig) -> mat4:
    translation(vec3(0, 0.9, 0)) * rotation_y(r.turn) * rotation_x(-r.lean) * rotation_z(r.tilt) * translation(vec3(0, -0.9, 0))

rig_shoulder = (r: Rig, side: f64) -> vec3: transform_point(rig_trunk(r), vec3(f32(side * 0.32), 1.43, 0))

# The elbow for a hand at h from a shoulder at s, bent toward the pole (a two-bone reach; a hand
# out of reach is brought in along the line to it).
rig_elbow = (s: vec3, h: vec3, pole: vec3) -> (vec3, vec3):
    d = h - s
    len = clamp(f64(length(d)), 0.08, ARM_SEGMENT * 2.0 - 0.005)
    u = if f64(length(d)) > 0.0001: normalize(d) else: vec3(0, -1, 0)
    hand = s + u * f32(len)
    n = pole - u * dot(pole, u)
    if f64(length(n)) < 0.001: n = vec3(u.y, -u.x, 0) + vec3(0, 0, 0.01)
    n = normalize(n)
    rise = sqrt(max(ARM_SEGMENT * ARM_SEGMENT - len * len * 0.25, 0.0))
    (s + u * f32(len * 0.5) + n * f32(rise), hand)

_segment = (a: vec3, b: vec3, pole: vec3) -> mat4:
    d = b - a
    up = pole - normalize(d) * dot(pole, normalize(d))
    translation(a) * facing(d, if f64(length(up)) > 0.001: up else: vec3(0, 0, 1)) * rotation_x(PI * 0.5) * scaling(vec3(0.95, f32(f64(length(d)) / 0.6), 0.95))

# The figure's own frame (camera-relative, scaled to its height) for a placement `at`.
rig_base = (f: Figure, at: mat4, offset: vec3 = vec3(0, 0, 0)) -> mat4:
    base = render_model(at, render_origin(scene_camera()))
    base[3] += vec4(offset, 0)
    base * scaling(f64(f.height))

# Draw the figure in a pose; returns its hips frame (for what it holds).
draw_rig = (f: Figure, at: mat4, r: Rig, kit: InstrumentKit, L: Light, t: f64, offset: vec3 = vec3(0, 0, 0)) -> mat4:
    base = rig_base(f, at, offset)
    hips = base * translation(vec3(0, f32(rig_drop(f, r.seated)), 0))
    trunk = hips * rig_trunk(r)
    draw(obj_sh, if r.seated: f.resting_torso else: f.torso, obj_local_params(L, t, trunk))
    head = trunk * translation(vec3(0, 1.5, 0)) * rotation_z(r.head_tilt) * rotation_x(-r.head_nod) * translation(vec3(0, -1.5, 0))
    draw(obj_sh, f.head, obj_local_params(L, t, head))
    if r.mouth >= 0.0:
        draw(obj_sh, kit.mouth, obj_local_params(L, t, head * translation(vec3(0, 1.615, -0.158)) * scaling(vec3(0.05, f32(0.006 + 0.034 * clamp(r.mouth, 0.0, 1.0)), 0.03))))
    loop side in [-1.0, 1.0]:
        leg = hips * translation(vec3(f32(side * 0.12), 0.86, 0))
        if r.seated: draw(obj_sh, f.resting_leg, obj_local_params(L, t, leg * scaling(vec3(1, 1.0 / f.height, 1))))
        else: draw(obj_sh, f.leg, obj_local_params(L, t, leg))
        s = rig_shoulder(r, side)
        hand = if side < 0.0: r.left else: r.right
        pole = if side < 0.0: r.left_pole else: r.right_pole
        elbow, reached = rig_elbow(s, hand, pole)
        draw(obj_sh, f.arm, obj_local_params(L, t, hips * _segment(s, elbow, pole)))
        draw(obj_sh, f.arm, obj_local_params(L, t, hips * _segment(elbow, reached, pole)))
    hips

# A frame from three axes and an origin.
frame_of = (x: vec3, y: vec3, z: vec3, o: vec3) -> mat4:
    m = mat4_identity()
    m[0] = vec4(x, 0); m[1] = vec4(y, 0); m[2] = vec4(z, 0); m[3] = vec4(o, 1)
    m

# An instrument's frame from the way its +x points (along the neck) and roughly where its +z (the
# face) looks.
neck_frame = (o: vec3, along: vec3, face: vec3) -> mat4:
    x = normalize(along)
    z = normalize(face - x * dot(face, x))
    frame_of(x, cross(z, x), z, o)

# ---------------- what is played, grouped ----------------

# A note of one player's part, in seconds.
struct PartNote:
    start: f64
    end: f64
    pitch: int
    level = 0.5

# One part's notes from a feed (by start).
part_notes = (notes: LiveNote[], part: int) -> PartNote[]:
    out: PartNote[]
    loop n in notes:
        if n.part != part: continue
        at = f64(n.start) / f64(MUSIC_RATE)
        out.push(PartNote(at, at + n.length, n.pitch, n.velocity))
    out

# Notes that start together (a chord, a double stop): one stroke, one pluck.
struct NoteGroup:
    start: f64
    end: f64                        # (the longest of them)
    level: f64
    low: int
    high: int
    mean: f64
    phrase = false                  # the first after a breath (a rest of a third of a second)

note_groups = (notes: PartNote[], within: f64 = 0.03) -> NoteGroup[]:
    out: NoteGroup[]
    count = 0
    sum = 0.0
    last_end = -100.0
    loop n in notes:
        if out.len() > 0 and n.start - out[out.len() - 1].start <= within:
            k = out.len() - 1
            out[k].end = max(out[k].end, n.end); out[k].level = max(out[k].level, n.level)
            out[k].low = min(out[k].low, n.pitch); out[k].high = max(out[k].high, n.pitch)
            count += 1; sum += f64(n.pitch); out[k].mean = sum / f64(count)
        else:
            out.push(NoteGroup(n.start, n.end, n.level, n.pitch, n.pitch, f64(n.pitch), n.start - last_end >= 0.33))
            count = 1; sum = f64(n.pitch)
        last_end = max(last_end, n.end)
    out

# The last group to start at or before t (-1 before the first).
group_at = (gs: NoteGroup[], t: f64) -> int:
    lo = 0; hi = gs.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if gs[mid].start <= t: lo = mid + 1
        else: hi = mid
    lo - 1

# How long a group sounds before the next takes over.
group_length = (gs: NoteGroup[], k: int) -> f64:
    e = gs[k].end
    if k + 1 < gs.len(): e = min(e, gs[k + 1].start)
    max(e - gs[k].start, 0.05)

# A plucked or struck onset's movement, 0..1: quick out, slower back.
pluck_curve = (age: f64) -> f64:
    if age < 0.0 or age > 0.35: return 0.0
    if age < 0.035: return age / 0.035
    exp(-(age - 0.035) / 0.07)

# ---------------- strokes: the bow, the bellows ----------------
# A stroke per group (the bow) or per phrase (the bellows), each the other way from the last, the
# length from how long and how loud it is, kept within the bow (or the bellows' reach). A rest long
# enough lets the bow be lifted and set down where the next stroke wants to start.

struct Strokes:
    start: f64[]
    end: f64[]
    from: f64[]
    to: f64[]
    group: int[]                    # (the first group of each stroke)

const BOW_STEPS = 43                 # (the places along the bow the plan chooses between)

bow_strokes = (gs: NoteGroup[]) -> Strokes:
    out = Strokes()
    n = gs.len()
    if n == 0: return out
    # Each group's stroke: its way (down, up, in turn; down again to open a phrase after a
    # breath), how much bow it wants (its length times a bow speed that rises with its loudness),
    # and whether the bow may be lifted and set down anywhere before it (after a short rest).
    ways: f64[]
    wants: f64[]
    lifted: bool[]
    dir = 1.0
    loop k in 0..n:
        gap = if k == 0: 100.0 else: gs[k].start - min(gs[k - 1].end, gs[k].start)
        if gs[k].phrase and gap > 0.6: dir = 1.0
        ways.push(dir); dir = -dir
        lifted.push(gap > 0.18)
        speed = 0.1 + 0.55 * gs[k].level                          # m/s: louder, faster
        wants.push(clamp(group_length(gs, k) * speed, 0.04, BOW_TIP - BOW_FROG))
    # The bow shared out (a player's bow distribution): of all the ways to place the strokes on the
    # bow, the one whose strokes are closest to what each wants (the ratio, so a short note's bow
    # matters as much as a long one's), each stroke at least a little bow.
    step = (BOW_TIP - BOW_FROG) / f64(BOW_STEPS - 1)
    at = (i: int) -> f64: BOW_FROG + f64(i) * step
    big = 1.0e9
    cost = fill(big, BOW_STEPS)
    back = fill(0, n * BOW_STEPS * 2)  # (for each stroke and end place: where it started, and
                                        # where the stroke before it ended)
    loop k in 0..n:
        start_cost = fill(big, BOW_STEPS)
        start_from = fill(-1, BOW_STEPS)
        if k == 0 or lifted[k]:
            best = big; bi = 0
            loop i in 0..BOW_STEPS:
                if k == 0: best = 0.0
                else if cost[i] < best: best = cost[i]; bi = i
            loop i in 0..BOW_STEPS:
                # (set down near the frog for a down bow, near the tip for an up bow)
                ideal = if ways[k] > 0.0: BOW_FROG + 0.03 else: BOW_TIP - 0.03
                start_cost[i] = best + 0.3 * pow((at(i) - ideal) / (BOW_TIP - BOW_FROG), 2.0)
                start_from[i] = if k == 0: -1 else: bi
        else:
            loop i in 0..BOW_STEPS: start_cost[i] = cost[i]; start_from[i] = i
        next = fill(big, BOW_STEPS)
        loop j in 0..BOW_STEPS:
            loop i in 0..BOW_STEPS:
                if start_cost[i] >= big: continue
                span = (at(j) - at(i)) * ways[k]
                if span < 0.02: continue
                r = log(span / wants[k])
                c = start_cost[i] + r * r
                if c < next[j]:
                    next[j] = c
                    back[k * BOW_STEPS * 2 + j] = i
                    back[k * BOW_STEPS * 2 + BOW_STEPS + j] = start_from[i]
        cost = next
    # (back from the best last place: each stroke's end, then its start, then the stroke before's end)
    froms = fill(0, n)
    tos = fill(0, n)
    j = 0
    loop i in 0..BOW_STEPS:
        if cost[i] < cost[j]: j = i
    k = n - 1
    loop k >= 0:
        tos[k] = j
        froms[k] = back[k * BOW_STEPS * 2 + j]
        j = back[k * BOW_STEPS * 2 + BOW_STEPS + j]
        k -= 1
    loop k2 in 0..n:
        out.start.push(gs[k2].start); out.end.push(gs[k2].start + group_length(gs, k2))
        out.from.push(at(froms[k2])); out.to.push(at(tos[k2])); out.group.push(k2)
    out

# Where along the bow the string is at t, and how far the bow is lifted off it.
bow_at = (st: Strokes, t: f64) -> (f64, f64):
    if st.start.len() == 0: return (BOW_FROG + 0.15, 0.03)
    lo = 0; hi = st.start.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if st.start[mid] <= t: lo = mid + 1
        else: hi = mid
    k = lo - 1
    if k < 0: return (st.from[0], 0.03)
    if t < st.end[k]:
        u = (t - st.start[k]) / max(st.end[k] - st.start[k], 0.001)
        e = 1.0 - pow(1.0 - clamp(u, 0.0, 1.0), 1.35)
        return (st.from[k] + (st.to[k] - st.from[k]) * e, 0.0)
    if k + 1 < st.start.len() and abs(st.from[k + 1] - st.to[k]) > 0.001:
        v = clamp((t - st.end[k]) / max(st.start[k + 1] - st.end[k], 0.001), 0.0, 1.0)
        v = v * v * (3.0 - 2.0 * v)
        return (st.to[k] + (st.from[k + 1] - st.to[k]) * v, 0.03 * sin(PI * v))
    (st.to[k], if k + 1 >= st.start.len() and t - st.end[k] > 0.6: 0.03 else: 0.0)

# The bellows: one way through a phrase, the other through the next.
const BELLOWS_SHUT = 0.1
const BELLOWS_OPEN = 0.36

bellows_strokes = (gs: NoteGroup[]) -> Strokes:
    out = Strokes()
    dir = 1.0
    w = BELLOWS_SHUT + 0.04
    k = 0
    loop k < gs.len():
        j = k + 1
        loop j < gs.len() and not gs[j].phrase and gs[j].start - gs[k].start < 4.0: j += 1
        a = gs[k].start
        b = gs[j - 1].start + group_length(gs, j - 1)
        level = 0.0
        loop m in k..j: level = max(level, gs[m].level)
        want = clamp((b - a) * (0.025 + 0.06 * level), 0.03, BELLOWS_OPEN - BELLOWS_SHUT)
        room = if dir > 0.0: BELLOWS_OPEN - w else: w - BELLOWS_SHUT
        if room < 0.04: dir = -dir; room = if dir > 0.0: BELLOWS_OPEN - w else: w - BELLOWS_SHUT
        span = min(want, room)
        out.start.push(a); out.end.push(b); out.from.push(w); out.to.push(w + dir * span); out.group.push(k)
        w += dir * span
        dir = -dir
        k = j
    out

bellows_at = (st: Strokes, t: f64) -> f64:
    if st.start.len() == 0: return BELLOWS_SHUT + 0.1
    lo = 0; hi = st.start.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if st.start[mid] <= t: lo = mid + 1
        else: hi = mid
    k = lo - 1
    if k < 0: return st.from[0]
    u = clamp((t - st.start[k]) / max(st.end[k] - st.start[k], 0.001), 0.0, 1.0)
    st.from[k] + (st.to[k] - st.from[k]) * u * u * (3.0 - 2.0 * u)

# ---------------- a hand following notes ----------------
# A hand at a place for each group's notes (`place` of its mean pitch), moving there just before the
# group starts, and dipping on the onset.

struct HandTrack:
    pos = 0.0
    dip = 0.0                       # 0..1, the onset's push
    lift = 0.0                      # 0..1, lifted on the way to the next

hand_track = (gs: NoteGroup[], t: f64, place: (f64) -> f64, rest: f64) -> HandTrack:
    k = group_at(gs, t)
    here = if k >= 0: place(gs[k].mean) else: rest
    out = HandTrack(here)
    if k >= 0: out.dip = gs[k].level * pluck_curve(t - gs[k].start)
    if k + 1 < gs.len():
        since = if k >= 0: gs[k].start else: gs[k + 1].start - 1.0
        travel = clamp((gs[k + 1].start - since) * 0.6, 0.04, 0.16)
        v = (t - (gs[k + 1].start - travel)) / travel
        if v > 0.0:
            v = clamp(v, 0.0, 1.0)
            there = place(gs[k + 1].mean)
            out.pos = here + (there - here) * v * v * (3.0 - 2.0 * v)
            out.lift = sin(PI * v) * clamp(abs(there - here) * 6.0, 0.25, 1.0)
    out

# ---------------- each player's motion ----------------

struct PlayerMotion:
    instrument = -1
    groups: NoteGroup[]
    strokes: Strokes = Strokes()    # (bow or bellows)
    left: NoteGroup[]               # (the pianist's hands)
    right: NoteGroup[]
    low = 40
    high = 80
    loudness = 0.5                  # (the part's usual level, for accents)

player_motion = (instrument: int, given: PartNote[]) -> PlayerMotion:
    # (levels taken against the part's loudest, as the scores' gains run past 1)
    top = 0.0
    loop n in given: top = max(top, n.level)
    notes = [loop n in given: PartNote(n.start, n.end, n.pitch, if top > 0.0: n.level / top else: 0.5)]
    m = PlayerMotion(instrument, note_groups(notes))
    if notes.len() > 0:
        m.low = 127; m.high = 0
        loop n in notes: m.low = min(m.low, n.pitch); m.high = max(m.high, n.pitch)
        m.high = max(m.high, m.low + 1)
    sum = 0.0
    loop g in m.groups: sum += g.level
    if m.groups.len() > 0: m.loudness = sum / f64(m.groups.len())
    if instrument == 0 or instrument == 13: m.strokes = bow_strokes(m.groups)
    if instrument == 9: m.strokes = bellows_strokes(m.groups)
    if instrument == 6:
        lefts: PartNote[]
        rights: PartNote[]
        loop n in notes:
            if n.pitch < 60: lefts.push(n) else: rights.push(n)
        m.left = note_groups(lefts); m.right = note_groups(rights)
    m

# A source's players: each part's motion (made again only when the feed is loaded with something
# new, `key`), and the clock they play to, in seconds into the piece.
struct Performance:
    key = ""
    parts: int[]
    motions: PlayerMotion[]
    seconds = 0.0
    playing = false
    kept: str[]                     # (motions made before, kept by key: a number played again,
    kept_parts: int[][]             # or made ahead with perform_warm, costs nothing)
    kept_motions: PlayerMotion[][]

perform_prepare = (p: mut Performance, feed: LiveNoteFeed, key: str):
    if key == p.key: return
    loop k in 0..p.kept.len():
        if p.kept[k] == key:
            p.parts = p.kept_parts[k]; p.motions = p.kept_motions[k]; p.key = key
            return
    p.parts = []; p.motions = []
    loop n in feed.notes:
        if not (n.part in p.parts): p.parts.push(n.part)
    loop part in p.parts: p.motions.push(player_motion(part, part_notes(feed.notes, part)))
    p.key = key
    if p.kept.len() >= 16:
        p.kept.remove_at(0); p.kept_parts.remove_at(0); p.kept_motions.remove_at(0)
    p.kept.push(key); p.kept_parts.push(p.parts); p.kept_motions.push(p.motions)

# Make (and keep) the motions for a feed ahead of time: the bow's plan is a few milliseconds a part.
perform_warm = (p: mut Performance, feed: LiveNoteFeed, key: str):
    perform_prepare(p, feed, key)
    p.key = ""

perform_motion = (p: Performance, instrument: int) -> PlayerMotion:
    loop k in 0..p.parts.len():
        if p.parts[k] == instrument: return p.motions[k]
    PlayerMotion(instrument, [])

# Run the players' clock a frame on: with the frame, drawn toward the frame being heard (or the
# schedule's), and set outright when it is a quarter of a second off (a new number, a seek).
perform_follow = (p: mut Performance, heard_frame: int, dt: f64):
    if heard_frame < 0:
        p.playing = false; return
    target = f64(heard_frame) / f64(MUSIC_RATE)
    run = p.seconds + dt
    err = target - run
    if not p.playing or abs(err) > 0.25: p.seconds = target
    else: p.seconds = run + err * min(1.0, dt * 10.0)
    p.playing = true

# Along a neck from a pitch: a fraction 0 (at the nut) .. 1 (high up, by the body), over the part's
# range as frets.
neck_reach = (m: PlayerMotion, pitch: f64) -> f64:
    frets = 9.0 * clamp((pitch - f64(m.low)) / f64(max(m.high - m.low, 1)), 0.0, 1.0)
    (1.0 - pow(2.0, -frets / 12.0)) / (1.0 - pow(2.0, -9.0 / 12.0))

# The wind player's lift: the instrument rising into a phrase or an accent, and settling.
accent_lift = (m: PlayerMotion, t: f64) -> f64:
    k = group_at(m.groups, t)
    lift = 0.0
    j = k
    loop j >= 0 and j > k - 8:
        g = m.groups[j]
        age = t - g.start
        if age > 1.2: break
        if g.phrase or g.level > m.loudness + 0.1:
            rise = clamp(age / 0.12, 0.0, 1.0)
            lift = max(lift, rise * exp(-max(age - 0.12, 0.0) / 0.45) * (if g.phrase: 1.0 else: 0.6))
        j -= 1
    lift

# ---------------- the players ----------------
# Each draws one figure playing at `at` (its feet, facing -z as draw_figure_at's), at music time
# `ms`; `t` is the clock the lights and small idle motions run on.

struct Player:
    fig: Figure
    at: mat4
    seed = 0.0                      # (a little difference between players)
    offset: vec3 = vec3(0, 0, 0)    # (camera-relative, added after placing: a precise position's rest)

# The violin's frame in the hips frame: under the chin on the left shoulder, pointing forward
# and left, its top tilted toward the bow.
const VIOLIN_SCALE = 1.4            # (the mesh is a real violin's size: the figures' heads are
                                    # large, so it is drawn larger to read beside them)

violin_frame = (r: Rig) -> mat4:
    trunk = rig_trunk(r)
    a = normalize(transform_dir(trunk, vec3(-0.62, -0.08, -0.78)))
    up = transform_dir(trunk, vec3(0.35, 1, 0.1))
    # (the end of the violin on the collarbone, under the chin)
    chin = transform_point(trunk, vec3(-0.11, 1.5, -0.1))
    neck_frame(chin, a, cross(a, up)) * scaling(VIOLIN_SCALE)

# The violinist's pose for a note's pitch, the place on the bow at the string and how far it is
# lifted: the violin's frame and the bow's frog and the way it lies (all in the hips frame).
struct ViolinPose:
    r: Rig
    vf: mat4
    frog: vec3
    across: vec3

violin_pose = (pitch: f64, s: f64, lift: f64, lean: f64, sway: f64) -> ViolinPose:
    r = Rig()
    r.lean = 0.04 + lean; r.tilt = 0.03 + sway
    r.head_tilt = 0.32; r.head_nod = 0.12
    vf = violin_frame(r)
    # the left hand on the neck: further up toward the body for the higher notes
    along = 0.41 - 0.08 * clamp((pitch - 69.0) / 18.0, 0.0, 1.0)
    r.left = transform_point(vf, vec3(f32(along), -0.035, 0))
    r.left_pole = vec3(0.1, -1, 0.2)
    # the bow across the strings by the bridge, tipped for the string the note is on
    string = clamp((pitch - 55.0) / 7.0, 0.0, 3.0)
    contact = transform_point(vf, vec3(0.19, f32(0.04 + lift / VIOLIN_SCALE), 0))
    across = normalize(transform_dir(vf, vec3(0, f32(0.2 - 0.14 * string), 1)))
    # (the bow lies across, frog toward the player's right)
    if f64(across.x) < 0.0: across = -across
    frog = contact + across * f32(s)
    r.right = frog + normalize(transform_dir(vf, vec3(0, 1, 0))) * 0.03
    r.right_pole = vec3(0.6, -1, 0.3)
    ViolinPose(r, vf, frog, across)

play_violin = (p: Player, m: PlayerMotion, ms: f64, kit: InstrumentKit, L: Light, t: f64):
    k = group_at(m.groups, ms)
    pitch = if k >= 0: m.groups[k].mean else: 69.0
    # (the body leans a little into each stroke's start)
    lean = if k >= 0: 0.03 * m.groups[k].level * pluck_curve((ms - m.groups[k].start) * 0.3) else: 0.0
    s, lift = bow_at(m.strokes, ms)
    v = violin_pose(pitch, s, lift, lean, 0.02 * sin(t * 0.6 + p.seed))
    hips = draw_rig(p.fig, p.at, v.r, kit, L, t, p.offset)
    draw(obj_sh, kit.violin, obj_local_params(L, t, hips * v.vf))
    top = normalize(transform_dir(v.vf, vec3(0, 1, 0)))
    draw(obj_sh, kit.bow, obj_local_params(L, t, hips * neck_frame(v.frog, v.across, cross(v.across, top))))

# Seated at a keyboard: `keys` is where the middle of the keys is, from the figure's feet (world
# metres: across, up, ahead), `width` the keyboard's.
play_piano = (p: Player, m: PlayerMotion, ms: f64, keys: vec3, width: f64, kit: InstrumentKit, L: Light, t: f64):
    r = Rig(seated = true)
    h = f64(p.fig.height)
    drop = rig_drop(p.fig, true)
    key_y = f64(keys.y) / h - drop
    key_z = -f64(keys.z) / h
    place = (pitch: f64) -> f64: f64(keys.x) / h + (pitch - 64.5) / 87.0 * width / h
    lh = hand_track(m.left, ms, place, place(48.0))
    rh = hand_track(m.right, ms, place, place(72.0))
    # (the body leans toward the hand that is furthest out)
    r.lean = 0.1
    r.tilt = -clamp((lh.pos + rh.pos) * 0.35, -0.12, 0.12)
    r.head_nod = 0.25
    r.head_tilt = r.tilt * 0.5
    r.left = vec3(f32(lh.pos), f32(key_y + 0.045 - 0.03 * lh.dip + 0.05 * lh.lift), f32(key_z))
    r.right = vec3(f32(rh.pos), f32(key_y + 0.045 - 0.03 * rh.dip + 0.05 * rh.lift), f32(key_z))
    r.left_pole = vec3(-1, -0.6, 0.3); r.right_pole = vec3(1, -0.6, 0.3)
    draw_rig(p.fig, p.at, r, kit, L, t, p.offset)

# A guitar, a mandolin or a bouzouki across the body: the body at the right hip (seated, on the
# thigh), the neck up to the left; the left hand along the neck with the pitch, the right hand at
# the sound hole plucking each onset, sweeping across for a chord.
play_plucked = (p: Player, m: PlayerMotion, ms: f64, kind: int, seated: bool, kit: InstrumentKit, L: Light, t: f64):
    r = Rig(seated = seated)
    r.lean = if seated: 0.12 else: 0.03
    r.head_nod = 0.3; r.head_tilt = 0.12
    k = group_at(m.groups, ms)
    hole = if seated: vec3(0.04, 1.08, -0.36) else: vec3(0.04, 1.14, -0.3)
    rise = if seated: 0.5 else: 0.38
    along = vec3(f32(-cos(rise)), f32(sin(rise)), -0.12)
    face = vec3(0, 0.25, -1)
    scale = if kind == 0: 1.05 else: 1.0
    nut = if kind == 0: 0.58 else: if kind == 1: 0.34 else: 0.56
    body_end = if kind == 0: 0.12 else: if kind == 1: 0.1 else: 0.1
    # (the right hand: back in a rest, sweeping across the strings for a chord, a flick for a note)
    strum = 0.0; pick = 0.0
    if k >= 0:
        c = pluck_curve(ms - m.groups[k].start)
        if m.groups[k].high - m.groups[k].low >= 7: strum = c else: pick = c
    inst = translation(hole) * neck_frame(vec3(0, 0, 0), along, face) * scaling(f64(scale))
    pitch = if k >= 0: f64(m.groups[k].high) else: f64(m.low + m.high) * 0.5
    reach = neck_reach(m, pitch)
    on_neck = nut - (nut - body_end) * reach * 0.85
    r.left = transform_point(inst, vec3(f32(on_neck), -0.05, -0.01))
    r.left_pole = vec3(-0.3, -1, 0.6)
    r.right = transform_point(inst, vec3(f32(-0.04 + 0.01 * pick), f32(0.06 - 0.12 * strum - 0.025 * pick), f32(0.08 + 0.02 * pick)))
    r.right_pole = vec3(1, -0.4, 0.6)
    hips = draw_rig(p.fig, p.at, r, kit, L, t, p.offset)
    mesh = if kind == 0: kit.guitar else: if kind == 1: kit.mandolin else: kit.bouzouki
    draw(obj_sh, mesh, obj_local_params(L, t, hips * inst))

# The accordion before the chest: the treble end at the right hand (its keys, high notes lower down,
# under the fingers), the bass end at the left hand, the bellows between, breathing with the phrases.
play_accordion = (p: Player, m: PlayerMotion, ms: f64, kit: InstrumentKit, L: Light, t: f64):
    r = Rig()
    r.lean = 0.03; r.head_nod = 0.18
    w = bellows_at(m.strokes, ms)
    r.tilt = (w - 0.22) * 0.25
    r.head_tilt = 0.08
    y = 1.12
    right_x = 0.16
    left_x = right_x - 0.075 - w
    place = (pitch: f64) -> f64: 0.14 - 0.26 * clamp((pitch - f64(m.low)) / f64(max(m.high - m.low, 1)), 0.0, 1.0)
    hand = hand_track(m.groups, ms, place, 0.0)
    r.right = vec3(f32(right_x + 0.03 + 0.012 * hand.dip), f32(y + hand.pos), -0.36)
    r.right_pole = vec3(1, -0.7, 0)
    r.left = vec3(f32(left_x - 0.06), f32(y), -0.24)
    r.left_pole = vec3(-1, -0.7, 0.2)
    hips = draw_rig(p.fig, p.at, r, kit, L, t, p.offset)
    at = hips * translation(vec3(0, f32(y), -0.24))
    draw(obj_sh, kit.box_right, obj_local_params(L, t, at * translation(vec3(f32(right_x), 0, 0))))
    draw(obj_sh, kit.bellows, obj_local_params(L, t, at * translation(vec3(f32(right_x - 0.04 - w * 0.5), 0, 0)) * scaling(vec3(f32(w), 1, 1))))
    draw(obj_sh, kit.box_left, obj_local_params(L, t, at * translation(vec3(f32(left_x), 0, 0))))

# A clarinet to the mouth, down and out; the fingers moving on the notes and the bell lifting into
# the phrases and the accents.
play_clarinet = (p: Player, m: PlayerMotion, ms: f64, kit: InstrumentKit, L: Light, t: f64):
    r = Rig()
    lift = accent_lift(m, ms)
    r.lean = 0.02 - 0.08 * lift
    r.head_nod = 0.1 - 0.15 * lift
    r.tilt = 0.02 * sin(t * 0.7 + p.seed)
    trunk = rig_trunk(r)
    head = trunk * translation(vec3(0, 1.5, 0)) * rotation_x(-r.head_nod) * translation(vec3(0, -1.5, 0))
    mouth = transform_point(head, vec3(0, 1.62, -0.19))
    down = 0.6 + 0.35 * lift
    dir = normalize(transform_dir(trunk, vec3(0, f32(-cos(down)), f32(-sin(down)))))
    k = group_at(m.groups, ms)
    finger = if k >= 0: pluck_curve(ms - m.groups[k].start) * 0.012 else: 0.0
    toward = normalize(cross(dir, vec3(1, 0, 0)))
    if f64(toward.z) < 0.0: toward = -toward
    r.left = mouth + dir * 0.2 + toward * f32(0.035 - finger)
    r.right = mouth + dir * 0.4 + toward * f32(0.035 - finger * (if k >= 0 and k % 2 == 1: 1.0 else: 0.4))
    r.left_pole = vec3(-1, -0.5, 0); r.right_pole = vec3(1, -0.6, 0.2)
    hips = draw_rig(p.fig, p.at, r, kit, L, t, p.offset)
    draw(obj_sh, kit.clarinet, obj_local_params(L, t, hips * neck_frame(mouth, dir, toward) * rotation_z(-PI * 0.5)))

# The double bass stood before the player, a little to the left: the left hand high on the neck,
# lower for higher notes; the right hand plucking at the end of the fingerboard.
play_bass = (p: Player, m: PlayerMotion, ms: f64, kit: InstrumentKit, L: Light, t: f64):
    r = Rig()
    r.lean = 0.08; r.turn = 0.25; r.head_tilt = 0.1; r.head_nod = 0.15
    k = group_at(m.groups, ms)
    stand = translation(vec3(-0.3, 0, -0.36)) * rotation_y(PI + 0.55) * rotation_x(-0.2) * scaling(0.92)
    pitch = if k >= 0: m.groups[k].mean else: f64(m.low)
    reach = clamp((pitch - f64(m.low)) / f64(max(m.high - m.low, 1)), 0.0, 1.0)
    pluck = if k >= 0: pluck_curve(ms - m.groups[k].start) else: 0.0
    r.left = transform_point(stand, vec3(-0.05, f32(1.8 - 0.4 * reach), 0.1))
    r.left_pole = vec3(-1, -0.3, 0)
    r.right = transform_point(stand, vec3(f32(0.06 + 0.06 * pluck), 1.08, f32(0.16 + 0.03 * pluck)))
    r.right_pole = vec3(1, -1, 0.4)
    hips = draw_rig(p.fig, p.at, r, kit, L, t, p.offset)
    draw(obj_sh, kit.bass, obj_local_params(L, t, hips * stand))

# A singer: swaying a little, the mouth open on the sung notes (wider on the open vowels), the head
# lifting for the high notes, one hand at the chest and the other opening into the phrases.
play_singer = (p: Player, m: PlayerMotion, ms: f64, kit: InstrumentKit, L: Light, t: f64):
    r = Rig()
    k = group_at(m.groups, ms)
    on = k >= 0 and ms < m.groups[k].end
    open = 0.0
    if on:
        age = ms - m.groups[k].start
        open = clamp(age / 0.06, 0.0, 1.0) * (0.45 + 0.55 * m.groups[k].level)
    else if k >= 0:
        open = max(0.0, 1.0 - (ms - m.groups[k].end) / 0.08) * 0.5
    r.mouth = open
    phrase = accent_lift(m, ms)
    pitch = if k >= 0: m.groups[k].mean else: 67.0
    r.tilt = 0.05 * sin(t * 1.1 + p.seed)
    r.turn = 0.06 * sin(t * 0.55 + p.seed)
    r.head_nod = -0.02 - 0.012 * clamp(pitch - 67.0, -6.0, 10.0)
    r.left = vec3(-0.06, 1.12, -0.24)
    r.left_pole = vec3(-1, -0.8, 0)
    r.right = vec3(f32(0.36 + 0.06 * phrase), f32(0.98 + 0.12 * phrase), f32(-0.22 - 0.12 * phrase))
    r.right_pole = vec3(1, -0.8, 0.2)
    draw_rig(p.fig, p.at, r, kit, L, t, p.offset)

# A street musician with a bouzouki, playing the phrase heard in the square (standing, or seated
# on a bench).
# `person` is who plays (the phrase is offset by it), `t` the world's time the phrase is heard on.
play_street = (p: Player, person: int, seated: bool, kit: InstrumentKit, L: Light, t: f64):
    notes: PartNote[]
    loop e in street_events(person, t):
        at = f64(e.start) / f64(MUSIC_RATE)
        notes.push(PartNote(at, at + f64(e.duration) / f64(MUSIC_RATE), e.pitch, e.gain))
    m = player_motion(STREET_PART, notes)
    m.low = STREET_ROOT; m.high = STREET_ROOT + 12
    play_plucked(p, m, t, 2, seated, kit, L, t)
