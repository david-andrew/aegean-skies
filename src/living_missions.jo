# Player military work names real orders, survivors, reports and consignments. Every offer
# has finite treasury escrow; proximity/recon/pickup are evidence, never UI-button outcomes.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_mission_types.jo'
use 'living_war_types.jo'
use 'living_war.jo'
use 'living_war_rescue.jo'
use 'living_war_access.jo'
use 'living_commissions.jo'
use 'living_far_news.jo'
use 'living_far_stock.jo'
use 'living_place_context.jo'
use 'living_money.jo'
use 'living_guard.jo'
use 'living_transaction.jo'

const WAR_MISSION_LIMIT=96

mission_position = (w: World, actor: int) -> vec3: person_world_position(w,actor)

escort_distance_left = (w: World, vehicle: int) -> int:
    if vehicle<0 or vehicle>=w.far.vehicles.len(): return 0
    id=w.far.vehicles[vehicle].journey
    if id<0 or not (id in w.far.journeys): return 0
    j=w.far.journeys[id]; points=w.far.links[j.link].points
    if not j.forward: points.reverse()
    result= -j.progress_mm
    loop k in j.segment..points.len()-1:
        result+=int(round(f64(length(points[k+1]-points[k]))*1000.0))
    max(0,result)

mission_views = (w: World, place: int = -1, actor: int = -1) -> MissionView[]:
    result: MissionView[]
    ids=w.war.missions.keys(); ids.sort()
    loop id in ids:
        m=w.war.missions[id]
        if place>=0 and m.origin!=place: continue
        if actor>=0 and m.carrier!=actor: continue
        result.push(MissionView(id,m.kind,m.country,m.origin,m.destination,m.target,m.reward,m.deadline,m.state,m.progress_ticks,m.required_ticks,m.commission,m.why))
    result

_mission_offer = (w: mut World, country: int, kind: CommissionKind, origin: int, destination: int, target: int, reward: int) -> int:
    if not w.far.populated or country<0 or country>=3 or not (origin in w.far.districts) or not (destination in w.far.districts) or reward<=0 or w.war.missions.len()>=WAR_MISSION_LIMIT: return -1
    if w.far.districts[origin].controller!=country: return -1
    loop _, m in w.war.missions:
        if m.country==country and m.kind==kind and m.target==target and (m.state==.open or m.state==.claimed): return -1
    if kind==.escort:
        if target<0 or target>=w.far.vehicles.len() or w.far.vehicles[target].journey<0 or w.far.vehicles[target].hull<=350 or escort_distance_left(w,target)<2152000: return -1
    else if kind==.rescue:
        if not (target in w.war.survivors) or w.war.survivors[target].resolved or w.minute>w.war.survivors[target].deadline: return -1
    else if kind==.reconnaissance:
        if not (target in w.far.districts): return -1
    else if kind==.mail:
        if not (target in w.far.news):
            found=false
            loop r in w.far.districts[origin].reports:
                if r.id==target: found=true
            if not found: return -1
    else if kind==.smuggling:
        if blockade_unit(w,destination)<0: return -1
    else: return -1
    payer=w.far.treasury[country]
    if w.accounts[payer].cents<reward: return -1
    initialize_war(w)
    id=w.war.next_mission
    distance=f64(length(w.place_contexts[origin].center-w.place_contexts[destination].center))
    deadline=w.minute+max(2880,int(ceil(distance/120.0))*5+720)
    escrow= -1; commission= -1
    why=""
    if kind==.mail:
        reports=[loop r in w.far.districts[origin].reports: if r.id==target: r]
        if reports.len()==0: return -1
        commission=post_far_mail(w,origin,destination,country,reports[0],reward)
        if commission<0: return -1
        escrow=w.far.commissions[commission].escrow; deadline=w.far.commissions[commission].deadline
        why=w.far.commissions[commission].why
    else if kind==.smuggling:
        # An occupied clinic's actual medicine, not a spawned mission token.
        requests=[loop r in w.far.districts[origin].reports: if r.kind=="supply_request" and r.origin==destination and r.supply_good==6 and r.hops==0 and r.confidence>=900 and w.minute<=r.supply_due: r]
        if requests.len()==0: return -1
        requests.sort((r: FarReport): (r.occurred_minute,r.id),descending=true)
        request=requests[0]
        qty=min(request.supply_qty,min(1000,far_market_qty(w,origin,6)))
        if qty<100: return -1
        commission=post_far_commission(w,origin,destination,6,qty,.smuggling,reward,country,request)
        if commission<0: return -1
        escrow=w.far.commissions[commission].escrow; deadline=w.far.commissions[commission].deadline
        why="Carry the paid medicine from {life_place_name(w,origin)} to {life_place_name(w,destination)} through the cordon. The clinic's cargo and its title are recorded; the payment is {f64(reward)/100.0:.2} lire."
    else:
        escrow=new_account(w,"military-mission:{id}")
        if not transfer(w,payer,escrow,reward,.escrow,id): living_fault("mission.escrow",guard_context(w)); return -1
        if kind==.escort:
            why="Accompany carrier {target} through one nautical mile of its voyage, keeping within 1.2 km while it is underway. Return to the office at {life_place_name(w,destination)} for {f64(reward)/100.0:.2} lire."
        else if kind==.reconnaissance:
            why="Observe the flags at {life_place_name(w,target)} from the air, then bring your dated report to {life_place_name(w,destination)}. Payment: {f64(reward)/100.0:.2} lire."
        else:
            s=w.war.survivors[target]
            deadline=min(deadline,s.deadline)
            who=if s.person>=0: w.people[s.person].name else: "a survivor of carrier {s.vehicle}"
            why="Pick up {who} from their actual last position and land them safely at {life_place_name(w,destination)} before the rescue window closes. Payment: {f64(reward)/100.0:.2} lire."
    poster=w.far.districts[origin].market_owner
    if poster<0 and w.far.districts[origin].core>=0: poster=w.places[w.far.districts[origin].core].market_owner
    w.war.missions[id]=WarMission(id=id,kind=kind,country=country,origin=origin,destination=destination,target=target,escrow=escrow,reward=reward,posted=w.minute,deadline=deadline,why=why,poster=poster,commission=commission,required_ticks=if kind==.escort: 1852000 else: if kind==.reconnaissance: 240 else: 1)
    if kind==.escort: w.war.missions[id].target_journey=w.far.vehicles[target].journey
    w.war.next_mission+=1
    far_local_news(w,origin,"military_work",why,country=country,severity=250,mission=id)
    id

post_mission = (w: mut World, country: int, kind: CommissionKind, origin: int, destination: int, target: int, reward: int) -> int:
    if guard_blocked(): return -1
    scope=guard_begin(w)
    result=_mission_offer(w,country,kind,origin,destination,target,reward)
    failed=guard_failed(scope); guard_finish(w,scope)
    if failed: -1 else: result

claim_mission = (w: mut World, id: int, actor: int = 0, loader: CarriageChoice = .player) -> bool:
    if not (id in w.war.missions) or actor<0 or actor>=w.people.len(): return false
    m=w.war.missions[id]
    if m.state!=.open or w.minute>m.deadline or length(mission_position(w,actor)-far_counter(w,m.origin))>40: return false
    if m.kind==.escort and (w.far.vehicles[m.target].journey!=m.target_journey or escort_distance_left(w,m.target)<m.required_ticks+300000): return false
    # A mercenary can carry cargo while escorting, but cannot promise two tactical sorties.
    loop _, old in w.war.missions:
        if old.carrier==actor and old.state==.claimed and old.commission<0 and m.commission<0: return false
    if m.kind!=.rescue and w.war.reputation.get("{actor}:{m.country}",0)< -300: return false
    if m.commission>=0 and not claim_far_commission(w,m.commission,actor,loader): return false
    w.war.missions[id].carrier=actor; w.war.missions[id].state=.claimed
    w.war.missions[id].last_tick=w.tick
    w.war.missions[id].last_actor_pos=mission_position(w,actor)
    if m.kind==.escort: w.war.missions[id].last_target_pos=w.far.vehicles[m.target].pos
    if m.kind==.rescue: w.war.missions[id].rescue_baseline=w.war.next_rescue_receipt
    true

# Actual mission evidence is updated per game minute, never by opening a menu or chart.
mission_progress = (w: mut World, id: int):
    m=w.war.missions[id]
    if m.state!=.claimed or m.carrier<0: return
    if m.commission>=0:
        if not (m.commission in w.far.commissions): return
        c=w.far.commissions[m.commission]
        if c.phase==.delivered:
            w.war.missions[id].state=if c.failed_minute<0: MissionState.completed else: MissionState.failed
            w.war.missions[id].completed_minute=w.minute
            if c.failed_minute<0: w.war.missions[id].paid=m.reward
        return
    craft=w.people[m.carrier].craft
    if craft<0 or craft>=w.aircraft.len(): return
    c=w.aircraft[craft]; now=mission_position(w,m.carrier)
    elapsed=max(0,w.tick-m.last_tick); w.war.missions[id].last_tick=w.tick
    if m.kind==.escort:
        v=w.far.vehicles[m.target]
        if c.state==.airborne and v.journey==m.target_journey and v.journey>=0 and v.hull>350 and length(now-v.pos)<1200 and length(m.last_actor_pos-m.last_target_pos)<1200:
            travelled=int(round(f64(length(v.pos-m.last_target_pos))*1000.0))
            # Endpoint samples and elapsed speed bound exclude a discontinuous debug move.
            plausible=elapsed*v.speed_mm_sec/60+1000
            if travelled<=plausible: w.war.missions[id].progress_ticks=min(m.required_ticks,m.progress_ticks+travelled)
        w.war.missions[id].last_target_pos=v.pos
    else if m.kind==.reconnaissance:
        where=w.place_contexts[m.target].center
        altitude=f64(now.y-where.y)
        if c.state==.airborne and altitude>=80 and altitude<=1500 and length(now.xz-where.xz)<2500:
            w.war.missions[id].progress_ticks=min(m.required_ticks,m.progress_ticks+min(elapsed,120))
            if w.war.missions[id].progress_ticks>=m.required_ticks:
                w.war.missions[id].observed_controller=w.far.districts[m.target].controller
                w.war.missions[id].observed_minute=w.minute
    else if m.kind==.rescue:
        loop r in w.war.rescue_receipts:
            if r.id>=m.rescue_baseline and r.survivor==m.target and r.actor==m.carrier and r.place==m.destination:
                w.war.missions[id].progress_ticks=m.required_ticks
    w.war.missions[id].last_actor_pos=now

finish_mission = (w: mut World, id: int, actor: int = 0) -> bool:
    if not (id in w.war.missions): return false
    m=w.war.missions[id]
    if m.state!=.claimed or m.carrier!=actor or m.commission>=0 or w.minute>m.deadline or m.progress_ticks<m.required_ticks or length(mission_position(w,actor)-far_counter(w,m.destination))>8: return false
    craft=w.people[actor].craft
    if craft>=0 and (w.aircraft[craft].state==.airborne or w.aircraft[craft].state==.approach): return false
    if m.kind==.rescue:
        found=false
        loop r in w.war.rescue_receipts:
            if r.id>=m.rescue_baseline and r.survivor==m.target and r.actor==actor and r.place==m.destination: found=true
        if not found: return false
    if m.kind==.reconnaissance and m.observed_minute<0: return false
    money=w.accounts[m.escrow].cents
    if money<m.reward: return false
    if not transfer(w,m.escrow,w.people[actor].account,m.reward,.reward,id): return false
    w.war.missions[id].state=.completed; w.war.missions[id].paid=m.reward
    w.war.missions[id].completed_minute=w.minute
    key="{actor}:{m.country}"
    w.war.reputation[key]=clamp(w.war.reputation.get(key,0)+20,-1000,1000)
    text="{w.people[actor].name} completed the {m.kind} commission for {w.countries[m.country].name} at {life_place_name(w,m.destination)}."
    if m.kind==.reconnaissance:
        clock=local_minute(m.observed_minute)
        text="{w.people[actor].name} observed {w.countries[m.observed_controller].name}'s flags at {life_place_name(w,m.target)} on day {day_index(m.observed_minute)+1}, {clock/60:02}:{clock%60:02}, and brought the report to {life_place_name(w,m.destination)}."
    far_local_news(w,m.destination,if m.kind==.reconnaissance: "reconnaissance" else: "mission_completed",text,actor=actor,country=m.country,severity=500,other_country=m.observed_controller,subject_place=if m.kind==.reconnaissance: m.target else: -1,subject_minute=m.observed_minute)
    true

missions_minute = (w: mut World):
    if not w.far.populated: return
    ids=w.war.missions.keys(); ids.sort()
    loop id in ids:
        mission_progress(w,id)
        m=w.war.missions[id]
        if (m.state==.open or m.state==.claimed) and w.minute>m.deadline:
            # Cargo-backed contracts own their own refund/custody transaction.
            if m.commission<0:
                cash=w.accounts[m.escrow].cents
                if cash>0: transfer(w,m.escrow,w.far.treasury[m.country],cash,.refund,id)
            w.war.missions[id].state=if m.carrier>=0: MissionState.failed else: .expired
            w.war.missions[id].completed_minute=w.minute
            if m.carrier>=0:
                key="{m.carrier}:{m.country}"
                w.war.reputation[key]=clamp(w.war.reputation.get(key,0)-8,-1000,1000)
        if (m.state==.completed or m.state==.failed or m.state==.expired) and w.minute-m.completed_minute>10080: w.war.missions.remove(id)

# An office publishes actual unmet needs from received reports or its own nearby issued orders.
# The same operation runs without a player; reading the offer projection remains pure.
refresh_military_work = (w: mut World, place: int) -> int[]:
    result: int[]
    if not w.far.populated or not (place in w.far.districts): return result
    country=w.far.districts[place].controller
    active=0
    loop _, m in w.war.missions:
        if m.country==country and (m.state==.open or m.state==.claimed): active+=1
    if active>=4: return result
    seat=if w.countries[country].capital_id>=0: w.countries[country].capital_id else: w.countries[country].seat
    reports=w.far.districts[place].reports
    loop r in reports:
        if active>=4: break
        if not far_report_current(w,r): continue
        kind: CommissionKind?=none; target= -1; destination=place
        if r.rescue>=0 and r.rescue in w.war.survivors:
            s=w.war.survivors[r.rescue]
            if not s.resolved and (s.country==country or country==0): kind=.rescue; target=r.rescue
        else if r.kind=="blockade" and r.origin!=place and w.far.districts[r.origin].born_country==country:
            kind=.smuggling; target=r.origin; destination=r.origin
        else if (r.kind=="armed_intrusion" or r.kind=="occupation" or r.kind=="battle") and r.origin!=place:
            kind=.reconnaissance; target=r.origin
        else if r.country==country and seat>=0 and seat!=place and w.minute-r.occurred_minute<2880 and (r.kind=="orders" or r.kind=="mobilization"):
            kind=.mail; target=r.id; destination=seat
        if kind==none: continue
        distance=f64(length(w.place_contexts[place].center-w.place_contexts[if kind==.reconnaissance: target else: destination].center))
        reward=1800+int(round(distance*0.12))
        id=post_mission(w,country,kind!,place,destination,target,reward)
        if id>=0: result.push(id); active+=1
    # A real departure from this port can ask for an air escort through its opening mile.
    threatened=false
    loop r in reports:
        if r.severity>=700 and far_report_current(w,r): threatened=true
    if threatened and active<4:
        loop v in w.far.vehicles:
            if v.citizen!=country or v.journey<0 or w.far.journeys[v.journey].origin!=place: continue
            id=post_mission(w,country,.escort,place,place,v.id,2400)
            if id>=0: result.push(id)
            break
    result

mission_offices_minute = (w: mut World):
    if not w.far.populated or w.minute%180!=0: return
    offices: {int: bool}
    loop c in w.countries:
        place=if c.capital_id>=0: c.capital_id else: c.seat
        if place>=0 and place in w.far.districts: offices[place]=true
    loop u in w.war.units:
        if u.retired or u.vehicle<0: continue
        place=w.far.vehicles[u.vehicle].place
        if place>=0 and w.far.districts[place].controller==u.country: offices[place]=true
    keys=offices.keys(); keys.sort()
    loop place in keys: refresh_military_work(w,place)
