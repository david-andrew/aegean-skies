# Swimming, from a beach or the end of a dock: wade in, swim, and come out again where the ground
# rises (or climb out onto a dock). Whether one swims, wades or is out of the water goes by the
# depth under the still water (`still`), with a band between swimming and wading: in a rough sea
# the swell's troughs once ended a swim where the still water was deeper than one may walk, and the
# pilot, dressed again, could step nowhere. The swell still lifts the swimmer and shows at the feet.
# No needs, no tiredness, no penalty: the sea is for the pleasure
# of it. Pure: the game gives the ground and the water's level (the unified water query: an inland
# lake or river's level, else the sea's swell, the same the sea is drawn with) as functions, and
# draws the swimmer, the splashes and the camera.

const SWIM_DEPTH = 1.15             # deeper than this, one swims; shallower, one wades
const SWIM_OUT = 0.25               # shallower than this, one is out of the water
const SWIM_SPEED = 0.85             # m/s (a strong stroke 1.35)
const WADE_SPEED = 0.9
const SWIM_BODY = 0.95              # the swimmer's feet below the surface (their body lies along it)
const SWIM_BAND = 0.15              # (swimming and wading change over this either side of SWIM_DEPTH)
const DIVE_SECONDS = 0.75

struct Swim:
    active = false
    swimming = false                # (else wading)
    stroke = 0.0                    # the arms' phase (radians)
    effort = 0.0                    # 0 treading water .. 1 a strong stroke
    level = 0.0                     # the water's surface here
    depth = 0.0
    diving = -1.0                   # 0..1 through a dive off a dock; -1 not diving
    dive_from: vec3 = vec3(0, 0, 0)
    dive_to: vec3 = vec3(0, 0, 0)
    shore: vec3 = vec3(0, 0, 0)     # where one went in (saving mid-swim puts the pilot back there)
    started = 0                     # (the world minute: for the notebook)
    strokes = 0
    splash = false                  # (a stroke's hand went in this step: the game throws a little spray)
    wet = false                     # (been in deeper than the ankles: only then does dry ground end the swim)

struct SwimStep:
    pos: vec3
    out = false                     # walked out onto dry ground: the swim is over

# Where the swimmer is held: the feet on the bottom while wading, the body along the surface when
# swimming (it rises and falls with the swell).
swim_height = (s: Swim, ground: f64) -> f64:
    if s.swimming: max(s.level - SWIM_BODY, ground) else: ground

# Swimming once deeper than SWIM_DEPTH + SWIM_BAND under the still water, wading again once
# shallower than SWIM_DEPTH - SWIM_BAND: a passing wave never flips one into the other.
swim_band = (swimming: bool, calm: f64) -> bool:
    if swimming: calm > SWIM_DEPTH - SWIM_BAND else: calm > SWIM_DEPTH + SWIM_BAND

# One step of the swim, moving `move` (metres, flat) this frame. A quay or a pier's stone stands
# out of the water like a wall: one swims along it, not into it. `level` is the surface as it is
# (with the swell), `still` the water's level without it.
swim_step = (s: mut Swim, pos: vec3, move: vec2, dt: f64, strong: bool, ground: (f64, f64) -> f64, level: (f64, f64) -> f64, still: (f64, f64) -> f64) -> SwimStep:
    s.splash = false
    if s.diving >= 0.0:
        s.diving = min(1.0, s.diving + dt / DIVE_SECONDS)
        u = s.diving
        p = s.dive_from + (s.dive_to - s.dive_from) * f32(u) + vec3(0, f32(sin(u * PI) * 0.9), 0)
        if u >= 1.0:
            s.diving = -1.0; s.splash = true
            s.level = level(f64(s.dive_to.x), f64(s.dive_to.z))
            s.depth = s.level - ground(f64(s.dive_to.x), f64(s.dive_to.z))
            s.swimming = still(f64(s.dive_to.x), f64(s.dive_to.z)) - ground(f64(s.dive_to.x), f64(s.dive_to.z)) > SWIM_DEPTH
            s.wet = true
            return SwimStep(vec3(s.dive_to.x, f32(swim_height(s, ground(f64(s.dive_to.x), f64(s.dive_to.z)))), s.dive_to.z))
        return SwimStep(p)
    x = f64(pos.x); z = f64(pos.z)
    moving = f64(length(move)) > 0.0001
    if moving:
        nx = x + f64(move.x); nz = z + f64(move.y)
        g = ground(nx, nz); lv = still(nx, nz)
        # (a wall: dry ground well above the still water, beside water too deep to stand in; by the
        # swell's level a beach ahead stood up as a wall in every trough)
        wall = g > lv + 0.5 and lv - ground(x, z) > SWIM_DEPTH * 0.6
        if not wall:
            x = nx; z = nz
    g = ground(x, z)
    s.level = level(x, z)
    s.depth = s.level - g
    calm = still(x, z) - g
    if calm >= SWIM_OUT + 0.15: s.wet = true
    if calm < SWIM_OUT and s.wet: return SwimStep(vec3(f32(x), f32(g), f32(z)), true)
    s.swimming = swim_band(s.swimming, calm)
    s.effort = if not moving: 0.0 else: if strong: 1.0 else: 0.6
    before = s.stroke
    s.stroke += dt * (if s.swimming: 1.6 + 1.6 * s.effort else: 0.0)
    # (each hand goes in once a turn of the stroke)
    if s.swimming and moving and floor(before / PI) != floor(s.stroke / PI):
        s.splash = true; s.strokes += 1
    SwimStep(vec3(f32(x), f32(swim_height(s, g)), f32(z)))

swim_speed = (s: Swim, strong: bool) -> f64: if s.swimming: (if strong: 1.35 else: SWIM_SPEED) else: WADE_SPEED

# Going in: off the end of a dock (a dive, out into deep water) or walking into the sea from a beach.
swim_begin = (s: mut Swim, pos: vec3, facing: vec2, minute: int, ground: (f64, f64) -> f64, level: (f64, f64) -> f64):
    s.active = true; s.started = minute; s.strokes = 0; s.shore = pos
    s.stroke = 0.0; s.effort = 0.0
    x = f64(pos.x); z = f64(pos.z)
    here = level(x, z)
    if ground(x, z) > here + 0.6:
        # (standing on a dock above deep water: a dive, two and a half metres out)
        to = vec3(f32(x + f64(facing.x) * 2.6), 0, f32(z + f64(facing.y) * 2.6))
        lv = level(f64(to.x), f64(to.z))
        s.dive_from = pos; s.dive_to = vec3(to.x, f32(lv - SWIM_BODY), to.z)
        s.diving = 0.0; s.swimming = true; s.level = lv
    else:
        s.diving = -1.0; s.swimming = false; s.level = here
        s.depth = here - ground(x, z)

# Where to climb out onto a dock: a dry deck within reach of the swimmer (an arm's length), if any.
swim_climb_out = (pos: vec3, ground: (f64, f64) -> f64, level: (f64, f64) -> f64) -> vec3?:
    x = f64(pos.x); z = f64(pos.z)
    lv = level(x, z)
    best: vec3? = none
    # (only from deep water beside a raised deck; on a beach one just walks out)
    if lv - ground(x, z) < SWIM_DEPTH * 0.8: return best
    bd = 1e9
    loop k in 0..12:
        a = f64(k) * TAU / 12.0
        loop r in [0.9, 1.5]:
            px = x + cos(a) * r; pz = z + sin(a) * r
            g = ground(px, pz)
            if g > lv + 0.3 and g < lv + 2.2 and r < bd:
                bd = r; best = vec3(f32(px), f32(g), f32(pz))
    best

swim_words = (s: Swim) -> str:
    if s.diving >= 0.0: return "In you go."
    if not s.swimming: return "Wading. Deeper water ahead; the shore behind."
    if s.effort > 0.8: return "A strong stroke."
    if s.effort > 0.0: return "Swimming."
    "Treading water. The sea holds you up."
