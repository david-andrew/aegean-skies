# Surf (the Tweaks page's "Surf", off by default): waves arriving on a beach or rocks as the film
# paints them. Each wave peels in along the shore (its phase drifts along the coast), breaks as a
# crisp rolled white lip at the break line, and runs in as a bore with a sheet of lace foam behind
# it: pale foam broken by dark rounded holes, thinning as it ages. Over the sand the bore runs up
# as a thin sheet with a bright foam edge, climbs fast, slides back slowly, and leaves dark glossy
# wet sand that dries until the next wave. On rocks it bursts up the face instead.
#
# Shared by the sea's material (the bore and lace in the water, sea.jo) and the coastal ground's
# (the run-up, the wet sand and the bursts, terrain.jo), so the two meet exactly. Shader code
# only, closed form in time: nothing is stepped, and the open sea is not touched (all of it is
# exactly zero beyond the surf zone's depth).
use 'look.jo'
use 'tweaks.jo'
use 'world_point.jo'
use 'quality.jo'

# (CPU) the trial's uniform: x 1 when on, y the sea's energy from the wind (0 calm .. 1 a fresh blow)
surf_uniform = () -> vec4: vec4(if tweaks.surf: 1.0 else: 0.0, f32(smoothstep(2.0,12.0,wind_now.speed)), f32(0.3+0.5*smoothstep(2.0,12.0,wind_now.speed)), 0)

# The wave's phase here, 0..1 (0: the lip breaks at the break line; 0.55: the bore reaches the
# waterline; then the run-up and the backwash). Neighbouring stretches of shore are a little
# out of step, so a wave peels along the coast instead of arriving everywhere at once.
surf_phase = (p: vec2, t: f32, energy: f32) -> f32:
    period = mix(8.5, 6.0, energy)
    offset = vnoise(p*0.011)*1.9
    fract(t/period+offset)

# How deep (m) the waves break: deeper in a fresh sea.
surf_break_depth = (energy: f32) -> f32: mix(1.6, 2.7, energy)

# Lace foam: pale foam with dark rounded holes, denser (0..1) the fresher the foam. Beyond a few
# hundred metres it is drawn as its average, so it never sparkles.
surf_lace = (p: vec2, t: f32, density: f32, dist: f32, pix: f32, low: bool = false) -> f32:
    # (far off, or with nothing to draw, its average: no noise evaluated; the low tier draws the
    # lace itself only within 200 m, and with one octave)
    if dist > (if low: 200.0 else: 420.0) or density <= 0.01: return clamp(density,0.0,1.0)*0.7
    q = p*0.32+vec2(sin(t*0.13)*1.5+t*0.05, cos(t*0.11)*1.5)
    n = if low: vnoise(q) else: vnoise(q)*0.62+vnoise(q*2.7+vec2(3.1,1.7))*0.38
    threshold = mix(0.82, 0.22, clamp(density,0.0,1.0))
    # (a crisp painted edge about a pixel wide, near or far: pix is a pixel's size in metres; the
    # noise's slope is about 0.9 per metre of q, so one pixel spans pix*0.32*0.9 of it)
    soft = max(pix*0.32*0.9*0.7, 0.002)
    lace = smoothstep(threshold-soft, threshold+soft, n)
    mix(lace, clamp(density,0.0,1.0)*0.7, smoothstep(if low: 80.0 else: 140.0, if low: 200.0 else: 420.0, dist))

# The foam on the water at depth `depth` (m): the breaking lip and the bore's front as crisp
# lines, the lace behind them, and the backwash's foam draining back. Zero beyond the surf zone.
surf_sea_foam = (p: vec2, t: f32, depth: f32, ddepth: f32, energy: f32, dist: f32, pix: f32, film: f32 = 9.0, dfilm: f32 = 0.0, low: bool = false) -> f32:
    db = surf_break_depth(energy)
    # The swash: where the water riding up the sand thins to nothing, a crisp foam edge, and lace
    # through the thin sheet behind it (film: the water's depth this instant over the ground).
    swash: f32 = 0.0
    if film < 0.35:
        edge_w = max(0.035, dfilm*2.0)
        # (the sheet itself stays thin clear water with a scatter of lace; only its edge is white)
        sheet_lace = 0.42*smoothstep(edge_w, edge_w*3.0, film)*(1.0-film/0.35)
        swash = max(1.0-smoothstep(edge_w*0.5, edge_w, film), surf_lace(p+vec2(5.0,3.0), t, sheet_lace, dist, pix, low))
    if depth > db*1.35: return swash
    c = surf_phase(p, t, energy)
    zone = 1.0-smoothstep(db*1.0, db*1.35, depth)
    foam: f32 = 0.0
    density: f32 = 0.38*(1.0-smoothstep(0.0, db*1.1, depth))
    if c < 0.55:
        front = db*pow(1.0-c/0.55, 1.15)
        # (in depth: at least a couple of pixels wide on screen, however flat the beach)
        width = max(0.05+0.04*energy, ddepth*2.5)
        # (the rolled lip at the front: brightest as it breaks, a crisp line all the way in)
        line = (1.0-smoothstep(width*0.4, width, abs(depth-front)))*(1.0-c*0.5)
        foam = line
        # (the lace behind it, fresh at the front and thinning seaward)
        behind = depth-front
        if behind > 0.0: density = max(density, exp(-behind/(0.5*db))*(1.0-0.5*c))
    else:
        # (the backwash: the inner surf's foam drains back seaward, thinning)
        x = (c-0.55)/0.45
        density = max(density, 0.55*(1.0-smoothstep(0.0, db*0.6, depth))*(1.0-x))
    max(max(foam, surf_lace(p, t, density, dist, pix, low))*zone, swash)

# The land at height y (m above the still sea): (spray cover, foam, wet), each 0..1. The water's
# own run-up over sand is the sea surface riding the swell (sea.jo); here, the sand it wets
# (dark and glossy below the swell's reach, drying toward its top) and, on steep rock, the bursts
# of white water thrown up the face as each wave strikes.
surf_swash = (p: vec2, t: f32, y: f32, slope: f32, energy: f32, reach: f32, dist: f32, pix: f32, low: bool = false) -> vec3:
    if y > reach*2.4+0.3 or y < -0.3: return vec3(0, 0, 0)
    wet = 1.0-smoothstep(reach*0.55, reach*1.05+0.05, y)
    rocky = smoothstep(0.3, 0.55, slope)
    foam: f32 = 0.0
    if rocky > 0.0 and dist < 500.0 and not low:
        c = surf_phase(p, t, energy)
        # (the strike as the bore arrives: white water leaps up the face and falls back)
        x = clamp((c-0.5)/0.35, 0.0, 1.0)
        top = (reach*2.2+0.2)*sin(x*3.1415927)*(0.6+0.4*energy)
        burst = (1.0-smoothstep(top*0.7, top, y))*step(0.0, top-0.02)
        foam = burst*surf_lace(p*1.7, t, 0.9-x*0.6, dist, pix)*rocky
    vec3(0, foam, wet*(1.0-rocky*0.4))

# The ships whose white water the sea paints this frame (vessel_spray.jo fills it): where each is,
# its heading, half length and half beam, how fast it goes (0..1 of its top speed).
struct SurfShip:
    at: WorldPoint
    yaw: f64
    half_length: f64
    half_beam: f64
    pace: f64
surf_ships: SurfShip[] = []

# (CPU) the four nearest to the eye as the sea's uniforms: a centre relative to the render origin
# with the heading's sine and cosine, then the half length, half beam and pace.
surf_ship_uniforms = (origin: vec3, eye: vec3, out: mut vec4[8]) -> int:
    order: int[]
    loop k in 0..surf_ships.len(): order.push(k)
    order.sort((k: int) -> f32: length(world_local(surf_ships[k].at, origin)-eye))
    n = min(if render_quality.tier == 0: 1 else: 4, order.len())
    loop j in 0..n:
        s = surf_ships[order[j]]
        c = world_local(s.at, origin)
        out[j*2] = vec4(c.x, c.z, f32(sin(s.yaw)), f32(cos(s.yaw)))
        out[j*2+1] = vec4(f32(s.half_length), f32(s.half_beam), f32(s.pace), 0)
    n

# The white water round a ship on the sea at q (render-local), 0..1: a lace band hugging the
# hull, thin at the bow cheeks and widening aft, then the churn of the wake behind the stern.
surf_ship_foam = (q: vec2, p: vec2, t: f32, a: vec4, b: vec4, energy: f32, dist: f32, pix: f32, low: bool = false) -> f32:
    d = q-a.xy
    along = d.x*a.z+d.y*a.w
    across = abs(d.x*a.w-d.y*a.z)
    hl = b.x; hb = b.y
    # (nothing ahead of the stem but its own cushion; the wake runs out astern)
    if along > hl+hb*0.4 or along < -hl*2.6 or across > hb*4.0: return 0.0
    strength = (0.3+0.7*energy)*(0.25+0.75*b.z)
    x = clamp(along/hl, -1.0, 1.0)
    hull = hb*sqrt(max(0.0, 1.0-pow(abs(x), 4.0)))
    aft = smoothstep(1.0, -1.0, x)
    width = hb*(0.35+1.3*aft*aft)+hb*0.8*energy*smoothstep(0.5, 0.95, x)
    out_by = across-hull
    density: f32 = 0.0
    if along > -hl:
        density = (1.0-smoothstep(0.0, width, out_by))*step(-hb*0.05, out_by)*(0.7+0.5*smoothstep(0.4, 1.0, x)+0.3*aft)
    else:
        # (behind the stern: the wake's churn, widening and thinning)
        behind = (-along-hl)/hl
        spread = hb*(1.6+behind*1.0)
        density = (1.0-smoothstep(spread*0.35, spread, across))*exp(-behind*0.8)*1.1
    if density <= 0.0: return 0.0
    # (the lace drifts aft along the hull at the ship's pace)
    flow = vec2(a.z, a.w)*(t*(1.5+4.0*b.z))
    surf_lace(p-flow+vec2(b.x*13.0, b.y*7.0), t, density*strength, dist, pix, low)

# (CPU) the box (render-local x/z min, max) round the white water of the first n ships.
surf_ship_box = (ships: vec4[8], n: int) -> vec4:
    if n == 0: return vec4(0,0,0,0)
    lo = vec2(1e9,1e9); hi = vec2(-1e9,-1e9)
    loop j in 0..n:
        a = ships[j*2]; b = ships[j*2+1]
        r = b.x*2.7+b.y*4.0
        lo = min(lo, a.xy-vec2(r,r)); hi = max(hi, a.xy+vec2(r,r))
    vec4(lo.x,lo.y,hi.x,hi.y)
