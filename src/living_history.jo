# Retain compact memories and live ownership; reclaim old terminal scheduler records.
use 'living_types.jo'
use 'living_delivery.jo'
use 'living_duties.jo'

prune_history = (w: mut World, presentation: mut PresentationState):
    cutoff = w.minute-11520
    pinned_jobs: {int: bool}
    pinned_events: {int: bool}
    pinned_trips: {int: bool}
    pinned_obligations: {int: bool}
    loop p in w.people:
        if p.trip >= 0: pinned_trips[p.trip] = true
    loop c in w.aircraft:
        if c.trip >= 0: pinned_trips[c.trip] = true
        if c.repair_obligation >= 0: pinned_obligations[c.repair_obligation] = true
        loop job in c.job_manifests: pinned_jobs[job] = true
    loop _, a in w.aftermath:
        pinned_events[a.event] = true
        if a.reason.job >= 0: pinned_jobs[a.reason.job] = true
        if a.reason.obligation >= 0: pinned_obligations[a.reason.obligation] = true
    loop f in w.factions:
        if f.bounty_event >= 0: pinned_events[f.bounty_event] = true
    loop _, e in w.encounters:
        if not e.resolved:
            pinned_trips[e.raider_trip] = true; pinned_trips[e.victim_trip] = true
            if e.outcome_event >= 0: pinned_events[e.outcome_event] = true
    loop _, o in w.obligations:
        if obligation_live(o.state) or ((o.kind == .debt or o.kind == .rent) and o.amount_cents > 0):
            if o.job >= 0: pinned_jobs[o.job] = true
            if o.reason.source_event >= 0: pinned_events[o.reason.source_event] = true
    loop _, j in w.jobs:
        if not job_terminal(j.state) or j.id in pinned_jobs:
            if j.obligation >= 0: pinned_obligations[j.obligation] = true
            if j.cause.source_event >= 0: pinned_events[j.cause.source_event] = true
    remove_jobs: int[]
    loop id, j in w.jobs:
        if job_terminal(j.state) and j.status_minute < cutoff and not (id in pinned_jobs): remove_jobs.push(id)
    loop id in remove_jobs: w.jobs.remove(id)
    jobs: int[]
    loop id in w.active_jobs:
        if id in w.jobs: jobs.push(id)
    w.active_jobs = jobs
    remove_trips: int[]
    loop id, t in w.trips:
        if (t.state == .arrived or t.state == .failed) and t.terminal_minute < cutoff and not (id in pinned_trips): remove_trips.push(id)
    loop id in remove_trips: w.trips.remove(id)
    remove_obligations: int[]
    loop id, o in w.obligations:
        terminal = o.state == .fulfilled or o.state == .cancelled or o.state == .breached or o.state == .defaulted
        unpaid = (o.kind == .debt or o.kind == .rent) and o.amount_cents > 0
        if terminal and o.deadline_minute < cutoff and not unpaid and not (id in pinned_obligations): remove_obligations.push(id)
    loop id in remove_obligations: w.obligations.remove(id)
    obligations: int[]
    loop id in w.open_obligations:
        if id in w.obligations: obligations.push(id)
    w.open_obligations = obligations
    loop p in 0..w.people.len():
        ids: int[]
        loop id in w.people[p].obligations:
            if id in w.obligations: ids.push(id)
        w.people[p].obligations = ids
    keys: str[]
    loop key, id in w.obligation_keys:
        if not (id in w.obligations): keys.push(key)
    loop key in keys: w.obligation_keys.remove(key)
    # Supply duties may pin expired jobs. This is deliberate while their need is unresolved.
    events: int[]
    loop id, e in w.events:
        if e.minute < cutoff and not (id in pinned_events): events.push(id)
    loop id in events: w.events.remove(id)
    order: int[]
    loop id in w.event_order:
        if id in w.events: order.push(id)
    w.event_order = order
    encounters: int[]
    loop id, e in w.encounters:
        if e.resolved and e.deadline_tick/120 < cutoff: encounters.push(id)
    loop id in encounters: w.encounters.remove(id)
    # Historical encounter IDs on terminal Trips are non-owning. Live ones must remain resolvable.
    boats: RescueTask[]
    loop r in w.rescues:
        if r.state != 2 or r.dispatch_minute >= cutoff: boats.push(r)
    w.rescues = boats
    ships: OutsideShipment[]
    loop s in w.shipments:
        if s.state == 0 or s.arrival_minute >= cutoff: ships.push(s)
    w.shipments = ships
    bark_keys: BarkKey[]
    loop key, day in presentation.bark_day:
        if day < day_index(w.minute)-2: bark_keys.push(key)
    loop key in bark_keys: presentation.bark_day.remove(key)
    hails: int[]
    loop id, _ in presentation.hailed_jobs:
        if not (id in w.jobs): hails.push(id)
    loop id in hails: presentation.hailed_jobs.remove(id)
