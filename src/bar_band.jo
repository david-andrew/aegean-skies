# The hotel's evening music, live: the procedural orchestra (src/music_synth.jo) playing the
# period repertoire in small line-ups, heard in the open air of the terrace (the facade's
# reflection and a short room, no radio filter), and a singer: a procedural voice (harmonic
# formant synthesis with vowels, legato glides and a late vibrato) singing each tune's melody,
# which the instrument that carried it then plays more softly under her. Nothing recorded.
#
# The set is scheduled on the living world's clock (from 19:00 to half past eleven), so it is
# where it should be after resting or saving, and every listener hears the same bar of it.

use 'music_data.jo'
use 'music_synth.jo'
use 'live_source.jo'
use 'band_request.jo'
use 'life_types.jo'
use 'live_notes.jo'

struct SetPiece:
    piece: int                      # MUSIC_PIECES index
    lineup: int                     # 0 piano alone, 1 dance band, 2 tango trio, 3 island pair, 4 piano and violin, 5 guitar and mandolin, 6 violin and guitar
    lead: int                       # the instrument that carries the melody (MusicInstrument)
    floor: int                      # (the lowest pitch of it that is melody, not accompaniment)
    sung: vec2[]                    # the stretches (seconds) the singer sings
    nights = 1                      # played one evening in so many (1: every evening)
    level = 1.0                     # (the trio's Summer: brought down to the set's loudness)

# The evening's numbers, in order, played round until the band stops: a quiet set for a harbour
# terrace (src/music_data.jo; sources and permissions in data/music/SOURCES.md).
BAR_SET: SetPiece[] = [
    SetPiece(7, 0, 6, 67, []),                  # Satie, Gymnopedie No. 1: the pianist alone
    SetPiece(8, 4, 0, 55, [vec2(14, 268)]),     # Gounod, Ave Maria: the singer takes the violin's line
    SetPiece(9, 0, 6, 72, []),                  # Debussy, Clair de lune: the pianist alone
    SetPiece(10, 5, 8, 52, []),                 # Tarrega, Adelita: guitar and mandolin
    SetPiece(11, 6, 0, 64, []),                 # Faure, Berceuse: violin and guitar
    # Every other evening, Marta brings her accordion: the trio (accordion, the upright, the bass;
    # bar_trio) plays the accordion numbers.
    SetPiece(34, 2, 9, 60, [], 2, 0.65),        # Vivaldi, Summer: the Presto, the solo on the accordion
    SetPiece(3, 2, 9, 60, [], 2),               # Villoldo, El Choclo
    SetPiece(39, 2, 9, 60, [], 2)               # Cottrau, Santa Lucia: the song on the accordion
]

# A trio number (the tango trio's line-up) as the three of them play it: the tune (the score's
# accordion or mandolin) on the accordion, the low line on the bass, every other part on the
# upright. A score with its own bass part keeps it, and its low strings go to the piano's left hand.
bar_trio = (events: MusicEvent[], sp: SetPiece) -> MusicEvent[]:
    if sp.lineup != 2: return events
    has_bass = false
    loop e in events: if e.instrument == 13: has_bass = true
    out: MusicEvent[]
    loop e in events:
        f = e
        if e.instrument == 9 or e.instrument == 8: f.instrument = 9
        else if e.instrument == 13 or (not has_bass and e.pitch < 48): f.instrument = 13
        else if e.instrument != 12: f.instrument = 6
        out.push(f)
    out

const BAR_GAP = 7.0                 # seconds between numbers
const BAR_START = 1140              # 19:00, local minutes
const BAR_END = 1410                # 23:30
const BAR_TICKS_PER_SECOND = 60

struct SetPosition:
    playing = false
    index = 0                       # into BAR_SET
    seconds = 0.0                   # into the piece
    left = 0.0                      # seconds until the next number starts
    request = false                 # (a number someone asked for)

# Where the band is now, from its state in the world (src/band_life.jo: a number starts when its
# players are in their places, not on a timetable).
bar_band_position = (b: BandState, tick: int) -> SetPosition:
    if b.index < 0 or b.index >= BAR_SET.len(): return SetPosition()
    playing = b.start >= 0 and tick >= b.start and tick < b.ends
    seconds = if playing: f64(tick - b.start) / f64(BAR_TICKS_PER_SECOND) else: 0.0
    left = if b.start >= 0: f64(b.ends - tick) / f64(BAR_TICKS_PER_SECOND) + BAR_GAP else: 0.0
    SetPosition(playing, b.index, seconds, left, b.request)

bar_singing = (p: SetPosition) -> bool:
    if not p.playing: return false
    loop w in BAR_SET[p.index].sung:
        if p.seconds >= f64(w.x) and p.seconds < f64(w.y): return true
    false

# ---------------- the singer ----------------

struct SungNote:
    start: int                      # frames at MUSIC_RATE
    end: int
    pitch: f64                      # MIDI
    vowel: int

struct Singer:
    notes: SungNote[]
    next = 0
    cursor = 0
    phase = 0.0
    pitch = 60.0                    # the sung pitch now (MIDI), gliding
    env = 0.0
    vib = 0.0
    note_start = -100000
    current = -1
    f1 = 800.0
    f2 = 1200.0
    f3 = 2800.0
    amps: f64[]
    harmonics = 0
    rng: u64 = 99
    jitter = 0.0
    breath = 0.0
    sine: f64[]

# the vowels she sings on (women's formants, Hz): ah, oh, eh, ah, oo-ish, ah
VOWELS: vec3[] = [vec3(830, 1250, 2850), vec3(560, 950, 2700), vec3(620, 1750, 2800), vec3(780, 1150, 2800), vec3(450, 900, 2650), vec3(760, 1300, 2900)]

# The tune's line: of the lead instrument's notes above its floor, the highest at each onset,
# held until the next; folded into a comfortable mezzo range. Sung stretches only.
singer_line = (events: MusicEvent[], sp: SetPiece) -> SungNote[]:
    lead: MusicEvent[]
    loop e in events:
        if e.instrument == sp.lead and e.pitch >= sp.floor:
            seconds = f64(e.start) / f64(MUSIC_RATE)
            inside = false
            loop w in sp.sung:
                if seconds >= f64(w.x) and seconds < f64(w.y): inside = true
            if inside: lead.push(e)
    lead.sort((e: MusicEvent): (e.start, -e.pitch))
    picked: MusicEvent[]
    loop e in lead:
        if picked.len() > 0 and e.start - picked[picked.len() - 1].start < MUSIC_RATE / 40:
            continue
        picked.push(e)
    if picked.len() == 0: return []
    total = 0.0
    loop e in picked: total += f64(e.pitch)
    shift = 12.0 * round((67.0 - total / f64(picked.len())) / 12.0)
    raw: SungNote[]
    loop k in 0..picked.len():
        e = picked[k]
        p = f64(e.pitch) + shift
        loop p > 79.0: p -= 12.0
        loop p < 55.0: p += 12.0
        end = e.start + max(e.duration, MUSIC_RATE / 10)
        if k + 1 < picked.len(): end = min(end, picked[k + 1].start)
        # (a rest shorter than a breath is sung through)
        if k + 1 < picked.len() and picked[k + 1].start - end < MUSIC_RATE / 6: end = picked[k + 1].start
        raw.push(SungNote(e.start, end, p, 0))
    # A voice doesn't sing every ornament an accordion or a bouzouki plays: a quick note is folded
    # into the longer one it decorates, and the syllables change on the notes that remain.
    out: SungNote[]
    shortest = MUSIC_RATE * 18 / 100
    loop n in raw:
        if out.len() > 0:
            last = out[out.len() - 1]
            joined = n.start - last.end < MUSIC_RATE / 20
            if joined and n.end - n.start < shortest:
                out[out.len() - 1].end = n.end
                continue
            if joined and last.end - last.start < shortest:
                out[out.len() - 1] = SungNote(last.start, n.end, n.pitch, last.vowel)
                continue
        out.push(SungNote(n.start, n.end, n.pitch, out.len() % VOWELS.len()))
    out

make_singer = (notes: SungNote[]) -> Singer:
    s = Singer(notes = notes)
    s.sine = [loop i in 0..1024: sin(TAU * f64(i) / 1024.0)]
    s.amps = fill(0.0, 48)
    s

singer_seek = (s: mut Singer, frame: int):
    s.cursor = frame; s.next = 0; s.current = -1; s.env = 0.0
    loop s.next < s.notes.len() and s.notes[s.next].end <= frame: s.next += 1

_formant = (f: f64, centre: f64, width: f64) -> f64:
    d = (f - centre) / (width * 0.5)
    1.0 / (1.0 + d * d)

_singer_spectrum = (s: mut Singer, hz: f64):
    s.harmonics = clamp(int(5200.0 / max(hz, 60.0)), 1, s.amps.len())
    # (high notes: the first formant rises with the voice, as singers open the vowel)
    f1 = max(s.f1, hz * 1.08)
    loop k in 0..s.harmonics:
        f = hz * f64(k + 1)
        g = 1.0 * _formant(f, f1, 120.0) + 0.55 * _formant(f, s.f2, 140.0) + 0.22 * _formant(f, s.f3, 200.0) + 0.07 * _formant(f, 3900.0, 280.0) + 0.004
        # (the source falls away with frequency, and softly above four kilohertz)
        s.amps[k] = g / pow(f64(k + 1), 0.95) / (1.0 + pow(f / 4200.0, 4.0))

singer_render = (s: mut Singer, count: int) -> f64[]:
    out = fill(0.0, count)
    rate = f64(MUSIC_RATE)
    glide = 1.0 - exp(-1.0 / (0.045 * rate))
    attack = 1.0 - exp(-1.0 / (0.05 * rate))
    release = 1.0 - exp(-1.0 / (0.11 * rate))
    vowel_step = 1.0 - exp(-1.0 / (0.06 * rate))
    loop i in 0..count:
        frame = s.cursor + i
        loop s.next < s.notes.len() and s.notes[s.next].start <= frame:
            s.current = s.next
            # (from silence she starts on the note; between notes she glides)
            if s.env < 0.05: s.pitch = s.notes[s.next].pitch
            s.note_start = frame
            s.next += 1
        on = s.current >= 0 and frame < s.notes[s.current].end
        target = if s.current >= 0: s.notes[s.current].pitch else: s.pitch
        s.pitch += (target - s.pitch) * glide
        age = f64(frame - s.note_start) / rate
        # a soft consonant at each new syllable: a dip in level and in the first formant
        consonant = if on and age < 0.05: 0.55 + 0.45 * age / 0.05 else: 1.0
        s.env += ((if on: 1.0 else: 0.0) * consonant - s.env) * (if on: attack else: release)
        if s.env < 0.0005 and not on: continue
        if s.current >= 0:
            v = VOWELS[s.notes[s.current].vowel]
            s.f1 += (f64(v.x) * (if age < 0.05: 0.7 else: 1.0) - s.f1) * vowel_step
            s.f2 += (f64(v.y) - s.f2) * vowel_step
            s.f3 += (f64(v.z) - s.f3) * vowel_step
        # a late vibrato, and the small unsteadiness of a real voice
        depth = 0.32 * clamp((age - 0.22) / 0.4, 0.0, 1.0)
        s.vib += (5.3 + 0.4 * sin(f64(frame) / rate * 0.7)) / rate
        s.rng = (s.rng * u64(6364136223846793005) + u64(1442695040888963407))
        noise = f64((s.rng >> 33) & u64(0xffff)) / 32768.0 - 1.0
        s.jitter += (noise * 0.06 - s.jitter) * 0.002
        hz = 440.0 * pow(2.0, (s.pitch + depth * sin(TAU * s.vib) + s.jitter - 69.0) / 12.0)
        if i % 32 == 0: _singer_spectrum(s, hz)
        s.phase += hz / rate
        s.phase -= floor(s.phase)
        sum = 0.0
        loop k in 0..s.harmonics:
            p = s.phase * f64(k + 1)
            j = int((p - floor(p)) * 1024.0) % 1024
            sum += s.amps[k] * s.sine[j]
        s.breath += (noise - s.breath) * 0.35
        out[i] = (sum * 0.62 + s.breath * 0.02) * s.env
    s.cursor += count
    out

# ---------------- the stream, placed in the world ----------------
# The band and singer make a dry mono signal; src/live_source.jo places it (direction, distance,
# walls, the listener's surroundings) and the stream is stereo.

struct BarMusic:
    synth: MusicSynth = MusicSynth()
    singer: Singer = Singer()
    space: LiveSpatial = LiveSpatial()
    hearing: LiveHearing = LiveHearing()
    ready = false
    index = -1                      # the set piece loaded
    voice = -1
    volume = 1.0
    rendered = 0                    # frames into the piece the stream has reached

# Load a number from the set, its melody notes softened under the singer.
bar_music_load = (m: mut BarMusic, index: int, seconds: f64):
    if not m.ready:
        m.synth = make_music_synth(); m.space = make_live_spatial(); m.ready = true
    sp = BAR_SET[index]
    m.synth.piece = -1
    # (the bar's piano is its upright, whatever the number)
    music_set_piano(m.synth, true)
    music_load(m.synth, sp.piece)
    m.synth.events = bar_trio(m.synth.events, sp)
    m.synth.gain = MUSIC_PIECES[sp.piece].level * sp.level
    m.synth.wet = 0.05
    notes = singer_line(m.synth.events, sp)
    starts: {int: bool}
    loop n in notes: starts[n.start] = true
    loop k in 0..m.synth.events.len():
        e = m.synth.events[k]
        if e.instrument == sp.lead and e.start in starts:
            m.synth.events[k].mix_gain = 0.5; m.synth.events[k].mix_end_gain = 0.5
    m.singer = make_singer(notes)
    m.index = index
    music_seek(m.synth, seconds)
    singer_seek(m.singer, m.synth.cursor)
    m.rendered = m.synth.cursor

# The band and the singer as heard from where the listener is: `count` stereo frames.
bar_music_dry = (m: mut BarMusic, count: int) -> f64[]:
    band = music_render(m.synth, count)
    voice = singer_render(m.singer, band.len())
    m.rendered += band.len()
    [loop i in 0..band.len(): band[i] * 3.0 + voice[i] * 1.5]

bar_music_render = (m: mut BarMusic, count: int) -> f32[]: live_process(m.space, m.hearing, bar_music_dry(m, count))

bar_music_stop = (m: mut BarMusic):
    if m.voice >= 0: stop(m.voice)
    m.voice = -1

# Each frame: keep a little queued (a tenth of a second, so turning is heard at once) while the
# band plays and the listener is within reach.
bar_music_update = (m: mut BarMusic, p: SetPosition, hearing: LiveHearing, audio: bool):
    m.hearing = hearing
    if not audio or not p.playing or hearing.distance > 150.0:
        bar_music_stop(m)
        if not p.playing: m.index = -1
        return
    want = int(p.seconds * f64(MUSIC_RATE))
    if m.index != p.index or m.voice < 0 or abs(m.rendered - want) > MUSIC_RATE * 2:
        bar_music_stop(m)
        bar_music_load(m, p.index, p.seconds)
        m.voice = sound_stream(MUSIC_RATE, 2, m.volume)
    queued = queued_samples(m.voice)
    need = clamp(MUSIC_RATE / 9 - queued, 0, 800)
    left = m.synth.frames - m.synth.cursor
    need = min(need, left)
    if need > 0: push_samples(m.voice, bar_music_render(m, need))

# ---------------- what the band plays, note by note ----------------
# The band's note feed (src/live_notes.jo): loaded with the number's note events when it starts,
# and the singer's line as a part of its own; stepped to the frame being heard: the stream's
# position while it plays (what was pushed less what still waits), the schedule's when silent.

const SINGER_PART = 14              # (the singer's line in a feed: the choir's instrument number)

struct BandFeed:
    feed: LiveNoteFeed = LiveNoteFeed()
    piece = -1                      # (what it is loaded with: a catalogue piece,
    index = -1                      # and the set's number, -1 for none)
    frame = -1                      # the frame being heard (-1: the band isn't playing)
    heard = false                   # (from the stream)
    ready: LiveNoteFeed[]           # (each number of the set, loaded ahead: bar_feed_warm)

# A piece's events with the singer's line added (for a number of the set that has one).
bar_note_events = (piece: int, index: int) -> MusicEvent[]:
    s = MusicSynth()
    music_load(s, piece)
    events = if index >= 0: bar_trio(s.events, BAR_SET[index]) else: s.events
    if index >= 0:
        loop n in singer_line(events, BAR_SET[index]):
            events.push(MusicEvent(n.start, max(n.end - n.start, 1), int(round(n.pitch)), SINGER_PART, 0.6, 0.6))
    events

_bar_feed_load = (b: mut BandFeed, piece: int, index: int):
    if b.piece == piece and b.index == index: return
    if index >= 0 and index < b.ready.len():
        b.feed = b.ready[index]; b.feed.next = 0; b.feed.frame = -1
    else: live_notes_load(b.feed, bar_note_events(piece, index), if index >= 0: BAR_SET[index].lead else: -1)
    b.piece = piece; b.index = index

# Every number of the set loaded ahead (at the start), so a number starting costs nothing.
bar_feed_warm = (b: mut BandFeed):
    b.ready = []
    loop k in 0..BAR_SET.len():
        f = LiveNoteFeed()
        live_notes_load(f, bar_note_events(BAR_SET[k].piece, k), BAR_SET[k].lead)
        b.ready.push(f)

# The key a feed's contents go by (for a Performance's motions).
bar_feed_key = (piece: int, index: int) -> str: "{piece}/{index}"

# Step the band's feed to now: the notes that started since the last step.
bar_note_feed = (b: mut BandFeed, m: BarMusic, p: SetPosition) -> LiveNote[]:
    if not p.playing:
        b.frame = -1; b.heard = false
        return []
    _bar_feed_load(b, BAR_SET[p.index].piece, p.index)
    b.heard = m.voice >= 0 and m.index == p.index
    b.frame = if b.heard: live_notes_heard_frame(m.rendered, queued_samples(m.voice)) else: live_notes_clock_frame(p.seconds)
    live_notes_step(b.feed, b.frame)

# (captures: any catalogue piece, from a given second, as if the band played it)
bar_note_feed_forced = (b: mut BandFeed, piece: int, seconds: f64) -> LiveNote[]:
    index = -1
    loop k in 0..BAR_SET.len():
        if BAR_SET[k].piece == piece: index = k
    _bar_feed_load(b, piece, index)
    b.heard = false
    b.frame = live_notes_clock_frame(seconds)
    live_notes_step(b.feed, b.frame)

# Whether the singer sings at a point of a piece (captures; the set's own windows).
bar_piece_sung = (piece: int, seconds: f64) -> bool:
    loop sp in BAR_SET:
        if sp.piece == piece:
            loop w in sp.sung:
                if seconds >= f64(w.x) and seconds < f64(w.y): return true
    false
