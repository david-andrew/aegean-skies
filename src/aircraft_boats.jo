# The big flying boats: the Savoia-Marchetti S.55 (twin hulls), the Dornier Wal and Do X (sponsons,
# push-pull pairs above the wing), the Short Sarafand (a biplane, three push-pull pairs between
# the wings) and the Hughes H-4 (eight radials on the leading edge, tip
# floats). Built like the other aircraft (flat-shaded parts in the seven damage bins), from lofted
# rings: hulls with flared chines and a step, thick aerofoil wings, nacelles. Craft frame as in
# planes.jo: forward -z, right +x, up +y, metres, the origin near the centre of gravity.
use 'planes.jo'
use 'aircraft_catalog.jo'
use 'cockpit_cutout.jo'
use 'cockpit_cabins.jo'

# ---------------- which aircraft ----------------

big_boat = (kind: Craft) -> bool: kind == .sm_s55 or kind == .dornier_wal or kind == .dornier_dox or kind == .hughes_h4 or kind == .short_sarafand

# Too big for a harbour's seaplane docks (they are 13 m apart along a quay): moored on a buoy
# offshore, reached by the harbour launch (src/offshore_moorings.jo).
offshore_only = (kind: Craft) -> bool: aircraft_profile(kind).span > 30.0

# The room a moored aircraft needs: it swings round its buoy with the wind, so a circle round the
# buoy holding the whole aircraft at any heading, plus the bow line (metres).
swing_radius = (kind: Craft) -> f64:
    p = aircraft_profile(kind)
    reach = sqrt(p.span * p.span * 0.25 + p.length * p.length * 0.36)
    reach + p.length * 0.25 + 6.0

# ---------------- primitives ----------------

_bt = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a) + vec3(0, 0.000001, 0))
    vs.push(Vertex3D(a, n, vec2(0, 0), col))
    vs.push(Vertex3D(b, n, vec2(0, 0), col))
    vs.push(Vertex3D(c, n, vec2(0, 0), col))

# a quad facing away from `inside` (flat-shaded, wound outward whichever way it was given)
_bq = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, col: vec4, inside: vec3):
    n = cross(b - a, c - a)
    mid = (a + b + c + d) * 0.25
    if dot(n, mid - inside) >= 0:
        _bt(vs, a, b, c, col); _bt(vs, a, c, d, col)
    else:
        _bt(vs, a, c, b, col); _bt(vs, a, d, c, col)

_bbox = (vs: mut Vertex3D[], c: vec3, h: vec3, col: vec4, m: mat4 = mat4()):
    add_box(vs, c, h * 2.0, col, m)

_bstrut = (vs: mut Vertex3D[], a: vec3, b: vec3, r: f64, col: vec4):
    d = b - a
    len = f64(length(d))
    if len < 0.01: return
    add_box(vs, vec3(0, 0, 0), vec3(f32(r * 2.0), f32(r * 2.0), f32(len)), col, translation((a + b) * 0.5) * facing(d))

_centroid = (ring: vec3[]) -> vec3:
    c = vec3(0, 0, 0)
    loop p in ring: c += p
    c / f32(ring.len())

# Rings lofted into a closed body. Faces whose centre lies below `boot` take the bottom paint;
# `tip` from that ring on (and its cap) take the tip paint. Both ends capped.
_rloft = (vs: mut Vertex3D[], rings: vec3[][], col: vec4, under: vec4, boot: f64 = -1e9, tip_col: vec4 = vec4(0, 0, 0, 0), tip_from: int = 1000000, cap_start: bool = true, cap_end: bool = true):
    loop k in 0..rings.len() - 1:
        a = rings[k]; b = rings[k + 1]
        inside = (_centroid(a) + _centroid(b)) * 0.5
        c = if k >= tip_from: tip_col else: col
        loop i in 0..a.len():
            j = (i + 1) % a.len()
            mid = (a[i] + a[j] + b[i] + b[j]) * 0.25
            _bq(vs, a[i], b[i], b[j], a[j], if f64(mid.y) < boot: under else: c, inside)
    loop e in [0, rings.len() - 1]:
        if (e == 0 and not cap_start) or (e > 0 and not cap_end): continue
        r = rings[e]
        centre = _centroid(r)
        other = _centroid(rings[if e == 0: 1 else: rings.len() - 2])
        c = if e >= tip_from: tip_col else: col
        loop i in 0..r.len():
            j = (i + 1) % r.len()
            n = cross(r[i] - centre, r[j] - centre)
            colour = if f64(((r[i] + r[j] + centre) / 3.0).y) < boot: under else: c
            if dot(n, centre - other) >= 0: _bt(vs, centre, r[i], r[j], colour)
            else: _bt(vs, centre, r[j], r[i], colour)

# A flying-boat hull section at z: half beam w (at the chines, flared a little wider), deck height
# top, chine height ch, keel depth k; cx is the hull's centreline (twin hulls).
_hull_ring = (z: f64, w: f64, top: f64, ch: f64, k: f64, cx: f64 = 0.0) -> vec3[]:
    out: vec3[]
    loop side in [1.0, -1.0]:
        pts = [vec3(cx + side * w * 0.6, top, z), vec3(cx + side * w * 0.96, top - (top - ch) * 0.28, z),
            vec3(cx + side * w * 1.04, ch, z), vec3(cx + side * w * 0.52, ch + (k - ch) * 0.62, z)]
        if side > 0:
            out.push(vec3(cx, top + w * 0.1, z))
            out.extend(pts)
            out.push(vec3(cx, k, z))
        else:
            loop i in 0..4: out.push(pts[3 - i])
    out

# An aerofoil section at a span station: leading edge at (x, y, le), chord c, thickness t.
_aero_ring = (x: f64, y: f64, le: f64, c: f64, t: f64) -> vec3[]:
    [vec3(x, y, le), vec3(x, y + t * 0.55, le + c * 0.22), vec3(x, y + t * 0.36, le + c * 0.62), vec3(x, y + t * 0.04, le + c),
     vec3(x, y - t * 0.2, le + c * 0.62), vec3(x, y - t * 0.42, le + c * 0.2)]

struct WingStation:
    x: f64                          # half span position, from the root out
    y: f64                          # height of the chord line
    le: f64                         # leading edge z
    chord: f64
    thick: f64

# A wing of both halves from root to tip stations; the outermost panel painted as a tip.
_aero_wing = (vs: mut Vertex3D[], st: WingStation[], col: vec4, tip: vec4, tip_panels: int = 1):
    loop side in [-1.0, 1.0]:
        rings = [loop s in st: _aero_ring(side * s.x, s.y, s.le, s.chord, s.thick)]
        _rloft(vs, rings, col, col, -1e9, tip, st.len() - 1 - tip_panels, cap_start = false)

# a round nacelle along z from z0 (front) to z1, radius r, with rounded ends; 8 sides
_nacelle = (vs: mut Vertex3D[], c: vec3, z0: f64, z1: f64, r: f64, col: vec4, nose: f64 = 0.55, tail: f64 = 0.35):
    ring = (z: f64, k: f64) -> vec3[]: [loop i in 0..8: c + vec3(f32(cos(f64(i) * TAU / 8.0) * r * k), f32(sin(f64(i) * TAU / 8.0) * r * k), f32(z))]
    l = z1 - z0
    _rloft(vs, [ring(z0, nose), ring(z0 + l * 0.12, 0.92), ring(z0 + l * 0.3, 1.0), ring(z1 - l * 0.3, 1.0), ring(z1 - l * 0.1, 0.75), ring(z1, tail)], col, col)

# a radial engine at c facing -z (or +z, a pusher): crankcase drum, nine cylinders, a nose
_radial = (vs: mut Vertex3D[], c: vec3, r: f64, back: bool, metal: vec4, dark: vec4):
    s = if back: 1.0 else: -1.0
    add_cylinder(vs, vec3(0, f32(-0.3 * r), 0), r * 0.48, 0.6 * r, dark, 10, r * 0.48, translation(c) * rotation_x(PI / 2))
    loop i in 0..9:
        a = f64(i) * TAU / 9.0
        dir = vec3(f32(cos(a)), f32(sin(a)), 0)
        add_box(vs, vec3(0, 0, 0), vec3(f32(r * 0.24), f32(r * 0.24), f32(r * 0.34)), metal, translation(c + dir * f32(r * 0.74)) * rotation_z(a))
    add_cylinder(vs, vec3(0, 0, 0), r * 0.3, 0.35 * r, metal, 8, r * 0.16, translation(c + vec3(0, 0, f32(s * r * 0.25))) * rotation_x(if back: PI / 2 else: -PI / 2))

_spin = (vs: mut Vertex3D[], c: vec3, r: f64, col: vec4, back: bool):
    add_cylinder(vs, vec3(0, 0, 0), r, r * 1.7, col, 8, 0.0, translation(c) * rotation_x(if back: PI / 2 else: -PI / 2))

# a fin from its root (x, y0, z0..z1) up to the tip at y1 (chord shrinking by k, swept back by
# sweep), thick t; the rudder (the aft quarter) in the accent paint
_fin = (vs: mut Vertex3D[], x: f64, y0: f64, y1: f64, z0: f64, z1: f64, k: f64, sweep: f64, t: f64, col: vec4, rudder: vec4):
    c0 = z1 - z0; c1 = c0 * k
    split = 0.72
    root = (z: f64, w: f64) -> vec3[]: [vec3(x, y0, z), vec3(x + w, y0, z + c0 * 0.3), vec3(x + w * 0.4, y0, z + c0 * split), vec3(x - w * 0.4, y0, z + c0 * split), vec3(x - w, y0, z + c0 * 0.3)]
    tipr = (z: f64, w: f64) -> vec3[]: [vec3(x, y1, z), vec3(x + w, y1, z + c1 * 0.3), vec3(x + w * 0.4, y1, z + c1 * split), vec3(x - w * 0.4, y1, z + c1 * split), vec3(x - w, y1, z + c1 * 0.3)]
    _rloft(vs, [root(z0, t), tipr(z0 + sweep, t * 0.6)], col, col)
    # the rudder behind the fin's hinge line
    h0 = z0 + c0 * split; h1 = z0 + sweep + c1 * split
    rr0 = [vec3(x, y0, h0), vec3(x + t * 0.4, y0, h0), vec3(x, y0, z1), vec3(x - t * 0.4, y0, h0)]
    rr1 = [vec3(x, y1, h1), vec3(x + t * 0.25, y1, h1), vec3(x, y1, z0 + sweep + c1), vec3(x - t * 0.25, y1, h1)]
    _rloft(vs, [rr0, rr1], rudder, rudder)

# a float or a sponson-like body along z: pointed bow, a step, a tapering stern
_bfloat = (vs: mut Vertex3D[], c: vec3, len: f64, w: f64, col: vec4, under: vec4):
    l = len; h = w
    _rloft(vs, [_hull_ring(f64(c.z) - l * 0.5, w * 0.2, f64(c.y) + h * 0.3, f64(c.y) - h * 0.05, f64(c.y) - h * 0.15, f64(c.x)),
        _hull_ring(f64(c.z) - l * 0.36, w * 0.85, f64(c.y) + h * 0.6, f64(c.y) - h * 0.4, f64(c.y) - h * 0.75, f64(c.x)),
        _hull_ring(f64(c.z) + l * 0.04, w, f64(c.y) + h * 0.65, f64(c.y) - h * 0.45, f64(c.y) - h * 0.85, f64(c.x)),
        _hull_ring(f64(c.z) + l * 0.06, w * 0.95, f64(c.y) + h * 0.6, f64(c.y) - h * 0.3, f64(c.y) - h * 0.45, f64(c.x)),
        _hull_ring(f64(c.z) + l * 0.5, w * 0.25, f64(c.y) + h * 0.4, f64(c.y) + h * 0.05, f64(c.y), f64(c.x))], col, under, f64(c.y) - h * 0.32)

# dark window panes along both sides of a hull on centreline cx (x: the sides' half beam there)
_windows = (vs: mut Vertex3D[], x: f64, y: f64, z0: f64, z1: f64, n: int, h: f64, w: f64, col: vec4, cx: f64 = 0.0):
    loop i in 0..n:
        z = z0 + (z1 - z0) * (f64(i) + 0.5) / f64(n)
        loop side in [-1.0, 1.0]:
            _bbox(vs, vec3(f32(cx + side * x), f32(y), f32(z)), vec3(0.03, f32(h * 0.5), f32(w * 0.5)), col)

# an open cockpit: a dark well, a coaming and a windscreen
_open_cockpit = (vs: mut Vertex3D[], c: vec3, w: f64, trim: vec4):
    _bbox(vs, c, vec3(f32(w * 0.5), 0.03, 0.45), rgb(0.12, 0.11, 0.1))
    loop side in [-1.0, 1.0]: _bstrut(vs, c + vec3(f32(side * w * 0.52), 0.04, -0.46), c + vec3(f32(side * w * 0.52), 0.04, 0.46), 0.04, trim)
    _bbox(vs, c + vec3(0, 0.13, -0.47), vec3(f32(w * 0.46), 0.13, 0.02), rgb(0.63, 0.79, 0.83))

# Operator bars on the upper wing (the game's civilian marking), clear of the walkways.
_bars = (vs: mut Vertex3D[], c: vec3, len: f64, col: vec4):
    loop dz in [-0.35, 0.35]: _bbox(vs, c + vec3(0, 0, f32(dz)), vec3(f32(len), 0.02, 0.12), col)

# Every triangle assigned to its bin by where it is: wings by side.
_split_wing = (bins: mut Vertex3D[][], vs: Vertex3D[]):
    loop tri in 0..vs.len() / 3:
        i = tri * 3
        id = if vs[i].pos.x + vs[i + 1].pos.x + vs[i + 2].pos.x < 0: 2 else: 3
        bins[id].extend(vs[i..i + 3])

# A propeller of either hand (hand -1: a pusher's mirror-handed blades), wooden with painted tips,
# or metal (the H-4's, 1947).
_boat_prop = (radius: f64, blades: int, hand: f64, metal: bool) -> Mesh:
    vs: Vertex3D[]
    blade = if metal: rgb(0.55, 0.56, 0.55) else: rgb(0.45, 0.28, 0.16)
    tip = if metal: rgb(0.85, 0.75, 0.25) else: rgb(0.85, 0.8, 0.6)
    loop b in 0..blades:
        m = rotation_z(f64(b) / f64(blades) * TAU) * rotation_y(0.35 * hand)
        _bbox(vs, vec3(0, f32(radius * 0.46), 0), vec3(0.09, f32(radius * 0.44), 0.03), blade, m)
        _bbox(vs, vec3(0, f32(radius * 0.92), 0), vec3(0.095, f32(radius * 0.08), 0.032), tip, m)
    custom_mesh(vs)

# ---------------- the four aircraft ----------------

struct BoatShape:
    hubs: vec3[]                    # propeller hubs, front to back, pairs together
    back: bool[]                    # which hubs push
    contacts: vec3[]
    seats: vec3[]
    exit: vec3
    shade: vec3[]
    blades: int

# A push-pull pair: one nacelle with an engine at each end, the front one pulling, the rear one
# pushing; radial (exposed Jupiters, the Do X) or cowled inline (V-12s with a radiator under,
# the Sarafand). Adds both hubs, front first. Shared by every tandem-engined boat.
_tandem_pair = (vs: mut Vertex3D[], sh: mut BoatShape, c: vec3, z0: f64, z1: f64, r: f64, radial: bool, lv: Livery, metal: vec4, dark: vec4):
    if radial:
        _nacelle(vs, c, z0 + 0.05, z1 - 0.05, r * 0.8, lv.trim, 0.7, 0.7)
        _radial(vs, c + vec3(0, 0, f32(z0)), r, false, metal, dark)
        _radial(vs, c + vec3(0, 0, f32(z1)), r, true, metal, dark)
    else:
        _nacelle(vs, c, z0 - 0.2, z1 + 0.2, r, lv.trim, 0.5, 0.45)
        _bbox(vs, c + vec3(0, f32(-r * 1.05), f32((z0 + z1) * 0.5)), vec3(f32(r * 0.55), f32(r * 0.35), f32((z1 - z0) * 0.2)), dark)
        loop j in 0..5:
            z = z0 + (z1 - z0) * (0.15 + f64(j) * 0.17)
            loop side in [-1.0, 1.0]: _bstrut(vs, c + vec3(f32(side * r * 0.85), f32(r * 0.45), f32(z)), c + vec3(f32(side * r * 1.0), f32(r * 0.8), f32(z)), 0.03, dark)
    _spin(vs, c + vec3(0, 0, f32(z0 - 0.45)), r * 0.28, lv.accent, false)
    _spin(vs, c + vec3(0, 0, f32(z1 + 0.45)), r * 0.28, lv.accent, true)
    sh.hubs.push(c + vec3(0, 0, f32(z0 - 0.65))); sh.back.push(false)
    sh.hubs.push(c + vec3(0, 0, f32(z1 + 0.65))); sh.back.push(true)

_build_s55 = (bins: mut Vertex3D[][], lv: Livery, metal: vec4, dark: vec4) -> BoatShape:
    sh = BoatShape(blades = 2)
    hx = 3.05
    # Two hulls under the wing, each with a step under the wing's trailing edge, carrying
    # passengers; the crew sit in the wing's thick centre section.
    loop side in [-1.0, 1.0]:
        x = side * hx
        id = if side < 0: 4 else: 5
        rings = [_hull_ring(-7.4, 0.18, 0.15, -0.1, -0.25, x), _hull_ring(-6.8, 0.55, 0.55, -0.45, -0.7, x),
            _hull_ring(-5.4, 0.76, 0.8, -0.62, -0.95, x), _hull_ring(-1.0, 0.8, 0.9, -0.66, -1.0, x),
            _hull_ring(1.2, 0.8, 0.9, -0.66, -1.0, x), _hull_ring(1.25, 0.76, 0.9, -0.48, -0.66, x),
            _hull_ring(3.6, 0.58, 0.88, -0.3, -0.45, x), _hull_ring(5.4, 0.22, 0.8, 0.2, 0.05, x)]
        _rloft(bins[id], rings, lv.body, lv.trim, -0.15)
        _windows(bins[id], 0.81, 0.25, -4.6, 0.4, 5, 0.32, 0.42, rgb(0.17, 0.22, 0.26), x)
        # struts from the hull's deck up into the wing
        loop z in [-2.6, 0.6]:
            _bstrut(bins[id], vec3(f32(x + side * 0.4), 0.85, f32(z)), vec3(f32(side * 6.6), 1.55, f32(z + 0.4)), 0.06, metal)
            _bstrut(bins[id], vec3(f32(x), 0.85, f32(z)), vec3(f32(x), 1.45, f32(z)), 0.12, lv.body)
        loop z in [-4.6, 0.8]: sh.contacts.push(vec3(f32(x), -1.0, f32(z)))
        loop dx in [-0.45, 0.45]:
            loop z in [-3.8, 0.8]: sh.contacts.push(vec3(f32(x + dx), -0.78, f32(z)))
        sh.contacts.push(vec3(f32(x), -0.45, 3.9))
        sh.shade.push(vec3(f32(x), -0.2, -1.0)); sh.shade.push(vec3(0.8, 0.8, 6.4))
    # The thick wing: a constant-chord centre section between the hulls, tapering outer panels.
    wing: Vertex3D[]
    _aero_wing(wing, [WingStation(0, 1.85, -3.4, 5.0, 1.0), WingStation(3.05, 1.85, -3.4, 5.0, 1.0), WingStation(7.5, 2.0, -3.1, 4.0, 0.62),
        WingStation(11.4, 2.15, -2.75, 2.9, 0.34), WingStation(12.0, 2.17, -2.45, 2.1, 0.2)], lv.wing, lv.accent)
    # (the centre section, between the hulls, is the body's: the crew's room)
    loop tri in 0..wing.len() / 3:
        i = tri * 3
        cx = (wing[i].pos.x + wing[i + 1].pos.x + wing[i + 2].pos.x) / 3.0
        if abs(f64(cx)) < 3.05: bins[0].extend(wing[i..i + 3])
        else: bins[if cx < 0: 2 else: 3].extend(wing[i..i + 3])
    loop side in [-1.0, 1.0]: _bars(bins[if side < 0: 2 else: 3], vec3(f32(side * 8.6), 2.32, -1.6), 1.4, lv.accent)
    sh.shade.push(vec3(0, 1.9, -0.9)); sh.shade.push(vec3(12.0, 0.1, 2.4))
    # Two open cockpits side by side in the leading edge, the observer's hatch behind.
    loop side in [-1.0, 1.0]:
        c = vec3(f32(side * 0.62), 2.36, -2.55)
        _open_cockpit(bins[0], c, 0.62, lv.trim)
        sh.seats.push(c + vec3(0, 0.38, 0))
    # The engines, back to back in one nacelle on struts above the centre section, a radiator
    # under each; the front one pulls, the rear one pushes.
    ey = 4.05
    _nacelle(bins[1], vec3(0, f32(ey), 0), -3.65, 1.75, 0.62, lv.trim, 0.45, 0.4)
    _bbox(bins[1], vec3(0, f32(ey - 0.78), -2.4), vec3(0.42, 0.22, 0.4), dark)
    _bbox(bins[1], vec3(0, f32(ey - 0.78), 0.6), vec3(0.42, 0.22, 0.4), dark)
    loop j in 0..6:
        loop side in [-1.0, 1.0]: _bstrut(bins[1], vec3(f32(side * 0.56), f32(ey + 0.25), f32(-2.9 + f64(j) * 0.8)), vec3(f32(side * 0.66), f32(ey + 0.5), f32(-2.9 + f64(j) * 0.8)), 0.03, dark)
    # (the front pair stands aft of the pilots' cockpit and outboard of it, clear of their view)
    loop z in [-1.2, 0.7]:
        loop side in [-1.0, 1.0]:
            _bstrut(bins[1], vec3(f32(side * 0.3), f32(ey - 0.5), f32(z)), vec3(f32(side * (if z < 0.0: 1.35 else: 0.9)), 2.33, f32(z - 0.3)), 0.06, metal)
            _bstrut(bins[1], vec3(f32(side * 0.3), f32(ey - 0.5), f32(z)), vec3(f32(side * 2.4), 2.25, f32(z + 0.2)), 0.045, metal)
    _spin(bins[1], vec3(0, f32(ey), -3.75), 0.2, lv.accent, false)
    _spin(bins[1], vec3(0, f32(ey), 1.85), 0.18, lv.accent, true)
    sh.hubs = [vec3(0, f32(ey), -3.95), vec3(0, f32(ey), 2.05)]
    sh.back = [false, true]
    # Twin booms per side, from the wing and the hull's stern, meet at the tailplane, which carries
    # three fins and rudders.
    loop side in [-1.0, 1.0]:
        x = side * hx
        _bstrut(bins[6], vec3(f32(x), 2.05, 1.5), vec3(f32(side * 2.7), 2.55, 8.0), 0.1, lv.body)
        _bstrut(bins[6], vec3(f32(x), 0.7, 5.2), vec3(f32(side * 2.7), 2.4, 8.2), 0.09, lv.body)
        _bstrut(bins[6], vec3(f32(x), 2.15, 4.6), vec3(f32(x), 1.0, 4.6), 0.05, metal)
        _bstrut(bins[6], vec3(f32(x), 2.15, 4.6), vec3(f32(side * 2.9), 1.15, 6.6), 0.04, metal)
    _bstrut(bins[6], vec3(-3.0, 2.1, 4.6), vec3(3.0, 2.1, 4.6), 0.05, metal)
    tail: Vertex3D[]
    _aero_wing(tail, [WingStation(0, 2.5, 7.6, 1.8, 0.24), WingStation(3.6, 2.5, 7.75, 1.55, 0.2), WingStation(4.1, 2.5, 7.9, 1.2, 0.16)], lv.wing, lv.wing)
    bins[6].extend(tail)
    loop x in [-2.7, 0.0, 2.7]: _fin(bins[6], x, 2.55, 4.35, 7.7, 9.35, 0.75, 0.35, 0.09, lv.body, lv.accent)
    sh.shade.push(vec3(0, 2.5, 8.4)); sh.shade.push(vec3(4.0, 0.1, 0.9))
    sh.exit = vec3(f32(hx), 0.95, -4.6)
    sh

_build_wal = (bins: mut Vertex3D[][], lv: Livery, metal: vec4, dark: vec4) -> BoatShape:
    sh = BoatShape(blades = 2)
    # A broad, flat-decked hull with a single step; it sweeps up aft into the tail.
    rings = [_hull_ring(-8.3, 0.2, 0.0, -0.4, -0.55), _hull_ring(-7.7, 0.75, 0.35, -0.9, -1.2), _hull_ring(-6.2, 1.1, 0.5, -1.0, -1.5),
        _hull_ring(-2.0, 1.15, 0.5, -1.05, -1.6), _hull_ring(0.6, 1.12, 0.52, -1.0, -1.58), _hull_ring(0.65, 1.05, 0.52, -0.8, -1.05),
        _hull_ring(4.0, 0.72, 0.75, -0.35, -0.55), _hull_ring(7.4, 0.32, 1.25, 0.3, 0.2), _hull_ring(8.9, 0.1, 1.45, 0.85, 0.8)]
    _rloft(bins[0], rings, lv.body, lv.trim, -0.82)
    _windows(bins[0], 1.08, -0.05, -3.4, -0.4, 4, 0.34, 0.42, rgb(0.17, 0.22, 0.26))
    # pilots side by side ahead of the wing, a gunner's ring in the bow
    c = vec3(0, 0.56, -4.6)
    _open_cockpit(bins[0], c, 1.25, lv.trim)
    sh.seats.push(vec3(-0.35, 0.94, -4.6))
    b = vec3(0, 0.45, -6.9)
    _open_cockpit(bins[0], b, 0.5, lv.trim)
    sh.seats.push(b + vec3(0, 0.38, 0))
    loop k in [-2.0, 0.4]: sh.contacts.push(vec3(0, -1.6, f32(k * 2.4)))
    loop dx in [-0.62, 0.62]:
        loop z in [-4.0, 0.4]: sh.contacts.push(vec3(f32(dx), -1.2, f32(z)))
    sh.contacts.push(vec3(0, -0.6, 4.6))
    sh.shade.push(vec3(0, 0, 0.3)); sh.shade.push(vec3(1.15, 0.9, 8.6))
    # Sponsons: stub aerofoils at the waterline, braced up to the wing.
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        sp = [loop s in [WingStation(1.0, -0.72, -2.6, 3.8, 0.62), WingStation(2.6, -0.8, -2.3, 3.3, 0.5), WingStation(3.4, -0.84, -2.0, 2.6, 0.36)]: _aero_ring(side * s.x, s.y, s.le, s.chord, s.thick)]
        _rloft(bins[id], sp, lv.body, lv.trim, -0.9)
        loop z in [-1.9, -0.2]:
            _bstrut(bins[id], vec3(f32(side * 3.1), -0.6, f32(z)), vec3(f32(side * 5.6), 2.95, f32(z - 0.2)), 0.07, metal)
        _bstrut(bins[id], vec3(f32(side * 3.1), -0.6, -1.9), vec3(f32(side * 5.6), 2.95, -0.4), 0.035, metal)
        sh.contacts.push(vec3(f32(side * 3.1), -0.92, -1.6))
        sh.contacts.push(vec3(f32(side * 3.1), -0.92, 0.4))
        sh.shade.push(vec3(f32(side * 2.2), -0.8, -0.7)); sh.shade.push(vec3(1.2, 0.3, 1.7))
    # The parasol wing, on N struts over the hull.
    wing: Vertex3D[]
    _aero_wing(wing, [WingStation(0, 3.1, -3.0, 4.3, 0.5), WingStation(9.6, 3.1, -3.0, 4.3, 0.46), WingStation(10.9, 3.1, -2.7, 3.6, 0.36), WingStation(11.25, 3.1, -2.2, 2.6, 0.22)], lv.wing, lv.accent)
    _split_wing(bins, wing)
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        _bars(bins[id], vec3(f32(side * 7.0), 3.38, -0.9), 1.6, lv.accent)
        loop z in [-2.4, -0.2]: _bstrut(bins[id], vec3(f32(side * 0.75), 0.5, f32(z)), vec3(f32(side * 1.5), 2.86, f32(z)), 0.07, metal)
        _bstrut(bins[id], vec3(f32(side * 0.75), 0.5, -2.4), vec3(f32(side * 1.5), 2.86, -0.2), 0.04, metal)
    sh.shade.push(vec3(0, 3.1, -0.85)); sh.shade.push(vec3(11.2, 0.12, 2.15))
    # The tandem nacelle on a pylon over the wing's centre: pull at the front, push at the back,
    # the radiator in between.
    ey = 4.95
    _nacelle(bins[1], vec3(0, f32(ey), 0), -3.25, 1.55, 0.58, lv.trim, 0.45, 0.4)
    _bbox(bins[1], vec3(0, f32(ey + 0.15), -0.85), vec3(0.62, 0.55, 0.32), dark)
    _bbox(bins[1], vec3(0, f32(ey - 0.95), -0.85), vec3(0.18, 0.55, 1.3), lv.trim)
    loop side in [-1.0, 1.0]:
        _bstrut(bins[1], vec3(f32(side * 0.25), f32(ey - 0.4), -2.6), vec3(f32(side * 1.4), 3.36, -2.6), 0.05, metal)
        _bstrut(bins[1], vec3(f32(side * 0.25), f32(ey - 0.4), 1.0), vec3(f32(side * 1.4), 3.36, 0.9), 0.05, metal)
    _spin(bins[1], vec3(0, f32(ey), -3.35), 0.2, lv.accent, false)
    _spin(bins[1], vec3(0, f32(ey), 1.65), 0.18, lv.accent, true)
    sh.hubs = [vec3(0, f32(ey), -3.55), vec3(0, f32(ey), 1.85)]
    sh.back = [false, true]
    # The tail: a fin on the upswept stern, the tailplane half way up it on struts.
    _fin(bins[6], 0.0, 1.3, 4.0, 6.4, 8.95, 0.7, 0.6, 0.11, lv.body, lv.accent)
    tail: Vertex3D[]
    _aero_wing(tail, [WingStation(0, 2.4, 6.9, 1.9, 0.22), WingStation(3.1, 2.4, 7.1, 1.6, 0.18), WingStation(3.5, 2.4, 7.3, 1.1, 0.14)], lv.wing, lv.wing)
    bins[6].extend(tail)
    loop side in [-1.0, 1.0]: _bstrut(bins[6], vec3(f32(side * 0.3), 0.7, 6.6), vec3(f32(side * 1.8), 2.32, 7.4), 0.04, metal)
    sh.shade.push(vec3(0, 2.4, 7.8)); sh.shade.push(vec3(3.4, 0.1, 0.95))
    sh.exit = vec3(0.7, 0.55, -3.4)
    sh

_build_dox = (bins: mut Vertex3D[][], lv: Livery, metal: vec4, dark: vec4) -> BoatShape:
    sh = BoatShape(blades = 2)
    # The hull: three decks, its bow rounded, one step; tarred below the waterline.
    rings = [_hull_ring(-19.6, 0.5, 0.3, -1.6, -1.9), _hull_ring(-18.6, 1.7, 1.8, -2.3, -2.7), _hull_ring(-15.5, 2.45, 2.55, -2.5, -3.1),
        _hull_ring(-6.0, 2.6, 2.7, -2.55, -3.2), _hull_ring(2.0, 2.55, 2.75, -2.5, -3.15), _hull_ring(2.1, 2.45, 2.75, -2.1, -2.4),
        _hull_ring(10.0, 1.8, 3.1, -1.1, -1.4), _hull_ring(16.5, 0.85, 3.7, 0.6, 0.4), _hull_ring(20.4, 0.2, 4.1, 2.4, 2.3)]
    _rloft(bins[0], rings, lv.body, lv.trim, -1.75)
    # the bridge: glazed, on the top deck forward, a deckhouse behind it (src/cockpit_cabins.jo
    # shapes both, inside and out); the passenger and lower decks' windows
    cabin_exterior(bins[0], cockpit_layout(.dornier_dox), lv.body, lv.trim)
    _windows(bins[0], 2.62, 1.1, -13.0, 8.0, 15, 0.62, 0.55, rgb(0.17, 0.22, 0.26))
    _windows(bins[0], 2.64, -0.85, -11.0, 4.0, 9, 0.36, 0.36, rgb(0.17, 0.22, 0.26))
    loop side in [-1.0, 1.0]:
        sh.seats.push(vec3(f32(side * 0.6), 4.2, -13.0))
    loop z in [-12.0, 1.6]: sh.contacts.push(vec3(0, -3.2, f32(z)))
    loop dx in [-1.6, 1.6]:
        loop z in [-10.0, 1.6]: sh.contacts.push(vec3(f32(dx), -2.7, f32(z)))
    sh.contacts.push(vec3(0, -1.6, 11.0))
    sh.shade.push(vec3(0, 0, 0.4)); sh.shade.push(vec3(2.6, 2.6, 20.0))
    # Sponsons, braced up to the wing with three struts each side.
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        sp = [loop s in [WingStation(2.3, -1.5, -6.4, 9.2, 1.3), WingStation(5.8, -1.7, -5.6, 7.6, 0.95), WingStation(7.4, -1.8, -4.8, 5.8, 0.6)]: _aero_ring(side * s.x, s.y, s.le, s.chord, s.thick)]
        _rloft(bins[id], sp, lv.body, lv.trim, -1.9)
        loop z in [-4.4, -1.8, 0.6]:
            _bstrut(bins[id], vec3(f32(side * 6.8), -1.3, f32(z)), vec3(f32(side * 11.0), 2.8, f32(z - 0.6)), 0.13, metal)
        sh.contacts.push(vec3(f32(side * 6.7), -1.86, -3.6))
        sh.contacts.push(vec3(f32(side * 6.7), -1.86, 0.4))
        sh.shade.push(vec3(f32(side * 4.9), -1.6, -1.8)); sh.shade.push(vec3(2.6, 0.5, 3.8))
    # The wing on top of the hull, nearly rectangular.
    wing: Vertex3D[]
    _aero_wing(wing, [WingStation(0, 3.4, -6.2, 9.6, 1.35), WingStation(18.0, 3.45, -6.0, 9.0, 1.1), WingStation(22.6, 3.5, -5.6, 7.8, 0.85),
        WingStation(24.0, 3.5, -4.7, 5.6, 0.5)], lv.wing, lv.accent)
    _split_wing(bins, wing)
    loop side in [-1.0, 1.0]: _bars(bins[if side < 0: 2 else: 3], vec3(f32(side * 17.5), 4.12, -1.6), 3.2, lv.accent)
    sh.shade.push(vec3(0, 3.4, -1.4)); sh.shade.push(vec3(24.0, 0.2, 4.8))
    # Six tandem nacelles on struts, joined by a slender auxiliary wing; Jupiters at both ends.
    ey = 7.6
    aux: Vertex3D[]
    _aero_wing(aux, [WingStation(0, ey - 0.15, -3.9, 2.9, 0.42), WingStation(13.2, ey - 0.15, -3.9, 2.9, 0.42), WingStation(13.8, ey - 0.15, -3.6, 2.2, 0.3)], lv.wing, lv.wing)
    bins[1].extend(aux)
    loop xi in [-11.1, -6.7, -2.3, 2.3, 6.7, 11.1]:
        c = vec3(f32(xi), f32(ey), 0)
        _tandem_pair(bins[1], sh, c, -5.25, 0.25, 0.78, true, lv, metal, dark)
        loop z in [-3.6, -1.2]:
            _bstrut(bins[1], vec3(f32(xi), f32(ey - 0.5), f32(z)), vec3(f32(xi), 4.0, f32(z - 0.3)), 0.11, metal)
        _bstrut(bins[1], vec3(f32(xi), f32(ey - 0.5), -3.6), vec3(f32(xi), 4.0, -1.5), 0.05, metal)
    sh.shade.push(vec3(0, f32(ey), -2.45)); sh.shade.push(vec3(13.8, 0.2, 1.5))
    # The tail: a big fin and rudder on the upswept stern; the tailplane on struts.
    _fin(bins[6], 0.0, 3.6, 8.8, 12.8, 20.4, 0.6, 2.6, 0.28, lv.body, lv.accent)
    tail: Vertex3D[]
    _aero_wing(tail, [WingStation(0, 4.3, 14.6, 4.6, 0.5), WingStation(6.6, 4.3, 15.2, 3.8, 0.4), WingStation(7.6, 4.3, 15.7, 2.6, 0.28)], lv.wing, lv.wing)
    bins[6].extend(tail)
    loop side in [-1.0, 1.0]: _bstrut(bins[6], vec3(f32(side * 0.9), 2.4, 14.8), vec3(f32(side * 4.4), 4.1, 15.8), 0.07, metal)
    sh.shade.push(vec3(0, 4.3, 16.6)); sh.shade.push(vec3(7.6, 0.15, 2.2))
    sh.exit = vec3(2.2, 2.75, -8.0)
    sh

_build_h4 = (bins: mut Vertex3D[][], lv: Livery, metal: vec4, dark: vec4) -> BoatShape:
    sh = BoatShape(blades = 4)
    # The hull: two decks deep, a single step, the flight deck in a hump ahead of the wing.
    rings = [_hull_ring(-31.0, 1.0, 0.0, -2.6, -3.0), _hull_ring(-29.6, 2.9, 2.6, -3.5, -4.1), _hull_ring(-25.0, 4.15, 4.3, -3.75, -4.55),
        _hull_ring(-12.0, 4.4, 4.7, -3.8, -4.6), _hull_ring(4.0, 4.35, 4.8, -3.75, -4.55), _hull_ring(4.15, 4.2, 4.8, -3.1, -3.6),
        _hull_ring(16.0, 3.3, 5.2, -1.8, -2.2), _hull_ring(27.0, 1.8, 6.0, 0.6, 0.3), _hull_ring(35.65, 0.4, 6.8, 4.2, 4.1)]
    _rloft(bins[0], rings, lv.body, lv.trim, -2.35)
    hump = [_hull_ring(-27.4, 0.9, 4.1, 3.6, 3.5), _hull_ring(-25.9, 2.2, 6.3, 3.9, 3.8), _hull_ring(-19.0, 2.5, 6.7, 4.0, 3.9), _hull_ring(-12.5, 2.4, 6.2, 4.2, 4.1)]
    _rloft(bins[0], hump, lv.body, lv.body)
    # (the flight deck's glazed house at the hump's head: src/cockpit_cabins.jo)
    cabin_exterior(bins[0], cockpit_layout(.hughes_h4), lv.body, lv.trim)
    _windows(bins[0], 2.25, 5.6, -24.8, -20.6, 4, 0.5, 0.75, rgb(0.2, 0.27, 0.32))
    _windows(bins[0], 4.24, 1.6, -22.0, -14.0, 5, 0.6, 0.6, rgb(0.2, 0.27, 0.32))
    loop side in [-1.0, 1.0]: sh.seats.push(vec3(f32(side * 1.0), 6.3, -24.2))
    loop z in [-18.0, 3.6]: sh.contacts.push(vec3(0, -4.6, f32(z)))
    loop dx in [-2.6, 2.6]:
        loop z in [-15.0, 3.6]: sh.contacts.push(vec3(f32(dx), -4.0, f32(z)))
    sh.contacts.push(vec3(0, -2.6, 18.0))
    sh.shade.push(vec3(0, 0, 2.3)); sh.shade.push(vec3(4.4, 4.0, 33.3))
    # The wing: thick enough at the root to walk inside, tapering to the tips, a little dihedral.
    wing: Vertex3D[]
    _aero_wing(wing, [WingStation(0, 6.6, -9.0, 15.4, 3.3), WingStation(4.4, 6.65, -8.9, 15.2, 3.2), WingStation(20.0, 7.3, -7.0, 12.0, 2.3),
        WingStation(40.0, 8.3, -4.4, 7.6, 1.2), WingStation(47.2, 8.65, -3.4, 5.4, 0.75), WingStation(48.75, 8.7, -2.6, 3.4, 0.4)], lv.wing, lv.accent)
    _split_wing(bins, wing)
    loop side in [-1.0, 1.0]: _bars(bins[if side < 0: 2 else: 3], vec3(f32(side * 30.0), 9.05, -1.2), 5.0, lv.accent)
    sh.shade.push(vec3(0, 7.5, -1.5)); sh.shade.push(vec3(48.0, 0.3, 5.6))
    # Eight Wasp Majors in long cowlings forward of the leading edge, four-bladed.
    loop xi in [-32.5, -25.0, -17.5, -10.0, 10.0, 17.5, 25.0, 32.5]:
        u = abs(xi)
        le = if u < 20.0: -8.9 + (u - 4.4) / 15.6 * 1.9 else: -7.0 + (u - 20.0) / 20.0 * 2.6
        y = if u < 20.0: 6.65 + (u - 4.4) / 15.6 * 0.65 else: 7.3 + (u - 20.0) / 20.0 * 1.0
        c = vec3(f32(xi), f32(y - 0.25), 0)
        _nacelle(bins[1], c, le - 5.2, le + 5.5, 1.25, lv.body, 0.85, 0.5)
        _bbox(bins[1], c + vec3(0, -1.05, f32(le - 1.5)), vec3(0.45, 0.25, 0.9), dark)
        _spin(bins[1], c + vec3(0, 0, f32(le - 5.35)), 0.55, lv.body, false)
        sh.hubs.push(c + vec3(0, 0, f32(le - 5.9))); sh.back.push(false)
    # Tip floats on tall pylons.
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        x = side * 38.5
        _bfloat(bins[id], vec3(f32(x), -1.4, -1.6), 10.5, 1.15, lv.body, lv.trim)
        loop z in [-3.2, 0.2]: _bstrut(bins[id], vec3(f32(x), -0.9, f32(z)), vec3(f32(x), 7.6, f32(z + 0.4)), 0.22, lv.body)
        _bstrut(bins[id], vec3(f32(x), -0.9, -3.2), vec3(f32(x - side * 4.0), 7.4, -2.0), 0.1, metal)
        sh.contacts.push(vec3(f32(x), -2.35, -3.2))
        sh.contacts.push(vec3(f32(x), -2.35, 0.8))
        sh.shade.push(vec3(f32(x), -1.4, -1.6)); sh.shade.push(vec3(1.15, 0.8, 5.25))
    # The tail: one huge fin; the tailplane on the hull below it.
    _fin(bins[6], 0.0, 5.6, 19.6, 18.5, 35.65, 0.42, 9.0, 0.7, lv.body, lv.accent)
    tail: Vertex3D[]
    _aero_wing(tail, [WingStation(0, 6.9, 25.4, 9.0, 1.1), WingStation(14.5, 7.2, 27.6, 6.0, 0.7), WingStation(17.0, 7.25, 28.8, 3.8, 0.45)], lv.wing, lv.wing)
    bins[6].extend(tail)
    sh.shade.push(vec3(0, 7.0, 30.0)); sh.shade.push(vec3(17.0, 0.2, 4.4))
    sh.exit = vec3(4.0, 4.8, -14.0)
    sh

_build_sarafand = (bins: mut Vertex3D[][], lv: Livery, metal: vec4, dark: vec4) -> BoatShape:
    sh = BoatShape(blades = 4)
    # A deep hull, its enclosed cockpit high in the bow, one step, swept up into the tail.
    rings = [_hull_ring(-13.0, 0.4, 0.4, -1.3, -1.6), _hull_ring(-12.2, 1.35, 1.5, -1.9, -2.2), _hull_ring(-9.8, 1.85, 1.9, -2.05, -2.45),
        _hull_ring(-3.0, 1.95, 1.95, -2.1, -2.5), _hull_ring(1.6, 1.92, 1.95, -2.05, -2.45), _hull_ring(1.7, 1.82, 1.95, -1.6, -1.85),
        _hull_ring(7.0, 1.3, 2.2, -0.7, -0.95), _hull_ring(11.5, 0.6, 2.7, 0.7, 0.55), _hull_ring(14.3, 0.18, 3.0, 2.1, 2.0)]
    _rloft(bins[0], rings, lv.body, lv.trim, -1.3)
    cabin_exterior(bins[0], cockpit_layout(.short_sarafand), lv.body, lv.trim)
    _windows(bins[0], 1.95, 0.6, -6.5, 1.0, 6, 0.4, 0.4, rgb(0.17, 0.22, 0.26))
    b = vec3(0, 1.62, -12.0)
    _open_cockpit(bins[0], b, 0.6, lv.trim)
    loop side in [-1.0, 1.0]: sh.seats.push(vec3(f32(side * 0.5), 3.0, -9.0))
    loop z in [-8.0, 1.2]: sh.contacts.push(vec3(0, -2.5, f32(z)))
    loop dx in [-1.15, 1.15]:
        loop z in [-6.5, 1.2]: sh.contacts.push(vec3(f32(dx), -2.05, f32(z)))
    sh.contacts.push(vec3(0, -0.9, 7.0))
    sh.shade.push(vec3(0, 0, 0.6)); sh.shade.push(vec3(1.95, 2.2, 13.6))
    # Two wings of nearly equal span; the lower on the hull's shoulders, the upper on struts.
    lower: Vertex3D[]
    _aero_wing(lower, [WingStation(0, 1.9, -2.6, 4.6, 0.6), WingStation(15.6, 1.95, -2.6, 4.6, 0.55), WingStation(16.8, 1.95, -2.35, 3.8, 0.42), WingStation(17.4, 1.95, -1.9, 2.8, 0.26)], lv.wing, lv.accent)
    _split_wing(bins, lower)
    upper: Vertex3D[]
    _aero_wing(upper, [WingStation(0, 6.6, -2.8, 4.8, 0.62), WingStation(16.8, 6.6, -2.8, 4.8, 0.58), WingStation(17.9, 6.6, -2.5, 4.0, 0.44), WingStation(18.4, 6.6, -2.0, 3.0, 0.28)], lv.wing, lv.accent)
    _split_wing(bins, upper)
    loop side in [-1.0, 1.0]:
        id = if side < 0: 2 else: 3
        _bars(bins[id], vec3(f32(side * 12.5), 6.96, -0.6), 2.4, lv.accent)
        # two bays of interplane struts outboard of the engines, wire-braced
        loop x in [10.4, 15.2]:
            loop z in [-2.0, 1.2]: _bstrut(bins[id], vec3(f32(side * x), 2.15, f32(z)), vec3(f32(side * x), 6.35, f32(z - 0.15)), 0.08, lv.trim)
        _bstrut(bins[id], vec3(f32(side * 10.4), 2.15, -0.4), vec3(f32(side * 15.2), 6.35, -0.4), 0.025, metal)
        _bstrut(bins[id], vec3(f32(side * 15.2), 2.15, -0.4), vec3(f32(side * 10.4), 6.35, -0.4), 0.025, metal)
        _bstrut(bins[id], vec3(f32(side * 5.6), 2.15, -0.4), vec3(f32(side * 10.4), 6.35, -0.4), 0.025, metal)
    sh.shade.push(vec3(0, 1.9, -0.3)); sh.shade.push(vec3(17.4, 0.12, 2.3))
    sh.shade.push(vec3(0, 6.6, -0.4)); sh.shade.push(vec3(18.4, 0.12, 2.4))
    # Three push-pull pairs of cowled V-12s between the wings, on struts to both.
    ey = 4.75
    loop xi in [-5.6, 0.0, 5.6]:
        c = vec3(f32(xi), f32(ey), 0)
        _tandem_pair(bins[1], sh, c, -3.25, 2.65, 0.62, false, lv, metal, dark)
        loop z in [-1.9, 0.9]:
            _bstrut(bins[1], vec3(f32(xi), f32(ey + 0.5), f32(z)), vec3(f32(xi), 6.3, f32(z)), 0.09, metal)
            _bstrut(bins[1], vec3(f32(xi), f32(ey - 0.5), f32(z)), vec3(f32(xi * 0.9), if xi == 0.0: 2.1 else: 2.2, f32(z)), 0.09, metal)
    sh.shade.push(vec3(0, f32(ey), -0.3)); sh.shade.push(vec3(6.2, 0.6, 3.0))
    # Tip floats under the lower wing.
    loop side in [-1.0, 1.0]:
        id = if side < 0: 4 else: 5
        x = side * 13.6
        _bfloat(bins[id], vec3(f32(x), -0.95, -0.9), 5.4, 0.62, lv.body, lv.trim)
        loop z in [-1.8, 0.0]: _bstrut(bins[id], vec3(f32(x), -0.6, f32(z)), vec3(f32(x), 1.68, f32(z + 0.2)), 0.07, metal)
        _bstrut(bins[id], vec3(f32(x), -0.6, -1.8), vec3(f32(x - side * 1.8), 1.68, -0.6), 0.04, metal)
        sh.contacts.push(vec3(f32(x), -1.55, -2.3))
        sh.contacts.push(vec3(f32(x), -1.55, 0.6))
        sh.shade.push(vec3(f32(x), -0.95, -0.9)); sh.shade.push(vec3(0.62, 0.4, 2.7))
    # A biplane tail on the upswept stern: two tailplanes, three fins and rudders between them.
    loop ty in [2.9, 5.6]:
        tail: Vertex3D[]
        _aero_wing(tail, [WingStation(0, ty, 11.3, 2.6, 0.3), WingStation(4.4, ty, 11.5, 2.3, 0.26), WingStation(5.0, ty, 11.8, 1.7, 0.2)], lv.wing, lv.wing)
        bins[6].extend(tail)
    loop x in [-3.6, 0.0, 3.6]: _fin(bins[6], x, if x == 0.0: 2.6 else: 2.95, 6.6, 11.4, 14.3, 0.8, 0.35, 0.12, lv.body, lv.accent)
    loop side in [-1.0, 1.0]: _bstrut(bins[6], vec3(f32(side * 2.0), 3.0, 12.0), vec3(f32(side * 2.0), 5.55, 12.0), 0.05, metal)
    sh.shade.push(vec3(0, 4.2, 12.6)); sh.shade.push(vec3(5.0, 1.4, 1.3))
    sh.exit = vec3(1.4, 1.95, -5.5)
    sh

# The model for one of the big boats (planes.jo's build_craft hands these over).
build_big_boat = (kind: Craft, lv: Livery) -> CraftModel:
    p = aircraft_profile(kind)
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    metal = rgb(0.35, 0.36, 0.34); dark = rgb(0.14, 0.13, 0.12)
    sh = match kind:
        .sm_s55: _build_s55(bins, lv, metal, dark)
        .dornier_wal: _build_wal(bins, lv, metal, dark)
        .dornier_dox: _build_dox(bins, lv, metal, dark)
        .short_sarafand: _build_sarafand(bins, lv, metal, dark)
        _: _build_h4(bins, lv, metal, dark)
    vs: Vertex3D[]
    loop bin in bins: vs.extend(bin)
    spins = [loop b in sh.back: (if b: -1.0 else: 1.0)]
    metal_props = kind == .hughes_h4
    # (right-hand props, as the period's engines (the profiles' prop_hand); a pair's pusher is the
    # other hand: spin -1, on mirror-twisted blades)
    m = CraftModel(custom_mesh(vs), _boat_prop(p.prop_radius, sh.blades, prop_twist(kind), metal_props), sh.hubs[0], sh.contacts, sh.seats[0], sh.exit, sh.shade,
        prop_hubs = sh.hubs, cockpits = sh.seats, prop_radius = p.prop_radius, prop_blades = sh.blades, prop_spins = spins,
        prop_alt = _boat_prop(p.prop_radius, sh.blades, -prop_twist(kind), metal_props))
    m.prop_hand = if p.prop_hand < 0.0: -1.0 else: 1.0
    m = fit_cockpit(m, bins[0], kind)
    m.cockpit_wings = [custom_mesh(bins[2]), custom_mesh(bins[3])]
    specs = boat_parts(kind, m.contacts)
    loop i in 0..7: m.parts.push(CraftPart(specs[i], custom_mesh(bins[i])))
    m

# Contacts only, for the flight model without meshes (headless tests, the living world).
big_boat_contacts = (kind: Craft) -> vec3[]:
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    lv = LIVERIES[0]; metal = rgb(0.35, 0.36, 0.34); dark = rgb(0.14, 0.13, 0.12)
    sh = match kind:
        .sm_s55: _build_s55(bins, lv, metal, dark)
        .dornier_wal: _build_wal(bins, lv, metal, dark)
        .dornier_dox: _build_dox(bins, lv, metal, dark)
        .short_sarafand: _build_sarafand(bins, lv, metal, dark)
        _: _build_h4(bins, lv, metal, dark)
    sh.contacts

# Where the wings touch the water first, tips of the lowest wing (the flight model's wing contacts).
big_boat_wing_contacts = (kind: Craft) -> vec3[]:
    match kind:
        .sm_s55: [vec3(-12.0, 2.17, -1.4), vec3(12.0, 2.17, -1.4)]
        .dornier_wal: [vec3(-11.25, 3.1, -0.9), vec3(11.25, 3.1, -0.9)]
        .dornier_dox: [vec3(-24.0, 3.5, -1.9), vec3(24.0, 3.5, -1.9)]
        .short_sarafand: [vec3(-17.4, 1.95, -0.5), vec3(17.4, 1.95, -0.5), vec3(-18.4, 6.6, -0.5), vec3(18.4, 6.6, -0.5)]
        _: [vec3(-48.75, 8.7, -0.9), vec3(48.75, 8.7, -0.9)]

# Which part a hull or float contact belongs to: the S.55's two hulls are its "floats".
big_boat_contact_part = (kind: Craft, p: vec3) -> int:
    if kind == .sm_s55: return if p.x < 0: int(PartId.left_float) else: int(PartId.right_float)
    if abs(f64(p.x)) < aircraft_profile(kind).width * 1.6: return int(PartId.body)
    if p.x < 0: int(PartId.left_float) else: int(PartId.right_float)

# The damage parts: the hull (or the S.55's wing centre and crew), the engines with their
# nacelles and struts, each outer wing, the sponsons, tip floats or the S.55's hulls, and the tail.
boat_parts = (kind: Craft, contacts: vec3[]) -> PartSpec[]:
    p = aircraft_profile(kind)
    twin = kind == .sm_s55
    fx = if twin: 3.05 else: p.float_x
    tail = vec3(0, f32(p.wing_y), f32(p.length * 0.44))
    ps = [PartSpec(.body, if twin: "wing centre section" else: "hull", vec3(0, 0, 0), if twin: 0.24 else: 0.5, 150000, if twin: 1.6 else: 1.15),
        PartSpec(.engine, "engines", vec3(0, f32(p.engine_y), f32(p.engine_z)), if twin: 0.16 else: 0.18, 67500, 0.15),
        PartSpec(.left_wing, "left wing", vec3(f32(-fx), f32(p.wing_y), -0.65), 0.1, 48000, 2.0),
        PartSpec(.right_wing, "right wing", vec3(f32(fx), f32(p.wing_y), -0.65), 0.1, 48000, 2.0),
        PartSpec(.left_float, if twin: "port hull" else: (if kind == .hughes_h4 or kind == .short_sarafand: "port float" else: "port sponson"), vec3(f32(-fx), f32(p.float_y), -0.35), if twin: 0.16 else: 0.05, if twin: 150000 else: 40000, 2.8),
        PartSpec(.right_float, if twin: "starboard hull" else: (if kind == .hughes_h4 or kind == .short_sarafand: "starboard float" else: "starboard sponson"), vec3(f32(fx), f32(p.float_y), -0.35), if twin: 0.16 else: 0.05, if twin: 150000 else: 40000, 2.8),
        PartSpec(.tail, "tail", tail, 0.08, 33000, 1.6)]
    if twin:
        ps[2].mass_share = 0.1; ps[3].mass_share = 0.1
    else:
        ps[0].mass_share = 1.0 - 0.18 - 0.2 - 0.1 - 0.08
    loop i in 0..ps.len(): ps[i].strength *= p.mass / 1400.0
    loop c in contacts: ps[big_boat_contact_part(kind, c)].contacts.push(c)
    loop c in big_boat_wing_contacts(kind): ps[if c.x < 0: 2 else: 3].wing_contacts.push(c)
    half = p.width
    ps[0].strikes = if twin: [vec3(0, 1.4, -3.4), vec3(-2.0, 1.4, 0), vec3(2.0, 1.4, 0)] else: [vec3(f32(-half), 0, 0), vec3(f32(half), 0, 0), vec3(0, f32(half), f32(-p.length * 0.47))]
    loop c in [vec3(0, f32(p.engine_y), f32(p.engine_z))]: ps[1].strikes.push(c)
    ps[6].strikes = [tail + vec3(f32(-p.span * 0.15), 0, 0), tail + vec3(f32(p.span * 0.15), 0, 0), tail + vec3(0, 1.2, 0)]
    if twin:
        ps[4].strikes = [vec3(-3.05, -0.4, -7.2), vec3(-3.85, 0, 0)]
        ps[5].strikes = [vec3(3.05, -0.4, -7.2), vec3(3.85, 0, 0)]
    ps

# ---------------- water ----------------

# Half the wet beam (the wake's width): the S.55's two hulls, the sponsons, the hulls.
boat_wake_width = (kind: Craft) -> f64:
    match kind:
        .sm_s55: 3.9
        .dornier_wal: 3.2
        .dornier_dox: 7.0
        .short_sarafand: 2.1
        _: 4.6

# How much bigger its spray is than a small boat's (drops, their speed and life): by weight. The
# Do X and the H-4 throw sheets of it.
boat_spray_scale = (kind: Craft) -> f64:
    if not big_boat(kind): return 1.0
    clamp(sqrt(aircraft_profile(kind).mass / 1400.0) / 2.2, 1.0, 3.2)

# the wake's width for any aircraft
wake_width = (kind: Craft) -> f64: if big_boat(kind): boat_wake_width(kind) else: (if kind == .heron: 1.4 else: 1.6)
