# The wildlife drawn (src/wildlife.jo): greylags, mallards, coots, gulls, goats and sheep, each a few painted low-poly
# parts made here in code and posed every frame (a goose's body tipping up to feed and its neck,
# the wings beating, a goat's head down to the grass and its legs swinging), every part of every
# animal near the camera in one instanced draw (each cut at its waterline: wild_fs); and the rings and little wakes they leave on the
# water, one more instanced draw each in the transparent pass. Nothing is drawn, and nothing is
# posed, when none are near.

use 'look.jo'
use 'render_space.jo'
use 'depth_space.jo'
use 'objects.jo'
use 'quality.jo'
use 'sea.jo'
use 'wildlife.jo'

struct WildMeshes:
    fowl: Mesh[]                    # FW_* (waterfowl bodies, necks, wings and feet)
    gull_perched: Mesh
    gull_body: Mesh
    gull_wing: Mesh[]
    goat_body: Mesh
    goat_head: Mesh
    goat_leg: Mesh
    sheep_body: Mesh
    sheep_head: Mesh
    sheep_leg: Mesh
    wake: Mesh
    ring: Mesh
    ready = false

# the waterfowl's meshes in WildMeshes.fowl: a body for each kind (wildlife.jo FOWL_*) and the
# goslings', a neck and head for each kind, each kind's two wings, and a webbed foot
const FW_BODY = 0
const FW_GOSLING = 4
const FW_NECK = 5
const FW_WING = 9
const FW_FEET = 17
const FW_COUNT = 18

# (both faces of a thin wing: it is seen from above and below)
_wtri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    vs.push(Vertex3D(a, n, vec2(0, 0), col)); vs.push(Vertex3D(b, n, vec2(0, 0), col)); vs.push(Vertex3D(c, n, vec2(0, 0), col))
    vs.push(Vertex3D(a, -n, vec2(0, 0), col)); vs.push(Vertex3D(c, -n, vec2(0, 0), col)); vs.push(Vertex3D(b, -n, vec2(0, 0), col))

# A wing from its root at the shoulder out along x (side +1 right, -1 left): the inner part, the
# hand, and the dark tips of the long feathers. Lengths in metres; nose toward -z.
_wing = (side: f64, span: f64, chord: f64, inner: vec4, outer: vec4, tip: vec4) -> Mesh:
    vs: Vertex3D[]
    s = f32(side); w = f32(span); c = f32(chord)
    root_f = vec3(0, 0, -c * 0.45); root_b = vec3(0, 0, c * 0.55)
    mid_f = vec3(s * w * 0.45, 0.02, -c * 0.42); mid_b = vec3(s * w * 0.45, 0.02, c * 0.5)
    hand_f = vec3(s * w * 0.78, 0.0, -c * 0.25); hand_b = vec3(s * w * 0.78, 0.0, c * 0.42)
    end = vec3(s * w, -0.01, c * 0.18)
    _wtri(vs, root_f, mid_f, root_b, inner); _wtri(vs, mid_f, mid_b, root_b, inner)
    _wtri(vs, mid_f, hand_f, mid_b, outer); _wtri(vs, hand_f, hand_b, mid_b, outer)
    _wtri(vs, hand_f, end, hand_b, tip)
    custom_mesh(vs)

# (an ellipsoid of few facets: the painted look wants no more, and a raft is many birds)
_ell = (vs: mut Vertex3D[], at: vec3, size: vec3, col: vec4, seg: int = 8, rings: int = 5, turn: mat4 = mat4()):
    add_sphere(vs, vec3(0, 0, 0), 1.0, col, max(5, seg - 2), max(2, rings - 1), translation(at) * turn * scaling(size))

# The waterfowl, each in a greylag's frame (wildlife.jo FOWL_SIZE scales them): waterline at
# y = 0, nose toward -z, the neck's root at (0, 0.15, -0.31), the shoulders at (+-0.09, 0.17, -0.07).
_fowl_meshes = () -> Mesh[]:
    out: Mesh[]
    white = rgb(0.95, 0.94, 0.9); black = rgb(0.07, 0.07, 0.075)
    # greylag: grey-brown, the flanks barred darker, the folded wing scalloped with pale edges, a
    # pale grey rump over a white stern, a thick grey-brown neck and an orange bill
    gb = rgb(0.5, 0.46, 0.4); gbreast = rgb(0.68, 0.65, 0.58); gflank = rgb(0.4, 0.36, 0.31)
    gwing = rgb(0.43, 0.4, 0.36); gedge = rgb(0.74, 0.72, 0.66); orange = rgb(0.93, 0.55, 0.24)
    b: Vertex3D[]
    _ell(b, vec3(0, 0.07, 0.0), vec3(0.18, 0.15, 0.37), gb, 9, 6)
    _ell(b, vec3(0, 0.07, -0.19), vec3(0.165, 0.14, 0.21), gbreast)
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        _ell(b, vec3(sx * 0.13, 0.06, 0.04), vec3(0.06, 0.05, 0.25), gflank, 6, 3)
        _ell(b, vec3(sx * 0.105, 0.12, 0.07), vec3(0.085, 0.07, 0.29), gwing, 7, 4, rotation_y(side * 0.07))
        loop k in 0..3:
            _ell(b, vec3(sx * 0.125, f32(0.135 - f64(k) * 0.012), f32(0.0 + f64(k) * 0.09)), vec3(0.07, 0.012, 0.05), gedge, 5, 2, rotation_y(side * 0.07))
    _ell(b, vec3(0, 0.15, 0.28), vec3(0.1, 0.05, 0.1), rgb(0.78, 0.78, 0.76))
    _ell(b, vec3(0, 0.08, 0.34), vec3(0.12, 0.1, 0.11), white)
    _ell(b, vec3(0, 0.15, 0.42), vec3(0.075, 0.035, 0.085), rgb(0.46, 0.43, 0.39), 6, 3)
    _ell(b, vec3(0, 0.155, 0.48), vec3(0.06, 0.02, 0.03), white, 6, 3)
    out.push(custom_mesh(b))
    # mallard drake: a grey body, chestnut breast, black stern and curled tail feathers, white tail,
    # the blue wing patch showing on the folded wing
    blue = rgb(0.2, 0.32, 0.78)
    d: Vertex3D[]
    _ell(d, vec3(0, 0.07, 0.0), vec3(0.17, 0.13, 0.36), rgb(0.72, 0.72, 0.7), 9, 6)
    _ell(d, vec3(0, 0.08, -0.2), vec3(0.15, 0.13, 0.17), rgb(0.42, 0.24, 0.15))
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        _ell(d, vec3(sx * 0.1, 0.12, 0.08), vec3(0.08, 0.06, 0.26), rgb(0.5, 0.45, 0.38), 7, 4, rotation_y(side * 0.07))
        _ell(d, vec3(sx * 0.13, 0.12, 0.14), vec3(0.035, 0.03, 0.07), blue, 5, 3)
    _ell(d, vec3(0, 0.1, 0.3), vec3(0.11, 0.1, 0.11), black)
    _ell(d, vec3(0, 0.14, 0.41), vec3(0.08, 0.03, 0.07), rgb(0.88, 0.88, 0.86), 6, 3)
    add_box(d, vec3(0, 0.22, 0.33), vec3(0.03, 0.06, 0.03), black, rotation_x(0.6))
    out.push(custom_mesh(d))
    # mallard duck: mottled browns, the same blue patch
    h: Vertex3D[]
    hb = rgb(0.56, 0.44, 0.3); hdark = rgb(0.38, 0.29, 0.2)
    _ell(h, vec3(0, 0.07, 0.0), vec3(0.17, 0.13, 0.36), hb, 9, 6)
    _ell(h, vec3(0, 0.08, -0.2), vec3(0.15, 0.13, 0.17), rgb(0.62, 0.5, 0.36))
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        _ell(h, vec3(sx * 0.1, 0.12, 0.08), vec3(0.08, 0.06, 0.26), hdark, 7, 4, rotation_y(side * 0.07))
        _ell(h, vec3(sx * 0.13, 0.12, 0.14), vec3(0.035, 0.03, 0.07), blue, 5, 3)
        loop k in 0..3:
            _ell(h, vec3(sx * 0.15, 0.05, f32(-0.12 + f64(k) * 0.11)), vec3(0.03, 0.025, 0.04), hdark, 5, 2)
    _ell(h, vec3(0, 0.12, 0.38), vec3(0.08, 0.03, 0.08), rgb(0.66, 0.56, 0.42), 6, 3)
    out.push(custom_mesh(h))
    # coot: a round slate-black body, a small tail
    c: Vertex3D[]
    _ell(c, vec3(0, 0.08, 0.02), vec3(0.2, 0.17, 0.34), rgb(0.13, 0.13, 0.15), 9, 6)
    _ell(c, vec3(0, 0.13, 0.33), vec3(0.08, 0.05, 0.07), rgb(0.1, 0.1, 0.11), 6, 3)
    out.push(custom_mesh(c))
    # goslings: olive-yellow down, a darker crown
    g: Vertex3D[]
    _ell(g, vec3(0, 0.05, 0.02), vec3(0.075, 0.06, 0.13), rgb(0.7, 0.68, 0.4))
    _ell(g, vec3(0, 0.12, -0.11), vec3(0.042, 0.042, 0.045), rgb(0.55, 0.52, 0.3), 6, 4)
    add_box(g, vec3(0, 0.115, -0.16), vec3(0.016, 0.014, 0.03), rgb(0.25, 0.25, 0.22))
    out.push(custom_mesh(g))
    # the necks and heads (from the neck's root, up along y, the bill toward -z)
    n: Vertex3D[]
    add_cylinder(n, vec3(0, -0.02, 0), 0.05, 0.28, gb, 7, 0.038)
    _ell(n, vec3(0, 0.29, -0.035), vec3(0.048, 0.05, 0.085), rgb(0.47, 0.43, 0.37), 7, 4)
    add_box(n, vec3(0, 0.282, -0.135), vec3(0.03, 0.026, 0.075), orange)
    add_box(n, vec3(0, 0.28, -0.175), vec3(0.022, 0.02, 0.012), rgb(0.9, 0.85, 0.75))
    out.push(custom_mesh(n))
    green = rgb(0.08, 0.3, 0.17)
    nd: Vertex3D[]
    add_cylinder(nd, vec3(0, -0.02, 0), 0.055, 0.17, green, 7, 0.045)
    _ell(nd, vec3(0, 0.0, 0), vec3(0.062, 0.016, 0.062), white, 7, 2)
    _ell(nd, vec3(0, 0.18, -0.035), vec3(0.06, 0.064, 0.085), green, 7, 4)
    add_box(nd, vec3(0, 0.165, -0.14), vec3(0.04, 0.02, 0.095), rgb(0.88, 0.82, 0.32))
    out.push(custom_mesh(nd))
    nh: Vertex3D[]
    add_cylinder(nh, vec3(0, -0.02, 0), 0.055, 0.17, hb, 7, 0.045)
    _ell(nh, vec3(0, 0.18, -0.035), vec3(0.06, 0.064, 0.085), rgb(0.6, 0.48, 0.34), 7, 4)
    _ell(nh, vec3(0, 0.22, -0.035), vec3(0.04, 0.03, 0.08), hdark, 6, 3)
    add_box(nh, vec3(0, 0.165, -0.14), vec3(0.04, 0.02, 0.095), rgb(0.75, 0.5, 0.25))
    out.push(custom_mesh(nh))
    nc: Vertex3D[]
    add_cylinder(nc, vec3(0, -0.02, 0), 0.07, 0.15, rgb(0.11, 0.11, 0.12), 7, 0.055)
    _ell(nc, vec3(0, 0.17, -0.03), vec3(0.065, 0.07, 0.08), rgb(0.08, 0.08, 0.09), 7, 4)
    add_box(nc, vec3(0, 0.165, -0.12), vec3(0.035, 0.035, 0.07), rgb(0.95, 0.95, 0.92))
    add_box(nc, vec3(0, 0.21, -0.09), vec3(0.03, 0.06, 0.02), rgb(0.95, 0.95, 0.92))
    out.push(custom_mesh(nc))
    # wings: the greylag's pale grey forewing, the mallard's blue band, the coot's dark slate
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.82, 0.3, gwing, rgb(0.66, 0.67, 0.66), rgb(0.25, 0.24, 0.23)))
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.74, 0.26, blue, rgb(0.48, 0.46, 0.42), rgb(0.32, 0.3, 0.28)))
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.74, 0.26, blue, rgb(0.5, 0.42, 0.32), rgb(0.34, 0.28, 0.22)))
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.62, 0.26, rgb(0.17, 0.17, 0.19), rgb(0.15, 0.15, 0.17), rgb(0.12, 0.12, 0.13)))
    # a webbed foot on its short leg (its colour the instance's: pink, orange or green-grey)
    f: Vertex3D[]
    pale = rgb(1.0, 1.0, 1.0)
    add_box(f, vec3(0, 0.05, 0), vec3(0.02, 0.1, 0.02), pale)
    _wtri(f, vec3(0, 0, 0.01), vec3(-0.05, 0, -0.1), vec3(0.05, 0, -0.1), pale)
    _wtri(f, vec3(-0.05, 0, -0.1), vec3(0, 0, -0.07), vec3(0.05, 0, -0.1), pale)
    out.push(custom_mesh(f))
    out

FOWL_FEET = [rgb(0.9, 0.62, 0.6), rgb(0.95, 0.55, 0.15), rgb(0.95, 0.55, 0.15), rgb(0.5, 0.56, 0.36)]

build_wild_meshes = () -> WildMeshes:
    white = rgb(0.95, 0.94, 0.9)
    # gulls: white with a grey back, black wing tips, a yellow bill, pink legs
    gwhite = rgb(0.96, 0.96, 0.94); grey = rgb(0.6, 0.65, 0.7); tipc = rgb(0.12, 0.12, 0.14); bill = rgb(0.92, 0.75, 0.2)
    p: Vertex3D[]
    _ell(p, vec3(0, 0.2, 0.02), vec3(0.07, 0.072, 0.18), gwhite)
    _ell(p, vec3(0, 0.235, 0.06), vec3(0.074, 0.04, 0.16), grey, 7, 4)
    add_box(p, vec3(0, 0.235, 0.21), vec3(0.05, 0.026, 0.13), tipc)
    _ell(p, vec3(0, 0.3, -0.13), vec3(0.046, 0.048, 0.055), gwhite, 7, 4)
    add_box(p, vec3(0, 0.292, -0.19), vec3(0.016, 0.016, 0.06), bill)
    loop side in [-1.0, 1.0]:
        add_box(p, vec3(f32(side * 0.025), 0.065, 0.0), vec3(0.014, 0.13, 0.014), rgb(0.85, 0.6, 0.55))
    gull_perched = custom_mesh(p)
    f: Vertex3D[]
    _ell(f, vec3(0, 0, 0.0), vec3(0.068, 0.068, 0.2), gwhite)
    _ell(f, vec3(0, 0.03, -0.19), vec3(0.042, 0.044, 0.05), gwhite, 7, 4)
    add_box(f, vec3(0, 0.025, -0.25), vec3(0.015, 0.015, 0.055), bill)
    add_box(f, vec3(0, 0.01, 0.22), vec3(0.08, 0.014, 0.08), gwhite)
    gull_body = custom_mesh(f)
    gull_wing = [loop side in [1.0, -1.0]: _wing(side, 0.62, 0.2, grey, grey, tipc)]
    # goats (their coat the instance's colour): a lean body, a raised tail, a bearded head with
    # swept-back horns, hoofed legs
    coat = rgb(1.0, 1.0, 1.0); horn = rgb(0.32, 0.29, 0.25); hoof = rgb(0.18, 0.16, 0.14)
    gb: Vertex3D[]
    _ell(gb, vec3(0, 0.6, 0.0), vec3(0.2, 0.22, 0.46), coat, 8, 5)
    _ell(gb, vec3(0, 0.64, -0.3), vec3(0.18, 0.21, 0.18), coat, 7, 4)
    add_box(gb, vec3(0, 0.78, 0.45), vec3(0.06, 0.12, 0.05), coat, rotation_x(-0.6))
    goat_body = custom_mesh(gb)
    gh: Vertex3D[]
    add_cylinder(gh, vec3(0, 0, 0), 0.07, 0.24, coat, 6, 0.055, rotation_x(-0.35))
    _ell(gh, vec3(0, 0.24, -0.15), vec3(0.065, 0.075, 0.14), coat, 7, 4, rotation_x(-0.5))
    loop side in [-1.0, 1.0]:
        add_cylinder(gh, vec3(0, 0, 0), 0.022, 0.2, horn, 5, 0.0, translation(vec3(f32(side * 0.035), 0.31, -0.12)) * rotation_z(side * -0.25) * rotation_x(1.05))
        add_box(gh, vec3(f32(side * 0.08), 0.27, -0.1), vec3(0.1, 0.025, 0.045), coat, rotation_z(side * 0.4))
    add_box(gh, vec3(0, 0.12, -0.26), vec3(0.03, 0.08, 0.03), horn)
    goat_head = custom_mesh(gh)
    gl: Vertex3D[]
    add_box(gl, vec3(0, -0.24, 0), vec3(0.055, 0.48, 0.06), coat)
    add_box(gl, vec3(0, -0.48, -0.005), vec3(0.06, 0.04, 0.07), hoof)
    goat_leg = custom_mesh(gl)
    # sheep: a round woolly body (its fleece the instance's colour), a dark face and legs
    sb: Vertex3D[]
    _ell(sb, vec3(0, 0.6, 0.0), vec3(0.22, 0.22, 0.38), coat, 8, 5)
    loop k in 0..7:
        a = f64(k) * 0.9
        _ell(sb, vec3(f32(sin(a) * 0.12), f32(0.7 + cos(a * 1.7) * 0.05), f32(-0.25 + f64(k) * 0.085)), vec3(0.13, 0.12, 0.13), coat, 6, 4)
    sheep_body = custom_mesh(sb)
    face = rgb(0.22, 0.2, 0.19)
    sh: Vertex3D[]
    _ell(sh, vec3(0, 0.08, -0.02), vec3(0.11, 0.11, 0.1), rgb(0.88, 0.85, 0.78), 6, 4)
    _ell(sh, vec3(0, 0.13, -0.15), vec3(0.06, 0.07, 0.12), face, 7, 4, rotation_x(-0.6))
    loop side in [-1.0, 1.0]:
        add_box(sh, vec3(f32(side * 0.08), 0.16, -0.08), vec3(0.09, 0.025, 0.04), face, rotation_z(side * 0.3))
    sheep_head = custom_mesh(sh)
    sl: Vertex3D[]
    add_box(sl, vec3(0, -0.23, 0), vec3(0.045, 0.46, 0.05), face)
    sheep_leg = custom_mesh(sl)
    # the marks on the water: a wake's two arms opening back from its apex, and a ring
    wv: Vertex3D[]
    up = vec3(0, 1, 0)
    loop side in [-1.0, 1.0]:
        a = 0.34 * side
        d = vec3(f32(sin(a)), 0, f32(cos(a))); across = vec3(d.z, 0, -d.x) * 0.06
        loop k in 0..4:
            u0 = f32(f64(k) / 4.0); u1 = f32(f64(k + 1) / 4.0)
            a0 = d * u0; a1 = d * u1
            wv.push(Vertex3D(a0 - across, up, vec2(u0, -1), white)); wv.push(Vertex3D(a1 - across, up, vec2(u1, -1), white)); wv.push(Vertex3D(a1 + across, up, vec2(u1, 1), white))
            wv.push(Vertex3D(a0 - across, up, vec2(u0, -1), white)); wv.push(Vertex3D(a1 + across, up, vec2(u1, 1), white)); wv.push(Vertex3D(a0 + across, up, vec2(u0, 1), white))
    rv: Vertex3D[]
    loop k in 0..20:
        a0 = f64(k) * TAU / 20.0; a1 = f64(k + 1) * TAU / 20.0
        i0 = vec3(f32(cos(a0) * 0.88), 0, f32(sin(a0) * 0.88)); o0 = vec3(f32(cos(a0) * 1.12), 0, f32(sin(a0) * 1.12))
        i1 = vec3(f32(cos(a1) * 0.88), 0, f32(sin(a1) * 0.88)); o1 = vec3(f32(cos(a1) * 1.12), 0, f32(sin(a1) * 1.12))
        rv.push(Vertex3D(i0, up, vec2(0, -1), white)); rv.push(Vertex3D(o1, up, vec2(0, 1), white)); rv.push(Vertex3D(o0, up, vec2(0, 1), white))
        rv.push(Vertex3D(i0, up, vec2(0, -1), white)); rv.push(Vertex3D(i1, up, vec2(0, -1), white)); rv.push(Vertex3D(o1, up, vec2(0, 1), white))
    WildMeshes(_fowl_meshes(), gull_perched, gull_body, gull_wing, goat_body, goat_head, goat_leg, sheep_body, sheep_head, sheep_leg, custom_mesh(wv), custom_mesh(rv), true)

GOAT_COATS = [rgb(0.55, 0.38, 0.24), rgb(0.17, 0.15, 0.14), rgb(0.9, 0.88, 0.82), rgb(0.5, 0.45, 0.4)]
SHEEP_COATS = [rgb(0.93, 0.9, 0.8), rgb(0.86, 0.82, 0.7), rgb(0.8, 0.77, 0.7), rgb(0.22, 0.2, 0.19)]

# ---------------- the marks' shader ----------------

struct MarkParams:
    view_proj: mat4
    cam: vec3
    sun: vec3
    sky: vec3
    haze: vec3
    fog: f32

struct MarkOut:
    pos: vec4
    world: vec3
    data: vec4

mark_vs = (v: Vertex3D, inst: Instance3D, u: MarkParams) -> MarkOut:
    w = inst.model * vec4(v.pos, 1)
    MarkOut(u.view_proj * w, w.xyz, vec4(v.uv.x, v.uv.y, inst.color.x, 0))

mark_fs = (i: MarkOut, u: MarkParams) -> vec4:
    a = (1.0 - smoothstep(0.3, 1.0, abs(i.data.y))) * i.data.z * (1.0 - 0.65 * i.data.x)
    if a < 0.01: discard()
    c = vec3(0.96, 0.98, 1.0) * (u.sun * 0.8 + u.sky * 0.35)
    vec4(aerial(c, i.world, u.cam, u.haze, u.fog), a)

# ---------------- the animals' shader ----------------
# The objects' painted light (objects.jo), with each instance's colour a tint and its alpha the
# height below which it is not drawn: a bird afloat is cut at its waterline, so what is under the
# water (a feeding bird's head and neck, its front half upended, a diving coot) is hidden, as
# through the surface it is in life; animals on land and in the air are never cut.
wild_vs = (v: Vertex3D, inst: Instance3D, u: ObjParams) -> ObjOut:
    w = render_model(inst.model, u.instance_origin) * vec4(v.pos, 1)
    ObjOut(u.view_proj * w, w.xyz, (inst.model * vec4(v.normal, 0)).xyz, vec4(v.color.xyz * inst.color.xyz, inst.color.w))

wild_fs = (i: ObjOut, u: ObjParams) -> vec4:
    if i.world.y < i.color.w: discard()
    o = ObjOut(i.pos, i.world, i.normal, vec4(i.color.xyz, 1.0))
    n = normalize(i.normal)
    obj_finish_light(obj_base_light(o, u, n, dot(n, normalize(u.sun_dir))), o, u, n)

wild_sh: Shader
wild_mark_sh: Shader
wild_meshes: WildMeshes = WildMeshes()
wild_view_ready = false

# (made the first time animals are near, not at the start)
_wild_view_init = ():
    global wild_mark_sh, wild_sh, wild_meshes, wild_view_ready
    wild_mark_sh = make_world_shader(shader(mark_vs, mark_fs))
    wild_sh = make_world_shader(shader(wild_vs, wild_fs))
    wild_meshes = build_wild_meshes()
    wild_view_ready = true

# ---------------- posing ----------------

# (kept between frames, cleared each one)
_wl_lists: Instance3D[][] = [loop k in 0..FW_COUNT + 10: []]
const WL_GULL_PERCHED = 18
const WL_GULL = 19
const WL_GULL_WING_R = 20
const WL_GULL_WING_L = 21
const WL_GOAT = 22
const WL_GOAT_HEAD = 23
const WL_GOAT_LEG = 24
const WL_SHEEP = 25
const WL_SHEEP_HEAD = 26
const WL_SHEEP_LEG = 27

_wl_mesh = (m: WildMeshes, k: int) -> Mesh:
    if k < FW_COUNT: return m.fowl[k]
    match k:
        18: m.gull_perched
        19: m.gull_body
        20: m.gull_wing[0]
        21: m.gull_wing[1]
        22: m.goat_body
        23: m.goat_head
        24: m.goat_leg
        25: m.sheep_body
        26: m.sheep_head
        _: m.sheep_leg

# (a plain instance colour, never cut)
const ONE = vec4(1, 1, 1, -100000)
_flat_d = (a: vec3, b: vec3) -> f64: f64(length(a.xz - b.xz))

# A waterfowl posed: afloat (cut at its waterline `level`), upended to feed (tipped forward about a
# point a little aft of its middle, front half and head under, the rear third and tail up at about
# 55 degrees, the feet paddling at the surface), diving (gone under), or flying with its wings.
_pose_fowl = (g: Goose, level: f64, origin: vec3, t: f64, flying: bool, running: bool, near: bool):
    wobble = if flying: 0.0 else: sin(t * 1.4 + g.seed * 7.0) * 0.012
    bob = if flying: 0.0 else: wobble + level - f64(g.pos.y)
    s = FOWL_SIZE[g.kind]
    cut = vec4(1, 1, 1, f32(level + wobble * 0.5 - 0.005))
    base = translation(g.pos - origin + vec3(0, f32(bob), 0)) * rotation_y(g.yaw + PI) * scaling(vec3(f32(s), f32(s), f32(s)))
    if g.young:
        _wl_lists[FW_GOSLING].push(Instance3D(base * translation(vec3(0, f32(-0.04 * g.tip), 0)) * rotation_x(-g.tip * 0.9), cut))
        return
    pitch = if flying: clamp(f64(g.vel.y) * 0.08, -0.15, 0.3) else: 0.0
    body = base * translation(vec3(0, f32(-0.07 * g.tip - 0.5 * g.under), 0.1)) * rotation_x(pitch - g.tip * 0.98 - g.under * 0.4) * translation(vec3(0, 0, -0.1))
    _wl_lists[FW_BODY + g.kind].push(Instance3D(body, cut))
    # the neck: up, laid back to rest, turned back to preen, stretched ahead in flight, or on down
    # into the water feeding
    n = g.neck
    side = if g.seed < 0.5: 1.0 else: -1.0
    bend = if n < 0.0: n * 1.4 else: n * 1.9
    turn = if n > 0.2 and n < 0.95: side * 1.3 * smoothstep(0.2, 0.6, n) else: 0.0
    stretch = if n > 0.0: 1.0 - n * 0.35 else: 1.0
    bend -= g.tip * 1.1
    neck = body * translation(vec3(0, 0.15, -0.31)) * rotation_y(turn) * rotation_x(bend + 0.1) * scaling(vec3(1, f32(stretch), 1))
    _wl_lists[FW_NECK + g.kind].push(Instance3D(neck, cut))
    # (upended: the feet out behind, paddling at the surface to hold it there)
    if g.tip > 0.5 and not flying and near:
        loop k in 0..2:
            sd = if k == 0: 1.0 else: -1.0
            kick = sin(t * 8.0 + g.seed * 20.0 + f64(k) * PI) * 0.7
            foot = base * translation(vec3(f32(sd * 0.08), 0.01, 0.22)) * rotation_y(sd * 0.5 + PI) * rotation_x(kick)
            _wl_lists[FW_FEET].push(Instance3D(foot, vec4(FOWL_FEET[g.kind].xyz, f32(level - 0.02))))
    if g.beat > 0.03 and (near or running or flying):
        a = g.beat * (0.1 + 0.8 * sin(g.flap)) + (1.0 - g.beat) * 0.6
        # (afloat and not running: a stretch of the wings, preening)
        if not flying and not running: a = 0.4 + g.beat * 0.6 * (0.5 + 0.5 * sin(g.flap))
        loop k in 0..2:
            sd = if k == 0: 1.0 else: -1.0
            _wl_lists[FW_WING + g.kind * 2 + k].push(Instance3D(body * translation(vec3(f32(sd * 0.09), 0.17, -0.07)) * rotation_z(sd * a), cut))

_pose_gull = (g: Gull, origin: vec3, t: f64, wings: bool = true):
    base = translation(g.pos - origin) * rotation_y(g.yaw + PI) * scaling(vec3(1.2, 1.2, 1.2))
    if g.act == .perch:
        _wl_lists[WL_GULL_PERCHED].push(Instance3D(base * rotation_y(g.look * 0.25), ONE))
        if g.squabble > 0.0 or g.beat > 0.05:
            a = 0.5 + 0.6 * sin(g.flap)
            loop k in 0..2:
                s = if k == 0: 1.0 else: -1.0
                _wl_lists[WL_GULL_WING_R + k].push(Instance3D(base * translation(vec3(f32(s * 0.04), 0.24, -0.02)) * rotation_z(s * a), ONE))
        return
    climb = f64(g.vel.y) / max(1.0, f64(length(g.vel)))
    pitch = clamp(climb, -0.4, 0.5) + (if g.act == .land and g.beat > 0.8: 0.5 else: 0.0)
    body = base * rotation_z(g.bank) * rotation_x(pitch)
    _wl_lists[WL_GULL].push(Instance3D(body, ONE))
    if not wings: return
    a = g.beat * 0.6 * sin(g.flap) + (1.0 - g.beat) * 0.1
    loop k in 0..2:
        s = if k == 0: 1.0 else: -1.0
        _wl_lists[WL_GULL_WING_R + k].push(Instance3D(body * translation(vec3(f32(s * 0.04), 0.03, -0.02)) * rotation_z(s * a), ONE))

_pose_beast = (e: Beast, sheep: bool, origin: vec3):
    coat = if sheep: SHEEP_COATS[e.coat % 4] else: GOAT_COATS[e.coat % 4]
    base = translation(e.pos - origin + vec3(0, f32(-0.42 * e.low), 0)) * rotation_y(e.yaw + PI)
    _wl_lists[if sheep: WL_SHEEP else: WL_GOAT].push(Instance3D(base, vec4(coat.xyz, -100000)))
    neck = if sheep: vec3(0, 0.66, -0.36) else: vec3(0, 0.74, -0.44)
    nod = -e.head * (if sheep: 1.0 else: 1.15) + sin(e.stride * 2.0) * 0.04
    _wl_lists[if sheep: WL_SHEEP_HEAD else: WL_GOAT_HEAD].push(Instance3D(base * translation(neck) * rotation_x(nod), if sheep: ONE else: vec4(coat.xyz, -100000)))
    if e.low > 0.6: return
    swing = sin(e.stride * TAU) * (if e.act == .run: 0.7 else: 0.4) * (if e.act == .walk or e.act == .run: 1.0 else: 0.15)
    loop k in 0..4:
        x = if k % 2 == 0: 0.09 else: -0.09
        z = if k < 2: (if sheep: -0.27 else: -0.32) else: (if sheep: 0.27 else: 0.32)
        phase = if k == 0 or k == 3: 1.0 else: -1.0
        hip = if sheep: 0.48 else: 0.52
        leg = base * translation(vec3(f32(x), f32(hip), f32(z))) * rotation_x(swing * phase)
        _wl_lists[if sheep: WL_SHEEP_LEG else: WL_GOAT_LEG].push(Instance3D(leg, if sheep: ONE else: vec4(coat.xyz, -100000)))

draw_wildlife = (wl: Wildlife, L: Light, t: f64):
    if wl.rafts.len() == 0 and wl.colonies.len() == 0 and wl.herds.len() == 0: return
    if not wild_view_ready: _wild_view_init()
    cam = scene_camera(); origin = render_origin(cam)
    low = render_quality.tier == 0
    far_goose = if low: 260.0 else: 650.0
    far_gull = if low: 350.0 else: 800.0
    far_beast = if low: 250.0 else: 550.0
    loop k in 0.._wl_lists.len(): clear(_wl_lists[k])
    loop r in wl.rafts:
        # (the swell under the raft taken once; each bird's own only close to the camera)
        raft_swell = if not r.site.inland and _flat_d(r.centre, cam) < 180.0: f64(swell_at(f64(r.centre.x), f64(r.centre.z), t).x) else: 0.0
        loop g in r.geese:
            d = f64(length(g.pos - cam))
            if d >= far_goose * (0.5 + 0.5 * FOWL_SIZE[g.kind]) or g.under >= 0.98: continue
            # (on the low tier the small ones go first: ducks and coots past 150 m, goslings past 100)
            if low and ((g.kind != FOWL_GREYLAG and d > 150.0) or (g.young and d > 100.0)): continue
            flying = g.act == .fly or (g.act == .run and f64(g.pos.y) > r.site.level + 0.05)
            # (on the sea, near enough to see it, each rides the swell the sea is drawn with)
            level = if flying or r.site.inland: r.site.level else: r.site.level + (if d < 30.0: f64(swell_at(f64(g.pos.x), f64(g.pos.z), t).x) else: raft_swell)
            _pose_fowl(g, level, origin, t, flying, g.act == .run or g.act == .fly, d < 60.0)
    loop c in wl.colonies:
        loop g in c.gulls:
            dg = f64(length(g.pos - cam))
            if dg < far_gull: _pose_gull(g, origin, t, not low or dg < 150.0)
    loop h in wl.herds:
        if f64(length(h.centre.xz - cam.xz)) > far_beast + 40.0: continue
        loop e in h.beasts:
            if f64(length(e.pos - cam)) < far_beast: _pose_beast(e, h.site.species == 1, origin)
    p = local_instance_params(L, t)
    loop k in 0.._wl_lists.len():
        if _wl_lists[k].len() > 0: draw_instanced(wild_sh, _wl_mesh(wild_meshes, k), _wl_lists[k], p)

_wl_wakes: Instance3D[]
_wl_rings: Instance3D[]

# The rings and wakes on the water (in the transparent pass, with the other wakes).
draw_wildlife_marks = (wl: Wildlife, L: Light):
    if wl.marks.len() == 0 or not wild_view_ready: return
    global _wl_wakes, _wl_rings
    cam = scene_camera(); origin = render_origin(cam)
    clear(_wl_wakes); clear(_wl_rings)
    far = if render_quality.tier == 0: 80.0 else: 450.0
    loop m in wl.marks:
        if f64(length(m.pos - cam)) > far: continue
        age = wl.time - m.born
        at = translation(m.pos - origin + vec3(0, 0.035, 0))
        if m.kind == 1:
            fade = pow(max(0.0, 1.0 - age / WILD_MARK_LIFE), 1.6)
            s = 0.45 + age * 0.5
            _wl_wakes.push(Instance3D(at * rotation_y(m.yaw + PI) * scaling(vec3(f32(s), 1, f32(s))), vec4(f32(clamp(m.size * 1.6, 0.25, 0.9) * fade * 0.7), 0, 0, 0)))
        else if m.kind == 0:
            fade = pow(max(0.0, 1.0 - age / WILD_MARK_LIFE), 2.0)
            s = 0.3 + age * 0.3
            _wl_rings.push(Instance3D(at * scaling(vec3(f32(s), 1, f32(s))), vec4(f32(0.65 * fade), 0, 0, 0)))
        else:
            if age > 1.4: continue
            s = m.size * 0.5 + age * 0.9
            _wl_rings.push(Instance3D(at * scaling(vec3(f32(s), 1, f32(s))), vec4(f32(0.85 * (1.0 - age / 1.4)), 0, 0, 0)))
    u = MarkParams(render_view_proj(origin), render_eye(origin), L.sun, L.sky_top, L.haze, f32(L.fog_density))
    if _wl_wakes.len() > 0: draw_instanced(wild_mark_sh, wild_meshes.wake, _wl_wakes, u)
    if _wl_rings.len() > 0: draw_instanced(wild_mark_sh, wild_meshes.ring, _wl_rings, u)
