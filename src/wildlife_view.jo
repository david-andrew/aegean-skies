# The wildlife drawn (src/wildlife.jo): greylags, mallards, coots, gulls, goats and sheep, each a few painted low-poly
# parts made here in code and posed every frame (a goose's body tipping up to feed and its neck,
# the wings beating, a goat's head down to the grass and its legs swinging), every part of every
# animal near the camera in one instanced draw (each cut at its waterline: wild_fs); and the rings and little wakes they leave on the
# water, one more instanced draw each in the transparent pass. Nothing is drawn, and nothing is
# posed, when none are near.

use 'look.jo'
use 'render_space.jo'
use 'depth_space.jo'
use 'objects.jo'
use 'quality.jo'
use 'sea.jo'
use 'wildlife.jo'

struct WildMeshes:
    fowl: Mesh[]                    # FW_* (waterfowl bodies, necks, wings and feet)
    gull_perched: Mesh
    gull_body: Mesh
    gull_wing: Mesh[]
    goat_body: Mesh
    goat_head: Mesh
    goat_leg: Mesh
    sheep_body: Mesh
    sheep_head: Mesh
    sheep_leg: Mesh
    wake: Mesh
    ring: Mesh
    ready = false

# the waterfowl's meshes in WildMeshes.fowl: a body for each kind (wildlife.jo FOWL_*) and the
# goslings', a neck segment for each kind (two to a neck), a head for each kind, each kind's two
# wings, and a webbed foot
const FW_BODY = 0
const FW_GOSLING = 4
const FW_NECK = 5
const FW_HEAD = 9
const FW_WING = 13
const FW_FEET = 21
const FW_COUNT = 22
# each kind's neck segment, in a greylag's frame (two make the neck)
NECK_LEN = [0.15, 0.085, 0.085, 0.07]

# (both faces of a thin wing: it is seen from above and below)
_wtri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    vs.push(Vertex3D(a, n, vec2(0, 0), col)); vs.push(Vertex3D(b, n, vec2(0, 0), col)); vs.push(Vertex3D(c, n, vec2(0, 0), col))
    vs.push(Vertex3D(a, -n, vec2(0, 0), col)); vs.push(Vertex3D(c, -n, vec2(0, 0), col)); vs.push(Vertex3D(b, -n, vec2(0, 0), col))

# A wing from its root at the shoulder out along x (side +1 right, -1 left): the inner part, the
# hand, and the dark tips of the long feathers. Lengths in metres; nose toward -z.
_wing = (side: f64, span: f64, chord: f64, inner: vec4, outer: vec4, tip: vec4) -> Mesh:
    vs: Vertex3D[]
    s = f32(side); w = f32(span); c = f32(chord)
    root_f = vec3(0, 0, -c * 0.45); root_b = vec3(0, 0, c * 0.55)
    mid_f = vec3(s * w * 0.45, 0.02, -c * 0.42); mid_b = vec3(s * w * 0.45, 0.02, c * 0.5)
    hand_f = vec3(s * w * 0.78, 0.0, -c * 0.25); hand_b = vec3(s * w * 0.78, 0.0, c * 0.42)
    end = vec3(s * w, -0.01, c * 0.18)
    _wtri(vs, root_f, mid_f, root_b, inner); _wtri(vs, mid_f, mid_b, root_b, inner)
    _wtri(vs, mid_f, hand_f, mid_b, outer); _wtri(vs, hand_f, hand_b, mid_b, outer)
    _wtri(vs, hand_f, end, hand_b, tip)
    custom_mesh(vs)

# (a box or a cylinder placed at `at`, then turned there: add_box and add_cylinder turn their own
# centre or base with the transform, so a turned part is moved first and turned in place)
_box = (vs: mut Vertex3D[], at: vec3, size: vec3, col: vec4, turn: mat4 = mat4()):
    add_box(vs, vec3(0, 0, 0), size, col, translation(at) * turn)
_cyl = (vs: mut Vertex3D[], at: vec3, r0: f64, h: f64, col: vec4, seg: int, r1: f64, turn: mat4 = mat4()):
    add_cylinder(vs, vec3(0, 0, 0), r0, h, col, seg, r1, translation(at) * turn)

# (an ellipsoid of few facets: the painted look wants no more, and a raft is many birds)
_ell = (vs: mut Vertex3D[], at: vec3, size: vec3, col: vec4, seg: int = 8, rings: int = 5, turn: mat4 = mat4()):
    add_sphere(vs, vec3(0, 0, 0), 1.0, col, max(5, seg - 2), max(2, rings - 1), translation(at) * turn * scaling(size))

# The waterfowl, each in a greylag's frame (wildlife.jo FOWL_SIZE scales them): waterline at
# y = 0, nose toward -z, the neck's root at (0, 0.15, -0.31), the shoulders at (+-0.09, 0.17, -0.07).
_fowl_meshes = () -> Mesh[]:
    out: Mesh[]
    white = rgb(0.95, 0.94, 0.9); black = rgb(0.07, 0.07, 0.075)
    # greylag: grey-brown, the flanks barred darker, the folded wing scalloped with pale edges, a
    # pale grey rump over a white stern, a thick grey-brown neck and an orange bill
    gb = rgb(0.5, 0.46, 0.4); gbreast = rgb(0.68, 0.65, 0.58); gflank = rgb(0.4, 0.36, 0.31)
    gwing = rgb(0.43, 0.4, 0.36); gedge = rgb(0.74, 0.72, 0.66); orange = rgb(0.93, 0.55, 0.24)
    b: Vertex3D[]
    _ell(b, vec3(0, 0.07, 0.0), vec3(0.18, 0.15, 0.37), gb, 9, 6)
    _ell(b, vec3(0, 0.07, -0.19), vec3(0.165, 0.14, 0.21), gbreast)
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        _ell(b, vec3(sx * 0.13, 0.06, 0.04), vec3(0.06, 0.05, 0.25), gflank, 6, 3)
        _ell(b, vec3(sx * 0.105, 0.12, 0.07), vec3(0.085, 0.07, 0.29), gwing, 7, 4, rotation_y(side * 0.07))
        loop k in 0..3:
            _ell(b, vec3(sx * 0.125, f32(0.135 - f64(k) * 0.012), f32(0.0 + f64(k) * 0.09)), vec3(0.07, 0.012, 0.05), gedge, 5, 2, rotation_y(side * 0.07))
    _ell(b, vec3(0, 0.15, 0.28), vec3(0.1, 0.05, 0.1), rgb(0.78, 0.78, 0.76))
    _ell(b, vec3(0, 0.08, 0.34), vec3(0.12, 0.1, 0.11), white)
    _ell(b, vec3(0, 0.15, 0.42), vec3(0.075, 0.035, 0.085), rgb(0.46, 0.43, 0.39), 6, 3)
    _ell(b, vec3(0, 0.155, 0.48), vec3(0.06, 0.02, 0.03), white, 6, 3)
    out.push(custom_mesh(b))
    # mallard drake: a grey body, chestnut breast, black stern and curled tail feathers, white tail,
    # the blue wing patch showing on the folded wing
    blue = rgb(0.2, 0.32, 0.78)
    d: Vertex3D[]
    _ell(d, vec3(0, 0.07, 0.0), vec3(0.17, 0.13, 0.36), rgb(0.72, 0.72, 0.7), 9, 6)
    _ell(d, vec3(0, 0.08, -0.2), vec3(0.15, 0.13, 0.17), rgb(0.42, 0.24, 0.15))
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        _ell(d, vec3(sx * 0.1, 0.12, 0.08), vec3(0.08, 0.06, 0.26), rgb(0.5, 0.45, 0.38), 7, 4, rotation_y(side * 0.07))
        _ell(d, vec3(sx * 0.13, 0.12, 0.14), vec3(0.035, 0.03, 0.07), blue, 5, 3)
    _ell(d, vec3(0, 0.1, 0.3), vec3(0.11, 0.1, 0.11), black)
    _ell(d, vec3(0, 0.14, 0.41), vec3(0.08, 0.03, 0.07), rgb(0.88, 0.88, 0.86), 6, 3)
    _box(d, vec3(0, 0.2, 0.36), vec3(0.025, 0.06, 0.025), black, rotation_x(0.7))
    # (the white collar at the root of the green neck)
    _ell(d, vec3(0, 0.155, -0.31), vec3(0.06, 0.016, 0.06), white, 7, 3)
    out.push(custom_mesh(d))
    # mallard duck: mottled browns, the same blue patch
    h: Vertex3D[]
    hb = rgb(0.56, 0.44, 0.3); hdark = rgb(0.38, 0.29, 0.2)
    _ell(h, vec3(0, 0.07, 0.0), vec3(0.17, 0.13, 0.36), hb, 9, 6)
    _ell(h, vec3(0, 0.08, -0.2), vec3(0.15, 0.13, 0.17), rgb(0.62, 0.5, 0.36))
    loop side in [-1.0, 1.0]:
        sx = f32(side)
        _ell(h, vec3(sx * 0.1, 0.12, 0.08), vec3(0.08, 0.06, 0.26), hdark, 7, 4, rotation_y(side * 0.07))
        _ell(h, vec3(sx * 0.13, 0.12, 0.14), vec3(0.035, 0.03, 0.07), blue, 5, 3)
        loop k in 0..3:
            _ell(h, vec3(sx * 0.15, 0.05, f32(-0.12 + f64(k) * 0.11)), vec3(0.03, 0.025, 0.04), hdark, 5, 2)
    _ell(h, vec3(0, 0.12, 0.38), vec3(0.08, 0.03, 0.08), rgb(0.66, 0.56, 0.42), 6, 3)
    out.push(custom_mesh(h))
    # coot: a round slate-black body, a small tail
    c: Vertex3D[]
    _ell(c, vec3(0, 0.08, 0.02), vec3(0.2, 0.17, 0.34), rgb(0.13, 0.13, 0.15), 9, 6)
    _ell(c, vec3(0, 0.13, 0.33), vec3(0.08, 0.05, 0.07), rgb(0.1, 0.1, 0.11), 6, 3)
    out.push(custom_mesh(c))
    # goslings: olive-yellow down, a darker crown
    g: Vertex3D[]
    _ell(g, vec3(0, 0.05, 0.02), vec3(0.075, 0.06, 0.13), rgb(0.7, 0.68, 0.4))
    _ell(g, vec3(0, 0.12, -0.11), vec3(0.042, 0.042, 0.045), rgb(0.55, 0.52, 0.3), 6, 4)
    add_box(g, vec3(0, 0.115, -0.16), vec3(0.016, 0.014, 0.03), rgb(0.25, 0.25, 0.22))
    out.push(custom_mesh(g))
    # the neck segments, each up along y from its joint (a ball at its top joint so the bends close)
    gneck = rgb(0.47, 0.43, 0.37); green = rgb(0.08, 0.3, 0.17); slate = rgb(0.11, 0.11, 0.12)
    loop k in 0..4:
        col = [gneck, green, hb, slate][k]
        r0 = [0.054, 0.05, 0.05, 0.065][k]; r1 = [0.046, 0.046, 0.046, 0.058][k]
        len = NECK_LEN[k]
        n: Vertex3D[]
        _cyl(n, vec3(0, -0.012, 0), r0, len + 0.012, col, 7, r1)
        add_sphere(n, vec3(0, f32(len), 0), r1, col, 6, 3)
        out.push(custom_mesh(n))
    # the heads, from the top of the neck, the bill toward -z
    h0: Vertex3D[]
    _ell(h0, vec3(0, 0.03, -0.035), vec3(0.046, 0.05, 0.085), gneck, 7, 4)
    _box(h0, vec3(0, 0.022, -0.135), vec3(0.03, 0.026, 0.075), orange)
    _box(h0, vec3(0, 0.02, -0.175), vec3(0.022, 0.02, 0.012), rgb(0.9, 0.85, 0.75))
    loop side in [-1.0, 1.0]: _box(h0, vec3(f32(side * 0.04), 0.045, -0.05), vec3(0.012, 0.012, 0.012), black)
    out.push(custom_mesh(h0))
    h1: Vertex3D[]
    _ell(h1, vec3(0, 0.035, -0.035), vec3(0.06, 0.064, 0.085), green, 7, 4)
    _box(h1, vec3(0, 0.022, -0.14), vec3(0.04, 0.02, 0.095), rgb(0.88, 0.82, 0.32))
    out.push(custom_mesh(h1))
    h2: Vertex3D[]
    _ell(h2, vec3(0, 0.035, -0.035), vec3(0.06, 0.064, 0.085), rgb(0.6, 0.48, 0.34), 7, 4)
    _ell(h2, vec3(0, 0.075, -0.035), vec3(0.04, 0.03, 0.08), hdark, 6, 3)
    _box(h2, vec3(0, 0.022, -0.14), vec3(0.04, 0.02, 0.095), rgb(0.75, 0.5, 0.25))
    out.push(custom_mesh(h2))
    h3: Vertex3D[]
    _ell(h3, vec3(0, 0.04, -0.02), vec3(0.065, 0.07, 0.08), rgb(0.08, 0.08, 0.09), 7, 4)
    _box(h3, vec3(0, 0.035, -0.11), vec3(0.035, 0.035, 0.07), rgb(0.95, 0.95, 0.92))
    _box(h3, vec3(0, 0.08, -0.08), vec3(0.03, 0.06, 0.02), rgb(0.95, 0.95, 0.92))
    out.push(custom_mesh(h3))
    # wings: the greylag's pale grey forewing, the mallard's blue band, the coot's dark slate
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.82, 0.3, gwing, rgb(0.66, 0.67, 0.66), rgb(0.25, 0.24, 0.23)))
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.74, 0.26, blue, rgb(0.48, 0.46, 0.42), rgb(0.32, 0.3, 0.28)))
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.74, 0.26, blue, rgb(0.5, 0.42, 0.32), rgb(0.34, 0.28, 0.22)))
    loop side in [1.0, -1.0]: out.push(_wing(side, 0.62, 0.26, rgb(0.17, 0.17, 0.19), rgb(0.15, 0.15, 0.17), rgb(0.12, 0.12, 0.13)))
    # a webbed foot on its short leg (its colour the instance's: pink, orange or green-grey)
    f: Vertex3D[]
    pale = rgb(1.0, 1.0, 1.0)
    add_box(f, vec3(0, 0.05, 0), vec3(0.02, 0.1, 0.02), pale)
    _wtri(f, vec3(0, 0, 0.01), vec3(-0.05, 0, -0.1), vec3(0.05, 0, -0.1), pale)
    _wtri(f, vec3(-0.05, 0, -0.1), vec3(0, 0, -0.07), vec3(0.05, 0, -0.1), pale)
    out.push(custom_mesh(f))
    out

FOWL_FEET = [rgb(0.9, 0.62, 0.6), rgb(0.95, 0.55, 0.15), rgb(0.95, 0.55, 0.15), rgb(0.5, 0.56, 0.36)]

build_wild_meshes = () -> WildMeshes:
    white = rgb(0.95, 0.94, 0.9)
    # gulls: white with a grey back, black wing tips, a yellow bill, pink legs
    gwhite = rgb(0.96, 0.96, 0.94); grey = rgb(0.6, 0.65, 0.7); tipc = rgb(0.12, 0.12, 0.14); bill = rgb(0.92, 0.75, 0.2)
    p: Vertex3D[]
    _ell(p, vec3(0, 0.2, 0.02), vec3(0.07, 0.072, 0.18), gwhite)
    _ell(p, vec3(0, 0.235, 0.06), vec3(0.074, 0.04, 0.16), grey, 7, 4)
    add_box(p, vec3(0, 0.235, 0.21), vec3(0.05, 0.026, 0.13), tipc)
    # (a short thick neck joining the head to the breast)
    _ell(p, vec3(0, 0.255, -0.1), vec3(0.05, 0.06, 0.05), gwhite, 7, 4)
    _ell(p, vec3(0, 0.3, -0.13), vec3(0.046, 0.048, 0.055), gwhite, 7, 4)
    add_box(p, vec3(0, 0.292, -0.19), vec3(0.016, 0.016, 0.06), bill)
    loop side in [-1.0, 1.0]:
        add_box(p, vec3(f32(side * 0.025), 0.065, 0.0), vec3(0.014, 0.13, 0.014), rgb(0.85, 0.6, 0.55))
    gull_perched = custom_mesh(p)
    f: Vertex3D[]
    _ell(f, vec3(0, 0, 0.0), vec3(0.068, 0.068, 0.2), gwhite)
    _ell(f, vec3(0, 0.03, -0.19), vec3(0.042, 0.044, 0.05), gwhite, 7, 4)
    add_box(f, vec3(0, 0.025, -0.25), vec3(0.015, 0.015, 0.055), bill)
    add_box(f, vec3(0, 0.01, 0.22), vec3(0.08, 0.014, 0.08), gwhite)
    gull_body = custom_mesh(f)
    gull_wing = [loop side in [1.0, -1.0]: _wing(side, 0.62, 0.2, grey, grey, tipc)]
    # goats (their coat the instance's colour): lean and long-legged, a deep chest and a level back,
    # a short tail cocked up at the rump; a long head on a slim neck with ears hanging out to the
    # sides, horns sweeping back, and a beard; slim legs with dark hooves. Ground at y = 0, nose -z.
    coat = rgb(1.0, 1.0, 1.0); horn = rgb(0.3, 0.27, 0.23); hoof = rgb(0.16, 0.14, 0.12); dark = rgb(0.2, 0.18, 0.16)
    gb: Vertex3D[]
    _ell(gb, vec3(0, 0.6, 0.02), vec3(0.17, 0.21, 0.4), coat, 9, 6)
    _ell(gb, vec3(0, 0.62, -0.28), vec3(0.16, 0.22, 0.17), coat, 8, 5)
    _ell(gb, vec3(0, 0.65, 0.3), vec3(0.15, 0.17, 0.14), coat, 8, 5)
    _box(gb, vec3(0, 0.76, 0.45), vec3(0.04, 0.12, 0.035), coat, rotation_x(-0.55))
    goat_body = custom_mesh(gb)
    # (the head and neck, about the neck's root at (0, 0.72, -0.38) on the body)
    gh: Vertex3D[]
    _cyl(gh, vec3(0, -0.02, 0), 0.075, 0.3, coat, 7, 0.055, rotation_x(-0.5))
    _ell(gh, vec3(0, 0.3, -0.17), vec3(0.06, 0.07, 0.09), coat, 7, 4)
    _ell(gh, vec3(0, 0.255, -0.285), vec3(0.042, 0.05, 0.09), coat, 7, 4, rotation_x(0.35))
    loop side in [-1.0, 1.0]:
        sd = f32(side)
        # ears hanging out and down
        _box(gh, vec3(sd * 0.085, 0.285, -0.15), vec3(0.1, 0.018, 0.04), coat, rotation_z(side * -0.55))
        # horns: a root rising back from the poll and a tip sweeping on back and out
        _cyl(gh, vec3(sd * 0.03, 0.35, -0.16), 0.021, 0.1, horn, 5, 0.016, rotation_z(side * -0.15) * rotation_x(0.75))
        _cyl(gh, vec3(sd * 0.042, 0.43, -0.095), 0.016, 0.1, horn, 5, 0.0, rotation_z(side * -0.3) * rotation_x(1.5))
        _box(gh, vec3(sd * 0.05, 0.315, -0.205), vec3(0.012, 0.014, 0.014), dark)
    _box(gh, vec3(0, 0.17, -0.3), vec3(0.03, 0.09, 0.03), dark, rotation_x(0.2))
    goat_head = custom_mesh(gh)
    # (a leg hanging from its hip: thigh and shank, a dark hoof)
    gl: Vertex3D[]
    _box(gl, vec3(0, -0.13, 0), vec3(0.06, 0.26, 0.07), coat)
    _box(gl, vec3(0, -0.37, 0.005), vec3(0.04, 0.24, 0.045), coat)
    _box(gl, vec3(0, -0.495, -0.005), vec3(0.045, 0.035, 0.055), hoof)
    goat_leg = custom_mesh(gl)
    # sheep: a round, deep fleece (the instance's colour) hanging low over the legs, lumpy along the
    # back and flanks, a woolly tail hanging at the rump; a short pale face with dark patches about
    # the eyes, a wool cap, ears out sideways; thin legs. Ground at y = 0, nose -z.
    sb: Vertex3D[]
    _ell(sb, vec3(0, 0.56, 0.0), vec3(0.26, 0.26, 0.42), coat, 9, 6)
    _ell(sb, vec3(0, 0.56, -0.3), vec3(0.23, 0.25, 0.16), coat, 8, 5)
    _ell(sb, vec3(0, 0.58, 0.3), vec3(0.24, 0.24, 0.16), coat, 8, 5)
    loop k in 0..6:
        z = f32(-0.3 + f64(k) * 0.12)
        _ell(sb, vec3(0, 0.77, z), vec3(0.14, 0.08, 0.1), coat, 6, 3)
        loop side in [-1.0, 1.0]:
            _ell(sb, vec3(f32(side * 0.2), f32(0.6 + f64(k % 2) * 0.06), z + 0.05), vec3(0.09, 0.13, 0.1), coat, 6, 3)
    _ell(sb, vec3(0, 0.43, 0.45), vec3(0.06, 0.13, 0.05), coat, 6, 3)
    sheep_body = custom_mesh(sb)
    face = rgb(0.86, 0.82, 0.74); patch = rgb(0.2, 0.18, 0.17); wool = rgb(0.9, 0.87, 0.78)
    # (about the neck's root at (0, 0.64, -0.38): a short neck in the fleece, the head held low)
    sh: Vertex3D[]
    _cyl(sh, vec3(0, -0.02, 0), 0.1, 0.17, wool, 7, 0.075, rotation_x(-0.75))
    _ell(sh, vec3(0, 0.15, -0.2), vec3(0.06, 0.065, 0.11), face, 7, 4, rotation_x(0.3))
    _ell(sh, vec3(0, 0.2, -0.15), vec3(0.07, 0.05, 0.06), wool, 6, 3)
    loop side in [-1.0, 1.0]:
        sd = f32(side)
        _box(sh, vec3(sd * 0.085, 0.18, -0.15), vec3(0.08, 0.02, 0.035), face, rotation_z(side * -0.25))
        _box(sh, vec3(sd * 0.045, 0.165, -0.24), vec3(0.03, 0.025, 0.03), patch)
    _box(sh, vec3(0, 0.1, -0.3), vec3(0.04, 0.03, 0.03), patch)
    sheep_head = custom_mesh(sh)
    sl: Vertex3D[]
    _box(sl, vec3(0, -0.19, 0), vec3(0.05, 0.38, 0.055), rgb(0.35, 0.32, 0.29))
    _box(sl, vec3(0, -0.385, -0.005), vec3(0.052, 0.03, 0.06), hoof)
    sheep_leg = custom_mesh(sl)
    # the marks on the water: a wake's two arms opening back from its apex, and a ring
    wv: Vertex3D[]
    up = vec3(0, 1, 0)
    loop side in [-1.0, 1.0]:
        a = 0.34 * side
        d = vec3(f32(sin(a)), 0, f32(cos(a))); across = vec3(d.z, 0, -d.x) * 0.035
        loop k in 0..4:
            u0 = f32(f64(k) / 4.0); u1 = f32(f64(k + 1) / 4.0)
            a0 = d * u0; a1 = d * u1
            wv.push(Vertex3D(a0 - across, up, vec2(u0, -1), white)); wv.push(Vertex3D(a1 - across, up, vec2(u1, -1), white)); wv.push(Vertex3D(a1 + across, up, vec2(u1, 1), white))
            wv.push(Vertex3D(a0 - across, up, vec2(u0, -1), white)); wv.push(Vertex3D(a1 + across, up, vec2(u1, 1), white)); wv.push(Vertex3D(a0 + across, up, vec2(u0, 1), white))
    rv: Vertex3D[]
    loop k in 0..20:
        a0 = f64(k) * TAU / 20.0; a1 = f64(k + 1) * TAU / 20.0
        i0 = vec3(f32(cos(a0) * 0.88), 0, f32(sin(a0) * 0.88)); o0 = vec3(f32(cos(a0) * 1.12), 0, f32(sin(a0) * 1.12))
        i1 = vec3(f32(cos(a1) * 0.88), 0, f32(sin(a1) * 0.88)); o1 = vec3(f32(cos(a1) * 1.12), 0, f32(sin(a1) * 1.12))
        rv.push(Vertex3D(i0, up, vec2(0.2, -1), white)); rv.push(Vertex3D(o1, up, vec2(0.2, 1), white)); rv.push(Vertex3D(o0, up, vec2(0.2, 1), white))
        rv.push(Vertex3D(i0, up, vec2(0.2, -1), white)); rv.push(Vertex3D(i1, up, vec2(0.2, -1), white)); rv.push(Vertex3D(o1, up, vec2(0.2, 1), white))
    WildMeshes(_fowl_meshes(), gull_perched, gull_body, gull_wing, goat_body, goat_head, goat_leg, sheep_body, sheep_head, sheep_leg, custom_mesh(wv), custom_mesh(rv), true)

GOAT_COATS = [rgb(0.55, 0.38, 0.24), rgb(0.17, 0.15, 0.14), rgb(0.9, 0.88, 0.82), rgb(0.5, 0.45, 0.4)]
SHEEP_COATS = [rgb(0.93, 0.9, 0.8), rgb(0.86, 0.82, 0.7), rgb(0.8, 0.77, 0.7), rgb(0.22, 0.2, 0.19)]

# ---------------- the marks' shader ----------------

struct MarkParams:
    view_proj: mat4
    cam: vec3
    sun: vec3
    sky: vec3
    haze: vec3
    fog: f32
    # the sea's six swells as it is drawn with them (sea.jo swell_at): each one's wave vector, its
    # phase at the render origin now (worked out in f64), and its height
    wave_a: vec4
    wave_b: vec4
    wave_c: vec4
    phase_a: vec4
    phase_b: vec4
    height_a: vec4
    height_b: vec4

struct MarkOut:
    pos: vec4
    world: vec3
    data: vec4

# A mark on the sea rides the swell the sea is drawn with, each corner lifted by the six waves
# there (inst.color.y 1: on the sea; lakes and rivers lie flat). The sea's own broad triangles
# can still stand a few centimetres above the true waves, so the mark is also slid toward the eye
# along its line of sight by that much (at most 0.1 m: never in front of a bird it rings). It
# stays where it was on the screen, and no triangle's straight edge cuts it.
_mark_swell = (p: vec2, u: MarkParams) -> f32:
    h = sin(dot(u.wave_a.xy, p) + u.phase_a.x) * u.height_a.x
    h += sin(dot(u.wave_a.zw, p) + u.phase_a.y) * u.height_a.y
    h += sin(dot(u.wave_b.xy, p) + u.phase_a.z) * u.height_a.z
    h += sin(dot(u.wave_b.zw, p) + u.phase_a.w) * u.height_a.w
    h += sin(dot(u.wave_c.xy, p) + u.phase_b.x) * u.height_b.x
    h + sin(dot(u.wave_c.zw, p) + u.phase_b.y) * u.height_b.y

mark_vs = (v: Vertex3D, inst: Instance3D, u: MarkParams) -> MarkOut:
    w = inst.model * vec4(v.pos, 1)
    p = w.xyz + vec3(0, _mark_swell(w.xz, u) * inst.color.y, 0)
    to_eye = u.cam - p
    far = max(length(to_eye), 0.001)
    rise = max(to_eye.y / far, 0.05)
    p = p + to_eye / far * min(0.025 / rise, 0.1)
    MarkOut(u.view_proj * vec4(p, 1), p, vec4(v.uv.x, v.uv.y, inst.color.x, 0))

# (every edge of a mark fades to nothing: a wake's arms across and toward their ends, and in at
# the apex; a ring across its band, so no straight edge of the quads shows from any side)
mark_fs_log = (i: MarkOut, u: MarkParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    mark_fs(i, u)

mark_fs = (i: MarkOut, u: MarkParams) -> vec4:
    a = (1.0 - smoothstep(0.3, 1.0, abs(i.data.y))) * i.data.z * (1.0 - smoothstep(0.45, 1.0, i.data.x)) * smoothstep(0.0, 0.08, i.data.x)
    if a < 0.01: discard()
    c = vec3(0.96, 0.98, 1.0) * (u.sun * 0.8 + u.sky * 0.35)
    vec4(aerial(c, i.world, u.cam, u.haze, u.fog), a)

# ---------------- the animals' shader ----------------
# The objects' painted light (objects.jo), with each instance's colour a tint and its alpha the
# height below which it is not drawn: a bird afloat is cut at its waterline, so what is under the
# water (a feeding bird's head and neck, its front half upended, a diving coot) is hidden, as
# through the surface it is in life; animals on land and in the air are never cut.
wild_vs = (v: Vertex3D, inst: Instance3D, u: ObjParams) -> ObjOut:
    w = render_model(inst.model, u.instance_origin) * vec4(v.pos, 1)
    ObjOut(u.view_proj * w, w.xyz, (inst.model * vec4(v.normal, 0)).xyz, vec4(v.color.xyz * inst.color.xyz, inst.color.w))

wild_fs_log = (i: ObjOut, u: ObjParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    wild_fs(i, u)

wild_fs = (i: ObjOut, u: ObjParams) -> vec4:
    if i.world.y < i.color.w: discard()
    o = ObjOut(i.pos, i.world, i.normal, vec4(i.color.xyz, 1.0))
    n = normalize(i.normal)
    obj_finish_light(obj_base_light(o, u, n, dot(n, normalize(u.sun_dir))), o, u, n)

wild_sh: Shader
wild_mark_sh: Shader
wild_meshes: WildMeshes = WildMeshes()
wild_view_ready = false

# (made the first time animals are near, not at the start)
# Each of the two programs takes about a tenth of a second to compile (desktop): made on the
# first frame animals were near, the two together were a visible hitch, flying into a harbour or
# leaving the title. wild_view_warm makes them a piece a frame while the game idles early on (the
# title, the first seconds); drawing finishes whatever is still left.
_wild_view_step = 0
_wild_view_piece = ():
    global wild_mark_sh, wild_sh, wild_meshes, wild_view_ready, _wild_view_step
    if _wild_view_step == 0: wild_mark_sh = make_shader(world_shader(shader(mark_vs, mark_fs), shader(mark_vs, mark_fs_log)))
    else if _wild_view_step == 1: wild_sh = make_shader(world_shader(shader(wild_vs, wild_fs), shader(wild_vs, wild_fs_log)))
    else if _wild_view_step == 2:
        wild_meshes = build_wild_meshes()
        wild_view_ready = true
    _wild_view_step += 1

_wild_view_init = ():
    loop not wild_view_ready: _wild_view_piece()

# (a piece a frame from the 90th frame on, until all are made)
wild_view_warm = ():
    if not wild_view_ready and frame_number() >= 90: _wild_view_piece()

# (for the other animals' drawings: the shader and the shared meshes made once)
wild_view_init = ():
    if not wild_view_ready: _wild_view_init()
# (the sea's swell for drawing what floats in it, near enough to see it ride)
wild_swell = (x: f64, z: f64, t: f64) -> f64: f64(swell_at(x, z, t).x)

# ---------------- posing ----------------

# (kept between frames, cleared each one)
_wl_lists: Instance3D[][] = [loop k in 0..FW_COUNT + 10: []]
const WL_GULL_PERCHED = FW_COUNT
const WL_GULL = FW_COUNT + 1
const WL_GULL_WING_R = FW_COUNT + 2
const WL_GULL_WING_L = FW_COUNT + 3
const WL_GOAT = FW_COUNT + 4
const WL_GOAT_HEAD = FW_COUNT + 5
const WL_GOAT_LEG = FW_COUNT + 6
const WL_SHEEP = FW_COUNT + 7
const WL_SHEEP_HEAD = FW_COUNT + 8
const WL_SHEEP_LEG = FW_COUNT + 9

_wl_mesh = (m: WildMeshes, k: int) -> Mesh:
    if k < FW_COUNT: return m.fowl[k]
    match k - FW_COUNT:
        0: m.gull_perched
        1: m.gull_body
        2: m.gull_wing[0]
        3: m.gull_wing[1]
        4: m.goat_body
        5: m.goat_head
        6: m.goat_leg
        7: m.sheep_body
        8: m.sheep_head
        _: m.sheep_leg

# (a plain instance colour, never cut)
const ONE = vec4(1, 1, 1, -100000)
_flat_d = (a: vec3, b: vec3) -> f64: f64(length(a.xz - b.xz))

# A waterfowl's neck and head, in its body's frame: the lower and the upper segment's lean (0 up,
# + back, - forward), the head's pitch (+ bill up, 0 level) and turn (pi: facing back), and the
# whole neck's turn to one side at its root. A goose holds its neck in an S, the head level.
struct NeckPose:
    lower: f64
    upper: f64
    pitch: f64
    yaw: f64 = 0.0
    turn: f64 = 0.0

NECK_SWIM = NeckPose(-0.16, 0.2, 0.0)
NECK_ALERT = NeckPose(-0.05, 0.05, 0.05)
NECK_FLY = NeckPose(-1.45, -1.45, -0.1)
# (feeding: straight on out along the body, which is tipped tail up, so down into the water)
NECK_FEED = NeckPose(-1.7, -1.9, -0.5)
# (asleep: folded back, the head laid along the back facing the tail, the bill tucked down)
NECK_REST = NeckPose(0.6, 2.3, -0.45, PI)
_neck_mix = (a: NeckPose, b: NeckPose, k: f64) -> NeckPose:
    NeckPose(a.lower + (b.lower - a.lower) * k, a.upper + (b.upper - a.upper) * k, a.pitch + (b.pitch - a.pitch) * k, a.yaw + (b.yaw - a.yaw) * k, a.turn + (b.turn - a.turn) * k)

# The neck as the bird's state has it: swimming, alert (neck up) or stretched out in flight (neck
# below 0), resting or preening (above 0: preening, turned aside and reaching back into the flank),
# and feeding or diving (tip, under).
fowl_neck = (g: Goose) -> NeckPose:
    pose = NECK_SWIM
    n = g.neck
    if n < 0.0:
        pose = _neck_mix(pose, NECK_ALERT, min(1.0, -n / 0.2))
        pose = _neck_mix(pose, NECK_FLY, smoothstep(0.25, 1.0, -n))
    else if n > 0.0:
        side = if g.seed < 0.5: 1.0 else: -1.0
        # (preening: turned out to one side and curving down over the shoulder, the head at the flank
        # facing the tail, the bill in the feathers)
        target = if g.act == .preen: NeckPose(0.3, 2.0, -1.0, side * 2.0, side * 0.9) else: NECK_REST
        pose = _neck_mix(pose, target, min(1.0, n))
    _neck_mix(pose, NECK_FEED, max(g.tip, g.under))

# A bird's body in its own frame (waterline y = 0, nose -z, a greylag's size): level afloat,
# pitched a little climbing in the air, tipped forward about a point aft of its middle to feed,
# sunk away diving.
fowl_body_frame = (g: Goose, flying: bool) -> mat4:
    pitch = if flying: clamp(f64(g.vel.y) * 0.08, -0.15, 0.3) else: 0.0
    translation(vec3(0, f32(-0.07 * g.tip - 0.5 * g.under), 0.1)) * rotation_x(pitch - g.tip * 0.98 - g.under * 0.4) * translation(vec3(0, 0, -0.1))

# Its neck's lower and upper segment and its head, from the body's frame (fowl_neck's pose).
fowl_neck_frames = (g: Goose, body: mat4) -> (mat4, mat4, mat4):
    pose = fowl_neck(g)
    len = f32(NECK_LEN[g.kind])
    lower = body * translation(vec3(0, 0.15, -0.31)) * rotation_y(pose.turn) * rotation_x(pose.lower)
    upper = lower * translation(vec3(0, len, 0)) * rotation_x(pose.upper - pose.lower)
    head = upper * translation(vec3(0, len, 0)) * rotation_x(-pose.upper) * rotation_y(pose.yaw) * rotation_x(pose.pitch)
    (lower, upper, head)

# A waterfowl posed: afloat (cut at its waterline `level`), upended to feed (tipped forward about a
# point a little aft of its middle, front half and head under, the rear third and tail up at about
# 55 degrees, the feet paddling at the surface), diving (gone under), or flying with its wings.
_pose_fowl = (g: Goose, level: f64, origin: vec3, t: f64, flying: bool, running: bool, near: bool):
    wobble = if flying: 0.0 else: sin(t * 1.4 + g.seed * 7.0) * 0.012
    bob = if flying: 0.0 else: wobble + level - f64(g.pos.y)
    s = FOWL_SIZE[g.kind]
    cut = vec4(1, 1, 1, f32(level + wobble * 0.5 - 0.005))
    base = translation(g.pos - origin + vec3(0, f32(bob), 0)) * rotation_y(g.yaw + PI) * scaling(vec3(f32(s), f32(s), f32(s)))
    if g.young:
        _wl_lists[FW_GOSLING].push(Instance3D(base * translation(vec3(0, f32(-0.04 * g.tip), 0)) * rotation_x(-g.tip * 0.9), cut))
        return
    body = base * fowl_body_frame(g, flying)
    _wl_lists[FW_BODY + g.kind].push(Instance3D(body, cut))
    # the neck in two segments from its root, and the head at its top held as the pose has it
    lower, upper, head = fowl_neck_frames(g, body)
    _wl_lists[FW_NECK + g.kind].push(Instance3D(lower, cut))
    _wl_lists[FW_NECK + g.kind].push(Instance3D(upper, cut))
    _wl_lists[FW_HEAD + g.kind].push(Instance3D(head, cut))
    # (upended: the feet out behind, paddling at the surface to hold it there)
    if g.tip > 0.5 and not flying and near:
        loop k in 0..2:
            sd = if k == 0: 1.0 else: -1.0
            kick = sin(t * 8.0 + g.seed * 20.0 + f64(k) * PI) * 0.7
            foot = base * translation(vec3(f32(sd * 0.08), 0.01, 0.22)) * rotation_y(sd * 0.5 + PI) * rotation_x(kick)
            _wl_lists[FW_FEET].push(Instance3D(foot, vec4(FOWL_FEET[g.kind].xyz, f32(level - 0.02))))
    if g.beat > 0.03 and (near or running or flying):
        a = g.beat * (0.1 + 0.8 * sin(g.flap)) + (1.0 - g.beat) * 0.6
        # (afloat and not running: a stretch of the wings, preening)
        if not flying and not running: a = 0.4 + g.beat * 0.6 * (0.5 + 0.5 * sin(g.flap))
        loop k in 0..2:
            sd = if k == 0: 1.0 else: -1.0
            _wl_lists[FW_WING + g.kind * 2 + k].push(Instance3D(body * translation(vec3(f32(sd * 0.09), 0.17, -0.07)) * rotation_z(sd * a), cut))

_pose_gull = (g: Gull, origin: vec3, t: f64, wings: bool = true, level: f64 = 0.0):
    base = translation(g.pos - origin) * rotation_y(g.yaw + PI) * scaling(vec3(1.2, 1.2, 1.2))
    if g.act == .sit:
        # afloat: sitting low, its legs under the water and cut away
        _wl_lists[WL_GULL_PERCHED].push(Instance3D(translation(vec3(0, -0.2, 0)) * base * rotation_y(g.look * 0.25), vec4(1, 1, 1, f32(level - 0.005))))
        return
    if g.act == .perch:
        _wl_lists[WL_GULL_PERCHED].push(Instance3D(base * rotation_y(g.look * 0.25), ONE))
        if g.squabble > 0.0 or g.beat > 0.05:
            a = 0.5 + 0.6 * sin(g.flap)
            loop k in 0..2:
                s = if k == 0: 1.0 else: -1.0
                _wl_lists[WL_GULL_WING_R + k].push(Instance3D(base * translation(vec3(f32(s * 0.04), 0.24, -0.02)) * rotation_z(s * a), ONE))
        return
    climb = f64(g.vel.y) / max(1.0, f64(length(g.vel)))
    pitch = clamp(climb, -0.4, 0.5) + (if g.act == .land and g.beat > 0.8: 0.5 else: 0.0)
    body = base * rotation_z(g.bank) * rotation_x(pitch)
    _wl_lists[WL_GULL].push(Instance3D(body, ONE))
    if not wings: return
    a = g.beat * 0.6 * sin(g.flap) + (1.0 - g.beat) * 0.1
    loop k in 0..2:
        s = if k == 0: 1.0 else: -1.0
        _wl_lists[WL_GULL_WING_R + k].push(Instance3D(body * translation(vec3(f32(s * 0.04), 0.03, -0.02)) * rotation_z(s * a), ONE))

# A goat or a sheep posed: its head and neck nodding down to graze from the neck's root, its legs
# swinging from the hips as it walks or runs, folded away lying down.
_pose_beast = (e: Beast, sheep: bool, origin: vec3):
    coat = if sheep: SHEEP_COATS[e.coat % 4] else: GOAT_COATS[e.coat % 4]
    tint = vec4(coat.xyz, -100000)
    drop = if sheep: 0.3 else: 0.4
    base = translation(e.pos - origin + vec3(0, f32(-drop * e.low), 0)) * rotation_y(e.yaw + PI)
    _wl_lists[if sheep: WL_SHEEP else: WL_GOAT].push(Instance3D(base, tint))
    neck = if sheep: vec3(0, 0.6, -0.38) else: vec3(0, 0.72, -0.38)
    nod = -e.head * (if sheep: 0.95 else: 1.1) + sin(e.stride * 2.0) * 0.04
    _wl_lists[if sheep: WL_SHEEP_HEAD else: WL_GOAT_HEAD].push(Instance3D(base * translation(neck) * rotation_x(nod), tint))
    if e.low > 0.6: return
    swing = sin(e.stride * TAU) * (if e.act == .run: 0.7 else: 0.4) * (if e.act == .walk or e.act == .run: 1.0 else: 0.15)
    loop k in 0..4:
        x = if sheep: (if k % 2 == 0: 0.12 else: -0.12) else: (if k % 2 == 0: 0.085 else: -0.085)
        z = if k < 2: (if sheep: -0.26 else: -0.3) else: (if sheep: 0.26 else: 0.3)
        phase = if k == 0 or k == 3: 1.0 else: -1.0
        hip = if sheep: 0.4 else: 0.5
        leg = base * translation(vec3(f32(x), f32(hip), f32(z))) * rotation_x(swing * phase)
        _wl_lists[if sheep: WL_SHEEP_LEG else: WL_GOAT_LEG].push(Instance3D(leg, if sheep: ONE else: tint))

draw_wildlife = (wl: Wildlife, L: Light, t: f64):
    if wl.rafts.len() == 0 and wl.colonies.len() == 0 and wl.herds.len() == 0: return
    if not wild_view_ready: _wild_view_init()
    cam = scene_camera(); origin = render_origin(cam)
    low = render_quality.tier == 0
    far_goose = if low: 260.0 else: 650.0
    far_gull = if low: 350.0 else: 800.0
    far_beast = if low: 250.0 else: 550.0
    loop k in 0.._wl_lists.len(): clear(_wl_lists[k])
    loop r in wl.rafts:
        # (the swell under the raft taken once; each bird's own only close to the camera)
        raft_swell = if not r.site.inland and _flat_d(r.centre, cam) < 180.0: f64(swell_at(f64(r.centre.x), f64(r.centre.z), t).x) else: 0.0
        loop g in r.geese:
            d = f64(length(g.pos - cam))
            if d >= far_goose * (0.5 + 0.5 * FOWL_SIZE[g.kind]) or g.under >= 0.98: continue
            # (on the low tier the small ones go first: ducks and coots past 150 m, goslings past 100)
            if low and ((g.kind != FOWL_GREYLAG and d > 150.0) or (g.young and d > 100.0)): continue
            flying = g.act == .fly or (g.act == .run and f64(g.pos.y) > r.site.level + 0.05)
            # (on the sea, near enough to see it, each rides the swell the sea is drawn with)
            level = if flying or r.site.inland: r.site.level else: r.site.level + (if d < 30.0: f64(swell_at(f64(g.pos.x), f64(g.pos.z), t).x) else: raft_swell)
            _pose_fowl(g, level, origin, t, flying, g.act == .run or g.act == .fly, d < 60.0)
    loop c in wl.colonies:
        loop g in c.gulls:
            dg = f64(length(g.pos - cam))
            if dg < far_gull: _pose_gull(g, origin, t, not low or dg < 150.0, c.level)
    loop h in wl.herds:
        if f64(length(h.centre.xz - cam.xz)) > far_beast + 40.0: continue
        loop e in h.beasts:
            if f64(length(e.pos - cam)) < far_beast: _pose_beast(e, h.site.species == 1, origin)
    p = local_instance_params(L, t)
    loop k in 0.._wl_lists.len():
        if _wl_lists[k].len() > 0: draw_instanced(wild_sh, _wl_mesh(wild_meshes, k), _wl_lists[k], p)

_wl_wakes: Instance3D[]
_wl_rings: Instance3D[]

# The rings and wakes on the water (in the transparent pass, with the other wakes).
# The sea's swells for the marks (as sea.jo swell_at makes them), their phases taken at `origin`.
_mark_waves = (u: mut MarkParams, origin: vec3, t: f64):
    turns = [0.0, 0.45, -0.5, 0.9, -0.25, 0.2]
    lengths = [61.0, 37.0, 23.0, 13.0, 7.3, 4.1]
    amp = max(0.0, swell_height_bound() - 0.001) / 146.0
    waves: vec2[]; phases: f32[]; heights: f32[]
    loop k in 0..6:
        a = turns[k]; len = lengths[k]; frequency = TAU / len
        dx = f64(wind_now.dir.x) * cos(a) - f64(wind_now.dir.y) * sin(a)
        dz = f64(wind_now.dir.x) * sin(a) + f64(wind_now.dir.y) * cos(a)
        wave = vec2(f32(dx * frequency), f32(dz * frequency))
        phase = f64(wave.x) * f64(origin.x) + f64(wave.y) * f64(origin.z) - t * sqrt(9.8 * frequency)
        waves.push(wave); phases.push(f32(phase - floor(phase / TAU) * TAU)); heights.push(f32(len * amp))
    u.wave_a = vec4(waves[0].x, waves[0].y, waves[1].x, waves[1].y)
    u.wave_b = vec4(waves[2].x, waves[2].y, waves[3].x, waves[3].y)
    u.wave_c = vec4(waves[4].x, waves[4].y, waves[5].x, waves[5].y)
    u.phase_a = vec4(phases[0], phases[1], phases[2], phases[3])
    u.phase_b = vec4(phases[4], phases[5], 0, 0)
    u.height_a = vec4(heights[0], heights[1], heights[2], heights[3])
    u.height_b = vec4(heights[4], heights[5], 0, 0)

draw_wildlife_marks = (wl: Wildlife, L: Light, t: f64):
    if wl.marks.len() == 0 or not wild_view_ready: return
    global _wl_wakes, _wl_rings
    cam = scene_camera(); origin = render_origin(cam)
    clear(_wl_wakes); clear(_wl_rings)
    far = if render_quality.tier == 0: 80.0 else: 450.0
    loop m in wl.marks:
        if f64(length(m.pos - cam)) > far: continue
        age = wl.time - m.born
        at = translation(m.pos - origin + vec3(0, 0.035, 0))
        sea: f32 = if m.pos.y < 0.5: 1.0 else: 0.0
        if m.kind == 1:
            fade = pow(max(0.0, 1.0 - age / WILD_MARK_LIFE), 1.6)
            s = 0.45 + age * 0.5
            _wl_wakes.push(Instance3D(at * rotation_y(m.yaw + PI) * scaling(vec3(f32(s), 1, f32(s))), vec4(f32(clamp((m.size - 0.15) * 2.0, 0.0, 0.9) * fade * 0.7), sea, 0, 0)))
        else if m.kind == 0:
            fade = pow(max(0.0, 1.0 - age / WILD_MARK_LIFE), 2.0)
            s = 0.3 + age * 0.3
            _wl_rings.push(Instance3D(at * scaling(vec3(f32(s), 1, f32(s))), vec4(f32(0.65 * fade), sea, 0, 0)))
        else:
            if age > 1.4: continue
            s = m.size * 0.5 + age * 0.9
            _wl_rings.push(Instance3D(at * scaling(vec3(f32(s), 1, f32(s))), vec4(f32(0.85 * (1.0 - age / 1.4)), sea, 0, 0)))
    u = MarkParams(render_view_proj(origin), render_eye(origin), L.sun, L.sky_top, L.haze, f32(L.fog_density))
    _mark_waves(u, origin, t)
    if _wl_wakes.len() > 0: draw_instanced(wild_mark_sh, wild_meshes.wake, _wl_wakes, u)
    if _wl_rings.len() > 0: draw_instanced(wild_mark_sh, wild_meshes.ring, _wl_rings, u)
