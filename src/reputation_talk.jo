# The pilot's name in what people say and do (docs/reputation.md, "Outputs"): greetings from
# those who have heard of him, remarks on what they heard, a short answer from those who think
# ill of him; whether anyone comes over, and whether they come when asked; a keeper's rounding;
# the wireless; the notebook's lines in words. Read-only on the World except `rep_*_said` marks.
use 'living_types.jo'
use 'life_types.jo'
use 'reputation_types.jo'
use 'reputation.jo'
use 'living_place_context.jo'
use 'errand_words.jo'

const REP_STANDOFFISH = -60           # warmth at which he is known as keeping to himself
const REP_COLD = -300                 # regard at which people give him a short answer

_cap = (s: str) -> str: if s == "": s else: upper(s[0..1])+s[1..]

# "a" or "an" before `word` ("an Orenthian", "a Kalyran", "an island").
_a = (word: str) -> str: if word.len() > 0 and "AEIOUaeiou".contains(word[0..1]): "an {word}" else: "a {word}"

_adj = (w: World, country: int) -> str:
    if country < 0 or country >= w.countries.len(): return "foreign"
    name = w.countries[country].name
    if w.countries[country].key == "archipelago": "island" else: if name.ends_with("a"): name+"n" else: name

_people = (w: World, country: int) -> str:
    if country < 0 or country >= w.countries.len(): return "foreigners"
    if w.countries[country].key == "archipelago": "island men" else: "{_adj(w,country)}s"

_count = (n: int) -> str:
    words = ["no","one","two","three","four","five","six","seven","eight","nine","ten"]
    if n >= 0 and n < words.len(): words[n] else: "{n}"

_who = (w: World, person: int) -> str:
    if person < 0 or person >= w.people.len(): return ""
    split(w.people[person].name," ")[0]

# ---------------- how people talk about him ----------------
# People talk as people do: one detail at most (the storm, the nationality, the place or a name),
# the rest left to what both of them know. A stranger who has only heard says a little more; a
# friend says less.

enum RepTie: stranger, acquaintance, friend

# How well `speaker` knows him: heard of only, spoken with, or a friend.
rep_tie = (w: World, speaker: int, known: bool) -> RepTie:
    met = if speaker in w.rep.opinions: w.rep.opinions[speaker].met else: 0
    rel = w.relationship_index.get(RelationshipKey(speaker,w.player),-1)
    affinity = if rel >= 0: w.relationships[rel].affinity else: 0
    if met >= 6 or affinity >= 150: return .friend
    if known or met > 0: return .acquaintance
    .stranger

_where = (w: World, d: RepDeed) -> str:
    if d.near >= 0: return "off {rep_town_name(w,d.near)}"
    if d.town >= 0: return "at {rep_town_name(w,d.town)}"
    "out there"

# By how well they know him: a friend's lines, an acquaintance's, a stranger's.
_by = (tie: RepTie, friend: str[], acquaintance: str[], stranger: str[]) -> str[]:
    if tie == .friend: friend else: if tie == .acquaintance: acquaintance else: stranger

# What `speaker` says of a deed they heard of, by how well they know him. Each line says one
# thing; the rest is understood.
rep_deed_lines = (w: World, d: RepDeed, speaker: int, tie: RepTie) -> str[]:
    ours = d.side >= 0 and d.side == rep_person_country(w,speaker)
    storm = d.storm >= 600
    adj = _adj(w,d.side)
    other = _who(w,d.other)
    where = _where(w,d)
    rescue = d.kind == .rescued_foe or d.kind == .rescued_friend or d.kind == .rescued_survivors
    if rescue and ours and d.kind == .rescued_foe:
        return _by(tie,["You picked up one of ours. Thank you.","I heard what you did for that boy of ours."],["You pulled one of ours out of the water. I won't forget that.","That was one of ours you fished out. Thank you."],["You're the one who picked up our boy, aren't you?","So you're the one who pulled him out."])
    if rescue and storm:
        return _by(tie,["You and your rescues.","In that sea. You'll be the death of me."],["Heard about the storm. Brave or mad, I can't decide.","That storm, and you put down in it. I heard."],["So you're the one who went down in that storm.","Heard about the storm. Brave or mad, I can't decide."])
    if d.kind == .rescued_foe:
        return _by(tie,["You and your rescues.","Fishing {adj}s out of the sea now?"],["Heard about the {adj}. Good of you.","That business {where}. Good of you."],["So you're the one who fished that {adj} out of the water.","You'd be the one who pulled the {adj} out."])
    if rescue:
        return _by(tie,["You and your rescues.","Picking people out of the sea again, I hear."],["Heard you brought them in. Good of you.","That business {where}. Good of you."],["You're the one who brought them in, aren't you?","They say you pulled them out of the water."])
    if d.kind == .shot_down and ours:
        return _by(tie,["I won't pretend I liked hearing it.","I heard. Let's not talk about it."],["I know what you did {where}.","I heard about {where}."],["I know what you did {where}.","I heard about {where}."])
    if d.kind == .shot_down:
        return _by(tie,["Another one down, they say. Careful.","Heard you were busy {where}."],["Heard you got one of them.","So you got the {adj}. They're all talking."],["You're the one who got that {adj}, aren't you?","Heard you were in the fight {where}."])
    # (an errand of the islands done: the mail, the papers, the nurse; src/errand_words.jo)
    if d.kind == .job_done and d.job >= 0:
        if let e = errand_of(w,d.job): return errand_said(w,e,if tie == .friend: 2 else: if tie == .acquaintance: 1 else: 0)
    if d.kind == .raced:
        at = rep_town_name(w,d.town)
        if d.rank == 1: return _by(tie,["Won again, I hear.","You and your racing."],["Heard you won at {at}.","So you won. They're all talking."],["You're the one who won at {at}, aren't you?","So you're the one who won the race."])
        if d.rank > 0 and d.rank <= 3: return _by(tie,["{_cap(_ordinal(d.rank))}, I hear. Not bad.","Close, they say."],["Heard you came {_ordinal(d.rank)} at {at}.","{_cap(_ordinal(d.rank))} at {at}, they say. Not bad."],["You raced at {at}, didn't you? {_cap(_ordinal(d.rank))}, I heard.","You're the one who came {_ordinal(d.rank)} at {at}."])
        return _by(tie,["Heard you raced.","Racing now, are we?"],["Heard you raced at {at}.","You were in the race at {at}, they say."],["You raced at {at}, didn't you?","You're the one who flew in the race at {at}."])
    if d.kind == .found_boat and other != "":
        return _by(tie,["You and your rescues.","Heard you found {other}. Good of you."],["Heard you found {other}.","{other}'s home, thanks to you."],["You're the one who found {other}'s boat, aren't you?","So you're the one who brought {other} in."])
    if d.kind == .flew_home_in_formation:
        return _by(tie,["Back in one piece, and the others with you.","All of you home. Good."],["You brought them all home, I heard.","Heard you stayed with the others."],["You brought them all home, I heard.","Heard you stayed with the others."])
    if d.kind == .left_the_fight:
        return _by(tie,["They're saying you turned back. I told them there'd be a reason.","I heard the talk. I don't believe half of it."],["Heard you turned for home early.","You left before the end, they say."],["Heard you turned for home early.","You left before the end, they say."])
    if other == "": return []
    match d.kind:
        .job_done: _by(tie,["On time again, I hear.","{other} was pleased with you."],["{other} says you were on time. Makes a change.","Heard you brought {other}'s load in."],["You brought {other}'s load in, didn't you?","You're the one who flies for {other}."])
        .job_late: _by(tie,["{other}'s been grumbling about you.","Late again, I hear."],["Late with {other}'s load, I heard.","{other} was waiting a while on you, they say."],["Late with {other}'s load, I heard.","{other} was waiting a while on you, they say."])
        .job_failed: _by(tie,["What happened with {other}'s load?","{other}'s still sore about it, you know."],["{other} never got the load, they say.","Heard about {other}'s load."],["{other} never got the load, they say.","Heard about {other}'s load."])
        .debt_paid: _by(tie,["Square with {other} now, then.","{other} says you paid up."],["Paid {other} back, I hear. Good.","{other} says you settled up."],["Paid {other} back, I hear. Good.","{other} says you settled up."])
        .debt_defaulted: _by(tie,["You still owe {other}, you know.","{other} keeps asking after you."],["{other} is still owed, they tell me.","Heard about {other}'s money."],["{other} is still owed, they tell me.","Heard about {other}'s money."])
        else: []

# How a stranger who has heard of him greets him: by one thing they know, and no more.
_heard_lines = (w: World, speaker: int, v: RepView) -> str[]:
    me = w.people[w.player]
    named = me.name != "" and me.name != "The Pilot"
    home = rep_town_of_place(w,me.home)
    here = home >= 0 and home == rep_town_of(w,speaker)
    who = if named: "{split(me.name," ")[0]}" else: if here: "the pilot" else: "the {rep_town_name(w,home)} pilot"
    if v.lean.warmth <= REP_STANDOFFISH: return ["Don't see you about much.","You keep to yourself, don't you."]
    if v.lean.warmth >= 150: return ["Ah, {who}. I've heard good things.","You'll be {who}. Heard you're good company."]
    if v.lean.honour >= 200: return ["You'll be {who}. People speak well of you.","Ah, {who}. I've heard of you."]
    ["You'll be {who}?","Ah. {_cap(who)}."]

_bank = (lines: str[], key: str, priority: int) -> SpeechCandidate[]:
    [loop k in 0..lines.len(): SpeechCandidate("{key}:{k}",lines[k],priority)]

# The greeting, as his name has reached `speaker`. `known` they have talked before; `result` the
# ordinary greetings (kept when his name changes nothing).
rep_greeting = (w: World, speaker: int, listener: int, known: bool, result: SpeechCandidate[]) -> SpeechCandidate[]:
    if listener != w.player: return result
    v = rep_view(w,speaker)
    if not v.known: return result
    # (thought ill of: a short answer, no question after it)
    if v.regard <= REP_COLD:
        lines = if v.side <= REP_COLD: ["I know who you are.","Yes. I know you.","Mm. What is it?"] else: ["Mm.","What is it?","I'm busy."]
        return _bank(lines,"rep-cold",175)
    tie = rep_tie(w,speaker,known)
    if v.deed >= 0:
        if let d = rep_deed(w,v.deed):
            lines = rep_deed_lines(w,d,speaker,tie)
            if lines.len() > 0: return _bank(lines,"rep-deed:{d.id}",165)+result
    if known: return result
    # (heard of him, never met: they say so)
    q = if result.len() > 0: result[0].ask else: TalkQuestion(.none,"","")
    cands = _bank(_heard_lines(w,speaker,v),"rep-heard",150)
    if q.kind != .none: cands[0].text += " "+q.text; cands[0].ask = q
    cands+result

# After a line is said to him: a chat counts (once a day), and a deed once remarked on is not
# remarked on again by the same person.
rep_said = (w: mut World, speaker: int, listener: int, topic: TalkTopic, key: str):
    if listener != w.player or speaker < 0 or speaker >= w.people.len(): return
    if topic == .greeting: rep_act(w,.talked,speaker)
    if key.starts_with("rep-deed:"):
        parts = split(key,":")
        if parts.len() >= 2:
            if let id = to_int(parts[1]):
                op = w.rep.opinions.get(speaker,RepOpinion(person=speaker,minute=w.minute))
                if not (id in op.told):
                    op.told.insert(0,id)
                    if op.told.len() > 3: op.told.pop()
                    if not (id in op.deeds):
                        op.deeds.insert(0,id)
                        if op.deeds.len() > 3: op.deeds.pop()
                    w.rep.opinions[speaker] = op

# How he answers in talk: an interested answer warms them a little; cutting them short cools.
rep_replied = (w: mut World, speaker: int, listener: int, reply: TalkReply):
    if listener != w.player: return
    match reply:
        .decline, .leave: rep_act(w,.cut_short,speaker)
        else: pass

# ---------------- company ----------------

# How readily someone would come over to him, or come when asked (1 = as to anyone).
rep_pull = (w: World, person: int) -> f64:
    v = rep_view(w,person)
    if not v.known: return 1.0
    if v.regard <= REP_COLD: return 0.0
    clamp(1.0+f64(v.lean.warmth)/150.0,0.15,1.6)*clamp(1.0+f64(v.regard)/1000.0,0.3,1.4)

# The town's welcome: how often anyone comes over at all (1 = as to a stranger). Known as keeping
# to himself, about a third as often; as good company, half again as often.
rep_welcome = (w: World, town: int) -> f64:
    if not (town in w.rep.towns): return 1.0
    tw = w.rep.towns[town]
    f = clamp(1.0+f64(tw.lean.warmth)/150.0,0.15,1.6)
    1.0+(f-1.0)*f64(min(1000,tw.heard*2))/1000.0

# Asked over: whether they come (`roll` in 0..1).
rep_accepts = (w: World, person: int, roll: f64) -> bool:
    v = rep_view(w,person)
    base = if v.met > 0: 0.8 else: 0.6
    roll < base*min(1.25,rep_pull(w,person))

# Asked "Mind if I sit?": why not, in their words, by what they've heard of him.
rep_decline_line = (w: World, person: int) -> str:
    v = rep_view(w,person)
    n = person+day_index(w.minute)
    lines = if not v.known: ["I'm waiting on someone, sorry.","Not tonight, thanks.","I'd rather sit alone tonight, if it's all the same."] else: if v.regard <= REP_COLD: ["I'd rather you didn't.","No.","Not with you."] else: if v.lean.warmth <= REP_STANDOFFISH: ["Thought you liked your own company.","Didn't take you for the sociable sort.","You? Sit with me? No, I'll manage."] else: ["Another time.","Not tonight, thanks.","I'm waiting on someone."]
    lines[n%lines.len()]

# And yes.
rep_accept_line = (w: World, person: int) -> str:
    v = rep_view(w,person)
    tie = rep_tie(w,person,v.met > 0)
    n = person+day_index(w.minute)
    lines = if tie == .friend: ["Pull up a chair.","Sit, sit."] else: if v.known and v.deed >= 0: ["Sit down. I want to hear about it.","Please. I've heard a thing or two."] else: if v.known and v.lean.warmth >= 150: ["Of course. Sit.","I was hoping you would."] else: ["Go on, then.","Please."]
    lines[n%lines.len()]

# ---------------- at the margin ----------------

# A keeper's rounding of a price for him, in permille (-60 to +50; 0 to strangers).
rep_price_permille = (w: World, seller: int) -> int:
    v = rep_view(w,seller)
    if not v.known: return 0
    if v.regard >= 600: return -60
    if v.regard >= 300: return -30
    if v.regard <= -400: return 50
    0

rep_price = (w: World, seller: int, cents: int) -> int:
    p = rep_price_permille(w,seller)
    if p == 0: return cents
    max(5,(cents*(1000+p)/1000+2)/5*5)

# A family who has heard well of him may put him up.
rep_would_host = (w: World, person: int) -> bool:
    v = rep_view(w,person)
    v.known and v.regard >= 350 and v.lean.honour >= 150

# ---------------- the wireless ----------------

struct RepBulletin:
    deed = -1
    text = ""
    code = ""
    minute = -1

# The big deed on the wireless today, if any: read for a day after it reaches the station.
# A state station doesn't read his victories over its own country.
rep_bulletin = (w: World, country: int) -> RepBulletin:
    best = RepBulletin()
    weight = 0
    loop d in w.rep.deeds:
        if not d.aired or w.minute-d.radio_minute >= 1440 or w.minute < d.radio_minute: continue
        if country >= 0 and d.side == country and (d.kind == .shot_down or d.kind == .left_the_fight): continue
        if d.weight <= weight: continue
        where = if d.town >= 0: "at {rep_town_name(w,d.town)}" else: if d.near >= 0: "off {rep_town_name(w,d.near)}" else: "at sea"
        me = w.people[w.player]
        who = if me.name != "" and me.name != "The Pilot": "{me.name}, a seaplane pilot," else: "A {rep_town_name(w,rep_town_of_place(w,me.home))} seaplane"
        storm = if d.storm >= 600: " in heavy seas" else: ""
        text = match d.kind:
            .rescued_foe: "{who} put down{storm} {where} to pick up a downed {_adj(w,d.side)} airman."
            .rescued_friend: "{who} put down{storm} {where} to pick up a downed airman."
            .rescued_survivors: "{who} brought {_count(d.people)} people out of the sea{storm} {where}."
            .raced: if d.rank == 1: "{if d.fast: "The Schneider race" else: "The race"} at {rep_town_name(w,d.town)} was won by a seaplane out of {rep_town_name(w,rep_town_of_place(w,me.home))}." else: ""
            .shot_down: "{_cap(_count(d.people))} {_adj(w,d.side)} aircraft reported down {where}."
            else: ""
        if text == "": continue
        weight = d.weight
        best = RepBulletin(deed=d.id,text=text,code=if d.kind == .shot_down: "AIR" else: "RES",minute=d.radio_minute)
    best

_ordinal = (n: int) -> str:
    words = ["","first","second","third","fourth","fifth","sixth","seventh","eighth"]
    if n > 0 and n < words.len(): words[n] else: "{n}th"

# ---------------- the paper ----------------

struct RepPaperPiece:
    head: str
    body: str
    weight = 0

# What the town at `place` (core) tells of him that the paper prints: his race, his rescues, a
# boat brought home; as the town tells it, in a paper's words.
rep_paper_pieces = (w: World, place: int) -> RepPaperPiece[]:
    out: RepPaperPiece[]
    town = rep_town_of_place(w,place)
    if not (town in w.rep.towns) or w.rep.towns[town].heard < 150: return out
    home = rep_town_name(w,rep_town_of_place(w,w.people[w.player].home))
    loop h in w.rep.towns[town].deeds:
        if let d = rep_deed(w,h.deed):
            at = rep_town_name(w,if d.town >= 0: d.town else: d.near)
            match d.kind:
                .raced:
                    if d.rank > 0 and d.rank <= 3:
                        title = if d.fast: "Schneider race" else: "Air race"
                        out.push(RepPaperPiece(if d.rank == 1: "{home} pilot wins at {at}" else: "{title} at {at}","{_cap(_ordinal(d.rank))} place in the {title.lower()} at {at} went to a seaplane out of {home}.",300-d.rank*40))
                .rescued_foe, .rescued_friend, .rescued_survivors:
                    out.push(RepPaperPiece("Rescue {_where(w,d)}","A seaplane out of {home} put down {_where(w,d)} to bring {if d.people > 1: "survivors" else: "an airman"} out of the sea.",d.weight/4))
                .found_boat:
                    out.push(RepPaperPiece("Boat brought home","A fishing boat overdue {_where(w,d)} is home again, found by a seaplane out of {home}.",d.weight/4))
                else: pass
    out

# ---------------- the notebook, in words ----------------

_lean_words = (l: RepLean) -> str:
    parts: str[]
    if l.warmth >= 100: parts.push("good company")
    else if l.warmth <= REP_STANDOFFISH: parts.push("one who keeps to himself")
    if l.honour >= 200: parts.push("a man of his word")
    else if l.honour <= -150: parts.push("not to be trusted")
    if l.daring >= 200: parts.push("fearless in the air")
    else if l.daring <= -150: parts.push("careful, some say timid")
    if l.reliability >= 150: parts.push("reliable with a load")
    else if l.reliability <= -120: parts.push("slow with a load")
    if parts.len() == 0: return "a pilot, and not much more"
    if parts.len() == 1: return parts[0]
    join(parts[0..parts.len()-1],", ")+" and "+parts[parts.len()-1]

# A line or two: where he is known and as what; where he stands (the town he's in) if unknown.
rep_summary_lines = (w: World) -> str[]:
    out: str[]
    ranked = [loop t, tw in w.rep.towns: if tw.heard >= 120: (-tw.heard,t)]
    ranked.sort()
    loop k in 0..min(3,ranked.len()):
        t = ranked[k].1; tw = w.rep.towns[t]
        how = if tw.heard >= 600: "Well known" else: if tw.heard >= 300: "Known" else: "Known to some"
        out.push("{how} in {rep_town_name(w,t)} as {_lean_words(tw.lean)}.")
    here = rep_town_of(w,w.player)
    if here >= 0 and (not (here in w.rep.towns) or w.rep.towns[here].heard < 120):
        out.push("In {rep_town_name(w,here)}, mostly unknown.")
    if out.len() == 0: out.push("Nobody much has heard of you yet.")
    out
