# The islands' ground: one mesh per island, built once from world.jo's heights, and its shader
# (white limestone with its strata on steep ground, dark green maquis on the gentle slopes, pale
# sand at the water's edge, wet sand and seabed below it).

use 'world.jo'
use 'look.jo'

struct GroundParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    sky: vec3
    shade: vec3
    haze: vec3
    fog: f32
    time: f32
    wind: vec4
    drift: vec2

struct GroundOut:
    pos: vec4
    world: vec3
    normal: vec3
    tint: vec4

ground_vs = (v: Vertex3D, u: GroundParams) -> GroundOut:
    GroundOut(u.view_proj * vec4(v.pos, 1), v.pos, v.normal, v.color)

ground_fs = (i: GroundOut, u: GroundParams) -> vec4:
    n = normalize(i.normal)
    y = i.world.y
    slope = 1.0 - n.y                                  # 0 flat, 1 a wall
    # limestone, its strata: bands along the height, wavering a little
    wav = sin(i.world.x * 0.013 + i.world.z * 0.009) * 2.5 + i.tint.y * 6.0
    band = sin((y + wav) * 0.55) * 0.5 + 0.5
    band2 = sin((y + wav * 0.6) * 1.9) * 0.5 + 0.5
    groove = smoothstep(0.82, 0.97, sin((y + wav) * 0.31 + 1.3) * 0.5 + 0.5)
    streak = sin(i.world.x * 0.21 + i.world.z * 0.17 + sin(y * 0.05) * 3.0) * 0.5 + 0.5
    stone = mix(vec3(0.94, 0.9, 0.81), vec3(0.72, 0.68, 0.6), band * 0.5 + band2 * 0.2)
    stone = mix(stone, vec3(0.5, 0.5, 0.5), groove * 0.45)
    stone = mix(stone, vec3(0.66, 0.62, 0.55), smoothstep(0.7, 1.0, streak) * 0.25 * slope)
    stone = mix(stone, vec3(0.84, 0.75, 0.6), i.tint.y * 0.35)
    # maquis and pines on gentle ground: dark green with olive patches
    green = mix(vec3(0.13, 0.3, 0.12), vec3(0.36, 0.45, 0.18), i.tint.x)
    green = mix(green, vec3(0.2, 0.36, 0.1), smoothstep(0.55, 0.8, i.tint.y))
    sand = vec3(0.95, 0.88, 0.7)
    wet = vec3(0.78, 0.72, 0.56)
    # what covers the ground: green unless steep (rock), or near the water (sand)
    # the ridge map: water gathers in the creases (lush, dark), ridges are dry (pale grass, bare rock)
    ridge = i.tint.z * 2.0 - 1.0
    crease = smoothstep(0.05, -0.6, ridge)
    dry = smoothstep(0.1, 0.75, ridge)
    green = mix(green, vec3(0.07, 0.2, 0.09), crease * 0.75)
    green = mix(green, vec3(0.55, 0.55, 0.3), dry * 0.55)
    veg = (1.0 - smoothstep(0.33 + crease * 0.2, 0.5 + crease * 0.2, slope + i.tint.y * 0.12 + dry * 0.12)) * smoothstep(3.0, 9.0 + i.tint.x * 8.0, y)
    c = mix(stone, green, veg)
    beach = (1.0 - smoothstep(1.8, 3.5 + i.tint.x * 2.5, y)) * (1.0 - smoothstep(0.25, 0.5, slope))
    c = mix(c, sand, beach)
    if y < 0.6:
        c = mix(wet, sand * 0.9, clamp(y + 0.4, 0.0, 1.0))
        c = mix(c, stone * 0.8, smoothstep(0.35, 0.6, slope))
    # close up: patches of lighter and darker growth, bare earth, small stones
    near = 1.0 - smoothstep(60.0, 260.0, length(i.world - u.cam))
    if near > 0.0:
        pn = vnoise(i.world.xz * 0.35) * 0.6 + vnoise(i.world.xz * 1.3) * 0.4
        pb = vnoise(i.world.xz * 0.11 + vec2(7, 1))
        detail = mix(vec3(0.82, 0.86, 0.78), vec3(1.15, 1.12, 0.95), pn)
        earth = smoothstep(0.68, 0.8, pb) * veg
        c = mix(c, c * detail, near)
        c = mix(c, vec3(0.55, 0.45, 0.32), earth * near * 0.55)
    # light: a painted two-tone, with the sky's fill and a cool shade
    ndl = dot(n, normalize(u.sun_dir))
    lit = cel(ndl)
    light = u.sun * lit + mix(u.shade, u.sky, 0.35) * (1.0 - lit * 0.6) * 0.75
    col = c * light
    # seabed: caustic shimmer in the shallows
    if y < 0.0:
        cx = sin(i.world.x * 0.35 + u.time * 1.3 + sin(i.world.z * 0.27 + u.time)) + sin(i.world.z * 0.41 - u.time * 1.1 + sin(i.world.x * 0.3))
        col = col * (0.9 + 0.25 * smoothstep(1.1, 1.9, cx) * clamp(1.0 + y * 0.15, 0.0, 1.0))
    # the wind over the grass: gusts sweep across the meadows as waves of paler, bent blades
    meadow = veg * (1.0 - smoothstep(0.15, 0.4, slope)) * (0.45 + 0.55 * dry) * (1.0 - crease * 0.6)
    g = gust(i.world.xz, u.drift)
    along = dot(i.world.xz, u.wind.xy)
    ripple = sin(along * 0.35 - u.time * (1.5 + u.wind.z * 0.35)) * 0.5 + 0.5
    wave = g * (0.55 + 0.45 * ripple) * clamp(u.wind.z / 8.0, 0.0, 1.2)
    col = mix(col, col * vec3(1.25, 1.22, 1.05) + vec3(0.05, 0.05, 0.02) * u.sun, meadow * wave * 0.6)
    vec4(aerial(col, i.world, u.cam, u.haze, u.fog), 1)

ground_sh: Shader

# one island's ground: a grid over its reach, `step` meters apart, the cells deep under the sea
# left out (and their corners not kept). Normals from the baked land, finer than the grid; the
# ridge map in the color's z (-1 creases .. 1 ridges, as 0..1)
build_island_mesh = (isl: Island, step: f64) -> Mesh:
    ext = mesh_extent(isl)
    n = int(ext * 2.0 / step) + 1
    x0 = f64(isl.center.x) - ext
    z0 = f64(isl.center.y) - ext
    rows = parallel_map([0..n), (j: int) -> f64[]: [loop i in 0..n: island_height(isl, x0 + f64(i) * step, z0 + f64(j) * step)])
    hs: f64[]
    loop r in rows: hs.extend(r)
    ids = fill(-1, n * n)
    idx: u32[]
    vs: Vertex3D[]
    vert = (vs: mut Vertex3D[], ids: mut int[], i: int, j: int) -> u32:
        k = j * n + i
        if ids[k] >= 0: return u32(ids[k])
        x = x0 + f64(i) * step
        z = z0 + f64(j) * step
        h = hs[k]
        e = 5.0
        nx = island_height(isl, x - e, z) - island_height(isl, x + e, z)
        nz = island_height(isl, x, z - e) - island_height(isl, x, z + e)
        nrm = normalize(vec3(f32(nx), f32(e * 2.0), f32(nz)))
        # (tint: x where the green is olive rather than dark, y how much the rock is ochre, z the ridges)
        tx = fbm(x * 0.004 + isl.seed, z * 0.004, 3)
        ty = noise(x * 0.0011 - isl.seed, z * 0.0011)
        tz = ridge_at(x, z) * 0.5 + 0.5
        ids[k] = vs.len()
        vs.push(Vertex3D(vec3(f32(x), f32(h), f32(z)), nrm, vec2(0, 0), vec4(f32(tx), f32(ty), f32(tz), 1)))
        u32(ids[k])
    loop j in 0..n - 1:
        loop i in 0..n - 1:
            a = j * n + i
            if max(max(hs[a], hs[a + 1]), max(hs[a + n], hs[a + n + 1])) < -40.0: continue
            va = vert(vs, ids, i, j); vb = vert(vs, ids, i + 1, j); vc = vert(vs, ids, i, j + 1); vd = vert(vs, ids, i + 1, j + 1)
            idx.push(va); idx.push(vc); idx.push(vb)
            idx.push(vb); idx.push(vc); idx.push(vd)
    mesh(vs, idx)

draw_ground = (meshes: Mesh[], L: Light, t: f64):
    p = GroundParams(scene_view_proj(), scene_camera(), L.sun_dir, L.sun, L.sky_top, L.shade, L.haze, f32(L.fog_density), f32(t),
        vec4(wind_now.dir.x, wind_now.dir.y, f32(wind_now.speed), 0), wind_now.drift)
    loop m in meshes: draw(ground_sh, m, p)

# (the GPU programs: made once the window is open)
init_terrain = ():
    global ground_sh
    ground_sh = make_shader(shader(ground_vs, ground_fs))
