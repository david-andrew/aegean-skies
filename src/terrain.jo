use 'runtime_options.jo'
use 'depth_space.jo'
# The islands' ground: error-bounded nested patches and the original painted shader
# (white limestone with its strata on steep ground, dark green maquis on the gentle slopes, pale
# sand at the water's edge, wet sand and seabed below it).

use 'world.jo'
use 'look.jo'
use 'tweaks.jo'
use 'paint.jo'
use 'plants.jo'
use 'terrain_data.jo'
use 'terrain_lod.jo'
use 'render_space.jo'
use 'coast_field.jo'
use 'coast_pattern.jo'
use 'coast_mesh.jo'
use 'coast_atlas.jo'
use 'quality.jo'
use 'road_material.jo'
use 'canopy.jo'
use 'fields.jo'
use 'field_map.jo'

struct GroundParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    sky: vec3
    shade: vec3
    haze: vec3
    fog: f32
    time: f32
    wind: vec4
    drift: vec2
    origin: vec3
    heights: Texture
    materials: Texture
    flow: vec4                      # the near detail's extra drift (look.jo near_flow)
    warp_a: vec4                    # (the speed trial's warp, its anchor relative to origin)
    warp_b: vec4
    pigment: Texture = Texture()
    coast_pattern: Texture = Texture()
    contact_rect: vec4 = vec4(0,0,0,0)
    grass_actor: vec4 = vec4(0,0,0,0)
    grass_airflow: vec4 = vec4(0,0,0,0)
    grass_gust: vec4 = vec4(0,0,0,0)  # the meadow gust layers' offsets (src/look.jo meadow_gust); drift holds the warp layer's
    grass_spring: vec4 = vec4(1,1,1,0)  # the meadow spring's gains per wave train (src/look.jo meadow_spring)
    grass_lag: vec4 = vec4(0,0,0,0)     # and its phase offsets (meadow_lag)
    meadow_a: vec4 = vec4(0,0,0,0)      # the wind study (Tweaks): its two gust layers' offsets (look.jo meadow_study_gust)
    meadow_b: vec4 = vec4(0,0,0,0)      # its two dab layers' offsets (meadow_study_dabs)
    meadow_c: vec4 = vec4(0,0,0,0)      # the gusts' reach (x, m), the dabs' (y), the dabs' travel (z, m/s), on (w: 1)
    meadow_noise: Texture = Texture()   # its noise tile (look.jo meadow_noise_texture)
    grass_view: vec4 = vec4(0,1,1,1)  # the grass egg: look x, z, side reach, behind reach (src/grass.jo grass_shape)
    roads: Texture = Texture()
    road_rect: vec4 = vec4(0,0,0,0)
    river_map:Texture=Texture()
    river_area:vec4=vec4(0,0,0,0)
    working_map:Texture=Texture()
    lake_map:Texture=Texture()
    lake_area:vec4=vec4(0,0,0,0)
    canopy: Texture = Texture()     # the crown mass sheet (src/canopy.jo)
    field_map: Texture = Texture()  # the fields' layout round the camera (src/field_map.jo)
    field_window: vec4 = vec4(0,0,0,1)  # its valid window: world min x, z, size; its span
    grove: vec4 = vec4(0,0,0,0)     # canopy_paint's grove (src/canopy.jo grove_uniform)
    canopy_light: vec4 = vec4(0,1,0,0)  # the canopy's modelling light (src/canopy.jo canopy_light)
    land_light: vec4 = vec4(0,1,0,0)    # the land's modelling light (src/canopy.jo land_light)
    land_steps: f32 = 0.0               # Tweaks "Painted layers": the far land's haze in steps (canopy.jo land_aerial)
    land_palette: f32 = 1.0             # the fields' palette: 1 green valleys, 0 dry straw (src/fields.jo)

struct GroundOut:
    pos: vec4
    world: vec3
    normal: vec3
    tint: vec4
    orchard: f32 = 0.0
    tile_level: f32 = 0.0
    relief_normal: vec3 = vec3(0,0,0)
    # Riparian ground: (weight, height above the river surface). Evaluated at
    # terrain vertices; the river mask is far coarser than the vertex spacing.
    river: vec2 = vec2(0,0)
    working:vec4=vec4(0,0,0,0)
    land: f32 = 0.0                 # the land light on the vertex's normal (src/canopy.jo land_light)

# A map a draw leaves unread (no river or lake in its area: river_area/lake_area are zero) still
# needs a texture bound in WebGL, or the browser warns on every draw ("no texture bound to the
# unit"): one 1x1 texture stands in for it.
unread_map_texture: Texture = Texture()
unread_map = () -> Texture:
    global unread_map_texture
    if unread_map_texture.id == 0: unread_map_texture = texture(image(1, 1), false)
    unread_map_texture

# The river corridor's alluvial/moist ground weight at a world point.
ground_riparian = (u: GroundParams,xz: vec2,y: f32) -> vec2:
    if u.river_area.z<=0.0:return vec2(0,0)
    uv=(xz-u.river_area.xy)/u.river_area.zw
    if uv.x<=0.0 or uv.x>=1.0 or uv.y<=0.0 or uv.y>=1.0:return vec2(0,0)
    mask=sample_lod(u.river_map,uv,0.0)
    above=y-mask.x*256.0/max(mask.w,0.001)
    weight=mask.w*(1.0-smoothstep(0.3,0.8,mask.y/max(mask.w,0.001)))*(1.0-smoothstep(8.0,18.0,above))
    vec2(weight,above)

coast_vs = (v: TerrainVertex,inst: CoastInstance,u: GroundParams) -> GroundOut:
    p = inst.region.xy+v.cell*inst.region.z
    # Filtering the continuous material channels needs two cached reads,
    # rather than fetching/decoding all four full corner records per vertex.
    uv = (inst.texel+p+vec2(0.5,0.5))/vec2(texture_size(u.materials))
    material = sample(u.materials,uv)
    ridge = sample(u.heights,(inst.texel+p+vec2(0.5,0.5))/vec2(texture_size(u.heights))).w
    normal_xz = material.xy*2.0-vec2(1,1)
    normal = vec3(normal_xz.x,sqrt(max(1.0-dot(normal_xz,normal_xz),0.001)),normal_xz.y)
    s = TerrainSample(0,normal,vec4(material.z,material.w,ridge,1))
    y = coast_gpu_height(inst,p,u.coast_pattern)
    base_normal = s.normal
    s.normal = coast_gpu_normal(inst.absolute,p,inst.heights,s.normal,smoothstep(0.0,3.0,coast_mesh_level(inst,p)),u.coast_pattern)
    s.tint.w = 1.0-smoothstep(1700.0,2300.0,y)
    local = vec3(inst.origin.x+p.x*14.0,y,inst.origin.y+p.y*14.0)
    world = local+u.origin
    bent = render_warped(local,u.cam,u.warp_a,u.warp_b)
    orchard = orchard_cover(world.xz,y,length(base_normal.xz)/max(base_normal.y,0.1))
    working = sample_lod(u.working_map,uv,0.0)
    GroundOut(u.view_proj*vec4(bent,1),local,base_normal,s.tint,orchard,0,s.normal,ground_riparian(u,world.xz,y),land=dot(base_normal,u.land_light.xyz),working=working)

# The analytic detail gradient avoids derivative extensions and extra fragment
# work on WebGL2. It converges to the same continuous field as the fine mesh.
coast_fs_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_fs(i, u)

coast_fs = (i: GroundOut,u: GroundParams) -> vec4:
    ground_material(i,u,false,true)

coast_world_fs_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_world_fs(i, u)

coast_world_fs = (i: GroundOut,u: GroundParams) -> vec4:
    ground_material(i,u,true,true)

# (the low tier's: its own canopy, compiled without the full one)
coast_fs_low_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_fs_low(i, u)

coast_fs_low = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,false,true,0)
coast_world_fs_low_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_world_fs_low(i, u)

coast_world_fs_low = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,true,true,0)
# (the wind study's (Tweaks): the same with its sheen compiled in; main's shaders never carry its code)
coast_fs_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_fs_ws(i, u)

coast_fs_ws = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,false,true,1,1)
coast_world_fs_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_world_fs_ws(i, u)

coast_world_fs_ws = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,true,true,1,1)
# (the low tier's read two layers, not four: wind_study 2)
coast_fs_low_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_fs_low_ws(i, u)

coast_fs_low_ws = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,false,true,0,2)
coast_world_fs_low_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    coast_world_fs_low_ws(i, u)

coast_world_fs_low_ws = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,true,true,0,2)

coast_sh: Shader
coast_world_sh: Shader
coast_sh_ws: Shader
coast_world_sh_ws: Shader
terrain_study_ready = false

# the wind study's ground shaders, made the first time its Tweaks box is on
terrain_study_shaders = ():
    global coast_sh_ws,coast_world_sh_ws,ground_sh_ws,terrain_study_ready
    if terrain_study_ready: return
    low = render_quality.tier == 0
    ground_sh_ws = make_shader(if low: world_shader(shader(ground_vs, ground_fs_low_ws), shader(ground_vs, ground_fs_low_ws_log)) else: world_shader(shader(ground_vs, ground_fs_ws), shader(ground_vs, ground_fs_ws_log)),false)
    coast_sh_ws = make_shader(if low: world_shader(shader(coast_vs, coast_fs_low_ws), shader(coast_vs, coast_fs_low_ws_log)) else: world_shader(shader(coast_vs, coast_fs_ws), shader(coast_vs, coast_fs_ws_log)),false)
    coast_world_sh_ws = make_shader(if low: world_shader(shader(coast_vs, coast_world_fs_low_ws), shader(coast_vs, coast_world_fs_low_ws_log)) else: world_shader(shader(coast_vs, coast_world_fs_ws), shader(coast_vs, coast_world_fs_ws_log)),false)
    terrain_study_ready = true

draw_coast_batches = (batches: CoastInstance[][],params: GroundParams,large: bool = false):
    global coast_triangles,coast_instances,coast_draws
    collect_coast_height(batches,true)
    loop level in 0..COAST_LEVELS:
        if batches[level].len() == 0: continue
        sh=if large:coast_world_sh else:coast_sh
        if params.meadow_c.w > 0.0:
            terrain_study_shaders()
            sh=if large:coast_world_sh_ws else:coast_sh_ws
        draw_instanced(sh,coast_grids[level],batches[level],params)
        coast_triangles += coast_grids[level].index_count/3*batches[level].len()
        coast_instances += batches[level].len()
        coast_draws += 1

ground_vs = (v: TerrainVertex, inst: TerrainInstance, u: GroundParams) -> GroundOut:
    p = v.cell
    fine = land_vertex(u.heights, u.materials, inst.texel, p, inst.edges)
    sample = fine
    if inst.state.y > 0.0 and p.x > 0.0 and p.x < 32.0 and p.y > 0.0 and p.y < 32.0:
        parent = land_parent(u.heights, u.materials, inst.texel, p, min(inst.state.x * 2.0, 32.0), inst.edges)
        sample = land_mix(fine, parent, inst.state.y)
    # Edges already use the shared record, independently of either interior.
    local = vec3(inst.origin.x + p.x * 14.0, sample.h, inst.origin.y + p.y * 14.0)
    world = local + u.origin
    camera_local = u.cam
    bent = render_warped(local, camera_local, u.warp_a, u.warp_b)
    orchard = orchard_cover(world.xz,world.y,length(sample.normal.xz)/max(sample.normal.y,0.1))
    working = sample_lod(u.working_map,(inst.texel+p+vec2(0.5,0.5))/vec2(texture_size(u.working_map)),log2(inst.state.x))
    GroundOut(u.view_proj * vec4(bent, 1), local, sample.normal, sample.tint,orchard,land=dot(sample.normal,u.land_light.xyz),working=working)

# Band-limit the original limestone pattern to the pixel footprint. Retain
# resolved strata nearby; distant slopes use each pattern's mean, not aliasing.
ground_band_visibility = (phase: f32) -> f32: 1.0-smoothstep(PI,TAU,fwidth(phase))

# Shared pigment/light evaluation can run at blade vertices. Derivative filters
# and screen-space paper stay in the terrain fragment entry point.
ground_strata=(i:GroundOut,u:GroundParams)->vec3:
    world=i.world+u.origin
    pigment=sample(u.pigment,vec2((world.x+world.z*0.71)/192.0,i.world.y/96.0))
    fracture=pigment.w-0.5
    wav=sin(world.x*0.013+world.z*0.009)*2.5+i.tint.y*6.0+fracture*34.0
    vec3((i.world.y+wav)*0.55,fracture,pigment.x)

ground_material = (i: GroundOut,u:GroundParams,large_terrain:bool,coastal:bool=false,detail:int=1,wind_study:int=0)->vec4:
    if behind_sea(i.world,u.cam):discard()
    if i.world.y < -40.0:return vec4(u.haze*0.2,1)
    strata=vec3(0,0,0)
    if 1.0-normalize(i.normal).y>0.28:strata=ground_strata(i,u)
    footprint=max(length(vec3(fwidth(i.world.x),fwidth(i.world.y),fwidth(i.world.z))),0.01)
    normal=if coastal:normalize(i.relief_normal) else:normalize(i.normal)
    ndl=dot(render_normal(normal,i.world,u.cam),normalize(u.sun_dir))
    # (a cliff's lip or foot: the terrain triangle there runs from a flat vertex to a sheer one, so
    # the interpolated slope changes fast per metre; on an even hillside it hardly changes)
    cliff_edge=smoothstep(0.025,0.05,fwidth(1.0-normalize(i.normal).y)/footprint)
    col=ground_surface(i,u,large_terrain,coastal,footprint,strata,fwidth(strata.x),fwidth(ndl)*0.65,1.0,detail,cliff_edge,vec3(-1,0,0),wind_study)
    vec4(col.xyz*paint_paper(i.pos.xy),col.w)

# canopy_detail: the canopy's (0 the low tier's, from its own shaders, so the full path is not compiled in)
# (in shaders) the wind study's field at a render position (look.jo explains it): x the dabs' strength (0..1, the
# grass laid over in a passing cat's paw), y the gust's (0..1); dabs: 0 skips the fine layers (far ground);
# lone: 1 reads the first gust layer alone (spread to the pair's deviation), for the far ground: one texture read;
# lite: 1 (the low tier's shaders) reads one gust layer and one dab layer everywhere, blades and ground alike.
meadow_study = (local: vec2, u: GroundParams, dabs: f32, lone: f32 = 0.0, lite: int = 0) -> vec3:
    qa = local + u.meadow_a.xy
    # gust layers turned by whole-number matrices (periods 2016/sqrt 5 and 1344/sqrt 5 m)
    a = sample_lod(u.meadow_noise, vec2(2.0 * qa.x + qa.y, 2.0 * qa.y - qa.x) / 2016.0, 0.0).x
    n = 0.5 + 0.727 * (a - 0.5)
    if lite == 0 and lone < 1.0:
        qb = local + u.meadow_a.zw
        b = sample_lod(u.meadow_noise, vec2(qb.x - 2.0 * qb.y, 2.0 * qb.x + qb.y) / 1344.0, 0.0).y
        n = mix(0.62 * a + 0.38 * b, n, lone)
    gust = smoothstep(0.5, 0.72, n) * smoothstep(2.5, 10.0, u.wind.z)
    dab: f32 = 0.0
    front: f32 = 0.0
    if dabs > 0.0:
        q1 = local + u.meadow_b.xy
        q2 = local + u.meadow_b.zw
        r1 = sample_lod(u.meadow_noise, vec2(q1.x + 2.0 * q1.y, q1.y - 2.0 * q1.x) / 144.0, 0.0).z
        m = 0.5 + 0.72 * (r1 - 0.5)
        if lite == 0:
            r2 = sample_lod(u.meadow_noise, q2 / 224.0, 0.0).w
            m = 0.6 * r1 + 0.4 * r2
        dab = smoothstep(0.49, 0.71, m) * dabs
        # Broken crests move with the first dab layer. Weight the two ridges by wind heading
        # so their long side lies across the prevailing wind. Both periods divide GUST_PERIOD.
        ridge = sin(q1*vec2(0.34906585,0.39269908)+vec2(m*5.0+n*7.0,n*8.0-m*4.0))
        crest = dot(ridge,u.wind.xy*u.wind.xy)
        front = smoothstep(0.08,0.82,crest)*(0.38+0.62*gust)*dabs*smoothstep(4.0,14.0,u.wind.z)
    # dabs everywhere (the field is never still), stronger inside the gusts
    vec3(dab * (0.42 + 0.58 * gust), gust, front)

# how much of the study replaces main's waves: none in a calm or light air (those keep main's look), all of it
# from 5 m/s
meadow_study_share = (u: GroundParams) -> f32: u.meadow_c.w * smoothstep(2.5, 5.0, u.wind.z)

# the meadow wind's uniforms for a render origin (main's waves, and the study's when its Tweaks box is on)
meadow_fill = (p: GroundParams, origin: vec3) -> GroundParams:
    q = p
    q.grass_gust = meadow_gust(origin)
    q.grass_spring = meadow_spring()
    q.grass_lag = meadow_lag()
    if tweaks.wind_study_grass:
        q.meadow_a = meadow_study_gust(origin)
        q.meadow_b = meadow_study_dabs(origin)
        low = render_quality.tier == 0
        q.meadow_c = vec4(if low: 1600 else: 2600, if low: 300 else: 600, f32(meadow_travel(meadow_state.speed)), 1)
        q.meadow_noise = meadow_noise_texture()
    else:
        q.meadow_c = vec4(0,0,0,0)
        q.meadow_noise = coast_pattern_texture
    q

# (in shaders, the wind study's ground shaders only) the sheen over the meadows: main's waves in a calm or light
# air, the study's gusts from 5 m/s, which carry on to the far fields (1.4-2.6 km; 0.9-1.6 km on the low tier)
# where main's waves stop at the near envelope. The study's gusts are 100-250 m patches that never repeat over
# a hill, so they may go further. A blade passes in what it already read at its root (known).
meadow_study_sheen = (i:GroundOut,u:GroundParams,col:vec3,meadow_in:f32,near:f32,riparian:f32,y:f32,known:vec3,lite:int)->vec3:
    out = col
    study = meadow_study_share(u)
    reach = length(i.world-u.cam)
    far_meadow = meadow_in*(1.0-smoothstep(u.meadow_c.x*0.55,u.meadow_c.x,reach))*study*(1.0-riparian)
    meadow = meadow_in*near*(1.0-riparian)
    if (meadow > 0.0 or far_meadow > 0.0) and y > 3.0:
        rise = smoothstep(3.0,9.0+i.tint.x*8.0,y)
        if study < 1.0:
            wave = meadow_wave(i.world.xz,u.grass_gust,u.drift,u.wind.z,u.grass_spring,u.grass_lag)*(1.0-study)
            out += vec3(0.055,0.048,0.026)*u.sun*(wave*meadow*rise)
        if far_meadow > 0.0:
            # the gust's laid-over grass, near and far, and the dabs (a few metres across: out to 150-600 m)
            s = if known.x >= 0.0: known else: meadow_study(i.world.xz,u,1.0-smoothstep(u.meadow_c.y*0.25,u.meadow_c.y,reach),smoothstep(u.meadow_c.y*0.5,u.meadow_c.y,reach),lite)
            out += vec3(0.055,0.048,0.026)*u.sun*(s.y*2.2+s.x*2.6+s.z*1.8)*far_meadow*rise
    out

ground_surface=(i:GroundOut,u:GroundParams,large_terrain:bool,coastal:bool,footprint:f32,strata:vec3,bed_width:f32,light_width:f32,blade_response:f32=1.0,canopy_detail:int=1,cliff_edge:f32=0.0,study_known:vec3=vec3(-1,0,0),wind_study:int=0)->vec4:
    # The sea is fully opaque above this depth, including clear coves. Keep
    # its occluding geometry/depth, but do not shade hidden offshore seabed.
    if i.world.y < -40.0: return vec4(u.haze*0.2,1)
    world = i.world+u.origin
    n = normalize(i.normal)
    y = i.world.y
    slope = 1.0 - n.y                                  # 0 flat, 1 a wall
    stone = vec3(0.84,0.79,0.69)
    # Flat ground is fully vegetated, sand or scree below; do not shade hidden
    # limestone strata there. Gentle orchard terraces use an even stone wash.
    # (along the face, horizontally: for streaks that hang down a cliff and ledges that come and go)
    along = dot(world.xz,normalize(vec2(-n.z,n.x)+vec2(0.0001,0)))
    if slope > 0.28:
        # Limestone in stacked beds, as the film paints a cliff: each bed its own cream or warm
        # grey, its foot a lit lip, and under the lip of the bed above a cool grey-violet shadow;
        # the ledges come and go along the face, some beds run together (no even stripes). The
        # oblique fractures (the strata's wave) stagger the bed boundaries.
        fracture=strata.y
        beds = strata.x*0.62
        bed = floor(beds); f = beds-bed
        bw = bed_width*0.62
        tone = fract(sin(bed*12.9898+0.7)*43758.547)
        visible = 1.0-smoothstep(0.35,0.9,bw)
        under: f32 = 0.0; lip: f32 = 0.0; held: f32 = 0.0; ledge: f32 = 0.5
        # (the ledges' and tufts' lookups only where the beds are resolved)
        if visible > 0.0 and canopy_detail > 0:
            ledge = sample(u.pigment,vec2(along/64.0,bed*0.37)).w
            held = smoothstep(0.3,0.55,fract(sin((bed+1.0)*7.233)*9341.37))*smoothstep(0.35,0.6,ledge)
            under = smoothstep(0.70,0.95,f)*(1.0-smoothstep(0.97,1.0,f))*held
            lip = (1.0-smoothstep(0.0,0.09,f))*held
        stone = mix(vec3(0.93,0.89,0.79),vec3(0.79,0.72,0.59),mix(0.45,tone*0.8+(fracture+0.2)*0.4,visible))
        stone = mix(stone,vec3(0.50,0.50,0.62),under*0.72*visible+0.07*(1.0-visible))
        stone = mix(stone,vec3(1.0,0.97,0.90),lip*0.45*visible)
        stone = mix(stone,vec3(0.86,0.70,0.46),i.tint.y*0.3)
        # (green tufts rooted on the ledges, more of them up toward the top)
        # (tufts from the ledge's own wash and a wave along it: no further lookup)
        if held*visible > 0.0 and canopy_detail > 0:
            clump = fract(ledge*7.3+sin(along*0.7+bed*2.1)*0.5)
            tuft = smoothstep(0.72,0.86,clump)*(1.0-smoothstep(0.02,0.24,f))*held*visible
            stone = mix(stone,vec3(0.22,0.34,0.19),tuft*smoothstep(0.2,0.75,1.0-slope+0.3)*0.85)
    if large_terrain:
        # (the strata are cliffs' and steep slopes': on gentler bare ground they would draw the
        # height's contours like wood grain; there the stone is a mottled scree, greyer up high)
        flat_rock = 1.0 - smoothstep(0.3, 0.6, slope)
        scree = mix(vec3(0.8, 0.77, 0.7), vec3(0.62, 0.6, 0.55), vnoise(world.xz * 0.004) * 0.6 + i.tint.y * 0.4)
        stone = mix(stone, scree, flat_rock)
        stone = mix(stone, stone * vec3(0.86, 0.87, 0.9), smoothstep(1500.0, 2500.0, y))
    resolved = 1.0-smoothstep(1.5,6.0,footprint)
    sand = vec3(0.78,0.71,0.55)
    wet = vec3(0.78,0.72,0.56)
    c = stone
    canopy = vec4(0.5,1,0.5,0.5)
    woody: f32 = 0.0
    veg: f32 = 0.0
    dry: f32 = 0.0
    crease: f32 = 0.0
    canopy_bend = vec2(0,0)
    canopy_lit: f32 = 0.0
    canopy_offset: f32 = 0.0
    canopy_shadow: f32 = 0.0
    field_shadow: f32 = 0.0
    farmed: f32 = 0.0
    # Underwater the wet sand/rock branch replaces every land contribution.
    if y >= (if coastal: 0.25 else: 0.6):
        canopy = sample(u.pigment,world.xz/320.0)
        ridge = i.tint.z*2.0-1.0
        crease = smoothstep(0.05,-0.6,ridge)
        # Expand the baked field's narrow middle range into distinct patches;
        # averaging the covers everywhere merely trades uniform green for tan.
        # (the pigment tile's wash is a sum of sinusoids: over the mainland's open
        # country it rippled every patch edge into a regular herringbone from the air)
        # The mainland reuses its field noise below, so this costs no extra lookups.
        wash = canopy.w
        broad: f32 = 0.5
        if large_terrain:
            broad = vnoise(world.xz*0.006)
            wash = 0.5+(broad-0.5)*0.8
        field = i.tint.x*0.65+wash*0.35+(i.tint.y-0.5)*0.25
        patch = smoothstep(0.30,0.67,field)
        cover = summer_cover(n,y,ridge,patch)
        dry = cover.x; woody = cover.y+cover.z
        grass = mix(vec3(0.49,0.47,0.30),vec3(0.69,0.57,0.35),dry)
        maquis = mix(vec3(0.24,0.32,0.23),vec3(0.40,0.43,0.31),i.tint.y)
        pine = mix(vec3(0.10,0.22,0.16),vec3(0.19,0.28,0.18),i.tint.x)
        green = grass*(1.0-woody)+maquis*cover.y+pine*cover.z
        if large_terrain:
            # (the country's lowlands are a summer patchwork: dry golden grass and fields on the flats
            # among the olive and the maquis; up the mountains, dark pine and then fir)
            flats = (1.0 - smoothstep(0.04, 0.16, slope)) * (1.0 - smoothstep(300.0, 900.0, y))
            fields = smoothstep(0.35, 0.65, vnoise(world.xz * 0.0011) * 0.7 + broad * 0.3)
            green = mix(green, mix(vec3(0.62, 0.55, 0.3), vec3(0.5, 0.48, 0.24), i.tint.x), flats * fields * (1.0 - crease * 0.7) * 0.75)
            forest = smoothstep(500.0, 1100.0, y) * (1.0 - smoothstep(1800.0, 2200.0, y))
            green = mix(green, mix(vec3(0.08, 0.2, 0.1), vec3(0.11, 0.24, 0.13), i.tint.x), forest * 0.8)
            alpine = smoothstep(1800.0, 2200.0, y)
            green = mix(green, vec3(0.5, 0.5, 0.33), alpine * 0.7)
        # Broad outcrops on steep faces, not bright slivers tracing every
        # eroded ridge. Intermediate slopes carry ochre scree; bare limestone
        # is reserved for continuous cliff faces and irregular exposed patches.
        outcrop = smoothstep(0.62,0.79,i.tint.y)*smoothstep(0.15,0.4,slope)
        exposure = max(smoothstep(0.26,0.72,slope+(patch-0.5)*0.26),outcrop*0.78)
        # (medium slopes on a cliff's lip and foot are its stone, not ochre scree: each terrain
        # triangle between a flat and a sheer vertex otherwise painted a tan sawtooth along it)
        cliff = max(smoothstep(mix(0.48,0.30,cliff_edge),mix(0.78,0.50,cliff_edge),slope),outcrop*0.7)
        scree = mix(vec3(0.60,0.54,0.40),stone,0.25+cliff*0.75)
        stone = mix(scree,stone,max(cliff,cliff_edge))
        veg = (1.0-exposure)*smoothstep(0.6,1.5,y)
        if large_terrain: veg *= i.tint.w    # high land reuses bare limestone
        # Where cliff meets the green above it, no hard line along the terrain's triangles: the
        # scrub hangs over the edge in ragged tongues (a vertically drawn-out wash breaks the
        # boundary), a band of bare soil shows between it and the rock, and below the lip the
        # rock is stained by roots and run-off in streaks.
        # (only a cliff's lip and foot and the face itself: an ordinary hillside skips all of it)
        if slope > 0.3 or (cliff_edge > 0.0 and slope > 0.08):
            # (low tier: a cheap wave along the face instead of the wash's lookup)
            drip = if canopy_detail > 0: sample(u.pigment,vec2(along/13.0,i.world.y/26.0)).w else: 0.5+0.25*sin(along*0.31+i.world.y*0.11)+0.15*sin(along*0.83-i.world.y*0.05)
            # (scrub only on gentle ground, decided per pixel with a drawn-out wash: across a terrain
            # triangle from the plateau's edge down to the face, the green stops close to the
            # plateau's line instead of half way down, so the 14 m triangles draw no sawteeth)
            gentle = 1.0-smoothstep(0.19,0.31,slope+(drip-0.5)*0.24)
            ragged = clamp((mix(veg,min(veg,gentle),cliff_edge)-0.5)*2.4+0.5+(drip-0.5)*0.9,0.0,1.0)
            soil = smoothstep(0.1,0.32,ragged)*(1.0-smoothstep(0.35,0.6,ragged))*cliff_edge
            veg = smoothstep(0.35,0.6,ragged)
            stone = mix(stone,mix(vec3(0.50,0.38,0.24),vec3(0.42,0.36,0.24),drip),soil*0.85)
            # (a cliff's foot is rock down to the water: below a line a few metres up, wavering along
            # the shore, any ground that is not a flat beach is bare stone, darker and wet at the
            # waterline; no scrub or scree in sawteeth between the beach's vertices and the face's)
            if y < 10.0:
                footline = 4.0+(drip-0.5)*6.0
                foot = (1.0-smoothstep(footline-1.5,footline+1.5,y))*smoothstep(0.1,0.22,slope)
                veg *= 1.0-foot
                awash = 1.0-smoothstep(0.4,1.8,y)
                stone = mix(stone,mix(vec3(0.70,0.66,0.58),vec3(0.42,0.42,0.40),awash),foot*0.85)
            lipzone = (1.0-veg)*(1.0-smoothstep(0.45,0.85,slope))*smoothstep(6.0,14.0,y)
            # (streaks hanging from the lip: a wave along the face, stretched down it)
            streak: f32 = 0.5
            if canopy_detail > 0: streak = smoothstep(0.35,0.8,0.5+0.3*sin(along*3.1+drip*5.0)+0.2*sin(along*1.37-i.world.y*0.05))
            stone = mix(stone,stone*vec3(0.66,0.64,0.70),lipzone*(0.3+streak*0.45))
        c = mix(stone, green, veg)
        # The farmed land (src/fields.jo): straight-edged fields of flat crop colour over the gentle
        # country, the same on every tier. The terrain's working channel holds each sample's field
        # colour and share (baked, src/world_terrain.jo; per vertex on the old islands); the field
        # map (src/field_map.jo) holds the layout: hedgerows and tree lines on a share of the
        # field edges, casting their shadows, lanes, and the thin edges where fields meet.
        farmed = i.working.w*veg
        c = mix(c,i.working.xyz,farmed)
        if farmed > 0.01 and footprint < 6.0:
            rel = world.xz-u.field_window.xy
            if rel.x > 0.0 and rel.y > 0.0 and rel.x < u.field_window.z and rel.y < u.field_window.z:
                m = sample(u.field_map,world.xz/u.field_window.w)
                seen = clamp((6.0-footprint)*0.25,0.0,1.0)*farmed
                c = mix(c,vec3(0.74,0.67,0.50),m.y*seen)
                c *= 1.0-m.z*0.22*seen
                c = mix(c,mix(vec3(0.09,0.20,0.11),vec3(0.16,0.29,0.14),hash21(floor(world.xz/7.0))),m.x*seen)
                field_shadow = m.w*seen
        # (far off, the tree lines below a pixel: their share of the fields, darker)
        c *= 1.0-0.06*farmed*clamp((footprint-3.0)*0.25,0.0,1.0)
        # The far canopy (src/canopy.jo): the maquis as scattered-to-closed crowns, the groves'
        # own pines among them; its crowns light by their own rounded normals below. A stand
        # thins out into the dry grass over some tens of metres past the summer cover's edge
        # (canopy_stand), so outlying crowns stand in the savanna.
        stand = max(woody,canopy_stand(n,ridge,field))*veg*(1.0-i.orchard*0.7)*(1.0-farmed*0.92)
        if canopy_detail == 0:
            c = canopy_paint_low(c,n,world.xz,y,footprint,i.tint.x,stand,length(i.world-u.cam),u.canopy_light,u.canopy,u.grove)
        else:
            paint = canopy_paint(c,n,world.xz,y,footprint,i.tint.x,stand,length(i.world-u.cam),normalize(u.sun_dir),u.canopy_light,u.canopy,u.grove)
            c = paint.color
            canopy_bend = paint.bend; canopy_lit = paint.crown; canopy_offset = paint.offset; canopy_shadow = paint.shadow
        # Parcels vary over hundreds of metres: vertex interpolation is sufficient
        # here. Broad rock/cover transitions above remain per fragment.
        orchard = i.orchard
        if orchard > 0.01:
            row = abs(fract(y/4.5+0.5)-0.5)*4.5
            terrace = (1.0-smoothstep(0.12,0.55,row))*smoothstep(0.03,0.1,slope)
            # (where the fields are drawn, their olive rows stand for the terraces)
            c = mix(c,mix(vec3(0.55,0.49,0.29),stone*0.85,terrace),orchard*veg*0.6*(1.0-farmed*0.85))
        # Erosion clamps inland basins to 1.5 m. End sand below that shelf,
        # with maquis immediately behind it, rather than flooding the basins.
        beach = (1.0 - smoothstep(0.65, 1.35, y)) * (1.0 - smoothstep(0.035, 0.12, slope))
        c = mix(c, sand, beach)
    if y < (if coastal: 0.9 else: 0.6):
        shore_color = mix(wet, sand * 0.9, clamp(y + 0.4, 0.0, 1.0))
        shore_color = mix(shore_color, stone * 0.8, smoothstep(0.35, 0.6, slope))
        c = if coastal: mix(c,shore_color,1.0-smoothstep(0.25,0.9,y)) else: shore_color
        # Offshore opaque water hides this material. Restrict its extra work
        # to the shallow seabed and filter fine blades out in the distance.
        if y < -0.5 and y > -38.0 and length(i.world-u.cam) < 650.0:
            # Reuse the smooth procedural noise tile at broad and fine scales,
            # rather than rebuilding five value-noise fields per seabed pixel.
            bed = if coastal: sample(u.coast_pattern,world.xz/448.0)*2.0-vec4(0.5,0.5,0.5,0) else: vec4(0,0,0,0)
            bed_fine = if coastal: sample(u.coast_pattern,world.xz/112.0)*3.0-vec4(1,1,1,0) else: vec4(0,0,0,0)
            # (a second, rotated and incommensurate lookup breaks the 448 m tile: weed beds and
            # stones scatter instead of repeating one camouflage of blotches)
            turned = vec2(world.x*0.8-world.z*0.6,world.x*0.6+world.z*0.8)
            bed2 = if coastal and canopy_detail > 0: sample(u.coast_pattern,turned/173.0)*2.0-vec4(0.5,0.5,0.5,0) else: if coastal: vec4(bed.z,bed.x,bed.y,0) else: vec4(0,0,0,0)
            patch = if coastal: bed.x*0.55+bed2.y*0.5+bed.y*0.15 else: vnoise(world.xz*0.045)+vnoise(world.xz*0.23)*0.25
            # (weed beds only in some stretches, each bed broken by holes: long runs of clean sand)
            meadow_here = if coastal: smoothstep(0.62,0.8,bed2.z+bed.z*0.4) else: 1.0
            holes = if coastal: smoothstep(0.25,0.55,bed_fine.y) else: 1.0
            grass_bed = smoothstep(0.74,0.88,patch)*meadow_here*holes*smoothstep(0.5,2.5,-y)*(1.0-smoothstep(22.0,38.0,-y))
            blades: f32 = 0.96
            if resolved > 0.0:
                fine = if coastal: bed_fine.x else: vnoise(world.xz*1.7+vec2(u.time*0.02,0))
                blades += (fine-0.5)*0.08*resolved
            c = mix(c,vec3(0.22,0.40,0.32)*blades,grass_bed*0.5)
            rocks = smoothstep(0.80,0.9,if coastal: bed_fine.z*0.6+bed2.x*0.5 else: vnoise(world.xz*0.18+vec2(17,9)))
            c = mix(c,vec3(0.36,0.42,0.40),rocks*(if coastal: 0.5 else: 0.7))
            # (the sand under the water is warm gold, paling to the shore)
            # (the sand under the water is pale, nearly white: the water's colour carries it)
            c = mix(c,vec3(0.92,0.89,0.79),(1.0-grass_bed*0.6)*(1.0-rocks*0.55)*0.5)
        # (seen through the water the seabed takes the water's colour, bluer and greener with depth:
        # the film's cove is turquoise over its sand, gold only at the very edge)
        if y < -0.2: c = c*mix(vec3(1,1,1),mix(vec3(0.74,0.96,0.97),vec3(0.36,0.80,0.90),smoothstep(2.0,8.0,-y)),smoothstep(0.2,2.0,-y))
    # close up: patches of lighter and darker growth, bare earth, small stones
    near = 1.0 - smoothstep(60.0, 260.0, length(i.world - u.cam))
    if near > 0.0:
        # (the fine growth streams past faster than the ground when going fast, as the sea's
        # detail does: two copies slid and crossfaded)
        q = world.xz
        pn = sample(u.pigment,q/24.0).w
        if length(u.flow.xy) > 0.01:
            ph = u.time / u.flow.z
            pa = ph - floor(ph)
            ph2 = ph + 0.5
            pb2 = ph2 - floor(ph2)
            wa = 1.0 - abs(2.0 * pa - 1.0)
            qa = q + u.flow.xy * ((pa - 0.5) * u.flow.z)
            qb = q + u.flow.xy * ((pb2 - 0.5) * u.flow.z)
            na = sample(u.pigment,qa/24.0).w
            nb = sample(u.pigment,qb/24.0).w
            pn = 0.5 + ((na - 0.5) * wa + (nb - 0.5) * (1.0 - wa)) / sqrt(wa * wa + (1.0 - wa) * (1.0 - wa))
        pb = sample(u.pigment,world.xz/96.0+vec2(7,1)).w*2.0-0.5
        detail = mix(vec3(0.82, 0.86, 0.78), vec3(1.15, 1.12, 0.95), pn)
        earth = smoothstep(0.68, 0.8, pb) * veg
        c = mix(c, c * detail, near)
        c = mix(c, vec3(0.55, 0.45, 0.32), earth * near * 0.55)
    if large_terrain and y>0.5:
        road=road_coverage(u.roads,u.road_rect,i.world.xz,footprint)
        c=mix(c,vec3(0.82,0.75,0.58),road);veg*=1.0-road;canopy_lit*=1.0-road;canopy_shadow*=1.0-road
    riparian:f32=0.0
    if large_terrain and i.river.x>0.0:
        riparian=i.river.x
        moist=mix(vec3(0.23,0.34,0.15),vec3(0.34,0.40,0.19),i.tint.x)
        alluvial=mix(vec3(0.47,0.43,0.33),moist,smoothstep(0.4,2.8,i.river.y))
        c=mix(c,alluvial,riparian)
    if large_terrain and u.lake_area.z>0.0:
        luv=(i.world.xz-u.lake_area.xy)/u.lake_area.zw
        if luv.x>0.0 and luv.x<1.0 and luv.y>0.0 and luv.y<1.0:
            bank=sample(u.lake_map,luv)
            distance=bank.x*128.0-64.0
            strip=(1.0-smoothstep(3.0,22.0,abs(distance)))*smoothstep(0.51,0.72,bank.y)
            bank_wet=1.0-smoothstep(-3.0,2.0,-distance)
            pebble=mix(vec3(0.55,0.52,0.42),vec3(0.38,0.40,0.32),bank_wet*0.55)
            pebble=mix(pebble,vec3(0.61,0.59,0.51),bank.z*0.3)
            c=mix(c,pebble,strip);veg*=1.0-strip;canopy_lit*=1.0-strip;canopy_shadow*=1.0-strip
            # Reed beds in the shallows and on the wet margin, in patches.
            reed=(1.0-smoothstep(5.0,13.0,abs(distance-3.0)))*smoothstep(0.64,0.78,bank.y)
            c=mix(c,mix(vec3(0.37,0.42,0.20),vec3(0.46,0.47,0.26),bank.z),reed*0.85)
    # light: a painted two-tone, with the sky's fill and a cool shade
    # Microrelief changes light, not the broad sand/grass/rock classification.
    # Reclassifying every tiny tilted facet produced hard, flat rubble decals
    # and ran the cliff material over otherwise gentle beach ground.
    light_normal = if coastal: normalize(i.relief_normal) else: n
    # (bare rock on a steep face lit as one bold plane by the way it faces, not by normals blended
    # across a 14 m triangle from its plateau and beach vertices, which smeared soft dark wedges
    # over the cliff)
    facing2 = vec2(n.x,n.z); reach = length(facing2)
    if canopy_detail > 0 and slope > 0.3 and reach > 0.2:
        plane = normalize(vec3(facing2.x/reach,0.6,facing2.y/reach))
        light_normal = normalize(mix(light_normal,plane,smoothstep(0.3,0.55,slope)*(1.0-veg)))
    rn = render_normal(light_normal, i.world, u.cam)
    # (the land's held-low modelling light, taken per vertex: per pixel it cost low more than
    # half a millisecond on redfox's terrain-filled views; slopes are broad enough for vertices)
    ndl = dot(rn, normalize(u.sun_dir))
    # (medium and high: low's terrain shader sits at a register-pressure cliff on redfox's GPU,
    # where this with the fields' colour cost half a millisecond; each alone cost nothing)
    if canopy_detail > 0: ndl = mix(ndl,i.land,u.land_light.w)
    lit = paint_ramp(ndl,max(light_width,if coastal: 0.08 else: 0.015))
    # (bare rock on a cliff in bold planes, as the film paints it: a crisp terminator, nudged by the
    # beds so a shadow's edge steps along the ledges, instead of light fading softly across each
    # 14 m column of the face, which read as dark smears)
    if canopy_detail > 0 and slope > 0.3:
        bold = smoothstep(-0.1,0.1,ndl+strata.y*0.18)
        lit = mix(lit,bold,smoothstep(0.35,0.6,slope)*(1.0-veg)*0.6)
    # The canopy's crowns: each lit by its own rounded normal on the slope, through a wrapped
    # painted ramp (the terminator shifted a little crown to crown, as a brush would place it).
    if canopy_detail > 0 and canopy_lit > 0.0:
        crown_normal = normalize(vec3(light_normal.x+canopy_bend.x*0.9,light_normal.y,light_normal.z+canopy_bend.y*0.9))
        # (by the canopy's modelling light, held low at every hour, faded with the sun)
        cdl = mix(dot(render_normal(crown_normal,i.world,u.cam),normalize(u.sun_dir)),dot(render_normal(crown_normal,i.world,u.cam),u.canopy_light.xyz),u.canopy_light.w)
        crown_lit = paint_ramp((cdl+0.28)/1.28+canopy_offset,max(light_width,0.05))
        lit = mix(lit,crown_lit,canopy_lit)
    if canopy_detail > 0: lit *= 1.0-canopy_shadow*(1.0-canopy_lit*0.3)
    # (a hedgerow's shadow: no sun there, the sky's light only)
    lit *= 1.0-field_shadow*0.75
    shade = mix(u.shade,vec3(dot(u.shade,vec3(0.22,0.62,0.16))),(1.0-veg)*0.28)
    light = mix(shade*vec3(0.94,1.08,1.1)+vec3(0.06,0.07,0.09)*min(u.sun,vec3(1,1,1)),u.sun*vec3(1.02,1.0,0.94),lit)
    col = c * light
    # seabed: caustic shimmer in the shallows
    # (a drifting network of thin bright lines where two incommensurate fields cross, the light
    # focused by the surface, metre-sized; faded where a pixel spans more than a fraction of a cell
    # and with depth, never a regular weave)
    if y < 0.0 and coastal and canopy_detail > 0 and footprint < 0.4:
        drift = vec2(u.time*0.07,u.time*0.05)
        q = world.xz
        a1 = sample(u.coast_pattern,q/5.3+drift).x
        a2 = sample(u.coast_pattern,vec2(q.x*0.8-q.y*0.6,q.x*0.6+q.y*0.8)/3.7-drift*1.3).y
        net = 1.0-smoothstep(0.0,0.07,abs(a1-a2))
        fade = (1.0-smoothstep(0.08,0.4,footprint))*clamp(1.0+y*0.18,0.0,1.0)*smoothstep(0.0,0.4,-y)
        col = col*(1.0+net*0.4*fade)
    # Contrast affects diffuse colour only; sheen is common to both surfaces.
    col*=blade_response
    # the wind over the grass: gusts sweep across the meadows as waves of paler, bent blades
    meadow = veg * (1.0 - smoothstep(0.15, 0.4, slope)) * (0.45 + 0.55 * dry) * (1.0 - crease * 0.6)
    # The wind wash and blade-mean tint share the near-detail envelope on
    # mainland and islands: unchanged to 60 m, absent by 260 m. Neither may
    # repeat over whole hills from altitude.
    if wind_study > 0:
        col = meadow_study_sheen(i,u,col,meadow,near,riparian,y,study_known,if wind_study == 2: 1 else: 0)
    else:
        meadow *= near
        # Coastal maquis replaces the old bare shelf, not a new grass meadow.
        # Retain the original height envelope for the animated grass wash.
        meadow*=1.0-riparian
        if meadow > 0.0 and y > 3.0:
            meadow *= smoothstep(3.0,9.0+i.tint.x*8.0,y)
            # Advect the broad pigment wash with the same wind drift. Two layers
            # of per-fragment hash noise read as digital mottling at aerial scale.
            wave = meadow_wave(i.world.xz,u.grass_gust,u.drift,u.wind.z,u.grass_spring,u.grass_lag)
            col += vec3(0.055,0.048,0.026)*u.sun*(wave*meadow)
            # This is also the blade-root colour. No separate grass palette or
            # distant tint: the root-tip response is normalized in the blade shader.
    vec4(land_aerial(col, i.world, u.cam, u.haze, u.fog, u.land_steps), 1)

# Both terrain paths share the same coastal and vegetation material rules.
ground_fs_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    ground_fs(i, u)

ground_fs = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,false)
ground_fs_low_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    ground_fs_low(i, u)

ground_fs_low = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,false,false,0)
ground_fs_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    ground_fs_ws(i, u)

ground_fs_ws = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,false,false,1,1)
ground_fs_low_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    ground_fs_low_ws(i, u)

ground_fs_low_ws = (i: GroundOut,u: GroundParams) -> vec4: ground_material(i,u,false,false,0,2)
ground_sh_ws: Shader

ground_sh: Shader

draw_ground = (L: Light, t: f64):
    global terrain_draws, terrain_triangles, terrain_visible, terrain_upload, terrain_report, terrain_prepare
    global coast_triangles,coast_instances,coast_draws
    begin_coast_frame()
    zone("terrain")
    prepare_start = time()
    terrain_prepare = 0.0
    vp = scene_view_proj()
    cam = scene_camera()
    update_field_map(cam,canopy_light(L.sun_dir))
    # Length of the vertical projection row removes camera rotation, leaving
    # cot(fov/2). Use the full viewport, including zoom/chase FOV changes.
    focal = f64(length(vec3(vp[0].y, vp[1].y, vp[2].y))) * f64(screen_height()) * 0.5
    select_terrain(cam, vp, focal, t)
    planes = land_planes(vp)
    origin = render_origin(cam)
    relative_vp = render_view_proj(origin)
    terrain_draws = 0; terrain_triangles = 0; terrain_visible = 0; terrain_upload = 0
    loop tile in terrain_tiles:
        batches: TerrainInstance[][] = [loop i in 0..96: []]
        coastal: CoastInstance[][] = [loop i in 0..COAST_LEVELS: []]
        loop patch in tile.patches:
            p = patch.data
            refined = coast_enabled and patch.lod == 0.0 and p.low < 192.0 and p.high > -10.0 and coast_patch_near(tile.x+f64(p.x)*14.0,tile.z+f64(p.z)*14.0,448.0,cam,focal/render_quality.terrain_error)
            if not land_visible(tile, p, cam, planes,refined): continue
            lev = min(int(floor(patch.lod)), 5)
            edges = vec4(f32(patch.lod), f32(patch.lod), f32(patch.lod), f32(patch.lod))
            mask = 0
            loop side in 0..4:
                nb = patch.neighbor[side]
                if nb < 0: continue
                other = tile.patches[nb].lod
                e = f32(max(patch.lod, other))
                match side:
                    0: edges.x = e
                    1: edges.y = e
                    2: edges.z = e
                    _: edges.w = e
                if int(floor(other)) < lev: mask = mask | (1 << side)
            if refined:
                coast_add_patch(coastal,tile.cpu_heights,tile.heights.width,tile.heights.height,tile.x,tile.z,p.x,p.z,32,vec2(0,0),cam,origin,focal/render_quality.terrain_error,planes,source_id=tile.heights.id)
                terrain_visible += 1
                continue
            at = vec2(f32(tile.x + f64(p.x) * MESH_STEP - f64(origin.x)), f32(tile.z + f64(p.z) * MESH_STEP - f64(origin.z)))
            batches[lev * 16 + mask].push(TerrainInstance(at, vec2(f32(p.x), f32(p.z)), vec2(f32(1 << lev), f32(patch.lod - f64(lev))), edges))
            terrain_visible += 1
        params = GroundParams(relative_vp, render_eye(origin), L.sun_dir, L.sun, L.sky_top, L.shade, air_down(L.haze, f64(cam.y), tweaks.brighter_ocean), f32(L.fog_density), f32(t),
            meadow_wind(wind_now, origin), meadow_gust_w(origin), origin, tile.heights, tile.materials, scene_flow, vec4(scene_warp_a.x - origin.x, scene_warp_a.y - origin.z, scene_warp_a.z, scene_warp_a.w), scene_warp_b)
        params.pigment = paint_surface()
        params.canopy = canopy_sheet()
        params.field_map = field_map_texture(); params.field_window = field_map_window
        # (the islands' groves have their own placement: their painted crowns stand among them)
        params.grove = grove_islands()
        params.canopy_light = canopy_light(L.sun_dir)
        params.land_light = land_light(L.sun_dir)
        params.land_steps = if tweaks.painted_layers: 1.0 else: 0.0
        params.land_palette = field_palette
        params.coast_pattern = coast_pattern_texture
        params = meadow_fill(params, origin)
        params.river_map = unread_map(); params.lake_map = unread_map()
        params.working_map = tile.working
        terrain_prepare += time() - prepare_start
        draw_coast_batches(coastal,params)
        loop i in 0..96:
            if batches[i].len() == 0: continue
            draw_instanced(if params.meadow_c.w > 0.0: ground_sh_ws else: ground_sh, terrain_grids[i], batches[i], params)
            terrain_draws += 1
            terrain_triangles += terrain_grids[i].index_count / 3 * batches[i].len()
            terrain_upload += batches[i].len() * 40
        prepare_start = time()
    if startup_aegean_lod_stats != none and (terrain_report < 0.0 or t - terrain_report > 1.0):
        print("LOD patches={terrain_visible} draws={terrain_draws} triangles={terrain_triangles} coast_triangles={coast_triangles} coast_cells={coast_instances} instance_bytes={terrain_upload} select_us={terrain_selection * 1000000.0:.1} prepare_us={terrain_prepare * 1000000.0:.1}")
        terrain_report = t
    zone_end()

init_terrain = ():
    global ground_sh,coast_sh,coast_world_sh
    init_coast_atlas()
    low = render_quality.tier == 0
    ground_sh = make_shader(if low: world_shader(shader(ground_vs, ground_fs_low), shader(ground_vs, ground_fs_low_log)) else: world_shader(shader(ground_vs, ground_fs), shader(ground_vs, ground_fs_log)))
    init_coast_mesh()
    reset_coast_selection()
    coast_sh = make_shader(if low: world_shader(shader(coast_vs, coast_fs_low), shader(coast_vs, coast_fs_low_log)) else: world_shader(shader(coast_vs, coast_fs), shader(coast_vs, coast_fs_log)))
    coast_world_sh = make_shader(if low: world_shader(shader(coast_vs, coast_world_fs_low), shader(coast_vs, coast_world_fs_low_log)) else: world_shader(shader(coast_vs, coast_world_fs), shader(coast_vs, coast_world_fs_log)))
