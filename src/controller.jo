# Gamepads and flight sticks: what a controller asks of the game, read through one thin layer.
#
# Two kinds of device, each with a profile of its own (both kept with the options):
#   gamepad       a standard layout (the browser's standard mapping, Xbox-style names): the left
#                 stick flies (pitch and roll), the bumpers are the rudder, the triggers open and
#                 close the throttle, the right stick looks about; the buttons are the game's keys.
#   flight stick  any other device (a stick, a HOTAS throttle, pedals), read by its own numbered
#                 axes and buttons: stick X and Y, a throttle lever, the rudder (twist or pedals),
#                 the hat to look about. A binding names its device, so a stick, a throttle and a
#                 set of pedals plugged in together each give their part.
# Every axis has its dead zone, response curve, sensitivity and inversion. The game reads
# `ctl`: the flight axes, the look, and virtual keys held and pressed (the same keys the keyboard
# and the touch pad give, through vdown and vpressed), sorted by where the player is: in the air,
# on the water, on foot, or in a menu (where the d-pad and A and B are the arrows, Enter and
# Escape). The bindings are changed on the pause menu's Controls page, by moving the control.
#
# Tests and captures need no hardware: controller_inject puts a synthetic device in (a standard pad
# or a flight stick, with its axes and buttons set by hand), and SLOPPY_INPUT's pad items
# (5:lstick=0x1, 5:rt=1, 5:pad_a+) drive a standard pad through Sloppy itself.

# what a binding reads: kind 0 nothing, 1 a standard pad's button, 2 a standard pad's axis, 3 a
# device's own button, 4 a device's own axis. dir: for an axis, 1 or -1 to use one way of it only
# (a half), 0 the whole of it. device: a device's own controls, by the device's name ("" any).
struct Bind:
    kind = 0
    index = 0
    dir = 0
    device = ""

# one of the flight's axes: the input (and, for a pair of buttons or triggers, the one taking it
# the other way), and how it answers
struct AxisSet:
    bind: Bind = Bind()
    neg: Bind = Bind()
    invert = false
    deadzone = 0.12
    gain = 1.0                      # sensitivity: the most it gives, past the dead zone (x)

# the axes, in this order
AXIS_NAMES = ["Pitch", "Roll", "Rudder", "Throttle lever", "Throttle up/down", "Look across", "Look up/down"]
const AX_PITCH = 0
const AX_ROLL = 1
const AX_RUDDER = 2
const AX_LEVER = 3
const AX_THROTTLE = 4
const AX_LOOK_X = 5
const AX_LOOK_Y = 6
const AXES = 7

# the buttons: what each does (the game's key it presses) and where (1 in the air, 2 on the
# water, 4 on foot)
ACTION_NAMES = ["Guns (water brake)", "Camera view", "Clutch / wheels", "Bail out / parachute", "Gun safety", "Look ahead", "Interact", "Run", "Pause", "Chart", "Log", "Controls card", "Towed home"]
ACTION_KEYS: Key[] = [.space, .v, .x, .t, .g, .home, .f, .shift, .p, .m, .j, .h, .r]
ACTION_WHERE = [3, 3, 3, 7, 3, 3, 7, 4, 7, 7, 7, 7, 3]
const ACTIONS = 13

struct ControlProfile:
    axes: AxisSet[]
    buttons: Bind[]
    curve = 1.6                     # response curve: 1 straight, higher gentler about the middle

# the controls kept with the options: both profiles, and which a device counts as
struct ControlsConfig:
    pad: ControlProfile = pad_defaults()
    stick: ControlProfile = stick_defaults()
    kind = 0                        # 0 by its name, 1 every device a gamepad, 2 every device a flight stick

_pb = (b: PadButton) -> Bind: Bind(kind = 1, index = int(b))
_pa = (i: int, dir: int = 0) -> Bind: Bind(kind = 2, index = i, dir = dir)
_rb = (i: int) -> Bind: Bind(kind = 3, index = i)
_ra = (i: int, dir: int = 0) -> Bind: Bind(kind = 4, index = i, dir = dir)

pad_defaults = () -> ControlProfile:
    axes = [
        AxisSet(bind = _pa(1)),                                     # pitch: the left stick back climbs
        AxisSet(bind = _pa(0)),                                     # roll
        AxisSet(bind = _pb(.rb), neg = _pb(.lb), deadzone = 0.0),   # rudder: the bumpers
        AxisSet(),                                                  # (no lever on a gamepad)
        AxisSet(bind = _pa(5), neg = _pa(4), deadzone = 0.06),      # throttle: RT opens, LT closes
        AxisSet(bind = _pa(2), deadzone = 0.18),                    # look: the right stick
        AxisSet(bind = _pa(3), deadzone = 0.18)]
    buttons = [_pb(.x), _pb(.y), _pb(.b), _pb(.down), _pb(.up), _pb(.rstick), _pb(.a), _pb(.b), _pb(.start), _pb(.back), _pb(.right), _pb(.lstick), _pb(.left)]
    ControlProfile(axes, buttons)

# (most sticks number them so: X, Y, the twist, the throttle, the hat's two axes; the trigger first)
stick_defaults = () -> ControlProfile:
    axes = [
        AxisSet(bind = _ra(1), deadzone = 0.04),
        AxisSet(bind = _ra(0), deadzone = 0.04),
        AxisSet(bind = _ra(2), deadzone = 0.08),
        AxisSet(bind = _ra(3), invert = true, deadzone = 0.02),     # (pushed forward: open)
        AxisSet(),
        AxisSet(bind = _ra(4), deadzone = 0.3),
        AxisSet(bind = _ra(5), deadzone = 0.3)]
    buttons = [_rb(0), _rb(2), _rb(3), _rb(5), _rb(4), _rb(9), _rb(1), Bind(), _rb(7), _rb(6), _rb(8), _rb(10), _rb(11)]
    ControlProfile(axes, buttons, curve = 1.2)

# (a profile saved by an older game, with fewer axes or buttons: the new ones at their defaults)
_complete = (p: ControlProfile, d: ControlProfile) -> ControlProfile:
    out = p
    loop k in out.axes.len()..d.axes.len(): out.axes.push(d.axes[k])
    loop k in out.buttons.len()..d.buttons.len(): out.buttons.push(d.buttons[k])
    out

# ---------------- devices: Sloppy's, and synthetic ones ----------------

# A device put in by hand (tests and captures): a standard pad, or a flight stick with its own axes
struct SynthDevice:
    name = "Synthetic pad"
    standard = true
    axes: f64[] = fill(0.0, 6)          # (a standard pad's: lx ly rx ry lt rt)
    buttons: bool[] = fill(false, 15)   # (by PadButton)
    raw_axes: f64[] = fill(0.0, 16)
    raw_buttons: bool[] = fill(false, 32)

const SYNTH_BASE = 8                    # synthetic devices are numbered from here
synthetic: SynthDevice[]

# put a device in (or replace the one with that name); its number
controller_inject = (d: SynthDevice) -> int:
    global synthetic
    loop k in 0..synthetic.len():
        if synthetic[k].name == d.name:
            synthetic[k] = d
            return SYNTH_BASE + k
    synthetic.push(d)
    SYNTH_BASE + synthetic.len() - 1

controller_clear = ():
    global synthetic, ctl
    synthetic = []
    ctl = Ctl()

devices = () -> int[]:
    out = gamepads()
    loop k in 0..synthetic.len(): out.push(SYNTH_BASE + k)
    out

device_name = (d: int) -> str:
    if d >= SYNTH_BASE: return synthetic[d - SYNTH_BASE].name
    gamepad_name(d)

_std_axis = (d: int, i: int) -> f64:
    if d < 0: return 0.0
    if d >= SYNTH_BASE: return synthetic[d - SYNTH_BASE].axes[i]
    gamepad_axis(d, i)
_std_button = (d: int, b: int) -> bool:
    if d < 0: return false
    if d >= SYNTH_BASE: return synthetic[d - SYNTH_BASE].buttons[b]
    gamepad_down(d, PadButton(b))
_raw_axes = (d: int) -> int:
    if d >= SYNTH_BASE: return synthetic[d - SYNTH_BASE].raw_axes.len()
    joystick_axes(d)
_raw_buttons = (d: int) -> int:
    if d >= SYNTH_BASE: return synthetic[d - SYNTH_BASE].raw_buttons.len()
    joystick_buttons(d)
_raw_axis = (d: int, i: int) -> f64:
    if d < 0: return 0.0
    if d >= SYNTH_BASE:
        a = synthetic[d - SYNTH_BASE].raw_axes
        return if i >= 0 and i < a.len(): a[i] else: 0.0
    joystick_axis(d, i)
_raw_button = (d: int, i: int) -> bool:
    if d < 0: return false
    if d >= SYNTH_BASE:
        b = synthetic[d - SYNTH_BASE].raw_buttons
        return i >= 0 and i < b.len() and b[i]
    joystick_button(d, i)

# Whether a device is a flight stick rather than a gamepad: the Controls page's choice, else its
# name (Sloppy cannot yet say whether a device has the standard layout)
STICK_WORDS = ["stick", "hotas", "throttle", "rudder", "pedal", "flight", "x52", "x56", "x55", "t.16000", "t16000", "twcs", "warthog", "saitek", "virpil", "vkb", "winwing", "extreme 3d", "sidewinder precision", "t.flight", "cyborg", "gladiator"]
PAD_WORDS = ["pad", "controller", "xbox", "x-box", "dualshock", "dualsense", "playstation", "8bitdo", "switch", "pro controller"]
is_stick = (d: int, kind: int) -> bool:
    if kind == 1: return false
    if kind == 2: return true
    if d >= SYNTH_BASE: return not synthetic[d - SYNTH_BASE].standard
    n = lower(device_name(d))
    loop w in PAD_WORDS:
        if contains(n, w): return false
    loop w in STICK_WORDS:
        if contains(n, w): return true
    false

# the device a binding of the stick profile reads: the one named, else the one in use
_device_for = (b: Bind, active: int) -> int:
    if b.device == "": return active
    if active >= 0 and device_name(active) == b.device: return active
    loop d in devices():
        if device_name(d) == b.device: return d
    -1

# how far a binding is pushed: a button 0 or 1; an axis -1..1 (its whole) or 0..1 (one way of it)
bind_value = (b: Bind, active: int) -> f64:
    match b.kind:
        1: if _std_button(active, b.index): 1.0 else: 0.0
        2:
            v = _std_axis(active, b.index)
            if b.dir != 0: max(0.0, v * f64(b.dir)) else: v
        3: if _raw_button(_device_for(b, active), b.index): 1.0 else: 0.0
        4:
            v = _raw_axis(_device_for(b, active), b.index)
            if b.dir != 0: max(0.0, v * f64(b.dir)) else: v
        _: 0.0

# an axis's value, as it answers: the dead zone taken out, the curve, the sensitivity, the sign
shape = (v: f64, deadzone: f64, curve: f64, gain: f64) -> f64:
    m = abs(v)
    if m <= deadzone: return 0.0
    m = min(1.0, (m - deadzone) / max(1.0 - deadzone, 0.01))
    sign(v) * min(1.0, pow(m, curve) * gain)

axis_value = (p: ControlProfile, i: int, active: int) -> f64:
    a = p.axes[i]
    if a.bind.kind == 0 and a.neg.kind == 0: return 0.0
    v = bind_value(a.bind, active) - bind_value(a.neg, active)
    if a.invert: v = -v
    # (the throttle lever and the triggers are not curved: what is set is what is given)
    curve = if i == AX_LEVER or i == AX_THROTTLE or i == AX_RUDDER and a.bind.kind == 1: 1.0 else: p.curve
    shape(v, a.deadzone, curve, a.gain)

# ---------------- what the game reads ----------------

struct Ctl:
    active = -1                     # the device in use (the last one touched), -1 none
    stick = false                   # (and it is a flight stick)
    connected = false               # (any device at all)
    used = false                    # a device has been touched since the last mouse or keyboard input
    pitch = 0.0                     # -1..1, back (climb) positive
    roll = 0.0                      # -1..1, right positive
    yaw = 0.0                       # -1..1, right rudder positive
    throttle_rate = 0.0             # -1..1: how fast the throttle opens (or closes)
    lever = -1.0                    # 0..1 the throttle lever, -1 none bound
    lever_moved = false             # (it moved this frame: it takes the throttle)
    look: vec2 = vec2(0, 0)         # -1..1 each way: right and down
    flying = false                  # (the flight axes are pushed)
    held: Key[]                     # virtual keys held and pressed this frame
    pressed: Key[]
    menu: Key[]                     # in a menu: the arrows, Enter, Escape (pressed, with repeats)
    tab = 0                         # in a menu: the bumpers, -1 or 1 (a page along)
    mode = 2                        # (as the touch pad: 0 air, 1 water, 2 foot, 3 a menu)
    menu_held: Key[]
    repeat_dir = -1                 # (the menu's held direction and when it next repeats)
    repeat_t = 0.0
    lever_last = -2.0
    touched: int[] = fill(0, 16)    # (per device: the frame it was last touched)
    prev_std: f64[] = fill(0.0, 16 * 6)
    prev_raw: f64[] = fill(0.0, 16 * 16)
    frame = 0

ctl = Ctl()

# a virtual key held or pressed by the controller (vdown and vpressed read these)
ctl_down = (k: Key) -> bool: ctl.held.contains(k)
ctl_pressed = (k: Key) -> bool: ctl.pressed.contains(k)
# in a menu: an arrow, Enter or Escape pressed (or repeated) on the controller
ctl_menu = (k: Key) -> bool: ctl.menu.contains(k)

# the profile in use, its missing parts filled
profile_of = (c: ControlsConfig, stick: bool) -> ControlProfile:
    if stick: _complete(c.stick, stick_defaults()) else: _complete(c.pad, pad_defaults())

# (a device touched this frame: a button down, a stick off its rest, an axis that moved)
_touched = (d: int) -> bool:
    slot = if d >= SYNTH_BASE: 8 + (d - SYNTH_BASE) % 8 else: d % 8
    any = false
    loop i in 0..15:
        if _std_button(d, i): any = true
    loop i in 0..6:
        v = _std_axis(d, i)
        if abs(v - ctl.prev_std[slot * 6 + i]) > 0.08 and abs(v) > 0.3: any = true
        ctl.prev_std[slot * 6 + i] = v
    loop i in 0..min(_raw_axes(d), 16):
        v = _raw_axis(d, i)
        if abs(v - ctl.prev_raw[slot * 16 + i]) > 0.08: any = true
        ctl.prev_raw[slot * 16 + i] = v
    loop i in 0..min(_raw_buttons(d), 32):
        if _raw_button(d, i): any = true
    if any: ctl.touched[slot] = ctl.frame
    any

_slot = (d: int) -> int: if d >= SYNTH_BASE: 8 + (d - SYNTH_BASE) % 8 else: d % 8

# Once a frame, before the game reads its keys: mode as the touch pad has it (0 in the air, 1 on
# the water, 2 on foot, 3 a menu or panel open)
update_controller = (mode: int, dt: f64, c: ControlsConfig):
    global ctl
    ctl.frame += 1
    ctl.mode = mode
    prev = ctl.held
    ctl.held = []
    ctl.pressed = []
    ctl.menu = []
    ctl.tab = 0
    ds = devices()
    ctl.connected = ds.len() > 0
    if not ctl.connected:
        ctl.active = -1
        ctl.pitch = 0.0; ctl.roll = 0.0; ctl.yaw = 0.0; ctl.throttle_rate = 0.0; ctl.look = vec2(0, 0)
        ctl.flying = false; ctl.lever = -1.0; ctl.lever_moved = false
        return
    # (the one in use: the last one touched; a device's stick, throttle and pedals each count)
    best = -1
    loop d in ds:
        moved = _touched(d)
        if moved and capture.active == false: ctl.used = true
        if best < 0 or ctl.touched[_slot(d)] > ctl.touched[_slot(best)]: best = d
    if ctl.active < 0 or not ds.contains(ctl.active) or ctl.touched[_slot(best)] > ctl.touched[_slot(ctl.active)]: ctl.active = best
    # (a key or the mouse taken up again: the controller's focus ring goes)
    if key_pressed_any() or mouse_pressed(.left): ctl.used = false
    ctl.stick = is_stick(ctl.active, c.kind)
    p = profile_of(c, ctl.stick)
    a = ctl.active
    ctl.pitch = axis_value(p, AX_PITCH, a)
    ctl.roll = axis_value(p, AX_ROLL, a)
    ctl.yaw = axis_value(p, AX_RUDDER, a)
    ctl.throttle_rate = axis_value(p, AX_THROTTLE, a)
    ctl.look = vec2(f32(axis_value(p, AX_LOOK_X, a)), f32(axis_value(p, AX_LOOK_Y, a)))
    ctl.flying = abs(ctl.pitch) + abs(ctl.roll) + abs(ctl.yaw) > 0.02
    # (the lever: 0..1 from its whole travel; it takes the throttle when it moves)
    lv = p.axes[AX_LEVER]
    if lv.bind.kind == 0:
        ctl.lever = -1.0
        ctl.lever_moved = false
    else:
        raw = bind_value(lv.bind, a)
        if lv.invert: raw = -raw
        u = clamp((raw + 1.0) * 0.5, 0.0, 1.0)
        u = clamp((u - lv.deadzone) / max(1.0 - 2.0 * lv.deadzone, 0.01), 0.0, 1.0)
        ctl.lever_moved = ctl.lever_last > -1.5 and abs(u - ctl.lever_last) > 0.004
        if ctl.lever_last < -1.5: ctl.lever_last = u
        if ctl.lever_moved: ctl.lever_last = u
        ctl.lever = u
    if capture.active:
        _capture_step(c)
        return
    if mode == 3:
        _menu_keys(p, a, dt)
        return
    ctl.repeat_dir = -1
    where = if mode == 0: 1 else: if mode == 1: 2 else: 4
    loop k in 0..min(ACTIONS, p.buttons.len()):
        if ACTION_WHERE[k] & where == 0: continue
        if bind_value(p.buttons[k], a) > 0.5 and not ctl.held.contains(ACTION_KEYS[k]): ctl.held.push(ACTION_KEYS[k])
    loop k in ctl.held:
        if not prev.contains(k): ctl.pressed.push(k)

# (a key pressed on the keyboard this frame: the keyboard is in charge again)
key_pressed_any = () -> bool:
    loop k in [Key.w, Key.a, Key.s, Key.d, Key.up, Key.down, Key.left, Key.right, Key.space, Key.enter, Key.escape, Key.tab]:
        if key_pressed(k): return true
    false

# In a menu: the d-pad or the left stick (a flight stick's hat) are the arrows, repeating while
# held; A is Enter and B Escape (a flight stick's Interact and Camera view); Start pauses and
# unpauses; the bumpers go a page along.
const MENU_DELAY = 0.35
const MENU_PERIOD = 0.12
_menu_keys = (p: ControlProfile, a: int, dt: f64):
    global ctl
    dir = -1
    if ctl.stick:
        lx = bind_value(p.axes[AX_LOOK_X].bind, a)
        ly = bind_value(p.axes[AX_LOOK_Y].bind, a)
        if p.axes[AX_LOOK_Y].invert: ly = -ly
        if ly < -0.5: dir = 0
        else if ly > 0.5: dir = 1
        else if lx < -0.5: dir = 2
        else if lx > 0.5: dir = 3
    else:
        sx = _std_axis(a, 0)
        sy = _std_axis(a, 1)
        if _std_button(a, int(PadButton.up)) or sy < -0.6: dir = 0
        else if _std_button(a, int(PadButton.down)) or sy > 0.6: dir = 1
        else if _std_button(a, int(PadButton.left)) or sx < -0.6: dir = 2
        else if _std_button(a, int(PadButton.right)) or sx > 0.6: dir = 3
    arrows: Key[] = [.up, .down, .left, .right]
    if dir < 0: ctl.repeat_dir = -1
    else if dir != ctl.repeat_dir:
        ctl.repeat_dir = dir
        ctl.repeat_t = MENU_DELAY
        ctl.menu.push(arrows[dir])
    else:
        ctl.repeat_t -= dt
        if ctl.repeat_t <= 0.0:
            ctl.repeat_t += MENU_PERIOD
            ctl.menu.push(arrows[dir])
    # (the buttons: held now, pressed this frame)
    ok = false; back = false; start = false; lb = false; rb = false
    if ctl.stick:
        ok = bind_value(p.buttons[6], a) > 0.5 or bind_value(p.buttons[0], a) > 0.5
        back = bind_value(p.buttons[1], a) > 0.5
        start = bind_value(p.buttons[8], a) > 0.5
    else:
        ok = _std_button(a, int(PadButton.a))
        back = _std_button(a, int(PadButton.b))
        start = _std_button(a, int(PadButton.start))
        lb = _std_button(a, int(PadButton.lb))
        rb = _std_button(a, int(PadButton.rb))
    now: Key[]
    if ok: now.push(.enter)
    if back: now.push(.escape)
    if start: now.push(.p)
    if lb: now.push(.page_up)
    if rb: now.push(.page_down)
    loop k in now:
        if not ctl.menu_held.contains(k):
            ctl.menu.push(k)
            if k == .p: ctl.pressed.push(.p)
            if k == .page_up: ctl.tab = -1
            if k == .page_down: ctl.tab = 1
    ctl.menu_held = now
    if now.len() > 0 or dir >= 0: ctl.used = true

# ---------------- binding by moving the control ----------------

struct Capture:
    active = false
    stick = false                   # (into the flight-stick profile, else the gamepad's)
    axis = -1                       # the axis being set (or -1)
    action = -1                     # the button being set (or -1)
    second = false                  # (an axis set by a button: now the button taking it the other way)
    t = 0.0
    std_rest: f64[]                 # (where every control rested when it began)
    raw_rest: f64[]
    held_std: bool[]
    held_raw: bool[]
    got: Bind = Bind()              # what was moved (taken by capture_take)
    got_neg: Bind = Bind()
    done = false

capture = Capture()

# start listening for the control to bind to axis i or button k (one of them -1)
capture_begin = (axis: int, action: int, stick: bool):
    global capture
    capture = Capture(active = true, stick = stick, axis = axis, action = action)
    loop d in 0..16:
        dev = if d < 8: d else: SYNTH_BASE + d - 8
        ok = if d < 8: gamepad_connected(d) else: d - 8 < synthetic.len()
        loop i in 0..6: capture.std_rest.push(if ok: _std_axis(dev, i) else: 0.0)
        loop i in 0..15: capture.held_std.push(ok and _std_button(dev, i))
        loop i in 0..16: capture.raw_rest.push(if ok and i < _raw_axes(dev): _raw_axis(dev, i) else: 0.0)
        loop i in 0..32: capture.held_raw.push(ok and i < _raw_buttons(dev) and _raw_button(dev, i))

capture_cancel = ():
    global capture
    capture = Capture()

# what was moved, once (the binding and, for an axis set by two buttons, the other one)
capture_take = () -> (Bind, Bind)?:
    global capture
    if not capture.done: return none
    out = (capture.got, capture.got_neg)
    capture = Capture()
    out

_capture_step = (c: ControlsConfig):
    global capture
    capture.t += 1.0 / 60.0
    if capture.t > 8.0 or key_pressed(.escape):
        capture_cancel()
        return
    loop d in devices():
        slot = _slot(d)
        name = device_name(d)
        found = Bind()
        if not capture.stick:
            # (a gamepad: its standard sticks, triggers and buttons)
            loop i in 0..15:
                down = _std_button(d, i)
                if not down: capture.held_std[slot * 15 + i] = false
                else if not capture.held_std[slot * 15 + i]: found = _pb(PadButton(i))
            loop i in 0..6:
                v = _std_axis(d, i)
                off = v - capture.std_rest[slot * 6 + i]
                if found.kind == 0 and abs(off) > 0.6:
                    trigger = i >= 4
                    whole = capture.axis >= 0 and not capture.second
                    found = _pa(i, if trigger: 1 else: if whole: 0 else: int(sign(off)))
        else:
            loop i in 0..min(_raw_buttons(d), 32):
                down = _raw_button(d, i)
                if not down: capture.held_raw[slot * 32 + i] = false
                else if not capture.held_raw[slot * 32 + i]: found = Bind(kind = 3, index = i, device = name)
            loop i in 0..min(_raw_axes(d), 16):
                v = _raw_axis(d, i)
                off = v - capture.raw_rest[slot * 16 + i]
                if found.kind == 0 and abs(off) > 0.6:
                    whole = capture.axis >= 0 and not capture.second
                    found = Bind(kind = 4, index = i, dir = if whole: 0 else: int(sign(off)), device = name)
        if found.kind == 0: continue
        if capture.axis >= 0 and not capture.second and (found.kind == 1 or found.kind == 3 or found.dir != 0):
            # (a button for an axis, or a trigger: that way; now the one for the other way)
            capture.got = found
            capture.second = true
            capture.t = 0.0
            capture_rest()
            return
        if capture.second: capture.got_neg = found
        else: capture.got = found
        capture.done = true
        capture.active = false
        return

# (the rests taken again: the control that set the first half let go)
capture_rest = ():
    global capture
    loop d in 0..16:
        dev = if d < 8: d else: SYNTH_BASE + d - 8
        ok = if d < 8: gamepad_connected(d) else: d - 8 < synthetic.len()
        loop i in 0..6: capture.std_rest[d * 6 + i] = if ok: _std_axis(dev, i) else: 0.0
        loop i in 0..15: capture.held_std[d * 15 + i] = ok and _std_button(dev, i)
        loop i in 0..16: capture.raw_rest[d * 16 + i] = if ok and i < _raw_axes(dev): _raw_axis(dev, i) else: 0.0
        loop i in 0..32: capture.held_raw[d * 32 + i] = ok and i < _raw_buttons(dev) and _raw_button(dev, i)

# ---------------- names, for the Controls page ----------------

PAD_BUTTON_NAMES = ["A", "B", "X", "Y", "LB", "RB", "Back", "Start", "Home", "L3", "R3", "D-pad up", "D-pad down", "D-pad left", "D-pad right"]
PAD_AXIS_NAMES = ["Left stick X", "Left stick Y", "Right stick X", "Right stick Y", "LT", "RT"]

bind_name = (b: Bind) -> str:
    way = if b.dir > 0: " +" else: if b.dir < 0: " -" else: ""
    match b.kind:
        1: if b.index >= 0 and b.index < PAD_BUTTON_NAMES.len(): PAD_BUTTON_NAMES[b.index] else: "Button"
        2:
            n = if b.index >= 0 and b.index < PAD_AXIS_NAMES.len(): PAD_AXIS_NAMES[b.index] else: "Axis"
            if b.index >= 4: n else: n + way
        3: "Button {b.index + 1}"
        4: "Axis {b.index + 1}{way}"
        _: "-"

axis_set_name = (a: AxisSet) -> str:
    if a.bind.kind == 0 and a.neg.kind == 0: return "-"
    if a.neg.kind == 0: return bind_name(a.bind)
    "{bind_name(a.bind)} / {bind_name(a.neg)}"
