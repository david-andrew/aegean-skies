        6: embed('../data/music/bethena.z')
        7: embed('../data/music/gymnopedie.z')
        8: embed('../data/music/ave-maria.z')
        9: embed('../data/music/clair-de-lune.z')
        10: embed('../data/music/adelita.z')
        11: embed('../data/music/berceuse.z')
        12: embed('../data/music/gymnopedie-orchestra.z')
        else: []
