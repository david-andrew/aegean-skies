# Generated by tools/music_pack.py; edit source MIDI or converter, then rebuild.
struct MusicPiece:
    title: str
    composer: str
    station: str
    frames: int
    shelf_hz = 0.0                  # the automatic balance's high shelf (tools/music_balance.py)
    shelf_db: f64[] = []            # (dB per instrument above shelf_hz)
    piano = 0                       # the piano it is played on: 0 the concert grand, 1 the 1920s upright
    level = 1.0                     # its level in the mix (tools/music_pack.py LEVEL)
    hall = false                    # heard in the concert hall's reverberation

