# Company at the table, now and then: while the pilot sits over a drink or a meal, someone from
# the town may come over (rarely: most sittings nobody does). At a table they ask first, and sit
# only if asked to; at the bar they simply take the next stool, and talk or don't. Once sitting,
# they pass a remark now and then, the ordinary talk of the day (the game's dialogue gives the
# words), and the pilot can talk to them properly. They go when the pilot gets up, or after a
# while. Pure: the game says who is about, where the seats are, and draws them.

const COMPANY_CHANCE_TABLE = 0.15   # (a sitting at a table someone comes to: about one in seven)
const COMPANY_CHANCE_BAR = 0.18     # (at the bar, someone takes the next stool)
const COMPANY_TALKS_AT_BAR = 0.55   # (and talks)
const COMPANY_SPEED = 1.1           # m/s walking over
const COMPANY_STAY = 240.0          # seconds they stay, at most
const COMPANY_FIRST_LINE = 4.0      # (seconds after sitting before the first remark)

enum CompanyStage: none, coming, asking, sitting, leaving

struct Company:
    stage: CompanyStage = .none
    due = -1.0                      # when someone comes (the game's clock); -1: nobody this sitting
    who = -1                        # the townsperson (index into the scene's folk)
    person = -1                     # (the living-world person)
    at_bar = false
    talks = true
    pos: vec3 = vec3(0, 0, 0)
    yaw = 0.0
    phase = 0.0
    from: vec3 = vec3(0, 0, 0)      # where they came from (and go back to)
    seat: vec3 = vec3(0, 0, 0)      # the seat they take
    seat_yaw = 0.0
    stand: vec3 = vec3(0, 0, 0)     # where they stand to ask
    since = 0.0                     # (when they sat)
    next_line = 0.0                 # (when they say something next)
    declined = false                # (asked and turned away: nobody else comes this sitting)

# A new sitting: whether anyone will come, and when (`roll`, `delay` two numbers in 0..1).
company_plan = (at_bar: bool, roll: f64, delay: f64, now: f64) -> Company:
    c = Company(at_bar = at_bar)
    chance = if at_bar: COMPANY_CHANCE_BAR else: COMPANY_CHANCE_TABLE
    if roll < chance: c.due = now + 45.0 + delay * 150.0
    c

struct Candidate:
    who: int                        # (the folk)
    person: int
    pos: vec3
    weight: f64                     # (how likely, against the others)

# Of those about, who comes: by weight (`pick` in 0..1). -1: nobody suitable.
company_pick = (cands: Candidate[], pick: f64) -> int:
    total = 0.0
    loop c in cands: total += max(0.0, c.weight)
    if total <= 0.0: return -1
    want = clamp(pick, 0.0, 0.999999) * total
    loop k in 0..cands.len():
        want -= max(0.0, cands[k].weight)
        if want < 0.0: return k
    cands.len() - 1

# Someone sets off: from where they are to the seat (at the bar) or to the table's side (to ask).
company_start = (c: mut Company, cand: Candidate, seat: vec3, seat_yaw: f64, stand: vec3, talks: bool, now: f64):
    c.stage = .coming; c.who = cand.who; c.person = cand.person
    c.pos = cand.pos; c.from = cand.pos
    c.seat = seat; c.seat_yaw = seat_yaw; c.stand = stand
    c.talks = talks
    c.due = -1.0

_walk = (c: mut Company, goal: vec3, dt: f64) -> bool:
    d = vec3(goal.x - c.pos.x, 0, goal.z - c.pos.z)
    l = f64(length(d))
    if l < 0.06: return true
    step = min(l, COMPANY_SPEED * dt)
    c.pos = c.pos + d / f32(l) * f32(step)
    c.yaw = atan2(f64(d.x), f64(d.z))
    c.phase += dt * COMPANY_SPEED * 5.0
    false

struct CompanyStep:
    arrived = false                 # (sat down this step)
    asks = false                    # (stopped at the table to ask, this step)
    speak = false                   # (time for a remark)
    gone = false                    # (left: the stage is none again)

# One step: walking over, asking (waiting for the answer), sitting (remarks now and then, leaving
# after a while), leaving. `seated` the pilot still sits; `height(x, z)` the ground.
company_step = (c: mut Company, now: f64, dt: f64, seated: bool, height: (f64, f64) -> f64) -> CompanyStep:
    out = CompanyStep()
    if c.stage == .none: return out
    if not seated and c.stage != .leaving:
        c.stage = .leaving
    match c.stage:
        .coming:
            goal = if c.at_bar: c.seat else: c.stand
            if _walk(c, goal, dt):
                if c.at_bar:
                    c.stage = .sitting; c.pos = c.seat; c.yaw = c.seat_yaw; c.since = now
                    c.next_line = now + COMPANY_FIRST_LINE + 3.0
                    out.arrived = true
                else:
                    c.stage = .asking
                    c.yaw = atan2(f64(c.seat.x - c.pos.x), f64(c.seat.z - c.pos.z))
                    out.asks = true
        .asking: pass
        .sitting:
            c.pos = c.seat; c.yaw = c.seat_yaw; c.phase = 0.0
            if c.talks and now >= c.next_line:
                out.speak = true
                c.next_line = now + 22.0 + 18.0 * (0.5 + 0.5 * sin(now * 1.7 + f64(c.person)))
            if now - c.since > COMPANY_STAY: c.stage = .leaving
        .leaving:
            if _walk(c, c.from, dt):
                c.stage = .none; c.who = -1; c.person = -1
                out.gone = true
        else: pass
    if c.stage != .sitting and c.stage != .none: c.pos = vec3(c.pos.x, f32(height(f64(c.pos.x), f64(c.pos.z))), c.pos.z)
    out

# The pilot's answer to "may I join you?"
company_answer = (c: mut Company, yes: bool, now: f64):
    if c.stage != .asking: return
    if yes:
        c.stage = .sitting; c.pos = c.seat; c.yaw = c.seat_yaw; c.since = now
        c.next_line = now + COMPANY_FIRST_LINE
    else:
        c.stage = .leaving; c.declined = true

# Whether it is time for someone to come.
company_due = (c: Company, now: f64) -> bool: c.stage == .none and c.due >= 0.0 and now >= c.due and not c.declined
