use 'world_point.jo'
# Close architectural kit. Shared meshes, pure site plans; no people or stock.
use 'objects.jo'
use 'town_details.jo'
use 'town_sites.jo'
use 'settlements.jo'
use 'town_region.jo'
use 'town_paving.jo'

const ARCH_COUNT = 22
const SHUTTER_COLORS = [vec4(0.18,0.36,0.48,1),vec4(0.29,0.40,0.29,1),vec4(0.63,0.42,0.20,1)]
arch_has_lod = (kind: int) -> bool: kind<3 or kind==6 or kind==9 or kind==19

arch_vertices = (kind: int,detail: int = 2) -> Vertex3D[]:
    vs: Vertex3D[]
    cream=rgb(0.90,0.85,0.73); stone=rgb(0.65,0.60,0.49); wood=rgb(0.32,0.23,0.15); iron=rgb(0.15,0.20,0.21)
    if kind<3:
        # A dark reveal, limestone sill and two hinged, slatted wooden shutters.
        color=SHUTTER_COLORS[kind]
        add_box(vs,vec3(0,0,0),vec3(1.48,1.96,0.10),iron)
        loop x in [-0.79,0.79]: add_box(vs,vec3(f32(x),0,0.08),vec3(0.14,2.12,0.16),cream)
        loop y in [-1.04,1.04]: add_box(vs,vec3(0,f32(y),0.10),vec3(1.72,0.14,0.22),cream)
        add_box(vs,vec3(0,-1.12,0.23),vec3(1.95,0.15,0.55),cream)
        loop side in [-1.0,1.0]:
            m=translation(vec3(f32(side*0.87),0,0.16))*rotation_y(side*0.23)
            add_box(vs,vec3(f32(side*0.36),0,0),vec3(0.72,2.03,0.10),color,m)
            slats=if detail==2: 6 else: if detail==1: 3 else: 0
            loop k in 0..slats: add_box(vs,vec3(f32(side*0.36),-0.75+f32(k)*1.5/f32(max(1,slats-1)),0.07),vec3(0.57,0.08,0.08),color*vec4(0.78,0.78,0.78,1),m)
        add_box(vs,vec3(0,0,0.09),vec3(0.065,1.9,0.06),wood)
    else if kind<6:
        color=SHUTTER_COLORS[kind-3]
        add_box(vs,vec3(0,0.9,0),vec3(1.7,1.8,0.12),color)
        loop k in 0..10:
            a=f64(k)*PI/10; b=f64(k+1)*PI/10
            add_outward_triangle(vs,vec3(0,1.8,0.07),vec3(f32(cos(a)*0.85),f32(1.8+sin(a)*0.85),0.07),vec3(f32(cos(b)*0.85),f32(1.8+sin(b)*0.85),0.07),color,vec3(0,1,-1))
            m=translation(vec3(f32(cos((a+b)*0.5)*1.0),f32(1.8+sin((a+b)*0.5)*1.0),0.12))*rotation_z((a+b)*0.5-PI/2)
            add_box(vs,vec3(0,0,0),vec3(0.33,0.29,0.28),cream,m)
        loop side in [-1.0,1.0]: add_box(vs,vec3(f32(side),0.9,0.12),vec3(0.28,1.8,0.28),cream)
        loop k in 0..7: add_box(vs,vec3(-0.73+f32(k)*0.24,0.9,0.08),vec3(0.018,1.72,0.025),wood)
        add_box(vs,vec3(0,0.9,0.10),vec3(0.06,1.8,0.06),wood)
        add_sphere(vs,vec3(0.25,1.0,0.17),0.07,rgb(0.6,0.43,0.20),5,3)
    else if kind==6:
        add_box(vs,vec3(0,0,0.65),vec3(3.2,0.22,1.6),cream)
        loop x in [-1.45,1.45]:
            town_beam(vs,vec3(f32(x),-0.75,0),vec3(f32(x),-0.1,1.2),0.09,stone)
            town_beam(vs,vec3(f32(x),0.12,0),vec3(f32(x),1.05,1.35),0.035,iron)
            town_beam(vs,vec3(f32(x),1.05,0),vec3(f32(x),1.05,1.35),0.045,iron)
        town_beam(vs,vec3(-1.45,1.05,1.35),vec3(1.45,1.05,1.35),0.045,iron)
        bars=if detail==2: 9 else: if detail==1: 5 else: 3
        loop k in 0..bars: town_beam(vs,vec3(-1.4+f32(k)*2.8/f32(bars-1),0.1,1.35),vec3(-1.4+f32(k)*2.8/f32(bars-1),1.05,1.35),0.028,iron)
    else if kind==19:
        # Kalyra's deep timber galleries: solid fascia, heavy rails and braces.
        add_box(vs,vec3(0,0,0.8),vec3(3.5,0.24,1.9),wood)
        add_box(vs,vec3(0,0.48,1.65),vec3(3.5,0.72,0.16),wood)
        add_box(vs,vec3(0,1.06,1.65),vec3(3.7,0.16,0.22),SHUTTER_COLORS[1])
        loop x in [-1.6,1.6]:
            add_box(vs,vec3(f32(x),0.55,0.8),vec3(0.16,1.1,1.9),wood)
            town_beam(vs,vec3(f32(x),-1.1,0),vec3(f32(x),-0.12,1.5),0.12,wood)
        loop k in 0..(if detail==0:3 else:7):
            add_box(vs,vec3(-1.5+f32(k)*(if detail==0:1.5 else:0.5),0.47,1.76),vec3(0.08,0.72,0.08),SHUTTER_COLORS[1])
    else if kind==20:
        # Gate leaves folded back against the enclosure, leaving the full gap.
        loop x in [-0.65,0.65]:add_box(vs,vec3(f32(x),0.55,0),vec3(0.14,1.1,0.14),wood)
        loop y in [0.24,0.74]:add_box(vs,vec3(0,f32(y),0),vec3(1.5,0.13,0.14),wood)
        town_beam(vs,vec3(-0.65,0.2,0),vec3(0.65,0.9,0),0.055,wood)
    else if kind==21:
        # A tethered farm goat, kept off the household's entry and yard paths.
        hide=rgb(0.78,0.73,0.60)
        add_sphere(vs,vec3(0,0,0),1,hide,7,4,translation(vec3(0,0.65,0))*scaling(vec3(0.25,0.32,0.57)))
        loop x in [-0.17,0.17]:
            loop z in [-0.35,0.35]:town_beam(vs,vec3(f32(x),0.04,f32(z)),vec3(f32(x),0.65,f32(z)),0.055,wood)
        town_beam(vs,vec3(0,0.65,-0.3),vec3(0,1.03,-0.5),0.16,hide)
        add_sphere(vs,vec3(0,1.02,-0.6),0.2,hide,6,3)
        loop x in [-0.12,0.12]:town_beam(vs,vec3(f32(x),1.14,-0.52),vec3(f32(x),1.4,-0.35),0.045,wood)
        town_beam(vs,vec3(0,0.75,0.45),vec3(0,0.98,0.65),0.055,hide)
    else if kind==7:
        add_plaster_box(vs,vec3(0,0.75,0),vec3(0.7,1.5,0.75),cream,mat4())
        loop x in [-0.25,0.25]: add_box(vs,vec3(f32(x),1.75,0),vec3(0.12,0.5,0.65),cream)
        add_gable(vs,vec3(0,2,0),1,1,0.24,ROOFS[0],mat4())
    else if kind==8:
        add_box(vs,vec3(0,0.48,0),vec3(2.2,0.96,1.85),stone)
        add_sphere(vs,vec3(0,0,0),1,cream,10,5,translation(vec3(0,0.9,0))*scaling(vec3(1.05,0.9,0.86)))
        add_box(vs,vec3(0,1.12,0.84),vec3(0.82,0.58,0.1),iron)
        add_box(vs,vec3(0,0.92,1.0),vec3(1.35,0.12,0.7),ROOFS[0])
        add_box(vs,vec3(-0.6,1.65,-0.35),vec3(0.38,1.4,0.4),cream)
        loop k in 0..4: town_beam(vs,vec3(-0.7+f32(k)*0.4,0.1,0.98),vec3(-0.6+f32(k)*0.4,0.1,1.5),0.12,wood)
    else if kind==9:
        # Climbing bougainvillea: woody stems reach each flower/leaf cluster.
        loop k in 0..5:
            at=vec3(f32(sin(f64(k)*2.3)*0.75),f32(0.8+f64(k)*0.6),0.0)
            town_beam(vs,vec3(0,0,0),at,0.045,wood)
            add_sphere(vs,at,0.42,rgb(0.28,0.36,0.19),if detail==2: 7 else: 5,if detail==2: 4 else: 3)
            flowers=if detail==2: 5 else: if detail==1: 3 else: 1
            loop j in 0..flowers:
                offset=vec3(f32(cos(f64(j)*2.4)*0.3),f32(sin(f64(j)*1.7)*0.2),f32(sin(f64(j)*2.4)*0.3))
                add_sphere(vs,at+offset,if detail==0: 0.28 else: 0.19,if j%2==0: rgb(0.60,0.24,0.39) else: rgb(0.74,0.35,0.48),if detail==2: 6 else: 5,if detail==2: 3 else: 2)
        add_cylinder(vs,vec3(0,0,0),0.36,0.6,ROOFS[1],7,0.48)
    else if kind==10:
        town_beam(vs,vec3(-2.1,0,0),vec3(2.1,0,0),0.018,wood)
        loop k in 0..5:
            add_box(vs,vec3(-1.6+f32(k)*0.8,-0.5,0),vec3(0.58,0.85,0.035),if k%3==0: rgb(0.40,0.54,0.61) else: cream,rotation_z(f64(k%3-1)*0.06))
    else if kind==11:
        add_box(vs,vec3(0,0.46,0),vec3(0.58,0.08,0.6),wood)
        loop x in [-0.24,0.24]:
            loop z in [-0.24,0.24]: add_box(vs,vec3(f32(x),0.24,f32(z)),vec3(0.07,0.48,0.07),wood)
            add_box(vs,vec3(f32(x),0.73,-0.24),vec3(0.07,0.55,0.07),wood)
        loop y in [0.72,0.91]: add_box(vs,vec3(0,f32(y),-0.24),vec3(0.5,0.1,0.07),wood)
    else if kind==12:
        hide=rgb(0.46,0.43,0.36)
        add_sphere(vs,vec3(0,0,0),1,hide,8,4,translation(vec3(0,1.05,0))*scaling(vec3(0.37,0.42,0.85)))
        town_beam(vs,vec3(0,1.1,-0.6),vec3(0,1.7,-0.9),0.24,hide)
        add_sphere(vs,vec3(0,0,0),1,hide,7,4,translation(vec3(0,1.7,-1.05))*scaling(vec3(0.23,0.25,0.4)))
        loop x in [-0.22,0.22]:
            loop z in [-0.55,0.55]: town_beam(vs,vec3(f32(x),0.1,f32(z)),vec3(f32(x),1.0,f32(z)),0.085,hide)
            town_beam(vs,vec3(f32(x*0.6),1.8,-0.86),vec3(f32(x),2.3,-0.8),0.075,hide)
            add_sphere(vs,vec3(f32(x),1.78,-1.12),0.04,iron,5,3)
        add_box(vs,vec3(0,1.41,0),vec3(0.8,0.08,0.7),rgb(0.48,0.24,0.19))
        town_beam(vs,vec3(0,1.2,0.7),vec3(0.12,0.6,1.02),0.04,wood)
        town_beam(vs,vec3(1.2,0,0.5),vec3(1.2,1.25,0.5),0.08,wood)
        town_beam(vs,vec3(0,1.65,-1.3),vec3(0.5,0.85,-0.4),0.014,cream)
        town_beam(vs,vec3(0.5,0.85,-0.4),vec3(1.2,1.1,0.5),0.014,cream)
    else if kind==13:
        # Empty slatted crates, deliberately without display/tradable cargo.
        loop y in [0.12,0.35,0.58]:
            loop z in [-0.4,0.4]: add_box(vs,vec3(0,f32(y),f32(z)),vec3(1.1,0.17,0.08),wood)
            loop x in [-0.5,0.5]: add_box(vs,vec3(f32(x),f32(y),0),vec3(0.08,0.17,0.8),wood)
        add_box(vs,vec3(0,0.04,0),vec3(1.1,0.08,0.8),wood)
    else if kind==18:
        # A small herb bed: planted soil, not a display of tradable produce.
        add_box(vs,vec3(0,0.09,0),vec3(1.2,0.18,0.72),rgb(0.37,0.30,0.21))
        loop k in 0..3:
            at=vec3(-0.38+f32(k)*0.38,0.29,0)
            town_beam(vs,at-vec3(0,0.12,0),at+vec3(0,0.16,0),0.035,wood)
            add_sphere(vs,at,0.22,rgb(0.39,0.47,0.31),5,3)
    else if kind==17:
        # The existing night-lit pane is separate from shutters and stonework.
        # Its alpha is the object's established emission tag, not transparency.
        add_box(vs,vec3(0,0,0.078),vec3(1.45,1.92,0.025),vec4(0.15,0.17,0.22,0.5))
    else:
        add_box(vs,vec3(0,0.5,0),vec3(1,1,1),if kind==16: vec4(1,1,1,1) else: if kind==14: cream else: stone)
    [loop v in vs: (if v.color==cream or kind==16: Vertex3D(v.pos,v.normal,vec2(182,0),v.color) else: v)]

arch_put = (lists: mut Instance3D[][],kind: int,s: TownSite,x: f64,y: f64,z: f64,scale: vec3 = vec3(1,1,1),turn: f64 = 0.0,origin:vec3=vec3(0,0,0),tint:vec4=vec4(1,1,1,1)):
    r=site_right(s);f=site_front(s)
    p=vec2(f32(f64(s.at.x)-f64(origin.x)+f64(r.x)*x+f64(f.x)*z),f32(f64(s.at.z)-f64(origin.z)+f64(r.y)*x+f64(f.y)*z))
    lists[kind].push(Instance3D(translation(vec3(p.x,f32(y),p.y))*rotation_y(s.yaw+turn)*scaling(scale),tint))

# Solid trim with real thickness. Roof caps meet the existing roof at an edge;
# no second plinth or frontage plane is laid over the house's lower wall.
arch_regional = (lists: mut Instance3D[][],s: TownSite,origin: vec3):
    if s.country==0 or s.chapel: return
    top=f64(s.at.y)+s.height
    trim=if s.country==1: vec4(0.69,0.63,0.53,1) else: vec4(0.96,0.96,0.90,1)
    y=if s.flat: top+0.3 else: top-0.32
    height=if s.flat: 0.48 else: 0.24
    # Butt joints: the short side caps stop at the long caps' inner edges.
    loop side in [-1.0,1.0]:
        arch_put(lists,16,s,0,y,side*(s.depth*0.5+0.04),vec3(f32(s.width+0.36),f32(height),0.28),origin=origin,tint=trim)
        arch_put(lists,16,s,side*(s.width*0.5+0.04),y,0,vec3(0.28,f32(height),f32(s.depth-0.20)),origin=origin,tint=trim)

arch_warehouse = (lists: mut Instance3D[][],s: TownSite,origin: vec3):
    pal=town_joinery(s.seed,s.country)
    arch_put(lists,3+pal,s,0,s.door_y,s.depth*0.5+0.23,vec3(2.35,1.25,1),origin=origin)
    loop x in [-7.0,0.0,7.0]:
        arch_put(lists,pal,s,x,f64(s.at.y)+6.2,s.depth*0.5+0.24,vec3(1.2,0.70,1),origin=origin)
    if s.country==1:
        # Adriatic masonry piers, physically proud of the ochre warehouse wall.
        loop x in [-s.width*0.5+0.55,-3.7,3.7,s.width*0.5-0.55]:
            z=s.depth*0.5+0.18; at=site_point(s,x,z)
            low=place_ground(at)-0.12; top=f64(s.at.y)+s.height-0.1
            if top>low:arch_put(lists,15,s,x,low,z,vec3(0.85,f32(top-low),0.60),origin=origin)
    else if s.country==2:
        # Low white portico and blue timber shade below the roof terrace.
        top=s.door_y+3.8;blue=vec4(0.22,0.42,0.55,1)
        loop x in [-3.3,3.3]:
            z=s.depth*0.5+2.3;low=place_ground(site_point(s,x,z))-0.1
            if top>low:arch_put(lists,16,s,x,low,z,vec3(0.25,f32(top-low),0.25),origin=origin,tint=vec4(0.96,0.96,0.90,1))
        arch_put(lists,16,s,0,top,s.depth*0.5+2.3,vec3(6.9,0.18,0.24),origin=origin,tint=blue)
        loop k in 0..7:
            arch_put(lists,16,s,-3.0+f64(k),top+0.18,s.depth*0.5+1.3,vec3(0.12,0.13,2.5),origin=origin,tint=blue)
    arch_regional(lists,s,origin)

arch_site = (lists: mut Instance3D[][],props: mut Instance3D[][],s: TownSite,ornament: bool,origin:vec3=vec3(0,0,0)):
    e=site_entry(s)
    if not s.service: arch_stairs(lists,e,origin=origin)
    if not ornament or s.chapel: return
    if s.warehouse:
        arch_warehouse(lists,s,origin)
        return
    pal=town_joinery(s.seed,s.country)
    arch_regional(lists,s,origin)
    sx=if s.modular: s.width/12 else: 1.0
    sy=if s.modular: s.height/(f64(s.floors)*4+1) else: 1.0
    width=if s.modular: 12.0 else: s.width
    loop fl in 0..s.floors:
        loop k in 0..max(1,int(width/4.4)):
            x=(-width*0.5+2.6+f64(k)*4.4)*sx
            if fl==0 and abs(x+s.width*0.2)<1.9: continue
            y=f64(s.at.y)+(2+f64(fl)*4)*sy
            wp=site_point(s,x,s.depth*0.5+0.1)
            if y-1.1<place_ground(wp): continue
            arch_put(lists,pal,s,x,y,s.depth*0.5+0.16,vec3(f32(sx),f32(sy),1),origin=origin)
            lit_seed=if s.modular: 0 else: s.seed
            if (lit_seed/13+k*7+fl*3)%3==0: arch_put(lists,17,s,x,y,s.depth*0.5+0.16,vec3(f32(sx),f32(sy),1),origin=origin)
            if fl==1 and k==0 and s.seed%3!=0: arch_put(lists,if s.country==1:19 else:6,s,x,y-1.18*sy,s.depth*0.5+0.15,origin=origin)
    if not s.service:
        cover=site_point(s,-s.width*0.2,s.depth*0.5+0.14)
        wall=if s.modular: (if s.country==1:rgb(0.75,0.71,0.60) else:WALLS[0])*(if s.country>0: town_region_color(s.seed,s.country) else: town_site_color(s.seed)) else: WALLS[s.seed%WALLS.len()]
        lists[16].push(Instance3D(translation(world_local(world_point(vec3(cover.x,s.at.y-1.6,cover.y)),origin))*rotation_y(s.yaw)*scaling(vec3(1.82,3.22,0.12)),wall))
    arch_put(lists,3+pal,s,if s.service: 0.0 else: -s.width*0.2,e.top,s.depth*0.5+0.23,origin=origin)
    roof=f64(s.at.y)+s.height+(if s.flat: 0.2 else: min(s.width,s.depth)*0.13)
    arch_put(lists,7,s,s.width*0.28,roof,-s.depth*0.15,origin=origin)
    if s.seed%3==0:
        line=site_point(s,s.width*0.12,s.depth*0.5+0.4)
        arch_put(lists,10,s,s.width*0.12,place_ground(line)+2.15,s.depth*0.5+0.4,origin=origin)
    flower=site_point(s,s.width*0.35,s.depth*0.5+0.75)
    if s.seed%3!=1: arch_put(lists,9,s,s.width*0.35,place_ground(flower)+0.12,s.depth*0.5+0.75,vec3(1,f32(0.8+f64(s.seed%5)*0.08),1),origin=origin)
    else: arch_prop(props,4,flower,s.yaw,origin=origin)
    chair=site_point(s,-s.width*0.2+2.2,s.depth*0.5+0.9)
    arch_put(lists,11,s,-s.width*0.2+2.2,place_ground(chair)+0.12,s.depth*0.5+0.9,origin=origin)
    if s.seed%4==0: arch_prop(props,12,site_point(s,-s.width*0.35,s.depth*0.5+0.9),s.yaw+0.15,origin=origin)
    if s.seed%5==0: arch_prop(props,6,site_point(s,s.width*0.25,s.depth*0.5+1.0),s.yaw,origin=origin)

arch_prop = (lists: mut Instance3D[][],kind: int,p: vec2,yaw: f64,origin:vec3=vec3(0,0,0)):
    h=place_ground(p)
    if h<0.4: return
    lists[kind].push(Instance3D(translation(world_local(WorldPoint(p.x,h+0.12,p.y),origin))*rotation_y(yaw),vec4(1,1,1,1)))

arch_clear = (sites: TownSite[],p: vec2,margin: f64) -> bool:
    loop s in sites:
        if length(p-s.at.xz)>f32(max(s.width,s.depth)+margin+4): continue
        if length(site_exclude(s,p,margin)-p)>0.02: return false
    place_ground(p)>0.4

arch_court = (s: TownSite,sites: TownSite[]) -> vec2?:
    if s.chapel: return none
    side=if s.seed%2==0: -1.0 else: 1.0
    x=side*(s.width*0.5+4.0); z=-s.depth*0.18
    p=site_point(s,x,z)
    # Only a genuine gap becomes a courtyard; no furniture in narrow passages.
    safe=true
    loop dx in [-2.6,2.6]:
        loop dz in [-3.0,3.0]:
            q=site_point(s,x+dx,z+dz)
            if not arch_clear(sites,q,0.6) or abs(place_ground(q)-place_ground(p))>1.2: safe=false
    if not safe: return none
    vec2(f32(x),f32(z))

arch_courtyard = (lists: mut Instance3D[][],props: mut Instance3D[][],paths: mut Vertex3D[],s: TownSite,sites: TownSite[],origin:vec3=vec3(0,0,0)):
    court=arch_court(s,sites)
    if court==none: return
    x=f64(court!.x); z=f64(court!.y); p=site_point(s,x,z)
    town_path(paths,site_point(s,x,z-3),site_point(s,x,z+3),5.4,true,origin=origin)
    # Low planted boundary on the back, leaving the whole front open.
    loop k in 0..5:
        wx=x-2.25+f64(k)*1.1; wz=z-3.1; at=site_point(s,wx,wz)
        arch_put(lists,15,s,wx,place_ground(at),wz,vec3(1.1,0.65,0.42),origin=origin)
    if s.seed%3==0: arch_prop(props,2,p,s.yaw,origin=origin)
    else if s.seed%3==1: arch_put(lists,8,s,x,place_ground(p)+0.12,z-1,origin=origin)
    else: arch_put(lists,12,s,x,place_ground(p)+0.12,z,origin=origin)
    if place_ground(p)<7 and s.seed%2==0: arch_prop(props,5,site_point(s,x,z-2.2),s.yaw,origin=origin)
    arch_put(lists,13,s,x+1.8,place_ground(site_point(s,x+1.8,z+1.8))+0.12,z+1.8,origin=origin)
    arch_prop(props,4,site_point(s,x-1.8,z+2.3),s.yaw,origin=origin)


arch_stairs = (lists: mut Instance3D[][],e: TownEntry,origin:vec3=vec3(0,0,0)):
    steps=e.steps; run=f64(length(e.front-e.outside))/f64(steps)
    direction=e.front-e.outside; yaw=atan2(f64(direction.x),f64(direction.y))
    loop k in 0..steps:
        at=mix(e.outside,e.front,f32((f64(k)+0.5)/f64(steps)))
        top=e.bottom+(e.top-e.bottom)*f64(k+1)/f64(steps)
        low=min(place_ground(at)-0.15,e.bottom-0.15)
        right=vec2(f32(cos(yaw)),f32(-sin(yaw)))
        forward=normalize(direction)
        loop side in [-0.5,0.5]:
            loop end in [-0.5,0.5]:
                corner=at+right*f32(e.width*side)+forward*f32(run*end)
                low=min(low,place_ground(corner)-0.15)
        lists[14].push(Instance3D(translation(world_local(WorldPoint(at.x,low,at.y),origin))*rotation_y(yaw)*scaling(vec3(f32(e.width),f32(top-low),f32(run+0.015))),vec4(1,1,1,1)))


# Open side passages are paved too; exposed end walls get windows. Attached
# party walls stay plain and no balcony/shutter is inserted into a narrow gap.
arch_side_lanes = (lists: mut Instance3D[][],paths: mut Vertex3D[],s: TownSite,sites: TownSite[],ornament: bool,origin:vec3=vec3(0,0,0)):
    loop side in [-1.0,1.0]:
        x=side*(s.width*0.5+1.8)
        a=site_point(s,x,s.depth*0.5+2.8)
        b=site_point(s,x,-s.depth*0.5-2.8)
        if not lane_clear(sites,a,b,2.4): continue
        town_path(paths,a,b,2.4,true,origin=origin)
        # A low kerb on the garden side; doors and cross-lane mouths stay open.
        loop k in 0..3:
            z=-s.depth*0.3+f64(k)*s.depth*0.3
            at=site_point(s,x+side*1.28,z)
            arch_put(lists,15,s,x+side*1.28,place_ground(at)+0.08,z,vec3(0.24,0.18,f32(s.depth*0.29)),origin=origin)
        if not ornament or s.chapel: continue
        sy=if s.modular: s.height/(f64(s.floors)*4+1) else: 1.0
        loop fl in 0..min(s.floors,3):
            z=if s.seed%2==0: -s.depth*0.18 else: s.depth*0.15
            wx=side*(s.width*0.5+0.17); at=site_point(s,wx,z)
            y=f64(s.at.y)+(2+f64(fl)*4)*sy
            if y-1.1<place_ground(at): continue
            arch_put(lists,town_joinery(s.seed,s.country),s,wx,y,z,vec3(1,f32(sy),1),side*PI/2,origin=origin)
            if (s.seed/13+fl)%3==0: arch_put(lists,17,s,wx,y,z,vec3(1,f32(sy),1),side*PI/2,origin=origin)

# Inland homes get small cultivated back gardens; farmsteads have a longer
# pair of beds. No new identities, stock or off-screen residents are created.
# The fixed close-site budget and density tier bound these shared instances.
arch_rural_garden = (lists: mut Instance3D[][],s: TownSite,sites: TownSite[],origin: vec3):
    if s.rural==0 or s.service or s.chapel: return
    rows=if s.rural==2: 4 else: 2
    loop side in [-1.0,1.0]:
        loop row in 0..rows:
            x=side*(s.width*0.5+3.2);z= -s.depth*0.5-1.8-f64(row)*1.15
            at=site_point(s,x,z)
            safe=arch_clear(sites,at,1.2)
            ground=place_ground(at)
            loop dx in [-0.7,0.7]:
                loop dz in [-0.45,0.45]:
                    q=site_point(s,x+dx,z+dz)
                    if abs(place_ground(q)-ground)>0.12:safe=false
            if safe:arch_put(lists,18,s,x,ground+0.03,z,origin=origin)

# Short masonry pieces follow the slope; opposite sides stop at the end walls'
# inner faces. The front and rear gates keep both the house and fields reachable.
arch_farm_wall = (lists: mut Instance3D[][],s: TownSite,a: vec2,b: vec2,origin: vec3):
    n=max(1,int(ceil(f64(length(b-a))/2.4)))
    loop k in 0..n:
        p=mix(a,b,f32(k)/f32(n));q=mix(a,b,f32(k+1)/f32(n));mid=(p+q)*0.5
        hp=place_ground(site_point(s,p.x,p.y));hq=place_ground(site_point(s,q.x,q.y))
        low=min(hp,hq)-0.15;top=max(hp,hq)+FARM_WALL_HEIGHT
        turn=atan2(f64(q.x-p.x),f64(q.y-p.y))
        arch_put(lists,if s.country==2:16 else:15,s,mid.x,low,mid.y,vec3(0.45,f32(top-low),length(q-p)),turn,origin)

arch_farmstead = (lists: mut Instance3D[][],props: mut Instance3D[][],paths: mut Vertex3D[],s: TownSite,ornament: bool,origin: vec3):
    yard=site_farm_yard(s)
    if yard==none:return
    b=yard!;gate=f32(-s.width*0.2)
    # Leave a 3.4 m opening aligned with the actual door, not a decorative gate
    # placed across the household's walking route.
    loop wall in site_farm_walls(s):arch_farm_wall(lists,s,wall.a,wall.b,origin)
    # A real path continues out to the existing vines/fields. It goes around the
    # farmhouse, never diagonally through its footprint.
    side=s.width*0.5+3.5
    town_path(paths,site_point(s,gate,b.w+5),site_point(s,gate,s.depth*0.5+0.6),2.4,true,origin)
    town_path(paths,site_point(s,side,-s.depth*0.5-2),site_point(s,side,b.y+2),2.2,true,origin)
    town_path(paths,site_point(s,side,b.y+2),site_point(s,gate,b.y+2),2.2,true,origin)
    town_path(paths,site_point(s,gate,b.y+2),site_point(s,gate,b.y-4),2.2,true,origin)
    if not ornament:return
    # Folded gates are mounted on the outside face, physically clear of stone.
    loop z in [b.y,b.w]:
        loop side in [-1.0,1.0]:
            x=f64(gate)+side*2.65;at=site_point(s,x,z)
            arch_put(lists,20,s,x,place_ground(at),f64(z)+(if z==b.w:0.34 else:-0.34),origin=origin)
    # Three paired olive rows, individually rooted in terrain, inside the yard.
    loop x in [-s.width*0.5-4,s.width*0.5+4]:
        loop row in 0..3:
            z=-s.depth*0.5-6+f64(row)*5.0;at=site_point(s,x,z)
            h=place_ground(at)
            props[21].push(Instance3D(translation(world_local(WorldPoint(at.x,h,at.y),origin))*rotation_y(s.yaw)*scaling(0.65),vec4(1,1,1,1)))
    # A small circular threshing floor, conforming to the canonical ground.
    # It is separate from the entry strip so two paving skins never overlap.
    local=vec2(f32(s.width*0.5+5.85),f32(s.depth*0.5+2.1));radius=1.55
    center=site_point(s,local.x,local.y)
    cp=world_local(WorldPoint(center.x,place_ground(center)+0.12,center.y),origin)
    loop k in 0..16:
        a=f64(k)*TAU/16;bearing=f64(k+1)*TAU/16
        a2=center+vec2(f32(cos(a)*radius),f32(sin(a)*radius));b2=center+vec2(f32(cos(bearing)*radius),f32(sin(bearing)*radius))
        ap=world_local(WorldPoint(a2.x,place_ground(a2)+0.12,a2.y),origin)
        bp=world_local(WorldPoint(b2.x,place_ground(b2)+0.12,b2.y),origin)
        town_paving_triangle(paths,cp,ap,bp,rgb(0.73,0.66,0.49),0.875,0.12,0,origin)
        mid=(a+bearing)*0.5
        town_paving_shoulder(paths,a2-origin.xz,b2-origin.xz,vec2(f32(cos(mid)),f32(sin(mid))),origin=origin)
    # Grazing animals occupy the front left of the plot, visible from the road
    # and clear of the entry strip and the side passage.
    loop k in 0..2:
        x=-s.width*0.5-5.4+f64(k)*0.8;z=s.depth*0.5+1.8+f64(k)*1.7
        at=site_point(s,x,z)
        arch_put(lists,21,s,x,place_ground(at),z,turn=f64(k)*1.4,origin=origin)
