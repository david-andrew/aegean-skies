# The archipelago: islands, their shapes, and the height of the world at any point.
# Coordinates: meters, y up, x east, z south (so north is -z). Sea level is y = 0.

const WORLD_SIZE = 16000.0          # the playable square, centered on the origin
const SEA_FLOOR = -60.0

enum Shape:
    cliffs      # a limestone island: white cliffs falling straight to the sea, green above
    hills       # rounded green hills with beaches in the coves
    rock        # a small, bare, steep rock
    cay         # low and sandy: a beach all round, a little scrub in the middle

struct Island:
    name: str
    center: vec2                    # x, z
    radius: f64                     # the coast is roughly this far out
    peak: f64                       # height of its highest ground
    shape: Shape
    seed: f64
    stretch: vec2 = vec2(1, 1)      # long islands
    turn: f64 = 0.0                 # their heading

ISLANDS: Island[] = [
    Island("Kalamos", vec2(0, 0), 1500.0, 260.0, .hills, 1.7, vec2(1.3, 0.8), 0.4),
    Island("Thera Minor", vec2(-4200, -2600), 1200.0, 330.0, .cliffs, 4.2, vec2(1.0, 0.7), -0.6),
    Island("Skopelos Rock", vec2(-1800, 3200), 280.0, 110.0, .rock, 9.1),
    Island("Agios Nikolaos", vec2(4600, -3400), 1700.0, 420.0, .cliffs, 2.9, vec2(1.2, 0.9), 1.1),
    Island("Leuke", vec2(3800, 3600), 600.0, 18.0, .cay, 6.6, vec2(1.5, 0.7), 0.2),
    Island("Mikra", vec2(-5200, 3800), 900.0, 190.0, .hills, 7.3, vec2(0.9, 1.2), 0.9),
    Island("Porto Vecchio", vec2(-600, -6000), 2000.0, 380.0, .hills, 3.3, vec2(1.4, 0.8), -0.2),
    Island("The Teeth", vec2(6400, 1200), 220.0, 85.0, .rock, 5.5),
    Island("Kryfo", vec2(-6600, -400), 700.0, 240.0, .cliffs, 8.8, vec2(1.0, 1.0), 0.0),
    Island("Selene", vec2(2300, -2500), 120.0, 16.0, .cliffs, 2.2),
]

# (the shape of one island, in its own frame: d is the distance from its center over its radius,
# after the coastline's wobble; the result is meters above sea level)
_profile = (isl: Island, d: f64, lx: f64, lz: f64) -> f64:
    s = isl.seed * 100.0
    # rolling ground over the whole island
    roll = fbm(lx * 0.0018 + s, lz * 0.0018 - s, 4)
    t = 1.0 - d                                   # 0 at the coast, 1 at the center
    match isl.shape:
        .cliffs:
            # a plateau: a cliff band at the coast, then gentle rise and ridges
            cliff = smoothstep(0.0, 0.035, t)
            rise = pow(clamp(t, 0.0, 1.0), 0.8)
            ridge = 1.0 - abs(fbm(lx * 0.0035 - s, lz * 0.0035 + s, 3) * 2.0 - 1.0)
            h = cliff * isl.peak * 0.32 + rise * isl.peak * (0.35 + 0.33 * ridge * roll * 1.4)
            # under the sea a steep drop
            if t < 0.0: return -6.0 + t * 260.0
            h
        .hills:
            # beaches: a gentle shelf near the coast, then hills
            beach = smoothstep(0.0, 0.025, t)
            hill = pow(clamp(t / 0.85, 0.0, 1.0), 0.75)
            bumps = fbm(lx * 0.004 + s, lz * 0.004, 3)
            h = beach * 1.6 + hill * isl.peak * (0.55 + 0.65 * roll * bumps * 1.6)
            if t < 0.0: return t * 70.0 - 1.0
            h
        .rock:
            jag = fbm(lx * 0.02 + s, lz * 0.02, 3)
            h = smoothstep(0.0, 0.25, t) * isl.peak * (0.6 + 0.6 * jag) + t * isl.peak * 0.4
            if t < 0.0: return -4.0 + t * 180.0
            h
        .cay:
            h = smoothstep(0.0, 0.5, t) * isl.peak * (0.5 + roll)
            if t < 0.0: return t * 22.0 - 0.6       # a wide shallow shelf: the turquoise lagoon
            h

# the island's own distance (with the coastline's wobble) for a world point; and its local coords
_island_d = (isl: Island, x: f64, z: f64) -> (f64, f64, f64):
    dx = x - f64(isl.center.x)
    dz = z - f64(isl.center.y)
    c = cos(isl.turn)
    s = sin(isl.turn)
    lx = (dx * c - dz * s) / f64(isl.stretch.x)
    lz = (dx * s + dz * c) / f64(isl.stretch.y)
    r = sqrt(lx * lx + lz * lz) / isl.radius
    # the coast: bays and headlands
    a = atan2(lz, lx)
    wob = (fbm(cos(a) * 1.6 + isl.seed * 7.0, sin(a) * 1.6 - isl.seed * 3.0, 4) - 0.5) * 0.55
    wob += (noise(lx * 0.006 + isl.seed, lz * 0.006) - 0.5) * 0.18
    (r * (1.0 + wob), lx, lz)

# how far out an island's influence reaches (in its own radii): beyond it, open sea floor
const REACH = 1.9

island_height = (isl: Island, x: f64, z: f64) -> f64:
    d, lx, lz = _island_d(isl, x, z)
    if d > REACH: return SEA_FLOOR
    max(_profile(isl, d, lx, lz), SEA_FLOOR)

# the ground (or sea floor) height anywhere in the world
height = (x: f64, z: f64) -> f64:
    h = SEA_FLOOR
    loop isl in ISLANDS:
        dx = x - f64(isl.center.x)
        dz = z - f64(isl.center.y)
        reach = isl.radius * REACH * f64(max(isl.stretch.x, isl.stretch.y)) * 1.4
        if dx * dx + dz * dz > reach * reach: continue
        h = max(h, island_height(isl, x, z))
    h

# which island a point is over (or nearest), -1 when out at sea far from all
island_at = (x: f64, z: f64) -> int:
    best = -1
    bd = 1e18
    loop i in 0..ISLANDS.len():
        isl = ISLANDS[i]
        d, _, _ = _island_d(isl, x, z)
        if d < bd:
            bd = d
            best = i
    if bd < 1.6: best else: -1

# ---------------- settlements ----------------

enum Place:
    port            # a harbor town: market, workshop, harbor office, inn
    village         # a fishing village: a quay, an inn, a few boats
    hotel           # a hotel on its own islet: a dock, a terrace, pilots in the evening
    cove            # a hidden cove: a beach, a hut, a hangar in the rock
    monastery       # a cliff-top village with a chapel and a little airstrip on the plateau

struct Settlement:
    name: str
    island: int
    bearing: f64                    # which side of the island it is on (radians, 0: east, turning to south)
    kind: Place
    size: int                       # how many houses
    seed: int

SETTLEMENTS: Settlement[] = [
    Settlement("Porto Vecchio", 6, 0.9, .port, 70, 11),
    Settlement("Kalamos", 0, 2.4, .village, 26, 12),
    Settlement("Agios Nikolaos", 3, 3.6, .monastery, 18, 13),
    Settlement("Mikra", 5, 0.3, .village, 14, 14),
    Settlement("Hotel Selene", 9, 1.2, .hotel, 1, 15),
    Settlement("Kryfo Cove", 8, 3.3, .cove, 3, 16),
]

# where the coast is, going out from an island's center along a bearing: the first point under
# the sea (to within a meter or so) and the way out to sea there
coast_point = (island: int, bearing: f64) -> (vec2, vec2):
    isl = ISLANDS[island]
    d = vec2(f32(cos(bearing)), f32(sin(bearing)))
    r = 0.0
    loop r < isl.radius * 4.0:
        p = isl.center + d * f32(r)
        if height(f64(p.x), f64(p.y)) < -1.0: break
        r += 4.0
    (isl.center + d * f32(r), d)

# the slope of the ground at a point (rise per meter)
slope_at = (x: f64, z: f64) -> f64:
    e = 3.0
    gx = (height(x + e, z) - height(x - e, z)) / (2.0 * e)
    gz = (height(x, z + e) - height(x, z - e)) / (2.0 * e)
    sqrt(gx * gx + gz * gz)
