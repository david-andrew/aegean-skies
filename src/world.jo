# The archipelago: islands, their shapes, and the height of the world at any point.
use 'erosion.jo'

# Coordinates: meters, y up, x east, z south (so north is -z). Sea level is y = 0.

const WORLD_SIZE = 16000.0          # the playable square, centered on the origin
const SEA_FLOOR = -60.0

enum Shape:
    cliffs      # a limestone island: white cliffs falling straight to the sea, green above
    hills       # rounded green hills with beaches in the coves
    rock        # a small, bare, steep rock
    cay         # low and sandy: a beach all round, a little scrub in the middle

struct Island:
    name: str
    center: vec2                    # x, z
    radius: f64                     # the coast is roughly this far out
    peak: f64                       # height of its highest ground
    shape: Shape
    seed: f64
    stretch: vec2 = vec2(1, 1)      # long islands
    turn: f64 = 0.0                 # their heading
    erosion: f64 = 1.0              # how worn by water
    index: int = 0                  # (its place in ISLANDS)

ISLANDS: Island[] = [
    Island("Kalamos", vec2(0, 0), 1500.0, 260.0, .hills, 1.7, vec2(1.3, 0.8), 0.4, 0.7),
    Island("Thera Minor", vec2(-4200, -2600), 1200.0, 330.0, .cliffs, 4.2, vec2(1.0, 0.7), -0.6),
    Island("Skopelos Rock", vec2(-1800, 3200), 280.0, 110.0, .rock, 9.1, vec2(1, 1), 0.0, 0.35),
    Island("Agios Nikolaos", vec2(4600, -3400), 1700.0, 420.0, .cliffs, 2.9, vec2(1.2, 0.9), 1.1),
    Island("Leuke", vec2(3800, 3600), 600.0, 18.0, .cay, 6.6, vec2(1.5, 0.7), 0.2),
    Island("Mikra", vec2(-5200, 3800), 900.0, 190.0, .hills, 7.3, vec2(0.9, 1.2), 0.9, 0.7),
    Island("Porto Vecchio", vec2(-600, -6000), 2000.0, 380.0, .hills, 3.3, vec2(1.4, 0.8), -0.2, 0.75),
    Island("The Teeth", vec2(6400, 1200), 220.0, 85.0, .rock, 5.5, vec2(1, 1), 0.0, 0.35),
    Island("Kryfo", vec2(-6600, -400), 700.0, 240.0, .cliffs, 8.8, vec2(1.0, 1.0), 0.0),
    Island("Selene", vec2(2300, -2500), 120.0, 16.0, .cliffs, 2.2),
]
loop k in 0..ISLANDS.len(): ISLANDS[k].index = k

# (the shape of one island, in its own frame: d is the distance from its center over its radius,
# after the coastline's wobble; the result is meters above sea level)
_profile = (isl: Island, d: f64, lx: f64, lz: f64) -> f64:
    s = isl.seed * 100.0
    # rolling ground over the whole island
    roll = fbm(lx * 0.0018 + s, lz * 0.0018 - s, 4)
    t = 1.0 - d                                   # 0 at the coast, 1 at the center
    match isl.shape:
        .cliffs:
            # a plateau: a cliff band at the coast, then gentle rise and ridges
            cliff = smoothstep(0.0, 0.035, t)
            rise = pow(clamp(t, 0.0, 1.0), 0.8)
            ridge = 1.0 - abs(fbm(lx * 0.0035 - s, lz * 0.0035 + s, 3) * 2.0 - 1.0)
            h = cliff * isl.peak * 0.32 + rise * isl.peak * (0.35 + 0.33 * ridge * roll * 1.4)
            # under the sea a steep drop
            if t < 0.0: return -6.0 + t * 260.0
            h
        .hills:
            # beaches: a gentle shelf near the coast, then hills
            beach = smoothstep(0.0, 0.025, t)
            hill = pow(clamp(t / 0.85, 0.0, 1.0), 0.75)
            bumps = fbm(lx * 0.004 + s, lz * 0.004, 3)
            h = beach * 1.6 + hill * isl.peak * (0.55 + 0.65 * roll * bumps * 1.6)
            if t < 0.0: return t * 70.0 - 1.0
            h
        .rock:
            jag = fbm(lx * 0.02 + s, lz * 0.02, 3)
            h = smoothstep(0.0, 0.25, t) * isl.peak * (0.6 + 0.6 * jag) + t * isl.peak * 0.4
            if t < 0.0: return -4.0 + t * 180.0
            h
        .cay:
            h = smoothstep(0.0, 0.5, t) * isl.peak * (0.5 + roll)
            if t < 0.0: return t * 22.0 - 0.6       # a wide shallow shelf: the turquoise lagoon
            h

# the island's own distance (with the coastline's wobble) for a world point; and its local coords
_island_d = (isl: Island, x: f64, z: f64) -> (f64, f64, f64):
    dx = x - f64(isl.center.x)
    dz = z - f64(isl.center.y)
    c = cos(isl.turn)
    s = sin(isl.turn)
    lx = (dx * c - dz * s) / f64(isl.stretch.x)
    lz = (dx * s + dz * c) / f64(isl.stretch.y)
    # the coast: the island's frame bent by noise (peninsulas, bays), then a ragged edge
    sc = 1.1 / isl.radius
    wx = (fbm(lx * sc + isl.seed * 5.0, lz * sc - isl.seed, 3) - 0.5) * isl.radius * 1.1
    wz = (fbm(lx * sc - isl.seed * 2.0, lz * sc + 9.0 + isl.seed, 3) - 0.5) * isl.radius * 1.1
    qx = lx + wx
    qz = lz + wz
    r = sqrt(qx * qx + qz * qz) / isl.radius
    a = atan2(qz, qx)
    wob = (fbm(cos(a) * 1.8 + isl.seed * 7.0, sin(a) * 1.8 - isl.seed * 3.0, 4) - 0.5) * 0.5
    wob += (noise(lx * 0.008 + isl.seed, lz * 0.008) - 0.5) * 0.14
    (r * (1.0 + wob), lx, lz)

# how far out an island's influence reaches (in its own radii): beyond it, open sea floor
const REACH = 1.9

# the island's shape before the weather has worn it
island_base = (isl: Island, x: f64, z: f64) -> f64:
    d, lx, lz = _island_d(isl, x, z)
    if d > REACH: return SEA_FLOOR
    max(_profile(isl, d, lx, lz), SEA_FLOOR)

# (the land is eroded in units of this many meters: the filter's scale and strength are in them)
const ERODE_UNIT = 1000.0
ERODE = ErosionParams(scale = 0.13, strength = 0.2)

# the island's height, worn by water: gullies down its slopes, sharper ridges between them
# (and the ridge map: -1 in creases, 1 on ridges, for the ground's colors)
island_height_ridge = (isl: Island, x: f64, z: f64) -> (f64, f64):
    h = island_base(isl, x, z)
    if h < 1.0: return (h, 0.0)
    e = 4.0
    gx = (island_base(isl, x + e, z) - island_base(isl, x - e, z)) / (2.0 * e)
    gz = (island_base(isl, x, z + e) - island_base(isl, x, z - e)) / (2.0 * e)
    fade = clamp(h / isl.peak * 2.0 - 1.0, -1.0, 1.0)
    er = erode(x / ERODE_UNIT, z / ERODE_UNIT, h / ERODE_UNIT, gx, gz, fade, ERODE, int(isl.seed * 100.0))
    # kept off the beaches and the coast, so the islands keep their outlines
    mask = smoothstep(1.0, 22.0, h) * isl.erosion
    dh = (er.dh - 0.5 * er.magnitude) * ERODE_UNIT * mask
    (max(h + dh, min(h, 1.5)), er.ridge * mask)

# ---------------- the baked land ----------------
# Eroding is slow (some 15 us a point), so the land's heights are worked out once (tools/bake.jo)
# on a grid TILE meters apart over each island's land, kept in assets/terrain.bin, and read back
# from it; between grid points they are interpolated. Without the file (or with one made for
# other islands) they are worked out as they are asked for.

const TILE = 8.0

struct LandTile:
    x0: f64
    z0: f64
    nx: int
    nz: int
    h: f32[]
    ridge: f32[]

land_tiles: LandTile[]              # by island; empty until loaded

terrain_key = () -> int: int((hash(ISLANDS) xor hash(ERODE) xor u64(TILE * 1000.0)) & u64(0x7FFFFFFFFFFFFFFF))

# the grid one island's land is baked on: its corner and size (where the shape before erosion is
# above the water, and a margin)
land_extent = (isl: Island) -> (f64, f64, int, int):
    ext = isl.radius * REACH * f64(max(isl.stretch.x, isl.stretch.y)) * 1.05
    x0 = 1e9
    z0 = 1e9
    x1 = -1e9
    z1 = -1e9
    step = 16.0
    x = f64(isl.center.x) - ext
    loop x < f64(isl.center.x) + ext:
        z = f64(isl.center.y) - ext
        loop z < f64(isl.center.y) + ext:
            if island_base(isl, x, z) > -1.0:
                x0 = min(x0, x); z0 = min(z0, z); x1 = max(x1, x); z1 = max(z1, z)
            z += step
        x += step
    if x1 < x0: return (f64(isl.center.x), f64(isl.center.y), 0, 0)
    x0 = floor((x0 - 48.0) / TILE) * TILE
    z0 = floor((z0 - 48.0) / TILE) * TILE
    (x0, z0, int((x1 + 48.0 - x0) / TILE) + 2, int((z1 + 48.0 - z0) / TILE) + 2)

# bake one island's land (in parallel over its rows)
bake_tile = (k: int) -> LandTile:
    isl = ISLANDS[k]
    x0, z0, nx, nz = land_extent(isl)
    rows = parallel_map([0..nz), (j: int) -> (f32, f32)[]:
        row: (f32, f32)[]
        loop i in 0..nx:
            hh, rr = island_height_ridge(isl, x0 + f64(i) * TILE, z0 + f64(j) * TILE)
            row.push((f32(hh), f32(rr)))
        row
    )
    h: f32[]
    r: f32[]
    loop row in rows:
        loop c in row:
            h.push(c.0)
            r.push(c.1)
    LandTile(x0, z0, nx, nz, h, r)

encode_tiles = (tiles: LandTile[]) -> u8[]:
    b: u8[] = [c'A', c'E', c'G', c'T']
    append_le(b, terrain_key(), 8)
    append_le(b, tiles.len(), 4)
    loop t in tiles:
        append_le(b, int(t.x0), 4); append_le(b, int(t.z0), 4); append_le(b, t.nx, 4); append_le(b, t.nz, 4)
        loop v in t.h: append_le(b, int(round(f64(v) * 10.0)), 2)
        loop v in t.ridge: append_le(b, int(round(f64(v) * 127.0)), 1)
    b

# read the baked land; false (and nothing loaded) when it was made for other islands
load_land = (b: u8[]) -> bool:
    global land_tiles
    if b.len() < 16 or b[0] != c'A' or b[3] != c'T': return false
    if get_le_signed(b, 4, 8) != terrain_key(): return false
    n = get_le(b, 12, 4)
    if n != ISLANDS.len(): return false
    at = 16
    tiles: LandTile[]
    loop k in 0..n:
        x0 = f64(get_le_signed(b, at, 4)); z0 = f64(get_le_signed(b, at + 4, 4))
        nx = get_le(b, at + 8, 4); nz = get_le(b, at + 12, 4)
        at += 16
        h = [loop i in 0..nx * nz: f32(f64(get_le_signed(b, at + i * 2, 2)) * 0.1)]
        at += nx * nz * 2
        r = [loop i in 0..nx * nz: f32(f64(get_le_signed(b, at + i, 1)) / 127.0)]
        at += nx * nz
        tiles.push(LandTile(x0, z0, nx, nz, h, r))
    land_tiles = tiles
    true

# the baked value at a point of a tile, between its grid points (none outside it)
_tile_at = (t: LandTile, x: f64, z: f64, ridge: bool) -> f64?:
    fx = (x - t.x0) / TILE
    fz = (z - t.z0) / TILE
    if fx < 0.0 or fz < 0.0 or fx >= f64(t.nx - 1) or fz >= f64(t.nz - 1): return none
    i = int(fx)
    j = int(fz)
    u = fx - f64(i)
    v = fz - f64(j)
    a = j * t.nx + i
    vs = if ridge: t.ridge else: t.h
    f64(vs[a]) * (1.0 - u) * (1.0 - v) + f64(vs[a + 1]) * u * (1.0 - v) + f64(vs[a + t.nx]) * (1.0 - u) * v + f64(vs[a + t.nx + 1]) * u * v

island_height = (isl: Island, x: f64, z: f64) -> f64:
    if land_tiles.len() > 0:
        k = isl.index
        if let h = _tile_at(land_tiles[k], x, z, false): return h
        return island_base(isl, x, z)
    h, _ = island_height_ridge(isl, x, z)
    h

# the ridge map (-1 creases, 1 ridges) at a point, from the baked land
ridge_at = (x: f64, z: f64) -> f64:
    loop t in land_tiles:
        if let r = _tile_at(t, x, z, true): return r
    0.0

# the ground (or sea floor) height anywhere in the world
height = (x: f64, z: f64) -> f64:
    h = SEA_FLOOR
    loop isl in ISLANDS:
        dx = x - f64(isl.center.x)
        dz = z - f64(isl.center.y)
        reach = isl.radius * REACH * f64(max(isl.stretch.x, isl.stretch.y)) * 1.4
        if dx * dx + dz * dz > reach * reach: continue
        h = max(h, island_height(isl, x, z))
    h

# ---------------- the ground as drawn ----------------
# The islands' meshes are grids MESH_STEP meters apart, each cell two triangles split along its
# b-c diagonal (a = i,j; b = i+1,j; c = i,j+1; d = i+1,j+1). Things that stand on the ground
# (people, trees, houses) use this height, so they meet the ground that is drawn.

const MESH_STEP = 14.0

mesh_extent = (isl: Island) -> f64: isl.radius * REACH * f64(max(isl.stretch.x, isl.stretch.y)) * 1.05

surface_height = (x: f64, z: f64) -> f64:
    h = SEA_FLOOR
    loop isl in ISLANDS:
        ext = mesh_extent(isl)
        x0 = f64(isl.center.x) - ext
        z0 = f64(isl.center.y) - ext
        fx = (x - x0) / MESH_STEP
        fz = (z - z0) / MESH_STEP
        if fx < 0.0 or fz < 0.0 or fx > ext * 2.0 / MESH_STEP or fz > ext * 2.0 / MESH_STEP: continue
        i = floor(fx)
        j = floor(fz)
        u = fx - i
        v = fz - j
        ax = x0 + i * MESH_STEP
        az = z0 + j * MESH_STEP
        a = island_height(isl, ax, az)
        b = island_height(isl, ax + MESH_STEP, az)
        c = island_height(isl, ax, az + MESH_STEP)
        d = island_height(isl, ax + MESH_STEP, az + MESH_STEP)
        hh = if u + v <= 1.0: a + u * (b - a) + v * (c - a) else: d + (1.0 - u) * (c - d) + (1.0 - v) * (b - d)
        h = max(h, hh)
    h

# which island a point is over (or nearest), -1 when out at sea far from all
island_at = (x: f64, z: f64) -> int:
    best = -1
    bd = 1e18
    loop i in 0..ISLANDS.len():
        isl = ISLANDS[i]
        d, _, _ = _island_d(isl, x, z)
        if d < bd:
            bd = d
            best = i
    if bd < 1.6: best else: -1

# ---------------- settlements ----------------

enum Place:
    port            # a harbor town: market, workshop, harbor office, inn
    village         # a fishing village: a quay, an inn, a few boats
    hotel           # a hotel on its own islet: a dock, a terrace, pilots in the evening
    cove            # a hidden cove: a beach, a hut, a hangar in the rock
    monastery       # a cliff-top village with a chapel and a little airstrip on the plateau

struct Settlement:
    name: str
    island: int
    bearing: f64                    # which side of the island it is on (radians, 0: east, turning to south)
    kind: Place
    size: int                       # how many houses
    seed: int

SETTLEMENTS: Settlement[] = [
    Settlement("Porto Vecchio", 6, 0.9, .port, 70, 11),
    Settlement("Kalamos", 0, 2.4, .village, 26, 12),
    Settlement("Agios Nikolaos", 3, 3.6, .monastery, 18, 13),
    Settlement("Mikra", 5, 0.3, .village, 14, 14),
    Settlement("Hotel Selene", 9, 1.2, .hotel, 1, 15),
    Settlement("Kryfo Cove", 8, 3.3, .cove, 3, 16),
]

# where the coast is, going out from an island's center along a bearing: the first point under
# the sea (to within a meter or so) and the way out to sea there
coast_point = (island: int, bearing: f64) -> (vec2, vec2):
    isl = ISLANDS[island]
    d = vec2(f32(cos(bearing)), f32(sin(bearing)))
    r = 0.0
    loop r < isl.radius * 4.0:
        p = isl.center + d * f32(r)
        if height(f64(p.x), f64(p.y)) < -1.0: break
        r += 4.0
    (isl.center + d * f32(r), d)

# the slope of the ground at a point (rise per meter)
slope_at = (x: f64, z: f64) -> f64:
    e = 3.0
    gx = (height(x + e, z) - height(x - e, z)) / (2.0 * e)
    gz = (height(x, z + e) - height(x, z - e)) / (2.0 * e)
    sqrt(gx * gx + gz * gz)
