# Drawing the airfields (airfields.jo): the mown strip and apron laid on the terrain's own 14 m
# lattice (same vertices, same diagonal, a few centimetres up: no gap and no fighting), the
# boundary markers, landing circle and T in whitewash, arched hangars open to the field, the office,
# the fuel point, and windsocks that stream with the wind. Built once on approach; nothing is drawn
# or held beyond 12 km.
use 'airfields.jo'
use 'objects.jo'
use 'painted_letters.jo'
use 'world_source.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'look.jo'

struct AirfieldBatch:
    ready = false
    base = 0.0                     # the mesh frame's height: the ground at the strip's centre
    ground_mesh = Mesh()           # strip, apron and whitewash (seen from far)
    built = Mesh()                 # buildings and fittings (near)
    sock = Mesh()
airfield_batches = [loop f in AIRFIELDS: AirfieldBatch()]

# The field frame: X along the strip (u), Z across it (v), Y up from `base`.
airfield_frame = (f: Airfield) -> mat4:
    fwd = airfield_forward(f); right = airfield_right(f)
    m = mat4()
    m[0] = vec4(fwd.x, 0, fwd.y, 0)
    m[1] = vec4(0, 1, 0, 0)
    m[2] = vec4(right.x, 0, right.y, 0)
    m

_aftri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    if n.y < 0: n = -n
    vs.push(Vertex3D(a, n, vec2(0, 0), col)); vs.push(Vertex3D(b, n, vec2(0, 0), col)); vs.push(Vertex3D(c, n, vec2(0, 0), col))

# The ground cover: every 14 m lattice cell whose centre is on the strip or the apron, in world
# offsets from the strip's centre (the lattice is the world's, not the field's).
_airfield_cover = (f: Airfield, base: f64) -> Vertex3D[]:
    vs: Vertex3D[]
    reach = f.half_length + 300.0
    x0 = int(floor((f64(f.center.x) - reach) / 14.0)); x1 = int(ceil((f64(f.center.x) + reach) / 14.0))
    z0 = int(floor((f64(f.center.y) - reach) / 14.0)); z1 = int(ceil((f64(f.center.y) + reach) / 14.0))
    lift = 0.03
    loop iz in z0..z1:
        loop ix in x0..x1:
            if not airfield_cover_cell(ix, iz): continue
            mid = vec2(f32((f64(ix) + 0.5) * 14.0), f32((f64(iz) + 0.5) * 14.0))
            q = airfield_local(f, mid)
            apron = not (abs(f64(q.x)) < f.half_length and abs(f64(q.y)) < f.half_width)
            # mown in bands along the strip, light and dark by the mower's turn; the apron worn
            band = int(floor((f64(q.y) + f.half_width) / 14.0))
            shade = 0.97 + 0.03 * f64(((ix * 7 + iz * 13) % 5)) / 4.0
            col = if apron: rgb(0.58 * shade, 0.5 * shade, 0.37 * shade) else: (if band % 2 == 0: rgb(0.55 * shade, 0.58 * shade, 0.32 * shade) else: rgb(0.62 * shade, 0.64 * shade, 0.38 * shade))
            corner = (i: int, k: int) -> vec3:
                x = f64(i) * 14.0; z = f64(k) * 14.0
                vec3(f32(x - f64(f.center.x)), f32(world_source_surface(x, z) + airfield_vertex_turf(i, k) - base + lift), f32(z - f64(f.center.y)))
            a = corner(ix, iz); b = corner(ix + 1, iz); c = corner(ix, iz + 1); d = corner(ix + 1, iz + 1)
            # (the terrain's own split: a-b-c and d-c-b)
            _aftri(vs, a, c, b, col); _aftri(vs, d, b, c, col)
    vs

# A flat whitewashed mark lying on the ground at field point u, v (its size along u and v).
_mark = (vs: mut Vertex3D[], f: Airfield, base: f64, u: f64, v: f64, su: f64, sv: f64, col: vec4):
    p = airfield_world(f, u, v)
    h = world_source_surface(f64(p.x), f64(p.y)) + airfield_turf(f64(p.x), f64(p.y)) - base
    add_box(vs, vec3(f32(u), f32(h + 0.05), f32(v)), vec3(f32(su), 0.14, f32(sv)), col)

_airfield_marks = (f: Airfield, base: f64) -> Vertex3D[]:
    vs: Vertex3D[]
    white = rgb(0.95, 0.94, 0.88)
    # boundary markers down both edges, the thresholds as rows of bars
    u = -f.half_length
    loop u <= f.half_length + 0.1:
        loop side in [-1.0, 1.0]: _mark(vs, f, base, u, side * (f.half_width + 1.5), 4.0, 1.0, white)
        u += 100.0
    loop end in [-1.0, 1.0]:
        loop k in 0..6: _mark(vs, f, base, end * (f.half_length - 6.0), -f.half_width + 5.0 + f64(k) * 9.2, 1.2, 5.0, white)
    # the landing circle in the field's middle, and the landing T by the threshold windsock
    loop k in 0..32:
        a = f64(k) * TAU / 32.0
        p = vec2(f32(cos(a) * 15.0), f32(sin(a) * 15.0))
        g = airfield_world(f, f64(p.x), f64(p.y))
        h = world_source_surface(f64(g.x), f64(g.y)) + airfield_turf(f64(g.x), f64(g.y)) - base
        add_box(vs, vec3(p.x, f32(h + 0.05), p.y), vec3(3.2, 0.14, 1.1), white, rotation_y(-a))
    _mark(vs, f, base, -585.0, -46.0, 2.0, 12.0, white)
    _mark(vs, f, base, -591.0, -46.0, 10.0, 2.0, white)
    vs

# An arched hangar in field coordinates: a barrel roof of corrugated iron over whitewashed end
# walls, the front (+v) open between two door leaves pushed aside, a concrete floor, the town's
# name across the front.
_hangar = (vs: mut Vertex3D[], b: AirfieldBuilding, floor: f64, ground_low: f64, f: Airfield):
    roof = rgb(0.6, 0.6, 0.56); wall = rgb(0.88, 0.84, 0.74); dark = rgb(0.2, 0.2, 0.19); concrete = rgb(0.68, 0.66, 0.6)
    hw = b.width * 0.5; hd = b.depth * 0.5
    c = vec3(f32(b.u), f32(floor), f32(b.v))
    # plinth down to the lowest ground and the floor slab
    add_box(vs, c + vec3(0, f32(-(floor - ground_low) * 0.5 - 0.1), 0), vec3(f32(b.width + 0.6), f32(floor - ground_low + 0.3), f32(b.depth + 0.6)), concrete)
    wallh = 2.2
    n = 12
    prof = [loop k in 0..n + 1: vec2(f32(-hw * cos(f64(k) * PI / f64(n))), f32(wallh + (b.height - wallh) * sin(f64(k) * PI / f64(n))))]
    loop k in 0..n:
        a = prof[k]; e = prof[k + 1]
        col = if k % 2 == 0: roof else: roof * vec4(0.94, 0.94, 0.94, 1)
        p0 = c + vec3(a.x, a.y, f32(-hd)); p1 = c + vec3(e.x, e.y, f32(-hd)); p2 = c + vec3(e.x, e.y, f32(hd)); p3 = c + vec3(a.x, a.y, f32(hd))
        n_out = normalize(vec3((a.x + e.x) * 0.5, (a.y + e.y) * 0.5 - f32(wallh), 0))
        loop q in [p0, p2, p1, p0, p3, p2]: vs.push(Vertex3D(q, n_out, vec2(0, 0), col))
        # (the underside, a sheet's thickness in, seen from inside the open front)
        loop q in [p0, p1, p2, p0, p2, p3]: vs.push(Vertex3D(q - n_out * 0.08, -n_out, vec2(0, 0), roof * vec4(0.6, 0.6, 0.6, 1)))
    # side walls under the springing of the arch
    loop side in [-1.0, 1.0]: add_box(vs, c + vec3(f32(side * (hw - 0.15)), f32(wallh * 0.5), 0), vec3(0.3, f32(wallh), f32(b.depth)), wall)
    # back wall: a fan under the arch
    centre = c + vec3(0, f32(wallh), f32(-hd))
    loop k in 0..n:
        a = prof[k]; e = prof[k + 1]
        p0 = c + vec3(a.x, a.y, f32(-hd)); p1 = c + vec3(e.x, e.y, f32(-hd))
        n_back = vec3(0, 0, -1)
        loop q in [centre, p1, p0]: vs.push(Vertex3D(q, n_back, vec2(0, 0), wall))
        loop q in [centre, p0, p1]: vs.push(Vertex3D(q + vec3(0, 0, 0.05), vec3(0, 0, 1), vec2(0, 0), wall * vec4(0.8, 0.8, 0.8, 1)))
    add_box(vs, c + vec3(0, f32(wallh * 0.5), f32(-hd)), vec3(f32(b.width), f32(wallh), 0.3), wall)
    # the front: an arched rim, two door leaves run aside, a lintel band with the name
    loop k in 0..n:
        a = prof[k]; e = prof[k + 1]
        mid = (a + e) * 0.5; d = e - a
        add_box(vs, c + vec3(mid.x, mid.y, f32(hd)), vec3(f32(length(d) + 0.1), 0.35, 0.35), wall, rotation_z(atan2(f64(d.y), f64(d.x))))
    loop side in [-1.0, 1.0]:
        add_box(vs, c + vec3(f32(side * (hw - 3.4)), f32(wallh + 1.0) * 0.5 + 0.6, f32(hd + 0.35)), vec3(6.4, f32(wallh + 2.2), 0.2), roof * vec4(0.85, 0.88, 0.85, 1))
        add_box(vs, c + vec3(f32(side * (hw - 0.4)), f32(wallh * 0.5), f32(hd)), vec3(0.8, f32(wallh), 0.5), wall)
    add_box(vs, c + vec3(0, f32(b.height - 1.5), f32(hd + 0.05)), vec3(f32(b.width * 0.55), 1.0, 0.25), wall)
    painted_letters(vs, f.name.split(" ")[0], c + vec3(0, f32(b.height - 1.6), f32(hd + 0.19)), 0.7, dark)
    add_box(vs, c + vec3(0, 0.02, 0), vec3(f32(b.width - 0.6), 0.06, f32(b.depth - 0.4)), concrete)

_office = (vs: mut Vertex3D[], b: AirfieldBuilding, floor: f64, ground_low: f64, country: int):
    wall = if country == 1: rgb(0.86, 0.78, 0.62) else: rgb(0.93, 0.9, 0.82)
    c = vec3(f32(b.u), f32(floor), f32(b.v))
    add_box(vs, c + vec3(0, f32(-(floor - ground_low) * 0.5), 0), vec3(f32(b.width + 0.4), f32(floor - ground_low + 0.2), f32(b.depth + 0.4)), rgb(0.62, 0.58, 0.5))
    add_box(vs, c + vec3(0, f32(b.height * 0.5), 0), vec3(f32(b.width), f32(b.height), f32(b.depth)), wall)
    add_gable(vs, c + vec3(0, f32(b.height), 0), b.width, b.depth, 1.8, ROOFS[1], mat4())
    # windows and a door toward the field, shutters in the country's green
    loop k in 0..4:
        x = -b.width * 0.5 + 2.0 + f64(k) * (b.width - 4.0) / 3.0
        if k == 1:
            add_box(vs, c + vec3(f32(x), 1.1, f32(b.depth * 0.5 + 0.03)), vec3(1.1, 2.2, 0.08), rgb(0.3, 0.22, 0.14))
            continue
        add_box(vs, c + vec3(f32(x), 1.8, f32(b.depth * 0.5 + 0.03)), vec3(0.9, 1.2, 0.08), rgb(0.16, 0.2, 0.21))
        loop side in [-1.0, 1.0]: add_box(vs, c + vec3(f32(x + side * 0.72), 1.8, f32(b.depth * 0.5 + 0.08)), vec3(0.5, 1.25, 0.06), rgb(0.22, 0.38, 0.3))
    # a mast with a pennant on the roof's end
    add_cylinder(vs, c + vec3(f32(b.width * 0.5 - 1.0), f32(b.height), 0), 0.06, 6.0, rgb(0.85, 0.83, 0.78), 6)
    add_box(vs, c + vec3(f32(b.width * 0.5 - 0.3), f32(b.height + 5.6), 0), vec3(1.3, 0.5, 0.03), if country == 1: rgb(0.16, 0.32, 0.62) else: rgb(0.72, 0.18, 0.13))

# The fuel point: a shed, a tank raised on legs with its hose to a hand pump, and drums.
_fuel_point = (vs: mut Vertex3D[], b: AirfieldBuilding, floor: f64, f: Airfield, base: f64):
    shed = rgb(0.55, 0.47, 0.36); tank = rgb(0.6, 0.18, 0.13); metal = rgb(0.32, 0.32, 0.3)
    c = vec3(f32(b.u), f32(floor), f32(b.v))
    add_box(vs, c + vec3(0, f32(b.height * 0.5 - 0.3), 0), vec3(f32(b.width), f32(b.height + 0.6), f32(b.depth)), shed)
    add_box(vs, c + vec3(0, f32(b.height + 0.25), 0), vec3(f32(b.width + 0.6), 0.12, f32(b.depth + 0.6)), rgb(0.45, 0.45, 0.43))
    fp = airfield_world(f, f64(AIRFIELD_FUEL.x), f64(AIRFIELD_FUEL.y))
    g = f32(world_source_surface(f64(fp.x), f64(fp.y)) + airfield_turf(f64(fp.x), f64(fp.y)) - base)
    at = vec3(AIRFIELD_FUEL.x, g, AIRFIELD_FUEL.y)
    loop dx in [-1.1, 1.1]:
        loop dz in [-0.6, 0.6]: add_box(vs, at + vec3(f32(dx) + 3.0, 1.4, f32(dz)), vec3(0.12, 2.8, 0.12), metal)
    add_cylinder(vs, vec3(0, -1.4, 0), 0.75, 2.8, tank, 12, -1.0, translation(at + vec3(3.0, 3.6, 0)) * rotation_z(PI / 2))
    add_cylinder(vs, at, 0.16, 1.5, tank, 8)
    add_box(vs, at + vec3(0, 1.55, 0), vec3(0.5, 0.1, 0.3), metal)
    add_box(vs, at + vec3(0.25, 1.15, 0.25), vec3(0.06, 0.06, 0.6), metal, rotation_x(0.6))
    loop k in 0..6:
        add_cylinder(vs, at + vec3(f32(-2.0 - f64(k % 3) * 0.7), 0, f32(-0.6 + f64(k / 3) * 0.75)), 0.3, 0.9, if k == 4: rgb(0.25, 0.35, 0.3) else: rgb(0.52, 0.2, 0.14), 8)

_airfield_built = (f: Airfield, base: f64) -> Vertex3D[]:
    vs: Vertex3D[]
    loop b in AIRFIELD_BUILDINGS:
        floor = airfield_floor(f, b) - base
        low = 1e9
        loop du in [-0.5, 0.5]:
            loop dv in [-0.5, 0.5]: low = min(low, airfield_ground(airfield_world(f, b.u + du * b.width, b.v + dv * b.depth)) - base)
        if b.kind == 0: _hangar(vs, b, floor, low, f)
        else if b.kind == 1: _office(vs, b, floor, low, f.country)
        else: _fuel_point(vs, b, floor, f, base)
    # windsock masts
    loop s in AIRFIELD_SOCKS:
        p = airfield_world(f, f64(s.x), f64(s.y))
        g = f32(world_source_surface(f64(p.x), f64(p.y)) - base)
        add_cylinder(vs, vec3(s.x, g, s.y), 0.08, 6.2, rgb(0.86, 0.85, 0.8), 6, 0.05)
        add_box(vs, vec3(s.x, g + 6.15, s.y), vec3(0.75, 0.05, 0.05), rgb(0.3, 0.3, 0.28))
    vs

# The sock: a truncated cone streaming along +Z from its ring, in red and white bands.
_sock_mesh = () -> Mesh:
    vs: Vertex3D[]
    loop k in 0..5:
        col = if k % 2 == 0: rgb(0.86, 0.3, 0.14) else: rgb(0.95, 0.93, 0.87)
        r0 = 0.36 - f64(k) * 0.045; r1 = r0 - 0.045
        add_cylinder(vs, vec3(0, f32(f64(k) * 0.55), 0), r0, 0.55, col, 10, r1, rotation_x(PI / 2))
    custom_mesh(vs)

_place_mesh = (f: Airfield, vs: Vertex3D[], base: f64, field_frame: bool) -> Mesh:
    if not field_frame: return mesh(vs)
    m = airfield_frame(f)
    mesh([loop v in vs: Vertex3D(transform_point(m, v.pos), transform_dir(m, v.normal), v.uv, v.color)])

prepare_airfield = (k: int):
    global airfield_batches
    if airfield_batches[k].ready: return
    f = AIRFIELDS[k]
    base = airfield_ground(f.center)
    marks = _airfield_marks(f, base)
    cover = _airfield_cover(f, base)
    m = airfield_frame(f)
    loop v in marks: cover.push(Vertex3D(transform_point(m, v.pos), transform_dir(m, v.normal), v.uv, v.color))
    airfield_batches[k] = AirfieldBatch(true, base, mesh(cover), _place_mesh(f, _airfield_built(f, base), base, true), _sock_mesh())

airfield_anchor = (k: int) -> WorldPoint:
    f = AIRFIELDS[k]
    world_point(vec3(f.center.x, f32(airfield_batches[k].base), f.center.y))

# wind: the air's velocity at the field (m/s, world frame).
draw_airfields = (L: Light, t: f64, wind: vec3):
    cam = scene_camera()
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]
        d = f64(length(cam.xz - f.center))
        if d > 12000.0: continue
        prepare_airfield(k)
        anchor = airfield_anchor(k)
        draw(obj_sh, airfield_batches[k].ground_mesh, obj_params(L, t, anchor = anchor))
        if d > 5000.0: continue
        draw(obj_sh, airfield_batches[k].built, obj_params(L, t, anchor = anchor))
        if d > 2000.0: continue
        # the socks: pointing downwind, filling out as the wind rises, hanging slack in a calm
        speed = f64(length(wind.xz))
        yaw = if speed > 0.2: atan2(f64(wind.x), f64(wind.z)) else: 0.0
        droop = (1.0 - clamp(speed / 9.0, 0.0, 1.0)) * 1.25 + 0.05 * sin(t * 2.3)
        fm = airfield_frame(f)
        loop s in AIRFIELD_SOCKS:
            p = airfield_world(f, f64(s.x), f64(s.y))
            g = world_source_surface(f64(p.x), f64(p.y)) - airfield_batches[k].base
            top = transform_point(fm, vec3(s.x, f32(g + 6.15), s.y))
            model = translation(top) * rotation_y(yaw) * rotation_x(droop + 0.04 * sin(t * 3.1 + f64(s.x)))
            draw(obj_sh, airfield_batches[k].sock, obj_params(L, t, model, anchor = anchor))
