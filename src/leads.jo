# Leads: now and then people mention something the pilot could go and do, as people do in passing:
# someone after a lift, a load left on a dock, a race on, a boat overdue, music at the Ancora
# tonight. Each is real (a job, a meeting, a story, the band's evening) and leads there when
# followed; it is said once by each person, in their own words, one detail at most, and is not
# kept anywhere for the player: no quest log, no marker. The scene asks for a speaker's lead
# (in talk, at the table, in passing) and passes in the flying clubs' meetings it keeps.
use 'living_types.jo'
use 'life_types.jo'
use 'living_place_context.jo'
use 'living_talk_words.jo'
use 'band_roster.jo'
use 'errand_words.jo'

enum LeadKind: ride, cargo, race, overdue, band

struct Lead:
    kind: LeadKind
    key: str                        # (said once per person: "ride:12")
    subject = -1                    # the job, meeting or story it is about (-1: the band)
    place = -1                      # where: a harbour (core place index) or, for a race, the capital's id
    day = -1                        # (a race: its day; the band: tonight's day)

# A flying club's meeting, as the scene keeps them (src/air_race.jo AirMeet).
struct MeetNote:
    id: int
    capital: int                    # settlement id of the capital
    day: int
    open = true                     # still taking entries (registration)
    fast = false                    # Schneider-class

const LEAD_CARGO_WAIT = 120         # a load nobody has taken for two hours is talked of

_first = (w: World, p: int) -> str: if p >= 0 and p < w.people.len(): split(w.people[p].name," ")[0] else: ""

_town = (w: World, place: int) -> str: life_place_name(w,place)

_core_of = (w: World, person: int) -> int:
    if person < 0 or person >= w.people.len(): return -1
    p = w.people[person].place
    if p >= 0 and p < w.places.len(): p else: -1

# The band's players in Porto Vecchio and free to play tonight (not away on the sea or the road,
# not laid up): with fewer than two there is no music to speak of.
lead_band_players = (w: World) -> int:
    n = 0
    loop q in BAND_ROSTER:
        if q >= w.people.len() or w.people[q].injured_until > w.minute: continue
        adrift = false
        loop a in w.adrift:
            if a.person == q and a.state != .home: adrift = true
        if adrift: continue
        p = w.people[q]
        # (in town, or out on a round trip from it and back in the evening: fishing, an errand)
        local = p.trip >= 0 and p.trip in w.trips and w.trips[p.trip].origin == BAND_PLACE and w.trips[p.trip].destination == BAND_PLACE
        if (p.trip < 0 and p.place == BAND_PLACE) or local: n += 1
    n

# Whether a lead is still real: the job still open (and the passenger still waiting), the meeting
# still taking entries, the boat still not back, the band still to play tonight.
lead_real = (w: World, l: Lead, meets: MeetNote[]) -> bool:
    match l.kind:
        .ride:
            if not (l.subject in w.jobs): return false
            j = w.jobs[l.subject]
            j.state == .open and j.passenger >= 0 and j.passenger < w.people.len() and w.people[j.passenger].place == j.origin and w.minute < j.expire_minute
        .cargo:
            if not (l.subject in w.jobs): return false
            j = w.jobs[l.subject]
            j.state == .open and j.passenger < 0 and j.cargo_mode != .none and w.minute < j.expire_minute
        .race:
            loop m in meets:
                if m.id == l.subject: return m.open and m.day >= day_index(w.minute)
            false
        .overdue:
            if not (l.subject in w.stories): return false
            s = w.stories[l.subject]
            s.kind == .missing_boat and not s.resolved and s.actors.len() > 0
        .band:
            w.band.numbers.len() > 0 and l.day == day_index(w.minute) and local_minute(w.minute) < w.band.closes and local_minute(w.minute) >= 6*60 and lead_band_players(w) >= 2

# What `speaker` could tell of, from where they are: their own harbour's jobs and worries, other
# harbours' long-waiting loads, the clubs' meetings and the Ancora's band, which everyone hears of.
leads_for = (w: World, speaker: int, meets: MeetNote[]) -> Lead[]:
    out: Lead[]
    if speaker < 0 or speaker >= w.people.len() or speaker == w.player: return out
    here = _core_of(w,speaker)
    ids = w.active_jobs; ids.sort()
    loop id in ids:
        if not (id in w.jobs): continue
        j = w.jobs[id]
        if j.state != .open or j.poster == speaker: continue
        if j.passenger >= 0:
            if j.origin == here and j.passenger != speaker: out.push(Lead(kind=.ride,key="ride:{id}",subject=id,place=j.destination))
        else if j.cargo_mode != .none and w.minute-j.created_minute >= LEAD_CARGO_WAIT:
            out.push(Lead(kind=.cargo,key="cargo:{id}",subject=id,place=j.origin))
    sids = w.stories.keys(); sids.sort()
    loop id in sids:
        s = w.stories[id]
        if s.kind == .missing_boat and not s.resolved and s.actors.len() > 0 and s.actors[0] != speaker and (s.place == here or (s.actors.len() > 1 and s.actors[1] == speaker)):
            out.push(Lead(kind=.overdue,key="overdue:{id}",subject=id,place=s.place))
    loop m in meets:
        if m.open and m.day >= day_index(w.minute) and m.day <= day_index(w.minute)+3:
            out.push(Lead(kind=.race,key="race:{m.id}",subject=m.id,place=m.capital,day=m.day))
    if here >= 0 and w.band.numbers.len() > 0:
        out.push(Lead(kind=.band,key="band:{day_index(w.minute)}",place=0,day=day_index(w.minute)))
    [loop l in out: if lead_real(w,l,meets): l]

_day_words = (w: World, day: int) -> str:
    today = day_index(w.minute)
    if day == today: "today" else: if day == today+1: "tomorrow" else: "on {weekday_name(day*1440)}"

_pick = (lines: str[], seq: int) -> str: if lines.len() == 0: "" else: lines[((seq%lines.len())+lines.len())%lines.len()]

# How `speaker` says it: plainly, one thing, the rest left to the listener.
lead_line = (w: World, l: Lead, speaker: int, seq: int) -> str:
    here = _core_of(w,speaker)
    # (an errand of the islands: the mail, the papers, the nurse wanted; src/errand_words.jo)
    if l.kind == .ride or l.kind == .cargo:
        if let e = errand_of(w,l.subject): return errand_lead(w,e)
    match l.kind:
        .ride:
            j = w.jobs[l.subject]
            p = j.passenger
            home = j.destination == w.people[p].home
            lines = if j.poster == p and home: ["{_first(w,p)}'s been trying to get home.","{_first(w,p)}'s after a way home, if anyone's going."] else: ["Someone's after a lift to {_town(w,l.place)}.","Somebody wants taking over to {_town(w,l.place)}."]
            _pick(lines,seq)
        .cargo:
            owner = w.jobs[l.subject].poster
            lines = if l.place == here: ["{_first(w,owner)}'s had a load on the dock a while.","{_first(w,owner)}'s still got crates nobody's taken."] else: ["There's cargo been sitting at {_town(w,l.place)} a while.","They've a load waiting at {_town(w,l.place)}, I hear."]
            _pick(lines,seq)
        .race:
            name = if l.place in w.place_contexts: w.place_contexts[l.place].name else: "the capital"
            # (in the capital itself: here)
            home = speaker >= 0 and speaker < w.people.len() and (w.people[speaker].far_place == l.place or w.people[speaker].far_visit == l.place or (here >= 0 and w.places[here].id == l.place))
            lines = if home: ["They're racing here {_day_words(w,l.day)}.","There's a race here {_day_words(w,l.day)}."] else: ["They're racing at {name} {_day_words(w,l.day)}.","There's a race on at {name} {_day_words(w,l.day)}."]
            _pick(lines,seq)
        .overdue:
            s = w.stories[l.subject]
            m = s.actors[0]
            lines = if s.actors.len() > 1 and s.actors[1] == speaker: ["{_first(w,m)}'s boat should've been back by now.","Still no sign of {_first(w,m)}."] else: ["{_first(w,m)}'s boat's overdue.","No word of {_first(w,m)}'s boat yet."]
            _pick(lines,seq)
        .band:
            evening = local_minute(w.minute) >= BAND_GATHER
            lines = if here == 0: (if evening: ["Band's on.","They're playing at the Ancora."] else: ["Band's on tonight.","There's music at the Ancora tonight."]) else: ["There's music at the Ancora tonight.","The Ancora's got its band on tonight."]
            _pick(lines,seq)

# How near home a lead is for `speaker`: their own harbour's news first (a lift wanted, a boat
# overdue, a load on their dock), then the band and the races, then loads at other harbours.
_lead_rank = (w: World, l: Lead, speaker: int) -> int:
    match l.kind:
        .ride, .overdue: 0
        .cargo: if l.place == _core_of(w,speaker): 0 else: 2
        else: 1

# The lead `speaker` would mention now, not yet told by them (`told` keys "person:lead"), or none:
# the nearest to home first, turn about within that by the day, and one of each kind a day.
lead_to_tell = (w: World, speaker: int, meets: MeetNote[], told: {str: int}) -> Lead?:
    said_kinds: {LeadKind: bool}
    all = leads_for(w,speaker,meets)
    loop l in all:
        if "{speaker}:{l.key}" in told: said_kinds[l.kind] = true
    ls = [loop l in all: if not ("{speaker}:{l.key}" in told) and not (l.kind in said_kinds): l]
    if ls.len() == 0: return none
    best = 3
    loop l in ls: best = min(best,_lead_rank(w,l,speaker))
    near = [loop l in ls: if _lead_rank(w,l,speaker) == best: l]
    near[(speaker+day_index(w.minute))%near.len()]

# Told: kept in the World (saved), a day's worth; older ones let go.
lead_told_now = (w: mut World, speaker: int, l: Lead):
    day = day_index(w.minute)
    if w.rep.told_leads.len() > 0:
        stale = [loop k, d in w.rep.told_leads: if d < day: k]
        loop k in stale: w.rep.told_leads.remove(k)
    w.rep.told_leads["{speaker}:{l.key}"] = day

# ---------------- the crates themselves ----------------

# An open job's crates within `reach` of `at` at harbour `place` (core): the lot nearest, or -1.
lead_crate_near = (w: World, at: vec3, place: int, reach: f64 = 3.0) -> int:
    best = -1; near = reach
    ids = w.cargo.keys(); ids.sort()
    loop id in ids:
        c = w.cargo[id]
        if c.job < 0 or c.place != place or not (c.job in w.jobs) or w.jobs[c.job].state != .open: continue
        d = f64(length(vec2(c.pos.x-at.x,c.pos.z-at.z)))
        if d < near: near = d; best = id
    best

# What the label says: whose, and where bound ("Despina Ralli, Kalamos. For Porto Vecchio.").
lead_crate_label = (w: World, lot: int) -> str:
    j = w.jobs[w.cargo[lot].job]
    "Stencilled on the crates: {w.people[j.poster].name}, {_town(w,j.origin)}. For {_town(w,j.destination)}."

# What someone near says of them, asked: whose, and where to find them.
lead_crate_said = (w: World, lot: int) -> str:
    j = w.jobs[w.cargo[lot].job]
    spot = role_spot(w,j.poster)
    if spot != "": "{_first(w,j.poster)}'s. You'll find them {spot}." else: "{_first(w,j.poster)}'s. Ask about the town."
