# Playing on a touch screen, with as few things on the screen as can be:
#   aboard   as in Sky Barons: a finger dragged anywhere turns the view about the aircraft, and the
#            aircraft turns to fly where the view looks (on the water too: it steers there). The
#            aim stays where it was put when the finger lifts. The throttle is a slider along the
#            left edge; Fire, the guns' safety and jumping out are buttons by the right thumb.
#   on foot  as in Sky Barons: a finger dragged anywhere turns the view, and one Walk button walks
#            the way the view looks: hold it to walk, slide the thumb away from it to go faster,
#            up to a run. A tap on someone nearby talks to them; two fingers pinch the view nearer.
#   anywhere the prompt cards ("F  climb aboard...") are buttons: tap one to do it.
# Buttons hold virtual keys the game reads alongside the keyboard (vdown, vpressed), so flying,
# walking and the panels work the same by finger as by key.

struct PadButton:
    label: str
    key: Key
    at: vec2                        # its center, in screen units
    r: f64                          # its radius
    hold = true                     # held while the finger is on it (else: a tap)

struct TouchPad:
    on = false                      # a touch screen (or AEGEAN_TOUCH): the controls are drawn
    mode = 2                        # 0 in the air, 1 on the water, 2 on foot, 3 a panel open
    aim = vec2(0, 0)                # aboard: the drag this frame, in screen units
    orbit = vec2(0, 0)              # two fingers' drag this frame
    zoom = 1.0                      # two fingers' pinch this frame (above 1: spreading)
    walking = false                 # on foot: a thumb on the Walk button
    walk_speed = 0.0                # (how far it has slid from it: 0 a walk .. 1 a run)
    walk_id = -1
    tapped = false                  # on foot: a tap this frame, and where
    tap_at = vec2(0, 0)
    throttle_want = -1.0            # a finger on the throttle slider: 0..1 (else -1)
    throttle_now = 0.0              # (the throttle as it is, for drawing the slider)
    held: Key[]                     # virtual keys held this frame
    pressed: Key[]                  # and those pressed this frame
    buttons: PadButton[]
    cards: Rect[]                   # (the prompt cards drawn last frame, and their keys)
    card_keys: Key[]
    next_cards: Rect[]              # (and those being drawn this frame)
    next_card_keys: Key[]
    drag_id = -1                    # (the finger dragging the view or walking: where it landed and was)
    drag_at = vec2(0, 0)
    drag_last = vec2(0, 0)
    drag_t = 0.0                    # (how long it's been down)
    drag_far = 0.0                  # (how far it has wandered from where it landed)
    slider_id = -1                  # (the finger on the throttle)
    pinch = 0.0                     # (two fingers' spread the frame before)
    two = false                     # (two fingers down: that gesture owns them till both lift)
    claimed: int[]                  # (fingers on buttons and cards, so they don't also steer)
    claimed_key: Key[]

pad = TouchPad()

# the controls shown or not (a touch screen, or AEGEAN_TOUCH to try them with a mouse)
set_touch_pad = (on: bool):
    global pad
    pad.on = on

# a key held: on the keyboard or on the pad
vdown = (k: Key) -> bool: key_down(k) or pad.held.contains(k)

# a key pressed this frame: on the keyboard or on the pad
vpressed = (k: Key) -> bool: key_pressed(k) or pad.pressed.contains(k)

# a prompt card drawn this frame at r, for key k: a finger on it holds k
tap_card = (r: Rect, k: Key):
    global pad
    if not pad.on: return
    pad.next_cards.push(r)
    pad.next_card_keys.push(k)

_unit = () -> f64: min(f64(screen_width()), f64(screen_height()))

# (held upright, a phone gets narrower units so its type and buttons stay big enough; on its side,
# the usual 1280 x 720)
lay_out_screen = ():
    p = pixel_size()
    if p.y > p.x: design_size(600, max(1067, int(600.0 * f64(p.y) / f64(max(p.x, 1.0)))))
    else: design_size(1280, 720)

# the Walk button, by the right thumb
walk_button = () -> vec2:
    u = _unit()
    vec2(f32(f64(screen_width()) - u * 0.085 * 1.6), f32(f64(screen_height()) - u * 0.085 * 1.6))

# the throttle's slider, along the left edge
throttle_track = () -> Rect:
    u = _unit()
    sh = f64(screen_height())
    Rect(u * 0.05, sh - u * 0.75, u * 0.075, u * 0.5)

_layout = (mode: int, guns: bool) -> PadButton[]:
    u = _unit()
    sw = f64(screen_width())
    sh = f64(screen_height())
    big = u * 0.085
    small = u * 0.055
    bs: PadButton[]
    top = small * 1.3
    # (along the top left: the clock and the money are top right)
    bs.push(PadButton("II", .p, vec2(f32(small * 1.4), f32(top)), small, false))
    bs.push(PadButton("Map", .m, vec2(f32(small * 3.8), f32(top)), small, false))
    bs.push(PadButton("Log", .j, vec2(f32(small * 6.2), f32(top)), small, false))
    aboard = mode == 0 or mode == 1
    if aboard:
        bs.push(PadButton("View", .v, vec2(f32(small * 8.6), f32(top)), small, false))
        bs.push(PadButton("Radio", .f9, vec2(f32(small * 11.0), f32(top)), small, false))
    # (fullscreen: top right, under the clock and the money, clear of the compass)
    if can_fullscreen() and not is_fullscreen(): bs.push(PadButton("Full", .f11, vec2(f32(sw - small * 1.4), f32(top + small * 2.6)), small, false))
    rx = sw - big * 1.5
    ry = sh - big * 1.5
    match mode:
        0:
            if guns: bs.push(PadButton("Fire", .space, vec2(f32(rx), f32(ry)), big))
            bs.push(PadButton("Safe", .g, vec2(f32(rx), f32(ry - big * 2.1)), small, false))
            bs.push(PadButton("Jump", .t, vec2(f32(rx - big * 1.9), f32(ry - big * 2.1)), small, false))
        1: bs.push(PadButton("Brake", .space, vec2(f32(rx), f32(ry)), big))
        _: pass
    bs

# each frame, before the game reads its input. mode: 0 in the air, 1 on the water, 2 on foot, 3 a
# panel open; throttle: the aircraft's now (0..1), for the slider
update_pad = (mode: int, guns: bool, throttle: f64, dt: f64):
    global pad
    if not pad.on: return
    prev = pad.held
    pad.mode = mode
    pad.held = []
    pad.pressed = []
    pad.aim = vec2(0, 0)
    pad.orbit = vec2(0, 0)
    pad.zoom = 1.0
    pad.walking = false
    pad.tapped = false
    pad.throttle_want = -1.0
    pad.throttle_now = throttle
    pad.cards = pad.next_cards
    pad.card_keys = pad.next_card_keys
    pad.next_cards = []
    pad.next_card_keys = []
    pad.buttons = _layout(if mode == 3: 2 else: mode, guns)
    if mode == 3: pad.buttons = [loop b in pad.buttons: if b.key == .p or b.key == .m or b.key == .j or b.key == .f11: b]
    ts = touches()
    ids = touch_ids()
    u = _unit()
    # (a finger that lifted: a short touch that barely moved, on foot, is a tap)
    if pad.drag_id >= 0 and not ids.contains(pad.drag_id):
        if mode == 2 and not pad.two and pad.drag_t < 0.25 and pad.drag_far < u * 0.03:
            pad.tapped = true
            pad.tap_at = pad.drag_last
        pad.drag_id = -1
    if not ids.contains(pad.slider_id): pad.slider_id = -1
    if not ids.contains(pad.walk_id): pad.walk_id = -1
    keep: int[]
    keep_key: Key[]
    loop k in 0..pad.claimed.len():
        if ids.contains(pad.claimed[k]):
            keep.push(pad.claimed[k])
            keep_key.push(pad.claimed_key[k])
    pad.claimed = keep
    pad.claimed_key = keep_key
    track = throttle_track()
    grown = Rect(track.x - 20.0, track.y - 20.0, track.w + 40.0, track.h + 40.0)
    free: vec2[]                    # (fingers on nothing in particular: the view, walking)
    loop k in 0..ts.len():
        id = ids[k]
        p = ts[k]
        if id == pad.slider_id or id == pad.walk_id or pad.claimed.contains(id): continue
        if id == pad.drag_id:
            free.push(p)
            continue
        # a finger landing: on a button or a card, on the throttle, else the view / walking
        hit = -1
        loop b in 0..pad.buttons.len():
            if f64(length(p - pad.buttons[b].at)) < pad.buttons[b].r * 1.15: hit = b
        card = -1
        loop c in 0..pad.cards.len():
            if contains(pad.cards[c], p): card = c
        if hit >= 0:
            pad.claimed.push(id)
            pad.claimed_key.push(pad.buttons[hit].key)
            if not pad.buttons[hit].hold:
                pad.pressed.push(pad.buttons[hit].key)
                # (fullscreen must come from a tap: the browser asks it be done in answer to one)
                if pad.buttons[hit].key == .f11: set_fullscreen(true)
        else if card >= 0:
            pad.claimed.push(id)
            pad.claimed_key.push(pad.card_keys[card])
        else if mode == 2 and f64(length(p - walk_button())) < u * 0.085 * 1.25 and pad.walk_id < 0:
            pad.walk_id = id
        else if (mode == 0 or mode == 1) and contains(grown, p) and pad.slider_id < 0:
            pad.slider_id = id
        else if mode != 3:
            free.push(p)
            if pad.drag_id < 0:
                pad.drag_id = id
                pad.drag_at = p
                pad.drag_last = p
                pad.drag_t = 0.0
                pad.drag_far = 0.0
    if free.len() == 0: pad.two = false
    # two fingers free: they turn the view and pinch it nearer, and don't walk or steer
    if free.len() >= 2:
        pad.two = true
        mid = (free[0] + free[1]) * 0.5
        spread = f64(length(free[0] - free[1]))
        if pad.pinch > 0.0:
            pad.orbit = mid - pad.drag_last
            pad.zoom = spread / pad.pinch
        pad.pinch = spread
        pad.drag_last = mid
    else:
        pad.pinch = 0.0
        loop k in 0..ts.len():
            id = ids[k]
            p = ts[k]
            if id == pad.drag_id:
                pad.drag_t += dt
                pad.drag_far = max(pad.drag_far, f64(length(p - pad.drag_at)))
                if not pad.two:
                    pad.aim = p - pad.drag_last
                    if mode == 2: pad.orbit = p - pad.drag_last
                pad.drag_last = p
            else if id == pad.walk_id:
                pad.walking = true
                pad.walk_speed = clamp(f64(length(p - walk_button())) / (u * 0.16), 0.0, 1.0)
            else if id == pad.slider_id:
                pad.throttle_want = clamp(f64(track.y + track.h - p.y) / f64(track.h), 0.0, 1.0)
    loop k in 0..pad.claimed.len():
        key = pad.claimed_key[k]
        hold = true
        loop b in pad.buttons:
            if b.key == key: hold = b.hold
        if hold:
            pad.held.push(key)
            if not prev.contains(key): pad.pressed.push(key)

# the controls drawn over the game, faint so the world shows through
draw_pad = ():
    if not pad.on: return
    u = _unit()
    if pad.mode == 2:
        # (the Walk button; a thumb slid away from it shows how far, up to a run)
        at = walk_button()
        r = u * 0.085
        circle(at, r, if pad.walking: rgba(1, 0.97, 0.88, 0.42) else: rgba(0.06, 0.08, 0.12, 0.35))
        ring(at, r, 2.0, rgba(1, 0.97, 0.9, 0.55))
        if pad.walking: ring(at, r + u * 0.16 * pad.walk_speed, 1.5, rgba(1, 0.97, 0.9, 0.35))
        size = max(r * 0.45, 13.0)
        lbl = if pad.walk_speed > 0.6: "Run" else: "Walk"
        text(lbl, at - vec2(f32(text_width(lbl, size) * 0.5), f32(size * 0.55)), size, rgba(1, 0.97, 0.9, 0.9))
    if pad.mode == 0 or pad.mode == 1:
        r = throttle_track()
        rect(r, rgba(0.06, 0.08, 0.12, 0.35))
        rect(Rect(r.x, r.y, r.w, 2.0), rgba(1, 0.97, 0.9, 0.5))
        rect(Rect(r.x, r.y + r.h - 2.0, r.w, 2.0), rgba(1, 0.97, 0.9, 0.5))
        level = clamp(pad.throttle_now, 0.0, 1.0)
        hy = r.y + r.h - r.h * f32(level)
        rect(Rect(r.x - 6.0, hy - 7.0, r.w + 12.0, 14.0), if pad.slider_id >= 0: rgba(1, 0.97, 0.88, 0.75) else: rgba(1, 0.97, 0.9, 0.5))
        size = max(u * 0.03, 12.0)
        text("Throttle", vec2(r.x, r.y - f32(size * 1.4)), size, rgba(1, 0.97, 0.9, 0.7))
    loop b in pad.buttons:
        down = pad.held.contains(b.key) or pad.pressed.contains(b.key)
        circle(b.at, b.r, if down: rgba(1, 0.97, 0.88, 0.42) else: rgba(0.06, 0.08, 0.12, 0.35))
        ring(b.at, b.r, 2.0, rgba(1, 0.97, 0.9, 0.55))
        size = max(b.r * 0.55, 13.0)
        w = text_width(b.label, size)
        text(b.label, b.at - vec2(f32(w * 0.5), f32(size * 0.55)), size, rgba(1, 0.97, 0.9, 0.9))
