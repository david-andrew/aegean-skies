# Playing on a touch screen: a thumb stick on the left half (where the thumb lands), a drag on the
# right half to look about, and a few buttons by the right thumb and along the top. They don't
# drive the game themselves: they hold virtual keys and an analog stick that the game reads
# alongside the keyboard (vdown, vpressed, pad.stick), so flying, walking and the panels work
# the same by finger as by key.

struct PadButton:
    label: str
    key: Key
    at: vec2                        # its center, in screen units
    r: f64                          # its radius
    hold = true                     # held while the finger is on it (else: a tap)

struct TouchPad:
    on = false                      # a touch screen (or AEGEAN_TOUCH): the controls are drawn
    stick = vec2(0, 0)              # the left thumb: -1..1 each way (x right, y down)
    look = vec2(0, 0)               # the right thumb's drag this frame, in screen units
    held: Key[]                     # virtual keys held this frame
    pressed: Key[]                  # and those pressed this frame
    buttons: PadButton[]
    stick_id = -1                   # (the finger on the stick, where it landed)
    stick_at = vec2(0, 0)
    look_id = -1                    # (the finger dragging the view, where it was)
    look_last = vec2(0, 0)
    claimed: int[]                  # (fingers on buttons, so they don't also steer or look)
    claimed_key: Key[]

pad = TouchPad()

# the controls shown or not (a touch screen, or AEGEAN_TOUCH to try them with a mouse)
set_touch_pad = (on: bool):
    global pad
    pad.on = on

# a key held: on the keyboard or on the pad
vdown = (k: Key) -> bool: key_down(k) or pad.held.contains(k)

# a key pressed this frame: on the keyboard or on the pad
vpressed = (k: Key) -> bool: key_pressed(k) or pad.pressed.contains(k)

_unit = () -> f64: min(f64(screen_width()), f64(screen_height()))

# the buttons for what one is doing: flying, on the water, or on foot (and always the pause, the
# chart and the notebook along the top)
_layout = (mode: int, guns: bool, crashed: bool) -> PadButton[]:
    u = _unit()
    sw = f64(screen_width())
    sh = f64(screen_height())
    big = u * 0.085
    small = u * 0.055
    bs: PadButton[]
    top = small * 1.3
    # (along the top left: the clock and the money are top right)
    bs.push(PadButton("II", .p, vec2(f32(small * 1.4), f32(top)), small, false))
    bs.push(PadButton("Map", .m, vec2(f32(small * 3.8), f32(top)), small, false))
    bs.push(PadButton("Log", .j, vec2(f32(small * 6.2), f32(top)), small, false))
    if mode == 0 or mode == 1: bs.push(PadButton("View", .v, vec2(f32(small * 8.6), f32(top)), small, false))
    rx = sw - big * 1.5
    ry = sh - big * 1.5
    match mode:
        # (in the air)
        0:
            bs.push(PadButton("+", .shift, vec2(f32(rx), f32(ry - big * 2.4)), big * 0.8))
            bs.push(PadButton("-", .z, vec2(f32(rx), f32(ry - big * 0.6)), big * 0.8))
            if guns: bs.push(PadButton("Fire", .space, vec2(f32(rx - big * 2.3), f32(ry - big * 0.2)), big))
            bs.push(PadButton("F", .f, vec2(f32(rx - big * 2.3), f32(ry - big * 2.4)), small, false))
            # (the guns' safety, and jumping out under a parachute)
            bs.push(PadButton("Safe", .g, vec2(f32(rx), f32(ry - big * 4.0)), small, false))
            bs.push(PadButton("Jump", .t, vec2(f32(rx - big * 2.3), f32(ry - big * 4.0)), small, false))
        # (on the water)
        1:
            bs.push(PadButton("+", .shift, vec2(f32(rx), f32(ry - big * 2.4)), big * 0.8))
            bs.push(PadButton("-", .z, vec2(f32(rx), f32(ry - big * 0.6)), big * 0.8))
            bs.push(PadButton("Brake", .space, vec2(f32(rx - big * 2.3), f32(ry - big * 0.2)), big))
            bs.push(PadButton("F", .f, vec2(f32(rx - big * 2.3), f32(ry - big * 2.4)), big * 0.8, false))
        # (on foot)
        _:
            bs.push(PadButton("F", .f, vec2(f32(rx), f32(ry - big * 0.4)), big, false))
            bs.push(PadButton("Run", .shift, vec2(f32(rx - big * 2.3), f32(ry - big * 0.2)), big * 0.8))
            bs.push(PadButton("Talk", .t, vec2(f32(rx), f32(ry - big * 2.6)), big * 0.7, false))
    if crashed: bs.push(PadButton("R", .r, vec2(f32(sw * 0.5), f32(top * 2.4)), big, false))
    bs

# each frame, before the game reads its input: mode 0 flying, 1 on the water, 2 on foot, 3 a panel
# open (only the top buttons, no stick or look)
update_pad = (mode: int, guns: bool, crashed: bool):
    global pad
    if not pad.on: return
    prev = pad.held
    pad.held = []
    pad.pressed = []
    pad.stick = vec2(0, 0)
    pad.look = vec2(0, 0)
    pad.buttons = _layout(if mode == 3: 2 else: mode, guns, crashed)
    if mode == 3: pad.buttons = [loop b in pad.buttons: if b.key == .p or b.key == .m or b.key == .j: b]
    ts = touches()
    ids = touch_ids()
    sw = f64(screen_width())
    u = _unit()
    # (forget fingers that have lifted)
    if not ids.contains(pad.stick_id): pad.stick_id = -1
    if not ids.contains(pad.look_id): pad.look_id = -1
    keep: int[]
    keep_key: Key[]
    loop k in 0..pad.claimed.len():
        if ids.contains(pad.claimed[k]):
            keep.push(pad.claimed[k])
            keep_key.push(pad.claimed_key[k])
    pad.claimed = keep
    pad.claimed_key = keep_key
    loop k in 0..ts.len():
        id = ids[k]
        p = ts[k]
        if id == pad.stick_id or id == pad.look_id or pad.claimed.contains(id): continue
        # a finger landing: on a button, else the stick (left half) or the view (right half)
        hit = -1
        loop b in 0..pad.buttons.len():
            if f64(length(p - pad.buttons[b].at)) < pad.buttons[b].r * 1.15: hit = b
        if hit >= 0:
            pad.claimed.push(id)
            pad.claimed_key.push(pad.buttons[hit].key)
            if not pad.buttons[hit].hold: pad.pressed.push(pad.buttons[hit].key)
        else if mode != 3 and f64(p.x) < sw * 0.5 and pad.stick_id < 0:
            pad.stick_id = id
            pad.stick_at = p
        else if mode != 3 and pad.look_id < 0:
            pad.look_id = id
            pad.look_last = p
    loop k in 0..ts.len():
        id = ids[k]
        p = ts[k]
        if id == pad.stick_id:
            reach = u * 0.12
            d = (p - pad.stick_at) / f32(reach)
            if length(d) > 1.0: d = normalize(d)
            pad.stick = d
        else if id == pad.look_id:
            pad.look = p - pad.look_last
            pad.look_last = p
    loop k in 0..pad.claimed.len():
        key = pad.claimed_key[k]
        hold = true
        loop b in pad.buttons:
            if b.key == key: hold = b.hold
        if hold:
            pad.held.push(key)
            if not prev.contains(key): pad.pressed.push(key)

# the controls drawn over the game, faint so the world shows through
draw_pad = ():
    if not pad.on: return
    u = _unit()
    if pad.stick_id >= 0:
        reach = u * 0.12
        ring(pad.stick_at, reach, 2.0, rgba(1, 1, 1, 0.35))
        circle(pad.stick_at + pad.stick * f32(reach), u * 0.045, rgba(1, 1, 1, 0.35))
    else:
        # (where the thumb goes)
        at = vec2(f32(u * 0.24), f32(f64(screen_height()) - u * 0.52))   # (above the gauges)
        ring(at, u * 0.12, 2.0, rgba(1, 1, 1, 0.18))
    loop b in pad.buttons:
        down = pad.held.contains(b.key) or pad.pressed.contains(b.key)
        circle(b.at, b.r, if down: rgba(1, 0.97, 0.88, 0.42) else: rgba(0.06, 0.08, 0.12, 0.35))
        ring(b.at, b.r, 2.0, rgba(1, 0.97, 0.9, 0.55))
        size = max(b.r * 0.55, 13.0)
        w = text_width(b.label, size)
        text(b.label, b.at - vec2(f32(w * 0.5), f32(size * 0.55)), size, rgba(1, 0.97, 0.9, 0.9))
