# The Hotel Ancora's band as people (see src/band_roster.jo for who and where). Each world minute
# (after the daily life has moved everyone): a number is chosen when the last is over and the pause
# after it has passed (one asked for first, then the set where this evening has got to), its players
# are called to the stand, and it starts only when all of them have walked to the stand, stepped up
# and settled. Those it doesn't need put their instrument away and step down; after the last number
# of the evening they all do, and go about their evening. One who isn't coming tonight (at work,
# laid up, away, the weather) means their numbers are passed over; a number asked for waits for its
# players, and one who isn't here can be sent for (src/leisure.jo). Saved with the world; the same
# minutes give the same evening, near or far.

use 'living_types.jo'
use 'life_types.jo'
use 'living_life.jo'
use 'living_money.jo'
use 'band_roster.jo'
use 'living_conditions.jo'

# Set the band's programme (the scene's: the hotel's stand and the music), keeping its state.
band_publish = (w: mut World, numbers: BandNumber[], opens: int, closes: int, gap: int):
    w.band.numbers = numbers; w.band.opens = opens; w.band.closes = closes; w.band.gap = gap
    if w.band.index >= numbers.len(): w.band.index = -1; w.band.start = -1; w.band.called = []; w.band.roles = []; w.band.up = []

# Whether a player will be at the hotel for the music: in town and free, and either it is the
# evening or they have been sent for (an errand still under way counts).
band_coming = (w: World, person: int) -> bool:
    if person <= 0 or person >= w.people.len(): return false
    p = w.people[person]
    if p.place != BAND_PLACE or p.home != BAND_PLACE or not life_free(w,person): return false
    if w.places[p.place].harbor_closed or weather_severity(w,p.pose.pos) >= 350: return false
    band_evening(w) or person in w.band.fetched

# At the step for their place, ready to go up.
_band_at_step = (w: World, person: int) -> bool:
    if not (person in w.daily_life): return false
    i = w.daily_life[person]
    if not i.arrived: return false
    if let step = band_step_point(w,person): return f64(length(w.people[person].pose.pos-step)) < 0.6
    false

# The people a number needs, and those of them who won't be coming.
band_needed = (w: World, index: int) -> int[]:
    if index < 0 or index >= w.band.numbers.len(): return []
    [loop r in w.band.numbers[index].roles: BAND_ROSTER[r]]

band_missing = (w: World, index: int) -> int[]:
    [loop person in band_needed(w,index): if not band_coming(w,person): person]

# Why a player can't be sent for now ("" if they can).
band_fetch_refusal = (w: World, person: int) -> str:
    if band_role(person) < 0: return "They don't play here."
    p = w.people[person]
    first = split(p.name, " ")[0]
    if p.place != BAND_PLACE: return "{first} isn't in town."
    if p.injured_until > w.minute: return "{first} is laid up."
    clock = local_minute(w.minute)
    if clock < 360 or clock >= 1380: return "{first} will have gone to bed."
    # (at work means at work: their trade's hours, or a job in hand)
    if not life_free(w,person) or p.action.activity == .work: return "{first} can't come until the work is done."
    ""

# Send for a player: `payer` tips the house (its boy goes) through the ledger.
band_fetch = (w: mut World, person: int, payer_account: int, house_account: int, cents: int) -> bool:
    if band_fetch_refusal(w,person) != "": return false
    if person in w.band.fetched: return true
    if cents > 0 and not transfer(w,payer_account,house_account,cents,.trade): return false
    w.band.fetched.push(person); w.band.fetched_minute.push(w.minute)
    true

# Ask for a number: it is played next (after any asked before it), once its players are there.
band_ask = (w: mut World, index: int) -> bool:
    if index < 0 or index >= w.band.numbers.len(): return false
    w.band.queue.push(index)
    true

# The number to play next: the first asked for whose players are coming; else, in the evening, the
# set from where it has got to, passing over a number whose players aren't (all) coming tonight.
_band_next = (w: World) -> (int, bool):
    loop k in 0..w.band.queue.len():
        if band_missing(w,w.band.queue[k]).len() == 0: return (k, true)
    clock = local_minute(w.minute)
    if clock < w.band.opens or clock >= w.band.closes: return (-1, false)
    n = w.band.numbers.len()
    loop step in 0..n:
        k = (w.band.played + day_index(w.minute) + step) % n
        if band_missing(w,k).len() == 0: return (k + 1000000, false)
    (-1, false)

# Someone leaves the stand: they put the instrument away and step down from their place in
# `number` (if they had gone up).
_band_release = (w: mut World, k: int, number: int):
    b = w.band
    if b.up[k] >= 0 and w.tick >= b.up[k] and number >= 0:
        w.band.packing.push(b.called[k]); w.band.packing_role.push(b.roles[k])
        w.band.packing_number.push(number); w.band.packing_until.push(w.tick + BAND_PACK)
    w.band.called.remove_at(k); w.band.roles.remove_at(k); w.band.up.remove_at(k)

band_minute = (w: mut World):
    if w.band.numbers.len() == 0: return
    t = w.tick
    day = day_index(w.minute)
    if w.band.evening != day and local_minute(w.minute) >= 360:
        w.band.evening = day; w.band.played = 0
    # (those put away and down: back to their evening)
    k = 0
    loop k < w.band.packing.len():
        if t >= w.band.packing_until[k]:
            w.band.packing.remove_at(k); w.band.packing_role.remove_at(k); w.band.packing_number.remove_at(k); w.band.packing_until.remove_at(k)
        else: k += 1
    # (the errands of the evening before, and anyone sent for who now can't come)
    k = 0
    loop k < w.band.fetched.len():
        if w.minute - w.band.fetched_minute[k] > 600 or band_fetch_refusal(w,w.band.fetched[k]) != "":
            w.band.fetched.remove_at(k); w.band.fetched_minute.remove_at(k)
        else: k += 1
    # the number over: a pause before the next
    if w.band.index >= 0 and w.band.start >= 0 and t >= w.band.ends:
        if not w.band.request: w.band.played += 1
        w.band.last = w.band.index
        w.band.index = -1; w.band.start = -1; w.band.ends = -1; w.band.request = false
        w.band.rest_until = t + w.band.gap
    # waiting for its players: each goes up once at the step; it starts when all are up and settled
    if w.band.index >= 0 and w.band.start < 0:
        loop k in 0..w.band.called.len():
            if w.band.up[k] < 0 and not (w.band.called[k] in w.band.packing) and _band_at_step(w,w.band.called[k]): w.band.up[k] = t
        all_up = w.band.called.len() > 0
        last = 0
        loop k in 0..w.band.called.len():
            if w.band.up[k] < 0: all_up = false
            else: last = max(last, w.band.up[k])
        if all_up:
            w.band.start = max(t, last + BAND_CLIMB + BAND_SETTLE)
            w.band.ends = w.band.start + w.band.numbers[w.band.index].ticks
        else:
            # (one of them won't be coming after all: the number is passed over)
            gone = false
            loop person in w.band.called:
                if not band_coming(w,person): gone = true
            if gone:
                if w.band.request: w.band.request = false
                else: w.band.played += 1
                w.band.last = w.band.index
                w.band.index = -1; w.band.rest_until = t
    # the next number: its players called (those already in their place for it stay)
    if w.band.index < 0 and t >= w.band.rest_until:
        pick, asked = _band_next(w)
        if pick >= 0:
            index = if asked: w.band.queue[pick] else: pick - 1000000
            if asked: w.band.queue.remove_at(pick)
            previous = w.band.last
            w.band.index = index; w.band.request = asked; w.band.start = -1; w.band.ends = -1
            roles = w.band.numbers[index].roles
            # (who stays: the same person in the same place; the rest step down)
            k = 0
            loop k < w.band.called.len():
                r = w.band.roles[k]
                keep = r in roles and previous >= 0 and f64(length(w.band.numbers[previous].spots[r]-w.band.numbers[index].spots[r])) < 0.05
                if keep: k += 1
                else: _band_release(w,k,previous)
            loop r in roles:
                person = BAND_ROSTER[r]
                if not (person in w.band.called):
                    w.band.called.push(person); w.band.roles.push(r); w.band.up.push(-1)
            # (anyone still stepping down from this place waits: they go up once down)
            loop k in 0..w.band.called.len():
                if w.band.called[k] in w.band.packing: w.band.up[k] = -1
        else:
            # nothing to play: everyone on the stand comes down
            loop w.band.called.len() > 0: _band_release(w,0,w.band.last)
    _band_tidy(w)

# (no one both called and still stepping down: the called wait at the step until they are down)
_band_tidy = (w: mut World):
    k = 0
    loop k < w.band.called.len():
        person = w.band.called[k]
        if person in w.band.packing and w.band.up[k] >= 0:
            w.band.up[k] = -1
        k += 1
