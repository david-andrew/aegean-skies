use 'look.jo'
use 'geography.jo'
use 'render_space.jo'
use 'lake_data.jo'
use 'river_render.jo'
# Nearby meshes only. Optics, fine speed marks and logarithmic depth use the shared
# inland material; no separate lake shader or wave scale.
struct LakeBatch:
    id:int= -1
    mesh:Mesh=Mesh()
lake_batches:LakeBatch[]=[LakeBatch(),LakeBatch(),LakeBatch(),LakeBatch()]
build_lake_vertices=(lake:SettlementLake)->InlandWaterVertex[]:
    vs:InlandWaterVertex[]
    side=vec2(-lake.axis.y,lake.axis.x)
    loop y in 0..18:
        loop x in 0..48:
            corners:InlandWaterVertex[]
            loop offset in [vec2(0,0),vec2(1,0),vec2(0,1),vec2(1,1)]:
                uv=(vec2(f32(x),f32(y))+offset)/vec2(48,18)*2.0-vec2(1,1)
                p=lake.center+lake.axis*uv.x*f32(lake.half_length*1.12)+side*uv.y*f32(lake.half_width*1.12)
                vertex=inland_water_vertex(vec3(p.x,f32(lake.level),p.y))
                # Metres in one fixed lake chart preserve the sea's sub-metre glints
                # at 250 km coordinates. Translation changes neither scale nor density.
                vertex.chart=p-lake.center
                corners.push(vertex)
            vs.extend([corners[0],corners[2],corners[1],corners[1],corners[2],corners[3]])
    vs

draw_lakes=(depth:Texture,L:Light,t:f64,velocity:vec3=vec3(0,0,0)):
    global lake_batches
    if not geography_enabled:return
    cam=scene_camera()
    loop slot in 0..lake_batches.len():
        id=lake_batches[slot].id
        if id>=0 and length(SETTLEMENT_LAKES[id].center-cam.xz)>11000:lake_batches[slot].id= -1
    loop i in 0..SETTLEMENT_LAKES.len():
        lake=SETTLEMENT_LAKES[i]
        if length(lake.center-cam.xz)>9500:continue
        slot= -1
        loop k in 0..lake_batches.len():
            if lake_batches[k].id==i:slot=k;break
        if slot<0:
            loop k in 0..lake_batches.len():
                if lake_batches[k].id<0:slot=k;break
            if slot<0:continue
            vertices=build_lake_vertices(lake)
            if lake_batches[slot].mesh.vao==0:lake_batches[slot].mesh=mesh(vertices)
            else:update_mesh(lake_batches[slot].mesh,vertices)
            lake_batches[slot].id=i
        draw_inland_water(lake_batches[slot].mesh,vec3(lake.center.x,f32(lake.level),lake.center.y),depth,L,t,velocity)
