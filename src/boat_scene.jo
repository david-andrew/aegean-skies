use 'depth_space.jo'
use 'world_point.jo'
# Read-only meshes and wakes for the existing saved working/public boat trips.
import 'living_boats.jo' as boats
import 'living_types.jo' as bt
use 'objects.jo'
use 'wake.jo'
use 'sea.jo'
use 'look.jo'
use 'render_space.jo'
struct BoatView:
    trip: int
    point=WorldPoint()
    pos: vec3
    yaw: f64 = 0.0
    last: f64
    active: bool = true
    wake: WakeTrail = WakeTrail()
boat_views: BoatView[]
working_boat_mesh: Mesh
init_boat_scene = ():
    global working_boat_mesh
    vs: Vertex3D[]
    add_boat(vs,mat4(),63,false,0.0)
    working_boat_mesh = custom_mesh(vs)
update_boat_scene = (w: bt.World,t: f64,observer: vec3):
    global boat_views
    loop mut b in boat_views: b.active = false
    loop marker in boats.query_boats(w):
        if w.trips[marker.trip].state == .failed or w.trips[marker.trip].state == .preparing: continue
        if length(marker.pose.pos-observer) > 4000.0: continue
        index = -1
        loop k in 0..boat_views.len():
            if boat_views[k].trip == marker.trip: index = k; break
        if index < 0:
            if boat_views.len() >= 24: continue
            boat_views.push(BoatView(trip=marker.trip,pos=marker.pose.pos,point=bt.pose_point(marker.pose),last=t))
            index = boat_views.len()-1
        b = boat_views[index]
        delta = world_delta(bt.pose_point(marker.pose),b.point)
        dt = t-b.last
        velocity = if dt > 0.001 and length(delta) < 50.0: delta/f32(dt) else: vec3(0,0,0)
        if length(velocity.xz) > 0.1: b.yaw = atan2(f64(velocity.x),f64(velocity.z))+PI
        b.point=bt.pose_point(marker.pose);b.point.y=0
        b.pos=world_vec(b.point)
        b.active = true; b.last = t
        wake_step(b.wake,b.point,velocity,true,2.1,t)
        boat_views[index] = b
    kept: BoatView[]
    loop b in boat_views:
        if b.active or t-b.last < WAKE_LIFE: kept.push(b)
    boat_views = kept
draw_workboats = (L: Light,t: f64):
    loop b in boat_views:
        if not b.active: continue
        at=afloat_transform(translation(b.pos)*rotation_y(b.yaw),t)
        point=world_offset(b.point,at[3].xyz-b.pos);at[3]=vec4(0,0,0,1)
        draw_world(obj_sh,working_boat_mesh,obj_params(L,t,at,anchor=point))
draw_boat_wakes = (L: Light,t: f64):
    draw_wakes([loop b in boat_views: b.wake],L,t)
