# The fuel pier's panel: the tank, the pier's stock and price, and three ways to take on fuel (fill
# up, add 10 or 20 litres), each with its cost or the reason it can't be had. Draws from plain
# figures and says what was chosen; the game makes the sale through the living world's ledger
# (living_refuel.buy_tank_fuel) and then runs the gauge up while the pump works.

use 'hud.jo'
use 'panels.jo'

_fc_over = (r: Rect) -> bool: contains(r, mouse_pos())
_fc_click = (r: Rect) -> bool: mouse_pressed(.left) and contains(r, mouse_pos())

struct FuelOption:
    label: str                      # "Fill up", "Add 10 litres"
    ml = 0                          # what it would put in the tank (0: can't be had)
    cents = 0
    reason = ""                     # why not, or a note (the pier is short)

struct FuelCounterResult:
    choice = -1                     # the option taken
    refused = -1                    # an option that can't be had, tapped: show its reason
    closed = false

# "0.80"
fuel_litre_price = (can_cents: int) -> str: "{f64(can_cents) / 1000.0:.2}"

fuel_lire_text = (cents: int) -> str:
    if cents % 100 == 0: "{cents / 100} lire" else: "{f64(cents) / 100.0:.2} lire"

fuel_litres_text = (ml: int) -> str:
    if ml % 1000 == 0: "{ml / 1000} litres" else: "{f64(ml) / 1000.0:.1} litres"

# The refuelling moment: the tank's reading `age` seconds into a fill from `from_l` to `to_l`
# lasting `duration` seconds. It eases in as the pump takes, then runs steadily.
refuel_gauge = (from_l: f64, to_l: f64, age: f64, duration: f64) -> f64:
    if duration <= 0.0 or age >= duration: return to_l
    if age <= 0.0: return from_l
    u = age / duration
    k = if u < 0.15: u * u / 0.3 else: (u - 0.075) / 0.925
    from_l + (to_l - from_l) * clamp(k, 0.0, 1.0)

# How long the pump runs for `litres`: a beat for a can, about three seconds for a full tank.
refuel_seconds = (litres: f64) -> f64: clamp(0.9 + litres / 30.0, 1.0, 3.2)

# `tank_l` is the reading to show (it rises while `pumping`); `dues` says the costs include a home
# port's harbour dues; `notice` is a line over the footer (what was just bought, or why not).
fuel_counter = (fonts: Fonts, place: str, can_cents: int, tank_l: f64, capacity_l: f64, stock_ml: int, cash: int, options: FuelOption[], pumping: bool, notice: str = "", dues: bool = false) -> FuelCounterResult:
    res = FuelCounterResult()
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(560.0, sw - 32.0)
    row_h = 54.0
    # (one reason that holds for every option, such as an empty pier, is said once, below them)
    shared = options.len() > 0
    loop o in options:
        if o.ml > 0 or o.reason == "" or o.reason != options[0].reason: shared = false
    shown_notice = if notice == "" and shared and not pumping: options[0].reason else: notice
    h = 214.0 + f64(options.len()) * row_h + 86.0
    x = (sw - w) * 0.5
    y = max(12.0, (sh - h) * 0.5)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.4))
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)
    set_font(fonts.title)
    text(fit_text("Fuel pier", w - 100, 26), vec2(f32(x + 30), f32(y + 22)), 26, INK)
    set_font(fonts.ui)
    text(fit_text("{place}, {fuel_litre_price(can_cents)} lire a litre{if dues: ", and 2% harbour dues" else: ""}", w - 80, 16), vec2(f32(x + 30), f32(y + 58)), 16, LIGHT_INK)
    close = Rect(x + w - 44, y + 14, 30, 30)
    text_centered("×", vec2(f32(close.x + 15), f32(close.y + 13)), 30, if _fc_over(close): INK else: LIGHT_INK)
    if not pumping and (_fc_click(close) or key_pressed(.escape)): res.closed = true
    hy = y + 90.0
    line(vec2(f32(x + 24), f32(hy)), vec2(f32(x + w - 24), f32(hy)), 1.5, PAPER_DARK)
    # the tank, as a gauge across the panel
    text("In the tank", vec2(f32(x + 30), f32(hy + 16)), 18, INK)
    reading = "{int(tank_l + 0.5)} of {int(capacity_l + 0.5)} litres"
    text(reading, vec2(f32(x + w - 30 - text_width(reading, 18)), f32(hy + 16)), 18, INK)
    gx = x + 30.0; gw = w - 60.0; gy = hy + 46.0
    rect_rounded(gx - 2, gy - 2, gw + 4, 18, 4, PAPER_DARK)
    rect(gx, gy, gw, 14, rgba(0.18, 0.16, 0.13, 1))
    frac = clamp(tank_l / max(capacity_l, 0.001), 0.0, 1.0)
    rect(gx + 1, gy + 1, (gw - 2) * frac, 12, if frac < 0.15: rgba(0.78, 0.26, 0.2, 1) else: rgba(0.45, 0.62, 0.36, 1))
    loop k in 1..4: rect(gx + gw * f64(k) / 4.0, gy, 1, 14, rgba(0.95, 0.91, 0.8, 0.35))
    text("At the pier", vec2(f32(x + 30), f32(hy + 76)), 18, INK)
    stock = if stock_ml <= 0: "none" else: fuel_litres_text(stock_ml / 1000 * 1000)
    text(stock, vec2(f32(x + w - 30 - text_width(stock, 18)), f32(hy + 76)), 18, if stock_ml <= 0: STAMP else: INK)
    oy = hy + 112.0
    line(vec2(f32(x + 24), f32(oy)), vec2(f32(x + w - 24), f32(oy)), 1.5, PAPER_DARK)
    bw = 120.0
    loop k in 0..options.len():
        o = options[k]
        ry = oy + 12.0 + f64(k) * row_h
        can = o.ml > 0 and not pumping
        text(o.label, vec2(f32(x + 30), f32(ry)), 19, INK)
        sub = if o.ml > 0: "{fuel_litres_text(o.ml)}, {fuel_lire_text(o.cents)}" else: if shared: "" else: o.reason
        if o.ml > 0 and o.reason != "": sub = "{sub}; {o.reason.lower()}"
        if pumping: sub = ""
        text(fit_text(sub, w - bw - 80, 15), vec2(f32(x + 30), f32(ry + 22)), 15, if o.ml > 0: LIGHT_INK else: STAMP)
        b = Rect(x + w - 30 - bw, ry + 2, bw, 34)
        rect_rounded(b.x, b.y, b.w, b.h, 5, if can: (if _fc_over(b): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1)) else: rgba(0.7, 0.68, 0.6, 1))
        text_centered(if pumping: "pumping" else: "take on", vec2(f32(b.x + b.w * 0.5), f32(b.y + 17)), 16, rgba(1, 0.97, 0.9, 1))
        if _fc_click(b) and not pumping:
            if can: res.choice = k else: res.refused = k
    fy = y + h - 44.0
    if shown_notice != "": text(fit_text(shown_notice, w - 60, 16), vec2(f32(x + 30), f32(fy - 38)), 16, STAMP)
    line(vec2(f32(x + 24), f32(fy - 10)), vec2(f32(x + w - 24), f32(fy - 10)), 1.5, PAPER_DARK)
    text(fuel_lire_text(cash), vec2(f32(x + 30), f32(fy)), 20, INK)
    if pumping:
        n = "pumping..."
        text(n, vec2(f32(x + w - 30 - text_width(n, 16)), f32(fy + 2)), 16, LIGHT_INK)
    set_font()
    res
