use 'world_point.jo'
# Named people are members removed from a real cohort, with one World.people identity/purse.
# Rendering leases do not create, destroy, return or rename a person.
use 'living_types.jo'
use 'living_far_types.jo'
use 'life_types.jo'
use 'living_far_stock.jo'
use 'living_money.jo'
use 'living_guard.jo'
use 'living_transaction.jo'
use 'living_place_context.jo'
use 'living_far_news.jo'
use 'living_calendar.jo'
use 'living_domestic.jo'
use 'living_conditions.jo'

const FAR_MAX_NAMED = 3072
const FAR_MAX_NEAR = 24

_far_name = (w: World, place: int, ordinal: int, country: int) -> str:
    first = [["Ione","Stavros","Daphne","Nestor","Leda","Marcos","Zoe","Andreas","Aliki","Sotiris","Kleio","Dion","Marina","Theo","Rena","Vassos"],
        ["Daria","Milan","Vera","Anton","Lina","Pavel","Nadia","Ivo","Mira","Stefan","Petra","Luka","Anja","Boris","Sonia","Viktor"],
        ["Selma","Arif","Leyla","Orhan","Ayla","Deniz","Meryem","Kemal","Asli","Cem","Eda","Hasan","Esma","Selim","Mina","Tarik"]]
    last = [["Vlastos","Dellis","Markou","Pappas","Kouris","Leontis","Sarris","Vellis","Drakos","Rallis","Zervos","Petras","Laskaris","Maris","Kallis","Galanis"],
        ["Velen","Daric","Kovek","Marin","Borin","Petric","Salek","Novar","Radek","Belan","Marek","Lorin","Varic","Sorik","Terek","Rovan"],
        ["Aydin","Demir","Kaya","Yilmaz","Acar","Eren","Sahin","Kilic","Yaman","Gunes","Bulut","Dogan","Aksoy","Akin","Celik","Sari"]]
    n = draw1000000(w.seed,130,place,0,ordinal)
    "{first[country][n%16]} {last[country][n/16%16]}"

_far_promote = (w: mut World, place: int, role: FarRole) -> int:
    if not w.far.populated or not (place in w.far.districts) or w.far.people.len()>=FAR_MAX_NAMED: return -1
    d = w.far.districts[place]
    pilots=0
    loop id in d.named:
        if w.far.people[id].role==.pilot: pilots+=1
    if role==.pilot:
        if pilots>=d.pilot_slots: return -1
    else if d.named.len()-pilots>=3: return -1
    if role==.trader and d.market_owner>=0: return d.market_owner
    citizen = d.born_country
    if d.workers[citizen]<=0:
        citizen = -1
        loop c in 0..3:
            if citizen<0 and d.workers[c]>0: citizen=c
    if citizen<0: return -1
    population = 0
    loop c in 0..3: population += d.workers[c]+d.dependents[c]
    cash = w.accounts[d.household_account].cents/max(1,population)
    id = w.people.len(); account = new_account(w,"resident:{place}:{d.named.len()}")
    if cash>0 and not transfer(w,d.household_account,account,cash,.wage,id):
        living_fault("far.promote_purse",guard_context(w)+" place={place}"); return -1
    at = w.place_contexts[place].center
    loop v in w.place_contexts[place].venues:
        if v.kind==(if role==.trader: VenueKind.market else: VenueKind.home): at=v.pos; break
    occupation = match role:
        .trader, .keeper: Occupation.merchant
        .fisher, .sailor: .fisher
        .artisan: .mechanic
        .clerk: .clerk
        .pilot: .courier
        .farmer: .farmer
    home_pos=w.place_contexts[place].center; home_key="registry:{place}:home"
    loop v in w.place_contexts[place].venues:
        if v.kind==.home: home_pos=v.pos; home_key=v.key; break
    if d.homes.len()>0:
        home=d.homes[d.named.len()%d.homes.len()]; home_pos=home.door; home_key=home.key
        if role!=.trader: at=home_pos
    # Promotion must not create multiple residents at the shared fallback.
    ordinal=d.named.len()
    if ordinal>0:
        angle=f64(ordinal)*2.399963229728653
        at+=vec3(f32(cos(angle)*1.25*sqrt(f64(ordinal))),0,f32(sin(angle)*1.25*sqrt(f64(ordinal))))
    w.people.push(Person(id,_far_name(w,place,d.named.len(),citizen),22+draw1000000(w.seed,131,place,0,d.named.len())%46,-1,occupation,id*7919+17,account=account,far_home=place,far_place=place,citizenship=citizen,place=-1,pose=Pose(pos=at),action=Action(purpose=.trade)))
    w.far.people[id] = FarPerson(id=id,role=role,home_key=home_key,home_pos=home_pos,target=at,last_tick=w.tick,news=d.recent_news)
    if role==.trader:
        w.far.people[id].seen_prices=d.prices; w.far.people[id].prices_minute=w.minute
        far_hear_counter(w,id,place)
    w.far.districts[place].workers[citizen] -= 1
    w.far.districts[place].named.push(id)
    if role==.trader: w.far.districts[place].market_owner=id
    id

promote_far_person = (w: mut World, place: int, role: FarRole) -> int:
    if guard_blocked(): return -1
    scope = guard_begin(w)
    result = _far_promote(w,place,role)
    failed = guard_failed(scope); guard_finish(w,scope)
    if failed: -1 else: result

far_person_venue = (w: World, person: int) -> LifeVenue:
    p = w.people[person]; a = w.far.people[person]; place = p.far_place
    if a.commission>=0 and a.commission in w.far.commissions:
        c=w.far.commissions[a.commission]
        kind=if c.phase==.carrying or c.phase==.aboard: VenueKind.quay else: VenueKind.market
        return LifeVenue(place,"commission:{c.id}:{c.phase}",kind,a.target)
    clock = local_minute(w.minute)
    if p.injured_until>w.minute:
        return LifeVenue(place,"recover:{person}:{p.injured_until}",.shelter,p.pose.pos,covered=true)
    # Home tasks occupy the hours outside paid work. A commission keeps priority.
    domestic: VenueKind? = none
    if place==p.far_home and weather_severity(w,p.pose.pos)<350 and not capital_feast_active(w,place,w.minute):
        if clock>=330 and clock<360 and (person+day_index(w.minute))%3==0: domestic=VenueKind.laundry
        else if clock>=1080 and clock<1110 and (person+day_index(w.minute))%3==1: domestic=VenueKind.oven
        else if clock>=1110 and clock<1170: domestic=VenueKind.seat
    if domestic!=none:
        available: LifeVenue[]
        loop v in w.place_contexts[place].venues:
            if v.kind!=domestic!: continue
            occupied=false
            loop other in w.far.districts[place].named:
                if other<person and w.people[other].far_place==place and w.far.people[other].commission<0 and not person_vehicle_bound(w,other) and w.far.people[other].anchor==v.key: occupied=true; break
            if not occupied: available.push(v)
        if let fixture=nearest_domestic(available,place,domestic!,a.home_pos): return fixture
    kind = if clock<360 or clock>=1320: VenueKind.home else: if day_index(w.minute)%7==6 and clock>=540 and clock<660: VenueKind.church else: if clock>=1080: VenueKind.square else: if clock>=720 and clock<780: VenueKind.cafe else: if a.role==.farmer: VenueKind.fields else: if a.role==.fisher: VenueKind.quay else: if a.role==.artisan: VenueKind.workshop else: VenueKind.market
    if capital_feast_active(w,place,w.minute): kind=.square
    if kind==.home and place!=p.far_home: kind=.shelter
    if kind==.home: return LifeVenue(place,a.home_key,.home,a.home_pos,covered=true)
    matches = [loop v in w.place_contexts[place].venues: if v.kind==kind: v]
    if matches.len()==0: matches = [loop v in w.place_contexts[place].venues: if v.kind==.square: v]
    if matches.len()==0: return LifeVenue(place,"registry:{place}:center",kind,w.place_contexts[place].center)
    matches.sort((v: LifeVenue): v.key)
    venue=matches[person%matches.len()]
    # Reserve a stable slot by district identity, not by arrival order. Sparse
    # person IDs and repeated visits therefore cannot collapse onto slot zero.
    slot=0
    loop other in w.far.people.keys():
        if other<person and w.people[other].far_place==place: slot+=1
    angle=f64(slot)*2.399963229728653
    radius=if slot==0: 0.0 else: 1.25*sqrt(f64(slot))
    venue.pos+=vec3(f32(cos(angle)*radius),0,f32(sin(angle)*radius))
    venue

far_walk_abstract = (w: mut World, person: int, tick: int):
    if person<0 or person>=w.people.len() or not (person in w.far.people):
        living_fault("far.walk_identity",guard_context(w)+" person={person}"); return
    a = w.far.people[person]
    if person_vehicle_bound(w,person):
        w.far.people[person].last_tick=max(a.last_tick,tick)
        return
    if a.scene_owned: return
    if a.waypoint<0 or a.waypoint>a.route.len() or a.route.len()>512 or not finite_living_point(a.target):
        living_fault("far.walk_route",guard_context(w)+" person={person} waypoint={a.waypoint}"); return
    elapsed = max(0,tick-a.last_tick); w.far.people[person].last_tick=tick
    if a.blocked!="": return
    budget=f64(elapsed)/60.0*1.2
    path=if a.route.len()>0: a.route else: [a.target]
    waypoint=if a.route.len()>0: a.waypoint else: 0
    loop budget>0 and waypoint<path.len():
        point=pose_point(w.people[person].pose)
        delta=world_delta(world_point(path[waypoint]),point); distance=f64(length(delta))
        used=min(budget,distance)
        if distance>0.001:
            place_pose(w.people[person].pose,world_offset(point,delta*f32(used/distance)))
            w.people[person].pose.rot=facing(delta)
        budget -= used
        if distance<=used+0.001: waypoint += 1
        else: break
    if a.route.len()>0: w.far.people[person].waypoint=waypoint

far_person_daily = (w: mut World, person: int):
    if person_vehicle_bound(w,person): return
    p = w.people[person]; a = w.far.people[person]; d = w.far.districts[p.far_place]
    clock = local_minute(w.minute)
    if p.injured_until<=w.minute and (clock>=360 and clock<720 or clock>=780 and clock<1080):
        if length(p.pose.pos-a.target)<3.0: w.far.people[person].worked_minutes += 1
    if w.far.people[person].worked_minutes>=60 and w.accounts[d.market_account].cents>=30:
        if transfer(w,d.market_account,p.account,30,.wage,person): w.far.people[person].worked_minutes -= 60
    if a.last_meal_day==day_index(w.minute): return
    qty = min(28,far_market_qty(w,p.far_place,3)); cents = (qty*d.prices[3]+999)/1000
    if qty>0 and w.accounts[p.account].cents>=cents:
        if cents>0: transfer(w,p.account,d.market_account,cents,.trade,person)
        batch = far_take_market(w,p.far_place,3,qty); far_use(w,batch)
    else: qty=0
    w.far.people[person].hungry_days=if qty<28: a.hungry_days+1 else: 0
    w.far.people[person].last_meal_day=day_index(w.minute)

far_people_minute = (w: mut World):
    if not w.far.populated: return
    ids = w.far.people.keys(); ids.sort()
    loop id in ids:
        if w.people[id].state==.injured and w.people[id].injured_until<=w.minute: w.people[id].state=.idle
        if person_vehicle_bound(w,id) or w.people[id].state==.departed:
            w.far.people[id].last_tick=w.tick
            continue
        if w.people[id].action.purpose==.repair and w.people[id].action.end_minute>=w.minute:continue
        far_walk_abstract(w,id,w.tick)
        a = w.far.people[id]
        if a.commission>=0 or a.vehicle>=0: continue
        clock=local_minute(w.minute)
        domestic_boundary=clock==330 or clock==360 or clock==1080 or clock==1110 or clock==1170
        if a.last_hour!=w.minute/60 or domestic_boundary:
            venue = far_person_venue(w,id)
            if a.anchor!=venue.key or a.target!=venue.pos:
                w.far.people[id].planned_anchor=""; w.far.people[id].route=[]
                w.far.people[id].waypoint=0; w.far.people[id].blocked=""
            w.far.people[id].target=venue.pos; w.far.people[id].anchor=venue.key
            w.far.people[id].last_hour=w.minute/60
        loop v in w.place_contexts[w.people[id].far_place].venues:
            if v.kind==.market and length(w.people[id].pose.pos-v.pos)<15.0:
                w.far.people[id].seen_prices=w.far.districts[v.place].prices
                w.far.people[id].prices_minute=w.minute
                far_hear_counter(w,id,v.place); break
        far_person_daily(w,id)
        if guard_blocked(): return

far_resident_views = (w: World) -> FarResidentView[]:
    result: FarResidentView[]
    loop id in w.far.near_people:
        p=w.people[id]; a=w.far.people[id]; d=w.far.districts[p.far_place]
        v=far_person_venue(w,id)
        label=match v.kind:
            .home: "Going home to rest"
            .square, .cafe: "Going out for company"
            .church: "Going to the church"
            .seat: "Resting outside home"
            .laundry: "Putting out the washing"
            .oven: "Tending the courtyard oven"
            _: "Going to work"
        reason=if a.commission>=0 and a.commission in w.far.commissions: "Carrying {if w.far.commissions[a.commission].good>=0: "{f64(w.far.commissions[a.commission].quantity)/1000.0:.1} packages of {w.goods[w.far.commissions[a.commission].good].key}" else: "a sealed dispatch"} for {w.people[w.far.commissions[a.commission].carrier].name}." else: "{label} in {life_place_name(w,p.far_place)}."
        result.push(FarResidentView(id,p.name,p.far_home,p.far_place,p.citizenship,d.controller,d.authority,p.pose.pos,a.target,a.role,reason))
    result
