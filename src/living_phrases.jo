# Original dialogue banks. These contain manner and observation, not unverified world facts.
# Fact-specific composition belongs to living_conversation; inspecting a bank consumes no RNG.
use 'life_types.jo'

greeting_lines = (voice: VoiceKind, known: bool, name: str, greeting: str) -> str[]:
    if known:
        return match voice:
            .salt: ["{greeting}, {name}.", "You again. Good.", "There's room beside me.", "Well? How did you get on?", "Come round this side. I can hear you here.", "Sit, if you're stopping.", "I thought that was your step.", "You've found me.", "What have you brought us?", "Still in one piece, I see.", "Speak up, {name}.", "I haven't gone anywhere.", "Back already?", "Come on, then. Out with it.", "A word before you go?", "You can spare a moment, surely."]
            .shop: ["Ah, {name}. Come closer.", "Have you come to buy or to tell me something?", "There's my traveller.", "Let me put this down. Now, what is it?", "You remembered where to find me.", "You've caught me between things.", "Show me your face before you ask a favour.", "I was wondering when I'd see you.", "Don't stand in the doorway, {name}.", "What sort of day have you had?", "You look as though you've something to say.", "If it's business, I'm listening.", "And what have you heard?", "A familiar face. That's something.", "Yes, yes, I've a minute for you.", "Good to see you on your feet, {name}."]
            .formal: ["{greeting}. You have a moment?", "Ah, {name}. Shall we speak?", "One matter at a time, if you please.", "You've come back. Very well.", "I remember you, of course.", "We can dispense with introductions.", "What may I do for you today?", "There you are. Now then.", "I trust your business went well.", "You know where I am to be found.", "A brief word, {name}?", "Please, come within earshot.", "Yes, I have not forgotten our conversation.", "Let us hear what you have to say.", "We meet again, {name}.", "Before you hurry off, a word."]
            .anxious: ["{name}! You're back.", "Oh, good. Someone I know.", "Have you a minute? Only a minute.", "I thought you might have gone already.", "Tell me you've had a better day.", "Sorry, I was somewhere else. What is it?", "You caught me thinking.", "I saw you, then wasn't sure it was you.", "Can we talk here?", "I've been meaning to ask you something.", "Don't mind me. Go on.", "It's good to see you back on the quay.", "You haven't come with bad news, have you?", "I nearly walked straight past you.", "Yes? I'm listening. Truly.", "Stay a little, {name}."]
            .warm: ["Come here, {name}. Let me look at you.", "There you are. Have you eaten?", "I can make room for an old acquaintance.", "Tell me one good thing before the rest.", "Ah, a face I like seeing.", "Come out of everyone's way and talk to me.", "Have you been keeping well?", "I've a moment, if it's for you.", "You needn't wait to be invited.", "Well, look who's come back.", "Your day can't be all hurry, {name}.", "Is there something on your mind?", "Don't leave without saying hello.", "You're welcome to stop a while.", "Put your troubles down for a minute.", "I wondered who was lingering there."]
            .measured: ["{greeting}, {name}. How are things?", "I'm glad you stopped.", "Shall we talk a moment?", "I remember where we left off.", "You have my attention.", "Have you something new to tell me?", "Let's find a quiet minute.", "Yes, I know your face now.", "We needn't hurry every word.", "How did the rest of your day turn out?", "Good. You're still here.", "Come alongside, {name}.", "I'm listening, if you want to say it.", "It's pleasant to be interrupted by a friend.", "What brings you back this way?", "Let's hear it from you."]
            .wry: ["Ah, {name}. Neither of us has escaped.", "You've found the right unfortunate.", "What can I do for you, within reason?", "Come and improve my conversation.", "A familiar nuisance. How are you?", "If you've come to borrow, start with a joke.", "I was about to pretend to be busy.", "Back with your pockets or your stories full?", "You always find me standing about.", "Tell me you haven't brought a form to sign.", "Well, what are we worrying about today?", "Good. Now there's someone else to blame the day on.", "I've been saving this bit of shade for you.", "What did you break this time? I'm teasing.", "You can't spend the whole day being sensible.", "There you are. We might as well talk."]
            .guarded: ["I know you. What is it?", "Come no closer than you need to.", "Speak, {name}.", "You know where you're standing.", "We have spoken before.", "What do you want to know this time?", "I can hear you from there.", "I'll listen. That isn't a promise.", "Don't make me regret stopping.", "You've a question, I suppose.", "Keep your voice down.", "Yes. You have my attention.", "There are worse people to see coming.", "You came back. I noticed.", "Say what you came to say.", "We've time for a few words."]
    match voice:
        .salt: ["{greeting}. What do they call you?", "Are you after someone?", "If you want the water, it's behind you.", "You've a question. I can see it.", "Speak plainly. I'm not the harbour office.", "I've a name, if you're going to ask a favour.", "Don't stand there wondering. Ask.", "{greeting}. Mind that rope.", "You're stopping, then?", "Who are you looking for?", "There's room to pass, if that's all.", "A word? Go on.", "Come where I can hear you.", "First time you've spoken to me, I think.", "You need something?", "{greeting}. I'm listening."]
        .shop: ["{greeting}. What can I find for you?", "A new customer, or just a visitor?", "Come closer. I don't charge for a word.", "You have the look of someone with a question.", "Who sent you to me?", "We haven't been introduced, have we?", "If you've business, let's hear it.", "I have a minute before the next thing.", "{greeting}. Are you staying here?", "You needn't hover. Come and ask.", "What name shall I put to that face?", "Are you from one of the aircraft?", "Take care by those boxes.", "Have you been told where to find me?", "What brings you to this end of the quay?", "{greeting}. Let me set this aside."]
        .formal: ["{greeting}. Your name, please?", "May I ask your business here?", "I do not believe we have met.", "One moment. Now, how can I help?", "{greeting}. Who directed you to me?", "Perhaps we should introduce ourselves.", "You wished to speak with me?", "Very well. What is the matter?", "I can give you a little of my time.", "Are you expected by someone?", "Please, speak clearly.", "You are visiting, I take it?", "Let us begin with your name.", "What may I do for a newcomer?", "There is no need to wait at that distance.", "You have my attention. Proceed."]
        .anxious: ["Oh. Hello. Were you waiting for me?", "{greeting}. Do we know one another?", "Sorry, were you speaking?", "Have you come about something?", "I hope I haven't kept you.", "Hello. You're from an aircraft, aren't you?", "You caught me unawares.", "Is something the matter?", "What was your name? I don't think I heard it.", "Can I help? I'll try.", "I thought you were somebody else. Sorry.", "Just a moment. Yes?", "Are you looking for someone?", "Tell me what you need.", "You wanted a word with me?", "Hello. I wasn't expecting anyone."]
        .warm: ["{greeting}. Come in closer.", "Have we met? I ought to know that face.", "You look as though you've come a way.", "Hello, dear. Who are you looking for?", "You needn't stand on ceremony here.", "There's room for one more conversation.", "Have you found what you came for?", "A visitor. And what do they call you?", "Stop a minute, if you're not in a hurry.", "Tell me your name before I forget to ask.", "What brings you among us?", "Come out of the way of the passers-by.", "Are you staying for the evening?", "I can spare a moment for a new face.", "{greeting}. Have you settled yourself?", "Hello. What can I do for you?"]
        .measured: ["{greeting}. I don't think we have spoken.", "Hello. Is there something you wanted?", "Shall we introduce ourselves?", "You needn't raise your voice. I can hear.", "What would you like to ask?", "I'm listening.", "Are you new to this place?", "Come a little closer, if you like.", "Who should I say I have met?", "We can talk here.", "Hello. What brings you this way?", "If you're looking for someone, perhaps I can help.", "Have you a question for me?", "A moment, then. Go ahead.", "{greeting}. It's good to put a voice to a face.", "What is it you'd like to know?"]
        .wry: ["{greeting}. You must have run out of better company.", "A new face. That should improve things.", "If you're selling miracles, I haven't the purse.", "Who are you, when you're not blocking the way?", "Hello. We haven't quarrelled yet, have we?", "Business or a story? I prefer the second.", "You look as though you've been sent to find me.", "What is it? I'm only pretending to be occupied.", "Have you brought the news, or are you it?", "Tell me your name. I'm poor at guessing.", "Good. Somebody who hasn't heard all my complaints.", "If it's advice, I have plenty. Not all useful.", "Come on, then. Let's meet properly.", "There's no fee for standing here. Yet.", "What brings you to my patch of inconvenience?", "{greeting}. Start with something cheerful."]
        .guarded: ["What do you want?", "I don't know you.", "Who told you to come here?", "Have we any business together?", "Keep your hands where I can see them.", "Say your name first.", "I'm not looking for company.", "What are you asking after?", "You're a long way from your own doorstep.", "Speak quietly.", "Do I owe you something?", "I can hear. There's no need to come closer.", "Choose your first question carefully.", "You have a moment. Use it.", "Are you lost, or looking for someone?", "{greeting}. That's all I've promised so far."]

farewell_lines = (voice: VoiceKind) -> str[]: match voice:
    .salt: ["Mind the water.", "Go on, then.", "I'll be about.", "Keep a line ashore.", "Safe home.", "Don't hurry the sea.", "Enough talk. Off you go.", "We'll speak again.", "Take your time over it.", "Watch where you put your feet.", "Leave it with me.", "Till next time."]
    .formal: ["Good day to you.", "That will do for now.", "We shall speak again.", "Thank you for calling.", "I will not keep you.", "I wish you a safe journey.", "Until our next conversation.", "Very well. Good day.", "You know where to find me.", "Please take care on your way.", "We understand one another, I think.", "I have other matters to attend to."]
    .guarded: ["You can go.", "That's enough for now.", "Remember what I said.", "We are finished, then.", "Keep our conversation here.", "Don't linger on my account.", "Go carefully.", "I've said my piece.", "We may speak again.", "There's your way back.", "Not another question just now.", "Leave it there."]
    else: ["Take care of yourself.", "Come back when you've time.", "I won't keep you any longer.", "Safe journey, then.", "We'll talk another day.", "Give my regards along the quay.", "Thank you for stopping.", "Don't let the day run away with you.", "I'll see you about.", "Go well.", "You know where to find me.", "Till we meet again.", "I must get on. So must you, I expect.", "Another word another time.", "I'll let you go.", "Remember to stop and eat something."]

quiet_lines = (voice: VoiceKind) -> str[]: match voice:
    .salt: ["I've told you what I know.", "No more in the net today.", "Ask me something else.", "You won't get a new answer by asking twice."]
    .formal: ["I have nothing further to add.", "I would rather not speculate.", "That is the extent of what I can tell you.", "Perhaps another subject."]
    .guarded: ["I said what I said.", "That's not for you.", "You ask too much.", "Leave that alone."]
    else: ["I'd only be repeating myself.", "There's nothing more I can tell you just now.", "Shall we talk about something else?", "I don't know. I won't invent an answer for you."]

# These observations are chosen only after checking the actual local weather.
weather_lines = (voice: VoiceKind, rough: bool, sheltered: bool) -> str[]:
    if rough:
        if voice == .salt: return ["No sense arguing with weather like this.", "I'd leave the boat tied.", "The nets can wait. We can't replace a man.", "Watch the water, not the clock.", "This is a day for mending.", "You can be late and still get home.", "If you go, leave word where.", "I've no appetite for that crossing today."]
        if sheltered: return ["Come under here. It won't make you any later.", "At least this roof has an honest day's work.", "I can wait it out here.", "I'll have another conversation before I go back out.", "We've room to shelter, if nothing else.", "The weather has brought us all to the same doorstep.", "You might as well sit until it eases.", "I'm glad not to be standing on the quay just now."]
        return ["I wish I'd finished this before the weather came in.", "Mind yourself out there.", "There's no shame in waiting.", "A roof would improve this conversation.", "I'd sooner lose an hour than an aircraft.", "I keep finding reasons not to leave yet.", "If you're flying, don't let anyone hurry you.", "People can wait more easily than the sea."]
    match voice:
        .salt: ["Nothing to quarrel with in the weather just now.", "Fair enough for a look outside.", "It may hold. I don't make promises for it.", "A quiet spell. Use it while it's here.", "I'm not complaining of the sky today.", "The weather isn't what keeps me standing here.", "We've had worse mornings to work in.", "Don't waste a fair spell asking me to predict the next."]
        .anxious: ["It looks fair here. I hope it stays that way.", "I keep looking up as though it'll answer me.", "At least the weather isn't giving me another excuse.", "I prefer a day when the horizon stays put.", "I'm trying not to fret about tomorrow's wind.", "It seems kind enough, just now.", "I can see the sky. It's the rest I worry about.", "Ask an old fisherman. Then ask another one."]
        else: ["It's fair here at the moment.", "A good enough day to walk a little.", "I'm taking the weather while it's offered.", "If it holds, I may take the long way home.", "One fewer thing to complain about, for the moment.", "The sky has left us to our other worries.", "You could find a worse time to stop and talk.", "I've no complaint about the weather here."]

followup_lines = (voice: VoiceKind, topic: TalkTopic) -> str[]:
    if topic == .news: return ["What did you hear yourself?", "Who told you the other side of it?", "Have you heard anything different?", "What do people say where you've been?", "Would you trust that account?", "Has anyone spoken to you about it?", "What would you make of that?", "Can you add anything to what I heard?"]
    match voice:
        .salt: ["Going out, or coming in?", "Have you eaten?", "What are you after here?", "You've time to sit?", "How did you get on?", "Anyone waiting for you?", "You keeping well?", "Where does the day take you next?", "What's on your mind?", "You found what you wanted?", "Can you spare a little time?", "And how is it with you?"]
        .formal: ["Will you be remaining here?", "What brings you to this part of town?", "Is there something I can assist with?", "Have you business still to conclude?", "How has your journey treated you?", "Do you intend to stay a while?", "May I ask what you have in mind?", "Have you found the person you sought?", "Where will your business take you next?", "Is there anything you wished to ask?", "How do you find our town?", "Do you have time for a proper conversation?"]
        .guarded: ["Who are you here to see?", "What do you want from me?", "Are you going somewhere?", "Who's waiting for you?", "Why are you asking?", "Do you mean to stay?", "Have you business here?", "What's your side of it?", "Do you know anyone here?", "What did you come looking for?", "How long have you been standing there?", "What would you do in my place?"]
        .wry: ["Have you had a sensible day, or an interesting one?", "What have you managed to avoid doing?", "Any good news, even borrowed?", "Are you staying long enough to be useful?", "What can you tell me that won't spoil my evening?", "Have you eaten, or is that only for the fortunate?", "Would you call this a good day?", "What brought you to my fine establishment of standing about?", "Did the day live up to its promises?", "Any trouble you can safely tell me about?", "Where are you off to next?", "Will you stay a little, or have I frightened you off?"]
        else: ["Have you been keeping well?", "Will you stop for a little company?", "And you? How has the day treated you?", "Have you had something to eat?", "What brings you back this way?", "Have you found what you came for?", "Where do you go after this?", "Have you a moment to sit?", "Is there something you want to tell me?", "Are you staying for the evening?", "What would make the day better for you?", "Can you spare a little of your time?"]
