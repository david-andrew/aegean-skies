# Explicit limits of a speaker's knowledge; other speech is composed from saved particulars.
use 'life_types.jo'

quiet_lines = (voice: VoiceKind) -> str[]: match voice:
    .salt: ["I've told you what I know.", "No more in the net today.", "Ask me something else.", "You won't get a new answer by asking twice."]
    .formal: ["I have nothing further to add.", "I would rather not speculate.", "That is the extent of what I can tell you.", "Perhaps another subject."]
    .guarded: ["I said what I said.", "That's not for you.", "You ask too much.", "Leave that alone."]
    else: ["I'd only be repeating myself.", "There's nothing more I can tell you just now.", "Ask me about something else.", "I don't know. I won't invent an answer for you."]
