# Deliberate limits of knowledge; each voice has its own words, not a shared fallback speaker.
use 'life_types.jo'
quiet_lines = (voice: VoiceKind) -> str[]: match voice:
    .salt: ["That's all I know.","Nothing more to tell.","Ask someone else about that.","You've had my answer."]
    .shop: ["I've nothing more on that.","That's all I can tell you.","I'd only be guessing.","You'd best ask elsewhere."]
    .formal: ["I have nothing to add.","I'd rather not speculate.","That's the extent of what I know.","Perhaps another subject."]
    .guarded: ["That's all.","Not your concern.","I've said enough.","Leave it."]
    .anxious: ["I don't know any more, honestly.","I'd only get it wrong.","That's all I've heard.","I'm sorry, I don't know."]
    .warm: ["That's all I can tell you, I'm afraid.","Ask me something else.","I wish I knew more.","We'll leave that there for today."]
    .measured: ["I don't know, and I won't make it up.","That's the end of what I know.","I'd need to hear more first.","I've told you what I know."]
    .wry: ["I'd only be repeating myself.","You've had the long version already.","Even I run out eventually.","That's my lot."]
    .plain: ["Don't know.","That's all.","Can't help you there.","No more to say."]
    .devout: ["I know no more than that.","The rest is beyond me.","I can't tell you more.","Let us leave it there."]
    .brisk: ["That's all I have.","No more on that.","I must get on.","Nothing else to say."]
    .chatty: ["Well, that's all I've heard, and I hear most things.","For once I've nothing more.","That's the lot, I'm afraid.","You'd think I'd know more."]
    .eager: ["That's all I know.","I don't know more than that.","Ask someone else, maybe.","No idea, sorry."]
    .elder: ["My memory's not what it was.","That's all I recall.","I've told you what I remember.","Ask the young ones."]
