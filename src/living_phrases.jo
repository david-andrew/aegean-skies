# Deliberate limits of knowledge; each voice has its own words, not a shared fallback speaker.
use 'life_types.jo'
quiet_lines = (voice: VoiceKind) -> str[]: match voice:
    .salt: ["I've told you what I know.","No more in the net today.","Ask me something else.","You won't get a new answer by asking twice."]
    .shop: ["I've nothing more to offer on that.","That's all I can put before you.","Let us leave that at the counter.","You have the whole of my answer on that."]
    .formal: ["I have nothing further to add.","I would rather not speculate.","That is the extent of what I can tell you.","Perhaps another subject."]
    .guarded: ["I said what I said.","That's not for you.","You ask too much.","Leave that alone."]
    .anxious: ["I haven't heard anything more.","Let us leave that for now.","I can't give you another answer yet.","I'd sooner stop than put it wrongly."]
    .warm: ["There's nothing more I can tell you just now.","Ask me about something else.","That is as far as I can go with it.","We'll have to leave that there for today."]
    .wry: ["I'd only be repeating myself.","You have had the long answer already.","Even I know when to stop talking.","A second telling won't improve that one."]
    .measured: ["I don't know. I won't invent an answer for you.","I've come to the end of what I know about it.","I'd need to hear more before answering that.","I can leave it at what I have already said."]
