use 'living_guard.jo'
use 'living_transaction.jo'
# Explicit finite opening stock, not an unlock list. Further editions are published from the
# real registry by map_scene; subsequent calls never replenish already sold/rewarded sheets.
use 'living_types.jo'
use 'living_map_types.jo'
use 'living_maps.jo'
use 'living_content.jo'
import 'world.jo' as geography

_guarded_stock_map = (w: mut World, edition: str, shop: str, price: int) -> int:
    if not (edition in w.maps.editions and shop in w.maps.shops and price>0):
        living_fault("living_map_seed.stock_map.0",guard_context(w)+" price={price}")
        return -1
    if not (w.maps.copies.len()<1024):
        living_fault("living_map_seed.stock_map.1",guard_context(w)+" price={price}")
        return -1
    id = w.maps.next_copy; w.maps.next_copy += 1; w.maps.issued += 1
    s = w.maps.shops[shop]
    w.maps.copies[id] = MapCopy(id,edition,.shop,shop=shop,place=s.place,pos=s.pos,price_cents=price,source="opening:{edition}:{id}")
    id

publish_map = (w: mut World, definition: PaperMap, sellers: str[], price: int) -> bool:
    if definition.id in w.maps.editions or not map_bounds_valid(definition.bounds) or sellers.len() == 0: return false
    loop seller in sellers:
        if not (seller in w.maps.shops): return false
    w.maps.editions[definition.id] = definition
    loop seller in sellers: stock_map(w,definition.id,seller,price)
    true

_guarded_initialize_maps = (w: mut World):
    if w.maps.version >= 1: return
    if not (w.maps.version == 0 and w.maps.copies.len() == 0):
        living_fault("living_map_seed.initialize_maps.2",guard_context(w))
        return
    w.maps.version = 1
    wharf = w.cargo_harbors[0].warehouse
    w.maps.shops["porto-chandler"] = MapShop("porto-chandler","Eleni's chandlery",0,1,w.people[1].account,wharf,"chandler")
    w.maps.shops["porto-office"] = MapShop("porto-office","Porto Vecchio harbour office",0,5,w.factions[0].account,w.people[5].pose.pos,"harbour office")
    w.maps.shops["kalamos-store"] = MapShop("kalamos-store","Kalamos cooperative counter",1,13,w.places[1].market.account,w.cargo_harbors[1].warehouse,"general store")
    w.maps.shops["selene-desk"] = MapShop("selene-desk","Hotel Selene reception",4,20,w.people[20].account,w.people[20].pose.pos,"hotel")
    at = w.harbors[0].center
    b = MapBounds(f64(at.x)-2700,f64(at.z)-2700,f64(at.x)+2700,f64(at.z)+2700)
    tourist = PaperMap("porto-tourist-1925","Tourist map of Porto Vecchio, 1925","Bellini & Marinou, Porto Vecchio",1925,.tourist,b,12000,3,[.coast,.towns,.roads,.landmarks,.moorings],25,notes="A visitor's street sheet. No soundings; not for navigating the channel.")
    if not (publish_map(w,tourist,["porto-chandler","selene-desk","porto-chandler"],200)):
        living_fault("living_map_seed.initialize_maps.3",guard_context(w))
        return
    # Shared immutable survey marks are referenced by edition, not copied afresh every draw.
    loop place in 0..w.places.len():
        h = w.harbors[place]
        key = "town:{place}"
        w.maps.features[key] = MapFeature(key,.towns,h.center,PLACE_NAMES[place],town_size=w.places[place].population)
        loop dock in 0..h.docks.len():
            key = "mooring:{place}:{dock}"
            w.maps.features[key] = MapFeature(key,.moorings,h.docks[dock],"{PLACE_NAMES[place]} quay {dock+1}")
    loop venue in w.life_venues:
        if venue.kind == .home or venue.kind == .shelter: continue
        key = "landmark:{venue.key}"
        w.maps.features[key] = MapFeature(key,.landmarks,venue.pos,"{PLACE_NAMES[venue.place]} {venue.kind}")
    # One cheap street sheet is the player's opening property, not a free world chart.
    starter = w.maps.next_copy-1
    map_to_person(w,starter,w.player,.opening)
    map_record_transfer(w,starter,.shop,-1,w.player,.opening)
    b = MapBounds(-11500,-11500,11500,11500)
    old = PaperMap("kalamos-channel-1911","Admiralty chart of the Kalamos channel, 1911","Archipelago Hydrographic Office",1911,.nautical,b,65000,2,[.coast,.depth,.towns,.lighthouses,.hazards,.moorings],180,survey_offset=vec2(110,-80),rotation_rad=0.001,scale_error_ppm=1200,minimum_town_size=8,notes="Soundings surveyed in 1911. No correction slips accompany this copy.")
    old.errors = [MapError(.moorings,"mooring:0:2",.omitted),MapError(.moorings,"mooring:1:0",.displaced,offset=vec2(130,-45)),MapError(.hazards,"shoal:old-kalamos",.phantom,label="3 fathoms (1911)",at=w.harbors[1].safe_water,depth_m=5.49)]
    if not (publish_map(w,old,["porto-office","porto-chandler","porto-chandler"],950)):
        living_fault("living_map_seed.initialize_maps.4",guard_context(w))
        return
    # Eleni promises one reserved, existing sheet for the opening medicine delivery.
    if 3 in w.jobs:
        if not (offer_map_reward(w,3,w.maps.next_copy-1,1)):
            living_fault("living_map_seed.initialize_maps.5",guard_context(w))
            return
    cache = stock_map(w,old.id,"porto-office",950)
    w.maps.copies[cache].holder = .cache; w.maps.copies[cache].shop = ""
    w.maps.copies[cache].pos = wharf+vec3(1,0,0)
    loop i in 0..geography.ISLANDS.len():
        island = geography.ISLANDS[i]
        rx = f64(island.radius*island.stretch.x)*geography.REACH+800
        rz = f64(island.radius*island.stretch.y)*geography.REACH+800
        bounds = MapBounds(f64(island.center.x)-rx,f64(island.center.y)-rz,f64(island.center.x)+rx,f64(island.center.y)+rz)
        m = PaperMap("island:{i}:1923","Sketch map of {island.name}, 1923","Island Co-operative Press",1923,.tourist,bounds,25000,2,[.coast,.towns,.roads,.landmarks,.lighthouses,.moorings],60,survey_offset=vec2(f32(i%3*14-14),f32(i%5*8-16)),notes="Paths and village names for visitors. Blank water carries no guarantee of safe depth.")
        seller = if i == 0 or i == 1: "kalamos-store" else: if i == 9: "selene-desk" else: "porto-chandler"
        if not (publish_map(w,m,[seller],300+i%3*50)):
            living_fault("living_map_seed.initialize_maps.6",guard_context(w))
            return
    m = PaperMap("archipelago-pilot-1924","Pilots' mooring sheet: the Kalamos Islands, 1924","Archipelago Aviation Co-operative",1924,.nautical,b,80000,1,[.coast,.towns,.lighthouses,.hazards,.airfields,.moorings],85,minimum_town_size=12,notes="Water moorings recorded in 1924; no claim that a quay is currently free or serviceable.")
    if not (publish_map(w,m,["porto-office","kalamos-store"],1400)):
        living_fault("living_map_seed.initialize_maps.7",guard_context(w))
        return
    # A large-scale-name on a small-scale sheet is not a detailed convenient global chart.
    world = PaperMap("aegean-general-1898","General sea chart of the Aegean, 1898","Eastern Sea Survey",1898,.nautical,MapBounds(-250000,-200000,250000,200000),2500000,0,[.coast,.depth,.towns,.lighthouses,.hazards],700,survey_offset=vec2(-350,220),rotation_rad=0.0008,scale_error_ppm=-900,minimum_town_size=250,notes="Ocean overview from the 1898 survey. Major ports only; use a local sheet for landfall. No aviation information.")
    if not (publish_map(w,world,["porto-office"],2600)):
        living_fault("living_map_seed.initialize_maps.8",guard_context(w))
        return

    keys = w.maps.editions.keys(); keys.sort()
    loop key in keys:
        if key != "aegean-general-1898": map_snapshot_features(w,key)


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
stock_map = (w: mut World, edition: str, shop: str, price: int) -> int:
    if guard_blocked(): return -1
    scope = guard_begin(w)
    result = _guarded_stock_map(w,edition,shop,price)
    failed = guard_failed(scope)
    guard_finish(w,scope)
    if failed: -1 else: result

initialize_maps = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_initialize_maps(w)
    guard_finish(w,scope)
