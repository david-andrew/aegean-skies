# Actual merchant and paid charter hulls agree an escort at their shared departure port.
# They keep their original journeys, stock, crews and motion owner; following only limits
# the escort's progress, never moves the merchant or teleports either ship into formation.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_war_types.jo'
use 'living_war.jo'
use 'living_war_contacts.jo'
use 'living_money.jo'
use 'living_far_news.jo'
use 'living_place_context.jo'
use 'living_guard.jo'
use 'living_transaction.jo'
use 'living_work_types.jo'

_form_convoy = (w: mut World, unit: int, merchant: int) -> bool:
    if unit<0 or unit>=w.war.units.len() or merchant<0 or merchant>=w.far.vehicles.len(): return false
    u=w.war.units[unit]
    if u.retired or u.vehicle<0 or u.convoy!=none or u.prize_return or war_power(w,unit)<=0 or w.minute>=u.charter_until: return false
    escort=w.far.vehicles[u.vehicle]; v=w.far.vehicles[merchant]
    if merchant==u.vehicle or v.kind!=.ship or escort.kind!=.ship or v.citizen!=u.country or v.duty!=.merchant or v.journey<0 or escort.journey>=0 or escort.place<0 or escort.battle>=0 or v.battle>=0 or length(v.pos-escort.pos)>500 or w.accounts[v.account].cents<600: return false
    j=w.far.journeys[v.journey]
    if j.origin!=escort.place or j.good<0 or j.quantity<=0 or j.survey or w.far.districts[escort.place].controller!=u.country or war_unit_hostile(w,unit,w.far.districts[j.destination].controller): return false
    loop other in w.war.units:
        if let group=other.convoy:
            if group.merchant==merchant: return false
    if u.order>=0:
        task=w.war.orders[u.order].task
        if task!=.patrol and task!=.repair: return false
    if not war_start_leg(w,u.vehicle,j.link,.convoy): return false
    voyage=w.far.vehicles[u.vehicle].journey
    w.far.journeys[voyage].follow_vehicle=merchant
    w.far.journeys[voyage].follow_voyage=j.id
    if not transfer(w,v.account,escort.account,600,.rent,unit): living_fault("convoy.agreed_fee",guard_context(w)); return false
    if u.order>=0: w.war.orders.remove(u.order); w.war.units[unit].order= -1
    reason="Carrier {merchant} paid charter {u.vehicle} six lire at {life_place_name(w,j.origin)} to escort its existing {w.goods[j.good].key} cargo to {life_place_name(w,j.destination)}. Both crews and their provisions belong to their original ships."
    w.far.journeys[voyage].provenance=WorkProvenance(cause=reason,requester_account=v.account,supplier_account=escort.account,request_place=j.origin,requested_minute=w.minute,heard_minute=w.minute,agreed_minute=w.minute,freight_cents=600,freight_payer=v.account,deadline=u.charter_until,negotiated=true)
    w.war.units[unit].convoy=WarConvoy(merchant,j.id,voyage,j.origin,j.destination,w.minute,u.charter_until,600,v.account,reason)
    w.war.convoys_formed+=1
    far_local_news(w,j.origin,"convoy",reason,country=u.country,severity=400)
    true

form_convoy = (w: mut World, unit: int, merchant: int) -> bool:
    if guard_blocked(): return false
    scope=guard_begin(w); result=_form_convoy(w,unit,merchant)
    failed=guard_failed(scope); guard_finish(w,scope)
    result and not failed

convoys_minute = (w: mut World):
    if not w.far.populated: return
    loop unit in 0..w.war.units.len():
        u=w.war.units[unit]
        if let group=u.convoy:
            escort=w.far.vehicles[u.vehicle]; merchant=w.far.vehicles[group.merchant]
            delivered=escort.place==group.destination and merchant.place==group.destination
            invalid=u.retired or escort.hull<=350 or merchant.hull<=350 or w.minute>group.deadline or (merchant.journey!=group.voyage and merchant.place!=group.destination) or (escort.journey!=group.escort_voyage and escort.place!=group.destination)
            if not delivered and not invalid: continue
            if group.escort_voyage in w.far.journeys:
                w.far.journeys[group.escort_voyage].follow_vehicle= -1
                w.far.journeys[group.escort_voyage].follow_voyage= -1
            w.war.units[unit].convoy=none
            if delivered:
                w.war.convoys_delivered+=1
                far_local_news(w,group.destination,"convoy_arrival","Carrier {group.merchant} and charter {u.vehicle} both reached {life_place_name(w,group.destination)} under their paid escort agreement.",country=u.country,severity=450)
            else: war_unit_account(w,unit,"convoy_interrupted","The escort of carrier {group.merchant} could not complete its agreed voyage. The original ships, cargo and survivors remain at their actual positions.",700)
    # Local requests can replace an unstarted routine patrol, never an airborne/sea commitment.
    loop unit in 0..w.war.units.len():
        u=w.war.units[unit]
        if u.retired or u.convoy!=none or u.vehicle<0: continue
        escort=w.far.vehicles[u.vehicle]
        if escort.kind!=.ship or escort.place<0 or escort.journey>=0: continue
        threatened=false
        loop r in w.far.districts[escort.place].reports:
            if far_report_current(w,r) and r.severity>=700 and (r.kind=="battle" or r.kind=="prize" or r.kind=="blockade" or r.kind=="armed_intrusion" or r.kind=="war_declared"): threatened=true
        if not threatened: continue
        loop v in w.far.vehicles:
            if v.journey<0 or v.kind!=.ship or v.citizen!=u.country or length(v.pos-escort.pos)>500: continue
            if form_convoy(w,unit,v.id): break
