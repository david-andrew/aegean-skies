# A panel of debugging switches and actions (F1): fill the tank, mend the aircraft, unlimited
# fuel, no damage, money, the time of day, the wind, another aircraft, a place to be. The game
# reads what was chosen and does it.

struct Debug:
    open = false
    infinite_fuel = false
    no_damage = false

enum DebugAct: none, refuel, repair, money, hour_back, hour_on, wind_down, wind_up, craft_gull, craft_heron, craft_corsair, craft_falco, to_air, to_town

struct DebugResult:
    act: DebugAct = .none
    town = -1

debug_panel = (d: mut Debug, towns: str[]) -> DebugResult:
    global ui_style
    r = DebugResult()
    if not d.open: return r
    sw = f64(screen_width())
    rect_rounded(sw - 300, 66, 284, 20.0 + f64(14 + towns.len()) * 28.0 + 30.0, 10, rgba(0.06, 0.08, 0.12, 0.82))
    saved = ui_style
    ui_style.size = 17.0
    ui_style.spacing = 28.0
    ui_style.width = 250.0
    ui_begin("debug", vec2(f32(sw - 158), 76))
    ui_text("Debug  (F1 to close)", 18)
    if ui_button("Fill the tank"): r.act = .refuel
    if ui_button("Mend the aircraft"): r.act = .repair
    d.infinite_fuel = ui_switch("Unlimited fuel", d.infinite_fuel)
    d.no_damage = ui_switch("No damage", d.no_damage)
    if ui_button("+1000 lire"): r.act = .money
    if ui_button("An hour back"): r.act = .hour_back
    if ui_button("An hour on"): r.act = .hour_on
    if ui_button("Less wind"): r.act = .wind_down
    if ui_button("More wind"): r.act = .wind_up
    if ui_button("Fly the Gull"): r.act = .craft_gull
    if ui_button("Fly the Heron"): r.act = .craft_heron
    if ui_button("Fly the Corsair"): r.act = .craft_corsair
    if ui_button("Fly the Falco"): r.act = .craft_falco
    if ui_button("Up in the air, 300 m"): r.act = .to_air
    loop k in 0..towns.len():
        if ui_button("To {towns[k]}"):
            r.act = .to_town
            r.town = k
    ui_end()
    ui_style = saved
    r
