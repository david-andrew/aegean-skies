# A panel of debugging switches and settings (F1), in three pages:
#   Aircraft  which one, fuel, unlimited fuel, no damage, each part's health, the wear on it
#   Place     any harbor, any altitude, anywhere on the chart
#   World     the hour, the wind, money
# The game fills a DebugView with how things are; the panel changes it in place and says what
# else was asked for; the game applies the differences.

struct Debug:
    open = false
    page = 0
    infinite_fuel = false
    no_damage = false
    town = 0
    altitude = 300.0
    picking = false                 # the next click on the chart is where to go
    lire_text = ""

# how things are now (the panel edits these)
struct DebugView:
    craft = 0                       # 0 Gull, 1 Heron, 2 Corsair, 3 Falco
    fuel = 1.0                      # share of a full tank
    parts: f64[]                    # each part's health, 0 (gone) .. 1
    hull_wear = 0.0                 # the world's wear on it, 0 new .. 1 worn out
    engine_wear = 0.0
    hour = 12.0
    wind = 0.0                      # added to the weather's wind, m/s
    wind_now = 0.0                  # (what the wind is now, for showing)
    lire = 0

enum DebugAct: none, repair, wreck, money_add, money_set, to_town, to_altitude, pick

struct DebugResult:
    act: DebugAct = .none
    town = -1
    lire = 0

PART_LABELS = ["Body", "Engine", "Left wing", "Right wing", "Left float", "Right float", "Tail"]
PAGES = ["Aircraft", "Place", "World"]

debug_panel = (d: mut Debug, v: mut DebugView, towns: str[], craft_names: str[]) -> DebugResult:
    global ui_style
    r = DebugResult()
    if not d.open: return r
    sw = f64(screen_width())
    rows = match d.page:
        0: 10 + v.parts.len()
        1: 7
        _: 7
    pw = 380.0
    rect_rounded(sw - pw - 16, 66, pw, 24.0 + f64(rows) * 30.0 + 20.0, 10, rgba(0.06, 0.08, 0.12, 0.85))
    saved = ui_style
    ui_style.size = 17.0
    ui_style.spacing = 30.0
    ui_style.width = pw - 44.0
    ui_begin("debug", vec2(f32(sw - 16 - pw * 0.5), 78))
    ui_text("Debug  (F1 to close)", 18)
    d.page = ui_choice("Page", PAGES, d.page)
    match d.page:
        0:
            v.craft = ui_choice("Aircraft", craft_names, v.craft)
            v.fuel = ui_slider("Fuel  {int(v.fuel * 100.0 + 0.5)}%", v.fuel, 0.05, 0.0, 1.0)
            d.infinite_fuel = ui_switch("Unlimited fuel", d.infinite_fuel)
            d.no_damage = ui_switch("No damage", d.no_damage)
            if ui_button("Mend everything"): r.act = .repair
            if ui_button("Wreck it"): r.act = .wreck
            loop k in 0..v.parts.len():
                label = if k < PART_LABELS.len(): PART_LABELS[k] else: "Part {k}"
                shown = if v.parts[k] <= 0.0: "gone" else: "{int(v.parts[k] * 100.0 + 0.5)}%"
                v.parts[k] = ui_slider("{label}  {shown}", v.parts[k], 0.05, 0.0, 1.0)
            v.hull_wear = ui_slider("Airframe wear  {int(v.hull_wear * 100.0 + 0.5)}%", v.hull_wear, 0.05, 0.0, 1.0)
            v.engine_wear = ui_slider("Engine wear  {int(v.engine_wear * 100.0 + 0.5)}%", v.engine_wear, 0.05, 0.0, 1.0)
        1:
            if towns.len() > 0:
                d.town = ui_choice("Harbor", towns, min(d.town, towns.len() - 1))
                if ui_button("Moor at {towns[d.town]}"):
                    r.act = .to_town
                    r.town = d.town
            d.altitude = ui_slider("Altitude  {int(d.altitude)} m", d.altitude, 50.0, 0.0, 4000.0)
            if ui_button("Up (or down) to this altitude here"): r.act = .to_altitude
            if ui_button(if d.picking: "Click the chart where to go" else: "Pick a place on the chart"): r.act = .pick
            ui_text("(on the chart: at this altitude; 0 m on the water)", 14)
        _:
            v.hour = ui_slider("Hour  {int(v.hour):02}:{int((v.hour - floor(v.hour)) * 60.0):02}", v.hour, 0.25, 0.0, 24.0)
            v.wind = ui_slider("Wind  {v.wind_now:.0} m/s  ({v.wind:+.0})", v.wind, 1.0, -15.0, 25.0)
            ui_text("{v.lire} lire", 17)
            d.lire_text = ui_text_field("Set lire to", d.lire_text, 9)
            if ui_button("Set"):
                if let n = to_int(d.lire_text):
                    r.act = .money_set
                    r.lire = n
            if ui_button("+1000 lire"): r.act = .money_add
    ui_end()
    ui_style = saved
    r
