use 'music_data.jo'
use 'music_audition.jo'
use 'tweaks.jo'
use 'scenario_catalog.jo'
from 'weather_scene.jo' import WEATHER_LABELS
from 'combat.jo' import PLAYER_GUN_NAMES
use 'options.jo'
from 'ambience_synth.jo' import AMBIENCE_LABELS, AMBIENCE_CATEGORIES

# The pause menu, which (while this is in development) is a panel of debugging switches and
# settings, worked with the mouse only so no key meant for flying moves it. Three pages:
#   Aircraft  which one, fuel, endless fuel, no damage, no drag, each part's health, the wear on it
#   Place     any harbor, any altitude, anywhere on the chart
#   World     the hour, the wind, how rough the sea is, the sounds, money
#   Tweaks    trial changes, to compare with the version that felt right
# The game fills a DebugView with how things are; the panel changes it in place and says what
# else was asked for; the game applies the differences.

struct Debug:
    open = false
    page = 0
    music: MusicAudition = MusicAudition()
    music_page = 0
    endless_ammunition = false
    gun_choice = 0
    infinite_fuel = false
    no_damage = false
    no_drag = false
    altitude = 300.0
    picking = false                 # the next click on the chart is where to go
    lire_text = ""
    snd_air = true                  # (sounds on or off, to hear each kind alone)
    snd_cloth = true
    snd_frame = true
    snd_world: bool[] = fill(true,AMBIENCE_CATEGORIES)
    weather_choice = -1
    snd_more = false
    tweaks: Tweaks = Tweaks()       # (trial changes, each off: Tweaks page)
    opts: Options = Options()       # (the player's options: Options page)

# how things are now (the panel edits these)
struct DebugView:
    craft = 0                       # 0 Gull, 1 Heron, 2 Corsair, 3 Falco
    fuel = 1.0                      # share of a full tank
    parts: f64[]                    # each part's health, 0 (gone) .. 1
    hull_wear = 0.0                 # the world's wear on it, 0 new .. 1 worn out
    engine_wear = 0.0
    hour = 12.0
    wind = 0.0                      # added to the weather's wind, m/s
    wind_now = 0.0                  # (what the wind is now, for showing)
    lire = 0
    speed_scale = 3.3               # how many times faster than designed the aircraft fly, drawn
    lift_scale = 3.3                # how many times faster one must go to lift off (pure scale)
    bullet_scale = 5.0              # how many times faster the rounds go
    sea_rough = 1.0                 # how rough the sea is for its wind (0 glassy .. 3 heavy)

enum DebugAct: none, repair, wreck, money_add, money_set, to_town, to_altitude, pick

struct DebugResult:
    weather = -1
    scenario = ""
    act: DebugAct = .none
    town = -1
    lire = 0

PART_LABELS = ["Body", "Engine", "Left wing", "Right wing", "Left float", "Right float", "Tail"]
PAGES = ["Aircraft", "Place", "World", "Tweaks", "Options", "Scenarios", "Music"]

const ROW = 30.0
const GAP = 6.0

debug_panel = (d: mut Debug, v: mut DebugView, towns: str[], craft_names: str[]) -> DebugResult:
    global hud_style
    r = DebugResult()
    if not d.open: return r
    saved = hud_style
    hud_style.text_size = 16.0
    hud_style.panel = rgba(0.06, 0.08, 0.12, 0.88)
    hud_style.button = rgba(0.14, 0.17, 0.22, 1)
    hud_style.hover = rgba(0.22, 0.27, 0.34, 1)
    sw = f64(screen_width())
    sh = f64(screen_height())
    pw = 400.0
    x = sw - pw - 16.0
    w = pw - 24.0
    rows = match d.page:
        0: 10.5 + f64((craft_names.len() + 3) / 4) * 0.8 + f64((v.parts.len() + 1) / 2 + 1)
        1: 4.0 + f64((towns.len() + 1) / 2)
        2: 9.0
        4: 4.0
        6: 11.5
        _: 5.0
    ph = if d.page == 6: sh-32.0 else: min(sh - 32.0, 82.0 + (f64((PAGES.len() + 2) / 3) - 2.0) * (ROW + GAP) + rows * (ROW + GAP) + 12.0)
    hud_panel(Rect(x, 16, pw, ph))
    text("Paused   (P to carry on)", vec2(f32(x + 12), 24), 17, rgba(1, 0.97, 0.9, 0.9))
    y = 52.0
    x += 12.0
    # the pages, as tabs
    tw = (w - GAP * 2.0) / 3.0
    loop k in 0..PAGES.len():
        if hud_button(Rect(x + f64(k%3) * (tw + GAP), y+f64(k/3)*(ROW+GAP), tw, ROW), PAGES[k], selected = d.page == k): d.page = k
    # (the tabs, three to a row, as many rows as they need)
    tab_rows = f64((PAGES.len() + 2) / 3)
    y += tab_rows * (ROW + GAP) + GAP * 3.0
    match d.page:
        5:
            loop scenario in SCENARIOS:
                if hud_button(Rect(x,y,w,ROW),scenario.name):r.scenario=scenario.key
                y+=ROW+GAP
                text(scenario.description,vec2(f32(x),f32(y)),14,rgba(0.82,0.85,0.9,1))
                y+=ROW+GAP*2
            text("Replaces the current situation. P resumes play.",vec2(f32(x),f32(y)),14,rgba(0.7,0.75,0.8,1))
        0:
            # (the aircraft, four to a row)
            cw = (w - GAP * 3.0) / 4.0
            ch = ROW * 0.8
            loop k in 0..craft_names.len():
                if hud_button(Rect(x + f64(k % 4) * (cw + GAP), y + f64(k / 4) * (ch + 4.0), cw, ch), craft_names[k], selected = v.craft == k): v.craft = k
            y += f64((craft_names.len() + 3) / 4) * (ch + 4.0) + GAP
            v.fuel = hud_slider(Rect(x, y, w, ROW), v.fuel, 0.0, 1.0, 0.05, "Fuel  {int(v.fuel * 100.0 + 0.5)}%")
            y += ROW + GAP
            third = w / 3.0
            d.infinite_fuel = hud_checkbox(Rect(x, y + 6, third - GAP, ROW - 12), "Endless fuel", d.infinite_fuel)
            d.no_damage = hud_checkbox(Rect(x + third, y + 6, third - GAP, ROW - 12), "No damage", d.no_damage)
            d.no_drag = hud_checkbox(Rect(x + third * 2.0, y + 6, third, ROW - 12), "No drag", d.no_drag)
            y += ROW + GAP
            d.endless_ammunition = hud_checkbox(Rect(x, y + 6, w * 0.56 - GAP, ROW - 12), "Endless ammunition", d.endless_ammunition)
            if hud_button(Rect(x + w * 0.56, y, w * 0.44, ROW), "Guns: {PLAYER_GUN_NAMES[d.gun_choice]}"):d.gun_choice=(d.gun_choice+1)%PLAYER_GUN_NAMES.len()
            y += ROW + GAP
            # (true speeds this many times the designed ones, turning at the designed rates)
            v.speed_scale = hud_slider(Rect(x, y, w, ROW), v.speed_scale, 1.0, 5.0, 0.1, "Speed x{v.speed_scale:.1}")
            y += ROW + GAP
            v.lift_scale = hud_slider(Rect(x, y, w, ROW), v.lift_scale, 1.0, 5.0, 0.1, "Liftoff speed x{v.lift_scale:.1}")
            y += ROW + GAP
            v.bullet_scale = hud_slider(Rect(x, y, w, ROW), v.bullet_scale, 1.0, 8.0, 0.1, "Bullet speed x{v.bullet_scale:.1}")
            y += ROW + GAP
            if hud_button(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), "Mend everything"): r.act = .repair
            if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Wreck it"): r.act = .wreck
            y += ROW + GAP * 3.0
            # (each part's health, two to a row, then the wear)
            hw = (w - GAP) * 0.5
            loop k in 0..v.parts.len():
                label = if k < PART_LABELS.len(): PART_LABELS[k] else: "Part {k}"
                shown = if v.parts[k] <= 0.0: "gone" else: "{int(v.parts[k] * 100.0 + 0.5)}%"
                v.parts[k] = hud_slider(Rect(x + f64(k % 2) * (hw + GAP), y + f64(k / 2) * (ROW + GAP), hw, ROW), v.parts[k], 0.0, 1.0, 0.05, "{label}  {shown}")
            y += f64((v.parts.len() + 1) / 2) * (ROW + GAP)
            v.hull_wear = hud_slider(Rect(x, y, hw, ROW), v.hull_wear, 0.0, 1.0, 0.05, "Airframe wear {int(v.hull_wear * 100.0 + 0.5)}%")
            v.engine_wear = hud_slider(Rect(x + hw + GAP, y, hw, ROW), v.engine_wear, 0.0, 1.0, 0.05, "Engine wear {int(v.engine_wear * 100.0 + 0.5)}%")
        1:
            d.altitude = hud_slider(Rect(x, y, w, ROW), d.altitude, 0.0, 4000.0, 50.0, "Altitude  {int(d.altitude)} m")
            y += ROW + GAP
            if hud_button(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), "To it, here"): r.act = .to_altitude
            if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Pick on the chart"): r.act = .pick
            y += ROW + GAP * 3.0
            text("Moor at", vec2(f32(x), f32(y)), 15, rgba(1, 0.97, 0.9, 0.7))
            y += 22.0
            hw = (w - GAP) * 0.5
            loop k in 0..towns.len():
                if hud_button(Rect(x + f64(k % 2) * (hw + GAP), y + f64(k / 2) * (ROW + GAP), hw, ROW), towns[k]):
                    r.act = .to_town
                    r.town = k
        3:
            # (trials: off, as it was when speed 3.3 first felt right)
            text("Off: as it was when speed 3.3 first felt right", vec2(f32(x), f32(y + 4)), 14, rgba(1, 0.97, 0.9, 0.7))
            y += ROW
            row = (label: str, on: bool) -> bool: hud_checkbox(Rect(x, y + 6, w, ROW - 12), label, on)
            d.tweaks.pure_scale = row("Pure speed scale (takeoff, handling by true)", d.tweaks.pure_scale)
            y += ROW + GAP
            d.tweaks.auto_trim = row("Auto-trim: let go, it holds its climb or descent", d.tweaks.auto_trim)
            y += ROW + GAP
            d.tweaks.chaotic_stalls = row("Chaotic stalls and spins", d.tweaks.chaotic_stalls)
            y += ROW + GAP
            d.tweaks.skybarons_response = row("Sky Barons energy and response", d.tweaks.skybarons_response)

        4:
            orow = (label: str, on: bool) -> bool: hud_checkbox(Rect(x, y + 6, w, ROW - 12), label, on)
            d.opts.tilt_aim = orow("Tilt the phone to fine-tune the aim", d.opts.tilt_aim)
            y += ROW + GAP
            d.opts.tilt_gain = hud_slider(Rect(x, y, w, ROW), d.opts.tilt_gain, 0.3, 3.0, 0.1, "Tilt sensitivity x{d.opts.tilt_gain:.1}")
            y += ROW + GAP
            d.opts.invert_y = orow("Invert looking up and down", d.opts.invert_y)

        6:
            # Small screens paginate the complete library; controls always stay visible.
            count = clamp(int((sh-y-190.0)/58.0),1,MUSIC_PIECES.len())
            pages = (MUSIC_PIECES.len()+count-1)/count
            d.music_page = clamp(d.music_page,0,pages-1)
            if pages > 1:
                if hud_button(Rect(x,y,70,ROW),"<"): d.music_page = (d.music_page+pages-1)%pages
                text("Library {d.music_page+1}/{pages}",vec2(f32(x+85),f32(y+7)),15,rgba(1,1,1,0.8))
                if hud_button(Rect(x+w-70,y,70,ROW),">"): d.music_page = (d.music_page+1)%pages
                y += ROW+GAP
            hud_style.text_size = 13.0
            loop k in d.music_page*count..min(MUSIC_PIECES.len(),(d.music_page+1)*count):
                piece = MUSIC_PIECES[k]
                if hud_button(Rect(x,y,w,26),piece.title,selected=d.music.piece == k): music_audition_select(d.music,k)
                text(piece.composer+" / "+piece.station,vec2(f32(x+4),f32(y+30)),11,rgba(1,0.97,0.9,0.75))
                y += 58.0
            hud_style.text_size = 16.0
            if hud_button(Rect(x,y,w*0.32,ROW),if d.music.playing: "Stop" else: "Play",selected=d.music.playing):
                if d.music.playing: d.music.playing = false
                else:
                    if d.music.position >= music_duration(d.music): music_audition_seek(d.music,0)
                    d.music.playing = true
            chain = hud_checkbox(Rect(x+w*0.36,y+6,w*0.64,ROW-12),"Through radio",d.music.through_radio)
            if chain != d.music.through_radio:
                d.music.through_radio = chain; d.music.dirty = true
            y += ROW+GAP
            pos = d.music.position; duration = music_duration(d.music)
            clock = (v: f64) -> str: "{int(v)/60}:{int(v)%60:02}"
            seek = hud_slider(Rect(x,y,w,ROW),pos,0.0,duration,0.01,clock(pos)+" / "+clock(duration))
            if abs(seek-pos) > 0.005: music_audition_seek(d.music,seek)
            y += ROW+GAP
            d.music.volume = hud_slider(Rect(x,y,w,ROW),d.music.volume,0.0,1.0,0.01,"Listening volume {int(d.music.volume*100)}%")

        _:
            v.hour = hud_slider(Rect(x, y, w, ROW), v.hour, 0.0, 24.0, 0.25, "Hour  {int(v.hour):02}:{int((v.hour - floor(v.hour)) * 60.0):02}")
            y += ROW + GAP
            weather_label = if d.weather_choice < 0: "Living" else: WEATHER_LABELS[d.weather_choice]
            if hud_button(Rect(x,y,w,ROW),"Set weather: {weather_label}  >"):
                d.weather_choice = (d.weather_choice+1)%WEATHER_LABELS.len()
                r.weather = d.weather_choice
            y += ROW + GAP
            v.wind = hud_slider(Rect(x, y, w, ROW), v.wind, -15.0, 25.0, 1.0, "Wind  {v.wind_now:.0} m/s  ({v.wind:+.0})")
            y += ROW + GAP
            v.sea_rough = hud_slider(Rect(x, y, w, ROW), v.sea_rough, 0.0, 3.0, 0.1, "Sea  x{v.sea_rough:.1}  (0 glassy, 1 as the wind makes it)")
            y += ROW + GAP
            if hud_button(Rect(x,y,92,ROW),"Sounds...",selected=d.snd_more): d.snd_more = not d.snd_more
            sw3 = (w - 100.0) / 3.0
            d.snd_air = hud_checkbox(Rect(x + 100.0, y + 6, sw3 - GAP, ROW - 12), "Air", d.snd_air)
            d.snd_cloth = hud_checkbox(Rect(x + 100.0 + sw3, y + 6, sw3 - GAP, ROW - 12), "Cloth", d.snd_cloth)
            d.snd_frame = hud_checkbox(Rect(x + 100.0 + sw3 * 2.0, y + 6, sw3, ROW - 12), "Airframe", d.snd_frame)
            y += ROW + GAP
            if d.snd_more:
                loop row in 0..3:
                    loop col in 0..3:
                        k = row*3+col
                        d.snd_world[k] = hud_checkbox(Rect(x+f64(col)*w/3,y+6,w/3-GAP,ROW-12),AMBIENCE_LABELS[k],d.snd_world[k])
                    y += ROW + GAP
            else:
                y += GAP*2
                text("{v.lire} lire", vec2(f32(x), f32(y)), 17, rgba(1, 0.97, 0.9, 0.9))
                y += 26.0
                d.lire_text = hud_text_field(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), d.lire_text, "lire", 9, "lire")
                if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Set") or (hud_focused("lire") and hud_submitted()):
                    if let n = to_int(d.lire_text):
                        r.act = .money_set
                        r.lire = n
                y += ROW + GAP
                if hud_button(Rect(x, y, w, ROW), "+1000 lire"): r.act = .money_add
    hud_style = saved
    r

# (typing into the panel's field: the game's keys left alone)
debug_typing = () -> bool: hud_focused("lire")
