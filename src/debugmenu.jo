use 'phoenix.jo'
use 'music_data.jo'
use 'music_audition.jo'
use 'tweaks.jo'
from 'flight_v2.jo' import Fdm2Tuning, fdm2_tuning_text, fdm2_skybarons_like
use 'scenario_catalog.jo'
from 'weather_scene.jo' import WEATHER_LABELS
from 'combat.jo' import PLAYER_GUN_NAMES
use 'options.jo'
use 'speech_stream.jo'
use 'side_colours.jo'
use 'sandbox.jo'
use 'touch.jo'
use 'fullscreen_mark.jo'
use 'aircraft_picker.jo'
use 'aircraft_paint_view.jo'
use 'aircraft_paint.jo'
use 'markings.jo'
use 'hud.jo'
use 'controls_page.jo'
use 'controller.jo'
from 'ambience_synth.jo' import AMBIENCE_LABELS, AMBIENCE_CATEGORIES

# The pause menu, which (while this is in development) is a panel of debugging switches and
# settings, worked with the mouse only so no key meant for flying moves it. Its pages:
#   Game      the three saved games: save here, load, delete (each asks first), and the autosave
#   Aircraft  which one: a card for each, grouped (switching to one)
#   Plane     the one flown now: fuel, endless fuel, no damage, no drag, guns, the speed scales,
#             mending, each part's health, the wear on it
#   Place     any harbor, any altitude, anywhere on the chart
#   World     the hour, the wind, how rough the sea is, the sounds, money
#   Tweaks    trial changes, to compare with the version that felt right
#   Flight v2 the flight model (liked, v2, Sky Barons'), v2's numbers live, and a line to copy
#   Paint     the aircraft repainted: livery, colours, insignia, rudder, tail number (src/aircraft_paint.jo)
# The game fills a DebugView with how things are; the panel changes it in place and says what
# else was asked for; the game applies the differences.

struct Debug:
    open = false
    page = 0
    panel: Rect = Rect(0, 0, 0, 0)  # (where the pause menu's panel was last drawn: a click beside it is the scene's)
    music: MusicAudition = MusicAudition()
    music_page = 0
    endless_ammunition = false
    gun_choice = 0
    infinite_fuel = false
    no_damage = false
    no_drag = false
    altitude = 300.0
    picking = false                 # the next click on the chart is where to go
    purse_text = ""
    snd_air = true                  # (sounds on or off, to hear each kind alone)
    snd_cloth = true
    snd_frame = true
    snd_world: bool[] = fill(true,AMBIENCE_CATEGORIES)
    weather_choice = -1
    snd_more = false
    tweaks: Tweaks = Tweaks()       # (trial changes, each off: Tweaks page)
    fdm2: Fdm2Tuning = Fdm2Tuning() # (flight model v2's numbers: Flight v2 page)
    fdm2_copied = 0.0               # (the copy button's "Copied" fades)
    fdm2_tab = 0                    # (the Flight v2 page's sliders: 0 feel, 1 Sky Barons' levers)
    opts: Options = Options()       # (the player's options: Options page)
    controls: ControlsPage = ControlsPage()   # (Controls page: which profile is shown)
    confirm = ""                    # (Game page: "save", "load" or "delete" waiting for a yes)
    craft_focus = -1                # (Aircraft page: the card the keys are on; Enter switches to it)
    craft_focus_moved = false
    focus_tab = -1                  # (a tab just chosen: the focus goes on it once laid out anew)
    confirm_slot = -1
    drawn_page = -1                 # (the page drawn last frame, and how tall its rows were: the
    drawn_height = 0.0              # panel is sized to that, so a page's rows never spill out)
    paint_page: PaintPage = PaintPage()   # (Paint page: the colour being changed, the free pick)
    reveal = ""                     # (Settings page, captures: the section scrolled into view: "accessibility", "sandbox")

# one saved-game slot, as the Game page shows it (made from the slot's header: src/game_menu.jo)
struct GameRow:
    slot = 0
    exists = false
    usable = false                  # (made by this game on this terrain: it can be loaded)
    autosave = false                # (the slot the autosave writes to)
    time = ""                       # "Wednesday 5 June 1929, 14:20"
    place = ""
    detail = ""                     # "Gull, ¤240, day 3"
    problem = ""

# how things are now (the panel edits these)
# A map in the world, for the World page's boxes: its edition, its title, whether the player has a copy
struct DebugMap:
    edition = ""
    title = ""
    owned = false

struct DebugView:
    maps: DebugMap[]                # (the World page: a box for each map, ticked where he has one)
    craft = 0                       # 0 Gull, 1 Heron, 2 Corsair, 3 Falco
    paint_name = ""                 # the paint it wears (the card's Paint button: the Paint page)
    fuel = 1.0                      # share of a full tank
    parts: f64[]                    # each part's health, 0 (gone) .. 1
    hull_wear = 0.0                 # the world's wear on it, 0 new .. 1 worn out
    engine_wear = 0.0
    hour = 12.0
    wind = 0.0                      # added to the weather's wind, m/s
    wind_now = 0.0                  # (what the wind is now, for showing)
    phoenixes = 0
    speed_scale = 3.3               # how many times faster than designed the aircraft fly, drawn
    lift_scale = 3.3                # how many times faster one must go to lift off (pure scale)
    bullet_scale = 7.0              # how many times faster the rounds go
    sea_rough = 1.0                 # how rough the sea is for its wind (0 glassy .. 3 heavy)
    games: GameRow[]                # the three saved-game slots
    game_ready = false              # (the saved games have been read)
    game_busy = false               # (a save, load or delete is under way)
    game_note = ""                  # what the last one came to, or what is under way
    autosave_note = ""              # where the autosave goes, or why it is off
    paint: Paint = Paint()          # the player's aircraft's paint (Paint page)
    paint_support: PaintSupport = PaintSupport()   # (what its type can wear)
    paint_shop: PaintShopView = PaintShopView()    # (the Paint page free, a paint shop's, or closed)
    craft_name = ""

enum DebugAct: none, repair, wreck, money_add, money_set, maps_all, map_one, to_town, to_altitude, pick

struct DebugResult:
    weather = -1
    scenario = ""
    act: DebugAct = .none
    town = -1
    phoenixes = 0
    game = ""                       # "save", "load" or "delete", confirmed
    game_slot = -1
    map_edition = ""                # (map_one: this map, ticked or not)
    map_on = false

PART_LABELS = ["Body", "Engine", "Left wing", "Right wing", "Left float", "Right float", "Tail"]
PAGES = ["Game", "Aircraft", "Place", "World", "Tweaks", "Settings", "Situations", "Music", "Flight v2", "Paint", "Plane", "Gamepad"]
const AIRCRAFT_PAGE = 1
const PAINT_PAGE = 9
const PLANE_PAGE = 10
const SETTINGS_PAGE = 5
const CONTROLS_PAGE = 11
# The tabs in the order shown (a page keeps its number wherever its tab stands): the player's own
# first (the game, the settings, gamepads and flight sticks, the aircraft's paint), then, with Advanced settings
# on (the Settings page), the trial and debugging pages: choosing any aircraft and its condition
# together, the places, the world, the trials, the situations, the music, the flight model.
PLAYER_PAGES = [0, 5, 11, 9]
ADVANCED_PAGES = [1, 10, 2, 3, 4, 6, 7, 8]
PAGE_ORDER = PLAYER_PAGES + ADVANCED_PAGES
# The tabs shown: the player's, or every page with Advanced settings on (or while one of the
# advanced pages is open, as a capture opens it)
# (the sandbox's "any aircraft at any time": the Aircraft page among the player's own)
shown_pages = (d: Debug) -> int[]:
    mine = if d.opts.sandbox.any_aircraft: PLAYER_PAGES + [AIRCRAFT_PAGE] else: PLAYER_PAGES
    if d.opts.advanced or not mine.contains(d.page): PAGE_ORDER else: mine
const TABS_PER_ROW = 4
# Tabs per row for a panel w wide: as many as hold the widest label whole at the tabs' size
# (three on an upright phone; on the wide Aircraft page all in two rows, leaving the cards room
# in a phone held sideways), never more than seven.
tabs_per_row = (w: f64, size: f64) -> int:
    widest = 0.0
    loop name in PAGES: widest = max(widest, text_width(name, size))
    clamp(int((w + GAP) / (widest + 18.0 + GAP)), 3, 7)

const ROW = 30.0
const GAP = 6.0

# A finger lifted on this row where it went down (not a drag that scrolled the page): in the
# panel's units, as the row is drawn
_row_press = vec2(-1e9, -1e9)
row_tapped = (r: Rect) -> bool:
    global _row_press
    m = screen_to_world(mouse_pos())
    if mouse_pressed(.left): _row_press = m
    mouse_released(.left) and contains(r, m) and contains(r, _row_press) and f64(length(m - _row_press)) < 14.0

debug_panel = (d: mut Debug, v: mut DebugView, towns: str[], craft_names: str[], craft_list: CraftEntry[] = []) -> DebugResult:
    global hud_style
    r = DebugResult()
    if not d.open: return r
    saved = hud_style
    hud_style.text_size = 16.0
    hud_style.panel = rgba(0.06, 0.08, 0.12, 0.88)
    hud_style.button = rgba(0.14, 0.17, 0.22, 1)
    hud_style.hover = rgba(0.22, 0.27, 0.34, 1)
    # (on a small screen the whole panel is drawn larger, so its type reads (readable_k); it is
    # laid out in the screen's units divided by that, and a page taller than the room scrolls)
    kz = readable_k(16.0)
    push_transform()
    scale(kz, kz)
    sw = f64(screen_width()) / kz
    sh = f64(screen_height()) / kz
    # (a controller's bumpers: a page along, its focus starting on the page itself, not the tabs;
    # turned before the panel is sized, which the Aircraft page's width changes)
    turned = ctl.tab != 0
    order = shown_pages(d)
    if turned:
        slot = 0
        loop k in 0..order.len():
            if order[k] == d.page: slot = k
        d.page = order[(slot + ctl.tab + order.len()) % order.len()]
        order = shown_pages(d)
    # (upright on a phone: the panel across the screen, so the Game page can use bigger type)
    # (the Aircraft page, on a screen wider than tall: wider, for two columns of cards)
    # (the Settings page, on a phone on its side: wide too, so the tabs take fewer rows and the
    # settings have the height)
    wide = d.page == 1 or (d.page == SETTINGS_PAGE and pad.on)
    pw = if sh > sw: sw - 32.0 else: if wide: min(sw - 32.0, 720.0) else: 400.0 * _game_k()
    x = sw - pw - 16.0
    w = pw - 24.0
    # (below the touch buttons along the top, where the panel reaches them)
    top = max(16.0, pad_top_clear(x * kz, (x + pw) * kz) / kz)
    room = sh - top - 16.0
    # (fingers get taller tabs: the Game page's scale)
    tab_h = if pad.on: max(ROW * _game_k(), tap_size(ROW, kz)) else: ROW
    per_row = tabs_per_row(w, 16.0 * tab_h / ROW)
    tab_rows = f64((order.len() + per_row - 1) / per_row)
    tabs_extra = tab_rows * (tab_h - ROW)
    rows = match d.page:
        11: 40.0
        1: 2.0 + f64(craft_names.len()) * (if sh > sw: 1.3 else: 0.7)
        10: 10.5 + f64((v.parts.len() + 1) / 2 + 1)
        2: 4.0 + f64((towns.len() + 1) / 2)
        3: 9.0
        5: 26.0
        7: 11.5
        8: 17.0
        4: 10.6
        _: 5.0
    ph = if d.page == 7: room else: min(room, 82.0 + tabs_extra + (tab_rows - 2.0) * (ROW + GAP) + rows * (ROW + GAP) + 12.0)
    if d.page == 0: ph = min(room, 36.0 + tab_rows * (tab_h + GAP) + GAP * 3.0 + game_page_height(v, w) + 12.0)
    else if d.page != 7 and d.drawn_page == d.page: ph = min(room, 36.0 + tab_rows * (tab_h + GAP) + GAP * 3.0 + d.drawn_height + 12.0)
    if d.page != 0: d.confirm = ""
    # (the keys and a controller work the boxes: each page keeps its own focus; not while the
    # Controls page waits for a control to be moved, nor in the frame that took it)
    hud_nav(not binding_now(), "pause-{d.page}")
    hud_panel(Rect(x, top, pw, ph))
    d.panel = Rect(x * kz, top * kz, pw * kz, ph * kz)
    # (where the fullscreen mark goes, at the header's right: drawn last, the last stop for the
    # keys and a controller, after the tabs and the page)
    mark_size = if pad.on: 34.0 else: 24.0
    mark_at = Rect(x + pw - mark_size - 8.0, top + 4.0, mark_size, mark_size)
    ptext(if pad.on: "Paused" else if pad_hints(): "Paused   ({key_button_name(.p, d.opts.controls)} to carry on)" else: "Paused   (P to carry on)", vec2(f32(x + 12), f32(top + 8.0)), 17, rgba(1, 0.97, 0.9, 0.9))
    y = top + 36.0
    x += 12.0
    # the pages, as tabs
    tw = (w - GAP * f64(per_row - 1)) / f64(per_row)
    # (every label whole: the type comes down if the widest would be cut short)
    size = 16.0 * tab_h / ROW
    widest = 0.0
    loop name in PAGES: widest = max(widest, text_width(name, size))
    hud_style.text_size = if widest > tw - 14.0: max(11.0, size * (tw - 14.0) / widest) else: size
    loop slot in 0..order.len():
        k = order[slot]
        tab = Rect(x + f64(slot%per_row) * (tw + GAP), y+f64(slot/per_row)*(tab_h+GAP), tw, tab_h)
        if d.focus_tab == k:
            hud_nav_focus(tab); d.focus_tab = -1
        if hud_button(tab, PAGES[k], selected = d.page == k):
            # (the new page's focus starts on its tab, where the choice was made: put there in the
            # next frame, the tabs laid out for the new page's width, as the Aircraft page's wider)
            if d.page != k: d.focus_tab = k
            d.page = k
    hud_style.text_size = 16.0
    # (the tabs, as many rows as they need)
    y += tab_rows * (tab_h + GAP) + GAP * 3.0
    content_top = y
    content_h = if d.page == 0: game_page_height(v, w) else: if d.drawn_page == d.page: d.drawn_height else: 0.0
    avail = top + ph - 12.0 - content_top
    off = 0.0
    scrolling = d.page != 7 and content_h > avail + 1.0
    if scrolling:
        box = Rect(x - 12.0, content_top, pw, avail)
        off = hud_scroll(box, content_h, "pause-{d.page}")
        clip(box)
        y -= off
    match d.page:
        0: game_page(d, v, r, x, y, w)
        9: y += paint_page(d.paint_page, v.paint, v.paint_support, v.craft, v.craft_name, x, y, w, v.paint_shop)
        6:
            loop scenario in SCENARIOS:
                if hud_button(Rect(x,y,w,ROW),scenario.name):r.scenario=scenario.key
                y+=ROW+GAP
                ptext(scenario.description,vec2(f32(x),f32(y)),14,rgba(0.82,0.85,0.9,1))
                y+=ROW+GAP*2
            ptext("Replaces the current situation. P resumes play.",vec2(f32(x),f32(y)),14,rgba(0.7,0.75,0.8,1))
            y+=20.0
        1:
            # (the aircraft: the one flying now, then every one, grouped, a card each)
            y = craft_picker(d, v, x, y, w, craft_names, craft_list, content_top - off, off, avail)
        10:
            # (the aircraft flown now: its condition, and the trial settings)
            flown = if v.craft >= 0 and v.craft < craft_names.len(): craft_names[v.craft] else: "The aircraft"
            ptext("{flown}: condition", vec2(f32(x), f32(y)), 14, rgba(0.85, 0.78, 0.55, 1))
            y += 22.0
            v.fuel = hud_slider(Rect(x, y, w, ROW), v.fuel, 0.0, 1.0, 0.05, "Fuel  {int(v.fuel * 100.0 + 0.5)}%")
            y += ROW + GAP
            third = w / 3.0
            d.infinite_fuel = hud_checkbox(Rect(x, y + 6, third - GAP, ROW - 12), "Endless fuel", d.infinite_fuel)
            d.no_damage = hud_checkbox(Rect(x + third, y + 6, third - GAP, ROW - 12), "No damage", d.no_damage)
            d.no_drag = hud_checkbox(Rect(x + third * 2.0, y + 6, third, ROW - 12), "No drag", d.no_drag)
            y += ROW + GAP
            d.endless_ammunition = hud_checkbox(Rect(x, y + 6, w * 0.56 - GAP, ROW - 12), "Endless ammunition", d.endless_ammunition)
            if hud_button(Rect(x + w * 0.56, y, w * 0.44, ROW), "Guns: {PLAYER_GUN_NAMES[d.gun_choice]}"):d.gun_choice=(d.gun_choice+1)%PLAYER_GUN_NAMES.len()
            y += ROW + GAP
            # (true speeds this many times the designed ones, turning at the designed rates)
            v.speed_scale = hud_slider(Rect(x, y, w, ROW), v.speed_scale, 1.0, 5.0, 0.1, "Speed x{v.speed_scale:.1}")
            y += ROW + GAP
            v.lift_scale = hud_slider(Rect(x, y, w, ROW), v.lift_scale, 1.0, 5.0, 0.1, "Liftoff speed x{v.lift_scale:.1}")
            y += ROW + GAP
            v.bullet_scale = hud_slider(Rect(x, y, w, ROW), v.bullet_scale, 1.0, 8.0, 0.1, "Bullet speed x{v.bullet_scale:.1}")
            y += ROW + GAP
            if hud_button(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), "Mend everything"): r.act = .repair
            if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Wreck it"): r.act = .wreck
            y += ROW + GAP * 3.0
            # (each part's health, two to a row, then the wear)
            hw = (w - GAP) * 0.5
            loop k in 0..v.parts.len():
                label = if k < PART_LABELS.len(): PART_LABELS[k] else: "Part {k}"
                shown = if v.parts[k] <= 0.0: "gone" else: "{int(v.parts[k] * 100.0 + 0.5)}%"
                v.parts[k] = hud_slider(Rect(x + f64(k % 2) * (hw + GAP), y + f64(k / 2) * (ROW + GAP), hw, ROW), v.parts[k], 0.0, 1.0, 0.05, "{label}  {shown}")
            y += f64((v.parts.len() + 1) / 2) * (ROW + GAP)
            v.hull_wear = hud_slider(Rect(x, y, hw, ROW), v.hull_wear, 0.0, 1.0, 0.05, "Airframe wear {int(v.hull_wear * 100.0 + 0.5)}%")
            v.engine_wear = hud_slider(Rect(x + hw + GAP, y, hw, ROW), v.engine_wear, 0.0, 1.0, 0.05, "Engine wear {int(v.engine_wear * 100.0 + 0.5)}%")
            y += ROW
        2:
            d.altitude = hud_slider(Rect(x, y, w, ROW), d.altitude, 0.0, 4000.0, 50.0, "Altitude  {int(d.altitude)} m")
            y += ROW + GAP
            if hud_button(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), "To it, here"): r.act = .to_altitude
            if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Pick on the chart"): r.act = .pick
            y += ROW + GAP * 3.0
            ptext("Moor at", vec2(f32(x), f32(y)), 15, rgba(1, 0.97, 0.9, 0.7))
            y += 22.0
            hw = (w - GAP) * 0.5
            loop k in 0..towns.len():
                if hud_button(Rect(x + f64(k % 2) * (hw + GAP), y + f64(k / 2) * (ROW + GAP), hw, ROW), towns[k]):
                    r.act = .to_town
                    r.town = k
            y += f64((towns.len() + 1) / 2) * (ROW + GAP) - GAP
        4:
            # (trials: off, as it was when speed 3.3 first felt right)
            ptext("Off: as it was when speed 3.3 first felt right", vec2(f32(x), f32(y + 4)), 14, rgba(1, 0.97, 0.9, 0.7))
            y += ROW
            row = (label: str, on: bool) -> bool: hud_checkbox(Rect(x, y + 6, w, ROW - 12), label, on)
            head = (label: str):
                ptext(label, vec2(f32(x), f32(y + 8)), 13, rgba(0.85, 0.78, 0.55, 1))
                rect(x + text_width(label, 13) + 10.0, y + 15.0, w - text_width(label, 13) - 10.0, 1.0, rgba(0.85, 0.78, 0.55, 0.35))
            head("Handling")
            y += ROW * 0.8
            d.tweaks.pure_scale = row("Pure speed scale (takeoff, handling by true)", d.tweaks.pure_scale)
            y += ROW + GAP
            d.tweaks.auto_trim = row("Auto-trim: let go, it holds its climb or descent", d.tweaks.auto_trim)
            y += ROW + GAP
            d.tweaks.skybarons_response = row("Sky Barons energy and response", d.tweaks.skybarons_response)
            y += ROW + GAP
            # (the flight model: 0 the liked one, 1 the trial rigid body with forces, src/flight_v2.jo)
            d.tweaks.flight_model = if row("Flight model v2: forces, soft stall", d.tweaks.flight_model == 1): 1 else: 0
            y += ROW + GAP
            head("Propeller torque")
            y += ROW * 0.8
            d.tweaks.prop_torque = row("In the air: it rolls her (not contra-rotating pairs)", d.tweaks.prop_torque)
            y += ROW + GAP
            d.tweaks.torque_swing = row("On the run: the racers swing", d.tweaks.torque_swing)
            y += ROW + GAP
            head("Combat")
            y += ROW * 0.8
            # (combat damage to the player's own aircraft is divided by this)
            d.tweaks.player_toughness = hud_slider(Rect(x, y, w, ROW), d.tweaks.player_toughness, 1.0, 3.0, 0.05, "Player toughness: damage taken / {d.tweaks.player_toughness:.2}")
            y += ROW
            # (the player's rounds hit a margin round each part; their path bent toward an obvious enemy)
            d.tweaks.generous_hits = hud_checkbox(Rect(x, y + 6, w * 0.5 - GAP, ROW - 12), "Generous hits for the player", d.tweaks.generous_hits)
            d.tweaks.aim_assist = hud_checkbox(Rect(x + w * 0.5, y + 6, w * 0.5, ROW - 12), "Aim assist (rounds curve to a target)", d.tweaks.aim_assist)
            y += ROW
            d.tweaks.hit_margin = hud_slider(Rect(x, y, w, ROW), d.tweaks.hit_margin, 0.0, 3.0, 0.05, "Player hit margin {d.tweaks.hit_margin:.2} m")
            y += ROW + GAP
            head("Look")
            y += ROW * 0.8
            d.tweaks.brighter_ocean = row("Brighter ocean (the teal sea from height)", d.tweaks.brighter_ocean)
            y += ROW
            d.tweaks.painted_layers = row("Painted layers (far land in soft steps)", d.tweaks.painted_layers)
            y += ROW
            d.tweaks.wind_study_grass = row("Wind study grass (gusts and cat's paws)", d.tweaks.wind_study_grass)
            y += ROW + GAP
            d.tweaks.wing_vapour = row("Vapour over the wings in hard pulls in damp air", d.tweaks.wing_vapour)
            y += ROW + GAP
            d.tweaks.surf = row("Surf: breaking waves and run-up on the shore, ships' white water", d.tweaks.surf)
            y += ROW + GAP

        8:
            # (the flight model, three ways: the liked one, v2 (src/flight_v2.jo), Sky Barons' own
            # (src/flight_sb.jo); and v2's numbers, live: the player's aircraft takes them at once)
            bw = (w - GAP * 2.0) / 3.0
            models = ["Liked", "v2", "Sky Barons"]
            loop m in 0..3:
                if hud_button(Rect(x + f64(m) * (bw + GAP), y, bw, ROW), models[m], selected = d.tweaks.flight_model == m): d.tweaks.flight_model = m
            y += ROW + GAP
            d.tweaks.fdm2_npcs = hud_checkbox(Rect(x, y + 6, w, ROW - 12), "The other aircraft fly v2 too", d.tweaks.fdm2_npcs)
            y += ROW + GAP
            d.tweaks.fdm2_fighters = hud_checkbox(Rect(x, y + 6, w, ROW - 12), "And a battle's fighters", d.tweaks.fdm2_fighters)
            y += ROW + GAP
            hw = (w - GAP) * 0.5
            if hud_button(Rect(x, y, hw, ROW), "v2: feel", selected = d.fdm2_tab == 0): d.fdm2_tab = 0
            if hud_button(Rect(x + hw + GAP, y, hw, ROW), "v2: Sky Barons levers", selected = d.fdm2_tab == 1): d.fdm2_tab = 1
            y += ROW + GAP
            t = d.fdm2
            slide = (value: f64, low: f64, high: f64, step: f64, label: str) -> f64:
                out = hud_slider(Rect(x, y, w, ROW), value, low, high, step, label)
                y += ROW + GAP
                out
            if d.fdm2_tab == 0:
                t.slow_lift = slide(t.slow_lift, 0.0, 2.5, 0.05, "Slow-turn lift  +{t.slow_lift:.2}")
                t.lift_boost = slide(t.lift_boost, 1.0, 2.0, 0.05, "Wing lift  x{t.lift_boost:.2}")
                t.g_limit = slide(t.g_limit, 3.0, 16.0, 0.25, "G cap  {t.g_limit:.2} g")
                t.roll = slide(t.roll, 0.4, 1.6, 0.05, "Roll authority  x{t.roll:.2}")
                t.departure = slide(t.departure, 0.0, 1.0, 0.05, "Stall softness  {t.departure:.2}")
                t.coordination = slide(t.coordination, 0.0, 1.5, 0.05, "Coordination  {t.coordination:.2}")
                t.skim = slide(t.skim, 0.0, 1.0, 0.05, "Skim hold  {t.skim:.2}")
                t.spins = if hud_checkbox(Rect(x, y + 6, w, ROW - 12), "Spins: stick back and full rudder", t.spins > 0.5): 1.0 else: 0.0
                y += ROW + GAP
            else:
                t.lift_reach = slide(t.lift_reach, 1.3, 8.0, 0.1, "Lift reach  {t.lift_reach:.1}x stall")
                t.roll_snap = slide(t.roll_snap, 0.3, 3.0, 0.05, "Roll snap  x{t.roll_snap:.2}")
                t.bank_turn = slide(t.bank_turn, 0.0, 1.0, 0.05, "Bank turn  {t.bank_turn:.2}")
                t.prop_reach = slide(t.prop_reach, 1.1, 5.0, 0.05, "Thrust at speed  {t.prop_reach:.2}")
                t.path_grip = slide(t.path_grip, 0.0, 3.0, 0.05, "Path grip  {t.path_grip:.2}/s")
                t.energy = slide(t.energy, 0.05, 1.0, 0.05, "Turn drag  {t.energy:.2}  (1 real)")
                t.power = slide(t.power, 0.8, 4.0, 0.05, "Power  x{t.power:.2}")
                if hud_button(Rect(x, y, w, ROW), "Sky Barons-like (keeps honest drag)"): t = fdm2_skybarons_like()
                y += ROW + GAP
            d.fdm2 = t
            if hud_button(Rect(x, y, hw, ROW), "Copy values"):
                set_clipboard(fdm2_tuning_text(d.fdm2))
                d.fdm2_copied = 2.0
            if hud_button(Rect(x + hw + GAP, y, hw, ROW), "Defaults"): d.fdm2 = Fdm2Tuning()
            y += ROW + GAP
            # (the same line, to read off or paste back as AEGEAN_FDM2=...)
            items = split(fdm2_tuning_text(d.fdm2), ",")
            lines = (items.len() + 3) / 4
            loop part in 0..lines:
                piece = join(items[min(part * 4, items.len())..min(part * 4 + 4, items.len())], ",")
                head = if part > 0: "" else: (if d.fdm2_copied > 0.0: "Copied: " else: "AEGEAN_FDM2=")
                ptext(head + piece + (if part < lines - 1: "," else: ""), vec2(f32(x), f32(y + 16.0 * f64(part))), 13, rgba(1, 0.97, 0.9, 0.9))
            d.fdm2_copied = max(0.0, d.fdm2_copied - 1.0 / 60.0)
            y += 16.0 * f64(lines) + 2.0

        11: y = controls_page(d.opts.controls, d.controls, x, y, w)
        5:
            # The player's settings, in sections; on a touch screen its own controls, with a mouse
            # the mouse's. Advanced settings, at the end, shows the trial and debugging pages.
            # (a finger's rows: never under 44 points tall on a touch screen, the box the whole row)
            R = tap_size(ROW, kz)
            orow = (label: str, on: bool) -> bool:
                if not pad.on: return hud_checkbox(Rect(x, y + 6, w, R - 12), label, on)
                # (the box its usual size in the row's middle; a tap anywhere on the row is it too)
                ticked = hud_checkbox(Rect(x, y + (R - 18.0) * 0.5, w, 18), label, on)
                if ticked == on and row_tapped(Rect(x, y, w, R)): not on else: ticked
            note = (words: str):
                ptext(fit_text(words, w - 26.0, 13), vec2(f32(x + 26.0), f32(y - 2.0)), 13, rgba(0.82, 0.85, 0.9, 0.85))
            section = (label: str):
                ptext(label, vec2(f32(x), f32(y + 8)), 15, rgba(0.85, 0.78, 0.55, 1))
                rect(x + text_width(label, 15) + 10.0, y + 16.0, w - text_width(label, 15) - 10.0, 1.0, rgba(0.85, 0.78, 0.55, 0.35))
            touch = pad.on
            # Display
            section("Display")
            y += R
            # (the screen itself, not a kept option: where it can be filled, F11 and the title's mark too)
            if can_fullscreen():
                full = orow("Fullscreen", is_fullscreen())
                if full != is_fullscreen(): set_fullscreen(full)
                y += R + GAP
            d.opts.music_notes = orow("Notes rising from music nearby", d.opts.music_notes)
            y += R + GAP
            d.opts.build_label = orow("Build number at the bottom of the screen", d.opts.build_label)
            y += R + GAP
            # (how fast people's words arrive in a conversation: src/speech_stream.jo)
            ptext("Text speed", vec2(f32(x), f32(y + 6.0)), 15, rgba(1, 0.97, 0.9, 0.9))
            y += 28.0
            speeds = if w >= 520.0: 4 else: 2
            speed_w = (w - GAP * f64(speeds - 1)) / f64(speeds)
            loop k in 0..TEXT_SPEEDS.len():
                at = Rect(x + f64(k % speeds) * (speed_w + GAP), y + f64(k / speeds) * (R + GAP), speed_w, R)
                if hud_button(at, TEXT_SPEED_LABELS[k], selected = d.opts.text_speed == TEXT_SPEEDS[k]): d.opts.text_speed = TEXT_SPEEDS[k]
            y += f64((TEXT_SPEEDS.len() + speeds - 1) / speeds) * (R + GAP)
            y += GAP * 2.0
            # Sound
            section("Sound")
            y += R
            d.opts.radio_volume = hud_slider(Rect(x, y, w, R), d.opts.radio_volume, 0.0, 1.0, 0.01, if d.opts.radio_volume <= 0.0: "Wireless volume: off" else: "Wireless volume {int(round(d.opts.radio_volume * 100.0))}%")
            y += R + GAP * 3.0
            # Controls
            section("Controls")
            y += R
            if not touch:
                d.opts.mouse_steers = orow("Mouse steers the aircraft", d.opts.mouse_steers)
                y += R
                note(if d.opts.mouse_steers: "Off: the mouse looks around and the keys fly." else: "The mouse looks around; Home looks ahead.")
                y += 18.0 + GAP
            d.opts.invert_y = orow("Invert looking up and down", d.opts.invert_y)
            y += R + GAP
            if touch:
                d.opts.tilt_aim = orow("Tilt the phone to fine-tune the aim", d.opts.tilt_aim)
                y += R + GAP
                if d.opts.tilt_aim:
                    d.opts.tilt_gain = hud_slider(Rect(x, y, w, R), d.opts.tilt_gain, 0.3, 3.0, 0.1, "Tilt sensitivity x{d.opts.tilt_gain:.1}")
                    y += R + GAP
                d.opts.walk_left = orow("Walk button on the left", d.opts.walk_left)
                y += R + GAP
            else:
                d.opts.scroll_speed = hud_slider(Rect(x, y, w, R), d.opts.scroll_speed, 0.25, 2.0, 0.05, "Scroll speed x{d.opts.scroll_speed:.2}")
                y += R + GAP
            if hud_button(Rect(x, y, w, R), "Gamepads and flight sticks"):
                d.page = CONTROLS_PAGE; d.focus_tab = CONTROLS_PAGE
            y += R + GAP * 3.0
            # Accessibility
            section_top = y + off - content_top
            section("Accessibility")
            y += R
            d.opts.guidance = orow("Hints for a new pilot", d.opts.guidance)
            y += R
            note("A welcome on the dock and a note in the cockpit.")
            y += 18.0 + GAP
            d.opts.tipsy_sway = orow("A gentle sway after a few drinks", d.opts.tipsy_sway)
            y += R + GAP
            # (how the sides' colours are told apart: a palette for each kind of colour vision,
            # src/side_colours.jo; the three signs beside it, in the palette chosen)
            ptext("Colours of the sides", vec2(f32(x), f32(y + 6.0)), 15, rgba(1, 0.97, 0.9, 0.9))
            # (from the right: each side's sign, then its name in its colour)
            sx = x + w
            loop k in 0..3:
                st = [Standing.neutral, Standing.ally, Standing.enemy][k]
                name = ["Other", "Friend", "Enemy"][k]
                sx -= ptext_width(name, 12)
                ptext(name, vec2(f32(sx), f32(y + 7.0)), 12, side_colour(st))
                side_sign(vec2(f32(sx - 10.0), f32(y + 14.0)), st)
                sx -= 30.0
            y += 28.0
            per = if w >= 520.0: 4 else: 2
            cw = (w - GAP * f64(per - 1)) / f64(per)
            loop k in 0..COLOUR_VISIONS.len():
                at = Rect(x + f64(k % per) * (cw + GAP), y + f64(k / per) * (R + GAP), cw, R)
                if hud_button(at, COLOUR_VISION_LABELS[k], selected = d.opts.colour_vision == COLOUR_VISIONS[k]): d.opts.colour_vision = COLOUR_VISIONS[k]
            y += f64((COLOUR_VISIONS.len() + per - 1) / per) * (R + GAP)
            y += 16.0
            note(match d.opts.colour_vision:
                .standard: "Enemies red-orange, friends blue."
                .red_green: "Enemies orange, friends blue."
                .blue_yellow: "Enemies red, friends teal."
                .monochrome: "By shape too: enemy a chevron, friend a ring.")
            y += 6.0 + GAP * 3.0
            # Character
            section("Character")
            y += R
            d.opts.small_talk = orow("Your pilot makes small talk", d.opts.small_talk)
            y += R
            note("He answers a remark now and then, from what he's done.")
            y += 18.0 + GAP * 3.0
            if d.reveal == "accessibility": hud_scroll_reveal("pause-{d.page}", section_top, y + off - content_top)
            # Sandbox: playing more freely, each a switch of its own, each off (src/sandbox.jo)
            section_top = y + off - content_top
            section("Sandbox")
            y += R
            d.opts.sandbox.paint_anywhere = orow("Paint the aircraft anywhere, at any time", d.opts.sandbox.paint_anywhere)
            y += R + GAP
            d.opts.sandbox.any_aircraft = orow("Any aircraft at any time", d.opts.sandbox.any_aircraft)
            y += R
            note("Adds the Aircraft page to this menu.")
            y += 18.0 + GAP
            d.opts.sandbox.unlimited_money = orow("Unlimited money", d.opts.sandbox.unlimited_money)
            y += R
            note("Switched off, you have your own purse again.")
            y += 18.0 + GAP
            d.opts.sandbox.no_damage = orow("No damage", d.opts.sandbox.no_damage)
            y += R + GAP
            d.opts.sandbox.no_fuel_use = orow("No fuel use", d.opts.sandbox.no_fuel_use)
            y += R + GAP
            d.opts.sandbox.endless_ammunition = orow("Endless ammunition", d.opts.sandbox.endless_ammunition)
            y += R + GAP * 3.0
            if d.reveal == "sandbox": hud_scroll_reveal("pause-{d.page}", section_top, y + off - content_top)
            # Advanced
            section("Advanced")
            y += R
            d.opts.advanced = orow("Advanced settings", d.opts.advanced)
            y += R
            note("Trials and testing: any aircraft, places, the world, the flight model.")
            y += 18.0

        7:
            # Small screens paginate the complete library; controls always stay visible.
            count = clamp(int((sh-y-190.0-ROW-GAP)/58.0),1,MUSIC_PIECES.len())
            pages = (MUSIC_PIECES.len()+count-1)/count
            d.music_page = clamp(d.music_page,0,pages-1)
            if pages > 1:
                if hud_button(Rect(x,y,70,ROW),"<"): d.music_page = (d.music_page+pages-1)%pages
                ptext("Library {d.music_page+1}/{pages}",vec2(f32(x+85),f32(y+7)),15,rgba(1,1,1,0.8))
                if hud_button(Rect(x+w-70,y,70,ROW),">"): d.music_page = (d.music_page+1)%pages
                y += ROW+GAP
            hud_style.text_size = 13.0
            loop k in d.music_page*count..min(MUSIC_PIECES.len(),(d.music_page+1)*count):
                piece = MUSIC_PIECES[k]
                if hud_button(Rect(x,y,w,26),piece.title,selected=d.music.piece == k): music_audition_select(d.music,k)
                ptext(fit_text(piece.composer+" / "+piece.station,w-8,readable(11.0)),vec2(f32(x+4),f32(y+29)),readable(11.0),rgba(1,0.97,0.9,0.75))
                y += 58.0
            hud_style.text_size = 16.0
            if hud_button(Rect(x,y,w*0.32,ROW),if d.music.playing: "Stop" else: "Play",selected=d.music.playing):
                if d.music.playing: d.music.playing = false
                else:
                    if d.music.position >= music_duration(d.music): music_audition_seek(d.music,0)
                    d.music.playing = true
            chain = hud_checkbox(Rect(x+w*0.36,y+6,w*0.64,ROW-12),"Through the wireless",d.music.through_radio)
            if chain != d.music.through_radio:
                d.music.through_radio = chain; d.music.dirty = true
            y += ROW+GAP
            levelling = hud_checkbox(Rect(x,y+6,w,ROW-12),"Station levelling",d.music.station_levelling)
            if levelling != d.music.station_levelling:
                d.music.station_levelling = levelling; d.music.dirty = true
            y += ROW+GAP
            if d.music.through_radio:
                d.music.strength = hud_slider(Rect(x,y,w,ROW),d.music.strength,0.05,1.0,0.01,"Signal strength {int(d.music.strength*100)}%")
                y += ROW+GAP
            pos = d.music.position; duration = music_duration(d.music)
            clock = (v: f64) -> str: "{int(v)/60}:{int(v)%60:02}"
            seek = hud_slider(Rect(x,y,w,ROW),pos,0.0,duration,0.01,clock(pos)+" / "+clock(duration))
            if abs(seek-pos) > 0.005: music_audition_seek(d.music,seek)
            y += ROW+GAP
            d.music.volume = hud_slider(Rect(x,y,w,ROW),d.music.volume,0.0,1.0,0.01,"Listening volume {int(d.music.volume*100)}%")

        _:
            v.hour = hud_slider(Rect(x, y, w, ROW), v.hour, 0.0, 24.0, 0.25, "Hour  {int(v.hour):02}:{int((v.hour - floor(v.hour)) * 60.0):02}")
            y += ROW + GAP
            weather_label = if d.weather_choice < 0: "Living" else: WEATHER_LABELS[d.weather_choice]
            if hud_button(Rect(x,y,w,ROW),"Set weather: {weather_label}  >"):
                d.weather_choice = (d.weather_choice+1)%WEATHER_LABELS.len()
                r.weather = d.weather_choice
            y += ROW + GAP
            v.wind = hud_slider(Rect(x, y, w, ROW), v.wind, -15.0, 25.0, 1.0, "Wind  {v.wind_now:.0} m/s  ({v.wind:+.0})")
            y += ROW + GAP
            v.sea_rough = hud_slider(Rect(x, y, w, ROW), v.sea_rough, 0.0, 3.0, 0.1, "Sea  x{v.sea_rough:.1}  (0 glassy, 1 as the wind makes it)")
            y += ROW + GAP
            if hud_button(Rect(x,y,92,ROW),"Sounds...",selected=d.snd_more): d.snd_more = not d.snd_more
            sw3 = (w - 100.0) / 3.0
            d.snd_air = hud_checkbox(Rect(x + 100.0, y + 6, sw3 - GAP, ROW - 12), "Air", d.snd_air)
            d.snd_cloth = hud_checkbox(Rect(x + 100.0 + sw3, y + 6, sw3 - GAP, ROW - 12), "Cloth", d.snd_cloth)
            d.snd_frame = hud_checkbox(Rect(x + 100.0 + sw3 * 2.0, y + 6, sw3, ROW - 12), "Airframe", d.snd_frame)
            y += ROW + GAP
            if d.snd_more:
                loop row in 0..3:
                    loop col in 0..3:
                        k = row*3+col
                        d.snd_world[k] = hud_checkbox(Rect(x+f64(col)*w/3,y+6,w/3-GAP,ROW-12),AMBIENCE_LABELS[k],d.snd_world[k])
                    y += ROW + GAP
            else:
                y += GAP*2
                ptext("Purse {phoenix_text(v.phoenixes * 100)}", vec2(f32(x), f32(y)), 17, rgba(1, 0.97, 0.9, 0.9))
                y += 26.0
                d.purse_text = hud_text_field(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), d.purse_text, "phoenixes", 9, "purse")
                if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Set") or (hud_focused("purse") and hud_submitted()):
                    if let n = to_int(d.purse_text):
                        r.act = .money_set
                        r.phoenixes = n
                y += ROW + GAP
                if hud_button(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), "Purse +1000"): r.act = .money_add
                if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Every map"): r.act = .maps_all
                y += ROW + GAP * 2.0
                # (or some of them: a box for each map, ticked where he has a copy; a tick hands one
                # over from a shop's counter, unticking puts back one handed over here)
                if v.maps.len() > 0:
                    ptext("Maps", vec2(f32(x), f32(y)), 15, rgba(1, 0.97, 0.9, 0.7))
                    y += 22.0
                    loop mp in v.maps:
                        on = hud_checkbox(Rect(x, y + 6, w, ROW - 12), mp.title, mp.owned)
                        if on != mp.owned:
                            r.act = .map_one; r.map_edition = mp.edition; r.map_on = on
                        y += ROW

    if scrolling: no_clip()
    if turned: hud_nav_focus(Rect(x - 12.0, content_top, pw, max(avail, 1.0)))
    d.drawn_page = d.page
    d.drawn_height = y + off - content_top
    # (the fullscreen mark, where the screen can be filled: the menu stays open; Escape, B or Back
    # still close the menu, not the fullscreen, but where a browser takes Escape itself to leave it)
    if can_fullscreen(): _ = fullscreen_mark(mark_at, 1.0)
    pop_transform()
    hud_style = saved
    hud_nav(false)
    r

# ---------------- the Aircraft page: the picker ----------------

# (a finger needs taller cards than a mouse)
_card_h = () -> f64: if pad.on: 54.0 else: 44.0

# one card: the silhouette, the name and year, what it is, and what it needs
_craft_card = (e: CraftEntry, x: f64, y: f64, w: f64, h: f64, chosen: bool, focused: bool) -> bool:
    picked = hud_button(Rect(x, y, w, h), "", selected = chosen)
    if focused: rect_outline(x - 2.0, y - 2.0, w + 4.0, h + 4.0, 1.5, rgba(1, 0.97, 0.9, 0.9))
    ink = rgba(1, 0.97, 0.9, if chosen: 1.0 else: 0.9)
    icon_w = min(h * 1.25, w * 0.2)
    draw_craft_plan(e.plan, x + 6.0, y + 5.0, icon_w, h - 10.0, rgba(0.92, 0.88, 0.76, if chosen: 0.95 else: 0.75))
    tx = x + icon_w + 14.0
    room = x + w - 8.0 - tx
    big = if pad.on: 17.0 else: 15.0
    small = if pad.on: 14.0 else: 12.0
    year_w = if e.year != "": text_width(e.year, small) + 8.0 else: 0.0
    # (what it needs: beside the name where the name leaves room, else at the end of the role line)
    badge = craft_needs_words(e.needs)
    badge_w = if badge != "": text_width(badge, small) + 12.0 else: 0.0
    on_top = badge != "" and text_width(e.name, big) + 10.0 + badge_w + year_w <= room
    name_room = room - year_w - (if on_top: badge_w else: 0.0)
    text(fit_text(e.name, name_room, big), vec2(f32(tx), f32(y + h * 0.5 - big - 1.0)), big, ink)
    if e.year != "": text(e.year, vec2(f32(x + w - 8.0 - text_width(e.year, small)), f32(y + h * 0.5 - big + 1.0)), small, rgba(0.85, 0.78, 0.55, 1))
    amber = rgba(0.95, 0.72, 0.42, 1)
    if on_top: text(badge, vec2(f32(x + w - 8.0 - year_w - text_width(badge, small)), f32(y + h * 0.5 - big + 1.0)), small, amber)
    role_room = room - (if badge != "" and not on_top: badge_w else: 0.0)
    text(fit_text(e.role, role_room, small), vec2(f32(tx), f32(y + h * 0.5 + 2.0)), small, rgba(0.78, 0.82, 0.88, 1))
    if badge != "" and not on_top: text(badge, vec2(f32(x + w - 8.0 - text_width(badge, small)), f32(y + h * 0.5 + 2.0)), small, amber)
    picked

# The aircraft picker: what is flying now, then every aircraft under its group's heading, in two
# columns where the panel is wide enough (one on a phone held upright). A tap or a click switches
# to that one (as the grid did: docked, on a buoy or on the airfield's stand, as it needs); the
# arrow keys move across and down the cards, Enter switches. Returns where the page goes on.
craft_picker = (d: mut Debug, v: mut DebugView, x: f64, y0: f64, w: f64, names: str[], list: CraftEntry[], page_top: f64, off: f64, avail: f64) -> f64:
    y = y0
    if list.len() == 0: return y
    cols = if w >= 520.0: 2 else: 1
    cw = (w - GAP * f64(cols - 1)) / f64(cols)
    ch = _card_h()
    head_h = if v.craft >= 0 and v.craft < list.len(): (if pad.on: 74.0 else: 64.0) + GAP * 2.0 else: 0.0
    # (where each card goes, worked out first, so the keys can move across and down the grid)
    kinds: int[]
    at: vec2[]
    heads: (int, f64)[]
    py = y + head_h
    loop g in 0..CRAFT_GROUPS.len():
        members = [loop e in list: if e.group == g: e.kind]
        if members.len() == 0: continue
        heads.push((g, py))
        py += 24.0
        loop i in 0..members.len():
            kinds.push(members[i])
            at.push(vec2(f32(x + f64(i % cols) * (cw + GAP)), f32(py + f64(i / cols) * (ch + 4.0))))
        py += f64((members.len() + cols - 1) / cols) * (ch + 4.0) + GAP * 2.0
    # the keys: up and down to the nearest card above or below, left and right along the row
    moves = [(Key.down, 0), (Key.up, 1), (Key.right, 2), (Key.left, 3)]
    loop m in moves:
        if not key_pressed(m.0): continue
        if d.craft_focus < 0: d.craft_focus = v.craft; continue
        from = index_of(kinds, d.craft_focus) ?? 0
        here = at[from]
        best = -1
        score = 1e9
        loop j in 0..kinds.len():
            dx = f64(at[j].x - here.x)
            dy = f64(at[j].y - here.y)
            ok = match m.1:
                0: dy > 1.0
                1: dy < -1.0
                2: abs(dy) < 1.0 and dx > 1.0
                _: abs(dy) < 1.0 and dx < -1.0
            if not ok: continue
            sc = if m.1 < 2: abs(dy) * 4.0 + abs(dx) else: abs(dx)
            if sc < score: score = sc; best = j
        if best >= 0:
            d.craft_focus = kinds[best]
            d.craft_focus_moved = true
    if d.craft_focus >= 0 and key_pressed(.enter): v.craft = d.craft_focus
    # (flying now)
    if v.craft >= 0 and v.craft < list.len():
        e = list[v.craft]
        h = if pad.on: 74.0 else: 64.0
        rect_rounded(x, y, w, h, 6, rgba(1, 1, 1, 0.06))
        draw_craft_plan(e.plan, x + 8.0, y + 6.0, h * 1.35, h - 12.0, rgba(0.95, 0.9, 0.78, 0.95))
        tx = x + h * 1.35 + 20.0
        room = x + w - 10.0 - tx
        # (the paint it wears: a click opens the Paint page, its period paints there among the liveries)
        if v.paint_name != "":
            bw = min(240.0, w * 0.42)
            room -= bw + 8.0
            label = "Paint: {v.paint_name}"
            if hud_button(Rect(x + w - bw - 8.0, y + (h - ROW) * 0.5, bw, ROW), fit_text(label, bw - 12.0, 14)): d.page = PAINT_PAGE
        text("Flying now", vec2(f32(tx), f32(y + 6.0)), 12, rgba(0.85, 0.78, 0.55, 1))
        text(fit_text(e.name, room, 18), vec2(f32(tx), f32(y + 20.0)), 18, rgba(1, 0.97, 0.9, 1))
        line = e.role + (if e.year != "": ", " + e.year else: "")
        text(fit_text(line, room, 13), vec2(f32(tx), f32(y + 42.0)), 13, rgba(0.82, 0.85, 0.9, 1))
        badge = craft_needs_words(e.needs)
        if badge != "" and h > 64.0: text(badge, vec2(f32(tx), f32(y + 58.0)), 12, rgba(0.95, 0.72, 0.42, 1))
        else if badge != "": text(badge, vec2(f32(x + w - 10.0 - text_width(badge, 12)), f32(y + 6.0)), 12, rgba(0.95, 0.72, 0.42, 1))
    # (the groups' headings, and every card)
    loop hd in heads:
        text(CRAFT_GROUPS[hd.0], vec2(f32(x), f32(hd.1 + 4.0)), 13, rgba(0.85, 0.78, 0.55, 1))
        tw = text_width(CRAFT_GROUPS[hd.0], 13)
        rect(x + tw + 10.0, hd.1 + 11.0, w - tw - 10.0, 1.0, rgba(0.85, 0.78, 0.55, 0.35))
    loop j in 0..kinds.len():
        k = kinds[j]
        cx = f64(at[j].x)
        cy = f64(at[j].y)
        if _craft_card(list[k], cx, cy, cw, ch, v.craft == k, d.craft_focus == k):
            v.craft = k
            d.craft_focus = k
        # (the keys moved here: the page scrolls to keep the card in view)
        if d.craft_focus == k and d.craft_focus_moved:
            d.craft_focus_moved = false
            # (the page's own scroll, just enough to show the card and a little around it)
            rel = cy - page_top
            hud_scroll_reveal("pause-1", rel - 40.0, rel + ch + 40.0)
    py + GAP

# (typing into the panel's field: the game's keys left alone)
debug_typing = () -> bool: hud_focused("purse") or hud_focused("tail-number")

# ---------------- the Game page: the three saved games ----------------

# (on a phone the page's type and buttons are bigger, to read and tap: much bigger held upright,
# where there is room down the screen, a little on its side, where three slots must still fit)
_game_k = () -> f64: if screen_height() > screen_width(): 1.45 else: if pad.on: 1.15 else: 1.0
# (a finger needs taller buttons than a mouse)
_game_button_h = () -> f64: (if pad.on: 42.0 else: ROW) * _game_k()
_game_card_h = () -> f64: 90.0 * _game_k() + _game_button_h() + 8.0

# words broken into lines no wider than `width` at `size`
_game_wrap = (s: str, size: f64, width: f64) -> str[]:
    lines: str[]
    line = ""
    loop word in s.split(" "):
        next = if line == "": word else: line + " " + word
        if line != "" and ptext_width(next, size) > width:
            lines.push(line); line = word
        else: line = next
    if line != "": lines.push(line)
    lines

_game_notes = (v: DebugView, w: f64) -> str[]:
    size = 14.0 * _game_k()
    notes: str[]
    if not v.game_ready: notes.push("Opening saved games...")
    if v.game_note != "": notes += _game_wrap(v.game_note, size, w)
    if v.autosave_note != "": notes += _game_wrap(v.autosave_note, size, w)
    notes

game_page_height = (v: DebugView, w: f64) -> f64:
    f64(max(v.games.len(), 3)) * (_game_card_h() + GAP) + GAP + f64(_game_notes(v, w).len()) * 19.0 * _game_k()

game_page = (d: mut Debug, v: DebugView, r: mut DebugResult, x: f64, y0: f64, w: f64):
    global hud_style
    k = _game_k()
    hud_style.text_size = 16.0 * k
    y = y0
    bh = _game_button_h()
    ch = _game_card_h()
    big = 16.0 * k
    body = 14.0 * k
    small = 13.0 * k
    at = (px: f64, py: f64) -> vec2: vec2(f32(px), f32(py))
    cream = rgba(1, 0.97, 0.9, 0.95)
    soft = rgba(0.82, 0.85, 0.9, 1)
    muted = rgba(0.7, 0.75, 0.8, 1)
    warn = rgba(1, 0.75, 0.6, 1)
    can_act = v.game_ready and not v.game_busy
    if not can_act: d.confirm = ""
    loop row in v.games:
        rect_rounded(x, y, w, ch, 6, rgba(1, 1, 1, if row.autosave: 0.09 else: 0.05))
        ix = x + 10.0
        iw = w - 20.0
        ptext("Slot {row.slot + 1}", at(ix, y + 8.0 * k), big, cream)
        if row.autosave:
            tag = "Autosaves here"
            ptext(tag, at(ix + iw - ptext_width(tag, small), y + 10.0 * k), small, rgba(0.85, 0.78, 0.55, 1))
        by = y + 90.0 * k
        if d.confirm != "" and d.confirm_slot == row.slot:
            question = match d.confirm:
                "save": "Save over slot {row.slot + 1}?"
                "load": "Load slot {row.slot + 1}?"
                _: "Delete slot {row.slot + 1}?"
            consequence = match d.confirm:
                "save": "What it holds now will be replaced."
                "load": "Anything you haven't saved will be lost."
                _: "It can't be brought back."
            yes = match d.confirm:
                "save": "Yes, save"
                "load": "Yes, load"
                _: "Yes, delete"
            ptext(question, at(ix, y + 34.0 * k), big, rgba(1, 0.9, 0.7, 1))
            ptext(consequence, at(ix, y + 58.0 * k), body, soft)
            hw = (iw - GAP) * 0.5
            if hud_button(Rect(ix, by, hw, bh), yes, enabled = can_act):
                r.game = d.confirm; r.game_slot = row.slot; d.confirm = ""
            if hud_button(Rect(ix + hw + GAP, by, hw, bh), "Cancel"): d.confirm = ""
        else:
            if not row.exists:
                ptext("Empty", at(ix, y + 34.0 * k), body, muted)
                if row.problem != "": ptext(row.problem, at(ix, y + 52.0 * k), small, warn)
            else:
                ptext(row.time, at(ix, y + 32.0 * k), body, soft)
                ptext(row.place, at(ix, y + 50.0 * k), body, soft)
                if row.problem != "": ptext(row.problem, at(ix, y + 68.0 * k), small, warn)
                else: ptext(row.detail, at(ix, y + 68.0 * k), body, soft)
            tw = (iw - GAP * 2.0) / 3.0
            if hud_button(Rect(ix, by, tw, bh), "Save here", enabled = can_act):
                if row.exists: d.confirm = "save"; d.confirm_slot = row.slot
                else: r.game = "save"; r.game_slot = row.slot
            if hud_button(Rect(ix + tw + GAP, by, tw, bh), "Load", enabled = can_act and row.usable):
                d.confirm = "load"; d.confirm_slot = row.slot
            if hud_button(Rect(ix + (tw + GAP) * 2.0, by, tw, bh), "Delete", enabled = can_act and row.exists):
                d.confirm = "delete"; d.confirm_slot = row.slot
        y += ch + GAP
    y += GAP
    loop note in _game_notes(v, w):
        ptext(note, at(x, y), body, muted)
        y += 19.0 * k
    hud_style.text_size = 16.0
