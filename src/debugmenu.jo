# The pause menu, which (while this is in development) is a panel of debugging switches and
# settings, worked with the mouse only so no key meant for flying moves it. Three pages:
#   Aircraft  which one, fuel, endless fuel, no damage, no drag, each part's health, the wear on it
#   Place     any harbor, any altitude, anywhere on the chart
#   World     the hour, the wind, how fast the near sea and ground stream past, money
# The game fills a DebugView with how things are; the panel changes it in place and says what
# else was asked for; the game applies the differences.

struct Debug:
    open = false
    page = 0
    infinite_fuel = false
    no_damage = false
    no_drag = false
    altitude = 300.0
    picking = false                 # the next click on the chart is where to go
    lire_text = ""
    snd_air = true                  # (sounds on or off, to hear each kind alone)
    snd_cloth = true
    snd_frame = true

# how things are now (the panel edits these)
struct DebugView:
    craft = 0                       # 0 Gull, 1 Heron, 2 Corsair, 3 Falco
    fuel = 1.0                      # share of a full tank
    parts: f64[]                    # each part's health, 0 (gone) .. 1
    hull_wear = 0.0                 # the world's wear on it, 0 new .. 1 worn out
    engine_wear = 0.0
    hour = 12.0
    wind = 0.0                      # added to the weather's wind, m/s
    wind_now = 0.0                  # (what the wind is now, for showing)
    lire = 0
    boost = 3.0                     # how much faster the near sea and ground stream past
    speed_scale = 1.0               # how many times faster than designed the aircraft fly
    camera_rises = false            # the chase camera rises as it falls back
    speed_mode = 1                  # which trick for the feel of speed (look.jo SPEED_MODES)

enum DebugAct: none, repair, wreck, money_add, money_set, to_town, to_altitude, pick

struct DebugResult:
    act: DebugAct = .none
    town = -1
    lire = 0

PART_LABELS = ["Body", "Engine", "Left wing", "Right wing", "Left float", "Right float", "Tail"]
PAGES = ["Aircraft", "Place", "World"]
SPEED_TRICKS = ["Off", "Detail", "Sea", "Stretch"]     # (look.jo speed_mode)

const ROW = 30.0
const GAP = 6.0

debug_panel = (d: mut Debug, v: mut DebugView, towns: str[], craft_names: str[]) -> DebugResult:
    global hud_style
    r = DebugResult()
    if not d.open: return r
    saved = hud_style
    hud_style.text_size = 16.0
    hud_style.panel = rgba(0.06, 0.08, 0.12, 0.88)
    hud_style.button = rgba(0.14, 0.17, 0.22, 1)
    hud_style.hover = rgba(0.22, 0.27, 0.34, 1)
    sw = f64(screen_width())
    sh = f64(screen_height())
    pw = 400.0
    x = sw - pw - 16.0
    w = pw - 24.0
    rows = match d.page:
        0: 8.0 + f64(v.parts.len() + 2)
        1: 4.0 + f64((towns.len() + 1) / 2)
        _: 10.0
    ph = min(sh - 32.0, 46.0 + rows * (ROW + GAP) + 12.0)
    hud_panel(Rect(x, 16, pw, ph))
    text("Paused   (P to carry on)", vec2(f32(x + 12), 24), 17, rgba(1, 0.97, 0.9, 0.9))
    y = 52.0
    x += 12.0
    # the pages, as tabs
    tw = (w - GAP * 2.0) / 3.0
    loop k in 0..PAGES.len():
        if hud_button(Rect(x + f64(k) * (tw + GAP), y, tw, ROW), PAGES[k], selected = d.page == k): d.page = k
    y += ROW + GAP * 3.0
    match d.page:
        0:
            cw = (w - GAP * 3.0) / 4.0
            loop k in 0..craft_names.len():
                if hud_button(Rect(x + f64(k) * (cw + GAP), y, cw, ROW), craft_names[k], selected = v.craft == k): v.craft = k
            y += ROW + GAP
            v.fuel = hud_slider(Rect(x, y, w, ROW), v.fuel, 0.0, 1.0, 0.05, "Fuel  {int(v.fuel * 100.0 + 0.5)}%")
            y += ROW + GAP
            third = w / 3.0
            d.infinite_fuel = hud_checkbox(Rect(x, y + 6, third - GAP, ROW - 12), "Endless fuel", d.infinite_fuel)
            d.no_damage = hud_checkbox(Rect(x + third, y + 6, third - GAP, ROW - 12), "No damage", d.no_damage)
            d.no_drag = hud_checkbox(Rect(x + third * 2.0, y + 6, third, ROW - 12), "No drag", d.no_drag)
            y += ROW + GAP
            # (true speeds this many times the designed ones, turning at the designed rates)
            v.speed_scale = hud_slider(Rect(x, y, w, ROW), v.speed_scale, 1.0, 2.2, 0.1, "Speed x{v.speed_scale:.1}  ({int(66.0 * v.speed_scale * 3.6)} km/h)")
            y += ROW + GAP
            v.camera_rises = hud_checkbox(Rect(x, y + 6, w, ROW - 12), "Camera rises as it falls back with speed", v.camera_rises)
            y += ROW + GAP
            if hud_button(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), "Mend everything"): r.act = .repair
            if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Wreck it"): r.act = .wreck
            y += ROW + GAP * 3.0
            loop k in 0..v.parts.len():
                label = if k < PART_LABELS.len(): PART_LABELS[k] else: "Part {k}"
                shown = if v.parts[k] <= 0.0: "gone" else: "{int(v.parts[k] * 100.0 + 0.5)}%"
                v.parts[k] = hud_slider(Rect(x, y, w, ROW), v.parts[k], 0.0, 1.0, 0.05, "{label}  {shown}")
                y += ROW + GAP
            v.hull_wear = hud_slider(Rect(x, y, w, ROW), v.hull_wear, 0.0, 1.0, 0.05, "Airframe wear  {int(v.hull_wear * 100.0 + 0.5)}%")
            y += ROW + GAP
            v.engine_wear = hud_slider(Rect(x, y, w, ROW), v.engine_wear, 0.0, 1.0, 0.05, "Engine wear  {int(v.engine_wear * 100.0 + 0.5)}%")
        1:
            d.altitude = hud_slider(Rect(x, y, w, ROW), d.altitude, 0.0, 4000.0, 50.0, "Altitude  {int(d.altitude)} m")
            y += ROW + GAP
            if hud_button(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), "To it, here"): r.act = .to_altitude
            if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Pick on the chart"): r.act = .pick
            y += ROW + GAP * 3.0
            text("Moor at", vec2(f32(x), f32(y)), 15, rgba(1, 0.97, 0.9, 0.7))
            y += 22.0
            hw = (w - GAP) * 0.5
            loop k in 0..towns.len():
                if hud_button(Rect(x + f64(k % 2) * (hw + GAP), y + f64(k / 2) * (ROW + GAP), hw, ROW), towns[k]):
                    r.act = .to_town
                    r.town = k
        _:
            v.hour = hud_slider(Rect(x, y, w, ROW), v.hour, 0.0, 24.0, 0.25, "Hour  {int(v.hour):02}:{int((v.hour - floor(v.hour)) * 60.0):02}")
            y += ROW + GAP
            v.wind = hud_slider(Rect(x, y, w, ROW), v.wind, -15.0, 25.0, 1.0, "Wind  {v.wind_now:.0} m/s  ({v.wind:+.0})")
            y += ROW + GAP
            v.boost = hud_slider(Rect(x, y, w, ROW), v.boost, 1.0, 6.0, 0.25, "Near speed  x{v.boost:.2}")
            y += ROW + GAP
            text("Speed trick", vec2(f32(x), f32(y + 6)), 15, rgba(1, 0.97, 0.9, 0.7))
            mw = (w - 100.0 - GAP * 3.0) / 4.0
            loop k in 0..SPEED_TRICKS.len():
                if hud_button(Rect(x + 100.0 + f64(k) * (mw + GAP), y, mw, ROW), SPEED_TRICKS[k], selected = v.speed_mode == k): v.speed_mode = k
            y += ROW + GAP
            text("Sounds", vec2(f32(x), f32(y + 6)), 15, rgba(1, 0.97, 0.9, 0.7))
            sw3 = (w - 100.0) / 3.0
            d.snd_air = hud_checkbox(Rect(x + 100.0, y + 6, sw3 - GAP, ROW - 12), "Air", d.snd_air)
            d.snd_cloth = hud_checkbox(Rect(x + 100.0 + sw3, y + 6, sw3 - GAP, ROW - 12), "Cloth", d.snd_cloth)
            d.snd_frame = hud_checkbox(Rect(x + 100.0 + sw3 * 2.0, y + 6, sw3, ROW - 12), "Airframe", d.snd_frame)
            y += ROW + GAP * 3.0
            text("{v.lire} lire", vec2(f32(x), f32(y)), 17, rgba(1, 0.97, 0.9, 0.9))
            y += 26.0
            d.lire_text = hud_text_field(Rect(x, y, w * 0.5 - GAP * 0.5, ROW), d.lire_text, "lire", 9, "lire")
            if hud_button(Rect(x + w * 0.5 + GAP * 0.5, y, w * 0.5 - GAP * 0.5, ROW), "Set") or (hud_focused("lire") and hud_submitted()):
                if let n = to_int(d.lire_text):
                    r.act = .money_set
                    r.lire = n
            y += ROW + GAP
            if hud_button(Rect(x, y, w, ROW), "+1000 lire"): r.act = .money_add
    hud_style = saved
    r

# (typing into the panel's field: the game's keys left alone)
debug_typing = () -> bool: hud_focused("lire")
