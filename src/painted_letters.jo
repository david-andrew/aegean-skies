# The same compact procedural engraver's alphabet as the cockpit instruments.
# Painted quads stand a real distance in front of a board's solid front face.
painted_glyph = (c:str) -> int[]:
    match c:
        "A":[2,5,7,5,5]
        "B":[6,5,6,5,6]
        "C":[3,4,4,4,3]
        "D":[6,5,5,5,6]
        "E":[7,4,6,4,7]
        "F":[7,4,6,4,4]
        "G":[3,4,5,5,3]
        "H":[5,5,7,5,5]
        "I":[7,2,2,2,7]
        "J":[1,1,1,5,2]
        "Q":[2,5,5,3,1]
        "X":[5,5,2,5,5]
        "Z":[7,1,2,4,7]
        ".":[0,0,0,0,2]
        "K":[5,5,6,5,5]
        "L":[4,4,4,4,7]
        "M":[5,7,7,5,5]
        "N":[5,7,7,7,5]
        "O":[2,5,5,5,2]
        "P":[6,5,6,4,4]
        "R":[6,5,6,5,5]
        "S":[3,4,2,1,6]
        "T":[7,2,2,2,2]
        "U":[5,5,5,5,7]
        "V":[5,5,5,5,2]
        "W":[5,5,7,7,5]
        "Y":[5,5,2,2,2]
        "0":[7,5,5,5,7]
        "1":[2,6,2,2,7]
        "2":[6,1,2,4,7]
        "3":[6,1,2,1,6]
        "4":[5,5,7,1,1]
        "5":[7,4,6,1,6]
        "6":[3,4,6,5,2]
        "7":[7,1,2,2,2]
        "8":[2,5,2,5,2]
        "9":[2,5,3,1,6]
        _:[0,0,0,0,0]

painted_letters=(vs:mut Vertex3D[],label:str,at:vec3,height:f64,col:vec4,m:mat4=mat4()):
    letters=split(label.upper(),"");unit=height/5.0
    normal=transform_dir(m,vec3(0,0,1))
    loop i in 0..letters.len():
        rows=painted_glyph(letters[i])
        loop row in 0..5:
            loop x in 0..3:
                if (rows[row] & (1 << (2-x)))==0:continue
                p=at+vec3((f64(i)*4+f64(x)-f64(letters.len()*4)*0.5)*unit,(2.0-f64(row))*unit,0)
                a=p;b=p+vec3(unit*0.85,0,0);c=p+vec3(unit*0.85,unit*0.85,0);d=p+vec3(0,unit*0.85,0)
                loop q in [a,b,c,a,c,d]:vs.push(Vertex3D(transform_point(m,q),normal,vec2(0,0),col))
