# The player's aircraft repainted: a base livery for the type, its colours changed, national
# insignia, rudder stripes, a tail number and operator bars. Colours and drawn marks only, built
# into the aircraft's mesh by the kit (src/planes.jo). Pure: the pause menu's Paint page edits a
# Paint (src/aircraft_paint_view.jo), the game rebuilds the player's model from paint_livery and saves the
# Paint with the game. A later paint shop can price the same Paint (paint_changes lists what
# differs from the type's own) without anything here changing.
#
# What a type may wear comes from src/markings.jo (insignia, stripes, nations, liveries), so a new
# type or marking added there appears here by itself.

use 'planes.jo'
use 'markings.jo'

# The four colours a Paint can change, as the page names them.
PAINT_SLOTS = ["Main", "Trim", "Wings", "Stripe"]

# what a type can wear, worked out once for it (paint_support)
struct PaintSupport:
    kind = -1
    liveries: int[]                 # LIVERIES indices, the type's default first
    insignia: int[]                 # INSIGNIA indices it may wear (none first)
    rudders: int[]                  # RUDDERS indices it may wear (plain first)
    wing_marks = false              # (its wings can carry insignia and bars)
    rudder_marks = false            # (its rudder can carry stripes and a number)

paint_default_livery = (kind: int) -> int: if kind >= 0 and kind < DEFAULT_LIVERIES.len(): DEFAULT_LIVERIES[kind] else: 0

# Whether a Paint is for this type and changes anything at all.
paint_active = (p: Paint, kind: int) -> bool:
    p.kind == kind and (p.livery >= 0 or p.body.w > 0.0 or p.trim.w > 0.0 or p.wing.w > 0.0 or p.accent.w > 0.0 or p.insignia >= 0 or p.rudder >= 0 or p.number != "" or p.bars >= 0)

paint_base = (p: Paint, kind: int) -> Livery:
    k = if p.livery >= 0 and p.livery < LIVERIES.len(): p.livery else: paint_default_livery(kind)
    LIVERIES[k]

# The livery the aircraft is built with: the base, its colours as changed, and the marks. The
# marks are given outright (not left to the livery), so a type built without them wears them.
paint_livery = (p: Paint, kind: int) -> Livery:
    lv = paint_base(p, kind)
    if p.body.w > 0.0: lv.body = p.body
    if p.trim.w > 0.0: lv.trim = p.trim
    if p.wing.w > 0.0: lv.wing = p.wing
    if p.accent.w > 0.0: lv.accent = p.accent
    if p.insignia >= 0 or p.bars >= 0:
        lv.insignia = paint_insignia(p, kind)
        lv.bars = if paint_bars(p, kind): 1 else: 0
    lv.rudder = p.rudder
    lv.number = clean_number(p.number)
    lv

# the marks as they stand (chosen, or the base livery's)
paint_insignia = (p: Paint, kind: int) -> int: if p.insignia >= 0 and p.insignia < INSIGNIA.len(): p.insignia else: livery_insignia(paint_base(p, kind))
paint_bars = (p: Paint, kind: int) -> bool: if p.bars >= 0: p.bars == 1 else: livery_bars(paint_base(p, kind))
paint_colour = (p: Paint, kind: int, slot: int) -> vec4:
    lv = paint_livery(p, kind)
    match slot:
        0: lv.body
        1: lv.trim
        2: lv.wing
        else: lv.accent

paint_set_colour = (p: mut Paint, slot: int, c: vec4):
    col = vec4(c.x, c.y, c.z, 1)
    match slot:
        0: p.body = col
        1: p.trim = col
        2: p.wing = col
        else: p.accent = col

# A new base livery: its own colours (the changes made over the old one are dropped).
paint_choose_livery = (p: mut Paint, k: int):
    p.livery = k
    p.body = vec4(0, 0, 0, 0); p.trim = vec4(0, 0, 0, 0); p.wing = vec4(0, 0, 0, 0); p.accent = vec4(0, 0, 0, 0)

paint_reset = (kind: int) -> Paint: Paint(kind = kind)

# What differs from the type's own paint, in words (a shop would price these; the page lists them).
paint_changes = (p: Paint, kind: int) -> str[]:
    out: str[]
    if not paint_active(p, kind): return out
    if p.livery >= 0 and p.livery != paint_default_livery(kind): out.push("livery")
    loop k in 0..4:
        if paint_colour(p, kind, k) != paint_colour(Paint(kind = kind, livery = p.livery), kind, k): out.push(PAINT_SLOTS[k].lower())
    if p.insignia >= 0 and p.insignia != paint_insignia(Paint(kind = kind, livery = p.livery), kind): out.push("insignia")
    if p.bars >= 0 and paint_bars(p, kind) != paint_bars(Paint(kind = kind, livery = p.livery), kind): out.push("bars")
    if p.rudder >= 0: out.push("rudder")
    if clean_number(p.number) != "": out.push("number")
    out

# What the type may wear. `name` its name (CRAFT_NAMES); `count(lv)` the vertices of the type
# built with a livery, to see whether its builder draws wing and rudder marks.
paint_support = (kind: int, name: str, count: (Livery) -> int, period: int[] = []) -> PaintSupport:
    nations = type_nations(name)
    base = LIVERIES[paint_default_livery(kind)]
    plain = base
    plain.insignia = INSIGNIA_NONE; plain.bars = 0; plain.number = ""
    marked = plain
    marked.insignia = INSIGNIA_KALYRA
    numbered = plain
    numbered.number = "8"
    n = count(plain)
    PaintSupport(kind, liveries_for(name, paint_default_livery(kind), LIVERIES.len(), period), insignia_for(nations), rudders_for(nations), count(marked) != n, count(numbered) != n)

# ---------------- choosing a colour ----------------

# hue (0..1), saturation, value -> a colour
hsv_colour = (h: f64, s: f64, v: f64) -> vec4:
    hh = (h - floor(h)) * 6.0
    k = int(floor(hh)); f = hh - f64(k)
    p = v * (1.0 - s); q = v * (1.0 - s * f); u = v * (1.0 - s * (1.0 - f))
    rgb3 = match k % 6:
        0: vec3(f32(v), f32(u), f32(p))
        1: vec3(f32(q), f32(v), f32(p))
        2: vec3(f32(p), f32(v), f32(u))
        3: vec3(f32(p), f32(q), f32(v))
        4: vec3(f32(u), f32(p), f32(v))
        else: vec3(f32(v), f32(p), f32(q))
    vec4(rgb3, 1)

# a colour -> (hue, saturation, value)
colour_hsv = (c: vec4) -> vec3:
    r = f64(c.x); g = f64(c.y); b = f64(c.z)
    mx = max(r, max(g, b)); mn = min(r, min(g, b)); d = mx - mn
    h = if d <= 0.00001: 0.0 else: if mx == r: ((g - b) / d) / 6.0 else: if mx == g: ((b - r) / d + 2.0) / 6.0 else: ((r - g) / d + 4.0) / 6.0
    vec3(f32(h - floor(h)), f32(if mx <= 0.0: 0.0 else: d / mx), f32(mx))
