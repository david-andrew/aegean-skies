# The player's aircraft repainted: a base livery for the type, its colours changed, national
# insignia, rudder stripes, a tail number and operator bars. Colours and drawn marks only, built
# into the aircraft's mesh by the kit (src/planes.jo). Pure: the pause menu's Paint page edits a
# Paint (src/aircraft_paint_view.jo), the game rebuilds the player's model from paint_livery and saves the
# Paint with the game. A later paint shop can price the same Paint (paint_changes lists what
# differs from the type's own) without anything here changing.
#
# What a type may wear comes from src/markings.jo (insignia, stripes, nations, liveries), so a new
# type or marking added there appears here by itself.

use 'planes.jo'
use 'markings.jo'
use 'paint_parts.jo'
use 'decals.jo'

# The four colours a Paint can change, as the page names them.
PAINT_SLOTS = ["Main", "Trim", "Wings", "Stripe"]

# what a type can wear, worked out once for it (paint_support)
struct PaintSupport:
    kind = -1
    liveries: int[]                 # LIVERIES indices, the type's default first
    insignia: int[]                 # INSIGNIA indices it may wear (none first)
    rudders: int[]                  # RUDDERS indices it may wear (plain first)
    wing_marks = false              # (its wings can carry insignia and bars)
    rudder_marks = false            # (its rudder can carry stripes and a number)
    parts: bool[] = []              # the parts that take their own paint (PAINT_PARTS order)

paint_default_livery = (kind: int) -> int: if kind >= 0 and kind < DEFAULT_LIVERIES.len(): DEFAULT_LIVERIES[kind] else: 0

# Whether a Paint is for this type and changes anything at all.
paint_active = (p: Paint, kind: int) -> bool:
    p.kind == kind and (p.livery >= 0 or p.body.w > 0.0 or p.trim.w > 0.0 or p.wing.w > 0.0 or p.accent.w > 0.0 or p.insignia >= 0 or p.rudder >= 0 or p.number != "" or p.bars >= 0 or paint_parts_set(p) > 0 or p.decals.len() > 0)

paint_base = (p: Paint, kind: int) -> Livery:
    k = if p.livery >= 0 and p.livery < LIVERIES.len(): p.livery else: paint_default_livery(kind)
    LIVERIES[k]

# The livery the aircraft is built with: the base, its colours as changed, and the marks. The
# marks are given outright (not left to the livery), so a type built without them wears them.
paint_livery = (p: Paint, kind: int) -> Livery:
    lv = paint_base(p, kind)
    if p.body.w > 0.0: lv.body = p.body
    if p.trim.w > 0.0: lv.trim = p.trim
    if p.wing.w > 0.0: lv.wing = p.wing
    if p.accent.w > 0.0: lv.accent = p.accent
    if p.insignia >= 0 or p.bars >= 0:
        lv.insignia = paint_insignia(p, kind)
        lv.bars = if paint_bars(p, kind): 1 else: 0
    lv.rudder = p.rudder
    lv.number = clean_number(p.number)
    lv

# The aircraft built in a paint: its livery, its parts in their own paint, its decals.
paint_build = (p: Paint, kind: int) -> CraftModel:
    build_painted_craft(Craft(kind), paint_livery(p, kind), paint_part_list(p), p.decals)

# ---------------- paint by part ----------------

# the parts given their own paint (one for a part: the last set)
paint_part_list = (p: Paint) -> PartPaint[]: [loop q in p.parts: if q.a.w > 0.0 and q.part >= 0 and q.part < PART_COUNT: q]
paint_parts_set = (p: Paint) -> int: paint_part_list(p).len()

# a part's own paint, or none (it wears the livery)
paint_part = (p: Paint, part: int) -> PartPaint?:
    loop q in p.parts:
        if q.part == part and q.a.w > 0.0: return q
    none

# A part given its own paint (replacing the one it had).
paint_set_part = (p: mut Paint, q: PartPaint):
    keep = PartPaint(part = q.part, pattern = clamp(q.pattern, 0, PAINT_PATTERNS.len() - 1), a = vec4(q.a.x, q.a.y, q.a.z, 1), b = if q.b.w > 0.0: vec4(q.b.x, q.b.y, q.b.z, 1) else: q.b,
        across = q.across, count = clamp(q.count, 2, 12))
    loop k in 0..p.parts.len():
        if p.parts[k].part == q.part:
            p.parts[k] = keep
            return
    p.parts.push(keep)

# A part back in the livery's paint.
paint_clear_part = (p: mut Paint, part: int):
    p.parts = [loop q in p.parts: if q.part != part: q]

# The colour a part shows on the page: its own paint's first colour, or the livery's for it.
paint_part_colour = (p: Paint, kind: int, part: int) -> vec4:
    if let q = paint_part(p, part): return q.a
    lv = paint_livery(p, kind)
    match part:
        1, 2: lv.wing
        4: lv.trim
        5, 7: lv.accent
        else: lv.body

# ---------------- decals ----------------

# A decal added (the newest painted over the others), within the limit: its index, or -1.
paint_add_decal = (p: mut Paint, d: Decal) -> int:
    if p.decals.len() >= DECAL_LIMIT or decal_motif_index(d.motif) < 0: return -1
    keep = d
    keep.text = decal_clean_text(d.text)
    p.decals.push(keep)
    p.decals.len() - 1

paint_remove_decal = (p: mut Paint, k: int):
    if k < 0 or k >= p.decals.len(): return
    p.decals = [loop j in 0..p.decals.len(): if j != k: p.decals[j]]

# the marks as they stand (chosen, or the base livery's)
paint_insignia = (p: Paint, kind: int) -> int: if p.insignia >= 0 and p.insignia < INSIGNIA.len(): p.insignia else: livery_insignia(paint_base(p, kind))
paint_bars = (p: Paint, kind: int) -> bool: if p.bars >= 0: p.bars == 1 else: livery_bars(paint_base(p, kind))
paint_colour = (p: Paint, kind: int, slot: int) -> vec4:
    lv = paint_livery(p, kind)
    match slot:
        0: lv.body
        1: lv.trim
        2: lv.wing
        else: lv.accent

paint_set_colour = (p: mut Paint, slot: int, c: vec4):
    col = vec4(c.x, c.y, c.z, 1)
    match slot:
        0: p.body = col
        1: p.trim = col
        2: p.wing = col
        else: p.accent = col

# A new base livery: its own colours (the changes made over the old one are dropped).
paint_choose_livery = (p: mut Paint, k: int):
    p.livery = k
    p.body = vec4(0, 0, 0, 0); p.trim = vec4(0, 0, 0, 0); p.wing = vec4(0, 0, 0, 0); p.accent = vec4(0, 0, 0, 0)

paint_reset = (kind: int) -> Paint: Paint(kind = kind)

# What differs from the type's own paint, in words (a shop would price these; the page lists them).
paint_changes = (p: Paint, kind: int) -> str[]:
    out: str[]
    if not paint_active(p, kind): return out
    if p.livery >= 0 and p.livery != paint_default_livery(kind): out.push("livery")
    loop k in 0..4:
        if paint_colour(p, kind, k) != paint_colour(Paint(kind = kind, livery = p.livery), kind, k): out.push(PAINT_SLOTS[k].lower())
    if p.insignia >= 0 and p.insignia != paint_insignia(Paint(kind = kind, livery = p.livery), kind): out.push("insignia")
    if p.bars >= 0 and paint_bars(p, kind) != paint_bars(Paint(kind = kind, livery = p.livery), kind): out.push("bars")
    if p.rudder >= 0: out.push("rudder")
    if clean_number(p.number) != "": out.push("number")
    loop q in paint_part_list(p): out.push(PAINT_PARTS[q.part].lower())
    if p.decals.len() == 1: out.push("a decal")
    else if p.decals.len() > 1: out.push("{p.decals.len()} decals")
    out

# What the type may wear. `name` its name (CRAFT_NAMES); `count(lv)` the vertices of the type
# built with a livery, to see whether its builder draws wing and rudder marks.
paint_support = (kind: int, name: str, count: (Livery) -> int, period: int[] = []) -> PaintSupport:
    nations = type_nations(name)
    base = LIVERIES[paint_default_livery(kind)]
    plain = base
    plain.insignia = INSIGNIA_NONE; plain.bars = 0; plain.number = ""
    marked = plain
    marked.insignia = INSIGNIA_KALYRA
    numbered = plain
    numbered.number = "8"
    n = count(plain)
    PaintSupport(kind, liveries_for(name, paint_default_livery(kind), LIVERIES.len(), period), insignia_for(nations), rudders_for(nations), count(marked) != n, count(numbered) != n,
        craft_paint_parts(Craft(kind), base))

# ---------------- choosing a colour ----------------

# hue (0..1), saturation, value -> a colour
hsv_colour = (h: f64, s: f64, v: f64) -> vec4:
    hh = (h - floor(h)) * 6.0
    k = int(floor(hh)); f = hh - f64(k)
    p = v * (1.0 - s); q = v * (1.0 - s * f); u = v * (1.0 - s * (1.0 - f))
    rgb3 = match k % 6:
        0: vec3(f32(v), f32(u), f32(p))
        1: vec3(f32(q), f32(v), f32(p))
        2: vec3(f32(p), f32(v), f32(u))
        3: vec3(f32(p), f32(q), f32(v))
        4: vec3(f32(u), f32(p), f32(v))
        else: vec3(f32(v), f32(p), f32(q))
    vec4(rgb3, 1)

# a colour -> (hue, saturation, value)
colour_hsv = (c: vec4) -> vec3:
    r = f64(c.x); g = f64(c.y); b = f64(c.z)
    mx = max(r, max(g, b)); mn = min(r, min(g, b)); d = mx - mn
    h = if d <= 0.00001: 0.0 else: if mx == r: ((g - b) / d) / 6.0 else: if mx == g: ((b - r) / d + 2.0) / 6.0 else: ((r - g) / d + 4.0) / 6.0
    vec3(f32(h - floor(h)), f32(if mx <= 0.0: 0.0 else: d / mx), f32(mx))

# ---------------- a paint written out in a line ----------------

_spec_colour = (s: str) -> vec4:
    c = [loop x in split(s, ","): to_float(x) ?? 0.0]
    if c.len() >= 3: vec4(f32(c[0]), f32(c[1]), f32(c[2]), 1) else: vec4(0, 0, 0, 0)

PAINT_PART_KEYS = ["fuselage", "lwing", "rwing", "floats", "struts", "cowling", "tail", "rudder"]

# A paint from a line of `name=value` items (captures and tests; AEGEAN_PAINT):
#   livery=17 insignia=4 rudder=4 bars=0 number=I-BAUF body=r,g,b trim=.. wing=.. accent=..
#   part.<fuselage|lwing|rwing|floats|struts|cowling|tail|rudder>=<plain|gradient|stripes>:<r,g,b>[:<r,g,b>[:<across 0|1>[:<bands>]]]
#   decal=<motif>:<spot | left|right|above|below/u/v>[:<size>[:<angle>[:<r,g,b>[:<r,g,b>[:<r,g,b>[:<both 0|1>[:<text>]]]]]]]
# or a livery's name alone ("Greek Naval Air Service").
paint_from_spec = (spec: str, kind: int) -> Paint:
    p = Paint(kind = kind)
    if not spec.contains("="):
        p.livery = livery_named(spec)
        return p
    loop item in split(spec, " "):
        at = item.index_of("=") ?? -1
        if at < 1: continue
        name = item[0..at]; value = item[at + 1..item.len()]
        n = to_int(value) ?? -1
        if name.starts_with("part."):
            part = -1
            loop k in 0..PAINT_PART_KEYS.len():
                if PAINT_PART_KEYS[k] == name[5..name.len()]: part = k
            f = split(value, ":")
            if part < 0 or f.len() < 2: continue
            q = PartPaint(part = part, pattern = if f[0] == "gradient": 1 else: if f[0] == "stripes": 2 else: 0, a = _spec_colour(f[1]))
            if f.len() > 2: q.b = _spec_colour(f[2])
            if f.len() > 3: q.across = f[3] == "1"
            if f.len() > 4: q.count = to_int(f[4]) ?? 4
            paint_set_part(p, q)
            continue
        match name:
            "livery": p.livery = n
            "insignia": p.insignia = n
            "rudder": p.rudder = n
            "bars": p.bars = n
            "number": p.number = clean_number(value)
            "body": p.body = _spec_colour(value)
            "trim": p.trim = _spec_colour(value)
            "wing": p.wing = _spec_colour(value)
            "accent": p.accent = _spec_colour(value)
            "decal":
                f = split(value, ":")
                if f.len() < 2: continue
                d = Decal(motif = f[0], size = 0.0)
                where = split(f[1], "/")
                if where.len() >= 3:
                    d.side = match where[0]:
                        "right": 1
                        "above": 2
                        "below": 3
                        else: 0
                    d.u = to_float(where[1]) ?? 0.5; d.v = to_float(where[2]) ?? 0.5
                    d.size = 0.8
                else: d.spot = f[1]
                if f.len() > 2 and (to_float(f[2]) ?? 0.0) > 0.0: d.size = to_float(f[2]) ?? 0.0
                if f.len() > 3: d.angle = to_float(f[3]) ?? 0.0
                if f.len() > 4: d.a = _spec_colour(f[4])
                if f.len() > 5: d.b = _spec_colour(f[5])
                if f.len() > 6: d.c = _spec_colour(f[6])
                if f.len() > 7: d.both = f[7] != "0"
                if f.len() > 8: d.text = f[8]
                paint_add_decal(p, d)
            _: pass
    p
