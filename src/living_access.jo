# Append surveyed cart connections to existing saves without replacing journeys,
# re-funding markets, or inventing new carriers. Existing link IDs stay stable.
use 'living_types.jo'
use 'living_far_types.jo'
use 'inland_connections_data.jo'

upgrade_access_links=(w:mut World):
    if not w.far.populated or w.far.access_version>=1:return
    loop connection in ACCESS_CONNECTIONS:
        if not (connection.a in w.far.districts) or not (connection.b in w.far.districts):continue
        present=false
        loop link in w.far.links:
            if link.mode==.cart and ((link.a==connection.a and link.b==connection.b) or (link.b==connection.a and link.a==connection.b)):present=true;break
        if present:continue
        distance=0
        loop k in 1..connection.points.len():distance+=int(round(f64(length(connection.points[k]-connection.points[k-1]))*1000.0))
        id=w.far.links.len()
        w.far.links.push(FarLink(id,connection.a,connection.b,.cart,connection.points,distance,trail=true))
        w.far.districts[connection.a].links.push(id)
        w.far.districts[connection.b].links.push(id)
    w.far.access_version=1
