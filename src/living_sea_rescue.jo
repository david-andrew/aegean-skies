# Passing real carriers assist at sea. A saved handling pause precedes boarding; the original
# named person/cohort then travels on that same ship to its real next port. No rescue teleport.
use 'living_types.jo'
use 'living_war_types.jo'
use 'living_far_types.jo'
use 'living_war_rescue.jo'
use 'living_far_checks.jo'
use 'living_far_news.jo'
use 'living_commissions.jo'

sea_rescue_board = (w: mut World, id: int, vehicle: int) -> int:
    s=w.war.survivors[id]; v=w.far.vehicles[vehicle]
    if s.resolved or s.riding_craft>=0 or s.riding_vehicle>=0 or s.vehicle==vehicle or length(v.pos-s.at)>75: return 0
    mass=inventory_mass(w,v.cargo)+v.passengers.len()*75000
    loop _, old in w.war.survivors:
        if old.riding_vehicle==vehicle:
            loop n in old.passengers: mass+=n*75000
    room=min(16,max(0,(v.capacity_grams-mass)/75000))
    if room<=0: return 0
    count=0
    if s.person>=0:
        w.far.vehicles[vehicle].passengers.push(s.person)
        w.people[s.person].far_boat=vehicle; w.people[s.person].pose.pos=v.pos
        count=1
    else if s.vehicle>=0:
        loop citizen in 0..3:
            n=min(room-count,w.far.vehicles[s.vehicle].crew[citizen])
            if n<=0: continue
            w.far.vehicles[s.vehicle].crew[citizen]-=n; w.far.crew_population[citizen]-=n
            w.war.survivors[id].passengers[citizen]+=n; count+=n
    if count>0:
        w.war.survivors[id].riding_vehicle=vehicle
        w.war.survivors[id].assigned_boat= -1
    count

sea_rescue_land = (w: mut World, id: int, vehicle: int, place: int):
    s=w.war.survivors[id]
    if s.riding_vehicle!=vehicle or not (place in w.far.districts): return
    count=0
    if s.person>=0:
        person=s.person; w.far.vehicles[vehicle].passengers.remove(person)
        w.people[person].far_boat= -1; w.people[person].pose.pos=far_counter(w,place)
        if w.people[person].far_home>=0:
            w.people[person].far_place=place; w.far.people[person].vehicle= -1
            w.far.people[person].route=[]; w.far.people[person].waypoint=0
            w.far.people[person].target=far_counter(w,place); w.far.people[person].last_tick=w.tick
            w.far.people[person].last_hour= -1
        else if place<w.places.len():
            w.people[person].place=place
            if not (person in w.places[place].residents): w.places[place].residents.push(person)
        else: w.people[person].far_visit=place
        count=1
    else:
        loop c in 0..3:
            n=s.passengers[c]; count+=n
            w.far.districts[place].dependents[c]+=n
            w.far.districts[place].pending_workers[c]+=n
            if n>0: w.far.districts[place].workers_ready_hour[c]=w.minute/60+1
        w.war.survivors[id].passengers=[0,0,0]
    w.war.survivors[id].rescued_total+=count; w.war.survivors[id].destination=place
    w.war.survivors[id].riding_vehicle= -1
    remaining=0
    if s.vehicle>=0:
        loop n in w.far.vehicles[s.vehicle].crew: remaining+=n
    w.war.survivors[id].resolved=s.person>=0 or remaining==0
    far_local_news(w,place,"rescue","Coaster {vehicle} brought {count} survivors to {w.place_contexts[place].name} on its actual voyage.",country=s.country,severity=700)

# Air meeting callers release a crashed body but deliberately keep its existing occupant
# bound. Adopt only unleased far wrecks with a living occupant; a scene-owned combat descent
# remains the combat API's responsibility until its real landed/swimming outcome arrives.
far_wreck_survivors = (w: mut World):
    loop c in w.aircraft:
        if c.state!=.wrecked or c.move_owner==.scene or c.rescue_event>=0 or c.hull<=0 or not (c.owner in w.far.people): continue
        if w.far.people[c.owner].vehicle!=c.id or w.people[c.owner].state==.departed: continue
        id=record_downed_airman(w,c.owner,c.id,c.pose.pos,w.people[c.owner].citizenship)
        if id<0: continue
        nearby= -1; distance=2000.0
        loop place in w.far.place_ids:
            d=f64(length(w.place_contexts[place].center-c.pose.pos))
            if d<distance: nearby=place; distance=d
        if nearby>=0:
            far_local_news(w,nearby,"rescue_needed","{w.people[c.owner].name}'s aircraft came down near {w.place_contexts[nearby].name}. The pilot needs passage to shelter.",actor=c.owner,country=w.people[c.owner].citizenship,severity=850,rescue=id)

sea_rescue_minute = (w: mut World):
    if not w.far.populated: return
    far_wreck_survivors(w)
    arrived=w.war.arrivals; w.war.arrivals=[]
    ids=w.war.survivors.keys(); ids.sort()
    loop id in ids:
        s=w.war.survivors[id]
        if s.resolved: continue
        if s.riding_vehicle>=0:
            boat=s.riding_vehicle
            if boat in arrived and w.far.vehicles[boat].place>=0: sea_rescue_land(w,id,boat,w.far.vehicles[boat].place)
            continue
        if s.riding_craft>=0: continue
        if s.assigned_boat>=0:
            v=w.far.vehicles[s.assigned_boat]
            if v.hull<=350 or v.journey<0 or length(v.pos-s.at)>75 or w.tick>s.pickup_tick+120:
                w.war.survivors[id].assigned_boat= -1
            else if w.tick>=s.pickup_tick:
                if sea_rescue_board(w,id,v.id)>0: continue
                w.war.survivors[id].assigned_boat= -1
            else: continue
        if w.minute>s.deadline:
            if s.person>=0:
                w.people[s.person].state=.departed
                if not (s.person in w.war.dead_named): w.war.dead_named.push(s.person)
            else if s.vehicle>=0:
                loop c in 0..3:
                    n=w.far.vehicles[s.vehicle].crew[c]
                    w.far.vehicles[s.vehicle].crew[c]=0; w.far.crew_population[c]-=n; w.far.dead+=n
            w.war.survivors[id].resolved=true
            continue
        loop v in w.far.vehicles:
            if v.kind!=.ship or v.journey<0 or v.hull<=500 or v.battle>=0 or v.id==s.vehicle or length(v.pos-s.at)>75: continue
            if inventory_mass(w,v.cargo)+v.passengers.len()*75000+75000>v.capacity_grams: continue
            w.war.survivors[id].assigned_boat=v.id; w.war.survivors[id].pickup_tick=w.tick+1800
            w.far.journeys[v.journey].hold_until_tick=max(w.far.journeys[v.journey].hold_until_tick,w.tick+1800)
            break
