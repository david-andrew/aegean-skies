# The day's air and sunset palettes: how clear or thick the low air is on a given day, and which
# atmospheric palette colours the sun disc, near-sun aureole, twilight sky and sea glitter.
#
# One air kind, one sunset palette and one vividness for the whole evening, the same for everyone
# (from the day's number), nudged smoothly by the weather where they stand: a clean wind keeps the
# air clear and leans bolder; rain or a deck under cloud makes it humid and dials vividness down.
# Exceptional stratospheric volcanic layers persist for three days; aged-smoke cool-disc events for
# two days; rare kinds stay rare (~85% routine, ~14% hazy/dust/smoke, ~1% exceptional, favouring
# subtle volcanic glows over full cool discs).
#
#   DayAir:
#     clear       clear maritime baseline
#     hazy        summer haze: disc warms from ~15 deg up, glow broader
#     dusty       Saharan dust: buff-veiled sky, flatter warmer light, disc muted from ~20 deg
#     heavy       heavy dust outbreak (~1 day in 25): thick buff veil, dim warm light, dark brown/crimson
#     humid       damp coastal air: softer, broader aureole
#     washed      day after rain or clean meltemi: crisp air, yellow-gold almost to the water
#
#   SunsetPalette (grounded in the solar colour field guide; every palette spans muted 0..bold 1):
#     amber       clear maritime: ivory -> pale yellow -> gold -> amber (routine; crisp disc vs glow)
#     red         existing red baseline at bold end (vivid=1); softer orange-scarlet at muted end
#     peach       humid / coastal haze: cream -> peach -> salmon -> coral (routine)
#     crimson     hazy / dust extinction: scarlet -> flat deep crimson -> wine burgundy (episodic)
#     copper      Saharan dust: copper -> rust -> dark reddish-brown in heavy dust (episodic)
#     rose        regional smoke: coral -> pale red -> rose -> burgundy over muted non-pink sky (episodic)
#     magenta     volcanic stratospheric: warm-white / pale-rose disc, rose -> pink -> magenta glow (exceptional)
#     lilac       volcanic twilight: warm cream disc, cool aureole -> lilac halo over warm horizon (exceptional)
#     blue        aged smoke: cool aureole -> blue -> indigo disc (very rare)
#     purple      aged smoke: lavender -> purple disc, plum glow (very rare)
#     cyan        aged smoke: cool aureole -> blue-green / cyan-mint disc, teal glow (very rare)
#     green       aged smoke: pale green / sage-emerald disc, green glow (very rare)
#
#   HorizonFlash (independent refraction event at a clear sea horizon):
#     none, green (yellow-green -> emerald), blue (rare), violet (very rare tip)
#
#   AureoleSize (per-evening spread around the disc): tight, normal, broad, wide
#   BishopsRingMode (volcanic 22-34 deg aerosol ring): off, subtle, strong
#   CoronaMode (faint WMO mist diffraction corona <5 deg): off, faint, clear
#
# Everything here is worked out on the CPU, once a frame: the sky, sea and disc shaders only take
# the Light it gives them. Environment overrides (captures):
#   AEGEAN_SKY_AIR=clear|hazy|dusty|heavy|humid|washed
#   AEGEAN_SUNSET=amber|red|peach|crimson|copper|rose|magenta|lilac|blue|purple|cyan|green
#   AEGEAN_SUNSET_VIVID=0..1|muted|medium|bold
#   AEGEAN_AUREOLE=tight|normal|broad|wide
#   AEGEAN_FLASH=none|green|blue|violet
#   AEGEAN_BISHOPS_RING=off|subtle|strong
#   AEGEAN_CORONA=off|faint|clear
use 'look.jo'

enum DayAir: clear, hazy, dusty, heavy, humid, washed
enum SunsetPalette: amber, red, peach, crimson, copper, rose, magenta, lilac, blue, purple, cyan, green
enum HorizonFlash: none, green, blue, violet
enum AureoleSize: tight, normal, broad, wide
enum BishopsRingMode: off, subtle, strong
enum CoronaMode: off, faint, clear

day_air_names = ["clear", "hazy", "dusty", "heavy", "humid", "washed"]
day_air_labels = ["Clear", "Hazy", "Dusty", "Heavy dust", "Humid", "Washed"]
day_air_kinds = [DayAir.clear, DayAir.hazy, DayAir.dusty, DayAir.heavy, DayAir.humid, DayAir.washed]
day_air_forced: DayAir? = none

sunset_palette_names = ["amber", "red", "peach", "crimson", "copper", "rose", "magenta", "lilac", "blue", "purple", "cyan", "green"]
sunset_palette_labels = ["Amber (clear)", "Red (baseline)", "Peach (humid)", "Crimson (hazy)", "Copper (dust)", "Rose (smoke)", "Magenta glow (volcanic)", "Lilac halo (volcanic)", "Blue sun (rare)", "Purple sun (rare)", "Blue-green sun (rare)", "Green sun (rare)"]
sunset_palette_kinds = [SunsetPalette.amber, SunsetPalette.red, SunsetPalette.peach, SunsetPalette.crimson, SunsetPalette.copper, SunsetPalette.rose, SunsetPalette.magenta, SunsetPalette.lilac, SunsetPalette.blue, SunsetPalette.purple, SunsetPalette.cyan, SunsetPalette.green]
sunset_palette_forced: SunsetPalette? = none

sunset_vivid_forced: f32? = none

aureole_size_names = ["tight", "normal", "broad", "wide"]
aureole_size_labels = ["Tight", "Normal", "Broad", "Wide"]
aureole_size_kinds = [AureoleSize.tight, AureoleSize.normal, AureoleSize.broad, AureoleSize.wide]
aureole_size_forced: AureoleSize? = none

horizon_flash_names = ["none", "green", "blue", "violet"]
horizon_flash_labels = ["Off", "Green flash", "Blue flash", "Violet flash"]
horizon_flash_kinds = [HorizonFlash.none, HorizonFlash.green, HorizonFlash.blue, HorizonFlash.violet]
horizon_flash_forced: HorizonFlash? = none

bishops_ring_names = ["off", "subtle", "strong"]
bishops_ring_labels = ["Off", "Subtle", "Strong"]
bishops_ring_kinds = [BishopsRingMode.off, BishopsRingMode.subtle, BishopsRingMode.strong]
bishops_ring_forced: BishopsRingMode? = none

corona_names = ["off", "faint", "clear"]
corona_labels = ["Off", "Faint", "Clear"]
corona_kinds = [CoronaMode.off, CoronaMode.faint, CoronaMode.clear]
corona_forced: CoronaMode? = none

_day_air_env = env("AEGEAN_SKY_AIR") ?? ""
loop k in 0..day_air_names.len():
    if _day_air_env == day_air_names[k]: day_air_forced = day_air_kinds[k]

_sunset_env = env("AEGEAN_SUNSET") ?? ""
loop k in 0..sunset_palette_names.len():
    if _sunset_env == sunset_palette_names[k]: sunset_palette_forced = sunset_palette_kinds[k]

_vivid_env = env("AEGEAN_SUNSET_VIVID") ?? ""
if _vivid_env == "muted": sunset_vivid_forced = 0.0
else if _vivid_env == "soft": sunset_vivid_forced = 0.25
else if _vivid_env == "medium": sunset_vivid_forced = 0.5
else if _vivid_env == "vivid": sunset_vivid_forced = 0.75
else if _vivid_env == "bold": sunset_vivid_forced = 1.0
else if _vivid_env != "":
    if let fv = to_float(_vivid_env): sunset_vivid_forced = f32(clamp(fv, 0.0, 1.0))

_aureole_env = env("AEGEAN_AUREOLE") ?? ""
loop k in 0..aureole_size_names.len():
    if _aureole_env == aureole_size_names[k]: aureole_size_forced = aureole_size_kinds[k]

_flash_env = env("AEGEAN_FLASH") ?? ""
loop k in 0..horizon_flash_names.len():
    if _flash_env == horizon_flash_names[k]: horizon_flash_forced = horizon_flash_kinds[k]

_ring_env = env("AEGEAN_BISHOPS_RING") ?? ""
loop k in 0..bishops_ring_names.len():
    if _ring_env == bishops_ring_names[k]: bishops_ring_forced = bishops_ring_kinds[k]

_corona_env = env("AEGEAN_CORONA") ?? ""
loop k in 0..corona_names.len():
    if _corona_env == corona_names[k]: corona_forced = corona_kinds[k]

set_day_air_forced = (k: DayAir?):
    global day_air_forced
    day_air_forced = k

set_sunset_palette_forced = (p: SunsetPalette?):
    global sunset_palette_forced
    sunset_palette_forced = p

set_sunset_vivid_forced = (v: f32?):
    global sunset_vivid_forced
    sunset_vivid_forced = if let x = v: f32(clamp(f64(x), 0.0, 1.0)) else: none

set_aureole_size_forced = (a: AureoleSize?):
    global aureole_size_forced
    aureole_size_forced = a

set_horizon_flash_forced = (f: HorizonFlash?):
    global horizon_flash_forced
    horizon_flash_forced = f

set_bishops_ring_forced = (m: BishopsRingMode?):
    global bishops_ring_forced
    bishops_ring_forced = m

set_corona_forced = (m: CoronaMode?):
    global corona_forced
    corona_forced = m

day_air_forced_index = () -> int:
    if let k = day_air_forced: int(k) else: -1

sunset_palette_forced_index = () -> int:
    if let p = sunset_palette_forced: int(p) else: -1

sunset_vivid_is_forced = () -> bool:
    sunset_vivid_forced != none

aureole_size_forced_index = () -> int:
    if let a = aureole_size_forced: int(a) else: -1

horizon_flash_forced_index = () -> int:
    if let f = horizon_flash_forced: int(f) else: -1

bishops_ring_forced_index = () -> int:
    if let m = bishops_ring_forced: int(m) else: -1

corona_forced_index = () -> int:
    if let m = corona_forced: int(m) else: -1

# (small integer hashes of the day's number: the same day, the same air & sunset, for everyone)
_day_hash = (day: int) -> f64:
    x = (day * 1103515245 + 12345) % 2147483647
    x = (x * 48271) % 2147483647
    if x < 0: x = -x
    f64(x % 10000) / 10000.0

_day_hash_salt = (day: int, salt: int) -> f64:
    x = ((day * 1664525 + salt * 1013904223 + 374761393) % 2147483647)
    x = ((x * 69069 + salt * 13 + 1) % 2147483647)
    if x < 0: x = -x
    f64(x % 100000) / 100000.0

# The day's kind. rain, deck and clarity are the weather where the eye is (living_conditions.jo
# WeatherAir): rain or a low deck mean damp air; a clearing wind (clarity over 1) clean air.
day_air_kind = (day: int, rain: f32, deck: f32, clarity: f32) -> DayAir:
    if let k = day_air_forced: return k
    u = _day_hash(day)
    if rain > 0.05 or deck > 0.3: return .humid
    if clarity > 1.25: return if u < 0.5: .clear else: .washed
    # (about a third of days clear, a quarter hazy, one in twelve dusty, one in 25 heavy dust, one
    # in seven humid, the rest washed)
    if u < 0.34: return .clear
    if u < 0.58: return .hazy
    if u < 0.66: return .dusty
    if u < 0.70: return .heavy
    if u < 0.84: return .humid
    .washed

# Which sunset palette belongs to this day's air and weather.
# Exceptional stratospheric volcanic layers persist for 3 days (~0.85% of days, favouring magenta
# and lilac glows); aged-smoke cool discs persist for 2 days (~0.15% of days: blue, purple, cyan,
# green). Ordinary days follow the day's air: ~85% routine (amber, red, peach), ~14% episodic
# dust/smoke (crimson, copper, rose, dusty red), ~1% exceptional.
sunset_palette_kind = (day: int, air: DayAir, rain: f32 = 0.0, deck: f32 = 0.0, clarity: f32 = 1.0) -> SunsetPalette:
    if let p = sunset_palette_forced: return p
    if rain < 0.2 and deck < 0.75:
        v_block = if day >= 0: day / 3 else: (day - 2) / 3
        v = _day_hash_salt(v_block, 71)
        if v < 0.0085:
            return if v < 0.0055: .magenta else: .lilac
        s_block = if day >= 0: day / 2 else: (day - 1) / 2
        s = _day_hash_salt(s_block, 193)
        if s < 0.0015:
            if s < 0.00055: return .blue
            if s < 0.00090: return .purple
            if s < 0.00120: return .cyan
            return .green
    u = _day_hash_salt(day, 31)
    match air:
        .washed:
            if u < 0.78: .amber
            else if u < 0.90: .peach
            else: .red
        .clear:
            if u < 0.52: .amber
            else if u < 0.84: .red
            else: .peach
        .humid:
            if u < 0.64: .peach
            else if u < 0.86: .red
            else: .amber
        .hazy:
            if u < 0.46: .red
            else if u < 0.68: .peach
            else if u < 0.80: .crimson
            else if u < 0.92: .rose
            else: .amber
        .dusty:
            if u < 0.48: .copper
            else if u < 0.70: .crimson
            else if u < 0.86: .red
            else: .rose
        .heavy:
            if u < 0.56: .copper
            else if u < 0.80: .crimson
            else if u < 0.90: .red
            else: .rose

# Canonical air for a forced palette when the user didn't also force a specific DayAir (and mild
# aged-smoke haze when a natural rare cool-disc event occurs on an otherwise clear day).
sunset_effective_air = (air: DayAir, pal: SunsetPalette) -> DayAir:
    if day_air_forced != none: return air
    if sunset_palette_forced != none:
        return match pal:
            .amber: .clear
            .red: .hazy
            .peach: .humid
            .crimson: .hazy
            .copper: .dusty
            .rose: .hazy
            .magenta: .clear
            .lilac: .clear
            .blue: .hazy
            .purple: .hazy
            .cyan: .hazy
            .green: .hazy
    if (pal == .blue or pal == .purple or pal == .cyan or pal == .green) and (air == .clear or air == .washed):
        return .hazy
    air

# Per-evening vividness (0 muted / toned-down .. 1 bold / original-red strength).
# Interspersed across days (~30% toned-down, ~35% medium, ~35% bold in fair weather): clearer and
# washed air leans bolder; rain and thick cloud cover smoothly dial vividness down.
sunset_vividness = (day: int, air: DayAir, pal: SunsetPalette, rain: f32 = 0.0, deck: f32 = 0.0, clarity: f32 = 1.0) -> f32:
    if let v = sunset_vivid_forced: return v
    u = _day_hash_salt(day, 317)
    base = clamp(u * 1.16 - 0.08, 0.0, 1.0)
    air_nudge = match air:
        .washed: 0.16
        .clear: 0.12
        .humid: 0.02
        .hazy: 0.0
        .dusty: -0.10
        .heavy: -0.20
    # Smooth weather damping (no sudden switches)
    weather_damp = clamp(f64(rain) * 0.55 + f64(deck) * 0.35, 0.0, 0.65)
    clean_lift = clamp((f64(clarity) - 1.0) * 0.22, -0.1, 0.15)
    f32(clamp(base + air_nudge + clean_lift - weather_damp, 0.0, 1.0))

# Per-evening aureole spread (independent of palette; humid/hazy/volcanic air leans broader).
aureole_size_kind = (day: int, air: DayAir) -> AureoleSize:
    if let a = aureole_size_forced: return a
    u = _day_hash_salt(day, 421)
    shift = match air:
        .washed: -0.22
        .clear: -0.08
        .humid: 0.16
        .hazy: 0.10
        .dusty: 0.06
        .heavy: 0.12
    x = clamp(u + shift, 0.0, 1.0)
    if x < 0.22: .tight
    else if x < 0.62: .normal
    else if x < 0.88: .broad
    else: .wide

aureole_size_scale = (a: AureoleSize) -> f32:
    match a:
        .tight: 0.74
        .normal: 1.0
        .broad: 1.22
        .wide: 1.42

# Independent refraction horizon flash (green, rare blue, very rare violet): requires clear sea air
# and an unobstructed horizon; never appears in haze, dust, rain, fog, storm or overcast.
horizon_flash_kind = (day: int, air: DayAir, rain: f32 = 0.0, deck: f32 = 0.0, fog: f32 = 0.0, storm: f32 = 0.0, clarity: f32 = 1.0) -> HorizonFlash:
    if let f = horizon_flash_forced: return f
    if air != .clear and air != .washed: return .none
    if rain > 0.02 or deck > 0.15 or fog > 0.05 or storm > 0.05: return .none
    u = _day_hash_salt(day, 509)
    if air == .washed or clarity > 1.2:
        if u < 0.006: return .violet
        if u < 0.032: return .blue
        if u < 0.21: return .green
        return .none
    if u < 0.08: .green else: .none

# High-altitude volcanic aerosol Bishop's ring: naturally active on volcanic days (magenta, lilac).
bishops_ring_kind = (day: int, pal: SunsetPalette) -> BishopsRingMode:
    if let m = bishops_ring_forced: return m
    if pal != .magenta and pal != .lilac: return .off
    u = _day_hash_salt(day, 613)
    if u < 0.35: .strong else: .subtle

# Faint WMO diffraction corona (<5 deg around disc): occurs naturally in humid / misty air.
corona_kind = (day: int, air: DayAir, fog: f32 = 0.0, rain: f32 = 0.0, deck: f32 = 0.0) -> CoronaMode:
    if let m = corona_forced: return m
    if rain > 0.25 or deck > 0.7: return .off
    if fog > 0.12: return .faint
    if air != .humid and air != .hazy: return .off
    u = _day_hash_salt(day, 727)
    if air == .humid and u < 0.28: return .faint
    if air == .hazy and u < 0.10: return .faint
    .off

# How thick the low air is: 0 the baseline, 1 for dust, 1.4 for heavy dust; below 0 cleaner than usual.
day_air_turbidity = (k: DayAir) -> f32:
    match k:
        .hazy: 0.6
        .dusty: 1.0
        .heavy: 1.4
        .humid: 0.45
        .washed: -0.4
        _: 0.0

# The low sun's light through that air (multiplies Light.sun while the sun is low).
day_air_sun_tint = (k: DayAir) -> vec3:
    match k:
        .dusty: vec3(1.0, 0.72, 0.48)
        .heavy: vec3(1.0, 0.6, 0.36)
        .hazy: vec3(1.0, 0.84, 0.64)
        .humid: vec3(1.0, 0.86, 0.78)
        _: vec3(1, 1, 1)

# The light of the day's air (baseline bold red palette): the sun's light warmer and dimmer low
# down in thick air, the glow band broader and reddened from a higher sun, the haze warmer; in
# washed air the band narrower. Every transition with elevation is smooth (no step at el = -0.05).
day_air_light = (L: Light, k: DayAir) -> Light:
    t = day_air_turbidity(k)
    out = L
    out.turbidity = t
    if t == 0.0: return out
    el = f64(normalize(L.sun_dir).y)
    # Smooth fade as the sun drops into deep twilight (replaces hard `el > -0.05` step)
    up_w = f32(smoothstep(-0.18, 0.02, el))
    if t > 0.0:
        low = f32(clamp(1.0 - el / 0.42, 0.0, 1.0))
        # (in thick air the sun's light is warmed from higher up: dust reddens a sun 25 degrees up)
        high = f32(clamp(1.0 - el / (0.42 + 0.2 * f64(t)), 0.0, 1.0))
        out.sun = L.sun * mix(vec3(1, 1, 1), day_air_sun_tint(k), t * high)
        out.haze = mix(L.haze, L.haze * vec3(1.04, 0.92, 0.84), t * low * 0.6)
        # (dust and haze make the whole sky milky, all day and more with a low sun: a pale buff-grey
        # veil from the horizon well up past the sun, the blue weak and only overhead, no bright
        # glare round the disc, and a flatter, warmer light on everything)
        veil = (if k == .heavy: 0.92 else: if k == .dusty: 0.82 else: if k == .hazy: 0.45 else: 0.2) * (0.6 + 0.4 * high)
        bright = dot(L.sky_horizon, vec3(0.3, 0.5, 0.2))
        buff = vec3(0.88, 0.8, 0.68) * bright * 1.15
        out.sky_horizon = mix(L.sky_horizon, buff, veil)
        out.sky_top = mix(L.sky_top, buff * 0.92, veil * 0.85)
        out.haze = mix(out.haze, buff * 0.96, veil * 0.8)
        out.glare = 1.0 - 0.85 * veil
        out.sun = out.sun * (1.0 - 0.28 * veil)
        out.shade = mix(L.shade, out.sun * 0.5, 0.35 * veil)
        # (the hot band from a sun as high as about 24 degrees, broader in thicker air, easing
        # continuously into post-sunset twilight without any step when crossing the horizon)
        reach = f32(smoothstep(0.42, 0.1, el)) * up_w
        toward = normalize(vec2(L.sun_dir.x, L.sun_dir.z) + vec2(0.00001, 0))
        glow = max(L.afterglow.x, min(t * 0.75 * reach, 1.0))
        base_band = if L.afterglow.x > 0.0: 1.0 / L.afterglow.y else: 0.10
        band = base_band * (1.0 + 0.8 * t * up_w)
        if glow > 0.001: out.afterglow = vec4(glow, 1.0 / band, toward.x, toward.y)
        out.sunset = max(L.sunset, min(t, 1.0) * f32(smoothstep(0.42, 0.05, el)) * up_w)
        out.glow_low = mix(vec3(0.92, 0.53, 0.25), vec3(1.0, 0.42, 0.12), out.sunset)
        out.glow_high = mix(vec3(0.93, 0.8, 0.55), vec3(0.94, 0.58, 0.5), out.sunset)
        out.glow_belt = mix(vec3(0.5, 0.38, 0.44), vec3(0.86, 0.6, 0.66), out.sunset)
    else:
        # (clean air: the band narrower and the haze a little bluer)
        if L.afterglow.x > 0.0: out.afterglow.y = L.afterglow.y * (1.0 - t * 0.8)
        out.haze = mix(L.haze, L.haze * vec3(0.94, 1.0, 1.06), -t)
    out

# Full sunset & twilight lighting for a day's air, palette, vividness (0 muted .. 1 bold), aureole
# spread, horizon flash, Bishop's ring and mist corona.
# Midday stays ordinary Mediterranean daylight, night stays deep navy, and every transition with
# elevation is continuous. At pal == .red and vivid == 1.0, preserves the existing red baseline.
sunset_light = (L: Light, k: DayAir, pal: SunsetPalette, flash: HorizonFlash = .none, vivid: f32 = 1.0, aureole: AureoleSize = .normal, ring: BishopsRingMode? = none, corona_m: CoronaMode? = none) -> Light:
    out = day_air_light(L, k)
    v = f32(clamp(f64(vivid), 0.0, 1.0))
    out.sunset_kind = int(pal)
    out.horizon_flash = int(flash)
    out.sunset_vivid = v
    out.aureole_scale = aureole_size_scale(aureole)

    el = f64(normalize(L.sun_dir).y)
    # Bishop's ring and mist corona (independent optical layers; can accompany any palette)
    rm = ring ?? (if pal == .magenta or pal == .lilac: .subtle else: .off)
    ring_gain: f32 = match rm:
        .off: 0.0
        .subtle: 0.32
        .strong: 0.58
    if ring_gain > 0.0:
        out.bishops_ring = f32(smoothstep(-0.02, 0.08, el) * (1.0 - smoothstep(0.25, 0.60, el))) * ring_gain
    cm = corona_m ?? .off
    corona_gain: f32 = match cm:
        .off: 0.0
        .faint: 0.45
        .clear: 0.85
    if corona_gain > 0.0:
        out.corona = f32(smoothstep(-0.02, 0.04, el) * (1.0 - smoothstep(0.35, 0.68, el))) * corona_gain

    # Smooth elevation envelopes (0 at midday and night)
    twilight = f32(smoothstep(-0.52, -0.26, el) * (1.0 - smoothstep(0.06, 0.42, el)))
    near_set = f32(smoothstep(-0.22, -0.02, el) * (1.0 - smoothstep(0.04, 0.36, el)))
    post_set = f32(smoothstep(-0.42, -0.18, el) * (1.0 - smoothstep(-0.04, 0.08, el)))
    smoke = f32(smoothstep(-0.35, -0.05, el) * (1.0 - smoothstep(0.25, 0.55, el)))
    s = out.sunset
    base_low = mix(vec3(0.92, 0.53, 0.25), vec3(1.0, 0.42, 0.12), s)
    base_high = mix(vec3(0.93, 0.80, 0.55), vec3(0.94, 0.58, 0.50), s)
    base_belt = mix(vec3(0.50, 0.38, 0.44), vec3(0.86, 0.60, 0.66), s)

    # Helper to widen/boost the horizon glow band slightly at the bold end (matching red's strong band)
    boost_band = (muted_mul: f32, bold_mul: f32):
        if out.afterglow.x > 0.001:
            out.afterglow.x = clamp(out.afterglow.x * mix(muted_mul, bold_mul, v), 0.0, 1.0)

    match pal:
        .red:
            # Bold end (v=1): 100% verbatim existing red baseline!
            # Muted end (v=0): gentler, softer orange-scarlet evening.
            if v < 0.999:
                m = 1.0 - v
                out.sky_horizon = mix(out.sky_horizon, vec3(0.80, 0.58, 0.52), near_set * 0.45 * m)
                out.glow_low = mix(out.glow_low, mix(vec3(0.82, 0.52, 0.32), vec3(0.88, 0.44, 0.24), s), twilight * 0.65 * m)
                out.glow_high = mix(out.glow_high, mix(vec3(0.82, 0.72, 0.58), vec3(0.84, 0.58, 0.52), s), twilight * 0.55 * m)
                out.glow_sea = mix(out.glow_sea, vec3(0.32, 0.20, 0.12), twilight * 0.6 * m)
                out.sunset_warm = mix(out.sunset_warm, vec3(0.86, 0.54, 0.32), twilight * 0.55 * m)
                out.glint_sun = mix(out.sun, vec3(1.06, 0.68, 0.42), near_set * 0.55 * m)
                if out.afterglow.x > 0.001:
                    out.afterglow.x *= mix(1.0, 0.74, near_set * m)
        .amber:
            # Clear maritime: ivory -> pale yellow -> gold -> amber (need not end in scarlet).
            # Keep glare controlled so the bright disc stays cleanly separated from its golden glow.
            out.sky_top = mix(out.sky_top, mix(vec3(0.11, 0.22, 0.46), vec3(0.08, 0.20, 0.52), v), near_set * mix(0.55, 0.78, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.90, 0.74, 0.50), vec3(1.00, 0.74, 0.24), v), near_set * mix(0.65, 0.88, v))
            out.haze = mix(out.haze, mix(vec3(0.64, 0.54, 0.44), vec3(0.76, 0.56, 0.28), v), near_set * mix(0.55, 0.75, v))
            out.sea_deep = mix(out.sea_deep, mix(vec3(0.04, 0.11, 0.26), vec3(0.04, 0.10, 0.28), v), near_set * 0.55)
            out.sun = mix(out.sun, mix(vec3(1.22, 0.94, 0.52), vec3(1.36, 0.96, 0.34), v), near_set * 0.78)
            out.glint_sun = mix(out.sun, mix(vec3(1.26, 0.96, 0.48), vec3(1.42, 0.94, 0.22), v), near_set * 0.90)
            out.glare = min(out.glare, mix(1.0, mix(0.52, 0.46, v), near_set))
            gl_m = mix(vec3(0.88, 0.64, 0.30), vec3(0.94, 0.66, 0.22), s)
            gl_b = mix(vec3(0.98, 0.68, 0.16), vec3(1.00, 0.62, 0.08), s)
            gh_m = mix(vec3(0.92, 0.84, 0.60), vec3(0.95, 0.84, 0.52), s)
            gh_b = mix(vec3(1.00, 0.86, 0.44), vec3(1.00, 0.78, 0.30), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.46, 0.46, 0.54), vec3(0.82, 0.68, 0.52), s), twilight)
            out.glow_sea = mix(out.glow_sea, mix(vec3(0.40, 0.30, 0.14), vec3(0.58, 0.40, 0.08), v), twilight)
            out.sunset_warm = mix(out.sunset_warm, mix(vec3(0.96, 0.72, 0.32), vec3(1.00, 0.68, 0.12), v), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.46, 0.42, 0.52), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), mix(vec3(1.0, 1.16, 1.10), vec3(1.04, 1.18, 0.86), v), near_set * 0.75)
            boost_band(0.88, 1.08)
        .peach:
            # Humid / coastal haze: cream -> peach -> salmon -> coral; bold matches red's intensity.
            out.sky_top = mix(out.sky_top, mix(vec3(0.17, 0.21, 0.40), vec3(0.15, 0.17, 0.40), v), near_set * mix(0.45, 0.70, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.90, 0.68, 0.62), vec3(1.00, 0.58, 0.48), v), near_set * mix(0.60, 0.88, v))
            out.haze = mix(out.haze, mix(vec3(0.66, 0.52, 0.52), vec3(0.76, 0.48, 0.44), v), near_set * mix(0.50, 0.74, v))
            out.sea_deep = mix(out.sea_deep, vec3(0.06, 0.09, 0.22), near_set * 0.45)
            out.sun = mix(out.sun, mix(vec3(1.16, 0.80, 0.62), vec3(1.34, 0.74, 0.52), v), near_set * 0.72)
            out.glint_sun = mix(out.sun, mix(vec3(1.22, 0.78, 0.58), vec3(1.42, 0.68, 0.46), v), near_set * 0.90)
            out.glare = min(out.glare, mix(1.0, mix(0.76, 0.68, v), near_set))
            gl_m = mix(vec3(0.88, 0.58, 0.46), vec3(0.94, 0.58, 0.44), s)
            gl_b = mix(vec3(0.98, 0.54, 0.36), vec3(1.00, 0.44, 0.32), s)
            gh_m = mix(vec3(0.93, 0.78, 0.70), vec3(0.96, 0.76, 0.66), s)
            gh_b = mix(vec3(1.00, 0.72, 0.60), vec3(1.00, 0.64, 0.56), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.52, 0.44, 0.50), vec3(0.84, 0.58, 0.62), s), twilight)
            out.glow_sea = mix(out.glow_sea, mix(vec3(0.40, 0.25, 0.20), vec3(0.58, 0.28, 0.20), v), twilight)
            out.sunset_warm = mix(out.sunset_warm, mix(vec3(0.94, 0.64, 0.50), vec3(1.00, 0.52, 0.38), v), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.52, 0.36, 0.46), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), mix(vec3(0.96, 0.98, 1.16), vec3(1.02, 0.92, 1.12), v), near_set * 0.75)
            boost_band(0.88, 1.08)
        .crimson:
            # Hazy / dust deep extinction: scarlet -> flat readable crimson -> wine burgundy.
            out.sky_top = mix(out.sky_top, mix(vec3(0.18, 0.15, 0.22), vec3(0.16, 0.10, 0.20), v), near_set * mix(0.65, 0.82, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.64, 0.36, 0.36), vec3(0.88, 0.24, 0.26), v), near_set * mix(0.68, 0.88, v))
            out.haze = mix(out.haze, mix(vec3(0.52, 0.32, 0.34), vec3(0.66, 0.24, 0.26), v), near_set * mix(0.60, 0.80, v))
            out.sea_deep = mix(out.sea_deep, mix(vec3(0.06, 0.06, 0.12), vec3(0.08, 0.04, 0.10), v), near_set * 0.60)
            out.sun = mix(out.sun, mix(vec3(0.86, 0.40, 0.36), vec3(1.16, 0.32, 0.28), v), near_set * 0.75)
            out.glint_sun = mix(out.sun, mix(vec3(0.92, 0.36, 0.34), vec3(1.30, 0.26, 0.26), v), near_set * 0.90)
            out.glare = min(out.glare, mix(1.0, mix(0.42, 0.48, v), near_set))
            gl_m = mix(vec3(0.66, 0.28, 0.28), vec3(0.74, 0.22, 0.24), s)
            gl_b = mix(vec3(0.88, 0.20, 0.22), vec3(0.96, 0.14, 0.18), s)
            gh_m = mix(vec3(0.64, 0.40, 0.42), vec3(0.70, 0.34, 0.38), s)
            gh_b = mix(vec3(0.82, 0.30, 0.36), vec3(0.88, 0.22, 0.30), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.42, 0.32, 0.36), vec3(0.64, 0.34, 0.40), s), twilight)
            out.glow_sea = mix(out.glow_sea, mix(vec3(0.32, 0.13, 0.14), vec3(0.52, 0.12, 0.14), v), twilight)
            out.sunset_warm = mix(out.sunset_warm, mix(vec3(0.78, 0.28, 0.28), vec3(0.96, 0.16, 0.20), v), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.44, 0.24, 0.32), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), mix(vec3(0.78, 0.62, 0.72), vec3(0.96, 0.52, 0.62), v), near_set * 0.80)
            boost_band(0.82, 1.06)
        .copper:
            # Saharan dust: muted copper / rust / dark reddish-brown in heavy dust; bold = burnished fiery copper.
            out.sky_top = mix(out.sky_top, mix(vec3(0.28, 0.24, 0.25), vec3(0.26, 0.18, 0.18), v), near_set * mix(0.65, 0.80, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.66, 0.54, 0.44), vec3(0.86, 0.48, 0.24), v), near_set * mix(0.70, 0.88, v))
            out.haze = mix(out.haze, mix(vec3(0.56, 0.46, 0.38), vec3(0.68, 0.42, 0.24), v), near_set * mix(0.65, 0.80, v))
            out.sea_deep = mix(out.sea_deep, vec3(0.07, 0.08, 0.13), near_set * 0.60)
            out.sun = mix(out.sun, mix(vec3(0.84, 0.52, 0.32), vec3(1.12, 0.54, 0.22), v), near_set * 0.75)
            out.glint_sun = mix(out.sun, mix(vec3(0.88, 0.52, 0.30), vec3(1.26, 0.52, 0.18), v), near_set * 0.90)
            out.glare = min(out.glare, mix(1.0, mix(0.40, 0.52, v), near_set))
            gl_m = mix(vec3(0.64, 0.42, 0.28), vec3(0.74, 0.42, 0.25), s)
            gl_b = mix(vec3(0.84, 0.40, 0.16), vec3(0.92, 0.34, 0.12), s)
            gh_m = mix(vec3(0.68, 0.58, 0.46), vec3(0.74, 0.58, 0.44), s)
            gh_b = mix(vec3(0.82, 0.56, 0.34), vec3(0.86, 0.50, 0.28), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.44, 0.38, 0.36), vec3(0.60, 0.45, 0.38), s), twilight)
            out.glow_sea = mix(out.glow_sea, mix(vec3(0.32, 0.19, 0.11), vec3(0.50, 0.22, 0.08), v), twilight)
            out.sunset_warm = mix(out.sunset_warm, mix(vec3(0.78, 0.46, 0.28), vec3(0.92, 0.40, 0.14), v), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.44, 0.34, 0.32), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), mix(vec3(0.74, 0.72, 0.72), vec3(0.92, 0.70, 0.58), v), near_set * 0.80)
            boost_band(0.78, 1.04)
        .rose:
            # Regional wildfire smoke: coral -> pale red -> rose -> burgundy; muted NON-pink opposite sky.
            out.sky_top = mix(out.sky_top, mix(vec3(0.16, 0.18, 0.29), vec3(0.14, 0.15, 0.28), v), near_set * mix(0.65, 0.80, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.64, 0.52, 0.52), vec3(0.82, 0.44, 0.50), v), near_set * mix(0.65, 0.85, v))
            out.haze = mix(out.haze, mix(vec3(0.50, 0.43, 0.45), vec3(0.60, 0.38, 0.44), v), near_set * mix(0.60, 0.78, v))
            out.sea_deep = mix(out.sea_deep, vec3(0.06, 0.08, 0.16), near_set * 0.55)
            out.sun = mix(out.sun, mix(vec3(0.94, 0.62, 0.58), vec3(1.18, 0.56, 0.58), v), near_set * 0.75)
            out.glint_sun = mix(out.sun, mix(vec3(1.00, 0.58, 0.60), vec3(1.34, 0.46, 0.56), v), near_set * 0.90)
            out.glare = min(out.glare, mix(1.0, mix(0.52, 0.58, v), near_set))
            gl_m = mix(vec3(0.68, 0.42, 0.44), vec3(0.80, 0.44, 0.48), s)
            gl_b = mix(vec3(0.88, 0.34, 0.44), vec3(0.96, 0.28, 0.44), s)
            gh_m = mix(vec3(0.68, 0.56, 0.56), vec3(0.74, 0.58, 0.58), s)
            gh_b = mix(vec3(0.82, 0.48, 0.56), vec3(0.88, 0.44, 0.56), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
            # Opposite belt stays dusky neutral taupe (not all-pink sky)
            out.glow_belt = mix(base_belt, mix(vec3(0.42, 0.39, 0.43), vec3(0.54, 0.47, 0.50), s), twilight)
            out.glow_sea = mix(out.glow_sea, mix(vec3(0.35, 0.20, 0.24), vec3(0.54, 0.20, 0.30), v), twilight)
            out.sunset_warm = mix(out.sunset_warm, mix(vec3(0.84, 0.50, 0.52), vec3(0.96, 0.36, 0.48), v), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.44, 0.34, 0.42), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), mix(vec3(0.82, 0.80, 1.05), vec3(0.94, 0.72, 1.12), v), near_set * 0.80)
            boost_band(0.82, 1.06)
        .magenta:
            # Volcanic stratospheric layer: warm-white / pale-rose disc, magenta carried by the glow
            # and twilight sky; bold end = dramatic vivid magenta twilight; zenith stays deep indigo.
            out.sky_top = mix(out.sky_top, mix(vec3(0.11, 0.13, 0.30), vec3(0.10, 0.08, 0.28), v), twilight * mix(0.78, 0.90, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.76, 0.48, 0.60), vec3(0.94, 0.34, 0.64), v), near_set * mix(0.65, 0.88, v))
            out.haze = mix(out.haze, mix(vec3(0.52, 0.37, 0.48), vec3(0.64, 0.30, 0.52), v), near_set * mix(0.55, 0.78, v))
            out.sea_deep = mix(out.sea_deep, mix(vec3(0.07, 0.07, 0.19), vec3(0.08, 0.05, 0.20), v), near_set * 0.60)
            out.sun = mix(out.sun, mix(vec3(1.16, 0.78, 0.72), vec3(1.28, 0.68, 0.80), v), near_set * 0.68)
            out.glint_sun = mix(out.sun, mix(vec3(1.18, 0.62, 0.80), vec3(1.42, 0.42, 0.92), v), near_set * 0.92)
            out.glare = min(out.glare, mix(1.0, mix(0.74, 0.64, v), near_set))
            gl_m = mix(vec3(0.76, 0.34, 0.56), vec3(0.88, 0.38, 0.58), s)
            gl_b = mix(vec3(0.94, 0.20, 0.60), vec3(1.00, 0.18, 0.58), s)
            gh_m = mix(vec3(0.64, 0.36, 0.60), vec3(0.72, 0.39, 0.63), s)
            gh_b = mix(vec3(0.80, 0.22, 0.70), vec3(0.88, 0.22, 0.74), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.40, 0.33, 0.46), vec3(0.62, 0.36, 0.58), s), twilight)
            out.glow_sea = mix(out.glow_sea, mix(vec3(0.38, 0.18, 0.30), vec3(0.58, 0.14, 0.42), v), twilight)
            out.sunset_warm = mix(out.sunset_warm, mix(vec3(0.88, 0.40, 0.62), vec3(1.00, 0.22, 0.66), v), twilight)
            out.sunset_shade = mix(out.sunset_shade, mix(vec3(0.48, 0.30, 0.46), vec3(0.54, 0.22, 0.48), v), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), mix(vec3(0.92, 0.86, 1.35), vec3(0.98, 0.76, 1.55), v), near_set * 0.82)
            if out.afterglow.x > 0.001:
                out.afterglow.x = min(out.afterglow.x * mix(0.92, 1.10, v) * (1.0 + 0.18 * post_set), 1.0)
                out.afterglow.y *= mix(1.0, 0.76, post_set)
        .lilac:
            # Volcanic twilight: warm cream disc, cool lilac halo over warm horizon strip; persists post-set.
            out.sky_top = mix(out.sky_top, mix(vec3(0.11, 0.14, 0.30), vec3(0.10, 0.11, 0.32), v), twilight * mix(0.65, 0.82, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.78, 0.64, 0.62), vec3(0.92, 0.64, 0.54), v), near_set * mix(0.60, 0.82, v))
            out.haze = mix(out.haze, mix(vec3(0.50, 0.44, 0.54), vec3(0.56, 0.42, 0.68), v), near_set * mix(0.55, 0.76, v))
            out.sea_deep = mix(out.sea_deep, vec3(0.05, 0.08, 0.20), near_set * 0.58)
            out.sun = mix(out.sun, mix(vec3(1.16, 0.88, 0.76), vec3(1.26, 0.88, 0.82), v), near_set * 0.68)
            out.glint_sun = mix(out.sun, mix(vec3(1.12, 0.86, 0.90), vec3(1.16, 0.78, 1.24), v), near_set * 0.92)
            out.glare = min(out.glare, mix(1.0, mix(0.74, 0.62, v), near_set))
            # Warm amber-apricot low horizon strip under a luminous cool lilac arch above
            gl_m = mix(vec3(0.78, 0.56, 0.48), vec3(0.88, 0.62, 0.46), s)
            gl_b = mix(vec3(0.92, 0.60, 0.42), vec3(0.98, 0.60, 0.36), s)
            gh_m = mix(vec3(0.64, 0.52, 0.76), vec3(0.68, 0.56, 0.78), s)
            gh_b = mix(vec3(0.66, 0.44, 0.96), vec3(0.70, 0.42, 0.98), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.42, 0.40, 0.54), vec3(0.58, 0.46, 0.72), s), twilight)
            out.glow_sea = mix(out.glow_sea, mix(vec3(0.32, 0.25, 0.38), vec3(0.44, 0.28, 0.58), v), twilight)
            out.sunset_warm = mix(out.sunset_warm, mix(vec3(0.74, 0.60, 0.82), vec3(0.72, 0.48, 0.98), v), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.42, 0.36, 0.58), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), mix(vec3(0.88, 0.96, 1.38), vec3(0.86, 0.90, 1.65), v), near_set * 0.82)
            if out.afterglow.x > 0.001:
                out.afterglow.x = min(out.afterglow.x * mix(0.92, 1.10, v) * (1.0 + 0.22 * post_set), 1.0)
                out.afterglow.y *= mix(1.0, 0.72, post_set)
        .blue:
            # Exceptional aged smoke: unmistakably blue -> indigo sun; muted = smoky steel-blue,
            # bold = dramatic cerulean-indigo glow & sapphire sea glitter.
            out.sky_top = mix(out.sky_top, mix(vec3(0.15, 0.22, 0.34), vec3(0.06, 0.14, 0.38), v), smoke * mix(0.78, 0.90, v))
            out.sky_horizon = mix(out.sky_horizon, mix(vec3(0.46, 0.55, 0.66), vec3(0.30, 0.54, 0.88), v), smoke * mix(0.82, 0.92, v))
            out.haze = mix(out.haze, mix(vec3(0.40, 0.48, 0.58), vec3(0.28, 0.46, 0.74), v), smoke * mix(0.80, 0.88, v))
            out.sea_deep = mix(out.sea_deep, mix(vec3(0.04, 0.08, 0.16), vec3(0.03, 0.08, 0.24), v), smoke * 0.70)
            out.sun = mix(out.sun, mix(vec3(0.62, 0.78, 0.96), vec3(0.58, 0.84, 1.24), v), smoke * 0.82)
            out.glint_sun = mix(out.sun, mix(vec3(0.60, 0.82, 1.04), vec3(0.44, 0.84, 1.44), v), smoke * 0.94)
            out.glare = min(out.glare, mix(1.0, mix(0.42, 0.56, v), smoke))
            gl_m = mix(vec3(0.42, 0.52, 0.64), vec3(0.46, 0.56, 0.72), s)
            gl_b = mix(vec3(0.24, 0.54, 0.92), vec3(0.20, 0.46, 0.96), s)
            gh_m = mix(vec3(0.36, 0.48, 0.66), vec3(0.38, 0.52, 0.74), s)
            gh_b = mix(vec3(0.18, 0.42, 0.86), vec3(0.16, 0.34, 0.84), s)
            out.glow_low = mix(base_low, mix(gl_m, gl_b, v), twilight)
            out.glow_high = mix(base_high, mix(gh_m, gh_b, v), twilight)
