# The day's air and sunset palettes: how clear or thick the low air is on a given day, and which
# atmospheric palette colours the sun disc, near-sun aureole, twilight sky and sea glitter.
#
# One air kind and one sunset palette for the whole day, the same for everyone (from the day's
# number), nudged by the weather where they stand: a clean wind keeps the air clear, rain or a deck
# under cloud makes it humid. Exceptional stratospheric volcanic layers persist for several days;
# aged-smoke cool-disc events for a day or two; rare kinds stay rare (~85% routine, ~14% hazy/dust/
# smoke, ~1% exceptional, favouring subtle volcanic glows over full cool discs).
#
#   DayAir:
#     clear       clear maritime baseline
#     hazy        summer haze: disc warms from ~15 deg up, glow broader
#     dusty       Saharan dust: buff-veiled sky, flatter warmer light, disc muted from ~20 deg
#     heavy       heavy dust outbreak (~1 day in 25): thick buff veil, dim warm light
#     humid       damp coastal air: softer, broader aureole
#     washed      day after rain or clean meltemi: crisp air, yellow-gold almost to the water
#
#   SunsetPalette (grounded in the solar colour field guide):
#     amber       clear maritime: ivory -> pale yellow -> gold -> amber (routine; need not end red)
#     red         existing red baseline: cream-white core, strong red aureole, orange/scarlet sky
#     peach       humid / coastal haze: cream -> peach -> coral, softer broader aureole (routine)
#     copper      Saharan dust: muted copper / rust / crimson, buff-veiled sky (episodic; not neon)
#     rose        regional smoke: coral -> rose -> burgundy, muted non-pink sky (episodic)
#     magenta     volcanic stratospheric: warm-white / pale-rose disc, magenta-led glow (exceptional)
#     lilac       volcanic twilight: warm cream disc, cool lilac halo over warm horizon (exceptional)
#     blue        aged smoke: attenuated blue / indigo disc, restrained slate glow (very rare)
#     purple      aged smoke: attenuated lavender / purple disc, restrained plum glow (very rare)
#     green       aged smoke: attenuated blue-green / pale green disc, sage glow (very rare)
#
#   HorizonFlash (independent refraction event at a clear sea horizon):
#     none, green, blue (rare; washed/very clear air only)
#
# Everything here is worked out on the CPU, once a frame: the sky, sea and disc shaders only take
# the Light it gives them. Environment overrides (captures):
#   AEGEAN_SKY_AIR=clear|hazy|dusty|heavy|humid|washed
#   AEGEAN_SUNSET=amber|red|peach|copper|rose|magenta|lilac|blue|purple|green
#   AEGEAN_FLASH=none|green|blue
use 'look.jo'

enum DayAir: clear, hazy, dusty, heavy, humid, washed
enum SunsetPalette: amber, red, peach, copper, rose, magenta, lilac, blue, purple, green
enum HorizonFlash: none, green, blue

day_air_names = ["clear", "hazy", "dusty", "heavy", "humid", "washed"]
day_air_labels = ["Clear", "Hazy", "Dusty", "Heavy dust", "Humid", "Washed"]
day_air_kinds = [DayAir.clear, DayAir.hazy, DayAir.dusty, DayAir.heavy, DayAir.humid, DayAir.washed]
day_air_forced: DayAir? = none

sunset_palette_names = ["amber", "red", "peach", "copper", "rose", "magenta", "lilac", "blue", "purple", "green"]
sunset_palette_labels = ["Amber (clear)", "Red (baseline)", "Peach (humid)", "Copper (dust)", "Rose (smoke)", "Magenta glow (volcanic)", "Lilac halo (volcanic)", "Blue sun (rare)", "Purple sun (rare)", "Green sun (rare)"]
sunset_palette_kinds = [SunsetPalette.amber, SunsetPalette.red, SunsetPalette.peach, SunsetPalette.copper, SunsetPalette.rose, SunsetPalette.magenta, SunsetPalette.lilac, SunsetPalette.blue, SunsetPalette.purple, SunsetPalette.green]
sunset_palette_forced: SunsetPalette? = none

horizon_flash_names = ["none", "green", "blue"]
horizon_flash_labels = ["Off", "Green flash", "Blue flash"]
horizon_flash_kinds = [HorizonFlash.none, HorizonFlash.green, HorizonFlash.blue]
horizon_flash_forced: HorizonFlash? = none

_day_air_env = env("AEGEAN_SKY_AIR") ?? ""
loop k in 0..day_air_names.len():
    if _day_air_env == day_air_names[k]: day_air_forced = day_air_kinds[k]

_sunset_env = env("AEGEAN_SUNSET") ?? ""
loop k in 0..sunset_palette_names.len():
    if _sunset_env == sunset_palette_names[k]: sunset_palette_forced = sunset_palette_kinds[k]

_flash_env = env("AEGEAN_FLASH") ?? ""
loop k in 0..horizon_flash_names.len():
    if _flash_env == horizon_flash_names[k]: horizon_flash_forced = horizon_flash_kinds[k]

set_day_air_forced = (k: DayAir?):
    global day_air_forced
    day_air_forced = k

set_sunset_palette_forced = (p: SunsetPalette?):
    global sunset_palette_forced
    sunset_palette_forced = p

set_horizon_flash_forced = (f: HorizonFlash?):
    global horizon_flash_forced
    horizon_flash_forced = f

day_air_forced_index = () -> int:
    if let k = day_air_forced: int(k) else: -1

sunset_palette_forced_index = () -> int:
    if let p = sunset_palette_forced: int(p) else: -1

horizon_flash_forced_index = () -> int:
    if let f = horizon_flash_forced: int(f) else: -1

# (small integer hashes of the day's number: the same day, the same air & sunset, for everyone)
_day_hash = (day: int) -> f64:
    x = (day * 1103515245 + 12345) % 2147483647
    x = (x * 48271) % 2147483647
    if x < 0: x = -x
    f64(x % 10000) / 10000.0

_day_hash_salt = (day: int, salt: int) -> f64:
    x = ((day * 1664525 + salt * 1013904223 + 374761393) % 2147483647)
    x = ((x * 69069 + salt * 13 + 1) % 2147483647)
    if x < 0: x = -x
    f64(x % 100000) / 100000.0

# The day's kind. rain, deck and clarity are the weather where the eye is (living_conditions.jo
# WeatherAir): rain or a low deck mean damp air; a clearing wind (clarity over 1) clean air.
day_air_kind = (day: int, rain: f32, deck: f32, clarity: f32) -> DayAir:
    if let k = day_air_forced: return k
    u = _day_hash(day)
    if rain > 0.05 or deck > 0.3: return .humid
    if clarity > 1.25: return if u < 0.5: .clear else: .washed
    # (about a third of days clear, a quarter hazy, one in twelve dusty, one in 25 heavy dust, one
    # in seven humid, the rest washed)
    if u < 0.34: return .clear
    if u < 0.58: return .hazy
    if u < 0.66: return .dusty
    if u < 0.70: return .heavy
    if u < 0.84: return .humid
    .washed

# Which sunset palette belongs to this day's air and weather.
# Exceptional stratospheric volcanic layers persist for 3 days (~0.85% of days, favouring magenta
# and lilac glows); aged-smoke cool discs persist for 2 days (~0.15% of days: blue, purple, green).
# Ordinary days follow the day's air: ~85% routine (amber, red, peach), ~14% episodic dust/smoke
# (copper, rose, dusty red), ~1% exceptional.
sunset_palette_kind = (day: int, air: DayAir, rain: f32 = 0.0, deck: f32 = 0.0, clarity: f32 = 1.0) -> SunsetPalette:
    if let p = sunset_palette_forced: return p
    # Exceptional aerosol events (suppressed only under active rain or thick low overcast; volcanic
    # stratospheric layers can colour an otherwise clear-looking evening far from their source)
    if rain < 0.2 and deck < 0.75:
        v_block = if day >= 0: day / 3 else: (day - 2) / 3
        v = _day_hash_salt(v_block, 71)
        if v < 0.0085:
            return if v < 0.0060: .magenta else: .lilac
        s_block = if day >= 0: day / 2 else: (day - 1) / 2
        s = _day_hash_salt(s_block, 193)
        if s < 0.0015:
            if s < 0.0007: return .blue
            if s < 0.0011: return .purple
            return .green
    u = _day_hash_salt(day, 31)
    match air:
        .washed:
            if u < 0.80: .amber
            else if u < 0.90: .peach
            else: .red
        .clear:
            if u < 0.55: .amber
            else if u < 0.85: .red
            else: .peach
        .humid:
            if u < 0.65: .peach
            else if u < 0.85: .red
            else: .amber
        .hazy:
            if u < 0.55: .red
            else if u < 0.80: .peach
            else if u < 0.92: .rose
            else: .amber
        .dusty:
            if u < 0.55: .copper
            else if u < 0.80: .red
            else: .rose
        .heavy:
            if u < 0.65: .copper
            else if u < 0.85: .red
            else: .rose

# Canonical air for a forced palette when the user didn't also force a specific DayAir (and mild
# aged-smoke haze when a natural rare cool-disc event occurs on an otherwise clear day).
sunset_effective_air = (air: DayAir, pal: SunsetPalette) -> DayAir:
    if day_air_forced != none: return air
    if sunset_palette_forced != none:
        return match pal:
            .amber: .clear
            .red: .hazy
            .peach: .humid
            .copper: .dusty
            .rose: .hazy
            .magenta: .clear
            .lilac: .clear
            .blue: .hazy
            .purple: .hazy
            .green: .hazy
    if (pal == .blue or pal == .purple or pal == .green) and (air == .clear or air == .washed):
        return .hazy
    air

# Independent refraction horizon flash (green, occasionally rare blue): requires clear sea air and
# an unobstructed horizon; never appears in haze, dust, rain, fog, storm or overcast.
horizon_flash_kind = (day: int, air: DayAir, rain: f32 = 0.0, deck: f32 = 0.0, fog: f32 = 0.0, storm: f32 = 0.0, clarity: f32 = 1.0) -> HorizonFlash:
    if let f = horizon_flash_forced: return f
    if air != .clear and air != .washed: return .none
    if rain > 0.02 or deck > 0.15 or fog > 0.05 or storm > 0.05: return .none
    u = _day_hash_salt(day, 509)
    if air == .washed or clarity > 1.2:
        if u < 0.03: return .blue
        if u < 0.21: return .green
        return .none
    if u < 0.08: .green else: .none

# How thick the low air is: 0 the baseline, 1 for dust, 1.4 for heavy dust; below 0 cleaner than usual.
day_air_turbidity = (k: DayAir) -> f32:
    match k:
        .hazy: 0.6
        .dusty: 1.0
        .heavy: 1.4
        .humid: 0.45
        .washed: -0.4
        _: 0.0

# The low sun's light through that air (multiplies Light.sun while the sun is low).
day_air_sun_tint = (k: DayAir) -> vec3:
    match k:
        .dusty: vec3(1.0, 0.72, 0.48)
        .heavy: vec3(1.0, 0.6, 0.36)
        .hazy: vec3(1.0, 0.84, 0.64)
        .humid: vec3(1.0, 0.86, 0.78)
        _: vec3(1, 1, 1)

# The light of the day's air (baseline red palette): the sun's light warmer and dimmer low down in
# thick air, the glow band broader and reddened from a higher sun, the haze warmer; in washed air
# the band narrower.
day_air_light = (L: Light, k: DayAir) -> Light:
    t = day_air_turbidity(k)
    out = L
    out.turbidity = t
    if t == 0.0: return out
    el = f64(normalize(L.sun_dir).y)
    up = el > -0.05
    if t > 0.0:
        low = f32(clamp(1.0 - el / 0.42, 0.0, 1.0))
        # (in thick air the sun's light is warmed from higher up: dust reddens a sun 25 degrees up)
        high = f32(clamp(1.0 - el / (0.42 + 0.2 * f64(t)), 0.0, 1.0))
        out.sun = L.sun * mix(vec3(1, 1, 1), day_air_sun_tint(k), t * high)
        out.haze = mix(L.haze, L.haze * vec3(1.04, 0.92, 0.84), t * low * 0.6)
        # (dust and haze make the whole sky milky, all day and more with a low sun: a pale buff-grey
        # veil from the horizon well up past the sun, the blue weak and only overhead, no bright
        # glare round the disc, and a flatter, warmer light on everything)
        veil = (if k == .heavy: 0.92 else: if k == .dusty: 0.82 else: if k == .hazy: 0.45 else: 0.2) * (0.6 + 0.4 * high)
        bright = dot(L.sky_horizon, vec3(0.3, 0.5, 0.2))
        buff = vec3(0.88, 0.8, 0.68) * bright * 1.15
        out.sky_horizon = mix(L.sky_horizon, buff, veil)
        out.sky_top = mix(L.sky_top, buff * 0.92, veil * 0.85)
        out.haze = mix(out.haze, buff * 0.96, veil * 0.8)
        out.glare = 1.0 - 0.85 * veil
        out.sun = out.sun * (1.0 - 0.28 * veil)
        out.shade = mix(L.shade, out.sun * 0.5, 0.35 * veil)
        if up:
            # (the hot band from a sun as high as about 24 degrees, broader in thicker air)
            reach = f32(smoothstep(0.42, 0.1, el))
            toward = normalize(vec2(L.sun_dir.x, L.sun_dir.z) + vec2(0.00001, 0))
            glow = max(L.afterglow.x, min(t * 0.75 * reach, 1.0))
            band = (if L.afterglow.x > 0.0: 1.0 / L.afterglow.y else: 0.22) * (1.0 + 0.8 * t)
            if glow > 0.001: out.afterglow = vec4(glow, 1.0 / band, toward.x, toward.y)
            out.sunset = max(L.sunset, min(t, 1.0) * f32(smoothstep(0.42, 0.05, el)))
            out.glow_low = mix(vec3(0.92, 0.53, 0.25), vec3(1.0, 0.42, 0.12), out.sunset)
            out.glow_high = mix(vec3(0.93, 0.8, 0.55), vec3(0.94, 0.58, 0.5), out.sunset)
            out.glow_belt = mix(vec3(0.5, 0.38, 0.44), vec3(0.86, 0.6, 0.66), out.sunset)
    else:
        # (clean air: the band narrower and the haze a little bluer)
        if L.afterglow.x > 0.0: out.afterglow.y = L.afterglow.y * (1.0 - t * 0.8)
        out.haze = mix(L.haze, L.haze * vec3(0.94, 1.0, 1.06), -t)
    out

# Full sunset & twilight lighting for a day's air, palette and optional horizon flash.
# Keeps the sun disc, near-sun glow, twilight sky and sea glitter coherent as separate layers:
# midday remains ordinary Mediterranean daylight, night remains deep navy, and transitions with
# elevation are smooth. Preserves the existing red look verbatim when pal == .red.
sunset_light = (L: Light, k: DayAir, pal: SunsetPalette, flash: HorizonFlash = .none) -> Light:
    out = day_air_light(L, k)
    out.sunset_kind = int(pal)
    out.horizon_flash = int(flash)
    if pal == .red: return out

    el = f64(normalize(L.sun_dir).y)
    # Smooth envelope over golden hour -> sunset -> twilight -> blue hour (0 by midday and night)
    twilight = f32(smoothstep(-0.52, -0.26, el) * (1.0 - smoothstep(0.06, 0.42, el)))
    # Peak right around sunset (sun near horizon)
    near_set = f32(smoothstep(-0.22, -0.02, el) * (1.0 - smoothstep(0.04, 0.36, el)))
    # Post-sunset volcanic twilight persistence (strongest just after the disc goes down)
    post_set = f32(smoothstep(-0.42, -0.18, el) * (1.0 - smoothstep(-0.04, 0.08, el)))
    s = out.sunset
    # Baseline dusk->sunset band colours for smooth blending
    base_low = mix(vec3(0.92, 0.53, 0.25), vec3(1.0, 0.42, 0.12), s)
    base_high = mix(vec3(0.93, 0.80, 0.55), vec3(0.94, 0.58, 0.50), s)
    base_belt = mix(vec3(0.50, 0.38, 0.44), vec3(0.86, 0.60, 0.66), s)

    match pal:
        .amber:
            # Clear maritime: bright ivory -> gold -> amber; dry clear day need not end in scarlet
            out.sky_top = mix(out.sky_top, vec3(0.11, 0.22, 0.46), near_set * 0.55)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.92, 0.76, 0.54), near_set * 0.65)
            out.haze = mix(out.haze, vec3(0.66, 0.56, 0.46), near_set * 0.55)
            out.sea_deep = mix(out.sea_deep, vec3(0.04, 0.11, 0.26), near_set * 0.55)
            out.sun = mix(out.sun, vec3(1.28, 0.96, 0.50), near_set * 0.75)
            out.glint_sun = mix(out.sun, vec3(1.32, 0.98, 0.48), near_set * 0.85)
            out.glare = min(out.glare, mix(1.0, 0.72, near_set))
            out.glow_low = mix(base_low, mix(vec3(0.90, 0.66, 0.30), vec3(0.96, 0.70, 0.24), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.94, 0.86, 0.62), vec3(0.97, 0.86, 0.54), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.46, 0.46, 0.54), vec3(0.76, 0.68, 0.62), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.44, 0.33, 0.14), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(1.0, 0.76, 0.34), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.46, 0.42, 0.52), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(1.0, 1.18, 1.12), near_set * 0.7)
        .peach:
            # Humid / coastal haze: cream -> peach / coral, softer broader aureole
            out.sky_top = mix(out.sky_top, vec3(0.17, 0.21, 0.40), near_set * 0.45)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.91, 0.69, 0.62), near_set * 0.60)
            out.haze = mix(out.haze, vec3(0.66, 0.52, 0.52), near_set * 0.50)
            out.sea_deep = mix(out.sea_deep, vec3(0.06, 0.09, 0.22), near_set * 0.40)
            out.sun = mix(out.sun, vec3(1.18, 0.80, 0.62), near_set * 0.65)
            out.glint_sun = mix(out.sun, vec3(1.24, 0.78, 0.58), near_set * 0.85)
            out.glow_low = mix(base_low, mix(vec3(0.88, 0.58, 0.46), vec3(0.94, 0.58, 0.44), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.93, 0.78, 0.70), vec3(0.96, 0.76, 0.66), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.52, 0.44, 0.50), vec3(0.78, 0.60, 0.64), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.42, 0.26, 0.20), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.96, 0.64, 0.50), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.52, 0.38, 0.46), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.96, 0.98, 1.18), near_set * 0.7)
        .copper:
            # Saharan dust: muted amber / copper / rust / crimson in a buff-veiled sky (never neon)
            out.sky_top = mix(out.sky_top, vec3(0.28, 0.24, 0.25), near_set * 0.65)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.66, 0.54, 0.44), near_set * 0.70)
            out.haze = mix(out.haze, vec3(0.56, 0.46, 0.38), near_set * 0.65)
            out.sea_deep = mix(out.sea_deep, vec3(0.07, 0.08, 0.13), near_set * 0.60)
            out.sun = mix(out.sun, vec3(0.84, 0.52, 0.32), near_set * 0.70)
            out.glint_sun = mix(out.sun, vec3(0.88, 0.52, 0.30), near_set * 0.85)
            out.glare = min(out.glare, mix(1.0, 0.42, near_set))
            out.glow_low = mix(base_low, mix(vec3(0.64, 0.42, 0.28), vec3(0.74, 0.42, 0.25), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.68, 0.58, 0.46), vec3(0.74, 0.58, 0.44), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.44, 0.38, 0.36), vec3(0.56, 0.47, 0.43), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.32, 0.19, 0.11), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.78, 0.46, 0.28), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.44, 0.35, 0.34), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.74, 0.72, 0.72), near_set * 0.8)
            # Soften over-bright glow band in dust so it stays muted rather than luminous orange
            out.afterglow.x *= mix(1.0, 0.78, near_set)
        .rose:
            # Regional wildfire smoke / tonal rose: rose/burgundy disc, muted NON-pink sky
            out.sky_top = mix(out.sky_top, vec3(0.16, 0.18, 0.29), near_set * 0.65)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.64, 0.52, 0.52), near_set * 0.65)
            out.haze = mix(out.haze, vec3(0.50, 0.43, 0.45), near_set * 0.60)
            out.sea_deep = mix(out.sea_deep, vec3(0.06, 0.08, 0.16), near_set * 0.55)
            out.sun = mix(out.sun, vec3(0.94, 0.62, 0.58), near_set * 0.70)
            out.glint_sun = mix(out.sun, vec3(1.00, 0.58, 0.60), near_set * 0.85)
            out.glare = min(out.glare, mix(1.0, 0.52, near_set))
            # Localized muted rose near sun; opposite belt stays dusky neutral taupe (not all-pink sky)
            out.glow_low = mix(base_low, mix(vec3(0.68, 0.42, 0.44), vec3(0.80, 0.44, 0.48), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.68, 0.56, 0.56), vec3(0.74, 0.58, 0.58), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.42, 0.39, 0.43), vec3(0.56, 0.49, 0.51), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.35, 0.20, 0.24), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.84, 0.50, 0.52), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.44, 0.35, 0.42), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.82, 0.80, 1.05), near_set * 0.8)
            out.afterglow.x *= mix(1.0, 0.82, near_set)
        .magenta:
            # Volcanic stratospheric layer: warm-white / pale-rose disc, magenta carried by the glow;
            # persists strongly after sunset; zenith stays dusky slate-indigo (no uniform purple wash)
            out.sky_top = mix(out.sky_top, vec3(0.11, 0.13, 0.30), twilight * 0.78)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.76, 0.48, 0.60), near_set * 0.65)
            out.haze = mix(out.haze, vec3(0.52, 0.37, 0.48), near_set * 0.55)
            out.sea_deep = mix(out.sea_deep, vec3(0.07, 0.07, 0.19), near_set * 0.55)
            # Keep direct sunlight believable warm-rose so whitewash doesn't turn neon fuchsia
            out.sun = mix(out.sun, vec3(1.16, 0.78, 0.72), near_set * 0.65)
            out.glint_sun = mix(out.sun, vec3(1.18, 0.62, 0.80), near_set * 0.85)
            out.glow_low = mix(base_low, mix(vec3(0.76, 0.34, 0.56), vec3(0.88, 0.38, 0.58), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.64, 0.36, 0.60), vec3(0.72, 0.39, 0.63), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.40, 0.33, 0.46), vec3(0.54, 0.42, 0.54), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.38, 0.18, 0.30), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.88, 0.40, 0.62), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.48, 0.30, 0.46), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.92, 0.86, 1.35), near_set * 0.8)
            if out.afterglow.x > 0.001:
                out.afterglow.x = min(out.afterglow.x * (1.0 + 0.18 * post_set), 1.0)
                out.afterglow.y *= mix(1.0, 0.78, post_set)
            out.bishops_ring = f32(smoothstep(-0.02, 0.08, el) * (1.0 - smoothstep(0.25, 0.60, el))) * 0.28
        .lilac:
            # Volcanic twilight: warm cream disc, soft cool lilac halo over a warm horizon strip;
            # strengthens after the disc is gone; overhead stays cool slate-navy
            out.sky_top = mix(out.sky_top, vec3(0.11, 0.14, 0.30), twilight * 0.65)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.78, 0.64, 0.62), near_set * 0.60)
            out.haze = mix(out.haze, vec3(0.50, 0.44, 0.54), near_set * 0.55)
            out.sea_deep = mix(out.sea_deep, vec3(0.05, 0.08, 0.19), near_set * 0.55)
            out.sun = mix(out.sun, vec3(1.16, 0.88, 0.76), near_set * 0.65)
            out.glint_sun = mix(out.sun, vec3(1.12, 0.86, 0.90), near_set * 0.85)
            # Warm horizon strip under a cool lilac arch above
            out.glow_low = mix(base_low, mix(vec3(0.78, 0.56, 0.48), vec3(0.88, 0.62, 0.46), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.64, 0.52, 0.76), vec3(0.68, 0.56, 0.78), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.42, 0.40, 0.54), vec3(0.54, 0.48, 0.62), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.32, 0.25, 0.38), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.74, 0.60, 0.82), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.42, 0.38, 0.54), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.88, 0.96, 1.38), near_set * 0.8)
            if out.afterglow.x > 0.001:
                out.afterglow.x = min(out.afterglow.x * (1.0 + 0.22 * post_set), 1.0)
                out.afterglow.y *= mix(1.0, 0.72, post_set)
            out.bishops_ring = f32(smoothstep(-0.02, 0.08, el) * (1.0 - smoothstep(0.25, 0.60, el))) * 0.36
        .blue:
            # Exceptional aged smoke: attenuated pale steel-blue / indigo disc over a muted smoky
            # slate-grey sky (no vivid electric blue)
            smoke = f32(smoothstep(-0.35, -0.05, el) * (1.0 - smoothstep(0.25, 0.55, el)))
            out.sky_top = mix(out.sky_top, vec3(0.18, 0.22, 0.30), smoke * 0.78)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.52, 0.55, 0.59), smoke * 0.82)
            out.haze = mix(out.haze, vec3(0.46, 0.49, 0.53), smoke * 0.80)
            out.sea_deep = mix(out.sea_deep, vec3(0.05, 0.08, 0.14), smoke * 0.65)
            out.sun = mix(out.sun, vec3(0.68, 0.76, 0.86), smoke * 0.75)
            out.glint_sun = mix(out.sun, vec3(0.70, 0.82, 0.94), smoke * 0.90)
            out.glare = min(out.glare, mix(1.0, 0.45, smoke))
            out.glow_low = mix(base_low, mix(vec3(0.48, 0.50, 0.54), vec3(0.56, 0.57, 0.62), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.40, 0.48, 0.60), vec3(0.44, 0.54, 0.66), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.36, 0.38, 0.42), vec3(0.44, 0.46, 0.50), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.22, 0.28, 0.36), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.46, 0.58, 0.72), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.38, 0.42, 0.48), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.52, 0.92, 1.85), smoke * 0.85)
            out.afterglow.x *= mix(1.0, 0.72, near_set)
        .purple:
            # Exceptional aged smoke / volcanic: attenuated lavender / purple disc over smoky taupe
            smoke = f32(smoothstep(-0.35, -0.05, el) * (1.0 - smoothstep(0.25, 0.55, el)))
            out.sky_top = mix(out.sky_top, vec3(0.18, 0.17, 0.26), smoke * 0.78)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.52, 0.48, 0.54), smoke * 0.82)
            out.haze = mix(out.haze, vec3(0.46, 0.43, 0.48), smoke * 0.80)
            out.sea_deep = mix(out.sea_deep, vec3(0.06, 0.06, 0.13), smoke * 0.65)
            out.sun = mix(out.sun, vec3(0.76, 0.68, 0.82), smoke * 0.75)
            out.glint_sun = mix(out.sun, vec3(0.80, 0.70, 0.88), smoke * 0.90)
            out.glare = min(out.glare, mix(1.0, 0.45, smoke))
            out.glow_low = mix(base_low, mix(vec3(0.48, 0.42, 0.48), vec3(0.56, 0.46, 0.54), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.44, 0.40, 0.52), vec3(0.50, 0.45, 0.58), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.36, 0.35, 0.39), vec3(0.44, 0.42, 0.46), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.26, 0.22, 0.32), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.54, 0.46, 0.64), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.40, 0.38, 0.46), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.58, 0.82, 1.75), smoke * 0.85)
            out.afterglow.x *= mix(1.0, 0.72, near_set)
        .green:
            # Exceptional aged smoke: attenuated pale sage-green / seafoam disc over olive-grey veil
            smoke = f32(smoothstep(-0.35, -0.05, el) * (1.0 - smoothstep(0.25, 0.55, el)))
            out.sky_top = mix(out.sky_top, vec3(0.18, 0.22, 0.22), smoke * 0.78)
            out.sky_horizon = mix(out.sky_horizon, vec3(0.50, 0.54, 0.48), smoke * 0.82)
            out.haze = mix(out.haze, vec3(0.45, 0.48, 0.44), smoke * 0.80)
            out.sea_deep = mix(out.sea_deep, vec3(0.05, 0.09, 0.10), smoke * 0.65)
            out.sun = mix(out.sun, vec3(0.72, 0.80, 0.68), smoke * 0.75)
            out.glint_sun = mix(out.sun, vec3(0.74, 0.84, 0.72), smoke * 0.90)
            out.glare = min(out.glare, mix(1.0, 0.45, smoke))
            out.glow_low = mix(base_low, mix(vec3(0.48, 0.50, 0.42), vec3(0.56, 0.56, 0.46), s), twilight)
            out.glow_high = mix(base_high, mix(vec3(0.44, 0.50, 0.46), vec3(0.48, 0.56, 0.50), s), twilight)
            out.glow_belt = mix(base_belt, mix(vec3(0.36, 0.39, 0.37), vec3(0.44, 0.46, 0.44), s), twilight)
            out.glow_sea = mix(out.glow_sea, vec3(0.24, 0.29, 0.24), twilight)
            out.sunset_warm = mix(out.sunset_warm, vec3(0.52, 0.62, 0.50), twilight)
            out.sunset_shade = mix(out.sunset_shade, vec3(0.38, 0.42, 0.38), twilight)
            out.cloud_sun_tint = mix(vec3(1, 1, 1), vec3(0.56, 1.05, 1.45), smoke * 0.85)
            out.afterglow.x *= mix(1.0, 0.72, near_set)
        _: pass
    out
