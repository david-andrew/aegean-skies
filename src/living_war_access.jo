# A blockade is a supplied force physically at a lane mouth, never a permanent town boolean.
use 'living_types.jo'
use 'living_far_types.jo'

blockade_unit = (w: World, place: int) -> int:
    if not (place in w.far.districts): return -1
    loop u in w.war.units:
        if u.retired or u.order<0 or u.vehicle<0 or not (u.order in w.war.orders): continue
        o=w.war.orders[u.order]; v=w.far.vehicles[u.vehicle]
        if o.task!=.blockade or o.target!=place or o.cancelled or o.expires<w.minute: continue
        crew=v.crew[0]+v.crew[1]+v.crew[2]
        if v.kind!=.ship or v.hull<=350 or crew<4 or u.supplied_until<w.minute or u.stock.qty[8]<100 or v.provisions.qty[3]<=0: continue
        if w.far.districts[place].controller==u.country: continue
        if length(v.pos-w.place_contexts[place].center)<=2500: return u.id
    -1

known_blockade = (w: World, origin: int, destination: int) -> bool:
    if not (origin in w.far.districts): return false
    loop r in w.far.districts[origin].reports:
        if r.kind=="blockade" and r.origin==destination and w.minute-r.occurred_minute<1440 and r.confidence>=600: return true
    false
