# Sparse town-data adapter. No terrain imports: headless simulations can publish test catalogs.
use 'living_types.jo'
use 'life_types.jo'
use 'living_content.jo'
use 'living_life_seed.jo'

publish_place_contexts = (w: mut World, version: int, contexts: LifePlaceContext[], capitals: int[]) -> bool:
    initialize_life(w)
    if version < 1 or contexts.len() == 0 or capitals.len() != w.countries.len(): return false
    staged: {int: LifePlaceContext}
    loop c in contexts:
        if c.id < 0 or c.id > 0x7fffffff or c.name == "" or c.id in staged or c.country < 0 or c.country >= w.countries.len(): return false
        if c.detailed < -1 or c.detailed >= w.places.len(): return false
        if c.detailed >= 0 and c.id != w.places[c.detailed].id: return false
        if not is_finite(c.center.x) or not is_finite(c.center.y) or not is_finite(c.center.z): return false
        keys: {str: bool}
        loop v in c.venues:
            if v.place != c.id or v.key == "" or v.key in keys or v.capacity < 1: return false
            keys[v.key] = true
        staged[c.id] = c
    loop id, c in staged:
        loop neighbor in c.neighbors:
            if not (neighbor in staged) or neighbor == id: return false
    loop country in 0..capitals.len():
        id = capitals[country]
        if id >= 0 and (not (id in staged) or staged[id].country != country): return false
    w.place_contexts = staged; w.place_catalog_version = version
    loop country in 0..capitals.len(): w.countries[country].capital_id = capitals[country]
    loop c in contexts:
        if c.detailed >= 0: w.place_country[c.detailed] = c.country
    true

life_place_name = (w: World, id: int) -> str:
    if id in w.place_contexts: return w.place_contexts[id].name
    if id >= 0 and id < w.places.len(): return PLACE_NAMES[id]
    "out at sea"

place_context = (w: World, id: int) -> LifePlaceContext?:
    if id in w.place_contexts: w.place_contexts[id] else: none
