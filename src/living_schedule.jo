# One recurring labor schedule, shared by actual credited work and speech. Absolute dates are
# derived from this day, never the opening day's shift obligation.
use 'living_types.jo'
work_periods = (occupation: Occupation) -> (int,int)[]: match occupation:
    .fisher: [(360,600)]
    .oil_presser, .miller: [(480,660)]
    .clerk, .patrol, .telegraphist: [(480,600),(840,960)]
    .teacher, .nurse, .priest: [(540,720)]
    _: []
work_role = (occupation: Occupation) -> bool: work_periods(occupation).len()>0
work_window = (occupation: Occupation, minute_of_day: int) -> bool:
    loop start,end in work_periods(occupation):
        if minute_of_day>=start and minute_of_day<end: return true
    false
current_shift_end = (occupation: Occupation, minute: int) -> int:
    clock=local_minute(minute)
    loop start,end in work_periods(occupation):
        if clock>=start and clock<end: return minute-clock+end
    -1
