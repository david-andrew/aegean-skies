# Closed, opaque splash bodies. One shared scalloped mesh, one instanced draw, no textures.
# Continuous float fans and detached emission envelopes use the same painted material.
use 'pilot.jo'
use 'flight.jo'
use 'flight_feedback.jo'
use 'planes.jo'
use 'damage.jo'
use 'flight_effects.jo'
use 'world_particles.jo'
use 'world_point.jo'
use 'sea.jo'
use 'look.jo'
use 'render_space.jo'
use 'depth_space.jo'
use 'curved_world.jo'

struct SplashVertex:
    pos:vec3
struct SplashInstance:
    center:vec4
    size:vec4
    back:vec4=vec4(0,0,1,0)
struct SplashParams:
    vp:mat4
    eye:vec3
    sun_dir:vec3
    white:vec3
    haze:vec3
    fog:f32
    warp_a:vec4
    warp_b:vec4
struct SplashOut:
    pos:vec4
    world:vec3
    normal:vec3
splash_vs=(v:SplashVertex,b:SplashInstance,u:SplashParams)->SplashOut:
    # Shape belongs to the body, never to the camera or screen. Broad lobes remain coherent
    # while smaller scallops slowly billow around them.
    n=v.pos
    scallop=1.0+0.10*sin(n.x*11.0+n.z*7.0+b.size.w)*sin(n.y*9.0-n.z*6.0+b.size.w*0.7)
    back=b.back.xyz;right=vec3(back.z,0,-back.x)
    local=n*b.size.xyz*scallop
    if b.center.w>1.5:
        along=(n.z+1.0)*0.5
        local.x*=0.30+along*1.1
        local.y+=sin(along*3.14159265)*b.size.y*0.35
    p=b.center.xyz+right*local.x+vec3(0,local.y,0)+back*local.z
    normal=normalize(n/max(b.size.xyz,vec3(0.001,0.001,0.001)))
    normal=right*normal.x+vec3(0,normal.y,0)+back*normal.z
    SplashOut(u.vp*vec4(render_warped(p,u.eye,u.warp_a,u.warp_b),1),p,normal)
splash_fs=(i:SplashOut,u:SplashParams)->vec4:
    facing=dot(normalize(i.normal),u.sun_dir)
    tone=if facing< -0.25:vec3(0.62,0.76,0.83) else:if facing<0.32:vec3(0.81,0.89,0.93) else:vec3(1,1,0.99)
    vec4(aerial(u.white*tone,i.world,u.eye,u.haze,u.fog),1)
splash_shader:Shader
splash_mesh:Mesh
init_splashes=():
    global splash_shader,splash_mesh
    splash_shader=make_world_shader(shader(splash_vs,splash_fs))
    vs:SplashVertex[]
    point=(a:int,b:int)->vec3:
        latitude=PI*f64(a)/8.0;longitude=TAU*f64(b)/16.0
        vec3(sin(latitude)*cos(longitude),cos(latitude),sin(latitude)*sin(longitude))
    loop a in 0..8:
        loop b in 0..16:
            loop p in [point(a,b),point(a+1,b),point(a,b+1),point(a,b+1),point(a+1,b),point(a+1,b+1)]:vs.push(SplashVertex(p))
    splash_mesh=mesh(vs)

splash_heading=(back:vec3)->vec3:
    flat=vec3(back.x,0,back.z)
    if length(flat)>0.0001:normalize(flat) else:vec3(0,0,1)

splash_add=(out:mut SplashInstance[],p:vec3,size:vec3,phase:f64,back:vec3=vec3(0,0,1)):
    if min(size.x,min(size.y,size.z))>0.004:out.push(SplashInstance(vec4(p,1),vec4(size,f32(phase)),vec4(splash_heading(back),0)))

# Intersecting closed lobes make a continuous opaque volume with scalloped outer edges.
# The thin roots touch the water; the spreading body peels out and rises behind the step.
splash_fan=(out:mut SplashInstance[],root:vec3,back:vec3,right:vec3,run:f64,phase:f64):
    length=1.0+run*6.0
    center=root+back*f32(length*0.5)+vec3(0,0.08,0)
    out.push(SplashInstance(vec4(center,2),vec4(0.25+run*1.6,0.15+run*0.85,length*0.5,f32(phase)),vec4(splash_heading(back),0)))
    # Overlapping scallops enlarge the ragged aft rim; they stay attached to the single body.
    loop j in 0..5:
        u=f64(j)/4.0
        aft=length*(0.62+0.17*sin(u*PI))
        wide=(u-0.5)*(0.4+run*2.0)
        radius=(0.12+run*0.4)*(0.8+0.2*sin(phase+u*5.0))
        p=root+back*f32(aft)+right*f32(wide)+vec3(0,0.1+run*0.25,0)
        splash_add(out,p,vec3(radius,radius*0.8,radius*1.4),phase+u*3.0,back)
    # Tapered white marks touch the wet footprint; the sea shader is not changed.
    loop side in [-1.0,1.0]:
        loop j in 0..3:
            u=f64(j)/3.0
            p=root+back*f32(0.4+u*3.0)+right*f32(side*(0.28+u*0.8))
            splash_add(out,p,vec3(0.04+run*0.025,0.018,0.6+run*0.55),phase,back)

splash_instances=(f:Flyer,model:CraftModel,pose:mat4,ps:WorldParticles,origin:vec3,t:f64,active:bool=true)->SplashInstance[]:
    out:SplashInstance[];s=f.state
    rotation=pose;rotation[3]=vec4(0,0,0,1)
    anchor=flight_fx_anchor(f,pose)
    back=quat_rotate(s.orientation,vec3(0,0,1));right=quat_rotate(s.orientation,vec3(1,0,0))
    if active and s.on_water and not s.moored and not s.crashed:
        run=smoothstep(3.0,f.spec.stall_speed,water_run_speed(f.spec,s))
        roots:{int:WorldPoint};front:{int:f64};phases:{int:f64}
        loop p in model.contacts:
            if run<0.01 or part_health(s.damage,PartId(contact_part(f.kind,p)))<=0:continue
            contact=world_offset(anchor,transform_point(rotation,p))
            sea=swell_at(contact.x,contact.z,f.sea_t)
            if contact.y>f64(sea.x)+0.18:continue
            contact.y=f64(sea.x)+0.04
            part=contact_part(f.kind,p)
            if not (part in roots) or f64(p.z)<front[part]:
                roots[part]=contact;front[part]=f64(p.z);phases[part]=f64(p.x)*1.7
        loop part in 0..7:
            if part in roots:splash_fan(out,world_local(roots[part],origin),back,right,run,t*2.0+phases[part])
    gap=f64(s.position.y)-f.spec.float_height
    skim=if s.on_water or s.moored:0.0 else:(1.0-smoothstep(0.5,f.spec.span*0.6,gap))*smoothstep(28.0,60.0,f64(length(s.velocity))/pure_k(f.spec))
    if active and skim>0.1:
        under=craft_offset(s,vec3(-s.velocity.x*0.15,0.1-s.position.y,-s.velocity.z*0.15))
        under.y=f64(swell_at(under.x,under.z,f.sea_t).x)+0.04
        splash_fan(out,world_local(under,origin),back,right,skim*0.65,t*2.0)
    loop b in ps.billows:
        age=f64(b.age);life=f64(b.life)
        if age>=life:continue
        fade=1.0-smoothstep(life*0.50,life,age)
        growth=0.55+0.45*smoothstep(0.0,0.12,age)
        radius=f64(b.radius)*pow(f64(b.count),0.25)*growth*fade
        # The original sampled velocity envelope expands the burst; drag limits its spread.
        spread=b.spread*f32((1.0-exp(-f64(ps.drag)*age))/max(0.01,f64(ps.drag))*0.45*fade)
        size=vec3(radius,radius*0.75,radius)+spread
        point=b.point
        # Falling splash bodies dissolve into the surface rather than floating below it.
        sea=f64(swell_at(point.x,point.z,t).x)
        if point.y+f64(size.y)<sea:continue
        splash_add(out,world_local(point,origin),size,f64(b.phase)+age*1.7)
    out

draw_splashes=(f:Flyer,model:CraftModel,pose:mat4,ps:WorldParticles,L:Light,t:f64,active:bool=true):
    draw_custom(():
        origin=render_origin(scene_camera())
        bodies=splash_instances(f,model,pose,ps,origin,t,active)
        if bodies.len()>0:
            glDepthMask(1);glDisable(GL_CULL_FACE)
            white=L.sun*0.75+L.shade*0.25+vec3(0.18,0.20,0.21)
            draw_instanced(splash_shader,splash_mesh,bodies,SplashParams(render_view_proj(origin),render_eye(origin),L.sun_dir,white,L.haze,f32(L.fog_density),render_anchor(scene_warp_a,origin),scene_warp_b))
    ,transparent=true)
    # The shared impact system also carries brown dirt. Its existing rendering stays intact.
    dust=ps;dust.items=[loop p in ps.items:if p.color.x<=0.8 or p.color.y<=0.8:p]
    if dust.items.len()>0:draw_curved_particles(dust,false)
