use 'water_field.jo'
use 'geography.jo'
# Closed, opaque splash bodies. One shared scalloped mesh, one instanced draw, no textures.
# Continuous float fans and detached emission envelopes use the same painted material.
use 'pilot.jo'
use 'flight.jo'
use 'flight_feedback.jo'
use 'planes.jo'
use 'damage.jo'
use 'flight_effects.jo'
use 'world_particles.jo'
use 'world_point.jo'
use 'sea.jo'
use 'look.jo'
use 'render_space.jo'
use 'depth_space.jo'
use 'curved_world.jo'

struct SplashVertex:
    pos:vec3
    normal:vec3
struct SplashInstance:
    center:vec4
    size:vec4
    back:vec4=vec4(0,0,1,0)
struct SplashParams:
    vp:mat4
    eye:vec3
    sun_dir:vec3
    white:vec3
    haze:vec3
    fog:f32
    warp_a:vec4
    warp_b:vec4
struct SplashOut:
    pos:vec4
    world:vec3
    normal:vec3
    body:f32
# A spray curtain is a fan: in its cross-section the sheet rises off the float's chine,
# arches over and comes down onto the water further out, like the two half-cones of spray
# thrown from a planing bow. A unit lobe's height y in -1..1 runs along that arch, root to
# landing. Half-widths across the sheet are (width, d width / d y): the hollow under the
# arch is a thin sheet; its back billows out, thickest over the crest and the descending
# outer half, thinning to a knife edge at the root by the float. outward > 0 is the back.
const CURTAIN_BILLOW=0.12
# How far the lobes' scallops stand out of a fan's back, in apex heights.
const CURTAIN_LUMP=0.30
# The arch rises steeply off the chine and falls in a long curve outward: the crest sits
# this fraction of the span out from the root.
const CURTAIN_RISE=0.45
# The highest a fan's arch stands (m), before its billows.
const CURTAIN_APEX=0.95
# Rows of billows on each fan's back: (count, place along the arch 0..1 from root to
# landing, radius in apex heights). A small row on the rising side, the biggest along the
# crest, a second big row down the falling half, and a rim row of small ones breaking up the
# edge where the fan lands: the fan reads as an arc of cloud over an open hollow.
CURTAIN_ROWS=[vec3(4,0.27,0.20),vec3(7,0.50,0.38),vec3(6,0.74,0.33),vec3(7,0.97,0.27)]
CURTAIN_BILLOWS=24
# Trailing billows and foam behind each outer fan.
CURTAIN_TRAIL=18
curtain_widths=(outward:f32,y:f32,thickness:f32,height:f32)->vec2:
    r=clamp(0.5+0.5*y,0.0,1.0)
    billow=height*CURTAIN_BILLOW
    slope=if y> -1.0 and y<1.0:billow*0.75*sqrt(r) else:0.0
    if outward>0.0:vec2(thickness+billow*r*sqrt(r),slope) else:vec2(thickness*0.55,0.0)
# The arch: two quarter ellipses meeting at the crest, a short steep rise from the root
# (0,0) and a long fall to the landing (span,0), apex height `height`, at angle a in 0..PI.
# Returns the point (outward, up) and the unit normal of its back (pointing away from the
# hollow under the arch); the normal is continuous through the crest.
curtain_half=(a:f32,span:f32)->f32:if a<1.5707964:span*CURTAIN_RISE else:span*(1.0-CURTAIN_RISE)
curtain_arch=(a:f32,span:f32,height:f32)->vec4:
    half=curtain_half(a,span)
    n=vec2(-height*cos(a),half*sin(a))
    n=n/max(length(n),0.0001)
    vec4(span*CURTAIN_RISE-half*cos(a),height*sin(a),n.x,n.y)

# A curtain lobe's unit shape mapped onto its fan, in the unmirrored frame (outward, up,
# aft). The height y over the cross-section's own radius runs the arch root to landing.
# The lobe's scallops (its radius above the bare sphere) stand out of the back as cloud
# lumps; the hollow side keeps a flat thin sheet.
curtain_map=(sh:vec3,span:f32,apex:f32,thickness:f32,along:f32,phase:f32=0.0)->vec3:
    radius=length(sh);unit=sh/max(radius,0.0001)
    ring=sqrt(max(1.0-unit.z*unit.z,0.0025))
    y=unit.y/ring
    # Each lobe's arch rounds down toward its fore and aft ends, so overlapping lobes
    # scallop the crest along the fan and the tail ends in a rounded shoulder.
    dome=sqrt(ring)
    top=apex*mix(0.45,1.0,dome);reach=span*mix(0.75,1.0,dome)
    w=curtain_widths(unit.x,clamp(y,-1.0,1.0),thickness,top).x
    lump=if unit.x>0.0:unit.x*smoothstep(0.86,1.12,radius)*CURTAIN_LUMP*top else:0.0
    d=unit.x*w+lump
    arch=curtain_arch(f32(PI)*(0.5+0.5*y),reach,top)
    point=vec2(arch.x+arch.z*d,arch.y+arch.w*d)
    # Where the sheet meets the sea it breaks into foam: the foot flares out flat over the
    # water and thins, in uneven scallops, instead of being cut off by the water plane.
    # Mostly outward at the landing, a little toward the float at the root.
    foot=1.0-smoothstep(0.0,0.30*top,point.y)
    foot=foot*foot
    landing=smoothstep(0.2,0.8,0.5+0.5*y)
    scallop=0.7+0.3*sin(unit.z*7.0+phase*1.3)+0.15*sin(unit.z*13.0-phase*0.9)
    point.x+=foot*scallop*top*mix(-0.18,0.55,landing)
    point.y=mix(point.y,point.y*0.35-0.01*top,foot)
    vec3(point.x,point.y,unit.z*along)

splash_vs=(v:SplashVertex,b:SplashInstance,u:SplashParams)->SplashOut:
    # The closed surface and its analytic smooth normals are baked together. A gentle
    # whole-body breath keeps the lobes moving without folding triangles into facets.
    radius=length(v.pos);sphere=v.pos/radius
    # Curtain sheet lobes keep softer scallops than their billows, so the sheet's broad
    # faces paint as large calm regions and the billows carry the cloud lumps.
    lobes=if b.center.w>1.5:1.0 else:if b.center.w>1.5:1.0 else:mix(0.16,1.0,smoothstep(0.8,1.6,max(b.size.x,max(b.size.y,b.size.z))))
    radius2=mix(1.0,radius,lobes)
    n=sphere*radius2
    normal=normalize(sphere-(sphere-v.normal/max(0.01,dot(v.normal,sphere)))*(lobes*radius/radius2))
    breath=vec3(1.0+0.025*sin(b.size.w),1.0+0.04*sin(b.size.w*0.8),1.0)
    scale=b.size.xyz*breath
    back=b.back.xyz;horizontal=vec3(back.z,0,-back.x)
    right=if length(horizontal)>0.0001:normalize(horizontal) else:vec3(1,0,0)
    up=cross(back,right)
    shape=n
    local=shape*scale
    if b.center.w>1.5:
        # Curtain lobes and billows churn: their scallops roll over the top and aft with
        # the flow (about the across axis) and rock outward and back (about the vertical),
        # so the shading features travel along the sheet instead of standing still.
        roll=b.size.w*1.6;c=cos(roll);s=sin(roll)
        n=vec3(n.x,c*n.y-s*n.z,s*n.y+c*n.z)
        normal=vec3(normal.x,c*normal.y-s*normal.z,s*normal.y+c*normal.z)
        spin=b.size.w*0.37+0.6*sin(b.size.w*0.7);c=cos(spin);s=sin(spin)
        n=vec3(c*n.x-s*n.z,n.y,s*n.x+c*n.z)
        normal=vec3(c*normal.x-s*normal.z,normal.y,s*normal.x+c*normal.z)
        shape=n
        local=shape*scale
    if b.center.w>2.5:
        # Curtain lobes bend along the fan's arch: every cross-section of the lobe follows
        # the whole arch from the root at the chine over the crest to the landing; across
        # it, the hollow side stays a thin sheet and the back billows out, and the sheet
        # thins to nothing at the lobe's ends so neighbouring lobes join into one fan.
        # back.w is the signed outward span: its sign picks the side, its size the reach.
        side=sign(b.back.w);span=abs(b.back.w)*breath.x
        here=curtain_map(shape,span,scale.y,scale.x,scale.z,b.size.w)
        # Exact enough smooth normals: the cofactor (inverse-transpose) of the mapping's
        # Jacobian, taken by differences, applied to the lobe's own normal.
        e=f32(0.004)
        j0=(curtain_map(shape+vec3(e,0,0),span,scale.y,scale.x,scale.z,b.size.w)-here)/e
        j1=(curtain_map(shape+vec3(0,e,0),span,scale.y,scale.x,scale.z,b.size.w)-here)/e
        j2=(curtain_map(shape+vec3(0,0,e),span,scale.y,scale.x,scale.z,b.size.w)-here)/e
        g=normal.x*cross(j1,j2)+normal.y*cross(j2,j0)+normal.z*cross(j0,j1)
        g=g*sign(dot(j0,cross(j1,j2))+0.000001)
        local=vec3(side*here.x,here.y,here.z)
        normal=vec3(side*g.x,g.y,g.z)
        scale=vec3(1,1,1)
    p=b.center.xyz+right*local.x+up*local.y+back*local.z
    normal=normal/max(scale,vec3(0.001,0.001,0.001))
    normal=normalize(normal)
    normal=right*normal.x+up*normal.y+back*normal.z
    SplashOut(u.vp*vec4(render_warped(p,u.eye,u.warp_a,u.warp_b),1),p,normal,b.center.w)
splash_fs=(i:SplashOut,u:SplashParams)->vec4:
    n=normalize(i.normal)
    facing=dot(n,u.sun_dir)
    # Flat painted regions, with a small soft terminator following each round lobe.
    tone=mix(vec3(0.68,0.80,0.86),vec3(0.84,0.91,0.94),smoothstep(-0.60,-0.48,facing))
    if i.body>1.5:
        # Spray curtains and their billows: two painted tones only. In bright sun the
        # pale middle tone saturates to white, so the shadow side takes the blue-grey
        # directly. Tops lit by the sky stay white; overhanging undersides and a thin
        # rim where each lobe turns away from the eye join the shadow, so every billow
        # shows a white cap over a grey belly and the outer mass reads from any side.
        top=smoothstep(0.55,0.82,n.y)
        under=smoothstep(0.05,0.45,-n.y)
        rim=smoothstep(0.88,0.97,1.0-abs(dot(n,normalize(u.eye-i.world))))
        facing=min(max(facing,mix(-1.0,0.30,top)),mix(1.0,-0.70,max(under,rim)))
        tone=vec3(0.68,0.80,0.86)
    tone=mix(tone,vec3(1,1,0.99),smoothstep(-0.06,0.07,facing))
    vec4(aerial(u.white*tone,i.world,u.eye,u.haze,u.fog),1)

# Gaussian caps on a sphere give rounded convex scallops in every viewing direction.
# The radial derivative supplies smooth normals, rather than triangle face normals or
# the undeformed sphere's normals. This mesh is shared by every body and made only once.
splash_vertex=(n:vec3)->SplashVertex:
    radius=0.82;gradient=vec3(0,0,0)
    loop j in 0..32:
        y=1.0-2.0*(f64(j)+0.5)/32.0
        r=sqrt(1.0-y*y);a=f64(j)*2.39996322972865
        d=vec3(r*cos(a),y,r*sin(a))
        cap=0.22*exp(22.0*(f64(dot(n,d))-1.0))
        radius+=cap;gradient+=d*f32(cap*22.0)
    normal=normalize(n-(gradient-n*dot(gradient,n))/f32(radius))
    SplashVertex(n*f32(radius),normal)

splash_shader:Shader
splash_mesh:Mesh
splash_small_mesh:Mesh
# A latitude/longitude grid of the scalloped lobe; the poles coincide exactly. Shared
# vertices let the vertex shader run once per grid point rather than per triangle corner.
splash_grid=(rows:int,columns:int)->Mesh:
    indices:u32[]
    point=(a:int,b:int)->SplashVertex:
        latitude=PI*f64(a)/f64(rows);longitude=TAU*f64(b%columns)/f64(columns)
        splash_vertex(vec3(sin(latitude)*cos(longitude),cos(latitude),sin(latitude)*sin(longitude)))
    grid:SplashVertex[]
    loop a in 0..rows+1:
        loop b in 0..columns:grid.push(point(a,b))
    loop a in 0..rows:
        loop b in 0..columns:
            c=(b+1)%columns
            loop k in [a*columns+b,(a+1)*columns+b,a*columns+c,a*columns+c,(a+1)*columns+b,(a+1)*columns+c]:indices.push(u32(k))
    mesh(grid,indices)
init_splashes=():
    global splash_shader,splash_mesh,splash_small_mesh
    splash_shader=make_world_shader(shader(splash_vs,splash_fs))
    # 64x40 (2,624 vertices) resolves the scallops even close to the floats.
    splash_mesh=splash_grid(40,64)
    # Curtain billows and crest drops are small: 40x24 (1,000 vertices) holds their scallops.
    splash_small_mesh=splash_grid(24,40)

# Instance kinds in center.w: 1 droplets/billows/water marks, 1.25 curtain crest drops,
# 2 curtain outer billows, 3 curtain sheet lobes. Drops and billows use the small mesh.
splash_small=(b:SplashInstance)->bool:b.center.w>1.1 and b.center.w<2.5

splash_heading=(back:vec3)->vec3:
    flat=vec3(back.x,0,back.z)
    if length(flat)>0.0001:normalize(flat) else:vec3(0,0,1)

splash_add=(out:mut SplashInstance[],p:vec3,size:vec3,phase:f64,back:vec3=vec3(0,0,1),kind:f32=1.0):
    if min(size.x,min(size.y,size.z))>0.004:out.push(SplashInstance(vec4(p,kind),vec4(size,f32(phase)),vec4(splash_heading(back),0)))

# A point on a curtain's arch, in the curtain's frame: `along` metres aft of its bow
# root, at fraction q from the root (0) over the crest to the landing (1), `out` metres
# off the sheet's back.
curtain_point=(edge:vec3,direction:vec3,across:vec3,up:vec3,side:f64,along:f64,span:f64,apex:f64,q:f64,out:f64)->vec3:
    arch=curtain_arch(f32(PI*q),f32(span),f32(apex))
    x=f64(arch.x)+f64(arch.z)*out;y=f64(arch.y)+f64(arch.w)*out
    edge+direction*f32(along)+across*f32(side*x)+up*f32(y)

# Half-thickness of a curtain's back at fraction q along its arch (the lobe's own profile).
curtain_back=(q:f64,thickness:f64,apex:f64)->f64:
    y=q*2.0-1.0;across=sqrt(max(0.0,1.0-y*y))
    across*(f64(curtain_widths(1,f32(y),f32(thickness),f32(apex)).x)+0.5*f64(CURTAIN_LUMP)*apex)

# Each float throws two fans of spray, one off each side, leaving a clear trough along its
# own track. An outer fan rises off the chine, arches over and comes down onto the water
# further out; it reaches wider and stands taller with speed. A float's inner side (toward
# a twin float, `inner` = that side's sign) throws only a low, short sheet with a few small
# billows, so the gap between the floats stays clear.
splash_fan=(out:mut SplashInstance[],root:vec3,back:vec3,right:vec3,run:f64,phase:f64,origin:vec3,t:f64,reach:f64=0.0,bow:f64=0.0,heave:f64=1.0,inner:f64=0.0):
    length=if reach>0.0:reach else:1.0+run*6.0
    curtain_length=length*0.72+bow
    # Low and short when just planing, wider and taller at speed. Chop and float bounce
    # breathe the whole fan a little.
    # The arch's apex is capped, chop included, so with its billows the fan stays between
    # the float deck and the lower wing even at full speed; only its reach keeps growing.
    height=min((0.25+0.95*pow(run,1.3))*heave,CURTAIN_APEX)
    span=(0.4+1.9*pow(run,1.2))*heave
    # Billows ride aft along the sheet at a painted fraction of the water's speed.
    cycle=t*(2.0+3.0*run)/max(0.5,curtain_length*0.78)
    thickness=0.05+run*0.03
    loop side in [-1.0,1.0]:
        low=inner!=0.0 and side==inner
        # Outer fans splay outward; the inner sheet runs straight aft beside its float.
        direction=normalize(back+right*f32(side*(if low:0.02 else:0.18+run*0.16)))
        across=normalize(vec3(direction.z,0,-direction.x))
        up=cross(direction,across)
        edge=root-back*f32(bow)+right*f32(side*(0.38+run*0.12))
        # Where along the fan (0 bow..1 tail) its arch stands how tall and reaches how far:
        # a half-cone opening aft from the bow, so from behind one looks into its open
        # crescent, settling a little at the very tail. Between twin floats only a low,
        # short hump hugging the water.
        shape=(u:f64)->vec2:
            if low:
                arch=sin(pow(u,0.72)*PI)
                vec2(height*0.16*(0.4+0.6*arch),span*0.18)
            else:
                # Standing tallest about half way and falling away toward the water aft, so
                # from the side the fan is a hump settling onto the sea while its open tail
                # still reads as a crescent from behind; opening wider all the way aft.
                # Past half way the sheet tapers away: lower toward the water and narrower
                # toward its root line, so it has no back face, only a thinning tail.
                stand=sin(pow(clamp(u,0.0,1.0),0.8)*PI*0.9)
                grow=pow(smoothstep(0.0,0.85,u),0.8)
                fade=smoothstep(0.5,1.0,u)
                vec2(height*(0.3+0.7*stand)*(1.0-0.7*fade),span*(0.35+0.65*grow)*(1.0-0.6*fade))
        # The fan's thin sheet: overlapping lobes along its length, each bent along the arch,
        # leaving the hollow under it open.
        # The outer fan is short for its size, a thrown half-cone rather than a long wall.
        fan=curtain_length*(if low:1.0 else:0.75)
        lobes=if low:2 else:6
        loop segment in 0..lobes:
            u=if low:0.12+f64(segment)*0.16 else:0.10+f64(segment)*0.155
            # Each lobe swells and settles on its own beat, so the crest line keeps changing.
            beat=1.0+0.09*sin(t*3.3+f64(segment)*1.9+side*0.7)+0.05*sin(t*5.7+f64(segment)*3.1)
            at=shape(u)
            center=edge+direction*f32(fan*u)
            # The tail lobes are shorter too, so the sheet ends in a small low dome, not a slab.
            along=fan*(if low:0.12 else:0.15*(1.0-0.45*smoothstep(0.5,1.0,u)))
            out.push(SplashInstance(vec4(center,3),vec4(thickness*(if low:0.8 else:1.0),at.x*beat,along,f32(phase+u)),vec4(direction,f32(side*at.y))))
        # Round billows ride the fan's back: a big row along the crest, a row down the falling
        # half and small ones breaking up the rim where it lands. Each is born small near the
        # bow, swells as it rolls aft and outward along the arch, rocks, then slides down the
        # falling half and sinks into the sea, shrinking as it goes under (never sliced flat
        # by the water) and leaving a few flat bubbles on the surface, while the next re-forms
        # behind it: a continuous rolling boil. The low inner hump keeps only two small ones.
        loop row in (if low:[3] else:[0,1,2,3]):
            spec=CURTAIN_ROWS[row];count=if low:2 else:int(spec.x)
            loop j in 0..count:
                c=fract(cycle+(f64(j)+0.37*f64(row))/f64(count)+side*0.21)
                u=0.10+0.82*c*(if low:0.4 else:1.0)
                k=f64(row*7+j)
                at=shape(u);h=at.x;reach_out=at.y
                sink=smoothstep(0.4,1.0,c)
                q=clamp(mix(f64(spec.y)+0.06*c+0.04*sin(c*TAU+k),1.0,sink),0.05,1.0)
                rock=0.08*h*sin(c*TAU*1.5+k*1.9+side)
                swell=0.86+0.14*sin(t*4.3+k*2.3+side*1.1)
                radius=h*f64(spec.z)*(if low:0.7 else:1.0)*swell*smoothstep(0.0,0.32,c)
                # Sit each billow half into the sheet's back at that point; the rim row
                # straddles the landing edge. Sinking, it goes down past the landing.
                p=curtain_point(edge,direction,across,up,side,fan*u,reach_out,h,q,curtain_back(q,f64(thickness),h)*(1.0-sink)+radius*0.35+rock)
                # Sinking, it settles to the waterline and shrinks into it: its centre goes
                # down to the surface as it goes, so the water plane never slices it flat.
                radius*=1.0-smoothstep(0.0,1.0,sink)
                p.y=f32(mix(f64(p.y),f64(edge.y)+radius*0.15,smoothstep(0.3,1.0,sink)))
                if radius>0.004:out.push(SplashInstance(vec4(p,2),vec4(radius*1.05,radius*0.92,radius*1.25,f32(t*1.9+k*1.3)),vec4(direction,0)))
                # Where it went under: two flat bubbles spreading and thinning on the sea.
                if not low and sink>0.5:
                    life=smoothstep(0.5,0.75,sink)*(1.0-smoothstep(0.88,1.0,c))
                    loop m in 0..2:
                        a=k*2.39+f64(m)*2.1
                        r=h*f64(spec.z)*(0.22+0.12*f64(m))*life
                        o=p+direction*f32(cos(a)*h*0.25)+across*f32(side*(0.12+0.1*f64(m))*h)
                        o.y=swell_at(f64(o.x)+f64(origin.x),f64(o.z)+f64(origin.z),t).x+0.02
                        if r>0.004:splash_add(out,o,vec3(r*(1.0+0.5*sink),r*0.22,r*(1.2+0.6*sink)),phase+a,direction,1.25)
        # Where the fan lands, its base breaks into foam: flat patches strewn along and just
        # outside the landing line, smaller and thinner the further out, each drifting aft
        # with the water and thinning away while new ones form ahead; a few hug the root.
        if not low:
            loop j in 0..12:
                c=fract(cycle*0.8+f64(j)/12.0+side*0.29)
                u=0.15+0.85*c
                at=shape(u)
                k=f64(j)*1.618+side
                spread=fract(k*0.7548)
                out_by=at.x*(0.05+0.85*spread)
                life=smoothstep(0.0,0.2,c)*(1.0-smoothstep(0.7,1.0,c))
                r=at.x*(0.55-0.35*spread)*life
                o=curtain_point(edge,direction,across,up,side,fan*u,at.y,at.x,1.0,0.0)+across*f32(side*out_by)
                o.y=swell_at(f64(o.x)+f64(origin.x),f64(o.z)+f64(origin.z),t).x+0.02
                if r>0.004:splash_add(out,o,vec3(r*(1.0+0.6*c),r*0.16,r*(1.4+0.8*c)),phase+k,direction,1.25)
            loop j in 0..3:
                c=fract(cycle*0.8+f64(j)/3.0+side*0.61)
                u=0.2+0.8*c
                at=shape(u)
                life=smoothstep(0.0,0.2,c)*(1.0-smoothstep(0.6,1.0,c))
                r=at.x*0.16*life
                o=edge+direction*f32(fan*u)-across*f32(side*at.x*0.1)
                o.y=swell_at(f64(o.x)+f64(origin.x),f64(o.z)+f64(origin.z),t).x+0.02
                if r>0.004:splash_add(out,o,vec3(r,r*0.16,r*1.6),phase+f64(j),direction,1.25)
        # Behind the sheet the thrown spray trails away over a length that grows with speed,
        # well past the float's tail: billows drifting aft at a painted fraction of the
        # water's speed, lower and narrower toward the root line, each shrinking as it goes and
        # spaced wider the further aft, turning into small flat foam ovals, then nothing.
        if not low:
            tail_end=shape(1.0)
            trail=1.2+5.0*pow(run,1.2)
            drift=t*(1.5+5.0*run)/trail
            loop j in 0..CURTAIN_TRAIL:
                c=fract(drift+f64(j)/f64(CURTAIN_TRAIL)+side*0.17)
                k=f64(j)*2.399+side*1.3
                jitter=fract(k*0.618)
                # Spacing grows with distance: equal steps in c spread out aft.
                along=fan+trail*pow(c,1.5)
                # A loose band, not a single file: scattered across the narrowing tail.
                lateral=span*mix(0.32,0.2,c)*(0.25+1.5*jitter)+f64(tail_end.y)*0.25
                foam=smoothstep(0.35,0.7,c)
                # Starting as big as the sheet's own tail billows, at its end.
                r=height*0.30*pow(1.0-c,1.4)*smoothstep(0.0,0.22,c)*(0.7+0.6*fract(k*0.37))
                sea=edge+direction*f32(along)+across*f32(side*lateral)
                sea.y=swell_at(f64(sea.x)+f64(origin.x),f64(sea.z)+f64(origin.z),t).x
                if r>0.004:
                    # A billow sitting half in the water, flattening into an oval of foam.
                    flat=mix(0.9,0.16,foam)
                    sea.y+=f32(r*flat*mix(0.35,0.1,foam))
                    size=vec3(f32(r*mix(1.0,1.5,foam)),f32(r*flat),f32(r*mix(1.2,2.0,foam)))
                    if foam<0.5:out.push(SplashInstance(vec4(sea,2),vec4(size,f32(t*1.9+k*1.3+50.0)),vec4(direction,0)))
                    else:splash_add(out,sea,size,phase+k,direction,1.25)
        # Droplets thrown off the rim: each leaves the falling half and flies out past the
        # landing edge, shrinking as it goes. None between twin floats.
        if not low:
            loop j in 0..5:
                c=fract(cycle*1.3+f64(j)/5.0+side*0.37)
                u=0.25+0.13*f64(j)+0.08*c
                at=shape(u);h=at.x
                radius=(0.06+run*0.05)*(0.9+0.1*sin(phase*0.55+f64(j)*5.0+side))*smoothstep(0.0,0.15,c)*(1.0-smoothstep(0.7,1.0,c))
                q=0.62+0.38*c
                p=curtain_point(edge,direction,across,up,side,fan*u,at.y,h,q,curtain_back(q,f64(thickness),h)+radius*1.5+c*0.6*h)
                splash_add(out,p,vec3(radius,radius*1.15,radius),phase+f64(j)*3.0,direction,1.25)
    # Tapered white marks touch the wet footprint; the sea shader is not changed.
    loop side in [-1.0,1.0]:
        loop j in 0..3:
            u=f64(j)/3.0
            p=root+back*f32(length*(0.60+u*0.60))+right*f32(side*(0.45+run*1.1+u*0.4))
            p.y=swell_at(f64(p.x)+f64(origin.x),f64(p.z)+f64(origin.z),t).x+0.035
            splash_add(out,p,vec3(0.04+run*0.025,0.018,0.6+run*0.55),phase,back)

# Presentation-only state: no forces, emission rates, RNG or damage changes.
# 95% attack in 0.20 s, release in 0.36 s; exact exponential integration is
# stable at 30/60/120 Hz and bridges momentary wet-contact changes in chop.
struct SplashSheet:
    root:WorldPoint
    back:vec3=vec3(0,0,1)
    right:vec3=vec3(1,0,0)
    run:f64=0.0
    reach:f64=0.0
    bow:f64=0.0
    amount:f64=0.0
    phase:f64=0.0
    heave:f64=0.0 # extra curtain height from chop and float bounce, as a fraction
    inner:f64=0.0 # the float's side toward a twin float (-1 left, 1 right), 0 when central
struct SplashMotion:
    sheets:SplashSheet[7]
    time:f64= -1.0
    anchor:WorldPoint
splash_motion=SplashMotion()
splash_ramp=(value:f64,target:f64,dt:f64)->f64:
    mix(value,target,1.0-exp(-max(0.0,dt)/(if target>value:0.065 else:0.12)))
splash_targets=(f:Flyer,model:CraftModel,pose:mat4,active:bool)->SplashSheet[]:
    s=f.state;out:SplashSheet[]
    rotation=pose;rotation[3]=vec4(0,0,0,1)
    anchor=flight_fx_anchor(f,pose)
    back=quat_rotate(s.orientation,vec3(0,0,1));right=quat_rotate(s.orientation,vec3(1,0,0))
    run=smoothstep(3.0,f.spec.stall_speed,water_run_speed(f.spec,s))
    surface=water_at(f64(s.position.x),f64(s.position.z))
    level=if geography_enabled and surface.wet:surface.level else:0.0
    gap=f64(s.position.y)-f.spec.float_height-level
    skim=if s.on_water or s.moored:0.0 else:(1.0-smoothstep(0.5,f.spec.span*0.6,gap))*smoothstep(28.0,60.0,f64(length(s.velocity))/pure_k(f.spec))
    loop part in 0..7:
        sheet=SplashSheet(back=back,right=right)
        aft= -1e30;wet= -1e30;front=1e30;dip=0.0
        loop p in model.contacts:
            if contact_part(f.kind,p)!=part or part_health(s.damage,PartId(part))<=0:continue
            contact=world_offset(anchor,transform_point(rotation,p))
            sea=swell_at(contact.x,contact.z,f.sea_t)
            if f64(p.z)>aft:
                aft=f64(p.z);sheet.root=contact;sheet.phase=f64(p.x)*1.7
                # A float well off the centreline has a twin across from it.
                sheet.inner=if abs(f64(p.x))>0.6: -sign(f64(p.x)) else:0.0
            if active and s.on_water and not s.moored and not s.crashed and run>0.0 and contact.y<=f64(sea.x)+0.18:
                wet=max(wet,f64(p.z));front=min(front,f64(p.z));dip=max(dip,f64(sea.x)-contact.y)
        if wet> -1e29:
            loop p in model.contacts:
                if contact_part(f.kind,p)==part and f64(p.z)==wet:
                    sheet.root=world_offset(anchor,transform_point(rotation,p))
                    sheet.root.y=f64(swell_at(sheet.root.x,sheet.root.z,f.sea_t).x)+0.04
            sheet.run=run;sheet.amount=smoothstep(0.0,0.04,run)
            sheet.bow=(wet-front)*(1.0-run*0.55)
            # A float pressed into a wave or dropping onto it throws a fuller curtain.
            sheet.heave=clamp(dip*0.6-f64(s.velocity.y)/pure_k(f.spec)*0.05-0.08,-0.2,0.25)
        else if active and not s.crashed and skim>0.1 and aft> -1e29:
            tail=world_offset(sheet.root,splash_heading(back)*f32(4.0+skim*7.0))
            tail.y=f64(swell_at(tail.x,tail.z,f.sea_t).x)+0.08
            delta=world_delta(tail,sheet.root)
            sheet.back=normalize(delta);sheet.reach=f64(length(delta))
            sheet.run=skim*0.65;sheet.amount=smoothstep(0.1,0.25,skim)
        out.push(sheet)
    out

step_splash_motion=(motion:mut SplashMotion,targets:SplashSheet[],anchor:WorldPoint,t:f64):
    dt=if motion.time<0.0:0.0 else:max(0.0,t-motion.time)
    if t<motion.time or length(world_delta(anchor,motion.anchor))>250.0:motion=SplashMotion()
    loop part in 0..7:
        next=targets[part];previous=motion.sheets[part]
        # Track the live float, even while its release envelope drains away.
        if next.amount>0.0:
            previous.root=next.root;previous.back=next.back;previous.right=next.right;previous.phase=next.phase;previous.inner=next.inner
            previous.run=splash_ramp(previous.run,next.run,dt)
            previous.reach=splash_ramp(previous.reach,next.reach,dt)
            previous.bow=splash_ramp(previous.bow,next.bow,dt)
            previous.heave=splash_ramp(previous.heave,next.heave,dt)
        else if motion.time>=0.0:
            delta=world_delta(anchor,motion.anchor)
            previous.root=world_offset(previous.root,vec3(delta.x,0,delta.z))
        previous.amount=splash_ramp(previous.amount,next.amount,dt)
        motion.sheets[part]=previous
    motion.anchor=anchor;motion.time=t

splash_instances=(f:Flyer,model:CraftModel,pose:mat4,ps:WorldParticles,origin:vec3,t:f64,active:bool=true,motion:SplashMotion?=none)->SplashInstance[]:
    out:SplashInstance[]
    eye=render_eye(origin)
    sheets=splash_targets(f,model,pose,active)
    if let m=motion:sheets=[loop sheet in m.sheets:sheet]
    loop sheet in sheets:
        if sheet.amount<0.0001:continue
        at=world_local(sheet.root,origin);start=out.len()
        splash_fan(out,at,sheet.back,sheet.right,sheet.run,t*2.0+sheet.phase,origin,t,sheet.reach,sheet.bow,1.0+sheet.heave,sheet.inner)
        fade=f32(sheet.amount)
        loop i in start..out.len():
            # Keep the user's water ovals/streaks in exactly the same places and
            # proportions. Only their size envelope changes, never their placement.
            streak=out[i].size.y==f32(0.018)
            if not streak:out[i].center=vec4(at+(out[i].center.xyz-at)*fade,out[i].center.w)
            out[i].size=vec4(out[i].size.xyz*fade,out[i].size.w)
    loop b in ps.billows:
        age=f64(b.age);life=f64(b.life)
        if age>=life:continue
        burst=b.count>=48
        # The detached lobes thrown by the float spray (and by touchdowns) are small,
        # slightly flattened and half as many, and break into the spray's small ovals early
        # rather than sailing on as big white eggs. Crash and plunge bursts keep their size.
        if not burst and fract(f64(b.phase)*0.618034)<0.5:continue
        fade=if burst:1.0-smoothstep(life*0.50,life,age) else:1.0-smoothstep(life*0.20,life*0.55,age)
        if not burst and age>=life*0.55:continue
        growth=smoothstep(0.0,min(0.18,life*0.3),age)
        radius=f64(b.radius)*pow(f64(b.count),0.25)*growth*fade
        # The original sampled velocity envelope expands the burst; drag limits its spread.
        spread=b.spread*f32((1.0-exp(-f64(ps.drag)*age))/max(0.01,f64(ps.drag))*0.45*fade)
        size=vec3(radius,radius*0.75,radius)+spread
        size=min(size,vec3(0.8,0.48,1.25))*f32(growth*fade)
        point=b.point
        # Falling splash bodies dissolve into the surface rather than floating below it.
        sea=f64(swell_at(point.x,point.z,t).x)
        if point.y+f64(size.y)<sea:continue
        # Sinking back, a billow shrinks into the water as it goes, rather than being sliced
        # flat by the surface into a white disc; and one the chase camera is about to pass
        # through shrinks away instead of filling the screen.
        under=clamp((sea-(point.y-f64(size.y)))/max(f64(size.y)*2.0,0.01),0.0,1.0)
        if not burst:size*=vec3(0.55,0.42,0.55)
        local=world_local(point,origin)
        near=f64(length(local-eye))
        size*=f32(sqrt(1.0-under)*(if burst: smoothstep(4.0,14.0,near) else: smoothstep(1.0,3.5,near)))
        if burst:
            # A big burst (a plunge or crash column) is a loose cluster of smaller lobes with
            # gaps between them, not one envelope-sized white oval that reads as a hole in the
            # sea from above.
            lobes=min(7,max(3,b.count/32))
            loop k in 0..lobes:
                a=f64(b.phase)+f64(k)*2.39996
                ring=0.45+0.4*fract(f64(k)*0.618034)
                offset=vec3(f32(cos(a)*ring)*size.x*1.3,f32(fract(f64(k)*0.37)-0.4)*size.y*1.6,f32(sin(a)*ring)*size.z)
                splash_add(out,local+offset,size*f32(0.40+0.2*fract(f64(k)*0.73)),f64(b.phase)+f64(k)+age*1.7)
            continue
        splash_add(out,local,size,f64(b.phase)+age*1.7)
        # A small detached lobe ends as a flat oval of foam spreading and thinning on the
        # sea beneath it, rather than simply vanishing.
        if fade<0.6:
            sea_local=world_local(WorldPoint(point.x,sea,point.z),origin)
            r=f64(b.radius)*pow(f64(b.count),0.25)*0.5*smoothstep(0.0,0.3,fade)*(1.6-fade)
            if r>0.004:splash_add(out,sea_local+vec3(0,0.01,0),vec3(f32(r),f32(r*0.12),f32(r*1.3)),f64(b.phase),vec3(f32(sin(f64(b.phase))),0,f32(cos(f64(b.phase)))),1.25)
    out

draw_splashes=(f:Flyer,model:CraftModel,pose:mat4,ps:WorldParticles,L:Light,t:f64,active:bool=true):
    global splash_motion
    step_splash_motion(splash_motion,splash_targets(f,model,pose,active),craft_point(f.state),t)
    snapshot=splash_motion
    draw_custom(():
        origin=render_origin(scene_camera())
        bodies=splash_instances(f,model,pose,ps,origin,t,active,snapshot)
        if bodies.len()>0:
            glDepthMask(1);glDisable(GL_CULL_FACE)
            white=L.sun*0.75+L.shade*0.25+vec3(0.18,0.20,0.21)
            params=SplashParams(render_view_proj(origin),render_eye(origin),L.sun_dir,white,L.haze,f32(L.fog_density),render_anchor(scene_warp_a,origin),scene_warp_b)
            large=[loop b in bodies:if not splash_small(b):b]
            small=[loop b in bodies:if splash_small(b):b]
            if large.len()>0:draw_instanced(splash_shader,splash_mesh,large,params)
            if small.len()>0:draw_instanced(splash_shader,splash_small_mesh,small,params)
    ,transparent=true)

draw_splash_dust=(ps:WorldParticles):
    # The shared impact system also carries brown dirt. Its existing rendering stays intact.
    dust=ps;dust.items=[loop p in ps.items:if p.color.x<=0.8 or p.color.y<=0.8:p]
    if dust.items.len()>0:draw_curved_particles(dust,false)
