# Closed, opaque splash bodies. One shared scalloped mesh, one instanced draw, no textures.
# Continuous float fans and detached emission envelopes use the same painted material.
use 'pilot.jo'
use 'flight.jo'
use 'flight_feedback.jo'
use 'planes.jo'
use 'damage.jo'
use 'flight_effects.jo'
use 'world_particles.jo'
use 'world_point.jo'
use 'sea.jo'
use 'look.jo'
use 'render_space.jo'
use 'depth_space.jo'
use 'curved_world.jo'

struct SplashVertex:
    pos:vec3
    normal:vec3
struct SplashInstance:
    center:vec4
    size:vec4
    back:vec4=vec4(0,0,1,0)
struct SplashParams:
    vp:mat4
    eye:vec3
    sun_dir:vec3
    white:vec3
    haze:vec3
    fog:f32
    warp_a:vec4
    warp_b:vec4
struct SplashOut:
    pos:vec4
    world:vec3
    normal:vec3
splash_vs=(v:SplashVertex,b:SplashInstance,u:SplashParams)->SplashOut:
    # The closed surface and its analytic smooth normals are baked together. A gentle
    # whole-body breath keeps the lobes moving without folding triangles into facets.
    radius=length(v.pos);sphere=v.pos/radius
    lobes=if b.center.w>1.5:1.0 else:mix(0.16,1.0,smoothstep(0.8,1.6,max(b.size.x,max(b.size.y,b.size.z))))
    radius2=mix(1.0,radius,lobes)
    n=sphere*radius2
    normal=normalize(sphere-(sphere-v.normal/max(0.01,dot(v.normal,sphere)))*(lobes*radius/radius2))
    breath=vec3(1.0+0.025*sin(b.size.w),1.0+0.04*sin(b.size.w*0.8),1.0)
    scale=b.size.xyz*breath
    back=b.back.xyz;horizontal=vec3(back.z,0,-back.x)
    right=if length(horizontal)>0.0001:normalize(horizontal) else:vec3(1,0,0)
    up=cross(back,right)
    shape=n
    local=shape*scale
    p=b.center.xyz+right*local.x+up*local.y+back*local.z
    normal=normalize(normal/max(scale,vec3(0.001,0.001,0.001)))
    normal=right*normal.x+up*normal.y+back*normal.z
    SplashOut(u.vp*vec4(render_warped(p,u.eye,u.warp_a,u.warp_b),1),p,normal)
splash_fs=(i:SplashOut,u:SplashParams)->vec4:
    facing=dot(normalize(i.normal),u.sun_dir)
    # Flat painted regions, with a small soft terminator following each round lobe.
    tone=mix(vec3(0.68,0.80,0.86),vec3(0.84,0.91,0.94),smoothstep(-0.60,-0.48,facing))
    tone=mix(tone,vec3(1,1,0.99),smoothstep(-0.06,0.07,facing))
    vec4(aerial(u.white*tone,i.world,u.eye,u.haze,u.fog),1)

# Gaussian caps on a sphere give rounded convex scallops in every viewing direction.
# The radial derivative supplies smooth normals, rather than triangle face normals or
# the undeformed sphere's normals. This mesh is shared by every body and made only once.
splash_vertex=(n:vec3)->SplashVertex:
    radius=0.82;gradient=vec3(0,0,0)
    loop j in 0..32:
        y=1.0-2.0*(f64(j)+0.5)/32.0
        r=sqrt(1.0-y*y);a=f64(j)*2.39996322972865
        d=vec3(r*cos(a),y,r*sin(a))
        cap=0.22*exp(22.0*(f64(dot(n,d))-1.0))
        radius+=cap;gradient+=d*f32(cap*22.0)
    normal=normalize(n-(gradient-n*dot(gradient,n))/f32(radius))
    SplashVertex(n*f32(radius),normal)

splash_shader:Shader
splash_mesh:Mesh
init_splashes=():
    global splash_shader,splash_mesh
    splash_shader=make_world_shader(shader(splash_vs,splash_fs))
    indices:u32[]
    # 64x40 resolves the scallops even close to the floats. The poles coincide exactly.
    point=(a:int,b:int)->SplashVertex:
        latitude=PI*f64(a)/40.0;longitude=TAU*f64(b%64)/64.0
        splash_vertex(vec3(sin(latitude)*cos(longitude),cos(latitude),sin(latitude)*sin(longitude)))
    grid:SplashVertex[]
    loop a in 0..41:
        loop b in 0..64:grid.push(point(a,b))
    loop a in 0..40:
        loop b in 0..64:
            c=(b+1)%64
            loop k in [a*64+b,(a+1)*64+b,a*64+c,a*64+c,(a+1)*64+b,(a+1)*64+c]:indices.push(u32(k))
    # Identical triangle order and vertices; reuse the 2,624 shared vertices instead
    # of running the vertex shader on 15,360 duplicated triangle corners per body.
    splash_mesh=mesh(grid,indices)

splash_heading=(back:vec3)->vec3:
    flat=vec3(back.x,0,back.z)
    if length(flat)>0.0001:normalize(flat) else:vec3(0,0,1)

splash_add=(out:mut SplashInstance[],p:vec3,size:vec3,phase:f64,back:vec3=vec3(0,0,1)):
    if min(size.x,min(size.y,size.z))>0.004:out.push(SplashInstance(vec4(p,1),vec4(size,f32(phase)),vec4(splash_heading(back),0)))

# Intersecting closed lobes make a continuous opaque volume with scalloped outer edges.
# The thin roots touch the water; the spreading body peels out and rises behind the step.
splash_fan=(out:mut SplashInstance[],root:vec3,back:vec3,right:vec3,run:f64,phase:f64,origin:vec3,t:f64,reach:f64=0.0,bow:f64=0.0):
    length=if reach>0.0:reach else:1.0+run*6.0
    # Two narrow scalloped curtains peel outward/back from the float's sides.
    # No central lobe: the float carves a clear trough along its own track.
    curtain_length=length*0.72+bow
    height=0.22+run*0.42*(1.0-run*0.65)
    width=0.16+run*0.27
    loop side in [-1.0,1.0]:
        direction=normalize(back+right*f32(side*(0.22+run*0.20)))
        edge=root-back*f32(bow)+right*f32(side*(0.38+run*0.12))
        # Overlapping short bodies keep round scallops along the long curtain;
        # stretching one sphere over the whole tail makes knife-straight fins.
        loop segment in 0..4:
            u=0.16+f64(segment)*0.23
            center=edge+direction*f32(curtain_length*u)+right*f32(side*0.22*sin(u*PI))+vec3(0,height*(0.45+0.20*sin(u*PI)),0)
            out.push(SplashInstance(vec4(center,3),vec4(width*(0.8+0.2*u),height*(0.7+0.3*sin(u*PI)),curtain_length*0.18,f32(phase+u)),vec4(direction,0)))
        # Rounded scallops on the outward rim, lower/aft as speed rises.
        loop j in 0..4:
            u=0.35+f64(j)*0.17
            radius=(0.10+run*0.16)*(0.9+0.1*sin(phase*0.55+u*5.0+side))
            p=edge+direction*f32(curtain_length*u)+right*f32(side*width*0.55)+vec3(0,height*(0.6+0.3*sin(u*PI)),0)
            splash_add(out,p,vec3(radius,radius*0.8,radius*1.3),phase+u*3.0,direction)
    # Tapered white marks touch the wet footprint; the sea shader is not changed.
    loop side in [-1.0,1.0]:
        loop j in 0..3:
            u=f64(j)/3.0
            p=root+back*f32(length*(0.60+u*0.60))+right*f32(side*(0.45+run*1.1+u*0.4))
            p.y=swell_at(f64(p.x)+f64(origin.x),f64(p.z)+f64(origin.z),t).x+0.035
            splash_add(out,p,vec3(0.04+run*0.025,0.018,0.6+run*0.55),phase,back)

# Presentation-only state: no forces, emission rates, RNG or damage changes.
# 95% attack in 0.20 s, release in 0.36 s; exact exponential integration is
# stable at 30/60/120 Hz and bridges momentary wet-contact changes in chop.
struct SplashSheet:
    root:WorldPoint
    back:vec3=vec3(0,0,1)
    right:vec3=vec3(1,0,0)
    run:f64=0.0
    reach:f64=0.0
    bow:f64=0.0
    amount:f64=0.0
    phase:f64=0.0
struct SplashMotion:
    sheets:SplashSheet[7]
    time:f64= -1.0
    anchor:WorldPoint
splash_motion=SplashMotion()
splash_ramp=(value:f64,target:f64,dt:f64)->f64:
    mix(value,target,1.0-exp(-max(0.0,dt)/(if target>value:0.065 else:0.12)))
splash_targets=(f:Flyer,model:CraftModel,pose:mat4,active:bool)->SplashSheet[]:
    s=f.state;out:SplashSheet[]
    rotation=pose;rotation[3]=vec4(0,0,0,1)
    anchor=flight_fx_anchor(f,pose)
    back=quat_rotate(s.orientation,vec3(0,0,1));right=quat_rotate(s.orientation,vec3(1,0,0))
    run=smoothstep(3.0,f.spec.stall_speed,water_run_speed(f.spec,s))
    gap=f64(s.position.y)-f.spec.float_height
    skim=if s.on_water or s.moored:0.0 else:(1.0-smoothstep(0.5,f.spec.span*0.6,gap))*smoothstep(28.0,60.0,f64(length(s.velocity))/pure_k(f.spec))
    loop part in 0..7:
        sheet=SplashSheet(back=back,right=right)
        aft= -1e30;wet= -1e30;front=1e30
        loop p in model.contacts:
            if contact_part(f.kind,p)!=part or part_health(s.damage,PartId(part))<=0:continue
            contact=world_offset(anchor,transform_point(rotation,p))
            sea=swell_at(contact.x,contact.z,f.sea_t)
            if f64(p.z)>aft:
                aft=f64(p.z);sheet.root=contact;sheet.phase=f64(p.x)*1.7
            if active and s.on_water and not s.moored and not s.crashed and run>0.0 and contact.y<=f64(sea.x)+0.18:
                wet=max(wet,f64(p.z));front=min(front,f64(p.z))
        if wet> -1e29:
            loop p in model.contacts:
                if contact_part(f.kind,p)==part and f64(p.z)==wet:
                    sheet.root=world_offset(anchor,transform_point(rotation,p))
                    sheet.root.y=f64(swell_at(sheet.root.x,sheet.root.z,f.sea_t).x)+0.04
            sheet.run=run;sheet.amount=smoothstep(0.0,0.04,run)
            sheet.bow=(wet-front)*(1.0-run*0.55)
        else if active and not s.crashed and skim>0.1 and aft> -1e29:
            tail=world_offset(sheet.root,splash_heading(back)*f32(4.0+skim*7.0))
            tail.y=f64(swell_at(tail.x,tail.z,f.sea_t).x)+0.08
            delta=world_delta(tail,sheet.root)
            sheet.back=normalize(delta);sheet.reach=f64(length(delta))
            sheet.run=skim*0.65;sheet.amount=smoothstep(0.1,0.25,skim)
        out.push(sheet)
    out

step_splash_motion=(motion:mut SplashMotion,targets:SplashSheet[],anchor:WorldPoint,t:f64):
    dt=if motion.time<0.0:0.0 else:max(0.0,t-motion.time)
    if t<motion.time or length(world_delta(anchor,motion.anchor))>250.0:motion=SplashMotion()
    loop part in 0..7:
        next=targets[part];previous=motion.sheets[part]
        # Track the live float, even while its release envelope drains away.
        if next.amount>0.0:
            previous.root=next.root;previous.back=next.back;previous.right=next.right;previous.phase=next.phase
            previous.run=splash_ramp(previous.run,next.run,dt)
            previous.reach=splash_ramp(previous.reach,next.reach,dt)
            previous.bow=splash_ramp(previous.bow,next.bow,dt)
        else if motion.time>=0.0:
            delta=world_delta(anchor,motion.anchor)
            previous.root=world_offset(previous.root,vec3(delta.x,0,delta.z))
        previous.amount=splash_ramp(previous.amount,next.amount,dt)
        motion.sheets[part]=previous
    motion.anchor=anchor;motion.time=t

splash_instances=(f:Flyer,model:CraftModel,pose:mat4,ps:WorldParticles,origin:vec3,t:f64,active:bool=true,motion:SplashMotion?=none)->SplashInstance[]:
    out:SplashInstance[]
    sheets=splash_targets(f,model,pose,active)
    if let m=motion:sheets=[loop sheet in m.sheets:sheet]
    loop sheet in sheets:
        if sheet.amount<0.0001:continue
        at=world_local(sheet.root,origin);start=out.len()
        splash_fan(out,at,sheet.back,sheet.right,sheet.run,t*2.0+sheet.phase,origin,t,sheet.reach,sheet.bow)
        fade=f32(sheet.amount)
        loop i in start..out.len():
            # Keep the user's water ovals/streaks in exactly the same places and
            # proportions. Only their size envelope changes, never their placement.
            streak=out[i].size.y==f32(0.018)
            if not streak:out[i].center=vec4(at+(out[i].center.xyz-at)*fade,out[i].center.w)
            out[i].size=vec4(out[i].size.xyz*fade,out[i].size.w)
    loop b in ps.billows:
        age=f64(b.age);life=f64(b.life)
        if age>=life:continue
        fade=1.0-smoothstep(life*0.50,life,age)
        growth=smoothstep(0.0,min(0.18,life*0.3),age)
        radius=f64(b.radius)*pow(f64(b.count),0.25)*growth*fade
        # The original sampled velocity envelope expands the burst; drag limits its spread.
        spread=b.spread*f32((1.0-exp(-f64(ps.drag)*age))/max(0.01,f64(ps.drag))*0.45*fade)
        size=vec3(radius,radius*0.75,radius)+spread
        size=min(size,vec3(0.8,0.48,1.25))*f32(growth*fade)
        point=b.point
        # Falling splash bodies dissolve into the surface rather than floating below it.
        sea=f64(swell_at(point.x,point.z,t).x)
        if point.y+f64(size.y)<sea:continue
        splash_add(out,world_local(point,origin),size,f64(b.phase)+age*1.7)
    out

draw_splashes=(f:Flyer,model:CraftModel,pose:mat4,ps:WorldParticles,L:Light,t:f64,active:bool=true):
    global splash_motion
    step_splash_motion(splash_motion,splash_targets(f,model,pose,active),craft_point(f.state),t)
    snapshot=splash_motion
    draw_custom(():
        origin=render_origin(scene_camera())
        bodies=splash_instances(f,model,pose,ps,origin,t,active,snapshot)
        if bodies.len()>0:
            glDepthMask(1);glDisable(GL_CULL_FACE)
            white=L.sun*0.75+L.shade*0.25+vec3(0.18,0.20,0.21)
            draw_instanced(splash_shader,splash_mesh,bodies,SplashParams(render_view_proj(origin),render_eye(origin),L.sun_dir,white,L.haze,f32(L.fog_density),render_anchor(scene_warp_a,origin),scene_warp_b))
    ,transparent=true)

draw_splash_dust=(ps:WorldParticles):
    # The shared impact system also carries brown dirt. Its existing rendering stays intact.
    dust=ps;dust.items=[loop p in ps.items:if p.color.x<=0.8 or p.color.y<=0.8:p]
    if dust.items.len()>0:draw_curved_particles(dust,false)
