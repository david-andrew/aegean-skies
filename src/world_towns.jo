# Bounded settlement streaming. Full 160 m districts are generated one per
# frame; shared house/prop meshes and reused instance buffers bound GPU state.
use 'world.jo'
use 'geography.jo'
use 'settlements.jo'
use 'objects.jo'
use 'town_details.jo'
use 'look.jo'
use 'render_space.jo'
use 'port_mesh.jo'
use 'town_sites.jo'
use 'town_architecture.jo'
use 'quality.jo'
use 'settlement_ports.jo'

# Match the terrain's camera-relative projection. Multiplying 150 km absolute
# positions by a view matrix loses enough depth precision to tear thin paving.
# Subtract model/instance translations before adding local geometry. Material
# phases are carried by ObjParams; curvature and varyings stay in the local chart.
struct TownParams:
    light: ObjParams
    origin: vec3

town_project = (world: vec3,normal: vec3,color: vec4,u: TownParams,surface: vec3) -> ObjOut:
    curved = render_warped(world,u.light.cam,u.light.warp_a,u.light.warp_b)
    ObjOut(u.light.view_proj*vec4(curved,1),world,render_normal(normal,world,u.light.cam),color,surface)

town_vertex = (v: Vertex3D,u: TownParams) -> ObjOut:
    w = u.light.model*vec4(v.pos,1)
    town_project(w.xyz,(u.light.model*vec4(v.normal,0)).xyz,v.color*u.light.tint,u,obj_surface(v))

town_instance_vertex = (v: Vertex3D,inst: Instance3D,u: TownParams) -> ObjOut:
    w = render_model(inst.model,u.origin)*vec4(v.pos,1)
    if u.light.sway > 0.0 and v.color.y > v.color.x*1.15:
        bend = max(v.pos.y,0.0)*u.light.wind.z*0.006*(0.3+0.7*gust(w.xz,u.light.drift))
        w += vec4(u.light.wind.x*bend,0,u.light.wind.y*bend,0)
    town_project(w.xyz,(inst.model*vec4(v.normal,0)).xyz,v.color*inst.color,u,obj_surface(v,u.light.sway))

town_fragment = (v: ObjOut,u: TownParams) -> vec4:
    if behind_sea(v.world,u.light.cam): discard()
    obj_light(v,u.light)

# Original-town furniture is rigid. Do not pay for the general grove
# instancer's gust noise and bending when its sway uniform would be zero.
legacy_town_vertex = (v: Vertex3D,inst: Instance3D,u: ObjParams) -> ObjOut:
    w = render_model(inst.model,u.origin)*vec4(v.pos,1)
    ObjOut(u.view_proj*w,w.xyz,(inst.model*vec4(v.normal,0)).xyz,v.color*inst.color,obj_surface(v))

legacy_town_inst_sh: Shader
world_town_sh: Shader
world_town_inst_sh: Shader

const TOWN_DISTRICT = 160.0
const TOWN_DISTRICT_LIMIT = 40
struct TownDistrict:
    key: int
    settlement: int
    x: int
    z: int
    center: vec2
    houses: Instance3D[]
    props: Instance3D[][]
    paths: Vertex3D[]
    styles: int[]
    mesh_slot: int = -1
    sites: TownSite[]

struct FarTown:
    houses: Instance3D[]
    lots: PlaceLot[]
    cells: int[]
    styles: int[]
    harbor: Vertex3D[]
    hill: Vertex3D[]
    ready: bool = false

world_town_density = 1.0           # public quality knob, 0..1; changes decoration/range, never IDs
world_town_slots: TownDistrict[]
world_town_far: FarTown[]
world_town_harbors: Mesh
world_town_house: Mesh[]
world_town_proxy: Mesh[]
world_town_props: Mesh[]
world_town_house_buffer: InstanceBuffer[Instance3D][]
world_town_far_buffer: InstanceBuffer[Instance3D][]
world_town_prop_buffers: InstanceBuffer[Instance3D][]
world_town_paths: Mesh
world_town_path_meshes: Mesh[]
world_town_last_cam = vec3(1e9,1e9,1e9)
world_town_last_density = -1.0
world_town_generated = 0
world_town_near_count = 0
world_town_far_count = 0
world_town_active: int[]
legacy_town_index = -1

place_district_key = (id: int,x: int,z: int) -> int: id*65536+(x+128)*256+z+128

place_model = (p: PlaceParcel,base_height: f64 = 9.0) -> mat4:
    translation(p.at)*rotation_y(p.yaw)*scaling(vec3(f32(p.width/12.0),f32(p.height/base_height),f32(p.depth/12.0)))

place_prop = (lists: mut Instance3D[][],kind: int,p: vec2,yaw: f64 = 0.0,scale: f64 = 1.0):
    h = place_ground(p)
    if h < 0.4: return
    lists[kind].push(Instance3D(translation(vec3(p.x,f32(h+0.04),p.y))*rotation_y(yaw)*scaling(scale),vec4(1,1,1,1)))

build_town_district = (index: int,x: int,z: int,density: f64) -> TownDistrict:
    global world_town_far
    s = world_settlements[index]
    tangent = vec2(-s.out.y,s.out.x)
    center = s.center.xz+tangent*f32((f64(x)+0.5)*TOWN_DISTRICT)-s.out*f32((f64(z)+0.5)*TOWN_DISTRICT)
    houses: Instance3D[]; styles: int[]; props: Instance3D[][] = [loop k in 0..TOWN_PROP_COUNT: []]
    paths: Vertex3D[]
    sites: TownSite[]
    yaw = atan2(f64(s.out.x),f64(s.out.y))
    if not world_town_far[index].ready: world_town_far[index] = build_far_town(s)
    loop lot in world_town_far[index].lots:
        if int(floor(f64(lot.local.x)/TOWN_DISTRICT)) != x or int(floor(f64(lot.local.y)/TOWN_DISTRICT)) != z: continue
        if let p = place_ground_lot(s,lot):
            sites.push(site_from_parcel(p))
            color = town_house_color(p.seed)
            houses.push(Instance3D(place_model(p,f64(p.floors)*4.0+1.0),color))
            styles.push(p.floors-1+(if p.seed%4 == 0: 4 else: 0))
            if f64(p.seed%100)/100.0 > density: continue
            front_dir = vec2(f32(sin(p.yaw)),f32(cos(p.yaw)))
            right = vec2(front_dir.y,-front_dir.x)
            front = p.at.xz+front_dir*f32(p.depth*0.5+1.5)
            if p.seed%4 == 0: place_prop(props,4,front+right*3.0,p.yaw)
            if p.seed%9 == 0: place_prop(props,1,front+front_dir*0.5,p.yaw)
            if p.seed%13 == 0: place_prop(props,2,p.at.xz+right*9.0,p.yaw)
            if p.seed%23 == 0: place_prop(props,6,front,p.yaw)
            if p.seed%19 == 0: place_prop(props,12,front-right*3.0,p.yaw)
            if s.kind == .capital and p.seed%151 == 0: place_prop(props,11,p.at.xz+right*12.0,p.yaw)
    loop lane in site_lanes(sites): town_path(paths,lane.a,lane.b,lane.width,true)
    if s.size >= 100 and int(floor(f64(s.old.x)/TOWN_DISTRICT)) == x and int(floor(f64(s.old.y)/TOWN_DISTRICT)) == z:
        hill = place_to_world(s,s.old)
        town_path(paths,hill-tangent*24.0,hill+tangent*24.0,32.0,true)
        place_prop(props,8,hill,yaw,if s.kind == .capital: 2.1 else: 1.25)
        place_prop(props,10,hill+tangent*18.0-s.out*4.0,yaw)
        place_prop(props,3,hill-tangent*16.0+s.out*5.0,yaw)
        # Short retaining walls step with the hill rather than making an apron.
        loop side in [-1.0,1.0]:
            loop k in 0..5:
                a = hill+tangent*f32(-25+k*10)+s.out*f32(side*21.0)
                b = a+tangent*10.0
                pa = place_point(a); pb = place_point(b)
                town_beam(paths,pa+vec3(0,0.7,0),pb+vec3(0,0.7,0),0.7,rgb(0.67,0.62,0.51))
    loop street in place_streets(s,x,z): town_path(paths,street.a,street.b,street.width,street.paved)
    # Landmarks belong to exactly one district; no duplicate squares or piers.
    if x == 0 and z == 0:
        square = s.center.xz
        plan = place_square(s)
        if s.kind != .farm:
            town_path(paths,square-tangent*f32(plan.half_width),square+tangent*f32(plan.half_width),plan.depth,plan.paved)
            place_prop(props,if s.kind == .lighthouse: 15 else: 8,square-s.out*26.0,yaw,if s.kind == .capital: 1.6 else: 1.0)
            if s.kind != .lighthouse: place_prop(props,17,square-s.out*34.0+tangent*15.0,yaw)
        else:
            place_prop(props,13,square-s.out*18.0,yaw)
            place_prop(props,13,square-s.out*27.0,yaw)
        loop prop in plan.props: place_prop(props,prop.kind,place_to_world(s,prop.local),yaw+prop.yaw,prop.scale)
        if s.kind == .monastery:
            loop k in 0..4:
                add_house(paths,translation(place_point(square+tangent*f32(-27+k*18)-s.out*46.0))*rotation_y(yaw),16.0,10.0,7.0,s.seed+k)
        if s.harbor.len() > 0: paths.extend(build_port_mesh(s,true))
    if density > 0.4 and x == 0 and z == int(s.radius/TOWN_DISTRICT)-1:
        p = center
        if place_flat(p,12.0,0.3):
            place_prop(props,7,p,yaw)
            place_prop(props,13,p+tangent*25.0,yaw)
    TownDistrict(place_district_key(s.id,x,z),index,x,z,center,houses,props,paths,styles,sites=sites)

# Distant blocks keep the real parcel pattern, but skip expensive corner detail
# and street furniture. They are culled/replaced when a full district publishes.
town_house_color = (seed: int) -> vec4:
    town_site_color(seed)

build_far_town = (s: WorldSettlement) -> FarTown:
    houses: Instance3D[]; cells: int[]; styles: int[]; lots = place_lots(s)
    loop lot in lots:
        if let p = place_ground_lot(s,lot,false):
            houses.push(Instance3D(place_model(p),town_house_color(p.seed)))
            styles.push(if p.seed%4 == 0: 1 else: 0)
            cells.push(place_district_key(s.id,int(floor(f64(lot.local.x)/TOWN_DISTRICT)),int(floor(f64(lot.local.y)/TOWN_DISTRICT))))
    hill: Vertex3D[]
    if s.size >= 100:
        p = place_point(place_to_world(s,s.old))
        add_chapel(hill,translation(p)*rotation_y(atan2(f64(s.out.x),f64(s.out.y)))*scaling(if s.kind == .capital: 2.1 else: 1.25))
    FarTown(houses,lots,cells,styles,build_far_harbor(s),hill,true)

build_legacy_town_detail = (tw: Town,index: int) -> TownDistrict:
    vs: Vertex3D[]
    props: Instance3D[][] = [loop k in 0..TOWN_PROP_COUNT: []]
    tangent = vec2(-tw.out.y,tw.out.x)
    yaw = atan2(f64(tw.out.x),f64(tw.out.y))
    loop lane in site_lanes(tw.sites): town_path(vs,lane.a,lane.b,lane.width,true)
    loop k in 0..tw.houses.len():
        hp = tw.houses[k]
        front = hp.xz+tw.out*8.0
        if place_ground(front) < 1.0: continue
        # Frontage strips join only nearby frontages, never across house centers.
        town_path(vs,front-tangent*6.0,front+tangent*6.0,2.0,true)
        if k > 0:
            prev = tw.houses[k-1].xz+tw.out*8.0
            if length(prev-front) < 25.0: town_path(vs,prev,front,2.0,true)
        if f64(place_hash(index+1,k)%100)/100.0>=world_town_density or k%(3-render_quality.tier)!=0: continue
        kinds = [4]
        if k%8 == 0: kinds.push(1)
        if k%11 == 0: kinds.push(2)
        if k%17 == 0: kinds.push(6)
        if k%19 == 0: kinds.push(12)
        loop kind in kinds:
            p = front+tangent*f32(if kind == 4: 4.0 else: -2.0)
            place_prop(props,kind,p,yaw)
    # The original ports use the same seeded furniture plans at their dry quay
    # roots; their existing houses, chapel geometry and contact remain unchanged.
    root = tw.center.xz-tw.out*18.0
    loop prop in place_square(world_settlements[index]).props:
        p = root+tangent*prop.local.x-tw.out*prop.local.y
        safe = place_ground(p) >= 0.5
        loop house in tw.houses:
            if length(p-house.xz) < 8.0: safe = false
        if safe: place_prop(props,prop.kind,p,yaw+prop.yaw,prop.scale)
    # (a cypress or two by each chapel, clear of the houses)
    loop chapel in tw.chapels:
        loop side in [-1.0,1.0]:
            p = chapel.xz+tangent*f32(side*22.0)
            safe = place_ground(p) > 2.0 and slope_at(f64(p.x),f64(p.y)) < 0.3
            loop house in tw.houses:
                if length(p-house.xz) < 12.0: safe = false
            if not safe: continue
            place_prop(props,17,p,yaw)
            break
    TownDistrict(paths=vs,props=props)

init_world_towns = (towns: Town[]):
    global world_town_sh,world_town_inst_sh,legacy_town_inst_sh,world_town_far,world_town_harbors,world_town_house,world_town_proxy,world_town_props,world_town_house_buffer,world_town_far_buffer,world_town_prop_buffers,world_town_paths,world_town_path_meshes,legacy_town_index,world_town_density
    world_town_density = clamp(to_float(env("AEGEAN_TOWN_DENSITY") ?? "1") ?? 1.0,0.0,1.0)
    init_settlements(false,true)
    legacy_town_inst_sh = make_shader(shader(legacy_town_vertex,obj_fs))
    world_town_sh = make_shader(shader(town_vertex,town_fragment))
    world_town_inst_sh = make_shader(shader(town_instance_vertex,town_fragment))
    world_town_house = []
    loop style in 0..8:
        h: Vertex3D[]
        add_house(h,mat4(),12.0,12.0,f64(style%4+1)*4.0+1.0,if style >= 4: 0 else: 12)
        # Balconies belong to the close kit, aligned to actual window floors.
        world_town_house.push(custom_mesh(h))
    world_town_proxy = []
    loop style in 0..2:
        far: Vertex3D[]
        add_house_proxy(far,mat4(),12.0,12.0,9.0,if style == 0: 12 else: 0)
        world_town_proxy.push(custom_mesh(far))
    # (the plane tree's and the cypress's foliage marked to bend in the wind, uv.x 173)
    world_town_props = [loop k in 0..TOWN_PROP_COUNT: custom_mesh([loop v in town_prop_vertices(k): (if k == 10 or k == 17: Vertex3D(v.pos,v.normal,vec2(173,v.pos.y),v.color) else: v)])]
    empty: Instance3D[]; vertices: Vertex3D[]
    world_town_house_buffer = [loop k in 0..8: instance_buffer(empty)]
    world_town_far_buffer = [loop k in 0..2: instance_buffer(empty)]
    world_town_prop_buffers = [loop k in 0..TOWN_PROP_COUNT: instance_buffer(empty)]
    world_town_paths = custom_mesh(vertices)
    world_town_path_meshes = [loop k in 0..TOWN_DISTRICT_LIMIT: mesh(vertices)]
    world_town_far = [loop s in world_settlements: FarTown()]
    legacy_town_index = -1
    world_town_harbors = custom_mesh(vertices)

# Update only when moving a meaningful distance, a district publishes, or the
# density changes. Steady frames submit shared buffers without CPU regeneration.
prepare_world_towns = (cam: vec3):
    global world_town_slots,world_town_generated,world_town_active,world_town_last_cam,world_town_last_density,world_town_house_buffer,world_town_far_buffer,world_town_prop_buffers,world_town_paths,world_town_path_meshes,world_town_harbors,world_town_far,world_town_near_count,world_town_far_count
    loop world_town_far.len() < world_settlements.len(): world_town_far.push(FarTown())
    world_town_generated = 0
    density = clamp(world_town_density,0.0,1.0)
    changed = length(cam-world_town_last_cam) > 120.0 or density != world_town_last_density
    if density != world_town_last_density: world_town_slots = []
    if prepare_settlement_roads(cam.xz): changed = true
    range = 180.0+350.0*density
    desired: int[]; active: int[]
    next_index = -1; next_x = 0; next_z = 0; closest = 1e30
    loop index in 6..world_settlements.len():
        s = world_settlements[index]
        d = f64(length(cam.xz-s.center.xz))
        if d > 12000.0+33000.0*density+s.radius: continue
        active.push(index)
        if d > s.radius+range or f64(cam.y-s.center.y) > 1600.0: continue
        tangent = vec2(-s.out.y,s.out.x)
        local = vec2(dot(cam.xz-s.center.xz,tangent),-dot(cam.xz-s.center.xz,s.out))
        n = int(ceil(s.radius/TOWN_DISTRICT))
        cx = int(floor(f64(local.x)/TOWN_DISTRICT)); cz = int(floor(f64(local.y)/TOWN_DISTRICT))
        reach = int(ceil(range/TOWN_DISTRICT))
        loop z in max(-n,cz-reach)..min(n,cz+reach)+1:
            loop x in max(-n,cx-reach)..min(n,cx+reach)+1:
                center = s.center.xz+tangent*f32((f64(x)+0.5)*TOWN_DISTRICT)-s.out*f32((f64(z)+0.5)*TOWN_DISTRICT)
                if f64(length(center-s.center.xz)) > s.radius+135.0: continue
                dist = f64(length(cam.xz-center))
                if dist > range and not (x == 0 and z == 0 and d < 700.0): continue
                key = place_district_key(s.id,x,z); desired.push(key)
                found = false
                loop slot in world_town_slots:
                    if slot.key == key: found = true; break
                if not found and dist < closest: closest = dist; next_index = index; next_x = x; next_z = z
    kept: TownDistrict[]
    loop slot in world_town_slots:
        if slot.key in desired: kept.push(slot)
        else: changed = true
    world_town_slots = kept
    if next_index >= 0 and world_town_slots.len() < TOWN_DISTRICT_LIMIT:
        free_slot = -1
        loop k in 0..TOWN_DISTRICT_LIMIT:
            used = false
            loop slot in world_town_slots:
                if slot.mesh_slot == k: used = true; break
            if not used: free_slot = k; break
        district = build_town_district(next_index,next_x,next_z,density/f64(3-render_quality.tier))
        district.mesh_slot = free_slot
        update_mesh(world_town_path_meshes[free_slot],district.paths)
        district.paths = [] # GPU owns the paving; no resident CPU copy/aggregation.
        world_town_slots.push(district)
        changed = true; world_town_generated = 1
    # Retain only the nearest 24 silhouettes (8 at minimum density).
    limit = 8+int(density*16.0)
    loop active.len() > limit:
        worst = 0; distance = -1.0
        loop k in 0..active.len():
            d = f64(length(world_settlements[active[k]].center.xz-cam.xz))
            if d > distance: distance = d; worst = k
        active.remove_at(worst)
    next_far = -1; closest_far = 1e30
    loop index in 6..world_town_far.len():
        if not (index in active):
            if world_town_far[index].ready: world_town_far[index] = FarTown(); changed = true
        else if not world_town_far[index].ready:
            d = f64(length(world_settlements[index].center.xz-cam.xz))
            if d < closest_far: next_far = index; closest_far = d
    if next_far >= 0:
        world_town_far[next_far] = build_far_town(world_settlements[next_far])
        changed = true
    if not changed: return
    world_town_active = active
    world_town_last_cam = cam; world_town_last_density = density
    houses: Instance3D[][] = [loop k in 0..8: []]; far: Instance3D[][] = [[],[]]; props: Instance3D[][] = [loop k in 0..TOWN_PROP_COUNT: []]
    paths: Vertex3D[]; harbors: Vertex3D[]; keys: {int: bool} = {}
    loop slot in world_town_slots:
        keys[slot.key] = true
        loop k in 0..slot.houses.len(): houses[slot.styles[k]].push(slot.houses[k])
        loop k in 0..TOWN_PROP_COUNT: props[k].extend(slot.props[k])
    loop index in active:
        ft = world_town_far[index]
        place = world_settlements[index]
        if not (place_district_key(place.id,0,0) in keys): harbors.extend(ft.harbor)
        if not (place_district_key(place.id,int(floor(f64(place.old.x)/TOWN_DISTRICT)),int(floor(f64(place.old.y)/TOWN_DISTRICT))) in keys): harbors.extend(ft.hill)
        loop k in 0..ft.houses.len():
            if not (ft.cells[k] in keys): far[ft.styles[k]].push(ft.houses[k])
    # Nearby stretches of country roads: bounded to the same detail radius.
    loop road in settlement_roads:
        loop k in 0..road.points.len()-1:
            a = road.points[k]; b = road.points[k+1]
            delta = b.xz-a.xz; len = length(delta)
            u = clamp(dot(cam.xz-a.xz,delta)/max(dot(delta,delta),0.001),0.0,1.0)
            if length(cam.xz-a.xz-delta*u) > f32(range): continue
            margin = f32(range)/max(len,1.0)
            town_path(paths,a.xz+delta*max(0.0,u-margin),a.xz+delta*min(1.0,u+margin),road.width,false)
    world_town_near_count = 0; world_town_far_count = 0
    loop k in 0..8:
        world_town_near_count += houses[k].len(); set_instances(world_town_house_buffer[k],houses[k])
    loop k in 0..2:
        world_town_far_count += far[k].len(); set_instances(world_town_far_buffer[k],far[k])
    loop k in 0..TOWN_PROP_COUNT: set_instances(world_town_prop_buffers[k],props[k])
    update_mesh(world_town_paths,paths)
    update_mesh(world_town_harbors,harbors)

draw_world_towns = (towns: Town[],L: Light,t: f64):
    global legacy_town_index,world_town_last_density,world_town_paths,world_town_prop_buffers,world_town_far,world_town_last_cam,world_town_generated
    # One four-island catalog batch per rendered frame, even at minimum density.
    if prepare_settlement_registry():
        loop world_town_far.len() < world_settlements.len(): world_town_far.push(FarTown())
        world_town_last_cam = vec3(1e9,1e9,1e9)
    cam = scene_camera(); p = obj_params(L,t)
    legacy = -1
    loop k in 0..towns.len():
        if length(cam-towns[k].center) < 650.0  : legacy = k; break
    if legacy >= 0:
        world_town_generated=0
        if legacy_town_index != legacy:
            detail = build_legacy_town_detail(towns[legacy],legacy)
            update_mesh(world_town_paths,detail.paths)
            loop k in 0..TOWN_PROP_COUNT: set_instances(world_town_prop_buffers[k],detail.props[k])
            legacy_town_index = legacy
            world_town_last_density = -1.0
        draw(obj_sh,world_town_paths,p)
        loop k in 0..TOWN_PROP_COUNT:
            if world_town_prop_buffers[k].count > 0: draw_instanced(legacy_town_inst_sh,world_town_props[k],world_town_prop_buffers[k],p)
        draw_close_town(towns,cam,L,t)
        return
    else: legacy_town_index = -1
    if not geography_enabled: return
    # Ground-level original harbors cannot see beyond the protected archipelago.
    if abs(cam.x) < LEGACY_RESERVE-4000.0 and abs(cam.z) < LEGACY_RESERVE-4000.0 and cam.y < 250.0: return
    prepare_world_towns(cam)
    origin = render_origin(cam)
    p.view_proj = render_view_proj(origin)
    tp = TownParams(p,origin)
    if world_town_harbors.count > 0: draw(world_town_sh,world_town_harbors,tp)
    loop k in 0..2:
        if world_town_far_buffer[k].count > 0: draw_instanced(world_town_inst_sh,world_town_proxy[k],world_town_far_buffer[k],tp)
    loop k in 0..8:
        if world_town_house_buffer[k].count > 0: draw_instanced(world_town_inst_sh,world_town_house[k],world_town_house_buffer[k],tp)
    if world_town_paths.count > 0: draw(world_town_sh,world_town_paths,tp)
    loop slot in world_town_slots:
        if slot.mesh_slot >= 0 and world_town_path_meshes[slot.mesh_slot].count > 0: draw(world_town_sh,world_town_path_meshes[slot.mesh_slot],tp)
    loop k in 0..TOWN_PROP_COUNT:
        tp.light.sway = if k == 10 or k == 17: 1.0 else: 0.0
        if world_town_prop_buffers[k].count > 0: draw_instanced(world_town_inst_sh,world_town_props[k],world_town_prop_buffers[k],tp)
    draw_close_town(towns,cam,L,t)

# Aerial harbor silhouettes have no bollards, windows, or decorative meshes.
build_far_harbor = (s: WorldSettlement) -> Vertex3D[]:
    build_port_mesh(s,false)

# The close kit is created on the first walking-level visit, never at startup
# or for a distant aerial town. Reused buffers and a capped nearest-site list.
close_town_meshes: Mesh[]
close_town_buffers: InstanceBuffer[Instance3D][]
close_town_props: InstanceBuffer[Instance3D][]
close_town_paths: Mesh
close_town_last=vec3(1e9,1e9,1e9)
close_town_stamp=-1
close_town_density=-1.0
close_town_sites=0
close_town_instances=0

close_site_limit = () -> int: if render_quality.tier==0: 24 else: if render_quality.tier==1: 48 else: 80
close_site_radius = () -> f32: if render_quality.tier==0: 65.0 else: if render_quality.tier==1: 95.0 else: 130.0

close_sites = (towns: Town[],cam: vec3) -> TownSite[]:
    result: TownSite[]
    radius=close_site_radius()
    if abs(cam.y-f32(place_ground(cam.xz)))>=30: return result
    loop tw in towns:
        if length(cam.xz-tw.center.xz)>500: continue
        loop s in tw.sites:
            if length(cam.xz-s.at.xz)<radius: result.push(s)
    loop slot in world_town_slots:
        loop s in slot.sites:
            if length(cam.xz-s.at.xz)<radius: result.push(s)
    loop index in settlement_bins.get(geography_bin(f64(cam.x),f64(cam.z)),[]):
        place=world_settlements[index]
        if place.legacy>=0 or place.harbor.len()==0 or length(cam.xz-place.center.xz)>f32(port_span(place)+120): continue
        loop b in settlement_port(place).buildings:
            if length(cam.xz-b.at.xz)>=radius: continue
            if b.kind=="warehouse": continue
            result.push(TownSite(b.at,atan2(f64(place.out.x),f64(place.out.y)),b.width,b.depth,b.height,place.seed+int(b.width),max(1,int(b.height/4)),(place.seed+int(b.width))/11%4==0,service=true,door_y=f64(b.door.y)))
    result.sort((s: TownSite) -> f32: length(s.at.xz-cam.xz))
    loop result.len()>close_site_limit(): result.pop()
    result

prepare_close_town = (towns: Town[],cam: vec3):
    global close_town_meshes,close_town_buffers,close_town_props,close_town_paths,close_town_last,close_town_stamp,close_town_density,close_town_sites,close_town_instances
    stamp=world_town_slots.len()*4+render_quality.tier
    density=world_town_density
    if length(cam-close_town_last)<12 and stamp==close_town_stamp and density==close_town_density and world_town_generated==0: return
    close_town_last=cam; close_town_stamp=stamp; close_town_density=density
    sites=close_sites(towns,cam); close_town_sites=sites.len(); close_town_instances=0
    if close_town_meshes.len()==0:
        if sites.len()==0: return
        close_town_meshes=[loop k in 0..ARCH_COUNT: custom_mesh(arch_vertices(k))]
        empty: Instance3D[]; vertices: Vertex3D[]
        close_town_buffers=[loop k in 0..ARCH_COUNT: instance_buffer(empty)]
        close_town_props=[loop k in 0..TOWN_PROP_COUNT: instance_buffer(empty)]
        close_town_paths=custom_mesh(vertices)
    lists: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
    props: Instance3D[][]=[loop k in 0..TOWN_PROP_COUNT: []]
    paths: Vertex3D[]
    loop s in sites:
        distance=length(s.at.xz-cam.xz)
        ornament=f64(s.seed%100)/100<density and distance<close_site_radius()*(if render_quality.tier==0: 0.72 else: 0.9)
        arch_site(lists,props,s,ornament)
        if not s.modular and not s.service:
            loop tw in towns:
                if length(s.at.xz-tw.center.xz)>500: continue
                if let roof=site_roof_entry(s,tw.sites): arch_stairs(lists,roof)
        # Frontage paving and the side passage remain present at minimum density.
        a=site_point(s,-s.width*0.5-1.4,s.depth*0.5+2.5)
        b=site_point(s,s.width*0.5+1.4,s.depth*0.5+2.5)
        town_path(paths,a,b,3.5,true)
        arch_side_lanes(lists,paths,s,sites,ornament)
        if ornament: arch_courtyard(lists,props,paths,s,sites)
    loop k in 0..ARCH_COUNT:
        close_town_instances+=lists[k].len()
        set_instances(close_town_buffers[k],lists[k])
    loop k in 0..TOWN_PROP_COUNT:
        close_town_instances+=props[k].len()
        set_instances(close_town_props[k],props[k])
    update_mesh(close_town_paths,paths)

draw_close_town = (towns: Town[],cam: vec3,L: Light,t: f64):
    prepare_close_town(towns,cam)
    if close_town_meshes.len()==0 or close_town_sites==0: return
    origin=render_origin(cam); p=obj_params(L,t)
    p.view_proj=render_view_proj(origin)
    tp=TownParams(p,origin)
    if close_town_paths.count>0: draw(world_town_sh,close_town_paths,tp)
    loop k in 0..ARCH_COUNT:
        if close_town_buffers[k].count>0: draw_instanced(world_town_inst_sh,close_town_meshes[k],close_town_buffers[k],tp)
    loop k in 0..TOWN_PROP_COUNT:
        if close_town_props[k].count>0: draw_instanced(world_town_inst_sh,world_town_props[k],close_town_props[k],tp)
