use 'runtime_options.jo'
use 'build_slice.jo'
use 'canal_geometry.jo'
use 'walk_shapes.jo'
use 'world_point.jo'
use 'depth_space.jo'
# Bounded settlement streaming. Full 160 m districts are generated one per
# frame; shared house/prop meshes and reused instance buffers bound GPU state.
use 'world.jo'
use 'geography.jo'
use 'settlements.jo'
use 'objects.jo'
use 'town_details.jo'
use 'coast_paving.jo'
use 'coast_support.jo'
use 'look.jo'
use 'render_space.jo'
use 'port_mesh.jo'
use 'town_sites.jo'
use 'town_architecture.jo'
use 'town_visibility.jo'
use 'town_paving.jo'
use 'town_mesh.jo'
use 'quality.jo'
use 'settlement_ports.jo'
use 'town_region.jo'
use 'town_regional_mesh.jo'
use 'landing_stairs.jo'

# Match the terrain's camera-relative projection. Multiplying 150 km absolute
# positions by a view matrix loses enough depth precision to tear thin paving.
# Subtract model/instance translations before adding local geometry. Material
# phases are carried by ObjParams; curvature and varyings stay in the local chart.
struct TownParams:
    light: ObjParams
    origin: vec3

town_project = (world: vec3,normal: vec3,color: vec4,u: TownParams,surface: vec3) -> ObjOut:
    curved = render_world(world,u.light.cam)
    if u.light.warp_b.x>0: curved=render_warped(world,u.light.cam,u.light.warp_a,u.light.warp_b)
    ObjOut(u.light.view_proj*vec4(curved,1),world,render_normal(normal,world,u.light.cam),color,surface)

town_vertex = (v: Vertex3D,u: TownParams) -> ObjOut:
    w = u.light.model*vec4(v.pos,1)
    town_project(w.xyz,(u.light.model*vec4(v.normal,0)).xyz,v.color*u.light.tint,u,obj_surface(v))

town_instance_vertex = (v: Vertex3D,inst: Instance3D,u: TownParams) -> ObjOut:
    w = render_model(inst.model,u.origin)*vec4(v.pos,1)
    if u.light.sway > 0.0 and v.color.y > v.color.x*1.15:
        bend = max(v.pos.y,0.0)*u.light.wind.z*0.006*(0.3+0.7*gust(w.xz,u.light.drift))
        w += vec4(u.light.wind.x*bend,0,u.light.wind.y*bend,0)
    town_project(w.xyz,(inst.model*vec4(v.normal,0)).xyz,v.color*inst.color,u,obj_surface(v,u.light.sway))

town_fragment_log = (v: ObjOut, u: TownParams) -> vec4:
    set_depth(world_depth_encode(1.0 / v.pos.w))
    town_fragment(v, u)

town_fragment = (v: ObjOut,u: TownParams) -> vec4:
    if behind_sea(v.world,u.light.cam): discard()
    obj_light(v,u.light)

# Original-town furniture is rigid. Do not pay for the general grove
# instancer's gust noise and bending when its sway uniform would be zero.
legacy_town_vertex = (v: Vertex3D,inst: Instance3D,u: ObjParams) -> ObjOut:
    w = render_model(inst.model,u.origin)*vec4(v.pos,1)
    ObjOut(u.view_proj*w,w.xyz,(inst.model*vec4(v.normal,0)).xyz,v.color*inst.color,obj_surface(v))

legacy_town_inst_sh: Shader
world_town_sh: Shader
world_town_inst_sh: Shader

const TOWN_DISTRICT = 160.0
const TOWN_DISTRICT_LIMIT = 40
struct TownDistrict:
    key: int
    settlement: int
    x: int
    z: int
    center: vec2
    houses: Instance3D[]
    props: Instance3D[][]
    paths: Vertex3D[]
    styles: int[]
    mesh_slot: int = -1
    sites: TownSite[]

struct FarTown:
    houses: Instance3D[]
    lots: PlaceLot[]
    cells: int[]
    styles: int[]
    harbor: Vertex3D[]
    hill: Vertex3D[]
    ready: bool = false

world_town_density = 1.0           # public quality knob, 0..1; changes decoration/range, never IDs
world_town_slots: TownDistrict[]
world_town_far: FarTown[]
world_town_harbors: Mesh
world_town_house: Mesh[]
world_town_proxy: Mesh[]
world_town_props: Mesh[]
world_town_house_buffer: InstanceBuffer[Instance3D][]
world_town_far_buffer: InstanceBuffer[Instance3D][]
world_town_prop_buffers: InstanceBuffer[Instance3D][]
world_town_paths: Mesh
world_town_path_meshes: Mesh[]
world_town_last_cam = vec3(1e9,1e9,1e9)
world_town_last_density = -1.0
world_town_generated = 0
world_town_near_count = 0
world_town_far_count = 0
world_town_active: int[]
legacy_town_index = -1
legacy_paving: PavingDraw
world_town_support_roots: vec2[]
town_view_frame = -1
town_view_legacy = -1
town_view_visible = false

place_district_key = (id: int,x: int,z: int) -> int: id*65536+(x+128)*256+z+128

place_model = (p: PlaceParcel,base_height: f64 = 9.0) -> mat4:
    translation(p.at)*rotation_y(p.yaw)*scaling(vec3(f32(p.width/12.0),f32(p.height/base_height),f32(p.depth/12.0)))

place_prop = (lists: mut Instance3D[][],kind: int,p: vec2,yaw: f64 = 0.0,scale: f64 = 1.0):
    h = place_ground(p)
    if h < 0.4: return
    lists[kind].push(Instance3D(translation(vec3(p.x,f32(h+0.04),p.y))*rotation_y(yaw)*scaling(scale),vec4(1,1,1,1)))

# A district is built a slice at a time: its houses and props lot by lot, then its lanes,
# streets, square and port queued, then paved a 14 m cell at a time. It is drawn (and its far
# proxies dropped) only once whole; until then the far town stands in for it.
struct DistrictStep:
    kind: int            # 0 a path to pave, 1 fixed vertices, 2 the port's quays and buildings, 3 the port's furniture
    a: vec2 = vec2(0,0)
    b: vec2 = vec2(0,0)
    width: f64 = 0.0
    paved: bool = false
    verts: Vertex3D[]

struct DistrictJob:
    district: TownDistrict
    density: f64 = 1.0
    stage: int = 0       # 0 houses from lots, 1 queue the paving, 2 paving, 3 done
    lot: int = 0
    steps: DistrictStep[]
    step: int = 0
    cursor: PaveCursor = PaveCursor()
    paths: Vertex3D[]
    active: bool = false

district_pave = (a: vec2,b: vec2,width: f64,paved: bool) -> DistrictStep: DistrictStep(0,a,b,width,paved)

district_job = (index: int,x: int,z: int,density: f64) -> DistrictJob:
    s = world_settlements[index]
    tangent = vec2(-s.out.y,s.out.x)
    center = s.center.xz+tangent*f32((f64(x)+0.5)*TOWN_DISTRICT)-s.out*f32((f64(z)+0.5)*TOWN_DISTRICT)
    props: Instance3D[][] = [loop k in 0..TOWN_PROP_COUNT: []]
    DistrictJob(TownDistrict(place_district_key(s.id,x,z),index,x,z,center,props=props),density,active=true)

district_lot = (d: mut TownDistrict,s: WorldSettlement,lot: PlaceLot,density: f64):
    if int(floor(f64(lot.local.x)/TOWN_DISTRICT)) != d.x or int(floor(f64(lot.local.y)/TOWN_DISTRICT)) != d.z: return
    if let p = place_ground_lot(s,lot):
        d.sites.push(site_from_parcel(p))
        color = town_region_color(p.seed,p.country)
        d.houses.push(Instance3D(place_model(p,f64(p.floors)*4.0+1.0),color))
        d.styles.push(town_region_style(p.country,town_roof_flat(p.seed,p.country),p.floors))
        if f64(p.seed%100)/100.0 > density: return
        front_dir = vec2(f32(sin(p.yaw)),f32(cos(p.yaw)))
        right = vec2(front_dir.y,-front_dir.x)
        front = p.at.xz+front_dir*f32(p.depth*0.5+1.5)
        if p.seed%4 == 0: place_prop(d.props,4,front+right*3.0,p.yaw)
        if p.seed%9 == 0: place_prop(d.props,1,front+front_dir*0.5+right*f32(p.width*0.35),p.yaw)
        if p.seed%13 == 0: place_prop(d.props,2,p.at.xz+right*9.0,p.yaw)
        if p.seed%23 == 0: place_prop(d.props,6,front,p.yaw)
        if p.seed%19 == 0: place_prop(d.props,12,front-right*3.0,p.yaw)
        if s.kind == .capital and p.seed%151 == 0: place_prop(d.props,11,p.at.xz+right*12.0,p.yaw)

# The lanes, the old town's hill, the streets, the square and the port, in drawing order.
district_steps = (d: mut TownDistrict,s: WorldSettlement,density: f64) -> DistrictStep[]:
    x = d.x; z = d.z
    tangent = vec2(-s.out.y,s.out.x)
    yaw = atan2(f64(s.out.x),f64(s.out.y))
    steps: DistrictStep[]
    loop lane in site_lanes(d.sites): steps.push(district_pave(lane.a,lane.b,lane.width,true))
    if s.size >= 100 and int(floor(f64(s.old.x)/TOWN_DISTRICT)) == x and int(floor(f64(s.old.y)/TOWN_DISTRICT)) == z:
        hill = place_to_world(s,s.old)
        steps.push(district_pave(hill-tangent*24.0,hill+tangent*24.0,32.0,true))
        place_prop(d.props,town_region_prop(8,s.country),hill,yaw,if s.kind == .capital: 2.1 else: 1.25)
        place_prop(d.props,town_region_prop(10,s.country),hill+tangent*18.0-s.out*4.0,yaw)
        place_prop(d.props,3,hill-tangent*16.0+s.out*5.0,yaw)
        # Short retaining walls step with the hill rather than making an apron.
        walls: Vertex3D[]
        loop side in [-1.0,1.0]:
            loop k in 0..5:
                a = hill+tangent*f32(-25+k*10)+s.out*f32(side*21.0)
                b = a+tangent*10.0
                pa = place_point(a); pb = place_point(b)
                town_beam(walls,pa+vec3(0,0.7,0),pb+vec3(0,0.7,0),0.7,rgb(0.67,0.62,0.51))
        steps.push(DistrictStep(1,verts=walls))
    loop street in place_streets(s,x,z): steps.push(district_pave(street.a,street.b,street.width,street.paved))
    # Landmarks belong to exactly one district; no duplicate squares or piers.
    if x == 0 and z == 0:
        square = s.center.xz
        plan = place_square(s)
        if s.kind != .farm:
            steps.push(district_pave(square-tangent*f32(plan.half_width),square+tangent*f32(plan.half_width),plan.depth,plan.paved))
            place_prop(d.props,if s.kind == .lighthouse: 15 else: town_region_prop(8,s.country),square-s.out*26.0,yaw,if s.kind == .capital: 1.6 else: 1.0)
            if s.kind != .lighthouse: place_prop(d.props,17,square-s.out*34.0+tangent*15.0,yaw)
        else:
            place_prop(d.props,13,square-s.out*18.0,yaw)
            place_prop(d.props,13,square-s.out*27.0,yaw)
        loop prop in plan.props: place_prop(d.props,town_region_prop(prop.kind,s.country),place_to_world(s,prop.local),yaw+prop.yaw,prop.scale)
        if s.kind == .monastery:
            cells: Vertex3D[]
            loop k in 0..4:
                add_house(cells,translation(place_point(square+tangent*f32(-27+k*18)-s.out*46.0))*rotation_y(yaw),16.0,10.0,7.0,s.seed+k)
            steps.push(DistrictStep(1,verts=cells))
        if s.harbor.len() > 0 and not s.remote_harbor and s.legacy < 0:
            steps.push(DistrictStep(2))
            loop pave in port_mesh_paths(s): steps.push(district_pave(pave.a,pave.b,pave.width,pave.paved))
            steps.push(DistrictStep(3))
    if density > 0.4 and x == 0 and z == int(s.radius/TOWN_DISTRICT)-1:
        p = d.center
        if place_flat(p,12.0,0.3):
            place_prop(d.props,7,p,yaw)
            place_prop(d.props,13,p+tangent*25.0,yaw)
    steps

# Advance the district job until `until` (a time()); true once the district is whole. Its
# settlement's far town (the lots) must be ready.
district_job_advance = (job: mut DistrictJob,until: f64) -> bool:
    s = world_settlements[job.district.settlement]
    index = job.district.settlement
    if job.stage == 0:
        loop job.lot < world_town_far[index].lots.len():
            district_lot(job.district,s,world_town_far[index].lots[job.lot],job.density)
            job.lot += 1
            if time() > until: return false
        job.stage = 1
    if job.stage == 1:
        job.steps = district_steps(job.district,s,job.density)
        job.stage = 2
        if time() > until: return false
    loop job.step < job.steps.len():
        kind = job.steps[job.step].kind
        if kind == 0:
            if not town_path_part(job.paths,job.steps[job.step].a,job.steps[job.step].b,job.steps[job.step].width,job.steps[job.step].paved,vec3(0,0,0),job.cursor,until): return false
            job.cursor = PaveCursor()
        else if kind == 1: job.paths.extend(job.steps[job.step].verts)
        else if kind == 2: port_mesh_structures(job.paths,s,true)
        else: port_mesh_furniture(job.paths,s)
        job.step += 1
        if time() > until and job.step < job.steps.len(): return false
    job.stage = 3
    job.district.paths = job.paths
    true

# The whole district at once (tools and tests).
build_town_district = (index: int,x: int,z: int,density: f64) -> TownDistrict:
    global world_town_far
    if not world_town_far[index].ready: world_town_far[index] = build_far_town(world_settlements[index])
    job = district_job(index,x,z,density)
    _ = district_job_advance(job,1e30)
    job.district

# Distant blocks keep the real parcel pattern, but skip expensive corner detail
# and street furniture. They are culled/replaced when a full district publishes.
town_house_color = (seed: int) -> vec4:
    town_site_color(seed)

# A far town is made a slice at a time too: its lots, then their houses lot by lot, then the
# old town's chapel and the plain harbour.
struct FarJob:
    index: int = -1
    stage: int = 0
    town: FarTown
    lot: int = 0

far_job_advance = (job: mut FarJob,until: f64) -> bool:
    s = world_settlements[job.index]
    if job.stage == 0:
        job.town = FarTown(lots=place_lots(s))
        job.stage = 1
        if time() > until: return false
    if job.stage == 1:
        loop job.lot < job.town.lots.len():
            lot = job.town.lots[job.lot]
            job.lot += 1
            if let p = place_ground_lot(s,lot,false):
                job.town.houses.push(Instance3D(place_model(p),town_region_color(p.seed,p.country)))
                job.town.styles.push(town_region_proxy(p.country,town_roof_flat(p.seed,p.country)))
                job.town.cells.push(place_district_key(s.id,int(floor(f64(lot.local.x)/TOWN_DISTRICT)),int(floor(f64(lot.local.y)/TOWN_DISTRICT))))
            if time() > until: return false
        job.stage = 2
    if s.size >= 100:
        p = place_point(place_to_world(s,s.old))
        region_chapel(job.town.hill,translation(p)*rotation_y(atan2(f64(s.out.x),f64(s.out.y)))*scaling(if s.kind == .capital: 2.1 else: 1.25),s.country)
    job.town.harbor = build_far_harbor(s)
    job.town.ready = true
    job.stage = 3
    true

build_far_town = (s: WorldSettlement) -> FarTown:
    job = FarJob(index=settlement_by_id[s.id])
    _ = far_job_advance(job,1e30)
    job.town

# An original island town's paving and furniture, queued as a job (its props placed at once,
# its lanes and frontages paved a cell at a time); legacy_detail_finish publishes its solids.
legacy_detail_job = (tw: Town,index: int) -> DistrictJob:
    props: Instance3D[][] = [loop k in 0..TOWN_PROP_COUNT: []]
    steps: DistrictStep[]
    tangent = vec2(-tw.out.y,tw.out.x)
    yaw = atan2(f64(tw.out.x),f64(tw.out.y))
    loop lane in site_lanes(tw.sites): steps.push(district_pave(lane.a,lane.b,lane.width,true))
    loop k in 0..tw.houses.len():
        hp = tw.houses[k]
        front = hp.xz+tw.out*8.0
        if place_ground(front) < 1.0: continue
        # Frontage strips join only nearby frontages, never across house centers.
        steps.push(district_pave(front-tangent*6.0,front+tangent*6.0,2.0,true))
        if k > 0:
            prev = tw.houses[k-1].xz+tw.out*8.0
            if length(prev-front) < 25.0: steps.push(district_pave(prev,front,2.0,true))
        if f64(place_hash(index+1,k)%100)/100.0>=world_town_density or k%(3-render_quality.tier)!=0: continue
        kinds = [4]
        if k%8 == 0: kinds.push(1)
        if k%11 == 0: kinds.push(2)
        if k%17 == 0: kinds.push(6)
        if k%19 == 0: kinds.push(12)
        loop kind in kinds:
            p = front+tangent*f32(if kind == 4: 4.0 else: -2.0)
            place_prop(props,kind,p,yaw)
    # The original ports use the same seeded furniture plans at their dry quay
    # roots; their existing houses, chapel geometry and contact remain unchanged.
    root = tw.center.xz-tw.out*18.0
    loop prop in place_square(world_settlements[index]).props:
        p = root+tangent*prop.local.x-tw.out*prop.local.y
        safe = place_ground(p) >= 0.5
        loop house in tw.houses:
            if length(p-house.xz) < 8.0: safe = false
        if safe: place_prop(props,prop.kind,p,yaw+prop.yaw,prop.scale)
    # (a cypress or two by each chapel, clear of the houses)
    loop chapel in tw.chapels:
        loop side in [-1.0,1.0]:
            p = chapel.xz+tangent*f32(side*22.0)
            safe = place_ground(p) > 2.0 and slope_at(f64(p.x),f64(p.y)) < 0.3
            loop house in tw.houses:
                if length(p-house.xz) < 12.0: safe = false
            if not safe: continue
            place_prop(props,17,p,yaw)
            break
    DistrictJob(TownDistrict(key=index,props=props),stage=2,steps=steps,active=true)

legacy_detail_finish = (tw: Town,index: int,job: DistrictJob) -> TownDistrict:
    yaw = atan2(f64(tw.out.x),f64(tw.out.y))
    props = job.district.props
    solids: TownSite[]
    loop kind in 0..props.len():
        loop inst in props[kind]:
            at=inst.model[3].xz
            solids.extend(walk_prop_sites(kind,at,yaw,f64(length(inst.model[0].xyz))))
    walk_publish("legacy:{index}",solids)
    TownDistrict(paths=job.paths,props=props)

build_legacy_town_detail = (tw: Town,index: int) -> TownDistrict:
    job = legacy_detail_job(tw,index)
    _ = district_job_advance(job,1e30)
    legacy_detail_finish(tw,index,job)

legacy_job: DistrictJob

init_world_towns = (towns: Town[]):
    global world_town_sh,world_town_inst_sh,legacy_town_inst_sh,world_town_far,world_town_harbors,world_town_house,world_town_proxy,world_town_props,world_town_house_buffer,world_town_far_buffer,world_town_prop_buffers,world_town_paths,world_town_path_meshes,legacy_town_index,world_town_density
    world_town_density = clamp(to_float(env("AEGEAN_TOWN_DENSITY") ?? "1") ?? 1.0,0.0,1.0)
    init_settlements(false,true)
    legacy_town_inst_sh = make_shader(world_shader(shader(legacy_town_vertex, obj_fs), shader(legacy_town_vertex, obj_fs_log)))
    world_town_sh = make_shader(world_shader(shader(town_vertex, town_fragment), shader(town_vertex, town_fragment_log)))
    world_town_inst_sh = make_shader(world_shader(shader(town_instance_vertex, town_fragment), shader(town_instance_vertex, town_fragment_log)))
    world_town_house = []
    loop style in 0..REGION_HOUSE_COUNT:
        h: Vertex3D[]
        region_house(h,mat4(),12,12,f64(style%4+1)*4+1,1+style/8,style%8>=4)
        # Balconies belong to the close kit, aligned to actual window floors.
        world_town_house.push(town_mesh(h))
    world_town_proxy = []
    loop style in 0..REGION_PROXY_COUNT:
        far: Vertex3D[]
        region_house(far,mat4(),12,12,9,1+style/2,style%2==1,false)
        world_town_proxy.push(town_mesh(far))
    # (the plane tree's and the cypress's foliage marked to bend in the wind, uv.x 173)
    world_town_props = [loop k in 0..TOWN_PROP_COUNT: town_mesh([loop v in town_prop_vertices(k): (if town_prop_foliage(k): Vertex3D(v.pos,v.normal,vec2(173,v.pos.y),v.color) else: v)])]
    empty: Instance3D[]; vertices: Vertex3D[]
    world_town_house_buffer = [loop k in 0..REGION_HOUSE_COUNT: instance_buffer(empty)]
    world_town_far_buffer = [loop k in 0..REGION_PROXY_COUNT: instance_buffer(empty)]
    world_town_prop_buffers = [loop k in 0..TOWN_PROP_COUNT: instance_buffer(empty)]
    world_town_paths = custom_mesh(vertices)
    world_town_path_meshes = [loop k in 0..TOWN_DISTRICT_LIMIT: mesh(vertices)]
    world_town_far = [loop s in world_settlements: FarTown()]
    legacy_town_index = -1
    world_town_harbors = custom_mesh(vertices)

# Town building (districts, far towns, the close kit) shares this much of each frame, so
# arriving in a town never stalls a frame on it; nearest work goes first.
const TOWN_BUILD_BUDGET = 0.004
town_build_until = 0.0

struct DistrictWant:
    key: int
    index: int
    x: int
    z: int
    distance: f64

world_town_parked: TownDistrict[]       # built districts out of range, kept (with their mesh slot) for a return
world_town_job: DistrictJob
world_town_paused: DistrictJob[]        # jobs put aside for a nearer district, resumed where they stopped
world_town_far_job: FarJob
world_town_lake_ports: {int: Vertex3D[]}
world_town_harbor_sign = ""
world_town_roads_cam = vec3(1e9,1e9,1e9)
world_town_roads_job: DistrictJob
world_town_track = vec3(1e9,1e9,1e9)    # the camera a moment ago, and when, for its course
world_town_track_t = 0.0
world_town_course = vec3(0,0,0)
world_town_approach = -1                # the settlement a low flight is heading for, if any
world_town_approach_at = vec2(0,0)      # (its harbour, else its square)

# Points a camera is about to pass (the title's next shot, along its path): the districts near each
# are wanted as if the camera were there, nearest the first point first, and kept while they are
# listed. world_towns_settled() is true once every district wanted is built.
world_town_expect: vec2[] = []
world_town_pending = 0
world_towns_expect = (points: vec2[]):
    global world_town_expect
    world_town_expect = points
world_towns_settled = () -> bool: world_town_pending == 0 and not world_town_job.active

# A pilot heading low for a town has its waterfront built on the way in: when the camera's
# course over the next 40 seconds runs past a harbour (or a square) that town's districts
# near it are built ahead, nearest the landing first, as if the camera were already there.
const TOWN_APPROACH_RANGE = 260.0
world_town_heading = (cam: vec3):
    global world_town_track,world_town_track_t,world_town_course,world_town_approach,world_town_approach_at
    now = time(); dt = now-world_town_track_t
    if dt >= 0.25:
        world_town_course = if dt < 2.0: (cam-world_town_track)/f32(dt) else: vec3(0,0,0)
        world_town_track = cam; world_town_track_t = now
    world_town_approach = -1
    speed = f64(length(world_town_course.xz))
    if speed < 12.0 or cam.y > 900.0: return
    dir = world_town_course.xz/f32(speed)
    best = 1e30
    loop index in 6..world_settlements.len():
        s = world_settlements[index]
        if s.id == CANAL_CITY_ID or s.legacy >= 0: continue
        target = if s.harbor.len() > 0: s.harbor[0].quay_a else: s.center.xz
        rel = target-cam.xz
        along = f64(dot(rel,dir))
        if along < -100.0 or along > speed*40.0: continue
        if f64(length(rel-dir*f32(along))) > 400.0: continue
        if along < best: best = along; world_town_approach = index; world_town_approach_at = target

# A mesh slot for a new district: a free one, else the farthest parked district's.
world_town_free_slot = (cam: vec3) -> int:
    global world_town_parked
    loop k in 0..TOWN_DISTRICT_LIMIT:
        used = false
        loop slot in world_town_slots:
            if slot.mesh_slot == k: used = true; break
        if not used:
            loop slot in world_town_parked:
                if slot.mesh_slot == k: used = true; break
        if not used: return k
    worst = -1; distance = -1.0
    loop k in 0..world_town_parked.len():
        d = f64(length(world_town_parked[k].center-cam.xz))
        if d > distance: distance = d; worst = k
    if worst < 0: return -1
    slot = world_town_parked[worst].mesh_slot
    world_town_parked.remove_at(worst)
    slot

# Work on the district `want` until `until`; true when it was published this call.
world_town_build = (want: DistrictWant,cam: vec3,until: f64) -> bool:
    global world_town_job,world_town_paused,world_town_slots,world_town_far,world_town_far_job,world_town_path_meshes
    if not world_town_far[want.index].ready:
        if world_town_far_job.index != want.index: world_town_far_job = FarJob(index=want.index)
        if not far_job_advance(world_town_far_job,until): return false
        world_town_far[want.index] = world_town_far_job.town; world_town_far_job = FarJob()
        if time() > until: return false
    if not world_town_job.active or world_town_job.district.key != want.key:
        if world_town_job.active:
            world_town_paused.push(world_town_job)
            # (a few, the nearest kept)
            loop world_town_paused.len() > 4:
                worst = 0; distance = -1.0
                loop k in 0..world_town_paused.len():
                    d = f64(length(world_town_paused[k].district.center-cam.xz))
                    if d > distance: distance = d; worst = k
                world_town_paused.remove_at(worst)
        resumed = -1
        loop k in 0..world_town_paused.len():
            if world_town_paused[k].district.key == want.key: resumed = k; break
        if resumed >= 0:
            world_town_job = world_town_paused[resumed]; world_town_paused.remove_at(resumed)
        else:
            world_town_job = district_job(want.index,want.x,want.z,clamp(world_town_density,0.0,1.0)/f64(3-render_quality.tier))
    if not district_job_advance(world_town_job,until): return false
    district = world_town_job.district
    world_town_job = DistrictJob()
    free_slot = world_town_free_slot(cam)
    if free_slot < 0: return false
    district.mesh_slot = free_slot
    update_mesh(world_town_path_meshes[free_slot],district.paths)
    district.paths = [] # GPU owns the paving; no resident CPU copy/aggregation.
    world_town_slots.push(district)
    true

# Update only when moving a meaningful distance, a district publishes, or the
# density changes. Steady frames submit shared buffers without CPU regeneration.
prepare_world_towns = (cam: vec3):
    global world_town_support_roots,world_town_slots,world_town_generated,world_town_active,world_town_last_cam,world_town_last_density,world_town_house_buffer,world_town_far_buffer,world_town_prop_buffers,world_town_paths,world_town_path_meshes,world_town_harbors,world_town_far,world_town_near_count,world_town_far_count
    global world_town_parked,world_town_job,world_town_paused,world_town_far_job,world_town_lake_ports,world_town_harbor_sign,world_town_roads_cam,world_town_roads_job,world_town_pending
    loop world_town_far.len() < world_settlements.len(): world_town_far.push(FarTown())
    world_town_generated = 0
    until = town_build_until
    density = clamp(world_town_density,0.0,1.0)
    changed = length(cam-world_town_last_cam) > 120.0 or density != world_town_last_density
    roads_changed = length(cam-world_town_roads_cam) > 120.0 or density != world_town_last_density
    if density != world_town_last_density:
        world_town_slots = []; world_town_parked = []; world_town_job = DistrictJob(); world_town_paused = []
    if prepare_settlement_roads(cam.xz,until=until): changed = true; roads_changed = true
    range = 180.0+350.0*density
    world_town_heading(cam)
    desired: int[]; active: int[]; wants: DistrictWant[]
    loop index in 6..world_settlements.len():
        s = world_settlements[index]
        if s.id==CANAL_CITY_ID:continue
        d = f64(length(cam.xz-s.center.xz))
        # (expected points: their nearest distance to this town, as the camera's own)
        expect_d = 1e30
        loop q in world_town_expect: expect_d = min(expect_d, f64(length(q-s.center.xz)))
        expected = expect_d < s.radius+range
        if d > 12000.0+33000.0*density+s.radius and not expected: continue
        active.push(index)
        approach = index == world_town_approach
        if not approach and not expected and (d > s.radius+range or f64(cam.y-s.center.y) > 1600.0): continue
        tangent = vec2(-s.out.y,s.out.x)
        local = vec2(dot(cam.xz-s.center.xz,tangent),-dot(cam.xz-s.center.xz,s.out))
        n = int(ceil(s.radius/TOWN_DISTRICT))
        cx = int(floor(f64(local.x)/TOWN_DISTRICT)); cz = int(floor(f64(local.y)/TOWN_DISTRICT))
        reach = int(ceil(range/TOWN_DISTRICT))
        whole = approach or expected
        loop z in (if whole: -n else: max(-n,cz-reach))..(if whole: n else: min(n,cz+reach))+1:
            loop x in (if whole: -n else: max(-n,cx-reach))..(if whole: n else: min(n,cx+reach))+1:
                center = s.center.xz+tangent*f32((f64(x)+0.5)*TOWN_DISTRICT)-s.out*f32((f64(z)+0.5)*TOWN_DISTRICT)
                if f64(length(center-s.center.xz)) > s.radius+135.0: continue
                dist = f64(length(cam.xz-center))
                if expected:
                    loop q in world_town_expect: dist = min(dist, f64(length(q-center)))
                ahead = if approach: f64(length(world_town_approach_at-center)) else: 1e30
                if dist > range and ahead > TOWN_APPROACH_RANGE and not (x == 0 and z == 0 and d < 700.0): continue
                key = place_district_key(s.id,x,z); desired.push(key)
                wants.push(DistrictWant(key,index,x,z,min(dist,ahead)))
    # Districts out of range are parked, not thrown away: coming back costs nothing.
    kept: TownDistrict[]
    loop slot in world_town_slots:
        if slot.key in desired: kept.push(slot)
        else: world_town_parked.push(slot); changed = true
    k = 0
    loop k < world_town_parked.len():
        if world_town_parked[k].key in desired:
            kept.push(world_town_parked[k]); world_town_parked.remove_at(k); changed = true
        else: k += 1
    world_town_slots = kept
    built: {int: bool} = {}
    loop slot in world_town_slots: built[slot.key] = true
    if world_town_job.active and not (world_town_job.district.key in desired): world_town_job = DistrictJob()
    world_town_paused = [loop job in world_town_paused: if job.district.key in desired: job]
    wants = [loop w in wants: if not (w.key in built): w]
    wants.sort((w: DistrictWant) -> f64: w.distance)
    world_town_pending = if world_town_slots.len() < TOWN_DISTRICT_LIMIT: wants.len() else: 0
    # Nearest first, a slice of a frame; one district published a frame at most.
    zone("district build")
    if wants.len() > 0 and world_town_slots.len() < TOWN_DISTRICT_LIMIT and time() < until:
        if world_town_build(wants[0],cam,until):
            changed = true; world_town_generated = 1
    zone_end()
    # Retain only the nearest 24 silhouettes (8 at minimum density).
    limit = 8+int(density*16.0)
    loop active.len() > limit:
        worst = 0; distance = -1.0
        loop k in 0..active.len():
            d = f64(length(world_settlements[active[k]].center.xz-cam.xz))
            if d > distance: distance = d; worst = k
        active.remove_at(worst)
    next_far = -1; closest_far = 1e30
    loop index in 6..world_town_far.len():
        if not (index in active):
            if world_town_far[index].ready: world_town_far[index] = FarTown(); changed = true
        else if not world_town_far[index].ready:
            d = f64(length(world_settlements[index].center.xz-cam.xz))
            if d < closest_far: next_far = index; closest_far = d
    # (a far town under way is finished first)
    if world_town_far_job.index >= 0 and world_town_far_job.index in active and not world_town_far[world_town_far_job.index].ready: next_far = world_town_far_job.index
    if next_far >= 0 and time() < until:
        if world_town_far_job.index != next_far: world_town_far_job = FarJob(index=next_far)
        if far_job_advance(world_town_far_job,until):
            world_town_far[next_far] = world_town_far_job.town; world_town_far_job = FarJob()
            changed = true
    zone("town gather")
    if changed:
        world_town_active = active
        world_town_last_density = density
        world_town_last_cam = cam
        houses: Instance3D[][] = [loop k in 0..REGION_HOUSE_COUNT: []]; far: Instance3D[][] = [loop k in 0..REGION_PROXY_COUNT: []]; props: Instance3D[][] = [loop k in 0..TOWN_PROP_COUNT: []]
        keys: {int: bool} = {}
        loop slot in world_town_slots:
            keys[slot.key] = true
            loop k in 0..slot.houses.len(): houses[slot.styles[k]].push(slot.houses[k])
            loop k in 0..TOWN_PROP_COUNT: props[k].extend(slot.props[k])
        # The harbours are remade only when which of them stand (and how) changes.
        sign = ""
        loop index in active:
            ft = world_town_far[index]
            place = world_settlements[index]
            if place.remote_harbor:
                if length(cam.xz-place.harbor[0].quay_a)<350 or landing_stairs_near(place.id,cam.xz,150.0): sign = "{sign}L{index};"
                else if ft.ready: sign = "{sign}h{index};"
            else if not (place_district_key(place.id,0,0) in keys) and ft.ready: sign = "{sign}h{index};"
            if not (place_district_key(place.id,int(floor(f64(place.old.x)/TOWN_DISTRICT)),int(floor(f64(place.old.y)/TOWN_DISTRICT))) in keys) and ft.ready: sign = "{sign}c{index};"
            loop k in 0..ft.houses.len():
                if not (ft.cells[k] in keys): far[ft.styles[k]].push(ft.houses[k])
        world_town_near_count = 0; world_town_far_count = 0
        loop k in 0..REGION_HOUSE_COUNT:
            world_town_near_count += houses[k].len(); set_instances(world_town_house_buffer[k],houses[k])
        loop k in 0..REGION_PROXY_COUNT:
            world_town_far_count += far[k].len(); set_instances(world_town_far_buffer[k],far[k])
        world_town_support_roots = []
        loop k in 0..TOWN_PROP_COUNT:
            set_instances(world_town_prop_buffers[k],props[k])
            loop inst in props[k]: world_town_support_roots.push(inst.model[3].xz)
        if sign != world_town_harbor_sign:
            world_town_harbor_sign = sign
            harbors: Vertex3D[]
            loop index in active:
                ft = world_town_far[index]
                place = world_settlements[index]
                if place.remote_harbor:
                    if "L{index};" in sign:
                        if not (place.id in world_town_lake_ports):
                            if world_town_lake_ports.len() > 4: world_town_lake_ports = {}
                            world_town_lake_ports[place.id] = build_port_mesh(place,true)
                        harbors.extend(world_town_lake_ports[place.id])
                    else: harbors.extend(ft.harbor)
                else if "h{index};" in sign: harbors.extend(ft.harbor)
                if "c{index};" in sign: harbors.extend(ft.hill)
            update_mesh(world_town_harbors,harbors)
    zone_end()
    if roads_changed:
        # Nearby stretches of country roads: bounded to the same detail radius, paved a slice
        # a frame like a district (the stretches drawn till now stay till they are whole).
        world_town_roads_cam = cam
        steps: DistrictStep[]
        loop road in settlement_roads:
            loop k in 0..road.points.len()-1:
                a = road.points[k]; b = road.points[k+1]
                delta = b.xz-a.xz; len = length(delta)
                u = clamp(dot(cam.xz-a.xz,delta)/max(dot(delta,delta),0.001),0.0,1.0)
                if length(cam.xz-a.xz-delta*u) > f32(range): continue
                margin = f32(range)/max(len,1.0)
                steps.push(district_pave(a.xz+delta*max(0.0,u-margin),a.xz+delta*min(1.0,u+margin),road.width,false))
        world_town_roads_job = DistrictJob(stage=2,steps=steps,active=true)
    if world_town_roads_job.active and time() < until:
        if district_job_advance(world_town_roads_job,until):
            update_mesh(world_town_paths,world_town_roads_job.paths)
            world_town_roads_job = DistrictJob()


prepare_town_view = (towns: Town[],cam: vec3):
    global legacy_cat_props,legacy_job
    global town_view_frame,town_view_legacy,town_view_visible,world_town_support_roots,legacy_paving,legacy_town_index,world_town_last_density,world_town_prop_buffers,world_town_far,world_town_last_cam,world_town_generated
    if town_view_frame == frame_number(): return
    town_view_frame = frame_number()
    global town_build_until
    town_build_until = time()+build_slice(TOWN_BUILD_BUDGET)
    if prepare_settlement_registry():
        loop world_town_far.len() < world_settlements.len(): world_town_far.push(FarTown())
        world_town_last_cam = vec3(1e9,1e9,1e9)
    legacy = -1
    loop k in 0..towns.len():
        if length(cam-towns[k].center) < 650.0: legacy = k; break
    town_view_legacy = legacy
    town_view_visible = true
    if legacy >= 0:
        world_town_generated = 0
        if legacy_town_index != legacy:
            if not legacy_job.active or legacy_job.district.key != legacy: legacy_job = legacy_detail_job(towns[legacy],legacy)
            done = district_job_advance(legacy_job,town_build_until)
            if done:
                detail = legacy_detail_finish(towns[legacy],legacy,legacy_job)
                legacy_job = DistrictJob()
                set_paving(legacy_paving,detail.paths)
                world_town_support_roots = []
                loop k in 0..TOWN_PROP_COUNT:
                    set_instances(world_town_prop_buffers[k],detail.props[k])
                    loop inst in detail.props[k]: world_town_support_roots.push(inst.model[3].xz)
                legacy_cat_props = detail.props[TOWN_CAT_PROP]
                legacy_town_index = legacy
                world_town_last_density = -1.0
    else:
        legacy_town_index = -1
        if not geography_enabled or (abs(cam.x) < LEGACY_RESERVE-4000.0 and abs(cam.z) < LEGACY_RESERVE-4000.0 and cam.y < 250.0):
            town_view_visible = false
            set_coast_support([])
            return
        zone("world towns");prepare_world_towns(cam);zone_end()
    zone("close town");prepare_close_town(towns,cam);zone_end()
    set_coast_support(world_town_support_roots+close_town_support_roots)

draw_world_towns = (towns: Town[],L: Light,t: f64):
    cam = scene_camera(); p = obj_params(L,t)
    prepare_town_view(towns,cam)
    if not town_view_visible: return
    if town_view_legacy >= 0:
        draw_paving(legacy_paving,obj_sh,p,cam)
        loop k in 0..TOWN_PROP_COUNT:
            if k != TOWN_CAT_PROP and world_town_prop_buffers[k].count > 0: draw_instanced(legacy_town_inst_sh,world_town_props[k],world_town_prop_buffers[k],p)
        draw_close_town(towns,cam,L,t)
        return
    origin = render_origin(cam)
    p.view_proj = render_view_proj(origin)
    tp = TownParams(p,origin)
    # Opaque near frontages write depth before the large shared house meshes.
    draw_close_town(towns,cam,L,t)
    if world_town_harbors.count > 0: draw(world_town_sh,world_town_harbors,tp)
    loop k in 0..REGION_PROXY_COUNT:
        if world_town_far_buffer[k].count > 0: draw_instanced(world_town_inst_sh,world_town_proxy[k],world_town_far_buffer[k],tp)
    loop k in 0..REGION_HOUSE_COUNT:
        if world_town_house_buffer[k].count > 0: draw_instanced(world_town_inst_sh,world_town_house[k],world_town_house_buffer[k],tp)
    if world_town_paths.count > 0: draw(world_town_sh,world_town_paths,tp)
    loop slot in world_town_slots:
        if slot.mesh_slot >= 0 and world_town_path_meshes[slot.mesh_slot].count > 0: draw(world_town_sh,world_town_path_meshes[slot.mesh_slot],tp)
    loop k in 0..TOWN_PROP_COUNT:
        tp.light.sway = if town_prop_foliage(k): 1.0 else: 0.0
        if k != TOWN_CAT_PROP and world_town_prop_buffers[k].count > 0: draw_instanced(world_town_inst_sh,world_town_props[k],world_town_prop_buffers[k],tp)

# Aerial harbor silhouettes have no bollards, windows, or decorative meshes.
build_far_harbor = (s: WorldSettlement) -> Vertex3D[]:
    build_port_mesh(s,false)

# The close kit is created on the first walking-level visit, never at startup
# or for a distant aerial town. Reused buffers and a capped nearest-site list.
close_town_meshes: Mesh[]
close_town_bounds: vec4[]
close_town_buffers: InstanceBuffer[Instance3D][]
close_town_props: InstanceBuffer[Instance3D][]
close_town_paths: PavingDraw
close_town_origin=vec3(0,0,0)
close_town_prop_roots:vec3[]
close_town_support_roots:vec2[]
close_town_last=vec3(1e9,1e9,1e9)
close_town_stamp=-1
close_town_density=-1.0
close_town_sites=0
close_town_instances=0
close_town_prop_count=0
close_town_prop_gap=0.0
close_town_local_bound=0.0
close_town_drawn_fixtures: vec4[]
legacy_cat_props: Instance3D[]          # the cats' spots (TOWN_CAT_PROP), drawn alive by src/cats.jo:
close_cat_props: Instance3D[]           # (the close kit's, about close_town_origin)

# the town cats' spots near p: (x, y, z, the way the cat faces as a world turn)
town_cat_homes = (p: vec3,radius: f32) -> vec4[]:
    result: vec4[]
    add = (at: vec3,m: mat4):
        if length(at.xz-p.xz)<radius: result.push(vec4(at,f32(atan2(f64(-m[0].z),f64(m[0].x)))))
    if town_view_legacy>=0:
        loop inst in legacy_cat_props: add(inst.model[3].xyz,inst.model)
    else:
        loop slot in world_town_slots:
            if length(slot.center-p.xz)>f32(TOWN_DISTRICT)+radius: continue
            loop inst in slot.props[TOWN_CAT_PROP]: add(inst.model[3].xyz,inst.model)
    if close_town_sites>0:
        loop inst in close_cat_props: add(inst.model[3].xyz+close_town_origin,inst.model)
    result
close_fixture_drawn = (kind: int,p: vec3) -> bool:
    loop fixture in close_town_drawn_fixtures:
        if int(fixture.w)==kind and length(fixture.xyz-world_local(world_point(p),close_town_origin))<0.08: return true
    false

close_site_limit = () -> int: if render_quality.tier==0: 24 else: if render_quality.tier==1: 48 else: 80
close_site_radius = () -> f32: if render_quality.tier==0: 65.0 else: if render_quality.tier==1: 95.0 else: 130.0

close_sites = (towns: Town[],cam: vec3) -> TownSite[]:
    result: TownSite[]
    radius=close_site_radius()
    if abs(cam.y-f32(place_ground(cam.xz)))>=30: return result
    loop tw in towns:
        if length(cam.xz-tw.center.xz)>500: continue
        loop s in tw.sites:
            if length(cam.xz-s.at.xz)<radius: result.push(s)
    loop slot in world_town_slots:
        loop s in slot.sites:
            if length(cam.xz-s.at.xz)<radius: result.push(s)
    loop index in settlement_bins.get(geography_bin(f64(cam.x),f64(cam.z)),[]):
        place=world_settlements[index]
        # A landing's waterfront is drawn whole with its jetty (lake_port_mesh).
        if place.legacy>=0 or place.harbor.len()==0 or place.remote_harbor or length(cam.xz-place.center.xz)>f32(port_span(place)+120): continue
        loop b in settlement_port(place).buildings:
            if length(cam.xz-b.at.xz)>=radius: continue
            result.push(TownSite(b.at,atan2(f64(place.out.x),f64(place.out.y)),b.width,b.depth,b.height,place.seed+int(b.width),max(1,int(b.height/4)),town_service_flat(place.seed+int(b.width),place.country,b.kind=="warehouse"),service=true,door_y=f64(b.door.y),country=place.country,warehouse=b.kind=="warehouse"))
    result.sort((s: TownSite) -> f32: length(s.at.xz-cam.xz))
    loop result.len()>close_site_limit(): result.pop()
    result

# One site's share of the close kit. Kept between rebuilds: the render origin moves by whole
# kilometres, so walking on, most sites come back unchanged and cost nothing.
struct CloseSiteKit:
    lists: Instance3D[][]
    props: Instance3D[][]
    paths: Vertex3D[]

# A rebuild of the close kit, a slice a frame (nearest sites first); the kit drawn until then
# stays, so nothing near the walker goes missing meanwhile.
struct CloseJob:
    active: bool = false
    cam: vec3 = vec3(0,0,0)
    origin: vec3 = vec3(0,0,0)
    density: f64 = 1.0
    sites: TownSite[]
    k: int = 0
    lists: Instance3D[][]
    props: Instance3D[][]
    paths: Vertex3D[]
    used: {str: CloseSiteKit}
    # (the site under way: its pieces, the paths it queued and those paved so far)
    open: bool = false
    key: str = ""
    kit: CloseSiteKit = CloseSiteKit()
    queued: TownPave[]
    queued_at: int[]
    queue: int = 0
    cursor: PaveCursor = PaveCursor()
    paved: Vertex3D[]
    paved_end: int[]
    # (publishing: see close_publish)
    pub_stage: int = 0
    pub_k: int = 0
    pub_i: int = 0
    local_sites: TownSite[]
    local_cam: vec3 = vec3(0,0,0)
    detailed: Instance3D[][]
    supports: vec2[]
    fixtures: vec4[]

close_site_kits: {str: CloseSiteKit}
close_job: CloseJob

# Everything a site's pieces depend on: the site, whether it is ornamented, the origin, and
# which of the kit's other sites stand near enough to bend its lanes, court or garden.
close_site_key = (s: TownSite,sites: TownSite[],ornament: bool,origin: vec3,density: f64) -> str:
    reach = max(s.width,s.depth)+16.0
    near = 0
    loop o in sites:
        if f64(length(o.at.xz-s.at.xz)) < reach+max(o.width,o.depth): near = (near+place_hash(int(floor(f64(o.at.x)*8.0)),int(floor(f64(o.at.z)*8.0))+o.seed))%1000000007
    "{s.at.x:.3},{s.at.y:.3},{s.at.z:.3},{s.seed},{s.yaw:.4},{s.width:.3},{s.depth:.3},{s.height:.3},{s.service},{s.modular},{s.rural},{ornament},{near},{origin.x},{origin.z},{density},{render_quality.tier}"

close_site_kit = (towns: Town[],s: TownSite,sites: TownSite[],ornament: bool,origin: vec3) -> CloseSiteKit:
    lists: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
    props: Instance3D[][]=[loop k in 0..TOWN_PROP_COUNT: []]
    paths: Vertex3D[]
    arch_site(lists,props,s,ornament,origin)
    if not s.modular and not s.service:
        loop tw in towns:
            if length(s.at.xz-tw.center.xz)>500: continue
            if let roof=site_roof_entry(s,tw.sites): arch_stairs(lists,roof,origin)
    # Frontage paving and the side passage remain present at minimum density.
    apron=if s.rural==2: 3.25 else: if s.service: 3.2 else: 2.5
    a=site_point(s,-s.width*0.5-1.4,s.depth*0.5+apron)
    b=site_point(s,s.width*0.5+1.4,s.depth*0.5+apron)
    town_street(paths,a,b,if s.rural==2: 5.0 else: if s.service: 5.2 else: 3.5,origin)
    arch_side_lanes(lists,paths,s,sites,ornament,origin)
    arch_farmstead(lists,props,paths,s,ornament,origin)
    if ornament:
        arch_courtyard(lists,props,paths,s,sites,origin)
        arch_rural_garden(lists,s,sites,origin)
    CloseSiteKit(lists,props,paths)

close_job_take = (key: str,kit: CloseSiteKit):
    global close_job
    close_job.used[key]=kit
    loop k in 0..ARCH_COUNT: close_job.lists[k].extend(kit.lists[k])
    loop k in 0..TOWN_PROP_COUNT: close_job.props[k].extend(kit.props[k])
    close_job.paths.extend(kit.paths)
    close_job.k+=1

close_job_for = (cam: vec3,density: f64,sites: TownSite[]) -> CloseJob:
    CloseJob(active=true,cam=cam,origin=render_origin(cam),density=density,sites=sites,lists=[loop k in 0..ARCH_COUNT: []],props=[loop k in 0..TOWN_PROP_COUNT: []])

prepare_close_town = (towns: Town[],cam: vec3):
    global close_town_last,close_town_stamp,close_town_density,close_town_meshes,close_town_bounds,close_town_buffers,close_town_props
    global close_job,close_site_kits,town_path_recording,town_path_recorded,town_path_recorded_at
    stamp=world_town_slots.len()*4+render_quality.tier
    density=world_town_density
    if not close_job.active:
        if length(cam-close_town_last)<12 and stamp==close_town_stamp and density==close_town_density and world_town_generated==0: return
        close_town_last=cam; close_town_stamp=stamp; close_town_density=density
        sites=close_sites(towns,cam)
        if sites.len()==0:
            empty=close_job_for(cam,density,sites)
            _=close_publish(towns,empty,1e30)
            return
        if close_town_meshes.len()==0:
            empty: Instance3D[]; vertices: Vertex3D[]
            close_town_meshes=[loop lod in 0..3: loop k in 0..ARCH_COUNT: town_mesh(if lod==2 or arch_has_lod(k): arch_vertices(k,lod) else: vertices)]
            close_town_bounds=[loop k in 0..ARCH_COUNT: town_mesh_bound(arch_vertices(k))]
            close_town_buffers=[loop k in 0..ARCH_COUNT*3: instance_buffer(empty)]
            close_town_props=[loop k in 0..TOWN_PROP_COUNT: instance_buffer(empty)]
        close_job=close_job_for(cam,density,sites)
    zone("close kit build")
    origin=close_job.origin
    loop close_job.k<close_job.sites.len():
        if not close_job.open:
            s=close_job.sites[close_job.k]
            distance=length(s.at.xz-close_job.cam.xz)
            ornament=f64(s.seed%100)/100<close_job.density and distance<close_site_radius()*(if render_quality.tier==0: 0.72 else: 0.9)
            key=close_site_key(s,close_job.sites,ornament,origin,close_job.density)
            if let cached=close_site_kits.get(key):
                close_job_take(key,cached)
                if time()>town_build_until and close_job.k<close_job.sites.len(): zone_end(); return
                continue
            # A new site: its pieces now, its paths queued to pave a cell at a time.
            town_path_recording=true; town_path_recorded=[]; town_path_recorded_at=[]
            kit=close_site_kit(towns,s,close_job.sites,ornament,origin)
            town_path_recording=false
            close_job.open=true; close_job.key=key; close_job.kit=kit
            close_job.queued=town_path_recorded; close_job.queued_at=town_path_recorded_at
            close_job.queue=0; close_job.cursor=PaveCursor(); close_job.paved=[]; close_job.paved_end=[]
            town_path_recorded=[]; town_path_recorded_at=[]
            if time()>town_build_until: zone_end(); return
        loop close_job.queue<close_job.queued.len():
            pave=close_job.queued[close_job.queue]
            if not town_path_part(close_job.paved,pave.a,pave.b,pave.width,pave.paved,pave.origin,close_job.cursor,town_build_until): zone_end(); return
            close_job.cursor=PaveCursor(); close_job.paved_end.push(close_job.paved.len()); close_job.queue+=1
        # (the paved paths back in their places among the site's other paving)
        kit=close_job.kit
        joined: Vertex3D[]; from=0; piece=0
        loop i in 0..close_job.queued.len():
            at=close_job.queued_at[i]
            if at>from: joined.extend(kit.paths[from..at])
            if close_job.paved_end[i]>piece: joined.extend(close_job.paved[piece..close_job.paved_end[i]])
            from=at; piece=close_job.paved_end[i]
        if kit.paths.len()>from: joined.extend(kit.paths[from..kit.paths.len()])
        kit.paths=joined
        close_job.open=false
        close_job_take(close_job.key,kit)
        if time()>town_build_until and close_job.k<close_job.sites.len(): zone_end(); return
    zone_end()
    if not close_publish(towns,close_job,town_build_until): return
    close_site_kits=close_job.used
    close_job=CloseJob()

# Draw the finished kit: its solids to walking, its pieces culled and sorted by detail, in
# slices (stage 0 the solids, 1 the cull a few pieces at a time, 2 the kit swapped in at once).
close_publish = (towns: Town[],job: mut CloseJob,until: f64) -> bool:
    global close_town_support_roots
    global close_cat_props
    global close_town_origin,close_town_prop_count,close_town_prop_gap,close_town_local_bound,close_town_prop_roots
    global close_town_meshes,close_town_bounds,close_town_buffers,close_town_props,close_town_paths,close_town_sites,close_town_instances,close_town_drawn_fixtures
    origin=job.origin
    if close_town_meshes.len()==0:
        close_town_drawn_fixtures=[];close_town_origin=origin;close_town_sites=job.sites.len();close_town_instances=0
        close_town_prop_count=0;close_town_prop_gap=0;close_town_local_bound=0;close_town_prop_roots=[];close_town_support_roots=[]
        return true
    if job.pub_stage==0:
        # Publish ground-level close-kit solids before visibility culling. Stairs,
        # door leaves, shutters, awnings and overhead balconies retain their gaps.
        solids: TownSite[]
        loop k in [8,13,20]:
            vertices=arch_vertices(k)
            low=vec3(1e9,1e9,1e9);high=vec3(-1e9,-1e9,-1e9)
            loop v in vertices:low=min(low,v.pos);high=max(high,v.pos)
            loop inst in job.lists[k]:
                middle=transform_point(inst.model,(low+high)*0.5)+origin
                sx=f64(length(inst.model[0].xyz));sy=f64(length(inst.model[1].xyz));sz=f64(length(inst.model[2].xyz))
                height=f64(high.y-low.y)*sy
                solids.push(TownSite(middle-vec3(0,f32(height*0.5),0),atan2(f64(inst.model[2].x),f64(inst.model[2].z)),f64(high.x-low.x)*sx,f64(high.z-low.z)*sz,height,0))
        loop kind in 0..job.props.len():
            loop inst in job.props[kind]:
                at=inst.model[3].xyz+origin
                solids.extend(walk_prop_sites(kind,at.xz,atan2(f64(inst.model[2].x),f64(inst.model[2].z)),f64(length(inst.model[0].xyz))))
        walk_publish("close-kit",solids)
        job.local_sites=[]
        loop site in job.sites:
            local_site=site; local_site.at=world_local(world_point(site.at),origin)
            job.local_sites.push(local_site)
        job.local_cam=world_local(world_point(job.cam),origin)
        job.detailed=[loop k in 0..ARCH_COUNT*3: []]
        job.pub_stage=1;job.pub_k=0;job.pub_i=0
        if time()>until: return false
    if job.pub_stage==1:
        loop job.pub_k<ARCH_COUNT:
            k=job.pub_k
            loop job.pub_i<job.lists[k].len():
                if job.pub_i%64==0 and time()>until: return false
                instance=job.lists[k][job.pub_i]; job.pub_i+=1
                bound=close_town_bounds[k]
                scale=max(length(instance.model[0].xyz),max(length(instance.model[1].xyz),length(instance.model[2].xyz)))
                if town_hidden(job.local_sites,job.local_cam,transform_point(instance.model,bound.xyz),bound.w*scale): continue
                if k == 8 or k == 9 or k == 11 or k == 12 or k == 13: job.supports.push(instance.model[3].xz+origin.xz)
                if k==8 or k==10 or k==11: job.fixtures.push(vec4(instance.model[3].xyz,f32(k)))
                distance=length(instance.model[3].xyz-job.local_cam)
                lod=if not arch_has_lod(k) or distance<32: 2 else: if distance<65: 1 else: 0
                job.detailed[k+lod*ARCH_COUNT].push(instance)
            job.pub_k+=1;job.pub_i=0
        job.pub_stage=2
        if time()>until: return false
    # (the new kit in at once: what is drawn and what walking asks of the drawn fixtures)
    close_town_origin=origin
    close_town_sites=job.sites.len(); close_town_instances=0
    close_town_prop_count=0;close_town_prop_gap=0;close_town_local_bound=0;close_town_prop_roots=[]
    close_town_drawn_fixtures=job.fixtures
    close_town_support_roots=job.supports
    loop k in 0..ARCH_COUNT:
        close_town_instances+=job.lists[k].len()
        if startup_aegean_walk_trace!=none:
            loop instance in job.lists[k]: close_town_local_bound=max(close_town_local_bound,f64(length(instance.model[3].xz)))
    loop k in 0..job.detailed.len(): set_instances(close_town_buffers[k],job.detailed[k])
    props=job.props
    loop k in 0..TOWN_PROP_COUNT:
        close_town_instances+=props[k].len()
        close_town_prop_count+=props[k].len()
        if startup_aegean_walk_trace!=none:
            loop inst in props[k]:
                at=inst.model[3].xyz
                close_town_prop_roots.push(at)
                close_town_local_bound=max(close_town_local_bound,f64(length(at.xz)))
                ground=place_ground(at.xz+origin.xz)
                close_town_prop_gap=max(close_town_prop_gap,abs(f64(at.y+origin.y)-ground-0.12))
        loop inst in props[k]: close_town_support_roots.push(inst.model[3].xz+origin.xz)
        set_instances(close_town_props[k],props[k])
    close_cat_props=props[TOWN_CAT_PROP]
    set_paving(close_town_paths,job.paths)
    true

draw_close_town = (towns: Town[],cam: vec3,L: Light,t: f64):
    if close_town_meshes.len()==0 or close_town_sites==0: return
    origin=render_origin(cam); p=obj_params(L,t)
    p.view_proj=render_view_proj(origin)
    p.model=translation(close_town_origin-origin)
    tp=TownParams(p,origin-close_town_origin)
    draw_paving(close_town_paths,world_town_sh,tp,cam,close_town_origin)
    loop group in 0..5:
        zone(["close openings","close balconies","close flowers","close structure","close domestic"][group])
        loop k in 0..close_town_buffers.len():
            kind=k%ARCH_COUNT
            g=if kind<6 or kind==17: 0 else: if kind==6: 1 else: if kind==9: 2 else: if kind>=14: 3 else: 4
            if g==group and close_town_buffers[k].count>0: draw_instanced(world_town_inst_sh,close_town_meshes[k],close_town_buffers[k],tp)
        zone_end()
    zone("close old props")
    loop k in 0..TOWN_PROP_COUNT:
        if k!=TOWN_CAT_PROP and close_town_props[k].count>0: draw_instanced(world_town_inst_sh,world_town_props[k],close_town_props[k],tp)
    zone_end()
