# No dead ends on foot. A walker who holds a direction and gets nowhere for a few seconds, and who
# is shut into a pocket (a sliver of shallows under a quay wall, a gap between two blocks, a hole a
# load or a lift put them in), is stepped up onto the nearest ground that is open. Standing against
# a wall or a house is not being stuck: the walk out of the pocket is tried first, and a walker who
# can go anywhere is left where they are.
# Pure CPU: the game says where the walker is and puts them where this says.
use 'world_point.jo'
use 'water_field.jo'
use 'objects.jo'

const WALK_STUCK_SECONDS = 3.0          # (holding a direction, getting nowhere, this long)
const WALK_STUCK_PROGRESS = 0.25        # (less than this share of the step asked for, is nowhere)
const WALK_POCKET_REACH = 30            # (a walker who can go this many metres from where they stand is not shut in)
const WALK_OUT_REACH = 40               # (how far to look for open ground)

struct WalkStuck:
    held = 0.0

# One frame of walking: `wanted` the metres the step asked for, `moved` the metres it got. True
# when it is time to look whether the walker is shut in (and the count starts again).
walk_stuck_step = (s: mut WalkStuck, wanted: f64, moved: f64, dt: f64) -> bool:
    if wanted < 0.0001 or moved >= wanted * WALK_STUCK_PROGRESS:
        s.held = 0.0
        return false
    s.held += dt
    if s.held < WALK_STUCK_SECONDS: return false
    s.held = 0.0
    true

# A step of one metre from the middle of a cell to the next, as the game would take it.
walk_cell_step = (towns: Town[], x: f64, z: f64, dx: int, dz: int) -> bool:
    p = WorldPoint(x, walk_height(towns, x, z), z)
    q = walk_step_precise(towns, p, vec2(f32(dx), f32(dz)))
    abs(q.x - x - f64(dx)) < 0.02 and abs(q.z - z - f64(dz)) < 0.02

# The metre cells one can walk to from `at` (cells within reach of it, as offsets from its
# middle), and whether they are shut in: no way out to WALK_POCKET_REACH metres away.
walk_pocket = (towns: Town[], at: WorldPoint) -> (bool, bool[], int):
    r = WALK_POCKET_REACH + 1
    n = r * 2 + 1
    seen: bool[]
    loop k in 0..n * n: seen.push(false)
    c0 = r * n + r
    seen[c0] = true
    # (depth first: out in the open it is across the reach in a few dozen steps; in a pocket it
    # has been through every cell of it)
    queue = [c0]
    shut = true
    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    loop queue.len() > 0:
        c = queue.pop()
        cx = c / n - r; cz = c % n - r
        if abs(cx) >= WALK_POCKET_REACH or abs(cz) >= WALK_POCKET_REACH: shut = false; break
        loop d in dirs:
            nx = cx + d.0; nz = cz + d.1
            k = (nx + r) * n + nz + r
            if seen[k]: continue
            if walk_cell_step(towns, at.x + f64(cx), at.z + f64(cz), d.0, d.1):
                seen[k] = true; queue.push(k)
    (shut, seen, n)

# Whether a spot is open ground to stand on: dry, clear of buildings, level enough all round that
# no ledge or pit is under it.
walk_open_ground = (towns: Town[], x: f64, z: f64) -> bool:
    h = walk_height(towns, x, z)
    w = water_at(x, z)
    if h < (if w.wet: w.level else: 0.0) + 0.25: return false
    here = vec2(f32(x), f32(z))
    if length(town_avoid_buildings(towns, here, h) - here) > 0.01: return false
    loop d in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
        a = walk_height(towns, x + f64(d.0), z + f64(d.1))
        if abs(a - h) > WALK_STEP_HEIGHT * 0.6: return false
    true

# Where a shut-in walker is stepped up to: none when they are not shut in, else the nearest open
# ground outside the pocket (rings out to WALK_OUT_REACH metres).
walk_escape = (towns: Town[], at: WorldPoint) -> WorldPoint?:
    shut, seen, n = walk_pocket(towns, at)
    if not shut: return none
    r = WALK_POCKET_REACH + 1
    tried = 0
    loop ring in 1..WALK_OUT_REACH + 1:
        found: WorldPoint[]
        loop dx in -ring..ring + 1:
            loop dz in -ring..ring + 1:
                if max(abs(dx), abs(dz)) != ring: continue
                inside = abs(dx) <= WALK_POCKET_REACH and abs(dz) <= WALK_POCKET_REACH and seen[(dx + r) * n + dz + r]
                if inside: continue
                x = at.x + f64(dx); z = at.z + f64(dz)
                if walk_open_ground(towns, x, z): found.push(WorldPoint(x, walk_height(towns, x, z), z))
        found.sort((q: WorldPoint): (q.x - at.x) * (q.x - at.x) + (q.z - at.z) * (q.z - at.z))
        # (open ground that is itself a pocket, a ledge in the rock, is no way out: the next)
        loop q in found:
            if tried >= 12: return found[0]
            tried += 1
            shut2, _, _ = walk_pocket(towns, q)
            if not shut2: return q
    none
