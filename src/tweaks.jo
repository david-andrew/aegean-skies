# Trial changes, each off by default and switched on in the pause menu's Tweaks page, so they can
# be compared side by side with the version that felt right (git tag liked-speed-3.3x: speed scale
# 3.3, true speed simply the drawn speed / the scale). Off, the game is that version.

struct Tweaks:
    pure_scale = true               # the speed scale as a pure scale: the engine pulls as it did
                                    # (acceleration as before), the top speed the scale's, and all
                                    # else by the true speed (drawn speed / scale) on the original
                                    # curves: lift and the takeoff, the stall, handling, the water's
                                    # forces, the cloth, the airframe, the sounds, the harm, the dial
    true_curve = false              # "true speed" on a curve: the drawn speed through taxiing,
                                    # takeoff and landing, the designed top at the drawn top (the
                                    # speedometer reads it), instead of the drawn speed / the scale
    quick_grip = false              # at a high drawn speed the way it goes follows the nose quicker
    airframe_true = false           # the wings' shake and the tail's flutter later (by true speed)
    cloth_true = false              # the cloth by the true speed, flapping slower and gentler
    new_sounds = true               # a deep roar, a whistle when very fast, the flapping steady and
                                    # faint, the engine's note rising with the speed too
    orbit_camera = false            # slow: once the mouse moves, an orbit as on foot; no guns

tweaks = Tweaks()

set_tweaks = (t: Tweaks):
    global tweaks
    tweaks = t
