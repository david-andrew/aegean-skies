# Trial changes, each off by default and switched on in the pause menu's Tweaks page, so they can
# be compared side by side with the version that felt right (git tag liked-speed-3.3x: speed scale
# 3.3, true speed simply the drawn speed / the scale). Off, the game is that version.

struct Tweaks:
    pure_scale = true               # the speed scale as a pure scale: the engine pulls as it did
                                    # (acceleration as before), the top speed the scale's, and all
                                    # else by the true speed (drawn speed / scale) on the original
                                    # curves: lift and the takeoff, the stall, handling, the water's
                                    # forces, the cloth, the airframe, the sounds, the harm, the dial
    auto_trim = false               # the stick let go in flight, the pilot holds the climb or descent
                                    # it was left in (the way the aircraft is going, not its nose);
                                    # off, it keeps the attitude it was left at
    skybarons_response = false     # equal true-speed power, 8g response and quicker roll/key response
    flight_model = 1                # 1 flight model v2, the rigid body with forces (src/flight_v2.jo),
                                    # the default; 0 the earlier model; 2 Sky Barons' own
                                    # (src/flight_sb.jo), for reference. In the air only
    fdm2_npcs = true                # the other aircraft fly v2 too, at the player's pure scale (Flight v2 page; off: the earlier model)
    fdm2_fighters = true            # battle fighters use v2 with the other NPCs (Flight v2 page)
    orbit_camera = true             # slow: once the mouse moves, an orbit as on foot; no guns
    player_toughness = 2.0         # how much more punishment the player's own aircraft takes than
                                    # an NPC's (combat damage to it is divided by this)
    generous_hits = true            # the player's rounds hit within hit_margin of an aircraft's parts
    hit_margin = 2.0                # metres added round each part an aircraft is hit as, for the player's rounds
    aim_assist = true               # the player's rounds, once fired, curve a little toward the most
                                    # obvious enemy near their path (never the controls or the aircraft)
    prop_torque = false             # the propeller's torque reaction rolls her (one float dug in on the
                                    # run); none for contra-rotating or push-pull pairs
    torque_swing = true             # the racers' propeller torque (the Schneider racers only): on the
                                    # take-off run the port float pressed in and the nose swung to
                                    # port (rudder holds it), just off the water a roll to port
    wing_vapour = false             # in a hard pull in very damp air, a thin sheet of vapour over the top
                                    # of the wings (src/wing_vapour.jo; the title's racers show it always)
    pointer_on_foot = env("AEGEAN_POINTER_ON_FOOT") == "1"  # (a trial) on foot the mouse stays a pointer: things
                                    # hovered are lit and a click uses them, a click on open ground walks
                                    # there, a drag turns the view (as in the rooms and at a table); off,
                                    # a click takes the mouse for the view and the screen's middle aims
    surf = env("AEGEAN_SURF") == "1"    # waves breaking on the shore as lace foam, a run-up over the sand
                                    # and wet sand, and the rough sea's white water round ships (surf.jo)
    brighter_ocean = env("AEGEAN_BRIGHT_SEA") == "1"  # the open sea keeps its luminous teal however high
                                    # one flies (off: it deepens toward navy from about 60 m up, sea.jo)
    wind_study_grass = env("AEGEAN_WIND_STUDY") == "1"  # the wind over the grass rebuilt from a study of videos:
                                    # gust patches drifting and changing, short-lived dabs inside them, the far
                                    # fields' sheen out to 2 km (off: main's three wave trains; look.jo, terrain.jo)

tweaks = Tweaks()

set_tweaks = (t: Tweaks):
    global tweaks
    tweaks = t
