# Particle histories own f64 positions. The vec3 snapshot is kept for existing
# event/debug interfaces; billboard expansion receives only a local coordinate.
use 'world_point.jo'
struct WorldParticle:
    pos:vec3
    vel:vec3
    life:f32
    max_life:f32
    size:f32
    color:vec4
    precise=WorldPoint()
    published=vec3(0,0,0)
    ready=false
# Optional aggregate envelopes for a painted splash renderer. Individual emission samples and
# their RNG consumption remain identical; no simulation client reads these visual envelopes.
struct ParticleBillow:
    point:WorldPoint
    velocity:vec3
    spread:vec3
    radius:f32
    age:f32
    life:f32
    count:int
    phase:f32
struct WorldParticles:
    items:WorldParticle[]
    gravity:vec3
    drag:f32=1.0
    billowing=false
    billows:ParticleBillow[]
    emission_serial=0
particle_point=(p:WorldParticle)->WorldPoint:
    if p.ready and p.pos==p.published:p.precise else:world_point(p.pos)

emit=(ps:mut WorldParticles,pos:WorldPoint,count:int,speed:f64,color:vec4,life:f64=1.0,size:f64=0.15,spread:f64=PI,direction:vec3=vec3(0,1,0)):
    # Preserve the runtime's sampling and random draw order without allocating
    # a temporary particle system for each emitter.
    d=normalize(direction);side=vec3(1,0,0)
    if abs(d.x)>0.9:side=vec3(0,0,1)
    a=normalize(cross(d,side));b=cross(d,a);c0=cos(min(spread,PI))
    published=world_vec(pos)
    velocity_sum=vec3(0,0,0);lo=vec3(1e9,1e9,1e9);hi= -lo;radius_sum=0.0;longest=f32(0)
    loop i in 0..count:
        z=random(c0,1.0);r=sqrt(max(1.0-z*z,0.0));t=random(0.0,TAU)
        dir=d*f32(z)+a*f32(r*cos(t))+b*f32(r*sin(t))
        l=f32(random(life*0.6,life))
        velocity=dir*f32(random(speed*0.3,speed));radius=f32(random(size*0.5,size))
        if ps.billowing:
            velocity_sum+=velocity;lo=min(lo,velocity);hi=max(hi,velocity);radius_sum+=f64(radius);longest=max(longest,l)
        ps.items.push(WorldParticle(published,velocity,l,l,radius,color,precise=pos,published=published,ready=true))
    if ps.billowing and count>0 and color.x>0.8 and color.y>0.8:
        ps.emission_serial+=1
        # Continuous float sheets carry the small emissions. Retain a few detached edge lobes,
        # and every impact burst, with the original lifetime/velocity envelope.
        if count>=6 or ps.emission_serial%8==0:
            if ps.billows.len()<256:
                ps.billows.push(ParticleBillow(pos,velocity_sum/f32(count),(hi-lo)*0.5,f32(radius_sum/f64(count)),0,longest,count,f32(ps.emission_serial)*2.399))

emit=(ps:mut WorldParticles,pos:vec3,count:int,speed:f64,color:vec4,life:f64=1.0,size:f64=0.15,spread:f64=PI,direction:vec3=vec3(0,1,0)):
    emit(ps,world_point(pos),count,speed,color,life,size,spread,direction)
update=(ps:mut WorldParticles,dt:f64):
    k=0
    loop k<ps.items.len():
        if ps.items[k].life<=0.0:
            ps.items[k]=ps.items[ps.items.len()-1];ps.items.pop()
        else:k+=1
    damp=f32(exp(-f64(ps.drag)*dt))
    loop mut p in ps.items:
        p.vel=(p.vel+ps.gravity*f32(dt))*damp
        p.precise=world_offset(particle_point(p),p.vel*f32(dt))
        p.pos=world_vec(p.precise);p.published=p.pos;p.ready=true
        p.life-=f32(dt)

    k=0
    loop k<ps.billows.len():
        if ps.billows[k].age>=ps.billows[k].life:
            ps.billows[k]=ps.billows[ps.billows.len()-1];ps.billows.pop()
        else:k+=1
    loop mut b in ps.billows:
        b.velocity=(b.velocity+ps.gravity*f32(dt))*damp
        b.point=world_offset(b.point,b.velocity*f32(dt));b.age+=f32(dt)
