# Tributaries use the shared inland-water contract; the river catalogue and its
# carving are untouched. Stable ownership is the lake/town ID.
use 'water_types.jo'
use 'lake_channels_data.jo'
lake_channel_at=(x:f64,z:f64)->WaterSample:
    key=int(floor(x/256.0))*8192+int(floor(z/256.0))
    if not (key in LAKE_CHANNEL_BINS):return NO_INLAND_WATER
    best=NO_INLAND_WATER;ratio=1e30
    loop index in LAKE_CHANNEL_BINS[key]:
        s=LAKE_CHANNELS[index];dx=f64(s.b.x-s.a.x);dz=f64(s.b.y-s.a.y)
        span=dx*dx+dz*dz
        if span<0.01:continue
        u=clamp(((x-f64(s.a.x))*dx+(z-f64(s.a.y))*dz)/span,0.0,1.0)
        px=x-(f64(s.a.x)+dx*u);pz=z-(f64(s.a.y)+dz*u)
        distance=sqrt(px*px+pz*pz);width=f64(mix(s.a.w,s.b.w,f32(u)))
        if distance/width>=min(ratio,1.8):continue
        ratio=distance/width;length=sqrt(span);grade=f64(s.b.z-s.a.z)/length
        best=WaterSample(found=true,wet=distance<width,level=f64(mix(s.a.z,s.b.z,f32(u))),distance=distance,width=width,slope=vec2(f32(grade*dx/length),f32(grade*dz/length)),current=vec3(f32(dx/length*0.35),f32(grade*0.35),f32(dz/length*0.35)),segment=index,along=u*length,lateral=(px*dz-pz*dx)/length,kind=.river,id=s.id)
    best
lake_channel_carve=(x:f64,z:f64,h:f64)->f64:
    r=lake_channel_at(x,z)
    if not r.found:return h
    q=r.distance/r.width
    bed=r.level-0.85+0.85*smoothstep(0.35,1.0,q)
    if q<=1:return min(h,bed)
    mix(r.level+0.6*smoothstep(1.0,1.6,q),h,smoothstep(1.1,1.8,q))
