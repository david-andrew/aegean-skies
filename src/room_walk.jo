# The rooms of a stay by their things: the bed, the chair, the window, the door. Tapping or
# clicking one sends the pilot there on foot: up out of the chair or the bed first, round the
# furniture, turned to it, then sitting down or lying down by degrees, never a jump to a new spot.
# Pure: the rooms' things and where they stand (room-local, as src/stay.jo's rooms are), which one
# a ray from the eye meets, a way across the room clear of the furniture, and the pilot's walk and
# settling a step at a time. The game draws it, lights what is pointed at, and says what happens
# when he gets there (src/stay.jo's stages: asleep, at the window, gone).

use 'stay.jo'

enum RoomThing: bed, chair, window, door

# One thing in a room: the box a pointer finds it by, where the pilot stands to use it and which
# way he faces there, and (sitting or lying) where his body goes and which way it faces.
struct RoomObject:
    thing: RoomThing
    lo: vec3                        # (the box: room-local corners)
    hi: vec3
    stand: vec3
    face: f64                       # (room-local yaw: 0 toward +z)
    pose = 0                        # 0 stands at it, 1 sits in it, 2 lies on it
    rest: vec3 = vec3(0, 0, 0)
    rest_yaw = 0.0

_chair_stand = (s: Seat, out: f64) -> vec3: s.at + vec3(f32(sin(s.yaw) * out), 0, f32(cos(s.yaw) * out))

room_objects = (kind: StayKind) -> RoomObject[]:
    if kind == .hotel:
        b = HOTEL_BED
        c = HOTEL_CHAIR
        return [
            RoomObject(.bed, vec3(b.x - 0.5, 0, b.z - 1.05), vec3(b.x + 0.5, 1.0, b.z + 1.0), vec3(-0.32, 0, -0.15), -PI * 0.5,
                pose = 2, rest = vec3(b.x, b.y - 0.12, b.z + 0.15), rest_yaw = 0.0),
            RoomObject(.chair, c.at - vec3(0.26, 0, 0.26), c.at + vec3(0.26, 1.05, 0.26), _chair_stand(c, 0.5), c.yaw,
                pose = 1, rest = c.at, rest_yaw = c.yaw),
            RoomObject(.window, vec3(-0.75, 0, 1.78), vec3(0.75, 2.45, 2.05), HOTEL_AT_WINDOW, -0.35),
            RoomObject(.door, HOTEL_DOOR + vec3(-0.06, 0, -0.45), HOTEL_DOOR + vec3(0.08, 2.1, 0.45), HOTEL_DOOR + vec3(0.45, 0, 0.1), -PI * 0.5)]
    s = FAMILY_SEATS[0]
    bd = FAMILY_BED
    [RoomObject(.bed, vec3(bd.x - 1.0, 0, bd.z - 0.48), vec3(bd.x + 1.0, 0.75, bd.z + 0.48), vec3(0.3, 0, 0.62), 0.0,
        pose = 2, rest = vec3(bd.x - 0.2, bd.y - 0.1, bd.z), rest_yaw = -PI * 0.5),
     RoomObject(.chair, s.at - vec3(0.26, 0, 0.26), s.at + vec3(0.26, 1.05, 0.26), vec3(0.45, 0, -1.5), 0.0,
        pose = 1, rest = s.at, rest_yaw = s.yaw),
     RoomObject(.door, FAMILY_DOOR + vec3(-0.45, 0, -0.06), FAMILY_DOOR + vec3(0.45, 2.0, 0.08), FAMILY_DOOR + vec3(0.2, 0, 0.35), PI)]

# What the furniture takes of the floor (x0, z0, x1, z1: room-local), walked round.
room_furniture = (kind: StayKind) -> vec4[]:
    if kind == .hotel:
        c = HOTEL_CHAIR.at
        return [vec4(-1.52, -1.27, -0.58, 0.77),        # the bed
            vec4(1.25, -1.15, 1.85, -0.25),             # the washstand
            vec4(-1.83, -1.95, -1.07, -1.35),           # the wardrobe
            vec4(-0.55, -1.75, -0.15, -1.35),           # the bedside table
            vec4(c.x - 0.22, c.z - 0.22, c.x + 0.22, c.z + 0.22),
            vec4(1.09, 1.39, 1.51, 1.81),               # the flowers' table
            vec4(-0.6, 0.77, -0.1, 1.03)]               # the pilot's bag
    out = [vec4(-0.75, -1.125, 0.75, -0.275),           # the table
        vec4(-2.05, -1.9, -1.35, -1.2),                 # the hearth
        vec4(-0.45, 0.97, 1.55, 1.93),                  # the bed
        vec4(-2.1, 0.5, -0.85, 2.05)]                   # (the curtained corner, the family's trade)
    loop s in FAMILY_SEATS: out.push(vec4(s.at.x - 0.21, s.at.z - 0.21, s.at.x + 0.21, s.at.z + 0.21))
    out

# Open floor to go by, where a straight way is blocked.
room_hubs = (kind: StayKind) -> vec3[]:
    if kind == .hotel: return [vec3(0.25, 0, 0.25), vec3(0.35, 0, -0.95), vec3(-0.15, 0, 1.4), vec3(0.95, 0, 0.55)]
    # (the way round the table on the window's side keeps clear of the corner the view is in)
    [vec3(1.15, 0, -1.4), vec3(1.55, 0, -0.8), vec3(1.5, 0, 0.35), vec3(0.3, 0, 0.5), vec3(-0.9, 0, -1.55), vec3(-1.3, 0, -0.5), vec3(0.75, 0, -1.85), vec3(-0.55, 0, -1.85)]

# ---------------- pointing ----------------

# Where a ray (origin o, direction d) enters a box: its distance along d, or -1 when it misses.
ray_box = (o: vec3, d: vec3, lo: vec3, hi: vec3) -> f64:
    near = -1e9; far = 1e9
    loop axis in 0..3:
        oa = f64(if axis == 0: o.x else: if axis == 1: o.y else: o.z)
        da = f64(if axis == 0: d.x else: if axis == 1: d.y else: d.z)
        la = f64(if axis == 0: lo.x else: if axis == 1: lo.y else: lo.z)
        ha = f64(if axis == 0: hi.x else: if axis == 1: hi.y else: hi.z)
        if abs(da) < 1e-9:
            if oa < la or oa > ha: return -1.0
            continue
        t0 = (la - oa) / da; t1 = (ha - oa) / da
        if t0 > t1: (t0, t1) = (t1, t0)
        near = max(near, t0); far = min(far, t1)
        if near > far: return -1.0
    if far < 0.0: return -1.0
    max(near, 0.0)

# The thing a ray from the eye meets first (room-local): its index, or -1.
room_pick = (objs: RoomObject[], o: vec3, d: vec3) -> int:
    best = -1; best_t = 1e9
    loop k in 0..objs.len():
        t = ray_box(o, d, objs[k].lo, objs[k].hi)
        if t >= 0.0 and t < best_t: best = k; best_t = t
    best

# ---------------- a way across the room ----------------

_inside = (p: vec3, r: vec4, grow: f64) -> bool:
    f64(p.x) > f64(r.x) - grow and f64(p.x) < f64(r.z) + grow and f64(p.z) > f64(r.y) - grow and f64(p.z) < f64(r.w) + grow

# Whether the floor from a to b keeps `grow` metres clear of a piece of furniture (one that a or b
# stands within doesn't count: one gets up out of it, or goes to it).
floor_clear = (a: vec3, b: vec3, rects: vec4[], grow: f64) -> bool:
    loop r in rects:
        if _inside(a, r, grow) or _inside(b, r, grow): continue
        # (the slab test, in x and z)
        t0 = 0.0; t1 = 1.0
        dx = f64(b.x - a.x); dz = f64(b.z - a.z)
        hit = true
        loop axis in 0..2:
            p = if axis == 0: f64(a.x) else: f64(a.z)
            dd = if axis == 0: dx else: dz
            lo = (if axis == 0: f64(r.x) else: f64(r.y)) - grow
            hi = (if axis == 0: f64(r.z) else: f64(r.w)) + grow
            if abs(dd) < 1e-9:
                if p < lo or p > hi: hit = false
                continue
            u0 = (lo - p) / dd; u1 = (hi - p) / dd
            if u0 > u1: (u0, u1) = (u1, u0)
            t0 = max(t0, u0); t1 = min(t1, u1)
            if t0 > t1: hit = false
        if hit: return false
    true

const ROOM_CLEARANCE = 0.16

# The way from `from` to `to` across the room: the points to walk through, `to` last; straight when
# the floor between is clear, else by the open floor (the shortest way through it).
room_path = (from: vec3, to: vec3, rects: vec4[], hubs: vec3[]) -> vec3[]:
    if floor_clear(from, to, rects, ROOM_CLEARANCE): return [to]
    nodes = [from] + hubs + [to]
    n = nodes.len()
    dist = [loop k in 0..n: 1e9]
    prev = [loop k in 0..n: -1]
    done = [loop k in 0..n: false]
    dist[0] = 0.0
    loop _ in 0..n:
        u = -1
        loop k in 0..n:
            if not done[k] and dist[k] < 1e8 and (u < 0 or dist[k] < dist[u]): u = k
        if u < 0: break
        done[u] = true
        loop v in 0..n:
            if done[v] or v == u: continue
            if not floor_clear(nodes[u], nodes[v], rects, ROOM_CLEARANCE): continue
            nd = dist[u] + f64(length(nodes[v] - nodes[u]))
            if nd < dist[v]: dist[v] = nd; prev[v] = u
    if prev[n - 1] < 0: return [to]                     # (no clear way: straight, as best one can)
    out: vec3[]
    k = n - 1
    loop k > 0:
        out.insert(0, nodes[k])
        k = prev[k]
    out

# ---------------- the pilot in the room ----------------

const ROOM_WALK_SPEED = 1.1         # m/s: across a small room at an easy pace
const ROOM_SIT_SECONDS = 0.7
const ROOM_LIE_SECONDS = 1.1

struct RoomPilot:
    at: vec3 = vec3(0, 0, 0)        # (room-local, on the floor, while not settled in something)
    yaw = 0.0
    on = -1                         # (the thing he is sitting or lying in, or settling into or out of)
    settle = 0.0                    # (0 standing at it .. 1 sat or lain)
    going = -1                      # (the thing he's on his way to)
    path: vec3[]
    phase = 0.0                     # (the walk's step)
    stride = 0.0

# Settled in a thing to begin with (the chair, at a family's table).
room_pilot_in = (objs: RoomObject[], k: int) -> RoomPilot:
    o = objs[k]
    RoomPilot(at = o.stand, yaw = o.face, on = k, settle = 1.0)

_ease = (x: f64) -> f64: x * x * (3.0 - 2.0 * x)

# Where the body is drawn and which way it faces, and its posture (0 standing, 1 sitting, 2 lying)
# with how far into it (posture and amount, as src/folk.jo's figure draws a settling body).
struct RoomBody:
    pos: vec3
    yaw: f64
    posture = 0
    amount = 0.0

room_body = (p: RoomPilot, objs: RoomObject[]) -> RoomBody:
    if p.on < 0 or p.settle <= 0.0: return RoomBody(p.at, p.yaw)
    o = objs[p.on]
    e = _ease(clamp(p.settle, 0.0, 1.0))
    dy = o.rest_yaw - o.face
    dy = dy - TAU * floor((dy + PI) / TAU)
    RoomBody(mix(o.stand, o.rest, f32(e)), o.face + dy * e, o.pose, clamp(p.settle, 0.0, 1.0))

# Off to a thing: up out of whatever he is in first, then the way there.
room_go = (p: mut RoomPilot, objs: RoomObject[], rects: vec4[], hubs: vec3[], k: int):
    if k < 0 or k >= objs.len(): return
    if p.on == k and p.going < 0 and p.settle >= 1.0: return
    p.going = k
    start = if p.on >= 0: objs[p.on].stand else: p.at
    p.path = if p.on == k: [] else: room_path(start, objs[k].stand, rects, hubs)

# Up out of the bed or the chair and standing beside it (the bed, clicked again).
room_get_up = (p: mut RoomPilot):
    if p.on >= 0: p.going = -2; p.path = []

# One step. Returns the thing he has just got to (sat down in, lain down on, or stood at), or -1.
room_step = (p: mut RoomPilot, objs: RoomObject[], dt: f64) -> int:
    p.stride = 0.0
    if p.going == -1: return -1
    # (out of the chair or the bed first, unless that is where he is going)
    if p.on >= 0 and p.going != p.on:
        o = objs[p.on]
        p.settle -= dt / (if o.pose == 2: ROOM_LIE_SECONDS else: ROOM_SIT_SECONDS)
        if p.settle <= 0.0:
            p.settle = 0.0; p.at = o.stand; p.yaw = o.face; p.on = -1
            if p.going == -2: p.going = -1
        return -1
    if p.going == -2: p.going = -1; return -1
    o = objs[p.going]
    if p.path.len() > 0:
        to = p.path[0]
        d = vec3(to.x - p.at.x, 0, to.z - p.at.z)
        left = f64(length(d))
        step = ROOM_WALK_SPEED * dt
        if left <= step:
            p.at = vec3(to.x, 0, to.z); p.path.remove_at(0)
        else:
            p.at = p.at + d * f32(step / left)
        if left > 0.01: p.yaw = approach_angle(p.yaw, atan2(f64(d.x), f64(d.z)), 9.0, dt)
        p.phase += dt * 7.5; p.stride = 0.7
        return -1
    # (there: turned to it, then down into it)
    if p.on != p.going:
        dy = o.face - p.yaw
        dy = dy - TAU * floor((dy + PI) / TAU)
        p.yaw = approach_angle(p.yaw, o.face, 8.0, dt)
        if abs(dy) > 0.08: return -1
        p.yaw = o.face
        if o.pose == 0:
            k = p.going; p.going = -1
            return k
        p.on = p.going; p.settle = 0.0
    p.settle += dt / (if o.pose == 2: ROOM_LIE_SECONDS else: ROOM_SIT_SECONDS)
    if p.settle < 1.0: return -1
    p.settle = 1.0
    k = p.going; p.going = -1
    k

# Whether he's still on his way, getting up or settling (a thing pointed at waits till he stops).
room_busy = (p: RoomPilot) -> bool: p.going != -1

# What doing a thing is called, as a small label over it: by what it is and the hour (lying down
# of an evening is to sleep; by day, to rest), and whether he is already in it.
room_label = (o: RoomObject, kind: StayKind, clock: int, lying_in_it: bool, at_window: bool) -> str:
    if o.thing == .bed:
        if lying_in_it: return "Get up"
        return if clock >= 1140 or clock < 330: "Sleep" else: "Lie down"
    if o.thing == .chair: return if kind == .family: "Sit at the table" else: "Sit"
    if o.thing == .window: return if at_window: "Back inside" else: "Look out"
    if kind == .family: "Thank them and go" else: "Leave"

# How long lying down lasts unless he gets up sooner: until morning of an evening or at night, else
# until the evening.
room_sleep_until = (clock: int) -> int: if clock >= 1020 or clock < 330: 420 else: 1110
