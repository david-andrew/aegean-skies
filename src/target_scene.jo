use 'targets.jo'
use 'traffic.jo'
use 'combat.jo'
use 'planes.jo'
use 'world.jo'
use 'vessel_types.jo'
use 'settlements.jo'
import 'living_types.jo' as data

# Fixed identities survive relevance reordering; only this small adapter knows world schemas.
view_candidates = (w:data.World,b:Battle,traffic:Traffic[],fleet:VesselFleet,eye:vec3,craft:int)->ViewTarget[]:
    result:ViewTarget[]
    player=combat_index(b,craft)
    fighting=player>=0 and b.actors[player].engagement>=0 and not b.finished
    loop a in b.actors:
        if a.craft==craft or not a.present or a.bailed or a.status!=.flying:continue
        distance=f64(length(a.state.position-eye))
        enemy=fighting and a.side!=b.actors[player].side and a.engagement==b.actors[player].engagement
        if not enemy and distance>5000:continue
        threat=enemy and a.pilot.target==player
        name=if a.person>=0 and a.person<w.people.len():w.people[a.person].name else:CRAFT_NAMES[int(a.spec.kind)]
        offer_target(result,ViewTarget(0,a.craft,name,combat_render_state(a,b.render_alpha).position,if enemy:0 else:2,distance*(if threat:0.5 else:1.0),enemy),if fighting:0 else:TARGET_LIMIT)
    loop tr in traffic:
        if tr.craft==craft or not tr.visible or not tr.flying:continue
        distance=f64(length(tr.state.position-eye))
        if distance<=3500:offer_target(result,ViewTarget(0,tr.craft,tr.name,tr.state.position,2,distance),if fighting:0 else:TARGET_LIMIT)
    if fighting:
        result.sort((a:ViewTarget)->f64:f64(a.rank)*1000000.0+a.score)
        return result
    loop id in w.active_jobs:
        j=w.jobs[id]
        if j.carrier!=w.player or j.state!=.claimed:continue
        place=if j.loaded:j.destination else:j.origin
        if place<0 or place>=w.harbors.len():continue
        h=w.harbors[place];pos=if h.docks.len()>0:h.docks[0] else:h.center
        name=if place<SETTLEMENTS.len():SETTLEMENTS[place].name else:"Dock"
        offer_target(result,ViewTarget(1,place,name+" dock",pos,1,f64(length(pos-eye))))
    loop _, c in w.far.commissions:
        if c.carrier!=w.player or (c.phase!=.claimed and c.phase!=.carrying and c.phase!=.aboard and c.phase!=.collecting):continue
        place=if c.phase==.claimed:c.origin else:c.destination
        if not (place in w.far.harbors):continue
        h=w.far.harbors[place];pos=if h.quays.len()>0:h.quays[0] else:h.buoy
        name=if place in settlement_by_id:world_settlements[settlement_by_id[place]].name else:"Destination"
        offer_target(result,ViewTarget(1,place,name+" dock",pos,1,f64(length(pos-eye))))
    loop task in w.public_boats:
        if task.person!=w.player or task.state>1:continue
        loop ship in fleet.ships:
            if ship.source_trip==task.trip and ship.health>0:
                offer_target(result,ViewTarget(2,ship.id,vessel_spec(ship.kind).name,ship.position,1,f64(length(ship.position-eye))))
    # Capitals and lighthouses only in the immediate neighbourhood; never the whole gazetteer.
    loop s in world_settlements:
        if s.kind!=.capital and s.kind!=.lighthouse:continue
        distance=f64(length(s.center-eye))
        if distance<3000:offer_target(result,ViewTarget(3,s.id,s.name,s.center+vec3(0,12,0),3,distance))
    result
