# Who plays in the Hotel Ancora's band, and where each of them is wanted now: read by the daily
# life (src/living_life.jo, an intent's venue and target), the townsfolk (not drawn while up on the
# stand: the band draws them there) and the band's own programme (src/band_life.jo). The players are
# Porto Vecchio people with the rest of their day: a clerk at the piano, a telegraphist who sings,
# a fisher on guitar and bass, a merchant on the violin, the mandolin and the reeds.

use 'living_types.jo'
use 'life_types.jo'

# The band's people by role: 0 the singer, 1 the pianist, 2 guitar or bass, 3 violin, mandolin or
# reeds (Leila Demir, Yannis Markou, Petros Laskaris, Marta Bellini).
BAND_ROSTER = [10, 5, 7, 3]
const BAND_PLACE = 0                # (Porto Vecchio)
const BAND_GATHER = 1050            # 17:30: the players make their way to the terrace
const BAND_FETCH_MINUTES = 15       # the boy's errand before one sent for sets out
const BAND_CLIMB = 150              # ticks from the step to one's place on the stand
const BAND_SETTLE = 60              # (and to settle there before the number begins)
const BAND_PACK = 240               # ticks to put the instrument away and step down: half each

# Names in a list as one says them: "Yannis", "Yannis and Marta", "Yannis, Marta and Leila".
names_list = (names: str[]) -> str:
    if names.len() == 0: return ""
    if names.len() == 1: return names[0]
    "{join(names[0..names.len() - 1], ", ")} and {names[names.len() - 1]}"

band_role = (person: int) -> int:
    loop k in 0..BAND_ROSTER.len():
        if BAND_ROSTER[k] == person: return k
    -1

# Whether a player has been sent for and the boy has reached them (they set out now).
band_fetched = (w: World, person: int) -> bool:
    loop k in 0..w.band.fetched.len():
        if w.band.fetched[k] == person and w.minute >= w.band.fetched_minute[k] + BAND_FETCH_MINUTES: return true
    false

# The players' evening at the hotel: from when they set out until the music is over.
band_evening = (w: World) -> bool:
    if w.band.numbers.len() == 0: return false
    clock = local_minute(w.minute)
    clock >= BAND_GATHER and clock < w.band.closes

# Where a player of the band is wanted now: 2 at the stand (called to it, or putting the instrument
# away), 1 at the band's table on the terrace (the evening, or sent for while there is music to
# play), 0 not at the hotel at all. Not for anyone else.
band_wanted = (w: World, person: int) -> int:
    if band_role(person) < 0 or w.band.numbers.len() == 0: return 0
    if person in w.band.called or person in w.band.packing: return 2
    if band_evening(w): return 1
    if band_fetched(w, person) and (w.band.index >= 0 or w.band.queue.len() > 0): return 1
    0

# Where a player wanted at the stand goes: the step for their place (or the place they are leaving).
band_step_point = (w: World, person: int) -> vec3?:
    b = w.band
    # (one still stepping down from a place stays by it until down, though called to another)
    loop k in 0..b.packing.len():
        if b.packing[k] == person and b.packing_number[k] >= 0 and b.packing_number[k] < b.numbers.len(): return b.numbers[b.packing_number[k]].steps[b.packing_role[k]]
    # (the called are in their places for the number now, or between numbers for the one before)
    number = if b.index >= 0: b.index else: b.last
    loop k in 0..b.called.len():
        if b.called[k] == person and number >= 0 and number < b.numbers.len(): return b.numbers[number].steps[b.roles[k]]
    none

# Up on the stand now (stepped up for a number, or still there putting the instrument away): the
# band draws them, not the town.
band_on_stage = (w: World, person: int) -> bool:
    b = w.band
    loop k in 0..b.called.len():
        if b.called[k] == person and b.up[k] >= 0 and w.tick >= b.up[k]: return true
    loop k in 0..b.packing.len():
        if b.packing[k] == person and w.tick < b.packing_until[k]: return true
    false

# ---------------- what is heard and seen ----------------

# Whether the number has begun (it plays from `start` to `ends`).
band_playing = (b: BandState, tick: int) -> bool: b.index >= 0 and b.start >= 0 and tick >= b.start and tick < b.ends

# Seconds into the number now (0 before it starts).
band_seconds = (b: BandState, tick: int) -> f64: if b.start >= 0 and tick > b.start: f64(tick - b.start) / 60.0 else: 0.0
