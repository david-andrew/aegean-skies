# A newcomer's first hour, told by the harbour: the mechanic on the dock greets a new pilot, says
# where the work is and how the aircraft is flown, a note by the compass gives the controls, and a
# fisherman says once to wait for the float. No arrows and no tutorial: the words are a real
# person's, through the speech bubbles and conversations the town already has. It ends for good,
# in that game, with the first job delivered, two minutes in the air, a job taken after talking
# to him, or Hints off (Options). The state lives in the world (World.welcome): the greeter's
# morning on the dock is the living world's own (src/living_life.jo reads it), so the scene and the
# rest of the world agree, and it is saved with the game.
use 'living_types.jo'
use 'life_types.jo'
use 'controller.jo'
use 'touch.jo'

const WELCOME_AIR_SECONDS = 120.0   # two minutes in the air: the pilot knows how
const WELCOME_CALL_AFTER = 40.0     # (seconds after the greeting, walked off without a word: he calls once)
const WELCOME_NOTE_SECONDS = 8.0    # the note by the compass, the first time aboard

welcome_active = (w: World) -> bool: not w.welcome.done and w.welcome.greeter >= 0

# Whether the welcome is over, this frame: the first job delivered, two minutes in the air, a job
# taken after talking to the greeter, or the hints turned off.
welcome_finished = (wl: WelcomeState, delivered: bool, took_job: bool, hints: bool) -> bool:
    not hints or delivered or wl.air_seconds >= WELCOME_AIR_SECONDS or (wl.talked and took_job)

# The pilot's first job delivered, or any taken, in the world's ledger of jobs
welcome_jobs = (w: World) -> (bool, bool):
    delivered = false; taken = false
    loop j in w.jobs.values():
        if j.carrier == w.player:
            if j.state == .delivered: delivered = true
            if j.state == .claimed or j.state == .delivered: taken = true
    (delivered, taken)

# ---------------- what is said ----------------

# The controls as this player has them: a keyboard's keys, a controller's buttons, a touch
# screen's own controls.
enum Hands: keys, controller, touch

hands_now = () -> Hands: if pad.on: Hands.touch else if pad_hints(): Hands.controller else: Hands.keys

_bound = (b: Bind) -> str: if b.kind != 0: bind_name(b) else: ""

# the throttle, as one would say it ("Shift", "RT", "the throttle slider")
throttle_said = (h: Hands, c: ControlsConfig) -> str:
    match h:
        .touch: "the throttle slider"
        .controller:
            p = profile_of(c, ctl.stick)
            if ctl.stick and p.axes[AX_LEVER].bind.kind != 0: return "the lever"
            n = _bound(p.axes[AX_THROTTLE].bind)
            if n != "": n else: "the throttle"
        else: "Shift"

# what closes it, and what flies her
throttle_back_said = (h: Hands, c: ControlsConfig) -> str:
    match h:
        .touch: "the slider"
        .controller:
            n = _bound(profile_of(c, ctl.stick).axes[AX_THROTTLE].neg)
            if n != "": n else: "the throttle"
        else: "Z"

stick_said = (h: Hands, c: ControlsConfig, mouse_steers: bool) -> str:
    match h:
        .touch: "a finger on the screen"
        .controller:
            # (the pitch axis is named as one of a stick's two: "Left stick Y" is "the left stick")
            n = axis_set_name(profile_of(c, ctl.stick).axes[AX_PITCH]).replace(" Y", "").replace(" X", "")
            if n != "" and n != "-": "the " + lower(n) else: "the stick"
        else: if mouse_steers: "the mouse" else: "W, A, S and D"

view_said = (h: Hands, c: ControlsConfig) -> str:
    match h:
        .touch: "View"
        .controller:
            p = profile_of(c, ctl.stick)
            loop i in 0..min(ACTIONS, p.buttons.len()):
                if ACTION_KEYS[i] == .v and p.buttons[i].kind != 0: return bind_name(p.buttons[i])
            "the view button"
        else: "V"

WELCOME_GREETING = "You'll be the new pilot. Paolo — I keep the engines here running."
WELCOME_CALL = "The board's by the market, if you're after work."
WELCOME_FISH = "Patience. Wait till the float goes right under."
WELCOME_ASK_WORK = "Where's the work?"
WELCOME_ASK_FLYING = "How does she handle?"

# "Where's the work?": the board, and the easiest job on it on foot and a flying one, by name
welcome_work_words = (place: int, on_foot: str, flying: str) -> str:
    s = if place == 0: "The board by the market, past the hotel." else: "The notice board, by the harbour."
    if on_foot != "": s = s + " {on_foot}: an easy one, on foot."
    if flying != "": s = s + " {flying}, if you'd sooner fly."
    s

# "How does she handle?"
welcome_flying_words = (h: Hands, c: ControlsConfig) -> str:
    "Open her up slowly with {throttle_said(h, c)} and keep her nose level till she's up on the step. Then ease back, and she'll fly herself off."

# The note by the compass, in Paolo's hand
welcome_note_lines = (h: Hands, c: ControlsConfig, mouse_steers: bool) -> str[]:
    t = throttle_said(h, c)
    [
        "{_cap(t)} opens her up, {throttle_back_said(h, c)} closes her.",
        "{_cap(stick_said(h, c, mouse_steers))} flies her. {_cap(view_said(h, c))} for the cockpit.",
        "— P."
    ]

_cap = (s: str) -> str: if s.len() == 0: s else: s[0..1].upper() + s[1..s.len()]
