# The Paint page: the player's aircraft repainted (src/aircraft_paint.jo). A livery valid for the
# type, its four colours (period dopes and lacquers, or any colour by hue, saturation and
# brightness), national insignia, operator bars, rudder stripes and a tail number where the type
# can wear them, and a reset to the type's own paint. Free here; a paint shop can draw the same
# page and price paint_changes.

use 'phoenix.jo'
use 'planes.jo'
use 'markings.jo'
use 'aircraft_paint.jo'

struct PaintPage:
    slot = 0                        # the colour being changed (PAINT_SLOTS)
    hsv: vec3 = vec3(0, 0, 0)       # (the free pick's hue, saturation and brightness)
    hsv_slot = -1                   # (the slot and colour the free pick was last set from)
    hsv_from: vec4 = vec4(0, 0, 0, 0)

const PP_ROW = 30.0
const PP_GAP = 6.0
_PP_HEAD = rgba(0.85, 0.78, 0.55, 1)
_PP_NOTE = rgba(0.78, 0.8, 0.85, 1)

_pp_head = (s: str, x: f64, y: f64): ptext(s, vec2(f32(x), f32(y)), 14, _PP_HEAD)

# a button with a colour in it (a swatch): pressed or not
_pp_swatch = (r: Rect, c: vec4, selected: bool) -> bool:
    hit = hud_button(r, "", selected = selected)
    rect(f64(r.x) + 4.0, f64(r.y) + 4.0, f64(r.w) - 8.0, f64(r.h) - 8.0, c)
    hit

# a small picture of an insignia (its rings, star or cross) at c, r across
_pp_insignia = (c: vec2, r: f64, ins: Insignia):
    if ins.shape == 0:
        n = ins.colours.len()
        loop k in 0..n: circle(c, f32(r * f64(n - k) / f64(n)), ins.colours[k])
    else if ins.shape == 1:
        circle(c, f32(r), ins.colours[0])
        loop j in 0..5:
            a = TAU * f64(j) / 5.0 - PI * 0.5
            tip = c + vec2(f32(cos(a) * r * 0.95), f32(sin(a) * r * 0.95))
            l = c + vec2(f32(cos(a - 0.63) * r * 0.37), f32(sin(a - 0.63) * r * 0.37))
            rr = c + vec2(f32(cos(a + 0.63) * r * 0.37), f32(sin(a + 0.63) * r * 0.37))
            polygon([c, rr, tip, l], ins.colours[1])
        circle(c, f32(r * 0.22), ins.colours[2])
    else if ins.shape == 2:
        rect(f64(c.x) - r * 1.1, f64(c.y) - r * 0.32, r * 2.2, r * 0.64, ins.colours[1])
        rect(f64(c.x) - r * 0.32, f64(c.y) - r * 1.1, r * 0.64, r * 2.2, ins.colours[1])
        rect(f64(c.x) - r, f64(c.y) - r * 0.22, r * 2.0, r * 0.44, ins.colours[0])
        rect(f64(c.x) - r * 0.22, f64(c.y) - r, r * 0.44, r * 2.0, ins.colours[0])

# A registration in the style of the nation the aircraft's marks say it is from.
paint_suggest_number = (p: Paint, kind: int, seed: int) -> str:
    ins = INSIGNIA[paint_insignia(p, kind)].key
    letters = "ABCDEFGHIKLMNOPRSTUVZ"
    pick = (k: int) -> str:
        i = ((seed * 7919 + k * 104729) % letters.len() + letters.len()) % letters.len()
        letters[i..i + 1]
    digits = (n: int) -> str: "{((seed * 37 + n * 11) % 9000 + 9000) % 9000 + 1000}"[0..n]
    match ins:
        "italy": "I-" + pick(1) + pick(2) + pick(3) + pick(4)
        "britain": "G-E" + pick(1) + pick(2) + pick(3)
        "usa": "A-" + digits(4)
        "germany": "D-" + digits(4)
        "greece": "SX-" + pick(1) + pick(2) + pick(3)
        "orenthia": "OR-" + digits(2)
        else: "K-" + pick(1) + pick(2) + digits(1)

# The page, at x, y, w across: the type's paint, changed in place. Returns the height it took.
paint_page = (pg: mut PaintPage, p: mut Paint, s: PaintSupport, kind: int, type_name: str, x: f64, y0: f64, w: f64) -> f64:
    y = y0
    if p.kind != kind: p = paint_reset(kind)
    ptext(type_name, vec2(f32(x), f32(y)), 17, rgba(1, 0.97, 0.9, 0.95))
    changes = paint_changes(p, kind)
    said = if changes.len() == 0: "As built" else: "Changed: " + join(changes, ", ")
    ptext(fit_text(said, w - 160.0, 13), vec2(f32(x), f32(y + 22.0)), 13, _PP_NOTE)
    if hud_button(Rect(x + w - 150.0, y, 150.0, PP_ROW), "Reset to default", enabled = changes.len() > 0):
        p = paint_reset(kind); pg.hsv_slot = -1
    y += PP_ROW + 22.0

    # the livery
    _pp_head("Livery", x, y); y += 20.0
    current = if p.livery >= 0: p.livery else: paint_default_livery(kind)
    half = (w - PP_GAP) * 0.5
    loop i in 0..s.liveries.len():
        k = s.liveries[i]
        r = Rect(x + f64(i % 2) * (half + PP_GAP), y + f64(i / 2) * (PP_ROW + PP_GAP), half, PP_ROW)
        name = if k < LIVERY_NAMES.len(): LIVERY_NAMES[k] else: "Livery {k + 1}"
        lv = LIVERIES[k]
        if hud_button(r, "      " + name + (if i == 0: " (own)" else: ""), selected = k == current, align = .left):
            paint_choose_livery(p, k); pg.hsv_slot = -1
        # (its colours in a little strip at the left of the button)
        loop c in 0..3:
            rect(f64(r.x) + 6.0 + f64(c) * 7.0, f64(r.y) + 7.0, 6.0, f64(r.h) - 14.0, [lv.body, lv.trim, lv.accent][c])
    y += f64((s.liveries.len() + 1) / 2) * (PP_ROW + PP_GAP) + PP_GAP

    # the colours
    _pp_head("Colours", x, y); y += 20.0
    q = (w - PP_GAP * 3.0) / 4.0
    loop k in 0..4:
        r = Rect(x + f64(k) * (q + PP_GAP), y, q, PP_ROW)
        if hud_button(r, "     " + PAINT_SLOTS[k], selected = pg.slot == k, align = .left): pg.slot = k
        rect(f64(r.x) + 6.0, f64(r.y) + 7.0, 14.0, f64(r.h) - 14.0, paint_colour(p, kind, k))
    y += PP_ROW + PP_GAP
    now = paint_colour(p, kind, pg.slot)
    loop pal in PALETTES:
        ptext(pal.0, vec2(f32(x), f32(y + 8.0)), 13, _PP_NOTE)
        sw = (w - 76.0 - PP_GAP * 5.0) / 6.0
        loop j in 0..pal.1.len():
            sc = pal.1[j]
            if _pp_swatch(Rect(x + 76.0 + f64(j) * (sw + PP_GAP), y, sw, PP_ROW), sc.colour, length(sc.colour.xyz - now.xyz) < 0.002):
                paint_set_colour(p, pg.slot, sc.colour)
        y += PP_ROW + PP_GAP
    # (any colour: hue, saturation and brightness, from the colour as it is)
    if pg.hsv_slot != pg.slot or length(pg.hsv_from - now) > 0.001:
        pg.hsv = colour_hsv(now); pg.hsv_slot = pg.slot; pg.hsv_from = now
    h = hud_slider(Rect(x, y, w, PP_ROW), f64(pg.hsv.x), 0.0, 1.0, 0.0, "Hue")
    y += PP_ROW + PP_GAP
    sa = hud_slider(Rect(x, y, w, PP_ROW), f64(pg.hsv.y), 0.0, 1.0, 0.0, "Saturation")
    y += PP_ROW + PP_GAP
    va = hud_slider(Rect(x, y, w, PP_ROW), f64(pg.hsv.z), 0.05, 1.0, 0.0, "Brightness")
    y += PP_ROW + PP_GAP
    if abs(h - f64(pg.hsv.x)) > 0.0005 or abs(sa - f64(pg.hsv.y)) > 0.0005 or abs(va - f64(pg.hsv.z)) > 0.0005:
        pg.hsv = vec3(f32(h), f32(sa), f32(va))
        c = hsv_colour(h, sa, va)
        paint_set_colour(p, pg.slot, c)
        pg.hsv_from = paint_colour(p, kind, pg.slot)

    # the marks
    _pp_head("Insignia", x, y); y += 20.0
    if not s.wing_marks:
        ptext("This type's wings carry no marks.", vec2(f32(x), f32(y + 6.0)), 13, _PP_NOTE)
        y += PP_ROW
    else:
        wearing = paint_insignia(p, kind)
        loop i in 0..s.insignia.len():
            k = s.insignia[i]
            r = Rect(x + f64(i % 2) * (half + PP_GAP), y + f64(i / 2) * (PP_ROW + PP_GAP), half, PP_ROW)
            if hud_button(r, "        " + INSIGNIA[k].name, selected = k == wearing, align = .left):
                p.insignia = k
                if p.bars < 0: p.bars = if paint_bars(p, kind): 1 else: 0
            if INSIGNIA[k].shape >= 0: _pp_insignia(vec2(f32(f64(r.x) + 18.0), f32(f64(r.y) + f64(r.h) * 0.5)), 9.0, INSIGNIA[k])
        y += f64((s.insignia.len() + 1) / 2) * (PP_ROW + PP_GAP)
        bars = hud_checkbox(Rect(x, y + 6.0, w, PP_ROW - 12.0), "Operator bars on the wings", paint_bars(p, kind))
        if bars != paint_bars(p, kind):
            p.bars = if bars: 1 else: 0
            if p.insignia < 0: p.insignia = paint_insignia(p, kind)
        y += PP_ROW + PP_GAP
    _pp_head("Rudder", x, y); y += 20.0
    if not s.rudder_marks:
        ptext("This type's rudder carries no marks.", vec2(f32(x), f32(y + 6.0)), 13, _PP_NOTE)
        y += PP_ROW
    else:
        own = Rect(x, y, half, PP_ROW)
        if hud_button(own, "As the type has it", selected = p.rudder < 0): p.rudder = -1
        loop i in 0..s.rudders.len():
            k = s.rudders[i]
            j = i + 1
            r = Rect(x + f64(j % 2) * (half + PP_GAP), y + f64(j / 2) * (PP_ROW + PP_GAP), half, PP_ROW)
            if hud_button(r, "        " + RUDDERS[k].name, selected = p.rudder == k, align = .left): p.rudder = k
            cols = if RUDDERS[k].colours.len() > 0: RUDDERS[k].colours else: [paint_colour(p, kind, 3)]
            loop c in 0..cols.len(): rect(f64(r.x) + 8.0 + f64(c) * 6.0, f64(r.y) + 7.0, 6.0, f64(r.h) - 14.0, cols[c])
        y += f64((s.rudders.len() + 2) / 2) * (PP_ROW + PP_GAP)
        _pp_head("Tail number", x, y); y += 20.0
        typed = hud_text_field(Rect(x, y, w - 200.0 - PP_GAP * 2.0, PP_ROW), p.number, "tail-number", 8, "none")
        if typed != p.number: p.number = clean_number(typed)
        if hud_button(Rect(x + w - 200.0 - PP_GAP, y, 100.0, PP_ROW), "Suggest"): p.number = paint_suggest_number(p, kind, frame_number())
        if hud_button(Rect(x + w - 100.0, y, 100.0, PP_ROW), "Clear", enabled = p.number != ""): p.number = ""
        y += PP_ROW + PP_GAP
    p.kind = kind
    y - y0
