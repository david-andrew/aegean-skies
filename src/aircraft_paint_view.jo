# The Paint page: the player's aircraft repainted (src/aircraft_paint.jo), in four tabs. Livery: a
# livery valid for the type and its four colours. Parts: each part in its own colour, gradient or
# stripes (src/paint_parts.jo). Decals: motifs at the usual spots or anywhere, at any size and
# angle (src/decals.jo). Marks: national insignia, operator bars, rudder stripes and a tail number
# where the type can wear them. Colours are period dopes and lacquers, or any colour by hue,
# saturation and brightness. Free here; the paint shop draws the same page and prices the change
# (paint_price).

use 'phoenix.jo'
use 'planes.jo'
use 'markings.jo'
use 'aircraft_paint.jo'
use 'paint_parts.jo'
use 'decals.jo'

PAINT_TABS = ["Livery", "Parts", "Decals", "Marks"]

# How the page stands: free (a change is made at once, for nothing), a paint shop's (the paint is a
# draft, priced: `cents` and `minutes` for `items`, ordered or left), or closed (painting is done
# at a workshop: `note` says where things stand).
enum PaintPageMode: free, shop, closed

struct PaintShopView:
    mode: PaintPageMode = .free
    who = ""                        # the painter
    cents = 0
    minutes = 0
    items: str[] = []
    refusal = ""                    # why the order can't be given ("": it can)
    note = ""                       # closed: where to have her painted, or how the work stands

struct PaintPage:
    tab = 0                         # PAINT_TABS
    slot = 0                        # the livery colour being changed (PAINT_SLOTS)
    part = 0                        # the part being painted (PAINT_PARTS)
    part_second = false             # (its second colour is the one being changed)
    decal = 0                       # the decal being changed
    decal_colour = 0                # (which of its colours)
    group = 0                       # (the motifs shown: DECAL_GROUPS)
    group_of = -1                   # (the decal whose motif's group was last shown: a decal chosen shows its own)
    mix = false                     # (the free pick is open: any colour by hue, saturation and brightness)
    hsv: vec3 = vec3(0, 0, 0)       # (the free pick's hue, saturation and brightness)
    hsv_key = -1                    # (what the free pick was last set from, and its colour)
    hsv_from: vec4 = vec4(0, 0, 0, 0)
    pointing = false                # (the next click or tap on the aircraft places the decal there)
    ordered = false                 # (a shop's page: the order was given this frame, or the page left)
    left = false

const PP_ROW = 30.0
const PP_GAP = 6.0
_PP_HEAD = rgba(0.85, 0.78, 0.55, 1)
_PP_NOTE = rgba(0.78, 0.8, 0.85, 1)

_pp_head = (s: str, x: f64, y: f64): ptext(s, vec2(f32(x), f32(y)), 14, _PP_HEAD)

# a button with a colour in it (a swatch): pressed or not
_pp_swatch = (r: Rect, c: vec4, selected: bool) -> bool:
    hit = hud_button(r, "", selected = selected)
    rect(f64(r.x) + 4.0, f64(r.y) + 4.0, f64(r.w) - 8.0, f64(r.h) - 8.0, c)
    hit

# a small picture of an insignia (its rings, star or cross) at c, r across
_pp_insignia = (c: vec2, r: f64, ins: Insignia):
    if ins.shape == 0:
        n = ins.colours.len()
        loop k in 0..n: circle(c, f32(r * f64(n - k) / f64(n)), ins.colours[k])
    else if ins.shape == 1:
        circle(c, f32(r), ins.colours[0])
        loop j in 0..5:
            a = TAU * f64(j) / 5.0 - PI * 0.5
            tip = c + vec2(f32(cos(a) * r * 0.95), f32(sin(a) * r * 0.95))
            l = c + vec2(f32(cos(a - 0.63) * r * 0.37), f32(sin(a - 0.63) * r * 0.37))
            rr = c + vec2(f32(cos(a + 0.63) * r * 0.37), f32(sin(a + 0.63) * r * 0.37))
            polygon([c, rr, tip, l], ins.colours[1])
        circle(c, f32(r * 0.22), ins.colours[2])
    else if ins.shape == 2:
        rect(f64(c.x) - r * 1.1, f64(c.y) - r * 0.32, r * 2.2, r * 0.64, ins.colours[1])
        rect(f64(c.x) - r * 0.32, f64(c.y) - r * 1.1, r * 0.64, r * 2.2, ins.colours[1])
        rect(f64(c.x) - r, f64(c.y) - r * 0.22, r * 2.0, r * 0.44, ins.colours[0])
        rect(f64(c.x) - r * 0.22, f64(c.y) - r, r * 0.44, r * 2.0, ins.colours[0])

# A registration in the style of the nation the aircraft's marks say it is from.
paint_suggest_number = (p: Paint, kind: int, seed: int) -> str:
    ins = INSIGNIA[paint_insignia(p, kind)].key
    letters = "ABCDEFGHIKLMNOPRSTUVZ"
    pick = (k: int) -> str:
        i = ((seed * 7919 + k * 104729) % letters.len() + letters.len()) % letters.len()
        letters[i..i + 1]
    digits = (n: int) -> str: "{((seed * 37 + n * 11) % 9000 + 9000) % 9000 + 1000}"[0..n]
    match ins:
        "italy": "I-" + pick(1) + pick(2) + pick(3) + pick(4)
        "britain": "G-E" + pick(1) + pick(2) + pick(3)
        "usa": "A-" + digits(4)
        "germany": "D-" + digits(4)
        "greece": "SX-" + pick(1) + pick(2) + pick(3)
        "orenthia": "OR-" + digits(2)
        else: "K-" + pick(1) + pick(2) + digits(1)

# "40 minutes", "1 hour 5 minutes"
paint_minutes_words = (m: int) -> str:
    if m < 60: return if m == 1: "1 minute" else: "{m} minutes"
    h = m / 60; r = m % 60
    hours = if h == 1: "1 hour" else: "{h} hours"
    if r == 0: hours else: "{hours} {paint_minutes_words(r)}"

# The colours to pick from: the period palettes, and any colour by hue, saturation and brightness.
# `now` the colour as it is, `key` what is being coloured (the free pick follows it). Returns the
# colour chosen this frame, if one was; `y` moves down past it.
_pp_picker = (pg: mut PaintPage, key: int, now: vec4, x: f64, y: mut f64, w: f64, row: f64 = PP_ROW) -> vec4?:
    picked: vec4? = none
    if row < PP_ROW:
        # (short of room: every colour in two rows of nine, their sets unnamed)
        all: Swatch[]
        loop pal in PALETTES: all.extend(pal.1)
        per = 9
        sw = (w - PP_GAP * f64(per - 1)) / f64(per)
        high = row + 4.0
        loop j in 0..all.len():
            if _pp_swatch(Rect(x + f64(j % per) * (sw + PP_GAP), y + f64(j / per) * (high + PP_GAP), sw, high), all[j].colour, length(all[j].colour.xyz - now.xyz) < 0.002): picked = all[j].colour
        y += f64((all.len() + per - 1) / per) * (high + PP_GAP)
    loop pal in (if row < PP_ROW: [] else: PALETTES):
        ptext(pal.0, vec2(f32(x), f32(y + row * 0.5 - 7.0)), 13, _PP_NOTE)
        sw = (w - 76.0 - PP_GAP * 5.0) / 6.0
        loop j in 0..pal.1.len():
            sc = pal.1[j]
            if _pp_swatch(Rect(x + 76.0 + f64(j) * (sw + PP_GAP), y, sw, row), sc.colour, length(sc.colour.xyz - now.xyz) < 0.002): picked = sc.colour
        y += row + PP_GAP
    # (any colour: hue, saturation and brightness, from the colour as it is; folded away until asked for)
    pg.mix = hud_checkbox(Rect(x, y + 6.0, w, PP_ROW - 12.0), "Mix any colour", pg.mix)
    y += PP_ROW + PP_GAP
    if not pg.mix: return picked
    if pg.hsv_key != key or length(pg.hsv_from - now) > 0.001:
        pg.hsv = colour_hsv(now); pg.hsv_key = key; pg.hsv_from = now
    h = hud_slider(Rect(x, y, w, PP_ROW), f64(pg.hsv.x), 0.0, 1.0, 0.0, "Hue")
    y += PP_ROW + PP_GAP
    sa = hud_slider(Rect(x, y, w, PP_ROW), f64(pg.hsv.y), 0.0, 1.0, 0.0, "Saturation")
    y += PP_ROW + PP_GAP
    va = hud_slider(Rect(x, y, w, PP_ROW), f64(pg.hsv.z), 0.05, 1.0, 0.0, "Brightness")
    y += PP_ROW + PP_GAP
    if abs(h - f64(pg.hsv.x)) > 0.0005 or abs(sa - f64(pg.hsv.y)) > 0.0005 or abs(va - f64(pg.hsv.z)) > 0.0005:
        pg.hsv = vec3(f32(h), f32(sa), f32(va))
        c = hsv_colour(h, sa, va)
        picked = c
        pg.hsv_from = vec4(c.x, c.y, c.z, 1)
    if let c = picked: pg.hsv_from = vec4(c.x, c.y, c.z, 1)
    picked

# a row of choices, `per` to a row: the one pressed this frame, or -1; `y` moves down past them
_pp_choices = (names: str[], selected: int, x: f64, y: mut f64, w: f64, per: int) -> int:
    hit = -1
    cw = (w - PP_GAP * f64(per - 1)) / f64(per)
    loop k in 0..names.len():
        r = Rect(x + f64(k % per) * (cw + PP_GAP), y + f64(k / per) * (PP_ROW + PP_GAP), cw, PP_ROW)
        if hud_button(r, fit_text(names[k], cw - 10.0, hud_style.text_size), selected = k == selected): hit = k
    y += f64((names.len() + per - 1) / per) * (PP_ROW + PP_GAP)
    hit

# ---------------- a motif drawn flat ----------------

_pp_motifs: {str: DecalPoly[]} = {}

# A decal's motif in a box (the page's little pictures, the same pieces the aircraft wears).
draw_decal_motif = (d: Decal, box: Rect, card: bool = false):
    global _pp_motifs
    # (on a card of doped linen, so a dark motif shows on the page's dark buttons)
    if card: rect_rounded(f64(box.x), f64(box.y), f64(box.w), f64(box.h), 3, rgb(0.8, 0.77, 0.67))
    id = if d.motif == "text": "text " + d.text else: d.motif
    if not (id in _pp_motifs): _pp_motifs[id] = decal_polys(d.motif, if d.motif == "text" and d.text == "": "A1" else: d.text)
    polys = _pp_motifs[id]
    wide = decal_half_width(d.motif, if d.motif == "text" and d.text == "": "A1" else: d.text)
    scale = min(f64(box.w) * 0.5 / max(wide, 1.0), f64(box.h) * 0.5) * 0.86
    c = vec2(f32(f64(box.x) + f64(box.w) * 0.5), f32(f64(box.y) + f64(box.h) * 0.5))
    loop layer in 0..2:
        loop q in polys:
            if q.layer != layer: continue
            polygon([loop pt in q.pts: c + vec2(pt.x * f32(scale), -pt.y * f32(scale))], decal_colour(d, q.slot))

# what a decal is called in the list: its motif and where it is
_pp_decal_name = (d: Decal) -> str:
    k = decal_motif_index(d.motif)
    what = if d.motif == "text": (if d.text == "": "Letters" else: d.text) else: if k >= 0: DECAL_MOTIFS[k].name else: d.motif
    where = DECAL_SIDES[clamp(d.side, 0, 3)]
    loop sp in DECAL_SPOTS:
        if sp.key == d.spot: where = sp.name
    what + ", " + where.lower()

# ---------------- the tabs ----------------

_pp_livery_tab = (pg: mut PaintPage, p: mut Paint, s: PaintSupport, kind: int, x: f64, y: mut f64, w: f64):
    _pp_head("Livery", x, y); y += 20.0
    current = if p.livery >= 0: p.livery else: paint_default_livery(kind)
    half = (w - PP_GAP) * 0.5
    livery_name = (k: int, own: bool) -> str: (if k < LIVERY_NAMES.len(): LIVERY_NAMES[k] else: "Livery {k + 1}") + (if own: " (own)" else: "")
    # (two to a row, or one when a name would be cut short: every paint shows its whole name)
    per_row = 2
    loop i in 0..s.liveries.len():
        if ptext_width("      " + livery_name(s.liveries[i], i == 0), hud_style.text_size) + 16.0 > half: per_row = 1
    cw = if per_row == 2: half else: w
    loop i in 0..s.liveries.len():
        k = s.liveries[i]
        r = Rect(x + f64(i % per_row) * (half + PP_GAP), y + f64(i / per_row) * (PP_ROW + PP_GAP), cw, PP_ROW)
        lv = LIVERIES[k]
        if hud_button(r, "      " + livery_name(k, i == 0), selected = k == current, align = .left):
            paint_choose_livery(p, k); pg.hsv_key = -1
        # (its colours in a little strip at the left of the button)
        loop c in 0..3:
            rect(f64(r.x) + 6.0 + f64(c) * 7.0, f64(r.y) + 7.0, 6.0, f64(r.h) - 14.0, [lv.body, lv.trim, lv.accent][c])
    y += f64((s.liveries.len() + per_row - 1) / per_row) * (PP_ROW + PP_GAP) + PP_GAP
    _pp_head("Colours", x, y); y += 20.0
    q = (w - PP_GAP * 3.0) / 4.0
    loop k in 0..4:
        r = Rect(x + f64(k) * (q + PP_GAP), y, q, PP_ROW)
        if hud_button(r, "     " + PAINT_SLOTS[k], selected = pg.slot == k, align = .left): pg.slot = k
        rect(f64(r.x) + 6.0, f64(r.y) + 7.0, 14.0, f64(r.h) - 14.0, paint_colour(p, kind, k))
    y += PP_ROW + PP_GAP
    if let c = _pp_picker(pg, pg.slot, paint_colour(p, kind, pg.slot), x, y, w): paint_set_colour(p, pg.slot, c)

_pp_parts_tab = (pg: mut PaintPage, p: mut Paint, s: PaintSupport, kind: int, x: f64, y: mut f64, w: f64):
    _pp_head("Part", x, y); y += 20.0
    there = [loop k in 0..PART_COUNT: if k < s.parts.len() and s.parts[k]: k]
    if there.len() == 0:
        ptext("This type takes one paint all over.", vec2(f32(x), f32(y + 6.0)), 13, _PP_NOTE)
        y += PP_ROW
        return
    if not (pg.part in there): pg.part = there[0]
    per = if w < 520.0: 2 else: 4
    cw = (w - PP_GAP * f64(per - 1)) / f64(per)
    loop i in 0..there.len():
        k = there[i]
        r = Rect(x + f64(i % per) * (cw + PP_GAP), y + f64(i / per) * (PP_ROW + PP_GAP), cw, PP_ROW)
        # (a boat's fuselage is its hull)
        name = if k == PART_FUSELAGE and is_boat(Craft(kind)): "Hull" else: PAINT_PARTS[k]
        if hud_button(r, "     " + name, selected = pg.part == k, align = .left):
            pg.part = k; pg.part_second = false
        rect(f64(r.x) + 6.0, f64(r.y) + 7.0, 14.0, f64(r.h) - 14.0, paint_part_colour(p, kind, k))
        # (a part with its own paint: its second colour beside the first)
        if let own = paint_part(p, k):
            if own.pattern != PATTERN_PLAIN and own.b.w > 0.0: rect(f64(r.x) + 13.0, f64(r.y) + 7.0, 7.0, f64(r.h) - 14.0, own.b)
    y += f64((there.len() + per - 1) / per) * (PP_ROW + PP_GAP) + PP_GAP
    _pp_head("Paint", x, y); y += 20.0
    own = paint_part(p, pg.part)
    now = own ?? PartPaint(part = pg.part)
    # (one row, so the Parts tab and its colours fit a 720-high screen without scrolling)
    choice = _pp_choices(["Livery", "Plain", "Gradient", "Stripes"], if own == none: 0 else: now.pattern + 1, x, y, w, 4)
    if choice == 0: paint_clear_part(p, pg.part)
    else if choice > 0:
        # (a part first painted starts from the colour it has; a second colour from the trim)
        if own == none: now.a = paint_part_colour(p, kind, pg.part)
        now.pattern = choice - 1
        if now.pattern != PATTERN_PLAIN and now.b.w <= 0.0: now.b = paint_colour(p, kind, 1)
        paint_set_part(p, now)
    own = paint_part(p, pg.part)
    if own == none:
        ptext("It wears the livery's colours.", vec2(f32(x), f32(y + 6.0)), 13, _PP_NOTE)
        y += PP_ROW
        return
    now = own
    two = now.pattern != PATTERN_PLAIN
    if not two: pg.part_second = false
    half = (w - PP_GAP) * 0.5
    loop k in 0..(if two: 2 else: 1):
        r = Rect(x + f64(k) * (half + PP_GAP), y, half, PP_ROW)
        if hud_button(r, "     " + (if k == 0: (if two: "First colour" else: "Colour") else: "Second colour"), selected = pg.part_second == (k == 1), align = .left): pg.part_second = k == 1
        rect(f64(r.x) + 6.0, f64(r.y) + 7.0, 14.0, f64(r.h) - 14.0, if k == 0: now.a else: now.b)
    y += PP_ROW + PP_GAP
    if two:
        across = hud_checkbox(Rect(x, y + 6.0, half, PP_ROW - 12.0), "Across the part", now.across)
        if across != now.across:
            now.across = across; paint_set_part(p, now)
        if now.pattern == PATTERN_STRIPES and pg.part != PART_STRUTS:
            bands = int(round(hud_slider(Rect(x + half + PP_GAP, y, half, PP_ROW), f64(now.count), 2.0, 12.0, 1.0, "Bands {now.count}")))
            if bands != now.count:
                now.count = bands; paint_set_part(p, now)
        y += PP_ROW + PP_GAP
    if let c = _pp_picker(pg, 100 + pg.part * 2 + (if pg.part_second: 1 else: 0), if pg.part_second: now.b else: now.a, x, y, w):
        if pg.part_second: now.b = c else: now.a = c
        paint_set_part(p, now)

# the usual spots, as their buttons name them (DECAL_SPOTS order), and anywhere
_PP_SPOT_LABELS = ["Rudder", "Fuselage", "Cowling", "Wing tops", "Under wings", "Fin", "Anywhere"]

# The Decals tab, laid out to fit a 720-high screen: the decals as a row of little pictures (the
# chosen one named whole under them), the motifs, where it goes, its size and angle, its colours.
_pp_decals_tab = (pg: mut PaintPage, p: mut Paint, x: f64, y: mut f64, w: f64):
    half = (w - PP_GAP) * 0.5
    text_size = hud_style.text_size
    pg.decal = clamp(pg.decal, 0, max(p.decals.len() - 1, 0))
    # the decals: a picture each, then one to add another
    per = if w < 520.0: 8 else: 13
    cw = (w - PP_GAP * f64(per - 1)) / f64(per)
    loop k in 0..p.decals.len() + 1:
        r = Rect(x + f64(k % per) * (cw + PP_GAP), y + f64(k / per) * (PP_ROW + PP_GAP), cw, PP_ROW)
        if k == p.decals.len():
            if hud_button(r, "+", enabled = p.decals.len() < DECAL_LIMIT):
                added = paint_add_decal(p, Decal(motif = "disc", spot = "fuselage", size = 0.0))
                if added >= 0:
                    pg.decal = added; pg.decal_colour = 0; pg.group_of = -1
        else:
            if hud_button(r, "", selected = pg.decal == k):
                pg.decal = k; pg.decal_colour = 0
            draw_decal_motif(p.decals[k], Rect(f64(r.x) + 3.0, f64(r.y) + 3.0, f64(r.w) - 6.0, f64(r.h) - 6.0), true)
    y += f64((p.decals.len() + per) / per) * (PP_ROW + PP_GAP)
    if p.decals.len() == 0:
        ptext("None yet: + adds one. Up to {DECAL_LIMIT} can be painted on.", vec2(f32(x), f32(y + 4.0)), 13, _PP_NOTE)
        y += 24.0
        return
    d = p.decals[pg.decal]
    was = d
    # (the chosen one named whole, and taken off)
    ptext(fit_text("{pg.decal + 1} of {p.decals.len()}: {_pp_decal_name(d)}", w - 96.0, 13), vec2(f32(x), f32(y + 3.0)), 13, _PP_NOTE)
    hud_style.text_size = 13.0
    if hud_button(Rect(x + w - 90.0, y - 3.0, 90.0, 22.0), "Remove"):
        paint_remove_decal(p, pg.decal)
        pg.decal = clamp(pg.decal, 0, max(p.decals.len() - 1, 0))
        pg.group_of = -1; pg.pointing = false
        hud_style.text_size = text_size
        y += 24.0
        return
    y += 24.0
    # the motif: its group, then the group's motifs as pictures
    here = decal_motif_index(d.motif)
    if pg.group_of != pg.decal and here >= 0:
        pg.group_of = pg.decal
        loop k in 0..DECAL_GROUPS.len():
            if DECAL_GROUPS[k] == DECAL_MOTIFS[here].group: pg.group = k
    g = _pp_choices(DECAL_GROUPS, pg.group, x, y, w, 5)
    if g >= 0: pg.group = g
    hud_style.text_size = text_size
    shown = [loop k in 0..DECAL_MOTIFS.len(): if DECAL_MOTIFS[k].group == DECAL_GROUPS[pg.group]: k]
    if DECAL_GROUPS[pg.group] == "Text":
        if d.motif != "text":
            if hud_button(Rect(x, y, half, PP_ROW), "Letters and numbers"): d.motif = "text"
        else:
            typed = hud_text_field(Rect(x, y, half, PP_ROW), d.text, "decal-text", DECAL_TEXT_LIMIT, "letters and numbers")
            if typed != d.text: d.text = decal_clean_text(typed)
        y += PP_ROW + PP_GAP
    else:
        mper = if w < 520.0: 8 else: 13
        mw = (w - PP_GAP * f64(mper - 1)) / f64(mper)
        loop i in 0..shown.len():
            m = DECAL_MOTIFS[shown[i]]
            r = Rect(x + f64(i % mper) * (mw + PP_GAP), y + f64(i / mper) * (PP_ROW + PP_GAP), mw, PP_ROW)
            if hud_button(r, "", selected = d.motif == m.key): d.motif = m.key
            draw_decal_motif(Decal(motif = m.key, a = if d.motif == m.key: d.a else: vec4(0, 0, 0, 0), b = if d.motif == m.key: d.b else: vec4(0, 0, 0, 0), c = if d.motif == m.key: d.c else: vec4(0, 0, 0, 0)),
                Rect(f64(r.x) + 3.0, f64(r.y) + 3.0, f64(r.w) - 6.0, f64(r.h) - 6.0), true)
        y += f64((shown.len() + mper - 1) / mper) * (PP_ROW + PP_GAP)
    # where it goes: a usual spot, or anywhere (pointed at on the aircraft herself, or by side and place)
    spot = -1
    loop k in 0..DECAL_SPOTS.len():
        if DECAL_SPOTS[k].key == d.spot: spot = k
    hud_style.text_size = 13.0
    at = _pp_choices(_PP_SPOT_LABELS, if spot < 0: DECAL_SPOTS.len() else: spot, x, y, w, if w < 760.0: 4 else: 7)
    if at >= 0 and at < DECAL_SPOTS.len():
        d.spot = DECAL_SPOTS[at].key; d.size = 0.0
        pg.pointing = false
    else if at == DECAL_SPOTS.len() and d.spot != "":
        d.spot = ""
        if d.size <= 0.0: d.size = 0.8
    if d.spot == "":
        side = _pp_choices(DECAL_SIDES, d.side, x, y, w, 4)
        if side >= 0: d.side = side
        flat = d.side == DECAL_ABOVE or d.side == DECAL_BELOW
        d.u = hud_slider(Rect(x, y, half, PP_ROW), d.u, 0.0, 1.0, 0.0, if flat: "Left to right" else: "Nose to tail")
        d.v = hud_slider(Rect(x + half + PP_GAP, y, half, PP_ROW), d.v, 0.0, 1.0, 0.0, if flat: "Nose to tail" else: "Bottom to top")
        y += PP_ROW + PP_GAP
    hud_style.text_size = text_size
    if hud_button(Rect(x, y, w * 0.62, PP_ROW), if pg.pointing: "Now click or tap her" else: "Point at her to place it", selected = pg.pointing): pg.pointing = not pg.pointing
    d.both = hud_checkbox(Rect(x + w * 0.62 + PP_GAP * 2.0, y + 6.0, w * 0.38 - PP_GAP * 2.0, PP_ROW - 12.0), "Both sides", d.both)
    y += PP_ROW + PP_GAP
    # (at a spot: as large as fits there, until a size is set)
    low = if d.spot == "": 0.1 else: 0.0
    size = hud_slider(Rect(x, y, half, PP_ROW), d.size, low, 6.0, 0.0, if d.size <= 0.0: "Size: as fits" else: "Size {d.size:.2} m")
    if abs(size - d.size) > 0.0005: d.size = if size < 0.1: low else: size
    angle = hud_slider(Rect(x + half + PP_GAP, y, half, PP_ROW), d.angle, -180.0, 180.0, 0.0, "Turned {d.angle:.0}°")
    if abs(angle - d.angle) > 0.05: d.angle = if abs(angle) < 2.0: 0.0 else: angle
    y += PP_ROW + PP_GAP
    # its colours
    n = decal_colours(d.motif)
    pg.decal_colour = clamp(pg.decal_colour, 0, n - 1)
    third = (w - PP_GAP * 2.0) / 3.0
    loop k in 0..n:
        r = Rect(x + f64(k) * (third + PP_GAP), y, third, PP_ROW)
        if hud_button(r, "     " + ["First", "Second", "Third"][k], selected = pg.decal_colour == k, align = .left): pg.decal_colour = k
        rect(f64(r.x) + 6.0, f64(r.y) + 7.0, 14.0, f64(r.h) - 14.0, decal_colour(d, k))
    y += PP_ROW + PP_GAP
    if let c = _pp_picker(pg, 200 + pg.decal * 3 + pg.decal_colour, decal_colour(d, pg.decal_colour), x, y, w, 19.0):
        col = vec4(c.x, c.y, c.z, 1)
        if pg.decal_colour == 0: d.a = col else: if pg.decal_colour == 1: d.b = col else: d.c = col
    if d != was: p.decals[pg.decal] = d

_pp_marks_tab = (p: mut Paint, s: PaintSupport, kind: int, x: f64, y: mut f64, w: f64):
    half = (w - PP_GAP) * 0.5
    _pp_head("Insignia", x, y); y += 20.0
    if not s.wing_marks:
        ptext("This type's wings carry no marks.", vec2(f32(x), f32(y + 6.0)), 13, _PP_NOTE)
        y += PP_ROW
    else:
        wearing = paint_insignia(p, kind)
        loop i in 0..s.insignia.len():
            k = s.insignia[i]
            r = Rect(x + f64(i % 2) * (half + PP_GAP), y + f64(i / 2) * (PP_ROW + PP_GAP), half, PP_ROW)
            if hud_button(r, "        " + INSIGNIA[k].name, selected = k == wearing, align = .left):
                p.insignia = k
                if p.bars < 0: p.bars = if paint_bars(p, kind): 1 else: 0
            if INSIGNIA[k].shape >= 0: _pp_insignia(vec2(f32(f64(r.x) + 18.0), f32(f64(r.y) + f64(r.h) * 0.5)), 9.0, INSIGNIA[k])
        y += f64((s.insignia.len() + 1) / 2) * (PP_ROW + PP_GAP)
        bars = hud_checkbox(Rect(x, y + 6.0, w, PP_ROW - 12.0), "Operator bars on the wings", paint_bars(p, kind))
        if bars != paint_bars(p, kind):
            p.bars = if bars: 1 else: 0
            if p.insignia < 0: p.insignia = paint_insignia(p, kind)
        y += PP_ROW + PP_GAP
    _pp_head("Rudder", x, y); y += 20.0
    if not s.rudder_marks:
        ptext("This type's rudder carries no marks.", vec2(f32(x), f32(y + 6.0)), 13, _PP_NOTE)
        y += PP_ROW
    else:
        own = Rect(x, y, half, PP_ROW)
        if hud_button(own, "As the type has it", selected = p.rudder < 0): p.rudder = -1
        loop i in 0..s.rudders.len():
            k = s.rudders[i]
            j = i + 1
            r = Rect(x + f64(j % 2) * (half + PP_GAP), y + f64(j / 2) * (PP_ROW + PP_GAP), half, PP_ROW)
            if hud_button(r, "        " + RUDDERS[k].name, selected = p.rudder == k, align = .left): p.rudder = k
            cols = if RUDDERS[k].colours.len() > 0: RUDDERS[k].colours else: [paint_colour(p, kind, 3)]
            loop c in 0..cols.len(): rect(f64(r.x) + 8.0 + f64(c) * 6.0, f64(r.y) + 7.0, 6.0, f64(r.h) - 14.0, cols[c])
        y += f64((s.rudders.len() + 2) / 2) * (PP_ROW + PP_GAP)
        _pp_head("Tail number", x, y); y += 20.0
        typed = hud_text_field(Rect(x, y, w - 200.0 - PP_GAP * 2.0, PP_ROW), p.number, "tail-number", 8, "none")
        if typed != p.number: p.number = clean_number(typed)
        if hud_button(Rect(x + w - 200.0 - PP_GAP, y, 100.0, PP_ROW), "Suggest"): p.number = paint_suggest_number(p, kind, frame_number())
        if hud_button(Rect(x + w - 100.0, y, 100.0, PP_ROW), "Clear", enabled = p.number != ""): p.number = ""
        y += PP_ROW + PP_GAP

# The four tabs (Livery, Parts, Decals, Marks) and the chosen one's controls, at x, y, w across:
# the paint changed in place. Returns the height they took. (The pause menu's page and the paint
# shop's panel both draw these.)
paint_tabs = (pg: mut PaintPage, p: mut Paint, s: PaintSupport, kind: int, x: f64, y0: f64, w: f64) -> f64:
    y = y0
    if p.kind != kind: p = paint_reset(kind)
    tab = _pp_choices(PAINT_TABS, pg.tab, x, y, w, 4)
    if tab >= 0:
        pg.tab = tab; pg.hsv_key = -1; pg.pointing = false
    y += PP_GAP
    match pg.tab:
        1: _pp_parts_tab(pg, p, s, kind, x, y, w)
        2: _pp_decals_tab(pg, p, x, y, w)
        3: _pp_marks_tab(p, s, kind, x, y, w)
        else: _pp_livery_tab(pg, p, s, kind, x, y, w)
    p.kind = kind
    y - y0

# The page, at x, y, w across: the type's paint, changed in place. Returns the height it took.
paint_page = (pg: mut PaintPage, p: mut Paint, s: PaintSupport, kind: int, type_name: str, x: f64, y0: f64, w: f64, shop: PaintShopView = PaintShopView()) -> f64:
    y = y0
    if p.kind != kind: p = paint_reset(kind)
    ptext(type_name, vec2(f32(x), f32(y)), 17, rgba(1, 0.97, 0.9, 0.95))
    if shop.mode == .closed:
        # (painting is done at a workshop: the paint as it is, and where things stand)
        y += 26.0
        loop line in wrap_text(shop.note, w, 14):
            ptext(line, vec2(f32(x), f32(y)), 14, _PP_NOTE)
            y += 20.0
        return y - y0
    changes = paint_changes(p, kind)
    said = if changes.len() == 0: "As built" else: "Changed: " + join(changes, ", ")
    ptext(fit_text(said, w - 160.0, 13), vec2(f32(x), f32(y + 22.0)), 13, _PP_NOTE)
    if hud_button(Rect(x + w - 150.0, y, 150.0, PP_ROW), "Reset to default", enabled = changes.len() > 0):
        p = paint_reset(kind); pg.hsv_key = -1
    y += PP_ROW + 22.0
    y += paint_tabs(pg, p, s, kind, x, y, w)
    y - y0
