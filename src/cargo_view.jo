# Plain crates/barrels. Every rendered stack names existing owned cargo; none is scenery stock.
use 'look.jo'
use 'objects.jo'
use 'living_types.jo'
use 'living_cargo.jo'
use 'living_portage.jo'
use 'sea.jo'

struct CargoMeshes:
    crate: Mesh
    barrel: Mesh

build_cargo_meshes = () -> CargoMeshes:
    box: Vertex3D[]
    add_box(box, vec3(0, 0.29, 0), vec3(0.7, 0.58, 0.58), rgb(0.62, 0.45, 0.27))
    loop side in [-1.0, 1.0]:
        add_box(box, vec3(f32(side * 0.28), 0.29, 0), vec3(0.055, 0.61, 0.62), rgb(0.4, 0.29, 0.18))
        add_box(box, vec3(0, 0.29, f32(side * 0.25)), vec3(0.73, 0.055, 0.05), rgb(0.74, 0.57, 0.35))
    add_box(box, vec3(0, 0.586, 0), vec3(0.22, 0.012, 0.3), rgb(0.86, 0.8, 0.64))
    barrel: Vertex3D[]
    add_cylinder(barrel, vec3(0, 0, 0), 0.32, 0.7, rgb(0.45, 0.32, 0.19), 12, 0.32)
    loop h in [0.12, 0.56]: add_cylinder(barrel, vec3(0, f32(h), 0), 0.335, 0.045, rgb(0.22, 0.23, 0.22), 12, 0.335)
    CargoMeshes(custom_mesh(box), custom_mesh(barrel))

cargo_position = (w: World, c: CargoLot) -> vec3:
    if (c.where == .person or c.where == .boat) and c.person >= 0: return w.people[c.person].pose.pos
    if c.where == .aircraft:
        craft = if c.store == .aircraft: c.holder else: if c.job >= 0 and c.job in w.jobs: w.people[w.jobs[c.job].carrier].craft else: -1
        if craft >= 0: return w.aircraft[craft].pose.pos
    if c.where == .boat and c.store == .boat and c.place >= 0: return w.cargo_harbors[c.place].boat_position
    c.pos

cargo_label = (w: World, c: CargoLot) -> str:
    if c.good < 0: "sealed bag" else: "{f64(c.quantity)/1000.0:.1} loads of {w.goods[c.good].key}"

nearest_cargo = (w: World, person: int, reach: f64 = 3.0) -> int:
    p = w.people[person]; best = -1; distance = reach
    ids = w.cargo.keys(); ids.sort()
    loop id in ids:
        c = w.cargo[id]
        if c.good < 0 and c.job < 0 and c.where == .warehouse: continue
        if c.where == .person or c.place != p.place and c.where != .aircraft: continue
        allowed = c.owner == person
        if c.job >= 0 and c.job in w.jobs: allowed = w.jobs[c.job].carrier == person and w.jobs[c.job].state == .claimed
        if not allowed: continue
        taken = false
        loop task_id in w.active_carriage:
            if w.carriage[task_id].cargo == id: taken = true
        if taken: continue
        pos = c.pos
        if c.where == .aircraft:
            spot = cargo_loading_spot(w, p.craft)
            if spot == none: continue
            pos = spot!
        d = f64(length(p.pose.pos - pos))
        if d < distance: distance = d; best = id
    best

draw_cargo = (w: World, meshes: CargoMeshes, L: Light, t: f64):
    cam = scene_camera(); shown: {str: bool}
    loop _, c in w.far.commissions:
        if (c.cargo.roots.len()==0 and c.paper==none) or c.phase==.aboard: continue
        carried=c.phase==.carrying or c.phase==.collecting
        holder=if c.porter>=0: c.porter else: c.carrier
        pos=if carried and holder>=0: w.people[holder].pose.pos else: c.pos
        if length(pos-cam)>600: continue
        at=translation(pos)
        if carried and holder>=0: at=at*quat_to_mat4(w.people[holder].pose.rot)*translation(vec3(0,0.87,-0.52))
        if c.paper!=none: at=at*scaling(vec3(0.45,0.3,0.5))
        mesh=if not carried and (c.good==1 or c.good==2 or c.good==4): meshes.barrel else: meshes.crate
        draw(obj_sh,mesh,obj_params(L,t,at))
    loop id, c in w.cargo:
        if c.where == .aircraft: continue # inside the actual hold
        if c.good < 0 and c.job < 0 and c.where == .warehouse: continue # correspondence stored inside the office
        pos = cargo_position(w, c)
        if (c.place < 0 and not (c.where == .boat and c.person >= 0)) or length(pos - cam) > 600: continue
        if c.where == .person:
            at = translation(pos) * quat_to_mat4(w.people[c.person].pose.rot) * translation(vec3(0, 0.87, -0.52))
            draw(obj_sh, meshes.crate, obj_params(L, t, at))
            continue
        if c.where == .warehouse and c.job < 0:
            # One visible stack can contain several restocking lots at this warehouse spot.
            key = "{int(c.store)}:{c.holder}:{c.owner}:{c.good}"
            if shown.get(key, false): continue
            shown[key] = true
        at = translation(pos)
        if c.where == .boat: at = afloat(pos, t) * at
        if c.good == 1 or c.good == 2 or c.good == 4: draw(obj_sh, meshes.barrel, obj_params(L, t, at))
        else: draw(obj_sh, meshes.crate, obj_params(L, t, at))

# Existing HUD primitives mark the real pickup/delivery anchors, not decorative goods.
draw_cargo_targets = (w: World):
    person = w.people[w.player]
    loop id in w.active_jobs:
        j = w.jobs[id]
        if j.carrier != w.player or j.state != .claimed: continue
        pos: vec3; label = ""
        if person.carrying >= 0 and (j.delivery_mode == .foot or j.loaded):
            pos = j.dropoff; label = "Deliver to {w.people[cargo_receiver(w,id)].name}"
        else if person.carrying >= 0:
            point = cargo_loading_spot(w, person.craft)
            if point == none: continue
            pos = point!; label = "Load the hold"
        else:
            found = false
            loop lot in j.cargo_ids:
                if not (lot in w.cargo): continue
                c = w.cargo[lot]
                if c.where == .warehouse or c.where == .quay:
                    pos = c.pos; label = "Collect {cargo_label(w,c)}"; found = true; break
            if not found: continue
        if length(pos - person.pose.pos) > 450: continue
        if let screen = world_to_screen(pos + vec3(0, 0.6, 0)):
            ring(screen, 7, 2, rgba(0.95, 0.76, 0.32, 0.9))
            text("{label} ({length(pos-person.pose.pos):.0} m)", screen + vec2(12, -8), 15, rgba(1, 0.95, 0.8, 1))
