# UI-facing knowledge, distinct from the omniscient state used by invariants. A chart cannot
# silently acquire remote control/danger just because a force changed a field in World.
use 'living_types.jo'
use 'life_types.jo'
use 'living_far_types.jo'
use 'living_far_news.jo'
use 'living_missions.jo'

struct WarPlaceView:
    place: int
    sovereign: int
    controller = -1
    authority = -1
    observed_minute = -1
    learned_minute = -1
    source_person = -1
    confidence = 0
    danger = -1
    reason = "No current local report."

struct WarRelationView:
    a: int
    b: int
    stage: CrisisStage = .calm
    known = false
    occurred_minute = -1
    learned_minute = -1
    source_person = -1

war_places = (w: World, actor: int = 0) -> WarPlaceView[]:
    if actor<0 or actor>=w.people.len(): return []
    result: WarPlaceView[]; at=mission_position(w,actor)
    loop id in w.far.place_ids:
        d=w.far.districts[id]; view=WarPlaceView(place=id,sovereign=d.born_country)
        loop r in w.people[actor].far_reports:
            if not far_report_current(w,r): continue
            if r.kind=="blockade" and r.origin==id:
                view.danger=max(view.danger,r.severity); view.reason=r.text
            observed=if r.kind=="occupation": r.origin else: if r.kind=="reconnaissance": r.subject_place else: -1
            control=if r.kind=="occupation": r.country else: r.other_country
            occurred=if r.kind=="reconnaissance": r.subject_minute else: r.occurred_minute
            if observed!=id or control<0: continue
            if occurred<view.observed_minute: continue
            view.controller=control; view.observed_minute=occurred; view.learned_minute=r.learned_minute
            view.source_person=r.source_person; view.confidence=r.confidence; view.danger=r.severity
            view.reason=r.text
        if length(w.place_contexts[id].center-at)<2000:
            view.controller=d.controller; view.authority=d.authority
            view.observed_minute=w.minute; view.learned_minute=w.minute; view.confidence=1000
            view.danger=d.danger; view.reason="Observed locally."
        result.push(view)
    result

war_relations = (w: World, actor: int = 0) -> WarRelationView[]:
    if actor<0 or actor>=w.people.len(): return []
    result: WarRelationView[]
    loop relation in w.diplomacy:
        view=WarRelationView(relation.a,relation.b)
        loop r in w.people[actor].far_reports:
            if not far_report_current(w,r) or r.other_country<0 or min(r.country,r.other_country)!=relation.a or max(r.country,r.other_country)!=relation.b or r.occurred_minute<view.occurred_minute: continue
            if r.kind!="war_declared" and r.kind!="armistice": continue
            view.stage=if r.kind=="war_declared": CrisisStage.war else: .armistice
            view.known=true; view.occurred_minute=r.occurred_minute
            view.learned_minute=r.learned_minute; view.source_person=r.source_person
        result.push(view)
    result
