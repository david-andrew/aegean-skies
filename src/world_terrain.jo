use 'runtime_options.jo'
use 'build_slice.jo'
use 'river_material.jo'
use 'water_field.jo'
use 'lake_field.jo'
use 'lake_data.jo'
use 'lake_material.jo'
use 'river_data.jo'
use 'depth_space.jo'
use 'paint.jo'
# Bounded regular-grid quadtree for the NEW geography. Legacy terrain remains
# byte-for-byte the original canonical surface, drawn by terrain.jo.
use 'quality.jo'
use 'canopy.jo'
use 'crowns.jo'
use 'fields.jo'
use 'field_map.jo'
use 'geography.jo'
use 'world_source.jo'
use 'terrain.jo'
use 'plants.jo'
use 'terrain_lod.jo'
use 'look.jo'
use 'tweaks.jo'
use 'render_space.jo'
use 'coast_mesh.jo'
use 'coast_atlas.jo'
use 'coast_field.jo'
use 'coast_pattern.jo'
use 'road_material.jo'
use 'settlement_purpose.jo'

const WORLD_TILE_CELLS = 16
const WORLD_TILE_SPAN = 224.0
const WORLD_ROOT_LEVEL = 12
const WORLD_ROOT_ORIGIN = -458752.0
const WORLD_CACHE_SLOTS = 1024
const WORLD_ATLAS_COLS = 32
const WORLD_TILE_PIXELS = 17
# (eleven RGBA8 atlas regions a tile: its heights and its materials, and since the fields, the
# orchards and woods' wash, and the cliffs morph between levels, each of those three maps three
# regions wide (world_triples: every sample beside its value one and two levels coarser):
# 12716 bytes a tile, 8092 with those maps apart and 4624 before they morphed; the five
# atlases are 13 MB of texture, 8 MB and 5 MB before)
const WORLD_TILE_UPLOAD_BYTES = WORLD_TILE_PIXELS*WORLD_TILE_PIXELS*4*11
const WORLD_GENERATE_LIMIT = 4
const WORLD_CONTACT_GENERATE_LIMIT = 9

struct WorldTile:
    key: int = -1
    x: int
    z: int
    level: int
    used: int = -100
    born: f64
    low: f64
    high: f64
    lod: f64
    published: bool = false
    cpu_heights: f32[] = []
    cpu_materials: u8[] = []
    inland_water: bool = false
    canal_city: bool = false       # over Neravessa's canal cut (world_tile_canal)
    stand: f32[] = []              # the woods' stand cover per sample (to level 3: src/canopy.jo wood_cover)
    rise: f32[] = []               # and the canopy's rise there
    wooded: f32 = 0.0              # its samples' most stand cover (any level)
    entered: f64 = -1e9            # when it last came into the selection (world_clock)
    start: f64 = 0.0               # the detail drawn where it is when it came in (a lod), which it morphs from
    maps: int = 7                  # which of its maps hold anything (1 fields, 2 orchards or canopy, 4 cliffs): its vertices read no others (the laptop's GPU pays for every read)
    cpu_working: u8[] = []         # its samples' field colour and share, as uploaded (tools/lod_pop_check.jo reads them)
    cpu_working_far: u8[] = []     # and on the next coarser level's grid (world_working_coarser)
    cpu_cover: u8[] = []           # the orchards' cover (r) and the woods' wash (b), and each on the coarser grid (g, a)
    cpu_cliff: u8[] = []           # the cliff map's stations, as uploaded
    cpu_cliff_far: u8[] = []       # and on the next coarser level's grid (world_cliff_coarser)

struct WorldInstance:
    origin: vec2
    texel: vec2
    state: vec4                    # cell metres, interior morph, level, which maps the tile has anything in (WorldTile.maps)
    edges: vec4                    # shared absolute levels relative to this tile

world_tiles: WorldTile[]
world_cache: {int:int} = {}
world_selected: int[]
world_contact_slots: int[]
world_contact_rect = vec4(0,0,0,0)
world_frame = 0
world_generated = 0
world_generate_budget = WORLD_GENERATE_LIMIT
# Past the first tile of a frame, tiles are made only until this time(): a fast low flight
# asks for more than a frame can make, and the coarser tile stands in a frame or two. The
# walker's own 3x3 contact neighbourhood is exempt (it is never a stand-in).
# (a variable: checks of what streaming converges to, run frame after frame with no frame
# time to keep, lift it and so make tiles as fast as the old four-a-frame limit allows)
world_generate_seconds = 0.005
world_generate_until = 0.0
# (checks: a fixed count of tiles a frame in place of the time slice, three while the arrival's
# larger slice would apply, so a check tests the order and the arrival's share, not how fast the
# machine is; 0 in the game, which keeps its time slice)
world_generate_tiles = 0
world_generate_made = 0           # (tiles made this frame outside the contact burst)
_world_slice_spent = () -> bool:
    if world_generate_tiles > 0: return world_generate_made >= world_generate_tiles * (if world_arriving_bare: 3 else: 1)
    time() > world_generate_until
# While most land in view has nothing that can be drawn (just after a jump, a load or the
# title's city shot), tiles get a larger slice of the frame: a few slower frames rather than
# seconds of sea where the coast should be. (Only most: a coastal tile or two hidden after
# landing at a quay is no reason to slow every frame.)
const WORLD_ARRIVAL_SECONDS = 0.015
world_arriving = false            # (land chosen hidden, tiles still to make: coarsest first)
world_arriving_bare = false       # (and more of it hidden than drawn: the larger slice too)
world_contact_requesting = false
world_uploaded = 0
world_draws = 0
world_triangles = 0
world_shell_tiles = 0               # (the tiles the canopy's sheet was drawn over, this frame)
world_clock = 0.0
world_heights: Texture
world_materials: Texture
world_keep_maps = false             # (a tile's uploaded fields, cover and cliff maps kept on the CPU too: tools/lod_pop_check.jo)
world_cliff_map: Texture            # each tile's cliff stations, each beside the two coarser levels' there (world_triples)
world_working:Texture              # each tile's fields, the same way
world_cover:Texture                # each tile's orchard cover (r) and canopy rise (g), the same way
world_ground_sh: Shader

world_tile_key = (x: int,z: int,level: int) -> int: level * 100000000 + x * 8192 + z
world_tile_size = (level: int) -> f64: WORLD_TILE_SPAN * f64(1 << level)
world_tile_origin = (x: int,z: int,level: int) -> (f64,f64):
    size = world_tile_size(level)
    (WORLD_ROOT_ORIGIN + f64(x)*size,WORLD_ROOT_ORIGIN + f64(z)*size)

world_possible_land = (x: f64,z: f64,size: f64) -> bool:
    if x >= WORLD_WIDTH*0.5 or z >= WORLD_DEPTH*0.5 or x+size <= -WORLD_WIDTH*0.5 or z+size <= -WORLD_DEPTH*0.5: return false
    if x >= -LEGACY_RESERVE and z >= -LEGACY_RESERVE and x+size <= LEGACY_RESERVE and z+size <= LEGACY_RESERVE: return false
    loop r in LAND_REGIONS:
        if x <= f64(r.bounds.z)*1000.0+2000.0 and z <= f64(r.bounds.w)*1000.0+2000.0 and x+size >= f64(r.bounds.x)*1000.0-2000.0 and z+size >= f64(r.bounds.y)*1000.0-2000.0: return true
    if size <= 16000.0:
        loop bz in int(floor(z/16000.0))..int(floor((z+size)/16000.0))+1:
            loop bx in int(floor(x/16000.0))..int(floor((x+size)/16000.0))+1:
                key = (bx+32)*128+bz+32
                if not (key in island_bins): continue
                loop k in island_bins[key]:
                    isl = small_islands[k]
                    radius = f64(max(isl.radii.x,isl.radii.y))*1.9+500.0
                    if x <= f64(isl.center.x)+radius and z <= f64(isl.center.y)+radius and x+size >= f64(isl.center.x)-radius and z+size >= f64(isl.center.y)-radius: return true
    else:
        loop isl in small_islands:
            radius = f64(max(isl.radii.x,isl.radii.y))*1.9+500.0
            if x <= f64(isl.center.x)+radius and z <= f64(isl.center.y)+radius and x+size >= f64(isl.center.x)-radius and z+size >= f64(isl.center.y)-radius: return true
    false

world_distance = (x: f64,z: f64,size: f64,cam: vec3) -> f64:
    dx = max(max(x-f64(cam.x),f64(cam.x)-x-size),0.0)
    dz = max(max(z-f64(cam.z),f64(cam.z)-z-size),0.0)
    dy = max(f64(cam.y)-3010.0,0.0)
    sqrt(dx*dx+dz*dz+dy*dy)

world_tile_visible = (x: f64,z: f64,size: f64,cam: vec3,planes: vec4[]) -> bool:
    center = vec3(f32(x+size*0.5),1475,f32(z+size*0.5))
    radius = sqrt(size*size*0.5+1535.0*1535.0) + f64(length(center.xz-cam.xz))*size/EARTH_RADIUS + size*size/EARTH_RADIUS + 1.0
    c = render_world(center,cam)
    loop p in planes:
        if f64(dot(p.xyz,c)+p.w) < -radius: return false
    true

# Whether a block of a tile's canopy (x, z, size; the tile's ground between low and high) may be in view.
billow_block_visible = (x: f64,z: f64,size: f64,low: f64,high: f64,cam: vec3,planes: vec4[]) -> bool:
    tall = (high-low)*0.5+25.0
    center = vec3(f32(x+size*0.5),f32((low+high)*0.5+12.0),f32(z+size*0.5))
    radius = sqrt(size*size*0.5+tall*tall)+30.0
    c = render_world(center,cam)
    loop p in planes:
        if f64(dot(p.xyz,c)+p.w) < -radius: return false
    true

world_upload_tile = (t: Texture,img: Image,slot: int):
    global world_uploaded
    world_uploaded += img.pixels.len()
    flush()
    glBindTexture(GL_TEXTURE_2D,u32(t.id))
    glPixelStorei(GL_UNPACK_ALIGNMENT,1)
    # (a map of triples is three times as wide: world_triples)
    gl_tex_sub_image((slot%WORLD_ATLAS_COLS)*img.width,(slot/WORLD_ATLAS_COLS)*WORLD_TILE_PIXELS,img.width,WORLD_TILE_PIXELS,GL_RGBA,GL_UNSIGNED_BYTE,data(img.pixels),img.pixels.len())

# A tile's map with each sample's three values side by side: its own, the next coarser level's
# there (world_working_coarser, world_cliff_coarser), and the level's after that. A vertex reads
# across them by how far it is drawn toward the coarser levels, and the texture's own filter
# gives the value morphed between two of them: one read, whatever the vertex. Read apart (three
# textures, and a tile's edge beside a coarser tile reading that tile's grid sample by sample)
# they were most of what the morphing cost: the laptop's GPU pays for every read a vertex
# makes, and it works a tile's vertices in groups, each paying for whatever any one of them reads.
world_triples = (own: u8[],coarser: u8[],coarsest: u8[]) -> Image:
    out = image(WORLD_TILE_PIXELS*3,WORLD_TILE_PIXELS)
    loop k in 0..WORLD_TILE_PIXELS*WORLD_TILE_PIXELS:
        loop c in 0..4:
            out.pixels[k*12+c] = own[k*4+c]
            out.pixels[k*12+4+c] = coarser[k*4+c]
            out.pixels[k*12+8+c] = coarsest[k*4+c]
    out

# A tile's samples are taken a row at a time, so a tile can be made over a few frames (the
# coarser tile above it stands in meanwhile); the textures go up when the last row is done.
struct WorldTileJob:
    key: int = -1
    x: int = 0
    z: int = 0
    level: int = 0
    row: int = 0
    asked: int = -100             # (the frame it was last asked for)
    advanced: int = -100          # (the frame it last took a row)
    h: Image
    m: Image
    cliff_stations: vec3[]
    working: Image
    working_far: Image             # the fields as the next coarser level has them (world_working_far)
    cover: Image                   # the orchards' cover (r) and the canopy's rise (b) at each sample; at the finish, each on the next coarser level's grid too (g, a)
    low: f64 = 1e9
    high: f64 = -1e9
    values: f32[]
    material_bytes: u8[]
    stand: f32[] = []
    rise: f32[] = []
    wooded: f32 = 0.0

world_tile_job_start = (x: int,z: int,level: int) -> WorldTileJob:
    WorldTileJob(world_tile_key(x,z,level),x,z,level,h=image(17,17),m=image(17,17),working=image(17,17),working_far=image(17,17),cover=image(17,17))

# Rows until `until` (a time()), at least one; true once all 17 are done.
world_tile_job_rows = (job: mut WorldTileJob,until: f64) -> bool:
    ox,oz = world_tile_origin(job.x,job.z,job.level)
    cell = 14.0*f64(1<<job.level)
    loop job.row < 17:
        if job.advanced == world_frame and time() > until: return false
        job.advanced = world_frame
        j = job.row
        loop i in 0..17:
            wx = ox + f64(i)*cell; wz = oz+f64(j)*cell
            sy,ridge = world_source_sample(wx,wz)
            y = round(sy*4096.0)/4096.0
            job.low = min(job.low,y); job.high = max(job.high,y)
            job.values.push(f32(y))
            packed = int(round((y+64.0)*4096.0))
            a = (j*17+i)*4
            job.h.pixels[a] = u8(packed & 255)
            job.h.pixels[a+1] = u8((packed>>8)&255)
            job.h.pixels[a+2] = u8((packed>>16)&255)
            job.h.pixels[a+3] = u8(round(clamp(ridge*0.5+0.5,0.0,1.0)*255.0))
            # Normals use a fixed world-space footprint at every LOD, so shared
            # samples keep the same material as neighboring tiles refine.
            nx = world_source_sample(wx-5.0,wz).0-world_source_sample(wx+5.0,wz).0
            nz = world_source_sample(wx,wz-5.0).0-world_source_sample(wx,wz+5.0).0
            normal = normalize(vec3(f32(nx),10,f32(nz)))
            station = cliff_station(f32(y),normal.y)
            if (job.level>0 or i==0 or i==16 or j==0 or j==16) and cliff_check_foot(station,f32(y)):
                # Use the same physical stencil on either side of a tile seam
                # and at coarser levels. Interiors reuse job.values on upload.
                hx = max(world_source_sample(wx-14.0,wz).0,world_source_sample(wx+14.0,wz).0)
                hz = max(world_source_sample(wx,wz-14.0).0,world_source_sample(wx,wz+14.0).0)
                station = cliff_foot_station(station,f32(y),f32(max(hx,hz)))
            job.cliff_stations.push(station)
            job.m.set(i,j,vec4(normal.x*0.5+0.5,normal.z*0.5+0.5,f32(fbm(wx*0.004+3.3,wz*0.004,3)),f32(noise(wx*0.0011-3.3,wz*0.0011))))
            work = working_landuse(vec2(f32(wx),f32(wz)),y,f64(length(normal.xz)/max(normal.y,0.1)))
            landuse = work
            # (the fields baked here as their colour (rgb) and share (a), working land and fields
            # alike, for every tier: the ground shader only mixes it in)
            hy = f32(y)
            stands = clamp(grove_pine_cover(f32(grove_field(wx,wz)),length(normal.xz)/max(normal.y,0.1),hy)*7.0,0.0,1.0)
            # (the orchards' cover: baked too, so the ground's vertices read it and it morphs
            # between levels with them; worked out at each vertex's own place it changed over a
            # whole tile when the tile split or merged)
            orchard = orchard_cover(vec2(f32(wx),f32(wz)),hy,length(normal.xz)/max(normal.y,0.1))
            wash = 0.5+(vnoise(vec2(f32(wx),f32(wz))*0.006)-0.5)*0.8
            work = field_colour(work,vec2(f32(wx),f32(wz)),hy,1.0-normal.y,stands,orchard,f32(cell),field_warp_cpu(vec2(f32(wx),f32(wz))),field_palette)
            job.working.set(i,j,work)
            # (and as the next coarser level bakes this sample, which is one of its own: only a
            # level-1 tile's differ, its parent's samples being wider apart than a field)
            work_far = work
            if i%2 == 0 and j%2 == 0:
                if job.level == 1: work_far = field_colour(landuse,vec2(f32(wx),f32(wz)),hy,1.0-normal.y,stands,orchard,f32(cell*2.0),field_warp_cpu(vec2(f32(wx),f32(wz))),field_palette)
                job.working_far.set(i,j,work_far)
            # (the woods' stand cover, as the ground paints it, and the canopy's rise: for the
            # canopy's domes over the tile, and whether the canopy covers it at all)
            covered = wood_cover(normal,hy,f32(ridge),f32(fbm(wx*0.004+3.3,wz*0.004,3)),f32(noise(wx*0.0011-3.3,wz*0.0011)),wash,work.w,orchard,true)
            # (the canopy's rise baked too, for its sheet (world_shell_vertex), which morphs it
            # between levels: worked out at each vertex from morphed values, a rise that is all
            # thresholds changed over a whole tile at a split. As the next coarser level has it:
            # with that level's share of fields)
            bare = 1.0-smoothstep(1700.0,2300.0,hy)
            rise_far = if job.level == 1 and i%2 == 0 and j%2 == 0: wood_cover(normal,hy,f32(ridge),f32(fbm(wx*0.004+3.3,wz*0.004,3)),f32(noise(wx*0.0011-3.3,wz*0.0011)),wash,work_far.w,orchard,true).y else: covered.y
            job.cover.set(i,j,vec4(orchard,orchard,covered.y*bare,rise_far*bare))
            job.wooded = max(job.wooded,covered.x)
            if job.level <= 2: job.stand.push(covered.x); job.rise.push(covered.y)
            job.material_bytes.push(job.h.pixels[a+3])
            loop c in 0..4:job.material_bytes.push(job.m.pixels[a+c])
        job.row += 1
    true

# The canopy's domes over each tile, by its slot (billow_build), and which of a tile's lists
# hold any (so a frame never reads the empty ones).
world_billows: Billow[][][] = []
world_billow_has: int[][] = []
# The fields on the next coarser level's grid, at every sample of a tile: that level's own
# samples (the tile's even ones) as given, the others between them on that grid's triangles (as
# world_coarse has the height). A tile's fields morph to these as the tile morphs to the coarser
# level, where its parent draws exactly them: no change at a split or a merge.
world_working_coarser = (given: u8[],step: int = 2) -> u8[]:
    out = given
    loop j in 0..17:
        loop i in 0..17:
            if i%step == 0 and j%step == 0: continue
            ax = min(i-i%step,16-step); az = min(j-j%step,16-step)
            fx = f32(i-ax)/f32(step); fz = f32(j-az)/f32(step)
            loop c in 0..4:
                aa = f32(given[(az*17+ax)*4+c]); bb = f32(given[(az*17+ax+step)*4+c])
                cc = f32(given[((az+step)*17+ax)*4+c]); dd = f32(given[((az+step)*17+ax+step)*4+c])
                v = if fx+fz <= 1.0: aa+(bb-aa)*fx+(cc-aa)*fz else: dd+(cc-dd)*(1.0-fx)+(bb-dd)*(1.0-fz)
                out[(j*17+i)*4+c] = u8(clamp(round(v),0.0,255.0))
    out

# A tile's cliff stations two levels coarser, at every sample: the next coarser level's
# (world_cliff_coarser's image) at every fourth sample, between them on that grid's triangles,
# as moments (a station's weighted height is in two bytes: mixed as one number).
world_cliff_coarsest = (given: u8[]) -> u8[]:
    out = given
    loop j in 0..17:
        loop i in 0..17:
            if i%4 == 0 and j%4 == 0: continue
            ax = min(i-i%4,12); az = min(j-j%4,12)
            fx = f32(i-ax)/4.0; fz = f32(j-az)/4.0
            at = (di: int,dj: int) -> vec3:
                k = ((az+dj)*17+ax+di)*4
                vec3(f32(given[k])+f32(given[k+1])*256.0,f32(given[k+2]),f32(given[k+3]))
            aa = at(0,0); bb = at(4,0); cc = at(0,4); dd = at(4,4)
            v = if fx+fz <= 1.0: aa+(bb-aa)*fx+(cc-aa)*fz else: dd+(cc-dd)*(1.0-fx)+(bb-dd)*(1.0-fz)
            h = int(clamp(round(v.x),0.0,65535.0))
            k = (j*17+i)*4
            out[k] = u8(h & 255); out[k+1] = u8(h >> 8)
            out[k+2] = u8(clamp(round(v.y),0.0,255.0)); out[k+3] = u8(clamp(round(v.z),0.0,255.0))
    out

# The cliff map's stations on the next coarser level's grid, at every sample of a tile (as
# world_working_coarser has the fields): at that level's own samples (the tile's even ones) what
# the parent tile bakes there (src/terrain_lod.jo cliff_map_image at twice the spacing: the
# station with its foot, spread onto its face a quarter as much, over the parent's neighbours;
# one beyond this tile's edge counts as the sample itself), between them on that grid's
# triangles, as moments (the weighted height, the weight, the wall), which is how they cross a
# triangle. stations: the tile's own (a level-0 tile's without their feet inside its edges,
# given here as the parent has them). x, z: the tile's place, for which of its edges are the
# parent's.
world_cliff_coarser = (stations: vec3[],heights: f32[],x: int,z: int,level: int) -> Image:
    own: vec3[] = stations
    if level == 0:
        loop j in [2,4,6,8,10,12,14]:
            loop i in [2,4,6,8,10,12,14]:
                k = j*17+i
                if cliff_check_foot(own[k],heights[k]): own[k] = cliff_foot_station(own[k],heights[k],max(max(heights[k-1],heights[k+1]),max(heights[k-17],heights[k+17])))
    spread = 0.25/f32((1<<level)*(1<<level))
    far: vec3[] = own
    loop j in [0,2,4,6,8,10,12,14,16]:
        loop i in [0,2,4,6,8,10,12,14,16]:
            # (the parent's own edge samples are left as they are, as in cliff_map_image)
            pi = (x%2)*8+i/2; pj = (z%2)*8+j/2
            if pi <= 0 or pi >= 16 or pj <= 0 or pj >= 16: continue
            k = j*17+i
            at = (di: int,dj: int) -> vec3:
                ni = i+di; nj = j+dj
                if ni < 0 or ni > 16 or nj < 0 or nj > 16: own[k] else: own[nj*17+ni]
            sides = at(-2,0)+at(2,0)+at(0,-2)+at(0,2)
            corners = at(-2,-2)+at(2,-2)+at(-2,2)+at(2,2)
            far[k] = mix(own[k],(own[k]*4.0+sides*2.0+corners)/16.0,spread)
    result = image(17,17)
    loop j in 0..17:
        loop i in 0..17:
            v = far[j*17+i]
            if i%2 != 0 or j%2 != 0:
                ax = min(i-i%2,14); az = min(j-j%2,14)
                fx = f32(i-ax)/2.0; fz = f32(j-az)/2.0
                aa = far[az*17+ax]; bb = far[az*17+ax+2]; cc = far[(az+2)*17+ax]; dd = far[(az+2)*17+ax+2]
                v = if fx+fz <= 1.0: aa+(bb-aa)*fx+(cc-aa)*fz else: dd+(cc-dd)*(1.0-fx)+(bb-dd)*(1.0-fz)
            # (packed as cliff_map_image packs a station: the weighted height in sixty-fourths of a metre)
            w = round(v.y*255.0)
            h = int(round(v.x/max(v.y,0.00001)*w*(64.0/255.0)))
            k = (j*17+i)*4
            result.pixels[k] = u8(h & 255); result.pixels[k+1] = u8(h >> 8)
            result.pixels[k+2] = u8(w); result.pixels[k+3] = u8(round(v.z*255.0))
    result

world_tile_job_finish = (job: WorldTileJob,slot: int) -> WorldTile:
    global world_billows,world_billow_has
    far = job.working_far
    far.pixels = world_working_coarser(job.working_far.pixels)
    # (the orchards the same way: g, the cover on the next coarser level's grid)
    cover = job.cover
    coarser = world_working_coarser(job.cover.pixels)
    loop k in 0..289: cover.pixels[k*4+1] = coarser[k*4+1]; cover.pixels[k*4+3] = coarser[k*4+3]
    # (its map: the orchards' cover and the canopy's rise at each sample (r, g), beside them
    # one and two levels coarser)
    cover_own: u8[] = [loop k in 0..289*4: u8(0)]
    cover_far: u8[] = [loop k in 0..289*4: u8(0)]
    loop k in 0..289:
        cover_own[k*4] = cover.pixels[k*4]; cover_own[k*4+1] = cover.pixels[k*4+2]
        cover_far[k*4] = cover.pixels[k*4+1]; cover_far[k*4+1] = cover.pixels[k*4+3]
    world_upload_tile(world_cover,world_triples(cover_own,cover_far,world_working_coarser(cover_far,4)),slot)
    world_upload_tile(world_heights,job.h,slot)
    world_upload_tile(world_materials,job.m,slot)
    cliffs = cliff_map_image(job.cliff_stations,17,17,1<<job.level,job.values)
    cliffs_far = world_cliff_coarser(job.cliff_stations,job.values,job.x,job.z,job.level)
    world_upload_tile(world_cliff_map,world_triples(cliffs.pixels,cliffs_far.pixels,world_cliff_coarsest(cliffs_far.pixels)),slot)
    world_upload_tile(world_working,world_triples(job.working.pixels,far.pixels,world_working_coarser(far.pixels,4)),slot)
    tile=WorldTile(job.key,job.x,job.z,job.level,world_frame,world_clock,job.low,job.high,f64(job.level+1),false,job.values,job.material_bytes,world_tile_inland(job.x,job.z,job.level))
    tile.canal_city=world_tile_canal(job.x,job.z,job.level)
    tile.stand=job.stand; tile.rise=job.rise
    # (which maps hold anything: fields with any share, own or as the coarser level has them;
    # any orchard or canopy; any station that can make a cliff's contact, as cliff_vertex_data
    # judges it at its own sample)
    tile.maps = 0
    loop k in 0..289:
        if job.working.pixels[k*4+3] > 0 or far.pixels[k*4+3] > 0: tile.maps = tile.maps | 1
        if cover.pixels[k*4] > 0 or cover.pixels[k*4+1] > 0 or cover.pixels[k*4+2] > 0 or cover.pixels[k*4+3] > 0: tile.maps = tile.maps | 2
        loop c in 0..2:
            px = if c == 0: cliffs.pixels else: cliffs_far.pixels
            sum = (f32(px[k*4])+f32(px[k*4+1])*256.0)/64.0
            if px[k*4+3] > 0 or sum > (job.values[k]+0.5)*f32(px[k*4+2])/255.0: tile.maps = tile.maps | 4
    # (kept on the CPU only for tools/lod_pop_check.jo, which sets world_keep_maps: 6 KB a tile)
    if world_keep_maps:
        tile.cpu_working=job.working.pixels
        tile.cpu_working_far=far.pixels
        tile.cpu_cover=cover.pixels
        tile.cpu_cliff=cliffs.pixels
        tile.cpu_cliff_far=cliffs_far.pixels
    tile.wooded=job.wooded
    # (the canopy's domes over it: kept by slot beside the tiles, which are copied about each frame)
    loop world_billows.len() <= slot: world_billows.push([]); world_billow_has.push([])
    world_billows[slot] = []; world_billow_has[slot] = []
    if job.wooded > 0.05 and job.level <= 2:
        ox,oz = world_tile_origin(job.x,job.z,job.level)
        world_billows[slot] = billow_build(job.x,job.z,job.level,job.values,job.stand,job.rise)
        world_billow_has[slot] = billow_held(world_billows[slot])
    tile

world_make_tile = (x: int,z: int,level: int,slot: int) -> WorldTile:
    job = world_tile_job_start(x,z,level)
    _ = world_tile_job_rows(job,1e30)
    world_tile_job_finish(job,slot)

world_tile_job = WorldTileJob()
# While arriving (world_arriving), the job takes only tiles of the coarsest level asked for and
# not made last frame (first asked first among them). Fine tiles near the camera are of
# no use until the coarser ones around them exist, as balancing folds them back into their
# ancestors; made nearest first, a jump to a coast drew nothing until some 300 tiles were
# made. Otherwise the first asked is made first (the contact ring ahead, then nearest).
world_next_level = -1
world_want_key = -1
world_want_level = -1
world_want_distance = 0.0
world_want_cam = vec3(0,0,0)
world_want = (key: int,x: int,z: int,level: int):
    global world_want_key,world_want_level,world_want_distance,world_want_warm
    if level < world_want_level: return
    ox,oz = world_tile_origin(x,z,level)
    d = world_distance(ox,oz,world_tile_size(level),world_want_cam)
    if world_warming and world_want_main: return
    if level > world_want_level or d < world_want_distance:
        world_want_key = key; world_want_level = level; world_want_distance = d; world_want_warm = world_warming

# Warming views ahead of the camera: the title's next shot, a jump or a load about to land.
# world_warm(views) asks for the tiles each view would draw (and a ground-level view's
# contact tiles) every frame, after the camera's own and within the same slices, coarsest
# first; world_warm_settled() is true once a whole pass over them found every tile made.
# Keep it to a view or two at a time: each holds its tiles (100-300 of the 1024) in the cache.
struct WorldWarmView:
    eye: vec3
    look: vec3                     # a point looked at
    fov: f64 = 70.0                # vertical, degrees
    aspect: f64 = 0.0              # width over height (0: the screen's)
world_warm_views: WorldWarmView[]
world_warm_selected: int[] = []    # (the tiles the warm views chose last frame, and each one's eye: for the groves)
world_warm_eyes: vec3[] = []
world_warming = false
world_want_main = false
world_want_warm = false
world_warm_missing = 0
world_warm_ready = false
world_warm_slice = 0.0
# (slice: seconds of each frame the warming may take beyond the camera's own tiles; 0: none
# beyond the ordinary allowance)
world_warm = (views: WorldWarmView[], slice: f64 = 0.0):
    global world_warm_views,world_warm_ready,world_warm_slice
    world_warm_views = views; world_warm_ready = false; world_warm_slice = slice
world_warm_clear = (): world_warm([])
world_warm_settled = () -> bool: world_warm_views.len() > 0 and world_warm_ready
# The camera's own view: none of the tiles it asked for last frame is missing.
world_view_missing = 0
world_view_settled = () -> bool: world_view_missing == 0

world_request_tile = (x: int,z: int,level: int) -> int:
    global world_tiles,world_cache,world_generated,world_tile_job,world_next_level,world_generate_made
    key = world_tile_key(x,z,level)
    if key in world_cache:
        slot = world_cache[key]
        world_tiles[slot].used = world_frame
        return slot
    global world_warm_missing,world_view_missing
    if world_warming: world_warm_missing += 1 else: world_view_missing += 1
    if world_generated >= world_generate_budget: return -1
    # Outside the walker's contact tiles one tile is made at a time, a few rows a frame within
    # the frame's allowance; a tile no longer asked for gives way to the next one asked.
    if not world_contact_requesting:
        if world_tile_job.key != key:
            world_want(key,x,z,level)
            if world_tile_job.key >= 0 and world_tile_job.asked >= world_frame-1: return -1
            if world_next_level >= 0 and level < world_next_level: return -1
            if _world_slice_spent(): return -1
            world_tile_job = world_tile_job_start(x,z,level)
        world_tile_job.asked = world_frame
        if not world_tile_job_rows(world_tile_job,world_generate_until): return -1
    slot = -1; oldest = world_frame-2
    loop i in 0..WORLD_CACHE_SLOTS:
        if world_tiles[i].key < 0: slot = i; break
        if world_tiles[i].level == WORLD_ROOT_LEVEL: continue
        if world_tiles[i].used < oldest: oldest = world_tiles[i].used; slot = i
    if slot < 0: return -1
    if world_tiles[slot].key >= 0: world_cache.remove(world_tiles[slot].key)
    if world_tile_job.key == key:
        # (finished here; a contact tile asked for while it was under way is finished at once)
        _ = world_tile_job_rows(world_tile_job,1e30)
        world_tiles[slot] = world_tile_job_finish(world_tile_job,slot)
        world_tile_job = WorldTileJob()
        world_next_level = -1
        world_generate_made += 1
    else: world_tiles[slot] = world_make_tile(x,z,level,slot)
    world_cache[key] = slot
    if world_warming: world_warm_missing -= 1 else: world_view_missing -= 1
    world_generated += 1
    slot

# Shore silhouettes expose the cell spacing; spend one extra level there.
# The atlas/generation caps and canonical height samples remain unchanged.
world_tile_inland = (tx:int,tz:int,level:int) -> bool:
    x,z=world_tile_origin(tx,tz,level);size=world_tile_size(level)
    outside_river=x>f64(RIVER_BOUNDS.z) or x+size<f64(RIVER_BOUNDS.x) or z>f64(RIVER_BOUNDS.w) or z+size<f64(RIVER_BOUNDS.y)
    if lake_touches(x,z,size):return true
    if outside_river:return false
    r=water_at(x+size*0.5,z+size*0.5)
    r.found and r.distance<size*0.71+r.width*3.0

# The canal city's cut (36 m of water between street-high walls) is narrower than a coarse tile's
# cells: there the terrain keeps its finest cells further out, so the cut stays open from the air.
world_tile_canal = (tx:int,tz:int,level:int) -> bool:
    x,z=world_tile_origin(tx,tz,level);size=world_tile_size(level)
    if x>f64(RIVER_BOUNDS.z) or x+size<f64(RIVER_BOUNDS.x) or z>f64(RIVER_BOUNDS.w) or z+size<f64(RIVER_BOUNDS.y):return false
    r=water_at(x+size*0.5,z+size*0.5)
    r.found and r.segment>=CANAL_BEGIN and r.distance<size*0.71+r.width*3.0

world_tile_detail = (node: WorldTile) -> f64:
    # Water coverage belongs to the immutable tile, not the moving camera.
    # Ocean coasts get one extra level; river and lake tiles half a level,
    # which keeps the carved banks and their groves (2x and 1.5x look alike).
    # Canonical contact tiles and sub-cell bank refinement remain unchanged.
    render_quality.terrain_detail*(if node.canal_city:3.0 else:if node.low < 0.0 and node.high > 0.0:2.0 else:if node.inland_water:1.5 else:1.0)

# A cold arrival can leave a country-sized ancestor selected while its
# children stream. Its multi-kilometre triangles connect opposite shores
# above open water. Keep generating it for traversal/balancing, but publish
# mixed coast tiles only once they meet the normal LOD request or their
# samples reach the 896 m geography lattice. This affects fallback arrival,
# not settled LOD, physics, generation budgets or the canonical contact mesh.
world_tile_drawable = (node: WorldTile,cam: vec3) -> bool:
    if node.level <= 6 or node.low >= 0.0 or node.high <= 0.0: return true
    x,z = world_tile_origin(node.x,node.z,node.level)
    size = world_tile_size(node.level)
    world_distance(x,z,size,cam) >= size*world_tile_detail(node)

world_visit = (x: int,z: int,level: int,cam: vec3,planes: vec4[]):
    global world_selected
    ox,oz = world_tile_origin(x,z,level); size = world_tile_size(level)
    if not world_possible_land(ox,oz,size) or not world_tile_visible(ox,oz,size,cam,planes): return
    slot = world_request_tile(x,z,level)
    if slot < 0: return
    distance = world_distance(ox,oz,size,cam)
    if level > 0 and distance < size*world_tile_detail(world_tiles[slot]):
        ready = true
        children: (int,int)[]
        # Visit the camera's nearest quadrant first, so a teleport or landing
        # spends its bounded generation budget on nearby contact tiles first.
        first = (if f64(cam.x) >= ox+size*0.5: 1 else: 0) + (if f64(cam.z) >= oz+size*0.5: 2 else: 0)
        loop order in 0..4:
            quadrant = order xor first
            cx = x*2+(quadrant%2); cz = z*2+(quadrant/2)
            px,pz = world_tile_origin(cx,cz,level-1)
            if not world_possible_land(px,pz,size*0.5) or not world_tile_visible(px,pz,size*0.5,cam,planes): continue
            children.push((cx,cz))
            if world_request_tile(cx,cz,level-1) < 0: ready = false
        if ready:
            loop child in children: world_visit(child.0,child.1,level-1,cam,planes)
            return
    else if level > 0 and not world_warming and distance < size*world_tile_detail(world_tiles[slot])*WORLD_PREFETCH:
        # (its children will be drawn soon: made ahead, once nothing the view needs is waiting,
        # so they are there when it splits and start from its own shape (world_prefetch_tiles))
        loop quadrant in 0..4:
            cx = x*2+(quadrant%2); cz = z*2+(quadrant/2)
            px,pz = world_tile_origin(cx,cz,level-1)
            if world_possible_land(px,pz,size*0.5) and world_tile_visible(px,pz,size*0.5,cam,planes): world_prefetch.push(WorldAhead(world_distance(px,pz,size*0.5,cam),cx,cz,level-1))
    world_selected.push(slot)

# The tiles to make ahead of need: the children of tiles within WORLD_PREFETCH of splitting, the
# nearest first, one at a time in the frame's ordinary slice and only while the view itself has
# every tile it needs. A tile that arrives after its parent should have split has to morph in
# from the parent's shape in view (prepare_world_terrain); made ahead, it is there at the split,
# where its shape is the parent's and nothing moves.
const WORLD_PREFETCH = 1.3
struct WorldAhead:
    away: f64
    x: int
    z: int
    level: int
world_prefetch: WorldAhead[] = []
world_prefetch_tiles = ():
    global world_prefetch,world_view_missing
    if world_view_missing > 0 or world_warm_views.len() > 0: world_prefetch = []; return
    world_prefetch.sort((a: WorldAhead) -> f64: a.away)
    loop a in world_prefetch: _ = world_request_tile(a.x,a.z,a.level)
    # (what is made ahead is not missing from the view)
    world_view_missing = 0
    world_prefetch = []

# Integer base-cell rectangles make adjacency independent of f32 world position.
world_rect = (t: WorldTile) -> (int,int,int): (t.x*(1<<t.level),t.z*(1<<t.level),1<<t.level)
world_neighbor_side = (a: WorldTile,b: WorldTile) -> int:
    ax,az,asize = world_rect(a); bx,bz,bsize = world_rect(b)
    if az < bz+bsize and az+asize > bz:
        if ax == bx+bsize: return 0
        if ax+asize == bx: return 1
    if ax < bx+bsize and ax+asize > bx:
        if az == bz+bsize: return 2
        if az+asize == bz: return 3
    -1

world_side = (ax: int,az: int,asize: int,bx: int,bz: int,bsize: int) -> int:
    if az < bz+bsize and az+asize > bz:
        if ax == bx+bsize: return 0
        if ax+asize == bx: return 1
    if ax < bx+bsize and ax+asize > bx:
        if az == bz+bsize: return 2
        if az+asize == bz: return 3
    -1

# Each round finds the first pair (in selection order) of a tile and an adjacent tile at least
# two levels coarser whose coarser-by-one ancestor is cached, and replaces what that ancestor
# covers with it. A tile so much coarser always covers a whole side of its neighbour (quadtree
# cells nest), so one look at the cell beside each side finds it: four lookups a tile, not a
# comparison with every other selected tile, and the same pair as that full comparison.
world_balance = ():
    global world_selected
    loop balance_round in 0..WORLD_CACHE_SLOTS:
        n = world_selected.len()
        tx: int[]; tz: int[]; tl: int[]
        at: {int: int} = {}
        loop k in 0..n:
            t = world_tiles[world_selected[k]]
            tx.push(t.x); tz.push(t.z); tl.push(t.level)
            at[world_tile_key(t.x,t.z,t.level)] = k
        found_a = -1; found_b = -1
        loop ia in 0..n:
            rs = 1 << tl[ia]; rx = tx[ia]*rs; rz = tz[ia]*rs
            best = -1
            loop side in 0..4:
                cx = if side == 0: rx-1 else: if side == 1: rx+rs else: rx
                cz = if side == 2: rz-1 else: if side == 3: rz+rs else: rz
                if cx < 0 or cz < 0: continue
                # (the selected tile covering that base cell, if any)
                ib = -1
                loop level in tl[ia]+2..WORLD_ROOT_LEVEL+1:
                    if let k = at.get(world_tile_key(cx >> level,cz >> level,level)):
                        ib = k; break
                if ib < 0 or (best >= 0 and ib >= best): continue
                level = tl[ib]-1
                if not (world_tile_key(tx[ia] >> (level-tl[ia]),tz[ia] >> (level-tl[ia]),level) in world_cache): continue
                best = ib
            if best >= 0: found_a = ia; found_b = best; break
        if found_a < 0: break
        level = tl[found_b]-1
        x = tx[found_a] >> (level-tl[found_a]); z = tz[found_a] >> (level-tl[found_a])
        parent = world_cache[world_tile_key(x,z,level)]
        next: int[]
        loop k in 0..n:
            if tl[k] <= level and (tx[k]>>(level-tl[k])) == x and (tz[k]>>(level-tl[k])) == z: continue
            next.push(world_selected[k])
        next.push(parent); world_selected = next

world_coarse = (u: GroundParams,base: vec2,p: vec2,step: f32) -> TerrainSample:
    if fract(p.x/step) == 0.0 and fract(p.y/step) == 0.0: return land_sample(u.heights,u.materials,base+p)
    # (one level coarser, a vertex at a sample lies midway along an edge or the diagonal of
    # that grid: two of its samples, not four. Most morphing vertices are these, and the laptop's
    # GPU pays for every read. Not the vertices between samples, which a tile has along an edge
    # beside finer tiles (src/terrain_lod.jo land_grid_data).)
    if step > 1.5 and step < 3.0 and fract(p.x) == 0.0 and fract(p.y) == 0.0:
        o = vec2(fract(p.x*0.5)*2.0,-fract(p.y*0.5)*2.0)
        return land_mix(land_sample(u.heights,u.materials,base+p-o),land_sample(u.heights,u.materials,base+p+o),0.5)
    a = min(floor(p/step)*step,vec2(16.0-step,16.0-step))
    f = (p-a)/step
    # (the triangle of that grid the vertex lies in: its two corners on the diagonal and the
    # one at its right angle, three samples and not the cell's four)
    lower = f.x+f.y <= 1.0
    kk = land_sample(u.heights,u.materials,base+a+(if lower: vec2(0,0) else: vec2(step,step)))
    bb = land_sample(u.heights,u.materials,base+a+vec2(step,0))
    cc = land_sample(u.heights,u.materials,base+a+vec2(0,step))
    wb = if lower: f.x else: 1.0-f.y
    wc = if lower: f.y else: 1.0-f.x
    TerrainSample(kk.h+wb*(bb.h-kk.h)+wc*(cc.h-kk.h),kk.normal+wb*(bb.normal-kk.normal)+wc*(cc.normal-kk.normal),kk.tint+wb*(bb.tint-kk.tint)+wc*(cc.tint-kk.tint))

# A sample of a map of triples (world_triples) drawn k levels coarser (0 to 2): between its own
# value and the next coarser level's there, or that and the level's after, by the texture's
# filter; and the next coarser level's alone.
# (a vertex between two samples, which a tile has along an edge beside finer tiles: down a
# column the filter gives the value between the rows; along a row the two samples are read apart)
world_morphed = (t: Texture,base: vec2,p: vec2,k: f32) -> vec4:
    size = vec2(texture_size(t))
    left = floor(p.x)
    a = sample_lod(t,vec2((base.x+left)*3.0+0.5+k,base.y+p.y+0.5)/size,0.0)
    if p.x > left: a = mix(a,sample_lod(t,vec2((base.x+left)*3.0+3.5+k,base.y+p.y+0.5)/size,0.0),p.x-left)
    a
world_coarser = (t: Texture,base: vec2,p: vec2) -> vec4: texel(t,ivec2(vec2((base.x+p.x)*3.0+1.0,base.y+p.y)))

# The fields' colour and share at a vertex, morphed between levels with the ground they lie on
# (read at each vertex's own sample whatever the level drawn, a tile's fields changed all at
# once when it split or merged). level: how many levels coarser the vertex is drawn. Within a
# level of the tile's own: its sample, toward the next coarser level's value there
# (beside it in the map, world_triples: at the split or merge exactly what the parent draws),
# and on toward the level's after that (a tile's edge beside a coarser tile is drawn as that
# tile is). More than two levels coarser (a tile just come in, morphing from what was drawn
# before): between that level's samples of the map.
world_working_at = (u: GroundParams,base: vec2,p: vec2,level: f32) -> vec4:
    w = world_morphed(u.working_map,base,p,min(level,2.0))
    if level > 2.0:
        s = pow(2.0,floor(level))
        w = mix(world_working_coarse(u,base,p,s),world_working_coarse(u,base,p,min(s*2.0,16.0)),fract(level))
    w
# The cliff map's station at a vertex, morphed the same way, as the moments a triangle carries
# (cliff_vertex_data): the tile's own, toward the next coarser level's there (beside it,
# world_cliff_coarser); coarser still, between that level's samples.
world_cliff_moments = (station: vec4) -> vec3: vec3(dot(station.xy,vec2(255.0/64.0,65280.0/64.0)),station.z,station.w)
world_cliff_at = (u: GroundParams,base: vec2,p: vec2,level: f32,y: f32) -> vec4:
    # (a station's moments are sums of its bytes, so the filter's value between two stations is
    # the moments between them)
    m = world_cliff_moments(world_morphed(u.cliff_map,base,p,min(level,2.0)))
    if level > 2.0:
        s = pow(2.0,floor(level))
        m = mix(world_cliff_coarse(u,base,p,s),world_cliff_coarse(u,base,p,min(s*2.0,16.0)),fract(level))
    possible = m.z > 0.0 or m.x > (y+2.0)*m.y
    vec4(m.x,m.y,m.z,if possible: 1.0 else: 0.0)
world_cliff_coarse = (u: GroundParams,base: vec2,p: vec2,step: f32) -> vec3:
    if fract(p.x/step) == 0.0 and fract(p.y/step) == 0.0: return world_cliff_moments(world_coarser(u.cliff_map,base,p))
    a = min(floor(p/step)*step,vec2(16.0-step,16.0-step))
    f = (p-a)/step
    bb = world_cliff_moments(world_coarser(u.cliff_map,base,a+vec2(step,0)))
    cc = world_cliff_moments(world_coarser(u.cliff_map,base,a+vec2(0,step)))
    if f.x+f.y <= 1.0:
        aa = world_cliff_moments(world_coarser(u.cliff_map,base,a))
        return aa+(bb-aa)*f.x+(cc-aa)*f.y
    dd = world_cliff_moments(world_coarser(u.cliff_map,base,a+vec2(step,step)))
    dd+(cc-dd)*(1.0-f.x)+(bb-dd)*(1.0-f.y)

# The orchards' cover (x) and the canopy's rise (y) at a vertex, morphed the same way.
world_cover_at = (u: GroundParams,base: vec2,p: vec2,level: f32) -> vec2:
    w = world_morphed(u.cover_map,base,p,min(level,2.0)).xy
    if level > 2.0:
        s = pow(2.0,floor(level))
        w = mix(world_cover_coarse(u,base,p,s),world_cover_coarse(u,base,p,min(s*2.0,16.0)),fract(level))
    w
world_cover_coarse = (u: GroundParams,base: vec2,p: vec2,step: f32) -> vec2:
    if fract(p.x/step) == 0.0 and fract(p.y/step) == 0.0: return world_coarser(u.cover_map,base,p).xy
    a = min(floor(p/step)*step,vec2(16.0-step,16.0-step))
    f = (p-a)/step
    bb = world_coarser(u.cover_map,base,a+vec2(step,0)).xy
    cc = world_coarser(u.cover_map,base,a+vec2(0,step)).xy
    if f.x+f.y <= 1.0:
        aa = world_coarser(u.cover_map,base,a).xy
        return aa+(bb-aa)*f.x+(cc-aa)*f.y
    dd = world_coarser(u.cover_map,base,a+vec2(step,step)).xy
    dd+(cc-dd)*(1.0-f.x)+(bb-dd)*(1.0-f.y)

world_working_coarse = (u: GroundParams,base: vec2,p: vec2,step: f32) -> vec4:
    if fract(p.x/step) == 0.0 and fract(p.y/step) == 0.0: return world_coarser(u.working_map,base,p)
    a = min(floor(p/step)*step,vec2(16.0-step,16.0-step))
    f = (p-a)/step
    bb = world_coarser(u.working_map,base,a+vec2(step,0))
    cc = world_coarser(u.working_map,base,a+vec2(0,step))
    if f.x+f.y <= 1.0:
        aa = world_coarser(u.working_map,base,a)
        return aa+(bb-aa)*f.x+(cc-aa)*f.y
    dd = world_coarser(u.working_map,base,a+vec2(step,step))
    dd+(cc-dd)*(1.0-f.x)+(bb-dd)*(1.0-f.y)

world_vertex = (v: TerrainVertex,inst: WorldInstance,u: GroundParams) -> GroundOut:
    p = v.cell*0.5
    level = inst.state.y
    if p.x == 0.0: level = max(level,inst.edges.x)
    if p.x == 16.0: level = max(level,inst.edges.y)
    if p.y == 0.0: level = max(level,inst.edges.z)
    if p.y == 16.0: level = max(level,inst.edges.w)
    # (up to four levels coarser: the last blends toward one quad a tile, the grid of the tile
    # four levels up)
    level = clamp(level,0.0,3.999)
    s = pow(2.0,floor(level))
    fine = world_coarse(u,inst.texel,p,s)
    sample = fine
    if fract(level) > 0.0: sample = land_mix(fine,world_coarse(u,inst.texel,p,min(s*2.0,16.0)),fract(level))
    local = vec3(inst.origin.x+p.x*inst.state.x,sample.h,inst.origin.y+p.y*inst.state.x)
    absolute = local+u.origin
    curved = local
    curved.y -= world_drop(local.xz-u.cam.xz)
    tint = sample.tint
    tint.w = 1.0-smoothstep(1700.0,2300.0,absolute.y)   # (the treeline: wooded below, bare above)
    # (only the maps the tile has anything in are read)
    maps = inst.state.w
    covers = if fract(floor(maps/2.0)/2.0) >= 0.5: world_cover_at(u,inst.texel,p,level) else: vec2(0,0)
    # (relief_normal.x: the canopy's rise there, for its sheet)
    result=GroundOut(u.view_proj*vec4(curved,1),local,normalize(sample.normal),tint,covers.x,inst.state.z,vec3(covers.y,0,0),ground_riparian(u,absolute.xz,local.y))
    uv=(inst.texel+p+vec2(0.5,0.5))/vec2(texture_size(u.materials))
    result.working=if fract(maps/2.0) >= 0.5: world_working_at(u,inst.texel,p,level) else: vec4(0,0,0,0)
    result.air=land_air_weights(local,u.cam,u.fog,u.land_steps)
    result.wall_sun=cliff_light(sample.normal,local,u)
    result.cliff=if maps >= 4.0: world_cliff_at(u,inst.texel,p,level,local.y) else: vec4(0,0,0,0)
    result.land=dot(normalize(sample.normal),u.land_light.xyz)
    result

world_fragment_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    world_fragment(i, u)

world_fragment = (i: GroundOut,u: GroundParams) -> vec4: world_fragment_at(i,u,1)

# The woods' stand cover at a sample, as the ground shader paints it (terrain.jo ground_surface:
# the summer cover's woody share and the canopy's stand on vegetated ground, less orchards and
# farmed fields): the woods' crowns (src/crowns.jo) stand where the paint draws crowns.
# n: the sample's normal; tx, ty: its materials' tint x and y; share: its field share.
wood_stand = (n: vec3,y: f32,ridge: f32,tx: f32,ty: f32,p: vec2,share: f32,orchard: f32) -> f32:
    wood_cover(n,y,ridge,tx,ty,0.5+(vnoise(p*0.006)-0.5)*0.8,share,orchard,true).x

# ---------------- the woods' canopy ----------------
# A wood is one canopy, not a field of trees. Over the woods' stand cover (the same green the
# ground paints) lies the sheet: the terrain lifted to the floor of the canopy's hollows and
# painted with the crowns' palette, its crowns the painted canopy's crown sheet; on it stand the
# canopy's billows (below), the domes that are its volume. Far off the sheet is flat, the
# ground's own paint; approaching, it grows up into its height over a kilometre, so there is no
# distance where trees arrive. Farther than the sheet stands, a wood's height shows only in its
# outline, and that is drawn on the screen (src/silhouette.jo: the ground and the sheet leave how
# wooded they are in the picture's alpha for it). Past the wood's edge the scattered crowns of
# the stand's thin margin are single crowns (src/crowns.jo crown_wood).
const CANOPY_TOP = 12.0             # (m, the canopy's mean height over the ground inside a wood)
const CANOPY_GROW_FAR = 3400.0      # (beyond, the canopy flat: the ground's paint alone)
const CANOPY_GROW_NEAR = 2300.0     # (nearer, its full height)

# The canopy's height over the ground at a point (absolute xz) for a stand cover: zero at the
# edge, rising over the stand's last tenths to the canopy's height, its top in broad lumps.
# rise: how far the canopy has risen there (wood_cover's y).
canopy_height = (p: vec2,rise: f32) -> f32:
    # (a gentle swell only: the vertices are 14 m apart and more, so anything finer would facet;
    # the canopy's masses are the billows standing on it)
    lumps = 0.84+0.32*vnoise(p/130.0+vec2(17.3,5.1))
    CANOPY_TOP*rise*lumps

# How far the canopy has grown at a distance (0 flat, 1 its full height).
canopy_grow = (d: f32) -> f32:
    g = clamp((CANOPY_GROW_FAR-d)/(CANOPY_GROW_FAR-CANOPY_GROW_NEAR),0.0,1.0)
    g*g*(3.0-2.0*g)

world_shell_vertex = (v: TerrainVertex,inst: WorldInstance,u: GroundParams) -> GroundOut:
    o = world_vertex(v,inst,u)
    absolute = o.world+u.origin
    # (the canopy's rise, baked per sample and morphed between levels with the ground
    # (world_cover_at), carried in orchard; the stand cover there, for its shading, in land: where
    # the canopy has risen at all the stand is closed, the more the higher)
    # (the ground's own values stay as they are: far off the sheet is painted as the ground is)
    d = length(o.world-u.cam)
    # (lifted a little even where it has sunk, so the canopy never fights the ground it lies on)
    lift = canopy_floor(absolute.xz,o.relief_normal.x,d)
    lifted = o.world+vec3(0,lift,0)
    curved = lifted
    curved.y -= world_drop(lifted.xz-u.cam.xz)
    o.pos = u.view_proj*vec4(curved,1)
    o.world = lifted
    o

# The painted crowns on the canopy are the crown sheet at the octave the distance asks for
# (level: log2 of the distance over 250 m; crowns, then the clumps they gather in, then their
# masses). Each coarse cell changes to the next octave at its own distance (its draw), and how
# far it has turned (0 this octave, 1 the next) rises over a sixth of an octave: its pixels go
# over by the shared dither, a few at a time. Changed all at once, a 70 m patch of a far wood
# took another pattern and another outline in one frame.
canopy_octave_turn = (q: vec2,level: f32) -> f32:
    lf = floor(level)
    clamp((fract(level)-hash21(floor(q/(CANOPY_CELL*pow(2.0,lf+1.0))))*0.84)*6.0,0.0,1.0)

world_shell_fragment = (i: GroundOut,u: GroundParams) -> vec4:
    if u.shell.w < 0.0: discard()
    # (the canopy's rise, baked per sample and morphed between levels with the ground
    # (world_cover_at); the stand cover there, for its shading: where the canopy has risen at
    # all the stand is closed, the more the higher)
    rise = i.relief_normal.x
    stand = 0.62+0.33*rise
    d = length(i.world-u.cam)
    q = i.world.xz+u.origin.xz
    span = f32(CANOPY_CELLS)*CANOPY_CELL
    # (the sheet is the floor under the canopy's domes: none where no crown stands, past the
    # wood's edge, where the ground's own paint of the crowns is the canopy)
    if rise < 0.04: discard()
    # (far off, the canopy hands over to the ground's paint of the same crowns by interleaved
    # gradient noise rather than periodic Bayer, so hillsides never show halftone bands)
    ign = fract(52.9829189*fract(dot(i.pos.xy,vec2(0.06711056,0.00583715))))
    if ign >= clamp((CANOPY_GROW_FAR+600.0-d)/600.0,0.0,1.0): discard()
    # the crowns: the painted canopy's crown sheet capped to exact integer octave 2 (36 m clusters,
    # zero IGN octave checkerboard beyond 1.12 km, matching canopy_far_relief's 36 m scale).
    level = clamp(log2(max(d/280.0,1.0)),0.0,2.0)
    lf = floor(level)
    l0 = lf+(if fract(ign+0.5) < canopy_octave_turn(q,level): 1.0 else: 0.0)
    s = sample_lod(u.canopy,q/(span*pow(2.0,l0))+vec2(l0*0.37,l0*0.61),clamp(d*0.00045,0.3,1.3))
    # its edge scalloped by the crowns along it
    if rise+(s.z-0.55)*0.1 < 0.07: discard()
    # light: each crown's rounded normal on the land's, the crowns' tops lit and the hollows
    # between them in shade
    crown = vec3((s.x*2.0-1.0)*1.9,0.40+0.60*s.z,(s.y*2.0-1.0)*1.9)
    nn = normalize(crown+normalize(i.normal)*0.3)
    # (under the domes that have risen there it is the floor of their hollows, deep in shade:
    # under the masses where the canopy has risen, under the crowns from the wood's edge)
    floor = max(billow_emerge(0.0,d,0.5)*clamp((rise-0.3)*4.0,0.0,1.0),billow_emerge(2.0,d,0.5)*clamp((rise-0.06)*10.0,0.0,1.0))
    # (farther off the hollows are a pixel or two between the crowns: less deep, grouped with them)
    grouped = billow_grouped(d)
    # (and past the crowns' reach the masses' cast shadows lie on it: active all the way to the
    # sheet's far handover so relief stays continuous from 4 km down to 500 m)
    cast = clamp((d-480.0)/260.0,0.0,1.0)*u.shell.y
    if cast > 0.0: cast *= billow_shadow(q,rise,u.sun_dir,d)
    ndl = mix(dot(nn,u.sun_dir),dot(nn,u.canopy_light.xyz),u.canopy_light.w*0.75)-floor*mix(0.3,0.12,grouped)-cast*0.68
    occl = (0.14+0.72*s.z+0.08*clamp((stand-CANOPY_EDGE)*4.0,0.0,1.0))*mix(1.0,mix(0.5,0.76,grouped),floor)*(1.0-0.52*cast)
    col = mix(vec3(0.20,0.34,0.19),vec3(0.30,0.42,0.24),fract(s.w*7.13))*mix(1.08,0.75,clamp((stand-0.6)*2.5,0.0,1.0)*0.4)
    c = crown_palette(col,ndl,occl,u.shade,u.sun,mix(0.78,1.0,clamp((300.0-d)/250.0,0.0,1.0)),fwidth(ndl+(occl-0.6)*0.6))
    # (the land's aerial perspective, the ground's own as its vertices carry it. Alpha: one
    # less how wooded the land is for the outline drawn on the screen (src/silhouette.jo), as
    # the ground leaves it (ground_surface): none where the masses stand, which are the wood's
    # outline there, the whole from 2.6 km)
    vec4(apply_land_air(c,u.haze,i.air),1.0-clamp(rise*2.0,0.0,1.0)*clamp((d-1800.0)/800.0,0.0,1.0))

world_shell_fragment_log = (i: GroundOut,u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0/i.pos.w))
    world_shell_fragment(i,u)

world_shell_sh: Shader
world_shell_ready = false
draw_world_shells = (batches: WorldInstance[][],params: GroundParams):
    global world_shell_sh,world_shell_ready
    if not world_shell_ready:
        world_shell_sh = make_shader(world_shader(shader(world_shell_vertex,world_shell_fragment),shader(world_shell_vertex,world_shell_fragment_log)),false)
        world_shell_ready = true
    p = params
    # (timing only: AEGEAN_FOLIAGE_OFF=shellfs its fragments discarded at once)
    # (y: the masses' cast shadows on; AEGEAN_FOLIAGE_OFF=cast for timing)
    p.shell = vec4(0,if foliage_off("cast"): 0.0 else: 1.0,0,if foliage_off("shellfs"): -1.0 else: 0.0)
    loop i in 0..16:
        if batches[i].len() > 0: draw_instanced(world_shell_sh,terrain_grids[16+i],batches[i],p)

# ---------------- the canopy's billows ----------------
# The canopy's volume, built the way a cumulus is: rounded masses standing on one another. Three
# sizes of low dome over the canopy's sheet, each riding the one under it: the wood's broad masses
# (56 m apart), the clumps on them (28 m), and the crowns on those (14 m), every dome its own size
# and height, lit as its own rounded body (its top lit, its foot in the hollow dark); and near the
# eye a crown's own lobes, smaller domes again, growing out of it. They are real geometry: they
# overlap one another from any angle, stand against the sky on a ridge and break the wood's
# outline against the ground. No dome arrives: each rises out of the sheet as the eye nears (the
# masses from 2.6 km, the clumps from 1.05 km, the crowns from 560 m, a crown's lobes from 80 m),
# its top first, so the canopy swells up continuously out of the paint.
# The domes are worked out once, as a terrain tile is made (billow_build, from the tile's own
# samples of the ground and the stand cover: no tree lists); a frame gathers the domes of the
# tiles in view and draws each size in one call.
struct BillowVertex:
    dome: vec3                      # the vertex on the unit dome (y its height, 1 the top); a lobe's: where it sits
    lobe: vec3                      # a lobe's vertex from where it sits, in the dome's unit space (zero: the dome's own)
    turn: f32                       # the angle about the dome's axis of the vertex (a lobe's: of where it sits)
    size: f32                       # a lobe's radius, of the dome's (zero: the dome's own vertex)

struct Billow:
    at: vec4                        # its centre (world x, the ground there, world z), its radius (m)
    form: vec4                      # its height (m), how deep its foot is sunk (m), its size (0 a mass, 1 a clump, 2 a crown), the canopy's swell there
    seed: vec4                      # its three draws (0..1), the canopy's rise at its centre
    lie: vec4                       # the ground's slope under it (x, z, per metre), the rise's slope (x, z, per metre)
    seat: vec4                      # what it stands on, fully grown: the masses (m), the clumps (m); the stand cover; the sheet under it (1; 0: none, it stands on the ground)
    born: vec4                      # when it was made (world_clock, s), where it begins to rise (its distance, m); a crown: the slope (x, z, per metre) of the masses it stands on

const BILLOW_TIERS = 3
const BILLOW_LOBES = 5
const BILLOW_LOBE_END = 120.0      # (beyond, a crown one 12-sided dome: its 5 round 10-sided lobes grow gently over 70 m)
const BILLOW_SHEET = 0.5           # (the sheet's height under grown masses, of the canopy's: their hollows' floor)

billow_span = (tier: f32) -> f32: if tier < 0.5: 56.0 else: if tier < 1.5: 28.0 else: 14.0
billow_reach = (tier: f32) -> f32: if tier < 0.5: 2600.0 else: if tier < 1.5: 1050.0 else: 560.0
# Where the crowns begin to rise, at most: within the finest terrain tiles, which are where they
# are made (billow_build), so a tile's split never brings crowns already risen (the finest tiles
# reach to 448 m times the quality's terrain detail; a crown begins up to 18% farther out by its
# draw).
billow_crown_reach = () -> f32: f32(min(560.0,380.0*render_quality.terrain_detail))

# A cell's dome: its three draws (0..1).
billow_seed = (cell: vec2,tier: f32) -> vec3:
    # (one hash, its 24 bits read three ways)
    h = hash21(cell+vec2(tier*17.0+3.0,tier*29.0+11.0))
    vec3(h,fract(h*256.0),fract(h*65536.0))

# A dome's centre (absolute xz) from its cell and draws.
billow_centre = (cell: vec2,sd: vec3,span: f32) -> vec2: (cell+vec2(0.5,0.5)+(sd.xy-vec2(0.5,0.5))*0.9)*span

# A dome's radius (m), its height over what it stands on (m) and how deep its foot is sunk (m).
billow_shape = (tier: f32,sd: vec3) -> vec3:
    v = fract(sd.z*7.31+sd.x)
    # (no wider than a cell and a half: billow_top looks in the cells about a point)
    if tier < 0.5: return vec3(27.0+15.0*sd.z,3.0+3.0*v,3.0)
    if tier < 1.5: return vec3(12.0+9.0*sd.z,2.5+2.5*v,2.2)
    # (the crowns: rounded, about as high as they are wide across the half that shows)
    r = 4.6+3.8*sd.z
    vec3(r,r*(0.7+0.35*v),1.2)

# How far a dome has risen at a distance over the ground (0 still under the sheet, 1 its full
# height); a crown a little sooner or later than its neighbours by its own draw.
billow_emerge = (tier: f32,d: f32,draw: f32) -> f32: billow_risen(billow_reach(tier)*(0.82+0.36*draw),d)
# The same for a dome that begins to rise at `far` (its born.y).
billow_risen = (far: f32,d: f32) -> f32:
    g = clamp((far-d)/(far*0.42),0.0,1.0)
    g*g*(3.0-2.0*g)

# How far the canopy's light is grouped at a distance (0 near: every dome its own light and its
# own deep hollow; 1 from 500 m: a crown takes most of its light from the mass it stands on, the
# hollows shallow), as a painter groups the values of a far wood by its masses.
billow_grouped = (d: f32) -> f32: clamp((d-120.0)/380.0,0.0,1.0)

# How far a dome's ring under its top has swelled from the far cone's side out to the dome's (0
# at the distance where the cone gives way to the ringed mesh, 1 nearer).
billow_full = (tier: f32,d: f32) -> f32:
    f = if tier > 1.5: clamp((BILLOW_MID_END-d)/130.0,0.0,1.0) else: clamp((BILLOW_CLUMP_END-d)/200.0,0.0,1.0)
    f*f*(3.0-2.0*f)

# How much taller the canopy's sheet stands at a distance (half as tall again from 2 km): far
# off a wood's height must read in its outline against the land behind it and on a ridge.
canopy_far = (d: f32) -> f32: 1.0+0.5*clamp((d-600.0)/1400.0,0.0,1.0)

# The shade the wood's masses cast at a point of its canopy (0 none, 1 full): of the masses that
# stand sunward of it (the cells 22 m and 56 m toward the sun), each a dome whose shadow runs
# from its foot away from the sun, as long as the dome is high over the sun's height (no longer
# than about three times). The masses are where billow_make stands them (the same draws), so
# the shadows lie where the domes are; whether one stands there is judged by the canopy's rise
# at the point. q: the point (absolute xz); rise: the canopy's rise there; d: the eye's distance.
billow_shadow = (q: vec2,rise: f32,sun: vec3,d: f32) -> f32:
    flat = vec2(sun.x,sun.z)
    if dot(flat,flat) < 0.0004: return 0.0
    dir = normalize(flat)
    run = 1.0/max(sun.y,0.32)
    k = billow_k(0.0,rise)*clamp((3100.0-d)/500.0,0.0,1.0)
    if k <= 0.0: return 0.0
    shade: f32 = 0.0
    loop n in 0..2:
        cell = floor((q+dir*(if n == 0: 22.0 else: 56.0))/56.0)
        sd = billow_seed(cell,0.0)
        shape = billow_shape(0.0,sd)
        to = billow_centre(cell,sd,56.0)-q
        along = dot(to,dir)
        aside = abs(to.x*dir.y-to.y*dir.x)
        # (how long its shadow: its height as it stands at that distance)
        long = shape.y*k*billow_far(d)*run
        inside = (1.0-smoothstep(shape.x*0.55,shape.x,aside))*smoothstep(shape.x*0.45,shape.x*0.8,along)*(1.0-smoothstep(shape.x*0.7+long*0.5,shape.x*0.7+long,along))
        shade = max(shade,inside)
    shade

# How much taller the masses and clumps stand at a distance over the ground.
billow_far = (d: f32) -> f32: 1.0+1.7*clamp((d-400.0)/1500.0,0.0,1.0)

# The same for the clumps: half as tall again at most.
billow_far_clump = (d: f32) -> f32: 1.0+0.5*clamp((d-500.0)/800.0,0.0,1.0)

# How far a size's domes have swelled for the canopy's rise at a point: the crowns from the
# wood's edge, the clumps and the masses under them only farther in, where the canopy has risen.
billow_k = (tier: f32,rise: f32) -> f32: clamp((rise-(if tier < 0.5: 0.4 else: if tier < 1.5: 0.22 else: 0.08))*2.6,0.0,1.0)

# The canopy sheet's lift over the ground at a point (m): the canopy's height as grown at that
# distance, lower where the masses have risen off it (it is then the floor of their hollows).
canopy_floor = (p: vec2,rise: f32,d: f32) -> f32:
    canopy_height(p,rise)*canopy_grow(d)*canopy_far(d)*mix(1.0,BILLOW_SHEET,billow_emerge(0.0,d,0.5))+0.6

# A tile's domes, from its 17 x 17 samples (the ground, the stand cover, the canopy's rise; step
# m apart, from ox, oz): for each size (the masses, the clumps, the crowns: a tile of the finest
# level only; the clumps to level 2, the masses to level 3) a list for each of its 4 x 4 blocks
# (size*16+block), so a frame gathers only the blocks in view and in reach. A dome belongs to the
# tile and the block its centre is in.
const BILLOW_BLOCKS = 4
# Each size is made in tiles of one level only, whatever level the terrain draws there, so a
# tile's split or merge never changes a dome: the masses in level-2 tiles (samples 56 m apart),
# the clumps in level-1 tiles (28 m), the crowns in level-0 tiles (14 m), each within the reach
# of tiles of that level. A clump stands on its level-2 ancestor's masses, a crown on its level-1
# and level-2 ancestors' domes (made first: a tile's ancestors are made before it is asked for);
# each dome's ground is the canonical surface under its centre, not the tile's coarser grid.
# The level of the tiles a size of dome is made in.
billow_source_level = (tier: int) -> int: 2-tier
billow_build = (x: int,z: int,level: int,ground: f32[],stand: f32[],rise: f32[]) -> Billow[][]:
    tier = if level == 2: 0 else: if level == 1: 1 else: if level == 0: 2 else: -1
    if tier < 0 or ground.len() != 289 or stand.len() != 289: return [loop i in 0..BILLOW_TIERS*BILLOW_BLOCKS*BILLOW_BLOCKS: []]
    ox,oz = world_tile_origin(x,z,level)
    step = 14.0*f64(1<<level)
    given: Billow[][] = [[],[]]
    loop t in 0..tier:
        up = billow_source_level(t)-level
        if let slot = world_cache.get(world_tile_key(x >> up,z >> up,level+up)):
            if slot < world_billows.len():
                loop list in world_billows[slot]: given[t] += list
    billow_make(ox,oz,step,17,17,ox,oz,step*16.0,tier,tier,1.0,true,ground,stand,rise,given)

# How high a size's domes stand at a point (m over what they stand on, fully grown): the highest
# of the domes about it, each as its vertices have it (the canopy's rise there by its slope from
# the dome's centre). cells: the domes by cell (from cx0, cz0, wide across; a zero radius: none);
# also what that dome stands on itself.
billow_top = (cells: Billow[],cx0: int,cz0: int,wide: int,tier: f32,q: vec2) -> vec2:
    span = billow_span(tier)
    cx = int(floor(q.x/span))-cx0; cz = int(floor(q.y/span))-cz0
    best = vec2(0,0)
    loop j in max(cz-1,0)..min(cz+2,cells.len()/wide):
        loop i in max(cx-1,0)..min(cx+2,wide):
            b = cells[j*wide+i]
            if b.at.w <= 0.0: continue
            to = q-b.at.xz
            r = length(to)/b.at.w
            if r >= 1.0: continue
            k = billow_k(tier,clamp(b.seed.w+dot(b.lie.zw,to),0.0,1.0))
            h = (sqrt(1.0-r*r)*(b.form.x+b.form.y)-b.form.y)*k
            if h+b.seat.x > best.x+best.y: best = vec2(b.seat.x,h)
    best

# The domes of a square of land (ox, oz, size) from a grid of samples over it (from gx, gz,
# step m apart, nx by nz): the sizes from `first` to `last` (0 the masses, 1 the clumps, 2 the
# crowns). given: the masses and the clumps already made about it (by their own tiles), to stand
# the smaller on; where none are given they are worked out here from this grid. surface: each
# dome's ground the canonical surface (the new world) rather than the grid's.
# A mass or a clump stands only where the wood covers its middle (a small wood has none: its
# crowns stand on the sheet); a clump stands on the masses under its centre, a crown on whatever
# dome is highest under its own. sheet: 1 where the canopy's sheet lies under them; 0 where
# there is none (the old islands) and they stand on the ground.
billow_make = (gx: f64,gz: f64,step: f64,nx: int,nz: int,ox: f64,oz: f64,size: f64,first: int,last: int,sheet: f32,surface: bool,ground: f32[],stand: f32[],rise: f32[],given: Billow[][]) -> Billow[][]:
    out: Billow[][] = [loop i in 0..BILLOW_TIERS*BILLOW_BLOCKS*BILLOW_BLOCKS: []]
    at = (g: f32[],x: f64,z: f64) -> f32:
        fx = clamp((x-gx)/step,0.0,f64(nx)-1.001); fz = clamp((z-gz)/step,0.0,f64(nz)-1.001)
        i = int(fx); j = int(fz); a = f32(fx-f64(i)); b = f32(fz-f64(j))
        mix(mix(g[j*nx+i],g[j*nx+i+1],a),mix(g[(j+1)*nx+i],g[(j+1)*nx+i+1],a),b)
    absent = Billow(vec4(0,0,0,0),vec4(0,0,0,0),vec4(0,0,0,0),vec4(0,0,0,0),vec4(0,0,0,0),vec4(0,0,0,0))
    crowns = billow_crown_reach()
    # (the larger sizes' domes by cell, a margin of two cells about the square: what the smaller stand on)
    under: Billow[][] = [[],[]]
    from: int[] = [0,0,0,0]
    wide: int[] = [1,1]
    loop t in 0..last+1:
        tier = f32(t)
        span = f64(billow_span(tier))
        cx0 = int(floor(ox/span))-2; cz0 = int(floor(oz/span))-2
        cx1 = int(floor((ox+size)/span))+3; cz1 = int(floor((oz+size)/span))+3
        if t < 2: from[t*2] = cx0; from[t*2+1] = cz0; wide[t] = cx1-cx0
        if t < first and given[t].len() > 0:
            # (the domes made by their own tiles, by cell)
            cells: Billow[] = [loop k in 0..(cx1-cx0)*(cz1-cz0): absent]
            loop b in given[t]:
                bx = int(floor(b.at.x/f32(span)))-cx0; bz = int(floor(b.at.z/f32(span)))-cz0
                if bx >= 0 and bz >= 0 and bx < cx1-cx0 and bz < cz1-cz0: cells[bz*(cx1-cx0)+bx] = b
            under[t] = cells
            continue
        loop cz in cz0..cz1:
            loop cx in cx0..cx1:
                cell = vec2(f32(cx),f32(cz))
                sd = billow_seed(cell,tier)
                c = billow_centre(cell,sd,f32(span))
                x = f64(c.x); z = f64(c.y)
                inside = x >= ox and x < ox+size and z >= oz and z < oz+size
                # (a crown is no one's footing: only the square's own)
                if t == 2 and not inside: continue
                shape = billow_shape(tier,sd)
                up = at(rise,x,z)
                cover = at(stand,x,z)
                # (the slopes over the dome's width: of the ground, and of the canopy's rise)
                w = f64(shape.x*0.6)
                slope = vec2(at(ground,x+w,z)-at(ground,x-w,z),at(ground,x,z+w)-at(ground,x,z-w))/f32(2.0*w)
                rising = vec2(at(rise,x+w,z)-at(rise,x-w,z),at(rise,x,z+w)-at(rise,x,z-w))/f32(2.0*w)
                radius = shape.x; tall = shape.y
                seat = vec2(0,0)
                lean = vec2(0,0)
                made = true
                if t == 2:
                    k = billow_k(tier,up)
                    # (a crown in seven missing: a gap in the canopy, the hollow under it showing)
                    if cover < CANOPY_EDGE or k <= 0.0 or fract(sd.z*13.7+sd.y) < 0.14: continue
                    # (a crown is a crown down to the wood's edge, only smaller there: the canopy
                    # under it is what steps down)
                    radius *= 0.68+0.32*k
                    tall *= 0.5+0.5*k
                    # (on the highest dome under it: a clump and what the clump stands on, or a mass)
                    on = billow_top(under[1],from[2],from[3],wide[1],1.0,c)
                    low = billow_top(under[0],from[0],from[1],wide[0],0.0,c)
                    seat = if on.x+on.y >= low.y: on else: vec2(low.y,0)
                    # (the slope of what it stands on, over 16 m: the light of the mass it belongs to)
                    loop side in 0..4:
                        q = c+(if side == 0: vec2(8,0) else: if side == 1: vec2(-8,0) else: if side == 2: vec2(0,8) else: vec2(0,-8))
                        a = billow_top(under[1],from[2],from[3],wide[1],1.0,q)
                        b0 = billow_top(under[0],from[0],from[1],wide[0],0.0,q)
                        h = max(a.x+a.y,b0.y)/16.0
                        if side == 0: lean.x += h
                        if side == 1: lean.x -= h
                        if side == 2: lean.y += h
                        if side == 3: lean.y -= h
                else:
                    # (where the canopy has risen all about its middle)
                    least = min(up,min(min(at(rise,x+w,z),at(rise,x-w,z)),min(at(rise,x,z+w),at(rise,x,z-w))))
                    made = billow_k(tier,least) > 0.0
                    if made and t == 1:
                        seat = vec2(billow_top(under[0],from[0],from[1],wide[0],0.0,c).y,0)
                        # (the slope of the mass it stands on, over 24 m: its light far off)
                        lean = vec2(billow_top(under[0],from[0],from[1],wide[0],0.0,c+vec2(12,0)).y-billow_top(under[0],from[0],from[1],wide[0],0.0,c-vec2(12,0)).y,billow_top(under[0],from[0],from[1],wide[0],0.0,c+vec2(0,12)).y-billow_top(under[0],from[0],from[1],wide[0],0.0,c-vec2(0,12)).y)/24.0
                if not made:
                    if t < 2: under[t].push(absent)
                    continue
                h = if surface: f32(world_source_surface(x,z)) else: at(ground,x,z)
                far = if t == 2: crowns*(0.82+0.36*sd.y) else: billow_reach(tier)
                b = Billow(vec4(c.x,h,c.y,radius),vec4(tall,shape.z,tier,0.84+0.32*vnoise(c/130.0+vec2(17.3,5.1))),vec4(sd,up),vec4(slope,rising),vec4(seat,cover,sheet),vec4(f32(world_clock),far,lean))
                if t < 2: under[t].push(b)
                if inside and t >= first:
                    which = (t*BILLOW_BLOCKS+min(int((z-oz)/size*f64(BILLOW_BLOCKS)),BILLOW_BLOCKS-1))*BILLOW_BLOCKS+min(int((x-ox)/size*f64(BILLOW_BLOCKS)),BILLOW_BLOCKS-1)
                    out[which].push(b)
    out

billow_vertex = (v: BillowVertex,b: Billow,u: GroundParams) -> GroundOut:
    gone = GroundOut(vec4(0,0,-2,1),vec3(0,0,0),vec3(0,1,0),vec4(0,0,0,0))
    tier = b.form.z
    crown = if tier > 1.5: 1.0 else: 0.0
    sd = b.seed.xyz
    local = b.at.xz-u.origin.xz
    # (a dome rises by its distance over the ground: the same measure the tiles' detail goes by)
    reach = length(local-u.cam.xz)
    # (and a dome of a tile made late, after the eye was already near, grows in over half a second)
    e = billow_risen(b.born.y,reach)*clamp((u.time-b.born.x)*2.0,0.0,1.0)
    if e <= 0.0: return gone
    # (a near crown's lobes grow gently out of it over 70 m as the eye nears, each to its own size)
    lobed = if v.size > 0.0: 1.0 else: 0.0
    lf = clamp((BILLOW_LOBE_END-reach)/70.0,0.0,1.0)
    lobes = lf*lf*(3.0-2.0*lf)
    grown = lobed*lobes*(0.78+0.30*fract(sd.z*31.0+v.turn*3.3+v.dome.y*5.1))
    # (near/mid crowns use true-spherical 12-sided 3-ring domes and 5 protruding 10-sided 3-ring
    # lobes with fixed 3D object-space organic sculpting; morph the 3-ring dome's rings smoothly from
    # the 8-sided 2-ring frustum across BILLOW_CUT_END=250..190 m so there is zero volume pop, and
    # gently tuck the core dome under the growing lobes over 120..50 m so crowns read multi-lobed)
    env_dome = mix(1.0,0.88,lobes*u.shell.x*(1.0-lobed))
    unit = v.dome*env_dome+v.lobe*grown
    if crown > 0.5 and lobed < 0.5:
        mf = clamp((BILLOW_CUT_END-reach)/60.0,0.0,1.0)
        if v.dome.y > 0.85 and v.dome.y < 0.99:
            m0 = mix(0.62,1.0,mf)
            unit = vec3(unit.x*m0,unit.y,unit.z*m0)
        else if v.dome.y > 0.45 and v.dome.y < 0.74:
            m1 = mix(0.913,1.0,mf)
            unit = vec3(unit.x*m1,unit.y,unit.z*m1)
    # (a dome is drawn as a cone far off (billow_mesh) and with a ring under its top nearer: that
    # ring starts on the cone's side where the meshes change and swells out to the dome's as the
    # eye nears, so no dome grows fuller at once)
    if lobed < 0.5 and v.dome.y > 0.5 and v.dome.y < 0.99: unit.y = mix(1.0-length(v.dome.xz),v.dome.y,billow_full(tier,reach))
    # (no two alike: turned about its axis by its draw, organic 2-, 3- and 5-lobe sculpting below
    # Nyquist for 12-sided near crowns so silhouettes stay round and fixed in 3D object space)
    a = sd.x*TAU
    ca = cos(a); sa = sin(a)
    long = 1.0+0.38*(sd.y-0.5)*crown
    th = v.turn
    lobe = 0.5+0.24*sin(2.0*th+sd.x*40.0)+0.18*sin(3.0*th+sd.y*40.0)+0.10*sin(5.0*th+sd.z*40.0)*crown
    ring = if v.dome.y < 0.99: 1.0 else: 0.0
    wide = 1.0+(lobe-0.5)*mix(0.08,0.24,crown)*ring
    lean = (vec2(fract(sd.x*97.0),fract(sd.y*61.0))-vec2(0.5,0.5))*0.42*crown
    turned = vec2(unit.x*long*ca-unit.z/long*sa,unit.x*long*sa+unit.z/long*ca)
    off = (turned*wide+lean*mix(unit.y,v.dome.y,lobed))*b.at.w
    # (a crown is one body on the ground's slope; a mass lies over the land as the canopy does,
    # swelling up out of the sheet where the canopy has risen and lying back into it toward the
    # wood's edge: the rise under each of its vertices, by its slope from the centre's)
    rise = clamp(b.seed.w+dot(b.lie.zw,off)*(1.0-crown),0.0,1.0)
    k = mix(billow_k(tier,rise),1.0,crown)
    ground = b.at.y+dot(b.lie.xy,off)
    d = length(vec3(local.x+off.x,ground,local.y+off.y)-u.cam)
    # (what it stands on: the sheet, and the larger sizes' domes as they stand there)
    base = ground+CANOPY_TOP*rise*b.form.w*canopy_grow(d)*canopy_far(d)*mix(1.0,BILLOW_SHEET,billow_emerge(0.0,d,0.5))*b.seat.w+0.6
    # (far off the masses and clumps stand taller, up to twice: a few metres of relief are
    # nothing at a kilometre and a half, and it is there they must carry the wood's volume;
    # nearer they settle to their size under the crowns)
    far = billow_far(reach)
    # (the clumps less: small and many, their tall far cones were most of a far wood's shimmer)
    far_clump = billow_far_clump(reach)
    if tier > 0.5: base += b.seat.x*billow_emerge(0.0,reach,0.5)*far
    if tier > 1.5: base += b.seat.y*billow_emerge(1.0,reach,0.5)*far_clump
    if tier > 0.5: far = far_clump
    tall = b.form.x*k
    high = (b.form.x+b.form.y)*e*(1.0+0.10*sin(2.0*th+sd.z*40.0)*(1.0-v.dome.y))
    # (where a mass lies flat it goes well under the sheet: its ground and the canopy's rise
    # there are reckoned along a line from its centre, a metre or two out on rough land)
    y = base+mix((v.dome.y*(b.form.x+b.form.y)-b.form.y)*k*e*far-0.3-3.0*(1.0-clamp(k*4.0,0.0,1.0)),unit.y*high-b.form.y,crown)
    world = vec3(local.x+off.x,y,local.y+off.y)
    curved = world
    curved.y -= world_drop(world.xz-u.cam.xz)
    # (a lobe is lit as its own rounded body: its normal out from where it sits, its foot in the
    # crease between it and its neighbours)
    sat = normalize(v.dome)
    own = normalize(v.lobe*2.2+sat*0.3)
    form = mix(vec3(unit.x,v.dome.y*0.85+0.25,unit.z),own,lobed)
    spun = vec2(form.x*ca-form.z*sa,form.x*sa+form.z*ca)
    # (tint: its draw (its turn), how much longer than wide it is drawn, its tone's draw, its size
    # (and 10 more where no sheet lies under it: it stands on the ground))
    o = GroundOut(u.view_proj*vec4(curved,1),world,normalize(vec3(spun.x,form.y,spun.y)),vec4(sd.x,long,sd.z,tier+(if b.seat.w < 0.5: 10.0 else: 0.0)))
    # (the vertex on the unit dome, uninflated, so 3D object-space tufts stay fixed across distance)
    o.relief_normal = vec3(turned.x,unit.y,turned.y)
    # (the rounded body the vertex belongs to, for its outline as the eye sees it: the dome,
    # about the middle of its foot, or a lobe, about where it sits; its radius across, and in
    # working.z its radius upward — uninflated true radii so the cut stays strictly inside the mesh)
    sit = vec2(v.dome.x*long*ca-v.dome.z/long*sa,v.dome.x*long*sa+v.dome.z/long*ca)
    sit_off = (sit*wide+lean*v.dome.y)*b.at.w*lobed
    middle = vec3(local.x+sit_off.x,y-unit.y*high+v.dome.y*high*lobed+dot(b.lie.xy,sit_off-off),local.y+sit_off.y)
    across = b.at.w*mix(1.0,v.size*max(grown,0.05),lobed)
    upward = (b.form.x+b.form.y)*e*mix(1.0,v.size*max(grown,0.05),lobed)
    o.cliff = vec4(middle,across)
    # (x: the outline's lobe or crease there; y: how far a lobe has grown; z: the body's radius
    # upward; w: the dome's radius)
    o.working = vec4(mix(1.0,lobe,ring),lobed*clamp(grown*2.0,0.0,1.0),max(upward,0.3),b.at.w)
    # (x: how wide the dome's outline is there, of its radius; y: how far the lobes of a near
    # crown have grown over its dome)
    o.air = vec2(mix(wide,1.0,lobed),lobes*u.shell.x)
    o.land = b.seat.z
    # (the light of the mass a crown stands on: the slope of what is under it, on the ground's)
    group = normalize(vec3(-(b.born.z+b.lie.x),1.0,-(b.born.w+b.lie.y)))
    o.orchard = mix(dot(group,normalize(u.sun_dir)),dot(group,u.canopy_light.xyz),u.canopy_light.w*0.6)
    o.wall_sun = mix(v.dome.y,clamp(dot(v.lobe,sat)/0.4,0.0,1.0)*(0.5+0.5*sat.y),o.working.y)
    # (how far it has swelled there: a mass is not drawn where it lies flat)
    o.tile_level = k
    o.river = land_aerial_terms(world,u.cam,u.fog,u.land_steps)
    o

# cutting: 1 the outline cut (crowns near enough for their scallops and leaves); 0 none, a shader
# with no discard, so the GPU tests depth before shading and a dome hidden by nearer ones costs
# nothing (the masses, the clumps and the far crowns, which are mostly hidden).
billow_fragment_at = (i: GroundOut,u: GroundParams,cutting: int,masses: int = 0,banded: int = 0) -> vec4:
    d = length(i.world-u.cam)
    q = i.world.xz+u.origin.xz
    span = f32(CANOPY_CELLS)*CANOPY_CELL
    if cutting == 1 and u.shell.w < 0.0: discard()
    on_ground = i.tint.w > 5.0
    tier = if on_ground: i.tint.w-10.0 else: i.tint.w
    stand = i.land
    # (a mass lying flat lies under the sheet: with no cut, hidden there)
    if cutting == 1 and i.tile_level < 0.04: discard()
    # (the crowns painted on a mass: the sheet's, at the octave the distance asks for, as on the sheet)
    # (a crown-sized dome is the crown: no painted crowns on it)
    # (banded: the near crowns' own shaders draw crowns only: what a mass or a clump asks for,
    # the sheet's painted crowns and the masses' cast shadows, is not compiled into them. In the
    # shader every dome shares, the laptop's GPU ran those short branches for a crown's pixel too)
    own = if banded == 1: 1.0 else: if tier > 1.5: 1.0 else: 0.0
    s = vec4(0.5,0.5,0.8,0.5)
    if banded == 0 and own < 0.5:
        level = clamp(log2(max(d/280.0,1.0)),0.0,2.0)
        lf = floor(level)
        ign = fract(52.9829189*fract(dot(i.pos.xy,vec2(0.06711056,0.00583715))))
        l0 = lf+(if ign < canopy_octave_turn(q,level): 1.0 else: 0.0)
        s = sample_lod(u.canopy,q/(span*pow(2.0,l0))+vec2(l0*0.37,l0*0.61),clamp(d*0.00045,0.3,1.3))
    near = clamp((170.0-d)/70.0,0.0,1.0)
    body = normalize(i.normal)
    up = i.wall_sun
    # (what stands on this dome, once risen, hides it: it is then the floor of their hollows, the
    # crowns painted on it given way to the real ones; so is a near crown's dome under its lobes)
    above = if banded == 1 or tier > 1.5: i.air.y*(1.0-i.working.y) else: billow_emerge(tier+1.0,d,0.5)
    if banded == 0 and own < 0.5 and above > 0.0:
        s = mix(s,vec4(0.5,0.5,0.65,0.5),clamp(above*1.2,0.0,1.0))
    crown = vec3((s.x*2.0-1.0)*1.9,0.40+0.60*s.z,(s.y*2.0-1.0)*1.9)
    # (far off a mass keeps crisp sunlit/shaded furry canopy texture over its rounded body so
    # 800..2600 m wooded hills read as a plush 3D canopy carpet instead of flat cones)
    massy = if banded == 1: 0.0 else: (if tier < 0.5: 1.0 else: 0.0)*clamp((d-500.0)/700.0,0.0,1.0)
    nn = normalize(body*mix(mix(0.85,1.35,own),1.05,massy)+crown*mix(0.82,0.62,massy)*(1.0-max(own,above)*0.72))
    # Seamless 3D object-space leaf tufts (crown_oct_tex, zero cube-face seams, camera-invariant):
    # only compiled into near/cut crown shaders (banded == 1); far solid domes skip it completely.
    mass: f32 = 0.65
    tuft: f32 = 0.5
    hn = normalize(i.relief_normal+vec3(0,0.05,0))
    seed = i.tint.x
    # Clamp world-space pixel footprint to the screen-space angular bound so grazing silhouette
    # triangles can never explode foot.
    foot = clamp(length(vec3(fwidth(i.world.x),fwidth(i.world.y),fwidth(i.world.z))),0.0001,max(d*0.0035,0.01))
    spans = i.working.w/foot
    # Smooth banded transition over 80..220 m (zero at BILLOW_CUT_END=250 m for seamless handover)
    band = if banded == 1: own*clamp((220.0-d)/140.0,0.0,1.0)*clamp((spans-10.0)/16.0,0.0,1.0) else: 0.0
    ang = seed*TAU
    ca = cos(ang); sa = sin(ang)
    yflip: f32 = if fract(seed*7.31) > 0.5: -1.0 else: 1.0
    hnr = vec3(hn.x*ca-hn.z*sa,hn.y*yflip,hn.x*sa+hn.z*ca)
    c_tuft = hn
    tuft_far: f32 = CROWN_OCT_MAX
    if banded == 1:
        t_oct = sample(u.pigment,crown_oct_encode(hnr))
        cr = normalize(t_oct.xyz*2.0-vec3(1,1,1))
        tuft_far = length(hnr-cr)
        if band > 0.0:
            c_tuft = vec3(cr.x*ca+cr.z*sa,cr.y*yflip,-cr.x*sa+cr.z*ca)
        if near > 0.0:
            tuft = mix(0.5,1.0-clamp((tuft_far-0.07)/0.14,0.0,1.0),near)
    outline = if cutting == 1: clamp((BILLOW_CUT_END-d)/80.0,0.0,1.0)*clamp((spans-5.0)/10.0,0.0,1.0) else: 0.0
    if cutting == 1 and (banded == 1 or own > 0.5):
        # Rounded 3D ellipsoid outline strictly inside the inflated dome/lobe mesh: removes all
        # octagonal and pentagonal corners, with 3D object-space leaf-tuft scallops fixed to hnr.
        lng = i.tint.y
        inv = vec3(1.0/(i.cliff.w*lng),1.0/i.working.z,lng/i.cliff.w)
        f0 = u.cam-i.cliff.xyz; r0 = i.world-u.cam
        from = vec3(f0.x*ca+f0.z*sa,f0.y,f0.z*ca-f0.x*sa)*inv
        ray = vec3(r0.x*ca+r0.z*sa,r0.y,r0.z*ca-r0.x*sa)*inv
        closest = from-ray*(dot(from,ray)/dot(ray,ray))
        edge = dot(closest,closest)/(i.air.x*i.air.x)
        if outline > 0.0 and edge > mix(0.52,0.44,u.shell.z):
            px = i.cliff.w/foot
            dith = crown_dither(i.pos.xy)
            lump = crown_macro_r(hnr,seed)-0.86
            arc = sqrt(max(CROWN_OCT_ROUND*CROWN_OCT_ROUND-tuft_far*tuft_far,0.0))/CROWN_OCT_ROUND
            down = clamp((u.cam.y-i.world.y)/max(d,1.0)*3.0,0.0,1.0)
            dome_cut = mix(1.0,0.84+0.45*lump+0.09*arc*clamp((200.0-d)/80.0,0.0,1.0),outline*max(clamp(up*2.5+0.15,0.0,1.0),down))
            lobe_cut = 0.72+0.4*lump+0.16*arc
            cut = mix(dome_cut,lobe_cut,u.shell.z)
            if (cut-sqrt(edge))*px < dith-0.5: discard()
    else if cutting == 1:
        v = normalize(i.world-u.cam)
        ndv = dot(body,v)
        turn = 1.0-ndv*ndv
        if outline > 0.0 and turn > 0.5:
            lump = crown_macro_r(hnr,seed)-0.86
            if turn > mix(1.0,0.78+0.6*lump,outline): discard()
    # Unified crown-form lighting: smooth transition from banded near crowns to grouped mid/far masses
    light = mix(u.sun_dir,u.canopy_light.xyz,u.canopy_light.w*0.6)
    lightness = dot(nn,light)
    grouped = billow_grouped(d)
    lightness = mix(lightness,i.orchard*0.7+lightness*0.3,grouped*(if tier > 0.5: 1.0 else: 0.0))
    if band > 0.0:
        nb = normalize(vec3(i.relief_normal.x,max(i.relief_normal.y,0.0)+0.2,i.relief_normal.z))
        nc = normalize(vec3(c_tuft.x,max(c_tuft.y,0.0)+0.2,c_tuft.z))
        whole = dot(nb,light)
        tuft_whole = dot(nc,light)
        inside = clamp((CROWN_OCT_ROUND-tuft_far)*spans+0.5,0.0,1.0)
        # Luminance-matched three-band leaf-tuft shading: keeps the same mean brightness as
        # mid/far billows so flying closer has no darkening cliff while keeping crisp sunlit caps.
        b_behind = (whole-0.14)*1.52-0.19
        b_tuft = (tuft_whole-0.14)*1.52+0.09
        lightness = mix(lightness,b_behind+inside*max(b_tuft-b_behind,0.0),band)
    # (and the shadows of the masses sunward of it, on a mass or a clump past the crowns' reach)
    cast = if banded == 1: 0.0 else: (1.0-own)*clamp((d-480.0)/260.0,0.0,1.0)*u.shell.y
    if banded == 0 and cast > 0.0: cast *= billow_shadow(q,i.tile_level*0.385+(if tier < 0.5: 0.4 else: 0.22),u.sun_dir,d)
    ndl = lightness+0.055*(1.0-band)-cast*0.5-(1.0-mass)*0.08*(1.0-band)-above*mix(0.24,0.12,grouped)*(1.0-band)+0.06*(1.0-own)*clamp((260.0-d)/120.0,0.0,1.0)
    # (the dome's top open to the sky, its foot down in the hollow between its neighbours)
    open = clamp(up*1.5-0.1,0.0,1.0)
    occl = (mix(0.22,0.38,grouped)+mix(0.78,0.62,grouped)*open)*mix(0.58+0.42*s.z,0.84+0.16*s.z,own)*(0.78+0.22*mass)*1.10*mix(mix(1.0,0.9+0.1*tuft,near)*(0.80+0.20*i.working.x),0.90,band)*(1.0-mix(0.42,0.22,grouped)*above*(1.0-band))*(1.0-0.4*cast)
    # (a crown its own green: the wood's range from a dark pine green to a lighter olive; smooth out
    # bilinear s.w wrapping when real crowns stand overhead so shaded hollows show zero contour rings)
    tone = mix(mix(fract(s.w*7.13),0.5,clamp(above*1.2,0.0,1.0)),i.tint.z,own)
    col = mix(vec3(0.17,0.31,0.18),vec3(0.33,0.43,0.22),tone)*mix(1.08,0.75,clamp((stand-0.6)*2.5,0.0,1.0)*0.4)
    # (far off a mass's foot is painted as the sheet it stands in is (the same crowns, the same
    # light): its outline against the sheet is then nowhere, and only its risen body reads. A
    # hard line round every mass's foot crawled as the eye moved: a quarter of a far wood's
    # shimmer seen from high up. masses: 1 in the masses' own shader only: in the shader every
    # dome shares this cost each crown's pixel its work too (the laptop's GPU runs both sides of
    # a short branch))
    if masses == 1 and tier < 0.5:
        foot = (1.0-smoothstep(0.02,0.45,up))*clamp((d-450.0)/200.0,0.0,1.0)
        if foot > 0.0:
            ns = normalize(crown+vec3(0,0.3,0))
            ndl = mix(ndl,mix(dot(ns,u.sun_dir),dot(ns,u.canopy_light.xyz),u.canopy_light.w*0.6)-mix(0.3,0.1,grouped)-cast*0.55,foot)
            occl = mix(occl,(0.28+0.66*s.z)*mix(0.5,0.78,grouped)*(1.0-0.45*cast),foot)
            col = mix(col,mix(vec3(0.20,0.34,0.19),vec3(0.30,0.42,0.24),fract(s.w*7.13))*mix(1.08,0.75,clamp((stand-0.6)*2.5,0.0,1.0)*0.4),foot)
    # (and some crowns of another kind: one in eight a dark pine, one in ten a pale olive, so a
    # far wood is a texture of different trees, not one green)
    kind = fract(i.tint.x*13.7)
    col = mix(col,vec3(0.11,0.25,0.17),own*step(kind,0.125)*0.75)
    col = mix(col,vec3(0.37,0.45,0.23),own*step(0.9,kind)*0.7)
    # (two branches, not one with an else: so written, the laptop's GPU ran both sides for
    # every pixel of a mainland wood)
    c = vec3(0,0,0)
    if on_ground:
        # (a dome that stands on the ground, among the ground's own painted crowns (the old
        # islands' small woods): the colour and the gentler light of that paint, so it is one
        # of them stood up, not a brighter thing among them)
        paint = mix(mix(vec3(0.20,0.34,0.19),vec3(0.30,0.42,0.24),tone),vec3(0.11,0.27,0.17),clamp((stand-0.6)*2.5,0.0,1.0)*0.4)
        c = mix(crown_palette(paint,ndl,occl,u.shade,u.sun,1.0),crown_palette(paint,0.2,0.75,u.shade,u.sun,1.0),0.55)*vec3(0.94,0.92,1.12)
    if not on_ground:
        sharp_far = mix(mix(0.68,0.84,massy),mix(0.55,1.0,own),clamp((300.0-d)/250.0,0.0,1.0))*(1.0-above*(1.0-own)*0.7)
        c = crown_palette(col,ndl,occl,u.shade,u.sun,mix(0.3,1.0,clamp((spans-3.0)/12.0,0.0,1.0))*sharp_far,fwidth(ndl+(occl-0.6)*0.6),band)
        # (against the light, a dome's outline glows where the sun comes through its leaves; all
        # round, a little of the sky's light on its edge: the form turning away)
        view = normalize(i.world-u.cam)
        turned = 1.0-abs(dot(body,view))
        back = clamp(dot(view,normalize(u.sun_dir)),0.0,1.0)
        c += col*u.sun*(0.55*back*back*turned*turned*turned*(0.4+0.6*open))+u.sky*(0.05*turned*turned*open)
    vec4(land_aerial_apply(c,i.river,u.haze)*paint_paper(i.pos.xy),1)

billow_fragment = (i: GroundOut,u: GroundParams) -> vec4: billow_fragment_at(i,u,1)
billow_fragment_solid = (i: GroundOut,u: GroundParams) -> vec4: billow_fragment_at(i,u,0)
billow_fragment_solid_log = (i: GroundOut,u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0/i.pos.w))
    billow_fragment_at(i,u,0)

billow_fragment_mass = (i: GroundOut,u: GroundParams) -> vec4: billow_fragment_at(i,u,0,1)
billow_fragment_mass_log = (i: GroundOut,u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0/i.pos.w))
    billow_fragment_at(i,u,0,1)

billow_fragment_log = (i: GroundOut,u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0/i.pos.w))
    billow_fragment(i,u)

# (the near crowns', lit in flat bands: their lobes, cut, and the domes under them, whole)
billow_fragment_near = (i: GroundOut,u: GroundParams) -> vec4: billow_fragment_at(i,u,1,0,1)
billow_fragment_near_log = (i: GroundOut,u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0/i.pos.w))
    billow_fragment_at(i,u,1,0,1)
billow_fragment_near_solid = (i: GroundOut,u: GroundParams) -> vec4: billow_fragment_at(i,u,0,0,1)
billow_fragment_near_solid_log = (i: GroundOut,u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0/i.pos.w))
    billow_fragment_at(i,u,0,0,1)

# The domes' mesh: a top vertex and its rings (one to three), each ring turned half a step from
# the last; a near crown's with its lobes, which are drawn first (they hide most of the dome
# under them, which then is never shaded).
billow_mesh = (seg: int,rings: int,lobed: bool = false,whole: bool = true) -> Mesh:
    vs: BillowVertex[]
    ids: u32[]
    body: u32[]
    rr: f32[] = if rings == 1: [1.0,1.0,1.0] else: if rings == 2: [0.62,1.0,1.0] else: [0.38,0.74,0.98]
    yy: f32[] = if rings == 1: [0.0,0.0,0.0] else: if rings == 2: [0.785,0.0,0.0] else: [0.925,0.67,0.0]
    none3 = vec3(0,0,0)
    vs.push(BillowVertex(vec3(0,1,0),none3,0.0,0.0))
    loop k in 0..rings:
        loop m in 0..seg:
            a = (f32(m)+0.5*f32(k))*f32(TAU)/f32(seg)
            vs.push(BillowVertex(vec3(cos(a)*rr[k],yy[k],sin(a)*rr[k]),none3,a,0.0))
    loop m in 0..seg:
        m1 = (m+1)%seg
        body.push(u32(0)); body.push(u32(1+m1)); body.push(u32(1+m))
        loop k in 0..rings-1:
            a0 = 1+k*seg+m; a1 = 1+k*seg+m1; c0 = a0+seg; c1 = a1+seg
            body.push(u32(a0)); body.push(u32(a1)); body.push(u32(c0))
            body.push(u32(a1)); body.push(u32(c1)); body.push(u32(c0))
    if lobed:
        # (a near crown's lobes: five protruding round 10-sided 3-ring domes — one offset cap lobe
        # and four broad shoulder lobes — sculpting lush multi-lobed crowns up close with Early-Z)
        lr: f32[] = [0.42,0.80,1.0]
        lh: f32[] = [0.91,0.56,-0.22]
        loop l in 0..BILLOW_LOBES:
            la: f32 = if l == 4: 0.9 else: (f32(l)+0.22*f32(l%2))*f32(TAU)/4.0
            tilt: f32 = if l == 4: 0.22 else: 0.82+0.10*f32(l%2)
            at = vec3(sin(tilt)*cos(la),cos(tilt),sin(tilt)*sin(la))
            t1 = normalize(cross(vec3(0.3,1,0.2),at))
            t2 = cross(t1,at)
            size: f32 = if l == 4: 0.56 else: 0.50+0.05*f32(l%2)
            sit = at*(if l == 4: 0.58 else: 0.66)
            lb = vs.len()
            vs.push(BillowVertex(sit,at*(size*0.98),la,size))
            loop k in 0..3:
                r = lr[k]
                h = lh[k]
                loop m in 0..10:
                    a = (f32(m)+0.5*f32(k))*f32(TAU)/10.0
                    vs.push(BillowVertex(sit,(t1*cos(a)+t2*sin(a))*(r*size)+at*(h*size*0.98),la,size))
            loop m in 0..10:
                m1 = (m+1)%10
                ids.push(u32(lb)); ids.push(u32(lb+1+m1)); ids.push(u32(lb+1+m))
                loop k in 0..2:
                    a0 = lb+1+k*10+m; a1 = lb+1+k*10+m1; c0 = a0+10; c1 = a1+10
                    ids.push(u32(a0)); ids.push(u32(a1)); ids.push(u32(c0))
                    ids.push(u32(a1)); ids.push(u32(c1)); ids.push(u32(c0))
    # (whole: the dome with them; else the lobes alone, the dome drawn after them from its own mesh)
    if whole: ids += body
    mesh(vs,ids)

const BILLOW_LISTS = 7              # (the masses, the far clumps, the clumps, the far crowns, the middle crowns, the crowns, the near crowns)
const BILLOW_CUT_END = 250.0        # (beyond, a crown drawn whole: no outline cut, its depth tested before it is shaded)
const BILLOW_MID_END = 470.0        # (beyond, a crown a cone of eight sides; nearer its ring swells out, a full dome from 340 m)
const BILLOW_CLUMP_END = 700.0      # (beyond, a clump a cone of six sides)
billow_sh: Shader
billow_solid_sh: Shader
billow_mass_sh: Shader              # (the masses': a far mass's foot painted as the sheet)
billow_near_sh: Shader              # (the near crowns' lobes, lit in flat bands)
billow_near_solid_sh: Shader        # (and the domes under them)
billow_ready = false
billow_meshes: Mesh[] = []
# (the gathered domes on the GPU, a buffer a list; each given again only when the tiles it is
# gathered from change)
billow_buffers: InstanceBuffer[Billow][] = []
billow_marks: int[] = []
billow_count = 0
# What a frame gathers: for each list the domes it is drawn from (a tile's slot, or an old
# island's patch as -1 less its place in island_billows; which of its lists; how far the block
# is), and a sum over them, to tell a change.
struct BillowFrom:
    source: int
    list: int
    away: f64
billow_from: BillowFrom[][] = []
billow_sums: int[] = []
billow_lobes = true

billow_gather_start = ():
    global billow_from,billow_sums,billow_lobes
    billow_from = [loop i in 0..BILLOW_LISTS: []]
    billow_sums = [loop i in 0..BILLOW_LISTS: 0]
    # (timing only: AEGEAN_BILLOW_LOBES=0 the near crowns without their lobes)
    billow_lobes = (env("AEGEAN_BILLOW_LOBES") ?? "") != "0"

# Which of a square's lists hold any domes.
billow_held = (lists: Billow[][]) -> int[]: [loop k in 0..lists.len(): if lists[k].len() > 0: k]

# The domes over the view: each size from the tiles it is made in (billow_build), wherever they
# are made, whatever level the terrain draws there: the ancestors of the tiles drawn, or the
# tiles themselves, or (where a coarser tile is drawn while its children are still being made)
# their descendants up to three levels down; each once. So a dome never waits for the ground's
# selection to reach its tile's level, and never appears when it does.
billow_gather_view = (cam: vec3,planes: vec4[]):
    seen: {int:bool} = {}
    reach = f64(billow_reach(0.0))+50.0
    loop slot in world_selected:
        node = world_tiles[slot]
        if node.level > 5: continue
        # (a drawn tile beyond every dome's reach: nothing to gather)
        ox,oz = world_tile_origin(node.x,node.z,node.level)
        away = world_distance(ox,oz,world_tile_size(node.level),cam)
        if away >= reach: continue
        loop source in [2,1,0]:
            # (the clumps and the crowns reach less far)
            if source == 1 and away >= f64(billow_reach(1.0))+50.0: continue
            if source == 0 and away >= f64(billow_crown_reach())*1.18+50.0: continue
            keys: int[] = []
            if source >= node.level:
                # (the dome tile is the drawn tile or its ancestor)
                up = source-node.level
                keys.push(world_tile_key(node.x >> up,node.z >> up,source))
            else:
                # (the dome tiles are the drawn tile's descendants, if not too far down)
                down = node.level-source
                if down > 3: continue
                n = 1 << down
                loop j in 0..n:
                    loop i in 0..n: keys.push(world_tile_key((node.x << down)+i,(node.z << down)+j,source))
            loop key in keys:
                if key in seen: continue
                seen[key] = true
                if let from = world_cache.get(key):
                    if from < world_billow_has.len() and world_billow_has[from].len() > 0:
                        t = world_tiles[from]
                        ox,oz = world_tile_origin(t.x,t.z,t.level)
                        billow_gather(from,key,world_billow_has[from],ox,oz,world_tile_size(t.level),t.low,t.high,cam,planes)

# The domes over a square of land (a tile, or an old island's patch: ox, oz, size, its ground
# between low and high; has: which of its lists hold any) into the frame's gathering: each size
# within its reach, block by block, the blocks in view.
billow_gather = (source: int,key: int,has: int[],ox: f64,oz: f64,size: f64,low: f64,high: f64,cam: vec3,planes: vec4[]):
    global billow_from,billow_sums
    near_edge = world_distance(ox,oz,size,cam)
    if near_edge >= f64(billow_reach(0.0))+50.0: return
    part = size/f64(BILLOW_BLOCKS)
    loop list in has:
        tier = list/(BILLOW_BLOCKS*BILLOW_BLOCKS); block = list%(BILLOW_BLOCKS*BILLOW_BLOCKS)
        reach = (if tier == 2: f64(billow_crown_reach())*1.18 else: f64(billow_reach(f32(tier))))+50.0
        if near_edge >= reach: continue
        bx = ox+f64(block%BILLOW_BLOCKS)*part; bz = oz+f64(block/BILLOW_BLOCKS)*part
        away = world_distance(bx,bz,part,cam)
        if away >= reach or not billow_block_visible(bx,bz,part,low,high,cam,planes): continue
        which = if tier == 0: 0 else: if tier == 1: (if away < BILLOW_CLUMP_END: 2 else: 1) else: if away < BILLOW_LOBE_END and billow_lobes: 6 else: if away < BILLOW_CUT_END: 5 else: if away < BILLOW_MID_END: 4 else: 3
        billow_from[which].push(BillowFrom(source,list,away))
        billow_sums[which] += key*61+list*3+1

# ---------------- the old islands' canopy ----------------
# The old islands' woods are the same domes, made patch by patch (448 m) from the islands' own
# samples (the stand cover as their ground paints it, src/terrain_lod.jo island_working) the
# first time a patch is in reach, one patch a frame. Their woods are small and their land is
# drawn patch by patch at its own detail, so no sheet is lifted under them: the domes stand on
# the ground, whose paint of the same crowns is the floor between them.
island_billows: Billow[][][] = []
island_billow_has: int[][] = []
island_billow_at: {int:int} = {}
island_billow_gather = (cam: vec3,planes: vec4[]):
    global island_billows,island_billow_has,island_billow_at
    made = false
    reach = f64(billow_reach(0.0))+50.0
    loop ti in 0..terrain_tiles.len():
        tile = terrain_tiles[ti]
        nx = tile.heights.width; nz = tile.heights.height
        tx = max(max(tile.x-f64(cam.x),f64(cam.x)-tile.x-f64(nx-1)*14.0),0.0); tz = max(max(tile.z-f64(cam.z),f64(cam.z)-tile.z-f64(nz-1)*14.0),0.0)
        if tx*tx+tz*tz >= reach*reach: continue
        loop pi in 0..tile.patches.len():
            if pi >= tile.wooded.len() or not tile.wooded[pi]: continue
            p = tile.patches[pi].data
            px = tile.x+f64(p.x)*14.0; pz = tile.z+f64(p.z)*14.0
            if world_distance(px,pz,448.0,cam) >= reach or not land_visible(tile,p,cam,planes): continue
            key = ti*4096+pi
            index = island_billow_at.get(key,-1)
            if index < 0:
                if made: continue
                made = true
                lists = billow_make(tile.x,tile.z,14.0,nx,nz,px,pz,448.0,0,2,0.0,false,tile.cpu_heights,tile.stand,tile.rise,[[],[]])
                island_billow_has.push(billow_held(lists))
                island_billows.push(lists)
                index = island_billows.len()-1
                island_billow_at[key] = index
            billow_gather(-1-index,900000000+key,island_billow_has[index],px,pz,448.0,p.low,p.high,cam,planes)

draw_world_billows = (params: GroundParams):
    global billow_sh,billow_solid_sh,billow_mass_sh,billow_near_sh,billow_near_solid_sh,billow_ready,billow_meshes,billow_buffers,billow_marks,billow_count
    from = billow_from; marks = billow_sums
    if not billow_ready:
        lists: Billow[][] = [loop i in 0..BILLOW_LISTS: []]
        billow_sh = make_shader(world_shader(shader(billow_vertex,billow_fragment),shader(billow_vertex,billow_fragment_log)),false)
        billow_solid_sh = make_shader(world_shader(shader(billow_vertex,billow_fragment_solid),shader(billow_vertex,billow_fragment_solid_log)),false)
        billow_mass_sh = make_shader(world_shader(shader(billow_vertex,billow_fragment_mass),shader(billow_vertex,billow_fragment_mass_log)),false)
        billow_near_sh = make_shader(world_shader(shader(billow_vertex,billow_fragment_near),shader(billow_vertex,billow_fragment_near_log)),false)
        billow_near_solid_sh = make_shader(world_shader(shader(billow_vertex,billow_fragment_near_solid),shader(billow_vertex,billow_fragment_near_solid_log)),false)
        # (far off a dome is a few pixels: a cone of six or eight sides, its normals a dome's; a
        # clump or a crown nearer eight-sided with a ring under its top; a near crown the same
        # with its own lobes. The laptop's GPU pays by the vertex)
        billow_meshes = [billow_mesh(6,1),billow_mesh(6,1),billow_mesh(8,2),billow_mesh(8,1),billow_mesh(8,2),billow_mesh(12,3),billow_mesh(12,3,true,false)]
        billow_buffers = [loop i in 0..BILLOW_LISTS: instance_buffer(lists[i])]
        billow_marks = [loop i in 0..BILLOW_LISTS: 0]
        billow_ready = true
    p = params
    # (the seamless 3D octahedral tuft sphere in the pigment slot: crowns are painted as single crowns are)
    crown_init()
    p.pigment = crown_oct_tex
    # (timing only: AEGEAN_BILLOWS=mask, a bit a list; AEGEAN_FOLIAGE_OFF=billowfs their
    # fragments discarded at once)
    shown = to_int(env("AEGEAN_BILLOWS") ?? "") ?? 127
    p.shell = vec4(0,if foliage_off("cast"): 0.0 else: 1.0,0,if foliage_off("billowfs"): -1.0 else: 0.0)
    billow_count = 0
    # (the crowns first, then what they stand on: the nearer, upper domes hide the lower)
    loop back in 0..BILLOW_LISTS:
        which = BILLOW_LISTS-1-back
        if marks[which] != billow_marks[which]:
            # (the nearest blocks first: their domes hide the farther ones' before those are shaded)
            order = from[which]
            order.sort((f: BillowFrom) -> f64: f.away)
            gathered: Billow[] = []
            loop f in order: gathered += if f.source >= 0: world_billows[f.source][f.list] else: island_billows[-1-f.source][f.list]
            set_instances(billow_buffers[which],gathered)
            billow_marks[which] = marks[which]
        if ((shown >> which) & 1) == 0 or billow_buffers[which].count == 0: continue
        billow_count += billow_buffers[which].count
        # (x: the near crowns, whose round 8-sided lobes grow gently over the 12-sided dome)
        p.shell.x = if which == BILLOW_LISTS-1: 1.0 else: 0.0
        p.shell.z = 0.0
        # (near and mid sculpted crowns share Early-Z billow_near_solid_sh: zero view-dependent
        # edge re-cutting, zero hexagons, and full Early-Z across overlapping canopy crowns)
        draw_instanced(if which >= 5 and not foliage_off("bands"): billow_near_solid_sh else: if foliage_off("solid"): billow_sh else: if which == 0 and not foliage_off("massfoot"): billow_mass_sh else: billow_solid_sh,billow_meshes[which],billow_buffers[which],p)
        # (a near crown: its 5 round lobes first; then its sculpted 12-sided core dome under them)
        if which == BILLOW_LISTS-1:
            draw_instanced(if foliage_off("bands"): billow_solid_sh else: billow_near_solid_sh,billow_meshes[which-1],billow_buffers[which],p)

# (the low tier's: its own canopy, compiled without the full one)
world_fragment_low_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    world_fragment_low(i, u)

world_fragment_low = (i: GroundOut,u: GroundParams) -> vec4: world_fragment_at(i,u,0)
# (the wind study's (Tweaks): its sheen compiled in, made the first time its box is on)
world_fragment_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    world_fragment_ws(i, u)

world_fragment_ws = (i: GroundOut,u: GroundParams) -> vec4: world_fragment_at(i,u,1,1)
world_fragment_low_ws_log = (i: GroundOut, u: GroundParams) -> vec4:
    set_depth(world_depth_encode(1.0 / i.pos.w))
    world_fragment_low_ws(i, u)

world_fragment_low_ws = (i: GroundOut,u: GroundParams) -> vec4: world_fragment_at(i,u,0,2)
world_ground_sh_ws: Shader
world_study_ready = false
world_study_shader = () -> Shader:
    global world_ground_sh_ws, world_study_ready
    if not world_study_ready:
        world_ground_sh_ws = make_shader(if render_quality.tier == 0: world_shader(shader(world_vertex, world_fragment_low_ws), shader(world_vertex, world_fragment_low_ws_log)) else: world_shader(shader(world_vertex, world_fragment_ws), shader(world_vertex, world_fragment_ws_log)),false)
        world_study_ready = true
    world_ground_sh_ws
world_fragment_at = (i: GroundOut,u: GroundParams,detail: int,wind_study: int = 0) -> vec4:
    # Canonical contact tiles replace coarse fallback geometry immediately,
    # even while the surrounding quadtree is still streaming after arrival.
    if i.tile_level>0.0 and i.world.x>=u.contact_rect.x and i.world.z>=u.contact_rect.y and i.world.x<u.contact_rect.z and i.world.z<u.contact_rect.w:discard()
    # Coarse fallback triangles may cross empty space while streaming. Never
    # let them cover the preserved archipelago, including its seabed apron.
    absolute = i.world+u.origin
    if abs(absolute.x) < 20000.0 and abs(absolute.z) < 20000.0: discard()
    if abs(absolute.x) >= 250000.0 or abs(absolute.z) >= 200000.0: discard()
    # Haze saturation is an explicit <=0.001 linear-color error bound. Keep
    # geometry/depth and horizon occlusion, skip invisible material detail.
    transmission = exp(-length(i.world-u.cam)*u.fog*exp(-max(min(i.world.y,u.cam.y),0.0)*0.0012))
    if transmission < 0.001:
        if behind_sea(i.world,u.cam): discard()
        return vec4(u.haze,1)
    ground_material(i,u,true,false,detail,wind_study)

init_world_terrain = ():
    reset_coast_selection()
    global world_cover
    global world_tiles,world_heights,world_materials,world_working,world_cliff_map,world_ground_sh,world_balance_input,world_balance_output,world_balance_registry
    world_balance_input=[];world_balance_output=[];world_balance_registry={}
    if coast_grids.len() == 0: init_terrain()
    world_tiles = [loop i in 0..WORLD_CACHE_SLOTS: WorldTile()]
    world_heights = texture(image(32*17,32*17),true)
    world_materials = texture(image(32*17,32*17),true)
    world_cliff_map = texture(image(32*51,32*17),true)
    set_mipmaps(world_cliff_map,false)
    world_working = texture(image(32*51,32*17),true)
    set_mipmaps(world_working,false)
    world_cover = texture(image(32*51,32*17),true)
    set_mipmaps(world_cover,false)
    world_ground_sh = make_shader(if render_quality.tier == 0: world_shader(shader(world_vertex, world_fragment_low), shader(world_vertex, world_fragment_low_log)) else: world_shader(shader(world_vertex, world_fragment), shader(world_vertex, world_fragment_log)))

world_edge_state = (slot: int) -> (vec4,int):
    node = world_tiles[slot]
    edges = vec4(f32(node.lod),f32(node.lod),f32(node.lod),f32(node.lod))
    mask = 0
    loop other in world_selected:
        if other == slot: continue
        nb = world_tiles[other]
        side = world_neighbor_side(node,nb)
        if side < 0: continue
        e = f32(max(node.lod,nb.lod))
        match side:
            0: edges.x = max(edges.x,e)
            1: edges.y = max(edges.y,e)
            2: edges.z = max(edges.z,e)
            _: edges.w = max(edges.w,e)
        if nb.level < node.level: mask = mask | (1<<side)
    (edges,mask)

# Neighbor relationships depend only on the selected tile geometry. Cache
# this quadratic scan while still reading live LOD morphs on every frame.
struct WorldEdgeStamp:
    slot:int
    key:int
    x:int
    z:int
    level:int
world_edge_stamps:WorldEdgeStamp[]
world_edge_neighbors:(int,int)[][]
world_edge_rebuilds=0

world_balance_input:WorldEdgeStamp[]
world_balance_output:WorldEdgeStamp[]
world_balance_registry:{int:int}
world_balance_rebuilds=0

world_selection_stamps=(selection:int[])->WorldEdgeStamp[]:
    stamps:WorldEdgeStamp[]
    loop slot in selection:
        n=world_tiles[slot]
        stamps.push(WorldEdgeStamp(slot,n.key,n.x,n.z,n.level))
    stamps

world_balance_cached=():
    global world_selected,world_balance_input,world_balance_output,world_balance_registry,world_balance_rebuilds
    stamps=world_selection_stamps(world_selected)
    result=[loop stamp in world_balance_output:stamp.slot]
    # Balancing depends on geometry and available ancestors, never live morphs.
    # Include the registry and result geometry so streaming/reused slots cannot
    # return an old ancestor even when the visible input selection is unchanged.
    if stamps==world_balance_input and world_cache==world_balance_registry and world_selection_stamps(result)==world_balance_output:
        world_selected=result
        return
    world_balance_input=stamps
    world_balance()
    world_balance_output=world_selection_stamps(world_selected)
    world_balance_registry=world_cache
    world_balance_rebuilds+=1

world_prepare_edge_states=():
    global world_edge_stamps,world_edge_neighbors,world_edge_rebuilds
    stamps:WorldEdgeStamp[]
    loop slot in world_selected:
        n=world_tiles[slot]
        stamps.push(WorldEdgeStamp(slot,n.key,n.x,n.z,n.level))
    if stamps==world_edge_stamps and world_edge_neighbors.len()==world_selected.len():return
    world_edge_stamps=stamps
    neighbors:(int,int)[][]
    rx=[loop t in stamps:t.x*(1<<t.level)];rz=[loop t in stamps:t.z*(1<<t.level)];rs=[loop t in stamps:1<<t.level]
    loop i in 0..stamps.len():
        row:(int,int)[]
        loop j in 0..stamps.len():
            if stamps[j].slot==stamps[i].slot:continue
            side=world_side(rx[i],rz[i],rs[i],rx[j],rz[j],rs[j])
            if side>=0:row.push((stamps[j].slot,side))
        neighbors.push(row)
    world_edge_neighbors=neighbors
    world_edge_rebuilds+=1

world_cached_edge_state=(selected_index:int)->(vec4,int):
    node=world_tiles[world_selected[selected_index]]
    edges=vec4(f32(node.lod),f32(node.lod),f32(node.lod),f32(node.lod));mask=0
    loop other,side in world_edge_neighbors[selected_index]:
        nb=world_tiles[other];e=f32(max(node.lod,nb.lod))
        match side:
            0:edges.x=max(edges.x,e)
            1:edges.y=max(edges.y,e)
            2:edges.z=max(edges.z,e)
            _:edges.w=max(edges.w,e)
        if nb.level<node.level:mask=mask | (1<<side)
    (edges,mask)

# A cold teleport to ground needs a complete balanced neighborhood, not just
# one cached tile. Spend a bounded burst there; steady flight and high views
# retain the normal budget. Existing islands never enter this path.
world_contact_budget = (cam: vec3) -> int:
    if (abs(cam.x) < 20000.0 and abs(cam.z) < 20000.0) or cam.y > 3210.0: return WORLD_GENERATE_LIMIT
    covered = 0
    loop dz in [-28.0,0.0,28.0]:
        loop dx in [-28.0,0.0,28.0]:
            x = f64(cam.x)+dx; z = f64(cam.z)+dz
            loop slot in world_selected:
                tile = world_tiles[slot]
                if tile.level != 0 or tile.lod != 0.0: continue
                ox,oz = world_tile_origin(tile.x,tile.z,0)
                if x >= ox and x < ox+224.0 and z >= oz and z < oz+224.0:
                    covered += 1
                    break
    if covered == 9: return WORLD_GENERATE_LIMIT
    ground = new_land_surface(f64(cam.x),f64(cam.z))
    if ground >= 0.0 and f64(cam.y)-ground < 200.0: WORLD_CONTACT_GENERATE_LIMIT else: WORLD_GENERATE_LIMIT

# Pin the camera's 3x3 contact neighbourhood before traversing the distant
# tree. A newly arrived walker must never stand on a 14 m CPU surface while
# the renderer morphs a kilometre-sized fallback under their feet.
world_prepare_contact = (cam: vec3,enabled: bool = true):
    global world_contact_slots,world_contact_rect,world_generate_budget,world_contact_requesting
    world_contact_slots=[];world_contact_rect=vec4(0,0,0,0)
    if not enabled:return
    if abs(cam.x)<LEGACY_RESERVE and abs(cam.z)<LEGACY_RESERVE:return
    ground=new_land_surface(f64(cam.x),f64(cam.z))
    if ground < -40.0 or f64(cam.y)-ground>80.0:return
    cx=int(floor((f64(cam.x)-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
    cz=int(floor((f64(cam.z)-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
    # Nine uploads only on a cold arrival; walking across an edge adds three.
    ordinary_budget=world_generate_budget
    world_generate_budget=max(world_generate_budget,WORLD_CONTACT_GENERATE_LIMIT)
    # All nine are made at once, never a slice at a time: until the nine are there the
    # contact area is off and a coarser tile still draws under the walker beside the fine
    # ones. (The ring the camera is heading into is made ahead, in slices: world_prefetch_contact.)
    world_contact_requesting=true
    loop dz in [-1,0,1]:
        loop dx in [-1,0,1]:
            slot=world_request_tile(cx+dx,cz+dz,0)
            if slot>=0:world_contact_slots.push(slot)
    world_contact_requesting=false
    world_generate_budget=max(ordinary_budget,world_generated)
    if world_contact_slots.len()!=9:return
    x,z=world_tile_origin(cx-1,cz-1,0)
    world_contact_rect=vec4(f32(x),f32(z),f32(x+WORLD_TILE_SPAN*3),f32(z+WORLD_TILE_SPAN*3))

# Make the contact neighbourhood the camera is heading into (six seconds on, at most 400 m)
# a tile or so a frame under the ordinary limits, so arriving there, by a walk across a tile
# edge or a seaplane coming into a harbour, rarely leaves anything for the burst above.
world_contact_track = vec3(1e9,1e9,1e9)
world_contact_track_t = 0.0
world_contact_course = vec3(0,0,0)
world_prefetch_contact = (cam: vec3):
    global world_contact_track,world_contact_track_t,world_contact_course
    if abs(cam.x)<LEGACY_RESERVE and abs(cam.z)<LEGACY_RESERVE:return
    now = time(); dt = now-world_contact_track_t
    if dt >= 0.25:
        world_contact_course = if dt < 2.0: (cam-world_contact_track)/f32(dt) else: vec3(0,0,0)
        world_contact_track = cam; world_contact_track_t = now
    ahead = world_contact_course.xz*6.0
    if length(ahead) < 20.0: return
    if length(ahead) > 400.0: ahead = ahead*(400.0/length(ahead))
    p = cam.xz+ahead
    ground = new_land_surface(f64(p.x),f64(p.y))
    if ground < -40.0 or f64(cam.y)-ground > 150.0: return
    cx=int(floor((f64(p.x)-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
    cz=int(floor((f64(p.y)-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
    loop dz in [-1,0,1]:
        loop dx in [-1,0,1]: _ = world_request_tile(cx+dx,cz+dz,0)

prepare_world_terrain = (cam: vec3,vp: mat4,t: f64,contact_burst: bool = true):
    global world_frame,world_clock,world_generated,world_uploaded,world_selected,world_tiles,world_generate_budget,world_generate_until
    world_generate_budget = if contact_burst: world_contact_budget(cam) else: WORLD_GENERATE_LIMIT
    world_frame += 1; world_clock = t; world_generated = 0; world_uploaded = 0
    world_generate_until = time()+(if world_generate_seconds >= 1.0: world_generate_seconds else: if world_arriving_bare: max(WORLD_ARRIVAL_SECONDS,build_slice(world_generate_seconds)) else: build_slice(world_generate_seconds))
    global world_generate_made
    world_generate_made = 0
    if world_generate_tiles > 0: world_generate_until = 1e30
    global world_next_level,world_want_key,world_want_level,world_want_cam,world_want_warm,world_view_missing
    world_next_level = if world_arriving or world_want_warm: world_want_level else: -1
    world_want_key = -1; world_want_level = -1; world_want_cam = cam; world_want_warm = false; world_view_missing = 0
    world_prepare_contact(cam,contact_burst)
    if contact_burst: world_prefetch_contact(cam)
    planes = land_planes(vp)
    world_selected = []
    global world_prefetch
    world_prefetch = []
    world_visit(0,0,WORLD_ROOT_LEVEL,cam,planes)
    world_balance_cached()
    # Preserve these exact tiles even if balancing selected a coarse ancestor.
    loop slot in world_contact_slots:
        if not (slot in world_selected):world_selected.push(slot)
    global world_arriving,world_arriving_bare
    # (arriving while land chosen cannot be drawn and tiles asked for are still to be made: a
    # view with nothing left to make gains nothing from the larger slice)
    world_arriving = false; world_arriving_bare = false
    if world_view_missing > 0:
        hidden = 0; shown = 0
        loop slot in world_selected:
            if world_tiles[slot].high > 0.0:
                if world_tile_drawable(world_tiles[slot],cam): shown += 1 else: hidden += 1
        world_arriving = hidden > 0
        world_arriving_bare = hidden > shown
    if world_warm_views.len() > 0: world_warm_pass()
    if not foliage_off("prefetch"): world_prefetch_tiles()
    # A tile coming into the selection (a split, a merge, a tile made late, balancing) starts
    # from the detail drawn where it is the frame before, and morphs from it to its own over
    # WORLD_ENTER_SECONDS: the ground never steps. Where nothing was drawn (an arrival), it
    # starts a level coarser, as the ground grows in.
    global world_last_lods,world_last_eye
    lods: {int:f64} = {}
    # (a cut or a jump: what was drawn before is elsewhere; the land arrives as it always has)
    if length(cam-world_last_eye) > 400.0: world_last_lods = {}
    world_last_eye = cam
    loop slot in world_selected:
        node = world_tiles[slot]
        ox,oz = world_tile_origin(node.x,node.z,node.level); size = world_tile_size(node.level)
        distance = world_distance(ox,oz,size,cam)
        transition = clamp(distance/(size*world_tile_detail(node))-1.0,0.0,1.0)
        if not node.published: node.born = t; node.published = true
        if not (node.key in world_last_lods):
            node.entered = t
            node.start = world_drawn_lod(node)
        entering = clamp((t-node.entered)/WORLD_ENTER_SECONDS,0.0,1.0)
        entering = entering*entering*(3.0-2.0*entering)
        from = clamp(node.start-f64(node.level),0.0,3.999)*(1.0-entering)
        # Physical contact is always the canonical 14 m surface, even during
        # an arrival transition after teleporting to a fresh tile.
        if node.level == 0 and distance < size*1.5 and node.start >= f64(node.level)+1.0: from = 0.0
        node.lod = if slot in world_contact_slots: 0.0 else: f64(node.level)+max(transition,from)
        lods[node.key] = node.lod
        world_tiles[slot] = node
    world_last_lods = lods

const WORLD_ENTER_SECONDS = 1.0
world_last_lods: {int:f64} = {}
world_last_eye = vec3(1e9,0,0)

# The detail drawn the frame before where a tile is (a lod): its own if it was drawn, else an
# ancestor's that covered it, else the finest of its descendants that did (no finer than the
# tile itself can draw), else a level coarser than its own (it arrives).
world_drawn_lod = (node: WorldTile) -> f64:
    if let lod = world_last_lods.get(node.key): return lod
    loop up in 1..WORLD_ROOT_LEVEL-node.level+1:
        if let lod = world_last_lods.get(world_tile_key(node.x >> up,node.z >> up,node.level+up)): return min(lod,f64(node.level)+3.999)
    finest = 1e9
    loop down in 1..4:
        if down > node.level: break
        n = 1 << down
        loop j in 0..n:
            loop i in 0..n:
                if let lod = world_last_lods.get(world_tile_key((node.x << down)+i,(node.z << down)+j,node.level-down)): finest = min(finest,lod)
        if finest < 1e8: return max(finest,f64(node.level))
    f64(node.level)+1.0

world_warm_pass = ():
    global world_selected,world_warming,world_want_main,world_warm_missing,world_warm_ready,world_want_cam,world_generate_until,world_warm_selected,world_warm_eyes
    main = world_selected; main_cam = world_want_cam
    if world_warm_slice > 0.0 and world_generate_seconds < 1.0: world_generate_until = max(world_generate_until,time()+world_warm_slice)
    world_want_main = world_want_key >= 0
    world_warming = true; world_warm_missing = 0
    world_warm_selected = []; world_warm_eyes = []
    loop v in world_warm_views:
        world_want_cam = v.eye
        ground = new_land_surface(f64(v.eye.x),f64(v.eye.z))
        if ground >= -40.0 and f64(v.eye.y)-ground <= 80.0 and not (abs(v.eye.x)<LEGACY_RESERVE and abs(v.eye.z)<LEGACY_RESERVE):
            cx=int(floor((f64(v.eye.x)-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
            cz=int(floor((f64(v.eye.z)-WORLD_ROOT_ORIGIN)/WORLD_TILE_SPAN))
            loop dz in [-1,0,1]:
                loop dx in [-1,0,1]: _ = world_request_tile(cx+dx,cz+dz,0)
        aspect = if v.aspect > 0.0: v.aspect else: f64(max(screen_width(),1))/f64(max(screen_height(),1))
        vp = perspective(v.fov*PI/180.0,aspect,0.3,world_far(f64(v.eye.y)))*look_at(v.eye,v.look,vec3(0,1,0))
        world_selected = []
        world_visit(0,0,WORLD_ROOT_LEVEL,v.eye,land_planes(vp))
        loop slot in world_selected:
            world_warm_selected.push(slot); world_warm_eyes.push(v.eye)
    world_warming = false
    world_selected = main; world_want_cam = main_cam
    world_warm_ready = world_warm_missing == 0

draw_world_terrain = (L: Light,t: f64):
    global world_frame,world_clock,world_generated,world_uploaded,world_selected,world_tiles,world_draws,world_triangles,world_shell_tiles
    if not geography_enabled: return
    begin_coast_frame()
    zone("world terrain")
    cam = scene_camera(); vp = scene_view_proj()
    update_field_map(cam,canopy_light(L.sun_dir))
    # (the ground and the canopy are opaque, and their alpha says how wooded the land is: never
    # blended by it, as the field map's redrawing would leave them: src/terrain.jo draw_ground)
    blend(.none)
    zone("world selection")
    prepare_world_terrain(cam,vp,t)
    world_prepare_edge_states()
    zone_end()
    origin = render_origin(cam)
    batches: WorldInstance[][] = [loop i in 0..16: []]
    shells: WorldInstance[][] = [loop i in 0..16: []]
    world_shell_tiles = 0
    billow_gather_start()
    coastal: CoastInstance[][] = [loop i in 0..COAST_LEVELS: []]
    planes = land_planes(vp)
    focal = f64(length(vec3(vp[0].y,vp[1].y,vp[2].y)))*f64(screen_height())*0.5/render_quality.terrain_error
    # (timing only: AEGEAN_MAPS=mask, the maps the ground's vertices read)
    maps_mask = to_int(env("AEGEAN_MAPS") ?? "") ?? 7
    loop selected_index in 0..world_selected.len():
        slot=world_selected[selected_index]
        node = world_tiles[slot]
        if not world_tile_drawable(node,cam): continue
        edges,mask = world_cached_edge_state(selected_index)
        ox,oz = world_tile_origin(node.x,node.z,node.level)
        if coast_enabled and node.level == 0 and node.lod == 0.0 and node.low < 192.0 and node.high > -10.0 and coast_patch_near(ox,oz,224.0,cam,focal):
            limits = vec4(if edges.x > 0.0: 0.0 else: 6.0,if edges.y > 0.0: 0.0 else: 6.0,if edges.z > 0.0: 0.0 else: 6.0,if edges.w > 0.0: 0.0 else: 6.0)
        instance = WorldInstance(vec2(f32(ox-f64(origin.x)),f32(oz-f64(origin.z))),vec2(f32(slot%32*17),f32(slot/32*17)),vec4(f32(14.0*f64(1<<node.level)),f32(node.lod-f64(node.level)),f32(node.level),f32(node.maps & maps_mask)),edges-vec4(f32(node.level),f32(node.level),f32(node.level),f32(node.level)))
        # (the far canopy's shells: tiles reaching past the crowns, below the treeline; over the
        # coast's refined lowland too, the shells lifted off the plain tile, within a metre of it)
        size = 14.0*16.0*f64(1<<node.level)
        dx = max(max(ox-f64(cam.x),f64(cam.x)-ox-size),0.0); dz = max(max(oz-f64(cam.z),f64(cam.z)-oz-size),0.0)
        near_edge = sqrt(dx*dx+dz*dz)
        # (a tile wholly nearer than where the shells begin would only rasterize discarded pixels)
        fx = max(abs(ox-f64(cam.x)),abs(ox+size-f64(cam.x))); fz = max(abs(oz-f64(cam.z)),abs(oz+size-f64(cam.z)))
        far_edge = sqrt(fx*fx+fz*fz)
        if node.wooded > 0.05 and node.low < 2200.0 and near_edge < f64(CANOPY_GROW_FAR)+600.0: shells[mask].push(instance); world_shell_tiles += 1
        if coast_enabled and node.level == 0 and node.lod == 0.0 and node.low < 192.0 and node.high > -10.0 and coast_patch_near(ox,oz,224.0,cam,focal):
            limits = vec4(if edges.x > 0.0: 0.0 else: 6.0,if edges.y > 0.0: 0.0 else: 6.0,if edges.z > 0.0: 0.0 else: 6.0,if edges.w > 0.0: 0.0 else: 6.0)
            coast_add_patch(coastal,node.cpu_heights,17,17,ox,oz,0,0,16,vec2(f32(slot%32*17),f32(slot/32*17)),cam,origin,focal,planes,limits,source_id=node.key)
            continue
        batches[mask].push(instance)
    params = GroundParams(render_view_proj(origin),render_eye(origin),L.sun_dir,L.sun,L.sky_top,L.shade,air_down(L.haze,f64(scene_camera().y),tweaks.brighter_ocean),f32(L.fog_density),f32(t),meadow_wind(wind_now,origin),meadow_gust_w(origin),origin,world_heights,world_materials,scene_flow,vec4(0,0,0,0),vec4(0,0,0,0))
    params.pigment = paint_surface()
    params.canopy = canopy_sheet()
    params.field_map = field_map_texture(); params.field_window = field_map_window
    params.grove = grove_new_world()
    params.canopy_light = canopy_light(L.sun_dir)
    params.land_light = land_light(L.sun_dir)
    params.land_steps = if tweaks.painted_layers: 1.0 else: 0.0
    params.land_palette = field_palette
    params = meadow_fill(params, origin)
    params.cliff_map=world_cliff_map
    params.working_map=world_working
    params.cover_map=world_cover
    params.river_map=river_material_texture()
    params.river_area=vec4(RIVER_BOUNDS.xy,RIVER_BOUNDS.zw-RIVER_BOUNDS.xy)
    params.coast_pattern = coast_pattern_texture
    prepare_road_field(cam)
    params.roads=road_field
    params.road_rect=road_field_rect-vec4(origin.x,origin.z,0,0)
    params.lake_map=unread_map()
    nearest_lake= -1;lake_distance:f32=5500.0
    loop k in 0..SETTLEMENT_LAKES.len():
        distance=length(SETTLEMENT_LAKES[k].center-cam.xz)
        if distance<lake_distance:nearest_lake=k;lake_distance=distance
    if nearest_lake>=0:
        lake=SETTLEMENT_LAKES[nearest_lake]
        params.lake_map=lake_material_texture(nearest_lake)
        # Texture texel centres coincide with the actual relief sample stations.
        params.lake_area=vec4(lake.origin-origin.xz-vec2(f32(lake.step*0.5),f32(lake.step*0.5)),vec2(f32(lake.nx),f32(lake.nz))*f32(lake.step))
    zone("world coast")
    draw_coast_batches(coastal,params,true)
    zone_end()
    if world_contact_slots.len()==9:params.contact_rect=world_contact_rect-vec4(origin.x,origin.z,origin.x,origin.z)
    world_draws = 0; world_triangles = 0
    # (the woods' canopy before the ground under it: the ground's pixels a wood hides are then
    # never shaded; AEGEAN_FOLIAGE_OFF=canopyfirst draws it after, for timing)
    first = not foliage_off("canopyfirst")
    loop turn in 0..2:
        if (turn == 0) == first:
            zone("canopy")
            if not foliage_off("shells"):
                if not foliage_off("billows"):
                    billow_gather_view(cam,planes)
                    island_billow_gather(cam,planes)
                    draw_world_billows(params)
                draw_world_shells(shells,params)
            zone_end()
        else:
            loop i in 0..16:
                if batches[i].len() == 0: continue
                grid = terrain_grids[16+i]
                draw_instanced(if params.meadow_c.w > 0.0: world_study_shader() else: world_ground_sh,grid,batches[i],params)
                world_draws += 1; world_triangles += grid.index_count/3*batches[i].len()
    if startup_aegean_lod_stats != none and world_frame%60 == 1:
        with_maps: int[] = [loop k in 0..8: 0]
        morphing = 0
        loop slot in world_selected:
            with_maps[world_tiles[slot].maps & 7] += 1
            if world_tiles[slot].lod > f64(world_tiles[slot].level): morphing += 1
        tenths: int[] = [loop k in 0..11: 0]
        loop slot in world_selected: tenths[int(clamp((world_tiles[slot].lod-f64(world_tiles[slot].level))*10.0,0.0,10.0))] += 1
        print("WORLD maps (tiles by which maps they read: bit 1 fields, 2 cover, 4 cliffs) {with_maps} morphing={morphing} by tenths of a level {tenths}")
        print("WORLD tiles={world_selected.len()} cache={world_cache.len()}/{WORLD_CACHE_SLOTS} generated={world_generated} upload={world_uploaded} draws={world_draws} triangles={world_triangles} coast_triangles={coast_triangles} canopy_sheet_tiles={world_shell_tiles}")
    zone_end()
