# UI-independent three-slot storage. Native writes use commit-last independent banks;
# browser writes acknowledge the IndexedDB transaction, never a queued memory copy.
use 'living_types.jo'
use 'living_save.jo'
use 'living_save_codec.jo'
use 'game_session.jo'
use 'living_save_stream.jo'
use 'save_stream.jo'

const GAME_SLOT_COUNT = 3
struct GameSaveStatus:
    ready: bool
    busy: bool
    operation: str
    slot: int
    sequence: int
    error: str
    active_slot = -1

struct GameSlotView:
    slot: int
    exists = false
    compatible = false
    generation = 0
    summary: SaveSummary
    error = ""

# A save in progress: a checkpoint taken in one frame, then checked, written as text,
# hashed and compressed a few milliseconds at a time (step_game_slots), then stored.
const SAVE_DEFLATE_BLOCK = 4096
const SAVE_STEP_BYTES = 8192
struct SaveJob:
    game: SaveGame
    stage = 0                     # 0 checks, 1 template, 2 text, 3 world deflate, 4 session deflate, 5 packed
    check = 0
    build: WorldTextBuild
    text: TextStream
    world_bytes = 0
    world_hash: u64 = 0
    deflate: DeflateStream
    session: DeflateStream

struct GameSlots:
    ready = false
    phase = ""
    operation = ""
    slot = -1
    terrain = 0
    error = ""
    sequence = 0
    busy = false
    loaded: SaveGame?
    pending: BinaryLivingSave
    body = ""                     # compressed bytes only, once packed
    job: SaveJob                  # while phase is "pack": the checkpoint being written

slot_prefix = (slot: int) -> str: "game-slot-{slot}"
valid_slot = (slot: int) -> bool: slot>=0 and slot<GAME_SLOT_COUNT
valid_game_session = (game: SaveGame) -> bool: read_game_session(game) is GameSession

when TARGET=="wasm":
    extern aegean_slots_open = ()
    extern aegean_slots_status = () -> int
    extern aegean_slots_header_size = (slot: int,bank: int) -> int
    extern aegean_slots_header_copy = (slot: int,bank: int,p: *u8,n: int)
    extern aegean_slots_read = (slot: int)
    extern aegean_slots_write = (slot: int,bank: int,generation: int,expected: int,p: *u8,n: int,b: *u8,k: int)
    extern aegean_slots_delete = (slot: int)
    extern aegean_slots_size = (index: int) -> int
    extern aegean_slots_copy = (index: int,p: *u8,n: int)
    extern aegean_slots_release = ()

slot_header_text = (slot: int,bank: int) -> str:
    when TARGET=="wasm":
        n=aegean_slots_header_size(slot,bank)
        if n<1 or n>8000000: return ""
        b=[loop _ in 0..n: u8(0)]; aegean_slots_header_copy(slot,bank,data(b),n)
        str_from_bytes(b)
    else: load_data(slot_prefix(slot)+(if bank==0: "-a" else: "-b")) ?? ""

slot_header = (text: str) -> BinaryLivingSave:
    if text=="": return BinaryLivingSave(valid=false)
    result=from_text[BinaryLivingSave](text)
    if result is TextError: return BinaryLivingSave(valid=false)
    result

list_game_slots = (state: GameSlots,terrain: int) -> GameSlotView[]:
    result: GameSlotView[]
    loop slot in 0..GAME_SLOT_COUNT:
        view=GameSlotView(slot=slot)
        if not state.ready: view.error=if state.error!="": state.error else: "Opening saved games."; result.push(view); continue
        loop bank in 0..2:
            text=slot_header_text(slot,bank)
            if text=="": continue
            view.exists=true; h=slot_header(text)
            if h.valid and h.generation>=view.generation:
                view.generation=h.generation; view.summary=h.summary
                view.compatible=h.schema==3 and (h.encoding==2 or h.encoding==3) and h.terrain_key==terrain and h.session_bytes>0
                view.error=if view.compatible: "" else: "This save needs a compatible game and terrain."
        if view.exists and view.generation==0: view.error="Unrecognised slot; retained unchanged."
        result.push(view)
    result

finish_slot_operation = (state: mut GameSlots,error: str = ""):
    state.busy=false; state.phase=""; state.error=error; state.sequence+=1
    state.body=""; state.pending=BinaryLivingSave(valid=false); state.job=SaveJob()
    when TARGET=="wasm": aegean_slots_release()

init_game_slots = (state: mut GameSlots):
    if state.ready or state.busy: return
    when TARGET=="wasm":
        state.busy=true;state.phase="opening";aegean_slots_open()
    else: state.ready=true

begin_slot_operation = (state: mut GameSlots,slot: int,operation: str,terrain: int = 0) -> bool:
    if not state.ready or state.busy: return false
    if not valid_slot(slot): state.error="Choose one of the three slots."; return false
    state.operation=operation;state.slot=slot;state.terrain=terrain;state.error="";state.loaded=none;state.busy=true
    true

# Start saving `game` (a checkpoint: capture_game or capture_game_snapshot). With spread,
# the work runs in step_game_slots a few milliseconds per frame; otherwise it completes here
# (tests and tools; in a browser the storage write still finishes in poll_game_slots).
save_game_slot = (state: mut GameSlots,slot: int,game: SaveGame,spread: bool = false) -> bool:
    if not begin_slot_operation(state,slot,"save",game.terrain_key): return false
    problem=""
    loop c in game.world.aircraft:
        if c.move_owner==.scene: problem="Fold aircraft scene ownership before saving."
    loop p in game.world.people:
        if p.move_owner==.scene: problem="Fold people scene ownership before saving."
    loop i in 0..game.world.far.vehicles.len():
        if game.world.far.vehicles[i].scene_owned: problem="Fold transport scene ownership before saving."
    if problem!="": finish_slot_operation(state,problem); return true
    # Never overwrite unknown schemas or terrain by accident, even in the older bank.
    loop bank in 0..2:
        text=slot_header_text(slot,bank); h=slot_header(text)
        if text!="" and (not h.valid or h.schema!=3 or (h.encoding!=2 and h.encoding!=3) or h.terrain_key!=game.terrain_key):
            finish_slot_operation(state,"Incompatible or damaged slot retained; delete it explicitly before reuse."); return true
    checkpoint=game; checkpoint.presentation=canonical_presentation(game.world,game.presentation)
    state.job=SaveJob(game=checkpoint,build=world_text_build(game.world)); state.phase="pack"
    if not spread:
        loop state.phase=="pack": step_game_slots(state,1e9)
    true

# One short piece of the save: a check, a template stage, or about SAVE_STEP_BYTES of text
# or compression. "" or the reason the save is refused (the previous banks stay).
_save_job_unit = (j: mut SaveJob) -> str:
    if j.stage==0:
        if j.check<save_check_count():
            error=save_check_step(j.game.world,j.check); j.check+=1
            return error
        if not valid_game_session(j.game): return "Invalid player checkpoint."
        j.stage=1; return ""
    if j.stage==1:
        if world_text_build_step(j.build): j.text=j.build.stream; j.build=WorldTextBuild(world=World(),canonical=World()); j.stage=2
        return ""
    if j.stage==2:
        if not text_step(j.text,SAVE_STEP_BYTES): return ""
        if j.text.error!="":
            # (a container the template could not place: the whole text at once, as before)
            text=canonical_text(j.game.world); j.world_bytes=text.len(); j.world_hash=hash(text); j.deflate=deflate_begin(bytes(text),SAVE_DEFLATE_BLOCK)
        else:
            j.world_bytes=j.text.out.len(); j.world_hash=text_stream_hash(j.text); j.deflate=deflate_begin(j.text.out,SAVE_DEFLATE_BLOCK)
        j.text=TextStream(); j.game.world=World(); j.stage=3
        return ""
    if j.stage==3:
        if deflate_step(j.deflate,SAVE_STEP_BYTES): j.session=deflate_begin(bytes(j.game.session),SAVE_DEFLATE_BLOCK); j.stage=4
        return ""
    if j.stage==4:
        if deflate_step(j.session,SAVE_STEP_BYTES): j.stage=5
    ""

# Advance a save for about budget_ms (at least one piece), then store it once packed.
step_game_slots = (state: mut GameSlots,budget_ms: f64):
    if state.phase!="pack": return
    started=time()
    loop state.job.stage<5:
        error=_save_job_unit(state.job)
        if error!="": finish_slot_operation(state,error); return
        if state.job.stage<5 and (time()-started)*1000>=budget_ms: return
    j=state.job
    packed=deflate_output(j.deflate)
    session=j.game.session
    state.pending=BinaryLivingSave(generation=0,terrain_key=j.game.terrain_key,world_bytes=j.world_bytes,packed_bytes=packed.len(),world_hash=j.world_hash,presentation=j.game.presentation,summary=j.game.summary,session_deflate=if session=="": "" else: base64_encode(deflate_output(j.session)),session_bytes=session.len(),session_hash=hash(session))
    state.body=str_from_bytes(packed); state.job=SaveJob()
    if not binary_save_fits(state.pending): finish_slot_operation(state,"Save exceeds the supported size; previous banks retained."); return
    when TARGET=="wasm":
        # Only the banks' headers and body sizes are needed (no inflate, no parse): the full
        # check of a stored game happens when it is loaded.
        state.phase="save-read"; aegean_slots_read(state.slot)
    else:
        prefix=slot_prefix(state.slot)
        headers=[slot_header_text(state.slot,0),slot_header_text(state.slot,1)]
        sizes=[loop bank in ["-a","-b"]: (load_data(prefix+bank+"-data") ?? "").len()]
        _store_save(state,headers,sizes)

# The bank to write is the one not holding the newest intact generation. Intact here: a
# compatible header and a body of its recorded size; loading checks the rest.
_store_save = (state: mut GameSlots,headers: str[],sizes: int[]):
    best= -1; best_generation=0; expected=0; exists=false
    loop bank in 0..2:
        if headers[bank]=="": continue
        exists=true; h=slot_header(headers[bank]); expected=max(expected,h.generation)
        if not h.valid or h.schema!=3 or (h.encoding!=2 and h.encoding!=3) or h.terrain_key!=state.terrain:
            finish_slot_operation(state,"Incompatible slot retained unchanged."); return
        if sizes[bank]==h.packed_bytes and (best<0 or h.generation>best_generation): best=bank; best_generation=h.generation
    if exists and best<0: finish_slot_operation(state,"No intact previous generation; delete this damaged slot explicitly before reuse."); return
    target=if best<0: 0 else: 1-best
    state.pending.generation=expected+1
    when TARGET=="wasm":
        text=to_text(state.pending)
        aegean_slots_release()
        aegean_slots_write(state.slot,target,state.pending.generation,expected,data(text),text.len(),data(state.body),state.body.len())
        state.body="";state.pending=BinaryLivingSave(valid=false);state.phase="save-write"
    else:
        name=slot_prefix(state.slot)+(if target==0: "-a" else: "-b")
        # The header is committed last: until then the older header still names its own body.
        if not save_data(name+"-data",state.body): finish_slot_operation(state,"write failed: {file_error()}; previous slot retained"); return
        if not save_value(name,state.pending): finish_slot_operation(state,"header write failed: {file_error()}; previous slot retained"); return
        finish_slot_operation(state)

load_game_slot = (state: mut GameSlots,slot: int,terrain: int) -> bool:
    if not begin_slot_operation(state,slot,"load",terrain): return false
    when TARGET=="wasm": state.phase="load-read";aegean_slots_read(slot)
    else:
        game=load_game(terrain,slot_prefix(slot),valid_game_session)
        if game is SaveGame: state.loaded=game; finish_slot_operation(state)
        else: finish_slot_operation(state,game.message)
    true

delete_game_slot = (state: mut GameSlots,slot: int) -> bool:
    if not begin_slot_operation(state,slot,"delete"): return false
    when TARGET=="wasm": state.phase="delete";aegean_slots_delete(slot)
    else:
        error=""
        loop bank in ["-a","-b"]:
            loop suffix in ["","-data"]:
                name=slot_prefix(slot)+bank+suffix
                if load_data(name)!=none and not delete_data(name): error="Some save files could not be deleted."
        finish_slot_operation(state,error)
    true

when TARGET=="wasm":
    slot_buffer = (index: int) -> str:
        n=aegean_slots_size(index)
        if n<1 or n>16000000: return ""
        b=[loop _ in 0..n: u8(0)];aegean_slots_copy(index,data(b),n)
        str_from_bytes(b)

poll_game_slots = (state: mut GameSlots):
    when TARGET=="wasm":
        # (while packing, storage is idle: its last status belongs to the previous operation)
        if not state.busy or state.phase=="pack": return
        status=aegean_slots_status()
        if status==1: return
        if status<0:
            error=slot_buffer(4)
            finish_slot_operation(state,if error!="": error else: "Browser storage is unavailable.");return
        if status!=2: return
        if state.phase=="opening": state.ready=true;finish_slot_operation(state);return
        if state.phase=="save-read":
            _store_save(state,[slot_buffer(0),slot_buffer(2)],[int(aegean_slots_size(1)),int(aegean_slots_size(3))])
            return
        if state.phase=="load-read":
            best: SaveGame?
            # Read candidates in header order, keeping only one parsed World alive.
            a=slot_header(slot_buffer(0));b=slot_header(slot_buffer(2))
            banks=if b.generation>a.generation:[1,0] else:[0,1]
            loop bank in banks:
                h=if bank==0:a else:b
                if not h.valid or h.schema!=3 or (h.encoding!=2 and h.encoding!=3) or h.terrain_key!=state.terrain:continue
                if let game=unpack_binary_living_save(h,slot_buffer(bank*2+1)):
                    if validate_save_world(game.world)=="" and valid_game_session(game):best=game;break
            if best==none: finish_slot_operation(state,"No compatible intact game in this slot; the stored data is unchanged.")
            else: state.loaded=best;finish_slot_operation(state)
            return
        finish_slot_operation(state)
    else: pass

take_game_slot = (state: mut GameSlots) -> SaveGame?:
    result=state.loaded;state.loaded=none;result
