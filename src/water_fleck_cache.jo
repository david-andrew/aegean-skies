# Exact procedural cell hashes, memoized near inland water. This is not a
# repeating image: every texel belongs to its original world cell and seed.
# Outside the published rectangle the shader uses the original hash function.
struct WaterFleckWindow:
    x:int=0
    z:int=0
    rows:int=0
    initialized:bool=false
water_fleck_windows:WaterFleckWindow[]=[WaterFleckWindow(),WaterFleckWindow(),WaterFleckWindow()]
water_fleck_texture=Texture()
water_fleck_frame= -1
water_fleck_sizes:f64[3]=[1.3,3.6,10.0]
water_fleck_counts:int[3]=[512,256,128]
water_fleck_offsets:int[3]=[0,512,768]
water_fleck_hash=(cell:vec2,seed:f32)->vec4:
    vec4(hash21(cell+vec2(41.0+seed,7)),hash21(cell+vec2(3,59.0+seed)),hash21(cell+vec2(17.0+seed,23)),1)
water_fleck_slot=(x:int,n:int)->int:((x%n)+n)%n

water_fleck_upload=(band:int,x:int,z:int,width:int,height:int):
    n=water_fleck_counts[band];offset=water_fleck_offsets[band]
    row=0
    loop row<height:
        sz=water_fleck_slot(z+row,n);h=min(height-row,n-sz)
        column=0
        loop column<width:
            sx=water_fleck_slot(x+column,n);w=min(width-column,n-sx)
            pixels:vec4[]
            loop j in 0..h:
                loop i in 0..w:pixels.push(water_fleck_hash(vec2(f32(x+column+i),f32(z+row+j)),f32(band)*13.0))
            gl_tex_sub_image(sx,offset+sz,w,h,GL_RGBA,GL_FLOAT,data(pixels) as *u8,pixels.len()*size_of(vec4))
            column+=w
        row+=h

prepare_water_flecks=(cam:vec3):
    global water_fleck_texture,water_fleck_frame,water_fleck_windows
    if water_fleck_frame==frame_number():return
    water_fleck_frame=frame_number()
    flush()
    if water_fleck_texture.id==0:
        id=gl_create_texture()
        water_fleck_texture=Texture(id,512,896)
        glBindTexture(GL_TEXTURE_2D,u32(id))
        gl_tex_image(512,896,0x8814,GL_RGBA,GL_FLOAT,null,0)
        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,i32(GL_NEAREST))
        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,i32(GL_NEAREST))
    else:glBindTexture(GL_TEXTURE_2D,u32(water_fleck_texture.id))
    loop band in 0..3:
        n=water_fleck_counts[band];size=water_fleck_sizes[band]
        x=int(floor(f64(cam.x)/size))-n/2;z=int(floor(f64(cam.z)/size))-n/2
        state=water_fleck_windows[band]
        dx=x-state.x;dz=z-state.z
        if not state.initialized or abs(dx)+abs(dz)>32:
            state=WaterFleckWindow(x,z,0,true)
        if state.rows<n:
            rows=min(16,n-state.rows)
            water_fleck_upload(band,state.x,state.z+state.rows,n,rows)
            state.rows+=rows
        else:
            # Retain overlap in a toroidal texture; upload only entering strips.
            if dx>0:water_fleck_upload(band,state.x+n,z,dx,n)
            else if dx<0:water_fleck_upload(band,x,z,-dx,n)
            if dz>0:water_fleck_upload(band,x,state.z+n,n,dz)
            else if dz<0:water_fleck_upload(band,x,z,n,-dz)
            state.x=x;state.z=z
        water_fleck_windows[band]=state

water_fleck_rects=()->vec4[3]:
    rects:vec4[3]
    loop band in 0..3:
        state=water_fleck_windows[band]
        rects[band]=vec4(f32(state.x),f32(state.z),f32(state.x+water_fleck_counts[band]),f32(state.z+state.rows))
    rects
