# Shared summer ecology/material controls. No independent seasonal calendar.
use 'look.jo'
const PLANT_KINDS = 6
const OLIVE = 3
const OLEANDER = 4
const PRICKLY_PEAR = 5

# Stable summer cover, not a response to the moving sun. Coordinates are
# x east / z south. Exposed low south slopes cure to straw; cooler folds retain
# grey-green scrub and upland/north-facing patches support darker pine masses.
# x = dryness, y = maquis fraction, z = pine fraction (y+z <= 1).
summer_cover = (n: vec3, height: f32, ridge: f32, patch: f32) -> vec3:
    south = n.z
    lowland = 1.0-smoothstep(180.0,750.0,height)
    dry = clamp(0.62+south*0.30+ridge*0.17+lowland*0.12-(patch-0.5)*0.30,0.0,1.0)
    scrub = smoothstep(0.30,0.58,patch-ridge*0.08-south*0.08)*(1.0-dry*0.12)
    upland = smoothstep(35.0,300.0,height)*(1.0-smoothstep(1500.0,2200.0,height))
    pine = smoothstep(0.38,0.64,patch-south*0.16-ridge*0.12)*upland*(1.0-dry*0.45)
    vec3(dry,scrub*(1.0-pine),pine)

orchard_cover = (p: vec2,h: f32,slope: f32) -> f32:
    if h <= 8.0 or h >= 500.0 or slope >= 0.58: return 0.0
    parcel = vnoise(p*0.0027+vec2(41,17))
    smoothstep(0.50,0.67,parcel)*smoothstep(8.0,28.0,h)*(1.0-smoothstep(250.0,500.0,h))*(1.0-smoothstep(0.38,0.58,slope))

plant_vertices = (kind: int) -> Vertex3D[]:
    vs: Vertex3D[]
    if kind == OLIVE:
        wood = rgb(0.38,0.34,0.25)
        add_cylinder(vs,vec3(0,-0.5,0),0.4,2.4,wood,6,0.24,rotation_z(0.13))
        loop k in 0..3:
            a = f64(k)*TAU/3.0
            m = rotation_y(a)*rotation_z(0.48)
            add_cylinder(vs,vec3(0,0,0),0.2,2.3,wood,5,0.08,translation(vec3(0,1.5,0))*m)
            p = vec3(f32(cos(a)*1.5),3.4,f32(sin(a)*1.5))
            add_sphere(vs,vec3(0,0,0),1.0,if k%2 == 0: rgb(0.38,0.43,0.28) else: rgb(0.29,0.36,0.22),6,3,translation(p)*scaling(vec3(2.0,1.2,1.8)))
        add_sphere(vs,vec3(0,0,0),1.0,rgb(0.48,0.51,0.34),6,3,translation(vec3(0,4.0,0))*scaling(vec3(2.1,1.0,2.0)))
    else if kind == OLEANDER:
        loop k in 0..3:
            p = vec3(f32(k-1)*0.75,0.9,f32(k%2)*0.4)
            add_sphere(vs,vec3(0,0,0),1.0,rgb(0.16,0.31,0.15),5,2,translation(p)*scaling(vec3(0.9,1.4,0.85)))
            add_sphere(vs,p+vec3(0.15,1.1,0),0.28,rgb(0.76,0.37,0.43),4,2)
    else:
        loop k in 0..5:
            m = translation(vec3(f32(k%3-1)*0.45,f32(k/3)*0.65,0))*rotation_z(f64(k-2)*0.22)
            add_sphere(vs,vec3(0,0,0),1.0,if k%2 == 0: rgb(0.3,0.42,0.25) else: rgb(0.38,0.48,0.28),5,2,m*translation(vec3(0,0.6,0))*scaling(vec3(0.42,0.7,0.14)))
    vs
