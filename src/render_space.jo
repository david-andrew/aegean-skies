# One spherical render chart; simulation, placement and material phase stay flat.
# Rationalized sagitta avoids subtracting nearly equal Earth radii in f32.
const EARTH_RADIUS = 6371000.0

world_drop = (q: vec2) -> f32:
    rr = dot(q, q)
    r: f32 = EARTH_RADIUS
    rr / (r + sqrt(max(r * r - rr, 1.0)))

render_world = (p: vec3, cam: vec3) -> vec3:
    vec3(p.x, p.y - world_drop(p.xz - cam.xz), p.z)

render_normal = (n: vec3, p: vec3, cam: vec3) -> vec3:
    q = p.xz - cam.xz
    root = sqrt(max(f32(EARTH_RADIUS * EARTH_RADIUS) - dot(q, q), 1.0))
    normalize(vec3(n.x + n.y * q.x / root, n.y, n.z + n.y * q.y / root))

# Snapped origin for patch coordinates, separate from absolute material phase.
render_origin = (cam: vec3) -> vec3:
    vec3(f32(floor(f64(cam.x) / 1024.0) * 1024.0), 0, f32(floor(f64(cam.z) / 1024.0) * 1024.0))

# Stable nearest positive sea intersection, in meters. -1 means unobstructed sky.
sea_intersection = (dir: vec3, altitude: f32) -> f32:
    h = max(altitude, 0.001)
    r: f32 = EARTH_RADIUS
    b = (r + h) * dir.y
    c = h * (2.0 * r + h)
    disc = b * b - c
    if b >= 0.0 or disc < 0.0: return -1.0
    c / (-b + sqrt(max(disc, 0.0)))

world_far = (altitude: f64) -> f64:
    h = max(altitude, 1.0)
    # Includes elevated features; the analytic ocean itself has no far plane.
    max(30000.0, sqrt(h * (2.0 * EARTH_RADIUS + h)) + 180000.0)

behind_sea = (world: vec3, cam: vec3) -> bool:
    flat = world - cam
    if dot(flat, flat) < 195000000.0: return false
    q = render_world(world, cam) - cam
    dist = length(q)
    if dist < 14000.0 or cam.y < 0.0: return false
    hit = sea_intersection(q / max(dist, 0.001), cam.y)
    hit > 0.0 and hit < dist - 2.0

# Translation-free perspective rays. Inverting a far projection and subtracting
# a kilometre-high camera loses precision even when the sphere roots are stable.
# The first two VP rows are the scaled right/up axes; its fourth is forward.
render_rays = (vp: mat4) -> mat4:
    right = vec3(vp[0].x, vp[1].x, vp[2].x)
    up = vec3(vp[0].y, vp[1].y, vp[2].y)
    forward = vec3(vp[0].w, vp[1].w, vp[2].w)
    m = mat4(0)
    m[0] = vec4(right / max(dot(right, right), 0.000001), 0)
    m[1] = vec4(up / max(dot(up, up), 0.000001), 0)
    m[2] = vec4(forward, 0)
    m
