use 'world_point.jo'
# One local spherical render chart; simulation and persistent placement stay flat.
# Rationalized sagitta avoids subtracting nearly equal Earth radii in f32.
const EARTH_RADIUS = 6371000.0

world_drop = (q: vec2) -> f32:
    rr = dot(q, q)
    r: f32 = EARTH_RADIUS
    rr / (r + sqrt(max(r * r - rr, 1.0)))

render_world = (p: vec3, cam: vec3) -> vec3:
    vec3(p.x, p.y - world_drop(p.xz - cam.xz), p.z)

# A trial for the feel of speed (the pause menu's "Stretch"): space ahead of the aircraft drawn
# stretched along its heading close in and squeezed beyond, true again `zone` meters out, so the
# near world rushes past faster while the far approaches at the true rate. Fixed to the aircraft,
# so nothing doubles or jumps; it starts a few meters ahead of it (the aircraft, its pilot and
# cloth are never warped) and fades off to the sides.
#   a: the aircraft (x, z) and its heading (x, z); b: k - 1 (0: none), zone, start, 0
scene_warp_a = vec4(0, 0, 0, 1)
scene_warp_b = vec4(0, 0, 0, 0)
set_scene_warp = (at: vec3, heading: vec3, k: f64, zone: f64):
    global scene_warp_a, scene_warp_b
    h = vec3(heading.x, 0, heading.z)
    if f64(length(h)) < 0.001 or k <= 1.0001:
        scene_warp_b = vec4(0, 0, 0, 0)
        return
    h = normalize(h)
    scene_warp_a = vec4(at.x, at.z, h.x, h.z)
    scene_warp_b = vec4(f32(k - 1.0), f32(zone), 8.0, 0)

# where a point is drawn, warped (its excess along the heading: (k-1) d (1 - d/zone)^3, which
# stretches by k at the start, squeezes by at most a quarter of (k-1) mid-zone, and is back to
# true, smoothly, at the zone's end)
warp_pos = (p: vec3, a: vec4, b: vec4) -> vec3:
    rel = p.xz - a.xy
    d = dot(rel, a.zw) - b.z
    lat = abs(dot(rel, vec2(-a.w, a.z)))
    x = clamp(d / max(b.y, 1.0), 0.0, 1.0)
    on = step(0.00001, b.x) * step(0.0, d) * step(x, 0.99999) * (1.0 - smoothstep(b.y * 0.5, b.y * 1.5, lat))
    e = b.x * max(d, 0.0) * (1.0 - x) * (1.0 - x) * (1.0 - x) * on
    vec3(p.x + a.z * e, p.y, p.z + a.w * e)

render_warped = (p: vec3, cam: vec3, a: vec4, b: vec4) -> vec3: render_world(warp_pos(p, a, b), cam)

render_normal = (n: vec3, p: vec3, cam: vec3) -> vec3:
    q = p.xz - cam.xz
    root = sqrt(max(f32(EARTH_RADIUS * EARTH_RADIUS) - dot(q, q), 1.0))
    normalize(vec3(n.x + n.y * q.x / root, n.y, n.z + n.y * q.y / root))

# Snapped origin for patch coordinates, separate from absolute material phase.
render_origin = (cam: vec3) -> vec3:
    vec3(f32(floor(f64(cam.x) / 1024.0) * 1024.0), 0, f32(floor(f64(cam.z) / 1024.0) * 1024.0))

# Stable nearest positive sea intersection, in meters. -1 means unobstructed sky.
sea_intersection = (dir: vec3, altitude: f32) -> f32:
    h = max(altitude, 0.001)
    r: f32 = EARTH_RADIUS
    b = (r + h) * dir.y
    c = h * (2.0 * r + h)
    disc = b * b - c
    if b >= 0.0 or disc < 0.0: return -1.0
    c / (-b + sqrt(max(disc, 0.0)))

world_far = (altitude: f64) -> f64:
    h = max(altitude, 1.0)
    # Includes elevated features; the analytic ocean itself has no far plane.
    max(30000.0, sqrt(h * (2.0 * EARTH_RADIUS + h)) + 210000.0)

behind_sea = (world: vec3, cam: vec3) -> bool:
    flat = world - cam
    if dot(flat, flat) < 195000000.0: return false
    q = render_world(world, cam) - cam
    dist = length(q)
    if dist < 14000.0 or cam.y < 0.0: return false
    hit = sea_intersection(q / max(dist, 0.001), cam.y)
    hit > 0.0 and hit < dist - 2.0

# Translation-free perspective rays. Inverting a far projection and subtracting
# a kilometre-high camera loses precision even when the sphere roots are stable.
# The first two VP rows are the scaled right/up axes; its fourth is forward.
render_rays = (vp: mat4) -> mat4:
    right = vec3(vp[0].x, vp[1].x, vp[2].x)
    up = vec3(vp[0].y, vp[1].y, vp[2].y)
    forward = vec3(vp[0].w, vp[1].w, vp[2].w)
    m = mat4(0)
    m[0] = vec4(right / max(dot(right, right), 0.000001), 0)
    m[1] = vec4(up / max(dot(up, up), 0.000001), 0)
    m[2] = vec4(forward, 0)
    m

# Construct the view in the local chart. Never cancel an absolute view-projection
# translation: that matrix has already rounded away the nearby depth bits.
render_view_proj = (origin: vec3) -> mat4:
    view = __view
    eye = render_eye(origin)
    view[3] = vec4(
        f32(-(f64(view[0].x)*f64(eye.x)+f64(view[1].x)*f64(eye.y)+f64(view[2].x)*f64(eye.z))),
        f32(-(f64(view[0].y)*f64(eye.x)+f64(view[1].y)*f64(eye.y)+f64(view[2].y)*f64(eye.z))),
        f32(-(f64(view[0].z)*f64(eye.x)+f64(view[1].z)*f64(eye.y)+f64(view[2].z)*f64(eye.z))),1)
    __proj3*view

render_model = (model: mat4, origin: vec3) -> mat4:
    m = model
    m[3] = vec4(model[3].xyz-origin,model[3].w)
    m

render_anchor = (anchor: vec4, origin: vec3) -> vec4:
    vec4(anchor.xy-origin.xz,anchor.zw)

# CPU phase reduction before f32 upload. Positive for negative world coordinates.
render_phase = (x: f64, period: f64) -> f32: f32(x-floor(x/period)*period)

# FlyCamera's default one-metre aim loses angular precision at country coordinates.
# A long aim vector preserves the direction without moving the camera or simulation.
render_camera = (eye: vec3, direction: vec3, fov: f64, near: f64, far: f64, up: vec3 = vec3(0,1,0)):
    camera3d(eye,eye+normalize(direction)*16384.0,fov,near,far,up)

# Standard lit effects use the same chart as custom materials. Call in a 3D
# callback so camera axes/projection refer to the pass being rendered.
render_lit_params = (origin: vec3,emissive: f32) -> LitParams:
    LitParams(view_proj=render_view_proj(origin),model=mat4(),color=vec4(1,1,1,1),cam_pos=render_eye(origin),
        sun_dir=__sun_dir,sun_color=__sun_color,sky_color=__sky_top*0.6+__sky_horizon*0.4,ground_color=__ground_color,
        fog_color=__fog_color,fog_density=__fog_density,fog_height=__fog_height,emissive=emissive,specular=0)

# Precise positions at the CPU/render boundary. Existing world IDs, saves and
# broad-phase queries may use the rounded vec3; motion never accumulates in it.
# A camera's low part is not folded back into an absolute f32 matrix. Reset for
# each draw before choosing a camera; precise cameras then supply the low part.
render_eye_low = vec3(0,0,0)
render_eye = (origin: vec3) -> vec3: (scene_camera()-origin)+render_eye_low
precise_camera = (eye: WorldPoint,direction: vec3,fov: f64,near: f64,far: f64,up: vec3=vec3(0,1,0)):
    global render_eye_low
    render_camera(world_vec(eye),direction,fov,near,far,up)
    render_eye_low = world_residual(eye)

struct FollowFrame:
    origin: vec3
    ready = false

# FollowCamera stores its smoothed target locally. Re-charting translates both
# targets before smoothing, so crossing a chart edge cannot move the camera.
update_local_follow = (c: mut FollowCamera,frame: mut FollowFrame,target: WorldPoint,dt: f64,input: bool = true):
    origin=render_origin(world_vec(target))
    if frame.ready:
        c.target += frame.origin-origin
        c.shown_target += frame.origin-origin
    else: c.placed=false
    frame.origin=origin; frame.ready=true
    update(c,world_local(target,origin),dt,input=input)

place_local_follow = (c: FollowCamera,frame: FollowFrame,fov: f64,near: f64,far: f64):
    local=position(c)
    eye=WorldPoint(f64(frame.origin.x)+f64(local.x),f64(local.y),f64(frame.origin.z)+f64(local.z))
    # The direction is computed before the large world translation is added.
    precise_camera(eye,aim(c)-local,fov,near,far)

# View-only actor offsets from published poses, shared with carried cargo.
# NPC entries include interpolation lag as well as the sub-centimetre low part.
# These never replace persistent actor coordinates or identities.
actor_render_offsets: {int:vec3}
