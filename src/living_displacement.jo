# Civilian flight follows an available real carrier on an actual adjacent road/sea lane.
use 'living_place_context.jo'
# Citizenship and the households' own funds travel; neither capture nor arrival mint residents.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_war.jo'
use 'living_far_stock.jo'
use 'living_far_checks.jo'
use 'living_far_news.jo'
use 'living_money.jo'
use 'living_guard.jo'

_evacuation = (w: mut World, origin: int, vehicle: int, link: int) -> bool:
    if not (origin in w.far.districts) or vehicle<0 or vehicle>=w.far.vehicles.len() or link<0 or link>=w.far.links.len(): return false
    d=w.far.districts[origin]; v=w.far.vehicles[vehicle]; l=w.far.links[link]
    if v.place!=origin or v.journey>=0 or v.scene_owned or v.duty!=.merchant or v.cargo.roots.len()>0 or v.motion_blocked!="" or v.hull<=350 or v.kind!=l.mode or (l.a!=origin and l.b!=origin): return false
    destination=if l.a==origin: l.b else: l.a
    if w.far.districts[destination].controller!=d.born_country: return false
    # People choose safety when their town is occupied or actual scarcity/danger is severe.
    if d.controller==d.born_country and d.hunger<350 and d.danger<350: return false
    if d.displaced_day==day_index(w.minute): return false
    available=d.workers[d.born_country]+d.dependents[d.born_country]-d.pending_workers[d.born_country]
    count=min(32,min(available/8,max(0,(v.capacity_grams-inventory_mass(w,v.provisions))/75000)))
    if count<1: return false
    adults=min(count*3/5,d.workers[d.born_country]); children=count-adults
    if children>d.dependents[d.born_country]-d.pending_workers[d.born_country]:
        adults=count-min(children,d.dependents[d.born_country]-d.pending_workers[d.born_country]); children=count-adults
    if adults>d.workers[d.born_country]: return false
    # Calculate the journey's actual provisions before committing any population change.
    days=max(1,(l.length_mm/v.speed_mm_sec/2+1439)/1440)+2
    food=count*28*days
    crew=v.crew[0]+v.crew[1]+v.crew[2]
    crew_food=max(0,crew*28*days-v.provisions.qty[3])
    quote=max(1,d.prices[3]); food_cost=max(1,(food*quote+999)/1000)
    fare=max(40,days*count*20)
    population=0
    loop c in 0..3: population+=d.workers[c]+d.dependents[c]
    money=w.accounts[d.household_account].cents*count/max(1,population)
    if money<food_cost+fare or far_market_qty(w,origin,3)<food+crew_food: return false
    if not war_start_leg(w,vehicle,link,.refugee): return false
    journey=w.far.vehicles[vehicle].journey
    escrow=new_account(w,"refugees:{journey}")
    if not transfer(w,d.household_account,escrow,money,.wage,journey): return false
    if not transfer(w,escrow,d.market_account,food_cost,.trade,journey) or not transfer(w,escrow,v.account,fare,.rent,journey): return false
    batch=far_take_market(w,origin,3,food)
    if not far_stock_add(w.far.vehicles[vehicle].provisions,batch): return false
    citizen=d.born_country
    w.far.districts[origin].workers[citizen]-=adults
    w.far.districts[origin].dependents[citizen]-=children
    w.far.districts[origin].displaced_day=day_index(w.minute)
    w.far.journeys[journey].refugees[citizen]=count
    w.far.journeys[journey].refugee_workers[citizen]=adults
    w.far.journeys[journey].passenger_account=escrow
    far_local_news(w,origin,"evacuation","{count} {w.countries[citizen].name} residents paid for passage from {life_place_name(w,origin)} to {life_place_name(w,destination)}.",country=citizen,severity=650)
    true

evacuate_households = (w: mut World, origin: int, vehicle: int, link: int) -> bool:
    # Infrequent departure transaction, including ordinary refusals; never a frame checkpoint.
    before=w
    if _evacuation(w,origin,vehicle,link): return true
    w=before
    false

displacement_minute = (w: mut World):
    if not w.far.populated or w.minute%60!=0: return
    # Stagger one actual community per hour. A nearby observer does not create a boat or family.
    if w.far.place_ids.len()==0: return
    first=(w.minute/60)%60
    loop index in first,first+60..w.far.place_ids.len():
        place=w.far.place_ids[index]; d=w.far.districts[place]
        if d.controller==d.born_country and d.hunger<350 and d.danger<350: continue
        departed=false
        loop v in w.far.vehicles:
            if departed: break
            if v.place!=place or v.journey>=0 or v.duty!=.merchant: continue
            edges=d.links; edges.sort()
            loop link in edges:
                if evacuate_households(w,place,v.id,link): departed=true; break
