use 'living_guard.jo'
use 'living_transaction.jo'
# Funded private buyers and identified docking searches; no manufactured contraband.
use 'living_types.jo'
use 'living_cargo.jo'
use 'living_money.jo'
use 'living_events.jo'
use 'living_seed.jo'

_guarded_sell_discreet = (w: mut World, seller: int, buyer: int, qty: int, craft: int = -1) -> bool:
    if seller < 0 or seller >= w.people.len() or (buyer != 6 and buyer != 20) or qty <= 0 or qty > 1000: return false
    place = w.people[seller].place
    if place < 0 or w.people[buyer].place != place: return false
    key = RelationshipKey(buyer,seller)
    if not (key in w.relationship_index) or w.relationships[w.relationship_index[key]].trust < 600: return false
    already = if w.people[buyer].tobacco_day == day_index(w.minute): w.people[buyer].tobacco_bought else: 0
    if already+qty > 1000: return false
    if craft >= 0:
        if craft >= w.aircraft.len() or w.aircraft[craft].owner != seller or w.aircraft[craft].place != place or available(w.aircraft[craft].cargo,7) < qty: return false
    else if available(w.people[seller].pocket,7) < qty: return false
    bill = qty*w.goods[7].base_cents*140/100000
    if w.accounts[w.people[buyer].account].cents < bill: return false
    if not (transfer(w,w.people[buyer].account,w.people[seller].account,bill,.trade)):
        living_fault("living_contraband.sell_discreet.0",guard_context(w)+" seller={seller} buyer={buyer} qty={qty} craft={craft}")
        return false
    if not (cargo_move(w,if craft >= 0: CargoStore.aircraft else: CargoStore.pocket,if craft >= 0: craft else: seller,.pocket,buyer,7,qty,buyer,w.people[buyer].place)):
        living_fault("living_contraband.sell_discreet.1",guard_context(w)+" seller={seller} buyer={buyer} qty={qty} craft={craft}")
        return false
    if craft >= 0: w.aircraft[craft].cargo.qty[7] -= qty
    else: w.people[seller].pocket.qty[7] -= qty
    w.people[buyer].pocket.qty[7] += qty
    w.people[buyer].tobacco_day = day_index(w.minute); w.people[buyer].tobacco_bought = already+qty
    true

_guarded_arrival_search = (w: mut World, trip: int):
    if w.trips[trip].searched: return
    w.trips[trip].searched = true
    place = w.trips[trip].destination; c = w.trips[trip].craft; p = w.trips[trip].actor
    if place == 5 or c < 0 or w.people[9].place != place: return
    key = ReputationKey(place,.person,p)
    chance = if w.reputation.get(key,0) < -300: 300000 else: 100000
    if draw1000000(w.seed,50,trip,w.trips[trip].departed_tick/120,77) >= chance: return
    if w.aircraft[c].cargo.qty[7] == 0 and w.aircraft[c].cargo.qty[8] == 0: return
    id = w.next_aftermath; w.next_aftermath += 1
    r = Reason(purpose=.trade,actor=p,counterparty=9,origin=w.trips[trip].origin,destination=place,amount_cents=2000)
    # Purpose uses trade in schema v1: contraband is an illegal method of trade.
    r.purpose = .trade
    w.aftermath[id] = Aftermath(id=id,kind=.crate,event=-1,owner=5,place=place,pos=w.harbors[place].center,reason=r,created_minute=w.minute,expires_minute=-1)
    loop g in [7,8]:
        qty = w.aircraft[c].cargo.qty[g]
        reserved = w.aircraft[c].cargo.reserved[g]
        if not (cargo_move(w,.aircraft,c,.aftermath,id,g,qty,w.aircraft[c].owner,w.people[w.aircraft[c].owner].place,-2)):
            living_fault("living_contraband.arrival_search.2",guard_context(w)+" trip={trip}")
            return
        w.aftermath[id].inventory.qty[g] += qty
        w.aircraft[c].cargo.qty[g] = 0; w.aircraft[c].cargo.reserved[g] = 0
        loop job in w.aircraft[c].job_manifests:
            if reserved <= 0: break
            if w.jobs[job].good != g: continue
            n = min(reserved,w.jobs[job].loaded_quantity-w.jobs[job].delivered_quantity-w.jobs[job].lost_quantity)
            w.jobs[job].lost_quantity += n; reserved -= n
    paid = min(2000,w.accounts[w.people[p].account].cents)
    if paid > 0:
        if not (transfer(w,w.people[p].account,w.factions[0].account,paid,.fine,trip)):
            living_fault("living_contraband.arrival_search.3",guard_context(w)+" trip={trip}")
            return
    if paid < 2000: seed_obligation(w,"search-fine-{trip}",p,-1,.rent,w.minute+60,w.minute+1440,2000-paid,place)
    event = emit_event(w,.fine,place,p,9,r,2000)
    w.aftermath[id].event = event


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
sell_discreet = (w: mut World, seller: int, buyer: int, qty: int, craft: int = -1) -> bool:
    if guard_blocked(): return false
    scope = guard_begin(w)
    result = _guarded_sell_discreet(w,seller,buyer,qty,craft)
    failed = guard_failed(scope)
    guard_finish(w,scope)
    if failed: false else: result

arrival_search = (w: mut World, trip: int):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_arrival_search(w,trip)
    guard_finish(w,scope)
