# Cached paving keeps its contact geometry, but off-screen town blocks need not
# submit every refined vertex. Both caches reuse a bounded set of GPU buffers.
use 'render_space.jo'

const PAVING_BLOCKS = 128

struct PavingBlock:
    vertices: Vertex3D[]
    low: vec3 = vec3(1e9,1e9,1e9)
    high: vec3 = vec3(-1e9,-1e9,-1e9)

struct PavingDraw:
    meshes: Mesh[]
    centers: vec3[]
    radii: f32[]
    count: int = 0

paving_blocks = (vs: Vertex3D[]) -> PavingBlock[]:
    keys: {str: int}
    blocks: PavingBlock[]
    loop k in 0..vs.len()/3:
        center = (vs[k*3].pos+vs[k*3+1].pos+vs[k*3+2].pos)/3.0
        x = int(floor(center.x/64.0)); z = int(floor(center.z/64.0))
        key = "{x},{z}"
        slot = keys.get(key,-1)
        if slot < 0:
            slot = min(blocks.len(),PAVING_BLOCKS)
            if slot == blocks.len(): blocks.push(PavingBlock())
            keys[key] = slot
        loop j in 0..3:
            v = vs[k*3+j]
            blocks[slot].vertices.push(v)
            blocks[slot].low = min(blocks[slot].low,v.pos)
            blocks[slot].high = max(blocks[slot].high,v.pos)
    blocks

set_paving = (cache: mut PavingDraw,vs: Vertex3D[]):
    blocks = paving_blocks(vs)
    cache.count = vs.len()
    cache.centers = []; cache.radii = []
    empty: Vertex3D[]
    loop k in 0..blocks.len():
        if k == cache.meshes.len(): cache.meshes.push(custom_mesh(empty))
        m = cache.meshes[k]
        update_mesh(m,blocks[k].vertices)
        cache.meshes[k] = m
        cache.centers.push((blocks[k].low+blocks[k].high)*0.5)
        cache.radii.push(length(blocks[k].high-blocks[k].low)*0.5)
    # Release old payloads when the next town uses fewer blocks.
    loop k in blocks.len()..cache.meshes.len():
        m = cache.meshes[k]
        update_mesh(m,empty)
        cache.meshes[k] = m

paving_planes = (m: mat4) -> vec4[]:
    row = (i: int) -> vec4: vec4(m[0][i],m[1][i],m[2][i],m[3][i])
    a = row(0); b = row(1); c = row(2); d = row(3)
    [loop p in [d+a,d-a,d+b,d-b,d+c,d-c]: p/max(length(p.xyz),0.000001)]

paving_visible = (center: vec3,radius: f32,cam: vec3,origin: vec3,planes: vec4[]) -> bool:
    # The legacy shader is flat; the close-town shader curves down. Expanding
    # by the largest possible drop safely encloses both. Warp trials bypass culling.
    if scene_warp_b.x > 0.0: return true
    reach = f64(length(center.xz-cam.xz)+radius)
    bound = f64(radius)+reach*reach/EARTH_RADIUS+1.0
    p = center-origin
    loop plane in planes:
        if f64(dot(plane.xyz,p)+plane.w) < -bound: return false
    true

draw_paving[U] = (cache: PavingDraw,sh: Shader,params: U,cam: vec3):
    origin = render_origin(cam)
    planes = paving_planes(render_view_proj(origin))
    loop k in 0..cache.centers.len():
        if paving_visible(cache.centers[k],cache.radii[k],cam,origin,planes): draw(sh,cache.meshes[k],params)
