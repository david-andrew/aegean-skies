# Conservative CPU occlusion for cached close decoration. Each corner of the
# object's bounding cube must be hidden from every corner of the camera's
# movement box by the same solid house. Roofs and chimneys use the same test.
use 'town_sites.jo'

town_wall_hit = (s: TownSite,eye: vec3,target: vec3) -> bool:
    a=site_local(s,eye.xz); b=site_local(s,target.xz)
    p=vec3(a.x,eye.y-s.at.y,a.y); q=vec3(b.x,target.y-s.at.y,b.y); d=q-p
    low=vec3(f32(-s.width*0.5+0.05),0.05,f32(-s.depth*0.5+0.05))
    high=vec3(f32(s.width*0.5-0.05),f32(s.height-0.05),f32(s.depth*0.5-0.05))
    enter=0.001; leave=0.999
    loop axis in 0..3:
        start=if axis==0: p.x else: if axis==1: p.y else: p.z
        delta=if axis==0: d.x else: if axis==1: d.y else: d.z
        lo=if axis==0: low.x else: if axis==1: low.y else: low.z
        hi=if axis==0: high.x else: if axis==1: high.y else: high.z
        if abs(delta)<0.00001:
            if start<=lo or start>=hi: return false
        else:
            u=(lo-start)/delta; v=(hi-start)/delta
            enter=max(enter,f64(min(u,v))); leave=min(leave,f64(max(u,v)))
            if enter>=leave: return false
    true

town_hidden = (sites: TownSite[],cam: vec3,center: vec3,radius: f32,guard: f32 = 12.0) -> bool:
    if length(center-cam)<radius+guard: return false
    loop s in sites:
        if s.chapel or s.service: continue # openings/office geometry need not be solid boxes
        local=site_local(s,cam.xz)
        if abs(local.x)<f32(s.width*0.5)+guard and abs(local.y)<f32(s.depth*0.5)+guard: continue
        if not town_wall_hit(s,cam,center): continue
        hidden=true
        loop eye_corner in 0..8:
            eye=cam+vec3(if (eye_corner&1)==0: -guard else: guard,if (eye_corner&2)==0: -guard else: guard,if (eye_corner&4)==0: -guard else: guard)
            loop corner in 0..8:
                p=center+vec3(if (corner&1)==0: -radius else: radius,if (corner&2)==0: -radius else: radius,if (corner&4)==0: -radius else: radius)
                if not town_wall_hit(s,eye,p): hidden=false; break
            if not hidden: break
        if hidden: return true
    false

town_mesh_bound = (vertices: Vertex3D[]) -> vec4:
    low=vec3(1e9,1e9,1e9); high=-low
    loop v in vertices: low=min(low,v.pos); high=max(high,v.pos)
    vec4((low+high)*0.5,length(high-low)*0.5)
