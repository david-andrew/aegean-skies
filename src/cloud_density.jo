# Original connected cumulus forms, baked into a small RGBA8 slice atlas.
# RGB stores an outward form normal; A encodes a signed distance (.5 at the
# surface, larger inside). No reference image pixels.
const CLOUD_VOXELS = 64
const CLOUD_STAMPS = 4
# Conservative nonzero support, including one voxel of trilinear filtering.
# The atlas test guards these bounds when the procedural forms change.
const CLOUD_MIN = vec3(-0.85, -0.66, -0.66)
const CLOUD_MAX = vec3(0.85, 0.95, 0.66)
const CLOUD_SLICE = CLOUD_VOXELS + 2
const CLOUD_TILES = 16
const CLOUD_ATLAS_W = CLOUD_SLICE*CLOUD_TILES
const CLOUD_ATLAS_H = CLOUD_SLICE*((CLOUD_STAMPS*CLOUD_VOXELS+CLOUD_TILES-1)/CLOUD_TILES)

struct CloudLobe:
    center: vec3
    radius: vec3

cloud_lobes = (kind: int) -> CloudLobe[]:
    r = rng(7181 + kind * 103)
    lobes: CloudLobe[]
    # Three different silhouettes, each with a shared condensation foot and
    # asymmetric rising heads. Small shoulders sit ON the outer shell instead
    # of disappearing inside a single large ellipsoid.
    lobes.push(CloudLobe(vec3(0,-0.48,0),vec3(0.39,0.16,0.35)))
    if kind == 0:
        lobes.push(CloudLobe(vec3(-0.22,-0.05,0.02),vec3(0.37,0.60,0.36)))
        lobes.push(CloudLobe(vec3(0.10,0.42,-0.02),vec3(0.34,0.43,0.32)))
        lobes.push(CloudLobe(vec3(0.39,-0.22,0.08),vec3(0.29,0.43,0.32)))
    else if kind == 1:
        lobes.push(CloudLobe(vec3(-0.43,-0.03,0.02),vec3(0.28,0.59,0.32)))
        lobes.push(CloudLobe(vec3(0.03,0.13,-0.03),vec3(0.39,0.69,0.36)))
        lobes.push(CloudLobe(vec3(0.47,-0.10,0.04),vec3(0.25,0.52,0.31)))
    else if kind == 2:
        lobes.push(CloudLobe(vec3(-0.36,0.12,0),vec3(0.27,0.69,0.32)))
        lobes.push(CloudLobe(vec3(0.04,-0.08,0.06),vec3(0.35,0.55,0.36)))
        lobes.push(CloudLobe(vec3(0.35,0.35,-0.05),vec3(0.28,0.50,0.30)))
    else:
        # Connected rolling wall and wind-spread cap, not a mushroom on a pole.
        lobes[0] = CloudLobe(vec3(0,-0.42,0),vec3(0.45,0.22,0.40))
        lobes.push(CloudLobe(vec3(-0.32,0.02,0),vec3(0.32,0.64,0.36)))
        lobes.push(CloudLobe(vec3(0.05,0.12,-0.03),vec3(0.38,0.70,0.36)))
        lobes.push(CloudLobe(vec3(0.35,0.58,0),vec3(0.38,0.25,0.37)))
    parents = lobes
    loop j in 1..parents.len():
        parent = parents[j]
        loop k in 0..12:
            a = f64(k%6)*TAU/6.0+r.next_float()*0.3
            lift = f64(k/6)*0.65-0.15+r.next_float()*0.2
            radius = 0.16+r.next_float()*0.065
            pos = parent.center+parent.radius*vec3(f32(cos(a)*0.82),f32(lift),f32(sin(a)*0.88))
            pos = clamp(pos,vec3(-0.76+f32(radius),-0.45,-0.62+f32(radius)),vec3(0.76-f32(radius),0.84-f32(radius),0.62-f32(radius)))
            lobes.push(CloudLobe(pos,vec3(f32(radius),f32(radius*1.1),f32(radius))))

    shoulders = lobes
    loop j in 4..shoulders.len():
        parent = shoulders[j]
        loop k in 0..3:
            a = r.next_float()*TAU
            radius = 0.035+r.next_float()*0.025
            pos = parent.center+parent.radius*vec3(f32(cos(a)*0.8),f32(0.2+r.next_float()*0.5),f32(sin(a)*0.8))
            pos = clamp(pos,vec3(-0.79+f32(radius),-0.45,-0.62+f32(radius)),vec3(0.79-f32(radius),0.86-f32(radius),0.62-f32(radius)))
            lobes.push(CloudLobe(pos,vec3(f32(radius),f32(radius*0.8),f32(radius))))
    lobes

cloud_form_distance = (p: vec3, lobes: CloudLobe[], kind: int) -> f64:
    d = 10.0
    loop l in lobes:
        q = (p - l.center) / l.radius
        ld = f64(length(q) - 1.0) * f64(min(l.radius.x, min(l.radius.y, l.radius.z)))
        # Smooth unions remove sphere intersections and make one readable mass.
        k = min(0.065,f64(min(l.radius.x,min(l.radius.y,l.radius.z)))*0.25)
        h = clamp(0.5 + 0.5 * (ld - d) / k, 0.0, 1.0)
        d = ld * (1.0 - h) + d * h - k * h * (1.0 - h)
    n = noise(f64(p.x) * 7.0 + f64(kind) * 9.3, f64(p.y) * 7.0, f64(p.z) * 7.0)
    fine = noise(f64(p.x) * 17.0, f64(p.y) * 17.0 + f64(kind) * 3.7, f64(p.z) * 17.0)
    d += (n - 0.5) * 0.045 + (fine - 0.5) * 0.018
    # Common condensation level; irregular edge, no row of rounded undersides.
    max(d, -f64(p.y) - 0.62 + (noise(f64(p.x) * 6.0, f64(p.z) * 6.0) - 0.5) * 0.025)

cloud_density_image = () -> Image:
    img = image(CLOUD_ATLAS_W, CLOUD_ATLAS_H)
    loop kind in 0..CLOUD_STAMPS:
        lobes = cloud_lobes(kind)
        loop z in 0..CLOUD_VOXELS:
            sx = ((kind*CLOUD_VOXELS+z)%CLOUD_TILES)*CLOUD_SLICE
            sy = ((kind*CLOUD_VOXELS+z)/CLOUD_TILES)*CLOUD_SLICE
            loop y in -1..CLOUD_VOXELS + 1:
                loop x in -1..CLOUD_VOXELS + 1:
                    p = vec3(f32(clamp(x, 0, CLOUD_VOXELS - 1)), f32(clamp(y, 0, CLOUD_VOXELS - 1)), f32(z)) * (2.0 / f32(CLOUD_VOXELS - 1)) - vec3(1, 1, 1)
                    d = cloud_form_distance(p, lobes, kind)
                    g = vec3(0, 1, 0)
                    if d < 0.06:
                        e: f32 = 1.0/f32(CLOUD_VOXELS)
                        g = vec3(f32(cloud_form_distance(p + vec3(e, 0, 0), lobes, kind) - cloud_form_distance(p - vec3(e, 0, 0), lobes, kind)), f32(cloud_form_distance(p + vec3(0, e, 0), lobes, kind) - cloud_form_distance(p - vec3(0, e, 0), lobes, kind)), f32(cloud_form_distance(p + vec3(0, 0, e), lobes, kind) - cloud_form_distance(p - vec3(0, 0, e), lobes, kind)))
                        g = g / max(length(g), 0.000001)
                    img.set(sx + x + 1, sy + y + 1, vec4(g * 0.5 + vec3(0.5, 0.5, 0.5), f32(clamp(0.5-d*2.0, 0.0, 1.0))))
    img
