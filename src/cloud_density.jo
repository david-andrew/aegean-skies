# Original connected cumulus forms, baked into a small RGBA8 slice atlas.
# RGB stores an outward form normal; A encodes a signed distance (.5 at the
# surface, larger inside). No reference image pixels.
const CLOUD_VOXELS = 64
const CLOUD_STAMPS = 5
# Shared with placement/lifecycle so changes to the cut cannot move the base.
const CLOUD_BASE = 0.54
# Conservative nonzero support, including one voxel of trilinear filtering.
# The atlas test guards these bounds when the procedural forms change.
const CLOUD_MIN = vec3(-0.85, -0.66, -0.66)
const CLOUD_MAX = vec3(0.85, 0.95, 0.66)
const CLOUD_SLICE = CLOUD_VOXELS + 2
const CLOUD_TILES = 16
const CLOUD_ATLAS_W = CLOUD_SLICE*CLOUD_TILES
const CLOUD_ATLAS_H = CLOUD_SLICE*((CLOUD_STAMPS*CLOUD_VOXELS+CLOUD_TILES-1)/CLOUD_TILES)

struct CloudLobe:
    center: vec3
    radius: vec3

cloud_lobes = (kind: int) -> CloudLobe[]:
    r = rng(7181 + kind * 103)
    lobes: CloudLobe[]
    # Round heads at several heights, rather than three stretched trunks.
    # Each head carries exposed shoulders and those carry smaller cauliflower
    # lobes. The small union radius preserves their individual shadow edges.
    lobes.push(CloudLobe(vec3(0,-0.49,0),vec3(0.46,0.14,0.30)))
    loop j in 0..7:
        x = [-0.40,-0.13,0.23,0.44,-0.25,0.08,0.05][j]
        y = [-0.25,-0.18,-0.22,-0.28,0.16,0.20,0.55][j]
        z = [0.02,0.16,0.05,-0.03,-0.02,-0.06,0.01][j]
        radius = [0.25,0.31,0.30,0.23,0.29,0.32,0.23][j]
        if kind == 1: x *= 1.08; y = y*0.83-0.02
        if kind == 2: x += y*0.28; z += sin(f64(j)*2.0)*0.09
        if kind == 3: x *= 1.03; radius *= 1.08
        lobes.push(CloudLobe(vec3(f32(x),f32(y),f32(z)),vec3(f32(radius),f32(radius*1.03),f32(radius))))
    if kind == 4:
        # A narrow rising trunk feeding a broad, flattened spreading crown.
        loop mut l in lobes:
            l.center.x *= 0.65; l.center.z *= 0.7
            l.radius.x *= 0.78; l.radius.z *= 0.8
        loop k in 0..5:
            lobes.push(CloudLobe(vec3(-0.44+f32(k)*0.22,0.66,0),vec3(0.32,0.13,0.38)))
    parents = lobes
    loop j in 1..parents.len():
        parent = parents[j]
        loop k in 0..11:
            a = f64(k)*2.399963+r.next_float()*0.3
            lift = -0.55+f64(k)/10.0*1.5
            ring = sqrt(1.0-lift*lift)
            direction = vec3(f32(cos(a)*ring),f32(lift),f32(sin(a)*ring))
            radius = 0.065+r.next_float()*0.08
            pos = parent.center+parent.radius*direction*0.94
            pos = clamp(pos,vec3(-0.79+f32(radius),-0.48,-0.62+f32(radius)),vec3(0.79-f32(radius),0.87-f32(radius),0.62-f32(radius)))
            lobes.push(CloudLobe(pos,vec3(f32(radius),f32(radius*0.95),f32(radius))))
    shoulders = lobes
    loop j in 8..shoulders.len():
        parent = shoulders[j]
        loop k in 0..3:
            a = r.next_float()*TAU
            lift = -0.15+r.next_float()*1.1
            ring = sqrt(1.0-lift*lift)
            radius = 0.033+r.next_float()*0.024
            pos = parent.center+parent.radius*vec3(f32(cos(a)*ring),f32(lift),f32(sin(a)*ring))*0.95
            pos = clamp(pos,vec3(-0.80+f32(radius),-0.48,-0.63+f32(radius)),vec3(0.80-f32(radius),0.89-f32(radius),0.63-f32(radius)))
            lobes.push(CloudLobe(pos,vec3(f32(radius),f32(radius),f32(radius))))
    lobes

cloud_form_distance = (p: vec3, lobes: CloudLobe[], kind: int) -> f64:
    d = 10.0
    loop l in lobes:
        q = (p - l.center) / l.radius
        ld = f64(length(q) - 1.0) * f64(min(l.radius.x, min(l.radius.y, l.radius.z)))
        # A narrow seam connects lobes without melting away their shoulders.
        k = min(0.012,f64(min(l.radius.x,min(l.radius.y,l.radius.z)))*0.16)
        h = clamp(0.5 + 0.5 * (ld - d) / k, 0.0, 1.0)
        d = ld * (1.0 - h) + d * h - k * h * (1.0 - h)
    n = noise(f64(p.x) * 7.0 + f64(kind) * 9.3, f64(p.y) * 7.0, f64(p.z) * 7.0)
    fine = noise(f64(p.x) * 17.0, f64(p.y) * 17.0 + f64(kind) * 3.7, f64(p.z) * 17.0)
    d += (n - 0.5) * 0.012 + (fine - 0.5) * 0.008
    # Common condensation level; irregular edge, no row of rounded undersides.
    max(d, -f64(p.y) - CLOUD_BASE + (noise(f64(p.x) * 6.0, f64(p.z) * 6.0) - 0.5) * 0.008)

cloud_density_image = () -> Image:
    img = image(CLOUD_ATLAS_W, CLOUD_ATLAS_H)
    loop kind in 0..CLOUD_STAMPS:
        lobes = cloud_lobes(kind)
        loop z in 0..CLOUD_VOXELS:
            sx = ((kind*CLOUD_VOXELS+z)%CLOUD_TILES)*CLOUD_SLICE
            sy = ((kind*CLOUD_VOXELS+z)/CLOUD_TILES)*CLOUD_SLICE
            loop y in -1..CLOUD_VOXELS + 1:
                loop x in -1..CLOUD_VOXELS + 1:
                    p = vec3(f32(clamp(x, 0, CLOUD_VOXELS - 1)), f32(clamp(y, 0, CLOUD_VOXELS - 1)), f32(z)) * (2.0 / f32(CLOUD_VOXELS - 1)) - vec3(1, 1, 1)
                    d = cloud_form_distance(p, lobes, kind)
                    g = vec3(0, 1, 0)
                    if d < 0.06:
                        e: f32 = 0.4/f32(CLOUD_VOXELS)
                        g = vec3(f32(cloud_form_distance(p + vec3(e, 0, 0), lobes, kind) - cloud_form_distance(p - vec3(e, 0, 0), lobes, kind)), f32(cloud_form_distance(p + vec3(0, e, 0), lobes, kind) - cloud_form_distance(p - vec3(0, e, 0), lobes, kind)), f32(cloud_form_distance(p + vec3(0, 0, e), lobes, kind) - cloud_form_distance(p - vec3(0, 0, e), lobes, kind)))
                        g = g / max(length(g), 0.000001)
                    img.set(sx + x + 1, sy + y + 1, vec4(g * 0.5 + vec3(0.5, 0.5, 0.5), f32(clamp(0.5-d*2.0, 0.0, 1.0))))
    img
