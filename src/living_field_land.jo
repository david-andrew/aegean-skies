# Canonical nonoverlapping land cells; terrain eligibility is baked, never recalculated per frame.
use 'living_far_types.jo'
const FIELD_CELL_METRES = 1000
const FIELD_PARCELS_PER_PLACE = 8
field_cell_id = (x: int,z: int) -> int: (x+512)*1024+z+512
field_cell_center = (id: int) -> vec2:
    vec2(f32((id/1024-512)*FIELD_CELL_METRES+FIELD_CELL_METRES/2),f32((id%1024-512)*FIELD_CELL_METRES+FIELD_CELL_METRES/2))
field_land_valid = (land: FarFieldLand) -> bool:
    land.id>=0 and land.id<1024*1024 and land.width==FIELD_CELL_METRES and land.area_ares==10000 and land.center.xz==field_cell_center(land.id) and is_finite(land.center.y) and land.center.y>=2 and land.center.y<=300
