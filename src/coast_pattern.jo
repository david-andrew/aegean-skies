# Procedural microrelief cache, generated by game code, never an authored asset.
# Five sub-8 m bands repeat after 112 m; the coastline/height masks do not repeat.
# One 512-square RGBA8 tile (1 MiB CPU + 1 MiB GPU), no mips. CPU interpolation
# and hardware linear sampling share the quantized bytes, including wrapping.
const COAST_PATTERN_N = 512
const COAST_PATTERN_SPAN: f32 = 112.0
const COAST_PATTERN_TEXEL: f32 = 0.21875

coast_periodic_noise = (p: vec2) -> f32:
    sum: f32 = 0.0
    lens: f32[5] = [7.0,3.5,1.75,0.875,0.4375]
    amps: f32[5] = [0.55,0.26,0.12,0.055,0.025]
    offsets: vec2[5] = [vec2(19,31),vec2(53,7),vec2(11,83),vec2(71,29),vec2(37,61)]
    loop k in 0..5:
        q = p/lens[k]+offsets[k]
        i = floor(q); f = fract(q)
        u = f*f*(vec2(3,3)-2.0*f)
        period = COAST_PATTERN_SPAN/lens[k]
        a = i-floor(i/period)*period
        b = i+vec2(1,0); b -= floor(b/period)*period
        c = i+vec2(0,1); c -= floor(c/period)*period
        d = i+vec2(1,1); d -= floor(d/period)*period
        sum += (mix(mix(hash21(a),hash21(b),u.x),mix(hash21(c),hash21(d),u.x),u.y)*2.0-1.0)*amps[k]
    sum

build_coast_pattern = () -> Image:
    img = image(COAST_PATTERN_N,COAST_PATTERN_N)
    loop j in 0..COAST_PATTERN_N:
        loop i in 0..COAST_PATTERN_N:
            p = vec2(f32(i),f32(j))*COAST_PATTERN_TEXEL
            value = vec3(coast_periodic_noise(p),coast_periodic_noise(p+vec2(113,47)),coast_periodic_noise(p+vec2(29,157)))
            img.set(i,j,vec4(value/2.02+vec3(0.5,0.5,0.5),1))
    img

coast_pattern_image = build_coast_pattern()
coast_pattern_texture: Texture

coast_pattern_grid = (p: vec2) -> vec2:
    (p-floor(p/COAST_PATTERN_SPAN)*COAST_PATTERN_SPAN)/COAST_PATTERN_TEXEL

coast_pattern_pixel = (x: int,z: int) -> vec3:
    coast_pattern_image.get(x & 511,z & 511).xyz*2.02-vec3(1.01,1.01,1.01)

coast_pattern_at = (p: vec2) -> vec3:
    q = coast_pattern_grid(p); f = fract(q)
    x = int(floor(q.x)); z = int(floor(q.y))
    # Canonical new-land vertices and every finest contact vertex lie exactly
    # on this lattice. Avoid three zero-weight pixel reads in that common case.
    if f.x == 0.0 and f.y == 0.0: return coast_pattern_pixel(x,z)
    mix(mix(coast_pattern_pixel(x,z),coast_pattern_pixel(x+1,z),f.x),mix(coast_pattern_pixel(x,z+1),coast_pattern_pixel(x+1,z+1),f.x),f.y)

coast_pattern_gpu = (t: Texture,p: vec2) -> vec3:
    q = coast_pattern_grid(p)
    sample(t,(q+vec2(0.5,0.5))/512.0).xyz*2.02-vec3(1.01,1.01,1.01)
