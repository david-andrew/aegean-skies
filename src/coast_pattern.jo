# Procedural microrelief cache, generated by game code, never an authored asset.
# Five sub-8 m bands repeat after 112 m; the coastline/height masks do not repeat.
# One 512-square RGBA8 tile (1 MiB CPU + 1 MiB GPU), no mips. CPU interpolation
# and hardware linear sampling share the quantized bytes, including wrapping.
use 'baked_assets.jo'
const COAST_PATTERN_N = 512
const COAST_PATTERN_SPAN: f32 = 112.0
const COAST_PATTERN_TEXEL: f32 = 0.21875

coast_periodic_noise = (p: vec2) -> f32:
    sum: f32 = 0.0
    lens: f32[5] = [7.0,3.5,1.75,0.875,0.4375]
    amps: f32[5] = [0.55,0.26,0.12,0.055,0.025]
    offsets: vec2[5] = [vec2(19,31),vec2(53,7),vec2(11,83),vec2(71,29),vec2(37,61)]
    loop k in 0..5:
        q = p/lens[k]+offsets[k]
        i = floor(q); f = fract(q)
        u = f*f*(vec2(3,3)-2.0*f)
        period = COAST_PATTERN_SPAN/lens[k]
        a = i-floor(i/period)*period
        b = i+vec2(1,0); b -= floor(b/period)*period
        c = i+vec2(0,1); c -= floor(c/period)*period
        d = i+vec2(1,1); d -= floor(d/period)*period
        sum += (mix(mix(hash21(a),hash21(b),u.x),mix(hash21(c),hash21(d),u.x),u.y)*2.0-1.0)*amps[k]
    sum

const CAUSTIC_CELLS = 8

coast_caustic_smin = (a: f32, b: f32, k: f32) -> f32:
    h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0)
    mix(b, a, h) - k * h * (1.0 - h)

# Seamless periodic exact-bisector Voronoi edge distance on an 8x8 torus (64 texels/cell),
# softly domain-warped by periodic harmonics so cell walls curve like real liquid caustics
# instead of straight Euclidean polygons: 0 at 3-way cusp nodes, ~0.03 on filaments, ~0.85+ inside.
coast_caustic_edge = (p_in: vec2, sx: f32[], sy: f32[]) -> f32:
    w_k = f32(TAU / 4.0)
    wx = 0.16 * sin(p_in.y * w_k + 0.4) + 0.09 * cos((p_in.x + p_in.y) * w_k - 0.7)
    wy = 0.16 * cos(p_in.x * w_k - 0.3) + 0.09 * sin((p_in.x - p_in.y) * w_k + 1.1)
    p = vec2(p_in.x + wx, p_in.y + wy)
    cx0 = int(floor(p.x)); cy0 = int(floor(p.y))
    best_d2: f32 = 1e9
    best_rx: f32 = 0.0; best_ry: f32 = 0.0
    best_ix = 0; best_iy = 0
    loop oy in -1..2:
        loop ox in -1..2:
            ix = (cx0 + ox) & (CAUSTIC_CELLS - 1)
            iy = (cy0 + oy) & (CAUSTIC_CELLS - 1)
            idx = iy * CAUSTIC_CELLS + ix
            rx = f32(cx0 + ox) + sx[idx] - p.x
            ry = f32(cy0 + oy) + sy[idx] - p.y
            d2 = rx * rx + ry * ry
            if d2 < best_d2:
                best_d2 = d2; best_rx = rx; best_ry = ry; best_ix = ox; best_iy = oy
    edge: f32 = 1.0
    loop oy in -1..2:
        loop ox in -1..2:
            if ox == best_ix and oy == best_iy: continue
            ix = (cx0 + ox) & (CAUSTIC_CELLS - 1)
            iy = (cy0 + oy) & (CAUSTIC_CELLS - 1)
            idx = iy * CAUSTIC_CELLS + ix
            rx = f32(cx0 + ox) + sx[idx] - p.x
            ry = f32(cy0 + oy) + sy[idx] - p.y
            dx = rx - best_rx; dy = ry - best_ry
            len = sqrt(max(dx * dx + dy * dy, 1e-8))
            d = (0.5 * (best_rx + rx) * dx + 0.5 * (best_ry + ry) * dy) / len
            edge = coast_caustic_smin(edge, d, 0.04)
    clamp((edge + 0.015) * 1.85, 0.0, 1.0)

build_coast_pattern = () -> Image:
    img = image(COAST_PATTERN_N,COAST_PATTERN_N)
    sx: f32[]; sy: f32[]
    loop cy in 0..CAUSTIC_CELLS:
        loop cx in 0..CAUSTIC_CELLS:
            sx.push(0.14 + 0.72 * hash21(vec2(f32(cx) + 13.0, f32(cy) + 41.0)))
            sy.push(0.14 + 0.72 * hash21(vec2(f32(cx) + 73.0, f32(cy) + 19.0)))
    cell_scale = f32(CAUSTIC_CELLS) / f32(COAST_PATTERN_N)
    loop j in 0..COAST_PATTERN_N:
        loop i in 0..COAST_PATTERN_N:
            p = vec2(f32(i),f32(j))*COAST_PATTERN_TEXEL
            value = vec3(coast_periodic_noise(p),coast_periodic_noise(p+vec2(113,47)),coast_periodic_noise(p+vec2(29,157)))
            w = coast_caustic_edge(vec2((f32(i) + 0.5) * cell_scale, (f32(j) + 0.5) * cell_scale), sx, sy)
            img.set(i,j,vec4(value/2.02+vec3(0.5,0.5,0.5),w))
    img

# (baked by tools/bake.jo as assets/baked/coast-pattern-v2.png, the same RGBA8 bytes; made here
# when there is no bake. Raise the version in the name when the pattern's code changes.)
const COAST_PATTERN_BAKE = "coast-pattern-v2.png"
load_coast_pattern = () -> Image:
    if let bytes = baked_asset(COAST_PATTERN_BAKE):
        loaded = load_png(bytes)
        if loaded is Image and loaded.width == COAST_PATTERN_N and loaded.height == COAST_PATTERN_N: return loaded
    build_coast_pattern()
coast_pattern_image = load_coast_pattern()
# tools/bake.jo: the pattern as the code makes it now, before anything is baked from it
rebuild_coast_pattern = () -> Image:
    global coast_pattern_image
    coast_pattern_image = build_coast_pattern()
    coast_pattern_image
coast_pattern_texture: Texture

coast_pattern_grid = (p: vec2) -> vec2:
    (p-floor(p/COAST_PATTERN_SPAN)*COAST_PATTERN_SPAN)/COAST_PATTERN_TEXEL

coast_pattern_pixel = (x: int,z: int) -> vec3:
    coast_pattern_image.get(x & 511,z & 511).xyz*2.02-vec3(1.01,1.01,1.01)

coast_pattern_at = (p: vec2) -> vec3:
    q = coast_pattern_grid(p); f = fract(q)
    x = int(floor(q.x)); z = int(floor(q.y))
    # Canonical new-land vertices and every finest contact vertex lie exactly
    # on this lattice. Avoid three zero-weight pixel reads in that common case.
    if f.x == 0.0 and f.y == 0.0: return coast_pattern_pixel(x,z)
    mix(mix(coast_pattern_pixel(x,z),coast_pattern_pixel(x+1,z),f.x),mix(coast_pattern_pixel(x,z+1),coast_pattern_pixel(x+1,z+1),f.x),f.y)

coast_pattern_gpu = (t: Texture,p: vec2) -> vec3:
    q = coast_pattern_grid(p)
    sample(t,(q+vec2(0.5,0.5))/512.0).xyz*2.02-vec3(1.01,1.01,1.01)
