# Inherited overland routes predate the river cuts. These surveyed stone
# viaducts keep the roads' bank elevations and leave the river flowing beneath.
# The deck profile is shared by walking, offline routes and rendering.
struct AccessBridge:
    a:vec3
    b:vec3
    width:f64=5.2
    rise:f64=0
ACCESS_BRIDGES=[
    AccessBridge(vec3(-156123.3,106.88922,-159532.62),vec3(-156221.27,107.91828,-159768.9)),
    AccessBridge(vec3(-147901.11,113.911644,-153105.45),vec3(-147882.23,114.03936,-153360.67)),
    AccessBridge(vec3(-134856.31,14.69129,-147974.02),vec3(-135183.64,15.687047,-147955.23)),
    AccessBridge(vec3(-119446.12,4.248534,-146404.81),vec3(-119775.28,2.8111272,-146504.06),rise=4),
    AccessBridge(vec3(-126463.26,8.294673,-145689.14),vec3(-126444.51,7.242047,-145976.39)),
]
access_bridge_profile=(bridge:AccessBridge,u:f64)->f64:
    mix(f64(bridge.a.y),f64(bridge.b.y),u)+bridge.rise*sin(u*PI)
access_bridge_deck=(p:vec2)->f64?:
    loop bridge in ACCESS_BRIDGES:
        delta=bridge.b.xz-bridge.a.xz;length2=dot(delta,delta)
        u=dot(p-bridge.a.xz,delta)/length2
        if u<0 or u>1:continue
        if abs(dot(p-bridge.a.xz,vec2(-delta.y,delta.x)))>f32(bridge.width*0.5)*sqrt(length2):continue
        return access_bridge_profile(bridge,f64(u))
    none
access_bridge_height=(p:vec2,ground:f64)->f64:
    if let deck=access_bridge_deck(p):max(ground,deck) else:ground
access_bridge_exclude=(p:vec2,height:f64)->vec2:
    result=p
    loop bridge in ACCESS_BRIDGES:
        d=bridge.b.xz-bridge.a.xz;len=length(d);axis=d/len;side=vec2(-axis.y,axis.x)
        q=result-bridge.a.xz;u=dot(q,axis);off=dot(q,side)
        if u<0 or u>len:continue
        deck=access_bridge_profile(bridge,f64(u/len))
        if height<deck-0.8 or height>deck+1.25:continue
        if abs(off)>f32(bridge.width*0.5-0.6) and abs(off)<f32(bridge.width*0.5+0.4):
            edge=f32(bridge.width*0.5-0.6);result=bridge.a.xz+axis*u+side*(if off<0:-edge else:edge)
    result
