# The player's options (the pause menu's Options page), kept between plays.

struct Options:
    tilt_aim = false                # fine aiming by tilting the phone, aboard
    tilt_gain = 1.0                 # how far the aim turns for a turn of the phone (1: as far)
    invert_y = false                # looking up and down the other way (drag, mouse, tilt)
    tipsy_sway = true               # a gentle sway of the view after several strong drinks
    walk_left = false               # on a touch screen: the Walk button by the left thumb instead

options = load_value("options", Options())

set_options = (o: Options):
    global options
    if o != options:
        options = o
        _ = save_value("options", o)
