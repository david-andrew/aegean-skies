# The player's options (the pause menu's Options page), kept between plays.
use 'controller.jo'
use 'ui_state.jo'

struct Options:
    tilt_aim = false                # fine aiming by tilting the phone, aboard
    tilt_gain = 1.0                 # how far the aim turns for a turn of the phone (1: as far)
    mouse_steers = true             # the mouse flies the aircraft (off: it looks around, the keys fly)
    invert_y = false                # looking up and down the other way (drag, mouse, tilt)
    tipsy_sway = true               # a gentle sway of the view after several strong drinks
    walk_left = false               # on a touch screen: the Walk button by the left thumb instead
    music_notes = true              # small notes rising from music played nearby (the band, a street player)
    guidance = false                # (Accessibility) a new pilot's welcome on the dock and the note by the compass. Off by
                                    # default: the game is found by playing. (Renamed from `hints`, which was on, so a
                                    # saved older value is not carried over)
    radio_volume = 0.5              # the cockpit radio's volume knob (half way: as it always was; radio_volume_gain)
    scroll_speed = 1.0              # the mouse wheel and a touchpad's scroll, in menus and zooming (1: the default; 2: a whole notch, as it was)
    controls: ControlsConfig = ControlsConfig()   # gamepads and flight sticks (the Controls page; older files: the defaults)

options = load_value("options", Options())

set_options = (o: Options):
    global options
    apply_scroll_speed(o.scroll_speed)      # (each frame: cheap, and set from the first)
    if o != options:
        options = o
        _ = save_value("options", o)
