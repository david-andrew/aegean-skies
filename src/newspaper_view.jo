# The paper on the table: one broadsheet column on newsprint, with:
#   - the masthead and dateline between double rules;
#   - the day's lead story;
#   - the sections under centred heads;
#   - the market's prices set as a table;
#   - the weather, and the notices boxed like classified advertisements.
# It scrolls by wheel, arrow and page keys, a finger's drag, or the page buttons.

use 'phoenix.jo'
use 'hud.jo'
use 'touch.jo'
use 'panels.jo'
use 'newspaper.jo'

NEWSPRINT = rgba(0.93, 0.9, 0.81, 1)
NEWS_INK = rgba(0.1, 0.09, 0.08, 1)
NEWS_GREY = rgba(0.1, 0.09, 0.08, 0.62)

struct PaperView:
    scroll = 0.0
    drag_from = -1.0
    drag_scroll = 0.0

# one laid-out line of the page
struct PaperLine:
    text: str
    size: f64
    title = false                   # in the display face
    centred = false
    colour: vec4 = NEWS_INK
    rule = 0                        # 1 a thin rule, 2 a double rule, 3 a short centred rule
    gap = 0.0                       # space before it
    box = false                     # (inside a notice's box)
    columns: str[]                  # (a row of the price table)

_pl_height = (l: PaperLine) -> f64:
    if l.rule > 0: return l.gap + (if l.rule == 2: 7.0 else: 3.0)
    l.gap + l.size * 1.28

# Lay the paper out at a column width: every line, rule and table row, top to bottom.
paper_lines = (fonts: Fonts, p: Paper, width: f64) -> PaperLine[]:
    out: PaperLine[]
    add_text = (text: str, size: f64, title: bool, centred: bool, colour: vec4, gap: f64, box: bool):
        set_font(if title: fonts.title else: fonts.ui)
        lines = wrap_text(text, width - (if box: 24.0 else: 0.0), size)
        loop k in 0..lines.len(): out.push(PaperLine(lines[k], size, title, centred, colour, gap = if k == 0: gap else: 0.0, box = box))
    out.push(PaperLine("", 0, rule = 2, gap = 4))
    set_font(fonts.title)
    size = 40.0
    loop size > 18.0 and ptext_width(p.title, size) > width: size -= 2.0
    out.push(PaperLine(p.title, size, true, true, gap = 6))
    out.push(PaperLine("", 0, rule = 1, gap = 4))
    out.push(PaperLine("", 13, columns = [p.dateline, "Price {phoenix_text(p.cents)}"], gap = 2))
    out.push(PaperLine("", 0, rule = 2, gap = 2))
    if let lead = p.lead:
        add_text(lead.head.upper(), 25, true, true, NEWS_INK, 14, false)
        add_text(lead.body, 17, false, false, NEWS_INK, 6, false)
        out.push(PaperLine("", 0, rule = 1, gap = 12))
    section = ""
    market_done = false
    market = (heading: bool):
        if p.prices.len() > 0:
            if heading:
                out.push(PaperLine("THE MARKET", 15, true, true, NEWS_GREY, gap = 16))
                out.push(PaperLine("", 0, rule = 1, gap = 3))
            out.push(PaperLine("", 13, colour = NEWS_GREY, columns = ["", "here", "", "by the latest word"], gap = 4))
            loop row in p.prices: out.push(PaperLine("", 15, columns = [row.good, phoenix_text(row.here), row.word, row.elsewhere], gap = 2))
        if p.weather != "":
            out.push(PaperLine("WEATHER", 15, true, true, NEWS_GREY, gap = 16))
            out.push(PaperLine("", 0, rule = 1, gap = 3))
            add_text(p.weather, 16, false, false, NEWS_INK, 6, false)
    loop piece in p.pieces:
        if not market_done and (piece.section == "Weather" or piece.section == "Notices"):
            market(section != "The market"); market_done = true
            section = "Weather"
        if piece.section != section:
            section = piece.section
            out.push(PaperLine(section.upper(), 15, true, true, NEWS_GREY, gap = 16))
            out.push(PaperLine("", 0, rule = 1, gap = 3))
        if piece.section == "Notices":
            add_text(piece.head, 16, true, false, NEWS_INK, 10, true)
            add_text(piece.body, 15, false, false, NEWS_INK, 2, true)
        else:
            add_text(piece.head, 19, true, false, NEWS_INK, 10, false)
            add_text(piece.body, 16, false, false, NEWS_INK, 3, false)
            out.push(PaperLine("", 0, rule = 3, gap = 8))
    if not market_done: market(section != "The market")
    out.push(PaperLine("", 0, rule = 2, gap = 18))
    set_font()
    out

# The paper, for one frame. True when it is put down.
paper_panel = (fonts: Fonts, p: Paper, v: mut PaperView) -> bool:
    closed = false
    sw = f64(screen_width()); sh = f64(screen_height())
    w = min(660.0, sw - 20.0)
    x = (sw - w) * 0.5
    top = max(10.0, pad_top_clear(x, x + w) + 4.0)
    h = sh - top - 10.0
    y = top
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.45))
    rect(x + 5, y + 7, w, h, rgba(0, 0, 0, 0.3))
    rect(x, y, w, h, NEWSPRINT)
    # (the fold and a little foxing at the edges)
    rect_gradient(x, y, w, 18, rgba(0.82, 0.78, 0.68, 0.6), rgba(0.93, 0.9, 0.81, 0))
    rect_gradient(x, y + h - 18, w, 18, rgba(0.93, 0.9, 0.81, 0), rgba(0.82, 0.78, 0.68, 0.6))
    pad_x = if w < 480.0: 14.0 else: 30.0
    inner = w - pad_x * 2.0
    lines = paper_lines(fonts, p, inner)
    total = 0.0
    loop l in lines: total += _pl_height(l)
    view_top = y + 8.0
    footer = 44.0
    view_h = h - 16.0 - footer
    most = max(0.0, total - view_h)
    # scrolling: wheel, keys, a finger's drag, the page buttons
    if mouse_wheel() != 0.0: v.scroll -= mouse_wheel() * 60.0
    if key_repeat(.down): v.scroll += 40.0
    if key_repeat(.up): v.scroll -= 40.0
    if key_pressed(.page_down) or key_pressed(.space): v.scroll += view_h * 0.85
    if key_pressed(.page_up): v.scroll -= view_h * 0.85
    if key_pressed(.home): v.scroll = 0.0
    if key_pressed(.end): v.scroll = most
    area = Rect(x, view_top, w, view_h)
    if mouse_pressed(.left) and contains(area, mouse_pos()):
        v.drag_from = f64(mouse_pos().y); v.drag_scroll = v.scroll
    if v.drag_from >= 0.0:
        if mouse_down(.left): v.scroll = v.drag_scroll - (f64(mouse_pos().y) - v.drag_from)
        else: v.drag_from = -1.0
    v.scroll = clamp(v.scroll, 0.0, most)
    clip(Rect(x, view_top, w, view_h))
    cy = view_top - v.scroll
    box_open = false
    box_top = 0.0
    loop i in 0..lines.len():
        l = lines[i]
        lh = _pl_height(l)
        if l.box and not box_open:
            box_open = true; box_top = cy + l.gap - 4.0
        if box_open and (i + 1 >= lines.len() or not lines[i + 1].box):
            # (a notice's box round its lines)
            rect_outline(x + pad_x, box_top, inner, cy + lh - box_top + 6.0, 1.2, NEWS_GREY)
            box_open = false
        if cy + lh < view_top - 40.0 or cy > view_top + view_h + 40.0:
            cy += lh
            continue
        ly = cy + l.gap
        if l.rule == 1: line(vec2(f32(x + pad_x), f32(ly + 1)), vec2(f32(x + w - pad_x), f32(ly + 1)), 1.4, NEWS_INK)
        else if l.rule == 2:
            line(vec2(f32(x + pad_x), f32(ly + 1)), vec2(f32(x + w - pad_x), f32(ly + 1)), 2.0, NEWS_INK)
            line(vec2(f32(x + pad_x), f32(ly + 5)), vec2(f32(x + w - pad_x), f32(ly + 5)), 1.3, NEWS_INK)
        else if l.rule == 3: line(vec2(f32(x + w * 0.5 - 30), f32(ly + 1)), vec2(f32(x + w * 0.5 + 30), f32(ly + 1)), 1.3, NEWS_GREY)
        else if l.columns.len() > 0:
            set_font(fonts.ui)
            if l.columns.len() == 2:
                ptext(fit_text(l.columns[0], inner * 0.7, l.size), vec2(f32(x + pad_x), f32(ly)), l.size, NEWS_INK)
                ptext(l.columns[1], vec2(f32(x + w - pad_x - ptext_width(l.columns[1], l.size)), f32(ly)), l.size, NEWS_INK)
            else:
                cw = [inner * 0.22, inner * 0.16, inner * 0.12, inner * 0.5]
                cx = x + pad_x
                loop k in 0..l.columns.len():
                    c = l.columns[k]
                    if k == 1: ptext(c, vec2(f32(cx + cw[k] - ptext_width(c, l.size) - 10.0), f32(ly)), l.size, l.colour)
                    else: ptext(fit_text(c, cw[k] - 6.0, l.size), vec2(f32(cx), f32(ly)), l.size, if k == 2: NEWS_GREY else: l.colour)
                    cx += cw[k]
        else:
            set_font(if l.title: fonts.title else: fonts.ui)
            tx = if l.centred: x + (w - ptext_width(l.text, l.size)) * 0.5 else: x + pad_x + (if l.box: 12.0 else: 0.0)
            ptext(l.text, vec2(f32(tx), f32(ly)), l.size, l.colour)
        cy += lh
    no_clip()
    # the foot: page buttons and the way out
    set_font(fonts.ui)
    fy = y + h - footer
    line(vec2(f32(x + 12), f32(fy)), vec2(f32(x + w - 12), f32(fy)), 1.4, NEWS_GREY)
    up = Rect(x + 14, fy + 7, 70, 30)
    dn = Rect(x + 92, fy + 7, 70, 30)
    put = Rect(x + w - 14 - 150, fy + 7, 150, 30)
    chip = (r: Rect, label: str, on: bool) -> bool:
        over = contains(r, mouse_pos())
        rect_rounded(r.x, r.y, r.w, r.h, 15, if not on: rgba(0.8, 0.77, 0.7, 0.5) else: if over: rgba(0.78, 0.72, 0.58, 1) else: rgba(0.86, 0.82, 0.72, 1))
        ptext_centered(label, vec2(f32(r.x + r.w * 0.5), f32(r.y + r.h * 0.5)), 15, if on: NEWS_INK else: NEWS_GREY)
        on and mouse_pressed(.left) and over
    if chip(up, "up", v.scroll > 0.0): v.scroll = max(0.0, v.scroll - view_h * 0.85)
    if chip(dn, "down", v.scroll < most): v.scroll = min(most, v.scroll + view_h * 0.85)
    if chip(put, if pad.on: "put it down" else: "Esc  put it down", true) or vpressed(.escape): closed = true
    if most > 0.0:
        pct = int(v.scroll / most * 100.0)
        ptext_centered("{pct}%", vec2(f32(x + 200), f32(fy + 22)), 13, NEWS_GREY)
    set_font()
    closed
