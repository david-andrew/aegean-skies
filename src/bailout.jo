# A person survives independently of their aircraft. Fixed-step, no world transactions or RNG.
# The living world decides rescue, injuries and ownership from the landing event.
enum DescentPhase: falling, canopy, landed, swimming

struct Descent:
    person: int
    craft: int
    position: vec3
    velocity: vec3
    phase: DescentPhase = .falling
    age = 0.0
    opened = 0.0
    yaw = 0.0
    injury = 0.0
    landed_event = false
    steering: vec3 = vec3(0,0,0)
    open_requested = false
    released = false

leave_aircraft = (person: int, craft: int, position: vec3, orientation: vec4, velocity: vec3, seat: vec3) -> Descent:
    up = quat_rotate(orientation,vec3(0,1,0))
    side = quat_rotate(orientation,vec3(1,0,0))
    Descent(person,craft,position+quat_rotate(orientation,seat)+up*1.5+side*1.2,velocity+up*4.0+side*3.0)

step_descent = (p: mut Descent, wind: vec3, ground: (f64,f64)->f64, sea: f64, dt: f64, steer: vec3 = vec3(0,0,0), open: bool = false):
    p.landed_event = false
    if p.phase == .landed: return
    if p.phase == .swimming:
        p.position += (vec3(wind.x,0,wind.z)*0.025+steer*1.2)*f32(dt)
        h = ground(f64(p.position.x),f64(p.position.z))
        p.position.y = f32(max(sea-0.5,h))
        if h > sea: p.phase = .landed
        return
    p.age += dt
    if p.phase == .falling and (p.age >= 1.25 or (open and p.age > 0.17)):
        p.phase = .canopy; p.opened = p.age
    if p.phase == .falling:
        p.velocity.y -= f32(9.81*dt)
        p.velocity += (wind-p.velocity)*f32(1.0-exp(-0.15*dt))
    else:
        # A seven m/s canopy, limited steering and drift toward the actual wind.
        target = vec3(wind.x,-7.0,wind.z)+vec3(steer.x,0,steer.z)*2.5
        p.velocity.x += (target.x-p.velocity.x)*f32(1.0-exp(-1.2*dt))
        p.velocity.z += (target.z-p.velocity.z)*f32(1.0-exp(-1.2*dt))
        p.velocity.y += (target.y-p.velocity.y)*f32(1.0-exp(-6.0*dt))
    p.position += p.velocity*f32(dt)
    h = ground(f64(p.position.x),f64(p.position.z))
    if f64(p.position.y) <= max(sea,h):
        p.injury = clamp((-f64(p.velocity.y)-10.0)/35.0,0.0,1.0)
        p.phase = if h > sea: DescentPhase.landed else: DescentPhase.swimming
        p.position.y = f32(if h > sea: h else: sea-0.5)
        p.velocity = vec3(0,0,0); p.landed_event = true
