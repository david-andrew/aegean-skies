# Air race classes, so that speeds are fair: the club class for the game's own types, and the
# open Schneider class for the historical racing seaplanes. Each class has its own course size
# (gate spacing and width) and racing pace, and each capital's club fields aircraft for both,
# bought by funding and, for the Schneider class, newest era first. Pure data; no world access.
from 'planes.jo' import Craft
import 'living_types.jo' as data

enum AirClass: club, schneider

AIR_CLASS_NAMES = ["Club", "Schneider"]

# The course's size over the club oval (air_course scale): gate spacing and width grow with it,
# so a 600 m/s S.6B has the room to turn for each gate. Tried in order until one fits open water.
air_class_scales = (c: AirClass) -> f64[]: if c == .schneider: [3.0, 2.5, 2.0] else: [1.0]

# The NPC racing speed (drawn m/s): the club keeps its settled 140 m/s at cruise; the Schneider
# class races at 80% of each type's top speed, up to what its course was sized for.
air_class_pace = (c: AirClass, cruise: f64, top: f64, scale: f64) -> f64:
    if c == .schneider: min(top * 0.8, 160.0 * scale) else: min(cruise, 140.0)

# The race's start, local minutes: the Schneider class in the late morning, the club class at
# five as it always was. Then racing, and the display (air_class_racing_minutes, air_class_meet_minutes).
air_class_start = (c: AirClass) -> int: if c == .schneider: 660 else: 1020

# How long a meet races, then how long it runs in all (game minutes from the start): the open
# class's course lies further out and its slowest racers take twice the fastest's time.
air_class_racing_minutes = (c: AirClass) -> int: if c == .schneider: 180 else: 120
air_class_meet_minutes = (c: AirClass) -> int: if c == .schneider: 300 else: 240

# The entry fee, in cents.
air_class_fee = (c: AirClass) -> int: if c == .schneider: 10000 else: 2000

# Which class a type races in, or none: the game's own types (the first sixteen) in the club
# class; the Schneider racers in theirs (the P.7 too, for a player who has one); the fighters,
# boats and liners in neither.
air_class_of = (kind: Craft) -> AirClass?:
    if int(kind) < 16: return .club
    if kind == .supermarine_s6b or kind == .macchi_mc72 or kind == .sm_s65 or kind == .piaggio_p7 or kind == .macchi_m33 or kind == .curtiss_r3c2 or kind == .sea_lion_ii: return .schneider
    none

air_class_eligible = (c: AirClass) -> str:
    if c == .schneider: "a Schneider racer: the S.6B, M.C.72, S.65, P.7, M.33, R3C-2 or Sea Lion II" else: "one of the islands' own aircraft"

# The clubs' fleets. Club class: two slots, each the best its purse allows from a short line
# (the Swift and the Falco first, as before; cheaper sport types when funds are short).
CLUB_LINES: data.Airframe[][] = [[.swift, .kestrel, .minnow], [.falco, .kingfisher, .kite]]

# Schneider class: three slots from the capital's racing tradition (by country), newest first.
# Slot k picks the newest type its purse allows from the k-th era on, so a rich club fields one
# of each era (1931, 1929/1925, 1925/1922) and a poorer one the older, cheaper racers.
SCHNEIDER_LINES: data.Airframe[][] = [[.supermarine_s6b, .curtiss_r3c2, .sea_lion_ii], [.macchi_mc72, .sm_s65, .macchi_m33]]

# The funding rule: one purchase spends at most a twentieth of the club's purse.
air_club_affords = (purse_cents: int, kind: data.Airframe) -> bool:
    purse_cents / 20 >= data.AIRFRAMES[int(kind)].price_cents

# The type a club slot buys with this purse, or none.
air_club_pick = (line: data.Airframe[], first: int, purse_cents: int) -> data.Airframe?:
    loop k in first..line.len():
        if air_club_affords(purse_cents, line[k]): return line[k]
    none
