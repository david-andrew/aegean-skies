use 'living_guard.jo'
use 'living_transaction.jo'
# Data-only publication from the real settlement/geography registry. No chart rendering or UI.
use 'living_types.jo'
use 'living_map_types.jo'
use 'living_maps.jo'
use 'living_map_seed.jo'
use 'living_money.jo'
use 'settlements.jo'
use 'geography.jo'

_map_country_bounds = (country: int) -> MapBounds:
    lo = vec2(1e9,1e9); hi = vec2(-1e9,-1e9)
    loop s in world_settlements:
        if s.country == country: lo = min(lo,s.center.xz); hi = max(hi,s.center.xz)
    MapBounds(max(-250000.0,f64(lo.x)-8000.0),max(-200000.0,f64(lo.y)-8000.0),min(250000.0,f64(hi.x)+8000.0),min(200000.0,f64(hi.y)+8000.0))

_guarded_publish_settlement_maps = (w: mut World):
    initialize_maps(w)
    if world_settlements.len()<=6 or w.maps.catalog_version>=SETTLEMENT_VERSION: return
    capitals = ["porto-office","porto-office","porto-office"]
    places = world_settlements
    places.sort_by((s: WorldSettlement): s.id)
    loop s in places:
        if s.kind != .capital: continue
        key = "books:{s.id}"
        if not (key in w.maps.shops):
            account = new_account(w,"map-bookseller:{s.id}",6000)
            pos = s.center
            loop landmark in place_landmarks(s):
                if landmark.kind == "cafe": pos = landmark.at
            w.maps.shops[key] = MapShop(key,"{s.name} bookseller",s.id,account=account,pos=pos,kind="bookseller")
        capitals[s.country] = key
    # Snapshot real settlement names, moorings, landmarks and simplified canonical road lines.
    loop s in places:
        key = "town:{s.id}"
        if not (key in w.maps.features): w.maps.features[key] = MapFeature(key,.towns,s.center,s.name,town_size=s.size)
        loop dock in 0..s.harbor.len():
            key = "mooring:{s.id}:{dock}"
            if not (key in w.maps.features): w.maps.features[key] = MapFeature(key,.moorings,s.harbor[dock].at,"{s.name} quay {dock+1}")
        landmarks = place_landmarks(s)
        loop i in 0..landmarks.len():
            l = landmarks[i]; key = "landmark:{s.id}:{i}"
            layer = if l.kind == "lighthouse": MapLayer.lighthouses else: MapLayer.landmarks
            if not (key in w.maps.features): w.maps.features[key] = MapFeature(key,layer,l.at,"{s.name}: {l.kind}")
    loop i in 0..settlement_roads.len():
        r = settlement_roads[i]; key = "road:{i}"
        if key in w.maps.features or r.points.len()<2: continue
        stride = max(1,(r.points.len()-1+30)/31)
        points: vec3[]
        loop j in 0,stride..r.points.len(): points.push(r.points[j])
        if points[points.len()-1] != r.points[r.points.len()-1]: points.push(r.points[r.points.len()-1])
        w.maps.features[key] = MapFeature(key,.roads,points[points.len()/2],"{world_settlements[settlement_by_id[r.a]].name} - {world_settlements[settlement_by_id[r.b]].name}",points)
    # Country sheets have different purposes/layers, rather than one pan-and-zoom global map.
    loop country in 1..3:
        b = _map_country_bounds(country)
        if not map_bounds_valid(b): continue
        country_name = SETTLEMENT_COUNTRIES[country]
        road = PaperMap("country:{country}:road:1922","Motoring and post roads of {country_name}, 1922","National Touring Club",1922,.road,b,650000,1,[.coast,.towns,.roads,.landmarks,.lighthouses],260,survey_offset=vec2(f32(country*40-90),f32(country*35)),scale_error_ppm=450,minimum_town_size=20,notes="Principal roads and post towns, revised 1922. Minor tracks and newer villages may be absent.")
        loop i in 0..settlement_roads.len():
            r = settlement_roads[i]
            if settlement_by_id[r.a] >= 0 and world_settlements[settlement_by_id[r.a]].country == country:
                road.errors.push(MapError(.roads,"road:{i}",.omitted)); break
        if not (publish_map(w,road,[capitals[country],capitals[country]],1800)):
            living_fault("map_scene.publish_settlement_maps.0",guard_context(w))
            return
        military = PaperMap("country:{country}:military:1919","{country_name}: coastal defence sheet, 1919","Survey Section, {country_name}",1919,.military,b,450000,1,[.coast,.towns,.roads,.landmarks,.hazards,.airfields,.moorings],400,survey_offset=vec2(f32(country*110),-140),rotation_rad=0.0009,minimum_town_size=40,notes="Surplus survey copy. Positions are those on the 1919 sheet, not current garrisons, fronts or patrols.")
        if not (publish_map(w,military,[capitals[country]],3500)):
            living_fault("map_scene.publish_settlement_maps.1",guard_context(w))
            return
        # Capital booksellers have a few general sea charts; no global replenishment.
        stock_map(w,"aegean-general-1898",capitals[country],2800)
    names = ["Inner Aegean Islands","North-western Islands","Eastern Coastal Islands","Southern Passage Islands","Northern Shelf Islands","Middle Eastern Islands"]
    loop i in 0..ISLAND_GROUPS.len():
        group = ISLAND_GROUPS[i]
        # Rotated island corridors need generous rectangular printed coverage.
        radius = f64(max(group.radii.x,group.radii.y)+group.scatter)*1000.0+10000.0
        at = group.center*1000.0
        b = MapBounds(max(-250000.0,f64(at.x)-radius),max(-200000.0,f64(at.y)-radius),min(250000.0,f64(at.x)+radius),min(200000.0,f64(at.y)+radius))
        m = PaperMap("group:{i}:1917","Coasting chart: {names[i]}, 1917","Aegean Coasting Service",1917,.nautical,b,350000,1,[.coast,.depth,.towns,.lighthouses,.hazards,.moorings],320,survey_offset=vec2(f32(i*19-50),f32(i*11-40)),minimum_town_size=16,notes="A coasting overview. Take a harbour sheet for soundings inside a quay.")
        seller = if i == 2 or i == 5: capitals[2] else: capitals[1]
        if not (publish_map(w,m,[seller,"porto-office"],1600)):
            living_fault("map_scene.publish_settlement_maps.2",guard_context(w))
            return
    # Local sheets for inhabited principal islands use actual island bounds and actual place names.
    loop island in small_islands:
        if island.id<32 or island.id>=44: continue
        port = -1
        loop s in places:
            if s.id == 300000+island.id*10 or (port < 0 and s.id == 300001+island.id*10): port = s.id
        if port < 0: continue
        s = world_settlements[settlement_by_id[port]]
        rx = f64(max(island.radii.x,island.radii.y))*1.9+1500.0
        b = MapBounds(f64(island.center.x)-rx,f64(island.center.y)-rx,f64(island.center.x)+rx,f64(island.center.y)+rx)
        m = PaperMap("principal:{island.id}:1921","{s.name} and its island: harbour and paths, 1921","Island Co-operative Press",1921,.tourist,b,45000,2,[.coast,.towns,.roads,.landmarks,.lighthouses,.moorings],95,survey_offset=vec2(35,-20),notes="A local visitor's sheet. Paths, places and moorings, without navigation soundings.")
        key = "chandler:{s.id}"
        if not (key in w.maps.shops):
            account = new_account(w,"map-chandler:{s.id}",3000)
            w.maps.shops[key] = MapShop(key,"{s.name} chandlery",s.id,account=account,pos=s.center,kind="chandler")
        if not (publish_map(w,m,[key,capitals[s.country]],550)):
            living_fault("map_scene.publish_settlement_maps.3",guard_context(w))
            return
    keys = w.maps.editions.keys(); keys.sort()
    loop key in keys: map_snapshot_features(w,key)
    w.maps.catalog_version = SETTLEMENT_VERSION


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
publish_settlement_maps = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_publish_settlement_maps(w)
    guard_finish(w,scope)
