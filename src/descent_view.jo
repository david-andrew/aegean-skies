use 'world_point.jo'
use 'render_space.jo'
use 'bailout.jo'

# Sky Barons FALL uses timer * .15 radians at 60 Hz, about 1.8 somersaults before
# the canopy opens. CHUTE is upright with a fully open canopy, without a bloom or sway cycle.
descent_frame = (d: Descent) -> mat4:
    at=translation(d.position)*rotation_y(d.yaw)
    if d.phase==.falling:at*rotation_x(d.age*9.0) else:at

struct DescentCamera:
    look: FollowCamera = follow_camera(distance=9.0,pitch=0.0,height=1.9)
    eye: vec3 = vec3(0,0,0)
    point=WorldPoint()
    ready=false
    frame=FollowFrame()

# Follow the eye, not just the target: the same shoulder offset and 14/s approach as
# Sky Barons. Mouse/stick aim stays independent of the tumbling person's orientation.
update_descent_camera = (c: mut DescentCamera,d: Descent,dt: f64,input: bool = true,ground: (f64,f64)->f64 = (x:f64,z:f64)->f64:0.0):
    c.look.smooth=0
    c.look.min_distance=9;c.look.max_distance=9
    c.look.min_pitch=-1.45;c.look.max_pitch=1.45
    c.look.height=if d.phase==.canopy:2.0 else:if d.phase==.swimming:1.2 else:1.9
    update_local_follow(c.look,c.frame,descent_point(d),dt,input=input)
    want=world_offset(world_point(c.frame.origin),position(c.look)+flat_right(c.look)*0.7)
    c.point=world_lerp(if c.ready:c.point else:world_point(c.eye),want,1.0-exp(-14.0*dt))
    c.point.y=max(c.point.y,max(0.0,ground(c.point.x,c.point.z))+1.0)
    c.eye=world_vec(c.point);c.ready=true

descent_aim = (c: DescentCamera) -> vec3:
    c.eye+vec3(-sin(c.look.yaw)*cos(c.look.pitch),-sin(c.look.pitch),-cos(c.look.yaw)*cos(c.look.pitch))*20.0

# The reference widens the vertical view on portrait screens.
descent_fov = () -> f64:
    a=aspect_ratio()
    if a>=1.0:65.0 else:degrees(2.0*atan(tan(radians(32.5))/sqrt(a)))

place_descent_camera=(c:DescentCamera,far:f64):
    direction=vec3(-sin(c.look.yaw)*cos(c.look.pitch),-sin(c.look.pitch),-cos(c.look.yaw)*cos(c.look.pitch))
    precise_camera(if c.ready:c.point else:world_point(c.eye),direction,descent_fov(),0.1,far)
