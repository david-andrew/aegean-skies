# Governments can propose peace because their real finances, food or received losses warrant
# it. Two signed offers must physically reach the opposite councils; no calendar ends a war.
use 'living_types.jo'
use 'living_war_types.jo'
use 'living_far_types.jo'
use 'living_far_news.jo'
use 'living_war.jo'
use 'living_place_context.jo'

peace_key = (a: int,b: int,issuer: int) -> str: "{min(a,b)}:{max(a,b)}:{issuer}"
peace_seat = (w: World, country: int) -> int:
    c=w.countries[country]
    if c.capital_id>=0: c.capital_id else: c.seat

offer_ceasefire = (w: mut World, country: int, other: int) -> int:
    relation=war_relation(w,country,other)
    if relation<0 or w.diplomacy[relation].stage!=.war: return -1
    place=peace_seat(w,country)
    if not (place in w.far.districts) or w.far.districts[place].controller!=country: return -1
    key=peace_key(country,other,country)
    if key in w.war.peace_offers and w.minute-w.war.peace_offers[key].occurred_minute<FAR_SIGNED_REPORT_MINUTES: return w.war.peace_offers[key].id
    id=far_local_news(w,place,"ceasefire_request","The {w.countries[country].name} council at {life_place_name(w,place)} offered {w.countries[other].name} a ceasefire and asked for a signed reply.",country=country,other_country=other,state_backed=true,severity=950)
    if id>=0: w.war.peace_offers[key]=far_news_snapshot(w.far.news[id],w.minute)
    id

peace_offer_received = (w: World, place: int, offer: FarReport) -> bool:
    if not (place in w.far.districts) or w.minute-offer.occurred_minute>=FAR_SIGNED_REPORT_MINUTES: return false
    loop r in w.far.districts[place].reports:
        if r.id==offer.id and r.country==offer.country and r.other_country==offer.other_country and r.kind=="ceasefire_request" and r.state_backed and r.hops==0 and r.confidence>=900: return true
    false

settle_ceasefires = (w: mut World):
    loop relation in 0..w.diplomacy.len():
        r=w.diplomacy[relation]
        if r.stage!=.war: continue
        ak=peace_key(r.a,r.b,r.a); bk=peace_key(r.a,r.b,r.b)
        if not (ak in w.war.peace_offers) or not (bk in w.war.peace_offers): continue
        a=w.war.peace_offers[ak]; b=w.war.peace_offers[bk]
        ap=peace_seat(w,r.a); bp=peace_seat(w,r.b)
        if not peace_offer_received(w,ap,b) or not peace_offer_received(w,bp,a): continue
        w.diplomacy[relation].stage=.armistice
        w.war.peace_offers.remove(ak); w.war.peace_offers.remove(bk)
        loop place in [ap,bp]:
            far_local_news(w,place,"armistice","Both signed ceasefire proposals reached the councils. {w.countries[r.a].name} and {w.countries[r.b].name} have agreed to stop fighting. Orders must still reach their forces.",country=r.a,other_country=r.b,state_backed=true,severity=1000)

war_peace_minute = (w: mut World):
    if not w.far.populated or w.minute%360!=0: return
    loop r in w.diplomacy:
        if r.stage!=.war: continue
        loop country in [r.a,r.b]:
            other=if country==r.a: r.b else: r.a
            place=peace_seat(w,country)
            if not (place in w.far.districts): continue
            d=w.far.districts[place]; losses: {int: bool}
            loop notice in d.reports:
                if notice.kind=="battle" and notice.affected==country and notice.confidence>=700 and far_report_current(w,notice) and w.minute-notice.learned_minute<20160: losses[notice.id]=true
            exhausted=w.accounts[w.far.treasury[country]].cents<50000 or d.hunger>=500 or losses.len()>=2
            if exhausted: offer_ceasefire(w,country,other)
    settle_ceasefires(w)
