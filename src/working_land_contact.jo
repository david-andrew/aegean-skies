use 'settlement_purpose.jo'
use 'settlements.jo'
use 'geography.jo'
use 'town_sites.jo'

working_building=(s:WorldSettlement,facility:WorkingFacility)->TownSite:
    TownSite(facility.at,facility.yaw,9,10,4,s.seed,service=true,door_y=f64(facility.at.y))

working_near=(p:vec2)->TownSite[]:
    result:TownSite[]
    loop index in settlement_bins.get(geography_bin(f64(p.x),f64(p.y)),[]):
        s=world_settlements[index]
        if s.legacy>=0 or length(p-s.center.xz)>f32(s.radius+310):continue
        if let facility=working_facility(s):
            if length(p-facility.at.xz)<12:result.push(working_building(s,facility))
    result

working_contact=(p:vec2,ground:f64)->f64:
    result=ground
    loop site in working_near(p):
        q=site_local(site,p)
        if abs(q.x)<4.65 and abs(q.y)<5.15:result=max(result,f64(site.at.y))
        result=entry_height(site_entry(site),p,result)
    result

working_exclude=(p:vec2,height:f64)->vec2:
    result=p
    loop site in working_near(p):
        loop box in [vec4(-4.4,0,0.45,10),vec4(4.4,0,0.45,10),vec4(0,-4.8,8.35,0.45)]:
            at=site_point(site,box.x,box.y);wall=TownSite(vec3(at.x,site.at.y,at.y),site.yaw,box.z,box.w,4,0)
            if height<f64(wall.at.y)+wall.height:result=site_exclude_box(wall,result)
        # Keep the visible mill/press/racks solid too, leaving the open front
        # clear for a worker to stand beside the equipment.
        equipment=site;equipment.width=4.0;equipment.depth=3.0;equipment.height=2.0
        if height<f64(site.at.y)+2.0:result=site_exclude_box(equipment,result)
    result
