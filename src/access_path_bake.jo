# Bounded offline track routing. Never used by a frame or a minute update.
use 'settlements.jo'
use 'living_feeder_bake.jo'
use 'water_field.jo'

access_track=(a:vec2,b:vec2,cell:f32=4.0,margin:f32=200.0)->vec3[]:
    low=min(a,b)-vec2(margin,margin);high=max(a,b)+vec2(margin,margin)
    nx=int(ceil((high.x-low.x)/cell))+1;nz=int(ceil((high.y-low.y)/cell))+1
    origin=a-vec2(floor((a.x-low.x)/cell),floor((a.y-low.y)/cell))*cell
    start=int(round((a.x-origin.x)/cell))+int(round((a.y-origin.y)/cell))*nx
    points:{int:vec3}={start:place_point(a)};cost:{int:f64}={start:0.0};parent:{int:int}={start: -1};closed:{int:bool}
    queue:(f64,int)[]=[(f64(length(b-a)),start)]
    goal= -1
    loop queue.len()>0 and closed.len()<180000:
        item=queue.heap_pop();id=item.1
        if id in closed:continue
        closed[id]=true;p=points[id]
        if length(p.xz-b)<cell*1.5 and feeder_segment_clear(p,place_point(b)):goal=id;break
        loop dy in -1..2:
            loop dx in -1..2:
                if dx==0 and dy==0:continue
                ix=id%nx+dx;iy=id/nx+dy
                if ix<0 or ix>=nx or iy<0 or iy>=nz:continue
                next=ix+iy*nx
                if next in closed:continue
                if not (next in points):points[next]=place_point(origin+vec2(f32(ix),f32(iy))*cell)
                q=points[next]
                if water_at(f64(q.x),f64(q.z)).wet or not feeder_segment_clear(p,q):continue
                candidate=cost[id]+f64(length(q.xz-p.xz))+abs(f64(q.y-p.y))*3.0
                if candidate>=cost.get(next,1e30):continue
                cost[next]=candidate;parent[next]=id
                queue.heap_push((candidate+f64(length(q.xz-b)),next))
    if goal<0:return []
    backwards=[place_point(b)];id=goal
    loop id>=0:backwards.push(points[id]);id=parent[id]
    backwards.reverse()
    # Straighten only across validated dry, wagon-width segments. No corner cutting.
    result=[backwards[0]];at=0
    loop at<backwards.len()-1:
        next=at+1
        loop k in at+2..min(backwards.len(),at+33):
            if not feeder_segment_clear(backwards[at],backwards[k]):break
            next=k
        result.push(backwards[next]);at=next
    result

# Long routes retain the cheap contour search; only obstructed local spans need
# the fine grid. Skip intermediate coarse stations inside houses instead of
# asking a walker to arrive inside a wall before continuing out the other side.
access_contour_track=(a:vec2,b:vec2)->vec3[]:
    coarse=place_route(a,b)
    if coarse.len()<2:return []
    result=[coarse[0]];at=1
    loop at<coarse.len():
        target=coarse[at]
        if at<coarse.len()-1:
            clear=true
            loop offset in [vec2(0,0),vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1)]:
                q=target.xz+offset
                if length(settlement_avoid_buildings(q)-q)>0.15:clear=false
            if not clear:at+=1;continue
        previous=result[result.len()-1]
        if feeder_segment_clear(previous,target):result.push(target)
        else:
            detour=access_track(previous.xz,target.xz)
            if detour.len()<2:return []
            result.extend(detour[1..])
        at+=1
    result
