# Bounded offline track routing. Never used by a frame or a minute update.
use 'settlements.jo'
use 'living_feeder_bake.jo'
use 'water_field.jo'
use 'access_bridges.jo'
use 'walk_shapes.jo'
use 'objects.jo'
use 'world_point.jo'

# A stepped footpath (kalderimi) from a clifftop chapel or hill village down to
# its own cove landing: one person wide and steep where the coast is a cliff.
# Only a landing's local approach may use it; carts and feeders never do. It
# keeps the dry, building and walking-contact rules of the wagon track.
const STEPPED_GRADE=1.0
stepped_segment_clear=(from:vec3,to:vec3)->bool:
    delta=to.xz-from.xz;distance=f64(length(delta))
    if distance<0.01:return true
    side=vec2(-delta.y,delta.x)/f32(distance)
    count=max(1,int(ceil(distance/2.0)));last=place_ground(from.xz)
    loop i in 0..count+1:
        p=mix(from.xz,to.xz,f32(f64(i)/f64(count)));h=place_ground(p)
        water=water_at(f64(p.x),f64(p.y))
        if water.wet and h<water.level+0.5 or h<1.0 or abs(h-last)>distance/f64(count)*STEPPED_GRADE+0.08:return false
        loop offset in [-0.6,0.6]:
            q=p+side*f32(offset);edge=place_ground(q)
            # Treads are cut into the slope behind a retaining edge, as on a
            # kalderimi, so cross slope is the walker's contact check, not here.
            if edge<0.8 or length(settlement_avoid_buildings(q)-q)>0.15:return false
        last=h
    true

# Optional close-contact sweep for short island roads: the walking capsule and
# frontage pieces can extend beyond the older settlement footprint probe.
access_segment_clear=(a:vec3,b:vec3,precise:bool,stepped:bool=false)->bool:
    if not (if stepped:stepped_segment_clear(a,b) else:feeder_segment_clear(a,b)):return false
    if not precise:return true
    delta=b.xz-a.xz;distance=f64(length(delta))
    if distance<0.01:return true
    side=vec2(-delta.y,delta.x)/f32(distance)
    count=max(1,int(ceil(distance/0.5)))
    loop k in 0..count+1:
        p=mix(a.xz,b.xz,f32(k)/f32(count))
        loop offset in [-0.8,0.0,0.8]:
            q=p+side*f32(offset)
            if length(walk_far_exclude(q,place_ground(q))-q)>0.01:return false
    # Working buildings, baths, stairs and physical contact share the player's
    # complete walking query; the footprint-only survey missed an olive press.
    point=world_point(a);point.y=walk_height([],point.x,point.z)
    steps=max(1,int(ceil(distance/0.25)))
    loop k in 0..steps:
        delta=vec2(f32(f64(b.x)-point.x),f32(f64(b.z)-point.z))/f32(steps-k)
        previous=point;point=walk_step_precise([],point,delta)
        if abs(point.x-previous.x-f64(delta.x))>0.01 or abs(point.z-previous.z-f64(delta.y))>0.01:return false
    true

access_track=(a:vec2,b:vec2,cell:f32=4.0,margin:f32=200.0,precise:bool=false,stepped:bool=false,limit:int=180000)->vec3[]:
    low=min(a,b)-vec2(margin,margin);high=max(a,b)+vec2(margin,margin)
    nx=int(ceil((high.x-low.x)/cell))+1;nz=int(ceil((high.y-low.y)/cell))+1
    origin=a-vec2(floor((a.x-low.x)/cell),floor((a.y-low.y)/cell))*cell
    start=int(round((a.x-origin.x)/cell))+int(round((a.y-origin.y)/cell))*nx
    points:{int:vec3}={start:place_point(a)};cost:{int:f64}={start:0.0};parent:{int:int}={start: -1};closed:{int:bool}
    queue:(f64,int)[]=[(f64(length(b-a)),start)]
    goal= -1
    loop queue.len()>0 and closed.len()<limit:
        item=queue.heap_pop();id=item.1
        if id in closed:continue
        closed[id]=true;p=points[id]
        if length(p.xz-b)<cell*1.5 and access_segment_clear(p,place_point(b),precise,stepped):goal=id;break
        loop dy in -1..2:
            loop dx in -1..2:
                if dx==0 and dy==0:continue
                ix=id%nx+dx;iy=id/nx+dy
                if ix<0 or ix>=nx or iy<0 or iy>=nz:continue
                next=ix+iy*nx
                if next in closed:continue
                if not (next in points):
                    candidate=place_point(origin+vec2(f32(ix),f32(iy))*cell)
                    candidate.y=f32(access_bridge_height(candidate.xz,f64(candidate.y)))
                    points[next]=candidate
                q=points[next]
                water=water_at(f64(q.x),f64(q.z))
                if water.wet and f64(q.y)<water.level+0.5 or not access_segment_clear(p,q,precise,stepped):continue
                candidate=cost[id]+f64(length(q.xz-p.xz))+abs(f64(q.y-p.y))*3.0
                if candidate>=cost.get(next,1e30):continue
                cost[next]=candidate;parent[next]=id
                queue.heap_push((candidate+f64(length(q.xz-b)),next))
    if goal<0:return []
    backwards=[place_point(b)];id=goal
    loop id>=0:backwards.push(points[id]);id=parent[id]
    backwards.reverse()
    # Straighten only across validated dry, wagon-width segments. No corner cutting.
    result=[backwards[0]];at=0
    loop at<backwards.len()-1:
        next=at+1
        loop k in at+2..min(backwards.len(),at+33):
            if not access_segment_clear(backwards[at],backwards[k],precise,stepped):break
            next=k
        result.push(backwards[next]);at=next
    result

# Long routes retain the cheap contour search; only obstructed local spans need
# the fine grid. Skip intermediate coarse stations inside houses instead of
# asking a walker to arrive inside a wall before continuing out the other side.
access_contour_track=(a:vec2,b:vec2)->vec3[]:
    coarse=place_route(a,b)
    if coarse.len()<2:return []
    result=[coarse[0]];at=1
    loop at<coarse.len():
        target=coarse[at]
        if at<coarse.len()-1:
            clear=true
            loop offset in [vec2(0,0),vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1)]:
                q=target.xz+offset
                if length(settlement_avoid_buildings(q)-q)>0.15:clear=false
            if not clear:at+=1;continue
        previous=result[result.len()-1]
        if feeder_segment_clear(previous,target):result.push(target)
        else:
            detour=access_track(previous.xz,target.xz)
            if detour.len()<2:return []
            result.extend(detour[1..])
        at+=1
    result
