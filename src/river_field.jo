# Shared drainage, bed and water authority. No renderer or terrain dependency.
use 'river_data.jo'
const RIVER_VERSION = 1
struct RiverSample:
    found = false
    wet = false
    level = 0.0
    distance = 1e30
    width = 1.0
    slope = vec2(0,0)
    current = vec3(0,0,0)
    segment = -1

river_at = (x: f64,z: f64) -> RiverSample:
    r = RiverSample()
    if x < -161100.0 or x > -85000.0 or z < -162000.0 or z > -140000.0: return r
    key = int(floor(x/2048.0))*1024+int(floor(z/2048.0))
    if not (key in RIVER_BINS): return r
    loop i in RIVER_BINS[key]:
        a=RIVER_NODES[i]; b=RIVER_NODES[i+1]
        dx=f64(b.x-a.x); dz=f64(b.y-a.y)
        l2=dx*dx+dz*dz
        u=clamp(((x-f64(a.x))*dx+(z-f64(a.y))*dz)/l2,0.0,1.0)
        ex=x-f64(a.x)-dx*u; ez=z-f64(a.y)-dz*u
        d=sqrt(ex*ex+ez*ez)
        if d >= r.distance: continue
        width=mix(f64(a.w),f64(b.w),u)
        level=mix(f64(a.z),f64(b.z),u)
        slope=vec2(f32(dx*(f64(b.z)-f64(a.z))/l2),f32(dz*(f64(b.z)-f64(a.z))/l2))
        flow=normalize(vec3(f32(dx),0,f32(dz)))*f32(0.45+0.35*(1.0-smoothstep(0.0,width,d)))
        r=RiverSample(true,d<width,level,d,width,slope,flow,i)
    r

river_carve = (x:f64,z:f64,h:f64)->f64:
    r=river_at(x,z)
    if not r.found or r.distance>=r.width*4.0:return h
    # Flat navigable bed, sloping shallows, then a broad valley shoulder.
    bed=r.level-5.0+7.0*smoothstep(r.width*0.65,r.width*1.15,r.distance)
    blend=smoothstep(r.width*1.15,r.width*4.0,r.distance)
    min(h,mix(bed,max(h,r.level+2.0),blend))

river_current = (x:f64,z:f64)->vec3:
    r=river_at(x,z)
    if r.wet:r.current else:vec3(0,0,0)
