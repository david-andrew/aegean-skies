# Shared drainage, bed and water authority. No renderer or terrain dependency.
use 'river_data.jo'
const RIVER_VERSION = 2
struct RiverSample:
    found = false
    wet = false
    level = 0.0
    distance = 1e30
    width = 1.0
    slope = vec2(0,0)
    current = vec3(0,0,0)
    segment = -1
    lateral = 0.0
    bend = 0.0
    along = 0.0

river_at = (x: f64,z: f64) -> RiverSample:
    r = RiverSample()
    if x<f64(RIVER_BOUNDS.x) or x>f64(RIVER_BOUNDS.z) or z<f64(RIVER_BOUNDS.y) or z>f64(RIVER_BOUNDS.w):return r
    key = int(floor(x/2048.0))*1024+int(floor(z/2048.0))
    if not (key in RIVER_BINS): return r
    loop i in RIVER_BINS[key]:
        a=RIVER_NODES[i]; b=RIVER_NODES[i+1]
        dx=f64(b.x-a.x); dz=f64(b.y-a.y)
        l2=dx*dx+dz*dz
        u=clamp(((x-f64(a.x))*dx+(z-f64(a.y))*dz)/l2,0.0,1.0)
        ex=x-f64(a.x)-dx*u; ez=z-f64(a.y)-dz*u
        d=sqrt(ex*ex+ez*ez)
        if d >= r.distance: continue
        width=mix(f64(a.w),f64(b.w),u)
        level=mix(f64(a.z),f64(b.z),u)
        slope=vec2(f32(dx*(f64(b.z)-f64(a.z))/l2),f32(dz*(f64(b.z)-f64(a.z))/l2))
        flow=normalize(vec3(f32(dx),0,f32(dz)))*f32(0.45+0.35*(1.0-smoothstep(0.0,width,d)))
        r=RiverSample(true,d<width,level,d,width,slope,flow,i)
        r.lateral=(dx*ez-dz*ex)/sqrt(l2)
        prev=if RIVER_BREAKS.contains(i-1):a else:RIVER_NODES[max(0,i-1)]
        next=if RIVER_BREAKS.contains(i+1):b else:RIVER_NODES[min(RIVER_NODES.len()-1,i+2)]
        before=normalize(a.xy-prev.xy+vec2(0.0001,0));after=normalize(next.xy-b.xy+vec2(0.0001,0))
        r.bend=clamp(f64(before.x*after.y-before.y*after.x)*5.0,-1.0,1.0)
        r.along=f64(i)+u
    r

river_carve = (x:f64,z:f64,h:f64)->f64:
    r=river_at(x,z)
    if not r.found or r.distance>=r.width*6.0:return h
    if r.segment>=CANAL_BEGIN:
        bank=r.level-4.5+6.5*smoothstep(r.width+14.0,r.width+28.0,r.distance)
        plateau=mix(bank,r.level+2.0,smoothstep(r.width+28.0,r.width+32.0,r.distance))
        return mix(plateau,h,smoothstep(r.width*4.5,r.width*6.0,r.distance))
    # Inside bends accumulate sand/gravel; outside bends undercut a steep bank.
    inner=clamp(r.bend*r.lateral/r.width,-1.0,1.0)
    shore=r.width*(1.0-inner*0.18)
    start=if inner>0.0:0.28 else:0.68
    bed=r.level-4.5+6.0*smoothstep(shore*start,shore*1.06,r.distance)
    # Repeated floodplain benches with broad, uneven shoulders.
    terrace=r.level+1.5+2.5*smoothstep(shore*1.5,shore*2.0,r.distance)
    terrace+=4.0*smoothstep(shore*2.7,shore*3.4,r.distance)
    valley=mix(bed,terrace,smoothstep(shore*1.06,shore*1.3,r.distance))
    blend=smoothstep(r.width*3.4,r.width*6.0,r.distance)
    # Occasional elongated gravel islands leave the central navigation lane open.
    station=f64(int(r.along/64.0)*64+35)
    bar=exp(-pow((r.along-station)/1.6,2.0)-pow((r.lateral-r.width*0.58)/(r.width*0.17),2.0))
    bedded=min(h,mix(valley,max(h,terrace),blend))
    if bar>0.02:max(bedded,r.level-6.0+6.8*bar) else:bedded

river_current = (x:f64,z:f64)->vec3:
    r=river_at(x,z)
    if r.wet:r.current else:vec3(0,0,0)

# Baked broad material mask; geometry/contact still use exact reach queries.
river_material_image=()->Image:
    img=image(2048,768)
    span=RIVER_BOUNDS.zw-RIVER_BOUNDS.xy
    loop y in 0..768:
        loop x in 0..2048:
            p=RIVER_BOUNDS.xy+span*vec2((f32(x)+0.5)/2048.0,(f32(y)+0.5)/768.0)
            r=river_at(f64(p.x),f64(p.y))
            if r.found and r.segment<CANAL_BEGIN and r.distance<r.width*4.0:
                img.set(x,y,vec4(f32(r.level/256.0),f32(r.distance/(r.width*4.0)),0,1))
    img
