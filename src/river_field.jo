# Shared drainage, bed and water authority. No renderer or terrain dependency.
use 'river_data.jo'
const RIVER_VERSION = 5
use 'water_types.jo'
type RiverSample=WaterSample

# Confluences: a tributary's mouth flares into its parent along circular fillets, so each bank
# turns to run along the parent's instead of meeting it at a square corner; the downstream
# corner is swept wider than the upstream one. The flare is a width along the tributary's last
# segments, so the water surface, carve and contact all read the same shape.
struct RiverMouth:
    last: int                      # the tributary's end node, on the parent's centreline
    down: f64                      # fillet radius on the downstream side
    up: f64
    down_side: f64                 # sign of the lateral offset that faces downstream
    bank: vec2                     # distance back from the end node where the (-, +) bank meets the parent

# Distance from p to the parent's channel centreline near node k.
_river_parent_distance = (k: int,p: vec2) -> f64:
    best = 1e30
    loop j in max(0,k-4)..min(RIVER_NODES.len()-1,k+4):
        if RIVER_BREAKS.contains(j): continue
        a = RIVER_NODES[j].xy; b = RIVER_NODES[j+1].xy
        u = clamp(dot(p-a,b-a)/max(dot(b-a,b-a),0.0001),0.0,1.0)
        best = min(best,f64(length(p-(a+(b-a)*u))))
    best

# How far back along a tributary its end node lies, from fraction u of segment i.
river_mouth_back = (i: int,u: f64,last: int) -> f64:
    back = (1.0-u)*f64(length(RIVER_NODES[i+1].xy-RIVER_NODES[i].xy))
    loop j in i+1..last: back += f64(length(RIVER_NODES[j+1].xy-RIVER_NODES[j].xy))
    back

river_mouths = () -> RiverMouth[]:
    out: RiverMouth[]
    loop mouth in RIVER_BREAKS:
        if mouth >= CANAL_BEGIN or mouth == 0: continue
        e = RIVER_NODES[mouth]
        # (this tributary's own chain starts after the previous break)
        first = 0
        loop other in RIVER_BREAKS:
            if other < mouth: first = max(first,other+1)
        loop k in 0..RIVER_NODES.len()-1:
            if k >= first and k <= mouth: continue
            if RIVER_BREAKS.contains(k) or k >= CANAL_BEGIN: continue
            if length(RIVER_NODES[k].xy-e.xy) > 1.0: continue
            flow = normalize(RIVER_NODES[k+1].xy-RIVER_NODES[max(0,k-1)].xy)
            along = normalize(e.xy-RIVER_NODES[mouth-1].xy)
            side = vec2(-along.y,along.x)
            radius = clamp(f64(e.w)*0.8,15.0,30.0)
            # Walk each bank back up the tributary until it leaves the parent's channel.
            bank = vec2(0,0)
            loop s in 0..2:
                sign: f32 = if s == 0: -1.0 else: 1.0
                back = 0.0
                loop back < 400.0:
                    i = mouth-1
                    loop i > first and river_mouth_back(i,0.0,mouth) < back: i -= 1
                    a = RIVER_NODES[i]; b = RIVER_NODES[i+1]
                    l = f64(length(b.xy-a.xy))
                    u = clamp(1.0-(back-river_mouth_back(i,1.0,mouth))/l,0.0,1.0)
                    c = mix(a.xy,b.xy,f32(u)); d = normalize(b.xy-a.xy)
                    if _river_parent_distance(k,c+vec2(-d.y,d.x)*a.w*sign) > f64(RIVER_NODES[k].w): break
                    back += 1.0
                if s == 0: bank.x = f32(back) else: bank.y = f32(back)
            out.push(RiverMouth(mouth,radius*1.3,radius*0.7,if dot(side,flow) > 0.0: 1.0 else: -1.0,bank))
            break
    out
RIVER_MOUTHS = river_mouths()

# Extra half-width on one side (the sign of lateral) of segment i at fraction u (unclamped).
river_mouth_flare = (i: int,x: f64,z: f64,u: f64,lateral: f64) -> f64:
    loop m in RIVER_MOUTHS:
        if i < m.last-3 or i >= m.last: continue
        if i == m.last-1 and u > 1.0: return 0.0
        radius = if lateral*m.down_side > 0.0: m.down else: m.up
        t = river_mouth_back(i,clamp(u,0.0,1.0),m.last)-f64(if lateral < 0.0: m.bank.x else: m.bank.y)
        if t <= 0.0: return radius
        if t >= radius: return 0.0
        return radius-sqrt(max(0.0,radius*radius-(radius-t)*(radius-t)))
    0.0

river_at = (x: f64,z: f64) -> RiverSample:
    if x<f64(RIVER_BOUNDS.x) or x>f64(RIVER_BOUNDS.z) or z<f64(RIVER_BOUNDS.y) or z>f64(RIVER_BOUNDS.w):return NO_INLAND_WATER
    key = int(floor(x/2048.0))*1024+int(floor(z/2048.0))
    if not (key in RIVER_BINS): return NO_INLAND_WATER
    r=NO_INLAND_WATER
    loop i in RIVER_BINS[key]:
        a=RIVER_NODES[i]; b=RIVER_NODES[i+1]
        dx=f64(b.x-a.x); dz=f64(b.y-a.y)
        l2=dx*dx+dz*dz
        raw=((x-f64(a.x))*dx+(z-f64(a.y))*dz)/l2
        u=clamp(raw,0.0,1.0)
        ex=x-f64(a.x)-dx*u; ez=z-f64(a.y)-dz*u
        d=sqrt(ex*ex+ez*ez)
        width=mix(f64(a.w),f64(b.w),u)
        if i >= RIVER_MAIN_COUNT and i < CANAL_BEGIN: width+=river_mouth_flare(i,x,z,raw,(dx*ez-dz*ex)/sqrt(l2))
        # Confluences are the union of their channels. A nearby narrow tributary's
        # dry bank must not override water inside the wider parent river.
        wet=d<width
        if r.found:
            if r.wet and not wet:continue
            if wet==r.wet and d/width>=r.distance/r.width:continue
        level=mix(f64(a.z),f64(b.z),u)
        slope=vec2(f32(dx*(f64(b.z)-f64(a.z))/l2),f32(dz*(f64(b.z)-f64(a.z))/l2))
        flow=normalize(vec3(f32(dx),0,f32(dz)))*f32(0.45+0.35*(1.0-smoothstep(0.0,width,d)))
        r=WaterSample(true,d<width,level,d,width,slope,flow,i)
        r.kind=.river;r.id=1
        loop boundary in RIVER_BREAKS:
            if boundary<i:r.id+=1
        r.lateral=(dx*ez-dz*ex)/sqrt(l2)
        prev=if RIVER_BREAKS.contains(i-1):a else:RIVER_NODES[max(0,i-1)]
        next=if RIVER_BREAKS.contains(i+1):b else:RIVER_NODES[min(RIVER_NODES.len()-1,i+2)]
        before=normalize(a.xy-prev.xy+vec2(0.0001,0));after=normalize(next.xy-b.xy+vec2(0.0001,0))
        r.bend=clamp(f64(before.x*after.y-before.y*after.x)*5.0,-1.0,1.0)
        r.along=f64(i)+u
    r

river_carve = (x:f64,z:f64,h:f64)->f64:
    r=river_at(x,z)
    # (a canal's carve fades out by eight widths, but no more than 140 m past a wide basin's wall)
    reach=if r.segment>=CANAL_BEGIN:(if r.width<=22.0:r.width*8.0 else:r.width+140.0) else:r.width*6.0
    if not r.found or r.distance>=reach:return h
    if r.segment>=CANAL_BEGIN:
        bank=r.level-4.5+6.5*smoothstep(r.width+14.0,r.width+28.0,r.distance)
        plateau=mix(bank,r.level+2.0,smoothstep(r.width+28.0,r.width+32.0,r.distance))
        return mix(plateau,h,smoothstep(r.width+34.0,reach,r.distance))
    # Inside bends accumulate sand/gravel; outside bends undercut a steep bank.
    inner=clamp(r.bend*r.lateral/r.width,-1.0,1.0)
    shore=r.width*(1.0-inner*0.18)
    start=if inner>0.0:0.28 else:0.68
    bed=r.level-4.5+6.0*smoothstep(shore*start,shore*1.06,r.distance)
    # Repeated floodplain benches with broad, uneven shoulders.
    terrace=r.level+1.5+2.5*smoothstep(shore*1.5,shore*2.0,r.distance)
    terrace+=4.0*smoothstep(shore*2.7,shore*3.4,r.distance)
    valley=mix(bed,terrace,smoothstep(shore*1.06,shore*1.3,r.distance))
    blend=smoothstep(r.width*3.4,r.width*6.0,r.distance)
    # Occasional elongated gravel islands leave the central navigation lane open.
    station=f64(int(r.along/64.0)*64+35)
    bar=exp(-pow((r.along-station)/1.6,2.0)-pow((r.lateral-r.width*0.58)/(r.width*0.17),2.0))
    bedded=min(h,mix(valley,max(h,terrace),blend))
    if bar>0.02:max(bedded,r.level-6.0+6.8*bar) else:bedded

river_current = (x:f64,z:f64)->vec3:
    r=river_at(x,z)
    if r.wet:r.current else:vec3(0,0,0)

# Baked broad material mask; geometry/contact still use exact reach queries.
river_material_image=()->Image:
    img=image(2048,768)
    span=RIVER_BOUNDS.zw-RIVER_BOUNDS.xy
    loop y in 0..768:
        loop x in 0..2048:
            p=RIVER_BOUNDS.xy+span*vec2((f32(x)+0.5)/2048.0,(f32(y)+0.5)/768.0)
            r=river_at(f64(p.x),f64(p.y))
            if r.found and r.distance<r.width*4.0:
                img.set(x,y,vec4(f32(r.level/256.0),f32(r.distance/(r.width*4.0)),0,1))
    img
