# Shared source contract. Coordinates/metres are world-space, independent of camera/LOD.
# found: an inland source/corridor is known here; wet: inside its water footprint.
# Ocean fallback has kind=ocean, id=0, level=0, found=false, wet=false: the existing
# terrain/sea contact decides whether that plane is exposed, and sea swell stays intact.
enum WaterKind: ocean, river, lake
struct WaterSample:
    found = false
    wet = false
    level = 0.0
    distance = 1e30
    width = 1.0
    slope = vec2(0,0)
    current = vec3(0,0,0)
    segment = -1
    lateral = 0.0
    bend = 0.0
    along = 0.0
    kind:WaterKind = .ocean
    id = 0                         # 1..99999 rivers/canals; >=100000 lakes/reservoirs
