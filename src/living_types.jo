    next_job = 0
    defaulted_people: {int: bool}
    last_local_raid: {int: int}
    next_news_event = 0
    next_event = 0
    next_aftermath = 0
    bounty_handled: {int: bool}
    raid_departures = 0
    patrol_departures = 0
