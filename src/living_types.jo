use 'life_types.jo'
use 'living_map_types.jo'

# Headless living-world schema. IDs are stable; money is centesimi.
const GOOD_COUNT = 9
const NONE_ID = -1
const TICKS_PER_MINUTE = 120
const EPOCH_LOCAL_MINUTE = 570      # day zero 09:30

enum GoodKind: fish, wine, oil, grain, fuel, parts, medicine, tobacco, arms
enum Occupation: player, merchant, courier, mechanic, clerk, innkeeper, fisher, patrol, telegraphist, oil_presser, miller, teacher, nurse, priest, hotelier, racer, pirate, quartermaster
enum Vice: none, smuggle, gamble, join_pirates, refuse_flight
enum PersonState: idle, working, walking, traveling, resting, injured, refusing, departed
enum Airframe: gull, heron, corsair, falco, tern, petrel, osprey, swift, pelican, kite, ibis, kestrel, minnow, albatross, cormorant, kingfisher
enum CraftState: moored, taxi, airborne, approach, workshop, ditched, wrecked
enum MoveOwner: abstract_world, scene
enum TripState: preparing, active, holding, diverted, arrived, failed
enum TripMode: aircraft, boat, ferry, tow
enum Purpose: delivery, passenger, trade, fishing, patrol, raid, repair, visit, return_home, rescue, settle, salvage, report
enum Activity: wait, work, fulfill, travel, rest, socialize, raid, patrol, trade, gamble, smuggle, refuse
enum ObligationKind: debt, delivery, passenger, shift, repair, rent, supply
enum ObligationState: open, blocked, fulfilled, breached, defaulted, cancelled
enum JobState: open, claimed, delivered, failed, expired, cancelled
enum CargoMode: none, commodity, sealed
enum EventKind: departed, arrived, produced, delivery, late, defaulted, theft, raid, patrol, rescue, ditch, repair, shortage, closure, refused, fine, search, met, quarrel, celebration
enum SubjectKind: person, faction
enum WeatherKind: fair, wind, squall, storm
enum AftermathKind: crate, beach_wreck, workshop_plane, stranded_boat, injured_person
enum MoneyKind: opening, trade, wage, reward, escrow, refund, debt, interest, rent, fuel, repair, fine, theft, outside_import, household_sale, outside_export, subsidy, gambling, departure, outside_credit

struct Good:
    kind: GoodKind
    key: str
    package_grams: int
    base_cents: int
    shelf_hours: int = 0           # 0 = no spoilage
    illegal: bool = false

struct Inventory:
    qty: int[GOOD_COUNT]           # milli-packages
    reserved: int[GOOD_COUNT]      # subset of qty, never an extra stock

# Physical goods and the custody inventories are two projections of the SAME stock.
# A reserved crate in a porter's hands remains charged to its source until handover.
enum CargoStore: market, pocket, aircraft, aftermath, lost_property, boat
enum CargoWhere: warehouse, quay, person, aircraft, boat
enum CargoOrigin: opening, production, imported
enum CarriageChoice: automatic, sender, porter, player
enum CarriagePhase: fetch, carry, waiting, done, cancelled
enum DeliveryMode: aircraft, foot

struct CargoSource:
    id: int
    good: int
    issued: int
    born_tick: int
    sequence: int
    origin: CargoOrigin
    owner: int
    consumed = 0

struct CargoLot:
    id: int
    source: int
    good: int                    # -1: an existing sealed parcel, not a commodity
    quantity: int                # milli-packages; sealed parcels count as one item
    grams = 0                    # sealed parcel weight
    owner: int                   # beneficial owner, distinct from the custodian
    store: CargoStore
    holder: int                  # custody inventory ID
    where: CargoWhere
    place: int
    pos: vec3
    person = -1
    job = -1

struct CargoHarbor:
    warehouse: vec3
    quay: vec3[]
    homes: vec3[]
    boat: vec3
    loading: vec3[]
    island = -1
    boat_position: vec3 = vec3(0,0,0)

struct Carriage:
    id: int
    job: int
    cargo: int
    person: int
    unloading = false
    phase: CarriagePhase = .fetch
    route: vec3[]
    waypoint = 0
    target: vec3
    last_tick: int
    move_owner: MoveOwner = .abstract_world
    payer = -1
    escrow = -1
    fee = 0
    paid = false
    blocked = ""
    scene_path_phase: CarriagePhase = .waiting
    retry_tick = -1

struct Traits:
    honesty = 500
    boldness = 500
    greed = 500
    sociability = 500
    loyalty = 500

struct Pressures:
    money = 0
    duty = 0
    rest = 0
    company = 0
    revenge = 0

struct Pose:
    pos: vec3
    vel: vec3
    rot: vec4 = vec4(0, 0, 0, 1)
    throttle: int = 0

struct Reason:
    purpose: Purpose
    actor: int = -1
    beneficiary: int = -1
    counterparty: int = -1        # victim/trading partner, distinct from beneficiary
    origin: int = -1
    destination: int = -1
    good: int = -1
    quantity: int = 0
    due_minute: int = -1
    obligation: int = -1
    job: int = -1
    source_event: int = -1
    amount_cents: int = 0
    outside_credit: bool = false

struct Action:
    activity: Activity = .wait
    purpose: Purpose
    reason: Reason
    target_person: int = -1
    target_place: int = -1
    target_anchor: int = -1
    end_minute: int = 0
    retry_minute: int = 0
    progress_minutes: int = 0
    failure_code: str = ""

struct PriceBelief:
    place: int
    good: int
    cents: int
    observed_minute: int
    learned_minute: int
    source_person: int = -1
    stock_milli = -1
    target_milli = -1
    confidence = 1000

struct Person:
    id: int
    name: str
    age: int
    home: int
    occupation: Occupation
    appearance_seed: int
    faction: int = -1
    account: int = -1             # money is here, never duplicated as Person.money
    craft: int = -1               # preferred/owned aircraft; actual owner is on aircraft
    place: int = -1               # -1 while traveling
    local_anchor: int = -1
    pose: Pose                    # saved foot pose; aboard uses aircraft pose
    move_owner: MoveOwner = .abstract_world
    state: PersonState = .idle
    traits: Traits
    pressures: Pressures
    vice: Vice = .none
    vice_active: bool = false
    vice_until: int = 0
    fatigue = 200
    fatigue_remainder = 0
    alone_minutes = 0
    injured_until = 0
    last_raid_minute = -100000
    last_gamble_day = -1
    tobacco_bought = 0
    tobacco_day = -1
    local_work_escrow = -1
    last_local_work_day = -1
    service_blocked_since = -1
    last_care_grant_day = -100
    last_recovery_work_day = -100
    last_recovery_action_minute = -100000
    return_passage_needed = false
    last_visit_day = -1
    last_choice_minute = -1
    free_choice_minutes = 0
    vice_recovery_minutes = 0
    vice_recovered_until = 0
    living_day = -1
    labor_remainder = 0
    wage_remainder = 0
    routine_day = -1
    routine_minutes: int[4]       # completed minutes in today's named routine blocks
    next_decision_minute = 0
    last_command_tick = -1
    last_command_sequence = -1
    trip: int = -1
    carriage = -1
    carrying = -1
    porter = false               # registered secondary dock work; normal trade is retained
    action: Action
    pocket: Inventory             # personal goods, not goods already in a craft
    obligations: int[]
    relationship_ids: int[]
    news: NewsItem[]              # <= 12
    prices: PriceBelief[]         # <= 6 * GOOD_COUNT

struct Market:
    account: int
    inventory: Inventory
    target: int[GOOD_COUNT]
    demand_per_day: int[GOOD_COUNT]
    demand_remainder: int[GOOD_COUNT]
    price_cents: int[GOOD_COUNT]
    price_remainder: int[GOOD_COUNT]
    unmet_demand_milli: int[GOOD_COUNT]
    shortage_hours: int[GOOD_COUNT]
    next_import_minute: int

struct SettlementRecord:
    id: int                      # existing SETTLEMENTS index
    key: str                     # stable save key, not displayed name
    population: int
    market_owner: int
    faction: int
    has_market: bool = true
    has_fuel: bool = true
    has_workshop: bool = false
    market: Market
    residents: int[]
    news: NewsItem[]              # <= 12
    yesterday: Reason[]          # <= 3, rendered as sentences
    harbor_closed: bool = false
    reopen_minutes = 0
    storm_minutes = 0
    banquet_day = -1
    banquet_obligation = -1
    banquet_planned = false
    last_bark_minute = -1000
    import_cancel_streak = 0
    last_advance_day = -1
    spoil_remainder: int[GOOD_COUNT]

struct AircraftRecord:
    id: int
    kind: Airframe
    model_index = -1
    livery_index = -1
    owner: int                   # Person ID, including pirate captain
    operator: int = -1
    fuel_ml: int
    burn_remainder: int = 0
    hull = 1000
    engine = 1000
    cargo: Inventory
    job_manifests: int[]          # commodity earmarks, sealed mail and passenger Jobs
    passengers: int[]            # actual Person IDs, <= type's seats
    place: int = -1
    dock: int = -1
    state: CraftState = .moored
    move_owner: MoveOwner = .abstract_world
    pose: Pose
    previous_pos: vec3
    trip: int = -1
    repair_obligation: int = -1
    held_by_faction: int = -1
    last_scene_tick = -1
    revision = 0                 # scene transaction stale-write protection
    scene_extension = ""         # adapter-owned integrator/controller snapshot at save boundary
    scene_extension_tick = -1

struct Trip:
    id: int
    actor: int
    craft: int = -1
    mode: TripMode
    state: TripState = .preparing
    origin: int
    destination: int
    reason: Reason
    route: vec3[]                # stable semantic route, not renderer tessellation
    segment_ticks: int[]
    segment_elapsed_ticks = 0
    traveled_mm = 0
    terminal_minute = -1
    segment = 0
    segment_mm = 0               # distance progressed on current segment
    cruise_mm_per_sec: int
    departed_tick: int
    last_tick: int
    eta_tick: int
    incident_at_mm: int = -1
    bad_weather_minutes = 0
    incident_resolved: bool = false
    encounter: int = -1
    diversion_count = 0
    hold_until_minute = 0
    progress_remainder = 0
    origin_dock = -1
    searched: bool = false
    claimed_dock: int = -1
    departure_taxi = true        # false after folding an already airborne remainder

struct Obligation:
    id: int
    kind: ObligationKind
    state: ObligationState = .open
    debtor: int                  # responsible Person
    creditor: int                # Person, or -1 for an organization account
    creditor_account: int
    place: int
    due_minute: int
    deadline_minute: int          # grace/cancellation date, >= due
    amount_cents: int = 0
    original_cents: int = 0
    principal_cents: int = 0       # debt only; unpaid principal
    interest_enabled: bool = true
    interest_cents: int = 0        # debt only; accrued unpaid interest
    interest_accrued_total: int = 0
    interest_remainder: int = 0
    paid_cents: int = 0
    good: int = -1
    quantity: int = 0
    job: int = -1
    craft: int = -1
    mechanic: int = -1
    reason: Reason
    late_event: int = -1
    next_retry_minute = 0
    reserved_until_minute = 0
    blocked_code: str = ""
    default_event = -1
    last_interest_day = 0
    work_minutes = 0
    work_day = -1
    repair_hull = false
    reserved_parts = 0
    labor_escrow = -1
    repair_started_minute = -1

struct Job:
    id: int
    poster: int
    origin: int
    destination: int
    purpose: Purpose
    cargo_mode: CargoMode = .none
    good: int = -1
    quantity: int = 0
    passenger: int = -1
    created_minute: int
    npc_claim_after: int
    due_minute: int
    expire_minute: int
    reward_cents: int
    reward_funder = -1
    wet_charter = false
    charter_payer = -1
    charter_reserved_milli = 0
    prepaid_fuel_ml = 0
    prepaid_fuel_cents = 0
    escrow_account: int
    state: JobState = .open
    carrier: int = -1
    obligation: int = -1
    source_inventory_kind: int    # 0 market, 1 person, 2 craft
    source_inventory_id: int
    late_event = -1
    status_minute = 0
    load_until_minute = -1
    loaded: bool = false
    loaded_quantity: int = 0
    returned_quantity: int = 0
    delivered_quantity: int = 0
    lost_quantity: int = 0
    paid_cents: int = 0
    sealed_grams: int = 0
    cause: Reason
    context = ""                    # factual sender wording, never a substitute for transaction fields
    delivery_mode: DeliveryMode = .aircraft
    loader: CarriageChoice = .automatic
    collector: CarriageChoice = .automatic
    cargo_ids: int[]
    source_quantities: {int: int}
    cargo_sequence = -1
    pickup: vec3
    dropoff: vec3
    collected = false
    drop_store: CargoStore = .market
    drop_holder = -1
    handling_bonus = 0
    return_place = -1

struct Event:
    id: int
    kind: EventKind
    minute: int
    place: int
    pos: vec3
    actor: int = -1
    target: int = -1
    actor_faction: int = -1       # membership at act time
    witnesses: int[]             # <= 8 direct witnesses
    severity: int                # 0..1000
    harm_cents: int = 0
    reason: Reason
    private_fact: bool = false

struct NewsItem:
    event: int
    kind: EventKind
    occurred_minute: int
    learned_minute: int
    origin: int
    source_person: int
    actor_faction: int = -1
    private_fact: bool = false
    hops: int = 0
    confidence = 1000
    severity: int
    reason: Reason               # printable even after full event expires

struct RelationshipKey:
    observer: int
    other: int

struct Memory:
    event: int
    kind: EventKind
    minute: int
    severity: int
    reason: Reason

struct Relationship:
    id: int
    observer: int
    other: int
    affinity = 0
    trust = 500
    memories: Memory[]           # <= 4, salience-ranked
    grievance = 0
    last_contact_minute: int
    last_social_event_day = -1

struct ReputationKey:
    place: int
    subject_kind: SubjectKind
    subject: int

struct NewsReceiptKey:
    receiver_kind: int           # 0 settlement, 1 faction HQ
    receiver: int
    event: int

struct NewsReceipt:
    occurred_minute: int
    applied_delta: int

struct Faction:
    id: int
    key: str
    account: int
    home: int
    leader: int
    members: int[]
    player_regard = 0
    bounty_cents = 0
    bounty_escrow: int = -1
    bounty_event: int = -1
    bounty_target: int = -1
    bounty_claimed: bool = false
    next_patrol_minute = 0
    raid_cooldown_until = 0
    raid_plan_minute = -1
    raid_plan: Reason
    raid_trip = -1
    last_raid_day = -1
    last_credit_day = -100
    last_salvage_day = -1
    salvage_person = -1
    salvage_until = -1
    last_patrol_day = -1
    patrol_until = -1
    patrol_pos: vec3
    supply_obligations: int[]

struct Weather:
    id: int
    kind: WeatherKind
    center: vec2
    velocity_milli_m_per_minute: vec2
    radius_m: int
    severity: int
    wind_milli_m_per_sec: vec2
    born_minute: int
    expires_minute: int

struct Aftermath:
    id: int
    kind: AftermathKind
    event: int
    owner: int
    craft: int = -1
    place: int
    pos: vec3
    inventory: Inventory
    reason: Reason
    created_minute: int
    expires_minute: int           # -1 while unresolved ownership/repair persists

struct Account:
    id: int
    key: str
    cents: int                   # nonnegative, no implicit overdraft

struct MoneyEntry:
    id: int
    tick: int
    debit: int                   # payer account, -1 = outside simulation
    credit: int                  # recipient account, -1 = outside simulation
    cents: int
    kind: MoneyKind
    cause_id: int

struct Ledger:
    opening_cents: int
    external_in_cents = 0
    external_out_cents = 0
    sequence = 0
    recent: MoneyEntry[]         # <= 2048; cumulative counters never trimmed
    day_in: int[24]              # by MoneyKind numeric value (<= 24 kinds)
    day_out: int[24]

struct Encounter:
    id: int
    raider_trip: int
    victim_trip: int
    started_tick: int
    deadline_tick: int
    resolved: bool = false
    outcome_event: int = -1
    last_burn_tick = -1           # exact mixed-owner interval; repeated drains are harmless

struct BarkKey:
    speaker: int
    event: int

struct PresentationState:
    bark_day: {BarkKey: int}
    hailed_jobs: {int: bool}
    last_hail_tick: int = -1

