struct AirframeSpec:
    cruise_mps: int
    cargo_grams: int
    seats: int
    tank_ml: int
    burn_ml_sec: int
    price_cents: int = 1200000
    role: str = "utility"

# Dispatch cruise is the service speed, below each airframe's full flight envelope.
# Opening mail/freight/patrol/racing lanes retain their existing 60/55/65/70 m/s budgets.
# The big boats use the freight service's 90 ml/s dispatch allowance; more capacity and range
# do not price the opening medicine contract out of its courier's choices.
AIRFRAMES: AirframeSpec[] = [
    AirframeSpec(60,180000,1,80000,60,1200000,"utility / mail"),
    AirframeSpec(55,550000,3,160000,90,2600000,"passengers / cargo"),
    AirframeSpec(65,120000,0,70000,80,1850000,"pirate / patrol"),
    AirframeSpec(70,90000,0,60000,70,3200000,"racer"),
    AirframeSpec(60,140000,1,75000,45,850000,"trainer / fishing spotter"),
    AirframeSpec(60,240000,1,110000,65,1550000,"mail boat / privateer"),
    AirframeSpec(65,180000,1,140000,80,2350000,"reconnaissance / police patrol"),
    AirframeSpec(70,80000,0,65000,72,3700000,"boat racer"),
    AirframeSpec(55,1100000,8,380000,90,8200000,"passenger / mail liner"),
    AirframeSpec(70,100000,0,85000,57,1700000,"experimental / amateur"),
    AirframeSpec(60,220000,1,100000,55,1450000,"island post / fishing spotter"),
    AirframeSpec(65,130000,0,90000,78,2100000,"privateer / escort"),
    AirframeSpec(70,60000,0,40000,30,750000,"sport / rich amateur"),
    AirframeSpec(55,1800000,4,460000,90,9400000,"cargo amphibian"),
    AirframeSpec(65,450000,2,240000,105,3800000,"long range police patrol"),
    AirframeSpec(60,200000,1,125000,68,2450000,"express mail")
]

# Alternatives for the eight existing owners: player, mail, freight/passengers, island post,
# patrol, private racing/amateur, pirate escort, pirate mail boat. No new people or accounts.
SEED_AIRFRAMES: Airframe[][] = [[.gull], [.kingfisher,.gull], [.heron,.pelican,.albatross],
    [.ibis,.tern,.petrel], [.osprey,.cormorant], [.swift,.minnow,.kite,.falco],
    [.kestrel,.corsair], [.petrel,.gull]]
AIRFRAME_LIVERIES = [0,5,3,1,0,5,4,1,2,5,0,3,1,5,4,2]

# (the speed scale: every airframe's cruise this many times its design, for trips and traffic)
_BASE_CRUISE: int[] = [loop a in AIRFRAMES: a.cruise_mps]
scale_airframes = (k: f64):
    global AIRFRAMES
    loop i in 0..AIRFRAMES.len(): AIRFRAMES[i].cruise_mps = int(round(f64(_BASE_CRUISE[i]) * k))

struct HarborGeometry:
    place: int
    center: vec3
    out: vec3
    docks: vec3[]
    buoy: vec3
    safe_water: vec3
    safe_beach: vec3

local_minute = (minute: int) -> int: ((minute + EPOCH_LOCAL_MINUTE) % 1440 + 1440) % 1440
day_index = (minute: int) -> int:
    n = minute+EPOCH_LOCAL_MINUTE
    if n >= 0: n/1440 else: -((-n+1439)/1440)
ticks_from_minutes = (minute: int) -> int: minute * TICKS_PER_MINUTE
physical_seconds = (ticks: int) -> f64: f64(ticks) / 60.0
route_minutes = (distance_m: f64, cruise_mps: int) -> int: int(ceil(distance_m / f64(cruise_mps) / 2.0))

mix64 = (x: u64) -> u64:
    let x = x
    x = (x xor (x >> 30)) * u64(0xbf58476d1ce4e5b9)
    x = (x xor (x >> 27)) * u64(0x94d049bb133111eb)
    x xor (x >> 31)

draw1000000 = (seed: u64, tag: int, id: int, minute: int, candidate: int = 0) -> int:
    x = mix64(seed xor u64(tag))
    x = mix64(x xor u64(id))
    x = mix64(x xor u64(minute))
    int(mix64(x xor u64(candidate)) % u64(1000000))

# Goods ledger uses 1/10000 package units, so tank millilitres are exact.
struct GoodsLedger:
    opening: int[GOOD_COUNT]
    created: int[GOOD_COUNT]
    consumed: int[GOOD_COUNT]

struct OutsideShipment:
    id: int
    place: int
    day: int
    manifest: int[GOOD_COUNT]
    arrival_minute: int
    original_arrival_minute: int
    state = 0                 # 0 en route, 1 delivered, 2 cancelled/returned
    paperwork_job = -1
    paperwork_cargo = -1
    cancelled: bool = false
    night: bool = false

struct RescueTask:
    person: int
    craft: int
    aftermath: int
    place: int
    dispatch_minute: int
    trip: int = -1
    state = 0
    billed: bool = false

struct PublicBoatTask:
    trip: int
    person: int
    craft = -1
    aftermath = -1
    origin: int
    destination: int
    dispatch_minute: int
    return_minute = -1
    delivery_segment: int
    delivered = false
    state = 0                     # 0 awaiting boat, 1 underway, 2 returned, 3 cancelled
    account: int
    fare: int
    pose: Pose

# Common aircraft convention matches the flight core: local -Z is the nose, +Y is up.
facing = (direction: vec3) -> vec4:
    if length(direction) < 0.00001: return vec4(0,0,0,1)
    unit = normalize(direction)
    quat_euler(asin(clamp(f64(unit.y),-1.0,1.0)),-atan2(f64(unit.x),-f64(unit.z)),0)

# Ordered 31-bit stable settlement IDs, independent of how many detailed places are resident.
route_pair = (origin: int, destination: int) -> int:
    if origin < 0 or destination < 0 or origin > 0x7fffffff or destination > 0x7fffffff: return -1
    (origin << 32) | destination

route_address = (w: World, origin: int, destination: int) -> int:
    if w.route_key_version == 0: origin*w.harbors.len()+destination else: route_pair(origin,destination)
