# The terrain shader's reading of a town's worn ground (the field is made by src/town_ground.jo).
const TOWN_GROUND_NEAR = 4.0        # the stored distance: from this far inside a lane's edge
const TOWN_GROUND_FAR = 12.0        # to this far outside it

town_ground_field: Texture
town_ground_rect = vec4(0, 0, 0, 0) # origin x, z; the field's span (m); 0 while there is none

# Shader-only: at a point of the ground (in the field's own frame, rect.xy its origin), how far
# inside a lane it is (x: 0 off it .. 1 on it), how worn the ground is (y), whether the lane is
# stone (z). `footprint` is a pixel's width on the ground, for a soft edge at any range.
town_ground_cover = (field: Texture, rect: vec4, p: vec2, footprint: f32) -> vec3:
    if rect.z <= 0.0: return vec3(0, 0, 0)
    q = (p - rect.xy) / rect.z
    if min(q.x, q.y) <= 0.0 or max(q.x, q.y) >= 1.0: return vec3(0, 0, 0)
    d = sample(field, q)
    edge = d.x * f32(TOWN_GROUND_NEAR + TOWN_GROUND_FAR) - f32(TOWN_GROUND_NEAR)
    aa = max(footprint * 0.7, 0.3)
    lane = 1.0 - smoothstep(-aa, aa, edge)
    # (fading out over the field's last 80 m, so its edge never shows)
    rim = min(min(q.x, q.y), min(1.0 - q.x, 1.0 - q.y)) * rect.z
    vec3(lane, d.y, d.z) * smoothstep(0.0, 80.0, rim)

