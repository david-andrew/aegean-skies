# Scene/living adapter for the new ports. No extra market, person, cargo, or legacy Town.
use 'settlement_ports.jo'
use 'settlements.jo'
use 'objects.jo'
use 'living_types.jo'
use 'life_types.jo'
use 'living_ports.jo'

port_harbor_geometry = (p: SettlementPort) -> HarborGeometry:
    out=vec3(p.out.x,0,p.out.y)
    HarborGeometry(p.id,p.center,out,p.docks,p.anchorage,p.anchorage,if p.quays.len()>0: p.quays[0].a else: p.center)

port_cargo_geometry = (p: SettlementPort) -> CargoHarbor:
    warehouse=p.board
    loop b in p.buildings:
        if b.kind=="warehouse": warehouse=b.door; break
    CargoHarbor(warehouse,[loop q in p.quays: q.a],[loop b in p.buildings: b.door],p.anchorage,p.loading,island= -(p.region+1),boat_position=p.anchorage)

# Publish just the nearby port's detailed venues, before residents choose local routines.
# The initial world catalog stays compact; catalogue IDs/route fingerprints do not change.
prepare_port_venues = (w: mut World,observer: vec3):
    loop index in nearby_ports(observer.xz):
        s=world_settlements[index]
        if not (s.id in w.place_contexts): continue
        present=false
        loop v in w.place_contexts[s.id].venues:
            if v.key=="port:{s.id}:board": present=true; break
        if present: continue
        p=settlement_port(s); out=vec3(p.out.x,0,p.out.y)
        venues=w.place_contexts[s.id].venues
        # Old capital warehouse placeholders were building centres, not accessible doors.
        if not s.remote_harbor:venues=[loop v in venues: if v.kind!=.market: v]
        venues.push(LifeVenue(s.id,"port:{s.id}:board",.square,p.board,facing=out,capacity=4))
        loop k in 0..p.loading.len(): venues.push(LifeVenue(s.id,"port:{s.id}:quay:{k}",.quay,p.loading[k],facing=out,capacity=4))
        market=false
        loop k in 0..p.buildings.len():
            b=p.buildings[k]
            kind=if b.kind=="warehouse" and not market: VenueKind.market else: VenueKind.workshop
            key=if b.kind=="warehouse" and not market: "port:{s.id}:warehouse" else: "port:{s.id}:building:{k}"
            if b.kind=="warehouse": market=true
            venues.push(LifeVenue(s.id,key,kind,b.door,facing=out,capacity=6,covered=true))
        w.place_contexts[s.id].venues=venues

near_port_board = (pos: vec3) -> int:
    loop index in nearby_ports(pos.xz):
        p=settlement_port(world_settlements[index])
        if length(pos-p.board)<3.2: return p.id
    -1

# The core trip is the pilot's declared journey, and stays open during an intermediate
# port call. No legacy delivery/arrival is falsely paid at a new settlement.
# Player walking releases their trip location; the aircraft retains the pending journey.
arrive_registry_port = (w: mut World,position: vec3) -> bool:
    craft=w.people[w.player].craft
    if craft<0: return false
    loop index in nearby_ports(position.xz):
        s=world_settlements[index]
        loop k in 0..s.harbor.len():
            if length(position.xz-s.harbor[k].at.xz)>22.0: continue
            if w.aircraft[craft].port_place==s.id and w.people[w.player].far_place==s.id: return true
            if length(w.aircraft[craft].pose.vel)>3.0: return false
            prepare_port_venues(w,position)
            p=settlement_port(s)
            old=w.people[w.player].place
            if old>=0: w.places[old].residents.remove(w.player)
            w.people[w.player].place=-1; w.people[w.player].far_place=s.id
            w.people[w.player].trip=-1; w.people[w.player].state=.idle
            w.aircraft[craft].port_place=s.id
            w.aircraft[craft].port_at=s.harbor[k].at
            w.aircraft[craft].port_loading=p.loading[k]
            w.aircraft[craft].place=-1; w.aircraft[craft].dock=-1; w.aircraft[craft].state=.moored
            return true
    false

leave_registry_port = (w: mut World):
    craft=w.people[w.player].craft
    if craft<0 or w.aircraft[craft].port_place<0: return
    w.aircraft[craft].port_place=-1
    w.people[w.player].far_place=-1
    w.people[w.player].trip=w.aircraft[craft].trip
    w.people[w.player].state=.traveling
