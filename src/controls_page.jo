# The pause menu's Controls page: gamepads and flight sticks (src/controller.jo). Which profile is
# being set (the gamepad's or the flight stick's), how devices are told apart, the response curve
# and an inverted Y; then each axis (choose it and move the control you want, its inversion, its
# dead zone and sensitivity, and a bar showing it live) and each button (choose it and press the
# one you want). Kept with the options.
use 'phoenix.jo'
use 'controller.jo'

const CROW = 30.0
const CGAP = 6.0

KIND_LABELS = ["Automatic", "Always a gamepad", "Always a flight stick"]

struct ControlsPage:
    tab = -1                        # the profile shown: 0 gamepad, 1 flight stick, -1 the one in use
    advanced = false                # (the Advanced row open: how a controller is told to be one or the other)

_ink = () -> vec4: rgba(1, 0.97, 0.9, 0.9)
_soft = () -> vec4: rgba(0.82, 0.85, 0.9, 0.85)
_gold = () -> vec4: rgba(0.85, 0.78, 0.55, 1)

_head = (label: str, x: f64, y: f64, w: f64):
    ptext(label, vec2(f32(x), f32(y + 8)), 13, _gold())
    lw = ptext_width(label, 13)
    rect(x + lw + 10.0, y + 15.0, w - lw - 10.0, 1.0, rgba(0.85, 0.78, 0.55, 0.35))

# (a small bar, -1..1 about its middle (or 0..1 from its left), showing what the axis gives now)
_live = (x: f64, y: f64, w: f64, v: f64, half: bool):
    rect(x, y, w, 4.0, rgba(1, 1, 1, 0.12))
    if half:
        rect(x, y, w * clamp(v, 0.0, 1.0), 4.0, rgba(1, 0.82, 0.4, 0.9))
    else:
        mid = x + w * 0.5
        span = w * 0.5 * clamp(v, -1.0, 1.0)
        rect(min(mid, mid + span), y, abs(span), 4.0, rgba(1, 0.82, 0.4, 0.9))
        rect(mid - 0.5, y - 1.0, 1.0, 6.0, rgba(1, 1, 1, 0.4))

# The page, from y down; where it ends
controls_page = (c: mut ControlsConfig, pg: mut ControlsPage, x: f64, y0: f64, w: f64) -> f64:
    y = y0
    # (what is plugged in, and which it counts as)
    stick = if pg.tab < 0: ctl.stick else: pg.tab == 1
    # (what is plugged in, by the name it gives, the one in use first)
    names: str[]
    loop d in devices():
        n = device_label(device_name(d))
        if n == "" or n == "SLOPPY_INPUT": n = if is_stick(d, c.kind): "Flight stick" else: "Gamepad"
        if d == ctl.active: names.insert(0, n) else: names.push(n)
    line = if names.len() == 0: "No controller connected: plug one in and press any button" else: "Connected: " + join(names, ", ")
    ptext(fit_text(line, w, 14), vec2(f32(x), f32(y + 2.0)), 14, if names.len() == 0: _soft() else: _ink())
    y += 22.0
    # (the bindings taken by moving a control, into the profile shown)
    into_stick = capture.stick
    if let got = capture_take():
        p = if into_stick: c.stick else: c.pad
        if capture_axis_for >= 0 and capture_axis_for < p.axes.len():
            p.axes[capture_axis_for].bind = got.0
            p.axes[capture_axis_for].neg = got.1
        else if capture_action_for >= 0 and capture_action_for < p.buttons.len():
            p.buttons[capture_action_for] = got.0
        if into_stick: c.stick = p else: c.pad = p
    hw = (w - CGAP) * 0.5
    if hud_button(Rect(x, y, hw, CROW), "Gamepad", selected = not stick): pg.tab = 0
    if hud_button(Rect(x + hw + CGAP, y, hw, CROW), "Flight stick", selected = stick): pg.tab = 1
    y += CROW + CGAP
    p = profile_of(c, stick)
    inv = hud_checkbox(Rect(x, y + 6, w, CROW - 12), "Invert Y: push forward to climb", p.axes[AX_PITCH].invert)
    p.axes[AX_PITCH].invert = inv
    y += CROW + CGAP
    p.curve = hud_slider(Rect(x, y, w, CROW), p.curve, 1.0, 3.0, 0.1, "Curve {p.curve:.1}  (1 straight)")
    y += CROW + CGAP
    # (rarely wanted: a controller the platform reports wrongly, told which it is)
    if hud_button(Rect(x, y, w, CROW), if pg.advanced: "Advanced  v" else: "Advanced  >", selected = pg.advanced): pg.advanced = not pg.advanced
    y += CROW + CGAP
    if pg.advanced:
        if hud_button(Rect(x, y, w, CROW), "Controller type: {KIND_LABELS[clamp(c.kind, 0, 2)]}  >"): c.kind = (c.kind + 1) % 3
        y += CROW + CGAP
    y += CGAP
    _head("Axes: choose one, then move the control", x, y, w)
    y += CROW * 0.8
    lw = w * 0.34
    bw = w * 0.42
    iw = w - lw - bw - CGAP * 2.0
    loop i in 0..AXES:
        if not stick and i == AX_LEVER: continue
        if stick and i == AX_THROTTLE: continue
        a = p.axes[i]
        ptext(fit_text(AXIS_NAMES[i], lw, 14), vec2(f32(x), f32(y + 5.0)), 14, _ink())
        v = if ctl.connected and ctl.stick == stick: axis_value(p, i, ctl.active) else: 0.0
        if i == AX_LEVER: v = if ctl.connected and ctl.stick == stick: ctl.lever else: 0.0
        _live(x, y + CROW - 6.0, lw - 8.0, v, i == AX_LEVER)
        waiting = capture.active and capture_axis_for == i and capture.stick == stick
        label = if waiting: (if capture.second: "Now the other way..." else: "Move it...") else: axis_set_name(a)
        if hud_button(Rect(x + lw, y, bw, CROW), label, selected = waiting):
            if waiting: capture_cancel()
            else: begin_binding(i, -1, stick)
        a.invert = hud_checkbox(Rect(x + lw + bw + CGAP * 2.0, y + 6, iw, CROW - 12), "Invert", a.invert)
        y += CROW + CGAP
        if i != AX_LEVER:
            a.deadzone = hud_slider(Rect(x, y, hw, CROW), a.deadzone, 0.0, 0.5, 0.01, "Dead {int(a.deadzone * 100.0 + 0.5)}%")
            a.gain = hud_slider(Rect(x + hw + CGAP, y, hw, CROW), a.gain, 0.3, 2.0, 0.05, "Sens. x{a.gain:.1}")
        else:
            a.deadzone = hud_slider(Rect(x, y, w, CROW), a.deadzone, 0.0, 0.2, 0.01, "Ends {int(a.deadzone * 100.0 + 0.5)}%")
        y += CROW + CGAP * 2.0
        p.axes[i] = a
    _head("Buttons: choose one, then press the button", x, y, w)
    y += CROW * 0.8
    cw = w - lw - bw - CGAP * 2.0
    loop k in 0..ACTIONS:
        ptext(fit_text(ACTION_NAMES[k], lw, 14), vec2(f32(x), f32(y + 7.0)), 14, _ink())
        waiting = capture.active and capture_action_for == k and capture.stick == stick
        label = if waiting: "Press it..." else: bind_name(p.buttons[k])
        if hud_button(Rect(x + lw, y, bw, CROW), label, selected = waiting):
            if waiting: capture_cancel()
            else: begin_binding(-1, k, stick)
        if hud_button(Rect(x + lw + bw + CGAP * 2.0, y, cw, CROW), "Clear"): p.buttons[k] = Bind()
        y += CROW + CGAP
    y += CGAP
    if hud_button(Rect(x, y, w, CROW), if stick: "Flight stick defaults" else: "Gamepad defaults"): p = if stick: stick_defaults() else: pad_defaults()
    y += CROW + CGAP
    ptext("In menus: the d-pad moves, A chooses, B goes back, LB and RB turn the pages.", vec2(f32(x), f32(y)), 13, _soft())
    y += 18.0
    if stick: c.stick = p else: c.pad = p
    y

# (which axis or button the control being moved will go to)
capture_axis_for = -1
capture_action_for = -1
begin_binding = (axis: int, action: int, stick: bool):
    global capture_axis_for, capture_action_for
    capture_axis_for = axis
    capture_action_for = action
    capture_begin(axis, action, stick)
