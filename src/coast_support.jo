# Active placed-prop roots. Spatial bins keep contact refinement local; callers
# provide their already bounded resident lists before selecting the terrain.
coast_support_roots: vec2[]
coast_support_bins: {vec2:vec2[]} = {}

set_coast_support = (roots: vec2[]):
    global coast_support_roots,coast_support_bins
    if roots == coast_support_roots: return
    coast_support_roots = roots
    coast_support_bins = {}
    loop p in roots:
        key = floor(p/32.0)
        if not (key in coast_support_bins): coast_support_bins[key] = []
        coast_support_bins[key].push(p)

coast_support_near = (x: f64,z: f64) -> vec2[]:
    result: vec2[]
    if coast_support_bins.len() == 0: return result
    lo = floor(vec2(f32(x-2.0),f32(z-2.0))/32.0)
    hi = floor(vec2(f32(x+16.0),f32(z+16.0))/32.0)
    loop j in int(lo.y)..int(hi.y)+1:
        loop i in int(lo.x)..int(hi.x)+1:
            key = vec2(f32(i),f32(j))
            if not (key in coast_support_bins): continue
            loop p in coast_support_bins[key]:
                d = max(max(vec2(f32(x),f32(z))-p,p-vec2(f32(x+14.0),f32(z+14.0))),vec2(0,0))
                if dot(d,d) < 4.0: result.push(p)
    result

coast_support_level = (roots: vec2[],a: vec2,b: vec2) -> f32:
    level: f32 = 0.0
    loop p in roots:
        d = max(max(a-p,p-b),vec2(0,0))
        # Exact physical triangles around the root; blend out over two metres.
        # The half-metre core is fixed in placement space, not view space.
        # This depends on placement, never on camera position.
        level = max(level,6.0*(1.0-smoothstep(0.5,2.0,length(d))))
    ceil(level*8.0)/8.0
