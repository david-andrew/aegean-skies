# One speed rule for all the historical types (a trial, Tweaks: "One speed rule for historical
# aircraft"): design top speed, true m/s = 80 x (real top km/h / 250)^0.76. It is the single curve
# closest to the values the three fleets were given by their own rules (the racers near their real
# speeds, the early boats by 85 x (km/h / 250)^0.6, the big boats by their own figures), so the order
# stays the real one and slow types sit a little faster than life, near the game's own designs. Each
# type's cruise moves with its top; its stall stays as designed (it is its wing loading's, and moving it
# shifts the take-off: the S.65 rotated early and scraped its floats); drag is divided by the factor's
# square so thrust over drag still makes the new top; thrust (the pull, so the acceleration) is kept.
# The game's own sixteen designs (real_top_kmh 0) are left as they are.
const SPEED_RULE_GAIN = 80.0
const SPEED_RULE_POWER = 0.76
speed_rule_top = (real_kmh: f64) -> f64: SPEED_RULE_GAIN * pow(max(real_kmh, 1.0) / 250.0, SPEED_RULE_POWER)
speed_rule = (p: AircraftProfile) -> AircraftProfile:
    if p.real_top_kmh <= 0.0: return p
    q = p
    k = speed_rule_top(p.real_top_kmh) / max(p.top, 1.0)
    q.top = p.top * k; q.cruise = p.cruise * k
    q.drag = p.drag / (k * k)
    q
AIRCRAFT_RULED: AircraftProfile[] = [loop p in AIRCRAFT: speed_rule(p)]
