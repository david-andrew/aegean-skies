# Append-only aircraft identities: the first four are also the original save-game IDs.
# Dimensions are metres in the same CG frame as planes.jo. No meshes or audio allocations here.
enum EngineVoice: rotary, inline, radial, twin

struct AircraftProfile:
    role: str
    boat = false
    span = 11.0
    length = 8.0
    width = 0.6
    wing_y = 1.6
    chord = 1.65
    decks = 2
    lower_span = 0.86
    taper = 0.72
    float_x = 1.55
    float_y = -2.05
    engine_y = 0.0
    engine_z = -3.8
    engine_x = 0.0             # >0: two engines, one each side
    pusher = false
    prop_radius = 1.25
    cockpit_z = 0.45
    cockpit_count = 1
    gunner = false
    amphibian = false
    voice: EngineVoice = .radial
    tone = 1.0
    mass = 1400.0
    area = 30.0
    stall = 28.0
    cruise = 66.0
    top = 85.0
    pitch = 1.5
    roll = 3.2
    yaw = 0.55
    response = 6.0
    thrust = 15.5
    drag = 0.00215
    grip = 2.9
    water_drag = 1.0
    tank = 180.0
    burn = 0.025

# Original aircraft profiles describe their sound and size; their existing geometry/flight
# calibration remains in planes.jo/flight.jo. New aircraft use this complete shared definition.
