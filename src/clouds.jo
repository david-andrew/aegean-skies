# Fair-weather cumulus: each cloud a heap of soft round puffs on a flat base, white where the sun
# is on them and blue-grey beneath, drifting with the wind. Drawn as instanced spheres with a
# painted light, faded into the sky's haze with distance.

use 'look.jo'

const CLOUD_FIELD = 34000.0         # they wrap around a square this wide, centered on the camera

struct Puff:
    pos: vec3                       # where in the field (wind moves the field)
    size: vec3                      # radii along x, y, z
    base: f32                       # the cloud's flat base, for darkening its underside
    tone: f32                       # a little variety in brightness

struct CloudParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    shade: vec3
    sky_top: vec3
    haze: vec3
    offset: vec2                    # the wind's drift so far
    fog: f32
    time: f32

struct CloudOut:
    pos: vec4
    world: vec3
    normal: vec3
    base: f32
    tone: f32

cloud_vs = (v: Vertex3D, inst: Puff, u: CloudParams) -> CloudOut:
    # wrap the field around the camera
    half = CLOUD_FIELD * 0.5
    rel = inst.pos.xz + u.offset - u.cam.xz + vec2(half, half)
    rel = rel - floor(rel / CLOUD_FIELD) * CLOUD_FIELD - vec2(half, half)
    c = vec3(u.cam.x + rel.x, inst.pos.y, u.cam.z + rel.y)
    # (near the edge of the field, where a cloud wraps round to the other side, it melts away)
    edge = 1.0 - smoothstep(half * 0.72, half * 0.97, max(abs(rel.x), abs(rel.y)))
    # a lumpy surface: bulges that move slowly (the cloud boils)
    wob = 1.0 + 0.07 * sin(v.pos.x * 5.0 + u.time * 0.15 + inst.tone * 9.0) * sin(v.pos.y * 4.0 + v.pos.z * 3.0)
    w = c + v.pos * inst.size * wob * edge
    n = normalize(v.normal / inst.size)
    CloudOut(u.view_proj * vec4(w, 1), w, n, inst.base, inst.tone)

cloud_fs = (i: CloudOut, u: CloudParams) -> vec4:
    n = normalize(i.normal)
    l = normalize(u.sun_dir)
    v = normalize(u.cam - i.world)
    ndl = dot(n, l)
    # a painted edge between the sunlit and the shaded side
    lit = smoothstep(-0.12, 0.22, ndl)
    # the underside darker: the flat base in its own shadow
    under = smoothstep(i.base - 20.0, i.base + 220.0, i.world.y)
    lit = lit * (0.25 + 0.75 * under)
    white = vec3(1.0, 0.98, 0.93) * u.sun * (0.94 + 0.06 * i.tone)
    grey = mix(u.shade * 1.25, u.sun * vec3(0.8, 0.84, 0.9), 0.42)
    grey = mix(grey * 0.82, grey, under)
    c = mix(grey, white, lit)
    # a bright rim where one looks toward the sun through its edge
    rim = pow(1.0 - max(dot(n, v), 0.0), 4.0)
    toward = clamp(dot(-v, l), 0.0, 1.0)
    c = c + u.sun * rim * (0.05 + 0.6 * toward * toward * toward)
    c = aerial(c, i.world, u.cam, u.haze, u.fog * 0.8)
    vec4(c, 1)

cloud_sh: Shader

build_puff_mesh = () -> Mesh:
    vs: Vertex3D[]
    add_sphere(vs, vec3(0, 0, 0), 1.0, vec4(1, 1, 1, 1), 12, 7)
    custom_mesh(vs)

# one cumulus: a dome of puffs over a flat base (width and height in meters)
_cumulus = (puffs: mut Puff[], cx: f64, cz: f64, base: f64, width: f64, tall: f64, tone: f32):
    n = 8 + int(width / 28.0)
    # the base: wide flat puffs
    nb = 2 + n / 5
    loop q in 0..nb:
        ang = random(0.0, TAU)
        rr = random() ^ 0.6 * width * 0.35
        r = width * random(0.18, 0.28)
        puffs.push(Puff(vec3(f32(cx + cos(ang) * rr), f32(base + r * 0.3), f32(cz + sin(ang) * rr * 0.8)), vec3(f32(r * 1.3), f32(r * 0.42), f32(r * 1.1)), f32(base), tone))
    # the heap: puffs over the surface of a dome, smaller toward the top
    loop q in 0..n:
        ang = random(0.0, TAU)
        th = acos(random(0.0, 1.0)) * 0.98
        R = width * 0.5
        r = width * random(0.09, 0.2) * (1.0 - 0.35 * cos(th))
        d = R - r * 0.55
        x = cx + cos(ang) * sin(th) * d
        z = cz + sin(ang) * sin(th) * d * 0.8
        y = base + R * 0.15 + cos(th) * d * tall
        puffs.push(Puff(vec3(f32(x), f32(y), f32(z)), vec3(f32(r), f32(r * 0.9), f32(r)), f32(base), tone))

# a field of clouds, made from a seed: formations, not loose ones. Fields of cumulus of many sizes
# heaped close together (their bases at one height), a few towering ones, flat sheets of
# stratocumulus, and some small fair-weather ones scattered between.
build_puffs = (seed: int, count: int) -> Puff[]:
    seed_random(seed)
    puffs: Puff[]
    loop f in 0..count:
        fx = random(-CLOUD_FIELD * 0.5, CLOUD_FIELD * 0.5)
        fz = random(-CLOUD_FIELD * 0.5, CLOUD_FIELD * 0.5)
        base = 640.0 + random(0.0, 220.0)
        kind = random()
        tone = f32(random())
        if kind < 0.45:
            # a field: a dozen or so cumulus in a band 2 to 5 km long
            len = random(2000.0, 5000.0)
            ang = random(0.0, TAU)
            m = 10 + random_int(0, 14)
            loop c in 0..m:
                along = random(-0.5, 0.5) * len
                across = random_normal() * len * 0.09
                big = random() ^ 1.8
                _cumulus(puffs, fx + cos(ang) * along - sin(ang) * across, fz + sin(ang) * along + cos(ang) * across, base + random(-15.0, 15.0), 260.0 + 900.0 * big, random(0.5, 0.9) * (0.6 + big * 0.6), tone)
        else if kind < 0.6:
            # a towering cumulus, with smaller ones round its foot
            _cumulus(puffs, fx, fz, base, random(1300.0, 2300.0), random(1.3, 1.8), tone)
            loop c in 0..random_int(2, 5):
                ang = random(0.0, TAU)
                _cumulus(puffs, fx + cos(ang) * random(900.0, 1500.0), fz + sin(ang) * random(900.0, 1500.0), base, random(250.0, 600.0), random(0.5, 0.8), tone)
        else if kind < 0.75:
            # a sheet of stratocumulus: wide flat puffs side by side, lumpy on top
            len = random(2500.0, 6000.0)
            wid = random(800.0, 2000.0)
            ang = random(0.0, TAU)
            loop c in 0..int(len * wid / 90000.0):
                along = random(-0.5, 0.5) * len
                across = random(-0.5, 0.5) * wid * (1.0 - abs(along / len))
                r = random(140.0, 320.0)
                x = fx + cos(ang) * along - sin(ang) * across
                z = fz + sin(ang) * along + cos(ang) * across
                lump = random() ^ 2.0
                puffs.push(Puff(vec3(f32(x), f32(base + 900.0 + r * (0.15 + 0.5 * lump)), f32(z)), vec3(f32(r * (1.3 + 0.4 * random())), f32(r * (0.35 + 0.45 * lump)), f32(r * (1.1 + 0.4 * random()))), f32(base + 860.0), tone))
        else:
            # small fair-weather cumulus, scattered
            loop c in 0..random_int(3, 8):
                _cumulus(puffs, fx + random(-1500.0, 1500.0), fz + random(-1500.0, 1500.0), base + random(-20.0, 40.0), random(150.0, 420.0), random(0.45, 0.8), tone)
    puffs

draw_clouds = (m: Mesh, puffs: InstanceBuffer[Puff], L: Light, offset: vec2, t: f64):
    p = CloudParams(scene_view_proj(), scene_camera(), L.sun_dir, L.sun, L.shade, L.sky_top, L.haze, offset, f32(L.fog_density), f32(t))
    draw_instanced(cloud_sh, m, puffs, p)

# (the GPU programs: made once the window is open)
init_clouds = ():
    global cloud_sh
    cloud_sh = make_shader(shader(cloud_vs, cloud_fs))
