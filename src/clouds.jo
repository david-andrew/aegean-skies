# Fair-weather cumulus: each cloud a heap of soft round puffs on a flat base, white where the sun
# is on them and blue-grey beneath, drifting with the wind. Drawn as instanced spheres with a
# painted light, faded into the sky's haze with distance.

use 'look.jo'

const CLOUD_FIELD = 26000.0         # they wrap around a square this wide, centered on the camera

struct Puff:
    pos: vec3                       # where in the field (wind moves the field)
    size: vec3                      # radii along x, y, z
    base: f32                       # the cloud's flat base, for darkening its underside
    tone: f32                       # a little variety in brightness

struct CloudParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun: vec3
    shade: vec3
    sky_top: vec3
    haze: vec3
    offset: vec2                    # the wind's drift so far
    fog: f32
    time: f32

struct CloudOut:
    pos: vec4
    world: vec3
    normal: vec3
    base: f32
    tone: f32

cloud_vs = (v: Vertex3D, inst: Puff, u: CloudParams) -> CloudOut:
    # wrap the field around the camera
    half = CLOUD_FIELD * 0.5
    rel = inst.pos.xz + u.offset - u.cam.xz + vec2(half, half)
    rel = rel - floor(rel / CLOUD_FIELD) * CLOUD_FIELD - vec2(half, half)
    c = vec3(u.cam.x + rel.x, inst.pos.y, u.cam.z + rel.y)
    # a lumpy surface: bulges that move slowly (the cloud boils)
    wob = 1.0 + 0.07 * sin(v.pos.x * 5.0 + u.time * 0.15 + inst.tone * 9.0) * sin(v.pos.y * 4.0 + v.pos.z * 3.0)
    w = c + v.pos * inst.size * wob
    n = normalize(v.normal / inst.size)
    CloudOut(u.view_proj * vec4(w, 1), w, n, inst.base, inst.tone)

cloud_fs = (i: CloudOut, u: CloudParams) -> vec4:
    n = normalize(i.normal)
    l = normalize(u.sun_dir)
    v = normalize(u.cam - i.world)
    ndl = dot(n, l)
    # a painted edge between the sunlit and the shaded side
    lit = smoothstep(-0.12, 0.22, ndl)
    # the underside darker: the flat base in its own shadow
    under = smoothstep(i.base - 20.0, i.base + 220.0, i.world.y)
    lit = lit * (0.25 + 0.75 * under)
    white = vec3(1.0, 0.98, 0.93) * u.sun * (0.94 + 0.06 * i.tone)
    grey = mix(u.shade * 1.25, u.sun * vec3(0.8, 0.84, 0.9), 0.42)
    grey = mix(grey * 0.82, grey, under)
    c = mix(grey, white, lit)
    # a bright rim where one looks toward the sun through its edge
    rim = pow(1.0 - max(dot(n, v), 0.0), 4.0)
    toward = clamp(dot(-v, l), 0.0, 1.0)
    c = c + u.sun * rim * (0.05 + 0.6 * toward * toward * toward)
    c = aerial(c, i.world, u.cam, u.haze, u.fog * 0.8)
    vec4(c, 1)

cloud_sh: Shader

build_puff_mesh = () -> Mesh:
    vs: Vertex3D[]
    add_sphere(vs, vec3(0, 0, 0), 1.0, vec4(1, 1, 1, 1), 14, 8)
    custom_mesh(vs)

# a field of cumulus, made from a seed: each a dome of puffs over a flat base
build_puffs = (seed: int, count: int) -> Puff[]:
    seed_random(seed)
    puffs: Puff[]
    loop k in 0..count:
        cx = random(-CLOUD_FIELD * 0.5, CLOUD_FIELD * 0.5)
        cz = random(-CLOUD_FIELD * 0.5, CLOUD_FIELD * 0.5)
        big = random() ^ 2.2
        width = 160.0 + 1300.0 * big
        base = 700.0 + random(0.0, 220.0)
        tall = random(0.5, 1.0) * (0.6 + big * 0.7)       # the big ones tower
        n = 8 + int(big * 46.0)
        tone = f32(random())
        # the base: wide flat puffs
        nb = 2 + n / 5
        loop q in 0..nb:
            ang = random(0.0, TAU)
            rr = random() ^ 0.6 * width * 0.35
            r = width * random(0.18, 0.28)
            puffs.push(Puff(vec3(f32(cx + cos(ang) * rr), f32(base + r * 0.3), f32(cz + sin(ang) * rr * 0.8)), vec3(f32(r * 1.3), f32(r * 0.42), f32(r * 1.1)), f32(base), tone))
        # the heap: puffs over the surface of a dome, smaller toward the top
        loop q in 0..n:
            ang = random(0.0, TAU)
            th = acos(random(0.0, 1.0)) * 0.98            # (more of them toward the sides)
            R = width * 0.5
            r = width * random(0.09, 0.2) * (1.0 - 0.35 * cos(th))
            d = R - r * 0.55
            x = cx + cos(ang) * sin(th) * d
            z = cz + sin(ang) * sin(th) * d * 0.8
            y = base + R * 0.15 + cos(th) * d * tall
            puffs.push(Puff(vec3(f32(x), f32(y), f32(z)), vec3(f32(r), f32(r * 0.9), f32(r)), f32(base), tone))
    puffs

draw_clouds = (m: Mesh, puffs: InstanceBuffer[Puff], L: Light, offset: vec2, t: f64):
    p = CloudParams(scene_view_proj(), scene_camera(), L.sun_dir, L.sun, L.shade, L.sky_top, L.haze, offset, f32(L.fog_density), f32(t))
    draw_instanced(cloud_sh, m, puffs, p)

# (the GPU programs: made once the window is open)
init_clouds = ():
    global cloud_sh
    cloud_sh = make_shader(shader(cloud_vs, cloud_fs))
