# Original environmental instruments. No sample assets, device access or global RNG.
use 'airsound.jo'

enum AmbienceKind: bell, murmur, hammer, rope, rigging, cafe, beach, cliff, trees, grass, cicada, cricket, owl, dog, goat, donkey, ship_engine, luff, whistle, rain_sea, rain_roof, thunder, gull, spring, songbird
const AMBIENCE_KINDS = 25
const AMBIENCE_CATEGORIES = 9
AMBIENCE_LABELS = ["Bells","Harbour","Cafes","Music","Shore","Nature","Animals","Ships","Weather"]
ambience_category = (kind: AmbienceKind) -> int:
    match kind:
        .bell: 0
        .murmur, .hammer, .rope, .rigging: 1
        .cafe: 2
        .beach, .cliff, .spring: 4
        .trees, .grass, .cicada, .cricket, .owl, .gull, .songbird: 5
        .dog, .goat, .donkey: 6
        .ship_engine, .luff, .whistle: 7
        _: 8
ambience_loop = (kind: AmbienceKind) -> bool:
    not (kind == .bell or kind == .hammer or kind == .owl or kind == .dog or kind == .goat or kind == .donkey or kind == .whistle or kind == .thunder or kind == .gull or kind == .songbird)
ambience_seconds = (kind: AmbienceKind) -> f64:
    match kind:
        .bell: 3.5
        .thunder: 4.5
        .beach, .cliff: 3.2
        .murmur, .cafe: 2.4
        .owl, .donkey, .whistle: 1.8
        .gull: 1.1
        .hammer, .goat, .dog: 0.75
        _: 1.6

ambience_noise = (state: mut u64) -> f64:
    state = (state*u64(1664525)+u64(1013904223)) & u64(0xffffffff)
    f64(state)/2147483648.0-1.0

make_ambience = (kind: AmbienceKind,seed: int = 1) -> Sound:
    seconds = ambience_seconds(kind)
    looped = ambience_loop(kind)
    fade = if looped: int(f64(MIX_RATE)*0.12) else: 0
    n = int(seconds*f64(MIX_RATE))+fade
    mono = fill(0.0,n)
    rng = u64(17+seed*1031+int(kind)*7919)
    low = 0.0; deep = 0.0; phase = 0.0
    band = Biquad(); bandpass(band,if kind == .cicada: 4200 else: if kind == .cricket: 3400 else: 1400,2.5)
    loop i in 0..n:
        t = f64(i)/f64(MIX_RATE)
        noise = ambience_noise(rng)
        low += (noise-low)*0.07
        deep += (low-deep)*0.025
        breath = filt(band,noise)
        v = 0.0
        match kind:
            .bell, .goat:
                hz = if kind == .bell: 330.0+f64(seed%3)*22.0 else: 1050.0
                decay = if kind == .bell: 1.2 else: 7.5
                loop k in 0.. and ratio in [0.5,1.0,1.19,1.51,2.0,2.76,3.08]:
                    v += sin(TAU*hz*ratio*t)*exp(-t*(decay+f64(k)*0.28))/(1.0+f64(k)*0.6)
                v *= min(1.0,t*500.0)
            .murmur, .cafe:
                # Indistinct, asynchronous vowel hums; no intelligible invented dialogue.
                loop k in 0..4:
                    f = 105.0+f64(k)*39.0
                    env = pow(max(0.0,sin(t*(4.1+f64(k)*0.51)+f64(k)*2.1)),2.0)
                    v += env*(sin(TAU*f*t)*0.05+sin(TAU*f*3.0*t)*0.035+breath*0.12)
                if kind == .cafe:
                    hit = t%0.71
                    v += (sin(TAU*2300*t)+sin(TAU*3710*t)*0.5)*exp(-hit*70.0)*0.15
            .hammer:
                v = (sin(TAU*180*t)*0.65+sin(TAU*413*t)*0.2+low*2.0)*exp(-t*19.0)*min(1.0,t*1500.0)
            .rope:
                phase += (180+55*sin(t*6.3))/f64(MIX_RATE)
                v = sin(TAU*phase)*pow(max(0.0,sin(t*4.0)),5.0)*0.2+low*0.05
            .rigging, .luff:
                rate = if kind == .luff: 7.0 else: 3.0
                v = (noise*0.3+low*2.0)*pow(max(0.0,sin(t*TAU*rate+sin(t*11))),12.0)+deep*0.5
            .beach, .cliff:
                swell = pow(0.5-0.5*cos(t*TAU/3.2),2.0)
                v = (low*2.0+noise*0.045)*swell
                if kind == .cliff: v += deep*6.0*pow(swell,3.0)+sin(TAU*48*t)*swell*0.08
            .trees, .grass:
                gust = 0.6+0.2*sin(t*2.7)+0.2*sin(t*7.2)
                v = (if kind == .trees: low*2.5+noise*0.07 else: breath*0.8+noise*0.06)*gust
            .cicada:
                v = breath*(0.4+0.6*pow(max(0.0,sin(TAU*73*t)),2.0))*(0.6+0.4*sin(t*3.2))
            .cricket:
                chirp = pow(max(0.0,sin(TAU*29*t)),8.0)
                group = pow(max(0.0,sin(TAU*2.5*t)),3.0)
                v = (sin(TAU*3400*t)*0.25+breath*0.3)*chirp*group
            .owl:
                u = t/1.8; pulse = max(0.0,sin(u*PI*3.0))
                phase += (420-100*u+18*sin(u*8))/f64(MIX_RATE)
                v = (sin(TAU*phase)+sin(TAU*phase*2)*0.12)*pulse*pulse*0.35
            .dog:
                phase += (190-90*min(t*3,1.0))/f64(MIX_RATE)
                env = exp(-(t%0.33)*18.0)*min(1.0,t*500)
                v = (sin(TAU*phase)+sin(TAU*phase*3)*0.6+breath*2)*env*0.3
            .donkey:
                u = t/1.8; env = pow(max(0.0,sin(PI*u*2)),0.5)
                phase += (150+180*max(0.0,sin(PI*u*2)))/f64(MIX_RATE)
                v = (sin(TAU*phase)+sin(TAU*phase*3)*0.5+sin(TAU*phase*5)*0.3+breath*0.4)*env*0.25
            .ship_engine:
                pulse = t%0.2
                v = (sin(TAU*52*t)*0.5+deep*4)*exp(-pulse*18)*min(1.0,pulse*1000)+sin(TAU*25*t)*0.18
            .whistle:
                env = min(1.0,t*7)*min(1.0,(seconds-t)*5)
                v = (sin(TAU*180*t)+sin(TAU*227*t)*0.65+sin(TAU*360*t)*0.22+breath*0.3)*env*0.3
            .rain_sea:
                v = noise*0.12+low*1.7
            .rain_roof:
                drip = if noise > 0.96: 1.0 else: 0.0
                v = low*0.7+noise*0.06+drip*sin(TAU*2100*t)*0.8
            .gull:
                u = (t%0.48)/0.48
                phase += (1700-600*u+40*sin(u*50))/f64(MIX_RATE)
                v = (sin(TAU*phase)*0.6+sin(TAU*phase*2)*0.2)*sin(PI*u)*pow(1-u,1.5)
            .spring:
                # A small running spout: soft turbulence and irregular bright
                # droplets, no surf-sized cyclic roar.
                drip=t%0.137
                v=low*1.3+noise*0.025+sin(TAU*(1700+300*sin(t*17))*drip)*exp(-drip*65)*0.055
            .songbird:
                syllable=t%0.31;gate=pow(max(0.0,sin(PI*syllable/0.18)),3.0)
                if syllable>0.18:gate=0
                phase+=(2400+800*sin(syllable*18)+300*sin(t*9))/f64(MIX_RATE)
                v=sin(TAU*phase)*gate*0.23*min(1.0,t*15)*max(0.0,1-t/seconds)
            .thunder:
                env = min(1.0,t*8)*pow(max(0.0,1-t/seconds),1.5)
                v = (deep*8+low*0.8*exp(-t*3))*(0.7+0.3*sin(t*11))*env
        if not looped: v *= min(1.0,max(0.0,seconds-t)*25.0)
        mono[i] = v
    if looped:
        s = seamless(mono,fade,0.11)
        # One common crest bound makes a strict combined mixer budget possible.
        loop i in 0..s.samples.len(): s.samples[i] = f32(clamp(f64(s.samples[i]),-0.45,0.45))
        return s
    one_shot(mono,0.45)

# Filtered copy crossfades with direct sound: no runtime DSP allocation/filters.
ambience_soften = (s: Sound) -> Sound:
    out = fill(f32(0),s.samples.len()); f = Biquad(); lowpass(f,850)
    # Warm the filter around a whole loop before storing, preventing a seam transient.
    loop i in 0..s.samples.len()/2: _ = filt(f,f64(s.samples[i*2]))
    loop i in 0..s.samples.len()/2:
        v = f32(filt(f,f64(s.samples[i*2])))
        out[i*2] = v; out[i*2+1] = v
    Sound(out)

# A few quiet early reflections, baked once per plucked note; no delay voices.
ambience_square_reverb = (s: Sound) -> Sound:
    out = fill(f32(0),s.samples.len()+int(f64(MIX_RATE)*0.16)*2)
    loop i in 0..s.samples.len(): out[i] = s.samples[i]
    loop tap in 0.. and delay in [0.037,0.071,0.113,0.149]:
        offset = int(delay*f64(MIX_RATE))*2
        gain = [0.14,0.10,0.065,0.04][tap]
        loop i in 0..s.samples.len(): out[i+offset] += f32(f64(s.samples[i])*gain)
    Sound(out)
