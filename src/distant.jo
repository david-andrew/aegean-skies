use 'world_point.jo'
use 'render_space.jo'
# Other aircraft heard: each engine nearby a looping voice, placed and pitched each frame as sound
# from it would really arrive.
#   - heard where it was, not where it is: sound takes about three seconds to come a kilometer,
#     so a plane passing at a distance is heard behind where it is seen (each aircraft's recent
#     path is kept, and the moment its sound left it is solved for)
#   - Doppler: higher as it comes, lower as it goes, by its speed toward the listener then, and
#     the listener's own (c / (c - v))
#   - and off the sea: a second, softer copy from its mirror image under the water, with its own
#     Doppler, so the two drift against each other and phase as it passes (the fly-by's whoosh)
#   - loud and carrying far, as engines do: falling off more gently than in a still room, and
#     duller far off: a bright copy of the engine close in crossfades into a muffled one as the
#     air takes its highs away
# Only the nearest few are given voices.
# The period engines trial (tweaks.period_engines): each aircraft heard with its own type's engine
# (src/engine_sound.jo make_outside: its propeller over its exhaust, at its own turning speed),
# made once a type, a type a frame as they come into hearing; and those beyond the nearest few
# folded into one distant bed, so a furball of sixteen costs no more than eight and a bed.

use 'sound.jo'
use 'airsound.jo'
use 'aircraft_catalog.jo'
use 'engine_sound.jo'
use 'tweaks.jo'
from 'planes.jo' import Craft, aircraft_profile

const SOUND_SPEED = 343.0
const HEARING = 6000.0              # meters: beyond this an engine is not heard
const VOICES = 8                    # at most this many other engines at once

struct SoundSample:
    point:WorldPoint
    time:f64

struct Heard:
    craft = -1
    voice: EngineVoice = .radial
    near_v = -1
    far_v = -1
    near_r = -1                     # (the copies off the sea)
    far_r = -1
    trail: SoundSample[]                   # where it was (x, y, z) and when (w, seconds of game time)
    using = -1                      # (its type's own sounds, an index in Hearing.kinds; -1 the shared loops)
    seen = 0.0                      # (the last time it was among the sources)

struct EngineSource:
    craft: int
    pos: vec3
    vel: vec3
    throttle: f64
    on: bool
    tone: f64                       # its engine's own pitch (bigger engines lower)
    true_speed: f64 = 0.0           # (its speed as designed, for its engine's note)
    voice: EngineVoice = .radial
    point:WorldPoint?=none
    gain = 1.0                      # (how loud against the rest: the title reel's racers sit under its music)
    kind = -1                       # (its type: a Craft, for its own engine; -1 by its voice only)

struct Hearing:
    near: Sound[]
    far: Sound[]
    heard: Heard[]
    ready = false
    kinds: int[]                    # (the types whose own engines are made, and their sounds)
    kind_near: Sound[]
    kind_far: Sound[]
    wanted: int[]                   # (types heard but not yet made: one at a time, a piece a frame)
    kind_spec: EngineSpec[]         # (each made type's engine and cruise speed, for its turning speed)
    kind_cruise: f64[]
    making = -1
    making_stage = 0
    making_parts: Sound[]
    making_muffle: Muffle = Muffle()
    bed = -1                        # (the distant bed: those beyond the nearest few)
    bed_kind = -2

# The same filtering is applied to each family: distance never changes engine identity.
muffle_engine = (sound: Sound, rounds: int = 3) -> Sound:
    src = sound.samples
    n = src.len() / 2
    lp = Biquad(); lp2 = Biquad()
    lowpass(lp, 700.0)
    lowpass(lp2, 900.0)
    delays = [loop d in [0.0297, 0.0371, 0.0411, 0.0437, 0.0533]: int(d * f64(MIX_RATE))]
    lines: f64[][] = [loop d in delays: fill(0.0, d)]
    at = fill(0, delays.len())
    out = fill(f32(0), n * 2)
    loop round in 0..rounds:
        loop i in 0..n:
            x = filt(lp2, filt(lp, f64(src[i * 2])))
            wet = 0.0
            loop k in 0..delays.len():
                y = lines[k][at[k]]
                lines[k][at[k]] = x + y * 0.72
                at[k] = (at[k] + 1) % delays[k]
                wet += y
            v = x * 0.45 + wet * 0.22
            if round == rounds - 1:
                out[i * 2] = f32(v * 1.5)
                out[i * 2 + 1] = f32(v * 1.5)
    Sound(out)

# The same muffling made in two pieces (a type's own engine, a frame each): warmed on the loop's
# last half second, so its start follows on from its end, then written.
struct Muffle:
    lp: Biquad = Biquad()
    lp2: Biquad = Biquad()
    delays: int[]
    lines: f64[][]
    at: int[]
    out: f32[]
muffle_begin = (n: int) -> Muffle:
    m = Muffle()
    lowpass(m.lp, 700.0); lowpass(m.lp2, 900.0)
    m.delays = [loop d in [0.0297, 0.0371, 0.0411, 0.0437, 0.0533]: int(d * f64(MIX_RATE))]
    m.lines = [loop d in m.delays: fill(0.0, d)]
    m.at = fill(0, m.delays.len())
    m.out = fill(f32(0), n * 2)
    m
muffle_run = (m: mut Muffle, src: f32[], from: int, to: int, write: bool):
    loop i in from..to:
        x = filt(m.lp2, filt(m.lp, f64(src[i * 2])))
        wet = 0.0
        loop k in 0..m.delays.len():
            y = m.lines[k][m.at[k]]
            m.lines[k][m.at[k]] = x + y * 0.72
            m.at[k] = (m.at[k] + 1) % m.delays[k]
            wet += y
        if write:
            v = f32((x * 0.45 + wet * 0.22) * 1.5)
            m.out[i * 2] = v; m.out[i * 2 + 1] = v

make_hearing = () -> Hearing:
    h = Hearing()
    loop i in 0..4:
        near = engine_outside_loop(EngineVoice(i))
        h.near.push(near); h.far.push(muffle_engine(near))
    h.ready = true
    h

# (where an aircraft was at time `at`, from its trail; and how fast it was going then)
_was = (trail: vec4[], at: f64) -> (vec3, vec3):
    n = trail.len()
    if n == 0: return (vec3(0, 0, 0), vec3(0, 0, 0))
    if n == 1 or at >= f64(trail[n - 1].w):
        last = trail[n - 1]
        v = if n >= 2: (last.xyz - trail[n - 2].xyz) / max(last.w - trail[n - 2].w, 0.001) else: vec3(0, 0, 0)
        return (last.xyz, v)
    k = n - 1
    loop k > 0 and f64(trail[k - 1].w) > at: k -= 1
    if k == 0: return (trail[0].xyz, (trail[1].xyz - trail[0].xyz) / max(trail[1].w - trail[0].w, 0.001))
    a = trail[k - 1]
    b = trail[k]
    u = clamp((at - f64(a.w)) / max(f64(b.w - a.w), 0.0001), 0.0, 1.0)
    (a.xyz + (b.xyz - a.xyz) * f32(u), (b.xyz - a.xyz) / max(b.w - a.w, 0.001))

# the sound of an aircraft arriving now at `ear`: where it was when that sound left it, how fast
# it was going then, how far that is, and the Doppler factor for it and the listener's motion
heard_from = (trail: vec4[], ear: vec3, ear_vel: vec3, t: f64) -> (vec3, vec3, f64, f64):
    at = t
    p, v = _was(trail, at)
    loop n in 0..4:
        at = t - f64(length(p - ear)) / SOUND_SPEED
        p, v = _was(trail, at)
    d = max(f64(length(p - ear)), 1.0)
    u = (ear - p) / f32(d)
    doppler = clamp((SOUND_SPEED - f64(dot(ear_vel, u))) / max(SOUND_SPEED - f64(dot(v, u)), 30.0), 0.5, 2.2)
    (p, v, d, doppler)

_was = (trail: SoundSample[], at: f64) -> (WorldPoint, vec3):
    n = trail.len()
    if n == 0: return (WorldPoint(), vec3(0, 0, 0))
    if n == 1 or at >= f64(trail[n - 1].time):
        last = trail[n - 1]
        v = if n >= 2: world_delta(last.point,trail[n - 2].point) / f32(max(last.time - trail[n - 2].time, 0.001)) else: vec3(0, 0, 0)
        return (last.point, v)
    k = n - 1
    loop k > 0 and f64(trail[k - 1].time) > at: k -= 1
    if k == 0: return (trail[0].point, world_delta(trail[1].point,trail[0].point) / f32(max(trail[1].time - trail[0].time, 0.001)))
    a = trail[k - 1]
    b = trail[k]
    u = clamp((at - f64(a.time)) / max(f64(b.time - a.time), 0.0001), 0.0, 1.0)
    (world_lerp(a.point,b.point,u), world_delta(b.point,a.point) / f32(max(b.time - a.time, 0.001)))

# the sound of an aircraft arriving now at `ear`: where it was when that sound left it, how fast
# it was going then, how far that is, and the Doppler factor for it and the listener's motion
heard_from = (trail: SoundSample[], ear: WorldPoint, ear_vel: vec3, t: f64) -> (WorldPoint, vec3, f64, f64):
    at = t
    p, v = _was(trail, at)
    loop n in 0..4:
        at = t - f64(length(world_delta(p,ear))) / SOUND_SPEED
        p, v = _was(trail, at)
    d = max(f64(length(world_delta(p,ear))), 1.0)
    u = world_delta(ear,p) / f32(d)
    doppler = clamp((SOUND_SPEED - f64(dot(ear_vel, u))) / max(SOUND_SPEED - f64(dot(v, u)), 30.0), 0.5, 2.2)
    (p, v, d, doppler)

_silence = (h: mut Hearing, i: int):
    loop id in [h.heard[i].near_v, h.heard[i].far_v, h.heard[i].near_r, h.heard[i].far_r]:
        if id >= 0: stop(id)
    h.heard[i].near_v = -1
    h.heard[i].far_v = -1
    h.heard[i].near_r = -1
    h.heard[i].far_r = -1

# how loud an engine is at d meters (1 at 60 m): falling off more gently than sound pressure in
# still air (an engine droning over the sea carries a long way, and the game's ears are kind) out
# to a few kilometers, then dropping away, so far engines fade out instead of piling up
_carry = (d: f64) -> f64: min(pow(60.0 / max(d, 15.0), 0.7), 2.0) * exp(-max(d - 2500.0, 0.0) / 1500.0)

# each frame: the engines about, heard by a listener at `ear` moving at `ear_vel`
hear_engines = (h: mut Hearing, sources: EngineSource[], ear: vec3, ear_vel: vec3, t: f64, precise_ear:WorldPoint?=none):
    listener=precise_ear ?? world_point(ear)
    if not h.ready: return
    # keep each aircraft's recent path (a sample every twentieth of a second, twelve seconds back)
    loop src in sources:
        k = -1
        loop i in 0..h.heard.len():
            if h.heard[i].craft == src.craft: k = i
        if k < 0:
            if not src.on or f64(length(src.pos - ear)) > HEARING: continue
            h.heard.push(Heard(src.craft))
            k = h.heard.len() - 1
        h.heard[k].seen = t
        tr = h.heard[k].trail
        if tr.len() == 0 or t - tr[tr.len() - 1].time >= 0.05: h.heard[k].trail.push(SoundSample(src.point ?? world_point(src.pos),t))
        loop h.heard[k].trail.len() > 2 and t - h.heard[k].trail[0].time > 12.0: h.heard[k].trail.remove_at(0)
    # (the types' own engines made as they come into hearing: a piece a frame)
    if tweaks.period_engines: _make_step(h)
    # the nearest few, by where their sound comes from now
    dist: (f64, int)[]
    loop i in 0..h.heard.len():
        p, _ = _was(h.heard[i].trail, t)
        dist.push((f64(length(world_delta(p,listener))), i))
    sort(dist, (x: (f64, int)) -> f64: x.0)
    keep = fill(false, h.heard.len())
    bed_power = 0.0; bed_x = 0.0; bed_y = 0.0; bed_z = 0.0; bed_pitch = 0.0; bed_weight = 0.0
    bed_kind = -2; bed_voice = EngineVoice.radial; bed_loudest = 0.0
    loop j in 0..min(VOICES, dist.len()): keep[dist[j].1] = true
    i = 0
    loop i < h.heard.len():
        hd = h.heard[i]
        src = EngineSource(-1, vec3(0, 0, 0), vec3(0, 0, 0), 0.0, false, 1.0)
        found = false
        loop s in sources:
            if s.craft == hd.craft:
                src = s
                found = true
        # (gone from the world, or long out of hearing: forgotten)
        if not found or (not keep[i] and t - hd.seen > 1.0) or f64(length(src.pos - ear)) > HEARING * 1.3:
            _silence(h, i)
            h.heard.remove_at(i)
            keep.remove_at(i)
            continue
        if not keep[i] or not src.on:
            _silence(h, i)
            if tweaks.period_engines and src.on:
                # (beyond the nearest few: into the distant bed, by its own loudness and place)
                p, _ = _was(hd.trail, t)
                d = max(f64(length(world_delta(p,listener))), 1.0)
                l = (0.45 + 0.55 * src.throttle) * _carry(d) * src.gain
                bed_power += l * l; bed_x += f64(world_delta(p,listener).x) * l; bed_z += f64(world_delta(p,listener).z) * l; bed_y += f64(world_delta(p,listener).y) * l
                bown = if src.kind >= 0: _own_engine(h, src.kind) else: -1
                bed_pitch += (if bown >= 0: _own_pitch(h, bown, src) else: src.tone * engine_note(src.throttle, src.true_speed)) * l
                bed_weight += l
                if bed_kind == -2 or l > bed_loudest: bed_kind = src.kind; bed_voice = src.voice; bed_loudest = l
            i += 1
            continue
        own = if tweaks.period_engines and src.kind >= 0: _own_engine(h, src.kind) else: -1
        if hd.voice != src.voice or hd.using != own:
            _silence(h, i)
            h.heard[i].voice = src.voice
            h.heard[i].using = own
            hd = h.heard[i]
        near = if own >= 0: h.kind_near[own] else: h.near[int(src.voice)]
        far_sound = if own >= 0: h.kind_far[own] else: h.far[int(src.voice)]
        p, v, d, doppler = heard_from(hd.trail, listener, ear_vel, t)
        power = 0.45 + 0.55 * src.throttle
        level = power * _carry(d) * src.gain
        far = smoothstep(150.0, 2000.0, d)
        # (pitched as one's own engine is, by its throttle and its speed as designed; its own
        # engine by its own turning speed)
        base = if own >= 0: _own_pitch(h, own, src) else: src.tone * engine_note(src.throttle, src.true_speed)
        pitch = base * doppler
        # (its image under the sea: the reflected sound, weaker, with its own path and Doppler)
        img = WorldPoint(p.x, -p.y, p.z)
        vimg = vec3(v.x, -v.y, v.z)
        d2 = max(f64(length(world_delta(img,listener))), 1.0)
        u2 = world_delta(listener,img) / f32(d2)
        doppler2 = clamp((SOUND_SPEED - f64(dot(ear_vel, u2))) / max(SOUND_SPEED - f64(dot(vimg, u2)), 30.0), 0.5, 2.2)
        level2 = power * _carry(d2) * 0.55 * src.gain
        far2 = smoothstep(150.0, 2000.0, d2)
        if hd.near_v < 0:
            # (each its own place in the loop, so two engines do not beat in step; the sea's copy
            # starts with it, and drifts as the paths change)
            off = random(0.0, duration(near))
            ids = [play(near, 0.0, looping = true, pitch = pitch), play(far_sound, 0.0, looping = true, pitch = pitch), play(near, 0.0, looping = true, pitch = base * doppler2), play(far_sound, 0.0, looping = true, pitch = base * doppler2)]
            loop id in ids: seek(id, off)
            h.heard[i].near_v = ids[0]
            h.heard[i].far_v = ids[1]
            h.heard[i].near_r = ids[2]
            h.heard[i].far_r = ids[3]
        hd2 = h.heard[i]
        move_world_sound(hd2.near_v, p, level * cos(far * PI * 0.5), 1000000000.0)
        move_world_sound(hd2.far_v, p, level * sin(far * PI * 0.5), 1000000000.0)
        move_world_sound(hd2.near_r, img, level2 * cos(far2 * PI * 0.5), 1000000000.0)
        move_world_sound(hd2.far_r, img, level2 * sin(far2 * PI * 0.5), 1000000000.0)
        set_pitch(hd2.near_v, pitch)
        set_pitch(hd2.far_v, pitch)
        set_pitch(hd2.near_r, base * doppler2)
        set_pitch(hd2.far_r, base * doppler2)
        i += 1
    _hear_bed(h, bed_kind, bed_voice, bed_power, vec3(f32(bed_x), f32(bed_y), f32(bed_z)) / f32(max(bed_weight, 1e-9)), if bed_weight > 0.0: bed_pitch / bed_weight else: 1.0, listener)

# paused: the other engines silent too
hush_engines = (h: Hearing):
    loop hd in h.heard:
        loop id in [hd.near_v, hd.far_v, hd.near_r, hd.far_r]:
            if id >= 0: set_volume(id, 0.0)
    if h.bed >= 0: set_volume(h.bed, 0.0)

# (a type's own engine sounds, an index in h.kinds; -1 until made, asking for them)
_own_engine = (h: mut Hearing, kind: int) -> int:
    loop k in 0..h.kinds.len():
        if h.kinds[k] == kind: return k
    if not h.wanted.contains(kind): h.wanted.push(kind)
    -1
_own_pitch = (h: Hearing, own: int, src: EngineSource) -> f64:
    spec = h.kind_spec[own]
    engine_pitch(spec, engine_rpm(spec, src.throttle, src.true_speed, h.kind_cruise[own], src.on))

# One piece of making a type's own engine heard from outside: its exhaust, its propeller, its
# tips, the three together, their muffled copy (each a few milliseconds).
_make_step = (h: mut Hearing):
    if h.making < 0:
        loop h.wanted.len() > 0 and h.making < 0:
            k = h.wanted[0]; h.wanted.remove_at(0)
            if not h.kinds.contains(k): h.making = k; h.making_stage = 0; h.making_parts = []
        if h.making < 0: return
    spec = engine_spec(Craft(h.making))
    if h.making_stage == 0: h.making_parts.push(make_exhaust(spec, true, 5))
    else if h.making_stage == 1: h.making_parts.push(make_prop(spec))
    else if h.making_stage == 2: h.making_parts.push(make_tips(spec, 6))
    else if h.making_stage == 3: h.making_parts = [outside_mix(h.making_parts[0], h.making_parts[1], h.making_parts[2])]
    else if h.making_stage == 4:
        n = h.making_parts[0].samples.len() / 2
        h.making_muffle = muffle_begin(n)
        muffle_run(h.making_muffle, h.making_parts[0].samples, n - MIX_RATE / 2, n, false)
    else if h.making_stage == 5:
        muffle_run(h.making_muffle, h.making_parts[0].samples, 0, h.making_parts[0].samples.len() / 2, true)
    else:
        near = h.making_parts[0]
        h.kinds.push(h.making); h.kind_near.push(near); h.kind_far.push(Sound(h.making_muffle.out)); h.making_muffle = Muffle()
        h.kind_spec.push(spec); h.kind_cruise.push(aircraft_profile(Craft(h.making)).cruise)
        h.making = -1; h.making_parts = []
        return
    h.making_stage += 1

# The distant bed: those beyond the nearest few, as one muffled engine from where they are on
# the whole, as loud as all of them together, at their mean pitch.
_hear_bed = (h: mut Hearing, kind: int, voice: EngineVoice, power: f64, at: vec3, pitch: f64, listener: WorldPoint):
    if power <= 0.0 or not tweaks.period_engines:
        if h.bed >= 0: stop(h.bed); h.bed = -1; h.bed_kind = -2
        return
    own = if kind >= 0: _own_engine(h, kind) else: -1
    want = if own >= 0: kind else: -1 - int(voice)
    if h.bed >= 0 and h.bed_kind != want: stop(h.bed); h.bed = -1
    if h.bed < 0:
        h.bed = play(if own >= 0: h.kind_far[own] else: h.far[int(voice)], 0.0, looping = true, pitch = pitch)
        h.bed_kind = want
    move_world_sound(h.bed, world_offset(listener, at), sqrt(power), 1000000000.0)
    set_pitch(h.bed, pitch)

# Spatialize after subtracting in f64; never reconstruct an absolute f32 source
# just for the audio API. Match its gain and camera-axis pan exactly.
move_world_sound=(id:int,point:WorldPoint,volume:f64,reach:f64):
    eye=world_offset(world_point(scene_camera()),render_eye_low)
    d=world_delta(point,eye);right=cross(__cam_target-__cam_pos,__cam_up)
    pan=if length(right)>0.0001 and length(d)>0.0001:f64(dot(normalize(d),normalize(right)))*0.8 else:0.0
    set_volume(id,volume*__reach_gain(f64(length(d)),reach));set_pan(id,pan)
