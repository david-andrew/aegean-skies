use 'runtime_options.jo'
# Read-only visual/flight adapter for the living world's saved weather.
import 'living_conditions.jo' as weather
import 'living_types.jo' as wt
use 'look.jo'

weather_cells: wt.Weather[]
weather_minute_now = 0.0
weather_hour_now = 14.0
weather_seconds = 0.0
weather_here = weather.WeatherAir()
weather_active = false

weather_at_point = (p: vec3) -> weather.WeatherAir:
    weather.weather_air(weather_cells,weather_minute_now,weather_hour_now,p)

weather_flight_wind = (p: vec3) -> vec3:
    a = weather_at_point(p)
    a.wind+weather.weather_gust(a,p,weather_seconds)

weather_scene_step = (w: wt.World, p: vec3, hour: f64, dt: f64):
    global weather_cells,weather_minute_now,weather_hour_now,weather_seconds,weather_here,weather_active,wind_now
    weather_cells = w.weather
    weather_minute_now = f64(w.tick)/f64(wt.TICKS_PER_MINUTE)
    weather_hour_now = hour
    weather_seconds = f64(w.tick)/60.0
    if let capture = startup_aegean_weather_clock: weather_seconds = to_float(capture) ?? weather_seconds
    weather_here = weather_at_point(p)
    weather_active = true
    wind_now.speed = f64(length(weather_here.wind))
    wind_now.dir = if wind_now.speed > 0.01: normalize(weather_here.wind.xz) else: vec2(0,1)
    advance_wind(wind_now,dt)

# A deterministic two-pulse flash, keyed by a saved storm's identity and world
# clock. No new random draws, gameplay damage, or audio/screen overlay.
weather_lightning = () -> f32:
    flash: f32 = 0.0
    loop cell in weather_cells:
        if cell.kind != .storm: continue
        phase = (weather_seconds+f64(cell.id)*7.13)%23.0
        pulse = max(0.0,1.0-abs(phase-2.0)/0.08)+max(0.0,1.0-abs(phase-2.22)/0.12)*0.65
        flash = max(flash,f32(pulse)*weather.weather_weight(cell,weather_minute_now,vec3(cell.center.x,0,cell.center.y)))
    flash

weather_light = (L: Light, p: vec3) -> Light:
    if not weather_active: return L
    a = weather_at_point(p)
    cover = clamp(a.deck*0.8+a.rain*0.65,0.0,0.95)
    high = smoothstep(a.ceiling+450.0+a.storm*5400.0,a.ceiling+900.0+a.storm*5400.0,p.y)
    cover *= 1.0-high
    out = L
    # A covered sky is one cool, diffuse source. Dimming direct light alone
    # left the saturated blue ambient brighter than the lit faces in rain.
    day = smoothstep(-0.12,0.35,L.sun_dir.y)
    grey_sun = mix(vec3(0.09,0.12,0.19),vec3(0.50,0.54,0.58),day)
    grey_shade = mix(vec3(0.025,0.038,0.07),vec3(0.23,0.29,0.34),day)
    grey_air = mix(vec3(0.035,0.052,0.09),vec3(0.36,0.43,0.49),day)
    wet = a.rain*(1.0-high)
    out.sun = mix(L.sun,grey_sun,cover)*(1.0-wet*0.12)
    out.shade = mix(L.shade,grey_shade,cover)
    out.sky_top = mix(L.sky_top,grey_air*0.78,cover)
    out.sky_horizon = mix(L.sky_horizon,grey_air,cover)
    fog = a.fog*(1.0-smoothstep(50.0,220.0,p.y))
    out.haze = mix(L.haze,grey_air,clamp(cover*0.85+wet*0.3+fog*0.4,0.0,0.95))
    out.fog_density *= f64((1.0+wet*4.5+fog*6.0)/a.clarity)
    out.sea_deep = mix(L.sea_deep,grey_air*0.20,cover*0.75)
    out.sea_shallow = mix(L.sea_shallow,grey_air*0.65,cover*0.55)
    flash = weather_lightning()*a.storm
    out.sun += vec3(0.7,0.78,1.0)*flash
    out.sky_horizon += vec3(0.18,0.22,0.3)*flash
    out

# Explicit capture fixtures use the same saved-data path; never auto-selected.
weather_fixture = (w: mut wt.World, name: str, p: vec3):
    w.weather = []
    kind: wt.WeatherKind = .fair
    match name:
        "meltemi": kind = .wind
        "towers": kind = .towers
        "overcast", "country-overcast": kind = .overcast
        "front", "rain": kind = .squall
        "storm": kind = .storm
        "fog": kind = .fog
        "calm": kind = .calm
        _: pass
    center = p.xz
    if name == "front": center += vec2(0,-18000)
    w.weather.push(wt.Weather(id=991,kind=kind,center=center,radius_m=if name == "storm": 9000 else: if name == "country-overcast": 600000 else: 80000,aspect=if name == "front": vec2(2.0,0.3) else: vec2(1,1),severity=if kind == .storm: 950 else: if kind == .squall: 700 else: 0,wind_milli_m_per_sec=if kind == .wind: vec2(-2000,13000) else: if kind == .storm: vec2(7000,9000) else: vec2(0,0),born_minute=-100,expires_minute=10000))

# Explicit pause-menu choices seed real saved weather, then release it to the
# existing drift/lifetime/scheduling simulation. No permanent renderer override.
WEATHER_CHOICES = ["fair","towers","overcast","front","rain","storm","fog","meltemi","calm"]
WEATHER_LABELS = ["Fair","Towers","Overcast","Front","Rain","Thunderstorm","Fog","Meltemi","Calm"]
weather_choose = (w: mut wt.World, choice: int, p: vec3):
    if choice < 0 or choice >= WEATHER_CHOICES.len(): return
    weather_fixture(w,WEATHER_CHOICES[choice],p)
    w.weather[0].id = w.next_weather; w.next_weather += 1
    w.weather[0].born_minute = w.minute-30
    w.weather[0].expires_minute = w.minute+720
    w.weather[0].fade_minutes = 30
    if choice == 3: w.weather[0].velocity_milli_m_per_minute = vec2(20000,80000)
    else if choice == 5: w.weather[0].velocity_milli_m_per_minute = vec2(16000,22000)
