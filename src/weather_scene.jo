use 'runtime_options.jo'
# Read-only visual/flight adapter for the living world's saved weather.
import 'living_conditions.jo' as weather
import 'living_types.jo' as wt
use 'look.jo'
use 'lightning.jo'
use 'world_point.jo'

weather_cells: wt.Weather[]
weather_minute_now = 0.0
weather_hour_now = 14.0
weather_seconds = 0.0
weather_here = weather.WeatherAir()
weather_active = false

weather_at_point = (p: vec3) -> weather.WeatherAir:
    weather.weather_air(weather_cells,weather_minute_now,weather_hour_now,p)

weather_flight_wind = (p: vec3) -> vec3:
    a = weather_at_point(p)
    a.wind+weather.weather_gust(a,p,weather_seconds)+weather_turbulent_gust(p,weather_turbulence(p))

# The cloud bodies near the camera that make the air rough inside them, from
# mild in fair cumulus to violent in a thunderstorm (`rough`, 0..1). Refreshed
# with the frame's cloud list.
struct WeatherBody:
    center: WorldPoint
    extent: vec3
    yaw: vec2
    rough: f32
weather_bodies: WeatherBody[]

# How rough the air is at p (0..1): inside a cloud's body, and in the gust
# front and downdrafts under a thunderstorm.
weather_turbulence = (p: vec3) -> f32:
    if not weather_active: return 0.0
    a = weather_at_point(p)
    rough = a.storm*0.4*(1.0-smoothstep(a.ceiling-100.0,a.ceiling+150.0,p.y))
    # Inside a storm system's deck the air is rough throughout, hardest toward its core.
    deck = smoothstep(a.ceiling-100.0,a.ceiling+100.0,p.y)*(1.0-smoothstep(3400.0,3700.0,p.y))
    rough = max(rough,smoothstep(0.0,0.6,a.storm)*0.6*deck)
    at = world_point(p)
    loop b in weather_bodies:
        d = world_delta(at,b.center)
        q = vec3(d.x*b.yaw.x+d.z*b.yaw.y,d.y,-d.x*b.yaw.y+d.z*b.yaw.x)/b.extent
        # (the body's lower part sits on its base, below its box's middle, and
        # fills the box out to its edges: rough from where the cloud is entered)
        q.y = q.y+0.3
        rough = max(rough,(1.0-smoothstep(0.75,1.0,length(q)))*b.rough)
    clamp(rough,0.0,1.0)

# Turbulent air, carried in the wind the flight model meets: eddies a few
# hundred metres across (an aircraft crossing them feels sharp vertical gusts
# and its airspeed swing), and a storm's broad updrafts and downdrafts.
weather_turbulent_gust = (p: vec3, rough: f32) -> vec3:
    if rough <= 0.0: return vec3(0,0,0)
    t = weather_seconds
    x = f64(p.x)*0.006; y = f64(p.y)*0.006; z = f64(p.z)*0.006
    e = vec3(f32(noise(x+t*0.31,y,z)-0.5),f32(noise(x,y+17.3,z+t*0.27)-0.5),f32(noise(x+41.0,y,z+t*0.23)-0.5))
    fine = vec3(f32(noise(x*4.0+t*1.9,y*4.0,z*4.0+7.0)-0.5),f32(noise(x*4.0+3.0,y*4.0+t*2.3,z*4.0)-0.5),f32(noise(x*4.0,y*4.0+11.0,z*4.0+t*1.7)-0.5))
    draft = f32(noise(f64(p.x)*0.0007+t*0.02,f64(p.z)*0.0007,5.0)-0.5)
    # (a storm's cores drive broad downdraughts and updraughts, the hardest where roughest)
    gust = e*vec3(16,22,16)+fine*vec3(6,9,6)+vec3(0,draft*(20.0+25.0*rough),0)
    gust*rough

weather_scene_step = (w: wt.World, p: vec3, hour: f64, dt: f64):
    global weather_cells,weather_minute_now,weather_hour_now,weather_seconds,weather_here,weather_active,wind_now
    weather_cells = w.weather
    weather_minute_now = f64(w.tick)/f64(wt.TICKS_PER_MINUTE)
    weather_hour_now = hour
    weather_seconds = f64(w.tick)/60.0
    if let capture = startup_aegean_weather_clock: weather_seconds = to_float(capture) ?? weather_seconds
    weather_here = weather_at_point(p)
    weather_active = true
    weather_strike_step()
    wind_now.speed = f64(length(weather_here.wind))
    wind_now.dir = if wind_now.speed > 0.01: normalize(weather_here.wind.xz) else: vec2(0,1)
    advance_wind(wind_now,dt)

# The brightest strike alight now (lightning.jo), and its light: the bolt,
# the cloud lit from inside and the sky's flash all follow it.
weather_strike = Strike()
weather_strike_light: f32 = 0.0
weather_strike_step = ():
    global weather_strike,weather_strike_light
    weather_strike = Strike(); weather_strike_light = 0.0
    loop cell in weather_cells:
        s = lightning_strike_at(cell,weather_seconds)
        if s.key < 0: continue
        light = lightning_brightness(s,weather_seconds-s.time)*s.weight
        if light > weather_strike_light: weather_strike = s; weather_strike_light = light
weather_lightning = () -> f32: weather_strike_light

weather_light = (L: Light, p: vec3) -> Light:
    if not weather_active: return L
    a = weather_at_point(p)
    cover = clamp(a.deck*0.8+a.rain*0.65,0.0,0.95)
    # (a broken deck lets the sun through its gaps: the shadow pass darkens what lies under
    # its rolls, so the sun itself, and the sky between, stay brighter)
    sun_cover = cover*(1.0-0.75*a.broken)
    cover *= 1.0-0.2*a.broken
    high = smoothstep(a.ceiling+450.0+a.storm*5400.0,a.ceiling+900.0+a.storm*5400.0,p.y)
    cover *= 1.0-high
    out = L
    # A covered sky is one cool, diffuse source. Dimming direct light alone
    # left the saturated blue ambient brighter than the lit faces in rain.
    day = smoothstep(-0.12,0.35,L.sun_dir.y)
    # (twilight: the clear sky keeps its glow until the sun is well down, so a covered
    # sky must not reach night darkness at sunset; rain then turned the scene black)
    glow = (1.0-smoothstep(0.05,0.55,L.sun_dir.y))*smoothstep(-0.2,0.0,L.sun_dir.y)
    day = max(day,glow*0.6)
    grey_sun = mix(vec3(0.09,0.12,0.19),vec3(0.50,0.54,0.58),day)
    grey_shade = mix(vec3(0.025,0.038,0.07),vec3(0.23,0.29,0.34),day)
    grey_air = mix(vec3(0.035,0.052,0.09),vec3(0.36,0.43,0.49),day)
    wet = a.rain*(1.0-high)
    out.sun = mix(L.sun,grey_sun,sun_cover)*(1.0-wet*0.12)
    out.shade = mix(L.shade,grey_shade,cover)
    out.sky_top = mix(L.sky_top,grey_air*0.78,cover)
    out.sky_horizon = mix(L.sky_horizon,grey_air,cover)
    fog = a.fog*(1.0-smoothstep(50.0,220.0,p.y))
    out.haze = mix(L.haze,grey_air,clamp(cover*0.85+wet*0.3+fog*0.4,0.0,0.95))
    out.fog_density *= f64((1.0+wet*4.5+fog*6.0)/a.clarity)
    out.sea_deep = mix(L.sea_deep,grey_air*0.20,cover*0.75)
    out.sea_shallow = mix(L.sea_shallow,grey_air*0.65,cover*0.55)
    # (the whole sky flashes only near the strike)
    near = if weather_strike.key >= 0: 1.0-smoothstep(3000.0,14000.0,length(world_delta(world_point(p),weather_strike.center).xz)) else: 0.0
    # Inside a storm's rain the view closes in, darker and greyer: the
    # downpour blurs everything past a few hundred metres.
    cell = smoothstep(0.5,0.85,a.storm)*(1.0-smoothstep(a.ceiling+a.storm*5000.0,a.ceiling+a.storm*5400.0,p.y))
    out.fog_density *= f64(1.0+cell*5.0)
    out.haze = mix(out.haze,grey_air*0.62,cell*0.55)
    out.sun *= 1.0-cell*0.25
    flash = weather_lightning()*max(a.storm,0.35)*near
    out.sun += vec3(0.7,0.78,1.0)*flash
    out.sky_horizon += vec3(0.18,0.22,0.3)*flash
    out

# Explicit capture fixtures use the same saved-data path; never auto-selected.
weather_fixture = (w: mut wt.World, name: str, p: vec3):
    w.weather = []
    kind: wt.WeatherKind = .fair
    match name:
        "meltemi": kind = .wind
        "towers": kind = .towers
        "overcast", "country-overcast", "broken": kind = .overcast
        "front", "rain": kind = .squall
        "storm": kind = .storm
        "fog": kind = .fog
        "calm": kind = .calm
        _: pass
    center = p.xz
    if name == "front": center += vec2(0,-18000)
    w.weather.push(wt.Weather(id=991,kind=kind,center=center,radius_m=if name == "storm": 13000 else: if name == "country-overcast": 600000 else: 80000,aspect=if name == "front": vec2(2.0,0.3) else: vec2(1,1),severity=if kind == .storm: 950 else: if kind == .squall: 700 else: if name == "broken": 300 else: 0,wind_milli_m_per_sec=if kind == .wind: vec2(-2000,13000) else: if kind == .storm: vec2(7000,9000) else: vec2(0,0),born_minute=-100,expires_minute=10000))

# Explicit pause-menu choices seed real saved weather, then release it to the
# existing drift/lifetime/scheduling simulation. No permanent renderer override.
# (new choices go last: title shots and settings keep their indices)
WEATHER_CHOICES = ["fair","towers","overcast","front","rain","storm","fog","meltemi","calm","broken"]
WEATHER_LABELS = ["Fair","Towers","Overcast","Front","Rain","Thunderstorm","Fog","Meltemi","Calm","Broken cloud"]
weather_choose = (w: mut wt.World, choice: int, p: vec3):
    if choice < 0 or choice >= WEATHER_CHOICES.len(): return
    weather_fixture(w,WEATHER_CHOICES[choice],p)
    w.weather[0].id = w.next_weather; w.next_weather += 1
    w.weather[0].born_minute = w.minute-30
    w.weather[0].expires_minute = w.minute+720
    w.weather[0].fade_minutes = 30
    if WEATHER_CHOICES[choice] == "front": w.weather[0].velocity_milli_m_per_minute = vec2(20000,80000)
    else if WEATHER_CHOICES[choice] == "storm": w.weather[0].velocity_milli_m_per_minute = vec2(16000,22000)
