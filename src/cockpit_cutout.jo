# Subtract a small cockpit well from the first-person fuselage only. Clip crossing triangles
# instead of dropping whole hull faces; outside meshes, part identities and contacts stay exact.
_cockpit_lerp = (a:Vertex3D,b:Vertex3D,t:f32) -> Vertex3D:
    Vertex3D(mix(a.pos,b.pos,t),normalize(mix(a.normal,b.normal,t)),mix(a.uv,b.uv,t),mix(a.color,b.color,t))

_cockpit_half = (poly:Vertex3D[],normal:vec3,bound:f32,inside:bool) -> Vertex3D[]:
    out:Vertex3D[]
    if poly.len()==0:return out
    prev=poly[poly.len()-1];pd=dot(prev.pos,normal)-bound
    loop cur in poly:
        cd=dot(cur.pos,normal)-bound
        pin=if inside:pd<=0 else:pd>=0
        cin=if inside:cd<=0 else:cd>=0
        if pin!=cin:out.push(_cockpit_lerp(prev,cur,pd/(pd-cd)))
        if cin:out.push(cur)
        prev=cur;pd=cd
    out

cockpit_cutout = (vs:Vertex3D[],seat:vec3) -> Vertex3D[]:
    normals=[vec3(1,0,0),vec3(-1,0,0),vec3(0,1,0),vec3(0,-1,0),vec3(0,0,1),vec3(0,0,-1)]
    bounds=[seat.x+0.53,-seat.x+0.53,seat.y+0.45,-seat.y+1.0,seat.z+0.95,-seat.z+0.86]
    out:Vertex3D[]
    loop tri in 0..vs.len()/3:
        remaining=vs[tri*3..tri*3+3]
        loop plane in 0..6:
            outside=_cockpit_half(remaining,normals[plane],bounds[plane],false)
            loop j in 1..outside.len()-1:out.extend([outside[0],outside[j],outside[j+1]])
            remaining=_cockpit_half(remaining,normals[plane],bounds[plane],true)
            if remaining.len()==0:break
    out

# Cabanes are known craft-space members. Classify by distance to their axes,
# not vertex batches: the part splitter assigns shared centre faces to one wing only.
cockpit_cabanes = (vs:Vertex3D[],starts:vec3[],ends:vec3[]) -> Vertex3D[]:
    out:Vertex3D[]
    loop tri in 0..vs.len()/3:
        remove=false
        loop member in 0..starts.len():
            a=starts[member];d=ends[member]-a;near=true
            loop j in 0..3:
                point=vs[tri*3+j].pos
                closest=a+d*clamp(dot(point-a,d)/dot(d,d),0.0,1.0)
                if length(point-closest)>0.075:near=false
            if near:remove=true
        if not remove:out.extend(vs[tri*3..tri*3+3])
    loop member in 0..starts.len():
        a=starts[member];b=ends[member]
        add_cylinder(out,vec3(0,0,0),0.019,f64(length(b-a)),rgb(0.36,0.33,0.26),6,transform=translation(a)*facing(b-a)*rotation_x(-PI*0.5))
    out
