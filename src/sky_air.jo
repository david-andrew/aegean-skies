# Shared clear-air gradient: distant paintings must dissolve into the sky's
# actual teal/horizon wash, not a different flat grey fog color. Clouds evaluate
# this once per formation on the CPU; the sky evaluates it per pixel.
use 'render_space.jo'

sky_air_color = (dir_y: f32, altitude: f32, sun_y: f32, top: vec3, horizon: vec3, haze: vec3) -> vec3:
    h = max(altitude,0.0)
    dip = sqrt(h*(2.0*f32(EARTH_RADIUS)+h))/(f32(EARTH_RADIUS)+h)
    y = max(dir_y+dip,0.0)
    # The palette already carries hour and weather. Replacing it with noon
    # teal here used to turn the gaps in a rain deck into a fair-weather sky.
    # At the curved tangent the sky and fully hazed sea share one endpoint.
    mix(mix(horizon,top,sqrt(clamp(y,0.0,1.0))),haze,exp(-y*18.0))

# Twilight's glow (look.jo Light.afterglow, a trial): a warm band low on the sun's side of the sky,
# orange at the horizon turning peach-gold above it, a faint rose round the rest; the sun itself
# may be well below the horizon. rgb the glow's colour, a how much it covers the sky there.
sky_afterglow = (dir: vec3, altitude: f32, sun: vec3, glow: vec4) -> vec4:
    h = max(altitude,0.0)
    dip = sqrt(h*(2.0*f32(EARTH_RADIUS)+h))/(f32(EARTH_RADIUS)+h)
    y = max(dir.y+dip,0.0)
    flat = normalize(vec2(dir.x,dir.z)+vec2(0.0001,0))
    toward = normalize(vec2(sun.x,sun.z)+vec2(0.0001,0))
    facing = clamp(dot(flat,toward)*0.5+0.5,0.0,1.0)
    side = facing*facing*facing
    up = y/max(glow.y,0.01)
    band = exp(-up*0.9)
    warm = mix(vec3(0.88,0.5,0.24),vec3(0.9,0.76,0.5),smoothstep(0.05,0.9,up))
    colour = mix(vec3(0.5,0.38,0.44),warm,smoothstep(0.15,0.75,facing))
    vec4(colour,clamp(glow.x*band*mix(0.22,0.97,side),0.0,0.97))
