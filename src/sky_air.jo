# Shared clear-air gradient: distant paintings must dissolve into the sky's
# actual teal/horizon wash, not a different flat grey fog color. Clouds evaluate
# this once per formation on the CPU; the sky evaluates it per pixel.
use 'render_space.jo'

sky_air_color = (dir_y: f32, altitude: f32, sun_y: f32, top: vec3, horizon: vec3, haze: vec3) -> vec3:
    h = max(altitude,0.0)
    dip = sqrt(h*(2.0*f32(EARTH_RADIUS)+h))/(f32(EARTH_RADIUS)+h)
    y = max(dir_y+dip,0.0)
    # The palette already carries hour and weather. Replacing it with noon
    # teal here used to turn the gaps in a rain deck into a fair-weather sky.
    # At the curved tangent the sky and fully hazed sea share one endpoint.
    mix(mix(horizon,top,sqrt(clamp(y,0.0,1.0))),haze,exp(-y*18.0))

# Twilight's glow (look.jo Light.afterglow): a warm band low on the sun's side of the sky, orange at
# the horizon turning peach-gold above it, a faint rose round the rest; the sun itself may be well
# below the horizon. y is the height above the horizon (dir.y plus the dip). Kept lean (no
# normalizing: near the horizon, where the glow lives, dir.xz is nearly unit). rgb the glow's
# colour, a how much it covers the sky there.
sky_afterglow = (dir: vec3, y: f32, glow: vec4) -> vec4:
    facing = clamp(dot(dir.xz,glow.zw)*0.5+0.5,0.0,1.0)
    side = facing*facing*facing
    up = max(y,0.0)*glow.y
    warm = mix(vec3(0.92,0.53,0.25),vec3(0.93,0.8,0.55),clamp(up*1.18-0.06,0.0,1.0))
    colour = mix(vec3(0.5,0.38,0.44),warm,clamp(facing*1.67-0.25,0.0,1.0))
    vec4(colour,min(glow.x*exp(-up*0.9)*mix(0.22,0.97,side),0.97))
