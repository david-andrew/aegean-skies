# Shared clear-air gradient: distant paintings must dissolve into the sky's
# actual teal/horizon wash, not a different flat grey fog color. Clouds evaluate
# this once per formation on the CPU; the sky evaluates it per pixel.
use 'render_space.jo'
use 'look.jo'

sky_air_color = (dir_y: f32, altitude: f32, sun_y: f32, top: vec3, horizon: vec3, haze: vec3) -> vec3:
    h = max(altitude,0.0)
    dip = sqrt(h*(2.0*f32(EARTH_RADIUS)+h))/(f32(EARTH_RADIUS)+h)
    y = max(dir_y+dip,0.0)
    # The palette already carries hour and weather. Replacing it with noon
    # teal here used to turn the gaps in a rain deck into a fair-weather sky.
    # At the curved tangent the sky and fully hazed sea share one endpoint.
    mix(mix(horizon,top,sqrt(clamp(y,0.0,1.0))),haze,exp(-y*18.0))

# The air toward the horizon from height (in shaders). Seen from high up, the sea and the land are
# veiled by darker air than the sky's (look.jo air_down: the haze a little darker the higher the
# eye) for a steep look down; nearing the horizon the line of sight runs through the same air as
# the sky's just above it, so in the last degrees below the tangent that darker air gives way to
# the sky's own air there (`tangent`: the haze sky_air_color ends on), falling off below the
# horizon as the sky's haze band does above it. Without it the far sea and land were a flat band
# darker than the sky, under a hard step at the horizon. `world` is in the flat chart (render_world
# lowers it by the curve); the depression is in radians, small angles.
air_tangent = (down: vec3, tangent: vec3, world: vec3, cam: vec3, top: vec3, glow_dir: vec4, glow_sun: vec3, glow_warm: vec3) -> vec3:
    q = world.xz - cam.xz
    flat = max(length(q), 1.0)
    h = max(cam.y, 0.0)
    fall = cam.y - world.y + world_drop(q)
    below = fall / flat - sqrt(2.0 * h / f32(EARTH_RADIUS))
    k = exp(-max(below, 0.0) * 18.0)
    if k < 0.002: return down
    # (the sky's own colour at the tangent there, sky.jo sky_color: its haze, toward its top on
    # the side away from a low sun, and the sun's glow and warmth round it; horizon_glow)
    sd = max(dot(normalize(vec3(q.x, -fall, q.y)), glow_dir.xyz), 0.0)
    sky = mix(tangent, top, glow_dir.w * (1.0 - sd * sd * sd)) + glow_sun * (pow(sd, 6.0) * 0.14 + pow(sd, 40.0) * 0.22) + glow_warm * pow(sd, 18.0)
    mix(down, sky, k)

# (on the CPU) air_tangent's sun terms for a light, as sky_color works them out: the way to the sun
# and (w) how far a low sun turns the far side toward the sky's top, the glow's colour, the warmth's
horizon_glow = (L: Light) -> (vec4, vec3, vec3):
    l = normalize(L.sun_dir)
    daylight = f32(smoothstep(-0.12, 0.04, f64(l.y)))
    low_sun = f32(1.0 - smoothstep(0.05, 0.5, f64(l.y))) * daylight
    (vec4(l, low_sun * 0.3), L.sun * L.glare * daylight, L.sunset_warm * (low_sun * 0.2))
