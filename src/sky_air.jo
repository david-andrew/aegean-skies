# Shared clear-air gradient: distant paintings must dissolve into the sky's
# actual teal/horizon wash, not a different flat grey fog color. Clouds evaluate
# this once per formation on the CPU; the sky evaluates it per pixel.
use 'render_space.jo'

sky_air_color = (dir_y: f32, altitude: f32, sun_y: f32, top: vec3, horizon: vec3, haze: vec3) -> vec3:
    h = max(altitude,0.0)
    dip = sqrt(h*(2.0*f32(EARTH_RADIUS)+h))/(f32(EARTH_RADIUS)+h)
    y = max(dir_y+dip,0.0)
    # The palette already carries hour and weather. Replacing it with noon
    # teal here used to turn the gaps in a rain deck into a fair-weather sky.
    # At the curved tangent the sky and fully hazed sea share one endpoint.
    mix(mix(horizon,top,sqrt(clamp(y,0.0,1.0))),haze,exp(-y*18.0))
