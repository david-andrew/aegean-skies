# Stable keys, not list indices, identify repeatable situations. Keep the menu lightweight.
struct Scenario:
    key: str
    name: str
    description: str

SCENARIOS = [Scenario("start", "Start of the game", "A fresh morning on the waterfront at Porto Vecchio."),Scenario("strait", "Battle over the strait", "Two nations. Sixteen fighters. Rain below cloud."),Scenario("canal", "Canal takeoff", "Repaired. Engine running. Pursuers closing.")]
