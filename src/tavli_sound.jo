# The sounds of the tavli board, made here (nothing recorded): bone dice rattled in the hand and
# clacking on the wooden board and its case, and wooden checkers put down. Each is a few short
# noise bursts through decaying resonances (the bone's ring, the board's knock), in variations so
# no two clacks are alike. Built once; the game plays them with a pan and a level.

struct TavliSounds:
    rattle: Sound[]
    clack: Sound[]
    checker: Sound[]

_ts_rng = (x: u64) -> u64: (x * u64(6364136223846793005) + u64(1442695040888963407))
_ts_noise = (state: mut u64) -> f64:
    state = _ts_rng(state)
    f64(int((state >> u64(33)) & u64(0xffffff))) / 8388608.0 - 1.0

# one strike: a burst of noise `burst` seconds long exciting resonances (frequency, decay time,
# level), added into `out` (mono) at `at` seconds
_ts_strike = (out: mut f64[], at: f64, level: f64, burst: f64, modes: vec3[], seed: u64):
    state = seed
    start = int(at * f64(MIX_RATE))
    n = int(0.12 * f64(MIX_RATE))
    phases = [loop m in modes: 0.0]
    loop i in 0..n:
        k = start + i
        if k >= out.len(): break
        t = f64(i) / f64(MIX_RATE)
        excite = if t < burst: _ts_noise(state) * (1.0 - t / burst) else: 0.0
        v = excite * 0.25
        loop j in 0..modes.len():
            m = modes[j]
            v += sin(f64(m.x) * TAU * t + phases[j]) * f64(m.z) * exp(-t / f64(m.y))
        out[k] += v * level

_ts_sound = (mono: f64[]) -> Sound:
    peak = 0.0
    loop v in mono: peak = max(peak, abs(v))
    g = if peak > 0.0: 0.8 / peak else: 1.0
    s: f32[]
    loop v in mono:
        s.push(f32(v * g)); s.push(f32(v * g))
    Sound(s)

make_tavli_sounds = () -> TavliSounds:
    out = TavliSounds()
    loop k in 0..4:
        r = 1.0 + 0.06 * f64(k - 2)
        # (a die on the board: a hard click, the bone's ring, the wood's knock under it)
        mono = fill(0.0, int(0.14 * f64(MIX_RATE)))
        _ts_strike(mono, 0.0, 1.0, 0.0015, [vec3(f32(3300.0 * r), 0.012, 0.5), vec3(f32(4850.0 * r), 0.008, 0.35), vec3(f32(1150.0 * r), 0.022, 0.6), vec3(f32(410.0 * r), 0.03, 0.5)], u64(11 + k))
        out.clack.push(_ts_sound(mono))
        # (a checker put down: a wooden thock, low, a little hollow)
        mono2 = fill(0.0, int(0.14 * f64(MIX_RATE)))
        _ts_strike(mono2, 0.0, 1.0, 0.003, [vec3(f32(640.0 * r), 0.03, 0.8), vec3(f32(1520.0 * r), 0.014, 0.4), vec3(f32(190.0 * r), 0.04, 0.5)], u64(41 + k))
        out.checker.push(_ts_sound(mono2))
    loop k in 0..2:
        # (the dice rattled in the hand: a dozen small knocks, bone on bone, as they are shaken)
        mono = fill(0.0, int(0.75 * f64(MIX_RATE)))
        state = u64(97 + k * 13)
        loop j in 0..13:
            state = _ts_rng(state)
            at = f64(j) * 0.045 + f64(int((state >> u64(40)) & u64(255))) / 255.0 * 0.03
            lv = 0.35 + 0.65 * f64(int((state >> u64(20)) & u64(255))) / 255.0
            _ts_strike(mono, at, lv * (1.0 - f64(j) / 20.0), 0.0008, [vec3(f32(3900.0 + 300.0 * f64(j % 3)), 0.006, 0.5), vec3(f32(2600.0), 0.009, 0.3)], state)
        out.rattle.push(_ts_sound(mono))
    out

# Play what the board asked for (kind 0 the rattle, 1 a die's clack, 2 a checker), quietly.
play_tavli_sounds = (bank: TavliSounds, events: vec3[], n: int, volume: f64):
    loop k in 0..events.len():
        e = events[k]
        kind = int(e.x); level = f64(e.y); pan = f64(e.z)
        pick = (n + k * 3) % 4
        if kind == 0 and bank.rattle.len() > 0: _ = play(bank.rattle[(n + k) % bank.rattle.len()], volume * 0.7, pan)
        else if kind == 1 and bank.clack.len() > 0: _ = play(bank.clack[pick], volume * (0.25 + 0.6 * level), pan, 0.94 + 0.12 * f64((n * 7 + k) % 5) / 4.0)
        else if kind == 2 and bank.checker.len() > 0: _ = play(bank.checker[pick], volume * (0.35 + 0.5 * level), pan)
