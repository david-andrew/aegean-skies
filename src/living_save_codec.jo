# The sparse registry is several megabytes as text. Two compressed slots keep the same
# canonical World and corruption fallback without exceeding small browser storage budgets.
use 'living_types.jo'

struct PackedLivingSave:
    schema = 2
    cargo_version = 1
    encoding = 1
    valid = true
    generation: int
    terrain_key: int
    world_bytes: int
    world_hash: u64
    world_deflate: str
    presentation: PresentationState

pack_living_save = (game: SaveGame) -> PackedLivingSave:
    text=to_text(game.world)
    PackedLivingSave(generation=game.generation,terrain_key=game.terrain_key,world_bytes=text.len(),world_hash=hash(text),world_deflate=base64_encode(deflate(bytes(text))),presentation=game.presentation)

unpack_living_save = (packed: PackedLivingSave) -> SaveGame?:
    if not packed.valid or packed.schema!=2 or packed.encoding!=1 or packed.cargo_version!=1 or packed.world_bytes<1 or packed.world_bytes>64000000 or packed.world_deflate.len()>16000000: return none
    encoded=base64_decode(packed.world_deflate) ?? return none
    raw=inflate(encoded) ?? return none
    if raw.len()!=packed.world_bytes: return none
    text=str_from_bytes(raw)
    if hash(text)!=packed.world_hash: return none
    world=from_text[World](text)
    if world is TextError: return none
    SaveGame(schema=2,valid=true,generation=packed.generation,terrain_key=packed.terrain_key,world=world,presentation=packed.presentation)

# save_data preserves bytes, including NULs, on both native files and browser storage.
# Its web backend already base64-encodes them. Keep the compressed body in a separate
# file/key so it is not encoded twice; the readable versioned header is committed LAST.
struct BinaryLivingSave:
    schema = 3
    cargo_version = 1
    # Same raw deflate body; version3 also identifies the browser's wide byte store.
    encoding = 3
    valid = true
    generation: int
    terrain_key: int
    world_bytes: int
    packed_bytes: int
    world_hash: u64
    presentation: PresentationState

pack_binary_living_save = (game: SaveGame) -> (BinaryLivingSave,str):
    text=to_text(game.world); packed=deflate(bytes(text))
    (BinaryLivingSave(generation=game.generation,terrain_key=game.terrain_key,world_bytes=text.len(),packed_bytes=packed.len(),world_hash=hash(text),presentation=game.presentation),str_from_bytes(packed))

unpack_binary_living_save = (header: BinaryLivingSave, body: str) -> SaveGame?:
    if not header.valid or header.schema!=3 or (header.encoding!=2 and header.encoding!=3) or header.cargo_version!=1 or header.world_bytes<1 or header.world_bytes>64000000 or header.packed_bytes<1 or header.packed_bytes>16000000 or body.len()!=header.packed_bytes: return none
    raw=inflate(bytes(body)) ?? return none
    if raw.len()!=header.world_bytes: return none
    text=str_from_bytes(raw)
    if hash(text)!=header.world_hash: return none
    world=from_text[World](text)
    if world is TextError: return none
    SaveGame(schema=3,valid=true,generation=header.generation,terrain_key=header.terrain_key,world=world,presentation=header.presentation)
