# What the player sees of the war: a title card when they come upon a named battle, and the
# war as they have heard of it, laid over the chart (held ports, cordons, battles and naval
# actions, and declarations). Reads the living world's received knowledge; never changes it.
use 'hud.jo'
use 'chart.jo'
use 'calendar.jo'
use 'panels.jo'
import 'living_types.jo' as data
import 'living_world.jo' as living
import 'living_far_news.jo' as far_news

const BATTLE_CARD_SECONDS = 7.0
const BATTLE_SIGHT = 6000.0

MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

# "5 June" (with_year: "5 June 1929"), from a game minute
war_date = (minute: int, with_year: bool = false) -> str:
    d = calendar_date(data.day_index(minute))
    if with_year: "{d.day} {MONTHS[d.month - 1]} {d.year}" else: "{d.day} {MONTHS[d.month - 1]}"

# the inks a country is drawn in on the chart
country_ink = (country: int, a: f64 = 1.0) -> vec4:
    match country:
        1: rgba(0.64, 0.16, 0.11, f32(a))
        2: rgba(0.14, 0.25, 0.52, f32(a))
        _: rgba(0.27, 0.4, 0.2, f32(a))

country_name = (w: data.World, country: int) -> str:
    if country >= 0 and country < w.countries.len(): w.countries[country].name else: "unknown"

# the place nearest a point (-1: none)
nearest_war_place = (w: data.World, at: vec3) -> int:
    best = -1; dist = 1.0e30
    loop id in w.far.place_ids:
        if not (id in w.place_contexts): continue
        d = f64(length(w.place_contexts[id].center - at))
        if d < dist: best = id; dist = d
    best

_place_name = (w: data.World, id: int) -> str: if id in w.place_contexts: w.place_contexts[id].name else: "?"

# ---------------- the battle title card ----------------

# A battle the player has been at, as the chart remembers it for this session.
struct SeenBattle:
    engagement: int
    name: str
    pos: vec3
    minute: int

struct BattleCard:
    shown: {int: bool}              # engagement keys whose card was shown
    name = ""
    line = ""
    since = -1000.0
    seen: SeenBattle[]

# Once a named battle is in sight, its card shows once. Returns true when a new card starts.
battle_card_step = (card: mut BattleCard, w: data.World, observer: vec3, t: f64) -> bool:
    if t - card.since < BATTLE_CARD_SECONDS: return false
    loop e in living.war_engagements(w, observer, BATTLE_SIGHT):
        if e.engagement in card.shown: continue
        if let name = e.name:
            card.shown[e.engagement] = true
            place = nearest_war_place(w, e.pos)
            card.name = name
            card.line = if place >= 0: "{_place_name(w, place)},  {war_date(e.started, true)}" else: war_date(e.started, true)
            card.since = t
            card.seen.push(SeenBattle(e.engagement, name, e.pos, e.started))
            return true
    false

# the card: the battle's name in large type, the place and date under it; fades in and out
draw_battle_card = (fonts: Fonts, card: BattleCard, t: f64):
    age = t - card.since
    if age < 0.0 or age > BATTLE_CARD_SECONDS or card.name == "": return
    a = smoothstep(0.0, 1.2, age) * (1.0 - smoothstep(BATTLE_CARD_SECONDS - 1.8, BATTLE_CARD_SECONDS, age))
    if a <= 0.0: return
    sw = f64(screen_width()); sh = f64(screen_height())
    cx = sw * 0.5; cy = sh * 0.34
    # (a soft dark band behind, so the words read over bright sky or sea)
    band = 150.0
    loop k in 0..12:
        f = f64(k) / 11.0
        rect(0, cy - band * 0.5 + f * band - band * 0.04, sw, band / 12.0 + 1.0, rgba(0.02, 0.03, 0.05, f32(a * 0.32 * (1.0 - abs(f - 0.5) * 1.9))))
    set_font(fonts.title)
    big = min(64.0, 64.0 * sw * 0.86 / max(text_width(card.name, 64), 1.0))
    text_centered(card.name, vec2(f32(cx + 3), f32(cy + 4)), big, rgba(0.02, 0.03, 0.06, f32(a * 0.45)))
    text_centered(card.name, vec2(f32(cx), f32(cy)), big, rgba(1, 0.97, 0.9, f32(a)))
    set_font(fonts.ui)
    small = min(22.0, 22.0 * sw * 0.8 / max(text_width(card.line, 22), 1.0))
    ly = cy + big * 0.5 + 24.0
    lw = text_width(card.line, small)
    rule = rgba(1, 0.97, 0.9, f32(a * 0.6))
    line(vec2(f32(cx - lw * 0.5 - 70.0), f32(ly)), vec2(f32(cx - lw * 0.5 - 18.0), f32(ly)), 1.2, rule)
    line(vec2(f32(cx + lw * 0.5 + 18.0), f32(ly)), vec2(f32(cx + lw * 0.5 + 70.0), f32(ly)), 1.2, rule)
    text_centered(card.line, vec2(f32(cx + 2), f32(ly + 2)), small, rgba(0.02, 0.03, 0.06, f32(a * 0.4)))
    text_centered(card.line, vec2(f32(cx), f32(ly)), small, rgba(1, 0.97, 0.9, f32(a * 0.92)))
    set_font()

# ---------------- the war on the chart ----------------

struct WarMark:
    kind: str                       # "held", "fighting", "cordon", "battle", "action"
    pos: vec3
    label: str
    note: str                       # "reported 5 June", "seen 6 June"
    country: int = -1               # whose ink: the holder, the cordon's, the victor's
    minute: int = -1

struct WarChart:
    minute = -1
    marks: WarMark[]
    news: str[]                     # declarations and armistices heard of, for the margin

# "near 1234, -5678." at the end of a battle account: where it was fought
battle_report_pos = (text: str) -> vec3?:
    k = last_index_of(text, " near ") ?? -1
    if k < 0: return none
    tail = text[(k + 6)..text.len()]
    if tail.ends_with("."): tail = tail[0..(tail.len() - 1)]
    parts = tail.split(", ")
    if parts.len() != 2: return none
    if let x = to_float(parts[0]):
        if let z = to_float(parts[1]): return vec3(f32(x), 0, f32(z))
    none

# a battle account's title, before its ": " (none for an unnamed action)
battle_report_name = (text: str) -> str?:
    k = text.index_of(": ") ?? -1
    if k > 0 and text.starts_with("Battle"): return text[0..k]
    none

_heard = (observed: int, learned: int, local: bool) -> str:
    if local: return "seen {war_date(observed)}"
    if learned >= 0 and data.day_index(learned) != data.day_index(observed): "{war_date(observed)}, heard {war_date(learned)}"
    else: "reported {war_date(observed)}"

# What the player knows of the war: their received reports and what they have seen, never the
# world's current truth. Cached by game minute (call when the chart opens or the minute turns).
war_chart_data = (w: data.World, actor: int, seen: SeenBattle[]) -> WarChart:
    out = WarChart(minute = w.minute)
    if actor < 0 or actor >= w.people.len(): return out
    loop v in living.war_places(w, actor):
        if not (v.place in w.place_contexts): continue
        at = w.place_contexts[v.place].center
        local = v.confidence >= 1000 and v.observed_minute == w.minute
        if v.controller >= 0 and v.controller != v.sovereign:
            out.marks.push(WarMark("held", at, "Held by {country_name(w, v.controller)}", _heard(v.observed_minute, v.learned_minute, local), v.controller, v.observed_minute))
        else if v.danger >= 650 and v.observed_minute >= 0 and not v.reason.contains("cordon"):
            out.marks.push(WarMark("fighting", at, "Fighting reported", _heard(v.observed_minute, v.learned_minute, local), -1, v.observed_minute))
    named: {str: bool}
    loop s in seen:
        named[s.name] = true
        out.marks.push(WarMark("battle", s.pos, s.name, "seen {war_date(s.minute)}", -1, s.minute))
    loop r in w.people[actor].far_reports:
        if not far_news.far_report_current(w, r): continue
        if r.kind == "blockade":
            if r.origin in w.place_contexts:
                out.marks.push(WarMark("cordon", w.place_contexts[r.origin].center, "Cordon by {country_name(w, r.country)}", _heard(r.occurred_minute, r.learned_minute, false), r.country, r.occurred_minute))
        else if r.kind == "battle":
            at = battle_report_pos(r.text) ?? (if r.origin in w.place_contexts: w.place_contexts[r.origin].center else: vec3(0, 0, 0))
            if let name = battle_report_name(r.text):
                if name in named: continue
                named[name] = true
                out.marks.push(WarMark("battle", at, name, "{country_name(w, r.country)} won, {war_date(r.occurred_minute)}", r.country, r.occurred_minute))
            else:
                out.marks.push(WarMark("action", at, "Naval action", "{country_name(w, r.country)} won, {war_date(r.occurred_minute)}", r.country, r.occurred_minute))
    loop rel in living.war_relations(w, actor):
        if not rel.known: continue
        what = if rel.stage == .war: "at war since" else: "armistice signed"
        out.news.push("{country_name(w, rel.a)} and {country_name(w, rel.b)}: {what} {war_date(rel.occurred_minute)} (heard {war_date(rel.learned_minute)})")
    out

# a dashed ring
_dashed_ring = (c: vec2, r: f64, width: f64, col: vec4, dashes: int = 16):
    loop k in 0..dashes:
        a0 = f64(k) / f64(dashes) * TAU
        arc(c, r, width, a0, a0 + TAU / f64(dashes) * 0.55, col)

# crossed swords, the old map sign for a battle
_battle_sign = (p: vec2, s: f64, col: vec4, width: f64):
    line(p + vec2(f32(-s), f32(-s)), p + vec2(f32(s), f32(s)), width, col)
    line(p + vec2(f32(s), f32(-s)), p + vec2(f32(-s), f32(s)), width, col)
    line(p + vec2(f32(-s * 0.95), f32(s * 0.35)), p + vec2(f32(-s * 0.35), f32(s * 0.95)), width, col)
    line(p + vec2(f32(s * 0.95), f32(s * 0.35)), p + vec2(f32(s * 0.35), f32(s * 0.95)), width, col)

# metres to chart pixels, at least `least`
_chart_metres = (r: Rect, m: f64, least: f64) -> f64:
    a = chart_point(r, 0.0, 0.0); b = chart_point(r, m, 0.0)
    max(least, f64(b.x - a.x))

# The war layer, inside the chart's rect: only where the owned sheets cover the ground.
draw_war_layer = (r: Rect, d: WarChart):
    ink = rgba(0.22, 0.17, 0.13, 0.95)
    clip(r)
    labels: vec4[]
    # (areas underneath, signs over them, the newest last so it lies on top)
    marks = d.marks
    marks.sort((m: WarMark): (if m.kind == "held" or m.kind == "fighting": 0 else: (if m.kind == "cordon": 1 else: 2), m.minute))
    loop m in marks:
        if not charted(f64(m.pos.x), f64(m.pos.z)): continue
        p = chart_point(r, f64(m.pos.x), f64(m.pos.z))
        size = 9.0
        match m.kind:
            "held":
                rad = _chart_metres(r, 1400.0, 16.0)
                circle(p, rad, country_ink(m.country, 0.16))
                # (hatched across, in the holder's ink)
                loop k in -4..5:
                    o = f64(k) * rad * 0.42
                    h = sqrt(max(0.0, rad * rad - o * o * 0.5)) * 0.7
                    line(p + vec2(f32(o - h), f32(h)), p + vec2(f32(o + h), f32(-h)), 1.0, country_ink(m.country, 0.35))
                _dashed_ring(p, rad, 1.6, country_ink(m.country, 0.8))
                size = rad
            "fighting":
                rad = _chart_metres(r, 1400.0, 16.0)
                _dashed_ring(p, rad, 1.6, rgba(0.6, 0.14, 0.1, 0.8), 10)
                size = rad
            "cordon":
                rad = _chart_metres(r, 2200.0, 22.0)
                _dashed_ring(p, rad, 2.2, country_ink(m.country, 0.85), 24)
                size = rad
            "battle":
                _battle_sign(p, 7.0, rgba(0.55, 0.1, 0.08, 0.95), 2.2)
            _:
                _battle_sign(p, 4.5, rgba(0.3, 0.2, 0.15, 0.85), 1.4)
                size = 6.0
        # its name, beside it; a later label yields to one already there
        font = if m.kind == "battle": 14.0 else: 12.0
        width = max(text_width(m.label, font), text_width(m.note, 11.0))
        at = vec2(f32(clamp(f64(p.x) + size * 0.7 + 4.0, r.x + 6.0, r.x + r.w - width - 6.0)), f32(clamp(f64(p.y) + size * 0.5, r.y + 42.0, r.y + r.h - font - 22.0)))
        blocked = false
        loop q in labels:
            if at.x < q.x + q.z + 4.0 and at.x + f32(width) + 4.0 > q.x and at.y < q.y + q.w + 2.0 and at.y + f32(font + 14.0) + 2.0 > q.y: blocked = true
        if blocked: continue
        labels.push(vec4(at.x, at.y, f32(width), f32(font + 14.0)))
        col = if m.kind == "battle": rgba(0.5, 0.09, 0.07, 1) else: (if m.kind == "held" or m.kind == "cordon": country_ink(m.country, 1.0) else: ink)
        text(m.label, at, font, col)
        text(m.note, at + vec2(0, f32(font + 1.0)), 11, rgba(0.22, 0.17, 0.13, 0.75))
    no_clip()
    # declarations and armistices heard of, in the lower margin
    y = r.y + r.h - 56.0
    loop k in 0..d.news.len():
        n = d.news[d.news.len() - 1 - k]
        text(n, vec2(f32(r.x + 14), f32(y - f64(k) * 18.0)), 13, ink)

# the button that shows or hides the war layer, at the chart's top left; returns the new state
war_layer_button = (r: Rect, on: bool, count: int) -> bool:
    global hud_style
    saved = hud_style
    hud_style.text_size = 14
    hud_style.button = rgba(0.14, 0.17, 0.22, 0.85)
    hud_style.hover = rgba(0.22, 0.27, 0.34, 1)
    label = if count > 0: "War news ({count})" else: "War news"
    flip = hud_button(Rect(r.x + 10.0, r.y + 10.0, 150.0, 28.0), label, selected = on)
    hud_style = saved
    if flip: not on else: on

# ---------------- military contracts at a port ----------------

# Board notice ids for military contracts lie far below the race notices' small negatives.
const MILITARY_NOTICE_BASE = -1000000

mission_of_notice = (id: int) -> int: if id <= MILITARY_NOTICE_BASE: MILITARY_NOTICE_BASE - id else: -1

# the living world's district for one of the six home harbors (core place index)
core_district = (w: data.World, place: int) -> int:
    loop id in w.far.place_ids:
        if id in w.far.districts and w.far.districts[id].core == place: return id
    if place in w.far.districts: place else: -1

_kind_word = (k: living.far_data.CommissionKind) -> str:
    match k:
        .escort: "Escort"
        .reconnaissance: "Reconnaissance"
        .rescue: "Rescue"
        .mail: "Dispatches"
        .smuggling: "Blockade running"
        _: "Freight"

contract_title = (w: data.World, m: living.MissionView) -> str: "{_kind_word(m.kind)} for {country_name(w, m.country)}"

find_mission = (w: data.World, id: int) -> living.MissionView?:
    loop m in living.military_work(w):
        if m.id == id: return m
    none

# The office's open contracts at this district (less those declined), then the player's own
# contracts that report here, as notices on the board.
military_notices = (w: data.World, district: int, actor: int, declined: {int: bool}, clock: (int) -> str) -> Notice[]:
    out: Notice[]
    if district < 0: return out
    office = "{_place_name(w, district)} office"
    loop m in living.military_work(w, district):
        if m.state != .open or w.minute > m.deadline or m.id in declined: continue
        out.push(Notice(MILITARY_NOTICE_BASE - m.id, "{country_name(w, m.country)}, {office}", contract_title(w, m), m.why, m.reward / 100, "by {clock(m.deadline)}"))
    loop m in living.military_work(w, -1, actor):
        if m.state != .claimed or (m.destination != district and m.origin != district): continue
        out.push(Notice(MILITARY_NOTICE_BASE - m.id, "your contract", contract_title(w, m), m.why, m.reward / 100, "by {clock(m.deadline)}", pay_text = "Yours: {m.reward / 100} lire"))
    out

# what can be said at the office about a contract: the words and their action codes
# (0 accept, 1 decline, 2 report for payment, 3 take the packet, 4 put it aboard, 5 hand it over, 6 back)
contract_answers = (w: data.World, m: living.MissionView, actor: int) -> (str[], int[]):
    words: str[]; codes: int[]
    if m.state == .open:
        words.push("Accept the contract."); codes.push(0)
        words.push("Decline it."); codes.push(1)
    else if m.state == .claimed and m.commission >= 0:
        words.push("Take the packet from the counter."); codes.push(3)
        words.push("Put it aboard my aircraft."); codes.push(4)
        words.push("Hand it over here."); codes.push(5)
    else if m.state == .claimed:
        words.push("Report for payment."); codes.push(2)
    words.push("Back to the board."); codes.push(6)
    (words, codes)

# the state of a contract, in a line for the panel
contract_status = (w: data.World, m: living.MissionView) -> str:
    pay = "{f64(m.reward) / 100.0:.2} lire"
    match m.state:
        .open: "Payment {pay}."
        .claimed:
            if m.kind == .escort: "Accepted. Escorted {m.progress / 1000} of {m.required / 1000} m."
            else if m.kind == .reconnaissance: "Accepted. Observed {m.progress} of {m.required} ticks over the target."
            else: "Accepted. Payment {pay} on report."
        .completed: "Completed and paid."
        .failed: "Failed."
        _: "Expired."

# do what was chosen; returns the line the office says back
contract_act = (w: mut data.World, id: int, code: int, actor: int) -> str:
    match code:
        0: if living.claim_military_work(w, id, actor, .player): "Signed. The terms are in your notebook." else: "The office will not sign it now: stand at the counter, finish your other sortie, or mend your standing with them."
        2: if living.report_military_work(w, id, actor): "Paid in full." else: "Not yet: the office needs the work done, you at its counter, and your aircraft down."
        3: if living.pickup_commission(w, m_commission(w, id), actor): "You have the packet." else: "The packet is not here for you to take, or your hands are full."
        4: if living.load_commission(w, m_commission(w, id), actor): "It is aboard." else: "Bring it beside your moored aircraft, with room in the hold."
        5: if living.collect_commission(w, m_commission(w, id), actor): "Received. The office pays on delivery." else: "This is not where it is to be handed over."
        _: ""

m_commission = (w: data.World, id: int) -> int:
    if let m = find_mission(w, id): m.commission else: -1
