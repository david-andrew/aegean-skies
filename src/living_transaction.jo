# A copy-on-write checkpoint only at an outer, infrequent mutation boundary. Nested cargo,
# cash and reward operations share it. No per-frame motion snapshot and no fabricated balancing
# entries: a failed transaction restores the actual prior World, including sources and escrow.
use 'living_types.jo'
use 'living_guard.jo'

struct WorldGuard:
    previous: World? = none
    epoch = 0
    active = false

_guard_depth = 0
_guard_outer_epoch = 0

guard_blocked = () -> bool: not living_strict() and _guard_depth>0 and living_fault_epoch()!=_guard_outer_epoch

guard_begin = (w: World) -> WorldGuard:
    global _guard_depth, _guard_outer_epoch
    if living_strict(): return WorldGuard()
    root = _guard_depth == 0
    if root: _guard_outer_epoch = living_fault_epoch()
    _guard_depth += 1
    WorldGuard(if root: w else: none,living_fault_epoch(),true)

guard_failed = (scope: WorldGuard) -> bool: scope.active and living_fault_epoch()!=scope.epoch

guard_finish = (w: mut World, scope: WorldGuard):
    global _guard_depth
    if not scope.active: return
    _guard_depth = max(0,_guard_depth-1)
    if guard_failed(scope):
        if let old = scope.previous: w = old

guard_context = (w: World) -> str:
    cash = 0
    loop account in w.accounts: cash += account.cents
    "seed={w.seed} tick={w.tick} minute={w.minute} cash={cash}/{w.ledger.opening_cents+w.ledger.external_in_cents-w.ledger.external_out_cents} jobs={w.active_jobs.len()} trips={w.active_trips.len()} cargo={w.cargo.len()}"
