# The barber at the Hotel Ancora's corner of the waterfront: a shave and a trim, and the pilot's
# mustache shaped as he likes it (or shaved off). Stavros is the hotel's barber, like its band: the
# house takes the money, by one transfer into the keeper's purse, so the world's money holds. He
# talks while he works: the weather, the band, whatever the waterfront is saying.
#
# The style is one of the figures' own mustaches (src/folk.jo): 0 clean-shaven, 1 a handlebar,
# 2 a walrus, 3 a chevron. It is kept with the game (GameSession.mustache).

use 'phoenix.jo'
use 'living_types.jo'
use 'living_money.jo'
use 'living_text.jo'
use 'living_news.jo'
use 'living_talk_words.jo'
import 'living_conditions.jo' as conditions

const BARBER_NAME = "Stavros"
const BARBER_SHAVE_CENTS = 40       # a shave and a trim, keeping the style
const BARBER_STYLE_CENTS = 70       # a new shape (or the whole thing off)
const BARBER_MINUTES = 25
const BARBER_OPENS = 480            # 08:00 to 19:00, local minutes
const BARBER_CLOSES = 1140

BARBER_STYLES: str[] = ["Clean-shaven", "A handlebar", "A walrus", "A chevron"]

struct BarberResult:
    ok: bool
    message: str
    cents = 0

barber_open = (w: World) -> bool:
    m = local_minute(w.minute)
    m >= BARBER_OPENS and m < BARBER_CLOSES

barber_price = (from: int, to: int) -> int: if from == to: BARBER_SHAVE_CENTS else: BARBER_STYLE_CENTS

# The pilot pays the house for the barber's work: one transfer, or nothing.
barber_pay = (w: mut World, keeper: int, from: int, to: int) -> BarberResult:
    p = w.player
    if not barber_open(w): return BarberResult(false, "The chair is empty; he works from eight until seven.")
    if keeper < 0 or keeper >= w.people.len(): return BarberResult(false, "Nobody to pay.")
    a = w.people[p].account; k = w.people[keeper].account
    if not account_valid(w, a) or not account_valid(w, k): return BarberResult(false, "Nobody to pay.")
    cents = barber_price(from, to)
    if w.accounts[a].cents < cents: return BarberResult(false, "That's {phoenix_text(cents)}, and you haven't got it.", cents)
    if not transfer(w, a, k, cents, .trade): return BarberResult(false, "Nobody to pay.")
    BarberResult(true, "{phoenix_text(cents)} to the house.", cents)

# What he says as one sits down, as he works and when he has done.
barber_greeting = (style: int, n: int) -> str:
    lines = if style == 0: ["Sit, sit. A clean face again, or are we growing something this time?", "Ah, the clean-shaven pilot. Sit down."] else: if style == 2: ["Sit down. That walrus needs taking in hand.", "The walrus is back. Sit, I'll find it a mouth."] else: if style == 3: ["Sit. The chevron's lost its edges; we'll put them back.", "A neat man. Sit, sit."] else: ["Sit down, sit down. That handlebar's been in the wind.", "The handlebar! Sit. Let's see what the wind did to it."]
    lines[n % lines.len()]

barber_style_words = (from: int, to: int) -> str:
    if from == to: return ["Just a shave and the edges tidied. Easy.", "As it is, then. A good choice; it suits you."][from % 2]
    match to:
        0: "All of it? Well. You'll look ten years younger and twice as surprised."
        1: "A handlebar: wax for the tips, and you'll have to keep them up yourself."
        2: "A walrus. Very distinguished. Soup will be a problem."
        3: "A chevron, short and square. Like a schoolmaster with an aeroplane."
        else: "As you like."

barber_done = (to: int, n: int) -> str:
    lines = if to == 0: ["There. Smooth as a plate. Feel that.", "Done. Your own mother wouldn't know you."] else: ["There. Have a look.", "Done. Not bad, eh? Look in the glass."]
    lines[n % lines.len()]

# Small talk while the razor goes: the weather here, the hotel's band, and what the town is saying.
barber_chat = (w: World, place: int, n: int) -> str:
    talk: str[]
    if place >= 0 and place < w.harbors.len():
        wind = conditions.wind_at(w, w.harbors[place].center)
        from = if abs(wind.x) > abs(wind.z): (if wind.x > 0: "west" else: "east") else: (if wind.z > 0: "north" else: "south")
        talk.push("Wind today? {_up(say_wind(f64(length(wind)) * 1.944, from))}. Good for drying nets, bad for hats.")
    talk.push("The band at the hotel tonight, you'll hear it from here. I keep the door open.")
    if place >= 0 and place < w.places.len():
        loop item in w.places[place].news:
            if item.private_fact or item.confidence < 600 or item.kind == .met: continue
            talk.push("They're saying on the waterfront: {news_sentence(w, item).replace("Heard: ", "")}")
            break
    talk.push("Hold still. Pilots never hold still.")
    talk[n % talk.len()]

_up = (s: str) -> str: if s.len() == 0: s else: s[0..1].upper() + s[1..s.len()]
