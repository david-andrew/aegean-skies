# The harbour launch: a small motor boat that takes the pilot between a dock and their aircraft
# moored offshore (src/offshore_moorings.jo). The ride is seen (the launch drawn crossing the
# harbour, the camera behind it) or cut (the clock runs on behind a dark card); either way it
# ends with the pilot aboard, or on the quay. A small fare to the harbour, through the ledger.
# The launch is the canal launch's own model (src/vessel_models.jo); the buoys are drawn here.
use 'world_point.jo'
use 'offshore_moorings.jo'
use 'vessel_models.jo'
use 'objects.jo'
use 'sea.jo'
use 'look.jo'
import 'living_types.jo' as lt
from 'living_money.jo' import transfer, account_valid, money_balances

const LAUNCH_FARE = 150             # cents a trip (¤1.50), paid to the harbour
const LAUNCH_SPEED = 4.2            # m/s through the water: about eight knots
const LAUNCH_SHOWN_SPEED = 11.0     # m/s as shown: the ride seen is the trip at a little under 3x

struct LaunchRide:
    active = false
    outward = true                  # out to the aircraft (true) or back to the dock
    place = -1                      # the harbour
    from: vec3                      # the dock berth (outward) or alongside the aircraft (back)
    to: vec3
    side: vec3                      # where alongside: the aircraft's boarding side, flat
    t = 0.0                         # seconds of the seen ride so far
    duration = 1.0
    minutes = 1                     # how long the trip takes in the world
    fare = 0                        # cents paid for this trip

# A ride from a dock out to an aircraft lying at `craft` (its exit point given, to come alongside),
# or back from it to the dock.
launch_ride = (place: int, dock: vec3, alongside: vec3, outward: bool) -> LaunchRide:
    a = vec3(dock.x, 0, dock.z); b = vec3(alongside.x, 0, alongside.z)
    d = f64(length(b - a))
    r = LaunchRide(active = true, outward = outward, place = place, from = if outward: a else: b, to = if outward: b else: a)
    r.duration = clamp(d / LAUNCH_SHOWN_SPEED, 6.0, 40.0)
    r.minutes = max(1, int(ceil(d / LAUNCH_SPEED / 60.0)) + 2)     # (and the boatman casting off)
    r

# where the launch is and which way it heads (a world turn, the vessels' convention: bow +z)
launch_pose = (r: LaunchRide) -> (vec3, f64):
    u = clamp(r.t / max(r.duration, 0.1), 0.0, 1.0)
    k = u * u * (3.0 - 2.0 * u)
    d = r.to - r.from
    # (a slight curve, so it leaves the berth and comes alongside on a line, not a beeline)
    side = normalize(vec3(-d.z, 0, d.x) + vec3(0.0001, 0, 0))
    p = r.from + d * f32(k) + side * f32(sin(k * PI) * min(f64(length(d)) * 0.08, 25.0))
    ahead = r.from + d * f32(min(1.0, k + 0.02)) + side * f32(sin(min(1.0, k + 0.02) * PI) * min(f64(length(d)) * 0.08, 25.0))
    dir = ahead - p
    if f64(length(dir)) < 0.001: dir = d
    (p, atan2(f64(dir.x), f64(dir.z)))

launch_done = (r: LaunchRide) -> bool: r.t >= r.duration

# The harbour's account a fare goes to: its market (the six old harbours) or its district's.
harbour_account = (w: lt.World, place: int) -> int:
    if place >= 0 and place < w.places.len(): return w.places[place].market.account
    if place in w.far.districts: return w.far.districts[place].market_account
    -1

# The fare for one trip, paid now: what was paid (0 when the purse or the harbour can't: the
# boatman lets it go).
pay_launch = (w: mut lt.World, place: int) -> int:
    payer = w.people[w.player].account
    to = harbour_account(w, place)
    if not account_valid(w, payer) or not account_valid(w, to) or payer == to: return 0
    if w.accounts[payer].cents < LAUNCH_FARE: return 0
    if transfer(w, payer, to, LAUNCH_FARE, .departure): LAUNCH_FARE else: 0

# ---------------- drawn ----------------

struct LaunchView:
    boat: Mesh
    buoy: Mesh
    ready = false

_buoy_vertices = () -> Vertex3D[]:
    vs: Vertex3D[]
    red = rgb(0.72, 0.16, 0.12); white = rgb(0.93, 0.91, 0.84); dark = rgb(0.16, 0.15, 0.14)
    add_cylinder(vs, vec3(0, -0.6, 0), 0.75, 0.65, red, 12, 0.85)
    add_cylinder(vs, vec3(0, 0.05, 0), 0.85, 0.35, white, 12, 0.55)
    add_cylinder(vs, vec3(0, 0.4, 0), 0.55, 0.3, red, 12, 0.3)
    add_cylinder(vs, vec3(0, 0.7, 0), 0.06, 1.1, dark, 6, 0.06)
    add_box(vs, vec3(0, 1.75, 0), vec3(0.5, 0.06, 0.06), dark)
    vs

launch_view_init = (v: mut LaunchView):
    if v.ready: return
    v.boat = custom_mesh(vessel_vertices(.canal_launch))
    v.buoy = custom_mesh(_buoy_vertices())
    v.ready = true

# the launch on the swell (within draw_custom)
draw_launch = (v: mut LaunchView, r: LaunchRide, L: Light, t: f64):
    if not r.active: return
    launch_view_init(v)
    pose = launch_pose(r)
    p = pose.0
    sw = swell_at(f64(p.x), f64(p.z), t)
    roll = sin(t * 1.3) * 0.03 + sin(t * 2.1) * 0.015
    pitch = -0.06 * clamp(r.t, 0.0, 1.0) * clamp(r.duration - r.t, 0.0, 1.0)
    at = rotation_y(pose.1) * rotation_x(pitch) * rotation_z(roll)
    draw(obj_sh, v.boat, obj_params(L, t, at, anchor = world_point(vec3(p.x, sw.x, p.z))))

# a mooring buoy riding the swell (the point where the line is made fast: buoy_top)
draw_buoy = (v: mut LaunchView, at: vec3, L: Light, t: f64):
    launch_view_init(v)
    sw = swell_at(f64(at.x), f64(at.z), t)
    tilt = rotation_x(sin(t * 0.9 + f64(at.x)) * 0.06) * rotation_z(sin(t * 1.1 + f64(at.z)) * 0.06)
    draw(obj_sh, v.buoy, obj_params(L, t, tilt, anchor = world_point(vec3(at.x, sw.x, at.z))))

buoy_top = (at: vec3) -> vec3: vec3(at.x, 0.5, at.z)

# The seen ride's camera: behind and above the launch, a little to one side, looking past it
# toward where it is going. Returns the eye and the point looked at.
launch_camera = (r: LaunchRide) -> (vec3, vec3):
    pose = launch_pose(r)
    p = pose.0
    dir = vec3(f32(sin(pose.1)), 0, f32(cos(pose.1)))
    side = vec3(dir.z, 0, -dir.x)
    eye = p - dir * 16.0 + side * 6.0 + vec3(0, 6.5, 0)
    look = mix(p + dir * 20.0, r.to, 0.35) + vec3(0, 3.0, 0)
    (eye, look)

# (captures and tests: the world's cash still adds up)
ledger_balances = (w: lt.World) -> bool: money_balances(w)
