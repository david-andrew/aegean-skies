# Work referrals are carried statements, not a view of the town's notice board.
use 'living_types.jo'
use 'life_types.jo'

work_offer_snapshot = (w: World, job: int, speaker: int) -> WorkLead?:
    if not (job in w.jobs) or speaker < 0 or speaker >= w.people.len(): return none
    j = w.jobs[job]
    if j.poster == speaker:
        if j.state != .open: return none
        return WorkLead(j.id,j.poster,j.origin,j.destination,j.good,j.quantity,j.reward_cents,w.minute,speaker,j.delivery_mode == .foot)
    loop lead in w.speech.get(speaker,SpeechLedger()).work_leads:
        if lead.job == job and w.minute-lead.heard_minute < 4320: return lead
    none

remember_work_offer = (w: mut World, listener: int, speaker: int, job: int) -> bool:
    if listener < 0 or listener >= w.people.len() or listener == speaker: return false
    if w.people[listener].place < 0 or w.people[listener].place != w.people[speaker].place: return false
    lead = work_offer_snapshot(w,job,speaker)
    if lead == none: return false
    next = lead!; next.source_person = speaker
    if not (listener in w.speech): w.speech[listener] = SpeechLedger()
    loop old in w.speech[listener].work_leads:
        # A retelling never refreshes the original observation, nor multiplies hearsay.
        if old.job == job and old.heard_minute >= next.heard_minute: return false
    keep = [loop old in w.speech[listener].work_leads: if old.job != job and w.minute-old.heard_minute < 4320: old]
    keep.push(next)
    keep.sort_by((l: WorkLead): (l.heard_minute,l.job))
    if keep.len()>12: keep.remove_at(0)
    w.speech[listener].work_leads = keep
    true

exchange_work_offers = (w: mut World, a: int, b: int):
    # Actual meetings exchange at most one known offer each way. Mere residence is not hearing.
    loop pair in [(a,b),(b,a)]:
        own = -1
        loop id in w.active_jobs:
            if w.jobs[id].poster == pair.0 and w.jobs[id].state == .open: own = id; break
        if own >= 0: remember_work_offer(w,pair.1,pair.0,own)
