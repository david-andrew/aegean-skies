# The period engines (a trial: tweaks.period_engines). Each aircraft's own engine, from what it
# really had: how many cylinders and how laid out (a rotary, a radial, an inline or V, a broad
# arrow W), its turning speed, its reduction gear and its propeller's blades. Heard as:
#   the exhaust: a pulse at every firing (cylinders/2 a turn), each a short crack rung through its
#     stacks' resonance, the cylinders a little unlike one another, so the beat repeats every two
#     turns (a radial's rumble, a V-12's snarl); hard and bright on load, soft and ragged on the
#     overrun, a rotary's open ports raspy and its blip switch cutting it in and out at low power
#   the propeller: its blades passing, a "whup" of harmonics, and at speed the tips' buzz-saw noise
#     growing with their speed through the air
#   pops and crackle from the stacks when the throttle comes back, and on a gliding approach
# Loops are baked once for the aircraft at a reference turning speed (whole cycles in a second, so
# they loop clean) and set_pitch follows the turning speed: firing, blade-pass and their harmonics
# move together, as they do. Nothing recorded: all made here.
use 'airsound.jo'
use 'aircraft_catalog.jo'
from 'planes.jo' import Craft, aircraft_profile

enum EngineLayout: rotary, radial, inline, arrow

struct EngineSpec:
    layout: EngineLayout = .radial
    cylinders = 9
    rpm = 1900.0                    # the crankshaft at cruise
    idle = 500.0
    gear = 1.0                      # propeller turns per crankshaft turn
    blades = 2
    stacks = 450.0                  # the exhaust's ring, Hz (short racing stubs high, a collector ring low)
    count = 1                       # engines heard

# The real engines of the historical types (approximate period figures); the game's own designs by
# their voice, their tone setting the turning speed a little.
engine_spec = (kind: Craft) -> EngineSpec:
    p = aircraft_profile(kind)
    many = max(1,if p.engines > 0: p.engines else: (if p.push_pull or p.engine_x > 0.0 or p.voice == .twin: 2 else: 1))
    match kind:
        .macchi_mc72: EngineSpec(.inline,24,3300,700,0.5,2,950,2)          # Fiat AS.6: two V-12s in tandem, contra-props
        .sm_s65: EngineSpec(.inline,12,2500,600,0.66,2,820,2)               # two Isotta-Fraschini V-12s, push-pull
        .piaggio_p7: EngineSpec(.arrow,18,2400,600,0.7,2,760,1)             # an Isotta-Fraschini W-18
        .macchi_m33: EngineSpec(.inline,12,2300,550,1.0,2,700,1)            # Curtiss D-12
        .curtiss_r3c2: EngineSpec(.inline,12,2400,550,1.0,2,760,1)          # Curtiss V-1400
        .supermarine_s6b: EngineSpec(.inline,12,3200,700,0.605,2,900,1)     # Rolls-Royce R
        .sea_lion_ii: EngineSpec(.arrow,12,2300,550,0.66,2,620,1)           # Napier Lion
        .sm_s55: EngineSpec(.inline,12,1900,500,1.0,2,560,2)                # two Isotta Asso V-12s, push-pull
        .dornier_wal: EngineSpec(.arrow,12,2000,500,0.66,2,560,2)           # two Napier Lions, push-pull
        .dornier_dox: EngineSpec(.radial,9,1700,450,1.0,2,420,12)           # twelve Bristol Jupiters
        .hughes_h4: EngineSpec(.radial,28,2550,600,0.381,4,380,8)           # eight P&W R-4360s
        .short_sarafand: EngineSpec(.inline,12,2300,550,0.553,2,600,6)      # six Rolls-Royce Buzzards
        .macchi_m5: EngineSpec(.inline,6,1450,450,1.0,2,520,1)              # Isotta-Fraschini V.4B
        .hansa_cc: EngineSpec(.inline,6,1400,450,1.0,2,500,1)               # Hiero / Benz six
        .macchi_m7: EngineSpec(.inline,6,1600,450,1.0,2,540,1)              # Isotta-Fraschini V.6
        .fiat_cr20: EngineSpec(.inline,12,2000,500,1.0,2,640,1)             # Fiat A.20
        .donnet_leveque: EngineSpec(.rotary,7,1200,500,1.0,2,1100,1)        # Gnome
        .sopwith_greek: EngineSpec(.radial,10,1200,450,1.0,2,620,1)         # Anzani ten
        .sopwith_bat_boat: EngineSpec(.radial,9,1250,450,1.0,2,560,1)       # Salmson, water-cooled
        .short_184: EngineSpec(.inline,12,2000,500,0.6,4,600,1)             # Sunbeam
        .blackburn_velos: EngineSpec(.arrow,12,2000,500,0.66,2,580,1)       # Napier Lion
        .fairey_iiif: EngineSpec(.arrow,12,2200,500,0.66,2,600,1)           # Napier Lion
        _:
            spin = 0.82+0.18*p.tone
            match p.voice:
                .rotary: EngineSpec(.rotary,9,1250*spin,500,1.0,2,1050,many)
                .inline: EngineSpec(.inline,12,2200*spin,550,0.62,2,700,many)
                .twin: EngineSpec(.radial,9,1900*spin,500,1.0,2,460,max(2,many))
                _: EngineSpec(.radial,9,1900*spin,500,1.0,2,460,many)

# (its own generator, so making these never moves the game's other sounds)
struct EngineNoise:
    s = u64(1)
engine_unit = (r: mut EngineNoise) -> f64:
    r.s += (u64(0x9E3779B9)<<32 or u64(0x7F4A7C15))
    z = r.s
    z = (z xor (z>>30))*(u64(0xBF58476D)<<32 or u64(0x1CE4E5B9))
    z = (z xor (z>>27))*(u64(0x94D049BB)<<32 or u64(0x133111EB))
    f64((z xor (z>>31))>>11)/9007199254740992.0
engine_signed = (r: mut EngineNoise) -> f64: engine_unit(r)*2.0-1.0

# whole turns a second near the cruise speed, even (an odd-cylindered engine's cycle is two turns)
engine_reference = (spec: EngineSpec) -> int: max(2,(int(spec.rpm/60.0+0.5)/2)*2)
prop_reference = (spec: EngineSpec) -> int: max(1,int(f64(engine_reference(spec))*spec.gear+0.5))

# (a mono second into a stereo loop at an rms; a second always loops clean here: whole cycles)
engine_sound_of = (m: f64[],rms: f64) -> Sound:
    sum = 0.0; top = 0.0
    loop v in m: sum += v*v; top = max(top,abs(v))
    # (at the loudness asked, its peaks kept under 0.7: a sparse, sharp loop is quieter for it)
    g = min(rms/max(sqrt(sum/f64(m.len())),1e-12),0.7/max(top,1e-12))
    out = fill(f32(0),m.len()*2)
    loop i in 0..m.len():
        out[i*2] = f32(m[i]*g); out[i*2+1] = f32(m[i]*g)
    Sound(out)

# (a sine wave by a turning phasor: a rotation a sample, no sine computed per sample; added into m)
engine_add_sine = (m: mut f64[],hz: f64,amp: f64,phase: f64):
    w = TAU*hz/f64(MIX_RATE); cw = cos(w); sw = sin(w)
    re = cos(phase); im = sin(phase)
    loop i in 0..m.len():
        m[i] += amp*im
        nr = re*cw-im*sw; im = re*sw+im*cw; re = nr
        if i%4096 == 4095:
            # (kept on the circle: rounding would otherwise wander its loudness)
            g = 1.0/sqrt(re*re+im*im); re *= g; im *= g

# The exhaust for a second at the reference speed: on load (hard, bright) or on the overrun (soft,
# ragged: firings missed, now and then one late and loud). Each cylinder's pulse (a crack rung
# through the stacks, a thump under it) is made once and laid at each of its firings.
make_exhaust = (spec: EngineSpec,load: bool,seed: int) -> Sound:
    r = EngineNoise(s = u64(seed*7919+int(spec.layout)*104729+spec.cylinders))
    n = MIX_RATE; rate = f64(MIX_RATE)
    m = fill(0.0,n)
    rev = f64(engine_reference(spec))
    cycles = int(rev/2.0)                       # (two turns a cycle)
    firings = spec.cylinders
    gap = 2.0/(rev*f64(firings))                # seconds between firings
    # each cylinder its own strength and a touch early or late, the same every cycle
    strength = [loop c in 0..firings: 1.0+0.18*engine_signed(r)]
    lean = [loop c in 0..firings: 0.06*engine_signed(r)*gap]
    open_ports = spec.layout == .rotary
    ring_hz = spec.stacks*(if load: 1.0 else: 0.8)
    ring_decay = if open_ports: 900.0 else: (if load: 260.0 else: 330.0)
    crack_decay = if load: 3000.0 else: 2000.0
    # (the pipe's own lower note: what makes a firing a bark, not a hiss)
    pipe_hz = max(spec.stacks*0.33,110.0)
    body_hz = min(rev*f64(firings)/2.0,180.0)
    length = int(rate*0.03)
    pulses: f64[][]
    loop c in 0..firings:
        phase0 = engine_unit(r)*TAU
        # (a crack of a fraction of a millisecond, the stacks ringing, the pipe's bark, a thump under it)
        pulses.push([loop k in 0..length: engine_signed(r)*exp(-f64(k)/rate*crack_decay)*(if open_ports: 0.5 else: 0.25)+sin(TAU*ring_hz*f64(k)/rate+phase0)*exp(-f64(k)/rate*ring_decay)+sin(TAU*pipe_hz*f64(k)/rate+phase0*0.5)*exp(-f64(k)/rate*140.0)*0.8+sin(TAU*body_hz*f64(k)/rate)*exp(-f64(k)/rate*90.0)*0.6])
    loop cycle in 0..cycles:
        loop c in 0..firings:
            at = (f64(cycle*firings+c))*gap+lean[c]
            level = strength[c]*(if load: 1.0 else: 0.35)
            late = 0.0
            if not load:
                pick = engine_unit(r)
                if pick < 0.12: level = 0.0                        # missed
                else if pick < 0.2: level *= 2.6; late = gap*0.3   # a pop, late
            if level <= 0.0: continue
            start = ((int((at+late)*rate))%n+n)%n
            pulse = pulses[c]
            loop k in 0..length: m[(start+k)%n] += pulse[k]*level
    # a rotary's cylinders sweep round: its sound swells once a turn; any engine's crankcase hums
    if open_ports:
        sweep = fill(0.0,n); engine_add_sine(sweep,rev,0.2,PI*0.5)
        loop i in 0..n: m[i] *= 0.8+sweep[i]
    engine_add_sine(m,rev,0.08,0.0); engine_add_sine(m,rev*2.0,0.05,0.0)
    # (a little dull: the period's own stacks and the cowling)
    f = Biquad(); lowpass(f,if load: 5500.0 else: 3500.0)
    loop i in n-4096..n: _ = filt(f,m[i])      # (warmed on the loop's end, so its start follows on)
    loop i in 0..n: m[i] = filt(f,m[i])
    engine_sound_of(m,0.1)

# The propeller's blades passing for a second at the reference speed: a "whup" of the blade rate's
# harmonics, the blades a touch unlike, so the turn itself is heard faintly.
make_prop = (spec: EngineSpec) -> Sound:
    m = fill(0.0,MIX_RATE)
    turn = f64(prop_reference(spec)); pass_hz = turn*f64(spec.blades)
    loop h in 1..15:
        if pass_hz*f64(h) < f64(MIX_RATE)*0.45: engine_add_sine(m,pass_hz*f64(h),1.0/pow(f64(h),1.35),f64(h*h)*0.37)
    engine_add_sine(m,turn,0.12,0.0)
    engine_sound_of(m,0.1)

# The tips' buzz-saw for a second: a sharp crack as each blade's tip goes by (a click rung through
# two bands near 1.6 and 3.2 kHz, a millisecond or two), each blade a touch unlike the others, the
# same every turn: pitched at the blade rate, never a hiss.
make_tips = (spec: EngineSpec,seed: int) -> Sound:
    r = EngineNoise(s = u64(seed*31337+5))
    n = MIX_RATE; rate = f64(MIX_RATE)
    m = fill(0.0,n)
    turns = prop_reference(spec); blades = spec.blades
    length = int(rate*0.004)
    cracks: f64[][]
    loop b in 0..blades:
        lo = 1450.0+250.0*engine_unit(r); hi = lo*2.1
        cracks.push([loop k in 0..length: (sin(TAU*lo*f64(k)/rate)+0.55*sin(TAU*hi*f64(k)/rate))*exp(-f64(k)/rate*1300.0)*min(1.0,f64(k)/3.0)])
    level = [loop b in 0..blades: 0.85+0.3*engine_unit(r)]
    passes = turns*blades
    loop k in 0..passes:
        b = k%blades
        start = int(f64(k)*rate/f64(passes)+0.5)
        crack = cracks[b]
        loop i in 0..length: m[(start+i)%n] += crack[i]*level[b]
    engine_sound_of(m,0.1)

# A pop from the stacks: a crack, the stacks ringing, a dull thud and a short sputter.
make_pop = (spec: EngineSpec,seed: int) -> Sound:
    r = EngineNoise(s = u64(seed*977+13))
    rate = f64(MIX_RATE); n = int(rate*0.16)
    m = fill(0.0,n)
    ring_hz = spec.stacks*(0.7+0.3*engine_unit(r))
    loop i in 0..n:
        t = f64(i)/rate
        m[i] = engine_signed(r)*exp(-t*1800.0)*0.6+sin(TAU*ring_hz*t)*exp(-t*90.0)*0.9+sin(TAU*ring_hz*0.33*t)*exp(-t*60.0)*0.7+sin(TAU*72.0*t)*exp(-t*35.0)*0.7
    one_shot(m,0.5)

# The turning speed for a throttle and a true airspeed, settled (the throttle's, or the air
# windmilling a fixed propeller, whichever is more; overspeeding in a dive), as a pitch for the loops.
engine_rpm = (spec: EngineSpec,throttle: f64,speed: f64,cruise: f64,on: bool) -> f64:
    driven = spec.idle+(spec.rpm*1.06-spec.idle)*pow(clamp(throttle,0.0,1.0),0.75)
    windmill = spec.rpm*0.82*speed/max(cruise,1.0)
    if on: min(max(driven,windmill),spec.rpm*1.32) else: windmill*0.6
engine_pitch = (spec: EngineSpec,rpm: f64) -> f64: rpm/(f64(engine_reference(spec))*60.0)

# An aircraft heard from outside, for a second at the reference speed: mostly its propeller (the
# blade-pass and the tips' buzz), its exhaust under it. One loop, so one voice an aircraft.
make_outside = (spec: EngineSpec) -> Sound: outside_mix(make_exhaust(spec,true,5),make_prop(spec),make_tips(spec,6))
outside_mix = (ex: Sound,pr: Sound,tp: Sound) -> Sound:
    m = [loop i in 0..MIX_RATE: f64(ex.samples[i*2])*0.55+f64(pr.samples[i*2])*1.0+f64(tp.samples[i*2])*0.45]
    engine_sound_of(m,0.1)

# The hydrofoil racer's water screw churning under the hull for a second (its three blades, geared
# down to half the engine's turn): water beaten at the blade rate, the cavitation's hiss over it.
make_screw = (spec: EngineSpec) -> Sound:
    r = EngineNoise(s = u64(777))
    n = MIX_RATE; rate = f64(MIX_RATE)
    m = fill(0.0,n)
    blade_hz = f64(engine_reference(spec)/2*3)
    low = Biquad(); lowpass(low,320.0); low2 = Biquad(); lowpass(low2,320.0); hiss = Biquad(); bandpass(hiss,3600.0,0.8)
    wave = fill(0.0,n); engine_add_sine(wave,blade_hz,0.5,PI*0.5)
    loop i in 0..2048: x = engine_signed(r); _ = filt(low2,filt(low,x)); _ = filt(hiss,x)
    loop i in 0..n:
        x = engine_signed(r)
        beat = 0.5+wave[i]
        m[i] = filt(low2,filt(low,x))*6.0*(0.45+0.55*beat*beat)+filt(hiss,x)*0.5*(0.3+0.7*beat)
    engine_sound_of(m,0.1)

# Foils cutting the sea, for two seconds: a seething hiss with a faint singing tone in it,
# wavering (pitched with her speed).
make_foil_hiss = () -> Sound:
    r = EngineNoise(s = u64(991))
    n = MIX_RATE*2
    m = fill(0.0,n)
    a = Biquad(); bandpass(a,1400.0,0.9); b = Biquad(); bandpass(b,920.0,22.0)
    sway = fill(0.0,n); engine_add_sine(sway,0.5,0.2,0.0)
    loop i in 0..2048: x = engine_signed(r); _ = filt(a,x); _ = filt(b,x)
    loop i in 0..n:
        x = engine_signed(r)
        m[i] = filt(a,x)*(0.8+sway[i])+filt(b,x)*1.8*(0.6+2.0*sway[i])
    engine_sound_of(m,0.1)

# The air propeller's blades slapping the sea, for a second at the reference speed: a splash at
# each blade's pass, each its own.
make_blade_slaps = (spec: EngineSpec) -> Sound:
    r = EngineNoise(s = u64(4321))
    n = MIX_RATE; rate = f64(MIX_RATE)
    m = fill(0.0,n)
    passes = prop_reference(spec)*spec.blades
    body = Biquad(); bandpass(body,700.0,0.8)
    loop k in 0..passes:
        start = int(f64(k)/f64(passes)*rate)
        level = 0.7+0.3*engine_unit(r)
        loop i in 0..int(rate*0.025):
            t = f64(i)/rate
            m[(start+i)%n] += filt(body,engine_signed(r))*exp(-t*160.0)*level*3.0+sin(TAU*120.0*t)*exp(-t*90.0)*level*0.5
    engine_sound_of(m,0.1)

# The air as heard with the period engines: by the speed against the type's own cruise (66 m/s, the
# Gull's), so the engine leads at cruise in a racer as in the Gull, the air catching up in a dive;
# slower types as they were.
air_heard_speed = (speed: f64,cruise: f64) -> f64: speed*min(1.0,66.0/max(cruise,1.0))

struct PeriodEngine:
    kind = -1                       # (the aircraft its sounds were made for)
    spec: EngineSpec = EngineSpec()
    on_load: Sound = Sound([])
    overrun: Sound = Sound([])
    prop: Sound = Sound([])
    tips: Sound = Sound([])
    pops: Sound[]
    water: Sound[]                  # (the hydrofoil racer: its screw, its foils, its blades in the sea)
    water_ids: int[]
    ids: int[]                      # on load, overrun, prop, tips; then each further bank's on load and overrun
    rpm = 0.0
    throttle_was = 0.0
    eased = 0.0                     # (the throttle a moment ago: a quick pull back sets the stacks popping)
    popping = 0.0                   # (seconds of crackle still to come)
    next_pop = 0.0
    blip = 0.0
    noise: EngineNoise = EngineNoise()
    making = -1                     # (the aircraft whose sounds are being made, a piece a frame)
    stage = 0
    quiet: bool[]                   # (each voice paused while silent: the mixer passes it by)

engine_sound_stop = (e: mut PeriodEngine):
    loop id in e.ids: stop(id)
    loop id in e.water_ids: stop(id)
    e.ids = []; e.water_ids = []; e.quiet = []

# (a voice's level: paused while silent, so the mixer does no work for it)
engine_level = (e: mut PeriodEngine,slot: int,id: int,volume: f64):
    loop e.quiet.len() <= slot: e.quiet.push(false)
    if volume < 0.0002:
        if not e.quiet[slot]: set_volume(id,0.0); pause(id); e.quiet[slot] = true
        return
    if e.quiet[slot]: resume(id); e.quiet[slot] = false
    set_volume(id,volume)

# The sounds for an aircraft, made when it is chosen, a piece a frame (engine_sound_build_step:
# each piece a few milliseconds); until they are all made the shared engine loops play.
engine_sound_prepare = (e: mut PeriodEngine,kind: Craft):
    if e.kind == int(kind) or e.making == int(kind): return
    engine_sound_stop(e)
    e.kind = -1; e.making = int(kind); e.stage = 0
engine_sound_ready = (e: PeriodEngine,kind: Craft) -> bool: e.kind == int(kind)
engine_sound_build_step = (e: mut PeriodEngine):
    if e.making < 0: return
    kind = Craft(e.making)
    if e.stage == 0: e.spec = engine_spec(kind); e.on_load = make_exhaust(e.spec,true,1)
    else if e.stage == 1: e.overrun = make_exhaust(e.spec,false,2)
    else if e.stage == 2: e.prop = make_prop(e.spec)
    else if e.stage == 3: e.tips = make_tips(e.spec,3)
    else if e.stage == 4: e.pops = [loop k in 0..6: make_pop(e.spec,k+1)]; e.water = []
    else if e.stage == 5:
        if aircraft_profile(kind).hydrofoil: e.water.push(make_screw(e.spec))
    else if e.stage == 6:
        if aircraft_profile(kind).hydrofoil: e.water.push(make_foil_hiss())
    else if e.stage == 7:
        if aircraft_profile(kind).hydrofoil: e.water.push(make_blade_slaps(e.spec))
    else:
        e.kind = e.making; e.making = -1
        e.rpm = e.spec.idle; e.noise = EngineNoise(s = u64(4242))
    e.stage += 1
# (all at once: tools and tests)
engine_sound_make = (e: mut PeriodEngine,kind: Craft):
    engine_sound_prepare(e,kind)
    loop not engine_sound_ready(e,kind): engine_sound_build_step(e)

# Each frame: is it running, the throttle (0..1), the true airspeed, the aircraft's cruise and top
# speeds, its propeller's radius and the overall level the old engine would have had (lv). Off:
# every voice silent.
engine_sound_update = (e: mut PeriodEngine,dt: f64,on: bool,throttle: f64,speed: f64,cruise: f64,top: f64,radius: f64,lv: f64):
    if e.kind < 0: return
    spec = e.spec
    if e.ids.len() == 0:
        e.ids = [play(e.on_load,0.0,looping = true),play(e.overrun,0.0,looping = true),play(e.prop,0.0,looping = true),play(e.tips,0.0,looping = true)]
        # (more engines: further banks, each a touch off the others, beating and drifting)
        loop k in 1..min(spec.count,3):
            e.ids.push(play(e.on_load,0.0,looping = true,delay = -0.37*f64(k)))
            e.ids.push(play(e.overrun,0.0,looping = true,delay = -0.21*f64(k)))
    # the turning speed: the throttle's, or the air's windmilling a fixed propeller (over the
    # cruise speed in a dive, so overspeeding), whichever is the more
    target = engine_rpm(spec,throttle,speed,cruise,on)
    e.rpm += (target-e.rpm)*min(1.0,dt*(if target > e.rpm: 2.2 else: 1.6))
    load = clamp((throttle-0.08)/0.6,0.0,1.0)*(if on: 1.0 else: 0.0)
    # (a quick pull back, at speed: the stacks pop and crackle for a while; gliding in with the
    # throttle shut, now and then)
    e.eased += (throttle-e.eased)*min(1.0,dt*2.0)
    if on and e.eased-throttle > 0.25 and e.rpm > spec.rpm*0.6: e.popping = max(e.popping,1.6)
    overrun = on and throttle < 0.12 and e.rpm > spec.idle*1.6
    e.popping = max(0.0,e.popping-dt)
    e.next_pop -= dt
    if on and (e.popping > 0.0 or overrun) and e.next_pop <= 0.0 and e.pops.len() > 0:
        busy = if e.popping > 0.0: 1.0 else: 0.35
        e.next_pop = (0.05+0.35*engine_unit(e.noise))/busy
        play(e.pops[int(engine_unit(e.noise)*5.999)],lv*(0.25+0.5*engine_unit(e.noise))*busy,pitch = 0.85+0.3*engine_unit(e.noise))
    # a rotary at low power: the blip switch cutting the ignition in and out
    gate = 1.0
    if spec.layout == .rotary and on and throttle < 0.45:
        e.blip += dt*2.6
        duty = 0.35+throttle
        gate = if e.blip-floor(e.blip) < duty: 1.0 else: 0.15
    pitch = e.rpm/(f64(engine_reference(spec))*60.0)
    prop_pitch = e.rpm*spec.gear/(f64(prop_reference(spec))*60.0)
    running = if on: 1.0 else: 0.0
    spin = e.rpm/spec.rpm
    # the tips' speed through the air, as a share of the speed of sound
    tip = sqrt(pow(TAU*radius*e.rpm*spec.gear/60.0,2.0)+speed*speed)/340.0
    loud = lv*0.95
    engine_level(e,0,e.ids[0],loud*(0.35+0.65*load)*gate*running); set_pitch(e.ids[0],pitch)
    engine_level(e,1,e.ids[1],loud*0.55*(1.0-load)*gate*running); set_pitch(e.ids[1],pitch)
    engine_level(e,2,e.ids[2],loud*0.55*min(1.4,spin*spin)); set_pitch(e.ids[2],prop_pitch)
    engine_level(e,3,e.ids[3],loud*0.6*smoothstep(0.45,0.95,tip)); set_pitch(e.ids[3],prop_pitch)
    loop k in 1..min(spec.count,3):
        drift = 1.0+0.011*f64(k)*(if k%2 == 0: -1.0 else: 1.0)
        bank = 0.75/f64(k)
        engine_level(e,2+k*2,e.ids[2+k*2],loud*bank*(0.35+0.65*load)*gate*running); set_pitch(e.ids[2+k*2],pitch*drift)
        engine_level(e,3+k*2,e.ids[3+k*2],loud*bank*0.55*(1.0-load)*gate*running); set_pitch(e.ids[3+k*2],pitch*drift)

engine_sound_hush = (e: mut PeriodEngine):
    loop k in 0..e.ids.len(): engine_level(e,k,e.ids[k],0.0)
    loop k in 0..e.water_ids.len(): engine_level(e,20+k,e.water_ids[k],0.0)

# Each frame, the hydrofoil racer in the sea: its screw driving (0..1), its foils' lift (a share
# of her weight) and its air propeller's blades in the sea (a share of the radius), at a speed.
engine_sound_water = (e: mut PeriodEngine,screw: f64,foil_cut: f64,prop_dip: f64,speed: f64,lv: f64):
    if e.water.len() == 0: return
    if e.water_ids.len() == 0: e.water_ids = [loop w in e.water: play(w,0.0,looping = true)]
    pitch = engine_pitch(e.spec,e.rpm)
    engine_level(e,20,e.water_ids[0],lv*0.9*screw); set_pitch(e.water_ids[0],pitch)
    engine_level(e,21,e.water_ids[1],lv*0.6*smoothstep(0.05,0.6,foil_cut)*smoothstep(4.0,20.0,speed)); set_pitch(e.water_ids[1],0.7+0.5*clamp(speed/30.0,0.0,1.6))
    engine_level(e,22,e.water_ids[2],lv*1.1*smoothstep(0.0,0.3,prop_dip)); set_pitch(e.water_ids[2],e.rpm*e.spec.gear/(f64(prop_reference(e.spec))*60.0))
