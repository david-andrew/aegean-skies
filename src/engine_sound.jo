# The period engines (a trial: tweaks.period_engines). Each aircraft's own engine, from what it
# really had: how many cylinders and how laid out (a rotary, a radial, an inline or V, a broad
# arrow W), its turning speed, its reduction gear and its propeller's blades. Heard as:
#   the exhaust: a pulse at every firing (cylinders/2 a turn), each a short crack rung through its
#     stacks' resonance, the cylinders a little unlike one another, so the beat repeats every two
#     turns (a radial's rumble, a V-12's snarl); hard and bright on load, soft and ragged on the
#     overrun, a rotary's open ports raspy and its blip switch cutting it in and out at low power
#   the propeller: its blades passing, a "whup" of harmonics, and at speed the tips' buzz-saw noise
#     growing with their speed through the air
#   pops and crackle from the stacks when the throttle comes back, and on a gliding approach
# Loops are baked once for the aircraft at a reference turning speed (whole cycles in a second, so
# they loop clean) and set_pitch follows the turning speed: firing, blade-pass and their harmonics
# move together, as they do. Nothing recorded: all made here.
use 'airsound.jo'
use 'aircraft_catalog.jo'
from 'planes.jo' import Craft, aircraft_profile

enum EngineLayout: rotary, radial, inline, arrow

struct EngineSpec:
    layout: EngineLayout = .radial
    cylinders = 9
    rpm = 1900.0                    # the crankshaft at cruise
    idle = 500.0
    gear = 1.0                      # propeller turns per crankshaft turn
    blades = 2
    stacks = 450.0                  # the exhaust's ring, Hz (short racing stubs high, a collector ring low)
    count = 1                       # engines heard

# The real engines of the historical types (approximate period figures); the game's own designs by
# their voice, their tone setting the turning speed a little.
engine_spec = (kind: Craft) -> EngineSpec:
    p = aircraft_profile(kind)
    many = max(1,if p.engines > 0: p.engines else: (if p.push_pull or p.engine_x > 0.0 or p.voice == .twin: 2 else: 1))
    match kind:
        .macchi_mc72: EngineSpec(.inline,24,3300,700,0.5,2,950,2)          # Fiat AS.6: two V-12s in tandem, contra-props
        .sm_s65: EngineSpec(.inline,12,2500,600,0.66,2,820,2)               # two Isotta-Fraschini V-12s, push-pull
        .piaggio_p7: EngineSpec(.arrow,18,2400,600,0.7,2,760,1)             # an Isotta-Fraschini W-18
        .macchi_m33: EngineSpec(.inline,12,2300,550,1.0,2,700,1)            # Curtiss D-12
        .curtiss_r3c2: EngineSpec(.inline,12,2400,550,1.0,2,760,1)          # Curtiss V-1400
        .supermarine_s6b: EngineSpec(.inline,12,3200,700,0.605,2,900,1)     # Rolls-Royce R
        .sea_lion_ii: EngineSpec(.arrow,12,2300,550,0.66,2,620,1)           # Napier Lion
        .sm_s55: EngineSpec(.inline,12,1900,500,1.0,2,560,2)                # two Isotta Asso V-12s, push-pull
        .dornier_wal: EngineSpec(.arrow,12,2000,500,0.66,2,560,2)           # two Napier Lions, push-pull
        .dornier_dox: EngineSpec(.radial,9,1700,450,1.0,2,420,12)           # twelve Bristol Jupiters
        .hughes_h4: EngineSpec(.radial,28,2550,600,0.381,4,380,8)           # eight P&W R-4360s
        .short_sarafand: EngineSpec(.inline,12,2300,550,0.553,2,600,6)      # six Rolls-Royce Buzzards
        .macchi_m5: EngineSpec(.inline,6,1450,450,1.0,2,520,1)              # Isotta-Fraschini V.4B
        .hansa_cc: EngineSpec(.inline,6,1400,450,1.0,2,500,1)               # Hiero / Benz six
        .macchi_m7: EngineSpec(.inline,6,1600,450,1.0,2,540,1)              # Isotta-Fraschini V.6
        .fiat_cr20: EngineSpec(.inline,12,2000,500,1.0,2,640,1)             # Fiat A.20
        .donnet_leveque: EngineSpec(.rotary,7,1200,500,1.0,2,1100,1)        # Gnome
        .sopwith_greek: EngineSpec(.radial,10,1200,450,1.0,2,620,1)         # Anzani ten
        .sopwith_bat_boat: EngineSpec(.radial,9,1250,450,1.0,2,560,1)       # Salmson, water-cooled
        .short_184: EngineSpec(.inline,12,2000,500,0.6,4,600,1)             # Sunbeam
        .blackburn_velos: EngineSpec(.arrow,12,2000,500,0.66,2,580,1)       # Napier Lion
        .fairey_iiif: EngineSpec(.arrow,12,2200,500,0.66,2,600,1)           # Napier Lion
        _:
            spin = 0.82+0.18*p.tone
            match p.voice:
                .rotary: EngineSpec(.rotary,9,1250*spin,500,1.0,2,1050,many)
                .inline: EngineSpec(.inline,12,2200*spin,550,0.62,2,700,many)
                .twin: EngineSpec(.radial,9,1900*spin,500,1.0,2,460,max(2,many))
                _: EngineSpec(.radial,9,1900*spin,500,1.0,2,460,many)

# (its own generator, so making these never moves the game's other sounds)
struct EngineNoise:
    s = u64(1)
engine_unit = (r: mut EngineNoise) -> f64:
    r.s += (u64(0x9E3779B9)<<32 or u64(0x7F4A7C15))
    z = r.s
    z = (z xor (z>>30))*(u64(0xBF58476D)<<32 or u64(0x1CE4E5B9))
    z = (z xor (z>>27))*(u64(0x94D049BB)<<32 or u64(0x133111EB))
    f64((z xor (z>>31))>>11)/9007199254740992.0
engine_signed = (r: mut EngineNoise) -> f64: engine_unit(r)*2.0-1.0

# whole turns a second near the cruise speed, even (an odd-cylindered engine's cycle is two turns)
engine_reference = (spec: EngineSpec) -> int: max(2,(int(spec.rpm/60.0+0.5)/2)*2)
prop_reference = (spec: EngineSpec) -> int: max(1,int(f64(engine_reference(spec))*spec.gear+0.5))

# (a mono second into a stereo loop at an rms; a second always loops clean here: whole cycles)
engine_sound_of = (m: f64[],rms: f64) -> Sound:
    sum = 0.0
    loop v in m: sum += v*v
    g = rms/max(sqrt(sum/f64(m.len())),1e-12)
    out = fill(f32(0),m.len()*2)
    loop i in 0..m.len():
        out[i*2] = f32(m[i]*g); out[i*2+1] = f32(m[i]*g)
    Sound(out)

# The exhaust for a second at the reference speed: on load (hard, bright) or on the overrun (soft,
# ragged: firings missed, now and then one late and loud).
make_exhaust = (spec: EngineSpec,load: bool,seed: int) -> Sound:
    r = EngineNoise(s = u64(seed*7919+int(spec.layout)*104729+spec.cylinders))
    n = MIX_RATE; rate = f64(MIX_RATE)
    m = fill(0.0,n)
    rev = f64(engine_reference(spec))
    cycles = int(rev/2.0)                       # (two turns a cycle)
    firings = spec.cylinders
    gap = 2.0/(rev*f64(firings))                # seconds between firings
    # each cylinder its own strength and a touch early or late, the same every cycle
    strength = [loop c in 0..firings: 1.0+0.18*engine_signed(r)]
    lean = [loop c in 0..firings: 0.06*engine_signed(r)*gap]
    open_ports = spec.layout == .rotary
    ring_hz = spec.stacks*(if load: 1.0 else: 0.8)
    ring_decay = if open_ports: 900.0 else: (if load: 260.0 else: 330.0)
    crack_decay = if load: 1100.0 else: 700.0
    body_hz = rev*f64(firings)/2.0
    length = int(rate*0.03)
    loop cycle in 0..cycles:
        loop c in 0..firings:
            at = (f64(cycle*firings+c))*gap+lean[c]
            level = strength[c]*(if load: 1.0 else: 0.35)
            late = 0.0
            if not load:
                pick = engine_unit(r)
                if pick < 0.12: level = 0.0                        # missed
                else if pick < 0.2: level *= 2.6; late = gap*0.3   # a pop, late
            if level <= 0.0: continue
            start = int((at+late)*rate)            # (may be a little before the loop's start: wrapped round)
            phase0 = engine_unit(r)*TAU
            loop k in 0..length:
                t = f64(k)/rate
                crack = engine_signed(r)*exp(-t*crack_decay)*(if open_ports: 1.4 else: 0.8)
                ring = sin(TAU*ring_hz*t+phase0)*exp(-t*ring_decay)
                thump = sin(TAU*min(body_hz,180.0)*t)*exp(-t*90.0)*0.6
                m[((start+k)%n+n)%n] += (crack+ring+thump)*level
    # a rotary's cylinders sweep round: its sound swells once a turn; any engine's crankcase hums
    loop i in 0..n:
        t = f64(i)/rate
        if open_ports: m[i] *= 0.8+0.2*cos(TAU*rev*t)
        m[i] += 0.08*sin(TAU*rev*t)+0.05*sin(TAU*rev*2.0*t)
    # (a little dull: the period's own stacks and the cowling)
    f = Biquad(); lowpass(f,if load: 5500.0 else: 3500.0)
    loop round in 0..2:
        loop i in 0..n:
            y = filt(f,m[i])
            if round == 1: m[i] = y
    engine_sound_of(m,0.1)

# The propeller's blades passing for a second at the reference speed: a "whup" of the blade rate's
# harmonics, the blades a touch unlike, so the turn itself is heard faintly.
make_prop = (spec: EngineSpec) -> Sound:
    n = MIX_RATE; rate = f64(MIX_RATE)
    m = fill(0.0,n)
    turn = f64(prop_reference(spec)); pass_hz = turn*f64(spec.blades)
    loop h in 1..15:
        a = 1.0/pow(f64(h),1.35); ph = f64(h*h)*0.37
        loop i in 0..n: m[i] += a*sin(TAU*pass_hz*f64(h)*f64(i)/rate+ph)
    loop i in 0..n: m[i] += 0.12*sin(TAU*turn*f64(i)/rate)
    engine_sound_of(m,0.1)

# The tips' noise for a second: a broad hiss (most of it 1.5-5 kHz) chopped at the blade rate, as a
# fast propeller's buzz-saw.
make_tips = (spec: EngineSpec,seed: int) -> Sound:
    r = EngineNoise(s = u64(seed*31337+5))
    n = MIX_RATE; rate = f64(MIX_RATE)
    m = fill(0.0,n)
    pass_hz = f64(prop_reference(spec)*spec.blades)
    a = Biquad(); bandpass(a,2300.0,0.7); b = Biquad(); bandpass(b,4600.0,0.9)
    loop round in 0..2:
        loop i in 0..n:
            x = engine_signed(r)
            v = filt(a,x)+0.6*filt(b,x)
            chop = 0.35+0.65*pow(0.5+0.5*cos(TAU*pass_hz*f64(i)/rate),3.0)
            if round == 1: m[i] = v*chop
    engine_sound_of(m,0.1)

# A pop from the stacks: a crack, the stacks ringing, a dull thud and a short sputter.
make_pop = (spec: EngineSpec,seed: int) -> Sound:
    r = EngineNoise(s = u64(seed*977+13))
    rate = f64(MIX_RATE); n = int(rate*0.16)
    m = fill(0.0,n)
    ring_hz = spec.stacks*(0.7+0.3*engine_unit(r))
    loop i in 0..n:
        t = f64(i)/rate
        m[i] = engine_signed(r)*exp(-t*600.0)*1.2+sin(TAU*ring_hz*t)*exp(-t*90.0)*0.8+sin(TAU*72.0*t)*exp(-t*35.0)*0.7
        if t > 0.02 and engine_unit(r) < 0.04: m[i] += engine_signed(r)*exp(-(t-0.02)*30.0)*0.8
    one_shot(m,0.5)

struct PeriodEngine:
    kind = -1                       # (the aircraft its sounds were made for)
    spec: EngineSpec = EngineSpec()
    on_load: Sound = Sound([])
    overrun: Sound = Sound([])
    prop: Sound = Sound([])
    tips: Sound = Sound([])
    pops: Sound[]
    ids: int[]                      # on load, overrun, prop, tips; then each further bank's on load and overrun
    rpm = 0.0
    throttle_was = 0.0
    eased = 0.0                     # (the throttle a moment ago: a quick pull back sets the stacks popping)
    popping = 0.0                   # (seconds of crackle still to come)
    next_pop = 0.0
    blip = 0.0
    noise: EngineNoise = EngineNoise()

engine_sound_stop = (e: mut PeriodEngine):
    loop id in e.ids: stop(id)
    e.ids = []

# The sounds for an aircraft, made once when it is chosen (a few tens of milliseconds).
engine_sound_prepare = (e: mut PeriodEngine,kind: Craft):
    if e.kind == int(kind): return
    engine_sound_stop(e)
    e.kind = int(kind); e.spec = engine_spec(kind)
    e.on_load = make_exhaust(e.spec,true,1); e.overrun = make_exhaust(e.spec,false,2)
    e.prop = make_prop(e.spec); e.tips = make_tips(e.spec,3)
    e.pops = [loop k in 0..6: make_pop(e.spec,k+1)]
    e.rpm = e.spec.idle; e.noise = EngineNoise(s = u64(4242))

# Each frame: is it running, the throttle (0..1), the true airspeed, the aircraft's cruise and top
# speeds, its propeller's radius and the overall level the old engine would have had (lv). Off:
# every voice silent.
engine_sound_update = (e: mut PeriodEngine,dt: f64,on: bool,throttle: f64,speed: f64,cruise: f64,top: f64,radius: f64,lv: f64):
    if e.kind < 0: return
    spec = e.spec
    if e.ids.len() == 0:
        e.ids = [play(e.on_load,0.0,looping = true),play(e.overrun,0.0,looping = true),play(e.prop,0.0,looping = true),play(e.tips,0.0,looping = true)]
        # (more engines: further banks, each a touch off the others, beating and drifting)
        loop k in 1..min(spec.count,3):
            e.ids.push(play(e.on_load,0.0,looping = true,delay = -0.37*f64(k)))
            e.ids.push(play(e.overrun,0.0,looping = true,delay = -0.21*f64(k)))
    # the turning speed: the throttle's, or the air's windmilling a fixed propeller (over the
    # cruise speed in a dive, so overspeeding), whichever is the more
    driven = spec.idle+(spec.rpm*1.06-spec.idle)*pow(clamp(throttle,0.0,1.0),0.75)
    windmill = spec.rpm*0.82*speed/max(cruise,1.0)
    target = if on: min(max(driven,windmill),spec.rpm*1.32) else: windmill*0.6
    e.rpm += (target-e.rpm)*min(1.0,dt*(if target > e.rpm: 2.2 else: 1.6))
    load = clamp((throttle-0.08)/0.6,0.0,1.0)*(if on: 1.0 else: 0.0)
    # (a quick pull back, at speed: the stacks pop and crackle for a while; gliding in with the
    # throttle shut, now and then)
    e.eased += (throttle-e.eased)*min(1.0,dt*2.0)
    if on and e.eased-throttle > 0.25 and e.rpm > spec.rpm*0.6: e.popping = max(e.popping,1.6)
    overrun = on and throttle < 0.12 and e.rpm > spec.idle*1.6
    e.popping = max(0.0,e.popping-dt)
    e.next_pop -= dt
    if on and (e.popping > 0.0 or overrun) and e.next_pop <= 0.0 and e.pops.len() > 0:
        busy = if e.popping > 0.0: 1.0 else: 0.35
        e.next_pop = (0.05+0.35*engine_unit(e.noise))/busy
        play(e.pops[int(engine_unit(e.noise)*5.999)],lv*(0.25+0.5*engine_unit(e.noise))*busy,pitch = 0.85+0.3*engine_unit(e.noise))
    # a rotary at low power: the blip switch cutting the ignition in and out
    gate = 1.0
    if spec.layout == .rotary and on and throttle < 0.45:
        e.blip += dt*2.6
        duty = 0.35+throttle
        gate = if e.blip-floor(e.blip) < duty: 1.0 else: 0.15
    pitch = e.rpm/(f64(engine_reference(spec))*60.0)
    prop_pitch = e.rpm*spec.gear/(f64(prop_reference(spec))*60.0)
    running = if on: 1.0 else: 0.0
    spin = e.rpm/spec.rpm
    # the tips' speed through the air, as a share of the speed of sound
    tip = sqrt(pow(TAU*radius*e.rpm*spec.gear/60.0,2.0)+speed*speed)/340.0
    loud = lv*0.95
    set_volume(e.ids[0],loud*(0.35+0.65*load)*gate*running); set_pitch(e.ids[0],pitch)
    set_volume(e.ids[1],loud*0.55*(1.0-load)*gate*running); set_pitch(e.ids[1],pitch)
    set_volume(e.ids[2],loud*0.55*min(1.4,spin*spin)); set_pitch(e.ids[2],prop_pitch)
    set_volume(e.ids[3],loud*0.6*smoothstep(0.45,0.95,tip)); set_pitch(e.ids[3],prop_pitch)
    loop k in 1..min(spec.count,3):
        drift = 1.0+0.011*f64(k)*(if k%2 == 0: -1.0 else: 1.0)
        bank = 0.75/f64(k)
        set_volume(e.ids[2+k*2],loud*bank*(0.35+0.65*load)*gate*running); set_pitch(e.ids[2+k*2],pitch*drift)
        set_volume(e.ids[3+k*2],loud*bank*0.55*(1.0-load)*gate*running); set_pitch(e.ids[3+k*2],pitch*drift)

engine_sound_hush = (e: PeriodEngine):
    loop id in e.ids: set_volume(id,0.0)
