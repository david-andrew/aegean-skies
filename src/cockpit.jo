# Fitted open cockpits, in aircraft coordinates. Instruments are engraved geometry, not HUD text.
use 'planes.jo'
use 'flight.jo'
use 'damage.jo'
use 'objects.jo'
use 'look.jo'
use 'render_space.jo'

struct Cockpit:
    panels:Mesh[]
    needle:Mesh
    hand:Mesh
    stick:Mesh
    oil:Mesh
    sight:Mesh
    prop_blur:Mesh

_dial_triangle = (vs:mut Vertex3D[],a:vec3,b:vec3,c:vec3,color:vec4):
    loop p in [a,b,c]:vs.push(Vertex3D(p,vec3(0,0,1),vec2(0,0),color))

_cockpit_strut = (vs:mut Vertex3D[],a:vec3,b:vec3,r:f64,col:vec4):
    add_cylinder(vs,vec3(0,0,0),r,f64(length(b-a)),col,6,transform=translation(a)*facing(b-a)*rotation_x(-PI*0.5))

_cockpit_quad = (vs:mut Vertex3D[],a:vec3,b:vec3,c:vec3,d:vec3,col:vec4):
    _dial_triangle(vs,a,b,c,col);_dial_triangle(vs,a,c,d,col)

_cockpit_line = (vs:mut Vertex3D[],a:vec3,b:vec3,w:f64,c:vec4):
    side=normalize(cross(b-a,vec3(0,0,1))+vec3(0.000001,0,0))*f32(w*0.5)
    _dial_triangle(vs,a-side,b-side,b+side,c);_dial_triangle(vs,a-side,b+side,a+side,c)

# Compact five-row engraver's alphabet; no font texture or extra draw calls.
_cockpit_glyph = (c:str) -> int[]:
    match c:
        "A":[2,5,7,5,5]
        "B":[6,5,6,5,6]
        "C":[3,4,4,4,3]
        "D":[6,5,5,5,6]
        "E":[7,4,6,4,7]
        "F":[7,4,6,4,4]
        "G":[3,4,5,5,3]
        "H":[5,5,7,5,5]
        "I":[7,2,2,2,7]
        "K":[5,5,6,5,5]
        "L":[4,4,4,4,7]
        "M":[5,7,7,5,5]
        "N":[5,7,7,7,5]
        "O":[2,5,5,5,2]
        "P":[6,5,6,4,4]
        "R":[6,5,6,5,5]
        "S":[3,4,2,1,6]
        "T":[7,2,2,2,2]
        "U":[5,5,5,5,7]
        "V":[5,5,5,5,2]
        "W":[5,5,7,7,5]
        "Y":[5,5,2,2,2]
        "0":[7,5,5,5,7]
        "1":[2,6,2,2,7]
        "2":[6,1,2,4,7]
        "3":[6,1,2,1,6]
        "4":[5,5,7,1,1]
        "5":[7,4,6,1,6]
        "6":[3,4,6,5,2]
        "7":[7,1,2,2,2]
        "8":[2,5,2,5,2]
        "9":[2,5,3,1,6]
        _:[0,0,0,0,0]

_cockpit_label = (vs:mut Vertex3D[],label:str,at:vec3,height:f64,col:vec4):
    letters=split(label,"");unit=height/5.0
    loop i in 0..letters.len():
        rows=_cockpit_glyph(letters[i])
        loop row in 0..5:
            loop x in 0..3:
                if (rows[row] & (1 << (2-x)))==0:continue
                p=at+vec3((f64(i)*4.0+f64(x)-f64(letters.len()*4-1)*0.5)*unit,(2.0-f64(row))*unit,0)
                _dial_triangle(vs,p,p+vec3(unit*0.85,0,0),p+vec3(unit*0.85,unit*0.85,0),col)
                _dial_triangle(vs,p,p+vec3(unit*0.85,unit*0.85,0),p+vec3(0,unit*0.85,0),col)

_cockpit_disc = (vs:mut Vertex3D[],at:vec3,r:f64,col:vec4):
    loop j in 0..32:
        a=TAU*f64(j)/32.0;b=TAU*f64(j+1)/32.0
        _dial_triangle(vs,at,at+vec3(cos(a)*r,sin(a)*r,0),at+vec3(cos(b)*r,sin(b)*r,0),col)

cockpit_dials = (kind:Craft) -> vec3[]:
    p=aircraft_profile(kind)
    w=if p.boat:1.08 else:if p.voice==.inline:0.92 else:1.0
    [vec3(-0.27*w,-0.30,-0.74),vec3(0,-0.27,-0.74),vec3(0.27*w,-0.30,-0.74),vec3(-0.16*w,-0.52,-0.72),vec3(0.16*w,-0.52,-0.72)]

cockpit_eye_local = (model:CraftModel) -> vec3:model.cockpit+vec3(0,0.16,0.40)

# Both barrels converge at (0,0,-450). Include gravity's drop at the selected bullet scale.
# This is a level-flight 450 m zero, rather than a screen-centred crosshair unrelated to the guns.
cockpit_zero = (scale:f64) -> vec3:vec3(0,-4.905*pow(450.0/(420.0*max(0.5,scale)),2.0),-450)
cockpit_sight = (model:CraftModel,scale:f64) -> vec3:
    eye=cockpit_eye_local(model)
    eye+normalize(cockpit_zero(scale)-eye)*1.16

build_cockpit = () -> Cockpit:
    c=Cockpit();brass=rgb(0.64,0.49,0.26);ivory=rgb(0.94,0.87,0.66)
    loop id in 0..16:
        kind=Craft(id);p=aircraft_profile(kind);vs:Vertex3D[]
        metal=p.voice==.inline or p.voice==.twin
        panel=if metal:rgb(0.31,0.36,0.34) else:rgb(0.47,0.24,0.10)
        # Rounded shoulders and a deeper lower panel, tucked below the coaming.
        loop j in 0..16:
            a=PI*f64(j)/16.0;b=PI*f64(j+1)/16.0
            _dial_triangle(vs,vec3(0,-0.65,-0.77),vec3(cos(b)*0.49,-0.32+sin(b)*0.22,-0.77),vec3(cos(a)*0.49,-0.32+sin(a)*0.22,-0.77),panel)
        add_box(vs,vec3(0,-0.55,-0.8),vec3(0.97,0.42,0.055),panel)
        # Fine grain / pressed horizontal stiffeners and perimeter screws.
        loop j in 0..15:
            y=-0.69+f64(j)*0.035
            _cockpit_line(vs,vec3(-0.44,y,-0.768),vec3(0.44,y+sin(f64(j))*0.006,-0.768),0.0015,panel*0.75)
        loop x in [-0.45,0.45]:
            loop y in [-0.33,-0.6]:
                _cockpit_disc(vs,vec3(x,y,-0.754),0.012,brass)
                _cockpit_line(vs,vec3(x-0.006,y,-0.75),vec3(x+0.006,y,-0.75),0.002,rgb(0.1,0.09,0.07))
        positions=cockpit_dials(kind)
        labels=["AIR SPEED","ALTIMETER","RPM","OIL PRESS","COMPASS"]
        units=["KM H","M X100","X100","KG CM2","N"]
        loop k in 0..5:
            at=positions[k];r=if k<3:0.112 else:0.088
            _cockpit_disc(vs,at,r+0.012,brass)
            _cockpit_disc(vs,at+vec3(0,0,0.002),r+0.004,rgb(0.12,0.11,0.09))
            _cockpit_disc(vs,at+vec3(0,0,0.004),r,rgb(0.035,0.045,0.04))
            loop tick in 0..21:
                angle=PI*1.25-f64(tick)*PI*1.5/20.0
                a=at+vec3(cos(angle)*r*0.9,sin(angle)*r*0.9,0.009)
                b=at+vec3(cos(angle)*r*(if tick%5==0:0.70 else:0.81),sin(angle)*r*(if tick%5==0:0.70 else:0.81),0.009)
                _cockpit_line(vs,a,b,if tick%5==0:0.003 else:0.0015,ivory)
                if tick%5==0 and k<4:
                    number=if k==0:tick*20 else:if k==1:tick*5 else:if k==2:tick*2 else:tick/5
                    _cockpit_label(vs,str(number),at+vec3(cos(angle)*r*0.55,sin(angle)*r*0.55,0.01),0.015,ivory)
            _cockpit_label(vs,labels[k],at+vec3(0,-r*0.4,0.011),0.013,ivory)
            if k!=4:_cockpit_label(vs,units[k],at+vec3(0,r*0.25,0.011),0.012,ivory)
            else:
                loop cardinal in 0..4:
                    angle=PI*0.5-f64(cardinal)*PI*0.5
                    _cockpit_label(vs,["N","E","S","W"][cardinal],at+vec3(cos(angle)*r*0.58,sin(angle)*r*0.58,0.011),0.015,ivory)
        _cockpit_label(vs,CRAFT_NAMES[id].upper(),vec3(0,-0.68,-0.75),0.02,ivory)
        # Padded leather oval, stitched by hand; the inside well has its own dark lining.
        loop j in 0..64:
            a=TAU*f64(j)/64.0;b=TAU*f64(j+1)/64.0
            a0=vec3(cos(a)*0.51,-0.24+max(0.0,-sin(a))*0.16,sin(a)*0.83+0.05)
            b0=vec3(cos(b)*0.51,-0.24+max(0.0,-sin(b))*0.16,sin(b)*0.83+0.05)
            _cockpit_strut(vs,a0,b0,0.043,rgb(0.24,0.105,0.045))
            if j%2==0:_cockpit_strut(vs,a0+vec3(0,0.044,0),mix(a0,b0,0.6)+vec3(0,0.044,0),0.0025,rgb(0.66,0.47,0.27))
            if sin(a)>-0.25:_cockpit_quad(vs,a0,b0,b0+vec3(0,-0.7,0),a0+vec3(0,-0.7,0),rgb(0.105,0.075,0.045))
        # Thin three-pane windscreen frame. Clear glass is suggested by edge highlights, leaving
        # the view clean (the opaque object material must never be used as tinted glass).
        screen=[vec3(-0.45,-0.23,-0.65),vec3(-0.33,0.23,-0.74),vec3(0.33,0.23,-0.74),vec3(0.45,-0.23,-0.65)]
        if p.boat:screen[1].y+=0.06;screen[2].y+=0.06
        loop j in 0..3:_cockpit_strut(vs,screen[j],screen[j+1],0.009,brass)
        loop side in [-1.0,1.0]:
            _cockpit_strut(vs,vec3(side*0.28,-0.23,-0.78),vec3(side*0.25,screen[1].y,-0.75),0.006,brass)
            _cockpit_line(vs,vec3(side*0.31,0.12,-0.732),vec3(side*0.28,0.20,-0.732),0.003,rgb(0.74,0.87,0.86))
        # Lined footwell, leather seat cushion and a simple rudder bar below the hands.
        add_box(vs,vec3(0,-0.94,0),vec3(0.98,0.03,1.5),rgb(0.15,0.11,0.07))
        add_box(vs,vec3(0,-0.80,0.45),vec3(0.40,0.10,0.40),rgb(0.26,0.12,0.05))
        _cockpit_strut(vs,vec3(-0.30,-0.88,-0.42),vec3(0.30,-0.88,-0.42),0.018,brass)
        # Throttle quadrant and its arc; left hand follows this lever.
        add_box(vs,vec3(-0.40,-0.53,-0.16),vec3(0.09,0.12,0.22),brass)
        c.panels.push(custom_mesh(vs))
    vs:Vertex3D[]
    _dial_triangle(vs,vec3(-0.015,-0.003,0),vec3(0.084,0,0),vec3(-0.015,0.003,0),ivory)
    _cockpit_disc(vs,vec3(0,0,0.001),0.009,brass)
    c.needle=custom_mesh(vs);vs=[]
    add_sphere(vs,vec3(0,0,0),0.055,rgb(0.35,0.19,0.09),8,4,scaling(vec3(0.8,0.7,1.2)))
    add_box(vs,vec3(0,-0.10,0.08),vec3(0.075,0.17,0.10),rgb(0.2,0.25,0.22))
    c.hand=custom_mesh(vs);vs=[]
    _cockpit_strut(vs,vec3(0,-0.4,0),vec3(0,0,0),0.012,rgb(0.19,0.2,0.17))
    _cockpit_strut(vs,vec3(-0.045,0,0),vec3(0.045,0,0),0.02,rgb(0.15,0.075,0.035))
    c.stick=custom_mesh(vs);vs=[]
    loop j in 0..18:
        x=sin(f64(j)*13.17)*0.29;y=sin(f64(j)*7.91)*0.15
        _cockpit_disc(vs,vec3(x,y,0),0.007+f64(j%4)*0.004,rgb(0.095,0.065,0.025))
        _cockpit_line(vs,vec3(x,y,0),vec3(x*1.03,y-0.04-f64(j%3)*0.02,0),0.004,rgb(0.14,0.09,0.025))
    c.oil=custom_mesh(vs);vs=[]
    loop j in 0..40:
        a=TAU*f64(j)/40.0;b=TAU*f64(j+1)/40.0
        _cockpit_line(vs,vec3(cos(a)*0.036,sin(a)*0.036,0),vec3(cos(b)*0.036,sin(b)*0.036,0),0.0015,rgb(0.23,0.18,0.1))
    _cockpit_line(vs,vec3(0,-0.16,0),vec3(0,-0.036,0),0.003,brass)
    _cockpit_disc(vs,vec3(0,0,0),0.002,brass)
    c.sight=custom_mesh(vs);vs=[]
    # Only the blade tips resolve at running RPM; a broad opaque blade obscures the sight.
    loop j in 0..48:
        if j%24>=10:continue
        a=TAU*f64(j)/48.0;b=TAU*f64(j+1)/48.0
        col=rgb(0.57,0.55,0.47)
        _cockpit_quad(vs,vec3(cos(a)*0.96,sin(a)*0.96,0),vec3(cos(a),sin(a),0),vec3(cos(b),sin(b),0),vec3(cos(b)*0.96,sin(b)*0.96,0),col)
    c.prop_blur=custom_mesh(vs)
    c

cockpit_values = (spec:CraftSpec,state:CraftState) -> f64[]:
    running=if state.fuel>0:clamp(1.0-state.engine_damage,0.0,1.0) else:0.0
    profile=aircraft_profile(spec.kind)
    rated=(if profile.voice==.rotary:1400.0 else:if profile.voice==.inline:2400.0 else:1900.0)*profile.tone
    [clamp(true_speed(spec,f64(length(state.velocity)))*3.6/400.0,0.0,1.0),
        (max(0.0,f64(state.position.y))/10000.0)%1.0,
        (450.0+state.throttle*(rated-450.0))*running/4000.0,(0.25+state.throttle*0.5)*running,
        (heading(state)+TAU)%TAU/TAU]

# Preserve millimetre-sized dial details hundreds of kilometres from the chart origin. The
# model translation is made camera-relative BEFORE adding local vertices; never subtract two
# already rounded world-space gauge positions in the vertex shader.
cockpit_params = (L:Light,t:f64,model:mat4) -> ObjParams:
    p=obj_params(L,t,model)
    p.view_proj[3]=vec4(0,0,-0.07000001,0)
    p.cam=vec3(0,0,0);p.warp_b=vec4(0,0,0,0)
    # Warm reflected light off fabric, varnished wood and the pilot's clothing.
    p.shade=mix(p.shade,vec3(0.72,0.6,0.44),0.8)
    p.sky=mix(p.sky,vec3(0.6,0.63,0.6),0.6)
    p

cockpit_relative = (at:mat4) -> mat4:
    local=at;local[3]=vec4(at[3].xyz-scene_camera(),1);local

draw_cockpit_airframe = (model:CraftModel,state:CraftState,at:mat4,L:Light,t:f64,prop:f64 = 0.0):
    local=cockpit_relative(at)
    loop i in 0..model.parts.len():
        if state.damage.parts[i].attached:
            draw(obj_sh,if i==0:model.cockpit_body else:if i==2 or i==3:model.cockpit_wings[i-2] else:model.parts[i].mesh,cockpit_params(L,t,local*model.parts[i].frame))
    if state.damage.parts[0].attached:
        loop wheel in model.wheels:draw(obj_sh,wheel.mesh,cockpit_params(L,t,local*wheel_frame(wheel,state.gear)))
    if state.damage.parts[1].attached and (state.fuel<=0 or state.engine_damage>=0.98):
        loop hub in model.prop_hubs:draw(obj_sh,model.prop,cockpit_params(L,t,local*translation(hub)*rotation_z(prop)))

draw_cockpit = (c:Cockpit,model:CraftModel,spec:CraftSpec,state:CraftState,at:mat4,L:Light,t:f64,controls:Controls = Controls(),scale:f64 = 5.0):
    relative=cockpit_relative(at)
    frame=relative*translation(model.cockpit)
    draw(obj_sh,c.panels[int(spec.kind)],cockpit_params(L,t,frame))
    if state.damage.parts[1].attached and state.fuel>0 and state.engine_damage<0.98:
        loop hub in model.prop_hubs:
            draw(obj_sh,c.prop_blur,cockpit_params(L,t,relative*translation(hub)*rotation_z(t*25.0)*scaling(aircraft_profile(spec.kind).prop_radius)))
    positions=cockpit_dials(spec.kind);values=cockpit_values(spec,state)
    loop j in 0..5:
        angle=if j==4:PI*0.5+values[j]*TAU else:PI*1.25-values[j]*PI*1.5
        if j==2 or j==3:angle+=sin(t*47.0)*0.012*state.throttle
        draw(obj_sh,c.needle,cockpit_params(L,t,frame*translation(positions[j]+vec3(0,0,0.018))*rotation_z(angle)*scaling(if j<3:1.0 else:0.76)))
    stick=frame*translation(vec3(0,-0.60,-0.15))*rotation_x(controls.pitch*0.24)*rotation_z(-controls.roll*0.22)
    draw(obj_sh,c.stick,cockpit_params(L,t,stick));draw(obj_sh,c.hand,cockpit_params(L,t,stick))
    throttle=frame*translation(vec3(-0.39,-0.43,-0.12-state.throttle*0.16))*rotation_z(0.3)
    draw(obj_sh,c.stick,cockpit_params(L,t,throttle*scaling(0.55)))
    draw(obj_sh,c.hand,cockpit_params(L,t,throttle))
    if state.engine_damage>0.3:draw(obj_sh,c.oil,cockpit_params(L,t,frame*translation(vec3(0,0.02,-0.72))*scaling(min(1.0,(state.engine_damage-0.3)*2.5))))
    draw(obj_sh,c.sight,cockpit_params(L,t,relative*translation(cockpit_sight(model,scale))))

cockpit_eye = (model:CraftModel,state:CraftState) -> vec3:
    state.position+quat_rotate(state.orientation,cockpit_eye_local(model))

place_cockpit_camera = (model:CraftModel,state:CraftState,yaw:f64,pitch:f64,t:f64 = 0.0,hit:f64 = 0.0,scale:f64 = 5.0,recoil:f64 = 0.0):
    running=if state.fuel>0:state.throttle*(1.0-state.engine_damage) else:0.0
    vibration=running*(0.002+state.engine_damage*0.006)
    offset=vec3(sin(t*61)*vibration,sin(t*47)*vibration,sin(t*53)*vibration*0.4)
    eye=cockpit_eye(model,state)+quat_rotate(state.orientation,offset)
    zero=normalize(cockpit_zero(scale)-cockpit_eye_local(model))
    kick=vec3(sin(t*37)*hit*0.018,sin(t*43)*hit*0.024+recoil*0.004,0)
    local=quat_rotate(quat_euler(pitch,yaw,0),normalize(zero+kick))
    forward=quat_rotate(state.orientation,local)
    up=quat_rotate(state.orientation,vec3(0,1,0))
    camera3d(eye,eye+forward*100.0,72.0,0.035,world_far(f64(eye.y)),up)
