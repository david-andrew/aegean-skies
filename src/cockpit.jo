use 'world_point.jo'
use 'targets.jo'
# Fitted open cockpits, in aircraft coordinates. Instruments are engraved geometry, not HUD text.
use 'planes.jo'
use 'flight.jo'
use 'damage.jo'
use 'prop_disc.jo'
use 'objects.jo'
use 'look.jo'
use 'paint.jo'
use 'render_space.jo'
use 'flight_instruments.jo'
use 'cockpit_cabins.jo'

struct Cockpit:
    panels:Mesh[]
    needle:Mesh
    short_hand:Mesh                 # the altimeter's thousands hand: short and broad
    hand:Mesh
    stick:Mesh
    oil:Mesh
    sight:Mesh
    moving_instruments:Mesh
    cabin_moving:Mesh               # throttle levers, the second airspeed/altimeter's and engine gauges' needles
    column:Mesh                     # a control wheel's column, from the floor up to its hub
    wheel:Mesh                      # the wheel itself, facing the pilot

_dial_triangle = (vs:mut Vertex3D[],a:vec3,b:vec3,c:vec3,color:vec4):
    loop p in [a,b,c]:vs.push(Vertex3D(p,vec3(0,0,1),vec2(0,0),color))

_cockpit_strut = (vs:mut Vertex3D[],a:vec3,b:vec3,r:f64,col:vec4):
    add_cylinder(vs,vec3(0,0,0),r,f64(length(b-a)),col,6,transform=translation(a)*facing(b-a)*rotation_x(-PI*0.5))

_cockpit_quad = (vs:mut Vertex3D[],a:vec3,b:vec3,c:vec3,d:vec3,col:vec4):
    _dial_triangle(vs,a,b,c,col);_dial_triangle(vs,a,c,d,col)

_cockpit_line = (vs:mut Vertex3D[],a:vec3,b:vec3,w:f64,c:vec4):
    side=normalize(cross(b-a,vec3(0,0,1))+vec3(0.000001,0,0))*f32(w*0.5)
    _dial_triangle(vs,a-side,b+side,b-side,c);_dial_triangle(vs,a-side,a+side,b+side,c)

# Compact five-row engraver's alphabet; no font texture or extra draw calls.
_cockpit_glyph = (c:str) -> int[]:
    match c:
        "A":[2,5,7,5,5]
        "B":[6,5,6,5,6]
        "C":[3,4,4,4,3]
        "D":[6,5,5,5,6]
        "E":[7,4,6,4,7]
        "F":[7,4,6,4,4]
        "G":[3,4,5,5,3]
        "H":[5,5,7,5,5]
        "I":[7,2,2,2,7]
        "K":[5,5,6,5,5]
        "L":[4,4,4,4,7]
        "M":[5,7,7,5,5]
        "N":[5,7,7,7,5]
        "O":[2,5,5,5,2]
        "P":[6,5,6,4,4]
        "R":[6,5,6,5,5]
        "S":[3,4,2,1,6]
        "T":[7,2,2,2,2]
        "U":[5,5,5,5,7]
        "V":[5,5,5,5,2]
        "W":[5,5,7,7,5]
        "Y":[5,5,2,2,2]
        "0":[7,5,5,5,7]
        "1":[2,6,2,2,7]
        "2":[6,1,2,4,7]
        "3":[6,1,2,1,6]
        "4":[5,5,7,1,1]
        "5":[7,4,6,1,6]
        "6":[3,4,6,5,2]
        "7":[7,1,2,2,2]
        "8":[2,5,2,5,2]
        "9":[2,5,3,1,6]
        _:[0,0,0,0,0]

_cockpit_label = (vs:mut Vertex3D[],label:str,at:vec3,height:f64,col:vec4):
    letters=split(label,"");unit=height/5.0
    loop i in 0..letters.len():
        rows=_cockpit_glyph(letters[i])
        loop row in 0..5:
            loop x in 0..3:
                if (rows[row] & (1 << (2-x)))==0:continue
                p=at+vec3((f64(i)*4.0+f64(x)-f64(letters.len()*4-1)*0.5)*unit,(2.0-f64(row))*unit,0)
                _dial_triangle(vs,p,p+vec3(unit*0.85,0,0),p+vec3(unit*0.85,unit*0.85,0),col)
                _dial_triangle(vs,p,p+vec3(unit*0.85,unit*0.85,0),p+vec3(0,unit*0.85,0),col)

_cockpit_disc = (vs:mut Vertex3D[],at:vec3,r:f64,col:vec4):
    loop j in 0..32:
        a=TAU*f64(j)/32.0;b=TAU*f64(j+1)/32.0
        _dial_triangle(vs,at,at+vec3(cos(a)*r,sin(a)*r,0),at+vec3(cos(b)*r,sin(b)*r,0),col)

cockpit_dials = (kind:Craft) -> vec3[]:
    p=aircraft_profile(kind)
    w=if p.boat:1.08 else:if p.voice==.inline:0.92 else:1.0
    [vec3(-0.27*w,-0.30,-0.74),vec3(0,-0.27,-0.74),vec3(0.27*w,-0.30,-0.74),vec3(-0.37,-0.54,-0.72),vec3(0.16*w,-0.52,-0.72)]

cockpit_eye_local = (model:CraftModel) -> vec3:model.cockpit+model.eye
# The cockpit's drawing frame in craft space: the seat for the open cockpits; for a cabin, its eye
# less the open cockpit's eye offset (so the panel sits where the open cockpit's does).
cockpit_frame_local = (model:CraftModel) -> vec3:cockpit_eye_local(model)-COCKPIT_EYE

# Both barrels converge at (0,0,-450). Include gravity's drop at the selected bullet scale.
# This is a level-flight 450 m zero, rather than a screen-centred crosshair unrelated to the guns.
cockpit_zero = (scale:f64) -> vec3:vec3(0,-4.905*pow(450.0/(420.0*max(0.5,scale)),2.0),-450)
cockpit_sight = (model:CraftModel,scale:f64) -> vec3:
    eye=cockpit_eye_local(model)
    eye+normalize(cockpit_zero(scale)-eye)*1.16

# One dial's fixed face: bezel, ticks, numerals and its name (k: airspeed, altimeter, rpm, oil
# pressure, compass; the needles are drawn over it).
# (the markings' paint is luminous: an alpha below 0.9 glows after dark in the object shader)
COCKPIT_LUMINOUS=rgba(0.94,0.87,0.66,0.2)
_cockpit_dial_face = (vs:mut Vertex3D[],k:int,at:vec3,r:f64):
    brass=rgb(0.64,0.49,0.26);ivory=COCKPIT_LUMINOUS
    labels=["AIR SPEED","ALTIMETER","RPM","OIL PRESS","COMPASS"]
    units=["KM H","M X100","X100","KG CM2","N"]
    _cockpit_disc(vs,at,r+0.012,brass)
    _cockpit_disc(vs,at+vec3(0,0,0.002),r+0.004,rgb(0.12,0.11,0.09))
    _cockpit_disc(vs,at+vec3(0,0,0.004),r,rgb(0.035,0.045,0.04))
    if k==1:
        # The altimeter's face goes all the way round: 0 to 9 clockwise from the top, a
        # tick every 20 m; the long hand reads hundreds, the short hand thousands.
        loop tick in 0..50:
            angle=PI*0.5-f64(tick)*TAU/50.0
            major=tick%5==0
            a=at+vec3(cos(angle)*r*0.9,sin(angle)*r*0.9,0.009)
            b=at+vec3(cos(angle)*r*(if major:0.72 else:0.82),sin(angle)*r*(if major:0.72 else:0.82),0.009)
            _cockpit_line(vs,a,b,if major:0.003 else:0.0013,ivory)
            if major:_cockpit_label(vs,str(tick/5),at+vec3(cos(angle)*r*0.57,sin(angle)*r*0.57,0.01),0.016*r/0.112,ivory)
        _cockpit_label(vs,labels[k],at+vec3(0,-r*0.32,0.011),0.012*r/0.112,ivory)
        _cockpit_label(vs,units[k],at+vec3(0,r*0.25,0.011),0.012*r/0.112,ivory)
        return
    loop tick in 0..21:
        angle=PI*1.25-f64(tick)*PI*1.5/20.0
        a=at+vec3(cos(angle)*r*0.9,sin(angle)*r*0.9,0.009)
        b=at+vec3(cos(angle)*r*(if tick%5==0:0.70 else:0.81),sin(angle)*r*(if tick%5==0:0.70 else:0.81),0.009)
        _cockpit_line(vs,a,b,if tick%5==0:0.003 else:0.0015,ivory)
        if tick%5==0 and k<4:
            number=if k==0:tick*20 else:if k==1:tick*5 else:if k==2:tick*2 else:tick/5
            _cockpit_label(vs,str(number),at+vec3(cos(angle)*r*0.55,sin(angle)*r*0.55,0.01),0.015*min(1.0,r/0.1),ivory)
    # (the name sits below the first and last numerals, not across them, and the small
    # dial's print is scaled to its face so it clears its own numerals)
    print_scale=r/0.112
    _cockpit_label(vs,labels[k],at+vec3(0,-r*0.66,0.011),0.013*print_scale,ivory)
    if k!=4:_cockpit_label(vs,units[k],at+vec3(0,r*0.25,0.011),0.012*print_scale,ivory)
    else:
        loop cardinal in 0..4:
            angle=PI*0.5-f64(cardinal)*PI*0.5
            _cockpit_label(vs,["N","E","S","W"][cardinal],at+vec3(cos(angle)*r*0.58,sin(angle)*r*0.58,0.011),0.015,ivory)

# The flying instruments, in the open cockpit's panel frame (a cabin shifts them into its own).
_cockpit_cluster = (vs:mut Vertex3D[],kind:Craft):
    brass=rgb(0.64,0.49,0.26);ivory=rgb(0.94,0.87,0.66)
    positions=cockpit_dials(kind)
    loop k in 0..4:_cockpit_dial_face(vs,k,positions[k],if k<3:0.112 else:0.055)
    loop at in [vec3(-0.14,-0.54,-0.72),vec3(0.12,-0.54,-0.72)]:
        _cockpit_disc(vs,at,0.12,brass)
        _cockpit_disc(vs,at+vec3(0,0,0.002),0.112,rgb(0.1,0.09,0.07))
    # The compass and radio are panel geometry, sharing the instruments' relative frame.
    add_box(vs,vec3(0,-0.05,-0.735),vec3(0.34,0.085,0.04),brass)
    add_box(vs,vec3(0.36,-0.54,-0.735),vec3(0.18,0.13,0.04),brass)
    _cockpit_label(vs,CRAFT_NAMES[int(kind)].upper(),vec3(0,-0.68,-0.75),0.02,ivory)

# A point round the coaming at angle a: an oval for one, squarer for a pair side by side (its front
# kept straight across both panels).
_coaming = (a:f64,ox:f64,ow:f64) -> vec3:
    k=if ow>0.55:0.35 else:1.0
    x=cos(a);z=sin(a)
    x=if x<0.0:-pow(-x,k) else:pow(x,k)
    z=if z<0.0:-pow(-z,k) else:pow(z,k)
    vec3(ox+x*ow,-0.24+max(0.0,-sin(a))*0.16,z*0.83+0.05)

# The coaming's top edge at angle a round the well, for a type (drawing frame; open cockpits).
cockpit_coaming = (kind:Craft,a:f64) -> vec3:
    l=cockpit_layout(kind)
    ox=if l.kind==.side_by_side:l.cx-l.seats[0] else:0.0
    _coaming(a,ox,l.open_hw)+vec3(0,0.043,0)

# The open cockpit round the panel: its backing, the padded coaming and the well under it (lined
# all round, wound toward the pilot: solid from inside at any head angle), the screen, the floor,
# seats and quadrant. ox, ow: a shared opening's centre and half width (side by side).
_cockpit_open = (vs:mut Vertex3D[],kind:Craft,ox:f64,ow:f64,seats:f64[]):
    p=aircraft_profile(kind);brass=rgb(0.64,0.49,0.26)
    metal=p.voice==.inline or p.voice==.twin
    panel=if metal:rgb(0.31,0.36,0.34) else:rgb(0.47,0.24,0.10)
    pw=ow-0.02
    # Rounded shoulders and a deeper lower panel, tucked below the coaming.
    loop j in 0..16:
        a=PI*f64(j)/16.0;b=PI*f64(j+1)/16.0
        _dial_triangle(vs,vec3(ox,-0.65,-0.77),vec3(ox+cos(b)*pw,-0.32+sin(b)*0.22,-0.77),vec3(ox+cos(a)*pw,-0.32+sin(a)*0.22,-0.77),panel)
    add_box(vs,vec3(ox,-0.55,-0.8),vec3(pw*1.98,0.42,0.055),panel)
    # Fine grain / pressed horizontal stiffeners and perimeter screws.
    loop j in 0..15:
        y=-0.69+f64(j)*0.035
        _cockpit_line(vs,vec3(ox-pw+0.05,y,-0.768),vec3(ox+pw-0.05,y+sin(f64(j))*0.006,-0.768),0.0015,paint_dim(panel,0.75))
    loop x in [ox-pw+0.04,ox+pw-0.04]:
        loop y in [-0.33,-0.6]:
            _cockpit_disc(vs,vec3(x,y,-0.754),0.012,brass)
            _cockpit_line(vs,vec3(x-0.006,y,-0.75),vec3(x+0.006,y,-0.75),0.002,rgb(0.1,0.09,0.07))
    # Padded leather oval, stitched by hand; the well below it has its own dark lining.
    lining=rgb(0.105,0.075,0.045)
    loop j in 0..64:
        a=TAU*f64(j)/64.0;b=TAU*f64(j+1)/64.0
        a0=_coaming(a,ox,ow);b0=_coaming(b,ox,ow)
        _cockpit_strut(vs,a0,b0,0.043,rgb(0.24,0.105,0.045))
        if j%2==0:_cockpit_strut(vs,a0+vec3(0,0.044,0),mix(a0,b0,0.6)+vec3(0,0.044,0),0.0025,rgb(0.66,0.47,0.27))
        if sin((a+b)*0.5)>0.0:cabin_face(vs,a0,b0,vec3(b0.x,-0.95,b0.z),vec3(a0.x,-0.95,a0.z),lining,vec3(ox,a0.y-0.3,0.05))
    # The tub under the opening: straight sides the fuselage's width (the oval narrows forward of
    # them, over the panel, which stands as the tub's front wall), a bulkhead behind the panel; the
    # rounded back follows the coaming (above).
    loop side in [-1.0,1.0]:
        x=ox+side*ow
        cabin_face(vs,vec3(x,-0.21,-0.84),vec3(x,-0.21,0.06),vec3(x,-0.95,0.06),vec3(x,-0.95,-0.84),lining,vec3(ox,-0.5,-0.3))
    cabin_face(vs,vec3(ox-ow,-0.95,-0.84),vec3(ox+ow,-0.95,-0.84),vec3(ox+ow,-0.12,-0.84),vec3(ox-ow,-0.12,-0.84),lining,vec3(ox,-0.5,0))
    # Thin three-pane windscreen frame. Clear glass is suggested by edge highlights, leaving
    # the view clean (the opaque object material must never be used as tinted glass).
    # (a pair's screen spans their shared opening)
    sw=if ow>0.55:ow*0.88/0.45 else:1.0
    screen=[vec3(ox-0.45*sw,-0.23,-0.65),vec3(ox-0.33*sw,0.23,-0.74),vec3(ox+0.33*sw,0.23,-0.74),vec3(ox+0.45*sw,-0.23,-0.65)]
    if p.boat:screen[1].y+=0.06;screen[2].y+=0.06
    loop j in 0..3:_cockpit_strut(vs,screen[j],screen[j+1],0.009,brass)
    loop side in [-1.0,1.0]:
        _cockpit_strut(vs,vec3(ox+side*0.28*sw,-0.23,-0.78),vec3(ox+side*0.25*sw,screen[1].y,-0.75),0.006,brass)
        _cockpit_line(vs,vec3(ox+side*0.31*sw,0.12,-0.732),vec3(ox+side*0.28*sw,0.20,-0.732),0.003,rgb(0.74,0.87,0.86))
    # Lined footwell, leather seat cushions and a simple rudder bar below the hands.
    add_box(vs,vec3(ox,-0.94,0.05),vec3(ow*2.0+0.06,0.03,1.78),rgb(0.15,0.11,0.07))
    loop x in seats:
        add_box(vs,vec3(x,-0.80,0.45),vec3(0.40,0.10,0.40),rgb(0.26,0.12,0.05))
        _cockpit_strut(vs,vec3(x-0.30,-0.88,-0.42),vec3(x+0.30,-0.88,-0.42),0.018,brass)
    if seats.len()>1:add_box(vs,vec3(seats[1],-0.52,0.70),vec3(0.40,0.46,0.08),rgb(0.26,0.12,0.05))
    # Throttle quadrant and its arc; left hand follows this lever (a pair flown with wheels has
    # its quadrant between the seats instead).
    if cockpit_quadrant(kind).len()==0:add_box(vs,vec3(-0.40,-0.53,-0.16),vec3(0.09,0.12,0.22),brass)

# A cabin's second airspeed and altimeter (before the right-hand seat) and its engines' gauges
# (along the panel under them), in the drawing frame.
cockpit_copilot_dials = (kind:Craft) -> vec3[]:
    l=cockpit_layout(kind)
    if l.kind!=.cabin or not l.copilot_dials or l.seats.len()<2:return []
    shift=cockpit_cluster_shift(kind);x=l.seats[1]-f64(l.eye.x)
    [vec3(x-0.12,-0.29,-0.74)+vec3(0,0,shift.z),vec3(x+0.12,-0.29,-0.74)+vec3(0,0,shift.z)]
cockpit_engine_gauges = (kind:Craft) -> vec3[]:
    l=cockpit_layout(kind)
    if l.kind!=.cabin or l.gauges==0:return []
    shift=cockpit_cluster_shift(kind)
    x=if l.seats.len()>1:l.seats[1]-f64(l.eye.x) else:0.0
    [loop k in 0..l.gauges:vec3(x+(f64(k)-f64(l.gauges-1)*0.5)*0.11,-0.50,-0.73+shift.z)]
# The quadrant's lever pivots, in the drawing frame (side by side or cabin: between the seats).
cockpit_quadrant = (kind:Craft) -> vec3[]:
    l=cockpit_layout(kind)
    if l.kind==.cabin:
        qx=(if l.seats.len()>1:(l.seats[0]+l.seats[1])*0.5 else:l.cx+0.3)-f64(l.eye.x)
        qw=0.05*f64(l.levers)+0.08
        return [loop k in 0..l.levers:vec3(qx-qw*0.5+0.06+f64(k)*0.05,-0.53,0.0)]
    if l.kind==.side_by_side and l.wheel:
        qx=(l.seats[0]+l.seats[1])*0.5-l.seats[0]
        return [loop k in 0..l.levers:vec3(qx+(f64(k)-f64(l.levers-1)*0.5)*0.06,-0.58,-0.25)]
    []
# The control wheels' hubs (pilot first), in the drawing frame.
cockpit_wheels = (kind:Craft) -> vec3[]:
    l=cockpit_layout(kind)
    if not l.wheel or l.seats.len()==0:return []
    [loop x in l.seats:vec3(x-l.seats[0],-0.40,-0.16)]

# One type's fixed cockpit: its instruments' faces and the cockpit round them (an open well or a
# cabin), in the drawing frame (cockpit_frame_local). CPU only: the tests read it.
cockpit_panel_vertices = (kind:Craft) -> Vertex3D[]:
    l=cockpit_layout(kind);vs:Vertex3D[];brass=rgb(0.64,0.49,0.26)
    cluster:Vertex3D[]
    _cockpit_cluster(cluster,kind)
    shift=cockpit_cluster_shift(kind)
    loop v in cluster:vs.push(Vertex3D(v.pos+shift,v.normal,v.uv,v.color))
    if l.kind==.cabin:
        vs.extend(cabin_interior(l))
        loop k in 0..cockpit_copilot_dials(kind).len():_cockpit_dial_face(vs,k,cockpit_copilot_dials(kind)[k],0.09)
        gauges=cockpit_engine_gauges(kind)
        loop k in 0..gauges.len():
            at=gauges[k]
            _cockpit_disc(vs,at,0.052,brass);_cockpit_disc(vs,at+vec3(0,0,0.003),0.045,rgb(0.035,0.045,0.04))
            loop tick in 0..11:
                angle=PI*1.25-f64(tick)*PI*1.5/10.0
                _cockpit_line(vs,at+vec3(cos(angle)*0.04,sin(angle)*0.04,0.006),at+vec3(cos(angle)*(if tick%5==0:0.031 else:0.035),sin(angle)*(if tick%5==0:0.031 else:0.035),0.006),0.0015,COCKPIT_LUMINOUS)
            _cockpit_label(vs,str(k+1),at+vec3(0,-0.022,0.007),0.011,COCKPIT_LUMINOUS)
        if gauges.len()>0:_cockpit_label(vs,"RPM",gauges[0]+vec3(-0.075,0,0.004),0.011,COCKPIT_LUMINOUS)
    else:
        seats=if l.kind==.side_by_side:[loop x in l.seats:x-l.seats[0]] else:[0.0]
        ox=if l.kind==.side_by_side:l.cx-l.seats[0] else:0.0
        _cockpit_open(vs,kind,ox,l.open_hw,seats)
    vs

build_cockpit = () -> Cockpit:
    c=Cockpit();c.moving_instruments=custom_mesh([Vertex3D(vec3(0,0,0),vec3(0,0,1),vec2(0,0),vec4(0,0,0,0))]);brass=rgb(0.64,0.49,0.26);ivory=rgb(0.94,0.87,0.66)
    c.cabin_moving=custom_mesh([Vertex3D(vec3(0,0,0),vec3(0,0,1),vec2(0,0),vec4(0,0,0,0))])
    loop id in 0..CRAFT_NAMES.len():c.panels.push(custom_mesh(cockpit_panel_vertices(Craft(id))))
    vs:Vertex3D[];ivory=COCKPIT_LUMINOUS
    _dial_triangle(vs,vec3(-0.015,-0.003,0),vec3(0.084,0,0),vec3(-0.015,0.003,0),ivory)
    _cockpit_disc(vs,vec3(0,0,0.001),0.009,brass)
    c.needle=custom_mesh(vs);vs=[]
    _dial_triangle(vs,vec3(-0.012,0,0),vec3(0.018,-0.008,0),vec3(0.018,0.008,0),ivory)
    _dial_triangle(vs,vec3(0.018,-0.008,0),vec3(0.05,0,0),vec3(0.018,0.008,0),ivory)
    _cockpit_disc(vs,vec3(0,0,0.001),0.011,brass)
    c.short_hand=custom_mesh(vs);vs=[]
    add_sphere(vs,vec3(0,0,0),0.055,rgb(0.35,0.19,0.09),8,4,scaling(vec3(0.8,0.7,1.2)))
    add_box(vs,vec3(0,-0.10,0.08),vec3(0.075,0.17,0.10),rgb(0.2,0.25,0.22))
    c.hand=custom_mesh(vs);vs=[]
    _cockpit_strut(vs,vec3(0,-0.4,0),vec3(0,0,0),0.012,rgb(0.19,0.2,0.17))
    _cockpit_strut(vs,vec3(-0.045,0,0),vec3(0.045,0,0),0.02,rgb(0.15,0.075,0.035))
    c.stick=custom_mesh(vs);vs=[]
    loop j in 0..18:
        x=sin(f64(j)*13.17)*0.29;y=sin(f64(j)*7.91)*0.15
        _cockpit_disc(vs,vec3(x,y,0),0.007+f64(j%4)*0.004,rgb(0.095,0.065,0.025))
        _cockpit_line(vs,vec3(x,y,0),vec3(x*1.03,y-0.04-f64(j%3)*0.02,0),0.004,rgb(0.14,0.09,0.025))
    c.oil=custom_mesh(vs);vs=[]
    loop j in 0..40:
        a=TAU*f64(j)/40.0;b=TAU*f64(j+1)/40.0
        _cockpit_line(vs,vec3(cos(a)*0.036,sin(a)*0.036,0),vec3(cos(b)*0.036,sin(b)*0.036,0),0.0015,rgb(0.23,0.18,0.1))
    _cockpit_line(vs,vec3(0,-0.16,0),vec3(0,-0.036,0),0.003,brass)
    _cockpit_disc(vs,vec3(0,0,0),0.002,brass)
    c.sight=custom_mesh(vs);vs=[]
    # The control wheel: a black rim on three brass spokes, its boss; the column (dark steel).
    loop j in 0..28:
        a=TAU*f64(j)/28.0;b=TAU*f64(j+1)/28.0
        _cockpit_strut(vs,vec3(cos(a)*0.17,sin(a)*0.17,0),vec3(cos(b)*0.17,sin(b)*0.17,0),0.016,rgb(0.08,0.06,0.04))
    loop k in 0..3:
        a=PI*0.5+TAU*f64(k)/3.0+PI
        _cockpit_strut(vs,vec3(0,0,0),vec3(cos(a)*0.165,sin(a)*0.165,0),0.008,brass)
    add_cylinder(vs,vec3(0,0,0),0.035,0.04,brass,10,transform=rotation_x(PI*0.5))
    c.wheel=custom_mesh(vs);vs=[]
    _cockpit_strut(vs,vec3(0,0,0),vec3(0,0.57,-0.12),0.026,rgb(0.17,0.18,0.17))
    add_box(vs,vec3(0,0.02,0),vec3(0.16,0.05,0.12),rgb(0.13,0.13,0.12))
    c.column=custom_mesh(vs);vs=[]
    c

# Each needle's reading from 0 to 1: airspeed, the altimeter's long hand (a turn per 1,000 m),
# rpm, oil pressure, heading.
cockpit_values = (spec:CraftSpec,state:CraftState) -> f64[]:
    running=if state.fuel>0:clamp(1.0-state.engine_damage,0.0,1.0) else:0.0
    profile=aircraft_profile(spec.kind)
    rated=(if profile.voice==.rotary:1400.0 else:if profile.voice==.inline:2400.0 else:1900.0)*profile.tone
    [clamp(true_speed(spec,f64(length(state.velocity)))*3.6/400.0,0.0,1.0),
        (max(0.0,f64(state.position.y))/1000.0)%1.0,
        (450.0+state.throttle*(rated-450.0))*running/4000.0,(0.25+state.throttle*0.5)*running,
        (heading(state)+TAU)%TAU/TAU]

# Preserve millimetre-sized dial details hundreds of kilometres from the chart origin. The
# model translation is made camera-relative BEFORE adding local vertices; never subtract two
# already rounded world-space gauge positions in the vertex shader.
cockpit_params = (L:Light,t:f64,model:mat4,cabin:bool=false,lamp:bool=true) -> ObjParams:
    p=obj_params(L,t,model)
    p.model=model;p.origin=vec3(0,0,0)
    p.view_proj[3]=vec4(0,0,-0.07000001,0)
    p.cam=vec3(0,0,0);p.warp_b=vec4(0,0,0,0)
    # Warm reflected light off fabric, varnished wood and the pilot's clothing.
    p.shade=mix(p.shade,vec3(0.72,0.6,0.44),0.8)
    p.sky=mix(p.sky,vec3(0.6,0.63,0.6),0.6)
    if cabin:
        # Under a roof: the sun reaches in only through the glass, and the rain stays outside.
        p.sun=p.sun*0.55;p.wet=0.0
    # After dark the cockpit lamp's warm light takes over from the moon's (a cabin's ceiling lamp
    # fills it; an open cockpit's panel lamp lights less). The dials' markings glow besides.
    night=1.0-smoothstep(-0.04,0.1,f64(normalize(L.sun_dir).y))
    if night>0.0 and lamp:
        glow=vec3(0.62,0.47,0.30);k=f32(night*(if cabin:0.9 else:0.7))
        p.sun=mix(p.sun,glow*0.8,k);p.shade=mix(p.shade,glow*0.7,k)
    p.plaster_bounce=paint_plaster_bounce(p.sun)
    p

cockpit_relative = (at:mat4,anchor:WorldPoint?=none) -> mat4:
    local=at;local[3]=vec4((at[3].xyz-scene_camera())+(if let point=anchor:world_residual(point) else:vec3(0,0,0))-render_eye_low,1);local

# rpm: the shaft's rad/s when known; the real blades show only below the spinning disc's speed.
draw_cockpit_airframe = (model:CraftModel,state:CraftState,at:mat4,L:Light,t:f64,prop:f64 = 0.0,rpm:f64 = -1.0):
    local=cockpit_relative(at,craft_point(state))
    loop i in 0..model.parts.len():
        if state.damage.parts[i].attached:
            draw(obj_sh,if i==0:model.cockpit_body else:if i==2 or i==3:model.cockpit_wings[i-2] else:model.parts[i].mesh,cockpit_params(L,t,lamp=false,model=local*model.parts[i].frame))
    if state.damage.parts[0].attached:
        loop wheel in model.wheels:draw(obj_sh,wheel.mesh,cockpit_params(L,t,lamp=false,model=local*wheel_frame(wheel,state.gear)))
    if state.damage.parts[1].attached and (if rpm>=0.0:not prop_disc_blurred(rpm) else:state.fuel<=0 or state.engine_damage>=0.98):
        loop i in 0..model.prop_hubs.len():draw(obj_sh,prop_mesh(model,i),cockpit_params(L,t,lamp=false,model=local*prop_frame(model,i,prop)))

# The cockpit's frame (its panels, windscreen and instruments) and the view it is drawn with.
cockpit_frame = (model:CraftModel,state:CraftState,at:mat4) -> mat4: cockpit_relative(at,craft_point(state))*translation(model.cockpit)
cockpit_view_proj = (L:Light,t:f64,frame:mat4) -> mat4: cockpit_params(L,t,frame).view_proj

draw_cockpit = (c:Cockpit,model:CraftModel,spec:CraftSpec,state:CraftState,at:mat4,L:Light,t:f64,controls:Controls = Controls(),scale:f64 = 5.0, instruments:FlightInstruments = FlightInstruments(), khz:f64 = 900.0, radio_on:bool = false, signal:f64 = 0.0, prop:f64 = 0.0, rpm:f64 = -1.0, prop_key:int = -1):
    kind=spec.kind;cabin=is_cabin(kind)
    P=(m:mat4)->ObjParams:cockpit_params(L,t,m,cabin)
    relative=cockpit_relative(at,craft_point(state))
    frame=relative*translation(cockpit_frame_local(model))
    draw(obj_sh,c.panels[int(kind)],P(frame))
    if state.damage.parts[1].attached:
        # Seen through the spinning disc (drawn later, with the transparent effects).
        spin=if rpm>=0.0:rpm else:if state.fuel>0 and state.engine_damage<0.98:8.0+70.0*state.throttle else:0.0
        queue_cockpit_prop_discs(model,relative,if rpm>=0.0:prop else:t*25.0,spin,L,t,prop_key)
    dials=frame*translation(cockpit_cluster_shift(kind))
    positions=cockpit_dials(kind);values=cockpit_values(spec,state)
    # (the altimeter's short hand, under its long one: a turn every 10,000 m)
    thousands=(max(0.0,f64(state.position.y))/10000.0)%1.0
    draw(obj_sh,c.short_hand,P(dials*translation(positions[1]+vec3(0,0,0.016))*rotation_z(PI*0.5-thousands*TAU)))
    loop j in 0..4:
        angle=if j==4:PI*0.5+values[j]*TAU else:if j==1:PI*0.5-values[j]*TAU else:PI*1.25-values[j]*PI*1.5
        if j==2 or j==3:angle+=sin(t*47.0)*0.012*state.throttle
        draw(obj_sh,c.needle,P(dials*translation(positions[j]+vec3(0,0,0.018))*rotation_z(angle)*scaling(if j<3:1.0 else:0.46)))
    draw_cockpit_instruments(c,dials,L,t,instruments,heading(state),khz,radio_on,signal,cabin)
    wheels=cockpit_wheels(kind)
    if wheels.len()>0:
        # Control wheels on columns: the column rocks with the elevator, the wheel turns with the
        # ailerons; the co-pilot's moves with the pilot's (they are linked).
        loop i in 0..wheels.len():
            hub=wheels[i]
            column=frame*translation(hub-vec3(0,0.57,-0.12))*rotation_x(controls.pitch*0.16)
            draw(obj_sh,c.column,P(column))
            wheel=column*translation(vec3(0,0.57,-0.12))*rotation_x(0.2)*rotation_z(-controls.roll*1.1)
            draw(obj_sh,c.wheel,P(wheel))
            if i==0:draw(obj_sh,c.hand,P(wheel*translation(vec3(-0.165,0.03,0.025))))
    else:
        stick=frame*translation(vec3(0,-0.60,-0.15))*rotation_x(controls.pitch*0.24)*rotation_z(-controls.roll*0.22)
        draw(obj_sh,c.stick,P(stick));draw(obj_sh,c.hand,P(stick))
    levers=cockpit_quadrant(kind)
    if levers.len()>0:
        # The quadrant's levers, the second airspeed and altimeter and the engines' gauges: one
        # mesh rebuilt each frame (no draw call per needle). The right hand rides the levers.
        vs:Vertex3D[];ivory=COCKPIT_LUMINOUS
        swing=-0.55+state.throttle*1.1
        tops:vec3[]
        loop k in 0..levers.len():
            pivot=levers[k];top=pivot+vec3(0,f32(cos(swing)*0.2),-f32(sin(swing)*0.2))
            _cockpit_strut(vs,pivot,top,0.007,rgb(0.12,0.12,0.11))
            add_sphere(vs,top,0.022,if k%2==0:rgb(0.55,0.08,0.05) else:rgb(0.1,0.09,0.08),6,3)
            tops.push(top)
        copilot=cockpit_copilot_dials(kind)
        loop k in 0..copilot.len():
            angle=if k==1:PI*0.5-values[1]*TAU else:PI*1.25-values[0]*PI*1.5
            _cockpit_needle(vs,copilot[k]+vec3(0,0,0.018),angle,0.07,ivory)
        gauges=cockpit_engine_gauges(kind)
        loop k in 0..gauges.len():
            angle=PI*1.25-values[2]*PI*1.5+sin(t*31.0+f64(k)*1.7)*0.02*state.throttle+f64(k%3)*0.015
            _cockpit_needle(vs,gauges[k]+vec3(0,0,0.009),angle,0.036,ivory)
        m=c.cabin_moving;update_mesh(m,vs);draw(obj_sh,m,P(frame))
        draw(obj_sh,c.hand,P(frame*translation((tops[0]+tops[tops.len()-1])*0.5+vec3(0,0.02,0.04))))
    else:
        throttle=frame*translation(vec3(-0.39,-0.43,-0.12-state.throttle*0.16))*rotation_z(0.3)
        draw(obj_sh,c.stick,P(throttle*scaling(0.55)))
        draw(obj_sh,c.hand,P(throttle))
    if state.engine_damage>0.3:draw(obj_sh,c.oil,P(dials*translation(vec3(0,0.02,-0.72))*scaling(min(1.0,(state.engine_damage-0.3)*2.5))))
    # (the gun sight: not on the cabin boats, which carry no forward guns)
    if not cabin:draw(obj_sh,c.sight,P(relative*translation(cockpit_sight(model,scale))))

# A needle laid into a rebuilt mesh: from the hub out to len at angle.
_cockpit_needle = (vs:mut Vertex3D[],at:vec3,angle:f64,len:f64,col:vec4):
    d=vec3(cos(angle),sin(angle),0);n=vec3(-sin(angle),cos(angle),0)
    _dial_triangle(vs,at-d*f32(len*0.18)-n*0.003,at+d*f32(len),at-d*f32(len*0.18)+n*0.003,col)
    _cockpit_disc(vs,at+vec3(0,0,0.001),0.006,rgb(0.64,0.49,0.26))

cockpit_eye = (model:CraftModel,state:CraftState) -> vec3:
    state.position+quat_rotate(state.orientation,cockpit_eye_local(model))

# The seat and its camera must share the drawn buoyancy/plunge pose. Keep the physical
# anchor precise, then apply only the small visual displacement and local head offset.
cockpit_pose_eye=(model:CraftModel,state:CraftState,pose:mat4,offset:vec3=vec3(0,0,0))->WorldPoint:
    rotation=pose;rotation[3]=vec4(0,0,0,1)
    anchor=world_offset(craft_point(state),pose[3].xyz-state.position)
    world_offset(anchor,transform_point(rotation,cockpit_eye_local(model)+offset))

place_cockpit_camera = (model:CraftModel,state:CraftState,yaw:f64,pitch:f64,t:f64 = 0.0,hit:f64 = 0.0,scale:f64 = 5.0,recoil:f64 = 0.0,tracking:vec3 = vec3(0,0,-1),weight:f64 = 0.0,pose:mat4?=none,head:vec3 = vec3(0,0,0),head_turn:vec3 = vec3(0,0,0)):
    running=if state.fuel>0:state.throttle*(1.0-state.engine_damage) else:0.0
    vibration=running*(0.002+state.engine_damage*0.006)
    # (the head jostled against the cockpit, head_shake: on top of where the pilot looks)
    offset=vec3(sin(t*61)*vibration,sin(t*47)*vibration,sin(t*53)*vibration*0.4)+head
    turned_pitch=pitch+f64(head_turn.x);turned_yaw=yaw+f64(head_turn.y)
    at=pose ?? (translation(state.position)*quat_to_mat4(state.orientation))
    eye=cockpit_pose_eye(model,state,at,offset)
    rotation=at;rotation[3]=vec4(0,0,0,1)
    zero=normalize(cockpit_zero(scale)-cockpit_eye_local(model))
    kick=vec3(sin(t*37)*hit*0.018,sin(t*43)*hit*0.024+recoil*0.004,0)
    local=quat_rotate(quat_euler(turned_pitch,turned_yaw,0),normalize(zero+kick))
    forward=blend_bearing(transform_point(rotation,local),tracking,weight)
    up=transform_point(rotation,vec3(0,1,0))
    if abs(dot(up,forward))>0.98:up=normalize(cross(forward,transform_point(rotation,vec3(1,0,0))))
    up=normalize(up*f32(cos(f64(head_turn.z)))+cross(forward,up)*f32(sin(f64(head_turn.z))))
    precise_camera(eye,forward,72.0,0.035,world_far(eye.y),up)

# All moving faces share the same camera-relative transform as the panel and its needles.
draw_cockpit_instruments = (c:Cockpit,frame:mat4,L:Light,t:f64,d:FlightInstruments,h:f64,khz:f64,on:bool,signal:f64,cabin:bool=false):
    vs:Vertex3D[];ivory=COCKPIT_LUMINOUS;ink=rgb(0.04,0.045,0.04);brass=rgb(0.64,0.49,0.26)
    at=vec3(-0.14,-0.54,-0.710);r=0.108
    loop sky in [false,true]:
        pts=horizon_half(d.pitch,d.bank,sky)
        color=if sky:rgb(0.28,0.51,0.67) else:rgb(0.40,0.25,0.12)
        loop j in 1..pts.len()-1:
            point=(p:vec2)->vec3:at+vec3(p.x*f32(r),p.y*f32(r),0)
            _dial_triangle(vs,point(pts[0]),point(pts[j]),point(pts[j+1]),color)
    loop degrees in [-20,-10,0,10,20]:
        y=(f64(degrees)*PI/180.0-d.pitch)*1.5
        if abs(y)>0.94:continue
        width=min(if degrees==0:0.92 else:0.24,sqrt(1.0-y*y)*0.95)
        point=(x:f64)->vec3:at+vec3((x*cos(d.bank)-y*sin(d.bank))*r,(x*sin(d.bank)+y*cos(d.bank))*r,0.001)
        _cockpit_line(vs,point(-width),point(width),0.0018,ivory)
    loop side in [-1.0,1.0]:
        _cockpit_line(vs,at+vec3(side*0.018,0,0.002),at+vec3(side*0.070,0,0.002),0.005,ivory)
        _cockpit_line(vs,at+vec3(side*0.018,0,0.002),at+vec3(side*0.018,-0.012,0.002),0.004,ivory)
    _cockpit_disc(vs,at+vec3(0,0,0.003),0.006,brass)
    loop degrees in [-60,-30,0,30,60]:
        a=f64(degrees)*PI/180.0
        _cockpit_line(vs,at+vec3(sin(a)*r*0.84,cos(a)*r*0.84,0.003),at+vec3(sin(a)*r*0.97,cos(a)*r*0.97,0.003),0.003,ivory)
    at=vec3(0.12,-0.54,-0.710)
    _cockpit_disc(vs,at,0.108,rgb(0.94,0.87,0.66))
    turn=clamp(d.turn/(PI/60.0),-2.0,2.0)*0.24
    pivot=at+vec3(0,-0.01,0.002)
    _cockpit_line(vs,pivot,pivot+vec3(sin(turn)*0.08,cos(turn)*0.08,0),0.005,ink)
    _cockpit_disc(vs,pivot+vec3(0,0,0.001),0.008,brass)
    _cockpit_label(vs,"2 MIN",at+vec3(0,0.025,0.003),0.012,ink)
    loop side in [-1.0,1.0]:
        _cockpit_line(vs,at+vec3(side*0.02,0.07,0.003),at+vec3(side*0.02,0.09,0.003),0.003,ink)
        _cockpit_label(vs,if side<0:"L" else:"R",at+vec3(side*0.075,0.055,0.003),0.014,ink)
    loop j in 0..16:
        a=-1.0+f64(j)/8.0;b=a+0.125
        _cockpit_line(vs,at+vec3(a*0.06,-0.065+a*a*0.015,0.002),at+vec3(b*0.06,-0.065+b*b*0.015,0.002),0.019,brass)
    _cockpit_disc(vs,at+vec3(d.slip*0.052,-0.065+d.slip*d.slip*0.015,0.004),0.010,ink)
    loop side in [-1.0,1.0]:_cockpit_line(vs,at+vec3(side*0.017,-0.052,0.005),at+vec3(side*0.017,-0.078,0.005),0.003,ink)
    # Compass card in its coaming case, clipped by selecting only visible graduations.
    at=vec3(0,-0.05,-0.712)
    _cockpit_quad(vs,at+vec3(-0.16,-0.032,0),at+vec3(0.16,-0.032,0),at+vec3(0.16,0.032,0),at+vec3(-0.16,0.032,0),ink)
    degrees=(h+TAU)%TAU*180.0/PI
    base=int(floor(degrees/10.0))*10
    loop tick in base-40..base+41:
        if tick%10!=0:continue
        x=(f64(tick)-degrees)*0.0037
        if abs(x)>0.148:continue
        _cockpit_line(vs,at+vec3(x,0.022,0.002),at+vec3(x,0.012,0.002),0.002,ivory)
        hd=((tick%360)+360)%360
        if abs(x)<0.135 and tick%30==0:
            name=if hd==0:"N" else:if hd==90:"E" else:if hd==180:"S" else:if hd==270:"W" else:str(hd/10)
            _cockpit_label(vs,name,at+vec3(x,-0.012,0.002),0.019,ivory)
    _dial_triangle(vs,at+vec3(-0.007,0.029,0.004),at+vec3(0.007,0.029,0.004),at+vec3(0,0.016,0.004),rgb(0.8,0.18,0.07))
    at=vec3(0.36,-0.54,-0.712)
    glow=if on:rgb(0.9,0.74,0.43) else:rgb(0.35,0.32,0.24)
    _cockpit_quad(vs,at+vec3(-0.082,-0.052,0),at+vec3(0.082,-0.052,0),at+vec3(0.082,0.052,0),at+vec3(-0.082,0.052,0),glow)
    loop tick in 0..11:
        frequency=600+tick*100;x=-0.072+0.144*(f64(frequency)-550.0)/1050.0
        _cockpit_line(vs,at+vec3(x,0.010,0.002),at+vec3(x,if tick%2==0:0.030 else:0.023,0.002),0.0014,ink)
        if tick%2==0:_cockpit_label(vs,str(frequency/100),at+vec3(x,-0.008,0.002),0.012,ink)
    x=-0.072+0.144*clamp((khz-550.0)/1050.0,0.0,1.0)
    _cockpit_line(vs,at+vec3(x,-0.020,0.004),at+vec3(x,0.036,0.004),0.003,rgb(0.7,0.08,0.035))
    _cockpit_label(vs,"RADIO",at+vec3(0,-0.038,0.002),0.012,ink)
    _cockpit_disc(vs,at+vec3(0.067,-0.038,0.003),0.005,if on:rgba(1,0.6+0.3*signal,0.15,0.8) else:ink)
    m=c.moving_instruments;update_mesh(m,vs);draw(obj_sh,m,cockpit_params(L,t,frame,cabin))

# The hit target uses exactly the dial's relative projection, not rounded world vertices.
cockpit_radio_rect = (model:CraftModel,at:mat4,anchor:WorldPoint?=none) -> Rect?:
    frame=cockpit_relative(at,anchor)*translation(cockpit_frame_local(model)+model.panel)
    vp=scene_view_proj();vp[3]=vec4(0,0,-0.07000001,0)
    lo=vec2(1e9,1e9);hi=vec2(-1e9,-1e9)
    loop x in [0.27,0.45]:
        loop y in [-0.605,-0.475]:
            clip=vp*frame*vec4(x,y,-0.712,1)
            if clip.w<=0.001:return none
            p=vec2((clip.x/clip.w*0.5+0.5)*f32(screen_width()),(0.5-clip.y/clip.w*0.5)*f32(screen_height()))
            lo=min(lo,p);hi=max(hi,p)
    if hi.x<0 or lo.x>f32(screen_width()) or hi.y<0 or lo.y>f32(screen_height()):return none
    Rect(f64(lo.x),f64(lo.y),f64(hi.x-lo.x),f64(hi.y-lo.y))
