# Physical cockpit hardware. The panel and needles live in aircraft coordinates, not the HUD.
use 'planes.jo'
use 'flight.jo'
use 'objects.jo'
use 'look.jo'
use 'render_space.jo'

struct Cockpit:
    panel: Mesh
    needle: Mesh

_dial_triangle = (vs: mut Vertex3D[],a: vec3,b: vec3,c: vec3,color: vec4):
    loop p in [a,b,c]:vs.push(Vertex3D(p,vec3(0,0,1),vec2(0,0),color))

build_cockpit = () -> Cockpit:
    vs:Vertex3D[]
    add_box(vs,vec3(0,0,-0.035),vec3(0.94,0.38,0.07),rgb(0.27,0.15,0.07))
    loop x in [-0.29,0.0,0.29]:
        loop j in 0..32:
            a=TAU*f64(j)/32.0;b=TAU*f64(j+1)/32.0
            _dial_triangle(vs,vec3(x,0,0.003),vec3(x+cos(a)*0.135,sin(a)*0.135,0.003),vec3(x+cos(b)*0.135,sin(b)*0.135,0.003),rgb(0.65,0.57,0.32))
            _dial_triangle(vs,vec3(x,0,0.006),vec3(x+cos(a)*0.118,sin(a)*0.118,0.006),vec3(x+cos(b)*0.118,sin(b)*0.118,0.006),rgb(0.08,0.085,0.075))
        loop j in 0..10:
            a=PI*0.75-f64(j)*PI*1.5/9.0
            m=translation(vec3(x,0,0.01))*rotation_z(a)
            add_box(vs,vec3(0.103,0,0),vec3(0.019,0.008,0.006),rgb(0.9,0.86,0.7),m)
    panel=custom_mesh(vs)
    vs=[]
    _dial_triangle(vs,vec3(-0.018,-0.014,0),vec3(0.103,0,0),vec3(-0.018,0.014,0),rgb(0.95,0.87,0.58))
    Cockpit(panel,custom_mesh(vs))

cockpit_anchor = (model: CraftModel) -> mat4: translation(model.cockpit+vec3(0,-0.07,-0.34))*rotation_x(-0.15)*scaling(0.65)

# Airspeed (0–130 m/s), altitude (0–1000 m), engine throttle. Simple period dials.
draw_cockpit = (c: Cockpit,model: CraftModel,spec: CraftSpec,state: CraftState,at: mat4,L: Light,t: f64):
    frame=at*cockpit_anchor(model)
    draw(obj_sh,c.panel,obj_params(L,t,frame))
    values=[clamp(true_speed(spec,f64(length(state.velocity)))/130.0,0.0,1.0),
        clamp(f64(state.position.y)/1000.0,0.0,1.0),state.throttle]
    loop j in 0..3:
        angle=PI*0.75-values[j]*PI*1.5
        draw(obj_sh,c.needle,obj_params(L,t,frame*translation(vec3((f64(j)-1.0)*0.29,0,0.018))*rotation_z(angle)))

cockpit_eye = (model: CraftModel,state: CraftState) -> vec3:
    state.position+quat_rotate(state.orientation,model.cockpit+vec3(0,0.08,0.08))

place_cockpit_camera = (model: CraftModel,state: CraftState,yaw: f64,pitch: f64):
    eye=cockpit_eye(model,state)
    local=quat_rotate(quat_euler(pitch,yaw,0),vec3(0,0,-1))
    forward=quat_rotate(state.orientation,local)
    up=quat_rotate(state.orientation,vec3(0,1,0))
    camera3d(eye,eye+forward*100.0,72.0,0.035,world_far(f64(eye.y)),up)
