# Guns, as Sky Barons has them: Space (or the left button, once the game has the mouse) fires the
# two guns in turn; bullets fly at their speed plus the aircraft's, under gravity, drawn as bright
# tracers; one striking the sea throws up a spout of spray and a ring of foam, the land a puff of
# dust and grit.

use 'look.jo'

struct Bullet:
    pos: vec3
    vel: vec3
    age = 0.0
    tracer = true

struct Guns:
    bullets: Bullet[]
    cool = 0.0                      # seconds till the next shot
    side = 1.0                      # which gun fires next
    heat = 0.0                      # (rises as they fire; for the sound and a stutter when hot)
    shots = 0                       # how many fired (for the sound)

struct Splash:
    pos: vec3
    born: f64
    size: f32

const BULLET_SPEED = 420.0
# (how many times faster than that the rounds go: the pause menu's Bullet speed, to keep pace with
# the drawn speeds)
bullet_scale = 5.0
set_bullet_scale = (x: f64):
    global bullet_scale
    bullet_scale = max(x, 0.5)
const FIRE_RATE = 11.0              # rounds a second, both guns together
const CONVERGE = 450.0              # meters ahead where the two guns' rounds meet

# fire while held: the guns at `muzzles` (aircraft frame), along its nose
fire = (g: mut Guns, held: bool, at: mat4, vel: vec3, muzzles: vec3[], dt: f64, flash: mut Particles3D):
    g.cool -= dt
    g.heat = max(0.0, g.heat - dt * 0.35)
    if not held or g.cool > 0.0 or muzzles.len() == 0: return
    g.cool = 1.0 / FIRE_RATE * (if g.heat > 0.85: 1.6 else: 1.0)
    g.heat = min(1.0, g.heat + 0.035)
    i = if g.side > 0.0: 0 else: muzzles.len() - 1
    g.side = -g.side
    m = muzzles[i]
    p = transform_point(at, m)
    fwd = normalize(transform_dir(at, vec3(0, 0, -1)))
    # (the wing guns harmonized: each laid to meet the other on the line of the nose CONVERGE
    # ahead, a little high for the drop; a little spread)
    meet = transform_point(at, vec3(0, 0.6 + f32(CONVERGE * CONVERGE * 0.00003), f32(-CONVERGE)))
    jitter = vec3(f32(random(-1.0, 1.0)), f32(random(-1.0, 1.0)), f32(random(-1.0, 1.0))) * 0.004
    g.bullets.push(Bullet(p, vel + normalize(normalize(meet - p) + jitter) * f32(BULLET_SPEED * bullet_scale), 0.0, true))
    # (the muzzle flash, and a puff of smoke left behind)
    emit(flash, p + fwd * 0.4, 5, 6.0, rgba(1.0, 0.75, 0.35, 1), 0.06, 0.35, 0.5, fwd)
    emit(flash, p, 2, 1.0, rgba(0.6, 0.6, 0.6, 0.5), 0.6, 0.4, PI, fwd)
    g.shots += 1

# bullets on their way: what they hit (sea height and ground height functions given)
update_bullets = (g: mut Guns, splashes: mut Splash[], ps: mut Particles3D, dust: mut Particles3D, sea: (f64, f64) -> f64, ground: (f64, f64) -> f64, t: f64, dt: f64):
    i = 0
    loop i < g.bullets.len():
        b = g.bullets[i]
        b.age += dt
        b.vel.y -= f32(9.8 * dt)
        np = b.pos + b.vel * f32(dt)
        gh = ground(f64(np.x), f64(np.z))
        sh = sea(f64(np.x), f64(np.z))
        hit_land = gh > 0.2 and f64(np.y) < gh
        hit_sea = not hit_land and f64(np.y) < sh
        if hit_sea:
            q = vec3(np.x, f32(sh), np.z)
            splashes.push(Splash(q, t, f32(random(0.8, 1.3))))
            emit(ps, q, 14, 9.0, rgba(0.95, 0.98, 1.0, 0.9), 1.1, 0.5, 0.25, vec3(0, 1, 0))
            emit(ps, q, 8, 4.0, rgba(0.9, 0.95, 1.0, 0.7), 0.7, 0.35, 1.2, vec3(0, 1, 0))
        if hit_land:
            q = vec3(np.x, f32(gh), np.z)
            emit(dust, q, 10, 5.0, rgba(0.62, 0.55, 0.45, 0.8), 1.2, 0.6, 0.8, vec3(0, 1, 0))
            emit(dust, q, 5, 9.0, rgba(0.3, 0.27, 0.22, 1), 0.6, 0.12, 0.9, vec3(0, 1, 0))
        if hit_sea or hit_land or b.age > 3.0:
            g.bullets.remove_at(i)
            continue
        b.pos = np
        g.bullets[i] = b
        i += 1
    # (splashes fade)
    loop splashes.len() > 0 and t - splashes[0].born > 2.5: splashes.remove_at(0)

# a tracer's streak, 1 long along -z from the origin (its head at -1, the way it flies): a hot
# yellow-white head, thickest just behind it, tapering back through orange to a dull red tail
# (Sky Barons' own)
_streak_mesh = () -> Mesh:
    vs: Vertex3D[]
    prof = [vec2(-1.0, 0.0), vec2(-0.93, 0.5), vec2(-0.78, 0.42), vec2(-0.35, 0.2), vec2(0.0, 0.0)]
    cols = [rgb(1.0, 1.0, 0.88), rgb(1.0, 0.9, 0.6), rgb(1.0, 0.55, 0.2), rgb(0.75, 0.16, 0.05)]
    n = 6
    ring = (i: int, k: int) -> vec3:
        a = TAU * f64(k % n) / f64(n)
        vec3(f32(cos(a) * f64(prof[i].y)), f32(sin(a) * f64(prof[i].y)), prof[i].x)
    loop i in 0..prof.len() - 1:
        loop k in 0..n:
            a = ring(i, k)
            b = ring(i, k + 1)
            c = ring(i + 1, k + 1)
            d = ring(i + 1, k)
            nrm = normalize(vec3(a.x + b.x, a.y + b.y, 0) + vec3(0, 0, 0.0001))
            vs.push(Vertex3D(a, nrm, vec2(0, 0), cols[i])); vs.push(Vertex3D(b, nrm, vec2(0, 0), cols[i])); vs.push(Vertex3D(c, nrm, vec2(0, 0), cols[i]))
            vs.push(Vertex3D(a, nrm, vec2(0, 0), cols[i])); vs.push(Vertex3D(c, nrm, vec2(0, 0), cols[i])); vs.push(Vertex3D(d, nrm, vec2(0, 0), cols[i]))
    custom_mesh(vs)

streak = Mesh()
streak_made = false

# the tracers, as Sky Barons draws them: a glowing streak behind each round, a few pixels wide
# at any distance (a close one a streak whizzing by, not a slab), never reaching back past the gun
# it left
draw_tracers = (g: Guns, scale: f64 = bullet_scale):
    global streak, streak_made
    if g.bullets.len() == 0: return
    if not streak_made:
        streak = _streak_mesh()
        streak_made = true
    cam = scene_camera()
    st: Instance3D[]
    loop b in g.bullets:
        if not b.tracer: continue
        d = normalize(b.vel)
        # (from behind, the chase camera sees them end on: a longer streak than Sky Barons' side
        # view needs, and a few pixels across however far)
        ln = min(14.0 * sqrt(scale), b.age * BULLET_SPEED * scale)
        if ln < 0.3: continue
        wd = max(0.06, 0.005 * f64(length(b.pos - cam)))
        st.push(instance(translation(b.pos - d * f32(ln)) * facing(d) * scaling(vec3(f32(wd), f32(wd), f32(ln))), rgb(1.0, 0.86, 0.72)))
    if st.len() > 0: draw_mesh_instanced(streak, st, emissive = 2.2, cast_shadow = false)

# the foam rings where rounds struck the water: widening, fading
draw_splash_rings = (splashes: Splash[], t: f64):
    loop s in splashes:
        age = t - s.born
        r = f64(s.size) * (0.6 + age * 2.2)
        a = f32(clamp(1.0 - age / 2.5, 0.0, 1.0) * 0.8)
        prev = s.pos + vec3(f32(r), 0.06, 0)
        loop k in 1..13:
            ang = f64(k) / 12.0 * TAU
            q = s.pos + vec3(f32(cos(ang) * r), 0.06, f32(sin(ang) * r))
            draw_line3d(prev, q, rgba(0.95, 0.97, 1.0, a), 0.08)
            prev = q
