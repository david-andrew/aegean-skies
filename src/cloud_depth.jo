use 'depth_space.jo'

# Take this snapshot outside draw_custom: copy_depth first flushes queued 3D.
# One opaque snapshot can reject hidden sea and inland water fragments alike.
water_depth = Texture()
water_depth_target = RenderTarget()

snapshot_water_depth = ():
    global water_depth, water_depth_target
    water_depth = Texture()
    if not world_logarithmic or not __post_active: return
    src = scene_depth()
    if src.id == 0: return
    if water_depth_target.texture.width != src.width or water_depth_target.texture.height != src.height:
        if water_depth_target.fbo != 0: free_render_target(water_depth_target)
        water_depth_target = render_target(src.width, src.height, depth_texture = true)
    copy_depth(src, water_depth_target)
    water_depth = water_depth_target.depth_texture

# The full-resolution cloud reconstruction blends straight onto the scene color
# while reading scene_depth(). A second framebuffer shares only the color and
# has its own disposable depth for the edge-repair mask. This avoids a scene
# depth copy (including on Metal) and leaves the library-owned target intact.
cloud_composite_fbo = 0
cloud_repair_buffer = 0
cloud_composite_color = Texture()
bind_cloud_composite = ():
    global cloud_composite_fbo, cloud_repair_buffer, cloud_composite_color
    target = __scene_rt.texture
    if cloud_composite_fbo == 0:
        cloud_composite_fbo = gl_create_framebuffer()
        cloud_repair_buffer = gl_create_renderbuffer()
    glBindFramebuffer(GL_FRAMEBUFFER, u32(cloud_composite_fbo))
    if target != cloud_composite_color:
        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(target.id), 0)
        glBindRenderbuffer(GL_RENDERBUFFER, u32(cloud_repair_buffer))
        glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, i32(target.width), i32(target.height))
        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, u32(cloud_repair_buffer))
        cloud_composite_color = target
