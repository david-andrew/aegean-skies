use 'depth_space.jo'
# A sampleable scene depth attachment, using the engine's existing portable
# depth-texture support. Its post target otherwise has an unsampleable renderbuffer.
# Detach it while sampling, avoiding WebGL framebuffer feedback; restore afterward.
cloud_scene_depth = Texture()
cloud_scene_fbo = 0

begin_cloud_depth = ():
    global cloud_scene_depth, cloud_scene_fbo
    if __soft:return
    if not __post_active:
        clear_world_depth();return
    rt = __scene_rt
    w = rt.texture.width; h = rt.texture.height
    if cloud_scene_depth.width != w or cloud_scene_depth.height != h:
        if cloud_scene_depth.id != 0: free_texture(cloud_scene_depth)
        id = gl_create_texture()
        glBindTexture(GL_TEXTURE_2D, u32(id))
        gl_tex_image(w, h, GL_DEPTH_COMPONENT24, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, null, 0)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, i32(GL_NEAREST))
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, i32(GL_NEAREST))
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, i32(GL_CLAMP_TO_EDGE))
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, i32(GL_CLAMP_TO_EDGE))
        cloud_scene_depth = Texture(id, w, h)
    cloud_scene_fbo = rt.fbo
    glBindFramebuffer(GL_FRAMEBUFFER, u32(rt.fbo))
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, u32(cloud_scene_depth.id), 0)
    glDepthMask(1)
    clear_world_depth()

detach_cloud_depth = ():
    glBindFramebuffer(GL_FRAMEBUFFER, u32(cloud_scene_fbo))
    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, u32(__scene_rt.depth))
    glDisable(GL_DEPTH_TEST)
    glDepthMask(0)

restore_cloud_depth = ():
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, u32(cloud_scene_depth.id), 0)
    glEnable(GL_DEPTH_TEST);glDepthFunc(world_depth_compare())

# An immutable, exact 24-bit copy for expensive materials whose fragment-depth
# output prevents hardware early rejection. A color-only target avoids feedback
# on WebGL2; three byte channels preserve the depth attachment's full precision.
struct DepthCopyVertex:
    corner:vec2
struct DepthCopyOut:
    pos:vec4
    uv:vec2
struct DepthCopyParams:
    depth:Texture
depth_copy_vs=(v:DepthCopyVertex,u:DepthCopyParams)->DepthCopyOut:DepthCopyOut(vec4(v.corner,0,1),v.corner*0.5+vec2(0.5,0.5))
depth_copy_fs=(i:DepthCopyOut,u:DepthCopyParams)->vec4:
    n=min(16777215.0,floor(sample(u.depth,i.uv).x*16777215.0+0.5))
    r=floor(n/65536.0);n-=r*65536.0
    g=floor(n/256.0)
    vec4(r,g,n-g*256.0,255)/255.0
opaque_depth_copy=RenderTarget()
opaque_depth_shader=Shader()
opaque_depth_quad=Mesh()
snapshot_opaque_depth=()->Texture:
    global opaque_depth_copy,opaque_depth_shader,opaque_depth_quad
    w=cloud_scene_depth.width;h=cloud_scene_depth.height
    if cloud_scene_depth.id==0:return Texture()
    if opaque_depth_copy.texture.width!=w or opaque_depth_copy.texture.height!=h:
        if opaque_depth_copy.fbo!=0:free_render_target(opaque_depth_copy)
        tex=texture(image(w,h),false);fbo=gl_create_framebuffer()
        glBindFramebuffer(GL_FRAMEBUFFER,u32(fbo))
        glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,u32(tex.id),0)
        opaque_depth_copy=RenderTarget(tex,fbo,0)
    if opaque_depth_shader.prog==0:
        opaque_depth_shader=make_shader(shader(depth_copy_vs,depth_copy_fs))
        opaque_depth_quad=mesh([DepthCopyVertex(vec2(-1,-1)),DepthCopyVertex(vec2(3,-1)),DepthCopyVertex(vec2(-1,3))])
    glBindFramebuffer(GL_FRAMEBUFFER,u32(opaque_depth_copy.fbo))
    glDisable(GL_DEPTH_TEST);glDepthMask(0);glDisable(GL_BLEND);glDisable(GL_CULL_FACE)
    draw(opaque_depth_shader,opaque_depth_quad,DepthCopyParams(cloud_scene_depth))
    glBindFramebuffer(GL_FRAMEBUFFER,u32(cloud_scene_fbo))
    glEnable(GL_DEPTH_TEST);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA)
    opaque_depth_copy.texture
