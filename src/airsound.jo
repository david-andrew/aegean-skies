# The sounds of going fast, made from noise the way recordings of them are built:
#   the rush of air: not a broad hiss but noise gathered into a howling band (about 400-700 Hz)
#     with fainter bands above it, all gliding slowly together, the loudness changing smoothly
#   wires and struts singing: a few narrow, wavering whistles (noise through very narrow
#     resonances, not pure tones)
#   the airframe working: panels bowing over the frame (oil-canning: a soft thump rung through a
#     few low plate modes that slide together in pitch, as the copper-sheet recording), rarely
#   cloth flapping: irregular sharp snaps, grouped in bursts, over a low flutter
# Loops are made a little long and their ends crossfaded into their starts, so they repeat with no
# seam or swell; speed then turns them up (set_pitch) and louder.

# ---------------- a small kit: a biquad filter, smooth randomness, seamless loops ----------------

struct Biquad:
    b0 = 0.0
    b1 = 0.0
    b2 = 0.0
    a1 = 0.0
    a2 = 0.0
    x1 = 0.0
    x2 = 0.0
    y1 = 0.0
    y2 = 0.0

# (a band around freq, q sharp: 0 dB at its peak)
bandpass = (f: mut Biquad, freq: f64, q: f64):
    w = TAU * min(freq, f64(MIX_RATE) * 0.45) / f64(MIX_RATE)
    alpha = sin(w) / (2.0 * q)
    a0 = 1.0 + alpha
    f.b0 = alpha / a0
    f.b1 = 0.0
    f.b2 = -alpha / a0
    f.a1 = -2.0 * cos(w) / a0
    f.a2 = (1.0 - alpha) / a0

lowpass = (f: mut Biquad, freq: f64, q: f64 = 0.707):
    w = TAU * min(freq, f64(MIX_RATE) * 0.45) / f64(MIX_RATE)
    alpha = sin(w) / (2.0 * q)
    c = cos(w)
    a0 = 1.0 + alpha
    f.b0 = (1.0 - c) * 0.5 / a0
    f.b1 = (1.0 - c) / a0
    f.b2 = (1.0 - c) * 0.5 / a0
    f.a1 = -2.0 * c / a0
    f.a2 = (1.0 - alpha) / a0

highpass = (f: mut Biquad, freq: f64, q: f64 = 0.707):
    w = TAU * min(freq, f64(MIX_RATE) * 0.45) / f64(MIX_RATE)
    alpha = sin(w) / (2.0 * q)
    c = cos(w)
    a0 = 1.0 + alpha
    f.b0 = (1.0 + c) * 0.5 / a0
    f.b1 = -(1.0 + c) / a0
    f.b2 = (1.0 + c) * 0.5 / a0
    f.a1 = -2.0 * c / a0
    f.a2 = (1.0 - alpha) / a0

filt = (f: mut Biquad, x: f64) -> f64:
    y = f.b0 * x + f.b1 * f.x1 + f.b2 * f.x2 - f.a1 * f.y1 - f.a2 * f.y2
    f.x2 = f.x1
    f.x1 = x
    f.y2 = f.y1
    f.y1 = y
    y

# (smooth randomness about 0, -1..1, changing `rate` times a second)
wander = (t: f64, rate: f64, seed: f64) -> f64: (noise(t * rate, seed) - 0.5) * 2.0

# (a mono buffer made into a seamless stereo loop: its last `fade` samples laid over its first,
# crossfaded at equal power; scaled to the loudness `rms`)
seamless = (m: f64[], fade: int, rms: f64) -> Sound:
    n = m.len() - fade
    sum = 0.0
    loop i in 0..n: sum += m[i] * m[i]
    g = rms / max(sqrt(sum / f64(n)), 1e-9)
    out = fill(f32(0), n * 2)
    loop i in 0..n:
        v = m[i]
        if i < fade:
            w = f64(i) / f64(fade) * PI * 0.5
            v = m[i] * sin(w) + m[n + i] * cos(w)
        out[i * 2] = f32(v * g)
        out[i * 2 + 1] = f32(v * g)
    Sound(out)

# (a one-shot: mono to stereo, scaled to a peak)
one_shot = (m: f64[], peak: f64) -> Sound:
    top = 0.0
    loop v in m: top = max(top, abs(v))
    g = peak / max(top, 1e-9)
    out = fill(f32(0), m.len() * 2)
    loop i in 0..m.len():
        out[i * 2] = f32(m[i] * g)
        out[i * 2 + 1] = f32(m[i] * g)
    Sound(out)

# ---------------- the rush of air ----------------

# the air going by: a howling band at about 520 Hz (at pitch 1), with fainter bands at 1.45 and
# 2.1 times it, gliding together by about a quarter over several seconds; a little body below and
# a little hiss above; the loudness wandering a few dB
make_rush = (seconds: f64 = 14.0, seed: int = 5) -> Sound:
    seed_random(seed)
    fade = MIX_RATE
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    b1 = Biquad(); b2 = Biquad(); b3 = Biquad(); body = Biquad(); hiss = Biquad(); top = Biquad(); top2 = Biquad()
    lowpass(body, 320.0)
    highpass(hiss, 2600.0)
    lowpass(top, 1500.0)
    lowpass(top2, 2400.0)
    gust = 1.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 32 == 0:
            gust = 1.0 + 0.3 * wander(t, 0.15, 3.0) + 0.08 * wander(t, 1.1, 6.0)
            fc = 520.0 * (1.0 + 0.24 * wander(t, 0.09, 1.0) + 0.06 * wander(t, 0.6, 2.0))
            bandpass(b1, fc, 5.0)
            bandpass(b2, fc * 1.45, 8.0)
            bandpass(b3, fc * 2.1, 10.0)
        x = random(-1.0, 1.0)
        v = filt(b1, x) * 1.0 + filt(b2, x) * 0.45 + filt(b3, x) * 0.2 + filt(body, x) * 0.18
        v = filt(top2, filt(top, v)) + filt(hiss, x) * 0.0025
        m[i] = v * gust
    seamless(m, fade, 0.22)

# wires and struts singing: four narrow noisy whistles, each wavering on its own, the strongest
# near 640 Hz (at pitch 1)
make_singing = (seconds: f64 = 12.0, seed: int = 11) -> Sound:
    seed_random(seed)
    fade = MIX_RATE / 2
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    tones = [640.0, 905.0, 1290.0, 1830.0]
    gains = [1.0, 0.55, 0.35, 0.18]
    bs: Biquad[] = [Biquad(), Biquad(), Biquad(), Biquad()]
    lv = [0.0, 0.0, 0.0, 0.0]
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        x = random(-1.0, 1.0)
        v = 0.0
        loop k in 0..4:
            if i % 32 == 0:
                bandpass(bs[k], tones[k] * (1.0 + 0.05 * wander(t, 0.3 + 0.15 * f64(k), 10.0 + f64(k))), 60.0)
                # (each comes and goes)
                lv[k] = gains[k] * max(0.0, 0.4 + 0.6 * wander(t, 0.15 + 0.06 * f64(k), 20.0 + f64(k)))
            v += filt(bs[k], x) * lv[k]
        m[i] = v
    seamless(m, fade, 0.18)

# ---------------- the airframe working ----------------

# ---------------- cloth flapping ----------------

# a streamer or scarf cracking in the wind: sharp snaps, about ten a second (at pitch 1) but
# uneven and grouped in bursts, each a crack of noise and a little thump, over a low flutter
make_flap = (seconds: f64 = 9.0, seed: int = 17) -> Sound:
    seed_random(seed)
    fade = MIX_RATE / 4
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    crack = Biquad(); rumble = Biquad(); thumpf = Biquad(); top = Biquad()
    bandpass(crack, 650.0, 0.9)
    lowpass(top, 2800.0)
    lowpass(rumble, 220.0)
    bandpass(thumpf, 110.0, 2.0)
    next = 0.0
    hit = -1.0                      # (when the last snap was, its loudness)
    amp = 0.0
    burst = 0.5
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 32 == 0:
            b = 0.5 + 0.5 * wander(t, 2.0, 4.0)
            burst = 0.12 + 0.88 * b * b
        if t >= next:
            # (snaps come faster in a burst)
            gap = 1.0 / (2.5 + 11.0 * burst)
            next = t + gap * random(0.4, 1.6)
            hit = t
            amp = random(0.35, 1.0) * burst
        a = t - hit
        snap = if a < 0.04: random(-1.0, 1.0) * exp(-a * 150.0) * amp else: 0.0
        thump = if a < 0.06: random(-1.0, 1.0) * exp(-a * 70.0) * amp else: 0.0
        flutter = random(-1.0, 1.0) * (0.25 + 0.2 * (0.5 + 0.5 * sin(t * TAU * 14.0))) * 0.25
        m[i] = filt(top, filt(crack, snap) * 1.0 + filt(thumpf, thump) * 1.6 + filt(rumble, flutter) * 0.6)
    seamless(m, fade, 0.16)

# ---------------- more layers, coming in as the speed builds ----------------

# the air buffeting: a low, gusty rumble (most of it 80-400 Hz), its loudness heaving
# irregularly a few times a second, as wind on a microphone or round an open cockpit
make_rumble = (seconds: f64 = 13.0, seed: int = 23) -> Sound:
    seed_random(seed)
    fade = MIX_RATE
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    lo = Biquad(); mid = Biquad(); top = Biquad()
    lowpass(lo, 190.0)
    bandpass(mid, 340.0, 1.1)
    lowpass(top, 900.0)
    heave = 1.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 32 == 0:
            g = 0.5 + 0.5 * wander(t, 1.6, 31.0) + 0.25 * wander(t, 5.0, 33.0)
            heave = 0.35 + 0.9 * max(g, 0.0) * max(g, 0.0)
        x = random(-1.0, 1.0)
        m[i] = filt(top, filt(lo, x) * 1.6 + filt(mid, x) * 0.7) * heave
    seamless(m, fade, 0.22)

# a higher howl: three bands near 900, 1150 and 1500 Hz (at pitch 1), narrow and gliding together
# a little, coming and going: what the wind does in rigging and gaps when it is really blowing
make_howl = (seconds: f64 = 15.0, seed: int = 29) -> Sound:
    seed_random(seed)
    fade = MIX_RATE
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    b1 = Biquad(); b2 = Biquad(); b3 = Biquad(); top = Biquad()
    lowpass(top, 2600.0)
    lv = 1.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 32 == 0:
            fc = 900.0 * (1.0 + 0.18 * wander(t, 0.12, 41.0) + 0.04 * wander(t, 0.9, 42.0))
            bandpass(b1, fc, 14.0)
            bandpass(b2, fc * 1.27, 16.0)
            bandpass(b3, fc * 1.66, 18.0)
            lv = max(0.0, 0.55 + 0.45 * wander(t, 0.2, 43.0))
        x = random(-1.0, 1.0)
        m[i] = filt(top, filt(b1, x) + filt(b2, x) * 0.7 + filt(b3, x) * 0.4) * lv
    seamless(m, fade, 0.16)

# heavy flapping: lower and denser than the streamers' snaps, a big cloth thrashing (most of it
# 100-1000 Hz), the beats coming in close runs
make_flap_heavy = (seconds: f64 = 8.0, seed: int = 37) -> Sound:
    seed_random(seed)
    fade = MIX_RATE / 4
    n = int(seconds * f64(MIX_RATE)) + fade
    m = fill(0.0, n)
    body = Biquad(); crack = Biquad(); top = Biquad()
    bandpass(body, 160.0, 1.4)
    bandpass(crack, 650.0, 0.9)
    lowpass(top, 3200.0)
    next = 0.0
    hit = -1.0
    amp = 0.0
    burst = 0.5
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 32 == 0:
            b = 0.5 + 0.5 * wander(t, 1.2, 47.0)
            burst = 0.2 + 0.8 * b
        if t >= next:
            next = t + 1.0 / (6.0 + 14.0 * burst) * random(0.5, 1.5)
            hit = t
            amp = random(0.4, 1.0) * burst
        a = t - hit
        x = if a < 0.08: random(-1.0, 1.0) * amp else: 0.0
        m[i] = filt(top, filt(body, x * exp(-a * 45.0)) * 1.5 + filt(crack, x * exp(-a * 110.0)) * 0.9)
    seamless(m, fade, 0.16)

# (a level read off a curve of points (x0, y0, x1, y1, ...), straight between them, flat beyond)
curve = (x: f64, pts: f64[]) -> f64:
    n = pts.len() / 2
    if x <= pts[0]: return pts[1]
    loop k in 1..n:
        x1 = pts[k * 2]
        if x <= x1:
            x0 = pts[k * 2 - 2]
            u = (x - x0) / max(x1 - x0, 1e-9)
            return pts[k * 2 - 1] + (pts[k * 2 + 1] - pts[k * 2 - 1]) * u
    pts[n * 2 - 1]

# ---------------- the airframe's panels, as the copper-sheet recording ----------------

# a panel bowing over its frame (oil-canning): a soft thump that sets a few low plate modes
# ringing, their pitch sliding as the panel pops through (up as it takes the load, down as it lets
# go): a deep "bwong", not a crack; no noise in it
make_oilcan = (seed: int, rising: bool) -> Sound:
    seed_random(seed * 7907 + (if rising: 3 else: 5))
    dur = random(0.45, 0.8)
    n = int(dur * f64(MIX_RATE))
    m = fill(0.0, n)
    lo = random(70.0, 115.0)
    hi = lo * random(1.5, 2.1)
    tau = random(0.04, 0.09)
    ratios = [1.0, 1.59, 2.14, 2.92]
    gains = [1.0, 0.55, 0.3, 0.15]
    rs: Biquad[] = [loop k in 0..4: Biquad()]
    top = Biquad()
    lowpass(top, 1400.0)
    strike = random(0.004, 0.008)
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 16 == 0:
            s = 1.0 - exp(-t / tau)
            f0 = if rising: lo + (hi - lo) * s else: hi + (lo - hi) * s
            loop k in 0..4: bandpass(rs[k], f0 * ratios[k], 60.0)
        # (the thump: half a sine, smooth, a few milliseconds)
        x = if t < strike: sin(t / strike * PI) else: 0.0
        v = 0.0
        loop k in 0..4: v += filt(rs[k], x) * gains[k]
        m[i] = filt(top, v) * (1.0 - smoothstep(dur * 0.55, dur, t))
    one_shot(m, 0.7)

# ---------------- another aircraft going by, as the fly-by recordings ----------------

# an aircraft's engine heard from outside: the propeller's and the cylinders' buzz, a strong
# harmonic series on 96 Hz (at pitch 1) reaching past a kilohertz, roughened, with the
# propeller's broadband rush under it. Four seconds, a whole number of cycles, so it loops clean.
make_flyby = (seed: int = 51) -> Sound:
    seed_random(seed)
    f0 = 96.0
    fade = MIX_RATE / 4
    n = 4 * MIX_RATE + fade
    m = fill(0.0, n)
    amps = [loop k in 1..17: (1.0 / pow(f64(k), 0.75)) * random(0.55, 1.0)]
    wash = Biquad(); wtop = Biquad(); top = Biquad()
    bandpass(wash, 700.0, 0.6)
    lowpass(wtop, 3200.0)
    lowpass(top, 4500.0)
    rough = 1.0
    loop i in 0..n:
        t = f64(i) / f64(MIX_RATE)
        if i % 32 == 0: rough = 1.0 + 0.12 * wander(t, 11.0, 52.0) + 0.06 * wander(t, 2.0, 53.0)
        ph = t * f0
        x = ph - floor(ph)
        v = 0.0
        loop k in 0..16: v += sin(x * TAU * f64(k + 1) + f64(k) * 1.7) * amps[k]
        # (the cylinders: every other beat a little harder)
        beat = 1.0 + 0.18 * sin(x * PI)
        noise = filt(wtop, filt(wash, random(-1.0, 1.0))) * 2.2
        m[i] = filt(top, v * 0.45 * beat * rough + noise * (0.6 + 0.4 * rough))
    seamless(m, fade, 0.2)
