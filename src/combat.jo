use 'world_point.jo'
# Deterministic physical engagements. IDs refer to living-world people/aircraft; no economy,
# rescue, spawning of inhabitants, device reads or random() calls occur here.
use 'flight.jo'
use 'flight_v2.jo'
use 'tweaks.jo'
from 'air_pilot.jo' import air_waypoint_controls, air_runway, AirRunway
use 'damage.jo'
use 'bailout.jo'
from 'planes.jo' import Craft, aircraft_profile, PartId

const COMBAT_DT = 1.0/60.0
const COMBAT_MAX_CRAFT = 128
const COMBAT_MAX_ROUNDS = 2048

enum CombatRole: fighter, wingman, strike, escort, flee
enum CombatMode: pursuit, scissors, breakaway, regroup, evade, strafe, withdrawing, down, lag, break_turn, head_on, extend, unload, zoom, cover, approach, homeward, ditching
enum CombatStatus: flying, disabled, escaped, wreck

enum CombatEventKind: shot, hit, ignition, separated, downed, bailed, landed, fled, splash, boat_disabled
struct CombatEvent:
    serial: int
    kind: CombatEventKind
    craft: int
    person: int
    other: int
    position: vec3
    direction: vec3 = vec3(0,1,0)
    strength = 1.0
    part: PartId = .body

struct CombatOutcome:
    serial: int
    engagement: int
    craft: int
    person: int
    kind: CombatEventKind
    attacker: int
    position: vec3
    hull: f64
    engine: f64
    injury = 0.0
    at_sea = false
    boat = -1

struct GunSpec:
    rate: f64
    damage: f64
    spread: f64
    voice: int
    mounts: int

gun_spec = (kind: Craft) -> GunSpec:
    match kind:
        .corsair, .kestrel: GunSpec(14,0.12,0.003,2,2)
        .osprey, .cormorant: GunSpec(11,0.105,0.003,1,2)
        .pelican, .albatross: GunSpec(8,0.10,0.004,2,2)
        .tern, .kite, .ibis, .minnow: GunSpec(8,0.09,0.004,0,1)
        _: GunSpec(11,0.10,0.003,1,2)

gun_mounts = (kind: Craft, count: int = 0) -> vec3[]:
    p = aircraft_profile(kind)
    y = if p.boat: p.width+0.15 else: p.width*0.5
    z = -p.length*0.38
    if (if count>0:count else:gun_spec(kind).mounts) == 1: [vec3(0,y,z)]
    else: [vec3(-p.width*0.8,y,z),vec3(p.width*0.8,y,z)]

struct CombatGun:
    locked = true
    cool = 0.0
    heat = 0.0
    jammed = false
    ammo = 700
    shots = 0
    choice = 0                     # human only: rapid, light, medium, heavy
    endless = false
    player_loaded = false

const PLAYER_AMMUNITION = 10000
PLAYER_GUN_NAMES = ["Rapid", "Light", "Medium", "Heavy"]

# The rapid option restores guns.jo's 11 Hz, all-tracer stream and gentle heat slowdown.
# Period guns retain their heat/jam rules. Neither setting changes NPC armament.
player_gun_spec = (choice: int) -> GunSpec:
    match choice:
        1: GunSpec(8,0.09,0.004,0,1)
        2: GunSpec(11,0.105,0.003,1,2)
        3: GunSpec(14,0.12,0.003,2,2)
        _: GunSpec(11,0.10,0.003,1,2)

combat_gun_spec = (a: Combatant) -> GunSpec:
    if a.human:player_gun_spec(a.gun.choice) else:gun_spec(a.spec.kind)

configure_player_gun = (a: mut Combatant, choice: int, endless: bool):
    if not a.human:return
    if not a.gun.player_loaded:
        a.gun.ammo=PLAYER_AMMUNITION;a.gun.player_loaded=true
    a.gun.choice=clamp(choice,0,3);a.gun.endless=endless

struct CombatPilot:
    skill = 0.6
    nerve = 0.65
    role: CombatRole = .fighter
    leader = -1                    # stable aircraft ID
    target = -1                    # cached local index, never a world ID
    boat = -1
    mode: CombatMode = .regroup
    hold = 0
    brain_tick = -1
    target_tick = -60
    controls: Controls = Controls()
    trigger = false
    formation = false              # optional approach; contact permanently releases the slot
    launching = false              # taking off from the water on `plan` (a sortie's start); at height, formation
    # A personality, with skill and nerve: aggression presses attacks, holds head-on passes, fires
    # from further and skips lag pursuit (and so overshoots); caution watches its tail and breaks
    # sooner, extends to reset a fight it is not winning, and keeps with its pair.
    aggression = 0.5
    caution = 0.5
    simple = false                 # a plain lead-pursuit pilot (the dogfight harness's player seat)
    wing = -1                      # a wingman's pair leader (aircraft ID); else its formation leader
    commit = 0                     # the tick the current manoeuvre is held until
    turn = 1.0                     # which way it breaks or extends (+1 right)
    away: vec3 = vec3(0,0,-1)      # an extension's heading
    threat = -1                    # local index of the enemy on its tail, once noticed
    noticed = -1                   # the tick that threat was first seen
    stalemate = 0                  # ticks of a turning fight with no angle gained
    best_angle = 3.2               # the smallest angle off the nose to the target lately
    breaking = 0                   # ticks spent breaking from an attacker without respite
    close = false                  # in a gun fight (a target near): thinks every few ticks, however far
    scripted = false               # flown by its caller (a test's stand-in player): no brain of its own
    aim_dir: vec3                  # the gun aim's direction at the last look, and when, and at whom
    aim_tick = -1
    aim_of = -1
    formation_heading = 0.0
    formation_speed = 0.0
    formation_offset: vec3
    # Going home (src/combat.jo _homeward): the turn to land in, the flight plan once it is its
    # turn, when the leader began its descent, and done (moored at the base).
    home_turn = -1
    rallied = false                # come in to the rally point after the fight
    climber = false                # a pilot who uses height: over the cloud deck before closing, down from above
    plan: FlightPlan = FlightPlan()
    descend_tick = -1
    home_done = false
    # A v2 stick commands rates. Steer the last requested direction between decisions.
    hold_want = vec3(0,0,0)
    hold_cap = true
    held_sight = false
    sight_rate = vec3(0,0,0)
    sight_since = -1

struct HitMark:
    local: vec3
    normal: vec3
    part: PartId

struct Combatant:
    craft: int
    person: int
    side: int
    spec: CraftSpec
    state: CraftState
    pilot: CombatPilot = CombatPilot()
    gun: CombatGun = CombatGun()
    status: CombatStatus = .flying
    external = false               # integrated by its existing human/traffic owner
    human = false
    present = true
    model = -1
    engagement = -1
    rally: vec3 = vec3(0,300,0)     # this engagement's origin, independent of other contacts
    previous_point:WorldPoint?=none
    previous: vec3 = vec3(0,0,0)
    previous_rotation: vec4 = vec4(0,0,0,1)
    render_ready = false
    fire = 0.0
    fire_age = 0.0
    last_attacker = -1
    pilot_hit = false              # the pilot struck (an NPC is out of the fight; it goes down)
    bailed = false
    down_reported = false
    wreck_age = 0.0
    last_wet = false
    marks: HitMark[]
    prop = 0.0
    lod = 0
    ditched = false                # put down on the water rather than bailed out of; the pilot is out

struct CombatBoat:
    id: int
    side: int
    position: vec3
    velocity: vec3
    half: vec3 = vec3(5,3,15)
    health = 1.0
    disabled = false
    external = false              # a vessel adapter already integrated this body
    yaw = 0.0                     # bow +z; hull hitbox rotates with the vessel
    attacker = -1

# Ground fire: riflemen and machine-gun posts that a scenario places. Each is a fixed physical gun
# with a stable negative owner ID (never an aircraft or a person). Its rounds are ordinary Rounds:
# the same hit tests, damage, events, tracers and near-pass sounds as an aircraft's. Posts are
# hit too (a small ellipsoid each) and fall silent when their health runs out.
enum GroundGunKind: rifle, machine_gun
struct GroundGun:
    id: int                        # stable and negative
    side: int
    position: vec3                 # the gun's pivot (a rifleman's shoulder, a tripod's head)
    kind: GroundGunKind = .rifle
    facing = 0.0                   # the yaw the post looks out along
    arc = PI                       # how far either side of it the gun can swing (a nest's parapet)
    reach = 650.0
    skill = 0.45
    health = 1.0
    disabled = false
    wake = 0                       # holds fire until this tick
    target = -1                    # local actor index, chosen on its brain ticks
    seen = -1                      # the tick it first had this target in sight
    cool = 0.0
    burst = 0
    shots = 0
    aim: vec3 = vec3(0,0,-1)       # where it points now
    half: vec3 = vec3(0.45,0.9,0.45)

struct Round:
    position: vec3
    velocity: vec3
    owner: int                     # aircraft ID, not array position
    side: int
    damage: f64
    age = 0.0
    tracer = true
    point:WorldPoint?=none
    serial = -1                    # stable shot identity for one-shot presentation feedback
    wide = 0.0                     # metres round each part this round still hits (the player's, generous)
    assist = -1                    # the aircraft (ID) this round curves toward (the player's, aim assist)

struct RoundSweep:
    owner: int
    serial: int
    start: vec3
    end: vec3

struct Battle:
    enabled = false
    engagement = -1
    seed: int = 1
    tick = 0
    center: vec3 = vec3(0,300,0)
    retreat_radius = 5000.0
    bullet_scale = 1.0
    actors: Combatant[]
    boats: CombatBoat[]
    rounds: Round[]
    ground: GroundGun[]            # scenario ground fire; empty for ordinary engagements
    sweeps: RoundSweep[]           # this tick, including rounds consumed by a collision
    descents: Descent[]
    events: CombatEvent[]           # presentation drains each fixed tick
    outcomes: CombatOutcome[]       # durable until the world acknowledges them
    render_alpha = 1.0              # presentation only; never used by hit tests or flight
    next_serial = 0
    pair_tests = 0
    narrow_tests = 0
    brain_steps = 0
    physics_steps = 0
    finished = false
    tactics: int[]                 # how often each CombatMode was entered (by its index)
    ceiling = 1e9                  # a soft top for the fight (under the thrust's fade): climbs ease under it
    deck_base = 1e9                # a cloud deck's base and top over the fight: passed through, never
    deck_top = 1e9                 # flown in (nobody can see in it), and enemies in it unseen
    homes: BattleHome[]            # each side's base harbour, where it goes home to (none: away)
    home_since: int[] = [-1,-1,-1] # the tick each side (by index) turned for home
    rally: vec3[] = [vec3(0,0,0),vec3(0,0,0),vec3(0,0,0)]   # where each side regroups after the fight
    formed: int[] = [-1,-1,-1]     # the tick each side, regrouped, formed up for home (-1: not yet)
    orders: FlightOrder[] = [FlightOrder(),FlightOrder(),FlightOrder()]   # each side's last word on the radio
    assist: Assist = Assist()      # the one sent down to the player on the sea (radio_help.jo)
    strength: int[] = [0,0,0]      # how many each side began with
    home_leg: int[] = [-2,-2,-2]   # each side's leg of its home's way round (via index, outer first; -1 straight in, -2 not yet chosen)
    managed: bool[] = [false,false,false]   # sides a sortie sends home itself (sortie.jo), not the fight's own judging
    apart_since: int[] = [-1,-1,-1] # the tick each side lost touch with the enemy (-1: in touch)

# A word on the radio to one's own flight (the player's R/T): form on me, circle here and wait,
# attack my target, break off and go home, lead me home. Held until another; an attack until its
# target is down. A pilot with an enemy on its tail and close looks after itself first.
enum OrderKind: none, form_on_me, circle, attack, go_home, lead_home
struct FlightOrder:
    kind: OrderKind = .none
    tick = -1
    by = -1                        # who gave it (aircraft ID)
    at: vec3 = vec3(0,0,0)         # where (circle here)
    target = -1                    # the aircraft to attack (ID)

# One of the flight sent down to the player on the sea: it lands off to one side, taxis to lie
# alongside and waits there (stage 2) while the cans are handed over, then takes off and goes on
# (stage 3) until the caller lets it go.
struct Assist:
    craft = -1
    stage = 0                      # 0 none, 1 coming, 2 alongside, 3 off again
    alongside: vec3 = vec3(0,0,0)  # where it comes to rest, beside the player's aircraft

# Sends `craft` down to lie at `alongside`: it touches down into the wind (`wind`), well short and
# off to the side, so its run out ends clear of the aircraft it comes to.
send_assist = (b: mut Battle, craft: int, alongside: vec3, wind: vec3):
    i = combat_index(b,craft)
    if i < 0: return
    w = vec3(wind.x,0,wind.z)
    h = if length(w) > 1.0: atan2(-f64(w.x),f64(w.z)) else: heading(b.actors[i].state)
    into = heading_vector(h); side = vec3(-into.z,0,into.x)
    touchdown = alongside-into*700.0+side*90.0
    b.assist = Assist(craft = craft, stage = 1, alongside = alongside)
    p = b.actors[i].pilot
    p.plan = FlightPlan(target = touchdown, taxi_target = alongside, altitude = max(250.0,f64(alongside.y)+250.0), landing_heading = h, phase = .cruise, speed = b.actors[i].spec.cruise_speed*0.8)
    p.target = -1; p.trigger = false; p.brain_tick = -1
    b.actors[i].pilot = p

# Follow a drifting pickup. Keep a short adjustment for the taxi, and replan
# the approach if the displacement exceeds the whole touchdown-to-pickup run.
move_assist = (b: mut Battle, alongside: vec3, wind: vec3) -> bool:
    i = combat_index(b,b.assist.craft)
    if i < 0 or b.assist.stage != 1: return false
    a = b.actors[i]; plan = a.pilot.plan
    if plan.phase == .taxi or plan.phase == .done:
        if a.state.moored: unmoor(a.state)
        a.pilot.plan.taxi_target = alongside
        a.pilot.plan.phase = .taxi
        a.pilot.brain_tick = -1
        b.actors[i] = a; b.assist.alongside = alongside
        return true
    if (plan.phase == .cruise or plan.phase == .descend) and length((alongside - plan.taxi_target).xz) > length((plan.target - plan.taxi_target).xz):
        send_assist(b,a.craft,alongside,wind)
        return true
    false

# Off again from alongside: a take-off into the wind and a climb away ahead.
release_assist = (b: mut Battle, wind: vec3):
    i = combat_index(b,b.assist.craft)
    if i < 0 or b.assist.stage == 0: b.assist = Assist(); return
    a = b.actors[i]
    w = vec3(wind.x,0,wind.z)
    h = if length(w) > 1.0: atan2(-f64(w.x),f64(w.z)) else: heading(a.state)
    if a.state.moored: unmoor(a.state)
    a.pilot.plan = FlightPlan(target = a.state.position+heading_vector(h)*20000.0, altitude = 300.0, takeoff_heading = h, phase = .takeoff)
    # (the anchor let go now, not at its next look round: else it would lie moored on)
    a.pilot.controls = Controls(throttle = 0.3); a.pilot.brain_tick = -1
    b.actors[i] = a
    b.assist.stage = 3

# Flown home with the player aboard (the flight skipped behind the dark card): moored at its own
# side's base, at its place along the quay, done; the assist over. False with no base.
assist_home = (b: mut Battle) -> bool:
    i = combat_index(b,b.assist.craft)
    if i < 0 or not _has_home(b,b.actors[i].side): return false
    a = b.actors[i]
    h = _home_of(b,a.side)
    slot = h.dock+h.step*f32(max(0,a.pilot.home_turn))
    a.state = water_start(a.spec,vec3(slot.x,0,slot.z),h.heading)
    moor(a.state,a.state.position,h.heading)
    a.previous = a.state.position; a.previous_point = world_point(a.state.position); a.previous_rotation = a.state.orientation
    a.pilot.mode = .homeward; a.pilot.home_done = true; a.pilot.plan = FlightPlan()
    a.pilot.controls = Controls(throttle = 0.0, water_brake = 1.0, anchor = true)
    b.actors[i] = a
    b.assist = Assist()
    true

# Done with: back to the flight (a fresh plan, so going home plans again from where it is).
end_assist = (b: mut Battle):
    i = combat_index(b,b.assist.craft)
    if i >= 0:
        a = b.actors[i]
        a.pilot.plan = FlightPlan()
        if a.status == .flying and a.side >= 0 and a.side < b.home_since.len() and b.home_since[a.side] >= 0:
            a.pilot.mode = .homeward
            a.pilot.descend_tick = -1; a.pilot.home_done = false
        b.actors[i] = a
    b.assist = Assist()

_assist = (b: Battle, index: int, e: FlightEnv, p: mut CombatPilot) -> CombatPilot:
    a = b.actors[index]; s = a.state; k = a.spec
    p.mode = .regroup; p.trigger = false; p.target = -1
    if b.assist.stage == 2 or p.plan.phase == .done:
        p.controls = Controls(throttle = 0.0, water_brake = 1.0, anchor = b.assist.stage != 3)
        if b.assist.stage != 3: return p
    c = autopilot(k,s,p.plan,e)
    # (waved off: round again; off the water again, on with the climb)
    if p.plan.phase == .failed:
        p.plan.phase = if s.on_water: FlightPhase.takeoff else: FlightPhase.cruise
        p.plan.go_arounds = 0
    p.controls = c
    p

# Off the water at a sortie's start: the plan's take-off and climb flown, then (at height) into
# formation on the leader, the brain's own from there.
_launch = (b: Battle, index: int, e: FlightEnv, p: mut CombatPilot) -> CombatPilot:
    a = b.actors[index]; s = a.state; k = a.spec
    p.mode = .regroup; p.trigger = false; p.target = -1
    if s.moored: p.controls = Controls(throttle = 0.2); return p
    p.controls = autopilot(k,s,p.plan,e)
    if p.plan.phase == .takeoff and s.on_water and abs(angle_delta(p.plan.takeoff_heading,heading(s))) > 0.3:
        # (turned onto the take-off's way at a taxiing pace first: opened up while still turning, a
        # seaplane lying along a quay runs on the way it lay, into the shore)
        p.controls = Controls(throttle = 0.3, yaw = clamp(angle_delta(p.plan.takeoff_heading,heading(s))*2.0,-1.0,1.0), assist = 0.0)
    if p.plan.phase == .climb or p.plan.phase == .cruise:
        # (off the water: straight on up the way it took off, which was clear, to its height; the
        # autopilot's own climb turns for the route's far end, or circles at the start under a
        # ridge beyond, both maybe over the shore it lifted from)
        ahead = vec3(s.position.x,0,s.position.z)+heading_vector(p.plan.takeoff_heading)*2000.0
        p.controls = air_waypoint_controls(k,s,e,ahead,max(p.plan.altitude,200.0),k.cruise_speed*0.8)
        p.plan.phase = if s.on_water: FlightPhase.takeoff else: FlightPhase.climb
        p.plan.go_arounds = 0
    if not s.on_water and f64(s.position.y) > 150.0:
        p.launching = false; p.formation = true; p.plan = FlightPlan()
    p

# A side's base: where its aircraft touch down (on `heading`), the first mooring and the step
# between moorings along the quay, and the height they come home at.
struct BattleHome:
    side: int
    touchdown: vec3
    heading: f64
    dock: vec3
    step: vec3
    altitude = 320.0
    place = -1                      # the world's place ID (for the deeds and the dock)
    centre: vec3 = vec3(0,0,0)      # the harbour's waterfront and its way out to sea (for the runway)
    out: vec3 = vec3(0,0,1)
    name = ""                       # what it is called when it is no town (a tender)
    via: vec3[]                     # a way round to it by low ground, home end first (the tender's round the island)
    afloat = false                  # a ship lying off (the tender): the landing run ends abreast of her

# Where to land at home in this wind: the traffic's own choice of water (air_runway), clear of the
# shore ahead; else the base's own touchdown.
home_runway = (h: BattleHome, e: FlightEnv) -> (vec3,f64):
    global _ship_runways
    # (the run out after a landing at the combat's pure-scale speeds is long: clear water for it)
    rw = air_runway(h.centre,h.out,e.wind,e.ground,h.altitude,rollout=1900.0)
    if not rw.valid: return (h.touchdown,h.heading)
    if h.afloat:
        # (found once for her and a wind: the search samples a lot of ground)
        loop c in _ship_runways:
            if length(c.0-h.centre) < 1.0 and length(c.1-e.wind) < 0.5: return (c.2,c.3)
        found = _ship_runway(h,e,rw)
        _ship_runways.push((h.centre,e.wind,found.0,found.1))
        if _ship_runways.len() > 16: _ship_runways.remove_at(0)
        return found
    (rw.touchdown,rw.heading)

_ship_runways: (vec3,vec3,vec3,f64)[]

_ship_runway = (h: BattleHome, e: FlightEnv, rw: AirRunway) -> (vec3,f64):
    # (at a ship: put down so the run ends abreast of her, a few hundred metres off her side by her
    # moorings, each in and made fast while the rest are still landing, not a long taxi back from
    # a mile past her; on a line clear of her, the approach and run over water as the runway's)
    # (across the wind as far as a light wind allows, when the high ground lies under the way in
    # from straight downwind of her)
    approach = max(1800.0,h.altitude/0.065+500.0)
    wind = f64(length(e.wind.xz))
    loop turn in [0.0,0.35,-0.35,0.7,-0.7,1.0,-1.0]:
        if wind*abs(sin(turn)) > 6.0: continue
        heading = rw.heading+turn
        dir = heading_vector(heading); side = vec3(-dir.z,0,dir.x)
        loop lateral in [320.0,-320.0,480.0,-480.0]:
            loop along in [0.0,250.0,-250.0]:
                end = h.centre+side*f32(lateral)+dir*f32(along)
                short = end-dir*f32(SHIP_RUN)
                clear = true
                loop i in 0..32:
                    if not clear: break
                    d = -approach+f64(i)*(approach+SHIP_RUN)/31.0
                    ceiling = if d < -600.0: max(0.0,-d*0.065-100.0) else: 0.0
                    loop lane in [-60.0,0.0,60.0]:
                        q = short+dir*f32(d)+side*f32(lane)
                        if e.ground(f64(q.x),f64(q.z)) > ceiling: clear = false
                if clear: return (short,heading)
    (rw.touchdown,rw.heading)

# One fixed tick of visual latency removes held/advanced-frame alternation. Human/external
# owners retain their own pose. This copy never feeds back into simulation or collision sweeps.
combat_render_state = (a:Combatant,alpha:f64) -> CraftState:
    s=a.state
    if a.external or not a.render_ready:return s
    t=f32(clamp(alpha,0.0,1.0))
    previous=a.previous_point ?? world_point(a.previous)
    if world_vec(previous)!=a.previous:previous=world_point(a.previous)
    s.precise=world_lerp(previous,craft_point(s),f64(t));s.position=world_vec(s.precise);s.published=s.position;s.precise_ready=true
    q=if dot(a.previous_rotation,s.orientation)<0:-s.orientation else:s.orientation
    s.orientation=normalize(lerp(a.previous_rotation,q,t))
    s

combat_index = (b: Battle, craft: int) -> int:
    loop i in 0..b.actors.len():
        if b.actors[i].craft == craft: return i
    -1

# Stateless scatter: cosmetic RNG, array capacity and render cadence cannot alter a hit.
combat_noise = (seed: int, id: int, shot: int, axis: int) -> f64:
    n = (seed*97+id*7919+shot*104729+axis*65537) % 2147483647
    n = (n*48271) % 2147483647
    f64(n % 20001)/10000.0-1.0

start_engagement = (id: int, seed: int, center: vec3, actors: Combatant[], boats: CombatBoat[] = []) -> Battle:
    assert(actors.len() <= COMBAT_MAX_CRAFT)
    b = Battle(enabled=true,engagement=id,seed=seed,center=center,actors=actors,boats=boats)
    loop i in 0..b.actors.len():
        assert(b.actors[i].craft >= 0 and b.actors[i].person >= 0)
        loop j in 0..i: assert(b.actors[i].craft != b.actors[j].craft and b.actors[i].person != b.actors[j].person)
        b.actors[i].spec.combat_flight=not b.actors[i].human
        b.actors[i].engagement = id
        b.actors[i].rally = center
        b.actors[i].previous_point=craft_point(b.actors[i].state)
        b.actors[i].previous = b.actors[i].state.position
        b.actors[i].gun.locked = b.actors[i].external
        b.actors[i].pilot.skill = clamp(b.actors[i].pilot.skill,0.0,1.0)
        b.actors[i].pilot.nerve = clamp(b.actors[i].pilot.nerve,0.0,1.0)
    b

_event = (b: mut Battle, kind: CombatEventKind, a: Combatant, at: vec3, other: int = -1, part: PartId = .body, strength: f64 = 1.0, direction: vec3 = vec3(0,1,0), outcome: bool = false):
    n = b.next_serial; b.next_serial += 1
    b.events.push(CombatEvent(n,kind,a.craft,a.person,other,at,direction,strength,part))
    if outcome:
        b.outcomes.push(CombatOutcome(n,if a.engagement>=0: a.engagement else: b.engagement,a.craft,a.person,kind,other,at,1.0-a.state.hull_damage,1.0-a.state.engine_damage))

take_combat_outcomes = (b: mut Battle) -> CombatOutcome[]:
    out = b.outcomes; b.outcomes = []; out

# Nearest entry parameter, including a segment starting inside. A miss is >1.
segment_ellipsoid = (a: vec3, z: vec3, center: vec3, half: vec3) -> f64:
    p = (a-center)/half; d = (z-a)/half
    aa = f64(dot(d,d)); bb = f64(dot(p,d)); cc = f64(dot(p,p))-1.0
    if cc <= 0: return 0
    if aa < 1e-12: return 2
    disc = bb*bb-aa*cc
    if disc < 0: return 2
    t = (-bb-sqrt(disc))/aa
    if t >= 0 and t <= 1: t else: 2

# Part-sized solids rather than a single giant sphere around the wing tips.
hit_aircraft = (a: Combatant, from: vec3, to: vec3, more: f64 = 0.0) -> (f64,PartId):
    inv = quat_inverse(a.state.orientation)
    p0 = quat_rotate(inv,from-a.previous); p1 = quat_rotate(inv,to-a.state.position)
    p = aircraft_profile(a.spec.kind)
    best = 2.0; part = PartId.body
    grow = vec3(f32(more),f32(more),f32(more))
    loop i in 0..7:
        if not a.state.damage.parts[i].attached: continue
        center = a.spec.parts[i].attachment
        half = match PartId(i):
            .body: vec3(max(p.width,0.55),max(p.width,0.65),p.length*0.34)
            .engine: vec3(max(0.6,p.engine_x+0.6),0.65,0.8)
            .left_wing, .right_wing: vec3(p.span*0.24,0.3,p.chord*0.55)
            .left_float, .right_float: vec3(if p.boat: 0.3 else: 0.5,0.4,if p.boat: 1.2 else: p.length*0.35)
            .tail: vec3(p.span*0.15,0.55,p.chord*0.5)
        if i == 2 or i == 3: center = vec3((if i == 2: -1.0 else: 1.0)*p.span*0.26,p.wing_y,-0.65)
        if i==2 or i==3:
            loop level in 0..p.decks:
                at=center+vec3(0,-f64(level)*(if p.decks==3:1.25 else:1.9),0)
                size=half
                if level>0:size.x*=f32(p.lower_span)
                t=segment_ellipsoid(p0,p1,at,size+grow)
                if t<best:best=t;part=PartId(i)
        else if i==1 and p.engine_x>0:
            loop side in [-1.0,1.0]:
                t=segment_ellipsoid(p0,p1,center+vec3(side*p.engine_x,0,0),vec3(0.65,0.65,0.8)+grow)
                if t<best:best=t;part=.engine
        else:
            t = segment_ellipsoid(p0,p1,center,half+grow)
            if t < best: best = t; part = PartId(i)
    (best,part)

intercept = (relative: vec3, velocity: vec3, speed: f64) -> vec3:
    aa = f64(dot(velocity,velocity))-speed*speed
    bb = 2.0*f64(dot(relative,velocity)); cc = f64(dot(relative,relative))
    t = sqrt(cc)/max(speed,1.0)
    disc = bb*bb-4.0*aa*cc
    if disc >= 0 and abs(aa) > 0.001:
        x = (-bb-sqrt(disc))/(2.0*aa); y = (-bb+sqrt(disc))/(2.0*aa)
        if x > 0 and y > 0: t = min(x,y)
        else if x > 0: t = x
        else if y > 0: t = y
    t = clamp(t,0.0,3.0)
    relative+velocity*f32(t)+vec3(0,4.905*t*t,0)

# Inside a cloud deck over the fight (where nobody sees anything).
in_deck = (b: Battle, p: vec3) -> bool: b.deck_base < 1e8 and f64(p.y) > b.deck_base and f64(p.y) < b.deck_top

_choose_target = (b: Battle, a: Combatant) -> int:
    best = -1; score = 1e20
    f = quat_rotate(a.state.orientation,vec3(0,0,-1))
    assigned = fill(0,b.actors.len())
    reported = fill(false,b.actors.len())
    loop ally in b.actors:
        if ally.side != a.side or not ally.present or ally.status != .flying: continue
        if a.engagement >= 0 and ally.engagement != a.engagement: continue
        if ally.pilot.mode == .homeward or ally.pilot.mode == .withdrawing: continue
        t = ally.pilot.target
        if ally.craft != a.craft and t >= 0 and t < assigned.len(): assigned[t] += 1
        # A nearby friend can call the contact it has seen. This also works
        # when the attacker is flown by hand and has no assigned quarry.
        threat = ally.pilot.threat
        if threat >= 0 and threat < reported.len() and ally.pilot.noticed >= 0 and b.tick-ally.pilot.noticed >= 24:
            if length(ally.state.position-a.state.position) < 1600: reported[threat] = true
    loop j in 0..b.actors.len():
        e = b.actors[j]
        if not e.present:continue
        if e.side == a.side or e.status != .flying or e.bailed: continue
        if a.engagement>=0 and e.engagement!=a.engagement: continue
        # (one gone home is let go)
        if e.pilot.mode == .homeward and not e.human: continue
        # (one in the cloud is not seen, unless it is very near)
        if in_deck(b,e.state.position) and f64(length(e.state.position-a.state.position)) > 400.0: continue
        delta = e.state.position-a.state.position
        distance = f64(length(delta))
        los = delta/f32(max(distance,0.01))
        nose = f64(dot(f,los))
        # A close contact behind can take longer to reach than the next one in front.
        turn_room = min(f64(length(a.state.velocity))*1.5,350.0)
        cost = distance*(1.7-0.7*nose)+turn_room*(1.0-nose)
        # Two aircraft can work a target together. Additional wing pairs look elsewhere.
        cost *= 1.0+0.55*f64(max(0,assigned[j]-1))
        if j == a.pilot.target:
            cost *= if distance<800 and nose>0.95: 0.5 else: 0.78
        if reported[j]:
            cost *= if j == a.pilot.threat: 0.6 else: 0.72
        if a.pilot.role == .escort:
            loop boat in b.boats:
                if boat.side == a.side and length(e.state.position-boat.position) < 1500: cost *= 0.45
        if cost < score or (cost == score and (best < 0 or e.craft < b.actors[best].craft)): best = j; score = cost
    best

# The dogfight, after Sky Barons' fighter (sim.jo bot_fighter, Aces' bot_pad): target choice by
# distance weighted to the nose, lead pursuit misjudged by skill, breaking off when too close and
# closing, a spread approach, throttling back close behind. What its physics gave its pilots for
# free is made explicit for this flight model: lag pursuit against a hard-turning target (no
# overshoot), a defensive break into an attacker and scissors when it overshoots, head-on passes
# held by nerve, extending to break a stalemate or after a pass and coming back, unloading to get
# speed back, zooming on an energy advantage, and wingmen covering their leader. Skill and the
# personality (aggression, caution) shape every choice; the mistakes are deliberate: a late
# reaction, a break the wrong way, fixation on a shot with an enemy behind, an overshoot, the aim
# misjudged. Returns the way to fly and the throttle; sets the mode and the trigger.
# The guns' aim at target t: where the rounds meet it, misjudged by skill (Sky Barons' wander);
# where the nose is put, leading the aim's swing (a pilot tracking a turning target puts the nose
# where the aim is going, not where it was, or trails a few degrees behind it all through the
# turn; the skilled anticipate more); and how far and how near the nose it fires.
struct GunAim:
    aim: vec3
    track: vec3
    ready: bool
    reach: f64
    cone: f64

_gun_aim = (b: Battle, a: Combatant, p: mut CombatPilot, t: int) -> GunAim:
    s = a.state; o = b.actors[t]
    delta = o.state.position-s.position; dist = max(f64(length(delta)),0.01)
    aim = intercept(delta,o.state.velocity-s.velocity,420.0*b.bullet_scale)
    err = (1.0-p.skill)*min(dist*0.035,25.0)
    wobble = vec3(sin(f64(b.tick)*0.021+f64(a.craft))*err,cos(f64(b.tick)*0.017+f64(a.craft))*err,0)
    look = normalize(aim); track = aim
    if p.aim_of != t or p.aim_tick < 0 or b.tick-p.aim_tick > 30:
        p.sight_rate = vec3(0,0,0)
        p.sight_since = b.tick
    if p.aim_of == t and p.aim_tick >= 0 and b.tick-p.aim_tick > 0 and b.tick-p.aim_tick <= 30:
        swing = (look-p.aim_dir)/f32(f64(b.tick-p.aim_tick)/60.0)
        if length(swing) < 1.5:
            dt=f64(b.tick-p.aim_tick)/60.0
            p.sight_rate+=(swing-p.sight_rate)*f32(1.0-exp(-dt*7.0))
            track = normalize(look+swing*f32(0.12+0.12*p.skill))*f32(dist)
    p.aim_dir = look; p.aim_tick = b.tick; p.aim_of = t
    ready = b.tick-p.sight_since >= int(12+16*(1.0-p.skill))
    GunAim(aim+wobble,track+wobble,ready,420.0+380.0*p.aggression+150.0*p.skill,0.9995-(1.0-p.skill)*0.002-p.aggression*0.0008)

# Between sightings the pilot carries the last observed motion forward. The bank brings the
# aircraft around. When almost lined up, use the smaller pitch and rudder corrections a pilot
# can make against the drifting sight. Both use the same imperfect sight picture.
_fighter_stick = (k: CraftSpec, s: CraftState, p: CombatPilot, tick: int) -> Controls:
    rate = if p.held_sight: p.sight_rate else: vec3(0,0,0)
    age = clamp(f64(tick-p.aim_tick)/60.0,0.0,0.25)
    sight = normalize(p.hold_want+rate*f32(age))
    course = normalize(sight+rate*f32(0.55+0.2*p.skill))
    c = steer(k,s,course,rate,false,false,true)
    if p.held_sight:
        inv = quat_inverse(s.orientation)
        local = quat_rotate(inv,sight)
        motion = quat_rotate(inv,rate)
        fine = smoothstep(0.95,0.995,-f64(local.z))
        pitch = (f64(motion.y)+3.0*f64(local.y))/max(0.1,k.pitch_rate)
        path = quat_rotate(inv,normalize(s.velocity+vec3(0.0001,0,0)))
        skid = atan2(-f64(path.x),max(-f64(path.z),0.05))
        yaw = (skid+1.3*f64(local.x)+0.2*(f64(motion.x)+f64(s.angular_velocity.y)))/max(fdm2.rudder_skid,0.02)
        c.pitch += fine*(clamp(pitch,-1.0,1.0)-c.pitch)
        c.yaw += fine*(clamp(yaw,-1.0,1.0)-c.yaw)
    if p.hold_cap:
        stall = k.stall_speed*pure_k(k)
        c.pitch = min(c.pitch,0.15+0.85*smoothstep(stall*1.1,stall*1.45,f64(length(s.velocity))))
    c.throttle = p.controls.throttle
    c.airbrake = p.controls.airbrake
    c

# Between thoughts, a pilot on a gun run (pursuit or a head-on pass, the target near and ahead)
# aims again: the stick put on the lead and the trigger decided, nothing else looked at.
_retrack = (b: Battle, index: int) -> CombatPilot:
    a = b.actors[index]; p = a.pilot; s = a.state; k = a.spec
    t = p.target
    if not p.close or not (p.mode == .pursuit or p.mode == .head_on or p.mode == .cover): return p
    if t < 0 or t >= b.actors.len() or b.actors[t].status != .flying or not b.actors[t].present:
        p.trigger = false; p.close = false; p.held_sight = false
        return p
    # (in the cloud the gun run is off, the brain taking it out of the deck, unless the target is
    # near enough to be seen in it)
    if (in_deck(b,s.position) or in_deck(b,b.actors[t].state.position)) and length(b.actors[t].state.position-s.position) > 400:
        p.trigger = false; p.close = false; p.held_sight = false
        return p
    g = _gun_aim(b,a,p,t)
    fwd = quat_rotate(s.orientation,vec3(0,0,-1))
    dist = f64(length(b.actors[t].state.position-s.position))
    p.trigger = g.ready and dist < g.reach and f64(dot(fwd,normalize(g.aim))) > g.cone
    if fdm2_active(k):
        p.hold_want = normalize(g.aim)
        p.held_sight = true
        p.controls=_fighter_stick(k,s,p,b.tick)
    else:
        c=steer(k,s,normalize(g.track))
        c.throttle=p.controls.throttle;c.airbrake=p.controls.airbrake
        st=k.stall_speed*pure_k(k)
        c.pitch=min(c.pitch*(0.65+0.35*p.skill),0.15+0.85*smoothstep(st*1.1,st*1.45,f64(length(s.velocity))))
        p.controls=c
    p

_dogfight = (b: Battle, index: int, e: FlightEnv, p: mut CombatPilot, ground: f64, elapsed: int, was: CombatMode) -> (vec3,f64):
    a = b.actors[index]; s = a.state; k = a.spec
    pos = s.position; fwd = quat_rotate(s.orientation,vec3(0,0,-1)); right = quat_rotate(s.orientation,vec3(1,0,0))
    speed = f64(length(s.velocity)); stall = k.stall_speed*pure_k(k)
    alt = f64(pos.y)-ground
    flat = (v: vec3) -> vec3:
        f = vec3(v.x,0,v.z)
        if length(f) < 0.01: vec3(fwd.x+0.0001,0,fwd.z) else: normalize(f)
    noise = (salt: int, axis: int) -> f64: combat_noise(b.seed,a.craft,salt,axis)
    # (an enemy within 800 m with its nose on this aircraft; noticed only after a reaction time)
    threat = -1; nearest = 450.0+300.0*p.caution
    if not p.simple:
        loop j in 0..b.actors.len():
            o = b.actors[j]
            if j == index or not o.present or o.status != .flying or o.bailed or o.side == a.side: continue
            if a.engagement >= 0 and o.engagement != a.engagement: continue
            d = pos-o.state.position; dist = f64(length(d))
            if dist >= nearest or dist < 1.0: continue
            toward_me = d/f32(dist)
            # The head-on pass already has its own break distance. Treating
            # that same opponent as a tail threat interrupts it a second time.
            if j == p.target and dot(fwd,-toward_me) > cos(0.5) and dot(s.velocity-o.state.velocity,-toward_me) > 50.0: continue
            if f64(dot(quat_rotate(o.state.orientation,vec3(0,0,-1)),toward_me)) > 0.985-p.caution*0.05: threat = j; nearest = dist
    if threat != p.threat: p.threat = threat; p.noticed = b.tick
    reaction = int((0.3+(1.0-p.skill)*1.1-p.caution*0.25)*60.0)
    alarmed = threat >= 0 and b.tick-p.noticed >= reaction
    # (a wingman turns on whoever is on its leader's tail)
    leader = if p.role == .wingman: combat_index(b,if p.wing >= 0: p.wing else: p.leader) else: -1
    covering = false
    if not alarmed and leader >= 0 and leader != index and b.actors[leader].status == .flying and b.actors[leader].present:
        l = b.actors[leader].state
        nearest_to_leader = 700.0
        loop j in 0..b.actors.len():
            o = b.actors[j]
            if o.side == a.side or o.status != .flying or not o.present or o.bailed: continue
            if a.engagement>=0 and o.engagement!=a.engagement:continue
            if o.pilot.mode==.homeward:continue
            d = l.position-o.state.position; dist = f64(length(d))
            if in_deck(b,o.state.position) and length(o.state.position-pos)>400.0:continue
            if dist < nearest_to_leader and dist > 1.0 and f64(dot(quat_rotate(o.state.orientation,vec3(0,0,-1)),d/f32(dist))) > 0.9:
                nearest_to_leader = dist; p.target = j; covering = true
    t = p.target
    has = t >= 0 and t < b.actors.len() and b.actors[t].status == .flying and b.actors[t].present
    # Held manoeuvres run their course; a fresh threat can still interrupt an extension.
    p.mode = was
    held = b.tick < p.commit and (was == .break_turn or was == .scissors or was == .extend or was == .unload)
    if held and was == .extend and alarmed: held = false
    if not held and b.tick >= p.commit and was == .break_turn and p.caution > 0.55 and threat >= 0:
        # (a cautious pilot, the attacker still about after its break: away, to come back later)
        p.mode = .extend; p.away = flat(s.velocity); p.commit = b.tick+int((4.0+p.caution*5.0)*60.0); held = true
    # (a break or a scissors pulls only as hard as the speed allows: slow, it eases off)
    ease = f32(smoothstep(stall*1.25,stall*1.8,speed))
    if held and (was == .break_turn or was == .scissors): p.breaking += elapsed
    if held:
        if p.mode==.break_turn and p.turn==0.0:return (p.away,1.0)
        if p.mode == .break_turn: return (right*f32(p.turn*1.6)*ease+fwd*(1.3-ease)+vec3(0,0.12,0),1.0)
        if p.mode == .scissors: return (right*f32(p.turn*1.4)*ease+fwd*(1.2-ease)+vec3(0,0.25,0),if speed > stall*1.6: 0.35 else: 1.0)
        if p.mode == .unload: return (flat(fwd)+vec3(0,-0.45,0),1.0)
        return (p.away+vec3(0,if alt > 450: -0.06 else: 0.05,0),1.0)
    if alarmed:
        o = b.actors[threat]
        # (fixed on its own shot: an aggressive, less skilled pilot may not let go of it)
        good = has and dot(fwd,normalize(b.actors[t].state.position-pos+vec3(0.0001,0,0))) > 0.96 and length(b.actors[t].state.position-pos) < 600
        # (on a good shot, the bold press it unless the attacker is very close; and an aggressive,
        # less skilled pilot may fix on it whatever comes)
        pressing = good and nearest > 250.0 and p.caution < 0.6
        fixed = pressing or (good and noise(p.noticed,7)*0.5+0.5 < p.aggression*(1.0-p.skill)*1.4)
        if not fixed and not p.simple:
            side = if dot(o.state.position-pos,right) >= 0: 1.0 else: -1.0
            # (a defensive spiral is not held for ever: after some seconds of breaking it reverses,
            # turning the other way across the attacker's nose, which may give him his shot)
            p.breaking += elapsed
            if p.turn!=0.0 and p.breaking > int((7.0+p.caution*5.0)*60.0):
                p.breaking = 0; side = -p.turn
            # (the wrong way, now and then, for the less skilled)
            if noise(p.noticed,8)*0.5+0.5 < (1.0-p.skill)*0.3: side = -side
            p.turn = side
            closing = f64(dot(o.state.velocity-s.velocity,normalize(pos-o.state.position)))
            if nearest < 220.0 and closing > 10.0 and p.skill+p.aggression > 0.9:
                p.mode = .scissors; p.commit = b.tick+int(1.1*60.0)
                return (right*f32(side*1.4)*ease+fwd*(1.2-ease)+vec3(0,0.25,0),if speed > stall*1.6: 0.35 else: 1.0)
            # (a cautious pilot near the cloud uses it: up or down into the deck and on through it,
            # out of the attacker's sight)
            if p.caution > 0.55 and b.deck_base < 1e8 and alt > 150.0:
                gap_up = b.deck_base-f64(pos.y); gap_down = f64(pos.y)-b.deck_top
                into = if gap_up > 0.0 and gap_up < 260.0: 1.0 else: if gap_down > 0.0 and gap_down < 260.0: -1.0 else: 0.0
                if into != 0.0:
                    p.mode = .extend; p.away = normalize(flat(s.velocity)+vec3(0,f32(into*0.55),0)); p.commit = b.tick+int(9.0*60.0)
                    return (p.away,1.0)
            p.mode = .break_turn; p.commit = b.tick+int((1.1+p.caution*1.2)*60.0)
            # (and after it, turn on the attacker)
            if p.caution < 0.7: p.target = threat; p.target_tick = b.tick
            return (right*f32(side*1.6)*ease+fwd*(1.3-ease)+vec3(0,0.12,0),1.0)
    if not alarmed and not held: p.breaking = max(0,p.breaking-elapsed*2)
    # (slow and with height to spare: unload, nose down, wings level, for speed)
    if not p.simple and speed < stall*1.35 and alt > 350.0:
        p.mode = .unload; p.commit = b.tick+int(2.5*60.0)
        return (flat(fwd)+vec3(0,-0.45,0),1.0)
    if not has:
        p.mode = .regroup
        return (vec3(0,0,0),1.0)
    o = b.actors[t]
    delta = o.state.position-pos; dist = max(f64(length(delta)),0.01); los = delta/f32(dist)
    angle = acos(clamp(f64(dot(fwd,los)),-1.0,1.0))
    nose_on_me = f64(dot(quat_rotate(o.state.orientation,vec3(0,0,-1)),-los))
    closure = f64(dot(s.velocity-o.state.velocity,los))
    g = _gun_aim(b,a,p,t)
    aim=g.aim; reach=g.reach
    fire = (at: vec3) -> bool: g.ready and dist < reach and f64(dot(fwd,normalize(at))) > g.cone
    p.close = dist < reach and angle < 0.35
    track=if fdm2_active(k) and p.close:aim else:g.track
    if p.simple:
        p.mode = .pursuit
        if dist < 65 and closure > 0: p.mode = .breakaway; return (-los+vec3(0,0.8,0),1.0)
        p.trigger = fire(aim)
        return (track,if dist < 180 and closure > 8 and speed > stall*1.6: 0.4 else: 1.0)
    # Head-on: hold it by nerve, fire if it lines up, break right (as both sides were taught) or,
    # for a bold one, up; the cautious go away after it, the aggressive straight back round.
    if angle < 0.5 and nose_on_me > 0.8 and closure > 50.0 and dist < 1800.0:
        if dist < max(90.0,closure*(0.42+(1.0-p.aggression)*0.5+p.caution*0.28)):
            p.turn = 1.0; p.mode = .break_turn; p.commit = b.tick+int(1.3*60.0)
            if p.aggression > 0.75 and speed>stall*1.8:
                p.turn=0.0;p.away=normalize(fwd+vec3(0,1.2,0))
                return (p.away,1.0)
            return (right*1.6+fwd*0.3-vec3(0,0.1,0),1.0)
        p.mode = .head_on; p.trigger = fire(aim)
        return (track,1.0)
    # Too close and closing: break off up and away (Sky Barons'); the fight goes on after.
    if dist < 65 and closure > 0:
        p.mode = .breakaway
        return (-los+vec3(0,0.8,0),1.0)
    # Gone past behind: come straight back round, or (slow, or cautious) extend first.
    if angle > 1.75 and nose_on_me < 0.9:
        if speed < stall*1.6 or (p.caution > 0.65 and dist < 600.0):
            p.mode = .extend; p.away = flat(s.velocity); p.commit = b.tick+int((3.5+p.caution*5.0)*60.0)
            return (p.away,1.0)
        p.mode = if covering: .cover else: .pursuit
        return (delta+vec3(0,f32(clamp(f64(-delta.y)*0.1,-40.0,60.0)),0),1.0)
    # Far: closing in a spread, each its own place (Sky Barons'), with height: the skilled and the
    # cautious look for an advantage; fast and below it, zoom up at it.
    if dist > 1500.0:
        across = normalize(vec3(-delta.z,0,delta.x)+vec3(0.0001,0,0))
        spread = f32((f64(a.craft%5)-2.0)*90.0*min((dist-1500.0)/800.0,1.0))
        over = f32(80.0*p.skill+60.0*p.caution)
        # (a climber goes up through the deck first, to come down on them from above)
        if p.climber and b.deck_top < 1e8 and f64(pos.y) < b.deck_top+60.0 and f64(o.state.position.y) < b.deck_top:
            over = f32(clamp(b.deck_top+120.0-f64(pos.y),0.0,600.0))
            p.mode = .zoom
            return (delta*0.25+across*spread+vec3(0,over,0),1.0)
        # (height for an advantage, but no higher than the clear sky a few hundred metres over the
        # deck: each wanting to be over the other, the whole fight would ratchet up to where the
        # engines fade)
        if b.deck_top < 1e8: over = min(over,f32(b.deck_top+350.0-f64(o.state.position.y)))
        p.mode = if f64(delta.y+over) > 150 and speed > stall*2.2: .zoom else: (if covering: .cover else: .approach)
        return (delta+across*spread+vec3(0,over,0),1.0)
    # A stalemate (a turning fight with no angle gained) is broken by extending and coming back.
    # (and a stern chase that does not close: let it go, for whoever is nearer)
    # (progress is a firing position, or a better angle than any yet; a nose swept past a target
    # out of range is not)
    chasing = dist > reach and closure < 3.0
    if (dist < reach and angle < 0.3) or angle < p.best_angle-0.08: p.best_angle = angle; p.stalemate = 0
    else: p.stalemate += elapsed
    if p.stalemate > int((26.0-p.caution*12.0)*60.0) and dist > 150.0:
        p.stalemate = 0; p.best_angle = 3.2
        if chasing or dist > reach:
            p.target_tick = b.tick-1000; p.mode = .approach
            return (delta,1.0)
        p.mode = .extend; p.away = flat(s.velocity); p.commit = b.tick+int((5.0+p.caution*6.0)*60.0)
        return (p.away,1.0)
    # Overshoot coming: lag pursuit, aiming behind it and easing off, until the angle is right.
    turning = f64(length(o.state.angular_velocity)) > 0.35
    if closure > 25.0+(1.0-p.aggression)*20.0 and dist < 350.0 and (angle > 0.25 or turning) and not fire(aim) and p.aggression < 0.8:
        p.mode = .lag
        behind = delta-o.state.velocity*0.45
        return (behind,if speed > stall*1.6: 0.55 else: 1.0)
    p.mode = if covering: .cover else: .pursuit
    # (no hanging on the propeller after a zooming target: climbing steeply and slowing, level off
    # and let it come back down; the less skilled hold on longer)
    if f64(fwd.y) > 0.6 and speed < stall*(1.35+0.6*p.skill):
        p.trigger = fire(aim)
        return (flat(delta)+vec3(0,-0.1,0),1.0)
    p.trigger = fire(aim)
    throttle=1.0
    # Ease in behind a crossing target without sailing through the shooting position.
    if angle<0.5 and nose_on_me<0.2 and dist<650.0 and speed>stall*1.6:
        throttle=clamp(0.8+(dist-220.0)*0.002-closure*0.025,0.12,1.0)
    (track,throttle)

# Roll upright and arrest a descent, including when a damaged fighter is rallying for home.
_pull_out = (k: CraftSpec, s: CraftState) -> Controls:
    fwd=quat_rotate(s.orientation,vec3(0,0,-1))
    speed=f64(length(s.velocity))
    st=k.stall_speed*pure_k(k)
    c=Controls(throttle=1.0,assist=0.0)
    # (a pull-out is flown by hand too: roll toward upright, and pull hard once the wings are
    # up; from a steep bank the steering law spends too long rolling)
    r = quat_rotate(s.orientation,vec3(1,0,0)); u = quat_rotate(s.orientation,vec3(0,1,0))
    # (nearly vertical: pull straight through, the roll no matter; otherwise upside down or
    # on a wing: roll upright first, with no pull, which would only steepen the dive; then pull)
    vertical = f64(fwd.y) < -0.85
    c.roll = if vertical: 0.0 else: (if u.y < 0.3: (if r.y >= 0: 1.0 else: -1.0) else: clamp(f64(r.y)*3.0,-1.0,1.0))
    c.pitch = if vertical: 1.0 else: if u.y > 0.45: 1.0 else: if u.y > 0.15: 0.3 else: 0.0
    c.pitch = min(c.pitch,0.25+0.75*smoothstep(st*1.05,st*1.3,speed))
    c

combat_controls = (b: Battle, index: int, e: FlightEnv) -> CombatPilot:
    a = b.actors[index]; p = a.pilot; s = a.state; k = a.spec
    elapsed = if p.brain_tick < 0: 6 else: b.tick-p.brain_tick
    was = p.mode
    p.brain_tick = b.tick; p.trigger = false; p.close = false
    p.held_sight = false; p.hold_want = vec3(0,0,0)
    if b.assist.craft == a.craft and b.assist.stage > 0: return _assist(b,index,e,p)
    if p.launching: return _launch(b,index,e,p)
    if p.mode == .homeward:
        p=_homeward(b,index,e,p)
        phase=p.plan.phase
        # The arrival controller can turn a damaged aircraft onto the approach below
        # its glide path. Recover before the flare. The final metre belongs to the
        # landing controller once it has lined up and entered the land phase.
        if fdm2_active(k) and not p.home_done and phase != .land and phase != .taxi and s.velocity.y < 5:
            approach = phase == .descend
            seconds = if approach: 2.5 else: 4.5+4.0*s.hull_damage
            ahead = s.position+s.velocity*f32(seconds)
            floor = max(0.0,e.ground(f64(ahead.x),f64(ahead.z)))
            if f64(ahead.y) < floor+(if approach: 40.0 else: 100.0):
                p.controls = _pull_out(k,s)
        # A downdraft on final can exceed the flare's authority. Wave off
        # while there is still time to arrest it and fly the approach again.
        if fdm2_active(k) and phase == .land and not s.on_water:
            sink = -f64(s.velocity.y)
            # Allow the normal 6.5% approach slope plus the flare's sink margin.
            if sink > 0.065*f64(length(s.velocity))+2.0*pure_k(k):
                wave = sea_surface(e,f64(s.position.x),f64(s.position.z),s.time)
                clearance = f64(s.position.y)-wave.height-k.float_height
                if clearance < 4.0+3.5*sink:
                    p.plan.phase = .climb
                    p.controls = _pull_out(k,s)
        return p
    order = _order_for(b,index)
    if order.kind == .form_on_me or order.kind == .circle:
        by = combat_index(b,order.by)
        if order.kind == .form_on_me and by >= 0 and b.actors[by].status == .flying:
            # (in its own slot on the player, as on the way out)
            l = b.actors[by].state
            slot = l.position+quat_rotate(quat_euler(0,-heading(l),0),p.formation_offset-b.actors[by].pilot.formation_offset)
            direction = heading_vector(heading(l)); lv = max(f64(length(l.velocity)),k.stall_speed*pure_k(k)*1.4)
            # (well out of position, a straggler opens right up to catch the formation)
            gap = f64(length(slot-s.position))
            pace = clamp(lv+f64(dot(slot-s.position,direction))*0.12,lv*0.75,lv*1.25+max(f64(k.max_speed)-lv*1.25,0.0)*smoothstep(300.0,900.0,gap))
            p.controls = air_waypoint_controls(k,s,e,slot+direction*1000.0,f64(slot.y),pace)
            p.mode = .regroup; p.target = -1
            return p
        if order.kind == .circle:
            out = s.position-order.at; out.y = 0
            if length(out) < 1: out = vec3(1,0,0)
            around = f64(atan2(f64(out.z),f64(out.x)))+0.4
            aim = order.at+vec3(f32(cos(around)*1000.0),0,f32(sin(around)*1000.0))
            p.controls = air_waypoint_controls(k,s,e,aim,max(f64(order.at.y),250.0),k.cruise_speed*0.65)
            p.mode = .regroup; p.target = -1
            return p
    if order.kind == .attack:
        t = combat_index(b,order.target)
        if t >= 0 and b.actors[t].status == .flying and b.actors[t].side != a.side: p.target = t; p.target_tick = b.tick
    if p.target < 0 or p.target >= b.actors.len() or b.actors[p.target].status != .flying or (in_deck(b,b.actors[p.target].state.position) and f64(length(b.actors[p.target].state.position-s.position)) > 400.0) or not b.actors[p.target].present or b.actors[p.target].side==a.side or (a.engagement>=0 and b.actors[p.target].engagement!=a.engagement) or b.tick-p.target_tick>=60:
        next_target=_choose_target(b,a)
        if next_target != p.target:
            p.best_angle = 3.2
            p.stalemate = 0
        p.target=next_target
        p.target_tick=b.tick
    pos = s.position; fwd = quat_rotate(s.orientation,vec3(0,0,-1))
    speed = f64(length(s.velocity))
    ground = max(0.0,e.ground(f64(pos.x),f64(pos.z)))
    ahead = pos+s.velocity*3.0
    look = pos+s.velocity*4.5
    # (the faster it sinks, the higher it starts pulling out: a softer flight model pulls out wider)
    sink = max(0.0,-f64(s.velocity.y))
    low = f64(pos.y) < ground+110.0+sink*5.0 or ahead.y < max(0.0,e.ground(f64(ahead.x),f64(ahead.z)))+80 or look.y < max(0.0,e.ground(f64(look.x),f64(look.z)))+40
    # (and the hills: the path sampled further out, for an island's slope rising ahead)
    loop later in [1.5,3.0,4.5,6.0]:
        if low: break
        q = pos+s.velocity*f32(later)
        low = f64(q.y) < max(0.0,e.ground(f64(q.x),f64(q.z)))+(if later < 3: 120.0 else: 80.0)
    # (hits now tell: a pilot withdraws only when badly hurt, a hit or two from going down)
    hurt = s.hull_damage > 0.3+0.3*p.nerve or part_health(s.damage,.tail)<0.15 or min(part_health(s.damage,.left_wing),part_health(s.damage,.right_wing))<0.2 or s.engine_damage > 0.8 or a.fire > 0.5 or a.gun.ammo == 0 or s.fuel < k.fuel_capacity*0.04
    fleeing = p.role == .flee or hurt or p.mode == .withdrawing
    if p.formation:
        if low or fleeing or p.target>=0 and length(b.actors[p.target].state.position-pos)<1400:
            p.formation=false
        else:
            direction=heading_vector(p.formation_heading)
            aim=pos+direction*1200.0
            altitude=f64(a.rally.y)+f64(p.formation_offset.y)
            pace=p.formation_speed
            leader=combat_index(b,p.leader)
            if leader>=0 and leader!=index and b.actors[leader].status==.flying:
                l=b.actors[leader].state
                slot=l.position+quat_rotate(quat_euler(0,-p.formation_heading,0),p.formation_offset)
                aim=slot+direction*1000.0
                altitude=f64(slot.y)
                # (well out of position, a straggler opens right up to catch the formation)
                gap=f64(length(slot-pos))
                pace=clamp(f64(length(l.velocity))+f64(dot(slot-pos,direction))*0.12,p.formation_speed*0.75,p.formation_speed*1.15+max(f64(k.max_speed)-p.formation_speed*1.15,0.0)*smoothstep(300.0,900.0,gap))
            p.controls=air_waypoint_controls(k,s,e,aim,altitude,pace)
            p.mode=.regroup
            return p
    want = a.rally-pos; want.y = f32(350.0-f64(pos.y))
    p.mode = .regroup
    if fleeing:
        p.mode = .withdrawing
        away = pos-a.rally; away.y = 0
        if length(away) < 1: away = fwd
        want = normalize(away)*1200.0+vec3(0,clamp(ground+250-f64(pos.y),-120.0,250.0),0)
    throttle = 1.0
    if not fleeing and p.role != .strike:
        fight,power = _dogfight(b,index,e,p,ground,elapsed,was)
        if length(fight) > 0.001: want = fight; throttle = power
        # (on flight model v2, turning to get onto a target: no faster than about the speed it turns
        # tightest at, a little over 2 x stall, the throttle eased back over it; full power would carry
        # it round on too wide a circle to gain any angle)
        if fdm2_active(k) and (p.mode == .pursuit or p.mode == .lag or p.mode == .cover or p.mode == .scissors or p.mode == .break_turn):
            vst = k.stall_speed*pure_k(k)
            turning=p.target>=0 and dot(fwd,normalize(b.actors[p.target].state.position-pos+vec3(0.001,0,0)))<0.7
            if turning: throttle = min(throttle,clamp(1.0-(f64(length(s.velocity))-vst*CORNER)/(vst*0.4),0.15,1.0))
    if not fleeing and p.role==.wingman and p.mode!=.cover and p.mode!=.break_turn and p.mode!=.scissors and (p.target<0 or length(b.actors[p.target].state.position-pos)>1800):
        leader = combat_index(b,if p.wing >= 0: p.wing else: p.leader)
        if leader >= 0 and b.actors[leader].present and b.actors[leader].status == .flying:
            l = b.actors[leader].state
            want = l.position+quat_rotate(l.orientation,vec3(if a.craft%2==0: -65 else: 65,25,100))-pos
            p.mode = .regroup; p.trigger = false
    # Strike pilots prefer boats while escorts engage their attackers.
    if not fleeing and p.role == .strike:
        best = -1; dist = 1e20
        loop j in 0..b.boats.len():
            boat = b.boats[j]
            d = f64(length(boat.position-pos))
            if boat.side != a.side and not boat.disabled and d < dist: best = j; dist = d
        p.boat = best
        if best >= 0:
            boat = b.boats[best]; delta = boat.position+vec3(0,2,0)-pos
            aim = intercept(delta,boat.velocity-s.velocity,420.0*b.bullet_scale)
            p.mode = .strafe; want = aim
            if dist > 1100: want.y = f32(250.0-f64(pos.y))
            if dist < 240 or (dist < 550 and dot(fwd,delta) < 0): p.mode = .breakaway; want = fwd+vec3(0,0.8,0)
            p.trigger = p.mode == .strafe and dist < 1100 and dot(fwd,normalize(aim)) > 0.997
    if low and not (p.mode == .strafe and pos.y > ground+75):
        want = vec3(fwd.x,0.9,fwd.z); p.trigger = false; p.mode = .evade; throttle = 1.0
    else if p.mode != .strafe:
        # (under a cloud deck: no climbing into it, and back down out of it)
        if f64(pos.y) > b.ceiling-150.0 and b.ceiling > ground+150.0:
            w = normalize(want+vec3(0.0001,0,0))
            over = clamp((f64(pos.y)-(b.ceiling-150.0))/250.0,0.0,1.0)
            # (a gentle way down, never a dive: at most a third of the way)
            want = vec3(w.x,f32(max(-0.33,min(f64(w.y),0.35*(1.0-over))-0.35*clamp((f64(pos.y)-b.ceiling)/200.0,0.0,1.0))),w.z)
        # (near the sea, no steeper dive than leaves room to pull out)
        w = normalize(want+vec3(0.0001,0,0)); room = f64(pos.y)-ground
        deepest = -clamp((room-200.0)/1400.0,0.0,0.9)
        if f64(w.y) < deepest: want = vec3(w.x,f32(deepest),w.z)
    # Local separation sampled only on brain ticks; no all-pairs scan per physics substep.
    avoid = vec3(0,0,0)
    loop other in b.actors:
        if other.craft == a.craft or other.status != .flying: continue
        gap = pos-other.state.position
        if dot(gap,gap) > 160000: continue
        dv = s.velocity-other.state.velocity
        tt = clamp(-f64(dot(gap,dv))/max(f64(dot(dv,dv)),0.01),0.0,1.5)
        miss = gap+dv*f32(tt)
        reach = (k.span+other.spec.span)*0.5+18.0
        if length(miss) < reach: avoid += normalize(miss+vec3(0,if a.craft>other.craft: 2 else: -2,0))*0.7
    if length(want) < 0.001: want = fwd
    p.hold_want=normalize(want)+avoid;p.hold_cap=true
    p.held_sight=p.close and (p.mode==.pursuit or p.mode==.head_on or p.mode==.cover)
    if fdm2_active(k):p.controls=_fighter_stick(k,s,p,b.tick)
    else:p.controls=steer(k,s,p.hold_want)
    p.controls.throttle = throttle
    p.controls.airbrake = if throttle < 0.5: 0.5 else: 0.0
    if p.mode != .evade and not fdm2_active(k): p.controls.pitch *= 0.65+0.35*p.skill
    # (slow: the pull eases off as the speed falls toward the stall, rather than at a cliff)
    st = k.stall_speed*pure_k(k)
    p.controls.pitch = min(p.controls.pitch,0.15+0.85*smoothstep(st*1.1,st*1.45,speed))
    if p.mode == .evade or p.mode == .unload: p.hold_want = vec3(0, 0, 0)
    if p.mode == .evade: p.controls=_pull_out(k,s)
    if p.mode == .unload:
        # (an unload is flown by hand: wings rolled level, the nose pushed a little below the
        # horizon, full power; the steering law would roll over and pull for a point below, the
        # last thing a slow aircraft wants)
        r = quat_rotate(s.orientation,vec3(1,0,0)); u = quat_rotate(s.orientation,vec3(0,1,0))
        climb = asin(clamp(f64(fwd.y),-1.0,1.0))
        # (rolling toward the side whose wing is up raises the lift vector: upright either way)
        p.controls.roll = if u.y < 0: (if r.y >= 0: 1.0 else: -1.0) else: clamp(f64(r.y)*3.0,-1.0,1.0)
        p.controls.pitch = if u.y < 0.2: 0.0 else: clamp((-0.3-climb)*2.5,-1.0,0.2)
        p.controls.yaw = 0.0
    # (in the cloud nobody sees anything: never level in it, but on through it, up if fast and
    # nearer the top, else down)
    # (but one on a gun run at a target in sight, a few hundred metres off, follows it on through)
    gunning = (p.mode == .pursuit or p.mode == .lag or p.mode == .cover or p.mode == .head_on) and p.target >= 0 and p.target < b.actors.len() and f64(length(b.actors[p.target].state.position-pos)) < 400.0
    # A close attacker is visible in the cloud too. Finish the defensive turn
    # while the attacker is in sight, then resume the crossing.
    evading = p.mode == .break_turn or p.mode == .scissors
    visible_threat = p.threat >= 0 and p.threat < b.actors.len() and length(b.actors[p.threat].state.position-pos) < 400.0
    if in_deck(b,pos) and p.mode != .evade and p.mode != .unload and not gunning and not (evading and visible_threat):
        middle = (b.deck_base+b.deck_top)*0.5
        # (crossing it already, fast and the right way, it is left to go on; else out by the nearer
        # side it can reach: the top if fast and above the middle, else the base)
        crossing = f64(s.velocity.y) > 20.0 or f64(s.velocity.y) < -20.0
        up = if crossing: f64(s.velocity.y) > 0.0 else: f64(pos.y) > middle and speed > k.stall_speed*pure_k(k)*1.7
        # (not crossing fast, but plainly going one way, down to regroup or up after a target: on out
        # that way, rather than turned back by being fast)
        intent = f64(normalize(want+vec3(0.0001,0,0)).y)
        if not crossing and abs(intent) > 0.15: up = intent > 0.0
        level = vec3(fwd.x,0,fwd.z)
        if length(level) < 0.1: level = vec3(s.velocity.x,0,s.velocity.z)
        p.hold_want=normalize(normalize(level+vec3(0.0001,0,0))+vec3(0,if up:0.6 else:-0.8,0))
        p.held_sight=false;p.close=false;p.trigger=false;p.hold_cap=false
        c=steer(k,s,p.hold_want)
        p.controls.pitch = c.pitch; p.controls.roll = c.roll; p.controls.yaw = c.yaw
    # (whatever was flown, the cloud base kept above: climbing so as to be over the soft ceiling within
    # a few seconds, a zoom or a hand-flown pull-up is eased over; only high ground beneath gives way)
    if b.ceiling < 1e8 and p.mode != .evade and f64(pos.y)+max(0.0,f64(s.velocity.y))*2.5 > b.ceiling and s.velocity.y > 0 and b.ceiling > ground+150.0:
        level = vec3(fwd.x,0,fwd.z)
        if length(level) < 0.1: level = vec3(s.velocity.x,0,s.velocity.z)
        p.hold_want=normalize(normalize(level+vec3(0.0001,0,0))+vec3(0,-0.15,0))
        p.held_sight=false;p.close=false;p.trigger=false;p.hold_cap=false
        c=steer(k,s,p.hold_want)
        p.controls.pitch = c.pitch; p.controls.roll = c.roll; p.controls.yaw = c.yaw
    p

# ---------------- going home ----------------
const CORNER = 2.2                 # (flight model v2: the multiple of the stall a fighter turning onto a target is held to)
const SHIP_RUN = 750.0             # m from touchdown to the run's end at a ship (the run out's length, about)
const LAND_GAP = 25*60              # ticks between aircraft landing in turn at a base
const RALLY_HEIGHT = 450.0          # where a side regroups after a fight (under the soft ceiling)
const RALLY_NEAR = 1300.0           # in at the rally point
const REGROUP_MOST = 150*60         # stragglers waited for this long at most
const REGROUP_LEAST = 60*60         # and at least a turn round the rally point, all of them in

_has_home = (b: Battle, side: int) -> bool:
    loop h in b.homes:
        if h.side == side: return true
    false

_home_of = (b: Battle, side: int) -> BattleHome:
    loop h in b.homes:
        if h.side == side: return h
    BattleHome(side,vec3(0,0,0),0.0,vec3(0,0,0),vec3(0,0,0))

# The side's homeward leader: the first in the landing order still flying (-1: none).
home_leader = (b: Battle, side: int) -> int:
    best = -1
    loop i in 0..b.actors.len():
        a = b.actors[i]
        if a.side != side or a.status != .flying or a.pilot.mode != .homeward or a.human: continue
        if best < 0 or a.pilot.home_turn < b.actors[best].pilot.home_turn: best = i
    best

# Where a homeward aircraft's place in the formation is: its own slot from the outward flight,
# kept relative to the leader's.
home_slot = (b: Battle, lead: int, offset: vec3) -> vec3:
    l = b.actors[lead]
    h = heading(l.state)
    l.state.position+quat_rotate(quat_euler(0,-h,0),offset-l.pilot.formation_offset)

# A side turns for home when it is beaten (half its aircraft lost and outnumbered two to one by
# those still fighting, or after five minutes no longer the stronger) or has won (no enemy left fighting): every one of its pilots still flying
# goes home, the leader first, the rest in their slots. Only battles that know their bases.
const CONTACT_RANGE = 6000.0
const CONTACT_LOST = 40*60

# Whether any of a side still fighting is within CONTACT_RANGE of an enemy still fighting.
_in_contact = (b: Battle, side: int) -> bool:
    loop a in b.actors:
        if a.side != side or a.status != .flying or not a.present or a.pilot.mode == .homeward or a.pilot.mode == .withdrawing: continue
        loop o in b.actors:
            if o.side == side or o.side < 0 or o.side > 2 or o.status != .flying or not o.present or o.pilot.mode == .homeward or o.pilot.mode == .withdrawing: continue
            if f64(length(o.state.position-a.state.position)) < CONTACT_RANGE: return true
    false

_turn_for_home = (b: mut Battle):
    if b.homes.len() == 0: return
    # (regrouped: every one of the side in at the rally point, or the stragglers given up on)
    loop side in 0..3:
        if b.home_since[side] < 0 or b.formed[side] >= 0: continue
        all_in = true
        loop a in b.actors:
            if a.side == side and a.status == .flying and a.present and not a.human and a.pilot.mode == .homeward and not a.pilot.rallied: all_in = false
        if (all_in and b.tick-b.home_since[side] >= REGROUP_LEAST) or b.tick-b.home_since[side] > REGROUP_MOST: b.formed[side] = b.tick
    if b.strength[0]+b.strength[1]+b.strength[2] == 0:
        loop a in b.actors:
            if a.side >= 0 and a.side < 3: b.strength[a.side] += 1
    loop side in 0..3:
        if b.home_since[side] >= 0 or b.strength[side] == 0 or not _has_home(b,side): continue
        # (a sortie's side: its own leader sends it home, seen off, beaten or its beat flown; not out of
        # touch with an enemy it has not met yet, nor beaten by the ones still on their moorings)
        if b.managed[side]: continue
        fighting = 0; other = 0
        loop a in b.actors:
            if a.status != .flying or not a.present or a.pilot.mode == .homeward or a.pilot.mode == .withdrawing: continue
            # (the player counts only while near an enemy: one gone off on their own fights no one)
            if a.human:
                near = false
                loop o in b.actors:
                    if o.side != a.side and o.status == .flying and o.present and f64(length(o.state.position-a.state.position)) < 5000.0: near = true
                if not near: continue
            if a.side == side: fighting += 1 else: other += 1
        lost = b.strength[side]-fighting
        # (and a long fight breaks up: after five minutes, half lost and not the stronger, home too)
        beaten = fighting > 0 and lost*2 >= b.strength[side] and (fighting*2 <= other or (b.tick > 60*300 and fighting <= other))
        won = fighting > 0 and other == 0 and b.tick > 600
        # (and a fight come apart, none of the side within CONTACT_RANGE of an enemy for CONTACT_LOST:
        # contact lost (up through the cloud, scattered), home, neither side beaten)
        apart = fighting > 0 and other > 0 and not _in_contact(b,side)
        if not apart: b.apart_since[side] = -1
        else: if b.apart_since[side] < 0: b.apart_since[side] = b.tick
        lost_touch = apart and b.tick-b.apart_since[side] >= CONTACT_LOST
        if not beaten and not won and not lost_touch: continue
        send_home(b,side,beaten,false)

# A side sent home (beaten, won, or told to on the radio): every one of its pilots still flying
# turns for home, regrouping first unless `at_once` (led straight home: "lead me home").
send_home = (b: mut Battle, side: int, beaten: bool, at_once: bool):
        if side < 0 or side > 2 or b.home_since[side] >= 0 or not _has_home(b,side): return
        b.home_since[side] = b.tick; b.home_leg[side] = -2
        if at_once: b.formed[side] = b.tick
        # (scattered by the fight, they regroup first: over the fight for the winners, a few
        # kilometres toward home for the beaten, under the cloud)
        centre = vec3(0,0,0); n = 0
        loop a in b.actors:
            if a.side == side and a.status == .flying and a.present and not a.human: centre += a.state.position; n += 1
        centre = if n > 0: centre/f32(n) else: b.center
        if beaten:
            # (toward home, or for a home past high ground, toward its way round)
            hm = _home_of(b,side)
            toward = (if hm.via.len() > 0: hm.via[hm.via.len()-1] else: hm.touchdown)-centre; toward.y = 0
            if length(toward) > 1: centre += normalize(toward)*5000.0
        b.rally[side] = vec3(centre.x,f32(min(RALLY_HEIGHT,b.ceiling-80.0)),centre.z)
        order = 0
        loop i in 0..b.actors.len():
            a = b.actors[i]
            if a.side != side or a.status != .flying or a.external or a.pilot.scripted or not a.present: continue
            a.pilot.home_turn = order; order += 1
            # A rescue already has a landing or departure plan. Reserve its
            # place at home and let the wingman finish the call first.
            if b.assist.stage > 0 and b.assist.craft == a.craft:
                b.actors[i] = a
                continue
            a.pilot.mode = .homeward
            a.pilot.trigger = false; a.pilot.target = -1; a.pilot.formation = false
            a.pilot.hold_want=vec3(0,0,0);a.pilot.close=false
            a.pilot.plan = FlightPlan(); a.pilot.descend_tick = -1; a.pilot.home_done = false
            b.actors[i] = a

# The player's word on the radio to their flight: returns how many are there to hear it (their
# side's pilots still flying in this battle). Going home starts at once.
give_order = (b: mut Battle, by: int, kind: OrderKind, target: int = -1) -> int:
    me = combat_index(b,by)
    if me < 0 or b.actors[me].side < 0 or b.actors[me].side > 2: return 0
    side = b.actors[me].side
    hear = 0
    loop a in b.actors:
        if a.side == side and a.craft != by and a.status == .flying and a.present and not a.human: hear += 1
    if hear == 0: return 0
    b.orders[side] = FlightOrder(kind,b.tick,by,b.actors[me].state.position,target)
    if kind == .go_home: send_home(b,side,true,false)
    if kind == .lead_home:
        if b.home_since[side] < 0: send_home(b,side,false,true)
        else: b.formed[side] = min(if b.formed[side] < 0: b.tick else: b.formed[side],b.tick)
    hear

# A pilot's order this moment, if it has one to follow (none with an enemy close on its tail).
_order_for = (b: Battle, index: int) -> FlightOrder:
    a = b.actors[index]
    if a.side < 0 or a.side > 2 or a.human: return FlightOrder()
    o = b.orders[a.side]
    if o.kind == .none or o.kind == .go_home or o.kind == .lead_home: return FlightOrder()
    loop e in b.actors:
        if e.side != a.side and e.status == .flying and e.present and e.pilot.target == index and f64(length(e.state.position-a.state.position)) < 700.0: return FlightOrder()
    o

# The pace a flight is led home at: one the player's own aircraft cruises at comfortably (they were
# held back flying with a leader at its own slow cruise); with the player in company, near the
# leader, their own speed, within reason, so the leader keeps with them rather than they with it.
_home_pace = (b: Battle, index: int) -> f64:
    a = b.actors[index]; k = a.spec
    pace = k.cruise_speed*0.82
    loop o in b.actors:
        if not o.human or o.side != a.side or o.status != .flying or o.state.on_water: continue
        pace = max(pace,o.spec.cruise_speed*0.88)
        if f64(length(o.state.position-a.state.position)) < 1500.0:
            pace = clamp(f64(length(o.state.velocity)),pace*0.85,pace*1.2)
    min(pace,k.max_speed*0.92)

# Whether the ground under the straight way from `from` to `to` stays below `altitude` with room
# to spare (sampled every 150 m).
_clear_way = (e: FlightEnv, from: vec3, to: vec3, altitude: f64) -> bool:
    d = vec3(to.x-from.x,0,to.z-from.z); n = max(2,int(f64(length(d))/150.0))
    loop i in 0..n+1:
        q = from+d*f32(f64(i)/f64(n))
        if e.ground(f64(q.x),f64(q.z)) > altitude-90.0: return false
    true

# The height to fly the way to `to` at: the home's, or over what lies between with room.
_way_height = (e: FlightEnv, from: vec3, to: vec3, altitude: f64) -> f64:
    d = vec3(to.x-from.x,0,to.z-from.z); n = max(2,int(f64(length(d))/150.0)); top = 0.0
    loop i in 0..n+1:
        q = from+d*f32(f64(i)/f64(n)); top = max(top,e.ground(f64(q.x),f64(q.z)))
    max(altitude,top+180.0)

# Each side going home past high ground: its leg of the way round, chosen once it has formed up
# (straight in if the touchdown is clear; else the nearest-home point of the way reachable clear;
# else the outer one), then one point nearer home each time the leader comes within 1.8 km of it,
# and straight in once the touchdown is clear. Kept, not chosen afresh: a leader at the edge of
# a clear line would turn back and forth between two.
_home_legs = (b: mut Battle, e: FlightEnv):
    loop side in 0..3:
        if b.home_since[side] < 0 or b.formed[side] < 0 or not _has_home(b,side): continue
        h = _home_of(b,side)
        if h.via.len() == 0 or b.home_leg[side] == -1: continue
        lead = home_leader(b,side)
        if lead < 0: continue
        at = b.actors[lead].state.position
        touchdown = if b.actors[lead].pilot.plan.initialized: b.actors[lead].pilot.plan.target else: h.touchdown
        # (straight in only with room: the ground under the way 150 m below the height flown)
        if _clear_way(e,at,touchdown,h.altitude-60.0): b.home_leg[side] = -1; continue
        if b.home_leg[side] == -2:
            b.home_leg[side] = h.via.len()-1
            loop k in 0..h.via.len():
                if b.home_leg[side] == h.via.len()-1 and _clear_way(e,at,h.via[k],h.altitude): b.home_leg[side] = k
            continue
        leg = b.home_leg[side]
        if f64(length(vec3(h.via[leg].x-at.x,0,h.via[leg].z-at.z))) < 1800.0: b.home_leg[side] = leg-1

# The player flying in company with this one (on its side, up, within 1.5 km).
_player_near = (b: Battle, index: int) -> bool:
    a = b.actors[index]
    loop o in b.actors:
        if o.human and o.side == a.side and o.status == .flying and not o.state.on_water and f64(length(o.state.position-a.state.position)) < 1500.0: return true
    false

# Home: the leader flies its own approach (the autopilot: cruise, descent, landing, taxi to the
# first mooring); the others keep their slots on it until it starts down, then circle the bay,
# stacked, and land in turn, LAND_GAP apart, each taxiing to its own mooring along the quay.
_homeward = (b: Battle, index: int, e: FlightEnv, p: mut CombatPilot) -> CombatPilot:
    a = b.actors[index]; s = a.state; k = a.spec
    p.mode = .homeward; p.trigger = false
    if p.home_done:
        p.controls = Controls(throttle = 0.0, water_brake = 1.0, anchor = true)
        return p
    if not _has_home(b,a.side):
        away = s.position-b.center; away.y = 0
        if length(away) < 1: away = quat_rotate(s.orientation,vec3(0,0,-1))
        p.controls = air_waypoint_controls(k,s,e,s.position+normalize(away)*2000.0,350.0,k.cruise_speed*0.9)
        return p
    h = _home_of(b,a.side)
    lead = home_leader(b,a.side)
    if b.formed[a.side] < 0:
        # (regrouping: to the rally point, then round it, each a little apart, the leader too)
        r = b.rally[a.side]
        d = f64(length(vec3(s.position.x-r.x,0,s.position.z-r.z)))
        if d < RALLY_NEAR: p.rallied = true
        if d > RALLY_NEAR*1.2:
            p.controls = air_waypoint_controls(k,s,e,r,f64(r.y),k.cruise_speed*0.8)
            return p
        out = s.position-r; out.y = 0
        if length(out) < 1: out = vec3(1,0,0)
        # (round it close, so the flight is together when it forms up: within a turn's reach of each
        # other, not strung round a wide circle)
        around = f64(atan2(f64(out.z),f64(out.x)))+0.6
        aim = r+vec3(f32(cos(around)*650.0),0,f32(sin(around)*650.0))
        p.controls = air_waypoint_controls(k,s,e,aim,f64(r.y)+20.0*f64(p.home_turn%3),k.cruise_speed*0.65)
        return p
    rank = 0
    loop o in b.actors:
        if o.side == a.side and o.status == .flying and o.pilot.mode == .homeward and not o.human and o.pilot.home_turn < p.home_turn: rank += 1
    descending = if lead >= 0 and lead != index: b.actors[lead].pilot.descend_tick else: p.descend_tick
    mine = lead == index or (descending >= 0 and b.tick >= descending+rank*LAND_GAP)
    if mine:
        if not p.plan.initialized:
            touchdown,landing = home_runway(h,e)
            # (leading the player home: a pace they can follow)
            leading = b.orders[a.side].kind == .lead_home
            p.plan = FlightPlan(target = touchdown, taxi_target = h.dock+h.step*f32(p.home_turn), altitude = h.altitude, landing_heading = landing, phase = .cruise, speed = if lead == index: _home_pace(b,index) else: 0.0)
        if lead == index and p.plan.phase == .cruise:
            # (leading the flight home at the player's pace; throttled back while a follower (not the
            # player, who sets the pace) is still well out of its slot)
            spread = 0.0
            loop o in b.actors:
                if o.side == a.side and o.status == .flying and o.pilot.mode == .homeward and not o.human and o.craft != a.craft:
                    spread = max(spread,f64(length(home_slot(b,index,o.pilot.formation_offset)-o.state.position)))
            # (the player in company sets the pace: the stragglers open up to catch it, as they do)
            p.plan.speed = _home_pace(b,index)*(if _player_near(b,index): 1.0 else: 1.0-0.25*smoothstep(500.0,1500.0,spread))
        # (high ground between: by the way round instead, the leader to the first point of it it
        # can reach clear, at the same pace, the flight in its slots behind)
        leg = b.home_leg[a.side]
        if lead == index and p.plan.phase == .cruise and leg >= 0 and leg < h.via.len():
            w = h.via[leg]
            p.controls = air_waypoint_controls(k,s,e,vec3(w.x,0,w.z),_way_height(e,s.position,w,h.altitude),p.plan.speed)
            return p
        c = autopilot(k,s,p.plan,e)
        if (p.plan.phase == .descend or p.plan.phase == .land) and p.descend_tick < 0: p.descend_tick = b.tick
        if p.plan.phase == .failed and s.beached and not s.crashed and f64(length((p.plan.taxi_target-s.position).xz)) < 25.0 and f64(length(s.velocity)) < 4.0*pure_k(k):
            # (run gently aground at her own mooring by the shore: home, made fast where she lies,
            # not opened up and driven up the beach to go round again)
            p.plan.phase = .done; c = Controls(throttle = 0.0, water_brake = 1.0, anchor = true)
        if p.plan.phase == .failed:
            # (waved off for good: round again from the start of the approach)
            p.plan.phase = .cruise; p.plan.go_arounds = 0
        if p.plan.phase == .done: p.home_done = true
        p.controls = c
        return p
    if descending < 0 and lead >= 0:
        # (in its slot on the leader)
        l = b.actors[lead].state
        slot = home_slot(b,lead,p.formation_offset)
        direction = heading_vector(heading(l))
        lv = f64(length(l.velocity))
        # (well out of position, a straggler opens right up to catch the formation)
        gap = f64(length(slot-s.position))
        fastest = lv*1.25+max(f64(k.max_speed)-lv*1.25,0.0)*smoothstep(300.0,900.0,gap)
        pace = clamp(lv+f64(dot(slot-s.position,direction))*0.12,lv*0.75,fastest)
        p.controls = air_waypoint_controls(k,s,e,slot+direction*1000.0,f64(slot.y),pace)
        return p
    # (its turn not yet come: round the bay on the approach side, stacked by turn)
    touchdown,landing = home_runway(h,e)
    centre = touchdown-heading_vector(landing)*1600.0
    out = s.position-centre; out.y = 0
    if length(out) < 1: out = vec3(1,0,0)
    around = f64(atan2(f64(out.z),f64(out.x)))+0.45
    aim = centre+vec3(f32(cos(around)*900.0),0,f32(sin(around)*900.0))
    p.controls = air_waypoint_controls(k,s,e,aim,min(h.altitude+28.0*f64(rank),b.ceiling-40.0),k.cruise_speed*0.75)
    p

# ---------------- ditching ----------------
# Can it be put down on the water: the engine gone but wings and tail still there and answering,
# no fire, the pilot sound, over the sea ahead, and low (higher, the parachute).
_can_ditch = (a: Combatant, e: FlightEnv) -> bool:
    s = a.state
    if s.crashed or a.fire > 0 or a.pilot_hit or s.on_water: return false
    loop part in [2,3,6]:
        if not s.damage.parts[part].attached: return false
    if f64(length(s.velocity)) < a.spec.stall_speed*pure_k(a.spec)*0.85: return false
    above = f64(s.position.y)-max(0.0,e.ground(f64(s.position.x),f64(s.position.z)))
    if above > 260.0: return false
    loop t in [0.0,4.0,8.0,12.0]:
        q = s.position+s.velocity*f32(t)
        if e.ground(f64(q.x),f64(q.z)) > -1.0: return false
    true

# A glide to the water, wings level, at a little over the stall, the flare in the last metres.
_ditch_controls = (a: Combatant, e: FlightEnv) -> Controls:
    s = a.state; k = a.spec
    if s.on_water: return Controls(throttle = 0.0, water_brake = 1.0)
    fwd = quat_rotate(s.orientation,vec3(0,0,-1))
    flat = vec3(fwd.x,0,fwd.z)
    if length(flat) < 0.1: flat = vec3(s.velocity.x,0,s.velocity.z)
    flat = normalize(flat+vec3(0.0001,0,0))
    st = k.stall_speed*pure_k(k); speed = max(f64(length(s.velocity)),1.0)
    hgt = f64(s.position.y)-k.float_height-max(0.0,e.ground(f64(s.position.x),f64(s.position.z)))
    slope = if speed < st*1.3: -0.16 else: if speed > st*1.6: -0.05 else: -0.09
    if hgt < 25.0: slope = -clamp(hgt*0.3,0.6,4.5)/speed
    c = steer(k,s,normalize(flat+vec3(0,f32(slope),0)))
    c.throttle = 0.0; c.roll = clamp(c.roll,-0.6,0.6); c.assist = 0.0
    c

# The pilot out of a ditched aircraft into the water beside it: in the water, a survivor.
_ditched_out = (b: mut Battle, i: int):
    a = b.actors[i]; p = aircraft_profile(a.spec.kind)
    side = quat_rotate(a.state.orientation,vec3(1,0,0)); side.y = 0
    at = a.state.position+normalize(side+vec3(0.0001,0,0))*f32(p.span*0.5+1.5)
    at.y = -0.5
    d = leave_aircraft(a.person,a.craft,world_point(at),a.state.orientation,vec3(0,0,0),vec3(0,0,0))
    d.position = at; d.point = world_point(at); d.published = at; d.velocity = vec3(0,0,0); d.phase = .swimming; d.wet = 0.0
    b.descents.push(d)
    a.bailed = true; a.ditched = true; a.external = false; a.status = .wreck; a.gun.locked = true; a.pilot.trigger = false
    b.actors[i] = a
    _event(b,.landed,a,at,a.last_attacker,outcome=true)
    last = b.outcomes.len()-1
    b.outcomes[last].injury = 0.1; b.outcomes[last].at_sea = true

bail_combatant = (b: mut Battle, i: int) -> bool:
    if i < 0 or i >= b.actors.len() or b.actors[i].bailed or b.actors[i].state.moored: return false
    a = b.actors[i]; p = aircraft_profile(a.spec.kind)
    seat = vec3(0,p.width+0.4,p.cockpit_z)
    b.descents.push(leave_aircraft(a.person,a.craft,craft_point(a.state),a.state.orientation,a.state.velocity,seat))
    a.bailed = true; a.external = false; a.status = .disabled; a.gun.locked = true; a.pilot.trigger = false
    b.actors[i] = a
    _event(b,.bailed,a,a.state.position,a.last_attacker,outcome=true)
    true

# Damage is tuned to "a few good bursts": two to four solid bursts from twin guns at fighting
# range bring an aircraft down (engine fire or seizure, a wing or the tail shot away, or the
# pilot hit); glancing hits do partial damage, and one burst kills only with a lucky hit on the
# engine or the pilot. The round's damage is scaled by BULLET_DAMAGE and the part's toughness (the
# fuselage's frame stands more than fabric wings or the tail), and divided by the player's
# toughness (Tweaks) on the player's own aircraft.
const BULLET_DAMAGE = 2.4
PART_TOUGHNESS = [1.9,0.9,1.85,1.85,1.4,1.4,1.1]   # body, engine, left/right wing, floats, tail
const PILOT_REACH = 0.75                         # m around the pilot's seat a round may strike him
const PILOT_CHANCE = 0.35                        # (the rest pass through the cockpit's side)

bullet_damage = (a: Combatant, part: PartId, amount: f64) -> f64:
    scale = sqrt(1400.0/a.spec.mass)
    hurt = amount*scale*BULLET_DAMAGE/PART_TOUGHNESS[int(part)]
    if a.human: hurt / max(0.25,tweaks.player_toughness) else: hurt

apply_bullet_hit = (b: mut Battle, i: int, part: PartId, point: vec3, direction: vec3, amount: f64, attacker: int):
    a = b.actors[i]; id = int(part)
    if not a.state.damage.parts[id].attached: return
    a.state.damage.parts[id].health = max(0.0,a.state.damage.parts[id].health-bullet_damage(a,part,amount))
    # (a round through the cockpit may strike the pilot: an NPC is out of the fight; the player's
    # own pilot is spared, his aircraft takes it)
    if part == .body and not a.human and not a.pilot_hit:
        seat = vec3(0,aircraft_profile(a.spec.kind).width+0.4,aircraft_profile(a.spec.kind).cockpit_z)
        near = quat_rotate(quat_inverse(a.state.orientation),point-a.state.position)-seat
        if length(near) < PILOT_REACH and combat_noise(b.seed,a.craft,b.next_serial,5)*0.5+0.5 < PILOT_CHANCE: a.pilot_hit = true
    a.last_attacker = attacker
    shooter=combat_index(b,attacker)
    if a.external and not a.human and a.status==.flying:
        a.external=false; a.gun.locked=false
        if a.engagement<0:
            a.engagement=1000000+min(a.craft,attacker)
            a.rally=a.state.position
        a.pilot.target=shooter
    if shooter>=0 and b.actors[shooter].engagement<0 and a.engagement>=0:
        b.actors[shooter].engagement=a.engagement
        b.actors[shooter].rally=a.rally
    local = quat_rotate(quat_inverse(a.state.orientation),point-a.state.position)
    normal = -quat_rotate(quat_inverse(a.state.orientation),normalize(direction))
    if a.marks.len() >= 24: a.marks.remove_at(0)
    a.marks.push(HitMark(local,normal,part))
    if a.state.damage.parts[id].health <= 0:
        detach_part(a.state.damage,a.spec.parts,part,a.spec.mass,a.state.position,a.state.orientation,a.state.velocity,a.state.angular_velocity)
        _event(b,.separated,a,point,attacker,part)
    if part == .engine and a.state.damage.parts[id].health < 0.55 and a.fire == 0:
        a.fire = 0.3
        _event(b,.ignition,a,point,attacker,part)
    refresh_damage(a.spec,a.state)
    b.actors[i] = a
    _event(b,.hit,a,point,attacker,part,amount,direction)

# Aim assist (the player's, on Tweaks): the enemy a round leaving the muzzle is most plainly
# fired at, within ASSIST_CONE of where it would meet the round and ASSIST_REACH: none otherwise.
const ASSIST_CONE = 0.9986          # cos 3 degrees
const ASSIST_REACH = 700.0
const ASSIST_TURN = 0.07            # radians a second the round's path may bend (4 degrees)
const ASSIST_TIME = 0.6             # seconds after the muzzle it may bend

_assist_meet = (from: vec3, speed: f64, o: Combatant) -> vec3:
    rel = o.state.position-from
    t = f64(length(rel))/max(speed,1.0)
    loop _ in 0..2: t = f64(length(rel+o.state.velocity*f32(t)))/max(speed,1.0)
    rel+o.state.velocity*f32(t)+vec3(0,f32(4.905*t*t),0)

_assist_target = (b: Battle, i: int, at: vec3, velocity: vec3) -> int:
    side = b.actors[i].side; way = normalize(velocity); speed = f64(length(velocity))
    best = -1; nearest = ASSIST_CONE
    loop j in 0..b.actors.len():
        o = b.actors[j]
        if j == i or o.side == side or not o.present or o.status != .flying or o.bailed: continue
        meet = _assist_meet(at,speed,o)
        d = f64(length(meet))
        if d > ASSIST_REACH or d < 5.0: continue
        on = f64(dot(way,meet/f32(d)))
        if on > nearest: nearest = on; best = o.craft
    best

_fire_round = (b: mut Battle, i: int):
    a = b.actors[i]
    configure_player_gun(a,a.gun.choice,a.gun.endless)
    gun = combat_gun_spec(a)
    rapid=a.human and a.gun.choice==0
    endless=a.human and a.gun.endless
    a.gun.cool = max(if a.human and a.pilot.trigger and a.gun.shots>0:-COMBAT_DT else:0.0,a.gun.cool-COMBAT_DT)
    a.gun.heat = max(0.0,a.gun.heat-COMBAT_DT*(if rapid:0.35 else:0.18))
    if rapid:a.gun.jammed=false
    else:
        if a.gun.heat >= 1: a.gun.jammed = true
        if a.gun.heat < 0.35: a.gun.jammed = false
    if a.status == .flying and not a.bailed and a.pilot.trigger and not a.gun.locked and not a.gun.jammed and (endless or a.gun.ammo > 0) and a.gun.cool <= 0 and b.rounds.len() < COMBAT_MAX_ROUNDS:
        mounts = gun_mounts(a.spec.kind,gun.mounts); local = mounts[a.gun.shots%mounts.len()]
        point=craft_offset(a.state,quat_rotate(a.state.orientation,local))
        at=world_vec(point)
        jitter = vec3(combat_noise(b.seed,a.craft,a.gun.shots,0),combat_noise(b.seed,a.craft,a.gun.shots,1),0)*f32(gun.spread)
        # Convergence is physical: no target seeking or bending after the round is fired (except
        # the player's rounds under the aim assist Tweak).
        dir = quat_rotate(a.state.orientation,normalize(vec3(0,0,-450)-local+jitter*450.0))
        round = Round(at,a.state.velocity+dir*f32(420.0*b.bullet_scale),a.craft,a.side,gun.damage,tracer=rapid or a.gun.shots%3==0,serial=b.next_serial,point=point)
        if a.human:
            if tweaks.generous_hits: round.wide = max(0.0,tweaks.hit_margin)
            if tweaks.aim_assist: round.assist = _assist_target(b,i,at,round.velocity)
        b.rounds.push(round)
        a.gun.shots += 1
        if not endless:a.gun.ammo -= 1
        a.gun.heat += 0.035
        interval=(if rapid and a.gun.heat>0.85:1.6 else:1.0)/gun.rate
        a.gun.cool = if a.human:a.gun.cool+interval else:interval
        _event(b,.shot,a,at,direction=dir,strength=f64(gun.voice))
    b.actors[i] = a

# Clear sight from a post: terrain sampled along the line, and the environment's solids (the
# canal city's buildings and bridges) swept in short pieces so each query stays local.
ground_sight = (e: FlightEnv, from: vec3, to: vec3) -> bool:
    span = f64(length(to-from))
    if span < 1.0: return true
    way = (to-from)/f32(span)
    start = from+way*1.5; stop = to-way*12.0
    run = f64(length(stop-start))
    if run <= 0: return true
    steps = max(1,int(run/40.0)+1)
    loop k in 1..steps:
        p = lerp(start,stop,f32(f64(k)/f64(steps)))
        if f64(p.y) < e.ground(f64(p.x),f64(p.z)): return false
    loop k in 0..steps:
        a = lerp(start,stop,f32(f64(k)/f64(steps)))
        z = lerp(start,stop,f32(f64(k+1)/f64(steps)))
        if e.solid(a,z).w > 0: return false
    true

# Riflemen take aimed single shots; machine guns fire short bursts. Both lead with the round's
# time of flight and drop (combat's intercept), wander by skill, scatter by stateless noise, and
# wait a reaction time after first sighting. Deterministic: no random() calls.
step_ground_fire = (b: mut Battle, e: FlightEnv):
    speed = 420.0*b.bullet_scale
    loop k in 0..b.ground.len():
        g = b.ground[k]
        if g.disabled or b.tick < g.wake: continue
        g.cool = max(0.0,g.cool-COMBAT_DT)
        out = (p: vec3) -> bool:
            d = vec2(p.x-g.position.x,p.z-g.position.z)
            if length(d) < 0.5: return false
            abs(angle_delta(g.facing,atan2(f64(d.x),-f64(d.y)))) > g.arc
        lost = g.target >= 0 and (g.target >= b.actors.len() or not b.actors[g.target].present or b.actors[g.target].status != .flying or b.actors[g.target].bailed or out(b.actors[g.target].state.position))
        # (a post with nothing in sight waits for its next look; only a lost target is looked
        # for again at once)
        if (b.tick+k)%12 == 0 or lost:
            # (nearest first; sight is the costly part, so at most two are looked for)
            best = -1; tried = 0; floor = 0.0
            loop tried < 2:
                pick = -1; nearest = g.reach
                loop i in 0..b.actors.len():
                    a = b.actors[i]
                    if not a.present or a.status != .flying or a.bailed or a.side == g.side or out(a.state.position): continue
                    d = f64(length(a.state.position-g.position))
                    if d > floor and d < nearest: pick=i; nearest=d
                if pick < 0: break
                if ground_sight(e,g.position,b.actors[pick].state.position): best = pick; break
                floor = nearest; tried += 1
            if best != g.target: g.seen = b.tick
            g.target = best
        if g.target < 0:
            g.burst = 0; b.ground[k] = g; continue
        t = b.actors[g.target]
        delta = t.state.position-g.position; distance = f64(length(delta))
        aim = intercept(delta,t.state.velocity,speed)
        across = normalize(cross(aim,vec3(0,1,0))+vec3(0.0001,0,0)); over = normalize(cross(across,aim))
        err = (1.0-g.skill)*min(distance*0.08,26.0)
        phase = f64(b.tick)*0.021+f64(-g.id)*1.7
        want = normalize(aim+across*f32(sin(phase)*err)+over*f32(cos(phase*0.83)*err*0.7))
        # (a man swings a rifle or a gun on its tripod only so fast: a close crossing outruns it,
        # and the gun's fire falls in behind)
        rifle = g.kind == .rifle
        swing = (if rifle: 1.3 else: 0.8)*COMBAT_DT
        gap = acos(clamp(f64(dot(g.aim,want)),-1.0,1.0))
        if gap <= swing: g.aim = want
        else:
            turn = normalize(want-g.aim*dot(g.aim,want)+vec3(0,0.000001,0))
            g.aim = normalize(g.aim*f32(cos(swing))+turn*f32(sin(swing)))
        on = gap < (if rifle: 0.03 else: 0.12)
        react = if rifle: 55 else: 40
        if b.tick-g.seen >= react and g.cool <= 0 and (on or (not rifle and g.burst > 0)) and b.rounds.len() < COMBAT_MAX_ROUNDS:
            spread = if rifle: 0.010 else: 0.018
            jitter = vec3(combat_noise(b.seed,g.id,g.shots,0),combat_noise(b.seed,g.id,g.shots,1),combat_noise(b.seed,g.id,g.shots,2))*f32(spread)
            dir = normalize(g.aim+jitter)
            muzzle = g.position+g.aim*f32(if rifle: 1.05 else: 0.98)
            b.rounds.push(Round(muzzle,dir*f32(speed),g.id,g.side,if rifle: 0.03 else: 0.024,tracer=(not rifle and g.shots%2==0) or (rifle and g.shots%3==0),serial=b.next_serial))
            b.events.push(CombatEvent(b.next_serial,.shot,g.id,-1,-1,muzzle,dir,if rifle: 0.0 else: 1.0)); b.next_serial += 1
            g.shots += 1
            pause = 0.5+0.5*combat_noise(b.seed,g.id,g.shots,3)
            if rifle: g.cool = 1.5+1.3*pause
            else:
                if g.burst <= 0: g.burst = 8+int(pause*6.0)
                g.burst -= 1
                g.cool = if g.burst > 0: 1.0/9.0 else: 1.8+1.4*pause
        b.ground[k] = g

struct RoundCell:
    x:int
    z:int

# Swept AABBs in a 128m XZ grid. Y and the actual swept ellipsoids still decide hits.
# Exceptionally long sweeps use the bounded full list; teleports cannot grow a huge grid.
step_combat_rounds = (b: mut Battle, e: FlightEnv, broad_phase:bool = true):
    b.sweeps.clear()
    indexed=broad_phase and b.actors.len()>24 and b.rounds.len()>0
    cells:{RoundCell:int[]};wide:int[]
    indices=[loop i in 0..b.actors.len():i]
    if indexed:
        loop i in indices:
            a=b.actors[i]
            if not a.present or a.status==.escaped:continue
            r=a.spec.span
            x0=int(floor((min(f64(a.previous.x),f64(a.state.position.x))-r)/128.0))
            x1=int(floor((max(f64(a.previous.x),f64(a.state.position.x))+r)/128.0))
            z0=int(floor((min(f64(a.previous.z),f64(a.state.position.z))-r)/128.0))
            z1=int(floor((max(f64(a.previous.z),f64(a.state.position.z))+r)/128.0))
            if (x1-x0+1)*(z1-z0+1)>64:wide.push(i);continue
            loop x in x0..x1+1:
                loop z in z0..z1+1:
                    key=RoundCell(x,z);bucket=cells.get(key,[]);bucket.push(i);cells[key]=bucket
    seen=fill(-1,b.actors.len());serial=0
    n = 0
    loop n < b.rounds.len():
        r = b.rounds[n]; r.age += COMBAT_DT
        r.velocity.y -= f32(9.81*COMBAT_DT)
        # (aim assist: bent a little toward the enemy it was fired at, in its first moments only)
        if r.assist >= 0 and r.age < ASSIST_TIME:
            k = combat_index(b,r.assist)
            if k >= 0 and b.actors[k].status == .flying:
                speed = f64(length(r.velocity))
                want = normalize(_assist_meet(r.position,speed,b.actors[k]))
                way = normalize(r.velocity)
                gap = acos(clamp(f64(dot(way,want)),-1.0,1.0))
                if gap > 1e-5 and gap < 0.1:
                    turn = min(1.0,ASSIST_TURN*COMBAT_DT/gap)
                    r.velocity = normalize(lerp(way,want,f32(turn)))*f32(speed)
        next_point=world_offset(r.point ?? world_point(r.position),r.velocity*f32(COMBAT_DT))
        end=world_vec(next_point)
        best = 2.0; victim = -1; boat_id = -1; part = PartId.body
        candidates=indices
        if indexed:
            x0=int(floor(min(f64(r.position.x),f64(end.x))/128.0));x1=int(floor(max(f64(r.position.x),f64(end.x))/128.0))
            z0=int(floor(min(f64(r.position.z),f64(end.z))/128.0));z1=int(floor(max(f64(r.position.z),f64(end.z))/128.0))
            if (x1-x0+1)*(z1-z0+1)<=64:
                candidates=wide
                loop i in wide:seen[i]=serial
                loop x in x0..x1+1:
                    loop z in z0..z1+1:
                        loop i in cells.get(RoundCell(x,z),[]):
                            if seen[i]!=serial:candidates.push(i);seen[i]=serial
            serial+=1
        loop i in candidates:
            if not b.actors[i].present:continue
            if b.actors[i].craft==r.owner or b.actors[i].side==r.side or b.actors[i].status==.escaped:continue
            a = b.actors[i]
            b.pair_tests += 1
            mid = (r.position+end)*0.5-a.state.position
            radius = a.spec.span+r.wide+f64(length(end-r.position))*0.5+f64(length(a.state.position-a.previous))
            if dot(mid,mid) > radius*radius: continue
            b.narrow_tests += 1
            at,id = hit_aircraft(a,r.position,end,r.wide)
            if at < best or (at == best and victim >= 0 and a.craft < b.actors[victim].craft): best=at; victim=i; part=id
        loop j in 0..b.boats.len():
            boat = b.boats[j]
            if boat.side == r.side or boat.disabled: continue
            c = cos(boat.yaw); sn = sin(boat.yaw)
            local = (p: vec3) -> vec3:
                d = p-boat.position
                vec3(f32(f64(d.x)*c-f64(d.z)*sn),d.y,f32(f64(d.x)*sn+f64(d.z)*c))
            at = segment_ellipsoid(local(r.position),local(end),vec3(0,0,0),boat.half)
            if at < best: best=at; victim=-1; boat_id=j
        post = -1
        loop j in 0..b.ground.len():
            g = b.ground[j]
            if g.disabled or g.side == r.side: continue
            if length(r.position-g.position) > 2200 and length(end-g.position) > 2200: continue
            at = segment_ellipsoid(r.position,end,g.position-vec3(0,g.half.y*0.6,0),g.half)
            if at < best: best=at; victim=-1; boat_id=-1; post=j
        # Swept terrain/sea sampling prevents a fast round passing through an intervening ridge.
        surface = 2.0
        loop j in 0..9:
            at = f64(j)/8.0; p = lerp(r.position,end,f32(at))
            if p.y <= max(0.0,e.ground(f64(p.x),f64(p.z))): surface=at; break
        if surface <= best:
            if surface <= 1:
                owner = combat_index(b,r.owner)
                if owner >= 0: _event(b,.splash,b.actors[owner],lerp(r.position,end,f32(surface)),strength=0.2)
                else:
                    # (a ground gun's round: the same strike, under its own owner ID)
                    b.events.push(CombatEvent(b.next_serial,.splash,r.owner,-1,-1,lerp(r.position,end,f32(surface)),strength=0.2)); b.next_serial += 1
        else if victim >= 0:
            apply_bullet_hit(b,victim,part,lerp(r.position,end,f32(best)),r.velocity,r.damage,r.owner)
        else if boat_id >= 0:
            b.boats[boat_id].health = max(0.0,b.boats[boat_id].health-r.damage*0.45)
            b.boats[boat_id].attacker = r.owner
            if b.boats[boat_id].health == 0:
                b.boats[boat_id].disabled = true
                owner = combat_index(b,r.owner)
                if owner >= 0:
                    _event(b,.boat_disabled,b.actors[owner],b.boats[boat_id].position,b.boats[boat_id].id,outcome=true)
                    b.outcomes[b.outcomes.len()-1].boat=b.boats[boat_id].id
                    b.outcomes[b.outcomes.len()-1].attacker=r.owner
        else if post >= 0:
            g = b.ground[post]
            g.health = max(0.0,g.health-r.damage*(if g.kind==.rifle: 3.0 else: 1.6))
            point = lerp(r.position,end,f32(best))
            b.events.push(CombatEvent(b.next_serial,.hit,g.id,-1,r.owner,point,r.velocity,r.damage));b.next_serial+=1
            if g.health <= 0: g.disabled = true; g.target = -1; g.burst = 0
            b.ground[post] = g
        b.sweeps.push(RoundSweep(r.owner,r.serial,r.position,lerp(r.position,end,f32(min(1.0,min(best,surface))))))
        if best <= 1 or surface <= 1 or r.age > 2.5: b.rounds.remove_at(n)
        else: r.position=end;r.point=next_point; b.rounds[n]=r; n+=1

# Observer changes only simulation detail, never faction/intent. Fixed inputs + the same LOD
# schedule are deterministic. Near bodies use full 120 Hz flight/contact physics; far bodies
# above terrain use the same air equations once per tick, avoiding per-contact terrain reads.
step_battle = (b: mut Battle, e: FlightEnv, observer: vec3):
    if not b.enabled: return
    b.events.clear(); b.pair_tests=0; b.narrow_tests=0; b.brain_steps=0; b.physics_steps=0
    b.tick += 1
    loop i in 0..b.actors.len():
        a = b.actors[i]
        # Presentation has finished sinking this wreck. Keep its identity/outcomes and
        # independent pilot descent, but stop invisible water contacts and bullet tests.
        if a.status==.wreck and a.wreck_age>90:a.present=false
        if not a.external:a.spec.combat_flight=true
        if not a.external:
            a.previous_point=craft_point(a.state)
            a.previous = a.state.position;a.previous_rotation=a.state.orientation;a.render_ready=true
        if a.status == .escaped or not a.present: b.actors[i]=a; continue
        distance = length(a.state.position-observer)
        a.lod = if distance > 2800: 2 else: if distance > 1200: 1 else: 0
        period = if a.lod==2: 30 else: if a.lod==1: 15 else: 6
        # (coming in to land at home the autopilot flies the flare and the taxi: every tick, however
        # far, or a held stick porpoises it into the water)
        if a.pilot.mode==.homeward and not a.pilot.home_done and (a.pilot.plan.phase==.descend or a.pilot.plan.phase==.land or a.pilot.plan.phase==.taxi): period = 1
        # (on flight model v2 the stick asks for a rate of roll and of turn: held half a second it
        # swings her far past the bank wanted. Flying in formation, regrouping or the way home is
        # steered by the autopilot, no dogfight brain, so every other tick)
        if (a.pilot.mode==.homeward or a.pilot.mode==.regroup or a.pilot.formation) and fdm2_active(a.spec): period = min(period,2)
        b.actors[i]=a
        if not a.external and not a.pilot.scripted and a.status == .flying and (a.pilot.brain_tick<0 or (b.tick+a.craft)%period==0):
            was=a.pilot.mode
            a.pilot=combat_controls(b,i,e); b.brain_steps+=1
            if a.pilot.mode!=was:
                if b.tactics.len()<20:b.tactics=fill(0,20)
                b.tactics[int(a.pilot.mode)]+=1
        # (far from the player, a pilot on a gun run still aims every few ticks: held for half a
        # second, its stick and trigger would spray past a target it should be tracking)
        else if not a.external and not a.pilot.scripted and a.status == .flying and a.lod > 0 and a.pilot.close and (b.tick+a.craft)%6==0:
            a.pilot=_retrack(b,i)
        # (on flight model v2, between thoughts, the stick worked toward the way last asked rather than
        # held: a held rate swings v2 far past it)
        else if not a.external and not a.pilot.scripted and a.status == .flying and length(a.pilot.hold_want) > 0.5 and fdm2_active(a.spec):
            a.pilot.controls=_fighter_stick(a.spec,a.state,a.pilot,b.tick)
        if a.pilot.mode == .ditching and not a.bailed:
            a.pilot.controls=_ditch_controls(a,e); a.pilot.trigger=false
        else if a.status == .disabled or a.bailed:
            a.pilot.controls=Controls(throttle=0,assist=0,roll=0.15)
            a.pilot.trigger=false
        if not a.external:
            # Far clear air uses one flight integration; close/contact/wreck paths keep full step.
            high = a.state.position.y > max(0.0,e.ground(f64(a.state.position.x),f64(a.state.position.z)))+140
            if a.lod > 0 and high and not a.state.crashed:
                step_distant(a.spec,a.state,a.pilot.controls,e)
            else: step(a.spec,a.state,a.pilot.controls,e,COMBAT_DT)
            b.physics_steps+=1
        a.prop += COMBAT_DT*(8.0+70.0*a.state.throttle)
        if a.fire > 0:
            a.fire_age += COMBAT_DT
            if a.state.on_water: a.fire=max(0.0,a.fire-COMBAT_DT*0.6)
            else:
                a.fire=min(1.0,a.fire+COMBAT_DT*0.04)
                a.state.damage.parts[1].health=max(0.0,a.state.damage.parts[1].health-COMBAT_DT*a.fire*0.035)
                a.state.damage.parts[0].health=max(0.0,a.state.damage.parts[0].health-COMBAT_DT*a.fire*0.012)
                loop part in [PartId.engine,PartId.body]:
                    if a.state.damage.parts[int(part)].health<=0 and a.state.damage.parts[int(part)].attached:
                        detach_part(a.state.damage,a.spec.parts,part,a.spec.mass,a.state.position,a.state.orientation,a.state.velocity,a.state.angular_velocity)
                        _event(b,.separated,a,a.state.position,part=part)
                refresh_damage(a.spec,a.state)
        # (a tail shot away leaves no control: that is the end of it too)
        hopeless = a.state.crashed or a.state.engine_damage > 0.95 or a.fire_age > 8.0+12.0*a.pilot.nerve or a.pilot_hit or not a.state.damage.parts[int(PartId.tail)].attached
        if hopeless and not a.down_reported:
            a.status=.disabled; a.down_reported=true
            _event(b,.downed,a,a.state.position,a.last_attacker,outcome=true)
        if a.status==.disabled and a.state.position.y < 15 and (a.state.on_water or a.state.beached): a.status=.wreck
        if a.status==.wreck: a.wreck_age+=COMBAT_DT
        if not a.last_wet and a.state.on_water and a.status != .flying: _event(b,.splash,a,a.state.position,strength=1.0)
        a.last_wet=a.state.on_water
        if (a.pilot.mode==.withdrawing or (a.pilot.mode==.homeward and not _has_home(b,a.side))) and length(a.state.position-a.rally)>b.retreat_radius and a.status==.flying:
            a.status=.escaped; a.external=true; _event(b,.fled,a,a.state.position,a.last_attacker,outcome=true)
        # (low over the sea with the engine gone and the aircraft still answering: put it down on
        # the water rather than jump; a fire or a wing gone, and there is height, jump after all)
        if hopeless and not a.external and not a.bailed and a.pilot.mode != .ditching and _can_ditch(a,e): a.pilot.mode = .ditching
        if a.pilot.mode == .ditching and not a.bailed:
            above = f64(a.state.position.y)-max(0.0,e.ground(f64(a.state.position.x),f64(a.state.position.z)))
            if (a.fire > 0 or not a.state.damage.parts[2].attached or not a.state.damage.parts[3].attached) and above > 70.0: a.pilot.mode = .down
        b.actors[i]=a
        if a.pilot.mode == .ditching and not a.bailed and a.state.on_water and f64(length(a.state.velocity)) < 3.0: _ditched_out(b,i)
        else if hopeless and not a.external and not a.bailed and a.pilot.mode != .ditching: bail_combatant(b,i)
    # Rotate launch order when the hard round budget is full, so the first faction in the
    # array cannot monopolize it. Each gun still advances exactly once per fixed tick.
    loop offset in 0..b.actors.len():_fire_round(b,(b.tick+offset)%b.actors.len())
    if b.ground.len() > 0: step_ground_fire(b,e)
    loop mut boat in b.boats:
        if not boat.disabled and not boat.external: boat.position+=boat.velocity*f32(COMBAT_DT)
    step_combat_rounds(b,e)
    loop i in 0..b.descents.len():
        d=b.descents[i]; step_descent(d,e.wind,e.ground,COMBAT_DT,d.steering,d.open_requested,e.water_level)
        b.descents[i]=d
        if d.landed_event:
            a=combat_index(b,d.craft)
            if a>=0:
                _event(b,.landed,b.actors[a],d.position,b.actors[a].last_attacker,outcome=true)
                last=b.outcomes.len()-1
                b.outcomes[last].injury=d.injury; b.outcomes[last].at_sea=d.phase==.swimming
    if b.tick%30 == 0:
        _turn_for_home(b)
        _home_legs(b,e)
    side=-1; contested=false
    loop a in b.actors:
        # (one gone home, or withdrawing hurt, no longer contests the fight)
        if a.status != .flying or a.pilot.mode == .homeward or a.pilot.mode == .withdrawing: continue
        if side<0: side=a.side
        else if side!=a.side: contested=true
    loop boat in b.boats:
        if boat.disabled:continue
        if side<0:side=boat.side
        else if side!=boat.side:contested=true
    b.finished=not contested
