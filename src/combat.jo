# Deterministic physical engagements. IDs refer to living-world people/aircraft; no economy,
# rescue, spawning of inhabitants, device reads or random() calls occur here.
use 'flight.jo'
use 'damage.jo'
use 'bailout.jo'
from 'planes.jo' import Craft, aircraft_profile, PartId

const COMBAT_DT = 1.0/60.0
const COMBAT_MAX_CRAFT = 64
const COMBAT_MAX_ROUNDS = 512

enum CombatRole: fighter, wingman, strike, escort, flee
enum CombatMode: pursuit, scissors, breakaway, regroup, evade, strafe, withdrawing, down
enum CombatStatus: flying, disabled, escaped, wreck

enum CombatEventKind: shot, hit, ignition, separated, downed, bailed, landed, fled, splash, boat_disabled
struct CombatEvent:
    serial: int
    kind: CombatEventKind
    craft: int
    person: int
    other: int
    position: vec3
    direction: vec3 = vec3(0,1,0)
    strength = 1.0
    part: PartId = .body

struct CombatOutcome:
    serial: int
    engagement: int
    craft: int
    person: int
    kind: CombatEventKind
    attacker: int
    position: vec3
    hull: f64
    engine: f64
    injury = 0.0
    at_sea = false
    boat = -1

struct GunSpec:
    rate: f64
    damage: f64
    spread: f64
    voice: int
    mounts: int

gun_spec = (kind: Craft) -> GunSpec:
    match kind:
        .corsair, .kestrel: GunSpec(14,0.12,0.003,2,2)
        .osprey, .cormorant: GunSpec(11,0.105,0.003,1,2)
        .pelican, .albatross: GunSpec(8,0.10,0.004,2,2)
        .tern, .kite, .ibis, .minnow: GunSpec(8,0.09,0.004,0,1)
        _: GunSpec(11,0.10,0.003,1,2)

gun_mounts = (kind: Craft) -> vec3[]:
    p = aircraft_profile(kind)
    y = if p.boat: p.width+0.15 else: p.width*0.5
    z = -p.length*0.38
    if gun_spec(kind).mounts == 1: [vec3(0,y,z)]
    else: [vec3(-p.width*0.8,y,z),vec3(p.width*0.8,y,z)]

struct CombatGun:
    locked = true
    cool = 0.0
    heat = 0.0
    jammed = false
    ammo = 700
    shots = 0

struct CombatPilot:
    skill = 0.6
    nerve = 0.65
    role: CombatRole = .fighter
    leader = -1                    # stable aircraft ID
    target = -1                    # cached local index, never a world ID
    boat = -1
    mode: CombatMode = .regroup
    hold = 0
    brain_tick = -1
    target_tick = -60
    controls: Controls = Controls()
    trigger = false

struct HitMark:
    local: vec3
    normal: vec3
    part: PartId

struct Combatant:
    craft: int
    person: int
    side: int
    spec: CraftSpec
    state: CraftState
    pilot: CombatPilot = CombatPilot()
    gun: CombatGun = CombatGun()
    status: CombatStatus = .flying
    external = false               # integrated by its existing human/traffic owner
    human = false
    present = true
    model = -1
    engagement = -1
    rally: vec3 = vec3(0,300,0)     # this engagement's origin, independent of other contacts
    previous: vec3 = vec3(0,0,0)
    fire = 0.0
    fire_age = 0.0
    last_attacker = -1
    bailed = false
    down_reported = false
    wreck_age = 0.0
    last_wet = false
    marks: HitMark[]
    prop = 0.0
    lod = 0

struct CombatBoat:
    id: int
    side: int
    position: vec3
    velocity: vec3
    half: vec3 = vec3(5,3,15)
    health = 1.0
    disabled = false
    external = false              # a vessel adapter already integrated this body
    yaw = 0.0                     # bow +z; hull hitbox rotates with the vessel
    attacker = -1

struct Round:
    position: vec3
    velocity: vec3
    owner: int                     # aircraft ID, not array position
    side: int
    damage: f64
    age = 0.0
    tracer = true

struct Battle:
    enabled = false
    engagement = -1
    seed: int = 1
    tick = 0
    center: vec3 = vec3(0,300,0)
    retreat_radius = 5000.0
    bullet_scale = 1.0
    actors: Combatant[]
    boats: CombatBoat[]
    rounds: Round[]
    descents: Descent[]
    events: CombatEvent[]           # presentation drains each fixed tick
    outcomes: CombatOutcome[]       # durable until the world acknowledges them
    next_serial = 0
    pair_tests = 0
    narrow_tests = 0
    brain_steps = 0
    physics_steps = 0
    finished = false

combat_index = (b: Battle, craft: int) -> int:
    loop i in 0..b.actors.len():
        if b.actors[i].craft == craft: return i
    -1

# Stateless scatter: cosmetic RNG, array capacity and render cadence cannot alter a hit.
combat_noise = (seed: int, id: int, shot: int, axis: int) -> f64:
    n = (seed*97+id*7919+shot*104729+axis*65537) % 2147483647
    n = (n*48271) % 2147483647
    f64(n % 20001)/10000.0-1.0

start_engagement = (id: int, seed: int, center: vec3, actors: Combatant[], boats: CombatBoat[] = []) -> Battle:
    assert(actors.len() <= COMBAT_MAX_CRAFT)
    b = Battle(enabled=true,engagement=id,seed=seed,center=center,actors=actors,boats=boats)
    loop i in 0..b.actors.len():
        assert(b.actors[i].craft >= 0 and b.actors[i].person >= 0)
        loop j in 0..i: assert(b.actors[i].craft != b.actors[j].craft and b.actors[i].person != b.actors[j].person)
        b.actors[i].engagement = id
        b.actors[i].rally = center
        b.actors[i].previous = b.actors[i].state.position
        b.actors[i].gun.locked = b.actors[i].external
        b.actors[i].pilot.skill = clamp(b.actors[i].pilot.skill,0.0,1.0)
        b.actors[i].pilot.nerve = clamp(b.actors[i].pilot.nerve,0.0,1.0)
    b

_event = (b: mut Battle, kind: CombatEventKind, a: Combatant, at: vec3, other: int = -1, part: PartId = .body, strength: f64 = 1.0, direction: vec3 = vec3(0,1,0), outcome: bool = false):
    n = b.next_serial; b.next_serial += 1
    b.events.push(CombatEvent(n,kind,a.craft,a.person,other,at,direction,strength,part))
    if outcome:
        b.outcomes.push(CombatOutcome(n,if a.engagement>=0: a.engagement else: b.engagement,a.craft,a.person,kind,other,at,1.0-a.state.hull_damage,1.0-a.state.engine_damage))

take_combat_outcomes = (b: mut Battle) -> CombatOutcome[]:
    out = b.outcomes; b.outcomes = []; out

# Nearest entry parameter, including a segment starting inside. A miss is >1.
segment_ellipsoid = (a: vec3, z: vec3, center: vec3, half: vec3) -> f64:
    p = (a-center)/half; d = (z-a)/half
    aa = f64(dot(d,d)); bb = f64(dot(p,d)); cc = f64(dot(p,p))-1.0
    if cc <= 0: return 0
    if aa < 1e-12: return 2
    disc = bb*bb-aa*cc
    if disc < 0: return 2
    t = (-bb-sqrt(disc))/aa
    if t >= 0 and t <= 1: t else: 2

# Part-sized solids rather than a single giant sphere around the wing tips.
hit_aircraft = (a: Combatant, from: vec3, to: vec3) -> (f64,PartId):
    inv = quat_inverse(a.state.orientation)
    p0 = quat_rotate(inv,from-a.previous); p1 = quat_rotate(inv,to-a.state.position)
    p = aircraft_profile(a.spec.kind)
    best = 2.0; part = PartId.body
    loop i in 0..7:
        if not a.state.damage.parts[i].attached: continue
        center = a.spec.parts[i].attachment
        half = match PartId(i):
            .body: vec3(max(p.width,0.55),max(p.width,0.65),p.length*0.34)
            .engine: vec3(max(0.6,p.engine_x+0.6),0.65,0.8)
            .left_wing, .right_wing: vec3(p.span*0.24,0.3,p.chord*0.55)
            .left_float, .right_float: vec3(if p.boat: 0.3 else: 0.5,0.4,if p.boat: 1.2 else: p.length*0.35)
            .tail: vec3(p.span*0.15,0.55,p.chord*0.5)
        if i == 2 or i == 3: center = vec3((if i == 2: -1.0 else: 1.0)*p.span*0.26,p.wing_y,-0.65)
        if i==2 or i==3:
            loop level in 0..p.decks:
                at=center+vec3(0,-f64(level)*(if p.decks==3:1.25 else:1.9),0)
                size=half
                if level>0:size.x*=f32(p.lower_span)
                t=segment_ellipsoid(p0,p1,at,size)
                if t<best:best=t;part=PartId(i)
        else if i==1 and p.engine_x>0:
            loop side in [-1.0,1.0]:
                t=segment_ellipsoid(p0,p1,center+vec3(side*p.engine_x,0,0),vec3(0.65,0.65,0.8))
                if t<best:best=t;part=.engine
        else:
            t = segment_ellipsoid(p0,p1,center,half)
            if t < best: best = t; part = PartId(i)
    (best,part)

intercept = (relative: vec3, velocity: vec3, speed: f64) -> vec3:
    aa = f64(dot(velocity,velocity))-speed*speed
    bb = 2.0*f64(dot(relative,velocity)); cc = f64(dot(relative,relative))
    t = sqrt(cc)/max(speed,1.0)
    disc = bb*bb-4.0*aa*cc
    if disc >= 0 and abs(aa) > 0.001:
        x = (-bb-sqrt(disc))/(2.0*aa); y = (-bb+sqrt(disc))/(2.0*aa)
        if x > 0 and y > 0: t = min(x,y)
        else if x > 0: t = x
        else if y > 0: t = y
    t = clamp(t,0.0,3.0)
    relative+velocity*f32(t)+vec3(0,4.905*t*t,0)

_choose_target = (b: Battle, a: Combatant) -> int:
    best = -1; score = 1e20
    f = quat_rotate(a.state.orientation,vec3(0,0,-1))
    loop j in 0..b.actors.len():
        e = b.actors[j]
        if not e.present:continue
        if e.side == a.side or e.status != .flying or e.bailed: continue
        if a.engagement>=0 and e.engagement!=a.engagement: continue
        delta = e.state.position-a.state.position
        distance = f64(length(delta))
        cost = distance*(2.0-f64(dot(f,delta/f32(max(distance,0.01)))))
        if j == a.pilot.target: cost *= 0.7
        if a.pilot.role == .escort:
            loop boat in b.boats:
                if boat.side == a.side and length(e.state.position-boat.position) < 1500: cost *= 0.45
        if cost < score or (cost == score and (best < 0 or e.craft < b.actors[best].craft)): best = j; score = cost
    best

combat_controls = (b: Battle, index: int, e: FlightEnv) -> CombatPilot:
    a = b.actors[index]; p = a.pilot; s = a.state; k = a.spec
    p.brain_tick = b.tick; p.trigger = false
    if p.target < 0 or p.target >= b.actors.len() or b.actors[p.target].status != .flying or not b.actors[p.target].present or b.actors[p.target].side==a.side or (a.engagement>=0 and b.actors[p.target].engagement!=a.engagement) or b.tick-p.target_tick>=60:
        p.target = _choose_target(b,a)
        p.target_tick=b.tick
    pos = s.position; fwd = quat_rotate(s.orientation,vec3(0,0,-1))
    speed = f64(length(s.velocity))
    ground = max(0.0,e.ground(f64(pos.x),f64(pos.z)))
    ahead = pos+s.velocity*3.0
    low = pos.y < ground+90 or ahead.y < max(0.0,e.ground(f64(ahead.x),f64(ahead.z)))+70
    hurt = s.hull_damage > 0.22+0.25*p.nerve or part_health(s.damage,.tail)<0.3 or min(part_health(s.damage,.left_wing),part_health(s.damage,.right_wing))<0.35 or s.engine_damage > 0.65 or a.fire > 0.35 or a.gun.ammo == 0 or s.fuel < k.fuel_capacity*0.04
    fleeing = p.role == .flee or hurt or p.mode == .withdrawing
    want = a.rally-pos; want.y = f32(350.0-f64(pos.y))
    p.mode = .regroup
    if fleeing:
        p.mode = .withdrawing
        away = pos-a.rally; away.y = 0
        if length(away) < 1: away = fwd
        want = normalize(away)*1200.0+vec3(0,clamp(ground+250-f64(pos.y),-120.0,250.0),0)
    else if p.target >= 0:
        target = b.actors[p.target]
        delta = target.state.position-pos; dist = f64(length(delta))
        aim = intercept(delta,target.state.velocity-s.velocity,420.0*b.bullet_scale)
        err = (1.0-p.skill)*min(dist*0.035,25.0)
        want = aim+vec3(sin(f64(b.tick)*0.021+f64(a.craft))*err,cos(f64(b.tick)*0.017+f64(a.craft))*err,0)
        p.mode = .pursuit
        behind = dot(fwd,normalize(delta+vec3(0.0001,0,0))) < -0.25
        threatened = behind and dist < 500 and dot(quat_rotate(target.state.orientation,vec3(0,0,-1)),normalize(-delta)) > 0.75
        if threatened:
            p.mode = .scissors
            turn = if (b.tick/150+a.craft)%2 == 0: -1.0 else: 1.0
            side = quat_rotate(s.orientation,vec3(turn,0,0))
            want = fwd+side*1.4+vec3(0,0.35,0)
        else if dist < 65 and dot(s.velocity-target.state.velocity,delta) > 0:
            p.mode = .breakaway; want = normalize(-delta)+vec3(0,0.8,0)
        else:
            p.trigger = dist < 850.0*b.bullet_scale and dot(fwd,normalize(aim)) > 0.9995-(1.0-p.skill)*0.002
    if not fleeing and p.role==.wingman and (p.target<0 or length(b.actors[p.target].state.position-pos)>900):
        leader = combat_index(b,p.leader)
        if leader >= 0 and b.actors[leader].present and b.actors[leader].status == .flying:
            l = b.actors[leader].state
            want = l.position+quat_rotate(l.orientation,vec3(if a.craft%2==0: -65 else: 65,25,100))-pos
    # Strike pilots prefer boats while escorts engage their attackers.
    if not fleeing and p.role == .strike:
        best = -1; dist = 1e20
        loop j in 0..b.boats.len():
            boat = b.boats[j]
            d = f64(length(boat.position-pos))
            if boat.side != a.side and not boat.disabled and d < dist: best = j; dist = d
        p.boat = best
        if best >= 0:
            boat = b.boats[best]; delta = boat.position+vec3(0,2,0)-pos
            aim = intercept(delta,boat.velocity-s.velocity,420.0*b.bullet_scale)
            p.mode = .strafe; want = aim
            if dist > 1100: want.y = f32(250.0-f64(pos.y))
            if dist < 240 or (dist < 550 and dot(fwd,delta) < 0): p.mode = .breakaway; want = fwd+vec3(0,0.8,0)
            p.trigger = p.mode == .strafe and dist < 1100 and dot(fwd,normalize(aim)) > 0.997
    if low and not (p.mode == .strafe and pos.y > ground+75):
        want = vec3(fwd.x,0.9,fwd.z); p.trigger = false; p.mode = .evade
    # Local separation sampled only on brain ticks; no all-pairs scan per physics substep.
    avoid = vec3(0,0,0)
    loop other in b.actors:
        if other.craft == a.craft or other.status != .flying: continue
        gap = pos-other.state.position
        if dot(gap,gap) > 160000: continue
        dv = s.velocity-other.state.velocity
        tt = clamp(-f64(dot(gap,dv))/max(f64(dot(dv,dv)),0.01),0.0,1.5)
        miss = gap+dv*f32(tt)
        reach = (k.span+other.spec.span)*0.5+18.0
        if length(miss) < reach: avoid += normalize(miss+vec3(0,if a.craft>other.craft: 2 else: -2,0))*0.7
    if length(want) < 0.001: want = fwd
    p.controls = steer(k,s,normalize(want)+avoid)
    p.controls.throttle = 1.0
    p.controls.pitch *= 0.65+0.35*p.skill
    if speed < k.stall_speed*pure_k(k)*1.25: p.controls.pitch = min(p.controls.pitch,0.15)
    if p.mode == .pursuit and p.target >= 0:
        other = b.actors[p.target].state
        if length(other.position-pos) < 180 and speed > length(other.velocity)+8:
            p.controls.throttle = 0.4; p.controls.airbrake = 0.5
    p

bail_combatant = (b: mut Battle, i: int) -> bool:
    if i < 0 or i >= b.actors.len() or b.actors[i].bailed or b.actors[i].state.moored: return false
    a = b.actors[i]; p = aircraft_profile(a.spec.kind)
    seat = vec3(0,p.width+0.4,p.cockpit_z)
    b.descents.push(leave_aircraft(a.person,a.craft,a.state.position,a.state.orientation,a.state.velocity,seat))
    a.bailed = true; a.external = false; a.status = .disabled; a.gun.locked = true; a.pilot.trigger = false
    b.actors[i] = a
    _event(b,.bailed,a,a.state.position,a.last_attacker,outcome=true)
    true

apply_bullet_hit = (b: mut Battle, i: int, part: PartId, point: vec3, direction: vec3, amount: f64, attacker: int):
    a = b.actors[i]; id = int(part)
    if not a.state.damage.parts[id].attached: return
    # Small rounds punch fabric/wood; heavy structure takes several bursts, not one touch.
    scale = sqrt(1400.0/a.spec.mass)
    a.state.damage.parts[id].health = max(0.0,a.state.damage.parts[id].health-amount*scale)
    a.last_attacker = attacker
    shooter=combat_index(b,attacker)
    if a.external and not a.human and a.status==.flying:
        a.external=false; a.gun.locked=false
        if a.engagement<0:
            a.engagement=1000000+min(a.craft,attacker)
            a.rally=a.state.position
        a.pilot.target=shooter
    if shooter>=0 and b.actors[shooter].engagement<0 and a.engagement>=0:
        b.actors[shooter].engagement=a.engagement
        b.actors[shooter].rally=a.rally
    local = quat_rotate(quat_inverse(a.state.orientation),point-a.state.position)
    normal = -quat_rotate(quat_inverse(a.state.orientation),normalize(direction))
    if a.marks.len() >= 24: a.marks.remove_at(0)
    a.marks.push(HitMark(local,normal,part))
    if a.state.damage.parts[id].health <= 0:
        detach_part(a.state.damage,a.spec.parts,part,a.spec.mass,a.state.position,a.state.orientation,a.state.velocity,a.state.angular_velocity)
        _event(b,.separated,a,point,attacker,part)
    if part == .engine and a.state.damage.parts[id].health < 0.55 and a.fire == 0:
        a.fire = 0.3
        _event(b,.ignition,a,point,attacker,part)
    refresh_damage(a.spec,a.state)
    b.actors[i] = a
    _event(b,.hit,a,point,attacker,part,amount,direction)

_fire_round = (b: mut Battle, i: int):
    a = b.actors[i]; gun = gun_spec(a.spec.kind)
    a.gun.cool = max(0.0,a.gun.cool-COMBAT_DT); a.gun.heat = max(0.0,a.gun.heat-COMBAT_DT*0.18)
    if a.gun.heat >= 1: a.gun.jammed = true
    if a.gun.heat < 0.35: a.gun.jammed = false
    if a.status == .flying and not a.bailed and a.pilot.trigger and not a.gun.locked and not a.gun.jammed and a.gun.ammo > 0 and a.gun.cool <= 0 and b.rounds.len() < COMBAT_MAX_ROUNDS:
        mounts = gun_mounts(a.spec.kind); local = mounts[a.gun.shots%mounts.len()]
        at = a.state.position+quat_rotate(a.state.orientation,local)
        jitter = vec3(combat_noise(b.seed,a.craft,a.gun.shots,0),combat_noise(b.seed,a.craft,a.gun.shots,1),0)*f32(gun.spread)
        # Convergence is physical: no target seeking or bending after the round is fired.
        dir = quat_rotate(a.state.orientation,normalize(vec3(0,0,-450)-local+jitter*450.0))
        b.rounds.push(Round(at,a.state.velocity+dir*f32(420.0*b.bullet_scale),a.craft,a.side,gun.damage,tracer=a.gun.shots%3==0))
        a.gun.shots += 1; a.gun.ammo -= 1; a.gun.heat += 0.035; a.gun.cool = 1.0/gun.rate
        _event(b,.shot,a,at,direction=dir,strength=f64(gun.voice))
    b.actors[i] = a

_step_rounds = (b: mut Battle, e: FlightEnv):
    n = 0
    loop n < b.rounds.len():
        r = b.rounds[n]; r.age += COMBAT_DT
        r.velocity.y -= f32(9.81*COMBAT_DT)
        end = r.position+r.velocity*f32(COMBAT_DT)
        best = 2.0; victim = -1; boat_id = -1; part = PartId.body
        loop i in 0..b.actors.len():
            a = b.actors[i]
            if not a.present:continue
            if a.craft == r.owner or a.side == r.side or a.status == .escaped: continue
            b.pair_tests += 1
            mid = (r.position+end)*0.5-a.state.position
            radius = a.spec.span+f64(length(end-r.position))*0.5+f64(length(a.state.position-a.previous))
            if dot(mid,mid) > radius*radius: continue
            b.narrow_tests += 1
            at,id = hit_aircraft(a,r.position,end)
            if at < best or (at == best and victim >= 0 and a.craft < b.actors[victim].craft): best=at; victim=i; part=id
        loop j in 0..b.boats.len():
            boat = b.boats[j]
            if boat.side == r.side or boat.disabled: continue
            c = cos(boat.yaw); sn = sin(boat.yaw)
            local = (p: vec3) -> vec3:
                d = p-boat.position
                vec3(f32(f64(d.x)*c-f64(d.z)*sn),d.y,f32(f64(d.x)*sn+f64(d.z)*c))
            at = segment_ellipsoid(local(r.position),local(end),vec3(0,0,0),boat.half)
            if at < best: best=at; victim=-1; boat_id=j
        # Swept terrain/sea sampling prevents a fast round passing through an intervening ridge.
        surface = 2.0
        loop j in 0..9:
            at = f64(j)/8.0; p = lerp(r.position,end,f32(at))
            if p.y <= max(0.0,e.ground(f64(p.x),f64(p.z))): surface=at; break
        if surface <= best:
            if surface <= 1:
                owner = combat_index(b,r.owner)
                if owner >= 0: _event(b,.splash,b.actors[owner],lerp(r.position,end,f32(surface)),strength=0.2)
        else if victim >= 0:
            apply_bullet_hit(b,victim,part,lerp(r.position,end,f32(best)),r.velocity,r.damage,r.owner)
        else if boat_id >= 0:
            b.boats[boat_id].health = max(0.0,b.boats[boat_id].health-r.damage*0.45)
            b.boats[boat_id].attacker = r.owner
            if b.boats[boat_id].health == 0:
                b.boats[boat_id].disabled = true
                owner = combat_index(b,r.owner)
                if owner >= 0:
                    _event(b,.boat_disabled,b.actors[owner],b.boats[boat_id].position,b.boats[boat_id].id,outcome=true)
                    b.outcomes[b.outcomes.len()-1].boat=b.boats[boat_id].id
                    b.outcomes[b.outcomes.len()-1].attacker=r.owner
        if best <= 1 or surface <= 1 or r.age > 2.5: b.rounds.remove_at(n)
        else: r.position=end; b.rounds[n]=r; n+=1

# Observer changes only simulation detail, never faction/intent. Fixed inputs + the same LOD
# schedule are deterministic. Near bodies use full 120 Hz flight/contact physics; far bodies
# above terrain use the same air equations once per tick, avoiding per-contact terrain reads.
step_battle = (b: mut Battle, e: FlightEnv, observer: vec3):
    if not b.enabled: return
    b.events.clear(); b.pair_tests=0; b.narrow_tests=0; b.brain_steps=0; b.physics_steps=0
    b.tick += 1
    loop i in 0..b.actors.len():
        a = b.actors[i]
        if not a.external: a.previous = a.state.position
        if a.status == .escaped or not a.present: b.actors[i]=a; continue
        distance = length(a.state.position-observer)
        a.lod = if distance > 2800: 2 else: if distance > 1200: 1 else: 0
        period = if a.lod==2: 30 else: if a.lod==1: 15 else: 6
        b.actors[i]=a
        if not a.external and a.status == .flying and (a.pilot.brain_tick<0 or (b.tick+a.craft)%period==0):
            a.pilot=combat_controls(b,i,e); b.brain_steps+=1
        if a.status == .disabled or a.bailed:
            a.pilot.controls=Controls(throttle=0,assist=0,roll=0.15)
            a.pilot.trigger=false
        if not a.external:
            # Far clear air uses one flight integration; close/contact/wreck paths keep full step.
            high = a.state.position.y > max(0.0,e.ground(f64(a.state.position.x),f64(a.state.position.z)))+140
            if a.lod > 0 and high and not a.state.crashed:
                step_distant(a.spec,a.state,a.pilot.controls,e)
            else: step(a.spec,a.state,a.pilot.controls,e,COMBAT_DT)
            b.physics_steps+=1
        a.prop += COMBAT_DT*(8.0+70.0*a.state.throttle)
        if a.fire > 0:
            a.fire_age += COMBAT_DT
            if a.state.on_water: a.fire=max(0.0,a.fire-COMBAT_DT*0.6)
            else:
                a.fire=min(1.0,a.fire+COMBAT_DT*0.04)
                a.state.damage.parts[1].health=max(0.0,a.state.damage.parts[1].health-COMBAT_DT*a.fire*0.035)
                a.state.damage.parts[0].health=max(0.0,a.state.damage.parts[0].health-COMBAT_DT*a.fire*0.012)
                loop part in [PartId.engine,PartId.body]:
                    if a.state.damage.parts[int(part)].health<=0 and a.state.damage.parts[int(part)].attached:
                        detach_part(a.state.damage,a.spec.parts,part,a.spec.mass,a.state.position,a.state.orientation,a.state.velocity,a.state.angular_velocity)
                        _event(b,.separated,a,a.state.position,part=part)
                refresh_damage(a.spec,a.state)
        hopeless = a.state.crashed or a.state.engine_damage > 0.95 or a.fire_age > 8.0+12.0*a.pilot.nerve
        if hopeless and not a.down_reported:
            a.status=.disabled; a.down_reported=true
            _event(b,.downed,a,a.state.position,a.last_attacker,outcome=true)
        if a.status==.disabled and a.state.position.y < 15 and (a.state.on_water or a.state.beached): a.status=.wreck
        if a.status==.wreck: a.wreck_age+=COMBAT_DT
        if not a.last_wet and a.state.on_water and a.status != .flying: _event(b,.splash,a,a.state.position,strength=1.0)
        a.last_wet=a.state.on_water
        if a.pilot.mode==.withdrawing and length(a.state.position-a.rally)>b.retreat_radius and a.status==.flying:
            a.status=.escaped; a.external=true; _event(b,.fled,a,a.state.position,a.last_attacker,outcome=true)
        b.actors[i]=a
        if hopeless and not a.external and not a.bailed: bail_combatant(b,i)
        _fire_round(b,i)
    loop mut boat in b.boats:
        if not boat.disabled and not boat.external: boat.position+=boat.velocity*f32(COMBAT_DT)
    _step_rounds(b,e)
    loop i in 0..b.descents.len():
        d=b.descents[i]; step_descent(d,e.wind,e.ground,0.0,COMBAT_DT,d.steering,d.open_requested)
        b.descents[i]=d
        if d.landed_event:
            a=combat_index(b,d.craft)
            if a>=0:
                _event(b,.landed,b.actors[a],d.position,b.actors[a].last_attacker,outcome=true)
                last=b.outcomes.len()-1
                b.outcomes[last].injury=d.injury; b.outcomes[last].at_sea=d.phase==.swimming
    side=-1; contested=false
    loop a in b.actors:
        if a.status != .flying: continue
        if side<0: side=a.side
        else if side!=a.side: contested=true
    loop boat in b.boats:
        if boat.disabled:continue
        if side<0:side=boat.side
        else if side!=boat.side:contested=true
    b.finished=not contested
