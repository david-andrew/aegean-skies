# The title screen's backdrop: a slow, unordered sequence of shots of the live world behind the
# menu, each 15-30 seconds, each with its own hour and fair weather:
#   low   low over the open sea at the top speed (about 450 km/h), the speed flecks streaming
#         past, seen from where flight's chase camera sees them (13-16 m up: lower, the flecks
#         grow large and sparse on the screen); flying free, chasing a Gull below and ahead,
#         overtaken by one, or a race: two Falcos come from behind, overtake jockeying, bank hard
#         round a race pylon and peel off while the camera carries straight on
#   high  far above the clouds, drifting slowly towards the sun as it goes down
#   city  a big town (Porto Vecchio, Kalyrassa, Neravessa) and its waterfront life: a low oblique
#         run along the harbour front from just offshore, the town rising behind; a high, slow
#         arc at golden hour, the roofs a texture; or, in the canal city, along the canals
# A shot is a pure function of its age: the camera, its up (for the gentle banks), its velocity
# (the sea's flecks smear with it) and, in a low shot, where the paced aircraft is.
# Its own random stream: the game's is never drawn on.

use 'flight.jo'
use 'air_pilot.jo'

enum TitleShotKind: low, high, city

struct TitleRng:
    s: u64 = u64(0x2545F4914F6CDD1D)

_title_next = (r: mut TitleRng) -> f64:
    r.s = r.s xor (r.s << u64(13))
    r.s = r.s xor (r.s >> u64(7))
    r.s = r.s xor (r.s << u64(17))
    f64(r.s >> u64(11)) / 9007199254740992.0

_title_range = (r: mut TitleRng, a: f64, b: f64) -> f64: a + (b - a) * _title_next(r)

# a big town to fly over
struct TitleSite:
    name: str
    center: vec3
    radius: f64
    out: vec2                       # the way out to sea from its harbour
    route: vec3[]                   # (the canal city: its canals, to follow)

struct TitleShot:
    kind: TitleShotKind = .low
    origin: vec3                    # where it begins (a city shot: the town's centre)
    heading = 0.0                   # (radians: 0 north (-z), PI/2 east)
    speed = 125.0                   # metres a second
    height = 6.0                    # over the water (a city shot: over the roofs' ground)
    length = 20.0                   # seconds
    hour = 9.5                      # the light's hour as it begins
    hour_rate = 0.0                 # (hours a second: the sun going down)
    weather = 0                     # (WEATHER_LABELS: Fair, Towers, Meltemi or Calm, never rain)
    turn = 0.0                      # (the most the heading turns, radians a second: gentle banks)
    sway = 0.1                      # (how fast the turn comes and goes)
    phase = 0.0
    pitch = -0.07                   # (the camera looks this far below the way it goes)
    glance = 0.0                    # (and this far to the side of it: along a waterfront, at the town)
    pace = -1                       # low: -1 flying free, 0 an aircraft ahead to chase, 1 one overtaking, 2 a race; high: 3 a plane into the sunset, 4 the strait's merge
    side = 1.0                      # (the paced aircraft's side, and a city pass's offset)
    site = ""                       # (a city shot: the town)
    style = 0                       # (0 a line, turning gently; 1 an arc about `origin`; 2 along `route`)
    radius = 0.0                    # (an arc's)
    route: vec3[]
    start = 0.0                     # (how far along the route it begins, metres; the merge: seconds after the strait opens)
    race: TitleRaceTrack[]          # (a race: each racer's flight, once flown: title_fly_race)
    rounds: TitleRound[]            # (the merge: the rounds in the air every 1/60 s, from round_from[k] to round_from[k + 1])
    round_from: int[]
    round_scale = 5.0               # (the battle's bullet speed, for the tracers' length)
    shots: vec4[]                   # (and each gun fired: where, and when in the shot (w))
    shot_by: int[]                  # (which aircraft fired it, and the muzzle's offset from it then, for the flash)
    shot_off: vec3[]

# a round in the air, as the battle flew it
struct TitleRound:
    at: vec3
    velocity: vec3
    age = 0.0

struct TitleView:
    eye: vec3
    dir: vec3
    up: vec3
    velocity: vec3
    height = 0.0                    # (the camera's height over the sea, for the flecks)
    hour = 9.5
    paced = false                   # (an aircraft in the shot, and where)
    pace_at: vec3
    pace_turn: vec4
    pace_speed = 0.0
    racers: TitleRacer[]            # (a race: the two racers, and the pylon they round)
    pylon = false
    pylon_at: vec3
    rounds: TitleRound[]            # (the merge's tracers)

# one racer in a race shot, as drawn and heard this frame
struct TitleRacer:
    at: vec3
    turn: vec4
    velocity: vec3
    throttle = 1.0
    model = 3                       # (craft_models: the Falco in its two liveries, 3 and 10)
    kind = 3                        # (Craft: the Falco)

const TITLE_G = 9.81

_title_dir = (h: f64) -> vec3: vec3(f32(sin(h)), 0, f32(-cos(h)))

# the heading's turn rate at time s (gentle banks that come and go)
_title_turn = (shot: TitleShot, s: f64) -> f64: shot.turn * sin(shot.phase + s * shot.sway)

# where the path is, and its heading, after `age` seconds (integrated in small steps)
_title_path = (shot: TitleShot, age: f64) -> (vec3, f64):
    at = shot.origin
    h = shot.heading
    steps = max(1, int(age / 0.05))
    dt = age / f64(steps)
    loop k in 0..steps:
        s = f64(k) * dt
        mid = h + _title_turn(shot, s) * dt * 0.5
        at = at + _title_dir(mid) * f32(shot.speed * dt)
        h += _title_turn(shot, s) * dt
    (at, h)

# the camera's bank: less than a coordinated turn would want, and never past 7 degrees
_title_bank = (shot: TitleShot, s: f64) -> f64: clamp(0.45 * atan(shot.speed * _title_turn(shot, s) / TITLE_G), -0.12, 0.12)

# a point `d` metres along a route (clamped to its ends)
_title_along = (route: vec3[], d: f64) -> vec3:
    left = max(0.0, d)
    loop k in 0..route.len() - 1:
        seg = f64(length(route[k + 1] - route[k]))
        if left <= seg or k == route.len() - 2: return route[k] + (route[k + 1] - route[k]) * f32(clamp(left / max(seg, 0.001), 0.0, 1.0))
        left -= seg
    route[route.len() - 1]

_title_route_length = (route: vec3[]) -> f64: [loop k in 0..route.len() - 1: f64(length(route[k + 1] - route[k]))].sum()

# where the camera is and which way the path goes, by the shot's style
_title_place = (shot: TitleShot, age: f64) -> (vec3, f64):
    if shot.style == 1:
        a = shot.phase + shot.side * shot.speed / max(shot.radius, 1.0) * age
        at = shot.origin + vec3(f32(sin(a) * shot.radius), 0, f32(cos(a) * shot.radius))
        # (the tangent: along the arc, the way it turns)
        t = vec3(f32(cos(a)), 0, f32(-sin(a))) * f32(shot.side)
        return (at, atan2(f64(t.x), -f64(t.z)))
    if shot.style == 2 and shot.route.len() > 1:
        d = shot.start + shot.speed * age
        ahead = _title_along(shot.route, d + 70.0) - _title_along(shot.route, d - 40.0)
        return (_title_along(shot.route, d), atan2(f64(ahead.x), -f64(ahead.z)))
    _title_path(shot, age)

# The race (a low pass's pace 2), flown by the game's own flight model: the camera flies straight
# along its line `a` (to its right `b`) at 125 m/s; two Falcos start just behind it in lanes to its
# right, clear of the menu, and the NPC pilots' controller (air_waypoint_controls) holds each lane,
# its height and 135 m/s, give or take the few m/s that are their jockeying, so they overtake. As
# each reaches the pylon it asks the shared steering law (steer) for 24 degrees left, round the
# pylon on its left, and the model rolls, pulls and climbs as it does for any aircraft; there the
# controller lines them up on the next leg, 20 degrees left of the camera's line, at 185 m/s:
# they cross ahead of the camera from the right, a real change of course. Flown once when the shot is cut, a fixed 1/60 s a
# step from a settled start, and kept: the shot is repeatable, and the view a function of its age.
const RACE_CAMERA = 125.0
# The sunset plane (a high shot's pace 3): a Gull flying calm and level into the sun, some way
# ahead of the camera and a little above it, drawing slowly away; the camera keeps its course.
const SUNSET_SPEED = 200.0          # (the Gull's own steady pace at the game's speed scale, a little under its cruise)
const SUNSET_CAMERA = 197.0         # (the camera a little slower: the plane draws slowly away)
const SUNSET_HEIGHT = 1400.0        # (under the clouds: above about 1600 m the flight model's air thins, no engine holds its speed)
const SUNSET_AHEAD = 95.0           # (beyond the chase camera's distance)
const SUNSET_ABOVE = 4.0
const SUNSET_MODEL = 0
const RACE_SPEED = 135.0
const RACE_OUT_SPEED = 185.0
const RACE_PEEL = -0.42             # (the hard turn round the pylon asks for 24 degrees left: it settles near 20)
const RACE_LEG = -0.35              # (then the next leg, 20 degrees left of the camera's line: they pull
                                    # ahead faster than they draw aside, and stay in sight as they shrink)
const RACE_PYLON_SIDE = 16.0        # (on the racers' left: they round it to the left, across ahead of the camera)
const RACE_PYLON_AT = 1075.0        # (along the line from where the shot began: about 60 m ahead of the camera as the first racer reaches it)
const RACE_TURN_LEAD = 5.0          # (each begins its turn as the pylon comes abeam)
const RACE_SETTLE = 3.0             # (seconds flown before the shot, so the trim has settled)
RACE_START = [-40.0, -52.0]         # (how far behind the camera each is as the shot begins)
RACE_LANE = [26.0, 32.0]            # (and how far right of its line: in the frame's right part, clear of the menu)

struct TitleRaceTrack:
    model = 3                       # (craft_models: which aircraft draws it)
    kind = 3                        # (Craft: which aircraft it sounds as)
    at: vec3[]                      # every 1/60 s from the shot's start
    turn: vec4[]
    velocity: vec3[]
    throttle: f64[]

# Fly both racers through the shot with `spec` (the Falco's, at the game's speed scale).
# A shot's own aircraft, flown by the flight model a slice at a time (title_flight_step, in the
# frames of the shot before it), then kept: the race's two Falcos, or the plane flying on into
# the sunset. One aircraft after the other, each from a settled start, a fixed 1/60 s a step.
struct TitleFlying:
    i = 0                           # (the aircraft being flown)
    k = 0                           # (its step)
    st: CraftState = CraftState()
    turned = false
    rounded = false
    done = false

# how many aircraft the shot flies
title_flight_count = (shot: TitleShot) -> int: if shot.kind == .low and shot.pace == 2: 2 else: if shot.kind == .high and shot.pace == 3: 1 else: 0

# where aircraft i starts, a settled moment before the shot begins
_title_flight_start = (shot: TitleShot, i: int, spec: CraftSpec) -> CraftState:
    f0 = _title_dir(shot.heading)
    r0 = vec3(-f0.z, 0, f0.x)
    if shot.kind == .high:
        at = shot.origin + f0 * f32(SUNSET_AHEAD - SUNSET_SPEED * RACE_SETTLE) + vec3(0, f32(shot.height + SUNSET_ABOVE), 0)
        return CraftState(position = at, velocity = f0 * f32(SUNSET_SPEED), orientation = quat_euler(0, -shot.heading, 0), fuel = spec.fuel_capacity, throttle = 0.5)
    up = shot.height - 5.0 + (if i == 1: 0.8 else: 0.0)
    a0 = RACE_START[i] - RACE_SPEED * RACE_SETTLE
    CraftState(position = shot.origin + f0 * f32(a0) + r0 * f32(RACE_LANE[i]) + vec3(0, f32(up), 0), velocity = f0 * f32(RACE_SPEED), orientation = quat_euler(0, -shot.heading, 0), fuel = spec.fuel_capacity, throttle = 0.2)

# One step of aircraft i: the controls its pilot gives now
_title_pilot = (shot: TitleShot, f: mut TitleFlying, spec: CraftSpec, env: FlightEnv, age: f64) -> Controls:
    i = f.i
    st = f.st
    f0 = _title_dir(shot.heading)
    r0 = vec3(-f0.z, 0, f0.x)
    if shot.kind == .high:
        # (calm, level, on into the sun at a steady pace)
        return air_waypoint_controls(spec, st, env, st.position + f0 * 3000.0, shot.height + SUNSET_ABOVE, SUNSET_SPEED)
    up = shot.height - 5.0 + (if i == 1: 0.8 else: 0.0)
    place = (a: f64, b: f64, h: f64) -> vec3: shot.origin + f0 * f32(a) + r0 * f32(b) + vec3(0, f32(h), 0)
    along = f64(dot(st.position - shot.origin, f0))
    if along >= RACE_PYLON_AT - RACE_TURN_LEAD: f.turned = true
    if not f.turned:
        # (the lane, a little drift in it, and the pace: one edges ahead, the other closes)
        lane = RACE_LANE[i] + 2.0 * sin(age * 0.4 + f64(i) * 1.3 + shot.phase)
        pace = RACE_SPEED + 3.0 * sin(age * 0.5 + f64(i) * 2.4 + shot.phase)
        return air_waypoint_controls(spec, st, env, place(along + 2500.0, lane, up), up, pace)
    err = angle_delta(shot.heading + RACE_PEEL, heading(st))
    if abs(err) < 0.08: f.rounded = true
    leg = heading_vector(shot.heading + RACE_LEG)
    # (the next leg a little higher: the controller's settle after the pull has room above the sea)
    leg_up = up + 6.0
    if f.rounded: return air_waypoint_controls(spec, st, env, st.position + leg * 2500.0, leg_up, RACE_OUT_SPEED)
    hold = air_waypoint_controls(spec, st, env, st.position + leg * 2500.0, leg_up, RACE_OUT_SPEED)
    hold_up = clamp((up - f64(st.position.y)) * 0.03, -0.2, 0.2)
    c = steer(spec, st, normalize(heading_vector(heading(st) + clamp(err, -1.0, 1.0)) + vec3(0, f32(hold_up), 0)))
    c.throttle = hold.throttle
    c

# Fly on until `until` (time()); true once every aircraft of the shot is flown.
title_flight_step = (shot: mut TitleShot, f: mut TitleFlying, spec: CraftSpec, until: f64) -> bool:
    count = title_flight_count(shot)
    if f.done or count == 0: f.done = true; return true
    env = FlightEnv()
    dt = 1.0 / 60.0
    steps = int((RACE_SETTLE + shot.length + 1.0) * 60.0)
    loop f.i < count:
        if f.k == 0:
            f.st = _title_flight_start(shot, f.i, spec); f.turned = false; f.rounded = false
            shot.race.push(if shot.kind == .high: TitleRaceTrack(model = SUNSET_MODEL, kind = 0) else: TitleRaceTrack(model = if f.i == 0: 3 else: 10))
        loop f.k < steps:
            age = f64(f.k) * dt - RACE_SETTLE
            c = _title_pilot(shot, f, spec, env, age)
            step(spec, f.st, c, env, dt)
            if age >= 0.0:
                t = shot.race.len() - 1
                shot.race[t].at.push(f.st.position); shot.race[t].turn.push(f.st.orientation); shot.race[t].velocity.push(f.st.velocity); shot.race[t].throttle.push(f.st.throttle)
            f.k += 1
            if f.k % 60 == 0 and time() > until: return false
        f.i += 1; f.k = 0
    f.done = true
    true

# Fly all of a shot's aircraft at once (tests, tools).
title_fly_race = (shot: mut TitleShot, spec: CraftSpec):
    shot.race = []
    f = TitleFlying()
    _ = title_flight_step(shot, f, spec, 1e30)

title_view = (shot: TitleShot, age: f64, ground: (f64, f64) -> f64) -> TitleView:
    p = _title_place(shot, age)
    h = p.1
    fwd = _title_dir(h)
    right = vec3(-fwd.z, 0, fwd.x)
    bank = _title_bank(shot, age)
    eye = p.0
    v = TitleView(hour = shot.hour + shot.hour_rate * age)
    match shot.kind:
        .low:
            # (a little rise and fall over the swell, and the camera banking with the turn)
            eye.y = f32(shot.height + 0.6 * sin(age * 0.7 + shot.phase))
        .high:
            eye.y = f32(shot.height + (if shot.pace == 4: 0.4 * sin(age * 0.8) else: (if shot.pace == 3: 2.0 else: 20.0) * sin(age * 0.05)))
        _:
            # (over the town: high enough over the ground about and ahead, never skimming a hill)
            top = 0.0
            loop k in 0..7:
                q = eye + fwd * f32(f64(k) * 60.0 - 60.0)
                top = max(top, ground(f64(q.x), f64(q.z)))
            eye.y = f32(max(shot.height, top + (if shot.style == 1: 140.0 else: shot.height * 0.7)))
    look = _title_dir(h + shot.glance) * f32(cos(shot.pitch)) + vec3(0, f32(sin(shot.pitch)), 0)
    if shot.style == 1:
        # (an arc looks across at the town, a little past its middle, never straight down)
        aim = shot.origin + vec3(0, 25, 0) + fwd * f32(shot.radius * 0.18) - eye
        look = normalize(aim)
        if f64(look.y) < -0.42:
            flat = normalize(vec3(look.x, 0, look.z))
            look = vec3(flat.x * 0.907, -0.42, flat.z * 0.907)
    v.eye = eye
    v.dir = normalize(look)
    v.up = normalize(vec3(0, f32(cos(bank)), 0) - right * f32(sin(bank)))
    v.velocity = fwd * f32(shot.speed)
    v.height = max(0.0, f64(eye.y) - max(ground(f64(eye.x), f64(eye.z)), 0.0))
    if shot.kind == .low and shot.pace >= 0:
        # chase: just ahead and a little to the side, holding station; overtake: from abeam
        # to well ahead over the shot, a little faster
        lead = if shot.pace == 0: 34.0 + 6.0 * sin(age * 0.4 + shot.phase) else: -18.0 + age * 5.5
        q = _title_path(shot, max(0.0, age + lead / shot.speed))
        qh = q.1
        qf = _title_dir(qh)
        qr = vec3(-qf.z, 0, qf.x)
        off = shot.side * (if shot.pace == 0: 5.0 else: 11.0)
        v.paced = true
        v.pace_at = q.0 + qr * f32(off) + vec3(0, f32(shot.height - (if shot.pace == 0: 5.0 else: 4.0) + 0.5 * sin(age * 0.9)), 0)
        v.pace_at.y = f32(max(f64(v.pace_at.y), 3.5))
        v.pace_turn = quat_euler(0.02, -qh, -_title_bank(shot, age + lead / shot.speed))
        v.pace_speed = shot.speed + (if shot.pace == 1: 5.5 else: 0.0)
    if shot.kind == .low and shot.pace == 2:
        # (the camera flies straight: its line is the shot's heading from its origin)
        f0 = _title_dir(shot.heading)
        r0 = vec3(-f0.z, 0, f0.x)
        v.paced = false
        v.pylon = true
        v.pylon_at = shot.origin + f0 * f32(RACE_PYLON_AT) + r0 * f32(RACE_PYLON_SIDE)
    if shot.round_from.len() > 1:
        x = clamp(age * 60.0, 0.0, f64(shot.round_from.len() - 2) - 0.001)
        k = int(x)
        u = x - f64(k)
        loop n in shot.round_from[k]..shot.round_from[k + 1]:
            o = shot.rounds[n]
            v.rounds.push(TitleRound(at = o.at + o.velocity * f32(u / 60.0), velocity = o.velocity, age = o.age + u / 60.0))
    if shot.race.len() > 0:
        loop i in 0..shot.race.len():
            track = shot.race[i]
            if track.at.len() < 2: continue
            x = clamp(age * 60.0, 0.0, f64(track.at.len() - 1) - 0.001)
            k = int(x)
            u = f32(x - f64(k))
            turn = normalize(mix(track.turn[k], if dot(track.turn[k], track.turn[k + 1]) < 0.0: -track.turn[k + 1] else: track.turn[k + 1], u))
            v.racers.push(TitleRacer(at = mix(track.at[k], track.at[k + 1], u), turn = turn, velocity = mix(track.velocity[k], track.velocity[k + 1], u),
                throttle = track.throttle[k], model = track.model, kind = track.kind))
    v

# which aircraft a low pass has: free a third of the time; otherwise a Gull to chase, one
# overtaking, or a race round a pylon
_title_pick_pace = (x: f64) -> int: if x < 0.32: -1 else: if x < 0.52: 0 else: if x < 0.74: 1 else: 2

# open water under the whole of a low shot, and a margin to each side (and, in a race, under the
# pylon and the racers' way out)
_title_open = (shot: TitleShot, ground: (f64, f64) -> f64) -> bool:
    if shot.pace == 2:
        loop k in 0..12:
            v = title_view(shot, f64(k) * shot.length / 11.0, ground)
            if ground(f64(v.pylon_at.x), f64(v.pylon_at.z)) > -4.0: return false
            loop racer in v.racers:
                if ground(f64(racer.at.x), f64(racer.at.z)) > -4.0: return false
    s = 0.0
    loop s <= shot.length + 1.0:
        p = _title_path(shot, s)
        f = _title_dir(p.1)
        r = vec3(-f.z, 0, f.x)
        loop side in [-90.0, 0.0, 90.0]:
            q = p.0 + r * f32(side) + f * f32(60.0)
            if ground(f64(q.x), f64(q.z)) > -4.0: return false
        s += 0.75
    true

# The next shot: never the same kind twice running; a low one over open water found near
# `home` (islands on the horizon), a city one over one of `sites`.
# The strait's merge (a high shot's pace 4): the camera rides inside Kalyra's V as the strait
# battle opens (src/title_battle.jo flies it), a little behind and right of its leader, on the V's
# course and pace, from MERGE_START seconds in; Orenthia's V comes head on, passes through and
# above, and the two break; the shot ends a few seconds into the break, well before anyone is down.
const MERGE_START = 5.0
const MERGE_LENGTH = 14.0
MERGE_SEAT = vec3(10, 4, 160)       # (in the V: between its second pair, the leader and the first pair ahead)

title_next_shot = (r: mut TitleRng, previous: TitleShotKind?, home: vec3, sites: TitleSite[], ground: (f64, f64) -> f64, sun: (f64) -> vec3, force: str = "", battle: vec3? = none) -> TitleShot:
    kinds: TitleShotKind[]
    loop k in [TitleShotKind.low, TitleShotKind.low, TitleShotKind.high, TitleShotKind.city, TitleShotKind.city]:
        if previous == none or k != previous!: kinds.push(k)
    kind = kinds[min(kinds.len() - 1, int(_title_next(r) * f64(kinds.len())))]
    # (captures: "low", "low-free", "low-chase", "low-pass" (with "@<metres>" a height), "high",
    # "city" or "city-<town>" (with ":run" or ":arc"))
    if force.starts_with("low"): kind = .low
    if force.starts_with("high"): kind = .high
    if force.starts_with("city") and sites.len() > 0: kind = .city
    length = _title_range(r, 18.0, 28.0)
    if kind == .low:
        # (bright morning or golden hour; a third of the time an aircraft to chase or one passing)
        golden = _title_next(r) < 0.4
        loop attempt in 0..400:
            a = _title_range(r, 0.0, TAU)
            d = _title_range(r, 1500.0, 14000.0)
            shot = TitleShot(kind = .low, origin = home + vec3(f32(cos(a) * d), 0, f32(sin(a) * d)), heading = _title_range(r, 0.0, TAU),
                speed = 125.0, height = _title_range(r, 13.0, 16.0), length = length, hour = if golden: _title_range(r, 16.6, 17.2) else: _title_range(r, 9.0, 11.5),
                weather = if _title_next(r) < 0.5: 0 else: 7, turn = _title_range(r, 0.01, 0.025), sway = _title_range(r, 0.08, 0.16), phase = _title_range(r, 0.0, TAU),
                pitch = -0.09, pace = _title_pick_pace(_title_next(r)), side = if _title_next(r) < 0.5: -1.0 else: 1.0)
            if attempt > 300: shot.turn = 0.0
            asked = force.split("@")
            if asked[0] == "low-free": shot.pace = -1
            if asked[0] == "low-chase": shot.pace = 0
            if asked[0] == "low-pass": shot.pace = 1
            if asked[0] == "low-race": shot.pace = 2
            # (a race flies its camera straight, past the pylon)
            if shot.pace == 2:
                shot.turn = 0.0
                shot.speed = RACE_CAMERA
                shot.length = min(shot.length, 21.0)
            # (captures: "low-free@2.5" flies at that height)
            if asked.len() > 1: shot.height = to_float(asked[1]) ?? shot.height
            if _title_open(shot, ground): return shot
        return TitleShot(kind = .high, origin = home + vec3(0, 0, 6000), heading = 4.7, speed = 24.0, height = 2900.0, length = length, hour = 17.7, hour_rate = 0.65 / length, weather = 0, turn = 0.0)
    if kind == .high:
        # (above the clouds, heading towards the sun as it sets: the light goes from gold to dusk)
        start = _title_range(r, 17.55, 17.8)
        s = sun(start)
        towards = atan2(f64(s.x), -f64(s.z))
        a = _title_range(r, 0.0, TAU)
        d = _title_range(r, 0.0, 12000.0)
        high = TitleShot(kind = .high, origin = home + vec3(f32(cos(a) * d), 0, f32(sin(a) * d)), heading = towards + _title_range(r, -0.45, 0.45),
            speed = _title_range(r, 18.0, 30.0), height = _title_range(r, 2700.0, 3400.0), length = length, hour = start, hour_rate = _title_range(r, 0.55, 0.75) / length,
            weather = if _title_next(r) < 0.5: 0 else: 1, turn = _title_range(r, 0.003, 0.008), sway = 0.05, phase = _title_range(r, 0.0, TAU), pitch = -0.05)
        # (half of them: a calm plane ahead, flying on into the sun; the camera on a straight course
        # just behind its pace, straight at the sun)
        # (a third of them, where there's a strait: its merge, in the morning)
        x = _title_next(r)
        if let at = battle:
            if (x < 0.34 and force != "high-clear" and force != "high-plane") or force == "high-battle":
                pace = craft_spec(.gull, []).cruise_speed * 0.86
                eye = at + MERGE_SEAT + _title_dir(0.0) * f32(pace * MERGE_START)
                return TitleShot(kind = .high, pace = 4, origin = vec3(eye.x, 0, eye.z), heading = 0.0, speed = pace, height = f64(eye.y), length = MERGE_LENGTH, start = MERGE_START,
                    hour = _title_range(r, 9.4, 11.0), weather = if _title_next(r) < 0.5: 0 else: 1, turn = 0.0, pitch = 0.015)
        if (_title_next(r) < 0.5 and force != "high-clear") or force == "high-plane":
            high.pace = 3; high.turn = 0.0; high.speed = SUNSET_CAMERA; high.heading = towards; high.pitch = -0.02; high.height = SUNSET_HEIGHT + _title_range(r, -100.0, 100.0)
        return high
    # a town and its waterfront: a low run along the harbour front from just offshore (boats, the
    # quay and the seaplanes in frame, the town rising behind), or a high slow arc at golden hour,
    # or in the canal city along its canals; never looking straight down into the streets
    site = sites[min(sites.len() - 1, int(_title_next(r) * f64(sites.len())))]
    style = if site.route.len() > 1: (if _title_next(r) < 0.7: 2 else: 1) else: (if _title_next(r) < 0.6: 0 else: 1)
    loop s in sites:
        if force.starts_with("city-") and s.name.replace(" ", "_").starts_with(force[5..force.len()].split(":")[0]):
            site = s
            style = if site.route.len() > 1: 2 else: 0
    if force.ends_with(":arc"): style = 1
    if force.ends_with(":run"): style = if site.route.len() > 1: 2 else: 0
    inland = atan2(-f64(site.out.x), f64(site.out.y))
    golden = _title_range(r, 16.7, 17.25)
    if style == 1:
        # (from the sea side round towards the town, the light low across the roofs)
        radius = clamp(site.radius * _title_range(r, 1.0, 1.3) + 450.0, 800.0, 1800.0)
        speed = _title_range(r, 22.0, 30.0)
        way = if _title_next(r) < 0.5: 1.0 else: -1.0
        start = atan2(f64(site.out.x), f64(site.out.y)) - way * speed / radius * length * 0.5
        return TitleShot(kind = .city, style = 1, origin = vec3(site.center.x, 0, site.center.z), radius = radius, phase = start, side = way, speed = speed,
            height = _title_range(r, 220.0, 320.0), length = length, hour = golden, weather = 0, site = site.name)
    if style == 2:
        # (along a canal, low over the water, the houses either side)
        total = _title_route_length(site.route)
        speed = _title_range(r, 18.0, 26.0)
        begin = _title_range(r, 0.0, max(0.0, total - speed * length - 50.0))
        return TitleShot(kind = .city, style = 2, route = site.route, start = begin, speed = speed, height = _title_range(r, 32.0, 50.0), length = length,
            hour = if _title_next(r) < 0.5: _title_range(r, 9.2, 10.8) else: golden, weather = if _title_next(r) < 0.6: 8 else: 0, pitch = -0.2, site = site.name,
            origin = _title_along(site.route, begin))
    # (along the harbour front: just far enough out to be over water the whole way)
    speed = _title_range(r, 22.0, 32.0)
    way = if _title_next(r) < 0.5: 1.0 else: -1.0
    heading = inland + way * PI * 0.5 + _title_range(r, -0.12, 0.12)
    out = vec3(site.out.x, 0, site.out.y)
    run = TitleShot(kind = .city, heading = heading, speed = speed, height = _title_range(r, 26.0, 40.0), length = length,
        hour = if _title_next(r) < 0.5: _title_range(r, 9.2, 10.8) else: golden, weather = if _title_next(r) < 0.6: 8 else: 0,
        pitch = -0.1, glance = -way * _title_range(r, 0.55, 0.8), site = site.name)
    offshore = 140.0
    loop offshore < 900.0:
        run.origin = site.center + out * f32(offshore) - _title_dir(heading) * f32(speed * length * 0.5)
        run.origin.y = 0
        wet = true
        loop k in 0..9:
            q = _title_path(run, f64(k) * length / 8.0).0
            if ground(f64(q.x), f64(q.z)) > -2.0: wet = false
        if wet: break
        offshore += 60.0
    run
