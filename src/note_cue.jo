# Musical notes rising from music played in the world (not the radio): every note of every part,
# as written, floating off from whoever plays it like a line of music carried on the air. Each is a
# real note from the source's note feed (src/live_notes.jo): its place on its part's staff from its
# pitch (lines and spaces, ledger lines, a sharp for a black key), its written value (whole to
# sixteenth, dotted or not) from its length against the score's quarter note (src/note_value.jo);
# notes played together (a chord in one hand, a strum) are one chord, heads stacked on one stem.
#
# Each part has its staff (treble, bass, or a grand staff for a piano's two hands), a lane of its
# own above the player. A note rises from the player in an arc and drifts off sideways across the
# view (tilted a little with the wind), at a speed set by the piece so its quickest notes stand
# apart: the newest by the player, the older further along, so a phrase reads left to right as it
# floats away, and new notes never land on old ones. Indoors they keep under the ceiling. Ink by
# day, cream after dark; fainter with distance, about as the music is.
#
# A cue reads a feed's notes and the frame being heard and keeps its own place in them by frame
# (a whole piece, or a street player's phrase about now), so the feed's other readers (the
# musicians' motions) are not disturbed. Pure but for the drawing.

use 'music_synth.jo'
use 'live_notes.jo'
use 'note_value.jo'

struct RisingNote:
    at: vec3                        # where it set off: the player, at its staff's lowest line (world)
    born: f64                       # (the game's clock, seconds)
    pitch: int                      # (the chord's lowest)
    size: f64                       # (from how loudly it was played)
    value: NoteValue                # (written: whole .. sixteenth, dotted or not)
    sway: f64                       # (its bob's phase)
    pitches: int[] = []             # a chord's notes, lowest first (empty: the one note)
    part: int = -1
    step = 0                        # its lowest head: staff steps above the staff's lowest line
    steps: int[] = [0]              # (its heads, steps above the lowest: note_steps)
    sharps: bool[] = []             # (which heads are black keys)
    ledgers: int[] = []             # (the ledger lines its heads need, steps above the staff's lowest line)

# A part's staff: its lines (steps from E4, the treble staff's lowest line: the bass staff's lines
# are -12..-4, the treble's 0..8; a grand staff has both, middle C between on a ledger line), and
# its lane among the source's staves (metres above the player).
struct NoteStaff:
    part: int
    low = 0                         # (its lowest line)
    treble = true
    bass = false
    lane = 0.0

struct NoteCue:
    frame = -1                      # (the frame last followed to)
    rising: RisingNote[]
    shown = 0
    staves: NoteStaff[] = []
    key = -1                        # (the notes the staves and the speed were set for)
    speed = 1.2                     # metres a second the notes drift (set by the piece)
    dir: vec3 = vec3(-1, 0, 0)      # the way they drift (across the view, with the air)
    ceiling = 1e9                   # (indoors: the highest a staff's top may go, world y)
    step_m = 0.06                   # metres a staff step (half a line's spacing)

const NOTE_PATH = 7.5               # metres a note drifts before it is gone
const NOTE_ARC = 1.1                # metres it rises at first, as it sets off
const NOTE_SEP = 0.26               # the gap the piece's quickest notes keep (metres)
const NOTE_LANE_GAP = 0.25          # (between one part's staff and the next above it)
const NOTE_MOST = 220               # (notes in the air at most, the oldest let go first)
const NOTE_HEARD = 140.0            # (metres: beyond this they are not shown, as the music fades)
const CHORD_WINDOW = 0.035          # seconds: notes of a part started this close are played together
const CHORD_REACH = 12              # semitones: a wider gap between neighbours is the other hand
const CHORD_MOST = 5                # (heads drawn on one stem at most)
const E4_STEP = 37                  # (the treble staff's lowest line, E4, in note_staff_step's steps)

# The chord a note is part of: the notes of its part started within CHORD_WINDOW of it (a chord
# struck together, rolled a little, or strummed), as far as one hand reaches from it (no gap of
# more than an octave between neighbours: a left-hand chord stays apart from the tune above it),
# lowest first, at most CHORD_MOST, the note itself always among them. A note alone is its own.
note_chord = (notes: LiveNote[], lead: LiveNote) -> LiveNote[]:
    w = int(CHORD_WINDOW * f64(MUSIC_RATE))
    lo = 0; hi = notes.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if notes[mid].start < lead.start - w: lo = mid + 1
        else: hi = mid
    together: LiveNote[]
    k = lo
    loop k < notes.len() and notes[k].start <= lead.start + w:
        n = notes[k]
        if n.part == lead.part: together.push(n)
        k += 1
    if together.len() <= 1: return [lead]
    together.sort((n: LiveNote): (n.pitch, n.start))
    at = 0
    loop i in 0..together.len():
        if together[i].pitch == lead.pitch and together[i].start == lead.start: at = i
    a = at; b = at
    loop a > 0 and together[a].pitch - together[a - 1].pitch <= CHORD_REACH: a -= 1
    loop b < together.len() - 1 and together[b + 1].pitch - together[b].pitch <= CHORD_REACH: b += 1
    out: LiveNote[]
    seen: int[]
    loop i in a..b + 1:
        # (the same pitch twice, as a roll repeats it: one head)
        if not (together[i].pitch in seen):
            out.push(together[i]); seen.push(together[i].pitch)
    # (too many: those nearest the lead in pitch)
    loop out.len() > CHORD_MOST:
        if abs(out[0].pitch - lead.pitch) > abs(out[out.len() - 1].pitch - lead.pitch): out.remove_at(0)
        else: out.remove_at(out.len() - 1)
    out

# A note of the tune: the part that carries it, or the singer's line.
note_is_tune = (n: LiveNote) -> bool: n.melody or n.part == 14

# The staves for a piece's notes, and the speed its notes drift at: each part's clef from its
# range (a grand staff when it spans both hands, bass when it sits low, else treble), lanes from
# the bottom up (the accompaniment below, the tune on top); the speed so that the quickest tenth
# of the gaps between a part's chords is NOTE_SEP long in the air (within 0.9..3.2 m/s).
note_cue_prepare = (c: mut NoteCue, notes: LiveNote[]):
    key = notes.len() * 7919 + (if notes.len() > 0: notes[0].start + notes[notes.len() - 1].pitch * 31 else: 0)
    if key == c.key: return
    c.key = key
    parts: int[]
    loop n in notes:
        if not (n.part in parts): parts.push(n.part)
    tune_last = (p: int) -> int: if p == 14: 3 else: 0
    staves: NoteStaff[]
    gaps: f64[]
    loop p in parts:
        ps = [loop n in notes: if n.part == p: n.pitch]
        ps.sort()
        lo = ps[0]; hi = ps[ps.len() - 1]; mid = ps[ps.len() / 2]
        grand = hi - lo > 22 and lo < 57 and hi > 64
        st = if grand: NoteStaff(p, -12, true, true) else: if mid < 55: NoteStaff(p, -12, false, true) else: NoteStaff(p, 0, true, false)
        staves.push(st)
        last = -1
        loop n in notes:
            if n.part != p: continue
            if last >= 0 and n.start - last > int(CHORD_WINDOW * f64(MUSIC_RATE)): gaps.push(f64(n.start - last) / f64(MUSIC_RATE))
            if last < 0 or n.start - last > int(CHORD_WINDOW * f64(MUSIC_RATE)): last = n.start
    melody = [loop n in notes: if note_is_tune(n): n.part]
    staves.sort((s: NoteStaff): (if s.part in melody: 1 else: 0, s.part))
    y = 0.0
    loop k in 0..staves.len():
        staves[k].lane = y
        y += _staff_span(staves[k]) * c.step_m + NOTE_LANE_GAP
    c.staves = staves
    gaps.sort()
    quick = if gaps.len() > 0: gaps[gaps.len() / 10] else: 0.25
    c.speed = clamp(NOTE_SEP / max(quick, 0.02), 0.9, 3.2)

# the steps a staff spans (its lowest line to its highest)
_staff_span = (s: NoteStaff) -> f64: if s.treble and s.bass: 20.0 else: 8.0

_staff_of = (c: NoteCue, part: int) -> NoteStaff:
    loop s in c.staves:
        if s.part == part: return s
    NoteStaff(part)

# The chords that began since the last step, each once (when its first note sounds), lowest note
# first: every note of every part, none skipped. A jump (a seek, a new number, the first step)
# finds its place without a burst of old notes. The notes are by start; they may be a whole piece
# or a window about now (a street player's phrase): the cue keeps its place by frame.
note_cue_take = (c: mut NoteCue, notes: LiveNote[], frame: int) -> LiveNote[][]:
    out: LiveNote[][]
    jumped = c.frame < 0 or frame < c.frame or frame - c.frame > MUSIC_RATE / 4
    from = c.frame
    c.frame = frame
    if jumped: return out
    lo = 0; hi = notes.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if notes[mid].start <= from: lo = mid + 1
        else: hi = mid
    k = lo
    loop k < notes.len() and notes[k].start <= frame:
        n = notes[k]
        chord = note_chord(notes, n)
        first = true
        loop m in chord:
            if m.start < n.start or (m.start == n.start and m.pitch < n.pitch): first = false
        if first: out.push(chord)
        k += 1
    out

# A chord (or a note) sets off from `at` (the player's head): placed on its part's staff, its value
# from its longest note against `quarter` (the score's quarter there, seconds; none: a quarter or an
# eighth by its length). `ago`: how long since it sounded (it is placed by its onset, not the frame
# it was seen in, so quick notes keep their true spacing).
note_cue_rise = (c: mut NoteCue, chord: LiveNote[], at: vec3, now: f64, quarter: f64? = none, ago: f64 = 0.0):
    if chord.len() == 0: return
    n = chord[0]
    length = 0.0; loudest = 0.0
    loop m in chord: length = max(length, m.length); loudest = max(loudest, m.velocity)
    value = if let q = quarter: note_value_seconds(length, q) else: NoteValue(if length < 0.3: NOTE_EIGHTH else: NOTE_QUARTER)
    st = _staff_of(c, n.part)
    step = note_staff_step(n.pitch) - E4_STEP - st.low
    pitches = if chord.len() >= 2: [loop m in chord: m.pitch] else: []
    steps = note_steps(pitches)
    ledgers: int[]
    loop s in steps:
        loop l in _ledgers(st, step + s):
            if not (l in ledgers): ledgers.push(l)
    c.shown += 1
    c.rising.push(RisingNote(at, now - max(0.0, ago), n.pitch, 0.85 + 0.3 * clamp(loudest, 0.0, 1.0), value, f64(c.shown) * 2.39, pitches, n.part, step, steps, [loop m in chord: _black[m.pitch % 12]], ledgers))
    if c.rising.len() > NOTE_MOST: c.rising.remove_at(0)

# Which way the notes drift, eased toward the view's left (so a phrase reads left to right as it
# goes), tilted a little into the depth with the wind. `left`: the view's left at the source.
note_cue_steer = (c: mut NoteCue, left: vec3, wind: vec2, wind_speed: f64, dt: f64):
    l = normalize(vec3(left.x, 0, left.z) + vec3(0.0001, 0, 0))
    w = vec3(wind.x, 0, wind.y) * f32(0.4 * clamp(wind_speed / 8.0, 0.0, 1.0))
    want = normalize(l + w - l * dot(w, l))
    c.dir = normalize(c.dir + (want - c.dir) * f32(clamp(dt * 1.5, 0.0, 1.0)) + vec3(0.0001, 0, 0))

# seconds since a note sounded, heard at `frame`
note_ago = (frame: int, n: LiveNote) -> f64: max(0.0, f64(frame - n.start) / f64(MUSIC_RATE))

note_life = (c: NoteCue) -> f64: NOTE_PATH / max(c.speed, 0.1)

note_cue_age = (c: mut NoteCue, now: f64):
    life = note_life(c)
    i = 0
    loop i < c.rising.len():
        if now - c.rising[i].born > life or now < c.rising[i].born: c.rising.remove_at(i) else: i += 1

# Where a note's staff line is now (world): risen in an arc from where it set off and drifted
# along, its part's lane above; under the ceiling indoors.
note_pos = (c: NoteCue, r: RisingNote, now: f64) -> vec3:
    a = max(0.0, now - r.born)
    st = _staff_of(c, r.part)
    _path(c, r.at, a, st)

# the way a staff runs: from `at`, `a` seconds along (risen in an arc, drifted, its lane above,
# under the ceiling)
_path = (c: NoteCue, at: vec3, a: f64, st: NoteStaff) -> vec3:
    rise = NOTE_ARC * (1.0 - exp(-a / 0.9)) + 0.08 * a
    p = at + c.dir * f32(c.speed * a) + vec3(0, f32(rise + st.lane), 0)
    top = f64(p.y) + _staff_span(st) * c.step_m
    if top > c.ceiling: p.y = f32(f64(p.y) - (top - c.ceiling))
    p

# how strongly a note shows for its age: in at once, out over the last third of its way
note_age_alpha = (c: NoteCue, r: RisingNote, now: f64) -> f64:
    a = now - r.born
    life = note_life(c)
    clamp(a / 0.12, 0.0, 1.0) * clamp((life - a) / (life * 0.33), 0.0, 1.0)

# how strongly notes show from where one is: fading with distance about as the music does, and
# fainter through walls
note_heard_alpha = (distance: f64, occlusion: f64) -> f64:
    (1.0 - smoothstep(22.0, NOTE_HEARD, distance)) * (1.0 - 0.65 * clamp(occlusion, 0.0, 1.0))

# ---------------- drawing ----------------

# A chord's heads as steps up the stave from its lowest (a step to each line or space, by the
# white notes: C D E F G A B), lowest first; one note: [0].
_white_step = [0, 0, 1, 1, 2, 3, 3, 4, 4, 5, 5, 6]
note_staff_step = (pitch: int) -> int: (pitch / 12) * 7 + _white_step[pitch % 12]
note_steps = (pitches: int[]) -> int[]:
    if pitches.len() < 2: return [0]
    base = note_staff_step(pitches[0])
    out: int[]
    loop p in pitches:
        s = note_staff_step(p) - base
        # (two notes on one step, a sharp beside its natural: a step apart, as accidentals sit)
        if out.len() > 0 and s <= out[out.len() - 1]: s = out[out.len() - 1] + 1
        out.push(s)
    out

# One note `h` pixels tall (head to the stem's top) with its head at `c`, as written: a slanted
# oval head (open for a whole or a half, filled for the rest; a whole a little wider, with no
# stem), a stem up from its right side, a flag curling down from the stem's top for an eighth and
# two for a sixteenth, and a dot after the head for a dotted value.
draw_note_glyph = (c: vec2, h: f64, col: vec4, v: NoteValue, steps: int[] = [0], sharps: bool[] = []):
    wide = if v.kind == NOTE_WHOLE: 1.25 else: 1.0
    rx = h * 0.2 * wide; ry = h * 0.14
    w = max(1.0, h * 0.075)
    # (a chord's heads up the stave, a step to a line or a space; a second's upper head goes to
    # the stem's other side, as written)
    flipped = false
    loop i in 0..steps.len():
        flipped = i > 0 and steps[i] - steps[i - 1] <= 1 and not flipped
        hc = vec2(f32(f64(c.x) + (if flipped: rx * 1.8 else: 0.0)), f32(f64(c.y) - f64(steps[i]) * ry))
        head: vec2[]
        loop k in 0..8:
            a = f64(k) * TAU / 8.0
            x = cos(a) * rx; y = sin(a) * ry
            head.push(vec2(f32(f64(hc.x) + x * 0.94 + y * 0.34), f32(f64(hc.y) + y * 0.94 - x * 0.34)))
        if v.kind <= NOTE_HALF: polyline(head, w * 1.15, col, true)
        else: polygon(head, col)
        if v.dotted: circle(vec2(f32(f64(c.x) + rx * (if flipped: 3.45 else: 1.65)), f32(f64(hc.y) - ry * 0.2)), max(1.0, h * 0.055), col, 6)
        # (a sharp before a black key's head)
        if i < sharps.len() and sharps[i]:
            sx0 = f64(c.x) - rx * 2.3; sy = f64(hc.y); u = ry * 1.6
            loop dx in [-0.25, 0.25]: line(vec2(f32(sx0 + dx * rx * 1.6), f32(sy - u * 1.1)), vec2(f32(sx0 + dx * rx * 1.6), f32(sy + u * 1.1)), max(1.0, w * 0.6), col)
            loop dy in [-0.35, 0.35]: line(vec2(f32(sx0 - rx * 0.75), f32(sy + dy * u + u * 0.12)), vec2(f32(sx0 + rx * 0.75), f32(sy + dy * u - u * 0.12)), max(1.0, w * 1.1), col)
    if v.kind == NOTE_WHOLE: return
    sx = f64(c.x) + rx * 0.9
    high = f64(c.y) - f64(steps[steps.len() - 1]) * ry
    top = vec2(f32(sx), f32(high - h * 0.86))
    line(vec2(f32(sx), f32(f64(c.y) - ry * 0.3)), top, w, col)
    loop f in 0..max(0, v.kind - NOTE_QUARTER):
        dy = f64(f) * h * 0.2
        start = vec2(top.x, f32(f64(top.y) + dy))
        mid = vec2(f32(sx + h * 0.24), f32(high - h * 0.56 + dy))
        end = vec2(f32(sx + h * 0.18), f32(high - h * 0.36 + dy))
        line(start, mid, w * 1.1, col)
        line(mid, end, w, col)

# A part's staff lines (steps above its lowest line) and the ledger lines a head at `step` needs.
_staff_lines = (s: NoteStaff) -> int[]: if s.treble and s.bass: [0, 2, 4, 6, 8, 12, 14, 16, 18, 20] else: [0, 2, 4, 6, 8]
_ledgers = (s: NoteStaff, step: int) -> int[]:
    out: int[]
    top = if s.treble and s.bass: 20 else: 8
    if step < 0:
        k = -2
        loop k >= step:
            out.push(k); k -= 2
    else if step > top:
        k = top + 2
        loop k <= step:
            out.push(k); k += 2
    else if s.treble and s.bass and step == 10: out.push(10)
    out

_black = [false, true, false, true, false, false, true, false, true, false, true, false]

# The notes of one source, seen from the camera, each part on its staff: `heard` the share they
# show at (distance, walls); `night` 0 by day .. 1 after dark (ink, or cream).
draw_note_cue = (c: NoteCue, now: f64, heard: f64, night: f64):
    if heard <= 0.01 or c.rising.len() == 0: return
    ink = vec4(0.16, 0.12, 0.09, 1) * f32(1.0 - night) + vec4(1.0, 0.95, 0.82, 1) * f32(night)
    up = vec3(0, f32(c.step_m), 0)
    loop st in c.staves:
        # (its notes, newest first: the staff runs from the player along them)
        # (its notes are in the order they rose: the newest last)
        first = -1; last = -1
        loop k in 0..c.rising.len():
            if c.rising[k].part == st.part:
                if first < 0: first = k
                last = k
        if last < 0: continue
        newest = c.rising[last]
        oldest = now - c.rising[first].born
        # (the staff: its lines sampled along the way, from the player to past the oldest note,
        # in three fading bands)
        lines = _staff_lines(st)
        span = min(note_life(c), oldest + 0.6)
        life = note_life(c)
        samples = 12
        sp: vec2[]; spx: f64[]; sal: f64[]
        loop k in 0..samples + 1:
            a = span * f64(k) / f64(samples)
            p = _path(c, newest.at, a, st)
            if let s0 = world_to_screen(p):
                if let s1 = world_to_screen(p + up):
                    sp.push(s0); spx.push(max(0.5, f64(length(s1 - s0))))
                    sal.push(clamp((life - a) / (life * 0.33), 0.0, 1.0) * clamp((span - a) / 0.6, 0.0, 1.0))
        if sp.len() < 2: continue
        loop chunk in 0..3:
            lo = chunk * sp.len() / 3
            hi = min(sp.len() - 1, (chunk + 1) * sp.len() / 3)
            if hi - lo < 1: continue
            a = sal[(lo + hi) / 2] * heard * 0.3
            if a <= 0.01: continue
            col = vec4(ink.x, ink.y, ink.z, f32(a))
            loop l in lines: polyline([loop k in lo..hi + 1: vec2(sp[k].x, f32(f64(sp[k].y) - f64(l) * spx[k]))], 1.0, col)
        # (the notes on it: a step's size on screen from the staff's samples at its age)
        sw = f64(screen_width()); sh = f64(screen_height())
        loop k in first..last + 1:
            r = c.rising[k]
            if r.part != st.part: continue
            a = note_age_alpha(c, r, now) * heard * 0.85
            if a <= 0.01: continue
            age = now - r.born
            u = clamp(age / max(span, 0.001) * f64(samples), 0.0, f64(samples))
            i0 = min(int(u), spx.len() - 1); i1 = min(i0 + 1, spx.len() - 1)
            step_px = spx[i0] + (spx[i1] - spx[i0]) * (u - f64(i0))
            if let s0 = world_to_screen(note_pos(c, r, now)):
                if f64(s0.x) < -40.0 or f64(s0.x) > sw + 40.0 or f64(s0.y) < -80.0 or f64(s0.y) > sh + 80.0: continue
                col = vec4(ink.x, ink.y, ink.z, f32(a))
                # (its heads a step apart on the staff's own spacing: lines and spaces as written)
                h = step_px / 0.14
                head = vec2(s0.x, f32(f64(s0.y) - f64(r.step) * step_px))
                rx = h * 0.2
                loop lg in r.ledgers:
                    ly = f64(s0.y) - f64(lg) * step_px
                    line(vec2(f32(f64(head.x) - rx * 1.5), f32(ly)), vec2(f32(f64(head.x) + rx * 1.5), f32(ly)), 1.0, col)
                # (far off and small: the heads and stems, without flags, dots or sharps)
                if h < 9.0: draw_note_glyph(head, h, col, NoteValue(min(r.value.kind, NOTE_QUARTER)), r.steps)
                else: draw_note_glyph(head, h, col, r.value, r.steps, r.sharps)
