# Setting a survivor ashore: whether they are a friend or a foe of the player's country, whether
# this harbour holds a foe as a prisoner (the player's own country's) or lets them go, the few
# words said on the quay, and the deeds it makes (src/deeds.jo). The landing itself is the living
# world's (land_survivors); this file only decides and says.
import 'living_types.jo' as data
use 'deeds.jo'
use 'side_colours.jo'

struct RescueWords:
    title: str
    lines: str[]

# The country a harbour belongs to (-1: none known).
harbour_country = (w: data.World, place: int) -> int:
    if place in w.far.districts: return w.far.districts[place].born_country
    if place >= 0 and place < w.place_country.len(): return w.place_country[place]
    -1

# The settlement a deed at sea happened off: the nearest harbour within 40 km (-1: open sea).
deed_place_off = (w: data.World, at: vec3) -> int:
    best = -1; near = 40000.0
    loop p, _ in w.far.harbors:
        if not (p in w.place_contexts): continue
        c = w.place_contexts[p].center
        d = f64(length(vec3(c.x-at.x,0,c.z-at.z)))
        if d < near or (d == near and p < best): near = d; best = p
    best

# A survivor of `country` is a foe when the player's country is at war with it.
rescue_is_foe = (w: data.World, country: int) -> bool:
    mine = w.people[w.player].citizenship
    if country < 0 or mine < 0 or country == mine: return false
    loop r in w.diplomacy:
        if ((r.a == mine and r.b == country) or (r.a == country and r.b == mine)) and r.stage == .war: return true
    false

# How the player sees a survivor of `country` (src/side_colours.jo): their own people friends,
# a country at war with theirs an enemy, anyone else neutral. The mark over them takes its colour.
survivor_standing = (w: data.World, country: int) -> Standing: country_standing(w.people[w.player].citizenship,country,rescue_is_foe(w,country))

# A foe set ashore in the player's own country's harbour can be handed over as a prisoner.
rescue_can_hold = (w: data.World, country: int, place: int) -> bool:
    rescue_is_foe(w,country) and harbour_country(w,place) == w.people[w.player].citizenship and harbour_country(w,place) >= 0

# Two countries at war with each other.
countries_at_war = (w: data.World, a: int, b: int) -> bool:
    if a < 0 or b < 0 or a == b: return false
    loop r in w.diplomacy:
        if ((r.a == a and r.b == b) or (r.a == b and r.b == a)) and r.stage == .war: return true
    false

_country_name = (w: data.World, c: int) -> str: if c >= 0 and c < w.countries.len(): w.countries[c].name else: "abroad"

# What is said on the quay. `held`: handed over as a prisoner. `seed` picks among a few ways of
# saying it, the same each time for the same person.
rescue_words = (w: data.World, name: str, country: int, place: int, place_name: str, held: bool, seed: int) -> RescueWords:
    pick = (n: int) -> int: ((seed%n)+n)%n
    if not rescue_is_foe(w,country):
        said = [["{name}: I'd given up on anyone seeing me down there. Thank you.", "Harbourmaster: Get {name} dry and fed. The squadron will want to know."],
            ["{name}: That was a rough sea to put down in. I owe you a drink.", "Harbourmaster: Up the steps, then. Someone fetch a blanket."],
            ["Harbourmaster: Out of the strait? Bring them up.", "{name}: I counted the waves until I heard your engine."]]
        return RescueWords("{name} ashore at {place_name}",said[pick(3)])
    home = _country_name(w,country)
    if held:
        said = [["Officer: From {home}? Held here until the prisoners are exchanged.", "{name}: They told us you would leave us in the water. You didn't."],
            ["{name}: So this is where I sit out the war.", "Guard: Dry and fed. More than the strait offered."]]
        return RescueWords("{name} held at {place_name}",said[pick(2)])
    if harbour_country(w,place) == country:
        return RescueWords("{name} home at {place_name}",["{name}: My own harbour. I never thought you'd bring me here.", "Harbourmaster: We won't forget who brought them in."])
    said = [["{name}: You're letting me go?", "Harbourmaster: The coaster for {home} sails at dusk. Be on it."],
        ["Harbourmaster: No papers, no questions. Off you go.", "{name}: I won't forget this."]]
    RescueWords("{name} free at {place_name}",said[pick(2)])

# What is said at the head of a navy ship's ladder (`ship` her name, `navy` her country):
# taken in by her people, a foe of hers held below until an exchange; she sends them on to
# `place_name` with her next boat.
rescue_words_aboard = (w: data.World, name: str, country: int, navy: int, ship: str, place_name: str, held: bool, seed: int) -> RescueWords:
    pick = (n: int) -> int: ((seed%n)+n)%n
    home = _country_name(w,country)
    if held:
        said = [["Master-at-arms: From {home}? Below with you. You'll be kept until there's an exchange.", "{name}: Dry and fed will do me."],
            ["Officer of the watch: A prisoner, then. Below, and find them a blanket.", "{name}: I'd sooner a cell than the strait."]]
        return RescueWords("{name} held aboard {ship}",said[pick(2)])
    if country == navy:
        said = [["Bosun: Up you come. Below and get some tea in you.", "{name}: Never so glad to see grey paint."],
            ["{name}: I thought the strait had me.", "Officer of the watch: Report to the surgeon. The boat goes in to {place_name} tonight."],
            ["Bosun: One of ours. Mind the rail, it's wet.", "{name}: Tell the squadron I'm back."]]
        return RescueWords("{name} aboard {ship}",said[pick(3)])
    said = [["Officer of the watch: You're not ours, but you're welcome. The boat takes you in to {place_name}.", "{name}: I won't forget it."],
        ["Bosun: Up the ladder. We'll put you ashore at {place_name}.", "{name}: Thank you. Both of you."]]
    RescueWords("{name} aboard {ship}",said[pick(2)])

# The deeds of setting a survivor ashore: the rescue (a friend or a foe), and holding or freeing
# a foe. Witnessed by the survivor and whoever is listed.
rescue_deeds = (w: mut data.World, survivor: int, country: int, place: int, held: bool, others: int[]):
    seen = [survivor]+others
    foe = rescue_is_foe(w,country)
    deed_record(if foe: DeedKind.rescued_foe else: DeedKind.rescued_friend,w.player,country,place,seen,w.minute)
    if foe: deed_record(if held: DeedKind.took_prisoner else: DeedKind.released_prisoner,w.player,country,place,seen,w.minute)
