use 'living_guard.jo'
use 'living_transaction.jo'
# Outside purchases produce actual business paperwork, including missed-shipment notices.
# A standing harbor-accounting duty carries this information to Yannis at Porto; it does not
# read remote stock or invent a crisis. Ordinary public tender/claim/arrival rules still apply.
use 'living_types.jo'
use 'living_cargo.jo'
use 'living_jobs.jo'
use 'living_money.jo'
use 'living_events.jo'
use 'living_travel.jo'

_guarded_post_import_receipts = (w: mut World):
    loop i in 0..w.shipments.len():
        place = w.shipments[i].place
        if place <= 0 or place >= 5 or w.shipments[i].state == 0 or w.shipments[i].paperwork_job >= 0: continue
        poster = w.places[place].market_owner
        if w.people[poster].place != place: continue
        market = w.places[place].market.account
        route = route_geometry(w,place,0,w.harbors[place].docks[0])
        reward = max(1800,8*((route_duration(route,60000)+119)/120))
        if w.accounts[market].cents < reward: continue
        # A real completed import produces paperwork before a courier job is posted.
        if w.shipments[i].paperwork_cargo < 0:
            w.shipments[i].paperwork_cargo = cargo_mint(w,.market,place,-1,1,poster,place,.production,5000)
        # Book a real business expense through the poster, then escrow it immediately.
        if not (transfer(w,market,w.people[poster].account,reward,.escrow,w.next_job)):
            living_fault("living_dispatch.post_import_receipts.0",guard_context(w))
            return
        job = post_job(w,poster,0,.sealed,-1,1,reward,w.minute+1440)
        if job < 0:
            if not (transfer(w,w.people[poster].account,market,reward,.refund)):
                living_fault("living_dispatch.post_import_receipts.1",guard_context(w))
                return
            continue
        reason = Reason(purpose=.report,actor=poster,beneficiary=5,counterparty=poster,origin=place,destination=0,good=4,quantity=w.shipments[i].manifest[4],due_minute=w.minute+1440,job=job,amount_cents=reward)
        event = emit_event(w,.produced,place,poster,-1,reason)
        reason.source_event = event
        w.jobs[job].cause = reason
        w.jobs[job].provenance.cause="The import at {w.places[place].key} {if w.shipments[i].state==1: "has arrived" else: "did not arrive"}. Yannis needs its {if w.shipments[i].state==1: "receipt" else: "missed-shipment notice"} in Porto, and the sender pays the carriage."
        w.jobs[job].provenance.request_event=event; w.jobs[job].provenance.freight_payer=market
        w.jobs[job].reward_funder = market
        w.jobs[job].wet_charter = true; w.jobs[job].charter_payer = market
        # The business reserves its own operating fuel so lamps/spot buyers cannot consume
        # the allocation while the public tender is still open. It remains real market stock.
        back = route_geometry(w,0,place,w.harbors[0].buoy)
        burn = route_fuel(route,.gull)+route_fuel(back,.gull)
        quantity = min(available(w.places[place].market.inventory,4),(burn+max(5000,burn/5)+9)/10)
        if quantity > 0:
            if not (reserve(w.places[place].market.inventory,4,quantity)):
                living_fault("living_dispatch.post_import_receipts.2",guard_context(w))
                return
            w.jobs[job].charter_reserved_milli = quantity
        w.shipments[i].paperwork_job = job


# Recovery boundaries share one checkpoint when nested; strict mode retains loud failures.
post_import_receipts = (w: mut World):
    if guard_blocked(): return
    scope = guard_begin(w)
    _guarded_post_import_receipts(w)
    guard_finish(w,scope)
