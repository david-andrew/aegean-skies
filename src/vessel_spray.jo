# The rough sea's white water round ships (Surf, on by default; the Tweaks page's "Surf" box).
# A ship under way in a lively sea buries its bow in the waves: each time the bow digs into a
# crest it throws white spray out to both sides, painted lobes as the aircraft's spray banks
# (spray_bank.jo) that hang and drift and shrink away; and the sea paints a churn of lace foam
# along the waterline, from the bow cheeks aft into the wake (surf.jo surf_ship_foam). Both grow with the sea's state and the
# ship's speed; in a calm, or at anchor, there is next to none.
#
# Presentation only: no forces, no shared particles, no draws on the game's random numbers.
use 'vessel_types.jo'
use 'vessel_view.jo'
use 'spray_bank.jo'
use 'splash.jo'
use 'sea.jo'
use 'look.jo'
use 'tweaks.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'surf.jo'

# A ship the churn is drawn round this frame.
struct VesselChurn:
    at: WorldPoint
    yaw: f64
    length: f64
    beam: f64
    speed: f64          # 0..1 of its own top speed
    id: int
struct VesselSpray:
    bank = SprayBank()
    ids: int[]
    immersion: f64[]    # how deep the bow was in the water last step (m)
    quiet: f64[]        # when its last burst was thrown
    churn: VesselChurn[]
    energy = 0.0
    time = -1.0
vessel_spray = VesselSpray()

# The sea's state for the white water: 0 under a moderate breeze, 1 in a fresh blow.
vessel_spray_energy = (wind: f64) -> f64: smoothstep(5.0, 14.0, wind)

# One frame: each near ship under way is checked for its bow digging in (pose: as drawn,
# relative to origin), and the bank ages out its old spray.
step_vessel_spray = (vs: mut VesselSpray, ships: Vessel[], poses: mat4[], origin: vec3, t: f64, wind: vec2):
    dt = if vs.time < 0.0 or t < vs.time: 0.0 else: min(0.1, t-vs.time)
    vs.time = t
    vs.churn.clear()
    surf_ships.clear()
    energy = vessel_spray_energy(f64(length(wind)))
    vs.energy = energy
    # (the bank's own stepping ages it; no aircraft feeds it, so give it no sheets)
    i = 0
    loop i < vs.bank.puffs.len():
        if t-vs.bank.puffs[i].born >= vs.bank.puffs[i].life:
            vs.bank.puffs[i] = vs.bank.puffs[vs.bank.puffs.len()-1]; vs.bank.puffs.pop()
        else: i += 1
    if not tweaks.surf: return
    drift = vec3(wind.x, 0, wind.y)*0.45
    loop k in 0..ships.len():
        s = ships[k]
        if s.status != .underway or s.speed < 0.5: continue
        spec = vessel_spec(s.kind)
        pace = clamp(s.speed/max(spec.speed, 0.1), 0.0, 1.0)
        vs.churn.push(VesselChurn(vessel_point(s), s.yaw, spec.length, spec.beam, pace, s.id))
        surf_ships.push(SurfShip(vessel_point(s), s.yaw, spec.length*0.5, spec.beam*0.5, pace))
        if energy < 0.05 or dt <= 0.0: continue
        forward = vec3(f32(sin(s.yaw)), 0, f32(cos(s.yaw)))
        across = vec3(forward.z, 0, -forward.x)
        bow_local = transform_point(poses[k], vec3(0, 0, f32(spec.length*0.46)))
        bow = world_offset(vessel_point(s), forward*f32(spec.length*0.46))
        sea = f64(swell_at(bow.x, bow.z, t).x)
        dip = sea-f64(bow_local.y+origin.y)
        slot = -1
        loop j in 0..vs.ids.len():
            if vs.ids[j] == s.id: slot = j
        if slot < 0:
            vs.ids.push(s.id); vs.immersion.push(dip); vs.quiet.push(-1e9); slot = vs.ids.len()-1
        rising = (dip-vs.immersion[slot])/dt
        vs.immersion[slot] = dip
        # A slam: the bow driving down into a crest (or a crest climbing it), bigger the deeper
        # and faster, the rougher the sea and the faster she goes; not more than about one a second.
        if dip > 0.05 and rising > 0.25 and t-vs.quiet[slot] > 0.9:
            vs.quiet[slot] = t
            hard = clamp(rising/2.5, 0.0, 1.0)*energy*(0.4+0.6*pace)
            n = int(3.0+7.0*hard)
            loop m in 0..n:
                vs.bank.serial += 1
                h = spray_hash(vs.bank.serial*3+5); h2 = spray_hash(vs.bank.serial*7+1)
                side = if m%2 == 0: 1.0 else: -1.0
                out = normalize(across*f32(side)+forward*f32(0.35+0.4*h))
                at = world_offset(bow, across*f32(side*spec.beam*0.3)-forward*f32(spec.length*0.04*h))
                at.y = sea
                r = spec.beam*(0.10+0.16*hard)*(0.7+0.6*h2)
                spray_throw(vs.bank, at, out, forward, drift, t, 1.3+1.4*h2+0.8*hard, spec.beam*(0.3+0.9*hard)*(0.6+0.8*h),
                    r*0.75+spec.beam*0.25*hard*h2, 0.0, vec3(f32(r*(0.8+0.4*h)), f32(r*(0.7+0.5*h2)), f32(r*(1.0+0.6*h))))

# The bodies to draw: the bank's spray (the churn along each hull is the sea's own, surf.jo).
vessel_spray_instances = (vs: VesselSpray, origin: vec3, eye: vec3, t: f64) -> SplashInstance[]:
    out: SplashInstance[]
    spray_bank_instances(vs.bank, origin, eye, t, out)
    out

draw_vessel_spray = (vs: VesselSpray, L: Light, t: f64):
    if not tweaks.surf: return
    if vs.bank.puffs.len() == 0: return
    draw_custom(():
        origin = render_origin(scene_camera())
        bodies = vessel_spray_instances(vs, origin, render_eye(origin), t)
        draw_splash_bodies(bodies, L, origin)
    , transparent = true)
