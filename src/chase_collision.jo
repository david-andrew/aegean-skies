use 'town_sites.jo'
use 'geography.jo'
# A camera-sized swept sphere, conservatively bounded by expanded solid boxes.
# Reuses CPU walking footprints; canal decks retain separate top/bottom bounds.
use 'objects.jo'
use 'walk_shapes.jo'
use 'canal_geometry.jo'

camera_box_fraction=(a:vec3,b:vec3,half:vec3)->f64:
    lo=0.0;hi=1.0;d=b-a
    loop axis in 0..3:
        x=f64(if axis==0:a.x else:if axis==1:a.y else:a.z)
        v=f64(if axis==0:d.x else:if axis==1:d.y else:d.z)
        h=f64(if axis==0:half.x else:if axis==1:half.y else:half.z)
        if abs(v)<0.000001:
            if abs(x)>h:return 1.0
        else:
            first=(-h-x)/v;last=(h-x)/v
            lo=max(lo,min(first,last));hi=min(hi,max(first,last))
            if lo>hi:return 1.0
    clamp(lo,0.0,1.0)

camera_site_fraction=(s:TownSite,a:vec3,b:vec3,radius:f64)->f64:
    aa=site_local(s,a.xz);bb=site_local(s,b.xz)
    # Include the pitched roof, not just the wall height used for walking.
    roof=if s.flat:0.2 else:min(s.width,s.depth)*0.32
    center=f64(s.at.y)+(s.height+roof)*0.5
    camera_box_fraction(vec3(aa.x,f64(a.y)-center,aa.y),vec3(bb.x,f64(b.y)-center,bb.y),vec3(s.width*0.5+radius,(s.height+roof)*0.5+radius,s.depth*0.5+radius))

camera_clear_fraction=(a:vec3,b:vec3,radius:f64,towns:Town[]=[])->f64:
    fraction=1.0
    if geography_enabled:
        # The segment's cell range includes the eye even when it lies beyond a
        # thin facade; endpoint-only collision would miss that obstruction.
        count=max(1,int(ceil(f64(length(b.xz-a.xz))/16.0)))
        seen:{str:bool}={}
        loop i in 0..count+1:
            p=mix(a,b,f32(i)/f32(count))
            key="{int(floor(f64(p.x)/32))}:{int(floor(f64(p.z)/32))}"
            if key in seen:continue
            seen[key]=true
            sites=walk_cell(p.xz).sites
            loop cells in walk_published.values():sites+=cells.get(key,[])
            loop s in sites:
                fraction=min(fraction,camera_site_fraction(s,a,b,radius))
                if s.chapel:fraction=min(fraction,camera_site_fraction(site_tower(s),a,b,radius))
        # Query canal solids independently of district drawing / visibility LOD.
        if canal_near(a) or canal_near(b):
            init_canal_geometry()
            lo=min(a.xz,b.xz)-vec2(radius,radius);hi=max(a.xz,b.xz)+vec2(radius,radius)
            loop x in int(floor(f64(lo.x)/64))..int(floor(f64(hi.x)/64))+1:
                loop z in int(floor(f64(lo.y)/64))..int(floor(f64(hi.y)/64))+1:
                    loop index in canal_bins.get(x*16384+z,[]):
                        box=canal_solids[index]
                        fraction=min(fraction,camera_box_fraction(canal_local(a,box),canal_local(b,box),box.half+vec3(radius,radius,radius)))
    loop tw in towns:
        if length(tw.center.xz-a.xz)>1500.0+length(b-a):continue
        loop s in tw.sites:
            fraction=min(fraction,camera_site_fraction(s,a,b,radius))
            if s.chapel:fraction=min(fraction,camera_site_fraction(site_tower(s),a,b,radius))
    fraction

# Enter the clearance margin early; recover distance more slowly so a passing
# corner cannot repeatedly snap the chase boom out and back. Hard clearance is
# always enforced after smoothing, including sudden turns and teleports.
camera_clearance_step=(previous:f64,soft:f64,hard:f64,dt:f64)->f64:
    rate=if soft<previous:18.0 else:3.0
    min(hard,lerp(previous,soft,1.0-exp(-rate*clamp(dt,0.0,0.1))))
