# Actual small meetings: bounded groups, shared venues, present bodies and carried knowledge.
use 'living_types.jo'
use 'life_types.jo'
use 'living_life.jo'
use 'living_news.jo'
use 'living_conversation.jo'
use 'living_seed.jo'
use 'living_events.jo'
use 'living_work_knowledge.jo'

social_ready = (w: World, person: int) -> bool:
    if not life_free(w,person) or not (person in w.daily_life) or w.people[person].action.activity == .work: return false
    intent = w.daily_life[person]
    intent.place == w.people[person].place and intent.arrived and intent.meeting < 0 and (intent.venue == .cafe or intent.venue == .square or intent.venue == .market or intent.venue == .quay) and intent.activity != .sleep and intent.activity != .rest

end_meeting = (w: mut World, id: int):
    w.meetings[id].active = false
    w.active_meetings.remove(id)
    loop person in w.meetings[id].people:
        if person in w.daily_life and w.daily_life[person].meeting == id:
            w.daily_life[person].meeting = -1; w.daily_life[person].companion = -1
            if w.people[person].action.activity == .socialize:
                w.people[person].action.end_minute = w.minute
                w.people[person].next_decision_minute = min(w.people[person].next_decision_minute,w.minute)

social_minute = (w: mut World):
    ids = w.active_meetings
    loop id in ids:
        m = w.meetings[id]
        if not m.active: continue
        valid = m.until_minute > w.minute
        loop person in m.people:
            if not life_free(w,person) or w.people[person].place != m.place or w.daily_life[person].venue != m.venue: valid = false
        if not valid: end_meeting(w,id)
    # Meetings may begin as soon as the participants reach their shared place.
    loop person in 1..w.people.len():
        if not social_ready(w,person): continue
        intent = w.daily_life[person]; group = [person]
        loop other in person+1..w.people.len():
            if group.len() >= 4: break
            if not social_ready(w,other): continue
            next = w.daily_life[other]
            if next.place != intent.place or next.venue != intent.venue or length(w.people[person].pose.pos-w.people[other].pose.pos)>5: continue
            hostile = false
            loop member in group:
                rel = w.relationship_index.get(RelationshipKey(member,other),-1)
                if rel >= 0 and w.relationships[rel].grievance > 400: hostile = true
            if not hostile: group.push(other)
        if group.len() < 2: continue
        id = w.next_meeting; w.next_meeting += 1
        w.active_meetings.push(id)
        w.meetings[id] = SocialMeeting(id,intent.place,intent.venue,group,w.minute,w.minute+20,reason="a little company while the day allows it")
        loop member in group:
            w.daily_life[member].meeting = id
            w.daily_life[member].companion = if member != person: person else: group[1]
            w.daily_life[member].mobility = .walking
            if w.daily_life[member].activity != .play: w.daily_life[member].activity = .talk
            w.people[member].alone_minutes = max(0,w.people[member].alone_minutes-20)
            w.people[member].next_decision_minute = max(w.people[member].next_decision_minute,w.minute+20)
    ids = w.active_meetings
    loop id in ids:
        m = w.meetings[id]
        if not m.active or m.last_exchange_minute >= 0: continue
        w.meetings[id].last_exchange_minute = w.minute
        loop i in 0..m.people.len():
            loop j in i+1..m.people.len():
                a = m.people[i]; b = m.people[j]
                exchange_meeting_news(w,a,b,m.place)
                exchange_work_offers(w,a,b)
                seed_relationship(w,a,b)
                relationship = w.relationship_index[RelationshipKey(a,b)]
                if w.relationships[relationship].last_social_event_day != day_index(w.minute):
                    emit_event(w,.met,m.place,a,b,Reason(purpose=.visit,actor=a,counterparty=b,origin=m.place,destination=m.place))
                loop pair in [(a,b),(b,a)]:
                    rel = w.relationship_index[RelationshipKey(pair.0,pair.1)]
                    w.relationships[rel].last_social_event_day = day_index(w.minute)
                    w.relationships[rel].last_contact_minute = w.minute
                    w.relationships[rel].affinity = min(1000,w.relationships[rel].affinity+1)
        # Save a few actual conversational turns; no remote observer/renderer chooses their words.
        a = m.people[0]; b = m.people[1]
        topic = if m.venue == .market: TalkTopic.market else: if m.venue == .square and local_minute(w.minute)>=1080: TalkTopic.music else: if w.people[a].news.len()>0: TalkTopic.news else: TalkTopic.home
        spoken = converse(w,a,b,topic)
        if spoken.replies.len() > 0: answer_conversation(w,a,b,.reassure)
        converse(w,b,a,if topic == .news: TalkTopic.people else: TalkTopic.home)
    # Compact meeting history; speech and relationship memories carry what matters afterward.
    if local_minute(w.minute) == 0:
        stale: int[]
        loop id, m in w.meetings:
            if not m.active and w.minute-m.until_minute>1440: stale.push(id)
        loop id in stale: w.meetings.remove(id)
