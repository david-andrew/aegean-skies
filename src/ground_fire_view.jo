# Ground fire, drawn: riflemen in navy tunics and caps, and machine guns on tripods behind a ring of
# sandbags with a gunner and a loader. Procedural boxes and beams, one mesh per part; the rifle and
# the gun follow each post's aim. Muzzle flashes, smoke and tracers come from the shot events and
# rounds like any other gun's. Presentation only.
use 'combat.jo'
use 'objects.jo'
use 'town_details.jo'
use 'damage.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'quality.jo'

struct GroundFireMeshes:
    ready = false
    legs: Mesh                      # a rifleman below the waist (feet at the origin, facing -z)
    body: Mesh                      # above it, belt, tunic and head (pivots at the hips)
    rifle: Mesh                     # arms and the shouldered rifle (pivot at the shoulder)
    fallen: Mesh                    # a rifleman down
    nest: Mesh                      # sandbags, the loader and his ammunition box
    gun: Mesh                       # the gun on its tripod's head (pivots there)
    gunner: Mesh                    # kneeling behind it

ground_fire_meshes = GroundFireMeshes()

_GF_TUNIC = rgb(0.15,0.19,0.30)
_GF_TROUSERS = rgb(0.47,0.43,0.33)
_GF_SKIN = rgb(0.74,0.56,0.42)
_GF_LEATHER = rgb(0.30,0.20,0.12)
_GF_WOOD = rgb(0.38,0.24,0.13)
_GF_STEEL = rgb(0.13,0.14,0.15)
_GF_GOLD = rgb(0.70,0.56,0.22)

_gf_head = (vs: mut Vertex3D[], at: vec3):
    add_box(vs,at,vec3(0.21,0.24,0.23),_GF_SKIN)
    add_box(vs,at+vec3(0,0.15,0.01),vec3(0.25,0.08,0.27),_GF_TUNIC)
    add_box(vs,at+vec3(0,0.12,-0.15),vec3(0.22,0.025,0.1),_GF_LEATHER)
    add_box(vs,at+vec3(0,0.15,-0.13),vec3(0.06,0.04,0.02),_GF_GOLD)

_gf_rifle = (vs: mut Vertex3D[], butt: vec3, muzzle: vec3):
    stock = butt+(muzzle-butt)*0.62
    town_beam(vs,butt,stock,0.045,_GF_WOOD)
    town_beam(vs,stock,muzzle,0.018,_GF_STEEL)

_ground_fire_build = () -> GroundFireMeshes:
    m = GroundFireMeshes(ready=true)
    vs: Vertex3D[]
    # (standing, left foot forward, weight on the back leg)
    loop side in [-1.0,1.0]:
        z = f32(side*0.13)
        add_box(vs,vec3(f32(side*0.11),0.44,z),vec3(0.16,0.82,0.18),_GF_TROUSERS)
        add_box(vs,vec3(f32(side*0.11),0.06,z-0.05),vec3(0.17,0.12,0.29),_GF_LEATHER)
    m.legs = mesh(vs)
    vs = []
    # (the upper body, from the hips at y 0.9: leaning into the rifle, cheek on the stock)
    add_box(vs,vec3(0,0.03,0),vec3(0.42,0.08,0.26),_GF_LEATHER)
    add_box(vs,vec3(0,0,0),vec3(0.42,0.56,0.25),_GF_TUNIC,translation(vec3(0,0.33,-0.04))*rotation_x(0.12))
    _gf_head(vs,vec3(0.06,0.74,-0.13))
    m.body = mesh(vs)
    vs = []
    # (arms and rifle about the shoulder line, y 0.55 above the hips, cheek on the stock)
    s0 = vec3(0,0.55,-0.04)
    butt = vec3(0.14,0.52,0.02)-s0; muzzle = vec3(0.05,0.55,-1.08)-s0
    _gf_rifle(vs,butt,muzzle)
    town_beam(vs,vec3(-0.21,0.56,-0.05)-s0,vec3(0.07,0.5,-0.55)-s0,0.055,_GF_TUNIC)
    town_beam(vs,vec3(0.21,0.56,-0.02)-s0,vec3(0.16,0.44,-0.18)-s0,0.055,_GF_TUNIC)
    add_box(vs,vec3(0.07,0.5,-0.57)-s0,vec3(0.08,0.08,0.1),_GF_SKIN)
    m.rifle = mesh(vs)
    vs = []
    # (down: on his back, the rifle dropped beside him)
    add_box(vs,vec3(0,0.12,0),vec3(0.42,0.22,0.6),_GF_TUNIC)
    loop side in [-1.0,1.0]:add_box(vs,vec3(f32(side*0.12),0.1,0.72),vec3(0.16,0.18,0.84),_GF_TROUSERS)
    _gf_head(vs,vec3(0,0.14,-0.42))
    _gf_rifle(vs,vec3(0.5,0.05,0.4),vec3(0.62,0.05,-0.6))
    m.fallen = mesh(vs)
    vs = []
    # (the nest: two courses of sandbags round the front and sides, an ammunition box, the loader
    # lying at the gun's left with a belt in his hands)
    loop course in 0..2:
        loop k in 0..11:
            angle = -PI*0.85+PI*1.7*(f64(k)+0.5*f64(course))/10.5
            r = 1.65
            at = vec3(f32(sin(angle)*r),f32(0.13+f64(course)*0.24),f32(-cos(angle)*r))
            shade = 0.62+0.05*f64((k*7+course*3)%3)
            add_box(vs,vec3(0,0,0),vec3(0.62,0.24,0.36),rgb(f32(shade+0.08),f32(shade),f32(shade*0.74)),translation(at)*rotation_y(-angle))
    add_box(vs,vec3(-0.75,0.13,0.15),vec3(0.3,0.24,0.42),rgb(0.29,0.31,0.22))
    add_box(vs,vec3(-0.95,0.11,0.5),vec3(0.42,0.2,0.75),_GF_TUNIC)
    loop side in [-1.0,1.0]:add_box(vs,vec3(f32(-0.95+side*0.1),0.09,1.2),vec3(0.15,0.16,0.7),_GF_TROUSERS)
    _gf_head(vs,vec3(-0.92,0.24,0.0))
    m.nest = mesh(vs)
    vs = []
    # (the gun: water jacket, receiver, grips and a small shield, on the tripod's head at the
    # origin; the tripod's legs splay to the ground below)
    add_box(vs,vec3(0,0.05,-0.42),vec3(0.15,0.15,0.75),_GF_STEEL)
    town_beam(vs,vec3(0,0.05,-0.8),vec3(0,0.05,-0.98),0.025,_GF_STEEL)
    add_box(vs,vec3(0,0.06,0.08),vec3(0.2,0.2,0.32),rgb(0.18,0.19,0.18))
    loop side in [-1.0,1.0]:town_beam(vs,vec3(f32(side*0.07),0.04,0.24),vec3(f32(side*0.07),-0.04,0.36),0.02,_GF_WOOD)
    add_box(vs,vec3(0,0.12,-0.12),vec3(0.62,0.42,0.025),rgb(0.24,0.27,0.22))
    add_box(vs,vec3(0.16,0.0,0.06),vec3(0.12,0.08,0.2),rgb(0.32,0.30,0.18))
    m.gun = mesh(vs)
    vs = []
    loop side in [-1.0,1.0]:town_beam(vs,vec3(0,0.48,0),vec3(f32(side*0.42),0,0.32),0.03,_GF_STEEL)
    town_beam(vs,vec3(0,0.48,0),vec3(0,0,-0.5),0.03,_GF_STEEL)
    # (the gunner, kneeling close behind the grips, well inside the ring)
    loop side in [-1.0,1.0]:
        add_box(vs,vec3(f32(side*0.12),0.12,0.8),vec3(0.16,0.2,0.46),_GF_TROUSERS)
        add_box(vs,vec3(f32(side*0.12),0.32,0.57),vec3(0.16,0.4,0.16),_GF_TROUSERS)
    add_box(vs,vec3(0,0,0),vec3(0.42,0.5,0.25),_GF_TUNIC,translation(vec3(0,0.68,0.64))*rotation_x(0.22))
    _gf_head(vs,vec3(0,1.05,0.56))
    loop side in [-1.0,1.0]:town_beam(vs,vec3(f32(side*0.2),0.86,0.58),vec3(f32(side*0.07),0.55,0.4),0.05,_GF_TUNIC)
    m.gunner = mesh(vs)
    m

_flat_yaw = (d: vec3, fallback: f64) -> f64:
    if length(vec2(d.x,d.z)) < 0.05: return fallback
    atan2(f64(d.x),-f64(d.z))

draw_ground_fire = (b: Battle, L: Light, t: f64):
    global ground_fire_meshes
    if b.ground.len() == 0: return
    eye = scene_camera()
    if not ground_fire_meshes.ready: ground_fire_meshes = _ground_fire_build()
    m = ground_fire_meshes
    # (a figure is a few pixels beyond a few hundred metres: the flashes and tracers carry it)
    reach = if render_quality.tier == 0: 450.0 else: if render_quality.tier == 1: 700.0 else: 1000.0
    loop g in b.ground:
        if length(g.position-eye) > reach: continue
        yaw = _flat_yaw(g.aim,g.facing)
        pitch = asin(clamp(f64(g.aim.y),-1.0,1.0))
        turn = rotation_y(-yaw)
        if g.kind == .rifle:
            foot = world_point(g.position-vec3(0,1.45,0))
            if g.disabled:
                draw(obj_sh,m.fallen,obj_params(L,t,rotation_y(-g.facing+0.6),anchor=foot))
                continue
            draw(obj_sh,m.legs,obj_params(L,t,turn,anchor=foot))
            # (aiming high he leans back from the hips and raises the rifle from the shoulder;
            # aiming low he leans into it)
            aim = clamp(pitch,-0.7,1.35)
            lean = if aim > 0: min(0.42,aim*0.38) else: aim*0.6
            hips = turn*translation(vec3(0,0.9,0))*rotation_x(lean)
            draw(obj_sh,m.body,obj_params(L,t,hips,anchor=foot))
            draw(obj_sh,m.rifle,obj_params(L,t,hips*translation(vec3(0,0.55,-0.04))*rotation_x(aim-lean),anchor=foot))
        else:
            head = world_point(g.position)
            ground = world_point(g.position-vec3(0,0.48,0))
            draw(obj_sh,m.nest,obj_params(L,t,rotation_y(-g.facing),anchor=ground))
            down = if g.disabled: -0.35 else: clamp(pitch,-0.6,1.2)
            draw(obj_sh,m.gun,obj_params(L,t,turn*rotation_x(down),anchor=head))
            gunner = if g.disabled: turn*translation(vec3(0,0,0.2))*rotation_x(-0.9) else: turn
            draw(obj_sh,m.gunner,obj_params(L,t,gunner,anchor=ground))
