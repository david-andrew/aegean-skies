use 'living_types.jo'
use 'life_types.jo'
# Browser engines compile less-used Wasm paths on their first execution. Exercise
# pure speech projections before a later social minute has to pay that cost too.
# Nothing is spoken, learned, committed or saved; all input is existing world data.
use 'living_conversation.jo'
use 'living_far_context.jo'
use 'living_far_news.jo'

struct SpeechWarmup:
    started = -1
    last_minute = -1
    cursor = 0
    next_report = 0
    kinds:{str:bool}
    work_units = 0
    checksum = 0
    finished = false

step_speech_warmup = (w: World, state: mut SpeechWarmup):
    if state.finished or not w.far.populated: return
    if state.started<0: state.started=w.minute
    # Run after the minute clock, but never pile onto a frame that advanced it.
    if state.last_minute!=w.minute:
        state.last_minute=w.minute
        return
    topics=[TalkTopic.greeting,.home,.weather,.people,.news,.market,.troubles,.work,.music,.farewell]
    count=core_person_count(w)*topics.len()
    if state.cursor<count:
        person=state.cursor/topics.len();topic=topics[state.cursor%topics.len()]
        listener=if person==w.player:1 else:w.player
        state.checksum+=conversation_candidates(w,person,listener,topic).len()
        state.cursor+=1;state.work_units+=1
        return
    # Notice kinds arrive during the early economy. Warm each kind once, with
    # its real published account, without giving it to a person or the player.
    if w.minute>=state.started+12:
        state.finished=true
        return
    loop scan in 0..8:
        if state.next_report>=w.far.news_order.len():return
        id=w.far.news_order[state.next_report];state.next_report+=1
        if not (id in w.far.news):continue
        n=w.far.news[id]
        if n.kind in state.kinds:continue
        state.kinds[n.kind]=true
        r=far_news_snapshot(n,w.minute)
        state.checksum+=far_report_line(w,r,w.player,-1,.formal).len()
        state.work_units+=1
        return
