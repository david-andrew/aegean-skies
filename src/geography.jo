segment_distance = (p: vec2, a: vec2, b: vec2) -> f64:
    d = b - a
    u = clamp(dot(p - a, d) / max(dot(d, d), 0.000001), 0.0, 1.0)
    f64(length(p - a - d * u))

# Signed inward distance, with no dependence on tile/cache/view state.
region_distance = (r: LandRegion, x: f64, z: f64) -> f64:
    p = vec2(f32(x * 0.001), f32(z * 0.001))
    inside = false
    d = 1e9
    j = r.outline.len() - 1
    loop i in 0..r.outline.len():
        a = r.outline[j]; b = r.outline[i]
        d = min(d, segment_distance(p, a, b))
        if (a.y > p.y) != (b.y > p.y):
            if p.x < (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x: inside = not inside
        j = i
    d * (if inside: 1000.0 else: -1000.0)

macro_at = (x: f64, z: f64) -> (f64, f64, int):
    best = -4096.0; id = 0; relief = 0.0
    loop r in LAND_REGIONS:
        if x < f64(r.bounds.x) * 1000.0 - 5000.0 or z < f64(r.bounds.y) * 1000.0 - 5000.0 or x > f64(r.bounds.z) * 1000.0 + 5000.0 or z > f64(r.bounds.w) * 1000.0 + 5000.0: continue
        d = region_distance(r, x, z)
        # Kilometre-scale coves refine the authored outline before sampling.
        # The maximum displacement is under 1.2 km, inside the region bounds'
        # renderer apron. Fine 120 m shoreline detail is added at query time.
        d += (fbm(x*0.00018+r.seed,z*0.00018,3)-0.5)*2000.0
        d += (noise(x*0.0008,z*0.0008+r.seed)-0.5)*300.0
        if d <= best: continue
        best = d; id = r.id
        h = r.floor * (0.35 + fbm(x * 0.00013 + r.seed, z * 0.00013, 3))
        # Bend each range's spine; several overlapping orientations, not a stripe.
        qx = x*0.001 + (fbm(x*0.00022+r.seed,z*0.00022,3)-0.5)*5.0
        qz = z*0.001 + (fbm(x*0.00022,z*0.00022-r.seed,3)-0.5)*5.0
        loop ridge in MOUNTAIN_CHAINS:
            if ridge.region != r.id: continue
            dist = segment_distance(vec2(f32(qx),f32(qz)), ridge.a, ridge.b)
            q = dist / ridge.width
            spine = exp(-q * q * 1.7)
            rough = 0.70 + 0.30 * (1.0 - abs(fbm(x * 0.00046 + r.seed, z * 0.00046, 4) * 2.0 - 1.0))
            h = max(h, ridge.peak * spine * rough)
        loop basin in LAND_BASINS:
            if basin.region != r.id: continue
            dist = segment_distance(vec2(f32(qx),f32(qz)),basin.a,basin.b)
            width = basin.width*(0.75+0.5*noise(x*0.0003+r.seed,z*0.0003))
            basin_mask = 1.0-smoothstep(width*0.15,width,dist)
            h = mix(h,min(h,basin.floor*(0.65+0.7*noise(x*0.0006,z*0.0006))),basin_mask)
        relief = min(h, 3000.0)
    (relief, clamp(best, -4096.0, 65520.0), id)

small_islands: SmallIsland[]
island_bins: {int: int[]} = {}

geography_bin = (x: f64, z: f64) -> int: (int(floor(x / 16000.0)) + 32) * 128 + int(floor(z / 16000.0)) + 32

geo_random = (rng: mut Rng, a: f64, b: f64) -> f64: a + (b-a) * rng.next_float()

# Authored tectonic corridors: centre/radii (km), angular interval, scatter km,
# and island long-axis heading. Islands use a truncated Pareto radius law.
struct IslandGroup:
    name: str
    center: vec2
    radii: vec2
    start: f64
    end: f64
    scatter: f64
    turn: f64

ISLAND_GROUPS = [
    IslandGroup("Central drowned plateau",vec2(0,25),vec2(62,57),0.0,6.283185,12.0,-0.8),
    IslandGroup("Northwestern continuation",vec2(-43,-120),vec2(36,9),0.1,3.0,5.0,-0.45),
    IslandGroup("Eastern coastal arc",vec2(121,72),vec2(19,73),-1.2,1.6,8.0,-1.0),
    IslandGroup("Southern stepping stones",vec2(-80,121),vec2(38,22),0.0,2.7,5.0,-0.9),
    IslandGroup("Northern shelf",vec2(62,-165),vec2(22,12),0.0,6.283185,7.0,-0.3),
    IslandGroup("Central eastern ridge",vec2(67,5),vec2(18,26),0.0,4.5,7.0,-0.7),
]

# Principal drowned summits anchor the groups before the seeded size tail.
# (x,z,radius,minor/major) in km except the ratio. Legacy reserve still wins.
PRINCIPAL_ISLANDS = [
    vec4(10,-37,5.5,0.48),vec4(39,-29,6.0,0.55),vec4(49,8,8.0,0.65),
    vec4(32,43,6.0,0.6),vec4(-8,56,8.0,0.55),vec4(-42,47,5.0,0.5),
    vec4(-58,11,5.0,0.45),vec4(-43,0,3.2,0.45),vec4(-60,69,4.0,0.5),
    vec4(-32,85,4.5,0.6),vec4(130,138,8.5,0.4),vec4(142,96,4.5,0.45),
]

init_geography = ():
    global small_islands, island_bins
    if small_islands.len() > 0: return
    rgen = rng(GEOGRAPHY_SEED)
    loop i in 0..1300:
        # One central candidate in three; the other five corridors all rotate.
        group_id = if i%3 == 0: 0 else: 1+(i/3*2+i%3-1)%5
        if i < PRINCIPAL_ISLANDS.len(): group_id = if i < 10: 0 else: 2
        group = ISLAND_GROUPS[group_id]
        angle = geo_random(rgen,group.start,group.end)
        x = (f64(group.center.x)+cos(angle)*f64(group.radii.x)+geo_random(rgen,-group.scatter,group.scatter))*1000.0
        z = (f64(group.center.y)+sin(angle)*f64(group.radii.y)+geo_random(rgen,-group.scatter,group.scatter))*1000.0
        # The largest candidates go first; the tail then fills gaps with rocks.
        rx = if i < 30: geo_random(rgen,2800.0,6500.0) else: min(8000.0,100.0*pow(1.0-geo_random(rgen,0.0,0.999),-1.0/0.95))
        ry = rx*geo_random(rgen,0.30,0.70)
        if i < PRINCIPAL_ISLANDS.len():
            anchor = PRINCIPAL_ISLANDS[i]
            x = f64(anchor.x)*1000.0; z = f64(anchor.y)*1000.0
            rx = f64(anchor.z)*1000.0; ry = rx*f64(anchor.w)
        radius = max(rx,ry)*1.9+300.0
        if abs(x) < LEGACY_RESERVE+radius+1000.0 and abs(z) < LEGACY_RESERVE+radius+1000.0: continue
        near_mainland = false
        loop r in LAND_REGIONS:
            if region_distance(r,x,z) > -radius-1800.0: near_mainland = true
        if near_mainland: continue
        overlap = false
        loop other in small_islands:
            if f64(length(other.center-vec2(f32(x),f32(z)))) < radius+f64(max(other.radii.x,other.radii.y))*1.6: overlap = true
        if overlap: continue
        peak = if rx > 2000.0: geo_random(rgen,120.0,min(650.0,rx*0.24)) else: (if i%4 == 0: geo_random(rgen,8.0,35.0) else: geo_random(rgen,min(35.0,rx*0.12),min(650.0,rx*0.24)))
        seed = f64(i*73+GEOGRAPHY_SEED)
        turn = group.turn+geo_random(rgen,-0.35,0.35)
        shape: Shape = if peak < 25.0 and i%3 == 0: .cay else: (if rx < 300.0: .rock else: (if i%3 == 0: .hills else: .cliffs))
        form = Island("",vec2(f32(x),f32(z)),rx,peak,shape,seed,vec2(1,f32(ry/rx)),turn,0.7)
        k = small_islands.len()
        small_islands.push(SmallIsland(32+i,vec2(f32(x),f32(z)),vec2(f32(rx),f32(ry)),turn,peak,seed,form,group_id))
        loop bz in int(floor((z-radius)/16000.0))..int(floor((z+radius)/16000.0))+1:
            loop bx in int(floor((x-radius)/16000.0))..int(floor((x+radius)/16000.0))+1:
                key = (bx+32)*128+bz+32
                ids = island_bins.get(key,[])
                ids.push(k); island_bins[key] = ids

struct MacroField:
    packed: u8[]                   # original validated bytes, no expanded arrays

macro_field = MacroField()
geography_revision = 0
geography_enabled = false           # enabled by world initialization, tests can isolate legacy

geography_key = () -> int: int((hash(RIVER_NODES) xor u64(RIVER_VERSION) xor hash(LAND_REGIONS) xor hash(MOUNTAIN_CHAINS) xor hash(LAND_BASINS) xor hash(ISLAND_GROUPS) xor hash(PRINCIPAL_ISLANDS) xor u64(GEOGRAPHY_VERSION * 100000 + GEOGRAPHY_SEED)) & u64(0x7FFFFFFFFFFFFFFF))

# A small periodic erosion basis generated by the ORIGINAL filter, at the
# original 1000 m units / .13 scale / .2 strength, with three resolved octaves.
# Eight slope directions share a 512 m domain sampled every 8 m. Height change
# (signed 1/256 m) and ridge (signed 1/127) are packed after the macro samples.
const EROSION_SIDE = 64
const EROSION_BYTES = 8*EROSION_SIDE*EROSION_SIDE*3
const EROSION_OFFSET = 16+MACRO_NX*MACRO_NZ*5
WORLD_ERODE = ErosionParams(scale=0.13,strength=0.2,octaves=3)

bake_erosion_basis = () -> u8[]:
    b: u8[]
    loop direction in 0..8:
        angle = f64(direction)*TAU/8.0
        loop j in 0..EROSION_SIDE:
            loop i in 0..EROSION_SIDE:
                x = f64(i)*8.0/1000.0; z = f64(j)*8.0/1000.0
                u = smoothstep(0.0,0.512,x); v = smoothstep(0.0,0.512,z)
                dh = 0.0; ridge = 0.0
                loop oz in 0..2:
                    loop ox in 0..2:
                        w = (if ox == 0: 1.0-u else: u)*(if oz == 0: 1.0-v else: v)
                        e = erode(x-f64(ox)*0.512,z-f64(oz)*0.512,0.0,cos(angle)*0.5,sin(angle)*0.5,0.0,WORLD_ERODE,330)
                        dh += (e.dh-e.magnitude*0.5)*1000.0*w
                        ridge += e.ridge*w
                append_le(b,int(round(dh*256.0)),2)
                b.push(u8(int(round(clamp(ridge,-1.0,1.0)*127.0)) & 255))
    b

erosion_basis_value = (direction: int,ix: int,iz: int) -> (f64,f64):
    at = EROSION_OFFSET+((direction & 7)*4096+(iz & 63)*64+(ix & 63))*3
    (f64(get_le_signed(macro_field.packed,at,2))/256.0,f64(get_le_signed(macro_field.packed,at+2,1))/127.0)

erosion_basis = (direction: int,x: f64,z: f64) -> (f64,f64):
    ix = int(floor(x/8.0)); iz = int(floor(z/8.0))
    u = x/8.0-f64(ix); v = z/8.0-f64(iz)
    a = erosion_basis_value(direction,ix,iz); b = erosion_basis_value(direction,ix+1,iz)
    c = erosion_basis_value(direction,ix,iz+1); d = erosion_basis_value(direction,ix+1,iz+1)
    (mix(mix(a.0,b.0,u),mix(c.0,d.0,u),v),mix(mix(a.1,b.1,u),mix(c.1,d.1,u),v))

encode_geography = () -> u8[]:
    b: u8[] = [c'A',c'E',c'G',c'W']
    append_le(b, GEOGRAPHY_VERSION, 4); append_le(b, geography_key(), 8)
    loop j in 0..MACRO_NZ:
        loop i in 0..MACRO_NX:
            h, d, id = macro_at(MACRO_X + f64(i) * MACRO_STEP, MACRO_Z + f64(j) * MACRO_STEP)
            append_le(b, int(round(h * 4.0)), 2)
            append_le(b, int(round(d / 2.0)), 2)
            b.push(u8(id))
    b.extend(bake_erosion_basis())
    append_le(b, int(hash(b) & u64(0x7FFFFFFFFFFFFFFF)), 8)
    b

load_geography = (b: u8[]) -> bool:
    global macro_field,geography_revision
    n = MACRO_NX * MACRO_NZ
    if b.len() != 24 + n * 5 + EROSION_BYTES: return false
    if b[0] != c'A' or b[1] != c'E' or b[2] != c'G' or b[3] != c'W': return false
    if get_le(b, 4, 4) != GEOGRAPHY_VERSION or get_le_signed(b, 8, 8) != geography_key(): return false
    if get_le_signed(b, b.len() - 8, 8) != int(hash(b[0..b.len() - 8]) & u64(0x7FFFFFFFFFFFFFFF)): return false
    macro_field = MacroField(b)
    geography_revision += 1
    init_geography()
    true

macro_value = (a: int,coast: bool) -> f64:
    if coast: f64(get_le_signed(macro_field.packed,16+a*5+2,2))*2.0
    else: f64(get_le(macro_field.packed,16+a*5,2))*0.25

macro_sample = (coast: bool, x: f64, z: f64) -> f64:
    fx = clamp((x - MACRO_X) / MACRO_STEP, 0.0, f64(MACRO_NX - 1) - 0.000001)
    fz = clamp((z - MACRO_Z) / MACRO_STEP, 0.0, f64(MACRO_NZ - 1) - 0.000001)
    ix = int(floor(fx)); iz = int(floor(fz)); u = fx - f64(ix); v = fz - f64(iz)
    a = iz * MACRO_NX + ix
    mix(mix(macro_value(a,coast),macro_value(a+1,coast),u),mix(macro_value(a+MACRO_NX,coast),macro_value(a+MACRO_NX+1,coast),u),v)

# Exact derivative of the bilinear macro interior, except within a 4 m strip
# across a grid boundary where the finite footprint must straddle two cells.
macro_gradient = (x: f64,z: f64) -> (f64,f64):
    fx = clamp((x-MACRO_X)/MACRO_STEP,0.0,f64(MACRO_NX-1)-0.000001)
    fz = clamp((z-MACRO_Z)/MACRO_STEP,0.0,f64(MACRO_NZ-1)-0.000001)
    ix = int(floor(fx)); iz = int(floor(fz)); u = fx-f64(ix); v = fz-f64(iz)
    if min(min(u,1.0-u),min(v,1.0-v))*MACRO_STEP < 4.0:
        return ((macro_sample(false,x+4.0,z)-macro_sample(false,x-4.0,z))/8.0,(macro_sample(false,x,z+4.0)-macro_sample(false,x,z-4.0))/8.0)
    a = iz*MACRO_NX+ix
    aa = macro_value(a,false); bb = macro_value(a+1,false)
    cc = macro_value(a+MACRO_NX,false); dd = macro_value(a+MACRO_NX+1,false)
    (mix(bb-aa,dd-cc,v)/MACRO_STEP,mix(cc-aa,dd-bb,u)/MACRO_STEP)

# Macro coast shelter comes from signed-distance curvature, not a new palette.
# A convex headland is exposed (.cliffs), a concave bay sheltered (.hills).
new_land_base = (x: f64,z: f64) -> (f64,f64,f64):
    if abs(x) < LEGACY_RESERVE and abs(z) < LEGACY_RESERVE: return (-60.0,100.0,0.0)
    if abs(x) >= WORLD_WIDTH*0.5 or abs(z) >= WORLD_DEPTH*0.5: return (-60.0,100.0,0.0)
    if macro_field.packed.len() == 0: return (-60.0,100.0,0.0)
    d = macro_sample(true,x,z)
    h = -60.0; peak = 100.0; seed = 3.3
    if d > -1200.0:
        d += (fbm(x*0.0017+13.0,z*0.0017,3)-0.5)*180.0
        base = macro_sample(false,x,z)
        peak = max(base,100.0)
        if d <= 0.0: h = max(-60.0,d*0.3)
        else:
            if d < 2500.0:
                lap = macro_sample(true,x-896.0,z)+macro_sample(true,x+896.0,z)+macro_sample(true,x,z-896.0)+macro_sample(true,x,z+896.0)-4.0*macro_sample(true,x,z)
                exposed = 1.0-smoothstep(-60.0,100.0,lap)
                # Original cliff and hill profiles, expressed in local shore distance.
                shore_peak = min(base,400.0)
                form = Island("",vec2(0,0),1500.0,shore_peak,.cliffs,seed)
                cliff = island_profile(form,1.0-d/1500.0,x,z)
                form.shape = .hills
                sheltered = island_profile(form,1.0-d/1500.0,x,z)
                shore = mix(sheltered,cliff,exposed)
                h = mix(shore,base,smoothstep(350.0,2500.0,d))
            else: h = base
    if geography_bin(x,z) in island_bins:
        loop k in island_bins[geography_bin(x,z)]:
            isl = small_islands[k]
            if abs(x-f64(isl.center.x)) > f64(max(isl.radii.x,isl.radii.y))*1.9 or abs(z-f64(isl.center.y)) > f64(max(isl.radii.x,isl.radii.y))*1.9: continue
            q,lx,lz = island_distance(isl.form,x,z)
            if q > 1.9: continue
            ih = max(-60.0,island_profile(isl.form,q,lx,lz))
            if ih > h: h = ih; peak = isl.peak; seed = isl.seed
    (min(h,3000.0),peak,seed)

# Directional reuse of the original erosion filter. A single moderate-slope,
# neutral ridge/valley basis replaces expensive per-query Phacelle evaluation.
# Fade detail off flats/beaches exactly in the authoritative source, never as
# a render-only displacement. Seed phase offsets keep island detail distinct.
new_land_sample = (x: f64,z: f64) -> (f64,f64):
    h,peak,seed = new_land_base(x,z)
    if h < 1.0: return (river_carve(x,z,h),0.0)
    gx = 0.0; gz = 0.0
    if macro_sample(true,x,z) > 2600.0 and not (geography_bin(x,z) in island_bins):
        gx,gz = macro_gradient(x,z)
    else:
        gx = (new_land_base(x+4.0,z).0-new_land_base(x-4.0,z).0)/8.0
        gz = (new_land_base(x,z+4.0).0-new_land_base(x,z-4.0).0)/8.0
    direction = atan2(gz,gx)*8.0/TAU
    k = int(floor(direction)); u = direction-f64(k)
    a = erosion_basis(k,x+seed*17.0,z-seed*11.0)
    b = erosion_basis(k+1,x+seed*17.0,z-seed*11.0)
    mask = smoothstep(1.0,22.0,h)*0.7*smoothstep(0.0,0.20,sqrt(gx*gx+gz*gz))
    (river_carve(x,z,min(3000.0,max(h+mix(a.0,b.0,u)*mask,min(h,1.5)))),mix(a.1,b.1,u)*mask)

new_land_raw = (x: f64,z: f64) -> f64: new_land_sample(x,z).0

# The authoritative 8 m source is independent of cache/generation order and LOD.
new_land_height = (x: f64, z: f64) -> f64:
    if not geography_enabled or (abs(x) < LEGACY_RESERVE and abs(z) < LEGACY_RESERVE): return -60.0
    ax = floor(x / 8.0) * 8.0; az = floor(z / 8.0) * 8.0
    u = (x - ax) / 8.0; v = (z - az) / 8.0
    a = round(new_land_raw(ax,az) * 4096.0) / 4096.0
    b = round(new_land_raw(ax+8.0,az) * 4096.0) / 4096.0
    c = round(new_land_raw(ax,az+8.0) * 4096.0) / 4096.0
    d = round(new_land_raw(ax+8.0,az+8.0) * 4096.0) / 4096.0
    mix(mix(a,b,u),mix(c,d,u),v)

new_land_canonical = (x: f64, z: f64) -> f64: round(new_land_height(x,z) * 4096.0) / 4096.0

new_land_surface = (x: f64, z: f64) -> f64:
    if not geography_enabled or (abs(x) < LEGACY_RESERVE and abs(z) < LEGACY_RESERVE): return -60.0
    ax = floor(x / 14.0) * 14.0; az = floor(z / 14.0) * 14.0
    u = (x - ax) / 14.0; v = (z - az) / 14.0
    a = new_land_canonical(ax,az); b = new_land_canonical(ax+14.0,az)
    c = new_land_canonical(ax,az+14.0); d = new_land_canonical(ax+14.0,az+14.0)
    h = if u + v <= 1.0: a + u * (b-a) + v * (c-a) else: d + (1.0-u)*(c-d) + (1.0-v)*(b-d)
    if min(min(a,b),min(c,d)) < 192.0 and max(max(a,b),max(c,d)) > -10.0: coast_contact(a,b,c,d,u,v,ax,az) else: h

land_region_at = (x: f64, z: f64) -> int:
    if not geography_enabled or new_land_height(x,z) <= 0.0: return -1
    if geography_bin(x,z) in island_bins:
        ids = island_bins[geography_bin(x,z)]
        loop k in ids:
            isl = small_islands[k]
            if f64(length(vec2(f32(x),f32(z)) - isl.center)) < f64(max(isl.radii.x,isl.radii.y))*1.9: return isl.id
    i = clamp(int(round((x-MACRO_X)/MACRO_STEP)),0,MACRO_NX-1)
    j = clamp(int(round((z-MACRO_Z)/MACRO_STEP)),0,MACRO_NZ-1)
    int(macro_field.packed[16+(j*MACRO_NX+i)*5+4])

# A view/cache-independent cross-backend probe. Quantization is the same as the
# canonical surface, so native/wasm comparisons include actual gameplay values.
geography_fingerprint = () -> u64:
    samples: int[]
    loop k in 0..1000:
        x = -249000.0+f64((k*7919)%498000)
        z = -199000.0+f64((k*12907)%398000)
        samples.push(int(round(new_land_surface(x,z)*4096.0)))
        samples.push(land_region_at(x,z))
    hash(samples)

# Sea depth only needs submerged height. Erosion cannot lower land below 1.5 m;
# avoid evaluating it where all four source corners are safely above water.
new_land_depth_height = (x: f64,z: f64) -> f64:
    ax = floor(x/8.0)*8.0; az = floor(z/8.0)*8.0
    a = new_land_base(ax,az).0; b = new_land_base(ax+8.0,az).0
    c = new_land_base(ax,az+8.0).0; d = new_land_base(ax+8.0,az+8.0).0
    if min(min(a,b),min(c,d)) > 1.0: return 1.0
    if max(max(a,b),max(c,d)) >= 1.0: return new_land_height(x,z)
    u = (x-ax)/8.0; v = (z-az)/8.0
    mix(mix(round(a*4096.0)/4096.0,round(b*4096.0)/4096.0,u),mix(round(c*4096.0)/4096.0,round(d*4096.0)/4096.0,u),v)
