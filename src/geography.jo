# Low interior basins and coast-reaching river corridors (km, terminal elevation m).
struct LandBasin:
    region: int
    a: vec2
    b: vec2
    width: f64
    floor: f64

LAND_BASINS = [
    LandBasin(1,vec2(-163,-160),vec2(-132,-144),14.0,100.0),
    LandBasin(1,vec2(-132,-144),vec2(-92,-153),5.0,12.0),
