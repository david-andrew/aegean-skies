# Country-scale geography around the original archipelago. This module has no
# dependency on the legacy islands and never rescales/repositions them.
# Authored outlines/ridges are kilometres here; all public queries use metres.
const GEOGRAPHY_VERSION = 2
const GEOGRAPHY_SEED = 7319
const WORLD_WIDTH = 500000.0
const WORLD_DEPTH = 400000.0
const LEGACY_RESERVE = 20000.0
const MACRO_STEP = 896.0            # 64 canonical 14 m cells
const MACRO_NX = 561
const MACRO_NZ = 449
const MACRO_X = -250880.0
const MACRO_Z = -200704.0

struct LandRegion:
    id: int
    name: str
    outline: vec2[]
    bounds: vec4                    # min x,z,max x,z (km)
    floor: f64
    seed: f64

struct MountainChain:
    region: int
    a: vec2                        # kilometres
    b: vec2
    width: f64
    peak: f64

struct SmallIsland:
    id: int
    center: vec2                    # metres
    radii: vec2
    turn: f64
    peak: f64
    seed: f64

region = (id: int, name: str, floor: f64, outline: vec2[]) -> LandRegion:
    lo = vec2(1e9, 1e9); hi = vec2(-1e9, -1e9)
    loop p in outline:
        lo = min(lo, p); hi = max(hi, p)
    LandRegion(id, name, outline, vec4(lo.x, lo.y, hi.x, hi.y), floor, f64(id * 113 + GEOGRAPHY_SEED))

# Broad mainland peninsulas and channels, not scaled copies of the small islands.
LAND_REGIONS = [
    region(1, "Western mainland", 220.0, [vec2(-248,-198),vec2(-82,-198),vec2(-88,-174),vec2(-110,-159),vec2(-93,-137),vec2(-114,-119),vec2(-101,-101),vec2(-118,-79),vec2(-104,-57),vec2(-125,-36),vec2(-108,-18),vec2(-113,1),vec2(-95,20),vec2(-114,27),vec2(-139,9),vec2(-152,17),vec2(-184,5),vec2(-205,18),vec2(-224,-4),vec2(-247,-14)]),
    region(2, "Western peninsula", 150.0, [vec2(-223,20),vec2(-192,15),vec2(-169,26),vec2(-142,22),vec2(-126,35),vec2(-109,32),vec2(-101,48),vec2(-117,59),vec2(-108,78),vec2(-119,98),vec2(-112,125),vec2(-127,117),vec2(-142,89),vec2(-151,96),vec2(-148,127),vec2(-166,116),vec2(-180,92),vec2(-191,112),vec2(-208,103),vec2(-201,78),vec2(-222,65),vec2(-231,41)]),
    region(3, "Eastern mainland", 210.0, [vec2(166,-198),vec2(249,-198),vec2(249,145),vec2(224,136),vec2(218,113),vec2(188,104),vec2(177,89),vec2(205,83),vec2(214,62),vec2(194,43),vec2(166,48),vec2(158,36),vec2(188,18),vec2(181,-2),vec2(152,-10),vec2(146,-27),vec2(174,-43),vec2(157,-68),vec2(171,-86),vec2(151,-106),vec2(165,-131),vec2(147,-154)]),
    region(4, "Long island", 110.0, [vec2(-92,-111),vec2(-77,-103),vec2(-69,-84),vec2(-52,-70),vec2(-48,-51),vec2(-33,-34),vec2(-39,-21),vec2(-57,-35),vec2(-63,-56),vec2(-81,-66),vec2(-86,-88),vec2(-99,-100)]),
    region(5, "Northeastern island", 120.0, [vec2(91,-143),vec2(113,-149),vec2(131,-132),vec2(125,-112),vec2(107,-105),vec2(88,-115),vec2(96,-125),vec2(83,-134)]),
    region(6, "Eastern island", 90.0, [vec2(109,-76),vec2(126,-82),vec2(138,-63),vec2(132,-43),vec2(118,-35),vec2(106,-51)]),
    region(7, "Southern island", 130.0, [vec2(-95,170),vec2(-70,159),vec2(-42,166),vec2(-17,160),vec2(8,168),vec2(37,163),vec2(67,174),vec2(64,188),vec2(37,192),vec2(14,186),vec2(-11,194),vec2(-36,185),vec2(-64,190),vec2(-87,184)]),
    region(8, "Southeastern island", 80.0, [vec2(111,22),vec2(135,17),vec2(146,26),vec2(140,38),vec2(120,40),vec2(108,33)]),
]

MOUNTAIN_CHAINS = [
    MountainChain(1,vec2(-173,-177),vec2(-145,-127),18.0,2950.0),
    MountainChain(1,vec2(-155,-117),vec2(-171,-65),15.0,2450.0),
    MountainChain(1,vec2(-177,-54),vec2(-151,-9),12.0,2050.0),
    MountainChain(2,vec2(-188,38),vec2(-163,64),13.0,2000.0),
    MountainChain(2,vec2(-159,66),vec2(-144,101),8.0,2350.0),
    MountainChain(3,vec2(214,-166),vec2(220,-92),22.0,2650.0),
    MountainChain(3,vec2(223,-72),vec2(232,-10),20.0,2850.0),
    MountainChain(3,vec2(233,21),vec2(224,101),15.0,2250.0),
    MountainChain(4,vec2(-82,-94),vec2(-51,-49),6.0,1740.0),
    MountainChain(5,vec2(106,-135),vec2(116,-118),6.0,980.0),
    MountainChain(6,vec2(124,-67),vec2(122,-48),6.0,1240.0),
    MountainChain(7,vec2(-69,175),vec2(-40,174),7.0,2390.0),
    MountainChain(7,vec2(-14,175),vec2(13,178),6.0,2130.0),
    MountainChain(8,vec2(119,29),vec2(133,28),4.0,1380.0),
]

segment_distance = (p: vec2, a: vec2, b: vec2) -> f64:
    d = b - a
    u = clamp(dot(p - a, d) / max(dot(d, d), 0.000001), 0.0, 1.0)
    f64(length(p - a - d * u))

# Signed inward distance, with no dependence on tile/cache/view state.
region_distance = (r: LandRegion, x: f64, z: f64) -> f64:
    p = vec2(f32(x * 0.001), f32(z * 0.001))
    inside = false
    d = 1e9
    j = r.outline.len() - 1
    loop i in 0..r.outline.len():
        a = r.outline[j]; b = r.outline[i]
        d = min(d, segment_distance(p, a, b))
        if (a.y > p.y) != (b.y > p.y):
            if p.x < (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x: inside = not inside
        j = i
    d * (if inside: 1000.0 else: -1000.0)

macro_at = (x: f64, z: f64) -> (f64, f64, int):
    best = -4096.0; id = 0; relief = 0.0
    loop r in LAND_REGIONS:
        if x < f64(r.bounds.x) * 1000.0 - 5000.0 or z < f64(r.bounds.y) * 1000.0 - 5000.0 or x > f64(r.bounds.z) * 1000.0 + 5000.0 or z > f64(r.bounds.w) * 1000.0 + 5000.0: continue
        d = region_distance(r, x, z)
        # Kilometre-scale coves refine the authored outline before sampling.
        # The maximum displacement is under 1.2 km, inside the region bounds'
        # renderer apron. Fine 120 m shoreline detail is added at query time.
        d += (fbm(x*0.00018+r.seed,z*0.00018,3)-0.5)*2000.0
        d += (noise(x*0.0008,z*0.0008+r.seed)-0.5)*300.0
        if d <= best: continue
        best = d; id = r.id
        h = r.floor * (0.35 + fbm(x * 0.00013 + r.seed, z * 0.00013, 3))
        loop ridge in MOUNTAIN_CHAINS:
            if ridge.region != r.id: continue
            dist = segment_distance(vec2(f32(x * 0.001), f32(z * 0.001)), ridge.a, ridge.b)
            q = dist / ridge.width
            spine = exp(-q * q * 1.7)
            rough = 0.78 + 0.22 * (1.0 - abs(fbm(x * 0.00046 + r.seed, z * 0.00046, 4) * 2.0 - 1.0))
            h = max(h, ridge.peak * spine * rough)
        relief = min(h, 3000.0)
    (relief, clamp(best, -4096.0, 65520.0), id)

small_islands: SmallIsland[]
island_bins: {int: int[]} = {}

geography_bin = (x: f64, z: f64) -> int: (int(floor(x / 16000.0)) + 32) * 128 + int(floor(z / 16000.0)) + 32

geo_random = (rng: mut Rng, a: f64, b: f64) -> f64: a + (b-a) * rng.next_float()

init_geography = ():
    global small_islands, island_bins
    if small_islands.len() > 0: return
    rgen = rng(GEOGRAPHY_SEED)
    loop i in 0..600:
        x = geo_random(rgen, -96000.0, 150000.0)
        z = geo_random(rgen, -177000.0, 155000.0)
        rx = geo_random(rgen, 300.0, 2700.0)
        ry = rx * geo_random(rgen, 0.5, 1.7)
        if i % 13 == 0: rx *= 2.6; ry *= 2.2
        radius = max(rx, ry) * 1.4 + 1000.0
        if abs(x) < LEGACY_RESERVE + radius + 5000.0 and abs(z) < LEGACY_RESERVE + radius + 5000.0: continue
        near_mainland = false
        loop r in LAND_REGIONS:
            if region_distance(r,x,z) > -radius - 2000.0: near_mainland = true
        if near_mainland: continue
        overlap = false
        loop other in small_islands:
            if f64(length(other.center - vec2(f32(x), f32(z)))) < radius + f64(max(other.radii.x, other.radii.y)) * 1.4: overlap = true
        if overlap: continue
        peak = if i % 5 == 0: geo_random(rgen, 8.0, 35.0) else: geo_random(rgen, min(65.0, rx * 0.12), min(650.0, rx * 0.17))
        k = small_islands.len()
        small_islands.push(SmallIsland(32 + i, vec2(f32(x), f32(z)), vec2(f32(rx), f32(ry)), geo_random(rgen, 0.0, TAU), peak, f64(i * 73 + GEOGRAPHY_SEED)))
        loop bz in int(floor((z - radius) / 16000.0))..int(floor((z + radius) / 16000.0)) + 1:
            loop bx in int(floor((x - radius) / 16000.0))..int(floor((x + radius) / 16000.0)) + 1:
                key = (bx + 32) * 128 + bz + 32
                ids = island_bins.get(key, [])
                ids.push(k); island_bins[key] = ids

struct MacroField:
    packed: u8[]                   # original validated bytes, no expanded arrays

macro_field = MacroField()
geography_enabled = false           # enabled by world initialization, tests can isolate legacy

geography_key = () -> int: int((hash(LAND_REGIONS) xor hash(MOUNTAIN_CHAINS) xor u64(GEOGRAPHY_VERSION * 100000 + GEOGRAPHY_SEED)) & u64(0x7FFFFFFFFFFFFFFF))

encode_geography = () -> u8[]:
    b: u8[] = [c'A',c'E',c'G',c'W']
    append_le(b, GEOGRAPHY_VERSION, 4); append_le(b, geography_key(), 8)
    loop j in 0..MACRO_NZ:
        loop i in 0..MACRO_NX:
            h, d, id = macro_at(MACRO_X + f64(i) * MACRO_STEP, MACRO_Z + f64(j) * MACRO_STEP)
            append_le(b, int(round(h * 4.0)), 2)
            append_le(b, int(round(d / 2.0)), 2)
            b.push(u8(id))
    append_le(b, int(hash(b) & u64(0x7FFFFFFFFFFFFFFF)), 8)
    b

load_geography = (b: u8[]) -> bool:
    global macro_field
    n = MACRO_NX * MACRO_NZ
    if b.len() != 24 + n * 5: return false
    if b[0] != c'A' or b[1] != c'E' or b[2] != c'G' or b[3] != c'W': return false
    if get_le(b, 4, 4) != GEOGRAPHY_VERSION or get_le_signed(b, 8, 8) != geography_key(): return false
    if get_le_signed(b, b.len() - 8, 8) != int(hash(b[0..b.len() - 8]) & u64(0x7FFFFFFFFFFFFFFF)): return false
    macro_field = MacroField(b)
    init_geography()
    true

macro_value = (a: int,coast: bool) -> f64:
    if coast: f64(get_le_signed(macro_field.packed,16+a*5+2,2))*2.0
    else: f64(get_le(macro_field.packed,16+a*5,2))*0.25

macro_sample = (coast: bool, x: f64, z: f64) -> f64:
    fx = clamp((x - MACRO_X) / MACRO_STEP, 0.0, f64(MACRO_NX - 1) - 0.000001)
    fz = clamp((z - MACRO_Z) / MACRO_STEP, 0.0, f64(MACRO_NZ - 1) - 0.000001)
    ix = int(floor(fx)); iz = int(floor(fz)); u = fx - f64(ix); v = fz - f64(iz)
    a = iz * MACRO_NX + ix
    mix(mix(macro_value(a,coast),macro_value(a+1,coast),u),mix(macro_value(a+MACRO_NX,coast),macro_value(a+MACRO_NX+1,coast),u),v)

new_land_raw = (x: f64, z: f64) -> f64:
    if abs(x) < LEGACY_RESERVE and abs(z) < LEGACY_RESERVE: return -60.0
    if abs(x) >= WORLD_WIDTH * 0.5 or abs(z) >= WORLD_DEPTH * 0.5: return -60.0
    if macro_field.packed.len() == 0: return -60.0
    d = macro_sample(true, x, z)
    h = -60.0
    if d > -1200.0:
        # Fine coast wobble and hills are in metres, independent of world extent.
        d += (noise(x * 0.0017 + 13.0, z * 0.0017) - 0.5) * 120.0
        if d <= 0.0: h = max(-60.0, d * 0.1)
        else:
            base = macro_sample(false, x, z)
            h = 1.5 * smoothstep(0.0, 35.0, d) + base * smoothstep(0.0, 2100.0, d)
            h += (fbm(x * 0.012 + 91.0, z * 0.012, 3) - 0.5) * 9.0 * smoothstep(20.0, 250.0, d)
    if geography_bin(x,z) in island_bins:
        ids = island_bins[geography_bin(x,z)]
        loop k in ids:
            isl = small_islands[k]
            dx = x - f64(isl.center.x); dz = z - f64(isl.center.y)
            c = cos(isl.turn); s = sin(isl.turn)
            qx = (dx * c - dz * s) / f64(isl.radii.x); qz = (dx * s + dz * c) / f64(isl.radii.y)
            r = sqrt(qx*qx + qz*qz)
            if r > 1.5: continue
            edge = (1.0 - r) * f64(min(isl.radii.x, isl.radii.y))
            edge += (fbm(qx * 3.0 + isl.seed, qz * 3.0, 3) - 0.5) * f64(min(isl.radii.x, isl.radii.y)) * 0.32
            ih = max(-60.0, edge * 0.15)
            if edge > 0.0:
                rise = smoothstep(0.0, f64(min(isl.radii.x, isl.radii.y)) * 0.9, edge)
                ih = 1.5 * smoothstep(0.0, 20.0, edge) + isl.peak * rise * (0.65 + 0.35 * fbm(x * 0.002 + isl.seed, z * 0.002, 3))
            h = max(h, ih)
    h

# The authoritative 8 m source is independent of cache/generation order and LOD.
new_land_height = (x: f64, z: f64) -> f64:
    if not geography_enabled or (abs(x) < LEGACY_RESERVE and abs(z) < LEGACY_RESERVE): return -60.0
    ax = floor(x / 8.0) * 8.0; az = floor(z / 8.0) * 8.0
    u = (x - ax) / 8.0; v = (z - az) / 8.0
    a = round(new_land_raw(ax,az) * 4096.0) / 4096.0
    b = round(new_land_raw(ax+8.0,az) * 4096.0) / 4096.0
    c = round(new_land_raw(ax,az+8.0) * 4096.0) / 4096.0
    d = round(new_land_raw(ax+8.0,az+8.0) * 4096.0) / 4096.0
    mix(mix(a,b,u),mix(c,d,u),v)

new_land_canonical = (x: f64, z: f64) -> f64: round(new_land_height(x,z) * 4096.0) / 4096.0

new_land_surface = (x: f64, z: f64) -> f64:
    if not geography_enabled or (abs(x) < LEGACY_RESERVE and abs(z) < LEGACY_RESERVE): return -60.0
    ax = floor(x / 14.0) * 14.0; az = floor(z / 14.0) * 14.0
    u = (x - ax) / 14.0; v = (z - az) / 14.0
    a = new_land_canonical(ax,az); b = new_land_canonical(ax+14.0,az)
    c = new_land_canonical(ax,az+14.0); d = new_land_canonical(ax+14.0,az+14.0)
    if u + v <= 1.0: a + u * (b-a) + v * (c-a) else: d + (1.0-u)*(c-d) + (1.0-v)*(b-d)

land_region_at = (x: f64, z: f64) -> int:
    if not geography_enabled or new_land_height(x,z) <= 0.0: return -1
    if geography_bin(x,z) in island_bins:
        ids = island_bins[geography_bin(x,z)]
        loop k in ids:
            isl = small_islands[k]
            if f64(length(vec2(f32(x),f32(z)) - isl.center)) < f64(max(isl.radii.x,isl.radii.y))*1.4: return isl.id
    i = clamp(int(round((x-MACRO_X)/MACRO_STEP)),0,MACRO_NX-1)
    j = clamp(int(round((z-MACRO_Z)/MACRO_STEP)),0,MACRO_NZ-1)
    int(macro_field.packed[16+(j*MACRO_NX+i)*5+4])

# A view/cache-independent cross-backend probe. Quantization is the same as the
# canonical surface, so native/wasm comparisons include actual gameplay values.
geography_fingerprint = () -> u64:
    samples: int[]
    loop k in 0..1000:
        x = -249000.0+f64((k*7919)%498000)
        z = -199000.0+f64((k*12907)%398000)
        samples.push(int(round(new_land_surface(x,z)*4096.0)))
        samples.push(land_region_at(x,z))
    hash(samples)
