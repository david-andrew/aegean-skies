# The town cats, alive: each sits or lies at its spot by a doorway (the towns' cat spots), looks
# round at the player, and can be stroked (it stands and leans into the hand, purring) or fed a bit
# of fish. A cat that has come to know the player (src/cat_bonds.jo) walks over when the player
# comes near, follows a little way along the player's own footsteps, and waits on the quay by the
# moored aircraft; left behind, it walks home the way it came.
# Everything is cosmetic and drawn from the cat's spot: nothing here touches the living world.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'living_types.jo'
use 'cat_bonds.jo'

enum CatAct: sit, loaf, walk, lean, eat

const CAT_SEEN = 70.0              # cats are kept alive within this of the player (their spots)
const CAT_DRAWN = 48.0             # and drawn within this
const CAT_REACH = 1.6              # near enough to stroke
const CAT_GREET = 14.0             # a friend comes over when the player comes this near
const CAT_ROAM = 30.0              # and follows while the player keeps within this of its spot
const CAT_QUAY = 70.0              # it waits by an aircraft moored within this of its spot
const CAT_STROKE_TIME = 3.4
const CAT_MEAL_TIME = 4.6

struct Cat:
    key: int
    home: vec3
    home_yaw: f64
    pos: vec3
    yaw: f64
    coat: int
    act: CatAct = .sit
    phase = 0.0                     # the walk's swing
    still = 0.0                     # how long it has been still
    look = 0.0                      # the head's turn toward the player
    following = false
    waiting = false                 # by the moored aircraft
    trail: vec3[]                   # where it has walked from its spot, to go back the same way
    step = -1                       # the player's footstep it is walking to (counted from the first)
    seen = true

struct CatMeshes:
    body: Mesh[]
    head: Mesh[]
    leg: Mesh[]
    tail: Mesh[]
    fish: Mesh

struct CatScene:
    cats: Cat[]
    meshes: CatMeshes
    ready = false
    steps: vec3[]                   # the player's last footsteps, for a following cat
    steps_gone = 0                  # how many earlier footsteps have been forgotten
    focus = -1                      # the cat being stroked or fed
    doing = 0                       # 1 stroking, 2 feeding
    timer = 0.0
    purr: Sound
    purr_voice = -1
    sound_ready = false

# coats: the fur, the lighter fur (muzzle, chest, paws), the eyes, and whether it is striped
_COAT_FUR = [rgb(0.83, 0.48, 0.18), rgb(0.1, 0.09, 0.1), rgb(0.5, 0.49, 0.47), rgb(0.93, 0.91, 0.87), rgb(0.11, 0.1, 0.11), rgb(0.47, 0.35, 0.23)]
_COAT_LIGHT = [rgb(0.96, 0.86, 0.7), rgb(0.13, 0.12, 0.13), rgb(0.78, 0.77, 0.74), rgb(0.95, 0.93, 0.9), rgb(0.94, 0.93, 0.9), rgb(0.84, 0.74, 0.6)]
_COAT_EYES = [rgb(0.45, 0.62, 0.2), rgb(0.85, 0.7, 0.15), rgb(0.85, 0.65, 0.2), rgb(0.35, 0.55, 0.8), rgb(0.5, 0.7, 0.25), rgb(0.75, 0.6, 0.2)]
_COAT_STRIPES = [true, false, true, false, false, true]
const CAT_COATS = 6

cat_coat_name = (coat: int) -> str: ["ginger", "black", "grey", "white", "black and white", "brown tabby"][coat % CAT_COATS]

_build_cat_meshes = () -> CatMeshes:
    m = CatMeshes()
    loop c in 0..CAT_COATS:
        fur = _COAT_FUR[c]; light = _COAT_LIGHT[c]
        dark = fur * 0.62; dark.w = 1.0
        # the body, about its centre, nose toward -z; a lighter chest; dark stripes over a tabby's back
        b: Vertex3D[]
        add_sphere(b, vec3(0, 0, 0), 1.0, fur, 8, 5, scaling(vec3(0.085, 0.088, 0.2)))
        add_sphere(b, vec3(0, 0, 0), 1.0, light, 6, 4, translation(vec3(0, -0.02, -0.15)) * scaling(vec3(0.066, 0.07, 0.07)))
        if _COAT_STRIPES[c]:
            loop k in 0..4:
                z = -0.1 + f64(k) * 0.065
                add_sphere(b, vec3(0, 0, 0), 1.0, dark, 6, 3, translation(vec3(0, f32(0.028 - abs(z) * 0.05), f32(z))) * scaling(vec3(0.078, 0.066, 0.016)))
        m.body.push(custom_mesh(b))
        # the head about its neck: a round skull, ears, a muzzle, eyes and a pink nose
        h: Vertex3D[]
        add_sphere(h, vec3(0, 0.035, -0.05), 0.075, fur, 8, 5)
        add_sphere(h, vec3(0, 0, 0), 1.0, light, 6, 4, translation(vec3(0, 0.012, -0.112)) * scaling(vec3(0.042, 0.032, 0.03)))
        loop side in [-1.0, 1.0]:
            add_cylinder(h, vec3(0, 0, 0), 0.03, 0.06, fur, 4, 0.0, translation(vec3(f32(side * 0.042), 0.085, -0.04)) * rotation_z(side * -0.3))
            add_cylinder(h, vec3(0, 0, 0), 0.016, 0.042, rgb(0.85, 0.6, 0.58), 4, 0.0, translation(vec3(f32(side * 0.042), 0.088, -0.05)) * rotation_z(side * -0.3))
            add_box(h, vec3(f32(side * 0.03), 0.05, -0.117), vec3(0.024, 0.02, 0.012), _COAT_EYES[c])
            add_box(h, vec3(f32(side * 0.03), 0.05, -0.121), vec3(0.007, 0.018, 0.006), rgb(0.03, 0.03, 0.03))
        add_box(h, vec3(0, 0.026, -0.143), vec3(0.018, 0.012, 0.01), rgb(0.82, 0.5, 0.5))
        m.head.push(custom_mesh(h))
        # a leg hanging from its top, with a paw (white on the black-and-white cat)
        l: Vertex3D[]
        add_box(l, vec3(0, -0.075, 0), vec3(0.042, 0.15, 0.046), fur)
        add_box(l, vec3(0, -0.158, -0.012), vec3(0.046, 0.024, 0.062), if c == 4: light else: fur)
        m.leg.push(custom_mesh(l))
        # a tail segment, from its root back along +z
        t: Vertex3D[]
        add_cylinder(t, vec3(0, 0, 0), 0.02, 0.085, fur, 5, 0.017, rotation_x(PI * 0.5))
        add_sphere(t, vec3(0, 0, 0.085), 0.017, if c == 4 or _COAT_STRIPES[c]: (if c == 4: fur else: dark) else: fur, 5, 3)
        m.tail.push(custom_mesh(t))
    f: Vertex3D[]
    add_sphere(f, vec3(0, 0, 0), 1.0, rgb(0.7, 0.74, 0.78), 6, 3, translation(vec3(0, 0.02, 0)) * scaling(vec3(0.03, 0.02, 0.075)))
    add_cylinder(f, vec3(0, 0, 0), 0.03, 0.045, rgb(0.55, 0.6, 0.66), 4, 0.0, translation(vec3(0, 0.02, 0.07)) * rotation_x(PI * 0.5) * scaling(vec3(1.0, 1.0, 0.35)))
    m.fish = custom_mesh(f)
    m

# a purr: a low rumble, pulsing about 25 times a second, louder breathing in than out (2 s, loops)
_build_purr = () -> Sound:
    n = MIX_RATE * 2
    samples = fill(f32(0), n * 2)
    seed = 12345; low = 0.0; low2 = 0.0
    loop k in 0..n:
        tt = f64(k) / f64(MIX_RATE)
        seed = (seed * 1103515245 + 12345) % 2147483648
        noise = f64(seed) / 1073741824.0 - 1.0
        low += (noise - low) * 0.05; low2 += (low - low2) * 0.08
        pulse = pow(0.5 + 0.5 * sin(TAU * 25.0 * tt), 3.0)
        breath = if tt < 0.9: 1.0 * sin(PI * tt / 0.9) else: 0.6 * sin(PI * (tt - 0.9) / 1.1)
        v = low2 * pulse * (0.25 + 0.75 * breath) * 3.2 + sin(TAU * 25.0 * tt) * 0.04 * breath
        samples[k * 2] = f32(v); samples[k * 2 + 1] = f32(v)
    Sound(samples)

build_cat_scene = (audio: bool) -> CatScene:
    s = CatScene()
    s.meshes = _build_cat_meshes()
    s.ready = true
    if audio:
        s.purr = _build_purr()
        s.sound_ready = true
    s

_flat = (a: vec3, b: vec3) -> f64: f64(length(a.xz - b.xz))
_yaw_to = (from: vec3, to: vec3) -> f64: atan2(f64(to.x - from.x), f64(to.z - from.z))

# a cat's place to wait by a moored aircraft: on the quay inland of the rope's anchor, a little
# aside, and far enough from the aircraft that one can kneel by it without climbing aboard
cat_quay_spot = (anchor: vec3, aircraft: vec3, key: int) -> vec3:
    away = anchor.xz - aircraft.xz
    dir = if length(away) > 0.1: normalize(away) else: vec2(1, 0)
    side = vec2(-dir.y, dir.x) * f32(if key % 2 == 0: 0.9 else: -0.9)
    q = aircraft.xz + dir * f32(max(f64(length(away)) + 0.8, 10.5)) + side
    vec3(q.x, anchor.y, q.y)

# where a cat means to go: (the goal, whether it follows the player's footsteps there, waiting by
# the aircraft); pure, so the tests can ask it
cat_goal = (c: Cat, friend: bool, player: vec3, on_foot: bool, anchor: vec3?, aircraft: vec3) -> (vec3, bool, bool):
    near_home = _flat(player, c.home) < CAT_ROAM
    if friend and on_foot and near_home and (c.following or _flat(player, c.pos) < CAT_GREET): return (player, true, false)
    if friend and not (on_foot and near_home):
        if let a = anchor:
            if _flat(a, c.home) < CAT_QUAY: return (cat_quay_spot(a, aircraft, c.key), false, true)
    (c.home, false, false)

# the footstep a following cat walks to: on along the player's footsteps, one after another, from
# the one nearest it when it set off
_next_step = (s: CatScene, c: mut Cat) -> vec3:
    if s.steps.len() == 0: return c.pos
    last = s.steps_gone + s.steps.len() - 1
    if c.step < s.steps_gone or c.step > last:
        nearest = 0
        loop k in 1..s.steps.len():
            if _flat(s.steps[k], c.pos) < _flat(s.steps[nearest], c.pos): nearest = k
        c.step = s.steps_gone + nearest
    loop c.step < last and _flat(s.steps[c.step - s.steps_gone], c.pos) < 0.5: c.step += 1
    s.steps[c.step - s.steps_gone]

_walk = (c: mut Cat, to: vec3, speed: f64, ground: (f64, f64) -> f64, dt: f64):
    d = _flat(c.pos, to)
    if d < 0.02: return
    step = min(d, speed * dt)
    dir = normalize(to.xz - c.pos.xz)
    c.yaw = approach_angle(c.yaw, atan2(f64(dir.x), f64(dir.y)), 9.0, dt)
    p = c.pos.xz + dir * f32(step)
    c.pos = vec3(p.x, f32(ground(f64(p.x), f64(p.y))), p.y)
    c.phase += dt * speed * 9.0
    c.act = .walk
    c.still = 0.0

# the cats about the player, kept in step with the town's cat spots
_sync_cats = (s: mut CatScene, homes: vec4[], player: vec3):
    loop mut c in s.cats: c.seen = false
    loop h in homes:
        key = cat_key(f64(h.x), f64(h.z))
        found = false
        loop mut c in s.cats:
            if c.key == key:
                found = true; c.seen = true
                c.home = h.xyz
        if not found:
            yaw = f64(h.w) + PI
            s.cats.push(Cat(key, h.xyz, yaw, h.xyz, yaw, (key / 7) % CAT_COATS))
    i = 0
    loop i < s.cats.len():
        c = s.cats[i]
        gone = if c.following or c.waiting: _flat(c.pos, player) > CAT_SEEN * 2.0 else: not c.seen and _flat(c.home, player) > CAT_SEEN
        if gone and i != s.focus:
            if s.focus > i: s.focus -= 1
            s.cats.remove_at(i)
        else: i += 1

# a step of every cat; returns words for the player when a cat has just become a friend, else ""
update_cats = (s: mut CatScene, homes: vec4[], player: vec3, on_foot: bool, anchor: vec3?, aircraft: vec3, bonds: mut {int: CatBond}, minute: int, ground: (f64, f64) -> f64, dt: f64, t: f64) -> str:
    _sync_cats(s, homes, player)
    if on_foot and (s.steps.len() == 0 or _flat(s.steps[s.steps.len() - 1], player) > 0.4):
        s.steps.push(player)
        if s.steps.len() > 90:
            s.steps.remove_at(0); s.steps_gone += 1
    if not on_foot:
        s.steps_gone += s.steps.len(); s.steps = []
    said = ""
    # the stroke or the meal in hand
    if s.focus >= 0:
        s.timer += dt
        if s.timer >= (if s.doing == 2: CAT_MEAL_TIME else: CAT_STROKE_TIME): said = _finish(s, bonds, minute, true)
    loop k in 0..s.cats.len():
        c = s.cats[k]
        if k == s.focus:
            # (it turns to the player and comes to the hand: just in front of the crouching player)
            want = player + normalize(vec3(c.pos.x - player.x, 0, c.pos.z - player.z) + vec3(0.0001, 0, 0)) * 0.85
            c.pos = approach(c.pos, vec3(want.x, f32(ground(f64(want.x), f64(want.z))), want.z), 6.0, dt)
            c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, player), 8.0, dt)
            c.act = if s.doing == 2: .eat else: .lean
            c.look = approach(c.look, 0.0, 6.0, dt)
            s.cats[k] = c
            continue
        friend = cat_is_friend(bonds, c.key, minute)
        goal = cat_goal(c, friend, player, on_foot, anchor, aircraft)
        c.following = goal.1; c.waiting = goal.2
        if not c.following: c.step = -1
        to = goal.0
        if c.waiting and ground(f64(to.x), f64(to.z)) < 0.3:
            # (no quay that far inland: by the anchor itself)
            if let a = anchor: to = a + vec3(f32(if c.key % 2 == 0: 0.8 else: -0.8), 0, 0)
        if c.following:
            if _flat(c.pos, player) < 1.1: to = c.pos
            else: to = _next_step(s, c)
        else if _flat(c.pos, to) > 0.3 and not c.waiting and c.trail.len() > 0:
            # (home the way it came)
            to = c.trail[c.trail.len() - 1]
            if _flat(c.pos, to) < 0.5: c.trail.pop()
        d = _flat(c.pos, to)
        if d > 0.25:
            if c.trail.len() == 0 or _flat(c.trail[c.trail.len() - 1], c.pos) > 0.6:
                if c.following and _flat(c.pos, c.home) > 0.5: c.trail.push(c.pos)
                if c.trail.len() > 160: c.trail.remove_at(0)
            _walk(c, to, if d > 4.0: 2.6 else: 1.1, ground, dt)
        else:
            c.still += dt
            if _flat(c.pos, c.home) < 0.3:
                c.trail = []
                c.yaw = approach_angle(c.yaw, c.home_yaw, 3.0, dt)
            else if c.following: c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, player), 4.0, dt)
            else if c.waiting: c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, aircraft), 3.0, dt)
            # (sits, and now and then lies down for a while)
            c.act = if c.still > 6.0 and ((int(t / 37.0) + c.key) % 3 == 0): .loaf else: .sit
        # (the head turns to watch a player near, as far as a neck turns)
        dp = _flat(c.pos, player)
        want_look = 0.0
        if dp < 6.0 and c.act != .walk:
            rel = _yaw_to(c.pos, player) - c.yaw
            rel = atan2(sin(rel), cos(rel))
            want_look = clamp(rel, -1.1, 1.1)
        c.look = approach(c.look, want_look, 4.0, dt)
        s.cats[k] = c
    _purr(s, t)
    said

_purr = (s: mut CatScene, t: f64):
    if not s.sound_ready: return
    if s.focus >= 0 and s.doing == 1 and s.timer > 0.5:
        at = s.cats[s.focus].pos + vec3(0, 0.25, 0)
        if s.purr_voice < 0: s.purr_voice = play_at(s.purr, at, 0.0, 6.0, looping = true)
        move_sound(s.purr_voice, at, 0.16 * min(1.0, (s.timer - 0.5) * 2.0), 6.0)
    else if s.purr_voice >= 0:
        stop(s.purr_voice); s.purr_voice = -1

_finish = (s: mut CatScene, bonds: mut {int: CatBond}, minute: int, whole: bool) -> str:
    k = s.focus
    if k < 0: return ""
    c = s.cats[k]
    was = cat_is_friend(bonds, c.key, minute)
    if whole or s.timer > 1.2:
        if s.doing == 2: cat_feed(bonds, c.key, minute) else: cat_stroke(bonds, c.key, minute)
    s.focus = -1; s.doing = 0; s.timer = 0.0
    s.cats[k].act = .sit; s.cats[k].still = 0.0
    if not was and cat_is_friend(bonds, c.key, minute): return "The {cat_coat_name(c.coat)} cat has taken to you"
    ""

# the nearest cat in reach of p, or -1
nearest_cat = (s: CatScene, p: vec3, reach: f64 = CAT_REACH) -> int:
    best = -1; bd = reach
    loop k in 0..s.cats.len():
        d = _flat(s.cats[k].pos, p)
        if d < bd and abs(f64(s.cats[k].pos.y - p.y)) < 1.2: best = k; bd = d
    best

cat_busy = (s: CatScene) -> bool: s.focus >= 0

# what the card says by a cat: food (a word, "" for none) is offered to a hungry cat
cat_prompt = (s: CatScene, k: int, bonds: {int: CatBond}, minute: int, food: str) -> str:
    if k < 0 or k >= s.cats.len(): return ""
    if food != "" and cat_hungry(bonds, s.cats[k].key, minute): return "F  give the cat some {food}"
    "F  stroke the cat"

# a stroke (feed false) or a meal begins; returns the way the player turns to face the cat
cat_begin = (s: mut CatScene, k: int, feed: bool, player: vec3) -> f64:
    s.focus = k; s.timer = 0.0
    s.doing = if feed: 2 else: 1
    _yaw_to(player, s.cats[k].pos)

# the player moved off: a stroke long enough still counts
cat_stop = (s: mut CatScene, bonds: mut {int: CatBond}, minute: int) -> str: _finish(s, bonds, minute, false)

# ---- drawing ----

struct CatPose:
    body_y = 0.2
    body_z = 0.0
    pitch = 0.0
    roll = 0.0
    head = 0.0                      # the head's nod (up +)
    legs: f64[] = [0.0, 0.0, 0.0, 0.0]     # front left, front right, hind left, hind right (world tilt, forward +)
    leg_len: f64[] = [1.0, 1.0, 1.0, 1.0]
    leg_w: f64[] = [1.0, 1.0, 1.0, 1.0]   # (thickened: a sitting cat's haunches)
    tail: vec2[] = [vec2(0, 0), vec2(0, 0), vec2(0, 0), vec2(0, 0)]    # each segment's (lift, sweep)

cat_pose = (act: CatAct, phase: f64, t: f64, seed: int) -> CatPose:
    p = CatPose()
    w = f64(seed % 100) * 0.13
    match act:
        .walk:
            s = sin(phase)
            p.body_y = 0.2 + abs(cos(phase)) * 0.008
            p.legs = [s * 0.5, -s * 0.5, -s * 0.5, s * 0.5]
            p.tail = [vec2(-0.7, 0), vec2(-0.3, f32(sin(phase * 0.5) * 0.15)), vec2(-0.25, 0), vec2(-0.3, 0)]
        .sit:
            p.pitch = 0.75; p.body_y = 0.165; p.body_z = 0.07
            p.legs = [0.06, 0.06, PI * 0.5, PI * 0.5]
            p.leg_len = [1.45, 1.45, 0.8, 0.8]
            p.leg_w = [1.0, 1.0, 1.8, 1.8]
            p.head = -0.75 + sin(t * 0.4 + w) * 0.05
            flick = if sin(t * 0.7 + w) > 0.85: sin(t * 9.0) * 0.4 else: 0.0
            p.tail = [vec2(1.25, 0.2), vec2(0.35, 0.6), vec2(0.0, f32(0.6 + flick)), vec2(0.0, f32(0.5 + flick))]
        .loaf:
            p.body_y = 0.095
            p.legs = [PI * 0.5, PI * 0.5, PI * 0.5, PI * 0.5]
            p.leg_len = [0.55, 0.55, 0.55, 0.55]
            p.head = 0.05 + sin(t * 0.3 + w) * 0.04
            p.tail = [vec2(0.45, 0.4), vec2(0.0, 0.55), vec2(0.0, 0.5), vec2(0.0, f32(0.4 + sin(t * 0.5 + w) * 0.15))]
        .lean:
            # (standing, pushing its head up into the hand, rubbing side to side, tail high)
            p.pitch = 0.14; p.body_y = 0.21
            p.roll = sin(t * 1.7) * 0.13
            p.head = 0.5 + sin(t * 1.7 + 0.8) * 0.12
            p.legs = [-0.1, -0.1, 0.05, 0.05]
            q = sin(t * 17.0) * 0.06
            p.tail = [vec2(-1.45, 0), vec2(0.05, f32(q)), vec2(-0.35, f32(q)), vec2(-0.6, f32(q * 2.0))]
        .eat:
            p.pitch = -0.18; p.body_y = 0.19
            p.head = -0.65 + abs(sin(t * 6.5)) * 0.14
            p.legs = [0.18, 0.18, 0.0, 0.0]
            p.leg_len = [0.92, 0.92, 1.0, 1.0]
            p.tail = [vec2(0.25, 0), vec2(0.0, f32(sin(t * 1.3) * 0.3)), vec2(0.0, f32(sin(t * 1.3 + 0.6) * 0.3)), vec2(-0.2, 0)]
    p

draw_cat = (m: CatMeshes, c: Cat, L: Light, t: f64, eating: f64 = 0.0):
    origin = render_origin(scene_camera())
    base = render_model(translation(c.pos) * rotation_y(c.yaw + PI), origin)
    p = cat_pose(c.act, c.phase, t, c.key)
    coat = c.coat % CAT_COATS
    body = base * translation(vec3(0, f32(p.body_y), f32(p.body_z))) * rotation_x(p.pitch) * rotation_z(p.roll)
    draw(obj_sh, m.body[coat], obj_local_params(L, t, body))
    head = body * translation(vec3(0, 0.06, -0.19)) * rotation_x(-p.pitch * 0.5) * rotation_y(c.look) * rotation_x(p.head + p.pitch * 0.5)
    draw(obj_sh, m.head[coat], obj_local_params(L, t, head))
    attach = [vec3(-0.05, -0.035, -0.13), vec3(0.05, -0.035, -0.13), vec3(-0.05, -0.035, 0.13), vec3(0.05, -0.035, 0.13)]
    loop k in 0..4:
        leg = body * translation(attach[k]) * rotation_z(-p.roll) * rotation_x(-p.pitch + p.legs[k]) * scaling(vec3(f32(p.leg_w[k]), f32(p.leg_len[k]), f32(p.leg_w[k] * 1.3 - 0.3)))
        draw(obj_sh, m.leg[coat], obj_local_params(L, t, leg))
    seg = body * translation(vec3(0, 0.035, 0.185)) * rotation_x(-p.pitch)
    loop k in 0..4:
        seg = seg * rotation_x(f64(p.tail[k].x)) * rotation_y(f64(p.tail[k].y) * (if c.key % 2 == 0: 1.0 else: -1.0))
        draw(obj_sh, m.tail[coat], obj_local_params(L, t, seg))
        seg = seg * translation(vec3(0, 0, 0.08))
    if eating > 0.0:
        # (the bit of fish on the ground before it, going as it eats)
        fish = base * translation(vec3(0, 0.005, -0.3)) * rotation_y(0.6) * scaling(f64(eating) * 1.4)
        draw(obj_sh, m.fish, obj_local_params(L, t, fish))

draw_cats = (s: CatScene, L: Light, t: f64):
    if not s.ready: return
    cam = scene_camera()
    loop k in 0..s.cats.len():
        c = s.cats[k]
        if length(c.pos - cam) > CAT_DRAWN: continue
        eating = if k == s.focus and s.doing == 2: clamp(1.0 - (s.timer - 0.8) / (CAT_MEAL_TIME - 0.6), 0.0, 1.0) else: 0.0
        draw_cat(s.meshes, c, L, t, eating)
