# The town cats, alive: each sits or lies at its spot by a doorway (the towns' cat spots), looks
# round at the player, and can be stroked (it stands and leans into the hand, purring) or fed (the
# pilot crouches and holds the food out; it comes and eats). Each has its temper: a wary stranger
# keeps out of reach and creeps up to food, a bold one comes over to sniff the pilot. A cat that
# has come to recognise the player (src/cat_bonds.jo) walks over when he comes back to its town,
# rubs round his legs, follows a little way along his own footsteps, and waits on the quay by the
# moored aircraft; left behind, it walks home the way it came.
#
# The cat that has adopted him (PresentationState.cat) follows him everywhere on land at a cat's
# pace, with its own detours (a sniff, a sit, a stretch, a wash), and waits outside when he goes in
# where it isn't welcome. It hops aboard after him before take-off, rides in the cockpit (crouching
# low through bumps and loops), and hops off after him; it curls up by him when he stays the
# night. Left alone in a town it keeps to a doorstep there; left with someone, it keeps by their
# door. Nothing appears or goes without a cat walking or jumping there, or someone carrying it.
# Everything is cosmetic: nothing here touches the living world.

use 'look.jo'
use 'render_space.jo'
use 'objects.jo'
use 'living_types.jo'
use 'cat_bonds.jo'

enum CatAct: sit, loaf, walk, lean, eat, sniff, stretch, groom, crouch, curl, leap

const CAT_SEEN = 70.0              # cats are kept alive within this of the player (their spots)
const CAT_DRAWN = 48.0             # and drawn within this
const CAT_REACH = 1.6              # near enough to stroke
const CAT_GREET = 14.0             # a friend comes over when the player comes this near
const CAT_ROAM = 30.0              # and follows while the player keeps within this of its spot
const CAT_QUAY = 70.0              # it waits by an aircraft moored within this of its spot
const CAT_STROKE_TIME = 3.4
const CAT_MEAL_TIME = 4.6
const CAT_SHY = 2.6                # a wary stranger moves off when the player comes this near
const CAT_BOARD = 45.0             # the pilot's own cat comes aboard an aircraft lying this near
const CAT_LOST = 150.0             # and is left in the town when he is this far off on foot
const CAT_HOP = 5.0                # the longest hop it takes, aboard or ashore (it goes nearer first)

# where a cat is (Cat.mode)
const CM_GROUND = 0
const CM_LEAP = 1
const CM_ABOARD = 2
const CM_STAY = 3                  # (in the room with him: drawn there, draw_stay_cat)
const CM_ARMS = 4                  # (in the pilot's jacket: he took it with him)

# after a leap: down on the ground, on to the seat, settled aboard
const LEAP_GROUND = 0
const LEAP_SEAT = 1
const LEAP_ABOARD = 2
const LEAP_DOWN = 3                # (then down beside the pilot)

struct Cat:
    key: int
    home: vec3
    home_yaw: f64
    pos: vec3
    yaw: f64
    coat: int
    act: CatAct = .sit
    phase = 0.0                     # the walk's swing
    still = 0.0                     # how long it has been still
    look = 0.0                      # the head's turn toward the player
    following = false
    waiting = false                 # by the moored aircraft
    trail: vec3[]                   # where it has walked from its spot, to go back the same way
    step = -1                       # the player's footstep it is walking to (counted from the first)
    seen = true
    companion = false               # the pilot's own cat (PresentationState.cat)
    temper = 1
    mode = 0                        # CM_GROUND, CM_LEAP, CM_ABOARD, CM_STAY, CM_ARMS
    leap_from: vec3 = vec3(0, 0, 0)
    leap_to: vec3 = vec3(0, 0, 0)   # (in the world, or in the aircraft's frame when leap_craft)
    leap_craft = false
    leap_from_craft = false
    leap_t = 0.0
    leap_len = 0.5
    leap_then = 0
    idle = 0                        # a detour: 1 a sniff, 2 a sit, 3 a stretch, 4 a wash
    idle_until = 0.0
    next_idle = 0.0
    greeted = false                 # (has rubbed round his legs since he came)
    rub = 0.0                       # (rubbing: seconds left)
    rub_a = 0.0
    sniffed = false                 # (a bold stranger: has been over to sniff him)
    ride: vec3 = vec3(0, 0, 0)      # (aboard: its sway in the seat)
    jolt = 0.0
    speed = 0.0
    getting_off = false

struct CatMeshes:
    body: Mesh[]
    head: Mesh[]
    leg: Mesh[]
    tail: Mesh[]
    fish: Mesh
    crust: Mesh

# what the scene needs of the pilot each frame
struct CatPilot:
    pos: vec3 = vec3(0, 0, 0)
    yaw = 0.0
    on_foot = false                 # walking about (not aboard, not in a room)
    moving = false
    aboard = false
    stay = false                    # in a room for the night (src/stay.jo)
    bailing = false                 # out of the aircraft under his parachute
    indoors = false                 # inside a house or the bar
    welcome = false                 # where his cat may come in too
    anchor: vec3? = none            # the moored aircraft's line on the quay

# and of his aircraft
struct CatCraft:
    pos: vec3 = vec3(0, 0, 0)
    rot: vec4 = vec4(0, 0, 0, 1)
    seat: vec3 = vec3(0, 0, 0)      # the cat's place in the cockpit (craft frame)
    exit: vec3 = vec3(0, 0, 0)      # where one steps off: a float, the hull's deck (craft frame)
    still = true                    # moored or lying still: to hop on or off
    speed = 0.0
    g: vec3 = vec3(0, 1, 0)         # what the seat feels, in g, in the craft's frame
    spin = 0.0                      # how fast it turns (rad/s)
    rough = 0.0                     # the air's roughness, 0 smooth .. 1

struct CatScene:
    cats: Cat[]
    meshes: CatMeshes
    ready = false
    steps: vec3[]                   # the player's last footsteps, for a following cat
    steps_gone = 0                  # how many earlier footsteps have been forgotten
    left_from: vec3 = vec3(0, 0, 0) # (where he last stood on foot: where he went aboard from)
    focus = -1                      # the cat being stroked or fed
    doing = 0                       # 1 stroking, 2 feeding
    food = 0                        # (feeding: 0 a fish, 1 a bit of something else)
    timer = 0.0
    arrived = false                 # (feeding: the cat has come to the food)
    me_pos: vec3 = vec3(0, 0, 0)
    me_yaw = 0.0
    purr: Sound
    purr_voice = -1
    sound_ready = false

# coats: the fur, the lighter fur (muzzle, chest, paws), the eyes, and whether it is striped
_COAT_FUR = [rgb(0.83, 0.48, 0.18), rgb(0.1, 0.09, 0.1), rgb(0.5, 0.49, 0.47), rgb(0.93, 0.91, 0.87), rgb(0.11, 0.1, 0.11), rgb(0.47, 0.35, 0.23)]
_COAT_LIGHT = [rgb(0.96, 0.86, 0.7), rgb(0.13, 0.12, 0.13), rgb(0.78, 0.77, 0.74), rgb(0.95, 0.93, 0.9), rgb(0.94, 0.93, 0.9), rgb(0.84, 0.74, 0.6)]
_COAT_EYES = [rgb(0.45, 0.62, 0.2), rgb(0.85, 0.7, 0.15), rgb(0.85, 0.65, 0.2), rgb(0.35, 0.55, 0.8), rgb(0.5, 0.7, 0.25), rgb(0.75, 0.6, 0.2)]
_COAT_STRIPES = [true, false, true, false, false, true]
const CAT_COATS = 6

cat_coat_name = (coat: int) -> str: ["ginger", "black", "grey", "white", "black and white", "brown tabby"][coat % CAT_COATS]

_build_cat_meshes = () -> CatMeshes:
    m = CatMeshes()
    loop c in 0..CAT_COATS:
        fur = _COAT_FUR[c]; light = _COAT_LIGHT[c]
        dark = fur * 0.62; dark.w = 1.0
        # the body, about its centre, nose toward -z; a lighter chest; dark stripes over a tabby's back
        b: Vertex3D[]
        add_sphere(b, vec3(0, 0, 0), 1.0, fur, 8, 5, scaling(vec3(0.085, 0.088, 0.2)))
        add_sphere(b, vec3(0, 0, 0), 1.0, light, 6, 4, translation(vec3(0, -0.02, -0.15)) * scaling(vec3(0.066, 0.07, 0.07)))
        if _COAT_STRIPES[c]:
            loop k in 0..4:
                z = -0.1 + f64(k) * 0.065
                add_sphere(b, vec3(0, 0, 0), 1.0, dark, 6, 3, translation(vec3(0, f32(0.028 - abs(z) * 0.05), f32(z))) * scaling(vec3(0.078, 0.066, 0.016)))
        m.body.push(custom_mesh(b))
        # the head about its neck: a round skull, ears, a muzzle, eyes and a pink nose
        h: Vertex3D[]
        add_sphere(h, vec3(0, 0.035, -0.05), 0.075, fur, 8, 5)
        add_sphere(h, vec3(0, 0, 0), 1.0, light, 6, 4, translation(vec3(0, 0.012, -0.112)) * scaling(vec3(0.042, 0.032, 0.03)))
        loop side in [-1.0, 1.0]:
            add_cylinder(h, vec3(0, 0, 0), 0.03, 0.06, fur, 4, 0.0, translation(vec3(f32(side * 0.042), 0.085, -0.04)) * rotation_z(side * -0.3))
            add_cylinder(h, vec3(0, 0, 0), 0.016, 0.042, rgb(0.85, 0.6, 0.58), 4, 0.0, translation(vec3(f32(side * 0.042), 0.088, -0.05)) * rotation_z(side * -0.3))
            add_box(h, vec3(f32(side * 0.03), 0.05, -0.117), vec3(0.024, 0.02, 0.012), _COAT_EYES[c])
            add_box(h, vec3(f32(side * 0.03), 0.05, -0.121), vec3(0.007, 0.018, 0.006), rgb(0.03, 0.03, 0.03))
        add_box(h, vec3(0, 0.026, -0.143), vec3(0.018, 0.012, 0.01), rgb(0.82, 0.5, 0.5))
        m.head.push(custom_mesh(h))
        # a leg hanging from its top, with a paw (white on the black-and-white cat)
        l: Vertex3D[]
        add_box(l, vec3(0, -0.075, 0), vec3(0.042, 0.15, 0.046), fur)
        add_box(l, vec3(0, -0.158, -0.012), vec3(0.046, 0.024, 0.062), if c == 4: light else: fur)
        m.leg.push(custom_mesh(l))
        # a tail segment, from its root back along +z
        t: Vertex3D[]
        add_cylinder(t, vec3(0, 0, 0), 0.02, 0.085, fur, 5, 0.017, rotation_x(PI * 0.5))
        add_sphere(t, vec3(0, 0, 0.085), 0.017, if c == 4 or _COAT_STRIPES[c]: (if c == 4: fur else: dark) else: fur, 5, 3)
        m.tail.push(custom_mesh(t))
    f: Vertex3D[]
    add_sphere(f, vec3(0, 0, 0), 1.0, rgb(0.7, 0.74, 0.78), 6, 3, translation(vec3(0, 0.02, 0)) * scaling(vec3(0.03, 0.02, 0.075)))
    add_cylinder(f, vec3(0, 0, 0), 0.03, 0.045, rgb(0.55, 0.6, 0.66), 4, 0.0, translation(vec3(0, 0.02, 0.07)) * rotation_x(PI * 0.5) * scaling(vec3(1.0, 1.0, 0.35)))
    m.fish = custom_mesh(f)
    # (a bit of something else from his things: a crust of bread with a piece of cheese on it)
    cr: Vertex3D[]
    add_box(cr, vec3(0, 0.015, 0), vec3(0.07, 0.03, 0.05), rgb(0.78, 0.58, 0.32))
    add_box(cr, vec3(0.005, 0.036, 0), vec3(0.045, 0.014, 0.035), rgb(0.95, 0.88, 0.6))
    m.crust = custom_mesh(cr)
    m

# a purr: a low rumble, pulsing about 25 times a second, louder breathing in than out (2 s, loops)
_build_purr = () -> Sound:
    n = MIX_RATE * 2
    samples = fill(f32(0), n * 2)
    seed = 12345; low = 0.0; low2 = 0.0
    loop k in 0..n:
        tt = f64(k) / f64(MIX_RATE)
        seed = (seed * 1103515245 + 12345) % 2147483648
        noise = f64(seed) / 1073741824.0 - 1.0
        low += (noise - low) * 0.05; low2 += (low - low2) * 0.08
        pulse = pow(0.5 + 0.5 * sin(TAU * 25.0 * tt), 3.0)
        breath = if tt < 0.9: 1.0 * sin(PI * tt / 0.9) else: 0.6 * sin(PI * (tt - 0.9) / 1.1)
        v = low2 * pulse * (0.25 + 0.75 * breath) * 3.2 + sin(TAU * 25.0 * tt) * 0.04 * breath
        samples[k * 2] = f32(v); samples[k * 2 + 1] = f32(v)
    Sound(samples)

build_cat_scene = (audio: bool) -> CatScene:
    s = CatScene()
    s.meshes = _build_cat_meshes()
    s.ready = true
    if audio:
        s.purr = _build_purr()
        s.sound_ready = true
    s

_flat = (a: vec3, b: vec3) -> f64: f64(length(a.xz - b.xz))
_yaw_to = (from: vec3, to: vec3) -> f64: atan2(f64(to.x - from.x), f64(to.z - from.z))
_hash01 = (key: int, n: f64) -> f64: fract(sin(f64(key % 9973) * 12.9898 + n * 78.233) * 43758.5453)

# a cat's place to wait by a moored aircraft: on the quay inland of the rope's anchor, a little
# aside, and far enough from the aircraft that one can kneel by it without climbing aboard
cat_quay_spot = (anchor: vec3, aircraft: vec3, key: int) -> vec3:
    away = anchor.xz - aircraft.xz
    dir = if length(away) > 0.1: normalize(away) else: vec2(1, 0)
    side = vec2(-dir.y, dir.x) * f32(if key % 2 == 0: 0.9 else: -0.9)
    q = aircraft.xz + dir * f32(max(f64(length(away)) + 0.8, 10.5)) + side
    vec3(q.x, anchor.y, q.y)

# where a cat means to go: (the goal, whether it follows the player's footsteps there, waiting by
# the aircraft); pure, so the tests can ask it
cat_goal = (c: Cat, friend: bool, player: vec3, on_foot: bool, anchor: vec3?, aircraft: vec3) -> (vec3, bool, bool):
    near_home = _flat(player, c.home) < CAT_ROAM
    if friend and on_foot and near_home and (c.following or _flat(player, c.pos) < CAT_GREET): return (player, true, false)
    if friend and not (on_foot and near_home):
        if let a = anchor:
            if _flat(a, c.home) < CAT_QUAY: return (cat_quay_spot(a, aircraft, c.key), false, true)
    (c.home, false, false)

# the footstep a following cat walks to: on along the player's footsteps, one after another, from
# the one nearest it when it set off
_next_step = (s: CatScene, c: mut Cat) -> vec3:
    if s.steps.len() == 0: return c.pos
    last = s.steps_gone + s.steps.len() - 1
    if c.step < s.steps_gone or c.step > last:
        nearest = 0
        loop k in 1..s.steps.len():
            if _flat(s.steps[k], c.pos) < _flat(s.steps[nearest], c.pos): nearest = k
        c.step = s.steps_gone + nearest
    loop c.step < last and _flat(s.steps[c.step - s.steps_gone], c.pos) < 0.5: c.step += 1
    s.steps[c.step - s.steps_gone]

_walk = (c: mut Cat, to: vec3, speed: f64, ground: (f64, f64) -> f64, dt: f64):
    d = _flat(c.pos, to)
    if d < 0.02: return
    step = min(d, speed * dt)
    dir = normalize(to.xz - c.pos.xz)
    c.yaw = approach_angle(c.yaw, atan2(f64(dir.x), f64(dir.y)), 9.0, dt)
    p = c.pos.xz + dir * f32(step)
    c.pos = vec3(p.x, f32(ground(f64(p.x), f64(p.y))), p.y)
    c.phase += dt * speed * 9.0
    c.act = .walk
    c.still = 0.0
    c.speed = speed

# where an aircraft-frame point is in the world
_craft_point = (cr: CatCraft, local: vec3) -> vec3: cr.pos + quat_rotate(cr.rot, local)

# a leap from where it is to a point (in the world, or aboard), taking a time for its length
_leap = (c: mut Cat, to: vec3, craft: bool, then: int, cr: CatCraft):
    c.leap_from = c.pos; c.leap_from_craft = false
    c.leap_to = to; c.leap_craft = craft
    end = if craft: _craft_point(cr, to) else: to
    d = f64(length(end - c.pos))
    c.leap_len = 0.35 + d * 0.12
    c.leap_t = 0.0; c.leap_then = then
    c.mode = CM_LEAP
    c.yaw = _yaw_to(c.pos, end)

# a leap from aboard: from the seat, in the aircraft's frame, as it moves under it
_leap_off = (c: mut Cat, from_local: vec3, to: vec3, craft: bool, then: int, cr: CatCraft):
    _leap(c, to, craft, then, cr)
    c.leap_from = from_local; c.leap_from_craft = true
    start = _craft_point(cr, from_local)
    end = if craft: _craft_point(cr, to) else: to
    c.leap_len = 0.35 + f64(length(end - start)) * 0.12
    c.yaw = _yaw_to(start, end)

# the leap's arc: up a little over the higher end, and down
cat_leap_point = (from: vec3, to: vec3, u: f64) -> vec3:
    p = from + (to - from) * f32(u)
    lift = 0.25 + f64(length(to - from)) * 0.12 + max(0.0, f64(to.y - from.y))
    p + vec3(0, f32(lift * 4.0 * u * (1.0 - u)), 0)

_leap_step = (c: mut Cat, cr: CatCraft, ground: (f64, f64) -> f64, dt: f64):
    c.leap_t += dt
    u = clamp(c.leap_t / c.leap_len, 0.0, 1.0)
    from = if c.leap_from_craft: _craft_point(cr, c.leap_from) else: c.leap_from
    to = if c.leap_craft: _craft_point(cr, c.leap_to) else: c.leap_to
    c.pos = cat_leap_point(from, to, u)
    c.act = .leap
    c.phase = u
    if u < 1.0: return
    c.act = .sit; c.still = 0.0
    if c.leap_then == LEAP_SEAT:
        _leap(c, cr.seat, true, LEAP_ABOARD, cr)
        c.leap_from = c.pos
    else if c.leap_then == LEAP_ABOARD:
        c.mode = CM_ABOARD; c.ride = vec3(0, 0, 0); c.jolt = 0.0
    else if c.leap_then == LEAP_DOWN:
        c.mode = CM_GROUND
    else:
        c.mode = CM_GROUND
        c.pos = vec3(c.pos.x, f32(ground(f64(c.pos.x), f64(c.pos.z))), c.pos.z)

# beside the pilot, on his right a little behind (where a cat lands from his arms or the seat)
_beside = (me: CatPilot, ground: (f64, f64) -> f64) -> vec3:
    p = me.pos + vec3(f32(-cos(me.yaw) * 0.55 - sin(me.yaw) * 0.3), 0, f32(sin(me.yaw) * 0.55 - cos(me.yaw) * 0.3))
    vec3(p.x, f32(ground(f64(p.x), f64(p.z))), p.z)

# the nearest of a town's cat spots to a point, within reach, else the point itself
_doorstep = (homes: vec4[], p: vec3) -> vec3:
    best = p; bd = 40.0
    loop h in homes:
        d = _flat(h.xyz, p)
        if d < bd: best = h.xyz; bd = d
    best

# the cats about the player, kept in step with the town's cat spots (the pilot's own cat is never
# one of a spot's: it is kept by _sync_pet)
_sync_cats = (s: mut CatScene, homes: vec4[], player: vec3, pet: CatCompanion, bonds: {int: CatBond}):
    loop mut c in s.cats: c.seen = false
    loop h in homes:
        key = cat_key(f64(h.x), f64(h.z))
        if pet.key == key: continue
        found = false
        loop mut c in s.cats:
            if c.key == key and not c.companion:
                found = true; c.seen = true
                c.home = h.xyz
        if not found:
            yaw = f64(h.w) + PI
            c = Cat(key, h.xyz, yaw, h.xyz, yaw, (key / 7) % CAT_COATS)
            c.temper = cat_temper(bonds, key)
            s.cats.push(c)
    i = 0
    loop i < s.cats.len():
        c = s.cats[i]
        gone = if c.companion: false else: if c.following or c.waiting: _flat(c.pos, player) > CAT_SEEN * 2.0 else: not c.seen and _flat(c.home, player) > CAT_SEEN
        if gone and i != s.focus:
            if s.focus > i: s.focus -= 1
            s.cats.remove_at(i)
        else: i += 1

# the pilot's own cat in the scene, where it is: with him (always), roaming or kept (while he is
# near where it keeps to); -1 when it isn't about
pet_index = (s: CatScene) -> int:
    loop k in 0..s.cats.len():
        if s.cats[k].companion: return k
    -1

_sync_pet = (s: mut CatScene, pet: CatCompanion, me: CatPilot, cr: CatCraft, bonds: {int: CatBond}, ground: (f64, f64) -> f64):
    k = pet_index(s)
    if not cat_has(pet):
        # (no longer his: it goes back to being a town cat, and walks home)
        if k >= 0:
            s.cats[k].companion = false; s.cats[k].following = false; s.cats[k].trail = []
            if s.cats[k].mode != CM_GROUND and s.cats[k].mode != CM_LEAP: s.cats[k].mode = CM_GROUND
        return
    if k >= 0 and s.cats[k].key != pet.key:
        s.cats[k].companion = false; k = -1
    near = _flat(me.pos, pet.at) < CAT_SEEN
    if k < 0:
        if pet.with != CAT_WITH and not near: return
        # (a cat already alive at its spot becomes the pilot's own where it stands)
        loop j in 0..s.cats.len():
            if s.cats[j].key == pet.key: k = j
        if k < 0:
            at = if pet.with == CAT_WITH: (if pet.aboard: _craft_point(cr, cr.seat) else: _beside(me, ground)) else: pet.at
            c = Cat(pet.key, pet.at, 0.0, at, me.yaw, pet.coat)
            c.temper = cat_temper(bonds, pet.key)
            if pet.with == CAT_WITH and pet.aboard: c.mode = CM_ABOARD
            s.cats.push(c)
            k = s.cats.len() - 1
        s.cats[k].companion = true
        s.cats[k].coat = pet.coat
    if pet.with != CAT_WITH:
        s.cats[k].home = pet.at
        # (out of sight and far: it keeps to its spot there, as the world remembers it)
        if not near and _flat(s.cats[k].pos, me.pos) > CAT_SEEN * 1.3 and k != s.focus:
            if s.focus > k: s.focus -= 1
            s.cats.remove_at(k)

# what happened in a step that the game says or does something about
struct CatNews:
    said = ""                       # words for the player
    adopted = false                 # a cat has just adopted him
    left = false                    # his cat stayed behind in the town
    aboard = false                  # it has just settled in the cockpit
    off = false                     # and has just hopped off after him

# a step of every cat; what came of it
update_cats = (s: mut CatScene, homes: vec4[], me: CatPilot, cr: CatCraft, bonds: mut {int: CatBond}, pet: mut CatCompanion, minute: int, ground: (f64, f64) -> f64, dt: f64, t: f64) -> CatNews:
    news = CatNews()
    if cat_companion_step(pet, bonds, minute):
        news.said = "{cat_called_cap(pet)} has gone back to {cat_possessive(pet)} own ways"
    _sync_cats(s, homes, me.pos, pet, bonds)
    _sync_pet(s, pet, me, cr, bonds, ground)
    s.me_pos = me.pos; s.me_yaw = me.yaw
    # (his footsteps, for a following cat: not where it may not come in)
    if me.on_foot and (not me.indoors or me.welcome) and (s.steps.len() == 0 or _flat(s.steps[s.steps.len() - 1], me.pos) > 0.4):
        s.steps.push(me.pos)
        if s.steps.len() > 90:
            s.steps.remove_at(0); s.steps_gone += 1
    if me.on_foot: s.left_from = me.pos
    if not me.on_foot:
        s.steps_gone += s.steps.len(); s.steps = []
    # the stroke or the meal in hand (a meal counts from when the cat has come to it)
    if s.focus >= 0:
        if s.doing == 1 or s.arrived: s.timer += dt
        if s.timer >= (if s.doing == 2: CAT_MEAL_TIME else: CAT_STROKE_TIME):
            out = _finish(s, bonds, pet, minute, true)
            news.said = out.said; news.adopted = out.adopted
    loop k in 0..s.cats.len():
        c = s.cats[k]
        if k == s.focus: _focus_step(s, c, me.pos, ground, dt, t)
        else if c.companion and pet.with == CAT_WITH: _pet_step(s, c, homes, me, cr, pet, minute, news, ground, dt, t)
        else: _town_step(s, c, me, cr, bonds, pet, minute, ground, dt, t)
        # (the head turns to watch a player near, as far as a neck turns)
        if c.mode == CM_GROUND:
            dp = _flat(c.pos, me.pos)
            want_look = 0.0
            if dp < 6.0 and c.act != .walk and c.act != .sniff and c.idle != 4:
                rel = _yaw_to(c.pos, me.pos) - c.yaw
                rel = atan2(sin(rel), cos(rel))
                want_look = clamp(rel, -1.1, 1.1)
            c.look = approach(c.look, want_look, 4.0, dt)
        s.cats[k] = c
    k = pet_index(s)
    if k >= 0 and pet.with == CAT_WITH: pet.aboard = s.cats[k].mode == CM_ABOARD or (s.cats[k].mode == CM_LEAP and s.cats[k].leap_craft)
    _purr(s, t)
    news

# the cat stroked or fed: it comes to him (a wary one creeping, stopping, coming on; a bold one
# straight over) and leans into the hand, or eats what he set down
_focus_step = (s: mut CatScene, c: mut Cat, player: vec3, ground: (f64, f64) -> f64, dt: f64, t: f64):
    want = player + normalize(vec3(c.pos.x - player.x, 0, c.pos.z - player.z) + vec3(0.0001, 0, 0)) * 0.85
    want = vec3(want.x, f32(ground(f64(want.x), f64(want.z))), want.z)
    d = _flat(c.pos, want)
    if s.doing == 2 and not s.arrived:
        if d < 0.12: s.arrived = true
        else:
            # (a wary cat creeps, low, a few steps at a time; a bold one trots over)
            go = c.temper != CAT_WARY or sin(t * 1.6 + f64(c.key % 7)) > -0.25
            if go: _walk(c, want, if c.temper == CAT_WARY: 0.45 else: if c.temper == CAT_BOLD: 1.5 else: 1.0, ground, dt)
            if c.temper == CAT_WARY: c.act = .crouch
            if not go: c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, player), 4.0, dt)
            return
    c.pos = approach(c.pos, want, 6.0, dt)
    c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, player), 8.0, dt)
    c.act = if s.doing == 2: .eat else: .lean
    c.look = approach(c.look, 0.0, 6.0, dt)

# the pilot's own cat, with him
_pet_step = (s: mut CatScene, c: mut Cat, homes: vec4[], me: CatPilot, cr: CatCraft, pet: mut CatCompanion, minute: int, news: mut CatNews, ground: (f64, f64) -> f64, dt: f64, t: f64):
    if c.mode == CM_LEAP:
        _leap_step(c, cr, ground, dt)
        if c.mode == CM_ABOARD: news.aboard = true
        if c.mode == CM_GROUND and c.leap_then == LEAP_DOWN and _flat(c.pos, _beside(me, ground)) > 0.4:
            # (down off the float or the deck: on beside him)
            _leap(c, _beside(me, ground), false, LEAP_GROUND, cr)
        else if c.mode == CM_GROUND and c.getting_off:
            c.getting_off = false; news.off = true
        return
    if c.mode == CM_ARMS:
        # (tucked in his jacket: down again once he is on his feet)
        c.pos = me.pos + vec3(0, 1.15, 0)
        if me.on_foot:
            c.mode = CM_GROUND
            _leap(c, _beside(me, ground), false, LEAP_GROUND, cr)
        return
    if c.mode == CM_STAY:
        c.pos = me.pos
        if not me.stay:
            c.mode = CM_GROUND
            c.pos = _beside(me, ground); c.act = .sit; c.still = 0.0
        return
    if c.mode == CM_ABOARD:
        c.pos = _craft_point(cr, cr.seat)
        if me.bailing:
            # (he takes it with him, inside his jacket)
            c.mode = CM_ARMS
            return
        if me.on_foot and cr.still and _flat(me.pos, cr.pos) < 16.0:
            # (he has gone ashore: off after him, by the float or the deck if it is far)
            c.getting_off = true
            if f64(length(cr.exit - cr.seat)) > 0.6: _leap_off(c, cr.seat, cr.exit, true, LEAP_DOWN, cr)
            else: _leap_off(c, cr.seat, _beside(me, ground), false, LEAP_GROUND, cr)
            return
        _ride_step(c, cr, dt, t)
        return
    # on the ground
    d = _flat(c.pos, me.pos)
    if me.stay and d < 30.0:
        c.mode = CM_STAY
        return
    if me.aboard:
        far = _flat(c.pos, cr.pos)
        if far < CAT_BOARD and cr.speed < 3.0:
            # (after him: to where he went aboard from, then up)
            from = s.left_from
            if _flat(c.pos, from) > 0.35:
                _walk(c, from, if _flat(c.pos, from) > 3.0: 3.4 else: 1.6, ground, dt)
                return
            exit_w = _craft_point(cr, cr.exit)
            seat_w = _craft_point(cr, cr.seat)
            by_exit = f64(length(cr.exit - cr.seat)) > 0.6
            to_w = if by_exit: exit_w else: seat_w
            if f64(length(to_w - c.pos)) > CAT_HOP:
                # (too far to jump from here: along the quay's edge nearer, while there is land)
                dir = normalize(to_w.xz - c.pos.xz + vec2(0.0001, 0))
                ahead = c.pos.xz + dir * 0.4
                if ground(f64(ahead.x), f64(ahead.y)) > 0.25:
                    _walk(c, vec3(ahead.x, 0, ahead.y), 1.2, ground, dt)
                    return
            if by_exit: _leap(c, cr.exit, true, LEAP_SEAT, cr)
            else: _leap(c, cr.seat, true, LEAP_ABOARD, cr)
            return
        if cr.speed > 4.0 or far > CAT_BOARD * 1.4:
            # (she went without it: it stays in the town, on a doorstep, and remembers him)
            spot = _doorstep(homes, c.pos)
            cat_leave_alone(pet, spot, minute)
            c.home = spot; c.trail = []; c.following = false
            news.left = true
        _sit_about(c, me.pos, dt, t)
        return
    if not me.on_foot:
        _sit_about(c, me.pos, dt, t)
        return
    if d > CAT_LOST:
        spot = _doorstep(homes, c.pos)
        cat_leave_alone(pet, spot, minute)
        c.home = spot; c.trail = []; c.following = false
        news.left = true
        return
    _follow(s, c, me, ground, dt, t)

# following him on foot at a cat's pace: trotting to catch up, walking near, and now and then a
# detour of its own (a sniff at something, a sit, a stretch, a wash) before it trots on
_follow = (s: mut CatScene, c: mut Cat, me: CatPilot, ground: (f64, f64) -> f64, dt: f64, t: f64):
    c.following = true
    d = _flat(c.pos, me.pos)
    if me.indoors and not me.welcome and s.steps.len() > 0 and _flat(c.pos, s.steps[s.steps.len() - 1]) < 0.5:
        # (he has gone in where it isn't welcome: it waits outside, at his last step there)
        _sit_about(c, me.pos, dt, t)
        return
    if c.idle > 0:
        if t < c.idle_until and d < 11.0:
            c.act = if c.idle == 1: CatAct.sniff else: if c.idle == 3: CatAct.stretch else: if c.idle == 4: CatAct.groom else: CatAct.sit
            c.still += dt
            return
        c.idle = 0
    if c.rub > 0.0:
        if d < 1.4 and not me.moving:
            _rub_step(c, me.pos, ground, dt)
            return
        c.rub = 0.0
    if d < 1.25:
        c.still += dt
        c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, me.pos), 4.0, dt)
        c.act = if c.still > 9.0 and ((int(t / 23.0) + c.key) % 3 == 0): .loaf else: if c.still > 4.0 and ((int(t / 11.0) + c.key) % 4 == 0): .groom else: .sit
        if not c.greeted and not me.moving and c.still > 0.6:
            c.greeted = true; c.rub = 3.2; c.rub_a = _yaw_to(me.pos, c.pos)
        return
    if c.still > 20.0: c.greeted = false          # (a while apart: it greets him again)
    if d < 9.0 and t > c.next_idle and c.next_idle > 0.0:
        h = _hash01(c.key, floor(t))
        c.idle = 1 + int(h * 4.0) % 4
        c.idle_until = t + 1.2 + _hash01(c.key, floor(t) + 3.0) * 1.8
        c.next_idle = t + 7.0 + _hash01(c.key, floor(t) + 7.0) * 9.0
        c.still = 0.0
        return
    if c.next_idle <= 0.0: c.next_idle = t + 4.0 + _hash01(c.key, 1.0) * 6.0
    to = if s.steps.len() > 0: _next_step(s, c) else: me.pos
    if _flat(c.pos, to) < 0.05: to = me.pos
    speed = if d > 8.0: 3.6 else: if d > 3.0: 2.1 else: 1.0
    _walk(c, to, speed, ground, dt)

# round his legs, leaning into them, tail up, and round again
_rub_step = (c: mut Cat, at: vec3, ground: (f64, f64) -> f64, dt: f64):
    c.rub -= dt
    c.rub_a += dt * 1.6
    p = at + vec3(f32(sin(c.rub_a) * 0.34), 0, f32(cos(c.rub_a) * 0.34))
    c.pos = approach(c.pos, vec3(p.x, f32(ground(f64(p.x), f64(p.z))), p.z), 5.0, dt)
    c.yaw = c.rub_a + PI * 0.5
    c.act = .lean
    c.phase += dt * 4.0
    c.still = 0.0

# sitting where it is, watching him or the aircraft
_sit_about = (c: mut Cat, toward: vec3, dt: f64, t: f64):
    c.still += dt
    c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, toward), 3.0, dt)
    c.act = if c.still > 8.0 and ((int(t / 31.0) + c.key) % 2 == 0): .loaf else: .sit

# riding in the cockpit: swaying to what the seat feels, crouching low through bumps and loops,
# settling again after; looking out now and then
_ride_step = (c: mut Cat, cr: CatCraft, dt: f64, t: f64):
    g = cr.g
    want = vec3(f32(clamp(-f64(g.x) * 0.05, -0.06, 0.06)), f32(clamp((f64(g.y) - 1.0) * -0.015, -0.03, 0.03)), f32(clamp(f64(g.z) * 0.04, -0.05, 0.05)))
    c.ride = approach(c.ride, want, 6.0, dt)
    shake = abs(f64(g.y) - 1.0) + abs(f64(g.x)) * 0.7 + cr.rough * 0.8 + cr.spin * 0.6 + (if f64(g.y) < 0.3: 1.0 else: 0.0)
    c.jolt = max(c.jolt - dt * 0.4, min(shake, 2.0))
    c.act = if c.jolt > 0.55: .crouch else: if cr.still and c.still > 12.0: .loaf else: .sit
    if c.act == .crouch: c.still = 0.0 else: c.still += dt
    c.look = approach(c.look, if c.jolt > 0.55: 0.0 else: sin(t * 0.23 + f64(c.key % 11)) * 0.9, 1.5, dt)
    c.phase = t

# a town cat (or the pilot's own, left in a town or kept by someone): at its spot, by its temper
# and what it knows of him
_town_step = (s: mut CatScene, c: mut Cat, me: CatPilot, cr: CatCraft, bonds: {int: CatBond}, pet: mut CatCompanion, minute: int, ground: (f64, f64) -> f64, dt: f64, t: f64):
    if c.mode == CM_LEAP:
        _leap_step(c, cr, ground, dt)
        return
    if c.mode != CM_GROUND: c.mode = CM_GROUND
    player = me.pos
    friend = c.companion or cat_is_friend(bonds, c.key, minute)
    kept = c.companion and pet.with == CAT_KEPT
    dp = _flat(c.pos, player)
    if dp > 20.0: c.sniffed = false
    if dp > CAT_GREET * 2.0: c.greeted = false
    to = c.home
    if friend:
        goal = cat_goal(c, friend, player, me.on_foot, me.anchor, cr.pos)
        c.following = goal.1 and not kept; c.waiting = goal.2 and not kept
        if c.following and c.companion and pet.with == CAT_ROAMING:
            # (its own pilot back in the town: it is with him again)
            cat_rejoin(pet, minute)
            c.trail = []
            return
        if not c.following: c.step = -1
        to = goal.0
        if kept:
            # (kept by someone: it comes over to him, but stays by their door)
            c.following = me.on_foot and dp < 8.0 and _flat(c.home, player) < 10.0
            to = c.home
        if c.waiting and ground(f64(to.x), f64(to.z)) < 0.3:
            # (no quay that far inland: by the anchor itself)
            if let a = me.anchor: to = a + vec3(f32(if c.key % 2 == 0: 0.8 else: -0.8), 0, 0)
        # (come to him: round his legs once, then by him)
        if c.following and dp < 1.3:
            if c.rub > 0.0 and not me.moving:
                _rub_step(c, player, ground, dt)
                return
            if not c.greeted and not me.moving:
                c.greeted = true; c.rub = 3.6; c.rub_a = _yaw_to(player, c.pos)
                return
    else:
        c.following = false; c.waiting = false; c.step = -1
        shy = cat_shy(bonds, c.key, minute)
        if shy and me.on_foot and dp < CAT_SHY:
            # (a wary stranger: up and off a few steps, and watches him from there)
            away = normalize(c.pos.xz - player.xz + vec2(0.001, 0))
            dest = c.pos.xz + away * 1.6
            if f64(length(dest - c.home.xz)) > 8.0: dest = c.home.xz + normalize(dest - c.home.xz) * 8.0
            _walk(c, vec3(dest.x, 0, dest.y), 1.9, ground, dt)
            return
        if shy and dp < 7.0 and _flat(c.pos, c.home) > 0.3:
            # (stays off where it went while he is about)
            _sit_about(c, player, dt, t)
            return
        if c.temper == CAT_BOLD and me.on_foot and dp < 5.0 and not c.sniffed:
            # (a bold one comes over for a look at him, and a sniff)
            if dp > 0.6:
                _walk(c, player, 1.1, ground, dt)
                return
            c.rub += dt
            c.act = .sniff
            c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, player), 6.0, dt)
            if c.rub > 2.2: c.sniffed = true; c.rub = 0.0
            return
    if c.following:
        if _flat(c.pos, player) < 1.1: to = c.pos
        else: to = _next_step(s, c)
    else if _flat(c.pos, to) > 0.3 and not c.waiting and c.trail.len() > 0:
        # (home the way it came)
        to = c.trail[c.trail.len() - 1]
        if _flat(c.pos, to) < 0.5: c.trail.pop()
    d = _flat(c.pos, to)
    if d > 0.25:
        if c.trail.len() == 0 or _flat(c.trail[c.trail.len() - 1], c.pos) > 0.6:
            if c.following and _flat(c.pos, c.home) > 0.5: c.trail.push(c.pos)
            if c.trail.len() > 160: c.trail.remove_at(0)
        _walk(c, to, if d > 4.0: 2.6 else: 1.1, ground, dt)
    else:
        c.still += dt
        if _flat(c.pos, c.home) < 0.3:
            c.trail = []
            c.yaw = approach_angle(c.yaw, c.home_yaw, 3.0, dt)
        else if c.following: c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, player), 4.0, dt)
        else if c.waiting: c.yaw = approach_angle(c.yaw, _yaw_to(c.pos, cr.pos), 3.0, dt)
        # (sits, and now and then lies down for a while)
        c.act = if c.still > 6.0 and ((int(t / 37.0) + c.key) % 3 == 0): .loaf else: .sit

_purr = (s: mut CatScene, t: f64):
    if not s.sound_ready: return
    if s.focus >= 0 and s.doing == 1 and s.timer > 0.5:
        at = s.cats[s.focus].pos + vec3(0, 0.25, 0)
        if s.purr_voice < 0: s.purr_voice = play_at(s.purr, at, 0.0, 6.0, looping = true)
        move_sound(s.purr_voice, at, 0.16 * min(1.0, (s.timer - 0.5) * 2.0), 6.0)
    else if s.purr_voice >= 0:
        stop(s.purr_voice); s.purr_voice = -1

_finish = (s: mut CatScene, bonds: mut {int: CatBond}, pet: mut CatCompanion, minute: int, whole: bool) -> CatNews:
    news = CatNews()
    k = s.focus
    if k < 0: return news
    c = s.cats[k]
    was = cat_is_friend(bonds, c.key, minute)
    if whole or (s.doing == 1 and s.timer > 1.2) or (s.doing == 2 and s.arrived and s.timer > 1.5):
        if s.doing == 2: cat_feed(bonds, c.key, minute) else: cat_stroke(bonds, c.key, minute)
    s.focus = -1; s.doing = 0; s.timer = 0.0; s.arrived = false
    s.cats[k].act = .sit; s.cats[k].still = 0.0
    if not cat_has(pet) and not c.companion and cat_would_adopt(bonds, c.key, minute):
        if cat_adopt(pet, bonds, c.key, c.coat, c.home, minute):
            pet.home = c.home
            s.cats[k].companion = true
            s.cats[k].greeted = true
            news.adopted = true
            news.said = "The {cat_coat_name(c.coat)} cat has decided you are {if cat_is_tom(c.key): "his" else: "hers"}"
            return news
    if not was and cat_is_friend(bonds, c.key, minute): news.said = "The {cat_coat_name(c.coat)} cat has taken to you"
    news

# the nearest cat in reach of p, or -1 (on the ground: not one aboard, in his arms or leaping)
nearest_cat = (s: CatScene, p: vec3, reach: f64 = CAT_REACH) -> int:
    best = -1; bd = reach
    loop k in 0..s.cats.len():
        if s.cats[k].mode != CM_GROUND: continue
        d = _flat(s.cats[k].pos, p)
        if d < bd and abs(f64(s.cats[k].pos.y - p.y)) < 1.2: best = k; bd = d
    best

cat_busy = (s: CatScene) -> bool: s.focus >= 0

# what the card says by a cat: food (a word, "" for none) is offered to a hungry cat; a wary
# stranger can only be offered food (it won't be touched yet)
cat_prompt = (s: CatScene, k: int, bonds: {int: CatBond}, minute: int, food: str) -> str:
    if k < 0 or k >= s.cats.len(): return ""
    c = s.cats[k]
    what = if c.companion: "your cat" else: "the cat"
    if food != "" and cat_hungry(bonds, c.key, minute): return "F  give {what} some {food}"
    if cat_shy(bonds, c.key, minute): return ""
    "F  stroke {what}"

# a stroke (feed false) or a meal begins (food: 0 a fish, 1 something else); returns the way the
# player turns to face the cat
cat_begin = (s: mut CatScene, k: int, feed: bool, player: vec3, food: int = 0) -> f64:
    s.focus = k; s.timer = 0.0; s.arrived = false
    s.doing = if feed: 2 else: 1
    s.food = food
    s.cats[k].idle = 0; s.cats[k].rub = 0.0
    _yaw_to(player, s.cats[k].pos)

# whether the cat being fed has come to the food yet (the pilot holds it out until it has)
cat_food_held = (s: CatScene) -> bool: s.focus >= 0 and s.doing == 2 and not s.arrived

# the player moved off: a stroke (or a meal) long enough still counts
cat_stop = (s: mut CatScene, bonds: mut {int: CatBond}, pet: mut CatCompanion, minute: int) -> CatNews: _finish(s, bonds, pet, minute, false)

# ---- the pilot's own cat: what the game does with it ----

# Left with someone, there: it walks over to them and sits by their door (the spot given).
pet_hand_over = (s: mut CatScene, pet: mut CatCompanion, person: int, place: int, door: vec3, minute: int) -> bool:
    if not cat_leave_with(pet, person, place, door, minute): return false
    k = pet_index(s)
    if k >= 0:
        s.cats[k].home = door; s.cats[k].following = false; s.cats[k].trail = []; s.cats[k].idle = 0
    true

# Collected from them: it comes to him from where it is.
pet_collect = (s: mut CatScene, pet: mut CatCompanion, person: int, minute: int) -> bool:
    if not cat_collect(pet, person, minute): return false
    k = pet_index(s)
    if k >= 0: s.cats[k].greeted = false
    # (not about here: it waits at their door, and comes to him when he passes)
    if k < 0: pet.with = CAT_ROAMING
    true

# Left here on purpose ("stay"): it keeps to the nearest doorstep.
pet_stay_here = (s: mut CatScene, pet: mut CatCompanion, homes: vec4[], minute: int):
    k = pet_index(s)
    if k < 0: return
    spot = _doorstep(homes, s.cats[k].pos)
    cat_leave_alone(pet, spot, minute)
    s.cats[k].home = spot; s.cats[k].following = false; s.cats[k].trail = []

# whether the pilot's own cat is with him and near (for the talk and the cards)
pet_near = (s: CatScene, pet: CatCompanion, p: vec3, reach: f64) -> bool:
    k = pet_index(s)
    k >= 0 and pet.with == CAT_WITH and s.cats[k].mode == CM_GROUND and _flat(s.cats[k].pos, p) < reach

# Into the room with him for the night (when the stay begins: the world's step waits while he sleeps).
pet_to_room = (s: mut CatScene, pet: CatCompanion, p: vec3):
    k = pet_index(s)
    if k < 0 or pet.with != CAT_WITH or s.cats[k].mode != CM_GROUND or _flat(s.cats[k].pos, p) > 30.0: return
    s.cats[k].mode = CM_STAY

pet_aboard = (s: CatScene) -> bool:
    k = pet_index(s)
    k >= 0 and s.cats[k].mode == CM_ABOARD

pet_in_room = (s: CatScene) -> bool:
    k = pet_index(s)
    k >= 0 and s.cats[k].mode == CM_STAY

# (the debug page) a cat beside the pilot, a stranger with no spot of its own; or the pilot's own
# put in the cockpit, as if it had hopped in
cat_spawn_beside = (s: mut CatScene, me: CatPilot, coat: int, key: int, ground: (f64, f64) -> f64) -> int:
    at = _beside(me, ground)
    c = Cat(key, at, me.yaw, at, me.yaw, coat % CAT_COATS)
    c.temper = cat_own_temper(key)
    s.cats.push(c)
    s.cats.len() - 1

pet_put_aboard = (s: mut CatScene, cr: CatCraft):
    k = pet_index(s)
    if k < 0: return
    s.cats[k].mode = CM_ABOARD
    s.cats[k].pos = _craft_point(cr, cr.seat)

# ---- drawing ----

struct CatPose:
    body_y = 0.2
    body_z = 0.0
    pitch = 0.0
    roll = 0.0
    head = 0.0                      # the head's nod (up +)
    legs: f64[] = [0.0, 0.0, 0.0, 0.0]     # front left, front right, hind left, hind right (world tilt, forward +)
    leg_len: f64[] = [1.0, 1.0, 1.0, 1.0]
    leg_w: f64[] = [1.0, 1.0, 1.0, 1.0]   # (thickened: a sitting cat's haunches)
    tail: vec2[] = [vec2(0, 0), vec2(0, 0), vec2(0, 0), vec2(0, 0)]    # each segment's (lift, sweep)
    turn = 0.0                      # (the head turned besides the look: a wash)

cat_pose = (act: CatAct, phase: f64, t: f64, seed: int, speed: f64 = 1.0) -> CatPose:
    p = CatPose()
    w = f64(seed % 100) * 0.13
    match act:
        .walk:
            s = sin(phase)
            # (a trot or a run swings the legs farther, and the back flexes)
            a = if speed > 3.0: 0.85 else: if speed > 1.8: 0.65 else: 0.5
            p.body_y = 0.2 + abs(cos(phase)) * (if speed > 3.0: 0.02 else: 0.008)
            p.pitch = if speed > 3.0: sin(phase * 2.0) * 0.06 else: 0.0
            p.legs = [s * a, -s * a, -s * a, s * a]
            p.tail = [vec2(-0.7, 0), vec2(-0.3, f32(sin(phase * 0.5) * 0.15)), vec2(-0.25, 0), vec2(-0.3, 0)]
        .sit:
            p.pitch = 0.75; p.body_y = 0.165; p.body_z = 0.07
            p.legs = [0.06, 0.06, PI * 0.5, PI * 0.5]
            p.leg_len = [1.45, 1.45, 0.8, 0.8]
            p.leg_w = [1.0, 1.0, 1.8, 1.8]
            p.head = -0.75 + sin(t * 0.4 + w) * 0.05
            flick = if sin(t * 0.7 + w) > 0.85: sin(t * 9.0) * 0.4 else: 0.0
            p.tail = [vec2(1.25, 0.2), vec2(0.35, 0.6), vec2(0.0, f32(0.6 + flick)), vec2(0.0, f32(0.5 + flick))]
        .groom:
            # (sitting, washing: the head down and round to a shoulder, a forepaw up to it)
            p.pitch = 0.75; p.body_y = 0.165; p.body_z = 0.07
            p.legs = [0.06, 0.06 + 0.9 + sin(t * 5.0) * 0.2, PI * 0.5, PI * 0.5]
            p.leg_len = [1.45, 0.9, 0.8, 0.8]
            p.leg_w = [1.0, 1.0, 1.8, 1.8]
            p.head = -0.4 + sin(t * 6.0) * 0.08
            p.turn = 0.9
            p.tail = [vec2(1.25, 0.2), vec2(0.35, 0.6), vec2(0.0, 0.6), vec2(0.0, 0.5)]
        .loaf:
            p.body_y = 0.095
            p.legs = [PI * 0.5, PI * 0.5, PI * 0.5, PI * 0.5]
            p.leg_len = [0.55, 0.55, 0.55, 0.55]
            p.head = 0.05 + sin(t * 0.3 + w) * 0.04
            p.tail = [vec2(0.45, 0.4), vec2(0.0, 0.55), vec2(0.0, 0.5), vec2(0.0, f32(0.4 + sin(t * 0.5 + w) * 0.15))]
        .curl:
            # (asleep, curled round: low and rounded, the head down on the paws, the tail round)
            p.body_y = 0.085; p.roll = 0.35
            p.legs = [PI * 0.5, PI * 0.5, PI * 0.5, PI * 0.5]
            p.leg_len = [0.5, 0.5, 0.5, 0.5]
            p.head = -0.25 + sin(t * 1.2) * 0.01
            p.turn = 0.7
            p.tail = [vec2(0.3, 1.0), vec2(0.0, 0.9), vec2(0.0, 0.8), vec2(0.0, 0.7)]
        .crouch:
            # (low, ears and belly down: creeping up to food, or holding on through a bump)
            s = sin(phase)
            p.body_y = 0.12; p.pitch = -0.05
            p.legs = [0.35 + s * 0.2, 0.35 - s * 0.2, -0.5 - s * 0.15, -0.5 + s * 0.15]
            p.leg_len = [0.75, 0.75, 0.7, 0.7]
            p.head = -0.15
            p.tail = [vec2(0.15, 0), vec2(0.05, 0.05), vec2(0.0, 0.0), vec2(0.0, 0.0)]
        .sniff:
            # (standing, the nose down to something, the tail level)
            p.pitch = -0.12; p.body_y = 0.2
            p.head = -0.9 + sin(t * 7.0) * 0.05
            p.legs = [0.2, 0.15, 0.0, 0.0]
            p.tail = [vec2(-0.9, 0), vec2(-0.2, f32(sin(t * 1.1 + w) * 0.25)), vec2(-0.2, 0), vec2(-0.1, 0)]
        .stretch:
            # (forelegs out in front, chest down, rump up, the tail up)
            p.pitch = -0.32; p.body_y = 0.16; p.body_z = -0.03
            p.legs = [1.05, 1.0, -0.15, -0.15]
            p.leg_len = [0.9, 0.9, 1.1, 1.1]
            p.head = 0.25
            p.tail = [vec2(-1.2, 0), vec2(-0.1, 0), vec2(-0.2, 0), vec2(-0.3, 0)]
        .leap:
            # (stretched out, forelegs reaching ahead, hind legs back; tucking up at the end)
            u = clamp(phase, 0.0, 1.0)
            p.body_y = 0.15; p.pitch = 0.35 - u * 0.7
            p.legs = [0.9 - u * 0.6, 0.9 - u * 0.6, -0.9 + u * 0.5, -0.9 + u * 0.5]
            p.head = 0.1
            p.tail = [vec2(-0.3, 0), vec2(-0.1, 0), vec2(0.0, 0), vec2(0.1, 0)]
        .lean:
            # (standing, pushing its head up into the hand, rubbing side to side, tail high)
            p.pitch = 0.14; p.body_y = 0.21
            p.roll = sin(t * 1.7) * 0.13
            p.head = 0.5 + sin(t * 1.7 + 0.8) * 0.12
            p.legs = [-0.1, -0.1, 0.05, 0.05]
            q = sin(t * 17.0) * 0.06
            p.tail = [vec2(-1.45, 0), vec2(0.05, f32(q)), vec2(-0.35, f32(q)), vec2(-0.6, f32(q * 2.0))]
        .eat:
            p.pitch = -0.18; p.body_y = 0.19
            p.head = -0.65 + abs(sin(t * 6.5)) * 0.14
            p.legs = [0.18, 0.18, 0.0, 0.0]
            p.leg_len = [0.92, 0.92, 1.0, 1.0]
            p.tail = [vec2(0.25, 0), vec2(0.0, f32(sin(t * 1.3) * 0.3)), vec2(0.0, f32(sin(t * 1.3 + 0.6) * 0.3)), vec2(-0.2, 0)]
    p

# a cat drawn about `base` (in render space: its feet, nose toward -z); `ride` sways it in a seat
draw_cat_at = (m: CatMeshes, c: Cat, base: mat4, P: (mat4) -> ObjParams, t: f64, eating: f64 = 0.0, food: int = 0):
    p = cat_pose(c.act, c.phase, t, c.key, c.speed)
    coat = c.coat % CAT_COATS
    body = base * translation(vec3(0, f32(p.body_y), f32(p.body_z))) * rotation_x(p.pitch) * rotation_z(p.roll)
    draw(obj_sh, m.body[coat], P(body))
    head = body * translation(vec3(0, 0.06, -0.19)) * rotation_x(-p.pitch * 0.5) * rotation_y(c.look + p.turn * (if c.key % 2 == 0: 1.0 else: -1.0)) * rotation_x(p.head + p.pitch * 0.5)
    draw(obj_sh, m.head[coat], P(head))
    attach = [vec3(-0.05, -0.035, -0.13), vec3(0.05, -0.035, -0.13), vec3(-0.05, -0.035, 0.13), vec3(0.05, -0.035, 0.13)]
    loop k in 0..4:
        leg = body * translation(attach[k]) * rotation_z(-p.roll) * rotation_x(-p.pitch + p.legs[k]) * scaling(vec3(f32(p.leg_w[k]), f32(p.leg_len[k]), f32(p.leg_w[k] * 1.3 - 0.3)))
        draw(obj_sh, m.leg[coat], P(leg))
    seg = body * translation(vec3(0, 0.035, 0.185)) * rotation_x(-p.pitch)
    loop k in 0..4:
        seg = seg * rotation_x(f64(p.tail[k].x)) * rotation_y(f64(p.tail[k].y) * (if c.key % 2 == 0: 1.0 else: -1.0))
        draw(obj_sh, m.tail[coat], P(seg))
        seg = seg * translation(vec3(0, 0, 0.08))
    if eating > 0.0:
        # (what he set down before it, going as it eats)
        bit = base * translation(vec3(0, 0.005, -0.3)) * rotation_y(0.6) * scaling(f64(eating) * 1.4)
        draw(obj_sh, if food == 1: m.crust else: m.fish, P(bit))

draw_cat = (m: CatMeshes, c: Cat, L: Light, t: f64, eating: f64 = 0.0, food: int = 0):
    origin = render_origin(scene_camera())
    draw_cat_at(m, c, render_model(translation(c.pos) * rotation_y(c.yaw + PI), origin), (q: mat4) -> ObjParams: obj_local_params(L, t, q), t, eating, food)

# where the food is in his hand as he crouches and holds it out (his right hand, low before him)
cat_hand_at = (pos: vec3, yaw: f64) -> vec3:
    fwd = vec3(f32(sin(yaw)), 0, f32(cos(yaw)))
    right = vec3(f32(-cos(yaw)), 0, f32(sin(yaw)))
    pos + fwd * 0.58 + right * 0.16 + vec3(0, 0.36, 0)

# every cat on the ground or leaping in the world; the one aboard in the cockpit, about the
# aircraft's own drawing (craft_at, render space, as the aircraft is drawn)
draw_cats = (s: CatScene, L: Light, t: f64):
    if not s.ready: return
    cam = scene_camera()
    origin = render_origin(cam)
    loop k in 0..s.cats.len():
        c = s.cats[k]
        if c.mode == CM_STAY or c.mode == CM_ARMS: continue
        if c.mode == CM_ABOARD: continue
        if length(c.pos - cam) > CAT_DRAWN: continue
        eating = if k == s.focus and s.doing == 2 and s.arrived: clamp(1.0 - (s.timer - 0.8) / (CAT_MEAL_TIME - 0.6), 0.0, 1.0) else: 0.0
        draw_cat(s.meshes, c, L, t, eating, s.food)
    # (held out in his hand until the cat has come to it)
    if cat_food_held(s):
        hand = cat_hand_at(s.me_pos, s.me_yaw)
        draw(obj_sh, if s.food == 1: s.meshes.crust else: s.meshes.fish, obj_local_params(L, t, render_model(translation(hand) * rotation_y(s.me_yaw + 1.2) * scaling(1.4), origin)))

# the pilot's own cat in his room for the night: on the bed's foot asleep, else on the rug
# (room-local, about the room's frame; render space handled as the room's own drawing)
draw_stay_cat = (s: CatScene, frame: mat4, at: vec3, yaw: f64, asleep: bool, L: Light, t: f64):
    k = pet_index(s)
    if k < 0 or s.cats[k].mode != CM_STAY: return
    c = s.cats[k]
    c.act = if asleep: .curl else: .loaf
    c.look = 0.0
    draw_cat_at(s.meshes, c, render_model(frame * translation(at) * rotation_y(yaw), render_origin(scene_camera())), (q: mat4) -> ObjParams: obj_local_params(L, t, q), t)

# the pilot's own cat in the cockpit, about its seat there (base: as the cockpit or the aircraft is
# drawn, with P the parameters they are drawn with), swaying as it rides
draw_pet_aboard = (s: CatScene, base: mat4, P: (mat4) -> ObjParams, t: f64):
    k = pet_index(s)
    if k < 0 or s.cats[k].mode != CM_ABOARD: return
    c = s.cats[k]
    draw_cat_at(s.meshes, c, base * translation(c.ride) * rotation_z(f64(c.ride.x) * -2.5) * rotation_x(f64(c.ride.z) * 2.0), P, t)
