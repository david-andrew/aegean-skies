use 'depth_space.jo'
use 'world_point.jo'
use 'render_space.jo'
use 'world_particles.jo'
use 'combat.jo'
# Bounded signs of ordinary traffic: short exhaust histories, sun glints and approach lamps.
use 'traffic.jo'
use 'planes.jo'
use 'objects.jo'
use 'flight.jo'
use 'air_pilot.jo'
use 'combat_trails.jo'
use 'curved_world.jo'
use 'look.jo'
use 'quality.jo'

struct AirCue:
    size = 0.0
    dot = 0.0
    glint = 0.0
    lamp = 0.0

air_cue = (state: CraftState, cam: vec3, sun: vec3, phase: FlightPhase, id: int, t: f64) -> AirCue:
    distance = f64(length(state.position - cam))
    if state.on_water or state.crashed or distance < 400 or distance > 12000: return AirCue()
    view = normalize(cam - state.position); up = quat_rotate(state.orientation, vec3(0, 1, 0))
    half = normalize(view + sun + vec3(0.001, 0, 0))
    flash = pow(max(0.0, f64(dot(up, half))), 48.0) * smoothstep(0.02, 0.2, f64(sun.y))
    night = 1.0 - smoothstep(-0.08, 0.16, f64(sun.y))
    landing = (phase == .land or phase == .descend or phase == .takeoff)
    AirCue(max(0.7, distance * 0.0018), smoothstep(400.0, 1300.0, distance) * (1.0 - night * 0.6), flash,
        if landing: night * pow(max(0.0, f64(dot(forward(state), view))), 12.0) else: 0.0)

struct AirView:
    silhouette: Mesh
    exhaust: BattleTrails
    previous: {int: WorldPoint}
    smoke_clock = 0.0
    spray_clock = 0.0
    spray: WorldParticles = WorldParticles(gravity = vec3(0, -9.8, 0), drag = 1.5)

make_air_view = () -> AirView:
    vs: Vertex3D[]
    col = rgb(0.40, 0.43, 0.43)
    add_box(vs, vec3(0, 0, 0), vec3(0.08, 0.08, 0.9), col)
    add_box(vs, vec3(0, 0.06, -0.12), vec3(1, 0.016, 0.18), rgb(0.65, 0.65, 0.59))
    add_box(vs, vec3(0, 0.015, 0.37), vec3(0.28, 0.014, 0.13), col)
    add_box(vs, vec3(0, 0.07, 0.35), vec3(0.014, 0.14, 0.13), col)
    AirView(silhouette = custom_mesh(vs), exhaust = make_battle_trails())

# One instanced draw replaces full aircraft/prop/gear meshes past 1.8 km. Marks and trails
# supplement this silhouette; they never cause the expensive near model to remain resident.
draw_air_far = (v: AirView, traffic: Traffic[], L: Light, t: f64, battle: Battle = Battle()):
    instances: Instance3D[]; cam = scene_camera();origin=render_origin(cam)
    loop tr in traffic:
        ci = combat_index(battle, tr.craft)
        if battle.enabled and ci >= 0 and battle.actors[ci].present and battle.actors[ci].status != .escaped:
            if not battle.actors[ci].external or battle.actors[ci].last_attacker >= 0: continue
        distance = length(tr.state.position - cam)
        if not tr.visible or distance <= 1800 or distance > 12000: continue
        at = translation(world_local(craft_point(tr.state),origin)) * quat_to_mat4(tr.state.orientation) * scaling(vec3(max(tr.spec.span, f64(distance) * 0.0020), tr.spec.span, max(aircraft_profile(tr.kind).length, f64(distance) * 0.0012)))
        instances.push(Instance3D(at, vec4(1, 1, 1, 1)))
    if instances.len() > 0: draw_world_instanced(obj_inst_sh, v.silhouette, instances, local_instance_params(L, t))

update_air_view = (v: mut AirView, traffic: Traffic[], wind: vec3, cam: vec3, dt: f64):
    step_battle_trails(v.exhaust, wind, dt)
    v.spray.update(dt); v.smoke_clock += dt; v.spray_clock += dt
    interval = if render_quality.tier == 0: 0.55 else: 0.3
    smoke = v.smoke_clock >= interval; spray = v.spray_clock >= 0.05
    if smoke: v.smoke_clock = v.smoke_clock % interval
    if spray: v.spray_clock = v.spray_clock % 0.05
    next: {int: WorldPoint}
    loop tr in traffic:
        distance = length(tr.state.position - cam)
        if not tr.visible or distance > 12000: continue
        s = tr.state
        at = craft_offset(s,-forward(s) * f32(aircraft_profile(tr.kind).length * 0.2))
        if smoke:
            next[tr.craft] = at
            if not s.on_water and s.throttle > 0.3 and not s.crashed:
                if let old = v.previous.get(tr.craft):
                    # A lease/route handoff must not draw a line across a teleport or a whole bay.
                    if length(world_delta(at,old)) < max(200.0, length(s.velocity) * f32(interval * 2.0)):
                        push_battle_ribbon(v.exhaust, BattleRibbon(old, at, 0, 7.0, max(0.6, f64(distance) * 0.0009), 0.55, 0.22), if render_quality.tier == 0: 256 else: 768)
        if spray and s.on_water and not s.moored and distance < 1000 and length(s.velocity) > 4:
            speed = f64(length(s.velocity)); count = if speed > 25: 2 else: 1
            loop side in [-1.0, 1.0]:
                if v.spray.items.len() >= (if render_quality.tier == 0: 160 else: 480): break
                p = craft_offset(s,quat_rotate(s.orientation, vec3(side * tr.spec.span * 0.14, -tr.spec.float_height, -aircraft_profile(tr.kind).length * 0.15))); p.y = 0.15
                dir = normalize(quat_rotate(s.orientation, vec3(side, 0.8, 0)) + vec3(0, 0.3, 0))
                emit(v.spray, p, count, min(12.0, speed * 0.18), rgba(0.95, 0.97, 1, 0.72), 0.85, 0.65, 0.5, dir)
    if smoke: v.previous = next

draw_air_view = (v: AirView, traffic: Traffic[], L: Light, t: f64):
    if v.exhaust.ribbons.len() > 0: draw_custom((): draw_battle_trails(v.exhaust), transparent = true)
    draw_curved_particles(v.spray, false)
    lights = WorldParticles(); cam = scene_camera()
    loop tr in traffic:
        if not tr.visible: continue
        cue = air_cue(tr.state, cam, L.sun_dir, if tr.flying and not tr.materialized: FlightPhase.cruise else: tr.plan.phase, tr.craft, t)
        if cue.glint > 0.03 or cue.lamp > 0.03:
            light = max(cue.glint, cue.lamp)
            point=craft_offset(tr.state,forward(tr.state)*f32(aircraft_profile(tr.kind).length*0.6))
            lights.items.push(WorldParticle(world_vec(point), vec3(0, 0, 0), 1, 1, f32(cue.size * (1.0 + light * 1.5)), rgba(1, 0.91, 0.65, f32(light * 0.85)),precise=point,published=world_vec(point),ready=true))
    draw_curved_particles(lights, true)
