# Recorded beds: the talk of a busy harbour, of a few people about a square, of a full bar, and a
# river, each edited from recordings into a seamless 30 s loop (assets/ambience/; sources and
# credits in docs/CREDITS.md). Streamed as they play (no wait to decode, little memory) and placed
# like any ambience voice. A bed that won't open is silent.
use 'ambience_synth.jo'

AMBIENCE_BED_KINDS = [AmbienceKind.murmur,.chatter,.cafe,.river]
ambience_bed_files = () -> u8[][]: [embed('../assets/ambience/harbour.ogg'),embed('../assets/ambience/village.ogg'),embed('../assets/ambience/bar.ogg'),embed('../assets/ambience/river.ogg')]
ambience_bed_index = (kind: AmbienceKind) -> int:
    loop k in 0.. and bed in AMBIENCE_BED_KINDS:
        if bed == kind: return k
    -1
