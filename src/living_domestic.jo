# Domestic destinations are actual published fixtures. Missing geometry leaves
# the ordinary routine alone; no actor, stock, wage or production is invented.
use 'living_types.jo'
use 'life_types.jo'
use 'living_life_seed.jo'

domestic_kind = (kind: VenueKind) -> bool: kind==.seat or kind==.laundry or kind==.oven
domestic_activity = (kind: VenueKind) -> LifeActivity: if kind==.seat: LifeActivity.sit else: if kind==.laundry: LifeActivity.wash else: LifeActivity.bake

nearest_domestic = (venues: LifeVenue[],place: int,kind: VenueKind,home: vec3) -> LifeVenue?:
    found: LifeVenue? = none; distance=80.0
    loop v in venues:
        if v.place!=place or v.kind!=kind: continue
        d=f64(length(v.pos-home))
        if d<distance or d==distance and found!=none and v.key<found!.key:
            found=v; distance=d
    found

core_domestic = (w: World,person: int,kind: VenueKind) -> LifeVenue?:
    p=w.people[person]
    if p.place!=p.home or p.home<0: return none
    home=choose_life_venue(w,p.home,.home,person)
    if home==none: return none
    available: LifeVenue[]
    loop v in w.life_venues:
        if v.place!=p.place or v.kind!=kind: continue
        occupied=false
        loop other,intent in w.daily_life:
            if other<person and w.people[other].place==p.place and intent.anchor==v.key and domestic_kind(intent.venue): occupied=true; break
        if not occupied: available.push(v)
    nearest_domestic(available,p.place,kind,home!.pos)

active_domestic = (w: World,person: int) -> LifeVenue?:
    p=w.people[person]
    if person_vehicle_bound(w,person) or person_has_load(w,person): return none
    key=""; venues: LifeVenue[]
    if p.far_home>=0:
        if not (person in w.far.people) or not (p.far_place in w.place_contexts): return none
        a=w.far.people[person]
        if length(p.pose.pos-a.target)>0.3: return none
        key=a.anchor; venues=w.place_contexts[p.far_place].venues
    else:
        if not (person in w.daily_life) or not w.daily_life[person].arrived: return none
        intent=w.daily_life[person]
        if not domestic_kind(intent.venue): return none
        key=intent.anchor; venues=w.life_venues
    loop v in venues:
        if v.key==key and domestic_kind(v.kind): return v
    none
