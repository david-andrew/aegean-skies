use 'settlement_ports.jo'
use 'render_space.jo'
# The player at the controls: keys to controls for the flight model, the chase camera, and the
# business of the water (casting off, mooring at a dock, climbing out), with spray off the floats.
#
# Keys (after Sky Barons): W dives and S climbs, A and D roll, Q and E the rudder (on the water,
# A and D steer too), Shift opens the throttle and Z closes it, Space brakes on the water, F moors
# beside a dock and climbs out.

use 'look.jo'
use 'weather_scene.jo'
use 'world.jo'
use 'planes.jo'
from 'aircraft_boats.jo' import boat_spray_scale
from 'air_classes.jo' import air_class_of, AirClass
use 'flight.jo'
use 'flight_ground.jo'
use 'touch.jo'
use 'controller.jo'
use 'motion.jo'
use 'options.jo'
use 'tweaks.jo'
use 'objects.jo'
use 'trails.jo'
use 'sea.jo'
use 'flight_feedback.jo'
use 'damage.jo'
use 'frame_budget.jo'
use 'flight_instruments.jo'
use 'ui_state.jo'

# (the chase camera rises as it falls back with speed: the pause menu's switch)
camera_rises = false
set_camera_rises = (on: bool):
    global camera_rises
    camera_rises = on

struct TargetChaseFrame:
    ready = false
    view = vec3(0,0,-1)
    up = vec3(0,1,0)

struct ChaseCamera:
    eye: WorldPoint
    view: vec3
    up: vec3

struct Flyer:
    kind: Craft
    model: int                      # which built model draws it
    spec: CraftSpec
    state: CraftState
    throttle = 0.0                  # lever -1..1: negative is air brake, engine follows positive
    cockpit_view = false
    guns_locked = true
    safety_zone = false
    gear_down = false
    clutch_hand = false             # (a hydrofoil craft: the pilot clutches the air propeller in by hand, once)
    cam_point = WorldPoint()
    cam_ready = false
    cam_pos: vec3
    cam_fwd: vec3 = vec3(0, 0, -1)
    cam_up: vec3 = vec3(0, 1, 0)
    target_frame = TargetChaseFrame()
    target_camera_time = -1.0
    camera_clearance = 1.0
    cam_lh = 0.0
    look_yaw = 0.0                  # (looking around while flying: offsets about the aircraft)
    look_pitch = 0.0
    look_return = false             # (the mouse looking: the view easing back to straight ahead)
    look_locked = false             # (and whether the game had the mouse last frame: let go, the view returns)
    pad_look = false                # (a controller's right stick turned the view: let go, it returns)
    slow = false                    # (on the water or below the stall: the mouse may orbit the camera)
    orbiting = false                # (and it has: the mouse moved while slow)
    orbit_yaw = 0.0                 # (the orbit: which way from the aircraft, how high, how far;
    orbit_pitch = 0.32              # fixed to the world, not the aircraft, so it holds still while
    orbit_dist = 30.0               # one taxis about)
    orbit_w = 0.0                   # (how far the camera has gone over to the orbit)
    sea_t = 0.0                     # (the sea's clock: the game's time)
    prop_angle = 0.0
    placed = false                  # (the camera has been put somewhere yet)
    aim_heading = 0.0               # where the mouse asks it to fly (heading, and climb angle)
    aim_climb = 0.0
    trim = 0.0                      # the attitude the keys left it at (kept when they are let go)
    keys_held = false
    last: Controls = Controls()
    aim_seen: vec3 = vec3(0, 0, 0)  # (the aim last frame, and how fast it moves, smoothed: led by the
    aim_rate: vec3 = vec3(0, 0, 0)  # v2 steering so a moving target is followed, not chased)
    fighting = false                # the guns in use or a target's lead shown: the steering aims the nose
    fov = 62.0
    shake = 0.0                     # the buffet now (0..1)
    wreck_cam = false               # (the camera stopped dead when it was wrecked)
    jolt = 0.0                      # (the camera's shake from that, dying away)
    # The pilot's head jostled against the airframe by its jolts (head_step): offset in the
    # craft's frame (m: right, up, back) and turn (rad: pitch, yaw, roll), springing back.
    head_pos: vec3 = vec3(0, 0, 0)
    head_vel: vec3 = vec3(0, 0, 0)
    head_rot: vec3 = vec3(0, 0, 0)
    head_spin: vec3 = vec3(0, 0, 0)
    head_v: vec3 = vec3(0, 0, 0)
    head_w: vec3 = vec3(0, 0, 0)
    head_fwd: vec3 = vec3(0, 0, -1)
    head_right: vec3 = vec3(1, 0, 0)
    head_rough = 0.0
    head_ready = false
    load = 1.0                      # how many g the wings pull (smoothed)
    prev_dir: vec3 = vec3(0, 0, -1)
    last_speed = 0.0
    surge = 0.0                     # the felt acceleration, smoothed
    mouse_mode = false              # the mouse is in charge (else the keys)
    # (the chase camera's state: the smoothed way of travel, the spring's offset and its rate in
    # that frame, the aircraft's smoothed acceleration, where it looks, its roll)
    path: vec3 = vec3(0, 0, -1)
    cam_e: vec3 = vec3(0, 0, 0)
    cam_ev: vec3 = vec3(0, 0, 0)
    prev_vel: vec3 = vec3(0, 0, 0)
    acc_lp: vec3 = vec3(0, 0, 0)
    look: vec3 = vec3(0, 0, -1)
    cam_aim: vec3 = vec3(0, 0, -1)  # (on a touch screen: the view's way, following the aim quickly)
    look_v: vec3 = vec3(0, 0, 0)
    roll = 0.0
    a_fast = 0.0
    a_slow = 0.0
    feedback: FlightFeedback = FlightFeedback()
    instruments: FlightInstruments = FlightInstruments()
    cam_vel: vec3 = vec3(0, 0, 0)   # the camera's own motion (it rides a spring behind the aircraft)
    # (the frame last drawn from, whichever camera drew it: the mouse and drag move the aim in it)
    screen_view: vec3 = vec3(0, 0, -1)
    screen_up: vec3 = vec3(0, 1, 0)
    screen_ready = false

make_flyer = (kind: Craft, model: int, contacts: vec3[], dock: vec3, heading: f64) -> Flyer:
    spec = craft_spec(kind, contacts)
    st = water_start(spec, dock, heading)
    moor(st, st.position, heading)
    Flyer(kind, model, spec, st, cam_pos = st.position)

# Solid built things an aircraft can strike: the canal's bridges and quays, the airfields' hangars.
_scene_solid = (a: vec3, b: vec3) -> vec4:
    hit = canal_sweep(a, b)
    if hit.w > 0.0: return hit
    airfield_solid(a, b)

# The shared saved-weather air field and the same swell the renderer draws.
flight_env = (t: f64, pos: vec3 = vec3(0,0,0)) -> FlightEnv:
    w = wind_now
    # (the sea the floats meet is the sea that is drawn: its swells, at the game's time)
    FlightEnv(solid = if geography_enabled:_scene_solid else:(a:vec3,b:vec3)->vec4:vec4(0,0,0,0), wind = if weather_active: weather_flight_wind(pos) else: vec3(w.dir.x, 0, w.dir.y) * f32(w.speed * 0.7), turbulence = if weather_active: f64(weather_turbulence(pos)) else: 0.0, wave_height = 0.0, wave_time = 0.0, ground = (x: f64, z: f64) -> f64: flight_surface_height(x, z) + airfield_turf(x, z),
        swell = (x: f64, z: f64) -> vec3: swell_at(x, z, t), has_swell = true, swell_ceiling=max(swell_height_bound(),if geography_enabled and water_at(f64(pos.x),f64(pos.z)).found:water_at(f64(pos.x),f64(pos.z)).level+2.0 else:0.0), current_at = (x:f64,z:f64)->vec3: if geography_enabled:water_current(x,z) else:vec3(0,0,0))

# where the aircraft is pointing: its heading and how far its nose is above the horizon
_attitude = (st: CraftState) -> (f64, f64, f64):
    f = quat_rotate(st.orientation, vec3(0, 0, -1))
    r = quat_rotate(st.orientation, vec3(1, 0, 0))
    u = quat_rotate(st.orientation, vec3(0, 1, 0))
    (heading(st), asin(clamp(f64(f.y), -1.0, 1.0)), atan2(-f64(r.y), f64(u.y)))

# the way the mouse asks to fly
aim_gust = (f: mut Flyer):
    f.aim_heading += f64(f.state.gust_turn.x)
    f.aim_climb = clamp(f.aim_climb + f64(f.state.gust_turn.y), -1.5, 1.5)

aim_dir = (f: Flyer) -> vec3:
    cp = cos(f.aim_climb)
    vec3(f32(sin(f.aim_heading) * cp), f32(sin(f.aim_climb)), f32(-cos(f.aim_heading) * cp))

# The mouse or a drag moves the aim ring the way it moved on the screen, whichever way the view
# faces or rolls (a target view looking aft, a camera carried over the top of a loop). The aim is
# pushed along the drawn frame's right and up, so a ring behind the eye moves the same way too.
# `turn` is in radians (x right, y down); climb stays inside low..high without going over a pole.
screen_aim = (f: mut Flyer, turn: vec2, low: f64 = -1.55, high: f64 = 1.55):
    a = aim_dir(f)
    view = if f.screen_ready: normalize(f.screen_view) else: a
    up = if f.screen_ready: f.screen_up else: vec3(0, 1, 0)
    right = cross(view, up)
    if length(right) < 0.001: right = cross(view, if abs(view.y) < 0.9: vec3(0, 1, 0) else: vec3(0, 0, 1))
    right = normalize(right)
    up = normalize(cross(right, view))
    # (a step along the great circle toward that screen direction's vanishing point: straight
    # along the screen wherever the ring is drawn, at an even angular rate, never past it)
    push = right * f32(turn.x) - up * f32(turn.y)
    amount = f64(length(push))
    if amount < 1e-9: return
    goal = push / f32(amount)
    across = goal - a * dot(a, goal)
    if length(across) < 0.000001: return
    across = normalize(across)
    angle = min(amount, acos(clamp(f64(dot(a, goal)), -1.0, 1.0)))
    moved = normalize(a * f32(cos(angle)) + across * f32(sin(angle)))
    flat = vec2(moved.x, moved.z)
    old = vec2(f32(sin(f.aim_heading)), f32(-cos(f.aim_heading)))
    climb = asin(clamp(f64(moved.y), -1.0, 1.0))
    # (over the top or under the bottom: hold the heading, stop at the limit)
    if length(flat) > 0.02 and dot(flat, old) > 0.0: f.aim_heading = atan2(f64(flat.x), -f64(flat.y))
    else: climb = if moved.y > 0: high else: low
    f.aim_climb = clamp(climb, low, high)

# The drawn camera's axes, from the view matrix in use (cockpit or any other camera).
remember_screen_axes = (f: mut Flyer):
    v = __view
    right = vec3(v[0].x, v[1].x, v[2].x)
    up = vec3(v[0].y, v[1].y, v[2].y)
    if length(right) < 0.5 or length(up) < 0.5: return
    f.screen_view = normalize(cross(up, right))
    f.screen_up = normalize(up)
    f.screen_ready = true

# Pure mapping also used by tests and future lever UI. No reverse engine thrust.
lever_controls = (lever: f64, gear: bool = false) -> Controls:
    Controls(throttle=clamp(lever,0.0,1.0),airbrake=clamp(-lever,0.0,1.0),gear=gear)

# Entering a protected area engages the safety once; an explicit unlock is always deliberate.
gun_safety = (f: mut Flyer, protected: bool, toggle: bool):
    if protected and not f.safety_zone: f.guns_locked=true
    f.safety_zone=protected
    if toggle:f.guns_locked=not f.guns_locked

# (a gamepad's left stick steering the aim: how fast it turns the aim pushed right over, rad/s; its
# curve gives the fine end)
const PAD_AIM_RATE = 1.4

# the controls, in two ways that do not fight: move the mouse (captured) and it is in charge, the
# aircraft steering to where it points (Sky Barons' steer), keys adding to it while held; touch a
# key and the keys are in charge, flying the aircraft directly with nothing steering it back, the
# aim following the nose until the mouse moves again.
# (`moved`: the mouse's movement added to the real one: tests)
key_controls = (f: mut Flyer, dt: f64, moved: vec2 = vec2(0, 0)) -> Controls:
    up = (k: Key) -> f64: if vdown(k): 1.0 else: 0.0
    if vdown(.shift): f.throttle = min(1.0, f.throttle + dt * 0.6)
    if vdown(.z): f.throttle = max(-1.0, f.throttle - dt * 0.6)
    st = f.state
    hd, pitch, bank = _attitude(st)
    kp = up(.s) + up(.down) - up(.w) - up(.up)
    kr = up(.d) + up(.right) - up(.a) - up(.left)
    # (the touch screen's throttle slider)
    if pad.throttle_want >= 0.0: f.throttle = pad.throttle_want
    ky = up(.e) - up(.q)
    # (a gamepad or a flight stick: its stick, rudder and throttle, analog, added to the keys';
    # src/controller.jo)
    analog = ctl.flying
    # (a gamepad in the air, as the Controls page has it by default: its left stick steers the aim at a
    # rate, as far as it is pushed, the aircraft flown to it as the mouse's and a finger's are, so a
    # nudge is a small, settled correction with the rudder; the bumpers still add rudder. A flight
    # stick, and a gamepad on the water, fly her directly)
    pad_aim = ctl.connected and not ctl.stick and options.controls.pad_aims and not st.on_water
    pad_turn = vec2(0, 0)
    if ctl.connected:
        if pad_aim:
            pad_turn = vec2(f32(ctl.roll), f32(-ctl.pitch)) * f32(PAD_AIM_RATE * dt / 0.0025)
            analog = false
        else:
            kp = clamp(kp + ctl.pitch, -1.0, 1.0)
            kr = clamp(kr + ctl.roll, -1.0, 1.0)
        ky = clamp(ky + ctl.yaw, -1.0, 1.0)
        if ctl.throttle_rate != 0.0: f.throttle = clamp(f.throttle + ctl.throttle_rate * dt * 0.6, -1.0, 1.0)
        if ctl.lever_moved: f.throttle = ctl.lever
    c = lever_controls(f.throttle,f.gear_down)
    c.throttle = max(0.0,f.throttle)
    # (the mouse looks around while the right button or C is held; and always when slow, on the
    # water or below the stall, the keys steering: coming into a harbor one can see where one is
    # going. The view stays where it was put until flying again, then swings back behind)
    # (on a touch screen, as in Sky Barons: a finger dragged turns the aim, and the view with it)
    md = (if is_mouse_locked(): mouse_delta() else: vec2(0, 0)) + pad.aim * 2.4 + moved
    # (tilting the phone nudges the aim: degrees turned, as far as the gain says; the drag and the
    # mouse turn it 0.0025 rad a unit)
    if options.tilt_aim:
        motion_start()
        tilt = motion_take()
        md = md + vec2(tilt.x, -tilt.y) * f32(options.tilt_gain * (PI / 180.0) / 0.0025)
    if options.invert_y: md.y = -md.y
    # (the Options page's "Mouse steers the aircraft" off: the mouse only looks, in the cockpit a
    # turn of the head, outside an orbit about the aircraft, within src/head_look.jo's limits; the
    # keys and a gamepad fly. Home or the middle button brings the view back ahead, as does letting
    # the mouse go. A touch screen is as it was)
    look_only = not options.mouse_steers and not pad.on
    if look_only:
        locked = is_mouse_locked()
        back = mouse_pressed(.middle) or vpressed(.home) or (f.look_locked and not locked)
        f.look_locked = locked
        f.mouse_mode = false
        if f.cockpit_view:
            # (in the cockpit: a turn of the head, within src/head_look.jo's limits)
            lim = look_limits(f.kind, f.cockpit_view)
            if back: f.look_return = true
            if length(md) > 0.5: f.look_return = false
            f.look_yaw -= f64(md.x) * 0.004
            f.look_pitch -= f64(md.y) * 0.004
            if f.look_return:
                k = 1.0 - exp(-5.0 * dt)
                f.look_yaw -= atan2(sin(f.look_yaw), cos(f.look_yaw)) * k
                f.look_pitch -= f.look_pitch * k
                if abs(f.look_yaw) + abs(f.look_pitch) < 0.002: f.look_yaw = 0.0; f.look_pitch = 0.0; f.look_return = false
            held = limit_look(f.look_yaw, f.look_pitch, lim)
            f.look_yaw = held.0; f.look_pitch = held.1
            md = vec2(0, 0)
            f.orbiting = false
        else:
            # (outside: the taxiing orbit about the aircraft, at any speed (below); Home, the middle
            # button or letting the mouse go hands the view back to the follow camera)
            # (a controller's right stick turns the follow view itself: below)
            if not f.pad_look: f.look_yaw = 0.0; f.look_pitch = 0.0; f.look_return = false
            if back: f.orbiting = false
    # (a controller's right stick or hat: the view turned as far as it is pushed, in the cockpit a
    # turn of the head, outside the follow view about the aircraft; let go, it eases back ahead)
    if length(ctl.look) > 0.0:
        lim = look_limits(f.kind, f.cockpit_view)
        want_yaw = -f64(ctl.look.x) * (if lim.wrap: PI * 0.95 else: lim.yaw)
        want_pitch = -f64(ctl.look.y) * (if ctl.look.y < 0: lim.up else: lim.down)
        k = 1.0 - exp(-10.0 * dt)
        f.look_yaw += (want_yaw - f.look_yaw) * k
        f.look_pitch += (want_pitch - f.look_pitch) * k
        f.look_return = false
        f.pad_look = true
    else if f.pad_look:
        k = 1.0 - exp(-6.0 * dt)
        f.look_yaw -= atan2(sin(f.look_yaw), cos(f.look_yaw)) * k
        f.look_pitch -= f.look_pitch * k
        if abs(f.look_yaw) + abs(f.look_pitch) < 0.002: f.look_yaw = 0.0; f.look_pitch = 0.0; f.pad_look = false
    # (on the water or tied up: taxiing, where the mouse orbits the view; with the mouse only
    # looking, outside the cockpit, the same orbit in the air too)
    slow = st.on_water or st.moored or st.on_ground
    if (slow or (look_only and not f.cockpit_view)) and tweaks.orbit_camera and not pad.on:
        # (a trial, Tweaks: moving the mouse while slow takes the camera off the follow to an orbit about the
        # aircraft, as the camera on foot: the mouse turns it about and up and down the same way,
        # the wheel brings it nearer or farther; it starts where the follow camera was)
        if not f.orbiting and length(md) > 0.5:
            f.orbiting = true
            rel = world_delta(if f.cam_ready:f.cam_point else:world_point(f.cam_pos),craft_point(st))
            f.orbit_yaw = atan2(f64(rel.x), -f64(rel.z))
            f.orbit_pitch = clamp(asin(clamp(f64(rel.y) / max(f64(length(rel)), 0.1), -1.0, 1.0)), -0.05, 1.35)
            f.orbit_dist = clamp(f64(length(rel)), 9.0, 90.0)
        if f.orbiting:
            f.orbit_yaw += f64(md.x) * 0.004
            f.orbit_pitch = clamp(f.orbit_pitch + f64(md.y) * 0.004, -0.05, 1.35)
            f.orbit_dist = clamp(f.orbit_dist * wheel_zoom(), 9.0, 90.0)
        md = vec2(0, 0)
    else: f.orbiting = false
    f.slow = slow
    # (as it was: slow, the mouse looks around the aircraft)
    looking = mouse_down(.right) or (slow and not tweaks.orbit_camera) or f.pad_look
    if not options.mouse_steers and not pad.on: pass
    else if looking:
        f.look_yaw = clamp(f.look_yaw - f64(md.x) * 0.004, -PI, PI)
        f.look_pitch = clamp(f.look_pitch - f64(md.y) * 0.004, -1.2, 1.2)
        md = vec2(0, 0)
    else:
        k = 1.0 - exp(-4.0 * dt)
        f.look_yaw -= f.look_yaw * k
        f.look_pitch -= f.look_pitch * k
    if st.on_water and pad.on:
        # (on a touch screen, on the water as in the air: the finger turns the aim and the view, and
        # the rudder steers for it; aim above the horizon and she lifts her nose)
        if not f.mouse_mode:
            f.aim_heading = hd
            f.aim_climb = clamp(pitch, -0.2, 0.3)
            f.mouse_mode = true
        screen_aim(f, md * 0.0025, -0.4, 0.6)
        c.yaw = clamp(angle_delta(f.aim_heading, hd) * 2.5 + ky + kr, -1.0, 1.0)
        c.pitch = clamp((f.aim_climb - pitch) * 3.0 + kp, -1.0, 1.0)
        c.water_brake = up(.space)
        c.assist = 0.0
        f.last = c
        return c
    if st.on_water:
        c.pitch = kp
        c.yaw = clamp(ky + kr, -1.0, 1.0)
        c.water_brake = up(.space)
        c.assist = 0.0
        f.aim_heading = hd
        f.aim_climb = clamp(pitch, -0.2, 0.3)
        f.last = c
        return c
    # (otherwise the mouse steers, while the game has it)
    keys = abs(kp) + abs(kr) + abs(ky) > 0.0
    # (on a touch screen the aim is always in charge, as the mouse is when it has been moved)
    if pad.on and not f.mouse_mode and not keys:
        f.aim_heading = hd
        f.aim_climb = pitch
        f.mouse_mode = true
    stick_aims = pad_aim and abs(ctl.pitch) + abs(ctl.roll) > 0.0
    if length(md) > 0.5 or stick_aims:
        if not f.mouse_mode:
            # taking over from the keys: the aim starts where the nose is
            f.aim_heading = hd
            f.aim_climb = pitch
        f.mouse_mode = true
        screen_aim(f, (md + pad_turn) * 0.0025)
    else if keys and not (pad_aim and abs(kp) + abs(kr) + abs(ky - ctl.yaw) == 0.0) and (analog or vpressed(.w) or vpressed(.s) or vpressed(.a) or vpressed(.d) or vpressed(.q) or vpressed(.e) or vpressed(.up) or vpressed(.down) or vpressed(.left) or vpressed(.right)):
        f.mouse_mode = false
    if f.mouse_mode:
        # (the storm's push on the aircraft's heading and climb turns the aim too: the mouse's
        # steering holds it steady, but off course until the pilot brings the aim back)
        aim_gust(f)
        aim_now = aim_dir(f)
        if length(f.aim_seen) > 0.5 and dt > 0.0: f.aim_rate += ((aim_now - f.aim_seen) / f32(dt) - f.aim_rate) * f32(1.0 - exp(-10.0 * dt))
        f.aim_seen = aim_now
        c = steer(f.spec, st, aim_now, f.aim_rate, fighting = f.fighting)
        c.throttle = max(0.0,f.throttle)
        c.airbrake = max(0.0,-f.throttle)
        c.gear = f.gear_down
        if kp != 0.0: c.pitch = clamp(c.pitch + kp, -1.0, 1.0)
        if kr != 0.0: c.roll = clamp(c.roll + kr, -1.0, 1.0)
        if ky != 0.0: c.yaw = clamp(c.yaw + ky, -1.0, 1.0)
    else:
        f.aim_heading = hd
        f.aim_climb = pitch
        f.aim_seen = vec3(0, 0, 0); f.aim_rate = vec3(0, 0, 0)
        c.pitch = kp
        c.roll = kr
        c.yaw = ky
    c.assist = 0.0
    # (the controls ease toward what is asked: a stick is not a switch)
    # (a stick is already smooth: it follows faster than the keys)
    rate = if f.mouse_mode: 30.0 else: if analog: 18.0 else: if tweaks.skybarons_response:9.0 else:7.0
    k = 1.0 - exp(-rate * dt)
    c.pitch = f.last.pitch + (c.pitch - f.last.pitch) * k
    c.roll = f.last.roll + (c.roll - f.last.roll) * k
    c.yaw = f.last.yaw + (c.yaw - f.last.yaw) * k
    f.last = c
    c

# vapor off the wingtips: pulling hard at speed in damp air (morning, evening, near the clouds);
# the two wingtips' trails (strength 0 when there is none)
# how damp the air is where the aircraft is, for its vapour (flight_feedback.jo vapour_dampness)
vapor_damp = (f: Flyer, hour: f64, t: f64) -> f64:
    p=craft_point(f.state)
    over_sea=height(p.x,p.z)<f64(swell_at(p.x,p.z,t).x)
    deck=if weather_active:f64(weather_here.deck) else:0.0
    rain=if weather_active:f64(weather_here.rain) else:0.0
    fog=if weather_active:f64(weather_here.fog) else:0.0
    vapour_dampness(p.y,over_sea,hour,deck,rain,fog)

vapor = (f: Flyer, trails: mut Trail[], hour: f64, t: f64):
    sp = f.feedback.speed
    strength=0.0
    if not f.state.on_water and sp>35.0 and f.load>2.8: strength=vapour_strength(sp,f.load,vapor_damp(f,hour,t))
    # the outermost wingtips: left and right
    tips = f.spec.wing_contacts
    left = tips[0]
    right = tips[0]
    loop p in tips:
        if p.x < left.x: left = p
        if p.x > right.x: right = p
    trail_step(trails[0], craft_offset(f.state,quat_rotate(f.state.orientation,left)), if part_health(f.state.damage,.left_wing) > 0: strength else: 0.0, t)
    trail_step(trails[1], craft_offset(f.state,quat_rotate(f.state.orientation,right)), if part_health(f.state.damage,.right_wing) > 0: strength else: 0.0, t)

# a step of the player's aircraft
fly = (f: mut Flyer, dt: f64, t: f64):
    c = key_controls(f, dt)
    # (the hand clutch is a push: once in, it stays in until she is back at rest; the automatic
    # one works without it)
    c.clutch = f.clutch_hand
    f.clutch_hand = false
    if f.state.moored and f.throttle > 0.05: unmoor(f.state)
    e=flight_env(t,f.state.position)
    if not f.state.moored: step(f.spec, f.state, c, e, dt)
    head_step(f, e.turbulence, dt)
    f.prop_angle += dt * prop_rotation_speed(f.state,f.feedback.speed)
    f.sea_t = t
    feel(f, dt,e.wind)

# The head lags the airframe: a quick, damped spring in the craft's frame pushed against each
# jolt the flight model gives it (the body's acceleration moves the head, its angular
# acceleration turns it), so the cockpit knocks against the view on hard hits. Clamped to a
# few centimetres and two degrees; a fine buzz in steady rough air comes with head_shake.
const HEAD_STIFF = 180.0
const HEAD_DAMP = 15.0
head_step = (f: mut Flyer, rough: f64, dt: f64):
    if dt <= 0.0: return
    q = f.state.orientation
    fwd = quat_rotate(q, vec3(0, 0, -1)); up = quat_rotate(q, vec3(0, 1, 0)); right = quat_rotate(q, vec3(1, 0, 0))
    acc = (f.state.velocity - f.head_v) / f32(dt)
    # (a teleport, a load or a crash is not a jolt: start again from rest)
    if not f.head_ready or length(acc) > 300.0 or f.state.crashed:
        f.head_pos = vec3(0, 0, 0); f.head_vel = vec3(0, 0, 0); f.head_rot = vec3(0, 0, 0); f.head_spin = vec3(0, 0, 0)
        f.head_w = vec3(0, 0, 0)
    else:
        body = vec3(dot(acc, right), dot(acc, up), -dot(acc, fwd))
        w = vec3(dot(f.head_fwd, up), -dot(f.head_fwd, right), dot(f.head_right, up)) / f32(dt)
        alpha = (w - f.head_w) / f32(dt)
        f.head_w = w
        # (in a storm's cell the head is thrown much harder, enough to blur the panel; ordinary
        # rough air stays mild: both grow with the air's roughness)
        storm = f32(clamp(rough, 0.0, 1.0))
        reach = 0.045 + 0.055 * storm; turn = 0.035 + 0.07 * storm
        f.head_vel += (-f.head_pos * f32(HEAD_STIFF) - f.head_vel * f32(HEAD_DAMP) - body * (0.24 + 0.36 * storm)) * f32(dt)
        f.head_pos = clamp(f.head_pos + f.head_vel * f32(dt), vec3(-reach, -reach, -0.03 - 0.03 * storm), vec3(reach, reach, 0.03 + 0.03 * storm))
        f.head_spin += (-f.head_rot * f32(HEAD_STIFF) - f.head_spin * f32(HEAD_DAMP) + alpha * (0.2 + 0.6 * storm)) * f32(dt)
        # (no snap: the head never turns faster than about 115 degrees a second)
        f.head_spin = clamp(f.head_spin, vec3(-2, -2, -2), vec3(2, 2, 2))
        f.head_rot = clamp(f.head_rot + f.head_spin * f32(dt), vec3(-turn, -turn, -turn), vec3(turn, turn, turn))
    f.head_v = f.state.velocity; f.head_fwd = fwd; f.head_right = right; f.head_ready = true
    f.head_rough = rough

# The head's offset and turn now, with a fine buzz in rough air (scale: 1 in the cockpit,
# less from the chase camera).
head_shake = (f: Flyer, t: f64) -> (vec3, vec3):
    b = f32(f.head_rough)
    # (about 8-15 Hz: smooth from frame to frame at 60 Hz, quick enough to blur the gauges;
    # in a storm's cell about one to two degrees)
    buzz = vec3(f32(noise(t * 11.0, 3.0) - 0.5), f32(noise(t * 13.0, 9.0) - 0.5), f32(noise(t * 9.0, 21.0) - 0.5))
    (f.head_pos + buzz * (b * 0.02), f.head_rot + vec3(buzz.y, buzz.z, buzz.x) * (b * 0.09))

craft_transform = (f: Flyer) -> mat4: translation(f.state.position) * quat_to_mat4(f.state.orientation)

# how far behind and above the camera sits, by the size of the aircraft
_cam_offset = (kind: Craft) -> vec2:
    if int(kind) < 4: return if kind == .heron: vec2(26,7) else: vec2(16,4.5)
    p = aircraft_profile(kind)
    vec2(max(16.0, p.span * 1.6), max(4.5, p.span * 0.4))

# the chase camera: behind the aircraft in a smoothed frame of it, the horizon kept level
# The chase camera (after the research in docs: the speed of the view is the ground's flow, its
# speed over the camera's height above it; and acceleration, not speed, is what is felt):
# - it rests at an anchor behind the aircraft in a frame along its path, high when the aircraft is
#   high, and low over the water (two meters up) when it skims it;
# - it hangs from that anchor on a spring along each axis, pushed by the aircraft's real
#   acceleration: back when it surges, out in a turn, a dip at a slam, nothing at a steady speed;
# - it looks ahead along the path, leading into turns, rolling a fifth of the bank.
_cam_shape = (kind: Craft) -> vec4:
    if int(kind) >= 4:
        p = aircraft_profile(kind)
        return vec4(max(12.0, p.span * 1.45), max(3.5, p.span * 0.36), if p.mass > 3000: 1.8 else: 2.4, 1.2)
    match kind:
        # (distance behind, height at altitude, longitudinal stiffness, longitudinal gain)
        .heron: vec4(24, 6, 1.8, 1.2)
        .falco: vec4(13, 3.5, 2.6, 1.1)
        _: vec4(15, 4, 2.2, 1.2)

chase = (f: mut Flyer, dt: f64):
    if dt <= 0.0: return
    st = f.state
    base = craft_point(st)
    P = vec3(0,st.position.y,0)
    v = st.velocity
    sp = f64(length(v))
    nose = quat_rotate(st.orientation, vec3(0, 0, -1))
    vdir = if sp > 2.0 and not st.moored: v / f32(sp) else: nose
    # wrecked: the camera stops dead where it was, as if it had hit a wall, and shakes with it; the
    # wreck goes on without it (falling away, plunging in), and drags it along only once it is far
    # off. It looks at the wreck, or where it went into the water, and never goes under itself.
    if (st.crashed or st.capsized) and f.placed:
        if not f.wreck_cam:
            f.wreck_cam = true
            f.jolt = clamp(sp / 45.0, 0.25, 1.6)
        c = world_delta(if f.cam_ready:f.cam_point else:world_point(f.cam_pos),WorldPoint(base.x,0,base.z))
        d = f64(length(c - P))
        if d > 55.0: c = P + (c - P) * f32(55.0 / d)
        c.y = max(c.y, f32(max(f64(swell_at(base.x+f64(c.x), base.z+f64(c.z), f.sea_t).x), surface_height(base.x+f64(c.x), base.z+f64(c.z))) + 2.0))
        f.cam_point=WorldPoint(base.x+f64(c.x),f64(c.y),base.z+f64(c.z));f.cam_ready=true
        f.cam_pos=world_vec(f.cam_point)
        f.jolt = f.jolt * exp(-2.2 * dt)
        sea = f64(swell_at(base.x+f64(P.x), base.z+f64(P.z), f.sea_t).x)
        at = if f64(P.y) < sea: vec3(P.x, f32(sea), P.z) else: P
        want = normalize(at - c + vec3(0, 0.0001, 0))
        f.look = normalize(f.look + (want - f.look) * f32(1.0 - exp(-7.0 * dt)))
        f.look_v = vec3(0, 0, 0)
        f.roll = f.roll * exp(-3.0 * dt)
        f.cam_up = quat_rotate(quat_axis_angle(f.look, f.roll), vec3(0, 1, 0))
        return
    f.wreck_cam = false
    f.jolt = f.jolt * exp(-2.2 * dt)
    # (adrift and slow: the camera keeps the way it last looked, level, and does not chase a
    # tumbling nose round under the water)
    frozen = st.crashed or st.capsized or st.beached or (st.on_water and sp < 3.0)
    if not f.placed: f.path = vdir
    if not frozen: f.path = normalize(f.path + (vdir - f.path) * f32(1.0 - exp(-6.0 * dt)))
    flat = vec3(f.path.x, if frozen: 0.0 else: f.path.y * 0.6, f.path.z)
    if length(flat) < 0.2: flat = vec3(0, 0, -1)
    fh = normalize(flat)
    up = vec3(0, 1, 0)
    uh = normalize(up - fh * dot(fh, up))
    rh = cross(fh, uh)
    shape = _cam_shape(f.kind)
    sfrac = smoothstep(f.spec.stall_speed, f.spec.max_speed, sp)
    below = max(surface_height(base.x+f64(P.x), base.z+f64(P.z)), f64(swell_at(base.x+f64(P.x),base.z+f64(P.z),f.sea_t).x))
    a = f64(P.y) - f.spec.float_height * 0.5 - below
    low = 1.0 - smoothstep(6.0, 40.0, a)
    # (the camera is pushed back by the air as it chases: well behind at rest, and the faster it
    # goes the farther the airflow holds it back, as drag does, with the square of the speed)
    rest = f64(shape.x) * 0.87
    # (a Schneider racer, so fast the full fall-back leaves it and its rivals small: held nearer)
    fall = if air_class_of(f.kind) == AirClass.schneider: 1.9 else: 3.4
    D = min(rest + f64(shape.x) * 0.000184 * sp * sp, rest * fall)
    # (it may rise as it falls back, or stay at its height: higher, the sea below it passes
    # slower, so by default it stays)
    rise = if camera_rises: 0.6 + 0.4 * D / rest else: 1.0
    Lh = max(f64(shape.y) * rise - (f64(shape.y) + 1.0) * low, 0.3)
    # (an upright screen is narrow: the camera stands farther back and higher, so the wings fit the
    # width and the upper wing's edge never slices across the picture; nothing changes on a wide one)
    sw_ = f64(screen_width()); sh_ = f64(screen_height())
    tall = if sw_ > 0.0 and sh_ > 0.0: clamp((1.0 - sw_ / sh_) * 2.0, 0.0, 1.0) else: 0.0
    D = D + rest * 0.55 * tall
    Lh = Lh + f64(shape.y) * 0.4 * tall
    # (eased, so a float touching a wave does not jerk it)
    if not f.placed: f.cam_lh = Lh
    f.cam_lh = f.cam_lh + (Lh - f.cam_lh) * (1.0 - exp(-1.5 * dt))
    A = P - fh * f32(D) + uh * f32(f.cam_lh)
    # (the aircraft's acceleration, smoothed, in the path's frame)
    if not f.placed: f.prev_vel = v
    acc = (v - f.prev_vel) / f32(dt)
    f.prev_vel = v
    f.acc_lp = f.acc_lp + (acc - f.acc_lp) * f32(1.0 - exp(-20.0 * dt))
    ah = vec3(dot(f.acc_lp, rh), dot(f.acc_lp, uh), dot(f.acc_lp, fh))
    w = vec3(3.0, 4.5, shape.z)
    z = vec3(0.8, 0.55, 0.6)
    g = vec3(0.6, 1.0, shape.w)
    if not f.placed:
        f.cam_e = vec3(0, 0, 0)
        f.cam_ev = vec3(0, 0, 0)
    # Independent exact axis springs: acceleration is constant for this sample. Work is
    # bounded even after a long pause; no Euler velocity can accumulate unseen by soft limits.
    loop axis in 0..3:
        wi = if axis==0: f64(w.x) else: if axis==1: f64(w.y) else: f64(w.z)
        zi = if axis==0: f64(z.x) else: if axis==1: f64(z.y) else: f64(z.z)
        force = if axis==0: -g.x*ah.x else: if axis==1: -g.y*ah.y else: -g.z*ah.z
        old_p = if axis==0: f.cam_e.x else: if axis==1: f.cam_e.y else: f.cam_e.z
        old_v = if axis==0: f.cam_ev.x else: if axis==1: f.cam_ev.y else: f.cam_ev.z
        pos,vel = spring_vector(vec3(old_p,0,0),vec3(old_v,0,0),vec3(f64(force)/(wi*wi),0,0),wi,zi,dt)
        if axis==0: f.cam_e.x=pos.x; f.cam_ev.x=vel.x
        else if axis==1: f.cam_e.y=pos.x; f.cam_ev.y=vel.x
        else: f.cam_e.z=pos.x; f.cam_ev.z=vel.x
    # (bounded softly: the offsets fade toward their limits rather than stopping at them; it
    # comes in closer only a little)
    soft = (x: f32, m: f32) -> f32: m * f32(tanh(f64(x / m)))
    e = vec3(soft(f.cam_e.x, 3.0), soft(f.cam_e.y, 1.2), if f.cam_e.z > 0.0: soft(f.cam_e.z, 1.0) else: soft(f.cam_e.z, 6.0))
    c = A + rh * e.x + uh * e.y + fh * e.z
    sw = swell_at(base.x+f64(c.x), base.z+f64(c.z), f.sea_t)
    c.y = max(c.y, f32(max(f64(sw.x) + 1.3, surface_height(base.x+f64(c.x), base.z+f64(c.z)) + 1.3)))
    # (looking around: the camera swung about the aircraft)
    if abs(f.look_yaw) + abs(f.look_pitch) > 0.001:
        rel = c - P
        rel = quat_rotate(quat_axis_angle(vec3(0, 1, 0), f.look_yaw), rel)
        side = normalize(cross(rel, vec3(0, 1, 0)))
        rel = quat_rotate(quat_axis_angle(side, f.look_pitch), rel)
        c = P + rel
        g2 = max(f64(swell_at(base.x+f64(c.x), base.z+f64(c.z), f.sea_t).x), surface_height(base.x+f64(c.x), base.z+f64(c.z))) + 1.3
        c.y = max(c.y, f32(g2))
    # where it looks: ahead along the path, leading into the turn, down a little when low
    yaw_rate = f64(dot(cross(fh, vdir), uh)) * 6.0
    T = P + fh * f32(22.0 + D * 0.4) + rh * f32(clamp(yaw_rate * sp * 0.2, -8.0, 8.0)) - uh * f32(4.0 * low)
    want = normalize(T - c)
    if abs(f.look_yaw) + abs(f.look_pitch) > 0.001:
        lk = smoothstep(0.0, 0.4, abs(f.look_yaw) + abs(f.look_pitch))
        want = normalize(want * f32(1.0 - lk) + normalize(P - c) * f32(lk))
    if not f.placed: f.look = want
    # (the aim keeps the aircraft well in the picture: stiff enough that it never runs to the edge)
    lw = 11.0
    look,look_v = spring_vector(f.look,f.look_v,want,lw,0.85,dt)
    f.look = if length(look)>0.00001: normalize(look) else: want
    f.look_v = look_v-f.look*dot(look_v,f.look)
    _, _, bank = _attitude(st)
    want_roll = if st.on_water or st.moored: 0.0 else: 0.2 * bank
    f.roll = f.roll + (want_roll - f.roll) * (1.0 - exp(-3.0 * dt))
    f.cam_up = quat_rotate(quat_axis_angle(f.look, f.roll + f.feedback.roll_lead), vec3(0, 1, 0))
    # the view widens a touch with speed, and kicks with a change of pace
    along = f64(ah.z)
    f.a_fast = f.a_fast + (along - f.a_fast) * (1.0 - exp(-8.0 * dt))
    f.a_slow = f.a_slow + (along - f.a_slow) * (1.0 - exp(-1.0 * dt))
    f.fov = 60.0 + 6.0 * sfrac + clamp(0.6 * (f.a_fast - f.a_slow), -3.0, 4.0)
    # (slow: the camera goes over to its orbit about the aircraft, and back when flying again)
    f.orbit_w = f.orbit_w + ((if f.orbiting: 1.0 else: 0.0) - f.orbit_w) * (1.0 - exp(-3.0 * dt))
    if not f.placed: f.orbit_w = if f.orbiting: 1.0 else: 0.0
    if f.orbit_w > 0.001:
        piv = P + vec3(0, 1.5, 0)
        cp = cos(f.orbit_pitch)
        dir = heading_vector(f.orbit_yaw) * f32(cp) + vec3(0, f32(sin(f.orbit_pitch)), 0)
        oc = piv + dir * f32(f.orbit_dist)
        oc.y = max(oc.y, f32(max(f64(swell_at(base.x+f64(oc.x), base.z+f64(oc.z), f.sea_t).x), surface_height(base.x+f64(oc.x), base.z+f64(oc.z))) + 1.3))
        ow = f32(f.orbit_w)
        c = c + (oc - c) * ow
        f.look = normalize(f.look + (normalize(piv - oc) - f.look) * ow)
        f.cam_up = normalize(f.cam_up + (vec3(0, 1, 0) - f.cam_up) * ow)
    # (on a touch screen, Sky Barons' view: from behind the aircraft along the aim, following the
    # aim quickly, looking a little past it, the aircraft held in the middle; it turns to fly where
    # the view looks)
    if pad.on and not st.crashed and not st.capsized:
        ad = aim_dir(f)
        if not f.placed: f.cam_aim = ad
        f.cam_aim = normalize(f.cam_aim + (ad - f.cam_aim) * f32(1.0 - exp(-25.0 * dt)))
        d = f.cam_aim
        behind = P - d * f32(D) + vec3(0, f32(f64(shape.y) * 0.95), 0)
        behind.y = max(behind.y, f32(max(f64(swell_at(base.x+f64(behind.x), base.z+f64(behind.z), f.sea_t).x), surface_height(base.x+f64(behind.x), base.z+f64(behind.z))) + 1.3))
        ahead = P + d * 40.0 + vec3(0, 2.5, 0)
        c = behind
        f.look = normalize(ahead - behind)
        f.cam_up = vec3(0, 1, 0)
    f.cam_point=WorldPoint(base.x+f64(c.x),f64(c.y),base.z+f64(c.z));f.cam_ready=true
    f.cam_pos=world_vec(f.cam_point)
    f.placed = true

# how it feels to be going: the load on the wings (from how fast the way it goes is turning), the
# field of view opening with speed, a buffet when fast and low, or pulling hard
feel = (f: mut Flyer, dt: f64,wind:vec3=vec3(0,0,0)):
    if dt <= 0: return
    instrument_step(f.instruments,f.spec,f.state,dt)
    v = f.state.velocity
    sp = f64(length(v))
    dir = if sp > 1.0: v / f32(sp) else: f.prev_dir
    turn = if f.feedback.ready: f64(length(dir - f.prev_dir)) / max(dt, 1e-4) else: 0.0
    f.prev_dir = dir
    g = 1.0 + turn * true_speed(f.spec, sp) / 9.81
    f.load = f.load + (min(g, 8.0) - f.load) * (1.0 - exp(-6.0 * dt))
    feedback_step(f.feedback,f.spec,f.state,f.load,dt,wind)
    f.shake = f.feedback.buffet

# Carry the camera's frame through the poles instead of switching an up axis at 0.98.
# Rodrigues transport uses only the small change since the preceding rendered frame.
transport_camera_up=(up:vec3,old:vec3,view:vec3)->vec3:
    axis=cross(old,view);c=clamp(dot(old,view),-1.0,1.0)
    result=if c> -0.999:up+cross(axis,up)+cross(axis,cross(axis,up))/f32(1.0+c) else:up
    result-=view*dot(result,view)
    if length(result)<0.0001:result=cross(view,if abs(view.x)<0.8:vec3(1,0,0) else:vec3(0,0,1))
    normalize(result)

# Target view rights itself: its carried up rolls back toward the horizon at a bounded rate,
# never in a snap, and holds where the horizon is undefined (looking nearly straight up or
# down). Without this, carrying the frame round a loop of bearings (a target passing overhead)
# left the picture upside down for good.
camera_horizon_up=(up:vec3,view:vec3,dt:f64)->vec3:
    level=vec3(0,1,0)-view*view.y
    n=f64(length(level))
    if n<0.05 or dt<=0:return up
    level=level/f32(n)
    angle=atan2(f64(dot(cross(up,level),view)),f64(dot(up,level)))
    turn=clamp(angle*(1.0-exp(-2.5*dt)),-1.5*dt,1.5*dt)*smoothstep(0.08,0.35,n)
    result=quat_rotate(quat_axis_angle(view,turn),up)
    normalize(result-view*dot(result,view))

# Gimbal-safe up for the drawn frame: carried from the frame last drawn, then turned onto the
# wanted up wherever that is defined. Near the vertical, where a look-at's up hint degenerates
# and would flip the picture, the carried frame holds instead.
steady_camera_up=(f:Flyer,view:vec3,hint:vec3)->vec3:
    want=hint-view*dot(hint,view)
    n=f64(length(want))
    carried=if f.screen_ready:transport_camera_up(f.screen_up,normalize(f.screen_view),view) else:transport_camera_up(vec3(0,1,0),view,view)
    if n<0.0001:return carried
    want=want/f32(n)
    k=smoothstep(0.1,0.35,n)
    if k>=1.0:return want
    angle=atan2(f64(dot(cross(carried,want),view)),f64(dot(carried,want)))
    normalize(quat_rotate(quat_axis_angle(view,angle*k),carried))

target_chase_camera=(f:mut Flyer,tracking:vec3,weight:f64,dt:f64=1.0/60.0)->ChaseCamera:
    eye=if f.cam_ready:f.cam_point else:world_point(f.cam_pos)
    w=clamp(weight,0.0,1.0)
    if w<=0.00001:
        f.target_frame.ready=false
        return ChaseCamera(eye,f.look,f.cam_up)
    normal=normalize(f.look)
    normal_up=transport_camera_up(f.cam_up,normal,normal)
    view=blend_bearing(normal,tracking,w)
    if not f.target_frame.ready:f.target_frame=TargetChaseFrame(true,normal,normal_up)
    view=blend_bearing(f.target_frame.view,view,1.0-exp(-10.0*max(0.0,dt)))
    up=camera_horizon_up(transport_camera_up(f.target_frame.up,f.target_frame.view,view),view,dt)
    # Smoothly recover the normal chase roll when leaving target view.
    home=transport_camera_up(normal_up,normal,view)
    roll=atan2(f64(dot(cross(home,up),view)),f64(dot(home,up)))
    up=quat_rotate(quat_axis_angle(view,roll*w),home)
    f.target_frame=TargetChaseFrame(true,view,up)
    craft=craft_point(f.state);rel=world_delta(eye,craft)
    reach=max(f64(length(rel)),8.0)
    side=normalize(cross(view,up));normal_side=normalize(cross(normal,normal_up))
    # Rotate around the craft throughout acquisition; a straight interpolation of eye positions
    # would pass through the aircraft when the selected target is directly behind it.
    offset= -view*f32(lerp(-f64(dot(rel,normal)),reach,w))+up*f32(lerp(f64(dot(rel,normal_up)),reach*0.28,w))+side*dot(rel,normal_side)*f32(1.0-w)
    eye=world_offset(craft,offset)
    floor=f64(swell_at(eye.x,eye.z,f.sea_t).x)+1.2
    if eye.y<floor:
        # Keep both wave clearance and chase distance; do not lift the eye into the airframe.
        offset.y=f32(floor-craft.y)
        horizontal=vec2(offset.x,offset.z)
        if length(horizontal)<0.001:horizontal=vec2(normal.x,normal.z)+vec2(0.0001,0)
        horizontal=normalize(horizontal)*f32(sqrt(max(1.0,reach*reach-f64(offset.y*offset.y))))
        offset.x=horizontal.x;offset.z=horizontal.y
        eye=world_offset(craft,offset)
        # The sea can prevent a literal target->craft->eye line. Preserve the player's aircraft.
        eye.y=max(eye.y,f64(swell_at(eye.x,eye.z,f.sea_t).x)+1.2)
        to_craft=normalize(world_delta(craft,eye))
        angle=acos(clamp(f64(dot(to_craft,view)),-1.0,1.0))
        allowance=min(0.22,max(0.04,f.fov*PI/360.0-atan2(f.spec.span*0.6,reach)))
        if angle>allowance:
            fraction=allowance/angle
            view=normalize(to_craft*f32(sin((1.0-fraction)*angle))+view*f32(sin(fraction*angle)))
        up=transport_camera_up(up,f.target_frame.view,view)
    ChaseCamera(eye,view,up)

clear_chase_camera=(f:mut Flyer,frame:ChaseCamera,dt:f64,towns:Town[]=[])->ChaseCamera:
    anchor=craft_point(f.state)
    a=world_vec(anchor);b=world_vec(frame.eye)
    soft=camera_clear_fraction(a,b,1.8,towns)
    hard=camera_clear_fraction(a,b,0.9,towns)
    f.camera_clearance=camera_clearance_step(f.camera_clearance,soft,hard,dt)
    eye=frame.eye
    if f.camera_clearance<0.99999:
        offset=world_delta(frame.eye,anchor)
        eye=world_offset(anchor,offset*f32(max(0.0,f.camera_clearance-0.0001)))
    # (never inside a wall or a bridge, even when the aircraft itself is: after a crash into the
    # canal's wall the wreck sits in the stone; the eye is put back out of it)
    out=camera_push_out(world_vec(eye),0.9)
    if length(out-world_vec(eye))>0.0001:eye=world_point(out)
    if eye==frame.eye:return frame
    focus=world_offset(frame.eye,frame.view*max(length(world_delta(frame.eye,anchor)),1.0))
    view=normalize(world_delta(focus,eye))
    ChaseCamera(eye,view,transport_camera_up(frame.up,frame.view,view))

# The chase or target frame to draw from; remembers its axes for the mouse.
chase_frame = (f: mut Flyer, t: f64, tracking:vec3 = vec3(0,0,-1), weight:f64 = 0.0, towns:Town[]=[]) -> ChaseCamera:
    if not f.placed:chase(f,1.0/60.0)
    dt=if f.target_camera_time<0:1.0/60.0 else:clamp(t-f.target_camera_time,0.0,0.1)
    frame=clear_chase_camera(f,target_chase_camera(f,tracking,weight,dt),dt,towns);f.target_camera_time=t
    frame.up=steady_camera_up(f,frame.view,frame.up)
    f.screen_view=frame.view;f.screen_up=frame.up;f.screen_ready=true
    frame

place_chase_camera = (f: mut Flyer, t: f64, tracking:vec3 = vec3(0,0,-1), weight:f64 = 0.0, towns:Town[]=[]):
    frame=chase_frame(f,t,tracking,weight,towns)
    view=frame.view;camera_up=frame.up;eye=frame.eye
    # the view hums only once it is really fast (the airframe itself shakes sooner), and shakes in a
    # buffet or a crash
    sp = f64(length(f.state.velocity))
    hum = if f.state.on_water: 0.0 else: smoothstep(75.0, 125.0, true_speed(f.spec, sp)) * 0.12
    side = normalize(cross(view, camera_up) + vec3(0.0001, 0, 0))
    up = normalize(cross(side, view))
    target = view * 50.0 + side * f32(sin(t * 61.0) * hum) + up * f32(sin(t * 53.0 + 1.3) * hum)
    a = f.shake * f.shake * 0.35 + f.jolt * 0.8 + f.feedback.slap * 0.12
    # (shaken about the camera's own axes, whichever way it faces)
    jitter = (side * f32(noise(t * 9.0, 1.0) - 0.5) + up * f32(noise(t * 11.0, 7.0) - 0.5) + view * f32(noise(t * 8.0, 13.0) - 0.5)) * f32(a)
    # (the head's jolts, smaller from out here: a few tens of centimetres of knock)
    head = head_shake(f, t)
    knock = side * (head.0.x * 6.0 + head.1.y * 3.0) + up * (head.0.y * 6.0 + head.1.x * 3.0)
    precise_camera(world_offset(eye,jitter*0.3+knock),target+jitter*4.7+knock*0.5,f.fov,0.5,world_far(eye.y),camera_up)

# the dock nearest the aircraft, when it is slow and close enough to moor there
mooring_spot = (f: Flyer, towns: Town[]) -> vec3?:
    if not f.state.on_water and not f.state.moored: return none
    v = length(vec3(f.state.velocity.x, 0, f.state.velocity.z))
    if v > 2.0: return none
    best: vec3? = none
    bd = 22.0
    loop tw in towns:
        loop d in tw.docks:
            l = f64(length(vec2(d.x - f.state.position.x, d.z - f.state.position.z)))
            if l < bd:
                bd = l
                best = d
    best ?? port_mooring(f.state.position)

# Registry docks carry their water datum, including elevated rivers and lakes.
moor_at_dock=(f:mut Flyer,dock:vec3):
    moor(f.state,vec3(dock.x,dock.y+f32(f.spec.float_height),dock.z),heading(f.state))

# (the heavy boats' bow sheets: how many drops are owed, between frames)
_sheet_credit = 0.0

# The heavy boats (Do X, H-4, Sarafand) climbing onto the step throw sheets of water off the bow
# and the sponsons, sideways and up past the wing: from a walking pace, heaviest over the hump,
# thinning as the hull lifts onto the step and gone in the air.
_bow_sheets = (f: Flyer, models: CraftModel[], ps: mut WorldParticles, v: f64, dt: f64):
    global _sheet_credit
    k = boat_spray_scale(f.kind)
    if k < 1.6:
        _sheet_credit = 0.0
        return
    hump = smoothstep(4.0, 10.0, v) * (1.0 - 0.75 * smoothstep(20.0, 34.0, v))
    _sheet_credit += min(dt, 0.1) * 140.0 * k * hump
    # (in bursts of eight: a burst is drawn as a billowing sheet, single drops only as specks)
    bursts = min(4, int(_sheet_credit / 8.0))
    _sheet_credit -= f64(bursts * 8)
    if bursts == 0 or ps.items.len() > 860: return
    fwd: vec3[]
    loop p in models[f.model].contacts:
        if p.z < 0 and abs(p.x) > 0.3: fwd.push(p)
    if fwd.len() == 0: return
    loop i in 0..bursts:
        p = fwd[(i + int(f.sea_t * 37.0)) % fwd.len()]
        w = craft_offset(f.state, quat_rotate(f.state.orientation, p))
        sea = swell_at(f64(w.x), f64(w.z), f.sea_t)
        # (only where the hull is in the water: never thrown from a point clear of it)
        if w.y > sea.x + 0.2: continue
        w.y = sea.x + 0.1
        side = if p.x < 0: -1.0 else: 1.0
        dir = normalize(quat_rotate(f.state.orientation, vec3(side * 1.0, 0.95 + 0.25 * sin(f64(i) * 1.7 + f.sea_t), 0.25)))
        emit(ps, w, 8, 4.0 + v * 0.38, rgba(0.95, 0.97, 1, 0.8), 1.15, 0.35 * k + v * 0.02, 0.35, dir)

# spray off the floats as they cut the water, and a wake
# The hydrofoil racer's declutched air propeller whirling with its lower blade in the sea: where a blade
# cuts the water, small throws of spray flicked off along the blade's way round, a throw at each
# strike; none once the propeller is out of the sea.
_blade_cuts = (f: mut Flyer, m: CraftModel, ps: mut WorldParticles, dt: f64):
    if f.spec.foils.len() == 0 or not f.state.foil.prop_wet or not f.state.damage.parts[1].attached:
        f.feedback.blade_credit = 0.0
        return
    omega = prop_rotation_speed(f.state,f.feedback.speed)
    if omega <= 0.0: return
    blades = m.prop_blades
    radius = m.prop_radius
    loop b in 0..blades:
        frame = prop_frame(m,0,f.prop_angle)*rotation_z(f64(b)*TAU/f64(blades)*prop_turn(m,0))
        hub = frame*vec4(0,0,0,1); tip = frame*vec4(0,f32(radius),0,1)
        hw = craft_offset(f.state,quat_rotate(f.state.orientation,hub.xyz))
        tw = craft_offset(f.state,quat_rotate(f.state.orientation,tip.xyz))
        sea = swell_at(tw.x,tw.z,f.sea_t).x
        if tw.y >= sea or hw.y <= sea: continue
        # (where the blade meets the surface, and the way that point of the blade is going)
        k = (hw.y-sea)/max(hw.y-tw.y,0.001)
        cut = WorldPoint(hw.x+(tw.x-hw.x)*k,sea+0.05,hw.z+(tw.z-hw.z)*k)
        along = quat_rotate(f.state.orientation,(prop_frame(m,0,f.prop_angle+0.05)*rotation_z(f64(b)*TAU/f64(blades)*prop_turn(m,0))*vec4(0,f32(radius*k),0,1)).xyz-(frame*vec4(0,f32(radius*k),0,1)).xyz)
        dir = normalize(normalize(along+vec3(0,0.0001,0))+vec3(0,0.9,0))
        # (a throw at each blade strike, more and quicker the faster it whirls; still a few drops)
        f.feedback.blade_credit += min(dt,0.1)*omega*0.9
        n = min(4,int(f.feedback.blade_credit))
        f.feedback.blade_credit -= f64(n)
        if n > 0 and ps.items.len() < 900:
            emit(ps,cut,min(n,900-ps.items.len()),2.0+omega*radius*0.22,rgba(0.95,0.97,1,0.85),0.5,0.18,0.5,dir)

spray = (f: mut Flyer, models: CraftModel[], ps: mut WorldParticles, dt: f64):
    if not f.state.on_water or f.state.moored or dt <= 0:
        f.feedback.spray_credit = 0.0
        return
    v = water_run_speed(f.spec,f.state)
    _bow_sheets(f, models, ps, v, dt)
    _blade_cuts(f, models[f.model], ps, dt)
    if v < 3.0:
        f.feedback.spray_credit=0.0
        return
    # Time-based emission, capped independently of refresh rate and long frames.
    f.feedback.spray_credit += min(dt,0.1)*(18.0+75.0*smoothstep(3.0,30.0,v))
    n = min(10,int(f.feedback.spray_credit))
    f.feedback.spray_credit -= f64(n)
    if n == 0: return
    loop p in models[f.model].contacts:
        if part_health(f.state.damage,PartId(contact_part(f.kind,p))) <= 0: continue
        w = craft_offset(f.state,quat_rotate(f.state.orientation,p))
        sea = swell_at(f64(w.x),f64(w.z),f.sea_t)
        if w.y > sea.x+0.18: continue
        w.y = sea.x+0.08
        side = if p.x < 0: -1.0 else: 1.0
        dir = normalize(quat_rotate(f.state.orientation,vec3(side*0.75,1.0,1.4))+vec3(0,0.35,0))
        if ps.items.len() < 900:
            # (the big boats' spray as big as they are: heavier drops, thrown faster and hanging
            # longer, and wider off the bow while it climbs onto the step)
            k = boat_spray_scale(f.kind)
            hump = if k > 1.0 and p.z < 0: 1.0 + 0.8 * smoothstep(5.0, 12.0, v) * (1.0 - smoothstep(22.0, 34.0, v)) else: 1.0
            emit(ps,w,min(n,900-ps.items.len()),min(16.0,v*0.5)*(0.7+0.3*k)*hump,rgba(0.95,0.97,1,0.85),0.55*(0.75+0.25*k),(0.18+v*0.009)*k*hump,0.48*hump,dir)

# a flight heading (0 north, east PI/2) as the world's turn (faces (sin, cos))
heading_to_turn = (h: f64) -> f64: PI - h

# Sky Barons' two marks: the gunsight, a ring with a dot where the guns point (on the nose's line,
# where the two guns' rounds meet, 450 m out), and a small ring where one asks it to fly (400 m out
# along the aim), while the aim steers (the mouse in charge, or a touch screen)
aim_marks = (f: Flyer, nose_marker: bool = true):
    if f.state.moored: return
    if nose_marker and not f.state.on_water:
        if let at = world_to_screen(f.state.position + quat_rotate(f.state.orientation, vec3(0, 0, -1)) * 450.0):
            ring(at, 16, 2, rgba(1, 1, 1, 0.75))
            circle(at, 2, rgba(1, 1, 1, 0.9))
    if f.mouse_mode and (is_mouse_locked() or pad.on):
        if let m = world_to_screen(f.state.position + aim_dir(f) * 400.0): ring(m, 7, 2, rgba(1, 1, 1, 0.5))
    if abs(f.look_yaw) + abs(f.look_pitch) > 0.35 and not f.state.moored: nose_pointer(f)

# Looking away: where the nose points, when it is out of the view, as a small chevron at the
# screen's edge pointing round to it (and a ring on it when it is in the view, in the cockpit too)
nose_pointer = (f: Flyer):
    nose = quat_rotate(f.state.orientation, vec3(0, 0, -1))
    sw = f64(screen_width()); sh = f64(screen_height())
    if let at = world_to_screen(f.state.position + nose * 450.0):
        if f64(at.x) > 30.0 and f64(at.x) < sw - 30.0 and f64(at.y) > 30.0 and f64(at.y) < sh - 30.0:
            ring(at, 12, 1.5, rgba(1, 0.97, 0.9, 0.6))
            return
    fwd = normalize(__cam_target - __cam_pos)
    right = normalize(cross(fwd, __cam_up))
    up = normalize(cross(right, fwd))
    d = vec2(dot(nose, right), -dot(nose, up))
    if length(d) < 0.0001: d = vec2(0, 1)
    d = normalize(d)
    # (on an ellipse just inside the screen's edge)
    c = vec2(f32(sw * 0.5), f32(sh * 0.5))
    p = c + vec2(d.x * f32(sw * 0.5 - 46.0), d.y * f32(sh * 0.5 - 46.0))
    side = vec2(-d.y, d.x)
    tip = p + d * 13.0
    triangle(tip, p - d * 5.0 + side * 10.0, p - d * 5.0 - side * 10.0, rgba(1, 0.97, 0.9, 0.75))
    circle(p - d * 12.0, 3.0, rgba(1, 0.97, 0.9, 0.6))

# how the airframe is working now, for drawing it: the wings bowing with the load, shaking with
# the engine and the air, fluttering at speed (and the half span they are measured by)
airframe = (f: Flyer) -> vec4: airframe_cues(f.spec, f.state.velocity, f.load, f.state.on_water, f.state.throttle)
