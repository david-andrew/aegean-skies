# The player at the controls: keys to controls for the flight model, the chase camera, and the
# business of the water (casting off, mooring at a dock, climbing out), with spray off the floats.
#
# Keys (after Sky Barons): W dives and S climbs, A and D roll, Q and E the rudder (on the water,
# A and D steer too), Shift opens the throttle and Z closes it, Space brakes on the water, F moors
# beside a dock and climbs out.

use 'look.jo'
use 'world.jo'
use 'planes.jo'
use 'flight.jo'
use 'objects.jo'

struct Flyer:
    kind: Craft
    model: int                      # which built model draws it
    spec: CraftSpec
    state: CraftState
    throttle = 0.0                  # the lever (the engine follows it)
    cam_pos: vec3
    cam_fwd: vec3 = vec3(0, 0, -1)
    cam_up: vec3 = vec3(0, 1, 0)
    prop_angle = 0.0
    placed = false                  # (the camera has been put somewhere yet)
    aim_heading = 0.0               # where the mouse asks it to fly (heading, and climb angle)
    aim_climb = 0.0
    trim = 0.0                      # the attitude the keys left it at (kept when they are let go)
    keys_held = false
    last: Controls = Controls()
    fov = 62.0
    shake = 0.0                     # the buffet now (0..1)
    load = 1.0                      # how many g the wings pull (smoothed)
    prev_dir: vec3 = vec3(0, 0, -1)

make_flyer = (kind: Craft, model: int, contacts: vec3[], dock: vec3, heading: f64) -> Flyer:
    spec = craft_spec(kind, contacts)
    st = water_start(spec, dock, heading)
    moor(st, st.position, heading)
    Flyer(kind, model, spec, st, cam_pos = st.position)

# the world the flight model flies in: the wind (gentler than the sea feels it), a little swell
flight_env = (t: f64) -> FlightEnv:
    w = wind_now
    FlightEnv(wind = vec3(w.dir.x, 0, w.dir.y) * f32(w.speed * 0.7), wave_height = clamp(0.05 + w.speed * 0.03, 0.0, 0.5), wave_time = 0.0, ground = surface_height)

# where the aircraft is pointing: its heading and how far its nose is above the horizon
_attitude = (st: CraftState) -> (f64, f64, f64):
    f = quat_rotate(st.orientation, vec3(0, 0, -1))
    r = quat_rotate(st.orientation, vec3(1, 0, 0))
    u = quat_rotate(st.orientation, vec3(0, 1, 0))
    (heading(st), asin(clamp(f64(f.y), -1.0, 1.0)), atan2(-f64(r.y), f64(u.y)))

# the way the mouse asks to fly
aim_dir = (f: Flyer) -> vec3:
    cp = cos(f.aim_climb)
    vec3(f32(sin(f.aim_heading) * cp), f32(sin(f.aim_climb)), f32(-cos(f.aim_heading) * cp))

# the controls, as Sky Barons has them: the mouse (captured) moves where to fly and the aircraft
# steers there; held keys fly it directly, the aim following the nose; let go, the aim keeps the
# way it was then flying and the steering levels the wings.
key_controls = (f: mut Flyer, dt: f64) -> Controls:
    up = (k: Key) -> f64: if key_down(k): 1.0 else: 0.0
    if key_down(.shift): f.throttle = min(1.0, f.throttle + dt * 0.6)
    if key_down(.z): f.throttle = max(0.0, f.throttle - dt * 0.6)
    st = f.state
    hd, pitch, bank = _attitude(st)
    kp = up(.s) + up(.down) - up(.w) - up(.up)
    kr = up(.d) + up(.right) - up(.a) - up(.left)
    ky = up(.e) - up(.q)
    c = Controls()
    c.throttle = f.throttle
    if st.on_water:
        c.pitch = kp
        c.yaw = clamp(ky + kr, -1.0, 1.0)
        c.water_brake = up(.space)
        c.assist = 0.0
        f.aim_heading = hd
        f.aim_climb = clamp(pitch, -0.2, 0.3)
        return c
    md = mouse_delta()
    if length(md) > 0.0:
        f.aim_heading += f64(md.x) * 0.0025
        f.aim_climb = clamp(f.aim_climb - f64(md.y) * 0.0025, -1.45, 1.45)
    keys = abs(kp) + abs(kr) + abs(ky) > 0.0
    if keys:
        f.aim_heading = hd
        f.aim_climb = pitch
        f.keys_held = true
    c = steer(f.spec, st, aim_dir(f))
    c.throttle = f.throttle
    # keys override the axes they hold
    if kp != 0.0: c.pitch = kp
    if kr != 0.0: c.roll = kr
    if ky != 0.0: c.yaw = ky
    # (the controls ease toward what is asked, quickly)
    rate = if keys: 9.0 else: 30.0
    k = 1.0 - exp(-rate * dt)
    c.pitch = f.last.pitch + (c.pitch - f.last.pitch) * k
    c.roll = f.last.roll + (c.roll - f.last.roll) * k
    c.yaw = f.last.yaw + (c.yaw - f.last.yaw) * k
    f.last = c
    c

# vapor off the wingtips: pulling hard at speed in damp air (morning, evening, near the clouds)
vapor = (f: Flyer, models: CraftModel[], ps: mut Particles3D, hour: f64):
    sp = f64(length(f.state.velocity))
    if f.state.on_water or sp < 40.0: return
    damp = max(1.0 - smoothstep(8.0, 11.0, hour), smoothstep(16.5, 19.0, hour))
    damp = max(damp, smoothstep(450.0, 680.0, f64(f.state.position.y)))
    need = 3.6 - 1.2 * damp
    if f.load < need: return
    m = translation(f.state.position) * quat_to_mat4(f.state.orientation)
    tips = f.spec.wing_contacts
    loop p in tips:
        if p.y < 0.0 and tips.len() > 2: continue
        w = transform_point(m, p)
        emit(ps, w, 2, 0.3, rgba(1, 1, 1, f32(0.35 + 0.3 * smoothstep(need, need + 2.0, f.load))), 1.2, 0.35, PI, vec3(0, 1, 0))

# a step of the player's aircraft
fly = (f: mut Flyer, dt: f64, t: f64):
    c = key_controls(f, dt)
    if f.state.moored and f.throttle > 0.05: unmoor(f.state)
    if not f.state.moored: step(f.spec, f.state, c, flight_env(t), dt)
    f.prop_angle += dt * (8.0 + 70.0 * f.state.throttle)
    feel(f, dt)

craft_transform = (f: Flyer) -> mat4: translation(f.state.position) * quat_to_mat4(f.state.orientation)

# how far behind and above the camera sits, by the size of the aircraft
_cam_offset = (kind: Craft) -> vec2: match kind:
    .heron: vec2(26, 7)
    _: vec2(16, 4.5)

# the chase camera: behind the aircraft in a smoothed frame of it, the horizon kept level
chase = (f: mut Flyer, dt: f64):
    fw = quat_rotate(f.state.orientation, vec3(0, 0, -1))
    k = 1.0 - exp(-5.0 * dt)
    if not f.placed:
        f.cam_fwd = fw
        k = 1.0
    f.cam_fwd = normalize(f.cam_fwd + (fw - f.cam_fwd) * f32(k))
    off = _cam_offset(f.kind)
    flat = normalize(vec3(f.cam_fwd.x, f.cam_fwd.y * 0.6, f.cam_fwd.z))
    want = f.state.position - flat * f32(off.x) + vec3(0, f32(off.y), 0)
    if f.state.on_water or f.state.moored: want = want + vec3(0, -1.0, 0)
    g = surface_height(f64(want.x), f64(want.z))
    want.y = max(want.y, f32(max(g, 0.0) + 1.5))
    if not f.placed:
        f.cam_pos = want
        f.placed = true
    f.cam_pos = f.cam_pos + (want - f.cam_pos) * f32(1.0 - exp(-9.0 * dt))

# how it feels to be going: the load on the wings (from how fast the way it goes is turning), the
# field of view opening with speed, a buffet when fast and low, or pulling hard
feel = (f: mut Flyer, dt: f64):
    v = f.state.velocity
    sp = f64(length(v))
    dir = if sp > 1.0: v / f32(sp) else: f.prev_dir
    turn = f64(length(dir - f.prev_dir)) / max(dt, 1e-4)
    f.prev_dir = dir
    g = 1.0 + turn * sp / 9.81
    f.load = f.load + (min(g, 8.0) - f.load) * (1.0 - exp(-6.0 * dt))
    want_fov = 60.0 + 16.0 * smoothstep(30.0, 90.0, sp)
    f.fov = f.fov + (want_fov - f.fov) * (1.0 - exp(-2.0 * dt))
    alt = f64(f.state.position.y)
    low = 1.0 - smoothstep(8.0, 90.0, alt)
    fast = smoothstep(40.0, 90.0, sp)
    pull = smoothstep(2.2, 5.0, f.load)
    f.shake = clamp(fast * (0.25 + 0.75 * low) * 0.8 + pull * 0.6, 0.0, 1.0) * (if f.state.on_water: 0.3 else: 1.0)

place_chase_camera = (f: Flyer, t: f64):
    target = f.state.position + f.cam_fwd * 30.0 + vec3(0, 1.5, 0)
    a = f.shake * f.shake * 0.35
    jitter = vec3(f32(noise(t * 9.0, 1.0) - 0.5), f32(noise(t * 11.0, 7.0) - 0.5), f32(noise(t * 8.0, 13.0) - 0.5)) * f32(a)
    camera3d(f.cam_pos + jitter * 0.3, target + jitter * 3.0, f.fov, 0.5, 30000.0)

# the dock nearest the aircraft, when it is slow and close enough to moor there
mooring_spot = (f: Flyer, towns: Town[]) -> vec3?:
    if not f.state.on_water and not f.state.moored: return none
    v = length(vec3(f.state.velocity.x, 0, f.state.velocity.z))
    if v > 2.0: return none
    best: vec3? = none
    bd = 22.0
    loop tw in towns:
        loop d in tw.docks:
            l = f64(length(vec2(d.x - f.state.position.x, d.z - f.state.position.z)))
            if l < bd:
                bd = l
                best = d
    best

# spray off the floats as they cut the water, and a wake
spray = (f: Flyer, models: CraftModel[], ps: mut Particles3D):
    if not f.state.on_water: return
    v = f64(length(vec3(f.state.velocity.x, 0, f.state.velocity.z)))
    if v < 3.0: return
    m = craft_transform(f)
    cm = models[f.model]
    n = int(clamp(v / 6.0, 1.0, 6.0))
    loop p in cm.contacts:
        if p.z > 0.0: continue
        w = transform_point(m, p)
        w.y = 0.1
        side = normalize(vec3(f32(f64(p.x)), 0, 0.001))
        dir = normalize(quat_rotate(f.state.orientation, side) + vec3(0, 0.8, 0))
        emit(ps, w, n, v * 0.18, rgba(0.95, 0.97, 1.0, 0.85), 0.9, 0.45, 0.6, dir)

# a flight heading (0 north, east PI/2) as the world's turn (faces (sin, cos))
heading_to_turn = (h: f64) -> f64: PI - h
