use 'render_space.jo'
# The player at the controls: keys to controls for the flight model, the chase camera, and the
# business of the water (casting off, mooring at a dock, climbing out), with spray off the floats.
#
# Keys (after Sky Barons): W dives and S climbs, A and D roll, Q and E the rudder (on the water,
# A and D steer too), Shift opens the throttle and Z closes it, Space brakes on the water, F moors
# beside a dock and climbs out.

use 'look.jo'
use 'world.jo'
use 'planes.jo'
use 'flight.jo'
use 'touch.jo'
use 'tweaks.jo'
use 'objects.jo'
use 'trails.jo'
use 'sea.jo'

# (the chase camera rises as it falls back with speed: the pause menu's switch)
camera_rises = false
set_camera_rises = (on: bool):
    global camera_rises
    camera_rises = on

struct Flyer:
    kind: Craft
    model: int                      # which built model draws it
    spec: CraftSpec
    state: CraftState
    throttle = 0.0                  # lever -1..1: negative is air brake, engine follows positive
    cockpit_view = false
    guns_locked = true
    safety_zone = false
    gear_down = false
    cam_pos: vec3
    cam_fwd: vec3 = vec3(0, 0, -1)
    cam_up: vec3 = vec3(0, 1, 0)
    cam_lh = 0.0
    look_yaw = 0.0                  # (looking around while flying: offsets about the aircraft)
    look_pitch = 0.0
    slow = false                    # (on the water or below the stall: the mouse may orbit the camera)
    orbiting = false                # (and it has: the mouse moved while slow)
    orbit_yaw = 0.0                 # (the orbit: which way from the aircraft, how high, how far;
    orbit_pitch = 0.32              # fixed to the world, not the aircraft, so it holds still while
    orbit_dist = 30.0               # one taxis about)
    orbit_w = 0.0                   # (how far the camera has gone over to the orbit)
    sea_t = 0.0                     # (the sea's clock: the game's time)
    prop_angle = 0.0
    placed = false                  # (the camera has been put somewhere yet)
    aim_heading = 0.0               # where the mouse asks it to fly (heading, and climb angle)
    aim_climb = 0.0
    trim = 0.0                      # the attitude the keys left it at (kept when they are let go)
    keys_held = false
    last: Controls = Controls()
    fov = 62.0
    shake = 0.0                     # the buffet now (0..1)
    wreck_cam = false               # (the camera stopped dead when it was wrecked)
    jolt = 0.0                      # (the camera's shake from that, dying away)
    load = 1.0                      # how many g the wings pull (smoothed)
    prev_dir: vec3 = vec3(0, 0, -1)
    last_speed = 0.0
    surge = 0.0                     # the felt acceleration, smoothed
    mouse_mode = false              # the mouse is in charge (else the keys)
    # (the chase camera's state: the smoothed way of travel, the spring's offset and its rate in
    # that frame, the aircraft's smoothed acceleration, where it looks, its roll)
    path: vec3 = vec3(0, 0, -1)
    cam_e: vec3 = vec3(0, 0, 0)
    cam_ev: vec3 = vec3(0, 0, 0)
    prev_vel: vec3 = vec3(0, 0, 0)
    acc_lp: vec3 = vec3(0, 0, 0)
    look: vec3 = vec3(0, 0, -1)
    look_v: vec3 = vec3(0, 0, 0)
    roll = 0.0
    a_fast = 0.0
    a_slow = 0.0
    cam_vel: vec3 = vec3(0, 0, 0)   # the camera's own motion (it rides a spring behind the aircraft)

make_flyer = (kind: Craft, model: int, contacts: vec3[], dock: vec3, heading: f64) -> Flyer:
    spec = craft_spec(kind, contacts)
    st = water_start(spec, dock, heading)
    moor(st, st.position, heading)
    Flyer(kind, model, spec, st, cam_pos = st.position)

# the world the flight model flies in: the wind (gentler than the sea feels it), a little swell
flight_env = (t: f64) -> FlightEnv:
    w = wind_now
    # (the sea the floats meet is the sea that is drawn: its swells, at the game's time)
    FlightEnv(wind = vec3(w.dir.x, 0, w.dir.y) * f32(w.speed * 0.7), wave_height = 0.0, wave_time = 0.0, ground = surface_height,
        swell = (x: f64, z: f64) -> vec3: swell_at(x, z, t), has_swell = true)

# where the aircraft is pointing: its heading and how far its nose is above the horizon
_attitude = (st: CraftState) -> (f64, f64, f64):
    f = quat_rotate(st.orientation, vec3(0, 0, -1))
    r = quat_rotate(st.orientation, vec3(1, 0, 0))
    u = quat_rotate(st.orientation, vec3(0, 1, 0))
    (heading(st), asin(clamp(f64(f.y), -1.0, 1.0)), atan2(-f64(r.y), f64(u.y)))

# the way the mouse asks to fly
aim_dir = (f: Flyer) -> vec3:
    cp = cos(f.aim_climb)
    vec3(f32(sin(f.aim_heading) * cp), f32(sin(f.aim_climb)), f32(-cos(f.aim_heading) * cp))

# Pure mapping also used by tests and future lever UI. No reverse engine thrust.
lever_controls = (lever: f64, gear: bool = false) -> Controls:
    Controls(throttle=clamp(lever,0.0,1.0),airbrake=clamp(-lever,0.0,1.0),gear=gear)

# Entering a protected area engages the safety once; an explicit unlock is always deliberate.
gun_safety = (f: mut Flyer, protected: bool, toggle: bool):
    if protected and not f.safety_zone: f.guns_locked=true
    f.safety_zone=protected
    if toggle:f.guns_locked=not f.guns_locked

# the controls, in two ways that do not fight: move the mouse (captured) and it is in charge, the
# aircraft steering to where it points (Sky Barons' steer), keys adding to it while held; touch a
# key and the keys are in charge, flying the aircraft directly with nothing steering it back, the
# aim following the nose until the mouse moves again.
key_controls = (f: mut Flyer, dt: f64) -> Controls:
    up = (k: Key) -> f64: if vdown(k): 1.0 else: 0.0
    if vdown(.shift): f.throttle = min(1.0, f.throttle + dt * 0.6)
    if vdown(.z): f.throttle = max(-1.0, f.throttle - dt * 0.6)
    st = f.state
    hd, pitch, bank = _attitude(st)
    # (on the water, a finger on the touch screen is a stick: down pulls back, across steers; in
    # the air it moves the aim instead, below)
    wet = if pad.mode == 1: 1.0 else: 0.0
    kp = clamp(up(.s) + up(.down) - up(.w) - up(.up) + f64(pad.stick.y) * wet, -1.0, 1.0)
    kr = clamp(up(.d) + up(.right) - up(.a) - up(.left) + f64(pad.stick.x) * wet, -1.0, 1.0)
    # (the touch screen's throttle slider)
    if pad.throttle_want >= 0.0: f.throttle = pad.throttle_want
    ky = up(.e) - up(.q)
    c = lever_controls(f.throttle,f.gear_down)
    c.throttle = max(0.0,f.throttle)
    # (the mouse looks around while the right button or C is held; and always when slow, on the
    # water or below the stall, the keys steering: coming into a harbor one can see where one is
    # going. The view stays where it was put until flying again, then swings back behind)
    # (a swipe in the air moves the aim as the mouse does)
    md = (if is_mouse_locked(): mouse_delta() else: vec2(0, 0)) + (if pad.mode == 0: pad.aim * 2.2 else: vec2(0, 0))
    slow = st.on_water or st.moored or f64(length(st.velocity)) < f.spec.stall_speed * pure_k(f.spec)
    # (two fingers turn the view about, slow on the water, as the mouse does)
    if slow: md = md + pad.orbit * 1.6
    if slow and tweaks.orbit_camera:
        # (a trial, Tweaks: moving the mouse while slow takes the camera off the follow to an orbit about the
        # aircraft, as the camera on foot: the mouse turns it about and up and down the same way,
        # the wheel brings it nearer or farther; it starts where the follow camera was)
        if not f.orbiting and length(md) > 0.5:
            f.orbiting = true
            rel = f.cam_pos - st.position
            f.orbit_yaw = atan2(f64(rel.x), -f64(rel.z))
            f.orbit_pitch = clamp(asin(clamp(f64(rel.y) / max(f64(length(rel)), 0.1), -1.0, 1.0)), -0.05, 1.35)
            f.orbit_dist = clamp(f64(length(rel)), 9.0, 90.0)
        if f.orbiting:
            f.orbit_yaw += f64(md.x) * 0.004
            f.orbit_pitch = clamp(f.orbit_pitch + f64(md.y) * 0.004, -0.05, 1.35)
            f.orbit_dist = clamp(f.orbit_dist * pow(0.93, clamp(mouse_wheel(), -3.0, 3.0)), 9.0, 90.0)
        md = vec2(0, 0)
    else: f.orbiting = false
    f.slow = slow
    # (as it was: slow, the mouse looks around the aircraft)
    looking = mouse_down(.right) or vdown(.c) or (slow and not tweaks.orbit_camera)
    if looking:
        f.look_yaw = clamp(f.look_yaw - f64(md.x) * 0.004, -PI, PI)
        f.look_pitch = clamp(f.look_pitch - f64(md.y) * 0.004, -1.2, 1.2)
        md = vec2(0, 0)
    else:
        k = 1.0 - exp(-4.0 * dt)
        f.look_yaw -= f.look_yaw * k
        f.look_pitch -= f.look_pitch * k
    if st.on_water:
        c.pitch = kp
        c.yaw = clamp(ky + kr, -1.0, 1.0)
        c.water_brake = up(.space)
        c.assist = 0.0
        f.aim_heading = hd
        f.aim_climb = clamp(pitch, -0.2, 0.3)
        f.last = c
        return c
    # (otherwise the mouse steers, while the game has it)
    keys = abs(kp) + abs(kr) + abs(ky) > 0.0
    # (the swipe let go: the aim settles back on the nose, and the aircraft flies on as it is)
    if pad.aim_let_go and pad.mode == 0:
        f.aim_heading = hd
        f.aim_climb = pitch
    if length(md) > 0.5:
        if not f.mouse_mode:
            # taking over from the keys: the aim starts where the nose is
            f.aim_heading = hd
            f.aim_climb = pitch
        f.mouse_mode = true
        f.aim_heading += f64(md.x) * 0.0025
        f.aim_climb = clamp(f.aim_climb - f64(md.y) * 0.0025, -1.55, 1.55)
    else if keys and (vpressed(.w) or vpressed(.s) or vpressed(.a) or vpressed(.d) or vpressed(.q) or vpressed(.e) or vpressed(.up) or vpressed(.down) or vpressed(.left) or vpressed(.right)):
        f.mouse_mode = false
    if f.mouse_mode:
        c = steer(f.spec, st, aim_dir(f))
        c.throttle = max(0.0,f.throttle)
        c.airbrake = max(0.0,-f.throttle)
        c.gear = f.gear_down
        if kp != 0.0: c.pitch = clamp(c.pitch + kp, -1.0, 1.0)
        if kr != 0.0: c.roll = clamp(c.roll + kr, -1.0, 1.0)
        if ky != 0.0: c.yaw = clamp(c.yaw + ky, -1.0, 1.0)
    else:
        f.aim_heading = hd
        f.aim_climb = pitch
        c.pitch = kp
        c.roll = kr
        c.yaw = ky
    c.assist = 0.0
    # (the controls ease toward what is asked: a stick is not a switch)
    rate = if f.mouse_mode: 30.0 else: 7.0
    k = 1.0 - exp(-rate * dt)
    c.pitch = f.last.pitch + (c.pitch - f.last.pitch) * k
    c.roll = f.last.roll + (c.roll - f.last.roll) * k
    c.yaw = f.last.yaw + (c.yaw - f.last.yaw) * k
    f.last = c
    c

# vapor off the wingtips: pulling hard at speed in damp air (morning, evening, near the clouds);
# the two wingtips' trails (strength 0 when there is none)
vapor = (f: Flyer, trails: mut Trail[], hour: f64, t: f64):
    sp = f64(length(f.state.velocity))
    damp = max(1.0 - smoothstep(8.0, 11.0, hour), smoothstep(16.5, 19.0, hour))
    damp = max(damp, smoothstep(450.0, 680.0, f64(f.state.position.y)))
    need = 3.4 - 1.2 * damp
    strength = if f.state.on_water or sp < 40.0: 0.0 else: smoothstep(need, need + 1.5, f.load)
    m = translation(f.state.position) * quat_to_mat4(f.state.orientation)
    # the outermost wingtips: left and right
    tips = f.spec.wing_contacts
    left = tips[0]
    right = tips[0]
    loop p in tips:
        if p.x < left.x: left = p
        if p.x > right.x: right = p
    trail_step(trails[0], transform_point(m, left), strength, t)
    trail_step(trails[1], transform_point(m, right), strength, t)

# a step of the player's aircraft
fly = (f: mut Flyer, dt: f64, t: f64):
    c = key_controls(f, dt)
    if f.state.moored and f.throttle > 0.05: unmoor(f.state)
    if not f.state.moored: step(f.spec, f.state, c, flight_env(t), dt)
    f.prop_angle += dt * (8.0 + 70.0 * f.state.throttle)
    f.sea_t = t
    feel(f, dt)

craft_transform = (f: Flyer) -> mat4: translation(f.state.position) * quat_to_mat4(f.state.orientation)

# how far behind and above the camera sits, by the size of the aircraft
_cam_offset = (kind: Craft) -> vec2:
    if int(kind) < 4: return if kind == .heron: vec2(26,7) else: vec2(16,4.5)
    p = aircraft_profile(kind)
    vec2(max(16.0, p.span * 1.6), max(4.5, p.span * 0.4))

# the chase camera: behind the aircraft in a smoothed frame of it, the horizon kept level
# The chase camera (after the research in docs: the speed of the view is the ground's flow, its
# speed over the camera's height above it; and acceleration, not speed, is what is felt):
# - it rests at an anchor behind the aircraft in a frame along its path, high when the aircraft is
#   high, and low over the water (two meters up) when it skims it;
# - it hangs from that anchor on a spring along each axis, pushed by the aircraft's real
#   acceleration: back when it surges, out in a turn, a dip at a slam, nothing at a steady speed;
# - it looks ahead along the path, leading into turns, rolling a fifth of the bank.
_cam_shape = (kind: Craft) -> vec4:
    if int(kind) >= 4:
        p = aircraft_profile(kind)
        return vec4(max(12.0, p.span * 1.45), max(3.5, p.span * 0.36), if p.mass > 3000: 1.8 else: 2.4, 1.2)
    match kind:
        # (distance behind, height at altitude, longitudinal stiffness, longitudinal gain)
        .heron: vec4(24, 6, 1.8, 1.2)
        .falco: vec4(13, 3.5, 2.6, 1.1)
        _: vec4(15, 4, 2.2, 1.2)

chase = (f: mut Flyer, dt: f64):
    if dt <= 0.0: return
    st = f.state
    P = st.position
    v = st.velocity
    sp = f64(length(v))
    nose = quat_rotate(st.orientation, vec3(0, 0, -1))
    vdir = if sp > 2.0 and not st.moored: v / f32(sp) else: nose
    # wrecked: the camera stops dead where it was, as if it had hit a wall, and shakes with it; the
    # wreck goes on without it (falling away, plunging in), and drags it along only once it is far
    # off. It looks at the wreck, or where it went into the water, and never goes under itself.
    if (st.crashed or st.capsized) and f.placed:
        if not f.wreck_cam:
            f.wreck_cam = true
            f.jolt = clamp(sp / 45.0, 0.25, 1.6)
        c = f.cam_pos
        d = f64(length(c - P))
        if d > 55.0: c = P + (c - P) * f32(55.0 / d)
        c.y = max(c.y, f32(max(f64(swell_at(f64(c.x), f64(c.z), f.sea_t).x), surface_height(f64(c.x), f64(c.z))) + 2.0))
        f.cam_pos = c
        f.jolt = f.jolt * exp(-2.2 * dt)
        sea = f64(swell_at(f64(P.x), f64(P.z), f.sea_t).x)
        at = if f64(P.y) < sea: vec3(P.x, f32(sea), P.z) else: P
        want = normalize(at - c + vec3(0, 0.0001, 0))
        f.look = normalize(f.look + (want - f.look) * f32(1.0 - exp(-7.0 * dt)))
        f.look_v = vec3(0, 0, 0)
        f.roll = f.roll * exp(-3.0 * dt)
        f.cam_up = quat_rotate(quat_axis_angle(f.look, f.roll), vec3(0, 1, 0))
        return
    f.wreck_cam = false
    f.jolt = f.jolt * exp(-2.2 * dt)
    # (adrift and slow: the camera keeps the way it last looked, level, and does not chase a
    # tumbling nose round under the water)
    frozen = st.crashed or st.capsized or st.beached or (st.on_water and sp < 3.0)
    if not f.placed: f.path = vdir
    if not frozen: f.path = normalize(f.path + (vdir - f.path) * f32(1.0 - exp(-6.0 * dt)))
    flat = vec3(f.path.x, if frozen: 0.0 else: f.path.y * 0.6, f.path.z)
    if length(flat) < 0.2: flat = vec3(0, 0, -1)
    fh = normalize(flat)
    up = vec3(0, 1, 0)
    uh = normalize(up - fh * dot(fh, up))
    rh = cross(fh, uh)
    shape = _cam_shape(f.kind)
    sfrac = smoothstep(f.spec.stall_speed, f.spec.max_speed, sp)
    below = max(surface_height(f64(P.x), f64(P.z)), 0.0)
    a = f64(P.y) - f.spec.float_height * 0.5 - below
    low = 1.0 - smoothstep(6.0, 40.0, a)
    # (the camera is pushed back by the air as it chases: well behind at rest, and the faster it
    # goes the farther the airflow holds it back, as drag does, with the square of the speed)
    rest = f64(shape.x) * 0.87
    D = min(rest + f64(shape.x) * 0.000184 * sp * sp, rest * 3.4)
    # (it may rise as it falls back, or stay at its height: higher, the sea below it passes
    # slower, so by default it stays)
    rise = if camera_rises: 0.6 + 0.4 * D / rest else: 1.0
    Lh = max(f64(shape.y) * rise - (f64(shape.y) + 1.0) * low, 0.3)
    # (eased, so a float touching a wave does not jerk it)
    if not f.placed: f.cam_lh = Lh
    f.cam_lh = f.cam_lh + (Lh - f.cam_lh) * (1.0 - exp(-1.5 * dt))
    A = P - fh * f32(D) + uh * f32(f.cam_lh)
    # (the aircraft's acceleration, smoothed, in the path's frame)
    if not f.placed: f.prev_vel = v
    acc = (v - f.prev_vel) / f32(dt)
    f.prev_vel = v
    f.acc_lp = f.acc_lp + (acc - f.acc_lp) * f32(1.0 - exp(-20.0 * dt))
    ah = vec3(dot(f.acc_lp, rh), dot(f.acc_lp, uh), dot(f.acc_lp, fh))
    w = vec3(3.0, 4.5, shape.z)
    z = vec3(0.8, 0.55, 0.6)
    g = vec3(0.6, 1.0, shape.w)
    if not f.placed:
        f.cam_e = vec3(0, 0, 0)
        f.cam_ev = vec3(0, 0, 0)
    n = max(1, int(ceil(dt * 240.0)))
    h = f32(dt / f64(n))
    loop k in 0..n:
        acc_e = -(w * w) * f.cam_e - (z * w * 2.0) * f.cam_ev - g * ah
        f.cam_ev += acc_e * h
        f.cam_e += f.cam_ev * h
    # (bounded softly: the offsets fade toward their limits rather than stopping at them; it
    # comes in closer only a little)
    soft = (x: f32, m: f32) -> f32: m * f32(tanh(f64(x / m)))
    e = vec3(soft(f.cam_e.x, 3.0), soft(f.cam_e.y, 1.2), if f.cam_e.z > 0.0: soft(f.cam_e.z, 1.0) else: soft(f.cam_e.z, 6.0))
    c = A + rh * e.x + uh * e.y + fh * e.z
    sw = swell_at(f64(c.x), f64(c.z), f.sea_t)
    c.y = max(c.y, f32(max(f64(sw.x) + 1.3, surface_height(f64(c.x), f64(c.z)) + 1.3)))
    # (looking around: the camera swung about the aircraft)
    if abs(f.look_yaw) + abs(f.look_pitch) > 0.001:
        rel = c - P
        rel = quat_rotate(quat_axis_angle(vec3(0, 1, 0), f.look_yaw), rel)
        side = normalize(cross(rel, vec3(0, 1, 0)))
        rel = quat_rotate(quat_axis_angle(side, f.look_pitch), rel)
        c = P + rel
        g2 = max(f64(swell_at(f64(c.x), f64(c.z), f.sea_t).x), surface_height(f64(c.x), f64(c.z))) + 1.3
        c.y = max(c.y, f32(g2))
    f.cam_pos = c
    # where it looks: ahead along the path, leading into the turn, down a little when low
    yaw_rate = f64(dot(cross(fh, vdir), uh)) * 6.0
    T = P + fh * f32(22.0 + D * 0.4) + rh * f32(clamp(yaw_rate * sp * 0.2, -8.0, 8.0)) - uh * f32(4.0 * low)
    want = normalize(T - c)
    if abs(f.look_yaw) + abs(f.look_pitch) > 0.001:
        lk = smoothstep(0.0, 0.4, abs(f.look_yaw) + abs(f.look_pitch))
        want = normalize(want * f32(1.0 - lk) + normalize(P - c) * f32(lk))
    if not f.placed: f.look = want
    # (the aim keeps the aircraft well in the picture: stiff enough that it never runs to the edge)
    lw = 11.0
    f.look_v += ((want - f.look) * f32(lw * lw) - f.look_v * f32(2.0 * 0.85 * lw)) * f32(dt)
    f.look = normalize(f.look + f.look_v * f32(dt))
    _, _, bank = _attitude(st)
    want_roll = if st.on_water or st.moored: 0.0 else: 0.2 * bank
    f.roll = f.roll + (want_roll - f.roll) * (1.0 - exp(-3.0 * dt))
    f.cam_up = quat_rotate(quat_axis_angle(f.look, f.roll), vec3(0, 1, 0))
    # the view widens a touch with speed, and kicks with a change of pace
    along = f64(ah.z)
    f.a_fast = f.a_fast + (along - f.a_fast) * (1.0 - exp(-8.0 * dt))
    f.a_slow = f.a_slow + (along - f.a_slow) * (1.0 - exp(-1.0 * dt))
    f.fov = 60.0 + 6.0 * sfrac + clamp(0.6 * (f.a_fast - f.a_slow), -3.0, 4.0)
    # (slow: the camera goes over to its orbit about the aircraft, and back when flying again)
    f.orbit_w = f.orbit_w + ((if f.orbiting: 1.0 else: 0.0) - f.orbit_w) * (1.0 - exp(-3.0 * dt))
    if not f.placed: f.orbit_w = if f.orbiting: 1.0 else: 0.0
    if f.orbit_w > 0.001:
        piv = P + vec3(0, 1.5, 0)
        cp = cos(f.orbit_pitch)
        dir = heading_vector(f.orbit_yaw) * f32(cp) + vec3(0, f32(sin(f.orbit_pitch)), 0)
        oc = piv + dir * f32(f.orbit_dist)
        oc.y = max(oc.y, f32(max(f64(swell_at(f64(oc.x), f64(oc.z), f.sea_t).x), surface_height(f64(oc.x), f64(oc.z))) + 1.3))
        ow = f32(f.orbit_w)
        f.cam_pos = f.cam_pos + (oc - f.cam_pos) * ow
        f.look = normalize(f.look + (normalize(piv - oc) - f.look) * ow)
        f.cam_up = normalize(f.cam_up + (vec3(0, 1, 0) - f.cam_up) * ow)
    f.placed = true

# how it feels to be going: the load on the wings (from how fast the way it goes is turning), the
# field of view opening with speed, a buffet when fast and low, or pulling hard
feel = (f: mut Flyer, dt: f64):
    v = f.state.velocity
    sp = f64(length(v))
    dir = if sp > 1.0: v / f32(sp) else: f.prev_dir
    turn = f64(length(dir - f.prev_dir)) / max(dt, 1e-4)
    f.prev_dir = dir
    g = 1.0 + turn * true_speed(f.spec, sp) / 9.81
    f.load = f.load + (min(g, 8.0) - f.load) * (1.0 - exp(-6.0 * dt))
    pull = smoothstep(2.2, 5.0, f.load)
    # (a buffet only from the wings themselves: pulling toward the stall)
    near_stall = 1.0 - smoothstep(f.spec.stall_speed * 1.05, f.spec.stall_speed * 1.6, sp)
    f.shake = if f.state.on_water: 0.0 else: clamp(pull * near_stall * 0.8, 0.0, 1.0)

place_chase_camera = (f: Flyer, t: f64):
    # the view hums only once it is really fast (the airframe itself shakes sooner), and shakes in a
    # buffet or a crash
    sp = f64(length(f.state.velocity))
    hum = if f.state.on_water: 0.0 else: smoothstep(75.0, 125.0, true_speed(f.spec, sp)) * 0.12
    side = normalize(cross(f.look, f.cam_up) + vec3(0.0001, 0, 0))
    up = normalize(cross(side, f.look))
    target = f.cam_pos + f.look * 50.0 + side * f32(sin(t * 61.0) * hum) + up * f32(sin(t * 53.0 + 1.3) * hum)
    a = f.shake * f.shake * 0.35 + f.jolt * 0.8
    # (shaken about the camera's own axes, whichever way it faces)
    jitter = (side * f32(noise(t * 9.0, 1.0) - 0.5) + up * f32(noise(t * 11.0, 7.0) - 0.5) + f.look * f32(noise(t * 8.0, 13.0) - 0.5)) * f32(a)
    camera3d(f.cam_pos + jitter * 0.3, target + jitter * 5.0, f.fov, 0.5, world_far(f64(f.cam_pos.y)), f.cam_up)

# the dock nearest the aircraft, when it is slow and close enough to moor there
mooring_spot = (f: Flyer, towns: Town[]) -> vec3?:
    if not f.state.on_water and not f.state.moored: return none
    v = length(vec3(f.state.velocity.x, 0, f.state.velocity.z))
    if v > 2.0: return none
    best: vec3? = none
    bd = 22.0
    loop tw in towns:
        loop d in tw.docks:
            l = f64(length(vec2(d.x - f.state.position.x, d.z - f.state.position.z)))
            if l < bd:
                bd = l
                best = d
    best

# spray off the floats as they cut the water, and a wake
spray = (f: Flyer, models: CraftModel[], ps: mut Particles3D):
    if not f.state.on_water: return
    v = f64(length(vec3(f.state.velocity.x, 0, f.state.velocity.z)))
    if v < 3.0: return
    m = craft_transform(f)
    cm = models[f.model]
    n = int(clamp(v / 6.0, 1.0, 6.0))
    loop p in cm.contacts:
        if p.z > 0.0: continue
        w = transform_point(m, p)
        w.y = 0.1
        side = normalize(vec3(f32(f64(p.x)), 0, 0.001))
        dir = normalize(quat_rotate(f.state.orientation, side) + vec3(0, 0.8, 0))
        emit(ps, w, n, v * 0.18, rgba(0.95, 0.97, 1.0, 0.85), 0.9, 0.45, 0.6, dir)

# a flight heading (0 north, east PI/2) as the world's turn (faces (sin, cos))
heading_to_turn = (h: f64) -> f64: PI - h

# where the nose points (a small ring 450 m ahead, where the guns' rounds meet) and where the mouse asks it to go (a cross 400 m
# out along the aim), as Sky Barons shows them
aim_marks = (f: Flyer, nose_marker: bool = true):
    if f.state.on_water or f.state.moored: return
    nose = f.state.position + quat_rotate(f.state.orientation, vec3(0, 0, -1)) * 450.0
    if nose_marker:
        if let p = world_to_screen(nose):
            ring(p, 9, 2, rgba(1, 0.97, 0.9, 0.75))
            circle(p, 2, rgba(1, 0.97, 0.9, 0.75))
    want = f.state.position + aim_dir(f) * 600.0
    if not f.mouse_mode or not is_mouse_locked(): return
    if let p = world_to_screen(want):
        c = rgba(1, 0.85, 0.45, 0.85)
        line(p + vec2(-14, 0), p + vec2(-5, 0), 2, c)
        line(p + vec2(5, 0), p + vec2(14, 0), 2, c)
        line(p + vec2(0, -14), p + vec2(0, -5), 2, c)
        line(p + vec2(0, 5), p + vec2(0, 14), 2, c)

# how the airframe is working now, for drawing it: the wings bowing with the load, shaking with
# the engine and the air, fluttering at speed (and the half span they are measured by)
airframe = (f: Flyer) -> vec4:
    vis = f64(length(f.state.velocity))
    sp = if tweaks.airframe_true: true_speed(f.spec, vis) else: (if tweaks.pure_scale: vis / f.spec.handling_scale else: vis)
    half = f.spec.span * 0.5
    bow = if f.state.on_water: 0.0 else: clamp((f.load - 1.0) * 0.045, -0.06, 0.3)
    # (by the drawn speed; or, a trial (Tweaks), by the true speed and later: the wings shake from
    # cruise on, the tail and trailing edges flutter only near the top speed and in a dive)
    # (under the pure scale, the true speed being low, they come on sooner)
    pure = tweaks.pure_scale and not tweaks.airframe_true
    shake = f.state.throttle * 0.012 + (if tweaks.airframe_true: smoothstep(45.0, 100.0, sp) else if pure: smoothstep(12.0, 75.0, sp) else: smoothstep(25.0, 95.0, sp)) * 0.04
    flutter = (if tweaks.airframe_true: smoothstep(70.0, 110.0, sp) else if pure: smoothstep(25.0, 80.0, sp) else: smoothstep(40.0, 100.0, sp)) * (0.4 + 0.6 * smoothstep(1.5, 4.0, f.load))
    if f.state.on_water: shake += smoothstep(5.0, 40.0, sp) * 0.04
    vec4(f32(bow), f32(shake), f32(flutter), f32(half))
