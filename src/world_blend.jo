# Generic blended world meshes (foam rings, and future translucent glass/markers).
# Use after draw_cloud_layer; opaque meshes retain the regular depth-writing path.
use 'cloud_transparency.jo'
use 'depth_space.jo'
use 'render_space.jo'
struct WorldBlendParams:
    light:LitParams
    clouds:CloudVeil
world_blend_vs=(v:Vertex3D,inst:Instance3D,u:WorldBlendParams)->LitOut:
    o=lit_vs_inst(v,inst,u.light)
    o.pos=u.light.view_proj*vec4(render_world(o.world,u.light.cam_pos),1)
    o.normal=render_normal(o.normal,o.world,u.light.cam_pos)
    o
world_blend_fs=(i:LitOut,u:WorldBlendParams)->vec4:
    if behind_sea(i.world,u.light.cam_pos):discard()
    color=lit_fs(i,u.light)
    vec4(color.xyz,color.w*cloud_transmittance(i.world,u.clouds))
world_blend_shader=Shader()
draw_world_blend=(m:Mesh,instances:Instance3D[],origin:vec3,emissive:f32):
    global world_blend_shader
    if world_blend_shader.prog==0:world_blend_shader=make_world_shader(shader(world_blend_vs,world_blend_fs))
    draw_instanced(world_blend_shader,m,instances,WorldBlendParams(render_lit_params(origin,emissive),cloud_veil))
