# Far conversations are real meetings at the same arrived venue. No renderer chooses their
# words and no district learns the global journal. A bounded slice visits all named districts.
use 'living_types.jo'
use 'life_types.jo'
use 'living_far_people.jo'
use 'living_conversation.jo'

far_social_ready = (w: World, person: int) -> bool:
    if not (person in w.far.people) or person_vehicle_bound(w,person): return false
    p=w.people[person]; a=w.far.people[person]
    if p.state==.departed or p.state==.injured or a.commission>=0 or a.blocked!="" or length(p.pose.pos-a.target)>2: return false
    venue=far_person_venue(w,person)
    venue.kind==.square or venue.kind==.cafe or venue.kind==.market or venue.kind==.quay

far_social_minute = (w: mut World):
    if not w.far.populated or w.far.place_ids.len()==0 or w.minute%5!=0: return
    # Up to24 districts each five minutes; at most one conversation per pair per hour.
    start=w.minute/5*24
    loop offset in 0..min(24,w.far.place_ids.len()):
        place=w.far.place_ids[(start+offset)%w.far.place_ids.len()]
        ids=w.far.districts[place].named
        loop k in 0..ids.len():
            a=ids[k]
            if not far_social_ready(w,a): continue
            loop l in k+1..ids.len():
                b=ids[l]
                if not far_social_ready(w,b) or w.people[b].far_place!=place or length(w.people[a].pose.pos-w.people[b].pose.pos)>5: continue
                ledger=w.speech.get(a,SpeechLedger())
                if w.minute-ledger.last_contact.get(b,-10000)<60: continue
                first=if (w.minute/60+place)%2==0: a else: b
                second=if first==a: b else: a
                topic=if w.people[first].far_reports.len()>0: TalkTopic.news else: TalkTopic.home
                converse(w,first,second,topic)
                converse(w,second,first,if w.people[second].far_reports.len()>0: TalkTopic.news else: TalkTopic.home)
                break
