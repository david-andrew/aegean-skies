# Signals between aircraft within sight of each other, as flights of the 1920s made them when a
# word was wanted and no wireless would carry it: near to, the pilot's arm up out of the cockpit
# and waved (or pointed the way); farther off, an Aldis lamp from the cockpit flashing the word in
# Morse. The flight's words to the player, from one of them in sight, go this way (the caption says
# so); from farther off they come by the R/T as ever. Drawing and timing only: who says what is
# homeward_view's.
use 'combat.jo'
use 'planes.jo'
use 'flight.jo'
use 'world_point.jo'
use 'world_particles.jo'
use 'curved_world.jo'
use 'radio_synth.jo'
use 'nav_lights.jo'

const SIGNAL_HAND = 260.0           # m: near enough to read a hand
const SIGNAL_SIGHT = 2200.0         # m: near enough to read a lamp by day
const SIGNAL_UNIT = 0.12            # s: a Morse unit by lamp (about ten words a minute)
const SIGNAL_LETTERS = 6            # the lamp spells this much of the word at most, then again

enum SignalWay: none, hand, lamp

struct FlightSignal:
    way: SignalWay = .none
    craft = -1
    since = 0.0
    until = 0.0
    code: bool[]                    # the lamp's on and off, unit by unit

# How a word from `craft` reaches the player at `at` (from the flight's aircraft at `from`): by
# hand near to, by lamp in sight, else by the R/T. In sight: neither of them down on the water
# far off, nothing more (a cloud between is not reckoned).
signal_way = (from: vec3, at: vec3) -> SignalWay:
    d = f64(length(from-at))
    if d <= SIGNAL_HAND: return .hand
    if d <= SIGNAL_SIGHT: return .lamp
    .none

# The word the lamp spells for a line: its first word, letters only, a few at most ("FORM", "DOWN").
signal_word = (words: str) -> str:
    u = words.upper()
    from = -1; to = -1
    loop i in 0..u.len():
        c = u[i]
        letter = c >= 'A' and c <= 'Z'
        if letter and from < 0: from = i
        if from >= 0 and (not letter or i-from >= SIGNAL_LETTERS): break
        if letter: to = i+1
    if from < 0: "K" else: u[from..to]

signal_start = (way: SignalWay, craft: int, words: str, now: f64, seconds: f64) -> FlightSignal:
    FlightSignal(way = way, craft = craft, since = now, until = now+seconds, code = radio_morse(signal_word(words)))

# Whether the lamp is lit `t` seconds into the signal (the word over and over, a pause between).
signal_lit = (s: FlightSignal, t: f64) -> bool:
    if s.code.len() == 0 or t < 0.0: return false
    k = int(t/SIGNAL_UNIT)%(s.code.len()+4)
    k < s.code.len() and s.code[k]

# In the aircraft's own frame (+x starboard, -z forward): the pilot's shoulder, beside the cockpit
# rim, and the lamp held up over it.
_shoulder = (kind: Craft) -> vec3:
    p = aircraft_profile(kind)
    vec3(0.30,f32(p.width+0.15),f32(p.cockpit_z))
_lamp = (kind: Craft) -> vec3:
    p = aircraft_profile(kind)
    vec3(-0.32,f32(p.width+0.45),f32(p.cockpit_z-0.25))

# The signal on the aircraft making it: the arm up and waving over the cockpit, or the lamp's
# flashes (a bright point kept a few pixels across far off, as the navigation lamps are).
draw_flight_signal = (s: FlightSignal, b: Battle, now: f64, cam: vec3, fog: f64):
    if s.way == .none or now >= s.until or now < s.since: return
    i = combat_index(b,s.craft)
    if i < 0: return
    a = b.actors[i]
    if not a.present or a.status != .flying or a.state.crashed: return
    st = combat_render_state(a,b.render_alpha)
    if s.way == .hand:
        if f64(length(st.position-cam)) > SIGNAL_HAND*2.0: return
        sh = _shoulder(a.spec.kind)
        t = now-s.since
        # (up, then waved side to side over the head, then down)
        up = smoothstep(0.0,0.4,t)*(1.0-smoothstep(s.until-s.since-0.5,s.until-s.since,t))
        wave = sin(t*7.0)*0.22*up
        hand = sh+vec3(f32(0.10+wave),f32(0.72*up-0.10),f32(-0.05))
        elbow = sh+vec3(f32(0.16+wave*0.4),f32(0.36*up-0.12),0.0)
        p0 = world_vec(craft_offset(st,quat_rotate(st.orientation,sh)))
        p1 = world_vec(craft_offset(st,quat_rotate(st.orientation,elbow)))
        p2 = world_vec(craft_offset(st,quat_rotate(st.orientation,hand)))
        sleeve = rgba(0.36,0.27,0.18,1)
        draw_line3d(p0,p1,sleeve,0.11)
        draw_line3d(p1,p2,sleeve,0.10)
        draw_line3d(p2,p2+(p2-p1)*0.18,rgba(0.80,0.62,0.48,1),0.09)
        return
    if not signal_lit(s,now-s.since): return
    lamps = WorldParticles()
    # (an Aldis by day: overbright, its halo wide, the haze between dimming it)
    nav_lamp(lamps,craft_offset(st,quat_rotate(st.orientation,_lamp(a.spec.kind))),vec3(1.0,0.96,0.85)*1.6,cam,1.0,fog*0.5)
    draw_curved_particles(lamps,true)
