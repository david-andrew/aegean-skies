# Names describe significant state engagements, decided at contact creation without an
# observer. A paid privateer, routine two-ship action or pirate raid earns no battle title.
use 'living_types.jo'
use 'living_war_types.jo'
use 'living_far_types.jo'
use 'living_war.jo'
use 'living_place_context.jo'

official_battle_force = (w: World, unit: int) -> bool:
    if unit<0 or unit>=w.war.units.len(): return false
    u=w.war.units[unit]
    if u.retired or u.vehicle<0 or u.vehicle>=w.far.vehicles.len() or u.supplied_until<w.minute or u.stock.qty[8]<3: return false
    v=w.far.vehicles[u.vehicle]
    v.hull>350 and v.duty!=.privateer and v.duty!=.merchant and v.provisions.qty[3]>0 and v.crew[0]+v.crew[1]+v.crew[2]>=4

battle_seat = (w: World, place: int) -> bool:
    loop country in w.countries:
        if (if country.capital_id>=0: country.capital_id else: country.seat)==place: return true
    false

national_battle_name = (w: World, a: int, b: int, at: vec3) -> str?:
    if not official_battle_force(w,a) or not official_battle_force(w,b): return none
    ua=w.war.units[a]; ub=w.war.units[b]
    if ua.country==ub.country or not war_hostile(w,ua.country,ub.country): return none
    va=w.far.vehicles[ua.vehicle]; vb=w.far.vehicles[ub.vehicle]
    crew=va.crew[0]+va.crew[1]+va.crew[2]+vb.crew[0]+vb.crew[1]+vb.crew[2]
    loop unit in [a,b]:
        u=w.war.units[unit]
        if u.order>=0:
            o=w.war.orders[u.order]
            if (o.task==.occupy or o.task==.blockade) and length(w.place_contexts[o.target].center-at)<6000:
                critical=battle_seat(w,o.target) or w.far.districts[o.target].population>=720
                if critical and crew>=16: return "Battle {if o.task==.blockade: "off" else: "for"} {life_place_name(w,o.target)}"
        if let group=u.convoy:
            v=w.far.vehicles[group.merchant]
            if v.journey>=0:
                j=w.far.journeys[v.journey]
                if j.id==group.voyage and (j.good==3 or j.good==6) and j.quantity*w.goods[j.good].package_grams/1000>=1000000 and (battle_seat(w,group.destination) or w.far.districts[group.destination].population>=720) and crew>=16:
                    return "Battle of the {life_place_name(w,group.destination)} Convoy"
    # A real local concentration on both sides can make a fleet battle away from a port.
    sides: int[2]; people=0
    loop k in 0..w.war.units.len():
        if not official_battle_force(w,k): continue
        u=w.war.units[k]; v=w.far.vehicles[u.vehicle]
        if (u.country!=ua.country and u.country!=ub.country) or length(v.pos-at)>1500: continue
        if u.order>=0 and (w.war.orders[u.order].task==.withdraw or w.war.orders[u.order].task==.repair): continue
        sides[if u.country==ua.country: 0 else: 1]+=1
        people+=v.crew[0]+v.crew[1]+v.crew[2]
    if sides[0]<2 or sides[1]<2 or people<32: return none
    nearest= -1; distance=1e30
    loop place in w.far.place_ids:
        d=f64(length(w.place_contexts[place].center-at))
        if d<distance: nearest=place; distance=d
    if nearest<0: return none
    "Battle {if va.kind==.ship and vb.kind==.ship: "off" else: "of"} {life_place_name(w,nearest)}"

engagement_name = (w: World, engagement: int) -> str?:
    if engagement<NATIONAL_ENGAGEMENT_BASE: return none
    loop _, c in w.war.contacts:
        if c.engagement==engagement and c.name!=none: return c.name
    none

struct WarEngagementView:
    contact: int
    engagement: int
    name: str?
    pos: vec3
    countries: int[2]
    started: int

# Only a currently physical contact is exposed for a nearby join/title-card decision.
# The UI decides when the player actually joins and remembers which card it already showed.
war_engagements = (w: World, observer: vec3, radius: f64 = 6000.0) -> WarEngagementView[]:
    result: WarEngagementView[]
    ids=w.war.contacts.keys(); ids.sort()
    loop id in ids:
        c=w.war.contacts[id]
        if c.state!=.physical or length(c.pos-observer)>radius: continue
        result.push(WarEngagementView(c.id,c.engagement,c.name,c.pos,[w.war.units[c.a].country,w.war.units[c.b].country],c.started))
    result
