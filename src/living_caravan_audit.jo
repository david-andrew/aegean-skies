# Optional bounded process-local diagnostics. Never saved; no RNG or simulation writes.
caravan_audit_enabled = false
caravan_audit_counts: {str: int}

caravan_audit = (reason: str, amount: int = 1):
    global caravan_audit_counts
    if caravan_audit_enabled: caravan_audit_counts[reason]=caravan_audit_counts.get(reason,0)+amount

reset_caravan_audit = ():
    global caravan_audit_counts
    caravan_audit_counts={}

caravan_audit_report = () -> str[]:
    keys=caravan_audit_counts.keys(); keys.sort()
    [loop key in keys: "{key}={caravan_audit_counts[key]}"]

set_caravan_audit = (enabled: bool):
    global caravan_audit_enabled
    caravan_audit_enabled=enabled
