use 'settlement_ports.jo'
use 'settlements.jo'
use 'objects.jo'
use 'town_details.jo'
use 'town_region.jo'
use 'town_regional_mesh.jo'

port_quay_mesh = (vs: mut Vertex3D[],q: PortQuay,detail: bool):
    if q.street_profile.len()>1:
        loop k in 1..q.street_profile.len():
            a=mix(q.a,q.b,f32(k-1)/f32(q.street_profile.len()-1))
            b=mix(q.a,q.b,f32(k)/f32(q.street_profile.len()-1))
            a.y=q.street_profile[k-1]; b.y=q.street_profile[k]
            port_quay_mesh(vs,PortQuay(a,b,q.width,street=true,profile=true),false)
        return
    len=length(q.b.xz-q.a.xz)
    if abs(q.a.y-q.b.y)>0.01 and not q.profile:
        pad=min(6.5,len*0.25); a=mix(q.a,q.b,pad/len); b=mix(q.a,q.b,1.0-pad/len)
        a.y=q.a.y; b.y=q.b.y
        # Tessellate the landing/ramp/landing profile explicitly.
        loop pair in [(q.a,a),(a,b),(b,q.b)]:
            start=vs.len(); part=PortQuay(pair.0,pair.1,q.width,street=true)
            delta=part.b-part.a; mid=(part.a+part.b)*0.5
            add_box(vs,vec3(0,(part.a.y-6.0)*0.5,0),vec3(f32(q.width),part.a.y+6.0,length(delta.xz)),rgb(0.8,0.76,0.68),translation(vec3(mid.x,0,mid.z))*rotation_y(atan2(f64(delta.x),f64(delta.z))))
            loop k in start..vs.len():
                u=clamp(dot(vs[k].pos.xz-part.a.xz,delta.xz)/dot(delta.xz,delta.xz),0.0,1.0)
                vs[k].pos.y+=(part.b.y-part.a.y)*u
        return
    start=vs.len()
    if detail and not q.street and not q.profile: add_quay(vs,q.a.xz,q.b.xz,q.width,f64(q.a.y))
    else:
        delta=q.b-q.a; mid=(q.a+q.b)*0.5
        add_box(vs,vec3(0,(q.a.y-6.0)*0.5,0),vec3(f32(q.width),q.a.y+6.0,length(delta.xz)),rgb(0.8,0.76,0.68),translation(vec3(mid.x,0,mid.z))*rotation_y(atan2(f64(delta.x),f64(delta.z))))
    delta=q.b.xz-q.a.xz
    loop k in start..vs.len():
        u=clamp(dot(vs[k].pos.xz-q.a.xz,delta)/dot(delta,delta),0.0,1.0)
        vs[k].pos.y += port_deck(q,u)-q.a.y
    # Rounded joins close the acute corners between waterfront strips.
    if not q.profile and not q.street: add_cylinder(vs,vec3(q.b.x,-6,q.b.z),q.width*0.5,f64(q.b.y)+6.0,rgb(0.8,0.76,0.68),if detail: 10 else: 6)

port_notice_mesh = (vs: mut Vertex3D[],at: vec3,yaw: f64,country: int=0):
    m=translation(at)*rotation_y(yaw)
    loop side in [-1.0,1.0]: add_box(vs,vec3(f32(side*0.9),0.9,0),vec3(0.12,1.8,0.12),rgb(0.42,0.3,0.19),m)
    add_box(vs,vec3(0,1.45,0),vec3(2.1,1.1,0.08),if country==1:rgb(0.23,0.34,0.25) else:if country==2:rgb(0.18,0.36,0.50) else:rgb(0.5,0.36,0.22),m)
    loop k in 0..5: add_box(vs,vec3(f32(-0.75+f64(k)*0.37),f32(1.4+f64(k%3)*0.1),0.06),vec3(0.28,0.34,0.02),rgb(0.95,0.91,0.8),m)
    add_gable(vs,vec3(0,2.05,0),2.2,0.5,0.25,ROOFS[1],m)

# Plaster walls already reach two metres below the nominal floor. The stone
# foundation starts at that bottom edge, rather than covering the same faces
# from -2 to 0. A shared edge is stable under reversed and logarithmic depth;
# moving one of two coincident faces by a depth bias would only hide the defect.
port_foundation_mesh = (vs: mut Vertex3D[],m: mat4,width: f64,depth: f64,base: f64):
    if base<=2.0: return
    add_box(vs,vec3(0,f32(-(base+2.0)*0.5),0),vec3(f32(width),f32(base-2.0),f32(depth)),rgb(0.65,0.62,0.54),m)

build_port_mesh = (s: WorldSettlement,detail: bool) -> Vertex3D[]:
    vs: Vertex3D[]
    if s.legacy>=0 or s.harbor.len()==0: return vs
    port=settlement_port(s); yaw=atan2(f64(s.out.x),f64(s.out.y))
    loop q in port.quays:
        port_quay_mesh(vs,q,detail)
        if not detail or q.street or q.profile: continue
        delta=q.b-q.a; len=f64(length(delta.xz)); n=vec2(-delta.z,delta.x)/f32(len)
        loop k in 0..max(1,int(len/36.0)):
            at=mix(q.a,q.b,f32((6.0+f64(k)*36.0)/len))+vec3(n.x,0,n.y)*f32(q.width*0.5-1.0)
            port_region_lamp(vs,at,s.country)
        if q.mole:
            add_cylinder(vs,q.b,0.7,2.5,rgb(0.86,0.82,0.71),8)
            add_box(vs,q.b+vec3(0,2.8,0),vec3(0.5,0.6,0.5),rgba(0.9,0.28,0.16,0.7))
    loop b in port.buildings:
        m=translation(b.at)*rotation_y(yaw)
        if detail:
            low=f64(b.at.y)-2.0
            side=vec2(-s.out.y,s.out.x)
            loop x in [-1.0,1.0]:
                loop z in [-1.0,1.0]: low=min(low,place_ground(b.at.xz+side*f32(x*b.width*0.5)+s.out*f32(z*b.depth*0.5)))
            base=f64(b.at.y)-low
            port_foundation_mesh(vs,m,b.width,b.depth,base)
            if b.kind=="warehouse":
                wall=if s.country==2: WALLS[0] else: rgb(0.82,0.71,0.53)
                add_plaster_box(vs,vec3(0,f32(b.height*0.5-1.0),0),vec3(f32(b.width),f32(b.height+2.0),f32(b.depth)),wall,m)
                region_roof(vs,m,b.width,b.depth,b.height,s.country,town_service_flat(s.seed,s.country,true))
                loop x in [-7.0,0.0,7.0]: add_box(vs,vec3(f32(x),6.2,f32(b.depth*0.5+0.06)),vec3(1.8,1.1,0.1),rgb(0.23,0.27,0.28),m)
            else:
                start=vs.len()
                region_house(vs,m,b.width,b.depth,b.height,s.country,town_service_flat(s.seed+int(b.width),s.country,false))
                loop k in start..vs.len():vs[k].color*=town_region_color(s.seed+int(b.width),s.country)
            if b.kind=="harbour office":
                # Enamel harbour sign and civic pennant. Country colours match
                # the established aircraft markings, not a new military lease.
                ink=if s.country==1:rgb(0.23,0.34,0.25) else:rgb(0.18,0.36,0.50)
                add_box(vs,vec3(0,4.0,f32(b.depth*0.5+0.24)),vec3(3.4,0.8,0.20),ink,m)
                loop k in 0..5:add_box(vs,vec3(-1.2+f32(k)*0.6,4.0,f32(b.depth*0.5+0.36)),vec3(0.3,0.10,0.05),WALLS[0],m)
                pole=vec3(f32(b.width*0.35),4.6,f32(b.depth*0.5+0.65))
                # Mount below the eaves, clear of the facade and its windows.
                # A pole starting at roof-floor height would be buried in a gable.
                loop y in [4.7,7.8]:add_box(vs,vec3(pole.x,f32(y),f32(b.depth*0.5+0.32)),vec3(0.1,0.1,0.65),ink,m)
                flag=if s.country==1:rgb(0.14,0.32,0.63) else:rgb(0.72,0.18,0.13)
                add_cylinder(vs,pole,0.06,3.5,ink,5,-1,m)
                loop k in 0..3:
                    # Three short folded panels suggest a cloth pennant.
                    add_box(vs,pole+vec3(0.35+f32(k)*0.5,2.8,f32(k%2)*0.12),vec3(0.52,0.8,0.06),if k==1:rgb(0.95,0.92,0.8) else:flag,m)
            # The functional door follows its actual street elevation, including hillside basements.
            dy=b.door.y-b.at.y
            add_box(vs,vec3(0,dy+1.5,f32(b.depth*0.5+0.08)),vec3(if b.kind=="warehouse": 3.8 else: 1.3,3,0.1),rgb(0.19,0.26,0.28),m)
        else:region_house(vs,m,b.width,b.depth,b.height,s.country,town_service_flat(s.seed+int(b.width),s.country,b.kind=="warehouse"),false)
    if not detail: return vs
    # These paths contain no goods: rendered cargo always belongs to the economy.
    town_path(vs,s.center.xz,port.quays[0].a.xz,4.0,true)
    loop b in port.buildings: town_path(vs,port.quays[0].a.xz,b.door.xz,3.0,true)
    port_notice_mesh(vs,port.board,yaw,s.country)
    port_region_lamp(vs,port.board-vec3(-s.out.y,0,s.out.x)*f32(s.harbor[0].width-2.0),s.country)
    if s.kind==.capital or s.kind==.port:
        at=port_point(s.harbor[0].quay_b,s.harbor[0].deck)
        side=vec3(-s.out.y,0,s.out.x)
        town_beam(vs,at,at+vec3(0,10,0),0.25,rgb(0.27,0.28,0.23))
        town_beam(vs,at+vec3(0,10,0),at+side*10.0+vec3(0,12,0),0.2,rgb(0.27,0.28,0.23))
        town_beam(vs,at+side*10.0+vec3(0,12,0),at+side*10.0+vec3(0,2,0),0.035,rgb(0.16,0.16,0.14))
    loop d in s.harbor: add_cylinder(vs,d.buoy,0.7,1.0,rgba(0.8,0.34,0.15,0.5),8,0.3)
    loop k in 0..port.boats.len(): add_boat(vs,translation(port.boats[k])*rotation_y(port.boat_headings[k]),place_hash(s.seed,k+700))
    vs

# Both families are fixed geometry in the existing district draw, not more draws.
port_region_lamp = (vs: mut Vertex3D[],at: vec3,country: int):
    if country==1:
        green=rgb(0.22,0.30,0.24)
        add_cylinder(vs,at,0.09,4,green,6)
        town_beam(vs,at+vec3(0,3.8,0),at+vec3(0.85,4,0),0.075,green)
        add_box(vs,at+vec3(0.85,3.6,0),vec3(0.38,0.6,0.38),rgba(0.95,0.85,0.55,0.8))
        add_gable(vs,at+vec3(0.85,3.9,0),0.2,0.2,0.22,green,mat4())
    else:
        add_cylinder(vs,at,0.24,0.8,WALLS[0],8)
        add_cylinder(vs,at+vec3(0,0.8,0),0.075,2.6,DOORS[0],6)
        add_sphere(vs,at+vec3(0,3.55,0),0.28,rgba(0.95,0.88,0.67,0.8),8,4)
