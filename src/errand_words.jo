# What an errand is called and said, everywhere it shows: the board's notice, the poster's ask, the
# one waiting on the dock, the leads and the pilot's name (src/errand_types.jo). Pure, World only.
use 'living_types.jo'
use 'errand_types.jo'
use 'living_place_context.jo'
use 'living_talk_words.jo'

errand_of = (w: World, job: int) -> Errand?: if job in w.errands: w.errands[job] else: none

_first = (w: World, p: int) -> str: short_name(w,p)

# What is carried, with its article ("the mail bag", "the morning papers").
errand_label = (k: ErrandKind) -> str:
    match k:
        .mail: "the mail bag"
        .papers: "the morning papers"
        .ice: "the ice"
        .sponges: "the sponges"
        .nurse: "the nurse"

# The board's notice: its title and its words.
errand_notice = (w: World, e: Errand) -> (str, str):
    j = w.jobs[e.job]
    to = life_place_name(w,j.destination)
    who = _first(w,e.recipient)
    match e.kind:
        .mail: ("The mail for {to}", "The bag is made up and sealed at the office. {who} keeps the post at {to} and meets the aircraft.")
        .papers: ("The Courier for {to}", "Today's papers, bundled, wanted on {to}'s tables by breakfast. {who} takes them in.")
        .ice: ("Ice for {to}", "Block ice in sawdust from the ice works, for the fish at {to}. Two hours before it is water. {who} waits for it.")
        .sponges: ("Sponges for {to}", "A diver's catch, dried and baled, for {who} at {to}.")
        .nurse: ("The nurse to {to}", "{_first(w,j.passenger)} is wanted at {to}: {e.child} is ill. Quickly, if you can.")

# The poster's own ask, when the pilot asks after work.
errand_ask = (w: World, e: Errand) -> str:
    j = w.jobs[e.job]
    to = life_place_name(w,j.destination)
    who = _first(w,e.recipient)
    match e.kind:
        .mail: "The mail for {to} is made up. Would you fly it over? {who} will meet you."
        .papers: "The papers want to be on {to}'s tables by breakfast. Can you get them there?"
        .ice: "There's ice for {who}'s fish at {to}. Two hours, then it's water."
        .sponges: "I've sponges for {who} at {to}. Dried and baled; they're no trouble."
        .nurse: "{e.child} at {to} is ill, and I'm wanted there. Will you take me?"

# The one waiting on the dock, as the aircraft comes in.
errand_waiting = (w: World, e: Errand) -> str:
    j = w.jobs[e.job]
    match e.kind:
        .mail: "Is that the mail?"
        .papers: "The papers! Just in time."
        .ice: "Is it still ice?"
        .sponges: "Those'll be {_first(w,j.poster)}'s sponges."
        .nurse: "Thank God you've come."

# Their thanks, as it is handed over (`late` it came after the hour wanted).
errand_thanks = (w: World, e: Errand, late: bool) -> str:
    match e.kind:
        .mail: if late: "Late, but here. People will be glad of it." else: "Good. I'll have it sorted by noon."
        .papers: if late: "Late for breakfast. They'll read it at lunch." else: "On the tables before the coffee's cold."
        .ice: if late: "Half of it's water. The fish will have to take their chances." else: "Still hard. The fish will keep."
        .sponges: "Fine ones. They'll sell."
        .nurse: if late: "Thank you. Let's hope it's not too late." else: "Thank you. Now, where's the child?"

# A lead's line about it, said by someone in the poster's harbour.
errand_lead = (w: World, e: Errand) -> str:
    j = w.jobs[e.job]
    to = life_place_name(w,j.destination)
    match e.kind:
        .mail: "{_first(w,j.poster)}'s got the mail for {to} waiting."
        .papers: "The papers for {to} are sitting on the dock."
        .ice: "There's ice at the works for {to}, going soft."
        .sponges: "{_first(w,j.poster)} has sponges for {to}."
        .nurse: "{e.child}'s ill at {to}. {_first(w,j.passenger)} needs taking over."

# What others say of it, done (a deed of his: src/reputation_talk.jo), by how well they know him:
# 0 a stranger, 1 an acquaintance, 2 a friend.
errand_said = (w: World, e: Errand, tie: int) -> str[]:
    j = w.jobs[e.job]
    to = life_place_name(w,j.destination)
    match e.kind:
        .mail: if tie == 2: ["Postman now, are we?","The mail came early. Your doing."] else: if tie == 1: ["The mail came in early today. That was you?","Heard you're flying the mail now."] else: ["You're the one flying the mail, aren't you?","You brought the mail over, I heard."]
        .papers: if tie == 2: ["We had the paper with our coffee. Thank you."] else: ["The papers came in before breakfast. That was you?","You brought the papers, didn't you?"]
        .ice: if tie == 2: ["The fish kept, thanks to you."] else: ["Heard you flew the ice over.","You're the one who brought the ice."]
        .sponges: ["You brought the sponges over, didn't you?","Heard you flew the sponges in."]
        .nurse: if tie == 2: ["How's the little one? You'd know."] else: ["You flew the nurse out to {to}, didn't you?","Heard you took the nurse over. Good of you."]

# His own word of it, his day (src/pilot_talk.jo).
errand_day = (w: World, e: Errand, at: str) -> str[]:
    j = w.jobs[e.job]
    to = life_place_name(w,j.destination)
    match e.kind:
        .mail: ["Flew the mail across {at}.","Mail run. Nothing to it."]
        .papers: ["Took the papers over at dawn.","Papers, first thing."]
        .ice: ["Ice run {at}. Most of it arrived as ice.","Flew ice over to {to}."]
        .sponges: ["Brought sponges over from {life_place_name(w,j.origin)}.","Sponges. Smelt of the sea."]
        .nurse: ["Flew the nurse out to {to}.","Took the nurse over to a sick child."]
