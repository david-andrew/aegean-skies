# Which build this is, in a small label at the bottom of the screen, so a player can say which one
# was played: the short commit, CI's run number and the day, as Pages writes data/build.txt before
# building ("local" from a build at home). Always shown in the pause menu (its Settings too); in
# play, while Settings > Display > Build number is on (on by default for now). A click or tap on it,
# with the pointer free, copies it to the clipboard ("Copied" for a moment in its place).
use 'phoenix.jo'
use 'touch.jo'
use 'hud.jo'

BUILD_NAME = trim(str_from_bytes(embed('../data/build.txt')))
build_copied_until = -1.0

draw_build_label = (fonts: Fonts, shown: bool):
    global build_copied_until
    if not shown or BUILD_NAME == "": return
    words = "build {BUILD_NAME}"
    set_font(fonts.ui)
    size = readable(11.0)
    w = text_width(words, size)
    at = vec2(f32((f64(screen_width()) - w) * 0.5), f32(f64(screen_height()) - size - 4.0))
    # (its box, a little generous for a finger)
    r = Rect(at.x - 8.0, at.y - 6.0, f32(w) + 16.0, f32(size) + 10.0)
    if not is_mouse_locked() and mouse_pressed(.left) and contains(r, mouse_pos()):
        set_clipboard(words)
        build_copied_until = time() + 1.5
    shown_words = if time() < build_copied_until: "Copied" else: words
    sat = if shown_words == words: at else: vec2(f32((f64(screen_width()) - text_width(shown_words, size)) * 0.5), at.y)
    text(shown_words, sat + vec2(1, 1), size, rgba(0, 0, 0, 0.45))
    text(shown_words, sat, size, rgba(1, 0.97, 0.9, if shown_words == words: 0.55 else: 0.85))
    set_font()
