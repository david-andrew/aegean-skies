use 'terrain_lod.jo'
use 'world_source.jo'
use 'river_banks.jo'
use 'look.jo'
use 'geography.jo'
use 'river_field.jo'
use 'water_field.jo'
use 'water_types.jo'
use 'river_data.jo'
use 'render_space.jo'
use 'depth_space.jo'
use 'cloud_depth.jo'
# Bounded ribbon batches, using the sea's optical material and world-depth path.
use 'sea.jo'
struct InlandWaterVertex:
    pos:vec3
    current:vec2=vec2(0,0)
    depth:f32=5.0
    chart:vec2=vec2(0,0)
    impact:f32=0.0
    chart_flow:vec2=vec2(0,0)
type RiverVertex=InlandWaterVertex
river_vertex=(p:vec3,flow:vec2,chart:vec2=vec2(0,0))->RiverVertex:
    r=water_at(f64(p.x),f64(p.z))
    impact=f32(clamp(-r.bend*r.lateral/r.width*3.0,0.0,1.0))
    InlandWaterVertex(p,flow,f32(max(0.0,f64(p.y)-world_source_surface(f64(p.x),f64(p.z)))),chart,impact,vec2(length(flow),0))
# Lake meshes use world-metric chart coordinates and the source's physical current.
# All inland water shares the same material, marks, scale and opacity treatment.
inland_water_vertex=(p:vec3)->InlandWaterVertex:
    water=water_at(f64(p.x),f64(p.z))
    InlandWaterVertex(p,water.current.xz,f32(max(0.0,f64(p.y)-world_source_surface(f64(p.x),f64(p.z)))),p.xz,0.0,water.current.xz)
struct RiverBatch:
    mesh:Mesh
    center:vec3
    bounds:vec3
    radius:f64
    # Triangles whose every vertex is at least 2 m deep, where the inland
    # material is exactly opaque: the opaque depth prepass needs no discard.
    occluder:Mesh=Mesh()
    occluder_count:int=0
    first:int=0
    count:int=0
river_batches:RiverBatch[]
# Batches sharing one material anchor (16 stations), as single meshes. Far
# groups and the opaque prepass draw these: far fewer draws and uniform uploads.
river_groups:RiverBatch[]
river_shader:Shader
river_depth_shader:Shader
river_far_shader:Shader
river_far_depth_shader:Shader
river_occlusion_shader:Shader
inland_depth_frame= -1
inland_depth_snapshot=Texture()
river_vs=(v:RiverVertex,u:SeaParams)->SeaOut:
    p=v.pos-u.origin
    SeaOut(u.view_proj*vec4(render_warped(p,u.cam,u.warp_a,u.warp_b),1),p,v.current,v.depth,v.chart,v.impact,v.chart_flow)
river_depth_vs=(v:RiverVertex,u:SeaParams)->SeaDepthOut:
    i=river_vs(v,u)
    SeaDepthOut(i.pos,i.world,i.pos,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow)
river_fs=(i:SeaOut,u:SeaParams)->vec4:sea_material(i,u,false,true)
river_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    river_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow),u)
river_far_fs=(i:SeaOut,u:SeaParams)->vec4:sea_material(i,u,false,true,false)
river_far_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    river_far_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow),u)
river_batch_visible=(batch:RiverBatch,cam:vec3,planes:vec4[])->bool:
    if length(batch.center.xz-cam.xz)>18000:return false
    if scene_warp_b.x!=0.0:return true
    warped=render_world(batch.bounds,cam)
    d=f64(length(cam.xz-batch.bounds.xz))
    radius=batch.radius+d*batch.radius/EARTH_RADIUS+batch.radius*batch.radius/EARTH_RADIUS+1.0
    loop plane in planes:
        if f64(dot(plane.xyz,warped)+plane.w)< -radius:return false
    true

# The batch's opaque-depth occluder: its triangles at least 2 m deep at every vertex.
river_with_occluder=(batch:RiverBatch,vs:RiverVertex[])->RiverBatch:
    deep:RiverVertex[]
    loop k in 0..vs.len()/3:
        if vs[k*3].depth>=2.0 and vs[k*3+1].depth>=2.0 and vs[k*3+2].depth>=2.0:deep.extend([vs[k*3],vs[k*3+1],vs[k*3+2]])
    result=batch
    if deep.len()>0:result.occluder=mesh(deep);result.occluder_count=deep.len()
    result

river_occlusion_fs=(i:SeaOut,u:SeaParams)->vec4:
    # Occluder triangles are at least 2 m deep at every vertex, so the
    # interpolated depth is too: the inland material is exactly opaque there.
    # Edge shallows still let the ordinary terrain render through them.
    vec4(0,0,0,1)

init_rivers=():
    global river_batches,river_groups,river_shader,river_depth_shader,river_occlusion_shader,river_far_shader,river_far_depth_shader
    if not geography_enabled:return
    init_river_banks()
    river_shader=make_world_shader(shader(river_vs,river_fs))
    river_depth_shader=make_world_shader(shader(river_depth_vs,river_depth_fs))
    river_far_shader=make_world_shader(shader(river_vs,river_far_fs))
    river_far_depth_shader=make_world_shader(shader(river_depth_vs,river_far_depth_fs))
    if world_reverse_depth_active():river_occlusion_shader=make_world_shader(shader(river_vs,river_occlusion_fs))
    distances:f32[]=[0.0]
    loop node in 1..RIVER_NODES.len():
        distances.push(if RIVER_BREAKS.contains(node-1):0.0 else:distances[node-1]+length(RIVER_NODES[node].xy-RIVER_NODES[node-1].xy))
    group_vs:RiverVertex[]
    loop first in 0..(RIVER_NODES.len()-2)/4+1:
        vs:RiverVertex[]
        begin=first*4; finish=min(begin+4,RIVER_NODES.len()-1)
        loop i in begin..finish:
            if RIVER_BREAKS.contains(i):continue
            a=RIVER_NODES[i]; b=RIVER_NODES[i+1]
            # Sea-level estuary uses the ordinary ocean surface, avoiding coplanar passes.
            if a.z<=0.001 and b.z<=0.001:continue
            # Averaged station normals join the banks without corner cracks.
            prev=RIVER_NODES[if RIVER_BREAKS.contains(i-1):i else:max(0,i-1)]
            next=RIVER_NODES[if RIVER_BREAKS.contains(i+1):i+1 else:min(RIVER_NODES.len()-1,i+2)]
            da=normalize(b.xy-prev.xy); db=normalize(next.xy-a.xy)
            na=vec2(-da.y,da.x); nb=vec2(-db.y,db.x)
            # Shoreward portion intersects the actual sloping bank, depth testing clips it.
            lefta=a.xy-na*a.w*1.12; righta=a.xy+na*a.w*1.12
            leftb=b.xy-nb*b.w*1.12; rightb=b.xy+nb*b.w*1.12
            loop cross in 0..12:
                u=f32(cross)/12.0;v=f32(cross+1)/12.0
                xa=mix(lefta,righta,u);xb=mix(lefta,righta,v)
                ya=mix(leftb,rightb,u);yb=mix(leftb,rightb,v)
                aa=river_vertex(vec3(xa.x,a.z,xa.y),da*0.65,vec2(distances[i],(u*2.0-1.0)*a.w*1.12));ab=river_vertex(vec3(xb.x,a.z,xb.y),da*0.65,vec2(distances[i],(v*2.0-1.0)*a.w*1.12))
                ba=river_vertex(vec3(ya.x,b.z,ya.y),db*0.65,vec2(distances[i+1],(u*2.0-1.0)*b.w*1.12));bb=river_vertex(vec3(yb.x,b.z,yb.y),db*0.65,vec2(distances[i+1],(v*2.0-1.0)*b.w*1.12))
                vs.extend([aa,ba,ab,ab,ba,bb])
        if begin==0:
            node=RIVER_NODES[if begin==0:0 else:RIVER_NODES.len()-1]
            center=river_vertex(vec3(node.x,node.z,node.y),vec2(0,0))
            loop j in 0..24:
                a=f64(j)*TAU/24.0;b=f64(j+1)*TAU/24.0
                aa=river_vertex(center.pos+vec3(cos(a),0,sin(a))*node.w*1.12,vec2(0,0),vec2(cos(a),sin(a))*node.w*1.12)
                bb=river_vertex(center.pos+vec3(cos(b),0,sin(b))*node.w*1.12,vec2(0,0),vec2(cos(b),sin(b))*node.w*1.12)
                vs.extend([center,aa,bb])
        # Round the closed ends of the commercial basins; the field's endpoint
        # coverage is a disk, so its rendered surface must include that disk.
        loop endpoint in [loop boundary in RIVER_BREAKS:if boundary>CANAL_FINISH:boundary]+[RIVER_NODES.len()-1]:
            if endpoint<=begin or endpoint>finish:continue
            node=RIVER_NODES[endpoint]
            center=river_vertex(vec3(node.x,node.z,node.y),vec2(0,0))
            loop j in 0..24:
                a=f64(j)*TAU/24.0;b=f64(j+1)*TAU/24.0
                aa=river_vertex(center.pos+vec3(cos(a),0,sin(a))*node.w*1.12,vec2(0,0),vec2(cos(a),sin(a))*node.w*1.12)
                bb=river_vertex(center.pos+vec3(cos(b),0,sin(b))*node.w*1.12,vec2(0,0),vec2(cos(b),sin(b))*node.w*1.12)
                vs.extend([center,aa,bb])
        if vs.len()>0:
            # Preserve the original material anchor while splitting geometry
            # into smaller bounds for visibility and distant shader selection.
            parent=(begin/16)*16
            p=RIVER_NODES[(parent+min(parent+16,RIVER_NODES.len()-1))/2]
            low=vs[0].pos;high=low
            loop vertex in vs:low=min(low,vertex.pos);high=max(high,vertex.pos)
            bounds=(low+high)*0.5;radius=f64(length(high-low))*0.5
            center=vec3(p.x,p.z,p.y)
            if river_groups.len()>0 and river_groups[river_groups.len()-1].center!=center:river_close_group(group_vs);group_vs=[]
            if group_vs.len()==0:river_groups.push(RiverBatch(Mesh(),center,center,0.0,first=river_batches.len()))
            group_vs.extend(vs)
            river_batches.push(river_with_occluder(RiverBatch(mesh(vs),center,bounds,radius),vs))
    if group_vs.len()>0:river_close_group(group_vs)
river_close_group=(vs:RiverVertex[]):
    global river_groups
    g=river_groups[river_groups.len()-1]
    low=vs[0].pos;high=low
    loop vertex in vs:low=min(low,vertex.pos);high=max(high,vertex.pos)
    g.mesh=mesh(vs);g.bounds=(low+high)*0.5;g.radius=f64(length(high-low))*0.5
    g.count=river_batches.len()-g.first
    river_groups[river_groups.len()-1]=river_with_occluder(g,vs)

# Common optical state is identical across a scene's inland surface batches.
inland_water_params=(depth:Texture,L:Light,t:f64,velocity:vec3,deep:vec3=vec3(0.025,0.065,0.05),shallow:vec3=vec3(0.18,0.23,0.12),opacity_depth:f64=2.0,chop:f64=0.0)->SeaParams:
    global inland_depth_frame,inland_depth_snapshot
    p=sea_params(depth,L,t,wind_now,velocity,SeaShadows())
    p.inland_depth=5.0;p.wind.w=0.0;p.wind.z=max(p.wind.z,2.0)
    p.fleck_reference=p.deep
    p.deep=deep;p.shallow=shallow;p.inland_opacity_depth=f32(opacity_depth);p.inland_chop=f32(chop)
    p.flow=vec4(0,0,0.6,0)
    if world_log_depth_active() and cloud_scene_depth.id!=0:
        if inland_depth_frame!=frame_number():
            inland_depth_snapshot=snapshot_opaque_depth();inland_depth_frame=frame_number()
        p.opaque_depth=inland_depth_snapshot;p.reject_depth=1
    p

# Water surfaces are fixed: each anchor's sample is queried once.
inland_anchor_samples:{vec3:WaterSample}={}
inland_water_at=(source:SeaParams,center:vec3,velocity:vec3)->SeaParams:
    global inland_anchor_samples
    p=source
    if not (center in inland_anchor_samples):inland_anchor_samples[center]=water_at(f64(center.x),f64(center.z))
    water=inland_anchor_samples[center]
    p.rush=rush_of(velocity,water.level)
    d=normalize(water.current.xz+vec2(0.00001,0));side=vec2(-d.y,d.x)
    along=f64(p.origin.x)*f64(d.x)+f64(p.origin.z)*f64(d.y)
    across=f64(p.origin.x)*f64(side.x)+f64(p.origin.z)*f64(side.y)
    p.inland_phase=vec4(render_phase(along*8.0,TAU),render_phase(across*19.0,TAU),render_phase(along*0.7,TAU),render_phase(along*2.0,TAU))
    p

draw_inland_prepared=(surface:Mesh,p:SeaParams,distant:bool):
    glDepthMask(1)
    shader=if distant:(if world_log_depth_active():river_far_depth_shader else:river_far_shader) else:(if world_log_depth_active():river_depth_shader else:river_shader)
    draw(shader,surface,p)
    glDepthMask(0)

# Stable rendering seam for lake meshes as well as river batches. Init via init_rivers;
# the caller owns geometry/residency/culling. No river bounds or sea-level assumptions here.
draw_inland_water=(surface:Mesh,center:vec3,depth:Texture,L:Light,t:f64,velocity:vec3=vec3(0,0,0),deep:vec3=vec3(0.025,0.065,0.05),shallow:vec3=vec3(0.18,0.23,0.12),opacity_depth:f64=2.0,distant:bool=false,chop:f64=0.0):
    if not geography_enabled:return
    p=inland_water_at(inland_water_params(depth,L,t,velocity,deep,shallow,opacity_depth,chop),center,velocity)
    draw_inland_prepared(surface,p,distant)

draw_rivers=(depth:Texture,L:Light,t:f64,velocity:vec3=vec3(0,0,0)):
    if not geography_enabled:return
    cam=scene_camera()
    if cam.x < -180000 or cam.x > -65000 or cam.z < -182000 or cam.z > -120000:return
    zone("river water")
    planes=land_planes(scene_view_proj())
    p:SeaParams;ready=false
    loop group in river_groups:
        if not river_batch_visible(group,cam,planes):continue
        if not ready:p=inland_water_params(depth,L,t,velocity);ready=true
        p=inland_water_at(p,group.center,velocity)
        # Marks and ripples are exactly zero beyond 450 m: a group wholly past
        # that uses the far material in one draw.
        if f64(length(cam-group.bounds))-group.radius>450.0:
            draw_inland_prepared(group.mesh,p,true)
            continue
        loop index in group.first..group.first+group.count:
            batch=river_batches[index]
            if not river_batch_visible(batch,cam,planes):continue
            draw_inland_prepared(batch.mesh,p,f64(length(cam-batch.bounds))-batch.radius>450.0)
    zone_end()

# Native reversed depth supports early rejection of the expensive bed shader.
# The later water pass overwrites these exact opaque pixels; optical shallows,
# islands, bank geometry and the WebGL2 path keep their existing treatment.
draw_river_occlusion=(depth:Texture,L:Light,t:f64):
    if not geography_enabled or not world_reverse_depth_active():return
    cam=scene_camera()
    if cam.x < -180000 or cam.x > -65000 or cam.z < -182000 or cam.z > -120000:return
    zone("river opaque depth")
    planes=land_planes(scene_view_proj())
    p=sea_params(depth,L,t,wind_now,vec3(0,0,0),SeaShadows())
    glDepthMask(1)
    # Ribbon triangles are drawn from both sides in the transparent pass.
    # Match that here: their winding must not cull the opaque depth prepass.
    glDisable(GL_CULL_FACE)
    loop group in river_groups:
        if group.occluder_count==0 or not river_batch_visible(group,cam,planes):continue
        draw(river_occlusion_shader,group.occluder,p)
    glEnable(GL_CULL_FACE)
    zone_end()
