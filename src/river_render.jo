use 'world_source.jo'
use 'river_banks.jo'
use 'look.jo'
use 'geography.jo'
use 'river_field.jo'
use 'water_field.jo'
use 'river_data.jo'
use 'render_space.jo'
use 'depth_space.jo'
use 'cloud_depth.jo'
# Bounded ribbon batches, using the sea's optical material and world-depth path.
use 'sea.jo'
struct InlandWaterVertex:
    pos:vec3
    current:vec2=vec2(0,0)
    depth:f32=5.0
    chart:vec2=vec2(0,0)
    impact:f32=0.0
    chart_flow:vec2=vec2(0,0)
type RiverVertex=InlandWaterVertex
river_vertex=(p:vec3,flow:vec2,chart:vec2=vec2(0,0))->RiverVertex:
    r=water_at(f64(p.x),f64(p.z))
    impact=f32(clamp(-r.bend*r.lateral/r.width*3.0,0.0,1.0))
    InlandWaterVertex(p,flow,f32(max(0.0,f64(p.y)-world_source_surface(f64(p.x),f64(p.z)))),chart,impact,vec2(length(flow),0))
# Lake meshes use world-metric chart coordinates and the source's physical current.
# All inland water shares the same material, marks, scale and opacity treatment.
inland_water_vertex=(p:vec3)->InlandWaterVertex:
    water=water_at(f64(p.x),f64(p.z))
    InlandWaterVertex(p,water.current.xz,f32(max(0.0,f64(p.y)-world_source_surface(f64(p.x),f64(p.z)))),p.xz,0.0,water.current.xz)
struct RiverBatch:
    mesh:Mesh
    center:vec3
river_batches:RiverBatch[]
river_shader:Shader
river_depth_shader:Shader
river_occlusion_shader:Shader
inland_depth_frame= -1
inland_depth_snapshot=Texture()
river_vs=(v:RiverVertex,u:SeaParams)->SeaOut:
    p=v.pos-u.origin
    SeaOut(u.view_proj*vec4(render_warped(p,u.cam,u.warp_a,u.warp_b),1),p,v.current,v.depth,v.chart,v.impact,v.chart_flow)
river_depth_vs=(v:RiverVertex,u:SeaParams)->SeaDepthOut:
    i=river_vs(v,u)
    SeaDepthOut(i.pos,i.world,i.pos,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow)
river_fs=(i:SeaOut,u:SeaParams)->vec4:sea_material(i,u,false,true)
river_depth_fs=(i:SeaDepthOut,u:SeaParams)->vec4:
    if sea_depth_hidden(i.clip,u):discard()
    river_fs(SeaOut(i.pos,i.world,i.current,i.water_depth,i.water_chart,i.bank_impact,i.water_flow),u)
river_occlusion_fs=(i:SeaOut,u:SeaParams)->vec4:
    # The inland material is exactly opaque at this interpolated depth.
    # Edge shallows still let the ordinary terrain render through them.
    if i.water_depth<2.0:discard()
    vec4(0,0,0,1)

init_rivers=():
    global river_batches,river_shader,river_depth_shader,river_occlusion_shader
    if not geography_enabled:return
    init_river_banks()
    river_shader=make_world_shader(shader(river_vs,river_fs))
    river_depth_shader=make_world_shader(shader(river_depth_vs,river_depth_fs))
    if world_reverse_depth_active():river_occlusion_shader=make_world_shader(shader(river_vs,river_occlusion_fs))
    distances:f32[]=[0.0]
    loop node in 1..RIVER_NODES.len():
        distances.push(if RIVER_BREAKS.contains(node-1):0.0 else:distances[node-1]+length(RIVER_NODES[node].xy-RIVER_NODES[node-1].xy))
    loop first in 0..(RIVER_NODES.len()-2)/16+1:
        vs:RiverVertex[]
        begin=first*16; finish=min(begin+16,RIVER_NODES.len()-1)
        loop i in begin..finish:
            if RIVER_BREAKS.contains(i):continue
            a=RIVER_NODES[i]; b=RIVER_NODES[i+1]
            # Sea-level estuary uses the ordinary ocean surface, avoiding coplanar passes.
            if a.z<=0.001 and b.z<=0.001:continue
            # Averaged station normals join the banks without corner cracks.
            prev=RIVER_NODES[if RIVER_BREAKS.contains(i-1):i else:max(0,i-1)]
            next=RIVER_NODES[if RIVER_BREAKS.contains(i+1):i+1 else:min(RIVER_NODES.len()-1,i+2)]
            da=normalize(b.xy-prev.xy); db=normalize(next.xy-a.xy)
            na=vec2(-da.y,da.x); nb=vec2(-db.y,db.x)
            # Shoreward portion intersects the actual sloping bank, depth testing clips it.
            lefta=a.xy-na*a.w*1.12; righta=a.xy+na*a.w*1.12
            leftb=b.xy-nb*b.w*1.12; rightb=b.xy+nb*b.w*1.12
            loop cross in 0..12:
                u=f32(cross)/12.0;v=f32(cross+1)/12.0
                xa=mix(lefta,righta,u);xb=mix(lefta,righta,v)
                ya=mix(leftb,rightb,u);yb=mix(leftb,rightb,v)
                aa=river_vertex(vec3(xa.x,a.z,xa.y),da*0.65,vec2(distances[i],(u*2.0-1.0)*a.w*1.12));ab=river_vertex(vec3(xb.x,a.z,xb.y),da*0.65,vec2(distances[i],(v*2.0-1.0)*a.w*1.12))
                ba=river_vertex(vec3(ya.x,b.z,ya.y),db*0.65,vec2(distances[i+1],(u*2.0-1.0)*b.w*1.12));bb=river_vertex(vec3(yb.x,b.z,yb.y),db*0.65,vec2(distances[i+1],(v*2.0-1.0)*b.w*1.12))
                vs.extend([aa,ba,ab,ab,ba,bb])
        if begin==0:
            node=RIVER_NODES[if begin==0:0 else:RIVER_NODES.len()-1]
            center=river_vertex(vec3(node.x,node.z,node.y),vec2(0,0))
            loop j in 0..24:
                a=f64(j)*TAU/24.0;b=f64(j+1)*TAU/24.0
                aa=river_vertex(center.pos+vec3(cos(a),0,sin(a))*node.w*1.12,vec2(0,0),vec2(cos(a),sin(a))*node.w*1.12)
                bb=river_vertex(center.pos+vec3(cos(b),0,sin(b))*node.w*1.12,vec2(0,0),vec2(cos(b),sin(b))*node.w*1.12)
                vs.extend([center,aa,bb])
        # Round the closed ends of the commercial basins; the field's endpoint
        # coverage is a disk, so its rendered surface must include that disk.
        loop endpoint in [loop boundary in RIVER_BREAKS:if boundary>CANAL_FINISH:boundary]+[RIVER_NODES.len()-1]:
            if endpoint<=begin or endpoint>finish:continue
            node=RIVER_NODES[endpoint]
            center=river_vertex(vec3(node.x,node.z,node.y),vec2(0,0))
            loop j in 0..24:
                a=f64(j)*TAU/24.0;b=f64(j+1)*TAU/24.0
                aa=river_vertex(center.pos+vec3(cos(a),0,sin(a))*node.w*1.12,vec2(0,0),vec2(cos(a),sin(a))*node.w*1.12)
                bb=river_vertex(center.pos+vec3(cos(b),0,sin(b))*node.w*1.12,vec2(0,0),vec2(cos(b),sin(b))*node.w*1.12)
                vs.extend([center,aa,bb])
        if vs.len()>0:
            p=RIVER_NODES[(begin+finish)/2]
            river_batches.push(RiverBatch(mesh(vs),vec3(p.x,p.z,p.y)))
# Stable rendering seam for lake meshes as well as river batches. Init via init_rivers;
# the caller owns geometry/residency/culling. No river bounds or sea-level assumptions here.
draw_inland_water=(surface:Mesh,center:vec3,depth:Texture,L:Light,t:f64,velocity:vec3=vec3(0,0,0)):
    global inland_depth_frame,inland_depth_snapshot
    if not geography_enabled:return
    p=sea_params(depth,L,t,wind_now,velocity,SeaShadows())
    loop mark in 0..3:p.mark_phase[mark]=vec4(0,0,0,0)
    p.glint_phase=vec4(0,0,0,0)
    p.inland_depth=5.0;p.wind.w=0.0;p.wind.z=max(p.wind.z,2.0)
    p.deep=vec3(0.025,0.065,0.05);p.shallow=vec3(0.18,0.23,0.12)
    p.flow=vec4(0,0,0.6,0)
    water=water_at(f64(center.x),f64(center.z))
    p.rush=rush_of(velocity,water.level)
    d=normalize(water.current.xz+vec2(0.00001,0));side=vec2(-d.y,d.x)
    along=f64(p.origin.x)*f64(d.x)+f64(p.origin.z)*f64(d.y)
    across=f64(p.origin.x)*f64(side.x)+f64(p.origin.z)*f64(side.y)
    p.inland_phase=vec4(render_phase(along*8.0,TAU),render_phase(across*19.0,TAU),render_phase(along*0.7,TAU),render_phase(along*2.0,TAU))
    if world_log_depth_active() and cloud_scene_depth.id!=0:
        # All river/lake batches share the opaque snapshot from this scene frame.
        # Copying per reach would both scale GPU work and include earlier water.
        if inland_depth_frame!=frame_number():
            inland_depth_snapshot=snapshot_opaque_depth();inland_depth_frame=frame_number()
        p.opaque_depth=inland_depth_snapshot;p.reject_depth=1
    glDepthMask(1)
    draw(if world_log_depth_active():river_depth_shader else:river_shader,surface,p)
    glDepthMask(0)

draw_rivers=(depth:Texture,L:Light,t:f64,velocity:vec3=vec3(0,0,0)):
    if not geography_enabled:return
    cam=scene_camera()
    if cam.x < -180000 or cam.x > -65000 or cam.z < -182000 or cam.z > -120000:return
    zone("river water")
    loop batch in river_batches:
        if length(batch.center.xz-cam.xz)>18000:continue
        draw_inland_water(batch.mesh,batch.center,depth,L,t,velocity)
    zone_end()

# Native reversed depth supports early rejection of the expensive bed shader.
# The later water pass overwrites these exact opaque pixels; optical shallows,
# islands, bank geometry and the WebGL2 path keep their existing treatment.
draw_river_occlusion=(depth:Texture,L:Light,t:f64):
    if not geography_enabled or not world_reverse_depth_active():return
    cam=scene_camera()
    if cam.x < -180000 or cam.x > -65000 or cam.z < -182000 or cam.z > -120000:return
    zone("river opaque depth")
    p=sea_params(depth,L,t,wind_now,vec3(0,0,0),SeaShadows())
    glDepthMask(1)
    loop batch in river_batches:
        if length(batch.center.xz-cam.xz)>18000:continue
        draw(river_occlusion_shader,batch.mesh,p)
    zone_end()
