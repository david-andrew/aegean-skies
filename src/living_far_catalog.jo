# Offline-derived data tied to the exact authored terrain/settlement layout.
use 'living_far_types.jo'
struct FarRouteCatalog:
    version: int
    terrain: int
    geography: int
    places: u64
    seeds: FarPlaceSeed[]
    links: FarLink[]
    navigation_version = 0           # 1: actual vessel draft/width; 0 requires offline rebake
    access_key:u64=0                  # surveyed bridge profiles, separate from water/terrain
