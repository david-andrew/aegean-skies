# The fullscreen mark (the title's corner, the pause menu's header): four corner brackets,
# pointing out to fill the screen, or in (when it already fills it) to leave it; quiet until the
# pointer is over it. A button like any other: a tap, a click or a controller's focus presses it
# (in a page the browser fills the screen only in answer to one: Sloppy's set_fullscreen waits for
# the next if need be). Drawn only where the screen can be filled (can_fullscreen: not an iPhone's
# Safari); F11 does the same everywhere.

# the fullscreen mark: four corner brackets, pointing out to fill the screen, or in (when it
# already fills it) to leave it
fullscreen_icon = (r: Rect, full: bool, ink: vec4):
    s = f64(r.w) * 0.42                 # (half the mark's width)
    l = s * 0.55                        # (each bracket's arm)
    t = max(1.5, f64(r.w) * 0.06)       # (its stroke)
    cx = f64(r.x) + f64(r.w) * 0.5; cy = f64(r.y) + f64(r.h) * 0.5
    loop sx in [-1.0, 1.0]:
        loop sy in [-1.0, 1.0]:
            # (the bracket's corner: at the mark's corner, arms running in; or, to leave, in where the
            # arms end, running out)
            px = cx + sx * (if full: s - l else: s); py = cy + sy * (if full: s - l else: s)
            dx = if full: sx else: -sx
            dy = if full: sy else: -sy
            rect(min(px, px + dx * l) - t * 0.5, py - t * 0.5, l + t, t, ink)
            rect(px - t * 0.5, min(py, py + dy * l) - t * 0.5, t, l + t, ink)

# the mark as a button in `r`, at opacity `a` (fading in with what it is on): pressed, the screen
# filled or left; the hud style as it was before
fullscreen_mark = (r: Rect, a: f64, enabled: bool = true) -> bool:
    global hud_style
    saved = hud_style
    hud_style.button = rgba(0, 0, 0, 0)
    hud_style.border = rgba(0, 0, 0, 0)
    hud_style.hover = rgba(0.04, 0.06, 0.1, f32(0.35 * a))
    hud_style.pressed = rgba(0.02, 0.03, 0.05, f32(0.5 * a))
    pressed = hud_button(r, "", enabled = enabled)
    hud_style = saved
    if pressed: set_fullscreen(not is_fullscreen())
    hot = contains(r, mouse_pos())
    fullscreen_icon(r, is_fullscreen(), rgba(0.88, 0.88, 0.86, f32((if hot: 0.95 else: 0.5) * a)))
    pressed
