# Thermal baths use the real world clock, pilot condition and cash ledger.
# Rendering and input are adapters; these commands also work in headless tests.
use 'living_types.jo'
use 'thermal_types.jo'
use 'living_money.jo'
use 'living_calendar.jo'
use 'living_sim.jo'

const THERMAL_INN_CENTS=800
thermal_place=(place:int)->bool:place==141625 or place==131459

thermal_until=(minute:int,hour:int)->int:
    remaining=(hour*60-local_minute(minute)+1440)%1440
    minute+(if remaining==0:1440 else:remaining)

thermal_begin=(w:mut World,visit:mut ThermalVisit,place:int,exit:vec3,sleeping:bool=false)->str:
    if visit.active:return "You are already resting."
    if not thermal_place(place) or not (place in w.far.districts):return "The baths are closed."
    p=w.people[w.player]
    if p.trip>=0 or p.carriage>=0 or p.carrying>=0 or p.state==.departed:return "Set down your load before resting."
    if sleeping and (visit.paid_place!=place or visit.paid_until<=w.minute):
        owner=w.far.districts[place].market_account
        # A named local innkeeper receives the rent when one already exists;
        # otherwise the town's account operates its communal guesthouse.
        loop person in w.far.districts[place].named:
            if w.people[person].occupation==.innkeeper or w.people[person].occupation==.hotelier:owner=w.people[person].account;break
        if not transfer(w,p.account,owner,THERMAL_INN_CENTS,.rent,place):return "A room costs ¤{THERMAL_INN_CENTS/100}. You do not have enough."
        visit.paid_place=place;visit.paid_until=thermal_until(w.minute,7)
    visit.place=place;visit.active=true;visit.sleeping=sleeping;visit.exit=exit;visit.last_minute=w.minute
    visit.until=if sleeping:visit.paid_until else: -1
    w.people[w.player].state=.resting
    ""

thermal_recover=(w:mut World,visit:mut ThermalVisit):
    if not visit.active:return
    elapsed=max(0,w.minute-visit.last_minute);visit.last_minute=w.minute
    # Same ordinary rest rate as other residents: 120 fatigue points per hour.
    w.people[w.player].fatigue=max(0,w.people[w.player].fatigue-elapsed*2)
    w.people[w.player].fatigue_remainder=0

thermal_end=(w:mut World,visit:mut ThermalVisit):
    thermal_recover(w,visit);visit.active=false;visit.until= -1
    if w.people[w.player].state==.resting:w.people[w.player].state=.idle

thermal_advance=(w:mut World,visit:mut ThermalVisit,minutes:int=1)->int:
    if not visit.active or minutes<=0:return 0
    count=min(minutes,if visit.until>=0:max(0,visit.until-w.minute) else:minutes)
    before=w.minute
    if count>0:advance_minutes(w,count)
    thermal_recover(w,visit)
    w.minute-before
