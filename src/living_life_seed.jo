# Default social content for the detailed core. No money/goods, actor clones or renderer state.
use 'living_types.jo'
use 'life_types.jo'

initialize_life = (w: mut World):
    if w.life_version >= 1: return
    loop p in w.people:
        if p.far_home<0 and p.id != w.player and not (p.id in w.daily_life): w.daily_life[p.id] = DailyIntent(p.id,p.place,target=p.pose.pos,last_tick=w.tick)
    if w.life_venues.len() == 0:
        loop place in 0..w.harbors.len():
            h = w.harbors[place]; side = vec3(-h.out.z,0,h.out.x)
            loop kind in [VenueKind.home,.quay,.market,.cafe,.church,.square,.fields,.workshop,.shelter,.school]:
                offset = match kind:
                    .quay: vec3(0,1.2,0)
                    .market: -h.out*8.0+vec3(0,1.2,0)
                    .cafe, .square: -h.out*14.0+side*10.0+vec3(0,1.2,0)
                    .church: -h.out*25.0-side*10.0+vec3(0,1.2,0)
                    .fields: -h.out*45.0+side*25.0+vec3(0,1.2,0)
                    .workshop: -h.out*12.0-side*15.0+vec3(0,1.2,0)
                    .home, .shelter, .school: -h.out*20.0+vec3(0,1.2,0)
                w.life_venues.push(LifeVenue(place,"legacy:{place}:{kind}",kind,h.center+offset,capacity=if kind == .square or kind == .market: 12 else: 6,covered=kind == .home or kind == .cafe or kind == .shelter or kind == .church))
    if w.households.len() == 0:
        names = ["Thaleia","Kiro","Evi","Omar","Iason","Melia","Safi","Rina","Piero","Lida","Yara","Miro"]
        guardians = [7,6,12,13,16,17,19,18,20,20,24,25]
        loop k in 0..guardians.len():
            guardian = guardians[k]
            if guardian >= w.people.len(): continue
            home = w.people[guardian].home
            w.households.push(HouseholdResident(1000000+k,names[k],7+k%6,home,guardian,w.people[guardian].pose.pos,w.people[guardian].pose.pos,last_tick=w.tick))
    if w.stories.len() == 0:
        # A possible courtship has to become something through actual repeated meetings.
        if w.people.len() > 10:
            id = w.next_story; w.next_story += 1
            w.stories[id] = LifeStory(id,.courtship,[2,10],w.people[10].home,since_minute=w.minute,changed_minute=w.minute,next_check_minute=w.minute+60)
        obligations = w.obligations.keys(); obligations.sort()
        loop key in obligations:
            o = w.obligations[key]
            if o.kind != .debt or o.amount_cents < 3000 or o.creditor < 0: continue
            id = w.next_story; w.next_story += 1
            w.stories[id] = LifeStory(id,.debt,[o.debtor,o.creditor],o.place,since_minute=w.minute,changed_minute=w.minute,next_check_minute=w.minute+60,obligation=key)
    if w.countries.len() == 0:
        w.countries = [CountryRecord(0,"archipelago","Archipelago"),CountryRecord(1,"kalyra","Kalyra"),CountryRecord(2,"orenthia","Orenthia")]
    if w.place_country.len() == 0: w.place_country = [loop place in w.places: 0]
    w.life_version = 1

# Towns can replace/add semantic anchors without moving anyone or changing a person's plan.
# Stable anchor keys survive different publication/insertion orders and geometry LOD changes.
set_life_venues = (w: mut World, place: int, supplied: LifeVenue[]):
    initialize_life(w)
    if place < 0 or place >= w.places.len(): return
    keep: LifeVenue[]
    loop v in w.life_venues:
        if v.place != place: keep.push(v)
    loop v in supplied:
        if v.place == place and v.key != "" and v.capacity > 0 and is_finite(v.pos.x) and is_finite(v.pos.y) and is_finite(v.pos.z): keep.push(v)
    keep.sort_by((v: LifeVenue): (v.place,int(v.kind),v.key))
    w.life_venues = keep
    people = w.daily_life.keys(); people.sort()
    loop person in people:
        if w.daily_life[person].place == place:
            w.daily_life[person].anchor = ""; w.daily_life[person].path_revision += 1

choose_life_venue = (w: World, place: int, kind: VenueKind, person: int) -> LifeVenue?:
    matches: LifeVenue[]
    loop v in w.life_venues:
        if v.place == place and v.kind == kind: matches.push(v)
    matches.sort_by((v: LifeVenue): v.key)
    if matches.len() == 0: return none
    matches[abs(person)%matches.len()]
