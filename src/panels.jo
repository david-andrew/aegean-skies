# The interface for dealing with people: a speech bubble over someone who says something as one
# passes, the conversation panel, a harbor's notice board (paper notices pinned to boards), and
# the trader's ledger. Each panel draws itself from plain data and says what was chosen; the game
# decides what that means.

use 'hud.jo'

PAPER = rgba(0.95, 0.91, 0.8, 1)
PAPER_DARK = rgba(0.86, 0.8, 0.66, 1)
WOOD = rgba(0.42, 0.29, 0.18, 1)
WOOD_DARK = rgba(0.3, 0.2, 0.12, 1)
STAMP = rgba(0.72, 0.16, 0.12, 0.85)
LIGHT_INK = rgba(0.12, 0.1, 0.08, 0.6)

struct Notice:
    id: int
    poster: str                     # who posted it
    title: str                      # "Olive oil to Mikra"
    body: str                       # what it says
    pay: int                        # lire
    due: str                        # "by dusk", "tomorrow 10:00"
    taken_by: str = ""              # empty while open

struct GoodRow:
    name: str
    unit: str                       # "crate", "barrel", "sack"
    buy: int                        # what one pays the trader for one
    sell: int                       # what the trader pays for one
    stock: int                      # the trader's
    have: int                       # one's own, in the hold

# ---------------- speech bubble ----------------

# a line over someone's head, faded by distance (dist in meters, 0..reach)
speech_bubble = (fonts: Fonts, head: vec3, name: str, line: str, dist: f64, reach: f64 = 14.0):
    a = 1.0 - smoothstep(reach * 0.6, reach, dist)
    if a <= 0.0: return
    let sp = world_to_screen(head + vec3(0, 0.45, 0))
    if sp == none: return
    p = sp!
    set_font(fonts.ui)
    lines = wrap_text(line, 260, 17)
    w = 0.0
    loop l in lines: w = max(w, text_width(l, 17))
    w = max(w, text_width(name, 14)) + 24.0
    h = f64(lines.len()) * 21.0 + 30.0
    # (kept inside the screen; its tail still points at the speaker)
    sw = f64(screen_width())
    x = clamp(f64(p.x) - w * 0.5, 8.0, max(sw - w - 8.0, 8.0))
    y = max(f64(p.y) - h - 12.0, 8.0)
    rect_rounded(x + 2, y + 3, w, h, 9, rgba(0, 0, 0, f32(0.18 * a)))
    rect_rounded(x, y, w, h, 9, rgba(0.98, 0.96, 0.9, f32(0.93 * a)))
    tx = f32(clamp(f64(p.x), x + 14.0, x + w - 14.0))
    triangle(vec2(tx - 7, f32(y + h - 1)), vec2(tx + 7, f32(y + h - 1)), vec2(p.x, f32(y + h + 10)), rgba(0.98, 0.96, 0.9, f32(0.93 * a)))
    text(name, vec2(f32(x + 12), f32(y + 6)), 14, rgba(0.55, 0.3, 0.15, f32(a)))
    loop k in 0..lines.len():
        text(lines[k], vec2(f32(x + 12), f32(y + 24.0 + f64(k) * 21.0)), 17, rgba(0.12, 0.1, 0.08, f32(a)))
    set_font()

# a small name over someone near (who is not speaking), so people can be told apart
name_tag = (fonts: Fonts, head: vec3, name: str, dist: f64):
    a = 1.0 - smoothstep(8.0, 16.0, dist)
    if a <= 0.0: return
    let sp = world_to_screen(head + vec3(0, 0.4, 0))
    if sp == none: return
    set_font(fonts.ui)
    text_centered(name, sp!, 14, rgba(1, 0.97, 0.9, f32(a * 0.9)), shadow = rgba(0, 0, 0, f32(a * 0.5)))
    set_font()

# ---------------- clicking ----------------

_clicked = (r: Rect) -> bool: mouse_pressed(.left) and contains(r, mouse_pos())
_hover = (r: Rect) -> bool: contains(r, mouse_pos())

# ---------------- conversation ----------------

# someone speaking with the player: who, their trade, what they say, and what one can answer
# (number keys or a click choose; returns the answer chosen this frame, or -1)
conversation = (fonts: Fonts, name: str, role: str, says: str, answers: str[]) -> int:
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(760.0, sw - 80.0)
    set_font(fonts.ui)
    lines = wrap_text(says, w - 56, 20)
    h = 70.0 + f64(lines.len()) * 26.0 + 14.0 + f64(answers.len()) * 34.0 + 16.0
    x = (sw - w) * 0.5
    y = sh - h - 30.0
    rect_rounded(x + 3, y + 4, w, h, 12, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 12, PAPER)
    rect_rounded_outline(x + 6, y + 6, w - 12, h - 12, 9, 1.5, PAPER_DARK)
    set_font(fonts.title)
    text(name, vec2(f32(x + 28), f32(y + 18)), 26, INK)
    nw = text_width(name, 26)
    set_font(fonts.ui)
    text(role, vec2(f32(x + 40 + nw), f32(y + 27)), 16, LIGHT_INK)
    loop k in 0..lines.len(): text(lines[k], vec2(f32(x + 28), f32(y + 60.0 + f64(k) * 26.0)), 20, INK)
    chosen = -1
    ay = y + 60.0 + f64(lines.len()) * 26.0 + 14.0
    loop k in 0..answers.len():
        r = Rect(x + 20, ay + f64(k) * 34.0, w - 40, 30)
        if _hover(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        text("{k + 1}.  {answers[k]}", vec2(f32(r.x + 10), f32(r.y + 5)), 19, rgba(0.32, 0.2, 0.1, 1))
        if _clicked(r): chosen = k
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6]
    loop k in 0..min(answers.len(), keys.len()):
        if key_pressed(keys[k]): chosen = k
    set_font()
    chosen

# a conversation in three parts: what they said, then the lines one can say back (answers to their
# question, errands: full width, numbered from 1), then the things one can bring up ("Ask about",
# small chips in a row), then the ways out (work, trade, goodbye: chips along the bottom). Returns
# the index of the choice in rows ++ chips ++ actions, or -1. Number keys pick the first nine.
conversation_grouped = (fonts: Fonts, name: str, role: str, says: str, rows: str[], chips: str[], actions: str[]) -> int:
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(760.0, sw - 40.0)
    x = (sw - w) * 0.5
    set_font(fonts.ui)
    lines = wrap_text(says, w - 56, 20)
    # (lay the chips out first, to know how tall the panel is)
    chip_h = 28.0
    place = (labels: str[], x0: f64, from: int) -> Rect[]:
        out: Rect[]
        cx = x0
        cy = 0.0
        loop k in 0..labels.len():
            cw = text_width("{from + k + 1}  {labels[k]}", 17) + 22.0
            if cx + cw > x + w - 20.0 and cx > x0:
                cx = x0
                cy += chip_h + 6.0
            out.push(Rect(cx, cy, cw, chip_h))
            cx += cw + 8.0
        out
    ask_x = x + 28.0 + text_width("Ask about", 15) + 12.0
    chip_rects = place(chips, ask_x, rows.len())
    act_rects = place(actions, x + 20.0, rows.len() + chips.len())
    chips_h = if chips.len() > 0: f64(chip_rects[chip_rects.len() - 1].y) + chip_h + 12.0 else: 0.0
    acts_h = if actions.len() > 0: f64(act_rects[act_rects.len() - 1].y) + chip_h else: 0.0
    h = 70.0 + f64(lines.len()) * 26.0 + 12.0 + f64(rows.len()) * 32.0 + (if rows.len() > 0: 8.0 else: 0.0) + chips_h + acts_h + 20.0
    y = max(sh - h - 24.0, 8.0)
    rect_rounded(x + 3, y + 4, w, h, 12, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 12, PAPER)
    rect_rounded_outline(x + 6, y + 6, w - 12, h - 12, 9, 1.5, PAPER_DARK)
    set_font(fonts.title)
    text(name, vec2(f32(x + 28), f32(y + 18)), 26, INK)
    nw = text_width(name, 26)
    set_font(fonts.ui)
    text(role, vec2(f32(x + 40 + nw), f32(y + 27)), 16, LIGHT_INK)
    loop k in 0..lines.len(): text(lines[k], vec2(f32(x + 28), f32(y + 60.0 + f64(k) * 26.0)), 20, INK)
    chosen = -1
    ay = y + 60.0 + f64(lines.len()) * 26.0 + 12.0
    loop k in 0..rows.len():
        r = Rect(x + 20, ay + f64(k) * 32.0, w - 40, 28)
        if _hover(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        text("{k + 1}.  {rows[k]}", vec2(f32(r.x + 10), f32(r.y + 4)), 19, rgba(0.32, 0.2, 0.1, 1))
        if _clicked(r): chosen = k
    cy0 = ay + f64(rows.len()) * 32.0 + (if rows.len() > 0: 8.0 else: 0.0)
    chip = (r0: Rect, label: str, n: int, fill: vec4) -> bool:
        r = Rect(r0.x, r0.y, r0.w, r0.h)
        rect_rounded(r.x, r.y, r.w, r.h, 14, if _hover(r): rgba(0.85, 0.74, 0.5, 0.6) else: fill)
        text("{n}", vec2(f32(r.x + 10), f32(r.y + 6)), 14, LIGHT_INK)
        text(label, vec2(f32(r.x + 12 + text_width("{n}", 14) + 6), f32(r.y + 5)), 17, rgba(0.32, 0.2, 0.1, 1))
        _clicked(r)
    if chips.len() > 0:
        text("Ask about", vec2(f32(x + 28), f32(cy0 + 6)), 15, LIGHT_INK)
        loop k in 0..chips.len():
            r = chip_rects[k]
            if chip(Rect(r.x, cy0 + r.y, r.w, r.h), chips[k], rows.len() + k + 1, rgba(0.88, 0.82, 0.68, 1)): chosen = rows.len() + k
    ry0 = cy0 + chips_h
    loop k in 0..actions.len():
        r = act_rects[k]
        if chip(Rect(r.x, ry0 + r.y, r.w, r.h), actions[k], rows.len() + chips.len() + k + 1, rgba(0.82, 0.76, 0.62, 1)): chosen = rows.len() + chips.len() + k
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8, .n9]
    total = rows.len() + chips.len() + actions.len()
    loop k in 0..min(total, keys.len()):
        if key_pressed(keys[k]): chosen = k
    set_font()
    chosen

# ---------------- the notice board ----------------

# a harbor's board: its notices pinned in rows. Returns the id of a notice clicked to take (an
# open one), or -1. Escape or the close mark closes it (`closed` set).
struct BoardResult:
    take = -1
    closed = false

notice_board = (fonts: Fonts, place: str, notices: Notice[], yesterday: str[]) -> BoardResult:
    res = BoardResult()
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(1100.0, sw - 60.0)
    h = min(640.0, sh - 60.0)
    x = (sw - w) * 0.5
    y = (sh - h) * 0.5
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.45))
    rect_rounded(x + 4, y + 6, w, h, 10, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 10, WOOD)
    # planks
    loop k in 1..8: line(vec2(f32(x + 8), f32(y + h * f64(k) / 8.0)), vec2(f32(x + w - 8), f32(y + h * f64(k) / 8.0)), 2, WOOD_DARK)
    set_font(fonts.title)
    text_centered(place, vec2(f32(x + w * 0.5), f32(y + 34)), 30, rgba(0.98, 0.92, 0.78, 1), shadow = rgba(0, 0, 0, 0.4))
    set_font(fonts.ui)
    close = Rect(x + w - 44, y + 14, 30, 30)
    text_centered("×", vec2(f32(close.x + 15), f32(close.y + 13)), 30, rgba(0.98, 0.92, 0.78, if _hover(close): 1.0 else: 0.7))
    if _clicked(close) or key_pressed(.escape): res.closed = true
    # yesterday's news, a strip along the bottom
    ny = y + h - 30.0 - f64(yesterday.len()) * 22.0
    if yesterday.len() > 0:
        rect_rounded(x + 24, ny - 34, w - 48, f64(yesterday.len()) * 22.0 + 44.0, 4, PAPER_DARK)
        text("Yesterday", vec2(f32(x + 40), f32(ny - 26)), 16, rgba(0.4, 0.25, 0.12, 1))
        loop k in 0..yesterday.len(): text(fit_text(yesterday[k], w - 100, 17), vec2(f32(x + 40), f32(ny - 4 + f64(k) * 22.0)), 17, INK)
    # the notices: cards in rows
    cw = 250.0
    ch = 190.0
    cols = max(1, int((w - 40.0) / (cw + 16.0)))
    top = y + 70.0
    loop k in 0..notices.len():
        n = notices[k]
        cx = x + 24.0 + f64(k % cols) * (cw + 16.0)
        cy = top + f64(k / cols) * (ch + 16.0)
        if cy + ch > ny - 44.0: break
        r = Rect(cx, cy, cw, ch)
        open = n.taken_by == ""
        rect(cx + 3, cy + 4, cw, ch, rgba(0, 0, 0, 0.25))
        rect(cx, cy, cw, ch, if _hover(r) and open: rgba(1, 0.97, 0.88, 1) else: PAPER)
        circle(vec2(f32(cx + cw * 0.5), f32(cy + 10)), 6, STAMP)
        text(fit_text(n.title, cw - 24, 19), vec2(f32(cx + 12), f32(cy + 22)), 19, INK)
        body = wrap_text(n.body, cw - 24, 15)
        loop b in 0..min(body.len(), 4): text(body[b], vec2(f32(cx + 12), f32(cy + 50.0 + f64(b) * 19.0)), 15, rgba(0.2, 0.17, 0.14, 1))
        text("{n.pay} lire", vec2(f32(cx + 12), f32(cy + ch - 46)), 19, rgba(0.35, 0.22, 0.1, 1))
        text(n.due, vec2(f32(cx + cw - 12 - text_width(n.due, 14)), f32(cy + ch - 42)), 14, LIGHT_INK)
        text("— {n.poster}", vec2(f32(cx + 12), f32(cy + ch - 22)), 14, LIGHT_INK)
        if not open:
            # dimmed, a red stamp across it
            rect(cx, cy, cw, ch, rgba(0.95, 0.91, 0.8, 0.7))
            text_centered("TAKEN", vec2(f32(cx + cw * 0.5), f32(cy + ch * 0.5 - 6)), 34, STAMP)
            text_centered(n.taken_by, vec2(f32(cx + cw * 0.5), f32(cy + ch * 0.5 + 22)), 15, STAMP)
        else if _clicked(r): res.take = n.id
    if notices.len() == 0: text_centered("Nothing posted.", vec2(f32(x + w * 0.5), f32(y + h * 0.4)), 22, rgba(0.98, 0.92, 0.78, 0.8))
    set_font()
    res

# ---------------- the ledger ----------------

# trading with someone: their goods, prices, and one's own hold. Returns (row, +1 buy / -1 sell)
# for a click on a row's buttons, or (-1, 0); `closed` when shut.
struct LedgerResult:
    row = -1
    dir = 0
    closed = false

ledger = (fonts: Fonts, trader: str, place: str, rows: GoodRow[], money: int, hold_used: int, hold_size: int) -> LedgerResult:
    res = LedgerResult()
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(720.0, sw - 60.0)
    h = 150.0 + f64(rows.len()) * 40.0 + 60.0
    x = (sw - w) * 0.5
    y = (sh - h) * 0.5
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.4))
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)
    set_font(fonts.title)
    text(trader, vec2(f32(x + 30), f32(y + 22)), 26, INK)
    tw = text_width(trader, 26)
    set_font(fonts.ui)
    text(place, vec2(f32(x + 42 + tw), f32(y + 31)), 16, LIGHT_INK)
    close = Rect(x + w - 44, y + 14, 30, 30)
    text_centered("×", vec2(f32(close.x + 15), f32(close.y + 13)), 30, if _hover(close): INK else: LIGHT_INK)
    if _clicked(close) or key_pressed(.escape): res.closed = true
    hy = y + 74.0
    cols = [x + 30, x + 230, x + 330, x + 430, x + 520, x + 600]
    heads = ["goods", "they sell", "they buy", "in stock", "yours", ""]
    loop k in 0..heads.len(): text(heads[k], vec2(f32(cols[k]), f32(hy)), 15, LIGHT_INK)
    line(vec2(f32(x + 24), f32(hy + 24)), vec2(f32(x + w - 24), f32(hy + 24)), 1.5, PAPER_DARK)
    loop k in 0..rows.len():
        g = rows[k]
        ry = hy + 34.0 + f64(k) * 40.0
        text("{g.name}", vec2(f32(cols[0]), f32(ry)), 19, INK)
        text("{g.buy}", vec2(f32(cols[1]), f32(ry)), 19, INK)
        text("{g.sell}", vec2(f32(cols[2]), f32(ry)), 19, INK)
        text("{g.stock}", vec2(f32(cols[3]), f32(ry)), 19, LIGHT_INK)
        text("{g.have}", vec2(f32(cols[4]), f32(ry)), 19, INK)
        bb = Rect(cols[5], ry - 4, 40, 28)
        sb = Rect(cols[5] + 46, ry - 4, 40, 28)
        can_buy = g.stock > 0 and money >= g.buy and hold_used < hold_size
        can_sell = g.have > 0
        rect_rounded(bb.x, bb.y, bb.w, bb.h, 5, if can_buy: (if _hover(bb): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1)) else: rgba(0.7, 0.68, 0.6, 1))
        rect_rounded(sb.x, sb.y, sb.w, sb.h, 5, if can_sell: (if _hover(sb): rgba(0.75, 0.5, 0.3, 1) else: rgba(0.66, 0.42, 0.25, 1)) else: rgba(0.7, 0.68, 0.6, 1))
        text_centered("buy", vec2(f32(bb.x + 20), f32(bb.y + 14)), 15, rgba(1, 0.97, 0.9, 1))
        text_centered("sell", vec2(f32(sb.x + 20), f32(sb.y + 14)), 15, rgba(1, 0.97, 0.9, 1))
        if can_buy and _clicked(bb):
            res.row = k
            res.dir = 1
        if can_sell and _clicked(sb):
            res.row = k
            res.dir = -1
    fy = y + h - 44.0
    line(vec2(f32(x + 24), f32(fy - 10)), vec2(f32(x + w - 24), f32(fy - 10)), 1.5, PAPER_DARK)
    text("{money} lire", vec2(f32(x + 30), f32(fy)), 20, INK)
    text("hold {hold_used} / {hold_size}", vec2(f32(x + w - 30 - text_width("hold {hold_used} / {hold_size}", 18)), f32(fy + 2)), 18, LIGHT_INK)
    set_font()
    res
