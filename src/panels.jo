# The interface for dealing with people: a speech bubble over someone who says something as one
# passes, the conversation panel, a harbor's notice board (paper notices pinned to boards), and
# the trader's ledger. Each panel draws itself from plain data and says what was chosen; the game
# decides what that means.

use 'phoenix.jo'
use 'touch.jo'
use 'hud.jo'
use 'touch.jo'
use 'speech_stream.jo'
use 'spoken_view.jo'
use 'talk_bubbles.jo'
use 'controller.jo'

PAPER = rgba(0.95, 0.91, 0.8, 1)
PAPER_DARK = rgba(0.86, 0.8, 0.66, 1)
WOOD = rgba(0.42, 0.29, 0.18, 1)
WOOD_DARK = rgba(0.3, 0.2, 0.12, 1)
STAMP = rgba(0.72, 0.16, 0.12, 0.85)
LIGHT_INK = rgba(0.12, 0.1, 0.08, 0.6)

struct Notice:
    id: int
    poster: str                     # who posted it
    title: str                      # "Olive oil to Mikra"
    body: str                       # what it says
    pay: int                        # lepta (1250: ¤12.50)
    due: str                        # "by dusk", "tomorrow 10:00"
    taken_by: str = ""              # empty while open
    pay_text: str = ""              # in place of "¤N" (an entry fee, not a reward)

struct GoodRow:
    name: str
    unit: str                       # "crate", "barrel", "sack"
    buy: int                        # what one pays the trader for one, in lepta (duty included)
    sell: int                       # what the trader pays for one, in lepta (duty taken off)
    stock: int                      # the trader's
    have: int                       # one's own, in the hold

# ---------------- speech bubble ----------------

# A bubble laid out on the screen: its box, the speaker's head, and which way its tail points.
struct BubbleBox:
    x: f64
    y: f64
    w: f64
    h: f64
    p: vec2                         # the speaker's head on the screen
    above = true                    # over the head, tail down (else beside it, tail across)
    right = true                    # (beside it: to its right)
    tail = true
    name = ""
    lines: str[]
    size = 17.0
    small = 14.0
    pitch = 21.0
    edge: vec2 = vec2(0, 0)         # (the speaker out of view: the way to them, pointed at from its side)

# Where a line over someone's head goes. `floor`: a panel's top edge the bubble keeps above, or
# -1; `wide`: how wide its lines may run (a conversation's lines, said nowhere else, run wider).
# (a bubble's lines and size, not yet placed)
_bubble_measure = (fonts: Fonts, name: str, line: str, wide: f64) -> BubbleBox:
    set_font(fonts.ui)
    # (never smaller than reads on this screen: on a phone the type, and the bubble, grow)
    k = readable_k(17.0)
    size = 17.0 * k; small = readable(14.0); pitch = 21.0 * k
    lines = wrap_text(line, min(wide * k, f64(screen_width()) - 40.0), size)
    w = 0.0
    loop l in lines: w = max(w, ptext_width(l, size))
    w = max(w, ptext_width(name, small)) + 24.0
    # (nobody named, the pilot's own words: no row kept for the name)
    h = f64(lines.len()) * pitch + (if name == "": 14.0 else: small + 16.0)
    set_font()
    BubbleBox(0.0, 0.0, w, h, vec2(0, 0), true, true, true, name, lines, size, small, pitch)

bubble_box = (fonts: Fonts, head: vec3, name: str, line: str, floor: f64 = -1.0, wide: f64 = 260.0) -> BubbleBox?:
    let sp = world_to_screen(head + vec3(0, 0.45, 0))
    if sp == none: return none
    p = sp!
    m = _bubble_measure(fonts, name, line, wide)
    w = m.w; h = m.h
    sw = f64(screen_width())
    # (above the head, its tail pointing down at the speaker; where there's no room above, beside
    # the head at its height, tail pointing across, so the bubble never covers the face)
    above = f64(p.y) - h - 12.0 >= 8.0
    x = clamp(f64(p.x) - w * 0.5, 8.0, max(sw - w - 8.0, 8.0))
    y = f64(p.y) - h - 12.0
    right = f64(p.x) + 40.0 + w < sw - 8.0
    if not above:
        x = if right: f64(p.x) + 40.0 else: max(8.0, f64(p.x) - 40.0 - w)
        y = clamp(f64(p.y) - h * 0.5, 8.0, max(8.0, f64(screen_height()) - h - 8.0))
    # (a panel along the foot of the screen: the bubble and its tail stay above its edge, however
    # low the speaker stands behind it)
    if floor > 0.0:
        most = floor - 6.0 - h - (if above: 12.0 else: 0.0)
        if y > most: y = max(8.0, most)
    BubbleBox(x, y, w, h, p, above, right, true, name, m.lines, m.size, m.small, m.pitch)

# The way across the screen to someone out of view (behind the camera, or off the screen's side):
# a direction, x to the right and y down, or none while they are in view.
offscreen_way = (head: vec3, margin: f64 = 26.0) -> vec2?:
    sw = f64(screen_width()); sh = f64(screen_height())
    if let sp = world_to_screen(head):
        if f64(sp.x) > margin and f64(sp.x) < sw - margin and f64(sp.y) > margin and f64(sp.y) < sh - margin: return none
    # (the camera's right and up, from rays through the screen)
    o, fwd = screen_ray(vec2(f32(sw * 0.5), f32(sh * 0.5)))
    o2, r = screen_ray(vec2(f32(sw), f32(sh * 0.5)))
    right = normalize(r - fwd * dot(r, fwd))
    up = normalize(cross(right, fwd))
    to = normalize(head - o)
    dx = f64(dot(to, right)); dy = f64(dot(to, up))
    if abs(dx) < 1e-4 and abs(dy) < 1e-4: dx = 1.0
    n = sqrt(dx * dx + dy * dy)
    vec2(f32(dx / n), f32(-dy / n))

# A line from someone out of view: their bubble against the screen's edge on their side, a small
# point toward them where its tail would be, so what they say is never lost with them. `way`:
# offscreen_way's; `keep_above`: the bubble stays above this height of the screen (the cards and
# controls along its foot), 0..1.
bubble_box_edge = (fonts: Fonts, way: vec2, name: str, line: str, wide: f64 = 260.0, keep_above: f64 = 0.74) -> BubbleBox:
    sw = f64(screen_width()); sh = f64(screen_height())
    m = _bubble_measure(fonts, name, line, wide)
    cx = sw * 0.5; cy = sh * 0.5
    # (out from the middle along the way to them, to where the bubble meets the screen's edge)
    hw = cx - m.w * 0.5 - 22.0; hh = cy - m.h * 0.5 - 22.0
    k = min(hw / max(abs(f64(way.x)), 1e-6), hh / max(abs(f64(way.y)), 1e-6))
    x = clamp(cx + f64(way.x) * k - m.w * 0.5, 22.0, max(22.0, sw - m.w - 22.0))
    y = clamp(cy + f64(way.y) * k - m.h * 0.5, 22.0, max(22.0, min(sh - m.h - 22.0, sh * keep_above - m.h)))
    b = BubbleBox(x, y, m.w, m.h, vec2(f32(x + m.w * 0.5), f32(y + m.h * 0.5)), true, true, false, name, m.lines, m.size, m.small, m.pitch)
    b.edge = way
    b

_boxes_touch = (a: BubbleBox, b: BubbleBox, gap: f64) -> bool:
    a.x < b.x + b.w + gap and b.x < a.x + a.w + gap and a.y < b.y + b.h + gap and b.y < a.y + a.h + gap

# Two bubbles of one exchange kept off each other: slid apart sideways, each toward its own
# speaker's side, where the screen has the room; else the second (said first: the pilot's
# question) stacked over the first, without a tail to cross it. `sw`: the screen's width.
bubbles_apart = (a: mut BubbleBox, b: mut BubbleBox, sw: f64):
    gap = 8.0
    if not _boxes_touch(a, b, gap): return
    a_left = f64(a.p.x) <= f64(b.p.x)
    lw = if a_left: a.w else: b.w
    rw = if a_left: b.w else: a.w
    if lw + rw + gap + 16.0 <= sw:
        lx = if a_left: a.x else: b.x
        rx = if a_left: b.x else: a.x
        need = lx + lw + gap - rx
        lx = max(8.0, lx - need * 0.5)
        rx = min(sw - rw - 8.0, max(rx + need * 0.5, lx + lw + gap))
        lx = min(lx, rx - gap - lw)
        if a_left:
            a.x = lx; b.x = rx
        else:
            b.x = lx; a.x = rx
        return
    b.y = a.y - b.h - gap
    b.tail = false
    if b.y < 8.0:
        # (no room over it either: the answer gives way downward, as far as it has)
        a.y += 8.0 - b.y
        b.y = 8.0

# The bubble drawn: `a` its opacity; `chars`: only the first that many characters of the line
# (words arriving as they are spoken), -1 all.
bubble_draw = (fonts: Fonts, b: BubbleBox, a: f64, chars: int = -1):
    if a <= 0.0: return
    set_font(fonts.ui)
    x = b.x; y = b.y; w = b.w; h = b.h; p = b.p
    fill = rgba(0.98, 0.96, 0.9, f32(0.93 * a))
    rect_rounded(x + 2, y + 3, w, h, 9, rgba(0, 0, 0, f32(0.18 * a)))
    rect_rounded(x, y, w, h, 9, fill)
    if length(b.edge) > 0.5:
        # (a point from the side of the bubble nearest them, toward them)
        c = vec2(f32(x + w * 0.5), f32(y + h * 0.5))
        reach = min((w * 0.5) / max(abs(f64(b.edge.x)), 1e-6), (h * 0.5) / max(abs(f64(b.edge.y)), 1e-6))
        at = c + b.edge * f32(reach - 1.0)
        side = vec2(-b.edge.y, b.edge.x) * 7.0
        triangle(at + side, at - side, at + b.edge * 13.0, fill)
    else if not b.tail: pass
    else if b.above:
        tx = f32(clamp(f64(p.x), x + 14.0, x + w - 14.0))
        # (a bubble slid aside still points toward its speaker, not far past its own corner)
        tip = f32(clamp(f64(p.x), x - 26.0, x + w + 26.0))
        triangle(vec2(tx - 7, f32(y + h - 1)), vec2(tx + 7, f32(y + h - 1)), vec2(tip, f32(y + h + 10)), fill)
    else:
        ty = f32(clamp(f64(p.y), y + 12.0, y + h - 12.0))
        edge = f32(if b.right: x + 1.0 else: x + w - 1.0)
        tip = if b.right: edge - 14.0 else: edge + 14.0
        triangle(vec2(edge, ty - 7), vec2(edge, ty + 7), vec2(tip, ty), fill)
    if b.name != "": ptext(b.name, vec2(f32(x + 12), f32(y + 6)), b.small, rgba(0.55, 0.3, 0.15, f32(a)))
    top = if b.name == "": 8.0 else: 10.0 + b.small
    counts = spoken_line_counts(b.lines, chars)
    loop k2 in 0..b.lines.len():
        if counts[k2] == 0: continue
        ptext(b.lines[k2], vec2(f32(x + 12), f32(y + top + f64(k2) * b.pitch)), b.size, rgba(0.12, 0.1, 0.08, f32(a)), chars = counts[k2])
    set_font()

# a line over someone's head, faded by distance (dist in meters, 0..reach)
speech_bubble = (fonts: Fonts, head: vec3, name: str, line: str, dist: f64, reach: f64 = 14.0):
    a = 1.0 - smoothstep(reach * 0.6, reach, dist)
    if a <= 0.0: return
    if let b = bubble_box(fonts, head, name, line): bubble_draw(fonts, b, a)

# a small name over someone near (who is not speaking), so people can be told apart; `taken`:
# where names are already written this frame (call nearest first): a name that would run into
# one of them is left out rather than printed over it
name_tag = (fonts: Fonts, head: vec3, name: str, dist: f64, taken: mut Rect[]):
    a = 1.0 - smoothstep(8.0, 16.0, dist)
    if a <= 0.0: return
    let sp = world_to_screen(head + vec3(0, 0.4, 0))
    if sp == none: return
    set_font(fonts.ui)
    size = readable(14.0)
    w = ptext_width(name, size) + 8.0
    # (someone at the screen's edge keeps their whole name, slid in from the edge: all the screen
    # shows, a phone on its side included)
    v = visible_rect()
    at = vec2(f32(clamp(f64(sp!.x), f64(v.x) + w * 0.5 + 4.0, f64(v.x + v.w) - w * 0.5 - 4.0)), f32(clamp(f64(sp!.y), f64(v.y) + size, f64(v.y + v.h) - size)))
    box = Rect(f64(at.x) - w * 0.5, f64(at.y) - size * 0.7, w, size * 1.4)
    loop o in taken:
        if box.x < o.x + o.w and o.x < box.x + box.w and box.y < o.y + o.h and o.y < box.y + box.h:
            set_font()
            return
    taken.push(box)
    ptext_centered(name, at, size, rgba(1, 0.97, 0.9, f32(a * 0.9)), shadow = rgba(0, 0, 0, f32(a * 0.5)))
    set_font()

# Someone out of view (behind the camera, or off the screen's side) who has just spoken: a small
# marker at the screen's edge, in their direction, with their name and a point toward them.
# Nothing when they are in view.
offscreen_pointer = (fonts: Fonts, head: vec3, name: str):
    sw = f64(screen_width()); sh = f64(screen_height())
    margin = 26.0
    let way = offscreen_way(head, margin)
    if way == none: return
    dx = f64(way!.x); dy = -f64(way!.y)
    # (straight along that direction from the middle to the edge, in from it a little)
    cx = sw * 0.5; cy = sh * 0.5
    hw = cx - margin * 2.2; hh = cy - margin * 2.2
    k = min(hw / max(abs(dx), 1e-6), hh / max(abs(dy), 1e-6))
    px = cx + dx * k; py = min(cy - dy * k, sh * 0.74)       # (above the prompt cards along the foot)
    set_font(fonts.ui)
    size = readable(16.0)
    w = ptext_width(name, size) + 22.0; h = size * 1.6
    bx = clamp(px - w * 0.5, 6.0, sw - w - 6.0); by = clamp(py - h * 0.5, 6.0, sh - h - 6.0)
    fill = rgba(0.95, 0.91, 0.8, 0.94)
    rect_rounded(bx, by, w, h, h * 0.5, fill)
    # (the point, from the marker's middle toward them)
    a = atan2(-dy, dx)
    tip = vec2(f32(px + cos(a) * (w * 0.5 + 12.0)), f32(py + sin(a) * (h * 0.5 + 12.0)))
    side = vec2(f32(-sin(a) * 7.0), f32(cos(a) * 7.0))
    base = vec2(f32(px + cos(a) * w * 0.4), f32(py + sin(a) * h * 0.4))
    triangle(base + side, base - side, tip, fill)
    ptext_centered(name, vec2(f32(bx + w * 0.5), f32(by + h * 0.5)), size, rgba(0.25, 0.15, 0.07, 1))
    set_font()

# ---------------- clicking ----------------

NUMBER_KEYS: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8, .n9]
_clicked = (r: Rect) -> bool: mouse_pressed(.left) and contains(r, mouse_pos())
_hover = (r: Rect) -> bool: contains(r, mouse_pos())

# ---------------- conversation ----------------

# The keys of a list of choices whose last is the way out (Goodbye, Back to the board): 1-9 pick
# the first nine others, 0 always the way out (as Escape does, wherever it stands in the list),
# up and down move a mark over every choice and Enter takes it. Returns the choice keyed this
# frame, or -1. The mark starts afresh each time the panel opens.
_conv_focus = -1
_conv_frame = -10
_conv_keys = (total: int) -> int:
    global _conv_focus, _conv_frame
    if frame_number() > _conv_frame + 1: _conv_focus = -1
    _conv_frame = frame_number()
    if total <= 0: return -1
    if _conv_focus >= total: _conv_focus = total - 1
    if mrepeat(.down): _conv_focus = (_conv_focus + 1) % total
    if mrepeat(.up): _conv_focus = if _conv_focus <= 0: total - 1 else: _conv_focus - 1
    chosen = -1
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8, .n9]
    loop k in 0..min(total - 1, keys.len()):
        if key_pressed(keys[k]): chosen = k
    if key_pressed(.n0): chosen = total - 1
    if mkey(.enter) and _conv_focus >= 0: chosen = _conv_focus
    if chosen >= 0: _conv_focus = -1
    chosen
# (the number a choice is shown with: its key, 0 for the way out, none past nine)
_conv_number = (k: int, total: int) -> str: if k == total - 1: "0" else: if k < 9: "{k + 1}" else: ""
# (the mark on the choice up and down have reached)
_conv_mark = (r: Rect, k: int, radius: f64):
    if k == _conv_focus: rect_rounded_outline(r.x - 1, r.y - 1, r.w + 2, r.h + 2, radius, 2.0, rgba(0.55, 0.32, 0.12, 0.9))

# Where the conversation panel stood when it was last drawn, and in which frame: the speakers'
# bubbles keep above it (aegean.jo's draw_talk_bubbles).
conversation_area = Rect(0, 0, 0, 0)
conversation_frame = -10
_conv_area = (x: f64, y: f64, w: f64, h: f64):
    global conversation_area, conversation_frame
    conversation_area = Rect(x, y, w, h)
    conversation_frame = frame_number()
# (where it was actually drawn last: shorter than its full height while its line arrives; a click
# on it finishes the line)
_conv_last = Rect(0, 0, 0, 0)
_conv_drawn = (x: f64, y: f64, w: f64, h: f64):
    global _conv_last
    _conv_last = Rect(x, y, w, h)
# the panel's top edge while it is open, at its full height (-1: no panel)
conversation_top = () -> f64: if frame_number() <= conversation_frame + 1: f64(conversation_area.y) else: -1.0

# (the lines someone is saying, as much of them as has arrived: src/spoken_view.jo)
_said_lines = (lines: str[], x: f64, y: f64, pitch: f64, size: f64, shown: int):
    counts = spoken_line_counts(lines, shown)
    loop k in 0..lines.len():
        if counts[k] == 0: continue
        ptext(lines[k], vec2(f32(x), f32(y + f64(k) * pitch)), size, INK, chars = counts[k])
# (a colour let in as the answers fade in after the line)
_faded = (c: vec4, a: f64) -> vec4: vec4(c.x, c.y, c.z, c.w * f32(a))

# someone speaking with the player: who, their trade, what they say, and what one can answer
# (number keys or a click choose; returns the answer chosen this frame, or -1). What they say
# arrives as it is spoken, `rate` characters a second after `lead` seconds (src/spoken_view.jo,
# under `key`); the answers come once it is whole. Space, Enter or a click on the panel finishes
# it at once.
conversation = (fonts: Fonts, name: str, role: str, says: str, answers: str[], rate: f64 = SPOKEN_RATE, lead: f64 = 0.0, key: str = "talk") -> int:
    sw = f64(screen_width())
    sh = f64(screen_height())
    # (type never smaller than reads on this screen; the rows' pitch follows their type)
    say = readable(20.0); ans = readable(19.0); rs = readable(16.0)
    lp = 26.0 * say / 20.0; ap = 34.0 * ans / 19.0
    w = min(760.0 * ans / 19.0, sw - 80.0)
    set_font(fonts.ui)
    lines = wrap_text(says, w - 56, say)
    full = 70.0 + f64(lines.len()) * lp + 14.0 + f64(answers.len()) * ap + 16.0
    x = (sw - w) * 0.5
    _conv_area(x, max(sh - full - 30.0, 8.0), w, full)
    # (while they speak the panel holds their line alone; it opens upward for the answers after)
    said = spoken_line(key, says, rate, lead, _clicked(_conv_last))
    fade = said_fade(said)
    brief = 70.0 + f64(lines.len()) * lp + 16.0
    h = brief + (full - brief) * smoothstep(0.0, 1.0, fade)
    y = max(sh - h - 30.0, 8.0)
    _conv_drawn(x, y, w, h)
    rect_rounded(x + 3, y + 4, w, h, 12, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 12, PAPER)
    rect_rounded_outline(x + 6, y + 6, w - 12, h - 12, 9, 1.5, PAPER_DARK)
    set_font(fonts.title)
    # (a long title, such as a contract's on a phone, narrows to the panel; the role beside it
    # is cut short, or left out where there's no room)
    ns = min(26.0, 26.0 * (w - 56.0) / max(ptext_width(name, 26), 1.0))
    ptext(name, vec2(f32(x + 28), f32(y + 18 + (26.0 - ns) * 0.5)), ns, INK)
    nw = ptext_width(name, ns)
    set_font(fonts.ui)
    room = w - 40.0 - nw - 28.0
    if room > 60.0: ptext(fit_text(role, room, rs), vec2(f32(x + 40 + nw), f32(y + 27)), rs, LIGHT_INK)
    _said_lines(lines, x + 28, y + 60.0, lp, say, said.shown)
    chosen = -1
    if not said.done:
        set_font()
        return -1
    ay = y + 60.0 + f64(lines.len()) * lp + 14.0
    loop k in 0..answers.len():
        r = Rect(x + 20, ay + f64(k) * ap, w - 40, ap - 4.0)
        if f64(r.y + r.h) > y + h - 8.0: break         # (not yet room for it in the opening panel)
        if said.ready and _hover(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        if said.ready: _conv_mark(r, k, 6)
        n = _conv_number(k, answers.len())
        ptext(if n == "": answers[k] else: "{n}.  {answers[k]}", vec2(f32(r.x + 10), f32(r.y + (r.h - ans) * 0.5)), ans, _faded(rgba(0.32, 0.2, 0.1, 1), fade))
        if said.ready and _clicked(r): chosen = k
    if said.ready:
        keyed = _conv_keys(answers.len())
        if keyed >= 0: chosen = keyed
    set_font()
    chosen

# ---------------- replies as bubbles ----------------
# What the pilot can say, as small bubbles in a short fan beside his head: a few at a time, each
# with its number; with more than fit, two small arrows step through the sets; the way out
# (Goodbye) under them on every set. A click or tap on one, or its number, says it; 0 or Escape
# is the way out; Tab the next set (Shift+Tab the one before). A controller's d-pad steps
# through them and A says the one reached, its bumpers turn the sets, B is the way out (its
# stick is still his feet). Nothing else of the screen is taken: the pilot walks and looks about
# as he talks. (Which set, and the keys: src/talk_bubbles.jo's ReplyFan.)
_reply = ReplyFan()
_reply_pin = ReplyPin()
_reply_frame = -10
_reply_rects: Rect[]                # where they were drawn last (a tap there is not a tap on the world)
reply_bubble_rects = () -> Rect[]: if frame_number() <= _reply_frame + 1: _reply_rects else: []
reply_set_showing = () -> int: _reply.set
reply_reached = () -> int: _reply.focus
reply_keep = ():
    global _reply_frame
    if frame_number() <= _reply_frame + 1: _reply_frame = frame_number()

_rects_cross = (r: Rect, o: Rect, gap: f64) -> bool:
    r.x < o.x + o.w + gap and o.x < r.x + r.w + gap and r.y < o.y + o.h + gap and o.y < r.y + r.h + gap

# Where a fan `wide` by `tall` goes about a head at `p` on a screen `sw` by `sh`: beside the
# head, on the side away from `other_x` (the person spoken with; -1 none), level with it; the
# other side, or lower or higher, to keep clear of `keep_off` (the speech bubbles, a touch
# screen's buttons, the pilot himself); else over his head; and only where `under` allows it,
# under his head, last. Returns its left edge, its top, whether it is to the right of the head
# (its bubbles fan out from that side), and whether it is clear of everything there (false:
# nowhere was; narrower, it may yet fit).
reply_place = (p: vec2, wide: f64, tall: f64, sw: f64, sh: f64, reach: f64, other_x: f64, keep_off: Rect[], under: bool = true) -> (f64, f64, bool, bool):
    prefer_right = other_x < 0.0 or other_x <= f64(p.x)
    level = clamp(f64(p.y) - tall * 0.5 - 10.0, 8.0, max(8.0, sh - tall - 8.0))
    best = (clamp(f64(p.x) - wide * 0.5, 8.0, max(8.0, sw - wide - 8.0)), clamp(f64(p.y) + reach, 8.0, max(8.0, sh - tall - 8.0)), true, false)
    least = 1.0e12
    middle = clamp(f64(p.x) - wide * 0.5, 8.0, max(8.0, sw - wide - 8.0))
    loop side in 0..4:
        # (0 the side preferred, 1 the other, 2 over his head, 3 under it)
        if side == 3 and not under: continue
        to_right = if side == 0: prefer_right else: not prefer_right
        home = if side >= 2: middle else: if to_right: f64(p.x) + reach else: f64(p.x) - reach - wide
        base = if side == 3: f64(p.y) + reach else: if side == 2: f64(p.y) - reach * 0.6 - tall else: level
        # (where it stands by itself; else under or over what is in its way, or out past it)
        tries = [(home, base)]
        loop o in keep_off:
            tries.push((home, f64(o.y + o.h) + 8.0))
            tries.push((home, f64(o.y) - tall - 8.0))
            if side < 2: tries.push((if to_right: f64(o.x + o.w) + 8.0 else: f64(o.x) - wide - 8.0, base))
            # (over his head: slid along clear of a bubble beside it)
            if side == 2:
                tries.push((f64(o.x + o.w) + 8.0, base))
                tries.push((f64(o.x) - wide - 8.0, base))
        loop spot in tries:
            x = spot.0; top = spot.1
            if x < 8.0 or x + wide > sw - 8.0 or top < 8.0 or top + tall > sh - 8.0: continue
            # (never back across his head to the side it was kept from)
            if side < 2 and (if to_right: x < home - 1.0 else: x > home + 1.0): continue
            # (over his head means over it: never down beside or below it)
            if side == 2 and top + tall > f64(p.y) - 4.0: continue
            r = Rect(x, top, wide, tall)
            clear = true
            loop o in keep_off:
                if _rects_cross(r, o, 6.0): clear = false
            if not clear: continue
            cost = abs(top - base) + abs(x - home) + (if side == 1: 40.0 else: if side == 2: 70.0 else: if side == 3: 140.0 else: 0.0)
            if cost < least:
                least = cost
                best = (x, top, if side >= 2: true else: to_right, true)
    best

# `head`: the pilot's head in the world; `options`: what he can say; `leave`: the way out's
# words; `fade` 0..1: how far in they have faded; `live`: whether they can be taken yet;
# `other_x`: where the person he is talking with is on the screen, or -1; `keep_off`: what the
# fan keeps clear of; `strength`: how strongly each option shows, 0..1 (an answer to a question
# fading as the question passes; none given: all whole). Returns the option chosen this frame,
# options.len() for the way out, or -1.
reply_bubbles = (fonts: Fonts, head: vec3, options: str[], leave: str, fade: f64, live: bool, other_x: f64 = -1.0, keep_off: Rect[] = [], strength: f64[] = [], pin_key: str = "") -> int:
    global _reply, _reply_pin, _reply_frame, _reply_rects
    sw = f64(screen_width()); sh = f64(screen_height())
    reopened = frame_number() > _reply_frame + 1 or (pin_key != "" and _reply_pin.open and pin_key != _reply_pin.key)
    reply_fresh(_reply, join(options, "|"), reopened)
    _reply_frame = frame_number()
    _reply_rects = []
    if fade <= 0.0:
        reply_pin_clear(_reply_pin)
        return -1
    if reopened: reply_pin_clear(_reply_pin)
    sets = reply_sets(options.len())
    if _reply.set >= sets: _reply.set = sets - 1
    first = reply_first(_reply)
    shown = reply_shown(_reply, options.len())
    set_font(fonts.ui)
    u = readable_k(16.0)
    size = 16.0 * u; num = 13.0 * u; pitch = size * 1.28
    pill = tap_size(30.0 * u); gap = (if pad.on: 8.0 else: 6.0) * u; badge = 22.0 * u
    most = min(330.0 * u, sw - 28.0)
    arrows = sets > 1
    lean = 18.0 * u                     # (how far the fan's ends stand out from its middle)
    reach = 40.0 * u
    leave_w = ptext_width(leave, size) + badge + 26.0 * u
    arrow_w = if arrows: pill * 2.0 + ptext_width("{sets} / {sets}", num) + 26.0 * u else: 0.0
    texts: str[][]
    widths: f64[]; heights: f64[]
    total = 0.0; widest = 0.0
    left = 0.0; top = 0.0; right = true
    if not _reply_pin.open:
        p = vec2(f32(sw * 0.5), f32(sh * 0.55))
        if let sp = world_to_screen(head): p = vec2(f32(clamp(f64(sp.x), 20.0, sw - 20.0)), f32(clamp(f64(sp.y), 20.0, sh - 20.0)))
        # (the pilot himself, head to feet, is kept clear too: what he says never hides him)
        avoid = keep_off
        if let feet = world_to_screen(head - vec3(0, 1.6, 0)):
            tall_p = clamp(f64(feet.y) - f64(p.y), 0.0, sh)
            if tall_p > 20.0: avoid.push(Rect(f64(p.x) - tall_p * 0.24, f64(p.y) - tall_p * 0.12, tall_p * 0.48, tall_p * 1.12))
        at = (0.0, 0.0, true, false)
        # (laid out at its full width across all sets; where that is clear of nothing, a cramped
        # screen, narrower until it fits or is as narrow as reads; pinned here while open)
        loop narrower in 0..5:
            all_texts: str[][]; all_widths: f64[]; all_heights: f64[]
            loop k in 0..options.len():
                lines = wrap_text(options[k], most - badge - 26.0 * u, size)
                w = 0.0
                loop l in lines: w = max(w, ptext_width(l, size))
                all_texts.push(lines); all_widths.push(w + badge + 26.0 * u); all_heights.push(max(pill, f64(lines.len()) * pitch + 12.0 * u))
            widest = max(leave_w, arrow_w)
            loop w in all_widths: widest = max(widest, w)
            total = pill + (if arrows: pill + gap else: 0.0)
            loop s in 0..sets:
                s0 = s * REPLY_SET
                s1 = min(options.len(), s0 + REPLY_SET)
                st = pill + (if arrows: pill + gap else: 0.0)
                loop k in s0..s1: st += all_heights[k] + gap
                total = max(total, st)
            texts = []; widths = []; heights = []
            loop k in 0..shown:
                texts.push(all_texts[first + k]); widths.push(all_widths[first + k]); heights.push(all_heights[first + k])
            # (beside him or over his head, narrowed as it must be; under it only if nothing else will do)
            at = reply_place(p, widest + lean, total, sw, sh, reach, other_x, avoid, false)
            if at.3: break
            if most <= 170.0 * u:
                at = reply_place(p, widest + lean, total, sw, sh, reach, other_x, avoid, true)
                break
            most = max(170.0 * u, most * 0.72)
        _reply_pin = ReplyPin(true, pin_key, at.0, at.1, at.2, most, widest, total)
        left = at.0; top = at.1; right = at.2
    else:
        most = min(_reply_pin.most, sw - 28.0)
        widest = _reply_pin.widest
        total = _reply_pin.total
        cur_widest = max(leave_w, arrow_w)
        cur_total = pill + (if arrows: pill + gap else: 0.0)
        loop k in 0..shown:
            lines = wrap_text(options[first + k], most - badge - 26.0 * u, size)
            w = 0.0
            loop l in lines: w = max(w, ptext_width(l, size))
            bw = w + badge + 26.0 * u
            bh = max(pill, f64(lines.len()) * pitch + 12.0 * u)
            texts.push(lines); widths.push(bw); heights.push(bh)
            cur_widest = max(cur_widest, bw)
            cur_total += bh + gap
        clamped = reply_pin_clamp(_reply_pin, max(widest, cur_widest) + lean, max(total, cur_total), sw, sh)
        left = clamped.0; top = clamped.1; right = clamped.2
    a = f32(clamp(fade, 0.0, 1.0))
    # (a fan: the ones level with its middle nearest him, those above and below a little farther out)
    place = (y: f64, w: f64, h: f64) -> Rect:
        off = (y + h * 0.5 - (top + total * 0.5)) / max(total * 0.5, 1.0)
        out = lean * off * off
        x = if right: left + out else: left + widest + lean - out - w
        Rect(clamp(x, 6.0, max(6.0, sw - w - 6.0)), y, w, h)
    chosen = -1
    y = top
    draw_pill = (r: Rect, mark: str, lines: str[], quiet: bool, reached: bool, shows: f64) -> bool:
        over = live and _hover(r)
        b = a * f32(clamp(shows, 0.0, 1.0))
        round = min(r.h * 0.5, 15.0 * u)
        fill = if over or reached: rgba(1.0, 0.97, 0.86, 0.98 * b) else: if quiet: rgba(0.9, 0.86, 0.76, 0.86 * b) else: rgba(0.96, 0.92, 0.8, 0.95 * b)
        rect_rounded(r.x + 2, r.y + 3, r.w, r.h, round, rgba(0, 0, 0, 0.16 * b))
        rect_rounded(r.x, r.y, r.w, r.h, round, fill)
        if over or reached: rect_rounded_outline(r.x, r.y, r.w, r.h, round, if reached: 2.0 else: 1.5, rgba(0.55, 0.32, 0.12, (if reached: 0.95 else: 0.8) * b))
        circle(vec2(f32(r.x + 8.0 * u + badge * 0.5), f32(r.y + r.h * 0.5)), f32(badge * 0.5 - 1.0), rgba(0.42, 0.29, 0.17, (if quiet: 0.55 else: 0.85) * b))
        ptext_centered(mark, vec2(f32(r.x + 8.0 * u + badge * 0.5), f32(r.y + r.h * 0.5)), num, rgba(1, 0.96, 0.86, b))
        ty = r.y + (r.h - f64(lines.len()) * pitch) * 0.5 + (pitch - size) * 0.5 - 1.0
        loop i in 0..lines.len(): ptext(lines[i], vec2(f32(r.x + badge + 16.0 * u), f32(ty + f64(i) * pitch)), size, rgba(0.3, 0.19, 0.09, b))
        _reply_rects.push(r)
        live and shows > 0.05 and _clicked(r)
    loop k in 0..shown:
        r = place(y, widths[k], heights[k])
        shows = if first + k < strength.len(): strength[first + k] else: 1.0
        if draw_pill(r, "{k + 1}", texts[k], false, live and _reply.focus == k, shows): chosen = first + k
        y += heights[k] + gap
    if arrows:
        # (two small arrows and which set of how many)
        count = "{_reply.set + 1} / {sets}"
        row_w = pill * 2.0 + ptext_width(count, num) + 26.0 * u
        row = place(y, row_w, pill)
        back = Rect(row.x, row.y, pill, pill)
        on = Rect(row.x + row_w - pill, row.y, pill, pill)
        ink = rgba(0.3, 0.19, 0.09, a)
        loop side in 0..2:
            b = if side == 0: back else: on
            over = live and _hover(b)
            circle(vec2(f32(b.x + pill * 0.5), f32(b.y + pill * 0.5)), f32(pill * 0.5), if over: rgba(1.0, 0.97, 0.86, 0.98 * a) else: rgba(0.96, 0.92, 0.8, 0.9 * a))
            c = vec2(f32(b.x + pill * 0.5), f32(b.y + pill * 0.5)); s = f32(pill * 0.2); d = if side == 0: -1.0 else: 1.0
            triangle(c + vec2(f32(d) * s, 0), c + vec2(f32(-d) * s * 0.7, -s), c + vec2(f32(-d) * s * 0.7, s), ink)
            _reply_rects.push(b)
        ptext_centered(count, vec2(f32(row.x + row_w * 0.5), f32(row.y + pill * 0.5)), num, rgba(1, 0.97, 0.9, 0.9 * a), shadow = rgba(0, 0, 0, 0.45 * a))
        if live:
            step = ctl.tab
            if _clicked(on) or (key_pressed(.tab) and not key_down(.shift)) or ctl_talk(.page_down) or ctl_talk(.right): step = 1
            if _clicked(back) or (key_pressed(.tab) and key_down(.shift)) or ctl_talk(.page_up) or ctl_talk(.left): step = -1
            if step != 0: reply_turn(_reply, options.len(), step)
        y += pill + gap
    r = place(y, leave_w, pill)
    if draw_pill(r, "0", [leave], true, live and _reply.focus == shown, 1.0): chosen = options.len()
    if live:
        if ctl_talk(.down): reply_reach(_reply, options.len(), 1)
        if ctl_talk(.up): reply_reach(_reply, options.len(), -1)
        digit = -1
        keys: Key[] = [.n0, .n1, .n2, .n3, .n4]
        loop k in 0..keys.len():
            if key_pressed(keys[k]): digit = k
        took = reply_take(_reply, options.len(), digit, ctl_talk(.enter))
        # (an answer that has faded away is not there to be said)
        if took >= 0 and (took >= strength.len() or strength[took] > 0.05): chosen = took
    set_font()
    chosen

# ---------------- the notice board ----------------

# a harbor's board: its notices pinned in rows. Returns the id of a notice clicked to take (an
# open one), or -1. Escape or the close mark closes it (`closed` set).
struct BoardResult:
    take = -1
    closed = false

notice_board = (fonts: Fonts, place: str, notices: Notice[], yesterday: str[]) -> BoardResult:
    res = BoardResult()
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(1100.0, sw - 60.0)
    h = min(640.0, sh - 60.0)
    x = (sw - w) * 0.5
    y = (sh - h) * 0.5
    # (on a phone on its side the pad's buttons along the top would sit on the board: it starts
    # under them and gives up that height)
    clear = pad_top_clear(x, x + w)
    if clear > y:
        h = min(h, sh - clear - 12.0)
        y = clear
    shade_screen(rgba(0.03, 0.04, 0.06, 0.45))
    rect_rounded(x + 4, y + 6, w, h, 10, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 10, WOOD)
    # planks
    loop k in 1..8: line(vec2(f32(x + 8), f32(y + h * f64(k) / 8.0)), vec2(f32(x + w - 8), f32(y + h * f64(k) / 8.0)), 2, WOOD_DARK)
    set_font(fonts.title)
    ptext_centered(place, vec2(f32(x + w * 0.5), f32(y + 34)), 30, rgba(0.98, 0.92, 0.78, 1), shadow = rgba(0, 0, 0, 0.4))
    set_font(fonts.ui)
    close = Rect(x + w - 44, y + 14, 30, 30)
    ptext_centered("×", vec2(f32(close.x + 15), f32(close.y + 13)), 30, rgba(0.98, 0.92, 0.78, if _hover(close): 1.0 else: 0.7))
    if _clicked(close) or mkey(.escape): res.closed = true
    # yesterday's news, a strip along the bottom
    ys = readable(17.0); yp = 22.0 * ys / 17.0
    ny = y + h - 30.0 - f64(yesterday.len()) * yp
    if yesterday.len() > 0:
        rect_rounded(x + 24, ny - 34 - (yp - 22.0), w - 48, f64(yesterday.len()) * yp + 44.0 + (yp - 22.0), 4, PAPER_DARK)
        ptext("Yesterday", vec2(f32(x + 40), f32(ny - 26 - (yp - 22.0))), readable(16.0), rgba(0.4, 0.25, 0.12, 1))
        loop k in 0..yesterday.len(): ptext(fit_text(yesterday[k], w - 100, ys), vec2(f32(x + 40), f32(ny - 4 + f64(k) * yp)), ys, INK)
    # the notices: cards in rows (larger where their type would otherwise be too small to read)
    u = readable_k(19.0)
    cw = 250.0 * u
    ch = 190.0 * u
    cols = max(1, int((w - 40.0) / (cw + 16.0)))
    top = y + 70.0
    # (the open cards answer every hand: a click or a tap, the keys' and a controller's focus with
    # Enter or A, and 1-9 for the first nine)
    numbered = 0
    loop k in 0..notices.len():
        n = notices[k]
        cx = x + 24.0 + f64(k % cols) * (cw + 16.0)
        cy = top + f64(k / cols) * (ch + 16.0)
        if cy + ch > ny - 44.0: break
        r = Rect(cx, cy, cw, ch)
        open = n.taken_by == ""
        rect(cx + 3, cy + 4, cw, ch, rgba(0, 0, 0, 0.25))
        rect(cx, cy, cw, ch, if _hover(r) and open: rgba(1, 0.97, 0.88, 1) else: PAPER)
        circle(vec2(f32(cx + cw * 0.5), f32(cy + 10 * u)), 6, STAMP)
        ptext(fit_text(n.title, cw - 24, 19 * u), vec2(f32(cx + 12), f32(cy + 22 * u)), 19 * u, INK)
        # (a longer notice, such as a race's, takes a size smaller and a fifth line; past that
        # its last line ends in an ellipsis rather than mid-sentence)
        bs = readable(15.0); bl = bs * 19.0 / 15.0; most = 4
        body = wrap_text(n.body, cw - 24, bs)
        if body.len() > most and readable(13.5) < bs:
            bs = 13.5; bl = 17.0; most = 5
            body = wrap_text(n.body, cw - 24, bs)
        # (no more lines than there's room for above the pay)
        most = min(most, max(1, int((ch - 50.0 * u - 48.0 * u) / bl)))
        if body.len() > most: body[most - 1] = fit_text(body[most - 1] + " " + body[most], cw - 24, bs)
        loop b in 0..min(body.len(), most): ptext(body[b], vec2(f32(cx + 12), f32(cy + 50.0 * u + f64(b) * bl)), bs, rgba(0.2, 0.17, 0.14, 1))
        small = readable(14.0)
        ptext(if n.pay_text != "": n.pay_text else: phoenix_text(n.pay), vec2(f32(cx + 12), f32(cy + ch - 46 * u)), 19 * u, rgba(0.35, 0.22, 0.1, 1))
        ptext(n.due, vec2(f32(cx + cw - 12 - ptext_width(n.due, small)), f32(cy + ch - 42 * u)), small, LIGHT_INK)
        ptext(fit_text("— {n.poster}", cw - 24, small), vec2(f32(cx + 12), f32(cy + ch - 22 * u)), small, LIGHT_INK)
        if not open:
            # dimmed, a red stamp across it
            rect(cx, cy, cw, ch, rgba(0.95, 0.91, 0.8, 0.7))
            ptext_centered("TAKEN", vec2(f32(cx + cw * 0.5), f32(cy + ch * 0.5 - 6 * u)), 34 * u, STAMP)
            ptext_centered(n.taken_by, vec2(f32(cx + cw * 0.5), f32(cy + ch * 0.5 + 22 * u)), readable(15.0), STAMP)
        else:
            numbered += 1
            digit = if numbered <= 9: mkey(NUMBER_KEYS[numbered - 1]) else: false
            if hud_nav_box(r) or digit: res.take = n.id
    if notices.len() == 0: ptext_centered("Nothing posted.", vec2(f32(x + w * 0.5), f32(y + h * 0.4)), 22, rgba(0.98, 0.92, 0.78, 0.8))
    set_font()
    res

# ---------------- the ledger ----------------

# trading with someone: their goods, prices, and one's own hold. Returns (row, +1 buy / -1 sell,
# how many loads) for a click on a row's buttons or its keys, or (-1, 0); `closed` when shut.
# Keys: up and down mark a good, left and right (or - and +) how many loads, B buys and S sells
# them, Tab moves the mark between buy and sell and Enter presses the marked button.
struct LedgerResult:
    row = -1
    dir = 0
    qty = 1
    closed = false

_ledger_row = 0
_ledger_qty = 1
_ledger_sell = false
_ledger_frame = -10

ledger = (fonts: Fonts, trader: str, place: str, rows: GoodRow[], money: int, hold_used: int, hold_size: int) -> LedgerResult:
    # (money and the rows' prices in lepta: 1250 is ¤12.50)
    global _ledger_row, _ledger_qty, _ledger_sell, _ledger_frame
    res = LedgerResult()
    if frame_number() > _ledger_frame + 1:
        _ledger_row = 0; _ledger_qty = 1; _ledger_sell = false
    _ledger_frame = frame_number()
    if rows.len() > 0:
        if mrepeat(.down): _ledger_row = (_ledger_row + 1) % rows.len()
        if mrepeat(.up): _ledger_row = (_ledger_row + rows.len() - 1) % rows.len()
        _ledger_row = clamp(_ledger_row, 0, rows.len() - 1)
    if mrepeat(.right) or key_repeat(.equals) or key_repeat(.kp_plus): _ledger_qty = min(_ledger_qty + 1, 99)
    if mrepeat(.left) or key_repeat(.minus) or key_repeat(.kp_minus): _ledger_qty = max(_ledger_qty - 1, 1)
    if key_pressed(.tab): _ledger_sell = not _ledger_sell
    qty = _ledger_qty
    res.qty = qty
    sw = f64(screen_width())
    sh = f64(screen_height())
    # (laid out at u times its desktop size where its type would otherwise be too small to read)
    u = readable_k(19.0)
    small = readable(15.0)
    w = min(720.0 * u, sw - 60.0)
    h = (150.0 + f64(rows.len()) * 40.0 + 60.0 + 24.0) * u
    x = (sw - w) * 0.5
    y = max((sh - h) * 0.5, 4.0)
    # (on a phone on its side, below the pad's buttons along the top, as far as it fits)
    at = panel_clear_of_pad(x, y, w, h, sw, sh)
    x = f64(at.x); y = f64(at.y)
    shade_screen(rgba(0.03, 0.04, 0.06, 0.4))
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)
    set_font(fonts.title)
    ptext(trader, vec2(f32(x + 30 * u), f32(y + 22 * u)), 26 * u, INK)
    tw = ptext_width(trader, 26 * u)
    set_font(fonts.ui)
    ptext(place, vec2(f32(x + 42 * u + tw), f32(y + 31 * u)), readable(16.0), LIGHT_INK)
    close = Rect(x + w - 44 * u, y + 14 * u, 30 * u, 30 * u)
    ptext_centered("×", vec2(f32(close.x + 15 * u), f32(close.y + 13 * u)), 30 * u, if _hover(close): INK else: LIGHT_INK)
    if _clicked(close) or mkey(.escape): res.closed = true
    hy = y + 74.0 * u
    cols = [x + 30 * u, x + 230 * u, x + 330 * u, x + 430 * u, x + 520 * u, x + 600 * u]
    heads = ["goods", "they sell", "they buy", "in stock", "yours", ""]
    loop k in 0..heads.len(): ptext(heads[k], vec2(f32(cols[k]), f32(hy)), small, LIGHT_INK)
    line(vec2(f32(x + 24), f32(hy + 24 * u)), vec2(f32(x + w - 24), f32(hy + 24 * u)), 1.5, PAPER_DARK)
    body = 19.0 * u
    loop k in 0..rows.len():
        g = rows[k]
        ry = hy + (34.0 + f64(k) * 40.0) * u
        marked = k == _ledger_row
        if marked: rect_rounded(x + 22, ry - 7 * u, w - 44, 34 * u, 5, rgba(0.85, 0.74, 0.5, 0.3))
        ptext("{g.name}", vec2(f32(cols[0]), f32(ry)), body, INK)
        ptext(phoenix_text(g.buy), vec2(f32(cols[1]), f32(ry)), body, INK)
        ptext(phoenix_text(g.sell), vec2(f32(cols[2]), f32(ry)), body, INK)
        ptext("{g.stock}", vec2(f32(cols[3]), f32(ry)), body, LIGHT_INK)
        ptext("{g.have}", vec2(f32(cols[4]), f32(ry)), body, INK)
        bb = Rect(cols[5], ry - 4 * u, 40 * u, 28 * u)
        sb = Rect(cols[5] + 46 * u, ry - 4 * u, 40 * u, 28 * u)
        n = if marked: qty else: 1
        can_buy = g.stock >= n and money >= g.buy * n and hold_used + n <= hold_size
        can_sell = g.have >= n
        if marked and qty > 1: ptext("x{qty}", vec2(f32(cols[5] - 8 * u - ptext_width("x{qty}", small)), f32(ry + 2 * u)), small, LIGHT_INK)
        rect_rounded(bb.x, bb.y, bb.w, bb.h, 5, if can_buy: (if _hover(bb): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1)) else: rgba(0.7, 0.68, 0.6, 1))
        rect_rounded(sb.x, sb.y, sb.w, sb.h, 5, if can_sell: (if _hover(sb): rgba(0.75, 0.5, 0.3, 1) else: rgba(0.66, 0.42, 0.25, 1)) else: rgba(0.7, 0.68, 0.6, 1))
        label = min(small, 15.0 * u * 1.15)
        ptext_centered("buy", vec2(f32(bb.x + bb.w * 0.5), f32(bb.y + bb.h * 0.5)), label, rgba(1, 0.97, 0.9, 1))
        ptext_centered("sell", vec2(f32(sb.x + sb.w * 0.5), f32(sb.y + sb.h * 0.5)), label, rgba(1, 0.97, 0.9, 1))
        if marked:
            mb = if _ledger_sell: sb else: bb
            rect_rounded_outline(mb.x - 2, mb.y - 2, mb.w + 4, mb.h + 4, 6, 2.0, rgba(0.32, 0.2, 0.1, 0.9))
        res_qty = n
        if can_buy and (_clicked(bb) or marked and (mkey(.b) or mkey(.enter) and not _ledger_sell)):
            res.row = k
            res.dir = 1
            res.qty = res_qty
        if can_sell and (_clicked(sb) or marked and (mkey(.s) or mkey(.enter) and _ledger_sell)):
            res.row = k
            res.dir = -1
            res.qty = res_qty
    fy = y + h - 68.0 * u
    line(vec2(f32(x + 24), f32(fy - 10 * u)), vec2(f32(x + w - 24), f32(fy - 10 * u)), 1.5, PAPER_DARK)
    ptext(purse_text(money), vec2(f32(x + 30 * u), f32(fy)), 20 * u, INK)
    hold = "hold {hold_used} / {hold_size}"
    ptext(hold, vec2(f32(x + w - 30 * u - ptext_width(hold, 18 * u)), f32(fy + 2 * u)), 18 * u, LIGHT_INK)
    hint = "Up/Down a good    Left/Right how many ({qty})    B buy    S sell    Tab, Enter the marked button"
    hs = readable(13.0)
    if ptext_width(hint, hs) > w - 60 * u: hint = "Up/Down  Left/Right ({qty})  B buy  S sell  Tab, Enter"
    ptext(fit_text(hint, w - 60 * u, hs), vec2(f32(x + 30 * u), f32(fy + 32 * u)), hs, LIGHT_INK)
    set_font()
    res

# A line typed with a finger on a paper panel (the bill of fare's search, the notebook's line): the
# library's text field, so a tap brings up the phone's keyboard (with Paste), in the paper's ink.
paper_field = (r: Rect, value: str, id: str, max_chars: int, hint: str, size: f64 = 17.0) -> str:
    global hud_style
    saved = hud_style
    hud_style.button = rgba(1, 1, 1, 0.55); hud_style.hover = rgba(1, 1, 1, 0.7)
    hud_style.border = rgba(0.32, 0.2, 0.1, 0.25); hud_style.accent = rgba(0.42, 0.29, 0.17, 1)
    hud_style.text = rgba(0.2, 0.14, 0.08, 1); hud_style.disabled = rgba(0.45, 0.38, 0.3, 0.8)
    hud_style.text_size = size
    v = hud_text_field(r, value, id, max_chars, hint)
    hud_style = saved
    v
