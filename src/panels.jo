# The interface for dealing with people: a speech bubble over someone who says something as one
# passes, the conversation panel, a harbor's notice board (paper notices pinned to boards), and
# the trader's ledger. Each panel draws itself from plain data and says what was chosen; the game
# decides what that means.

use 'phoenix.jo'
use 'touch.jo'
use 'hud.jo'
use 'touch.jo'

PAPER = rgba(0.95, 0.91, 0.8, 1)
PAPER_DARK = rgba(0.86, 0.8, 0.66, 1)
WOOD = rgba(0.42, 0.29, 0.18, 1)
WOOD_DARK = rgba(0.3, 0.2, 0.12, 1)
STAMP = rgba(0.72, 0.16, 0.12, 0.85)
LIGHT_INK = rgba(0.12, 0.1, 0.08, 0.6)

struct Notice:
    id: int
    poster: str                     # who posted it
    title: str                      # "Olive oil to Mikra"
    body: str                       # what it says
    pay: int                        # lepta (1250: ¤12.50)
    due: str                        # "by dusk", "tomorrow 10:00"
    taken_by: str = ""              # empty while open
    pay_text: str = ""              # in place of "¤N" (an entry fee, not a reward)

struct GoodRow:
    name: str
    unit: str                       # "crate", "barrel", "sack"
    buy: int                        # what one pays the trader for one, in lepta (duty included)
    sell: int                       # what the trader pays for one, in lepta (duty taken off)
    stock: int                      # the trader's
    have: int                       # one's own, in the hold

# ---------------- speech bubble ----------------

# a line over someone's head, faded by distance (dist in meters, 0..reach)
speech_bubble = (fonts: Fonts, head: vec3, name: str, line: str, dist: f64, reach: f64 = 14.0):
    a = 1.0 - smoothstep(reach * 0.6, reach, dist)
    if a <= 0.0: return
    let sp = world_to_screen(head + vec3(0, 0.45, 0))
    if sp == none: return
    p = sp!
    set_font(fonts.ui)
    # (never smaller than reads on this screen: on a phone the type, and the bubble, grow)
    k = readable_k(17.0)
    size = 17.0 * k; small = readable(14.0); pitch = 21.0 * k
    lines = wrap_text(line, 260.0 * k, size)
    w = 0.0
    loop l in lines: w = max(w, ptext_width(l, size))
    w = max(w, ptext_width(name, small)) + 24.0
    h = f64(lines.len()) * pitch + small + 16.0
    sw = f64(screen_width())
    # (above the head, its tail pointing down at the speaker; where there's no room above, beside
    # the head at its height, tail pointing across, so the bubble never covers the face)
    above = f64(p.y) - h - 12.0 >= 8.0
    x = clamp(f64(p.x) - w * 0.5, 8.0, max(sw - w - 8.0, 8.0))
    y = f64(p.y) - h - 12.0
    right = f64(p.x) + 40.0 + w < sw - 8.0
    if not above:
        x = if right: f64(p.x) + 40.0 else: max(8.0, f64(p.x) - 40.0 - w)
        y = clamp(f64(p.y) - h * 0.5, 8.0, max(8.0, f64(screen_height()) - h - 8.0))
    fill = rgba(0.98, 0.96, 0.9, f32(0.93 * a))
    rect_rounded(x + 2, y + 3, w, h, 9, rgba(0, 0, 0, f32(0.18 * a)))
    rect_rounded(x, y, w, h, 9, fill)
    if above:
        tx = f32(clamp(f64(p.x), x + 14.0, x + w - 14.0))
        triangle(vec2(tx - 7, f32(y + h - 1)), vec2(tx + 7, f32(y + h - 1)), vec2(p.x, f32(y + h + 10)), fill)
    else:
        ty = f32(clamp(f64(p.y), y + 12.0, y + h - 12.0))
        edge = f32(if right: x + 1.0 else: x + w - 1.0)
        tip = if right: edge - 14.0 else: edge + 14.0
        triangle(vec2(edge, ty - 7), vec2(edge, ty + 7), vec2(tip, ty), fill)
    ptext(name, vec2(f32(x + 12), f32(y + 6)), small, rgba(0.55, 0.3, 0.15, f32(a)))
    loop k2 in 0..lines.len():
        ptext(lines[k2], vec2(f32(x + 12), f32(y + 10.0 + small + f64(k2) * pitch)), size, rgba(0.12, 0.1, 0.08, f32(a)))
    set_font()

# a small name over someone near (who is not speaking), so people can be told apart; `taken`:
# where names are already written this frame (call nearest first): a name that would run into
# one of them is left out rather than printed over it
name_tag = (fonts: Fonts, head: vec3, name: str, dist: f64, taken: mut Rect[]):
    a = 1.0 - smoothstep(8.0, 16.0, dist)
    if a <= 0.0: return
    let sp = world_to_screen(head + vec3(0, 0.4, 0))
    if sp == none: return
    set_font(fonts.ui)
    size = readable(14.0)
    w = ptext_width(name, size) + 8.0
    box = Rect(f64(sp!.x) - w * 0.5, f64(sp!.y) - size * 0.7, w, size * 1.4)
    loop o in taken:
        if box.x < o.x + o.w and o.x < box.x + box.w and box.y < o.y + o.h and o.y < box.y + box.h:
            set_font()
            return
    taken.push(box)
    ptext_centered(name, sp!, size, rgba(1, 0.97, 0.9, f32(a * 0.9)), shadow = rgba(0, 0, 0, f32(a * 0.5)))
    set_font()

# ---------------- clicking ----------------

NUMBER_KEYS: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8, .n9]
_clicked = (r: Rect) -> bool: mouse_pressed(.left) and contains(r, mouse_pos())
_hover = (r: Rect) -> bool: contains(r, mouse_pos())

# ---------------- conversation ----------------

# The keys of a list of choices whose last is the way out (Goodbye, Back to the board): 1-9 pick
# the first nine others, 0 always the way out (as Escape does, wherever it stands in the list),
# up and down move a mark over every choice and Enter takes it. Returns the choice keyed this
# frame, or -1. The mark starts afresh each time the panel opens.
_conv_focus = -1
_conv_frame = -10
_conv_keys = (total: int) -> int:
    global _conv_focus, _conv_frame
    if frame_number() > _conv_frame + 1: _conv_focus = -1
    _conv_frame = frame_number()
    if total <= 0: return -1
    if _conv_focus >= total: _conv_focus = total - 1
    if mrepeat(.down): _conv_focus = (_conv_focus + 1) % total
    if mrepeat(.up): _conv_focus = if _conv_focus <= 0: total - 1 else: _conv_focus - 1
    chosen = -1
    keys: Key[] = [.n1, .n2, .n3, .n4, .n5, .n6, .n7, .n8, .n9]
    loop k in 0..min(total - 1, keys.len()):
        if key_pressed(keys[k]): chosen = k
    if key_pressed(.n0): chosen = total - 1
    if mkey(.enter) and _conv_focus >= 0: chosen = _conv_focus
    if chosen >= 0: _conv_focus = -1
    chosen
# (the number a choice is shown with: its key, 0 for the way out, none past nine)
_conv_number = (k: int, total: int) -> str: if k == total - 1: "0" else: if k < 9: "{k + 1}" else: ""
# (the mark on the choice up and down have reached)
_conv_mark = (r: Rect, k: int, radius: f64):
    if k == _conv_focus: rect_rounded_outline(r.x - 1, r.y - 1, r.w + 2, r.h + 2, radius, 2.0, rgba(0.55, 0.32, 0.12, 0.9))

# someone speaking with the player: who, their trade, what they say, and what one can answer
# (number keys or a click choose; returns the answer chosen this frame, or -1)
conversation = (fonts: Fonts, name: str, role: str, says: str, answers: str[]) -> int:
    sw = f64(screen_width())
    sh = f64(screen_height())
    # (type never smaller than reads on this screen; the rows' pitch follows their type)
    say = readable(20.0); ans = readable(19.0); rs = readable(16.0)
    lp = 26.0 * say / 20.0; ap = 34.0 * ans / 19.0
    w = min(760.0 * ans / 19.0, sw - 80.0)
    set_font(fonts.ui)
    lines = wrap_text(says, w - 56, say)
    h = 70.0 + f64(lines.len()) * lp + 14.0 + f64(answers.len()) * ap + 16.0
    x = (sw - w) * 0.5
    y = max(sh - h - 30.0, 8.0)
    rect_rounded(x + 3, y + 4, w, h, 12, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 12, PAPER)
    rect_rounded_outline(x + 6, y + 6, w - 12, h - 12, 9, 1.5, PAPER_DARK)
    set_font(fonts.title)
    # (a long title, such as a contract's on a phone, narrows to the panel; the role beside it
    # is cut short, or left out where there's no room)
    ns = min(26.0, 26.0 * (w - 56.0) / max(ptext_width(name, 26), 1.0))
    ptext(name, vec2(f32(x + 28), f32(y + 18 + (26.0 - ns) * 0.5)), ns, INK)
    nw = ptext_width(name, ns)
    set_font(fonts.ui)
    room = w - 40.0 - nw - 28.0
    if room > 60.0: ptext(fit_text(role, room, rs), vec2(f32(x + 40 + nw), f32(y + 27)), rs, LIGHT_INK)
    loop k in 0..lines.len(): ptext(lines[k], vec2(f32(x + 28), f32(y + 60.0 + f64(k) * lp)), say, INK)
    chosen = -1
    ay = y + 60.0 + f64(lines.len()) * lp + 14.0
    loop k in 0..answers.len():
        r = Rect(x + 20, ay + f64(k) * ap, w - 40, ap - 4.0)
        if _hover(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        _conv_mark(r, k, 6)
        n = _conv_number(k, answers.len())
        ptext(if n == "": answers[k] else: "{n}.  {answers[k]}", vec2(f32(r.x + 10), f32(r.y + (r.h - ans) * 0.5)), ans, rgba(0.32, 0.2, 0.1, 1))
        if _clicked(r): chosen = k
    keyed = _conv_keys(answers.len())
    if keyed >= 0: chosen = keyed
    set_font()
    chosen

# a conversation in three parts: what they said, then the lines one can say back (answers to their
# question, errands: full width, numbered from 1), then the things one can bring up ("Ask about",
# small chips in a row), then the ways out (work, trade, goodbye: chips along the bottom). Returns
# the index of the choice in rows ++ chips ++ actions, or -1. Keys: _conv_keys (the last action,
# Goodbye, is the way out).
conversation_grouped = (fonts: Fonts, name: str, role: str, says: str, rows: str[], chips: str[], actions: str[]) -> int:
    sw = f64(screen_width())
    sh = f64(screen_height())
    # (type never smaller than reads on this screen; pitches follow their type)
    say = readable(20.0); row = readable(19.0); cs = readable(17.0); num = readable(14.0); ask = readable(15.0); rs = readable(16.0)
    lp = 26.0 * say / 20.0; rp = 32.0 * row / 19.0
    w = min(760.0 * row / 19.0, sw - 40.0)
    x = (sw - w) * 0.5
    set_font(fonts.ui)
    lines = wrap_text(says, w - 56, say)
    total = rows.len() + chips.len() + actions.len()
    # (lay the chips out first, to know how tall the panel is)
    chip_h = 28.0 * cs / 17.0
    place = (labels: str[], x0: f64, from: int) -> Rect[]:
        out: Rect[]
        cx = x0
        cy = 0.0
        loop k in 0..labels.len():
            cw = ptext_width(_conv_number(from + k, total), num) + ptext_width(labels[k], cs) + 28.0
            if cx + cw > x + w - 20.0 and cx > x0:
                cx = x0
                cy += chip_h + 6.0
            out.push(Rect(cx, cy, cw, chip_h))
            cx += cw + 8.0
        out
    ask_x = x + 28.0 + ptext_width("Ask about", ask) + 12.0
    chip_rects = place(chips, ask_x, rows.len())
    act_rects = place(actions, x + 20.0, rows.len() + chips.len())
    chips_h = if chips.len() > 0: f64(chip_rects[chip_rects.len() - 1].y) + chip_h + 12.0 else: 0.0
    acts_h = if actions.len() > 0: f64(act_rects[act_rects.len() - 1].y) + chip_h else: 0.0
    h = 70.0 + f64(lines.len()) * lp + 12.0 + f64(rows.len()) * rp + (if rows.len() > 0: 8.0 else: 0.0) + chips_h + acts_h + 20.0
    y = max(sh - h - 24.0, 8.0)
    rect_rounded(x + 3, y + 4, w, h, 12, rgba(0, 0, 0, 0.25))
    rect_rounded(x, y, w, h, 12, PAPER)
    rect_rounded_outline(x + 6, y + 6, w - 12, h - 12, 9, 1.5, PAPER_DARK)
    set_font(fonts.title)
    # (a long title, such as a contract's on a phone, narrows to the panel; the role beside it
    # is cut short, or left out where there's no room)
    ns = min(26.0, 26.0 * (w - 56.0) / max(ptext_width(name, 26), 1.0))
    ptext(name, vec2(f32(x + 28), f32(y + 18 + (26.0 - ns) * 0.5)), ns, INK)
    nw = ptext_width(name, ns)
    set_font(fonts.ui)
    room = w - 40.0 - nw - 28.0
    if room > 60.0: ptext(fit_text(role, room, rs), vec2(f32(x + 40 + nw), f32(y + 27)), rs, LIGHT_INK)
    loop k in 0..lines.len(): ptext(lines[k], vec2(f32(x + 28), f32(y + 60.0 + f64(k) * lp)), say, INK)
    chosen = -1
    ay = y + 60.0 + f64(lines.len()) * lp + 12.0
    loop k in 0..rows.len():
        r = Rect(x + 20, ay + f64(k) * rp, w - 40, rp - 4.0)
        if _hover(r): rect_rounded(r.x, r.y, r.w, r.h, 6, rgba(0.85, 0.74, 0.5, 0.45))
        _conv_mark(r, k, 6)
        n = _conv_number(k, total)
        ptext(if n == "": rows[k] else: "{n}.  {rows[k]}", vec2(f32(r.x + 10), f32(r.y + (r.h - row) * 0.5)), row, rgba(0.32, 0.2, 0.1, 1))
        if _clicked(r): chosen = k
    cy0 = ay + f64(rows.len()) * rp + (if rows.len() > 0: 8.0 else: 0.0)
    chip = (r0: Rect, label: str, k: int, fill: vec4) -> bool:
        r = Rect(r0.x, r0.y, r0.w, r0.h)
        rect_rounded(r.x, r.y, r.w, r.h, 14, if _hover(r): rgba(0.85, 0.74, 0.5, 0.6) else: fill)
        _conv_mark(r, k, 14)
        n = _conv_number(k, total)
        ptext(n, vec2(f32(r.x + 10), f32(r.y + (r.h - num) * 0.5 + 1.0)), num, LIGHT_INK)
        ptext(label, vec2(f32(r.x + 12 + ptext_width(n, num) + 6), f32(r.y + (r.h - cs) * 0.5)), cs, rgba(0.32, 0.2, 0.1, 1))
        _clicked(r)
    if chips.len() > 0:
        ptext("Ask about", vec2(f32(x + 28), f32(cy0 + (chip_h - ask) * 0.5)), ask, LIGHT_INK)
        loop k in 0..chips.len():
            r = chip_rects[k]
            if chip(Rect(r.x, cy0 + r.y, r.w, r.h), chips[k], rows.len() + k, rgba(0.88, 0.82, 0.68, 1)): chosen = rows.len() + k
    ry0 = cy0 + chips_h
    loop k in 0..actions.len():
        r = act_rects[k]
        if chip(Rect(r.x, ry0 + r.y, r.w, r.h), actions[k], rows.len() + chips.len() + k, rgba(0.82, 0.76, 0.62, 1)): chosen = rows.len() + chips.len() + k
    keyed = _conv_keys(total)
    if keyed >= 0: chosen = keyed
    set_font()
    chosen

# ---------------- the notice board ----------------

# a harbor's board: its notices pinned in rows. Returns the id of a notice clicked to take (an
# open one), or -1. Escape or the close mark closes it (`closed` set).
struct BoardResult:
    take = -1
    closed = false

notice_board = (fonts: Fonts, place: str, notices: Notice[], yesterday: str[]) -> BoardResult:
    res = BoardResult()
    sw = f64(screen_width())
    sh = f64(screen_height())
    w = min(1100.0, sw - 60.0)
    h = min(640.0, sh - 60.0)
    x = (sw - w) * 0.5
    y = (sh - h) * 0.5
    # (on a phone on its side the pad's buttons along the top would sit on the board: it starts
    # under them and gives up that height)
    clear = pad_top_clear(x, x + w)
    if clear > y:
        h = min(h, sh - clear - 12.0)
        y = clear
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.45))
    rect_rounded(x + 4, y + 6, w, h, 10, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 10, WOOD)
    # planks
    loop k in 1..8: line(vec2(f32(x + 8), f32(y + h * f64(k) / 8.0)), vec2(f32(x + w - 8), f32(y + h * f64(k) / 8.0)), 2, WOOD_DARK)
    set_font(fonts.title)
    ptext_centered(place, vec2(f32(x + w * 0.5), f32(y + 34)), 30, rgba(0.98, 0.92, 0.78, 1), shadow = rgba(0, 0, 0, 0.4))
    set_font(fonts.ui)
    close = Rect(x + w - 44, y + 14, 30, 30)
    ptext_centered("×", vec2(f32(close.x + 15), f32(close.y + 13)), 30, rgba(0.98, 0.92, 0.78, if _hover(close): 1.0 else: 0.7))
    if _clicked(close) or mkey(.escape): res.closed = true
    # yesterday's news, a strip along the bottom
    ys = readable(17.0); yp = 22.0 * ys / 17.0
    ny = y + h - 30.0 - f64(yesterday.len()) * yp
    if yesterday.len() > 0:
        rect_rounded(x + 24, ny - 34 - (yp - 22.0), w - 48, f64(yesterday.len()) * yp + 44.0 + (yp - 22.0), 4, PAPER_DARK)
        ptext("Yesterday", vec2(f32(x + 40), f32(ny - 26 - (yp - 22.0))), readable(16.0), rgba(0.4, 0.25, 0.12, 1))
        loop k in 0..yesterday.len(): ptext(fit_text(yesterday[k], w - 100, ys), vec2(f32(x + 40), f32(ny - 4 + f64(k) * yp)), ys, INK)
    # the notices: cards in rows (larger where their type would otherwise be too small to read)
    u = readable_k(19.0)
    cw = 250.0 * u
    ch = 190.0 * u
    cols = max(1, int((w - 40.0) / (cw + 16.0)))
    top = y + 70.0
    # (the open cards answer every hand: a click or a tap, the keys' and a controller's focus with
    # Enter or A, and 1-9 for the first nine)
    numbered = 0
    loop k in 0..notices.len():
        n = notices[k]
        cx = x + 24.0 + f64(k % cols) * (cw + 16.0)
        cy = top + f64(k / cols) * (ch + 16.0)
        if cy + ch > ny - 44.0: break
        r = Rect(cx, cy, cw, ch)
        open = n.taken_by == ""
        rect(cx + 3, cy + 4, cw, ch, rgba(0, 0, 0, 0.25))
        rect(cx, cy, cw, ch, if _hover(r) and open: rgba(1, 0.97, 0.88, 1) else: PAPER)
        circle(vec2(f32(cx + cw * 0.5), f32(cy + 10 * u)), 6, STAMP)
        ptext(fit_text(n.title, cw - 24, 19 * u), vec2(f32(cx + 12), f32(cy + 22 * u)), 19 * u, INK)
        # (a longer notice, such as a race's, takes a size smaller and a fifth line; past that
        # its last line ends in an ellipsis rather than mid-sentence)
        bs = readable(15.0); bl = bs * 19.0 / 15.0; most = 4
        body = wrap_text(n.body, cw - 24, bs)
        if body.len() > most and readable(13.5) < bs:
            bs = 13.5; bl = 17.0; most = 5
            body = wrap_text(n.body, cw - 24, bs)
        # (no more lines than there's room for above the pay)
        most = min(most, max(1, int((ch - 50.0 * u - 48.0 * u) / bl)))
        if body.len() > most: body[most - 1] = fit_text(body[most - 1] + " " + body[most], cw - 24, bs)
        loop b in 0..min(body.len(), most): ptext(body[b], vec2(f32(cx + 12), f32(cy + 50.0 * u + f64(b) * bl)), bs, rgba(0.2, 0.17, 0.14, 1))
        small = readable(14.0)
        ptext(if n.pay_text != "": n.pay_text else: phoenix_text(n.pay), vec2(f32(cx + 12), f32(cy + ch - 46 * u)), 19 * u, rgba(0.35, 0.22, 0.1, 1))
        ptext(n.due, vec2(f32(cx + cw - 12 - ptext_width(n.due, small)), f32(cy + ch - 42 * u)), small, LIGHT_INK)
        ptext(fit_text("— {n.poster}", cw - 24, small), vec2(f32(cx + 12), f32(cy + ch - 22 * u)), small, LIGHT_INK)
        if not open:
            # dimmed, a red stamp across it
            rect(cx, cy, cw, ch, rgba(0.95, 0.91, 0.8, 0.7))
            ptext_centered("TAKEN", vec2(f32(cx + cw * 0.5), f32(cy + ch * 0.5 - 6 * u)), 34 * u, STAMP)
            ptext_centered(n.taken_by, vec2(f32(cx + cw * 0.5), f32(cy + ch * 0.5 + 22 * u)), readable(15.0), STAMP)
        else:
            numbered += 1
            digit = if numbered <= 9: mkey(NUMBER_KEYS[numbered - 1]) else: false
            if hud_nav_box(r) or digit: res.take = n.id
    if notices.len() == 0: ptext_centered("Nothing posted.", vec2(f32(x + w * 0.5), f32(y + h * 0.4)), 22, rgba(0.98, 0.92, 0.78, 0.8))
    set_font()
    res

# ---------------- the ledger ----------------

# trading with someone: their goods, prices, and one's own hold. Returns (row, +1 buy / -1 sell,
# how many loads) for a click on a row's buttons or its keys, or (-1, 0); `closed` when shut.
# Keys: up and down mark a good, left and right (or - and +) how many loads, B buys and S sells
# them, Tab moves the mark between buy and sell and Enter presses the marked button.
struct LedgerResult:
    row = -1
    dir = 0
    qty = 1
    closed = false

_ledger_row = 0
_ledger_qty = 1
_ledger_sell = false
_ledger_frame = -10

ledger = (fonts: Fonts, trader: str, place: str, rows: GoodRow[], money: int, hold_used: int, hold_size: int) -> LedgerResult:
    # (money and the rows' prices in lepta: 1250 is ¤12.50)
    global _ledger_row, _ledger_qty, _ledger_sell, _ledger_frame
    res = LedgerResult()
    if frame_number() > _ledger_frame + 1:
        _ledger_row = 0; _ledger_qty = 1; _ledger_sell = false
    _ledger_frame = frame_number()
    if rows.len() > 0:
        if mrepeat(.down): _ledger_row = (_ledger_row + 1) % rows.len()
        if mrepeat(.up): _ledger_row = (_ledger_row + rows.len() - 1) % rows.len()
        _ledger_row = clamp(_ledger_row, 0, rows.len() - 1)
    if mrepeat(.right) or key_repeat(.equals) or key_repeat(.kp_plus): _ledger_qty = min(_ledger_qty + 1, 99)
    if mrepeat(.left) or key_repeat(.minus) or key_repeat(.kp_minus): _ledger_qty = max(_ledger_qty - 1, 1)
    if key_pressed(.tab): _ledger_sell = not _ledger_sell
    qty = _ledger_qty
    res.qty = qty
    sw = f64(screen_width())
    sh = f64(screen_height())
    # (laid out at u times its desktop size where its type would otherwise be too small to read)
    u = readable_k(19.0)
    small = readable(15.0)
    w = min(720.0 * u, sw - 60.0)
    h = (150.0 + f64(rows.len()) * 40.0 + 60.0 + 24.0) * u
    x = (sw - w) * 0.5
    y = max((sh - h) * 0.5, 4.0)
    # (on a phone on its side, below the pad's buttons along the top, as far as it fits)
    at = panel_clear_of_pad(x, y, w, h, sw, sh)
    x = f64(at.x); y = f64(at.y)
    rect(0, 0, sw, sh, rgba(0.03, 0.04, 0.06, 0.4))
    rect_rounded(x + 4, y + 6, w, h, 8, rgba(0, 0, 0, 0.3))
    rect_rounded(x, y, w, h, 8, PAPER)
    rect_rounded_outline(x + 8, y + 8, w - 16, h - 16, 6, 1.5, PAPER_DARK)
    set_font(fonts.title)
    ptext(trader, vec2(f32(x + 30 * u), f32(y + 22 * u)), 26 * u, INK)
    tw = ptext_width(trader, 26 * u)
    set_font(fonts.ui)
    ptext(place, vec2(f32(x + 42 * u + tw), f32(y + 31 * u)), readable(16.0), LIGHT_INK)
    close = Rect(x + w - 44 * u, y + 14 * u, 30 * u, 30 * u)
    ptext_centered("×", vec2(f32(close.x + 15 * u), f32(close.y + 13 * u)), 30 * u, if _hover(close): INK else: LIGHT_INK)
    if _clicked(close) or mkey(.escape): res.closed = true
    hy = y + 74.0 * u
    cols = [x + 30 * u, x + 230 * u, x + 330 * u, x + 430 * u, x + 520 * u, x + 600 * u]
    heads = ["goods", "they sell", "they buy", "in stock", "yours", ""]
    loop k in 0..heads.len(): ptext(heads[k], vec2(f32(cols[k]), f32(hy)), small, LIGHT_INK)
    line(vec2(f32(x + 24), f32(hy + 24 * u)), vec2(f32(x + w - 24), f32(hy + 24 * u)), 1.5, PAPER_DARK)
    body = 19.0 * u
    loop k in 0..rows.len():
        g = rows[k]
        ry = hy + (34.0 + f64(k) * 40.0) * u
        marked = k == _ledger_row
        if marked: rect_rounded(x + 22, ry - 7 * u, w - 44, 34 * u, 5, rgba(0.85, 0.74, 0.5, 0.3))
        ptext("{g.name}", vec2(f32(cols[0]), f32(ry)), body, INK)
        ptext(phoenix_text(g.buy), vec2(f32(cols[1]), f32(ry)), body, INK)
        ptext(phoenix_text(g.sell), vec2(f32(cols[2]), f32(ry)), body, INK)
        ptext("{g.stock}", vec2(f32(cols[3]), f32(ry)), body, LIGHT_INK)
        ptext("{g.have}", vec2(f32(cols[4]), f32(ry)), body, INK)
        bb = Rect(cols[5], ry - 4 * u, 40 * u, 28 * u)
        sb = Rect(cols[5] + 46 * u, ry - 4 * u, 40 * u, 28 * u)
        n = if marked: qty else: 1
        can_buy = g.stock >= n and money >= g.buy * n and hold_used + n <= hold_size
        can_sell = g.have >= n
        if marked and qty > 1: ptext("x{qty}", vec2(f32(cols[5] - 8 * u - ptext_width("x{qty}", small)), f32(ry + 2 * u)), small, LIGHT_INK)
        rect_rounded(bb.x, bb.y, bb.w, bb.h, 5, if can_buy: (if _hover(bb): rgba(0.5, 0.65, 0.4, 1) else: rgba(0.42, 0.56, 0.34, 1)) else: rgba(0.7, 0.68, 0.6, 1))
        rect_rounded(sb.x, sb.y, sb.w, sb.h, 5, if can_sell: (if _hover(sb): rgba(0.75, 0.5, 0.3, 1) else: rgba(0.66, 0.42, 0.25, 1)) else: rgba(0.7, 0.68, 0.6, 1))
        label = min(small, 15.0 * u * 1.15)
        ptext_centered("buy", vec2(f32(bb.x + bb.w * 0.5), f32(bb.y + bb.h * 0.5)), label, rgba(1, 0.97, 0.9, 1))
        ptext_centered("sell", vec2(f32(sb.x + sb.w * 0.5), f32(sb.y + sb.h * 0.5)), label, rgba(1, 0.97, 0.9, 1))
        if marked:
            mb = if _ledger_sell: sb else: bb
            rect_rounded_outline(mb.x - 2, mb.y - 2, mb.w + 4, mb.h + 4, 6, 2.0, rgba(0.32, 0.2, 0.1, 0.9))
        res_qty = n
        if can_buy and (_clicked(bb) or marked and (mkey(.b) or mkey(.enter) and not _ledger_sell)):
            res.row = k
            res.dir = 1
            res.qty = res_qty
        if can_sell and (_clicked(sb) or marked and (mkey(.s) or mkey(.enter) and _ledger_sell)):
            res.row = k
            res.dir = -1
            res.qty = res_qty
    fy = y + h - 68.0 * u
    line(vec2(f32(x + 24), f32(fy - 10 * u)), vec2(f32(x + w - 24), f32(fy - 10 * u)), 1.5, PAPER_DARK)
    ptext(phoenix_text(money), vec2(f32(x + 30 * u), f32(fy)), 20 * u, INK)
    hold = "hold {hold_used} / {hold_size}"
    ptext(hold, vec2(f32(x + w - 30 * u - ptext_width(hold, 18 * u)), f32(fy + 2 * u)), 18 * u, LIGHT_INK)
    hint = "Up/Down a good    Left/Right how many ({qty})    B buy    S sell    Tab, Enter the marked button"
    hs = readable(13.0)
    if ptext_width(hint, hs) > w - 60 * u: hint = "Up/Down  Left/Right ({qty})  B buy  S sell  Tab, Enter"
    ptext(fit_text(hint, w - 60 * u, hs), vec2(f32(x + 30 * u), f32(fy + 32 * u)), hs, LIGHT_INK)
    set_font()
    res
