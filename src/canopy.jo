# The far canopy: trees and maquis as a painted surface beyond (and under) the grove meshes.
#
# Two classes share the terrain's ground material (src/terrain.jo ground_surface):
# - the trees: the streamed groves' own pines (src/world_groves.jo), found again in the shader
#   from the same pure cell query (grove_layout, grove_chances, grove_sibling, grove_kind_at) and
#   the same density field (the terrain's baked grove field, its tint.x). Where meshes stand, a
#   kept tree's painted crown is only its shade on the ground and nothing is painted where no
#   mesh stands; beyond the meshes' reach the painted crown is the tree. So the paint is as
#   sparse or as dense as the trees themselves.
# - the maquis: the summer cover's own class (scrub and pine understory), a sheet of smaller
#   scalloped crowns and, farther off, the clumps they gather in, which make a wooded hillside
#   one mottled, contiguous surface from afar; its edges break into scattered crowns.
# Every value here comes from integer cell hashes (hash21), identical on the CPU and the GPU.
use 'look.jo'
use 'paint.jo'
use 'quality.jo'
use 'baked_assets.jo'
use 'plants.jo'

const GROVE_CELL = 26.0
# (the new world's grove field: the materials' fbm(x*0.004+3.3, z*0.004, 3))
const GROVE_SEED = 3.3

# Four 6-bit fields of one 24-bit cell hash, each in (0, 1). Exact in f32 on both sides.
grove_bits = (h: f32) -> vec4:
    a = h*64.0
    x = floor(a); a = (a-x)*64.0
    y = floor(a); a = (a-y)*64.0
    z = floor(a); a = (a-z)*64.0
    (vec4(x,y,z,floor(a))+vec4(0.5,0.5,0.5,0.5))/64.0

# A candidate cell's fixed draws: (jitter x, jitter z, crown scale, rotation).
grove_layout = (cell: vec2) -> vec4: grove_bits(hash21(cell+vec2(7919.0,104729.0)))
# Its chances: (alpine cull, pine, bush, shade).
grove_chances = (cell: vec2) -> vec4: grove_bits(hash21(cell+vec2(-31337.0,52361.0)))
# Whether the cell's trees are drawn as meshes on a tier (under the tier's share), and when
# past the meshes' reach a thinned one comes in as paint.
grove_keep = (cell: vec2) -> f32: hash21(cell+vec2(1201.0,8803.0))
# A pine's neighbour: (chance, offset x, offset z, scale).
grove_sibling = (cell: vec2) -> vec4: grove_bits(hash21(cell+vec2(60493.0,-24611.0)))

const GROVE_SIBLING_REACH = 7.0

# The same ecology thresholds as grove_kind (objects.jo) for the new world: -1 none, 0 pine,
# 2 bush (Tree order). Height, slope (rise over run) and density at the tree.
grove_kind_at = (chance: vec4,dens: f32,slope: f32,h: f32) -> int:
    if h < 4.0 or h >= 2200.0 or slope > 0.7: return -1
    if chance.x < smoothstep(1500.0,2200.0,h): return -1
    if slope < 0.45 and dens > 0.52 and chance.y < (dens-0.45)*2.2: return 0
    if dens > 0.4 and chance.z < 0.35: return 2
    -1

# The grove density at a point of the new world, exactly as the terrain's materials carry it
# (world_tile_job_rows: one byte), so the shader reads the trees' own field for free.
grove_field = (x: f64,z: f64) -> f64: round(clamp(fbm(x*0.004+GROVE_SEED,z*0.004,3),0.0,1.0)*255.0)/255.0

# The share of the new world's grove cells drawn as meshes on this tier (grove_keep under it):
# all on high, a quarter below (the groves gather into stands, so the old lists' double thinning,
# a ninth on low, left low's stands nearly bare; a quarter keeps about the old count nearby).
grove_kept_share = () -> f32: if render_quality.tree_stride > 1: 0.25 else: 1.0

# canopy_paint's grove uniform: (the meshes' reach from the camera, the kept share (0: meshes
# not placed by the cell query, as on the old islands: nothing painted under them), detail
# (0 low, 1 medium and high), 1 paint (0: the mean only, for grass blades)).
grove_uniform = (reach: f64,share: f32) -> vec4: vec4(f32(reach),share,if render_quality.tier == 0: 0.0 else: 1.0,1)
grove_new_world = () -> vec4: grove_uniform(render_quality.grove_distance-112.0,grove_kept_share())
grove_islands = () -> vec4: grove_uniform(render_quality.tree_distance,0.0)

# The canopy's modelling light: the sun's bearing, held low over the crowns at every hour, so the
# lumps keep a lit side and a shaded side even at noon (a high sun alone models nothing: the
# canopy read flat from afar); w fades it out as the sun goes down. A world direction, never the
# camera's, so nothing swims as the view turns.
canopy_light = (sun: vec3) -> vec4:
    s = normalize(sun)
    h = vec2(s.x,s.z)
    dir = if length(h) > 0.05: normalize(h) else: vec2(-0.6,0.8)
    vec4(normalize(vec3(dir.x*0.85,max(s.y,0.0)*0.5+0.22,dir.y*0.85)),clamp(s.y*5.0,0.0,1.0))

# The land's modelling light (ground_surface): the sun's bearing held a little lower than a
# high sun, weighted into the land's own light, so slopes turned from the sun read shaded and
# ridges lit even at noon: the bands the far land is built from. w: its weight.
land_light = (sun: vec3) -> vec4:
    s = normalize(sun)
    h = vec2(s.x,s.z)
    dir = if length(h) > 0.05: normalize(h) else: vec2(-0.6,0.8)
    high_sun = clamp((s.y-0.24)*2.2,0.0,1.0)
    vec4(normalize(vec3(dir.x*0.84,0.54,dir.y*0.84)),0.68*high_sun)

# The land's own aerial perspective, painted in layers: the same air as look.jo aerial (its
# optical depth, thinner up high), but seen against land as a deeper blue than the horizon haze,
# turning to the haze only far off. The land keeps its own colour a long way (about two
# thirds at 5 km, half at 10, a quarter at 20), so ridge behind ridge stands a clear value step
# paler and bluer than the one in front, as far mountain ranges do. And the valleys hold the air,
# so a far ridge's foot is paler than its crest and every crest reads against the one behind it.
# (Flattening the far shading to one tone here cost the low tier's ground shader about 0.25 ms on
# redfox's GPU, a register cliff: left out.)
const LAND_FADE = 16500.0             # the land's own colour fades over this (m, at sea level)
const LAND_MIST: f32 = 0.78           # the valleys' extra air (optical depth at sea level, far off)
const LAND_MIST_FALL: f32 = 0.0023    # ... thinning upward (per metre) so crests rise out of valley mist
# land_aerial's two factors (how much of the land is seen, how far its air has turned to the
# haze), for a shader that reckons them per vertex (the crowns and the woods' canopy): land_aerial_apply
# mixes them in per pixel.
# Painted layers (off by default; Tweaks › Look, AEGEAN_PAINTED_LAYERS=1 to compare): optional
# distance bands (1, 2, 4, 8, 16, 32 km). By default steps is 0 so haze follows smooth distance and
# terrain elevation (valley mist thinning up slopes), letting nearer ridges stand out from farther
# ones without camera-centred circular rings.
land_step_scale = (dist: f32,steps: f32) -> f32:
    r = 1.0
    if steps > 0.0:
        q = log2(max(dist,1000.0)/1000.0)
        band = 1000.0*pow(2.0,floor(q)+smoothstep(0.46,0.54,fract(q)))
        r = mix(1.0,band/max(dist,1.0)*2.5,steps*clamp((dist-800.0)*0.002,0.0,1.0))
    r
land_aerial_terms = (world: vec3,cam: vec3,density: f32,steps: f32 = 0.0) -> vec2:
    dist = length(world-cam)
    low = max(min(world.y,cam.y),0.0)
    dh = abs(max(world.y,0.0)-max(cam.y,0.0))*0.0012
    mean = exp(-low*0.0012)*(if dh < 0.01: 1.0-dh*0.5 else: (1.0-exp(-dh))/dh)
    optical = max(dist-60.0,0.0)*density*(0.12+0.88*mean)
    fade = max(dist-300.0,0.0)*(0.7+0.3*mean)/(f32(LAND_FADE)*(1.0+max(cam.y,0.0)*0.0002))
    far = smoothstep(1200.0,7500.0,dist)
    mist = exp(-max(world.y,0.0)*LAND_MIST_FALL)*far*LAND_MIST
    vec2(exp(-(fade+optical*0.25)*land_step_scale(dist,steps)-mist),1.0-exp(-optical*0.35))
land_aerial_apply = (c: vec3,terms: vec2,haze: vec3) -> vec3:
    air = mix(haze*vec3(0.32,0.70,0.94),haze,terms.y)
    c*terms.x+air*(1.0-terms.x)

land_aerial = (c: vec3,world: vec3,cam: vec3,haze: vec3,density: f32,steps: f32 = 0.0) -> vec3:
    dist = length(world-cam)
    low = max(min(world.y,cam.y),0.0)
    dh = abs(max(world.y,0.0)-max(cam.y,0.0))*0.0012
    mean = exp(-low*0.0012)*(if dh < 0.01: 1.0-dh*0.5 else: (1.0-exp(-dh))/dh)
    optical = max(dist-60.0,0.0)*density*(0.12+0.88*mean)
    # (smooth distance attenuation plus elevation-stratified valley mist, so nearer ridges stand
    # out from misted valleys and farther ranges without circular distance bands)
    fade = max(dist-300.0,0.0)*(0.7+0.3*mean)/(f32(LAND_FADE)*(1.0+max(cam.y,0.0)*0.0002))
    far = smoothstep(1200.0,7500.0,dist)
    mist = exp(-max(world.y,0.0)*LAND_MIST_FALL)*far*LAND_MIST
    seen = exp(-(fade+optical*0.25)*land_step_scale(dist,steps)-mist)
    # (the air seen against land: a rich Mediterranean cerulean-teal rather than chalky grey haze,
    # its red pulled down; it nears the horizon haze only far off)
    air = mix(haze*vec3(0.32,0.70,0.94),haze,1.0-exp(-optical*0.35))
    c*seen+air*(1.0-seen)

# The ground's air carried from its vertices (its optical weights change over kilometres): the same
# air as land_aerial, Painted layers steps included, as (how much of the land is seen, the share of
# the air still short of the haze); apply_land_air mixes it in per pixel.
land_air_weights = (world: vec3,cam: vec3,density: f32,steps: f32 = 0.0) -> vec2:
    t = land_aerial_terms(world,cam,density,steps)
    vec2(t.x,(1.0-t.x)*(1.0-t.y))

apply_land_air = (color: vec3,haze: vec3,air: vec2) -> vec3:
    color*air.x+haze*((1.0-air.x)-vec3(0.68,0.30,0.06)*air.y)

# The expected share of the ground under pine crowns: the far canopy's mean when crowns are too
# small to draw (a pine crown about 80 m^2, 1.6 trees a cell where it holds a pine).
# (linear ramps throughout the shader paths: on the laptop's GPU each smoothstep was a cost)
grove_pine_cover = (dens: f32,slope: f32,h: f32) -> f32:
    ok = clamp((0.48-slope)*16.0,0.0,1.0)*clamp((2200.0-h)/700.0,0.0,1.0)
    clamp((dens-0.5)*1.5,0.0,0.19)*ok

# The maquis' stand cover for the canopy: the summer cover's field (and its drier south faces
# and ridges, plants.jo summer_cover) on one wider linear ramp, so a stand thins out into the
# dry grass over a hundred metres or so instead of ending at a line. (One ramp: on low every
# land pixel pays for this.)
canopy_stand = (n: vec3,ridge: f32,field: f32) -> f32:
    clamp((field-0.365-n.z*0.06-ridge*0.05)*5.2,0.0,1.0)

# ---------------- the woods' stand cover ----------------
# The woods' stand cover at a sample, as the ground shader paints it (terrain.jo ground_surface:
# the summer cover's woody share and the canopy's stand on vegetated ground, less orchards and
# farmed fields): the woods' canopy (src/world_terrain.jo) stands where the paint draws crowns.
# n: the sample's normal; tx, ty: its materials' tint x and y; share: its field share.
const CANOPY_EDGE = 0.5             # (the stand cover where the canopy's edge runs)

# x: the stand cover; y: how far the canopy has risen there (0 at a wood's edge, 1 in its heart). The
# stand cover closes within a few metres at a wood's edge; a canopy as steep would stand like a
# wall. So its height follows the smooth field the stand is drawn from, over the field's next
# fifth: tens of metres of scrub and low crowns stepping up to the wood, and woods taller in
# their hearts. Where farmland or rock cuts the stand, the canopy ends with it.
# wash: the broad wash of the field (the new world's noise; the old islands' pigment sheet).
# treeline: the new world's (its high land is bare).
wood_cover = (n: vec3,y: f32,ridge: f32,tx: f32,ty: f32,wash: f32,share: f32,orchard: f32,treeline: bool) -> vec2:
    if y < 0.6: return vec2(0,0)
    slope = 1.0-n.y
    field = tx*0.65+wash*0.35+(ty-0.5)*0.25
    patch = smoothstep(0.30,0.67,field)
    rg = clamp(ridge,-1.0,1.0)
    cover = summer_cover(n,y,rg,patch)
    outcrop = smoothstep(0.62,0.79,ty)*smoothstep(0.15,0.4,slope)
    exposure = max(smoothstep(0.26,0.72,slope+(patch-0.5)*0.26),outcrop*0.78)
    veg = (1.0-exposure)*smoothstep(0.6,1.5,y)*(if treeline: 1.0-smoothstep(1700.0,2300.0,y) else: 1.0)
    if veg <= 0.0: return vec2(0,0)
    stand = max(cover.y+cover.z,canopy_stand(n,rg,field))*veg*(1.0-orchard*0.7)*clamp(1.0-share*veg*1.35,0.0,1.0)
    closed = clamp((stand-CANOPY_EDGE+0.02)*2.2,0.0,1.0)
    # (among fields the farmland ends where the pines' density takes over, src/fields.jo
    # field_share: there the canopy rises with that density, from the fields' last edge)
    farmable = clamp((0.26-slope)*8.0,0.0,1.0)*clamp((850.0-y)/250.0,0.0,1.0)*clamp((y-4.0)*0.5,0.0,1.0)
    natural = min(clamp((field-0.44-n.z*0.06-rg*0.05)*5.0,0.0,1.0),mix(1.0,clamp((tx-0.56)*8.0,0.0,1.0),farmable))
    vec2(stand,min(closed*closed,natural))

# ---------------- the trees ----------------

struct GroveCrown:
    normal: vec2 = vec2(0,0)        # the crown's rounded normal (x, z), world axes
    cap: f32 = 0.0                  # 0 outside, 1 at the crown's top
    shade: f32 = 0.5                # the tree's own shade draw
    keep: f32 = 0.0                 # the cell's grove_keep

# One crown on the ground plane: a slightly uneven ellipse, rounded normal, cap height.
_grove_disc = (d: vec2,radius: f32,shape: f32,crown: mut GroveCrown,shade: f32,height: f32,keep: f32):
    q = d/(radius*vec2(1.0+(shape-0.5)*0.25,1.0-(shape-0.5)*0.25))
    t = 1.0-dot(q,q)
    if t <= 0.0: return
    cap = sqrt(t)
    if cap*height <= crown.cap: return
    crown.cap = cap*height
    crown.normal = q
    crown.shade = shade
    crown.keep = keep

# The topmost pine crown over a ground point (absolute world xz), from the 2x2 candidate cells
# around it (a crown or its neighbour never reaches past half a cell). dens, slope and height
# are the fragment's: the shader's stand-ins for the values at each tree. (The groves' bushes
# are the maquis' class here.)
grove_crown = (p: vec2,dens: f32,slope: f32,h: f32) -> GroveCrown:
    crown = GroveCrown()
    base = floor(p/GROVE_CELL-vec2(0.5,0.5))
    loop k in 0..4:
        cell = base+vec2(f32(k%2),f32(k/2))
        lay = grove_layout(cell)
        d = p-(cell+lay.xy)*GROVE_CELL
        if dot(d,d) > 169.0: continue
        chance = grove_chances(cell)
        if grove_kind_at(chance,dens,slope,h) != 0: continue
        keep = grove_keep(cell)
        scale = 0.75+0.55*lay.z
        _grove_disc(d,4.8*scale,lay.w,crown,chance.w,scale,keep)
        sib = grove_sibling(cell)
        if sib.x < 0.6:
            s2 = 0.7+0.45*sib.w
            _grove_disc(d-(sib.yz*2.0-vec2(1,1))*GROVE_SIBLING_REACH,4.8*s2,sib.y,crown,chance.w,s2,keep)
    crown

# ---------------- the crown mass sheet ----------------
# 64 cells square, two scalloped crowns a cell (a large and a small one), wrapped so the sheet
# tiles. RG: the top crown's normal (x, z); B: its cap (0 in the gaps); A: its own random number
# (presence against the cover, and its colour).
const CANOPY_CELLS = 64
const CANOPY_PIXELS = 512

# Each cell's two crowns, drawn once: (center x, center z, radius, lobes) and
# (phase a, phase b, phase c, height); the id is a third draw.
struct CanopySeed:
    shape: vec4
    phase: vec4
    id: f32

canopy_seeds = () -> CanopySeed[]:
    seeds: CanopySeed[]
    loop z in 0..CANOPY_CELLS:
        loop x in 0..CANOPY_CELLS:
            w = vec2(f32(x),f32(z))
            loop k in 0..2:
                a = grove_bits(hash21(w+vec2(f32(k)*911.0+17.0,f32(k)*577.0+43.0)))
                b = grove_bits(hash21(w+vec2(f32(k)*313.0+71.0,f32(k)*199.0+5.0)))
                center = vec2(0.5,0.5)+(a.xy-vec2(0.5,0.5))*0.9
                radius = if k == 0: 0.42+a.z*0.30 else: 0.26+a.z*0.18
                seeds.push(CanopySeed(vec4(center.x,center.y,radius,5.0+floor(a.w*4.0)),vec4(b.x*TAU,b.y*TAU,b.z*TAU,0.8+0.5*b.w),hash21(w+vec2(f32(k)*41.0+3.0,f32(k)*83.0+11.0))))
    seeds

canopy_sheet_pixel = (p: vec2,seeds: CanopySeed[]) -> vec4:
    cell = floor(p)
    best: f32 = 0.0; normal = vec3(0,1,0); id: f32 = 0.5; cap: f32 = 0.0
    loop z in -1..2:
        loop x in -1..2:
            c = cell+vec2(f32(x),f32(z))
            w = c-floor(c/f32(CANOPY_CELLS))*f32(CANOPY_CELLS)
            loop k in 0..2:
                s = seeds[(int(w.y)*CANOPY_CELLS+int(w.x))*2+k]
                d = p-c-s.shape.xy
                reach = s.shape.z*1.2
                if dot(d,d) >= reach*reach: continue
                n = d/max(length(d),0.0001)
                # scalloped rims: 5 to 8 lobes, a fifth of the radius
                lobes = s.shape.w
                wobble = 1.0+0.12*sin(n.x*lobes+s.phase.x+n.y*2.0)*sin(n.y*lobes*0.7+s.phase.y)+0.06*sin((n.x-n.y)*(lobes+3.0)+s.phase.z)
                q = d/(s.shape.z*wobble)
                t = 1.0-dot(q,q)
                if t <= 0.0: continue
                h = sqrt(t)
                height = h*s.shape.z*s.phase.w
                if height > best:
                    best = height; cap = h; id = s.id
                    normal = normalize(vec3(q.x,h*1.15,q.y))
    vec4(normal.x*0.5+0.5,normal.z*0.5+0.5,cap,id)

canopy_sheet_image = () -> Image:
    img = image(CANOPY_PIXELS,CANOPY_PIXELS)
    seeds = canopy_seeds()
    k = f32(CANOPY_CELLS)/f32(CANOPY_PIXELS)
    loop y in 0..CANOPY_PIXELS:
        loop x in 0..CANOPY_PIXELS: img.set(x,y,canopy_sheet_pixel((vec2(f32(x),f32(y))+vec2(0.5,0.5))*k,seeds))
    img

# (baked by tools/bake.jo as assets/baked/canopy-sheet-v1.png, the same RGBA8 bytes: making it
# takes a fifth of a second. Raise the version in the name when the sheet's code changes.)
const CANOPY_SHEET_BAKE = "canopy-sheet-v1.png"
load_canopy_sheet = () -> Image:
    if let bytes = baked_asset(CANOPY_SHEET_BAKE):
        loaded = load_png(bytes)
        if loaded is Image and loaded.width == CANOPY_PIXELS and loaded.height == CANOPY_PIXELS: return loaded
    canopy_sheet_image()

canopy_tex: Texture
canopy_sheet = () -> Texture:
    global canopy_tex
    if canopy_tex.id == 0:
        canopy_tex = texture(load_canopy_sheet(),true)
        set_repeat(canopy_tex,true)
        set_mipmaps(canopy_tex,true)
    canopy_tex

# metres per crown-mass cell
const CANOPY_CELL = 9.0


# ---------------- the painted canopy (ground shader) ----------------

struct CanopyPaint:
    color: vec3                     # albedo with the crowns painted in
    bend: vec2 = vec2(0,0)          # the crowns' normal, added to the ground's (x, z)
    crown: f32 = 0.0                # how much of the pixel is crown (lit by the wrapped ramp)
    offset: f32 = 0.0               # per-crown shift of the painted terminator
    shadow: f32 = 0.0               # cast by the next crown sunward (medium and high)

# The near crowns' mean over a stand of this cover (gaps, floor and crowns): the clumps' colour
# farther off, so a stand's margin stays as soft there as near and matches the canopy sheet handover.
canopy_mean = (base: vec3,maquis: f32) -> vec3:
    closed = clamp((maquis-0.6)*2.5,0.0,1.0)
    mix(mix(base,vec3(0.06,0.19,0.15),closed*0.62),mix(vec3(0.18,0.34,0.22),vec3(0.11,0.27,0.19),closed*0.42),maquis*0.88)

# Smooth C1 per-crown tone variation in [0, 1] with exact mean 0.5 at mipmap convergence
# (replaces fract(w*7.13) sawtooth wraps that broke hardware mipmapping and shimmered during pans).
canopy_tone = (w: f32) -> f32:
    u = w-0.5
    0.5+u*(4.0-8.0*abs(u))

# One octave of canopy lumps: returns signed directional 3D relief in [-1, 1] — positive on sunlit
# crown-cluster crests, negative in deep hollows and leeward shadow faces, modelled by the held-low
# canopy light on every tier. Contiguous inside closed woods (no polka-dot dropouts), breaking into
# scattered crowns at wood margins.
_canopy_lump_relief = (k: vec4,cover: f32,light: vec4) -> f32:
    present = clamp((cover*1.28-k.w)*2.2+0.65,0.0,1.0)
    dome = clamp(k.z*1.75,0.0,1.0)*present
    sun_side = dot(k.xy*2.0-vec2(1,1),light.xz)*light.w
    tone = (canopy_tone(k.w)-0.5)*0.45
    clamp((dome-0.46)*1.45+sun_side*(0.40+1.25*dome)+tone*dome,-1.0,1.0)

const CANOPY_CLUMPS = 6.0
const CANOPY_MASSES = 18.0
const CANOPY_SWELLS = 48.0

# Directional 3D relief (signed [-1, 1]) for far woods (1..20 km, 300..4000 m altitude), shared
# identically by low, medium and high tiers. Uses a single hardware-mipmapped world-fixed 36 m
# cluster fetch (aligned with world_shell's far octave) so facing slopes keep plush velvety 3D
# forest roughness while grazing ridges and 300 m flight views filter cleanly without aliasing.
canopy_far_relief = (sheet: Texture,p: vec2,footprint: f32,cover: f32,light: vec4) -> f32:
    nyq = clamp((34.0-footprint)/22.0,0.0,1.0)
    strength = clamp((cover-0.1)*2.5,0.0,1.0)*nyq
    if strength <= 0.0: return 0.0
    k = sample(sheet,p/(f32(CANOPY_CELLS)*CANOPY_CELL*4.0)+vec2(0.74,1.22))
    _canopy_lump_relief(k,cover,light)*strength

# Convert signed far canopy relief [-1, 1] to a plush emerald-crest / cool-pine-hollow albedo tint
# matching crown_palette and world_shell_fragment without neon yellow-lime spikes.
canopy_relief_tint = (r: f32) -> vec3:
    lit_w = max(r,0.0)
    shd_w = max(-r,0.0)
    vec3(0.98,0.99,0.99)+vec3(0.28,0.34,0.12)*lit_w-vec3(0.46,0.32,0.16)*shd_w

# Legacy scalar wrapper retained for any external callers.
canopy_far_value = (sheet: Texture,p: vec2,footprint: f32,cover: f32,light: vec4,wide: bool) -> f32:
    t = canopy_relief_tint(canopy_far_relief(sheet,p,footprint,cover,light))
    dot(t,vec3(0.3,0.59,0.11))

# A sheet sample's crown: present where its own random number is under the cover, inside its rim.
_canopy_mass = (s: vec4,cover: f32,soft: f32,edge: f32) -> f32:
    clamp((cover-s.w)/(2.0*soft)+0.5,0.0,1.0)*clamp(s.z/edge,0.0,1.0)

# base: the ground's colour (also the gaps between crowns: in a stand's thin margin it is the
# dry grass around, so the margin has no outline); maquis: the stand cover (0 to 1); dens: the
# grove field (the materials' tint.x).
canopy_paint = (base: vec3,n: vec3,p: vec2,y: f32,footprint: f32,dens: f32,maquis: f32,distance: f32,sun: vec3,light: vec4,sheet: Texture,grove: vec4) -> CanopyPaint:
    slope = length(n.xz)/max(n.y,0.1)
    pines = grove_pine_cover(dens,slope,y)
    if maquis < 0.01 and pines <= 0.0: return CanopyPaint(base)
    if grove.w == 0.0: return CanopyPaint(mix(base,vec3(0.12,0.22,0.13),pines*0.5))
    # The maquis: one sheet at two physical scales, crowns (9 m cells) near and the clumps they
    # gather in (54 m) beyond; one fetch, both only across the hand-over. Between its crowns the
    # summer grass shows where the scrub is open, so the scrub's edges break into scattered
    # crowns; where it closes, a shaded floor.
    span = f32(CANOPY_CELLS)*CANOPY_CELL
    far = clamp((footprint-3.5)*0.5,0.0,1.0)
    color = base
    bend = vec2(0,0)
    lit: f32 = 0.0
    offset: f32 = 0.0
    shadow: f32 = 0.0
    if far < 1.0:
        s = sample(sheet,p/span)
        m_eff = clamp((maquis-0.14)*1.22,0.0,1.0)
        mass = _canopy_mass(s,m_eff,0.06,0.3)
        tone = canopy_tone(s.w)
        closed = clamp((maquis-0.6)*2.5,0.0,1.0)
        shrub = mix(vec3(0.13,0.29,0.20),vec3(0.24,0.38,0.22),tone)*(0.76+0.3*s.z)
        shrub = mix(shrub,vec3(0.08,0.22,0.17),closed*0.42)
        ground = mix(base,vec3(0.05,0.16,0.13),closed*0.62)
        color = mix(ground,shrub,mass)
        bend = (s.xy*2.0-vec2(1,1))*mass*0.5
        lit = mass
        offset = (s.w-0.5)*0.12
        if grove.z > 0.0:
            cs = sample(sheet,(p+sun.xz/max(sun.y,0.3)*3.0)/span)
            shadow = clamp(_canopy_mass(cs,maquis,0.06,0.3)*(cs.z-s.z*mass),0.0,1.0)*0.35
    if far > 0.0:
        # Farther off, directional 3D canopy relief across continuous physical octaves:
        # warm sunlit crests and cool deep blue-green shadow hollows matching the canopy sheet.
        k = sample(sheet,p/(span*CANOPY_CLUMPS)+vec2(0.37,0.61))
        hold = clamp((35.0-footprint)/20.0,0.0,1.0)
        clump = _canopy_mass(k,maquis*1.1,0.12,0.25)*clamp(k.z*1.6,0.0,1.0)
        rel = canopy_far_relief(sheet,p,footprint,maquis,light)
        color = mix(color,canopy_mean(base,maquis)*canopy_relief_tint(rel),far)
        bend = mix(bend,(k.xy*2.0-vec2(1,1))*clump*0.6*hold,far)
        lit = mix(lit,clump*hold,far)
        offset = mix(offset,(k.w-0.5)*0.12*hold,far)
        shadow *= 1.0-far
    # The trees: the groves' own pines. Inside the meshes' reach a kept tree's crown is its
    # shade on the ground, and nothing stands where no mesh does; past it the painted crown is
    # the tree, the thinned ones coming in over the next 400 m, each at its own distance.
    resolve = clamp((7.0-footprint)*0.25,0.0,1.0)
    painted = 1.0
    if pines > 0.0 and resolve > 0.0:
        g = grove_crown(p,dens,slope,y)
        if g.cap > 0.0:
            on = clamp(g.cap/max(0.08,footprint*0.12),0.0,1.0)*resolve
            meshed = grove.y > 0.0 and g.keep < grove.y
            if distance < grove.x:
                if meshed: color = mix(color,color*vec3(0.62,0.68,0.72),on*0.8)
                shadow *= 1.0-on
            else:
                arrive = if meshed: 1.0 else: clamp((distance-grove.x-fract(g.keep*13.0)*400.0)/40.0,0.0,1.0)
                tree = mix(vec3(0.08,0.21,0.16),vec3(0.15,0.29,0.19),g.shade)*(0.85+0.19*clamp(g.cap*2.0,0.0,1.0))
                color = mix(color,tree,on*arrive)
                bend = mix(bend,g.normal,on*arrive)
                lit = mix(lit,1.0,on*arrive)
                offset = mix(offset,(g.shade-0.5)*0.16,on*arrive)
                shadow *= 1.0-on*arrive
        painted = 1.0-resolve
    # far off, the unresolved crowns' mean (and none inside the meshes' reach)
    trees = pines*painted*clamp((distance-grove.x)/400.0,0.0,1.0)
    color = mix(color,vec3(0.09,0.22,0.16),trees)
    CanopyPaint(color,bend,lit,offset,shadow)

# The low tier's canopy, compiled into its own terrain shaders (ground_surface's detail 0):
# returns albedo directly (zero extra live register across ground_fs_low) with the same directional
# 3D canopy relief across continuous physical octaves as medium and high tiers, smoothly crossfading
# across footprint 3.5..5.5 m so moving over land never snaps along a hard distance ring.
canopy_paint_low = (base: vec3,n: vec3,p: vec2,y: f32,footprint: f32,dens: f32,maquis: f32,distance: f32,light: vec4,sheet: Texture,grove: vec4) -> vec3:
    pines = clamp((dens-0.5)*1.5,0.0,0.19)*clamp((0.48-length(n.xz)/max(n.y,0.1))*16.0,0.0,1.0)*clamp((distance-grove.x)/400.0,0.0,1.0)
    if maquis < 0.01 and pines <= 0.0: return base
    if footprint >= 5.5:
        rel = canopy_far_relief(sheet,p,footprint,maquis,light)
        return mix(canopy_mean(base,maquis)*canopy_relief_tint(rel),vec3(0.09,0.22,0.16),pines)
    span = f32(CANOPY_CELLS)*CANOPY_CELL
    s = sample(sheet,p/span)
    m_eff = clamp((maquis-0.14)*1.22,0.0,1.0)
    mass = clamp((m_eff-s.w)*8.0+0.5,0.0,1.0)*clamp(s.z*3.3,0.0,1.0)
    dir = dot(s.xy*2.0-vec2(1,1),light.xz)*light.w
    shrub = mix(vec3(0.13,0.29,0.20),vec3(0.24,0.38,0.22),canopy_tone(s.w))*(0.74+0.32*s.z+dir*0.28)
    floor_mix = clamp((maquis-0.6)*2.5,0.0,1.0)
    shrub = mix(shrub,vec3(0.08,0.22,0.17),floor_mix*0.42)
    c = mix(mix(base,vec3(0.05,0.16,0.13),floor_mix*0.62),shrub,mass)
    if footprint > 3.5:
        rel = canopy_far_relief(sheet,p,footprint,maquis,light)
        c = mix(c,canopy_mean(base,maquis)*canopy_relief_tint(rel),(footprint-3.5)*0.5)
    mix(c,vec3(0.09,0.22,0.16),pines)
