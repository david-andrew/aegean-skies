# Fine aiming by tilting the phone (an option: the pause menu's Options page). The drag does the
# big turns; small turns of the phone nudge the aim, so one can steer low over the water without a
# finger over the screen. The browser hands over how far the phone has turned since the last frame
# about the screen's own axes, in degrees.

when TARGET == "wasm":
    extern __aegean_motion_start = ()
    extern __aegean_motion_live = () -> i32
    extern __aegean_motion_x = () -> f64
    extern __aegean_motion_y = () -> f64

motion_started = false

# start listening (on iOS: asks for permission at the next tap)
motion_start = ():
    global motion_started
    if motion_started: return
    motion_started = true
    when TARGET == "wasm": __aegean_motion_start()

# whether the phone has reported any turning yet (none: no gyroscope, or no permission)
motion_live = () -> bool:
    when TARGET == "wasm": return __aegean_motion_live() != 0
    false

# how far the phone has turned since the last call, degrees: x to the right, y up
motion_take = () -> vec2:
    when TARGET == "wasm": return vec2(f32(__aegean_motion_x()), f32(__aegean_motion_y()))
    vec2(0, 0)
