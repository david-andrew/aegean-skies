use 'descent_view.jo'
# Presentation consumes combat events. All random particles are cosmetic; Battle never reads them.
use 'combat.jo'
use 'damage.jo'
use 'planes.jo'
use 'objects.jo'
use 'look.jo'
use 'folk.jo'
use 'curved_world.jo'
use 'guns.jo'
use 'combat_trails.jo'
use 'quality.jo'
use 'cockpit.jo'

struct CombatView:
    smoke: Particles3D = Particles3D(gravity=vec3(0,0.3,0),drag=0.2)
    flame: Particles3D = Particles3D(gravity=vec3(0,0.7,0),drag=0.3)
    sparks: Particles3D = Particles3D(gravity=vec3(0,-8,0),drag=0.6)
    mist: Particles3D = Particles3D(gravity=vec3(0,-3,0),drag=1.2)
    emit_clock = 0.0
    trail_clock = 0.0
    time = 0.0
    trails: BattleTrails
    observer: vec3 = vec3(0,0,0)
    hit = 0.0
    recoil = 0.0
    near_ids: int[]
    whizzes: vec3[]
    whizz_cool = 0.0
    low: Mesh[]
    low_parts: Mesh[]
    chute: Mesh
    hole: Mesh
    oil: Mesh
    pilot: Figure
    distant_pilot: Mesh

_cv_tri = (vs: mut Vertex3D[], a: vec3,b: vec3,c: vec3,col: vec4):
    n=normalize(cross(b-a,c-a)+vec3(0,0.000001,0))
    loop p in [a,b,c]: vs.push(Vertex3D(p,n,vec2(0,0),col))

_cv_line = (vs: mut Vertex3D[], a: vec3,b: vec3,width: f64,col: vec4):
    side=normalize(cross(b-a,vec3(0,0,1))+vec3(0.0001,0,0))*f32(width)
    _cv_tri(vs,a-side,b-side,b+side,col);_cv_tri(vs,a-side,b+side,a+side,col)
    _cv_tri(vs,b+side,b-side,a-side,col);_cv_tri(vs,a+side,b+side,a-side,col)
    side=normalize(cross(b-a,vec3(1,0,0))+vec3(0,0,0.0001))*f32(width)
    _cv_tri(vs,a-side,b-side,b+side,col);_cv_tri(vs,a-side,b+side,a+side,col)
    _cv_tri(vs,b+side,b-side,a-side,col);_cv_tri(vs,a+side,b+side,a-side,col)

make_combat_view = () -> CombatView:
    v=CombatView(trails=make_battle_trails())
    loop id in 0..CRAFT_NAMES.len():
        p=aircraft_profile(Craft(id)); vs:Vertex3D[]
        # Silhouette LOD: at most 96 triangles, batched by kind. No gauges, struts or props.
        col=rgb(0.85,0.83,0.72)
        add_box(vs,vec3(0,0,0),vec3(p.width*2,p.width*1.4,p.length),col)
        loop level in 0..p.decks:
            add_box(vs,vec3(0,p.wing_y-f64(level)*1.6,-0.65),vec3(p.span*(if level==0: 1 else: p.lower_span),0.12,p.chord),col)
        add_box(vs,vec3(0,0.3,p.length*0.42),vec3(p.span*0.3,0.1,p.chord*0.6),col)
        add_box(vs,vec3(0,0.8,p.length*0.42),vec3(0.1,1.4,p.chord*0.6),col)
        if not p.boat:
            loop side in [-1.0,1.0]:add_box(vs,vec3(side*p.float_x,p.float_y,0),vec3(0.65,0.5,p.length*0.72),col)
        v.low.push(custom_mesh(vs))
        loop part in 0..7:
            ps:Vertex3D[]
            if part==0:add_box(ps,vec3(0,0,0),vec3(p.width*2,p.width*1.4,p.length*0.8),col)
            if part==1:add_box(ps,vec3(0,p.engine_y,p.engine_z),vec3(p.width*1.8,p.width*1.7,1.0),rgb(0.25,0.24,0.22))
            if part==2 or part==3:
                side=if part==2:-1.0 else:1.0
                loop level in 0..p.decks:
                    span=p.span*(if level==0:1.0 else:p.lower_span)
                    add_box(ps,vec3(side*span*0.25,p.wing_y-f64(level)*1.6,-0.65),vec3(span*0.5,0.12,p.chord),col)
            if (part==4 or part==5) and not p.boat:
                add_box(ps,vec3((if part==4:-1.0 else:1.0)*p.float_x,p.float_y,0),vec3(0.65,0.5,p.length*0.72),col)
            if part==6:
                add_box(ps,vec3(0,0.3,p.length*0.42),vec3(p.span*0.3,0.1,p.chord*0.6),col)
                add_box(ps,vec3(0,0.8,p.length*0.42),vec3(0.1,1.4,p.chord*0.6),col)
            v.low_parts.push(custom_mesh(ps))
    vs:Vertex3D[]
    # Sky Barons' open canopy: twelve gores, five rings, lines meeting above the shoulders.
    rings=[vec2(6.5,3.5),vec2(7.5,3.15),vec2(8.3,2.4),vec2(8.8,1.4),vec2(9.0,0.45)]
    point=(ring:int,k:int)->vec3:
        angle=TAU*f64(k%12)/12.0
        vec3(cos(angle)*f64(rings[ring].y),rings[ring].x,sin(angle)*f64(rings[ring].y))
    loop k in 0..12:
        col=if k%2==0:rgb(0.95,0.94,0.9) else:rgb(0.84,0.81,0.73)
        loop ring in 0..rings.len()-1:
            a=point(ring,k);b=point(ring,k+1);c=point(ring+1,k+1);d=point(ring+1,k)
            _cv_tri(vs,a,c,b,col);_cv_tri(vs,a,d,c,col)
            _cv_tri(vs,b,c,a,col*0.8);_cv_tri(vs,c,d,a,col*0.8)
        top=vec3(0,9,0);a=point(4,k);b=point(4,k+1)
        _cv_tri(vs,top,b,a,rgb(0.9,0.88,0.82));_cv_tri(vs,a,b,top,rgb(0.7,0.68,0.62))
        _cv_line(vs,point(0,k),vec3(0,2.2,0),0.025,rgb(0.75,0.73,0.68))
    loop side in [-1.0,1.0]:_cv_line(vs,vec3(0,2.2,0),vec3(0.2*side,1.5,0),0.04,rgb(0.6,0.55,0.45))
    v.chute=custom_mesh(vs)
    vs=[]
    loop j in 0..12:
        a=TAU*f64(j)/12.0;b=TAU*f64(j+1)/12.0
        ra=if j%2==0:0.10 else:0.07
        rb=if j%2==0:0.07 else:0.10
        p=vec3(cos(a)*ra,sin(a)*ra,0);q=vec3(cos(b)*rb,sin(b)*rb,0)
        _cv_tri(vs,vec3(0,0,0),p,q,rgb(0.04,0.03,0.025))
        _cv_tri(vs,p,q,q*1.3,rgb(0.7,0.56,0.32));_cv_tri(vs,p,q*1.3,p*1.3,rgb(0.7,0.56,0.32))
    v.hole=custom_mesh(vs)
    vs=[]
    _cv_tri(vs,vec3(-0.12,0,0),vec3(0.12,0,0),vec3(0.035,0,2.4),rgb(0.12,0.10,0.07))
    v.oil=custom_mesh(vs)
    v.pilot=build_figure(.pilot,93)
    vs=[]
    add_box(vs,vec3(0,0.8,0),vec3(0.45,1.5,0.25),rgb(0.18,0.19,0.14))
    v.distant_pilot=custom_mesh(vs)
    v

# Swept closest approach, so fast rounds cannot skip the listener between fixed ticks.
round_pass = (a:vec3,b:vec3,ear:vec3) -> vec3:
    delta=b-a
    a+delta*clamp(dot(ear-a,delta)/max(dot(delta,delta),0.00001),0.0,1.0)

combat_near_passes = (v:mut CombatView,b:Battle,craft:int,ear:vec3):
    v.whizzes=[]
    if craft<0:return
    loop r in b.rounds:
        if r.owner==craft or v.near_ids.contains(r.serial):continue
        at=round_pass(r.position-r.velocity*f32(COMBAT_DT),r.position,ear)
        if length(at-ear)>12:continue
        v.near_ids.push(r.serial)
        if v.near_ids.len()>128:v.near_ids.remove_at(0)
        if v.whizz_cool<=0:
            v.whizzes.push(at);v.whizz_cool=0.09

combat_effect_events = (v: mut CombatView, events: CombatEvent[],player:int = -1):
    cap=battle_budget(render_quality.tier).particles
    loop event in events:
        p=event.position;distance=f64(length(p-v.observer))
        if event.craft==player and event.kind==.hit:v.hit=min(1.5,v.hit+0.35+event.strength*2.0)
        if event.craft==player and event.kind==.shot:v.recoil=0.7
        if distance>11000:continue
        size=max(1.0,min(9.0,distance*0.0015))
        match event.kind:
            .shot:
                if v.flame.items.len()<cap:
                    v.flame.items.push(Particle3D(p+event.direction*0.6,vec3(0,0,0),0.12,0.12,f32(size),rgba(1,0.8,0.35,1)))
                if v.smoke.items.len()<cap:emit(v.smoke,p,1,1,rgba(0.7,0.68,0.57,0.6),1.4,1.3)
            .hit, .separated:
                if v.flame.items.len()<cap:v.flame.items.push(Particle3D(p,vec3(0,0,0),0.16,0.16,f32(size*1.8),rgba(1,0.9,0.6,1)))
                if v.sparks.items.len()+10<=cap:
                    emit(v.sparks,p,5,22,rgba(1,0.7,0.25,1),0.6,0.3)
                    emit(v.sparks,p,5,13,rgba(0.55,0.35,0.16,1),2.4,0.45)
            .splash:
                count=min(cap-v.mist.items.len(),int(8+event.strength*45))
                if count>0:emit(v.mist,p,count,10+event.strength*17,rgba(0.88,0.96,1,0.9),2.8,1.0+event.strength*3,0.42,vec3(0,1,0))
            _:pass

update_combat_view = (v: mut CombatView, b: Battle, wind: vec3, dt: f64, observer: vec3):
    v.time+=dt
    v.observer=observer;v.hit*=exp(-5.5*dt);v.recoil*=exp(-18.0*dt);v.whizz_cool=max(0.0,v.whizz_cool-dt)
    budget=battle_budget(render_quality.tier)
    step_battle_trails(v.trails,wind,dt)
    v.emit_clock+=dt;v.trail_clock+=dt
    emit_now=v.emit_clock>=0.08;trail_now=v.trail_clock>=budget.sample
    if emit_now:v.emit_clock=v.emit_clock%0.08
    if trail_now:v.trail_clock=v.trail_clock%budget.sample
    if emit_now or trail_now:
        loop a in b.actors:
            strength=max(a.state.damage.smoke,a.fire)
            # Ordinary traffic needs no history lookup, profile transforms or source allocation.
            if a.engagement<0 and strength<0.025:continue
            source=-1
            loop i in 0..v.trails.sources.len():
                if v.trails.sources[i].craft==a.craft:source=i;break
            if source<0 and v.trails.sources.len()<COMBAT_MAX_CRAFT:
                source=v.trails.sources.len();v.trails.sources.push(BattleTrailSource(a.craft,a.state.position,a.state.position))
            if source<0:continue
            valid=a.present and a.status!=.escaped and a.wreck_age<90 and not a.state.on_water and length(a.state.position-observer)<11000
            p=aircraft_profile(a.spec.kind)
            at=a.state.position+quat_rotate(a.state.orientation,vec3(0,p.engine_y,p.engine_z))
            wing=a.state.position+quat_rotate(a.state.orientation,vec3(p.span*0.48,p.wing_y,-0.6))
            turning=valid and strength<0.025 and a.engagement>=0 and (abs(a.pilot.controls.pitch)>0.08 or abs(a.pilot.controls.roll)>0.25) and length(a.state.velocity)>35 and a.status==.flying
            if trail_now:
                src=v.trails.sources[source]
                active=valid and strength>0.025
                if active and src.active and v.time-src.last<budget.sample*2.1 and length(at-src.point)<500:
                    push_battle_ribbon(v.trails,BattleRibbon(src.point+(wind*0.8+vec3(0,0.5+clamp(strength*1.5,0.15,1.0),0))*f32(budget.sample),at,0,22,0.8+strength*2.0,clamp(strength*1.5,0.15,1.0),0.45+strength*0.4),budget.ribbons)
                if turning and src.turning and v.time-src.last<budget.sample*2.1 and length(wing-src.wing)<500:
                    push_battle_ribbon(v.trails,BattleRibbon(src.wing+(wind*0.8+vec3(0,0.5,0))*f32(budget.sample),wing,0,7,0.27,0,0.32),budget.ribbons)
                v.trails.sources[source]=BattleTrailSource(a.craft,at,wing,active,turning,v.time)
            if not valid or not emit_now:continue
            if a.fire>0 and v.flame.items.len()+2<=budget.particles:
                distance=f64(length(at-observer))
                first=v.flame.items.len()
                emit(v.flame,at,2,4.0,rgba(1,0.3,0.025,1),0.75,2.5+a.fire*3,0.7,normalize(-a.state.velocity+vec3(0,5,0)))
                loop i in first..v.flame.items.len():
                    v.flame.items[i].vel+=a.state.velocity*0.25
                    v.flame.items[i].size=max(v.flame.items[i].size,f32(min(12.0,distance*0.002)))
    v.smoke.update(dt);v.flame.update(dt);v.sparks.update(dt);v.mist.update(dt)

# Wing holes are on both skins, rather than on the bullet-facing collision ellipsoid. They
# remain visible from inside a cockpit looking up at an upper wing or down at a lower wing.
hit_mark_frames = (mark:HitMark,kind:Craft) -> mat4[]:
    if mark.part!=.left_wing and mark.part!=.right_wing:
        return [translation(mark.local+mark.normal*0.035)*facing(-mark.normal)]
    p=aircraft_profile(kind);point=mark.local
    top=if kind==.gull:1.55 else:if kind==.corsair:1.5 else:if kind==.falco:-0.35 else:p.wing_y
    gap=if kind==.gull:2.05 else:if kind==.corsair:2.1 else:if p.decks==3:1.25 else:1.9
    deck=clamp(int(round((top-f64(point.y))/gap)),0,p.decks-1)
    point.y=f32(top-f64(deck)*gap)
    span=p.span*(if deck==0:1.0 else:p.lower_span)
    point.x=f32(clamp(f64(point.x),-span*0.47,span*0.47))
    point.z=f32(clamp(f64(point.z),-0.65-p.chord*0.44,-0.65+p.chord*0.44))
    [translation(point+vec3(0,0.115,0))*rotation_x(-PI*0.5),translation(point-vec3(0,0.115,0))*rotation_x(PI*0.5)]

# Inside draw_custom. Detailed damaged craft nearby; one instanced silhouette batch per kind far.
draw_combat_aircraft = (v: CombatView,b: Battle,models: CraftModel[],L: Light,t:f64,skip: int = -1):
    cam=scene_camera()
    far:Instance3D[][]=[loop id in 0..CRAFT_NAMES.len(): []]
    pieces:Instance3D[][]
    holes:Instance3D[]
    loop a in b.actors:
        if not a.present or a.craft==skip or a.status==.escaped or a.wreck_age>90:continue
        if a.external and not a.human and a.last_attacker<0:continue
        distance=length(a.state.position-cam)
        if distance>10000:continue
        at=translation(a.state.position)*quat_to_mat4(a.state.orientation)
        if a.status==.wreck:
            at=translation(a.state.position+vec3(0,-max(0.0,a.wreck_age-60.0)*0.08,0))*quat_to_mat4(a.state.orientation)
        if distance>battle_budget(render_quality.tier).detail:
            tint=if a.side==0:rgb(0.85,0.94,1) else:rgb(0.9,0.4,0.28)
            intact=true
            loop part in a.state.damage.parts:
                if not part.attached:intact=false
            if not intact or a.state.damage.debris.len()>0:
                if pieces.len()==0:pieces=[loop id in 0..CRAFT_NAMES.len()*7: []]
            if intact:far[int(a.spec.kind)].push(instance(at,tint))
            else:
                loop part in 0..7:
                    if a.state.damage.parts[part].attached:pieces[int(a.spec.kind)*7+part].push(instance(at,tint))
            loop debris in a.state.damage.debris:
                model=models[if a.model>=0 and a.model<models.len():a.model else:default_craft_model(a.spec.kind)]
                frame=translation(debris.position)*quat_to_mat4(debris.orientation)*translation(-model.parts[int(debris.part)].spec.attachment)
                pieces[int(a.spec.kind)*7+int(debris.part)].push(instance(frame,tint))
        else:
            model=models[if a.model>=0 and a.model<models.len():a.model else:default_craft_model(a.spec.kind)]
            draw_craft_parts(model,a.state.damage,at,L,t,a.prop,gear=a.state.gear)
            if distance<battle_budget(render_quality.tier).detail*1.5:draw_debris(model,a.state.damage,L,t)
            if distance<350:
                loop mark in a.marks:
                    if not a.state.damage.parts[int(mark.part)].attached:continue
                    # facing() points -Z; the decal's outward face points along its normal.
                    loop frame in hit_mark_frames(mark,a.spec.kind):holes.push(instance(at*frame,rgb(1,1,1)))
                if a.state.engine_damage>0.35:
                    p=aircraft_profile(a.spec.kind)
                    draw(obj_sh,v.oil,obj_params(L,t,at*translation(vec3(p.width*0.6,p.width+0.02,p.engine_z+0.6))))
    loop id in 0..far.len():
        if far[id].len()>0:draw_instanced(obj_inst_sh,v.low[id],far[id],obj_params(L,t))
    loop id in 0..pieces.len():
        if pieces[id].len()>0:draw_instanced(obj_inst_sh,v.low_parts[id],pieces[id],obj_params(L,t))
    if holes.len()>0:draw_instanced(obj_inst_sh,v.hole,holes,obj_params(L,t))
    loop d in b.descents:
        if d.released or length(d.position-cam)>7000:continue
        at=descent_frame(d)
        if d.phase==.canopy:draw(obj_sh,v.chute,obj_params(L,t,at))
        if length(d.position-cam)<450:draw_figure_at(v.pilot,at,0,0,L,t)   # (legs and all, dangling under the canopy)
        else:draw(obj_sh,v.distant_pilot,obj_params(L,t,at))

draw_combat_particles = (v: CombatView,b: Battle):
    if v.trails.ribbons.len()>0:draw_custom(():draw_battle_trails(v.trails),transparent=true)
    draw_curved_particles(v.smoke,false);draw_curved_particles(v.mist,false)
    draw_curved_particles(v.flame,true);draw_curved_particles(v.sparks,true)
    # A held flash on the actual moving muzzle supplements the short event spark.
    muzzle=Particles3D()
    loop a in b.actors:
        if not a.present or a.gun.shots==0 or a.gun.cool<1.0/combat_gun_spec(a).rate-0.065:continue
        mounts=gun_mounts(a.spec.kind,combat_gun_spec(a).mounts)
        at=a.state.position+quat_rotate(a.state.orientation,mounts[(a.gun.shots-1)%mounts.len()])
        distance=f64(length(at-scene_camera()))
        if distance<11000:muzzle.items.push(Particle3D(at,vec3(0,0,0),1,1,f32(max(0.6,min(9.0,distance*0.002))),rgba(1,0.8,0.3,1)))
    draw_curved_particles(muzzle,true)
    g=Guns()
    loop round in b.rounds:g.bullets.push(Bullet(round.position,round.velocity,round.age,round.tracer))
    draw_tracers(g,b.bullet_scale)

# The player's aircraft is drawn separately with its chase-camera bob/plunge transform.
draw_player_hit_marks = (v: CombatView,a: Combatant,at: mat4,L: Light,t: f64,interior:bool = false):
    holes:Instance3D[]
    loop mark in a.marks:
        if a.state.damage.parts[int(mark.part)].attached:
            loop frame in hit_mark_frames(mark,a.spec.kind):
                if interior:draw(obj_sh,v.hole,cockpit_params(L,t,cockpit_relative(at)*frame))
                else:holes.push(instance(at*frame,rgb(1,1,1)))
    if holes.len()>0:draw_instanced(obj_inst_sh,v.hole,holes,obj_params(L,t))
    if a.state.engine_damage>0.35 and a.state.damage.parts[1].attached:
        p=aircraft_profile(a.spec.kind)
        draw(obj_sh,v.oil,obj_params(L,t,at*translation(vec3(p.width*0.6,p.width+0.02,p.engine_z+0.6))))
