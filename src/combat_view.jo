# Presentation consumes combat events. All random particles are cosmetic; Battle never reads them.
use 'combat.jo'
use 'damage.jo'
use 'planes.jo'
use 'objects.jo'
use 'look.jo'
use 'folk.jo'
use 'curved_world.jo'
use 'guns.jo'

struct CombatView:
    smoke: Particles3D = Particles3D(gravity=vec3(0,0.3,0),drag=0.2)
    flame: Particles3D = Particles3D(gravity=vec3(0,0.7,0),drag=0.3)
    sparks: Particles3D = Particles3D(gravity=vec3(0,-8,0),drag=0.6)
    mist: Particles3D = Particles3D(gravity=vec3(0,-3,0),drag=1.2)
    emit_clock = 0.0
    low: Mesh[]
    chute: Mesh
    hole: Mesh
    oil: Mesh
    pilot: Figure

_cv_tri = (vs: mut Vertex3D[], a: vec3,b: vec3,c: vec3,col: vec4):
    n=normalize(cross(b-a,c-a)+vec3(0,0.000001,0))
    loop p in [a,b,c]: vs.push(Vertex3D(p,n,vec2(0,0),col))

_cv_line = (vs: mut Vertex3D[], a: vec3,b: vec3,width: f64,col: vec4):
    side=normalize(cross(b-a,vec3(0,0,1))+vec3(0.0001,0,0))*f32(width)
    _cv_tri(vs,a-side,b-side,b+side,col);_cv_tri(vs,a-side,b+side,a+side,col)
    _cv_tri(vs,b+side,b-side,a-side,col);_cv_tri(vs,a+side,b+side,a-side,col)
    side=normalize(cross(b-a,vec3(1,0,0))+vec3(0,0,0.0001))*f32(width)
    _cv_tri(vs,a-side,b-side,b+side,col);_cv_tri(vs,a-side,b+side,a+side,col)
    _cv_tri(vs,b+side,b-side,a-side,col);_cv_tri(vs,a+side,b+side,a-side,col)

make_combat_view = () -> CombatView:
    v=CombatView()
    loop id in 0..CRAFT_NAMES.len():
        p=aircraft_profile(Craft(id)); vs:Vertex3D[]
        # Silhouette LOD: at most 96 triangles, batched by kind. No gauges, struts or props.
        col=rgb(0.85,0.83,0.72)
        add_box(vs,vec3(0,0,0),vec3(p.width*2,p.width*1.4,p.length),col)
        loop level in 0..p.decks:
            add_box(vs,vec3(0,p.wing_y-f64(level)*1.6,-0.65),vec3(p.span*(if level==0: 1 else: p.lower_span),0.12,p.chord),col)
        add_box(vs,vec3(0,0.3,p.length*0.42),vec3(p.span*0.3,0.1,p.chord*0.6),col)
        add_box(vs,vec3(0,0.8,p.length*0.42),vec3(0.1,1.4,p.chord*0.6),col)
        if not p.boat:
            loop side in [-1.0,1.0]:add_box(vs,vec3(side*p.float_x,p.float_y,0),vec3(0.65,0.5,p.length*0.72),col)
        v.low.push(custom_mesh(vs))
    vs:Vertex3D[]
    loop j in 0..16:
        a=f64(j)*TAU/16.0;b=f64(j+1)*TAU/16.0
        col=if j%4==0:rgb(0.68,0.23,0.16) else:rgb(0.93,0.88,0.7)
        loop ring in 0..4:
            t0=f64(ring)*PI/8.0;t1=f64(ring+1)*PI/8.0
            p=(angle:f64,t:f64)->vec3:vec3(cos(angle)*sin(t)*3.6,5.0+cos(t)*2.1,sin(angle)*sin(t)*3.6)
            _cv_tri(vs,p(a,t0),p(b,t1),p(b,t0),col)
            _cv_tri(vs,p(a,t0),p(a,t1),p(b,t1),col)
            # The canopy has an underside too; its open edge reads from below.
            _cv_tri(vs,p(b,t0),p(b,t1),p(a,t0),col*0.8)
            _cv_tri(vs,p(b,t1),p(a,t1),p(a,t0),col*0.8)
        _cv_line(vs,vec3(cos(a)*3.6,5,sin(a)*3.6),vec3(cos(a)*0.25,1.4,sin(a)*0.25),0.025,rgb(0.62,0.56,0.43))
    v.chute=custom_mesh(vs)
    vs=[]
    loop j in 0..8:
        a=TAU*f64(j)/8.0;b=TAU*f64(j+1)/8.0
        _cv_tri(vs,vec3(0,0,0),vec3(cos(a)*0.065,sin(a)*0.065,0),vec3(cos(b)*0.065,sin(b)*0.065,0),rgb(0.07,0.06,0.05))
    v.hole=custom_mesh(vs)
    vs=[]
    _cv_tri(vs,vec3(-0.12,0,0),vec3(0.12,0,0),vec3(0.035,0,2.4),rgb(0.12,0.10,0.07))
    v.oil=custom_mesh(vs)
    v.pilot=build_figure(.pilot,93)
    v

combat_effect_events = (v: mut CombatView, events: CombatEvent[]):
    loop event in events:
        p=event.position
        match event.kind:
            .shot:
                if v.flame.items.len()<500: emit(v.flame,p,2,4,rgba(1,0.75,0.25,1),0.05,0.4,0.5,event.direction)
            .hit, .separated:
                if v.sparks.items.len()<1000:
                    emit(v.sparks,p,6,13,rgba(1,0.7,0.25,1),0.25,0.13)
                    emit(v.sparks,p,5,9,rgba(0.55,0.35,0.16,1),1.2,0.2)
            .splash:
                if v.mist.items.len()<1200: emit(v.mist,p,int(10+event.strength*70),8+event.strength*10,rgba(0.88,0.96,1,0.9),1.6,0.5+event.strength,0.65,vec3(0,1,0))
            _:pass

update_combat_view = (v: mut CombatView, b: Battle, wind: vec3, dt: f64, observer: vec3):
    v.emit_clock+=dt
    if v.emit_clock>=0.04:
        v.emit_clock=v.emit_clock%0.04
        loop a in b.actors:
            if not a.present or a.status==.escaped or a.wreck_age>90 or a.state.on_water:continue
            strength=max(a.state.damage.smoke,a.fire)
            if strength<0.01:continue
            d=length(a.state.position-observer)
            if d>7000 or (d>2500 and b.tick%4!=0):continue
            p=aircraft_profile(a.spec.kind)
            at=a.state.position+quat_rotate(a.state.orientation,vec3(0,p.engine_y,p.engine_z))
            if v.smoke.items.len()<2200:
                first=v.smoke.items.len()
                emit(v.smoke,at,1,1.3,rgba(0.13,0.12,0.105,f32(0.35+0.5*strength)),5.0+strength*3.0,2.0+strength*4.0)
                loop i in first..v.smoke.items.len():
                    v.smoke.items[i].vel+=wind*0.75
                    v.smoke.items[i].size=f32((2.0+strength*4.0)*(0.85+random()*0.15))
            if a.fire>0 and v.flame.items.len()<500:
                emit(v.flame,at,2,3.0,rgba(1,0.34,0.035,0.9),0.35,1.2+a.fire*1.5,0.7,normalize(-a.state.velocity+vec3(0,5,0)))
    v.smoke.update(dt);v.flame.update(dt);v.sparks.update(dt);v.mist.update(dt)

# Inside draw_custom. Detailed damaged craft nearby; one instanced silhouette batch per kind far.
draw_combat_aircraft = (v: CombatView,b: Battle,models: CraftModel[],L: Light,t:f64,skip: int = -1):
    cam=scene_camera()
    far:Instance3D[][]=[loop id in 0..CRAFT_NAMES.len(): []]
    holes:Instance3D[]
    loop a in b.actors:
        if not a.present or a.craft==skip or a.status==.escaped or a.wreck_age>90:continue
        if a.external and not a.human and a.last_attacker<0:continue
        distance=length(a.state.position-cam)
        if distance>10000:continue
        at=translation(a.state.position)*quat_to_mat4(a.state.orientation)
        if a.status==.wreck:
            at=translation(a.state.position+vec3(0,-max(0.0,a.wreck_age-60.0)*0.08,0))*quat_to_mat4(a.state.orientation)
        if distance>1100 and a.status==.flying and a.state.hull_damage<0.2:
            far[int(a.spec.kind)].push(instance(at,if a.side==0:rgb(0.85,0.94,1) else:rgb(0.9,0.4,0.28)))
        else:
            model=models[if a.model>=0 and a.model<models.len():a.model else:default_craft_model(a.spec.kind)]
            draw_craft_parts(model,a.state.damage,at,L,t,a.prop,gear=a.state.gear)
            draw_debris(model,a.state.damage,L,t)
            if distance<350:
                loop mark in a.marks:
                    if not a.state.damage.parts[int(mark.part)].attached:continue
                    # facing() points -Z; the decal's outward face points along its normal.
                    holes.push(instance(at*translation(mark.local+mark.normal*0.035)*facing(-mark.normal),rgb(1,1,1)))
                if a.state.engine_damage>0.35:
                    p=aircraft_profile(a.spec.kind)
                    draw(obj_sh,v.oil,obj_params(L,t,at*translation(vec3(p.width*0.6,p.width+0.02,p.engine_z+0.6))))
    loop id in 0..far.len():
        if far[id].len()>0:draw_instanced(obj_inst_sh,v.low[id],far[id],obj_params(L,t))
    if holes.len()>0:draw_instanced(obj_inst_sh,v.hole,holes,obj_params(L,t))
    loop d in b.descents:
        if d.released or length(d.position-cam)>7000:continue
        at=translation(d.position)*rotation_y(d.yaw)
        if d.phase==.canopy:draw(obj_sh,v.chute,obj_params(L,t,at))
        draw_figure_at(v.pilot,at,0,0,L,t,seated=d.phase==.canopy or d.phase==.falling)

draw_combat_particles = (v: CombatView,b: Battle):
    draw_curved_particles(v.smoke,false);draw_curved_particles(v.mist,false)
    draw_curved_particles(v.flame,true);draw_curved_particles(v.sparks,true)
    g=Guns()
    loop round in b.rounds:g.bullets.push(Bullet(round.position,round.velocity,round.age,round.tracer))
    draw_tracers(g,b.bullet_scale)

# The player's aircraft is drawn separately with its chase-camera bob/plunge transform.
draw_player_hit_marks = (v: CombatView,a: Combatant,at: mat4,L: Light,t: f64):
    holes:Instance3D[]
    loop mark in a.marks:
        if a.state.damage.parts[int(mark.part)].attached:
            holes.push(instance(at*translation(mark.local+mark.normal*0.035)*facing(-mark.normal),rgb(1,1,1)))
    if holes.len()>0:draw_instanced(obj_inst_sh,v.hole,holes,obj_params(L,t))
    if a.state.engine_damage>0.35 and a.state.damage.parts[1].attached:
        p=aircraft_profile(a.spec.kind)
        draw(obj_sh,v.oil,obj_params(L,t,at*translation(vec3(p.width*0.6,p.width+0.02,p.engine_z+0.6))))
