# The sounds' synthesis draws from a generator of its own: each sound seeds it as it used to seed
# the global one (audio_seed(n) where it called seed_random(n)), so the samples are the same, and
# building the sounds, at the start or behind the title, takes nothing from the global random()
# that the rest of the game draws from. (The same draws as random(), random(lo, hi), random_int.)
_audio_rng = rng(0)

audio_seed = (seed: int):
    global _audio_rng
    _audio_rng = rng(seed)

audio_random = () -> f64:
    global _audio_rng
    next_float(_audio_rng)

# (always draws, as random(lo, hi) does, so a sequence keeps its place with equal bounds)
audio_random = (lo: f64, hi: f64) -> f64:
    if hi < lo: panic("audio_random: hi must be at least lo")
    draw = audio_random()
    if hi == lo: return lo
    lo + (hi - lo) * draw

audio_random_int = (lo: int, hi: int) -> int:
    global _audio_rng
    next_int(_audio_rng, lo, hi)

# Sloppy's tone() (lib/game/audio.jo), the same samples for a given draw sequence, its noise drawn
# from this generator after audio_seed(seed) rather than from the global random(): a click's noise
# no longer depends on what the start drew before it
audio_tone = (seed: int, freq: f64, seconds: f64, wave: Wave = .sine, volume: f64 = 0.5, attack: f64 = 0.005, release: f64 = 0.1, slide: f64 = 1.0, vibrato: f64 = 0.0) -> Sound:
    audio_seed(seed)
    n = int(seconds * f64(MIX_RATE))
    s = Sound(fill(f32(0), n * 2))
    phase = 0.0
    att = min(attack, seconds * 0.5)
    rel = min(release, seconds * 0.5)
    held = 0.0
    step = -1
    loop i in [0..n):
        t = f64(i) / f64(MIX_RATE)
        u = f64(i) / f64(max(n, 1))
        f = freq * pow(slide, u) * (1.0 + vibrato * sin(t * 30.0))
        phase += f / f64(MIX_RATE)
        env = 1.0
        if t < att: env = t / att
        rem = seconds - t
        if rem < rel: env = env * max(rem / rel, 0.0)
        v = 0.0
        if wave == .noise:
            k = int(phase * 16.0)
            if k != step:
                held = audio_random(-1.0, 1.0)
                step = k
            v = held
        else: v = __osc(wave, phase)
        x = f32(v * env * volume)
        s.samples[i * 2] = x
        s.samples[i * 2 + 1] = x
    s
