# The chart: a sea chart of the archipelago in the style of an old pilot's map, painted once from
# the world's heights (watercolor sea with depth bands, ochre and green land with hill shading,
# a coastline in ink), with the settlements named and the player marked on it.

use 'world.jo'
use 'objects.jo'

const CHART_PX = 640
const CHART_EXTENT = 17000.0        # meters across the chart

struct Chart:
    tex: Texture

build_chart = () -> Chart:
    n = CHART_PX
    rows = parallel_map([0..n), (j: int) -> f64[]:
        z = (f64(j) + 0.5) / f64(n) * CHART_EXTENT - CHART_EXTENT * 0.5
        [loop i in 0..n: height((f64(i) + 0.5) / f64(n) * CHART_EXTENT - CHART_EXTENT * 0.5, z)]
    )
    img = image(n, n)
    paper = vec3(0.93, 0.88, 0.76)
    loop j in 0..n:
        loop i in 0..n:
            h = rows[j][i]
            hx = rows[j][min(i + 1, n - 1)] - rows[j][max(i - 1, 0)]
            hz = rows[min(j + 1, n - 1)][i] - rows[max(j - 1, 0)][i]
            grain = f32(noise(f64(i) * 0.9, f64(j) * 0.9) * 0.06 + noise(f64(i) * 0.08, f64(j) * 0.08) * 0.08)
            c = paper
            if h <= 0.0:
                # watercolor sea: paler near the coast, bands of depth
                d = clamp(-h / 60.0, 0.0, 1.0)
                band = f32(floor(d * 4.0) / 4.0)
                c = mix(vec3(0.72, 0.86, 0.86), vec3(0.42, 0.62, 0.75), band)
                c = mix(c, paper, 0.25)
            else:
                # land: ochre low ground, green above, shaded from the north-west
                g = f32(clamp(h / 220.0, 0.0, 1.0))
                c = mix(vec3(0.86, 0.76, 0.55), vec3(0.55, 0.62, 0.4), g)
                shade = f32(clamp((hx + hz) * 0.02, -0.25, 0.25))
                c = c * (1.0 - shade)
                # contour lines every 50 m
                if floor(h / 50.0) != floor((h + abs(hx) * 0.5 + abs(hz) * 0.5) / 50.0): c = c * 0.82
            # the coastline in ink
            hn = [rows[j][min(i + 1, n - 1)], rows[min(j + 1, n - 1)][i], rows[j][max(i - 1, 0)], rows[max(j - 1, 0)][i]]
            coast = false
            loop q in hn:
                if (q > 0.0) != (h > 0.0): coast = true
            if coast: c = vec3(0.25, 0.2, 0.16)
            c = c * (1.0 - grain)
            img.set(i, j, vec4(c.x, c.y, c.z, 1))
    Chart(texture(img, true))

# where a world point is on the chart drawn in rect r
chart_point = (r: Rect, x: f64, z: f64) -> vec2:
    vec2(f32(r.x + (x / CHART_EXTENT + 0.5) * r.w), f32(r.y + (z / CHART_EXTENT + 0.5) * r.h))

draw_chart = (ch: Chart, towns: Town[], player: vec3, heading: f64, hour: f64):
    sw = screen_width()
    sh = screen_height()
    size = min(sw, sh) - 80.0
    r = Rect((sw - size) * 0.5, (sh - size) * 0.5, size, size)
    rect(0, 0, sw, sh, rgba(0.05, 0.07, 0.1, 0.55))
    rect_rounded(r.x - 14, r.y - 14, r.w + 28, r.h + 28, 6, rgb(0.42, 0.3, 0.2))
    sprite(ch.tex, vec2(f32(r.x), f32(r.y)), vec2(f32(r.w), f32(r.h)))
    ink = rgba(0.22, 0.17, 0.13, 0.95)
    # a compass rose
    cr = vec2(f32(r.x + r.w - 70), f32(r.y + 70))
    ring(cr, 34, 1.5, ink)
    triangle(cr + vec2(0, -46), cr + vec2(-7, 0), cr + vec2(7, 0), ink)
    triangle(cr + vec2(0, 46), cr + vec2(-7, 0), cr + vec2(7, 0), rgba(0.22, 0.17, 0.13, 0.4))
    text_centered("N", cr + vec2(0, -58), 16, ink)
    text_centered("THE KALAMOS ARCHIPELAGO", vec2(f32(r.x + r.w * 0.5), f32(r.y + 26)), 22, ink)
    loop tw in towns:
        p = chart_point(r, f64(tw.center.x), f64(tw.center.z))
        circle(p, 4, ink)
        text(tw.name, p + vec2(7, -9), 15, ink)
    # the player: an arrow along the heading
    pp = chart_point(r, f64(player.x), f64(player.z))
    fwd = vec2(f32(sin(heading)), f32(-cos(heading)))
    side = vec2(-fwd.y, fwd.x)
    triangle(pp + fwd * 11.0, pp - fwd * 7.0 + side * 6.0, pp - fwd * 7.0 - side * 6.0, rgb(0.8, 0.16, 0.12))
    text("{int(hour):02}:{int((hour - floor(hour)) * 60.0):02}", vec2(f32(r.x + 14), f32(r.y + r.h - 30)), 18, ink)
