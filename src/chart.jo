use 'world_point.jo'
use 'touch.jo'
# The chart: a sea chart of the archipelago in the style of an old pilot's map, painted once from
# the world's heights (watercolor sea with depth bands, ochre and green land with hill shading,
# a coastline in ink), with the settlements named and the player marked on it.

use 'world.jo'
use 'geography.jo'
use 'objects.jo'
use 'settlements.jo'
use 'vessel_types.jo'

const CHART_PX = 640
const CHART_EXTENT = 22000.0        # meters across the chart

struct Chart:
    tex: Texture
    world_tex: Texture

# One paper map the player owns, as the chart lays it down: its sheet covers this much ground.
struct ChartSheet:
    copy: int
    edition: str
    title: str
    west: f64
    north: f64
    east: f64
    south: f64

# What the chart shows: none, every sheet (the pause menu's place-picking); otherwise only the
# ground the owned sheets cover. chart_focus: the copy centred on (-1: all of them together).
chart_sheets: ChartSheet[]? = none
chart_focus = -1
sheet_textures: {str: Texture}
const SHEET_PX = 384
const CHART_LIST_W = 250.0
const SHEET_DETAIL = 30000.0        # sheets narrower than this get their own finer painting

build_chart_texture = (extent: f64, depth: f64, cx: f64 = 0.0, cz: f64 = 0.0, n: int = CHART_PX) -> Texture:
    rows = parallel_map([0..n), (j: int) -> f64[]:
        z = cz + (f64(j) + 0.5) / f64(n) * depth - depth * 0.5
        row: f64[]
        loop i in 0..n:
            x = cx+(f64(i)+0.5)/f64(n)*extent-extent*0.5
            # Whole-world pixels span ~780 m; don't calculate metre-scale erosion.
            row.push(if extent > CHART_EXTENT and (abs(x) >= LEGACY_RESERVE or abs(z) >= LEGACY_RESERVE): new_land_base(x,z).0 else: height(x,z))
        row
    )
    img = image(n, n)
    paper = vec3(0.93, 0.88, 0.76)
    loop j in 0..n:
        loop i in 0..n:
            h = rows[j][i]
            hx = rows[j][min(i + 1, n - 1)] - rows[j][max(i - 1, 0)]
            hz = rows[min(j + 1, n - 1)][i] - rows[max(j - 1, 0)][i]
            grain = f32(noise(f64(i) * 0.9, f64(j) * 0.9) * 0.06 + noise(f64(i) * 0.08, f64(j) * 0.08) * 0.08)
            c = paper
            if h <= 0.0:
                # watercolor sea: paler near the coast, bands of depth
                d = clamp(-h / 60.0, 0.0, 1.0)
                band = f32(floor(d * 4.0) / 4.0)
                c = mix(vec3(0.72, 0.86, 0.86), vec3(0.42, 0.62, 0.75), band)
                c = mix(c, paper, 0.25)
            else:
                # land: ochre low ground, green above, shaded from the north-west
                g = f32(clamp(h / 220.0, 0.0, 1.0))
                c = mix(vec3(0.86, 0.76, 0.55), vec3(0.55, 0.62, 0.4), g)
                shade = f32(clamp((hx + hz) * 0.02, -0.25, 0.25))
                c = c * (1.0 - shade)
                # contour lines every 50 m
                if floor(h / 50.0) != floor((h + abs(hx) * 0.5 + abs(hz) * 0.5) / 50.0): c = c * 0.82
            # the coastline in ink
            hn = [rows[j][min(i + 1, n - 1)], rows[min(j + 1, n - 1)][i], rows[j][max(i - 1, 0)], rows[max(j - 1, 0)][i]]
            coast = false
            loop q in hn:
                if (q > 0.0) != (h > 0.0): coast = true
            if coast: c = vec3(0.25, 0.2, 0.16)
            c = c * (1.0 - grain)
            img.set(i, j, vec4(c.x, c.y, c.z, 1))
    texture(img, true)

chart_local = false
chart_extent = () -> f64: if geography_enabled and not chart_local: WORLD_WIDTH else: CHART_EXTENT
chart_depth = () -> f64: if geography_enabled and not chart_local: WORLD_DEPTH else: CHART_EXTENT

build_chart = () -> Chart:
    local = build_chart_texture(CHART_EXTENT,CHART_EXTENT)
    Chart(local,if geography_enabled: build_chart_texture(WORLD_WIDTH,WORLD_DEPTH) else: local)

# the ground the chart spans: its middle and its width and depth, in metres
struct ChartView:
    cx: f64
    cz: f64
    w: f64
    d: f64

chart_view = () -> ChartView:
    if let sheets = chart_sheets:
        west = 1.0e9; east = -1.0e9; north = 1.0e9; south = -1.0e9
        loop round in 0..2:
            loop s in sheets:
                if round == 0 and s.copy != chart_focus: continue
                west = min(west,s.west); east = max(east,s.east); north = min(north,s.north); south = max(south,s.south)
            if east > west: break
        if east > west:
            # (a margin of blank paper round the sheets; no wider than the whole world)
            w = min(max((east-west)*1.12,1500.0),chart_extent()*1.12); d = min(max((south-north)*1.12,1500.0),chart_depth()*1.12)
            return ChartView((west+east)*0.5,(north+south)*0.5,w,d)
    ChartView(0.0,0.0,chart_extent(),chart_depth())

# where a world point is on the chart drawn in rect r
chart_point = (r: Rect, x: f64, z: f64) -> vec2:
    v = chart_view()
    vec2(f32(r.x + ((x-v.cx) / v.w + 0.5) * r.w), f32(r.y + ((z-v.cz) / v.d + 0.5) * r.h))

# where the chart lies on the screen
chart_rect = () -> Rect:
    v = chart_view()
    sw=screen_width();sh=screen_height()
    # (room at the left for the list of maps, on a screen wide enough to spare it)
    side = if chart_sheets != none and sw >= 900.0: CHART_LIST_W + 28.0 else: 0.0
    size = min(sw - side, sh) - 80.0
    w = min(sw-side-80.0,size*v.w/v.d)
    h = w*v.d/v.w
    # (a tall narrow screen, a phone held upright: the list goes under the chart instead, so the
    # chart rides high, under the touch pad's top buttons)
    if _chart_list_under(w, h): return Rect(side+(sw-side-w)*0.5,max(60.0,pad_top_clear(f64(sw)*0.5-w*0.5-14.0,f64(sw)*0.5+w*0.5+14.0)+20.0),w,h)
    Rect(side+(sw-side-w)*0.5,(sh-h)*0.5,w,h)

# whether the list of maps goes under the chart, a chart w x h being drawn (on a screen too narrow
# for it beside the chart, with room for a dozen rows under it)
_chart_list_under = (w: f64, h: f64) -> bool:
    chart_sheets != none and f64(screen_width()) < 900.0 and f64(screen_height()) - h - 260.0 > 12.0 * 32.0

# the place (x, z) under a point on the chart (none: off it)
chart_place = (p: vec2) -> vec2?:
    r = chart_rect(); v = chart_view()
    u = (f64(p.x) - r.x) / r.w
    w = (f64(p.y) - r.y) / r.h
    if u < 0.0 or u > 1.0 or w < 0.0 or w > 1.0: return none
    vec2(f32(v.cx + (u - 0.5) * v.w), f32(v.cz + (w - 0.5) * v.d))

# is (x, z) on one of the sheets laid down (everything is, with no sheets given)
charted = (x: f64, z: f64) -> bool:
    if let sheets = chart_sheets:
        loop s in sheets:
            if x >= s.west and x <= s.east and z >= s.north and z <= s.south: return true
        return false
    true

# a small sheet is painted once, finer than the whole chart, when it is first laid down
sheet_texture = (s: ChartSheet) -> Texture?:
    if s.east-s.west > SHEET_DETAIL or s.south-s.north > SHEET_DETAIL: return none
    if not (s.edition in sheet_textures):
        sheet_textures[s.edition] = build_chart_texture(s.east-s.west,s.south-s.north,(s.west+s.east)*0.5,(s.north+s.south)*0.5,SHEET_PX)
    sheet_textures[s.edition]

# the screen rectangle of ground [west, east] x [north, south] on the chart in r
_ground_rect = (r: Rect, west: f64, north: f64, east: f64, south: f64) -> Rect:
    a = chart_point(r,west,north); b = chart_point(r,east,south)
    Rect(f64(a.x),f64(a.y),f64(b.x-a.x),f64(b.y-a.y))

_overlap = (a: Rect, b: Rect) -> Rect:
    x0 = max(a.x,b.x); y0 = max(a.y,b.y); x1 = min(a.x+a.w,b.x+b.w); y1 = min(a.y+a.h,b.y+b.h)
    Rect(x0,y0,max(0.0,x1-x0),max(0.0,y1-y0))

# the owned sheets, laid on blank paper: the larger underneath, each with its paper edge
_draw_sheets = (ch: Chart, r: Rect, sheets: ChartSheet[]):
    paper = rgb(0.9, 0.86, 0.75)
    rect(r.x, r.y, r.w, r.h, paper)
    # (the blank paper's own faint grain, so it reads as paper rather than as a hole)
    loop k in 0..9:
        y = r.y + r.h*(f64(k)+0.5)/9.0
        line(vec2(f32(r.x+8.0),f32(y)),vec2(f32(r.x+r.w-8.0),f32(y)),0.6,rgba(0.55,0.45,0.32,0.06))
    order = sheets
    # (the larger underneath; the one centred on, on top of them all)
    order.sort((s: ChartSheet): (if s.copy == chart_focus: 1 else: 0, -(s.east-s.west)*(s.south-s.north)))
    world = _ground_rect(r,-chart_extent()*0.5,-chart_depth()*0.5,chart_extent()*0.5,chart_depth()*0.5)
    local = _ground_rect(r,-CHART_EXTENT*0.5,-CHART_EXTENT*0.5,CHART_EXTENT*0.5,CHART_EXTENT*0.5)
    loop s in order:
        sr = _ground_rect(r,s.west,s.north,s.east,s.south)
        shown = _overlap(sr,r)
        if shown.w < 1.0 or shown.h < 1.0: continue
        rect(shown.x+2.0,shown.y+3.0,shown.w,shown.h,rgba(0.3,0.22,0.14,0.18))
        clip(shown)
        if let tex = sheet_texture(s): sprite(tex,vec2(f32(sr.x),f32(sr.y)),vec2(f32(sr.w),f32(sr.h)))
        else if geography_enabled and (s.west < -CHART_EXTENT*0.5 or s.east > CHART_EXTENT*0.5 or s.north < -CHART_EXTENT*0.5 or s.south > CHART_EXTENT*0.5): sprite(ch.world_tex,vec2(f32(world.x),f32(world.y)),vec2(f32(world.w),f32(world.h)))
        else: sprite(ch.tex,vec2(f32(local.x),f32(local.y)),vec2(f32(local.w),f32(local.h)))
        no_clip()
        edge = rgba(0.36,0.27,0.18,0.45)
        a = vec2(f32(shown.x),f32(shown.y)); b = vec2(f32(shown.x+shown.w),f32(shown.y+shown.h))
        line(a,vec2(b.x,a.y),1.0,edge); line(vec2(b.x,a.y),b,1.0,edge); line(b,vec2(a.x,b.y),1.0,edge); line(vec2(a.x,b.y),a,1.0,edge)

# the sheets one owns, as a list beside the chart: the one clicked is centred on, "All sheets"
# lays them all out together. Returns the copy picked (-1: all), or -2 when nothing was picked.
chart_sheet_list = (sheets: ChartSheet[], text_size: f64 = 15.0) -> int:
    global hud_style
    r = chart_rect()
    lw = CHART_LIST_W; row = 28.0; gap = 4.0
    x = r.x - 14.0 - lw - 14.0
    if x < 12.0: x = r.x + 10.0
    h = 40.0 + f64(sheets.len()+1)*(row+gap) + 6.0
    y = max(12.0, r.y - 14.0)
    # (under the chart, as wide as its frame, and clear of the prompt cards along the bottom)
    bottom = 12.0
    if _chart_list_under(r.w, r.h):
        x = r.x - 14.0; lw = r.w + 28.0; y = r.y + r.h + 28.0; bottom = 120.0
    saved = hud_style
    hud_style.text_size = text_size
    hud_style.panel = rgba(0.06, 0.08, 0.12, 0.82)
    hud_style.button = rgba(0.14, 0.17, 0.22, 1)
    hud_style.hover = rgba(0.22, 0.27, 0.34, 1)
    h = min(h, f64(screen_height()) - y - bottom)
    hud_panel(Rect(x, y, lw, h))
    text("Maps", vec2(f32(x + 12.0), f32(y + 10.0)), 17, rgba(1, 0.97, 0.9, 0.9))
    picked = -2
    box = Rect(x, y + 36.0, lw, h - 40.0)
    off = hud_scroll(box, f64(sheets.len()+1)*(row+gap), "chart-maps")
    clip(box)
    yy = box.y + 2.0 - off
    if hud_button(Rect(x+8.0,yy,lw-16.0,row),"All sheets",selected=chart_focus < 0,align=.left): picked = -1
    yy += row + gap
    loop s in sheets:
        if hud_button(Rect(x+8.0,yy,lw-16.0,row),s.title,selected=chart_focus == s.copy,align=.left): picked = s.copy
        yy += row + gap
    no_clip()
    hud_style = saved
    picked

draw_chart = (ch: Chart, towns: Town[], player: vec3, heading: f64, hour: f64, others: vec4[] = [], ships: Vessel[] = [], lanes: SeaLane[] = [],player_point:WorldPoint?=none,other_points:WorldPoint[]=[]):
    r = chart_rect()
    rect_rounded(r.x - 14, r.y - 14, r.w + 28, r.h + 28, 6, rgb(0.42, 0.3, 0.2))
    if let sheets = chart_sheets: _draw_sheets(ch,r,sheets)
    else: sprite(if chart_local or not geography_enabled: ch.tex else: ch.world_tex, vec2(f32(r.x), f32(r.y)), vec2(f32(r.w), f32(r.h)))
    ink = rgba(0.22, 0.17, 0.13, 0.95)
    # a compass rose
    cr = vec2(f32(r.x + r.w - 70), f32(r.y + 70))
    ring(cr, 34, 1.5, ink)
    triangle(cr + vec2(0, -46), cr + vec2(-7, 0), cr + vec2(7, 0), ink)
    triangle(cr + vec2(0, 46), cr + vec2(-7, 0), cr + vec2(7, 0), rgba(0.22, 0.17, 0.13, 0.4))
    text_centered("N", cr + vec2(0, -58), 16, ink)
    heading_text = if chart_local or not geography_enabled: "THE KALAMOS ARCHIPELAGO" else: "THE AEGEAN"
    if let sheets = chart_sheets:
        loop s in sheets:
            if s.copy == chart_focus or sheets.len() == 1: heading_text = s.title
    text_centered(heading_text, vec2(f32(r.x + r.w * 0.5), f32(r.y + 26)), if heading_text.len() > 34: 18 else: 22, ink)
    if geography_enabled and chart_sheets == none:
        text("Tab: " + (if chart_local: "whole world" else: "local archipelago"),vec2(f32(r.x+14),f32(r.y+r.h-52)),15,ink)
    whole = geography_enabled and (not chart_local or chart_sheets != none)
    clip(r)
    if whole:
        prepare_settlement_roads(player.xz,true)
        loop road in settlement_roads:
            loop k in 0..road.points.len()-1:
                a = road.points[k]; b = road.points[k+1]
                if not charted(f64(a.x),f64(a.z)) or not charted(f64(b.x),f64(b.z)): continue
                line(chart_point(r,f64(a.x),f64(a.z)),chart_point(r,f64(b.x),f64(b.z)),0.7,rgba(0.36,0.27,0.19,0.3))
        labels: vec4[]
        # Capitals first; smaller names yield when their labels would overlap.
        loop tier in 0..3:
            loop s in world_settlements:
                st = if s.kind == .capital: 0 else: (if s.size >= 100: 1 else: 2)
                if st != tier or not charted(f64(s.center.x),f64(s.center.z)): continue
                p = chart_point(r,f64(s.center.x),f64(s.center.z))
                circle(p,if tier == 0: 3.5 else: (if tier == 1: 2.0 else: 0.8),ink)
                if tier == 2 and s.legacy < 0: continue
                font = if tier == 0: 15.0 else: 11.0
                width = f64(s.name.len())*font*0.66
                label = vec2(f32(clamp(f64(p.x)+5.0,r.x+6.0,r.x+r.w-width-6.0)),f32(clamp(f64(p.y)-9.0,r.y+42.0,r.y+r.h-font-8.0)))
                blocked = label.x > f32(r.x+r.w-115.0) and label.y < f32(r.y+120.0)
                loop q in labels:
                    if label.x < q.x+q.z+4.0 and label.x+f32(width)+4.0 > q.x and label.y < q.y+q.w+4.0 and label.y+f32(font)+4.0 > q.y: blocked = true
                if blocked: continue
                labels.push(vec4(label.x,label.y,f32(width),f32(font)))
                text(s.name,label,font,ink)
    loop tw in towns:
        if whole or not charted(f64(tw.center.x),f64(tw.center.z)): continue
        p = chart_point(r, f64(tw.center.x), f64(tw.center.z))
        circle(p, 4, ink)
        text(tw.name, p + vec2(7, -9), 15, ink)
    # Registered major sea lanes only; no navigation work or new ships on opening.
    loop lane in lanes:
        if lane.status != .ready or lane.distance < 10000: continue
        loop k in 0..lane.points.len()-1:
            a = lane.points[k]; b = lane.points[k+1]
            if not charted(a.x,a.y) or not charted(b.x,b.y): continue
            line(chart_point(r,a.x,a.y),chart_point(r,b.x,b.y),0.65,rgba(0.18,0.36,0.45,0.32))
    loop ship in ships:
        if ship.status == .sunk or length(ship.position-player) > 20000: continue
        point=vessel_point(ship)
        at = chart_point(r,point.x,point.z)
        if at.x < r.x or at.x > r.x+r.w or at.y < r.y or at.y > r.y+r.h or not charted(point.x,point.z): continue
        forward = vec2(f32(sin(ship.yaw)),f32(cos(ship.yaw)))
        side = vec2(-forward.y,forward.x)
        triangle(at+forward*4.0,at-forward*3.0+side*2.0,at-forward*3.0-side*2.0,rgb(0.12,0.29,0.37))
    # other aircraft aloft: small grey arrows (x, z, heading)
    loop i in 0..others.len():
        o=others[i];point=if i<other_points.len():other_points[i] else:WorldPoint(o.x,o.y,o.z)
        op = chart_point(r,point.x,point.z)
        if abs(f64(o.x)) > chart_extent()*0.5 or abs(f64(o.z)) > chart_depth()*0.5 or not charted(point.x,point.z): continue
        of = vec2(f32(sin(f64(o.w))), f32(-cos(f64(o.w))))
        os = vec2(-of.y, of.x)
        triangle(op + of * 7.0, op - of * 5.0 + os * 4.0, op - of * 5.0 - os * 4.0, rgba(0.25, 0.22, 0.2, 0.75))
    no_clip()
    # where one is (which way one faces is the compass's to tell)
    point=player_point ?? world_point(player)
    pp = chart_point(r,point.x,point.z)
    if abs(f64(player.x)) < chart_extent()*0.5 and abs(f64(player.z)) < chart_depth()*0.5:
        ring(pp, 6, 2, rgb(0.8, 0.16, 0.12))
        circle(pp, 2, rgb(0.8, 0.16, 0.12))
    text("{int(hour):02}:{int((hour - floor(hour)) * 60.0):02}", vec2(f32(r.x + 14), f32(r.y + r.h - 30)), 18, ink)
