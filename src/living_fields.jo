# Household choices over finite owned fields. Seed is an owned FarStock until sowing;
# a growing crop is potential, never loadable grain. Only paid mature harvest creates goods.
use 'phoenix.jo'
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_stock.jo'
use 'living_far_orders.jo'
use 'living_far_recipes.jo'
use 'living_crop_calendar.jo'
use 'living_money.jo'
use 'living_far_news.jo'
use 'living_place_context.jo'
use 'living_work.jo'
use 'living_work_types.jo'
use 'living_guard.jo'
use 'living_field_land.jo'
use 'living_transaction.jo'

field_population = (d: FarDistrict) -> int:
    result=0
    loop c in 0..3: result+=d.workers[c]+d.dependents[c]
    result

field_seed_milli = (area_ares: int) -> int: area_ares*CROP_SEED_PER_ARE
field_household_target_ares = (d: FarDistrict) -> int:
    # A household wants an annual staple ration, not unlimited cash-crop acreage.
    max(1,(field_population(d)*FAR_STAPLE_DAILY*CROP_YEAR_DAYS+CROP_YIELD_PER_ARE-1)/CROP_YIELD_PER_ARE)

field_has_sown = (crop: FarCrop) -> bool: crop.stage!=.sowing
field_care_yield = (crop: FarCrop) -> int:
    required=crop_required_work(crop.area_ares,CROP_TEND_HOURS_PER_HA)
    crop.area_ares*CROP_YIELD_PER_ARE*(500+500*min(required,crop.tending_work)/required)/1000

field_reason = (w: mut World,place: int,text: str):
    if w.far.districts[place].field_reason==text: return
    old=w.far.districts[place].field_reason_day
    w.far.districts[place].field_reason=text
    w.far.districts[place].field_reason_minute=w.minute
    if old!=day_index(w.minute):
        w.far.districts[place].field_reason_day=day_index(w.minute)
        far_local_news(w,place,"household_fields",text)

begin_household_sowing = (w: mut World,place: int,index: int,area_ares: int) -> bool:
    d=w.far.districts[place]; day=day_index(w.minute)
    if not crop_sowing_season(day) or index<0 or index>=d.fields.len() or area_ares<=0: return false
    field=d.fields[index]
    if field.crop!=none or area_ares>field.land.area_ares: return false
    seed=field_seed_milli(area_ares)
    # The family cannot eat planted seed. Keep its next two days' meals intact.
    pantry=field_population(d)*FAR_STAPLE_DAILY*2
    if far_market_qty(w,place,3)<pantry+seed or w.accounts[d.market_account].cents<100: return false
    batch=far_take_market(w,place,3,seed); roots=batch.roots.keys(); roots.sort()
    why="The households at {life_place_name(w,place)} asked their counter to sow {f64(area_ares)/100.0:.2} hectares of registered field {field.land.id}: their grain reserve does not cover the coming growing season. The counter assigned its actual {f64(seed)/1000.0:.2} packages of seed and agreed ¤1 a day for each local field hand, taking those hands away from {w.goods[d.output].key} work. No harvest is due before {crop_date(crop_ready_day(day,field.land.id))}."
    p=WorkProvenance(cause=why,requester_account=d.household_account,supplier_account=d.market_account,request_place=place,requested_minute=w.minute,heard_minute=w.minute,agreed_minute=w.minute,freight_payer=d.market_account,deadline=(crop_ready_day(day,field.land.id)+31)*1440,supply_roots=roots,supply=work_supply(w,roots),negotiated=true,need_places=[place],need_since=w.minute)
    w.far.districts[place].fields[index].crop=FarCrop(area_ares,batch,roots,seed,0,agreement=p,seed_source=place)
    field_reason(w,place,why)
    true

field_pay_work = (w: mut World,place: int,index: int,wanted: int) -> int:
    if wanted<=0: return 0
    d=w.far.districts[place]; crop=d.fields[index].crop ?? return 0
    cash=w.accounts[d.market_account].cents
    #100cents per averaged worker-day. Fractions stay with this actual crop.
    workers=min(wanted,max(0,((cash+1)*24-1-crop.wage_remainder)/100))
    if workers<=0: return 0
    raw=workers*100+crop.wage_remainder; cents=raw/24
    if cents>0 and not transfer(w,d.market_account,d.household_account,cents,.wage,d.fields[index].land.id): return 0
    w.far.districts[place].fields[index].crop!.wage_remainder=raw%24
    w.far.districts[place].fields[index].crop!.paid_cents+=cents
    w.far.field_labor_paid+=cents; w.far.field_labor_hours+=workers
    workers

finish_field_record = (w: mut World,place: int,index: int,why: str):
    field=w.far.districts[place].fields[index]; crop=field.crop ?? return
    if crop.seed.roots.len()>0:
        if not far_market_accepts(w,place,crop.seed): return
        far_put_market(w,place,crop.seed)
    w.far.districts[place].fields[index].last_harvest=FarHarvest(crop.sown_day,crop.ready_day,day_index(w.minute),crop.area_ares,crop.seed_roots,crop.seed_milli,crop.harvested_milli,crop.sowing_work+crop.tending_work+crop.harvest_work,crop.paid_cents,why,agreement=crop.agreement,seed_route=crop.seed_route,seed_cents=crop.seed_cents)
    w.far.districts[place].fields[index].crop=none
    field_reason(w,place,why)

# Returns this hour's actual diverted workers. Caller subtracts them from the SAME
# cohort's specialist work; populations and vehicle crews are never duplicated.
household_fields_hour = (w: mut World,place: int,workers: int) -> int:
    d=w.far.districts[place]
    w.far.districts[place].field_workers=0; w.far.districts[place].field_seed_target=0
    loop k in 0..d.fields.len(): w.far.districts[place].fields[k].last_workers=0
    if d.fields.len()==0 or d.output==3: return 0 # existing specialist farms retain their cohort model
    day=day_index(w.minute); budget=max(0,min(workers/2,workers-3)); used=0
    edible=max(0,far_market_qty(w,place,3)-d.field_seed_target)
    annual=field_population(d)*FAR_STAPLE_DAILY*CROP_YEAR_DAYS
    need_crop=edible<annual
    recovered=edible>=annual
    planted=0
    loop field in d.fields:
        if let crop=field.crop: planted+=crop.area_ares
    if (need_crop or d.field_seed_target>0) and not recovered and crop_sowing_season(day) and w.accounts[d.market_account].cents>=100:
        want=max(0,field_household_target_ares(d)-planted)
        loop index in 0..d.fields.len():
            if want<=0: break
            field=w.far.districts[place].fields[index]
            if field.crop!=none: continue
            price=w.far.districts[place].prices[3]
            # A prospective seed order must fit actual funds, including the field wages.
            affordable=w.accounts[d.market_account].cents*1000/max(1,price*CROP_SEED_PER_ARE+10000)
            area=min(want,min(field.land.area_ares,affordable))
            if area<=0: break
            planned=field_seed_milli(area)
            if not begin_household_sowing(w,place,index,area):
                w.far.districts[place].field_seed_target+=planned
            want-=area
    loop index in 0..d.fields.len():
        field=w.far.districts[place].fields[index]; crop=field.crop ?? continue
        if crop.stage!=.sowing and day>crop.harvest_until_day:
            finish_field_record(w,place,index,"The households at {life_place_name(w,place)} closed field {field.land.id}'s harvest on {crop_date(day)}: {f64(crop.harvested_milli)/1000.0:.2} packages were actually gathered. Uncollected crop was lost in the field; it never became warehouse stock.")
            continue
        if (crop.stage==.sowing and recovered) or (crop.stage!=.sowing and day<crop.ready_day and not need_crop):
            if crop.stage==.sowing:
                finish_field_record(w,place,index,"The households at {life_place_name(w,place)} stopped preparing field {field.land.id} after grain supplies recovered, returned its unplanted seed and released their hands to {w.goods[d.output].key} work.")
            continue
        if budget<=0: continue
        required=0; done=0; daily=0
        if crop.stage==.sowing:
            required=crop_required_work(crop.area_ares,CROP_SOW_HOURS_PER_HA); done=crop.sowing_work
            daily=max(1,(required+47)/48)
        else if day<crop.ready_day:
            required=crop_required_work(crop.area_ares,CROP_TEND_HOURS_PER_HA); done=crop.tending_work
            daily=max(1,(required-done+max(1,(crop.ready_day-day)*24)-1)/max(1,(crop.ready_day-day)*24))
        else:
            if crop.stage!=.harvesting:
                w.far.districts[place].fields[index].crop!.stage=.harvesting
                w.far.districts[place].fields[index].crop!.potential_milli=field_care_yield(crop)
                crop=w.far.districts[place].fields[index].crop!
            required=crop_required_work(crop.area_ares,CROP_HARVEST_HOURS_PER_HA); done=crop.harvest_work
            daily=max(1,(required+23)/24)
        if crop.stage==.harvesting and d.core<0:
            key="far:{place}:3:false:field:{field.land.id}:sown:{crop.sown_day}"; root=w.cargo_source_keys.get(key,-1)
            current=w.far.districts[place].stock
            if not (root in current.roots) and current.roots.len()>=FAR_MAX_STOCK_ROOTS: continue
        count=min(budget,min(daily,max(0,required-done)))
        actual=field_pay_work(w,place,index,count)
        if actual<=0: continue
        used+=actual; budget-=actual
        w.far.districts[place].fields[index].last_workers=actual
        if crop.stage==.sowing:
            w.far.districts[place].fields[index].crop!.sowing_work+=actual
            if crop.sowing_work+actual>=required:
                far_use(w,crop.seed); w.far.field_seed_sown+=crop.seed_milli
                w.far.districts[place].fields[index].crop!.seed=FarStock()
                w.far.districts[place].fields[index].crop!.stage=.growing
                w.far.districts[place].fields[index].crop!.sown_day=day
                ready=crop_ready_day(day,field.land.id)
                w.far.districts[place].fields[index].crop!.ready_day=ready
                w.far.districts[place].fields[index].crop!.harvest_until_day=ready+30
                w.far.districts[place].fields[index].crop!.agreement.deadline=(ready+31)*1440
                field_reason(w,place,"The households at {life_place_name(w,place)} finished sowing field {field.land.id} on {crop_date(day)} using their recorded seed. Its grain cannot be harvested before {crop_date(ready)}.")
        else if day<crop.ready_day:
            w.far.districts[place].fields[index].crop!.tending_work+=actual
        else:
            work=crop.harvest_work+actual
            grain=max(0,crop.potential_milli*work/required-crop.harvested_milli)
            if grain>0 and not far_produce(w,place,3,grain,field=field.land.id):
                living_fault("fields.harvest_stock","place={place} field={field.land.id}"); return used
            w.far.districts[place].fields[index].crop!.harvest_work=work
            w.far.districts[place].fields[index].crop!.harvested_milli+=grain
            w.far.field_grain_harvested+=grain
            if work>=required:
                finish_field_record(w,place,index,"The households at {life_place_name(w,place)} finished harvesting field {field.land.id} on {crop_date(day)}: {f64(crop.harvested_milli+grain)/1000.0:.2} real packages of grain from seed sown on {crop_date(crop.sown_day)}. The hands can return to {w.goods[d.output].key} work.")
    w.far.districts[place].field_workers=used
    if used>0:
        field_reason(w,place,"The households at {life_place_name(w,place)} moved {used} existing hands from {w.goods[d.output].key} work into an agreed crop on their registered grain fields after their food outlook prompted a growing plan. Seed, paid fieldwork and the harvest season still limit the crop.")
    else if not need_crop and d.field_workers>0:
        field_reason(w,place,"Grain supplies at {life_place_name(w,place)} have recovered; the households released their extra field hands back to {w.goods[d.output].key} work.")
    used

household_field_views = (w: World,place: int) -> FarFieldView[]:
    result: FarFieldView[]
    if not (place in w.far.districts): return result
    d=w.far.districts[place]
    loop field in d.fields:
        stage="fallow"; area=0; sow= -1; ready= -1; harvested=0; why=d.field_reason
        if d.output==3: stage="specialist farm"
        if let crop=field.crop:
            stage=if crop.stage==.sowing: "sowing" else: if day_index(w.minute)<crop.ready_day: "growing" else: "ripe"
            area=crop.area_ares; sow=crop.sown_day; ready=crop.ready_day; harvested=crop.harvested_milli
            why=crop.agreement.cause+" "+d.field_reason
        else if let record=field.last_harvest: why=record.why
        result.push(FarFieldView(field.land.id,place,field.land.center,field.land.width,field.land.area_ares,area,stage,sow,ready,harvested,why,workers=field.last_workers,owner_account=d.household_account,operator_account=d.market_account,seed_milli=if let crop=field.crop: crop.seed_milli else: 0,paid_cents=if let crop=field.crop: crop.paid_cents else: 0))
    result


household_field_provenance = (w: World,place: int,id: int) -> str[]:
    result: str[]
    if not (place in w.far.districts): return result
    loop field in w.far.districts[place].fields:
        if field.land.id!=id: continue
        if let crop=field.crop:
            result=provenance_lines(w,crop.agreement)
            result.push("Registered area: {f64(crop.area_ares)/100.0:.2} hectares; seed: {f64(crop.seed_milli)/1000.0:.2} packages; paid field wages: {phoenix_text(crop.paid_cents)}.")
            if crop.stage==.sowing: result.push("The seed is still held for planting. No crop has been sown or harvested yet.")
            else: result.push("Sown {crop_date(crop.sown_day)}; cannot harvest before {crop_date(crop.ready_day)}; {f64(crop.harvested_milli)/1000.0:.2} packages actually gathered.")
        else if let record=field.last_harvest:
            result=provenance_lines(w,record.agreement); result.push(record.why)
        else: result.push("Registered field {id}, {life_place_name(w,place)}: {f64(field.land.area_ares)/100.0:.2} hectares owned by the local households. No additional standing crop is recorded.")
    result


# One-time explicit metadata migration after the adapter verifies the same terrain/registry.
# A played save gets existing land rights, not retroactive crops, seed, cash or labor.
register_household_land = (w: mut World,seeds: FarPlaceSeed[]) -> bool:
    if w.far.fields_registered: return true
    if not w.far.populated or guard_blocked(): return false
    scope=guard_begin(w)
    owners: {int: int}; staged: {int: FarField[]}
    loop place in w.far.place_ids:
        staged[place]=w.far.districts[place].fields
        loop field in staged[place]: owners[field.land.id]=place
    valid=true
    loop seed in seeds:
        if not (seed.id in staged) or seed.fields.len()>8: valid=false; break
        loop land in seed.fields:
            if not field_land_valid(land): valid=false; break
            if land.id in owners: continue # preserve the actual saved owner and growing crop
            if staged[seed.id].len()>=8: continue
            staged[seed.id].push(FarField(land)); owners[land.id]=seed.id
    if valid:
        loop place in w.far.place_ids:
            parcels=staged[place]; parcels.sort((field: FarField): field.land.id)
            w.far.districts[place].fields=parcels
        w.far.fields_registered=true
    else: living_fault("fields.land_migration",guard_context(w)+" incompatible mapped parcels")
    failed=guard_failed(scope); guard_finish(w,scope)
    valid and not failed
