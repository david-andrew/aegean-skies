# Graphics-only residency. The water field, canal collision and economy do not
# depend on these meshes/shaders and remain available before the first visit.
use 'river_render.jo'
use 'canal_render.jo'
use 'canal_geometry.jo'
use 'geography.jo'
use 'lake_data.jo'
use 'thermal_sites.jo'

inland_scenery_ready=false
canal_scenery_ready=false

prepare_inland_scenery=(cam:vec3):
    global inland_scenery_ready,canal_scenery_ready
    if not geography_enabled:return
    if not inland_scenery_ready:
        # Match the river draw region, including its distant-water selection.
        near=cam.x>= -180000 and cam.x<= -65000 and cam.z>= -182000 and cam.z<= -120000
        if not near:
            loop lake in SETTLEMENT_LAKES:
                if length(cam.xz-lake.center)<10000:near=true;break
        if not near:
            loop site in THERMAL_SITES:
                if length(cam-site.center)<2500:near=true;break
        if near:init_rivers();inland_scenery_ready=true
    if not canal_scenery_ready and length(cam.xz-canal_origin.xz)<16000:
        init_canal();canal_scenery_ready=true
