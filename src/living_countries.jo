# National foundation: evidence, attribution and tension. No unowned fleets or scheduled war.
use 'living_types.jo'
use 'life_types.jo'
use 'living_life_seed.jo'

country_of = (w: World, person: int) -> int:
    if person < 0 or person >= w.people.len(): return -1
    if w.people[person].far_home>=0: return w.people[person].citizenship
    home = w.people[person].home
    if home < 0 or home >= w.place_country.len(): -1 else: w.place_country[home]

set_core_country = (w: mut World, place: int, country: int) -> bool:
    initialize_life(w)
    if place < 0 or place >= w.places.len() or country < -1 or country >= w.countries.len(): return false
    w.place_country[place] = country
    true

set_country_seat = (w: mut World, country: int, place: int, authority: int) -> bool:
    if country < 0 or country >= w.countries.len() or place < 0 or place >= w.places.len() or authority < 0 or authority >= w.factions.len(): return false
    if w.place_country[place] != country: return false
    w.countries[country].seat = place; w.countries[country].authority_faction = authority
    w.countries[country].treasury_account = w.factions[authority].account
    true

# A government can only respond to reports actually heard at its seat. Evidence is deduped by
# real Event ID; circulating a story or raising its confidence never multiplies the incident.
record_national_evidence = (w: mut World, government: int, news: NewsItem) -> bool:
    if government < 0 or government >= w.countries.len() or news.private_fact or news.event < 0 or news.confidence < 600 or news.hops > 4 or w.minute-news.occurred_minute >= 10080: return false
    seat = w.countries[government].seat
    if seat < 0 or seat >= w.places.len(): return false
    heard_here = false
    loop n in w.places[seat].news:
        if n.event == news.event and n.confidence >= news.confidence: heard_here = true
    if not heard_here or news.event in w.diplomatic_receipts: return false
    # Civilian/privateer wrongdoing creates danger and a dispute; it is not proof of state orders.
    if news.kind != .raid and news.kind != .theft and news.kind != .fine: return false
    actor = news.reason.actor
    target = if news.reason.counterparty >= 0: news.reason.counterparty else: news.reason.beneficiary
    a = country_of(w,actor); b = country_of(w,target)
    if a < 0 or b < 0 or a == b or (government != a and government != b): return false
    state_backed = w.countries[a].authority_faction >= 0 and news.actor_faction == w.countries[a].authority_faction
    weight = max(1,news.severity*news.confidence/10000)
    if not state_backed: weight = max(1,weight/3)
    id = w.next_border_incident; w.next_border_incident += 1
    kind = if news.kind == .raid: BorderIncidentKind.attack else: BorderIncidentKind.seizure
    w.border_incidents.push(BorderIncident(id,news.event,news.occurred_minute,a,b,kind,news.confidence,weight,news.source_person,state_backed))
    w.diplomatic_receipts[news.event] = news.occurred_minute
    first = min(a,b); second = max(a,b); relation = -1
    loop k in 0..w.diplomacy.len():
        if w.diplomacy[k].a == first and w.diplomacy[k].b == second: relation = k
    if relation < 0:
        relation = w.diplomacy.len(); w.diplomacy.push(DiplomaticRelation(first,second))
    w.diplomacy[relation].tension = min(1000,w.diplomacy[relation].tension+weight)
    w.diplomacy[relation].last_incident_minute = max(w.diplomacy[relation].last_incident_minute,news.occurred_minute)
    w.diplomacy[relation].evidence.push(id)
    if w.diplomacy[relation].evidence.len()>32: w.diplomacy[relation].evidence.remove_at(0)
    # Armed escalation needs funded units/convoys and territorial data. Until those exist,
    # the truthful implemented result is a strained relationship, not a fake running war.
    if w.diplomacy[relation].tension >= 40: w.diplomacy[relation].stage = .strained
    if w.border_incidents.len()>128: w.border_incidents.remove_at(0)
    true

countries_minute = (w: mut World):
    if w.minute%60 != 0: return
    initialize_life(w)
    loop country in w.countries:
        if country.seat < 0: continue
        news = w.places[country.seat].news
        news.sort((n: NewsItem): n.event)
        loop n in news: record_national_evidence(w,country.id,n)
    if local_minute(w.minute) == 0:
        loop k in 0..w.diplomacy.len():
            if w.diplomacy[k].last_review_day == day_index(w.minute): continue
            w.diplomacy[k].last_review_day = day_index(w.minute)
            if w.minute-w.diplomacy[k].last_incident_minute >= 1440: w.diplomacy[k].tension = max(0,w.diplomacy[k].tension-4)
            if w.diplomacy[k].tension < 25 and (w.diplomacy[k].stage==.calm or w.diplomacy[k].stage==.strained): w.diplomacy[k].stage = .calm
        stale: int[]
        loop event, occurred in w.diplomatic_receipts:
            if w.minute-occurred >= 11520: stale.push(event)
        loop event in stale: w.diplomatic_receipts.remove(event)
