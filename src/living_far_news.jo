# Local witnesses and physically carried accounts, not a world-wide broadcast of the event map.
use 'living_types.jo'
use 'living_far_types.jo'
use 'living_far_stock.jo'
use 'living_place_context.jo'

far_local_news = (w: mut World, place: int, kind: str, text: str, actor: int = -1, other: int = -1, country: int = -1, severity: int = 100, other_country: int = -1, aggressor: int = -1, affected: int = -1, state_backed: bool = false, weight: int = 0, subject_place: int = -1, subject_minute: int = -1, mission: int = -1, rescue: int = -1) -> int:
    if other_country< -1 or other_country>=3 or aggressor< -1 or aggressor>=3 or affected< -1 or affected>=3 or weight<0 or weight>150: return -1
    if not (place in w.far.districts) or text=="" or text.len()>4096 or actor< -1 or actor>=w.people.len() or other< -1 or other>=w.people.len() or country< -1 or country>=3 or severity<0 or severity>1000: return -1
    id = w.far.next_news; w.far.next_news += 1
    w.far.news[id]=FarNews(id,w.minute,place,actor,other,country,kind,text,severity,other_country=other_country,aggressor=aggressor,affected=affected,state_backed=state_backed,weight=weight,subject_place=subject_place,subject_minute=subject_minute,mission=mission,rescue=rescue)
    w.far.news_order.push(id)
    if w.far.news_order.len()>2048:
        old=w.far.news_order[0]; w.far.news_order.remove_at(0); w.far.news.remove(old)
    far_store_report(w,place,far_news_snapshot(w.far.news[id],w.minute))
    w.far.districts[place].recent_news.push(id)
    if w.far.districts[place].recent_news.len()>12: w.far.districts[place].recent_news.remove_at(0)
    id

far_receive_report = (w: mut World, person: int, report: FarReport) -> bool:
    if person<0 or person>=w.people.len() or report.occurred_minute>w.minute or not far_report_current(w,report) or report.hops>4 or report.confidence<300: return false
    loop old in w.people[person].far_reports:
        if old.id==report.id and old.confidence>=report.confidence: return false
    kept=[loop old in w.people[person].far_reports: if old.id!=report.id and far_report_current(w,old): old]
    kept.push(report)
    now=w.minute
    kept.sort((r: FarReport): (r.severity*r.confidence,max(-10080,r.occurred_minute-now),-r.id),descending=true)
    if kept.len()>12: kept=kept[0..12]
    w.people[person].far_reports=kept
    true

far_hear_counter = (w: mut World, person: int, place: int):
    if not (place in w.far.districts) or person<0 or person>=w.people.len(): return
    if length(person_world_position(w,person)-far_counter_position(w,place))>20: return
    loop old in w.far.districts[place].reports:
        r=old; r.learned_minute=w.minute
        far_receive_report(w,person,r)

far_relay_report = (w: mut World, speaker: int, listener: int, report: int) -> bool:
    if not people_can_talk(w,speaker,listener): return false
    loop old in w.people[speaker].far_reports:
        if old.id!=report: continue
        next=old; next.source_person=speaker; next.learned_minute=w.minute
        next.hops += 1; next.confidence=next.confidence*85/100
        return far_receive_report(w,listener,next)
    false

far_news_snapshot = (n: FarNews, minute: int) -> FarReport:
    FarReport(n.id,n.minute,minute,n.place,n.text,n.kind,actor=n.actor,other=n.other,country=n.country,severity=n.severity,other_country=n.other_country,aggressor=n.aggressor,affected=n.affected,state_backed=n.state_backed,weight=n.weight,subject_place=n.subject_place,subject_minute=n.subject_minute,mission=n.mission,rescue=n.rescue,supply_good=n.supply_good,supply_qty=n.supply_qty,supply_bid=n.supply_bid,supply_reward=n.supply_reward,supply_due=n.supply_due,supply_account=n.supply_account,supply_observed=n.supply_observed,supply_target=n.supply_target)

far_report_current = (w: World, r: FarReport) -> bool:
    r.occurred_minute<=w.minute and (r.kind=="war_declared" or r.kind=="armistice" or w.minute-r.occurred_minute<(if r.severity>=650: 43200 else: 10080)) and r.hops<=4 and r.confidence>=300

far_store_report = (w: mut World, place: int, r: FarReport):
    if not (place in w.far.districts) or not far_report_current(w,r): return
    loop old in w.far.districts[place].reports:
        if old.id==r.id and old.confidence>=r.confidence: return
    kept=[loop old in w.far.districts[place].reports: if old.id!=r.id and far_report_current(w,old): old]
    kept.push(r)
    kept.sort((r: FarReport): (r.severity*r.confidence,r.occurred_minute,-r.id),descending=true)
    if kept.len()>12: kept=kept[0..12]
    w.far.districts[place].reports=kept

far_arriving_accounts = (w: mut World, place: int, reports: FarReport[]):
    loop old in reports:
        r=old; r.learned_minute=w.minute; r.carriage+=1
        far_store_report(w,place,r)

far_departing_accounts = (w: World, place: int, vehicle: int) -> FarReport[]:
    candidates=w.far.districts[place].reports+w.far.vehicles[vehicle].reports
    candidates.sort((r: FarReport): (r.severity*r.confidence,r.occurred_minute,-r.id),descending=true)
    result: FarReport[]; seen: {int: bool}
    loop r in candidates:
        if r.id in seen or not far_report_current(w,r): continue
        seen[r.id]=true; result.push(r)
        if result.len()>=12: break
    result

far_counter_position = (w: World, place: int) -> vec3:
    if not (place in w.place_contexts): return vec3(0,0,0)
    if place>=0 and place<w.cargo_harbors.len(): return w.cargo_harbors[place].warehouse
    loop v in w.place_contexts[place].venues:
        if v.kind==.market: return v.pos
    w.place_contexts[place].center

far_player_counter_news = (w: mut World):
    if not w.far.populated: return
    at=person_world_position(w,w.player)
    loop place in w.far.place_ids:
        if length(at-far_counter_position(w,place))<=20:
            far_hear_counter(w,w.player,place)
            return

# A real counter publishes an authorized buying bid when household use depleted its stock.
# The report travels on actual services before another counter can accept these terms.
far_supply_requests = (w: mut World, place: int):
    d=w.far.districts[place]
    loop g in 0..8:
        stock=far_market_qty(w,place,g)
        if w.goods[g].shelf_hours>0: continue
        if stock>=d.target[g]/2 or w.minute-d.last_supply_request[g]<1440: continue
        qty=min(max(0,d.target[g]-stock),25000*1000/w.goods[g].package_grams)
        bid=d.prices[g]; freight=2400
        if qty<100 or w.accounts[d.market_account].cents<(qty*bid+999)/1000+freight: continue
        need="{life_place_name(w,place)}'s counter has {f64(stock)/1000.0:.2} packages of {w.goods[g].key} against its household supply target of {f64(d.target[g])/1000.0:.2}. It requests {f64(qty)/1000.0:.2}, offers up to {f64(bid)/100.0:.2} lire a package and pays {f64(freight)/100.0:.2} lire for carriage, due on day {day_index(w.minute+10080)+1} at {local_minute(w.minute+10080)/60:02}:{local_minute(w.minute+10080)%60:02}."
        id=far_local_news(w,place,"supply_request",need,country=d.controller,severity=if g==3 or g==6: 550 else: 300)
        if id<0: continue
        w.far.news[id].supply_good=g; w.far.news[id].supply_qty=qty
        w.far.news[id].supply_bid=bid; w.far.news[id].supply_reward=freight
        w.far.news[id].supply_due=w.minute+10080; w.far.news[id].supply_account=d.market_account
        w.far.news[id].supply_observed=stock; w.far.news[id].supply_target=d.target[g]
        w.far.districts[place].reports=[loop r in w.far.districts[place].reports: if r.id!=id: r]
        far_store_report(w,place,far_news_snapshot(w.far.news[id],w.minute))
        w.far.districts[place].last_supply_request[g]=w.minute
