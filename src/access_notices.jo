# Settlement names and distances come from the exact living cart graph. The
# sign is scenery, not a second schedule, stock ledger or transport authority.
use 'settlements.jo'
use 'inland_access_data.jo'
use 'thermal_sites.jo'
use 'landing_access.jo'
use 'shore_access_data.jo'

# Time on foot for a walk of metres that climbs rise metres, by the hill
# walkers' rule of thumb: 5 km an hour, and ten minutes more for each 100 m up.
walk_time_text=(metres:int,rise:f64)->str:
    minutes=f64(metres)*60.0/5000.0+max(0.0,rise)/10.0
    if minutes<8.0:return "a few minutes"
    if minutes<20.0:return "a quarter of an hour"
    if minutes<38.0:return "half an hour"
    if minutes<53.0:return "three quarters of an hour"
    if minutes<80.0:return "about an hour"
    if minutes<105.0:return "an hour and a half"
    "about {int(round(minutes/60.0))} hours"

# An island landing a long walk below its square: (metres, climb), else none.
landing_walk=(s:WorldSettlement)->(int,f64)?:
    if not (s.id in SHORE_LANDINGS) or not (s.id in INLAND_ACCESS):return none
    access=INLAND_ACCESS[s.id]
    if access.landing!=s.id or access.metres<1000:return none
    (access.metres,f64(s.center.y-landing_access(s.id).root.y))

# The same, as a line for a notice or a destination card:
# "Coastal landing, 5.4 km from the square, about an hour and a half on foot".
landing_walk_text=(s:WorldSettlement)->str:
    if let walk=landing_walk(s):return "Coastal landing, {f64(walk.0)/1000.0:.1} km from the square, {walk_time_text(walk.0,walk.1)} on foot"
    ""

access_notice_lines=(s:WorldSettlement)->str[]:
    if s.legacy>=0:return []
    # At a landing far below its square, the board gives the climb on foot.
    if let walk=landing_walk(s):return [s.name,"{f64(walk.0)/1000.0:.1} KM UP TO THE SQUARE",upper(walk_time_text(walk.0,walk.1))+" ON FOOT"]
    destinations:(int,int)[]
    loop id,access in INLAND_ACCESS:
        if access.landing!=s.id or not (id in settlement_by_id):continue
        town=world_settlements[settlement_by_id[id]]
        if town.kind!=.market:continue
        priority=if thermal_site(id)>=0: -1000000 else:0
        destinations.push((priority+access.metres,id))
    destinations.sort((p:(int,int)):p)
    lines:str[]
    loop k in 0..min(2,destinations.len()):
        id=destinations[k].1;access=INLAND_ACCESS[id]
        lines.push(world_settlements[settlement_by_id[id]].name)
        lines.push(if access.metres<1000:"{access.metres} M BY ROAD" else:"{f64(access.metres)/1000.0:.1} KM BY ROAD")
    lines
