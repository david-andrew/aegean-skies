# Settlement names and distances come from the exact living cart graph. The
# sign is scenery, not a second schedule, stock ledger or transport authority.
use 'settlements.jo'
use 'inland_access_data.jo'
use 'thermal_sites.jo'

access_notice_lines=(s:WorldSettlement)->str[]:
    if s.legacy>=0:return []
    destinations:(int,int)[]
    loop id,access in INLAND_ACCESS:
        if access.landing!=s.id or not (id in settlement_by_id):continue
        town=world_settlements[settlement_by_id[id]]
        if town.kind!=.market:continue
        priority=if thermal_site(id)>=0: -1000000 else:0
        destinations.push((priority+access.metres,id))
    destinations.sort((p:(int,int)):p)
    lines:str[]
    loop k in 0..min(2,destinations.len()):
        id=destinations[k].1;access=INLAND_ACCESS[id]
        lines.push(world_settlements[settlement_by_id[id]].name)
        lines.push(if access.metres<1000:"{access.metres} M BY ROAD" else:"{f64(access.metres)/1000.0:.1} KM BY ROAD")
    lines
