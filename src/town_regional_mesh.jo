# Two bounded mesh families, shared by all new-land parcels. The door/window
# grid and footprint are unchanged: these are roofs and materials, not addresses.
use 'objects.jo'
use 'town_region.jo'

const REGION_HOUSE_COUNT = 16
const REGION_PROXY_COUNT = 4

town_region_style = (country: int,flat: bool,floors: int) -> int:
    (if country==2:8 else:0)+(if flat:4 else:0)+floors-1

town_region_proxy = (country: int,flat: bool) -> int:
    (if country==2:2 else:0)+(if flat:1 else:0)

region_roof = (vs: mut Vertex3D[],m: mat4,w: f64,d: f64,h: f64,country: int,flat: bool):
    if not flat:
        # Clay gables in Kalyra have a much steeper silhouette and deep eaves.
        add_gable(vs,vec3(0,f32(h),0),w+0.5,d+0.5,min(w,d)*(if country==1:0.40 else:0.16),ROOFS[1],m)
        return
    white=WALLS[0]
    add_plaster_box(vs,vec3(0,f32(h+0.15),0),vec3(f32(w+0.3),0.3,f32(d+0.3)),white,m)
    if country==2:
        # A small stair-head at the back makes the roof a stepped terrace,
        # without changing the habitable footprint or hiding the front windows.
        add_plaster_box(vs,vec3(f32(w*0.22),f32(h+1.35),f32(-d*0.22)),vec3(f32(w*0.35),2.1,f32(d*0.35)),white,m)
        add_plaster_box(vs,vec3(f32(w*0.22),f32(h+2.48),f32(-d*0.22)),vec3(f32(w*0.35+0.25),0.16,f32(d*0.35+0.25)),white,m)
        add_painted_opening(vs,vec3(f32(w*0.22),f32(h+1.15),f32(-d*0.045+0.08)),vec3(0.85,1.6,0.16),DOORS[0],m)

region_house = (vs: mut Vertex3D[],m: mat4,w: f64,d: f64,h: f64,country: int,flat: bool,detail: bool=true):
    if country==1:
        # Stone is the lower wall itself, not a coplanar plinth on top of render.
        stone=rgb(0.67,0.63,0.52)
        if detail:
            add_box(vs,vec3(0,0.4,0),vec3(f32(w-0.10),4.8,f32(d-0.10)),rgb(0.43,0.42,0.36),m)
            loop row in 0..6:
                add_box(vs,vec3(0,f32(-1.62+f64(row)*0.8),0),vec3(f32(w),0.76,f32(d)),stone*vec4(1+f32(row%2)*0.04,1+f32(row%2)*0.04,1,1),m)
        else:add_box(vs,vec3(0,0.4,0),vec3(f32(w),4.8,f32(d)),stone,m)
        add_plaster_box(vs,vec3(0,f32((h+2.8)*0.5),0),vec3(f32(w),f32(h-2.8),f32(d)),WALLS[0],m)
    else:add_plaster_box(vs,vec3(0,f32(h*0.5-1),0),vec3(f32(w),f32(h+2),f32(d)),WALLS[0],m)
    region_roof(vs,m,w,d,h,country,flat)
    if not detail:return
    door=if country==1:DOORS[1] else:DOORS[0]
    z=f32(d*0.5+0.06)
    add_painted_opening(vs,vec3(f32(-w*0.2),0,z),vec3(1.7,3,0.12),door,m)
    loop fl in 0..max(1,int(h/4)):
        loop k in 0..max(1,int(w/4.4)):
            x=-w*0.5+2.6+f64(k)*4.4
            if fl==0 and abs(x+w*0.2)<1.9:continue
            lit=(k*7+fl*3)%3==0
            add_painted_opening(vs,vec3(f32(x),f32(2+f64(fl)*4),z),vec3(1.4,1.9,0.12),if lit:vec4(0.15,0.17,0.22,0.5) else:door,m)

region_chapel = (vs: mut Vertex3D[],m: mat4,country: int):
    white=WALLS[0];stone=rgb(0.72,0.68,0.57);bronze=rgb(0.38,0.30,0.17)
    if country==1:
        # Warm stone nave, terracotta ridge and a square open campanile.
        add_box(vs,vec3(0,3,0),vec3(9,10,14),stone,m)
        add_gable(vs,vec3(0,8,0),14,9,4.0,ROOFS[1],m*rotation_y(PI/2))
        add_box(vs,vec3(-5,6,-4),vec3(3.2,16,3.2),stone,m)
        loop x in [-6.3,-3.7]:
            loop z in [-5.3,-2.7]:add_box(vs,vec3(f32(x),15.6,f32(z)),vec3(0.6,3.2,0.6),stone,m)
        add_box(vs,vec3(-5,17.3,-4),vec3(3.6,0.3,3.6),white,m)
        add_gable(vs,vec3(-5,17.45,-4),3.8,3.8,2.8,ROOFS[1],m)
        add_cylinder(vs,vec3(-5,14.3,-4),0.7,1.1,bronze,8,0.27,m)
        add_box(vs,vec3(0,2,7.12),vec3(2.2,4,0.24),DOORS[1],m)
    else:
        # Low white nave, rounded blue-grey dome, two open bells on the facade.
        add_plaster_box(vs,vec3(0,2,0),vec3(10,8,14),white,m)
        add_cylinder(vs,vec3(0,6,0),3.2,1.4,white,12,-1,m)
        add_sphere(vs,vec3(0,0,0),1,rgb(0.39,0.53,0.60),12,6,m*translation(vec3(0,7.2,0))*scaling(vec3(3.35,2.6,3.35)))
        loop x in [-2.2,0.0,2.2]:add_plaster_box(vs,vec3(f32(x),7.5,6.5),vec3(0.55,3,0.8),white,m)
        add_plaster_box(vs,vec3(0,9.15,6.5),vec3(5,0.3,1),white,m)
        loop x in [-1.1,1.1]:add_cylinder(vs,vec3(f32(x),7.05,6.5),0.55,0.9,bronze,8,0.24,m)
        add_box(vs,vec3(0,1.8,7.12),vec3(2.2,3.6,0.24),DOORS[0],m)
    add_box(vs,vec3(0,10.6,0),vec3(0.13,1.6,0.13),white,m)
    add_box(vs,vec3(0,10.9,0),vec3(0.85,0.13,0.13),white,m)

# Cypress avenues in Kalyra; silver-green olive crowns in Orenthia and farms.
region_tree = (vs: mut Vertex3D[],country: int):
    bark=rgb(0.40,0.36,0.26)
    add_cylinder(vs,vec3(0,0,0),0.25,if country==1:5.0 else:2.5,bark,6,0.16)
    if country==1:
        add_sphere(vs,vec3(0,0,0),1,rgb(0.14,0.27,0.17),7,5,translation(vec3(0,5,0))*scaling(vec3(1.35,4.1,1.35)))
        add_cylinder(vs,vec3(0,7.5,0),0.75,2.6,rgb(0.17,0.29,0.18),7,0)
    else:
        loop k in 0..4:
            a=f64(k)*TAU/4+0.3;at=vec3(f32(cos(a)*1.5),f32(3.1+f64(k%2)*0.5),f32(sin(a)*1.5))
            add_cylinder(vs,vec3(0,0,0),0.12,f64(length(at-vec3(0,1.5,0))),bark,5,0.07,translation(vec3(0,1.5,0))*object_toward(at-vec3(0,1.5,0)))
            add_sphere(vs,vec3(0,0,0),1,if k%2==0:rgb(0.39,0.46,0.31) else:rgb(0.47,0.52,0.37),7,4,translation(at)*scaling(vec3(2.1,1.25,1.9)))
