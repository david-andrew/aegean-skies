# Two bounded mesh families, shared by all new-land parcels. The door/window
# grid and footprint are unchanged: these are roofs and materials, not addresses.
use 'objects.jo'
use 'town_region.jo'

const REGION_HOUSE_COUNT = 16
const REGION_PROXY_COUNT = 4

town_region_style = (country: int,flat: bool,floors: int) -> int:
    (if country==2:8 else:0)+(if flat:4 else:0)+floors-1

town_region_proxy = (country: int,flat: bool) -> int:
    (if country==2:2 else:0)+(if flat:1 else:0)

region_roof = (vs: mut Vertex3D[],m: mat4,w: f64,d: f64,h: f64,country: int,flat: bool):
    if not flat:
        # Clay gables in Kalyra have a much steeper silhouette and deep eaves.
        add_gable(vs,vec3(0,f32(h),0),w+0.5,d+0.5,min(w,d)*(if country==1:0.40 else:0.16),ROOFS[1],m)
        return
    white=WALLS[0]
    add_plaster_box(vs,vec3(0,f32(h+0.15),0),vec3(f32(w+0.3),0.3,f32(d+0.3)),white,m)
    if country==2:
        # A small stair-head at the back makes the roof a stepped terrace,
        # without changing the habitable footprint or hiding the front windows.
        add_plaster_box(vs,vec3(f32(w*0.22),f32(h+1.35),f32(-d*0.22)),vec3(f32(w*0.35),2.1,f32(d*0.35)),white,m)
        add_plaster_box(vs,vec3(f32(w*0.22),f32(h+2.48),f32(-d*0.22)),vec3(f32(w*0.35+0.25),0.16,f32(d*0.35+0.25)),white,m)
        add_painted_opening(vs,vec3(f32(w*0.22),f32(h+1.15),f32(-d*0.045+0.08)),vec3(0.85,1.6,0.16),DOORS[0],m)

# Single front-facing 2-triangle window pane (6x fewer triangles than add_box on far proxy houses).
_add_window_quad = (vs: mut Vertex3D[],cx: f32,cy: f32,z: f32,hw: f32,hh: f32,col: vec4,m: mat4):
    n = normalize((m * vec4(0,0,1,0)).xyz)
    p00 = (m * vec4(cx-hw,cy-hh,z,1)).xyz
    p10 = (m * vec4(cx+hw,cy-hh,z,1)).xyz
    p11 = (m * vec4(cx+hw,cy+hh,z,1)).xyz
    p01 = (m * vec4(cx-hw,cy+hh,z,1)).xyz
    vs.extend([
        Vertex3D(p00,n,vec2(0,0),col), Vertex3D(p10,n,vec2(1,0),col), Vertex3D(p11,n,vec2(1,1),col),
        Vertex3D(p00,n,vec2(0,0),col), Vertex3D(p11,n,vec2(1,1),col), Vertex3D(p01,n,vec2(0,1),col)
    ])

region_house = (vs: mut Vertex3D[],m: mat4,w: f64,d: f64,h: f64,country: int,flat: bool,detail: bool=true):
    if country==1:
        # Stone is the lower wall itself, not a coplanar plinth on top of render.
        region_stone_box(vs,vec3(0,0.4,0),vec3(f32(w),4.8,f32(d)),m)
        add_plaster_box(vs,vec3(0,f32((h+2.8)*0.5),0),vec3(f32(w),f32(h-2.8),f32(d)),WALLS[0],m)
    else:add_plaster_box(vs,vec3(0,f32(h*0.5-1),0),vec3(f32(w),f32(h+2),f32(d)),WALLS[0],m)
    region_roof(vs,m,w,d,h,country,flat)
    if not detail:
        # Keep a pair of lit-capable window quads on far proxy houses (4 tris instead of 24)
        # so approaching a district at night hands over smoothly without popping from dark blocks.
        z=f32(d*0.5+0.09)
        pane=vec4(0.15,0.17,0.22,0.5)
        _add_window_quad(vs,f32(-w*0.2),f32(h*0.42),z,0.75,0.9,pane,m)
        _add_window_quad(vs,f32(w*0.22),f32(h*0.68),z,0.75,0.9,pane,m)
        return
    door=if country==1:DOORS[1] else:DOORS[0]
    z=f32(d*0.5+0.06)
    add_painted_opening(vs,vec3(f32(-w*0.2),0,z),vec3(1.7,3,0.12),door,m)
    loop fl in 0..max(1,int(h/4)):
        loop k in 0..max(1,int(w/4.4)):
            x=-w*0.5+2.6+f64(k)*4.4
            if fl==0 and abs(x+w*0.2)<1.9:continue
            lit=(k*7+fl*3)%3==0
            add_painted_opening(vs,vec3(f32(x),f32(2+f64(fl)*4),z),vec3(1.4,1.9,0.12),if lit:vec4(0.15,0.17,0.22,0.5) else:door,m)

# A church's west door on the facade (z 7): a dressed stone surround with a round arch and
# keystone, two panelled leaves with a dark seam, ring handles, and a round window above.
region_church_door = (vs: mut Vertex3D[],m: mat4,height: f64,paint: vec4,surround: vec4,window: bool = true):
    z=7.0
    dark=paint*0.62;dark.w=1.0
    trim=surround*0.92;trim.w=1.0
    iron=rgb(0.12,0.12,0.12)
    leaf_h=height-0.55
    # (the doorway's dark depth behind the leaves, then the leaves either side of the seam)
    add_box(vs,vec3(0,f32(height*0.5),f32(z+0.04)),vec3(2.3,f32(height),0.1),rgb(0.08,0.07,0.06),m)
    loop side in [-1.0,1.0]:
        cx=f32(side*0.56)
        add_box(vs,vec3(cx,f32(leaf_h*0.5),f32(z+0.13)),vec3(1.06,f32(leaf_h),0.12),paint,m)
        loop k in 0..2:
            ph=leaf_h*0.36
            add_box(vs,vec3(cx,f32(leaf_h*(0.27+0.46*f64(k))),f32(z+0.2)),vec3(0.74,f32(ph),0.03),dark,m)
        add_cylinder(vs,vec3(0,0,0),0.08,0.04,iron,6,-1.0,m*translation(vec3(f32(side*0.16),f32(leaf_h*0.5),f32(z+0.19)))*rotation_x(PI*0.5))
    # (the fanlight under the arch)
    add_box(vs,vec3(0,f32(leaf_h+0.27),f32(z+0.13)),vec3(2.18,0.5,0.1),dark,m)
    # the surround: jambs, plinth blocks, the arch's voussoirs and keystone
    loop side in [-1.0,1.0]:
        add_box(vs,vec3(f32(side*1.36),f32(height*0.5),f32(z+0.16)),vec3(0.44,f32(height),0.32),trim,m)
        add_box(vs,vec3(f32(side*1.36),0.25,f32(z+0.2)),vec3(0.56,0.5,0.4),surround,m)
    loop k in 0..7:
        a=PI*f64(k)/6.0
        add_box(vs,vec3(f32(cos(a)*1.36),f32(height+sin(a)*0.9),f32(z+0.16)),vec3(0.48,0.36,0.32),trim,m)
    add_box(vs,vec3(0,f32(height+0.95),f32(z+0.2)),vec3(0.34,0.52,0.38),surround,m)
    # the round window above, framed in stone
    if window:
        add_cylinder(vs,vec3(0,0,0),0.95,0.24,trim,14,-1.0,m*translation(vec3(0,f32(height+2.4),f32(z-0.02)))*rotation_x(PI*0.5))
        add_cylinder(vs,vec3(0,0,0),0.72,0.26,rgb(0.12,0.14,0.18),14,-1.0,m*translation(vec3(0,f32(height+2.4),f32(z-0.02)))*rotation_x(PI*0.5))

region_chapel = (vs: mut Vertex3D[],m: mat4,country: int):
    white=WALLS[0];stone=rgb(0.72,0.68,0.57);bronze=rgb(0.38,0.30,0.17)
    if country==1:
        # Warm stone nave, terracotta ridge and a square open campanile.
        region_stone_box(vs,vec3(0,3,0),vec3(9,10,14),m)
        add_gable(vs,vec3(0,8,0),14,9,4.0,ROOFS[1],m*rotation_y(PI/2))
        region_stone_box(vs,vec3(-5,6,-4),vec3(3.2,16,3.2),m)
        loop x in [-6.3,-3.7]:
            loop z in [-5.3,-2.7]:add_box(vs,vec3(f32(x),15.6,f32(z)),vec3(0.6,3.2,0.6),stone,m)
        add_box(vs,vec3(-5,17.3,-4),vec3(3.6,0.3,3.6),white,m)
        add_gable(vs,vec3(-5,17.45,-4),3.8,3.8,2.8,ROOFS[1],m)
        add_cylinder(vs,vec3(-5,14.3,-4),0.7,1.1,bronze,8,0.27,m)
        region_church_door(vs,m,4.0,DOORS[1],stone)
    else:
        # Low white nave, rounded blue-grey dome, two open bells on the facade.
        add_plaster_box(vs,vec3(0,2,0),vec3(10,8,14),white,m)
        add_cylinder(vs,vec3(0,6,0),3.2,1.4,white,12,-1,m)
        add_sphere(vs,vec3(0,0,0),1,rgb(0.39,0.53,0.60),12,6,m*translation(vec3(0,7.2,0))*scaling(vec3(3.35,2.6,3.35)))
        loop x in [-2.2,0.0,2.2]:add_plaster_box(vs,vec3(f32(x),7.5,6.5),vec3(0.55,3,0.8),white,m)
        add_plaster_box(vs,vec3(0,9.15,6.5),vec3(5,0.3,1),white,m)
        loop x in [-1.1,1.1]:add_cylinder(vs,vec3(f32(x),7.05,6.5),0.55,0.9,bronze,8,0.24,m)
        region_church_door(vs,m,3.6,DOORS[0],white,window = false)
    cross=if country==1:vec3(-5,20.8,-4) else:vec3(0,10.6,0)
    add_box(vs,cross,vec3(0.13,1.6,0.13),white,m)
    add_box(vs,cross+vec3(0,0.3,0),vec3(0.85,0.13,0.13),white,m)

# Cypress avenues in Kalyra; silver-green olive crowns in Orenthia and farms.
region_tree = (vs: mut Vertex3D[],country: int):
    bark=rgb(0.40,0.36,0.26)
    add_cylinder(vs,vec3(0,0,0),0.25,if country==1:5.0 else:2.5,bark,6,0.16)
    if country==1:
        add_sphere(vs,vec3(0,0,0),1,rgb(0.14,0.27,0.17),7,5,translation(vec3(0,5,0))*scaling(vec3(1.35,4.1,1.35)))
        add_cylinder(vs,vec3(0,7.5,0),0.75,2.6,rgb(0.17,0.29,0.18),7,0)
    else:
        loop k in 0..4:
            a=f64(k)*TAU/4+0.3;at=vec3(f32(cos(a)*1.5),f32(3.1+f64(k%2)*0.5),f32(sin(a)*1.5))
            add_cylinder(vs,vec3(0,0,0),0.12,f64(length(at-vec3(0,1.5,0))),bark,5,0.07,translation(vec3(0,1.5,0))*object_toward(at-vec3(0,1.5,0)))
            add_sphere(vs,vec3(0,0,0),1,if k%2==0:rgb(0.39,0.46,0.31) else:rgb(0.47,0.52,0.37),7,4,translation(at)*scaling(vec3(2.1,1.25,1.9)))

# The masonry uses its own wall volume, never a second face over the plaster.
# Local material coordinates are stored before any country-scale placement.
region_stone_box = (vs: mut Vertex3D[],center: vec3,size: vec3,m: mat4):
    local: Vertex3D[]
    add_box(local,center,size,rgb(0.75,0.71,0.60))
    loop v in local:
        horizontal=if abs(v.normal.x)>0.5:v.pos.z else:v.pos.x
        # Encode both local coordinates in the UV tag's interval. The integer
        # part selects masonry; the other coordinate is its local height.
        uv=vec2(184.0+horizontal/1024.0,v.pos.y)
        vs.push(Vertex3D(transform_point(m,v.pos),(m*vec4(v.normal,0)).xyz,uv,v.color))
