# The phoenix: the money of the game's Aegean, after Greece's first modern currency (1828), whose
# coin showed a phoenix rising from flames; a phoenix is 100 lepta.
#
# The ledger keeps money in whole lepta (`cents` everywhere in the code: 1250 = 12.50 phoenixes).
# Written amounts are the phoenix sign and the figure ("¤12", "¤12.50"); an amount under one
# phoenix is written in lepta ("30 λ"). Words carry the sign as "¤" (the generic currency sign),
# and ptext and its kin draw it as the phoenix (`draw_phoenix`), so a notice, a toast or a line
# in the notebook needs nothing more than the words. Speech says the money aloud instead
# ("near enough nineteen phoinikes", "thirty lepta": src/living_talk_words.jo say_money).

const PHOENIX_SIGN = "¤"

# The written amount: "¤120", "¤3.50", "30 λ", "¤0"
phoenix_text = (cents: int) -> str:
    if cents < 0: return "-" + phoenix_text(-cents)
    if cents > 0 and cents < 100: return "{cents} λ"
    if cents % 100 == 0: "¤{cents / 100}" else: "¤{cents / 100}.{cents % 100:02}"

# ---------------- the sign ----------------

PHOENIX_GOLD = rgba(0.86, 0.68, 0.30, 1)
PHOENIX_FLAME = rgba(0.80, 0.42, 0.16, 1)

# The sign's outline in a 1 x 1 box centred on it (x right, y down): the head with its beak to
# the right and a plume behind, the wings raised to their tips and back down along three
# feathers each, and the flame it rises from, three tongues a side and one licking up the tail.
_PHOENIX_SHAPE: vec2[] = [vec2(0.0, -0.44), vec2(0.07, -0.41), vec2(0.18, -0.33), vec2(0.08, -0.28),
    vec2(0.07, -0.19), vec2(0.11, -0.13), vec2(0.21, -0.28), vec2(0.32, -0.42), vec2(0.49, -0.50),
    vec2(0.46, -0.34), vec2(0.41, -0.27), vec2(0.48, -0.22), vec2(0.36, -0.13), vec2(0.40, -0.05),
    vec2(0.24, -0.02), vec2(0.22, 0.06), vec2(0.11, 0.09),
    vec2(0.15, 0.21), vec2(0.28, 0.07), vec2(0.26, 0.25), vec2(0.39, 0.20), vec2(0.33, 0.39), vec2(0.19, 0.48), vec2(0.0, 0.50),
    vec2(-0.19, 0.48), vec2(-0.33, 0.39), vec2(-0.39, 0.20), vec2(-0.26, 0.25), vec2(-0.28, 0.07), vec2(-0.15, 0.21), vec2(-0.11, 0.09), vec2(-0.22, 0.06), vec2(-0.24, -0.02), vec2(-0.40, -0.05),
    vec2(-0.36, -0.13), vec2(-0.48, -0.22), vec2(-0.41, -0.27), vec2(-0.46, -0.34), vec2(-0.49, -0.50),
    vec2(-0.32, -0.42), vec2(-0.21, -0.28), vec2(-0.11, -0.13), vec2(-0.07, -0.19), vec2(-0.08, -0.29),
    vec2(-0.09, -0.37), vec2(-0.18, -0.49), vec2(-0.04, -0.44)]
# the flame alone, below where the bird meets it
_PHOENIX_FLAME: vec2[] = [vec2(0.11, 0.09), vec2(0.15, 0.21), vec2(0.28, 0.07), vec2(0.26, 0.25), vec2(0.39, 0.20), vec2(0.33, 0.39), vec2(0.19, 0.48), vec2(0.0, 0.50),
    vec2(-0.19, 0.48), vec2(-0.33, 0.39), vec2(-0.39, 0.20), vec2(-0.26, 0.25), vec2(-0.28, 0.07), vec2(-0.15, 0.21), vec2(-0.11, 0.09), vec2(-0.05, 0.20), vec2(0.0, 0.11), vec2(0.05, 0.20)]

_phoenix_at = (pts: vec2[], c: vec2, h: f64) -> vec2[]:
    out: vec2[]
    loop p in pts: out.push(c + p * f32(h))
    out

# a stroked path with round joins (closed: back to its first point)
_phoenix_stroke = (pts: vec2[], w: f64, col: vec4, closed: bool):
    n = if closed: pts.len() else: pts.len() - 1
    loop k in 0..n: line(pts[k], pts[(k + 1) % pts.len()], w, col)
    if w > 1.6:
        loop p in pts: circle(p, w * 0.5, col)

# The phoenix with its wings raised over a flame, `h` tall and as wide, centred on `c`: filled
# (the purse, a price that stands on its own) or in outline (an amount in running text on
# paper). The flame takes `fire` when it is given, else the bird's own colour.
draw_phoenix = (c: vec2, h: f64, col: vec4 = PHOENIX_GOLD, filled: bool = true, fire: vec4 = vec4(0, 0, 0, 0)):
    if filled:
        polygon(_phoenix_at(_PHOENIX_SHAPE, c, h), col)
        if fire.w > 0.0: polygon(_phoenix_at(_PHOENIX_FLAME, c, h), fire)
        return
    # (in outline the bird is drawn round and the flame stays solid, so it reads as fire)
    w = max(1.0, 0.075 * h)
    polygon(_phoenix_at(_PHOENIX_FLAME, c, h), if fire.w > 0.0: fire else: col)
    _phoenix_stroke(_phoenix_at(_PHOENIX_SHAPE, c, h), w, col, true)

# ---------------- words with the sign in them ----------------
# The sign takes the room of "¤" and a little more, so lines measured, wrapped or cut with
# text_width, wrap_text and fit_text come out within a few pixels of how they are drawn
# (ptext_width is exact).

_PHOENIX_EXTRA = 0.18               # (of the type size, beyond the "¤" glyph's own width)

_phoenix_advance = (size: f64) -> f64: text_width(PHOENIX_SIGN, size) + size * _PHOENIX_EXTRA

ptext_width = (s: str, size: f64 = 20.0) -> f64:
    if not s.contains(PHOENIX_SIGN): return text_width(s, size)
    widest = 0.0
    loop row in split(s, "\n"):
        parts = split(row, PHOENIX_SIGN)
        wide = 0.0
        loop k in 0..parts.len():
            wide += text_width(parts[k], size)
            if k > 0: wide += _phoenix_advance(size)
        widest = max(widest, wide)
    widest

# text(), with each "¤" drawn as the phoenix: in the text's own colour unless `sign` (and `fire`,
# the flame's) is given, and in outline when `filled` is false
ptext = (s: str, pos: vec2, size: f64 = 20.0, color: vec4 = vec4(1, 1, 1, 1), shadow: vec4 = vec4(0, 0, 0, 0), mono: bool = false, chars: int = -1, filled: bool = true, sign: vec4 = vec4(0, 0, 0, 0), fire: vec4 = vec4(0, 0, 0, 0)):
    if not s.contains(PHOENIX_SIGN) or mono or chars >= 0:
        text(s, pos, size, color, shadow, mono, chars)
        return
    rows = split(s, "\n")
    loop r in 0..rows.len():
        y = pos.y + f32(f64(r) * size * 1.25)
        x = f64(pos.x)
        parts = split(rows[r], PHOENIX_SIGN)
        loop k in 0..parts.len():
            if k > 0:
                adv = _phoenix_advance(size)
                c = vec2(f32(x + adv * 0.47), f32(f64(y) + size * 0.52))
                if shadow.w > 0.0: draw_phoenix(c + vec2(f32(size * 0.06), f32(size * 0.06)), size * 0.74, shadow, filled)
                draw_phoenix(c, size * 0.74, if sign.w > 0.0: sign else: color, filled, fire)
                x += adv
            if parts[k] != "":
                text(parts[k], vec2(f32(x), y), size, color, shadow)
                x += text_width(parts[k], size)

ptext_centered = (s: str, center: vec2, size: f64 = 20.0, color: vec4 = vec4(1, 1, 1, 1), shadow: vec4 = vec4(0, 0, 0, 0), mono: bool = false, filled: bool = true):
    if not s.contains(PHOENIX_SIGN) or mono:
        text_centered(s, center, size, color, shadow, mono)
        return
    rows = split(s, "\n")
    top = f64(center.y) - text_height(s, size) * 0.5
    loop r in 0..rows.len():
        w = ptext_width(rows[r], size)
        ptext(rows[r], vec2(f32(f64(center.x) - w * 0.5), f32(top + f64(r) * size * 1.25)), size, color, shadow, filled = filled)
