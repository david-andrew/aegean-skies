# Matching relative views of stable town identities before/after relocation.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use 'judge_scene.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
loop id in [111289,131012,141625]:
    s=world_settlements[settlement_by_id[id]]
    out=if id==111289:normalize(vec2(0.323,-0.946)) else:if id==131012:normalize(vec2(0.999,-0.037)) else:vec2(0,1)
    side=vec2(-out.y,out.x)
    air=s.center+vec3(-out.x*1100+side.x*650,900,-out.y*1100+side.y*650)
    target=s.center+vec3(out.x*400,0,out.y*400)
    ground=judge_ground_eye(s,s.center)
    loop pair in [("air",air,target),("street",ground,s.center+vec3(0,2,0))]:
        d=pair.2-pair.1
        yaw=atan2(-f64(d.x),-f64(d.z));pitch=atan2(f64(d.y),f64(length(d.xz)))
        print("{s.name.lower()}-{pair.0}|{pair.1.x} {pair.1.y} {pair.1.z} {yaw} {pitch} 14")
