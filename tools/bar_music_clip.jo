# A clip of the Hotel Ancora's evening music, as heard from a table: renders the band and the singer
# through the terrace's room to a WAV (48 kHz stereo), and prints the band's and the voice's levels.
#   BAR_PIECE=0 BAR_FROM=10 BAR_SECONDS=30 BAR_DISTANCE=12 BAR_OUT=clip.wav sloppy --release tools/bar_music_clip.jo
# BAR_VOICE=0 leaves the singer out (to compare).
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/bar_band.jo'

index = clamp(to_int(env("BAR_PIECE") ?? "0") ?? 0, 0, BAR_SET.len() - 1)
from = to_float(env("BAR_FROM") ?? "10") ?? 10.0
seconds = to_float(env("BAR_SECONDS") ?? "30") ?? 30.0
distance = to_float(env("BAR_DISTANCE") ?? "12") ?? 12.0
out_path = env("BAR_OUT") ?? "bar-clip.wav"
voice_on = (env("BAR_VOICE") ?? "1") != "0"
voice_only = env("BAR_VOICE") == "only"

m = BarMusic()
bar_music_load(m, index, from)
m.distance = distance
total = int(seconds * f64(MUSIC_RATE))
mono: f32[]
band_sq = 0.0; voice_sq = 0.0; n = 0
t0 = time()
loop mono.len() < total:
    count = min(512, total - mono.len())
    band = music_render(m.synth, count)
    voice = singer_render(m.singer, band.len())
    if band.len() == 0: break
    loop i in 0..band.len():
        band_sq += band[i] * band[i] * 1.21
        voice_sq += voice[i] * voice[i] * 0.3844
        n += 1
        mono.push(f32(bar_room_sample(m.room, (if voice_only: 0.0 else: band[i] * 1.1) + (if voice_on: voice[i] * 0.62 else: 0.0), m.distance)))
spent = time() - t0
peak = 0.0
loop v in mono: peak = max(peak, abs(f64(v)))
gain = if peak > 0.0: 0.89 / peak else: 1.0
# 16 kHz mono to 48 kHz stereo, by straight lines between samples
stereo: f32[]
loop i in 0..mono.len():
    a = f64(mono[i]) * gain
    b = if i + 1 < mono.len(): f64(mono[i + 1]) * gain else: a
    loop k in 0..3:
        v = f32(a + (b - a) * f64(k) / 3.0)
        stereo.push(v); stereo.push(v)
assert(save_wav(out_path, Sound(stereo)))
print("{MUSIC_PIECES[BAR_SET[index].piece].title}: {f64(mono.len()) / f64(MUSIC_RATE):.1} s from {from:.1} s at {distance:.0} m -> {out_path}")
print("band rms {sqrt(band_sq / f64(max(n, 1))):.4}  voice rms {sqrt(voice_sq / f64(max(n, 1))):.4}  peak {peak:.3}  sung notes {m.singer.notes.len()}  render {spent / seconds * 100.0:.1}% of real time")
