# CPU-only selection/generation probe, offscreen software texture uploads.
# Callgrind 0 vs 360 subtracts identical warmup and preparation. No timings here.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/world_terrain.jo'
use '../src/terrain_lod.jo'
use '../src/render_space.jo'
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_world_terrain()
n = to_int(env("AEGEAN_COST_FRAMES") ?? "360") ?? 360
mainland = env("AEGEAN_COST_MAINLAND") != none
checksum = 0; generated = 0; largest = 0
loop frame in 0..120+n:
    offset = f64(max(0,frame-120))*3.3
    cam = if mainland: vec3(f32(-144000.0+offset),2065,-119000) else: vec3(f32(800.0+offset),100,-3600)
    vp = perspective(62.0*PI/180.0,1280.0/720.0,0.3,world_far(f64(cam.y)))*look_at(cam,cam+vec3(0.8,-0.12,-1),vec3(0,1,0))
    prepare_world_terrain(cam,vp,f64(frame)/60.0)
    loop slot in world_selected:
        edges,mask = world_edge_state(slot)
        checksum += mask+int(edges.x*100.0)
    if frame >= 120:
        generated += world_generated
        largest = max(largest,world_selected.len())
print("frames={n} checksum={checksum} generated={generated} max_selected={largest} cache={world_cache.len()}")
