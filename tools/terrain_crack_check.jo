# Cracks in the new world's ground, in far stills along a flight path.
# The pop check (tools/lod_pop_check.jo) works the drawn ground out on the CPU, at the tiles'
# samples: it cannot see a fault in the shader itself, or at the vertices a tile has between its
# samples along an edge beside finer tiles (src/terrain_lod.jo land_grid_data). In round 7 of the
# canopy a cheaper read of the coarser level's height took the wrong samples at exactly those
# vertices: cracks and a spike in far stills, and every test passed. This one draws: the path
# is flown frame by frame as the game selects and makes its tiles (the pop check's paths, and
# its AEGEAN_POP_PATH), and at a few frames along it the ground alone is drawn, by the game's own
# shaders, over a colour nothing paints. A pixel left that colour is the sky, water beyond the
# land's tiles, or a crack. A crack is a small hole with the ground about it (within CRACK_SPAN
# pixels on all four sides) through which the eye's ray meets land: the ray is followed over the
# land's own heights (new_land_height, the world's curve as the renderer bends it), and must go
# under ground that stands above the sea, within 16 km, by more than the coarser far tiles can
# differ from it. (A thin strip of far water between a near ridge and the land
# beyond it is enclosed too; its rays come down on the sea.) Fails on any crack pixel.
# With the round 7 fault put back it finds 31 to 106 crack pixels on each of the four paths on a
# GPU, and 120 to 516 under software rendering.
# Run with SLOPPY_SOFTWARE=1 (no window, the same shaders on the CPU) or headless on a GPU.
# AEGEAN_CRACK_STILLS="480 900 ...": the frames drawn. AEGEAN_CRACK_OUT=dir: the stills saved
# there, the cracks marked yellow (enclosed holes over water or beyond the range: blue).
use '../src/geography.jo'
use '../src/world.jo'
use '../src/world_terrain.jo'
use '../src/terrain_lod.jo'
use '../src/terrain.jo'
use '../src/render_space.jo'
use '../src/look.jo'
use '../src/coast_field.jo'
use '../src/crowns.jo'

const W = 640
const H = 360
window("Terrain crack check",W,H)
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_world_terrain()
# (the ground alone: the canopy's sheet is cut through by design)
foliage_off_list = "shells"
world_generate_tiles = 1

start = vec3(-126400,600,-128700)
glide = vec3(-45,-7.2,-29.8)
yaw: f32 = 0.985; pitch: f32 = -0.16
if let path = env("AEGEAN_POP_PATH"):
    w = split(path," ")
    start = vec3(f32(to_float(w[0]) ?? 0.0),f32(to_float(w[1]) ?? 0.0),f32(to_float(w[2]) ?? 0.0))
    glide = vec3(f32(to_float(w[3]) ?? 0.0),f32(to_float(w[4]) ?? 0.0),f32(to_float(w[5]) ?? 0.0))
    yaw = f32(to_float(w[6]) ?? 0.0); pitch = f32(to_float(w[7]) ?? 0.0)
forward = vec3(-sin(yaw)*cos(pitch),sin(pitch),-cos(yaw)*cos(pitch))
orbit_mode = false
orbit_center = vec3(0,0,0)
orbit_radius: f32 = 0.0
orbit_secs: f64 = 24.0
orbit_pitch: f32 = -0.08
if let orb = env("AEGEAN_POP_ORBIT"):
    w = split(orb," ")
    orbit_mode = true
    orbit_center = vec3(f32(to_float(w[0]) ?? 0.0),f32(to_float(w[1]) ?? 0.0),f32(to_float(w[2]) ?? 0.0))
    orbit_radius = f32(to_float(w[3]) ?? 28.0)
    orbit_secs = to_float(w[4]) ?? 24.0
    if w.len() >= 6: orbit_pitch = f32(to_float(w[5]) ?? -0.08)

camera_at = (f: int) -> (vec3,vec3):
    t = f64(f)/60.0
    if orbit_mode:
        ang = f32(t/orbit_secs*TAU)
        if orbit_radius > 0.0:
            eye = vec3(orbit_center.x+cos(ang)*orbit_radius,orbit_center.y,orbit_center.z+sin(ang)*orbit_radius)
            return (eye,normalize(orbit_center-eye))
        ofwd = vec3(-sin(ang)*cos(orbit_pitch),sin(orbit_pitch),-cos(ang)*cos(orbit_pitch))
        return (orbit_center,ofwd)
    (start+glide*(f32(f)/60.0),forward)
stills: int[] = [480,900,1320,1740,2160]
if let given = env("AEGEAN_CRACK_STILLS"): stills = [loop word in split(given," "): to_int(word) ?? 0]
out_dir = env("AEGEAN_CRACK_OUT") ?? ""

# (the colour nothing paints, and how wide an enclosed hole may be and still be a crack: wider,
# it is water beyond the land's tiles)
const CLEAR = vec4(1,0,1,1)
const CRACK_SPAN = 40
# (how far the ray is followed: beyond, a tile's samples are hundreds of metres apart and a far
# shore is not where the land's own heights have it)
const CRACK_RANGE = 16000.0

# Whether the eye's ray through a pixel meets land: goes under ground that stands above the sea,
# within CRACK_RANGE, by more than a far tile's coarser shape can differ from the land's own
# (3 m and four thousandths of the distance: about two pixels).
ray_meets_land = (eye: vec3,fwd: vec3,x: int,y: int) -> bool:
    right = normalize(cross(fwd,vec3(0,1,0)))
    up = cross(right,fwd)
    tanv: f32 = 0.6009
    dir = normalize(fwd+right*((f32(x)+0.5)/f32(W)*2.0-1.0)*tanv*f32(W)/f32(H)+up*(1.0-(f32(y)+0.5)/f32(H)*2.0)*tanv)
    t: f32 = 30.0
    loop t < CRACK_RANGE:
        p = eye+dir*t
        # (above every summit and rising: nothing more to meet)
        if p.y > 3200.0 and dir.y >= 0.0: return false
        ground = new_land_height(f64(p.x),f64(p.z))
        drop = f64(world_drop(p.xz-eye.xz))
        if ground > 0.5 and f64(p.y) < ground-drop-3.0-0.004*f64(t): return true
        # (come down on the water: the sea's level there, as the world curves)
        if ground <= 0.5 and f64(p.y) < 0.0-drop: return false
        t += max(8.0,t*0.008)
    false

frame = 0
still = 0
cracked = 0
worst = 0
hidden_total = 0
update = (dt: f64):
    return

draw = ():
    global frame,still,cracked,worst,hidden_total
    # (flown to the still's frame as the game flies: its tiles selected, made and morphed frame by frame)
    loop frame < stills[still]:
        eye,fwd = camera_at(frame)
        vp = perspective(62.0*PI/180.0,f32(W)/f32(H),0.3,world_far(f64(eye.y)))*look_at(eye,eye+fwd,vec3(0,1,0))
        prepare_world_terrain(eye,vp,f64(frame)/60.0)
        frame += 1
    eye,fwd = camera_at(frame)
    clear(CLEAR); hide_sky()
    camera3d(eye,eye+fwd,62.0,0.3,world_far(f64(eye.y)))
    t = f64(frame)/60.0
    draw_custom((): draw_world_terrain(light_at(14.0),t))
    hidden_land = 0
    loop idx in 0..world_selected.len():
        if idx < world_selected_visible.len() and not world_selected_visible[idx]: continue
        tile = world_tiles[world_selected[idx]]
        if tile.high > 0.0 and not world_tile_drawable(tile,eye): hidden_land += 1
    hidden_total += hidden_land
    img = screenshot()
    open: bool[] = [loop k in 0..W*H: img.pixels[k*4] == u8(255) and img.pixels[k*4+1] == u8(0) and img.pixels[k*4+2] == u8(255)]
    drawn = 0
    loop k in 0..W*H:
        if not open[k]: drawn += 1
    # (a crack: an open pixel with the ground within CRACK_SPAN pixels of it on both sides,
    # along its row and along its column)
    cracks = 0
    enclosed = 0
    marked = img
    loop y in 0..H:
        loop x in 0..W:
            if not open[y*W+x]: continue
            left = false; right = false; above = false; below = false
            loop d in 1..CRACK_SPAN+1:
                if x-d >= 0 and not open[y*W+x-d]: left = true
                if x+d < W and not open[y*W+x+d]: right = true
                if y-d >= 0 and not open[(y-d)*W+x]: above = true
                if y+d < H and not open[(y+d)*W+x]: below = true
            if left and right and above and below:
                k = (y*W+x)*4
                if ray_meets_land(eye,fwd,x,y):
                    cracks += 1
                    marked.pixels[k] = u8(255); marked.pixels[k+1] = u8(255); marked.pixels[k+2] = u8(0)
                else:
                    enclosed += 1
                    marked.pixels[k] = u8(0); marked.pixels[k+1] = u8(0); marked.pixels[k+2] = u8(255)
    print("TERRAIN CRACKS frame={frame} eye={eye.x:.0} {eye.y:.0} {eye.z:.0} tiles={world_selected.len()} ground_pixels={drawn} enclosed_water_pixels={enclosed} crack_pixels={cracks} hidden_land={hidden_land}")
    if out_dir != "": _ = save_png("{out_dir}/still-{frame}.png",marked)
    cracked += cracks; worst = max(worst,cracks)
    # (a still with no ground in it checks nothing)
    assert(drawn > W*H/8,"the still at frame {frame} shows too little ground to check")
    still += 1; frame += 1
    if still >= stills.len():
        if cracked > 0 or hidden_total > 0:
            print("TERRAIN CRACKS FAIL {cracked} crack pixels, {hidden_total} hidden land tiles in {stills.len()} stills (at most {worst} cracks in one)")
            exit(1)
        print("TERRAIN CRACKS PASS stills={stills.len()} crack_pixels=0 hidden_land=0")
        exit(0)
