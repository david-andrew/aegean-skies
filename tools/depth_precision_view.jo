# Actual coarse-triangle depth ordering fixture. The two surfaces use opposite
# diagonals and vary 4:1 in view depth. Correct perspective fragment depth must
# keep the near green surface in front regardless of submission order or origin.
use '../src/depth_space.jo'
use '../src/render_space.jo'
struct DepthVertex:
    pos:vec3
    color:vec4
struct DepthUniform:
    projection:mat4
struct DepthOut:
    pos:vec4
    color:vec4
probe_vs=(v:DepthVertex,u:DepthUniform)->DepthOut:DepthOut(u.projection*vec4(v.pos,1),v.color)
probe_fs=(i:DepthOut,u:DepthUniform)->vec4:i.color
enable_world_depth()
prog=make_world_shader(shader(probe_vs,probe_fs))
distance=to_float(env("DEPTH_DISTANCE")??"10000")??10000.0
gap=to_float(env("DEPTH_GAP")??"0.5")??0.5
origin=to_float(env("DEPTH_ORIGIN")??"0")??0.0
origin_z=0.0
if let at=env("DEPTH_AT"):
    xy=at.split(" ");origin=to_float(xy[0])??0.0;origin_z=to_float(xy[1])??0.0
build=(offset:f64,color:vec4,reverse:bool)->Mesh:
    vs:DepthVertex[]
    coords=[vec2(-0.9,-0.9),vec2(0.9,-0.9),vec2(0.9,0.9),vec2(-0.9,0.9)]
    depths=[0.5,0.8,2.0,0.8]
    ids=if reverse:[0,1,3,1,2,3] else:[0,1,2,0,2,3]
    loop id in ids:
        d=distance*depths[id]+offset
        # Subtract the geographic anchor in f64 before upload.
        x=origin+f64(coords[id].x)*d
        vs.push(DepthVertex(vec3(f32(x-origin),f32(f64(coords[id].y)*d),f32((origin_z-d)-origin_z)),color))
    mesh(vs)
a=build(0,vec4(0,1,0,1),false)
b=build(gap,vec4(1,0,0,1),true)
draw=():
    clear(BLACK)
    hide_sky()
    camera3d(vec3(0,0,0),vec3(0,0,-1),90,0.035,1048575)
    draw_custom(():
        # Equal-depth samples overwrite on purpose, exposing quantization.
        clear_world_depth()
        glDisable(GL_CULL_FACE)
        u=DepthUniform(perspective(PI/2.0,1,0.035,1048575))
        draw_world(prog,a,u)
        draw_world(prog,b,u))
