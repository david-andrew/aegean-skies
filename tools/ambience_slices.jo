# Times every piece of making the ambience after the first frame (src/ambience.jo
# ambience_build_piece): by kind of piece, the median, 95th and 99th percentiles and the longest,
# the slowest pieces with what they were, and the frames the game would see at its budget.
# Wall-clock: run it on the quiet laptop (a release build copied there), not a shared desktop.
#   sloppy build tools/ambience_slices.jo --release -o slices   (AMBIENCE_BUDGET_MS, default 3)
use '../src/ambience.jo'
use '../src/ambience_synth.jo'
use '../src/ambience_crowd.jo'

NAMES = ["sound","finish","half-rate copy","muffled copy","next begun"]
budget = to_float(env("AMBIENCE_BUDGET_MS") ?? "") ?? 3.0
a = Ambience(active = true,playback = true)
ambience_build_later(a)
times: f64[]; makings: int[]; stages: int[]; what: str[]
loop a.next_kind < AMBIENCE_KINDS:
    kind = AMBIENCE_BUILD_ORDER[a.next_kind]
    label = "{str(kind)} take {a.next_take} {NAMES[a.making]}"
    makings.push(a.making); stages.push(if a.making == 0 and a.build.crowded: a.build.crowd.stage else: -1); what.push(label)
    began = time()
    ambience_build_piece(a)
    times.push((time()-began)*1000.0)
total = 0.0
loop v in times: total += v
print("{times.len()} pieces, {total:.0} ms in all")
loop m in 0..5:
    loop st in -1..CROWD_MADE:
        mine = [loop j in 0..times.len() if makings[j] == m and stages[j] == st: times[j]]
        if mine.len() == 0: continue
        mine.sort()
        print("{NAMES[m]}{if st >= 0: " (crowd stage {st})" else: ""}: {mine.len()} pieces, median {mine[mine.len()/2]:.3} ms, p95 {mine[mine.len()*95/100]:.3} ms, p99 {mine[mine.len()*99/100]:.3} ms, longest {mine[mine.len()-1]:.3} ms")
order = [loop j in 0..times.len(): j]
order.sort((j: int) -> f64: -times[j])
loop q in 0..min(8,order.len()): print("  {times[order[q]]:.2} ms  {what[order[q]]}")
# the frames the game would see: pieces until the budget is passed (at least one a frame)
frames = 0; worst = 0.0; i = 0
loop i < times.len():
    sum = 0.0
    loop i < times.len():
        sum += times[i]; i += 1
        if sum >= budget: break
    frames += 1; worst = max(worst,sum)
print("at {budget:.1} ms a frame: {frames} frames, the longest {worst:.2} ms")
