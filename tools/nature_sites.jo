# Deterministic capture sites on the unchanged original island geometry.
use '../src/world.jo'
use '../src/plants.jo'
assert(load_land(embed('../assets/terrain.bin')))
best_bay = -1.0; bay = vec2(0,0); bay_out = vec2(0,1)
best_cliff = -1.0; cliff = vec3(0,0,0); cliff_out = vec2(0,1)
best_olive = -1.0; olive = vec3(0,0,0)
loop island in 0..ISLANDS.len():
    loop k in 0..72:
        coast,out = coast_point(island,f64(k)*TAU/72.0)
        loop d in [20.0,45.0,80.0]:
            q = coast+out*f32(d)
            depth = -height(f64(q.x),f64(q.y))
            if depth > 1.0 and depth < 9.0:
                enclosed = 0.0
                loop delta in [vec2(140,0),vec2(-140,0),vec2(0,140),vec2(0,-140)]:
                    h = height(f64(q.x+delta.x),f64(q.y+delta.y))
                    if h > -2.0: enclosed += 1.0
                score = enclosed-abs(depth-4.0)*0.04
                if score > best_bay: best_bay = score; bay = q; bay_out = out
        loop d in [15.0,30.0,50.0,80.0]:
            q = coast-out*f32(d)
            h = surface_height(f64(q.x),f64(q.y)); sl = slope_at(f64(q.x),f64(q.y))
            if h > 12.0 and h < 220.0:
                score = 1.0-abs(sl-1.4)
                if score > best_cliff: best_cliff = score; cliff = vec3(q.x,f32(h),q.y); cliff_out = out
    isl = ISLANDS[island]
    loop z in -12..13:
        loop x in -12..13:
            p = isl.center+vec2(f32(x),f32(z))*45.0
            h = surface_height(f64(p.x),f64(p.y)); sl = slope_at(f64(p.x),f64(p.y))
            cover = f64(orchard_cover(p,f32(h),f32(sl)))
            score = cover+fbm(f64(p.x)*0.006+isl.seed*3.0,f64(p.y)*0.006,3)*0.4
            if cover > 0.75 and sl > 0.12 and sl < 0.35 and score > best_olive: best_olive = score; olive = vec3(p.x,f32(h),p.y)
print("cove air: {bay.x+bay_out.x*100.0} 70 {bay.y+bay_out.y*100.0} {atan2(f64(bay_out.x),f64(bay_out.y))} -0.5 14")
print("cove water: {bay.x+bay_out.x*12.0} 1.8 {bay.y+bay_out.y*12.0} {atan2(f64(bay_out.x),f64(bay_out.y))} -0.12 14")
print("cliff: {cliff.x+cliff_out.x*65.0} {cliff.y+18.0} {cliff.z+cliff_out.y*65.0} {atan2(f64(cliff_out.x),f64(cliff_out.y))} -0.27 14")
print("olive: {olive.x} {olive.y+32.0} {olive.z+95.0} 0 -0.25 14")
print("cove score={best_bay}, cliff score={best_cliff}, olive score={best_olive}")
