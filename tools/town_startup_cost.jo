# Run on redfox under the shared benchmark lock, one worker.
use '../src/world_towns.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
t = time()
init_settlements(false)
print("places memory={memory_in_use()} bytes: {time()-t:.3}s count={world_settlements.len()}")
t = time()
build_settlement_roads()
points = 0
loop r in settlement_roads: points += r.points.len()
print("roads memory={memory_in_use()} bytes: {time()-t:.3}s roads={settlement_roads.len()} points={points}")
t = time()
index_settlement_roads()
print("road index memory={memory_in_use()} bytes: {time()-t:.3}s bins={settlement_road_bins.len()}")
t = time()
far = [loop s in world_settlements: build_far_town(s)]
print("far parcels memory={memory_in_use()} bytes: {time()-t:.3}s")
