# The townsfolk in a row on a quay, for looking at them: sloppy tools/folkview.jo
use '../src/look.jo'
use '../src/sky.jo'
use '../src/objects.jo'
use '../src/folk.jo'

window("Folk", 1280, 720)
init_sky(); init_objects()
kinds: Dress[] = [.fisher, .merchant, .pilot, .police, .dress, .widow, .worker, .fisher, .dress, .merchant]
figs = [loop k in 0..kinds.len(): build_figure(kinds[k], k * 3 + 1)]
floor_m = custom_mesh((): 
    vs: Vertex3D[]
    add_box(vs, vec3(0, -0.5, 0), vec3(30, 1, 6), rgb(0.78, 0.74, 0.66))
    vs
())
t = 0.0
update = (dt: f64): t += dt
draw = ():
    L = light_at(15.0)
    clear(BLACK)
    hide_sky()
    camera3d(vec3(2, 2.2, -9), vec3(0, 1.0, 0), 50.0, 0.1, 5000.0)
    draw_custom((): draw_sky(L, t))
    draw_custom(():
        draw(obj_sh, floor_m, obj_params(L, t))
        loop k in 0..figs.len():
            draw_figure(figs[k], vec3(f32(-6.75 + f64(k) * 1.5), 0, 0), PI + 0.3 * f64(k % 3) - 0.3, t * 6.0 + f64(k), f64(k % 2), L, t, if k == 2: 1.0 else: 0.0)
    )
