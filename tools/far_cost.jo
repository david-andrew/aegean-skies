# Run on redfox only under bench.lock. This measures complete minute rules, no renderer.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_sim.jo'
use '../src/living_guard.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true; init_settlements()
set_living_strict(false)
loop far in [false,true]:
    w = build_world(u64(42)); publish_settlement_life(w)
    if far: assert(configure_far_economy(w))
    measurements: f64[]; total = 0.0
    loop _ in 0..600:
        started = time(); step_minute(w); duration = (time()-started)*1000.0
        measurements.push(duration); total += duration
    measurements.sort()
    print("FAR_MINUTE far={far} mean_ms={total/600.0:.4} p95_ms={measurements[570]:.4} max_ms={measurements[599]:.4} places={w.far.place_ids.len()} journeys={w.far.completed_journeys} faults={living_faults().len()} recovery=true ticks=600")
