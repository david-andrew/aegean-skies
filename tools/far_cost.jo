# Run on redfox only under bench.lock. This measures complete minute rules, no renderer.
build:
    name = "worldlog"

use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_sim.jo'
use '../src/living_guard.jo'
use '../src/living_save.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true; init_settlements(); finish_settlement_registry()
set_living_strict(false)
loop label in ["core","opening","mature"]:
    w = build_world(u64(42)); publish_settlement_life(w)
    if label!="core": assert(configure_far_economy(w) and configure_far_harbors(w))
    if label=="mature":
        source=env("WORLD_SOURCE") ?? "phase4-month-v6"
        saved=load_game(42,source)
        assert(saved is SaveGame,"Missing actual worldlog checkpoint for mature cost fixture")
        w=saved.world
    measurements: f64[]; total = 0.0
    loop _ in 0..600:
        started = time(); step_minute(w); duration = (time()-started)*1000.0
        measurements.push(duration); total += duration
    measurements.sort()
    print("FAR_MINUTE case={label} mean_ms={total/600.0:.4} p95_ms={measurements[570]:.4} max_ms={measurements[599]:.4} places={w.far.place_ids.len()} journeys={w.far.completed_journeys} faults={living_faults().len()} recovery=true ticks=600")
