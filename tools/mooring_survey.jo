# Offshore moorings for every sea harbour, for the big boats' swing radii: how many, how far from
# the docks, how sheltered, how long the search took, each re-checked by verify_mooring.
# Usage: sloppy --release tools/mooring_survey.jo OUT.txt [ID,ID...|legacy|all]
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/offshore_moorings.jo'
from '../src/planes.jo' import Craft, CRAFT_NAMES
from '../src/aircraft_boats.jo' import swing_radius, offshore_only, big_boat

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
scope=if args().len()>2:args()[2] else:"all"
wanted:{int:bool}
if scope!="all" and scope!="legacy":
    loop part in split(scope,","):wanted[to_int(part)!]=true
kinds=[loop k in 0..CRAFT_NAMES.len():Craft(k)]
radii:f64[]
names:str[]
loop k in kinds:
    if big_boat(k) and offshore_only(k):radii.push(swing_radius(k));names.push(CRAFT_NAMES[int(k)])
text="# offshore moorings: radii {radii}\n"
harbours=0;none_found=[0,0,0,0,0,0];bad=0;slowest=0.0;total_time=0.0
loop s in world_settlements:
    if s.harbor.len()==0 or abs(f64(s.harbor[0].at.y))>0.5:continue
    if scope=="legacy" and s.legacy<0:continue
    if scope!="all" and scope!="legacy" and not (s.id in wanted):continue
    harbours+=1
    loop i in 0..radii.len():
        started=time()
        ms=offshore_moorings(s.id,radii[i])
        took=f64(time()-started);total_time+=took;slowest=max(slowest,took)
        if ms.len()==0:none_found[i]+=1
        line="{s.id}|{s.name}|{names[i]}|{ms.len()}|{took*1000.0:.0} ms"
        loop m in ms:
            v=verify_mooring(m)
            if v!="":bad+=1
            line+="|{m.at.x:.0},{m.at.z:.0} {length(m.at.xz-m.dock.xz):.0} m shelter {m.shelter:.2}{if v!="":" BAD "+v else:""}"
        text+=line+"\n"
summary="MOORINGS {harbours} harbours; none for {names}: {none_found[0..radii.len()]}; failed checks {bad}; search {total_time:.1} s, slowest {slowest*1000.0:.0} ms"
text+="# "+summary+"\n"
assert(write_file(args()[1],text))
print(summary)
