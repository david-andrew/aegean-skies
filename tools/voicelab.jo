# Offline announcer renderer and cost check. Never opens a window or plays audio.
#   VOICE_TEXTS=lines.txt VOICE_DIR=/abs/scratch sloppy --release tools/voicelab.jo
# Each line of VOICE_TEXTS is "name|text". For each: name-dry.wav (the vocoder alone) and, unless
# VOICE_DRY_ONLY=1, name-strong/-medium/-weak.wav through the station leveller and the receiver
# chain. VOICE_SPEED, VOICE_PITCH (semitones), VOICE_POST (cepstral emphasis) tune the delivery.
# Without VOICE_DIR it only measures planning and synthesis time per second of speech.
use '../src/voice_text.jo'
use '../src/voice_synth.jo'
use '../src/radio_chain.jo'
use '../src/radio_station.jo'
use '../src/radio.jo'

dir = env("VOICE_DIR") ?? ""
speed = to_float(env("VOICE_SPEED") ?? "1.0") ?? 1.0
pitch = to_float(env("VOICE_PITCH") ?? "0") ?? 0.0
post = to_float(env("VOICE_POST") ?? "0") ?? 0.0
coda = to_float(env("VOICE_CODA") ?? "1") ?? 1.0
pauses = to_float(env("VOICE_PAUSES") ?? "1") ?? 1.0
out_level = to_float(env("VOICE_LEVEL") ?? "0") ?? 0.0
dry_only = (env("VOICE_DRY_ONLY") ?? "") == "1"
lines_path = env("VOICE_TEXTS") ?? ""

texts: str[]
names: str[]
if lines_path != "":
    file = read_file(lines_path)
    if file is str:
        loop line in lines(file):
            if trim(line) == "": continue
            parts = split(line,"|",1)
            names.push(trim(parts[0])); texts.push(trim(parts[1]))
if texts.len() == 0:
    names.push("weather"); texts.push("Good evening. Here is the weather for the islands. The wind is from the south at seven metres per second, with fair conditions.")

save16 = (path: str, samples: f64[]):
    # Linear 16 -> 48 kHz for the engine's stereo WAV writer.
    stereo = fill(f32(0),samples.len()*6)
    loop i in 0..samples.len()*3:
        at = i/3; blend = f64(i%3)/3.0
        v = samples[at]*(1.0-blend)+samples[min(at+1,samples.len()-1)]*blend
        stereo[i*2] = f32(clamp(v,-0.99,0.99)); stereo[i*2+1] = stereo[i*2]
    assert(save_wav(path,Sound(stereo)))

load_start = time_ns()
bank = voice_load()
if not bank.ready:
    eprint("no announcer data: set AEGEAN_VOICE_DATA to the announcer file (kept outside the repository)")
    exit(1)
print("bank load ms={f64(time_ns()-load_start)/1e6:.2} units={bank.units.len()} words={bank.words.len()}")
synth = make_voice_synth(bank)
synth.postfilter = post
if out_level > 0: synth.level = out_level
synth.breath = to_float(env("VOICE_BREATH") ?? "1") ?? 1.0
style = VoiceStyle(speed=speed,pitch=pitch,coda=coda,pauses=pauses)
station = to_int(env("VOICE_STATION") ?? "-1") ?? -1
if station >= 0: style = radio_voice_style(station,.news)
# VOICE_INPUT=a.wav sends a recording through the same station and receiver instead (scratch
# comparisons only); its name is "input".
input_path = env("VOICE_INPUT") ?? ""
total_plan = 0.0; total_synth = 0.0; total_seconds = 0.0; worst_block = 0.0
loop t in 0..texts.len():
    begin = time_ns()
    plan = voice_plan(bank,texts[t],style,t)
    total_plan += f64(time_ns()-begin)/1e6
    voice_start(synth,plan,0,t)
    samples: f64[]
    if input_path != "":
        names[t] = "input"
        bytes = read_bytes(input_path)
        if bytes is u8[]:
            sound = load_wav(bytes)
            if sound is Sound:
                loop i in 0..sound.samples.len()/6:
                    samples.push((f64(sound.samples[i*6])+f64(sound.samples[i*6+2])+f64(sound.samples[i*6+4]))/3.0)
    else:
        loop not voice_done(synth):
            b0 = time_ns()
            block = voice_render(synth,800)
            ms = f64(time_ns()-b0)/1e6
            total_synth += ms; worst_block = max(worst_block,ms)
            samples += block
        total_seconds += plan.seconds
    peak = 0.0; energy = 0.0
    loop v in samples: peak = max(peak,abs(v)); energy += v*v
    print("{names[t]} seconds={plan.seconds:.2} phones={plan.phones.len()} peak={peak:.3} rms={sqrt(energy/f64(max(1,samples.len()))):.4}")
    if dir == "": continue
    save16(dir+"/"+names[t]+"-dry.wav",samples)
    if (env("VOICE_DUMP") ?? "") == "1":
        assert(write_file(dir+"/"+names[t]+"-f0.txt",join([loop v in plan.f0: "{v:.3}"],"\n")))
    if dry_only: continue
    strengths = [1.0,0.45,0.2]
    labels = ["strong","medium","weak"]
    loop k in 0..3:
        chain = make_radio_chain(t,0)
        level = StationLevel()
        lead = int(0.6*f64(VOICE_RATE))
        out = fill(0.0,samples.len()+2*lead)
        loop i in 0..out.len():
            source = if i >= lead and i < lead+samples.len(): samples[i-lead] else: 0.0
            out[i] = radio_chain_sample(chain,station_level(level,source),strengths[k],0.0,0.0,0.0)
        save16(dir+"/"+names[t]+"-"+labels[k]+".wav",out)
print("plan_ms_per_speech_second={total_plan/max(0.001,total_seconds):.3} synth_ms_per_speech_second={total_synth/max(0.001,total_seconds):.3} worst_50ms_block_ms={worst_block:.3}")
