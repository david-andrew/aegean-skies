# Points along every catalogue road and track near a settlement lake, binned by
# 64 m. Shoreline shaping keeps clear of them, so a cove never floods a road.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/lake_data.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements(true)
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
bins:{int:vec2[]}
count=0
# Both the surveyed tracks and the planned road lines they were repaired from.
lines=[loop link in catalog.links:if link.mode==.cart:link.points]
loop road in settlement_roads:
    if road.points.len()>1:lines.push(road.points)
loop line in lines:
    loop k in 1..line.len():
        a=line[k-1].xz;b=line[k].xz;n=max(1,int(ceil(f64(length(b-a))/20.0)))
        loop j in 0..n+1:
            p=mix(a,b,f32(j)/f32(n))
            near=false
            loop lake in SETTLEMENT_LAKES:
                if p.x>lake.bounds.x-200 and p.y>lake.bounds.y-200 and p.x<lake.bounds.z+200 and p.y<lake.bounds.w+200:near=true
            if not near:continue
            key=int(floor(f64(p.x)/64.0))*65536+int(floor(f64(p.y)/64.0))
            list=bins.get(key,[]);list.push(p);bins[key]=list;count+=1
source="# Road points near settlement lakes, by 64 m bin (tools/bake_lake_road_guard.jo).\nLAKE_ROAD_GUARD:{{int:vec2[]}}={{\n"
keys=bins.keys();keys.sort()
loop key in keys:
    source+="    {key}:["
    loop p in bins[key]:source+="vec2({p.x},{p.y}),"
    source+="],\n"
source+="}}\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/lake_road_guard_data.jo'),source))
print("LAKE ROAD GUARD {count} points in {keys.len()} bins")
