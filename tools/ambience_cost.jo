# Silent, deterministic adapter workload. Time only on the quiet laptop under its lock.
# Desktop: use instruction counts, or run without AMBIENCE_TIMING for functional bounds.
use '../src/ambience_scene.jo'
use '../src/ambience.jo'
use '../src/ambience_synth.jo'
use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/world.jo'
use '../src/vessel_types.jo'
import '../src/living_seed.jo' as seed
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_settlements(false)
w = seed.build_world()
# Exercise a detailed capital, including parcel roof and collision-footprint queries.
index = -1
loop k in 0..world_settlements.len():
    if world_settlements[k].kind == .capital: index = k; break
assert(index >= 0)
s = world_settlements[index]
scene = AmbienceScene(sound=Ambience(active=true))
fleet = VesselFleet()
samples: f64[]
max_loops = 0; max_pending = 0
loop frame in 0..600:
    w.tick += 1; w.minute = w.tick/120
    # On foot through a square, then a fast low pass; forces geometry cache refreshes.
    x = if frame < 300: f64(frame)*0.04 else: f64(frame-300)*3.0
    ear = s.center+vec3(f32(x),if frame < 300: 2 else: 45,0)
    begin = time()
    ambience_scene_step(scene,w,fleet,[],[],ear,1.0/60,frame>=300,vec3(3,0,6))
    samples.push((time()-begin)*1000)
    max_loops = max(max_loops,scene.sound.sources.len()); max_pending = max(max_pending,scene.sound.pending.len())
assert(max_loops <= AMBIENCE_LOOPS and max_pending <= AMBIENCE_PENDING)
print("functional_frames=600 max_sources={max_loops} max_pending={max_pending} registry={world_settlements.len()}")
if env("AMBIENCE_TIMING") != none:
    sum = 0.0
    loop v in samples: sum += v
    samples.sort()
    print("adapter_mean_ms={sum/f64(samples.len()):.6} p99_ms={samples[samples.len()*99/100]:.6} max_ms={samples[samples.len()-1]:.6}")
