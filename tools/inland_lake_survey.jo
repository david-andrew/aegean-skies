# Offline survey of modest basins beside existing towns; does not edit terrain.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
survey_links=catalog.links

struct LakeSurvey:
    center:vec2
    axis:vec2
    level:f64
    score:f64
    cut:f64
    fill:f64

const LAKE_HALF_LENGTH = 900.0
const LAKE_HALF_WIDTH = 320.0
survey_local=(p:vec2,center:vec2,axis:vec2)->vec2:
    d=p-center
    vec2(dot(d,axis)/f32(LAKE_HALF_LENGTH),dot(d,vec2(-axis.y,axis.x))/f32(LAKE_HALF_WIDTH))
survey_spot=(center:vec2,axis:vec2,q:vec2)->vec2:center+axis*q.x*f32(LAKE_HALF_LENGTH)+vec2(-axis.y,axis.x)*q.y*f32(LAKE_HALF_WIDTH)
survey_free=(center:vec2,axis:vec2)->bool:
    loop s in world_settlements:
        if length(s.center.xz-center)>f32(s.radius+1600.0):continue
        loop k in 0..16:
            angle=f64(k)*TAU/16.0
            p=s.center.xz+vec2(f32(cos(angle)),f32(sin(angle)))*f32(s.radius+80.0)
            if length(survey_local(p,center,axis))<1.4:return false
    loop link in survey_links:
        if link.mode!=.cart:continue
        loop k in 1..link.points.len():
            a=survey_local(link.points[k-1].xz,center,axis);b=survey_local(link.points[k].xz,center,axis);d=b-a
            u=clamp(-dot(a,d)/max(dot(d,d),0.00001),0.0,1.0)
            if length(a+d*u)<1.4:return false
    true

loop s in world_settlements:
    if s.harbor.len()>0 or s.size<100:continue
    best=LakeSurvey(vec2(0,0),vec2(1,0),0,1e30,0,0);accepted=0
    loop distance in [900.0,1200.0,1500.0,1900.0,2400.0]:
        loop k in 0..16:
            bearing=f64(k)*TAU/16.0
            center=s.center.xz+vec2(f32(cos(bearing)),f32(sin(bearing)))*f32(distance)
            loop direction in 0..8:
                angle=f64(direction)*PI/8.0;axis=vec2(f32(cos(angle)),f32(sin(angle)))
                if not survey_free(center,axis):continue
                low=1e9;high = -1e9;dry=true
                loop j in 0..24:
                    a=f64(j)*TAU/24.0
                    p=survey_spot(center,axis,vec2(f32(cos(a)*1.2),f32(sin(a)*1.2)))
                    h=place_ground(p);low=min(low,h);high=max(high,h)
                    if h<8.0:dry=false
                if not dry or high-low>35.0:continue
                level=low-0.75;cut=0.0;fill=0.0;volume=0.0;count=0
                loop j in -3..4:
                    loop i in -5..6:
                        q=vec2(f32(i)*0.16,f32(j)*0.25)
                        if length(q)>0.85:continue
                        h=place_ground(survey_spot(center,axis,q));delta=h-(level-5.0)
                        cut=max(cut,delta);fill=max(fill,-delta);volume+=abs(delta);count+=1
                if cut>20.0 or fill>14.0:continue
                score=volume/f64(count)+(high-low)*0.3+distance*0.0015+cut*0.15
                accepted+=1
                if score<best.score:best=LakeSurvey(center,axis,level,score,cut,fill)
    if accepted==0:print("NO_SITE|{s.id}|{s.name}");continue
    print("LAKE|{s.id}|{s.name}|{best.center.x}|{best.center.y}|{best.level}|{best.axis.x}|{best.axis.y}|{LAKE_HALF_LENGTH}|{LAKE_HALF_WIDTH}|{best.cut}|{best.fill}|{best.score}|{accepted}")
