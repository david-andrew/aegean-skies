use '../src/music_data.jo'
use '../src/music_audition.jo'
use '../src/music_synth.jo'
use '../src/radio_synth.jo'
use '../src/title_music.jo'

# File-only timing of the title's cue as the game plays it (receiver, hall, level curve): the cost
# of each 50 ms block (800 samples), over the whole cue, three passes. Wall-clock: redfox under
# bench.lock, or the test phone (built --target wasm). Prints, no audio device.
loop round in 0..3:
    a = make_title_music()
    begin = time_ns()
    music_audition_program(a)
    setup = f64(time_ns()-begin)/1e6
    costs: f64[]
    total = 0.0; worst_at = 0.0; worst = 0.0; energy = 0.0
    loop:
        start = time_ns()
        block = music_audition_render(a,800)
        ms = f64(time_ns()-start)/1e6
        if block.len() == 0: break
        if ms > worst: worst = ms; worst_at = f64(a.synth.music.cursor)/f64(MUSIC_RATE)
        costs.push(ms); total += ms
        loop v in block: energy += f64(v)*f64(v)
    n = costs.len()
    late = [loop k in 0..n: if k >= n*2/3: costs[k]]
    costs.sort(); late.sort()
    print("BUDGET pass={round} piece={a.piece} blocks={n} setup_ms={setup:.3} mean_ms={total/f64(n):.4} p50_ms={costs[n/2]:.4} p95_ms={costs[n*95/100]:.4} p99_ms={costs[n*99/100]:.4} max_ms={worst:.4} max_at_s={worst_at:.1} last_third_p50_ms={late[late.len()/2]:.4} last_third_p95_ms={late[late.len()*95/100]:.4} stolen={a.synth.music.stolen} energy={energy:.6}")
print("DONE")
