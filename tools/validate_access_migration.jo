# Exercise a real previous catalogue against the current one, including every
# saved edge. The old file stays in scratch; no second world asset is shipped.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_seed.jo'
use '../src/life_types.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_people.jo'
use '../src/living_place_context.jo'
use '../src/living_relocation.jo'
use '../src/living_save.jo'
use '../src/living_money.jo'
use '../src/far_scene.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
bytes=read_bytes(args()[1]);assert(bytes is u8[])
inflated=inflate(bytes);assert(inflated!=none)
old=from_text[FarRouteCatalog](str_from_bytes(inflated!));assert(old is FarRouteCatalog)
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
fresh=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(fresh is FarRouteCatalog)
w=build_world(u64(12345));contexts:LifePlaceContext[]
loop s in world_settlements:
    contexts.push(LifePlaceContext(s.id,s.name,s.country,s.seed,s.center,s.harbor.len()>0,s.legacy))
assert(publish_place_contexts(w,SETTLEMENT_VERSION,contexts,[-1,-1,-1]))
assert(populate_settlement_economy(w,old.version,old.seeds,old.links))
loop id in [111289,131012]:assert(promote_far_person(w,id,.farmer)>=0)
population=far_population(w);accounts=hash(w.accounts);stock=stock_totals(w);people=w.people.len();ledger=hash(w.ledger)
missing=0
loop link in old.links:
    pair=layout_pair(link.a,link.b,link.mode);found=false
    loop current in fresh.links:
        if layout_pair(current.a,current.b,current.mode)==pair:found=true;break
    if found:continue
    route=layout_route(fresh.links,link.a,link.b,link.mode)
    print("REPLACEMENT {link.id} {link.a}/{link.b} {link.mode}: {route.len()} points")
    if route.len()<2:missing+=1
assert(missing==0,"{missing} saved routes have no verified replacement")
assert(configure_far_economy(w))
assert(population==far_population(w) and accounts==hash(w.accounts) and stock==stock_totals(w) and people==w.people.len() and ledger==hash(w.ledger))
assert(w.far.links.len()>=old.links.len())
loop i in 0..old.links.len():assert(w.far.links[i].id==old.links[i].id and w.far.links[i].a==old.links[i].a and w.far.links[i].b==old.links[i].b)
loop id in [111289,131012]:
    assert(w.far.relocated_centers[id]==world_settlements[settlement_by_id[id]].center)
    loop person in w.far.districts[id].named:
        assert(w.people[person].far_home==id)
        assert(length(w.people[person].pose.pos-w.far.relocated_centers[id])<600)
assert(money_balances(w) and goods_balance(w))
print("SAVE MIGRATION: {old.links.len()} old links preserved; {w.far.links.len()} current links; population, accounts, goods, ledger and identities unchanged")
