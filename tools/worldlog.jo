# Full registry acceptance, including funded commissions, real services and national logistics.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_checks.jo'
use '../src/living_war_checks.jo'
use '../src/living_checks.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true; init_settlements(); finish_settlement_registry()
w=build_world(u64(42)); publish_settlement_life(w)
assert(configure_far_economy(w) and configure_far_harbors(w))
assert(validate_save_world(w)=="")
print("WORLD_OPEN places={w.far.place_ids.len()} harbors={w.far.harbors.len()} population={far_population(w)} links={w.far.links.len()} vehicles={w.far.vehicles.len()}")
days=if let value=env("WORLD_DAYS"): to_int(value) ?? 30 else: 30
loop day in 0..days:
    loop _ in 0..1440:
        step_minute(w)
        if w.minute%360==0:
            errors=invariant_errors(w); assert(errors.len()==0,errors.join("; "))
    text=canonical_text(w); decoded=from_text[World](text)
    assert(decoded is World and canonical_text(decoded)==text and validate_save_world(decoded)=="")
    print("WORLD_DAY {day+1} deliveries={w.far.completed_journeys} moving={w.far.journeys.len()} offers={w.far.commissions.len()} people={w.far.people.len()} units={w.war.units.len()} incidents={w.war.evidence.len()} contacts={w.war.contacts.len()} hungry={[loop _, d in w.far.districts: if d.hunger>=350: d.id].len()} occupied={[loop _, d in w.far.districts: if d.controller!=d.born_country: d.id].len()} refugees={[loop _, j in w.far.journeys: if j.duty==.refugee: j.id].len()} diplomacy={[loop r in w.diplomacy: (r.a,r.b,r.stage,r.tension)]} bytes={text.len()} hash={canonical_hash(w)}")
    w=decoded
    loop u in w.war.units:
        v=w.far.vehicles[u.vehicle]
        print("WORLD_FORCE day={day+1} country={u.country} unit={u.id} hull={v.hull} kind={v.kind} at={v.place} home={u.home} order={u.order} journey={v.journey} supplied={u.supplied_until} stock={u.stock.qty}")
        if u.order>=0:
            o=w.war.orders[u.order]
            print("WORLD_ORDER task={o.task} target={o.target} leg={o.leg}/{o.route.len()} arrived={o.arrived} expires={o.expires}")
