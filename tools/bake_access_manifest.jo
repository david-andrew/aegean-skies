# Derive each settlement's nearest real landing from verified cart links.
# Used by roadside signs and the per-place audit, never a second transport graph.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_purpose.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/landing_access.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
ordered=world_settlements;ordered.sort((s:WorldSettlement):s.id)
assert(catalog.places==hash([loop s in ordered:(s.id,s.center,s.out,s.country)]))
adj:{int:int[]};distance:{int:int};landing:{int:int};next:{int:int};closed:{int:bool};queue:(int,int)[]
loop k in 0..catalog.links.len():
    link=catalog.links[k]
    if link.mode!=.cart:continue
    aa=adj.get(link.a,[]);aa.push(k);adj[link.a]=aa
    bb=adj.get(link.b,[]);bb.push(k);adj[link.b]=bb
loop s in ordered:
    if s.harbor.len()==0:continue
    extra=0
    if s.id in landing_access_ids():
        access=landing_access(s.id)
        loop k in 1..access.route.len():extra+=int(round(f64(length(access.route[k]-access.route[k-1]))*1000))
    distance[s.id]=extra;landing[s.id]=s.id;next[s.id]=s.id;queue.heap_push((extra,s.id))
loop queue.len()>0:
    cost,id=queue.heap_pop()
    if id in closed:continue
    closed[id]=true
    loop k in adj.get(id,[]):
        link=catalog.links[k];other=if link.a==id:link.b else:link.a
        candidate=cost+link.length_mm
        if candidate>=distance.get(other,0x7fffffffffffffff):continue
        distance[other]=candidate;landing[other]=landing[id];next[other]=id
        queue.heap_push((candidate,other))
source="# Derived from verified living cart links by tools/bake_access_manifest.jo.\nstruct InlandAccess:\n    landing:int\n    metres:int\n    next:int\nINLAND_ACCESS:{{int:InlandAccess}}={{\n"
print("| Name | Size | Reason | Access |")
print("| --- | --- | --- | --- |")
loop s in ordered:
    source+="    {s.id}:InlandAccess({landing.get(s.id,-1)},{distance.get(s.id,-1000)/1000},{next.get(s.id,-1)}),\n"
    if s.legacy>=0 or s.kind==.port or s.kind==.capital or s.kind==.fishing or s.kind==.lighthouse:continue
    access="Unresolved: isolated island"
    if s.id in distance:
        port=world_settlements[settlement_by_id[landing[s.id]]]
        label=if s.id==111289 or s.id==131012:"Lake jetty" else:"Coastal landing"
        access=if s.id==port.id:"{label}, {distance[s.id]/1000} m from the square" else:"Road to {port.name}, {f64(distance[s.id])/1000000.0:.1} km"
    print("| {s.name} ({s.id}) | {s.kind}, {max(4,s.size*4)} residents | {settlement_purpose(s).reason} | {access} |")
source+="}\nconst INLAND_ACCESS_CATALOG_KEY:u64={hash(catalog.links)}\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/inland_access_data.jo'),source))
