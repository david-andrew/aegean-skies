# The pause menu's Game page, end to end: the autosave and its quiet "Saved" card, then a save,
# a changed game, a load and a delete, each asked for the way the page asks (a DebugResult through
# debug_apply), with the page's rows and notes checked as it shows them. The pause menu stays open
# on the Game page throughout, so its drawing runs every frame. Run headlessly with an isolated,
# empty SLOPPY_SAVE_DIR.
build:
    name = "Aegean game menu probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/phoenix.jo'
use '../src/game_slots.jo'
use '../src/living_types.jo'
use '../src/debugmenu.jo'
use '../src/settlements.jo'

finish_settlement_registry()
base_update:(f64)->void=game.update
base_draw:()->void=game.draw
stage=0
frames=0
saved_pos=vec3(0,0,0)
saved_cents=0
saved_minute=0

ask = (command: str,slot: int):
    v=game.debug_view()
    game.debug_apply(v,v,DebugResult(game=command,game_slot=slot))

idle = () -> bool: game.game_save_command=="" and not game.game_save_status().busy

update = (dt: f64):
    global stage,frames,saved_pos,saved_cents,saved_minute
    base_update(dt)
    frames+=1
    assert(frames<2400,"Game menu probe did not complete: stage={stage} note={game.game_ui_note} error={game.game_saves.error}")
    if stage==0:
        # the autosave at the starting mooring, and its card
        if game.game_slot_views.len()!=3 or not idle() or not game.game_slot_views[0].exists:return
        assert(game.saved_toast_at>=0.0,"The autosave finished without its Saved card.")
        assert(game.game_ui_note=="","An autosave must not write the menu's note.")
        game.set_paused(true)
        assert(game.dbg.open and game.dbg.page==0,"The pause menu opens on the Game page.")
        v=game.debug_view()
        assert(v.games.len()==3 and v.games[0].exists and v.games[0].autosave and not v.games[1].exists)
        assert(v.autosave_note.contains("slot 1"),v.autosave_note)
        print("GAME_MENU_PROBE autosave slot1: {v.games[0].time} | {v.games[0].place} | {v.games[0].detail}")
        assert(v.games[0].time!="" and v.games[0].detail.contains("¤") and v.games[0].detail.contains("day "),v.games[0].detail)
        # what the save should bring back
        game.debug_cents(game.player_cents()+4321)
        game.presentation.cat_bonds[321]=CatBond(fondness=640,minute=game.living_world.minute,strokes=4)
        game.presentation.battles_seen.push(BattleSighting(88,"Fight off the headland",game.pc.state.position,game.living_world.minute))
        saved_pos=game.me.pos;saved_cents=game.player_cents();saved_minute=game.living_world.minute
        ask("save",1);stage=1
    else if stage==1:
        if not idle() or not game.game_slot_views[1].exists:return
        assert(game.game_ui_note=="Saved in slot 2.",game.game_ui_note)
        v=game.debug_view()
        assert(v.games[1].exists and v.games[1].usable and v.games[1].autosave and not v.games[0].autosave,"A manual save makes that slot the autosave's.")
        assert(v.games[1].detail.contains(phoenix_text(saved_cents)),v.games[1].detail)
        print("GAME_MENU_PROBE saved slot2: {v.games[1].time} | {v.games[1].place} | {v.games[1].detail}")
        # play on and change everything the load must restore
        game.debug_cents(1)
        game.me.pos=game.me.pos+vec3(40,0,25)
        game.presentation.cat_bonds={}
        game.presentation.battles_seen=[]
        ask("load",1);stage=2
    else if stage==2:
        if not idle():return
        assert(game.game_ui_note=="Loaded slot 2.",game.game_ui_note)
        assert(not game.paused and not game.dbg.open,"A successful load closes the pause menu.")
        assert(length(game.me.pos-saved_pos)<0.01,"position {game.me.pos} vs {saved_pos}")
        assert(game.player_cents()==saved_cents,"purse {game.player_cents()} vs {saved_cents}")
        assert(game.living_world.minute==saved_minute)
        assert(321 in game.presentation.cat_bonds and game.presentation.cat_bonds[321].fondness==640,"cat friendship")
        assert([loop b in game.presentation.battles_seen: if b.name=="Fight off the headland": b].len()==1,"battle card seen")
        print("GAME_MENU_PROBE loaded slot2: position, purse {saved_cents}, cat fondness 640, battle card restored")
        game.set_paused(true)
        ask("delete",0);stage=3
    else if stage==3:
        if not idle() or game.game_slot_views[0].exists:return
        assert(game.game_ui_note=="Slot 1 deleted.",game.game_ui_note)
        v=game.debug_view()
        assert(not v.games[0].exists and v.games[1].exists and v.games[1].autosave)
        print("GAME_MENU_PROBE PASS autosave+card, menu save/load/delete, rows and notes; position/purse/cat/battle restored")
        exit(0)

draw = ():
    when TARGET=="wasm":
        if frame_number()>1 and frame_number()%120!=0:return
    base_draw()
