# The game with scripted input (SLOPPY_INPUT), telling how a visit to the paint shop goes: every
# frame a PAINT line with where the pilot is, what has the screen, the town's paint shop on the
# screen (where to tap it), the talk's number for the painter's answer, the shop's panel and its
# buttons, the aircraft at the berth, the job and its stage, and the purse.
# tests/paint_shop_flow_test.py runs it and reads the lines.
build:
    name = "Aegean paint shop probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/settlements.jo'
use '../src/paint_shed.jo'
use '../src/paint_shop.jo'
use '../src/paint_shop_view.jo'
use '../src/aircraft_paint.jo'
use '../src/markings.jo'
use '../src/panels.jo'

finish_settlement_registry()
base_update: (f64) -> void = game.update
base_draw: () -> void = game.draw

# what she wears now: her own paint, primer, the top coat, or the new paint dry
_stage = () -> str:
    job = game.paint_job
    if not job.active: return if paint_parts_set(game.player_paint) > 0 or game.player_paint.livery >= 0 or game.player_paint.decals.len() > 0: "dry" else: "none"
    done = paint_job_progress(job, game.living_world.minute)
    if done < 0.34: "masked" else: if done < 0.67: "primer" else: "top"

update = (dt: f64):
    base_update(dt)
    w = game.living_world
    place = game.town_here(game.me.pos)
    line = "PAINT f={frame_number()} ui={game.ui} skip={game.skip.active} mode={game.me.mode} pos={game.me.pos.x:.1},{game.me.pos.z:.1} minute={w.minute} purse={game.player_cents()}"
    if let shed = game.paint_shed_of(place):
        # (the board on its back wall, seen from the waterfront: where a tap finds the workshop)
        board = transform_point(shed.frame, vec3(-2.5, f32(SHED_DECK + 2.2), f32(SHED_BACK_Z)))
        px = world_to_screen(board)
        line = line + " stand_d={length(game.me.pos - shed.stand):.2} berth={game.paint_at_berth(shed)}"
        if let at = px: line = line + " shed_px={at.x:.0}x{at.y:.0}"
        who = game.paint_mechanic_here()
        if who >= 0: line = line + " painter_d={length(w.people[who].pose.pos - shed.painter):.1}"
    talking = if game.ui == .talk and game.ui_folk >= 0 and game.ui_folk < game.folks.len(): game.folks[game.ui_folk].person else: -1
    if talking >= 0:
        # (the painter's answer among the talk's chips, and its "I'll wait" beside it: where to tap)
        k = game.paint_answer_key
        line = line + " talk={w.people[talking].occupation} live={conversation_live}"
        if k >= 0 and k < conversation_action_at.len(): line = line + " ask={conversation_action_at[k].x:.0}x{conversation_action_at[k].y:.0}"
        if k >= 0 and k + 1 < conversation_action_at.len(): line = line + " next={conversation_action_at[k + 1].x:.0}x{conversation_action_at[k + 1].y:.0}"
    if game.paint_shop_open:
        q = game.paint_shop_quote()
        st = game.paint_panel
        line = line + " panel={st.rect.x:.0},{st.rect.y:.0},{st.rect.w:.0},{st.rect.h:.0} order={st.order_at.x:.0}x{st.order_at.y:.0} tabs={st.tabs_at.x:.0},{st.tabs_at.y:.0},{st.tabs_w:.0} quote={q.cents}/{q.minutes}/{q.items.len()}"
    line = line + " job={game.paint_job.active} stage={_stage()} wait_view={game.paint_wait_view}"
    print(line)

draw = (): base_draw()
