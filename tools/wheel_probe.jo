# The mouse wheel in the running game: on foot with nothing open it brings the camera nearer; with
# each panel (every Ui state, and the leisure panels' stages), the pause menu, the notebook, the
# chart, time passing and the table's card open in turn, it leaves the camera where it was.
# The wheel is turned by SLOPPY_INPUT, a notch every few frames:
#   env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 SLOPPY_SEED=12345 \
#     SLOPPY_SAVE_DIR=<empty scratch> SLOPPY_WINDOW=640x360 SLOPPY_SCREENSHOT=<scratch>/w.png \
#     SLOPPY_FRAMES=3000 SLOPPY_INPUT="$(python3 -c 'print(" ".join(f"{k}:wheel=1" for k in range(1,3000,3)))')" \
#     sloppy --release tools/wheel_probe.jo
# It prints WHEEL_PROBE PASS and exits, or stops on the first state that let the camera move.
build:
    name = "Aegean wheel probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/ui_state.jo'
use '../src/settlements.jo'

finish_settlement_registry()
base_update:(f64)->void=game.update
base_draw:()->void=game.draw

# what each step opens (and closes again afterwards)
STATES = ["nothing", "talk", "board", "handling", "trade", "contract", "maps", "fuel", "leisure", "workshop",
    "sitting", "menu", "room", "tavli-choice", "song", "paper",
    "paused", "notebook", "chart", "skip", "nothing-again"]

step = -1
opened_at = 0
before = 0.0
ready_frames = 0
settling = false                    # (checked; waiting for time passing to end before the next)

_ui_index = (name: str) -> int:
    loop i in 1..UI_STATES:
        if STATES[i] == name: return i
    -1

# A panel state held open: some panels close themselves where they don't apply (the fuel pier's
# off the aircraft, the workshop's away from its desk), so the probe opens them again before each
# of the game's steps; the camera's step is in that update.
_hold = (name: str):
    k = _ui_index(name)
    if k < 0: return
    game.ui = Ui(k)
    game.ui_folk = if game.folks.len() > 0: 0 else: -1
    game.ui_place = 0
    sellers = game.living.map_sellers(game.living_world, game.living_world.player)
    if sellers.len() > 0: game.ui_shop = sellers[0].id

_open = (name: str):
    # (from the middle of the camera's range, so a step either way would show)
    game.follow.distance = 6.0
    if name == "nothing" or name == "nothing-again": return
    if _ui_index(name) >= 0:
        _hold(name)
        return
    if name == "sitting": game.leisure_sit("hotel")
    else if name == "menu": game.leisure_open_menu("hotel")
    else if name == "room":
        game.ui = .leisure; game.leisure_ui = 2; game.leisure_at = "hotel"
    else if name == "tavli-choice":
        game.ui = .leisure; game.leisure_ui = 6; game.leisure_at = "coffee"
    else if name == "song":
        game.ui = .leisure; game.leisure_ui = 8
    else if name == "paper":
        game.ui = .leisure; game.leisure_ui = 9
    else if name == "paused": game.set_paused(true)
    else if name == "notebook": game.notebook.open = true
    else if name == "chart": game.show_chart = true
    else if name == "skip": game.leisure_skip(30, "Time passes")

_close = ():
    if game.leisure.sitting != "": game.leisure_stand()
    game.ui = .none; game.leisure_ui = 0
    game.set_paused(false)
    game.notebook.open = false
    game.show_chart = false

update = (dt: f64):
    global step, opened_at, before, ready_frames, settling
    if step >= 0 and not settling: _hold(STATES[step])
    base_update(dt)
    if settling:
        if game.skip.active: return
        settling = false
        _next()
        return
    if step < 0:
        if not game.living_world.far.populated or game.me.mode != .walking: return
        ready_frames += 1
        if ready_frames < 30: return
        step = 0; _open(STATES[0]); opened_at = frame_number()
        return
    n = frame_number() - opened_at
    name = STATES[step]
    if n == 3: before = game.follow.distance
    if n < 16: return
    after = game.follow.distance
    if name == "nothing" or name == "nothing-again":
        assert(after < before - 0.05, "WHEEL_PROBE the wheel did not zoom with nothing open ({name}: {before} -> {after}); is SLOPPY_INPUT turning it?")
    else:
        assert(abs(after - before) < 1e-9, "WHEEL_PROBE {name} open: the camera moved with the wheel ({before} -> {after})")
        assert(game.menus_open(), "WHEEL_PROBE {name}: not counted as open")
    print("WHEEL_PROBE {name}: {before:.3} -> {after:.3}")
    _close()
    # (let the time card finish before the next)
    if game.skip.active: settling = true
    else: _next()

_next = ():
    global step, opened_at
    step += 1
    if step >= STATES.len():
        print("WHEEL_PROBE PASS {STATES.len()} states")
        exit(0)
    _open(STATES[step]); opened_at = frame_number()

draw = (): base_draw()
