# Matched aerial ground checks. STRIPE_SITE=mainland|islands,
# STRIPE_ALTITUDE is metres above the target ground. Use 200 warm-up frames.
use '../src/world.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'
use '../src/world_terrain.jo'
use '../src/terrain.jo'
use '../src/geography.jo'
use '../src/terrain_lod.jo'
use '../src/quality.jo'
use '../src/look.jo'
use '../src/sky.jo'
use '../src/sea.jo'
window("Terrain stripe check",1280,720)
record_stats()
init_quality()
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
load_terrain(embed('../assets/terrain_lod.bin'))
enable_world_depth()
init_terrain();init_world_terrain();init_sky();init_sea()
depth=build_depth_texture()
water=build_sea_mesh()
wind_now.speed=2.0
h=f32(to_float(env("STRIPE_ALTITUDE")??"1000")??1000.0)
site=env("STRIPE_SITE")??"mainland"
p=if site=="mainland":vec3(-148267,66,-156238) else:vec3(40,0,0)
p.y=f32(surface_height(f64(p.x),f64(p.z)))
eye=p+vec3(-h*0.85,h,h*0.6)
target=p+vec3(h*0.25,0,-h*0.15)
if site=="islands":
    # Keep the protected archipelago in view, without distant mainland.
    eye=p+vec3(-h*0.5,h,h*0.35)
    target=p+vec3(h*0.15,0,-h*0.1)
print("STRIPE site={site} agl={h} eye={eye} target={target}")
frame=0
update=(dt:f64):
    global frame
    frame+=1
draw=():
    clear(BLACK);hide_sky()
    camera3d(eye,target,62,0.1,world_far(f64(eye.y)))
    draw_custom(():
        clear_world_depth()
        L=light_at(14.0)
        draw_sky(L,12.0);draw_far_sea(depth,L,12.0,wind_now)
        draw_ground(L,12.0+f64(frame)/60.0);draw_world_terrain(L,12.0+f64(frame)/60.0)
    )
    draw_custom(():draw_sea(water,depth,light_at(14.0),12.0,wind_now),transparent=true)
    if frame==120 or frame==600 or frame==840: print(frame_stats_line())
