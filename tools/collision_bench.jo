# Identical full-game moving-street fixture compiled against base and candidate.
import '../aegean.jo' as game
use 'judge_scene.jo'
use '../src/settlements.jo'
use '../src/objects.jo'
use '../src/world_point.jo'
record_stats()
finish_settlement_registry()
site=env("COLLIDE_BENCH_SITE") ?? "porto"
a=vec2(516.177,-6334.7266);b=vec2(501.1,-6326.84)
if site=="kalyrassa":a=vec2(-117999.45,-84871.78);b=vec2(-117993.9,-84855.7)
if site=="olythoria":
    loop s in world_settlements:
        if s.name=="Olythoria":a=place_to_world(s,vec2(-5,-4));b=place_to_world(s,vec2(-5,3))
game.me.pos=vec3(a.x,f32(walk_height(game.towns,a.x,a.y)),a.y)
game.me.mode=.walking;game.judge_ready=true
base_update:(f64)->void=game.update
base_draw:()->void=game.draw
max_error=0.0
update=(dt:f64):
    global max_error
    frame=frame_number()
    fraction=f64(max(0,frame-240))/60.0*1.7/f64(length(b-a))
    phase=fraction-floor(fraction/2)*2
    u=if phase<=1:phase else:2-phase
    wanted=mix(a,b,f32(u))
    game.sync_walker_point()
    game.step_player_walk(wanted-world_vec(game.walker_point).xz)
    delta=b-a
    game.me.yaw=atan2(f64(delta.x),f64(delta.y))
    game.me.stride=if frame>240:1.0 else:0.0
    game.me.phase+=dt*8
    base_update(dt)
    max_error=max(max_error,f64(length(game.me.pos.xz-wanted)))
    target=vec3(wanted.x,f32(walk_height(game.towns,wanted.x,wanted.y)+1),wanted.y)
    direction=normalize(b-a);side=vec2(-direction.y,direction.x)
    eye=target+vec3(-direction.x*7+side.x*4,3,-direction.y*7+side.y*4)
    game.judge_camera=JudgeView(eye,target,"matched walking street")
draw=():
    base_draw()
    frame=frame_number()
    if frame==240 or frame==480 or frame==720:
        print("COLLIDE_BENCH {site} frame={frame} path_error={max_error:.6} "+frame_stats_line())
        assert(max_error<0.12)
