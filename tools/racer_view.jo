# A model check for one aircraft through the standard renderer (no world): RACER_KIND (Craft ID),
# RACER_YAW and RACER_PITCH (radians, the eye's direction round it), RACER_DIST (times the span).
# Headless: SLOPPY_NO_AUDIO=1 SLOPPY_FRAMES=3 SLOPPY_SCREENSHOT=out.png sloppy tools/racer_view.jo
use '../src/planes.jo'

window("Aircraft view", 1280, 720)
kind = Craft(clamp(to_int(env("RACER_KIND") ?? "16") ?? 16, 0, CRAFT_NAMES.len() - 1))
yaw = to_float(env("RACER_YAW") ?? "0.75") ?? 0.75
pitch = to_float(env("RACER_PITCH") ?? "0.3") ?? 0.3
dist = to_float(env("RACER_DIST") ?? "1.25") ?? 1.25
p = aircraft_profile(kind)
m = build_craft(kind, LIVERIES[DEFAULT_LIVERIES[int(kind)]])

draw = ():
    clear(rgb(0.78, 0.84, 0.86))
    d = max(p.span, p.length) * dist
    eye = vec3(sin(yaw) * cos(pitch) * d, sin(pitch) * d, -cos(yaw) * cos(pitch) * d)
    camera3d(eye, vec3(0, 0, 0), 40.0)
    sun(normalize(vec3(0.4, 1.0, 0.3)))
    draw_mesh(m.body)
    loop hub in m.prop_hubs: draw_mesh(m.prop, translation(hub) * rotation_z(0.5))
    text("{CRAFT_NAMES[int(kind)]}  /  {p.role}", vec2(24, 34), 26, rgb(0.12, 0.18, 0.2))
