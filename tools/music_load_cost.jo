# The cost of loading a piece (inflating and unpacking its events), the work done at once when the
# radio moves on to it or a station is tuned: count instructions with valgrind, not the clock.
#   MUSIC_PIECE=72 valgrind --tool=callgrind ./music_load_cost
use '../src/music_data.jo'
use '../src/music_synth.jo'

piece = to_int(env("MUSIC_PIECE") ?? "0") ?? 0
s = make_music_synth()
music_load(s, piece)
print("LOAD {MUSIC_PIECES[piece].title}: {s.events.len()} events")
