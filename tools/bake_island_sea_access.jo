# Append one hull-verified sea service to an existing served harbour. Preserve
# old link IDs, paths and all seeds; use the same navigator as the full bake.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/vessel_types.jo'
use '../src/sea_routes.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
id=to_int(args()[1])!;s=world_settlements[settlement_by_id[id]]
assert(s.harbor.len()>0 and vessel_berth(id,.trehantiri)!=none)
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
served:{int:bool}
loop link in catalog.links:
    if link.mode==.ship:served[link.a]=true;served[link.b]=true
assert(not (id in served))
others=[loop p in world_settlements:if p.id in served and p.harbor.len()>0:p]
others.sort((p:WorldSettlement):(length(p.center-s.center),p.id))
added=false
loop other in others[..min(8,others.len())]:
    a=min(id,other.id);b=max(id,other.id);fleet=VesselFleet()
    eprint("SEA TRY {s.name}/{other.name}")
    request=request_harbor_lane(fleet,a,b,.trehantiri)
    if request<0:continue
    loop batch in 0..128:
        step_sea_navigation(fleet,16384)
        if fleet.lanes[0].status==.ready or fleet.lanes[0].status==.blocked:break
    lane=fleet.lanes[0]
    if lane.status!=.ready:continue
    points=[loop p in lane.points:vec3(p.x,0,p.y)];distance=0
    loop k in 1..points.len():distance+=int(round(f64(length(points[k]-points[k-1]))*1000.0))
    catalog.links.push(FarLink(catalog.links.len(),a,b,.ship,points,distance))
    print("SEA VERIFIED {id}/{other.id}: {points.len()} points, {distance} mm; {catalog.links.len()} links")
    added=true;break
assert(added,"no verified sea service; do not mark landing served")
assert(write_bytes(join_path(dir_name(args()[0]),'../assets/living-routes.bin'),deflate(bytes(to_text(catalog)))))
