# Land after a jump: the camera is set down at the mainland coast (a load, a teleport, the
# title's city shot) and terrain selection runs frame by frame as the game runs it, with its
# own per-frame allowance. Every land tile chosen must be drawable within 120 frames (two
# seconds at 60 fps; it takes 45-50 on a busy desktop, as on a 33 fps laptop about 1.5 s).
# Before the coarsest tiles were made first, a coast drew nothing for some 330 frames.
# SLOPPY_SOFTWARE=1, no window.
use '../src/geography.jo'
use '../src/world.jo'
use '../src/world_terrain.jo'
use '../src/terrain_lod.jo'
use '../src/render_space.jo'
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_world_terrain()
# (eye, looking at): offshore low over Kalyrassa's harbour, a high arc, on foot at its aerodrome
views = [(vec3(-117683,40,-84975),vec3(-120176,0,-87738)),(vec3(-116500,420,-83500),vec3(-120176,0,-87738)),(vec3(-120176,0,-87738),vec3(-121000,0,-88500))]
loop k in 0..views.len():
    eye,at = views[k]
    if eye.y == 0: eye.y = f32(new_land_surface(f64(eye.x),f64(eye.z))+1.7)
    vp = perspective(70.0*PI/180.0,1280.0/720.0,0.3,world_far(f64(eye.y)))*look_at(eye,at,vec3(0,1,0))
    work = 0.0; shown = -1
    loop frame in 0..600:
        t0 = time()
        prepare_world_terrain(eye,vp,f64(frame)/60.0+f64(k)*100.0)
        work += time()-t0
        land = 0; hidden = 0
        loop slot in world_selected:
            node = world_tiles[slot]
            if node.high <= 0.0: continue
            if world_tile_drawable(node,eye): land += 1 else: hidden += 1
        if land > 0 and hidden == 0: shown = frame+1; break
    print("TERRAIN ARRIVAL view={k} frames={shown} tile_work={work*1000.0:.0}ms cache={world_cache.len()} selected={world_selected.len()}")
    assert(shown > 0 and shown <= 120,"land after a jump not drawable within 120 frames")
    # (the next view starts as cold as a jump from far away does)
    loop i in 0..WORLD_CACHE_SLOTS:
        if world_tiles[i].key >= 0 and world_tiles[i].level < WORLD_ROOT_LEVEL: world_cache.remove(world_tiles[i].key); world_tiles[i] = WorldTile()
# Warmed ahead (the title's next shot): from far out at sea, warm the first view until
# world_warm_settled(), then cut to it: its land is drawable on the first frame there.
far_eye = vec3(-60000,300,-60000)
far_vp = perspective(70.0*PI/180.0,1280.0/720.0,0.3,world_far(300.0))*look_at(far_eye,far_eye+vec3(1,-0.1,0),vec3(0,1,0))
warm_eye,warm_at = views[0]
world_warm([WorldWarmView(warm_eye,warm_at,aspect=1280.0/720.0)])
warmed = -1
loop frame in 0..2000:
    prepare_world_terrain(far_eye,far_vp,500.0+f64(frame)/60.0)
    if world_warm_settled(): warmed = frame+1; break
assert(warmed > 0,"warmed view never settled")
world_warm_clear()
warm_vp = perspective(70.0*PI/180.0,1280.0/720.0,0.3,world_far(f64(warm_eye.y)))*look_at(warm_eye,warm_at,vec3(0,1,0))
prepare_world_terrain(warm_eye,warm_vp,600.0)
land = 0; hidden = 0
loop slot in world_selected:
    if world_tiles[slot].high <= 0.0: continue
    if world_tile_drawable(world_tiles[slot],warm_eye): land += 1 else: hidden += 1
print("TERRAIN WARM settled_frames={warmed} first_frame land={land} hidden={hidden} made_then={world_generated} view_settled={world_view_settled()}")
assert(land > 0 and hidden == 0,"a warmed view's land not drawable on its first frame")
print("TERRAIN ARRIVAL PASS")
