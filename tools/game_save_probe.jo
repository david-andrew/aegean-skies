# Full-game persistence integration: real autosave, paid fuel, manual save, load and delete.
# Run headlessly with an isolated SLOPPY_SAVE_DIR. No menu or keyboard shortcut is added.
build:
    name = "Aegean save probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
import '../src/living_world.jo' as life
import '../src/living_save.jo' as saves
import '../src/living_refuel.jo' as refuel
use '../src/game_slots.jo'
use '../src/living_types.jo'
use '../src/notebook.jo'
use '../src/living_guard.jo'
use '../src/game_session.jo'
use '../src/settlements.jo'
use '../src/leisure.jo'

finish_settlement_registry()
base_update:(f64)->void=game.update
base_draw:()->void=game.draw
case=env("GAME_SAVE_CASE") ?? "foot"
stage=0
resumed_at=0
expected_tick= -1
expected_fuel=0
expected_accounts=u64(0)
expected_state=u64(0)
expected_time=0.0
wait_frames=0

update = (dt: f64):
    global stage,expected_tick,expected_fuel,expected_accounts,expected_state,expected_time,wait_frames,resumed_at
    base_update(dt)
    wait_frames+=1
    assert(wait_frames<1600,"Persistence probe did not complete: stage={stage} error={game.game_saves.error} phase={game.game_saves.phase}")
    assert(game.game_saves.error=="",game.game_saves.error)
    if stage==0:
        if game.game_slot_views.len()!=3 or game.game_saves.busy or not game.living_world.far.populated:return
        if case=="foot":
            if not game.game_slot_views[0].exists:return
            print("GAME_SAVE_PROBE autosave slot0 minute={game.living_world.minute}")
        else:
            if game.living_world.tick<40:return
            assert(not game.game_slot_views[0].exists,"Airborne game must not autosave.")
        game.set_paused(true)
        c=game.living_world.people[game.living_world.player].craft
        # A disclosed fixture draw-down, then an actual paid purchase from the actual pier.
        if case=="foot":
            game.debug_fuel_ml(c,max(0,game.living_world.aircraft[c].fuel_ml-10000))
            pier=refuel.fuel_pier_at(game.living_world,game.pc.state.position)
            assert(pier!=none)
            sold=refuel.buy_tank_fuel(game.living_world,pier!,game.living_world.player,10000)
            assert(sold.ml>0,sold.reason)
            game.pc.state.fuel=f64(game.living_world.aircraft[c].fuel_ml)/1000
            game.leisure_sit("hotel")
            bought=leisure_order(game.living_world,game.hotel_place,game.hotel_menu[0],game.leisure)
            assert(bought.ok,bought.message)
            game.leisure_spent+=bought.cents;game.leisure_had.push(game.hotel_menu[0].name)
            assert(game.leisure.served.len()==1 and game.leisure_spent>0)
        game.presentation.cat_bonds[123]=CatBond(fondness=730,minute=game.living_world.minute,strokes=5)
        game.presentation.battles_seen.push(BattleSighting(77,"Battle over the strait",game.pc.state.position,game.living_world.minute))
        game.notebook.notes.push(Note("A persistence test entry.","Today"))
        expected_tick=game.living_world.tick;expected_time=game.t
        expected_fuel=game.living_world.aircraft[c].fuel_ml
        expected_accounts=hash(to_text(game.living_world.accounts))
        expected_state=hash(to_text(game.pc.state))
        assert(game.request_game_save(1));stage=1
    else if stage==1:
        if game.game_save_command!="" or game.game_saves.busy or game.game_slot_views.len()!=3 or not game.game_slot_views[1].exists:return
        print("GAME_SAVE_PROBE manual slot1 paid_fuel={expected_fuel}")
        life.advance_minutes(game.living_world,5)
        game.pc.state.fuel=0;game.presentation.cat_bonds={};game.presentation.battles_seen=[];game.notebook.notes=[]
        assert(game.request_game_load(1));stage=2
    else if stage==2:
        if game.game_save_command!="" or game.game_save_status().busy:return
        assert(game.living_world.tick==expected_tick and game.t==expected_time)
        c=game.living_world.people[game.living_world.player].craft
        assert(game.living_world.aircraft[c].fuel_ml==expected_fuel)
        assert(hash(to_text(game.living_world.accounts))==expected_accounts)
        assert(hash(to_text(game.pc.state))==expected_state)
        assert(game.presentation.cat_bonds[123].fondness==730)
        if case=="foot":
            assert(game.leisure.sitting=="hotel" and game.leisure.served.len()==1 and game.leisure_spent>0)
            assert(length(game.living_world.people[game.living_world.player].pose.pos-game.me.pos)<0.1)
        assert(game.presentation.battles_seen.len()==1 and game.presentation.battles_seen[0].name=="Battle over the strait")
        assert(game.notebook.notes[game.notebook.notes.len()-1].text=="A persistence test entry.")
        assert(game.request_game_delete(0));stage=3
    else if stage==3:
        if game.game_save_command!="" or game.game_saves.busy or game.game_slot_views[0].exists:return
        assert(game.game_slot_views[1].exists and not game.game_slot_views[2].exists)
        game.set_paused(false);resumed_at=frame_number();stage=4
    else if stage==4:
        if frame_number()-resumed_at<120:return
        assert(game.living_world.tick>expected_tick)
        check=game.capture_running_game()
        assert(check is SaveGame,if check is saves.LivingSaveError:check.message else:"")
        assert(living_faults().len()==0,to_text(living_faults()))
        print("GAME_SAVE_PROBE PASS {case} autosave/manual/load/delete player/aircraft/fuel/accounts/cats/battle-history/notebook/clock/resumed-conservation; tick={expected_tick}")
        exit(0)

draw = ():
    # SwiftShader's full town render is expensive; this tests storage/physics, not FPS.
    # Native probes render every frame; WebGL2 draws before saving and after restoring.
    when TARGET=="wasm":
        if frame_number()>1 and frame_number()%120!=0:return
    base_draw()
