# CPU/functional cache probe. SLOPPY_SOFTWARE=1, no window/audio; one process.
use '../src/world_towns.jo'
use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
towns = [loop s in SETTLEMENTS: build_town(s)]
init_world_towns(towns)
largest = 0; vertices = 0; total_far = 0
loop ft in world_town_far: assert(not ft.ready and ft.houses.len() == 0)
loop road in settlement_roads: assert(not road.ready)
loop s in world_settlements:
    if s.kind != .capital: continue
    loop k in 0..45:
        prepare_world_towns(s.center+vec3(0,30,0))
        assert(world_town_generated <= 1 and world_town_slots.len() <= TOWN_DISTRICT_LIMIT)
        largest = max(largest,world_town_slots.len())
        resident_vertices = world_town_paths.count
        loop slot in world_town_slots:
            assert(slot.paths.len() == 0)
            resident_vertices += world_town_path_meshes[slot.mesh_slot].count
        vertices = max(vertices,resident_vertices)
    retained = 0
    loop ft in world_town_far:
        if ft.ready: retained += 1
    assert(retained <= 24)
    assert(world_town_far[settlement_by_id[s.id]].houses.len() >= 2000)
    keys: {int: bool} = {}
    loop slot in world_town_slots:
        assert(not (slot.key in keys)); keys[slot.key] = true
        loop inst in slot.houses:
            at = transform_point(inst.model,vec3(0,0,0))
            assert(place_ground(at.xz) >= f64(at.y)-0.02)
    print("CAPITAL {s.name} far={world_town_far[settlement_by_id[s.id]].houses.len()} near={world_town_near_count} slots={world_town_slots.len()}")
    canonical_houses = 0
    loop lot in world_town_far[settlement_by_id[s.id]].lots:
        if place_ground_lot(s,lot) != none: canonical_houses += 1
    assert(canonical_houses >= 2000)
    print("HILL {s.name} at={place_point(place_to_world(s,s.old))} canonical_houses={canonical_houses}")
    full = world_town_near_count
    world_town_density = 0.0
    loop k in 0..45: prepare_world_towns(s.center+vec3(0,30,0))
    assert(world_town_near_count <= full)
    world_town_density = 1.0
print("BOUNDS slots={largest}/{TOWN_DISTRICT_LIMIT} path_vertices={vertices} eager_far_parcels={total_far} props={world_town_props.len()}")
# A functional cache rebuild reproduces the district exactly.
a = build_town_district(6,0,0,1.0)
b = build_town_district(6,0,0,1.0)
assert(hash(a.houses) == hash(b.houses) and hash(a.paths) == hash(b.paths) and hash(a.props) == hash(b.props))
print("district reproducibility passed")

loop place in world_settlements:
    landmarks = place_landmarks(place)
    if place.legacy >= 0: assert(landmarks.len() == 0)
    else if place.kind == .farm:
        assert(landmarks.len() == 2 and landmarks[0].kind == "farmhouse")
    else:
        assert(landmarks.len() > 0)
        loop landmark in landmarks:
            assert(landmark.at.y > 0.0)
print("landmark contract passed")

loop road in settlement_roads:
    loop k in 0..road.points.len():
        if k%17 == 0: assert(settlement_on_road(road.points[k].xz))
print("road ecology index passed")

# Visiting a different mainland and returning must not change a place or grow
# the residency bound; GPU paving slots are reused, CPU paving is transient.
capital = world_settlements[settlement_by_id[10001]]
reference = hash(build_far_town(capital).houses)
loop k in 0..45: prepare_world_towns(capital.center+vec3(0,30,0))
assert(hash(world_town_far[settlement_by_id[capital.id]].houses) == reference)
retained = 0
loop ft in world_town_far:
    if ft.ready: retained += 1
assert(retained <= 24 and world_town_path_meshes.len() == TOWN_DISTRICT_LIMIT)
loop slot in world_town_slots: assert(slot.paths.len() == 0)
print("return-trip geometry and residency passed; retained plans={retained}")
