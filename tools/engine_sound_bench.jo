# Times the period engines (tweaks.period_engines, src/engine_sound.jo) on the quiet laptop:
#   the switch: making one aircraft's engine sounds (every type, the median and the worst), and the
#     other aircraft's own engines as each type first comes into hearing
#   a busy strait: sixteen fighters wheeling round the listener and the player's own engine, a
#     frame's sound work (update_audio, hear_engines and the mixer's 800 samples) for 1200 frames,
#     the trial off and on: the mean, the 99th percentile and the worst
# Wall-clock: build on the desktop, run on redfox under the bench lock.
#   sloppy build tools/engine_sound_bench.jo --release -o engine_sound_bench
use '../src/sound.jo'
use '../src/engine_sound.jo'
use '../src/flight_feedback.jo'
use '../src/distant.jo'
use '../src/tweaks.jo'
from '../src/planes.jo' import Craft, CRAFT_NAMES, aircraft_profile

camera3d(vec3(0,500,0),vec3(0,500,-10))
host = env("BENCH_HOST") ?? "unknown"
skip = env("BENCH_SKIP") ?? ""         # player or hearing: leave that part out of the strait (to find a cost)
part = env("BENCH_PART") ?? "all"         # all, switch, strait-off or strait-on (instruction counts: one at a time)

# the switch: each piece of making a type's sounds (one a frame), and all of them
bench_switch = ():
    pieces: f64[]; totals: f64[]
    worst = ""; worst_ms = 0.0
    loop k in 0..CRAFT_NAMES.len():
        e = PeriodEngine()
        engine_sound_prepare(e,Craft(k))
        total = 0.0
        loop not engine_sound_ready(e,Craft(k)):
            began = time()
            engine_sound_build_step(e)
            ms = (time()-began)*1000.0
            pieces.push(ms); total += ms
            if ms > worst_ms: worst_ms = ms; worst = CRAFT_NAMES[k]
        totals.push(total)
    pieces.sort(); totals.sort()
    print("BENCH {host} switch: {totals.len()} types, all its sounds median {totals[totals.len()/2]:.1} ms in all; a piece (one a frame) median {pieces[pieces.len()/2]:.2} ms, p95 {pieces[pieces.len()*95/100]:.2} ms, worst {worst_ms:.2} ms ({worst})")
    outs: f64[]
    loop k in [0,16,21,25,35]:
        spec = engine_spec(Craft(k))
        began = time(); ex = make_exhaust(spec,true,5); outs.push((time()-began)*1000.0)
        began = time(); pr = make_prop(spec); outs.push((time()-began)*1000.0)
        began = time(); tp = make_tips(spec,6); outs.push((time()-began)*1000.0)
        began = time(); near = outside_mix(ex,pr,tp); outs.push((time()-began)*1000.0)
        mf = Muffle()
        began = time()
        mf = muffle_begin(MIX_RATE); muffle_run(mf,near.samples,MIX_RATE/2,MIX_RATE,false)
        outs.push((time()-began)*1000.0)
        began = time(); muffle_run(mf,near.samples,0,MIX_RATE,true); outs.push((time()-began)*1000.0)
    outs.sort()
    print("BENCH {host} another type first heard, a piece a frame: median {outs[outs.len()/2]:.2} ms, worst {outs[outs.len()-1]:.2} ms")


# a busy strait
run = (on: bool) -> f64[]:
    tweaks.period_engines = on
    a = start_audio(false)
    h = make_hearing()
    frame_ms: f64[]
    loop f in 0..(to_int(env("BENCH_FRAMES") ?? "") ?? 1260):
        t = f64(f)/60.0
        sources: EngineSource[]
        loop k in 0..16:
            ang = t*0.35+f64(k)*0.39; r = 300.0+180.0*sin(t*0.2+f64(k))
            pos = vec3(f32(cos(ang)*r),f32(450.0+60.0*sin(t*0.5+f64(k)*1.7)),f32(sin(ang)*r))
            vel = vec3(f32(-sin(ang)*r*0.35),0,f32(cos(ang)*r*0.35))
            kind = if k < 8: Craft.fiat_cr20 else: Craft.macchi_m33
            sources.push(EngineSource(100+k,pos,vel,0.85,true,1.0,f64(length(vel)),voice = aircraft_profile(kind).voice,kind = int(kind)))
        began = time()
        if skip != "player": update_audio(a,1.0/60.0,true,0.8,70.0,1e4,false,vec3(0,500,0),Craft.gull,FlightFeedback(ready = true,powered = true,speed = 70.0))
        if skip != "hearing": hear_engines(h,sources,vec3(0,500,0),vec3(0,0,-70),t)
        __mix(800)
        if f >= 60: frame_ms.push((time()-began)*1000.0)
    hush_audio(a); hush_engines(h)
    frame_ms
if part == "all" or part == "switch": bench_switch()
# (samples so small they are subnormal floats: a processor works through those many times slower)
if part == "all" or part == "subnormal":
    worst_count = 0; where = ""
    loop k in 0..CRAFT_NAMES.len():
        e = PeriodEngine()
        engine_sound_make(e,Craft(k))
        loop s in [e.on_load,e.overrun,e.prop,e.tips]+e.pops+e.water+[make_outside(e.spec)]:
            count = 0
            loop v in s.samples:
                if v != f32(0) and abs(v) < f32(1.2e-38): count += 1
            if count > worst_count: worst_count = count; where = CRAFT_NAMES[k]
    print("BENCH {host} subnormal samples in any one sound: {worst_count} ({where})")
loop on in [false,true]:
    if part != "all" and part != (if on: "strait-on" else: "strait-off"): continue
    ms = run(on)
    mean = 0.0
    loop v in ms: mean += v/f64(ms.len())
    ms.sort()
    print("BENCH {host} strait{if skip != "": " without "+skip else: ""}, trial {if on: "on" else: "off"}: sound work a frame mean {mean:.3} ms, p99 {ms[ms.len()*99/100]:.3} ms, worst {ms[ms.len()-1]:.3} ms")
