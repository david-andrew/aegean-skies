# Headless walking/contact probe. Paths are walked at the player's normal speed.
use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/town_sites.jo'
use '../src/render_space.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
init_settlements(false,true);finish_settlement_registry()
towns=[loop s in SETTLEMENTS: build_town(s)]
walk_segment=(towns: Town[],a: vec2,b: vec2) -> bool:
    p=WorldPoint(f64(a.x),walk_height(towns,f64(a.x),f64(a.y)),f64(a.y))
    steps=int(ceil(f64(length(b-a))/1.7*60))+120
    loop k in 0..steps:
        d=b-world_vec(p).xz
        if length(d)<0.08: return true
        p=walk_step_precise(towns,p,normalize(d)*min(length(d),f32(1.7/60)))
    print("BLOCKED {a} -> {b} at={p}")
    false

# A waterfront lane through Porto Vecchio, and the capital's inhabited street.
routes=[ [vec2(516.177,-6334.7266),vec2(501.1,-6326.84)], [vec2(-117999.45,-84871.78),vec2(-117993.9,-84855.7)] ]
loop i in 0..routes.len():
    loop k in 0..routes[i].len()-1: assert(walk_segment(towns,routes[i][k],routes[i][k+1]))
    print("WALK route={i} reached every waypoint")
# Every generated lane has footprint clearance; sample both ends through real contact.
lanes=site_lanes(towns[0].sites)
print("LANES {lanes.len()} sites={towns[0].sites.len()}")
walked=0; blocked=0
loop lane in lanes:
    assert(lane_clear(towns[0].sites,lane.a,lane.b,lane.width))
    if walked+blocked>=20: break
    if walk_segment(towns,lane.a,lane.b): walked+=1
    else: blocked+=1
assert(blocked==0)
print("WALK {walked} generated lanes reached")

roofs=0
loop tw in towns:
    loop site in tw.sites:
        if let entry=site_roof_entry(site,tw.sites):
            assert(walk_segment(towns,entry.outside,entry.front))
            # Walk from the top tread onto the roof, not just towards a wall.
            assert(walk_segment(towns,entry.front,entry.front-site_right(site)*1.7))
            roofs+=1
assert(roofs>0)
print("WALK {roofs} outside stairs and roof landings reached")
