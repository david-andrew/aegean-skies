#!/bin/sh
# Refuse to push commits that add files which must stay out of the repository (see docs/CI.md).
# git gives one line per ref on standard input: <local ref> <local sha> <remote ref> <remote sha>
top=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue           # a deletion
    if [ "$remote_sha" = "$zero" ]; then
        # a new branch: check everything not already on a remote
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    python3 "$top/tools/check_tracked_files.py" --range "$range" --quiet || exit 1
done
exit 0
