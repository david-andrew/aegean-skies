use '../src/world.jo'
# Dev-only camera recipes for tools/judge_pack.sh; never used without AEGEAN_CAPTURE.
use '../src/objects.jo'
use '../src/settlements.jo'
use '../src/planes.jo'

struct JudgeView:
    eye:vec3
    target:vec3
    label:str

# Capture recipes must observe a place from walkable open ground, not from
# the first house reached by a fixed offset. Test the whole sightline.
judge_ground_clear = (s: WorldSettlement,eye: vec3,target: vec3) -> bool:
    loop k in 0..13:
        p = mix(eye,target,f32(k)/12.0)
        if length(settlement_avoid_buildings(p.xz)-p.xz) > 0.05: return false
        if place_ground(p.xz)+0.3 > f64(p.y): return false
    true

judge_ground_eye = (s: WorldSettlement,center: vec3) -> vec3:
    target = center+vec3(0,2,0)
    loop radius in [14.0,18.0,24.0,32.0]:
        loop k in 0..16:
            a = f64(k)*TAU/16.0+0.45
            q = center.xz+s.out*f32(cos(a)*radius)+vec2(-s.out.y,s.out.x)*f32(sin(a)*radius)
            eye = vec3(q.x,f32(place_ground(q)+2.0),q.y)
            if place_ground(q) > 0.4 and judge_ground_clear(s,eye,target): return eye
    # The plaza center is reserved from housing. A modest raised overview is
    # an explicit fallback if all pedestrian sightlines are obstructed.
    center+vec3(0,9,0)+vec3(s.out.x,0,s.out.y)*6.0

judge_view = (recipe:str,towns:Town[],craft:vec3,span:f64) -> JudgeView:
    tw=towns[0];out=vec3(tw.out.x,0,tw.out.y);side=vec3(-out.z,0,out.x)
    center=tw.center
    if recipe=="flight":return JudgeView(craft+out*16.0+side*f32(max(20.0,span*1.7))+vec3(0,8,0),craft,"selected aircraft in flight, tracking side view")
    if recipe=="dock":return JudgeView(craft+out*16.0+side*f32(max(18.0,span*1.6))+vec3(0,8,0),craft,"home dock; selected aircraft")
    if recipe=="home":return JudgeView(center+out*220.0+side*125.0+vec3(0,110,0),center,"home harbor")
    if recipe=="weather-above":return JudgeView(center+out*400.0+vec3(0,2400,0),center+out*3500.0+vec3(0,700,0),"overcast deck from 2400 m above home waters")
    if recipe=="weather-below":return JudgeView(center+out*400.0+vec3(0,250,0),center+out*3500.0+vec3(0,850,0),"overcast deck from 250 m below, home waters")
    if recipe=="weather-storm":return JudgeView(vec3(0,400,-15000),vec3(0,1800,-26000),"storm off the archipelago; cell centered at (0, -26000)")
    if recipe=="weather-fog":return JudgeView(center+out*1800.0+side*400.0+vec3(0,15,0),center+vec3(0,12,0),"home waterfront through fog, low observer")
    if recipe=="cliff":
        coast,direction=coast_point(1,0.2)
        target=vec3(coast.x,55,coast.y)
        return JudgeView(target+vec3(direction.x*240,30,direction.y*240),target,"Thera Minor limestone cliff coast")
    if recipe=="mainland":return JudgeView(vec3(-85000,4000,-115000),vec3(-105000,1000,-145000),"Kalyra mainland at 4000 m")
    words=split(recipe,":")
    if words.len()>=3 and words[0]=="place":
        finish_settlement_registry()
        kind=to_int(words[1]) ?? 0
        chosen=-1
        loop i in 0..world_settlements.len():
            s=world_settlements[i]
            if int(s.kind)==kind and s.legacy<0 and (chosen<0 or s.id<world_settlements[chosen].id):chosen=i
        assert(chosen>=0)
        s=world_settlements[chosen];center=s.center;out=vec3(s.out.x,0,s.out.y);side=vec3(-out.z,0,out.x)
        if words[2]=="old":center=place_point(place_to_world(s,s.old))
        if words[2]=="old":return JudgeView(center+out*85.0+side*65.0+vec3(0,45,0),center,"{s.name}, id {s.id}, old-quarter hill and streets")
        if s.kind==.chapel or s.kind==.lighthouse:center=place_point(s.center.xz-s.out*26.0)
        if s.kind==.farm:
            if let parcel=place_parcel(s,1,1):center=parcel.at
        label="{s.name}, id {s.id}, {s.kind}, {words[2]}"
        if words[2]=="air":
            distance=max(140.0,s.radius*1.2)
            return JudgeView(center+out*f32(distance)+side*f32(distance*0.55)+vec3(0,f32(distance*0.65),0),center,label)
        eye=judge_ground_eye(s,center)
        return JudgeView(eye,center+vec3(0,2.0,0),label)
    panic("Unknown AEGEAN_CAPTURE recipe: {recipe}")
