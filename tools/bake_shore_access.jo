# Isolated island communities need a landing, not the broad flat apron required
# by a full generated port. Survey narrow quays and dry paths on canonical terrain.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_path_bake.jo'
use '../src/shore_access_data.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
loop id in SHORE_LANDINGS.keys():
    if id in settlement_by_id:
        index=settlement_by_id[id];world_settlements[index].harbor=[];world_settlements[index].remote_harbor=false
source="# Offline surveyed island landings.\nuse 'landing_access_types.jo'\nSHORE_LANDINGS:{{int:LandingAccess}}={{\n"
added=0;failed=0
loop s in world_settlements:
    if s.id<300001 or s.id>=400000 or s.id%10!=1 or s.harbor.len()>0:continue
    # An existing coastal village already supplies the island's landing.
    if s.id-1 in settlement_by_id:continue
    radius:f32=0
    loop island in small_islands:
        if island.id==(s.id-300001)/10:radius=max(island.radii.x,island.radii.y)
    if radius<=0:continue
    candidates:(f64,vec3,vec3,vec2)[]
    loop direction in 0..32:
        angle=f64(direction)*TAU/32.0;out=vec2(cos(angle),sin(angle))
        a=s.center.xz;b=a+out*radius*3.0
        if place_ground(b)> -3.0:continue
        loop k in 0..18:
            mid=(a+b)*0.5
            if place_ground(mid)>0.0:a=mid
            else:b=mid
        shore=(a+b)*0.5;root=place_point(shore-out*25.0)
        if root.y<2.0 or root.y>18.0:continue
        side=vec2(-out.y,out.x);tip=vec3(shore.x+out.x*110.0,1.2,shore.y+out.y*110.0)
        clear=true
        loop sign in [-1.0,0.0,1.0]:
            if place_ground(tip.xz-out*12.0+side*f32(sign*18.0))> -3.0:clear=false
            if abs(place_ground(root.xz+side*f32(sign*2.5))-f64(root.y))>0.8:clear=false
        if clear:candidates.push((f64(length(root-s.center))+f64(root.y)*30.0,root,tip,out))
    candidates.sort((item:(f64,vec3,vec3,vec2)):item.0)
    path:vec3[];root=vec3(0,0,0);tip=root;out=vec2(0,0)
    eprint("SHORE TRY {s.id} {s.name}: {candidates.len()} possible landings")
    loop k in 0..min(6,candidates.len()):
        option=candidates[k]
        path=access_contour_track(s.center.xz,option.1.xz)
        if path.len()<2 and length(s.center.xz-option.1.xz)<1800:path=access_track(s.center.xz,option.1.xz)
        if path.len()>1:root=option.1;tip=option.2;out=option.3;break
    if path.len()<2:
        failed+=1;eprint("SHORE UNRESOLVED {s.id} {s.name}");continue
    source+="    {s.id}:LandingAccess(vec3({root.x},{root.y},{root.z}),vec3({tip.x},{tip.y},{tip.z}),vec2({out.x},{out.y}),["
    loop p in path:source+="vec3({p.x},{p.y},{p.z}),"
    source+="],width=1.8),\n";added+=1
    assert(write_file(join_path(dir_name(args()[0]),'../src/shore_access_data.jo'),source+"}}\n"))
    eprint("SHORE ADDED {s.id} {s.name}: {path.len()} path bends")
assert(write_file(join_path(dir_name(args()[0]),'../src/shore_access_data.jo'),source+"}}\n"))
eprint("SHORE COMPLETE added={added} unresolved={failed}")
