# CPU-only stock/catalog audit; no chart UI or windows.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_seed.jo'
use '../src/living_types.jo'
use '../src/living_maps.jo'
use '../src/living_save.jo'
use '../src/map_scene.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true; init_settlements()
w = build_world(u64(42)); publish_settlement_maps(w)
assert(validate_save_world(w) == "")
before = canonical_text(w); copies = w.maps.issued; cash = w.ledger.opening_cents
publish_settlement_maps(w)
assert(canonical_text(w) == before and w.maps.issued == copies and w.ledger.opening_cents == cash)
restored = from_text[World](before); assert(restored is World and canonical_text(restored) == before)
keys = w.maps.editions.keys(); keys.sort()
loop key in keys:
    m = w.maps.editions[key]
    print("MAP {m.id}: {m.title}; {m.kind}, scale 1:{m.scale}, detail={m.detail}, accuracy={m.accuracy_m:.0}m, layers={m.layers}, errors={m.errors.len()}")
print("PAPER MAPS: {world_settlements.len()} real places; {w.maps.editions.len()} editions; {w.maps.shops.len()} sellers; {copies} conserved articles; {owned_maps(w).len()} owned, {w.maps.rewards.len()} reserved rewards; {before.len()} save bytes; hash={canonical_hash(w)}")
