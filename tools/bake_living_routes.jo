# Offline route validation, never an A* search in the game's minute/frame loop.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true; init_settlements(true)
seeds: FarPlaceSeed[]; links: FarLink[]
ordered = world_settlements; ordered.sort((s: WorldSettlement): s.id)
loop s in ordered:
    output = match s.kind:
        .fishing, .lighthouse: 0
        .farm: if s.seed%3==0: 2 else: 3
        .hill, .hamlet, .monastery, .chapel: if s.seed%4==0: 1 else: 3
        .capital: if s.country==1: 4 else: 5
        .market: if s.seed%3==0: 6 else: if s.seed%3==1: 7 else: 3
        .port: if s.seed%4==0: 5 else: if s.seed%4==1: 2 else: if s.seed%4==2: 1 else: 0
    population = if s.legacy>=0: [80,36,20,24,12,8][s.legacy] else: max(4,s.size*4)
    homes: FarHome[]
    if s.legacy<0:
        lots=place_lots(s); lots.sort((lot: PlaceLot): (length(lot.local),lot.seed))
        loop lot in lots:
            if homes.len()>=3: break
            if let parcel=place_ground_lot(s,lot):
                forward=vec2(f32(sin(parcel.yaw)),f32(cos(parcel.yaw)))
                door=place_point(parcel.at.xz+forward*f32(parcel.depth*0.5+1.2))
                if door.y>1.0: homes.push(FarHome("home:{s.id}:{parcel.seed}",door))
    seeds.push(FarPlaceSeed(s.id,population,s.country,output,productivity=240,raw_ore=if output==5: population*100000 else: 0,raw_crude=if output==4: population*100000 else: 0,homes=homes))
length_mm = (points: vec3[]) -> int:
    total = 0
    loop i in 1..points.len(): total += int(round(f64(length(points[i]-points[i-1]))*1000.0))
    total
loop i in 0..settlement_roads.len():
    road = settlement_roads[i]
    if road.points.len()<2: continue
    links.push(FarLink(links.len(),road.a,road.b,.cart,road.points,length_mm(road.points),i))
# Four nearest ports are candidates, not permission to cross an island. Dock-to-sea approach
# and every 35m of each crossing must lie over canonical water. Rejected chords have no service.
water = (a: vec3,b: vec3) -> bool:
    count = max(1,int(ceil(f64(length(b-a))/35.0)))
    loop n in 0..count+1:
        p = mix(a,b,f32(f64(n)/f64(count)))
        if height(p.x,p.z)>-0.5: return false
    true
seen: {int: bool}
ports = [loop s in ordered: if s.harbor.len()>0: s]
loop s in ports:
    others = [loop t in ports: if t.id!=s.id: t]
    others.sort((t: WorldSettlement): (length(t.center-s.center),t.id))
    loop n in 0..min(4,others.len()):
        t = others[n]; lane_key = (min(s.id,t.id)<<32)|max(s.id,t.id)
        if lane_key in seen: continue
        seen[lane_key] = true
        if length(t.center-s.center)>140000.0: continue
        a = s.harbor[0].buoy; b = t.harbor[0].buoy
        ap = a+vec3(s.out.x,0,s.out.y)*350.0; bp = b+vec3(t.out.x,0,t.out.y)*350.0
        if not water(a,ap) or not water(ap,bp) or not water(bp,b): continue
        points = [a,ap,bp,b]
        links.push(FarLink(links.len(),s.id,t.id,.ship,points,length_mm(points)))
key = hash([loop s in ordered: (s.id,s.center,s.out,s.country)])
catalog = FarRouteCatalog(SETTLEMENT_VERSION,terrain_key(),geography_key(),key,seeds,links)
path = join_path(dir_name(args()[0]),'../assets/living-routes.bin')
assert(write_bytes(path,deflate(bytes(to_text(catalog)))))
print("LIVING ROUTES places={seeds.len()} road_candidates={settlement_roads.len()} roads={[loop l in links: if l.mode==.cart: l].len()} sea_lanes={[loop l in links: if l.mode==.ship: l].len()} verified-samples=35m key={key}")
