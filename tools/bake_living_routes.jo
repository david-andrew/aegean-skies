# Offline route validation, never an A* search in the game's minute/frame loop.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/vessel_types.jo'
use '../src/sea_routes.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true; init_settlements(true)
seeds: FarPlaceSeed[]; links: FarLink[]
ordered = world_settlements; ordered.sort((s: WorldSettlement): s.id)
loop s in ordered:
    output = match s.kind:
        .fishing, .lighthouse: 0
        .farm: if s.seed%3==0: 2 else: 3
        .hill, .hamlet, .monastery, .chapel: if s.seed%4==0: 1 else: 3
        .capital: if s.country==1: 4 else: 5
        .market: if s.seed%3==0: 6 else: if s.seed%3==1: 7 else: 3
        .port: if s.seed%4==0: 5 else: if s.seed%4==1: 2 else: if s.seed%4==2: 1 else: 0
    population = if s.legacy>=0: [80,36,20,24,12,8][s.legacy] else: max(4,s.size*4)
    homes: FarHome[]
    if s.legacy<0:
        lots=place_lots(s); lots.sort((lot: PlaceLot): (length(lot.local),lot.seed))
        loop lot in lots:
            if homes.len()>=3: break
            if let parcel=place_ground_lot(s,lot):
                forward=vec2(f32(sin(parcel.yaw)),f32(cos(parcel.yaw)))
                door=place_point(parcel.at.xz+forward*f32(parcel.depth*0.5+1.2))
                if door.y>1.0: homes.push(FarHome("home:{s.id}:{parcel.seed}",door))
    seeds.push(FarPlaceSeed(s.id,population,s.country,output,productivity=240,raw_ore=if output==5: population*100000 else: 0,raw_crude=if output==4: population*100000 else: 0,homes=homes))
length_mm = (points: vec3[]) -> int:
    total = 0
    loop i in 1..points.len(): total += int(round(f64(length(points[i]-points[i-1]))*1000.0))
    total
loop i in 0..settlement_roads.len():
    road = settlement_roads[i]
    if road.points.len()<2: continue
    links.push(FarLink(links.len(),road.a,road.b,.cart,road.points,length_mm(road.points),i))
# All path finding happens here. Straight 0.5m-deep chords disconnected the capitals
# and could not fit the actual trading hulls. The vessel navigator validates center and
# clearance edges every7m, with real moorings or deep anchorages and headland detours.
ports=[loop s in ordered: if s.harbor.len()>0 and vessel_berth(s.id,.trehantiri)!=none: s]
requests: {int: (int,int)}
add_pair = (a: int,b: int):
    if a==b: return
    key=(min(a,b)<<32)|max(a,b)
    requests[key]=(min(a,b),max(a,b))
loop s in ports:
    others=[loop t in ports: if t.id!=s.id: t]
    others.sort((t: WorldSettlement): (length(t.center-s.center),t.id))
    loop n in 0..min(4,others.len()): add_pair(s.id,others[n].id)
# Also attempt the geographic minimum spanning tree: a local-neighbor limit must not
# isolate a whole group merely because all four closest ports share its same coast.
if ports.len()>0:
    visited: {int: bool}; visited[ports[0].id]=true
    best: {int: (f64,int)}
    loop t in ports[1..]: best[t.id]=(f64(length(t.center-ports[0].center)),ports[0].id)
    loop visited.len()<ports.len():
        choice= -1; score=1e30
        loop t in ports:
            if t.id in visited: continue
            d=best[t.id]
            if d.0<score or (d.0==score and (choice<0 or t.id<choice)): choice=t.id; score=d.0
        if choice<0: break
        add_pair(choice,best[choice].1); visited[choice]=true
        at=world_settlements[settlement_by_id[choice]].center
        loop t in ports:
            if t.id in visited: continue
            d=f64(length(t.center-at))
            if d<best[t.id].0: best[t.id]=(d,choice)
keys=requests.keys(); keys.sort(); ready=0; refused=0
loop key in keys:
    pair=requests[key]; fleet=VesselFleet()
    id=request_harbor_lane(fleet,pair.0,pair.1,.trehantiri)
    if id<0: refused+=1; continue
    loop batch in 0..128:
        step_sea_navigation(fleet,16384)
        if fleet.lanes[0].status==.ready or fleet.lanes[0].status==.blocked: break
    lane=fleet.lanes[0]
    if lane.status!=.ready: refused+=1; continue
    points=[loop p in lane.points: vec3(p.x,0,p.y)]
    links.push(FarLink(links.len(),pair.0,pair.1,.ship,points,length_mm(points)))
    ready+=1
    if ready%10==0: eprint("SEA_BAKE ready={ready} refused={refused} attempted={ready+refused}/{keys.len()}")
key = hash([loop s in ordered: (s.id,s.center,s.out,s.country)])
catalog = FarRouteCatalog(SETTLEMENT_VERSION,terrain_key(),geography_key(),key,seeds,links,navigation_version=1)
path = join_path(dir_name(args()[0]),'../assets/living-routes.bin')
assert(write_bytes(path,deflate(bytes(to_text(catalog)))))
print("LIVING ROUTES places={seeds.len()} road_candidates={settlement_roads.len()} roads={[loop l in links: if l.mode==.cart: l].len()} sea_lanes={[loop l in links: if l.mode==.ship: l].len()} hull-verified-samples=7m key={key}")
