# The night sky over open water, for judging the Moon, the stars, the planets and the Milky Way
# without loading the world: the game's own sky and sea programs and its light.
#   NIGHT_HOUR (20)  NIGHT_DAY (0: the sky's day count, the Moon's age)
#   NIGHT_AIR  clear|hazy|dusty|heavy|humid|washed (the day's air, day_air.jo)
#   NIGHT_AIM  moon|venus|jupiter|mars|saturn|milky: look at it; else NIGHT_YAW and NIGHT_PITCH
#              (degrees: yaw 0 north, 90 east; pitch up)
#   NIGHT_FOV (62)  NIGHT_EYE (40: the eye's height, m)  NIGHT_SEA=0: no sea  NIGHT_T (the time, s)
#   NIGHT_PAN="degrees a second": the view turns (clips, with SLOPPY_FIXED_STEP)
build:
    js = "../src/web_compat.js"
use '../src/sky.jo'
use '../src/sea.jo'
use '../src/celestial.jo'
use '../src/look.jo'
use '../src/day_air.jo'
use '../src/depth_space.jo'
use '../src/render_space.jo'
window("Night sky",1280,720)
enable_world_depth();init_sky();init_sea()
water=build_sea_mesh()
img=image(1,1)
img.set(0,0,vec4(1,0,0,1))
depth=texture(img)
expanded_depth=depth;nearby_depth=depth
num=(name:str,d:f64)->f64:to_float(env(name)??"")??d
hour=num("NIGHT_HOUR",20.0);day=num("NIGHT_DAY",0.0)
air=env("NIGHT_AIR")??"clear"
kind=DayAir.clear
loop k in 0..day_air_names.len():
    if air==day_air_names[k]:kind=day_air_kinds[k]
L=day_air_light(light_at(hour,day),kind)
yaw=num("NIGHT_YAW",180.0)*PI/180.0;pitch=num("NIGHT_PITCH",22.0)*PI/180.0
look=vec3(f32(sin(yaw)*cos(pitch)),f32(sin(pitch)),f32(cos(yaw)*cos(pitch)))
which=env("NIGHT_AIM")??""
if which=="moon":look=L.moon_dir
else if which=="venus":look=L.planets[0].xyz
else if which=="jupiter":look=L.planets[1].xyz
else if which=="mars":look=L.planets[2].xyz
else if which=="saturn":look=L.planets[3].xyz
fov=num("NIGHT_FOV",62.0);eye=num("NIGHT_EYE",40.0);t0=num("NIGHT_T",123.5)
pan=num("NIGHT_PAN",0.0)*PI/180.0
sea_on=env("NIGHT_SEA")!="0"
wind=Wind(vec2(0.8,0.6),5.0,vec2(0,0))
print("NIGHT hour={hour:.2} day={day:.2} air={air} moon={L.moon_dir} lit={moon_illumination(L.sun_dir,L.moon_dir):.3} sun_y={L.sun_dir.y:.3}")
loop k in 0..4:print("PLANET {k} {L.planets[k]}")
seconds=0.0
update=(dt:f64):
    global seconds
    seconds+=dt
draw=():
    clear(BLACK);hide_sky();post_effects(0.35,0.85,0.22,1.08, scene_depth = true)
    a=atan2(f64(look.x),f64(look.z))+pan*seconds
    flat=sqrt(f64(look.x*look.x+look.z*look.z))
    at=vec3(f32(sin(a)*flat),look.y,f32(cos(a)*flat))
    render_camera(vec3(0,f32(eye),0),at,fov,0.5,300000)
    draw_custom(():
        clear_depth()
        draw_sky(L,t0+seconds)
        if sea_on:draw_sea(water,depth,L,t0+seconds,wind))
