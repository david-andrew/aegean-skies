# Supplement the living road graph with validated routes from stranded communities.
# Existing links/identities are preserved; no render-time route finding.
use '../src/settlements.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/access_path_bake.jo'
use '../src/living_feeder_bake.jo'
use '../src/inland_connections_data.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
adj:{int:int[]};reached:{int:bool};queue:int[]
loop link in catalog.links:
    if link.mode!=.cart:continue
    aa=adj.get(link.a,[]);aa.push(link.b);adj[link.a]=aa
    bb=adj.get(link.b,[]);bb.push(link.a);adj[link.b]=bb
loop s in world_settlements:
    if s.harbor.len()>0:reached[s.id]=true;queue.push(s.id)
spread=():
    at=0
    loop at<queue.len():
        id=queue[at];at+=1
        loop other in adj.get(id,[]):
            if other in reached:continue
            reached[other]=true;queue.push(other)
spread()
connections=ACCESS_CONNECTIONS
source_for=(items:AccessConnection[])->str:
    source="# Offline validated access connections.\nstruct AccessConnection:\n    a:int\n    b:int\n    points:vec3[]\nACCESS_CONNECTIONS:AccessConnection[]=[\n"
    loop item in items:
        source+="    AccessConnection({item.a},{item.b},["
        loop p in item.points:source+="vec3({p.x},{p.y},{p.z}),"
        source+=" ]),\n"
    source+"]\n"
loop i in 0..connections.len():
    old=connections[i].points;path=[old[0]]
    loop k in 1..old.len():
        if feeder_segment_clear(path[path.len()-1],old[k]):path.push(old[k]);continue
        repaired=access_track(path[path.len()-1].xz,old[k].xz)
        assert(repaired.len()>1,"cannot repair connection {connections[i].a}/{connections[i].b} segment {k}")
        eprint("ACCESS REPAIR {connections[i].a}/{connections[i].b} segment {k}")
        path.extend(repaired[1..])
    connections[i].points=path
refused:{int:bool};added=0;attempts=0
loop attempts<100:
    pairs:(f64,int,int)[]
    loop a in world_settlements:
        if a.id in reached or a.legacy>=0:continue
        loop b in world_settlements:
            if not (b.id in reached) or b.region!=a.region:continue
            key=a.id*1000000+b.id
            if key in refused:continue
            distance=f64(length(b.center.xz-a.center.xz))
            if distance<=32000:pairs.push((distance,a.id,b.id))
    if pairs.len()==0:break
    pairs.sort((pair:(f64,int,int)):pair)
    pair=pairs[0];a=world_settlements[settlement_by_id[pair.1]];b=world_settlements[settlement_by_id[pair.2]]
    attempts+=1;eprint("ACCESS TRY {attempts}: {a.name}/{b.name} {pair.0:.0} m")
    path=access_contour_track(a.center.xz,b.center.xz)
    if path.len()<2:refused[a.id*1000000+b.id]=true;continue
    length_mm=0
    loop k in 1..path.len():length_mm+=int(round(f64(length(path[k]-path[k-1]))*1000))
    added+=1
    connections.push(AccessConnection(a.id,b.id,path))
    catalog.links.push(FarLink(catalog.links.len(),a.id,b.id,.cart,path,length_mm,trail=true))
    aa=adj.get(a.id,[]);aa.push(b.id);adj[a.id]=aa
    bb=adj.get(b.id,[]);bb.push(a.id);adj[b.id]=bb
    reached[a.id]=true;queue.push(a.id);spread()
    eprint("ACCESS ADDED {a.name}/{b.name}; {added} links, {reached.len()}/{world_settlements.len()} reachable")
assert(write_file(join_path(dir_name(args()[0]),'../src/inland_connections_data.jo'),source_for(connections)))
assert(write_bytes(join_path(dir_name(args()[0]),'../assets/living-routes.bin'),deflate(bytes(to_text(catalog)))))
eprint("ACCESS COMPLETE added={added} attempted={attempts} reachable={reached.len()}/{world_settlements.len()}")
