# A catalogue piece as the game's radio carries it (the station's orchestra, levelling and the
# receiver chain at a strong signal): a WAV for listening. Never opens a window or plays audio.
#   RADIO_PIECE=12 RADIO_SECONDS=120 RADIO_OUT=clip.wav sloppy --release tools/radio_piece_clip.jo
# RADIO_STRENGTH (default 1.0) for a weaker signal.
use '../src/music_data.jo'
use '../src/radio_synth.jo'

piece = to_int(env("RADIO_PIECE") ?? "12") ?? 12
seconds = to_float(env("RADIO_SECONDS") ?? "60") ?? 60.0
strength = to_float(env("RADIO_STRENGTH") ?? "1.0") ?? 1.0
out_path = env("RADIO_OUT") ?? "radio-clip.wav"
s = make_radio_synth()
radio_synth_program(s, .classical, 0, 0)
radio_music_program(s, piece, 0)
samples: f32[]
total = int(seconds * f64(RADIO_RATE))
loop samples.len() < total:
    samples += radio_render(s, min(RADIO_BLOCK, total - samples.len()), strength)
stereo = fill(f32(0), samples.len() * 6)
loop i in 0..samples.len() * 3:
    at = i / 3; blend = f32(i % 3) / 3.0
    v = samples[at] * (1.0 - blend) + samples[min(at + 1, samples.len() - 1)] * blend
    stereo[i * 2] = v; stereo[i * 2 + 1] = v
assert(save_wav(out_path, Sound(stereo)))
print("RADIO {MUSIC_PIECES[piece].title}: {seconds:.0} s -> {out_path}")
