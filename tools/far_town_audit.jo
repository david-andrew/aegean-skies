# CPU-only whole-registry contact/identity sweep. Run with --release.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/town_sites.jo'
use '../src/town_architecture.jo'
use '../src/town_life_scene.jo'
use '../src/town_details.jo'
use '../src/life_types.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/render_space.jo'
use '../src/objects.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements(false)
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
ordered=world_settlements;ordered.sort((s: WorldSettlement):s.id)
assert(catalog.navigation_version==1 and catalog.version==SETTLEMENT_VERSION)
assert(catalog.terrain==terrain_key() and catalog.geography==geography_key())
assert(catalog.places==hash([loop s in ordered:(s.id,s.center,s.out,s.country)]))
places=0;homes=0;treads=0;fixtures=0;ports=0;worst=0.0
loop s in world_settlements:
    if s.legacy>=0:continue
    places+=1
    lots=place_lots(s);lots.sort((lot: PlaceLot): (length(lot.local),lot.seed))
    sites: TownSite[]
    loop lot in lots:
        if sites.len()>=3:break
        if let p=place_ground_lot(s,lot):
            forward=vec2(f32(sin(p.yaw)),f32(cos(p.yaw)))
            door=place_point(p.at.xz+forward*f32(p.depth*0.5+1.2))
            if door.y<=1:continue
            found=false
            loop seed in catalog.seeds:
                if seed.id!=s.id:continue
                loop home in seed.homes:
                    if home.key=="home:{s.id}:{p.seed}":
                        assert(home.door==door);found=true
            assert(found);homes+=1;sites.push(site_from_parcel(p))
    # Include adjacent homes when checking courtyard/fixture clearance, just
    # as the lazy fixture publisher does around the three baked households.
    neighbors: TownSite[];keys: {int:bool}={}
    loop site in sites:
        door=site_point(site,0,site.depth*0.5+1.2)
        loop cell in place_candidate_cells(s,place_to_local(s,door)):
            if let lot=place_lot(s,cell.0,cell.1):
                if lot.seed in keys:continue
                if let p=place_ground_lot(s,lot):
                    keys[lot.seed]=true;neighbors.push(site_from_parcel(p))
    loop site in sites:
        origin=render_origin(site.at)
        e=site_entry(site)
        parts: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
        props: Instance3D[][]=[loop k in 0..TOWN_PROP_COUNT: []]
        paths: Vertex3D[]
        arch_site(parts,props,site,true,origin)
        arch_courtyard(parts,props,paths,site,neighbors,origin)
        arch_rural_garden(parts,site,neighbors,origin)
        assert(parts[14].len()==e.steps)
        loop k in 0..e.steps:
            p=mix(e.outside,e.front,f32((f64(k)+0.5)/f64(e.steps)))
            top=f64(transform_point(parts[14][k].model,vec3(0,1,0)).y)
            error=abs(top-entry_height(e,p,-1000));worst=max(worst,error)
            assert(error<0.002);treads+=1
            # Exercise the player's full spatial/contact lookup as well as
            # the local entry formula. Another overlapping deck may be higher,
            # but the player must never fall through this rendered tread.
            assert(walk_height([],f64(p.x),f64(p.y))>=top-0.002)
        loop fixture in town_fixture_venues(s.id,site,neighbors):
            if fixture.kind==.alley:continue
            kind=if fixture.kind==.seat:11 else:if fixture.kind==.laundry:10 else:8
            found=false
            loop inst in parts[kind]:
                if length(inst.model[3].xyz-(fixture.prop_pos-origin))<0.05:found=true
            assert(found);fixtures+=1
        loop group in parts:
            loop inst in group:assert(length(inst.model[3].xz)<1600)
    if s.harbor.len()>0:
        ports+=1
        loop b in settlement_port(s).buildings:
            # Port foundation/plaster partition stays at -2 for every building.
            assert(b.width>0 and b.depth>0 and b.height>0)
    print("PASS {s.id} {s.name}: homes={sites.len()} country={s.country} kind={s.kind}")
print("TOTAL places={places} ports={ports} homes={homes} treads={treads} fixtures={fixtures} worst_tread_gap={worst}")
