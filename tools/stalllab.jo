# Deterministic stall traces at the player's 3.3x drawn speed. No window or audio.
# STALL_TRIAL=0 records the liked model; STALL_SCALE=1 compares unscaled physics.
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as planes

stall_spec = (kind: planes.Craft) -> fl.CraftSpec:
    k = fl.craft_spec(kind, planes.build_craft(kind, planes.LIVERIES[0]).contacts)
    k.player = true
    k

stall_start = (k: fl.CraftSpec, scenario: int) -> fl.CraftState:
    speed = k.stall_speed * fl.pure_k(k)
    s = fl.CraftState(position = vec3(0, 1500, 0), fuel = k.fuel_capacity)
    s.velocity = vec3(0, 0, -speed * 1.15)
    s.orientation = quat_euler(0.06, 0, 0)
    if scenario == 1: s.velocity.x = f32(speed * 0.12)
    if scenario == 2: s.throttle = 0.7
    if scenario == 3:
        s.velocity = vec3(0, speed * 0.30, 0)
        s.orientation = quat_euler(PI * 0.5, 0, 0)
        s.throttle = 1.0
    if scenario == 4:
        s.velocity = vec3(0, speed * 0.15, 0)
        s.orientation = quat_euler(PI * 0.5, 0, 0)
    if scenario == 5: s.damage.parts[2].health = 0.35
    s.airspeed = f64(length(s.velocity))
    s

stall_controls = (s: fl.CraftState, scenario: int) -> fl.Controls:
    c = fl.Controls(assist = 0.0)
    if scenario == 0: c.pitch = if s.time < 3: 0.3 else: 0.0
    if scenario == 1 or scenario == 2 or scenario == 5:
        c.pitch = 0.8; c.yaw = 0.8
        if scenario == 2: c.throttle = 0.7; c.roll = 0.6
    if scenario == 3: c.throttle = 1.0; c.yaw = if s.time < 3.0: 1.0 else: 0.0
    recover_at = if scenario == 3 or scenario == 4: 3.0 else: 8.0
    if s.time >= recover_at:
        # Power idle, opposite rudder, stick forward until the wings reattach; then neutral
        # rudder, level the wings and ease out of the resulting dive before adding power.
        separated = f64(s.wing_separation.x + s.wing_separation.y) * 0.5
        c = fl.Controls(assist = 0.0)
        if separated > 0.20 or (s.time < recover_at + 0.25):
            c.pitch = -1.0
            c.yaw = if abs(f64(s.angular_velocity.y)) > 0.10: sign(f64(s.angular_velocity.y)) else: 0.0
        else:
            r = quat_rotate(s.orientation, vec3(1, 0, 0)); u = quat_rotate(s.orientation, vec3(0, 1, 0))
            bank = atan2(-f64(r.y), f64(u.y))
            c.roll = clamp(-bank * 1.5, -1.0, 1.0)
            pitch = asin(clamp(f64(fl.forward(s).y), -1.0, 1.0))
            if abs(bank) < 0.5: c.pitch = clamp((0.05 - pitch) * 2.0, -0.4, 1.0)
            if abs(bank) < 0.5 and pitch > -0.3: c.throttle = 1.0
    c

main = ():
    fl.set_speed_scale(to_float(env("STALL_SCALE") ?? "3.3") ?? 3.3)
    tw.set_tweaks(tw.Tweaks(chaotic_stalls = (env("STALL_TRIAL") ?? "1") == "1"))
    print("kind,scenario,t,x,alt,z,speed,pitch,roll,yaw,wx,wy,wz,aoa,left,right,buffet,qx,qy,qz,qw")
    loop id in 0..planes.CRAFT_NAMES.len():
        k = stall_spec(planes.Craft(id))
        loop scenario in 0..6:
            s = stall_start(k, scenario)
            loop i in 0..60 * 22:
                fl.step(k, s, stall_controls(s, scenario), fl.FlightEnv(), 1.0 / 60.0)
                if i % 6 == 0:
                    r = quat_rotate(s.orientation, vec3(1, 0, 0)); u = quat_rotate(s.orientation, vec3(0, 1, 0))
                    print("{id},{scenario},{s.time:.6},{s.position.x:.6},{s.position.y:.6},{s.position.z:.6},{s.airspeed / fl.pure_k(k):.6},{asin(clamp(f64(fl.forward(s).y), -1.0, 1.0)):.6},{atan2(-f64(r.y), f64(u.y)):.6},{fl.heading(s):.6},{s.angular_velocity.x:.6},{s.angular_velocity.y:.6},{s.angular_velocity.z:.6},{s.aoa:.6},{s.wing_separation.x:.6},{s.wing_separation.y:.6},{s.buffet:.6},{s.orientation.x:.6},{s.orientation.y:.6},{s.orientation.z:.6},{s.orientation.w:.6}")
