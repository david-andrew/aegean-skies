# A bounded real saved-state diagnostic, never a synthetic resource/refit fixture.
build:
    name = "worldlog"
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_types.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
use '../src/living_guard.jo'
use '../src/living_checks.jo'
use '../src/living_caravan_audit.jo'
use '../src/living_money.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true; init_settlements(); finish_settlement_registry()
source=env("WORLD_SOURCE") ?? "phase5-recovery-v11"
saved=load_game(42,source); assert(saved is SaveGame)
w=saved.world
set_living_strict(false); set_caravan_audit(true)
start=w.minute; steps=to_int(env("WORLD_STEPS") ?? "1440") ?? 1440
loop _ in 0..steps:
    step_minute(w)
    assert(living_faults().len()==0)
    loop place in w.places:
        if not inventory_valid(place.market.inventory):
            eprint("INVENTORY_FAILURE minute={w.minute} place={place.id} qty={place.market.inventory.qty} reserved={place.market.inventory.reserved}")
            assert(false,"Detailed reservation was consumed by another owner")
    if w.minute%360==0:
        errors=invariant_errors(w); assert(errors.len()==0,errors.join("; "))
eprint("CART_AUDIT source={source} from={start} to={w.minute} hash={canonical_hash(w)}")
loop line in caravan_audit_report(): eprint(line)
