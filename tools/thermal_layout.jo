# Lay out each bath on its hillside: the upper terrace's height from the
# uncarved ground, the foot of the last flight, and (with "paths") the surveyed
# path from that foot to the town's square, written to src/thermal_paths_data.jo.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/thermal_sites.jo'
use '../src/water_field.jo'
use '../src/access_path_bake.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements(true)
raw=(p:vec2)->f64:water_carve(f64(p.x),f64(p.y),new_land_relief(f64(p.x),f64(p.y)).0)
source="# Surveyed paths from each bath's last flight to its town square (tools/thermal_layout.jo).\nTHERMAL_PATHS:{{int:vec3[]}}={{\n"
loop site in THERMAL_SITES:
    # Each terrace is flush with the highest ground inside it (its uphill edge),
    # and at least 0.9 m below the one above.
    levels:f64[]
    loop t in THERMAL_TERRACES:
        heights:f64[]
        loop j in 0..9:
            loop i in 0..9:
                q=mix(t.low,t.high,vec2(f32(i)/8.0,f32(j)/8.0))
                heights.push(raw(thermal_world(site,vec3(q.x,0,q.y)).xz))
        heights.sort()
        top=heights[heights.len()/2]   # (median: cut behind, a modest wall in front)
        if levels.len()>0:top=min(top,levels[levels.len()-1]-0.9)
        levels.push(round((top+0.1)*20.0)/20.0)
    t3=levels[2];z=22.0;foot=thermal_world(site,vec3(4.5,0,22))
    loop z<80.0:
        q=thermal_world(site,vec3(4.5,0,f32(z)))
        if 0.6*(z-21.0)>=abs(raw(q.xz)-t3):foot=vec3(q.x,f32(raw(q.xz)),q.z);break
        z+=0.5
    print("SITE {site.place} {site.name}: levels {levels}; foot at z {z:.1f}")
    print("    ThermalSite({site.place},\"{site.name}\",{site.country},vec3({site.center.x},{levels[0]},{site.center.z}),{site.yaw},vec3({foot.x},{foot.y},{foot.z}),vec2({levels[0]-levels[1]:.2f},{levels[0]-levels[2]:.2f})),")
    if args().len()>1 and args()[1]=="paths":
        s=world_settlements[settlement_by_id[site.place]]
        path=access_track(site.road.xz,s.center.xz,4.0,300.0,true,false,180000)
        if path.len()<2:path=access_track(site.road.xz,s.center.xz,4.0,300.0,true,true,180000)
        print("  path to {s.name}: {path.len()} points")
        source+="    {site.place}:["
        loop p in path:source+="vec3({p.x},{p.y},{p.z}),"
        source+="],\n"
source+="}}\n"
if args().len()>1 and args()[1]=="paths":assert(write_file(join_path(dir_name(args()[0]),'../src/thermal_paths_data.jo'),source))
if args().len()>1 and args()[1]=="profile":
    loop site in THERMAL_SITES:
        line="{site.name}:"
        loop z in -4..7:line+=" z{z*5}={raw(thermal_world(site,vec3(0,0,f32(z*5))).xz):.1f}"
        print(line)
        line="  across:"
        loop x in -4..5:line+=" x{x*5}={raw(thermal_world(site,vec3(f32(x*5),0,0)).xz):.1f}"
        print(line)
if args().len()>1 and args()[1]=="grid":
    site=THERMAL_SITES[0]
    loop j in -4..6:
        z=f64(j)*5.0;line="z{z:5.0f}:"
        loop i in -5..6:line+=" {raw(thermal_world(site,vec3(f32(i*5),0,f32(z))).xz):6.1f}"
        print(line)
