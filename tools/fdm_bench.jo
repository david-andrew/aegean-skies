# Cost of the player's flight step, the liked model against flight model v2: FDM_MODEL=0|1,
# FDM_STEPS=n frames at 60 Hz (two 120 Hz substeps each) of the Gull flown about at the 3.3x scale.
# Wall-clock only on the quiet laptop; on the desktop compare instruction counts (valgrind).
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as planes

main = ():
    model = to_int(env("FDM_MODEL") ?? "1") ?? 1
    steps = to_int(env("FDM_STEPS") ?? "100000") ?? 100000
    fl.set_speed_scale(3.3); fl.set_lift_scale(3.3)
    tw.set_tweaks(tw.Tweaks(flight_model = model))
    k = fl.craft_spec(.gull, planes.build_craft(.gull, planes.LIVERIES[0]).contacts)
    k.player = true
    s = fl.CraftState(position = vec3(0, 1200, 0), velocity = vec3(0, 0, f32(-k.cruise_speed)), fuel = k.fuel_capacity, water_age = 1.0)
    s.throttle = 0.8; s.rpm = 0.8
    e = fl.FlightEnv()
    started = time_ns()
    loop i in 0..steps:
        t = f64(i) / 60.0
        c = fl.Controls(throttle = 0.8, pitch = clamp(sin(t * 0.7) * 0.6 + 0.05, -1.0, 1.0), roll = clamp(sin(t * 1.3) * 0.8, -1.0, 1.0))
        fl.step(k, s, c, e, 1.0 / 60.0)
        # (kept aloft: reset to the start pose before the ground)
        if s.position.y < 400.0 or s.position.y > 2200.0: s.position = vec3(s.position.x, 1200, s.position.z); s.precise_ready = false
    us = f64(time_ns() - started) / f64(steps) / 1000.0
    print("model={model} steps={steps}: {us:.3} us per 60 Hz frame (host-dependent), checksum {s.position.x + s.position.z:.3}")
