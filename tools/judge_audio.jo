use '../src/airsound.jo'
use '../src/aircraft_catalog.jo'
# Export procedural samples for offline spectra. Never starts an audio device or plays a sound.
use '../src/sound.jo'
use '../src/combat_sound.jo'
folder=env("JUDGE_AUDIO_DIR") ?? "."
export_wave=(name:str,s:Sound):
    assert(write_bytes("{folder}/{name}.f32",to_bytes(s.samples)))
    print("{name},{MIX_RATE},{s.samples.len()/2}")
loop k in 0..4:export_wave("engine-{k}",engine_loop(EngineVoice(k)))
export_wave("air-rush",make_rush());export_wave("wires",make_singing())
export_wave("cloth",make_flap());export_wave("cloth-hit",make_flap_hit(101))
export_wave("heavy-cloth",make_flap_heavy());export_wave("rumble",make_rumble())
export_wave("howl",make_howl());export_wave("deep",make_deep());export_wave("gale",make_gale())
export_wave("flex-up",make_oilcan(0,true));export_wave("flex-down",make_oilcan(10,false))
loop k in 0..9:export_wave("combat-{k}",combat_wave(k))
