# Deterministic open-water regression view, with no shore, sky, props or effects.
# SEA_HOUR and SEA_WIND select lighting and weather; simulation time stays fixed.
use '../src/sea.jo'
use '../src/look.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'
window("Sea detail guard",640,360)
enable_world_depth()
init_sea()
water=build_sea_mesh()
img=image(1,1)
img.set(0,0,vec4(1,0,0,1))
depth=texture(img)
expanded_depth=depth;nearby_depth=depth
hour=to_float(env("SEA_HOUR")??"6.916667")??6.916667
speed=to_float(env("SEA_WIND")??"6")??6
wind=Wind(vec2(0.8,0.6),speed,vec2(0,0))
draw=():
    clear(BLACK);hide_sky()
    render_camera(vec3(0,20,0),vec3(0,-0.3,-1),62,0.1,300000)
    draw_custom(():
        clear_world_depth()
        draw_sea(water,depth,light_at(hour),123.5,wind)
    )
