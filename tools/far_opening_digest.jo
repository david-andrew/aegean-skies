# The living world's opening (far economy, harbours and opening trade, as the game's start builds
# it) as digests, to show a change to that code keeps every result: the game's own world (seed 0)
# and fresh worlds of other seeds, each at the opening and after a simulated day.
# Run headlessly: env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_FRAMES=1 sloppy --release tools/far_opening_digest.jo
# FAR_DIGEST_SEEDS="1 7 42" picks the extra seeds; FAR_DIGEST_MINUTES the day's length (1440).
build:
    name = "Aegean far opening digest"
import '../aegean.jo' as game
import '../src/living_world.jo' as living
import '../src/life_scene.jo' as daily_scene
use '../src/living_save.jo'
use '../src/traffic.jo'

minutes = to_int(env("FAR_DIGEST_MINUTES") ?? "1440") ?? 1440
seeds: int[]
loop s in split(env("FAR_DIGEST_SEEDS") ?? "1 7 42", " "):
    if let v = to_int(s): seeds.push(v)

report = (label: str, w: mut living.World):
    print("FAR_DIGEST {label} opening far {hash(to_text(w.far))} world {canonical_hash(w)} districts {w.far.districts.len()} vehicles {w.far.vehicles.len()}")
    living.advance_minutes(w, minutes)
    print("FAR_DIGEST {label} after {minutes} min world {canonical_hash(w)}")

w0 = game.living_world
report("game", w0)
loop s in seeds:
    began = time()
    w = living.build_world(u64(s), harbors_from_towns(game.towns))
    daily_scene.configure_life_scene(w, game.towns)
    print("FAR_DIGEST seed {s} opening built in {(time() - began) * 1000.0:.0} ms")
    report("seed {s}", w)
exit(0)
