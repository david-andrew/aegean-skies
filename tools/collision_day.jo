# CPU-only, real clock/scene leases and rendered actor interpolation for a full day.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/objects.jo'
use '../src/townsfolk.jo'
use '../src/world_point.jo'
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_scene.jo'
use '../src/living_guard.jo'
use '../src/life_scene.jo'
use '../src/cargo_scene.jo'
use '../src/living_domestic.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements();finish_settlement_registry()
towns=[loop s in SETTLEMENTS:build_town(s)]
name=env("COLLIDE_DAY_TOWN") ?? "Olythoria"
focus=vec3(0,0,0);place= -1
loop s in world_settlements:
    if s.name==name:focus=s.center;place=s.id
assert(place>=0)
w=build_world(u64(0))
configure_cargo_scene(w,towns);configure_life_scene(w,towns)
folks: Folk[]
sync_folk(folks,w,towns)
close_for: {str:int}={};failures: {str:bool}={}
worst=0;observed=0;minimum=1e9
frames=to_int(env("COLLIDE_DAY_FRAMES") ?? "172800") ?? 172800
loop frame in 0..frames:
    scene_clock_begin(w)
    step_cargo_scene(w,towns,focus,1.0/60)
    step_life_scene(w,towns,focus,1.0/60)
    scene_clock_end(w)
    if frame%120==0:sync_folk(folks,w,towns)
    update_folk(folks,w,towns,focus,1.0/60)
    if frame<600 or frame%6!=0:continue
    visible=[loop f in folks:if f.shown and length(f.pos-focus)<360:f]
    observed=max(observed,visible.len())
    close: {str:bool}={}
    loop a in 0..visible.len():
        loop b in a+1..visible.len():
            pa=visible[a].precise;pb=visible[b].precise
            if abs(pa.y-pb.y)>1:continue
            dx=pa.x-pb.x;dz=pa.z-pb.z;distance=sqrt(dx*dx+dz*dz)
            minimum=min(minimum,distance)
            if distance>=0.5:continue
            i=visible[a].person;j=visible[b].person;key="{min(i,j)}:{max(i,j)}"
            close[key]=true;close_for[key]=close_for.get(key,0)+6
            worst=max(worst,close_for[key])
            if close_for[key]>120 and not (key in failures):
                failures[key]=true
                print("OVERLAP town={name} minute={w.minute} ids={i},{j} names={w.people[i].name}|{w.people[j].name} distance={distance:.6} poses={visible[a].pos}|{visible[b].pos}")
    loop key in close_for.keys():
        if not (key in close):close_for.remove(key)
    if frame%7200==0:print("DAY_PROGRESS {name} minute={w.minute} visible={visible.len()} failures={failures.len()}")
print("DAY_RESULT {name} frames={frames} minute={w.minute} peak_visible={observed} minimum={minimum:.6} longest_overlap_seconds={f64(worst)/60:.3} pairs_over_two_seconds={failures.len()}")
assert(failures.len()==0)
