# The floating notes' per-frame work, counted: a number of the band's set loaded into a note feed
# (once a number), then NOTE_BENCH_FRAMES frames at 60 a second of taking every note, rising, ageing and
# placing them (all but the drawing's few primitives). Run it under valgrind with two frame
# counts and take the difference: instructions per frame, start-up and loading cancelled out.
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/band_request.jo'
use '../src/bar_band.jo'
use '../src/live_notes.jo'
use '../src/note_cue.jo'

frames = int(to_float(env("NOTE_BENCH_FRAMES") ?? "0") ?? 0.0)
b = BandFeed()
live_notes_load(b.feed, bar_note_events(BAR_SET[1].piece, 1), BAR_SET[1].lead)
c = NoteCue()
shown = 0
sum = 0.0
alive = 0
loop k in 0..frames:
    now = f64(k) / 60.0
    frame = int(now * f64(MUSIC_RATE)) % max(1, MUSIC_PIECES[BAR_SET[1].piece].frames)
    note_cue_age(c, now)
    loop ch in note_cue_take(c, b.feed.notes, frame):
        note_cue_rise(c, ch, vec3(0, 1.9, 0), now, none, f64(frame - ch[0].start) / f64(MUSIC_RATE))
        shown += 1
    alive = max(alive, c.rising.len())
    loop r in c.rising: sum += f64(note_pos(c, r, now).y) * note_age_alpha(r, now) * note_heard_alpha(35.0, 0.0)
print("NOTE_BENCH frames {frames} notes {b.feed.notes.len()} shown {shown} ({f64(shown) / max(1.0, f64(frames) / 60.0):.2} a second) most in the air {alive} check {sum:.1}")
