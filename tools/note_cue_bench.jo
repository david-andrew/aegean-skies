# The floating notes' per-frame work, counted: a number of the band's set loaded into a note feed
# (once a number), then NOTE_BENCH_FRAMES frames at 60 a second of picking, rising, ageing and
# placing the notes (all but the drawing's few primitives). Run it under valgrind with two frame
# counts and take the difference: instructions per frame, start-up and loading cancelled out.
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/band_request.jo'
use '../src/bar_band.jo'
use '../src/live_notes_shim.jo'
use '../src/band_feed_tmp.jo'
use '../src/note_cue.jo'

frames = int(to_float(env("NOTE_BENCH_FRAMES") ?? "0") ?? 0.0)
b = BandFeed()
live_notes_load(b.feed, bar_note_events(BAR_SET[1].piece, 1), BAR_SET[1].lead)
c = NoteCue()
shown = 0
sum = 0.0
loop k in 0..frames:
    now = f64(k) / 60.0
    frame = int(now * f64(MUSIC_RATE)) % max(1, MUSIC_PIECES[BAR_SET[1].piece].frames)
    note_cue_age(c, now)
    if let n = note_cue_pick(c, b.feed.notes, frame, now):
        note_cue_rise(c, n, vec3(0, 1.9, 0), now)
        shown += 1
    loop r in c.rising: sum += f64(note_pos(r, now).y) * note_age_alpha(r, now) * note_heard_alpha(35.0, 0.0)
print("NOTE_BENCH frames {frames} notes {b.feed.notes.len()} shown {shown} ({f64(shown) / max(1.0, f64(frames) / 60.0):.2} a second) check {sum:.1}")
