# File-free cost check for the announcer, beside a music piece in the same harness.
# Run wall-clock measurements on redfox under bench.lock (native, and --target wasm in muted
# headless Chromium). Each programme renders 60 s in 800-sample (50 ms) blocks through the
# station leveller and the receiver at strength 0.55, detuning 4, as music_budget.jo does.
use '../src/radio_synth.jo'
use '../src/radio.jo'
use '../src/voice_text.jo'

texts = [
    "The harbor office reports: An attack on cargo was reported near Kalamos. Report time 09:30; 15 game minutes ago.",
    "At Porto Vecchio: squalls; wind from the south, 7 metres per second. This is an observation, not a forecast.",
    "Orenthia National: Orenthia calls for discipline and public service. Stand together; honor the crews who carry our trade.",
    "Which travels farther after sunset: our radio signal or a harbor clerk's promise? The radio signal. No prizes, friends, only another tune."
]
stations = [13,14,13,14]

report = (label: str, costs: f64[], energy: f64):
    sorted = costs
    sorted.sort()
    n = sorted.len()
    total = 0.0
    loop c in costs: total += c
    print("{label} blocks={n} mean_ms={total/f64(n):.4} p50_ms={sorted[n/2]:.4} p95_ms={sorted[n*95/100]:.4} p99_ms={sorted[n*99/100]:.4} max_ms={sorted[n-1]:.4} energy={energy:.9}")

begin = time_ns()
s = make_radio_synth()
radio_voice_prepare(s)
if not s.voice_bank.ready:
    eprint("no announcer data: AEGEAN_VOICE_DATA names an unreadable or invalid voice file")
    exit(1)
print("voice_prepare_ms={f64(time_ns()-begin)/1e6:.3}")
loop k in 0..texts.len():
    start = time_ns()
    radio_synth_program(s,.speech,7,0.0,[],texts[k],radio_voice_style(stations[k],.news),10.0)
    _ = radio_render(s,800,0.55,4)
    print("speech{k} program_and_first_block_ms={f64(time_ns()-start)/1e6:.4} bulletin_s={f64(s.voice.plan.count)*VOICE_FRAME:.2} period_s={f64(s.speech_period)/f64(RADIO_RATE):.1}")
    costs: f64[]
    energy = 0.0
    loop i in 0..1200:
        b0 = time_ns()
        block = radio_render(s,800,0.55,4)
        costs.push(f64(time_ns()-b0)/1e6)
        loop v in block: energy += f64(v)*f64(v)
    report("speech{k}",costs,energy)
    # Speaking blocks only (the receiver alone runs in the pauses between repeats).
    plan0 = time_ns()
    radio_synth_program(s,.speech,7,0.0,[],texts[k],radio_voice_style(stations[k],.news),10.0)
    plan_ms = f64(time_ns()-plan0)/1e6
    spoken: f64[]
    blocks = s.voice.plan.count*VOICE_HOP/800
    loop i in 0..blocks:
        b0 = time_ns()
        _ = radio_render(s,800,0.55,4)
        spoken.push(f64(time_ns()-b0)/1e6)
    report("speech{k}-talking",spoken,0.0)
    # (one bulletin end to end: planning it, then every 50 ms block of it through the studio, leveller and receiver)
    total_spoken = 0.0
    loop c in spoken: total_spoken += c
    print("speech{k}-bulletin plan_ms={plan_ms:.3} blocks_ms={total_spoken:.3} total_ms={plan_ms+total_spoken:.3} speech_s={f64(s.voice.plan.count)*VOICE_FRAME:.2} blocks={blocks}")
# The same harness on a music piece for a direct comparison (Magnetic Rag, the receiver as above).
radio_synth_prepare(s)
radio_synth_program(s,.foxtrot,7,0.0)
costs: f64[]
energy = 0.0
loop i in 0..1200:
    b0 = time_ns()
    block = radio_render(s,800,0.55,4)
    costs.push(f64(time_ns()-b0)/1e6)
    loop v in block: energy += f64(v)*f64(v)
report("music-foxtrot",costs,energy)
print("DONE")
print("VOICE_BUDGET_DONE")
