# Offline listening reel from the game's actual loops and pitch/volume laws. No audio device.
use '../src/sound.jo'
use '../src/airsound.jo'
use '../src/flight_feedback.jo'
folder=env("FLIGHT_AUDIO_DIR") ?? "."
assert(save_wav("{folder}/water-run.wav",make_water_run()))
engine=engine_loop(); wind=make_rush(); wires=make_singing(); water=make_water_run(); creak=make_oilcan(1,true)
phases=fill(0.0,4)
seconds=24.0
out=fill(f32(0),int(seconds*f64(MIX_RATE))*2)
# 0-4 cruise; 4-8 climb under load; 8-12 accelerating dive; 12-16 idle glide;
# 16-20 planing run; 20-24 water releases. A load creak marks the pull at 4s.
loop i in 0..out.len()/2:
    t=f64(i)/f64(MIX_RATE)
    speed=if t<8: 55.0 else: if t<12: 55.0+(t-8.0)*12.0 else: if t<16: 75.0 else: if t<20: 8.0+(t-16.0)*7.0 else: 36.0
    throttle=if t<12: 0.85 else: if t<16: 0.0 else: 1.0
    climb=if t>=4 and t<8: smoothstep(4.0,5.0,t) else: 0.0
    glide=if t>=12 and t<16: smoothstep(12.0,13.0,t) else: 0.0
    wet=if t>=16 and t<20: smoothstep(3.0,30.0,speed) else: 0.0
    gains=[0.22+0.33*throttle+0.12*clamp(speed/85.0,0.0,1.4),curve(speed,[10.0,0.02,40.0,0.06,66.0,0.11,85.0,0.16,125.0,0.22,160.0,0.26]),curve(speed,[50.0,0.0,85.0,0.04,125.0,0.07,160.0,0.08])+0.075*glide,0.30*wet]
    pitches=[loaded_engine_note(engine_note(throttle,speed),climb),0.55+0.6*clamp((speed-5.0)/85.0,0.0,1.8),0.7+speed/150.0,0.65+0.65*wet]
    loops=[engine,wind,wires,water]
    value=0.0
    loop j in 0..4:
        s=loops[j]; n=s.samples.len()/2
        a=int(phases[j])%n;b=(a+1)%n;w=phases[j]-floor(phases[j])
        value+=(f64(s.samples[a*2])*(1.0-w)+f64(s.samples[b*2])*w)*gains[j]
        phases[j]+=pitches[j]
    hit=i-int(4.1*f64(MIX_RATE))
    if hit>=0 and hit<creak.samples.len()/2: value+=f64(creak.samples[hit*2])*0.22
    value*=min(1.0,min(t,seconds-t)*10.0)
    out[i*2]=f32(value);out[i*2+1]=f32(value)
assert(save_wav("{folder}/flight-reel.wav",Sound(out)))
print("flight-reel.wav: cruise 0-4s, climb 4-8s, dive 8-12s, idle glide 12-16s, water run 16-20s, release 20-24s")
