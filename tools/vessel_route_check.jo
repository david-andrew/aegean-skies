# Offline route acceptance. Never called at game startup.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/vessel_types.jo'
use '../src/sea_routes.jo'
use '../src/vessels.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_settlements(false)
f = VesselFleet()
loop pair in [(0,1),(1,3),(4,0),(10001,10003)]:
    kind = if pair.0 > 100: VesselKind.passenger_steamer else: VesselKind.island_ferry
    id = request_harbor_lane(f,pair.0,pair.1,kind)
    assert(id >= 0)
    calls = 0; samples = 0; slowest = 0.0; total = 0.0; peak = memory_in_use()
    loop calls < 200000 and f.lanes[id].status != .ready and f.lanes[id].status != .blocked:
        begin = time()
        samples += step_sea_navigation(f,64); calls += 1
        elapsed = time()-begin; total += elapsed; slowest = max(slowest,elapsed); peak = max(peak,memory_in_use())
    lane = f.lanes[id]
    print("{pair}: {lane.status} points={lane.points.len()} distance={lane.distance:.0} samples={samples} retries={lane.retries} anchorage={lane.anchorage} {lane.reason}")
    assert(lane.status == .ready)
    print("navigation batches={calls} total={total:.3}s max_batch={slowest*1000:.3}ms peak={peak} resident={memory_in_use()}")

# A full bounded fleet uses fixed ticks even when no vessel is rendered.
f = VesselFleet()
loop k in 0..VESSEL_LIMIT:
    a = vec2(f32(k*150),-20000); b = a+vec2(0,-10000)
    # Four shared open-water lanes with caller-supplied waiting order.
    lane = k%4
    if k < 4: f.lanes.push(SeaLane(k,-1,-1,a,b,6,12,status=.ready,points=[a,b],distance=10000))
    a = f.lanes[lane].start
    assert(spawn_vessel(f,Vessel(k,.motor_caique,k,1,lane=lane,position=vec3(a.x,0,a.y))))
t = time(); slowest = 0.0
loop k in 0..900:
    begin = time(); step_vessels(f,vec2(8,0),VESSEL_DT); slowest = max(slowest,time()-begin)
print("128 vessels 900 ticks: {time()-t:.3}s max_tick={slowest*1000:.3}ms resident={memory_in_use()}")
