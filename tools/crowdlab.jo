# Offline audition of the crowd bed (src/ambience_crowd.jo): the harbour's and the cafe's beds,
# played round for CROWD_SECONDS (default 20), to compare with the fitting references by ear and
# by measure (docs/crowd-reference.md). CROWD_FIT="near=4,rt60=0.9,..." tries other settings.
# CROWD_SAMPLES=<scratch dir> sloppy --release tools/crowdlab.jo
use '../src/ambience_synth.jo'
use '../src/ambience_crowd.jo'

dir = env("CROWD_SAMPLES") ?? panic("Set CROWD_SAMPLES to an existing scratch directory")
seconds = to_int(env("CROWD_SECONDS") ?? "") ?? 20
tag = env("CROWD_TAG") ?? ""

tuned = (base: CrowdFit) -> CrowdFit:
    fit = base
    loop pair in split(env("CROWD_FIT") ?? "", ","):
        parts = split(pair, "=")
        if parts.len() != 2: continue
        v = to_float(parts[1]) ?? panic("CROWD_FIT: {pair}")
        match parts[0]:
            "near": fit.near = int(v)
            "mid": fit.mid = int(v)
            "far_level": fit.far_level = v
            "rate_min": fit.rate_min = v
            "rate_max": fit.rate_max = v
            "phrase_min": fit.phrase_min = v
            "phrase_max": fit.phrase_max = v
            "pause_min": fit.pause_min = v
            "pause_max": fit.pause_max = v
            "breath": fit.breath = v
            "jitter": fit.jitter = v
            "shimmer": fit.shimmer = v
            "plosive": fit.plosive = v
            "fricative": fit.fricative = v
            "sonorant": fit.sonorant = v
            "coda": fit.coda = v
            "rt60": fit.rt60 = v
            "wet_near": fit.wet_near = v
            "wet_mid": fit.wet_mid = v
            "wet_far": fit.wet_far = v
            "steps": fit.steps = int(v)
            "spread": fit.spread = v
            "low_db": fit.low_db = v
            "low_hz": fit.low_hz = v
            "high_db": fit.high_db = v
            "high_hz": fit.high_hz = v
            "swell": fit.swell = v
            "burst": fit.burst = v
            "share": fit.share = v
            "rumble": fit.rumble = v
            _: panic("CROWD_FIT: no {parts[0]}")
    fit

loop kind in [AmbienceKind.murmur,AmbienceKind.cafe]:
    started = time()
    s = if env("CROWD_FIT") == none: make_ambience(kind) else: crowd_sound(crowd_bed(int(ambience_seconds(kind)*f64(MIX_RATE)+0.5),1,tuned(if kind == .cafe: CROWD_CAFE else: CROWD_QUAY)),0.091)
    made = time()-started
    n = s.samples.len()
    out = fill(f32(0),MIX_RATE*2*seconds)
    loop i in 0..out.len(): out[i] = s.samples[i%n]
    assert(save_wav(dir+"/crowd-"+str(kind)+tag+".wav",Sound(out)))
    print("{kind}: {f64(n/2)/f64(MIX_RATE):.1} s loop, made in {made:.2} s")
