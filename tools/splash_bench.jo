# Full-game splash regression fixture. Copy unchanged to the pinned baseline.
# SPLASH_CASE=harbour|takeoff|landing|clouds. The flying cases repeat a three-second
# physical sequence, including particle updates and normal world/sea rendering.
build:
    name = "Aegean splash benchmark"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/flight.jo'
use '../src/pilot.jo'
use '../src/world_point.jo'
use '../src/sea.jo'
use '../src/look.jo'
use '../src/combat.jo'
use '../src/world.jo'
import '../src/living_types.jo' as data
use 'judge_scene.jo'
case=env("SPLASH_CASE") ?? "harbour"
assert(case=="harbour" or case=="takeoff" or case=="landing" or case=="clouds")
moving=case=="takeoff" or case=="landing"
if case=="clouds":game.pc.cockpit_view=true
if moving:
    k=game.pc.spec
    s=water_start(k,vec3(0,0,8000))
    s.moored=false;s.on_water=true;s.water_age=1.0;s.throttle=1.0
    s.velocity=vec3(0,0,-19.0*pure_k(k))
    if case=="landing":
        s=CraftState(position=vec3(0,k.float_height+0.4,8000),velocity=vec3(0,-1.5,-k.stall_speed*pure_k(k)*1.15),fuel=k.fuel_capacity,water_age=1.0)
        wind_now.speed=12.0
    s.precise=world_point(s.position);s.published=s.position;s.precise_ready=true
    game.pc=Flyer(game.pc.kind,game.pc.model,k,s,cam_pos=s.position,throttle=if case=="landing":0.0 else:1.0)
    game.me.mode=.aboard;game.me.pos=s.position
    game.rope.tied=false;game.was_moored=false
    game.judge_origin=s.position
    offset=vec3(k.span*1.0,max(3.0,k.span*0.28),k.span*0.95)
    game.judge_camera=JudgeView(s.position+offset,s.position+vec3(0,-0.3,0),case)
    game.judge_ready=true
initial=game.pc
record=game.living_world.people[game.living_world.player].craft
initial_record=game.living_world.aircraft[record]
if moving:
    initial_record.move_owner=.scene
    initial_record.pose=data.Pose(pos=initial.state.position,vel=initial.state.velocity,rot=initial.state.orientation,throttle=int(initial.throttle*1000))
    data.place_pose(initial_record.pose,craft_point(initial.state))
    print("SPLASH_SITE ground={surface_height(f64(initial.state.position.x),f64(initial.state.position.z))}")
initial_particles=game.spray_ps
initial_wakes=game.wakes
initial_vapor=game.vapor_trails
bench_draw:()->void=game.draw
record_stats()
frame=0
update=(dt:f64):
    global frame
    if moving and frame%180==0:
        game.pc=initial;game.spray_ps=initial_particles
        # Rewinding a physical pose must not refund fuel already consumed in the world.
        fuel=game.living_world.aircraft[record].fuel_ml
        game.living_world.aircraft[record]=initial_record
        game.living_world.aircraft[record].fuel_ml=fuel
        game.pc.state.fuel=f64(fuel)/1000.0
        ci=combat_index(game.battle,record)
        if ci>=0:game.battle.actors[ci]=Combatant(record,game.living_world.player,0,initial.spec,game.pc.state,external=true,human=true,previous=initial.state.position,previous_point=craft_point(initial.state),model=initial.model)
        game.wakes=initial_wakes;game.vapor_trails=initial_vapor
        game.t=0;game.plunge=0;game.plunge_v=0
        seed_random(12345)
    game.update(1.0/60.0)
    frame+=1
    if frame%60==0:
        s=game.pc.state
        print("SPLASH_TRACE {frame} {s.position} {s.velocity} {s.on_water} {s.hull_damage} {game.spray_ps.items.len()}")
draw=():
    bench_draw()
    if frame==240 or frame==480 or frame==720:
        print("SPLASH_STATS {frame} {frame_stats_line()}")
