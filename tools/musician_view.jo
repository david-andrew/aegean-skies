# Every kind of musician in a row on a floor, each playing a real part from the music catalogue at
# the same moment, for looking at how they hold and play their instruments:
#   MV_FROM=40 MV_CAM='x y z  tx ty tz' SLOPPY_SCREENSHOT=out.png SLOPPY_FRAMES=2 sloppy --release tools/musician_view.jo
# (MV_FROM: seconds into each piece at the start; MV_ONLY=k draws only player k, 0..8, at x = 0.)
# The players, left to right: violin (Ave Maria), piano (Ave Maria), guitar (Berceuse), mandolin
# (Adelita), accordion (El Choclo), clarinet (Magnetic Rag), double bass (El Choclo), the singer
# (Ave Maria's line), a street musician's bouzouki.
use '../src/look.jo'
use '../src/sky.jo'
use '../src/objects.jo'
use '../src/folk.jo'
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/live_notes.jo'
use '../src/street_phrase.jo'
use '../src/musician_pose.jo'
use '../src/bar_band.jo'

window("Musicians", 1280, 720)
init_sky(); init_objects()
kit = make_instrument_kit()
from = to_float(env("MV_FROM") ?? "40") ?? 40.0
only = to_int(env("MV_ONLY") ?? "-1") ?? -1
cam = [loop w in split(env("MV_CAM") ?? "", " "): if w != "": to_float(w) ?? 0.0]

_perf = (piece: int, index: int) -> Performance:
    f = LiveNoteFeed()
    live_notes_load(f, bar_note_events(piece, index), -1)
    p = Performance()
    perform_prepare(p, f, "{piece}")
    p

choices = [vec2(8, 0), vec2(8, 6), vec2(11, 7), vec2(10, 8), vec2(3, 9), vec2(2, 4), vec2(3, 13), vec2(8, 14)]
perfs = [loop c in choices: _perf(int(c.x), if int(c.x) == 8: 1 else: -1)]
figs = [build_figure(.fisher, 79, age = 27), build_figure(.merchant, 417, age = 52, mustache = 1), build_figure(.merchant, 233, age = 40), build_figure(.fisher, 79, age = 27), build_figure(.fisher, 79, age = 27), build_figure(.fisher, 79, age = 27), build_figure(.merchant, 233, age = 40), build_figure(.dress, 911, age = 31), build_figure(.worker, 52, age = 35)]
floor_m = custom_mesh(():
    vs: Vertex3D[]
    add_box(vs, vec3(0, -0.5, 0), vec3(30, 1, 8), rgb(0.45, 0.3, 0.2))
    vs
())
# (an upright piano before the pianist: its case and keys, and the stool, as on the hotel's stand)
piano_m = custom_mesh((): 
    vs: Vertex3D[]
    add_box(vs, vec3(0, 0.65, -0.86), vec3(1.5, 1.3, 0.62), rgb(0.16, 0.09, 0.06))
    add_box(vs, vec3(0, 0.75, -0.44), vec3(1.34, 0.06, 0.28), rgb(0.95, 0.93, 0.88))
    add_box(vs, vec3(0, 0.25, 0.0), vec3(0.8, 0.5, 0.4), rgb(0.16, 0.09, 0.06))
    vs
())
t = 0.0
update = (dt: f64): t += dt
draw = ():
    L = light_at(15.0)
    clear(BLACK)
    hide_sky()
    eye = if cam.len() == 6: vec3(f32(cam[0]), f32(cam[1]), f32(cam[2])) else: vec3(0, 2.0, 9)
    look = if cam.len() == 6: vec3(f32(cam[3]), f32(cam[4]), f32(cam[5])) else: vec3(0, 1.1, 0)
    camera3d(eye, look, 50.0, 0.1, 5000.0)
    draw_custom((): draw_sky(L, t))
    draw_custom(():
        draw(obj_sh, floor_m, obj_params(L, t))
        loop k in 0..9:
            if only >= 0 and k != only: continue
            x = if only >= 0: 0.0 else: -7.6 + f64(k) * 1.9
            ms = from + t
            # (the pianist faces the piano, his back to the camera; the rest face the camera)
            yaw = if k == 1: PI else: 0.0
            if k == 1:
                draw(obj_sh, piano_m, obj_params(L, t, translation(vec3(f32(x), 0, 0))))
                draw(obj_sh, kit.keys, obj_params(L, t, translation(vec3(f32(x), 0.781, -0.3)) * rotation_y(-PI * 0.5)))
            p = Player(figs[k], translation(vec3(f32(x), 0, if k == 1: -0.08 else: 0.0)) * rotation_y(yaw + PI), f64(k))
            if k == 8:
                play_street(p, 3, false, kit, L, ms)
                continue
            m = perform_motion(perfs[k], int(choices[k].y))
            match k:
                0: play_violin(p, m, ms, kit, L, t)
                1: play_piano(p, m, ms, vec3(0, 0.77, 0.3), KEYBOARD_WIDTH, kit, L, t)
                2:
                    draw(obj_sh, kit.stool, obj_params(L, t, translation(vec3(f32(x), 0, 0))))
                    play_plucked(p, m, ms, 0, true, kit, L, t)
                3: play_plucked(p, m, ms, 1, false, kit, L, t)
                4: play_accordion(p, m, ms, kit, L, t)
                5: play_clarinet(p, m, ms, kit, L, t)
                6: play_bass(p, m, ms, kit, L, t)
                _: play_singer(p, m, ms, kit, L, t)
    )
