# Explicit synthetic cost fixture, never loaded by the game or credited with inhabitants.
# Run timing only on redfox under bench.lock. Canonical terrain, real combat kernel, no renderer.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/combat.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
set_speed_scale(1)
loop count in [2,4]:
    center = vec3(30000,700,-100000)
    actors: Combatant[]
    loop i in 0..count:
        side = i%2
        kind = if side == 0: Craft.osprey else: Craft.kestrel
        spec = craft_spec(kind,catalog_contacts(kind))
        at = center+vec3(f32(i/2*130),f32(i/2*30),if side == 0: 300.0 else: -300.0)
        state = CraftState(position=at,velocity=vec3(0,0,if side == 0: -65.0 else: 65.0),orientation=quat_euler(0,if side == 0: 0.0 else: PI,0),throttle=0.8,fuel=spec.fuel_capacity)
        actors.push(Combatant(i,i,side,spec,state,pilot=CombatPilot(skill=0.65,nerve=0.7)))
    b = start_engagement(1,42,center,actors)
    e = FlightEnv(wind=vec3(4,0,1),ground=(x: f64,z: f64) -> f64: height(x,z))
    durations: f64[]; total = 0.0; pairs = 0; brains = 0; max_rounds = 0
    loop tick in 0..3600:
        start = time(); step_battle(b,e,center)
        elapsed = (time()-start)*1000000.0
        durations.push(elapsed); total += elapsed; pairs += b.pair_tests; brains += b.brain_steps
        max_rounds = max(max_rounds,b.rounds.len())
    durations.sort()
    print("WAR_KERNEL count={count} ticks=3600 mean_us={total/3600.0:.3} p95_us={durations[3420]:.3} max_us={durations[3599]:.3} pairs={pairs} brains={brains} rounds={max_rounds} outcomes={b.outcomes.len()} observer=fixed-engagement-center terrain=canonical")
