# Stems of a piece for the automatic balance (tools/music_balance.py): the procedural orchestra
# rendering only the instruments asked for (the rest are silenced but still played, so voices are
# allocated as in the full mix), with trial gains and a trial shelf. A 48 kHz WAV.
#   MUSIC_PIECE=11 MUSIC_KEEP=0 MUSIC_SECONDS=60 MUSIC_OUT=violin.wav sloppy --release tools/music_stems.jo
# MUSIC_KEEP     all, or instrument numbers (MusicInstrument) separated by commas
# MUSIC_FROM     seconds into the piece (default 0); MUSIC_SECONDS how long (default 60)
# MUSIC_GAINS    trial gains: instrument:dB,instrument:dB
# MUSIC_SHELF    a trial shelf: hz|instrument:dB,instrument:dB  ("none": no shelf at all)
# MUSIC_PIANO    grand or upright: the piano, whatever the piece says
# MUSIC_WET      the synth's own room (default 0.05, as at the hotel's terrace)
use '../src/music_data.jo'
use '../src/music_synth.jo'

piece = to_int(env("MUSIC_PIECE") ?? "0") ?? 0
keep_text = env("MUSIC_KEEP") ?? "all"
from = to_float(env("MUSIC_FROM") ?? "0") ?? 0.0
seconds = to_float(env("MUSIC_SECONDS") ?? "60") ?? 60.0
out_path = env("MUSIC_OUT") ?? "stem.wav"

_pairs = (text: str) -> {int: f64}:
    out: {int: f64} = {}
    if text == "": return out
    loop part in split(text, ","):
        kv = split(part, ":")
        if kv.len() == 2: out[to_int(kv[0]) ?? -1] = to_float(kv[1]) ?? 0.0
    out

s = make_music_synth()
if let text = env("MUSIC_SHELF"):
    s.shelf_fixed = true
    if text != "none":
        halves = split(text, "|")
        s.shelf_hz = to_float(halves[0]) ?? 0.0
        s.shelf_db = fill(0.0, 16)
        if halves.len() > 1:
            loop k, v in _pairs(halves[1]): if k >= 0 and k < 16: s.shelf_db[k] = v
# MUSIC_PIANO=grand|upright: the piano, whatever the piece says
if let choice = env("MUSIC_PIANO"):
    s.piano_fixed = true; s.upright = choice == "upright"
s.thump_level = to_float(env("MUSIC_THUMP") ?? "1") ?? 1.0
music_load(s, piece)
s.wet = to_float(env("MUSIC_WET") ?? "0.05") ?? 0.05
gains = _pairs(env("MUSIC_GAINS") ?? "")
keep: {int: bool} = {}
if keep_text != "all":
    loop part in split(keep_text, ","): keep[to_int(part) ?? -1] = true
loop k in 0..s.events.len():
    e = s.events[k]
    g = pow(10.0, gains.get(e.instrument, 0.0) / 20.0)
    if keep_text != "all" and not (e.instrument in keep): g = 0.0
    s.events[k].mix_gain = e.mix_gain * g
    s.events[k].mix_end_gain = e.mix_end_gain * g
music_seek(s, from)
total = min(int(seconds * f64(MUSIC_RATE)), s.frames - s.cursor)
mono: f64[]
loop mono.len() < total:
    block = music_render(s, min(512, total - mono.len()))
    if block.len() == 0: break
    mono.extend(block)
stereo: f32[]
loop i in 0..mono.len():
    a = mono[i]
    b = if i + 1 < mono.len(): mono[i + 1] else: a
    loop k in 0..3:
        v = f32((a + (b - a) * f64(k) / 3.0) * 0.5)
        stereo.push(v); stereo.push(v)
assert(save_wav(out_path, Sound(stereo)))
print("STEM {MUSIC_PIECES[piece].title}: {keep_text}, {f64(mono.len()) / f64(MUSIC_RATE):.1} s -> {out_path}")
