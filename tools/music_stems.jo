# Stems of a piece for the automatic balance (tools/music_balance.py): the procedural orchestra
# rendering only the instruments asked for (the rest are silenced but still played, so voices are
# allocated as in the full mix), with trial gains and a trial shelf. A 48 kHz WAV.
#   MUSIC_PIECE=11 MUSIC_KEEP=0 MUSIC_SECONDS=60 MUSIC_OUT=violin.wav sloppy --release tools/music_stems.jo
# MUSIC_KEEP     all, or instrument numbers (MusicInstrument) separated by commas
# MUSIC_FROM     seconds into the piece (default 0); MUSIC_SECONDS how long (default 60)
# MUSIC_GAINS    trial gains: instrument:dB,instrument:dB
# MUSIC_SHELF    a trial shelf: hz|instrument:dB,instrument:dB  ("none": no shelf at all)
# MUSIC_PIANO    grand or upright: the piano, whatever the piece says
# MUSIC_WET      the synth's own room (default 0.05, as at the hotel's terrace)
# MUSIC_EVENTS   a packed score (.z, as tools/music_pack.py writes them) played in place of the
#                piece's own, in the piece's hall and at its level: one part alone, or a trial
#                arrangement (tools/music_part_balance.py)
# MUSIC_SING     1: a song as the radio has it, her voice over the rest (src/singer.jo); only: her voice alone
#                (MUSIC_KEEP=0 with the violin's line for comparison)
# MUSIC_MONO     1: a 16 kHz mono WAV, the synth's own samples (a third of the size, for measuring)
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/singer.jo'

piece = to_int(env("MUSIC_PIECE") ?? "0") ?? 0
keep_text = env("MUSIC_KEEP") ?? "all"
from = to_float(env("MUSIC_FROM") ?? "0") ?? 0.0
seconds = to_float(env("MUSIC_SECONDS") ?? "60") ?? 60.0
out_path = env("MUSIC_OUT") ?? "stem.wav"

_pairs = (text: str) -> {int: f64}:
    out: {int: f64} = {}
    if text == "": return out
    loop part in split(text, ","):
        kv = split(part, ":")
        if kv.len() == 2: out[to_int(kv[0]) ?? -1] = to_float(kv[1]) ?? 0.0
    out

s = make_music_synth()
if let text = env("MUSIC_SHELF"):
    s.shelf_fixed = true
    if text != "none":
        halves = split(text, "|")
        s.shelf_hz = to_float(halves[0]) ?? 0.0
        s.shelf_db = fill(0.0, 16)
        if halves.len() > 1:
            loop k, v in _pairs(halves[1]): if k >= 0 and k < 16: s.shelf_db[k] = v
# MUSIC_PIANO=grand|upright: the piano, whatever the piece says
# (without it, the piano of the venue where the piece is usually heard: MusicPiece.piano)
s.piano_fixed = true
s.upright = if let choice = env("MUSIC_PIANO"): choice == "upright" else: MUSIC_PIECES[piece].piano == 1
s.thump_level = to_float(env("MUSIC_THUMP") ?? "1") ?? 1.0
music_load(s, piece)
if let path = env("MUSIC_EVENTS"):
    packed = read_bytes(path)
    assert(packed is u8[], "MUSIC_EVENTS: no such file")
    if packed is u8[]:
        b = inflate(packed)!
        assert(b.len() >= 16 and b[0] == 77 and b[1] == 85 and b[2] == 83 and (b[3] >= 49 and b[3] <= 52))
        count = music_u32(b, 4)
        stride = if b[3] >= 51: 16 else: if b[3] == 50: 14 else: 12
        assert(b.len() == 16 + count * stride)
        s.frames = music_u32(b, 8); s.lookback = music_u32(b, 12)
        s.events = []
        loop i in 0..count:
            at = 16 + i * stride
            s.events.push(MusicEvent(music_u32(b, at), music_u32(b, at + 4), int(b[at + 8]), if b[3] == 52: int(b[at + 9]) & 15 else: int(b[at + 9]), f64(b[at + 10]) / 100.0, f64(b[at + 11]) / 100.0, if b[3] == 50: f64(b[at + 12]) / 100.0 else: -1.0, if b[3] == 50: f64(b[at + 13]) / 100.0 else: 0.4, if b[3] >= 51: f64(int(b[at + 12]) + int(b[at + 13]) * 256) / 4096.0 else: 1.0, if b[3] >= 51: f64(int(b[at + 14]) + int(b[at + 15]) * 256) / 4096.0 else: 1.0, if b[3] == 52: int(b[at + 9]) / 16 - 1 else: -1))
s.wet = to_float(env("MUSIC_WET") ?? "0.05") ?? 0.05
gains = _pairs(env("MUSIC_GAINS") ?? "")
keep: {int: bool} = {}
if keep_text != "all":
    loop part in split(keep_text, ","): keep[to_int(part) ?? -1] = true
loop k in 0..s.events.len():
    e = s.events[k]
    g = pow(10.0, gains.get(e.instrument, 0.0) / 20.0)
    if keep_text != "all" and not (e.instrument in keep): g = 0.0
    s.events[k].mix_gain = e.mix_gain * g
    s.events[k].mix_end_gain = e.mix_end_gain * g
sing = env("MUSIC_SING") ?? ""
singer = Singer()
if sing != "" and singer_sings(piece): singer = singer_take_line(s, piece)
music_seek(s, from)
singer_seek(singer, s.cursor)
total = min(int(seconds * f64(MUSIC_RATE)), s.frames - s.cursor)
mono: f64[]
loop mono.len() < total:
    block = music_render(s, min(512, total - mono.len()))
    if block.len() == 0: break
    if sing != "" and singer.notes.len() > 0:
        voice = singer_render(singer, block.len())
        weight = MUSIC_PIECES[piece].sung_gain * MUSIC_PIECES[piece].level
        loop k in 0..block.len(): block[k] = (if sing == "only": 0.0 else: block[k]) + voice[k] * weight
    mono.extend(block)
if (env("MUSIC_MONO") ?? "") == "1":
    # (16-bit PCM, one channel, MUSIC_RATE: the same scale as the stereo file's)
    wav: u8[] = []
    put = (v: int, bytes: int):
        loop k in 0..bytes: wav.push(u8((v >> (8 * k)) & 255))
    loop c in "RIFF": wav.push(u8(c))
    put(36 + mono.len() * 2, 4)
    loop c in "WAVEfmt ": wav.push(u8(c))
    put(16, 4); put(1, 2); put(1, 2); put(MUSIC_RATE, 4); put(MUSIC_RATE * 2, 4); put(2, 2); put(16, 2)
    loop c in "data": wav.push(u8(c))
    put(mono.len() * 2, 4)
    loop v in mono: put(int(round(clamp(v * 0.5, -1.0, 1.0) * 32767.0)) & 65535, 2)
    assert(write_bytes(out_path, wav))
    print("STEM {MUSIC_PIECES[piece].title}: {keep_text}, {f64(mono.len()) / f64(MUSIC_RATE):.1} s -> {out_path}")
    exit(0)
stereo: f32[]
loop i in 0..mono.len():
    a = mono[i]
    b = if i + 1 < mono.len(): mono[i + 1] else: a
    loop k in 0..3:
        v = f32((a + (b - a) * f64(k) / 3.0) * 0.5)
        stereo.push(v); stereo.push(v)
assert(save_wav(out_path, Sound(stereo)))
print("STEM {MUSIC_PIECES[piece].title}: {keep_text}, {f64(mono.len()) / f64(MUSIC_RATE):.1} s -> {out_path}")
