# Contact sheet: all types in one livery, or all liveries of one type.
# HANGAR_KIND=-1 (all), HANGAR_LIVERY=0..5, HANGAR_YAW=0.6; single-kind sheets show six paints.
# Headless: SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 SLOPPY_FRAMES=2 SLOPPY_SCREENSHOT=... sloppy tools/hangar.jo
use '../src/look.jo'
use '../src/objects.jo'
use '../src/planes.jo'
use '../src/flight.jo'

window("Aircraft catalog", 1920, 1280)
init_objects()
kind_id = clamp(to_int(env("HANGAR_KIND") ?? "-1") ?? -1, -1, CRAFT_NAMES.len() - 1)
livery_id = clamp(to_int(env("HANGAR_LIVERY") ?? "0") ?? 0, 0, LIVERIES.len() - 1)
gear = clamp(to_float(env("HANGAR_GEAR") ?? "0") ?? 0, 0.0, 1.0)
yaw = to_float(env("HANGAR_YAW") ?? "0.65") ?? 0.65
kinds = if kind_id >= 0: [loop j in 0..LIVERIES.len(): Craft(kind_id)] else: [loop j in 0..CRAFT_NAMES.len(): Craft(j)]
liveries = if kind_id >= 0: [loop j in 0..LIVERIES.len(): j] else: fill(livery_id, kinds.len())
models = [loop j in 0..kinds.len(): build_craft(kinds[j], LIVERIES[liveries[j]])]
cols = if kind_id >= 0: 3 else: 4
rows = (kinds.len() + cols - 1) / cols
cell_w = 1920 / cols
cell_h = 1180 / rows

# Contact sheets are diagnostic tooling, not a game menu. Each cell has its own fitted camera.
draw = ():
    clear(rgb(0.92, 0.9, 0.83))
    text("AEGEAN SKIES  /  AIRCRAFT", vec2(28, 36), 30, rgb(0.15, 0.23, 0.25))
    text(if kind_id >= 0: CRAFT_NAMES[kind_id] + " — six operator liveries" else: "Sixteen aircraft — " + LIVERY_NAMES[livery_id], vec2(28, 72), 21, rgb(0.29, 0.35, 0.35))
    camera3d(vec3(0, 5, -20), vec3(0, 0, 0))
    hide_sky()
    loop j in 0..models.len():
        p = aircraft_profile(kinds[j])
        x = (j % cols) * cell_w + 6; y = 100 + (j / cols) * cell_h
        rect(x, y, cell_w - 12, cell_h - 55, rgb(0.76, 0.83, 0.82))
        name = if kind_id >= 0: LIVERY_NAMES[liveries[j]] else: CRAFT_NAMES[int(kinds[j])]
        text(name, vec2(x + 9, y + cell_h - 51), 22, rgb(0.15, 0.23, 0.25))
        text(p.role, vec2(x + 9, y + cell_h - 26), 15, rgb(0.35, 0.39, 0.37))
    draw_custom(():
        L = light_at(14.5)
        loop j in 0..models.len():
            p = aircraft_profile(kinds[j]); m = models[j]
            # Portrait-ish six-paint cells need a wider horizontal field than the catalog.
            aspect = f64(cell_w - 12) / f64(cell_h - 55)
            distance = max(p.span * max(1.0, 1.8 / aspect), p.length * 1.65)
            eye = vec3(sin(yaw) * distance, distance * 0.4, -cos(yaw) * distance)
            x = (j % cols) * cell_w + 6; y = 100 + (j / cols) * cell_h
            cw = f64(cell_w - 12); ch = f64(cell_h - 55)
            cell = translation(vec3((f64(x) + cw * 0.5) / 960.0 - 1.0, 1.0 - (f64(y) + ch * 0.5) / 640.0, 0)) * scaling(vec3(cw / 1920.0, ch / 1280.0, 1))
            u = obj_params(L, 0)
            u.view_proj = cell * perspective(radians(38.0), cw / ch, 0.1, 500) * look_at(eye, vec3(0, 0.3, 0), vec3(0, 1, 0))
            u.cam = eye
            draw(obj_sh, m.body, u)
            loop wheel in m.wheels:
                u.model = wheel_frame(wheel, gear)
                draw(obj_sh, wheel.mesh, u)
            loop hub in m.prop_hubs:
                u.model = translation(hub) * rotation_z(0.4)
                draw(obj_sh, m.prop, u)
    )
