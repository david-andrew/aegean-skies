# The aircraft side by side on the water, for looking at them: sloppy tools/hangar.jo
use '../src/look.jo'
use '../src/sky.jo'
use '../src/sea.jo'
use '../src/objects.jo'
use '../src/planes.jo'
use '../src/world.jo'

window("Hangar", 1280, 720)
init_sky(); init_sea(); init_objects()
models = [build_craft(.gull, LIVERIES[0]), build_craft(.heron, LIVERIES[5]), build_craft(.corsair, LIVERIES[3]), build_craft(.falco, LIVERIES[1])]
sea_mesh = build_sea_mesh()
depth_tex = build_depth_texture()
yaw = to_float(env("HANGAR_YAW") ?? "0.6") ?? 0.6
t = 0.0
update = (dt: f64): t += dt
draw = ():
    L = light_at(14.5)
    clear(BLACK)
    hide_sky()
    O = vec3(7000, 0, 7000)
    camera3d(O + vec3(f32(sin(yaw) * 30.0), 9, f32(cos(yaw) * 30.0 + 2.0)), O + vec3(0, 1, 0), 45.0, 0.5, 30000.0)
    draw_custom((): draw_sky(L, t))
    draw_custom(():
        loop k in 0..models.len():
            m = models[k]
            at = translation(vec3(7000, 0, 7000) + vec3(f32(-15.0 + f64(k) * 10.0), 2.5, f32(if k % 2 == 0: 0.0 else: -6.0))) * rotation_y(-0.5)
            draw(obj_sh, m.body, obj_params(L, t, at))
            draw(obj_sh, m.prop, obj_params(L, t, at * translation(m.prop_at) * rotation_z(t * 30.0)))
    )
    draw_custom((): draw_sea(sea_mesh, depth_tex, L, t, 0.2), transparent = true)
