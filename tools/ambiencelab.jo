# Offline audition only: no play(), audio driver, global game state, or downloaded assets.
use '../src/ambience_synth.jo'
use '../src/ambience.jo'
use '../src/life_audio.jo'
use '../src/sound.jo'

names = ["bell","harbour-murmur","hull-hammer","rope-creak","rigging","cafe","beach","cliff","trees","grass","cicadas","crickets","owl","dog","goat-bell","donkey","ship-engine","sail-luff","steam-whistle","rain-sea","rain-roof","thunder","gull"]
dir = env("AMBIENCE_SAMPLES") ?? panic("Set AMBIENCE_SAMPLES to an existing scratch directory")
bank: Sound[]
bytes = 0
loop k in 0..AMBIENCE_KINDS:
    s = make_ambience(AmbienceKind(k)); bank.push(s); bytes += s.samples.len()*4*2
    assert(save_wav(s,dir+"/"+names[k]+".wav"))
    energy = 0.0; peak = 0.0
    loop v in s.samples: energy += f64(v)*f64(v); peak = max(peak,abs(f64(v)))
    print("{names[k]},seconds={f64(s.samples.len())/f64(MIX_RATE*2):.3},rms={sqrt(energy/f64(s.samples.len())):.5},peak={peak:.5}")
print("bank_direct_plus_soft_bytes={bytes}")

add = (out: mut f32[],s: Sound,at: f64,gain: f64,seconds: f64,looped: bool = false,pitch: f64 = 1.0):
    offset = int(at*f64(MIX_RATE))*2
    count = min(int(seconds*f64(MIX_RATE))*2,out.len()-offset)
    loop i in 0..count:
        frame = f64(i/2)*pitch; source = int(frame)*2+i%2
        if not looped and source >= s.samples.len(): break
        left = source%s.samples.len(); right = (left+2)%s.samples.len()
        value = mix(f64(s.samples[left]),f64(s.samples[right]),frame-floor(frame))
        out[offset+i] += f32(value*gain)

# The actual scheduler's noon count and Sunday/feast peal, with engine pitch playback rendered.
loop minute, label in [(150,"bells-noon"),(6*1440-30,"bells-sunday-feast")]:
    bells = Ambience()
    ambience_bells(bells,[AmbienceSource(0,.bell,vec3(0,8,0),0.24,1600)],minute,0,vec3(0,2,0))
    clip = fill(f32(0),MIX_RATE*18*2)
    loop event in bells.pending:
        add(clip,bank[int(AmbienceKind.bell)],event.due,event.source.gain,3.5/event.source.pitch,pitch=event.source.pitch)
    assert(save_wav(Sound(clip),dir+"/"+label+".wav"))

# Conservative in-world gains at a quiet quay. Close source, no distance loss.
quay = fill(f32(0),MIX_RATE*12*2)
add(quay,bank[int(AmbienceKind.beach)],0,0.08,12,true)
add(quay,bank[int(AmbienceKind.murmur)],0,0.14,12,true)
add(quay,bank[int(AmbienceKind.rope)],0,0.025,12,true)
add(quay,bank[int(AmbienceKind.rigging)],0,0.025,12,true)
loop t in [1.0,5.7,10.4]: add(quay,bank[int(AmbienceKind.hammer)],t,0.12,0.75)
add(quay,bank[int(AmbienceKind.bell)],3,0.24,3.5)
assert(save_wav(Sound(quay),dir+"/scene-quay.wav"))

night = fill(f32(0),MIX_RATE*12*2)
add(night,bank[int(AmbienceKind.cricket)],0,0.04,12,true)
add(night,bank[int(AmbienceKind.trees)],0,0.04,12,true)
add(night,bank[int(AmbienceKind.owl)],3,0.10,1.8)
add(night,bank[int(AmbienceKind.dog)],9,0.08,0.75)
assert(save_wav(Sound(night),dir+"/scene-night.wav"))
storm = fill(f32(0),MIX_RATE*10*2)
add(storm,bank[int(AmbienceKind.rain_roof)],0,0.15,10,true)
add(storm,bank[int(AmbienceKind.rain_sea)],0,0.10,10,true)
# At t=1 a flash 1029 metres away; propagation arrives at t=4, never at t=1.
add(storm,ambience_soften(bank[int(AmbienceKind.thunder)]),4,0.25,4.5)
assert(save_wav(Sound(storm),dir+"/scene-storm-1029m.wav"))

phrase = fill(f32(0),MIX_RATE*7*2); square = fill(f32(0),MIX_RATE*7*2)
loop k in 0..16:
    note = make_life_note([0,3,7,3,2,5,9,5][k%8])
    add(phrase,note,f64(k)/3,0.17,0.75)
    add(square,ambience_square_reverb(note),f64(k)/3,0.17,0.92)
assert(save_wav(Sound(phrase),dir+"/musician-dry.wav"))
assert(save_wav(Sound(square),dir+"/musician-square.wav"))
assert(save_wav(ambience_soften(Sound(quay)),dir+"/scene-quay-softened.wav"))

# Worst-case budget, before positional distance losses: verify the engine still leads.
worst = fill(f32(0),MIX_RATE*6*2)
loop kind in [AmbienceKind.murmur,.cliff,.trees,.cicada,.ship_engine,.rain_roof]: add(worst,bank[int(kind)],0,0.055/6,6,true)
loop kind in [AmbienceKind.bell,.whistle,.thunder,.dog]: add(worst,bank[int(kind)],1,0.035/4,ambience_seconds(kind))
engine = engine_loop(); mix = worst; engine_only = fill(f32(0),worst.len())
add(engine_only,engine,0,0.22,6,true)
loop i in 0..mix.len(): mix[i] += engine_only[i]
assert(save_wav(Sound(worst),dir+"/flight-ambience-budget.wav"))
assert(save_wav(Sound(engine_only),dir+"/flight-engine-idle.wav"))
assert(save_wav(Sound(mix),dir+"/flight-engine-with-ambience.wav"))
e = 0.0; a = 0.0
loop i in 0..worst.len(): e += f64(engine_only[i])*f64(engine_only[i]); a += f64(worst[i])*f64(worst[i])
print("flight_ambience_to_idle_engine_rms={sqrt(a/e):.5}")
assert(a < e*0.04)
