# Offline audition only: no play(), audio driver, global game state, or downloaded assets.
use '../src/ambience_synth.jo'
use '../src/ambience.jo'
use '../src/life_audio.jo'
use '../src/sound.jo'

names = ["bell","harbour-murmur","hull-hammer","rope-creak","rigging","cafe","beach","cliff","trees","grass","cicadas","crickets","owl","dog","goat-bell","donkey","ship-engine","sail-luff","steam-whistle","rain-sea","rain-roof","thunder","gull","spring","songbird","wave","surge","call","laugh","greet","ask","answer"]
dir = env("AMBIENCE_SAMPLES") ?? panic("Set AMBIENCE_SAMPLES to an existing scratch directory")
bank: Sound[]               # (each kind's first take)
takes: Sound[][]
bytes = 0
loop k in 0..AMBIENCE_KINDS:
    kind = AmbienceKind(k)
    mine: Sound[]
    loop take in 0..ambience_variants(kind):
        s = make_ambience(kind,take+1); mine.push(s)
        bytes += ambience_decimate(s,ambience_rate_step(kind)).samples.len()*4+ambience_soften_bank(s).samples.len()*4
        label = if take == 0: names[k] else: "{names[k]}-{take+1}"
        assert(save_wav(dir+"/"+label+".wav", s))
        energy = 0.0; peak = 0.0
        loop v in s.samples: energy += f64(v)*f64(v); peak = max(peak,abs(f64(v)))
        print("{label},seconds={f64(s.samples.len())/f64(MIX_RATE*2):.3},rms={sqrt(energy/f64(s.samples.len())):.5},peak={peak:.5}")
    bank.push(mine[0]); takes.push(mine)
print("bank_direct_plus_soft_bytes={bytes}")

add = (out: mut f32[],s: Sound,at: f64,gain: f64,seconds: f64,looped: bool = false,pitch: f64 = 1.0):
    offset = int(at*f64(MIX_RATE))*2
    count = min(int(seconds*f64(MIX_RATE))*2,out.len()-offset)
    loop i in 0..count:
        frame = f64(i/2)*pitch; source = int(frame)*2+i%2
        if not looped and source >= s.samples.len(): break
        left = source%s.samples.len(); right = (left+2)%s.samples.len()
        value = mix(f64(s.samples[left]),f64(s.samples[right]),frame-floor(frame))
        out[offset+i] += f32(value*gain)

# The actual scheduler's noon count and Sunday/feast peal, with engine pitch playback rendered.
loop minute, label in [(150,"bells-noon"),(6*1440-30,"bells-sunday-feast")]:
    bells = Ambience()
    ambience_bells(bells,[AmbienceSource(0,.bell,vec3(0,8,0),0.24,1600)],minute,0,vec3(0,2,0))
    clip = fill(f32(0),MIX_RATE*18*2)
    loop event in bells.pending:
        add(clip,bank[int(AmbienceKind.bell)],event.due,event.source.gain,3.5/event.source.pitch,pitch=event.source.pitch)
    assert(save_wav(dir+"/"+label+".wav", Sound(clip)))

# Conservative in-world gains at a quiet quay in a fresh breeze, 40 s: the beds, and the single
# events at the scheduler's own uneven moments (ambience_due), each its take and pitch.
quay = fill(f32(0),MIX_RATE*40*2)
add(quay,bank[int(AmbienceKind.beach)],0,0.08,40,true)
add(quay,bank[int(AmbienceKind.murmur)],0,0.14,40,true)
lab_event = (out: mut f32[],kind: AmbienceKind,key: int,period: f64,gain: f64,spread: f64):
    loop step in 0..80:
        cell = ambience_due(f64(step)*0.5,f64(step+1)*0.5,key,period)
        if cell < 0: continue
        take = takes[int(kind)][int(ambience_hash(key,cell,2)*64.0)%takes[int(kind)].len()]
        pitch = 1.0+(ambience_hash(key,cell,3)-0.5)*2.0*spread
        add(out,take,f64(step+1)*0.5,gain*(0.6+0.4*ambience_hash(key,cell,9)),ambience_seconds(kind)/pitch,pitch=pitch)
lab_event(quay,AmbienceKind.wave,-5,5.5,0.14,0.08)
lab_event(quay,AmbienceKind.rope,11,4.5,0.035,0.12)
lab_event(quay,AmbienceKind.rigging,12,5.0,0.035,0.1)
lab_event(quay,AmbienceKind.hammer,13,3.0,0.12,0.03)
loop k in 0.. and kind in [AmbienceKind.greet,AmbienceKind.laugh,AmbienceKind.call,AmbienceKind.ask,AmbienceKind.answer]:
    lab_event(quay,kind,20+k,14.0,if kind == .call: 0.09 else: 0.065,0.05)
add(quay,bank[int(AmbienceKind.bell)],3,0.24,3.5)
assert(save_wav(dir+"/scene-quay.wav", Sound(quay)))
voices = fill(f32(0),MIX_RATE*24*2)
loop k in 0.. and kind in [AmbienceKind.greet,AmbienceKind.laugh,AmbienceKind.call,AmbienceKind.ask,AmbienceKind.answer]:
    loop take in 0..4: add(voices,takes[int(kind)][take],f64(k*4+take)*1.15+0.2,0.5,ambience_seconds(kind))
assert(save_wav(dir+"/voices-all-takes.wav", Sound(voices)))

night = fill(f32(0),MIX_RATE*12*2)
add(night,bank[int(AmbienceKind.cricket)],0,0.04,12,true)
add(night,bank[int(AmbienceKind.trees)],0,0.04,12,true)
add(night,bank[int(AmbienceKind.owl)],3,0.10,1.8)
add(night,bank[int(AmbienceKind.dog)],9,0.08,0.75)
assert(save_wav(dir+"/scene-night.wav", Sound(night)))
storm = fill(f32(0),MIX_RATE*10*2)
add(storm,bank[int(AmbienceKind.rain_roof)],0,0.15,10,true)
add(storm,bank[int(AmbienceKind.rain_sea)],0,0.10,10,true)
# At t=1 a flash 1029 metres away; propagation arrives at t=4, never at t=1.
add(storm,ambience_soften(bank[int(AmbienceKind.thunder)]),4,0.25,4.5)
assert(save_wav(dir+"/scene-storm-1029m.wav", Sound(storm)))

phrase = fill(f32(0),MIX_RATE*7*2); square = fill(f32(0),MIX_RATE*7*2)
loop k in 0..16:
    note = make_life_note([0,3,7,3,2,5,9,5][k%8])
    add(phrase,note,f64(k)/3,0.17,0.75)
    add(square,ambience_square_reverb(note),f64(k)/3,0.17,0.92)
assert(save_wav(dir+"/musician-dry.wav", Sound(phrase)))
assert(save_wav(dir+"/musician-square.wav", Sound(square)))
# the street musician's tune over four phrases (src/life_audio.jo life_phrase_note)
tune = fill(f32(0),MIX_RATE*23*2)
loop beat in 0..64:
    k = life_phrase_note(7,beat)
    if k >= 0: add(tune,make_life_note([0,2,3,5,7,9,10,12][k]),f64(beat)/3,0.17,0.75)
assert(save_wav(dir+"/musician-phrases.wav", Sound(tune)))
assert(save_wav(dir+"/scene-quay-softened.wav", ambience_soften(Sound(quay))))

# Worst-case budget, before positional distance losses: verify the engine still leads.
worst = fill(f32(0),MIX_RATE*6*2)
loop kind in [AmbienceKind.murmur,.cliff,.trees,.cicada,.ship_engine,.rain_roof]: add(worst,bank[int(kind)],0,0.055/6,6,true)
loop kind in [AmbienceKind.bell,.whistle,.thunder,.dog]: add(worst,bank[int(kind)],1,0.035/4,ambience_seconds(kind))
engine = engine_loop(); mix = worst; engine_only = fill(f32(0),worst.len())
add(engine_only,engine,0,0.22,6,true)
loop i in 0..mix.len(): mix[i] += engine_only[i]
assert(save_wav(dir+"/flight-ambience-budget.wav", Sound(worst)))
assert(save_wav(dir+"/flight-engine-idle.wav", Sound(engine_only)))
assert(save_wav(dir+"/flight-engine-with-ambience.wav", Sound(mix)))
e = 0.0; a = 0.0
loop i in 0..worst.len(): e += f64(engine_only[i])*f64(engine_only[i]); a += f64(worst[i])*f64(worst[i])
print("flight_ambience_to_idle_engine_rms={sqrt(a/e):.5}")
assert(a < e*0.04)
