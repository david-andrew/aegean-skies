# Bounded depth streaming and atomic publication; run headless with a screenshot
# path and SLOPPY_SOFTWARE=1. Samples the same 8 m authority used by boat routing.
use '../src/geography.jo'
use '../src/world.jo'
use '../src/sea.jo'
window("World depth check",320,200)
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_expanded_depth(texture(image(1,1)))
worst = 0.0
shallow = 0; submerged = 0; dry = 0
loop station in 0..3:
    cam = vec3(f32(-104900+station*750),80,-120000)
    camera3d(cam,cam+vec3(-1,-0.2,0),62,0.3,30000)
    before = nearby_area
    loop row in 0..NEAR_DEPTH_N/NEAR_DEPTH_ROWS-1:
        update_nearby_depth()
        assert(nearby_area == before)
    update_nearby_depth()
    assert(nearby_area.w == 1.0 and nearby_row == -1)
    assert(length(nearby_area.xy-cam.xz) < 1100.0)
    loop j in 0..32:
        loop i in 0..32:
            px = i*8; pz = j*8
            x = f64(nearby_area.x)+(f64(px)+0.5)/256.0*6000.0-3000.0
            z = f64(nearby_area.y)+(f64(pz)+0.5)/256.0*6000.0-3000.0
            want = clamp(-new_land_height(x,z),0.0,60.0)
            if want > 0.0 and want < 60.0: shallow += 1
            if want > 0.0: submerged += 1
            else: dry += 1
            actual = f64(nearby_image.pixels[(pz*256+px)*4])*60.0/255.0
            worst = max(worst,abs(actual-want))
            assert(abs(actual-want) <= 60.0/255.0+0.000001)
assert(shallow > 0 and submerged > 0 and dry > 0)
print("WORLD DEPTH PASS windows=3 samples=3072 shallow={shallow} dry={dry} submerged={submerged} max_depth_quantization={worst:.6}m rows_per_frame={NEAR_DEPTH_ROWS}")
exit(0)
