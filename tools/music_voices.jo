use '../src/music_data.jo'
use '../src/music_synth.jo'

# File-only survey of the 64-voice ceiling: for every catalogue piece, the synth's own output over
# the whole piece (no radio) as a hash, the number of voices taken from sounding notes
# (music_steal) and the most voices sounding at once. A piece with stolen=0 never reaches the
# stealing rule, so a change to that rule leaves its hash unchanged.
#   SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy --release tools/music_voices.jo
# PIECES=a,b limits it to those piece numbers; DUMP=<directory> also writes each piece's samples
# (<piece>.f32, mono f32 at 16 kHz) for comparing two builds.
only = env("PIECES") ?? ""
loop piece in 0..MUSIC_PIECES.len():
    if only != "" and not (str(piece) in split(only,",")): continue
    s = make_music_synth()
    music_load(s,piece)
    music_seek(s,0.0)
    h: u64 = 1469598103934665603
    dump = env("DUMP") ?? ""
    pcm: f32[]
    most = 0; energy = 0.0
    loop s.cursor < s.frames:
        block = music_render(s,min(512,s.frames-s.cursor))
        if block.len() == 0: break
        loop v in block:
            h = ((h xor u64(int(v*1000000000.0) & 0xffffffff))*u64(1099511628211)) & u64(0xffffffffffff)
            energy += v*v
            if dump != "": pcm.push(f32(v))
        active = 0
        loop k in 0..s.voices.len(): if s.voices[k].active: active += 1
        most = max(most,active)
    if dump != "": assert(write_bytes("{dump}/{piece}.f32",plain_bytes(pcm)))
    print("PIECE {piece} stolen={s.stolen} most={most} rms={sqrt(energy/f64(max(1,s.frames))):.6} hash={h} frames={s.frames} {MUSIC_PIECES[piece].title}")
