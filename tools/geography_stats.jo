# Deterministic geography statistics; no display/audio and no timing claims.
use '../src/geography.jo'
use '../src/world.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
counts: {int:int} = {}
peaks: {int:f64} = {}
loop j in 0..200:
    loop i in 0..250:
        x = -249000.0+f64(i)*2000.0; z = -199000.0+f64(j)*2000.0
        h = new_land_height(x,z)
        id = land_region_at(x,z)
        if id < 0: continue
        counts[id] = counts.get(id,0)+1
        peaks[id] = max(peaks.get(id,0.0),h)
loop r in LAND_REGIONS: print("region {r.id} {r.name}: sampled area {counts.get(r.id,0)*4} km2, sampled peak {peaks.get(r.id,0.0):.1} m")
low = 0
loop isl in small_islands:
    if isl.peak <= 35.0: low += 1
print("small islands={small_islands.len()}, low islands (envelope <=35m)={low}")
x = -144000.0; z = -119000.0
print("ground camera: {x} {new_land_surface(x,z)+2.0} {z}")
# Find a reproducible real shoreline along an authored region's east coast.
z = -120000.0; x = -130000.0
loop x < -80000.0:
    if new_land_height(x,z) > 0.0 and new_land_height(x+100.0,z) <= 0.0: break
    x += 100.0
print("coast camera: {x+200.0} 80 {z}")
loop speed in [165.0,200.0]: print("500km at {speed}m/s: {500000.0/speed/60.0:.2} minutes")

print("geography fingerprint {geography_fingerprint()}")
