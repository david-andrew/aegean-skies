build:
    name = "Aegean River Capture"
    js = "../src/web_compat.js"

use '../src/canal_render.jo'
use '../src/canal_traffic.jo'
use '../src/vessel_types.jo'
use '../src/vessels.jo'
use '../src/vessel_scene.jo'
use '../src/vessel_view.jo'
use '../src/canal_geometry.jo'
use '../src/river_banks.jo'
use '../src/prop_disc.jo'
use '../src/flight.jo'
use '../src/weather_scene.jo'
use '../src/flight_feedback.jo'
use '../src/flight_effects.jo'
use '../src/pilot.jo'
use '../src/planes.jo'
use '../src/damage.jo'
use '../src/tweaks.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/sea.jo'
use '../src/curved_world.jo'
use '../src/trails.jo'
use '../src/world_point.jo'
use '../src/world_particles.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'
use '../src/world.jo'
use '../src/world_terrain.jo'
use '../src/terrain.jo'
use '../src/terrain_lod.jo'
use '../src/quality.jo'
use '../src/sky.jo'
use '../src/river_render.jo'
use '../src/river_field.jo'
use '../src/river_data.jo'
use '../src/geography.jo'
use '../src/wake.jo'

window("River flight sample",1280,720)
init_quality()
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
load_terrain(embed('../assets/terrain_lod.bin'))
enable_world_depth()
init_terrain();init_world_terrain();init_objects();init_sea();init_curved_world();init_rivers();init_canal();init_sky();init_flight_effects();init_wake()
if env("RIVER_FULL_MATERIAL")!=none:river_far_shader=river_shader;river_far_depth_shader=river_depth_shader
wind_now.speed=2.0
water=build_sea_mesh();depth=build_depth_texture()
scale=to_float(env("RIVER_SCALE")??"1")??1.0
set_speed_scale(scale);set_lift_scale(scale)
model=build_craft(Craft.gull,LIVERIES[0]);models=[model]
k=craft_spec(Craft.gull,model.contacts);k.player=scale>1.0
station=clamp(to_int(env("RIVER_STATION")??"85")??85,0,RIVER_MAIN_COUNT-2)
p=RIVER_NODES[station];q=RIVER_NODES[station+1]
if (env("RIVER_CASE")??"")=="canal":
    station=CANAL_BEGIN+clamp(to_int(env("RIVER_STATION")??"22")??22,1,68)
    p=RIVER_NODES[station];q=RIVER_NODES[station+1]
    if station==CANAL_BEGIN+22:p=(p+q)*0.5
dir=normalize(vec3(q.x-p.x,0,q.y-p.y));hd=atan2(f64(dir.x),-f64(dir.z))
comparison=env("RIVER_COMPARE")??""
if comparison=="sea":p=vec4(10000,-14000,0,40)
f=Flyer(kind=Craft.gull,model=0,spec=k,state=water_start(k,vec3(p.x,p.z,p.y),hd))
scenario=env("RIVER_CASE")??"takeoff"
view=env("RIVER_VIEW")??"near"
if scenario=="landing":
    f.state=CraftState(position=vec3(p.x,p.z+k.float_height+3,p.y),velocity=dir*f32(k.stall_speed*1.15)+vec3(0,-0.6,0),orientation=quat_euler(-0.02,-hd,0),fuel=k.fuel_capacity)
plan=FlightPlan(takeoff_heading=hd,target=vec3(p.x,p.z,p.y)+dir*5000.0,altitude=f64(p.z)+180.0)
wakes=[WakeTrail()]
fleet=VesselFleet();fleet_view=VesselView()
if scenario=="canal":ensure_canal_traffic(fleet,0)
frame=0
update=(dt:f64):
    global frame
    frame+=1
    if frame<=180:return
    e=flight_env(f.state.time,f.state.position)
    if scenario=="canal" and (f.state.on_water or f.state.position.y<p.z+40.0):
        reach=canal_station(f.state.position)
        lookahead=if scale<=1.0:3 else:if reach>=CANAL_BEGIN+35 and reach<=CANAL_BEGIN+45:6 else:5
        goal=RIVER_NODES[min(CANAL_FINISH,reach+lookahead)]
        forward=normalize(vec3(goal.x-f.state.position.x,0,goal.y-f.state.position.z))
        plan.takeoff_heading=atan2(f64(forward.x),-f64(forward.z))
        plan.target=f.state.position+forward*5000.0
    c=if scenario!="canal" and f.state.time<5.0:Controls(throttle=0.17) else:autopilot(k,f.state,plan,e)
    if scenario=="canal" and scale>1.0 and f.state.on_water:
        velocity_heading=atan2(f64(f.state.velocity.x),-f64(f.state.velocity.z))
        c.yaw=clamp(angle_delta(plan.takeoff_heading,heading(f.state))*4.0+angle_delta(plan.takeoff_heading,velocity_heading)*2.0,-1.0,1.0)
    if scenario=="landing":c=Controls(assist=0.0,water_brake=0.4)
    if comparison!="":
        # A controlled rendering comparison: identical horizontal ground speed.
        # Float/attitude contact still integrates; only the horizontal speed is clamped.
        f.state.velocity.x=dir.x*25.0;f.state.velocity.z=dir.z*25.0
        c=Controls(throttle=0.5,assist=0.0)
    previous=f.state.position
    step_vessels(fleet,vec2(0,0),1.0/60.0,f.state.position,f.state.velocity)
    step(k,f.state,c,e,1.0/60.0)
    collide_vessels(fleet,k,f.state,previous,0)
    f.sea_t=f.state.time
    f.prop_angle+=1.0/60.0*prop_rotation_speed(f.state,f.feedback.speed)
    feel(f,1.0/60.0,e.wind)
    chase(f,1.0/60.0)
    wake_step(wakes[0],craft_point(f.state),f.state.velocity,f.state.on_water,3.0,f.state.time)
    if frame%60==0:print("RIVER t={f.state.time:.2} pos={f.state.position} wet={f.state.on_water} damage={f.state.hull_damage:.3} speed={length(f.state.velocity):.2}")
draw=():
    # Recording is 20 fps; simulation still advances every fixed 60 Hz step.
    # Avoid rendering the two intervening frames that are never captured.
    if env("RIVER_FRAMES")!=none and frame>180 and frame%3!=0:return
    L=light_at(14.0);t=f.state.time
    clear(BLACK);hide_sky()
    side=vec3(-dir.z,0,dir.x)
    offset=-dir*27.0+side*19.0+vec3(0,11,0)
    if view=="shop":offset=-dir*24.0+side*2.0+vec3(0,7,0)
    if view=="city":offset=-dir*260.0+side*420.0+vec3(0,330,0)
    if view=="far":offset=-dir*1000.0+side*750.0+vec3(0,850,0)
    target=if view=="shop":side*43.0+vec3(0,4,0) else:dir*25.0
    if view=="near" and comparison=="":place_chase_camera(f,t)
    else:precise_camera(craft_offset(f.state,offset),target-offset,62.0,0.1,world_far(f64(f.state.position.y+offset.y)))
    draw_custom(():
        clear_world_depth();draw_sky(L,t);draw_far_sea(depth,L,t,wind_now)
        draw_river_occlusion(depth,L,t)
        draw_river_banks(L,t);draw_canal(L,t);draw_ground(L,t);draw_world_terrain(L,t)
        prepare_vessel_view(fleet_view,fleet,scene_camera(),t,vec2(0,0));draw_vessels(fleet_view,L,t)
        draw_craft_parts(model,f.state.damage,quat_to_mat4(f.state.orientation),L,t,f.prop_angle,airframe(f),0.0,craft_point(f.state),prop_speed=prop_rotation_speed(f.state,f.feedback.speed))
    )
    draw_custom(():draw_sea(water,depth,L,t,wind_now,f.state.velocity),transparent=true)
    draw_custom(():draw_rivers(depth,L,t,f.state.velocity),transparent=true)
    draw_custom(():draw_wakes(wakes,L,t);draw_vessel_wakes(fleet_view,L,t),transparent=true)
    draw_custom(():draw_flight_effects(f,model,craft_transform(f),L,t),transparent=true)
    draw_custom(():draw_prop_discs(L),transparent=true)
    # A 2D submission resolves the deferred 3D passes before framebuffer readback.
    rect(-2,-2,1,1,BLACK)
    if frame==360 and env("RIVER_BANK_STATS")!=none:
        resident,bytes,expanded=river_bank_storage()
        print("BANK_STORAGE groups={resident} bytes={bytes} expanded={expanded}")
    if let folder=env("RIVER_FRAMES"):
        if frame>180 and frame%3==0:assert(save_png("{folder}/{frame:05}.png",screenshot()))
