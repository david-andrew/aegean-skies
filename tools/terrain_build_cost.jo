# CPU-only bound for deriving existing render data from the unchanged 8 m bake.
# Timings only on redfox under ~/dev/tmp/bench.lock.
use '../src/world.jo'
use '../src/terrain_data.jo'
assert(load_land(embed('../assets/terrain.bin')))
t = time()
render = [loop k in 0..ISLANDS.len(): bake_render_tile(k)]
b = encode_render_land(render)
assert(b == embed('../assets/terrain_lod.bin'))
print("derive exact legacy render bytes={b.len()} elapsed={time()-t:.4}s")
