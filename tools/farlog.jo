# Full published registry, real cargo routes and week-long source/population/cash validation.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_transport.jo'
use '../src/living_checks.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true; init_settlements()
w = build_world(u64(42)); publish_settlement_life(w)
assert(configure_far_economy(w))
assert(invariant_errors(w).len()==0 and validate_save_world(w)=="")
print("FAR_OPEN places={w.far.districts.len()} population={far_population(w)} routes={w.far.links.len()} vehicles={w.far.vehicles.len()} sources={w.cargo_sources.len()} opening_cash={w.ledger.opening_cents}")
loop day in 0..7:
    loop _ in 0..1440:
        step_minute(w)
        if w.minute%60==0:
            errors = invariant_errors(w); assert(errors.len()==0,errors.join("; "))
    text = canonical_text(w); restored = from_text[World](text)
    assert(restored is World and canonical_text(restored)==text and validate_save_world(restored)=="")
    print("FAR_DAY {day+1} delivered={w.far.completed_journeys} active={w.far.journeys.len()} produced={w.far.produced} consumed={w.far.consumed} cash_external_in={w.ledger.external_in_cents} sources={w.cargo_sources.len()} bytes={text.len()} population={far_population(w)} hash={canonical_hash(w)}")
assert(w.far.completed_journeys>0)
