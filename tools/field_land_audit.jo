# Functional publication audit; no timing claim and no simulation/stock writes.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/living_fields_bake.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true; init_settlements(true)
packed=inflate(embed('../assets/living-routes.bin')); assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!)); assert(catalog is FarRouteCatalog)
seeds=catalog.seeds
loop k in 0..seeds.len(): seeds[k].fields=[]
assert(bake_field_land(seeds,world_settlements)>0)
seen: {int: bool}
loop s in seeds:
    assert(s.fields.len()<=8)
    loop land in s.fields:
        assert(not (land.id in seen)); seen[land.id]=true
        assert(land.area_ares==10000 and land.width==1000)
        assert(field_arable_cell(land.center.xz,world_settlements))
    if s.id==10001 or s.id==10003:
        eprint("FIELD_CAPITAL place={s.id} parcels={s.fields.len()} population={s.population}")
        assert(s.fields.len()>0,"No actual arable plot near this capital; do not invent one")
eprint("FIELD_LAND_AUDIT_OK unique={seen.len()}")
