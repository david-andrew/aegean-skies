use '../src/vessel_types.jo'
use '../src/vessel_models.jo'
use '../src/vessel_view.jo'
loop k in 0..18:
    kind = VesselKind(k)
    vs = vessel_vertices(kind); far = vessel_vertices(kind,true)
    assert(vs.len() > 0 and vs.len()%3 == 0 and far.len() <= vs.len())
    print("{vessel_spec(kind).name}: near={vs.len()/3} far={far.len()/3} triangles")
