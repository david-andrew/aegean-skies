use '../src/world.jo'
use '../src/terrain_data.jo'
use '../src/terrain_lod.jo'
use '../src/render_space.jo'
use 'terrain_reference.jo'

window("Terrain error check", 1280, 720)
assert(load_land(embed('../assets/terrain.bin')))
b = embed('../assets/terrain_lod.bin')
load_terrain(b)
source = decode_render_land(b)
loop altitude in [2.0, 100.0, 750.0, 1500.0, 3000.0]:
    cam = vec3(2600, f32(altitude), 2600)
    yaw = 0.8; pitch = -0.18
    dir = vec3(f32(-sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
    vp = perspective(62.0 * PI / 180.0, 16.0 / 9.0, 1.0, world_far(altitude)) * look_at(cam, cam + dir, vec3(0, 1, 0))
    terrain_ready = false
    select_terrain(cam, vp, 360.0 / tan(31.0 * PI / 180.0), 0.0)
    worst = 0.0
    seam = 0.0
    loop ti in 0..terrain_tiles.len():
        tile = terrain_tiles[ti]
        loop pi in 0..tile.patches.len():
            worst = max(worst, ref_error_pixels(source[ti], tile, pi, cam, vp))
            seam = max(seam, ref_edge_gap(source[ti], tile, pi, cam))
        # Also test coarser neighbors while they themselves morph to a parent.
        loop mut patch in tile.patches: patch.lod = min(patch.lod + 0.37, 5.0)
        loop pi in 0..tile.patches.len(): seam = max(seam, ref_edge_gap(source[ti], tile, pi, cam))
    print("altitude {altitude:.0}: actual settled screen error {worst:.4} px")
    print("shared edge residual, including parent morph: {seam:.7} m")
    assert(worst < 1.5)
    assert(seam < 0.01)
exit(0)
