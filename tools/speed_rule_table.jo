# The one speed rule's table: every aircraft's real top speed (historical types), its game speeds now
# and under the rule (true m/s, as craft_spec makes them at speed scale 1; drawn at the speed scale),
# as markdown, fastest first by the rule. sloppy tools/speed_rule_table.jo
use '../src/aircraft_catalog.jo'
from '../src/planes.jo' import CRAFT_NAMES, Craft
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw

main = ():
    fl.set_speed_scale(1.0)
    now: fl.CraftSpec[]
    ruled: fl.CraftSpec[]
    tw.set_tweaks(tw.Tweaks(speed_rule = false))
    loop i in 0..AIRCRAFT.len(): now.push(fl.craft_spec(Craft(i), []))
    tw.set_tweaks(tw.Tweaks(speed_rule = true))
    loop i in 0..AIRCRAFT.len(): ruled.push(fl.craft_spec(Craft(i), []))
    print("| # | Aircraft | Role | Real top km/h | Top now m/s (km/h) | Top by the rule m/s (km/h) | Change | Stall (kept) | Cruise now / rule |")
    print("|---:|---|---|---:|---:|---:|---:|---:|---:|")
    order: int[]
    loop i in 0..AIRCRAFT.len(): order.push(i)
    order.sort((i: int) -> f64: -ruled[i].max_speed)
    loop i in order:
        p = AIRCRAFT[i]; a = now[i]; b = ruled[i]
        hist = p.real_top_kmh > 0.0
        real = if hist: "{p.real_top_kmh:.0}" else: "(own design)"
        rule = if hist: "{b.max_speed:.1} ({b.max_speed * 3.6:.0})" else: "same"
        change = if hist: "{(b.max_speed / a.max_speed - 1.0) * 100.0:+.0}%" else: ""
        stall = "{a.stall_speed:.0}"
        cruise = if hist: "{a.cruise_speed:.0} / {b.cruise_speed:.1}" else: "{a.cruise_speed:.0}"
        role = split(p.role, ":")[0]
        print("| {i} | {CRAFT_NAMES[i]} | {role} | {real} | {a.max_speed:.1} ({a.max_speed * 3.6:.0}) | {rule} | {change} | {stall} | {cruise} |")
