# The one speed rule's table: every aircraft's real top speed (historical types) and its game speeds
# (true m/s, as craft_spec makes them at speed scale 1; drawn at the speed scale), as markdown,
# fastest first. sloppy tools/speed_rule_table.jo
use '../src/aircraft_catalog.jo'
from '../src/planes.jo' import CRAFT_NAMES, Craft
import '../src/flight.jo' as fl

main = ():
    fl.set_speed_scale(1.0)
    specs: fl.CraftSpec[]
    loop i in 0..AIRCRAFT.len(): specs.push(fl.craft_spec(Craft(i), []))
    print("| # | Aircraft | Role | Real top km/h | Top m/s (km/h) | Cruise | Stall |")
    print("|---:|---|---|---:|---:|---:|---:|")
    order: int[]
    loop i in 0..AIRCRAFT.len(): order.push(i)
    order.sort((i: int) -> f64: -specs[i].max_speed)
    loop i in order:
        p = AIRCRAFT[i]; a = specs[i]
        real = if p.real_top_kmh > 0.0: "{p.real_top_kmh:.0}" else: "(own design)"
        role = split(p.role, ":")[0]
        print("| {i} | {CRAFT_NAMES[i]} | {role} | {real} | {a.max_speed:.1} ({a.max_speed * 3.6:.0}) | {a.cruise_speed:.1} | {a.stall_speed:.0} |")
