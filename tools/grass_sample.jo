# Deterministic meadow prototype capture. Silent/headless environment required.
use '../src/quality.jo'
use '../src/world.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/terrain_lod.jo'
use '../src/depth_space.jo'
use '../src/grass.jo'
use '../src/terrain.jo'
window("Meadow sample",960,540)
init_quality()
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
enable_world_depth()
init_terrain();init_grass()
towns: Town[]
site=vec3(0,0,0)
best=0.0
loop j in -15..16:
    loop i in -15..16:
        p=ISLANDS[0].center+vec2(f32(i*20),f32(j*20))
        k=grass_cover(towns,f64(p.x),f64(p.y))
        if k>best:
            best=k;site=vec3(p.x,f32(surface_height(f64(p.x),f64(p.y))),p.y)
field=build_grass(towns,site)
mesh=build_tuft()
frame=0
kind=env("GRASS_CASE") ?? "walk"
print("GRASS site={site} cover={best} instances={field.count}")
update=(dt:f64):
    global frame,wind_now,grass_actor,grass_contact_radius
    frame+=1
    wind_step(wind_now,f64(frame)/60.0,1.0/60.0,14.0)
    grass_actor=site+vec3(f32(frame)/60.0*2.0,0,0)
    grass_contact_radius=1.2
    if kind=="wash":
        grass_actor=site+vec3(f32(frame)/60.0*10.0-20.0,3,0)
        grass_contact_radius=9.0
draw=():
    clear(rgb(0.64,0.75,0.79));hide_sky()
    eye=site+vec3(0,1.6,6)
    if kind=="far":eye=site+vec3(0,18,50)
    if kind=="wash":eye=site+vec3(0,5,14)
    camera3d(eye,site+vec3(0,0.2,0),60,0.1,20000)
    draw_custom(():
        clear_world_depth()
        L=light_at(14.0)
        draw_ground(L,f64(frame)/60.0)
        draw_grass(mesh,field,L,f64(frame)/60.0)
    )
