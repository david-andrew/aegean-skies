import 'grass_baseline_terrain.jo' as old_ground
import 'grass_baseline.jo' as before
use '../src/planes.jo'
use '../src/render_space.jo'
# Deterministic meadow prototype capture. Silent/headless environment required.
use '../src/quality.jo'
use '../src/world.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/terrain_lod.jo'
use '../src/depth_space.jo'
use '../src/grass.jo'
use '../src/terrain.jo'
sample_old_ground_fs=(i:GroundOut,u:GroundParams)->vec4:old_ground.baseline_ground_fs(i,u)
window("Meadow sample",960,540)
init_quality()
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
enable_world_depth()
init_terrain();init_grass();init_objects();before.init_grass()
towns: Town[]
site=vec3(40,f32(surface_height(40,0)),0)
field=build_grass(towns,site)
mesh=build_tuft()
old_field=before.build_grass(towns,site)
old_mesh=before.build_tuft()
plane=build_craft(.gull,LIVERIES[0])
baseline=env("GRASS_BEFORE") != none
output=env("GRASS_OUTPUT") ?? ""
capture_step=max(1,to_int(env("GRASS_CAPTURE_STEP") ?? "2") ?? 2)
if baseline:ground_sh=make_world_shader(shader(ground_vs,sample_old_ground_fs))
frame=0
kind=env("GRASS_CASE") ?? "walk"
print("GRASS site={site} instances={field.count}")
update=(dt:f64):
    global frame,wind_now,grass_actor,grass_contact_radius,grass_airflow,field,old_field
    frame+=1
    wind_step(wind_now,f64(frame)/60.0,1.0/60.0,14.0)
    grass_actor=site+vec3(0,0,-f32(frame)/60.0*1.6)
    grass_actor.y=f32(surface_height(f64(grass_actor.x),f64(grass_actor.z)))
    grass_contact_radius=1.2
    if kind=="wash":
        grass_actor=site+vec3(f32(frame)/60.0*6.0-18.0,3,0)
        grass_actor.y=f32(surface_height(f64(grass_actor.x),f64(grass_actor.z)))+3.0
        grass_airflow=vec3(1,0,1.2)
        grass_contact_radius=9.0
    if kind=="approach":
        approach_distance=60.0-f32(frame)*50.0/900.0
        approach_side=env("GRASS_APPROACH_SIDE") ?? "south"
        approach_offset=if approach_side=="west":vec3(-approach_distance,0,0) else:if approach_side=="north":vec3(0,0,-approach_distance) else:vec3(0,0,approach_distance)
        grass_actor=site+approach_offset
        grass_actor.y=f32(surface_height(f64(grass_actor.x),f64(grass_actor.z)))
    if (kind=="walk" or kind=="approach") and length(field.center.xz-grass_actor.xz)>12.0:
        field=build_grass(towns,grass_actor)
        old_field=before.build_grass(towns,grass_actor)
draw=():
    clear(rgb(0.64,0.75,0.79));hide_sky()
    eye=grass_actor+vec3(0,1.6,0)
    target=grass_actor+vec3(0,0.5,-8)
    if kind=="approach":target=site+vec3(0,0.5,0)
    if kind=="far":eye=site+vec3(0,18,50);target=site
    if kind=="wash":eye=site+vec3(0,3.5,12);target=site
    camera3d(eye,target,60,0.1,20000)
    draw_custom(():
        clear_world_depth()
        L=light_at(14.0)
        draw_ground(L,f64(frame)/60.0)
        if baseline:before.draw_grass(old_mesh,old_field,L,f64(frame)/60.0)
        else:draw_grass(mesh,field,L,f64(frame)/60.0)
        if kind=="wash":
            at=translation(grass_actor)*rotation_y(-PI*0.5)
            draw(obj_sh,plane.body,obj_params(L,f64(frame)/60.0,at))
            draw_craft_props(plane,L,f64(frame)/60.0,at,f64(frame)*0.8)
    )
    if frame==120:print("GRASS submitted blades={grass_visible_blades}")
    text(if baseline:"BEFORE" else:"AFTER",vec2(20,20),24,WHITE)
    if output!="" and frame%capture_step==0:
        save_png("{output}/{frame/capture_step:04}.png",screenshot())
