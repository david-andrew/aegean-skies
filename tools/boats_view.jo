# Four views of one aircraft (three-quarter front, side, top, three-quarter rear), for checking a
# model's shape. VIEW_KIND=Craft id, VIEW_LIVERY (default: its own paint).
# Headless: SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 SLOPPY_FRAMES=2 SLOPPY_SCREENSHOT=out.png sloppy tools/boats_view.jo
use '../src/look.jo'
use '../src/objects.jo'
use '../src/planes.jo'

window("Aircraft views", 1600, 1000)
init_objects()
kind = Craft(clamp(to_int(env("VIEW_KIND") ?? "16") ?? 16, 0, CRAFT_NAMES.len() - 1))
livery = to_int(env("VIEW_LIVERY") ?? "-1") ?? -1
model = build_craft(kind, LIVERIES[if livery >= 0: livery else: DEFAULT_LIVERIES[int(kind)]])
p = aircraft_profile(kind)
# (yaw, pitch) per view; yaw 0 looks at the nose from ahead
VIEWS = [vec2(0.7, 0.28), vec2(1.5708, 0.0), vec2(0.0, 1.5), vec2(2.5, 0.3)]

draw = ():
    clear(rgb(0.92, 0.9, 0.83))
    text("{CRAFT_NAMES[int(kind)]}  /  {p.role}  /  {model.body.count / 3} triangles", vec2(20, 30), 22, rgb(0.15, 0.23, 0.25))
    camera3d(vec3(0, 5, -20), vec3(0, 0, 0))
    hide_sky()
    draw_custom(():
        L = light_at(14.5)
        loop j in 0..4:
            x = (j % 2) * 800 + 6; y = 50 + (j / 2) * 475
            cw = 788.0; ch = 465.0
            v = VIEWS[j]
            distance = max(p.span, p.length) * 2.3
            eye = vec3(sin(v.x) * cos(v.y) * distance, sin(v.y) * distance + 0.5, -cos(v.x) * cos(v.y) * distance)
            up = if v.y > 1.4: vec3(0, 0, -1) else: vec3(0, 1, 0)
            cell = translation(vec3((f64(x) + cw * 0.5) / 800.0 - 1.0, 1.0 - (f64(y) + ch * 0.5) / 500.0, 0)) * scaling(vec3(cw / 1600.0, ch / 1000.0, 1))
            u = obj_params(L, 0)
            u.view_proj = cell * perspective(radians(21.0), cw / ch, 1.0, 2000) * look_at(eye, vec3(0, 1.0, 0), up)
            u.cam = eye
            u.model = mat4(); u.origin = vec3(0, 0, 0); u.instance_origin = u.origin
            u.warp_a = vec4(0, 0, 0, 0); u.warp_b = vec4(0, 0, 0, 0)
            draw(obj_sh, model.body, u)
            loop i in 0..model.prop_hubs.len():
                u.model = translation(model.prop_hubs[i]) * rotation_z(0.4 + f64(i))
                draw(obj_sh, model.prop, u)
    )
