# The game with scripted input (SLOPPY_INPUT: keys, touches, a controller's buttons), telling what
# it did: every frame a PROBE line with the panels open (the pause menu, the chart, the notebook,
# a conversation or other panel, and the leisure page), and the touch pad's buttons and the
# notebook's Close where they were drawn. tests/panel_close_test.py runs it and reads the lines.
build:
    name = "Aegean panel probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/touch.jo'
use '../src/notebook.jo'
use '../src/settlements.jo'
use '../src/speech_stream.jo'
use '../src/spoken_view.jo'
use '../src/talk_bubbles.jo'
use '../src/panels.jo'
use '../src/scene_hold.jo'
use '../src/talk_hold.jo'

finish_settlement_registry()
probe_person = -1
base_update: (f64) -> void = game.update
base_draw: () -> void = game.draw

update = (dt: f64):
    base_update(dt)
    buttons = join([loop b in pad.buttons: "{b.label}@{b.at.x:.0}x{b.at.y:.0}"], ",")
    print("PROBE f={frame_number()} paused={game.paused} chart={game.show_chart} notebook={game.notebook.open} ui={game.ui} leisure={game.leisure_ui} page={game.dbg.page} close={notebook_close_at.x:.0}x{notebook_close_at.y:.0} buttons={buttons}")

    # (a conversation: how much of the person's line has arrived, whose bubbles are up, and
    # whether Space is the line's just now; tests/talk_bubbles_test.py reads these)
    # (whoever the conversation is or was with: where they stand, which way they face, whether the
    # scene holds them and what has called them away; and the pilot's own facing)
    global probe_person
    if game.ui == .talk and game.ui_folk >= 0 and game.ui_folk < game.folks.len(): probe_person = game.folks[game.ui_folk].person
    if probe_person >= 0:
        pose = game.living_world.people[probe_person].pose
        to = game.me.pos - pose.pos
        print("WHO f={frame_number()} x={pose.pos.x:.3} z={pose.pos.z:.3} yaw={pose_yaw(pose):.3} bearing={atan2(f64(to.x), f64(to.z)):.3} me_yaw={game.me.yaw:.3} me_bearing={atan2(f64(-to.x), f64(-to.z)):.3} held={scene_holds(probe_person)} paced={scene_pace(probe_person) < 1.0} me_x={game.me.pos.x:.3} me_z={game.me.pos.z:.3} call={game.talk_hold.call} toast={if game.t < game.toast_until: game.toast.replace(" ", "_") else: ""} minute={game.living_world.minute} errand={talk_errand(game.living_world, probe_person)} day={if probe_person in game.living_world.daily_life: "{game.living_world.daily_life[probe_person].activity}/{game.living_world.daily_life[probe_person].venue}/r{game.living_world.daily_life[probe_person].path_revision}/a{game.living_world.daily_life[probe_person].arrived}/w{game.living_world.daily_life[probe_person].waypoint}of{game.living_world.daily_life[probe_person].route.len()}/{if game.living_world.daily_life[probe_person].blocked != "": "blocked" else: "clear"}" else: "none"}")
    # (a question put to the pilot in bubbles outside a conversation: the place's panel number, its
    # bubbles, the speaker's bubble, and the pilot's word)
    if game.ui != .talk and reply_bubble_rects().len() > 0:
        fan = join([loop r in reply_bubble_rects(): "{r.x:.0},{r.y:.0},{r.w:.0},{r.h:.0}"], ";")
        print("FAN f={frame_number()} ui={game.ui} leisure={game.leisure_ui} workshop_talk={game.workshop_talk} said={game.place_bubble_frame >= frame_number() - 1} bubble={game.place_bubble_rect.x:.0},{game.place_bubble_rect.y:.0},{game.place_bubble_rect.w:.0},{game.place_bubble_rect.h:.0} pilot={game.pilot_word.replace(" ", "_")} boxes={fan}")
    if game.ui != .talk and game.pilot_word != "" and game.t < game.pilot_word_until:
        print("SAID f={frame_number()} ui={game.ui} leisure={game.leisure_ui} pilot={game.pilot_word.replace(" ", "_")}")
    if game.keeper_word_frame >= frame_number() - 1:
        print("KEEPER f={frame_number()} ui={game.ui} leisure={game.leisure_ui} remark={game.menu_view.remark.replace(" ", "_")} line={game.menu_view.line.replace(" ", "_")} bubble={game.keeper_word_rect.x:.0},{game.keeper_word_rect.y:.0},{game.keeper_word_rect.w:.0},{game.keeper_word_rect.h:.0}")
    if game.ui == .talk or game.talk_bubbles.person >= 0:
        said = spoken_peek("talk", game.ui_line)
        # (what he can say, where it was drawn: the set showing, the one a d-pad has reached, each
        # bubble's box; and how far off they are, in metres)
        boxes = join([loop r in reply_bubble_rects(): "{r.x:.0},{r.y:.0},{r.w:.0},{r.h:.0}"], ";")
        gap = if game.ui_folk >= 0 and game.ui_folk < game.folks.len(): f64(length(game.folks[game.ui_folk].pos.xz - game.me.pos.xz)) else: -1.0
        print("TALK f={frame_number()} chars={char_count(game.ui_line)} shown={said.shown} done={said.done} ready={said.ready} person={talk_person_speaks(game.talk_bubbles, game.t)} pilot={talk_pilot_speaks(game.talk_bubbles, game.t)} words={game.talk_bubbles.pilot.replace(" ", "_")} line={game.ui_line.replace(" ", "_")} space={space_is_held()} set={reply_set_showing()} reach={reply_reached()} gap={gap:.2} walking={game.talk_hold.walking} speed={game.options.text_speed} options={game.talk_options} clarity={talk_clarity(gap, TALK_FAINT_METRES, TALK_END_METRES):.2} bubble={game.talk_bubble_rect.x:.0},{game.talk_bubble_rect.y:.0},{game.talk_bubble_rect.w:.0},{game.talk_bubble_rect.h:.0} boxes={boxes}")

draw = (): base_draw()
