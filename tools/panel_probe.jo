# The game with scripted input (SLOPPY_INPUT: keys, touches, a controller's buttons), telling what
# it did: every frame a PROBE line with the panels open (the pause menu, the chart, the notebook,
# a conversation or other panel, and the leisure page), and the touch pad's buttons and the
# notebook's Close where they were drawn. tests/panel_close_test.py runs it and reads the lines.
build:
    name = "Aegean panel probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/touch.jo'
use '../src/notebook.jo'
use '../src/settlements.jo'
use '../src/speech_stream.jo'
use '../src/spoken_view.jo'
use '../src/talk_bubbles.jo'
use '../src/panels.jo'

finish_settlement_registry()
base_update: (f64) -> void = game.update
base_draw: () -> void = game.draw

update = (dt: f64):
    base_update(dt)
    buttons = join([loop b in pad.buttons: "{b.label}@{b.at.x:.0}x{b.at.y:.0}"], ",")
    print("PROBE f={frame_number()} paused={game.paused} chart={game.show_chart} notebook={game.notebook.open} ui={game.ui} leisure={game.leisure_ui} page={game.dbg.page} close={notebook_close_at.x:.0}x{notebook_close_at.y:.0} buttons={buttons}")

    # (a conversation: how much of the person's line has arrived, whose bubbles are up, and
    # whether Space is the line's just now; tests/talk_bubbles_test.py reads these)
    if game.ui == .talk or game.talk_bubbles.person >= 0:
        said = spoken_peek("talk", game.ui_line)
        print("TALK f={frame_number()} chars={char_count(game.ui_line)} shown={said.shown} done={said.done} ready={said.ready} person={talk_person_speaks(game.talk_bubbles, game.t)} pilot={talk_pilot_speaks(game.talk_bubbles, game.t)} words={game.talk_bubbles.pilot.replace(" ", "_")} space={space_is_held()} top={conversation_top():.0} speed={game.options.text_speed}")

draw = (): base_draw()
