# Negative acceptance probe: defaults MUST panic. LIVING_RECOVER=1 must keep running instead.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_money.jo'
use '../src/living_cargo.jo'
use '../src/living_guard.jo'
use '../src/living_save.jo'
use '../src/living_far_people.jo'
import '../src/flight.jo' as physics
import '../src/traffic.jo' as traffic
w = build_world()
if env("LIVING_RECOVER") != none: set_living_strict(false)
mode = env("LIVING_GUARD_CASE") ?? "balance"
if mode == "balance":
    w.aircraft[0].fuel_ml += 37
    step_minute(w)
else if mode == "far_walk":
    before=canonical_text(w)
    far_walk_abstract(w,999,w.tick)
    assert(canonical_text(w)==before)
else if mode == "motion":
    w.aircraft[0].move_owner = .scene; w.aircraft[0].last_scene_tick = w.tick
    c = w.aircraft[0]
    body = physics.CraftState(position=c.pose.pos,velocity=c.pose.vel,orientation=c.pose.rot,fuel=f64(c.fuel_ml)/1000.0)
    traffic.commit_player_motion(w,body,c.pose,c.fuel_ml,1.0)
else:
    loop id in cargo_ids(w,.market,0,0): cargo_remove(w,id)
    before = canonical_text(w)
    assert(not trade(w,0,0,0,100,true))
    assert(canonical_text(w) == before)
print("RECOVERY CONTINUED {mode} tick={w.tick} faults={living_faults().len()}")
