# Offline search beside an existing road, outside the house district. The bath
# platform must fit a small natural shelf rather than burying a hillside.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/water_field.jo'
use '../src/inland_connections_data.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements(true)
loop id in [141625,131459]:
    s=world_settlements[settlement_by_id[id]];best=1e9;at=vec3(0,0,0);turn=0.0;root=vec3(0,0,0);range=vec2(0,0)
    paths=[loop road_id in s.roads:settlement_roads[road_id].points]
    loop connection in ACCESS_CONNECTIONS:
        if connection.a==id or connection.b==id:paths.push(connection.points)
    loop path in paths:
        samples:vec3[]
        loop k in 1..path.len():
            a=path[k-1];b=path[k];n=max(1,int(ceil(f64(length(b.xz-a.xz))/16.0)))
            loop j in 0..n:samples.push(mix(a,b,f32(j)/f32(n)))
        loop k in 1..samples.len():
            p=samples[k];d=f64(length(p.xz-s.center.xz))
            if d<s.radius+60 or d>s.radius+1200:continue
            axis=normalize(p.xz-samples[k-1].xz);side=vec2(-axis.y,axis.x)
            loop sign in [-1.0,1.0]:
                center=p.xz+side*f32(sign*28);low=1e9;high= -1e9;valid=true
                loop z in -4..5:
                    loop x in -4..5:
                        q=center+axis*f32(x*4)+side*f32(z*4);h=place_ground(q)
                        low=min(low,h);high=max(high,h)
                        if water_at(f64(q.x),f64(q.y)).wet or length(settlement_avoid_buildings(q)-q)>0.1:valid=false
                score=(high-low)*4+d*0.0003
                if valid and score<best:
                    best=score;at=place_point(center);root=place_point(p.xz);turn=atan2(f64(side.x*sign),f64(side.y*sign));range=vec2(f32(low),f32(high))
    print("SPRING|{s.id}|{s.name}|{s.country}|{s.center}|{at}|{turn}|{root}|{range}|{best}")
