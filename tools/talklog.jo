# Speech sampler over the published registry: residents of many towns greet the pilot, then answer
# each topic the pilot can raise. Headless; prints one line per turn for reading and auditing.
# TALKLOG_DAYS (default 2) of simulation first; TALKLOG_TOWNS (default 24) far towns are sampled.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_place_context.jo'
use '../src/living_content.jo'
use '../src/life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_people.jo'
use '../src/living_far_types.jo'
use '../src/living_sim.jo'
use '../src/living_conversation.jo'
use '../src/speech.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true; init_settlements()
w = build_world(u64(42)); publish_settlement_life(w)
assert(configure_far_economy(w))
days = to_int(env("TALKLOG_DAYS") ?? "2") ?? 2
towns = to_int(env("TALKLOG_TOWNS") ?? "24") ?? 24
loop _ in 0..days*1440: step_minute(w)
# Mid-morning on the last day, when people are out and about.
loop _ in 0..(600-local_minute(w.minute)+1440)%1440: step_minute(w)

far: int[]
loop id in w.far.place_ids:
    if w.far.districts[id].core<0: far.push(id)
far.sort()
step = max(1,far.len()/max(1,towns))
picked = [loop k in 0..far.len(): if k%step==0: far[k]]
loop id in far:
    if w.place_contexts[id].name=="Olythoria" and not (id in picked): picked.push(id)

sample = (w: mut World, person: int, town: str):
    p = w.people[person]
    w.people[w.player].pose.pos = person_world_position(w,person)+vec3(1.5,0,0)
    w.people[w.player].place = p.place
    print("\n== {p.name}, {p.age}, {p.occupation} ({voice_of(w,person)}), {town}")
    bark = passing_line(w,person)
    if bark!="": print("  bark: {bark}")
    g = converse(w,person,w.player,.greeting)
    print("  greeting: {turn_line(g)}")
    if g.replies.len()>0:
        back = answer_conversation(w,person,w.player,.ask_back)
        if back.text!="": print("  [{g.replies[2].label}] {turn_line(back)}")
    loop o in conversation_topics(w,person,w.player):
        if o.topic==.greeting or o.topic==.farewell: continue
        t = converse(w,person,w.player,o.topic)
        if t.text!="": print("  {o.topic} ({o.label}): {turn_line(t)}")
    loop topic in [TalkTopic.market,.people,.news]:
        again = converse(w,person,w.player,topic)
        if again.text!="" and not again.exhausted: print("  {topic} (asked again): {turn_line(again)}")
    t = converse(w,person,w.player,.work)
    if t.text!="": print("  work: {turn_line(t)}")
    bye = converse(w,person,w.player,.farewell)
    if bye.text!="": print("  farewell: {bye.text}")

turn_line = (t: ConversationTurn) -> str: if t.question!="": "{t.text} {t.question}" else: t.text

loop place in picked:
    d = w.far.districts[place]
    loop role in [FarRole.trader,if d.output==0: FarRole.fisher else: FarRole.farmer,FarRole.artisan]: promote_far_person(w,place,role)
    loop person in w.far.districts[place].named: sample(w,person,w.place_contexts[place].name)
loop p in 1..PERSON_SEEDS.len():
    if w.people[p].place<0 or w.people[p].trip>=0: continue
    sample(w,p,life_place_name(w,w.people[p].place))
