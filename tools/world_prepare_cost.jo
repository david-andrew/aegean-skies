# Redfox-only wall clock probe under the benchmark lock. Software atlas uploads
# isolate CPU preparation/generation; shader draw/submission is not timed here.
use '../src/geography.jo'
use '../src/world.jo'
use '../src/world_terrain.jo'
use '../src/terrain_lod.jo'
use '../src/render_space.jo'
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_world_terrain()
cam = vec3(-144000,f32(new_land_surface(-144000.0,-119000.0)+2.0),-119000)
vp = perspective(110.0*PI/180.0,1280.0/720.0,0.3,world_far(f64(cam.y)))*look_at(cam,cam+vec3(0.8,-0.05,-1),vec3(0,1,0))
burst = (env("AEGEAN_COST_BURST") ?? "1") == "1"
peak = 0.0; total = 0.0; ready = -1; max_generated = 0; max_upload = 0
loop frame in 0..120:
    start = time()
    prepare_world_terrain(cam,vp,f64(frame)/60.0,burst)
    elapsed = time()-start
    peak = max(peak,elapsed); total += elapsed
    max_generated = max(max_generated,world_generated)
    max_upload = max(max_upload,world_uploaded)
    if ready < 0 and world_contact_budget(cam) == WORLD_GENERATE_LIMIT: ready = frame+1
print("PREPARE burst={burst} max_cpu_ms={peak*1000.0:.4} total_cpu_ms={total*1000.0:.4} contact_footprint_ready_updates={ready} max_generated={max_generated} max_upload={max_upload}")
