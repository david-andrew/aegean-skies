# CPU/offscreen residency stress; SLOPPY_SOFTWARE=1, no update/draw/window.
use '../src/geography.jo'
use '../src/world.jo'
use '../src/world_terrain.jo'
use '../src/terrain_lod.jo'
use '../src/render_space.jo'
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_world_terrain()
points = [vec2(-151000,-120000),vec2(-144000,-119000),vec2(223000,-72000),vec2(224000,101000),vec2(-69000,175000),small_islands[0].center,vec2(-240000,-190000),vec2(120000,17000)]
max_cache = 0; max_selected = 0
ready_frames: int[]
cached_frames: int[]
loop k in 0..points.len():
    p = points[k]
    y = new_land_surface(f64(p.x),f64(p.y))
    assert(y > 0.0)
    cam = vec3(p.x,f32(y+2.0),p.y)
    yaw = f64(k)*1.391
    dir = vec3(f32(sin(yaw)),-0.05,f32(cos(yaw)))
    vp = perspective(110.0*PI/180.0,1280.0/720.0,0.3,world_far(y+2.0))*look_at(cam,cam+dir,vec3(0,1,0))
    ready = -1; cached = -1
    key = world_tile_key(int(floor((f64(p.x)-WORLD_ROOT_ORIGIN)/224.0)),int(floor((f64(p.y)-WORLD_ROOT_ORIGIN)/224.0)),0)
    loop frame in 0..180:
        prepare_world_terrain(cam,vp,f64(k*180+frame)/60.0)
        world_prepare_edge_states()
        if frame%30==0:
            loop i in 0..world_selected.len():
                assert(world_cached_edge_state(i)==world_edge_state(world_selected[i]))
        max_cache = max(max_cache,world_cache.len())
        max_selected = max(max_selected,world_selected.len())
        assert(world_cache.len() <= WORLD_CACHE_SLOTS)
        assert(world_generated <= world_generate_budget and world_generate_budget <= WORLD_CONTACT_GENERATE_LIMIT)
        if cached < 0 and key in world_cache: cached = frame+1
        if ready < 0:
            loop slot in world_selected:
                tile = world_tiles[slot]
                if tile.level != 0 or tile.lod != 0.0: continue
                ox,oz = world_tile_origin(tile.x,tile.z,tile.level)
                if f64(p.x) >= ox and f64(p.x) < ox+224.0 and f64(p.y) >= oz and f64(p.y) < oz+224.0: ready = frame+1
    found = 0
    loop slot in world_selected:
        tile = world_tiles[slot]
        ox,oz = world_tile_origin(tile.x,tile.z,tile.level); size = world_tile_size(tile.level)
        if f64(p.x) >= ox and f64(p.x) < ox+size and f64(p.y) >= oz and f64(p.y) < oz+size:
            found += 1
            if tile.level != 0: print("contact not fine: station={k} level={tile.level} cache={world_cache.len()} selected={world_selected.len()}")
            assert(tile.level == 0 and tile.lod == 0.0)
    assert(found == 1 and ready > 0)
    ready_frames.push(ready)
    cached_frames.push(cached)
print("WORLD CACHE PASS teleports={points.len()} fov=110 contact=14m cache={max_cache}/512 selected={max_selected} contact_ready_updates={ready_frames} cached_updates={cached_frames}")
