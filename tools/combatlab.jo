# Explicit synthetic fixture, never loaded by the living game. COMBAT_SCENE=battle|burning|chute|cockpit.
# COMBAT_COUNT=30, COMBAT_SEEK=ticks, COMBAT_FREEZE=1. COMBAT_BENCH=ticks runs CPU-only.
# Timings are meaningful only on the quiet laptop under its bench.lock.
use '../src/combat.jo'
use '../src/flight.jo'
use '../src/damage.jo'
use '../src/planes.jo'
use '../src/combat_view.jo'
use '../src/cockpit.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/curved_world.jo'
use '../src/sea.jo'
use '../src/world.jo'
use '../src/sky.jo'
use '../src/quality.jo'

build:
    js = "../src/web_compat.js"


set_speed_scale(1)
scene=env("COMBAT_SCENE") ?? "battle"
count=clamp(to_int(env("COMBAT_COUNT") ?? "30") ?? 30,0,40)
if scene!="battle" and scene!="stress":count=1
models=build_craft_models()
actors:Combatant[]
loop i in 0..count:
    kind=if scene=="cockpit":Craft(clamp(to_int(env("COMBAT_KIND") ?? "0") ?? 0,0,15)) else:Craft.corsair
    model=models[default_craft_model(kind)];spec=craft_spec(kind,model.contacts)
    side=i%2;row=i/2
    at=vec3(18000+f64(row%5-2)*110,420+f64(row/5)*90,18000+(if side==0:200 else:-100))
    if scene!="battle" and scene!="stress":at=vec3(18000,240,18000)
    state=CraftState(position=at,velocity=vec3(0,0,-65),throttle=0.8,fuel=spec.fuel_capacity,orientation=quat_euler(0,0,0))
    actors.push(Combatant(i,i,side,spec,state,model=if kind==.corsair and side==0:11 else:default_craft_model(kind),pilot=CombatPilot(skill=if side==0:0.95 else:0.5,nerve=0.85)))
battle=start_engagement(1,27,vec3(18000,400,18000),actors)
if scene=="flyby":
    battle.actors[0].external=true;battle.actors[0].human=true
    battle.actors[0].state.position=vec3(17930,400,18000)
    battle.actors[0].state.velocity=vec3(65,0,0)
    battle.actors[0].state.orientation=quat_euler(0,-PI*0.5,0)
if scene=="cockpit":
    battle.actors[0].external=true;battle.actors[0].human=true
    if env("COMBAT_HIT")!=none:
        apply_bullet_hit(battle,0,.engine,actors[0].state.position,vec3(0,0,1),0.65,99)
if scene=="burning" or scene=="chute":
    apply_bullet_hit(battle,0,.engine,actors[0].state.position,vec3(0,0,1),0.8,99)
    if scene=="chute":bail_combatant(battle,0)
    else:
        apply_bullet_hit(battle,0,.left_wing,actors[0].state.position,vec3(0,0,1),2,99)
if scene=="stress":
    loop i in 0..battle.actors.len():
        # Fixed fly-through, all thirty burning: deliberately harsher than an ordinary fight.
        battle.actors[i].external=true;battle.actors[i].human=true;battle.actors[i].fire=0.6
        battle.actors[i].state.damage.smoke=0.7
        battle.actors[i].last_attacker=99
observer=vec3(18000,450,18650)
if let distance=env("COMBAT_DISTANCE"):observer=vec3(18000,500,18000+ (to_float(distance) ?? 2000.0))
if env("COMBAT_FAR")!=none:observer.z=22000
env_flight=FlightEnv(wind=vec3(5,0,1))
if let ticks=env("COMBAT_BENCH"):
    n=to_int(ticks) ?? 3600
    times:f64[];pairs=0;brains=0
    loop tick in 0..n:
        before=time();step_battle(battle,env_flight,observer);times.push((time()-before)*1000.0)
        pairs=max(pairs,battle.pair_tests);brains+=battle.brain_steps
    times.sort();total=0.0
    loop t in times:total+=t
    print("COMBAT count={count} ticks={n} far={env("COMBAT_FAR")!=none} mean_ms={total/f64(n):.4} p50_ms={times[n/2]:.4} p95_ms={times[n*95/100]:.4} max_pairs={pairs} brains={brains} outcomes={battle.outcomes.len()}")
    exit(0)

window("Combat acceptance",1280,720)
init_quality()
init_objects();init_sky();init_sea();init_curved_world()
assert(load_land(embed('../assets/terrain.bin')))
sea=build_sea_mesh();depth=build_depth_texture()
view=make_combat_view();cockpit=build_cockpit();wind=Wind()
seek=max(0,to_int(env("COMBAT_SEEK") ?? "0") ?? 0)
one_tick=():
    if scene=="flyby":step(battle.actors[0].spec,battle.actors[0].state,Controls(throttle=0.8),env_flight,COMBAT_DT)
    step_battle(battle,env_flight,observer)
    if scene=="stress":
        loop mut a in battle.actors:
            a.state.position.z-=0.8
            a.state.damage.smoke=0.7;a.fire=0.6;a.fire_age=0;a.state.on_water=false;a.status=.flying
            a.state.damage.parts[1].health=1;a.state.engine_damage=0;a.pilot.trigger=true;a.gun.locked=false;a.gun.ammo=500
    combat_effect_events(view,battle.events)
    update_combat_view(view,battle,env_flight.wind,COMBAT_DT,observer)
loop i in 0..seek:one_tick()
print("fixture tick={battle.tick} ribbons={view.trails.ribbons.len()} rounds={battle.rounds.len()} particles={view.flame.items.len()}")
if battle.actors.len()>0:print("actor angular={battle.actors[0].state.angular_velocity} shots={battle.actors[0].gun.shots}")
update=(dt:f64):
    if env("COMBAT_FREEZE")==none:one_tick()

draw=():
    t=f64(battle.tick)*COMBAT_DT;L=light_at(14.5)
    fog(L.haze,L.fog_density,0.0012)
    focus=if battle.actors.len()>0:battle.actors[0].state.position else:vec3(0,400,0)
    if scene=="chute" and battle.descents.len()>0:focus=battle.descents[0].position+vec3(0,3,0)
    if scene=="cockpit":place_cockpit_camera(models[default_craft_model(battle.actors[0].spec.kind)],battle.actors[0].state,0,to_float(env("COMBAT_PITCH") ?? "0") ?? 0,t,0,battle.bullet_scale)
    else if env("COMBAT_DISTANCE")!=none:camera3d(observer,vec3(18000,400,18000),62,0.1,100000)
    else if scene=="flyby":camera3d(vec3(18000,405,18070),vec3(18000,400,18000),62,0.1,100000)
    else if scene=="battle" and env("COMBAT_STATIC_CAMERA")!=none:camera3d(vec3(18000,700,18650),vec3(18000,400,18000),62,0.1,100000)
    else if scene=="battle":camera3d(focus+vec3(105,90,160),focus+vec3(0,0,-130),62,0.1,100000)
    else:camera3d(focus+vec3(22,10,27),focus,52,0.1,100000)
    hide_sky()
    draw_custom(():draw_sky(L,t))
    draw_custom(():draw_far_sea(depth,L,t,wind))
    draw_custom(():
        draw_combat_aircraft(view,battle,models,L,t,if scene=="cockpit":0 else:-1)
        if scene=="cockpit":
            a=battle.actors[0];m=models[default_craft_model(a.spec.kind)]
            at=translation(a.state.position)*quat_to_mat4(a.state.orientation)
            draw_cockpit_airframe(m,a.state,at,L,t)
            draw_cockpit(cockpit,m,a.spec,a.state,at,L,t,scale=battle.bullet_scale)
            draw_player_hit_marks(view,a,at,L,t,true)
    )
    draw_custom(():draw_sea(sea,depth,L,t,wind),transparent=true)
    draw_combat_particles(view,battle)
