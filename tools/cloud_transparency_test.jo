# Regression scene: production vertex/material/depth paths on colour-keyed probes.
# Rows are fixed material slots, columns are 8 / 120 / 300 m (rain 8 / 16 / 24 m).
# CLOUD_TEST_MODE=front|behind|clear|blank. Behind is a negative occlusion control.
build:
    js = "../src/web_compat.js"
use '../src/cloud_transparency.jo'
use '../src/cloud_volume.jo'
use '../src/cloud_depth.jo'
use '../src/depth_space.jo'
use '../src/render_space.jo'
use '../src/world_point.jo'
use '../src/look.jo'
use '../src/quality.jo'
use '../src/prop_disc.jo'
use '../src/splash.jo'
use '../src/trails.jo'
use '../src/combat_trails.jo'
use '../src/curved_world.jo'
use '../src/rain.jo'
use '../src/wake.jo'
use '../src/flight_effects.jo'
use '../src/vessel_view.jo'
use '../src/world_blend.jo'
use '../src/sea.jo'
use '../src/objects.jo'
window("Cloud / blended world regression",1200,900)
enable_world_depth();init_quality();init_cloud_volumes();init_objects();init_curved_world();init_splashes();init_prop_discs()
mode=env("CLOUD_TEST_MODE") ?? "front"
L=light_at(14.0)
key=(c:vec4)->vec4:vec4(1,0,0.85,c.w)
probe_sea_vs=(v:SeaVertex,u:SeaParams)->SeaOut:SeaOut(u.view_proj*vec4(render_world(v.pos,u.cam),1),v.pos)
key_prop=(i:PropDiscOut,u:PropDiscParams)->vec4:key(prop_disc_fs(i,u))
sh_prop=make_world_shader(shader(prop_disc_vs,key_prop))
key_splash=(i:SplashOut,u:SplashParams)->vec4:key(splash_fs(i,u))
sh_splash=make_world_shader(shader(splash_vs,key_splash))
key_trail=(i:TrailOut,u:TrailParams)->vec4:key(trail_fs(i,u))
sh_trail=make_world_shader(shader(trail_vs,key_trail))
key_smoke=(i:LocalParticleOut,u:LocalParticleParams)->vec4:key(local_particle_fs(i,u))
sh_smoke=make_world_shader(shader(local_particle_vs,key_smoke))
key_battle=(i:BattleTrailOut,u:BattleTrailParams)->vec4:key(battle_trail_fs(i,u))
sh_battle=make_world_shader(shader(battle_trail_vs,key_battle))
key_rain=(i:RainOut,u:RainParams)->vec4:key(rain_fs(i,u))
sh_rain=make_world_shader(shader(rain_vs,key_rain))
key_wake=(i:WakeOut,u:WakeParams)->vec4:key(wake_fs(i,u))
sh_wake=make_world_shader(shader(curved_wake_vs,key_wake))
key_fx=(i:FlightFxOut,u:FlightFxParams)->vec4:key(flight_fx_fs(i,u))
sh_fx=make_world_shader(shader(flight_fx_vs,key_fx))
key_vessel=(i:ObjOut,u:VesselParams)->vec4:key(vessel_smoke_fragment(i,u))
sh_vessel=make_world_shader(shader(vessel_vertex,key_vessel))
key_blend=(i:LitOut,u:WorldBlendParams)->vec4:key(world_blend_fs(i,u))
sh_blend=make_world_shader(shader(world_blend_vs,key_blend))
key_tracer=(i:LitOut,u:LitParams)->vec4:key(curved_lit_fs(i,u))
sh_tracer=make_world_shader(shader(curved_lit_inst,key_tracer))
key_sea=(i:SeaOut,u:SeaParams)->vec4:key(sea_fs(i,u))
sh_sea=make_world_shader(shader(probe_sea_vs,key_sea))
quad=[vec2(-1,-1),vec2(1,-1),vec2(-1,1),vec2(-1,1),vec2(1,-1),vec2(1,1)]
particle_mesh=mesh([loop q in quad:Vertex3D(vec3(0,0,0),vec3(0,0,1),(q+vec2(1,1))*0.5,vec4(1,1,1,1))])
unit_mesh=mesh([loop q in quad:Vertex3D(vec3(q.x,q.y,0),vec3(0,0,1),vec2(0,0),vec4(1,1,1,1))])
img=image(2,2)
loop y in 0..2:
    loop x in 0..2:img.set(x,y,vec4(1,0,0,1))
depth=texture(img,true);init_expanded_depth(depth)
# 14 rows: the last two exercise generic glass and in-world marker materials.
point=(row:int,col:int)->vec3:
    d=if row==6:[8.0,12.0,16.0][col] else:if mode=="behind":2400.0 else:[8.0,120.0,300.0][col]
    x=(f64(col)-1.0)*0.58;y=1.0-(f64(row)+0.5)*2.0/14.0
    vec3(x*d*tan(31.0*PI/180.0)*1200.0/900.0,1000.0+y*d*tan(31.0*PI/180.0),-d)
probe=(row:int,col:int):
    p=point(row,col);r=f64(-p.z)*0.028
    chart=render_origin(scene_camera());eye=render_eye(chart);vp=render_view_proj(chart)
    p-=chart
    at=translation(p)*scaling(r)
    if row==0:
        instance=prop_disc_instance(at,1,3,eye-p,L,0,78,1,0)
        draw_instanced(sh_prop,prop_disc_mesh,[instance],PropDiscParams(cloud_veil,vec3(0,0,0),vp,eye,L.haze,0,vec4(0,0,0,0),vec4(0,0,0,0),vec3(1,1,1),L.shade))
    if row==1:
        glDepthMask(1)
        draw_instanced(sh_splash,splash_mesh,[SplashInstance(vec4(p,1),vec4(r,r,r,0))],SplashParams(vp,eye,L.sun_dir,vec3(1,1,1),L.haze,0,vec4(0,0,0,0),vec4(0,0,0,0)))
        glDepthMask(0)
    if row==2:
        m=mesh([loop q in quad:TrailVertex(p+vec3(q.x*r,q.y*r,0),vec4(q.x,0.1,1,0.04))])
        draw(sh_trail,m,TrailParams(view_proj=vp,cam=eye,sun=L.sun,sky=L.sky_top,clouds=cloud_veil))
    if row==3 or row==4:
        if row==4:glBlendFunc(GL_SRC_ALPHA,GL_ONE)
        draw_instanced(sh_smoke,particle_mesh,[LocalParticle(p,f32(r),vec4(1,1,1,0.85))],LocalParticleParams(cloud_veil,vp,vec3(1,0,0),vec3(0,1,0)))
        glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA)
    if row==5:
        m=mesh([loop q in quad:BattleTrailVertex(p+vec3(q.x*r,q.y*r,0),vec4(q.x,q.y,0,0),vec4(1,1,1,0.8))])
        draw(sh_battle,m,BattleTrailParams(cloud_veil,vp,eye,L.haze,0,vec4(0,0,0,0),vec4(0,0,0,0)))
    if row==6:
        m=mesh([loop j in -3..4:loop q in quad:RainVertex(p+vec3(f64(j)*0.07,0,0),q)])
        draw(sh_rain,m,RainParams(cloud_veil,vp,eye,vec3(0,0,0),vec3(1,1,1),0,1,2000,vec3(0,0,0),vec3(0,0,0)))
    if row==7:
        m=mesh([loop q in quad:Vertex3D(p+vec3(q.x*r,q.y*r,0),vec3(0,1,0),vec2(1.0+q.x*0.07,0.1),vec4(1,0,0.03,1))])
        draw(sh_wake,m,WakeParams(clouds=cloud_veil,view_proj=vp,cam=eye,sun_dir=L.sun_dir,sun=L.sun,sky=L.sky_top))
    if row==8:
        m=mesh([loop q in quad:FlightFxVertex(p+vec3(q.x*r,q.y*r,0),vec4(1,1,1,0.8),q)])
        draw(sh_fx,m,FlightFxParams(cloud_veil,vp,eye,L.haze,0,vec4(0,0,0,0),vec4(0,0,0,0)))
    if row==9:
        draw_instanced(sh_vessel,unit_mesh,[VesselInstance(at,color=vec4(1,1,1,0.8))],VesselParams(cloud_veil,obj_params(L,0),vec3(0,0,0)))
    if row==10:
        glDepthMask(1)
        draw_instanced(sh_tracer,unit_mesh,[instance(at)],render_lit_params(chart,2.2));glDepthMask(0)
    if row==11:
        glDepthMask(1)
        m=mesh([loop q in quad:SeaVertex(p+vec3(q.x*r,q.y*r,0))])
        params=sea_params(depth,L,0,wind_now,vec3(0,0,0),SeaShadows());params.fog=0
        draw(sh_sea,m,params);glDepthMask(0)
    if row==12 or row==13:
        draw_instanced(sh_blend,unit_mesh,[instance(at,vec4(1,1,1,0.6))],WorldBlendParams(render_lit_params(chart,0.8),cloud_veil))
draw=():
    clear(vec4(0.08,0.14,0.25,1));hide_sky();post_effects(0,0,0,1)
    render_camera(vec3(0,1000,0),vec3(0,0,-1),62,0.035,10000)
    draw_custom(():begin_cloud_depth())
    # Solid late materials publish depth before cloud compositing.
    if mode!="blank":
        draw_custom(():
            loop row in [1,10,11]:
                loop col in 0..3:probe(row,col)
        ,transparent=true)
    cloud=CloudVolume(vec3(0,1000,-1200),vec3(2000,1500,650),0)
    draw_cloud_layer(if mode=="clear":[] else:[cloud],L)
    if mode!="blank":
        draw_custom(():
            loop row in 0..14:
                if row==1 or row==10 or row==11:continue
                loop col in 0..3:probe(row,col)
        ,transparent=true)
