# Compact macro geography only; no continent-sized fine terrain bake.
use '../src/geography.jo'
b = encode_geography()
assert(load_geography(b))
p = join_path(dir_name(args()[0]), '../assets/world.bin')
assert(write_bytes(p,b))
print("world macro: {b.len()} bytes, {small_islands.len()} small islands, key {geography_key()}")
