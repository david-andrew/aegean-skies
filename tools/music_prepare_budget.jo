# Loading warmup and subsequent Play/Seek latency; file-only, under redfox's lock.
use '../src/radio_synth.jo'

start=time_ns()
s=make_radio_synth()
radio_synth_prepare(s)
print("prepare_ms={f64(time_ns()-start)/1e6:.4}")
loop piece in 0..7:
    loop seconds in [0.0,19.999,42.345]:
        start=time_ns()
        radio_synth_program(s,.morse,0,seconds);s.style=.classical
        radio_music_program(s,piece,seconds)
        block=radio_render(s,800,0.55,4)
        print("piece={piece} seconds={seconds} select_and_first50_ms={f64(time_ns()-start)/1e6:.4} samples={block.len()}")
print("DONE")
