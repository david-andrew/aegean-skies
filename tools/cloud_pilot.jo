use '../src/world_point.jo'
build:
    js = "../src/web_compat.js"
use '../src/cloud_volume.jo'
use '../src/cloud_transparency.jo'
use '../src/cloud_field.jo'
use '../src/celestial.jo'
use '../src/cloud_depth.jo'
use '../src/sky.jo'
use '../src/look.jo'
use '../src/quality.jo'
use '../src/trails.jo'
use '../src/weather_scene.jo'
import '../src/living_conditions.jo' as conditions
window("Cloud pilot", 1280, 720)
init_quality()
init_cloud_volumes()
init_sky()
init_trails()
box = cube_mesh(180.0)
clouds = [CloudVolume(vec3(0, 1500, 0), vec3(1700, 1700, 1700), 0), CloudVolume(vec3(2600, 1700, -2800), vec3(2300, 1500, 1900), 1)]
# Reproducible shape/angle variants for matched-scale and blinded crop checks.
clouds[0].shape = clamp(f32(to_float(env("CLOUD_KIND") ?? "0") ?? 0.0),0.0,3.0)
clouds[0].heading = f32(to_float(env("CLOUD_HEADING") ?? "0") ?? 0.0)
frame = 0
hour = to_float(env("AEGEAN_HOUR") ?? "14") ?? 14.0
mode = env("CLOUD_VIEW") ?? "front"
update = (dt: f64):
    global frame
    frame += 1
draw = ():
    L = light_at(hour, to_float(env("CLOUD_DAY") ?? "0") ?? 0.0)
    eye = vec3(0, 700, 4800); target = vec3(400, 1700, 0)
    if mode == "storm": eye = vec3(0,1000,14000); target = vec3(0,3000,0)
    if mode == "storm_wall": eye = vec3(3200,1800,6500); target = vec3(0,3800,0)
    if mode == "field": eye = vec3(0, 1800, 4800); target = eye + vec3(0, 0, -1)
    if mode == "field_sunset": eye = vec3(0, 1200, 4800); target = eye + vec3(-1, 0.05, -0.07)
    if mode == "portrait":
        eye = vec3(0,700,4800); target = vec3(0,1600,0)
    if mode == "comparison" or mode == "life":
        eye = vec3(-2400,650,-1600); target = vec3(0,1500,0)
    if mode == "lit":
        eye = vec3(-3800,700,-2800); target = vec3(0,1600,0)
    comparison_distance = clamp(to_float(env("CLOUD_DISTANCE") ?? "1") ?? 1.0,1.0,4.0)
    if mode == "comparison":
        offset = eye-target
        eye.x = target.x+offset.x*f32(comparison_distance)
        eye.z = target.z+offset.z*f32(comparison_distance)
        comparison_distance = f64(length(eye-target)/length(offset))
    if mode == "trails": eye = vec3(0,900,90); target = vec3(0,900,0)
    if mode == "above": eye = vec3(0, 4400, 4800)
    if mode == "inside": eye = vec3(0, 1500, 400); target = eye + vec3(0, 0, -1)
    if mode == "entry": eye.z = f32(4800.0 - f64(frame) * 12.0); target = eye + vec3(0, 0, -1)
    if mode == "moon": eye = vec3(0, 700, 0); target = eye + L.moon_dir
    if let position = env("CLOUD_EYE"):
        coords = position.split(" ")
        if coords.len() == 3:
            eye = vec3(f32(to_float(coords[0]) ?? 0.0),f32(to_float(coords[1]) ?? 1500.0),f32(to_float(coords[2]) ?? 4800.0))
            target = clouds[0].center
    if let aim = env("CLOUD_TARGET"):
        coords = aim.split(" ")
        if coords.len() == 3: target = vec3(f32(to_float(coords[0]) ?? 0.0),f32(to_float(coords[1]) ?? 1500.0),f32(to_float(coords[2]) ?? 0.0))
    clear(BLACK); hide_sky(); sun(L.sun_dir, L.sun, 0.0)
    post_effects(0.35, 0.85, 0.22, 1.08)
    camera3d(eye, target, if mode == "moon": 4.0 else: if mode == "comparison": 2.0*atan(tan(31.0*PI/180.0)/comparison_distance)*180.0/PI else: 62.0, 1.0, 240000.0, if mode == "bank": vec3(f32(sin(f64(frame) * 0.025)), f32(cos(f64(frame) * 0.025)), 0) else: vec3(0, 1, 0))
    draw_custom((): begin_cloud_depth())
    draw_custom((): draw_sky(L, 0.0))
    if mode == "moon": return

    # A far opaque edge through a near cloud must not punch a reconstruction
    # crack into it; it also must not leak clouds over the near red cube.
    if mode == "horizon":
        draw_mesh(cube_mesh(1.0), translation(vec3(0, -100000, -150000)) * scaling(vec3(500000, 201500, 100)), rgba(0.2, 0.4, 0.65, 1))
    if mode != "portrait" and mode != "lit" and mode != "trails" and mode != "comparison" and mode != "life" and mode != "storm" and mode != "storm_wall":
        draw_mesh(box, translation(vec3(-400, 1300, 1800)), rgba(0.9, 0.2, 0.12, 1))
        draw_mesh(box, translation(vec3(400, 1400, 0)), rgba(0.9, 0.2, 0.12, 1))
        draw_mesh(box, translation(vec3(950, 1500, -1500)), rgba(0.9, 0.2, 0.12, 1))
    if env("CLOUD_NO_CLOUDS") == none: draw_cloud_layer(if mode == "field" or mode == "field_sunset": world_clouds(eye, vec2(0, 0)) else: if mode == "trails": [CloudVolume(vec3(0,900,0),vec3(50,50,50),0)] else: if mode == "portrait" or mode == "lit" or mode == "comparison": [clouds[0]] else: if mode == "storm" or mode == "storm_wall": [CloudVolume(vec3(0,3000,0),vec3(5500,4000,4500),5,weather=vec2(1,1))] else: if mode == "life": [cloud_evolve(clouds[0],conditions.WeatherAir(cloud=0.8,towers=0.4),to_float(env("CLOUD_SECONDS") ?? "0") ?? 0.0)] else: clouds, L)
    if mode == "trails" and env("CLOUD_NO_TRAILS") == none:
        test_trails: Trail[]
        loop k in 0..3:
            z = [60.0,0.0,-60.0][k]; y = 910.0-f64(k)*10.0
            test_trails.push(Trail(pts=[TrailPoint(WorldPoint(-40,y,z),0,1),TrailPoint(WorldPoint(40,y,z),0,1)],on=true))
        draw_custom((): draw_trails(test_trails,L,0.5),transparent=true)
