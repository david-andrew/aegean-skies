# An eclipse over open water, for judging the Sun's bite, the beads, the diamond ring, the corona,
# totality's sky and a lunar eclipse without loading the world: the game's own sky and sea programs.
#   ECL_PHASE  a phase (eclipse.jo ECLIPSE_PHASES: first partial deep crescent beads ring total third
#              after last annular lunar-penumbral lunar-partial lunar-total lunar-leaving)
#   ECL_ROW=n  instead: the table's row n replayed here, ECL_MINUTES from its greatest (default 0)
#   ECL_HOUR   the sun's time (10, or 23 for a lunar phase)   ECL_FOV (62)   ECL_EYE (40 m)
#   ECL_AIM    sun|moon (default: the one eclipsed) or ECL_YAW / ECL_PITCH (degrees)
#   ECL_SEED   the corona's pattern (a forced eclipse's)   ECL_RUN=minutes a second (with SLOPPY_FIXED_STEP)
#   ECL_FRAMES=dir: frames saved there (every second frame)
build:
    js = "../src/web_compat.js"
use '../src/sky.jo'
use '../src/sea.jo'
use '../src/celestial.jo'
use '../src/look.jo'
use '../src/day_air.jo'
use '../src/eclipse.jo'
use '../src/depth_space.jo'
use '../src/render_space.jo'
window("Eclipse",1280,720)
enable_world_depth();init_sky();init_sea()
water=build_sea_mesh()
img=image(1,1)
img.set(0,0,vec4(1,0,0,1))
depth=texture(img)
expanded_depth=depth;nearby_depth=depth
num=(name:str,d:f64)->f64:to_float(env(name)??"")??d
phase=env("ECL_PHASE")??"total"
lunar=starts_with(phase,"lunar")
hour=num("ECL_HOUR",if lunar:23.0 else:10.0)
fov=num("ECL_FOV",62.0);eye=num("ECL_EYE",40.0)
run=num("ECL_RUN",0.0)
base=5000000.0+hour*60.0
row=to_int(env("ECL_ROW")??"")??-1
if row>=0:eclipse_force_row(row,num("ECL_MINUTES",0.0),base,0.0,0.0)
else:eclipse_force_phase(phase,base,0.0,0.0)
wind=Wind(vec2(0.8,0.6),5.0,vec2(0,0))
seconds=0.0
frames_dir=env("ECL_FRAMES")
update=(dt:f64):
    global seconds
    seconds+=dt
draw=():
    clear(BLACK);hide_sky();post_effects(0.35,0.85,0.22,1.08, scene_depth = true)
    minute=base+seconds*run
    h=(hour+seconds*run/60.0)%24.0
    L=light_at(h,100.0)
    e=eclipse_at(minute,0.0,0.0,L.sun_dir)
    if let sd=to_float(env("ECL_SEED")??""):e.seed=int(sd)
    L=eclipse_light(L,e)
    if env("ECL_NOGLOW")!=none:L.afterglow=vec4(0,0,0,0)
    eclipse_frame_set(e,minute,L.sun_dir)
    look=if lunar or env("ECL_AIM")=="moon":L.moon_dir else:L.sun_dir
    if env("ECL_YAW")!=none:
        yaw=num("ECL_YAW",180.0)*PI/180.0;pitch=num("ECL_PITCH",10.0)*PI/180.0
        look=vec3(f32(sin(yaw)*cos(pitch)),f32(sin(pitch)),f32(cos(yaw)*cos(pitch)))
    if frame_number()==2:print("ECLIPSE phase={phase} row={e.row} covered={e.covered:.4} sliver={e.sliver:.4} k={e.k:.4} offset={e.offset} minutes={e.minutes:.2} sun_y={L.sun_dir.y:.3} look={L.eclipse_look}")
    render_camera(vec3(0,f32(eye),0),look,fov,0.5,300000)
    draw_custom(():
        clear_depth()
        draw_sky(L,123.5+seconds)
        draw_sea(water,depth,L,123.5+seconds,wind))
    if let directory=frames_dir:
        if frame_number()>=4 and frame_number()%2==0:save_png("{directory}/{(frame_number()-4)/2:05}.png",screenshot())
