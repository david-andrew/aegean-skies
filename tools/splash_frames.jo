# Splash comparison: POLISH_SEQUENCE=directory captures every second frame.
# Real simulation snapshots with the game's meshes/effects/swell. No scripted aircraft poses.
# POLISH_CASE=takeoff|landing|stall-in|turn|night POLISH_TIME=seconds POLISH_KIND=0..15
use '../src/splash.jo'
use '../src/cloud_transparency.jo'
use '../src/wake.jo'
use '../src/prop_disc.jo'
use '../src/flight.jo'
use '../src/weather_scene.jo'
use '../src/flight_feedback.jo'
use '../src/flight_effects.jo'
use '../src/pilot.jo'
use '../src/planes.jo'
use '../src/damage.jo'
use '../src/tweaks.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/sea.jo'
use '../src/curved_world.jo'
use '../src/trails.jo'
use '../src/world_point.jo'
use '../src/world_particles.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'

window("Flight polish / physical frame sequence",1280,720)
enable_world_depth()
init_objects();init_sea();init_curved_world();init_trails();init_flight_effects();init_splashes();init_wake()
set_speed_scale(3.3);set_tweaks(Tweaks())
kind=Craft(clamp(to_int(env("POLISH_KIND") ?? "0") ?? 0,0,15))
model=build_craft(kind,LIVERIES[0]);models=[model]
k=craft_spec(kind,model.contacts);k.player=true
s=water_start(k,vec3(0,0,0))
scenario=env("POLISH_CASE") ?? "takeoff"
if scenario=="landing" or scenario=="stall-in":wind_now.speed=12.0
# Explicit wet-air fixture for the condensation sample; no humidity inferred from altitude.
if scenario=="turn":weather_active=true;weather_here.deck=1.0
anchor=WorldPoint()
if let at=env("POLISH_AT"):
    parts=at.split(" ");anchor=WorldPoint(to_float(parts[0])??0.0,0,to_float(parts[1])??0.0)
target=to_float(env("POLISH_TIME") ?? "12") ?? 12.0
if scenario=="landing": s=CraftState(position=vec3(0,k.float_height+0.4,0),velocity=vec3(0,-1.5,-k.stall_speed*3.3*1.15),fuel=k.fuel_capacity,water_age=1.0)
if scenario=="stall-in": s=CraftState(position=vec3(0,k.float_height+2.0,0),velocity=vec3(0,-14,-18),fuel=k.fuel_capacity,water_age=1.0)
if scenario=="skim": s=CraftState(position=vec3(0,k.float_height+1.5,0),velocity=vec3(0,0,-190),throttle=0.7,fuel=k.fuel_capacity,water_age=1.0)
if scenario=="turn" or scenario=="night": s=CraftState(position=vec3(0,60,0),velocity=vec3(0,0,-230),throttle=0.85,fuel=k.fuel_capacity,water_age=1.0)
s.precise=world_offset(anchor,s.position);s.position=world_vec(s.precise);s.published=s.position;s.precise_ready=true
f=Flyer(kind,0,k,s,cam_pos=s.position)
particles=WorldParticles(gravity=vec3(0,-9.8,0),drag=1.5,billowing=true)
trails=[Trail(),Trail()];wakes=[WakeTrail()]
sequence=env("POLISH_SEQUENCE")
advance=():
    global f,particles,trails,wakes,splash_motion
    c=Controls(throttle=1.0,pitch=if water_run_speed(k,f.state)>k.stall_speed*1.0: 0.25 else: 0.0)
    if scenario=="landing" or scenario=="stall-in": c=Controls(throttle=0.0,assist=0.0)
    if scenario=="turn": c=Controls(throttle=0.85,pitch=0.7,roll=0.65,assist=0.0)
    if scenario=="night": c=Controls(throttle=0.85)
    if scenario=="skim": c=Controls(throttle=0.7,pitch=0.06)
    t=f.state.time
    e=FlightEnv(has_swell=true,swell=(x:f64,z:f64)->vec3:swell_at(x,z,t))
    step(k,f.state,c,e,1.0/120.0)
    f.sea_t=f.state.time;f.prop_angle+=1.0/120.0*prop_rotation_speed(f.state,f.feedback.speed)
    feel(f,1.0/120.0,e.wind)
    spray(f,models,particles,1.0/120.0);particles.update(1.0/120.0)
    loop ev in f.state.damage.events:
        hard=clamp(log(1.0+ev.strength/2000.0)/6.0,0.0,1.0)
        if hard>0.05: emit(particles,ev.position,int(6.0+60.0*hard),4.0+14.0*hard,rgba(0.96,0.98,1,0.9),1.4,0.6+0.8*hard,0.9,normalize(ev.normal+vec3(0,1,0)))
    step_splash_motion(splash_motion,splash_targets(f,model,craft_transform(f),true),craft_point(f.state),f.state.time)
    vapor(f,trails,18.0,f.sea_t)
    gap=f64(f.state.position.y)-k.float_height
    skim=if f.state.on_water or f.state.moored:0.0 else:(1.0-smoothstep(0.5,k.span*0.6,gap))*smoothstep(28.0,60.0,f64(length(f.state.velocity))/pure_k(k))
    under=craft_offset(f.state,vec3(-f.state.velocity.x*0.15,0.1-f.state.position.y,-f.state.velocity.z*0.15))
    wake_step(wakes[0],under,f.state.velocity,f.state.on_water and not f.state.moored,1.6,f.state.time,skim)
    if skim>0.1:emit(particles,under,int(1.0+skim*4.0),3.0+6.0*skim,rgba(0.96,0.98,1,f32(0.5+0.4*skim)),1.2,0.5+0.6*skim,0.7,normalize(vec3(-f.state.velocity.x,30,-f.state.velocity.z)))
    if int(f.state.time*120)%30==0:
        pitch=asin(clamp(f64(forward(f.state).y),-1.0,1.0))*180.0/PI
        print("{scenario},{f.state.time:.3},{water_run_speed(k,f.state):.3},{f.state.position.y:.3},{pitch:.3},{f.state.on_water},{f.state.planing},{f.feedback.water:.3},{f.feedback.slap:.3},{f.state.hull_damage:.4},{f.load:.3},{f.feedback.roll:.3},{f.feedback.roll_lead:.4},{f.feedback.buffet:.3}")
loop i in 0..int(target*120.0):advance()
update=(dt:f64):
    global target
    if sequence!=none:
        advance();advance();target=f.state.time
img=image(2,2)
loop y in 0..2:
    loop x in 0..2: img.set(x,y,vec4(1,0,0,1))
depth=texture(img,true);init_expanded_depth(depth)
sea=build_sea_mesh()

draw=():
    hour=if scenario=="night": 20.0 else: 16.5
    L=light_at(hour)
    clear(vec4(L.sky_horizon,1));hide_sky()
    # Fixed three-quarter observer follows translation only. Pitch/heave remain physical.
    offset=vec3(k.span*1.25,max(3.0,k.span*0.32),k.span*1.1)
    if scenario=="night":offset=vec3(k.span*0.7,1,-k.span*0.85)
    aim=vec3(0,-0.3,0)
    if scenario=="skim":offset=vec3(k.span*2.4,k.span*0.65,k.span*3.4);aim=vec3(0,-2,15)
    precise_camera(craft_offset(f.state,offset),aim-offset,48.0,0.1,18000.0)
    at=craft_transform(f)
    draw_custom(():
        clear_world_depth()
        draw_craft_parts(model,f.state.damage,quat_to_mat4(f.state.orientation),L,target,f.prop_angle,airframe(f),0.0,craft_point(f.state),prop_speed=prop_rotation_speed(f.state,f.feedback.speed))
        draw_debris(model,f.state.damage,L,target)
    )
    draw_custom(():draw_sea(sea,depth,L,target,wind_now),transparent=true)
    draw_custom(():prepare_cloud_transparency(),transparent=true)
    draw_custom(():draw_wakes(wakes,L,target),transparent=true)
    draw_custom(():draw_flight_effects(f,model,at,L,target),transparent=true)
    draw_custom(():draw_prop_discs(L),transparent=true)
    draw_splashes(f,model,at,particles,L,target)
    draw_custom(():draw_trails(trails,L,target),transparent=true)
    text("{scenario} / {CRAFT_NAMES[int(kind)]} / t={target:.2}s",vec2(24,20),24,WHITE)
    text("True water speed {water_run_speed(k,f.state):.1}m/s   height {f.state.position.y:.2}m   planing {f.state.planing}   damage {f.state.hull_damage:.2}",vec2(24,55),18,WHITE)

    if let directory=sequence:
        if frame_number()%2==0:save_png("{directory}/{frame_number()}.png",screenshot())
