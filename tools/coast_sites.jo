# Candidate cove and cliff viewpoints round the islands, for coast art captures (prints
# AEGEAN_VIEW strings). Headless: no window needed.
use '../src/world.jo'
use '../src/geography.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
struct Site:
    score: f64
    island: int
    coast: vec2
    out: vec2
    kind: str
cliffs: Site[]; coves: Site[]
loop k in 0..ISLANDS.len():
    loop b in 0..126:
        bearing = f64(b) * 0.05
        cp = coast_point(k, bearing)
        c = cp.0; o = cp.1
        inland = (d: f64) -> f64: height(f64(c.x - o.x * f32(d)), f64(c.y - o.y * f32(d)))
        rise = inland(45.0)
        # (a cliff: high ground close behind the waterline)
        if rise > 30.0: cliffs.push(Site(rise / 45.0, k, c, o, "cliff"))
        # (a cove: a wide shallow shelf offshore, land on both flanks, a low shore behind)
        shelf: f64 = 0.0
        loop s in 1..30:
            h = height(f64(c.x + o.x * f32(s * 8)), f64(c.y + o.y * f32(s * 8)))
            if h < -0.3 and h > -6.0: shelf += 8.0
        side = vec2(-o.y, o.x)
        flanks: f64 = 0.0
        loop sgn in [-1.0, 1.0]:
            loop s in 1..12:
                q = c + o * 120.0 + side * f32(sgn * f64(s) * 40.0)
                if height(f64(q.x), f64(q.y)) > 0.5: flanks += 1.0; break
        if shelf > 60.0 and flanks >= 2.0 and inland(30.0) < 12.0: coves.push(Site(shelf, k, c, o, "cove"))
cliffs.sort((s: Site) -> f64: s.score, descending = true)
coves.sort((s: Site) -> f64: s.score, descending = true)
view = (s: Site, back: f64, up: f64) -> str:
    eye = s.coast + s.out * f32(back)
    target = s.coast - s.out * f32(if s.kind == "cliff": 10.0 else: 0.0)
    ty = if s.kind == "cliff": height(f64(target.x), f64(target.y)) * 0.5 else: -2.0
    d = vec3(eye.x - target.x, f32(up - ty), eye.y - target.y)
    yaw = atan2(f64(d.x), f64(d.z)); pitch = -atan2(f64(d.y), f64(length(d.xz)))
    "{eye.x:.0} {up:.0} {eye.y:.0} {yaw:.3} {pitch:.3}"
shown: vec2[]
pick = (list: Site[], n: int, back: f64, up: f64):
    count = 0
    loop s in list:
        far = true
        loop p in shown:
            if length(p - s.coast) < 600.0: far = false
        if not far: continue
        shown.push(s.coast)
        print("{s.kind} {ISLANDS[s.island].name} score {s.score:.1} at {s.coast.x:.0} {s.coast.y:.0} view \"{view(s, back, up)} HOUR\"")
        count += 1
        if count >= n: break
pick(coves, 6, 140.0, 45.0)
pick(cliffs, 6, 220.0, 25.0)
# Mainland cliffs: a grid over the strait's coasts.
main: Site[]
loop gx in 0..330:
    loop gz in 0..260:
        p = vec2(f32(-247000.0 + f64(gx) * 1500.0), f32(-195000.0 + f64(gz) * 1500.0))
        if abs(p.x) < 12000.0 and abs(p.y) < 12000.0: continue
        h0 = height(f64(p.x), f64(p.y))
        if h0 > -1.0 or h0 < -6.0: continue
        loop a in 0..8:
            d = vec2(f32(cos(f64(a) * 0.785)), f32(sin(f64(a) * 0.785)))
            # (walk in to the waterline, then the land 45 m behind it)
            q = p; steps = 0
            loop height(f64(q.x), f64(q.y)) < 0.0 and steps < 60: q += d * 5.0; steps += 1
            if steps >= 60: continue
            rise = height(f64(q.x + d.x * 45.0), f64(q.y + d.y * 45.0))
            if rise > 25.0: main.push(Site(rise / 45.0, 0, q, -d, "cliff"))
main.sort((s: Site) -> f64: s.score, descending = true)
loop s in main[0..min(main.len(), 40)]:
    far = true
    loop p in shown:
        if length(p - s.coast) < 3000.0: far = false
    if far and shown.len() < 15:
        shown.push(s.coast)
        print("mainland {s.kind} score {s.score:.1} at {s.coast.x:.0} {s.coast.y:.0} view \"{view(s, 220.0, 25.0)} HOUR\"")
