# Audit every town in Aegean Skies for misplaced plants (on dock paths, quays,
# streets, squares, stairs, inside buildings/doorways, or in/over water).
# Usage:
#   sloppy --release tools/town_plants_audit.jo [OUT.txt] [ID,ID...|legacy|all] [nograss]
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/objects.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/settlement_access.jo'
use '../src/settlement_ports.jo'
use '../src/landing_access.jo'
use '../src/canal_geometry.jo'
use '../src/river_data.jo'
use '../src/town_plants_audit.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
init_legacy_covers(embed('../assets/terrain_lod.bin'))
geography_enabled = true
init_settlements()
packed = inflate(embed('../assets/living-routes.bin')); assert(packed != none)
catalog = from_text[FarRouteCatalog](str_from_bytes(packed!)); assert(catalog is FarRouteCatalog)
publish_access_roads(catalog.links)
towns = [loop st in SETTLEMENTS: build_town(st)]

out_path = if args().len() > 1: args()[1] else: ""
scope = if args().len() > 2: args()[2] else: "all"
check_grass = not (args().len() > 3 and args()[3] == "nograss")
if out_path == "views":
    ids = [loop part in split(scope, ","): to_int(part)!]
    loop id in ids:
        s = world_settlements[settlement_by_id[id]]
        dock_eye = vec3(0,0,0); dock_look = vec3(0,0,0); air_eye = vec3(0,0,0); air_look = vec3(0,0,0)
        if s.legacy >= 0:
            tw = towns[s.legacy]
            q = tw.quays[0]
            if tw.stairs.len() > 0:
                st = tw.stairs[0]
                a = st[0]; b = st[min(st.len() - 1, 5)]; top = st[st.len() - 1]
                dock_eye = vec3(q.b.x, f32(QUAY_TOP + 2.2), q.b.y)
                if f64(length(dock_eye.xz - a.xz)) > 45.0: dock_eye = mix(vec3(q.a.x, f32(QUAY_TOP + 2.2), q.a.y), vec3(q.b.x, f32(QUAY_TOP + 2.2), q.b.y), 0.5)
                dock_look = b + vec3(0, 2.0, 0)
                mid = (a + top) * 0.5
                air_look = mid
                air_eye = mid + vec3(tw.out.x * 55.0, 60.0, tw.out.y * 55.0)
            else:
                dock_eye = vec3(q.b.x, f32(QUAY_TOP + 2.2), q.b.y)
                dock_look = vec3(q.a.x, f32(QUAY_TOP + 2.5), q.a.y) - vec3(tw.out.x, 0, tw.out.y) * 20.0
                air_look = vec3(q.a.x, f32(QUAY_TOP), q.a.y)
                air_eye = air_look + vec3(tw.out.x * 65.0, 60.0, tw.out.y * 65.0)
        else if s.id == CANAL_CITY_ID:
            # Look along Neravessa's upstream canal promenade where river/woods invade the waterfront
            n0 = RIVER_NODES[CANAL_BEGIN + 3]; n1 = RIVER_NODES[CANAL_BEGIN + 6]
            dir = normalize(n1.xy - n0.xy); side = vec2(-dir.y, dir.x)
            p0 = n0.xy + side * f32(f64(n0.w) + 5.0)
            p1 = n1.xy + side * f32(f64(n1.w) + 5.0)
            dock_eye = vec3(p0.x, f32(f64(n0.z) + CANAL_STREET + 2.4), p0.y)
            dock_look = vec3(p1.x, f32(f64(n1.z) + CANAL_STREET + 2.0), p1.y)
            air_look = vec3(n1.x, f32(f64(n1.z) + CANAL_STREET), n1.y)
            air_eye = vec3(n0.x - dir.x * 40.0, f32(f64(n0.z) + CANAL_STREET + 60.0), n0.y - dir.y * 40.0)
        else if s.remote_harbor:
            landing = landing_access(s.id)
            root = landing.root; tip = landing.tip; rt = landing.route
            # Identify which end of route is nearest root
            r0 = rt[0]; r1 = rt[rt.len() - 1]
            near_start = f64(length(r0.xz - root.xz)) < f64(length(r1.xz - root.xz))
            up_idx = if near_start: min(rt.len() - 1, max(1, rt.len() / 3)) else: max(0, rt.len() - 1 - max(1, rt.len() / 3))
            mid_pt = rt[up_idx]
            dock_eye = mix(root, tip, 0.45) + vec3(0, 2.4, 0)
            dock_look = mid_pt + vec3(0, 2.0, 0)
            air_look = mix(root, mid_pt, 0.5)
            air_eye = root + vec3(landing.out.x * 55.0, 60.0, landing.out.y * 55.0)
        else:
            dock = s.harbor[0]
            p_eye = dock.quay_a + s.out * 52.0
            p_look = dock.quay_a - s.out * 18.0
            dock_eye = vec3(p_eye.x, f32(dock.deck + 2.4), p_eye.y)
            dock_look = vec3(p_look.x, f32(place_ground(p_look) + 2.2), p_look.y)
            air_look = vec3(dock.quay_a.x, f32(place_ground(dock.quay_a)), dock.quay_a.y)
            air_eye = air_look + vec3(s.out.x * 65.0, 60.0, s.out.y * 65.0)
        loop pair in [("dock", dock_eye, dock_look), ("aerial", air_eye, air_look)]:
            d = pair.2 - pair.1
            yaw = atan2(-f64(d.x), -f64(d.z)); pitch = atan2(f64(d.y), f64(length(d.xz)))
            print("{s.id}|{s.name}|{pair.0}|{pair.1.x:.2} {pair.1.y:.2} {pair.1.z:.2} {yaw:.4} {pitch:.4} 11")
    exit(0)
wanted: {int: bool} = {}
if scope != "all" and scope != "legacy":
    loop part in split(scope, ","): wanted[to_int(part)!] = true

started = time()
by_kind: {str: int} = {}
by_zone: {str: int} = {}
total = 0

struct TownSummary:
    id: int
    name: str
    kind: str
    harbor: bool
    remote: bool
    total: int
    dock: int
    street: int
    building: int
    water: int
    kinds: {str: int}
    samples: PlantFinding[]

summaries: TownSummary[]

loop s in world_settlements:
    if scope == "legacy" and s.legacy < 0: continue
    if scope != "all" and scope != "legacy" and not (s.id in wanted): continue
    findings = audit_town_plants(towns, s, check_grass)
    dock = 0; street = 0; building = 0; water = 0
    tk: {str: int} = {}
    samples: PlantFinding[]
    loop f in findings:
        total += 1
        by_kind[f.kind] = by_kind.get(f.kind, 0) + 1
        by_zone[f.zone] = by_zone.get(f.zone, 0) + 1
        tk[f.kind] = tk.get(f.kind, 0) + 1
        if f.zone == "dock_path": dock += 1
        else if f.zone == "street_square": street += 1
        else if f.zone == "building_door": building += 1
        else: water += 1
        if samples.len() < 5: samples.push(f)
    summaries.push(TownSummary(s.id, s.name, "{s.kind}", s.harbor.len() > 0, s.remote_harbor, findings.len(), dock, street, building, water, tk, samples))

elapsed = time() - started
affected = 0; affected_dock = 0
loop ts in summaries:
    if ts.total > 0: affected += 1
    if ts.dock > 0: affected_dock += 1

report = "# Town Plants Audit ({summaries.len()} towns, {elapsed:.1f} s, grass={check_grass})\n"
report += "TOTAL findings: {total} across {affected}/{summaries.len()} towns ({affected_dock} towns with dock_path issues)\n\n"
report += "## By Zone\n"
zkeys = by_zone.keys(); zkeys.sort()
loop zk in zkeys: report += "- {zk}: {by_zone[zk]}\n"
report += "\n## By Plant Kind\n"
kkeys = by_kind.keys(); kkeys.sort()
loop kk in kkeys: report += "- {kk}: {by_kind[kk]}\n"

# Sort worst dock-path towns first
by_dock = summaries
by_dock.sort((a: TownSummary): (-a.dock, -a.total, a.id))
report += "\n## Top 20 Worst Towns (by dock_path findings)\n"
loop i in 0..min(20, by_dock.len()):
    ts = by_dock[i]
    if ts.dock == 0: break
    kstr = ""
    ks = ts.kinds.keys(); ks.sort()
    loop k in ks: kstr += "{k}={ts.kinds[k]} "
    report += "{i+1}. {ts.name} (id={ts.id}, {ts.kind}, remote={ts.remote}): dock={ts.dock} street={ts.street} bldg={ts.building} water={ts.water} total={ts.total} | {kstr}\n"
    loop sf in ts.samples:
        report += "     - [{sf.zone}] {sf.kind} at ({sf.at.x:.1f}, {sf.at.y:.1f}, {sf.at.z:.1f}): {sf.detail}\n"

# Sort worst overall towns
by_all = summaries
by_all.sort((a: TownSummary): (-a.total, -a.dock, a.id))
report += "\n## Top 25 Worst Towns (by total findings)\n"
loop i in 0..min(25, by_all.len()):
    ts = by_all[i]
    if ts.total == 0: break
    kstr = ""
    ks = ts.kinds.keys(); ks.sort()
    loop k in ks: kstr += "{k}={ts.kinds[k]} "
    report += "{i+1}. {ts.name} (id={ts.id}, {ts.kind}, harbor={ts.harbor}, remote={ts.remote}): total={ts.total} (dock={ts.dock} street={ts.street} bldg={ts.building} water={ts.water}) | {kstr}\n"
    loop sf in ts.samples:
        report += "     - [{sf.zone}] {sf.kind} at ({sf.at.x:.1f}, {sf.at.y:.1f}, {sf.at.z:.1f}): {sf.detail}\n"

# Full table of all towns with findings
report += "\n## All Affected Towns ({affected})\n"
loop ts in by_all:
    if ts.total == 0: break
    kstr = ""
    ks = ts.kinds.keys(); ks.sort()
    loop k in ks: kstr += "{k}={ts.kinds[k]} "
    report += "{ts.id}|{ts.name}|{ts.kind}|harbor={ts.harbor}|remote={ts.remote}|total={ts.total}|dock={ts.dock}|street={ts.street}|bldg={ts.building}|water={ts.water}|{kstr}\n"

print(report[0..min(report.len(), 6000)])
if out_path != "":
    assert(write_file(out_path, report))
    print("Wrote full report -> {out_path}")
