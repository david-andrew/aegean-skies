# Offline listening files; never calls play/sound_stream or opens a window.
# MUSIC_SAMPLE_DIR=/absolute/scratch SLOPPY_THREADS=1 SLOPPY_NO_AUDIO=1 sloppy --release tools/musiclab.jo
use '../src/radio_synth.jo'
use '../src/music_synth.jo'
use '../src/music_data.jo'

dir = env("MUSIC_SAMPLE_DIR") ?? ""
assert(dir != "")
names = ["01-mahler-adagietto","02-mahler-opening","03-magnetic-foxtrot","04-el-choclo-tango","05-gladiators-march","06-ikariotikos","07-bethena-waltz"]
loop piece in 0..MUSIC_PIECES.len():
    loop mode in 0..2:
        s = make_radio_synth()
        radio_synth_program(s,.morse,0,0)
        s.style = .classical; s.strength = 1
        radio_music_program(s,piece,0)
        seconds = min(60.0,f64(MUSIC_PIECES[piece].frames)/f64(MUSIC_RATE))
        samples: f32[]
        energy = 0.0; peak = 0.0
        loop samples.len() < int(seconds*f64(MUSIC_RATE)):
            values = radio_render(s,min(RADIO_BLOCK,int(seconds*f64(MUSIC_RATE))-samples.len()),1,0,mode == 0)
            loop v in values:
                energy += f64(v)*f64(v); peak = max(peak,abs(f64(v)))
            samples += values
        stereo = fill(f32(0),samples.len()*6)
        loop i in 0..samples.len()*3:
            at = i/3; blend = f32(i%3)/3.0
            v = samples[at]*(1.0-blend)+samples[min(at+1,samples.len()-1)]*blend
            stereo[i*2] = v; stereo[i*2+1] = v
        label = if mode == 0: "dry" else: "radio"
        assert(save_wav(dir+"/"+names[piece]+"-"+label+".wav",Sound(stereo)))
        print("{names[piece]} {label}: {seconds:.2}s peak={peak:.5} rms={sqrt(energy/f64(samples.len())):.5} stolen={s.music.stolen}")
