# Headless physics trace. FLIGHT_KIND=0..3, FLIGHT_SCENARIO=trip|takeoff|cruise|landing|stall|ridge|taxi|wind.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 sloppy tools/flightlab.jo
import '../src/flight.jo' as fl
import '../src/planes.jo' as planes

make_spec = (kind: planes.Craft) -> fl.CraftSpec:
    model = planes.build_craft(kind, planes.LIVERIES[0])
    fl.craft_spec(kind, model.contacts)

main = ():
    kind = planes.Craft(clamp(to_int(env("FLIGHT_KIND") ?? "0") ?? 0, 0, 3))
    scenario = env("FLIGHT_SCENARIO") ?? "trip"
    k = make_spec(kind)
    e = fl.FlightEnv()
    s = fl.water_start(k, vec3(0, 0, 0))
    plan = fl.FlightPlan()
    if scenario == "ridge":
        e.ground = (x: f64, z: f64) -> f64: max(-100.0, 300.0 - abs(z + 2200.0) * 0.5)
    if scenario == "cruise" or scenario == "stall":
        s.position.y = 600; s.on_water = false
        s.velocity = vec3(0, 0, -k.cruise_speed)
        s.throttle = fl.cruise_throttle(k, k.cruise_speed)
    if scenario == "landing":
        s.position.y = f32(k.float_height + 3); s.on_water = false; s.water_age = 1
        s.velocity = vec3(0, -1.5, -k.stall_speed * 1.15)
        s.orientation = quat_euler(0.08, 0, 0)
    if scenario == "wind": e.wind = vec3(8, 0, 0)
    dt = 1.0 / 60.0
    n = int((to_float(env("FLIGHT_SECONDS") ?? "420") ?? 420.0) / dt)
    loop i in 0..n:
        c = fl.Controls()
        if scenario == "trip" or scenario == "ridge": c = fl.autopilot(k, s, plan, e)
        else if scenario == "cruise": c.throttle = fl.cruise_throttle(k, k.cruise_speed)
        else if scenario == "takeoff":
            c = fl.autopilot(k, s, plan, e)
        else if scenario == "taxi": c.throttle = 0.17; c.yaw = 0.6
        else if scenario == "landing": c.assist = 0; c.water_brake = 0.4
        else if scenario == "stall":
            c.throttle = if i > 60 * 70: 1.0 else: 0.0
        fl.step(k, s, c, e, dt)
        if i % 120 == 0:
            print("t={s.time:.1} v={s.airspeed:.2} y={s.position.y:.2} vz={s.velocity.y:.2} xz=({s.position.x:.1},{s.position.z:.1}) pitch={asin(fl.forward(s).y):.3} aoa={s.aoa:.3} throttle={s.throttle:.2} phase={plan.phase} wet={s.on_water} damage={s.hull_damage:.2} bank={atan2(-quat_rotate(s.orientation, vec3(1, 0, 0)).y, quat_rotate(s.orientation, vec3(0, 1, 0)).y):.2}")
        if scenario == "takeoff" and not s.on_water and s.position.y > k.float_height + 3:
            print("takeoff {kind}: t={s.time:.2}s distance={length(s.position.xz):.1}m speed={s.airspeed:.2}m/s")
            break
        if s.crashed or plan.phase == .done or plan.phase == .failed:
            print("end t={s.time:.2} phase={plan.phase} crash={s.crashed} damage={s.hull_damage:.2} landing={plan.touchdown} pos={s.position}")
            break
