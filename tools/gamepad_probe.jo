# The game with a scripted controller (SLOPPY_INPUT's pad items), telling what it did: every tenth
# frame a PROBE line with the title's page and focus, the pause menu's page, the Controls page's
# Invert Y, the device in use (a flight stick or not, its name, its throttle lever) and the player's
# aircraft (on the water, its height). tests/gamepad_play_test.py runs it and reads the lines.
build:
    name = "Aegean gamepad probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/controller.jo'
use '../src/settlements.jo'

finish_settlement_registry()
base_update: (f64) -> void = game.update
base_draw: () -> void = game.draw

update = (dt: f64):
    base_update(dt)
    f = frame_number()
    if f % 10 == 0:
        st = game.pc.state
        print("PROBE f={f} title={game.title.open} tpage={game.title.page} tfocus={game.title.focus} paused={game.paused} page={game.dbg.page} invert={game.dbg.opts.controls.pad.axes[AX_PITCH].invert} sinvert={game.dbg.opts.controls.stick.axes[AX_PITCH].invert} stick={ctl.stick} dev={device_name(ctl.active)} lever={ctl.lever:.2} throttle={game.pc.throttle:.2} water={st.on_water} y={st.position.y:.1}")

draw = (): base_draw()
