# Walk up an island landing's path in the full game and frame it, for checking
# the walking contact on a cliff stair or stepped path. Dev-only.
#   CLIMB_ID=id CLIMB_VIEW=air|foot|mid [CLIMB_AT=0..1] SLOPPY_FRAMES=n SLOPPY_SCREENSHOT=out.png
# air: the landing and its stair from offshore; foot: walking off the pier onto
# the stair; mid: walking up from CLIMB_AT of the way along the stair.
import '../aegean.jo' as game
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/landing_access.jo'
use '../src/objects.jo'
use '../src/world_point.jo'
use 'judge_scene.jo'
finish_settlement_registry()
climb_id=to_int(env("CLIMB_ID") ?? "0") ?? 0
climb_view=env("CLIMB_VIEW") ?? "air"
climb_at=to_float(env("CLIMB_AT") ?? "0.4") ?? 0.4
assert(climb_id in settlement_by_id)
climb_s=world_settlements[settlement_by_id[climb_id]]
climb_landing=landing_access(climb_id)
climb_up=climb_landing.route;climb_up.reverse()
# The stair (or, for a plain stepped path, the whole path) from the root upward.
climb_stair=if climb_landing.stair_from>=0:climb_up[..climb_up.len()-climb_landing.stair_from] else:climb_up
climb_out=vec3(climb_landing.out.x,0,climb_landing.out.y)
climb_port=settlement_port(climb_s)
# A plain stepped path can run for kilometres: frame its first stretch from the jetty.
climb_shown=if climb_landing.stair_from>=0:climb_stair else:climb_stair[..min(climb_stair.len(),6)]
climb_mid=climb_shown[climb_shown.len()/2]
climb_waypoint=0
if climb_view=="air":
    reach=max(160.0,f64(length(climb_shown[climb_shown.len()-1].xz-climb_shown[0].xz))*0.9)
    eye=climb_mid+climb_out*f32(reach)+vec3(-climb_out.z,0,climb_out.x)*f32(reach*0.45)+vec3(0,f32(reach*0.45),0)
    game.judge_camera=JudgeView(eye,climb_mid,"{climb_s.name} landing and stair from offshore")
start=if climb_view=="mid":climb_stair[min(climb_stair.len()-2,int(f64(climb_stair.len())*climb_at))] else:climb_port.quays[0].b
climb_waypoint=if climb_view=="mid":min(climb_stair.len()-1,int(f64(climb_stair.len())*climb_at)+1) else:0
game.me.mode=.walking
game.me.pos=vec3(start.x,f32(walk_height(game.towns,f64(start.x),f64(start.z))),start.z)
game.judge_ready=true
print("CLIMB {climb_s.name} {climb_id} view={climb_view} start={game.me.pos} stair_points={climb_stair.len()} top={climb_stair[climb_stair.len()-1]}")
climb_path:vec3[]=if climb_view=="mid":climb_up[climb_waypoint..] else:[climb_port.quays[0].a]+climb_up
climb_waypoint=0
capture_update:(f64)->void=game.update
capture_draw:()->void=game.draw
update=(dt:f64):
    capture_update(dt)
    frame=frame_number()
    if climb_view=="air" or frame<30 or climb_waypoint>=climb_path.len():return
    goal=climb_path[climb_waypoint];here=game.me.pos
    d=goal.xz-here.xz
    if length(d)<0.3:climb_waypoint+=1;return
    move=normalize(d)*f32(min(f64(length(d)),0.12))
    before=game.me.pos
    game.me.yaw=atan2(f64(move.x),f64(move.y))
    game.me.stride=1;game.me.phase+=dt*8
    game.step_player_walk(move)
    if length(game.me.pos.xz-before.xz)<0.02:print("CLIMB_STUCK frame={frame} at={game.me.pos} goal={goal}")
    # Follow from behind and below on the seaward side, looking up the way.
    back=normalize(vec3(move.x,0,move.y))
    eye=game.me.pos-back*7.0+climb_out*4.0+vec3(0,3.0,0)
    game.judge_camera=JudgeView(eye,game.me.pos+back*4.0+vec3(0,1.6,0),"{climb_s.name} walking up the landing path")
    if frame%30==0:print("CLIMB_STEP frame={frame} pos={game.me.pos} waypoint={climb_waypoint}/{climb_path.len()}")
draw=():
    capture_draw()
