# Re-plan every installed landing cliff stair from its own jetty root, in its own
# direction, with longer flights and roomier landings (FLIGHT m of run, REST m
# flat): about 18 m of rise between landings. The path above the stair is kept;
# the new stair must pass cliff_stair_clear and join that path with full walking
# contact, else the old stair stays. Rewrites src/shore_access_data.jo.
# Usage: replan_cliff_stairs.jo [FLIGHT [REST [ID,ID...]]]; FLIGHT 0 tries 30, 26, 34 and 24 m.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_path_bake.jo'
use '../src/shore_access_data.jo'
use '../src/landing_access_types.jo'
use '../src/landing_stairs.jo'
use '../src/stairways.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
flights=if args().len()>1 and args()[1]!="0":[f64(to_int(args()[1])!)] else:[30.0,26.0,34.0,24.0]
only=if args().len()>3:[loop part in split(args()[3],","):to_int(part)!] else:[]
rest=if args().len()>2:f64(to_int(args()[2])!) else:4.0
ground=(x:f64,z:f64)->f64:place_ground(vec2(f32(x),f32(z)))
width=f64(LANDING_STEP_WIDTH)
items=SHORE_LANDINGS
ids=items.keys();ids.sort()
loop id in ids:
    landing=items[id]
    if landing.stair_from<0 or only.len()>0 and not only.contains(id):continue
    up=landing.route[landing.stair_from..];up.reverse()
    foot=up[0];old_top=up[up.len()-1]
    side=vec2(-landing.out.y,landing.out.x)
    along=if dot(old_top.xz-foot.xz,side)>0.0:side else: -side
    done=false
    loop attempt in 0..flights.len()*4:
        if done:break
        flight=flights[attempt/4];lift=[-1.0,1.0,3.0,6.0][attempt%4]
        stair=plan_cliff_stair(ground,foot,f64(old_top.y)+lift,along,-landing.out,flight,900.0,width*0.5-0.2,rest)
        if stair.len()<2:eprint("  {id} flight {flight} lift {lift}: the face runs out");continue
        fault=cliff_stair_fault(stair,width)
        if fault!="":eprint("  {id} flight {flight} lift {lift}: {fault}");continue
        top=stair[stair.len()-1]
        loop j in [landing.stair_from-1,landing.stair_from-2,landing.stair_from-3,landing.stair_from-4]:
            if done or j<0:continue
            if not access_segment_clear(landing.route[j],top,true,true):continue
            route=landing.route[..j+1]
            loop k in 0..stair.len():route.push(stair[stair.len()-1-k])
            next=landing;next.route=route;next.stair_from=j+1
            items[id]=next;done=true
            flats=0
            loop k in 1..stair.len():
                if abs(stair[k].y-stair[k-1].y)<0.05:flats+=1
            print("REPLANNED {id} flight {flight}: {stair.len()} stair points ({flats} landings), top {top.y:.1f} (was {old_top.y:.1f}), joins path point {j}")
    if not done:print("KEPT {id}: no re-planned stair passed")
source="# Offline surveyed island landings.\nuse 'landing_access_types.jo'\nSHORE_LANDINGS:{{int:LandingAccess}}={{\n"
loop key in ids:source+="    {key}:{replace(to_text(items[key]),", stair_from=-1)",")")},\n"
source+="}\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/shore_access_data.jo'),source))
