# Registry-only site inventory; intentionally independent of the route catalogue
# so a relocation can be audited before its one final route bake.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_purpose.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
loop s in world_settlements:
    purpose=settlement_purpose(s)
    print("SITE|{s.id}|{s.name}|{s.kind}|{s.size}|{s.country}|{s.region}|{s.center}|{s.out}|{s.radius}|{s.seed}|{s.harbor.len()}|{purpose.output}|{purpose.reason}")
