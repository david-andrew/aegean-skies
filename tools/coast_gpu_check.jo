# Actual GPU readback: bound hardware linear-filter error against CPU contact.
# No window or audio; run headlessly with the native backend (not software).
use '../src/coast_pattern.jo'
use '../src/coast_field.jo'
use '../src/coast_mesh.jo'

struct ProbeVertex:
    pos: vec2
struct ProbeOut:
    pos: vec4
struct ProbeParams:
    pattern: Texture

probe_fraction = (k: int) -> vec2:
    vec2((f32(k%31)+0.31)/31.0,(f32(k%29)+0.73)/29.0)
probe_origin = (k: int) -> vec2:
    if k < 512: vec2(-5012.125,-2436.25) else: vec2(219996,-120008)
probe_vs = (v: ProbeVertex,u: ProbeParams) -> ProbeOut: ProbeOut(vec4(v.pos,0,1))
probe_fs = (i: ProbeOut,u: ProbeParams) -> vec4:
    k = int(floor(i.pos.x))
    h = if k < 4: f32(k)*10.0 else: coast_gpu_vertex(vec4(-24,120,-4,165),probe_fraction(k),probe_origin(k),u.pattern)
    packed = int(round((h+64.0)*4096.0))
    vec4(f32(packed & 255),f32((packed>>8)&255),f32((packed>>16)&255),255)/255.0

window("Coast GPU check",32,32)
assert(not __soft)
init_coast_mesh()
program = make_shader(shader(probe_vs,probe_fs))
tri = mesh([ProbeVertex(vec2(-1,-1)),ProbeVertex(vec2(3,-1)),ProbeVertex(vec2(-1,3))])
target = render_target(1024,1,false)
draw_to(target)
clear(BLACK)
draw(program,tri,ProbeParams(coast_pattern_texture))
img = screenshot()
draw_to_screen()
worst = 0.0
loop k in 0..1024:
    expected = if k < 4: f32(k)*10.0 else: coast_vertex_height(vec4(-24,120,-4,165),probe_fraction(k),probe_origin(k))
    a = k*4
    actual = f64(int(img.pixels[a])+int(img.pixels[a+1])*256+int(img.pixels[a+2])*65536)/4096.0-64.0
    if k < 4: assert(abs(actual-f64(expected)) < 0.0002)
    worst = max(worst,abs(actual-f64(expected)))
print("GPU/CPU coast height maximum {worst} m, 1024 probes including steep cliffs and country coordinates")
assert(worst < 0.025)
free_render_target(target)

# Web pages enter the frame loop after the one-shot readback. Supply empty
# callbacks there; native probes have finished and can close immediately.
update=(dt:f64):pass
draw=():pass
when TARGET!="wasm":quit()
