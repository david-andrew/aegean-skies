# Install one surveyed road without renumbering or removing existing services.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/access_path_bake.jo'
use '../src/inland_connections_data.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
id=to_int(args()[1])!;a=world_settlements[settlement_by_id[id]];b=world_settlements[settlement_by_id[id-1]]
assert(b.harbor.len()>0)
source=read_file(args()[2]);assert(source is str)
path=from_text[vec3[]](source);assert(path is vec3[] and path.len()>1)
assert(length(path[0]-a.center)<0.01 and length(path[path.len()-1]-b.center)<0.01)
meters=0
loop k in 1..path.len():
    assert(access_segment_clear(path[k-1],path[k],true))
    meters+=int(round(f64(length(path[k]-path[k-1]))*1000))
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
loop l in catalog.links:assert(not (l.mode==.cart and ((l.a==a.id and l.b==b.id) or (l.a==b.id and l.b==a.id))))
catalog.links.push(FarLink(catalog.links.len(),a.id,b.id,.cart,path,meters,trail=true))
connections=ACCESS_CONNECTIONS;connections.push(AccessConnection(a.id,b.id,path))
output="# Offline validated access connections.\nstruct AccessConnection:\n    a:int\n    b:int\n    points:vec3[]\nACCESS_CONNECTIONS:AccessConnection[]=[\n"
loop item in connections:
    output+="    AccessConnection({item.a},{item.b},["
    loop p in item.points:output+="vec3({p.x},{p.y},{p.z}),"
    output+=" ]),\n"
output+="]\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/inland_connections_data.jo'),output))
assert(write_bytes(join_path(dir_name(args()[0]),'../assets/living-routes.bin'),deflate(bytes(to_text(catalog)))))
print("INSTALLED {a.name}/{b.name}: {meters} mm, {catalog.links.len()} links; old links preserved")
