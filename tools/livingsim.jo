# Headless digest. LIVING_BENCH=1 measures only on the designated i5-8350U laptop.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_money.jo'
use '../src/living_text.jo'
use '../src/living_content.jo'
use '../src/living_news.jo'
use '../src/living_jobs.jo'
use '../src/living_checks.jo'

const REFERENCE_TICK_US = 83.69 # Release, 30 days seed42 on redfox i5-8350U, 2026-11-10.
argv = args()
days = max(0,if argv.len() > 1: to_int(argv[1]) ?? 1 else: 1)
seed = if argv.len() > 2: to_int(argv[2]) ?? 0 else: 0
w = build_world(u64(seed))
print("Aegean Skies, seed {seed}, {days} days from 09:30")
measure = env("LIVING_BENCH") == "1" and "i5-8350U" in (read_file("/proc/cpuinfo") ?? "")
total_ns = 0; maximum_ns = 0
loop minute in 0..days*1440:
    begin = if measure: time_ns() else: 0
    advance_minutes(w,1)
    if measure:
        cost = time_ns()-begin
        total_ns += cost; maximum_ns = max(maximum_ns,cost)
loop _, t in w.trips:
    if t.mode == .aircraft: print("Trip{t.id} {t.state}: {say_reason(w,t.reason)}")
loop id in 0..6:
    print("{PLACE_NAMES[id]} quotes (centesimi/package): {w.places[id].market.price_cents}")
    loop line in board_lines(w,id): print("  {line}")
    loop line in news_lines(w,id): print("  News: {line}")
loop _, o in w.obligations:
    if o.amount_cents > 0 and (o.kind == .debt or o.kind == .rent): print("{person_name(w,o.debtor)} owes {person_name(w,o.creditor)} {o.amount_cents}c ({o.state}); retry {o.next_retry_minute}")
print("Pirates: {w.raid_departures} sorties, {w.next_encounter} encounters; authority: {w.patrol_departures} patrol departures, bounty {w.factions[0].bounty_cents}c.")
print("Books: opening {w.ledger.opening_cents}c, outside in {w.ledger.external_in_cents}c, outside out {w.ledger.external_out_cents}c; emergency subsidies {w.emergency_subsidies}.")
errors = invariant_errors(w)
print("Invariant checks: {if errors.len() == 0: "PASS" else: "FAIL"} {errors}")
if measure and days > 0:
    print("Measured tick cost on redfox i5-8350U: {f64(total_ns)/f64(days*1440)/1000.0:.2} us/minute mean, {f64(maximum_ns)/1000.0:.2} us max (release; timing includes clock-read overhead).")
else:
    print("Reference release tick cost: {REFERENCE_TICK_US:.2} us/game minute mean on redfox i5-8350U; set LIVING_BENCH=1 there to measure this run.")
assert(errors.len() == 0)
