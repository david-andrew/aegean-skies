# Read an actual saved world without advancing it or fabricating evidence/forces.
build:
    name = "worldlog"

use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_save.jo'
use '../src/living_war.jo'

source=env("WORLD_SOURCE") ?? "phase4-month-v11"
saved=load_game(42,source)
assert(saved is SaveGame,"No valid saved world under the requested source prefix")
w=saved.world
print("WAR_AUDIT source={source} minute={w.minute} forces={w.war.units.len()} contacts={w.war.next_contact} evidence={w.war.evidence.len()}")
loop c in w.countries:
    at=if c.capital_id>=0: c.capital_id else: c.seat
    if not (at in w.far.districts): continue
    print("COUNCIL country={c.id} place={at} treasury={w.accounts[w.far.treasury[c.id]].cents} accounts={[loop r in w.far.districts[at].reports: (r.kind,r.origin,r.aggressor,r.affected,r.weight,r.occurred_minute)]}")
loop _, e in w.war.evidence:
    print("INCIDENT id={e.news} place={e.place} aggressor={e.aggressor} affected={e.affected} minute={e.minute} received={[loop key,_ in w.war.heard: if key=="{e.affected}:{e.news}": key]}")
loop u in w.war.units:
    if u.vehicle<0: continue
    v=w.far.vehicles[u.vehicle]
    route=if v.journey>=0: w.far.journeys[v.journey].destination else: v.place
    print("FORCE id={u.id} country={u.country} mode={v.kind} home={u.home} place={v.place} destination={route} retired={u.retired} charter={u.charter_until} ready_until={u.supplied_until} hull={v.hull} crew={v.crew} grain={v.provisions.qty[3]} hungry_days={v.hungry_days} parts={u.stock.qty[5]} ammo={u.stock.qty[8]} orders={u.order} known={u.known_wars}")
