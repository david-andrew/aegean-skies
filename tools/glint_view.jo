# The sun's or the moon's glitter on open water, for judging the glints' shape and the glitter path.
# GLINT_ELEV: the light's height above the horizon (degrees, straight ahead); GLINT_MOON=1: the moon
# at night instead of the sun; GLINT_EYE: the eye's height (m); GLINT_PITCH: the look (degrees,
# down negative); GLINT_T: the sea's time (s); SEA_WIND: the wind (m/s).
use '../src/sea.jo'
use '../src/look.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'
window("Glints",1280,720)
enable_world_depth()
init_sea()
water=build_sea_mesh()
img=image(1,1)
img.set(0,0,vec4(1,0,0,1))
depth=texture(img)
expanded_depth=depth;nearby_depth=depth
elev=(to_float(env("GLINT_ELEV")??"12")??12.0)*PI/180.0
moon=env("GLINT_MOON")=="1"
eye=to_float(env("GLINT_EYE")??"50")??50.0
pitch=(to_float(env("GLINT_PITCH")??"-8")??-8.0)*PI/180.0
t=to_float(env("GLINT_T")??"123.5")??123.5
speed=to_float(env("SEA_WIND")??"6")??6.0
wind=Wind(vec2(0.8,0.6),speed,vec2(0,0))
toward=vec3(0,f32(sin(elev)),f32(-cos(elev)))
L=light_at(if moon: 23.5 else: 12.0)
if moon: L.moon_dir=toward
else: L.sun_dir=toward
draw=():
    clear(BLACK);hide_sky()
    render_camera(vec3(0,f32(eye),0),vec3(0,f32(sin(pitch)),f32(-cos(pitch))),62,0.1,300000)
    draw_custom(():
        clear_world_depth()
        draw_sea(water,depth,L,t,wind)
    )
