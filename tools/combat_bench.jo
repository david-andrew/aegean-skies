# Wall time: run only on the quiet laptop under its bench.lock.
import '../tests/combat_scale_test.jo' as fixture
use '../src/combat.jo'
use '../src/flight.jo'
base=fixture.scale_battle()
loop indexed in [false,true]:
    start=time();pairs=0
    loop i in 0..500:
        b=base;step_combat_rounds(b,FlightEnv(),indexed);pairs+=b.pair_tests
    print("round_grid={indexed} mean_ms={(time()-start)*2.0:.4} pairs={pairs/500}")
