import '../tests/scenarios_test.jo' as fixture
use '../src/flight.jo'
use '../src/planes.jo'
use '../src/pilot.jo'
use '../src/combat.jo'
use '../src/combat_view.jo'
use '../src/combat_trails.jo'
use '../src/traffic.jo'
use '../src/scenarios.jo'
use '../src/frame_budget.jo'
use '../src/weather_scene.jo'
use '../src/world.jo'
use '../src/quality.jo'
use '../src/tweaks.jo'
import '../src/living_scene.jo' as scene

s=fixture.scenario_fixture(to_int(env("SOAK_SIDE") ?? "8") ?? 8);w=s.world;f=s.flyer;b=s.battle
set_tweaks(Tweaks(chaotic_stalls=(env("SOAK_TRIAL") ?? "0")=="1"))
models=build_craft_models();traffic=make_living_traffic(w,models)
adapter=scene.SceneAdapter();bind_living_player(f,w,adapter)
v=CombatView();clock=0.0;frames=0;max_ticks=0;max_rounds=0;max_trails=0;max_events=0;max_look=0.0
trace_time=0.0
timed=env("SOAK_TIMING")!=none
sample_start=if timed:time() else:0.0
sample_frames=0;worst=0.0;traffic_ms=0.0;commit_ms=0.0;view_ms=0.0;max_pairs=0;max_brains=0
limit=to_float(env("SOAK_SECONDS") ?? "600") ?? 600.0
loop clock<limit:
    frame_start=if timed:time() else:0.0
    raw=if frames%71==0: 0.5 else: if frames%17==0:0.25 else:1.0/60.0
    dt=frame_dt(raw);clock+=dt;frames+=1
    weather_scene_step(w,f.state.position,9.5,dt)
    # A repeatable human control stream circles the engagement, never grants combat ownership.
    target=STRAIT_CENTER+vec3(sin(clock*0.045)*1400,200,cos(clock*0.045)*1400)
    c=steer(f.spec,f.state,target-f.state.position);c.throttle=0.8
    pi=combat_index(b,w.people[w.player].craft)
    if not b.actors[pi].bailed:step(f.spec,f.state,c,flight_env(clock,f.state.position),dt)
    else:f.state=b.actors[pi].state
    feel(f,dt);chase(f,dt)
    phase_start=if timed:time() else:0.0
    update_traffic(traffic,w,adapter,f.state.position,clock,dt,f.state,[],b,
        (events:CombatEvent[]):combat_effect_events(v,events,w.people[w.player].craft))
    if timed:traffic_ms+=(time()-phase_start)*1000.0;phase_start=time()
    commit_scenario_aircraft(w,b)
    if timed:commit_ms+=(time()-phase_start)*1000.0;phase_start=time()
    pi=combat_index(b,w.people[w.player].craft)
    f.state.damage=b.actors[pi].state.damage;refresh_damage(f.spec,f.state)
    update_combat_view(v,b,vec3(0,0,0),dt,f.state.position)
    if timed:view_ms+=(time()-phase_start)*1000.0
    max_pairs=max(max_pairs,b.pair_tests);max_brains=max(max_brains,b.brain_steps)
    max_ticks=max(max_ticks,adapter.frame_ticks);max_rounds=max(max_rounds,b.rounds.len());max_trails=max(max_trails,v.trails.ribbons.len());max_events=max(max_events,b.events.len());max_look=max(max_look,f64(length(f.look_v)))
    assert(adapter.frame_ticks<=FRAME_TICKS and b.actors.len()<=COMBAT_MAX_CRAFT and b.rounds.len()<=COMBAT_MAX_ROUNDS)
    assert(v.trails.ribbons.len()<=battle_budget(render_quality.tier).ribbons and length(f.look_v)<20)
    assert(is_finite(f.cam_pos.x) and is_finite(f.cam_pos.y) and is_finite(f.look_v.x))
    if timed:worst=max(worst,(time()-frame_start)*1000.0)
    if clock>=trace_time:
        if timed:
            print("CPU seconds={clock:.2} mean_ms={(time()-sample_start)*1000.0/f64(max(1,frames-sample_frames)):.4} worst_ms={worst:.4} traffic_ms={traffic_ms/f64(max(1,frames-sample_frames)):.4} commit_ms={commit_ms/f64(max(1,frames-sample_frames)):.4} view_ms={view_ms/f64(max(1,frames-sample_frames)):.4}")
            sample_start=time();sample_frames=frames;worst=0.0;traffic_ms=0;commit_ms=0;view_ms=0
        print("SOAK seconds={clock:.2} frames={frames} ticks={adapter.frame_ticks} battle={b.tick} actors={b.actors.len()} rounds={b.rounds.len()} ribbons={v.trails.ribbons.len()} flame={v.flame.items.len()} events={b.events.len()} lookv={length(f.look_v):.4} people={w.people.len()} jobs={w.jobs.len()} wrecks={len([loop a in b.actors:if a.status==.wreck:1])}")
        trace_time+=10
print("SOAK PASS seconds={clock:.3} frames={frames} max_ticks={max_ticks} rounds={max_rounds} trails={max_trails} events={max_events} pairs={max_pairs} brains={max_brains} look_velocity={max_look:.4}")
