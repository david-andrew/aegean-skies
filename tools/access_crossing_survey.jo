# Detailed physical inventory of water crossings in an existing route catalogue.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/water_field.jo'
use '../src/access_bridges.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
loop link in catalog.links:
    if link.mode!=.cart:continue
    points:vec3[]
    loop k in 1..link.points.len():
        a=link.points[k-1];b=link.points[k];n=max(1,int(ceil(f64(length(b.xz-a.xz))/8.0)))
        loop j in 0..n:points.push(mix(a,b,f32(j)/f32(n)))
    points.push(link.points[link.points.len()-1]);begin= -1;wet=0
    loop k in 0..points.len():
        p=points[k];r=water_at(f64(p.x),f64(p.z))
        covered=r.wet and access_bridge_height(p.xz,place_ground(p.xz))<r.level-0.3
        if covered:
            if begin<0:begin=k
            wet+=1
        if begin>=0 and (not covered or k==points.len()-1):
            first=points[max(0,begin-12)];last=points[min(points.len()-1,k+12)]
            middle=points[(begin+k)/2];sample=water_at(f64(middle.x),f64(middle.z))
            print("CROSS|{link.id}|{link.a}|{link.b}|{first}|{last}|{middle}|{sample.level}|{sample.width}|{sample.kind}|{wet}")
            begin= -1;wet=0
