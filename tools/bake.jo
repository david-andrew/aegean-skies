# Bake the islands' eroded land into assets/terrain.bin (run after changing the islands or the
# erosion): sloppy --release tools/bake.jo
use '../src/world.jo'

t0 = time()
tiles: LandTile[]
cells = 0
loop k in 0..ISLANDS.len():
    t = bake_tile(k)
    cells += t.nx * t.nz
    print("{ISLANDS[k].name}: {t.nx} x {t.nz}")
    tiles.push(t)
b = encode_tiles(tiles)
path = join_path(dir_name(args()[0]), "../assets/terrain.bin")
if not write_bytes(path, b): panic("cannot write {path}")
print("{cells} cells, {b.len() / 1024} KB, in {time() - t0:.1} s -> {path}")
