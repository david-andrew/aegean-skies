# Bake the islands' eroded land into assets/terrain.bin (run after changing the islands or the
# erosion): sloppy --release tools/bake.jo
use '../src/terrain_data.jo'
use '../src/world.jo'
use '../src/geography.jo'

t0 = time()
tiles: LandTile[]
cells = 0
loop k in 0..ISLANDS.len():
    t = bake_tile(k)
    cells += t.nx * t.nz
    print("{ISLANDS[k].name}: {t.nx} x {t.nz}")
    tiles.push(t)
b = encode_tiles(tiles)
path = join_path(dir_name(args()[0]), "../assets/terrain.bin")
if not write_bytes(path, b): panic("cannot write {path}")
print("{cells} cells, {b.len() / 1024} KB, in {time() - t0:.1} s -> {path}")

# Decode the quantized source before deriving the render hierarchy: CI and the
# runtime must see the same 8 m heights, never the unquantized erosion output.
if not load_land(b): panic("terrain source round trip failed")
render = [loop k in 0..ISLANDS.len(): bake_render_tile(k)]
lod = encode_render_land(render)
if decode_render_land(lod).len() != ISLANDS.len(): panic("render bake round trip failed")
lod_path = join_path(dir_name(args()[0]), "../assets/terrain_lod.bin")
if not write_bytes(lod_path, lod): panic("cannot write {lod_path}")
print("render v{LAND_VERSION}: {lod.len() / 1024} KB -> {lod_path}")

# The expanded world stores only its coarse authored field. Fine samples are
# deterministic and generated locally, never baked over the entire country.
world_bytes = encode_geography()
if not load_geography(world_bytes): panic("world macro round trip failed")
world_path = join_path(dir_name(args()[0]), "../assets/world.bin")
if not write_bytes(world_path,world_bytes): panic("cannot write {world_path}")
print("world v{GEOGRAPHY_VERSION}: {world_bytes.len()} bytes, {small_islands.len()} small islands -> {world_path}")
