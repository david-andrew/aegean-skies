# CPU-only settlement/transport inventory; no route generation or GPU resources.
use '../src/settlements.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/living_far_catalog.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
init_settlements()
packed=inflate(embed('../assets/living-routes.bin')); assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!)); assert(catalog is FarRouteCatalog)
ordered=world_settlements; ordered.sort((s:WorldSettlement):s.id)
key=hash([loop s in ordered:(s.id,s.center,s.out,s.country)])
assert(catalog.version==SETTLEMENT_VERSION and catalog.terrain==terrain_key() and catalog.geography==geography_key() and catalog.places==key,"stale route catalogue")
adj:{int:int[]}; roads:{int:int}; feeders:{int:int}
loop l in catalog.links:
    if l.mode!=.cart:continue
    aa=adj.get(l.a,[]);aa.push(l.b);adj[l.a]=aa
    bb=adj.get(l.b,[]);bb.push(l.a);adj[l.b]=bb
    roads[l.a]=roads.get(l.a,0)+1;roads[l.b]=roads.get(l.b,0)+1
    if l.trail:feeders[l.a]=feeders.get(l.a,0)+1;feeders[l.b]=feeders.get(l.b,0)+1
    print("LINK|{l.id}|{l.a}|{l.b}|{l.length_mm}|{l.road}|{l.trail}|{l.points.len()}")
# Is there a road-only way from each community to a working sea harbour?
reached:{int:bool};queue:int[]
loop s in ordered:
    if s.harbor.len()>0:reached[s.id]=true;queue.push(s.id)
at=0
loop at<queue.len():
    id=queue[at];at+=1
    loop other in adj.get(id,[]):
        if other in reached:continue
        reached[other]=true;queue.push(other)
inland=0;isolated=0;unserved=0;towns=0
loop s in ordered:
    count=roads.get(s.id,0);served=s.id in reached
    if s.harbor.len()==0:
        inland+=1
        if count==0:isolated+=1
        if not served:unserved+=1
        if s.size>=100:towns+=1
    print("PLACE|{s.id}|{s.name}|{s.kind}|{s.size}|{s.country}|{s.region}|{s.center.x}|{s.center.y}|{s.center.z}|{s.radius}|{s.harbor.len()}|{count}|{feeders.get(s.id,0)}|{served}")
print("TOTAL|places={ordered.len()}|inland={inland}|towns={towns}|isolated={isolated}|no_road_to_harbour={unserved}|catalog_links={catalog.links.len()}")
