# Functional scene captures from real saved routines, with normal walking/flight leases.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/terrain.jo'
use '../src/terrain_lod.jo'
use '../src/render_space.jo'
use '../src/curved_world.jo'
use '../src/sea.jo'
use '../src/sky.jo'
use '../src/look.jo'
use '../src/objects.jo'
use '../src/world_towns.jo'
use '../src/settlements.jo'
use '../src/folk.jo'
use '../src/townsfolk.jo'
use '../src/aircraft_catalog.jo'
use '../src/planes.jo'
use '../src/life_view.jo'
use '../src/life_types.jo'
import '../src/traffic.jo' as air
import '../src/living_world.jo' as living
import '../src/living_types.jo' as data
import '../src/living_scene.jo' as clock
import '../src/living_life.jo' as daily
import '../src/life_scene.jo' as walking
import '../src/cargo_scene.jo' as cargo
import '../src/cargo_view.jo' as goods
import '../src/living_save.jo' as saves

window("Daily life acceptance",1280,720)
init_terrain(); init_sea(); init_sky(); init_objects(); init_curved_world()
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
load_terrain(embed('../assets/terrain_lod.bin'))
sea = build_sea_mesh(); depth = build_depth_texture()
towns = [loop s in SETTLEMENTS: build_town(s)]
init_world_towns(towns)
w = living.build_world(u64(0),air.harbors_from_towns(towns))
cargo.configure_cargo_scene(w,towns)
folks: Folk[]; sync_folk(folks,w,towns)
meshes = build_life_meshes(w); crates = goods.build_cargo_meshes()
models = build_craft_models(); traffic = air.make_living_traffic(w,models)
adapter = clock.SceneAdapter()
evening = env("LIFE_CAPTURE") == "evening"
# No people or props are moved for the camera; all plans advance from the starting world.
living.advance_minutes(w,if evening: 1940 else: 35)
sync_folk(folks,w,towns)
focus = w.harbors[0].center
loop venue in w.life_venues:
    if venue.place == 0 and venue.kind == (if evening: VenueKind.square else: VenueKind.market): focus = venue.pos
steps = 0; t = f64(w.tick)/60.0
update = (dt: f64):
    global t,steps
    if steps >= 3600: return
    nav_budget = 1
    loop k in 0..120:
        clock.scene_clock_begin(w)
        cargo.step_cargo_scene(w,towns,focus,1.0/60.0)
        nav_budget -= walking.step_life_scene(w,towns,focus,1.0/60.0,nav_budget)
        clock.scene_clock_end(w)
        update_folk(folks,w,towns,focus,1.0/60.0)
        steps += 1; t += 1.0/60.0
    if steps >= 3600:
        sync_folk(folks,w,towns); update_folk(folks,w,towns,focus,0.0)
        print("SCENE {if evening: "evening square" else: "morning quay"}: minute {w.minute}; catalog {w.place_contexts.len()}; meetings {w.next_meeting}")
        loop p in w.people:
            if p.place != 0 or p.id == 0: continue
            intent = w.daily_life[p.id]
            print("  {p.name}: {intent.venue}/{intent.activity}, arrived {intent.arrived}, blocked '{intent.blocked}', at {p.pose.pos}")
        print("children {w.households.len()}, live meetings {w.active_meetings.len()}")
        print("shared props: bicycle {meshes.bicycle.count} vertices, instrument {meshes.mandolin.count}; saved world {saves.canonical_text(w).len()} text bytes")
draw = ():
    hour = f64(data.local_minute(w.minute))/60.0
    L = light_at(hour)
    clear(BLACK); hide_sky(); fog(L.haze,L.fog_density,0.0012)
    out = w.harbors[0].out; side = vec3(-out.z,0,out.x)
    eye = if evening: focus+out*12.0+side*10.0+vec3(0,5,0) else: focus+out*19.0+side*14.0+vec3(0,8,0)
    camera3d(eye,focus+vec3(0,0.9,0),55.0,0.1,30000.0)
    draw_custom((): draw_sky(L,t))
    draw_custom((): draw_far_sea(depth,L,t,wind_now))
    draw_custom((): draw_ground(L,t))
    draw_custom((): draw_towns(towns,L,t))
    draw_custom((): draw_world_towns(towns,L,t))
    draw_custom(():
        draw_folk(folks,L,t)
        draw_life(w,meshes,L,t)
        goods.draw_cargo(w,crates,L,t)
        loop c in w.aircraft:
            if c.place < 0 or c.dock < 0: continue
            at = afloat(c.pose.pos,t)*translation(c.pose.pos)*quat_to_mat4(c.pose.rot)
            draw(obj_sh,models[c.model_index].body,obj_params(L,t,at))
            draw_craft_props(models[c.model_index],L,t,at,0.4)
        loop tw in towns:
            loop boat in tw.boats: draw(obj_sh,boat.mesh,obj_params(L,t,afloat(boat.at,t)*translation(boat.at)))
    )
    draw_custom((): draw_sea(sea,depth,L,t,wind_now,vec3(0,0,0)),transparent=true)
