# Faces and cats up close, for looking at them: FACEVIEW=pilot|follow|folk|cats|pet|feed sloppy tools/faceview.jo
# (pilot: the player's pilot's face; follow: the same at the follow camera's distance; folk: a row
# of townsmen with their mustaches)
use '../src/look.jo'
use '../src/sky.jo'
use '../src/objects.jo'
use '../src/folk.jo'
use '../src/cats.jo'

window("Faces", 1280, 720)
init_sky(); init_objects()
mode = env("FACEVIEW") ?? "pilot"
pilot = build_figure(.pilot, 7, mustache = 1, mustache_tint = PILOT_MUSTACHE)
row_dress: Dress[] = [.fisher, .merchant, .worker]
row_seed = [3, 11, 25]
row_age = [34, 70, 50]
row_style = [1, 2, 3]
row = [loop k in 0..row_dress.len(): build_figure(row_dress[k], row_seed[k], age = row_age[k], mustache = row_style[k])]
cats = build_cat_scene(false)
acts: CatAct[] = [.sit, .loaf, .walk, .lean, .eat]
floor_m = custom_mesh((): 
    vs: Vertex3D[]
    add_box(vs, vec3(0, -0.5, 0), vec3(30, 1, 6), rgb(0.78, 0.74, 0.66))
    vs
())
t = 0.0
update = (dt: f64): t += dt
draw = ():
    L = light_at(15.0)
    clear(BLACK)
    hide_sky()
    s = f64(pilot.height)
    if mode == "pilot": camera3d(vec3(0.35, f32(1.72 * s), -0.95), vec3(0, f32(1.68 * s), 0), 32.0, 0.05, 5000.0)
    else if mode == "follow": camera3d(vec3(2.4, f32(1.72 * s + 1.4), -4.6), vec3(0, f32(1.45 * s), 0), 55.0, 0.05, 5000.0)
    else if mode == "folk": camera3d(vec3(0.3, 1.8, -2.3), vec3(0, 1.55, 0), 40.0, 0.05, 5000.0)
    else if mode == "cats": camera3d(vec3(0.0, 0.9, -2.6), vec3(0, 0.2, 0.4), 50.0, 0.05, 5000.0)
    else: camera3d(vec3(2.4, 1.3, 2.0), vec3(0, 0.45, 0.4), 40.0, 0.05, 5000.0)
    draw_custom((): draw_sky(L, t))
    draw_custom(():
        draw(obj_sh, floor_m, obj_params(L, t))
        if mode == "cats":
            loop a in 0..6:
                cat = Cat(a, vec3(0, 0, 0), 0.0, vec3(f32(2.0 - f64(a) * 0.8), 0, 0.4), PI * 0.7, a, act = acts[a % acts.len()], phase = t * 6.0)
                draw_cat(cats.meshes, cat, L, t)
        else if mode == "pet" or mode == "feed":
            draw_figure(pilot, vec3(0, 0, 0), 0.0, 0.0, 0.0, L, t, posture = 4)
            cat = Cat(0, vec3(0, 0, 0), 0.0, vec3(0, 0, 0.85), PI, 0, act = if mode == "pet": CatAct.lean else: CatAct.eat)
            draw_cat(cats.meshes, cat, L, t, if mode == "feed": 0.7 else: 0.0)
        else if mode == "folk":
            loop k in 0..row.len(): draw_figure(row[k], vec3(f32(0.8 - f64(k) * 0.8), 0, 0), PI + 0.3 * f64(k - 1), 0.0, 0.0, L, t)
        else: draw_figure(pilot, vec3(0, 0, 0), PI + 0.35, 0.0, 0.0, L, t)
    )
