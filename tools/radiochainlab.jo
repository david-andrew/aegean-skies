# File-only receiver comparisons. Input: little-endian mono float32 PCM at 16 kHz.
# CHAIN_INPUT=/scratch/music.f32 CHAIN_OUTPUT=/scratch/out CHAIN_RECORD=0.8
# SLOPPY_THREADS=1 SLOPPY_NO_AUDIO=1 sloppy --release tools/radiochainlab.jo
use '../src/radio_chain.jo'

input = env("CHAIN_INPUT") ?? ""
dir = env("CHAIN_OUTPUT") ?? ""
assert(input != "" and dir != "")
b = read_bytes(input)
assert(b is u8[])
assert(b.len()>0 and b.len()%4 == 0)
source: f64[]
loop at in 0..b.len()/4:
    i=at*4
    bits=u32(b[i]) | (u32(b[i+1])<<8) | (u32(b[i+2])<<16) | (u32(b[i+3])<<24)
    source.push(f64(f32_from_bits(bits)))
record = clamp(to_float(env("CHAIN_RECORD") ?? "0") ?? 0.0,0.0,1.0)
loop setting in 0..(if (env("CHAIN_STRONG_ONLY") ?? "0") == "1": 1 else: 5):
    strength=if setting==0: 1.0 else: if setting==1: 0.55 else: 0.18
    detuning=if setting==4: 8.0 else: 0.0
    night=if setting==3: 1.0 else: 0.0
    name=["strong","medium","weak","weak-night","weak-edge"][setting]
    c=make_radio_chain(7)
    c.strength=strength; c.record=record; c.night=night; c.detuning=detuning
    out=fill(f32(0),source.len()*6)
    energy=0.0; peak=0.0
    loop i in 0..source.len():
        v=radio_chain_sample(c,source[i],strength,detuning,record,night)
        energy+=v*v; peak=max(peak,abs(v))
        loop j in 0..6: out[i*6+j]=f32(v)
    assert(save_wav(dir+"/"+name+".wav",Sound(out)))
    print("{name}: peak={peak:.5} rms={sqrt(energy/f64(source.len())):.5} clicks={c.clicks} crashes={c.crashes}")
