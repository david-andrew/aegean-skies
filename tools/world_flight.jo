# Headless-only acceptance path: streaming, teleports, seams and near contact.
# Set SLOPPY_SCREENSHOT and SLOPPY_FRAMES=720; no windows/audio on desktop.
use '../src/geography.jo'
use '../src/world.jo'
use '../src/world_terrain.jo'
use '../src/terrain_lod.jo'
use '../src/terrain.jo'
use '../src/render_space.jo'
use '../src/look.jo'

window("World streaming check",1280,720)
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_world_terrain()

ref_coarse = (tile: WorldTile,p: vec2,step: f64) -> f64:
    ox,oz = world_tile_origin(tile.x,tile.z,tile.level)
    cell = 14.0*f64(1<<tile.level)
    x = min(floor(f64(p.x)/step)*step,16.0-step)
    z = min(floor(f64(p.y)/step)*step,16.0-step)
    u = (f64(p.x)-x)/step; v = (f64(p.y)-z)/step
    a = new_land_canonical(ox+x*cell,oz+z*cell)
    b = new_land_canonical(ox+(x+step)*cell,oz+z*cell)
    c = new_land_canonical(ox+x*cell,oz+(z+step)*cell)
    d = new_land_canonical(ox+(x+step)*cell,oz+(z+step)*cell)
    if u+v <= 1.0: a+u*(b-a)+v*(c-a) else: d+(1.0-u)*(c-d)+(1.0-v)*(b-d)

ref_vertex = (slot: int,wx: f64,wz: f64) -> f64:
    tile = world_tiles[slot]
    ox,oz = world_tile_origin(tile.x,tile.z,tile.level)
    cell = 14.0*f64(1<<tile.level)
    p = vec2(f32((wx-ox)/cell),f32((wz-oz)/cell))
    edges,mask = world_edge_state(slot)
    lev = tile.lod
    if p.x == 0.0: lev = max(lev,f64(edges.x))
    if p.x == 16.0: lev = max(lev,f64(edges.y))
    if p.y == 0.0: lev = max(lev,f64(edges.z))
    if p.y == 16.0: lev = max(lev,f64(edges.w))
    lev = clamp(lev-f64(tile.level),0.0,3.0)
    step = pow(2.0,floor(lev))
    mix(ref_coarse(tile,p,step),ref_coarse(tile,p,min(step*2.0,16.0)),lev-floor(lev))

frame = 0
max_cache = 0
max_selected = 0
max_triangles = 0
worst_gap = 0.0
near_checks = 0
update = (dt: f64):
    global frame
    frame += 1

draw = ():
    global max_cache,max_selected,max_triangles,worst_gap,near_checks
    t = f64(frame)/60.0
    # Fixed views settle, movement follows at 200 m/s, then far teleport.
    x = -151000.0; z = -120000.0; altitude = 4000.0
    if frame > 180:
        x = -144000.0 + max(0.0,f64(frame-300))*200.0/60.0
        z = -119000.0
        altitude = new_land_surface(x,z)+2.0
    if frame > 480: x = 223000.0; z = -72000.0; altitude = 4000.0
    cam = vec3(f32(x),f32(altitude),f32(z))
    clear(BLACK); hide_sky()
    camera3d(cam,cam+vec3(0.5,-0.2,-1),62.0,0.3,world_far(altitude))
    draw_custom(():
        draw_world_terrain(light_at(14.0),t)
        max_cache = max(max_cache,world_cache.len())
        max_selected = max(max_selected,world_selected.len())
        max_triangles = max(max_triangles,world_triangles)
        assert(world_cache.len() <= WORLD_CACHE_SLOTS)
        assert(world_generated <= world_generate_budget and world_generate_budget <= WORLD_CONTACT_GENERATE_LIMIT)
        assert(world_uploaded <= world_generate_budget*17*17*8)
        if frame%30 == 0:
            loop sa in world_selected:
                a = world_tiles[sa]
                ax,az = world_tile_origin(a.x,a.z,a.level); size = world_tile_size(a.level)
                if frame > 280 and frame < 480 and x >= ax and x < ax+size and z >= az and z < az+size:
                    assert(a.level == 0)
                    assert(abs(ref_vertex(sa,x,z)-new_land_surface(x,z)) < 0.002)
                    near_checks += 1
                loop sb in world_selected:
                    if sa == sb: continue
                    b = world_tiles[sb]
                    bx,bz = world_tile_origin(b.x,b.z,b.level); bs = world_tile_size(b.level)
                    assert(not (ax < bx+bs and ax+size > bx and az < bz+bs and az+size > bz))
                    side = world_neighbor_side(a,b)
                    if side < 0: continue
                    assert(abs(a.level-b.level) <= 1)
                    if a.level > b.level: continue
                    loop k in 0..17:
                        wx = ax+f64(k)*size/16.0; wz = az+f64(k)*size/16.0
                        match side:
                            0: wx = ax
                            1: wx = ax+size
                            2: wz = az
                            _: wz = az+size
                        gap = abs(ref_vertex(sa,wx,wz)-ref_vertex(sb,wx,wz))
                        worst_gap = max(worst_gap,gap)
                        if gap >= 0.002: print("gap={gap} frame={frame} levels={a.level}/{b.level} lod={a.lod}/{b.lod}")
                        assert(gap < 0.002)
        if frame == 720:
            assert(near_checks > 0)
            print("WORLD CHECK PASS cache={max_cache}/{WORLD_CACHE_SLOTS} selected={max_selected} triangles={max_triangles} seam={worst_gap:.8}m contacts={near_checks}")
    )
