# Convert an actual full-registry replay checkpoint and exercise both durable banks.
build:
    name = "worldlog"

use '../src/living_types.jo'
use '../src/living_save.jo'
source=env("WORLD_SOURCE") ?? "phase4-month-v5"
target=env("WORLD_CHECKPOINT") ?? "phase4-browser-storage"
saved=load_game(42,source); assert(saved is SaveGame)
loop _ in 0..2:
    generation=save_game(saved.world,saved.presentation,42,target)
    assert(generation is int)
restored=load_game(42,target)
assert(restored is SaveGame and canonical_text(restored.world)==canonical_text(saved.world))
encoded=0; browser=0
loop suffix in ["-a","-b","-a-data","-b-data"]:
    text=load_data(target+suffix) ?? ""
    eprint("STORAGE_KEY {target+suffix} bytes={text.len()}")
    encoded+=(text.len()+2)/3*4
    browser+=if suffix.ends_with("-data") and text.len()>=48: (text.len()*8+14)/15+"AS15:{text.len()}:".len() else: (text.len()+2)/3*4
eprint("STORAGE legacy_base64_chars={encoded} browser_wide_chars={browser} limit={5*1024*1024}")
assert(browser<5*1024*1024-256*1024)
