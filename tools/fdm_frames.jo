# Strobe of a stall, seen from the side: the real aircraft mesh at the simulated poses every
# FDM_EVERY seconds along its true flight path (drawn 3x size), for the liked model or flight model v2.
#   FDM_MODEL=0|1 FDM_KIND=0 FDM_CASE=idle|power FDM_ZOOM=50 (degrees) SLOPPY_FRAMES=2 SLOPPY_SCREENSHOT=out.png sloppy tools/fdm_frames.jo
# (headless: env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1)
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/flight_v2.jo' as v2
use '../src/planes.jo'
use '../src/damage.jo'
use '../src/objects.jo'
use '../src/look.jo'

const K = 3.3
model_id = clamp(to_int(env("FDM_MODEL") ?? "1") ?? 1, 0, 1)
kind = Craft(clamp(to_int(env("FDM_KIND") ?? "0") ?? 0, 0, 15))
idle = (env("FDM_CASE") ?? "idle") == "idle"
every = to_float(env("FDM_EVERY") ?? "0.5") ?? 0.5
zoom = (to_float(env("FDM_ZOOM") ?? "50") ?? 50.0) * PI / 180.0

window("Stall strobe", 1920, 1080)
init_objects()
fl.set_speed_scale(K); fl.set_lift_scale(K)
tw.set_tweaks(tw.Tweaks(pure_scale = true, flight_model = model_id))
model = build_craft(kind, LIVERIES[0])
k = fl.craft_spec(kind, model.contacts)
k.player = true

vt = (s: fl.CraftState) -> f64: f64(length(s.velocity)) / K
path_of = (s: fl.CraftState) -> f64: asin(clamp(f64(s.velocity.y) / max(f64(length(s.velocity)), 0.1), -1.0, 1.0))
bank_of = (s: fl.CraftState) -> f64:
    r = quat_rotate(s.orientation, vec3(1, 0, 0)); u = quat_rotate(s.orientation, vec3(0, 1, 0))
    atan2(-f64(r.y), f64(u.y))

struct Pose:
    state: fl.CraftState
    dist = 0.0

# the idle (or 70% power) zoom stall of tools/fdm_compare.jo, recorded
poses: Pose[]
line: vec2[]
power = if idle: 0.0 else: 0.7
s = fl.CraftState(position = vec3(0, f32(300.0 * K), 0), velocity = vec3(0, 0, f32(-k.cruise_speed)), fuel = k.fuel_capacity, water_age = 1.0)
s.throttle = power; s.rpm = power
broke = -1.0; done = -1.0; dist = 0.0; next = 0.0
loop i in 0..60 * 30:
    c = fl.Controls(throttle = power)
    if broke < 0.0: c.pitch = clamp((zoom - path_of(s)) * 2.5 / k.pitch_rate, -1.0, 1.0)
    else:
        c.throttle = if idle and s.stalled: 0.0 else: 1.0
        if vt(s) > k.stall_speed * 1.05 and not s.stalled: c.pitch = clamp(((if vt(s) < k.stall_speed * 1.3: -0.1 else: 0.0) - path_of(s)) * 2.5 / k.pitch_rate, -1.0, 1.0)
    c.roll = clamp(-bank_of(s) * 2.0, -1.0, 1.0) * 0.5
    fl.step(k, s, c, fl.FlightEnv(), 1.0 / 60.0)
    dist += f64(length(vec3(s.velocity.x, 0, s.velocity.z))) / K / 60.0
    if broke < 0.0 and (s.stalled or vt(s) < k.stall_speed * 0.6): broke = s.time
    line.push(vec2(f32(dist), f32(f64(s.position.y) / K)))
    if s.time >= next - 0.0001:
        poses.push(Pose(s, dist)); next += every
    if broke >= 0.0 and done < 0.0 and not s.stalled and path_of(s) > -0.14 and vt(s) > k.stall_speed * 1.05 and s.time > broke + 0.5: done = s.time
    if done > 0.0 and s.time > done + 1.5: break

lo = vec2(1e9, 1e9); hi = vec2(-1e9, -1e9)
loop p in line:
    lo = min(lo, p); hi = max(hi, p)
mid = (lo + hi) * 0.5
extent = max(f64(hi.x - lo.x) * 0.5625, f64(hi.y - lo.y)) * 1.25 + 30.0
draw = ():
    clear(rgb(0.86, 0.9, 0.93)); hide_sky()
    fov = 8.0
    dist_cam = extent / (2.0 * tan(fov * 0.5 * PI / 180.0))
    camera3d(vec3(mid.x, mid.y, f32(dist_cam)), vec3(mid.x, mid.y, 0), fov, 1.0, dist_cam * 2.0)
    L = light_at(11.0); L.fog_density = 0.0
    loop i in 1..line.len():
        a = line[i - 1]; b = line[i]
        draw_line3d(vec3(a.x, a.y, -2), vec3(b.x, b.y, -2), rgba(0.2, 0.25, 0.3, 0.6), extent * 0.0018)
    draw_custom(():
        loop p in poses:
            # (the sim flies north (-z); turned to fly right across the picture, drawn 3x size)
            at = translation(vec3(f32(p.dist), f32(f64(p.state.position.y) / K), 0)) * rotation_y(-PI * 0.5) * quat_to_mat4(p.state.orientation) * scaling(3.0)
            draw_craft_parts(model, p.state.damage, at, L, p.state.time, p.state.time * p.state.throttle * 40.0)
    )
    loop p in poses:
        if let at = world_to_screen(vec3(f32(p.dist), f32(f64(p.state.position.y) / K - 14.0), 0)):
            text("{p.state.time:.1}s", at - vec2(18, 0), 16, rgba(0.15, 0.15, 0.15, 0.9))
            text("{vt(p.state) * 3.6:.0}", at + vec2(-14, 18), 15, rgba(0.15, 0.3, 0.6, 0.9))
    name = if model_id == 1: "Flight model v2" else: "The liked model"
    what = "zoom to {zoom * 180.0 / PI:.0} degrees " + (if idle: "at idle until it breaks; hands off, then power" else: "at 70% power until it breaks; hands off, full power")
    text("{name} | {CRAFT_NAMES[int(kind)]} | {what}", vec2(30, 22), 28, rgba(0.1, 0.1, 0.1, 1))
    text("Side view of the true flight path; the aircraft every {every:.1} s at its simulated attitude (drawn 3x size). Time, and true speed in km/h (blue). Break at {broke:.1} s, flying again at {done:.1} s.", vec2(30, 62), 18, rgba(0.2, 0.2, 0.2, 0.85))
