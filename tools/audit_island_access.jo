# Read-only diagnosis of unserved places in the shipped access manifest. Does
# not generate routes, alter settlement identities, or initialize GPU resources.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/inland_access_data.jo'
use '../src/living_feeder_bake.jo'
use '../src/water_field.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
ids=INLAND_ACCESS.keys();ids.sort()
count=0
loop id in ids:
    if INLAND_ACCESS[id].landing>=0:continue
    assert(id in settlement_by_id)
    s=world_settlements[settlement_by_id[id]]
    displacement=length(settlement_avoid_buildings(s.center.xz)-s.center.xz)
    wet=water_at(f64(s.center.x),f64(s.center.z)).wet
    sibling= -1;name="none";harbors=0;distance=0.0;straight=false
    if id-1 in settlement_by_id:
        coast=world_settlements[settlement_by_id[id-1]]
        sibling=coast.id;name=coast.name;harbors=coast.harbor.len()
        distance=f64(length(s.center.xz-coast.center.xz))
        straight=feeder_segment_clear(s.center,coast.center)
    print("GAP|{id}|{s.name}|{s.kind}|{s.country}|{max(4,s.size*4)}|{s.center.x}|{s.center.y}|{s.center.z}|{displacement}|{wet}|{sibling}|{name}|{harbors}|{distance}|{straight}")
    count+=1
print("TOTAL|{count}")
