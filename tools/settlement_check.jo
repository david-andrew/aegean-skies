use '../src/settlements.jo'
use '../src/world.jo'
use '../src/geography.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_settlements()
counts: {SettlementKind: int} = {}
loop s in world_settlements:
    counts[s.kind] = counts.get(s.kind,0)+1
    print("PLACE {s.id} {s.name} {s.kind} region={s.region} size={s.size} at={s.center.x:.1} {s.center.y:.1} {s.center.z:.1} out={s.out.x:.3} {s.out.y:.3} roads={s.roads.len()}")
print("COUNTS {counts} roads={settlement_roads.len()}")

loop k in 0..min(5,settlement_roads.len()):
    road = settlement_roads[k]; at = road.points[road.points.len()/2]
    ahead = road.points[min(road.points.len()/2+2,road.points.len()-1)]
    direction = ahead-at
    print("ROAD {k} at={at.x:.2} {at.y:.2} {at.z:.2} yaw={atan2(-f64(direction.x),-f64(direction.z)):.5}")

loop isl in small_islands:
    if max(isl.radii.x,isl.radii.y) < 1000.0: continue
    found = false
    loop s in world_settlements:
        if s.region == isl.id: found = true
    if not found: print("MISSING island={isl.id} at={isl.center} radii={isl.radii} peak={isl.peak}")
