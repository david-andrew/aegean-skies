use '../src/world_towns.jo'
use '../src/world.jo'
use '../src/objects.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_seed.jo'
use '../src/living_types.jo'
use '../src/living_life.jo'
use '../src/living_life_seed.jo'
use '../src/living_domestic.jo'
use '../src/life_scene.jo'
use '../src/cargo_scene.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/town_life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_far_people.jo'
use '../src/life_types.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
towns=[loop s in SETTLEMENTS: build_town(s)]
init_world_towns(towns)
finish_settlement_registry()
w=build_world()
configure_cargo_scene(w,towns)
configure_life_scene(w,towns)
print("FIXTURES {w.life_venues.len()} people={w.people.len()}")
loop minutes in [0,240,90,120]:
    advance_minutes(w,minutes)
    print("CLOCK {w.minute} save={validate_save_world(w)}")
    loop id,intent in w.daily_life:
        if w.people[id].home!=0: continue
        print("PERSON {id} {w.people[id].name} home={choose_life_venue(w,0,.home,id)!.pos} pos={w.people[id].pose.pos} action={w.people[id].action.activity} goal={intent.venue} arrived={intent.arrived} blocked={intent.blocked} fixture={core_domestic(w,id,.seat)}")
    loop p in w.households:
        if p.home==0: print("CHILD {p.id} {p.pose} target={p.target} venue={p.venue}")

s=world_settlements[settlement_by_id[10001]]
prepare_far_fixtures(w,s.center)
prepare_far_people(w,s.center)
print("FAR fixtures={w.place_contexts[s.id].venues.len()} homes={w.far.districts[s.id].homes}")
loop id in w.far.districts[s.id].named:
    w.minute=1110-EPOCH_LOCAL_MINUTE; w.tick=w.minute*120
    venue=far_person_venue(w,id)
    print("FAR PERSON {id} {w.people[id].name} home={w.far.people[id].home_pos} goal={venue}")
    if venue.kind==.seat:
        path=cargo_walk_path(towns,w.far.people[id].home_pos,venue.pos)
        print("ROUTE {id} points={path.len()}")
        assert(path.len()>=2)
