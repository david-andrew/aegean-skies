# Offline shore/road survey. Never route-find or probe terrain on lake arrival.
use '../src/lake_data.jo'
use '../src/lake_access_data.jo'
use '../src/lake_field.jo'
use '../src/settlements.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/living_feeder_bake.jo'
use '../src/access_path_bake.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
source="# Baked shore approaches; regenerate with tools/bake_lake_access.jo.\nuse 'landing_access_types.jo'\nLAKE_LANDINGS:{{int:LandingAccess}}={{\n"
loop lake in SETTLEMENT_LAKES:
    s=world_settlements[settlement_by_id[lake.id]]
    # The town fronts its surveyed natural shore. Search from its square toward
    # the lake, never radially from an ellipse centre.
    out=lake.out;side=vec2(-out.y,out.x)
    best:vec3[];root=vec3(0,0,0);tip=vec3(0,0,0);score=1e30
    loop offset in [0.0,-40.0,40.0,-80.0,80.0]:
        start=s.center.xz+side*f32(offset)
        low=0.0;high=600.0
        if not lake_at(f64((start+out*f32(high)).x),f64((start+out*f32(high)).y)).wet:continue
        loop k in 0..20:
            mid=(low+high)*0.5;p=start+out*f32(mid)
            if lake_at(f64(p.x),f64(p.y)).wet:high=mid
            else:low=mid
        at=place_point(start+out*f32(low-18.0))
        path=access_track(s.center.xz,at.xz)
        if path.len()<2:continue
        end=at+vec3(out.x,0,out.y)*110.0;end.y=f32(lake.level+1.2)
        clear=false
        loop attempt in 0..35:
            clear=true
            loop sign in [-1.0,1.0]:
                p=end.xz-out*12.0+side*f32(sign*18.0)
                if not lake_at(f64(p.x),f64(p.y)).wet or lake.level-place_ground(p)<2.8:clear=false
            if clear:break
            end+=vec3(out.x,0,out.y)*10.0
        if not clear:continue
        runway=true
        loop k in 0..20:
            p=mix(at,end,f32(k)/19.0).xz-lake.center
            if abs(dot(p,lake.axis))<f32(LAKE_CLEAR_RUN*0.5+40.0) and abs(dot(p,vec2(-lake.axis.y,lake.axis.x)))<85.0:runway=false
        if not runway:continue
        distance=0.0
        loop k in 1..path.len():distance+=f64(length(path[k]-path[k-1]))
        if distance<score:score=distance;best=path;root=at;tip=end
    assert(best.len()>1,"no dry shore approach and runway-clear jetty for {lake.name}")
    source+="    {lake.id}:LandingAccess(vec3({root.x},{root.y},{root.z}),vec3({tip.x},{tip.y},{tip.z}),vec2({out.x},{out.y}),["
    loop p in compact_place_route(best):source+="vec3({p.x},{p.y},{p.z}),"
    source+="]),\n"
    print("LANDING|{lake.id}|{lake.name}|{root}|{tip}|{score}|{best.len()}")
source+="}}\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/lake_access_data.jo'),source))
