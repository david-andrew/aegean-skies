# Offline shore/road survey. Never route-find or probe terrain on lake arrival.
use '../src/lake_data.jo'
use '../src/lake_access_data.jo'
use '../src/lake_field.jo'
use '../src/settlements.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/living_feeder_bake.jo'
use '../src/access_path_bake.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
source="# Baked shore approaches; regenerate with tools/bake_lake_access.jo.\nstruct LakeLanding:\n    root:vec3\n    tip:vec3\n    out:vec2\n    route:vec3[]\nLAKE_LANDINGS:{{int:LakeLanding}}={{\n"
loop lake in SETTLEMENT_LAKES:
    s=world_settlements[settlement_by_id[lake.id]]
    # Land on a long bank: an end-on pier would obstruct the takeoff run.
    toward=vec2(-lake.axis.y,lake.axis.x)
    if dot(s.center.xz-lake.center,toward)<0.0:toward= -toward
    best:vec3[];root=vec3(0,0,0);out=vec2(0,0);score=1e30
    loop angle in [0.0,-0.25,0.25,-0.5,0.5,-0.75,0.75]:
        ray=vec2(toward.x*f32(cos(angle))-toward.y*f32(sin(angle)),toward.x*f32(sin(angle))+toward.y*f32(cos(angle)))
        low=0.0;high=1200.0
        loop k in 0..18:
            mid=(low+high)*0.5;p=lake.center+ray*f32(mid);sample=lake_at(f64(p.x),f64(p.y))
            if sample.found and sample.distance/sample.width<1.11:low=mid
            else:high=mid
        shore=place_point(lake.center+ray*f32(high))
        path=if env("AEGEAN_REUSE_LAKE_PATHS")=="1" and lake.id in LAKE_LANDINGS:LAKE_LANDINGS[lake.id].route else:access_track(s.center.xz,shore.xz)
        if path.len()<2:continue
        distance:f64=0
        loop k in 1..path.len():distance+=f64(length(path[k]-path[k-1]))
        if distance<score:score=distance;best=path;root=shore;out= -ray
        if angle==0.0:break
    assert(best.len()>1,"no walkable shore approach for {lake.name}")
    tip=root+vec3(out.x,0,out.y)*max(110.0,length(root.xz-lake.center)*0.30);tip.y=f32(lake.level+1.2)
    # Both float positions need real depth on the canonical surface, including
    # its source interpolation, not just nominal distance into the basin.
    side=vec2(-out.y,out.x)
    loop attempt in 0..40:
        clear=true
        loop sign in [-1.0,1.0]:
            at=tip.xz-out*12.0+side*f32(sign*18.0)
            if not lake_at(f64(at.x),f64(at.y)).wet or lake.level-place_ground(at)<2.8:clear=false
        if clear:break
        tip+=vec3(out.x,0,out.y)*10.0
    assert(lake.level-place_ground(tip.xz-out*12.0)>2.8)
    source+="    {lake.id}:LakeLanding(vec3({root.x},{root.y},{root.z}),vec3({tip.x},{tip.y},{tip.z}),vec2({out.x},{out.y}),["
    loop p in compact_place_route(best):source+="vec3({p.x},{p.y},{p.z}),"
    source+="]),\n"
    print("LANDING|{lake.id}|{lake.name}|{root}|{tip}|{score}|{best.len()}")
source+="}}\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/lake_access_data.jo'),source))
