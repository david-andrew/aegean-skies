# Explicit synthetic vessel acceptance scenes. Never seeds the living game.
# VESSEL_SCENE=steamer|schooner|convoy|morning|night|catalog|sinking
build:
    js = "../src/web_compat.js"

use '../src/vessel_types.jo'
use '../src/vessels.jo'
use '../src/sea_routes.jo'
use '../src/vessel_view.jo'
use '../src/vessel_scene.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/sky.jo'
use '../src/sea.jo'
use '../src/terrain.jo'
use '../src/terrain_lod.jo'
use '../src/curved_world.jo'
use '../src/quality.jo'
use '../src/wake.jo'

scene = env("VESSEL_SCENE") ?? "steamer"
window("Vessel acceptance",1280,720)
init_quality()
render_quality = quality_profile(to_int(env("VESSEL_QUALITY") ?? "2") ?? 2)
init_objects(); init_terrain(); init_sky(); init_sea(); init_curved_world(); init_wake()
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
build_terrain_from_source()
init_settlements(false)
towns = [loop st in SETTLEMENTS: build_town(st)]
water = build_sea_mesh(); depth = build_depth_texture()
fleet = VesselFleet(); view = VesselView()
wind_now.speed = if scene == "schooner": 17.0 else: 9.0
wind_now.dir = normalize(vec2(0.85,0.45))
port = world_settlements[0]; out = port.out; tangent = vec2(-out.y,out.x)
base = port.center.xz+out*1800.0
kinds: VesselKind[] = [.coastal_steamer]
if scene == "schooner": kinds = [.trehantiri]
if scene == "convoy": kinds = [.tramp_freighter,.tanker,.tramp_freighter,.kalyra_destroyer,.kalyra_torpedo,.seaplane_tender]
if scene == "morning": kinds = [.sail_caique,.motor_caique,.sail_caique]
if scene == "night": kinds = [.passenger_steamer,.island_ferry,.motor_yacht]
if scene == "catalog": kinds = [loop k in 0..18: VesselKind(k)]
if scene == "sinking": kinds = [.coastal_steamer]
loop k in 0..kinds.len():
    kind = kinds[k]; spec = vessel_spec(kind)
    offset = if scene == "catalog": vec2(f32(k%6)*140.0-350.0,f32(k/6)*180.0) else: vec2(f32(k%3-1)*150.0,f32(k/3)*220.0)
    if kinds.len() == 1: offset = vec2(0,0)
    start = base+tangent*offset.x+out*offset.y
    if scene == "morning": start = port.center.xz+out*f32(120.0+f64(k)*55.0)+tangent*f32(f64(k-1)*28.0)
    finish = start+out*1500.0
    lane = request_sea_lane(fleet,0,0,start,finish,spec.draft,spec.beam*0.5+2.0,true)
    assert(lane >= 0)
    assert(spawn_vessel(fleet,Vessel(id=100+k,kind=kind,owner=10+k,side=1,lane=lane,position=vec3(start.x,0,start.y),yaw=atan2(f64(out.x),f64(out.y)),speed=spec.speed,convoy=if scene == "convoy": 1 else: -1,escort=if spec.navy: 100 else: -1,crew=[1000+k])))
# Explicit fixture setup completes routes offline; the game never does this.
rounds = 0
loop rounds < 50000:
    pending = false
    loop lane in fleet.lanes:
        if lane.status == .queued or lane.status == .searching or lane.status == .validating: pending = true
    if not pending: break
    step_sea_navigation(fleet,512); rounds += 1
loop lane in fleet.lanes:
    print("lane {lane.id}: {lane.status} points={lane.points.len()} reason={lane.reason}")
    assert(lane.status == .ready)
seek = if scene == "morning": 10.0 else: 22.0
step_vessels(fleet,wind_now.dir*f32(wind_now.speed),seek)
if scene == "sinking":
    damage_vessel(fleet,100,1.0,999,true)
    step_vessels(fleet,wind_now.dir*f32(wind_now.speed),19.0)
t = seek
hour = if scene == "night": 21.5 else: if scene == "morning": 6.6 else: 14.5
print("CAPTURE vessel {scene}; {port.name}; base {base}; hour {hour}; fixture time {t}")
update = (dt: f64):
    global t
    if env("VESSEL_MOVE") != none:
        step_vessels(fleet,wind_now.dir*f32(wind_now.speed),clamp(dt,0.0,0.1)); t += min(dt,0.1)

draw = ():
    focus = fleet.ships[0].position
    size = vessel_spec(fleet.ships[0].kind).length
    side = vec3(tangent.x,0,tangent.y); forward = vec3(out.x,0,out.y)
    eye = focus+side*f32(size*0.95)+forward*f32(size*1.1)+vec3(0,f32(size*0.42),0)
    if scene == "schooner": eye = focus+side*43.0+forward*23.0+vec3(0,17,0); focus.y = 9
    if scene == "morning": eye = port.center+side*85.0+vec3(0,34,0); focus = port.center+forward*300.0
    if scene == "convoy" or scene == "night": eye = focus+side*370.0-forward*190.0+vec3(0,145,0); focus += side*110.0+forward*70.0
    if scene == "catalog": eye = vec3(base.x,650,base.y)+side*650.0+forward*900.0; focus = vec3(base.x,0,base.y)+forward*300.0
    camera3d(eye,focus,55,0.2,100000)
    hide_sky()
    L = light_at(hour)
    draw_custom((): draw_sky(L,t))
    draw_custom((): draw_far_sea(depth,L,t,wind_now))
    draw_custom(():
        draw_ground(L,t); draw_towns(towns,L,t)
        if env("VESSEL_HIDE") != none: return
        prepare_vessel_view(view,fleet,scene_camera(),t,wind_now.dir*f32(wind_now.speed))
        # Frozen fixture wakes retain the vessel's recent track, without a fake body.
        if view.frame == 24:
            loop wi in 0..view.wakes.len():
                k = vessel_index(fleet,view.wakes[wi].id); s = fleet.ships[k]
                view.wakes[wi].trail = WakeTrail()
                loop j in 0..24:
                    age = f64(23-j)*0.5
                    stern = s.position-vec3(f32(sin(s.yaw)),0,f32(cos(s.yaw)))*f32(vessel_spec(s.kind).length*0.48)
                    wake_step(view.wakes[wi].trail,stern-s.velocity*f32(age),s.velocity,true,vessel_spec(s.kind).beam*0.25,t-age)
        draw_vessels(view,L,t)
        if view.frame == 60: print("vessels models={view.models.len()} near={view.near_count} far={view.far_count} triangles={view.triangles} wakes={view.wakes.len()} smoke={view.smoke_buffer.count} resident={memory_in_use()}")
    )
    draw_custom((): draw_sea(water,depth,L,t,wind_now),transparent=true)
    draw_custom((): draw_vessel_wakes(view,L,t),transparent=true)
    draw_custom((): draw_vessel_smoke(view,L,t),transparent=true)
