# Survey a way up from the sea for an island community the narrow shore probe
# could not serve. Read-only: each result is written to OUTDIR/shore-ID.txt for
# tools/install_island_landing.jo. Usage:
#   survey_island_climb.jo ID[,ID...] OUTDIR [CELL_M [ALTERNATIVES]]
# With ALTERNATIVES>0, also writes shore-ID-altN.txt: the next best landings at
# least 1.5 km from those already written (for a jetty no ship lane reaches).
# One flood of the whole island from the square, on the stepped-path rules, finds
# every place a mule track can reach. A landing is then either
#  - a cove or beach whose jetty root that flood reaches (a stepped path), or
#  - the foot of a sea cliff below the reached ground, with a built switchback-free
#    stair climbing diagonally along the face to the top (plan_cliff_stair).
# The cheaper way is kept; the path is then re-checked with full walking contact.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_path_bake.jo'
use '../src/landing_access_types.jo'
use '../src/settlement_ports.jo'
use '../src/stairways.jo'
use '../src/landing_stairs.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
targets=[loop part in split(args()[1],","):to_int(part)!]
cell:f32=if args().len()>3:f32(to_int(args()[3])!) else:8.0
alternatives=if args().len()>4:to_int(args()[4])! else:0
ground=(x:f64,z:f64)->f64:place_ground(vec2(f32(x),f32(z)))

struct Climb:
    cost:f64
    cell:int                       # reached grid cell the landing joins
    join:vec3                      # where the path leaves the grid (root or stair top)
    root:vec3
    tip:vec3
    out:vec2
    stair:vec3[]                   # foot (root) to top, or [] for a plain path

# A jetty from root out to tip: deep water off its end, room for both moorings,
# and a deck that clears the ground all the way (as probe_island_shore checks).
jetty_clear=(root:vec3,tip:vec3,out:vec2)->bool:
    side=vec2(-out.y,out.x)
    loop sign in [-1.0,0.0,1.0]:
        if place_ground(tip.xz-out*12.0+side*f32(sign*18.0))> -3.0:return false
    deck_root=root+vec3(0,0.12,0);join=mix(deck_root,tip,0.45);join.y=tip.y
    loop quay in [PortQuay(deck_root,join,5.0,profile=true),PortQuay(join,tip,5.0)]:
        count=max(1,int(ceil(f64(length(quay.b-quay.a))*2)))
        loop k in 0..count+1:
            u=f32(k)/f32(count);at=mix(quay.a,quay.b,u)
            if place_ground(at.xz)>f64(port_deck(quay,u))+0.02:return false
    # The two berths attach_landing will look for, beside the pier.
    berth=(q:vec2)->bool:
        if place_ground(q)>= -2.0:return false
        loop k in 0..12:
            if place_ground(q+vec2(f32(cos(f64(k)*TAU/12.0)),f32(sin(f64(k)*TAU/12.0)))*6.0)> -0.3:return false
        true
    loop sign in [-1.0,1.0]:
        found=false
        loop back in [12.0,20.0,4.0,28.0]:
            loop lateral in [18.0,22.0,14.0,26.0]:
                if not found and berth(tip.xz-out*f32(back)+side*f32(sign*lateral)):found=true
        if not found:return false
    true

loop id in targets:
    s=world_settlements[settlement_by_id[id]]
    radius:f32=0;ic=vec2(0,0)
    loop island in small_islands:
        if island.id==(s.id-300001)/10:radius=max(island.radii.x,island.radii.y);ic=island.center
    if radius<=0:print("NO ISLAND {s.id} {s.name}");continue
    span=radius*1.6;nx=int(ceil(span*2/cell))+1;origin=ic-vec2(span,span)
    grid=(ix:int,iy:int)->vec3:place_point(origin+vec2(f32(ix),f32(iy))*cell)
    near_key=(p:vec2)->int:int(round((p.x-origin.x)/cell))+int(round((p.y-origin.y)/cell))*nx
    start=near_key(s.center.xz)
    pts:{int:vec3}={start:s.center};cost:{int:f64}={start:0.0};parent:{int:int}={start: -1};closed:{int:bool}
    queue:(f64,int)[]=[(0.0,start)]
    loop queue.len()>0 and closed.len()<2500000:
        item=queue.heap_pop();node=item.1
        if node in closed:continue
        closed[node]=true;p=pts[node]
        loop dy in -1..2:
            loop dx in -1..2:
                if dx==0 and dy==0:continue
                ix=node%nx+dx;iy=node/nx+dy
                if ix<0 or iy<0 or ix>=nx or iy>=nx:continue
                next=ix+iy*nx
                if next in closed:continue
                if not (next in pts):pts[next]=grid(ix,iy)
                q=pts[next]
                c=cost[node]+f64(length(q.xz-p.xz))+abs(f64(q.y-p.y))*3.0
                if c>=cost.get(next,1e30):continue
                if not stepped_segment_clear(p,q):continue
                cost[next]=c;parent[next]=node;queue.heap_push((c,next))
    eprint("CLIMB FLOOD {s.id} {s.name}: {closed.len()} cells reached")
    # Cheapest reached cell from which a stepped segment reaches p.
    joining=(p:vec3,reach:int)->(int,f64):
        best= -1;score=1e30;k0=near_key(p.xz)
        loop dy in -reach..reach+1:
            loop dx in -reach..reach+1:
                k=k0+dx+dy*nx
                if not (k in closed):continue
                q=pts[k];c=cost[k]+f64(length(q.xz-p.xz))+abs(f64(q.y-p.y))*3.0
                if c<score and stepped_segment_clear(q,p):best=k;score=c
        (best,score)
    climbs:Climb[]
    loop direction in 0..256:
        angle=f64(direction)*TAU/256.0;ray=vec2(cos(angle),sin(angle))
        # Outermost coast along this ray from the island's centre.
        last= -1.0;r=0.0
        loop r<f64(span):
            if place_ground(ic+ray*f32(r))>0.0:last=r
            r+=4.0
        if last<0:continue
        a=ic+ray*f32(last);b=a+ray*4.0
        loop k in 0..16:
            mid=(a+b)*0.5
            if place_ground(mid)>0.0:a=mid
            else:b=mid
        shore=(a+b)*0.5
        # Face the jetty down the local slope, not along the ray.
        gradient=vec2(f32(ground(f64(shore.x)+2,f64(shore.y)-6*f64(ray.y))-ground(f64(shore.x)-2,f64(shore.y)-6*f64(ray.y))),f32(ground(f64(shore.x)-6*f64(ray.x),f64(shore.y)+2)-ground(f64(shore.x)-6*f64(ray.x),f64(shore.y)-2)))
        out=if length(gradient)>0.01 and dot(-normalize(gradient),ray)>0.4: -normalize(gradient) else:ray
        side=vec2(-out.y,out.x)
        # A cove or beach: a gentle root a few metres up, reached by the flood.
        loop inset in [8.0,12.0,18.0,25.0,35.0,50.0]:
            root=place_point(shore-out*f32(inset))
            if root.y<2.0 or root.y>18.0:continue
            flat=true
            loop sign in [-1.0,1.0]:
                if abs(place_ground(root.xz+side*f32(sign*2.5))-f64(root.y))>0.8:flat=false
            if not flat:continue
            tip=vec3(0,0,0);ok=false
            loop reach in [60.0,90.0,110.0,140.0]:
                if ok:break
                tip=vec3(shore.x+out.x*f32(reach),1.2,shore.y+out.y*f32(reach))
                ok=jetty_clear(root,tip,out)
            if not ok:continue
            k,c=joining(root,2)
            if k>=0:climbs.push(Climb(c+f64(length(tip.xz-root.xz))*0.1,k,root,root,tip,out,[]));break
        # The foot of a sea cliff: a stair up the face beside the jetty.
        a=shore;b=shore-out*40.0
        if place_ground(b)<12.0:continue
        loop k in 0..16:
            mid=(a+b)*0.5
            if place_ground(mid)<2.0:a=mid
            else:b=mid
        foot=place_point(a)
        if foot.y<1.4 or foot.y>3.0:continue
        tip=vec3(0,0,0);ok=false
        loop reach in [40.0,60.0,90.0]:
            if ok:break
            tip=vec3(a.x+out.x*f32(reach),1.2,a.y+out.y*f32(reach))
            ok=jetty_clear(foot,tip,out)
        if not ok:continue
        # The lowest reached ground within 500 m is the height the stair aims for.
        rim=1e9;k0=near_key(foot.xz);w=int(500/cell)
        loop dy in -w..w+1:
            loop dx in -w..w+1:
                if k0+dx+dy*nx in closed:rim=min(rim,f64(pts[k0+dx+dy*nx].y))
        if rim>600:continue
        done=false
        loop lift in [0.0,6.0,12.0,20.0,30.0,45.0]:
            if done:break
            loop along in [side,-side]:
                if done:break
                stair=plan_cliff_stair(ground,foot,rim+lift,along,-out,20.0,900.0,f64(LANDING_STEP_WIDTH)*0.5-0.2)
                if stair.len()<2:continue
                top=stair[stair.len()-1]
                k,c=joining(top,2)
                if k<0:continue
                if not cliff_stair_clear(stair,f64(LANDING_STEP_WIDTH)):continue
                run=0.0
                loop j in 1..stair.len():run+=f64(length(stair[j]-stair[j-1]))
                climbs.push(Climb(c+run*1.5+f64(length(tip.xz-foot.xz))*0.1,k,top,foot,tip,out,stair));done=true
    climbs.sort((c:Climb):c.cost)
    eprint("CLIMB TRY {s.id} {s.name}: {climbs.len()} landings ({[loop c in climbs:if c.stair.len()>0:1].len()} cliff stairs)")
    written=false;roots:vec3[]
    loop option in climbs:
        if roots.len()>alternatives:break
        apart=true
        loop r in roots:
            if length(r.xz-option.root.xz)<1500:apart=false
        if not apart:continue
        coarse:vec3[];node=option.cell
        loop node>=0:coarse.push(pts[node]);node=parent[node]
        coarse.reverse();coarse.push(option.join)
        # Full walking contact on each stretch; straighten where it stays clear,
        # and search a fine local detour round anything the coarse grid missed.
        path=[coarse[0]];at=0;failed=false
        loop at<coarse.len()-1 and not failed:
            next= -1
            loop k in at+1..min(coarse.len(),at+40):
                if not access_segment_clear(coarse[at],coarse[k],true,true):break
                next=k
            if next>=0:path.push(coarse[next]);at=next;continue
            joined=false
            loop k in at+1..min(coarse.len(),at+5):
                detour=access_track(coarse[at].xz,coarse[k].xz,2.0,40.0,true,true,40000)
                if detour.len()>1:
                    loop q in detour[1..]:path.push(q)
                    path[path.len()-1]=coarse[k];at=k;joined=true;break
            if not joined:failed=true
        if failed:eprint("CLIMB REJECT {s.id} option cost={option.cost:.0f}: walking contact");continue
        path[0]=s.center
        stair_from= -1
        if option.stair.len()>0:
            stair_from=path.len()-1
            loop j in 1..option.stair.len():path.push(option.stair[option.stair.len()-1-j])
        landing=LandingAccess(option.root,option.tip,option.out,path,width=1.2,stepped=true,stair_from=stair_from)
        name=if roots.len()==0:"shore-{s.id}.txt" else:"shore-{s.id}-alt{roots.len()}.txt"
        assert(write_file(join_path(args()[2],name),to_text(landing)))
        roots.push(option.root)
        walk=0.0
        loop j in 1..path.len():walk+=f64(length(path[j]-path[j-1]))
        print("SURVEYED {name} {s.id} {s.name}: root={option.root} tip={option.tip} points={path.len()} walk={walk:.0f} m stair_points={option.stair.len()} stair_top={if option.stair.len()>0:option.stair[option.stair.len()-1].y else:0.0}; NOT INSTALLED")
        written=true
    if not written:print("FAILED {s.id} {s.name}: {climbs.len()} landings, none walkable")
