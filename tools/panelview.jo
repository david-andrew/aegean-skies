# The interface panels over a quiet sky, with made-up contents: sloppy tools/panelview.jo [board|ledger|talk|bubble]
use '../src/hud.jo'
use '../src/panels.jo'

window("Panels", 1280, 720)
_f = (b: u8[]) -> Font:
    f = load_font(b)
    if f is FontError: panic("font")
    f
fonts = Fonts(_f(embed("../assets/fonts/JosefinSans-SemiBold.ttf")), _f(embed("../assets/fonts/Limelight-Regular.ttf")))
which = if args().len() > 1: args()[1] else: (env("PANEL") ?? "board")
notices = [Notice(1, "Marta Galli", "Olive oil to Mikra", "Six barrels, the Mikra inn is out. Paid on delivery to Spiro at the dock.", 4800, "by dusk"),
    Notice(2, "Harbor office", "Mail to Agios Nikolaos", "One sealed sack for the monastery. Do not open.", 2200, "tomorrow 10:00"),
    Notice(3, "Ottavio Brun", "Engine parts from Porto Vecchio", "A crate of valves for my Heron, waiting at Lenzi's workshop.", 3500, "in two days", "Nikos Varda"),
    Notice(4, "Dario Fenn", "A passenger to Kalamos", "My daughter, and her trunk. She does not like to be kept waiting.", 3000, "this afternoon")]
rows = [GoodRow("Fish", "crate", 6, 4, 22, 0), GoodRow("Wine", "barrel", 14, 11, 8, 2), GoodRow("Olive oil", "barrel", 18, 15, 3, 0), GoodRow("Fuel", "tin", 5, 3, 40, 0), GoodRow("Machine parts", "crate", 31, 26, 1, 0)]
draw = ():
    clear(rgb(0.35, 0.6, 0.85))
    rect_gradient(0, 0, 1280, 720, rgba(0.15, 0.4, 0.8, 1), rgba(0.65, 0.82, 0.95, 1))
    match which:
        "board": notice_board(fonts, "Porto Vecchio", notices, ["The Heron of Ottavio Brun came in two hours late from Agios Nikolaos.", "Pirates took a cargo of wine off Mikra; nobody hurt."])
        "ledger": ledger(fonts, "Marta Galli", "merchant, Kalamos", rows, 120, 2, 8)
        "talk": conversation(fonts, "Spiro Laskaris", "innkeeper, Mikra", "You flew in from Porto? Then you didn't see Elena's Gull. She should have been back before the wind turned.", ["Any work going?", "What's the news?", "Goodbye."])
        _: speech_bubble(fonts, vec3(0, 0, 0), "Spiro Laskaris", "She should have been back before the wind turned.", 3.0)
