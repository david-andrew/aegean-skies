# Offline listening samples: no mixer, window or playback. Usage: sloppy tools/gunlab.jo DIR
use '../src/combat_sound.jo'
use '../src/combat.jo'
use '../src/flight.jo'

assert(args().len()==2,"give an existing output directory")
dir=args()[1]
loop choice in 0..4:
    spec=player_gun_spec(choice)
    reports=[loop variant in 0..GUN_VARIANTS:gun_report(spec.voice,variant)]
    # Spaced shots expose variation; a three-second held trigger demonstrates actual 60 Hz cadence.
    isolated=fill(f32(0),MIX_RATE*2*5)
    loop variant in 0..GUN_VARIANTS:
        offset=int(f64(variant)*0.6*f64(MIX_RATE))*2
        loop i in 0..reports[variant].samples.len():isolated[offset+i]+=reports[variant].samples[i]*0.7
    assert(save_wav(Sound(isolated),dir+"/"+PLAYER_GUN_NAMES[choice]+"-shots.wav"))
    burst=fill(f32(0),MIX_RATE*2*4)
    a=Combatant(1,1,0,craft_spec(.corsair,[]),CraftState(position=vec3(0,500,0)),external=true,human=true,
        pilot=CombatPilot(trigger=true),gun=CombatGun(locked=false,choice=choice))
    b=Battle(enabled=true,actors=[a]);r=rng(1928)
    loop tick in 0..180:
        step_battle(b,FlightEnv(),vec3(0,500,0))
        loop e in b.events:
            if e.kind!=.shot:continue
            s=reports[r.next_int(0,GUN_VARIANTS)];offset=int(f64(tick)/60.0*f64(MIX_RATE))*2
            loop i in 0..s.samples.len():burst[offset+i]+=s.samples[i]*0.7
    assert(save_wav(Sound(burst),dir+"/"+PLAYER_GUN_NAMES[choice]+"-burst.wav"))
    print("{PLAYER_GUN_NAMES[choice]}: {b.actors[0].gun.shots} rounds / 3 s")
