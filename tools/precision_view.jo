# Deterministic translated sea/geometry fixture. PRECISION_AT='x z'; PRECISION_MARKS=1
# isolates the actual sea-detail painter at a fixed metric footprint for image comparison.
use '../src/sea.jo'
use '../src/look.jo'
use '../src/objects.jo'
use '../src/render_space.jo'
use '../src/curved_world.jo'
window("Precision fixture",640,360)
init_sea()
init_curved_world()
sea_mesh = build_sea_mesh()
depth = texture(image(1,1))
expanded_depth = depth; nearby_depth = depth
at = vec3(0,0,0)
if let text = env("PRECISION_AT"):
    parts = text.split(" ")
    at = vec3(f32(to_float(parts[0]) ?? 0.0),0,f32(to_float(parts[1]) ?? 0.0))
marks = env("PRECISION_MARKS") != none
baseline_fleck = (p: vec2, smear: vec2, size: f32, seed: f32) -> f32:
    best: f32 = 0.0
    loop k in 0..2:
        q = (p - smear * f32(k)) / size
        cell = floor(q)
        r1 = hash21(cell + vec2(41.0 + seed, 7.0))
        if r1 >= 0.6:
            r2 = hash21(cell + vec2(3.0, 59.0 + seed))
            r3 = hash21(cell + vec2(17.0 + seed, 23.0))
            c = (cell + vec2(0.25, 0.25) + vec2(r2, r3) * 0.5) * size
            # (distance from the mark's center to the swept stretch)
            a = p - smear
            ab = smear
            t = clamp(dot(c - a, ab) / max(dot(ab, ab), 0.0001), 0.0, 1.0)
            d = length(c - (a + ab * t)) / size
            m = 1.0 - smoothstep(0.1, 0.17, d)
            v = if r1 > 0.82: m else: -m
            if abs(v) > abs(best): best = v
    best

# the sea's marks at three sizes, each shown only where it is a few pixels across or more
baseline_marks = (p: vec2, smear: vec2, dist: f32) -> f32:
    sizes: f32[3] = [1.3, 3.6, 10.0]
    acc: f32 = 0.0
    loop o in 0..3:
        size = sizes[o]
        vis = smoothstep(dist * 0.004, dist * 0.009, size)
        if vis > 0.0:
            m = baseline_fleck(p, smear, size, f32(o) * 13.0) * vis
            if abs(m) > abs(acc): acc = m
    acc


struct PrecisionOut:
    pos: vec4
    local: vec2
precision_vs = (v: FarSeaVertex,u: SeaParams) -> PrecisionOut:
    PrecisionOut(vec4(v.pos,0,1),v.pos*vec2(48,27)+(if u.expanded > 0.5: u.origin.xz else: vec2(0,0)))
precision_fs = (i: PrecisionOut,u: SeaParams) -> vec4:
    m = if u.expanded > 0.5: baseline_marks(i.local,vec2(0,0),0) else: sea_marks(i.local,vec2(0,0),0,u.wind.xy,u)
    vec4(vec3(0.5+m*0.5),1)
mark_shader = make_shader(shader(precision_vs,precision_fs))
# Float fixtures retain the same local centimetre geometry at each translation.
vertices: Vertex3D[]
add_box(vertices,vec3(0,0,0),vec3(4,0.08,4),vec4(1,0,0,1))
plate = custom_mesh(vertices)
draw = ():
    clear(BLACK); hide_sky()
    render_camera(at+vec3(0,20,0),vec3(0,-0.3,-1),62,0.1,300000)
    L = light_at(14)
    wind = Wind(vec2(0.8,0.6),6,vec2(0,0))
    draw_custom(():
        p = sea_params(depth,L,123.5,wind,vec3(0,0,0),SeaShadows())
        if marks:
            p.expanded = if env("PRECISION_BEFORE") != none: 1.0 else: 0.0
            # Metric grid centred on chart origin; same fractional pattern phase
            # for image-frequency comparisons, world cell identities stay distinct.
            draw(mark_shader,far_sea_tri,p)
        else:
            loop z in [-20.0,-100.0,-1000.0,-10000.0]:
                loop y in [-1.0,1.0]:
                    model = translation(at+vec3(f32(y*5.0),f32(y),f32(z)))
                    draw(obj_sh,plate,obj_params(L,123.5,model))
            draw_sea(sea_mesh,depth,L,123.5,wind)
    )
