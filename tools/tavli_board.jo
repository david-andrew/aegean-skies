# The tavli board on its own, for looking at and playing without the game: a staged position.
#   SLOPPY_SCREENSHOT=board.png SLOPPY_FRAMES=90 TAVLI_TURNS=14 sloppy --release tools/tavli_board.jo
# TAVLI_TURNS   turns played by two townsfolk first (0: the opening)
# TAVLI_PICK    1: the player has picked up a checker (its places to go shown)
# TAVLI_SEED    the dice's seed
# AEGEAN_TOUCH  1: drawn for a finger
use '../src/phoenix.jo'
use '../src/hud.jo'
use '../src/touch.jo'
use '../src/panels.jo'
use '../src/living_types.jo'
use '../src/tavli.jo'
use '../src/tavli_view.jo'

_font = (bytes: u8[]) -> Font:
    f = load_font(bytes)
    if f is FontError: panic("font: {f}")
    f

window("Tavli", 1280, 720)
screen_fit(.native)
fonts = Fonts(_font(embed("../assets/fonts/JosefinSans-SemiBold.ttf")), _font(embed("../assets/fonts/Limelight-Regular.ttf")))
pad.on = (env("AEGEAN_TOUCH") ?? "0") == "1"

turns = to_int(env("TAVLI_TURNS") ?? "14") ?? 14
game = TavliGame(opponent = 3, stake = 50)
game.rng = mix64(u64(to_int(env("TAVLI_SEED") ?? "7") ?? 7) * u64(2654435761))
game.style = TavliStyle(care = 0.3, boldness = 0.7, pace = 0.6, words = 1)
view = TavliView()
if turns > 0:
    tavli_opening(game)
    played = 0
    loop played < turns and game.phase != .done:
        if game.phase == .roll: tavli_throw(game)
        play = tavli_choose(game.board, game.turn, tavli_roll_dice(game.roll[0], game.roll[1]), TavliStyle(care = 0.8), game.rng xor u64(played))
        loop m in play.moves: _ = tavli_move(game, m)
        if game.turn == 1: view.last_theirs = play.moves
        tavli_pass(game)
        played += 1
    # the player's turn, the dice down
    if game.turn == 1:
        tavli_throw(game)
        play = tavli_choose(game.board, 1, tavli_roll_dice(game.roll[0], game.roll[1]), TavliStyle(care = 0.8), game.rng)
        loop m in play.moves: _ = tavli_move(game, m)
        view.last_theirs = play.moves
        tavli_pass(game)
    tavli_throw(game)
    loop k in 0..2:
        tb_throw_die(view.dice[k], 0, game.roll[k], f64(k) * 3.3 + 1.0)
        loop _ in 0..400: tb_dice_step(view.dice, 1.0 / 60.0)
    view.dice_side = 0
    view.said = "Off you go! Round again."; view.said_at = 0.0
    if (env("TAVLI_PICK") ?? "1") == "1":
        sources = tb_sources(game)
        best = sources[0]
        loop s in sources:
            if tb_targets(game, s).len() > tb_targets(game, best).len(): best = s
        view.selected = best
face = TavliFace("Yannis", "Yannis Petrou", "fisherman; plays fast and loose", tavli_stake_words(50), "You 2, Yannis 3", 4210)

last = ""
update = (dt: f64):
    global last
    now = "{game.phase} turn {game.turn} roll {game.roll} done {game.done.len()}/{game.duty.need} off {game.board.off} pips {tavli_pips(game.board, 0)}/{tavli_pips(game.board, 1)}"
    if env("TAVLI_LOG") != none and now != last:
        print("TAVLI frame {frame_number()}: {now}")
        last = now

draw = ():
    clear(rgba(0.18, 0.2, 0.22, 1))
    act = tavli_panel(fonts, game, view, face)
    if act.leave: quit()
