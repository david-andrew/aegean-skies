# CPU-only diagnosis of actual automatic aircraft claims/handling/funding; no forced success.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_claims.jo'
use '../src/living_charters.jo'
use '../src/living_portage.jo'
use '../src/living_travel.jo'
use '../src/living_save.jo'
w=build_world(u64(42)); states: {int: JobState}
minutes=to_int(env("AUDIT_MINUTES") ?? "10080") ?? 10080
loop _ in 0..minutes:
    step_minute(w)
    loop id,j in w.jobs:
        if j.delivery_mode!=.aircraft: continue
        if states.get(id,JobState.open)==j.state: continue
        states[id]=j.state
        eprint("JOB min={w.minute} id={id} {j.state} carrier={j.carrier} {j.origin}->{j.destination} loaded={j.loaded} collected={j.collected} why={if j.carrier>=0: w.people[j.carrier].action.failure_code else: ""} cargo={cargo_status(w,id)}")
    if w.minute%720!=0: continue
    eprint("SNAPSHOT {w.minute}")
    loop c in w.aircraft:
        p=w.people[c.owner]
        eprint("CRAFT {c.id} owner={p.name} place={c.place}/{p.place} trip={c.trip} dock={c.dock} fuel={c.fuel_ml} hp={c.hull}/{c.engine} cash={w.accounts[p.account].cents} fatigue={p.fatigue} action={p.action.activity}:{p.action.purpose} end={p.action.end_minute} why={p.action.failure_code} manifests={c.job_manifests}")
    loop id in w.active_jobs:
        j=w.jobs[id]
        if j.delivery_mode!=.aircraft or j.state!=.open: continue
        eligibility: str[]
        loop p in [2,8,11,21]:
            eligibility.push("{p}:feasible={claim_feasible(w,id,p)} charter={charter_feasible(w,id,p)} travel={travel_feasible(w,p,j.destination)}")
        eprint("OFFER {id} {j.origin}->{j.destination} fund={j.charter_payer} reserved={j.charter_reserved_milli} qty={j.quantity} state={cargo_status(w,id)} {eligibility}")
assert(validate_save_world(w)=="")
