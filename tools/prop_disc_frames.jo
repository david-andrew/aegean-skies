# Spinning propeller disc samples: one aircraft held level in the air, its engine at a set throttle.
# PROP_KIND=0..15 PROP_THROTTLE=0..1 PROP_VIEW=side|front|rear|far|cockpit PROP_HOUR=16.5
# PROP_SAVE=<dir> saves frames 30..44 (every second frame) to show the streaks' drift and redraws.
use '../src/flight.jo'
use '../src/flight_feedback.jo'
use '../src/planes.jo'
use '../src/damage.jo'
use '../src/prop_disc.jo'
use '../src/cockpit.jo'
use '../src/tweaks.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/sea.jo'
use '../src/curved_world.jo'
use '../src/world_point.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'

window("Propeller disc samples",1280,720)
enable_world_depth()
init_objects();init_sea();init_curved_world()
set_speed_scale(3.3);set_tweaks(Tweaks())
kind=Craft(clamp(to_int(env("PROP_KIND") ?? "0") ?? 0,0,15))
throttle=clamp(to_float(env("PROP_THROTTLE") ?? "1") ?? 1.0,0.0,1.0)
view=env("PROP_VIEW") ?? "side"
hour=to_float(env("PROP_HOUR") ?? "16.5") ?? 16.5
model=build_craft(kind,LIVERIES[clamp(to_int(env("PROP_LIVERY") ?? "0") ?? 0,0,LIVERIES.len()-1)])
k=craft_spec(kind,model.contacts);k.player=true
s=CraftState(position=vec3(0,120,0),velocity=vec3(0,0,-f32(k.stall_speed*3.3*1.4)),throttle=throttle,fuel=k.fuel_capacity,water_age=1.0)
s.precise=world_point(s.position);s.precise_ready=true;s.published=s.position
cockpit=build_cockpit()
img=image(2,2)
loop y in 0..2:
    loop x in 0..2: img.set(x,y,vec4(1,0,0,1))
depth=texture(img,true);init_expanded_depth(depth)
sea=build_sea_mesh()
prop=1.3;t=40.0
rpm=prop_rotation_speed(s,k.stall_speed*1.4)
hub=model.prop_hubs[0]

draw=():
    global prop,t
    t+=1.0/60.0;prop+=rpm/60.0
    L=light_at(hour)
    clear(vec4(L.sky_horizon,1));hide_sky()
    r=model.prop_radius
    if view=="cockpit":place_cockpit_camera(model,s,0,0,t)
    else:
        offset=if view=="front":vec3(r*2.6,r*0.9,-r*3.4) else:if view=="rear":vec3(r*1.6,r*1.2,r*4.5) else:if view=="far":vec3(k.span*1.3,k.span*0.35,-k.span*1.2) else:vec3(r*4.2,r*0.35,-r*0.4)
        precise_camera(craft_offset(s,hub+offset),-offset,48.0,0.1,18000.0)
    at=quat_to_mat4(s.orientation)
    draw_custom(():
        clear_world_depth()
        if view=="cockpit":draw_cockpit_airframe(model,s,translation(s.position)*at,L,t,prop,rpm)
        else:draw_craft_parts(model,s.damage,at,L,t,prop,anchor=craft_point(s),prop_speed=rpm)
        if view=="cockpit":draw_cockpit(cockpit,model,k,s,translation(s.position)*at,L,t,prop=prop,rpm=rpm)
    )
    draw_custom(():draw_sea(sea,depth,L,t,wind_now),transparent=true)
    draw_custom(():draw_prop_discs(L),transparent=true)
    text("{CRAFT_NAMES[int(kind)]}  {view}  throttle {throttle:.2}  shaft {rpm:.0} rad/s",vec2(24,20),22,WHITE)
    if let dir=env("PROP_SAVE"):
        n=frame_number()
        if n>=30 and n<=44 and n%2==0:save_png("{dir}/{n}.png",screenshot())
