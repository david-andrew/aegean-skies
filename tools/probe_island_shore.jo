# Isolated island communities need a landing, not the broad flat apron required
# by a full generated port. Survey narrow quays and dry paths on canonical terrain.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_path_bake.jo'
use '../src/landing_access_types.jo'
use '../src/settlement_ports.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
# Read-only survey: preserve the shipped landings and write each candidate to
# scratch. Width stays 5 m until quay contact/loading support another width.
# Usage: probe_island_shore.jo ID[,ID...] OUT [TRIES [MARGIN_M [NODES [stepped]]]]. With several IDs, OUT is a
# directory receiving shore-ID.txt per surveyed place; a failure is reported,
# never fatal, so one batch covers the whole hand-off list.
targets=[loop part in split(args()[1],","):to_int(part)!]
batch=targets.len()>1
tries=if args().len()>3:to_int(args()[3])! else:6
margin:f32=if args().len()>4:f32(to_int(args()[4])!) else:300.0
limit=if args().len()>5:to_int(args()[5])! else:180000
modes:bool[]=if args().len()>6 and args()[6]=="stepped":[true] else:[false,true]
surveyed=0
loop s in world_settlements:
    if not targets.contains(s.id):continue
    # A coastal sibling's harbour is not this community's access without a road;
    # batch surveys include those places, the single-place form keeps old behaviour.
    if not batch and s.id-1 in settlement_by_id:continue
    radius:f32=0
    loop island in small_islands:
        if island.id==(s.id-300001)/10:radius=max(island.radii.x,island.radii.y)
    if radius<=0:print("NO ISLAND {s.id} {s.name}");continue
    candidates:(f64,vec3,vec3,vec2)[]
    loop direction in 0..32:
        angle=f64(direction)*TAU/32.0;out=vec2(cos(angle),sin(angle))
        a=s.center.xz;b=a+out*radius*3.0
        if place_ground(b)> -3.0:continue
        loop k in 0..18:
            mid=(a+b)*0.5
            if place_ground(mid)>0.0:a=mid
            else:b=mid
        shore=(a+b)*0.5;side=vec2(-out.y,out.x)
        loop inset in [8.0,12.0,18.0,25.0,35.0,50.0]:
            root=place_point(shore-out*f32(inset))
            if root.y<2.0 or root.y>18.0:continue
            loop reach in [60.0,90.0,110.0,140.0]:
                tip=vec3(shore.x+out.x*f32(reach),1.2,shore.y+out.y*f32(reach))
                clear=true
                loop sign in [-1.0,0.0,1.0]:
                    if place_ground(tip.xz-out*12.0+side*f32(sign*18.0))> -3.0:clear=false
                    if abs(place_ground(root.xz+side*f32(sign*2.5))-f64(root.y))>0.8:clear=false
                # The pier must clear the whole shore profile, not just its
                # root. Low rises between root and water can bury a flat ramp.
                deck_root=root+vec3(0,0.12,0);join=mix(deck_root,tip,0.45);join.y=tip.y
                loop quay in [PortQuay(deck_root,join,5.0,profile=true),PortQuay(join,tip,5.0)]:
                    count=max(1,int(ceil(f64(length(quay.b-quay.a))*2)))
                    loop k in 0..count+1:
                        u=f32(k)/f32(count);at=mix(quay.a,quay.b,u)
                        if place_ground(at.xz)>f64(port_deck(quay,u))+0.02:clear=false;break
                if clear:
                    candidates.push((f64(length(root-s.center))+f64(root.y)*30.0+reach*0.1,root,tip,out));break
    candidates.sort((item:(f64,vec3,vec3,vec2)):item.0)
    path:vec3[];root=vec3(0,0,0);tip=root;out=vec2(0,0)
    eprint("SHORE TRY {s.id} {s.name}: {candidates.len()} possible landings")
    # Wagon-width track first; where the coast is a cliff, a stepped footpath.
    stepped=false
    loop mode in modes:
        loop k in 0..min(tries,candidates.len()):
            option=candidates[k]
            eprint("CANDIDATE {k} stepped={mode} root={option.1} tip={option.2}")
            path=access_track(s.center.xz,option.1.xz,4.0,margin,true,mode,limit)
            if path.len()>1:root=option.1;tip=option.2;out=option.3;break
        if path.len()>1:stepped=mode;break
    if path.len()<=1:
        print("FAILED {s.id} {s.name}: candidates={candidates.len()} tried={min(tries,candidates.len())} centre_y={s.center.y}")
        continue
    target_file=if batch:join_path(args()[2],"shore-{s.id}.txt") else:args()[2]
    assert(write_file(target_file,to_text(LandingAccess(root,tip,out,path,width=if stepped:1.2 else:1.8,stepped=stepped))))
    surveyed+=1
    print("SURVEYED {s.id} {s.name}: root={root} tip={tip} route_points={path.len()} stepped={stepped}; NOT INSTALLED")
if not batch:assert(surveyed==1,"no verified landing among bounded attempts")
