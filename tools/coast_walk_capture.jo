# Matched full-game walking frames, with existing scripted input and fixed-step
# screenshot controls. The same wrapper also compiles against the pinned main.
import '../aegean.jo' as game
use '../src/terrain_lod.jo'
use '../src/world_terrain.jo'
use '../src/coast_mesh.jo'
use '../src/coast_atlas.jo'
coast_game_draw: () -> void = game.draw
record_stats()
draw = ():
    coast_game_draw()
    frame = frame_number()+1
    if frame == 120 or frame == 600 or frame == 840:
        print("COAST_WALK frame={frame} terrain={terrain_triangles} world={world_triangles} detail={coast_triangles} domains={coast_instances}")
        print(frame_stats_line())
        print("COAST_WALK atlas_refreshes={coast_height_refreshes} selection_builds={coast_selection_builds}")
