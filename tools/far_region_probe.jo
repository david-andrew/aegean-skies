# Reproducible street/road cameras, with the real parcel and gate anchors.
use '../src/objects.jo'
use '../src/town_sites.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements(false)
loop s in world_settlements:
    if s.name not in ["Melavanissa","Zeryileia","Pheryalara","Thalvalissa"]:continue
    print("PLACE {s.name} country={s.country} at={s.center} out={s.out}")
    lots=place_lots(s);lots.sort((p: PlaceLot):length(p.local))
    loop k in 0..min(3,lots.len()):
        if let parcel=place_ground_lot(s,lots[k]):
            site=site_from_parcel(parcel)
            print("HOME {site.at} yaw={site.yaw} width={site.width} depth={site.depth} floors={site.floors}")
            if let yard=site_farm_yard(site):
                p=site_point(site,-site.width*0.2,yard.w+10)
                print("FARM_CAMERA {p.x} {p.y} {site.yaw}")
                gate=site_point(site,-site.width*0.2,yard.w)
                print("GATE {gate} height={walk_height([],f64(gate.x),f64(gate.y))}")

# Walk both real gate openings of every farm, through the same player contact
# solver used in the game. Raising boundary walls must not imprison residents.
use '../src/world_point.jo'
gates=0
loop s in world_settlements:
    if s.legacy>=0 or s.kind!=.farm:continue
    loop lot in place_lots(s):
        if let parcel=place_ground_lot(s,lot):
            site=site_from_parcel(parcel);yard=site_farm_yard(site)!
            loop z in [yard.y,yard.w]:
                a=site_point(site,-site.width*0.2,f64(z)-2)
                b=site_point(site,-site.width*0.2,f64(z)+2)
                p=WorldPoint(f64(a.x),walk_height([],f64(a.x),f64(a.y)),f64(a.y))
                reached=false
                loop k in 0..220:
                    delta=vec2(f32(f64(b.x)-p.x),f32(f64(b.y)-p.z))
                    if length(delta)<0.05:reached=true;break
                    p=walk_step_precise([],p,normalize(delta)*min(length(delta),f32(1.7/60)))
                if not reached:print("BLOCKED FARM {s.name} {a} -> {b} at {p}")
                assert(reached);gates+=1
print("FARM GATES WALKED {gates}")

import '../src/cargo_scene.jo' as navigation
routed=0;blocked=0
loop s in world_settlements:
    if s.legacy>=0 or s.kind!=.farm:continue
    loop lot in place_lots(s):
        if let parcel=place_ground_lot(s,lot):
            site=site_from_parcel(parcel);entry=site_entry(site)
            target=vec3(entry.outside.x,f32(walk_height([],entry.outside.x,entry.outside.y)),entry.outside.y)
            path=navigation.cargo_walk_path([],s.center,target)
            reached=path.len()>=2
            if reached:
                p=WorldPoint(f64(path[0].x),f64(path[0].y),f64(path[0].z))
                loop k in 1..path.len():
                    done=false
                    loop step in 0..int(ceil(f64(length(path[k].xz-world_vec(p).xz))/0.02))+30:
                        delta=vec2(f32(f64(path[k].x)-p.x),f32(f64(path[k].z)-p.z))
                        if length(delta)<0.05:done=true;break
                        p=walk_step_precise([],p,normalize(delta)*min(length(delta),0.02))
                    if not done:reached=false;break
            if reached:routed+=1
            else:blocked+=1;print("BLOCKED APPROACH {s.id} {s.name} path={path}")
print("FARM APPROACHES routed={routed} blocked={blocked}")
assert(blocked==0)
