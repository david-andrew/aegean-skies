# Every decal motif on one sheet, drawn flat from the same polygons the aircraft wears
# (src/decals.jo): for checking a motif's shape.
# Headless: SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 SLOPPY_FRAMES=2 SLOPPY_SCREENSHOT=out.png sloppy tools/decal_sheet.jo
use '../src/markings.jo'
use '../src/decals.jo'

window("Decal motifs", 1280, 720)

draw = ():
    clear(rgb(0.62, 0.66, 0.62))
    per = 8
    cw = 1280.0 / f64(per); ch = 140.0
    loop k in 0..DECAL_MOTIFS.len():
        m = DECAL_MOTIFS[k]
        x = f64(k % per) * cw; y = f64(k / per) * ch + 6.0
        d = Decal(motif = m.key, text = if m.key == "text": "K-AB3" else: "")
        polys = decal_polys(d.motif, d.text)
        wide = decal_half_width(d.motif, d.text)
        scale = min((cw - 24.0) * 0.5 / max(wide, 1.0), (ch - 46.0) * 0.5)
        c = vec2(f32(x + cw * 0.5), f32(y + (ch - 30.0) * 0.5))
        loop layer in 0..2:
            loop q in polys:
                if q.layer == layer: polygon([loop pt in q.pts: c + vec2(pt.x * f32(scale), -pt.y * f32(scale))], decal_colour(d, q.slot))
        text("{m.name} ({polys.len()})", vec2(f32(x + 8.0), f32(y + ch - 26.0)), 13, rgb(0.1, 0.12, 0.14))
