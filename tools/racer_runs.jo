# Take-off runs at full throttle (rudder holding the heading, the stick eased back once the true
# speed passes the stall) for every aircraft under the 3.3 pure scale: time, drawn distance,
# heading wander, and damage. RUNS_TRACE=id prints the S.6B-style trace for one aircraft.
import '../src/planes.jo' as planes
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
main = ():
    fl.set_speed_scale(3.3)
    trace = to_int(env("RUNS_TRACE") ?? "-1") ?? -1
    npc = (env("RUNS_NPC") ?? "0") == "1"
    t = tw.tweaks; t.torque_swing = (env("RUNS_SWING") ?? "1") == "1"; tw.set_tweaks(t)
    auto = npc or (env("RUNS_AUTO") ?? "0") == "1"
    loop id in 0..planes.CRAFT_NAMES.len():
        kind = planes.Craft(id)
        if trace >= 0 and id != trace: continue
        fl.set_speed_scale(if npc: 1.0 else: 3.3)
        m = planes.build_craft(kind, planes.LIVERIES[0])
        k = fl.craft_spec(kind, m.contacts); k.player = not npc
        e = fl.FlightEnv(); s = fl.water_start(k, vec3(0, 0, 0)); wander = 0.0
        plan = fl.FlightPlan()
        loop i in 0..60 * 120:
            h = fl.heading(s); wander = max(wander, abs(h))
            c = if auto: fl.autopilot(k, s, plan, e) else: fl.Controls(throttle = 1, yaw = clamp(-h * 4.0, -1.0, 1.0), pitch = if s.airspeed > k.stall_speed * fl.pure_k(k): 0.25 else: 0.0)
            fl.step(k, s, c, e, 1.0 / 60.0)
            if trace >= 0 and i % 30 == 0: print("t={s.time:.1} v={s.airspeed:.1} true={s.airspeed / fl.pure_k(k):.1} y={s.position.y:.2} pitch={asin(f64(fl.forward(s).y)):.3} water={s.on_water} plan={s.planing} dmg={s.hull_damage:.4} parts={[loop p in s.damage.parts: p.health]}")
            if not s.on_water and s.position.y > k.float_height + 3: break
        print("{planes.CRAFT_NAMES[id]}: {s.time:.1} s, {length(s.position.xz):.0} m, wander {wander:.3}, damage {s.hull_damage:.4}, stall {k.stall_speed:.0} m/s")
