# Detect inherited cart roads crossing new inland water without a walking deck.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/water_field.jo'
use '../src/objects.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
wet=0
loop link in catalog.links:
    if link.mode!=.cart:continue
    bad=0;first=vec3(0,0,0)
    loop k in 1..link.points.len():
        a=link.points[k-1];b=link.points[k]
        n=max(1,int(ceil(f64(length(b.xz-a.xz))/8.0)))
        loop j in 0..n:
            p=mix(a,b,f32(j)/f32(n));water=water_at(f64(p.x),f64(p.z))
            if not water.wet:continue
            if walk_height([],f64(p.x),f64(p.z))<water.level-0.3:
                if bad==0:first=p
                bad+=1
    if bad>0:
        wet+=1
        print("WET ROAD {link.id} {link.a}/{link.b} samples={bad} first={first} trail={link.trail}")
print("WATER ACCESS AUDIT submerged_roads={wet}")
