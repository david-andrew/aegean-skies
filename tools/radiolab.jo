# Offline acceptance/audition renderer. Never opens a window or plays audio.
# RADIO_SAMPLE_DIR=/absolute/scratch sloppy --release tools/radiolab.jo
# RADIO_COST_SECONDS=60 skips files and measures a fixed CPU-only synthesis workload.
use '../src/radio_synth.jo'
use '../src/sound.jo'

dir = env("RADIO_SAMPLE_DIR") ?? ""
seconds = to_float(env("RADIO_COST_SECONDS") ?? "12") ?? 12.0
names = ["foxtrot","tango","waltz","bouzouki","march","choir","morse"]
# Render from one synth at a time; no allocations proportional to world or programme length
# in the game. This offline tool explicitly assembles clips for save_wav only when requested.
loop style in 0..7:
    modes = if dir == "": 1 else: 3
    loop mode in 0..modes:
        s = make_radio_synth()
        radio_synth_program(s,RadioStyle(style),3,0,radio_morse("SEA FAIR"))
        samples: f32[]
        energy = 0.0; peak = 0.0; rendered = 0
        loop rendered < int(seconds*f64(RADIO_RATE)):
            chunk = radio_render(s,min(RADIO_BLOCK,int(seconds*f64(RADIO_RATE))-rendered),if mode == 2: 0.3 else: 1.0,if mode == 2: 6.0 else: 0.0,mode == 0 and dir != "")
            loop v in chunk:
                value = f64(v)
                energy += value*value; peak = max(peak,abs(value))
            if dir != "": samples += chunk
            rendered += chunk.len()
        rms = sqrt(energy/f64(max(1,rendered)))
        print("{names[style]} mode={mode} frames={rendered} peak={peak:.6} rms={rms:.6}")
        if dir == "": continue
        # Linear 16->48 kHz for the engine's stereo WAV writer; no audio device is used.
        stereo = fill(f32(0),samples.len()*6)
        loop i in 0..samples.len()*3:
            at = i/3; blend = f32(i%3)/3.0
            v = samples[at]*(1.0-blend)+samples[min(at+1,samples.len()-1)]*blend
            stereo[i*2] = v; stereo[i*2+1] = v
        label = if mode == 0: "dry" else: if mode == 1: "am" else: "weak"
        assert(save_wav(Sound(stereo),dir+"/runtime-"+names[style]+"-"+label+".wav"))
        # Representative fixed mix used in update_audio: idle volume .22; cruise .55.
        if style == 0 and mode == 1:
            engine = engine_loop()
            loop cruise in 0..2:
                combined = stereo
                pitch = if cruise == 0: 0.6 else: 1.35
                engine_gain = if cruise == 0: 0.22 else: 0.55
                radio_gain = 0.55*(if cruise == 0: 0.20 else: 0.10)
                loop i in 0..combined.len()/2:
                    e = engine.samples[(int(f64(i)*pitch)%MIX_RATE)*2]*f32(engine_gain)
                    v = combined[i*2]*f32(radio_gain)+e
                    combined[i*2] = v; combined[i*2+1] = v
                assert(save_wav(Sound(combined),dir+"/runtime-foxtrot-"+(if cruise == 0: "engine-idle" else: "engine-cruise")+".wav"))
