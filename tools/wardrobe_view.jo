# The town's clothes in two rows, for looking at them: every trade as src/wardrobe.jo dresses it
# (the back row in trousers, the front in skirts where the trade allows), then the hotel's staff and
# the band's evening clothes.
#   WV_CAM='x y z  tx ty tz' WV_HOUR=12 SLOPPY_SCREENSHOT=out.png SLOPPY_FRAMES=2 sloppy --release tools/wardrobe_view.jo
use '../src/look.jo'
use '../src/sky.jo'
use '../src/objects.jo'
use '../src/folk.jo'
use '../src/living_types.jo'
use '../src/wardrobe.jo'

window("Wardrobe", 1280, 720)
init_sky(); init_objects()
cam = [loop w in split(env("WV_CAM") ?? "", " "): if w != "": to_float(w) ?? 0.0]
hour = to_float(env("WV_HOUR") ?? "12") ?? 12.0
trades = [Occupation.fisher, Occupation.sailor, Occupation.merchant, Occupation.merchant, Occupation.clerk, Occupation.farmer, Occupation.mechanic, Occupation.priest, Occupation.patrol, Occupation.courier, Occupation.innkeeper, Occupation.nurse, Occupation.teacher, Occupation.hotelier]
cents = [3000, 3000, 3000, 20000, 6000, 2000, 4000, 4000, 4000, 4000, 9000, 4000, 4000, 22000]
back = [loop k in 0..trades.len(): build_outfit_figure(outfit_for(trades[k], 31 + k * 17, 38, false, cents[k]), 31 + k * 17, age = 38)]
front = [loop k in 0..trades.len(): build_outfit_figure(outfit_for(trades[k], 57 + k * 23, 34, true, cents[k]), 57 + k * 23, age = 34)]
extra = [build_outfit_figure(waiter_outfit(), 311, age = 34), build_outfit_figure(barkeep_outfit(), 77, age = 52), build_outfit_figure(errand_boy_outfit(), 905, age = 14), build_outfit_figure(evening_outfit(0, 911, true), 911, age = 31), build_outfit_figure(evening_outfit(1, 417, false), 417, age = 52), build_outfit_figure(evening_outfit(2, 233, false), 233, age = 40), build_outfit_figure(evening_outfit(3, 79, false), 79, age = 27), build_outfit_figure(outfit_for(Occupation.fisher, 5, 70, true, 2000), 5, age = 70), build_outfit_figure(outfit_for(Occupation.merchant, 6, 70, false, 2000), 6, age = 70)]
floor_m = custom_mesh(():
    vs: Vertex3D[]
    add_box(vs, vec3(0, -0.5, 0), vec3(40, 1, 12), rgb(0.62, 0.58, 0.5))
    vs
())
t = 0.0
update = (dt: f64): t += dt
draw = ():
    L = light_at(hour)
    clear(BLACK)
    hide_sky()
    eye = if cam.len() == 6: vec3(f32(cam[0]), f32(cam[1]), f32(cam[2])) else: vec3(0, 2.4, 13)
    look = if cam.len() == 6: vec3(f32(cam[3]), f32(cam[4]), f32(cam[5])) else: vec3(0, 1.0, 0)
    camera3d(eye, look, 50.0, 0.1, 5000.0)
    draw_custom((): draw_sky(L, t))
    draw_custom(():
        draw(obj_sh, floor_m, obj_params(L, t))
        loop k in 0..back.len(): draw_figure(back[k], vec3(f32(-9.1 + f64(k) * 1.4), 0, -1.6), PI, 0.0, 0.0, L, t)
        loop k in 0..front.len(): draw_figure(front[k], vec3(f32(-9.1 + f64(k) * 1.4), 0, 0.4), PI, 0.0, 0.0, L, t)
        loop k in 0..extra.len(): draw_figure(extra[k], vec3(f32(-5.6 + f64(k) * 1.4), 0, 2.4), PI, 0.0, 0.0, L, t)
    )
