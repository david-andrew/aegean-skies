use '../src/world_towns.jo'
use '../src/world.jo'
use '../src/objects.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/town_architecture.jo'
use '../src/town_sites.jo'
use '../src/quality.jo'
draw_bound = ():
    count=0; vertices=0; draws=0
    loop k in 0..close_town_buffers.len():
        count+=close_town_buffers[k].count
        vertices+=close_town_buffers[k].count*close_town_meshes[k].count
        if close_town_buffers[k].count>0: draws+=1
    print("DRAW close instances={count} vertices={vertices} draws={draws}")
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
towns=[loop s in SETTLEMENTS: build_town(s)]
init_world_towns(towns)
assert(close_town_meshes.len()==0)
cam=towns[0].center+vec3(0,111,0)
prepare_close_town(towns,cam)
assert(close_town_meshes.len()==0)
print("AERIAL close kit remains unallocated")
finish_settlement_registry()
loop tier in [0,1,2]:
    render_quality=quality_profile(tier)
    world_town_density=1.0
    detail=build_legacy_town_detail(towns[0],0)
    prepare_close_town(towns,vec3(494.60004,4.07782,-6315.229))
    assert(close_town_sites<=close_site_limit())
    print("BOUNDS Porto tier={tier} sites={close_town_sites} instances={close_town_instances} near_path={close_town_paths.count} town_paths={detail.paths.len()}")
    draw_bound()
    count=0
    loop s in towns[0].sites:
        if site_roof_entry(s,towns[0].sites)!=none: count+=1
    print("ROOFS {count}")
    index=settlement_by_id[10001]
    world_town_slots=[build_town_district(index,-1,0,1.0),build_town_district(index,0,0,1.0)]
    close_town_last=vec3(1e9,1e9,1e9)
    prepare_close_town(towns,vec3(-117992.75,10.65167,-84877.086))
    assert(close_town_sites<=close_site_limit())
    print("BOUNDS Kalyrassa tier={tier} sites={close_town_sites} instances={close_town_instances} near_path={close_town_paths.count}")
    draw_bound()
    world_town_slots=[]
vertices=0
loop mesh in close_town_meshes: vertices+=mesh.count
print("SHARED meshes={close_town_meshes.len()} vertices={vertices}")

loop tw in towns:
    roofs=0
    loop s in tw.sites:
        if let roof=site_roof_entry(s,tw.sites):
            roofs+=1
            print("ROOF at={s.at} bottom={roof.outside} top={roof.front}")
    print("ROOFS {tw.name} {roofs}")

# Audit actual courtyard placement, not just the existence of a prop mesh.
loop tw in towns:
    lists: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
    props: Instance3D[][]=[loop k in 0..18: []]
    paths: Vertex3D[]
    loop s in tw.sites: arch_courtyard(lists,props,paths,s,tw.sites)
    print("COURTS {tw.name}: ovens={lists[8].len()} donkeys={lists[12].len()} pergolas={props[2].len()} nets={props[5].len()}")
    loop kind in [8,12]:
        if lists[kind].len()>0: print("COURT kind={kind} at={transform_point(lists[kind][0].model,vec3(0,0,0))}")
loop pair in [("oven",vec2(432,-6322)),("donkey-front",vec2(585.8,-6444))]:
    print("CAPTURE {pair.0} {pair.1.x} {place_ground(pair.1)+1.8} {pair.1.y}")
