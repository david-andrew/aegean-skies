# Actual full-registry opening proof, before any month-long acceptance replay.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_far_types.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_economy.jo'
use '../src/living_fields.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
use '../src/living_guard.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true; init_settlements(); finish_settlement_registry()
w=build_world(u64(42)); publish_settlement_life(w)
assert(configure_far_economy(w) and configure_far_harbors(w))
assert(validate_save_world(w)=="",validate_save_world(w))
plots=0; standing=0; area=0
loop _, d in w.far.districts:
    plots+=d.fields.len()
    loop field in d.fields:
        if let crop=field.crop:
            standing+=1; area+=crop.area_ares
            assert(crop.opening and crop.sown_day<0 and crop.harvested_milli==0)
loop place in [10001,10003]:
    views=household_field_views(w,place)
    eprint("FIELD_OPENING_CAPITAL place={place} crops={[loop v in views: if v.stage=="growing": (v.id,v.planted_ares,v.ready_day)]}")
    assert([loop v in views: if v.stage=="growing": v].len()>0)
assert(w.far.field_grain_harvested==0 and w.far.household_consumed[3]==0)
eprint("FIELD_OPENING plots={plots} standing={standing} hectares={f64(area)/100.0:.2} real_seed_milli={w.far.field_seed_sown} paid_labor_cents={w.far.field_labor_paid}")
set_living_strict(false)
loop _ in 0..60: step_minute(w); assert(living_faults().len()==0)
assert(validate_save_world(w)=="",validate_save_world(w))
assert(w.far.field_grain_harvested==0)
eprint("FIELD_OPENING_AUDIT_OK minute={w.minute} hash={canonical_hash(w)}")
