# Audit real coastal frontage/street triangles against the fixed contact field.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/settlements.jo'
use '../src/world_towns.jo'
use '../src/town_details.jo'
use '../src/town_architecture.jo'
use '../src/town_sites.jo'

paving_clearance = (name: str,vs: Vertex3D[]) -> f64:
    worst = 1e9; buried = 0; probes = 0
    loop k in 0..vs.len()/3:
        a = vs[k*3]; b = vs[k*3+1]; c = vs[k*3+2]
        if a.normal.y < 0.25: continue
        loop j in 0..9:
            loop i in 0..9-j:
                u = f32(i)/8.0; v = f32(j)/8.0
                p = a.pos+(b.pos-a.pos)*u+(c.pos-a.pos)*v
                gap = f64(p.y)-place_ground(p.xz)
                worst = min(worst,gap)
                if gap < -0.005: buried += 1
                probes += 1
    print("PAVING {name}: triangles={vs.len()/3} samples={probes} buried={buried} minimum_clearance={worst} m")
    worst

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_settlements()
worst = 1e9
loop index in [0,1]:
    town = build_town(SETTLEMENTS[index])
    detail = build_legacy_town_detail(town,index)
    worst = min(worst,paving_clearance(SETTLEMENTS[index].name,detail.paths))
    # Main's close scenery also makes frontage, side passages and courtyards.
    paths: Vertex3D[]
    lists: Instance3D[][] = [loop k in 0..ARCH_COUNT: []]
    props: Instance3D[][] = [loop k in 0..TOWN_PROP_COUNT: []]
    loop s in town.sites:
        a = site_point(s,-s.width*0.5-1.4,s.depth*0.5+2.5)
        b = site_point(s,s.width*0.5+1.4,s.depth*0.5+2.5)
        town_path(paths,a,b,3.5,true)
        arch_side_lanes(lists,paths,s,town.sites,true)
        arch_courtyard(lists,props,paths,s,town.sites)
    worst = min(worst,paving_clearance(SETTLEMENTS[index].name+" close alleys",paths))
loop s in world_settlements:
    if s.name != "Pheryalara" and s.name != "Thalvalissa": continue
    vs: Vertex3D[]
    loop street in place_streets(s,0,0): town_path(vs,street.a,street.b,street.width,street.paved)
    worst = min(worst,paving_clearance(s.name,vs))
print("PAVING worst {worst} m")
if (env("COAST_PAVING_ASSERT") ?? "0") == "1": assert(worst >= -0.005)
