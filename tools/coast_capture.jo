use '../src/depth_space.jo'
# Fixed coast views for before/after captures; silent/headless environment required.
# COAST_RANGE=2000|300|50|2, COAST_SITE=legacy|new|beach|harbor.
# COAST_MOTION translates the view in metres/second; COAST_ALTITUDE overrides
# its height for low-pass traces. COAST_WARMUP holds the initial pose first.
build:
    js = "../src/web_compat.js"
use '../src/world_terrain.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/terrain.jo'
use '../src/terrain_lod.jo'
use '../src/quality.jo'
use '../src/render_space.jo'
use '../src/look.jo'
use '../src/coast_mesh.jo'
use '../src/coast_atlas.jo'
use '../src/sea.jo'
use '../src/sky.jo'

window("Coast reference",1280,720)
record_stats()
init_quality()
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
load_terrain(embed('../assets/terrain_lod.bin'))
enable_world_depth()
init_terrain(); init_world_terrain(); init_sea(); init_sky()
depth = build_depth_texture()
water = build_sea_mesh()
site = env("COAST_SITE") ?? "legacy"
range = to_float(env("COAST_RANGE") ?? "50") ?? 50.0
coast,out = coast_point(1,1.15)
if site == "harbor": coast,out = coast_point(6,0.9)
if site == "beach":
    coast,out = coast_point(4,0.7)
    loop height(f64(coast.x),f64(coast.y)) < 0.0: coast -= out

if site == "new":
    # Frozen from the baseline's canonical coast search, not the refined query.
    coast = vec2(13170,-37000)
    out = vec2(1,0)
eye = vec3(coast.x+out.x*f32(range),f32(max(1.7,range*0.42)),coast.y+out.y*f32(range))
target = vec3(coast.x,0,coast.y)
if site == "beach" and range == 2.0:
    p = coast-out*2.0
    loop height(f64(p.x),f64(p.y)) < 1.25: p -= out
    eye = vec3(p.x,f32(max(height(f64(p.x),f64(p.y)),0.0)+1.7),p.y)
    target = vec3(coast.x-out.y*20.0,0.0,coast.y+out.x*20.0)
if let altitude = env("COAST_ALTITUDE"): eye.y = f32(to_float(altitude) ?? f64(eye.y))
warmup = to_int(env("COAST_WARMUP") ?? "0") ?? 0
print("COAST site={site} range={range} eye={eye} target={target}")
motion = to_float(env("COAST_MOTION") ?? "0") ?? 0.0
frame = 0
update = (dt: f64):
    global frame
    frame += 1
draw = ():
    clear(BLACK); hide_sky()
    shift = vec3(-out.y,0,out.x)*f32(motion*f64(max(0,frame-warmup))/60.0)
    camera3d(eye+shift,target+shift,62.0,0.1,world_far(f64(eye.y)))
    L = light_at(14.0)
    t = 12.0
    draw_custom(():
        clear_world_depth()
        draw_sky(L,t)
        draw_far_sea(depth,L,t,wind_now)
        draw_ground(L,t+f64(frame)/60.0)
        draw_world_terrain(L,t+f64(frame)/60.0)
        if frame == 120 or frame == 600 or frame == 840:
            print("COAST terrain={terrain_triangles} world={world_triangles} detail={coast_triangles} domains={coast_instances} draws={terrain_draws+world_draws+coast_draws}")
            print(frame_stats_line())
            print("COAST atlas_refreshes={coast_height_refreshes} selection_builds={coast_selection_builds}")
    )
    draw_custom((): draw_sea(water,depth,L,t,wind_now),transparent=true)
