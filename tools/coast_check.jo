# CPU execution of GPU helpers uses Sloppy's software texture backend. This
# checks texture decoding/interpolation and the sea's actual shared-edge path.
use '../src/coast_pattern.jo'
use '../src/coast_field.jo'
use '../src/coast_mesh.jo'
use '../src/world.jo'
use '../src/terrain_lod.jo'
use '../src/geography.jo'

assert((env("SLOPPY_SOFTWARE") ?? "0") == "1")
init_coast_mesh()
worst = 0.0
loop k in 0..1000:
    p = vec2(f32(k)*-243.731,f32(k%97)*217.39)
    worst = max(worst,f64(length(coast_pattern_at(p)-coast_pattern_gpu(coast_pattern_texture,p))))
assert(worst < 0.000002)
print("pattern CPU/texture maximum {worst}")

# GPU parent interpolation skips zero-weight samples but must preserve morphs.
worst = 0.0
loop level in [0.0,1.25,3.1,5.6,6.0]:
    inst = CoastInstance(vec2(0,0),vec2(-5012.125,-2436.25),vec2(0,0),vec4(-12,3,-3,7),f32(level),vec4(0.5,2.35,1.1,f32(level)))
    loop j in 0..65:
        loop i in 0..65:
            p = vec2(f32(i)/64.0,f32(j)/64.0)
            cpu = coast_mesh_height(inst,p)
            gpu = coast_gpu_height(inst,p,coast_pattern_texture)
            worst = max(worst,f64(abs(cpu-gpu)))
print("CPU/texture morphed mesh maximum {worst} m")
assert(worst < 0.00002)
