# CPU execution of GPU helpers uses Sloppy's software texture backend. This
# checks texture decoding/interpolation and the sea's actual shared-edge path.
use '../src/coast_pattern.jo'
use '../src/coast_field.jo'
use '../src/coast_mesh.jo'
use '../src/coast_water.jo'
use '../src/world.jo'
use '../src/terrain_lod.jo'
use '../src/geography.jo'

assert((env("SLOPPY_SOFTWARE") ?? "0") == "1")
init_coast_mesh()
worst = 0.0
loop k in 0..1000:
    p = vec2(f32(k)*-243.731,f32(k%97)*217.39)
    worst = max(worst,f64(length(coast_pattern_at(p)-coast_pattern_gpu(coast_pattern_texture,p))))
assert(worst < 0.000002)
print("pattern CPU/texture maximum {worst}")

# A steep analytic cliff crosses the sea and spans several neighboring cells.
# It makes wrong diagonals, clamped dry texels and unconstrained edges visible.
img = image(6,6)
loop j in 0..6:
    loop i in 0..6:
        let h = -35.0+f64(i)*12.0+f64(j)*8.0
        packed = int(round((h+64.0)*4096.0))
        a = (j*6+i)*4
        img.pixels[a] = u8(packed & 255)
        img.pixels[a+1] = u8((packed>>8)&255)
        img.pixels[a+2] = u8((packed>>16)&255)
        img.pixels[a+3] = 255
tex = texture(img,false)
origin = vec2(-5012,-2436)
area = vec4(origin.x-14.0,origin.y-14.0,6,6)
h = vec4(-15,-3,-7,5)
worst = 0.0
loop range in [2.0,50.0,100.0,300.0,2000.0]:
    cam = vec3(origin.x+f32(range),2,origin.y+7)
    level = f32(coast_level(f64(origin.x),f64(origin.y),-15,5,cam,600))
    bound = vec4(-40,192,-40,192)
    edges = min(vec4(level,level,level,level),vec4(coast_water_level(origin-vec2(14,0),bound,cam,600),coast_water_level(origin+vec2(14,0),bound,cam,600),coast_water_level(origin-vec2(0,14),bound,cam,600),coast_water_level(origin+vec2(0,14),bound,cam,600)))
    inst = CoastInstance(vec2(0,0),origin,vec2(1,1),h,level,edges)
    n = pow(2.0,ceil(f64(level)))
    loop k in 0..300:
        # Recover fractional cell position from the actual f32 sea coordinate.
        p = origin+vec2(f32(k%29)/29.0,f32(k%31)/31.0)*14.0
        f = (p-origin)/14.0
        a = min(floor(f*f32(n)),vec2(f32(n-1.0),f32(n-1.0)))/f32(n)
        s = f32(1.0/n)
        heights = vec4(coast_mesh_height(inst,a),coast_mesh_height(inst,a+vec2(s,0)),coast_mesh_height(inst,a+vec2(0,s)),coast_mesh_height(inst,a+vec2(s,s)))
        mesh_y = coast_triangle(heights,(f-a)*f32(n))
        sea_y = coast_water_height(tex,area,p,cam,600,coast_pattern_texture)
        chart = floor(cam.xz/1024.0)*1024.0
        shifted = coast_water_height(tex,area-vec4(chart.x,chart.y,0,0),p-chart,cam-vec3(chart.x,0,chart.y),600,coast_pattern_texture,chart-floor(chart/112.0)*112.0)
        assert(abs(shifted-sea_y) < 0.00001)
        worst = max(worst,f64(abs(mesh_y-sea_y)))
assert(worst < 0.001)
print("sea/mesh maximum {worst} m through contact, mixed edges and distance morphs")

assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
cam = vec3(220000,2,-72000)
loop frame in 0..16:
    update_coast_water(cam,600)
    assert(not coast_water_valid)
update_coast_water(cam,600)
assert(coast_water_valid and coast_water_row == -1)
ready = coast_water_area
loop frame in 0..16:
    update_coast_water(cam+vec3(448,0,0),600)
    assert(coast_water_area == ready)
update_coast_water(cam+vec3(448,0,0),600)
assert(coast_water_area != ready)
print("new-coast depth publishes 65-square atlas atomically, four rows/frame")
