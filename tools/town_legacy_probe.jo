# CPU geometry fingerprint for the original six. Compare this output with a
# pinned baseline built with the same toolchain and baked terrain.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/town_architecture.jo'
use '../src/town_details.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
loop settlement in SETTLEMENTS:
    town=build_town(settlement)
    parts: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
    props: Instance3D[][]=[loop k in 0..TOWN_PROP_COUNT: []]
    paths: Vertex3D[]
    loop site in town.sites:
        arch_site(parts,props,site,true)
        arch_side_lanes(parts,paths,site,town.sites,true)
        arch_courtyard(parts,props,paths,site,town.sites)
    # New regional kinds are unused on the original islands.
    loop k in 18..props.len():assert(props[k].len()==0)
    loop k in 18..parts.len():assert(parts[k].len()==0)
    print("{town.name}: {hash(parts[0..18])} {hash(props[0..18])} {hash(paths)}")
