build:
    name = "Aegean far opening bake"
# Bake the far economy's opening for the start's world, begun as the title begins it
# (title_open_world), into assets/baked/far-opening-v1.bin (the World after it, Sloppy's binary
# form, deflated) and far-opening-v1.key (the key of the World it began from); then read the bake
# back as the game does and check it gives the opening made here. Run after tools/bake.jo, and
# again whenever the far economy's opening or the start's world changes (docs/common.md):
#   AEGEAN_TITLE=1 SLOPPY_SOFTWARE=1 SLOPPY_NO_AUDIO=1 SLOPPY_FRAMES=1 SLOPPY_SCREENSHOT=/tmp/far-bake.png sloppy --release tools/bake_far_opening.jo
import '../aegean.jo' as game
use '../src/far_scene.jo'
use '../src/living_save.jo'

assert(env("AEGEAN_TITLE") == "1", "run with AEGEAN_TITLE=1: the opening is baked as the title begins it")
began = time()
far_bake_stage = 3                  # (made here, never taken from an older bake)
game.title_open_world()
assert(far_opening_pending(), "the title began no far opening (already populated, or no catalogue)")
before = far_opening_kept
key = far_opening_key(before)
loop not far_opening_advance(1.0e30): pass
after = far_opening_take()
assert(after.far.populated, "the opening made no far economy")
made = canonical_hash(after)
packed = deflate(to_bytes(after))
dir = join_path(dir_name(args()[0]), "../assets/baked/")
if not write_bytes(dir + FAR_OPENING_BAKE + ".bin", packed): panic("cannot write {dir}{FAR_OPENING_BAKE}.bin")
if not write_file(dir + FAR_OPENING_BAKE + ".key", "{key}"): panic("cannot write {dir}{FAR_OPENING_BAKE}.key")
# (read back as the game does: inflate, from_bytes, the roads published; the same World)
inflated = inflate(packed)
assert(inflated != none, "the bake does not inflate")
read = far_bake_read(inflated!)
assert(read != none, "the bake does not read back")
assert(canonical_hash(read!) == made, "the bake reads back as another World")
print("far opening: {packed.len() / 1024} KB ({to_bytes(after).len() / 1024} KB inflated), key {key}, in {(time() - began) * 1000.0:.0} ms -> {dir}{FAR_OPENING_BAKE}.bin")
exit(0)
