# Install one surveyed shore approach, preserving every previously verified landing.
# Sea-service baking and physical quay checks must pass before committing it.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_path_bake.jo'
use '../src/shore_access_data.jo'
use '../src/landing_access_types.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
id=to_int(args()[1])!;assert(id in settlement_by_id and not (id in SHORE_LANDINGS))
s=world_settlements[settlement_by_id[id]];assert(s.harbor.len()==0)
text=read_file(args()[2]);assert(text is str)
landing=from_text[LandingAccess](text);assert(landing is LandingAccess)
assert(landing.route.len()>1 and length(landing.route[0]-s.center)<0.01)
assert(length(landing.route[landing.route.len()-1]-landing.root)<0.01)
loop k in 1..landing.route.len():assert(access_segment_clear(landing.route[k-1],landing.route[k],true,landing.stepped))
items=SHORE_LANDINGS;items[id]=landing;ids=items.keys();ids.sort()
source="# Offline surveyed island landings.\nuse 'landing_access_types.jo'\nSHORE_LANDINGS:{{int:LandingAccess}}={{\n"
loop key in ids:source+="    {key}:{to_text(items[key])},\n"
source+="}\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/shore_access_data.jo'),source))
print("LANDING INSTALLED {id}: {landing.route.len()} approach points; sea service still required")
