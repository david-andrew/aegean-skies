# The land's outline drawn on the screen (src/silhouette.jo), checked on a far wooded slope.
# The ground is drawn by the game's own shaders with the outline's two passes run as the game
# runs them (src/cloud_transparency.jo draw_cloud_layer), four times: from one eye with the
# outline off and on, and the same from an eye six metres to the side. Then:
# - the outline is there: at least MIN_PIXELS pixels differ between off and on;
# - it is only crowns on a line: no column has a run of changed pixels taller than a crown can
#   be drawn (SILHOUETTE_REACH and its soft top), and no more than a fiftieth of the picture
#   changes;
# - it is steady: the crowns are fixed to the land, and six metres to the side moves a ridge
#   kilometres off by less than a pixel, so column by column the crowns against the sky stand
#   about as high from the one eye as from the other: the two profiles' correlation may be no
#   less than STEADY (0.81 on a GPU as written). This catches crowns that are not the same from
#   one picture to the next; it does not catch slow crawling. A pattern that also went by the
#   land's point along the eye's ray, which the depth of a line seen edge-on gives only roughly,
#   scored 0.72 here and crawled in flight: the measure of that is the glides' stepped pixels
#   (the round's report), not this check.
# Headless on a GPU (SLOPPY_SCREENSHOT set): under SLOPPY_SOFTWARE=1 the outline's passes draw
# nothing (the lines are found; no crown reaches the picture), so this is not in CI
# (tools/ci_test_shard.py GPU_ONLY). AEGEAN_OUTLINE_OUT=dir: the four pictures saved there.
use '../src/geography.jo'
use '../src/world.jo'
use '../src/world_terrain.jo'
use '../src/terrain_lod.jo'
use '../src/terrain.jo'
use '../src/render_space.jo'
use '../src/look.jo'
use '../src/coast_field.jo'
use '../src/crowns.jo'
use '../src/cloud_transparency.jo'
use '../src/silhouette.jo'

const W = 640
const H = 360
const MIN_PIXELS = 150
const STEADY = 0.6
window("Outline check",W,H)
assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_world_terrain()
world_generate_seconds = 2.0
# (the ground and the canopy's sheet, without its domes: their crowns sway from one picture to the next)
foliage_off_list = "billows"
out_dir = env("AEGEAN_OUTLINE_OUT") ?? ""

# (the far wooded slope of the canopy's samples, and six metres along the slope from it)
eyes: vec3[] = [vec3(-119500,800,-135000),vec3(-119500,800,-135006)]
yaw: f32 = -1.5708; pitch: f32 = 0.1
forward = vec3(-sin(yaw)*cos(pitch),sin(pitch),-cos(yaw)*cos(pitch))
shots: Image[] = []
step = 0
update = (dt: f64):
    return

draw = ():
    global step,silhouette_off
    eye = eyes[step/2]
    # (the tiles made and settled before the picture is drawn)
    vp = perspective(62.0*PI/180.0,f32(W)/f32(H),0.3,world_far(f64(eye.y)))*look_at(eye,eye+forward,vec3(0,1,0))
    loop k in 0..150: prepare_world_terrain(eye,vp,f64(step)*10.0+f64(k)/60.0)
    silhouette_off = step%2 == 0
    L = light_at(10.0)
    clear(BLACK)
    sun(L.sun_dir,L.sun,0.0)
    hide_sky()
    fog(L.haze,L.fog_density,0.0012)
    post_effects(0.0,1.0,0.0,1.0,scene_depth = true)
    camera3d(eye,eye+forward,62.0,0.3,world_far(f64(eye.y)))
    # (one moment for all four: the wind's sway of the near canopy is not the outline's doing)
    draw_custom((): draw_world_terrain(L,100.0))
    draw_cloud_layer([],L)
    img = screenshot()
    shots.push(img)
    if out_dir != "": _ = save_png("{out_dir}/outline-{step}.png",img)
    if env("AEGEAN_OUTLINE_DEBUG") != none: print("OUTLINE DEBUG step {step}: lines found {silhouette_ready}, scene depth {scene_depth().id != 0}")
    step += 1
    if step < 4: return
    # (how far two pictures differ at a pixel: the largest of its three colours' differences)
    differ = (a: Image,b: Image,k: int) -> int: max(max(abs(int(a.pixels[k*4])-int(b.pixels[k*4])),abs(int(a.pixels[k*4+1])-int(b.pixels[k*4+1]))),abs(int(a.pixels[k*4+2])-int(b.pixels[k*4+2])))
    outline = 0; tallest = 0
    # (the first pixel down a column that is not the cleared sky)
    top = (img: Image,x: int) -> int:
        loop y in 0..H:
            k = (y*W+x)*4
            if int(img.pixels[k])+int(img.pixels[k+1])+int(img.pixels[k+2]) > 24: return y
        H
    # (how high the crowns stand over the land's line against the sky in each column, from each eye)
    one: f64[] = []; other: f64[] = []
    loop x in 0..W:
        run = 0
        loop y in 0..H:
            if differ(shots[0],shots[1],y*W+x) > 8:
                outline += 1; run += 1; tallest = max(tallest,run)
            else: run = 0
        a = top(shots[0],x)-top(shots[1],x); b = top(shots[2],x)-top(shots[3],x)
        if a+b > 0: one.push(f64(a)); other.push(f64(b))
    n = f64(max(one.len(),1))
    ma = 0.0; mb = 0.0
    loop k in 0..one.len(): ma += one[k]/n; mb += other[k]/n
    saa = 0.0; sbb = 0.0; sab = 0.0
    loop k in 0..one.len(): saa += (one[k]-ma)*(one[k]-ma); sbb += (other[k]-mb)*(other[k]-mb); sab += (one[k]-ma)*(other[k]-mb)
    steady = sab/max(sqrt(saa*sbb),0.000001)
    print("OUTLINE pixels={outline} tallest_run={tallest} columns={one.len()} steady={steady:.3}")
    failed = false
    if outline < MIN_PIXELS: print("OUTLINE FAIL the far wooded slope has no outline ({outline} pixels, at least {MIN_PIXELS})"); failed = true
    if outline > W*H/50: print("OUTLINE FAIL the outline is over more of the picture than crowns on a line ({outline} pixels)"); failed = true
    if tallest > SILHOUETTE_REACH+2: print("OUTLINE FAIL a crown {tallest} pixels tall (at most {SILHOUETTE_REACH+2})"); failed = true
    if steady < STEADY: print("OUTLINE FAIL the crowns crawl: from two eyes six metres apart their profiles' correlation is {steady:.3} (at least {STEADY})"); failed = true
    if failed: exit(1)
    print("OUTLINE PASS")
    exit(0)
