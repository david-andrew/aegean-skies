# Read an actual saved registry. Potential output is a bound, not newly produced goods.
build:
    name = "worldlog"
use '../src/living_types.jo'
use '../src/living_save.jo'
use '../src/living_far_types.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_orders.jo'
use '../src/living_caravans.jo'

source=env("WORLD_SOURCE") ?? "phase5-month-v2"
saved=load_game(42,source)
assert(saved is SaveGame,"No compatible daily worldlog save")
w=saved.world
potential=0; grain=0; over_reserve=0; parts=0; wallets=0
loop place in w.far.place_ids:
    d=w.far.districts[place]; grain+=far_market_qty(w,place,3)
    over_reserve+=max(0,far_market_qty(w,place,3)-max(1000,d.target[3]/3))
    if d.output==3:
        workers=d.workers[0]+d.workers[1]+d.workers[2]
        potential+=workers*d.productivity
    if d.output!=3 and d.spare_wagons>0 and d.workers[d.born_country]>3:
        if far_market_qty(w,place,5)>=500: parts+=1
        if w.accounts[d.market_account].cents>=6300: wallets+=1
empty=0; loaded=0; grain_loads=0; groups=0; no_order=0; bid_low=0; no_surplus=0; stale=0
loop v in w.far.vehicles:
    if v.kind!=.cart or v.duty!=.merchant: continue
    if cart_wagons(v)>1: groups+=1
    if v.cargo.qty[3]>0: grain_loads+=1
    if v.journey>=0:
        if w.far.journeys[v.journey].survey: empty+=1 else: loaded+=1
    if v.place<0: continue
    if let o=v.buying_order:
        if o.due<w.minute or order_due(o,3)<w.minute: stale+=1
        if o.quantity[3]>0 and w.far.districts[v.place].prices[3]>o.price[3]: bid_low+=1
        if far_market_qty(w,v.place,3)<=max(1000,w.far.districts[v.place].target[3]/3): no_surplus+=1
    else: no_order+=1
print("FOOD_AUDIT source={source} minute={w.minute} population={far_population(w)} daily_meals_bound={far_population(w)*28} potential_farm_output_per_day={potential} produced={w.far.produced[3]} consumed={w.far.consumed[3]} counter_grain={grain} counter_sale_surplus={over_reserve}")
print("CARRIAGE groups={groups} actual_grain_carts={grain_loads} moving_loaded={loaded} moving_empty={empty} idle_no_order={no_order} idle_expired_bid={stale} idle_low_grain_bid={bid_low} idle_no_local_grain_surplus={no_surplus} investment_places_with_parts={parts} investment_places_with_money={wallets}")
loop c in w.countries:
    if not (c.capital_id in w.far.districts): continue
    place=c.capital_id; d=w.far.districts[place]
    print("CAPITAL place={place} hunger={d.hunger} grain={far_market_qty(w,place,3)} target={counter_stock_target(w,place,3)} learned_sources={d.staple_sources} spare_wagons={d.spare_wagons} workers={d.workers} cash={w.accounts[d.market_account].cents}")
    loop edge in d.links:
        loop v in w.far.vehicles:
            if v.route!=edge or v.duty!=.merchant: continue
            print("CAPITAL_SERVICE vehicle={v.id} mode={v.kind} at={v.place} journey={v.journey} hull={v.hull} rations={v.provisions.qty[3]} hungry_days={v.hungry_days} wagons={cart_wagons(v)} cargo_grain={v.cargo.qty[3]} bid_grain={if let o=v.buying_order: o.quantity[3] else: -1} capacity={v.capacity_grams}")
