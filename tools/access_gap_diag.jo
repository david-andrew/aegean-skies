# Read-only: from each unserved island settlement, flood the dry stepped-path
# region (same segment rule as a stepped landing) and report how far down it
# reaches and where the slope closes it off. Usage: access_gap_diag.jo ID[,ID...]
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_path_bake.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
targets=[loop part in split(args()[1],","):to_int(part)!]
cell:f32=if args().len()>2:f32(to_int(args()[2])!) else:4.0
loop id in targets:
    s=world_settlements[settlement_by_id[id]]
    radius:f32=0;peak=0.0;ic=vec2(0,0)
    loop island in small_islands:
        if island.id==(s.id-300001)/10:radius=max(island.radii.x,island.radii.y);peak=island.peak;ic=island.center
    span=radius*1.6
    nx=int(ceil(span*2/cell))+1
    origin=ic-vec2(span,span)
    key=(p:vec2)->int:int(round((p.x-origin.x)/cell))+int(round((p.y-origin.y)/cell))*nx
    start=key(s.center.xz)
    pts:{int:vec3}={start:s.center};seen:{int:bool}={start:true};queue=[start];at=0
    lowest=f64(s.center.y);lowest_at=s.center
    loop at<queue.len() and at<2000000:
        idn=queue[at];at+=1;p=pts[idn]
        loop dy in -1..2:
            loop dx in -1..2:
                if dx==0 and dy==0:continue
                ix=idn%nx+dx;iy=idn/nx+dy
                if ix<0 or iy<0 or ix>=nx or iy>=nx:continue
                nk=ix+iy*nx
                if nk in seen:continue
                q=place_point(origin+vec2(f32(ix),f32(iy))*cell)
                if not stepped_segment_clear(p,q):continue
                seen[nk]=true;pts[nk]=q;queue.push(nk)
                if f64(q.y)<lowest:lowest=f64(q.y);lowest_at=q
    # Slope histogram over the island interior along 32 rays from the centre.
    steepest=0.0
    loop direction in 0..32:
        angle=f64(direction)*TAU/32.0;out=vec2(cos(angle),sin(angle))
        last=place_ground(s.center.xz)
        loop k in 1..int(radius*3/2):
            p=s.center.xz+out*f32(k*2);h=place_ground(p)
            if h<0:break
            steepest=max(steepest,abs(h-last)/2.0);last=h
    print("DIAG|{id}|{s.name}|{s.kind}|centre_y={s.center.y:.0f}|radius={radius:.0f}|peak={peak:.0f}|reached={queue.len()}|lowest={lowest:.1f}|at={lowest_at}|steepest_ray={steepest:.2f}")
