# The sea alone, seen straight down from a height over a real place, a frame every tenth of a
# second: the pictures tests/sea_speed_render_test.py measures the drawn waves' speed from.
#   SEA_PLACE="x z" (a point of the world) or SEA_HARBOUR=<settlement id> (12 m off its first
#   dock, with the harbour's shelter as the game sets it); SEA_HEIGHT (m, default 30);
#   SEA_WIND="speed dx dz"; SEA_FRAMES=<dir> for f000.png onwards (with SLOPPY_FRAMES).
# Prints SEAVIEW with the water's depth there and the metres a pixel covers.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/sea.jo'
use '../src/look.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'
use '../src/harbour_shelter.jo'
const VIEW_FOV = 60.0
const VIEW_STEP = 0.1               # seconds of the sea between frames
window("Sea speed view",480,270)
enable_world_depth()
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_settlements()
init_sea()
water = build_sea_mesh()
depth = build_depth_texture()
place = vec2(60000,-90000)
if let v = env("SEA_PLACE"):
    w = split(v," ")
    place = vec2(f32(to_float(w[0]) ?? 0.0),f32(to_float(w[1]) ?? 0.0))
if let v = env("SEA_HARBOUR"):
    s = world_settlements[settlement_by_id[to_int(v) ?? 0]]
    place = s.harbor[0].at.xz+s.out*12.0
    set_sea_harbour(harbour_shelter_at(place))
eye_height = to_float(env("SEA_HEIGHT") ?? "30") ?? 30.0
wind = Wind(vec2(0.8,0.6),6,vec2(0,0))
if let v = env("SEA_WIND"):
    w = split(v," ")
    wind = Wind(normalize(vec2(f32(to_float(w[1]) ?? 0.8),f32(to_float(w[2]) ?? 0.6))),to_float(w[0]) ?? 6.0,vec2(0,0))
wind_now = wind
frames = env("SEA_FRAMES")
print("SEAVIEW depth {max(-surface_height(f64(place.x),f64(place.y)),0.0):.2} metres_per_pixel {2.0*eye_height*tan(radians(VIEW_FOV*0.5))/270.0:.5} step {VIEW_STEP} calm {sea_calm_at(f64(place.x),f64(place.y)):.2} wind {wind.speed:.1}")
draw = ():
    clear(BLACK);hide_sky()
    render_camera(vec3(place.x,f32(eye_height),place.y),vec3(0,-1,-0.0005),VIEW_FOV,0.1,300000)
    draw_custom(():
        clear_depth()
        # (the depth map round a far place is made a few rows a frame: all of it before the first)
        if frame_number() <= 1:
            loop k in 0..400: update_nearby_depth()
        draw_sea(water,depth,light_at(13.0),300.0+f64(frame_number())*VIEW_STEP,wind)
    )
    if let directory = frames: save_png("{directory}/f{frame_number():03}.png",screenshot())
