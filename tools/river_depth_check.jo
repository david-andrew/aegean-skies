# Native early-depth regression: deep water must hide a red bed; shallows keep it.
use '../src/river_render.jo'
use '../src/geography.jo'
use '../src/depth_space.jo'
use '../src/sea.jo'
use '../src/look.jo'
use '../src/render_space.jo'
enable_world_depth()
window("River opaque depth check",320,240)
geography_enabled=true
at=vec3(-148000,5,-156000)
aa=InlandWaterVertex(at+vec3(-20,0,-20),depth=0)
ba=InlandWaterVertex(at+vec3(20,0,-20),depth=5)
ab=InlandWaterVertex(at+vec3(-20,0,20),depth=0)
bb=InlandWaterVertex(at+vec3(20,0,20),depth=5)
# Deliberately use the same downward-facing winding as the generated ribbon.
river_batches=[RiverBatch(mesh([aa,ba,ab,ab,ba,bb]),at,at,30)]
river_occlusion_shader=make_world_shader(shader(river_vs,river_occlusion_fs))
bed_fs=(i:SeaOut,u:SeaParams)->vec4:vec4(1,0,0,1)
bed_shader=make_world_shader(shader(river_vs,bed_fs))
aa.pos.y=0;ab.pos.y=0;ba.pos.y=0;bb.pos.y=0
bed=mesh([aa,ab,ba,ab,bb,ba])
depth=texture(image(1,1))
draw=():
    clear(WHITE);hide_sky()
    render_camera(at+vec3(0,50,0),vec3(0,-1,-0.001),62,0.1,200,vec3(0,0,-1))
    draw_custom(():
        clear_world_depth()
        draw_river_occlusion(depth,light_at(14),0)
        p=sea_params(depth,light_at(14),0,wind_now,vec3(0,0,0),SeaShadows())
        draw(bed_shader,bed,p)
    )
