# Cheap calendar/phase/angular-size captures using the real sky/cloud shaders.
build:
    js = "../src/web_compat.js"
use '../src/sky.jo'
use '../src/celestial.jo'
use '../src/look.jo'
use '../src/cloud_depth.jo'
use '../src/cloud_volume.jo'
use '../src/cloud_transparency.jo'
use '../src/depth_space.jo'
use '../src/render_space.jo'
window("Calendar sky sample",1280,720)
enable_world_depth();init_sky();init_cloud_volumes()
hour=to_float(env("SKY_HOUR")??"20")??20.0
day=to_float(env("SKY_DAY")??"0")??0.0
which=env("SKY_TARGET")??"moon"
L=light_at(hour,day)
aim=if which=="sun":L.sun_dir else:if which=="venus":L.planets[0].xyz else:if which=="jupiter":L.planets[1].xyz else:if which=="mars":L.planets[2].xyz else:if which=="saturn":L.planets[3].xyz else:L.moon_dir
print("SKY day={day:.4} hour={hour:.3} moon={L.moon_dir} illumination={moon_illumination(L.sun_dir,L.moon_dir):.5}")
loop k in 0..4:print("PLANET {k} {L.planets[k]}")
draw=():
    clear(BLACK);hide_sky();post_effects(0.35,0.85,0.22,1.08)
    render_camera(vec3(0,300,0),aim,62.0,0.035,20000)
    draw_custom(():begin_cloud_depth())
    sky_light=L
    if env("SKY_HIDE_BODY")!=none:
        sky_light.moon_dir=vec3(0,-1,0)
        loop k in 0..4:sky_light.planets[k]=vec4(0,-1,0,0)
    draw_custom(():draw_sky(sky_light,0))
    if env("SKY_CLOUD")!=none:
        center=vec3(0,300,0)+aim*3000.0
        cloud=CloudVolume(center,vec3(2000,1800,1300),0)
        draw_cloud_layer([cloud],L)
    text("{which} / day {day:.2} / {hour:.2}h / 62 degree field of view",vec2(24,24),20,WHITE)
