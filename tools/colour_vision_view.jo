# A capture of the game as an eye with a colour-vision deficiency sees it, for checking the
# colour-blind presets (src/side_colours.jo) against what is really on the screen:
#
#   sloppy --release tools/colour_vision_view.jo <in.png> <out.png> <protan|deutan|tritan|achromat>
#       the picture simulated (src/colour_vision.jo: Machado et al. 2009 at full severity, in
#       linear light; achromat: luminance alone)
#   sloppy --release tools/colour_vision_view.jo <in.png> <out.png> sheet
#       the picture and its four simulations side by side, each at half size, named
#   sloppy --release tools/colour_vision_view.jo <in.png> sample <x> <y> [half=6]
#       the mean colour of the square round a point, as rgba(...) for a test's reference grounds
#
# No window is opened.
use '../src/colour_vision.jo'

_load = (path: str) -> Image:
    data = read_bytes(path)
    if data is u8[]:
        img = load_image(data)
        if img is Image: return img
    print("cannot read {path}")
    exit(1)
    image(1, 1)

_simulated = (src: Image, d: Deficiency) -> Image:
    out = image(src.width, src.height)
    # (a picture has far fewer colours than pixels: each simulated once)
    seen: {int: vec4}
    loop y in 0..src.height:
        loop x in 0..src.width:
            i = (y * src.width + x) * 4
            key = int(src.pixels[i]) * 65536 + int(src.pixels[i + 1]) * 256 + int(src.pixels[i + 2])
            if not (key in seen): seen[key] = simulate_colour(src.get(x, y), d)
            c = seen[key]
            out.set(x, y, vec4(c.x, c.y, c.z, 1))
    out

_paste = (to: mut Image, from: Image, x0: int, y0: int):
    loop y in 0..from.height:
        loop x in 0..from.width:
            if x0 + x < to.width and y0 + y < to.height: to.set(x0 + x, y0 + y, from.get(x, y))

a = args()
if a.len() < 4:
    print("usage: colour_vision_view.jo <in.png> <out.png> <protan|deutan|tritan|achromat|sheet>  |  <in.png> sample <x> <y> [half]")
    exit(2)
src = _load(a[1])
if a[2] == "sample":
    cx = to_int(a[3]) ?? 0
    cy = if a.len() > 4: to_int(a[4]) ?? 0 else: 0
    half = if a.len() > 5: to_int(a[5]) ?? 6 else: 6
    sum = vec3(0, 0, 0); n = 0
    loop y in max(0, cy - half)..min(src.height, cy + half + 1):
        loop x in max(0, cx - half)..min(src.width, cx + half + 1):
            c = src.get(x, y)
            sum += vec3(c.x, c.y, c.z); n += 1
    m = sum / f32(max(n, 1))
    print("rgba({m.x:.2}, {m.y:.2}, {m.z:.2}, 1)")
    exit(0)
if a[3] == "sheet":
    w = src.width / 2; h = src.height / 2
    sheet = image(w * 3, h * 2, vec4(0.05, 0.06, 0.08, 1))
    kinds = [Deficiency.none, Deficiency.protan, Deficiency.deutan, Deficiency.tritan, Deficiency.achromat]
    loop k in 0..kinds.len():
        _paste(sheet, resized(_simulated(src, kinds[k]), w, h), (k % 3) * w, (k / 3) * h)
    assert(save_png(a[2], sheet))
    print("{a[2]}: normal, protanopia, deuteranopia / tritanopia, achromatopsia")
    exit(0)
kind = Deficiency.none
loop d in DEFICIENCIES:
    if str(d) == a[3]: kind = d
if kind == .none:
    print("unknown deficiency '{a[3]}': protan, deutan, tritan or achromat")
    exit(2)
assert(save_png(a[2], _simulated(src, kind)))
print("{a[2]}: {deficiency_name(kind)}")
