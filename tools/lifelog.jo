# CPU-only month transcript. No generated events, forced jobs or actor teleportation.
use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_conversation.jo'
use '../src/living_news.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'

w = build_world(u64(42))
spoken = 0; questions = 0; meetings = 0; last_day = -1
seen: {int: bool}
loop minute in 1..43201:
    advance_minutes(w,1)
    if minute%60 != 0: continue
    assert(invariant_errors(w).len() == 0 and validate_save_world(w) == "")
    day = day_index(w.minute); clock = local_minute(w.minute)
    if day != last_day:
        last_day = day
        text = canonical_text(w); restored = from_text[World](text)
        assert(restored is World and canonical_text(restored) == text)
        w = restored
        print("\nDAY {day+1}: {w.next_trip} journeys; {w.next_meeting} meetings; {w.stories.len()} small stories")
    # Three visits a day. People are only heard speaking to somebody physically nearby.
    if clock < 480 or clock >= 1320 or clock%240 != 30: continue
    print("-- {clock/60:02}:{clock%60:02} --")
    loop p in w.people:
        if p.id == w.player or p.place < 0 or p.trip >= 0 or p.carriage >= 0: continue
        listener = -1
        loop other in w.people:
            if other.id == p.id or other.place != p.place or other.trip >= 0 or other.carriage >= 0: continue
            if length(other.pose.pos-p.pose.pos) <= 8 and listener < 0: listener = other.id
        if listener < 0: continue
        offered = conversation_topics(w,p.id,listener)
        topic = offered[(day+p.id+clock/240)%offered.len()].topic
        before = w.speech.get(p.id,SpeechLedger()).recent
        turn = converse(w,p.id,listener,topic)
        if turn.text == "": continue
        loop old in before:
            if w.minute-old.minute < SPEECH_RECENT_MINUTES:
                assert(old.text != turn.text and (turn.question == "" or old.text != turn.question))
        spoken += 1
        print("{w.people[p.id].name} [{voice_of(w,p.id)} -> {w.people[listener].name}, {topic}]: {turn.text}")
        if turn.replies.len() > 0:
            questions += 1
            if turn.question != "": print("  {turn.question}")
            reply = answer_conversation(w,p.id,listener,.reassure)
            if reply.text != "": print("  [{turn.replies[0].label}] {reply.text}")
        if turn.source_event >= 0: print("  [account {turn.source_event}, from {turn.source_person}, confidence {turn.confidence}]")
    loop place in w.places:
        loop n in place.news:
            if n.private_fact or seen.get(n.event,false): continue
            seen[n.event] = true
            print("QUAY {place.key}: {news_sentence(w,n)}")
assert(spoken > 250 and questions > 20 and w.next_meeting > 30)
assert(invariant_errors(w).len() == 0 and validate_save_world(w) == "")
print("\nMONTH COMPLETE: {spoken} spoken turns, {questions} questions, {seen.len()} public accounts; {w.next_meeting} meetings; {w.next_trip} journeys; canonical hash {canonical_hash(w)}")
