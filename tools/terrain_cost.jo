# CPU-only selection workload for instruction-count comparisons. No window or sound.
# Build release, run under Callgrind with SLOPPY_SOFTWARE=1. Compare 0 and 360
# frames to subtract fixed asset decoding/grid preparation from the workload.
use '../src/terrain_lod.jo'
use '../src/world.jo'
use '../src/render_space.jo'

assert(load_land(embed('../assets/terrain.bin')))
load_terrain(embed('../assets/terrain_lod.bin'))
n = to_int(env("AEGEAN_COST_FRAMES") ?? "360") ?? 360
checksum = 0
loop frame in 0..n:
    cam = vec3(f32(800.0 + f64(frame) * 3.3), 100, -3600)
    vp = perspective(62.0 * PI / 180.0, 1280.0 / 720.0, 0.3, world_far(100.0)) * look_at(cam, cam + vec3(0.8, -0.12, -1), vec3(0, 1, 0))
    select_terrain(cam, vp, 600.0, f64(frame) / 60.0)
    planes = land_planes(vp)
    loop tile in terrain_tiles:
        loop patch in tile.patches:
            if land_visible(tile, patch.data, cam, planes): checksum += 1 + patch.goal
print("frames={n} checksum={checksum}")
