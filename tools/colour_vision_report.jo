# The colour presets' scores as tables (Markdown), for docs/accessibility.md and for reports:
#
#   sloppy --release tools/colour_vision_report.jo           every preset under the eyes it is for,
#                                                            and the standard look under every eye
#   sloppy --release tools/colour_vision_report.jo before    the same for the palettes as they were
#                                                            before the presets were retuned
#   sloppy --release tools/colour_vision_report.jo inks      the war chart's inks
#   sloppy --release tools/colour_vision_report.jo faint     the standard colours as they scored
#                                                            with the lighter halo and narrow
#                                                            outline they had before
#
# The figures are those tests/colour_vision_test.jo holds the presets to (src/colour_vision_scores.jo).
use '../src/colour_vision_scores.jo'
use '../src/colour_vision.jo'
use '../src/side_colours.jo'

# The palettes of the first round (main at 34a0ef8), for comparison.
_before = (v: ColourVision) -> SidePalette:
    match v:
        .standard: SidePalette()
        .red_green: SidePalette(enemy = rgba(1.0,0.58,0.0,1.0), ally = rgba(0.30,0.52,1.0,1.0), neutral = rgba(0.97,0.97,0.97,1.0))
        .blue_yellow: SidePalette(enemy = rgba(0.95,0.22,0.22,1.0), ally = rgba(0.05,1.0,0.85,1.0), neutral = rgba(1.0,1.0,1.0,1.0))
        .monochrome: SidePalette(enemy = rgba(1.0,0.98,0.80,1.0), ally = rgba(0.42,0.62,0.95,1.0), neutral = rgba(0.80,0.80,0.80,1.0), shapes = true, halo = 0.95)

mode = if args().len() > 1: args()[1] else: ""
palette = (v: ColourVision) -> SidePalette:
    if mode == "before": return _before(v)
    p = side_palette_for(v)
    if mode == "faint" and v == ColourVision.standard: p = SidePalette()
    p

row = (label: str, p: SidePalette, e: Eye):
    a = sides_2000(p, e); u = sides_ucs(p, e); j = sides_lightness(p, e)
    g = colour_off_ground(p, e); m = mark_off_ground(p, e); c = mark_contrast(p, e); n = name_contrast(p, e)
    print("| {label} | {eye_name(e)} | {a.value:.1} ({a.at}) | {u.value:.1} | {j.value:.1} | {g.value:.1} ({g.at}) | {m.value:.1} | {c.value:.2}:1 ({c.at}) | {n.value:.1}:1 |")

if mode == "inks":
    print("| Preset | Seen by | Least ΔE2000 between inks | On paper | On the chart's sea | On land |")
    print("| --- | --- | --- | --- | --- | --- |")
    loop k in 0..COLOUR_VISIONS.len():
        v = COLOUR_VISIONS[k]
        loop e in (if v == ColourVision.standard: ALL_EYES else: preset_eyes(v)):
            inks = chart_inks(v)
            a = inks_2000(inks, e)
            land = min(inks_off_ground(inks, e, CHART_GROUNDS[2]).value, inks_off_ground(inks, e, CHART_GROUNDS[3]).value)
            print("| {COLOUR_VISION_LABELS[k]} | {eye_name(e)} | {a.value:.1} ({a.at}) | {inks_off_ground(inks, e, CHART_GROUNDS[0]).value:.1} | {inks_off_ground(inks, e, CHART_GROUNDS[1]).value:.1} | {land:.1} |")
    exit(0)

print("| Preset | Seen by | Sides: least ΔE2000 | Sides: least CAM02-UCS | Sides: least lightness ΔJ' | Colour alone on a ground: least ΔE2000 | Mark with halo on a ground: least ΔE2000 | Mark contrast (WCAG 1.4.11) | Name contrast (WCAG 1.4.3) |")
print("| --- | --- | --- | --- | --- | --- | --- | --- | --- |")
loop k in 0..COLOUR_VISIONS.len():
    v = COLOUR_VISIONS[k]
    if v == ColourVision.standard or mode == "faint": continue
    loop e in preset_eyes(v): row(COLOUR_VISION_LABELS[k], palette(v), e)
loop e in ALL_EYES: row("Standard", palette(.standard), e)
