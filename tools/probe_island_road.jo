# Read-only single-island route survey. Output goes to an explicit scratch file.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_path_bake.jo'
use '../src/living_feeder_bake.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
id=to_int(args()[1])!;assert(id in settlement_by_id and id-1 in settlement_by_id)
a=world_settlements[settlement_by_id[id]];b=world_settlements[settlement_by_id[id-1]]
assert(b.harbor.len()>0)
loop s in [a,b]:
    exits=0
    loop k in 0..32:
        angle=f32(k)*6.2831853/32.0
        q=place_point(s.center.xz+vec2(cos(angle),sin(angle))*4.0)
        if feeder_segment_clear(s.center,q):exits+=1
    eprint("ENDPOINT {s.id} {s.name} height={s.center.y} clear_exits={exits}/32")
eprint("FINE precise 4m {a.name}/{b.name}")
path=access_track(a.center.xz,b.center.xz,4.0,300.0,true)
assert(path.len()>1,"no verified route")
meters=0.0
loop k in 1..path.len():
    assert(access_segment_clear(path[k-1],path[k],true))
    meters+=f64(length(path[k]-path[k-1]))
assert(write_file(args()[2],to_text(path)))
print("VERIFIED {a.id}/{b.id} points={path.len()} length={meters}")
