# 120 Hz quaternion/rate audit of the enabled trial; one substep per recorded pose.
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as pl
import 'stalllab.jo' as lab

inertia_start = (k: fl.CraftSpec, scenario: int) -> fl.CraftState:
    s = lab.stall_start(k, 0)
    s.velocity = vec3(0, 0, -k.stall_speed * fl.pure_k(k) * 0.8)
    s.orientation = quat_euler(0.4, 0, 0)
    if scenario == 1:
        s.orientation = quat_euler(0.2, 0, -0.25)
        s.angular_velocity.z = -0.9
    if scenario == 2: s = lab.stall_start(k, 2)
    if scenario == 3:
        s.orientation = quat_euler(0.0, 0, -1.2)
        s.angular_velocity = vec3(0.0, 0.0, -0.7)
    if scenario == 4:
        s.orientation = quat_euler(-0.4, 0, -1.8)
        s.angular_velocity = vec3(0.5, 0.2, -0.8)
    s.airspeed = f64(length(s.velocity))
    s

inertia_controls = (scenario: int) -> fl.Controls:
    if scenario == 2: fl.Controls(pitch = 0.8, roll = 0.6, yaw = 0.8, throttle = 0.7, assist = 0.0)
    else: fl.Controls(assist = 0.0)

# Quaternion logarithm in the old body frame. Euler-angle derivatives cannot measure this:
# pitch/bank coordinates wrap at vertical flight, even when the actual aircraft rotates smoothly.
observed_rate = (before: vec4, after: vec4, dt: f64) -> vec3:
    d = quat_mul(quat_inverse(before), after)
    if d.w < 0: d = -d
    v = vec3(d.x, d.y, d.z)
    angle = 2.0 * atan2(f64(length(v)), f64(d.w))
    if length(v) > 1e-9: normalize(v) * f32(angle / dt) else: vec3(0, 0, 0)

flow_angle = (s: fl.CraftState) -> f64:
    v = quat_rotate(quat_inverse(s.orientation), s.velocity)
    atan2(-f64(v.y), -f64(v.z))

main = ():
    fl.set_speed_scale(3.3)
    tw.set_tweaks(tw.Tweaks(chaotic_stalls = true))
    print("kind,case,t,alt,speed,alpha,pitch,bank,wx,wy,wz,dx,dy,dz,left,right,stalled")
    loop kind in [pl.Craft.gull, pl.Craft.falco, pl.Craft.tern, pl.Craft.pelican, pl.Craft.corsair]:
        k = lab.stall_spec(kind)
        loop scenario in 0..5:
            s = inertia_start(k, scenario)
            loop i in 0..1440:
                before = s.orientation
                fl.step(k, s, inertia_controls(scenario), fl.FlightEnv(), 1.0 / 120.0)
                actual = observed_rate(before, s.orientation, 1.0 / 120.0)
                up = quat_rotate(s.orientation, vec3(0, 1, 0)); right = quat_rotate(s.orientation, vec3(1, 0, 0))
                print("{int(kind)},{scenario},{s.time:.6},{s.position.y:.6},{s.airspeed / 3.3:.6},{flow_angle(s):.6},{asin(clamp(f64(fl.forward(s).y), -1.0, 1.0)):.6},{atan2(-f64(right.y), f64(up.y)):.6},{s.angular_velocity.x:.6},{s.angular_velocity.y:.6},{s.angular_velocity.z:.6},{actual.x:.6},{actual.y:.6},{actual.z:.6},{s.wing_separation.x:.6},{s.wing_separation.y:.6},{if s.stalled: 1 else: 0}")
