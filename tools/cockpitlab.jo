# Cockpit view samples: one aircraft held level in the air, seen from the pilot's seat.
# COCKPIT_KIND=Craft id  COCKPIT_HOUR=16.5  COCKPIT_LOOK="yaw pitch" (radians)  COCKPIT_SIZE="w h"
# COCKPIT_ROLL=controls.roll. COCKPIT_FUEL=0..1 the tank's contents. COCKPIT_SWEEP=<dir> runs every aircraft through COCKPIT_SWEEP_LOOKS
# ("yaw pitch;yaw pitch;...", default a left and a right glance down past the coaming), saving
# <dir>/<id>-<look>.png each, then quits.
use '../src/flight.jo'
use '../src/flight_feedback.jo'
use '../src/flight_instruments.jo'
use '../src/planes.jo'
use '../src/damage.jo'
use '../src/prop_disc.jo'
use '../src/cockpit.jo'
use '../src/tweaks.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/sea.jo'
use '../src/curved_world.jo'
use '../src/world_point.jo'
use '../src/render_space.jo'
use '../src/depth_space.jo'
use '../src/pilot.jo'

size=split(env("COCKPIT_SIZE") ?? "1280 720"," ")
window("Cockpit samples",to_int(size[0]) ?? 1280,to_int(size[1]) ?? 720)
enable_world_depth()
init_objects();init_sea();init_curved_world()
set_speed_scale(3.3);set_tweaks(Tweaks())
kind=Craft(clamp(to_int(env("COCKPIT_KIND") ?? "0") ?? 0,0,CRAFT_NAMES.len()-1))
hour=to_float(env("COCKPIT_HOUR") ?? "16.5") ?? 16.5
look=split(env("COCKPIT_LOOK") ?? "0 0"," ")
yaw=to_float(look[0]) ?? 0.0;pitch=to_float(look[1]) ?? 0.0
alt=to_float(env("COCKPIT_ALT") ?? "120") ?? 120.0
fly=(kind:Craft,model:CraftModel)->(CraftSpec,CraftState):
    k=craft_spec(kind,model.contacts);k.player=true
    s=CraftState(position=vec3(0,f32(alt),0),velocity=vec3(0,0,-f32(k.stall_speed*3.3*1.4)),throttle=0.7,fuel=k.fuel_capacity*(to_float(env("COCKPIT_FUEL") ?? "1") ?? 1.0),water_age=1.0)
    s.orientation=quat_euler(to_float(env("COCKPIT_PITCH") ?? "0") ?? 0.0,0,to_float(env("COCKPIT_BANK") ?? "0") ?? 0.0)
    s.precise=world_point(s.position);s.precise_ready=true;s.published=s.position
    (k,s)
model=build_craft(kind,LIVERIES[DEFAULT_LIVERIES[int(kind)]])
flown=fly(kind,model);k=flown.0;s=flown.1
sweep=env("COCKPIT_SWEEP")
looks:vec2[]
loop w in split(env("COCKPIT_SWEEP_LOOKS") ?? "1.15 -0.45;-1.15 -0.45;0.45 -0.75;-0.45 -0.75",";"):
    f=split(w," ");looks.push(vec2(f32(to_float(f[0]) ?? 0.0),f32(to_float(f[1]) ?? 0.0)))
step=0
cockpit=build_cockpit()
img=image(2,2)
loop y in 0..2:
    loop x in 0..2: img.set(x,y,vec4(1,0,0,1))
depth=texture(img,true);init_expanded_depth(depth)
sea=build_sea_mesh()
prop=1.3;t=40.0
rpm=prop_rotation_speed(s,k.stall_speed*1.4)
controls=Controls(roll=to_float(env("COCKPIT_ROLL") ?? "0") ?? 0.0,pitch=to_float(env("COCKPIT_STICK") ?? "0") ?? 0.0)
instruments=FlightInstruments()
shot_frame=to_int(env("COCKPIT_FRAME") ?? "20") ?? 20

draw=():
    global prop,t,kind,model,k,s,rpm,yaw,pitch,step
    if let dir=sweep:
        # three frames a shot: the first sets it up, the last is saved
        shot=step/3;phase=step%3;step+=1
        id=shot/looks.len();look=shot%looks.len()
        if id>=CRAFT_NAMES.len():quit();return
        if phase==0:
            if look==0:
                kind=Craft(id);model=build_craft(kind,LIVERIES[DEFAULT_LIVERIES[id]])
                flown=fly(kind,model);k=flown.0;s=flown.1;rpm=prop_rotation_speed(s,k.stall_speed*1.4)
            yaw=f64(looks[look].x);pitch=f64(looks[look].y)
    t+=1.0/60.0
    prop+=rpm/60.0
    instrument_step(instruments,k,s,1.0/60.0)
    L=light_at(hour)
    clear(vec4(L.sky_horizon,1));hide_sky()
    at=translation(s.position)*quat_to_mat4(s.orientation)
    if let v=env("COCKPIT_OUTSIDE"):
        # "yaw pitch distance": an outside view of the aircraft, from that side
        w=split(v," ");a=to_float(w[0]) ?? 0.8;e=to_float(w[1]) ?? 0.2;d=to_float(w[2]) ?? 14.0
        target=s.position+vec3(0,1,f32(to_float(env("COCKPIT_OUTSIDE_Z") ?? "0") ?? 0.0))
        off=vec3(f32(sin(a)*cos(e)*d),f32(sin(e)*d),f32(-cos(a)*cos(e)*d))
        precise_camera(world_point(target+off),-off,48.0,0.1,18000.0)
        draw_custom(():
            clear_world_depth()
            draw_craft_parts(model,s.damage,quat_to_mat4(s.orientation),L,t,prop,anchor=craft_point(s),prop_speed=rpm,prop_key=0)
        )
    else:
        place_cockpit_camera(model,s,yaw,pitch,t)
        draw_custom(():
            clear_world_depth()
            draw_cockpit_airframe(model,s,at,L,t,prop,rpm)
            draw_cockpit(cockpit,model,k,s,at,L,t,controls,instruments=instruments,prop=prop,rpm=rpm,prop_key=0)
        )
    if let dir=sweep:
        if step%3==0:
            text("{int(kind)} {CRAFT_NAMES[int(kind)]}  look {yaw:.2} {pitch:.2}",vec2(12,10),20,WHITE)
            save_png("{dir}/{int(kind)}-{(step/3-1)%looks.len()}.png",screenshot())
    draw_custom(():draw_sea(sea,depth,L,t,wind_now),transparent=true)
    draw_custom(():draw_prop_discs(L),transparent=true)
    if let out=env("COCKPIT_SHOT"):
        if frame_number()==shot_frame:
            save_png(out,screenshot());quit()
