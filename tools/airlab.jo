use '../src/depth_space.jo'
# Synthetic acceptance fixture only. AIR_BASELINE=1 draws the old full aircraft at distance.
# AIR_SCENE=traffic|meet|quay|dusk; AIR_CPU=n measures only control+physics (laptop only).
use '../src/air_view.jo'
use '../src/air_pilot.jo'
use '../src/air_meet_view.jo'
use '../src/air_race.jo'
use '../src/traffic.jo'
use '../src/flight.jo'
use '../src/tweaks.jo'
use '../src/planes.jo'
use '../src/objects.jo'
use '../src/look.jo'
use '../src/curved_world.jo'
use '../src/sea.jo'
use '../src/world.jo'
use '../src/sky.jo'
use '../src/quality.jo'

build:
    js = "../src/web_compat.js"

set_speed_scale(3.3)
set_tweaks(Tweaks(chaotic_stalls = true))
models = build_craft_models(); traffic: Traffic[]
observer = vec3(18000, 120, 18000)
scene = env("AIR_SCENE") ?? "traffic"
baseline = env("AIR_BASELINE") != none
loop i in 0..8:
    kind = Craft(i % 4); model = default_craft_model(kind); spec = craft_spec(kind, models[model].contacts)
    s = CraftState(position = observer + vec3(f64(i % 4 - 2) * 250, 100 + f64(i % 3) * 70, -2000 - f64(i) * 650),
        orientation = quat_euler(0, PI, 0), velocity = vec3(0, 0, 100), throttle = 0.7, fuel = 100)
    traffic.push(Traffic(craft = i, kind = kind, model = model, spec = spec, state = s, plan = FlightPlan(phase = .descend), flying = true, materialized = true))
if let ticks = env("AIR_CPU"):
    n = to_int(ticks) ?? 3600; times: f64[]
    loop tick in 0..n:
        before = time()
        contacts = [loop tr in traffic: AirContact(tr.craft, tr.state.position, tr.state.velocity, 0)]
        loop mut tr in traffic:
            target = vec3(18000, 300, -80000); e = FlightEnv()
            if not baseline: air_think(tr.air, AirProfile(), tr.craft, 0, tr.state, tr.spec, target, contacts, [], -1, tick, e)
            c = if baseline: air_waypoint_controls(tr.spec, tr.state, e, target, 300, tr.spec.cruise_speed) else: air_social_controls(tr.air, AirProfile(), tr.craft, tr.state, tr.spec, e, tick)
            step(tr.spec, tr.state, if baseline: c else: air_stabilize(tr.spec, tr.state, e, c), e, 1.0 / 60.0)
        times.push((time() - before) * 1000)
    times.sort(); total = 0.0
    loop t in times: total += t
    print("AIR CPU baseline={baseline} count=8 mean_ms={total/f64(n):.4} p95_ms={times[n*95/100]:.4}")
    exit(0)
enable_world_depth()
window("Air life acceptance", 1280, 720)
init_quality(); init_objects(); init_sky(); init_sea(); init_curved_world()
assert(load_land(embed('../assets/terrain.bin')))
sea = build_sea_mesh(); depth = build_depth_texture(); wind = Wind()
view = make_air_view(); meeting_view = make_air_meet_view()
meet = AirMeet(1, 100, 6, "Synthetic capital meeting", air_course(vec3(18000, 0, 18000), vec3(0, 0, -1), (x: f64, z: f64) -> f64: -20), phase = .racing,
    quay_a = vec3(17985, 1, 18030), quay_b = vec3(18015, 1, 18030), audience = 48)
events = AirEvents(meets = [meet])
quay_vertices: Vertex3D[]
add_box(quay_vertices, vec3(18000, 0, 18038), vec3(34, 2, 20), rgb(0.6, 0.55, 0.43))
quay_mesh = custom_mesh(quay_vertices)
if scene == "meet":
    observer = meet.gates[0].center + vec3(400, 100, 650)
    loop i in 0..2:
        gate = meet.gates[i]; traffic[i].state.position = gate.center - gate.forward * 100
        traffic[i].state.orientation = quat_euler(0, -atan2(f64(gate.forward.x), -f64(gate.forward.z)), 0)
if scene == "quay": observer = vec3(18000, 7, 18068)
if scene == "dusk":
    traffic[0].state.position = observer + vec3(0, 30, -1800)
    traffic[0].state.orientation = quat_euler(0, PI, 0)
# Warm actual exhaust histories without advancing positions during the measured frame loop.
loop frame in 0..120:
    loop mut tr in traffic: tr.state.position += tr.state.velocity / 60.0
    update_air_view(view, traffic, vec3(3, 0, 0), observer, 1.0 / 60.0)
if scene == "dusk": print("dusk cue={air_cue(traffic[0].state,observer,light_at(18.25).sun_dir,traffic[0].plan.phase,0,4)}")
record_stats()
frame = 0
update = (dt: f64):
    global frame
    frame += 1
    if frame == 60: print("warmup " + frame_stats_line())
    if frame == 240: print(frame_stats_line())
draw = ():
    t = 4.0; L = light_at(if scene == "dusk": 18.25 else: 15.0)
    focus = if scene == "meet": meet.gates[0].center else: if scene == "quay": vec3(18000, 2, 18028) else: observer + vec3(0, 15, -1500)
    camera3d(observer, focus, 52, 0.1, 100000)
    fog(L.haze, L.fog_density, 0.0012); hide_sky()
    draw_custom(():clear_world_depth())
    draw_custom((): draw_sky(L, t))
    draw_custom((): draw_far_sea(depth, L, t, wind))
    draw_custom(():
        draw_traffic(traffic, models, L, t, detail_distance = if baseline: 9000 else: 1800)
        if not baseline:
            draw_air_far(view, traffic, L, t)
            if scene == "meet" or scene == "quay": draw_air_meets(meeting_view, events, L, t)
            if scene == "quay": draw_world(obj_sh, quay_mesh, obj_params(L, t))
    )
    draw_custom((): draw_sea(sea, depth, L, t, wind), transparent = true)
    if not baseline: draw_air_view(view, traffic, L, t)
