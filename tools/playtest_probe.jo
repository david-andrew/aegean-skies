# An automated playtest of the game's loops: the whole game, driven through the functions the
# player's inputs reach, telling at each step what is offered next. PLAYTEST_CASE picks the loop;
# each prints PLAYTEST lines and ends with PLAYTEST PASS or a failed assertion naming the dead end.
# Run headlessly with an isolated SLOPPY_SAVE_DIR and SLOPPY_SCREENSHOT set (see tools/playtest.sh).
build:
    name = "Aegean playtest probe"
    js = "../src/web_compat.js"
import '../aegean.jo' as game
import '../src/living_world.jo' as life
import '../src/living_portage.jo' as portage
import '../src/living_claims.jo' as claims
use '../src/controller.jo'
use '../src/world.jo'
use '../src/world_point.jo'
use '../src/flight.jo'
use '../src/combat.jo'
use '../src/leisure.jo'
use '../src/radio_help.jo'
use '../src/game_slots.jo'
use '../src/living_types.jo'
use '../src/settlements.jo'
from '../src/canal_traffic.jo' import canal_route_point
from '../src/river_data.jo' import CANAL_BEGIN
from '../src/water_field.jo' import water_at
use '../src/touch.jo'
use '../src/rt_pad.jo'
use '../src/vessel_scene.jo'
use '../src/vessel_types.jo'
use '../src/weather_scene.jo'
use '../src/air_events.jo'
use '../src/air_race.jo'
use '../src/debugmenu.jo'
import '../src/living_jobs.jo' as jobs

finish_settlement_registry()
base_update:(f64)->void=game.update
base_draw:()->void=game.draw
case=env("PLAYTEST_CASE") ?? "room"
stage=0
frames=0
waited=0
limit=to_int(env("PLAYTEST_FRAMES") ?? "3000") ?? 3000

note=(text:str):print("PLAYTEST {case} f={frame_number()} stage={stage}: {text}")
offers_text=()->str:
    out=""
    loop o in game.offers_now():out=out+"[{game.offer_key_name(o.key)} {o.words} ({o.act})]"
    out
state_text=()->str:"mode={game.me.mode} ui={game.ui} leisure_ui={game.leisure_ui} stay={game.stay.active} scenario='{game.active_scenario}' moored={game.pc.state.moored} water={game.pc.state.on_water} fuel={game.pc.state.fuel:.1} crashed={game.pc.state.crashed} cents={game.player_cents()}"
next=(n:int):
    global stage,waited
    stage=n;waited=0
saved=(slot:int)->bool:game.game_save_command=="" and not game.game_saves.busy and game.game_slot_views.len()==3 and game.game_slot_views[slot].exists
loaded=()->bool:game.game_save_command=="" and not game.game_save_status().busy

pressing=false
key_down=false
# A key pressed for one frame, as the touch pad's buttons press them
press_key=(k:Key):
    global key_down
    game.pad.pressed.push(k);key_down=true
# The k-th thing on offer chosen, as a controller's button chooses it (for the next update only).
press=(act:str)->bool:
    global pressing
    o=game.offers_now()
    loop k in 0..o.len():
        if o[k].act==act:
            ctl.choice=k;pressing=true
            return true
    false
has_offer=(act:str)->bool:
    loop o in game.offers_now():
        if o.act==act:return true
    false
# The walker put beside a point (as if he had walked there), on the ground.
walk_to=(p:vec3,back:f64=2.0):
    d=normalize(vec3(game.me.pos.x-p.x,0,game.me.pos.z-p.z)+vec3(0.001,0,0))
    q=p+d*f32(back)
    game.me.pos=vec3(q.x,f32(game.walk_height(game.towns,f64(q.x),f64(q.z))),q.z)
    game.walker_point=world_point(game.me.pos)

update = (dt: f64):
    global frames,waited,pressing,key_down
    audit_finger()
    base_update(dt)
    if pressing:
        ctl.choice=-1;pressing=false
    if key_down:
        game.pad.pressed=[];key_down=false
    frames+=1;waited+=1
    assert(frames<limit,"PLAYTEST {case}: stuck at stage {stage}: {state_text()} offers {offers_text()}")
    if game.game_saves.error!="":
        w=game.living_world;mine=w.people[w.player].craft
        loop k in 0..w.aircraft.len():
            if w.aircraft[k].move_owner==.scene:
                ci=combat_index(game.battle,k)
                o=w.aircraft[k].owner
                inair=false
                loop pl in game.air_events.pilots:
                    if pl.craft==k:inair=true
                loop pl in game.air_events.arm:
                    if pl.craft==k:inair=true
                print("PLAYTEST   craft {k} owner {if o>=0: w.people[o].name else: "-"} occupation {if o>=0: to_text(w.people[o].occupation) else: "-"} air_events={inair} kind {w.aircraft[k].kind} place {w.aircraft[k].place}")
                print("PLAYTEST scene-owned craft {k} player={k==mine} combat={ci} status={if ci>=0: to_text(game.battle.actors[ci].status) else: "-"} present={if ci>=0: game.battle.actors[ci].present else: false} state={w.aircraft[k].state} trip={w.aircraft[k].trip}")
    assert(game.game_saves.error=="","PLAYTEST {case}: save error {game.game_saves.error}")
    if case=="room":room_case()
    if case=="delivery":delivery_case()
    if case=="strait-home" or case=="canal":situation_case()
    if case=="tow":tow_case()
    if case=="broke":broke_case()
    if case=="fuel":fuel_case()
    if case=="night":night_case()
    if case=="ride":ride_case()
    if case=="strait-lose":strait_lose_case()
    if case=="dry":dry_case()
    if case=="bail" or case=="bail-canal" or case=="bail-sea":bail_case()
    if case.starts_with("audit-"):audit_case()

# A room for the night, saved in the room and loaded again in the same session: the pilot must be
# back on foot by the desk with the room gone, not held in a room he can no longer leave.
room_case=():
    if stage==0:
        if game.game_slot_views.len()!=3 or game.game_saves.busy or not game.living_world.far.populated or not game.stay.active:return
        note("in the room: {state_text()}")
        assert(game.request_game_save(1));next(1)
    else if stage==1:
        if not saved(1):return
        note("saved in the room")
        assert(game.request_game_load(1));next(2)
    else if stage==2:
        if not loaded():return
        note("loaded: {state_text()} offers {offers_text()}")
        assert(not game.stay.active,"the room outlived the load: the pilot can't leave it")
        assert(game.me.mode==.walking and game.ui==.none)
        d=f64(length(game.me.pos.xz-game.hotel.desk.xz))
        assert(d<6.0,"loaded {d:.1} m from the hotel desk")
        next(3)
    else if stage==3 and waited>60:
        note("walking after the load: {state_text()}")
        print("PLAYTEST PASS {case}")
        exit(0)

# The first delivery, staged moored at its destination (AEGEAN_CAPTURE_DELIVERY + _MOORED): ashore,
# saved and loaded with the receiver waiting, then handed over and signed for, and paid.
delivery_job=-1
cents_before=0
seen_waiting=false
delivery_case=():
    global delivery_job,cents_before,seen_waiting,waited
    w=game.living_world
    if stage==0:
        if game.game_slot_views.len()!=3 or game.game_saves.busy or not w.far.populated or waited<30:return
        delivery_job=game.capture_delivery_job
        assert(delivery_job>=0,"no job staged")
        note("moored at the destination: {state_text()} offers {offers_text()} job {w.jobs[delivery_job].state} loaded {w.jobs[delivery_job].loaded}")
        assert(game.me.mode==.aboard)
        o=game.offers_now()
        acts=[loop e in o:e.act]
        # (on to the dock: whichever offer takes the pilot ashore)
        chosen=false
        loop a in ["ashore","climb-down","step-ashore","out"]:
            if not chosen and a in acts:chosen=press(a)
        assert(chosen,"moored at the destination with no way ashore: {offers_text()}")
        next(1)
    else if stage==1:
        if game.me.mode!=.walking:
            assert(waited<120,"still not ashore: {state_text()}");return
        note("ashore: {state_text()} offers {offers_text()}")
        assert(game.request_game_save(1));next(2)
    else if stage==2:
        if not saved(1):return
        assert(game.request_game_load(1));next(3)
    else if stage==3:
        if not loaded():return
        note("loaded on the dock: {state_text()} job {w.jobs[delivery_job].state} {portage.cargo_status(w,delivery_job)}")
        next(4)
    else if stage==4:
        # (or the receiver comes and unloads it herself, through the world's carriage: then it is
        # signed for without a handover)
        if w.jobs[delivery_job].state==.delivered:
            cents_before=game.player_cents()-1
            note("collected by the receiver without a handover")
            next(5);return
        rc=portage.cargo_receiver(w,delivery_job)
        if rc>=0 and w.people[rc].carriage>=0 and w.people[rc].carrying>=0:return
        # (the receiver waiting on the dock: the pilot walks up to them)
        who=-1
        loop k in 0..game.folks.len():
            if game.folks[k].shown and portage.cargo_awaited(w,game.folks[k].person)==delivery_job:who=k
        if who<0:
            if waited%600==0:
                rc=portage.cargo_receiver(w,delivery_job)
                rp=if rc>=0:w.people[rc] else:w.people[w.player]
                shown=false;dist=-1.0
                loop f in game.folks:
                    if f.person==rc:shown=f.shown;dist=f64(length(f.pos.xz-game.me.pos.xz))
                note("waiting for the receiver {if rc>=0: rp.name else: "none"}: place {rp.place} trip {rp.trip} carrying {rp.carrying} carriage {rp.carriage} in scene {shown} {dist:.0} m away; minute {w.minute} due {w.jobs[delivery_job].due_minute}; {portage.cargo_status(w,delivery_job)}")
            assert(waited<to_int(env("PLAYTEST_WAIT") ?? "1800") ?? 1800,"nobody comes down to wait for the cargo: {portage.cargo_status(w,delivery_job)} job {w.jobs[delivery_job].state}")
            return
        if not seen_waiting:
            seen_waiting=true;waited=0
        if waited%10==0:walk_to(game.folks[who].pos)
        if has_offer("handover"):
            cents_before=game.player_cents()
            note("receiver {w.people[game.folks[who].person].name} waiting; offers {offers_text()}")
            assert(press("handover"));next(5)
        else:
            cr=w.people[w.player].craft
            assert(waited<1800,"beside the receiver, no handover offered: {offers_text()} (aircraft place {w.aircraft[cr].place} trip {w.aircraft[cr].trip} state {w.aircraft[cr].state}; destination {w.jobs[delivery_job].destination}; receiver {game.folks[who].pos} me {game.me.pos})")
    else if stage==5:
        if w.jobs[delivery_job].state!=.delivered:
            assert(waited<3600,"handed over but never signed for: {portage.cargo_status(w,delivery_job)}");return
        note("signed for after {waited} frames, paid {game.player_cents()-cents_before}: {state_text()} offers {offers_text()}")
        assert(game.player_cents()>cents_before,"delivered without pay")
        print("PLAYTEST PASS {case}")
        exit(0)

# The player's aircraft brought in to its side's home dock, as a pilot who has flown there lands and ties up
come_in_home=():
    me=combat_index(game.battle,game.living_world.people[game.living_world.player].craft)
    assert(me>=0)
    side=game.battle.actors[me].side
    found=false
    loop hm in game.battle.homes:
        if hm.side==side and not found:
            found=true
            h=hm.heading
            game.pc.state=water_start(game.pc.spec,vec3(hm.dock.x,0,hm.dock.z),h)
            moor(game.pc.state,vec3(hm.dock.x,f32(game.pc.spec.float_height),hm.dock.z),h)
            game.pc.throttle=0.0;game.pc.state.throttle=0.0
            game.capture_after="";game.capture_canal_run=false
            game.tie_up()
            note("flown in to the home dock at place {hm.place}")
    assert(found,"no home harbour for the player's side: nowhere the situation leads")

# A situation (AEGEAN_SCENARIO=strait with AEGEAN_CAPTURE_STRAIT_AFTER=home: the side's homeward
# flight; or the canal escape with AEGEAN_CAPTURE_CANAL_RUN) played to its arrival: it must hand the
# pilot back to the ordinary game, which can be saved, once moored in a harbour.
situation_case=():
    if stage==0:
        if game.active_scenario=="" or waited<30:return
        note("situation {game.active_scenario} under way: {state_text()}")
        next(1)
    else if stage==1:
        if waited%600==0:
            mi=combat_index(game.battle,game.living_world.people[game.living_world.player].craft)
            sd=if mi>=0:game.battle.actors[mi].side else:1
            foes=0;near=1e9
            loop a in game.battle.actors:
                if a.side!=sd and a.present and a.status==.flying:
                    foes+=1;near=min(near,f64(length(a.state.position.xz-game.pc.state.position.xz)))
            note("{state_text()} pos {game.pc.state.position} home_since {game.battle.home_since[sd]} formed {game.battle.formed[sd]} homes {game.battle.homes.len()} foes flying {foes} nearest {near:.0} m")
        if waited==to_int(env("PLAYTEST_COME_IN") ?? "4000") ?? 4000 and not game.pc.state.moored:come_in_home()
        if game.pc.state.moored or game.me.mode==.walking:
            note("moored: {state_text()} offers {offers_text()}")
            next(2)
    else if stage==2:
        if waited<180:
            if waited%10==1:note("moored? {game.pc.state.moored} scenario '{game.active_scenario}' throttle {game.pc.throttle:.2} speed {length(game.pc.state.velocity):.2}")
            return
        note("after mooring: {state_text()} offers {offers_text()}")
        assert(game.active_scenario=="","moored in harbour after the {game.active_scenario} situation, still inside it: no saving, no way on to the ordinary game")
        assert(game.request_game_save(1));next(3)
    else if stage==3:
        if not saved(1):return
        note("saved the carried-on game")
        print("PLAYTEST PASS {case}")
        exit(0)

# The call for help, as a player waits it out: R calls (done by the case), then "Wait for them" once
# the boat is under way and again under tow, as the pad's R/T offers it.
help_waited=HelpStage.none
wait_for_help=():
    global help_waited
    if game.skip.active:return
    s=game.sos
    if s.by!=.wingman and s.stage!=help_waited and ((s.stage==.coming and s.since>2.0) or (s.stage==.towing and s.since>6.0)):
        help_waited=s.stage
        game.help_wait()
    if waited%240==0:note("help: {s.stage} by {s.by} ({s.name}), to {s.harbour_name}: {state_text()}")

# Wrecked in flight (AEGEAN_FLYING), the world records the damage; R calls for help: she must come
# home whole and tied up, not wrecked again by the record's old damage.
tow_case=():
    w=game.living_world;c=w.people[w.player].craft
    if stage==0:
        if not w.far.populated or waited<60:return
        # (PLAYTEST_TOW=shot: badly hit first, flying on while the world records it, then down)
        if env("PLAYTEST_TOW")=="shot":
            game.pc.state.hull_damage=0.9;game.pc.state.engine_damage=0.85
            note("shot up: {state_text()}")
            next(10);return
        game.pc.state.hull_damage=0.97;game.pc.state.crashed=true;game.pc.state.throttle=0;game.pc.throttle=0
        note("wrecked: {state_text()} record hull {w.aircraft[c].hull} engine {w.aircraft[c].engine}")
        next(1)
    else if stage==10:
        if waited<180:return
        note("flying on hit: record hull {w.aircraft[c].hull} engine {w.aircraft[c].engine}")
        game.pc.state.crashed=true;game.pc.state.throttle=0;game.pc.throttle=0
        next(1)
    else if stage==1:
        if waited<240:return
        note("down: {state_text()} record hull {w.aircraft[c].hull} engine {w.aircraft[c].engine} fuel_ml {w.aircraft[c].fuel_ml}")
        assert(game.pc.state.crashed,"the wreck isn't a wreck")
        press_key(.r);next(2)
    else if stage==2:
        wait_for_help()
        assert(waited<6000,"called for help and never brought in: {game.sos.stage}")
        if game.sos.stage!=.none or game.skip.active or waited<60:return
        note("towed: {state_text()} record hull {w.aircraft[c].hull} engine {w.aircraft[c].engine} offers {offers_text()}")
        assert(not game.pc.state.crashed,"towed home and wrecked again (the record's hull {w.aircraft[c].hull})")
        assert(game.pc.state.moored,"towed home but not tied up")
        print("PLAYTEST PASS {case}")
        exit(0)

# Broke and dry at home (no money, an empty tank): some way to earn must stay open (a job on foot,
# a charter that supplies its fuel), or the game ends there with no way on.
broke_case=():
    w=game.living_world;c=w.people[w.player].craft
    if stage==0:
        if not w.far.populated or waited<60:return
        game.debug_cents(0);game.debug_fuel_ml(c,0);game.pc.state.fuel=0
        next(1)
    else if stage==1:
        if waited<30:return
        reasons:{str:int}={}
        open=0;ok=0;foot=0;charter=0
        loop id in w.active_jobs:
            j=w.jobs[id]
            if j.state!=.open or j.origin!=w.people[w.player].place:continue
            open+=1
            r=claims.claim_refusal(w,id,w.player)
            key=if r=="":"claimable" else:r
            reasons[key]=reasons.get(key,0)+1
            if r=="":
                ok+=1
                if j.delivery_mode==.foot:foot+=1
                if j.wet_charter:charter+=1
        note("broke and dry: {state_text()} open jobs here {open}: {reasons} (claimable on foot {foot}, charters {charter}) offers {offers_text()}")
        if ok>0:
            print("PLAYTEST PASS {case}")
            exit(0)
        next(2)
    else if stage==2:
        # (time passes, an hour at a time, as it would sitting at the café: does anything turn up?)
        if waited%5!=0:return
        life.advance_minutes(w,60)
        hours=waited/5
        ok=0;foot=0;why:{str:int}={}
        loop id in w.active_jobs:
            j=w.jobs[id]
            if j.state!=.open or j.origin!=w.people[w.player].place:continue
            r=claims.claim_refusal(w,id,w.player)
            why[if r=="": "claimable" else: r]=why.get(if r=="": "claimable" else: r,0)+1
            if r=="":
                ok+=1
                if j.delivery_mode==.foot:foot+=1
        if ok>0 or hours>=24:
            note("after {hours} h: {why} (on foot {foot}) cents {game.player_cents()} fuel_ml {w.aircraft[c].fuel_ml}")
            assert(ok>0,"broke with an empty tank at home: nothing to take for a whole day, a dead end")
            print("PLAYTEST PASS {case}")
            exit(0)

# At home on the quay: aboard, the pier's fuel bought into a drained tank, saved and loaded with it.
fuel_before=0.0
fuel_cents=0
fuel_case=():
    global fuel_before,fuel_cents
    w=game.living_world;c=w.people[w.player].craft
    if stage==0:
        if not w.far.populated or waited<60:return
        note("on the quay: {state_text()} offers {offers_text()}")
        assert(press("aboard"),"no way aboard from the start: {offers_text()}");next(1)
    else if stage==1:
        if game.me.mode!=.aboard:
            assert(waited<120,"not aboard");return
        game.debug_fuel_ml(c,6000);game.pc.state.fuel=6.0
        next(2)
    else if stage==2:
        if waited<30:return
        note("aboard with 6 L: offers {offers_text()}")
        fuel_before=game.pc.state.fuel;fuel_cents=game.player_cents()
        assert(press("fuel"),"alongside the home pier with a dry tank, no fuel offered: {offers_text()}");next(3)
    else if stage==3:
        if game.ui!=.fuel:
            assert(waited<120,"the fuel panel didn't open: {state_text()}");return
        game.fuel_take(0);next(4)
    else if stage==4:
        if waited<120:return
        note("filled: {state_text()} paid {fuel_cents-game.player_cents()}")
        assert(game.pc.state.fuel>fuel_before+10.0,"bought no fuel")
        game.ui=.none
        fuel_before=game.pc.state.fuel
        assert(game.request_game_save(1));next(5)
    else if stage==5:
        if not saved(1):return
        game.pc.state.fuel=0
        assert(game.request_game_load(1));next(6)
    else if stage==6:
        if not loaded():return
        note("loaded: {state_text()} offers {offers_text()}")
        assert(abs(game.pc.state.fuel-fuel_before)<0.01,"the fuel bought didn't survive the load")
        print("PLAYTEST PASS {case}")
        exit(0)

# A night in the hotel's room (AEGEAN_LEISURE=stay-hotel): asleep till morning, then out by the desk.
night_case=():
    w=game.living_world
    if stage==0:
        if not w.far.populated or not game.stay.active or waited<30:return
        note("in the room at {game.lt.local_minute(w.minute)/60}h: {state_text()}")
        game.stay_sleep(rest_minutes(w,420),"Sleeping");next(1)
    else if stage==1:
        if game.skip.active or waited<10:return
        note("woke at {game.lt.local_minute(w.minute)/60}h, stage {game.stay.stage}")
        assert(game.stay.active,"woke and the room was gone")
        game.stay_end();next(2)
    else if stage==2:
        if waited<60:return
        note("out of the room: {state_text()} offers {offers_text()}")
        assert(not game.stay.active and game.me.mode==.walking and game.ui==.none,"still held in the room")
        print("PLAYTEST PASS {case}")
        exit(0)

# A pleasure flight (AEGEAN_LEISURE=ride-air with AEGEAN_FLYING): brought in to a dock, the guest thanks
# the pilot and goes; the game carries on with nothing held.
ride_case=():
    w=game.living_world
    if stage==0:
        if not w.far.populated or waited<60:return
        note("flying with a guest: ride stage {game.ride.stage} {state_text()}")
        assert(game.ride.stage==.flying,"no guest aboard")
        tw=game.towns[0];d=tw.docks[0];o=vec3(tw.out.x,0,tw.out.y);h=atan2(-f64(o.x),f64(o.z))
        game.pc.state=water_start(game.pc.spec,vec3(d.x,0,d.z),h)
        moor(game.pc.state,vec3(d.x,f32(game.pc.spec.float_height),d.z),h)
        game.pc.throttle=0.0;game.tie_up();game.capture_takeoff=false
        next(1)
    else if stage==1:
        if waited%120==0:note("ride stage {game.ride.stage} {state_text()} offers {offers_text()}")
        if game.ride.stage==.none:
            note("the guest has gone: {state_text()} offers {offers_text()}")
            print("PLAYTEST PASS {case}")
            exit(0)
        if game.me.mode==.aboard and waited==240:press("ashore")
        assert(waited<3000,"the pleasure flight never ends: ride stage {game.ride.stage}")

# Lost in the strait: call on the way down, board the responder, then use the
# passenger's return-home action. The situation must hand back a saveable game.
strait_help_answered=false
strait_help_boarded=false
strait_responder = -1
strait_lose_case=():
    global strait_help_answered,strait_help_boarded,strait_responder
    w=game.living_world
    if stage==0:
        if game.active_scenario!="strait" or waited<300:return
        game.pc.state.hull_damage=0.97;game.pc.state.crashed=true;game.pc.throttle=0;game.pc.state.throttle=0
        note("shot down: {state_text()}");next(1)
    else if stage==1:
        if waited<300:return
        note("calling for help: {state_text()} offers {offers_text()}")
        press_key(.r);next(2)
    else if stage==2:
        wait_for_help()
        if game.sos.stage!=.none and not strait_help_answered:
            assert(game.sos.by==.wingman,"the strait flight did not answer the call")
            strait_help_answered=true
            strait_responder=game.sos.who
        if strait_responder>=0 and (game.sos.by==.launch or game.sos.by==.ship):
            i=combat_index(game.battle,strait_responder)
            assert(i<0 or not game.battle.actors[i].present or game.battle.actors[i].status!=.flying,"a flying wingman abandoned the call")
            note("the {game.sos.by} took over after craft {strait_responder} was lost")
            strait_responder = -1
        if game.sos.aboard and not strait_help_boarded:
            assert(game.help_swim_s<45,"the rescue required {game.help_swim_s:.0} seconds of swimming to {game.sos.by}")
            strait_help_boarded=true
            note("aboard the {game.sos.by} after a {game.help_swim_s:.0} s swim")
        if game.sos.stage==.carrying and game.help_aboard_done() and game.help_carrier_up():press_key(.f)
        if game.active_scenario=="" and waited>60 and game.sos.stage==.none:
            note("handed back: {state_text()} offers {offers_text()}")
            assert(strait_help_answered and strait_help_boarded,"the wreck never went through the rescue")
            c=w.people[w.player].craft
            assert(not game.pc.state.crashed and not game.pc.state.capsized,"the rescue handed back a wreck")
            assert(w.aircraft[c].hull>350 and w.aircraft[c].engine>350,"the recovered aircraft is still broken in the registry")
            assert(game.request_game_save(1));next(3)
        else:
            if game.sos.by==.wingman and waited%1200==0:
                i=combat_index(game.battle,game.sos.who)
                if game.battle.assist.craft!=game.sos.who:
                    note("waiting for the wreck to settle, speed {length(game.pc.state.velocity.xz):.0} m/s")
                else if i>=0:
                    a=game.battle.actors[i]
                    distance=length((a.state.position-game.pc.state.position).xz)
                    note("wingman {a.pilot.plan.phase}, {a.state.position.y:.0} m high, {distance:.0} m from wreck")
            assert(waited<60*450,"rescue after losing the strait stalled (help {game.sos.stage} by {game.sos.by})")
    else if stage==3:
        if not saved(1):return
        print("PLAYTEST PASS {case}")
        exit(0)

# Out of fuel over the sea (AEGEAN_FLYING): the engine dies, she comes down on the water, intact;
# the R/T (C, or its plate) then has the call for help (a flare out of its reach).
dry_case=():
    w=game.living_world;c=w.people[w.player].craft
    if stage==0:
        if not w.far.populated or waited<60:return
        game.debug_fuel_ml(c,0);game.pc.state.fuel=0;game.pc.throttle=0
        # (PLAYTEST_DRY=afloat: already down on the water, intact, out at sea)
        if env("PLAYTEST_DRY")=="afloat":
            at=game.pc.state.position;h=game.heading(game.pc.state)
            game.pc.state=water_start(game.pc.spec,vec3(at.x,0,at.z),h);game.pc.state.fuel=0
        note("tank dry at {game.pc.state.position.y:.0} m");next(1)
    else if stage==1:
        if game.pc.state.on_water and length(game.pc.state.velocity)<2.0 and waited>120:
            lines=game.rt_lines()
            note("afloat and powerless: {state_text()} offers [{offers_text()}] R/T {lines} (help {game.RT_HELP}, flare {game.RT_FLARE}) need {game.help_need_now()}")
            assert(game.offers_now().len()>0 or game.RT_HELP in lines or game.RT_FLARE in lines,"afloat, intact and out of fuel at sea: nothing offered, no call for help, no way on")
            print("PLAYTEST PASS {case}")
            exit(0)
        if waited%600==0:note("{state_text()} y {game.pc.state.position.y:.0}")
        assert(waited<9000,"never came down")

# Bail with the normal control, let the boat pick up the swimmer, and keep
# the combatant on the same side and engagement through the handover.
bail_side = -1
bail_engagement = -1
bail_wet = false
bail_boarded = false
bail_flared = false
bail_case = ():
    global bail_side, bail_engagement, bail_wet, bail_boarded, bail_flared
    w = game.living_world
    c = w.people[w.player].craft
    index = combat_index(game.battle, c)
    if stage == 0:
        if index < 0 or game.me.mode != .aboard or waited < 300: return
        if case == "bail-canal":
            if game.pc.state.on_water or game.pc.state.position.y < 30.0: return
            # After the canal takeoff, line up over the lagoon's raised water.
            at = canal_route_point(CANAL_BEGIN + 63, 125.0)
            water = water_at(f64(at.x), f64(at.z))
            assert(water.wet and water.level - surface_height(f64(at.x), f64(at.z)) > 2.0, "lagoon fixture is not over water")
            along = normalize(canal_route_point(CANAL_BEGIN + 64, 125.0).xz - at.xz)
            game.pc.state.position = vec3(at.x, f32(water.level + 45.0), at.z)
            game.pc.state.orientation = quat_euler(0, -atan2(f64(along.x), -f64(along.y)), 0)
            game.pc.state.velocity = vec3(along.x, 0, along.y) * 65.0
            game.pc.state.precise_ready = false
        if case == "bail-sea":
            # Put the already flying aircraft well past the harbour route.
            # The subsequent bailout, descent and rescue are the game loop.
            forward = heading_vector(heading(game.pc.state))
            away = game.pc.state.position + forward * 14000.0
            assert(surface_height(f64(away.x), f64(away.z)) < -15.0, "open-water fixture reached land")
            game.pc.state.position = away
            game.pc.state.precise_ready = false
        bail_side = game.battle.actors[index].side
        bail_engagement = game.battle.actors[index].engagement
        note("bailing out: side {bail_side} engagement {bail_engagement} at {game.pc.state.position}")
        press_key(.t)
        next(1)
    else if stage == 1:
        if not bail_wet:
            loop d in game.battle.descents:
                if d.person != w.player or d.released or d.phase != .swimming: continue
                bail_wet = true
                note("in the water at {d.position}; {offers_text()}")
        if case == "bail-sea" and bail_wet and not bail_flared and has_offer("pickup-flare"):
            bail_flared = true
            press_key(.t)
        if not bail_boarded and game.sos.aboard:
            bail_boarded = true
            assert(game.sos.need == .pickup and game.me.mode == .free)
            note("aboard {game.sos.name}, bound for {game.sos.harbour_name}")
        if waited % 600 == 0: note("{state_text()} pickup {game.sos.stage} offers {offers_text()}")
        if not bail_boarded or game.sos.stage != .none or game.skip.active: return
        assert(bail_wet and (case != "bail-sea" or (bail_flared and game.help_flare_t >= 0.0)))
        assert(game.me.mode == .walking or (game.me.mode == .aboard and game.pc.state.moored), "pickup didn't leave the pilot safe")
        assert(index >= 0 and game.battle.actors[index].side == bail_side and game.battle.actors[index].engagement == bail_engagement, "pickup changed the player's side or engagement")
        assert(not game.battle.actors[index].bailed and not game.pc.state.crashed, "the rescue returned the pilot to the wreck")
        loop d in game.battle.descents:
            assert(d.person != w.player or d.released, "a duplicate player is still in the water")
        note("safe: {state_text()} side {bail_side}, engagement {bail_engagement}")
        next(2)
    else if stage == 2:
        if game.active_scenario != "": return
        assert(game.request_game_save(1))
        next(3)
    else if stage == 3 and saved(1):
        note("handed back and saved")
        print("PLAYTEST PASS {case}")
        exit(0)

audit_draw_recovery=env("PLAYTEST_DRAW_RECOVERY")=="1"
audit_last_draw: (str,bool,str)=("",false,"")
draw = ():
    global audit_last_draw
    key=(str(game.sos.stage),game.sos.aboard,str(game.me.mode))
    if audit_draw_recovery and key!=audit_last_draw:
        audit_last_draw=key
        hidden=game.world_hidden
        game.world_hidden=false
        note("drawing recovery state {key}")
        base_draw()
        game.world_hidden=hidden
    else:base_draw()

# The touch run uses the same finger and first-finger mouse events as the web input.
# Recovery passes only if the corresponding card or menu row takes the tap.
audit_touch=env("AEGEAN_TOUCH")=="1"
audit_tap: vec2?=none
audit_down=false
audit_finger=():
    global audit_tap,audit_down
    if audit_down:
        __touch_event(91,2,0,0)
        __mouse_event(0,false)
        audit_down=false
    else if let p=audit_tap:
        __script_move_mouse(p)
        __touch_event(91,1,f32(__mouse_x),f32(__mouse_y))
        __mouse_event(0,true)
        __press_track()
        audit_tap=none
        audit_down=true

audit_tap_at=(r:Rect) -> bool:
    global audit_tap
    if audit_tap != none or audit_down:return false
    audit_tap=vec2(r.x+r.w*0.5,r.y+r.h*0.5)
    true

audit_slot_button=(button:int) -> bool:
    # First slot on the pause menu's Game page. Use its visible button, as for an R/T row.
    kz=readable_k(16.0)
    sw=f64(screen_width())/kz; sh=f64(screen_height())/kz
    k=if sh>sw:1.45 else:1.15
    pw=if sh>sw:sw-32.0 else:400.0*k
    x=sw-pw-16.0
    top=max(16.0,pad_top_clear(x*kz,(x+pw)*kz)/kz)
    tab_h=if env("PLAYTEST_RT_KEY")=="c":ROW*k else:max(ROW*k,44.0/(kz*ui_points()))
    set_font(game.fonts.ui)
    cols=tabs_per_row(pw-24.0,16.0*tab_h/ROW)
    set_font()
    rows=(shown_pages(game.dbg).len()+cols-1)/cols
    y=top+36.0+f64(rows)*(tab_h+GAP)+3.0*GAP+90.0*k
    bw=(pw-44.0-2.0*GAP)/3.0
    audit_tap_at(Rect((x+22.0+f64(button)*(bw+GAP))*kz,y*kz,bw*kz,42.0*k*kz))

audit_key=(k:Key) -> bool:
    if not audit_touch:
        press_key(k);return true
    loop i in 0..pad.cards.len():
        if pad.card_keys[i]==k:return audit_tap_at(pad.cards[i])
    loop b in pad.buttons:
        if b.key==k:return audit_tap_at(Rect(b.at.x-1,b.at.y-1,2,2))
    false

audit_offer=(a:str) -> bool:
    loop o in game.offers_now():
        if o.act==a:return audit_key(o.key)
    false

audit_radio=(line:int) -> bool:
    if not game.rt.open:
        rt_key=if env("PLAYTEST_RT_KEY")=="c" or (audit_touch and .c in pad.card_keys and not (.y in pad.card_keys)):Key.c else:Key.y
        _=audit_key(rt_key)
        return false
    i=game.rt.lines.index_of(line) ?? -1
    if i<0:return false
    if not audit_touch:
        press_key([Key.n1,Key.n2,Key.n3,Key.n4,Key.n5,Key.n6,Key.n7][i])
        return true
    sw=f64(screen_width())
    tr=throttle_track()
    x=f64(tr.x+tr.w)+24.0
    y=max(f64(tr.y+tr.h)-56.0-38.0*f64(game.rt.lines.len()),60.0)
    audit_tap_at(Rect(x,y+30.0+38.0*f64(i),min(sw*0.4,320.0,sw-x-20.0),34))

audit_at=vec3(0,0,0)
audit_minute=0
audit_start=0.0
audit_frame=0
audit_saved_stage=HelpStage.none
audit_job=-1
audit_passenger=-1
audit_canopy=false
audit_swimming=false
audit_pickup_side=-1
audit_pickup_engagement=-1
audit_boarded=false
audit_search=false
audit_terminal_minute=-1
audit_pass=():
    note("recovered in {f64(frame_number()-audit_frame)/60.0:.2f} real-time seconds at 60 fps ({game.t-audit_start:.2f} active), {game.living_world.minute-audit_minute} world minutes; {state_text()} at {game.pc.state.position}; offers {offers_text()}")
    print("PLAYTEST PASS {case}")
    exit(0)

audit_start_clock=():
    global audit_minute,audit_start,audit_frame
    audit_minute=game.living_world.minute
    audit_start=game.t
    audit_frame=frame_number()

audit_status=()->str:
    s=game.sos
    w=game.living_world; c=w.people[w.player].craft
    "help {s.stage}/{s.by}, aboard {s.aboard}, eta {s.eta}, {state_text()} at {game.pc.state.position}; hull {w.aircraft[c].hull} engine {w.aircraft[c].engine}; cards {pad.card_keys}; R/T {game.rt_lines()}; offers {offers_text()}; {game.toast}"

audit_wait=():
    if game.skip.active or audit_down or waited%18!=0:return
    s=game.sos
    if s.by==.search:
        _=audit_key(.f)
    else if game.me.mode==.descent and s.need==.pickup:
        if s.since>4.0:_=audit_offer("pickup-wait")
    else if s.aboard:
        if game.help_aboard_done() and (s.stage==.towing or (s.stage==.carrying and (s.need==.pickup or game.help_carrier_up()))):_=audit_key(.f)
    else if game.RT_WAIT in game.rt_lines() and s.since>4.0:
        _=audit_radio(game.RT_WAIT)

audit_job_case=():
    global audit_job,audit_passenger,audit_terminal_minute
    w=game.living_world
    c=w.people[w.player].craft
    if stage==0:
        if not w.far.populated or waited<60:return
        if case=="audit-cargo":
            audit_job=game.capture_delivery_job
            assert(audit_job>=0 and w.jobs[audit_job].loaded,"delivery capture did not load")
            audit_passenger=portage.cargo_receiver(w,audit_job)
        else:
            # Claim while the passenger is still at Porto Vecchio. Make them leave before boarding.
            loop p in w.places[0].residents:
                if p!=w.player and w.people[p].place==0 and w.people[p].trip<0 and w.accounts[w.people[p].account].cents>=1200:
                    audit_passenger=p
                    break
            assert(audit_passenger>=0,"no passenger to stage")
            audit_job=jobs.post_job(game.living_world,audit_passenger,1,.none,-1,1,1000,w.minute+300,passenger=audit_passenger)
            assert(audit_job>=0 and life.take_job(game.living_world,audit_job,w.player,.automatic),"passenger claim refused")
            game.me.mode=.aboard
        assert(audit_passenger>=0)
        game.living_world.people[audit_passenger].place=2
        game.living_world.people[audit_passenger].state=.departed
        game.living_world.people[audit_passenger].pose.pos=w.harbors[2].center
        j=game.living_world.jobs[audit_job]
        audit_terminal_minute=j.expire_minute
        audit_start_clock()
        note("job {audit_job} {j.state} loaded {j.loaded}; person {audit_passenger} gone, expires in {audit_terminal_minute-w.minute} minutes")
        next(1)
    else if stage==1:
        if audit_offer("ashore"):next(2)
    else if stage==2:
        if game.me.mode!=.walking:return
        assert(w.jobs[audit_job].state==.claimed and not (audit_passenger in w.aircraft[c].passengers),"the missing person was treated as present")
        note("still free to step ashore; {state_text()}, {portage.cargo_status(w,audit_job)}; offers {offers_text()}")
        life.advance_minutes(game.living_world,max(1,audit_terminal_minute-w.minute+1))
        next(3)
    else if stage==3 and waited>20:
        assert(w.jobs[audit_job].state==.failed and w.accounts[w.jobs[audit_job].escrow_account].cents==0,"the expired job or its escrow is stuck")
        if case=="audit-passenger":assert(not (audit_job in w.aircraft[c].job_manifests),"expired passenger still blocks the hold")
        note("deadline passed; job {w.jobs[audit_job].state}, escrow {w.accounts[w.jobs[audit_job].escrow_account].cents}, return port {w.jobs[audit_job].return_place}")
        audit_pass()

audit_case=():
    global audit_at,audit_saved_stage,audit_canopy,audit_swimming,audit_pickup_side,audit_pickup_engagement,audit_boarded,audit_search
    if case=="audit-cargo" or case=="audit-passenger":audit_job_case();return
    w=game.living_world
    if stage==0:
        if not w.far.populated or game.game_slot_views.len()!=3 or waited<60:return
        c=w.people[w.player].craft
        game.me.mode=.aboard
        game.pc.cockpit_view=false
        if env("PLAYTEST_RACE")=="1":
            game.stage_capture_race("racing")
            meet=air_meet_index(game.air_events,-7)
            assert(meet>=0 and game.air_events.meets[meet].phase==.racing)
            # A capture made in the opening minute backdates its start before tick zero.
            loop mut entry in game.air_events.meets[meet].entries:
                if entry.human:entry.started_tick=w.tick
        at=game.home.docks[0]+vec3(game.home.out.x,0,game.home.out.y)*3000
        if game.active_scenario=="strait":at=game.pc.state.position
        if game.active_scenario=="canal":
            game.slip.active=false
            # The canal scenario's player and hostile flight stay intact. Land seaward of Porto
            # Vecchio so water depth is independent of how far the launch rolled down the ways.
            assert(combat_index(game.battle,c)>=0)
        if case=="audit-remote":
            at=if env("PLAYTEST_OFF_CHART")=="1":vec3(180000,0,365000) else:vec3(-238000,0,190000)
            assert(help_harbour(at,40000.0)<0,"fixture is within harbour radio reach")
            loop i in 0..8:
                p=at+vec3(f32(cos(f64(i)*TAU/8.0)),0,f32(sin(f64(i)*TAU/8.0)))*20000.0
                assert(surface_height(f64(p.x),f64(p.z)) < -2.0,"island within the fixture's 20 km sample ring")
            assert(surface_height(f64(at.x),f64(at.z)) < -2.0)
            if let name=env("AEGEAN_WEATHER"):weather_fixture(game.living_world,name,at)
        if case=="audit-island":
            p=ISLANDS[2].center
            assert([loop s in world_settlements: if s.region==-3 and s.harbor.len()>0:s.id].len()==0)
            game.me.mode=.walking
            game.place_walker(vec3(p.x,f32(surface_height(f64(p.x),f64(p.y))),p.y))
            audit_start_clock();note("alone on {ISLANDS[2].name} at {game.me.pos}, plane {game.pc.state.position}");next(1);return
        if case=="audit-hotel":
            m=local_minute(w.minute)
            life.advance_minutes(game.living_world,(120-m+1440)%1440)
            game.me.mode=.walking
            walk_to(game.hotel.desk,0.8)
            assert(not leisure_open(game.living_world,game.hotel_place))
            audit_start_clock();note("hotel shut at {local_minute(game.living_world.minute)}; {state_text()}");next(1);return
        if case=="audit-broke":at=game.home.docks[0]+vec3(game.home.out.x,0,game.home.out.y)*18.0
        h=game.heading(game.pc.state)
        if case=="audit-rough":
            p=ISLANDS[0].center+vec2(410,190)
            at=vec3(p.x,f32(surface_height(f64(p.x),f64(p.y))),p.y)
            assert(game.pc.spec.landplane and at.y>20.0 and game.airfield_at(at.xz)<0)
            game.pc.state=ground_start(game.pc.spec,at,h)
        else:
            game.pc.state=water_start(game.pc.spec,vec3(at.x,0,at.z),h)
            if case=="audit-remote":
                game.pc.state.position.y=35.0
                game.pc.state.on_water=false
                game.pc.state.velocity=game.forward(game.pc.state)*f32(game.pc.spec.stall_speed*game.pc.spec.handling_scale*1.2)
            if case=="audit-bail-canal":
                lagoon=canal_route_point(CANAL_BEGIN+63,125.0)
                water=water_at(f64(lagoon.x),f64(lagoon.z))
                assert(water.wet and water.level-surface_height(f64(lagoon.x),f64(lagoon.z))>2.0)
                game.pc.state.position=vec3(lagoon.x,f32(water.level+60.0),lagoon.z)
                game.pc.state.precise_ready=false
                game.pc.state.on_water=false
                ci=combat_index(game.battle,c)
                assert(game.active_scenario=="canal" and ci>=0)
                side=game.battle.actors[ci].side
                audit_pickup_side=side
                audit_pickup_engagement=game.battle.actors[ci].engagement
                game.battle.actors[ci].state=game.pc.state
                loop mut a in game.battle.actors:
                    if a.side!=side and a.engagement==game.battle.actors[ci].engagement:
                        a.status=.escaped;a.present=false
            if case=="audit-ditch" or case=="audit-save-rescue" or case=="audit-land-water":
                game.pc.state.crashed=true
                game.pc.state.capsized=true
                game.pc.state.hull_damage=0.97
            if case=="audit-broke":
                game.debug_cents(0)
                game.pc.state.crashed=true
                game.living_world.aircraft[c].hull=70;game.living_world.aircraft[c].engine=70
        if env("PLAYTEST_SUNK")=="1":
            ci=combat_index(game.battle,c)
            if ci>=0:
                game.battle.actors[ci].status=.wreck
                game.battle.actors[ci].wreck_age=91.0
            game.pc.state.position.y= -2.0
        game.pc.throttle=0
        if case!="audit-bail-canal":
            game.debug_fuel_ml(c,0)
            game.pc.state.fuel=0
        audit_at=game.pc.state.position
        audit_start_clock()
        note("staged at {audit_at}; hour {game.hour:.1f}; weather rain {game.weather_here.rain:.2f}; {audit_status()}")
        next(1)
    else if stage==1:
        if waited==30:note("{audit_status()}; hour {game.hour:.1f} rain {game.weather_here.rain:.2f}")
        if case=="audit-bail-canal":
            if game.me.mode==.aboard and waited>3:
                _=audit_key(.t)
                return
            assert(game.active_scenario=="canal","scenario ended while the pilot was still coming down")
            loop d in game.battle.descents:
                if d.person!=w.player or d.released:continue
                if d.phase==.canopy and not audit_canopy:
                    audit_canopy=true;note("enemy gone; under canopy, situation {game.active_scenario}")
                if d.phase==.swimming:
                    if not audit_swimming:audit_swimming=true;note("enemy gone; pilot swimming, situation {game.active_scenario}")
                    if audit_offer("pickup-flare"):next(2);return
            return
        if waited<30:return
        if case=="audit-save-tow" or case=="audit-save-rescue":
            # Stage a boat with the existing flare. Keep all subsequent actions on the player UI.
            game.help_call(true)
            assert(game.sos.vessel>=0,"no boat dispatched for the saved-recovery fixture")
            note("staged a boat out to the aircraft; {audit_status()}")
            next(2)
            return
        if case=="audit-island" or case=="audit-hotel" or case=="audit-rough":
            a=if case=="audit-island":"shore-help" else:if case=="audit-hotel":"wait-desk" else:"fetch"
            if audit_offer(a):next(2)
            else if waited==180:assert(false,"no reachable {a}: {audit_status()}")
            return
        need=game.help_need_now()
        if game.sos.stage!=.none:next(2);return
        if game.pc.spec.landplane or game.help_wreck():
            if audit_key(.r):next(2)
        else if need!=.none and game.pc.state.on_water:
            if audit_radio(if game.help_in_reach():game.RT_HELP else:game.RT_FLARE):next(2)
        if waited%180==0:note("looking for recovery: {audit_status()}")
    else if stage==2:
        s=game.sos
        if waited%180==1:note(audit_status())
        if case=="audit-bail-canal":
            if game.sos.aboard and not audit_boarded:
                audit_boarded=true
                note("aboard {s.name}, bound for {s.harbour_name}")
            if s.by==.search and not audit_search:
                audit_search=true
                note("the live pickup fell back to the search wait")
            if env("PLAYTEST_PICKUP_FALLBACK")=="1" and s.need==.pickup and s.vessel>=0:
                k=vessel_index(game.vessels,s.vessel)
                if k>=0:game.vessels.ships[k].status=.sunk
            if game.active_scenario=="" and s.stage==.none and not game.skip.active:
                assert(audit_canopy and audit_swimming and game.help_flare_t>=0.0)
                if env("PLAYTEST_PICKUP_FALLBACK")=="1":assert(audit_search and not audit_boarded)
                else:assert(audit_boarded and not audit_search)
                ci=combat_index(game.battle,w.people[w.player].craft)
                assert(ci>=0 and game.battle.actors[ci].side==audit_pickup_side and game.battle.actors[ci].engagement==audit_pickup_engagement)
                assert(game.me.mode==.walking and not game.help_wreck())
                audit_pass()
        if case=="audit-save-tow" or case=="audit-save-rescue":
            phase=if env("PLAYTEST_SAVE_PHASE")=="boarding":HelpStage.alongside else:HelpStage.towing
            if s.stage==phase and (phase!=.alongside or s.aboard):
                assert(s.aboard==(case=="audit-save-rescue"))
                audit_saved_stage=s.stage
                note("save in progress: {audit_status()}")
                if audit_touch:
                    if audit_key(.p):next(6)
                else:
                    assert(game.request_game_save(0));next(3)
                return
        audit_wait()
        if waited<20 or game.skip.active:return
        if case=="audit-hotel" and leisure_open(w,game.hotel_place):audit_pass()
        if case=="audit-island" and game.me.mode==.walking and length(game.me.pos.xz-game.home.center.xz)<1000.0:audit_pass()
        if case=="audit-broke" and s.stage==.none and not game.help_wreck():
            if game.me.mode==.aboard:_=audit_offer("ashore")
            else if game.me.mode==.walking:
                c=w.people[w.player].craft
                assert(w.aircraft[c].engine>350 and w.aircraft[c].hull>350 and game.player_cents()==0,"still grounded by the broken aircraft or charged more than the purse")
                audit_pass()
        if game.active_scenario=="" and s.stage==.none and length(game.pc.state.position.xz-audit_at.xz)>25.0:
            if env("PLAYTEST_RACE")=="1":
                meet=air_meet_index(game.air_events,-7)
                assert(meet>=0,"staged race no longer tracked")
                entry=player_air_entry(game.air_events.meets[meet],w.player)
                assert(entry!=none and entry!.disqualified,"ditched pilot remains in the race")
            if game.pc.spec.landplane:
                if game.airfield_at(game.pc.state.position.xz)>=0 and not game.pc.state.crashed:audit_pass()
            else if (game.pc.state.moored or (game.pc.state.fuel>5.0 and not game.help_wreck())) and not game.help_wreck():audit_pass()
        if waited==420 and game.active_scenario=="" and s.stage==.none and not game.skip.active:
            assert(false,"no recovery went ahead: {audit_status()}")
    else if stage==3 and saved(0):
        if audit_touch:
            if audit_slot_button(1):next(7)
        else:
            assert(game.request_game_load(0));next(4)
    else if stage==4 and loaded():
        note("loaded mid-{audit_saved_stage}: {audit_status()}")
        assert(game.sos.stage==audit_saved_stage,"tow or rescue lost on load")
        next(5)
    else if stage==5:
        audit_wait()
        if waited>20 and not game.skip.active and game.sos.stage==.none and game.pc.state.moored and not game.help_wreck():audit_pass()
    else if stage==6 and game.paused and waited>2:
        if audit_slot_button(0):next(3)
    else if stage==7 and game.dbg.confirm=="load":
        if audit_slot_button(0):next(8)
    else if stage==8 and not game.paused and loaded():
        note("loaded mid-{audit_saved_stage} via Game page: {audit_status()}")
        assert(game.sos.stage==audit_saved_stage,"tow or rescue lost on load")
        next(5)
