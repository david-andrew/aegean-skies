# Headless GPU equivalence: cold cache, movement, wrap and teleport. Green is exact.
use '../src/sea.jo'
use '../src/water_fleck_cache.jo'
use '../src/render_space.jo'
window("Water fleck cache check",640,360)
struct FleckCheckOut:
    pos:vec4
    point:vec2
check_vs=(v:FarSeaVertex,u:SeaParams)->FleckCheckOut:
    FleckCheckOut(vec4(v.pos,0,1),v.pos*vec2(520,350)+u.residual)
check_fs=(i:FleckCheckOut,u:SeaParams)->vec4:
    a=i.point;b=a+vec2(0.23,-0.17);smear=vec2(0.25,-0.11)
    pair=sea_marks_pair(a,b,smear,0,u)
    ref=vec2(sea_marks(a,smear,0,vec2(1,0),u),sea_marks(b,smear,0,vec2(1,0),u))
    delta=max(abs(pair.x-ref.x),abs(pair.y-ref.y))
    if delta>0.00001:return vec4(1,0,0,1)
    vec4(0,1,0,1)
sh=make_shader(shader(check_vs,check_fs))
tri=mesh([FarSeaVertex(vec2(-1,-1)),FarSeaVertex(vec2(3,-1)),FarSeaVertex(vec2(-1,3))])
frame=0
update=(dt:f64):
    global frame
    frame+=1
draw=():
    clear(BLACK);hide_sky()
    render_camera(vec3(0,10,0),vec3(0,0,-1),62,0.1,2000)
    at=if frame<65:vec3(-148205+f32(max(0,frame-32))*0.4,140,-156186-f32(max(0,frame-32))*0.3) else:vec3(144000-f32(frame-65)*0.3,4,123000+f32(frame-65)*0.2)
    draw_custom(():
        prepare_water_flecks(at)
        u=SeaParams();u.origin=render_origin(at);u.residual=at.xz-u.origin.xz
        loop o in 0..3:u.mark_phase[o]=sea_cell_anchor(u.origin.xz,[1.3,3.6,10.0][o])
        u.fleck_cache=water_fleck_texture;u.fleck_rects=water_fleck_rects()
        glDisable(GL_DEPTH_TEST);glDisable(GL_CULL_FACE)
        draw(sh,tri,u)
        glEnable(GL_DEPTH_TEST);glEnable(GL_CULL_FACE)
    )
    rect(-2,-2,1,1,BLACK)
    if let folder=env("FLECK_CHECK_FRAMES"):
        if frame in [1,31,33,40,64,65,96,110]:assert(save_png("{folder}/{frame:03}.png",screenshot()))
