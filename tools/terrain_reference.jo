# CPU reference for the shader's constrained surface; tests only, never gameplay.
use '../src/terrain_data.jo'
use '../src/terrain_lod.jo'
use '../src/world.jo'
use '../src/render_space.jo'

ref_edge = (t: LandRenderData, p: LandPatchData, x: int, z: int, edges: f64[4]) -> f64:
    e = 0.0
    if x == 0: e = max(e, edges[0])
    if x == 32: e = max(e, edges[1])
    if z == 0: e = max(e, edges[2])
    if z == 32: e = max(e, edges[3])
    along = (step: int) -> f64:
        ax = x / step * step; az = z / step * step
        bx = min(ax + step, 32); bz = min(az + step, 32)
        if x == 0 or x == 32: ax = x; bx = x
        else: az = z; bz = z
        f = f64(max(x - ax, z - az)) / f64(step)
        a = render_height(t, p.x + ax, p.z + az)
        b = render_height(t, p.x + bx, p.z + bz)
        a + (b - a) * f
    lev = int(floor(e))
    a = along(1 << lev)
    b = along(min(2 << lev, 32))
    a + (b - a) * (e - f64(lev))

ref_corner = (t: LandRenderData, p: LandPatchData, x: int, z: int, edges: f64[4]) -> f64:
    if x == 0 or x == 32 or z == 0 or z == 32: return ref_edge(t, p, x, z, edges)
    render_height(t, p.x + x, p.z + z)

ref_vertex = (t: LandRenderData, p: LandPatchData, x: int, z: int, lod: f64, edges: f64[4]) -> f64:
    if x == 0 or x == 32 or z == 0 or z == 32: return ref_edge(t, p, x, z, edges)
    lev = int(floor(lod))
    step = min(2 << lev, 32)
    ax = min(x / step * step, 32 - step); az = min(z / step * step, 32 - step)
    parent = triangle_height(ref_corner(t, p, ax, az, edges), ref_corner(t, p, ax + step, az, edges), ref_corner(t, p, ax, az + step, edges), ref_corner(t, p, ax + step, az + step, edges), f64(x - ax) / f64(step), f64(z - az) / f64(step))
    fine = render_height(t, p.x + x, p.z + z)
    fine + (parent - fine) * (lod - f64(lev))

ref_surface = (t: LandRenderData, p: LandPatchData, x: int, z: int, lod: f64, edges: f64[4]) -> f64:
    if x == 0 or x == 32 or z == 0 or z == 32: return ref_edge(t, p, x, z, edges)
    step = 1 << int(floor(lod))
    ax = min(x / step * step, 32 - step); az = min(z / step * step, 32 - step)
    triangle_height(ref_vertex(t, p, ax, az, lod, edges), ref_vertex(t, p, ax + step, az, lod, edges), ref_vertex(t, p, ax, az + step, lod, edges), ref_vertex(t, p, ax + step, az + step, lod, edges), f64(x - ax) / f64(step), f64(z - az) / f64(step))

ref_morph_pixels = (t: LandRenderData, tile: TerrainTile, pi: int, old: f64[], cam: vec3, vp: mat4) -> f64:
    patch = tile.patches[pi]
    before = old[pi]; after = patch.lod
    eb: f64[4] = [before, before, before, before]
    ea: f64[4] = [after, after, after, after]
    changed = before != after
    loop side in 0..4:
        nb = patch.neighbor[side]
        if nb >= 0:
            eb[side] = max(eb[side], old[nb])
            ea[side] = max(ea[side], tile.patches[nb].lod)
            changed = changed or eb[side] != ea[side]
    if not changed: return 0.0
    p = patch.data
    step = 1 << min(int(floor(before)), int(floor(after)))
    worst = 0.0
    loop j in 0..32 / step + 1:
        loop i in 0..32 / step + 1:
            x = i * step; z = j * step
            a = ref_surface(t, p, x, z, before, eb)
            b = ref_surface(t, p, x, z, after, ea)
            world = vec3(f32(tile.x + f64(p.x + x) * MESH_STEP), f32(a), f32(tile.z + f64(p.z + z) * MESH_STEP))
            ca = vp * vec4(render_world(world, cam), 1)
            world.y = f32(b)
            cb = vp * vec4(render_world(world, cam), 1)
            if ca.w <= 1.0 or cb.w <= 1.0: continue
            ndc = ca.xy / ca.w
            if abs(ndc.x) > 1.05 or abs(ndc.y) > 1.05: continue
            delta = (ndc - cb.xy / cb.w) * vec2(640, 360)
            worst = max(worst, f64(length(delta)))
    worst

ref_error_pixels = (t: LandRenderData, tile: TerrainTile, pi: int, cam: vec3, vp: mat4) -> f64:
    patch = tile.patches[pi]
    edges: f64[4] = [patch.lod, patch.lod, patch.lod, patch.lod]
    loop side in 0..4:
        nb = patch.neighbor[side]
        if nb >= 0: edges[side] = max(edges[side], tile.patches[nb].lod)
    p = patch.data
    worst = 0.0
    loop z in 0..33:
        loop x in 0..33:
            a = render_height(t, p.x + x, p.z + z)
            if a < -5.0: continue  # opaque deep sea occludes the seabed
            b = ref_surface(t, p, x, z, patch.lod, edges)
            world = vec3(f32(tile.x + f64(p.x + x) * MESH_STEP), f32(a), f32(tile.z + f64(p.z + z) * MESH_STEP))
            ca = vp * vec4(render_world(world, cam), 1)
            world.y = f32(b)
            cb = vp * vec4(render_world(world, cam), 1)
            if ca.w <= 1.0 or cb.w <= 1.0: continue
            ndc = ca.xy / ca.w
            if abs(ndc.x) > 1.0 or abs(ndc.y) > 1.0: continue
            worst = max(worst, f64(length((ndc - cb.xy / cb.w) * vec2(640, 360))))
    worst

ref_edge_gap = (t: LandRenderData, tile: TerrainTile, pi: int, cam: vec3) -> f64:
    patch = tile.patches[pi]
    edge_states = (i: int) -> f64[4]:
        p = tile.patches[i]
        es: f64[4] = [p.lod, p.lod, p.lod, p.lod]
        loop side in 0..4:
            nb = p.neighbor[side]
            if nb >= 0: es[side] = max(es[side], tile.patches[nb].lod)
        es
    position = (p: LandPatchData, x: int, z: int, es: f64[4]) -> vec3:
        origin = render_origin(cam)
        # Reproduce CPU-origin subtraction followed by GPU f32 addition.
        at = vec2(f32(tile.x + f64(p.x) * MESH_STEP - f64(origin.x)), f32(tile.z + f64(p.z) * MESH_STEP - f64(origin.z)))
        local = vec3(at.x + f32(x) * 14.0, f32(ref_edge(t, p, x, z, es)), at.y + f32(z) * 14.0)
        render_world(local, cam - origin)
    own = edge_states(pi)
    worst = 0.0
    loop side in [1, 3]:
        nb = patch.neighbor[side]
        if nb < 0: continue
        neighbor = tile.patches[nb]
        other = edge_states(nb)
        step = 1 << min(int(floor(patch.lod)), int(floor(neighbor.lod)))
        loop i in 0..32 / step + 1:
            along = i * step
            a = position(patch.data, if side == 1: 32 else: along, if side == 1: along else: 32, own)
            b = position(neighbor.data, if side == 1: 0 else: along, if side == 1: along else: 0, other)
            worst = max(worst, f64(length(a - b)))
    worst
