# The floating notes' drawing, timed: the busiest number of the band's set (the singer, the violin
# and the piano's running arpeggio, three staves) played from NOTE_DRAW_FROM seconds, its notes
# drawn each frame from a camera 8 m off, as the game draws them; prints the drawing's time a
# frame (the mean over the frames after the first second) and the most notes in the air.
#   SLOPPY_FRAMES=900 sloppy --release tools/note_draw_bench.jo
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/band_request.jo'
use '../src/bar_band.jo'
use '../src/live_notes.jo'
use '../src/note_cue.jo'

window("notes", 1280, 720)
b = BandFeed()
live_notes_load(b.feed, bar_note_events(BAR_SET[1].piece, 1), BAR_SET[1].lead)
c = NoteCue()
note_cue_prepare(c, b.feed.notes)
from = to_float(env("NOTE_DRAW_FROM") ?? "40") ?? 40.0
t = 0.0
spent = 0.0; frames = 0; most = 0
update = (dt: f64): t += 1.0 / 60.0
draw = ():
    global spent, frames, most
    clear(rgb(0.1, 0.12, 0.2))
    camera3d(vec3(0, 2.5, 8), vec3(-2, 2.6, 0), 50.0, 0.1, 500.0)
    now = from + t
    frame = int(now * f64(MUSIC_RATE))
    note_cue_age(c, now)
    loop ch in note_cue_take(c, b.feed.notes, frame):
        note_cue_rise(c, ch, vec3(f32(f64(ch[0].part) * 0.15), 1.9, 0), now, none, note_ago(frame, ch[0]))
    note_cue_steer(c, vec3(-1, 0, 0), vec2(0.8, 0.6), 5.0, 1.0 / 60.0)
    t0 = time_ns()
    draw_note_cue(c, now, 1.0, 1.0)
    if t > 1.0:
        spent += f64(time_ns() - t0) / 1e6; frames += 1
    most = max(most, c.rising.len())
    if frame_number() % 300 == 0 and frames > 0: print("NOTE_DRAW {spent / f64(frames):.3} ms a frame over {frames}, most in the air {most}")
