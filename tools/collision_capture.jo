use 'judge_scene.jo'
# Procedural in-game sample: approach a wall, then push diagonally along it.
import '../aegean.jo' as game
use '../src/settlements.jo'
use '../src/town_sites.jo'
use '../src/objects.jo'
use '../src/world_point.jo'
finish_settlement_registry()
capture_site=TownSite()
capture_square=vec3(0,0,0)
loop s in world_settlements:
    if s.name!="Olythoria":continue
    capture_square=s.center
    loop lot in place_lots(s):
        if let parcel=place_ground_lot(s,lot):
            capture_site=site_from_parcel(parcel)
            break
start=site_point(capture_site,0,capture_site.depth*0.5+3)
game.me.pos=vec3(start.x,f32(walk_height(game.towns,start.x,start.y)),start.y)
game.me.mode=.walking
game.judge_ready=true
game.follow.yaw=capture_site.yaw+PI/2
game.follow.placed=false
view_target=game.me.pos+vec3(0,1,0)
f=site_front(capture_site);r=site_right(capture_site)
game.judge_camera=JudgeView(view_target+vec3(f.x*8-r.x*5,4,f.y*8-r.y*5),view_target,"collision sample")
capture_update: (f64)->void=game.update
capture_draw: ()->void=game.draw
update=(dt:f64):
    capture_update(dt)
    frame=frame_number()
    if frame==240:
        game.me.pos=capture_square+vec3(0,0,8)
        game.me.pos.y=f32(walk_height(game.towns,game.me.pos.x,game.me.pos.z))
        game.judge_camera=JudgeView(game.me.pos+vec3(8,6,8),capture_square+vec3(0,1,0),"crowded square")
    # A reproducible stress sample using the town's existing three identities.
    # No additional residents or economic records are created.
    if frame==300:
        loop id in game.living_world.far.near_people:
            at=capture_square+vec3(0,0,-1)
            at.y=f32(walk_height(game.towns,at.x,at.z))
            game.living_world.people[id].pose.pos=at
            game.living_world.far.people[id].target=at
            game.living_world.far.people[id].route=[]
            game.living_world.far.people[id].waypoint=0
            game.living_world.far.people[id].planned_anchor=""
    if frame==470:
        ids=game.living_world.far.near_people
        nearest=1e9
        loop a in 0..ids.len():
            loop b in a+1..ids.len():nearest=min(nearest,f64(length(game.living_world.people[ids[a]].pose.pos.xz-game.living_world.people[ids[b]].pose.pos.xz)))
        print("CROWD_SAMPLE residents={ids.len()} minimum_separation={nearest:.6}")
        loop id in ids:
            loop f in game.folks:
                if f.person==id:print("CROWD_ID {id} name={game.living_world.people[id].name} pose={game.living_world.people[id].pose.pos} rendered={f.precise} shown={f.shown}")
        loop a in 0..game.folks.len():
            loop b in a+1..game.folks.len():
                first=game.folks[a];second=game.folks[b]
                if first.person in ids and second.person in ids:
                    d=world_delta(first.precise,second.precise)
                    print("CROWD_RENDER_PAIR {first.person},{second.person} horizontal={sqrt(f64(d.x)*f64(d.x)+f64(d.z)*f64(d.z)):.6}")
        assert(ids.len()>=3 and nearest>0.5)
    if frame>=60 and frame<240:
        delta= -site_front(capture_site)*0.06
        if frame>=120:delta+=site_right(capture_site)*0.025
        game.me.yaw=atan2(f64(delta.x),f64(delta.y))
        game.me.stride=1;game.me.phase+=dt*8
        game.step_player_walk(delta)
        game.update_player_follow(dt,false)
draw=():
    capture_draw()
    if frame_number()%4==0 and frame_number()>=60:
        if let path=env("COLLIDE_FRAMES"):save_png("{path}/{frame_number():04}.png",screenshot())
