# Reproduce the chart warp in the real game, then retain every frame interval.
# Run timings on redfox under bench.lock. STUTTER_TOWN names a generated place;
# STUTTER_MODE=fly|stay; STUTTER_WARMUP/STUTTER_SECONDS are wall-clock seconds.
# STUTTER_ENFORCE=1 fails on any measured frame >50 ms. Use a fresh save.
build:
    js = "../src/web_compat.js"
import '../aegean.jo' as game
use '../src/settlements.jo'
use '../src/world.jo'
use '../src/objects.jo'
record_stats()
trace_update:(f64)->void=game.update
trace_draw:()->void=game.draw
trace_town=env("STUTTER_TOWN")??"Olythoria"
trace_mode=env("STUTTER_MODE")??"fly"
trace_warmup=to_float(env("STUTTER_WARMUP")??"30")??30.0
trace_seconds=to_float(env("STUTTER_SECONDS")??"60")??60.0
trace_agl=to_float(env("STUTTER_AGL")??"0")??0.0
trace_frame=0
trace_warped=false
trace_measure=1e30
trace_previous=0.0
trace_update_ms=0.0
trace_draw_ms=0.0
trace_rows:vec4[]
trace_done=false
update=(dt:f64):
    global trace_frame,trace_warped,trace_measure,trace_previous,trace_update_ms,trace_done,trace_rows
    now=time()
    elapsed=if trace_previous>0:now-trace_previous else:dt
    if trace_previous>=trace_measure and not trace_done:
        trace_rows.push(vec4(f32(trace_previous-trace_measure),f32((now-trace_previous)*1000),f32(trace_update_ms),f32(trace_draw_ms)))
    if trace_warped and now>=trace_measure+trace_seconds and not trace_done:
        trace_done=true
        worst=0.0;over=0
        loop i in 0..trace_rows.len():
            r=trace_rows[i];worst=max(worst,f64(r.y));if r.y>50:over+=1
            print("STUTTER_FRAME,{i},{r.x:.6},{r.y:.6},{r.z:.6},{r.w:.6}")
        print("STUTTER_END town={trace_town} mode={trace_mode} seconds={now-trace_measure:.3} frames={trace_rows.len()} max_ms={worst:.3} over50={over}")
        print("STUTTER_POSITION at={game.pc.state.position} crashed={game.pc.state.crashed}")
        if env("STUTTER_ENFORCE")=="1":assert(over==0,"Frame exceeded 50 ms after warm-up")
        quit();return
    trace_frame+=1
    if trace_frame==120:
        finish_settlement_registry()
        found=false
        loop s in world_settlements:
            if s.name!=trace_town:continue
            print("STUTTER_WARP town={s.name} id={s.id} at={s.center} mode={trace_mode}")
            game.debug_place(f64(s.center.x),f64(s.center.z),200.0)
            if trace_mode=="stay":
                game.me.mode=.walking
                game.me.pos=vec3(s.center.x,f32(walk_height(game.towns,f64(s.center.x),f64(s.center.z))),s.center.z)
            found=true;break
        assert(found,"Unknown STUTTER_TOWN")
        trace_warped=true;trace_measure=time()+trace_warmup
    if trace_warped and trace_mode=="fly" and trace_agl>0:
        # Sustained terrain-following pass: keep the real game's horizontal
        # flight, streaming, audio and grass updates active below their cutoff.
        p=game.pc.state.position
        game.pc.state.position.y=f32(surface_height(f64(p.x),f64(p.z))+trace_agl)
        game.pc.state.velocity.y=0
    trace_previous=time()
    # Screenshot/headless native runs otherwise force 1/60 independent of the
    # actual frame interval and fly a shorter route than a slow browser run.
    trace_update(elapsed)
    trace_update_ms=(time()-trace_previous)*1000
    if trace_update_ms>50:print("STUTTER_SLOW_UPDATE frame={trace_frame} ms={trace_update_ms:.3} t={game.t:.3}")
draw=():
    global trace_draw_ms
    started=time();trace_draw();trace_draw_ms=(time()-started)*1000
    if trace_draw_ms>50:print("STUTTER_SLOW_DRAW frame={trace_frame} ms={trace_draw_ms:.3} t={game.t:.3}")
    if trace_frame%240==0:print(frame_stats_line())
