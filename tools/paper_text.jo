# Today's paper as plain text, from a seeded world run on for a while (for reading its copy).
#   PAPER_MINUTES=2700 PAPER_SEED=3 sloppy --release tools/paper_text.jo
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/phoenix.jo'
use '../src/townsfolk.jo'
use '../src/newspaper.jo'

w = build_world(u64(to_int(env("PAPER_SEED") ?? "3") ?? 3))
advance_minutes(w, to_int(env("PAPER_MINUTES") ?? "2700") ?? 2700)
extra: PaperPiece[]
loop n in job_notices(w, 0):
    if n.taken_by == "": extra.push(PaperPiece("Notices", "Wanted: {n.title}", "{n.body} Pays {phoenix_text(n.pay)}, {n.due}. Apply to {n.poster}.", 0))
p = newspaper(w, 0, extra)
print("=" * 72)
print(p.title.upper())
print("{p.dateline}                Price {phoenix_text(p.cents)}")
print("=" * 72)
if let lead = p.lead:
    print("")
    print(lead.head.upper())
    print(lead.body)
section = ""
loop piece in p.pieces:
    if piece.section != section:
        section = piece.section
        print("")
        print("-- {section.upper()} --")
    print("")
    print("{piece.head}")
    print("{piece.body}")
if section != "The market":
    print("")
    print("-- THE MARKET --")
print("")
loop row in p.prices: print("{row.good}  {phoenix_text(row.here)}  {row.word}  {row.elsewhere}")
print("")
print("-- WEATHER --")
print(p.weather)
