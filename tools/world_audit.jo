# World sanity audit over every settlement, dock, quay, landing, placed prop,
# building, door and road. Usage:
#   sloppy --release tools/world_audit.jo OUT.txt [ID,ID...|legacy|all] [reach]
# Writes ranked findings (severe first) with coordinates; "reach" also runs the
# walking search from every dock to its settlement (slow; minutes).
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/objects.jo'
use '../src/walk_shapes.jo'
use '../src/thermal_sites.jo'
use '../src/landing_access.jo'
use '../src/world_point.jo'
use '../src/canal_geometry.jo'
use '../src/world_audit.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/settlement_access.jo'
use '../src/town_sites.jo'
use '../src/world_audit_run.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
publish_access_roads(catalog.links)
towns=[loop st in SETTLEMENTS:build_town(st)]
scope=if args().len()>2:args()[2] else:"all"
reach=args().len()>3 and args()[3]=="reach"
wanted:{int:bool}
if scope!="all" and scope!="legacy":
    loop part in split(scope,","):wanted[to_int(part)!]=true
started=time()
ranked=world_audit_run(towns,scope,wanted,reach)
text="# world audit: {ranked.len()} findings, {f64(time()-started):.0f} s\n"
severe=0
loop f in ranked:
    if f.severe:severe+=1
    text+="{if f.severe:"SEVERE" else:"warn"}|{f.score:.0f}|{f.kind}|{f.place}|{f.name}|{f.at.x:.1f}|{f.at.y:.1f}|{f.at.z:.1f}|{f.detail}|{f.key}\n"
assert(write_file(args()[1],text))
print("WORLD AUDIT {ranked.len()} findings ({severe} severe) in {f64(time()-started):.0f} s -> {args()[1]}")
