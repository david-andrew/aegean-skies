# Offline survey for a grass airfield near a capital: a strip of naturally flat, dry, open
# ground (no regrading: the terrain stays as baked), clear of the town, its roads, rivers
# and lakes, with clear approaches off both ends. Prints the best candidates.
#   sloppy --release tools/airfield_survey.jo [capital name] [strip length m]
#   sloppy --release tools/airfield_survey.jo check x z heading length    (one site, as AIRFIELDS has it)
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/water_field.jo'
use '../src/flight_ground.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/settlement_access.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
# (the access roads too, as the world audit has them: a field must not straddle any road)
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
publish_access_roads(catalog.links)
checking=args().len()>5 and args()[1]=="check"
want=if checking:"Kalyrassa" else:(if args().len()>1:args()[1] else:"Kalyrassa")
strip=if args().len()>2:f64(to_int(args()[2]) ?? 700) else:700.0
town=-1
loop i in 0..world_settlements.len():
    if world_settlements[i].name==want:town=i
assert(town>=0,"no settlement named {want}")
s=world_settlements[town]
print("{s.name}: id {s.id} centre {s.center} out {s.out} radius {s.radius:.0f} country {s.country}")

struct Candidate:
    at:vec2
    heading:f64
    score:f64
    level:f64
    grade:f64
    rough:f64
    side:f64

# The strip's heights on a 10 m grid (3 lanes 25 m apart), fitted by a plane along it.
judge=(c:vec2,h:f64,len:f64)->Candidate?:
    dir=vec2(f32(sin(h)),f32(-cos(h)));side=vec2(-dir.y,dir.x)
    xs:f64[];ys:f64[];hs:f64[]
    n=int(len/10.0)
    loop lane in [-25.0,0.0,25.0]:
        loop i in 0..n+1:
            t=-len*0.5+f64(i)*10.0
            p=c+dir*f32(t)+side*f32(lane)
            if water_at(f64(p.x),f64(p.y)).wet or settlement_urban(p) or settlement_on_road(p):return none
            g=flight_surface_height(f64(p.x),f64(p.y))
            if g<4.0:return none
            xs.push(t);ys.push(lane);hs.push(g)
    # least squares plane h = a + b t + d lane
    m=f64(xs.len());st=0.0;sl=0.0;sh=0.0;stt=0.0;sll=0.0;sth=0.0;slh=0.0
    loop i in 0..xs.len():
        st+=xs[i];sl+=ys[i];sh+=hs[i];stt+=xs[i]*xs[i];sll+=ys[i]*ys[i];sth+=xs[i]*hs[i];slh+=ys[i]*hs[i]
    b=(sth-st*sh/m)/max(stt-st*st/m,1.0);d=(slh-sl*sh/m)/max(sll-sl*sl/m,1.0);a=(sh-b*st-d*sl)/m
    rough=0.0
    loop i in 0..xs.len():rough=max(rough,abs(hs[i]-(a+b*xs[i]+d*ys[i])))
    if abs(b)>0.02 or abs(d)>0.03 or rough>1.2:return none
    # The whole field (airfields.jo's cleared area: 90 m off each end, 190 m left, 70 m right)
    # clear of houses and roads, and dry.
    u=-len*0.5-90.0
    loop u<=len*0.5+90.0:
        v=-190.0
        loop v<=70.0:
            q=c+dir*f32(u)+side*f32(v)
            if settlement_urban(q) or settlement_on_road(q) or water_at(f64(q.x),f64(q.y)).wet:return none
            v+=20.0
        u+=20.0
    # Approaches: 1:20 clear for 1500 m off both ends.
    loop e in [-1.0,1.0]:
        loop k in 1..31:
            q=c+dir*f32(e*(len*0.5+f64(k)*50.0))
            if flight_surface_height(f64(q.x),f64(q.y))>a+e*b*len*0.5+f64(k)*50.0/20.0:return none
    Candidate(c,h,abs(b)*100.0+abs(d)*40.0+rough*2.0,a,b,rough,d)

if checking:
    at=vec2(f32(to_float(args()[2]) ?? 0.0),f32(to_float(args()[3]) ?? 0.0));h=to_float(args()[4]) ?? 0.0;len=to_float(args()[5]) ?? 700.0
    if let c=judge(at,h,len):print("check ({at.x:.0f},{at.y:.0f}) {len:.0f} m: level {c.level:.1f} m grade {c.grade*100.0:.2f}% cross {c.side*100.0:.2f}% rough {c.rough:.2f} m")
    else:print("check ({at.x:.0f},{at.y:.0f}) {len:.0f} m: rejected")
    exit(0)
found:Candidate[]
centre=s.center.xz
loop r in [1600.0,2000.0,2500.0,3000.0,3600.0,4300.0,5000.0,6000.0,7000.0]:
    loop k in 0..int(r*TAU/250.0):
        a=f64(k)*TAU/f64(int(r*TAU/250.0))
        c=centre+vec2(f32(cos(a)*r),f32(sin(a)*r))
        if place_base(c)<4.0:continue
        loop hi in 0..12:
            if let cand=judge(c,f64(hi)*PI/12.0,strip):
                cand.score+=r/2000.0
                found.push(cand)
found.sort((x:Candidate):x.score)
print("{found.len()} candidates")
loop i in 0..min(25,found.len()):
    f=found[i]
    print("{i}: at ({f.at.x:.0f},{f.at.y:.0f}) heading {f.heading:.3f} level {f.level:.1f} m grade {f.grade*100.0:.2f}% cross {f.side*100.0:.2f}% rough {f.rough:.2f} m dist {length(f.at-centre):.0f} score {f.score:.2f}")

# Detail of the two best: heights relative to the strip level, 100 m along x 25 m across,
# out to 150 m each side (the apron and hangars stand beside the strip).
loop i in 0..min(3,found.len()):
    f=found[i]
    dir=vec2(f32(sin(f.heading)),f32(-cos(f.heading)));side=vec2(-dir.y,dir.x)
    print("candidate {i} heading {f.heading:.3f}:")
    loop j in -6..7:
        line=""
        loop k in -7..8:
            p=f.at+dir*f32(f64(k)*100.0)+side*f32(f64(j)*25.0)
            g=flight_surface_height(f64(p.x),f64(p.y))-f.level
            mark=if water_at(f64(p.x),f64(p.y)).wet:"W" else:(if settlement_on_road(p):"R" else:" ")
            line=line+"{g:6.1f}{mark}"
        print(line)
