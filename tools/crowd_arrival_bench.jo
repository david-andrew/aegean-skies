# Arrival in a big town, for the crowd's layout cost: the pilot stands 600 m from Kalyrassa's
# square (outside the crowd's reach) for 300 frames, then is set down on the benchmark street
# (tools/collision_bench.jo's) and walks it. Each frame's wall time is logged from frame 300 to
# the end, with what the crowd's update cost that frame (0 on a build without the crowd: run the
# same file against base and candidate). ARRIVAL lines: frame, frame ms, crowd ms.
import '../aegean.jo' as game
use 'judge_scene.jo'
use '../src/settlements.jo'
use '../src/objects.jo'
use '../src/world_point.jo'
finish_settlement_registry()
a=vec2(-117999.45,-84871.78);b=a+(vec2(-117993.9,-84855.7)-a)*0.4
away=a+vec2(0,600)
game.me.pos=vec3(away.x,f32(walk_height(game.towns,away.x,away.y)),away.y)
game.me.mode=.walking;game.judge_ready=true
base_update:(f64)->void=game.update
base_draw:()->void=game.draw
last=-1.0;worst=0.0;over=0;worst_crowd=0.0
last_frame=to_int(env("SLOPPY_FRAMES") ?? "900") ?? 900
# (what the crowd's update cost this frame; a copy of this file built against a revision without
# the crowd says 0.0 here)
crowd_now = () -> f64: game.ambient_update_ms
update=(dt:f64):
    global last,worst,over
    frame=frame_number()
    if frame==300:
        game.me.pos=vec3(a.x,f32(walk_height(game.towns,a.x,a.y)),a.y);game.walker_point=world_point(game.me.pos);game.follow.placed=false
    if frame>300:
        fraction=f64(frame-300)/60.0*1.7/f64(length(b-a))
        phase=fraction-floor(fraction/2)*2
        u=if phase<=1:phase else:2-phase
        wanted=mix(a,b,f32(u))
        game.sync_walker_point()
        game.step_player_walk(wanted-world_vec(game.walker_point).xz)
    base_update(dt)
draw=():
    global last,worst,over,worst_crowd
    base_draw()
    now=time();frame=frame_number()
    if last>=0.0 and frame>300:
        ms=(now-last)*1000.0
        crowd=crowd_now()
        worst=max(worst,ms);worst_crowd=max(worst_crowd,crowd)
        if ms>50.0:over+=1
        print("ARRIVAL {frame} {ms:.2} {crowd:.3}")
    last=now
    if frame==last_frame: print("ARRIVAL_SUMMARY worst_frame_ms={worst:.2} frames_over_50={over} worst_crowd_ms={worst_crowd:.3}")
