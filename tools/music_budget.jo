# File-only audio benchmark. Run wall-clock measurements on redfox under bench.lock.
# Compile the same harness against the original/auditioned revisions for comparison.
use '../src/radio_synth.jo'
use '../src/music_synth.jo'

loop piece in 0..7:
    begin=time_ns()
    s=make_radio_synth()
    radio_synth_program(s,.morse,0,0);s.style=.classical
    radio_music_program(s,piece,0)
    setup=f64(time_ns()-begin)/1e6
    loop iteration in 0..2:
        if iteration==1:music_seek(s.music,0)
        costs: f64[]
        energy=0.0;first=0.0;total=0.0
        loop i in 0..min(1200,s.music.frames/800):
            start=time_ns()
            block=radio_render(s,800,0.55,4)
            ms=f64(time_ns()-start)/1e6
            if i==0:first=ms
            costs.push(ms);total+=ms
            loop v in block:energy+=f64(v)*f64(v)
        costs.sort();n=costs.len()
        print("piece={piece} pass={iteration} setup_ms={setup:.4} first50_ms={first:.4} mean_ms={total/f64(n):.4} p50_ms={costs[n/2]:.4} p95_ms={costs[n*95/100]:.4} p99_ms={costs[n*99/100]:.4} max_ms={costs[n-1]:.4} energy={energy:.12}")
    loop seconds in [0.001,19.999,42.345]:
        start=time_ns()
        radio_synth_program(s,.morse,0,seconds);s.style=.classical
        radio_music_program(s,piece,seconds)
        block=radio_render(s,800,0.55,4)
        ms=f64(time_ns()-start)/1e6
        print("seek piece={piece} seconds={seconds} setup_and_first50_ms={ms:.4} samples={block.len()}")
print("DONE")
