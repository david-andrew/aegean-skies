# Export the untouched relief around inland towns for offline flood/spill analysis.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/lake_data.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
directory=env("LAKE_SURVEY_DIR") ?? panic("LAKE_SURVEY_DIR is required")
loop lake in SETTLEMENT_LAKES:
    only=to_int(env("LAKE_SURVEY_ID") ?? "0") ?? 0
    if only!=0 and lake.id!=only:continue
    if only==0 and env("LAKE_SURVEY_ALL")==none and not (lake.id in [111289,131012,141625]):continue
    s=world_settlements[settlement_by_id[lake.id]]
    step=to_float(env("LAKE_SURVEY_STEP") ?? "16") ?? 16.0
    n=to_int(env("LAKE_SURVEY_N") ?? "513") ?? 513
    cx=to_float(env("LAKE_SURVEY_X") ?? "") ?? f64(s.center.x)
    cz=to_float(env("LAKE_SURVEY_Z") ?? "") ?? f64(s.center.z)
    x=floor(cx/step)*step-f64(n/2)*step
    z=floor(cz/step)*step-f64(n/2)*step
    data:u8[]
    loop j in 0..n:
        loop i in 0..n:
            h=new_land_relief(x+f64(i)*step,z+f64(j)*step).0
            append_le(data,int(round(h*256.0)),4)
    assert(write_bytes("{directory}/{s.id}.bin",data))
    print("BASIN|{s.id}|{s.name}|{s.center.x}|{s.center.y}|{s.center.z}|{s.radius}|{x}|{z}|{step}|{n}")
