# Keep an old, physically valid cart service when the new spanning-tree bake
# chooses different feeders. A saved paid journey must still have a route.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/living_relocation.jo'
use '../src/living_feeder_bake.jo'
use '../src/inland_connections_data.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true;init_settlements()
bytes=read_bytes(args()[1]);assert(bytes is u8[])
unpacked=inflate(bytes);assert(unpacked!=none)
old=from_text[FarRouteCatalog](str_from_bytes(unpacked!));assert(old is FarRouteCatalog)
packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
connections=ACCESS_CONNECTIONS
loop link in old.links:
    if link.mode!=.cart or layout_route(catalog.links,link.a,link.b,.cart).len()>1:continue
    assert(length(link.points[0]-world_settlements[settlement_by_id[link.a]].center)<1)
    assert(length(link.points[link.points.len()-1]-world_settlements[settlement_by_id[link.b]].center)<1)
    loop k in 1..link.points.len():assert(feeder_segment_clear(link.points[k-1],link.points[k]),"old service {link.a}/{link.b} is no longer dry/walkable")
    connections.push(AccessConnection(link.a,link.b,link.points))
    fresh=link;fresh.id=catalog.links.len();fresh.road= -1;fresh.trail=true;catalog.links.push(fresh)
    print("RETAINED {link.a}/{link.b}: {link.points.len()} verified points")
source="# Offline validated access connections.\nstruct AccessConnection:\n    a:int\n    b:int\n    points:vec3[]\nACCESS_CONNECTIONS:AccessConnection[]=[\n"
loop item in connections:
    source+="    AccessConnection({item.a},{item.b},["
    loop p in item.points:source+="vec3({p.x},{p.y},{p.z}),"
    source+=" ]),\n"
source+="]\n"
assert(write_file(join_path(dir_name(args()[0]),'../src/inland_connections_data.jo'),source))
assert(write_bytes(join_path(dir_name(args()[0]),'../assets/living-routes.bin'),deflate(to_text(catalog).bytes())))
