# Time only on redfox under the shared benchmark lock. Never writes an asset.
use '../src/geography.jo'
t = time()
b = encode_geography()
assert(load_geography(b))
assert(b == embed('../assets/world.bin'))
print("world bake bytes={b.len()} islands={small_islands.len()} elapsed={time()-t:.4}s key={geography_key()}")
