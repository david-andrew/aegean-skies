use '../src/world_towns.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/settlements.jo'
use '../src/town_sites.jo'
use '../src/town_details.jo'
use '../src/town_paving.jo'
assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true
init_settlements(false,true)
tw=build_town(SETTLEMENTS[0])
paths=build_legacy_town_detail(tw,0).paths
loop s in tw.sites:
    a=site_point(s,-s.width*0.5-1.4,s.depth*0.5+2.5); b=site_point(s,s.width*0.5+1.4,s.depth*0.5+2.5)
    if env("AEGEAN_PAVING_BASELINE")!=none: town_path(paths,a,b,3.5,true)
    else: town_street(paths,a,b,3.5)
worst=1e9; at=vec3(0,0,0)
loop i in 0..paths.len()/3:
    a=paths[i*3].pos; b=paths[i*3+1].pos; c=paths[i*3+2].pos
    loop u in 0..9:
        loop v in 0..9-u:
            p=a+(b-a)*f32(u)/8+(c-a)*f32(v)/8
            gap=f64(p.y)-place_ground(p.xz)
            if gap<worst: worst=gap; at=p
print("PAVING clearance={worst} at={at} ground={place_ground(at.xz)}")
