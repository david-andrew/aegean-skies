<rdf:Description rdf:about=".">
    <mp:title>Andante in C Major K. 315</mp:title>
    <mp:composer>MozartWA</mp:composer>
    <mp:opus>KV 315</mp:opus>
    <mp:lyricist/>
    <mp:for>Flute and Orchestra: Violins, Viola, Cello, Horns, Oboes and Bass</mp:for>
