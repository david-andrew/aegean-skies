# What tools/bake.jo bakes ahead of time is exactly what the game would make itself as it
# starts: the coast microrelief tile, the islands' render tiles and the islands' settlement
# registry. (A stale bake after a code change fails here: run sloppy --release tools/bake.jo.)
use '../src/world.jo'
use '../src/geography.jo'
use '../src/terrain_data.jo'
use '../src/terrain_lod.jo'
use '../src/coast_pattern.jo'
use '../src/settlements.jo'
use '../src/baked_assets.jo'
use '../src/sea.jo'

test "the coast microrelief tile in use is the one the code makes":
    made = build_coast_pattern()
    assert(coast_pattern_image.width == made.width and coast_pattern_image.pixels == made.pixels)
    if let bytes = baked_asset(COAST_PATTERN_BAKE):
        loaded = load_png(bytes)
        assert(loaded is Image and loaded.pixels == made.pixels, "stale {COAST_PATTERN_BAKE}: run tools/bake.jo")

test "the baked render tiles are the ones derived from the 8 m source":
    assert(load_land(embed('../assets/terrain.bin')))
    baked = decode_render_land(embed('../assets/terrain_lod.bin'))
    assert(baked.len() == ISLANDS.len())
    loop k in 0..ISLANDS.len():
        tile = bake_render_tile(k)
        loop mut patch in tile.patches:
            loop lev in 0..6: patch.error[lev] = ceil(patch.error[lev]*4096.0)/4096.0
        assert(to_text(baked[k]) == to_text(tile), "{ISLANDS[k].name}: stale terrain_lod.bin: run tools/bake.jo")

test "the baked settlement registry is the one the islands would get a few a frame":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_settlements(false,true)
    baked = baked_asset(SETTLEMENT_REGISTRY_BAKE) != none
    assert(settlement_registry_ready == baked, "a bake present is taken; without one the islands wait")
    taken = to_text((world_settlements,settlement_roads,settlement_by_id,settlement_bins))
    packed = bake_settlement_registry()
    assert(to_text((world_settlements,settlement_roads,settlement_by_id,settlement_bins)) == taken or not baked, "stale {SETTLEMENT_REGISTRY_BAKE}: run tools/bake.jo")
    if let file = baked_asset(SETTLEMENT_REGISTRY_BAKE): assert(file == packed)
    # A different mainland (other data, other code) never takes the islands baked for this one.
    if baked:
        init_settlements(false,true)
        assert(settlement_registry_ready)
        world_settlements[0].radius += 1.0
        settlement_registry_ready = false
        assert(not use_baked_registry())

test "the baked sea depth map is the one the land makes":
    assert(load_land(embed('../assets/terrain.bin')))
    if let png = baked_asset(DEPTH_MAP_BAKE + ".png"):
        loaded = load_png(png)
        made = build_depth_image()
        assert(loaded is Image and loaded.pixels == made.pixels, "stale {DEPTH_MAP_BAKE}.png: run tools/bake.jo")
        if let key = baked_asset(DEPTH_MAP_BAKE + ".key"): assert(str_from_bytes(key) == "{depth_map_key()}", "stale {DEPTH_MAP_BAKE}.key")
