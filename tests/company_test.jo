# Company at the table: rare (most sittings nobody comes); at a table they ask and sit only if
# asked to; at the bar they take the next stool without asking, and may not talk; remarks now and
# then, not a stream; they go when the pilot gets up, or after a while.
use '../src/company.jo'

_flat = (x: f64, z: f64) -> f64: 0.0

_cand = () -> Candidate: Candidate(3, 17, vec3(10, 0, 0), 1.0)

_run = (c: mut Company, from: f64, seconds: f64, seated: bool) -> CompanyStep[]:
    out: CompanyStep[]
    loop k in 0..int(seconds * 20.0): out.push(company_step(c, from + f64(k) * 0.05, 0.05, seated, _flat))
    out

test "most sittings nobody comes":
    n = 1000
    table = 0; bar = 0
    loop k in 0..n:
        roll = f64((k * 7919) % n) / f64(n)
        if company_plan(false, roll, 0.5, 0.0).due >= 0.0: table += 1
        if company_plan(true, roll, 0.5, 0.0).due >= 0.0: bar += 1
    assert(table > 100 and table < 200, "{table}")
    assert(bar > 120 and bar < 230, "{bar}")
    # (and not at once: a while into the sitting)
    assert(company_plan(false, 0.0, 0.0, 100.0).due >= 145.0)

test "who comes: by weight, and nobody when nobody will do":
    cands = [Candidate(0, 10, vec3(0, 0, 0), 1.0), Candidate(1, 11, vec3(0, 0, 0), 3.0)]
    assert(company_pick(cands, 0.1) == 0 and company_pick(cands, 0.5) == 1 and company_pick(cands, 0.99) == 1)
    assert(company_pick([], 0.5) == -1)
    assert(company_pick([Candidate(0, 10, vec3(0, 0, 0), 0.0)], 0.5) == -1)

test "at a table they ask, and sit only when asked to":
    c = company_plan(false, 0.0, 0.0, 0.0)
    company_start(c, _cand(), vec3(0, 0, 1), 3.1, vec3(0.7, 0, 1), true, 0.0)
    steps = _run(c, 0.0, 20.0, true)
    assert(c.stage == .asking)
    assert([loop s in steps: if s.asks: 1].len() == 1)
    # (no answer yet: they wait)
    _ = _run(c, 20.0, 30.0, true)
    assert(c.stage == .asking)
    company_answer(c, true, 50.0)
    assert(c.stage == .sitting and c.pos == c.seat)

test "turned away, they go, and nobody else comes this sitting":
    c = company_plan(false, 0.0, 0.0, 0.0)
    company_start(c, _cand(), vec3(0, 0, 1), 3.1, vec3(0.7, 0, 1), true, 0.0)
    _ = _run(c, 0.0, 20.0, true)
    company_answer(c, false, 20.0)
    assert(c.stage == .leaving and c.declined)
    _ = _run(c, 20.0, 30.0, true)
    assert(c.stage == .none and not company_due(c, 1000.0))

test "at the bar they just take the next stool, and may not say a word":
    c = company_plan(true, 0.0, 0.0, 0.0)
    company_start(c, _cand(), vec3(1, 0, 0), 0.0, vec3(1, 0, 0), false, 0.0)
    steps = _run(c, 0.0, 30.0, true)
    assert(c.stage == .sitting)
    assert([loop s in steps: if s.asks: 1].len() == 0 and [loop s in steps: if s.arrived: 1].len() == 1)
    assert([loop s in steps: if s.speak: 1].len() == 0)

test "remarks now and then, not a stream; gone after a while, or when the pilot gets up":
    c = company_plan(false, 0.0, 0.0, 0.0)
    company_start(c, _cand(), vec3(0, 0, 1), 3.1, vec3(0.7, 0, 1), true, 0.0)
    _ = _run(c, 0.0, 20.0, true)
    company_answer(c, true, 20.0)
    steps = _run(c, 20.0, 120.0, true)
    said = [loop s in steps: if s.speak: 1].len()
    assert(said >= 2 and said <= 6, "{said}")
    _ = _run(c, 140.0, COMPANY_STAY, true)
    assert(c.stage == .leaving or c.stage == .none)
    d = company_plan(false, 0.0, 0.0, 0.0)
    company_start(d, _cand(), vec3(0, 0, 1), 3.1, vec3(0.7, 0, 1), true, 0.0)
    _ = _run(d, 0.0, 20.0, true)
    company_answer(d, true, 20.0)
    _ = _run(d, 20.0, 1.0, false)
    assert(d.stage == .leaving)

test "called away to the band's stand: they get up and go, a little quicker, wherever the town has them":
    c = Company()
    company_start(c, Candidate(0, 5, vec3(10, 0, 0), 1.0), vec3(0, 0, 0), 0.0, vec3(0.7, 0, 0), true, 0.0)
    c.stage = .asking
    company_answer(c, true, 1.0)
    assert(c.stage == .sitting)
    company_called_away(c, vec3(-6, 0, 0))
    assert(c.stage == .leaving and c.speed > COMPANY_SPEED and length(c.from - vec3(-6, 0, 0)) < 0.001)
    flat = (x: f64, z: f64) -> f64: 0.0
    gone = false
    loop k in 0..400:
        st = company_step(c, 1.0 + f64(k) / 60.0, 1.0 / 60.0, true, flat)
        if st.gone: gone = true; break
    # (6 m at twice the pace: under four seconds)
    assert(gone and c.stage == .none)
    # (nobody sitting: nothing to call away)
    d = Company()
    company_called_away(d, vec3(1, 0, 0))
    assert(d.stage == .none)
