# Meetings in this fixture are observed evidence, not calendar-based forced affection.
test "courtship needs distinct days of actual meetings and a gift buys real stock":
    w = build_world(); story = 0
    assert(w.stories[story].kind == .courtship)
    cash = w.ledger; stock = stock_totals(w)
    w.minute = 15; w.tick = 1800; stories_minute(w)
    assert(w.stories[story].stage == 0 and w.stories[story].job < 0)
    # Nikos has completed his seeded trip before these controlled local meetings.
    w.people[2].place = 0
    w.meetings[100] = SocialMeeting(100,0,.cafe,[2,10],15,10000,active=true)
    w.active_meetings = [100]; w.next_meeting = 101
    w.stories[story].next_check_minute = 30
    loop day in 0..3:
        w.minute = day*1440+30; w.tick = w.minute*120
        stories_minute(w)
        count = w.stories[story].meetings
        w.stories[story].next_check_minute = w.minute
        stories_minute(w)
        assert(w.stories[story].meetings == count)
    assert(w.stories[story].job < 0) # An empty purse cannot commission a gesture.
    assert(transfer(w,w.factions[1].account,w.people[2].account,500,.wage))
    w.minute += 15; w.tick = w.minute*120; stories_minute(w)
    job = w.stories[story].job
    assert(w.stories[story].meetings == 3 and w.stories[story].stage == 2 and job >= 0)
    assert(w.jobs[job].delivery_mode == .foot and w.jobs[job].quantity == 100 and w.jobs[job].good == 1)
    assert(w.jobs[job].context != "" and w.jobs[job].drop_holder == 10 and w.jobs[job].reward_cents == 80)
    assert(stock_totals(w) == stock and w.ledger.opening_cents == cash.opening_cents and w.ledger.external_in_cents == cash.external_in_cents and w.ledger.external_out_cents == cash.external_out_cents and goods_balance(w) and money_balances(w))
    assert(w.jobs[job].cargo_ids.len() > 0 and w.cargo[w.jobs[job].cargo_ids[0]].owner == 2)

test "feud concern and debt stories have causes and do not resolve by a clock":
    w = build_world(); before = w.stories.len()
    w.minute = 30; w.tick = 3600; stories_minute(w)
    loop _, story in w.stories:
        assert(story.kind != .missing_boat) # No actual overdue boat in this fixture.
    debt = -1
    loop id, story in w.stories:
        if story.kind == .debt: debt = id
    assert(debt >= 0)
    obligation = w.stories[debt].obligation
    w.obligations[obligation].paid_cents = 100
    w.stories[debt].next_check_minute = 45
    w.minute = 45; w.tick = 5400; stories_minute(w)
    assert(w.stories[debt].stage == 1 and not w.stories[debt].resolved)
    assert(w.stories.len() >= before)


test "a grievance held by the higher numbered person makes one feud and both must settle":
    w = build_world(); seed_relationship(w,3,1)
    anger = w.relationship_index[RelationshipKey(3,1)]
    other = w.relationship_index[RelationshipKey(1,3)]
    w.relationships[anger].grievance = 300; w.relationships[anger].trust = 300
    w.minute = 30; w.tick = 3600; stories_minute(w)
    feud = -1; count = 0
    loop id, story in w.stories:
        if story.kind == .feud and (1 in story.actors) and (3 in story.actors): feud = id; count += 1
    assert(feud >= 0 and count == 1 and not w.stories[feud].resolved)
    w.relationships[anger].grievance = 0; w.relationships[anger].trust = 650; w.relationships[anger].affinity = 0
    w.relationships[other].grievance = 200
    w.minute += 15; w.tick = w.minute*120; stories_minute(w)
    assert(not w.stories[feud].resolved)
    w.relationships[other].grievance = 0; w.relationships[other].trust = 650; w.relationships[other].affinity = 0
    w.minute += 15; w.tick = w.minute*120; stories_minute(w)
    assert(w.stories[feud].resolved and w.stories[feud].stage == 2)

test "an overdue real boat's return is not known to a distant watcher until the account arrives":
    w = build_world(); trip = w.people[7].trip
    if trip < 0: trip = begin_fishing(w,7)
    assert(trip >= 0 and w.trips[trip].mode == .boat)
    place = w.trips[trip].origin; watcher = w.places[place].market_owner
    # A published historical account can outlive its pruned Event. It refers to another day,
    # not this boat's still-unfinished journey.
    w.next_event = 901; w.next_news_event = 901
    assert(receive_person(w,watcher,NewsItem(event=900,kind=.arrived,occurred_minute=-100,learned_minute=-100,origin=place,source_person=7,reason=Reason(purpose=.fishing,actor=7,origin=place,destination=place))))
    w.minute = w.trips[trip].eta_tick/120+75; w.tick = w.minute*120
    stories_minute(w)
    story_id = -1
    loop id, story in w.stories:
        if story.kind == .missing_boat and story.actors[0] == 7: story_id = id
    assert(story_id >= 0 and not w.stories[story_id].resolved)
    w.people[watcher].pose.pos += vec3(500,0,0)
    assert(commit_arrival(w,trip,place,-1,0))
    w.minute += 15; w.tick = w.minute*120; stories_minute(w)
    assert(not w.stories[story_id].resolved)
    publish_events(w)
    w.minute += 15; w.tick = w.minute*120; stories_minute(w)
    assert(w.stories[story_id].resolved and w.stories[story_id].stage == 2)
    assert(goods_balance(w) and money_balances(w))
