# Leads (src/leads.jo): what people mention that the pilot could go and do is always real (an open
# job, a club meeting taking entries, a boat not yet back, tonight's band) and stops being said
# once it isn't; each person says it once, plainly, one detail at most.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/life_types.jo'
use '../src/living_jobs.jo'
use '../src/living_claims.jo'
use '../src/living_stories.jo'
use '../src/living_place_context.jo'
use '../src/leads.jo'

# A world with one of each: a lift wanted, a load left on a dock, a boat overdue, the band's
# numbers, and a club meeting the day after.
_world = () -> (World, MeetNote[]):
    w = build_world(); advance_minutes(w,30)
    # (Dario at Porto Vecchio wants to get home to Agios Nikolaos; he posts it himself)
    w.people[8].place = 0; w.people[8].trip = -1; w.people[8].home = 2
    ride = post_job(w,8,2,.none,-1,1,1500,w.minute+600,passenger=8)
    # (Nefeli's load of oil left at Kalamos)
    cargo = post_job(w,13,0,.commodity,2,1000,2000,w.minute+1440)
    # (Kostas's boat overdue at Kalamos; Despina watching for it)
    new_life_story(w,.missing_boat,[12,13],1)
    w.band.numbers = [BandNumber(ticks=6000,roles=[0,1])]
    # (the load posted a while ago, and nobody has taken it)
    w.jobs[cargo].created_minute = w.minute-LEAD_CARGO_WAIT-30
    meets = [MeetNote(id=7700001,capital=w.places[3].id,day=day_index(w.minute)+1,fast=true)]
    assert(ride >= 0 and cargo >= 0,"{ride} {cargo}")
    (w,meets)

test "every lead is real: a job, a meeting, a story or tonight's band":
    w0, meets = _world()
    w = w0
    kinds: {LeadKind: int}
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,meets):
            assert(lead_real(w,l,meets),"{speaker}: {l.key}")
            kinds[l.kind] = kinds.get(l.kind,0)+1
            match l.kind:
                .ride, .cargo:
                    assert(l.subject in w.jobs and w.jobs[l.subject].state == .open)
                    assert(l.place >= 0 and l.place < w.places.len())
                .overdue: assert(l.subject in w.stories and not w.stories[l.subject].resolved)
                .race: assert([loop m in meets: if m.id == l.subject: 1].len() == 1)
                .band: assert(w.band.numbers.len() > 0 and l.place == 0)
            line = lead_line(w,l,speaker,speaker)
            assert(line != "" and split(line," ").len() <= 10,line)
    loop k in [LeadKind.ride,.cargo,.overdue,.race,.band]: assert(kinds.get(k,0) > 0,"{k}")

test "where a lead points: the ride names where, the load where it waits, the race where and when":
    w, meets = _world()
    found = 0
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,meets):
            line = lead_line(w,l,speaker,1)
            match l.kind:
                .ride:
                    j = w.jobs[l.subject]
                    if j.poster != j.passenger: assert(line.contains(life_place_name(w,j.destination)),line)
                    else: assert(line.contains("Dario") and line.contains("home"),line)
                    found += 1
                .cargo:
                    if l.place != w.people[speaker].place: assert(line.contains(life_place_name(w,l.place)),line)
                .race: assert(line.contains("tomorrow"),line)
                else: pass
    assert(found > 0)

test "a lead stops being said once it isn't real, and each person says it once":
    w, meets = _world()
    teller = -1; lead = Lead(kind=.ride,key="")
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,meets):
            if l.kind == .cargo and teller < 0: teller = speaker; lead = l
    assert(teller >= 0)
    told: {str: int}
    first = lead_to_tell(w,teller,meets,told)
    assert(first != none)
    told["{teller}:{first!.key}"] = day_index(w.minute)
    second = lead_to_tell(w,teller,meets,told)
    assert(second == none or second!.key != first!.key)
    # (the load taken by someone: nobody speaks of it any more)
    w.jobs[lead.subject].state = .claimed
    assert(not lead_real(w,lead,meets))
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,meets): assert(l.key != lead.key)
    # (the meeting closed to entries, the boat back, the band done for the night)
    closed = [loop m in meets: MeetNote(id=m.id,capital=m.capital,day=m.day,open=false)]
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,closed): assert(l.kind != .race)
    loop id in w.stories.keys(): w.stories[id].resolved = true
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,meets): assert(l.kind != .overdue)
    w.minute = (day_index(w.minute)+1)*1440 + (1430-570)
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,meets): assert(l.kind != .band)

test "over days of the world going on, every lead offered at any hour is real":
    w = build_world(u64(11))
    meets: MeetNote[]
    offered = 0
    loop step in 0..24:
        advance_minutes(w,180)
        meets = [MeetNote(id=1+day_index(w.minute),capital=w.places[3].id,day=day_index(w.minute)+1)]
        # (the band's numbers as the scene would publish them, on a copy: the headless world has no stand)
        q = w; q.band.numbers = [BandNumber(ticks=6000,roles=[0,1])]
        loop speaker in 1..q.people.len():
            loop l in leads_for(q,speaker,meets):
                assert(lead_real(q,l,meets),"{step} {speaker} {l.key}")
                assert(lead_line(q,l,speaker,step) != "")
                offered += 1
    assert(offered > 50,"{offered}")
