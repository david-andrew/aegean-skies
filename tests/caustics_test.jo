# Unit tests for shallow-water caustics (src/caustics.jo and src/coast_pattern.jo).
use '../src/caustics.jo'
use '../src/coast_pattern.jo'
use '../src/look.jo'
use '../src/weather_scene.jo'
import '../src/living_conditions.jo' as weather

test "caustic strength vanishes at night and under cloud cover, fades at low sun":
    weather_active = false
    noon = caustic_strength(light_at(13.0).sun_dir)
    low = caustic_strength(light_at(17.25).sun_dir)
    very_low = caustic_strength(light_at(17.5).sun_dir)
    dusk = caustic_strength(light_at(18.5).sun_dir)
    night = caustic_strength(light_at(22.0).sun_dir)
    assert(noon > 0.95, "noon strength {noon}")
    assert(low > 0.12 and low < noon * 0.65, "low sun should fade yet remain legible: low={low} noon={noon}")
    assert(very_low < low, "sun nearer horizon should fade further: very_low={very_low} low={low}")
    assert(dusk == 0.0, "post-sunset must be 0, got {dusk}")
    assert(night == 0.0, "night must be 0, got {night}")
    # Overcast and rain extinguish caustics
    weather_active = true
    weather_here = weather.WeatherAir(deck = 0.9)
    assert(caustic_strength(light_at(13.0).sun_dir) == 0.0, "overcast must extinguish caustics")
    weather_here = weather.WeatherAir(rain = 0.9)
    assert(caustic_strength(light_at(13.0).sun_dir) == 0.0, "rain must extinguish caustics")
    weather_here = weather.WeatherAir(deck = 0.0, rain = 0.0)
    assert(caustic_strength(light_at(13.0).sun_dir) > 0.95, "clear sky restores caustics")
    weather_active = false

test "caustic uniforms are deterministic at frozen time and invariant across origin snaps":
    weather_active = false
    L = light_at(13.0)
    a1, b1, c1, d1 = caustic_uniforms(L.sun_dir, 100.0, vec3(0, 0, 0), L.glare)
    a2, b2, c2, d2 = caustic_uniforms(L.sun_dir, 100.0, vec3(0, 0, 0), L.glare)
    assert(a1 == a2 and b1 == b2 and c1 == c2 and d1 == d2, "frozen clock must produce identical uniforms")
    # Low-sun stretch compression increases at low solar elevation
    _, _, c_low, _ = caustic_uniforms(light_at(17.25).sun_dir, 100.0, vec3(0, 0, 0), 1.0)
    assert(c_low.z > c1.z + 0.25, "low sun should stretch caustics along sun azimuth: low={c_low.z} noon={c1.z}")
    # Check world-point UV invariance across a 1024 m render-origin snap for both octaves
    world_xz = vec2(5410.0, 5075.0)
    orig0 = vec3(5120.0, 0.0, 5120.0)
    orig1 = vec3(6144.0, 0.0, 4096.0)
    _, ub0, uc0, _ = caustic_uniforms(L.sun_dir, 42.0, orig0, L.glare)
    _, ub1, uc1, _ = caustic_uniforms(L.sun_dir, 42.0, orig1, L.glare)
    l0 = world_xz - orig0.xz
    l1 = world_xz - orig1.xz
    p0 = l0 - uc0.xy * (dot(l0, uc0.xy) * uc0.z)
    p1 = l1 - uc1.xy * (dot(l1, uc1.xy) * uc1.z)
    uv1_0 = fract(p0 / f32(CAUSTIC_SPAN1) + ub0.xy)
    uv1_1 = fract(p1 / f32(CAUSTIC_SPAN1) + ub1.xy)
    diff1 = abs(uv1_0 - uv1_1)
    diff1 = min(diff1, vec2(1, 1) - diff1)
    assert(diff1.x < 0.002 and diff1.y < 0.002, "origin snap octave 1 UV mismatch: {uv1_0} vs {uv1_1}")
    r0 = vec2(p0.x * 0.79863551 - p0.y * 0.60181502, p0.x * 0.60181502 + p0.y * 0.79863551)
    r1 = vec2(p1.x * 0.79863551 - p1.y * 0.60181502, p1.x * 0.60181502 + p1.y * 0.79863551)
    uv2_0 = fract(r0 / f32(CAUSTIC_SPAN2) + ub0.zw)
    uv2_1 = fract(r1 / f32(CAUSTIC_SPAN2) + ub1.zw)
    diff2 = abs(uv2_0 - uv2_1)
    diff2 = min(diff2, vec2(1, 1) - diff2)
    assert(diff2.x < 0.002 and diff2.y < 0.002, "origin snap octave 2 UV mismatch: {uv2_0} vs {uv2_1}")

test "coast pattern alpha holds a seamless Voronoi caustic distance field":
    img = coast_pattern_image
    lo: f32 = 1.0; hi: f32 = 0.0; sum: f64 = 0.0
    loop y in 0..img.height:
        loop x in 0..img.width:
            w = img.get(x, y).w
            lo = min(lo, w); hi = max(hi, w); sum += f64(w)
    mean = sum / f64(img.width * img.height)
    assert(lo < 0.03, "expected filament/cusp minima near 0, got {lo}")
    assert(hi > 0.75, "expected cell-interior maxima > 0.75, got {hi}")
    assert(mean > 0.25 and mean < 0.65, "unexpected mean {mean}")
    # Seamless wrap across left/right and top/bottom borders
    max_seam: f32 = 0.0
    loop k in 0..img.height:
        max_seam = max(max_seam, abs(img.get(0, k).w - img.get(img.width - 1, k).w))
        max_seam = max(max_seam, abs(img.get(k, 0).w - img.get(k, img.height - 1).w))
    assert(max_seam < 0.08, "tile seam jump too large: {max_seam}")
