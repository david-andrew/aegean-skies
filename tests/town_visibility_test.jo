use '../src/town_visibility.jo'
use '../src/town_sites.jo'
use '../src/town_architecture.jo'

test "wall occlusion keeps silhouettes and camera movement conservative":
    wall=TownSite(vec3(0,0,0),0,10,10,9,0)
    cam=vec3(0,2,-40)
    assert(town_hidden([wall],cam,vec3(0,2,7),0.5))
    assert(not town_hidden([wall],cam,vec3(15,2,7),0.5))
    assert(not town_hidden([wall],cam,vec3(0,12,7),0.5))
    assert(not town_hidden([wall],vec3(0,2,0),vec3(0,2,7),0.5))
    # The cached decision must remain valid throughout its movement box.
    loop x in [-12.0,0.0,12.0]:
        loop y in [-12.0,0.0,12.0]:
            loop z in [-12.0,0.0,12.0]:
                assert(town_wall_hit(wall,cam+vec3(f32(x),f32(y),f32(z)),vec3(0,2,7)))

test "distant ornament meshes reduce triangles and preserve bounds":
    loop kind in [0,1,2,6,9]:
        full=arch_vertices(kind); mid=arch_vertices(kind,1); far=arch_vertices(kind,0)
        assert(far.len()<mid.len() and mid.len()<full.len())
        bound=town_mesh_bound(full)
        loop v in far: assert(length(v.pos-bound.xyz)<=bound.w+0.01)
