use '../src/living_money.jo'
use '../src/living_relocation.jo'
use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_far_types.jo'
use '../src/living_seed.jo'
use '../src/living_place_context.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_people.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_orders.jo'
use '../src/living_far_stock.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'

relocation_fixture=()->World:
    w=build_world(u64(42));contexts:LifePlaceContext[]
    loop k in 0..6:contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    loop id in [100,200,300]:contexts.push(LifePlaceContext(id,"Town {id}",1,id,vec3(f32(id),2,0)))
    assert(publish_place_contexts(w,1,contexts,[-1,100,-1]))
    seeds=[FarPlaceSeed(100,80,1,3,homes=[FarHome("stable-home",vec3(105,2,0))]),FarPlaceSeed(200,80,1,0),FarPlaceSeed(300,40,1,1)]
    links=[FarLink(0,100,200,.cart,[vec3(100,2,0),vec3(150,2,0),vec3(200,2,0)],100000),FarLink(1,200,300,.cart,[vec3(200,2,0),vec3(300,2,0)],100000)]
    assert(populate_settlement_economy(w,1,seeds,links));w

relocation_catalog=()->FarLink[]:
    [FarLink(0,200,100,.cart,[vec3(200,2,0),vec3(600,2,0),vec3(1000,2,0)],800000),FarLink(1,200,300,.cart,[vec3(200,2,0),vec3(300,2,0)],100000)]
relocation_moves=()->FarPlaceMove[]:
    [FarPlaceMove(100,vec3(100,2,0),vec3(1000,2,0),[FarHome("stable-home",vec3(1005,2,0))])]

test "shore relocation preserves a real resident household trade purse and home key":
    w=relocation_fixture();id=promote_far_person(w,100,.farmer)
    people=w.people.len();population=far_population(w);accounts=to_text(w.accounts);stock=stock_totals(w);ledger=to_text(w.ledger)
    w.place_contexts[100].center=vec3(1000,2,0)
    assert(upgrade_settlement_layout(w,relocation_catalog(),relocation_moves(),u64(71)))
    assert(w.people.len()==people and far_population(w)==population and to_text(w.accounts)==accounts and stock_totals(w)==stock and to_text(w.ledger)==ledger)
    assert(w.people[id].far_home==100 and w.far.people[id].role==.farmer and w.far.districts[100].output==3)
    assert(w.far.people[id].home_key=="stable-home" and w.far.people[id].home_pos==vec3(1005,2,0))
    assert(w.people[id].pose.pos==vec3(1005,2,0) and w.far.districts[100].homes[0].key=="stable-home")
    before=canonical_text(w)
    assert(upgrade_settlement_layout(w,relocation_catalog(),relocation_moves(),u64(71)) and canonical_text(w)==before)
    restored=from_text[World](before);assert(restored is World)
    assert(canonical_text(restored)==before and validate_save_world(restored)=="")

test "a paid cart keeps its journey cargo ownership and fractional progress on a relocated road":
    w=relocation_fixture()
    assert(far_produce(w,100,3,10000));w.far.districts[200].target[3]+=20000
    w.far.vehicles[0].buying_order=counter_restock_order(w,0,200)
    assert(far_depart(w,0));id=w.far.vehicles[0].journey
    w.far.journeys[id].segment=1;w.far.journeys[id].progress_mm=0
    journey=w.far.journeys[id];cargo=to_text(w.far.vehicles[0].cargo);accounts=to_text(w.accounts);roots=w.next_cargo_source
    assert(upgrade_settlement_layout(w,relocation_catalog(),relocation_moves(),u64(72)))
    after=w.far.journeys[id]
    assert(after.id==journey.id and after.link==journey.link and after.buyer==journey.buyer and after.cargo_owner==journey.cargo_owner and after.quantity==journey.quantity)
    assert(after.origin==100 and after.destination==200 and w.far.vehicles[0].journey==id)
    assert(w.far.vehicles[0].pos==vec3(600,2,0) and journey_progress_mm(w,after)==400000)
    assert(to_text(w.far.vehicles[0].cargo)==cargo and to_text(w.accounts)==accounts and w.next_cargo_source==roots)
    assert(validate_save_world(w)=="" and invariant_errors(w).len()==0)

test "a changed road neighbor follows verified graph edges without renumbering the old service":
    w=relocation_fixture()
    catalog=[FarLink(0,100,300,.cart,[vec3(1000,2,0),vec3(300,2,0)],700000),FarLink(1,300,200,.cart,[vec3(300,2,0),vec3(200,2,0)],100000)]
    assert(upgrade_settlement_layout(w,catalog,relocation_moves(),u64(73)))
    assert(w.far.links[0].a==100 and w.far.links[0].b==200 and w.far.links[0].id==0)
    assert(w.far.links[0].points==[vec3(1000,2,0),vec3(300,2,0),vec3(200,2,0)])
    assert(w.far.links.len()==3 and w.far.links[2].id==2 and w.far.links[2].a==100 and w.far.links[2].b==300)
    assert(validate_save_world(w)=="")

test "an unrepairable saved route is refused without partially changing the world":
    w=relocation_fixture();before=canonical_text(w)
    assert(not upgrade_settlement_layout(w,[],relocation_moves(),u64(74)))
    assert(canonical_text(w)==before)
