use '../src/town_sites.jo'
use '../src/settlements.jo'
use '../src/world_point.jo'
use '../src/walk_shapes.jo'
use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'

test "wall sliding preserves tangent motion and gates stay open":
    s=TownSite(vec3(0,0,0),0,10,8,6,0)
    p=vec2(-5.6,-3)
    loop k in 0..50:
        p=walk_site_exclude(s,p+vec2(0.1,0.1),0)
        assert(p.x<=-5.34)
    assert(p.y>1.9)
    assert(walk_site_exclude(s,vec2(0,0),7)==vec2(0,0))

test "cached footprints match far settlement geometry in three towns":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    checked=0
    loop s in world_settlements:
        if s.name!="Olythoria" and s.name!="Kalyrassa" and s.name!="Pheryalara":continue
        lots=place_lots(s)
        count=0
        loop lot in lots:
            if let parcel=place_ground_lot(s,lot):
                site=site_from_parcel(parcel)
                start=site_point(site,-site.width*0.5-1,0)
                point=WorldPoint(f64(start.x),walk_height([],start.x,start.y),f64(start.y))
                loop frame in 0..100:point=walk_step_precise([],point,site_right(site)*0.05)
                local=site_local(site,world_vec(point).xz)
                assert(local.x<=f32(-site.width*0.5-0.30))
                count+=1
                if count>=3:break
        assert(count==3)
        checked+=1
    assert(checked==3)
