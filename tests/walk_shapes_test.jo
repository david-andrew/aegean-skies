use '../src/town_sites.jo'
use '../src/settlements.jo'
use '../src/world_point.jo'
use '../src/walk_shapes.jo'
use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'

test "wall sliding preserves tangent motion and gates stay open":
    s=TownSite(vec3(0,0,0),0,10,8,6,0)
    p=vec2(-5.6,-3)
    loop k in 0..50:
        p=walk_site_exclude(s,p+vec2(0.1,0.1),0)
        assert(p.x<=-5.34)
    assert(p.y>1.9)
    assert(walk_site_exclude(s,vec2(0,0),7)==vec2(0,0))

test "cached footprints match far settlement geometry in three towns":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    checked=0
    loop s in world_settlements:
        if s.name!="Olythoria" and s.name!="Kalyrassa" and s.name!="Pheryalara":continue
        lots=place_lots(s)
        count=0
        loop lot in lots:
            if let parcel=place_ground_lot(s,lot):
                site=site_from_parcel(parcel)
                start=site_point(site,-site.width*0.5-1,0)
                point=WorldPoint(f64(start.x),walk_height([],start.x,start.y),f64(start.y))
                loop frame in 0..100:point=walk_step_precise([],point,site_right(site)*0.05)
                local=site_local(site,world_vec(point).xz)
                assert(local.x<=f32(-site.width*0.5-0.30))
                before=world_vec(point).xz
                loop frame in 0..20:point=walk_step_precise([],point,site_right(site)*0.05+site_front(site)*0.05)
                assert(length(world_vec(point).xz-before)>0.5)
                assert(site_local(site,world_vec(point).xz).x<=f32(-site.width*0.5-0.30))
                # A large navigation probe cannot tunnel through the facade.
                point=walk_step_precise([],point,site_right(site)*f32(site.width+4))
                assert(site_local(site,world_vec(point).xz).x<=f32(-site.width*0.5-0.30))
                entry=site_entry(site)
                door=WorldPoint(f64(entry.outside.x),walk_height([],entry.outside.x,entry.outside.y),f64(entry.outside.y))
                loop frame in 0..50:door=walk_step_precise([],door,(entry.front-entry.outside)/50.0)
                # A closed modelled door blocks the capsule at the facade;
                # its approach stairs remain reachable without a height jump.
                assert(length(world_vec(door).xz-entry.front)<0.8)
                count+=1
                if count>=3:break
        assert(count==3)
        checked+=1
    assert(checked==3)

test "farm gate stays open while boundary wall blocks and slides":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    checked=false
    loop place in world_settlements:
        if place.kind!=.farm:continue
        if let lot=place_lot(place,1,1):
            if let parcel=place_ground_lot(place,lot):
                s=site_from_parcel(parcel);yard=site_farm_yard(s)
                if yard==none:continue
                gate=site_point(s,site_farm_gate(s,true),f64(yard!.w))
                h=place_ground(gate)
                assert(length(walk_site_exclude(s,gate,h)-gate)<0.05)
                wall=site_point(s,f64(yard!.x),0)
                assert(length(walk_site_exclude(s,wall,place_ground(wall))-wall)>0.3)
                checked=true;break
    assert(checked)
