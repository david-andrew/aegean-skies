# Notes rising from music in the world: each is a real note's onset, a few a second at most, the
# tune's notes before the others, none in a burst after a seek; they rise and fade, fainter with
# distance and through walls.
use '../src/music_synth.jo'
use '../src/live_notes.jo'
use '../src/note_cue.jo'
use '../src/note_value.jo'

_n = (start: int, part: int, tune: bool, velocity: f64 = 0.5, length: f64 = 0.5) -> LiveNote: LiveNote(start, 60, part, velocity, length, tune)

# a busy score: a chord on every eighth of a second, the tune every quarter
_busy = () -> LiveNote[]:
    out: LiveNote[]
    loop k in 0..400:
        f = k * MUSIC_RATE / 8
        out.push(_n(f, 6, false)); out.push(_n(f, 13, false))
        if k % 2 == 0: out.push(_n(f, 0, true, 0.3))
    out

_play = (c: mut NoteCue, notes: LiveNote[], seconds: f64, from: f64 = 0.0) -> LiveNote[]:
    shown: LiveNote[]
    loop k in 0..int(seconds * 60.0):
        now = from + f64(k) / 60.0
        if let n = note_cue_pick(c, notes, int(now * f64(MUSIC_RATE)), now): shown.push(n)
    shown

test "a few a second at most, however busy the music":
    c = NoteCue()
    shown = _play(c, _busy(), 40.0)
    assert(shown.len() > 20, "{shown.len()}")
    assert(f64(shown.len()) / 40.0 <= 1.0 / NOTE_GAP + 0.01, "{shown.len()}")

test "the tune's notes before the accompaniment's":
    c = NoteCue()
    shown = _play(c, _busy(), 30.0)
    loop n in shown: assert(note_is_tune(n), "part {n.part}")

test "the accompaniment shows when the tune has been quiet a while":
    notes = [loop k in 0..100: _n(k * MUSIC_RATE / 2, 6, false)]
    c = NoteCue()
    shown = _play(c, notes, 20.0)
    assert(shown.len() >= 10 and shown.len() <= 20, "{shown.len()}")

test "the singer's line counts as the tune":
    assert(note_is_tune(_n(0, 14, false)))

test "each shown note is a real onset, shown when it is heard":
    notes = [_n(MUSIC_RATE * 2, 0, true), _n(MUSIC_RATE * 5, 0, true)]
    c = NoteCue()
    _ = _play(c, notes, 1.9)
    assert(c.rising.len() == 0)
    late: LiveNote[]
    loop k in 114..130:
        now = f64(k) / 60.0
        if let n = note_cue_pick(c, notes, int(now * f64(MUSIC_RATE)), now): late.push(n)
    assert(late.len() == 1 and late[0].start == MUSIC_RATE * 2)

test "no burst of old notes after a seek or a new number":
    c = NoteCue()
    _ = _play(c, _busy(), 2.0)
    # (heard from 30 s on: a jump)
    assert(note_cue_pick(c, _busy(), MUSIC_RATE * 30, 30.0) == none)
    shown = _play(c, _busy(), 1.0, 30.02)
    assert(shown.len() <= 4)

test "a note rises, fades and is gone; its written value from its length against the quarter":
    c = NoteCue()
    note_cue_rise(c, _n(0, 0, true, 1.0, 0.2), vec3(0, 2, 0), 10.0)
    note_cue_rise(c, _n(0, 0, true, 0.2, 0.8), vec3(0, 2, 0), 10.0)
    # (no score's tempo: an eighth when short, else a quarter)
    assert(c.rising[0].value.kind == NOTE_EIGHTH and c.rising[1].value.kind == NOTE_QUARTER)
    # (with the score's quarter at 0.4 s: 0.2 s an eighth, 0.6 s a dotted quarter, 1.6 s a whole)
    d = NoteCue()
    loop len in [0.2, 0.6, 1.6]: note_cue_rise(d, _n(0, 0, true, 0.5, len), vec3(0, 2, 0), 10.0, 0.4)
    assert(d.rising[0].value == NoteValue(NOTE_EIGHTH) and d.rising[1].value == NoteValue(NOTE_QUARTER, true) and d.rising[2].value == NoteValue(NOTE_WHOLE))
    assert(c.rising[0].size > c.rising[1].size)
    r = c.rising[0]
    assert(note_age_alpha(r, 10.0) == 0.0 and note_age_alpha(r, 11.0) == 1.0 and note_age_alpha(r, 10.0 + NOTE_LIFE) < 0.01)
    assert(note_pos(r, 12.0).y > note_pos(r, 11.0).y)
    note_cue_age(c, 10.0 + NOTE_LIFE + 0.1)
    assert(c.rising.len() == 0)

test "fainter with distance, as the music is, and through walls":
    assert(note_heard_alpha(10.0, 0.0) == 1.0)
    assert(note_heard_alpha(80.0, 0.0) > 0.0 and note_heard_alpha(80.0, 0.0) < 1.0)
    assert(note_heard_alpha(NOTE_HEARD, 0.0) == 0.0)
    assert(note_heard_alpha(30.0, 1.0) < note_heard_alpha(30.0, 0.0))

# ---------------- chords ----------------

_p = (start: int, pitch: int, part: int, length: f64 = 0.4, tune: bool = false) -> LiveNote: LiveNote(start, pitch, part, 0.6, length, tune)
_ms = (s: f64) -> int: int(s * f64(MUSIC_RATE))

test "a piano's left hand chord rises as one chord, apart from the tune above it":
    # (C3 E3 G3 struck together, rolled over 20 ms; the tune's C5 with them)
    notes = [_p(1000, 48, 6), _p(1000 + _ms(0.01), 52, 6), _p(1000 + _ms(0.02), 55, 6, 1.2), _p(1000, 72, 6, 0.4, true)]
    notes.sort((n: LiveNote): (n.start, n.part, n.pitch))
    left = note_chord(notes, notes[0])
    assert([loop n in left: n.pitch] == [48, 52, 55])
    tune = note_chord(notes, notes[1])
    assert([loop n in tune: n.pitch] == [72], "{[loop n in tune: n.pitch]}")
    # (rising, its longest note sets the value: the G held for 1.2 s is a half at 0.5 s a quarter)
    c = NoteCue()
    note_cue_rise(c, notes[0], vec3(0, 0, 0), 1.0, 0.5, left)
    assert(c.rising[0].pitches == [48, 52, 55] and c.rising[0].value.kind == NOTE_HALF)
    assert(note_steps(c.rising[0].pitches) == [0, 2, 4])

test "a guitar strum is one chord; another part, or notes further apart, are not in it":
    strum = [_p(5000, 40, 7), _p(5000, 47, 7), _p(5000, 52, 7), _p(5000, 56, 7), _p(5000, 59, 7), _p(5000, 64, 7)]
    notes = strum + [_p(5000, 43, 13), _p(5000 + _ms(0.06), 60, 7)]
    notes.sort((n: LiveNote): (n.start, n.part, n.pitch))
    k = 0
    loop i in 0..notes.len():
        if notes[i].part == 7 and notes[i].pitch == 52: k = i
    chord = note_chord(notes, notes[k])
    # (six strings, five heads at most: those nearest the note picked; the bass's G and the later C not in it)
    assert(chord.len() == CHORD_MOST and not (43 in [loop n in chord: n.pitch]) and not (60 in [loop n in chord: n.pitch]))
    assert(52 in [loop n in chord: n.pitch])

test "a note alone is its own chord, and draws as one head":
    notes = [_p(100, 60, 0), _p(100 + _ms(0.2), 62, 0)]
    one = note_chord(notes, notes[0])
    assert(one.len() == 1)
    c = NoteCue()
    note_cue_rise(c, notes[0], vec3(0, 0, 0), 1.0, 0.5, one)
    assert(c.rising[0].pitches.len() == 0 and note_steps(c.rising[0].pitches) == [0])
    # (a second: steps one apart; a sharp beside its natural: still a step apart)
    assert(note_steps([60, 62, 67]) == [0, 1, 4] and note_steps([60, 61]) == [0, 1])
