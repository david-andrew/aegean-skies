# Taking the waters: the keeper's words, the bathers' talk in turn (no line twice running, a lead
# once a soak, the dialogue's remark now and then), and the day's ticket.
use '../src/bath.jo'

test "the bathers talk in turn, never the same line twice running; a lead once":
    b = Bath(stage = .soaking, bathers = [3, 5, 8])
    last = ""
    leads = 0
    speakers: int[]
    loop k in 0..12:
        assert(bath_line_due(b, b.next_line))
        sp = bath_next_speaker(b)
        speakers.push(sp)
        line = bath_pick_line(b, "Marta has oil for Kalamos", if k % 2 == 1: "Wind's getting up." else: "")
        assert(line != last, "{k}: {line}")
        if line.contains("Marta has oil"): leads += 1
        bath_said(b, sp, line, b.next_line)
        last = line
    assert(leads == 1, "{leads}")
    assert(0 in speakers and 1 in speakers and 2 in speakers)
    # (nobody in the pool, or not soaking: nothing is said)
    assert(not bath_line_due(Bath(stage = .soaking), 100.0))
    assert(not bath_line_due(Bath(stage = .dressed, bathers = [1]), 100.0))

test "the day's ticket: paid today at this spring, not tomorrow, not the other spring":
    b = Bath(paid_day = 40, site = 0)
    assert(bath_paid_today(b, 40, 0))
    assert(not bath_paid_today(b, 41, 0))
    assert(not bath_paid_today(b, 40, 1))
    assert(bath_keeper_ask(false).contains("lepta") and bath_keeper_ask(true) != bath_keeper_ask(false))
