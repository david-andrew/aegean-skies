import '../src/geography.jo' as geography
import '../src/settlements.jo' as places
import '../src/living_world.jo' as living
import '../src/living_types.jo' as data
import '../src/living_claims.jo' as claims
import '../src/living_portage.jo' as porter
import '../src/cargo_scene.jo' as scene
import '../src/living_scene.jo' as clock
import '../src/objects.jo' as objects
import '../src/world.jo' as land

test "visible porter walks the actual Porto quay with the reserved crate":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    scene.configure_cargo_scene(w, towns)
    assert(claims.take_job(w, 3, 0, .porter))
    task = w.carriage[0]; person = task.person
    carried = false; moved_with_crate = false
    loop tick in 0..60 * 240:
        before = w.people[person].pose.pos
        clock.scene_clock_begin(w)
        scene.step_cargo_scene(w, towns, w.harbors[0].center, 1.0 / 60.0)
        clock.scene_clock_end(w)
        now = w.people[person].pose.pos
        assert(length(now - before) < 0.03)
        if w.people[person].carrying >= 0:
            carried = true
            lot = w.people[person].carrying
            assert(w.cargo[lot].pos == now and w.cargo[lot].where == .person)
            if length(now - before) > 0.001: moved_with_crate = true
        if w.jobs[3].loaded: break
    if not w.jobs[3].loaded: print(w.carriage[0], w.people[person].pose, w.cargo_harbors[0])
    assert(carried and moved_with_crate and w.jobs[3].loaded)
    assert(porter.cargo_all_aboard(w, 3))
    assert(living.invariant_errors(w).len() == 0)

test "an unreachable walking route cannot complete when it leaves the scene":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    scene.configure_cargo_scene(w, towns)
    assert(claims.take_job(w, 3, 0, .porter))
    id = 0; task = w.carriage[id]
    sea = w.harbors[0].center + w.harbors[0].out * 90.0
    w.cargo[task.cargo].pos = sea
    w.carriage[id].route = [w.people[task.person].pose.pos, sea]
    clock.scene_clock_begin(w)
    scene.step_cargo_scene(w, towns, w.harbors[0].center, 1.0 / 60.0)
    assert(w.carriage[id].blocked != "")
    scene.step_cargo_scene(w, towns, vec3(100000, 0, 100000), 1.0 / 60.0)
    living.advance_minutes(w, 10)
    assert(not w.jobs[3].loaded and w.cargo[task.cargo].pos == sea)

test "Kalyrassa navigation follows collision-checked street corners":
    assert(land.load_land(embed('../assets/terrain.bin')))
    assert(geography.load_geography(embed('../assets/world.bin')))
    geography.geography_enabled=true;places.init_settlements();places.finish_settlement_registry()
    towns=[loop s in land.SETTLEMENTS:objects.build_town(s)]
    from=vec3(-117987.875,11.338751,-84833.73)
    target=vec3(-117951.61,8.021283,-84956.08)
    path=scene.cargo_walk_path(towns,from,target)
    assert(path.len()>2 and path[0]==from and path[path.len()-1]==target)
    loop k in 1..path.len():
        p=path[k-1];delta=path[k].xz-p.xz
        steps=max(1,int(ceil(f64(length(delta))/0.1)))
        loop step in 1..steps+1:
            next=mix(path[k-1],path[k],f32(step)/f32(steps))
            p=objects.walk_step(towns,p,next.xz-p.xz)
            assert(length(p.xz-next.xz)<0.15)
