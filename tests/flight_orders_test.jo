# The strait, the enemy gone but one far off, the player's flight scattered over a few kilometres.
staged = () -> (Battle,int,int):
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    sc=build_scenario("strait",towns,build_craft_models())!
    b=sc.battle;w=sc.world
    me=combat_index(b,w.people[w.player].craft)
    foe=-1
    loop i in 0..b.actors.len():
        a=b.actors[i]
        if a.side!=b.actors[me].side:
            if foe<0:
                foe=i;a.state.position+=vec3(0,0,-14000);a.previous=a.state.position;a.previous_point=world_point(a.state.position);a.pilot.formation=false
            else:a.present=false;a.status=.escaped
        else if i!=me:
            a.pilot.formation=false
            a.state.position+=vec3(f32(combat_noise(3,a.craft,0,0)*7000.0),0,f32(combat_noise(3,a.craft,0,2)*7000.0))
            a.state.precise_ready=false;a.previous=a.state.position;a.previous_point=world_point(a.state.position)
        b.actors[i]=a
    (b,me,foe)

# The player flying straight and level at cruise (the game integrates them; here they are moved).
fly = (b: mut Battle, me: int, seconds: f64):
    loop _ in 0..int(seconds*60.0):
        p=b.actors[me]
        p.previous=p.state.position;p.previous_point=world_point(p.state.position)
        p.state.position+=p.state.velocity*f32(COMBAT_DT);p.state.precise_ready=false
        b.actors[me]=p
        step_battle(b,flight_env(f64(b.tick)/60.0,p.state.position),p.state.position)

slot_error = (b: Battle, me: int) -> f64:
    sum=0.0;n=0
    l=b.actors[me]
    loop a in b.actors:
        if a.side!=l.side or a.human or a.status!=.flying or not a.present:continue
        slot=l.state.position+quat_rotate(quat_euler(0,-heading(l.state),0),a.pilot.formation_offset-l.pilot.formation_offset)
        sum+=f64(length(slot-a.state.position));n+=1
    sum/max(1.0,f64(n))

test "on the R/T the flight forms on the player, circles where told and goes for the player's target":
    b,me,foe=staged()
    # (no bases: nobody turns for home on their own while the orders are tried)
    b.homes=[]
    # (the enemy kept out of it while the formation and the circle are tried: one coming in on a
    # wingman's tail would rightly have it look after itself first)
    b.actors[foe].present=false
    by=b.actors[me].craft
    before=slot_error(b,me)
    assert(give_order(b,by,.form_on_me)==7)
    fly(b,me,180.0)
    after=slot_error(b,me)
    print("form on me: slot error {before:.0} m to {after:.0} m")
    assert(after<300.0 and after<before*0.1)
    at=b.actors[me].state.position
    assert(give_order(b,by,.circle)>0)
    fly(b,me,60.0)
    far=0.0
    loop a in b.actors:
        if a.side==b.actors[me].side and not a.human and a.status==.flying:far=max(far,f64(length(vec3(a.state.position.x-at.x,0,a.state.position.z-at.z))))
    print("circle here: the farthest {far:.0} m from the spot")
    assert(far<2200.0)
    # (the enemy back, under the cloud deck, where it can be seen: one in the deck is lost to sight)
    f=b.actors[foe];f.present=true;f.state.position.y=420;f.previous=f.state.position;f.previous_point=world_point(f.state.position);b.actors[foe]=f
    assert(give_order(b,by,.attack,b.actors[foe].craft)>0)
    fly(b,me,1.0)
    loop a in b.actors:
        if a.side==b.actors[me].side and not a.human and a.status==.flying:assert(a.pilot.target==foe)

test "on the R/T the flight breaks off for home, or leads the player straight home at a pace to follow":
    b,me,foe=staged()
    by=b.actors[me].craft;side=b.actors[me].side
    assert(give_order(b,by,.go_home)>0)
    assert(b.home_since[side]>=0 and b.formed[side]<0)
    b2,me2,foe2=staged()
    assert(give_order(b2,b2.actors[me2].craft,.lead_home)>0)
    assert(b2.home_since[side]>=0 and b2.formed[side]>=0)
    fly(b2,me2,30.0)
    lead=home_leader(b2,side)
    assert(lead>=0 and b2.actors[lead].pilot.plan.speed<b2.actors[lead].spec.cruise_speed*0.75)

test "the R/T pad: a number sends at once, C steps, F sends the line stepped to, idle closes it":
    r=RtPad()
    rt_open(r,0.0,[0,1,2,3,4])
    assert(rt_keys(r,false,false,3,false,0.5)==2 and not r.open)
    rt_open(r,1.0,[0,1,2,3,4])
    assert(rt_keys(r,true,false,0,false,1.2)==-1 and r.focus==1)
    assert(rt_keys(r,false,true,0,false,1.4)==1 and not r.open)
    rt_open(r,2.0,[0,1,2,3,4])
    assert(rt_keys(r,false,false,0,false,2.0+RT_IDLE+0.1)==-1 and not r.open)
    assert(RT_WORDS.len()==RT_KINDS.len() and rt_answer(.attack,false)!="")
    # (down on the sea: the call for help heads the pad, the flight's words after it)
    rt_open(r,3.0,[RT_HELP,0,1])
    assert(rt_keys(r,false,false,1,false,3.1)==RT_HELP)
    rt_open(r,4.0,[RT_FLARE])
    assert(rt_keys(r,false,false,2,false,4.1)==-1 and r.open)
    assert(rt_keys(r,false,true,0,false,4.2)==RT_FLARE)
