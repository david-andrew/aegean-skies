# The phoenix: written amounts are the sign and a figure, small change is written in lepta, speech
# says the money aloud, and no player-facing words still name the old lire.
use '../src/phoenix.jo'
use '../src/living_talk_words.jo'

test "written amounts: the sign and the figure, two places for part of a phoenix":
    assert(phoenix_text(12000) == "¤120", phoenix_text(12000))
    assert(phoenix_text(100) == "¤1" and phoenix_text(350) == "¤3.50" and phoenix_text(1205) == "¤12.05")
    assert(phoenix_text(0) == "¤0")
    assert(phoenix_text(-250) == "-¤2.50")

test "under one phoenix is written in lepta, with the lepton's λ":
    assert(phoenix_text(30) == "30 λ" and phoenix_text(5) == "5 λ" and phoenix_text(99) == "99 λ")
    assert(phoenix_text(-30) == "-30 λ")

test "the sign is measured as drawn, a little wider than the bare glyph":
    plain = text_width("120", 20)
    signed = ptext_width("¤120", 20)
    assert(signed > plain + text_width("¤", 20) and signed < plain + 20.0, "{signed} vs {plain}")
    assert(ptext_width("no money here", 16) == text_width("no money here", 16))
    assert(ptext_width("a ¤3\nand ¤120 more", 18) == ptext_width("and ¤120 more", 18))

test "spoken money: phoinikes, and lepta for small change, never the written sign":
    assert(say_money(1880) == "near enough nineteen phoinikes")
    assert(say_money(30) == "thirty lepta" and say_money(34) == "thirty lepta" and say_money(46) == "fifty lepta")
    assert(say_money(100) == "a phoinix" and say_money(150) == "a phoinix and a half")
    loop cents in [1, 30, 99, 100, 818, 2662, 12345, 98765]:
        said = say_money(cents)
        assert(not ("¤" in said) and not ("λ" in said) and not ("lir" in said), said)

# Player-facing words come from the game's sources: no string there may still say lire or lira
# (comments may, as history).
test "no words in the game still name the lire":
    # (run from the repository or from tests/)
    root = if is_dir("src"): "" else: "../"
    sources = [root + "aegean.jo"]
    names = list_dir(root + "src")
    if names is str[]:
        loop name in names:
            if name.ends_with(".jo"): sources.push(root + "src/" + name)
    assert(sources.len() > 100, "{sources.len()} sources")
    bad: str[]
    loop path in sources:
        body = read_file(path)
        if not (body is str): continue
        n = 0
        loop row in split(body, "\n"):
            n += 1
            code = row.trim()
            if code.starts_with("#"): continue
            low = lower(code)
            loop word in [" lire", " lira", "\"lire", "\"lira"]:
                if low.contains(word) and low.contains("\""): bad.push("{path}:{n}: {code}")
    assert(bad.len() == 0, bad.join("\n"))
