use '../src/flight.jo'
use '../src/combat.jo'

# A fixed ground gun: it leads, fires, swings only within its arc, holds fire till it wakes, and
# is silenced by hits; all deterministic.
fixture = (target: vec3, arc: f64 = PI) -> Battle:
    k = craft_spec(.gull,[])
    me = Combatant(1,1,1,k,CraftState(position=target,velocity=vec3(60,0,0)),human=true,external=true)
    g = GroundGun(-1000,2,vec3(0,1.45,0),.machine_gun,0.0,arc=arc,wake=10)
    b = Battle(enabled=true,actors=[me],bullet_scale=5)
    b.ground = [g]
    b

shots = (b: mut Battle, ticks: int) -> int:
    n = 0
    loop _ in 0..ticks:
        b.actors[0].previous = b.actors[0].state.position
        b.actors[0].state.position += b.actors[0].state.velocity*f32(COMBAT_DT)
        step_battle(b,FlightEnv(ground=(x:f64,z:f64)->f64:0.0),vec3(0,0,0))
        loop e in b.events:
            if e.kind == .shot and e.craft == -1000: n += 1
    n

test "a ground gun fires within its arc after waking, never behind it":
    ahead = fixture(vec3(-200,150,-300),1.9)
    assert(shots(ahead,240) > 5)
    behind = fixture(vec3(-200,150,300),1.9)
    assert(shots(behind,240) == 0)
    around = fixture(vec3(-200,150,300))
    assert(shots(around,480) > 5)      # (after swinging round: a heavy gun turns slowly)
    # (asleep for its first ticks)
    early = fixture(vec3(-100,150,-300),1.9)
    assert(shots(early,10) == 0)

test "ground fire is deterministic and a post can be silenced":
    a = fixture(vec3(-200,150,-300)); b = fixture(vec3(-200,150,-300))
    _ = shots(a,300); _ = shots(b,300)
    assert(to_text(a) == to_text(b))
    c = fixture(vec3(-200,150,-300))
    c.actors.push(Combatant(2,2,1,craft_spec(.gull,[]),CraftState(position=vec3(0,30,60),velocity=vec3(0,0,-40))))
    loop _ in 0..40:
        c.rounds.push(Round(vec3(0,1.2,8),vec3(0,0,-900),2,1,0.1))
        _ = shots(c,1)
    assert(c.ground[0].disabled and c.ground[0].health == 0)
    n = shots(c,240)
    assert(n == 0)
