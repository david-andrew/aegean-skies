# Precision contracts independent of graphics backends and world asset streaming.
use '../src/render_space.jo'
use '../src/sea.jo'
use '../src/objects.jo'
use '../src/look.jo'

phase_params = (origin: vec3,t: f64) -> SeaParams:
    p = SeaParams(origin=origin,wind=vec4(0.8,0.6,6,0.0096))
    sea_phases(p,t)
    p

test "wave phases survive all corners long sessions and origin boundaries":
    worst = 0.0
    loop x in [-249856.0,-1024.0,0.0,1024.0,249856.0]:
        loop z in [-199680.0,0.0,199680.0]:
            loop time in [0.0,123.5,86400.0,10000000.0]:
                origin = vec3(f32(x),0,f32(z))
                a = phase_params(origin,time)
                b = phase_params(origin+vec3(1024,0,-1024),time)
                local = vec2(13.125,55.5)
                p = sea_swell(local,a,0)
                q = sea_swell(local-vec2(1024,-1024),b,0)
                worst = max(worst,f64(length(p-q)))
                assert(length(p-q)<0.00015)
    print("WAVE anchor/long-time max error {worst:.9}")

test "sea marks preserve cell identity and footprint over origin snaps":
    worst = 0.0
    loop origin in [vec3(0,0,0),vec3(249856,0,-199680),vec3(-249856,0,199680)]:
        a = phase_params(origin,0)
        b = phase_params(origin+vec3(1024,0,-1024),0)
        loop j in 0..40:
            loop i in 0..40:
                point = vec2(f32(i)*0.27,f32(j)*0.29)
                # The actual finest mark lattice, including crossfade/smear offsets.
                q = point
                other = point-vec2(1024,-1024)
                r = other
                value = sea_fleck(q,vec2(0.1,0.2),1.3,0,a.mark_phase[0])
                next = sea_fleck(r,vec2(0.1,0.2),1.3,0,b.mark_phase[0])
                worst = max(worst,abs(f64(value-next)))
                assert(abs(value-next)<0.003)
    print("MARK anchor max amplitude error {worst:.9}")

test "model detail is translated before small vertices are added":
    point = vec4(0.001,0.002,0.003,1)
    loop origin in [vec3(0,0,0),vec3(249856,0,-199680),vec3(-249856,0,199680)]:
        model = translation(origin+vec3(5,2,7))*rotation_y(0.7)
        local = render_model(model,origin)*point
        reference = (translation(vec3(5,2,7))*rotation_y(0.7))*point
        assert(length(local-reference)<0.000001)

test "local projection keeps sea and submerged ground order at every origin":
    saved_view = __view; saved_proj = __proj3; saved_cam = __cam_pos
    worst = 0.0
    loop origin in [vec3(0,0,0),vec3(249856,0,-199680),vec3(-249856,0,199680)]:
        eye = vec3(10,20,10)
        __cam_pos = origin+eye
        # Set axes independently of absolute target construction.
        __view = look_at(eye,eye+vec3(0.25,-0.3,-1),vec3(0,1,0))
        __view[3] = vec4(123456,234567,345678,1)
        __proj3 = perspective(62.0*PI/180.0,16.0/9.0,1.0,300000.0)
        local = render_view_proj(origin)
        reference = __proj3*look_at(eye,eye+vec3(0.25,-0.3,-1),vec3(0,1,0))
        water = local*vec4(0,0,-100,1); ground = local*vec4(0,-1,-100,1)
        assert(water.z/water.w < ground.z/ground.w)
        loop point in [vec4(0,0,-100,1),vec4(0,-1,-100,1),vec4(100,0,-1000,1)]:
            a = local*point; b = reference*point
            worst = max(worst,f64(length(a-b)))
            assert(length(a-b)<0.001)
    __view = saved_view; __proj3 = saved_proj; __cam_pos = saved_cam
    print("PROJECTION translation error {worst:.9}")

test "physics swell and render waves share double precision phase":
    old = wind_now
    wind_now = Wind(vec2(0.8,0.6),6,vec2(0,0))
    worst = 0.0
    loop x in [-240000.125,0.125,240000.125]:
        loop z in [-190000.375,0.375,190000.375]:
            origin = render_origin(vec3(f32(x),0,f32(z)))
            p = phase_params(origin,86400.0)
            # The public sea defaults to this amplitude at six metres per second.
            p.wind.w = 0.0096
            rendered = sea_swell(vec2(f32(x-f64(origin.x)),f32(z-f64(origin.z))),p,0)
            physical = swell_at(x,z,86400.0)
            worst = max(worst,f64(length(rendered-physical)))
            assert(length(rendered-physical)<0.0002)
    wind_now = old
    print("CPU/GPU wave reference max error {worst:.9}")

test "follow smoothing is translation invariant while walking and stopping":
    worst=0.0;old_worst=0.0
    loop origin in [vec3(0,0,0),vec3(14336,0,-171008),vec3(237568,0,182272)]:
        local=follow_camera(distance=5.5,pitch=0.25,height=1.6)
        far=follow_camera(distance=5.5,pitch=0.25,height=1.6)
        original=follow_camera(distance=5.5,pitch=0.25,height=1.6)
        local_frame=FollowFrame();far_frame=FollowFrame()
        loop frame in 0..600:
            x=100.0+f64(clamp(frame-60,0,360))*1.7/60.0
            point=WorldPoint(x,7.0,100.0)
            translated=WorldPoint(x+f64(origin.x),7.0,100.0+f64(origin.z))
            update_local_follow(local,local_frame,point,1.0/60.0,input=false)
            update_local_follow(far,far_frame,translated,1.0/60.0,input=false)
            update(original,world_vec(translated),1.0/60.0,input=false)
            error=f64(length(position(local)-position(far)))
            worst=max(worst,error)
            old_worst=max(old_worst,f64(length((position(original)-origin)-position(local))))
            assert(error<0.0002)
    print("WALK follow max local error {worst:.9}; old absolute error {old_worst:.9}")

test "follow chart crossing keeps its existing smooth trajectory":
    camera=follow_camera();frame=FollowFrame()
    previous=WorldPoint();worst=0.0
    loop k in 0..240:
        point=WorldPoint(249820.0+f64(k)*0.03,3.0,-199680.0)
        update_local_follow(camera,frame,point,1.0/60.0,input=false)
        p=position(camera)
        eye=WorldPoint(f64(frame.origin.x)+f64(p.x),f64(p.y),f64(frame.origin.z)+f64(p.z))
        if k>60:
            worst=max(worst,abs((eye.x-previous.x)-0.03))
            assert(abs((eye.x-previous.x)-0.03)<0.0002)
        previous=eye
    print("WALK chart-crossing camera step error {worst:.9}")

test "buoyancy cannot move a stationary boat sideways at a far port":
    saved=wind_now
    wind_now=Wind(vec2(0.8,0.6),9,vec2(0,0))
    worst=0.0;old_worst=0.0
    loop position in [vec3(14301.849,0,-170021.6),vec3(237640.03,0,182723.14)]:
        loop k in 0..180:
            at=translation(position)*rotation_y(0.73)
            changed=afloat_transform(at,f64(k)/60.0)
            error=f64(length(changed[3].xz-position.xz))
            worst=max(worst,error)
            old=afloat(position,f64(k)/60.0)*at
            old_worst=max(old_worst,f64(length(old[3].xz-position.xz)))
            assert(error==0.0)
    wind_now=saved
    print("BOAT lateral error {worst:.9}; old pivot cancellation {old_worst:.9}")

test "precise camera low part survives projection without moving world props":
    old_view=__view;old_proj=__proj3;old_cam=__cam_pos;old_low=render_eye_low
    worst=0.0
    origin=vec3(237568,0,182272)
    loop k in 0..240:
        point=WorldPoint(237640.12345+f64(k)*0.001,3.1234567,182723.12345)
        __cam_pos=world_vec(point);render_eye_low=world_residual(point)
        local=world_local(point,origin)
        __view=look_at(vec3(0,0,0),vec3(0.5,-0.2,-1),vec3(0,1,0))
        __proj3=perspective(58.0*PI/180.0,16.0/9.0,0.3,300000.0)
        camera=render_eye(origin)
        worst=max(worst,f64(length(camera-local)))
        assert(length(camera-local)<0.00005)
    __view=old_view;__proj3=old_proj;__cam_pos=old_cam;render_eye_low=old_low
    print("WALK precise eye max chart error {worst:.9}")
