# How landings on the water harm the floats and the hull, by how bad they are (flight.jo's water
# contacts, damage.jo's contact work against each part's strength). A hard, bouncy, slightly fast or
# slightly crooked landing, the abuse a pilot learning gives an aircraft, does light damage at most;
# only a truly bad one breaks things: diving steeply in, dropped flat from a height, or very fast
# and crabbed. Prints the table of severities.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 sloppy test tests/landing_damage_test.jo
import '../src/flight.jo' as fl
import '../src/planes.jo' as planes

_spec = (kind: planes.Craft) -> fl.CraftSpec:
    fl.set_speed_scale(3.3)
    model = planes.build_craft(kind, planes.LIVERIES[0])
    fl.craft_spec(kind, model.contacts)

struct Landing:
    name: str
    speed: f64                      # times the stall speed
    path: f64                       # the glide path's angle down at the touch, degrees
    pitch: f64                      # the nose, degrees up
    crab: f64                       # heading off the way she moves, degrees
    bad = false                     # past the abuse a float is built for: it may break things
    worst = false                   # a truly bad one: it must

# (the sink at the touch is the drawn speed's along the path: the game draws the aircraft at three
# and a third times its true speed, and its sink with it, so a 3 degree approach at 1.15 times the
# Gull's stall meets the water at some 5 m/s)
LANDINGS = [
    Landing("gentle", 1.15, 1.0, 3.0, 0.0),
    Landing("firm", 1.15, 2.5, 3.0, 0.0),
    Landing("hard", 1.15, 4.0, 2.0, 0.0),
    Landing("bouncy (tail first, hard)", 1.1, 3.5, 9.0, 0.0),
    Landing("slightly fast", 1.5, 2.0, 0.0, 0.0),
    Landing("slightly crooked", 1.15, 2.5, 2.0, 10.0),
    Landing("hard, fast and a little crooked", 1.4, 3.5, 0.0, 8.0),
    Landing("a little nose down", 1.2, 3.0, -4.0, 0.0),
    Landing("very hard", 1.15, 6.0, 2.0, 0.0, true),
    Landing("crabbed", 1.2, 3.0, 0.0, 20.0, true),
    Landing("steep dive in", 1.3, 12.0, -15.0, 0.0, true, true),
    Landing("dropped in, stalled", 0.9, 14.0, 4.0, 0.0, true, true),
    Landing("very fast and crabbed", 1.8, 4.0, 0.0, 35.0, true, true)]

struct Outcome:
    worst = 1.0                     # the most damaged part's health
    worst_part = "none"
    lost = 0                        # parts torn off
    hull = 0.0                      # hull_damage (mass-weighted)
    wrecked = false

# (the player's aircraft, as the game flies it: drawn at its pure speed scale, the true speed's
# times faster along the water; the harm is judged at the true speed)
_land = (kind: planes.Craft, l: Landing, hz: int = 60) -> Outcome:
    k = _spec(kind); k.player = true; e = fl.FlightEnv()
    s = fl.CraftState(position = vec3(0, f32(k.float_height + 0.25), 0), fuel = k.fuel_capacity, water_age = 1.0)
    v = k.stall_speed * l.speed * fl.pure_k(k)
    sink = v * tan(l.path / 57.29578)
    s.velocity = vec3(0, f32(-sink), f32(-v))
    s.orientation = quat_euler(l.pitch / 57.29578, l.crab / 57.29578, 0)
    loop i in 0..hz * 8: fl.step(k, s, fl.Controls(assist = 0.0, water_brake = 0.4), e, 1.0 / f64(hz))
    out = Outcome(hull = s.hull_damage, wrecked = s.crashed or s.capsized)
    loop i in 0..k.parts.len():
        h = s.damage.parts[i].health
        if not s.damage.parts[i].attached: out.lost += 1
        if h < out.worst: out.worst = h; out.worst_part = k.parts[i].name
    out

k_sink = (kind: planes.Craft, l: Landing) -> f64:
    k = _spec(kind); k.player = true
    k.stall_speed * l.speed * fl.pure_k(k) * tan(l.path / 57.29578)

test "landing harm by severity: abuse does light damage at most, only a truly bad landing breaks things":
    loop kind in [planes.Craft.gull, planes.Craft.heron, planes.Craft.corsair, planes.Craft.falco]:
        loop l in LANDINGS:
            o = _land(kind, l)
            print("LANDING | {kind} | {l.name} | {l.speed:.2}x stall, path {l.path:.1} deg, nose {l.pitch:.0} deg, crab {l.crab:.0} deg | sink {k_sink(kind, l):.1} m/s | worst {o.worst_part} {o.worst:.2} | lost {o.lost} | hull {o.hull:.3} | wrecked {o.wrecked}")
            if not l.bad:
                # (light damage at most: nothing torn off, no part under three quarters, still afloat)
                assert(o.lost == 0 and o.worst >= 0.75 and not o.wrecked, "{kind}, a {l.name} landing: {o.worst_part} at {o.worst:.2}, {o.lost} lost, wrecked {o.wrecked}")
            else if l.worst:
                # (a truly bad one does real harm)
                assert(o.lost > 0 or o.worst < 0.6 or o.wrecked, "{kind}, a {l.name} landing does no real harm: worst {o.worst:.2}")
