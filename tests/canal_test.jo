use '../src/canal_geometry.jo'
use '../src/river_data.jo'
use '../src/river_field.jo'
use '../src/flight.jo'
use '../src/flight_ground.jo'
use '../src/planes.jo'
use '../src/geography.jo'

test "canal bridge openings and swept decks share solid geometry":
    init_canal_geometry()
    loop j in 0..3:
        i=CANAL_BEGIN+[15,38,56][j]
        a=RIVER_NODES[i];b=RIVER_NODES[i+1]
        along=normalize(vec3(b.x-a.x,0,b.y-a.y))
        at=vec3(a.x,a.z+2,a.y)
        assert(canal_sweep(at-along*10,at+along*10).w==0)
        deck=if j==0:13.0 else:if j==1:13.0 else:4.0
        at.y=a.z+f32(deck+0.5)
        assert(canal_sweep(at-along*10,at+along*10).w>0)
        at.y=a.z+f32(deck-1.0)
        assert(canal_sweep(at,at+vec3(0,4,0)).y<0)
        # A walker below cannot snap onto an overhead deck.
        assert(canal_floor(f64(a.x),f64(a.y),f64(a.z)+2.8)<f64(a.z)+3.0)

test "bridge strike is resolved even while clear of the river":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    model=build_craft(Craft.gull,LIVERIES[0]);k=craft_spec(Craft.gull,model.contacts)
    a=RIVER_NODES[CANAL_BEGIN+56];b=RIVER_NODES[CANAL_BEGIN+57]
    dir=normalize(vec3(b.x-a.x,0,b.y-a.y));hd=atan2(f64(dir.x),-f64(dir.z))
    e=FlightEnv(ground=flight_surface_height,solid=canal_sweep,has_swell=true,swell_ceiling=f64(a.z)+0.1,
        swell=(x:f64,z:f64)->vec3:vec3(f32(river_at(x,z).level),0,0))
    s=CraftState(position=vec3(a.x,a.z+4.5,a.y)-dir*16.0,velocity=dir*25.0,orientation=quat_euler(0,-hd,0),fuel=k.fuel_capacity)
    loop i in 0..60:step(k,s,Controls(assist=0.0),e,1.0/60.0)
    assert(s.hull_damage>0 or s.crashed or length(s.velocity-dir*25.0)>8.0)
    assert(length(s.velocity)<150.0)

test "a gull can accelerate along the canal and clear the bridges":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    model=build_craft(Craft.gull,LIVERIES[0]);k=craft_spec(Craft.gull,model.contacts)
    a=RIVER_NODES[CANAL_BEGIN+22];b=RIVER_NODES[CANAL_BEGIN+23]
    hd=atan2(f64(b.x-a.x),-f64(b.y-a.y))
    e=FlightEnv(ground=flight_surface_height,solid=canal_sweep,has_swell=true,swell_ceiling=f64(a.z)+0.1,current_at=river_current,
        swell=(x:f64,z:f64)->vec3:
            r=river_at(x,z)
            vec3(if r.wet:f32(r.level) else:0,r.slope.x,r.slope.y))
    s=water_start(k,vec3(a.x,a.z,a.y),hd)
    plan=FlightPlan(takeoff_heading=hd,target=vec3(b.x,a.z+100,b.y),altitude=f64(a.z)+100)
    loop i in 0..1800:
        r=river_at(f64(s.position.x),f64(s.position.z))
        target=RIVER_NODES[min(CANAL_FINISH,max(CANAL_BEGIN,r.segment)+3)]
        if s.on_water:
            plan.takeoff_heading=atan2(f64(target.x-s.position.x),-f64(target.y-s.position.z))
            plan.target=vec3(target.x,target.z+100,target.y)
        step(k,s,autopilot(k,s,plan,e),e,1.0/60.0)
        if not s.on_water and s.position.y>a.z+15:break
    assert(not s.on_water and s.position.y>a.z+15 and s.hull_damage==0,"pos={s.position} damage={s.hull_damage} wet={s.on_water}")
