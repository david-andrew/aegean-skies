use '../src/canal_geometry.jo'
use '../src/river_data.jo'
use '../src/river_field.jo'
use '../src/flight.jo'
use '../src/flight_ground.jo'
use '../src/planes.jo'
use '../src/geography.jo'
use '../src/pilot.jo'
use '../src/slipway.jo'
use '../src/world_point.jo'
use '../src/chase_collision.jo'
import '../src/living_types.jo' as data

test "canal bridge openings and swept decks share solid geometry":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    init_canal_geometry()
    loop bridge in CANAL_BRIDGES:
        i=CANAL_BEGIN+bridge.local
        a=RIVER_NODES[i];b=RIVER_NODES[i+1]
        along=normalize(vec3(b.x-a.x,0,b.y-a.y))
        at=vec3(a.x,a.z+2,a.y)
        assert(canal_sweep(at-along*10,at+along*10).w==0,"bridge {bridge.local} blocks the water")
        # (its deck, a little off the centre line, is solid to a sweep along the canal)
        at.y=a.z+f32(canal_bridge_top(bridge,0.0,f64(a.w))-0.3)
        assert(canal_sweep(at-along*10,at+along*10).w>0,"bridge {bridge.local} has no deck")
        at.y=a.z+f32(canal_bridge_under(bridge,0.0,f64(a.w))-1.0)
        assert(canal_sweep(at,at+vec3(0,4,0)).y<0)
        # A walker below cannot snap onto an overhead deck.
        assert(canal_floor(f64(a.x),f64(a.y),f64(a.z)+2.8)<f64(a.z)+3.0)

test "a planing Gull held near the centre line passes under every crossing":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    # (floats on the water: the top wing's tip ~3.9 m over it, its half span 5.5 m)
    loop bridge in CANAL_BRIDGES:
        i=CANAL_BEGIN+bridge.local
        a=RIVER_NODES[i];b=RIVER_NODES[i+1]
        along=normalize(vec3(b.x-a.x,0,b.y-a.y));side=vec3(-along.z,0,along.x)
        loop lateral in [-8.0,-4.0,0.0,4.0,8.0]:
            loop tip in [-5.5,0.0,5.5]:
                at=vec3(a.x,a.z+3.9,a.y)+side*f32(lateral+tip)
                assert(canal_sweep(at-along*12,at+along*12).w==0,"bridge {bridge.local} strikes a wing at {lateral+tip} m")
                if bridge.kind==CANAL_STONE:
                    # (a metre spare over the wing everywhere within 8 m of the centre)
                    assert(canal_bridge_under(bridge,lateral+tip,f64(a.w))>4.9,"bridge {bridge.local}: {canal_bridge_under(bridge,lateral+tip,f64(a.w))} at {lateral+tip}")

test "the canal's walls stand to the street over the water":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    loop local in [10,25,40,45,60]:
        i=CANAL_BEGIN+local
        a=RIVER_NODES[i];b=RIVER_NODES[i+1];m=(a+b)*0.5
        d=normalize(b.xy-a.xy);side=vec2(-d.y,d.x)
        loop sign in [-1.0,1.0]:
            front=canal_frontage(local,sign)
            if front==3:continue
            q=m.xy+side*f32(sign*(f64(m.w)+1.0))
            top=canal_floor(f64(q.x),f64(q.y),f64(m.z)+20.0,true)
            assert(abs(top-(f64(m.z)+canal_street(front)))<0.05,"node {local} side {sign}: wall top {top-f64(m.z)}")

test "bridge strike is resolved even while clear of the river":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    model=build_craft(Craft.gull,LIVERIES[0]);k=craft_spec(Craft.gull,model.contacts)
    a=RIVER_NODES[CANAL_BEGIN+57];b=RIVER_NODES[CANAL_BEGIN+58]
    dir=normalize(vec3(b.x-a.x,0,b.y-a.y));hd=atan2(f64(dir.x),-f64(dir.z))
    e=FlightEnv(ground=flight_surface_height,solid=canal_sweep,has_swell=true,swell_ceiling=f64(a.z)+0.1,
        swell=(x:f64,z:f64)->vec3:vec3(f32(river_at(x,z).level),0,0))
    s=CraftState(position=vec3(a.x,a.z+4.5,a.y)-dir*16.0,velocity=dir*25.0,orientation=quat_euler(0,-hd,0),fuel=k.fuel_capacity)
    loop i in 0..60:step(k,s,Controls(assist=0.0),e,1.0/60.0)
    assert(s.hull_damage>0 or s.crashed or length(s.velocity-dir*25.0)>8.0)
    assert(length(s.velocity)<150.0)

test "a gull can accelerate along the canal and clear the bridges":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    # (at the game's flight scales, from the slipway's hand-over, steered as the canal scenario's
    # run is: it planes the cut under every bridge and lifts off on the wide reach past them)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    model=build_craft(Craft.gull,LIVERIES[0])
    f=make_flyer(.gull,0,model.contacts,canal_launch,canal_heading)
    f.state.moored=false
    plan=canal_run_plan()
    loop i in 0..3000:
        e=flight_env(f.state.time,f.state.position)
        step(f.spec,f.state,canal_run_controls(f,plan,e),e,1.0/60.0)
    set_speed_scale(1.0);data.scale_airframes(1.0)
    s=f.state
    assert(not s.on_water and s.position.y>canal_launch.y+40 and s.hull_damage==0,"pos={s.position} damage={s.hull_damage} wet={s.on_water}")

test "after a crash into the canal's wall the chase camera is put back out of the stone":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    model=build_craft(Craft.gull,LIVERIES[0])
    a=RIVER_NODES[CANAL_BEGIN+40];b=RIVER_NODES[CANAL_BEGIN+41]
    d=normalize(b.xy-a.xy);side=vec2(-d.y,d.x)
    # (the wreck lodged in the left wall, the camera frozen where it was, inside the stone too)
    wall=a.xy+side*f32(f64(a.w)+0.9)
    f=make_flyer(.gull,0,model.contacts,vec3(wall.x,a.z+3.0,wall.y),atan2(f64(d.x),-f64(d.y)))
    f.state.moored=false
    chase(f,1.0/60.0)
    f.state.crashed=true
    inside=a.xy+side*f32(f64(a.w)+1.0)-d*6.0
    f.cam_point=world_point(vec3(inside.x,a.z+2.5,inside.y));f.cam_pos=world_vec(f.cam_point);f.cam_ready=true
    loop k in 0..30:
        chase(f,1.0/60.0)
        frame=clear_chase_camera(f,target_chase_camera(f,vec3(0,0,-1),0),1.0/60.0)
        eye=world_vec(frame.eye)
        assert(f64(length(camera_push_out(eye,0.5)-eye))<0.001,"camera inside a solid at {eye}")
        assert(is_finite(frame.view.x) and f64(length(frame.view))>0.9)
