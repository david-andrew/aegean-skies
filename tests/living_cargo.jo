use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_cargo.jo'
use '../src/living_money.jo'
use '../src/living_jobs.jo'
use '../src/living_sim.jo'
use '../src/living_checks.jo'
use '../src/living_save.jo'

test "opening crates partition existing stocks and jobs reserve prior owned goods":
    w = build_world()
    assert(cargo_inventory_errors(w).len() == 0)
    stock = stock_totals(w); issued = w.next_cargo_source
    id = post_job(w, 1, 1, .commodity, 2, 1000, 500, 500)
    assert(id >= 0 and w.next_cargo_source == issued and stock_totals(w) == stock)
    assert(w.jobs[id].cargo_ids.len() > 0)
    loop lot in w.jobs[id].cargo_ids:
        c = w.cargo[lot]
        assert(c.owner == 1 and c.where == .warehouse and c.place == 0)
        assert(w.cargo_sources[c.source].sequence < w.jobs[id].cargo_sequence)
    assert(cargo_inventory_errors(w).len() == 0)

test "week of production imports travel and delivery conserves every lot and source":
    w = build_world(u64(42))
    loop minute in 0..7 * 1440:
        advance_minutes(w, 1)
        if minute % 60 == 0:
            errors = invariant_errors(w)
            if errors.len() > 0:
                print("minute {w.minute}: {errors}")
                loop p in w.people:
                    if p.action.end_minute + 60 < w.minute: print(p.id, p.carriage, p.carrying, p.action, p.trip, p.place)
                loop id, j in w.jobs:
                    if j.carrier == 2: print(id, j.state, j.loaded, j.collected)
            assert(errors.len() == 0)
    assert(w.next_trip > 10 and money_balances(w) and goods_balance(w))
    totals: {int: int}
    loop _, lot in w.cargo: totals[lot.source] = totals.get(lot.source, 0) + lot.quantity
    loop id, source in w.cargo_sources: assert(totals.get(id, 0) + source.consumed == source.issued)
    assert(validate_save_world(w) == "")

test "pre cargo saves are rejected before replacing either slot":
    w = build_world(); w.cargo_version = 0
    assert("migration" in validate_save_world(w))

test "old cargo headers reject reads and writes without changing either saved slot":
    assert(env("SLOPPY_SAVE_DIR") != none)
    prefix = "cargo-old-header"
    old = SaveGame(valid=true,terrain_key=123,generation=1,cargo_version=0,world=build_world())
    assert(save_value("{prefix}-a",old) and save_value("{prefix}-b",old))
    a = load_data("{prefix}-a"); b = load_data("{prefix}-b")
    assert(load_game(123,prefix) is LivingSaveError)
    assert(save_game(build_world(),PresentationState(),123,prefix) is LivingSaveError)
    assert(load_data("{prefix}-a") == a and load_data("{prefix}-b") == b)
    delete_data("{prefix}-a"); delete_data("{prefix}-b")

test "malformed cargo custody index and rewound identity counters reject cleanly":
    w = build_world(); id = w.jobs[3].cargo_ids[0]; c = w.cargo[id]
    w.cargo_bins[cargo_key(c.store,c.holder,c.good)].push(id)
    assert(validate_save_world(w) != "")
    w = build_world(); w.next_cargo = 0
    assert(validate_save_world(w) != "")
    w = build_world(); w.cargo[id].holder = 999
    assert(validate_save_world(w) != "")
