# Spindrift: wisps torn off a storm sea's crests, none in an ordinary sea; presentation only.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/spindrift_test.jo
use '../src/spindrift.jo'
use '../src/sea.jo'
use '../src/look.jo'

_run = (speed: f64) -> Spindrift:
    global wind_now, sea_state_now
    wind_now = Wind(vec2(0.8,0.6), speed, vec2(0,0))
    sea_state_now = sea_state(wind_now)
    sd = Spindrift()
    t = 100.0
    loop i in 0..240:
        step_spindrift(sd, vec3(0,30,8000), t, wind_now)   # (open water)
        t += 1.0/60.0
    sd

test "a storm sea throws spindrift and an ordinary one none":
    calm = _run(8.0)
    storm = _run(24.0)
    print("wisps: fresh breeze {calm.wisps.len()}, storm {storm.wisps.len()} (storm {sea_state_now.storm:.2}, height {sea_state_now.height:.1} m)")
    assert(calm.wisps.len() == 0)
    assert(storm.wisps.len() > 40)
    loop w in storm.wisps:
        assert(w.rise > 0.5 and w.life >= 1.5 and w.strength > 0.0)

test "spindrift draws nothing from the game's random numbers":
    seed_random(7); a = random(0.0, 1.0)
    seed_random(7); _run(24.0); b = random(0.0, 1.0)
    assert(a == b)

test "the storm foam's noise tile is smooth, seamless and centred":
    img = sea_storm_noise_image()
    size = STORM_NOISE_CELLS*STORM_NOISE_TEXELS
    total = vec4(0,0,0,0); jump = 0.0; seam = 0.0
    loop y in 0..size:
        loop x in 0..size:
            v = img.get(x,y)
            assert(v.x >= 0.0 and v.x <= 1.0 and v.w >= 0.0 and v.w <= 1.0)
            total += v
            if x > 0: jump = max(jump, f64(length(v-img.get(x-1,y))))
        seam = max(seam, f64(length(img.get(0,y)-img.get(size-1,y))))
    mean = total/f32(size*size)
    print("storm noise: mean {mean} largest step {jump:.3} across the seam {seam:.3}")
    assert(abs(mean.x-0.5) < 0.08 and abs(mean.w-0.5) < 0.08)
    assert(seam < jump*1.5 and jump < 0.4)
