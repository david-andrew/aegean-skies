# Table service and one's own pace: what is ordered is brought by the waiter (paid once, when
# ordered), set down at free spots, eaten and drunk only while the player holds the key, kept in
# hand when let go, put down by another item or Esc, and cleared by the waiter once empty a while.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/leisure_menu.jo'
use '../src/leisure.jo'
use '../src/table_service.jo'

_bar = () -> LeisurePlace: LeisurePlace("porto:hotel", 0, .bar, "Hotel Ancora", "hotel and terrace bar", 6, opens = 420, closes = 120, room_cents = 600)
_coffee = () -> LeisurePlace: LeisurePlace("porto:coffee", 0, .coffee_house, "The Coffee House", "coffee house", 6, menu = "coffee")

_spots = () -> ServiceSpots: ServiceSpots(vec3(0, 0, 0), vec3(8, 0, 6), vec3(8.8, 0.75, 6), vec3(1, 0, 0), vec3(0, 0, 1))
_flat = (x: f64, z: f64) -> f64: 0.0

_find = (menu: MenuItem[], name: str) -> MenuItem:
    loop d in menu:
        if d.name == name: return d
    menu[0]

_run = (wt: mut Waiter, served: mut Served[], seconds: f64):
    loop k in 0..int(seconds / 0.05): waiter_step(wt, _spots(), served, 0.05, _flat)

test "an order is brought by the waiter, not put straight on the table":
    w = build_world(u64(3))
    lp = _bar()
    w.people[w.player].place = lp.place
    w.minute = 600
    state = LeisureState()
    menu = leisure_menu(lp)
    before = w.accounts[w.people[w.player].account].cents
    r = leisure_order(w, lp, _find(menu, "Fix"), state)
    assert(r.ok)
    assert(state.served.len() == 0 and state.coming.len() == 1)
    assert(w.accounts[w.people[w.player].account].cents == before - r.cents)
    wt = Waiter()
    loop s in state.coming: waiter_order(wt, s)
    state.coming = []
    _run(wt, state.served, 1.0)
    assert(wt.stage == 1 and wt.tray.len() == 1 and state.served.len() == 0)
    _run(wt, state.served, 15.0)
    assert(state.served.len() == 1 and state.served[0].amount == 1.0)
    _run(wt, state.served, 15.0)
    assert(wt.stage == 0 and wt.tray.len() == 0)
    # (paid once: the waiter moves no money)
    assert(w.accounts[w.people[w.player].account].cents == before - r.cents)
    assert(money_balances(w))

test "three to a tray, the rest on the next trip, each at its own spot":
    menu = drinks_catalogue()
    wt = Waiter()
    served: Served[]
    loop k in 0..5: waiter_order(wt, Served(menu[k], 0, 0))
    _run(wt, served, 3.0)
    assert(wt.tray.len() == 3 and wt.pending.len() == 2)
    _run(wt, served, 60.0)
    assert(served.len() == 5 and wt.pending.len() == 0)
    loop a in 0..served.len():
        loop b in a + 1..served.len(): assert(served[a].seat != served[b].seat)

test "one drinks only while the key is held, keeps it in hand, and puts it down":
    menu = drinks_catalogue()
    served = [Served(_find(menu, "Fix"), 0, 0), Served(_find(menu, "Ouzo, the house's"), 0, 1)]
    tk = Taking()
    # (taken up, not yet at the lips: nothing drunk)
    take_step(tk, served, 0.05, 0, true, false)
    assert(tk.held == 0 and served[0].held and served[0].amount == 1.0)
    loop k in 0..60: take_step(tk, served, 0.05, -1, true, false)
    sipped = served[0].amount
    assert(sipped < 1.0 and sipped > 0.0)
    # (let go: held at the chest, the level stays)
    loop k in 0..40: take_step(tk, served, 0.05, -1, false, false)
    assert(tk.held == 0 and served[0].amount == sipped and tk.lift < 0.5)
    # (the other one: the first goes back on the table)
    take_step(tk, served, 0.05, 1, false, false)
    assert(tk.held == 1 and not served[0].held and served[1].held)
    # (Esc)
    take_step(tk, served, 0.05, -1, false, true)
    assert(tk.held == -1 and not served[1].held)

test "a glass held to the lips is finished, and its empty stays until the waiter clears it":
    menu = drinks_catalogue()
    served = [Served(_find(menu, "Ouzo, the house's"), 0, 0)]
    tk = Taking()
    take_step(tk, served, 0.05, 0, true, false)
    loop k in 0..400: take_step(tk, served, 0.05, -1, true, false)
    assert(served[0].amount == 0.0)
    take_step(tk, served, 0.05, -1, false, true)
    loop k in 0..200: take_step(tk, served, 0.05, -1, false, false)
    assert(served.len() == 1 and served[0].empty_for >= 9.0)
    wt = Waiter()
    _run(wt, served, 5.0)
    assert(served.len() == 1)             # (not yet: it has not stood long enough)
    loop k in 0..800: take_step(tk, served, 0.05, -1, false, false)
    _run(wt, served, 30.0)
    assert(served.len() == 0)

test "eating goes bite by bite while held, and the plate stays on the table":
    food = MenuItem("Meze plate", "Food", "To start", serve = .plate, food = true)
    served = [Served(food, 0, 0)]
    tk = Taking()
    take_step(tk, served, 0.05, 0, true, false)
    loop k in 0..100: take_step(tk, served, 0.05, -1, true, false)
    assert(served[0].amount < 1.0 and served[0].amount > 0.0)
    left = served[0].amount
    loop k in 0..100: take_step(tk, served, 0.05, -1, false, false)
    assert(served[0].amount == left)
    assert(take_label(served[0]).contains("Meze"))

test "the waiter never takes what is in hand or not yet finished":
    menu = drinks_catalogue()
    served = [Served(menu[0], 0, 0, amount = 0.0, empty_for = 100.0, held = true), Served(menu[1], 0, 1, amount = 0.4, empty_for = 100.0)]
    wt = Waiter()
    _run(wt, served, 40.0)
    assert(served.len() == 2)

test "each house's bill of fare is a handful of its own menu, by section":
    loop lp in [_bar(), _coffee()]:
        menu = leisure_menu(lp)
        bill = leisure_bill(lp, menu)
        want = if lp.menu == "coffee": BILL_COFFEE else: BILL_HOTEL
        n = 0
        loop sec in want: n += sec.len() - 1
        assert(bill.items.len() == n)         # (every line is on the house's menu)
        assert(bill.items.len() <= 9)         # (a key each)
        total = 0
        loop c in bill.counts: total += c
        assert(total == bill.items.len() and bill.titles.len() == want.len())

test "a button keeps the thing's plain name, however much is left":
    food = MenuItem("Meze plate", "Food", "To start", serve = .plate, food = true)
    loop a in [1.0, 0.6, 0.2, 0.0]:
        assert(take_label(Served(food, 0, 0, amount = a)) == "Meze plate")

test "seated: an empty is cleared, one with some left is left alone":
    menu = drinks_catalogue()
    served = [Served(menu[0], 0, 0, amount = 0.0, empty_for = 60.0), Served(menu[1], 0, 1, amount = 0.5)]
    wt = Waiter()
    _run(wt, served, 30.0)
    assert(served.len() == 1 and served[0].amount == 0.5)

test "after a good while untouched, he asks; not yet, and it's left a while longer; yes, and it goes":
    menu = drinks_catalogue()
    served = [Served(menu[1], 0, 1, amount = 0.5)]
    tk = Taking()
    loop k in 0..int(ASK_AFTER / 0.05) + 2: take_step(tk, served, 0.05, -1, false, false)
    wt = Waiter()
    _run(wt, served, 20.0)
    assert(wt.stage == 7)
    if let s = waiter_asking_about(wt, served): assert(s.seat == 1) else: assert(false)
    # (he waits for the answer)
    _run(wt, served, 10.0)
    assert(wt.stage == 7 and served.len() == 1)
    waiter_answer(wt, served, false)
    assert(served.len() == 1 and served[0].still < 0.0 and wt.stage == 3)
    _run(wt, served, 20.0)
    assert(wt.stage == 0)
    # (not asked again soon)
    loop k in 0..200: take_step(tk, served, 0.05, -1, false, false)
    _run(wt, served, 10.0)
    assert(wt.stage == 0)
    # (much later he asks again; yes, and it goes)
    loop k in 0..int((NOT_YET + ASK_AFTER) / 0.05): take_step(tk, served, 0.05, -1, false, false)
    _run(wt, served, 20.0)
    assert(wt.stage == 7)
    waiter_answer(wt, served, true)
    assert(served.len() == 0 and wt.tray.len() == 1)

test "taking a sip resets the wait: something being eaten is never asked about":
    menu = drinks_catalogue()
    served = [Served(menu[1], 0, 1, amount = 0.9)]
    tk = Taking()
    loop k in 0..int(ASK_AFTER / 0.05) - 20: take_step(tk, served, 0.05, -1, false, false)
    take_step(tk, served, 0.05, 0, true, false)
    take_step(tk, served, 0.05, -1, false, true)
    loop k in 0..100: take_step(tk, served, 0.05, -1, false, false)
    assert(waiter_ask_ready(served) == -1)

test "the pilot gone: everything left is cleared, a trayful at a time, and back to the pass":
    menu = drinks_catalogue()
    served = [loop k in 0..5: Served(menu[k], 0, k, amount = 0.5)]
    wt = Waiter(clear_all = true)
    _run(wt, served, 12.0)
    assert(served.len() == 2 and wt.tray.len() == 3)
    _run(wt, served, 40.0)
    assert(served.len() == 0 and wt.stage == 0)
