use '../src/battle_radio.jo'
use '../src/combat.jo'
use '../src/flight.jo'
use '../src/combat_sound.jo'
use '../src/air_view.jo'

test "battle radio follows real formation and fire once, then resets on rewind":
    b=Battle(enabled=true,tick=90)
    loop id in 1..4:
        b.actors.push(Combatant(id,id,if id==3:2 else:1,craft_spec(.gull,[]),CraftState(position=vec3(id*100,400,0))))
    radio=BattleRadio();before=to_text(b)
    assert(battle_radio_cue(radio,b,1)==0)
    assert(to_text(b)==before)
    assert(battle_radio_cue(radio,b,1)== -1)
    b.tick=600
    assert(battle_radio_cue(radio,b,1)== -1)
    b.actors[1].gun.shots=1
    assert(battle_radio_cue(radio,b,1)==1)
    b.tick=1200
    assert(battle_radio_cue(radio,b,1)== -1)
    b.actors[0].status= .wreck
    assert(battle_radio_cue(radio,b,1)==2)
    b.actors[0].status= .flying;b.actors[1].gun.shots=0;b.tick=90
    assert(battle_radio_cue(radio,b,1)==0)
    b.finished=true;b.tick=2000
    assert(battle_radio_cue(radio,b,1)== -1)

test "procedural combat radio and hull splash are bounded finite sounds":
    total=0
    loop sound in [battle_radio_wave("VV",1931),battle_radio_wave("R",1932),battle_radio_wave("SOS",1933),wreck_water_report()]:
        assert(sound.samples.len()>48000 and sound.samples.len()<400000)
        peak=0.0
        loop sample in sound.samples:
            assert(sample==sample)
            peak=max(peak,abs(f64(sample)))
        assert(peak>0.1 and peak<1)
        total+=sound.samples.len()
    assert(total*4<3000000)

test "bank glints remain angular under overcast and fair cues are unchanged":
    s=CraftState(position=vec3(0,300,0),orientation=quat_euler(0,PI,0))
    cam=s.position+vec3(0,1200,1600);sun=normalize(vec3(0,0.6,-0.8))
    fair=air_cue(s,cam,sun,.cruise,1,0)
    covered=air_cue(s,cam,sun,.cruise,1,0,1)
    assert(fair.glint>0.9 and covered.glint>0.5 and covered.glint<fair.glint)
    s.orientation=quat_euler(0,PI,PI/2)
    assert(air_cue(s,cam,sun,.cruise,1,0,1).glint<0.01)
