use '../src/air_race.jo'
use '../src/air_pilot.jo'
use '../src/flight.jo'
use '../src/planes.jo'

meet_fixture = () -> AirMeet:
    gates = air_course(vec3(0, 0, 0), vec3(0, 0, -1), (x: f64, z: f64) -> f64: -20.0)
    AirMeet(1, 10001, 13, "Capital race", gates, race_tick = 60, display_tick = 60 * 600, end_tick = 60 * 900)

test "race entry is unique and swept gates require direction extent order and full laps":
    meet = meet_fixture()
    assert(enter_air_meet(meet, 1, 2, true, 0))
    assert(not enter_air_meet(meet, 1, 3, true, 0) and not enter_air_meet(meet, 4, 2, true, 0))
    advance_air_meet(meet, 60)
    assert(not enter_air_meet(meet, 4, 5, true, 60))
    gate = meet.gates[0]; side = vec3(-gate.forward.z, 0, gate.forward.x)
    assert(air_gate_crossing(gate, gate.center - gate.forward * 10, gate.center + gate.forward * 10) == 0.5)
    assert(air_gate_crossing(gate, gate.center + gate.forward * 10, gate.center - gate.forward * 10) < 0)
    assert(air_gate_crossing(gate, gate.center - gate.forward * 10 + side * 500, gate.center + gate.forward * 10 + side * 500) < 0)
    assert(air_gate_crossing(gate, vec3(gate.center.x, 700, gate.center.z) - gate.forward * 10, vec3(gate.center.x, 700, gate.center.z) + gate.forward * 10) < 0)
    tick = 61
    loop crossing in 0..13:
        g = meet.gates[crossing % 6]
        # A deliberate discontinuity is sampled, never awarded; the following short sweep is real.
        sample_air_entry(meet, 1, g.center - g.forward * 10, tick)
        sample_air_entry(meet, 1, g.center + g.forward * 10, tick + 1)
        tick += 2
        if crossing < 12: assert(meet.entries[0].finished_tick < 0)
    assert(meet.entries[0].laps == 2 and meet.entries[0].finished_tick >= 0)
    saved = from_text[AirMeet](to_text(meet)); assert(saved is AirMeet and saved == meet)

test "bad venues and unsafe weather cancel without made-up racers":
    assert(air_course(vec3(0, 0, 0), vec3(0, 0, -1), (x: f64, z: f64) -> f64: 20.0).len() == 0)
    meet = meet_fixture(); advance_air_meet(meet, 1, false)
    assert(meet.phase == .cancelled and meet.entries.len() == 0)

test "autopilot racer physically completes the pylon circuit":
    set_speed_scale(1)
    model = build_craft(.swift, LIVERIES[0]); k = craft_spec(.swift, model.contacts)
    meet = meet_fixture(); meet.laps = 1
    assert(enter_air_meet(meet, 1, 2, false, 0)); advance_air_meet(meet, 60)
    gate = meet.gates[0]; h = atan2(f64(gate.forward.x), -f64(gate.forward.z))
    s = CraftState(position = gate.center - gate.forward * 600, orientation = quat_euler(0, -h, 0), velocity = gate.forward * f32(k.cruise_speed), fuel = 100)
    loop tick in 60..60 * 600:
        sample_air_entry(meet, 1, s.position, tick, not s.crashed)
        if meet.entries[0].finished_tick >= 0: break
        if let task = air_race_task(meet, meet.entries[0], s.position):
            c = air_waypoint_controls(k, s, FlightEnv(), task.aim, task.altitude, k.cruise_speed * task.pace)
            step(k, s, c, FlightEnv(), 1.0 / 60.0)
    e = meet.entries[0]
    print("race gate={e.gate} laps={e.laps} finish={e.finished_tick} pose={s.position} damage={s.hull_damage}")
    assert(e.laps == 1 and e.finished_tick > 60 and not s.crashed and s.hull_damage < 0.01)
