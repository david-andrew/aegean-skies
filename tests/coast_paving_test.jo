use '../src/coast_paving.jo'
use '../src/render_space.jo'

test "paving buckets preserve crossing triangles and bound retained buffers":
    vs: Vertex3D[]
    loop k in 0..300:
        p = vec3(f32(k)*80.0,0,0)
        loop d in [vec3(-70,0,-70),vec3(80,3,0),vec3(0,1,90)]:
            vs.push(Vertex3D(p+d,vec3(0,1,0),vec2(183,0),vec4(1,1,1,1)))
    blocks = paving_blocks(vs)
    assert(blocks.len() == PAVING_BLOCKS+1)
    total = 0
    found: {int: bool}
    loop b in blocks:
        total += b.vertices.len()
        loop k in 0..b.vertices.len()/3:
            a = b.vertices[k*3]
            id = int(round((a.pos.x+70.0)/80.0))
            assert(not found.get(id,false)); found[id] = true
            loop j in 0..3: assert(b.vertices[k*3+j] == vs[id*3+j])
        center = (b.low+b.high)*0.5; radius = length(b.high-b.low)*0.5
        loop v in b.vertices: assert(length(v.pos-center) <= radius+0.001)
    assert(total == vs.len() and found.len() == 300)

test "paving culling keeps edge intersections and local-chart translations":
    planes = paving_planes(mat4())
    loop origin in [vec3(0,0,0),vec3(220000,0,-120000)]:
        cam = origin
        assert(paving_visible(origin,0.1,cam,origin,planes))
        assert(paving_visible(origin+vec3(3,0,0),2.1,cam,origin,planes))
        assert(not paving_visible(origin+vec3(10,0,0),0.1,cam,origin,planes))
    scene_warp_b = vec4(1,200,8,0)
    assert(paving_visible(vec3(100,0,0),0.1,vec3(0,0,0),vec3(0,0,0),planes))
    scene_warp_b = vec4(0,0,0,0)
