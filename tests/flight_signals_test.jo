use '../src/flight_signals.jo'

test "a word from the flight in sight goes by hand near to, by lamp farther off, else by the R/T":
    at=vec3(0,500,0)
    assert(signal_way(at+vec3(120,0,0),at)==.hand)
    assert(signal_way(at+vec3(0,0,900),at)==.lamp)
    assert(signal_way(at+vec3(4000,0,0),at)==.none)

test "the lamp spells the line's first word in Morse, over and over, a pause between":
    assert(signal_word("Follow me down. We'll land in turn.")=="FOLLOW")
    assert(signal_word("Close up.")=="CLOSE" and signal_word("...")=="K" and signal_word("Abeam")=="ABEAM")
    s=signal_start(.lamp,7,"E",10.0,4.8)
    # (E: one unit lit, then the letter's and the word's gaps dark, then again)
    assert(signal_lit(s,SIGNAL_UNIT*0.5) and not signal_lit(s,SIGNAL_UNIT*1.5))
    n=s.code.len()+4
    assert(signal_lit(s,SIGNAL_UNIT*(f64(n)+0.5)))
    lit=0
    loop k in 0..n:
        if signal_lit(s,SIGNAL_UNIT*(f64(k)+0.5)): lit+=1
    assert(lit==1)
    assert(s.until==14.8 and s.craft==7)
