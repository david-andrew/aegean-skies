strait = () -> ScenarioState:
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    build_scenario("strait",towns,build_craft_models())!

test "the Ierax lies in deep water in a lee 25 km west of the strait, her moorings and a landing run clear":
    s=strait()
    d=f64(length(vec3(TENDER_AT.x-STRAIT_CENTER.x,0,TENDER_AT.z-STRAIT_CENTER.z)))
    assert(d>22000.0 and d<29000.0)
    spec=vessel_spec(.seaplane_tender)
    assert(sea_depth_ok(TENDER_AT.xz,spec.draft+2.0))
    # (her whole length afloat)
    loop z in [-0.5,0.0,0.5]: assert(sea_depth_ok(tender_local(vec3(0,0,f32(z*spec.length))).xz,spec.draft))
    # (land close to the east, the island she lies under)
    lee=false
    loop k in 1..30:
        if place_ground(vec2(TENDER_AT.x+f32(f64(k)*100.0),TENDER_AT.z))>0.0: lee=true
    assert(lee)
    loop k in 0..TENDER_SLOTS: assert(sea_depth_ok(tender_slot(k).xz,1.5))
    # (the strait's flight lands to seaward of her)
    h=tender_home(1)
    rw=air_runway(h.centre,h.out,vec3(0,0,6),(x:f64,z:f64)->f64:place_ground(vec2(f32(x),f32(z))),h.altitude,rollout=1900.0)
    assert(rw.valid)
    homes=s.battle.homes
    assert(homes.len()==2 and homes[0].side==1 and homes[0].name==TENDER_NAME and f64(length(homes[0].centre-TENDER_AT))<1.0)

test "the derrick lifts her in clear of the rail, swings her over the deck and sets her down; and back":
    start=tender_slot(0); from=tender_under_derrick(); to=tender_deck_spot()
    assert(f64(length(hoist_point(start,from,to,0.0,false)-start))<0.01)
    assert(f64(length(hoist_point(start,from,to,HOIST_HOOK,false)-from))<0.01)
    assert(f64(length(hoist_point(start,from,to,hoist_seconds(),false)-to))<0.01)
    mid=hoist_point(start,from,to,HOIST_HOOK+HOIST_LIFT+HOIST_SWING*0.5,false)
    assert(f64(mid.y)>f64(to.y)+2.0)
    assert(f64(length(hoist_point(start,from,to,0.0,true)-to))<0.01 and f64(length(hoist_point(start,from,to,hoist_seconds(),true)-from))<0.01)
    # (under the derrick: on the water beside her, within its reach)
    assert(sea_depth_ok(from.xz,1.5) and f64(length((from-tender_derrick()).xz))<12.0)

test "Kalyra's flight comes home to the Ierax and moors in turn along her booms and astern":
    s=strait()
    b=s.battle
    loop i in 0..b.actors.len():
        if b.actors[i].side==2:b.actors[i].present=false;b.actors[i].status=.escaped
    b.tick=700
    went=-1;all=-1;crashed=0;over=0.0
    loop tick in 0..60*900:
        observer=b.actors[0].state.position
        e=flight_env(f64(b.tick)/60.0,observer)
        step_battle(b,e,observer)
        if went<0 and b.home_since[1]>=0:went=b.tick
        # (the highest ground any of them flies over on the way: round the island, not over its ridge)
        if tick%30==0:
            loop a in b.actors:
                if a.side==1 and not a.human and a.status==.flying and not a.state.on_water:over=max(over,e.ground(f64(a.state.position.x),f64(a.state.position.z)))
        done=0;home=0
        loop a in b.actors:
            if a.side==1 and a.status==.flying and not a.human:
                home+=1
                if a.pilot.home_done:done+=1
        if home>0 and done==home:all=tick;break
    loop a in b.actors:
        if a.side==1 and a.status!=.flying:crashed+=1
    print("Kalyra home from {went}, all moored at the Ierax after {f64(all)/60.0:.0} s, lost {crashed}; the highest ground flown over {over:.0} m")
    assert(went>=0 and all>0 and crashed==0)
    # (the island's ridge, 1,200 m, between the strait and her: the flight goes round its low north end)
    assert(over<700.0)
    # (each at a mooring of hers, none on another's)
    loop a in b.actors:
        if a.side!=1 or a.human:continue
        near=1e9
        loop k in 0..TENDER_SLOTS: near=min(near,f64(length(vec3(a.state.position.x-tender_slot(k).x,0,a.state.position.z-tender_slot(k).z))))
        assert(near<15.0)
        loop o in b.actors:
            if o.side==1 and not o.human and a.craft<o.craft: assert(length(a.state.position-o.state.position)>12.0)

test "the ways aboard her: her Jacob's ladder over her side between the booms, her boat alongside at its foot, off an aircraft by its float's bow, and below at her house":
    spec=vessel_spec(.seaplane_tender)
    loop k in 0..4:
        at=tender_slot(k)
        assert(tender_boom_at(at)==k)
        ladder=tender_ladder(at)
        foot=tender_local_of(ladder.0); top=tender_local_of(ladder.1)
        # (on her side toward the aircraft, from a little over the water to her rail, clear of a boom)
        section=vessel_deck_section(f64(foot.z),spec.length,spec.beam,spec.deck,false)
        assert(abs(foot.x-section.x-0.12)<0.01 and abs(f64(ladder.0.y)-LADDER_FOOT)<0.01 and abs(top.y-section.y-f32(TENDER_RAIL))<0.01)
        loop j in 0..4: assert(abs(f64(foot.z)-(30.0-TENDER_STEP*f64(j)))>=3.99)
        boat=tender_boat_at_ladder(ladder,vessel_spec(.rowboat).beam)
        bl=tender_local_of(boat)
        assert(bl.x>section.x+f32(vessel_spec(.rowboat).beam*0.5) and abs(f64(bl.z-foot.z))<0.01)
        # (the hand helping them over stands on her deck, inboard of the rail)
        assert(tender_on_deck(tender_inboard(ladder,0.55)) and tender_on_deck(tender_inboard(ladder,1.0)))
    assert(tender_boom_at(tender_slot(5))<0)
    # (off a floatplane: down beside the cockpit onto the float's top, forward to its bow, a little
    # over the water; a flying boat's hull the same, on its centre line)
    path=off_aircraft_path(vec3(0,0.4,0.5),false,1.55,8.0,-2.0)
    assert(path.len()==3 and abs(f64(path[1].x)-1.55)<0.01 and f64(path[1].y)>-2.0 and f64(path[1].y)<-1.5 and f64(path[2].z)<-3.0)
    hull=off_aircraft_path(vec3(0,0.4,0.5),true,4.7,9.4,-0.6)
    assert(abs(f64(hull[2].x))<0.01 and f64(hull[2].z)<-4.0)
    # (walking in from her rail toward her middle, they reach her house's door, on her deck all the way)
    rail=tender_inboard(tender_ladder(tender_slot(1)),0.6)
    p=rail; inside=false
    loop _ in 0..60:
        p=p+normalize(vec3(TENDER_AT.x-p.x,0,TENDER_AT.z-p.z))*0.5
        if tender_below(p): inside=true;break
        assert(tender_deck_height(f64(p.x),f64(p.z))!=none)
    assert(inside)
    assert(not tender_on_deck(tender_slot(0)) and tender_on_deck(tender_deck_spot()))

test "the direct berth brings the float within a step of the ladder and keeps the wing clear":
    s = vessel_spec(.seaplane_tender)
    loop kind in [.gull,.heron,.corsair]:
        prof = aircraft_profile(kind)
        loop side in [-1.0,1.0]:
            ladder = tender_direct_ladder(tender_local(vec3(f32(20*side),0,15)),prof.span)
            at,head,path = tender_float_berth(ladder,prof,-2.0,vec3(0,0,0.4))
            q = quat_euler(0,-head,0)
            bow = at+quat_rotate(q,path[2])
            assert(abs(length((bow-ladder.0).xz)-0.8)<0.02)
            loop wing in [-1.0,1.0]:
                tip = tender_local_of(at+quat_rotate(q,vec3(f32(wing*prof.span*0.5),0,-0.5)))
                section = vessel_deck_section(f64(tip.z),s.length,s.beam,s.deck,false)
                assert(f64(abs(tip.x)-section.x)>0.4)

test "the pulling boat rows a continuous sweep, stops at both ends and backs off the float":
    start = tender_local(vec3(8,0,17))
    approach = tender_local(vec3(33,0,24))
    finish = tender_local(vec3(33,0,16))
    arc = tender_local(vec3(8,0,23))
    out = tender_boat_course(start,arc,approach,finish)
    back = tender_boat_course(finish,approach,arc,start)
    assert(out.length>length(finish-start))
    assert(tender_row_pose(out,0,false).0==start and tender_row_pose(out,0,false).2==0.0)
    at_float = tender_row_pose(out,1e9,false)
    assert(at_float.0==finish and at_float.2==0.0)
    assert(abs(angle_delta(at_float.1,tender_row_pose(back,0,true).1))<0.00001)
    assert(tender_row_pose(back,1e9,true).0==start)
    loop route in [out,back]:
        backwards = route.points[0]==back.points[0]
        previous = tender_row_pose(route,0,backwards)
        loop n in 1..101:
            p = tender_row_pose(route,route.length/TENDER_ROW_SPEED*f64(n)/100,backwards)
            assert(abs(angle_delta(p.1,previous.1))<0.30)
            if n<100: assert(p.2>0.0)
            previous = p
