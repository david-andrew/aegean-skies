use '../src/world.jo'
use '../src/world_point.jo'
use '../src/world_towns.jo'
use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/tweaks.jo'
use '../src/combat.jo'
use '../src/scenarios.jo'
use '../src/pilot.jo'
use '../src/flight_ground.jo'
use '../src/sea_routes.jo'
use '../src/air_pilot.jo'
use '../src/tender.jo'
use '../src/vessel_types.jo'
import '../src/living_types.jo' as data

strait = () -> ScenarioState:
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    build_scenario("strait",towns,build_craft_models())!

test "the Ierax lies in deep water in a lee 25 km west of the strait, her moorings and a landing run clear":
    s=strait()
    d=f64(length(vec3(TENDER_AT.x-STRAIT_CENTER.x,0,TENDER_AT.z-STRAIT_CENTER.z)))
    assert(d>22000.0 and d<29000.0)
    spec=vessel_spec(.seaplane_tender)
    assert(sea_depth_ok(TENDER_AT.xz,spec.draft+2.0))
    # (her whole length afloat)
    loop z in [-0.5,0.0,0.5]: assert(sea_depth_ok(tender_local(vec3(0,0,f32(z*spec.length))).xz,spec.draft))
    # (land close to the east, the island she lies under)
    lee=false
    loop k in 1..30:
        if place_ground(vec2(TENDER_AT.x+f32(f64(k)*100.0),TENDER_AT.z))>0.0: lee=true
    assert(lee)
    loop k in 0..TENDER_SLOTS: assert(sea_depth_ok(tender_slot(k).xz,1.5))
    # (the strait's flight lands to seaward of her)
    h=tender_home(1)
    rw=air_runway(h.centre,h.out,vec3(0,0,6),(x:f64,z:f64)->f64:place_ground(vec2(f32(x),f32(z))),h.altitude,rollout=1900.0)
    assert(rw.valid)
    homes=s.battle.homes
    assert(homes.len()==2 and homes[0].side==1 and homes[0].name==TENDER_NAME and f64(length(homes[0].centre-TENDER_AT))<1.0)

test "the derrick lifts her in clear of the rail, swings her over the deck and sets her down; and back":
    start=tender_slot(0); from=tender_under_derrick(); to=tender_deck_spot()
    assert(f64(length(hoist_point(start,from,to,0.0,false)-start))<0.01)
    assert(f64(length(hoist_point(start,from,to,HOIST_HOOK,false)-from))<0.01)
    assert(f64(length(hoist_point(start,from,to,hoist_seconds(),false)-to))<0.01)
    mid=hoist_point(start,from,to,HOIST_HOOK+HOIST_LIFT+HOIST_SWING*0.5,false)
    assert(f64(mid.y)>f64(to.y)+2.0)
    assert(f64(length(hoist_point(start,from,to,0.0,true)-to))<0.01 and f64(length(hoist_point(start,from,to,hoist_seconds(),true)-from))<0.01)
    # (under the derrick: on the water beside her, within its reach)
    assert(sea_depth_ok(from.xz,1.5) and f64(length((from-tender_derrick()).xz))<12.0)

test "Kalyra's flight comes home to the Ierax and moors in turn along her booms and astern":
    s=strait()
    b=s.battle
    loop i in 0..b.actors.len():
        if b.actors[i].side==2:b.actors[i].present=false;b.actors[i].status=.escaped
    b.tick=700
    went=-1;all=-1;crashed=0
    loop tick in 0..60*720:
        observer=b.actors[0].state.position
        step_battle(b,flight_env(f64(b.tick)/60.0,observer),observer)
        if went<0 and b.home_since[1]>=0:went=b.tick
        done=0;home=0
        loop a in b.actors:
            if a.side==1 and a.status==.flying and not a.human:
                home+=1
                if a.pilot.home_done:done+=1
        if home>0 and done==home:all=tick;break
    loop a in b.actors:
        if a.side==1 and a.status!=.flying:crashed+=1
    print("Kalyra home from {went}, all moored at the Ierax after {f64(all)/60.0:.0} s, lost {crashed}")
    assert(went>=0 and all>0 and crashed==0)
    # (each at a mooring of hers, none on another's)
    loop a in b.actors:
        if a.side!=1 or a.human:continue
        near=1e9
        loop k in 0..TENDER_SLOTS: near=min(near,f64(length(vec3(a.state.position.x-tender_slot(k).x,0,a.state.position.z-tender_slot(k).z))))
        assert(near<15.0)
        loop o in b.actors:
            if o.side==1 and not o.human and a.craft<o.craft: assert(length(a.state.position-o.state.position)>12.0)
