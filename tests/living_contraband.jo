use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_contraband.jo'

test "private tobacco buyer is trusted physically present capped and funded":
    w = build_world()
    w.people[0].place = 5; w.aircraft[0].place = 5; w.aircraft[0].dock = -1
    assert(trade(w,0,5,7,1000,true,0))
    w.people[0].place = 0; w.aircraft[0].place = 0
    assert(not trade(w,0,0,7,1000,false,0))
    assert(not sell_discreet(w,0,6,1000,0))
    seed_relationship(w,0,6,true)
    cash = w.accounts[0].cents
    assert(sell_discreet(w,0,6,1000,0))
    assert(w.accounts[0].cents == cash+3080)
    assert(not sell_discreet(w,0,6,1000,0))
    assert(w.people[6].pocket.qty[7] == 1000 and money_balances(w) and goods_balance(w))
