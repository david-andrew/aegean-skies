# On foot (tweaks.on_foot, src/foot_sound.jo): its sounds made in pieces, every ground its own
# footsteps, each take its own, none clipped.
use '../src/foot_sound.jo'

test "on foot: every ground's steps and every moment's sounds are made, a few a piece":
    f = FootSound()
    pieces = 0
    loop not f.ready:
        foot_sound_build_step(f); pieces += 1
    assert(pieces > GROUNDS*2)
    assert(f.steps.len() == GROUNDS)
    loop g in 0..GROUNDS:
        assert(f.steps[g].len() == FOOT_TAKES,"{Ground(g)}")
        assert(f.steps[g][0].samples != f.steps[g][1].samples,"{Ground(g)}: its takes differ")
    loop takes in [f.climb_in,f.climb_out,f.chair,f.stool,f.glass,f.plate]+f.steps:
        loop s in takes:
            peak = 0.0
            loop v in s.samples: peak = max(peak,abs(f64(v)))
            assert(peak > 0.05 and peak <= 0.5)
    # (the grounds sound apart: planks lower and rounder than stone)
    centroid = (s: Sound) -> f64:
        e = 0.0; d = 0.0
        loop i in 1..s.samples.len()/2:
            a = f64(s.samples[i*2]); b = f64(s.samples[(i-1)*2])
            e += a*a; d += (a-b)*(a-b)
        sqrt(d/max(e,1e-12))
    assert(centroid(f.steps[int(Ground.planks)][0]) < centroid(f.steps[int(Ground.stone)][0]))
