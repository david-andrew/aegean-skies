use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_pirates.jo'
use '../src/living_events.jo'
use '../src/living_news.jo'

test "real reachable sortie contact and news funded patrol":
    loop seed in [0,1,7,42,127]:
        w = build_world(u64(seed))
        advance_minutes(w,1440*3)
        print("seed {seed}: sorties {w.raid_departures}, encounters {w.encounters.len()}, patrols {w.patrol_departures}")
        assert(w.raid_departures > 0 and w.encounters.len() > 0)
        assert(w.patrol_departures > 0 and w.factions[0].bounty_event >= 0)
        assert(money_balances(w) and goods_balance(w))
        loop id, e in w.encounters:
            assert(e.resolved and not finish_encounter(w,id,true))

test "loot capped by actual value quantity capacity and one resolution":
    w = build_world()
    before = w.aircraft[2].cargo.qty[3]
    amount = loot_cargo(w,6,2)
    assert(amount <= 720 and amount >= 0)
    assert(w.aircraft[2].cargo.qty[3]+w.aircraft[6].cargo.qty[3] == before)
    assert(w.jobs[1].lost_quantity == before-w.aircraft[2].cargo.qty[3])
    assert(goods_balance(w) and money_balances(w))

test "bounty needs witnessed custody and cannot pay twice":
    w = build_world()
    advance_minutes(w,1440)
    assert(w.factions[0].bounty_cents > 0)
    source = w.factions[0].bounty_event
    c = 6; target = w.aircraft[c].owner
    w.places[5].residents.remove(target)
    w.people[target].place = 0; w.places[0].residents.push(target)
    w.aircraft[c].place = 0; w.aircraft[c].dock = -1
    w.aircraft[c].held_by_faction = 0; w.aircraft[c].state = .ditched
    event = emit_event(w,.patrol,0,0,target,Reason(purpose=.patrol,actor=0,counterparty=target,source_event=source))
    w.events[event].witnesses = [0,9,target]
    assert(not claim_bounty(w,0,c,event))
    w.aircraft[c].state = .workshop
    cash = w.accounts[0].cents
    assert(claim_bounty(w,0,c,event))
    assert(w.accounts[0].cents == cash+4000 and not claim_bounty(w,0,c,event))
    assert(w.aircraft[c].owner == target and money_balances(w) and goods_balance(w))

test "patrol fuel allowance includes carried sub cent debt when officer is penniless":
    w = build_world()
    assert(transfer(w,w.people[9].account,w.factions[1].account,w.accounts[9].cents,.trade))
    burn_fuel(w,4,50000)
    w.quote_residual["9:0:4:true"] = 999
    r = Reason(purpose=.raid,actor=22,counterparty=8,origin=0,destination=3)
    e = emit_event(w,.raid,-1,22,8,r,2000,false,vec3(-2100,500,2900))
    publish_events(w)
    # Direct testimony is the only thing that makes the reported lane known at HQ.
    n = w.people[8].news[0]
    assert(n.event == e and receive_place(w,0,n))
    authority_response(w)
    assert(w.patrol_departures == 1 and w.people[9].trip >= 0)
    assert(money_balances(w) and goods_balance(w))

use '../src/living_duties.jo'

test "crew outside credit is bounded and repayments leave the boundary once":
    w = build_world()
    assert(transfer(w,w.factions[3].account,w.factions[1].account,w.accounts[w.factions[3].account].cents,.trade))
    burn_fuel(w,6,15000)
    crew_recovery(w)
    assert(w.outside_creditor_account >= 0 and w.factions[3].last_credit_day == 0)
    id = w.obligation_keys["crew-credit-0"]
    assert(w.obligations[id].creditor_account == w.outside_creditor_account)
    before_in = w.ledger.external_in_cents
    crew_recovery(w)
    assert(w.ledger.external_in_cents == before_in)
    before_out = w.ledger.external_out_cents
    paid = pay_obligation(w,id,100)
    assert(paid == 100 and w.ledger.external_out_cents == before_out+100)
    assert(w.accounts[w.outside_creditor_account].cents == 0 and money_balances(w) and goods_balance(w))
