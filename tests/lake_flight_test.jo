use '../src/world.jo'
use '../src/world_source.jo'
use '../src/geography.jo'
use '../src/water_field.jo'
use '../src/lake_data.jo'
import '../src/flight.jo' as fl
import '../src/planes.jo' as planes
import '../src/pilot.jo' as pilot

test "inland lake supports takeoff with the canonical bed and shared water surface":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    lake=SETTLEMENT_LAKES[3]
    heading=atan2(f64(lake.axis.x),-f64(lake.axis.y))
    start=lake.center-lake.axis*540.0
    e=fl.FlightEnv(has_swell=true,swell_ceiling=lake.level,
        swell=(x:f64,z:f64)->vec3:vec3(f32(water_at(x,z).level),0,0),
        ground=(x:f64,z:f64)->f64:world_source_surface(x,z),
        current_at=(x:f64,z:f64)->vec3:water_current(x,z))
    loop kind in [planes.Craft.gull,planes.Craft.heron,planes.Craft.albatross,planes.Craft.cormorant,planes.Craft.pelican]:
        model=planes.build_craft(kind,planes.LIVERIES[0]);spec=fl.craft_spec(kind,model.contacts)
        s=fl.water_start(spec,vec3(start.x,f32(lake.level),start.y),heading)
        plan=fl.FlightPlan(takeoff_heading=heading,target=vec3(lake.center.x+lake.axis.x*5000.0,f32(lake.level),lake.center.y+lake.axis.y*5000.0),altitude=lake.level+180.0)
        airborne=false
        loop k in 0..2250:
            control=fl.autopilot(spec,s,plan,e);fl.step(spec,s,control,e,1.0/30.0)
            if not s.on_water and s.position.y>lake.level+spec.float_height+3.0:airborne=true;break
            if s.crashed or not water_at(f64(s.position.x),f64(s.position.z)).wet:break
        run=f64(length(s.position.xz-start))
        print("LAKE TAKEOFF {kind}: {run:.1} m, airborne={airborne}, damage={s.hull_damage}")
        assert(airborne and not s.crashed and s.hull_damage==0 and run<1080,"lake takeoff {kind}")
        flyer=pilot.Flyer(kind=kind,model=0,spec=spec,state=s)
        pilot.moor_at_dock(flyer,vec3(start.x,f32(lake.level),start.y))
        assert(flyer.state.moored and abs(f64(flyer.state.position.y)-lake.level-spec.float_height)<0.001)
