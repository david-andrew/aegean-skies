eat_counter_grain = (w: mut World, place: int, quantity: int):
    batch=far_take_market(w,place,3,quantity); far_use(w,batch)

test "a farmer without buying needs remains a supplier while consumer pantries are protected":
    w=far_fixture()
    assert([loop e in w.far.districts[200].customer_orders: if e.order.place==100: e].len()==0)
    assert(counter_sale_available(w,100,3)>0 and counter_sale_available(w,300,3)==0)
    eat_counter_grain(w,200,far_market_qty(w,200,3))
    assert(procurement_links(w,200,3)==[0])
    a=counter_restock_order(w,0,200); b=counter_restock_order(w,1,200)
    assert(a.quantity[3]>0 and b.quantity[3]==0 and a.supply_source==100 and a.supply_minute==0)
    assert(money_balances(w) and goods_balance(w) and validate_far(w)=="",validate_far(w))

test "remote stock depletion becomes known only when the service carries its new inventory report":
    w=far_fixture(); assert(far_provision(w,0))
    eat_counter_grain(w,200,far_market_qty(w,200,3))
    before=counter_restock_order(w,0,200)
    eat_counter_grain(w,100,far_market_qty(w,100,3))
    assert(counter_restock_order(w,0,200)==before and procurement_links(w,200,3)==[0])
    assert(far_depart(w,0))
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==200 and procurement_links(w,200,3)==[0,1])
    assert([loop q in w.far.districts[200].supplier_quotes: if q.place==100: q.available[3]][0]==0)
    assert(money_balances(w) and goods_balance(w) and validate_far(w)=="",validate_far(w))

test "a collected last-stock shipment establishes actual supplier throughput without inventing inventory":
    w=far_fixture(); assert(far_provision(w,0))
    eat_counter_grain(w,200,far_market_qty(w,200,3))
    order=counter_restock_order(w,0,200); w.far.vehicles[0].buying_order=order
    keep=counter_sale_reserve(w,100,3)+order.quantity[3]
    eat_counter_grain(w,100,max(0,far_market_qty(w,100,3)-keep))
    assert(far_depart(w,0)); journey=w.far.journeys[w.far.vehicles[0].journey]
    assert(journey.good==3 and journey.quantity==order.quantity[3])
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    q=[loop q in w.far.districts[200].supplier_quotes: if q.place==100: q][0]
    assert(q.available[3]==0 and q.delivered[3]==journey.quantity and q.delivered_minute[3]==w.minute)
    eat_counter_grain(w,200,1000)
    next=counter_restock_order(w,0,200)
    assert(next.supply_source==100 and next.supply_received and next.supply_minute==w.minute)
    assert(money_balances(w) and goods_balance(w) and validate_far(w)=="",validate_far(w))

test "competitive carried quotes split an exact budget by price stock and public journey time":
    w=build_world(u64(42)); contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    loop id in [100,200,300]: contexts.push(LifePlaceContext(id,"Counter {id}",1,id,vec3(f32(id),0,0)))
    assert(publish_place_contexts(w,1,contexts,[-1,200,-1]))
    seeds=[FarPlaceSeed(100,500,1,3),FarPlaceSeed(200,80,1,0),FarPlaceSeed(300,4000,1,3)]
    links=[FarLink(0,100,200,.cart,[vec3(100,0,0),vec3(200,0,0)],10000000),FarLink(1,200,300,.ship,[vec3(200,0,0),vec3(300,0,0)],60000000)]
    assert(populate_settlement_economy(w,1,seeds,links))
    assert(procurement_links(w,200,3)==[0,1])
    loop quantity in [1,2,17,1000,10000000]:
        a=procurement_share(w,200,3,quantity,0); b=procurement_share(w,200,3,quantity,1)
        assert(a+b==quantity and a>=0 and b>=0)
    assert(procurement_share(w,200,3,10000000,1)>procurement_share(w,200,3,10000000,0))
    text=canonical_text(w); copy=from_text[World](text)
    assert(copy is World and canonical_text(copy)==text and validate_far(w)=="",validate_far(w))
    w.far.districts[200].supplier_quotes[0].delivered[3]=1000
    assert(validate_far(w)=="invalid actual supplier delivery date")


test "a tiny collected shipment cannot monopolize a much larger real food request":
    w=far_fixture(12800)
    eat_counter_grain(w,200,far_market_qty(w,200,3))
    # The city's actual household food reserve is now empty.
    # It must seek the remainder through the other existing service, not declare that
    # its one small observed supplier can provide an unlimited city-sized order.
    quote=w.far.districts[200].supplier_quotes[0]
    known=quote.available[3]; assert(known>0)
    quantity=counter_own_target(w,200,3)
    assert(quantity>known*10)
    a=counter_restock_order(w,0,200).quantity[3]; b=counter_restock_order(w,1,200).quantity[3]
    assert(a==known and b==quantity-known and a+b==quantity)
    # Missing information is not missing goods: changing remote inventory cannot
    # alter this allocation until a physical report or collected shipment arrives.
    eat_counter_grain(w,100,far_market_qty(w,100,3))
    assert(procurement_share(w,200,3,quantity,0)==a)
    assert(goods_balance(w) and money_balances(w))

test "a collected carrier-sized small shipment is valid supplier evidence with a bounded new request":
    w=far_fixture(); assert(far_provision(w,0))
    eat_counter_grain(w,200,far_market_qty(w,200,3))
    w.far.vehicles[0].buying_order=counter_restock_order(w,0,200)
    keep=counter_sale_reserve(w,100,3)+500
    eat_counter_grain(w,100,far_market_qty(w,100,3)-keep)
    assert(far_depart(w,0)); j=w.far.journeys[w.far.vehicles[0].journey]
    assert(j.quantity==500)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    q=[loop q in w.far.districts[200].supplier_quotes: if q.place==100: q][0]
    assert(q.available[3]==0 and q.delivered[3]==500)
    assert(procurement_links(w,200,3)==[0])
    next=counter_restock_order(w,0,200)
    assert(next.quantity[3]==counter_purchase_own_target(w,200,3)-far_market_qty(w,200,3) and next.supply_received and next.supply_source==100)
    assert(q.delivered[3]==500 and q.available[3]==0) # Two-load buying terms are not new stock.
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))

test "a busy office sends carrier-sized essential inquiries and eventually explores every actual route":
    w=build_world(u64(42)); contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    contexts.push(LifePlaceContext(1000,"Office",1,1000,vec3(0,0,0)))
    seeds=[FarPlaceSeed(1000,80,1,0)]; links: FarLink[]
    loop i in 0..16:
        id=2000+i; pos=vec3(f32(i+1)*100,0,0)
        contexts.push(LifePlaceContext(id,"Neighbor {i}",1,id,pos))
        seeds.push(FarPlaceSeed(id,80,1,3))
        links.push(FarLink(i,1000,id,.cart,[vec3(0,0,0),pos],int((i+1)*100000)))
    assert(publish_place_contexts(w,1,contexts,[-1,1000,-1]))
    assert(populate_settlement_economy(w,1,seeds,links))
    # The workshop reserve was used for real maintenance; its 10kg replacement
    # must not become sixteen sub-lot orders which every carrier refuses.
    used=far_take_market(w,1000,5,far_market_qty(w,1000,5)); far_use(w,used)
    seen: {int: bool}
    loop day in 0..7:
        w.minute=day*1440; w.tick=w.minute*120
        total=0; accepted=0
        loop route in 0..16:
            order=counter_restock_order(w,route,1000); qty=order.quantity[5]
            assert(restock_order_valid(w,order))
            total+=qty
            if qty>0:
                assert(qty>=FAR_MIN_PURCHASE); accepted+=1; seen[route]=true
        assert(total==1000 and accepted==10)
    assert(seen.len()==16 and goods_balance(w) and money_balances(w))

supplier_visit = (w: mut World, vehicle: int):
    v=w.far.vehicles[vehicle]
    w.minute=max(w.minute,v.next_departure)
    if v.place==v.home: w.minute=max(w.minute,v.last_survey_minute+1440)
    w.tick=w.minute*120
    assert(far_depart(w,vehicle))
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[vehicle].journey<0)

parts_priority_fixture = (farm_grain: int = 200000) -> World:
    w=far_fixture(producer_population=4000)
    supplier_visit(w,1) # The existing carrier is physically at the parts works.
    # Fixture inventory allocation: actual farmer grain, with its original roots,
    # stocks the workshop pantry. No new output is created for the test's orders.
    assert(far_provision(w,0))
    pantry=far_take_market(w,100,3,1000); far_put_market(w,300,pantry)
    eat_counter_grain(w,100,far_market_qty(w,100,3)-farm_grain)
    repair=far_take_market(w,200,5,far_market_qty(w,200,5)); far_use(w,repair)
    supplier_visit(w,0) # The farm's actual new storage order reaches the relay.
    supplier_visit(w,1); supplier_visit(w,1) # Return, then carry the relay's new terms.
    w

test "forwarded reserve top-ups do not pretend that fed households are starving and preempt real maintenance":
    w=parts_priority_fixture()
    v=w.far.vehicles[1]; paper=v.buying_order!
    assert(v.place==300 and paper.place==200 and paper.observed[3]>5000)
    assert(paper.target[3]>paper.observed[3]*4 and paper.quantity[3]>1000 and paper.quantity[5]>=FAR_MIN_PURCHASE)
    assert(paper.quantity[5]*w.far.districts[300].prices[5]>counter_sale_available(w,300,3)*w.far.districts[300].prices[3])
    assert(far_market_qty(w,100,3)>100000) # The farm also has over a day's actual food.
    assert(order_urgent_food(paper,300,w.minute)==0)
    w.minute=max(w.minute,v.next_departure); w.tick=w.minute*120
    assert(far_depart(w,1))
    j=w.far.journeys[w.far.vehicles[1].journey]
    assert(j.good==5,"The full commercial grain target must not make this fed buyer reject maintenance parts: {j.good}")
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))

test "a production warehouse is filled by paid production rather than buying its own output back":
    w=far_fixture(producer_population=4000)
    reserve=counter_sale_reserve(w,100,3)
    eat_counter_grain(w,100,far_market_qty(w,100,3)-reserve)
    paper=counter_restock_order(w,0,100)
    assert(counter_own_target(w,100,3)>reserve)
    assert(paper.quantity[3]==0,"Fed productive farmers must not import grain to fill their output warehouse.")
    used=far_take_market(w,300,5,far_market_qty(w,300,5)-1000); far_use(w,used)
    parts=counter_restock_order(w,1,300)
    assert(parts.quantity[5]==0,"A parts works must not buy its finished output just to fill its production warehouse.")
    w.minute=1500; w.tick=w.minute*120
    far_supply_requests(w,100); far_supply_requests(w,300)
    assert([loop r in w.far.districts[100].reports: if r.kind=="supply_request" and r.supply_good==3: r].len()==0)
    assert([loop r in w.far.districts[300].reports: if r.kind=="supply_request" and r.supply_good==5: r].len()==0)
    produced=w.far.produced[5]; far_work_hour(w,300)
    assert(w.far.produced[5]>produced and far_market_qty(w,300,5)>1000)
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))


test "real downstream household urgency travels separately from commerce and expires with its own component":
    w=parts_priority_fixture(0); v=w.far.vehicles[1]; paper=v.buying_order!
    assert(paper.observed[3]>=paper.food_floor and paper.primary_food_urgent)
    assert(order_urgent_food(paper,300,w.minute)>0)
    assert([loop part in order_components(paper,3,w.minute): if part.urgent and 100 in part.places: part].len()>0)
    expired=order_due(paper,3)+1
    assert(order_urgent_food(paper,300,expired)==0)
    assert(order_quantity_for_supplier(paper,3,300,expired)>0) # Local nonurgent buffer survives.
    text=canonical_text(w); copy=from_text[World](text)
    assert(copy is World and canonical_text(copy)==text)
    w.minute=max(w.minute,v.next_departure); w.tick=w.minute*120
    assert(far_depart(w,1))
    j=w.far.journeys[w.far.vehicles[1].journey]
    assert(j.good==3 and j.quantity>0)
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))


test "a partial real delivery cannot cap the next city inquiry below the carrier it actually visited":
    w=far_fixture(12800); assert(far_provision(w,0))
    eat_counter_grain(w,200,far_market_qty(w,200,3))
    w.far.vehicles[0].buying_order=counter_restock_order(w,0,200)
    keep=counter_sale_reserve(w,100,3)+500
    eat_counter_grain(w,100,far_market_qty(w,100,3)-keep)
    assert(far_depart(w,0)); j=w.far.journeys[w.far.vehicles[0].journey]
    assert(j.quantity==500)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    next=counter_restock_order(w,0,200)
    payload=w.far.vehicles[0].capacity_grams*1000/w.goods[3].package_grams
    assert(next.quantity[3]>=payload*2,"The physical500kgcarrier was remembered as a perpetual10kg supplier")
    q=[loop q in w.far.districts[200].supplier_quotes: if q.link==0: q][0]
    assert(q.available[3]==0 and q.delivered[3]==500 and q.payload_grams==w.far.vehicles[0].capacity_grams)
    # A later remote refit cannot alter this historical local observation.
    w.far.vehicles[0].capacity_grams*=2
    assert(counter_restock_order(w,0,200).quantity[3]==next.quantity[3])
    w.far.vehicles[0].capacity_grams/=2
    assert(next.quantity[3]<next.target[3]-next.observed[3]) # Other routes still seek the residual.
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))
