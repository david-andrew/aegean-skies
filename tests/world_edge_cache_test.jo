use '../src/world_terrain.jo'

test "world edge memo reuses exact state and invalidates every edge input":
    saved_tiles=world_tiles;saved_selected=world_selected
    world_tiles=[WorldTile(x=0,z=0,level=0,lod=0),WorldTile(x=1,z=0,level=0,lod=0),WorldTile(x=0,z=1,level=1,lod=1)]
    world_selected=[0,1,2]
    world_edge_stamps=[];world_edge_neighbors=[]
    world_prepare_edge_states()
    count=world_edge_rebuilds
    loop frame in 0..120:world_prepare_edge_states()
    assert(world_edge_rebuilds==count)
    world_tiles[1].lod=0.5
    world_prepare_edge_states()
    assert(world_edge_rebuilds==count)
    loop i in 0..world_selected.len():assert(world_cached_edge_state(i)==world_edge_state(world_selected[i]))
    loop change in 0..4:
        match change:
            0:world_tiles[1].x=3
            1:world_tiles[1].z=1
            2:world_tiles[1].level=1;world_tiles[1].key=99
            _:world_selected=[2,0]
        world_prepare_edge_states()
        assert(world_edge_rebuilds==count+change+1)
        loop i in 0..world_selected.len():
            assert(world_cached_edge_state(i)==world_edge_state(world_selected[i]))
    world_selected=[0,2];world_prepare_edge_states()
    loop i in 0..world_selected.len():assert(world_cached_edge_state(i)==world_edge_state(world_selected[i]))
    world_tiles=saved_tiles;world_selected=saved_selected
    world_edge_stamps=[];world_edge_neighbors=[]

test "world balance memo matches full balancing through ancestor arrival and slot reuse":
    saved_tiles=world_tiles;saved_selected=world_selected;saved_cache=world_cache
    world_tiles=[WorldTile(key=world_tile_key(3,0,0),x=3,z=0,level=0),WorldTile(key=world_tile_key(1,0,2),x=1,z=0,level=2),WorldTile(key=world_tile_key(1,0,1),x=1,z=0,level=1)]
    world_cache={world_tiles[0].key:0,world_tiles[1].key:1}
    world_balance_input=[];world_balance_output=[];world_balance_registry={}
    source=[0,1]
    loop change in 0..5:
        match change:
            0:pass
            1:world_cache[world_tiles[2].key]=2
            2:world_tiles[2].x=2 # a replaced result slot with the same input selection
            3:world_tiles[2].x=1;source=[1,0]
            _:world_cache.remove(world_tiles[2].key)
        world_selected=source;world_balance();expected=world_selected
        world_selected=source;world_balance_cached()
        assert(world_selected==expected)
        count=world_balance_rebuilds
        loop frame in 0..120:
            world_tiles[0].lod=f64(frame)/120
            world_selected=source;world_balance_cached()
            assert(world_selected==expected)
        assert(world_balance_rebuilds==count)
    world_tiles=saved_tiles;world_selected=saved_selected;world_cache=saved_cache
    world_balance_input=[];world_balance_output=[];world_balance_registry={}
