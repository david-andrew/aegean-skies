use '../src/sea.jo'
use '../src/world_point.jo'
use '../src/flight.jo'
use '../src/targets.jo'
use '../src/weather_scene.jo'
use '../src/pilot.jo'

camera_fixture=(height:f64)->Flyer:
    k=craft_spec(.gull,[]);s=CraftState(position=vec3(0,height,0))
    Flyer(.gull,0,k,s,cam_pos=vec3(0,height+8,30),fov=62)

test "target chase carries its frame over both poles without snapping or losing the craft":
    f=camera_fixture(500)
    previous=target_chase_camera(f,vec3(0,0,-1),1.0)
    max_step=0.0;min_up=1.0
    loop i in 1..1441:
        angle=f64(i)*TAU/720.0
        tracking=vec3(0,sin(angle),-cos(angle))
        frame=target_chase_camera(f,tracking,1.0)
        delta=f64(length(world_delta(frame.eye,previous.eye)))
        max_step=max(max_step,delta);min_up=min(min_up,f64(dot(frame.up,previous.up)))
        assert(delta<1.0 and dot(frame.up,previous.up)>0.999)
        assert(abs(dot(frame.view,frame.up))<0.00001 and abs(length(frame.up)-1)<0.00001)
        relative=world_delta(craft_point(f.state),frame.eye)
        depth=dot(relative,frame.view)
        assert(depth>8 and abs(dot(relative,frame.up)/depth)<0.3)
        side=normalize(cross(frame.view,frame.up))
        loop corner in [vec3(-5.5,0,0),vec3(5.5,0,0),vec3(0,0,-4.5),vec3(0,0,4.5),vec3(0,2.0,0)]:
            p=relative+corner;z=dot(p,frame.view)
            assert(z>0 and abs(dot(p,side)/z)<0.95 and abs(dot(p,frame.up)/z)<0.56)
        previous=frame
    print("TARGET poles max eye step {max_step:.4}m min consecutive up dot {min_up:.6}")

test "acquiring an aft target or releasing it never cuts through the aircraft":
    f=camera_fixture(500);v=TargetView(items=[ViewTarget(0,1,"aft",vec3(0,500,300),0,0)],selected=0,looking=true)
    previous=target_chase_camera(f,vec3(0,0,-1),0)
    loop i in 0..360:
        if i==180:v.looking=false
        step_target_view(v,vec3(0,500,0),f.look,1.0/60.0)
        frame=target_chase_camera(f,v.bearing,v.weight)
        assert(length(world_delta(frame.eye,craft_point(f.state)))>25)
        assert(length(world_delta(frame.eye,previous.eye))<8)
        assert(dot(frame.up,previous.up)>0.98)
        previous=frame

test "near sea target chase stays above waves and frames the player for targets above and below":
    f=camera_fixture(2.5)
    loop i in 0..1440:
        angle=f64(i)*TAU/720.0
        frame=target_chase_camera(f,vec3(0,sin(angle),-cos(angle)),1)
        assert(frame.eye.y>=f64(swell_at(frame.eye.x,frame.eye.z,f.sea_t).x)+1.19)
        relative=world_delta(craft_point(f.state),frame.eye)
        depth=dot(relative,frame.view)
        assert(depth>8 and abs(dot(relative,frame.up)/depth)<0.3)
        side=normalize(cross(frame.view,frame.up))
        loop corner in [vec3(-5.5,0,0),vec3(5.5,0,0),vec3(0,0,-4.5),vec3(0,0,4.5),vec3(0,2.0,0)]:
            p=relative+corner;z=dot(p,frame.view)
            assert(z>0 and abs(dot(p,side)/z)<0.95 and abs(dot(p,frame.up)/z)<0.56)
        assert(is_finite(frame.up.x) and abs(dot(frame.view,frame.up))<0.00001)

test "normal chase is unchanged and target camera retains far chart precision":
    f=camera_fixture(500)
    normal=target_chase_camera(f,vec3(0,1,0),0)
    assert(normal.eye==world_point(f.cam_pos) and normal.view==f.look and normal.up==f.cam_up)
    a=target_chase_camera(f,normalize(vec3(1,1,1)),1)
    offset=vec3(220000,0,-190000)
    g=camera_fixture(500);g.state.precise=world_offset(world_point(g.state.position),offset)
    g.state.precise_ready=true;g.state.position=world_vec(g.state.precise);g.state.published=g.state.position
    g.cam_point=world_offset(world_point(g.cam_pos),offset);g.cam_ready=true
    b=target_chase_camera(g,normalize(vec3(1,1,1)),1)
    assert(length(world_delta(b.eye,world_offset(a.eye,offset)))<0.0001)
