use '../src/eclipse.jo'
use '../src/eclipse_table.jo'
use '../src/night_sky.jo'
use '../src/look.jo'
use '../src/celestial.jo'
use '../src/day_air.jo'
use '../src/eclipse_talk.jo'

# Eclipses (src/eclipse.jo): the real ones from the table on their dates, the share of the Sun
# covered by place and time, totality only on the umbra's track, the light they give, the lunar
# ones, every phase reachable by forcing, and none on the title screen or in a new world's first days.

_row_named = (date: str) -> int:
    loop i in 0..ECLIPSE_ROWS.len():
        if starts_with(ECLIPSE_ROWS[i].label, date): return i
    -1

test "The table holds the real eclipses: 19 June 1936 total over the map, 29 June 1927 partial":
    total = _row_named("19 Jun 1936")
    assert(total >= 0 and ECLIPSE_ROWS[total].solar and ECLIPSE_ROWS[total].k > 1.0)
    # (minute 0 is 7 June 1926 at 09:30: the 1936 eclipse falls on world day 3665, near sunrise)
    day = floor((ECLIPSE_ROWS[total].minute + 570.0) / 1440.0)
    assert(day == 3665.0, "{day}")
    partial = _row_named("29 Jun 1927")
    assert(partial >= 0 and ECLIPSE_ROWS[partial].solar)
    lunar = _row_named("08 Dec 1927")
    assert(lunar >= 0 and not ECLIPSE_ROWS[lunar].solar)
    # (in order, never two at once)
    loop i in 1..ECLIPSE_ROWS.len():
        assert(ECLIPSE_ROWS[i].minute - ECLIPSE_ROWS[i].span > ECLIPSE_ROWS[i-1].minute + ECLIPSE_ROWS[i-1].span)

test "1936: totality on a track across the map, a deep partial beside it, the umbra moving":
    r = ECLIPSE_ROWS[_row_named("19 Jun 1936")]
    sun = normalize(vec3(0.95, 0.07, -0.3))
    best = eclipse_row_best(r)
    # (its best view is total; 150 km aside from the track it is only partial)
    e = eclipse_at(r.minute + f64(best.z) * 60.0, f64(best.x), f64(best.y), sun)
    assert(e.on and e.solar and e.covered > 0.999 and e.sliver <= 0.0, "{e.covered} {e.sliver}")
    tracked = 0; partial = 0
    loop i in 0..11:
        loop j in 0..9:
            x = -250.0 + 50.0 * f64(i); z = -200.0 + 50.0 * f64(j)
            g = eclipse_row_greatest(r, x, z)
            ee = eclipse_at(r.minute + g * 60.0, x, z, sun)
            if ee.covered > 0.999: tracked += 1
            else: if ee.covered > 0.8: partial += 1
    assert(tracked > 5 and tracked < 60 and partial > 20, "{tracked} {partial}")

test "The share covered rises to totality and falls; the stretch slows only the middle":
    eclipse_force_phase("first", 1000000.0, 0.0, 0.0)
    sun = normalize(vec3(0.2, 0.8, 0.5))
    last = -1.0; peak = 0.0; peaked = false
    loop i in 0..400:
        m = 1000000.0 + f64(i) * 0.5
        e = eclipse_at(m, 0.0, 0.0, sun)
        if not peaked:
            if f64(e.covered) < last - 0.0001: peaked = true
        peak = max(peak, f64(e.covered))
        last = f64(e.covered)
    assert(peak > 0.999 and peaked)
    # (totality lasts minutes of the world's clock, stretched ECLIPSE_STRETCH times)
    eclipse_force_phase("total", 2000000.0, 0.0, 0.0)
    span = 0.0
    loop i in -400..400:
        m = 2000000.0 + f64(i) * 0.1
        if eclipse_at(m, 0.0, 0.0, sun).sliver <= 0.0: span += 0.1
    assert(span > 2.0 * ECLIPSE_STRETCH and span < 6.0 * ECLIPSE_STRETCH, "{span}")
    assert(abs(eclipse_unstretch(eclipse_stretch_of(37.0)) - 37.0) < 0.001)
    eclipse_force_off()

test "Every phase can be forced, at the eye, and gives what it says":
    sun = normalize(vec3(0.3, 0.6, 0.7))
    loop phase in ECLIPSE_PHASES:
        eclipse_force_phase(phase, 5000000.0, 12.0, -30.0)
        e = eclipse_at(5000000.0, 12.0, -30.0, sun)
        assert(e.on, phase)
        match phase:
            "first": assert(e.covered > 0.0 and e.covered < 0.01, phase)
            "partial": assert(abs(f64(e.covered) - 0.5) < 0.02, phase)
            "deep": assert(abs(f64(e.covered) - 0.9) < 0.02, phase)
            "beads": assert(eclipse_beads(e) > 0.3 and eclipse_totality(e) < 0.9, phase)
            "ring": assert(eclipse_ring(e) > 0.3, phase)
            "total": assert(eclipse_totality(e) == 1.0 and e.covered >= 0.9999, phase)
            "annular": assert(e.k < 1.0 and e.covered > 0.85 and eclipse_totality(e) == 0.0, phase)
            "lunar-total": assert(not e.solar and e.covered > 0.999, phase)
            "lunar-penumbral": assert(not e.solar and e.covered == 0.0, phase)
            "lunar-partial": assert(not e.solar and e.covered > 0.1 and e.covered < 0.9, phase)
            _: assert(true)
        # (the debug page can always be put back)
    eclipse_force_off()
    assert(not eclipse_at(5000000.0, 12.0, -30.0, sun, false).on)

test "The umbra is where the shadow pass draws it: the place terms agree with the model":
    sun = normalize(vec3(0.4, 0.5, -0.6))
    eclipse_force_phase("total", 3000000.0, 40.0, 20.0)
    eclipse_eye_set(40.0, 20.0)
    loop dt in [-20.0, -3.0, 0.0, 2.0]:
        e = eclipse_at(3000000.0 + dt, 40.0, 20.0, sun)
        (o, q1, q2) = eclipse_place_terms(e, 3000000.0 + dt, sun)
        loop p in [vec2(40, 20), vec2(-60, 80), vec2(140, -100)]:
            here = eclipse_at(3000000.0 + dt, f64(p.x), f64(p.y), sun, true, 40.0, 20.0, false)
            wx = p.x / 100.0; wz = p.y / 100.0
            off = vec2(o.x, o.y) + vec2(o.z, o.w) * wx + vec2(q1.x, q1.y) * wz + vec2(q1.z, q1.w) * wx * wx + vec2(q2.x, q2.y) * wz * wz + vec2(q2.z, q2.w) * wx * wz
            assert(length(off - here.offset) < 0.002, "{dt} {p} {off} {here.offset}")
    # (a real row replayed here: its own terms, moved)
    r = _row_named("19 Jun 1936")
    eclipse_force_row(r, 0.0, 3000000.0, 40.0, 20.0)
    e = eclipse_at(3000000.0, 40.0, 20.0, sun)
    assert(e.covered > 0.999, "{e.covered}")
    (o, q1, q2) = eclipse_place_terms(e, 3000000.0, sun)
    loop p in [vec2(40, 20), vec2(-100, 100), vec2(200, -150)]:
        here = eclipse_at(3000000.0, f64(p.x), f64(p.y), sun, true, 40.0, 20.0, false)
        wx = p.x / 100.0; wz = p.y / 100.0
        off = vec2(o.x, o.y) + vec2(o.z, o.w) * wx + vec2(q1.x, q1.y) * wz + vec2(q1.z, q1.w) * wx * wx + vec2(q2.x, q2.y) * wz * wz + vec2(q2.z, q2.w) * wx * wz
        assert(length(off - here.offset) < 0.003, "{p} {off} {here.offset}")
    eclipse_force_off()

test "The light: dimming and cooling, totality's sky, the stars out by day":
    L = light_at(10.0, 100.0)
    eclipse_force_phase("deep", 4000000.0, 0.0, 0.0)
    deep = eclipse_light(L, eclipse_at(4000000.0, 0.0, 0.0, L.sun_dir))
    eclipse_force_phase("total", 4000000.0, 0.0, 0.0)
    tot = eclipse_light(L, eclipse_at(4000000.0, 0.0, 0.0, L.sun_dir))
    eclipse_force_off()
    assert(length(deep.sun) < length(L.sun) * 0.8 and length(tot.sun) < length(L.sun) * 0.1)
    assert(deep.sun.z / deep.sun.x > L.sun.z / L.sun.x)
    assert(length(tot.sky_top) < 0.25 and tot.afterglow.x > 0.8 and tot.eclipse_look.x == 1.0)
    day = night_air(L); dark = night_air(tot)
    assert(day.limit < -5.5 and dark.limit > 1.0, "{day.limit} {dark.limit}")
    # (the Moon on the Sun)
    assert(dot(normalize(tot.moon_dir), normalize(tot.sun_dir)) > 0.99999)

test "A lunar eclipse: the Moon on the shadow, dimmed, the stars out about it":
    L = light_at(23.0, 100.0)
    eclipse_force_phase("lunar-total", 6000000.0, 0.0, 0.0)
    e = eclipse_at(6000000.0, 0.0, 0.0, L.sun_dir)
    T = eclipse_light(L, e)
    eclipse_force_off()
    assert(T.lunar_eclipse and dot(normalize(T.moon_dir), -normalize(T.sun_dir)) > 0.9999)
    assert(eclipse_moon_light(T) < 0.1)
    a = night_air(T)
    assert(a.moonlight < 0.1 and a.moon_left < 0.1)

test "No eclipse on the title screen or in a new world's first days unless forced":
    r = ECLIPSE_ROWS[_row_named("19 Jun 1936")]
    assert(not eclipse_allowed(r.minute, true))
    assert(eclipse_allowed(r.minute, false))
    assert(not eclipse_allowed(3.0 * 1440.0, false))
    # (the first real one comes after the first five days)
    assert(ECLIPSE_ROWS[0].minute - ECLIPSE_ROWS[0].span > f64(EARLY_WORLD_DAYS) * 1440.0)
    sun = normalize(vec3(0.95, 0.07, -0.3))
    best = eclipse_row_best(r)
    assert(not eclipse_at(r.minute + f64(best.z) * 60.0, f64(best.x), f64(best.y), sun, false).on)
    eclipse_force_phase("total", 100.0, 0.0, 0.0)
    assert(eclipse_at(100.0, 0.0, 0.0, sun, false).on)
    eclipse_force_off()
    assert(eclipse_next_row(0.0) == 0)

test "Talk of an eclipse in the days about it, only for the ones worth remarking":
    r = ECLIPSE_ROWS[_row_named("19 Jun 1936")]
    m = int(r.minute)
    before = eclipse_talk_lines(m - 2 * 1440)
    after = eclipse_talk_lines(m + 1440)
    assert(before.len() > 0 and after.len() > 0)
    assert("go out" in before[0] or "go out" in before[1], "{before}")
    assert(eclipse_talk_lines(m + 9 * 1440).len() == 0)
    # (a slight partial: nothing said)
    slight = ECLIPSE_ROWS[_row_named("01 Nov 1929")]
    assert(eclipse_talk_lines(int(slight.minute)).len() == 0)
