# People's words arriving as they are spoken (src/speech_stream.jo), a conversation's bubbles over
# both speakers (src/talk_bubbles.jo, src/panels.jo's bubbles_apart) and the player's Text speed
# (src/options.jo). The game itself, played through a conversation: tests/talk_bubbles_test.py.
use '../src/speech_stream.jo'
use '../src/talk_bubbles.jo'
use '../src/life_types.jo'
use '../src/options.jo'
use '../src/panels.jo'

let STEP = 1.0 / 60.0

# (seconds a line takes, stepped a frame at a time)
_run = (text: str, rate: f64, speed: TextSpeed = TextSpeed.normal) -> f64:
    s = spoken_begin(text)
    n = 0
    loop not s.done and n < 100000:
        spoken_step(s, STEP, rate, speed)
        n += 1
    f64(n) * STEP

test "a line arrives at the speaker's pace, between 35 and 50 characters a second":
    plain = "The boats went out before the light and came back heavy"      # (no pauses in it)
    n = f64(char_count(plain))
    assert(abs(_run(plain, 42.0) - n / 42.0) < 0.05)
    assert(abs(spoken_seconds(plain, 42.0) - n / 42.0) < 1.0e-9)
    loop v in [VoiceKind.salt, VoiceKind.shop, VoiceKind.formal, VoiceKind.anxious, VoiceKind.warm, VoiceKind.measured, VoiceKind.wry, VoiceKind.guarded, VoiceKind.plain, VoiceKind.devout, VoiceKind.brisk, VoiceKind.chatty, VoiceKind.eager, VoiceKind.elder]:
        loop age in [9, 20, 35, 50, 66, 90]:
            r = spoken_rate(v, age)
            assert(r >= 35.0 and r <= 50.0, "{v} at {age}: {r}")
    # (a slow old fisherman types slower than a brisk nurse or a formal clerk)
    assert(spoken_rate(.salt, 72) < spoken_rate(.formal, 40) and spoken_rate(.formal, 40) < spoken_rate(.brisk, 30))
    assert(spoken_rate(.elder, 80) <= spoken_rate(.elder, 66) and spoken_rate(.plain, 70) < spoken_rate(.plain, 40))
    assert(_run(plain, spoken_rate(.salt, 72)) > _run(plain, spoken_rate(.brisk, 30)) + 0.2)
    # (the characters come one after another, none skipped and none twice)
    s = spoken_begin(plain)
    last = 0
    loop not s.done:
        spoken_step(s, STEP, 42.0)
        assert(s.shown >= last and s.shown - last <= 1)
        last = s.shown
    assert(s.shown == char_count(plain))

test "a comma is a breath and a full stop a longer one, but not inside a figure or at the end":
    assert(spoken_pause(chars("Well, yes"), 4) == SPOKEN_COMMA)
    assert(spoken_pause(chars("No. Not today"), 2) == SPOKEN_STOP)
    assert(spoken_pause(chars("Is it? It is"), 5) == SPOKEN_STOP)
    assert(spoken_pause(chars("Wait; listen"), 4) == SPOKEN_CLAUSE)
    assert(SPOKEN_COMMA < SPOKEN_CLAUSE and SPOKEN_CLAUSE < SPOKEN_STOP)
    # (the last character, a figure's point or comma, and all but the last of a run of marks)
    assert(spoken_pause(chars("Good day."), 8) == 0.0)
    assert(spoken_pause(chars("12.50 the load"), 2) == 0.0 and spoken_pause(chars("1,200 of them"), 1) == 0.0)
    assert(spoken_pause(chars("Well... no"), 4) == 0.0 and spoken_pause(chars("Well... no"), 5) == 0.0 and spoken_pause(chars("Well... no"), 6) == SPOKEN_STOP)
    assert(spoken_pause(chars("abc"), -1) == 0.0 and spoken_pause(chars("abc"), 7) == 0.0)
    # (a line with two commas and a stop takes that much longer than its letters)
    line = "Well, the wind is fair, they say. Go on"
    n = f64(char_count(line))
    want = n / 42.0 + 2.0 * SPOKEN_COMMA + SPOKEN_STOP
    assert(abs(spoken_seconds(line, 42.0) - want) < 1.0e-9)
    assert(abs(_run(line, 42.0) - want) < 0.06, "{_run(line, 42.0)} against {want}")
    # (while it pauses nothing more arrives: just past the comma, a frame adds nothing)
    s = spoken_begin(line)
    loop s.shown < 5: spoken_step(s, STEP, 42.0)
    assert(s.shown == 5 and s.wait > 0.0)
    spoken_step(s, STEP, 42.0)
    assert(s.shown == 5)
    # (a slow voice's pauses are longer too)
    assert(spoken_seconds(line, 36.0) - n / 36.0 > spoken_seconds(line, 48.0) - n / 48.0)

test "the text speed: slow, normal and fast in order, and instant all at once":
    line = "There's music at the Ancora tonight, if you've a mind to hear it."
    slow = _run(line, 42.0, .slow); normal = _run(line, 42.0, .normal); fast = _run(line, 42.0, .fast)
    assert(slow > normal * 1.3 and normal > fast * 1.5, "{slow} {normal} {fast}")
    s = spoken_begin(line)
    spoken_step(s, STEP, 42.0, .instant)
    assert(s.done and s.shown == char_count(line))
    assert(spoken_seconds(line, 42.0, .instant) == 0.0)
    assert(TEXT_SPEEDS.len() == 4 and TEXT_SPEED_LABELS == ["Slow", "Normal", "Fast", "Instant"])
    # (an empty line is whole from the first)
    assert(spoken_begin("").done)

test "wrapped lines show the characters arrived, the break between two lines counted":
    lines = ["I'm Marta; I keep", "a store here."]
    assert(spoken_line_counts(lines, -1) == [-1, -1])
    assert(spoken_line_counts(lines, 0) == [0, 0])
    assert(spoken_line_counts(lines, 5) == [5, 0])
    assert(spoken_line_counts(lines, 17) == [17, 0] and spoken_line_counts(lines, 18) == [17, 0])
    assert(spoken_line_counts(lines, 20) == [17, 2])
    assert(spoken_line_counts(lines, 500) == [17, 13])

test "the answers wait for the line, a press finishes it, and that press is not an answer":
    line = "I'm Marta; I keep a store here. What brings you to Porto Vecchio?"
    e = SpokenEntry(SpokenLine())
    f = 100
    said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, false)
    assert(not said.done and not said.ready and said_fade(said) == 0.0)
    # (the press that opened the panel, still down in its first frames, does not hurry it)
    f += 1
    said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, true)
    assert(not said.done and said.shown <= 2)
    # (asked twice in a frame, it is stepped once)
    again = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, false)
    assert(again.shown == said.shown)
    # (it arrives a little each frame, the answers kept back all the while)
    loop k in 0..20:
        f += 1
        said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, false)
        assert(not said.done and not said.ready)
    assert(said.shown > 5 and said.shown < char_count(line))
    # (Space, Enter, A or a tap on the panel: whole at once; the answers show, but are not taken
    # by that same press)
    f += 1
    said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, true)
    assert(said.done and said.shown == -1 and not said.ready)
    f += 1
    said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, false)
    assert(said.done and said.ready and said_fade(said) > 0.0 and said_fade(said) < 1.0)
    loop k in 0..15:
        f += 1
        said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, false)
    assert(said_fade(said) == 1.0)
    # (left alone it finishes in its own time, and the answers come the frame after)
    e = SpokenEntry(SpokenLine())
    frames = 0
    loop frames < 1000:
        f += 1; frames += 1
        said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, false)
        if said.done: break
    assert(said.done and not said.ready)
    assert(abs(f64(frames) * STEP - spoken_seconds(line, 42.0)) < 0.08)
    f += 1
    assert(spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .normal, false).ready)
    # (a new line under the same key starts afresh; the same line after the panel was away too)
    f += 1
    said = spoken_entry_step(e, "Fair winds.", f, STEP, 42.0, 0.0, .normal, false)
    assert(not said.done and said.shown <= 1)
    loop k in 0..200:
        f += 1
        said = spoken_entry_step(e, "Fair winds.", f, STEP, 42.0, 0.0, .normal, false)
    assert(said.ready)
    f += 60
    assert(not spoken_entry_step(e, "Fair winds.", f, STEP, 42.0, 0.0, .normal, false).done)
    # (the pilot's own words first: nothing of the answer for the lead's length)
    e = SpokenEntry(SpokenLine())
    loop k in 0..int(TALK_ANSWER_LEAD / STEP) - 1:
        f += 1
        said = spoken_entry_step(e, line, f, STEP, 42.0, TALK_ANSWER_LEAD, .normal, false)
        assert(said.shown == 0 and not said.done)
    loop k in 0..12:
        f += 1
        said = spoken_entry_step(e, line, f, STEP, 42.0, TALK_ANSWER_LEAD, .normal, false)
    assert(said.shown > 0)
    # (Instant, and words that are read and not said: whole and answerable from the first frame)
    e = SpokenEntry(SpokenLine())
    f += 10
    said = spoken_entry_step(e, line, f, STEP, 42.0, 0.0, .instant, false)
    assert(said.done and said.ready and said.shown == -1 and said_fade(said) == 1.0)
    e = SpokenEntry(SpokenLine())
    said = spoken_entry_step(e, line, f, STEP, 0.0, 0.0, .normal, false)
    assert(said.done and said.ready)

test "a conversation's line is over the person and the pilot's words over him, and both go at goodbye":
    b = TalkBubbles()
    assert(not talk_person_speaks(b, 0.0) and not talk_pilot_speaks(b, 0.0))
    # (the conversation opens: their greeting, still arriving)
    talk_bubbles_step(b, true, 7, "Good day to you.", false, 10.0)
    assert(b.person == 7 and talk_person_speaks(b, 10.0) and not talk_pilot_speaks(b, 10.0))
    talk_bubbles_step(b, true, 7, "Good day to you.", true, 10.6)
    assert(talk_person_speaks(b, 10.6) and talk_person_speaks(b, 10.6 + TALK_LINE_SECONDS - 0.1))
    # (a line stays as an overheard remark does once it is whole, then goes)
    assert(not talk_person_speaks(b, 10.6 + TALK_LINE_SECONDS + 0.1))
    # (the pilot picks a subject: his words over his head, a moment before the answer begins)
    talk_bubbles_pilot(b, pilot_asks(.weather), 12.0)
    assert(talk_pilot_speaks(b, 12.0) and b.pilot == "How's the weather looking?")
    assert(talk_answer_lead(b, 12.0) == TALK_ANSWER_LEAD and talk_answer_lead(b, 12.0 + TALK_ANSWER_LEAD + 0.1) == 0.0)
    talk_bubbles_step(b, true, 7, "The meltemi will blow by noon.", false, 12.02)
    assert(talk_person_speaks(b, 12.02) and talk_pilot_speaks(b, 12.02))
    # (both up together while the answer arrives: two people talking)
    talk_bubbles_step(b, true, 7, "The meltemi will blow by noon.", true, 13.0)
    assert(talk_person_speaks(b, 14.0) and talk_pilot_speaks(b, 14.0))
    assert(not talk_pilot_speaks(b, 12.0 + TALK_PILOT_SECONDS + 0.1))
    # (goodbye: the panel shuts and both bubbles go with it, at once)
    talk_bubbles_pilot(b, pilot_says("Goodbye."), 15.0)
    assert(talk_pilot_speaks(b, 15.0))
    talk_bubbles_step(b, false, -1, "", true, 15.02)
    assert(b == TalkBubbles() and not talk_person_speaks(b, 15.02) and not talk_pilot_speaks(b, 15.02))
    # (talking to someone else straight after: nothing left over from the last)
    talk_bubbles_step(b, true, 7, "Good day to you.", true, 20.0)
    talk_bubbles_pilot(b, "Any work going?", 20.5)
    talk_bubbles_step(b, true, 9, "Morning.", false, 20.52)
    assert(b.person == 9 and b.pilot == "" and not talk_pilot_speaks(b, 20.52) and talk_person_speaks(b, 20.52))

test "what the pilot says: a question for each subject, an answer without its quotation marks":
    seen: str[]
    loop topic in [TalkTopic.greeting, TalkTopic.work, TalkTopic.news, TalkTopic.weather, TalkTopic.market, TalkTopic.home, TalkTopic.people, TalkTopic.troubles, TalkTopic.music, TalkTopic.farewell]:
        q = pilot_asks(topic)
        assert(q != "" and char_count(q) <= 32 and not (q in seen), q)
        assert(not q.lower().contains("quay"))
        seen.push(q)
    assert(pilot_says("\"I slept well, thank you.\"") == "I slept well, thank you.")
    assert(pilot_says("Any work going?") == "Any work going?" and pilot_says("Goodbye.") == "Goodbye.")
    long = pilot_says("I've brought the crate of medicine from Marta Bellini. It was a rough crossing and the engine ran hot all the way.")
    assert(long == "I've brought the crate of medicine from Marta Bellini.")

_box = (x: f64, y: f64, w: f64, h: f64, head: f64) -> BubbleBox: BubbleBox(x, y, w, h, vec2(f32(head), f32(y + h + 12.0)))
_overlap = (a: BubbleBox, b: BubbleBox) -> bool: a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h

test "two speakers' bubbles keep off each other: apart sideways, or one over the other on a narrow screen":
    # (heads a little apart on a wide screen: each slides toward its own speaker's side)
    a = _box(500, 200, 280, 80, 640)
    b = _box(420, 210, 240, 60, 540)
    bubbles_apart(a, b, 1280.0)
    assert(not _overlap(a, b) and b.x + b.w <= a.x and a.tail and b.tail)
    assert(a.x >= 8.0 and b.x >= 8.0 and a.x + a.w <= 1272.0)
    # (already apart: left alone)
    c = _box(100, 200, 200, 80, 200); d = _box(700, 200, 200, 80, 800)
    bubbles_apart(c, d, 1280.0)
    assert(c.x == 100.0 and d.x == 700.0)
    # (against the screen's edge the other gives all the way)
    e = _box(8, 200, 280, 80, 60); g = _box(60, 190, 280, 80, 200)
    bubbles_apart(e, g, 1280.0)
    assert(not _overlap(e, g) and e.x == 8.0 and g.x >= e.x + e.w)
    # (a phone held upright has no room for two side by side: the pilot's goes over the answer)
    h = _box(40, 300, 300, 90, 200); k = _box(60, 310, 280, 60, 230)
    bubbles_apart(h, k, 400.0)
    assert(not _overlap(h, k) and k.y + k.h <= h.y and not k.tail and h.tail)

test "the text speed is kept with the options, and normal for a new player and an older file":
    assert(Options().text_speed == TextSpeed.normal)
    loop v in TEXT_SPEEDS:
        back = from_text[Options](to_text(Options(text_speed = v)))
        assert(back is Options)
        if back is Options: assert(back.text_speed == v and back == Options(text_speed = v))
    # (saved and read back as the game does)
    _ = save_value("talk-bubbles-test-options", Options(text_speed = TextSpeed.fast, invert_y = true))
    kept = load_value("talk-bubbles-test-options", Options())
    assert(kept.text_speed == TextSpeed.fast and kept.invert_y)
    # (a file from before the setting: everything else as it was, the speed normal)
    text = to_text(Options(text_speed = TextSpeed.slow, invert_y = true, small_talk = false))
    assert(text.contains(", text_speed=slow"), text)
    old = text.replace(", text_speed=slow", "")
    back = from_text[Options](old)
    assert(not (back is TextError), if back is TextError: back.message else: "")
    if back is Options: assert(back.text_speed == TextSpeed.normal and back.invert_y and not back.small_talk)
