# CI regression gate: verify zero misplaced plants across every town in Aegean Skies
# (dock/quay paths, cliff stairs, streets, squares, buildings, doorways, and moorings),
# while ensuring legitimate town greenery, gardens, promenades, and hillsides stay lush.
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/objects.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/settlement_access.jo'
use '../src/town_plants_audit.jo'
use '../src/town_exclusions.jo'
use '../src/canal_geometry.jo'
use '../src/canal_city.jo'
use '../src/river_banks.jo'
use '../src/lake_banks.jo'
use '../src/world_groves.jo'
use '../src/grass.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
init_legacy_covers(embed('../assets/terrain_lod.bin'))
geography_enabled = true
init_settlements()
packed = inflate(embed('../assets/living-routes.bin')); assert(packed != none)
catalog = from_text[FarRouteCatalog](str_from_bytes(packed!)); assert(catalog is FarRouteCatalog)
publish_access_roads(catalog.links)
towns = [loop st in SETTLEMENTS: build_town(st)]

test "every town has zero misplaced plants on dock paths, streets, buildings, doors, and moorings":
    bad = 0
    bad_towns = 0
    loop s in world_settlements:
        findings = audit_town_plants(towns, s, true)
        if findings.len() > 0:
            bad_towns += 1
            bad += findings.len()
            if bad_towns <= 10:
                print("FAIL {s.name} (id={s.id}): {findings.len()} findings; first: [{findings[0].zone}] {findings[0].kind} at {findings[0].at}: {findings[0].detail}")
    assert(bad == 0, "found {bad} misplaced plants across {bad_towns} towns")

test "legitimate greenery stays lush in town gardens, promenades, river/lake banks, and surrounding hillsides":
    # Legacy islands keep their groves outside town footprints
    legacy_trees = 0
    loop k in 0..ISLANDS.len():
        lists = legacy_grove_lists(k, towns)
        loop group in lists: legacy_trees += group.len()
    assert(legacy_trees > 400, "expected legacy groves > 400, got {legacy_trees}")

    # Neravessa keeps its intentional stone-promenade plane and poplar trees
    kept_canal_trees = 0
    loop bank in canal_banks:
        if bank.front != 0: continue
        arm = bank.local < 0
        seed = abs(bank.local * 3 + (if bank.sign > 0.0: 1 else: 0)) + (if arm: int(abs(bank.a.x)) else: 0)
        if arm and canal_hash(seed) % 3 != 0: continue
        mid = (bank.a + bank.b) * 0.5 + bank.out * 4.2
        if canal_tree_clear(mid, bank.terrace): kept_canal_trees += 1
    assert(kept_canal_trees > 100, "expected Neravessa promenade trees > 100, got {kept_canal_trees}")

    # Wild river & lake banks keep trees and reeds away from towns and jetties
    rb = build_river_bank(2)
    assert(rb.kinds[0].len() + rb.kinds[1].len() > 10 and rb.kinds[2].len() > 50, "river bank greenery wiped out")
    lt, lst, lr = lake_bank_plan(0)
    assert(lt[0].len() + lt[1].len() > 20 and lr.len() > 20, "lake bank greenery wiped out")

    # Town gardens & square props survive outside forbidden zones
    kalyrassa = world_settlements[settlement_by_id[10001]]
    sq_kept = 0
    loop prop in place_square(kalyrassa).props:
        if prop.kind == 2 or prop.kind == 4 or prop.kind == 10:
            p = place_to_world(kalyrassa, prop.local)
            if town_prop_clear(p, if prop.kind == 4: 0.4 else: 1.0, if prop.kind == 4: 2 else: 1): sq_kept += 1
    assert(sq_kept > 0, "Kalyrassa square greenery wiped out")

    # Hillsides near towns stay grassy and wooded
    grassy = 0
    loop dx in 0..20:
        if grass_cover(towns, 40.0 + f64(dx) * 2.0, 35.0) > 0.5: grassy += 1
    assert(grassy > 10, "legacy hillside grass wiped out")
