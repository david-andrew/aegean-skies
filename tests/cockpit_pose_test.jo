use '../src/cockpit.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/sea.jo'
use '../src/world_point.jo'

test "moored cockpit head shares the visual seat pose throughout the swell":
    model=CraftModel(Mesh(),Mesh(),vec3(0,0,0),[],vec3(0,1,0.35),vec3(0,0,0))
    loop base in [WorldPoint(0.125,2.2,-6000.234),WorldPoint(220000.125,2.2,-190000.234)]:
        state=CraftState(position=world_vec(base),precise=base,published=world_vec(base),precise_ready=true,moored=true)
        loop i in 0..600:
            pose=afloat_transform(translation(state.position)*rotation_y(0.75),f64(i)/60.0)
            eye=cockpit_pose_eye(model,state,pose)
            root=world_offset(base,pose[3].xyz-state.position)
            rotation=pose;rotation[3]=vec4(0,0,0,1)
            in_seat=transform_point(transpose(rotation),world_delta(eye,root))
            assert(length(in_seat-cockpit_eye_local(model))<0.000001)

test "unmodified airborne cockpit retains the physical head transform":
    model=CraftModel(Mesh(),Mesh(),vec3(0,0,0),[],vec3(0,1,0.35),vec3(0,0,0))
    state=CraftState(position=vec3(100,500,-400),orientation=quat_euler(0.3,1.2,-0.5))
    pose=translation(state.position)*quat_to_mat4(state.orientation)
    eye=cockpit_pose_eye(model,state,pose)
    prior=craft_offset(state,quat_rotate(state.orientation,cockpit_eye_local(model)))
    assert(length(world_delta(eye,prior))<0.000001)
