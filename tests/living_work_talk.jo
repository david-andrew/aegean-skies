import '../src/living_world.jo' as facade
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_save.jo'
use '../src/living_conversation.jo'
use '../src/living_work_knowledge.jo'

test "asking a person for work offers their own commission and never the other notices":
    w = build_world()
    offers = facade.work_offers(w,1)
    assert(offers.len()>0)
    loop offer in offers: assert(offer.own and w.jobs[offer.job].poster == 1)
    turn = facade.ask_for_work(w,1)
    assert(turn.job >= 0 and w.jobs[turn.job].poster == 1)
    assert(w.jobs[turn.job].state == .open and w.people[0].carriage < 0)
    assert(w.speech[0].work_leads.len() == 1)

test "a person without work says no instead of presenting the board and previews stay pure":
    w = build_world(); before = canonical_text(w)
    assert(facade.work_offers(w,7).len() == 0 and canonical_text(w) == before)
    turn = facade.ask_for_work(w,7)
    assert(turn.job == -1 and turn.text != "" and "me" in turn.text)
    # Pointing to the town's merchant by name is fine; disclosing her posted load is not.
    assert(not ("medicine" in turn.text) and not ("lire" in turn.text))

test "only an actually heard offer becomes a dated referral and a retelling cannot refresh it":
    w = build_world(); job = facade.work_offers(w,1)[0].job
    assert(facade.work_offers(w,7).len() == 0)
    assert(remember_work_offer(w,7,1,job))
    w.minute = 100; w.tick = 12000
    assert(remember_work_offer(w,6,7,job))
    assert(w.speech[6].work_leads[0].heard_minute == 0)
    assert(not remember_work_offer(w,7,6,job))
    before = canonical_text(w); options = facade.work_offers(w,6)
    assert(options.len() == 1 and not options[0].own and options[0].source_person == 7)
    assert(canonical_text(w) == before)
    turn = facade.ask_for_work(w,6)
    assert(turn.job == job and "Petros" in turn.text and "Eleni" in turn.text)
    parsed = from_text[World](canonical_text(w)); assert(parsed is World)
    assert(facade.work_offers(parsed,6) == facade.work_offers(w,6))
    w.minute = 4320; w.tick = w.minute*120
    assert(facade.work_offers(w,6).len() == 0)
