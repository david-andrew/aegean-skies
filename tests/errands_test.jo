# Errands of the islands (src/errands.jo): the mail bag, the morning papers, ice for the fishmonger,
# a diver's sponges, the nurse to a sick child. Each is posted by the one whose work it is at its
# hour, priced believably, waited for on the dock by the one named (the dock handover), and told of
# after (the pilot's name, his day, the leads). Saved with the world.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/life_types.jo'
use '../src/living_portage.jo'
use '../src/living_jobs.jo'
use '../src/errand_types.jo'
use '../src/errand_words.jo'
use '../src/errands.jo'
use '../src/reputation_types.jo'
use '../src/reputation.jo'
use '../src/reputation_talk.jo'
use '../src/pilot_day_types.jo'
use '../src/pilot_talk.jo'
use '../src/leads.jo'
use '../src/world_bytes.jo'
import '../src/living_world.jo' as living

_kinds = (w: World) -> {ErrandKind: int}:
    n: {ErrandKind: int}
    loop _, e in w.errands: n[e.kind] = n.get(e.kind,0)+1
    n

test "a week of errands: each posted at its hour by the one whose work it is, believably priced":
    w = build_world(u64(4))
    advance_minutes(w,6*1440)
    n = _kinds(w)
    loop k in [ErrandKind.mail,.papers,.ice,.sponges,.nurse]: assert(n.get(k,0) > 0,"{k}: {n}")
    loop id, e in w.errands:
        j = w.jobs[id]
        assert(j.reward_cents >= 600 and j.reward_cents <= 4500,"{e.kind} {j.reward_cents}")
        assert(e.recipient >= 0 and w.people[e.recipient].home == j.destination,"{e.kind} recipient")
        assert(j.context == errand_ask(w,e))
        if e.kind == .mail:
            assert(w.people[j.poster].occupation == .clerk or w.people[j.poster].occupation == .telegraphist or w.people[j.poster].occupation == .teacher or w.people[j.poster].occupation == .priest or w.people[j.poster].occupation == .merchant)
        if e.kind == .nurse: assert(j.purpose == .passenger and w.people[j.passenger].occupation == .nurse and e.child != "")
        else: assert(j.cargo_mode == .sealed)
        notice = errand_notice(w,e)
        assert(notice.0 != "" and notice.1 != "")
    # (the papers at dawn, wanted by breakfast)
    loop _, e in w.errands:
        if e.kind == .papers: assert(local_minute(e.posted) == 300 and w.jobs[e.job].due_minute-e.posted == 180)

# The pilot and his aircraft set down at harbour `p`, moored at its first dock.
_put = (w: mut World, p: int):
    c = w.people[w.player].craft
    w.aircraft[c].move_owner = .scene
    w.aircraft[c].place = p; w.aircraft[c].dock = 0; w.aircraft[c].trip = -1; w.aircraft[c].state = .moored
    w.aircraft[c].pose.pos = w.harbors[p].docks[0]
    w.places[w.people[w.player].place].residents.remove(w.player)
    w.people[w.player].place = p; w.places[p].residents.push(w.player)
    w.people[w.player].pose.pos = w.cargo_harbors[p].loading[0]

# The day's mail out of Porto Vecchio, taken by the pilot and loaded.
_mail = () -> (World, int):
    w = build_world(u64(4))
    loop m in 0..1440*2:
        living.advance_minutes(w,1)
        loop id, e in w.errands:
            if e.kind == .mail and w.jobs[id].origin == 0 and w.jobs[id].state == .open:
                assert(living.take_job(w,id,w.player,.automatic))
                k = 0
                loop k < 180 and not w.jobs[id].loaded:
                    living.advance_minutes(w,1); k += 1
                assert(w.jobs[id].loaded)
                return (w,id)
    panic("no mail posted")

test "the mail: the postmaster at the other end waits on the dock, takes it, the pilot is paid and it is told":
    w, job = _mail()
    e = w.errands[job]
    r = cargo_receiver(w,job)
    assert(r == e.recipient,"{r} {e.recipient}")
    assert(cargo_awaited(w,r) == job)
    assert(errand_waiting(w,e) == "Is that the mail?")
    # (arrived and handed over)
    _put(w,w.jobs[job].destination)
    before = w.accounts[w.people[w.player].account].cents
    assert(choose_collection(w,job,w.player,.sender))
    m = 0
    loop m < 30 and w.jobs[job].state != .delivered:
        living.advance_minutes(w,1); m += 1
    assert(w.jobs[job].state == .delivered)
    assert(w.accounts[w.people[w.player].account].cents-before == w.jobs[job].reward_cents)
    living.advance_minutes(w,2)
    deeds = [loop d in w.rep.deeds: if d.kind == .job_done and d.job == job: d]
    assert(deeds.len() == 1)
    said = rep_deed_lines(w,deeds[0],e.recipient,.stranger)
    assert(said.len() > 0 and said[0].contains("mail"),"{said}")
    day = pilot_on_day(w,w.pilot_day,0)
    assert(day.contains("mail") or day.contains("Mail"),day)

# The first nurse errand open in a week, with its world.
_nurse = () -> (World, int):
    w = build_world(u64(4))
    loop m in 0..1440*8:
        living.advance_minutes(w,1)
        loop id, e in w.errands:
            if e.kind == .nurse and w.jobs[id].state == .open: return (w,id)
    panic("no nurse wanted in eight days")

test "the nurse to a sick child: she rides as a passenger, the lead says so, and she is set down there":
    w, nurse_job = _nurse()
    e = w.errands[nurse_job]
    j = w.jobs[nurse_job]
    told = false
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,[]):
            if l.subject == nurse_job:
                assert(lead_line(w,l,speaker,0).contains(e.child))
                told = true
    assert(told)
    _put(w,j.origin)
    assert(living.take_job(w,nurse_job,w.player,.automatic))
    c = w.people[w.player].craft
    k = 0
    loop k < 60 and not w.jobs[nurse_job].loaded:
        living.advance_minutes(w,1); k += 1
    assert(j.passenger in w.aircraft[c].passengers)
    # (there: she alights and the guardian waits)
    _put(w,j.destination)
    assert(living.deliver_job(w,nurse_job,w.player))
    assert(w.jobs[nurse_job].state == .delivered,"{w.jobs[nurse_job].state}")
    assert(w.people[j.passenger].place == j.destination)

test "errands are kept with the world when it is saved":
    w = build_world(u64(4))
    advance_minutes(w,2*1440)
    assert(w.errands.len() > 0)
    got = world_from_bytes(world_to_bytes(w))
    if got is TextError: panic("{got}")
    assert(got.errands == w.errands)
