# Swimming ashore in a rough sea: the swim ends on ground the walker accepts, and the pilot can
# walk up the beach and back toward the water from there, whatever the swell is doing. (In a high
# wind the swell's troughs once ended a swim where the still water was deeper than one may wade:
# dressed again, the pilot could step nowhere.) The real swell, island terrain and walker.
use '../src/world.jo'
use '../src/objects.jo'
use '../src/sea.jo'
use '../src/look.jo'
use '../src/swimming.jo'
use '../src/world_point.jo'

assert(load_land(embed('../assets/terrain.bin')))
geography_enabled = false

_towns: Town[] = []
_ground = (x: f64, z: f64) -> f64: walk_height(_towns, x, z)
_still = (x: f64, z: f64) -> f64: 0.0

# A gently shelving beach on Kalamos along bearing a: the dry sand's first point and the way out
# to sea, found by walking out from the island's centre.
_beach = (a: f64) -> (vec2, vec2)?:
    out = vec2(f32(cos(a)), f32(sin(a)))
    r = 300.0
    loop r < 4000.0:
        p = out * f32(r)
        if _ground(f64(p.x), f64(p.y)) < 0.0:
            # (a beach, not a cliff: 2.5 m deep some 20-60 m further out)
            deep = p + out * 60.0; mid = p + out * 20.0
            if _ground(f64(deep.x), f64(deep.y)) < -2.5 and _ground(f64(mid.x), f64(mid.y)) > -2.5: return (p - out * 2.0, out)
            return none
        r += 2.0
    none

test "swimming ashore in a rough sea ends where one can walk, up the beach and back":
    wind_now.speed = 14.0
    tried = 0
    loop seed in 0..24:
        a = f64(seed) * TAU / 24.0
        if let found = _beach(a):
            shore, out = found
            tried += 1
            loop phase in [0.0, 1.3, 2.9, 4.1]:
                wind_now.dir = normalize(vec2(f32(cos(a + phase)), f32(sin(a + phase))))
                clock = phase * 7.0 + f64(seed)
                level = (x: f64, z: f64) -> f64: f64(swell_at(x, z, clock).x)
                # (out where it is deep, swimming in toward the beach)
                start = shore + out * 70.0
                s = Swim(active = true, swimming = true, wet = true)
                p = vec3(start.x, f32(level(f64(start.x), f64(start.y)) - SWIM_BODY), start.y)
                ended = false
                loop k in 0..12000:
                    clock += 1.0 / 60.0
                    st = swim_step(s, p, -out * f32(swim_speed(s, false) / 60.0), 1.0 / 60.0, false, _ground, level, _still)
                    p = st.pos
                    if st.out:
                        ended = true; break
                assert(ended, "seed {seed} phase {phase}: never came out")
                # (out on ground the walker accepts: no deeper than one may wade under the still water)
                assert(_ground(f64(p.x), f64(p.z)) > -SWIM_OUT - 0.001, "seed {seed} phase {phase}: out at {p.y:.2}")
                # up the beach 8 m, then back down to the water's edge and in to wading depth
                w = world_point(p)
                w = walk_step_precise(_towns, w, -out * 8.0)
                assert(f64(length(world_vec(w).xz - p.xz)) > 6.0, "seed {seed} phase {phase}: couldn't walk up the beach")
                back = world_point(p)
                back = walk_step_precise(_towns, back, out * 3.0)
                assert(f64(length(world_vec(back).xz - p.xz)) > 0.5, "seed {seed} phase {phase}: couldn't walk back into the water")
                # (every way from where the swim ended goes somewhere)
                loop k in 0..8:
                    d = vec2(f32(cos(f64(k) * TAU / 8.0)), f32(sin(f64(k) * TAU / 8.0)))
                    moved = walk_step_precise(_towns, world_point(p), d * 0.5)
                    if f64(dot(d, out)) < 0.3: assert(f64(length(world_vec(moved).xz - p.xz)) > 0.3, "seed {seed} phase {phase}: stuck going {d}")
    assert(tried >= 3)

test "the walker never pins anyone standing deeper than one may wade":
    # (put down too deep, by a load or a swim's end elsewhere: shallower is always open)
    found = _beach(0.0) ?? _beach(PI * 0.5) ?? _beach(PI)
    assert(found != none)
    shore, out = found!
    deep = shore + out * 40.0
    assert(_ground(f64(deep.x), f64(deep.y)) < -WALK_WADE_DEPTH - 0.1)
    p = world_point(vec3(deep.x, f32(_ground(f64(deep.x), f64(deep.y))), deep.y))
    up = walk_step_precise(_towns, p, -out * 2.0)
    assert(f64(length(world_vec(up).xz - world_vec(p).xz)) > 1.5)
    # (and going deeper from there is still refused)
    down = walk_step_precise(_towns, p, out * 2.0)
    assert(f64(length(world_vec(down).xz - world_vec(p).xz)) < 0.01)

test "a passing wave does not flip swimming and wading":
    assert(swim_band(false, SWIM_DEPTH + SWIM_BAND + 0.01) and not swim_band(false, SWIM_DEPTH))
    assert(swim_band(true, SWIM_DEPTH) and not swim_band(true, SWIM_DEPTH - SWIM_BAND - 0.01))
