use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_schedule.jo'
use '../src/living_talk_context.jo'
use '../src/living_questions.jo'
use '../src/living_conversation.jo'
use '../src/living_work_knowledge.jo'
use '../src/living_news.jo'

test "shift speech uses today's credited work interval and disappears off duty":
    w=build_world()
    loop day in [1,14,29]:
        w.minute=day*1440-570+870; w.tick=w.minute*120
        assert(current_shift_end(.clerk,w.minute)==day*1440-570+960)
        seen=false
        loop c in context_day(w,5,.formal,0):
            if c.key.starts_with("shift:"):
                seen=true; assert("16:00" in c.text and not ("yesterday" in c.text) and not ("days ago" in c.text))
        assert(seen)
        w.minute += 150; w.tick=w.minute*120
        loop c in context_day(w,5,.formal,0): assert(not c.key.starts_with("shift:"))

test "a work referral does not send the listener back to themselves":
    w=build_world(); j=2
    lead=WorkLead(j,20,4,0,1,1000,1800,w.minute,20,false)
    w.speech[21]=SpeechLedger(work_leads=[lead])
    assert(work_referral_candidates(w,21,20).len()>0)
    loop c in work_referral_candidates(w,21,20): assert(not c.key.starts_with("work-lead:"))

test "news uses self and source perspective instead of repeating names as strangers":
    w=build_world()
    own=NewsItem(999,.delivery,0,0,2,17,severity=100,reason=Reason(purpose=.delivery,actor=17,beneficiary=17,origin=2,destination=2,good=2,quantity=1000))
    w.people[17].news=[own]
    lines=news_candidates(w,17,16)
    assert(lines.len()>0 and "myself" in lines[0].text and not ("for Father Andreas" in lines[0].text))
    attacked=NewsItem(1000,.raid,0,0,3,8,hops=1,confidence=850,severity=600,reason=Reason(purpose=.raid,actor=22,counterparty=8,origin=3,destination=3))
    w.people[5].news=[attacked]
    lines=news_candidates(w,5,0)
    assert(lines.len()>0 and "Dario said Cem attacked them" in lines[0].text)
    assert(not ("Dario told me this: Dario" in lines[0].text))

test "visible player craft belongs to you and an inserted name preserves capital I":
    w=build_world(); w.people[1].pose.pos=w.aircraft[0].pose.pos
    found=false
    loop c in context_day(w,1,.shop,0):
        if c.key.starts_with("visible-craft:0:"):
            found=true; assert("your gull" in lower(c.text) and not ("pilot's" in c.text))
    assert(found and ctx_after_name("I've said enough.")=="I've said enough.")
    loop c in conversation_candidates(w,24,25,.troubles): assert(not (", i'" in c.text) and not (", i " in c.text))

test "new question sentences belong to one voice and still carry a matching domain":
    owners: {str: VoiceKind}
    loop voice in [VoiceKind.salt,.shop,.formal,.guarded,.anxious,.warm,.wry,.measured]:
        loop topic in [TalkTopic.greeting,.news]:
            loop q in followup_questions(voice,topic):
                assert(not (q.text in owners)); owners[q.text]=voice
                assert(question_details(q.text).kind==q.kind)
    assert(not ("And you? How has the day treated you?" in owners))
