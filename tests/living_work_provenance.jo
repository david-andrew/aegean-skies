use 'living_commissions.jo'

test "a real depleted buyer's bid travels on a returning carrier before the supplier may agree":
    w=commission_fixture()
    loop hour in 1..42:
        w.minute=hour*60; w.tick=w.minute*120
        loop place in [100,200]:
            far_work_hour(w,place); far_household_hour(w,place)
    far_supply_requests(w,200)
    bids=[loop r in w.far.districts[200].reports: if r.kind=="supply_request" and r.supply_good==3: r]
    assert(bids.len()==1); bid=bids[0]
    assert(bid.supply_observed<bid.supply_target and bid.supply_account==w.far.districts[200].market_account)
    assert(refresh_far_work(w,100)<0) # remote current need is not communication
    assert(far_depart(w,0))
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    w.tick+=3600; w.minute=w.tick/120
    assert(far_depart(w,0))
    assert([loop r in w.far.journeys[w.far.vehicles[0].journey].reports: if r.id==bid.id: r].len()==1)
    assert(refresh_far_work(w,100)<0) # the signed order is still aboard, not received
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    goods=stock_totals(w); roots=w.next_cargo_source
    id=refresh_far_work(w,100)
    assert(id>=0)
    p=w.far.commissions[id].provenance
    assert(p.negotiated and p.request_report==bid.id and p.heard_minute>p.requested_minute)
    assert(p.supplier_account==w.far.districts[100].market_account and p.requester_account==bid.supply_account)
    assert(p.goods_cents>0 and p.freight_cents==bid.supply_reward and p.deadline==bid.supply_due and p.supply_roots.len()>0)
    assert(stock_totals(w)==goods and w.next_cargo_source==roots and refresh_far_work(w,100)<0)
    before=canonical_text(w); assert(commission_provenance(w,id).len()>=3 and canonical_text(w)==before)
    assert(money_balances(w)); assert(goods_balance(w))
    # Only the far subsystem advanced in this fixture; core deadlines use the full-world test.
    assert(validate_far(w)=="",validate_far(w))

test "routine local delivery does not manufacture another need when the household already owns its reserve":
    w=commission_fixture()
    # A genuine local owner already has the requested wine. Moving existing market roots
    # through the ordinary purchase command is sufficient; no new daily job should appear.
    w.people[6].place=0
    # Existing normal jobs may be posted elsewhere; compare only Sofia's requested goods.
    assert(trade(w,6,0,1,1000,true))
    local_errands_minute(w)
    assert([loop id in w.active_jobs: if w.jobs[id].poster==6 and w.jobs[id].delivery_mode==.foot: id].len()==0)
