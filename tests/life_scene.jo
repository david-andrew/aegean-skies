use '../src/geography.jo'
use '../src/settlements.jo'
import '../src/living_world.jo' as living
import '../src/living_types.jo' as data
import '../src/life_types.jo' as life_data
import '../src/living_life.jo' as daily
import '../src/living_scene.jo' as clock
import '../src/life_scene.jo' as scene
import '../src/cargo_scene.jo' as cargo
import '../src/living_portage.jo' as porter
import '../src/living_save.jo' as saves
import '../src/objects.jo' as objects
import '../src/world.jo' as land

test "a saved daily route walks the actual quay under one scene owner and folds exactly":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns)
    daily.life_minute(w)
    moved = false
    loop k in 0..240:
        before = w.people[1].pose.pos
        clock.scene_clock_begin(w)
        cargo.step_cargo_scene(w,towns,w.harbors[0].center,1.0/60.0)
        scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
        clock.scene_clock_end(w)
        delta = length(w.people[1].pose.pos.xz-before.xz)
        assert(delta <= 0.022)
        if delta > 0.001: moved = true
    assert(moved and w.daily_life[1].scene_owned and w.people[1].move_owner == .scene)
    position = w.people[1].pose.pos
    scene.fold_life_for_save(w); porter.fold_carriage_for_save(w)
    assert(w.people[1].pose.pos == position and not w.daily_life[1].scene_owned)
    assert(saves.validate_save_world(w) == "")
    parsed = from_text[data.World](saves.canonical_text(w)); assert(parsed is data.World)
    assert(parsed.people[1].pose.pos == position and parsed.daily_life[1].route == w.daily_life[1].route)

test "a scene-obstructed daily destination cannot be reached by folding out of view":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns)
    loop k in 0..w.life_venues.len():
        if w.life_venues[k].place == 0 and w.life_venues[k].kind == .market: w.life_venues[k].pos = w.harbors[0].center+w.harbors[0].out*100.0
    daily.life_minute(w)
    clock.scene_clock_begin(w)
    scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
    clock.scene_clock_end(w)
    assert(w.daily_life[1].blocked != "")
    position = w.people[1].pose.pos
    scene.fold_life_for_save(w)
    living.advance_minutes(w,10)
    assert(w.people[1].pose.pos == position and not w.daily_life[1].arrived and w.daily_life[1].blocked != "")

test "daily navigation has a strict shared budget and children keep their movement lease":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns); daily.life_minute(w)
    position = w.people[1].pose.pos
    clock.scene_clock_begin(w)
    assert(scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0,0) == 0)
    clock.scene_clock_end(w)
    assert(w.people[1].pose.pos == position)
    clock.scene_clock_begin(w)
    assert(scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0,1) <= 1)
    clock.scene_clock_end(w)
    child = w.households[0].pose
    assert(w.households[0].scene_owned)
    daily.advance_household_motion(w,0,w.tick+120)
    assert(w.households[0].pose == child)
    scene.fold_life_for_save(w)
    assert(not w.households[0].scene_owned and saves.validate_save_world(w) == "")

test "coincident idle residents separate their saved poses":
    w=living.build_world()
    towns=[loop s in land.SETTLEMENTS:objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns);scene.configure_life_scene(w,towns)
    at=w.people[1].pose.pos
    loop id in [1,2,3]:
        # Explicitly stage visible on-foot bodies; the seed includes travelers.
        w.people[id].place=0;w.people[id].trip= -1;w.people[id].state=.idle
        w.daily_life[id].venue=.square;w.daily_life[id].activity=.wait
        w.people[id].pose.pos=at
        w.daily_life[id].scene_owned=true
        w.daily_life[id].arrived=true
    loop frame in 0..360:scene.separate_life_people(w,towns,at,1.0/60.0)
    loop a in [1,2,3]:
        loop b in [1,2,3]:
            if a<b:assert(length(w.people[a].pose.pos.xz-w.people[b].pose.pos.xz)>0.5)


test "idle separation retains sub-centimeter motion at Olythoria coordinates":
    assert(land.load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    w=living.build_world()
    towns=[loop s in land.SETTLEMENTS:objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns);scene.configure_life_scene(w,towns)
    at=vec3(0,0,0)
    loop s in world_settlements:
        if s.name=="Olythoria":at=s.center+vec3(0,0,-1)
    assert(abs(at.x)>100000)
    at.y=f32(objects.walk_height(towns,at.x,at.z))
    loop id in [1,2,3]:
        # Explicitly stage visible on-foot bodies; the seed includes travelers.
        w.people[id].place=0;w.people[id].trip= -1;w.people[id].state=.idle
        w.daily_life[id].venue=.square;w.daily_life[id].activity=.wait
        w.people[id].pose.pos=at
        w.daily_life[id].scene_owned=true;w.daily_life[id].arrived=true
    loop frame in 0..360:scene.separate_life_people(w,towns,at,1.0/60.0)
    loop a in [1,2,3]:
        loop b in [1,2,3]:
            if a<b:assert(length(w.people[a].pose.pos.xz-w.people[b].pose.pos.xz)>0.5)


test "stationary workers occupy space without a daily route lease":
    w=living.build_world()
    towns=[loop s in land.SETTLEMENTS:objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns);scene.configure_life_scene(w,towns)
    at=w.people[4].pose.pos
    loop id in [4,8]:
        w.people[id].pose.pos=at;w.people[id].place=0;w.people[id].trip= -1
        w.people[id].action.purpose=.repair
        w.daily_life[id].scene_owned=false;w.daily_life[id].arrived=true
        w.daily_life[id].venue=.workshop;w.daily_life[id].activity=.work
    loop frame in 0..180:scene.separate_life_people(w,towns,at,1.0/60)
    assert(length(w.people[4].pose.pos.xz-w.people[8].pose.pos.xz)>0.5)
    assert(not w.daily_life[4].scene_owned and not w.daily_life[8].scene_owned)

test "blocked residents yield to walkers without adding another walking step":
    w=living.build_world()
    towns=[loop s in land.SETTLEMENTS:objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns);scene.configure_life_scene(w,towns)
    at=w.people[1].pose.pos
    loop id in [1,2]:
        w.people[id].pose.pos=at;w.people[id].place=0;w.people[id].trip= -1
        w.people[id].state=.idle
        w.people[id].action.purpose=.visit
        w.daily_life[id].scene_owned=true;w.daily_life[id].arrived=false
        w.daily_life[id].venue=.square;w.daily_life[id].activity=.wait
        w.daily_life[id].blocked=if id==2:"The walking route is obstructed." else:""
    loop frame in 0..180:scene.separate_life_people(w,towns,at,1.0/60)
    assert(w.people[1].pose.pos==at)
    assert(length(w.people[1].pose.pos.xz-w.people[2].pose.pos.xz)>0.5)

test "a walker the daily scene lets go for a carriage still in the world's hands is not left owned by the scene":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns)
    daily.life_minute(w)
    loop k in 0..60:
        clock.scene_clock_begin(w)
        scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
        clock.scene_clock_end(w)
    assert(w.daily_life[1].scene_owned and w.people[1].move_owner == .scene)
    # (a porter's errand handed to them by the world: the carriage is not in the scene)
    id = 990
    w.carriage[id] = data.Carriage(id=id,job= -1,cargo= -1,person=1,phase=.carry,target=w.people[1].pose.pos,last_tick=w.tick)
    w.people[1].carriage = id
    clock.scene_clock_begin(w)
    scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
    clock.scene_clock_end(w)
    assert(not w.daily_life[1].scene_owned and w.people[1].move_owner == .abstract_world)
    # (the same carriage taken into the scene keeps them there, for the cargo scene's fold)
    w.daily_life[1].scene_owned = true; w.people[1].move_owner = .scene; w.carriage[id].move_owner = .scene
    clock.scene_clock_begin(w)
    scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
    clock.scene_clock_end(w)
    assert(w.people[1].move_owner == .scene)
    # (and what a save folds leaves nobody to the scene: main's web saves were refused for this)
    scene.fold_life_for_save(w); porter.fold_carriage_for_save(w)
    loop p in w.people: assert(p.move_owner != .scene)

test "at an open-air cafe the people take its own chairs: one each, kept while they stay; a fifth stands by":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    init_settlements(false, true)
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns)
    cafe: life_data.LifeVenue? = none
    loop v in w.life_venues:
        if v.place == 0 and v.key == "legacy:0:scene:cafe": cafe = v
    assert(cafe != none)
    site = cafe!
    # (the venue is where the town's cafe tables stand, with their turn and size)
    fixture = scene.legacy_cafe_fixture(towns[0], 0)
    assert(fixture != none and life_data.cafe_has_chairs(site) and length(site.prop_pos - fixture!.0) < 0.01)
    chairs = [loop k in 0..4: life_data.cafe_chair(site, k).0]
    loop k in 0..4:
        loop j in k + 1..4: assert(f64(length(chairs[k] - chairs[j])) > 1.5)
        # (each faces its table: the table is between a chair and its opposite)
        face = life_data.cafe_chair(site, k).1
        assert(f64(dot(normalize(chairs[(k + 2) % 4] - chairs[k]), face)) > 0.95)
    # five townspeople sent to the cafe to talk
    people: int[]
    loop p in w.people:
        if p.id > 0 and p.id != w.player and p.place == 0 and p.home == 0 and people.len() < 5: people.push(p.id)
    assert(people.len() == 5)
    loop person in people:
        intent = w.daily_life[person]
        intent.venue = .cafe; intent.activity = .talk; intent.place = 0
        daily.set_life_destination(w, person, intent)
    seated: int[]
    standing = 0
    loop person in people:
        target = w.daily_life[person].target
        assert(w.daily_life[person].anchor == site.key)
        chair = -1
        loop k in 0..4:
            if f64(length(target - chairs[k])) < 0.3: chair = k
        if chair >= 0:
            assert(not (chair in seated)); seated.push(chair)
        else: standing += 1
    assert(seated.len() == 4 and standing == 1)
    # (planned again, each keeps the chair he has)
    before = [loop person in people: w.daily_life[person].target]
    loop k in 0..people.len():
        intent = w.daily_life[people[k]]
        daily.set_life_destination(w, people[k], intent)
        assert(f64(length(w.daily_life[people[k]].target - before[k])) < 0.01)
