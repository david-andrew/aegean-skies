use '../src/geography.jo'
use '../src/settlements.jo'
import '../src/living_world.jo' as living
import '../src/living_types.jo' as data
import '../src/life_types.jo' as life_data
import '../src/living_life.jo' as daily
import '../src/living_scene.jo' as clock
import '../src/life_scene.jo' as scene
import '../src/cargo_scene.jo' as cargo
import '../src/living_portage.jo' as porter
import '../src/living_save.jo' as saves
import '../src/objects.jo' as objects
import '../src/world.jo' as land

test "a saved daily route walks the actual quay under one scene owner and folds exactly":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns)
    daily.life_minute(w)
    moved = false
    loop k in 0..240:
        before = w.people[1].pose.pos
        clock.scene_clock_begin(w)
        cargo.step_cargo_scene(w,towns,w.harbors[0].center,1.0/60.0)
        scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
        clock.scene_clock_end(w)
        delta = length(w.people[1].pose.pos.xz-before.xz)
        assert(delta <= 0.022)
        if delta > 0.001: moved = true
    assert(moved and w.daily_life[1].scene_owned and w.people[1].move_owner == .scene)
    position = w.people[1].pose.pos
    scene.fold_life_for_save(w); porter.fold_carriage_for_save(w)
    assert(w.people[1].pose.pos == position and not w.daily_life[1].scene_owned)
    assert(saves.validate_save_world(w) == "")
    parsed = from_text[data.World](saves.canonical_text(w)); assert(parsed is data.World)
    assert(parsed.people[1].pose.pos == position and parsed.daily_life[1].route == w.daily_life[1].route)

test "a scene-obstructed daily destination cannot be reached by folding out of view":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns)
    loop k in 0..w.life_venues.len():
        if w.life_venues[k].place == 0 and w.life_venues[k].kind == .market: w.life_venues[k].pos = w.harbors[0].center+w.harbors[0].out*100.0
    daily.life_minute(w)
    clock.scene_clock_begin(w)
    scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
    clock.scene_clock_end(w)
    assert(w.daily_life[1].blocked != "")
    position = w.people[1].pose.pos
    scene.fold_life_for_save(w)
    living.advance_minutes(w,10)
    assert(w.people[1].pose.pos == position and not w.daily_life[1].arrived and w.daily_life[1].blocked != "")

test "daily navigation has a strict shared budget and children keep their movement lease":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns); daily.life_minute(w)
    position = w.people[1].pose.pos
    clock.scene_clock_begin(w)
    assert(scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0,0) == 0)
    clock.scene_clock_end(w)
    assert(w.people[1].pose.pos == position)
    clock.scene_clock_begin(w)
    assert(scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0,1) <= 1)
    clock.scene_clock_end(w)
    child = w.households[0].pose
    assert(w.households[0].scene_owned)
    daily.advance_household_motion(w,0,w.tick+120)
    assert(w.households[0].pose == child)
    scene.fold_life_for_save(w)
    assert(not w.households[0].scene_owned and saves.validate_save_world(w) == "")

test "coincident idle residents separate their saved poses":
    w=living.build_world()
    towns=[loop s in land.SETTLEMENTS:objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns);scene.configure_life_scene(w,towns)
    at=w.people[1].pose.pos
    loop id in [1,2,3]:
        w.people[id].pose.pos=at
        w.daily_life[id].scene_owned=true
        w.daily_life[id].arrived=true
    loop frame in 0..360:scene.separate_life_people(w,towns,at,1.0/60.0)
    loop a in [1,2,3]:
        loop b in [1,2,3]:
            if a<b:assert(length(w.people[a].pose.pos.xz-w.people[b].pose.pos.xz)>0.5)


test "idle separation retains sub-centimeter motion at Olythoria coordinates":
    assert(land.load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    w=living.build_world()
    towns=[loop s in land.SETTLEMENTS:objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns);scene.configure_life_scene(w,towns)
    at=vec3(0,0,0)
    loop s in world_settlements:
        if s.name=="Olythoria":at=s.center+vec3(0,0,-1)
    assert(abs(at.x)>100000)
    at.y=f32(objects.walk_height(towns,at.x,at.z))
    loop id in [1,2,3]:
        w.people[id].pose.pos=at
        w.daily_life[id].scene_owned=true;w.daily_life[id].arrived=true
    loop frame in 0..360:scene.separate_life_people(w,towns,at,1.0/60.0)
    loop a in [1,2,3]:
        loop b in [1,2,3]:
            if a<b:assert(length(w.people[a].pose.pos.xz-w.people[b].pose.pos.xz)>0.5)
