# A picnic: the sea found from a spot (the deepest water round it), a good spot (low land by the
# sea, not built on), a bite now and then, the notebook's line.
use '../src/picnic.jo'

test "the sea's way from a spot, and what makes a good one":
    depths = [0.0, 0.0, 0.2, 1.5, 3.0, 1.2, 0.0, 0.0]
    a = picnic_sea_angle(depths)
    assert(abs(a - 4.0 * TAU / 8.0) < 1e-9, "{a}")
    assert(picnic_sea_angle([0.0, 0.1, 0.3]) < 0.0)
    assert(picnic_spot_ok(1.0, false, a))
    assert(not picnic_spot_ok(1.0, true, a))           # (a quay, a pier, a town street)
    assert(not picnic_spot_ok(6.0, false, a))          # (up on the cliff)
    assert(not picnic_spot_ok(0.05, false, a))         # (in the wash)
    assert(not picnic_spot_ok(1.0, false, -1.0))       # (no sea in reach)

test "a bite now and then, sitting; the notebook's line":
    p = Picnic(active = true, settle = 1.0, next_bite = 10.0)
    assert(not picnic_bite_due(p, 9.0) and picnic_bite_due(p, 10.0))
    assert(not picnic_bite_due(Picnic(active = true, settle = 0.5), 100.0))
    assert(picnic_note(Picnic(place = "Porto Vecchio")).contains("Porto Vecchio"))
