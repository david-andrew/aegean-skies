use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_countries.jo'
use '../src/living_events.jo'
use '../src/living_news.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'

test "national tension needs a heard identified event and cannot compound a retelling":
    w = build_world()
    assert(set_core_country(w,0,0) and set_core_country(w,5,1))
    assert(set_country_seat(w,0,0,0))
    event = emit_event(w,.raid,5,22,8,Reason(purpose=.raid,actor=22,counterparty=8,origin=5,destination=5),5000)
    publish_events(w)
    n = w.people[8].news[0]
    assert(n.event == event and not record_national_evidence(w,0,n))
    assert(w.border_incidents.len() == 0)
    assert(receive_place(w,0,retell(n,8,w.minute)))
    heard = w.places[0].news[0]; assert(heard.event == event)
    before = stock_totals(w); cash = w.ledger
    assert(record_national_evidence(w,0,heard))
    tension = w.diplomacy[0].tension
    assert(tension > 0 and not w.border_incidents[0].state_backed)
    loop k in 0..100: assert(not record_national_evidence(w,0,heard))
    assert(w.diplomacy[0].tension == tension and w.border_incidents.len() == 1)
    assert(stock_totals(w) == before and w.ledger == cash and money_balances(w))
    assert(w.diplomacy[0].stage == .calm or w.diplomacy[0].stage == .strained)
    parsed = from_text[World](canonical_text(w)); assert(parsed is World and validate_save_world(parsed) == "")

test "private unknown or weak country reports cannot become a national incident":
    w = build_world()
    assert(set_core_country(w,0,0) and set_core_country(w,5,1) and set_country_seat(w,0,0,0))
    event = emit_event(w,.theft,5,22,8,Reason(purpose=.raid,actor=22,counterparty=8,origin=5,destination=5),2000,true)
    publish_events(w)
    n = w.people[8].news[0]; assert(n.event == event and n.private_fact and not record_national_evidence(w,0,n))
    n.private_fact = false; n.confidence = 500
    assert(not record_national_evidence(w,0,n))
    assert(not set_country_seat(w,1,0,3))
    assert(w.border_incidents.len() == 0 and w.diplomacy.len() == 0)
