use '../src/chase_collision.jo'
use '../src/pilot.jo'
use '../src/flight.jo'
use '../src/town_sites.jo'
use '../src/world_point.jo'
use '../src/canal_geometry.jo'
use '../src/geography.jo'
use '../src/river_data.jo'

test "camera sweeps catch thin walls and keep bridge undersides open":
    h=vec3(4,0.3,8)
    assert(camera_box_fraction(vec3(0,-2,-20),vec3(0,-2,20),h)==1)
    assert(abs(camera_box_fraction(vec3(0,-2,0),vec3(0,2,0),h)-0.425)<0.00001)
    assert(camera_box_fraction(vec3(-20,0,0),vec3(20,0,0),vec3(0.1,8,10))<0.5)
    s=TownSite(vec3(100,3,200),0.7,10,16,12,0)
    a=site_point(s,0,-20);b=site_point(s,0,20)
    assert(camera_site_fraction(s,vec3(a.x,10,a.y),vec3(b.x,10,b.y),0.9)<0.5)
    assert(camera_site_fraction(s,vec3(a.x,30,a.y),vec3(b.x,30,b.y),0.9)==1)

test "camera pulls into the safety margin and returns smoothly without overshoot":
    distance=1.0
    loop i in 0..30:distance=camera_clearance_step(distance,0.4,0.5,1.0/60.0)
    assert(distance>=0.4 and distance<0.401)
    previous=distance
    distance=camera_clearance_step(distance,1,1,1.0/60.0)
    assert(distance>previous and distance<previous+0.04)
    assert(camera_clearance_step(1,0.2,0.3,1.0/60.0)<=0.3)

test "canal camera collision sees a hidden bridge deck and its navigable opening":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_canal_geometry()
    a=RIVER_NODES[CANAL_BEGIN+38]
    b=RIVER_NODES[CANAL_BEGIN+39]
    dir=normalize(vec3(b.x-a.x,0,b.y-a.y))
    mid=vec3(a.x,a.z+4,a.y)
    assert(camera_clear_fraction(mid-dir*10,mid+dir*10,0.9)==1)
    assert(camera_clear_fraction(mid,mid+vec3(0,25,0),0.9)<0.5)
    f=Flyer(spec=craft_spec(.gull,[]),state=CraftState(position=mid))
    frame=ChaseCamera(world_point(mid+vec3(0,25,0)),vec3(0,-1,0),vec3(0,0,1))
    clipped=clear_chase_camera(f,frame,1.0/60.0)
    assert(camera_clear_fraction(mid,world_vec(clipped.eye),0.85)==1)
