use '../src/town_mesh.jo'
use '../src/town_architecture.jo'

test "indexed architecture preserves every triangle attribute and reduces vertex work":
    total=0; unique=0
    loop k in 0..ARCH_COUNT:
        source=arch_vertices(k); indexed=town_indexed(source)
        assert(indexed.1.len()==source.len())
        loop i in 0..source.len(): assert(indexed.0[int(indexed.1[i])]==source[i])
        total+=source.len(); unique+=indexed.0.len()
    print("KIT vertices {total} -> {unique}")
    assert(unique*4<total*3)
