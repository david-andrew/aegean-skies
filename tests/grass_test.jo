use '../src/terrain_lod.jo'
use '../src/grass.jo'
use '../src/town_sites.jo'
use '../src/look.jo'
test "grass patches respect diagonal paved lanes and their endpoints":
    lanes=[TownLane(vec2(0,0),vec2(10,10),2)]
    assert(not grass_lane_clear(vec2(5,5),lanes))
    assert(not grass_lane_clear(vec2(5,6.8),lanes))
    assert(not grass_lane_clear(vec2(-1,0),lanes))
    assert(grass_lane_clear(vec2(5,8),lanes))
    assert(grass_lane_clear(vec2(-3,0),lanes))
test "meadow wave carries the same front through local render origins":
    world=vec2(40000,60000);drift=vec2(39980,59970);origin=vec2(39936,59392)
    wind=vec4(0.6,0.8,8,0)
    assert(abs(meadow_wave(world-drift,wind)-meadow_wave((world-origin)-(drift-origin),wind))<0.00001)
    assert(meadow_wave(world-drift,vec4(0.6,0.8,0,0))==0.0)

use '../src/settlements.jo'
test "streamed roads invalidate nearby grass and reserve only the actual track":
    old_roads=settlement_roads;old_bins=settlement_road_bins
    settlement_roads=[];settlement_road_bins={}
    at=vec2(-236348,-187187);before=grass_road_stamp(at)
    settlement_roads.push(SettlementRoad(1,2,[vec3(at.x,0,at.y-20),vec3(at.x,0,at.y+20)],3.4,true,vec4(0,0,0,0)))
    index_settlement_road(0)
    assert(grass_road_stamp(at)!=before)
    lanes=grass_road_lanes(at,30)
    assert(lanes.len()==1)
    assert(not grass_lane_clear(at+vec2(1.9,0),lanes))
    assert(grass_lane_clear(at+vec2(4,0),lanes))
    settlement_roads=old_roads;settlement_road_bins=old_bins

use '../src/geography.jo'
use '../src/world_source.jo'
use '../src/world.jo'
test "grass source memo preserves mainland and island heights slopes and contact":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    loop center in [vec2(-206885,-95795),vec2(-117964,-84901),vec2(-104900,-120000),vec2(680,1390)]:
        loop k in 0..32:
            x=f64(center.x)+f64(k)*1.17;z=f64(center.y)+f64(k%7)*2.31
            assert(grass_ecology_height(x,z)==height(x,z))
            assert(grass_surface_height(x,z)==surface_height(x,z))
            gx=(surface_height(x+3,z)-surface_height(x-3,z))/6
            gz=(surface_height(x,z+3)-surface_height(x,z-3))/6
            assert(grass_hillside_slope(x,z)==1.0-1.0/sqrt(1.0+gx*gx+gz*gz))
    # A whole one-metre field should query source corners, not rebuild the
    # authority tens of thousands of times for nearly identical samples.
    world_source_revision=-1
    before=world_source_misses
    loop j in 0..80:
        loop i in 0..80:
            x=-206925.0+f64(i);z=-95835.0+f64(j)
            grass_ecology_height(x,z);grass_hillside_slope(x,z)
            grass_surface_height(x,z)
            grass_surface_height(x+0.5,z);grass_surface_height(x-0.5,z)
            grass_surface_height(x,z+0.5);grass_surface_height(x,z-0.5)
    queries=world_source_misses-before
    assert(queries>0 and queries<2048)
    assert(world_source_points.len()==WORLD_SOURCE_SLOTS)
    print("grass field 6400 cells: {queries} source misses")

use '../src/objects.jo'
test "grass terrain cells reuse overlap and survive toroidal wrap and reload":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    grass_terrain_cells=[];grass_height_cells=[]
    heights_before=grass_height_misses
    before=grass_terrain_misses
    loop j in 0..80:
        loop i in 0..80:grass_terrain(-206925.0+f64(i),-95835.0+f64(j))
    assert(grass_terrain_misses-before==6400)
    assert(grass_height_misses-heights_before==20320) # 57600 calls without overlap reuse
    heights_before=grass_height_misses
    before=grass_terrain_misses
    loop j in 0..80:
        loop i in 0..80:grass_terrain(-206913.0+f64(i),-95835.0+f64(j))
    assert(grass_terrain_misses-before==960)
    assert(grass_height_misses-heights_before>0 and grass_height_misses-heights_before<3500)
    loop x in [-206885.0,-206757.0,-206885.0,-206884.25]:
        z=-95795.0
        cell=grass_terrain(x,z)
        assert(cell.ecology==height(x,z))
        assert(cell.ground==surface_height(x,z))
        loop offset in [vec2(0,0),vec2(0.5,0),vec2(0,-0.5),vec2(3,0)]:
            assert(grass_surface_height(x+f64(offset.x),z+f64(offset.y))==surface_height(x+f64(offset.x),z+f64(offset.y)))
        assert(cell.slope==grass_hillside_slope(x,z))
        assert(cell.dx==surface_height(x+0.5,z)-surface_height(x-0.5,z))
        assert(cell.dz==surface_height(x,z+0.5)-surface_height(x,z-0.5))
        assert(walk_height_from_surface([],x,z,cell.ground)==walk_height([],x,z))
    before=grass_terrain_misses
    assert(load_geography(embed('../assets/world.bin')))
    cell=grass_terrain(-206885.0,-95795.0)
    assert(grass_terrain_misses==before+1 and cell.ground==surface_height(-206885.0,-95795.0))
    assert(grass_terrain_cells.len()==GRASS_TERRAIN_EDGE*GRASS_TERRAIN_EDGE)
    print("grass cell cache: cold=6400 shifted_12m=960 capacity={grass_terrain_cells.len()}")

test "cached terrain height never caches live quay support":
    town=Town(center=vec3(0,0,0))
    assert(walk_height_from_surface([town],0,0,0)==0)
    town.quays=[Quay(vec2(-10,0),vec2(10,0),4)]
    assert(walk_height_from_surface([town],0,0,0)==QUAY_TOP)
    town.quays=[]
    assert(walk_height_from_surface([town],0,0,0)==0)
use '../src/world.jo'
use '../src/objects.jo'
test "meshed hillside is not mistaken for raised paving":
    previous=land_tiles
    assert(load_land(embed('../assets/terrain.bin')))
    towns:Town[]
    # This plain hillside is 0.887 m above the ecological source after meshing.
    assert(surface_height(40,35)>height(40,35)+0.2)
    assert(abs(walk_height(towns,40,35)-surface_height(40,35))<0.01)
    assert(grass_cover(towns,40,35)>0.99)
    land_tiles=previous


test "meadow slope coverage follows the meshed approach hillside":
    previous=land_tiles
    assert(load_land(embed('../assets/terrain.bin')))
    # These adjacent points straddle the old near-bare rectangular patch in
    # the 35 m approach frame, despite lying on a continuous drawn hillside.
    assert(slope_at(40.67,26.94)>0.75)
    assert(grass_hillside_cover(40.67,26.94)>0.8)
    assert(abs(grass_hillside_cover(40.67,26.94)-grass_hillside_cover(40.67,27.94))<0.15)
    land_tiles=previous


use '../src/quality.jo'
test "walking residency contains the frontier through a full rebuild interval":
    previous=render_quality
    loop tier in [0,1,2]:
        render_quality=quality_profile(tier)
        radius=grass_resident_radius(vec3(40,0,0),vec3(40,2,5))
        assert(radius<render_quality.grass_radius+16.0)
        assert(radius>=f64(grass_draw_radius())+5.0+12.0+2.21)
        assert(radius==floor(radius)) # root lattice must never shift half a cell
    render_quality=previous


test "grass material decodes the same filtered terrain bytes":
    # Ridge, normal.xz, pigment.xy. Four corners with deliberately different
    # colours and slopes catch accidental procedural or nearest-cell sampling.
    bytes:u8[]=[64,128,128,32,96,128,180,128,96,160,192,128,180,160,224,255,180,180,224,32]
    material=land_cpu_material(bytes,2,vec2(0.25,0.75),12)
    expected=mix(mix(vec3(32,96,64),vec3(96,160,128),0.25),mix(vec3(160,224,192),vec3(224,32,255),0.25),0.75)/255.0
    assert(length(material.tint.xyz-expected)<0.00001)
    nx=mix(128.0,180.0,0.25)/255.0*2.0-1.0
    nz=mix(128.0,180.0,0.75)/255.0*2.0-1.0
    assert(abs(material.normal.x-nx)<0.00001)
    assert(abs(material.normal.z-nz)<0.00001)
    assert(abs(length(material.normal)-1.0)<0.00001)
    assert(material.h==12.0 and material.tint.w==1.0)

test "blade contrast preserves the visible diffuse mean":
    loop visible in [0.45,0.56,0.78]:
        loop growth in [0.0,0.5,1.0]:
            root=meadow_blade_response(0,growth,visible)
            tip=meadow_blade_response(1,growth,visible)
            assert(abs(mix(root,tip,mix(0.75,visible,growth))-1.0)<0.00001)
            assert(root>0.7 and tip<1.3 and root<=tip)
