use '../src/terrain_lod.jo'
use '../src/grass.jo'
use '../src/town_sites.jo'
use '../src/look.jo'
test "grass patches respect diagonal paved lanes and their endpoints":
    lanes=[TownLane(vec2(0,0),vec2(10,10),2)]
    assert(not grass_lane_clear(vec2(5,5),lanes))
    assert(not grass_lane_clear(vec2(5,6.8),lanes))
    assert(not grass_lane_clear(vec2(-1,0),lanes))
    assert(grass_lane_clear(vec2(5,8),lanes))
    assert(grass_lane_clear(vec2(-3,0),lanes))
test "meadow wave carries the same front through local render origins":
    world=vec2(40000,60000);drift=vec2(39980,59970);origin=vec2(39936,59392)
    wind=vec4(0.6,0.8,8,0)
    assert(abs(meadow_wave(world-drift,wind)-meadow_wave((world-origin)-(drift-origin),wind))<0.00001)
    assert(meadow_wave(world-drift,vec4(0.6,0.8,0,0))==0.0)

use '../src/settlements.jo'
test "streamed roads invalidate nearby grass and reserve only the actual track":
    old_roads=settlement_roads;old_bins=settlement_road_bins
    settlement_roads=[];settlement_road_bins={}
    at=vec2(-236348,-187187);before=grass_road_stamp(at)
    settlement_roads.push(SettlementRoad(1,2,[vec3(at.x,0,at.y-20),vec3(at.x,0,at.y+20)],3.4,true,vec4(0,0,0,0)))
    index_settlement_road(0)
    assert(grass_road_stamp(at)!=before)
    lanes=grass_road_lanes(at,30)
    assert(lanes.len()==1)
    assert(not grass_lane_clear(at+vec2(1.9,0),lanes))
    assert(grass_lane_clear(at+vec2(4,0),lanes))
    settlement_roads=old_roads;settlement_road_bins=old_bins

use '../src/world.jo'
use '../src/objects.jo'
test "meshed hillside is not mistaken for raised paving":
    previous=land_tiles
    assert(load_land(embed('../assets/terrain.bin')))
    towns:Town[]
    # This plain hillside is 0.887 m above the ecological source after meshing.
    assert(surface_height(40,35)>height(40,35)+0.2)
    assert(abs(walk_height(towns,40,35)-surface_height(40,35))<0.01)
    assert(grass_cover(towns,40,35)>0.99)
    land_tiles=previous


test "meadow slope coverage follows the meshed approach hillside":
    previous=land_tiles
    assert(load_land(embed('../assets/terrain.bin')))
    # These adjacent points straddle the old near-bare rectangular patch in
    # the 35 m approach frame, despite lying on a continuous drawn hillside.
    assert(slope_at(40.67,26.94)>0.75)
    assert(grass_hillside_cover(40.67,26.94)>0.8)
    assert(abs(grass_hillside_cover(40.67,26.94)-grass_hillside_cover(40.67,27.94))<0.15)
    land_tiles=previous


use '../src/quality.jo'
test "walking residency contains the frontier through a full rebuild interval":
    previous=render_quality
    loop tier in [0,1,2]:
        render_quality=quality_profile(tier)
        radius=grass_resident_radius(vec3(40,0,0),vec3(40,2,5))
        assert(radius<render_quality.grass_radius+16.0)
        assert(radius>=f64(grass_draw_radius())+5.0+12.0+2.21)
        assert(radius==floor(radius)) # root lattice must never shift half a cell
    render_quality=previous


test "grass material decodes the same filtered terrain bytes":
    # Ridge, normal.xz, pigment.xy. Four corners with deliberately different
    # colours and slopes catch accidental procedural or nearest-cell sampling.
    bytes:u8[]=[64,128,128,32,96,128,180,128,96,160,192,128,180,160,224,255,180,180,224,32]
    material=land_cpu_material(bytes,2,vec2(0.25,0.75),12)
    expected=mix(mix(vec3(32,96,64),vec3(96,160,128),0.25),mix(vec3(160,224,192),vec3(224,32,255),0.25),0.75)/255.0
    assert(length(material.tint.xyz-expected)<0.00001)
    nx=mix(128.0,180.0,0.25)/255.0*2.0-1.0
    nz=mix(128.0,180.0,0.75)/255.0*2.0-1.0
    assert(abs(material.normal.x-nx)<0.00001)
    assert(abs(material.normal.z-nz)<0.00001)
    assert(abs(length(material.normal)-1.0)<0.00001)
    assert(material.h==12.0 and material.tint.w==1.0)
