use '../src/quality.jo'
test "walking residency contains the frontier through a full rebuild interval":
    previous=render_quality
    loop tier in [0,1,2]:
        render_quality=quality_profile(tier)
        radius=grass_resident_radius(vec3(40,0,0),vec3(40,2,5))
        assert(radius<=render_quality.grass_radius+16.0)
        assert(radius>=f64(grass_forward_reach())+5.0+12.0+2.21)
        assert(radius==floor(radius)) # root lattice must never shift half a cell
    render_quality=previous


test "grass material decodes the same filtered terrain bytes":
    # Ridge, normal.xz, pigment.xy. Four corners with deliberately different
    # colours and slopes catch accidental procedural or nearest-cell sampling.
    bytes:u8[]=[64,128,128,32,96,128,180,128,96,160,192,128,180,160,224,255,180,180,224,32]
    material=land_cpu_material(bytes,2,vec2(0.25,0.75),12)
    expected=mix(mix(vec3(32,96,64),vec3(96,160,128),0.25),mix(vec3(160,224,192),vec3(224,32,255),0.25),0.75)/255.0
    assert(length(material.tint.xyz-expected)<0.00001)
    nx=mix(128.0,180.0,0.25)/255.0*2.0-1.0
    nz=mix(128.0,180.0,0.75)/255.0*2.0-1.0
    assert(abs(material.normal.x-nx)<0.00001)
    assert(abs(material.normal.z-nz)<0.00001)
    assert(abs(length(material.normal)-1.0)<0.00001)
    assert(material.h==12.0 and material.tint.w==1.0)

test "blade contrast preserves the visible diffuse mean":
    loop visible in [0.45,0.56,0.78]:
        loop growth in [0.0,0.5,1.0]:
            root=meadow_blade_response(0,growth,visible)
            tip=meadow_blade_response(1,growth,visible)
            assert(abs(mix(root,tip,mix(0.75,visible,growth))-1.0)<0.00001)
            assert(root>0.7 and tip<1.3 and root<=tip)

test "the wind study's layers each travel at their own speed and direction":
    loop speed in [3.0,8.0,20.0]:
        meadow_state=MeadowPhase(vec2(0,0),vec2(0,0),vec2(0,0),vec2(1,0),speed)
        meadow_step(Wind(dir=vec2(1,0),speed=speed),0,0,1.0)
        c=meadow_travel(speed)
        m=meadow_state
        assert(abs(f64(m.sa.x)-c*1.3)<0.001 and abs(f64(m.sb.x)-c*1.05)<0.001)
        assert(abs(f64(m.r1.x)-c)<0.001 and m.r1.y==0.0)
        # the second dab layer runs 30 degrees off the wind, half as fast again
        assert(abs(f64(m.r2.x)-c*1.5*0.866)<0.002 and abs(f64(m.r2.y)-c*1.5*0.5)<0.002)
    # every study period divides the wrap, so wrapped offsets stay seamless
    loop period in [2016.0,1344.0,144.0,112.0]:
        assert(GUST_PERIOD/period==floor(GUST_PERIOD/period))

test "the wind study's noise tile is even and repeats across its edges":
    img=build_meadow_noise()
    n=MEADOW_NOISE_N
    assert(img.width==n and img.height==n)
    loop ch in 0..4:
        sum=0.0
        inner=0.0
        seam=0.0
        loop j in 0..n:
            loop i in 0..n:
                sum+=f64(img.get(i,j)[ch])
            inner+=abs(f64(img.get(n/2,j)[ch]-img.get(n/2-1,j)[ch]))
            seam+=abs(f64(img.get(0,j)[ch]-img.get(n-1,j)[ch]))
        mean=sum/f64(n*n)
        assert(abs(mean-0.5)<0.03)
        # the step across the tile's edge is no bigger than a step inside it
        assert(seam<inner*2.0+0.5)

use '../src/canopy.jo'
test "blades stand in the ground's own field colour":
    # The working channel under a cell is the terrain's own samples blended across it (RGBA bytes, as the
    # mainland's tiles keep them): four corners of different fields catch a nearest or a recomputed colour.
    bytes:u8[]=[200,160,90,220, 90,130,70,220, 60,110,60,0, 180,150,80,110]
    got=grass_working_bytes(bytes,2,vec2(0.25,0.75))
    expected=mix(mix(vec4(200,160,90,220),vec4(90,130,70,220),0.25),mix(vec4(60,110,60,0),vec4(180,150,80,110),0.25),0.75)/255.0
    assert(length(got-expected)<0.00001)
    assert(length(grass_working_bytes(bytes,2,vec2(0,0))-vec4(200,160,90,220)/255.0)<0.00001)
    # An island tile: the grass works out the tile's samples again from the bytes the terrain keeps, by the
    # function the terrain's working texture is baked with, and blends them the same way.
    previous=terrain_tiles
    heights:f32[]=[20,21,22, 20,22,24, 21,23,25]
    materials:u8[]=[]
    loop k in 0..9:
        materials.extend([u8(128),u8(128+k),u8(126),u8(40+k*20),u8(128)])
    terrain_tiles=[TerrainTile(700.0,-1400.0,Texture(0,3,3),Texture(0,3,3),[],heights,materials)]
    loop j in 0..3:
        loop i in 0..3:
            k=(j*3+i)*5
            baked=island_working_sample(materials[k+1],materials[k+2],materials[k+3],heights[j*3+i],vec2(f32(700.0+f64(i)*14.0),f32(-1400.0+f64(j)*14.0)))
            assert(length(island_working_at(terrain_tiles[0],i,j)-baked)<1.0/255.0+0.00001)
    a=island_working_at(terrain_tiles[0],0,0);b=island_working_at(terrain_tiles[0],1,0)
    c=island_working_at(terrain_tiles[0],0,1);d=island_working_at(terrain_tiles[0],1,1)
    assert(length(grass_working(700.0,-1400.0)-a)<0.00001)
    assert(length(grass_working(707.0,-1400.0)-(a+b)*0.5)<0.00001)
    assert(length(grass_working(707.0,-1393.0)-(a+b+c+d)*0.25)<0.00001)
    # (some of these samples are fields: the test would pass on an empty tile otherwise)
    assert(a.w+b.w+c.w+d.w>0.5)
    # 196 cells share each sample: a metre-by-metre field works each out once
    before=grass_work_misses
    loop z in 0..14:
        loop x in 0..14: _=grass_working(700.5+f64(x),-1399.5+f64(z))
    assert(grass_work_misses-before<=4)
    terrain_tiles=previous
    # The blades are painted with the ground's own canopy: the same grove uniform, its paint on.
    assert(grass_grove(vec3(40,0,32))==grove_islands() and grove_islands().w==1.0)

test "a blade's own colour varies about the ground's and is the ground's at the rim":
    loop patch in [0.0,0.5,1.0]:
        sum=vec3(0,0,0)
        loop k in 0..400:
            pick=hash21(vec2(f32(k),7))
            # at the rim (keep 0) a blade coming in is the ground's colour exactly, whatever its own
            assert(grass_blade_tone(pick,patch,1.0,0.0)==vec3(1,1,1))
            tone=grass_blade_tone(pick,patch,0.0,1.0)
            sum+=tone
            assert(tone.x>0.8 and tone.x<1.22 and tone.y>0.82 and tone.y<1.18 and tone.z>0.78 and tone.z<1.2)
        # blade to blade the colour varies, but a clump's mean is its tint: the field does not drift off the ground
        tint=mix(vec3(0.95,0.975,0.93),vec3(1.05,1.03,0.985),f32(patch))
        assert(length(sum/400.0-tint)<0.02)
    # the pocket of grass as a mound: its sunward side lighter, the far side darker, evenly
    lit=grass_blade_tone(0.5,0.5,1.0,1.0);dark=grass_blade_tone(0.5,0.5,-1.0,1.0);level=grass_blade_tone(0.5,0.5,0.0,1.0)
    assert(lit.y>level.y*1.08 and dark.y<level.y*0.92 and abs(lit.y+dark.y-2.0*level.y)<0.0001)

test "a blade's base turns to face the viewer about its upright axis":
    across=vec2(0.6,0.8)
    loop k in 0..72:
        angle=f64(k)*TAU/72.0+0.01
        own=vec2(f32(cos(angle)),f32(sin(angle)))
        loop turn in [0.5,1.0,1.6]:
            faced=grass_facing(own,across,f32(turn))
            assert(abs(length(faced)-1.0)<0.0001)
            # the two base vertices (own and its reverse) stay opposite each other: one base, rooted in place
            assert(length(faced+grass_facing(-own,across,f32(turn)))<0.0001)
            # it faces the viewer to within atan(turn/2): never edge-on, never quite square to every camera
            off=acos(clamp(f64(abs(dot(faced,across))),0.0,1.0))
            assert(off<=atan(turn*0.5)+0.0001)
            # and turns less than the camera does: it hangs back toward its own heading
            assert(dot(faced,own)*dot(faced,across)*dot(own,across)>=-0.0001)
    # a blade that would be edge-on, or already faces, comes round square to the view
    assert(abs(abs(dot(grass_facing(vec2(-0.8,0.6),across,1.6),across))-1.0)<0.0001)
    assert(abs(dot(grass_facing(across,across,1.6),across)-1.0)<0.0001)
    # no jump as the view swings past edge-on: the base on either side of it is the same line
    near=grass_facing(normalize(vec2(-0.8,0.6)+across*0.001),across,1.0)
    far=grass_facing(normalize(vec2(-0.8,0.6)-across*0.001),across,1.0)
    assert(abs(dot(near,far))>0.9999)
    # most blades face, some keep their own heading (and may be caught on edge)
    assert(GRASS_FACING_SHARE>0.75 and GRASS_FACING_SHARE<0.95)

test "the blade's spring overshoots past its rest and settles":
    # the constants follow from the spring's frequency and damping
    z=MEADOW_BLADE_DAMPING
    assert(abs(f64(MEADOW_REBOUND)-exp(-PI*z/sqrt(1.0-z*z)))<0.001)
    assert(z<0.5 and MEADOW_REBOUND>0.3)
    half=1.0/(2.0*MEADOW_BLADE_HZ*sqrt(1.0-z*z))
    assert(abs(f64(MEADOW_TAP_LATE-MEADOW_TAP_EARLY)-half)<0.002)
    # in a steady wind the blade lies where the wind holds it
    loop held in [0.0,0.3,1.0]: assert(abs(meadow_sprung(f32(held),f32(held))-f32(held))<0.00001)
    # A dab passes over a blade: the drive rises to 1, holds and lets go (a raised cosine each way, 0.35 s).
    # The shader reads the drive now and its rate; a real spring is integrated from the same drive.
    x=0.0;vel=0.0;w=TAU*MEADOW_BLADE_HZ
    low=1.0;low_at=0.0;high=0.0;ode_low=1.0;ode_low_at=0.0;ode_high=0.0;last=1.0
    dt=1.0/480.0
    loop step in 0..480*4:
        t=f64(step)*dt
        # the noise the dab's threshold reads: from 0.4 up to 0.8 and back
        phase=if t<0.5:0.0 else:if t<0.85:(t-0.5)/0.35 else:if t<1.6:1.0 else:if t<1.95:1.0-(t-1.6)/0.35 else:0.0
        slope=if t>=0.5 and t<0.85:1.0/0.35 else:if t>=1.6 and t<1.95:-1.0/0.35 else:0.0
        m=0.4+0.4*(0.5-0.5*cos(PI*phase))
        rate=0.4*0.5*PI*sin(PI*phase)*slope
        drive=smoothstep(0.49,0.71,m)
        got=f64(meadow_sprung(f32(smoothstep(0.49,0.71,f64(meadow_past(f32(m),f32(rate),MEADOW_TAP_EARLY,1.0)))),f32(smoothstep(0.49,0.71,f64(meadow_past(f32(m),f32(rate),MEADOW_TAP_LATE,1.0))))))
        vel+=(w*w*(drive-x)-2.0*z*w*vel)*dt;x+=vel*dt
        high=max(high,got);ode_high=max(ode_high,x)
        if got<low:low=got;low_at=t
        if x<ode_low:ode_low=x;ode_low_at=t
        last=got
    # thrown over further than it will lie as the dab arrives
    assert(high>1.15 and high<1.6 and abs(high-ode_high)<0.25)
    # past its rest on the way back, about as far and about when a real spring is, and it comes back to rest
    assert(low < -0.2 and low > -0.6)
    assert(abs(low-ode_low)<0.2)
    assert(abs(low_at-ode_low_at)<0.15 and low_at>1.6)
    assert(abs(last)<0.0001)
    # the look back is bounded: a steep slope in the noise cannot invent a gust that never was
    assert(abs(meadow_past(0.3,50.0,0.3,1.0)-0.0)<0.00001 and abs(meadow_past(0.3,-50.0,0.3,1.0)-0.6)<0.00001)

test "the dab tile holds the dabs' noise and its slope across the tile":
    img=build_meadow_dabs()
    n=MEADOW_NOISE_N
    assert(img.width==n and img.height==n)
    sum=0.0;clipped=0;agree_x=0.0;agree_y=0.0;power_x=0.0;power_y=0.0;slope_x=0.0;slope_y=0.0
    loop j in 0..n:
        loop i in 0..n:
            p=img.get(i,j)
            sum+=f64(p.x)
            if p.y<0.01 or p.y>0.99 or p.z<0.01 or p.z>0.99:clipped+=1
            # the slope channels against the noise's own differences three texels either side
            gx=f64(p.y-0.5)*f64(MEADOW_DAB_SLOPE);gy=f64(p.z-0.5)*f64(MEADOW_DAB_SLOPE)
            dx=f64(img.get((i+3)%n,j).x-img.get((i+n-3)%n,j).x)*f64(n)/6.0
            dy=f64(img.get(i,(j+3)%n).x-img.get(i,(j+n-3)%n).x)*f64(n)/6.0
            agree_x+=gx*dx;power_x+=dx*dx;slope_x+=gx*gx
            agree_y+=gy*dy;power_y+=dy*dy;slope_y+=gy*gy
    assert(abs(sum/f64(n*n)-0.5)<0.03)
    assert(clipped==0)
    assert(agree_x/sqrt(power_x*slope_x)>0.9 and agree_y/sqrt(power_y*slope_y)>0.9)
    # the same scale as the noise's own differences: a rate read from it is the noise's rate
    assert(slope_x/power_x>0.6 and slope_x/power_x<1.6 and slope_y/power_y>0.6 and slope_y/power_y<1.6)

