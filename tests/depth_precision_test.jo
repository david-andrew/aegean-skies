use '../src/depth_space.jo'
use '../src/sea.jo'

test "log depth retains half-metre sample ordering at the far horizon":
    loop distance in [100.0,1000.0,10000.0,50000.0,250000.0]:
        d=f32(distance)
        a=world_depth_encode(d);b=world_depth_encode(d+0.5)
        assert(b>a)
        assert(abs(f64(world_depth_decode(a,vec2(20,0)))-distance)<distance*0.000003)
        # Model the minimum WebGL2 24-bit depth attachment as well as f32.
        qa=round(f64(a)*16777215.0);qb=round(f64(b)*16777215.0)
        assert(qb>qa)

test "glint rejection cannot remove any reflecting facet":
    rejected=0
    loop k in 0..1200:
        a=f64(k)*2.399963229728653
        n=normalize(vec3(sin(a)*0.5,1,cos(a*1.3)*0.5))
        v=normalize(vec3(sin(a*0.7),0.01+f64(k%29)/29.0,cos(a*0.7)))
        l=normalize(vec3(sin(a*1.7),0.05+f64(k%17)/17.0,cos(a*1.7)))
        h=normalize(v+l)
        rough=f32(k%23)/22.0
        if sea_glint_possible(n,v,l,h,rough):continue
        rejected+=1
        loop x in [-0.5,-0.25,0.0,0.25,0.5]:
            loop z in [-0.5,-0.25,0.0,0.25,0.5]:
                tilt=vec3(f32(x),0,f32(z))*(0.22+0.45*rough)
                facet=normalize(n+tilt)
                assert(dot(reflect(-v,facet),l)<0.9945)
    assert(rejected>100)
    print("GLINT conservative rejection cases {rejected}/1200")

test "native reversed float depth retains half metre ordering across the whole world":
    loop distance in [0.035,0.1,1.0,100.0,10000.0,100000.0,500000.0,1000000.0]:
        near=f32(0.035);d=f32(distance)
        a=near/d;b=near/(d+0.5)
        assert(a>b)
        assert(abs(f64(world_depth_decode(a,vec2(near,-1)))-distance)<max(0.000001,distance*0.0000003))
    assert(not world_has_depth(0,vec2(0.035,-1)))
    assert(world_has_depth(0.0000001,vec2(0.035,-1)))


test "split depth orders both ranges and decodes the seam":
    ab=vec2(0.035,-2)
    prior=f32(-1)
    loop distance in [0.035,0.1,1.0,32.0,120.0,127.99,128.0,128.01,150.0,1000.0,10000.0,50000.0]:
        d=f32(distance);encoded=world_scene_depth_encode(d,ab)
        assert(encoded>prior);prior=encoded
        recovered=world_depth_decode(encoded,ab)
        assert(abs(f64(recovered)-distance)<max(0.00001,distance*0.0003))
    loop distance in [32.0,120.0,127.99,128.0,150.0,10000.0,50000.0]:
        a=world_scene_depth_encode(f32(distance),ab)
        b=world_scene_depth_encode(f32(distance+0.5),ab)
        assert(round(f64(b)*16777215)>round(f64(a)*16777215))
    assert(world_scene_depth_encode(127.999,ab)<0.5)
    assert(world_scene_depth_encode(128,ab)==0.5)

test "bounded near shader has no fragment depth override":
    source=ShaderSource()
    source.vs="void main() \{ gl_Position = vec4(1.0); }"
    source.fs="void main() \{ color = material(); }"
    near=bounded_depth_source(source)
    assert(near.fs==source.fs)
    assert("gl_Position.z = -0.035" in near.vs)
