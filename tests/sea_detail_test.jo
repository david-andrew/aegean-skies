use '../src/sea.jo'

test "painted sea detail retains its fair weather contrast at rest and speed":
    assert(abs(sea_detail_strength(50,0,0)-0.35)<0.00001)
    assert(abs(sea_detail_strength(50,1,0)-1.0)<0.00001)
    assert(abs(sea_detail_strength(50,0,1)-0.175)<0.00001)
    assert(sea_detail_strength(450,1,0)==0)

test "inland flecks retain the sea painter relative luminance without cyan stamping":
    sea=vec3(0.02,0.24,0.46);river=vec3(0.025,0.065,0.05);sky=vec3(0.31,0.72,0.80)
    l=vec3(0.2126,0.7152,0.0722)
    loop sign in [-1.0,1.0]:
        target=sea_fleck_color(sea,sky,f32(sign))
        result=water_fleck_relative_color(river,sea,target)
        assert(abs(dot(result,l)/dot(river,l)-dot(target,l)/dot(sea,l))<0.00001)
        assert(abs(result.x/river.x-result.z/river.z)<0.00001)

reference_fleck = (p: vec2, smear: vec2, size: f32, seed: f32, anchor: vec4) -> f32:
    best: f32 = 0.0
    loop k in 0..2:
        q = (p - smear * f32(k)) / size + anchor.xy
        cell = floor(q)+anchor.zw
        r1 = hash21(cell + vec2(41.0 + seed, 7.0))
        if r1 >= 0.6:
            r2 = hash21(cell + vec2(3.0, 59.0 + seed))
            r3 = hash21(cell + vec2(17.0 + seed, 23.0))
            # Centre relative to this sample; never form two huge positions
            # just to subtract them. The cell hash stays fixed across chart snaps.
            c = (vec2(0.25,0.25)+vec2(r2,r3)*0.5-fract(q))*size+smear*(1.0-f32(k))
            # (distance from the mark's center to the swept stretch)
            a = vec2(0,0)
            ab = smear
            t = clamp(dot(c - a, ab) / max(dot(ab, ab), 0.0001), 0.0, 1.0)
            d = length(c - (a + ab * t)) / size
            m = 1.0 - smoothstep(0.1, 0.17, d)
            v = if r1 > 0.82: m else: -m
            if abs(v) > abs(best): best = v
    best


test "speed fleck duplicate-cell rejection preserves the original swept circles":
    worst:f32=0.0
    loop origin in [vec2(0,0),vec2(-148000,-156000)]:
        loop size in [1.3,3.6,10.0]:
            anchor=sea_cell_anchor(origin,size)
            loop smear in [vec2(0,0),vec2(0.25,0),vec2(-0.65,0.8),vec2(1.5,-0.3)]:
                loop k in 0..2000:
                    p=vec2(f32(k%71)*0.631-21.0,f32(k/71)*0.719-12.0)
                    expected=reference_fleck(p,smear,f32(size),13,anchor)
                    actual=sea_fleck(p,smear,f32(size),13,anchor)
                    worst=max(worst,abs(actual-expected))
    print("fleck maximum arithmetic difference {worst}")
    assert(worst<0.0004)


test "advected inland pair shares hashes without changing either sea field":
    u=SeaParams()
    loop origin in [vec2(0,0),vec2(-148000,-156000)]:
        loop o in 0..3:u.mark_phase[o]=sea_cell_anchor(origin,[1.3,3.6,10.0][o])
        loop k in 0..4000:
            a=vec2(f32(k%101)*0.173-8.0,f32(k/101)*0.217-4.0)
            b=a+vec2(0.23,-0.17)
            smear=vec2(f32(k%13)*0.073,f32(k%17)*-0.031)
            dist=f32(k%450)
            pair=sea_marks_pair(a,b,smear,dist,u)
            assert(abs(pair.x-sea_marks(a,smear,dist,vec2(1,0),u))<0.00001)
            assert(abs(pair.y-sea_marks(b,smear,dist,vec2(1,0),u))<0.00001)
