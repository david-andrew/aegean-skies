use '../src/targets.jo'
use '../src/target_scene.jo'
use '../src/combat.jo'
use '../src/flight.jo'
use '../src/vessel_types.jo'
import '../src/living_types.jo' as data

test "shortlist is capped ranks threat before friends and keeps stable selection":
    items:ViewTarget[]
    loop i in 0..30:offer_target(items,ViewTarget(0,i,"Pilot",vec3(i,100,0),if i<10:2 else:0,f64(i)))
    assert(items.len()==6 and items[0].id==10)
    v=TargetView();refresh_targets(v,items);cycle_target(v);toggle_target(v)
    assert(v.selected==0 and v.looking)
    reversed=[items[2],items[0],items[1]]
    refresh_targets(v,reversed);assert(v.selected==1 and v.looking)
    refresh_targets(v,[items[2]]);assert(v.selected== -1 and not v.looking)
    refresh_targets(v,[]);cycle_target(v);toggle_target(v);assert(v.selected== -1 and not v.looking)

test "touch short tap cycles and long press only toggles":
    v=TargetView(items=[ViewTarget(0,1,"One",vec3(0,0,-10),0,0),ViewTarget(0,2,"Two",vec3(0,0,10),0,0)])
    target_touch(v,true,0.1);target_touch(v,false,0.01)
    assert(v.selected==0 and not v.looking)
    loop i in 0..60:target_touch(v,true,1.0/60.0)
    target_touch(v,false,0.01);assert(v.selected==0 and v.looking)
    target_touch(v,true,0.1);target_touch(v,false,0.01)
    assert(v.selected==1 and v.looking)

test "look direction crosses directly aft and hitches without changing normal view":
    v=TargetView(items=[ViewTarget(0,1,"Aft",vec3(0,0,100),0,0)],selected=0,looking=true)
    normal=vec3(0,0,-1)
    loop dt in [0.016,0.05,0.25,2.0,8.0]:
        step_target_view(v,vec3(0,0,0),normal,dt)
        result=blend_bearing(normal,v.bearing,v.weight)
        assert(is_finite(result.x) and abs(length(result)-1)<0.00001)
    assert(v.bearing.z>0.99)
    toggle_target(v);step_target_view(v,vec3(0,0,0),normal,8)
    assert(length(blend_bearing(normal,v.bearing,v.weight)-normal)<0.00001)

test "actual battle adapter prefers incoming enemy and excludes own and wrecked aircraft without dropping distant hostiles":
    spec=craft_spec(.gull,[])
    actors:Combatant[]
    loop i in 0..9:
        actors.push(Combatant(i,i,if i<2:0 else:1,spec,CraftState(position=vec3(i*100,400,0)),engagement=4))
    actors[3].pilot.target=0
    actors[4].status=.wreck;actors[5].state.position.x=6000
    b=Battle(enabled=true,actors=actors)
    items=view_candidates(data.World(player=0),b,[],VesselFleet(),vec3(0,400,0),0)
    assert(items.len()==7 and items[0].id==3 and items[0].hostile)
    loop item in items:assert(item.id!=0 and item.id!=4)
    assert(items[6].id==1 and not items[6].hostile)


test "combat cycling reaches every member of a 64 against 64 battle":
    k=craft_spec(.gull,[]);b=Battle(enabled=true)
    loop i in 0..128:
        b.actors.push(Combatant(i,i,if i<64:0 else:1,k,CraftState(position=vec3(i*100,400,0)),engagement=7))
    items=view_candidates(data.World(player=0),b,[],VesselFleet(),vec3(0,400,0),0)
    enemies=[loop item in items:if item.hostile:item.id]
    assert(enemies.len()==64)
    v=TargetView();refresh_targets(v,items);seen:int[]
    loop i in 0..items.len():cycle_target(v);seen.push(v.items[v.selected].id)
    loop id in enemies:assert(seen.contains(id))
