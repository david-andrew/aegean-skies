# The barber: his price moves by one transfer to the house, only while he works, a new shape costs
# more than a trim, and the pilot's style is kept with the game.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/barber.jo'
use '../src/game_session.jo'

_total = (w: World) -> int:
    t = 0
    loop a in w.accounts: t += a.cents
    t

_at = (w: mut World, local: int):
    # (move the clock on to that local time)
    now = local_minute(w.minute)
    advance_minutes(w, ((local - now) % 1440 + 1440) % 1440)

test "a shave costs the trim's price, a new shape more, by one transfer to the house":
    w = build_world(u64(3))
    _at(w, 600)
    keeper = 6
    total = _total(w); mine = w.accounts[w.people[w.player].account].cents; theirs = w.accounts[w.people[keeper].account].cents
    a = barber_pay(w, keeper, 1, 1)
    assert(a.ok and a.cents == BARBER_SHAVE_CENTS)
    b = barber_pay(w, keeper, 1, 2)
    assert(b.ok and b.cents == BARBER_STYLE_CENTS and BARBER_STYLE_CENTS > BARBER_SHAVE_CENTS)
    assert(w.accounts[w.people[w.player].account].cents == mine - a.cents - b.cents)
    assert(w.accounts[w.people[keeper].account].cents == theirs + a.cents + b.cents)
    assert(_total(w) == total)

test "the chair is empty out of hours, and nothing is paid":
    w = build_world(u64(3))
    _at(w, 1260)
    total = _total(w); mine = w.accounts[w.people[w.player].account].cents
    r = barber_pay(w, 6, 1, 0)
    assert(not r.ok and w.accounts[w.people[w.player].account].cents == mine and _total(w) == total)

test "he says something for every style, and talks while he works":
    w = build_world(u64(3))
    loop from in 0..4:
        assert(barber_greeting(from, 3) != "")
        loop to in 0..4: assert(barber_style_words(from, to) != "")
    loop n in 0..6: assert(barber_chat(w, 0, n) != "")

test "the pilot's style is kept with the game":
    s = GameSession(mustache = 2)
    back = from_text[GameSession](to_text(s))
    assert(back is GameSession)
    if back is GameSession: assert(back.mustache == 2)
    old = from_text[GameSession](to_text(GameSession()))
    if old is GameSession: assert(old.mustache == 1)
