import '../src/living_seed.jo' as seed
import '../src/living_types.jo' as lt
import '../src/living_boats.jo' as boats

assert(load_land(embed('../assets/terrain.bin')))

test "workboats follow existing routine trips and physical harm suspends their abstract motion":
    w = seed.build_world()
    w.minute = 340-lt.EPOCH_LOCAL_MINUTE; w.tick = w.minute*120
    trip = boats.begin_fishing(w,7)
    assert(trip >= 0)
    f = VesselFleet(); binding = VesselBindings(); before = hash(w)
    sync_workboat_vessels(f,binding,w,1.0/60.0)
    assert(hash(w) == before and f.ships.len() == 1)
    assert(f.ships[0].external and f.ships[0].crew == [7] and f.ships[0].source_trip == trip)
    assert(f.ships[0].side == 100+max(0,w.people[7].faction))
    pos = f.ships[0].position
    step_vessels(f,vec2(8,0),10)
    assert(f.ships[0].position == pos)
    w.tick += 120; boats.advance_workboats(w); sync_workboat_vessels(f,binding,w,1.0/60.0)
    assert(f.ships[0].position.xz == w.people[7].pose.pos.xz and f.ships[0].position != pos)
    damage_vessel(f,f.ships[0].id,1.0,999,true)
    sync_workboat_vessels(f,binding,w,1.0/60.0)
    held = w.people[7].pose.pos; w.tick += 120; boats.advance_workboats(w)
    assert(w.people[7].move_owner == .scene and w.people[7].pose.pos == held)

test "combat targets rotate with hulls and externally owned boats integrate exactly once":
    f = VesselFleet()
    assert(spawn_vessel(f,Vessel(id=81,kind=.tramp_freighter,owner=9,side=1,position=vec3(0,0,-20000),velocity=vec3(4,0,0),yaw=PI/2,status=.underway,external=true)))
    b = Battle(enabled=true); binding = VesselBindings()
    publish_vessel_targets(f,b,binding,vec3(0,0,-20000))
    pos = b.boats[0].position
    step_battle(b,FlightEnv(),vec3(0,0,-20000))
    assert(b.boats[0].position == pos)
    assert(vessel_segment_hit(f.ships[0],vec3(35,2,-20020),vec3(35,2,-19980)) <= 1.0)
    assert(vessel_segment_hit(f.ships[0],vec3(0,2,-20035),vec3(0,2,-20020)) > 1.0)
    b.boats[0].health = 0.4; b.boats[0].attacker = 12
    receive_vessel_hits(f,b,binding)
    assert(abs(f.ships[0].health-0.4) < 0.001 and f.ships[0].attacker == 12)
    publish_vessel_targets(f,b,binding,vec3(0,0,-20000))
    assert(b.boats.len() == 1 and abs(b.boats[0].health-0.4) < 0.001)

test "mooring is beside a slow large vessel and releases when it departs":
    f = VesselFleet()
    assert(spawn_vessel(f,Vessel(id=7,kind=.seaplane_tender,owner=3,side=1,position=vec3(0,0,-20000),status=.anchored)))
    aircraft = CraftState(position=vec3(16.1,2,-20000),on_water=true)
    m = find_vessel_mooring(f,aircraft,12)
    assert(m != none and m!.vessel == 7)
    point = vessel_mooring_point(f,m!,12)
    assert(point != none and point!.x > vessel_spec(.seaplane_tender).beam*0.5+6)
    f.ships[0].speed = 4
    assert(vessel_mooring_point(f,m!,12) == none)


test "fast seaplane contact uses the swept entry normal rather than the exit side":
    f = VesselFleet()
    assert(spawn_vessel(f,Vessel(7,.tramp_freighter,3,1,position=vec3(0,0,-20000),status=.anchored)))
    model = build_craft(.gull,LIVERIES[0]); spec = craft_spec(.gull,model.contacts)
    aircraft = CraftState(position=vec3(20,2,-20000),velocity=vec3(80,0,0),on_water=true)
    collide_vessels(f,spec,aircraft,vec3(-20,2,-20000),9)
    assert(aircraft.position.x < 0 and aircraft.velocity.x < 20 and aircraft.hull_damage > 0)
    assert(f.ships[0].health < 1 and f.ships[0].attacker == 9)

import '../src/traffic.jo' as air
import '../src/living_scene.jo' as scene

test "NPC hull contacts commit once through passive and combat scene ownership":
    kinds = [Craft.gull,Craft.heron,Craft.corsair,Craft.falco,Craft.gull,Craft.gull,Craft.heron,Craft.gull,Craft.heron,Craft.gull,Craft.falco,Craft.corsair]
    models = [loop kind in kinds: build_craft(kind,LIVERIES[0])]
    loop enabled in [false,true]:
        w = seed.build_world(); traffic = air.make_living_traffic(w,models)
        adapter = scene.SceneAdapter(); battle = Battle(enabled=enabled)
        old_hull = w.aircraft[1].hull
        air.update_traffic(traffic,w,adapter,w.harbors[0].center,0,1.0/60.0,battle=battle,
            contact=(id: int,spec: CraftSpec,state: CraftState,previous: vec3) -> CraftState:
                result = state
                if id == 1:
                    result.damage.parts[0].health = min(result.damage.parts[0].health,0.5)
                    refresh_damage(spec,result)
                result
        )
        assert(w.tick == 1 and w.aircraft[1].hull < old_hull)
        assert(air.traffic_for_craft(traffic,1)!.combat_damage)


test "submerged sinking hulls no longer obstruct aircraft on the surface":
    ship = Vessel(7,.tramp_freighter,3,1,position=vec3(0,0,-20000),status=.sinking,sink_age=60)
    assert(vessel_segment_hit(ship,vec3(-20,2,-20000),vec3(20,2,-20000)) > 1)
