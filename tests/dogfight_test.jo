use '../src/combat.jo'
use '../src/flight.jo'
use '../src/planes.jo'

# The dogfight brain's behaviours, each set up in the open sky over a flat sea.
env = () -> FlightEnv: FlightEnv(ground=(x:f64,z:f64)->f64:0.0)

pilot_at = (id: int, side: int, at: vec3, heading: f64, pilot: CombatPilot) -> Combatant:
    k = craft_spec(.gull,[])
    s = CraftState(position=at,orientation=quat_euler(0,-heading,0),velocity=heading_vector(heading)*f32(k.cruise_speed*0.9),throttle=0.8,fuel=k.fuel_capacity)
    Combatant(id,id,side,k,s,pilot=pilot)

run = (b: mut Battle, ticks: int) -> CombatMode[]:
    seen: CombatMode[]
    loop _ in 0..ticks:
        step_battle(b,env(),vec3(0,600,0))
        m = b.actors[0].pilot.mode
        if seen.len() == 0 or seen[seen.len()-1] != m: seen.push(m)
    seen

test "an attacker on the tail draws a break into it, after a reaction time":
    me = pilot_at(1,1,vec3(0,800,0),0.0,CombatPilot(skill=0.9,caution=0.5))
    # (an enemy 250 m behind and a little to the right, nose on)
    foe = pilot_at(2,2,vec3(40,800,250),0.0,CombatPilot(skill=0.5))
    foe.gun.locked = true
    b = start_engagement(1,7,vec3(0,800,0),[me,foe])
    b.actors[1].pilot.target = 0
    seen = run(b,40)
    assert(seen.contains(.break_turn),"modes {seen}")
    assert(b.actors[0].pilot.turn > 0,"broke away from the attacker's side")

test "head-on: held by nerve, then broken off, never flown into":
    bold = pilot_at(1,1,vec3(0,800,800),0.0,CombatPilot(skill=0.8,aggression=0.95,caution=0.1))
    shy = pilot_at(2,2,vec3(5,800,-800),PI,CombatPilot(skill=0.8,aggression=0.2,caution=0.9))
    b = start_engagement(1,7,vec3(0,800,0),[bold,shy])
    closest = 1e9; broke = [-1.0,-1.0]
    loop _ in 0..60*14:
        step_battle(b,env(),vec3(0,800,0))
        d = f64(length(b.actors[0].state.position-b.actors[1].state.position))
        closest = min(closest,d)
        loop k in 0..2:
            if broke[k] < 0 and b.actors[k].pilot.mode == .break_turn: broke[k] = d
    assert(closest > 15.0,"they nearly collided: {closest:.1} m")
    # (the cautious one breaks further out; the bold one later, or not at all once the other's break
    # has taken it off the collision course)
    assert(broke[1] > 0 and (broke[0] < 0 or broke[1] > broke[0]),"the cautious one breaks further out: {broke}")

test "a fast overshoot on a turning target is flown as lag pursuit":
    me = pilot_at(1,1,vec3(70,800,230),0.0,CombatPilot(skill=0.9,aggression=0.3))
    me.state.velocity *= 1.8
    foe = pilot_at(2,2,vec3(0,800,0),0.0,CombatPilot(skill=0.5,simple=true))
    foe.state.angular_velocity = vec3(0,0.6,0)
    b = start_engagement(1,7,vec3(0,800,0),[me,foe])
    b.actors[0].pilot.target = 1
    seen = run(b,30)
    assert(seen.contains(.lag) or seen.contains(.breakaway),"modes {seen}")

test "pursuit down toward the sea pulls out with room to spare":
    me = pilot_at(1,1,vec3(0,500,0),0.0,CombatPilot(skill=0.4,aggression=0.9))
    me.state.orientation = quat_euler(-0.6,0,0); me.state.velocity = quat_rotate(me.state.orientation,vec3(0,0,-1))*f32(me.spec.cruise_speed)
    foe = pilot_at(2,2,vec3(0,40,-600),0.0,CombatPilot(skill=0.5,simple=true))
    b = start_engagement(1,7,vec3(0,300,0),[me,foe])
    lowest = 1e9
    loop _ in 0..60*20:
        step_battle(b,env(),vec3(0,300,0))
        lowest = min(lowest,f64(b.actors[0].state.position.y))
    assert(not b.actors[0].state.crashed and lowest > 25.0,"lowest {lowest:.0} m")

test "a wingman turns on the enemy behind its leader":
    leader = pilot_at(1,1,vec3(0,800,0),0.0,CombatPilot(skill=0.8))
    wing = pilot_at(3,1,vec3(-80,820,120),0.0,CombatPilot(skill=0.8,role=.wingman,wing=1))
    foe = pilot_at(2,2,vec3(10,800,300),0.0,CombatPilot(skill=0.5))
    far = pilot_at(4,2,vec3(3000,800,-3000),0.0,CombatPilot(skill=0.5))
    b = start_engagement(1,7,vec3(0,800,0),[wing,leader,foe,far])
    b.actors[0].pilot.target = 3
    seen = run(b,30)
    assert(b.actors[0].pilot.target == 2,"covering the leader: target {b.actors[0].pilot.target} modes {seen}")
