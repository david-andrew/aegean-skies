# Someone of a far town's crowd met by the pilot (src/ambient_crowd.jo, aegean.jo crowd_meet):
# they become one of the world's people where they stand, taken from the town's cohort with a share
# of its purse like any resident, in their own country's clothes, and they talk like anyone else.
use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_far_types.jo'
use '../src/living_seed.jo'
use '../src/living_place_context.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_people.jo'
use '../src/far_scene.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'
use '../src/living_conversation.jo'
use '../src/wardrobe.jo'
use '../src/crowd_figures.jo'
import '../src/townsfolk.jo' as tf

met_fixture = () -> World:
    w = build_world(u64(42))
    contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    venues = [LifeVenue(100,"test:market",.market,vec3(100,2,100)),LifeVenue(100,"test:home",.home,vec3(110,2,100)),LifeVenue(100,"test:square",.square,vec3(100,2,110)),LifeVenue(100,"test:quay",.quay,vec3(80,2,100))]
    contexts.push(LifePlaceContext(100,"Oria",2,100,vec3(100,2,100),venues=venues))
    assert(publish_place_contexts(w,1,contexts,[-1,-1,100]))
    assert(populate_settlement_economy(w,1,[FarPlaceSeed(100,40,2,3)],[]))
    w

met_of = (w: World, look: CrowdLook, ident: int, at: vec3) -> FarMet:
    role = [FarRole.keeper, FarRole.sailor, FarRole.clerk][look.role % 3]
    FarMet(far_met_name(w.seed,100,ident,look.country,look.woman),look.age,look.seed,look.country,role,at,vec3(1,0,0))

test "met in the crowd: one of the world's people where they stood, from the town's own cohort and purse":
    w = met_fixture(); population = far_population(w); cash = w.ledger.opening_cents
    households = w.accounts[w.far.districts[100].household_account].cents
    look = crowd_look(77, 3, 2)
    at = vec3(104,2,107)
    id = met_far_person(w,100,met_of(w,look,4242,at))
    assert(id >= 0)
    p = w.people[id]
    assert(p.far_home == 100 and p.citizenship == 2 and p.appearance_seed == look.seed and p.age == look.age)
    assert(length(p.pose.pos-at) < 0.001 and length(w.far.people[id].target-at) < 0.001)
    # (a woman's name for a woman, read back the way the town reads it)
    assert(tf.person_woman(p.name) == look.woman, p.name)
    assert(w.accounts[p.account].cents == households/40 and far_population(w) == population and w.ledger.opening_cents == cash)
    # (met again, by the same name: the same person, not a second one)
    assert(met_far_person(w,100,met_of(w,look,4242,at)) == id)
    assert(invariant_errors(w).len() == 0 and validate_save_world(w) == "")
    # (they look as they were drawn: the same outfit from what the world knows of them)
    assert(tf.person_outfit(p, 3000) == crowd_outfit(look))

test "those met don't take the working residents' places, and a town gives only so many names":
    w = met_fixture()
    loop k in 0..6:
        assert(met_far_person(w,100,met_of(w,crowd_look(5,k,2),1000+k,vec3(100,2,100+f32(k)))) >= 0)
    # (the trader, the farmer and the artisan are still promoted as before)
    assert(promote_far_person(w,100,.trader) >= 0 and promote_far_person(w,100,.farmer) >= 0 and promote_far_person(w,100,.artisan) >= 0)
    # (as many as the town has people of their country to give, up to FAR_MAX_MET)
    met = 6
    loop k in 6..FAR_MAX_MET + 4:
        if met_far_person(w,100,met_of(w,crowd_look(5,k,2),1000+k,vec3(100,2,100+f32(k)))) >= 0: met += 1
    assert(met <= FAR_MAX_MET and (met == FAR_MAX_MET or w.far.districts[100].workers[2] == 0), "{met} {w.far.districts[100].workers[2]}")
    assert(invariant_errors(w).len() == 0 and validate_save_world(w) == "")

test "someone met talks like anyone else and keeps their own day after":
    w = met_fixture()
    id = met_far_person(w,100,met_of(w,crowd_look(9,1,2),31,vec3(102,2,104)))
    w.people[0].pose.pos = w.people[id].pose.pos
    greeting = converse(w,id,0,.greeting)
    assert(greeting.text != "" and greeting.replies.len() >= 1)
    loop _ in 0..120: step_minute(w)
    assert(invariant_errors(w).len() == 0)
    restored = from_text[World](canonical_text(w)); assert(restored is World)

test "Orenthia's people wear their country's clothes; the uniformed and the flyers dress alike everywhere":
    loop d in 0..3:
        set_regional_dress(d)
        loop seed in 1..40:
            loop woman in [false, true]:
                home = outfit_for(.fisher, seed, 35, woman, 3000)
                east = outfit_for(.fisher, seed, 35, woman, 3000, 2)
                assert(home != east, "direction {d} seed {seed}")
                assert(outfit_for(.patrol, seed, 35, woman, 3000, 2) == outfit_for(.patrol, seed, 35, woman, 3000))
                assert(outfit_for(.courier, seed, 35, woman, 3000, 2) == outfit_for(.courier, seed, 35, woman, 3000))
                # (Kalyra and the archipelago as before)
                assert(outfit_for(.merchant, seed, 35, woman, 3000, 1) == outfit_for(.merchant, seed, 35, woman, 3000))
    # the sash direction: most men with a sash, most women with a long skirt
    set_regional_dress(0)
    sashes = 0; long = 0
    loop seed in 1..201:
        if outfit_for(.merchant, seed, 35, false, 3000, 2).sash.w > 0.0: sashes += 1
        if outfit_for(.merchant, seed, 35, true, 3000, 2).long_skirt: long += 1
    assert(sashes > 150 and long > 150, "{sashes} {long}")
    # the three directions differ from each other
    set_regional_dress(1); b = outfit_for(.clerk, 17, 35, false, 3000, 2)
    set_regional_dress(2); c = outfit_for(.clerk, 17, 35, false, 3000, 2)
    set_regional_dress(0); a = outfit_for(.clerk, 17, 35, false, 3000, 2)
    assert(a != b and b != c and a != c)
