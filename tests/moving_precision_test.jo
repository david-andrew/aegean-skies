use '../src/world_point.jo'
use '../src/world_particles.jo'
use '../src/flight.jo'

test "sub-centimetre aircraft motion survives all map corners and teleports":
    loop offset in [vec3(0,0,0),vec3(-240000,0,-190000),vec3(240000,0,-190000),vec3(-240000,0,190000),vec3(240000,0,190000)]:
        s=CraftState(position=offset,velocity=vec3(0.03,0,-0.02))
        loop i in 0..600:craft_advance(s,1.0/60.0)
        p=craft_point(s)
        assert(abs(p.x-f64(offset.x)-0.3)<0.000001)
        assert(abs(p.z-f64(offset.z)+0.2)<0.000001)
        s.position=vec3(13000,0,-170000)
        craft_advance(s,1.0/60.0)
        assert(abs(craft_point(s).x-13000.0005)<0.000001)

test "particle motion and ground contact are translation invariant":
    reference=WorldParticles(gravity=vec3(0,-1,0),drag=0.3)
    shifted=WorldParticles(gravity=reference.gravity,drag=reference.drag)
    a=WorldPoint(0.003,2,-0.007);b=WorldPoint(240000.003,2,-190000.007)
    reference.items.push(WorldParticle(world_vec(a),vec3(0.03,0,0.02),10,10,0.1,vec4(1,1,1,1),precise=a,published=world_vec(a),ready=true))
    shifted.items.push(WorldParticle(world_vec(b),vec3(0.03,0,0.02),10,10,0.1,vec4(1,1,1,1),precise=b,published=world_vec(b),ready=true))
    loop i in 0..120:
        update(reference,1.0/60.0);update(shifted,1.0/60.0)
        p=particle_point(reference.items[0]);q=particle_point(shifted.items[0])
        assert(abs(q.x-p.x-240000)<0.0000001 and abs(q.z-p.z+190000)<0.0000001)
        assert(p.y==q.y)

use '../src/pilot.jo'
use '../src/planes.jo'
use '../src/distant.jo'
use '../src/combat_trails.jo'

test "chase camera preserves slow aircraft motion at a far corner":
    a=Flyer(kind=.gull,model=0,spec=CraftSpec(),state=CraftState(position=vec3(0,5000,0),velocity=vec3(0.03,0,-0.02)))
    b=a;b.state.position=vec3(240000,5000,-190000)
    loop i in 0..300:
        craft_advance(a.state,1.0/60.0);craft_advance(b.state,1.0/60.0)
        chase(a,1.0/60.0);chase(b,1.0/60.0)
        assert(abs(b.cam_point.x-a.cam_point.x-240000)<0.00005 and abs(b.cam_point.z-a.cam_point.z+190000)<0.00005)
        assert(abs(b.cam_point.y-a.cam_point.y)<0.00005)
        assert(length(a.look-b.look)<0.00001)

test "engine propagation and Doppler retain slow motion after a long session":
    near:SoundSample[];far:SoundSample[]
    loop i in 0..200:
        t=f64(i)*0.05;p=WorldPoint(40+t*0.03,10,-8+t*0.02)
        near.push(SoundSample(p,100000000+t))
        far.push(SoundSample(WorldPoint(p.x+240000,p.y,p.z-190000),100000000+t))
    p,v,d,k=heard_from(near,WorldPoint(0,2,0),vec3(0,0,0),100000009.9)
    q,w,e,l=heard_from(far,WorldPoint(240000,2,-190000),vec3(0,0,0),100000009.9)
    assert(abs(d-e)<0.00001 and abs(k-l)<0.0000001)
    assert(length(v-w)<0.000001)
    assert(abs(v.x-0.03)<0.000001 and abs(v.z-0.02)<0.000001)

test "exhaust drift is independent of its geographic chart":
    a=BattleTrails();b=BattleTrails()
    a.ribbons.push(BattleRibbon(WorldPoint(0,5,0),WorldPoint(1,5,0),0,10,1,0,1))
    b.ribbons.push(BattleRibbon(WorldPoint(240000,5,-190000),WorldPoint(240001,5,-190000),0,10,1,0,1))
    loop i in 0..300:
        step_battle_trails(a,vec3(0.03,0,-0.02),1.0/60.0)
        step_battle_trails(b,vec3(0.03,0,-0.02),1.0/60.0)
        assert(abs(b.ribbons[0].a.x-a.ribbons[0].a.x-240000)<0.0000001)
        assert(abs(b.ribbons[0].a.z-a.ribbons[0].a.z+190000)<0.0000001)

use '../src/descent_view.jo'
use '../src/bailout.jo'
import '../src/living_conditions.jo' as conditions
import '../src/living_types.jo' as living

test "swimming and descent camera remain smooth at a far port":
    a=Descent(position=vec3(0,0,0),phase=.swimming)
    b=Descent(position=vec3(240000,0,-190000),phase=.swimming)
    ca=DescentCamera();cb=DescentCamera(eye=b.position)
    ground=(x:f64,z:f64)->f64:-10.0
    loop i in 0..300:
        step_descent(a,vec3(0.03,0,-0.02),ground,0,1.0/60.0)
        step_descent(b,vec3(0.03,0,-0.02),ground,0,1.0/60.0)
        update_descent_camera(ca,a,1.0/60.0,false,ground)
        update_descent_camera(cb,b,1.0/60.0,false,ground)
        assert(abs(descent_point(b).x-descent_point(a).x-240000)<0.000001)
        # FollowCamera works in a bounded 1024 m f32 chart (at most 0.12 mm/ulp).
        assert(abs(cb.point.x-ca.point.x-240000)<0.00025)
        assert(abs(cb.point.z-ca.point.z+190000)<0.00025)
        assert(abs(cb.point.y-ca.point.y)<0.000001)

test "weather interpolation and saved scene poses preserve the low part":
    p=WorldPoint(240000.003,2,-190000.007)
    pose=living.Pose();living.place_pose(pose,p)
    restored=from_text[living.Pose](to_text(pose))
    assert(restored is living.Pose)
    assert(living.pose_point(restored)==p)
    cell=living.Weather(center=vec2(240000,-190000),velocity_milli_m_per_minute=vec2(30,-20),precise=p,published=vec2(240000,-190000))
    q=conditions.weather_center(cell,1000.5)
    assert(abs(q.x-p.x-0.015)<0.0000001 and abs(q.z-p.z+0.01)<0.0000001)
