use '../src/world_point.jo'
use '../src/world_particles.jo'
use '../src/flight.jo'

test "sub-centimetre aircraft motion survives all map corners and teleports":
    loop offset in [vec3(0,0,0),vec3(-240000,0,-190000),vec3(240000,0,-190000),vec3(-240000,0,190000),vec3(240000,0,190000)]:
        s=CraftState(position=offset,velocity=vec3(0.03,0,-0.02))
        loop i in 0..600:craft_advance(s,1.0/60.0)
        p=craft_point(s)
        assert(abs(p.x-f64(offset.x)-0.3)<0.000001)
        assert(abs(p.z-f64(offset.z)+0.2)<0.000001)
        s.position=vec3(13000,0,-170000)
        craft_advance(s,1.0/60.0)
        assert(abs(craft_point(s).x-13000.0005)<0.000001)

test "particle motion and ground contact are translation invariant":
    reference=WorldParticles(gravity=vec3(0,-1,0),drag=0.3)
    shifted=WorldParticles(gravity=reference.gravity,drag=reference.drag)
    a=WorldPoint(0.003,2,-0.007);b=WorldPoint(240000.003,2,-190000.007)
    reference.items.push(WorldParticle(world_vec(a),vec3(0.03,0,0.02),10,10,0.1,vec4(1,1,1,1),precise=a,published=world_vec(a),ready=true))
    shifted.items.push(WorldParticle(world_vec(b),vec3(0.03,0,0.02),10,10,0.1,vec4(1,1,1,1),precise=b,published=world_vec(b),ready=true))
    loop i in 0..120:
        update(reference,1.0/60.0);update(shifted,1.0/60.0)
        p=particle_point(reference.items[0]);q=particle_point(shifted.items[0])
        assert(abs(q.x-p.x-240000)<0.0000001 and abs(q.z-p.z+190000)<0.0000001)
        assert(p.y==q.y)
