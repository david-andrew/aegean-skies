use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_displacement.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_checks.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

test "displaced households pay real passage carry their money and arrive with their citizenship":
    w=commission_fixture(); w.far.districts[100].controller=2; w.far.districts[200].controller=1
    before=stock_totals(w); cash=w.ledger.opening_cents
    source=w.far.districts[100].workers[1]+w.far.districts[100].dependents[1]
    target=w.far.districts[200].workers[1]+w.far.districts[200].dependents[1]
    assert(evacuate_households(w,100,0,0))
    id=w.far.vehicles[0].journey; j=w.far.journeys[id]
    assert(j.duty==.refugee and j.refugees[1]==6 and j.refugees[0]==0 and j.refugees[2]==0)
    assert(w.far.districts[100].workers[1]+w.far.districts[100].dependents[1]==source-6)
    assert(far_population(w)==w.far.opening_population and stock_totals(w)==before and w.ledger.opening_cents==cash)
    text=canonical_text(w); restored=from_text[World](text); assert(restored is World and canonical_text(restored)==text)
    assert(validate_far(w)=="" and money_balances(w) and goods_balance(w))
    w.tick+=6000; w.minute=w.tick/120
    far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==200 and not (id in w.far.journeys))
    assert(w.far.districts[200].workers[1]+w.far.districts[200].dependents[1]==target+6)
    assert(w.far.districts[200].pending_workers[1]==3)
    assert(w.accounts[j.passenger_account].cents==0)
    # Adults cannot produce twice during one staggered work hour after migration.
    actual=w.far.districts[200].workers[1]
    far_work_hour(w,200); assert(w.far.districts[200].workers[1]==actual)
    w.minute=60; w.tick=7200
    far_work_hour(w,200); assert(w.far.districts[200].workers[1]==actual+3)
    assert(far_population(w)==w.far.opening_population and far_stock_errors(w).len()==0)

test "an unsafe destination unavailable carrier or unfunded passage leaves no partial migration":
    w=commission_fixture(); before=canonical_text(w)
    assert(not evacuate_households(w,100,0,0) and canonical_text(w)==before)
    w.far.districts[100].controller=2
    before=canonical_text(w)
    assert(not evacuate_households(w,100,0,0) and canonical_text(w)==before)
    w.far.districts[200].controller=1
    account=w.far.districts[100].household_account
    # Empty its purse by a real transfer; never alter the opening ledger for this refusal.
    amount=w.accounts[account].cents
    assert(transfer(w,account,w.far.treasury[1],amount,.rent))
    before=canonical_text(w)
    assert(not evacuate_households(w,100,0,0) and canonical_text(w)==before)

test "passenger admission includes the carrier's own provisioning before removing households":
    w=commission_fixture(); w.far.districts[100].controller=2; w.far.districts[200].controller=1
    # Leave enough for passengers alone but not for both crew and passengers.
    keep=504
    qty=far_market_qty(w,100,3)-keep
    batch=far_take_market(w,100,3,qty); far_use(w,batch)
    before=canonical_text(w)
    assert(not evacuate_households(w,100,0,0))
    assert(canonical_text(w)==before and far_population(w)==w.far.opening_population)
