use '../src/living_types.jo'
use '../src/living_far_people.jo'
use '../src/living_far_aircraft.jo'
use '../src/living_far_types.jo'
use '../src/living_money.jo'
use '../src/living_checks.jo'
use '../src/living_save.jo'
use '../src/living_far_stock.jo'
use 'living_commissions.jo'

test "capital racers reserve two actual pilot slots buy existing parts and share world tanks":
    w=commission_fixture(); cash=w.ledger.opening_cents; population=w.far.opening_population
    # Households can fund a club only out of their own existing purse.
    funder=w.far.districts[100].household_account
    assert(far_produce(w,100,5,2000)) # explicit fixture production, owned before registration
    a=register_far_aircraft(w,100,.minnow,funder,"club:100:0")
    assert(a.error=="",a.error)
    b=register_far_aircraft(w,100,.minnow,funder,"club:100:0")
    assert(a==b and w.aircraft.len()==9 and w.far.opening_population==population,"a={a} b={b} aircraft={w.aircraft.len()} pop={w.far.opening_population}/{population}")
    assert(w.aircraft[a.craft].fuel_ml==0 and w.people[a.person].craft==a.craft)
    before=stock_totals(w)
    fuel=fill_far_tank(w,a.craft,100,10000,funder)
    assert(fuel>0 and w.aircraft[a.craft].fuel_ml==fuel)
    assert(stock_totals(w)==before and w.ledger.opening_cents==cash)
    errors=invariant_errors(w); assert(errors.len()==0,errors.join("; "))
    assert(validate_save_world(w)=="")
    text=canonical_text(w); again=from_text[World](text)
    assert(again is World and canonical_text(again)==text)

test "two pilot slots coexist with three local workers and reject a third aircraft atomically":
    w=commission_fixture(); funder=w.far.districts[100].household_account
    w.far.harbors[100].docks.push(vec3(100,0,60)); w.far.harbors[100].quays.push(vec3(100,2,50))
    assert(far_produce(w,100,5,4000))
    a=register_far_aircraft(w,100,.minnow,funder,"club:0")
    b=register_far_aircraft(w,100,.minnow,funder,"club:1")
    assert(a.error=="" and b.error=="",a.error+" / "+b.error)
    loop role in [FarRole.trader,FarRole.farmer,FarRole.artisan]: assert(promote_far_person(w,100,role)>=0)
    assert(w.far.districts[100].named.len()==5)
    before=canonical_text(w)
    refused=register_far_aircraft(w,100,.minnow,funder,"club:2")
    assert(refused.craft<0 and canonical_text(w)==before)
    assert(validate_save_world(w)=="")
