use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/ambient_crowd.jo'
use '../src/quality.jo'
use '../src/walk_shapes.jo'

test "a capital's crowd stands and walks clear of its buildings, thins at night and by tier":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    init_settlements(false,true);finish_settlement_registry()
    towns=[loop s in SETTLEMENTS: build_town(s)]
    index=-1
    loop k in 0..world_settlements.len():
        if world_settlements[k].name=="Kalyrassa":index=k
    assert(index>=0)
    town=ambient_layout(index)
    loop town.routes.len()>0:ambient_layout_step(town)
    walk_publish("ambient-crowd",[])        # (their own solids aside: the town's buildings only)
    sitting=0;pairs=0;strollers=0;vendors=0
    loop f in town.figures:
        match f.kind:
            .sit:sitting+=1
            .pair:pairs+=1
            .stroll:strollers+=1
            .vendor:vendors+=1
    assert(sitting>=2 and pairs>=6 and strollers>=12 and vendors>=1,"{sitting} {pairs} {strollers} {vendors}")
    # (nobody stands inside a house: what a walker can't stand on, neither can they)
    inside=(p:vec3)->bool:
        at=p.xz
        length(town_avoid_buildings(towns,at,f64(p.y)+0.5)-at)>0.3
    loop f in town.figures:
        if f.kind==.pair or f.kind==.vendor:assert(not inside(f.at),"{f.kind} at {f.at}")
    loop path in town.paths:
        assert(path.pts.len()>=2 and path.length>5.0)
        loop k in 0..path.pts.len():
            if k%3==0:assert(not inside(path.pts[k]),"path point {path.pts[k]}")
    # the evening walk is busier than the small hours; low quality shows fewer
    assert(ambient_density(19.0)>ambient_density(14.0) and ambient_density(14.0)>ambient_density(3.0))
    assert(ambient_density(3.0)<0.1)
    render_quality.tier=0;low=ambient_tier_share()
    render_quality.tier=2;high=ambient_tier_share()
    assert(low<high)

test "a stroller walks its loop at its pace, facing the way it goes":
    p=AmbientPath(pts=[vec3(0,0,0),vec3(1,0,0),vec3(2,0,0),vec3(3,0,0)],length=3.0)
    a=ambient_along(p,1.5)
    assert(abs(f64(a.0.x)-1.5)<0.01 and abs(a.1-PI/2)<0.01)
    b=ambient_along(p,4.5)
    assert(abs(f64(b.0.x)-1.5)<0.01 and abs(b.1+PI/2)<0.01)
