# Elevated flowing water must retain ocean flight behavior under translation.
import '../src/flight.jo' as fl
import '../src/planes.jo' as planes

test "elevated water floats settle and follow local current":
    model = planes.build_craft(planes.Craft.gull, planes.LIVERIES[0])
    k = fl.craft_spec(planes.Craft.gull, model.contacts)
    e = fl.FlightEnv(has_swell = true, swell_ceiling = 80.0,
        swell = (x: f64, z: f64) -> vec3: vec3(80, 0, 0),
        ground = (x: f64, z: f64) -> f64: 72.0,
        current_at = (x: f64, z: f64) -> vec3: vec3(0.8, 0, 0))
    s = fl.water_start(k, vec3(0, 80, 0))
    loop i in 0..600: fl.step(k, s, fl.Controls(), e, 1.0 / 30.0)
    assert(s.on_water and not s.crashed)
    assert(abs(f64(s.position.y) - 80.0 - k.float_height) < 0.08)
    assert(s.position.x > 8 and s.velocity.x > 0.6)

test "elevated water takeoff stays in takeoff phase until clear":
    model = planes.build_craft(planes.Craft.gull, planes.LIVERIES[0])
    k = fl.craft_spec(planes.Craft.gull, model.contacts)
    e = fl.FlightEnv(has_swell = true, swell_ceiling = 80.0,
        swell = (x: f64, z: f64) -> vec3: vec3(80, 0, 0),
        ground = (x: f64, z: f64) -> f64: 72.0)
    s = fl.water_start(k, vec3(0, 80, 0))
    plan = fl.FlightPlan()
    airborne = false
    loop i in 0..2250:
        c = fl.autopilot(k, s, plan, e)
        fl.step(k, s, c, e, 1.0 / 30.0)
        if not s.on_water and s.position.y > 80 + k.float_height + 3:
            airborne = true; break
    assert(airborne and not s.crashed and s.hull_damage == 0)

test "elevated water landing settles and taxi rudder turns":
    model = planes.build_craft(planes.Craft.gull, planes.LIVERIES[0])
    k = fl.craft_spec(planes.Craft.gull, model.contacts)
    e = fl.FlightEnv(has_swell = true, swell_ceiling = 80.0,
        swell = (x: f64, z: f64) -> vec3: vec3(80, 0, 0),
        ground = (x: f64, z: f64) -> f64: 72.0)
    s = fl.CraftState(position = vec3(0, 80 + k.float_height + 3, 0),
        velocity = vec3(0, -0.6, -k.stall_speed * 1.15),
        orientation = quat_euler(-0.02, 0, 0), fuel = k.fuel_capacity)
    loop i in 0..900: fl.step(k, s, fl.Controls(assist = 0.0, water_brake = 0.4), e, 1.0 / 30.0)
    assert(s.on_water and not s.crashed and s.hull_damage < 0.05)
    assert(abs(f64(s.position.y) - 80.0 - k.float_height) < 0.15)
    s.velocity = vec3(0, 0, -4)
    loop i in 0..450: fl.step(k, s, fl.Controls(throttle = 0.17, yaw = 0.6), e, 1.0 / 30.0)
    assert(abs(fl.heading(s)) > 0.5 and s.on_water and not s.crashed)
