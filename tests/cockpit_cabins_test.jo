use '../src/cockpit_cabins.jo'
use '../src/planes.jo'
use '../src/cockpit.jo'

# (ray t at which it crosses triangle a b c, or -1)
_hit = (o: vec3, d: vec3, a: vec3, b: vec3, c: vec3) -> f64:
    e1 = b - a; e2 = c - a
    p = cross(d, e2); det = f64(dot(e1, p))
    if abs(det) < 1e-9: return -1.0
    inv = 1.0 / det
    s = o - a
    u = f64(dot(s, p)) * inv
    if u < 0.0 or u > 1.0: return -1.0
    q = cross(s, e1)
    v = f64(dot(d, q)) * inv
    if v < 0.0 or u + v > 1.0: return -1.0
    f64(dot(e2, q)) * inv

test "every aircraft has a cockpit arrangement, the enclosed types a cabin":
    cabins: str[]
    loop id in 0..CRAFT_NAMES.len():
        l = cockpit_layout(Craft(id))
        if l.kind == .cabin: cabins.push(CRAFT_NAMES[id])
        assert(l.look.yaw > 1.5 and l.look.yaw <= PI and l.look.up > 0.5 and l.look.down > 0.5)
    assert(cabins == ["Heron", "Pelican", "Albatross", "Do X", "H-4", "Sarafand"])
    assert(cockpit_layout(.sm_s55).kind == .side_by_side and cockpit_layout(.dornier_wal).kind == .side_by_side)
    assert(cockpit_layout(.tern).kind == .open_tandem and cockpit_layout(.gull).kind == .open_single)

test "a cabin's pilots sit inside it and its cut takes the whole room":
    loop id in 0..CRAFT_NAMES.len():
        kind = Craft(id); l = cockpit_layout(kind)
        if l.kind != .cabin: continue
        e = l.eye
        assert(f64(e.y) > l.floor + 1.0 and f64(e.y) < l.roof - 0.3, CRAFT_NAMES[id])
        assert(f64(e.z) > l.front + 1.0 and f64(e.z) < l.rear - 0.4, CRAFT_NAMES[id])
        loop x in l.seats: assert(abs(x - l.cx) < l.hw - 0.3, CRAFT_NAMES[id])
        box = cockpit_cut_box(kind, vec3(0, 0, 0))
        loop v in cabin_interior_craft(l):
            # (all but the footwell, which runs forward under the panel)
            if f64(v.pos.z) > l.front - 0.1 and f64(v.pos.y) > l.sill:
                assert(v.pos.x >= box.0.x and v.pos.x <= box.1.x and v.pos.y <= box.1.y and v.pos.z <= box.1.z, CRAFT_NAMES[id])
        assert(cockpit_glass(kind).len() == l.panes + 2 * l.windows)

# From the pilot's eye, every direction meets a face turned toward the eye (drawn) before it leaves
# through a pane: no hole, no back face, at any head angle (the head-look's and beyond).
test "a cabin is solid from inside: every look ends on a drawn face or the glass":
    loop id in 0..CRAFT_NAMES.len():
        kind = Craft(id); l = cockpit_layout(kind)
        if l.kind != .cabin: continue
        tris = cabin_interior_craft(l)
        o = cockpit_origin(l)
        glass: vec3[][] = [loop pane in cockpit_glass(kind): [loop c in pane: c + o]]
        eye = l.eye
        loop i in 0..24:
            yaw = -PI + TAU * (f64(i) + 0.5) / 24.0
            loop j in 0..11:
                pitch = -1.35 + 2.7 * f64(j) / 10.0
                d = vec3(f32(-sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
                best = 1e9; facing = false
                loop k in 0..tris.len() / 3:
                    a = tris[k * 3]
                    t = _hit(eye, d, a.pos, tris[k * 3 + 1].pos, tris[k * 3 + 2].pos)
                    if t > 0.0 and t < best:
                        best = t; facing = dot(a.normal, d) < 0
                pane = 1e9
                loop g in glass:
                    loop tri in [[g[0], g[1], g[2]], [g[0], g[2], g[3]]]:
                        t = _hit(eye, d, tri[0], tri[1], tri[2])
                        if t > 0.0 and t < pane: pane = t
                ok = (best < 1e9 and facing) or (pane < 1e9 and pane < best + 0.03)
                assert(ok, "{CRAFT_NAMES[id]} yaw {yaw:.2} pitch {pitch:.2}: hole or back face at {best:.2} (glass {pane:.2})")

test "the ray check sees the ceiling over the pilot's head":
    l = cockpit_layout(.dornier_dox)
    tris = cabin_interior_craft(l)
    best = 1e9
    loop k in 0..tris.len() / 3:
        t = _hit(l.eye, vec3(0, 1, 0), tris[k * 3].pos, tris[k * 3 + 1].pos, tris[k * 3 + 2].pos)
        if t > 0.0 and t < best: best = t
    assert(best > 0.3 and best < 0.45, "ceiling at {best}")

# The user's report (2026-11-15): in an open cockpit the sea showed through the well's walls either
# side of the panel. From the pilot's eye every glance that passes below the coaming (an open
# cockpit) or anywhere (a cabin) must land on a cockpit face turned toward the eye, for every type.
test "every cockpit is solid from the seat: no glance below the coaming sees through the well":
    loop id in 0..CRAFT_NAMES.len():
        kind = Craft(id); l = cockpit_layout(kind)
        tris = cockpit_panel_vertices(kind)
        eye = COCKPIT_EYE
        glass: vec3[][] = cockpit_glass(kind)
        ring: vec3[] = [loop j in 0..96: cockpit_coaming(kind, TAU * f64(j) / 96.0)]
        lim = cockpit_look(kind)
        loop i in 0..33:
            yaw = -lim.yaw - 0.35 + (2.0 * lim.yaw + 0.7) * f64(i) / 32.0
            loop j in 0..14:
                pitch = -1.3 + 1.6 * f64(j) / 13.0
                d = vec3(f32(-sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
                if l.kind != .cabin:
                    # (where the ray crosses the coaming's line in plan, and whether it passes under it)
                    h = normalize(vec2(d.x, d.z))
                    best_c = -1.0; under = false
                    loop c in ring:
                        rel = vec2(c.x - eye.x, c.z - eye.z)
                        if dot(normalize(rel), h) > best_c:
                            best_c = f64(dot(normalize(rel), h))
                            reach = f64(length(rel)) / max(0.05, f64(length(vec2(d.x, d.z))))
                            under = f64(eye.y) + f64(d.y) * reach < f64(c.y) - 0.06
                    if not under: continue
                best = 1e9; facing = false
                loop k in 0..tris.len() / 3:
                    a = tris[k * 3]
                    t = _hit(eye, d, a.pos, tris[k * 3 + 1].pos, tris[k * 3 + 2].pos)
                    if t > 0.0 and t < best:
                        best = t; facing = dot(normalize(cross(tris[k * 3 + 1].pos - a.pos, tris[k * 3 + 2].pos - a.pos)), d) < 0 or dot(a.normal, d) < 0
                pane = 1e9
                loop g in glass:
                    loop tri in [[g[0], g[1], g[2]], [g[0], g[2], g[3]]]:
                        t = _hit(eye, d, tri[0], tri[1], tri[2])
                        if t > 0.0 and t < pane: pane = t
                ok = (best < 1e9 and facing) or (pane < 1e9 and pane < best + 0.03)
                assert(ok, "{CRAFT_NAMES[id]} yaw {yaw:.2} pitch {pitch:.2}: sees through at {best:.2}")
