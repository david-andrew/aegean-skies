use '../src/prop_disc.jo'
use '../src/loading_prop.jo'

test "the loading propeller's cycle closes on itself and shows every regime":
    rows = loading_table()
    assert(rows.len() == LOADING_STOPS + 1)
    first = rows[0]; last = rows[rows.len() - 1]
    half = (d: f64) -> f64: ((d % 180.0) + 180.0) % 180.0
    assert(abs(half(last.blade) - half(first.blade)) < 1e-6 and abs(half(last.band) - half(first.band)) < 1e-6 and abs(half(last.rim) - half(first.rim)) < 1e-6, "a jump as the cycle starts again")
    # (the rim's sheen turns at its own rate, not with the bands)
    assert(abs(rows[80].rim - rows[80].band) > 30.0 and rows[80].rim > 0.0)
    assert(abs(last.blades - first.blades) < 1e-9 and abs(last.disc - first.disc) < 1e-9 and abs(last.arcs - first.arcs) < 1e-9)
    # (solid blades turning; the disc with fast-precessing arcs near the hand-over; the full disc,
    # its arcs creeping): each for a while in every cycle
    blades = 0; transition = 0; full = 0
    loop r in rows:
        if r.blades > 0.95 and r.disc < 0.3 and r.rpm > 6.0: blades += 1
        if r.blades < 0.05 and r.arcs > 0.5 and abs(prop_band_speed(r.rpm)) > 20.0: transition += 1
        if r.rpm > 75.0 and r.disc > 0.99 and r.arcs > 0.99 and abs(prop_band_speed(r.rpm)) < 8.0: full += 1
    assert(blades >= 10 and transition >= 10 and full >= 10, "regimes: blades {blades}, transition {transition}, full {full} stops")
    # (the arcs: a few dozen strokes a drawing, the three drawings different)
    a0 = loading_arcs(0); a1 = loading_arcs(1)
    assert(a0.len() > 10 and a0.len() < 30 and a0 != a1)

test "the game's loader and the page's card share one timetable and one set of arcs":
    script = "const P=require(process.argv[1]).AegeanLoadingProp;for(const r of P.table())console.log('ROW',r.blade,r.band,r.blades,r.disc,r.arcs,r.rim);for(const v of [0,1,2])for(const a of P.arcs(v))console.log('ARC',v,a[0],a[1],a[2])"
    page = abs_path(dir_name(args()[0]) + "/../src/web_compat.js")
    got = run_program("node", ["-e", script, page])
    assert(got.0 == 0, "node, to read the page's loader (tools/check_web_shaders.cjs needs it too)")
    rows = loading_table()
    arcs = [loop v in 0..3: loading_arcs(v)]
    s = 0
    counts = [0, 0, 0]
    worst = 0.0
    loop line in split(got.1, "\n"):
        w = split(line, " ")
        if w.len() == 7 and w[0] == "ROW":
            n = [loop k in 1..7: to_float(w[k]) ?? 1e9]
            r = rows[s]
            worst = max([worst, abs(n[0] - r.blade), abs(n[1] - r.band), abs(n[2] - r.blades), abs(n[3] - r.disc), abs(n[4] - r.arcs), abs(n[5] - r.rim)])
            s += 1
        else if w.len() == 5 and w[0] == "ARC":
            v = to_int(w[1]) ?? 0
            a = arcs[v][counts[v]]
            worst = max([worst, abs((to_float(w[2]) ?? 1e9) - f64(a.x)), abs((to_float(w[3]) ?? 1e9) - f64(a.y)), abs((to_float(w[4]) ?? 1e9) - f64(a.z))])
            counts[v] += 1
    assert(s == rows.len() and counts == [arcs[0].len(), arcs[1].len(), arcs[2].len()], "rows {s}, arcs {counts}")
    assert(worst < 1e-4, "the page's loader differs from the game's by {worst}")
