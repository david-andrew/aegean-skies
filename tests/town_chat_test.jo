use '../src/living_seed.jo'
use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_far_types.jo'
use '../src/pilot_day_types.jo'
use '../src/town_chat.jo'
use '../src/leads.jo'
use '../src/reputation_types.jo'
use '../src/reputation.jo'
use '../src/options.jo'

_no_lead = () -> MeetNote[]?: none

test "the speaker and place have independent rests and changing both still leaves a quiet spell":
    h: ChatVisit[]
    chat_remember(h,100,3,0,"catch")
    assert(chat_chance(h,135,5,0,false) == 0.0)
    assert(chat_chance(h,136,5,0,false) > 0.0)
    assert(chat_chance(h,199,3,1,true) == 0.0)
    assert(chat_chance(h,200,3,1,true) > 0.0)
    assert(chat_chance(h,112,5,2,false) == 0.0)
    assert(chat_chance(h,113,5,2,false) < chat_chance(h,145,5,2,false))
    assert(chat_chance(h,145,5,2,false) < chat_chance(h,190,5,2,false))
    # Many manually initiated conversations must not evict a still-live NPC or place cooldown.
    loop i in 0..20: chat_remember(h,102+i,i+20,10,"conversation")
    assert(chat_chance(h,122,3,2,true) == 0.0 and chat_chance(h,122,4,0,true) == 0.0)
    restored = from_bytes[PresentationState](to_bytes(PresentationState(town_chat=h)))
    if restored is TextError: panic("{restored}")
    assert(restored.town_chat == h)
    old = from_text[PresentationState]("PresentationState(last_hail_tick=42)")
    assert(old is PresentationState and old.town_chat.len() == 0)

test "a delivered opening owns its replies and recent openings are heard by nobody else":
    w = build_world()
    speaker = 3; place = person_place(w,speaker)
    w.people[w.player].place = place
    c = ChatContact(speaker,place,wind=3.0,forced=true)
    h: ChatVisit[]
    heard: str[]
    loop k in 0..10:
        w.minute = k*110
        bank = chat_openings(w,speaker,place,false,3.0)
        turn = town_chat(w,h,c,_no_lead)
        match_ = [loop o in bank: if o.tag == turn.tag: o]
        assert(match_.len() == 1 and match_[0].line == turn.opening)
        assert(turn.reply in match_[0].replies and match_[0].replies.len() >= 2)
        assert(not (turn.tag in heard)); heard.push(turn.tag)
        # Another speaker gets the same recent-opening memory.
        if let next = chat_choose(bank,h,17): assert(next.tag != turn.tag)
        assert(town_chat(w,h,c,_no_lead).opening == "")
    assert(Options().small_talk)
    c.answers = false; w.minute += 200
    turn = town_chat(w,h,c,_no_lead)
    assert(turn.opening != "" and turn.reply == "")

test "weather, last flight, delivery, prices, feast, war and reputation select eligible pairs":
    w = build_world(); p = 3; place = person_place(w,p)
    w.people[w.player].place = place; w.minute = 500
    blank = chat_openings(w,p,place,false,2.0)
    assert(not ("flight_air" in [loop o in blank: o.tag]))
    w.pilot_day = [Doing(.flew,w.minute-10,where="Kalamos",rough=2),Doing(.fished,w.minute-5)]
    _ = rep_record(w,.job_late,place,place,1,-1,1,[],0)
    fish = int(GoodKind.fish)
    w.places[place].market.price_cents[fish] = 2*w.goods[fish].base_cents
    w.people[p].far_reports.push(FarReport(1,497,499,place,"","war_declared"))
    bank = chat_openings(w,p,place,true,3.0)
    tags = [loop o in bank: o.tag]
    loop tag in ["flight_air","flight_from","catch","delivery","rain_glass","fish_price","war_news"]: assert(tag in tags,tag)
    loop tag in ["wind_landing","light_air","feast"]: assert(not (tag in tags),tag)
    loop o in bank:
        if o.tag == "flight_from": assert(o.replies[0].contains("Kalamos"))
        if o.tag == "delivery": assert(o.replies[0].contains("late"))
        if o.tag == "fish_price": assert(o.replies[0].contains("Dear"))
        loop line in [o.line]+o.replies: assert(not lower(line).contains("quay"))
    w.minute += 1441
    later = [loop o in chat_openings(w,p,place,false,13.0): o.tag]
    assert("wind_landing" in later)
    loop tag in ["war_news","delivery","flight_air","catch"]: assert(not (tag in later))
    w.minute = (6+7*(place%4))*1440+18*60-EPOCH_LOCAL_MINUTE
    w.countries.push(CountryRecord(88,"test","Test",capital_id=place))
    feast = [loop o in chat_openings(w,p,place,false,4.0): o.tag]
    assert("feast" in feast)
    id = rep_record(w,.rescued_friend,place,place,2,-1,1,[p],800)
    h: ChatVisit[]
    turn = town_chat(w,h,ChatContact(p,place,seated=true,first_at_table=true,forced=true),_no_lead)
    assert(turn.tag == "heard_rescue" and turn.reply != "")
    assert(id in w.rep.opinions[p].told)
    another = [ChatOpening("heard_rescue","Heard you brought them in.",["I did."],id),ChatOpening("wind","Much wind?",["A little."])]
    assert(chat_choose(another,h,0,true)!.tag == "wind")
    again = [loop o in chat_openings(w,p,place,false,4.0): o.tag]
    assert(not ("heard_rescue" in again))

test "an occupied pilot never starts or carries a reply into another contact":
    w = build_world(); p = 3; place = person_place(w,p); w.people[w.player].place = place
    c = ChatContact(p,place,busy=true,forced=true)
    h: ChatVisit[]
    before = w.speech
    assert(town_chat(w,h,c,_no_lead) == ChatTurn() and h.len() == 0 and w.speech == before)
    c.busy = false; turn = town_chat(w,h,c,_no_lead)
    initial = TownSpeech(p,false,turn,10.0)
    live = initial
    chat_step(live,12.1,p,false,false,true); assert(not live.answered)
    chat_step(live,12.3,p,false,false,true); assert(live.answered)
    chat_step(live,17.0,p,false,false,true); assert(live.speaker < 0)
    loop interrupted in 0..3:
        pending = initial
        chat_step(pending,11.0,if interrupted == 1: p+1 else: p,interrupted == 2,interrupted == 0,true)
        chat_step(pending,12.3,p,false,false,true)
        assert(not pending.answered and pending.speaker < 0)
    muted = initial
    chat_step(muted,11.0,p,false,false,false); chat_step(muted,12.3,p,false,false,true)
    assert(not muted.answered)

test "a delivery walk or cargo in hand takes precedence over a passing remark":
    w = build_world()
    j = w.active_jobs[0]
    place = person_place(w,w.player)
    w.jobs[j].origin = place; w.jobs[j].state = .claimed; w.jobs[j].carrier = w.player
    assert(chat_on_business(w,true) and not chat_on_business(w,false))
    w.jobs[j].origin = place+1; w.jobs[j].destination = place+2
    assert(not chat_on_business(w,true))
    w.people[w.player].carrying = 1
    assert(chat_on_business(w,false))

test "a nearby speaker warns once per incoming storm through both cooldowns and a save":
    old = from_text[ChatVisit]("ChatVisit(minute=10,speaker=3,place=0,opening=\"coffee\")")
    assert(old is ChatVisit and old.keep_until == -1)
    w = build_world(); w.minute = 10
    p = 3; place = person_place(w,p); w.people[w.player].place = place
    w.people[p].pose.pos = vec3(0,0,0)
    near = Weather(id=42,kind=.storm,center=vec2(-28000,0),radius_m=13000,velocity_milli_m_per_minute=vec2(120000,0),expires_minute=360)
    away = near; away.id = 41; away.velocity_milli_m_per_minute = vec2(-120000,0)
    far = near; far.id = 40; far.center = vec2(-90000,0)
    w.weather = [away,far]
    h = [ChatVisit(w.minute,p,place,"coffee")]
    c = ChatContact(p,place,warnings_only=true)
    assert(town_chat(w,h,c,_no_lead) == ChatTurn())
    w.weather.push(near)
    c.busy = true; assert(town_chat(w,h,c,_no_lead) == ChatTurn() and h.len() == 1)
    c.busy = false
    warning = town_chat(w,h,c,_no_lead)
    assert(warning.opening.contains("west, 15 kilometres off, coming this way") and warning.reply == "I'll give it a wide berth, then.")
    # Long-lived storms outlast the ordinary history, including a change of town and speaker.
    w.minute = 200
    loop k in 0..20: chat_remember(h,w.minute,k+20,place,"conversation")
    saved = from_bytes[PresentationState](to_bytes(PresentationState(town_chat=h)))
    if saved is TextError: panic("{saved}")
    c.speaker = 5; c.place = place+1
    w.people[c.speaker].place = c.place; w.people[w.player].place = c.place
    w.people[c.speaker].pose.pos = vec3(0,0,0)
    assert(town_chat(w,saved.town_chat,c,_no_lead) == ChatTurn())
    second = near; second.id = 43; w.weather.push(second); c.answers = false
    other = town_chat(w,saved.town_chat,c,_no_lead)
    assert(other.tag == "storm:43" and other.opening != "" and other.reply == "")
