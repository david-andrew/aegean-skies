# The aerodromes in the living world: the paper maps that print airfields list them (new worlds and
# worlds published before there were aerodromes), and a point on a field is known to be there.
# SLOPPY_THREADS=1 sloppy test tests/airfield_world_test.jo
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_seed.jo'
use '../src/living_save.jo'
use '../src/living_types.jo'
use '../src/living_map_types.jo'
use '../src/living_maps.jo'
use '../src/map_scene.jo'
use '../src/airfields.jo'

_published = () -> World:
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true; init_settlements()
    w = build_world(u64(7))
    publish_settlement_maps(w)
    w

test "the military sheet of each aerodrome's country lists it on its airfield layer":
    w = _published()
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]; key = "airfield:{k}"
        assert(key in w.maps.features and w.maps.features[key].layer == .airfields)
        sheet = "country:{f.country}:military:1919"
        assert(sheet in w.maps.editions and key in w.maps.editions[sheet].feature_keys)
        marks = map_features(w, sheet, .airfields)
        ours = 0
        loop j in 0..AIRFIELDS.len(): if AIRFIELDS[j].country == f.country: ours += 1
        assert(marks.len() == ours)
        found = false
        loop m in marks:
            if m.label != f.name: continue
            found = true
            # (printed with the sheet's survey error: near, not exactly, where the field is)
            print("{f.name}: printed {m.position} true {f.center}")
            assert(length(m.position.xz - f.center) < 2000.0)
        assert(found)
        # sheets without the layer never list it
        loop edition, m in w.maps.editions:
            if key in m.feature_keys: assert(MapLayer.airfields in m.layers)
    assert(validate_save_world(w) == "")

test "a world published before the aerodromes gets them, once":
    w = _published()
    sheet = "country:{AIRFIELDS[0].country}:military:1919"
    w.maps.features.remove("airfield:0")
    w.maps.editions[sheet].feature_keys.remove("airfield:0")
    before = w.maps.editions[sheet].feature_keys.len()
    publish_airfield_features(w)
    publish_airfield_features(w)
    assert("airfield:0" in w.maps.features and w.maps.editions[sheet].feature_keys.len() == before + 1)
    assert(validate_save_world(w) == "")

test "a point on a field is at that aerodrome; its town and the open country are not":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true; init_settlements()
    loop n in 0..AIRFIELDS.len():
        f = AIRFIELDS[n]
        assert(airfield_at(f.center) == n)
        assert(airfield_at(airfield_stand(f, 0).xz) == n)
        assert(airfield_at(airfield_fuel_stand(f).xz) == n)
        k = -1
        loop i in 0..world_settlements.len():
            if world_settlements[i].id == f.place: k = i
        assert(k >= 0 and airfield_at(world_settlements[k].center.xz) == -1)
        assert(airfield_at(f.center + vec2(5000, 0)) == -1)
