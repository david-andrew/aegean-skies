use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_travel.jo'
use '../src/living_sim.jo'
use '../src/living_money.jo'
use '../src/living_delivery.jo'

test "Trip0 crosses within five minutes and payments commit once":
    w = build_world(u64(7))
    q = query_airborne(w)
    assert(q.len() == 1 and q[0].person == 2 and q[0].reason.beneficiary == 10)
    initial = w.aircraft[1].pose.pos
    advance_minutes(w,5)
    gate = w.harbors[0].center+w.harbors[0].out*900.0+vec3(0,300,0)
    assert(length(w.aircraft[1].pose.pos-gate) < 1.0)
    assert(length(w.aircraft[1].pose.pos-initial) > 599.0)
    advance_minutes(w,40)
    assert(w.trips[0].state == .arrived)
    advance_minutes(w,45)
    assert(w.jobs[0].state == .delivered and w.jobs[0].paid_cents > 0)
    assert(w.jobs[1].state == .delivered and w.jobs[1].paid_cents == 1200)
    stock = w.places[0].market.inventory.qty[3]
    assert(not deliver_job(w,1,8) and w.places[0].market.inventory.qty[3] == stock)
    assert(not commit_arrival(w,0,0,2,w.aircraft[1].revision))
    assert(money_balances(w) and goods_balance(w))

test "tick partition and repeated trip fuel have no minute drift":
    a = build_world(); b = build_world()
    advance_minutes(a,50)
    loop i in 0..6000: advance_ticks(b,1)
    assert(a.aircraft[1].fuel_ml == b.aircraft[1].fuel_ml)
    assert(a.aircraft[1].pose == b.aircraft[1].pose and a.jobs[0] == b.jobs[0])
    w = build_world()
    # Isolated repeatedly reset route. Explicit external test fuel becomes opening stock.
    total = 0
    loop i in 0..10:
        w.aircraft[4].fuel_ml += 50000
        w.goods_ledger.opening[4] += 50000
        before = w.aircraft[4].fuel_ml
        destination = if w.people[9].place == 0: 1 else: 0
        id = start_trip(w,9,destination,Reason(purpose=.patrol,actor=9,origin=w.people[9].place,destination=destination))
        assert(id >= 0)
        expected = route_fuel(w.trips[id].route,w.aircraft[4].kind)
        loop w.people[9].trip >= 0:
            w.tick += 120; w.minute = w.tick/120
            advance_trips(w,w.tick)
        used = before - w.aircraft[4].fuel_ml
        assert(abs(used-expected) <= 1)
        total += used
    assert(total > 0 and money_balances(w) and goods_balance(w))
