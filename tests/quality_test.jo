use '../src/quality.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/world_terrain.jo'
use '../src/render_space.jo'

test "quality budgets thin render instances without moving roots or consuming random draws":
    trees = [loop k in 0..30: Instance3D(translation(vec3(f32(k),0,0)),vec4(1,1,1,1))]
    seed_random(123); expected = random()
    loop tier in 0..3:
        render_quality = quality_profile(tier)
        seed_random(123)
        out = quality_trees(trees)
        assert(random() == expected)
        assert(out.len() == 30/render_quality.tree_stride)
        loop k in 0..out.len(): assert(out[k] == trees[k*render_quality.tree_stride])
    render_quality = RenderQuality()

test "all quality tiers retain canonical contact terrain and balanced visible edges":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_world_terrain()
    x = -112700.0; z = -120000.0
    height = new_land_surface(x,z)
    cam = vec3(f32(x),f32(height+2.0),f32(z))
    vp = perspective(110.0*PI/180.0,1280.0/720.0,0.3,world_far(height+2.0))*look_at(cam,cam+vec3(0.7,-0.05,0.7),vec3(0,1,0))
    loop tier in 0..3:
        render_quality = quality_profile(tier)
        loop frame in 0..100: prepare_world_terrain(cam,vp,f64(tier*100+frame)/60.0)
        found = 0
        loop slot in world_selected:
            node = world_tiles[slot]
            ox,oz = world_tile_origin(node.x,node.z,node.level); size = world_tile_size(node.level)
            if x >= ox and x < ox+size and z >= oz and z < oz+size:
                found += 1
                assert(node.level == 0 and node.lod == 0.0)
            loop other in world_selected:
                b = world_tiles[other]
                if world_neighbor_side(node,b) >= 0: assert(abs(node.level-b.level) <= 1)
        assert(found == 1)
        assert(world_cache.len() <= WORLD_CACHE_SLOTS)
        assert(new_land_surface(x,z) == height)
    render_quality = RenderQuality()

test "far port contact tiles are canonical on the very first arrival frame":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    loop point in [vec2(14263.08,-170005.45),vec2(237606.22,182748.05)]:
        # A cold arrival, not a hundred-frame warmup hiding moving ground.
        world_cache.clear();world_selected=[]
        init_world_terrain()
        h=new_land_surface(f64(point.x),f64(point.y))
        cam=vec3(point.x,f32(max(h,5.0)+3.0),point.y)
        vp=perspective(58.0*PI/180.0,16.0/9.0,0.3,world_far(cam.y))*look_at(cam,cam+vec3(0.8,-0.2,-0.5)*1000.0,vec3(0,1,0))
        prepare_world_terrain(cam,vp,0.0)
        assert(world_contact_slots.len()==9)
        assert(world_generated<=WORLD_CONTACT_GENERATE_LIMIT)
        assert(world_uploaded<=WORLD_CONTACT_GENERATE_LIMIT*17*17*8)
        loop slot in world_contact_slots:
            assert(slot in world_selected)
            node=world_tiles[slot]
            assert(node.level==0 and node.lod==0.0)
        # Camera and props within 70 m fit inside the protected contact area.
        assert(point.x-70.0>=world_contact_rect.x and point.x+70.0<world_contact_rect.z)
        assert(point.y-70.0>=world_contact_rect.y and point.y+70.0<world_contact_rect.w)
