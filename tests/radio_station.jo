use '../src/radio_station.jo'
use '../src/radio_synth.jo'

test "station level is finite bounded silent and does not turn rests into noise":
    s=StationLevel()
    loop i in 0..1600:assert(station_level(s,0)==0)
    loop i in 0..32000:
        x=(if i%701==0:8.0 else:0.3)*sin(f64(i)*0.271)
        v=station_level(s,x)
        assert(v==v and abs(v)<=0.5)
    loop i in 0..16000:_=station_level(s,0)
    gain=s.gain_target
    loop i in 0..32000:assert(station_level(s,0)==0)
    assert(s.gain_target==gain and s.delay.len()==STATION_LOOKAHEAD)

test "station level reduces long programme differences while preserving a phrase swell":
    a=StationLevel();b=StationLevel()
    quiet=0.0;loud=0.0
    loop i in 0..8*STATION_RATE:
        tone=sin(f64(i)*0.173)
        x=station_level(a,tone*0.012);y=station_level(b,tone*0.35)
        if i>6*STATION_RATE:quiet+=x*x;loud+=y*y
    assert(loud/quiet<9.0 and loud/quiet>0.3)
    first=0.0;last=0.0
    loop i in 0..STATION_RATE:
        value=station_level(a,sin(f64(i)*0.173)*0.012*(1+f64(i)/f64(STATION_RATE)))
        if i<4000:first+=value*value
        if i>12000:last+=value*value
    assert(last>first*1.5)

test "station toggle leaves dry output intact and programme reset clears its lookahead":
    a=make_radio_synth();b=make_radio_synth()
    radio_synth_program(a,.morse,4,0,radio_morse("TEST"))
    radio_synth_program(b,.morse,4,0,radio_morse("TEST"))
    same=radio_render(a,800,1,0,true,true)==radio_render(b,800,1,0,true,false)
    assert(same)
    _=radio_render(a,800)
    assert(a.station.delay.len()==STATION_LOOKAHEAD)
    radio_synth_program(a,.morse,4,0,radio_morse("TEST"))
    assert(not a.station.ready and a.station.delay.len()==0)
