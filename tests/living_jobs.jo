use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_claims.jo'
use '../src/living_jobs.jo'
use '../src/living_delivery.jo'
use '../src/living_travel.jo'
use '../src/living_cargo.jo'

test "public tender independent of presence exclusive claim escrow and board history":
    w = build_world()
    # Player may claim immediately; both pilots cannot own the same load.
    assert(take_job(w,3,0))
    assert(not take_job(w,3,8))
    assert(not load_job(w,3))
    advance_minutes(w,5)
    assert(not w.jobs[3].loaded) # Existing stock must actually cross the quay.
    loop minute in 0..100:
        if w.jobs[3].loaded: break
        advance_minutes(w,1)
    assert(w.jobs[3].loaded and w.places[0].market.inventory.reserved[6] == 5000)
    assert(w.aircraft[0].cargo.qty[6] == 2000 and w.people[0].trip == -1)
    assert(start_trip(w,0,2,w.jobs[3].cause) >= 0)
    assert(board_lines(w,0).join("\n").contains("taken by The Pilot"))
    advance_minutes(w,300)
    assert(w.jobs[3].state == .delivered and w.jobs[3].paid_cents == 4000)
    assert(not deliver_job(w,3,0) and money_balances(w) and goods_balance(w))
    # Public 90-minute gate fixture, with decisions deliberately not run.
    b = build_world()
    b.minute = 89; b.tick = 89*120
    assert(not take_job(b,3,8))
    b.minute = 90; b.tick = 90*120
    b.people[8].action.activity = .wait
    b.aircraft[2].job_manifests.clear()
    assert(claim_feasible(b,3,8))

test "expiry returns escrow and retains one physical paid cargo owner":
    w = build_world()
    # No carrier accepts: expiry cannot charge or blame a bystander.
    w.minute = 600; w.tick = 600*120
    assert(expire_job(w,3))
    assert(w.jobs[3].state == .expired and w.accounts[w.jobs[3].escrow_account].cents == 0)
    assert(w.places[0].market.inventory.reserved[6] == 5000)
    assert(w.aftermath.len() == 1 and goods_balance(w) and money_balances(w))
    assert(not expire_job(w,3))
    id = post_job(w,1,2,.sealed,-1,1,800,w.minute+480)
    assert(id == 5 and w.jobs[id].npc_claim_after == 690)
    assert(expire_job(w,id,true))
    assert(w.accounts[w.jobs[id].escrow_account].cents == 0)

test "real passenger manifest boards and safely disembarks once":
    w = build_world()
    j = post_job(w,1,1,.none,-1,1,2000,480,5)
    assert(j >= 0 and take_job(w,j,0))
    advance_minutes(w,5)
    assert(w.people[0].trip == -1)
    assert(start_trip(w,0,1,w.jobs[j].cause) >= 0)
    assert(w.people[5].trip == w.people[0].trip and w.people[5].place == -1)
    assert(w.aircraft[0].passengers.len() == 1)
    advance_minutes(w,300)
    assert(w.people[5].place == 1 and w.people[5].trip == -1)
    assert(w.aircraft[0].passengers.len() == 0 and w.jobs[j].state == .delivered)
    assert(money_balances(w) and goods_balance(w))

test "partial stolen commodity delivery transfers surviving stock and proportional pay once":
    w = build_world()
    # Isolate a moored Dario with three packages; one is transferred to the raider.
    w.aircraft[4].dock = -1; w.aircraft[4].pose.pos = w.harbors[0].buoy
    w.aircraft[2].dock = 1; w.aircraft[2].pose.pos = w.harbors[0].docks[1]
    assert(move_stock(w.aircraft[2].cargo,w.aircraft[6].cargo,3,1000,true))
    assert(cargo_move(w,.aircraft,2,.aircraft,6,3,1000,22,-1,1,true))
    w.jobs[1].lost_quantity = 1000
    assert(not deliver_job(w,1,8))
    # The buoy has no loading point. Taxi to a real dock, then wait for collection.
    loop minute in 0..90:
        if w.jobs[1].state != .claimed: break
        advance_minutes(w,1)
    assert(w.jobs[1].delivered_quantity == 2000 and w.jobs[1].paid_cents == 800)
    assert(w.jobs[1].state == .failed and w.accounts[w.jobs[1].escrow_account].cents == 0)
    assert(not deliver_job(w,1,8) and goods_balance(w) and money_balances(w))
