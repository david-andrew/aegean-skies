use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_access.jo'
use '../src/road_material.jo'
use '../src/living_far_catalog.jo'

test "the complete living road graph including feeder tracks is visible and publication is idempotent":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
    catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
    publish_access_roads(catalog.links)
    count=0
    loop link in catalog.links:
        if link.mode!=.cart:continue
        count+=1;found=false
        loop id in world_settlements[settlement_by_id[link.a]].roads:
            road=settlement_roads[id]
            if road.a!=link.a or road.b!=link.b:continue
            assert(road.ready and road.points.len()>=2)
            assert(length(road.points[0]-link.points[0])<0.01)
            assert(length(road.points[road.points.len()-1]-link.points[link.points.len()-1])<0.01)
            assert(id in world_settlements[settlement_by_id[link.b]].roads)
            mid=(road.points[0].xz+road.points[1].xz)*0.5
            assert(id in settlement_road_bins.get(road_bin(mid),[]))
            found=true;break
        assert(found,"missing physical route {link.id}")
    assert(count>500 and access_feeder_roads.len()>0)
    fingerprint=hash(settlement_roads)
    publish_access_roads(catalog.links)
    assert(hash(settlement_roads)==fingerprint)
    init_settlements();publish_access_roads(catalog.links)
    assert(hash(settlement_roads)==fingerprint)

test "vector road cells preserve narrow tracks and all three arms of a junction":
    img=image(8,32)
    loop i in 0..img.pixels.len():img.pixels[i]=u8(0)
    origin=vec2(240000,-180000);cell:f32=32.0
    center=origin+vec2(112,112)
    loop end in [vec2(-24,0),vec2(24,0),vec2(0,24)]:road_raster_segment(img,origin,cell,center,center+end,false)
    filled=0
    loop k in 0..4:
        if img.get(3,3+k*8)!=vec4(0,0,0,0):filled+=1
    assert(filled==3)
    loop end in [vec2(-12,0),vec2(12,0),vec2(0,12)]:
        nearest:f32=1e9
        loop k in 0..filled:
            decoded=road_decode(img.get(3,3+k*8),cell)
            nearest=min(nearest,road_line_distance(vec2(16,16)+end,decoded.xy,decoded.zw))
        assert(nearest<0.3,"track displaced by vector quantisation")
    assert(road_line_distance(vec2(10,12),vec2(0,0),vec2(20,0))==12.0)
    a,b,ok=road_clip(vec2(-100,4),vec2(100,4),vec2(0,0),vec2(32,32))
    assert(ok and length(a-vec2(0,4))<0.001 and length(b-vec2(32,4))<0.001)
