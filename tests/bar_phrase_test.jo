# The band stops for rain at a breath in the music: the widest gap between notes beginning, just
# ahead; it goes on from the first note after it.
use '../src/music_synth.jo'
use '../src/bar_band.jo'

_ev = (sec: f64) -> MusicEvent: MusicEvent(int(sec * f64(MUSIC_RATE)), 2000, 60, 0, 0.5, 0.5)

test "the widest gap ahead is where they stop, and the note after it where they go on":
    events = [loop s in [10.0, 10.5, 11.0, 11.5, 12.0, 14.0, 14.5, 15.0, 15.25, 15.5]: _ev(s)]
    br = bar_phrase_break(events, 10.2)
    assert(br.0 > 12.0 and br.0 < 13.0)
    assert(abs(br.1 - 14.0) < 0.05)

test "nothing ahead: stop where it is":
    br = bar_phrase_break([_ev(1.0)], 5.0)
    assert(br.0 == 5.0 and br.1 == 5.0)
