use '../src/world.jo'
use '../src/world_point.jo'
use '../src/world_towns.jo'
use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/tweaks.jo'
use '../src/combat.jo'
use '../src/scenarios.jo'
use '../src/pilot.jo'
use '../src/flight_ground.jo'
import '../src/living_types.jo' as data

strait = () -> ScenarioState:
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    build_scenario("strait",towns,build_craft_models())!

test "a side left alone forms on its leader, flies home and lands in turn at its base":
    s=strait()
    b=s.battle
    # (Kalyra's flight gone: Orenthia has won and turns for home)
    loop i in 0..b.actors.len():
        if b.actors[i].side==1:b.actors[i].present=false;b.actors[i].status=.escaped
    # (scattered by the fight: each somewhere within a few kilometres, every which way)
    loop i in 0..b.actors.len():
        if b.actors[i].side!=2:continue
        a=b.actors[i]
        off=vec3(f32(combat_noise(7,a.craft,0,0)*7000.0),f32(combat_noise(7,a.craft,0,1)*120.0),f32(combat_noise(7,a.craft,0,2)*7000.0))
        turn=quat_euler(0,combat_noise(7,a.craft,0,3)*3.1,0)
        a.state.position+=off;a.state.orientation=normalize(quat_mul(turn,a.state.orientation));a.state.velocity=quat_rotate(turn,a.state.velocity);a.state.precise_ready=false
        a.previous=a.state.position;a.previous_point=world_point(a.state.position)
        b.actors[i]=a
    b.tick=700
    h=b.homes[1]
    assert(h.side==2 and b.homes[0].side==1)
    went=-1;formed=-1;first=-1;all=-1;slot_sum=0.0;slot_n=0;crashed=0
    loop tick in 0..60*600:
        observer=b.actors[0].state.position
        step_battle(b,flight_env(f64(b.tick)/60.0,observer),observer)
        if went<0 and b.home_since[2]>=0:went=b.tick
        lead=home_leader(b,2)
        # (in formation on the way: each follower's distance from its slot on the leader)
        if formed<0 and b.formed[2]>=0:
            formed=b.tick
        if lead>=0 and b.actors[lead].pilot.descend_tick<0 and formed>=0 and b.tick>formed+60*25 and tick%30==0:
            loop a in b.actors:
                if a.side==2 and a.status==.flying and a.craft!=b.actors[lead].craft:
                    slot_sum+=f64(length(home_slot(b,lead,a.pilot.formation_offset)-a.state.position));slot_n+=1
        done=0;home=0
        loop a in b.actors:
            if a.side==2 and a.status==.flying:
                home+=1
                if a.pilot.home_done:done+=1
        if done>0 and first<0:first=tick
        if home>0 and done==home:all=tick;break
    loop a in b.actors:
        if a.side==2 and a.status!=.flying:crashed+=1
    print("home from {went}, regrouped after {f64(formed-went)/60.0:.0} s, slot error {slot_sum/max(1.0,f64(slot_n)):.0} m over {slot_n}, first moored {f64(first)/60.0:.0} s, all {f64(all)/60.0:.0} s, lost {crashed}")
    assert(went>=0 and all>0 and crashed==0)
    # (regrouped before forming up, and not for ever)
    assert(formed-went>=REGROUP_LEAST and formed-went<=REGROUP_MOST+60)
    assert(slot_sum/max(1.0,f64(slot_n))<120.0)
    # (each at its own mooring, along the quay)
    loop a in b.actors:
        loop o in b.actors:
            if a.side==2 and o.side==2 and a.craft<o.craft: assert(length(a.state.position-o.state.position)>12.0)
