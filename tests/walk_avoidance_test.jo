use '../src/walk_avoidance.jo'
use '../src/walk_shapes.jo'
use '../src/town_sites.jo'
use '../src/world_point.jo'

const TEST_FLOOR = 1000.0
const STEP = 1.0/60.0

walk_fixture = (gap:f64,floor_width:f64=14.0):
    clear_walk_presentations()
    walk_publish_floors([TownSite(vec3(0,TEST_FLOOR,0),0,floor_width,24,0.1,0)])
    walls: TownSite[]
    if gap>0:
        loop side in [-1.0,1.0]:
            walls.push(TownSite(vec3(f32(side*(gap*0.5+2.0)),TEST_FLOOR,0),0,4,0.28,3,0))
    walk_publish("steering-test",walls)

test "nearby walker looks ahead, takes a wide lane, and returns to the route":
    walk_fixture(0.0)
    pilot=WalkSubject(WALK_PILOT,WorldPoint(0,TEST_FLOOR,0),PI,0)
    clearance=100.0
    shift=0.0
    first=0.0
    loop k in 0..420:
        z=min(3.2,-2.7+1.35*STEP*f64(k))
        route=WalkSubject(2,WorldPoint(0,TEST_FLOOR,z),0,if z<3.2:1.35 else:0.0)
        walk_update_presentations([],[pilot,route],pilot,STEP)
        shown=walk_presentation(route)
        clearance=min(clearance,f64(length(walk_xz(shown.point,pilot.point))))
        shift=max(shift,abs(shown.point.x))
        if first==0.0 and abs(shown.point.x)>0.04:first=z
        assert(route.point.x==0.0 and route.point.z==z)
        if k==419:assert(length(walk_xz(shown.point,route.point))<0.036)
    assert(first < -1.0 and shift>0.60 and clearance>0.60)

test "walkers shorten their stride and turn their shoulders in a narrow opening":
    walk_fixture(1.6)
    pilot=WalkSubject(WALK_PILOT,WorldPoint(-0.1,TEST_FLOOR,0),PI,0)
    clearance=100.0
    shoulder=0.0
    slow=false
    looked=false
    loop k in 0..480:
        z=min(3.2,-2.7+1.35*STEP*f64(k))
        route=WalkSubject(2,WorldPoint(0,TEST_FLOOR,z),0,1.35)
        walk_update_presentations([],[pilot,route],pilot,STEP)
        shown=walk_presentation(route)
        clearance=min(clearance,f64(length(walk_xz(shown.point,pilot.point))))
        shoulder=max(shoulder,abs(shown.shoulder))
        if abs(shown.shoulder)>0.8 and shown.pace<0.75:slow=true
        if shown.point.z>0.75:looked=true
        at=world_vec(shown.point).xz
        assert(length(walk_published_exclude(at,shown.point.y)-at)<0.025)
    print("narrow clearance {clearance:.3} m and shoulder turn {shoulder:.3} rad")
    assert(looked and slow and clearance>=WALK_CONTACT and shoulder>1.0)

test "a blocked one-person gap makes the walker wait and yield until it clears":
    walk_fixture(1.15)
    pilot=WalkSubject(WALK_PILOT,WorldPoint(0,TEST_FLOOR,0),PI,0)
    nearest=-100.0
    moved_back=false
    loop k in 0..570:
        z=min(3.2,-2.7+1.35*STEP*f64(k))
        route=WalkSubject(2,WorldPoint(0,TEST_FLOOR,z),0,1.35)
        if k<360:walk_update_presentations([],[pilot,route],pilot,STEP)
        else:walk_update_presentations([],[route],none,STEP)
        shown=walk_presentation(route)
        if k<360:
            nearest=max(nearest,shown.point.z)
            assert(shown.point.z< -0.42)
            if nearest-shown.point.z>0.7 and k>180:moved_back=true
        if k==569:assert(shown.point.z>2.5)
    assert(nearest> -0.9 and moved_back)

test "sidesteps stay on a raised quay next to a drop":
    walk_fixture(0,1.5)
    pilot=WalkSubject(WALK_PILOT,WorldPoint(0.58,TEST_FLOOR,0),PI,0)
    moved_left=false
    loop k in 0..400:
        z=min(2.0,-2.7+1.35*STEP*f64(k))
        route=WalkSubject(3,WorldPoint(0.36,TEST_FLOOR,z),0,1.35)
        walk_update_presentations([],[pilot,route],pilot,STEP)
        shown=walk_presentation(route)
        assert(shown.point.y==TEST_FLOOR and abs(shown.point.x)<0.75)
        if shown.point.x<0.12:moved_left=true
    assert(moved_left)

test "oncoming neighbours pass on their own right without a pilot in the way":
    walk_fixture(0)
    clearance=100.0
    loop k in 0..420:
        z=min(3.2,-2.7+1.35*STEP*f64(k))
        a=WalkSubject(2,WorldPoint(0,TEST_FLOOR,z),0,1.35)
        b=WalkSubject(3,WorldPoint(0,TEST_FLOOR,-z),PI,1.35)
        walk_update_presentations([],[a,b],none,STEP)
        left=walk_presentation(a);right=walk_presentation(b)
        clearance=min(clearance,f64(length(walk_xz(left.point,right.point))))
        if k==419:assert(left.point.z>3.0 and right.point.z< -3.0)
    print("two walkers' minimum clearance {clearance:.3} m")
    assert(clearance>0.50)

test "the pilot's shoulder and the local cap are presentation-only":
    walk_fixture(0)
    pilot=WalkSubject(WALK_PILOT,WorldPoint(0,TEST_FLOOR,0),0,1.7)
    people=[pilot]
    loop i in 0..80:
        s=WalkSubject(i+1,WorldPoint(0.48,TEST_FLOOR,0.32+f64(i)*0.2),PI,0)
        walk_offer(people,s,pilot.point)
    assert(people.len()==WALK_LOCAL_LIMIT and people[0].id==WALK_PILOT)
    loop k in 0..30:walk_update_presentations([],people,pilot,STEP)
    assert(abs(pilot_shoulder)>0.2)
    assert(walk_presentation(pilot).point==pilot.point and walk_presentation(pilot).yaw==pilot.yaw)
    loop k in 0..60:walk_update_presentations([],[pilot],pilot,STEP)
    assert(abs(pilot_shoulder)<0.001)
