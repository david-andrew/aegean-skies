# Wildlife (src/wildlife.jo): where the rafts, colonies and herds are is the world's own and the
# same whatever the camera; a raft moves off from a person walking up and puts up into the air,
# running over the water, for an aircraft taxiing close; gulls come down to perches; herds scatter.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/wildlife_test.jo
use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/world.jo'
use '../src/objects.jo'
use '../src/lake_data.jo'
use '../src/vessel_types.jo'
use '../src/wildlife.jo'
use '../src/wildlife_view.jo'

# (a still lake at 10 m over a flat bed 3 m down, and a shore beyond x = 400)
_lake = WildEnv(ground = (x: f64, z: f64) -> f64: if x > 400.0: 14.0 else: 7.0,
    water = (x: f64, z: f64) -> f64: if x > 400.0: WILD_DRY else: 10.0)

_raft = (env: WildEnv) -> Raft:
    make_raft(WildSite(1234, .raft, vec3(0, 10, 0), radius = 40.0, level = 10.0, out = vec2(-1, 0)), env)

_up = (r: Raft) -> int:
    n = 0
    loop g in r.geese:
        if f64(g.pos.y) > 10.5: n += 1
    n

_run = (r: mut Raft, threats: WildThreat[], env: WildEnv, seconds: f64) -> int:
    marks: WildMark[]; calls: WildCall[]
    loop k in 0..int(seconds * 30.0):
        raft_step(r, threats, env, 1.0 / 30.0, f64(k) / 30.0, marks, calls)
        clear(calls)
    marks.len()

test "a raft is the same birds in the same places each time, sized by the season":
    a = _raft(_lake); b = _raft(_lake)
    assert(a.geese.len() == b.geese.len() and a.geese.len() >= 5 and a.geese.len() <= 32)
    loop k in 0..a.geese.len():
        assert(length(a.geese[k].pos - b.geese[k].pos) == 0.0 and a.geese[k].act == b.geese[k].act)
    # (day 0 is 3 June: a summer raft; 180 days on it is December and they are more)
    assert(wild_winter(180) and wild_summer(0))
    loop key in 0..50:
        assert(wild_raft_count(key, 180) >= wild_raft_count(key, 0))
        assert(wild_raft_count(key, 180) <= 20 and wild_raft_count(key, 0) >= 5)
        assert(wild_raft_present(key, 180))
    # (and roosting at night: all resting, heads down)
    night = _lake; night.hour = 23.0
    loop g in _raft(night).geese: assert(g.act == .rest)

test "a harbour raft is greylags; a lake's has mallards in pairs and coots, and the coots dive":
    harbour = _raft(_lake)
    greylags = 0
    loop g in harbour.geese:
        if g.kind == FOWL_GREYLAG: greylags += 1
        assert(g.kind != FOWL_COOT)
    assert(greylags * 2 > harbour.geese.len())
    coots = 0; drakes = 0; ducks = 0
    loop key in 0..40:
        r = make_raft(WildSite(3000000 + key * 4, .raft, vec3(0, 10, 0), level = 10.0, inland = true), _lake)
        loop g in r.geese:
            if g.kind == FOWL_COOT: coots += 1
            if g.kind == FOWL_DRAKE: drakes += 1
            if g.kind == FOWL_DUCK: ducks += 1
    assert(coots > 20 and drakes > 20 and drakes == ducks)
    r = make_raft(WildSite(3000008, .raft, vec3(0, 10, 0), level = 10.0, inland = true), _lake)
    marks: WildMark[]; calls: WildCall[]
    dived = false
    loop k in 0..30 * 90:
        raft_step(r, [], _lake, 1.0 / 30.0, f64(k) / 30.0, marks, calls)
        clear(calls)
        loop g in r.geese:
            if g.kind == FOWL_COOT:
                assert(g.act != .upend and g.tip < 0.01)
                if g.under > 0.9: dived = true
            else: assert(g.under < 0.01)
    assert(dived)

test "left alone a raft paddles about its water and feeds tail up, and stays afloat":
    r = _raft(_lake)
    marks = _run(r, [], _lake, 60.0)
    assert(r.alarm == 0 and _up(r) == 0)
    upended = false
    loop g in r.geese:
        assert(abs(f64(g.pos.y) - 10.0) < 0.01 and f64(length(g.pos.xz - r.site.at.xz)) < 80.0)
        if g.act == .upend: upended = true
    assert(upended and marks > 0)

test "the take-off trigger: an aircraft taxiing up puts the raft into the air":
    # far off and slow: nothing; at rest close by (moored): nothing
    assert(wild_threat_level(vec3(0, 10, 0), 10.0, WildThreat(vec3(600, 10.5, 0), vec3(-3, 0, 0))) == 0)
    assert(wild_threat_level(vec3(0, 10, 0), 10.0, WildThreat(vec3(50, 10.5, 0), vec3(0, 0, 0))) == 0)
    # taxiing toward them: first they move off, then they go
    assert(wild_threat_level(vec3(0, 10, 0), 10.0, WildThreat(vec3(200, 10.5, 0), vec3(-2, 0, 0))) == 1)
    assert(wild_threat_level(vec3(0, 10, 0), 10.0, WildThreat(vec3(100, 10.5, 0), vec3(-4, 0, 0))) == 2)
    # a take-off run passing close, and an aircraft coming in to land over them
    assert(wild_threat_level(vec3(0, 10, 0), 10.0, WildThreat(vec3(150, 10.5, 40), vec3(-25, 0, 0))) == 2)
    assert(wild_threat_level(vec3(0, 10, 0), 10.0, WildThreat(vec3(300, 40, 0), vec3(-40, -4, 0))) == 2)
    # high overhead: nothing
    assert(wild_threat_level(vec3(0, 10, 0), 10.0, WildThreat(vec3(0, 400, 0), vec3(-50, 0, 0))) == 0)
    r = _raft(_lake)
    plane = WildThreat(vec3(90, 10.5, 0), vec3(-4, 0, 0))
    _run(r, [plane], _lake, 1.0)
    assert(r.alarm == 2)
    # they run over the water first (none up at once), then all fly, low and away
    assert(_up(r) < r.geese.len())
    marks = _run(r, [plane], _lake, 12.0)
    assert(marks > 20)
    # (all but a brood and its parents, who swim off: goslings cannot fly)
    brood = false
    loop g in r.geese:
        if g.young: brood = true
    loop k in 0..r.geese.len():
        g = r.geese[k]
        if g.young or (brood and k < 2 and g.kind == FOWL_GREYLAG):
            assert(g.act == .swim and abs(f64(g.pos.y) - 10.0) < 0.01)
            continue
        assert(g.act == .fly and f64(g.pos.y) < 40.0 and f64(g.pos.x) < -40.0)
        assert(f64(length(g.vel)) > 6.0)
    assert(_up(r) >= 3)

test "someone walking up: the raft moves off, then flies if followed close":
    r = _raft(_lake)
    walker = WildThreat(vec3(30, 10.2, 0), aircraft = false)
    _run(r, [walker], _lake, 5.0)
    assert(r.alarm == 1 and _up(r) == 0)
    assert(f64(r.centre.x) < -1.0)
    close = WildThreat(r.centre + vec3(10, 0.2, 0), aircraft = false)
    _run(r, [close], _lake, 6.0)
    assert(r.alarm == 2 and _up(r) > 0)

test "gulls wheel, come down to the perches and get up again; a herd scatters from a low pass":
    flat = WildEnv(ground = (x: f64, z: f64) -> f64: if x > 0.0: 20.0 else: -5.0, water = (x: f64, z: f64) -> f64: if x > 0.0: WILD_DRY else: 0.0)
    perches = [vec3(5, 21.2, 0), vec3(8, 21.2, 3), vec3(8, 21.2, -3), vec3(12, 24, 0)]
    site = WildSite(77, .colony, vec3(0, 0, 0), count = 6, perches = perches)
    c = make_colony(site, flat)
    calls: WildCall[]
    landed = 0; flew = 0; fastest = 0.0
    gmarks: WildMark[]
    loop k in 0..30 * 120:
        colony_step(c, [], flat, 1.0 / 30.0, f64(k) / 30.0, none, calls, gmarks)
        clear(calls)
        loop g in c.gulls:
            if g.act == .perch: landed += 1
            else: flew += 1
            if g.act == .perch: assert(length(g.pos - perches[g.perch]) < 0.01)
            else:
                assert(f64(g.pos.y) > -5.0 and f64(g.pos.y) < 120.0)
                fastest = max(fastest, f64(length(g.vel)))
    assert(landed > 1000 and flew > 1000)
    print("fastest gull {fastest:.1f}")
    assert(fastest < 20.0)
    # one perch, one gull: never two on it
    loop p in 0..perches.len():
        on = 0
        loop g in c.gulls:
            if g.act == .perch and g.perch == p: on += 1
        assert(on <= 1)
    hill = WildEnv(ground = (x: f64, z: f64) -> f64: 50.0 + x * 0.2, water = (x: f64, z: f64) -> f64: WILD_DRY)
    h = make_herd(WildSite(91, .herd, vec3(0, 50, 0), count = 8), hill)
    pass_low = WildThreat(vec3(-150, 80, 5), vec3(45, 0, 0))
    herd_step(h, [pass_low], hill, 1.0 / 30.0, 0.0, calls)
    running = 0
    loop e in h.beasts:
        if e.act == .run: running += 1
    assert(running == h.beasts.len())
    loop k in 1..30 * 8: herd_step(h, [], hill, 1.0 / 30.0, f64(k) / 30.0, calls)
    loop e in h.beasts:
        assert(e.act != .run and abs(f64(e.pos.y) - (50.0 + f64(e.pos.x) * 0.2)) < 0.01)

test "the places are the world's: found the same from anywhere near, whichever is looked for first":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_settlements(true)
    towns = [loop st in SETTLEMENTS: build_town(st)]
    env = WildEnv(ground = (x: f64, z: f64) -> f64: surface_height(x, z), water = wild_world_water)
    home = towns[0].center
    a = Wildlife(); b = Wildlife()
    wild_scan(a, towns, home, env)
    wild_scan(b, towns, home + vec3(1800, 0, -900), env)
    wild_scan(b, towns, home, env)
    assert(a.sites.len() > 0 and a.sites.len() == b.sites.len())
    kinds: {int: bool} = {}
    loop k in 0..a.sites.len():
        s = a.sites[k]; t = b.sites[k]
        assert(s.key == t.key and s.resident == t.resident and length(s.at - t.at) == 0.0 and s.count == t.count and s.perches.len() == t.perches.len())
        kinds[int(s.kind)] = true
        if s.kind == .raft:
            assert(s.level - surface_height(f64(s.at.x), f64(s.at.z)) >= 0.6)
        if s.kind == .herd:
            assert(wild_world_water(f64(s.at.x), f64(s.at.z)) < -1.0e8 and f64(s.at.y) > 9.0)
    # (rafts, colonies and herds about the islands' home harbour)
    assert(kinds.len() == 3)
    # and the lakes' rafts on the lakes
    lake = SETTLEMENT_LAKES[0]
    c = Wildlife()
    wild_scan(c, towns, vec3(lake.center.x, f32(lake.level), lake.center.y), env)
    on_lake = 0
    loop s in c.sites:
        if s.kind == .raft and abs(s.level - lake.level) < 0.01: on_lake += 1
    assert(on_lake >= 2)
    loop s in a.sites:
        if s.kind == .raft: assert(s.resident)

# (where a bird's head is and which way its bill points, in its own frame: nose -z, up +y)
_head = (g: Goose, flying: bool = false) -> (vec3, vec3):
    _, _, head = fowl_neck_frames(g, fowl_body_frame(g, flying))
    at = (head * vec4(0, 0.03, -0.035, 1)).xyz
    bill = normalize((head * vec4(0, 0, -1, 0)).xyz)
    (at, bill)

test "a goose holds its head as a goose does: level up its neck, ahead in flight, under feeding, on its back asleep":
    g = Goose(pos = vec3(0, 0, 0))
    # swimming: the head well up over the neck's root, level, the bill forward
    at, bill = _head(g)
    assert(f64(at.y) > 0.38 and abs(f64(at.z) + 0.31) < 0.12)
    assert(f64(bill.z) < -0.95 and abs(f64(bill.y)) < 0.15)
    # alert: higher still, straight up
    g.neck = -0.15
    up, _ = _head(g)
    assert(f64(up.y) > f64(at.y))
    # flying: stretched out ahead, the bill forward and nearly level
    g.neck = -1.0
    at, bill = _head(g, true)
    assert(f64(at.z) < -0.55 and f64(at.y) < 0.3 and f64(bill.z) < -0.9)
    # feeding, tipped tail up: the head down under the water, the bill pointing down
    g.neck = 0.0; g.tip = 1.0
    at, bill = _head(g)
    assert(f64(at.y) < -0.1 and f64(bill.y) < -0.5)
    # asleep: the neck folded back, the head on the back facing the tail
    g.tip = 0.0; g.neck = 1.0; g.act = .rest
    at, bill = _head(g)
    assert(f64(at.y) > 0.12 and f64(at.y) < 0.3 and f64(at.z) > -0.2 and f64(bill.z) > 0.5)
    # preening: the head down at one flank, turned toward the tail
    g.act = .preen; g.neck = 0.9
    at, bill = _head(g)
    assert(abs(f64(at.x)) > 0.08 and f64(at.y) < 0.35 and f64(bill.z) > 0.0)
    # a mallard's and a coot's the same way, on their shorter necks
    loop kind in [FOWL_DRAKE, FOWL_COOT]:
        d = Goose(pos = vec3(0, 0, 0), kind = kind)
        at, bill = _head(d)
        assert(f64(at.y) > 0.25 and f64(bill.z) < -0.95)

test "gulls after a caique hauling its nets dive to the water astern, sit, and get up again":
    sea = WildEnv(ground = (x: f64, z: f64) -> f64: -30.0, water = (x: f64, z: f64) -> f64: 0.0)
    boat = Vessel(id = 9, kind = .sail_caique, owner = 1, side = 0, cargo = [], crew = [], position = vec3(0, 0, 0), status = .anchored)
    c = make_colony(WildSite(5000009, .colony, vec3(0, 0, 0), count = 6), sea, 9)
    calls: WildCall[]; marks: WildMark[]
    dives = 0; sat = 0; lowest = 100.0
    loop k in 0..30 * 120:
        colony_step(c, [], sea, 1.0 / 30.0, f64(k) / 30.0, boat, calls, marks)
        clear(calls)
        loop g in c.gulls:
            if g.act == .dive: dives += 1
            if g.act == .sit:
                sat += 1
                assert(abs(f64(g.pos.y)) < 0.01 and f64(length(g.pos.xz)) < 25.0)
            lowest = min(lowest, f64(g.pos.y))
    print("hauling: dive frames {dives} sitting frames {sat} splashes {marks.len()} lowest {lowest:.2f}")
    assert(dives > 30 and sat > 60 and marks.len() > 4 and lowest > -0.05)
