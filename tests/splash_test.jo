use '../src/splash.jo'
use '../src/world_particles.jo'
use '../src/world_point.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/pilot.jo'
use '../src/flight_feedback.jo'
use '../src/sea.jo'

test "splash envelopes preserve every emission sample and RNG draw":
    plain=WorldParticles(gravity=vec3(0,-9.8,0),drag=1.5)
    bodies=WorldParticles(gravity=vec3(0,-9.8,0),drag=1.5,billowing=true)
    seed_random(87)
    loop i in 0..12:emit(plain,WorldPoint(240000.003,0,-190000.007),18,12,vec4(1,1,1,0.9),1.4,0.8,0.9)
    after=random(0.0,1.0)
    seed_random(87)
    loop i in 0..12:emit(bodies,WorldPoint(240000.003,0,-190000.007),18,12,vec4(1,1,1,0.9),1.4,0.8,0.9)
    assert(random(0.0,1.0)==after and plain.items==bodies.items and bodies.billows.len()==12)
    loop i in 0..240:
        plain.update(1.0/120.0);bodies.update(1.0/120.0)
        assert(plain.items==bodies.items)
    assert(bodies.billows.len()==0 and bodies.items.len()==0)

test "painted float fans need wet attached contacts and grow with run speed":
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    s=water_start(k,vec3(0,0,0));s.position.y= -10
    f=Flyer(.gull,0,k,s,cam_pos=s.position)
    ps=WorldParticles()
    f.state.velocity=vec3(0,0,-2)
    assert(splash_instances(f,model,craft_transform(f),ps,vec3(0,0,0),0).len()==0)
    f.state.velocity=vec3(0,0,-100)
    full=splash_instances(f,model,craft_transform(f),ps,vec3(0,0,0),0)
    assert(full.len()>0 and full.len()<=24)
    f.state.moored=true
    assert(splash_instances(f,model,craft_transform(f),ps,vec3(0,0,0),0).len()==0)
    f.state.moored=false
    loop i in 0..7:f.state.damage.parts[i].attached=false
    assert(splash_instances(f,model,craft_transform(f),ps,vec3(0,0,0),0).len()==0)

test "detached splash volumes stay bounded precise and shrink to nothing":
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    f=Flyer(.gull,0,k,CraftState(moored=true),cam_pos=vec3(0,0,0))
    ps=WorldParticles(billowing=true)
    loop i in 0..400:emit(ps,WorldPoint(240000.003,30,-190000.007),6,0,vec4(1,1,1,1),1,0.8)
    assert(ps.billows.len()==256)
    origin=vec3(240000,0,-190000)
    bodies=splash_instances(f,model,craft_transform(f),ps,origin,0)
    assert(bodies.len()==256 and abs(bodies[0].center.x-0.003)<0.00001)
    near=ps
    loop mut b in near.billows:b.point=world_offset(b.point,-origin)
    local=splash_instances(f,model,craft_transform(f),near,vec3(0,0,0),0)
    assert(local==bodies)
    first=ps.billows[0];ps.billows=[first]
    ps.billows[0].age=first.life*0.99
    last=splash_instances(f,model,craft_transform(f),ps,origin,0)
    assert(last.len()==0 or last[0].size.x<0.01)
