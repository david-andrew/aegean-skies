use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_place_context.jo'
use '../src/living_far_types.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_checks.jo'
use '../src/living_trade_opening.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'

opening_trade_fixture = () -> World:
    w=build_world(u64(42)); contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    loop pair in [(100,100),(200,3100),(300,6100)]: contexts.push(LifePlaceContext(pair.0,"Opening port {pair.0}",1,pair.0,vec3(f32(pair.1),0,0)))
    assert(publish_place_contexts(w,1,contexts,[-1,300,-1]))
    seeds=[FarPlaceSeed(100,4000,1,3,productivity=80),FarPlaceSeed(200,80,1,0),FarPlaceSeed(300,2000,1,5,productivity=80,raw_ore=10000000)]
    links=[FarLink(0,100,200,.cart,[vec3(100,0,0),vec3(3100,0,0)],3000000,road=0),FarLink(1,200,300,.cart,[vec3(3100,0,0),vec3(6100,0,0)],3000000,road=1)]
    assert(populate_settlement_economy(w,1,seeds,links))
    w

test "the founding voyage register contains paid real loads on actual routes and never creates goods people or a second voyage":
    w=opening_trade_fixture(); people=far_population(w); roots=w.next_cargo_source
    before=stock_totals(w); seed=w.goods_ledger.opening
    assert(initialize_opening_trade(w)>0)
    assert(not w.far.opening_trade_pending and w.far.completed_journeys==0 and w.minute==0 and w.tick==0)
    loaded=[loop id, j in w.far.journeys: if not j.survey and j.good==3: id]
    assert(loaded.len()>0)
    j=w.far.journeys[loaded[0]]; v=w.far.vehicles[j.vehicle]
    assert(j.provenance.negotiated and j.quantity==v.cargo.qty[3] and v.place== -1)
    assert(j.opening_progress_mm>0 and journey_progress_mm(w,j)==j.opening_progress_mm)
    assert(j.cargo_owner==w.far.districts[j.destination].market_account)
    assert(w.goods_ledger.opening==seed and w.next_cargo_source==roots and far_population(w)==people)
    assert(stock_totals(w)[3]==before[3]) # Real provisions are transferred, not invented or eaten early.
    assert(goods_balance(w) and money_balances(w) and validate_save_world(w)=="",validate_save_world(w))
    text=canonical_text(w); assert(initialize_opening_trade(w)==0 and canonical_text(w)==text)
    saved=from_text[World](text); assert(saved is World and canonical_text(saved)==text)
    assert(initialize_opening_trade(saved)==0 and canonical_text(saved)==text)

test "a declared opening pose advances once under whichever scene owner holds the real carrier":
    w=opening_trade_fixture(); assert(initialize_opening_trade(w)>0)
    id=[loop id, j in w.far.journeys: if j.good==3: id][0]
    j=w.far.journeys[id]; vehicle=j.vehicle; start=journey_progress_mm(w,j)
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(journey_progress_mm(w,w.far.journeys[id])-start==w.far.vehicles[vehicle].speed_mm_sec*2)
    w.far.vehicles[vehicle].scene_owned=true
    start=journey_progress_mm(w,w.far.journeys[id]); w.tick+=120; w.minute=w.tick/120
    far_advance_transport(w,w.tick)
    assert(journey_progress_mm(w,w.far.journeys[id])==start)
    far_advance_transport(w,w.tick,vehicle,true)
    after=journey_progress_mm(w,w.far.journeys[id])
    assert(after-start==w.far.vehicles[vehicle].speed_mm_sec*2)
    far_advance_transport(w,w.tick,vehicle,true)
    assert(journey_progress_mm(w,w.far.journeys[id])==after)
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))

test "a played or already leased fleet never receives reconstructed founding poses":
    loop mode in 0..2:
        w=opening_trade_fixture()
        if mode==0: w.minute=1; w.tick=120
        else: w.far.vehicles[0].scene_owned=true
        positions=[loop v in w.far.vehicles: v.pos]; stock=stock_totals(w)
        cash=[loop a in w.accounts: a.cents]
        assert(initialize_opening_trade(w)==0)
        assert([loop v in w.far.vehicles: v.pos]==positions and stock_totals(w)==stock and [loop a in w.accounts: a.cents]==cash)
