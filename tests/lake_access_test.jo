use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/lake_data.jo'
use '../src/lake_access_data.jo'
use '../src/water_field.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/living_feeder_bake.jo'

test "each inland town has dry walking access to usable elevated moorings":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    assert(LAKE_LANDINGS.len()==SETTLEMENT_LAKES.len())
    loop lake in SETTLEMENT_LAKES:
        s=world_settlements[settlement_by_id[lake.id]]
        assert(s.remote_harbor and s.harbor.len()==2)
        p=settlement_port(s);landing=LAKE_LANDINGS[s.id]
        assert(length(landing.route[0]-s.center)<0.1)
        assert(length(landing.route[landing.route.len()-1]-landing.root)<0.1)
        loop k in 1..landing.route.len():assert(feeder_segment_clear(landing.route[k-1],landing.route[k]),"blocked access in {s.name}")
        loop d in s.harbor:
            r=water_at(f64(d.at.x),f64(d.at.z))
            assert(r.wet and r.id==s.id and abs(r.level-f64(d.at.y))<0.001,"dry mooring {s.name}: {d.at} {r}")
            assert(f64(d.at.y)-place_ground(d.at.xz)>2.0,"shallow mooring {s.name}")
            assert(port_mooring(d.at)!=none)
            landing_point=port_landing(d.at);assert(landing_point!=none)
            assert(f64(landing_point!.y)>lake.level+0.5)
            assert(abs(port_quay_height(landing_point!.xz,place_ground(landing_point!.xz))-f64(landing_point!.y))<0.02)
        previous=f64(landing.root.y)
        loop q in p.quays:
            n=max(1,int(ceil(f64(length(q.b-q.a))*2.0)))
            loop k in 0..n+1:
                at=mix(q.a,q.b,f32(k)/f32(n))
                relative=at.xz-lake.center;side=vec2(-lake.axis.y,lake.axis.x)
                if abs(dot(relative,lake.axis))<=f32(LAKE_CLEAR_RUN*0.5):assert(abs(dot(relative,side))>70.0,"jetty obstructs runway {s.name}")
                h=port_quay_height(at.xz,place_ground(at.xz))
                assert(h>=f64(port_deck(q,f32(k)/f32(n)))-0.01)
                assert(abs(h-previous)<0.8,"jetty step in {s.name}")
                previous=h
