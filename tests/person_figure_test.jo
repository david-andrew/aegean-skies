# The world's women are drawn without a mustache, whatever their trade dresses them in (a woman
# merchant across the hotel table had one).
use '../src/townsfolk.jo'
use '../src/living_content.jo'

test "the seeded women are known as women, and the men as men":
    women = ["Eleni Vassiliou", "Marta Bellini", "Sofia Marinou", "Leila Demir", "Marina Kallergi", "Despina Ralli", "Irene Mavrou", "Maria Sarris", "Aylin Yilmaz", "Lucia Moretti"]
    n = 0
    loop s in PERSON_SEEDS:
        expected = false
        loop w in women:
            if w == s.name: expected = true
        assert(person_woman(s.name) == expected, s.name)
        if expected: n += 1
    assert(n == women.len())

test "far districts' given names: every other one a woman's":
    assert(person_woman("Daphne Vlastos") and person_woman("Mina Celik") and person_woman("Vera Marek"))
    assert(not person_woman("Stavros Vlastos") and not person_woman("Tarik Celik") and not person_woman("Milan Marek"))
