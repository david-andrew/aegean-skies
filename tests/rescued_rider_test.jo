use '../src/rescued_rider.jo'

land = (x: f64, z: f64) -> f64?: if z < 30.0: 1.2 else: none

test "a rescued pilot climbs aboard, rides, climbs out onto the quay and walks off into the town":
    r = rider_board(7, vec3(10,-1.2,0), 0.0, false)
    rider_step(r, 1.0, 1.0/60.0, land)
    assert(r.stage == .boarding)
    rider_step(r, RIDER_CLIMB+0.01, 1.0/60.0, land)
    assert(r.stage == .aboard and r.person == 7)
    # (up out of the water and over the edge: higher in the middle of the climb than a straight line)
    mid = rider_climb_point(vec3(0,-1.2,0), vec3(2,1.0,0), 0.5)
    assert(f64(mid.y) > -0.1+0.5)
    rider_alight(r, vec3(0,2.5,0), vec3(1,1.2,0), vec3(0,0,1), 10.0)
    assert(r.stage == .alighting)
    rider_step(r, 10.0+RIDER_ALIGHT+0.01, 1.0/60.0, land)
    assert(r.stage == .walking)
    start = r.pos
    t = 10.0+RIDER_ALIGHT+0.01
    loop _ in 0..300:
        t += 1.0/60.0
        rider_step(r, t, 1.0/60.0, land)
    assert(r.stage == .walking and f64(r.pos.z-start.z) > 5.0 and abs(f64(r.pos.y)-1.2) < 0.01)
    # (they stop at the water's edge rather than walk into the sea; still in sight, they stay; out of
    # it, they are gone into the town)
    loop _ in 0..60*30:
        t += 1.0/60.0
        rider_step(r, t, 1.0/60.0, land, false)
    assert(r.stage == .walking)
    rider_step(r, t, 1.0/60.0, land, true)
    assert(r.stage == .none)

test "a pilot back aboard after a load is in the seat at once; the wing root when the seat is taken":
    r = rider_seated(3, 5.0, true)
    assert(r.stage == .aboard and r.on_wing)
    seat = vec3(0,1.5,0.8)
    assert(rider_seat(seat, false, 12.0) == seat and rider_seat(seat, true, 12.0) != seat)
