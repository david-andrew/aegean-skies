use '../src/world_terrain.jo'

reference_balance=(input:int[])->int[]:
    selected=input
    loop balance_round in 0..WORLD_CACHE_SLOTS:
        changed = false
        loop ia in 0..selected.len():
            a = world_tiles[selected[ia]]
            loop ib in 0..selected.len():
                b = world_tiles[selected[ib]]
                if b.level <= a.level+1 or world_neighbor_side(a,b) < 0: continue
                level = b.level-1
                x = a.x >> (level-a.level); z = a.z >> (level-a.level)
                key = world_tile_key(x,z,level)
                if not (key in world_cache): continue
                parent = world_cache[key]
                next: int[]
                loop slot in selected:
                    c = world_tiles[slot]
                    if c.level <= level and (c.x>>(level-c.level)) == x and (c.z>>(level-c.level)) == z: continue
                    next.push(slot)
                next.push(parent); selected = next
                changed = true
                break
            if changed: break
        if not changed: break
    selected

test "cached terrain topology preserves balancing, moving morphs and slot reuse":
    world_tiles=[];world_cache={};world_selected=[];world_generated=1
    world_balance_input=[];world_balance_output=[];world_balance_output_keys=[]
    loop level in 0..4:
        loop z in 0..(8>>level):
            loop x in 0..(16>>level):
                key=world_tile_key(x,z,level)
                world_cache[key]=world_tiles.len()
                world_tiles.push(WorldTile(key,x,z,level,0,0,0,1,f64(level)))
    input=[loop z in 0..8:loop x in 0..8:world_cache[world_tile_key(x,z,0)]]
    input.push(world_cache[world_tile_key(1,0,3)])
    expected=reference_balance(input)
    loop iteration in 0..20:
        world_selected=input
        world_balance()
        assert(world_selected==expected)
        world_generated=0
        loop slot in world_selected:world_tiles[slot].lod=f64(world_tiles[slot].level)+f64((iteration+slot)%17)/17.0
        world_prepare_edge_states()
        loop i in 0..world_selected.len():assert(world_cached_edge_state(i)==world_edge_state(world_selected[i]))
    # A recycled slot keeps its index but acquires a different spatial key.
    slot=world_selected[0]
    world_tiles[slot].x+=100;world_tiles[slot].key=world_tile_key(world_tiles[slot].x,world_tiles[slot].z,world_tiles[slot].level)
    world_prepare_edge_states()
    loop i in 0..world_selected.len():assert(world_cached_edge_state(i)==world_edge_state(world_selected[i]))
    # New generation changes which balancing parents can be selected.
    world_generated=1;world_selected=input
    expected=reference_balance(input);world_balance();assert(world_selected==expected)
