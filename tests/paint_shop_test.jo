# The paint shop: only what is changed is charged, a little time for each thing; the aircraft is
# in the shop until the paint is dry, shown masked, primed, then painted; the job and the paint
# round-trip through a save. Other pilots' liveries: one for each pilot, the same every time, made
# with the shop's own tools, kept with the aircraft's record.
use '../src/planes.jo'
use '../src/markings.jo'
use '../src/paint_parts.jo'
use '../src/decals.jo'
use '../src/aircraft_paint.jo'
use '../src/paint_shop.jo'
use '../src/pilot_liveries.jo'
use '../src/living_types.jo'
use '../src/game_session.jo'

let RED = vec4(0.8, 0.1, 0.1, 1)
let WHITE = vec4(0.95, 0.94, 0.9, 1)

test "nothing changed costs nothing and cannot be ordered":
    k = int(Craft.gull)
    q = paint_quote(Paint(kind = k), Paint(kind = k), k)
    assert(q.cents == 0 and q.minutes == 0 and q.items.len() == 0)
    assert(paint_order_refusal(q, 100000) != "")
    # (a paint for another type is as none)
    assert(paint_quote(Paint(kind = 3, livery = 2), Paint(kind = k), k).cents == 0)

test "only what differs is charged: a part, a pattern, a decal, each mark":
    k = int(Craft.gull)
    old = Paint(kind = k)
    new = old
    paint_set_part(new, PartPaint(part = PART_LEFT_WING, a = RED))
    q = paint_quote(old, new, k)
    assert(q.cents == PAINT_PART_CENTS and q.minutes == PAINT_SETUP_MINUTES + PAINT_PART_MINUTES and q.items == ["the left wing"], "{q}")
    paint_set_part(new, PartPaint(part = PART_RIGHT_WING, pattern = PATTERN_STRIPES, a = RED, b = WHITE))
    paint_add_decal(new, Decal(motif = "star", spot = "rudder"))
    new.number = "K-AB3"; new.insignia = INSIGNIA_KALYRA; new.bars = 0
    q = paint_quote(old, new, k)
    assert(q.cents == PAINT_PART_CENTS + PAINT_PATTERN_CENTS + PAINT_DECAL_CENTS + PAINT_SMALL_CENTS * 2 + PAINT_MARK_CENTS, "{q}")
    # (from that paint, one more decal is all that is charged; the same paint again, nothing)
    more = new
    paint_add_decal(more, Decal(motif = "cat", spot = "cowling"))
    assert(paint_quote(new, more, k).cents == PAINT_DECAL_CENTS and paint_quote(new, new, k).cents == 0)
    # (a decal painted out, and a part back in the livery's colours, are work too)
    back = more
    paint_remove_decal(back, 0); paint_clear_part(back, PART_LEFT_WING)
    q = paint_quote(more, back, k)
    assert(q.cents == PAINT_SMALL_CENTS + PAINT_PART_CENTS and "a decal painted out" in q.items, "{q}")

test "a new livery brings its own colours: only those changed over it are extra":
    k = int(Craft.gull)
    new = Paint(kind = k, livery = 2)
    q = paint_quote(Paint(kind = k), new, k)
    assert(q.cents == PAINT_LIVERY_CENTS and q.items == ["a new livery"], "{q}")
    paint_set_colour(new, 0, RED)
    assert(paint_quote(Paint(kind = k), new, k).cents == PAINT_LIVERY_CENTS + PAINT_COLOUR_CENTS)
    # (a colour alone, on the livery she has)
    tinted = Paint(kind = k)
    paint_set_colour(tinted, 2, RED)
    q = paint_quote(Paint(kind = k), tinted, k)
    assert(q.cents == PAINT_COLOUR_CENTS and q.items == ["the wings colour"], "{q}")

test "the longest job is a working day; money short, the order is refused":
    k = int(Craft.gull)
    new = Paint(kind = k, livery = 2)
    loop part in 0..PART_COUNT: paint_set_part(new, PartPaint(part = part, pattern = PATTERN_GRADIENT, a = RED, b = WHITE))
    loop j in 0..DECAL_LIMIT: paint_add_decal(new, Decal(motif = "star", u = f64(j) * 0.05))
    loop slot in 0..4: paint_set_colour(new, slot, vec4(0.3, 0.2 + f32(slot) * 0.1, 0.1, 1))
    q = paint_quote(Paint(kind = k), new, k)
    assert(q.minutes == PAINT_LONGEST_MINUTES and q.cents > 4000)
    assert(paint_order_refusal(q, q.cents - 1) != "" and paint_order_refusal(q, q.cents) == "")
    assert(paint_minutes_text(45) == "45 minutes" and paint_minutes_text(60) == "1 hour" and paint_minutes_text(125) == "2 hours 5 minutes")

test "in the shop: her old paint while she is masked, primer, the new paint without its decals, then all of it":
    k = int(Craft.gull)
    old = Paint(kind = k, number = "K-1")
    new = Paint(kind = k)
    paint_set_part(new, PartPaint(part = PART_FUSELAGE, a = RED))
    paint_add_decal(new, Decal(motif = "star", spot = "rudder"))
    q = paint_quote(old, new, k)
    job = paint_job_begin(new, k, q, 1000, 0, 4)
    assert(job.active and job.ready_minute == 1000 + q.minutes and job.cents == q.cents and job.painter == 4)
    assert(paint_job_look(job, old, 1000) == old and not paint_job_done(job, 1000 + q.minutes - 1))
    primed = paint_job_look(job, old, 1000 + q.minutes / 2)
    assert(primed != old and primed != new and primed.decals.len() == 0 and primed.number == "" and primed.body == primed.wing)
    top = paint_job_look(job, old, 1000 + q.minutes * 9 / 10)
    assert(top.parts == new.parts and top.decals.len() == 0)
    assert(paint_job_done(job, 1000 + q.minutes) and paint_job_look(job, old, 1000 + q.minutes) == new)
    assert(paint_job_left(job, 1010) == q.minutes - 10 and paint_job_left(PaintJob(), 5) == 0)
    assert(paint_job_look(PaintJob(), old, 5) == old and paint_job_progress(PaintJob(), 5) == 1.0)
    # (each stage is a paint the kit can build)
    loop minute in [1000, 1000 + q.minutes / 2, 1000 + q.minutes * 9 / 10, 1000 + q.minutes]:
        assert(paint_build(paint_job_look(job, old, minute), k).body.count > 0)

test "the job and the paint come back from a save as they went, and an old save has neither":
    k = int(Craft.gull)
    new = paint_from_spec("livery=2 part.lwing=stripes:0.8,0.1,0.1:0.9,0.9,0.8:1:6 decal=roundel:wing-top decal=text:fuselage:0.5:12:0.1,0.1,0.1::::K-9", k)
    job = paint_job_begin(new, k, paint_quote(Paint(kind = k), new, k), 4321, 0, 4)
    s = GameSession(paint = new, paint_job = job)
    text = from_text[GameSession](to_text(s))
    if text is GameSession: assert(text.paint == new and text.paint_job == job)
    else: assert(false, "text")
    bytes = from_bytes[GameSession](to_bytes(s))
    if bytes is GameSession: assert(bytes.paint == new and bytes.paint_job == job)
    else: assert(false, "bytes")
    old = from_text[PaintJob]("PaintJob()")
    if old is PaintJob: assert(not old.active)
    else: assert(false)
    # (the aircraft's record keeps a pilot's paint as text)
    r = AircraftRecord(id = 3, kind = .gull, owner = 8, fuel_ml = 0, paint = paint_to_record(new))
    back = from_bytes[AircraftRecord](to_bytes(r))
    if back is AircraftRecord: assert(back.paint == r.paint and paint_from_record(back.paint) == new)
    else: assert(false, "record")
    plain = to_text(AircraftRecord(id = 3, kind = .gull, owner = 8, fuel_ml = 0))
    assert(plain.contains("paint=\"\", "), plain)
    before = from_text[AircraftRecord](plain.replace("paint=\"\", ", ""))
    if before is AircraftRecord: assert(before.paint == "" and paint_from_record(before.paint).kind == -1)
    else: assert(false, "old record")
    assert(paint_from_record("not a paint").kind == -1 and paint_to_record(Paint()) == "")

test "each pilot's livery: the same every time, their own, and made of what the shop offers":
    k = int(Craft.gull)
    seen: str[]
    offered: vec4[]
    loop pal in PALETTES:
        loop sw in pal.1: offered.push(sw.colour)
    loop pilot in 0..40:
        p = pilot_paint(pilot, k, pilot % 6, "Dario Ferraro")
        assert(p == pilot_paint(pilot, k, pilot % 6, "Dario Ferraro"))
        assert(p.kind == k and p.livery == pilot % 6 and paint_active(p, k))
        assert(p.parts.len() >= 2 and p.decals.len() >= 1 and p.decals.len() <= 2, "{pilot}")
        loop q in p.parts: assert(q.part >= 0 and q.part < PART_COUNT and q.a in offered and (q.b.w == 0.0 or q.b in offered))
        loop d in p.decals: assert(decal_motif_index(d.motif) >= 0 and d.spot != "")
        text = paint_to_record(p)
        if not (text in seen): seen.push(text)
        assert(paint_from_record(text) == p)
    # (forty pilots: nearly as many liveries)
    assert(seen.len() >= 36, "{seen.len()}")
    assert(pilot_initials("Dario Ferraro") == "DF" and pilot_initials("") == "")

test "a service's aircraft keep its livery and carry a number; a pirate's is marked boldly":
    k = int(Craft.osprey)
    a = pilot_paint(3, k, 4, "Salvatore Greco", .service); b = pilot_paint(9, k, 4, "Another Officer", .service)
    assert(a.parts.len() == 0 and a.livery == 4 and a.decals.len() == 2 and a.decals[0].motif == "text" and a.decals[0].text.len() == 2)
    assert(a.decals[0].text != b.decals[0].text)
    pirate = pilot_paint(21, k, 3, "Cem Aydin", .pirate)
    assert(pirate.livery == 3 and pirate.parts.len() == 3 and pirate.decals.len() == 1)

test "every type builds in a pilot's livery, with its decals laid on":
    loop id in 0..CRAFT_NAMES.len():
        lv = DEFAULT_LIVERIES[id]
        plain = build_craft(Craft(id), LIVERIES[lv])
        p = pilot_paint(100 + id, id, lv, "Test Pilot")
        m = paint_build(p, id)
        assert(m.body.count > 0 and m.contacts == plain.contacts, CRAFT_NAMES[id])
        assert(m.body.count != plain.body.count or p.decals.len() == 0, CRAFT_NAMES[id])
        assert(m.body.count < plain.body.count + DECAL_CORNERS + 4000, "{CRAFT_NAMES[id]} {m.body.count}")
