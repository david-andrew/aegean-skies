use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_war_types.jo'
use '../src/living_war.jo'
use '../src/living_war_access.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_stock.jo'
use '../src/living_money.jo'
use '../src/living_missions.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

blockade_fixture = () -> World:
    w=commission_fixture()
    w.far.links[0].mode=.ship; w.far.vehicles[0].kind=.ship
    unit=war_charter(w,0,1); assert(unit==0)
    war_supply(w,unit)
    assert(issue_war_order(w,unit,.blockade,200)>=0)
    w

test "only an actual supplied hull at the lane can enforce a blockade":
    w=blockade_fixture()
    assert(blockade_unit(w,200)==0)
    before=canonical_text(w)
    assert(blockade_unit(w,100)== -1 and canonical_text(w)==before)
    w.far.vehicles[0].pos=vec3(10000,0,10000)
    assert(blockade_unit(w,200)== -1)
    w.far.vehicles[0].pos=vec3(100,0,0); w.war.units[0].supplied_until= -1
    assert(blockade_unit(w,200)== -1)

test "a cordon holds paid cargo in its original ship and clears without catch-up movement":
    w=commission_fixture()
    w.far.districts[300].target[0]+=20000
    w.tick=120; w.minute=1
    assert(far_depart(w,1)); journey=w.far.vehicles[1].journey
    w.far.links[0].mode=.ship; w.far.vehicles[0].kind=.ship
    unit=war_charter(w,0,1); war_supply(w,unit)
    assert(issue_war_order(w,unit,.blockade,200)>=0)
    at=w.far.vehicles[1].pos; cargo=w.far.vehicles[1].cargo
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[1].pos==at and w.far.vehicles[1].cargo==cargo)
    assert(w.far.journeys[journey].blocked_by==unit)
    w.war.units[unit].supplied_until= -1
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[1].pos!=at and length(w.far.vehicles[1].pos-at)<14)
    assert(money_balances(w) and goods_balance(w) and far_stock_errors(w).len()==0)

test "smuggling work pays for existing medicine only behind a real cordon":
    w=commission_fixture(); before=canonical_text(w)
    assert(post_mission(w,1,.smuggling,100,200,200,2400)<0 and canonical_text(w)==before)
    w=blockade_fixture(); stock=stock_totals(w); roots=w.next_cargo_source
    id=post_mission(w,1,.smuggling,100,200,200,2400)
    assert(id>=0 and w.war.missions[id].commission>=0)
    parcel=w.far.commissions[w.war.missions[id].commission]
    assert(parcel.kind==.smuggling and parcel.good==6 and parcel.cargo.qty[6]>0)
    assert(stock_totals(w)==stock and w.next_cargo_source==roots and money_balances(w))
