# The spinning propeller disc's per-aircraft data: fades, anchoring, the prop meshes' own sizes.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/prop_disc_test.jo
import '../src/prop_disc.jo' as disc
import '../src/planes.jo' as pl
import '../src/look.jo' as lighting

_frame = translation(vec3(3,4,-5))*rotation_y(0.7)

test "the disc fades in with the shaft speed and the real blades show below it":
    L=lighting.light_at(14)
    idle=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),L,1.0,8.0,10.0,0.0)
    cruise=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),L,1.0,43.0,10.0,0.0)
    full=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),L,1.0,78.0,10.0,0.0)
    assert(idle.spin.x==0.0 and idle.spin.y==0.0)
    assert(cruise.spin.x>0.5 and cruise.spin.x<1.0 and cruise.spin.y>0.2 and cruise.spin.y<0.7)
    assert(full.spin.x==1.0 and full.spin.y==1.0)
    assert(not disc.prop_disc_blurred(8.0) and not disc.prop_disc_blurred(30.0) and disc.prop_disc_blurred(43.0))

test "the disc sits on the hub in the prop's own plane, at the mesh's radius":
    L=lighting.light_at(14)
    d=disc.prop_disc_instance(_frame,1.4,3,vec3(0,0,10),L,2.0,78.0,10.0,0.0)
    assert(length(d.model[3].xyz-vec3(3,4,-5))<0.0601)
    assert(abs(length(d.model[0].xyz)-1.4)<0.00001 and abs(length(d.model[2].xyz)-1.4)<0.00001)
    # the axis stays the craft's own fore-aft axis
    assert(length(normalize(d.model[2].xyz)-_frame[2].xyz)<0.00001)
    assert(abs(length(d.light.xyz)-1.0)<0.0001)
    assert(d.look.x==3.0 and d.look.w==3.0)
    assert(d.spin.z>=0.0 and d.spin.z<f32(TAU/3.0)+0.0001 and d.spin.w>=0.0 and d.spin.w<f32(TAU))

test "the streaks redraw on twos, each drawing at its own blade angle":
    L=lighting.light_at(14)
    # 12 drawings a second (on twos at 24 fps): at 60 Hz each is held for five frames, both
    # its strokes and its angle; between drawings the pattern creeps a fraction of a turn.
    held=0
    loop k in 0..12:
        x=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),L,100.0+78.0*f64(k)/60.0,78.0,10.0+f64(k)/60.0,0.0)
        y=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),L,100.0+78.0*f64(k+1)/60.0,78.0,10.0+f64(k+1)/60.0,0.0)
        step=abs(f64(y.spin.w)-f64(x.spin.w))
        if x.look.y==y.look.y:
            held+=1
            assert(step<0.0005)
        else:
            # the step between drawings, seen modulo a blade spacing, is the strobe alias
            seen=(f64(y.spin.w)-f64(x.spin.w))%PI
            alias=(78.0/12.0)%PI
            assert(abs(seen-alias)<0.002)
    assert(held>=8 and held<=10)

test "the bands precess with the shaft speed: forward, still, back":
    L=lighting.light_at(14)
    seen=(rpm:f64)->f64:
        x=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),L,100.0,rpm,10.0,0.0)
        y=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),L,100.0+rpm/12.0,rpm,10.0+1.0/12.0,0.0)
        d=(f64(y.spin.w)-f64(x.spin.w))%PI
        if d>PI*0.5: d-PI else: d
    assert(seen(78.0)>0.1 and seen(78.0)<0.3)
    assert(abs(seen(24.0*PI))<0.002)
    assert(seen(72.0)< -0.1 and seen(72.0)> -0.4)

test "night dims the streaks but never removes the disc":
    day=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),lighting.light_at(13),1.0,78.0,10.0,0.0)
    night=disc.prop_disc_instance(_frame,1.25,2,vec3(0,0,10),lighting.light_at(23),1.0,78.0,10.0,0.0)
    assert(day.light.w>0.95 and night.light.w<0.2 and night.spin.x==1.0)

test "each prop mesh records its own radius and blade count":
    gull=pl.build_craft(.gull,pl.LIVERIES[0]); heron=pl.build_craft(.heron,pl.LIVERIES[0])
    assert(gull.prop_radius==1.25 and gull.prop_blades==2)
    assert(heron.prop_radius==1.4 and heron.prop_blades==3)
    loop id in 4..pl.CRAFT_NAMES.len():
        m=pl.build_craft(pl.Craft(id),pl.LIVERIES[0])
        assert(m.prop_radius==pl.aircraft_profile(pl.Craft(id)).prop_radius)
        assert(m.prop_blades==2 or m.prop_blades==4)
