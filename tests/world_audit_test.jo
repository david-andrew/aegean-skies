use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/objects.jo'
use '../src/living_far_catalog.jo'
use '../src/living_far_types.jo'
use '../src/settlement_access.jo'
use '../src/world_audit_run.jo'
use '../src/fish_stall.jo'
use '../src/walk_shapes.jo'
use '../src/world_point.jo'
use '../src/town_sites.jo'

# Every harbour leads to its houses, every placed object stands on walkable
# ground, berths swing clear, buildings stand apart and roads reach their
# places. The full ranked report (with the slow harbour walking search) is
# tools/world_audit.jo; reviewed exceptions live in world_audit_allow.txt.
test "the world has no new severe audit findings":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
    catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
    publish_access_roads(catalog.links)
    towns=[loop st in SETTLEMENTS:build_town(st)]
    allowed:{str:bool}
    loop line in split(str_from_bytes(embed('world_audit_allow.txt')),"\n"):
        key=trim(split(line,"#")[0])
        if key!="":allowed[key]=true
    fresh:str[]
    loop f in world_audit_run(towns,"all",{},false):
        if f.severe and not (f.key in allowed):fresh.push("{f.kind} at {f.name} ({f.at}): {f.detail} [{f.key}]")
    assert(fresh.len()==0,"{fresh.len()} new severe world-audit findings:\n"+join(fresh,"\n"))

test "harbours under cliffs climb to their houses by a built stair":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    towns=[loop st in SETTLEMENTS:build_town(st)]
    loop place in [2,5]:
        tw=towns[place]
        # (the stair, and the lane from its top to the houses: tests/first_delivery_test.jo)
        assert(tw.stairs.len()==2,"{tw.name} has no stair and lane")
        stair=tw.stairs[0]
        # Each tread stands on the slope: never far above the ground under it.
        loop k in 1..stair.len()-1:assert(f64(stair[k].y)-surface_height(f64(stair[k].x),f64(stair[k].z))<1.5,"{tw.name} stair floats at {k}")
        # The board and the store are on the quay deck, not on the cliff face.
        board=town_board_spot(tw)
        assert(abs(f64(board.y)-walk_height(towns,f64(board.x),f64(board.z)))<0.3)

test "each harbour town's fish stall stands in the open, and walkers go round it":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    towns=[loop st in SETTLEMENTS:build_town(st)]
    loop place in 0..towns.len():
        st=fish_stall_place(towns,place)
        if not fish_stall_wanted(place):
            assert(not st.found)
            continue
        assert(st.found,"{towns[place].name} has no fish stall spot")
        print("stall {towns[place].name}: {if st.on_quay:"quay" else:"square"} at {st.at} yaw {st.yaw:.2f}")
        assert(fish_stall_trouble(towns,st,fish_stall_keep(towns,place))=="")
        # (the same spot every time: the game and the audit agree)
        again=fish_stall_place(towns,place)
        assert(again.at==st.at and again.yaw==st.yaw)
        # Its trestle and poles are solid: one walking at the counter stops short of it, and one
        # walking along its front passes by.
        walk_publish("fish-stall",fish_stall_solids(st))
        front=fish_stall_front(st)
        p=world_point(fish_stall_customer(st))
        loop k in 0..40:p=walk_step_precise(towns,p,-front.xz*0.05)
        table=fish_stall_solids(st)[0]
        local=site_local(table,vec2(f32(p.x),f32(p.z)))
        assert(f64(abs(local.y))>=table.depth*0.5+0.3,"{towns[place].name}: walked into the stall ({local})")
        walk_publish("fish-stall",[])
