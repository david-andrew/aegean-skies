use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_life.jo'
use '../src/living_social.jo'
use '../src/living_stories.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/living_money.jo'

# Fixed current actors but no pending movement/job may own the subject of a routine test.
_free = (w: mut World, person: int):
    w.people[person].action = Action(activity=.wait,purpose=.visit,end_minute=w.minute+60)
    w.people[person].next_decision_minute = w.minute+60

_clock = (w: mut World, local: int, day: int = 0):
    w.minute = day*1440+local-EPOCH_LOCAL_MINUTE; w.tick = w.minute*120

test "daily intent is clocked by occupation rest Sunday evening and actual weather":
    w = build_world(); _free(w,1)
    _clock(w,630)
    assert(life_daily_goal(w,1).venue == .market)
    _clock(w,810)
    assert(life_daily_goal(w,1).venue == .home and life_daily_goal(w,1).activity == .rest)
    _clock(w,1200)
    assert(life_daily_goal(w,1).venue == .cafe)
    _clock(w,630,6)
    assert(life_daily_goal(w,1).venue == .church)
    w.places[0].harbor_closed = true
    assert(life_daily_goal(w,1).venue == .shelter)
    assert(w.households.len() > 0 and w.people.len() == 26)

test "a scene lease or real porter job forbids a second daily movement owner":
    w = build_world(); _free(w,1)
    _clock(w,1200); life_minute(w)
    before = w.people[1].pose
    w.people[1].move_owner = .scene
    advance_life_motion(w,w.tick+120)
    assert(w.people[1].pose == before)
    w.people[1].move_owner = .abstract_world
    advance_life_motion(w,w.tick+120)
    assert(length(w.people[1].pose.pos-before.pos) <= 2.51)
    w.people[1].carriage = 999
    held = w.people[1].pose
    advance_life_motion(w,w.tick+600)
    assert(w.people[1].pose == held)

test "only actual nearby people at a shared venue meet and exchange":
    w = build_world(); _free(w,1); _free(w,3)
    _clock(w,1200)
    loop person in [1,3]:
        w.people[person].pose.pos = w.harbors[0].center+vec3(0,1.2,0)
        w.daily_life[person].venue = .cafe; w.daily_life[person].arrived = true
        w.daily_life[person].activity = .talk
    social_minute(w)
    assert(w.next_meeting > 0 and w.daily_life[1].meeting == w.daily_life[3].meeting)
    assert(w.speech.len() > 0)
    w.people[3].place = 1
    social_minute(w)
    assert(w.daily_life[1].meeting < 0)

test "social plans and conversation survive a deterministic day without changing the books":
    a = build_world(u64(42)); advance_minutes(a,180)
    parsed = from_text[World](canonical_text(a)); assert(parsed is World)
    b = parsed
    assert(validate_save_world(b) == "")
    advance_minutes(a,1440); advance_minutes(b,1440)
    assert(canonical_text(a) == canonical_text(b))
    assert(money_balances(a) and goods_balance(a) and a.next_meeting > 0)
