use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_guard.jo'
use '../src/living_transaction.jo'
use '../src/living_save.jo'
use '../src/living_money.jo'
use '../src/living_cargo.jo'
use '../src/living_claims.jo'
use '../src/living_portage.jo'

test "strict validation is the default for tests and tools":
    assert(living_strict())

test "a preexisting balance fault skips economic rules without rebasing the ledger or stopping time":
    w = build_world(); w.aircraft[0].fuel_ml += 37
    before = w
    set_living_strict(false)
    defer set_living_strict(true)
    step_minute(w); step_minute(w)
    before.tick = 240; before.minute = 2
    assert(canonical_text(w) == canonical_text(before))
    found = false
    loop fault in living_faults():
        if fault.site == "minute_rules.preexisting_balance":
            found = true; assert(fault.count == 2 and "seed=" in fault.context and "goods=" in fault.context)
    assert(found and not goods_balance(w)) # no invented balancing entry

test "a mid-minute missing physical lot rolls all economic changes back while the clock advances":
    w = build_world(); w.tick = 29*120; w.minute = 29
    ids = cargo_ids(w,.market,0,0)
    loop id in ids: cargo_remove(w,id) # projection remains, forcing the old cargo_consume assertion
    before = w; before.tick = 30*120; before.minute = 30
    set_living_strict(false)
    defer set_living_strict(true)
    step_minute(w)
    assert(canonical_text(w) == canonical_text(before))
    assert(money_balances(w) and goods_balance(w))

test "a failed cargo trade restores price residuals tax cash stock and source partitions":
    w = build_world()
    loop id in cargo_ids(w,.market,0,0): cargo_remove(w,id)
    before = canonical_text(w)
    set_living_strict(false)
    defer set_living_strict(true)
    assert(not trade(w,0,0,0,100,true))
    assert(canonical_text(w) == before and not guard_blocked())

test "a porter payment failure restores the carrying person crate phase and escrow":
    w = build_world(); assert(take_job(w,3,0,.porter))
    task = w.carriage[0]; person = task.person
    # Reach the existing leg with the actual existing lot. Deplete only the funded escrow via
    # a real transfer to exercise failure after the function would have moored the load.
    w.carriage[0].phase = .carry
    w.people[person].pose.pos = task.target
    w.people[person].carrying = task.cargo
    w.cargo[task.cargo].where = .person; w.cargo[task.cargo].person = person
    w.cargo[task.cargo].pos = task.target
    assert(transfer(w,task.escrow,w.people[task.payer].account,w.accounts[task.escrow].cents,.refund))
    before = canonical_text(w)
    set_living_strict(false)
    defer set_living_strict(true)
    cargo_carriage_reached(w,0)
    assert(canonical_text(w) == before)
    assert(w.people[person].carrying == task.cargo and w.carriage[0].phase == .carry)
    assert(not guard_blocked())
