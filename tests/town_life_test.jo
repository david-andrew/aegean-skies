use '../src/town_sites.jo'
use '../src/town_architecture.jo'
use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'

test "oriented footprints keep corners solid and narrow lanes open":
    a=TownSite(vec3(0,0,0),0.3,10,14,9,17)
    corner=site_point(a,4.9,6.9)
    assert(length(site_exclude(a,corner)-corner)>0.1)
    outside=site_point(a,5.5,0)
    assert(length(site_exclude(a,outside)-outside)<0.001)
    center=site_local(a,site_exclude(a,a.at.xz))
    assert(abs(center.x)>5 or abs(center.y)>7)
    assert(site_crosses(a,site_point(a,-10,0),site_point(a,10,0),0.35))
    assert(not site_crosses(a,site_point(a,-10,8),site_point(a,10,8),0.35))

test "architectural kit is deterministic and finite":
    total=0
    loop kind in 0..ARCH_COUNT:
        vs=arch_vertices(kind)
        assert(vs.len()>0 and vs.len()%3==0)
        assert(hash(vs)==hash(arch_vertices(kind)))
        loop v in vs:
            assert(abs(v.pos.x)<10 and abs(v.pos.y)<10 and abs(v.pos.z)<10)
        total+=vs.len()
    assert(total<30000)

test "entrance contact follows rendered treads independently of density":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    site=TownSite(vec3(483.53366,2.2786796,-6327.7705),0.67102,10.653375,12.365658,10.135209,9,2)
    e=site_entry(site)
    lists: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
    props: Instance3D[][]=[loop k in 0..18: []]
    arch_site(lists,props,site,false)
    assert(lists[14].len()==e.steps)
    loop k in 0..e.steps:
        p=mix(e.outside,e.front,f32((f64(k)+0.5)/f64(e.steps)))
        top=transform_point(lists[14][k].model,vec3(0,1,0))
        assert(abs(f64(top.y)-entry_height(e,p,-100))<0.002)
    assert(entry_height(e,e.outside+vec2(20,20),3)==3)
