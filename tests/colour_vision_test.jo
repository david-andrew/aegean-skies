# The colour-blind-friendliness test (docs/accessibility.md). The presets recolour the game for the
# player; the simulation of an eye is only the check, as in Viz Palette, Adobe Color's
# accessibility checker, Coblis and Color Oracle. For each preset, under the eye it is for (each
# dichromacy under both standard models, Machado 2009 and Brettel 1997; no colour as luminance):
#   the three sides apart: CIEDE2000 and CAM02-UCS at least 20 (Petroff 2021's minimum);
#   every mark apart from the sea, sky and cloud behind it (colours sampled from captures):
#     CIEDE2000 at least 15, and a contrast ratio of at least 3:1 (WCAG 2.2 SC 1.4.11);
#   every side's name at 4.5:1 against its ground (WCAG 2.2 SC 1.4.3);
#   shape as a second cue (WCAG 2.2 SC 1.4.1);
#   the war chart's country inks apart from each other and from the chart.
# The standard look is scored the same way under every eye, and its figures pinned, so what a
# player who never opens the setting gets is known and cannot slip unnoticed.
# The first tests check the instruments against their published reference values.
use '../src/colour_vision.jo'
use '../src/side_colours.jo'
use '../src/colour_vision_scores.jo'
import '../src/war_view.jo' as war

_near = (got: f64, want: f64, within: f64) -> bool: abs(got - want) <= within

test "CIEDE2000 reproduces the reference data of Sharma, Wu and Dalal (2005)":
    # (L1 a1 b1 L2 a2 b2 and the difference, from their ciede2000testdata.txt: the pairs that try
    # the hue's wrap-round and the blue region's rotation, some large ones, some near black)
    rows = [[50.0, 2.6772, -79.7751, 50.0, 0.0, -82.7485, 2.0425], [50.0, 3.1571, -77.2803, 50.0, 0.0, -82.7485, 2.8615],
        [50.0, 2.8361, -74.0200, 50.0, 0.0, -82.7485, 3.4412], [50.0, -1.3802, -84.2814, 50.0, 0.0, -82.7485, 1.0000],
        [50.0, -1.1848, -84.8006, 50.0, 0.0, -82.7485, 1.0000], [50.0, -0.9009, -85.5211, 50.0, 0.0, -82.7485, 1.0000],
        [50.0, 0.0, 0.0, 50.0, -1.0, 2.0, 2.3669], [50.0, -1.0, 2.0, 50.0, 0.0, 0.0, 2.3669],
        [50.0, 2.49, -0.001, 50.0, -2.49, 0.0009, 7.1792], [50.0, 2.49, -0.001, 50.0, -2.49, 0.0010, 7.1792],
        [50.0, 2.49, -0.001, 50.0, -2.49, 0.0011, 7.2195], [50.0, 2.49, -0.001, 50.0, -2.49, 0.0012, 7.2195],
        [60.2574, -34.0099, 36.2677, 60.4626, -34.1751, 39.4387, 1.2644], [63.0109, -31.0961, -5.8663, 62.8187, -29.7946, -4.0864, 1.2630],
        [61.2901, 3.7196, -5.3901, 61.4292, 2.2480, -4.9620, 1.8731], [35.0831, -44.1164, 3.7933, 35.0232, -40.0716, 1.5901, 1.8645],
        [22.7233, 20.0904, -46.6940, 23.0331, 14.9730, -42.5619, 2.0373], [36.4612, 47.8580, 18.3852, 36.2715, 50.5065, 21.2231, 1.4146],
        [90.8027, -2.0831, 1.4410, 91.1528, -1.6435, 0.0447, 1.4441], [90.9257, -0.5406, -0.9208, 88.6381, -0.8985, -0.7239, 1.5381],
        [6.7747, -0.2908, -2.4247, 5.8714, -0.0985, -2.2286, 0.6377], [2.0776, 0.0795, -1.1350, 0.9033, -0.0636, -0.5514, 0.9082]]
    loop r in rows:
        got = delta_e_2000(Lab(r[0], r[1], r[2]), Lab(r[3], r[4], r[5]))
        assert(_near(got, r[6], 0.00006), "{r}: {got:.5}")
        # (and the same either way round)
        assert(_near(delta_e_2000(Lab(r[3], r[4], r[5]), Lab(r[0], r[1], r[2])), r[6], 0.00006))
    assert(delta_e_2000(Lab(40.0, 10.0, -20.0), Lab(40.0, 10.0, -20.0)) == 0.0)
    # (white to black in sRGB: 100 apart)
    assert(_near(seen_2000(rgba(0, 0, 0, 1), rgba(1, 1, 1, 1)), 100.0, 0.01))

test "CIECAM02 reproduces the worked examples of CIE 159:2004, and CAM02-UCS is built on it":
    white = [95.05, 100.0, 108.88]
    a = ciecam02([19.01, 20.00, 21.78], white, 318.31, 20.0)
    assert(_near(a.j, 41.73, 0.006) and _near(a.c, 0.1047, 0.00006) and _near(a.m, 0.1088, 0.00006) and _near(a.h, 219.0, 0.06), "{a}")
    b = ciecam02([57.06, 43.06, 31.96], white, 31.83, 20.0)
    assert(_near(b.j, 65.96, 0.006) and _near(b.c, 48.57, 0.006) and _near(b.m, 41.67, 0.006) and _near(b.h, 19.6, 0.06), "{b}")
    # (CAM02-UCS: white at lightness 100 with next to no colour, black at 0, a grey between; and
    # the distance is a distance)
    w = ucs_of(rgba(1, 1, 1, 1)); k = ucs_of(rgba(0, 0, 0, 1)); g = ucs_of(rgba(0.5, 0.5, 0.5, 1))
    assert(_near(w.j, 100.0, 0.001) and abs(w.a) < 3.0 and abs(w.b) < 3.0 and _near(k.j, 0.0, 0.001) and g.j > 40.0 and g.j < 70.0)
    red = rgba(1, 0, 0, 1); blue = rgba(0, 0, 1, 1)
    assert(seen_ucs(red, red) == 0.0 and seen_ucs(red, blue) == seen_ucs(blue, red) and seen_ucs(red, blue) > 50.0)

test "the WCAG contrast ratio: 21:1 for black on white, and the greys either side of 4.5:1":
    white = rgba(1, 1, 1, 1)
    assert(_near(contrast_ratio(rgba(0, 0, 0, 1), white), 21.0, 0.0001) and contrast_ratio(white, white) == 1.0)
    assert(_near(relative_luminance(white), 1.0, 0.0001) and relative_luminance(rgba(0, 0, 0, 1)) == 0.0)
    # (#767676 is the lightest grey that passes 4.5:1 on white; #777777 just fails)
    assert(contrast_ratio(hex_colour("767676"), white) >= 4.5 and contrast_ratio(hex_colour("777777"), white) < 4.5)
    assert(_near(contrast_ratio(hex_colour("767676"), white), 4.54, 0.01))

test "the simulations: white and grey are kept, the two models agree for red-green eyes, no colour is one light":
    grey = rgba(0.5, 0.5, 0.5, 1)
    loop e in ALL_EYES:
        g = seen_by(grey, e); w = seen_by(rgba(1, 1, 1, 1), e)
        assert(abs(f64(g.x) - 0.5) < 0.01 and abs(f64(g.y) - 0.5) < 0.01 and abs(f64(g.z) - 0.5) < 0.01, "{eye_name(e)} {g}")
        assert(f64(w.x) > 0.99 and f64(w.y) > 0.99 and f64(w.z) > 0.99)
    loop d in [Deficiency.protan, Deficiency.deutan, Deficiency.tritan]:
        # (each matrix's rows sum to one: that is what keeps the greys)
        p = brettel_params(d)
        loop m in [machado_matrix(d), p.first, p.second]:
            loop row in 0..3: assert(_near(m[row * 3] + m[row * 3 + 1] + m[row * 3 + 2], 1.0, 0.00002), "{d} {m}")
        # (Brettel's two halves meet on their plane: a colour on it looks the same by either)
        n = p.normal
        on = [0.5, 0.6, -(n[0] * 0.5 + n[1] * 0.6) / n[2]]
        if on[2] < 0.0 or on[2] > 1.0: on = [0.5, -(n[0] * 0.5 + n[2] * 0.6) / n[1], 0.6]
        assert(abs(n[0] * on[0] + n[1] * on[1] + n[2] * on[2]) < 1e-9 and on[1] >= 0.0 and on[1] <= 1.0 and on[2] >= 0.0 and on[2] <= 1.0)
        loop row in 0..3:
            first = p.first[row * 3] * on[0] + p.first[row * 3 + 1] * on[1] + p.first[row * 3 + 2] * on[2]
            second = p.second[row * 3] * on[0] + p.second[row * 3 + 1] * on[1] + p.second[row * 3 + 2] * on[2]
            assert(abs(first - second) < 0.004, "{d} row {row}: {first} {second}")
    # (what each eye famously loses, by either model: red against green, blue against green)
    red = rgba(0.64, 0.16, 0.11, 1); green = rgba(0.27, 0.4, 0.2, 1); blue = rgba(0.14, 0.25, 0.52, 1)
    assert(seen_2000(red, green) > 35.0 and seen_2000(blue, green) > 25.0)
    loop m in [SimModel.machado, SimModel.brettel]:
        assert(seen_2000(red, green, Eye(.protan, m)) < 12.0 and seen_2000(red, green, Eye(.deutan, m)) < 12.0, "{m}")
        assert(seen_2000(blue, green, Eye(.tritan, m)) < 14.0, "{m} {seen_2000(blue, green, Eye(.tritan, m))}")
    # (the two models see the game's own colours nearly alike for red-green eyes; for tritanopia
    # they differ more, which is why every check runs under both)
    loop v in COLOUR_VISIONS:
        loop c in palette_sides(side_palette_for(v)):
            loop d in [Deficiency.protan, Deficiency.deutan]:
                assert(delta_e_2000(lab_of(simulate_colour(c, d, .machado)), lab_of(simulate_colour(c, d, .brettel))) < 8.0, "{v} {c} {d}")
    a = simulate_colour(rgba(0.9, 0.3, 0.1, 1), .achromat)
    assert(a.x == a.y and a.y == a.z)

test "each preset's three sides are far apart to the eye it is for: CIEDE2000 and CAM02-UCS of 20 or more":
    loop v in COLOUR_VISIONS:
        p = side_palette_for(v)
        loop e in preset_eyes(v):
            a = sides_2000(p, e); u = sides_ucs(p, e)
            assert(a.value >= SIDES_APART, "{v} {eye_name(e)}: CIEDE2000 {a.value:.1} ({a.at})")
            assert(u.value >= SIDES_APART, "{v} {eye_name(e)}: CAM02-UCS {u.value:.1} ({u.at})")
    # (the two colour presets well past it: their weakest pair at 45 or more)
    loop v in [ColourVision.red_green, ColourVision.blue_yellow]:
        loop e in preset_eyes(v): assert(sides_2000(side_palette_for(v), e).value >= 45.0)

test "with no colour the sides differ in lightness by far more than the 5 that monochromacy needs":
    p = side_palette_for(.monochrome)
    j = sides_lightness(p, Eye(.achromat))
    assert(j.value >= 4.0 * LIGHTNESS_APART, "{j.value:.1} ({j.at})")
    # (enemy the lightest, friend the darkest, others between: white, a dark mark, a grey)
    assert(relative_luminance(p.enemy) > relative_luminance(p.neutral) and relative_luminance(p.neutral) > relative_luminance(p.ally))
    assert(side_is_dark(p.ally) and not side_is_dark(p.enemy) and not side_is_dark(p.neutral))

test "every mark stands off the sea, sky and cloud behind it: CIEDE2000 of 15 or more, by its colour or its halo":
    loop v in COLOUR_VISIONS:
        p = side_palette_for(v)
        loop e in preset_eyes(v):
            m = mark_off_ground(p, e)
            assert(m.value >= MARK_OFF_GROUND, "{v} {eye_name(e)}: {m.value:.1} ({m.at})")

test "every mark of a preset keeps 3:1 against the sea, sky and cloud behind it (WCAG 1.4.11)":
    loop v in [ColourVision.red_green, ColourVision.blue_yellow, ColourVision.monochrome]:
        p = side_palette_for(v)
        assert(p.firm)
        loop e in preset_eyes(v):
            c = mark_contrast(p, e)
            assert(c.value >= MARK_CONTRAST, "{v} {eye_name(e)}: {c.value:.2}:1 ({c.at})")
            # (how: the mark's two tones are near 9:1 apart, and 9:1 between them leaves 3:1 for
            # one or the other against any ground at all)
            t = tones_contrast(p, e)
            assert(t.value >= 8.0, "{v} {eye_name(e)}: tones {t.value:.1}:1 ({t.at})")

test "every side's name in a preset has 4.5:1 against its ground (WCAG 1.4.3), as each eye sees it":
    loop v in [ColourVision.red_green, ColourVision.blue_yellow, ColourVision.monochrome]:
        p = side_palette_for(v)
        loop e in preset_eyes(v):
            n = name_contrast(p, e)
            assert(n.value >= NAME_CONTRAST, "{v} {eye_name(e)}: {n.value:.1}:1 ({n.at})")

test "a dark mark takes a pale halo and a light mark a dark one":
    loop v in COLOUR_VISIONS:
        p = side_palette_for(v)
        loop c in palette_sides(p):
            ink = palette_halo(p, c)
            if side_is_dark(c): assert(relative_luminance(ink) > 0.8, "{v} {c}")
            else: assert(relative_luminance(ink) < 0.01, "{v} {c}")
    # (one side of each preset is the dark one; none of the standard look is)
    loop c in palette_sides(side_palette_for(.standard)): assert(not side_is_dark(c))
    assert(side_is_dark(side_palette_for(.red_green).neutral) and side_is_dark(side_palette_for(.blue_yellow).neutral) and side_is_dark(side_palette_for(.monochrome).ally))
    # (a firm palette draws its marks whole: a mark asked for at 0.9 is at full strength, one fading still fades)
    set_colour_vision(.red_green)
    assert(side_colour(.enemy, 0.9).w == 1.0 and side_colour(.enemy, 0.45).w == 0.5 and side_colour(.enemy, 0.0).w == 0.0)
    # (the standard look is firm too, with no dark side)
    set_colour_vision(.standard)
    assert(side_palette.firm and side_colour(.enemy, 0.9).w == 1.0 and side_colour(.ally, 0.45).w == 0.5)

test "shape is a second cue in any colours when asked, and always with no colour (WCAG 1.4.1)":
    loop v in COLOUR_VISIONS:
        set_colour_vision(v)
        assert(side_shapes() == (v == ColourVision.monochrome))
        set_colour_vision(v, true)
        assert(side_shapes())
        # (the shapes change nothing of the colours)
        with_shapes = side_palette
        with_shapes.shapes = side_palette_for(v).shapes
        assert(with_shapes == side_palette_for(v))
    set_colour_vision(.monochrome)
    assert(country_hatch(1) != country_hatch(2) and country_hatch(2) != country_hatch(0) and country_hatch(1) != country_hatch(0))
    set_colour_vision(.standard)
    assert(not side_shapes() and country_hatch(1) == country_hatch(2) and country_hatch(2) == country_hatch(0))
    # (the standard look: the first colours, firm like the presets)
    std = side_palette_for(.standard); first = SidePalette()
    assert(std.enemy == first.enemy and std.ally == first.ally and std.neutral == first.neutral and std.firm and not std.shapes)

test "the colours are the established ones: Okabe and Ito's orange, and blue or teal for the friend":
    orange = hex_colour("E69F00")
    loop v in [ColourVision.red_green, ColourVision.blue_yellow]:
        p = side_palette_for(v)
        assert(seen_2000(p.enemy, orange) < 0.5)
        # (never red against green: the enemy is orange, the friend's blue is its strongest part)
        assert(p.ally.z > p.ally.x and (v == ColourVision.blue_yellow or p.ally.z > p.ally.y))
    # (blue-yellow's teal: green and blue both well up, red low)
    by = side_palette_for(.blue_yellow)
    assert(by.ally.y > 0.6 and by.ally.z > 0.6 and by.ally.x < 0.4)
    # (and the chart's inks in the two colour presets: their orange and blue, and black)
    loop v in [ColourVision.red_green, ColourVision.blue_yellow]:
        assert(seen_2000(country_ink_for(v, 1), orange) < 0.5 and seen_2000(country_ink_for(v, 2), hex_colour("0072B2")) < 0.5 and seen_2000(country_ink_for(v, 0), rgba(0, 0, 0, 1)) < 0.5)

test "the standard look, scored under every eye: what a player who never opens the setting gets":
    p = side_palette_for(.standard)
    # (normal sight: sides far apart, every mark off its ground)
    assert(sides_2000(p, Eye()).value >= 30.0 and sides_ucs(p, Eye()).value >= 30.0 and mark_off_ground(p, Eye()).value >= 25.0)
    # (the three dichromacies, by either model: past Petroff's 20 in CAM02-UCS, his own measure;
    # in CIEDE2000 past 20 for protanopia and tritanopia and a little short for deuteranopia,
    # where the red-orange enemy and the cream neutral are closest)
    loop e in ALL_EYES:
        if e.deficiency == .none or e.deficiency == .achromat: continue
        assert(sides_ucs(p, e).value >= SIDES_APART, "{eye_name(e)} {sides_ucs(p, e).value:.1}")
        a = sides_2000(p, e)
        assert(a.value >= (if e.deficiency == .deutan: 17.0 else: SIDES_APART), "{eye_name(e)} {a.value:.1}")
        assert(mark_off_ground(p, e).value >= MARK_OFF_GROUND)
    assert(sides_2000(p, Eye(.deutan)).value < SIDES_APART and sides_2000(p, Eye(.deutan)).at == "enemy/other")
    # (no colour at all: enemy and friend are one light, so there the standard look rests on the
    # signs the targets and people in the water carry; the No colour preset is the remedy)
    assert(sides_2000(p, Eye(.achromat)).value < 10.0 and sides_2000(p, Eye(.achromat)).at == "enemy/friend")
    # (contrast: firm like the presets, its names pass 4.5:1 under every eye; its marks reach
    # 2.9:1 or better on every ground, a hair under 3:1 where the red-orange enemy lies on the
    # far sea, since that colour is 8.2:1 from its halo, not 9:1. With the lighter halo it had
    # before, marks were at about 2.4:1 and names at 2.5:1)
    loop e in ALL_EYES:
        c = mark_contrast(p, e)
        assert(c.value >= 2.9, "{eye_name(e)} {c.value:.2} ({c.at})")
        assert(name_contrast(p, e).value >= NAME_CONTRAST, "{eye_name(e)} {name_contrast(p, e).value:.1}")
    faint = p
    faint.firm = false; faint.halo = 0.7; faint.dark = SidePalette().dark
    assert(mark_contrast(faint, Eye()).value < 2.5 and name_contrast(faint, Eye()).value < 3.0)

test "the war chart's country inks are apart from each other and from the chart in each preset":
    loop v in COLOUR_VISIONS:
        mono = v == ColourVision.monochrome
        inks = chart_inks(v)
        loop e in preset_eyes(v):
            a = inks_2000(inks, e)
            # (with no colour, lightness alone cannot part three inks by 20 on a chart of many
            # tones: 10 between them, and the hatching and the words carry the country)
            assert(a.value >= (if mono: 10.0 else: SIDES_APART), "{v} {eye_name(e)}: {a.value:.1} ({a.at})")
            assert(inks_off_ground(inks, e, CHART_GROUNDS[0]).value >= 20.0, "{v} {eye_name(e)} on paper {inks_off_ground(inks, e, CHART_GROUNDS[0]).value:.1}")
            assert(inks_off_ground(inks, e, CHART_GROUNDS[1]).value >= MARK_OFF_GROUND, "{v} {eye_name(e)} on the chart's sea {inks_off_ground(inks, e, CHART_GROUNDS[1]).value:.1}")
            # (on the land: every preset's inks stand off it; the standard green on the green
            # land is as it always was, about 13)
            loop land in CHART_GROUNDS[2..4]:
                if v != ColourVision.standard: assert(inks_off_ground(inks, e, land).value >= MARK_OFF_GROUND, "{v} {eye_name(e)} {inks_off_ground(inks, e, land).value:.1} ({inks_off_ground(inks, e, land).at})")
    # (why the presets: the standard red and green are one ink to a red-green eye, its blue and
    # green to a blue-yellow one, by either model)
    std = chart_inks(.standard)
    loop m in [SimModel.machado, SimModel.brettel]:
        assert(inks_2000(std, Eye(.protan, m)).value < 12.0 and inks_2000(std, Eye(.deutan, m)).value < 12.0 and inks_2000(std, Eye(.tritan, m)).value < 14.0)
    # (and the colour presets' inks serve every dichromat alike: one set, 35 or more for all)
    loop e in ALL_EYES:
        if e.deficiency != .achromat: assert(inks_2000(chart_inks(.red_green), e).value >= 35.0, eye_name(e))

test "the setting swaps the sides' palette and the chart's inks together":
    loop v in COLOUR_VISIONS:
        set_colour_vision(v)
        assert(side_palette == side_palette_for(v))
        assert(side_colour(.enemy).x == side_palette_for(v).enemy.x and side_colour(.enemy).w == 1.0)
        loop country in 0..3: assert(war.country_ink(country, 0.8) == country_ink_for(v, country, 0.8))
    set_colour_vision(.standard)
    assert(war.country_ink(1) == rgba(0.64, 0.16, 0.11, 1) and side_colour(.ally) == rgba(0.46, 0.72, 1.0, 1.0))
