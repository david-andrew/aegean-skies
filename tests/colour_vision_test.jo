# The colour-vision presets (src/side_colours.jo), checked under a simulation of the eye each is
# for (src/colour_vision.jo): the sides' three colours apart from each other, every mark apart
# from the sea, cloud and sky behind it (by its colour or by its dark halo), the war chart's
# country inks apart on its paper, and with no colour at all, the side carried by shape too.
use '../src/colour_vision.jo'
use '../src/side_colours.jo'
import '../src/war_view.jo' as war

# The eyes a preset is for.
_eyes = (v: ColourVision) -> Deficiency[]:
    match v:
        .standard: [Deficiency.none]
        .red_green: [Deficiency.protan, Deficiency.deutan]
        .blue_yellow: [Deficiency.tritan]
        .monochrome: [Deficiency.achromat]

# What lies behind a mark, measured on captures of the game (tools/colour_vision_view.jo
# sample): the sea deep and in the sun's path, the sky high
# and at the horizon, cloud lit and in shade.
_GROUNDS = [("deep sea", rgba(0.08, 0.25, 0.40, 1)), ("bright sea", rgba(0.15, 0.45, 0.55, 1)), ("high sky", rgba(0.45, 0.68, 0.92, 1)),
    ("horizon", rgba(0.75, 0.85, 0.92, 1)), ("lit cloud", rgba(0.95, 0.95, 0.93, 1)), ("cloud shade", rgba(0.65, 0.70, 0.78, 1))]

_STANDINGS = [Standing.enemy, Standing.ally, Standing.neutral]
_HALO = rgba(0.03, 0.04, 0.05, 1)

test "the simulation: grey stays grey, red and green close up for a red-green eye, no colour is one light":
    loop d in DEFICIENCIES:
        g = simulate_colour(rgba(0.5, 0.5, 0.5, 1), d)
        assert(abs(f64(g.x) - 0.5) < 0.01 and abs(f64(g.y) - 0.5) < 0.01 and abs(f64(g.z) - 0.5) < 0.01, "{deficiency_name(d)} {g}")
        w = simulate_colour(rgba(1, 1, 1, 1), d)
        assert(f64(w.x) > 0.99 and f64(w.y) > 0.99 and f64(w.z) > 0.99)
    red = rgba(0.64, 0.16, 0.11, 1); green = rgba(0.27, 0.4, 0.2, 1); blue = rgba(0.14, 0.25, 0.52, 1)
    assert(seen_distance(red, green, .none) > 60.0)
    assert(seen_distance(red, green, .protan) < 20.0 and seen_distance(red, green, .deutan) < 20.0)
    assert(seen_distance(blue, green, .tritan) < 20.0 and seen_distance(blue, green, .none) > 60.0)
    a = simulate_colour(rgba(0.9, 0.3, 0.1, 1), .achromat)
    assert(a.x == a.y and a.y == a.z)
    assert(colour_distance(rgba(0, 0, 0, 1), rgba(1, 1, 1, 1)) > 99.0 and colour_distance(red, red) == 0.0)

test "each preset's three sides are far apart to the eye it is for":
    loop v in COLOUR_VISIONS:
        p = side_palette_for(v)
        # (with no colour there is only lightness, and all three must still read on the sea: enemy
        # and friend plainly apart, the neutral a step between them, and the shapes carry the rest)
        least = if v == .monochrome: 30.0 else: 45.0
        step = if v == .monochrome: 14.0 else: 45.0
        loop d in _eyes(v):
            assert(seen_distance(p.enemy, p.ally, d) >= least, "{v} {deficiency_name(d)} enemy/friend {seen_distance(p.enemy, p.ally, d):.1}")
            assert(seen_distance(p.enemy, p.neutral, d) >= step, "{v} {deficiency_name(d)} enemy/other {seen_distance(p.enemy, p.neutral, d):.1}")
            assert(seen_distance(p.ally, p.neutral, d) >= step, "{v} {deficiency_name(d)} friend/other {seen_distance(p.ally, p.neutral, d):.1}")
    # (and with no colour, each is light enough for its name to read on the deep sea)
    mono = side_palette_for(.monochrome)
    loop c in [mono.enemy, mono.ally, mono.neutral]: assert(seen_distance(c, rgba(0.08, 0.25, 0.40, 1), .achromat) >= 25.0, "{c}")

test "the red-green preset is orange against blue, never red against green; the blue-yellow, red against teal":
    rg = side_palette_for(.red_green)
    # (orange: red full, green well up, no blue; blue: blue the most)
    assert(rg.enemy.x > 0.9 and rg.enemy.y > 0.45 and rg.enemy.y < 0.75 and rg.enemy.z < 0.2)
    assert(rg.ally.z > rg.ally.x and rg.ally.z > rg.ally.y)
    by = side_palette_for(.blue_yellow)
    assert(by.enemy.x > 0.85 and by.enemy.y < 0.35 and by.enemy.z < 0.35)
    # (teal: green and blue both well up and near each other, red low)
    assert(by.ally.y > 0.6 and by.ally.z > 0.6 and abs(f64(by.ally.y - by.ally.z)) < 0.2 and by.ally.x < 0.4)
    # (and each beats the standard colours for its own eye where the standard is weakest)
    std = side_palette_for(.standard)
    assert(seen_distance(rg.enemy, rg.neutral, .protan) > seen_distance(std.enemy, std.neutral, .protan) + 20.0)
    assert(seen_distance(rg.enemy, rg.neutral, .deutan) > seen_distance(std.enemy, std.neutral, .deutan) + 20.0)
    assert(seen_distance(by.enemy, by.ally, .tritan) > seen_distance(std.enemy, std.ally, .tritan) + 20.0)

test "every side's mark stands off sea, cloud and sky in each preset, by its colour or its halo":
    loop v in COLOUR_VISIONS:
        p = side_palette_for(v)
        loop d in _eyes(v):
            loop s in _STANDINGS:
                c = match s:
                    .enemy: p.enemy
                    .ally: p.ally
                    .neutral: p.neutral
                loop g in _GROUNDS:
                    # (the line itself against the ground; or its halo against the ground and the
                    # line against its halo)
                    halo = colour_over(vec4(_HALO.x, _HALO.y, _HALO.z, f32(p.halo)), g.1)
                    core = seen_distance(c, g.1, d)
                    ringed = min(seen_distance(halo, g.1, d), seen_distance(c, halo, d))
                    assert(max(core, ringed) >= 20.0, "{v} {deficiency_name(d)} {s} on {g.0}: colour {core:.1}, halo {ringed:.1}")

test "with no colour the sides are told by shape and a darker halo; the other presets keep the marks as they were":
    loop v in COLOUR_VISIONS:
        p = side_palette_for(v)
        assert(p.shapes == (v == ColourVision.monochrome))
        assert(if v == ColourVision.monochrome: p.halo > 0.9 else: p.halo == 0.7)
    assert(side_palette_for(.standard) == SidePalette())
    set_colour_vision(.monochrome)
    assert(side_shapes())
    assert(country_hatch(1) != country_hatch(2) and country_hatch(2) != country_hatch(0) and country_hatch(1) != country_hatch(0))
    set_colour_vision(.standard)
    assert(not side_shapes() and country_hatch(1) == country_hatch(2) and country_hatch(2) == country_hatch(0))

test "the war chart's country inks are apart from each other and from the chart in each preset":
    # (the chart's grounds, measured on a capture of the Kalamos channel chart: its paper, its
    # sea, its land light and dark)
    paper = rgba(0.93, 0.88, 0.76, 1); sea = rgba(0.51, 0.64, 0.70, 1)
    lands = [rgba(0.54, 0.56, 0.37, 1), rgba(0.46, 0.50, 0.33, 1)]
    loop v in COLOUR_VISIONS:
        mono = v == ColourVision.monochrome
        loop d in _eyes(v):
            a = country_ink_for(v, 1); b = country_ink_for(v, 2); c = country_ink_for(v, 0)
            said = "{v} {deficiency_name(d)}: {seen_distance(a, b, d):.1} {seen_distance(a, c, d):.1} {seen_distance(b, c, d):.1}"
            # (with no colour: the darkest and lightest plainly apart, the middle a step from
            # each; the hatching and the words carry the rest)
            if mono: assert(seen_distance(a, c, d) >= 30.0 and seen_distance(a, b, d) >= 12.0 and seen_distance(b, c, d) >= 12.0, said)
            else: assert(seen_distance(a, b, d) >= 35.0 and seen_distance(a, c, d) >= 35.0 and seen_distance(b, c, d) >= 35.0, said)
            loop ink in [a, b, c]:
                assert(seen_distance(ink, paper, d) >= 40.0, "{v} {deficiency_name(d)} on paper {seen_distance(ink, paper, d):.1}")
                assert(seen_distance(ink, sea, d) >= 20.0, "{v} {deficiency_name(d)} on the chart's sea {seen_distance(ink, sea, d):.1}")
                # (on the land: the new presets' inks all stand off it; the standard green on the
                # green land is as it was, about 16 to 22; with no colour at least 12)
                loop land in lands:
                    if v != ColourVision.standard: assert(seen_distance(ink, land, d) >= (if mono: 12.0 else: 25.0), "{v} {deficiency_name(d)} on land {seen_distance(ink, land, d):.1}")
    # (why the presets: the standard red and green are one ink to a red-green eye, its blue and
    # green to a blue-yellow one)
    assert(seen_distance(country_ink_for(.standard, 1), country_ink_for(.standard, 0), .protan) < 20.0)
    assert(seen_distance(country_ink_for(.standard, 2), country_ink_for(.standard, 0), .tritan) < 20.0)

test "the setting swaps the sides' palette and the chart's inks together":
    loop v in COLOUR_VISIONS:
        set_colour_vision(v)
        assert(side_palette == side_palette_for(v))
        assert(side_colour(.enemy) == side_palette_for(v).enemy and side_colour(.ally, 0.5).w == 0.5)
        loop country in 0..3: assert(war.country_ink(country, 0.8) == country_ink_for(v, country, 0.8))
    set_colour_vision(.standard)
    assert(war.country_ink(1) == rgba(0.64, 0.16, 0.11, 1) and side_colour(.ally) == rgba(0.46, 0.72, 1.0, 1.0))
