# The rooms by their things: a ray from the eye finds what it points at, the pilot's way across
# the room keeps clear of the furniture, and he gets up, walks, turns and settles by degrees (no
# jump to a new spot at any step).
use '../src/stay.jo'
use '../src/room_walk.jo'

_index = (objs: RoomObject[], thing: RoomThing) -> int:
    loop k in 0..objs.len():
        if objs[k].thing == thing: return k
    -1

test "pointing: the eye's ray finds the bed, the window and the door; the nearest wins; empty floor nothing":
    objs = room_objects(.hotel)
    eye = HOTEL_EYE
    loop thing in [RoomThing.bed, RoomThing.chair, RoomThing.window, RoomThing.door]:
        k = _index(objs, thing)
        mid = (objs[k].lo + objs[k].hi) * 0.5
        assert(room_pick(objs, eye, normalize(mid - eye)) == k, "{thing}")
    # (straight up at the ceiling: nothing)
    assert(room_pick(objs, eye, vec3(0, 1, 0)) == -1)
    # (a ray through two boxes takes the nearer)
    a = RoomObject(.bed, vec3(0, 0, 1), vec3(1, 1, 2), vec3(0, 0, 0), 0.0)
    b = RoomObject(.door, vec3(0, 0, 3), vec3(1, 1, 4), vec3(0, 0, 0), 0.0)
    assert(room_pick([b, a], vec3(0.5, 0.5, 0), vec3(0, 0, 1)) == 1)

test "the way across: straight when clear, round the bed when not, never through furniture":
    rects = room_furniture(.hotel)
    hubs = room_hubs(.hotel)
    objs = room_objects(.hotel)
    # (every thing to every other: each leg of the way keeps clear)
    loop i in 0..objs.len():
        loop j in 0..objs.len():
            if i == j: continue
            path = room_path(objs[i].stand, objs[j].stand, rects, hubs)
            assert(path.len() >= 1 and path[path.len() - 1] == objs[j].stand)
            prev = objs[i].stand
            loop p in path:
                assert(floor_clear(prev, p, rects, ROOM_CLEARANCE * 0.9), "{objs[i].thing} to {objs[j].thing}: {prev} {p}")
                prev = p
    # (the family's house too: from the guest's chair to the bed in the back room goes round the table)
    f = room_objects(.family)
    fr = room_furniture(.family)
    fp = room_path(f[_index(f, .chair)].stand, f[_index(f, .bed)].stand, fr, room_hubs(.family))
    assert(fp.len() >= 2, "{fp}")
    loop i in 0..f.len():
        loop j in 0..f.len():
            if i == j: continue
            path = room_path(f[i].stand, f[j].stand, fr, room_hubs(.family))
            prev = f[i].stand
            loop p in path:
                assert(floor_clear(prev, p, fr, ROOM_CLEARANCE * 0.9), "family {f[i].thing} to {f[j].thing}: {prev} {p}")
                prev = p

test "the pilot gets up, walks, turns and lies down by degrees, never jumping":
    objs = room_objects(.hotel)
    rects = room_furniture(.hotel)
    hubs = room_hubs(.hotel)
    chair = _index(objs, .chair); bed = _index(objs, .bed)
    p = room_pilot_in(objs, chair)
    assert(room_body(p, objs).posture == 1 and room_body(p, objs).amount == 1.0)
    room_go(p, objs, rects, hubs, bed)
    last = room_body(p, objs).pos
    got = -1
    steps = 0
    loop got < 0 and steps < 2000:
        got = room_step(p, objs, 1.0 / 60.0)
        now = room_body(p, objs).pos
        assert(f64(length(now - last)) < 0.06, "a jump at step {steps}: {last} to {now}")
        last = now
        steps += 1
    assert(got == bed, "{got} after {steps}")
    body = room_body(p, objs)
    assert(body.posture == 2 and body.amount == 1.0)
    assert(f64(length(body.pos - objs[bed].rest)) < 0.001)
    # (a few seconds' walk, not an instant nor an age)
    assert(steps > 120 and steps < 900, "{steps}")
    assert(not room_busy(p))

test "getting up out of bed leaves him standing beside it; going to the door says so on arrival":
    objs = room_objects(.hotel)
    bed = _index(objs, .bed); door = _index(objs, .door)
    p = room_pilot_in(objs, bed)
    room_get_up(p)
    loop k in 0..200: assert(room_step(p, objs, 1.0 / 60.0) == -1)
    assert(p.on == -1 and p.going == -1 and p.at == objs[bed].stand)
    assert(room_body(p, objs).posture == 0)
    room_go(p, objs, room_furniture(.hotel), room_hubs(.hotel), door)
    got = -1
    loop k in 0..2000:
        got = room_step(p, objs, 1.0 / 60.0)
        if got >= 0: break
    assert(got == door)
    assert(f64(length(p.at - objs[door].stand)) < 0.001)

test "the labels say what the thing does now":
    objs = room_objects(.hotel)
    bed = objs[_index(objs, .bed)]
    assert(room_label(bed, .hotel, 1320, false, false) == "Sleep")
    assert(room_label(bed, .hotel, 900, false, false) == "Lie down")
    assert(room_label(bed, .hotel, 900, true, false) == "Get up")
    assert(room_label(objs[_index(objs, .window)], .hotel, 900, false, true) == "Back inside")
    f = room_objects(.family)
    assert(room_label(f[_index(f, .door)], .family, 900, false, false) == "Thank them and go")
    # (lying down of an evening: until morning; by day, until the evening)
    assert(room_sleep_until(1260) == 420 and room_sleep_until(200) == 420 and room_sleep_until(700) == 1110)

test "the family's view: the way to the back room keeps a good step from the eye":
    f = room_objects(.family)
    path = room_path(f[_index(f, .chair)].stand, f[_index(f, .bed)].stand, room_furniture(.family), room_hubs(.family))
    prev = f[_index(f, .chair)].stand
    loop p in path:
        # (his head along each leg of the way, a metre or more from the eye)
        loop k in 0..11:
            at = mix(prev, p, f32(f64(k) / 10.0)) + vec3(0, 1.55, 0)
            assert(f64(length(at - FAMILY_EYE)) > 1.1, "{at}")
        prev = p

test "into bed in three thirds: turned about standing, then down on its edge, then round onto it and back":
    objs = room_objects(.hotel)
    bed = _index(objs, .bed)
    p = RoomPilot(at = objs[bed].stand, yaw = objs[bed].face, on = bed, settle = 0.0)
    seen: int[]
    loop k in 0..21:
        p.settle = f64(k) / 20.0
        b = room_body(p, objs)
        if not (b.posture in seen): seen.push(b.posture)
    # (standing, sitting on the edge, lying back, lain: in that order)
    assert(seen == [0, 1, 3, 2], "{seen}")
    out = objs[bed].face + PI
    # (the first third: turning where he stands, upright, not moved)
    p.settle = 1.0 / 6.0
    turning = room_body(p, objs)
    assert(turning.posture == 0 and f64(length(turning.pos - objs[bed].stand)) < 1e-4)
    # (a third in: standing at the stand point, his back to the bed, not yet lowered)
    p.settle = 1.0 / 3.0
    turned = room_body(p, objs)
    assert(abs(turned.amount) < 1e-9 and f64(length(turned.pos - objs[bed].stand)) < 1e-4, "{turned.pos}")
    assert(abs(sin(turned.yaw - out)) < 1e-4 and cos(turned.yaw - out) > 0.0, "{turned.yaw}")
    # (half way: sitting down onto the edge, still facing away)
    p.settle = 0.5
    sitting = room_body(p, objs)
    assert(sitting.posture == 1 and sitting.amount > 0.4 and sitting.amount < 0.6 and abs(sin(sitting.yaw - out)) < 1e-4)
    # (two thirds in: sat on the edge, facing away, about to lie back)
    p.settle = 2.0 / 3.0
    mid = room_body(p, objs)
    assert(mid.posture == 3 and mid.amount < 1e-6 and f64(length(mid.pos - room_bed_edge(objs[bed]))) < 1e-3, "{mid.pos}")
    assert(abs(sin(mid.yaw - out)) < 1e-4 and cos(mid.yaw - out) > 0.0)
