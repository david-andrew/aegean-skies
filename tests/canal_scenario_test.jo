use '../src/chase_collision.jo'
use '../src/world_point.jo'
use '../src/river_field.jo'
use '../src/river_data.jo'
use '../src/pilot.jo'
use '../src/vessels.jo'
use '../src/vessel_scene.jo'
use '../src/scenarios.jo'
use '../src/settlements.jo'
use '../src/world.jo'
use '../src/world_towns.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/combat.jo'
use '../src/canal_geometry.jo'
use '../src/vessel_types.jo'
use '../src/tweaks.jo'
import '../src/living_types.jo' as data
import '../src/living_checks.jo' as checks
import '../src/living_save.jo' as saves

test "canal scenario starts repaired afloat with finite pursuers and local traffic":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    models=build_craft_models()
    s=build_scenario("canal",towns,models)!
    errors=checks.invariant_errors(s.world)
    assert(errors.len()==0,"{errors}")
    assert(saves.validate_save_world(s.world)=="")
    assert(s.mode==.aboard and s.flyer.state.on_water and not s.flyer.state.moored)
    assert(length(s.position-canal_launch)<4 and s.flyer.state.throttle>0)
    assert(s.flyer.state.hull_damage==0 and s.flyer.state.engine_damage==0)
    assert(s.vessels.ships.len()==12)
    hostile=0
    loop actor in s.battle.actors:
        assert(actor.rally==canal_launch and actor.engagement==s.battle.engagement)
        if actor.side==2:
            hostile+=1
            assert(actor.gun.ammo>0 and actor.state.fuel>0 and not actor.external)
            assert(length(actor.state.position-canal_launch)>1000 and length(actor.state.position-canal_launch)<2500)
    assert(hostile==2)
    again=build_scenario("canal",towns,models)!
    assert(saves.canonical_hash(s.world)==saves.canonical_hash(again.world))
    assert(to_text(s.battle)==to_text(again.battle) and to_text(s.vessels)==to_text(again.vessels))
    f=s.flyer
    plan=FlightPlan(takeoff_heading=canal_heading,target=canal_launch+heading_vector(canal_heading)*5000.0,altitude=f64(canal_launch.y)+180.0)
    loop tick in 0..2400:
        if f.state.position.y<canal_launch.y+45.0:
            station=canal_station(f.state.position)
            target=RIVER_NODES[min(CANAL_FINISH,station+(if station>=CANAL_BEGIN+35 and station<=CANAL_BEGIN+45:6 else:5))]
            direction=normalize(vec3(target.x-f.state.position.x,0,target.y-f.state.position.z))
            plan.takeoff_heading=atan2(f64(direction.x),-f64(direction.z))
            plan.target=f.state.position+direction*5000.0
        e=flight_env(f.state.time,f.state.position)
        previous=f.state.position
        step_vessels(s.vessels,vec2(0,0),1.0/60.0,f.state.position,f.state.velocity)
        controls=autopilot(f.spec,f.state,plan,e)
        if f.state.on_water:
            velocity_heading=atan2(f64(f.state.velocity.x),-f64(f.state.velocity.z))
            controls.yaw=clamp(angle_delta(plan.takeoff_heading,heading(f.state))*4.0+angle_delta(plan.takeoff_heading,velocity_heading)*2.0,-1.0,1.0)
        step(f.spec,f.state,controls,e,1.0/60.0)
        collide_vessels(s.vessels,f.spec,f.state,previous,s.world.people[s.world.player].craft)
        f.sea_t=f.state.time
        chase(f,1.0/60.0)
        frame=clear_chase_camera(f,target_chase_camera(f,vec3(0,0,-1),0),1.0/60.0,towns)
        assert(camera_clear_fraction(f.state.position,world_vec(frame.eye),0.8,towns)>0.999,"camera occluded at tick {tick}")
    assert(not f.state.crashed and f.state.hull_damage==0 and f.state.position.y>canal_launch.y+45.0,"scenario departure {f.state.position} damage={f.state.hull_damage}")
