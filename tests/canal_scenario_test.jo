canal_fixture = () -> (Town[],CraftModel[]):
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    (towns,build_craft_models())

# Down the slipway until the yard hands over; returns the steps taken.
run_slipway = (f: mut Flyer, towns: Town[]) -> int:
    l=start_slip_launch(f)
    ticks=0;splashed=false
    loop l.active:
        assert(ticks<60*20,"slipway launch never handed over")
        previous=f.state.position
        _=step_slip_launch(l,f,1.0/60.0,f64(ticks)/60.0)
        if l.splash:splashed=true
        assert(not f.state.crashed and f.state.hull_damage==0,"slipway damage at {ticks}")
        if l.phase==.sliding or l.phase==.waiting:
            # (on the ways: the floats ride the cradle, which rides the ramp; never under the ways)
            assert(f.state.position.y>=slip_point(l.z).y+f32(SLIP_CRADLE+f.spec.float_height)-0.05)
            assert(length(f.state.position-previous)<0.3)
        chase(f,1.0/60.0)
        frame=clear_chase_camera(f,target_chase_camera(f,vec3(0,0,-1),0),1.0/60.0,towns)
        assert(is_finite(frame.eye.x) and is_finite(frame.view.x))
        ticks+=1
    assert(splashed and f.state.on_water,"no splash into the canal")
    ticks

test "canal scenario starts repaired on the slipway with finite pursuers, ground fire and local traffic":
    towns,models=canal_fixture()
    s=build_scenario("canal",towns,models)!
    errors=checks.invariant_errors(s.world)
    assert(errors.len()==0,"{errors}")
    assert(saves.validate_save_world(s.world)=="")
    assert(s.mode==.aboard and s.slipway and not s.flyer.state.on_water and not s.flyer.state.moored)
    # (on the cradle at the head of the ways, inside the workshop, engine running)
    assert(length(s.position.xz-slip_point(SLIP_START).xz)<0.5 and s.flyer.state.throttle>0)
    assert(length(s.position.xz-canal_workshop.xz)<8)
    # (the shop's centre, the workshop's standing point, stays level floor in front of the ways)
    assert(abs(canal_floor(f64(canal_workshop.x),f64(canal_workshop.z),f64(canal_workshop.y)+0.1)-f64(canal_workshop.y))<0.05)
    assert(not canal_on_ways(canal_workshop.xz))
    assert(s.flyer.state.hull_damage==0 and s.flyer.state.engine_damage==0)
    assert(s.vessels.ships.len()==CANAL_VESSELS)
    hostile=0
    loop actor in s.battle.actors:
        assert(actor.rally==canal_launch and actor.engagement==s.battle.engagement)
        if actor.side==2:
            hostile+=1
            assert(actor.gun.ammo>0 and actor.state.fuel>0 and not actor.external)
            # (far enough back that they reach gun range a few seconds after the hand-over)
            assert(length(actor.state.position-canal_launch)>3500 and length(actor.state.position-canal_launch)<5500)
    assert(hostile==2)
    # Ground fire: Orenthian posts on roofs, bridges and quays, holding fire through the launch.
    assert(s.battle.ground.len()>=8)
    guns=0
    loop g in s.battle.ground:
        assert(g.side==2 and g.id<0 and not g.disabled and g.wake>=int(CANAL_LAUNCH_SECONDS*60.0))
        if g.kind==.machine_gun:guns+=1
        # (standing on something solid: a roof, a deck or a quay, not hanging in the air)
        stand=g.position.y-(if g.kind==.rifle:1.45 else:0.48)
        top=canal_floor(f64(g.position.x),f64(g.position.z),f64(stand)+0.2)
        # (within the parapet slab drawn over a flat roof: 0.3 m)
        assert(f64(stand)-top>-0.05 and f64(stand)-top<0.35,"post {g.id} floats at {stand} over {top}")
    assert(guns>=2)
    # The slipway stays clear: anyone the world puts on the ways is shown on the floor beside them.
    loop z in [SLIP_TOP,6.0,14.0,SLIP_WATER-1.0]:
        assert(canal_on_ways(slip_point(z).xz))
        q=canal_off_ways(slip_point(z))
        assert(not canal_on_ways(q.xz) and abs(canal_floor(f64(q.x),f64(q.z),f64(canal_workshop.y)+1.0)-f64(canal_workshop.y))<0.3,"{z}: {q}")
    assert(not canal_on_ways(canal_launch.xz) and canal_off_ways(canal_launch)==canal_launch)
    again=build_scenario("canal",towns,models)!
    assert(saves.canonical_hash(s.world)==saves.canonical_hash(again.world))
    assert(to_text(s.battle)==to_text(again.battle) and to_text(s.vessels)==to_text(again.vessels))
    f=s.flyer
    launch=run_slipway(f,towns)
    # The yard hands her over afloat near the old start, facing down the canal, unhurt.
    assert(launch<60*14 and length(f.state.position.xz-canal_launch.xz)<30)
    assert(abs(angle_delta(canal_heading,heading(f.state)))<0.35 and f.state.hull_damage==0)
    plan=FlightPlan(takeoff_heading=canal_heading,target=canal_launch+heading_vector(canal_heading)*5000.0,altitude=f64(canal_launch.y)+180.0)
    loop tick in 0..2400:
        e=flight_env(f.state.time,f.state.position)
        previous=f.state.position
        step_vessels(s.vessels,vec2(0,0),1.0/60.0,f.state.position,f.state.velocity)
        controls=canal_run_controls(f,plan,e)
        step(f.spec,f.state,controls,e,1.0/60.0)
        collide_vessels(s.vessels,f.spec,f.state,previous,s.world.people[s.world.player].craft)
        f.sea_t=f.state.time
        chase(f,1.0/60.0)
        frame=clear_chase_camera(f,target_chase_camera(f,vec3(0,0,-1),0),1.0/60.0,towns)
        assert(camera_clear_fraction(f.state.position,world_vec(frame.eye),0.8,towns)>0.999,"camera occluded at tick {tick}")
    assert(not f.state.crashed and f.state.hull_damage==0 and f.state.position.y>canal_launch.y+45.0,"scenario departure {f.state.position} damage={f.state.hull_damage}")

test "canal ground fire stays present through the run without stopping the takeoff":
    towns,models=canal_fixture()
    s=build_scenario("canal",towns,models)!
    f=s.flyer;b=s.battle
    me=combat_index(b,s.world.people[s.world.player].craft)
    # (the pursuers are a separate threat: the ground's own share is measured here)
    loop i in 0..b.actors.len():
        if b.actors[i].side==2:b.actors[i].present=false
    l=start_slip_launch(f)
    plan=FlightPlan(takeoff_heading=canal_heading,target=canal_launch+heading_vector(canal_heading)*5000.0,altitude=f64(canal_launch.y)+180.0)
    shots=0;hits=0;near=0;airborne=-1;lifted=-1;early=0;climbing=0;hull=0.0
    loop tick in 0..60*45:
        clock=f64(tick)/60.0
        previous=f.state.position
        if l.active:_=step_slip_launch(l,f,1.0/60.0,clock)
        else:
            e=flight_env(f.state.time,f.state.position)
            step(f.spec,f.state,canal_run_controls(f,plan,e),e,1.0/60.0)
        b.actors[me].previous=previous;b.actors[me].previous_point=world_point(previous);b.actors[me].state=f.state
        step_battle(b,flight_env(clock,f.state.position),f.state.position)
        f.state=b.actors[me].state
        loop ev in b.events:
            if ev.kind==.shot and ev.craft<0:
                shots+=1
                if l.active:early+=1
                if lifted>=0:climbing+=1
            if ev.kind==.hit and ev.craft==b.actors[me].craft:
                assert(ev.other<0,"only the ground is shooting here")
                hits+=1
        loop sw in b.sweeps:
            if sw.owner<0:
                d=sw.end-sw.start;a=f.state.position-sw.start
                u=clamp(f64(dot(a,d))/max(f64(dot(d,d)),0.0001),0.0,1.0)
                if length(a-d*f32(u))<15:near+=1
        # (lifted off: out of the cut, the posts' fire at her climbing away; airborne: clear of the town)
        if lifted<0 and not l.active and not f.state.on_water and f.state.position.y>canal_launch.y+8.0:lifted=tick
        if airborne<0 and f.state.position.y>canal_launch.y+45.0:airborne=tick;hull=f.state.hull_damage
    print("GROUND FIRE shots {shots} (after lift-off {climbing}) hits {hits} near passes {near} hull at lift-off {hull:.3} final {f.state.hull_damage:.3} engine {f.state.engine_damage:.3} airborne at {f64(airborne)/60.0:.1}s")
    assert(early==0,"the posts fired during the slipway launch")
    assert(airborne>0 and not f.state.crashed,"ground fire stopped the takeoff")
    assert(hits>=1 and hits<=10 and hull<0.08 and f.state.engine_damage<0.2,"unfair: {hits} hits, hull {hull}")
    # (the allied courier draws some of the fire too, as the dogfight brain flies it)
    assert(near>=15 and shots>=40 and climbing>=5,"too quiet: {shots} shots, {near} near passes, {climbing} after lift-off")
