# The paper at the coffee house: made from what the town has heard (its news, its people's
# telegrams, its market), read-only, and bought once a day by one transfer.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/leisure.jo'
use '../src/newspaper.jo'

_total = (w: World) -> int:
    t = 0
    loop a in w.accounts: t += a.cents
    t

test "a day's paper: the town's news, every legal good's price, the weather, the notices given":
    w = build_world(u64(3))
    advance_minutes(w, 600)
    before = canonical_hash(w)
    p = newspaper(w, 0, [PaperPiece("Notices", "Wanted: oil to Mikra", "Pays well.", 0)])
    assert(canonical_hash(w) == before)
    assert(p.title == "The Porto Vecchio Courier")
    assert(p.dateline.contains("1929"))
    legal = 0
    loop g in w.goods:
        if not g.illegal: legal += 1
    assert(p.prices.len() == legal)
    loop row in p.prices: assert(row.here > 0)
    assert(p.weather != "")
    notices = 0; news = 0
    loop piece in p.pieces:
        if piece.section == "Notices": notices += 1
        else: news += 1
        assert(piece.head != "" and piece.body != "")
        assert(not piece.body.contains("Heard:"))
    assert(notices == 1)
    print("the paper has {news} news pieces, lead: {if let l = p.lead: l.head else: "none"}")
    # edited, not logged: cargoes in one item, no sentence twice, a lead, and a small advert or two
    loop piece in p.pieces:
        sentences = split(piece.body, ". ")
        loop i in 0..sentences.len():
            loop j in i + 1..sentences.len(): assert(sentences[i] != sentences[j])
        assert(not piece.body.contains("brought goods to"))
    cargo_items = 0; ads = 0
    loop piece in p.pieces:
        if piece.body.contains("landed"): cargo_items += 1
        if piece.section == "Advertisements": ads += 1
    if let l = p.lead:
        if l.body.contains("landed"): cargo_items += 1
    assert(cargo_items <= 1)
    assert(ads >= 1 and ads <= 2)
    assert(news > 0)
    # (sections in the paper's order)
    last = -1
    loop piece in p.pieces:
        r = 0
        loop k in 0..PAPER_SECTIONS.len():
            if PAPER_SECTIONS[k] == piece.section: r = k
        assert(r >= last)
        last = r

test "the paper is bought once a day, by a transfer to the coffee house":
    w = build_world(u64(3))
    lp = LeisurePlace("coffee", 0, .coffee_house, "The coffee house", "kafeneio", 3, opens = 360, closes = 1320, menu = "coffee")
    state = LeisureState()
    total = _total(w); mine = w.accounts[w.people[w.player].account].cents
    a = leisure_buy_paper(w, lp, state, PAPER_CENTS)
    assert(a.ok and a.cents == PAPER_CENTS)
    b = leisure_buy_paper(w, lp, state, PAPER_CENTS)
    assert(b.ok and b.cents == 0)
    assert(w.accounts[w.people[w.player].account].cents == mine - PAPER_CENTS and _total(w) == total)
    advance_minutes(w, 1440)
    total = _total(w); mine = w.accounts[w.people[w.player].account].cents
    c = leisure_buy_paper(w, lp, state, PAPER_CENTS)
    assert(c.ok and c.cents == PAPER_CENTS and _total(w) == total)
    assert(w.accounts[w.people[w.player].account].cents == mine - PAPER_CENTS)
