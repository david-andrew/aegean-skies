# The look's highlight goes by each lookable thing's own shape (glossary: Things to tap;
# src/look_outline.jo, src/look_things.jo): every kind of thing has one, none falls back to a box
# where the mask can be drawn, and nothing lookable can be made without saying its kind.
use '../src/look_outline.jo'
use '../src/look_things.jo'
use '../src/bar_scene.jo'
use '../src/bar_room.jo'
use '../src/thermal_sites.jo'
use '../src/stay.jo'
use '../src/room_walk.jo'

_root = () -> str: if is_dir("src"): "" else: "../"

_read = (path: str) -> str:
    body = read_file(_root() + path)
    assert(body is str, "cannot read {path}")
    if body is str: return body
    ""

# every source of the game, as (path, text)
_sources = () -> (str, str)[]:
    out = [("aegean.jo", _read("aegean.jo"))]
    names = list_dir(_root() + "src")
    if names is str[]:
        loop name in names:
            if name.ends_with(".jo"): out.push(("src/" + name, _read("src/" + name)))
    assert(out.len() > 100, "{out.len()} sources")
    out

# The kinds as the enum's own lines name them (so a kind added there is a kind checked here).
_kind_names = () -> str[]:
    out: str[]
    inside = false
    loop row in split(_read("src/look_outline.jo"), "\n"):
        if row.starts_with("enum LookKind:"):
            inside = true
            continue
        if not inside: continue
        if not row.starts_with("    "): break
        name = split(row.trim(), " ")[0]
        if name != "" and not name.starts_with("#"): out.push(name)
    out

_kinds = () -> LookKind[]:
    names = _kind_names()
    assert(names.len() >= 18, "{names}")
    out: LookKind[]
    loop i in 0..names.len():
        k = LookKind(i)
        assert("{k}" == names[i], "kind {i} is {k}, the enum's line says {names[i]}")
        out.push(k)
    out

_bounds = (vs: Vertex3D[]) -> (vec3, vec3):
    lo = vec3(1e9, 1e9, 1e9); hi = vec3(-1e9, -1e9, -1e9)
    loop v in vs:
        lo = vec3(min(lo.x, v.pos.x), min(lo.y, v.pos.y), min(lo.z, v.pos.z))
        hi = vec3(max(hi.x, v.pos.x), max(hi.y, v.pos.y), max(hi.z, v.pos.z))
    (lo, hi)

# the arguments of each call of `name(` in a source's code (not its comments, nor its definition)
_calls = (text: str, name: str) -> str[]:
    out: str[]
    loop row in split(text, "\n"):
        code = row.trim()
        if code.starts_with("#") or code.starts_with("struct ") or code.starts_with(name + " = "): continue
        parts = split(code, name + "(")
        loop i in 1..parts.len():
            # (a longer name that ends the same, as draw_thing(, is another function)
            before = parts[i - 1]
            last = if before.len() > 0: before[before.len() - 1..before.len()] else: " "
            if last == "_" or (last >= "a" and last <= "z") or (last >= "A" and last <= "Z") or (last >= "0" and last <= "9"): continue
            out.push(parts[i])
    out

test "every lookable kind has a shape of its own: drawn by the scene and taken, or a small mesh with vertices":
    sources = _sources()
    loop k in _kinds():
        shape = look_shape_of(k)
        if shape == .drawn:
            assert(look_parts(k) == 0 and look_vertices(k).len() == 0, "{k}")
            # (a person's figure is taken by draw_folk for look_folk; the rest where look_on names them)
            mark = if k == .person: "look_capturing = k == look_folk" else: "look_on(.{k})"
            taken = false
            loop s in sources:
                if s.0 != "src/look_outline.jo" and s.1.contains(mark): taken = true
            assert(taken, "{k} is a drawn kind, but nothing in the scene takes it ({mark})")
            continue
        n = look_parts(k)
        assert(n >= 1, "{k} has no parts")
        loop part in 0..n:
            # (a room's window is the hotel's alone)
            if k == .room_window and part > 0: continue
            vs = look_vertices(k, part)
            assert(vs.len() >= 12 and vs.len() % 3 == 0, "{k} {part}: {vs.len()} vertices")
            # (a thing, not a scene: the pool is the largest, under 12 m across)
            lo, hi = _bounds(vs)
            assert(f64(length(hi - lo)) < 18.0 and f64(hi.x - lo.x) > 0.05 and f64(hi.y - lo.y) > 0.05, "{k} {part}: {lo} {hi}")

test "nothing lookable is made without its kind, and every kind is something that can be looked at":
    text = _read("aegean.jo")
    names = _kind_names()
    used: str[]
    made = 0
    loop name in ["_thing", "FootThing"]:
        loop args in _calls(text, name):
            first = split(split(args, ",")[0], ")")[0].trim()
            assert(first.starts_with(".") and names.contains(first[1..first.len()]), "{name}({args[0..min(args.len(), 60)]}: the first thing said must be its kind")
            used.push(first[1..first.len()])
            made += 1
    assert(made >= 16, "{made} things found in aegean.jo")
    # (a room's things have theirs by src/look_things.jo room_look_kind)
    loop t in [RoomThing.bed, RoomThing.chair, RoomThing.window, RoomThing.door]: used.push("{room_look_kind(t)}")
    loop name in names: assert(used.contains(name), "{name} is a kind nothing lookable has")

test "the box's outline and a room's brighter redraw are only for where the mask cannot be drawn":
    text = _read("aegean.jo")
    n = 0
    loop row in split(text, "\n"):
        code = row.trim()
        if code.starts_with("#") or code.starts_with("draw_look = "): continue
        if code.contains(" draw_look(") or code.starts_with("draw_look("):
            assert(code.contains("not look_outline_available()"), code)
            n += 1
        if code.contains("lit < things[mode].len()"): assert(code.contains("not look_outline_available()"), code)
    assert(n == 1, "{n} uses of the box's outline")

test "the bandstand's shape is its platform and what stands on it, and it moves into the bar room with the stand":
    lo, hi = _bounds(bandstand_vertices())
    s = vec3(-12.5, f32(DECK), 27.8)
    # (the platform 4.2 by 5.6, from the deck up; the microphone its highest thing)
    assert(abs(f64(lo.x) - (f64(s.x) - 2.1)) < 0.01 and abs(f64(hi.x) - (f64(s.x) + 2.1)) < 0.01, "{lo} {hi}")
    assert(abs(f64(lo.z) - (f64(s.z) - 2.8)) < 0.01 and abs(f64(hi.z) - (f64(s.z) + 2.8)) < 0.01, "{lo} {hi}")
    assert(abs(f64(lo.y) - DECK) < 0.01 and f64(hi.y) > DECK + 1.7 and f64(hi.y) < DECK + 2.0, "{lo} {hi}")
    # (the room's stand, table and stools are the terrace's, shifted: the shapes are placed so)
    assert(f64(length(vec3(s.x, 0, s.z) + ROOM_STAGE_SHIFT - ROOM_STAGE)) < 0.001)
    t_lo, t_hi = _bounds(hotel_table_vertices(hotel_table_count() - 1))
    mid = (t_lo + t_hi) * 0.5
    assert(f64(length(vec3(mid.x, 0, mid.z) - TERRACE_PLAYER_TABLE)) < 0.02, "{mid}")
    loop k in 0..hotel_table_count():
        a, b = _bounds(hotel_table_vertices(k))
        # (a table: from the deck to its top, its cloth's size)
        assert(abs(f64(a.y) - DECK) < 0.01 and abs(f64(b.y) - (DECK + TABLE_TOP)) < 0.01, "{k}: {a} {b}")
        if k < 4: assert(f64(length(vec3((a.x + b.x) * 0.5, 0, (a.z + b.z) * 0.5) - TERRACE_TABLES[k])) < 0.02)

test "a room's every thing has its own vertices, in the hotel's room and in each family's house":
    loop room in 0..1 + ROOM_TRADES:
        objs = room_objects(if room == 0: StayKind.hotel else: StayKind.family)
        assert(objs.len() >= 3)
        loop o in objs:
            vs = room_thing_vertices(room, o.thing)
            assert(vs.len() >= 12, "room {room} {o.thing}: {vs.len()}")
            # (its vertices are where its pointing box is: their middle within it, a hand's breadth)
            lo, hi = _bounds(vs)
            mid = (lo + hi) * 0.5
            grow = vec3(0.45, 0.45, 0.45)
            assert(clamp(mid, o.lo - grow, o.hi + grow) == mid, "room {room} {o.thing}: {mid} not in {o.lo} {o.hi}")

test "the hot pool's shape is its water and the stone round it, at each of the springs":
    loop k in 0..THERMAL_SITES.len():
        site = THERMAL_SITES[k]
        lo, hi = _bounds(look_vertices(.hot_pool, k))
        # (about the site's centre: the pool's middle, its coping 0.8 m beyond the water's 4.4)
        c = thermal_pool(site) - site.center
        mid = (lo + hi) * 0.5
        assert(f64(length(vec2(mid.x - c.x, mid.z - c.z))) < 0.05, "{mid} {c}")
        assert(abs(f64(hi.x - lo.x) - 10.4) < 0.1 and abs(f64(hi.z - lo.z) - 10.4) < 0.1, "{lo} {hi}")
        # (nothing of it under the paving; its top the coping's, a quarter metre over the water)
        assert(abs(f64(hi.y) - (f64(c.y) + 0.25)) < 0.02 and f64(hi.y - lo.y) < 0.5, "{lo} {hi} {c}")
