# A boat in trouble at sea (src/living_adrift.jo): it really lies on the water where its lane runs,
# its trip held so it is overdue and the town worries (the lead); found, it comes home by the pilot
# taking the crew aboard, a line to another boat, or the harbour's launch; left alone, the lost
# find their way and the others are brought in late the next day. What the pilot did goes into his
# name and his talk. Saved and loaded as it lies.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/life_types.jo'
use '../src/living_boats.jo'
use '../src/living_adrift.jo'
use '../src/adrift_types.jo'
use '../src/reputation_types.jo'
use '../src/reputation.jo'
use '../src/reputation_talk.jo'
use '../src/pilot_day_types.jo'
use '../src/pilot_talk.jo'
use '../src/leads.jo'
use '../src/world_bytes.jo'

# The next morning's fishing: Kostas (12) out from Kalamos, in trouble at once (`cause`).
_out = (cause: AdriftCause) -> (World, int):
    w = build_world(u64(3))
    advance_minutes(w,(1440-570)+5*60+35)     # 05:35 the next day, before the boats are out
    trip = if w.people[12].trip >= 0 and w.trips[w.people[12].trip].reason.purpose == .fishing: w.people[12].trip else: begin_fishing(w,12)
    assert(trip >= 0)
    i = adrift_begin(w,trip,cause)
    assert(i >= 0)
    (w,i)

_dist_to_route = (route: vec3[], p: vec3) -> f64:
    best = 1e18
    loop k in 0..route.len()-1:
        a = route[k]; b = route[k+1]; ab = b-a
        u = clamp(f64(dot(p-a,ab))/max(f64(dot(ab,ab)),1e-6),0.0,1.0)
        best = min(best,f64(length(a+ab*f32(u)-p)))
    best

# (the newest worry about them)
_story = (w: World, person: int) -> int:
    best = -1
    loop id, s in w.stories:
        if s.kind == .missing_boat and s.actors.len() > 0 and s.actors[0] == person and id > best: best = id
    best

test "it lies out on the water, on its lane, held there, overdue; the town worries":
    w, i = _out(.engine)
    a = w.adrift[i]
    route = w.sea_routes[a.route]
    home = w.harbors[a.home].center
    d = f64(length(a.at-home))
    assert(d > 1200.0 and d < 6000.0,"{d}")
    assert(_dist_to_route(route,a.at) < 1.0)
    # (hours on, past the hour it was due in: drifted a little, along the lane, and still out there)
    advance_minutes(w,420)
    b = w.adrift[i]
    assert(b.state == .adrift and _dist_to_route(route,b.at) < 1.0 and f64(length(b.at-a.at)) > 300.0)
    assert(w.people[12].trip == a.trip and w.people[12].place < 0)
    assert(f64(length(w.people[12].pose.pos-b.at)) < 1.0)
    # (overdue: the worry, and the lead people mention)
    s = _story(w,12)
    assert(s >= 0 and not w.stories[s].resolved,"story {s} at {local_minute(w.minute)} eta {w.trips[a.trip].eta_tick/120}")
    told = 0
    loop speaker in 1..w.people.len():
        loop l in leads_for(w,speaker,[]):
            if l.kind == .overdue and l.subject == s:
                assert(lead_line(w,l,speaker,0).contains("Kostas"))
                told += 1
    assert(told > 0)

test "taken aboard and set ashore: home, the worry over, and the pilot's name and talk know it":
    w, i = _out(.mast)
    advance_minutes(w,300)
    s = _story(w,12)
    assert(adrift_take_aboard(w,i))
    assert(adrift_set_ashore(w,i,w.adrift[i].home))
    advance_minutes(w,2)
    assert(w.people[12].place == w.people[12].home and w.people[12].trip < 0)
    assert(s < 0 or w.stories[s].resolved)
    found = [loop d in w.rep.deeds: if d.kind == .found_boat and d.other == 12: d]
    assert(found.len() == 1)
    # (Kostas remembers who came for him)
    rel = w.relationship_index.get(RelationshipKey(12,w.player),-1)
    assert(rel >= 0 and w.relationships[rel].affinity > 0)
    day = pilot_on_day(w,w.pilot_day,0)
    assert(day.contains("Kostas") or day.contains("boat"),day)
    assert(pilot_on_deed(found[0],0) != "")

test "a line to another boat out fishing, or the harbour told: home a while later":
    w, i = _out(.engine)
    # (another boat out near: one of the other fishers not in trouble themselves, put on the same water)
    mate = -1
    loop q in [7,18]:
        tq = w.people[q].trip
        if mate < 0 and (tq < 0 or not adrift_holds(w,tq)):
            trip = if tq >= 0 and w.trips[tq].reason.purpose == .fishing: tq else: begin_fishing(w,q)
            if trip >= 0: mate = q
    assert(mate >= 0)
    w.people[mate].pose.pos = w.adrift[i].at+vec3(400,0,0)
    helper = adrift_tow_boat(w,i,3000.0)
    assert(helper == mate,"{helper}")
    minutes = adrift_tow(w,i,helper)
    assert(minutes > 0)
    advance_minutes(w,minutes+2)
    assert(w.adrift[i].state == .home and w.trips[w.adrift[i].trip].state == .arrived and w.trips[w.adrift[i].trip].destination == w.people[12].home)
    assert([loop d in w.rep.deeds: if d.kind == .found_boat: d].len() == 1)
    v, j = _out(.engine)
    assert(adrift_report(v,j) < 0)          # (not found yet: nothing to tell)
    adrift_found(v,j)
    minutes = adrift_report(v,j)
    assert(minutes > 15)
    advance_minutes(v,minutes-5)
    assert(v.adrift[j].state == .reported)
    advance_minutes(v,7)
    assert(v.adrift[j].state == .home and v.trips[v.adrift[j].trip].state == .arrived and v.trips[v.adrift[j].trip].destination == v.people[12].home)
    assert([loop d in v.rep.deeds: if d.kind == .found_boat: d].len() == 1)

test "left alone: the lost find their way, the others are brought in next day; no credit":
    w, i = _out(.lost)
    advance_minutes(w,ADRIFT_LOST_HOME+2)
    assert(w.adrift[i].state == .home and w.trips[w.adrift[i].trip].state == .arrived)
    v, j = _out(.engine)
    advance_minutes(v,ADRIFT_LOST_HOME+2)
    assert(v.adrift[j].state == .adrift)
    advance_minutes(v,ADRIFT_PASSING-ADRIFT_LOST_HOME)
    assert(v.adrift[j].state == .home)
    assert([loop d in w.rep.deeds: if d.kind == .found_boat: d].len() == 0)
    assert([loop d in v.rep.deeds: if d.kind == .found_boat: d].len() == 0)

test "saved and loaded as it lies; the same seed, the same troubles":
    w, i = _out(.engine)
    advance_minutes(w,120)
    got = world_from_bytes(world_to_bytes(w))
    if got is TextError: panic("{got}")
    a = got; b = w
    advance_minutes(a,240); advance_minutes(b,240)
    assert(a.adrift == b.adrift and a.people[12].pose.pos == b.people[12].pose.pos)
    # (left to themselves for days, two worlds of one seed have the same troubles)
    x = build_world(u64(21)); y = build_world(u64(21))
    advance_minutes(x,4*1440); advance_minutes(y,4*1440)
    assert(x.adrift == y.adrift)
