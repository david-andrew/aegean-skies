# The house behind the service: what is ordered takes its time to make and is carried out; what
# comes back is set down at the pass and dealt with in the open (glasses washed, dried and put back
# on the shelf by the barkeep; plates taken in at the kitchen's hatch). Nothing leaves a table, or
# arrives on one, without a waiter there.
use '../src/leisure_menu.jo'
use '../src/leisure.jo'
use '../src/table_service.jo'
use '../src/house_service.jo'

let PASS = vec3(0, 0, 0)
_spots = (x: f64) -> ServiceSpots: ServiceSpots(vec3(0, 0, 0), vec3(f32(x), 0, 6), vec3(f32(x + 0.8), 0.75, 6), vec3(1, 0, 0), vec3(0, 0, 1))
_flat = (x: f64, z: f64) -> f64: 0.0
_hs = () -> HouseSpots: HouseSpots(vec3(-0.5, 1.1, 0.5), vec3(0.5, 1.1, -0.5), vec3(0.5, 0, -0.6), vec3(-1.0, 0, -0.4), vec3(-1.5, 1.1, 0.2), vec3(-2.0, 0.8, -1.2), vec3(-1, 0, 0), vec3(-3.0, 0, -0.4))

_find = (name: str) -> MenuItem:
    loop d in HOTEL_FOOD:
        if d.name == name: return d
    loop d in drinks_catalogue():
        if d.name == name: return d
    drinks_catalogue()[0]

# a frame of the house: the kitchen, the waiter, the barkeep (free when not serving)
_step = (sc: mut Scullery, wt: mut Waiter, bk: mut Waiter, tables: mut HouseTable[], dt: f64):
    house_kitchen_step(sc, dt, bk.stage == 0 or bk.stage >= 10)
    house_waiter_step(wt, sc, tables, dt, _flat)
    house_barkeep_step(bk, sc, _hs(), dt, true, _flat)

_run = (sc: mut Scullery, wt: mut Waiter, bk: mut Waiter, tables: mut HouseTable[], seconds: f64):
    loop k in 0..int(seconds / 0.05): _step(sc, wt, bk, tables, 0.05)

test "drinks are poured in moments, dishes take minutes, and a full house is slower":
    beer = _find("Fix"); fish = _find("Grilled fish of the day"); bread = _find("Bread and olives")
    assert(prep_seconds(beer) < 45.0)
    assert(prep_seconds(fish) >= 120.0)
    assert(prep_seconds(bread) < prep_seconds(fish))
    assert(prep_seconds(fish, 6) > prep_seconds(fish, 0) * 1.3)

test "served only after it is made, carried out by the waiter, never put straight on the table":
    sc = Scullery(); wt = Waiter(); bk = Waiter()
    tables = [HouseTable(-1, _spots(8.0))]
    fish = _find("Grilled fish of the day")
    house_order(sc, Served(fish, 0, 0), -1, 0)
    _run(sc, wt, bk, tables, prep_seconds(fish) - 5.0)
    assert(tables[0].served.len() == 0 and wt.tray.len() == 0 and sc.making.len() == 1)
    _run(sc, wt, bk, tables, 6.0)
    # (made: out on the sill, then on his tray, on its way)
    assert(sc.making.len() == 0 and tables[0].served.len() == 0)
    assert(wt.tray.len() == 1 and wt.stage == 1)
    _run(sc, wt, bk, tables, 15.0)
    assert(tables[0].served.len() == 1)

test "each table gets its own order, the pilot's first":
    sc = Scullery(); wt = Waiter(); bk = Waiter()
    tables = [HouseTable(-1, _spots(8.0)), HouseTable(0, _spots(-6.0))]
    beer = _find("Fix")
    house_order(sc, Served(beer, 0, 0), 0, 0)
    house_order(sc, Served(beer, 0, 1), -1, 0)
    _run(sc, wt, bk, tables, 120.0)
    assert(tables[0].served.len() == 1 and tables[1].served.len() == 1)

test "an empty goes back to the pass, is washed, dried and put on the shelf: never just gone":
    sc = Scullery(shelf = 5); wt = Waiter(); bk = Waiter()
    glass = Served(_find("Fix"), 0, 0, amount = 0.0, empty_for = 60.0)
    plate = Served(_find("Meze plate"), 0, 1, amount = 0.0, empty_for = 60.0)
    tables = [HouseTable(-1, _spots(8.0), [glass, plate])]
    seen_dirty = false; seen_drain = false; seen_hands = false; seen_plate = false
    total = 2
    loop k in 0..int(90.0 / 0.05):
        _step(sc, wt, bk, tables, 0.05)
        # (the empties are always somewhere: on the table, the tray, the pass, the sink, the
        # drainer, the shelf or with the kitchen)
        where = tables[0].served.len() + wt.tray.len() + wt.dropped.len() + sc.dirty.len() + sc.hands.len() + sc.drainer.len() + sc.plates.len() + (sc.shelf - 5)
        if sc.plates.len() == 0 and seen_plate: where += 1
        assert(where == total)
        if sc.dirty.len() > 0: seen_dirty = true
        if sc.drainer.len() > 0: seen_drain = true
        if sc.hands.len() > 0: seen_hands = true
        if sc.plates.len() > 0: seen_plate = true
    assert(seen_dirty and seen_drain and seen_hands and seen_plate)
    assert(sc.shelf == 6 and sc.plates.len() == 0 and tables[0].served.len() == 0)

test "a table left with food on it keeps it until the waiter clears it, then it is carried back":
    sc = Scullery(); wt = Waiter(); bk = Waiter()
    tables = [HouseTable(-2, _spots(8.0), [Served(_find("Meze plate"), 0, 0, amount = 0.6)])]
    _run(sc, wt, bk, tables, 30.0)
    assert(tables[0].served.len() == 1)
    tables[0].clear_all = true
    _run(sc, wt, bk, tables, 4.0)
    assert(tables[0].served.len() == 1)
    _run(sc, wt, bk, tables, 30.0)
    assert(tables[0].served.len() == 0)
    assert(sc.plates.len() + (if sc.cook_take < COOK_TAKE: 0 else: 0) <= 1)

test "a table gone mid-trip: what he carries goes back to the pass":
    sc = Scullery(); wt = Waiter(); bk = Waiter()
    tables = [HouseTable(0, _spots(-6.0))]
    house_order(sc, Served(_find("Fix"), 0, 0), 0, 0)
    loop k in 0..2000:
        if wt.stage == 1 and wt.clock > 1.0: break
        _step(sc, wt, bk, tables, 0.05)
    assert(wt.tray.len() == 1 and wt.stage == 1)
    none_left: HouseTable[]
    _run(sc, wt, bk, none_left, 20.0)
    assert(wt.tray.len() == 0 and wt.stage == 0)
    assert(sc.dirty.len() + sc.hands.len() + sc.drainer.len() + sc.shelf == 10)

