import '../src/living_world.jo' as living

test "coordinator facade constructs ticks and projects without graphics":
    w = living.build_world(u64(42))
    assert(living.scene_requests(w).len() == 1)
    assert(living.airborne_trips(w)[0].reason.actor == 2)
    assert(living.board_lines(w,0).len() >= 2)
    assert("medicine" in living.proximity_speech(w,1))
    living.tick(w,600)
    assert(w.minute == 5 and living.boat_markers(w).len() == 3)
    assert(living.invariant_errors(w).len() == 0)
