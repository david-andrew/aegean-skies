# The player's aircraft repainted: as built, nothing changes; a paint changes the colours and the
# marks the type can wear, and only those; the choices offered follow the type's nation; a paint
# for another type is ignored; old games without one load as built.
use '../src/planes.jo'
use '../src/markings.jo'
use '../src/aircraft_paint.jo'

_count = (kind: int) -> (Livery) -> int: (lv: Livery) -> int: build_craft(Craft(kind), lv).body.count

_name = (kind: Craft) -> str: CRAFT_NAMES[int(kind)]

test "as built, every type is drawn exactly as before (the new livery fields left alone)":
    loop id in 0..CRAFT_NAMES.len():
        lv = LIVERIES[DEFAULT_LIVERIES[id]]
        # (the defaults: the insignia from `marking`, the type's own rudder, no number)
        assert(lv.insignia == -1 and lv.bars == -1 and lv.rudder == -1 and lv.number == "")
        assert(not paint_active(Paint(), id) and not paint_active(Paint(kind = id), id))
        same = paint_livery(Paint(kind = id), id)
        assert(same.body == lv.body and same.trim == lv.trim and same.wing == lv.wing and same.accent == lv.accent)

test "the game's two countries' marks are where `marking` put them":
    assert(livery_insignia(LIVERIES[0]) == INSIGNIA_NONE and livery_bars(LIVERIES[0]))
    assert(livery_insignia(LIVERIES[4]) == INSIGNIA_KALYRA and not livery_bars(LIVERIES[4]))
    assert(livery_insignia(LIVERIES[2]) == INSIGNIA_ORENTHIA)

test "a type's wings and rudder take marks where its builder draws them":
    # (the first four: wing marks only when repainted; the catalog types and the early fighters
    # always; the big boats' bars; the racers' rudders)
    loop k in [Craft.gull, Craft.heron, Craft.corsair, Craft.falco, Craft.tern, Craft.macchi_m5, Craft.sm_s55]:
        s = paint_support(int(k), _name(k), _count(int(k)))
        assert(s.wing_marks, _name(k))
    loop k in [Craft.gull, Craft.heron, Craft.corsair, Craft.tern, Craft.macchi_m5, Craft.curtiss_r3c2]:
        s = paint_support(int(k), _name(k), _count(int(k)))
        assert(s.rudder_marks, _name(k))
    s55 = paint_support(int(Craft.sm_s55), "S.55", _count(int(Craft.sm_s55)))
    assert(not s55.rudder_marks)

test "a number and an insignia add geometry, and only when asked for":
    k = int(Craft.gull)
    base = LIVERIES[0]
    n = _count(k)(base)
    numbered = base
    numbered.number = "K-AB3"
    assert(_count(k)(numbered) > n)
    marked = paint_livery(Paint(kind = k, insignia = INSIGNIA_KALYRA, bars = 0), k)
    assert(_count(k)(marked) > n)
    striped = base
    striped.rudder = 4
    assert(_count(k)(striped) > n)

test "the insignia and stripes offered follow the type's nation":
    italian = paint_support(int(Craft.macchi_m5), "Macchi M.5", _count(int(Craft.macchi_m5)))
    keys = [loop k in italian.insignia: INSIGNIA[k].key]
    assert("none" in keys and "kalyra" in keys and "orenthia" in keys and "italy" in keys)
    assert(not ("britain" in keys) and not ("usa" in keys))
    gull = paint_support(int(Craft.gull), "Gull", _count(int(Craft.gull)))
    assert([loop k in gull.insignia: INSIGNIA[k].key] == ["none", "kalyra", "orenthia"])
    assert(not ("italy" in [loop k in gull.rudders: RUDDERS[k].key]))
    # (a nation added for a type shows its marks with no other change)
    assert("germany" in [loop k in insignia_for(type_nations("Do X")): INSIGNIA[k].key])

test "the liveries offered: the type's own first, then the civil ones and its family's":
    l = liveries_for("Macchi M.5", DEFAULT_LIVERIES[int(Craft.macchi_m5)], LIVERIES.len())
    assert(l[0] == DEFAULT_LIVERIES[int(Craft.macchi_m5)])
    loop k in 0..6: assert(k in l)
    loop k in 14..19: assert(k in l)
    assert(not (10 in l))
    # (a livery no family claims is worn by the types whose default it is)
    assert(liveries_for("X", 40, 41)[0] == 40)

test "colours change the livery, a new base livery drops them, reset brings back the type's own":
    k = int(Craft.heron)
    p = Paint(kind = k)
    paint_set_colour(p, 0, rgb(0.2, 0.3, 0.6))
    assert(paint_active(p, k) and paint_livery(p, k).body == rgb(0.2, 0.3, 0.6))
    assert("main" in paint_changes(p, k))
    paint_choose_livery(p, 3)
    assert(paint_livery(p, k).body == LIVERIES[3].body)
    assert(paint_changes(paint_reset(k), k).len() == 0)
    # (another type's paint is not this one's)
    assert(not paint_active(p, int(Craft.gull)))

test "a free colour by hue, saturation and brightness comes back as it went":
    loop c in [rgb(0.78, 0.18, 0.12), rgb(0.2, 0.33, 0.62), rgb(0.88, 0.84, 0.7), rgb(0.1, 0.45, 0.22)]:
        hsv = colour_hsv(c)
        back = hsv_colour(f64(hsv.x), f64(hsv.y), f64(hsv.z))
        assert(length(back.xyz - c.xyz) < 0.002, "{c} {back}")

test "a tail number is what the font can paint":
    assert(clean_number("i-bauf") == "I-BAUF")
    assert(clean_number("k?ab 3!") == "KAB 3")
    assert(clean_number("ABCDEFGHIJK").len() == 8)
    loop k in 0..FONT_CHARS.len():
        assert(FONT_ROWS[k].len() == 7)
        loop r in FONT_ROWS[k]: assert(r >= 0 and r < 32)

test "a game saved before paint loads as built":
    p = from_text[Paint]("Paint()")
    if p is Paint: assert(p.kind == -1 and not paint_active(p, 0))
    else: assert(false)
