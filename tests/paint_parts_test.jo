# Paint by part: a part in its own colour, gradient or stripes changes that part's paint and
# nothing else; an aircraft with no part painted is built exactly as before; every type's parts
# are found, whichever builder made it; the choices round-trip through a save's text and bytes.
use '../src/planes.jo'
use '../src/markings.jo'
use '../src/paint_parts.jo'
use '../src/decals.jo'
use '../src/aircraft_paint.jo'

let RED = vec4(0.8, 0.1, 0.1, 1)
let WHITE = vec4(0.95, 0.94, 0.9, 1)
let BLUE = vec4(0.1, 0.2, 0.7, 1)

# a small aircraft by hand: a fuselage box in the body colour with a glass pane, a wing each side,
# a rudder; `lv` its four colours (body, trim, wing, accent)
_toy = (lv: vec4[]) -> Vertex3D[][]:
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    add_box(bins[0], vec3(0, 0, 0), vec3(1, 1, 6), lv[0])
    add_box(bins[0], vec3(0, 0.6, -1), vec3(0.5, 0.2, 0.5), rgb(0.6, 0.8, 0.9))
    add_box(bins[2], vec3(-3, 0, 0), vec3(4, 0.1, 1.5), lv[2])
    add_box(bins[3], vec3(3, 0, 0), vec3(4, 0.1, 1.5), lv[2])
    add_box(bins[6], vec3(0, 0, 3.5), vec3(0.6, 0.6, 1), lv[0] * 0.8)
    add_box(bins[6], vec3(0, 1.2, 3.6), vec3(0.1, 1.4, 0.8), lv[0])
    from = bins[6].len()
    add_box(bins[6], vec3(0, 1.2, 4.2), vec3(0.1, 1.2, 0.4), lv[3])
    tag_paint(bins[6], from, PAINT_RUDDER_TAG)
    bins

_LV: vec4[] = [rgb(0.9, 0.9, 0.8), rgb(0.1, 0.4, 0.5), rgb(0.85, 0.8, 0.7), rgb(0.7, 0.2, 0.1)]
_key = () -> Vertex3D[][]: _toy([PAINT_KEYS[0], PAINT_KEYS[1], PAINT_KEYS[2], PAINT_KEYS[3]])

_colours = (vs: Vertex3D[]) -> vec4[]:
    out: vec4[]
    loop v in vs:
        if not (v.color in out): out.push(v.color)
    out

test "no part painted: nothing changes":
    bins = _toy(_LV); was = bins
    paint_parts_apply(bins, _key(), [])
    assert(bins == was)
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_LEFT_WING)])       # (alpha 0: the livery's)
    assert(bins == was)

test "one colour: that part's paint alone, glass and the other parts as they were":
    bins = _toy(_LV); was = bins
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_LEFT_WING, a = RED)])
    assert(bins[0] == was[0] and bins[3] == was[3] and bins[6] == was[6])
    assert(bins[2].len() == was[2].len())
    loop k in 0..bins[2].len():
        assert(bins[2][k].color == RED and bins[2][k].pos == was[2][k].pos and bins[2][k].normal == was[2][k].normal)
    bins = _toy(_LV)
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_FUSELAGE, a = RED)])
    # (the pane keeps its glass; no triangle is added or lost)
    assert(bins[0].len() == was[0].len())
    cols = _colours(bins[0])
    assert(cols.len() == 2 and RED in cols and rgb(0.6, 0.8, 0.9) in cols)

test "the fuselage's paint carries on into the tail's bin, a shade keeps its shade, the fin and rudder stay":
    bins = _toy(_LV); was = bins
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_FUSELAGE, a = RED)])
    # (the tail bin: the fuselage's end, built 0.8 as bright, then the fin, then the rudder)
    assert(length(bins[6][0].color.xyz - RED.xyz * 0.8) < 0.02, "{bins[6][0].color}")
    assert(bins[6][36].color == _LV[0] and bins[6][72].color == _LV[3])
    bins = _toy(_LV)
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_RUDDER, a = BLUE), PartPaint(part = PART_TAIL, a = WHITE)])
    assert(bins[6][72].color == BLUE and bins[6][36].color == WHITE and bins[6][0].color == was[6][0].color)
    assert(bins[0] == was[0])

test "a gradient runs from the first colour at the root to the second at the tip, and across when asked":
    bins = _toy(_LV)
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_LEFT_WING, pattern = PATTERN_GRADIENT, a = RED, b = WHITE), PartPaint(part = PART_RIGHT_WING, pattern = PATTERN_GRADIENT, a = RED, b = WHITE)])
    loop side in [2, 3]:
        loop v in bins[side]:
            u = (abs(v.pos.x) - 1.0) / 4.0
            assert(length(v.color.xyz - mix(RED, WHITE, f32(u)).xyz) < 0.001, "{v.pos} {v.color}")
    bins = _toy(_LV)
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_LEFT_WING, pattern = PATTERN_GRADIENT, a = RED, b = WHITE, across = true)])
    loop v in bins[2]: assert(length(v.color.xyz - mix(RED, WHITE, (v.pos.z + 0.75) / 1.5).xyz) < 0.001)

test "stripes cut the part into bands of the two colours: the same surface, each piece in its band":
    bins = _toy(_LV); was = bins
    paint_parts_apply(bins, _key(), [PartPaint(part = PART_LEFT_WING, pattern = PATTERN_STRIPES, a = RED, b = WHITE, count = 4)])
    assert(bins[2].len() > was[2].len() and bins[2].len() % 3 == 0)
    area = (vs: Vertex3D[]) -> f64:
        total = 0.0
        loop t in 0..vs.len() / 3: total += f64(length(cross(vs[t * 3 + 1].pos - vs[t * 3].pos, vs[t * 3 + 2].pos - vs[t * 3].pos))) * 0.5
        total
    assert(abs(area(bins[2]) - area(was[2])) < 0.001, "{area(bins[2])} {area(was[2])}")
    loop t in 0..bins[2].len() / 3:
        mid = (bins[2][t * 3].pos + bins[2][t * 3 + 1].pos + bins[2][t * 3 + 2].pos) / 3.0
        band = clamp(int(floor((-f64(mid.x) - 1.0) / 4.0 * 4.0)), 0, 3)
        want = if band % 2 == 0: RED else: WHITE
        loop j in 0..3: assert(bins[2][t * 3 + j].color == want, "{mid} {band}")
    # (the same from the same paint: nothing random in it)
    again = _toy(_LV)
    paint_parts_apply(again, _key(), [PartPaint(part = PART_LEFT_WING, pattern = PATTERN_STRIPES, a = RED, b = WHITE, count = 4)])
    assert(again == bins)

test "every type: built plainly as ever, its parts found, and a part's paint lands on it":
    loop id in 0..CRAFT_NAMES.len():
        kind = Craft(id)
        lv = LIVERIES[DEFAULT_LIVERIES[id]]
        plain = build_craft(kind, lv)
        # (no parts and no decals: the plain build itself)
        assert(build_painted_craft(kind, lv, [], []).body.count == plain.body.count, CRAFT_NAMES[id])
        there = craft_paint_parts(kind, lv)
        assert(there.len() == PART_COUNT and there[PART_FUSELAGE] and there[PART_LEFT_WING] and there[PART_RIGHT_WING] and there[PART_TAIL], CRAFT_NAMES[id])
        painted = build_painted_craft(kind, lv, [PartPaint(part = PART_FUSELAGE, a = RED), PartPaint(part = PART_LEFT_WING, pattern = PATTERN_STRIPES, a = RED, b = WHITE, count = 6)], [])
        # (stripes add triangles; the parts' meshes still add up to the body)
        assert(painted.body.count > plain.body.count, CRAFT_NAMES[id])
        total = 0
        loop part in painted.parts: total += part.mesh.count
        assert(total == painted.body.count, "{CRAFT_NAMES[id]} {total} {painted.body.count}")
        assert(painted.contacts == plain.contacts and painted.struts.len() == plain.struts.len() and painted.streamers == plain.streamers, CRAFT_NAMES[id])

test "every type has a rudder to paint, whichever builder laid it; the original four a cowling and struts":
    loop id in 0..CRAFT_NAMES.len():
        there = craft_paint_parts(Craft(id), LIVERIES[DEFAULT_LIVERIES[id]])
        assert(there[PART_RUDDER], CRAFT_NAMES[id])
        if id < 4: assert(there[PART_COWLING] and there[PART_STRUTS], CRAFT_NAMES[id])

test "a rudder's own paint covers the stripes its type or nation gave it":
    lv = LIVERIES[DEFAULT_LIVERIES[int(Craft.curtiss_r3c2)]]
    plain = build_craft(.curtiss_r3c2, lv)
    painted = build_painted_craft(.curtiss_r3c2, lv, [PartPaint(part = PART_RUDDER, a = RED)], [])
    assert(painted.body.count == plain.body.count)

test "a paint's parts: one for a part, cleared, listed among the changes, and the page's colour":
    k = int(Craft.gull)
    p = Paint(kind = k)
    assert(not paint_active(p, k))
    paint_set_part(p, PartPaint(part = PART_COWLING, a = RED))
    paint_set_part(p, PartPaint(part = PART_COWLING, pattern = PATTERN_GRADIENT, a = BLUE, b = WHITE, count = 99))
    assert(paint_active(p, k) and p.parts.len() == 1 and paint_parts_set(p) == 1)
    q = paint_part(p, PART_COWLING)
    assert(q != none)
    if let own = q: assert(own.a == BLUE and own.pattern == PATTERN_GRADIENT and own.count == 12)
    assert("cowling" in paint_changes(p, k) and paint_part_colour(p, k, PART_COWLING) == BLUE)
    assert(paint_part_colour(p, k, PART_FUSELAGE) == LIVERIES[0].body)
    paint_clear_part(p, PART_COWLING)
    assert(not paint_active(p, k) and paint_part(p, PART_COWLING) == none)

test "a paint with parts and decals comes back from a save's text and its bytes as it went":
    p = paint_from_spec("livery=2 number=K-AB3 part.lwing=stripes:0.8,0.1,0.1:0.9,0.9,0.8:1:6 part.fuselage=gradient:0.1,0.2,0.6:0.9,0.9,0.8 decal=roundel:wing-top decal=text:fuselage:0.5:12:0.1,0.1,0.1::::K-9 decal=cat:left/0.3/0.6:0.7:0:::: 0", 0)
    assert(p.parts.len() == 2 and p.decals.len() == 3)
    assert(p.parts[0].part == PART_LEFT_WING and p.parts[0].across and p.parts[0].count == 6 and p.parts[0].pattern == PATTERN_STRIPES)
    assert(p.decals[1].text == "K-9" and p.decals[1].size == 0.5 and p.decals[1].angle == 12.0 and p.decals[2].spot == "" and p.decals[2].u == 0.3)
    text = from_text[Paint](to_text(p))
    if text is Paint: assert(text == p)
    else: assert(false, "text")
    back = from_bytes[Paint](to_bytes(p))
    if back is Paint: assert(back == p)
    else: assert(false, "bytes")
    # (a paint saved before parts and decals: none of either)
    old = from_text[Paint]("Paint(kind=0, livery=2, number=\"K-AB3\")")
    if old is Paint: assert(old.parts.len() == 0 and old.decals.len() == 0 and old.livery == 2 and paint_active(old, 0))
    else: assert(false, "old")
