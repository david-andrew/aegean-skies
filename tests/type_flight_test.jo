# Aircraft flown as a player flies them on flight model v2, on the mouse's aim (flight.jo `steer`):
# the take-off and the water in a moderate sea, where tools/type_survey.jo found types that flew badly.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/type_flight_test.jo
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as planes
import '../src/sea.jo' as sea
import '../src/look.jo' as look

const K = 3.3
const FIELD = 60.0

_spec = (kind: planes.Craft) -> fl.CraftSpec:
    fl.set_speed_scale(K); fl.set_lift_scale(K)
    tw.set_tweaks(tw.Tweaks())
    k = fl.craft_spec(kind, planes.build_craft(kind, planes.LIVERIES[0]).contacts)
    k.player = true
    k

_reset = ():
    fl.set_speed_scale(1.0); look.wind_now = look.Wind(); tw.set_tweaks(tw.Tweaks())

_pitch = (s: fl.CraftState) -> f64: asin(clamp(f64(fl.forward(s).y), -1.0, 1.0))
_dir = (climb: f64) -> vec3: vec3(0, f32(sin(climb)), f32(-cos(climb)))

# The landplanes' take-off on the mouse: the aim on the horizon, lifted four degrees near flying speed.
# On the wheels the aim holds the nose's attitude; asked for the path, the stick came right back,
# sat her on her tail at 21 degrees, stalled, and she never left the ground.
test "a landplane takes off from the grass on the mouse's aim, without sitting on her tail":
    loop kind in [planes.Craft.fiat_cr20, planes.Craft.kea_chelidon]:
        k = _spec(kind)
        e = fl.FlightEnv(ground = (x: f64, z: f64) -> f64: FIELD)
        s = fl.ground_start(k, vec3(0, f32(FIELD), 0))
        off = -1.0; steepest = 0.0
        loop i in 0..60 * 60:
            climb = if s.on_ground: (if f64(length(s.velocity)) / K > k.stall_speed * 0.85: 0.07 else: 0.0) else: 0.14
            c = fl.steer(k, s, _dir(climb))
            c.throttle = 1.0
            fl.step(k, s, c, e, 1.0 / 60.0)
            if s.on_ground: steepest = max(steepest, _pitch(s))
            if off < 0.0 and not s.on_ground and f64(s.position.y) > FIELD + 5.0: off = s.time
            if off > 0.0 and f64(s.position.y) > FIELD + 60.0: break
        print("{kind} mouse take-off: off at {off:.1} s, steepest on the wheels {steepest * 57.3:.0} deg, damage {s.hull_damage:.3}")
        assert(off > 0.0 and off < 40.0 and steepest < 0.3 and not s.crashed and s.hull_damage < 0.01)
    _reset()

# Off the water the mouse's aim starts where the nose is (src/pilot.jo) and the player lifts it: the
# aim asks the path for no more than the wing has at that speed, so she climbs away instead of pulling
# into a stall and falling back into the sea (the Heron and the early flying boats did).
test "off the water on the mouse's aim she climbs away, never pulled into a stall":
    loop kind in [planes.Craft.heron, planes.Craft.macchi_m5, planes.Craft.macchi_m7, planes.Craft.pelican]:
        k = _spec(kind)
        s = fl.water_start(k, vec3(0, 0, 0))
        off = -1.0; aim0 = 0.0; stalled = false; steepest = 0.0
        loop i in 0..60 * 80:
            c = fl.Controls(throttle = 1.0, assist = 0.0)
            if s.on_water:
                if f64(length(s.velocity)) / K > k.stall_speed * 0.85: c.pitch = clamp((0.1 - _pitch(s)) * 3.0, -1.0, 1.0)
                aim0 = _pitch(s)
            else:
                if off < 0.0: off = s.time
                c = fl.steer(k, s, _dir(aim0 + (0.14 - aim0) * clamp((s.time - off) / 3.0, 0.0, 1.0)))
                c.throttle = 1.0
                if s.time < off + 8.0:
                    stalled = stalled or s.stalled
                    steepest = max(steepest, _pitch(s))
            fl.step(k, s, c, fl.FlightEnv(), 1.0 / 60.0)
            if off > 0.0 and f64(s.position.y) > 60.0 * K: break
        print("{kind} off the water on the aim: at {off:.1} s, steepest {steepest * 57.3:.0} deg, stalled {stalled}, up {f64(s.position.y) / K:.0} m")
        assert(off > 0.0 and not stalled and steepest < 0.35 and f64(s.position.y) > 60.0 * K and not s.crashed and s.hull_damage < 0.01)
    _reset()

# A flying boat's hull below its middle is hull: running through wind 3's swell the water along its
# sides is not a panel slammed broadside (it broke up the Heron, the Swift and the S.55's twin hulls)
test "flying boats run through a moderate swell without breaking up":
    loop kind in [planes.Craft.heron, planes.Craft.swift, planes.Craft.sm_s55, planes.Craft.macchi_m5]:
        k = _spec(kind)
        look.wind_now = look.Wind(dir = vec2(0.8, 0.6), speed = 3.0)
        worst = 0.0
        loop n in 0..2:
            s = fl.water_start(k, vec3(f32(f64(n) * 61.0), 0, 0))
            t = 0.0
            loop i in 0..60 * 30:
                tt = t
                e = fl.FlightEnv(wind = vec3(0.8, 0, 0.6) * 2.1, swell = (x: f64, z: f64) -> vec3: sea.swell_at(x, z, tt), has_swell = true, swell_ceiling = sea.swell_height_bound())
                # (the stick in the middle, running fast on the hull through the swell, held short of
                # flying speed)
                # (and the wings held level, as a pilot does on the water)
                bank = asin(clamp(f64(quat_rotate(s.orientation, vec3(1, 0, 0)).y), -1.0, 1.0))
                fl.step(k, s, fl.Controls(throttle = if f64(length(s.velocity)) / K < k.stall_speed * 0.6: 1.0 else: 0.2, roll = clamp(bank * 3.0, -1.0, 1.0), assist = 0.0), e, 1.0 / 60.0)
                t += 1.0 / 60.0
            worst = max(worst, s.hull_damage)
        print("{kind} through wind 3's swell: worst hull damage {worst:.3}")
        assert(worst < 0.05)
    _reset()

# The player's hand on the mouse, as src/pilot.jo eases it (30/s), with the aim's own motion
_hand = (k: fl.CraftSpec, s: fl.CraftState, aim: vec3, last: fl.Controls, seen: vec3, rate: vec3, thr: f64) -> fl.Controls:
    c = fl.steer(k, s, aim, rate)
    e = 1.0 - exp(-30.0 / 60.0)
    c.pitch = last.pitch + (c.pitch - last.pitch) * e
    c.roll = last.roll + (c.roll - last.roll) * e
    c.yaw = last.yaw + (c.yaw - last.yaw) * e
    c.throttle = thr
    c

_level_air = (k: fl.CraftSpec, v: f64) -> fl.CraftState:
    s = fl.CraftState(position = vec3(0, 900, 0), velocity = vec3(0, 0, f32(-v * K)), fuel = k.fuel_capacity, water_age = 1.0)
    s.throttle = fl.cruise_throttle(k, v); s.rpm = s.throttle
    s

_path = (s: fl.CraftState) -> f64: asin(clamp(f64(s.velocity.y) / max(f64(length(s.velocity)), 0.1), -1.0, 1.0))

# On v2 the cruise throttle is v2's own balance: held level at it, every type flies its catalog cruise
test "at its cruise throttle each type holds its catalog cruise on v2":
    loop kind in [planes.Craft.gull, planes.Craft.falco, planes.Craft.macchi_mc72, planes.Craft.hughes_h4, planes.Craft.sopwith_greek, planes.Craft.kea_chelidon]:
        k = _spec(kind)
        v = k.cruise_speed / K
        s = _level_air(k, v * 0.9)
        loop i in 0..60 * 60:
            fl.step(k, s, fl.Controls(throttle = fl.cruise_throttle(k, v), pitch = clamp(-_path(s) * 2.0 / max(k.pitch_rate, 0.1), -1.0, 1.0)), fl.FlightEnv(), 1.0 / 60.0)
        got = f64(length(s.velocity)) / K
        print("{kind} at its cruise throttle: {got:.1} m/s true, catalog {v:.1}")
        assert(abs(got / v - 1.0) < 0.02)
    _reset()

# Slow, on an approach, the aim is the way she goes: held three degrees down, she flies three degrees
# down (the nose's alpha over the path no longer mixed in, which sank her a degree or two steeper)
test "on a slow approach she goes where the aim is":
    loop kind in [planes.Craft.minnow, planes.Craft.gull, planes.Craft.kea_chelidon, planes.Craft.short_sarafand]:
        k = _spec(kind)
        v = k.stall_speed * 1.3
        s = _level_air(k, v)
        s.velocity = vec3(0, f32(-v * K * sin(0.0524)), f32(-v * K * cos(0.0524)))
        last = fl.Controls(); err = 0.0; n = 0
        loop i in 0..60 * 25:
            c = _hand(k, s, _dir(-0.0524), last, vec3(0, 0, 0), vec3(0, 0, 0), fl.cruise_throttle(k, v) * 0.45)
            last = c
            fl.step(k, s, c, fl.FlightEnv(), 1.0 / 60.0)
            if i > 600: err += (-0.0524 - _path(s)) * 57.3; n += 1
        print("{kind} approach on a 3 degree aim: settles {err / f64(n):.2} degrees off it")
        assert(abs(err / f64(n)) < 0.5)
    _reset()

# Small corrections of the aim bank a fast racer no more than they bank the rest (the path's gentle
# turn is the same rate, and the bank for it grows with the speed); a big one still turns her briskly
test "the racers bank like the rest for small corrections, and still turn briskly for a big one":
    loop kind in [planes.Craft.macchi_mc72, planes.Craft.sm_s65, planes.Craft.piaggio_p7, planes.Craft.gull]:
        k = _spec(kind)
        v = k.cruise_speed / K
        # (a two degree wiggle every two seconds)
        s = _level_air(k, v); last = fl.Controls(); bank = 0.0; seen = vec3(0, 0, 0); rate = vec3(0, 0, 0)
        loop i in 0..60 * 12:
            t = f64(i) / 60.0
            aim = vec3(f32(sin(0.035 * sin(t * PI))), 0, f32(-cos(0.035 * sin(t * PI))))
            if length(seen) > 0.5: rate += ((aim - seen) * 60.0 - rate) * f32(1.0 - exp(-10.0 / 60.0))
            seen = aim
            c = _hand(k, s, aim, last, seen, rate, fl.cruise_throttle(k, v)); last = c
            fl.step(k, s, c, fl.FlightEnv(), 1.0 / 60.0)
            r = quat_rotate(s.orientation, vec3(1, 0, 0)); u = quat_rotate(s.orientation, vec3(0, 1, 0))
            bank = max(bank, abs(atan2(-f64(r.y), f64(u.y))) * 57.3)
        # (a ten degree step to the right: within a degree in so many seconds)
        s = _level_air(k, v); last = fl.Controls(); settled = -1.0
        aim = vec3(f32(sin(0.1745)), 0, f32(-cos(0.1745)))
        loop i in 0..60 * 8:
            c = _hand(k, s, aim, last, vec3(0, 0, 0), vec3(0, 0, 0), fl.cruise_throttle(k, v)); last = c
            fl.step(k, s, c, fl.FlightEnv(), 1.0 / 60.0)
            if settled < 0.0 and acos(clamp(f64(dot(fl.forward(s), aim)), -1.0, 1.0)) < 0.0175: settled = s.time
        print("{kind}: a 2 degree wiggle banks her {bank:.1} degrees; a 10 degree step is on within a degree at {settled:.2} s")
        assert(bank < 5.5 and settled > 0.0 and settled < 2.0)
    _reset()

# The gun line: slow but not on an approach (the throttle up), or fighting (the guns in use, a lead
# shown) whatever the throttle, the steering puts the nose on the aim, so a degree's correction lands
# on it; the way she goes is aimed only on an approach, throttle back and slow, the guns not in use
_nose_on = (kind: planes.Craft, v_mul: f64, thr_mul: f64, fighting: bool) -> f64:
    k = _spec(kind)
    v = k.stall_speed * v_mul
    s = _level_air(k, v)
    thr = fl.cruise_throttle(k, v) * thr_mul
    s.throttle = thr; s.rpm = thr
    aim = vec3(f32(sin(0.0175)), 0, f32(-cos(0.0175)))
    last = fl.Controls(); err = 0.0; n = 0
    loop i in 0..60 * 8:
        c = fl.steer(k, s, aim, vec3(0, 0, 0), fighting = fighting)
        e = 1.0 - exp(-30.0 / 60.0)
        c.pitch = last.pitch + (c.pitch - last.pitch) * e; c.roll = last.roll + (c.roll - last.roll) * e; c.yaw = last.yaw + (c.yaw - last.yaw) * e
        c.throttle = thr; last = c
        fl.step(k, s, c, fl.FlightEnv(), 1.0 / 60.0)
        if i > 60 * 3: err += acos(clamp(f64(dot(fl.forward(s), aim)), -1.0, 1.0)) * 57.3; n += 1
    err / f64(n)

test "slow with the throttle up, or fighting, a degree's correction lands on the gun line":
    loop kind in [planes.Craft.gull, planes.Craft.corsair, planes.Craft.supermarine_s6b]:
        up = _nose_on(kind, 1.5, 1.6, false)
        fight = _nose_on(kind, 1.3, 0.6, true)
        print("{kind}: a 1 degree correction, slow with the throttle up {up:.2} degrees off the guns; fighting on an approach's speed and throttle {fight:.2}")
        assert(up < 0.4 and fight < 0.4)
    _reset()
