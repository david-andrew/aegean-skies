# The paint shop as a place: a workshop on a deck one can walk onto, its walls and bench solid, its
# painter, its bench and its bollard on the deck, a berth on the water in front; sited clear of
# docks, boats, quays and shallows; a gangway where the harbour has no waterfront; and its venue
# is where the town's mechanic works. Unit liveries: one unit, one colour, each aircraft its number.
use '../src/objects.jo'
use '../src/town_sites.jo'
use '../src/life_types.jo'
use '../src/living_types.jo'
use '../src/living_life_seed.jo'
use '../src/markings.jo'
use '../src/paint_parts.jo'
use '../src/decals.jo'
use '../src/paint_shed.jo'
use '../src/pilot_liveries.jo'
use '../src/paint_shop_view.jo'

# a town facing +z from the origin: a main quay out to sea, docks beside its end
_town = (port: bool) -> Town:
    quays = [Quay(vec2(0, -12), vec2(0, if port: 70 else: 25), if port: 8.0 else: 5.0)]
    if port: quays.push(Quay(vec2(-90, -2), vec2(90, -2), 10.0))
    docks = [vec3(10, 0, if port: 58 else: 13), vec3(-10, 0, if port: 58 else: 13)]
    Town("Test", vec3(0, 1.2, 0), vec2(0, 1), docks, [], quays, [], Mesh(), [], Mesh(), [], [], [])

# a shore sloping away: dry land behind z = 0, a metre down every four metres out
_shelf = (x: f64, z: f64) -> f64: -z * 0.25

test "the workshop: a deck to walk on, solids on it, its places on the deck, a berth off its edge":
    s = build_paint_shed(mat4(), 3)
    assert(s.ok and s.place == 3 and s.mesh.count > 1500 and s.mesh.count < 12000, "{s.mesh.count}")
    assert(s.quays.len() == 1 and abs(f64(s.quays[0].width) - SHED_HALF * 2.0) < 0.001)
    assert(s.quays[0].a.y < 0.0 and abs(f64(s.quays[0].b.y) - SHED_DEPTH) < 0.001)
    on_deck = (p: vec3) -> bool: abs(f64(p.x)) < SHED_HALF and f64(p.z) > 0.0 and f64(p.z) < SHED_DEPTH
    loop p in [s.painter, s.stand, s.bollard]: assert(on_deck(p), "{p}")
    assert(abs(f64(s.painter.y) - SHED_DECK) < 0.001 and abs(f64(s.stand.y) - SHED_DECK) < 0.001 and on_deck(s.bench))
    solids = paint_shed_solids(s)
    assert(solids.len() >= 5)
    loop b in solids:
        assert(on_deck(b.at), "{b.at}")
        # (nobody is asked to stand inside one)
        loop p in [s.painter, s.stand]:
            assert(abs(f64(p.x - b.at.x)) > b.width * 0.5 + 0.2 or abs(f64(p.z - b.at.z)) > b.depth * 0.5 + 0.2, "{p} in {b.at}")
    berth = paint_shed_berth(s, 8.0)
    assert(abs(f64(berth.0.z) - (SHED_DEPTH + SHED_BERTH_GAP + 4.0)) < 0.001 and berth.0.x == 0.0 and berth.0.y == 0.0)
    # (nose in: heading back towards the shed; a longer aircraft lies further out, her nose where it was)
    assert(abs(cos(berth.1) - 1.0) < 0.001 or abs(sin(berth.1)) < 0.001)
    assert(abs(f64(paint_shed_berth(s, 14.0).0.z) - f64(berth.0.z) - 3.0) < 0.001)
    v = paint_shed_venue(s)
    assert(v.kind == .workshop and v.place == 3 and v.key.starts_with(PAINT_SHED_VENUE) and v.pos == s.painter)

test "turned with its frame: out to sea is its own +z, the berth out along it":
    m = translation(vec3(100, 0, -50)) * rotation_y(1.1)
    s = build_paint_shed(m, 0)
    out = normalize((m * vec4(0, 0, 1, 0)).xyz)
    berth = paint_shed_berth(s, 8.0)
    to = berth.0 - s.origin
    assert(dot(normalize(vec3(to.x, 0, to.z)), out) > 0.999)
    # (her nose points back at the deck)
    nose = vec3(f32(sin(berth.1)), 0, f32(-cos(berth.1)))
    assert(dot(nose, out) < -0.999, "{nose} {out}")
    view = paint_shed_view(s, berth.0, 0.0, 0.3, 20.0)
    assert(abs(f64(length(view.0 - view.1)) - 20.0) < 0.01 and view.0.y > view.1.y)
    # (from the deck's side of her)
    assert(dot(normalize(vec3(view.0.x - berth.0.x, 0, view.0.z - berth.0.z)), out) < -0.9)

test "a spot is good where the berth floats and nothing is in the way, and bad otherwise":
    port = _town(true)
    deep = (x: f64, z: f64) -> f64: -4.0
    assert(paint_shed_score(port, paint_shed_frame(port, 30.0, true), deep, true) == 0.0)
    # (too near the main quay; over the docks; shallows where she would lie; ground through the deck)
    assert(paint_shed_score(port, paint_shed_frame(port, 6.0, true), deep, true) > 25.0)
    by_docks = port
    by_docks.docks = [vec3(-30, 0, 20)]
    assert(paint_shed_score(by_docks, paint_shed_frame(by_docks, 30.0, true), deep, true) > 25.0)
    assert(paint_shed_score(port, paint_shed_frame(port, 30.0, true), (x: f64, z: f64) -> f64: -0.3, true) > 25.0)
    assert(paint_shed_score(port, paint_shed_frame(port, 30.0, true), (x: f64, z: f64) -> f64: 2.5, true) > 25.0)
    # (kept clear of what is named: the hotel)
    assert(paint_shed_score(port, paint_shed_frame(port, 30.0, true), deep, true, [vec3(-34, 20.0, 18)]) > 25.0)
    boated = port
    boated.boats = [Boat(Mesh(), vec3(-30, 0, 18), vec3(-30, 0, 20))]
    assert(paint_shed_score(boated, paint_shed_frame(boated, 30.0, true), deep, true) > 25.0)

test "the site found is the nearest good one to the main quay, or none":
    port = _town(true)
    deep = (x: f64, z: f64) -> f64: -4.0
    found = paint_shed_site(port, deep, true)
    assert(found != none)
    if let m = found:
        at = transform_point(m, vec3(0, 0, 0))
        # (off the waterfront's seaward edge, the first place the berth clears the quay)
        assert(abs(f64(at.z) - 2.6) < 0.001 and abs(f64(at.x)) >= 12.0 and abs(f64(at.x)) <= 20.0, "{at}")
    assert(paint_shed_site(port, (x: f64, z: f64) -> f64: 3.0, true) == none)
    cove = _town(false)
    there = paint_shed_site(cove, _shelf, false)
    assert(there != none)
    if let m = there:
        at = transform_point(m, vec3(0, 0, 0))
        assert(f64(at.z) < 0.0 and abs(f64(at.x)) >= 19.0, "{at}")
        # (its gangway reaches the quay's near edge)
        g = paint_shed_gangway(cove, m)
        assert(abs(abs(g) - (abs(f64(at.x)) - 2.5)) < 0.01, "{g} {at}")
        s = build_paint_shed(m, 5, g)
        assert(s.quays.len() == 2 and f64(s.quays[1].width) < 2.0)
        ends = [s.quays[1].a, s.quays[1].b]
        # (one end on the deck, the other on the quay)
        assert(min(abs(f64(ends[0].x)), abs(f64(ends[1].x))) < 2.5 and max(abs(f64(ends[0].x)), abs(f64(ends[1].x))) > abs(f64(at.x)) - SHED_HALF - 0.1)
    # (a port stands off its waterfront and needs none)
    assert(build_paint_shed(mat4(), 0, 0.0).quays.len() == 1)

test "a town's mechanic works at its paint shop; nobody else is sent there":
    w = World()
    w.people.push(Person(id = 0, name = "Pilot", occupation = .player))
    w.people.push(Person(id = 1, name = "Paolo", occupation = .mechanic))
    w.people.push(Person(id = 2, name = "Dario", occupation = .courier))
    w.life_venues.push(LifeVenue(0, "legacy:0:scene:workshop", .workshop, vec3(50, 4, 50)))
    shed = build_paint_shed(mat4(), 0)
    w.life_venues.push(paint_shed_venue(shed))
    w.life_venues.push(LifeVenue(1, "paint-shop:1", .workshop, vec3(900, 1, 900)))
    m = choose_life_venue(w, 0, .workshop, 1)
    assert(m != none)
    if let v = m: assert(v.key.starts_with(PAINT_SHED_VENUE) and v.pos == shed.painter)
    loop person in [0, 2]:
        if let v = choose_life_venue(w, 0, .workshop, person): assert(v.key == "legacy:0:scene:workshop")
        else: assert(false)
    # (a town with no paint shop: its mechanic keeps the old workshop)
    w.life_venues = [w.life_venues[0]]
    if let v = choose_life_venue(w, 0, .workshop, 1): assert(v.key == "legacy:0:scene:workshop")
    else: assert(false)

test "a unit's livery: the service's paint kept, one colour for the unit, each aircraft its number":
    colours = [rgb(0.2, 0.3, 0.6), rgb(0.9, 0.9, 0.85)]
    ink = vec4(0.09, 0.09, 0.1, 1)
    a = unit_paint(2064, 0, 4, 1, colours, ink); b = unit_paint(2064, 0, 4, 7, colours, ink)
    assert(a == unit_paint(2064, 0, 4, 1, colours, ink))
    assert(a.livery == 4 and b.livery == 4 and a.parts == b.parts and a.parts.len() >= 1 and a.parts[0].part == PART_COWLING and a.parts[0].a in colours)
    # (nothing over the fuselage, wings or tail: its side still reads)
    loop q in a.parts: assert(q.part == PART_COWLING or q.part == PART_STRUTS)
    assert(a.decals.len() == 2 and a.decals[0].motif == "text" and a.decals[0].text == "1" and b.decals[0].text == "7" and a.decals[0].a == ink)
    assert(unit_paint(2064, 0, 4, 250, colours, ink).decals[0].text == "99")
    assert(paint_from_record(paint_to_record(b)) == b)

test "the shop's panel: beside it is the scene, and the aircraft is given the room it leaves":
    st = PaintPanel(rect = Rect(860, 16, 400, 688))
    assert(paint_panel_over(st, vec2(900, 300)) and not paint_panel_over(st, vec2(400, 300)) and not paint_panel_over(st, vec2(900, 710)))
    # (at the side: the aircraft's middle moves left; along the bottom of an upright screen: up)
    side = paint_panel_shift(st)
    assert(side.x < 0.0 and side.y == 0.0)
    up = paint_panel_shift(PaintPanel(rect = Rect(12, 500, 400, 700), upright = true))
    assert(up.x == 0.0 and up.y < 0.0)
    # (no panel drawn: she has the middle of the screen)
    assert(paint_panel_shift(PaintPanel()) == vec2(0, 0))
