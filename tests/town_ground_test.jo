# A town's worn ground, painted on the terrain (src/town_ground.jo): the island towns' lanes join
# every house to the rest and to the foot of the quay, stone in the port and earth in the
# villages; a mainland town's field holds its streets; the seats of a cafe and a bench.
use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/town_sites.jo'
use '../src/world_towns.jo'
use '../src/town_ground.jo'
use '../src/town_ground_cover.jo'

_world = () -> Town[]:
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_settlements(false, true); finish_settlement_registry()
    [loop s in SETTLEMENTS: build_town(s)]

# whether the lanes make one connected whole that reaches `near`
_joined = (plan: TownGroundPlan, near: vec2) -> bool:
    if plan.lanes.len() == 0: return false
    seen = fill(false, plan.lanes.len())
    todo = [0]; seen[0] = true
    touch = (a: GroundLane, b: GroundLane) -> bool:
        loop p in [a.a, a.b]:
            loop q in [b.a, b.b]:
                if f64(length(p - q)) < 0.6: return true
        false
    loop todo.len() > 0:
        k = todo[todo.len() - 1]; _ = todo.pop()
        loop j in 0..plan.lanes.len():
            if not seen[j] and touch(plan.lanes[k], plan.lanes[j]): seen[j] = true; todo.push(j)
    reached = false
    loop j in 0..plan.lanes.len():
        if not seen[j]: return false
        if f64(length(plan.lanes[j].a - near)) < 1.0 or f64(length(plan.lanes[j].b - near)) < 1.0: reached = true
    reached

test "the island towns: every house's door joined by lanes to the foot of the quay; stone in the port, earth in the villages":
    towns = _world()
    loop index in 0..world_settlements.len():
        s = world_settlements[index]
        if s.legacy < 0: continue
        tw = towns[s.legacy]
        if tw.sites.len() < 3: continue
        plan = town_ground_plan(index, towns)
        assert(plan.housed and plan.spots.len() >= tw.sites.len())
        assert(_joined(plan, tw.center.xz - tw.out * 16.0), "{s.name}: {plan.lanes.len()} lanes")
        stone = SETTLEMENTS[s.legacy].kind == .port
        loop lane in plan.lanes: assert(lane.stone == stone, s.name)
    assert(town_ground_stone(world_settlements[0]))

test "a town's field: its lanes and worn ground are in it, the open country is not":
    towns = _world()
    tw = towns[0]
    span = f64(TOWN_GROUND_N) * TOWN_GROUND_CELL
    origin = vec2(f32(f64(tw.center.x) - span * 0.5), f32(f64(tw.center.z) - span * 0.5))
    img = town_ground_image(origin, towns)
    plan = town_ground_plan(0, towns)
    at = (p: vec2) -> int: (int(floor(f64(p.y - origin.y) / TOWN_GROUND_CELL)) * TOWN_GROUND_N + int(floor(f64(p.x - origin.x) / TOWN_GROUND_CELL))) * 4
    # (the middle of a long lane is on it: the stored edge distance is inside; stone)
    longest = plan.lanes[0]
    loop lane in plan.lanes:
        if length(lane.b - lane.a) > length(longest.b - longest.a): longest = lane
    k = at((longest.a + longest.b) * 0.5)
    edge = f64(img.pixels[k]) / 255.0 * (TOWN_GROUND_NEAR + TOWN_GROUND_FAR) - TOWN_GROUND_NEAR
    assert(edge < 0.0 and int(img.pixels[k + 2]) == 255, "{edge}")
    # (a house's ground is worn)
    assert(int(img.pixels[at(tw.sites[0].at.xz) + 1]) > 120)
    # (four hundred metres out to sea: untouched)
    far = at(tw.center.xz + tw.out * 400.0)
    assert(int(img.pixels[far]) == 255 and int(img.pixels[far + 1]) == 0)
    assert(town_ground_on_lane((longest.a + longest.b) * 0.5, towns))
    assert(not town_ground_on_lane(tw.center.xz + tw.out * 400.0, towns))

test "a mainland town's plan: its streets and its square before its houses are known, alleys and worn ground after":
    towns = _world()
    index = -1
    loop k in 0..world_settlements.len():
        s = world_settlements[k]
        if s.legacy < 0 and s.kind == .market and (index < 0 or s.id < world_settlements[index].id): index = k
    assert(index >= 0)
    world_town_far = [loop s in world_settlements: FarTown()]
    bare = town_ground_plan(index, towns)
    assert(not bare.housed and bare.lanes.len() > 10 and bare.spots.len() == 1)
    world_town_far[index] = build_far_town(world_settlements[index])
    full = town_ground_plan(index, towns)
    assert(full.housed and full.spots.len() > world_town_far[index].houses.len() / 2 and full.lanes.len() > bare.lanes.len())

test "a cafe's four chairs face its tables; a bench seats two, reached from its front":
    m = translation(vec3(10, 2, 20)) * rotation_y(0.7)
    cafe = town_prop_seats(0, m, vec3(0, 0, 0))
    assert(cafe.len() == 4)
    loop st in cafe:
        face = vec3(f32(sin(st.yaw)), 0, f32(cos(st.yaw)))
        table = (m * vec4(if (inverse(m) * vec4(st.at, 1)).x > 0.0: 2.0 else: -2.0, 0, 0, 1)).xyz
        assert(f64(dot(normalize(table - st.at), face)) > 0.95)
        # (stood behind the chair, away from the table)
        assert(f64(length(st.stand - table)) > f64(length(st.at - table)) + 0.8)
    bench = town_prop_seats(3, m, vec3(0, 0, 0))
    assert(bench.len() == 2 and f64(length(bench[0].at - bench[1].at)) > 1.0)
    loop st in bench:
        face = vec3(f32(sin(st.yaw)), 0, f32(cos(st.yaw)))
        assert(f64(dot(normalize(st.stand - st.at), face)) > 0.95)
