use '../src/town_details.jo'
use '../src/town_life_scene.jo'
use '../src/town_sites.jo'
use '../src/town_architecture.jo'
use '../src/life_types.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/settlements.jo'
use '../src/town_paving.jo'

test "published fixtures match physical architecture at dry accessible points":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true; init_settlements(false,true)
    tw=build_town(SETTLEMENTS[0]); count=0
    loop s in tw.sites:
        fixtures=town_fixture_venues(0,s,tw.sites)
        assert(to_text(fixtures)==to_text(town_fixture_venues(0,s,tw.sites)))
        parts: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
        props: Instance3D[][]=[loop k in 0..TOWN_PROP_COUNT: []]
        paths: Vertex3D[]
        arch_site(parts,props,s,true); arch_courtyard(parts,props,paths,s,tw.sites)
        loop v in fixtures:
            if v.kind==.alley: continue
            kind=if v.kind==.seat: 11 else: if v.kind==.laundry: 10 else: 8
            found=false
            loop instance in parts[kind]:
                if length(instance.model[3].xyz-v.prop_pos)<0.02: found=true
            if not found: print("MISSING {v} actual={parts[kind]}")
            assert(found)
            assert(abs(v.pos.y-place_ground(v.pos.xz)-0.12)<0.01)
            assert(arch_clear(tw.sites,v.pos.xz,0.25))
            count+=1
    assert(count>30)

test "paving caps overlap their junction and shoulders descend to the contact ground":
    assert(load_land(embed('../assets/terrain.bin')))
    a=vec2(490,-6312); b=vec2(500,-6312)
    vs: Vertex3D[]; town_street(vs,a,b,3.5)
    assert(vs.len()>0)
    cap=false; ground=false
    loop v in vs:
        if v.pos.x<488.3: cap=true
        gap=v.pos.y-f32(place_ground(v.pos.xz))
        assert(gap>=0 and gap<0.13)
        if gap<0.01: ground=true
    assert(cap and ground)
