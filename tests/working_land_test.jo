use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_purpose.jo'
use '../src/working_land_contact.jo'
use '../src/town_sites.jo'
use '../src/world_point.jo'
use '../src/objects.jo'
use '../src/inland_access_data.jo'
use '../src/living_far_catalog.jo'

test "working shelters have real front steps and only their floors suppress ground cover":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    checked=0
    loop id in [111289,131012,141625,131459,110977,110978]:
        s=world_settlements[settlement_by_id[id]]
        if let facility=working_facility(s):
            site=working_building(s,facility);entry=site_entry(site)
            start=entry.outside+site_front(site)*0.3;target=site_point(site,0,4)
            p=WorldPoint(f64(start.x),walk_height([],f64(start.x),f64(start.y)),f64(start.y))
            loop _ in 0..50:p=walk_step_precise([],p,normalize(target-world_vec(p).xz)*0.1)
            assert(length(world_vec(p).xz-target)<0.15,"workshop entrance {s.name}")
            assert(abs(p.y-f64(facility.at.y))<0.03)
            assert(working_paved(facility.at.xz))
            assert(not working_paved(site_point(site,8,0)),"workshop clears surrounding field")
            wall=site_point(site,4.4,0)
            assert(length(working_exclude(wall,f64(site.at.y))-wall)>0.1)
            checked+=1
    assert(checked>=4,"too few sampled sites have working buildings")

test "landing distances are baked from the shipped transport catalogue":
    packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
    catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
    assert(INLAND_ACCESS_CATALOG_KEY==hash(catalog.links),"rebake the landing manifest")
    loop id in [111289,131012,141625,131459]:
        access=INLAND_ACCESS[id]
        assert(access.landing>=0 and access.metres>0)
        if access.next!=id:
            found=false
            loop link in catalog.links:
                if link.mode==.cart and (link.a==id and link.b==access.next or link.b==id and link.a==access.next):found=true
            assert(found)
