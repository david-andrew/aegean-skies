use '../src/living_save.jo'

test "hired porter is funded walks existing cargo and is paid exactly once":
    w = build_world()
    assert(take_job(w, 3, 0, .porter))
    assert(w.carriage.len() > 0 and not w.jobs[3].loaded)
    task = w.carriage[0]
    assert(w.people[task.person].porter and task.fee > 0 and w.accounts[task.escrow].cents == task.fee)
    source = w.cargo[task.cargo].source
    assert(w.cargo_sources[source].sequence < w.jobs[3].cargo_sequence)
    advance_minutes(w, 60)
    assert(w.jobs[3].loaded and cargo_all_aboard(w, 3))
    assert(w.carriage[0].phase == .done and w.carriage[0].paid)
    assert(w.accounts[task.escrow].cents == 0)
    paid = 0
    loop entry in w.ledger.recent:
        if entry.debit == task.escrow and entry.credit == w.people[task.person].account: paid += entry.cents
    assert(paid == task.fee)
    assert(invariant_errors(w).len() == 0)

test "player picks up walks drops saves and puts the same crate aboard":
    w = build_world()
    assert(take_job(w, 3, 0, .player))
    assert(w.jobs[3].handling_bonus == 80)
    lot = w.jobs[3].cargo_ids[0]
    cargo_person_pose(w, 0, w.cargo[lot].pos)
    assert(cargo_pick_up(w, 0, lot))
    assert(start_trip(w, 0, 2, w.jobs[3].cause) == -1)
    dropped = w.people[0].pose.pos + vec3(0, 0, 5)
    cargo_person_pose(w, 0, dropped)
    assert(cargo_put_down(w, 0) and w.cargo[lot].pos == dropped)
    loaded = from_text[World](to_text(w))
    assert(loaded is World and loaded.cargo[lot].pos == dropped)
    w = loaded
    assert(cargo_pick_up(w, 0, lot))
    cargo_person_pose(w, 0, cargo_loading_spot(w, 0)!)
    assert(cargo_put_down(w, 0, true))
    advance_minutes(w, 5)
    assert(w.jobs[3].loaded and w.cargo[lot].where == .aircraft)
    assert(w.cargo[lot].source == loaded.cargo[lot].source and invariant_errors(w).len() == 0)

test "local errand uses hands and owned stock without aircraft departure":
    w = build_world(); before = stock_totals(w); trips = w.next_trip
    target = w.cargo_harbors[0].boat
    job = post_job(w, 6, 0, .commodity, 1, 1000, 180, 600, delivery_mode = .foot, dropoff = target)
    assert(job >= 0 and take_job(w, job, 0, .player))
    lot = w.jobs[job].cargo_ids[0]
    cargo_person_pose(w, 0, w.cargo[lot].pos)
    assert(cargo_pick_up(w, 0, lot))
    cargo_person_pose(w, 0, target)
    assert(cargo_put_down(w, 0) and w.jobs[job].collected)
    assert(deliver_job(w, job, 0) and not deliver_job(w, job, 0))
    assert(w.jobs[job].state == .delivered and w.next_trip == trips)
    assert(w.cargo[lot].owner == 6 and w.cargo[lot].store == .pocket and w.cargo[lot].pos == target)
    assert(stock_totals(w) == before and invariant_errors(w).len() == 0)

test "scene owned porter never moves from abstract clock and fold has no catchup":
    w = build_world(); assert(take_job(w, 3, 0, .porter))
    id = 0; person = w.carriage[id].person; start = w.people[person].pose.pos
    w.carriage[id].move_owner = .scene; w.people[person].move_owner = .scene
    advance_minutes(w, 10)
    assert(w.people[person].pose.pos == start and not w.jobs[3].loaded)
    fold_carriage_for_save(w)
    assert(w.carriage[id].last_tick == w.tick)
    advance_minutes(w, 1)
    assert(length(w.people[person].pose.pos - start) <= 2.51)
    assert(invariant_errors(w).len() == 0)

test "purchased goods are fetched from stock and the carried lot is stowed and unloaded":
    w = build_world(); before = stock_totals(w)
    assert(trade(w, 0, 0, 1, 1000, true))
    ids = cargo_ids(w, .pocket, 0, 1); assert(ids.len() > 0)
    id = ids[0]; root = w.cargo[id].source
    cargo_person_pose(w, 0, w.cargo[id].pos)
    assert(cargo_pick_up(w, 0, id))
    cargo_person_pose(w, 0, cargo_loading_spot(w, 0)!)
    assert(cargo_put_down(w, 0, true))
    assert(w.cargo[id].store == .aircraft and w.cargo[id].where == .aircraft and w.cargo[id].source == root)
    assert(cargo_pick_up(w, 0, id))
    dropped = w.people[0].pose.pos - vec3(0, 0, 2)
    cargo_person_pose(w, 0, dropped)
    assert(cargo_put_down(w, 0))
    assert(w.cargo[id].store == .pocket and w.cargo[id].pos == dropped)
    assert(stock_totals(w) == before and invariant_errors(w).len() == 0)

test "a full hold blocks a porter then retries after real space becomes available":
    w = build_world(); assert(take_job(w, 3, 0, .porter))
    # Put an owned, real opening-stock load aboard before the porter reaches the hold.
    quantity = 8950
    assert(trade(w, 0, 0, 3, quantity, true, 0))
    advance_minutes(w, 90)
    blocked = false
    loop id in w.active_carriage:
        if w.carriage[id].job == 3 and w.carriage[id].blocked != "": blocked = true
    assert(blocked and not w.jobs[3].loaded)
    assert(trade(w, 0, 0, 3, 2000, false, 0))
    advance_minutes(w, 20)
    assert(w.jobs[3].loaded and invariant_errors(w).len() == 0)

test "receiver signs at the actual aircraft and still walks home with that same saved crate":
    w = build_world()
    loop minute in 0..100:
        if w.jobs[0].state == .delivered: break
        advance_minutes(w,1)
    assert(w.jobs[0].state == .delivered)
    lot = w.jobs[0].cargo_ids[0]; task = -1
    loop id in w.active_carriage:
        if w.carriage[id].cargo == lot: task = id
    assert(task >= 0 and w.carriage[task].phase == .carry)
    assert(w.cargo[lot].where == .person and w.cargo[lot].person == 10 and w.cargo[lot].owner == 10 and w.cargo[lot].store == .pocket)
    before = w.cargo[lot].pos
    parsed = from_text[World](to_text(w)); assert(parsed is World)
    w = parsed; advance_minutes(w,2)
    assert(w.carriage[task].phase == .carry and length(w.cargo[lot].pos-before) > 1)
    assert(validate_save_world(w) == "")
    advance_minutes(w,70)
    assert(w.carriage[task].phase == .done and w.cargo[lot].where == .warehouse)
    assert(invariant_errors(w).len() == 0)

test "cancelling cargo in player hands preserves its exact dropped position and title":
    w = build_world(); assert(take_job(w,3,0,.player))
    lot = w.jobs[3].cargo_ids[0]
    cargo_person_pose(w,0,w.cargo[lot].pos); assert(cargo_pick_up(w,0,lot))
    spot = w.people[0].pose.pos+vec3(7,0,2); cargo_person_pose(w,0,spot)
    assert(expire_job(w,3,true))
    assert(w.people[0].carrying == -1 and w.cargo[lot].pos == spot and w.cargo[lot].where == .quay)
    assert(w.cargo[lot].owner == 1 and w.cargo[lot].store == .aftermath)
    fold_carriage_for_save(w)
    assert(validate_save_world(w) == "")

test "expired loaded goods are physically collected by their owner before custody returns":
    w = build_world(); lot = w.jobs[2].cargo_ids[0]; root = w.cargo[lot].source
    assert(expire_job(w,2,true) and not return_job_cargo(w,2,11))
    assert(w.jobs[2].returned_quantity == 0 and w.cargo[lot].where == .aircraft)
    assert(start_trip(w,11,4,w.jobs[2].cause) >= 0)
    advance_minutes(w,240)
    if w.jobs[2].returned_quantity != 3000:
        print(w.jobs[2]); loop id in w.active_carriage: print(w.carriage[id],w.people[w.carriage[id].person].pose)
    assert(w.jobs[2].returned_quantity == 3000 and w.cargo[lot].owner == 20 and w.cargo[lot].source == root)
    assert(w.cargo[lot].store == .pocket and w.cargo[lot].where != .aircraft)
    assert(invariant_errors(w).len() == 0)

use '../src/living_pirates.jo'

test "a crate already in the consignee's hands is not loot aboard the aircraft":
    w = build_world(); lot = w.jobs[1].cargo_ids[0]
    # Actual collection changes physical location before the inventory custody transaction.
    w.cargo[lot].where = .person; w.cargo[lot].person = 3
    w.cargo[lot].pos = w.people[3].pose.pos; w.people[3].carrying = lot
    before = w.aircraft[2].cargo
    aboard = before.qty[3]-w.cargo[lot].quantity
    assert(cargo_aboard_quantity(w,2,3) == aboard)
    loot_cargo(w,6,2)
    assert(w.aircraft[2].cargo.qty[3] >= w.cargo[lot].quantity and w.cargo[lot].person == 3 and w.cargo[lot].owner == 3)
    assert(invariant_errors(w).len() == 0)

test "personal stock must return to the market before a sale can transfer its title":
    w = build_world(); assert(trade(w,0,0,2,1000,true))
    lot = cargo_ids(w,.pocket,0,2)[0]
    cargo_person_pose(w,0,w.cargo[lot].pos); assert(cargo_pick_up(w,0,lot))
    cargo_person_pose(w,0,w.people[0].pose.pos+vec3(15,0,0)); assert(cargo_put_down(w,0))
    stock = w.people[0].pocket; money = w.accounts[0].cents
    assert(not trade(w,0,0,2,1000,false))
    assert(w.people[0].pocket == stock and w.accounts[0].cents == money)
    assert(cargo_pick_up(w,0,lot))
    cargo_person_pose(w,0,cargo_stock_spot(w,0,2))
    assert(trade(w,0,0,2,1000,false) and w.people[0].carrying == -1)
    assert(invariant_errors(w).len() == 0)

test "a foot delivery between same island settlements leaves the aircraft at its home quay":
    w = build_world()
    w.cargo_harbors[1].island = w.cargo_harbors[0].island
    target = w.cargo_harbors[1].warehouse
    job = post_job(w,6,1,.commodity,1,1000,180,10000,delivery_mode=.foot,dropoff=target)
    assert(job >= 0 and take_job(w,job,0,.player))
    lot = w.jobs[job].cargo_ids[0]
    cargo_person_pose(w,0,w.cargo[lot].pos); assert(cargo_pick_up(w,0,lot))
    cargo_person_pose(w,0,target)
    assert(w.people[0].place == 1 and w.aircraft[0].place == 0)
    assert(cargo_put_down(w,0) and deliver_job(w,job,0))
    assert(w.cargo[lot].place == 1 and invariant_errors(w).len() == 0)

use '../src/living_weather.jo'

test "ditching a plane preserves dockside hands and every client's salvage title":
    w = build_world(); lot = w.jobs[1].cargo_ids[0]
    w.cargo[lot].where = .person; w.cargo[lot].person = 3
    w.cargo[lot].pos = w.people[3].pose.pos; w.people[3].carrying = lot
    position = w.cargo[lot].pos; held = w.cargo[lot].quantity
    salvage = ditch(w,2,w.jobs[1].cause)
    assert(w.cargo[lot].where == .person and w.cargo[lot].pos == position and w.people[3].carrying == lot)
    assert(w.aircraft[2].cargo.qty[3] == held and w.jobs[1].lost_quantity == 3000-held)
    loop id in w.jobs[1].cargo_ids:
        assert(w.cargo[id].owner == 3)
        if id != lot: assert(w.cargo[id].store == .aftermath and w.cargo[id].holder == salvage)
    assert(invariant_errors(w).len() == 0)

test "saved slots resume an identified carried load and its funded porter deterministically":
    assert(env("SLOPPY_SAVE_DIR") != none)
    w = build_world(); assert(take_job(w,3,0,.porter))
    person = w.carriage[0].person
    loop minute in 0..60:
        if w.people[person].carrying >= 0: break
        advance_minutes(w,1)
    lot = w.people[person].carrying; assert(lot >= 0)
    prefix = "cargo-carried-slot"
    delete_data("{prefix}-a"); delete_data("{prefix}-b")
    assert(save_game(w,PresentationState(),123,prefix) is int)
    saved = load_game(123,prefix); assert(saved is SaveGame)
    restored = saved.world
    assert(restored.people[person].carrying == lot and restored.cargo[lot].pos == w.cargo[lot].pos)
    advance_minutes(w,30); advance_minutes(restored,30)
    assert(canonical_text(w) == canonical_text(restored))
    delete_data("{prefix}-a"); delete_data("{prefix}-b")

test "cancelling and reposting correspondence preserves existing dropped letters":
    w = build_world()
    job = post_job(w,1,2,.sealed,-1,3,500,600)
    assert(job >= 0 and take_job(w,job,0,.player))
    lot = w.jobs[job].cargo_ids[0]; source = w.cargo[lot].source
    cargo_person_pose(w,0,w.cargo[lot].pos); assert(cargo_pick_up(w,0,lot))
    position = w.people[0].pose.pos+vec3(6,0,0); cargo_person_pose(w,0,position)
    assert(expire_job(w,job,true))
    assert(w.cargo[lot].pos == position and w.cargo[lot].where == .quay and w.cargo[lot].job == -1)
    next = post_job(w,1,2,.sealed,-1,3,500,600)
    assert(next >= 0 and w.cargo[lot].job == next and w.cargo[lot].pos == position and w.cargo[lot].where == .quay and w.cargo[lot].source == source)
    assert(invariant_errors(w).len() == 0)
