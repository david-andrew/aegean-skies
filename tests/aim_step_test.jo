# Four fixed aim steps from the trimmed nose of the player's Gull at the
# strait's formation speed, flown through the shared mouse/touch/pad controls.
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/pilot.jo' as pilot
import '../tools/aim_track.jo' as aim

struct StepResult:
    settled = -1.0
    overshoot = 0.0
    later_error = 0.0

_measure = (k: fl.CraftSpec, start: fl.CraftState, tangent: vec3, degrees: f64, hz: int) -> StepResult:
    nose = fl.forward(start)
    angle = degrees * PI / 180.0
    target = normalize(nose * f32(cos(angle)) + tangent * f32(sin(angle)))
    dt = 1.0 / f64(hz)
    flyer = pilot.Flyer(kind = k.kind, model = 0, spec = k, state = start, throttle = start.throttle, mouse_mode = true, fighting = true,
        aim_seen = nose, aim_heading = atan2(f64(target.x), -f64(target.z)), aim_climb = asin(f64(target.y)))
    result = StepResult()
    inside = 0
    loop i in 0..hz * 7:
        ctl = pilot.key_controls(flyer, dt)
        fl.step(k, flyer.state, ctl, fl.FlightEnv(), dt)
        assert(not flyer.state.crashed and not flyer.state.on_water and not flyer.state.on_ground)
        fwd = fl.forward(flyer.state)
        err = atan2(f64(length(cross(fwd, target))), f64(dot(fwd, target))) * 180.0 / PI
        travel = atan2(f64(dot(fwd, tangent)), f64(dot(fwd, nose))) * 180.0 / PI
        result.overshoot = max(result.overshoot, travel - degrees)
        # First entry into a quarter-degree cone held for half a second.
        if err <= 0.25: inside += 1
        else: inside = 0
        if result.settled > 0.0: result.later_error = max(result.later_error, err)
        if result.settled < 0.0 and f64(inside - 1) * dt >= 0.5:
            result.settled = f64(i + 2 - inside) * dt
    result

test "v2 player aim settles onto a step in all four directions":
    k = aim.spec_for(.gull, 1)
    speed = k.cruise_speed * 0.86
    thr = fl.cruise_throttle(k, speed / aim.K)
    s = fl.CraftState(position = vec3(0, 1500, 0), velocity = vec3(0, 0, f32(-speed)), fuel = k.fuel_capacity, throttle = thr, water_age = 1.0)
    loop i in 0..240:
        fl.step(k, s, fl.Controls(throttle = thr), fl.FlightEnv(), 1.0 / 60.0)
    up = quat_rotate(s.orientation, vec3(0, 1, 0))
    right = quat_rotate(s.orientation, vec3(1, 0, 0))
    # Small steps must stay on aim; a large lateral turn also needs time to bank.
    loop size in [(2.0, 0.6), (5.0, 0.9), (15.0, 1.6), (45.0, 4.3)]:
        degrees = size.0
        loop direction in ["up", "down", "left", "right"]:
            tangent = match direction:
                "up": up
                "down": -up
                "left": -right
                _: right
            loop hz in [60, 30]:
                r = _measure(k, s, tangent, degrees, hz)
                print("{hz} Hz, {degrees:.0} degrees {direction}: settled {r.settled:.3} s, overshoot {r.overshoot:.3} degrees")
                limit = if degrees == 45.0 and direction == "down": 2.6 else: size.1
                assert(r.settled > 0.0 and r.settled < limit, "{degrees} {direction} at {hz} Hz")
                if degrees <= 5.0:
                    assert(r.overshoot < 0.15 and r.later_error <= 0.25, "{degrees} {direction} at {hz} Hz")
    fl.set_speed_scale(1.0)
    tw.set_tweaks(tw.Tweaks())

test "v2 player can bank past vertical for a low diagonal aim when the wing tip clears":
    k = aim.spec_for(.gull, 1)
    s = fl.CraftState(velocity = vec3(0, 0, f32(-k.cruise_speed)), orientation = quat_axis_angle(vec3(0, 0, -1), PI / 2.0), gap = 1500.0)
    target = aim.dir_of(PI / 3.0, -PI / 6.0)
    high = fl.steer(k, s, target, fighting = true)
    s.gap = k.span * 0.25
    low = fl.steer(k, s, target, fighting = true)
    assert(high.roll > 0.0 and low.roll < 0.0, "roll at height {high.roll}, near the surface {low.roll}")
    fl.set_speed_scale(1.0)
    tw.set_tweaks(tw.Tweaks())


test "v2 player can push at low airspeed within the negative load limit":
    k = aim.spec_for(.gull, 1)
    speed = k.stall_speed * 1.05
    s = fl.CraftState(velocity = vec3(0, 0, f32(-speed * aim.K)), gap = 500.0)
    c = fl.steer(k, s, aim.dir_of(0.0, -PI / 4.0), fighting = true)
    # Wings level, the stick adds a path turn to the one g holding her up.
    load = 1.0 + c.pitch * k.pitch_rate * speed / fl.FLIGHT_G
    assert(load < -0.5 and load >= -2.001, "requested load {load:.3} g")
    fl.set_speed_scale(1.0)
    tw.set_tweaks(tw.Tweaks())
