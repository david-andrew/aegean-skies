use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_player.jo'

test "player command receipt rejects replay before another purchase":
    w = build_world()
    c = PlayerCommand(tick=0,sequence=0,kind=.buy,place=0,craft=0,good=4,quantity=1000)
    assert(apply_command(w,c).accepted)
    cash = w.accounts[0].cents; stock = w.aircraft[0].cargo.qty[4]
    assert(not apply_command(w,c).accepted)
    assert(w.accounts[0].cents == cash and w.aircraft[0].cargo.qty[4] == stock)
    c.sequence = 1; c.place = 4
    assert(not apply_command(w,c).accepted)
    assert(money_balances(w) and goods_balance(w))
