use '../src/living_money.jo'
use '../src/canal_service.jo'
use '../src/canal_geometry.jo'
use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_far_types.jo'
use '../src/living_far_people.jo'
use '../src/living_far_economy.jo'
use '../src/living_place_context.jo'
use '../src/living_seed.jo'
use '../src/living_duties.jo'
use '../src/living_checks.jo'
use '../src/living_save.jo'
use '../src/living_far_stock.jo'

canal_service_fixture=()->World:
    init_canal_geometry()
    w=build_world(u64(42))
    contexts:LifePlaceContext[]
    loop k in 0..6:contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    contexts.push(LifePlaceContext(CANAL_CITY_ID,CANAL_CITY_NAME,1,1,canal_workshop))
    assert(publish_place_contexts(w,1,contexts,[-1,CANAL_CITY_ID,-1]))
    assert(populate_settlement_economy(w,1,[FarPlaceSeed(CANAL_CITY_ID,80,1,5)],[]))
    p=promote_far_person(w,CANAL_CITY_ID,.artisan)
    assert(p>=26)
    w.people[p].pose.pos=canal_workshop
    w.people[0].place= -1;w.people[0].pose.pos=canal_workshop
    w.aircraft[0].place= -1;w.aircraft[0].dock= -1;w.aircraft[0].pose.pos=canal_launch;w.aircraft[0].engine=600
    w

test "canal repair spends owned parts and pays actual saved labour exactly once":
    w=canal_service_fixture()
    id=request_repair(w,0);assert(id>=0)
    stock=far_market_qty(w,CANAL_CITY_ID,5)
    assert(start_repair(w,id))
    assert(w.aircraft[0].engine==600 and w.aircraft[0].state==.workshop)
    assert(far_market_qty(w,CANAL_CITY_ID,5)==stock-50)
    assert(not start_repair(w,id))
    # Persist halfway through; the saved obligation is the sole progress record.
    loop _ in 0..30:w.minute+=1;w.tick=w.minute*120;advance_repairs(w)
    text=canonical_text(w);again=from_text[World](text)
    assert(again is World)
    w=again
    loop _ in 0..30:w.minute+=1;w.tick=w.minute*120;advance_repairs(w)
    assert(w.aircraft[0].engine==800 and w.aircraft[0].state==.moored and w.aircraft[0].owner==0)
    assert(w.aircraft[0].pose.pos==canal_launch and w.obligations[id].state==.fulfilled)
    advance_repairs(w)
    assert(far_market_qty(w,CANAL_CITY_ID,5)==stock-50)
    assert(money_balances(w) and goods_balance(w))
    assert(validate_save_world(w)=="",validate_save_world(w))

test "canal workshop refuses distant craft and refunds unearned labour on interruption":
    w=canal_service_fixture()
    w.aircraft[0].pose.pos+=vec3(100,0,0)
    assert(request_repair(w,0)<0)
    w.aircraft[0].pose.pos=canal_launch
    id=request_repair(w,0);assert(start_repair(w,id))
    cancel_repair(w,id)
    assert(w.aircraft[0].engine==600 and w.aircraft[0].repair_obligation<0)
    assert(w.accounts[w.obligations[id].labor_escrow].cents==0)
    assert(money_balances(w) and goods_balance(w))
