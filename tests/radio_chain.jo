use '../src/radio_chain.jo'

test "receiver noise rises as reception weakens and rises again at night":
    energies: f64[]
    loop setting in 0..4:
        strength=if setting==0: 1.0 else: if setting==1: 0.55 else: 0.18
        night=if setting==3: 1.0 else: 0.0
        c=make_radio_chain(73); c.strength=strength; c.night=night
        energy=0.0
        loop i in 0..160000:
            v=radio_chain_sample(c,0,strength,0,0,night)
            assert(v==v and abs(v)<0.95)
            energy+=v*v
        energies.push(energy)
    assert(energies[1]>energies[0]*10 and energies[2]>energies[1]*2)
    assert(energies[3]>energies[2]*1.15)

test "record surface noise exists at full strength but a live channel has none":
    live=make_radio_chain(2); record=make_radio_chain(2)
    a=0.0; b=0.0
    loop i in 0..160000:
        x=radio_chain_sample(live,0,1,0,0); y=radio_chain_sample(record,0,1,0,1)
        a+=x*x; b+=y*y
    assert(b>a*20 and record.clicks>2000 and record.clicks<12000)

test "new receiver has a midrange passband and rejects low bass and ultrasonic energy":
    energies: f64[]
    loop frequency in [40.0,1000.0,7400.0]:
        c=make_radio_chain()
        energy=0.0
        loop k in 0..32000:
            y=radio_chain_sample(c,0.1*sin(TAU*frequency*f64(k)/16000.0),1,0,0)
            if k>8000: energy+=y*y
        energies.push(energy)
    assert(energies[0]<energies[1]*0.03 and energies[2]<energies[1]*0.03)

test "off tuning adds a carrier whistle even without programme input":
    center=make_radio_chain(17); edge=make_radio_chain(17)
    a=0.0; b=0.0
    loop k in 0..32000:
        x=radio_chain_sample(center,0,0.7,0,0); y=radio_chain_sample(edge,0,0.7,8,0)
        a+=x*x; b+=y*y
    assert(b>a*3)

test "record and receiver stay bounded through level and tuning transitions":
    c=make_radio_chain()
    previous=0.0
    loop k in 0..96000:
        strength=if k<32000: 1.0 else: if k<64000: 0.1 else: 0.6
        x=(if k<48000: 0.1 else: 1.5)*sin(TAU*720.0*f64(k)/16000.0)
        v=radio_chain_sample(c,x,strength,if k<64000: 0.0 else: 20.0,1,1)
        assert(v==v and abs(v)<=0.95)
        if k==32000 or k==64000: assert(abs(v-previous)<0.3)
        previous=v

test "weak reception has continuous micro crackle rather than isolated crashes":
    c=make_radio_chain(9); c.strength=0.18; c.night=1
    peak=0.0; total=0.0; block=0.0; quiet_blocks=0
    loop k in 0..160000:
        v=radio_chain_sample(c,0,0.18,0,0,1)
        peak=max(peak,abs(v)); total+=v*v; block+=v*v
        if k%320==319:
            if block<0.00001: quiet_blocks+=1
            block=0
    assert(c.clicks>4000 and c.clusters>60)
    assert(peak<0.16 and quiet_blocks<5 and total>0.1)

test "wear is the same receiver heavier: a narrower band, more noise and crackle, never louder than the clip, and nothing at wear 0":
    plain=make_radio_chain(11); same=make_radio_chain(11,0,0.0); worn=make_radio_chain(11,0,0.7)
    quiet_plain=0.0; quiet_worn=0.0
    loop i in 0..160000:
        a=radio_chain_sample(plain,0,1,0,0.1); b=radio_chain_sample(same,0,1,0,0.1); c=radio_chain_sample(worn,0,1,0,0.1)
        assert(a==b)
        assert(c==c and abs(c)<0.95)
        quiet_plain+=a*a; quiet_worn+=c*c
    assert(quiet_worn>quiet_plain*2.0)
    assert(worn.clicks>plain.clicks*1.5)
    # a tone near the top of the old band comes through weaker, one in the middle about as before
    levels: f64[]
    loop frequency in [1000.0,2600.0]:
        for_wear=[make_radio_chain(5),make_radio_chain(5,0,0.7)]
        loop k in 0..2:
            e=0.0
            loop i in 0..32000:
                x=0.1*sin(TAU*frequency*f64(i)/16000.0)
                v=radio_chain_sample(for_wear[k],x,1,0,0)
                if i>16000: e+=v*v
            levels.push(e)
    assert(levels[3]<levels[2]*0.8)
    assert(levels[1]>levels[0]*0.3 and levels[1]<levels[0]*3.0)
