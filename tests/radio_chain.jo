use '../src/radio_chain.jo'

test "receiver noise rises as reception weakens and rises again at night":
    energies: f64[]
    loop setting in 0..4:
        strength=if setting==0: 1.0 else: if setting==1: 0.55 else: 0.18
        night=if setting==3: 1.0 else: 0.0
        c=make_radio_chain(73); c.strength=strength; c.night=night
        energy=0.0
        loop i in 0..160000:
            v=radio_chain_sample(c,0,strength,0,0,night)
            assert(v==v and abs(v)<0.95)
            energy+=v*v
        energies.push(energy)
    assert(energies[1]>energies[0]*10 and energies[2]>energies[1]*2)
    assert(energies[3]>energies[2]*1.15)

test "record surface noise exists at full strength but a live channel has none":
    live=make_radio_chain(2); record=make_radio_chain(2)
    a=0.0; b=0.0
    loop i in 0..160000:
        x=radio_chain_sample(live,0,1,0,0); y=radio_chain_sample(record,0,1,0,1)
        a+=x*x; b+=y*y
    assert(b>a*20 and record.clicks>100 and record.clicks<500)

test "new receiver has a midrange passband and rejects low bass and ultrasonic energy":
    energies: f64[]
    loop frequency in [40.0,1000.0,7400.0]:
        c=make_radio_chain()
        energy=0.0
        loop k in 0..32000:
            y=radio_chain_sample(c,0.1*sin(TAU*frequency*f64(k)/16000.0),1,0,0)
            if k>8000: energy+=y*y
        energies.push(energy)
    assert(energies[0]<energies[1]*0.03 and energies[2]<energies[1]*0.03)

test "off tuning adds a carrier whistle even without programme input":
    center=make_radio_chain(17); edge=make_radio_chain(17)
    a=0.0; b=0.0
    loop k in 0..32000:
        x=radio_chain_sample(center,0,0.7,0,0); y=radio_chain_sample(edge,0,0.7,8,0)
        a+=x*x; b+=y*y
    assert(b>a*3)

test "record and receiver stay bounded through level and tuning transitions":
    c=make_radio_chain()
    previous=0.0
    loop k in 0..96000:
        strength=if k<32000: 1.0 else: if k<64000: 0.1 else: 0.6
        x=(if k<48000: 0.1 else: 1.5)*sin(TAU*720.0*f64(k)/16000.0)
        v=radio_chain_sample(c,x,strength,if k<64000: 0.0 else: 20.0,1,1)
        assert(v==v and abs(v)<=0.95)
        if k==32000 or k==64000: assert(abs(v-previous)<0.3)
        previous=v
