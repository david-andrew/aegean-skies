# The pilot's own cat in the scene: following on foot, hopping aboard and off, riding, being left
# in a town or with someone, waiting outside, the night's room, the jacket.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/cat_pet_test.jo
use '../src/living_types.jo'
use '../src/cat_bonds.jo'
use '../src/cats.jo'

_ground = (x: f64, z: f64) -> f64: 1.0
_dist = (a: vec3, b: vec3) -> f64: f64(length(a.xz - b.xz))

# a scene with an adopted cat beside the pilot on foot
_with_pet = (bonds: mut {int: CatBond}, pet: mut CatCompanion, at: vec3) -> CatScene:
    key = cat_key(f64(at.x), f64(at.z))
    cat_set_stage(bonds, key, 100, CAT_ADOPTED)
    assert(cat_adopt(pet, bonds, key, 0, at, 100))
    s = CatScene()
    _ = update_cats(s, [], CatPilot(pos = at, on_foot = true), CatCraft(), bonds, pet, 100, _ground, 1.0 / 30.0, 0.0)
    assert(pet_index(s) >= 0)
    s

_run = (s: mut CatScene, me: CatPilot, cr: CatCraft, bonds: mut {int: CatBond}, pet: mut CatCompanion, secs: f64, t0: f64, homes: vec4[] = []) -> CatNews:
    all = CatNews()
    n = int(secs * 30.0)
    loop i in 0..n:
        w = update_cats(s, homes, me, cr, bonds, pet, 100 + int((t0 + f64(i) / 30.0) / 60.0), _ground, 1.0 / 30.0, t0 + f64(i) / 30.0)
        if w.aboard: all.aboard = true
        if w.off: all.off = true
        if w.left: all.left = true
        if w.said != "": all.said = w.said
    all

_moored = (at: vec3) -> CatCraft: CatCraft(pos = at, seat = vec3(0.3, 0.6, 0.2), exit = vec3(1.6, -0.3, 0.4), still = true)

test "the adopted cat follows him through the town at its own pace, with detours":
    bonds: {int: CatBond}
    pet = CatCompanion()
    s = _with_pet(bonds, pet, vec3(0, 1, 0))
    k = pet_index(s)
    # (he walks forty metres along a street at a walk; it keeps up, stopping now and then)
    detours = 0; t = 1.0; was = 0
    loop i in 0..1200:
        p = vec3(f32(f64(i) * 1.7 / 30.0), 1, 0)
        _ = update_cats(s, [], CatPilot(pos = p, on_foot = true, moving = true), CatCraft(), bonds, pet, 100, _ground, 1.0 / 30.0, t)
        if s.cats[k].idle > 0 and was == 0: detours += 1
        was = s.cats[k].idle
        t += 1.0 / 30.0
    assert(detours >= 1)
    end = vec3(68, 1, 0)
    assert(_dist(s.cats[k].pos, end) < 14.0)
    # (he stops: it catches up and settles by him)
    _ = _run(s, CatPilot(pos = end, on_foot = true), CatCraft(), bonds, pet, 20.0, t)
    assert(_dist(s.cats[k].pos, end) < 1.6 and pet.with == CAT_WITH)

test "it hops aboard after him, rides in the seat as she flies, and hops off after him":
    bonds: {int: CatBond}
    pet = CatCompanion()
    quay = vec3(0, 1, 0)
    s = _with_pet(bonds, pet, quay)
    k = pet_index(s)
    _ = _run(s, CatPilot(pos = quay, on_foot = true), CatCraft(), bonds, pet, 3.0, 0.0)
    cr = _moored(vec3(3, 0.2, 0))
    # (he climbs aboard: the cat goes to where he went from, and hops on, by the float)
    leapt = false
    seen_aboard = false
    loop i in 0..300:
        w = update_cats(s, [], CatPilot(pos = quay, aboard = true), cr, bonds, pet, 101, _ground, 1.0 / 30.0, 3.0 + f64(i) / 30.0)
        if s.cats[k].mode == CM_LEAP: leapt = true
        if w.aboard: seen_aboard = true
    assert(leapt and seen_aboard and pet_aboard(s) and pet.aboard)
    # (never more than a hop's length at once, and never through the air without a leap)
    # (flying: it stays in the seat, crouching through a hard pull)
    loop i in 0..90:
        fly = CatCraft(pos = vec3(f32(3.0 + f64(i) * 2.0), 50, 0), seat = cr.seat, exit = cr.exit, still = false, speed = 60.0, g = vec3(0, 3.2, 0))
        _ = update_cats(s, [], CatPilot(pos = fly.pos, aboard = true), fly, bonds, pet, 102, _ground, 1.0 / 30.0, 20.0 + f64(i) / 30.0)
        assert(f64(length(s.cats[k].pos - (fly.pos + fly.seat))) < 0.01)
    assert(s.cats[k].act == .crouch)
    # (moored again elsewhere, he steps ashore: off it hops, and lands by him)
    there = vec3(200, 0.2, 0)
    cr2 = _moored(there)
    ashore = vec3(197, 1, 1)
    news = _run(s, CatPilot(pos = ashore, on_foot = true), cr2, bonds, pet, 6.0, 30.0)
    assert(news.off and s.cats[k].mode == CM_GROUND and not pet.aboard)
    assert(_dist(s.cats[k].pos, ashore) < 1.6)

test "left behind when she goes without it, it keeps to a doorstep there and comes back to him":
    bonds: {int: CatBond}
    pet = CatCompanion()
    quay = vec3(0, 1, 0)
    homes = [vec4(4, 1, 6, 0)]
    s = _with_pet(bonds, pet, quay)
    k = pet_index(s)
    # (he takes off at once from far out: she is gone before it can come)
    gone = CatCraft(pos = vec3(90, 20, 0), still = false, speed = 40.0)
    news = _run(s, CatPilot(pos = gone.pos, aboard = true), gone, bonds, pet, 1.0, 0.0, homes)
    assert(news.left and pet.with == CAT_ROAMING and cat_has(pet))
    assert(length(pet.at - vec3(4, 1, 6)) < 0.01)
    # (it walks to the doorstep while she flies off, and is not about once he is far)
    _ = _run(s, CatPilot(pos = vec3(900, 50, 0), aboard = true), CatCraft(pos = vec3(900, 50, 0), still = false, speed = 40.0), bonds, pet, 2.0, 2.0, homes)
    assert(pet_index(s) < 0)
    # (back in the town on foot: it is there, comes over, and is with him again)
    back = vec3(6, 1, 9)
    _ = _run(s, CatPilot(pos = back, on_foot = true), CatCraft(), bonds, pet, 6.0, 10.0, homes)
    assert(pet.with == CAT_WITH and pet_index(s) >= 0)

test "left with someone, it keeps by their door until collected; never twice":
    bonds: {int: CatBond}
    pet = CatCompanion()
    me = vec3(0, 1, 0)
    s = _with_pet(bonds, pet, me)
    door = vec3(3, 1, 0)
    assert(pet_hand_over(s, pet, 12, 4, door, 200))
    assert(not pet_hand_over(s, pet, 13, 4, door, 200))
    # (he walks about the town: it doesn't follow him off)
    _ = _run(s, CatPilot(pos = vec3(30, 1, 0), on_foot = true), CatCraft(), bonds, pet, 20.0, 0.0)
    k = pet_index(s)
    assert(k >= 0 and _dist(s.cats[k].pos, door) < 0.5 and pet.with == CAT_KEPT)
    # (and flies away: it isn't left behind, it is kept)
    _ = _run(s, CatPilot(pos = vec3(500, 30, 0), aboard = true), CatCraft(pos = vec3(500, 30, 0), still = false, speed = 50.0), bonds, pet, 2.0, 20.0)
    assert(pet.with == CAT_KEPT)
    # (collected: with him again, and they may have it in their house)
    _ = _run(s, CatPilot(pos = vec3(4, 1, 0), on_foot = true), CatCraft(), bonds, pet, 1.0, 30.0)
    assert(pet_collect(s, pet, 12, 300) and pet.with == CAT_WITH and pet.welcome.contains(12))
    _ = _run(s, CatPilot(pos = vec3(4, 1, 0), on_foot = true), CatCraft(), bonds, pet, 8.0, 31.0)
    k = pet_index(s)
    assert(_dist(s.cats[k].pos, vec3(4, 1, 0)) < 1.6)

test "it waits outside where it isn't welcome, sleeps in his room, and goes in his jacket":
    bonds: {int: CatBond}
    pet = CatCompanion()
    s = _with_pet(bonds, pet, vec3(0, 1, 0))
    k = pet_index(s)
    # (to the door, then in: it stops at his last step outside)
    loop i in 0..120:
        _ = update_cats(s, [], CatPilot(pos = vec3(f32(f64(i) * 0.05), 1, 0), on_foot = true, moving = true), CatCraft(), bonds, pet, 100, _ground, 1.0 / 30.0, f64(i) / 30.0)
    door = vec3(6, 1, 0)
    inside = vec3(11, 1, 0)
    loop i in 0..300:
        p = if i < 60: vec3(f32(6.0 + f64(i) / 12.0), 1, 0) else: inside
        _ = update_cats(s, [], CatPilot(pos = p, on_foot = true, indoors = true), CatCraft(), bonds, pet, 100, _ground, 1.0 / 30.0, 4.0 + f64(i) / 30.0)
    assert(_dist(s.cats[k].pos, door) < 1.0)
    # (welcome there: it comes in after him)
    _ = _run(s, CatPilot(pos = inside, on_foot = true, indoors = true, welcome = true), CatCraft(), bonds, pet, 8.0, 20.0)
    assert(_dist(s.cats[k].pos, inside) < 1.6)
    # (a night in a room: it is in there with him, and out with him in the morning)
    _ = _run(s, CatPilot(pos = inside, stay = true), CatCraft(), bonds, pet, 1.0, 30.0)
    assert(pet_in_room(s))
    _ = _run(s, CatPilot(pos = inside, on_foot = true), CatCraft(), bonds, pet, 1.0, 31.0)
    assert(not pet_in_room(s) and _dist(s.cats[k].pos, inside) < 1.6)
    # (aboard and baled out: in his jacket, and down again once he is on his feet)
    pet_put_aboard(s, _moored(vec3(20, 0.2, 0)))
    _ = _run(s, CatPilot(pos = vec3(20, 200, 0), bailing = true), CatCraft(pos = vec3(20, 200, 0), still = false, speed = 50.0), bonds, pet, 0.5, 40.0)
    assert(s.cats[k].mode == CM_ARMS)
    landed = vec3(60, 1, 30)
    _ = _run(s, CatPilot(pos = landed, on_foot = true), CatCraft(pos = vec3(400, 1, 0), still = false), bonds, pet, 3.0, 41.0)
    assert(s.cats[k].mode == CM_GROUND and _dist(s.cats[k].pos, landed) < 1.6)

test "the pilot's own cat is never one of a spot's, so it is never there twice":
    bonds: {int: CatBond}
    pet = CatCompanion()
    home = vec3(0, 1, 0)
    homes = [vec4(0, 1, 0, 0), vec4(5, 1, 5, 0)]
    s = _with_pet(bonds, pet, home)
    loop i in 0..60: _ = update_cats(s, homes, CatPilot(pos = vec3(2, 1, 0), on_foot = true), CatCraft(), bonds, pet, 100, _ground, 1.0 / 30.0, f64(i) / 30.0)
    n = 0
    loop c in s.cats:
        if c.key == pet.key: n += 1
    assert(n == 1 and s.cats.len() == 2)

test "after a load the cat is where the save left it: aboard in the seat, or by him, or kept":
    bonds: {int: CatBond}
    pet = CatCompanion()
    s = _with_pet(bonds, pet, vec3(0, 1, 0))
    cr = _moored(vec3(3, 0.2, 0))
    pet_put_aboard(s, cr)
    _ = _run(s, CatPilot(pos = vec3(3, 0.2, 0), aboard = true), cr, bonds, pet, 0.2, 0.0)
    assert(pet.aboard)
    state = PresentationState(cat_bonds = bonds, cat = pet)
    back = from_text[PresentationState](to_text(state))
    assert(back is PresentationState)
    if back is PresentationState:
        bb = back.cat_bonds; bp = back.cat
        fresh = CatScene()
        _ = update_cats(fresh, [], CatPilot(pos = vec3(3, 0.2, 0), aboard = true), cr, bb, bp, 200, _ground, 1.0 / 30.0, 0.0)
        assert(pet_aboard(fresh) and f64(length(fresh.cats[pet_index(fresh)].pos - (cr.pos + cr.seat))) < 0.01)
        # (kept by someone: nowhere about until he is near their door)
        cat_leave_alone(bp, vec3(50, 1, 0), 300)
        assert(cat_leave_with(bp, 7, 1, vec3(50, 1, 0), 300) == false)
        bp.with = CAT_WITH
        assert(cat_leave_with(bp, 7, 1, vec3(50, 1, 0), 300))
        far = CatScene()
        _ = update_cats(far, [], CatPilot(pos = vec3(400, 1, 0), on_foot = true), CatCraft(), bb, bp, 300, _ground, 1.0 / 30.0, 0.0)
        assert(pet_index(far) < 0)
        _ = update_cats(far, [], CatPilot(pos = vec3(55, 1, 0), on_foot = true), CatCraft(), bb, bp, 300, _ground, 1.0 / 30.0, 0.1)
        assert(pet_index(far) >= 0 and f64(length(far.cats[pet_index(far)].pos - vec3(50, 1, 0))) < 0.2)
