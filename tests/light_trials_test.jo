use '../src/render_space.jo'
use '../src/sky_air.jo'
use '../src/look.jo'
use '../src/tweaks.jo'
use '../src/paint.jo'

# The light trials (src/tweaks.jo deep_sea_height, dusk_afterglow): off by default, and with the
# afterglow on, noon is exactly the everyday light and dawn mirrors dusk.

close3 = (a: vec3, b: vec3, eps: f32) -> bool: length(a - b) < eps

with_afterglow = (on: bool):
    t = tweaks
    t.dusk_afterglow = on
    set_tweaks(t)

test "The light trials are off by default and leave the everyday light alone":
    assert(not Tweaks().deep_sea_height)
    assert(not Tweaks().dusk_afterglow)
    with_afterglow(false)
    loop h in [6.5, 12.0, 18.4, 19.35, 23.0]:
        assert(light_at(h).afterglow.w == 0.0)

test "With the afterglow, noon is the everyday noon":
    with_afterglow(false)
    a = light_at(12.0)
    with_afterglow(true)
    b = light_at(12.0)
    with_afterglow(false)
    assert(close3(a.sky_top, b.sky_top, 0.001) and close3(a.sky_horizon, b.sky_horizon, 0.001))
    assert(close3(a.haze, b.haze, 0.001) and close3(a.sun, b.sun, 0.001) and close3(a.shade, b.shade, 0.001))
    assert(close3(a.sea_deep, b.sea_deep, 0.001) and close3(a.sea_shallow, b.sea_shallow, 0.001))
    assert(b.afterglow.w == 0.0)

test "The afterglow lasts well after sunset, mirrors at dawn, and is gone by night":
    with_afterglow(true)
    loop m in [10.0, 30.0, 60.0, 81.0, 105.0]:
        dusk = light_at(18.0 + m / 60.0)
        dawn = light_at(6.0 - m / 60.0)
        assert(abs(dusk.afterglow.x - dawn.afterglow.x) < 0.001)
        assert(close3(dusk.sky_horizon, dawn.sky_horizon, 0.001))
    # (19:21: still a strong glow over a dark sea; 20:45: none, and the stars out)
    assert(light_at(19.35).afterglow.x > 0.6)
    assert(light_at(19.35).sea_deep.y < 0.1)
    late = light_at(20.75)
    assert(late.afterglow.w == 0.0 and late.afterglow.z > 0.99)
    with_afterglow(false)

test "The glow lies on the sun's side, low in the sky":
    sun = normalize(vec3(-1, -0.3, 0))
    glow = vec4(1, 0.25, 0, 1)
    toward = sky_afterglow(normalize(vec3(-1, 0.05, 0)), 200.0, sun, glow)
    away = sky_afterglow(normalize(vec3(1, 0.05, 0)), 200.0, sun, glow)
    high = sky_afterglow(normalize(vec3(-1, 1.2, 0)), 200.0, sun, glow)
    assert(toward.a > 0.75 and away.a < 0.3 and high.a < toward.a * 0.3)
    assert(toward.r > toward.b)

test "Warm bounce: plaster in shade keeps its noon strength and warms toward evening":
    lum = (c: vec3) -> f32: dot(c, vec3(0.2126, 0.7152, 0.0722))
    noon = light_at(12.0)
    cool = paint_plaster_bounce(noon.sun)
    warm = paint_plaster_bounce(noon.sun, true)
    assert(abs(lum(warm) - lum(cool)) < lum(cool) * 0.15)
    evening = paint_plaster_bounce(light_at(17.0).sun, true)
    assert(evening.x > evening.z * 1.8)
    assert(paint_plaster_bounce(light_at(17.0).sun).z >= paint_plaster_bounce(light_at(17.0).sun).x)
    assert(not Tweaks().warm_bounce)
