use '../src/render_space.jo'
use '../src/sky_air.jo'
use '../src/look.jo'
use '../src/tweaks.jo'
use '../src/paint.jo'

# The light of the day: noon as it was, a glow that lasts well after sunset and mirrors at dawn,
# a warm bounce in shade; the "Brighter ocean" tweak off by default.

close3 = (a: vec3, b: vec3, eps: f32) -> bool: length(a - b) < eps

test "Noon is the noon the game was approved with":
    noon = light_at(12.0)
    assert(close3(noon.sky_top, vec3(0.025,0.56,0.74), 0.002))
    assert(close3(noon.sky_horizon, vec3(0.31,0.72,0.80), 0.002))
    assert(close3(noon.haze, vec3(0.58,0.74,0.83), 0.002))
    assert(close3(noon.sun, vec3(1.18,1.1,0.98), 0.002))
    assert(close3(noon.sea_deep, vec3(0.02,0.24,0.46), 0.002) and close3(noon.sea_shallow, vec3(0.2,0.78,0.8), 0.002))
    assert(noon.afterglow.x == 0.0 and noon.stars == 0.0)
    assert(not Tweaks().brighter_ocean)

test "The afterglow lasts well after sunset, mirrors at dawn, and is gone by night":
    loop m in [10.0, 30.0, 60.0, 81.0, 105.0]:
        dusk = light_at(18.0 + m / 60.0)
        dawn = light_at(6.0 - m / 60.0)
        assert(abs(dusk.afterglow.x - dawn.afterglow.x) < 0.001)
        assert(close3(dusk.sky_horizon, dawn.sky_horizon, 0.001))
        # (the glow faces the sun: west at dusk, east at dawn)
        assert(dusk.afterglow.z < -0.9 and dawn.afterglow.z > 0.9)
    # (19:21: still a strong glow over a dark sea; 20:45: none, and the stars out)
    assert(light_at(19.35).afterglow.x > 0.6)
    assert(light_at(19.35).sea_deep.y < 0.1)
    late = light_at(20.75)
    assert(late.afterglow.x == 0.0 and late.stars > 0.99)

test "The glow lies on the sun's side, low in the sky":
    glow = vec4(1, 4, -1, 0)
    toward = sky_afterglow(normalize(vec3(-1, 0.05, 0)), 0.05, glow)
    away = sky_afterglow(normalize(vec3(1, 0.05, 0)), 0.05, glow)
    high = sky_afterglow(normalize(vec3(-1, 1.2, 0)), 0.77, glow)
    assert(toward.a > 0.75 and away.a < 0.3 and high.a < toward.a * 0.3)
    assert(toward.r > toward.b)

test "Warm bounce: plaster in shade keeps its noon strength and warms toward evening":
    lum = (c: vec3) -> f32: dot(c, vec3(0.2126, 0.7152, 0.0722))
    noon = light_at(12.0).sun
    cool = vec3(dot(noon,vec3(0.22,0.62,0.16)))*vec3(0.31,0.33,0.36)   # (the old cool fill)
    assert(abs(lum(paint_plaster_bounce(noon)) - lum(cool)) < lum(cool) * 0.15)
    evening = paint_plaster_bounce(light_at(17.0).sun)
    assert(evening.x > evening.z * 1.8)

test "The glow's shaders are asked for before the sky glows, not at it":
    # (the glow begins at about 16:26 and ends near 03:35 the next morning, mirrored at dawn)
    assert(light_at(16.2).afterglow.x == 0.0 and light_at(16.6).afterglow.x > 0.0)
    assert(not twilight_glow_soon(15.5, 0.5))
    assert(twilight_glow_soon(16.0, 0.5))
    assert(twilight_glow_soon(19.0, 0.5))
    assert(not twilight_glow_soon(12.0, 0.5))
