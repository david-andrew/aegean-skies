use '../src/radio_synth.jo'

test "radio render is bounded deterministic finite across score styles":
    loop style in 0..5:
        a = make_radio_synth(); b = make_radio_synth()
        radio_synth_program(a,RadioStyle(style),5,0)
        radio_synth_program(b,RadioStyle(style),5,0)
        energy = 0.0
        loop k in 0..40:
            x = radio_render(a,800); y = radio_render(b,800)
            assert(x == y and x.len() == 800)
            loop v in x:
                assert(abs(v) <= 0.95)
                energy += f64(v)*f64(v)
        assert(energy > 0.1)
    s = make_radio_synth()
    assert(radio_render(s,100000).len() == RADIO_BLOCK)
    assert(radio_render(s,-1).len() == 0)

test "radio filter attenuates out of band and passes the midrange":
    energies: f64[]
    loop frequency in [60.0,1000.0,7000.0]:
        hi = radio_filter(300,true); lo = radio_filter(3000,false)
        e = 0.0
        loop k in 0..16000:
            y = radio_filter_sample(lo,radio_filter_sample(hi,sin(TAU*frequency*f64(k)/16000.0)))
            if k > 800: e += y*y
        energies.push(e)
    assert(energies[0] < energies[1]*0.01 and energies[2] < energies[1]*0.01)

test "Morse uses actual letter spacing and bounded input":
    e = radio_morse("E")
    assert(e[0] and not e[1] and e.len() == 8)
    a = radio_morse("A")
    assert(a[0] and not a[1] and a[2] and a[3] and a[4] and not a[5])
    assert(radio_morse("e") == e)
    assert(radio_morse("SOS").len() == 34)

test "radio block boundaries do not change its continuous waveform":
    loop style in [RadioStyle.foxtrot,RadioStyle.choir,RadioStyle.morse]:
        a = make_radio_synth(); b = make_radio_synth()
        radio_synth_program(a,style,2,33.17,radio_morse("SEA FAIR"))
        radio_synth_program(b,style,2,33.17,radio_morse("SEA FAIR"))
        loop k in 0..20:
            whole = radio_render(a,800,0.5,7)
            left = radio_render(b,317,0.5,7); right = radio_render(b,483,0.5,7)
            assert(whole == left+right)

test "genre scores have different non silent audio and Morse dashes stay joined":
    signatures: f64[]
    loop style in 0..5:
        s = make_radio_synth(); radio_synth_program(s,RadioStyle(style),0,0)
        sum = 0.0
        loop k in 0..20:
            values = radio_render(s,800,1,0,true)
            loop i in 0..values.len(): sum += abs(f64(values[i]))*f64(1+i%17)
        loop previous in signatures: assert(abs(sum-previous) > 1.0)
        signatures.push(sum)
    s = make_radio_synth(); radio_synth_program(s,.morse,0,0,radio_morse("T"))
    values: f32[]
    loop k in 0..5: values += radio_render(s,800,1,0,true)
    # A three-unit dash has no artificial envelope hole around its internal unit boundaries.
    loop center in [1280,2560]:
        energy = 0.0
        loop i in center-40..center+40: energy += f64(values[i])*f64(values[i])
        assert(energy > 2.0)

test "radio synthesis does not consume or reseed game randomness":
    seed_random(897)
    expected = random(0.0,1.0)
    seed_random(897)
    s = make_radio_synth(); radio_synth_program(s,.tango,73,20)
    _ = radio_render(s,800,0.3,7)
    assert(random(0.0,1.0) == expected)
