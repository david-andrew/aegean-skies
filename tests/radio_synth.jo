use '../src/radio_synth.jo'
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/singer.jo'

test "radio render is bounded deterministic finite across score styles":
    loop style in 0..5:
        a = make_radio_synth(); b = make_radio_synth()
        radio_synth_program(a,RadioStyle(style),5,0)
        radio_synth_program(b,RadioStyle(style),5,0)
        energy = 0.0
        loop k in 0..40:
            x = radio_render(a,800); y = radio_render(b,800)
            assert(x == y and x.len() == 800)
            loop v in x:
                assert(abs(v) <= 0.95)
                energy += f64(v)*f64(v)
        assert(energy > 0.1)
    s = make_radio_synth()
    assert(radio_render(s,100000).len() == RADIO_BLOCK)
    assert(radio_render(s,-1).len() == 0)

test "radio filter attenuates out of band and passes the midrange":
    energies: f64[]
    loop frequency in [60.0,1000.0,7000.0]:
        hi = radio_filter(300,true); lo = radio_filter(3000,false)
        e = 0.0
        loop k in 0..16000:
            y = radio_filter_sample(lo,radio_filter_sample(hi,sin(TAU*frequency*f64(k)/16000.0)))
            if k > 800: e += y*y
        energies.push(e)
    assert(energies[0] < energies[1]*0.01 and energies[2] < energies[1]*0.01)

test "Morse uses actual letter spacing and bounded input":
    e = radio_morse("E")
    assert(e[0] and not e[1] and e.len() == 8)
    a = radio_morse("A")
    assert(a[0] and not a[1] and a[2] and a[3] and a[4] and not a[5])
    assert(radio_morse("e") == e)
    assert(radio_morse("SOS").len() == 34)

test "radio block boundaries do not change its continuous waveform":
    loop style in [RadioStyle.foxtrot,RadioStyle.choir,RadioStyle.morse]:
        a = make_radio_synth(); b = make_radio_synth()
        radio_synth_program(a,style,2,33.17,radio_morse("SEA FAIR"))
        radio_synth_program(b,style,2,33.17,radio_morse("SEA FAIR"))
        loop k in 0..20:
            whole = radio_render(a,800,0.5,7)
            left = radio_render(b,317,0.5,7); right = radio_render(b,483,0.5,7)
            assert(whole == left+right)

test "genre scores have different non silent audio and Morse dashes stay joined":
    signatures: f64[]
    loop style in 0..5:
        s = make_radio_synth(); radio_synth_program(s,RadioStyle(style),0,0)
        sum = 0.0
        loop k in 0..20:
            values = radio_render(s,800,1,0,true)
            loop i in 0..values.len(): sum += abs(f64(values[i]))*f64(1+i%17)
        loop previous in signatures: assert(abs(sum-previous) > 1.0)
        signatures.push(sum)
    s = make_radio_synth(); radio_synth_program(s,.morse,0,0,radio_morse("T"))
    values: f32[]
    loop k in 0..5: values += radio_render(s,800,1,0,true)
    # A three-unit dash has no artificial envelope hole around its internal unit boundaries.
    loop center in [1280,2560]:
        energy = 0.0
        loop i in center-40..center+40: energy += f64(values[i])*f64(values[i])
        assert(energy > 2.0)

test "radio synthesis does not consume or reseed game randomness":
    seed_random(897)
    expected = random(0.0,1.0)
    seed_random(897)
    s = make_radio_synth(); radio_synth_program(s,.tango,73,20)
    _ = radio_render(s,800,0.3,7)
    assert(random(0.0,1.0) == expected)

test "a station plays its style's pieces one after another, each from its start; every radio piece is on some station":
    heard: int[]
    loop style in 0..8:
        if RadioStyle(style) == .morse: continue
        loop station in [-1, 0, 6, 8, 10, 12]:
            pool = radio_pool(RadioStyle(style), station)
            assert(pool.len() >= 1)
            loop k in pool:
                assert(k >= 0 and k < MUSIC_PIECES.len())
                if not (k in heard): heard.push(k)
            # (walking the clock through the round: at each piece's end, the next one at its start)
            cue = radio_cue(RadioStyle(style), station, 0.0)
            t = 0.0
            loop step in 0..pool.len() + 1:
                left = f64(MUSIC_PIECES[cue.piece].frames) / f64(MUSIC_RATE) - cue.at
                after = radio_cue(RadioStyle(style), station, t + left + 0.01)
                assert(after.piece == radio_next_piece(RadioStyle(style), station, cue.piece), "{style} {station} {cue.piece}")
                assert(after.at < 0.05, "{after.at}")
                t += left + 0.01
                cue = after
    # (the Hotel Ancora's evening set and the title's music stay off the air; everything else is broadcast)
    loop k in 0..MUSIC_PIECES.len():
        if MUSIC_PIECES[k].station == "Hotel Ancora" or MUSIC_PIECES[k].station == "Title": assert(not (k in heard), "{k}")
        else: assert(k in heard, "{MUSIC_PIECES[k].title}")
    # (the chapel's choir, the cafe stations' accordion)
    assert(radio_pool(.choir, 12)[0] == 41)
    assert(34 in radio_pool(.bouzouki, 10) and not (34 in radio_pool(.bouzouki, 6)))

test "at a piece's end the radio goes on to the next in the round, without a gap":
    s = make_radio_synth()
    radio_synth_program(s, .tango, 0, 0.0)
    s.channel = 11; radio_music_on_air(s, 0.0)
    first = s.music.piece
    left = s.music.frames - s.music.cursor
    loop left > 0:
        n = min(left, RADIO_BLOCK)
        radio_render(s, n)
        left -= n
    radio_render(s, RADIO_BLOCK)
    assert(s.music.piece == radio_next_piece(.tango, 11, first) and s.music.piece != first)
    assert(s.music.cursor == RADIO_BLOCK)

test "a song on the radio is a voice over the piano: she sings the tune, and its instrument is not played under her":
    piece = 0
    loop k in 0..MUSIC_PIECES.len(): if singer_sings(k): piece = k
    assert(piece > 0 and MUSIC_PIECES[piece].title.starts_with("Ave Maria (Ellens"))
    p = MUSIC_PIECES[piece]
    s = make_radio_synth()
    radio_synth_program(s, .classical, 0, 0.0)
    radio_music_load(s, piece, 0.0)
    assert(s.sings and s.singer.notes.len() > 200)
    # (the score's tune instrument has no note left in her stretches, and the piano is all there)
    piano = 0
    loop e in s.music.events:
        if e.instrument == p.sung_lead and e.pitch >= p.sung_floor:
            seconds = f64(e.start) / f64(MUSIC_RATE)
            loop w in p.sung: assert(not (seconds >= f64(w.x) and seconds < f64(w.y)))
        if e.instrument == 6: piano += 1
    assert(piano > 1500)
    # (heard: more sound where she sings than the piano alone makes, and none of it outside the stretches)
    inside = radio_cue_energy(s, piece, f64(p.sung[0].x) + 20.0, true)
    plain = radio_cue_energy(s, piece, f64(p.sung[0].x) + 20.0, false)
    assert(inside > plain * 1.2, "{inside} {plain}")
    # (after the radio has been on another piece, loading it again sings again)
    radio_music_load(s, 0, 0.0)
    assert(not s.sings)
    radio_music_load(s, piece, 30.0)
    assert(s.sings and s.singer.notes.len() > 200)

# The programme's sound energy over two seconds from a place in a piece, with her voice or without it.
radio_cue_energy = (s: mut RadioSynth, piece: int, at: f64, voice: bool) -> f64:
    radio_music_load(s, piece, at)
    s.sings = voice
    total = 0.0
    loop k in 0..40:
        loop v in radio_render(s, 800, 1.0, 0.0, true, false): total += f64(v) * f64(v)
    total
