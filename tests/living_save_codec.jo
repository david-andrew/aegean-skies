use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_save.jo'
use '../src/living_save_codec.jo'
use 'living_commissions.jo'

test "compressed sparse saves preserve canonical state presentation and reject corrupted content":
    w=commission_fixture(); state=PresentationState(); state.last_hail_tick=42
    game=SaveGame(valid=true,generation=7,terrain_key=123,world=canonical_world(w),presentation=state)
    packed=pack_living_save(game)
    assert(packed.world_deflate.len()<packed.world_bytes)
    decoded=unpack_living_save(packed)
    assert(decoded!=none and decoded!.generation==7 and canonical_text(decoded!.world)==canonical_text(w))
    assert(decoded!.presentation==state)
    packed.world_hash=packed.world_hash xor u64(1)
    assert(unpack_living_save(packed)==none)
    packed.world_hash=packed.world_hash xor u64(1); packed.world_bytes+=1
    assert(unpack_living_save(packed)==none)

test "old text slots upgrade without overwriting them and packed slot corruption falls back":
    w=commission_fixture(); prefix="life4-codec-regression"
    assert(save_data("{prefix}-a","")); assert(save_data("{prefix}-b",""))
    old=SaveGame(valid=true,generation=3,terrain_key=123,world=canonical_world(w))
    assert(save_value("{prefix}-a",old))
    before=load_data("{prefix}-a")
    result=save_game(w,PresentationState(),123,prefix)
    assert(result is int and result==4)
    assert(load_data("{prefix}-a")==before)
    loaded=load_game(123,prefix)
    assert(loaded is SaveGame and loaded.schema==2 and loaded.generation==4 and canonical_text(loaded.world)==canonical_text(w))
    assert(save_data("{prefix}-b","damaged packed slot"))
    loaded=load_game(123,prefix)
    assert(loaded is SaveGame and loaded.generation==3)
    save_data("{prefix}-a",""); save_data("{prefix}-b","")
