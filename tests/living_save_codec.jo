use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_save.jo'
use '../src/living_save_codec.jo'
use 'living_commissions.jo'

test "compressed sparse saves preserve canonical state presentation and reject corrupted content":
    w=commission_fixture(); state=PresentationState(); state.last_hail_tick=42
    game=SaveGame(valid=true,generation=7,terrain_key=123,world=canonical_world(w),presentation=state)
    packed=pack_living_save(game)
    assert(packed.world_deflate.len()<packed.world_bytes)
    decoded=unpack_living_save(packed)
    assert(decoded!=none and decoded!.generation==7 and canonical_text(decoded!.world)==canonical_text(w))
    assert(decoded!.presentation==state)
    packed.world_hash=packed.world_hash xor u64(1)
    assert(unpack_living_save(packed)==none)
    packed.world_hash=packed.world_hash xor u64(1); packed.world_bytes+=1
    assert(unpack_living_save(packed)==none)

test "old text slots upgrade without overwriting them and packed slot corruption falls back":
    w=commission_fixture(); prefix="life4-codec-regression"
    assert(save_data("{prefix}-a","")); assert(save_data("{prefix}-b",""))
    old=SaveGame(valid=true,generation=3,terrain_key=123,world=canonical_world(w))
    assert(save_value("{prefix}-a",old))
    before=load_data("{prefix}-a")
    result=save_game(w,PresentationState(),123,prefix)
    assert(result is int and result==4)
    assert(load_data("{prefix}-a")==before)
    loaded=load_game(123,prefix)
    assert(loaded is SaveGame and loaded.schema==3 and loaded.generation==4 and canonical_text(loaded.world)==canonical_text(w))
    body=load_data("{prefix}-b-data") ?? ""
    assert(body.len()>0 and save_data("{prefix}-b-data",body[0..body.len()-1]))
    loaded=load_game(123,prefix)
    assert(loaded is SaveGame and loaded.generation==3)
    assert(save_data("{prefix}-b-data",body))
    assert(save_data("{prefix}-b","damaged packed slot"))
    loaded=load_game(123,prefix)
    assert(loaded is SaveGame and loaded.generation==3)
    save_data("{prefix}-a",""); save_data("{prefix}-b","")
    save_data("{prefix}-a-data",""); save_data("{prefix}-b-data","")

test "binary bodies preserve arbitrary compressed bytes while older packed text remains readable":
    w=commission_fixture(); game=SaveGame(valid=true,generation=7,terrain_key=123,world=canonical_world(w))
    pair=pack_binary_living_save(game)
    assert(pair.1.len()<pack_living_save(game).world_deflate.len())
    legacy=pair.0; legacy.encoding=2
    assert(unpack_binary_living_save(legacy,pair.1)!=none)
    restored=unpack_binary_living_save(pair.0,pair.1)
    assert(restored!=none and restored!.schema==3 and canonical_text(restored!.world)==canonical_text(w))
    broken=pair.0; broken.world_hash=broken.world_hash xor u64(1)
    assert(unpack_binary_living_save(broken,pair.1)==none)
    prefix="life4-packed-upgrade"
    save_data(prefix+"-b","")
    assert(save_value(prefix+"-a",pack_living_save(game)))
    old=load_game(123,prefix); assert(old is SaveGame and old.schema==2 and old.generation==7)
    before=load_data(prefix+"-a")
    generation=save_game(w,PresentationState(),123,prefix)
    assert(generation is int and generation==8 and load_data(prefix+"-a")==before)
    loaded=load_game(123,prefix); assert(loaded is SaveGame and loaded.schema==3 and loaded.generation==8)
    save_data(prefix+"-a",""); save_data(prefix+"-b",""); save_data(prefix+"-b-data","")
