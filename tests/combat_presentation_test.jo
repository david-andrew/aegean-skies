use '../src/combat_view.jo'
use '../src/combat_trails.jo'
use '../src/combat.jo'
use '../src/cockpit.jo'
use '../src/cockpit_cutout.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/quality.jo'

# Thirty continuously burning aircraft, at every tier, over multiple history wraps.
# This exercises update storage and aging without allocating graphics resources.
test "thirty burning aircraft retain bounded fading wind-blown histories on every tier":
    spec=craft_spec(.corsair,[])
    loop tier in 0..3:
        render_quality=quality_profile(tier);budget=battle_budget(tier)
        view=CombatView();b=Battle(enabled=true)
        loop i in 0..30:
            b.actors.push(Combatant(i,i,i%2,spec,CraftState(position=vec3(f64(i)*20,400,0),velocity=vec3(0,0,-60)),fire=0.7,engagement=1))
        loop frame in 0..60*32:
            loop mut a in b.actors:a.state.position.z-=1
            update_combat_view(view,b,vec3(8,0,0),1.0/60.0,vec3(0,400,-1000))
        assert(view.trails.ribbons.len()<=budget.ribbons and view.trails.ribbons.len()>100)
        assert(view.trails.sources.len()==30)
        assert(view.flame.items.len()<=budget.particles)
        # Smoke expands and drifts after its source disappears, then expires without new work.
        old=view.trails.ribbons[0]
        b.actors=[]
        update_combat_view(view,b,vec3(8,0,0),0.5,vec3(0,400,-1000))
        newer=view.trails.ribbons[0]
        if old.age<old.life-0.5:assert(newer.a.x>old.a.x+3 and newer.a.y>old.a.y)
        update_combat_view(view,b,vec3(8,0,0),30.0,vec3(0,400,-1000))
        loop ribbon in view.trails.ribbons:assert(ribbon.age>=ribbon.life)
    render_quality=RenderQuality()

test "fast near passes cross the listener once without warning about one's own rounds":
    view=CombatView();b=Battle()
    b.rounds=[Round(vec3(2,0,-20),vec3(0,0,-2400),2,1,0.1,serial=10),
        Round(vec3(0,0,-20),vec3(0,0,-2400),1,0,0.1,serial=11),
        Round(vec3(50,0,-20),vec3(0,0,-2400),2,1,0.1,serial=12)]
    combat_near_passes(view,b,1,vec3(0,0,0))
    assert(view.whizzes.len()==1 and length(view.whizzes[0]-vec3(2,0,0))<0.001)
    view.whizz_cool=0
    combat_near_passes(view,b,1,vec3(0,0,0));assert(view.whizzes.len()==0)
    b.rounds[0].serial=13
    combat_near_passes(view,b,1,vec3(0,0,0));assert(view.whizzes.len()==1)

test "event bursts obey hard particle caps and player feedback only comes from own hits":
    render_quality=quality_profile(0);v=CombatView();events:CombatEvent[]
    loop i in 0..1000:events.push(CombatEvent(i,.splash,7,7,2,vec3(0,0,0),strength=1))
    combat_effect_events(v,events,1)
    assert(v.mist.items.len()<=battle_budget(0).particles and v.hit==0)
    combat_effect_events(v,[CombatEvent(1001,.hit,1,1,2,vec3(0,0,0),strength=0.15)],1)
    assert(v.hit>0.5)
    update_combat_view(v,Battle(),vec3(0,0,0),1,vec3(0,0,0))
    assert(v.hit<0.01)
    render_quality=RenderQuality()

test "cockpit well subtraction preserves the rest of crossing hull triangles":
    vs:Vertex3D[]
    loop p in [vec3(-2,-2,0),vec3(2,-2,0),vec3(2,2,0),vec3(-2,-2,0),vec3(2,2,0),vec3(-2,2,0)]:
        vs.push(Vertex3D(p,vec3(0,0,1),vec2(0,0),vec4(1,1,1,1)))
    cut=cockpit_cutout(vs,vec3(0,0,0));area=0.0
    loop i in 0..cut.len()/3:
        a=cut[i*3].pos;b=cut[i*3+1].pos;c=cut[i*3+2].pos
        area+=f64(length(cross(b-a,c-a)))*0.5
        center=(a+b+c)/3.0
        assert(abs(center.x)>=0.5299 or center.y<=-0.9999 or center.y>=0.4499)
    assert(abs(area-(16.0-1.06*1.45))<0.0001)

test "all aircraft sights agree with converged ballistics at both speed scales":
    loop kind in 0..16:
        model=build_craft(Craft(kind),LIVERIES[0])
        loop scale in [1.0,5.0]:
            eye=cockpit_eye_local(model);sight=cockpit_sight(model,scale)
            line=normalize(sight-eye)
            loop mount in gun_mounts(Craft(kind)):
                aim=vec3(0,0,-450)-mount
                time=f64(length(aim))/(420.0*scale)
                arrival=vec3(0,-4.905*time*time,-450)
                error=length(cross(line,normalize(arrival-eye)))
                assert(error<0.0004)
        spec=craft_spec(Craft(kind),model.contacts)
        off=cockpit_values(spec,CraftState(fuel=0,throttle=1))
        assert(off[2]==0 and off[3]==0)

test "wing hits mark both skins of the nearest deck":
    loop y in [1.55,-0.5]:
        frames=hit_mark_frames(HitMark(vec3(-2,y,-0.6),vec3(0,0,1),.left_wing),.gull)
        assert(frames.len()==2)
        top=transform_point(frames[0],vec3(0,0,0));bottom=transform_point(frames[1],vec3(0,0,0))
        assert(abs(f64(top.y)-y-0.115)<0.001 and abs(f64(bottom.y)-y+0.115)<0.001)
        assert(transform_dir(frames[0],vec3(0,0,1)).y>0.99)
        assert(transform_dir(frames[1],vec3(0,0,1)).y< -0.99)
