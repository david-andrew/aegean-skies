# Tavli (Portes): the rules (entering, hitting, bearing off, using as many dice as can be used and
# the larger of two), whole games between townsfolk that always end with every checker accounted
# for, careful players beating loose ones, and stakes that move only by transfer.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/tavli.jo'
use '../src/tavli_sound.jo'

_count = (b: TavliBoard, side: int) -> int:
    n = b.bar[side] + b.off[side]
    loop i in 0..24: n += tavli_own(b, side, i)
    n

_empty = () -> TavliBoard: TavliBoard(fill(0, 24), [0, 0], [0, 0])

_total = (w: World) -> int:
    t = 0
    loop a in w.accounts: t += a.cents
    t

test "the opening position has fifteen a side and 167 pips each":
    b = tavli_start_board()
    assert(_count(b, 0) == 15 and _count(b, 1) == 15)
    assert(tavli_pips(b, 0) == 167 and tavli_pips(b, 1) == 167)

test "an opening 3-1 can make the five point":
    plays = tavli_plays(tavli_start_board(), 0, [3, 1])
    assert(plays.len() > 5)
    made = false
    loop p in plays:
        if p.board.pts[4] == 2 and p.board.pts[7] == 2 and p.board.pts[5] == 4: made = true
    assert(made)
    # and the careful townsperson, playing dark with the same roll, makes their five point
    best = tavli_choose(tavli_start_board(), 1, [3, 1], TavliStyle(care = 1.0), u64(5))
    assert(best.board.pts[19] == -2)

test "a checker on the bar must enter first, and a closed board keeps it out":
    b = _empty()
    b.bar[0] = 1; b.pts[10] = 14
    loop i in 18..24: b.pts[i] = -2
    b.pts[0] = -3
    assert(tavli_plays(b, 0, [6, 5]).len() == 1 and tavli_plays(b, 0, [6, 5])[0].moves.len() == 0)
    b.pts[20] = -1; b.pts[0] = -4      # point 21 opens with a blot on it: a 4 enters and hits
    plays = tavli_plays(b, 0, [4, 2])
    assert(plays.len() > 0)
    loop p in plays:
        assert(p.moves[0].from == TAVLI_BAR and p.moves[0].to == 20 and p.moves[0].hit)
        assert(p.board.bar[1] == 1)

test "bearing off: exact, or a higher die from the farthest checker only":
    b = _empty()
    b.pts[4] = 1; b.pts[1] = 2; b.off[0] = 12
    b.pts[23] = -15
    # a 6 bears off from the five point (the farthest); a 1 can't bear off from there
    moves6 = tavli_single_moves(b, 0, 6)
    assert(moves6.len() == 1 and moves6[0].from == 4 and moves6[0].to == TAVLI_OFF)
    moves1 = tavli_single_moves(b, 0, 1)
    loop m in moves1: assert(m.to != TAVLI_OFF)
    # not all home: nothing comes off
    b.pts[10] = 1; b.off[0] = 11
    loop m in tavli_single_moves(b, 0, 6): assert(m.to != TAVLI_OFF)

_lone = () -> TavliBoard:
    # one light checker on point 16 (the rest borne off), the dark at home on point 24
    b = _empty()
    b.pts[15] = 1; b.off[0] = 14
    b.pts[23] = -13
    b

test "as many dice as can be played, and the larger when only one can":
    open_board = _lone()
    open_board.pts[23] = -15
    assert(tavli_duty(open_board, 0, [6, 5]).need == 2)
    # point 5 blocked: either die alone, but not both; the larger must be the one
    one = _lone()
    one.pts[4] = -2
    duty = tavli_duty(one, 0, [6, 5])
    assert(duty.need == 1 and duty.larger_only == 6)
    moves = tavli_legal_next(one, 0, [6, 5], duty.need, duty.larger_only)
    assert(moves.len() == 1 and moves[0].die == 6 and moves[0].to == 9)
    # points 10 and 11 blocked: nothing at all
    none_board = _lone()
    none_board.pts[9] = -2; none_board.pts[10] = -2; none_board.pts[23] = -11
    assert(tavli_duty(none_board, 0, [6, 5]).need == 0)
    # point 10 blocked: only the 5 first lets both dice be played, so the 6 may not go first
    order = _lone()
    order.pts[9] = -2
    duty = tavli_duty(order, 0, [6, 5])
    assert(duty.need == 2)
    first = tavli_legal_next(order, 0, [6, 5], 2)
    assert(first.len() == 1 and first[0].die == 5 and first[0].to == 10)
    # doubles: four moves
    assert(tavli_duty(open_board, 0, [2, 2, 2, 2]).need == 4)

_play_out = (seed: int, light: TavliStyle, dark: TavliStyle) -> (int, int, int):
    g = TavliGame()
    g.rng = mix64(u64(seed) * u64(2654435761))
    tavli_opening(g)
    turns = 0
    loop g.phase != .done and turns < 600:
        if g.phase == .roll: tavli_throw(g)
        style = if g.turn == 0: light else: dark
        play = tavli_choose(g.board, g.turn, tavli_roll_dice(g.roll[0], g.roll[1]), style, g.rng xor u64(turns))
        loop m in play.moves: assert(tavli_move(g, m))
        if g.phase == .done: break
        assert(tavli_turn_complete(g))
        assert(_count(g.board, 0) == 15 and _count(g.board, 1) == 15)
        tavli_pass(g)
        turns += 1
    (g.winner, g.points, turns)

test "whole games end, every checker accounted for, and care tells":
    careful = TavliStyle(care = 0.95, boldness = 0.4)
    loose = TavliStyle(care = 0.1, boldness = 0.7)
    wins = 0; games = 60; longest = 0
    loop k in 0..games:
        # (each side takes the light half the time)
        r = if k % 2 == 0: _play_out(k, careful, loose) else: _play_out(k, loose, careful)
        assert(r.0 == 0 or r.0 == 1)
        assert(r.1 == 1 or r.1 == 2)
        longest = max(longest, r.2)
        careful_side = if k % 2 == 0: 0 else: 1
        if r.0 == careful_side: wins += 1
    print("careful won {wins} of {games}; longest game {longest} turns")
    assert(longest < 600)
    assert(wins > games / 2)

test "the stake moves by one transfer, and they remember the game":
    w = build_world(u64(3))
    them = 3
    before = _total(w)
    g = tavli_new(w, them, 50, 0)
    g.phase = .done; g.winner = 0; g.points = 2
    records: TavliRecord[]
    mine = w.accounts[w.people[w.player].account].cents
    theirs = w.accounts[w.people[them].account].cents
    s = tavli_settle(w, g, records)
    assert(s.ok and s.cents == 100)
    assert(w.accounts[w.people[w.player].account].cents == mine + 100)
    assert(w.accounts[w.people[them].account].cents == theirs - 100)
    assert(_total(w) == before)
    assert(records.len() == 1 and records[0].wins == 1 and records[0].balance == 100)
    assert(tavli_remark(w, records, them) != "")
    # the player loses the next one, for nothing: no money moves, and they are warmer for it
    rid = w.relationship_index[RelationshipKey(them, w.player)]
    warm = w.relationships[rid].affinity
    g2 = tavli_new(w, them, 0, 1)
    g2.phase = .done; g2.winner = 1; g2.points = 1
    s2 = tavli_settle(w, g2, records)
    assert(s2.ok and s2.cents == 0 and _total(w) == before)
    assert(records[0].losses == 1 and w.relationships[rid].affinity > warm)

test "partners are townsfolk in the town, never the player, and stakes are ones both can stand":
    w = build_world(u64(3))
    partners = tavli_partners(w, 0, [w.player, 3])
    assert(partners.len() > 0 and partners.len() <= 3)
    assert(partners[0] == 3)
    loop id in partners:
        assert(id != w.player)
        assert(w.people[id].place == 0 and w.people[id].trip < 0)
    loop id in partners:
        loop s in tavli_stakes(w, id):
            assert(s * 2 <= w.accounts[w.people[w.player].account].cents)
            assert(s * 2 <= w.accounts[w.people[id].account].cents)
    # a player with empty pockets can still play for the game alone
    pa = w.people[w.player].account
    all = w.accounts[pa].cents
    assert(transfer(w, pa, w.people[3].account, all, .trade))
    assert(tavli_stakes(w, 3) == [0])

_count_p = (b: TavliBoard, side: int) -> int:
    n = b.bar[side] + b.off[side]
    loop i in 0..24: n += tavli_own(b, side, i) + tavli_pinned(b, side, i)
    n

test "Plakoto: a lone checker landed on is pinned, not sent back, and freed when the pinner leaves":
    b = tavli_plakoto_board()
    assert(_count_p(b, 0) == 15 and _count_p(b, 1) == 15 and tavli_pips(b, 0) == 360)
    # a lone dark checker on point 19 (index 18); the light come from index 23 with a 5
    b.pts[0] = -14; b.pts[18] = -1
    m = tavli_single_moves(b, 0, 5)
    pin = TavliMove(23, 18, 5, true)
    assert(m.len() == 1 and m[0].to == 18 and m[0].hit)
    after = tavli_apply(b, 0, pin)
    assert(after.pts[18] == 1 and after.pinned[18] == 1 and after.bar[1] == 0)
    assert(_count_p(after, 1) == 15)
    # the pinned checker can't move; the point is closed to the dark while the pinner holds it
    loop d in 1..7:
        loop mv in tavli_single_moves(after, 1, d): assert(mv.from != 18 and mv.to != 18)
    # the pinner moves on: the dark checker is free again
    freed = tavli_apply(after, 0, TavliMove(18, 15, 3))
    assert(freed.pts[18] == -1 and freed.pinned[18] == -1 and freed.pts[15] == 1)

test "Plakoto: whole games end, every checker accounted for":
    careful = TavliStyle(care = 0.95, boldness = 0.5)
    loose = TavliStyle(care = 0.2, boldness = 0.6)
    longest = 0; careful_wins = 0
    loop k in 0..24:
        g = TavliGame(board = tavli_plakoto_board())
        g.turn_board = g.board
        g.rng = mix64(u64(k + 50) * u64(2654435761))
        tavli_opening(g)
        turns = 0
        loop g.phase != .done and turns < 800:
            if g.phase == .roll: tavli_throw(g)
            style = if (g.turn == 0) == (k % 2 == 0): careful else: loose
            play = tavli_choose(g.board, g.turn, tavli_roll_dice(g.roll[0], g.roll[1]), style, g.rng xor u64(turns))
            loop mv in play.moves:
                if g.phase == .done: break
                assert(tavli_move(g, mv))
            if g.phase == .done: break
            assert(_count_p(g.board, 0) == 15 and _count_p(g.board, 1) == 15)
            tavli_pass(g)
            turns += 1
        assert(g.phase == .done)
        longest = max(longest, turns)
        if g.winner == (if k % 2 == 0: 0 else: 1): careful_wins += 1
    print("Plakoto: careful won {careful_wins} of 24; longest {longest} turns")
    assert(careful_wins > 12)

test "the board's sounds are made in code: short, bounded, not silent":
    bank = make_tavli_sounds()
    assert(bank.clack.len() == 4 and bank.checker.len() == 4 and bank.rattle.len() == 2)
    loop group in [bank.clack, bank.checker, bank.rattle]:
        loop s in group:
            peak = 0.0; energy = 0.0
            loop v in s.samples:
                assert(is_finite(f64(v)))
                peak = max(peak, abs(f64(v))); energy += f64(v) * f64(v)
            assert(peak > 0.5 and peak <= 0.81 and energy > 1.0)
            assert(s.samples.len() / 2 <= MIX_RATE)
