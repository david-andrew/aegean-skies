use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_services.jo'
use '../src/living_weather.jo'
use '../src/living_duties.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_geometry.jo'

test "paid ferry has a water only journey real passenger and empty return":
    w = build_world()
    assert(1 in w.sea_routes and water_path_valid(w.sea_routes[1]))
    before = w.accounts[5].cents
    id = request_ferry(w,5,1)
    assert(id >= 0 and w.accounts[5].cents < before)
    delivered = false
    loop i in 0..10000:
        w.tick += 120; w.minute = w.tick/120
        advance_public_boats(w)
        if w.public_boats[0].delivered:
            delivered = true
            assert(w.people[5].place == 1 and w.people[5].trip == -1)
        if w.public_boats[0].state == 2: break
    assert(delivered and w.public_boats[0].state == 2 and w.trips[id].state == .arrived)
    assert(money_balances(w) and goods_balance(w))

test "paid tow moves same wreck without healing fueling or duplicating salvage":
    w = build_world()
    a = ditch(w,1,w.trips[0].reason)
    advance_minutes(w,200)
    assert(w.people[2].place == 0)
    assert(transfer(w,w.factions[1].account,w.people[2].account,4000,.wage))
    fuel = w.aircraft[1].fuel_ml; hull = w.aircraft[1].hull; engine = w.aircraft[1].engine
    id = request_tow(w,2,1,0)
    assert(id >= 0 and request_tow(w,2,1,0) == -1)
    loop i in 0..200:
        w.tick += 120; w.minute = w.tick/120
        advance_public_boats(w)
    assert(w.aircraft[1].id == 1 and w.aircraft[1].owner == 2 and w.aircraft[1].place == 0)
    assert(w.aircraft[1].fuel_ml == fuel and w.aircraft[1].hull == hull and w.aircraft[1].engine == engine)
    assert(w.aftermath[a].kind == .workshop_plane and money_balances(w) and goods_balance(w))

test "repair quotes choose engine then hull and only completed labor restores it":
    w = build_world()
    advance_minutes(w,15)
    w.obligations[w.obligation_keys["dario_service"]].state = .fulfilled
    w.aircraft[2].engine = 800; w.aircraft[2].hull = 600
    id = request_repair(w,8)
    assert(id >= 0 and w.obligations[id].repair_hull and start_repair(w,id))
    assert(w.aircraft[2].hull == 600)
    loop i in 0..60:
        w.minute += 1; w.tick = w.minute*120
        advance_repairs(w)
    assert(w.aircraft[2].engine == 800 and w.aircraft[2].hull == 800)
    assert(request_repair(w,8) == -1 and money_balances(w) and goods_balance(w))

test "closed harbors broken aircraft absent mechanic begin funded recovery by 48 hours":
    w = build_world(u64(42))
    w.aircraft[2].engine = 300
    w.people[4].place = 2
    w.weather.push(Weather(id=100,kind=.storm,center=vec2(0,0),radius_m=1000000,severity=1000,born_minute=0,expires_minute=180))
    advance_minutes(w,2880)
    recovery = w.people[8].last_recovery_action_minute >= 0 or w.aircraft[2].repair_obligation >= 0
    loop task in w.public_boats:
        if task.person == 8 and task.state != 3: recovery = true
    assert(recovery or w.people[8].injured_until > w.minute)
    assert(money_balances(w) and goods_balance(w))
