use 'living_commissions.jo'

test "reconnaissance requires observation and an actual return before a single funded payment":
    w=commission_fixture(); actor=w.player
    w.people[actor].pose.pos=far_counter(w,100)
    id=post_mission(w,1,.reconnaissance,100,100,200,2400)
    assert(id>=0 and claim_mission(w,id))
    money=w.accounts[w.people[actor].account].cents
    assert(not finish_mission(w,id))
    w.aircraft[0].state=.airborne; w.aircraft[0].pose.pos=w.place_contexts[200].center+vec3(0,150,0)
    before=canonical_text(w); views=mission_views(w,100); assert(views.len()==1 and canonical_text(w)==before)
    loop _ in 0..2:
        w.tick+=120; w.minute=w.tick/120; mission_progress(w,id)
    assert(w.war.missions[id].observed_controller==2 and w.war.missions[id].progress_ticks==240)
    # The old foot pose is still at the office; airborne observers cannot report remotely.
    assert(not finish_mission(w,id) and w.accounts[w.people[actor].account].cents==money)
    w.aircraft[0].state=.moored; w.aircraft[0].pose.pos=w.far.harbors[100].docks[0]
    assert(finish_mission(w,id) and not finish_mission(w,id))
    assert(w.accounts[w.people[actor].account].cents==money+2400 and w.war.missions[id].paid==2400)
    assert(money_balances(w) and goods_balance(w) and validate_war(w)=="")

test "a government dispatch is one saved physical packet backed by a real report":
    w=commission_fixture(); event=far_local_news(w,100,"orders","The frontier patrol requested its orders.",country=1,severity=400)
    report=[loop r in w.far.districts[100].reports: if r.id==event: r][0]
    before=stock_totals(w); roots=w.next_cargo_source
    id=post_mission(w,1,.mail,100,200,event,1800)
    assert(id>=0); parcel=w.war.missions[id].commission
    assert(parcel>=0 and w.far.commissions[parcel].paper!=none and w.far.commissions[parcel].cargo.roots.len()==0)
    w.people[0].pose.pos=far_counter(w,100)
    assert(claim_mission(w,id) and pickup_far_commission(w,parcel))
    w.aircraft[0].state=.moored; w.aircraft[0].pose.pos=w.far.harbors[100].docks[0]; w.people[0].pose.pos=w.aircraft[0].pose.pos
    assert(load_far_commission(w,parcel) and craft_grams(w,0)==200)
    assert(w.far.districts[200].reports.len()==0)
    text=canonical_text(w); restored=from_text[World](text); assert(restored is World and canonical_text(restored)==text)
    w.aircraft[0].pose.pos=w.far.harbors[200].docks[0]; w.people[0].pose.pos=w.aircraft[0].pose.pos
    assert(pickup_far_commission(w,parcel))
    w.people[0].pose.pos=far_counter(w,200)
    assert(collect_far_commission(w,parcel) and not collect_far_commission(w,parcel))
    mission_progress(w,id)
    assert(w.war.missions[id].state==.completed and w.war.missions[id].paid==1800)
    assert(w.far.commissions[parcel].paper==none and stock_totals(w)==before and w.next_cargo_source==roots)
    assert([loop r in w.far.districts[200].reports: if r.id==event: r].len()==1)
    assert(validate_war(w)=="" and validate_save_world(w)=="")

test "an unclaimed military offer returns its real escrow and cannot be claimed from stale foot coordinates":
    w=commission_fixture(); w.people[0].pose.pos=far_counter(w,100)
    treasury=w.far.treasury[1]; cash=w.accounts[treasury].cents
    id=post_mission(w,1,.reconnaissance,100,100,200,1000)
    assert(id>=0 and w.accounts[treasury].cents==cash-1000)
    w.aircraft[0].state=.airborne; w.aircraft[0].pose.pos=vec3(10000,400,10000)
    assert(not claim_mission(w,id))
    w.war.missions[id].deadline=1; w.minute=2; w.tick=240
    missions_minute(w)
    assert(w.war.missions[id].state==.expired and w.accounts[treasury].cents==cash)
    assert(money_balances(w) and validate_war(w)=="")

escort_fixture = (span: f32 = 3000.0) -> World:
    w=commission_fixture()
    w.far.links[1].points=[vec3(200,0,0),vec3(200+span,0,0)]
    w.far.links[1].length_mm=int(round(f64(span)*1000.0))
    w.place_contexts[300].center=vec3(200+span,0,0)
    w.far.districts[300].target[0]+=20000
    w.far.vehicles[1].buying_order=counter_restock_order(w,1,300)
    w.minute=1; w.tick=120; assert(far_depart(w,1))
    w.people[0].pose.pos=far_counter(w,200)
    w

test "escort terms refuse a voyage too short for the promised mile and a stale offer with too little distance left":
    w=escort_fixture(100); treasury=w.far.treasury[2]; before=w.accounts[treasury].cents
    assert(post_mission(w,2,.escort,200,200,1,2400)<0 and w.accounts[treasury].cents==before)
    w=escort_fixture()
    id=post_mission(w,2,.escort,200,200,1,2400); assert(id>=0)
    w.tick+=12000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(escort_distance_left(w,1)<1852000 and not claim_mission(w,id))
    assert(w.war.missions[id].state==.open)

test "escort evidence belongs to the agreed voyage rather than a carrier's later unrelated departure":
    w=escort_fixture()
    id=post_mission(w,2,.escort,200,200,1,2400); assert(id>=0 and claim_mission(w,id))
    old=w.war.missions[id].target_journey
    w.tick+=30000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[1].journey<0)
    w.tick+=3600; w.minute=w.tick/120; assert(far_depart(w,1))
    assert(w.far.vehicles[1].journey!=old)
    at=w.far.vehicles[1].pos
    w.aircraft[0].state=.airborne; w.aircraft[0].pose.pos=at+vec3(0,100,0)
    w.war.missions[id].last_target_pos=at; w.war.missions[id].last_actor_pos=w.aircraft[0].pose.pos
    w.war.missions[id].last_tick=w.tick
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    w.aircraft[0].pose.pos=w.far.vehicles[1].pos+vec3(0,100,0)
    mission_progress(w,id)
    assert(w.war.missions[id].progress_ticks==0 and money_balances(w) and goods_balance(w))
