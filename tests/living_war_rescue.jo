use '../src/living_types.jo'
use '../src/living_war_types.jo'
use '../src/living_war_contacts.jo'
use '../src/living_war_rescue.jo'
use '../src/living_war_checks.jo'
use '../src/living_far_types.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_checks.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use '../src/living_far_aircraft.jo'
use '../src/living_far_stock.jo'
use 'war_scene.jo'

test "rescue moves the same cohort into real aircraft seats then to shelter without a bounty spawn":
    w=naval_fixture(); w.minute+=45; w.tick=w.minute*120
    advance_war_contacts(w)
    id=w.war.survivors.keys()[0]; s=w.war.survivors[id]
    original=w.far.vehicles[s.vehicle].crew[s.country]
    count=w.people.len(); population=far_population(w); cash=w.ledger.opening_cents
    w.aircraft[0].pose.pos=s.at; w.aircraft[0].pose.vel=vec3(0,0,0); w.aircraft[0].state=.taxi
    assert(board_survivors(w,id)==1 and board_survivors(w,id)==0)
    assert(w.far.vehicles[s.vehicle].crew[s.country]==original-1 and far_population(w)==population)
    assert(w.people.len()==count and craft_grams(w,0)==75000)
    assert(land_survivors(w,id,100)==0)
    w.aircraft[0].pose.pos=w.far.harbors[100].docks[0]; w.aircraft[0].state=.moored
    before=w.far.districts[100].dependents[s.country]
    assert(land_survivors(w,id,100)==1 and land_survivors(w,id,100)==0)
    assert(w.far.districts[100].dependents[s.country]==before+1)
    assert(w.war.survivors[id].rescued_total==1 and far_population(w)==population)
    assert(w.ledger.opening_cents==cash and money_balances(w) and goods_balance(w))
    assert(validate_war(w)=="" and validate_far(w)=="")

test "a downed named pilot keeps their identity and wreck and is paid no imaginary rescue money":
    w=naval_fixture(); place=100; account=w.far.districts[place].household_account
    assert(far_produce(w,place,5,2000))
    registration=register_far_aircraft(w,place,.minnow,account,"test:pilot")
    assert(registration.craft>=0,registration.error)
    person=registration.person; craft=registration.craft
    at=vec3(140,0,-20000)
    wreck=at+vec3(0,0,100)
    w.aircraft[craft].pose.pos=wreck
    id=record_downed_airman(w,person,craft,at,1)
    assert(id>=0 and record_downed_airman(w,person,craft,at,1)==id)
    assert(w.aircraft[craft].rescue_event==id and w.people[person].pose.pos==at)
    w.aircraft[0].pose.pos=at; w.aircraft[0].state=.taxi
    assert(board_survivors(w,id)==1 and person in w.aircraft[0].passengers)
    w.aircraft[0].pose.pos=w.far.harbors[100].docks[0]; w.aircraft[0].state=.moored
    assert(land_survivors(w,id,100)==1)
    assert(w.people[person].far_place==100 and w.people[person].injured_until>w.minute)
    assert(w.aircraft[craft].state==.wrecked and w.aircraft[craft].pose.pos==wreck and wreck!=w.aircraft[0].pose.pos)
    assert(not (person in w.aircraft[0].passengers) and w.war.survivors[id].resolved)
    assert(validate_war(w)=="" and validate_far(w)=="" and far_population(w)==w.far.opening_population)
    text=canonical_text(w); restored=from_text[World](text)
    assert(restored is World and canonical_text(restored)==text)
