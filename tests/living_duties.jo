use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_duties.jo'

test "simple debt partial payments default once and no endless interest":
    w = build_world()
    id = w.obligation_keys["nikos_engine_bill"]
    w.minute = 870; w.tick = w.minute*120
    accrue_interest(w)
    assert(w.obligations[id].amount_cents == 7070)
    before = w.accounts[4].cents
    assert(pay_obligation(w,id,1000) == 1000)
    assert(w.obligations[id].interest_cents == 0 and w.obligations[id].principal_cents == 6070)
    assert(w.accounts[4].cents == before+1000)
    loop d in 2..31:
        w.minute = d*1440; w.tick = w.minute*120
        accrue_interest(w); check_deadlines(w)
    assert(w.obligations[id].state == .defaulted)
    assert(w.obligations[id].interest_accrued_total <= 3500)
    old = w.obligations[id].amount_cents; event = w.obligations[id].default_event
    accrue_interest(w); check_deadlines(w)
    assert(w.obligations[id].amount_cents == old and w.obligations[id].default_event == event)
    assert(money_balances(w))

test "named production equals actual minutes and wage is prorated":
    w = build_world(u64(42))
    # No markets yet: production accounting records only named minutes actually worked.
    fisher = 7
    factor = 600+draw1000000(w.seed,20,fisher,0)*800/1000000
    before = w.goods_ledger.created[0]
    yannis = w.accounts[5].cents
    advance_minutes(w,30)
    expected = 4000*factor*30/60000
    # Other fishers also work, so inspect Petros' personal completed labor.
    assert(w.people[fisher].routine_minutes[0] == 30)
    assert(w.goods_ledger.created[0] > before and w.people[fisher].labor_remainder == 4000*factor*30%60000)
    assert(w.accounts[5].cents-yannis == 150)
    assert(expected > 0 and money_balances(w) and goods_balance(w))
    old = w.people[fisher].routine_minutes[0]
    advance_minutes(w,60)
    assert(w.people[fisher].routine_minutes[0] == old)

test "repair reservation completes once and missing mechanic releases it":
    w = build_world()
    id = w.obligation_keys["dario_service"]
    # Dario's original cargo service completes before optional engine work.
    advance_minutes(w,15)
    assert(start_repair(w,id))
    assert(not start_repair(w,id))
    advance_minutes(w,30)
    assert(w.aircraft[2].engine == 800 and w.obligations[id].state == .fulfilled)
    assert(not start_repair(w,id))
    assert(money_balances(w) and goods_balance(w))
    w.obligations[id].state = .open
    assert(start_repair(w,id))
    w.people[4].place = 2
    advance_minutes(w,120)
    assert(w.aircraft[2].repair_obligation == -1 and w.obligations[id].reserved_parts == 0)
    assert(money_balances(w) and goods_balance(w))
