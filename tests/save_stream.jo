use '../src/save_stream.jo'

sample = (n: int, seed: int) -> u8[]:
    words=["harbour ","grain ","Kalyrassa ","42 ","FarDistrict(id=","), ","\"oil\": ","[1, 2, 3] ","\n"]
    out: u8[]
    x=seed
    loop out.len()<n:
        x=(x*1103515245+12345)%2147483648
        if x%7==0: out.push(u8(x%256))
        else: out.extend(bytes(words[x%words.len()]))
    out[0..n]

test "a deflate stream in any step size writes the library's exact bytes":
    loop n in [0,1,2,3,100,5000,70000,300000]:
        src=sample(n,n+3)
        whole=deflate(src)
        loop limit in [1,7,4096,1000000]:
            if n>70000 and limit<4096: continue
            s=deflate_begin(src)
            loop not deflate_step(s,limit): pass
            assert(deflate_output(s)==whole,"n={n} limit={limit}")
            assert(inflate(deflate_output(s))! == src)

test "the streamed text hash is the library's hash of that text":
    loop n in [0,1,10,1000,100000]:
        b=sample(n,7)
        text=str_from_bytes(b)
        h: u64 = TEXT_HASH_START
        cut=n/3
        h=text_hash_feed(h,b,0,cut); h=text_hash_feed(h,b,cut,n)
        assert(text_hash_finish(h)==hash(text))

struct Inner:
    name = ""
    xs: int[]

struct Outer:
    a = 1
    m: {int: Inner}
    tail = "end"
    list: Inner[]
    words: {str: int}

test "a template with parts writes exactly to_text, piece by piece":
    v=Outer()
    loop k in [5,-2,9]: v.m[k]=Inner("n{k}",[k,k+1])
    loop k in 0..4: v.list.push(Inner("l{k}",[k]))
    v.words["b\"q"]=2; v.words["a"]=1
    keys=v.m.keys()
    t=v; t.m={keys[0]: v.m[keys[0]]}; t.list=[v.list[0]]
    template=to_text(t)
    parts=[map_text_part(to_text(t.m),v.m,keys,(x: Inner) -> Inner: x),array_text_part(to_text(t.list),v.list,(x: Inner) -> Inner: x)]
    loop limit in [1,10,100000]:
        s=text_stream(template,parts)
        loop not text_step(s,limit): pass
        assert(s.error=="",s.error)
        assert(str_from_bytes(s.out)==to_text(v))
        assert(text_stream_hash(s)==hash(to_text(v)))

test "a marker that is not unique is refused, never guessed":
    v=Outer(); v.list=[Inner("x",[1]),Inner("x",[1])]
    template=to_text(v)
    s=text_stream(template,[array_text_part(to_text([Inner("x",[1])]),v.list,(x: Inner) -> Inner: x)])
    loop not text_step(s,100): pass
    assert(s.error!="" or str_from_bytes(s.out)==to_text(v))
