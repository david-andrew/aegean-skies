use '../src/deeds.jo'
import '../src/living_types.jo' as data

test "deeds are appended in order, witnesses kept once, and read back by serial and actor":
    log = DeedLog()
    a = deed_record(log,.rescued_foe,7,2,-1,[3,3,7,1,-1],minute=100,at=vec3(10,0,20))
    b = deed_record(log,.flew_home_in_formation,7,1,40,[1,2],minute=160)
    c = deed_record(log,.shot_down,5,2,-1,[7],minute=110)
    assert(a == 0 and b == 1 and c == 2)
    assert(log.entries[0].witnesses == [1,3])
    assert(deeds_since(log,1).len() == 2 and deeds_since(log,1)[0].kind == .flew_home_in_formation)
    assert(deeds_by(log,7).len() == 2 and deed_count(log,7,.rescued_foe) == 1 and deed_count(log,5,.shot_down) == 1)

test "a full log keeps recording, the oldest first to go, serials never reused":
    log = DeedLog()
    loop i in 0..DEEDS_MOST+5: _ = deed_record(log,.left_the_fight,i,1,-1,[])
    assert(log.entries.len() == DEEDS_MOST and log.entries[0].serial == 5 and log.next == DEEDS_MOST+5)

test "the log is saved with the world and read back the same":
    w = data.World(seed=u64(1))
    _ = deed_record(w.deeds,.rescued_friend,0,1,12,[4,5],minute=90,at=vec3(1,2,3))
    back = from_text[data.World](to_text(w)).unwrap()
    assert(back.deeds.entries.len() == 1 and back.deeds.entries[0].kind == .rescued_friend and back.deeds.entries[0].witnesses == [4,5] and back.deeds.next == 1)
