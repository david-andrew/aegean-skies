use '../src/living_types.jo'

test "clock units epoch and airframe constants":
    assert(local_minute(0) == 570 and day_index(0) == 0)
    assert(local_minute(-571) == 1439 and day_index(-571) == -1)
    assert(local_minute(870) == 0 and day_index(870) == 1)
    assert(physical_seconds(ticks_from_minutes(1)) == 2.0)
    assert(route_minutes(16000.0,60) == 134)
    assert(AIRFRAMES.len() == 16 and AIRFRAMES[0].tank_ml == 80000)

test "stable wrapping mixer fixtures":
    assert(mix64(u64(0)) == u64(0))
    assert(mix64(u64(1)) == u64(0x5692161d100b05e5))
    n = draw1000000(u64(42),10,2,-100,3)
    assert(n == draw1000000(u64(42),10,2,-100,3))
    assert(n >= 0 and n < 1000000)
    loop i in 0..100: assert(draw1000000(u64(i),20,7,0) < 1000000)

test "common pose quaternion faces the route in flight core coordinates":
    loop direction in [vec3(1,0,0),vec3(0,0,-1),vec3(-1,0.3,0.2),vec3(0,1,0)]:
        q = facing(direction)
        assert(abs(f64(length(q))-1.0) < 0.00001)
        assert(length(quat_rotate(q,vec3(0,0,-1))-normalize(direction)) < 0.00001)
