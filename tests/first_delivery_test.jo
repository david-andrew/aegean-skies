# The pilot's first flying job, as a new player meets it: the medicine for Agios Nikolaos. Its
# receiver goes down to the dock once it is aboard (wherever in the town they live) and waits there;
# the cargo stays aboard until the pilot hands it over; handed over, the receiver takes it from the
# aircraft, the job is delivered and the pilot paid through the ledger. And the town's cliff stair
# keeps the pilot on its treads (its parapet) and is climbed at a brisk pace.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/life_types.jo'
use '../src/living_life.jo'
use '../src/living_portage.jo'
use '../src/living_money.jo'
use '../src/world.jo'
use '../src/world_point.jo'
use '../src/objects.jo'
import '../src/living_world.jo' as living

# The medicine job from Porto Vecchio to Agios Nikolaos, taken by the pilot and loaded
_medicine = () -> (World, int):
    w = build_world(u64(0))
    job = -1
    loop id in w.active_jobs:
        j = w.jobs[id]
        if job < 0 and j.state == .open and j.origin == 0 and j.destination == 2 and j.delivery_mode == .aircraft and j.cargo_mode != .none: job = id
    assert(job >= 0, "no flying job for Agios Nikolaos")
    assert(living.take_job(w, job, w.player, .automatic))
    m = 0
    loop m < 180 and not w.jobs[job].loaded:
        living.advance_minutes(w, 1); m += 1
    assert(w.jobs[job].loaded, "not loaded after {m} minutes")
    (w, job)

# The pilot's aircraft moored at the destination's first dock (as a scene arrival commits it)
_arrive = (w: mut World, job: int):
    p = w.jobs[job].destination; c = w.people[w.player].craft
    w.aircraft[c].move_owner = .scene
    w.aircraft[c].place = p; w.aircraft[c].dock = 0; w.aircraft[c].trip = -1; w.aircraft[c].state = .moored
    w.aircraft[c].pose.pos = w.harbors[p].docks[0]
    w.places[w.people[w.player].place].residents.remove(w.player)
    w.people[w.player].place = p; w.places[p].residents.push(w.player)
    w.people[w.player].pose.pos = w.cargo_harbors[p].loading[0]

test "the medicine's receiver goes down to the dock and waits there for the aircraft":
    w, job = _medicine()
    r = cargo_receiver(w, job)
    assert(r >= 0 and w.people[r].home == 2 and w.people[r].place == 2, "receiver {r}")
    assert(cargo_awaited(w, r) == job)
    goal = life_daily_goal(w, r)
    assert(goal.venue == .quay and goal.activity == .wait and goal.reason.contains("medicine"), "{goal.venue} {goal.activity} {goal.reason}")
    # (an hour on, while the pilot flies over, she is on the dock by where it comes ashore)
    living.advance_minutes(w, 60)
    d = f64(length(w.people[r].pose.pos.xz - cargo_meeting_spot(w, job).xz))
    assert(d < 3.0, "the receiver is {d:.0} m from the dock's loading point")

test "the pilot's cargo stays aboard until it is handed over, then is delivered and paid":
    w, job = _medicine()
    r = cargo_receiver(w, job)
    living.advance_minutes(w, 60)
    _arrive(w, job)
    living.advance_minutes(w, 20)
    # (nobody unloads the pilot's own cargo on their own: no carriage, still aboard)
    loop id in w.active_carriage: assert(w.carriage[id].job != job, "unloaded without the pilot")
    assert(w.jobs[job].state == .claimed and not w.jobs[job].collected)
    assert(cargo_awaited(w, r) == job, "the receiver still waits")
    # handed over: the receiver takes it from the aircraft and signs for it
    before = w.accounts[w.people[w.player].account].cents
    assert(choose_collection(w, job, w.player, .sender))
    m = 0
    loop m < 30 and w.jobs[job].state != .delivered:
        living.advance_minutes(w, 1); m += 1
    assert(w.jobs[job].state == .delivered, "not delivered {m} minutes after the handover: {cargo_status(w, job)}")
    paid = w.accounts[w.people[w.player].account].cents - before
    assert(paid == w.jobs[job].reward_cents, "paid {paid} of {w.jobs[job].reward_cents}")
    assert(cargo_awaited(w, r) < 0)

test "nobody waits for a job not yet aboard, another's job, or one long overdue and not coming":
    w, job = _medicine()
    r = cargo_receiver(w, job)
    w.jobs[job].due_minute = w.minute - 1
    assert(cargo_awaited(w, r) < 0, "overdue and still at home: no waiting")
    w.jobs[job].due_minute = w.minute + 600
    w.jobs[job].carrier = r
    assert(cargo_awaited(w, r) < 0)

test "a cliff stair's parapet keeps the walker on its treads, and its ends stay open":
    assert(load_land(embed('../assets/terrain.bin')))
    geography_enabled = false
    towns = [build_town(SETTLEMENTS[2])]
    stair = towns[0].stairs[0]
    # (half way up a flight: on the treads)
    k = stair.len() / 2
    a = stair[k]; b = stair[k + 1]
    if f64(length(b.xz - a.xz)) < 0.5: b = stair[k + 2]
    along = normalize(b.xz - a.xz); side = vec2(-along.y, along.x)
    mid = (a.xz + b.xz) * 0.5
    y = walk_height(towns, f64(mid.x), f64(mid.y))
    p = world_point(vec3(mid.x, f32(y), mid.y))
    assert(on_any_stair(towns, world_vec(p)), "not on the stair at its middle")
    # (sideways both ways: one side the rock, the other the drop; neither leaves the treads)
    loop s in [-1.0, 1.0]:
        moved = walk_step_precise(towns, p, side * f32(s * 3.0))
        q = world_vec(moved)
        assert(on_any_stair(towns, q) or f64(q.y) >= y - 0.6, "stepped off the stair {s}: {q.y:.1} from {y:.1}")
    # (along it, up to the flight's next point and back down to its last, the walker goes on)
    up = walk_step_precise(towns, p, (b.xz - mid) * 0.95)
    assert(f64(length(world_vec(up).xz - b.xz)) < 0.3, "stopped {length(world_vec(up).xz - b.xz):.2} m short going up")
    down = walk_step_precise(towns, p, (a.xz - mid) * 0.95)
    assert(f64(length(world_vec(down).xz - a.xz)) < 0.3, "stopped {length(world_vec(down).xz - a.xz):.2} m short going down")
    # (the foot meets the quay: from the first tread onto the quay is open)
    foot = stair[0]
    fp = world_point(vec3(foot.x, f32(walk_height(towns, f64(foot.x), f64(foot.z))), foot.z))
    off = walk_step_precise(towns, fp, -normalize(stair[1].xz - stair[0].xz) * 2.0)
    assert(f64(length(world_vec(off).xz - world_vec(fp).xz)) > 1.0, "the stair's foot is closed")
