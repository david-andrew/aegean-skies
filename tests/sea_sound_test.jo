# The sea about the aircraft (tweaks.sea_sounds, src/sea_sound.jo): its sounds made in pieces,
# whole and quiet enough, and heard where they belong: the wash and the breeze moored in a wind,
# the planing only on a run, nothing of the sea high over land.
use '../src/sea_sound.jo'
use '../src/flight_feedback.jo'
use '../src/engine_sound.jo'

test "the sea's sounds are made a piece at a time, and loop whole":
    s = SeaSound()
    pieces = 0
    loop not s.ready:
        sea_sound_build_step(s); pieces += 1
    assert(pieces > 8)
    loop snd in [s.wash,s.breeze,s.planing]+s.laps+s.slaps:
        assert(snd.samples.len() > 0)
        peak = 0.0
        loop v in snd.samples: peak = max(peak,abs(f64(v)))
        assert(peak > 0.01 and peak < 0.9)
    assert(s.wash.samples.len() == ENGINE_RATE*SEA_WASH_SECONDS*2)

test "moored in a breeze the sea is heard; high over land it is not":
    s = SeaSound()
    sea_sound_make(s)
    moored = FlightFeedback(ready = true,afloat = 1.0,moored = true,over_sea = true,sea_wind = 9.0)
    sea_sound_update(s,1.0/60.0,moored,9.0,true)
    assert(not s.quiet[0] and not s.quiet[1] and s.quiet[2],"the wash and the breeze, no planing")
    high = FlightFeedback(ready = true,afloat = 0.0,over_sea = false,height = 600.0,sea_wind = 9.0)
    sea_sound_update(s,1.0/60.0,high,60.0,true)
    assert(s.quiet[0] and s.quiet[1] and s.quiet[2],"high over land: nothing of the sea")
    sea_sound_hush(s)
