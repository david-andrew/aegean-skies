far_fixture = (consumer_population: int = 80, producer_population: int = 80) -> World:
    w = build_world(u64(42))
    contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    loop pair in [(100,1),(200,2),(300,1)]: contexts.push(LifePlaceContext(pair.0,"Port {pair.0}",pair.1,pair.0,vec3(f32(pair.0),0,0)))
    assert(publish_place_contexts(w,1,contexts,[-1,100,200]))
    seeds = [FarPlaceSeed(100,producer_population,1,3),FarPlaceSeed(200,consumer_population,2,0),FarPlaceSeed(300,40,1,5,raw_ore=100000)]
    links = [FarLink(0,100,200,.cart,[vec3(100,0,0),vec3(150,0,0),vec3(200,0,0)],100000),FarLink(1,200,300,.ship,[vec3(200,0,0),vec3(300,0,0)],100000)]
    assert(populate_settlement_economy(w,1,seeds,links))
    w

far_only_minutes = (w: mut World, minutes: int):
    loop _ in 0..minutes:
        step_minute(w)

test "game save boundaries still fully reject a nonfinite published route":
    set_living_strict(false)
    w=far_fixture()
    w.far.links[0].points[1].x=f32(sqrt(-1.0))
    assert(validate_far(w)=="invalid far route point")
    assert(validate_save_world(w)=="invalid far route point")
    refused=save_game(w,PresentationState(),42,"phase4-rejected-route")
    assert(refused is LivingSaveError)
    set_living_strict(true)

test "funded settlement opening population crew and stocks are owned and idempotent":
    w = far_fixture()
    assert(w.far.populated and w.far.place_ids==[100,200,300])
    assert(far_population(w)==w.far.opening_population and validate_far(w)=="")
    assert(invariant_errors(w).len()==0)
    before = canonical_text(w)
    assert(populate_settlement_economy(w,1,[],[]))
    assert(canonical_text(w)==before)

test "households pay from real purses and production requires funds inputs and finite raw material":
    w = far_fixture(); external = w.ledger.external_in_cents
    cash = w.accounts[w.far.districts[100].household_account].cents
    loop _ in 0..61:
        w.minute += 1; w.tick += 120
        far_economy_minute(w); far_transport_minute(w)
    assert(w.far.produced[3]>0 and w.far.consumed[3]>0 and w.ledger.external_in_cents==external)
    assert(w.accounts[w.far.districts[100].household_account].cents!=cash)
    w.far.districts[300].raw_ore=0
    produced = w.far.produced[5]
    loop _ in 0..61:
        w.minute += 1; w.tick += 120
        far_economy_minute(w); far_transport_minute(w)
    assert(w.far.produced[5]==produced)
    assert(validate_far(w)=="" and far_stock_errors(w).len()==0 and money_balances(w) and goods_balance(w))

test "a cargo service pays before departure carries original roots and commits the real destination":
    w = far_fixture()
    assert(far_produce(w,100,3,10000))
    # Make the actual destination need grain, without deleting any of its stock.
    w.far.districts[200].target[3] += 20000
    # The fixture hands over the receiving counter's signed order, not live remote stock.
    w.far.vehicles[0].buying_order=counter_restock_order(w,0,200)
    roots = w.next_cargo_source; external = w.ledger.external_in_cents
    before = stock_totals(w)
    assert(far_depart(w,0)); j = w.far.journeys[w.far.vehicles[0].journey]
    assert(j.origin==100 and j.destination==200 and j.quantity>0 and w.far.vehicles[0].cargo_owner==j.buyer)
    assert(j.provenance.negotiated and j.provenance.requester_account==j.buyer and j.provenance.supply_roots.len()>0)
    assert(w.far.vehicles[0].place== -1 and w.far.vehicles[0].cargo.qty[3]==j.quantity)
    assert(stock_totals(w)==before and w.next_cargo_source==roots and w.ledger.external_in_cents==external)
    w.tick += 6000; w.minute = w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==200 and w.far.vehicles[0].journey== -1 and w.far.completed_journeys==1)
    assert(stock_totals(w)==before and invariant_errors(w).len()==0)
    assert(w.far.cargo_deliveries==1 and w.far.order_rounds==0)

test "week of staggered cohorts and journeys conserves cash goods provenance population and replay":
    a = far_fixture(); far_only_minutes(a,1440*3+17)
    text = canonical_text(a); restored = from_text[World](text); assert(restored is World)
    b = restored
    far_only_minutes(a,1440*4); far_only_minutes(b,1440*4)
    assert(canonical_text(a)==canonical_text(b))
    assert(a.far.produced[3]>0 and a.far.consumed[3]>0)
    assert(far_population(a)==a.far.opening_population)
    errors = invariant_errors(a); assert(errors.len()==0,errors.join("; "))
    assert(validate_save_world(a)=="")

test "malformed far journey references are rejected before indexed helpers run":
    w = far_fixture(); assert(far_produce(w,100,3,10000))
    w.far.districts[200].target[3] += 20000
    assert(far_depart(w,0)); id = w.far.vehicles[0].journey
    w.far.journeys[id].link=99999
    assert(validate_save_world(w)=="invalid far journey")

test "a broken far journey refuses a game minute without a panic or partial economic writes":
    w = far_fixture(); assert(far_produce(w,100,3,10000))
    w.far.districts[200].target[3] += 20000
    assert(far_depart(w,0)); id = w.far.vehicles[0].journey
    w.far.journeys[id].link=99999
    before = w; before.tick += 120; before.minute += 1
    set_living_strict(false)
    defer set_living_strict(true)
    step_minute(w)
    assert(canonical_text(w)==canonical_text(before))
    # Repair the reference from its real assigned service; the next minute can proceed.
    w.far.journeys[id].link=w.far.vehicles[0].route
    step_minute(w)
    assert(validate_save_world(w)=="")

test "a household with its real staple ration does not starve solely for lack of fish":
    w=far_fixture(); qty=far_market_qty(w,100,0)
    if qty>0:
        batch=far_take_market(w,100,0,qty); far_use(w,batch)
    w.far.districts[100].hunger=10
    far_household_hour(w,100)
    assert(w.far.districts[100].unmet[0]>0 and w.far.districts[100].hunger==9)
    assert(goods_balance(w) and money_balances(w) and far_stock_errors(w).len()==0)


test "hourly work is spread across minute batches with every real district worked once":
    w=build_world(u64(42)); contexts: LifePlaceContext[]; seeds: FarPlaceSeed[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    loop k in 0..130:
        id=100+k
        contexts.push(LifePlaceContext(id,"District {id}",1,id,vec3(f32(k*100),0,0)))
        seeds.push(FarPlaceSeed(id,80,1,3))
    assert(publish_place_contexts(w,1,contexts,[-1,-1,-1]))
    assert(populate_settlement_economy(w,1,seeds,[]))
    visited=0
    loop minute in 60..120:
        w.minute=minute; w.tick=minute*120
        before=[loop _, d in w.far.districts: if d.last_hour==1: d.id].len()
        far_economy_minute(w)
        after=[loop _, d in w.far.districts: if d.last_hour==1: d.id].len()
        assert(after-before<=3,"One minute must not absorb the rest of the hour's work.")
        visited+=after-before
    assert(visited==130 and money_balances(w) and goods_balance(w))

test "a starving home crew can carry its funded food inquiry despite an empty dated quote":
    w=far_fixture()
    # The existing food was eaten, not erased. No rations appear for this voyage.
    loop place in [100,200]:
        batch=far_take_market(w,place,3,far_market_qty(w,place,3)); far_use(w,batch)
    far_crew_meals(w); w.minute+=1440; w.tick=w.minute*120; far_crew_meals(w)
    assert(w.far.vehicles[0].hungry_days>=2 and w.far.vehicles[0].provisions.qty[3]==0)
    w.far.vehicles[0].buying_order=counter_restock_order(w,0,200)
    quote=w.far.vehicles[0].buying_order!
    assert(quote.observed[3]==0 and quote.quantity[3]>0)
    before=stock_totals(w); roots=w.next_cargo_source; cash=w.ledger.external_in_cents
    assert(far_depart(w,0))
    journey=w.far.journeys[w.far.vehicles[0].journey]
    assert(journey.provenance.negotiated and journey.return_order!.quantity[3]>0)
    assert("funded food inquiry" in journey.provenance.cause)
    assert(w.far.vehicles[0].provisions.qty[3]==0 and stock_totals(w)==before and roots==w.next_cargo_source and cash==w.ledger.external_in_cents)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==200 and far_market_qty(w,200,3)==0)
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="")

test "food inquiries still require the actual reciprocal agreement a current quote and real funding":
    original=far_fixture()
    loop place in [100,200]:
        batch=far_take_market(original,place,3,far_market_qty(original,place,3)); far_use(original,batch)
    far_crew_meals(original); original.minute+=1440; original.tick=original.minute*120; far_crew_meals(original)
    original.far.vehicles[0].buying_order=counter_restock_order(original,0,200)
    loop refusal in 0..3:
        w=original
        if refusal==0: w.far.vehicles[0].service_agreement=false
        if refusal==1: w.minute+=43201; w.tick=w.minute*120
        if refusal==2:
            payer=w.far.districts[100].market_account; receiver=w.far.districts[200].market_account
            assert(transfer(w,payer,receiver,w.accounts[payer].cents,.trade))
        assert(not far_depart(w,0) and w.far.vehicles[0].journey<0)
        assert(stock_totals(w)==stock_totals(original) and money_balances(w) and goods_balance(w))

test "a hungry home's funded inquiry is for its own meals even when the peer requested no grain":
    w=far_fixture()
    loop place in [100,200]:
        batch=far_take_market(w,place,3,far_market_qty(w,place,3)); far_use(w,batch)
    far_crew_meals(w); w.minute+=1440; w.tick=w.minute*120; far_crew_meals(w)
    order=counter_restock_order(w,0,200)
    # The peer's outstanding paper explicitly requested no grain. Its present
    # shortage remains unknown; the hungry HOME counter pays to ask anew.
    order.quantity[3]=0; order.local_quantity[3]=0
    order.extra_lines=[loop line in order.extra_lines: if line.good!=3: line]
    w.far.vehicles[0].buying_order=order
    assert(order.observed[3]==0 and restock_order_valid(w,order))
    before=stock_totals(w); cash=w.ledger.external_in_cents
    assert(far_depart(w,0))
    j=w.far.journeys[w.far.vehicles[0].journey]
    assert(j.return_order!.quantity[3]>0 and "funded food inquiry" in j.provenance.cause)
    assert(w.far.vehicles[0].provisions.qty[3]==0 and w.far.vehicles[0].hungry_days>=2)
    assert(stock_totals(w)==before and w.ledger.external_in_cents==cash and money_balances(w) and goods_balance(w))

test "game validation scheduling preserves a healthy strict world's exact decisions and saves":
    strict=far_fixture(); game=strict
    set_living_strict(true)
    loop _ in 0..1440: step_minute(strict)
    set_living_strict(false)
    loop _ in 0..1440: step_minute(game)
    assert(living_faults().len()==0 and canonical_text(game)==canonical_text(strict))
    assert(validate_save_world(game)=="")
    set_living_strict(true)


test "a far counter cannot sell detailed workshop parts already reserved by an actual paid repair":
    w=build_world(); advance_minutes(w,15)
    id=w.obligation_keys["dario_service"]; assert(start_repair(w,id))
    place=w.aircraft[2].place; assert(w.obligations[id].reserved_parts>0)
    contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    assert(publish_place_contexts(w,1,contexts,[-1,-1,-1]))
    assert(populate_settlement_economy(w,1,[FarPlaceSeed(place,80,0,5,raw_ore=1000000)],[]))
    free=available(w.places[place].market.inventory,5)
    assert(far_market_qty(w,place,5)==free,"Far market offered the mechanic's reserved parts")
    batch=far_take_market(w,place,5,free); far_use(w,batch)
    assert(inventory_valid(w.places[place].market.inventory))
    assert(w.places[place].market.inventory.qty[5]==w.obligations[id].reserved_parts)
    loop _ in 0..30:
        w.minute+=1; w.tick=w.minute*120; advance_repairs(w)
    assert(w.obligations[id].state==.fulfilled and w.aircraft[2].engine==800)
    assert(invariant_errors(w).len()==0,invariant_errors(w).join("; "))
