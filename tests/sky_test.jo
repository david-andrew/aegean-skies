test "Sun wraps continuously and Moon phase follows its solar elongation":
    loop hour in 0..25:
        sun = sky_sun(f64(hour)); moon = sky_moon(f64(hour), 0.0)
        assert(abs(length(sun) - 1.0) < 0.00001)
        assert(abs(length(moon) - 1.0) < 0.00001)
        assert(length(sun - sky_sun(f64(hour) + 24.0)) < 0.00001)
        assert(length(moon - sky_moon(f64(hour), LUNAR_MONTH)) < 0.00001)
    new_day = -LUNAR_EPOCH_AGE
    assert(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day)) < 0.003)
    assert(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day + LUNAR_MONTH / 2.0)) > 0.997)
    assert(abs(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day + LUNAR_MONTH / 4.0)) - 0.5) < 0.003)
    assert(sky_moon(0.0, new_day + LUNAR_MONTH / 2.0).y > 0.9)
    assert(sky_moon(12.0, new_day + LUNAR_MONTH / 2.0).y < -0.9)

test "Cloud cells are deterministic disjoint and independent of quality or global RNG":
    seed_random(42); expected = random()
    count = 0
    loop tier in 0..3:
        render_quality = quality_profile(tier)
        seed_random(42)
        loop z in -8..9:
            loop x in -8..9:
                a = cloud_cell(x, z); b = cloud_cell(x, z)
                assert(a == b)
                if a == none: continue
                v = a!; count += 1
                # The full rotated horizontal box fits inside its own cell.
                radius = length(v.extent.xz)
                assert(abs(v.center.x - f32((f64(x) + 0.5) * CLOUD_CELL)) + radius < f32(CLOUD_CELL * 0.5))
                assert(abs(v.center.z - f32((f64(z) + 0.5) * CLOUD_CELL)) + radius < f32(CLOUD_CELL * 0.5))
                assert(v.center.y - v.extent.y * f32(CLOUD_BASE+0.01) > 500.0)
                assert(v.shape >= 0.0 and v.shape < f32(CLOUD_STAMPS))
        assert(random() == expected)
    assert(count > 100)
    render_quality = RenderQuality()

test "Paint atlas fits mobile limits and never bleeds across tile edges":
    img = paint_image()
    assert(img.width <= 2048 and img.height <= 2048)
    assert(img.width*img.height*4 <= 7*1024*1024)
    loop tile in 0..PAINT_KINDS*PAINT_LAYERS:
        ox = tile%PAINT_COLS*PAINT_SIZE; oy = tile/PAINT_COLS*PAINT_SIZE
        filled = 0; lit = 0; shaded = 0; translucent = 0
        loop y in 0..PAINT_SIZE:
            loop x in 0..PAINT_SIZE:
                pixel = img.get(ox+x,oy+y)
                if x < 2 or y < 2 or x >= PAINT_SIZE-2 or y >= PAINT_SIZE-2: assert(pixel.w == 0.0)
                if tile % 3 > 0 and f32(y)/f32(PAINT_SIZE-1)*2.0-1.0 > 0.27: assert(pixel.w == 0.0)
                if pixel.w > 0.01:
                    translucent += 1
                    assert(abs(f32(x)/255.0*2.0-1.0) < 0.93)
                    assert(f32(y)/255.0*2.0-1.0 >= -0.56)
                    assert(f32(y)/255.0*2.0-1.0 <= paint_top(tile/3))
                if pixel.w > 0.9:
                    filled += 1
                    if pixel.x > 0.7: lit += 1
                    if pixel.x < 0.65: shaded += 1
        if tile % 3 == 0: assert(filled > 1000 and lit > 100 and shaded > 100)
        else: assert(translucent > 100)

test "Paint planes put a near ribbon ahead and a far ribbon behind all layers":
    cam = vec3(0,900,90); center = vec3(0,900,0); extent = vec3(50,50,50)
    ray = vec3(0,0,-1)
    previous: f32 = 1000.0
    loop layer in 0..3:
        hit = paint_intersection(ray,cam,center,extent,vec2(1,0),vec4(0,0,0,0),f32(layer))
        assert(hit.z > 30.0 and hit.z < 150.0)
        assert(hit.z < previous)
        assert(length(hit.xy) < 0.1)
        previous = hit.z

test "Height integrated haze stays clear at altitude and agrees at equal heights":
    c = vec3(0, 0, 0); haze = vec3(1, 1, 1)
    a = aerial(c, vec3(10000, 0, 0), vec3(0, 0, 0), haze, 0.00011)
    b = aerial(c, vec3(10000, 5000, 0), vec3(0, 5000, 0), haze, 0.00011)
    up = aerial(c, vec3(10000, 5000, 0), vec3(0, 0, 0), haze, 0.00011)
    down = aerial(c, vec3(0, 0, 0), vec3(10000, 5000, 0), haze, 0.00011)
    assert(abs(a.x - f32(1.0 - exp(-1.1))) < 0.00001)
    assert(b.x < 0.01 and up.x > b.x and up.x < a.x)
    assert(length(up - down) < 0.00001)

test "World cloud identities survive cache movement and wind advection":
    cam = vec3(0, 1000, 0)
    a = world_clouds(cam, vec2(0, 0))
    b = world_clouds(vec3(f32(CLOUD_CELL + 1.0), 1000, 0), vec2(0, 0))
    c = world_clouds(cam, vec2(30, -20))
    checked = 0
    loop v in a:
        if length(v.center.xz) > 15000.0: continue
        assert(any(b, (w: CloudVolume) -> bool: w == v))
        moved = v; moved.center += vec3(30, 0, -20)
        # Heating follows the actual land under an advected formation. It is
        # environmental input, not part of the persistent shape/cell identity.
        assert(any(c, (w: CloudVolume) -> bool:
            identity = w; identity.thermal = moved.thermal
            identity == moved))
        checked += 1
    assert(checked > 3)

test "Paint bounds contain all sheets from oblique rolled and overhead views":
    loop cam in [vec3(0,1200,0),vec3(2000,8000,-9900),vec3(-1000,1000,8000)]:
        loop center in [vec3(2000,1800,-10000),vec3(90000,2800,-110000)]:
            v = CloudVolume(center,vec3(2300,2200,1700),0,growth=vec4(0.1,1.2,0.018,0.035))
            target = render_world(center,cam)
            vp = perspective(62.0*PI/180.0,1280.0/720.0,1.0,300000.0)*look_at(cam,target,normalize(vec3(0.4,1,0)))
            bounds = volume_bounds(v,cam,vp)
            facing = paint_facing(center,cam); right = paint_right(facing); up = cross(right,facing)
            loop layer in 0..3:
                loop corner in 0..4:
                    p = target+facing*((1.0-f32(layer))*v.extent.z*0.08)+right*(if corner & 1 == 0: -0.91 else: 0.91)*v.extent.x+up*(if corner & 2 == 0: -0.54 else: paint_top(4)-0.02)*v.extent.y
                    clip = vp*vec4(p,1)
                    q = clamp(clip.xy/clip.w,vec2(-1,-1),vec2(1,1))
                    assert(q.x >= bounds.x-0.0001 and q.x <= bounds.z+0.0001)
                    assert(q.y >= bounds.y-0.0001 and q.y <= bounds.w+0.0001)


test "Nearest guide bound cannot accept an unresolved depth discontinuity":
    loop center in [1.0,20.0,100.0,1000.0,10000.0,1000000.0]:
        loop ratio in [0.0,0.01,0.1,0.5,0.9,1.0,1.1,2.0,10.0,1000.0]:
            near = center*ratio
            if not volume_nearest_resolves(f32(center),f32(near)): continue
            delta = abs(near-center)/max(8.0,center*0.025)
            # The closest of four taps always has a bilinear weight >=1/4.
            minimum = 0.25/(1.0+delta*delta*delta*delta)
            assert(minimum >= 0.0001)
    assert(not volume_nearest_resolves(100.0,1000.0))
    assert(not volume_nearest_resolves(1000.0,100.0))
