test "Sun wraps continuously and Moon phase follows its solar elongation":
    loop hour in 0..25:
        sun = sky_sun(f64(hour)); moon = sky_moon(f64(hour), 0.0)
        assert(abs(length(sun) - 1.0) < 0.00001)
        assert(abs(length(moon) - 1.0) < 0.00001)
        assert(length(sun - sky_sun(f64(hour) + 24.0)) < 0.00001)
        assert(length(moon - sky_moon(f64(hour), LUNAR_MONTH)) < 0.00001)
    new_day = -LUNAR_EPOCH_AGE
    assert(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day)) < 0.003)
    assert(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day + LUNAR_MONTH / 2.0)) > 0.997)
    assert(abs(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day + LUNAR_MONTH / 4.0)) - 0.5) < 0.003)
    assert(sky_moon(0.0, new_day + LUNAR_MONTH / 2.0).y > 0.9)
    assert(sky_moon(12.0, new_day + LUNAR_MONTH / 2.0).y < -0.9)

test "Cloud cells are deterministic and independent of quality or global RNG":
    seed_random(42); expected = random()
    count = 0
    loop tier in 0..3:
        render_quality = quality_profile(tier)
        seed_random(42)
        loop z in -8..9:
            loop x in -8..9:
                a = cloud_cell(x, z); b = cloud_cell(x, z)
                assert(a == b)
                if a == none: continue
                v = a!; count += 1
                assert(v.center.y - v.extent.y * f32(CLOUD_BASE+0.01) > 500.0)
                assert(v.shape >= 0.0 and v.shape < f32(CLOUD_STAMPS))
        assert(random() == expected)
    assert(count > 100)
    render_quality = RenderQuality()

# Encoded value of stamp s at voxel (x, y, z), read back from the baked atlas.
cloud_atlas_voxel = (img: Image, s: int, x: int, y: int, z: int) -> f32:
    slab = cloud_stamp_slab(s); n = cloud_group_dims(s/4); cols = int(slab.z)
    sx = int(slab.x)+(z%cols)*(int(n.x)+2); sy = int(slab.y)+(z/cols)*(int(n.y)+2)
    img.get(sx+x+1,sy+y+1)[s%4]

cloud_largest_component = (img: Image, s: int) -> f64:
    n = cloud_group_dims(s/4); nx = int(n.x); ny = int(n.y); nz = int(n.z)
    filled = fill(false,nx*ny*nz); seen = fill(false,nx*ny*nz)
    total = 0
    loop z in 0..nz:
        loop y in 0..ny:
            loop x in 0..nx:
                if cloud_atlas_voxel(img,s,x,y,z) > 0.515:
                    filled[(z*ny+y)*nx+x] = true; total += 1
    largest = 0
    queue: int[]
    loop seed in 0..filled.len():
        if not filled[seed] or seen[seed]: continue
        queue.clear(); queue.push(seed); seen[seed] = true
        head = 0
        loop head < queue.len():
            at = queue[head]; head += 1
            x = at % nx; y = (at / nx) % ny; z = at / (nx * ny)
            loop k in 0..6:
                if (k == 0 and x == 0) or (k == 1 and x == nx - 1) or (k == 2 and y == 0) or (k == 3 and y == ny - 1) or (k == 4 and z == 0) or (k == 5 and z == nz - 1): continue
                next = at + (if k == 0: -1 else if k == 1: 1 else if k == 2: -nx else if k == 3: nx else if k == 4: -nx * ny else: nx * ny)
                if filled[next] and not seen[next]: seen[next] = true; queue.push(next)
        largest = max(largest, queue.len())
    f64(largest) / f64(max(total, 1))

test "Atlas gutters agree, forms fit their boxes and sit on one condensation level":
    img = cloud_density_image()
    assert(img.width <= 2048 and img.height <= 2048)
    assert(img.width == CLOUD_ATLAS_W and img.height == CLOUD_ATLAS_H)
    # (the startup check knows a fresh atlas, and one with a form changed; an atlas left
    # from older forms drew every cloud as its box)
    assert(cloud_atlas_current(img))
    old = img
    loop y in 0..CLOUD_ATLAS_H:
        loop x in 0..CLOUD_ATLAS_W/2: set(old,x,y,vec4(0.5,0.5,0.5,0.5))
    assert(not cloud_atlas_current(old))
    loop s in 0..CLOUD_STAMPS:
        n = cloud_group_dims(s/4); nx = int(n.x); ny = int(n.y); nz = int(n.z)
        a = cloud_stamp_aspect(s)
        kind = cloud_stamp_kind(s)
        f = cloud_make_form(s)
        # Every voxel is a cube in metres: a form is never stretched by its grid.
        assert(abs((n.y-1.0)/(n.x-1.0)-a.y) < 0.0001 and abs((n.z-1.0)/(n.x-1.0)-a.z) < 0.0001)
        if kind == CLOUD_HUMILIS or kind == CLOUD_MEDIOCRIS or kind == CLOUD_CONGESTUS or kind == CLOUD_MASS or kind == CLOUD_ANVIL:
            # The baked flat cut agrees with the base used by placement.
            filled = false
            loop l in f.lobes:
                if abs(f64(l.center.x)) < 0.2 and abs(f64(l.center.z)) < 0.2: filled = true
            if filled:
                yb = f32(-CLOUD_BASE)*a.y
                assert(cloud_form_distance(f,vec3(0,yb+0.04,0)) < -0.01)
                assert(cloud_form_distance(f,vec3(0,yb-0.04,0)) > 0.01)
            assert(cloud_largest_component(img,s) > 0.99)
        slab = cloud_stamp_slab(s); cols = int(slab.z)
        loop z in 0..nz:
            sx = int(slab.x)+(z%cols)*(nx+2); sy = int(slab.y)+(z/cols)*(ny+2)
            loop k in 0..ny:
                assert(img.get(sx,sy+k+1) == img.get(sx+1,sy+k+1))
                assert(img.get(sx+nx+1,sy+k+1) == img.get(sx+nx,sy+k+1))
            loop k in 0..nx:
                assert(img.get(sx+k+1,sy) == img.get(sx+k+1,sy+1))
                assert(img.get(sx+k+1,sy+ny+1) == img.get(sx+k+1,sy+ny))
            loop y in 0..ny:
                loop x in 0..nx:
                    v = cloud_atlas_voxel(img,s,x,y,z)
                    if v > 0.5:
                        q = cloud_voxel_point(s/4,x,y,z)/a
                        margin: f32 = 2.0/(n.x-1.0)
                        loop axis in 0..3:
                            assert(q[axis]-margin >= CLOUD_MIN[axis] and q[axis]+margin <= CLOUD_MAX[axis])
                    if x == 0 or y == 0 or z == 0 or x == nx-1 or y == ny-1 or z == nz-1: assert(v < 0.5)

test "Form layouts derived in shaders from the index agree with the CPU tables":
    loop s in 0..CLOUD_STAMPS:
        loop mirror in [1.0,-1.0]:
            packed = f32(s+1)*f32(mirror)
            assert(cloud_stamp_slab_of(packed) == cloud_stamp_slab(s))
            assert(cloud_stamp_voxels_of(packed) == cloud_stamp_voxels(s,f32(mirror)))

test "Shadow footprints hold each form's densest value in its height slab":
    img = cloud_density_image()
    loop s in [0,3,9,17,24]:
        n = cloud_group_dims(s/4); nx = int(n.x); ny = int(n.y); nz = int(n.z)
        o = cloud_footprint_origin(s)
        assert(int(o.x)+nx+2 <= CLOUD_ATLAS_W and int(o.y)+nz+2 <= CLOUD_ATLAS_H)
        loop z in 0..nz:
            loop x in 0..nx:
                expected = vec4(0,0,0,0)
                loop y in 0..ny:
                    j = min(3,y*4/ny)
                    expected[j] = max(expected[j],cloud_atlas_voxel(img,s,x,y,z))
                assert(length(img.get(int(o.x)+x+1,int(o.y)+z+1)-expected) < 0.003)

test "Height integrated haze stays clear at altitude and agrees at equal heights":
    c = vec3(0, 0, 0); haze = vec3(1, 1, 1)
    a = aerial(c, vec3(10000, 0, 0), vec3(0, 0, 0), haze, 0.00011)
    b = aerial(c, vec3(10000, 5000, 0), vec3(0, 5000, 0), haze, 0.00011)
    up = aerial(c, vec3(10000, 5000, 0), vec3(0, 0, 0), haze, 0.00011)
    down = aerial(c, vec3(0, 0, 0), vec3(10000, 5000, 0), haze, 0.00011)
    assert(abs(a.x - f32(1.0 - exp(-0.00011*9940.0))) < 0.00001)
    assert(b.x > 0.1 and b.x < 0.15 and up.x > b.x and up.x < a.x)
    assert(length(up - down) < 0.00001)

test "World cloud identities survive cache movement and wind advection":
    cam = vec3(0, 1000, 0)
    a = world_clouds(cam, vec2(0, 0))
    b = world_clouds(vec3(f32(CLOUD_CELL + 1.0), 1000, 0), vec2(0, 0))
    c = world_clouds(cam, vec2(30, -20))
    checked = 0
    loop v in a:
        # (cloud bodies only: weather layers are not cells)
        if length(v.center.xz) > 4500.0 or (v.shape >= 4.0 and v.shape != 5.0): continue
        # (the same cloud; only its range fade differs from the other camera)
        assert(any(b, (w: CloudVolume) -> bool:
            same = w; same.weather = v.weather
            same == v))
        moved = v; moved.center += vec3(30, 0, -20)
        moved.precise=world_offset(cloud_point(v),vec3(30,0,-20))
        # Heating follows the actual land under an advected formation. It is
        # environmental input, not part of the persistent shape/cell identity.
        assert(any(c, (w: CloudVolume) -> bool:
            identity = w; identity.thermal = moved.thermal
            identity == moved))
        checked += 1
    assert(checked > 3)

test "Cloud shape bounds are world oriented from every camera side":
    v = CloudVolume(vec3(0,1500,0),cloud_extent(16,1700.0),2,heading=0.7,stamp=16)
    a = cloud_stamp_aspect(16)
    loop cam in [vec3(0,1500,5000),vec3(5000,1500,0),vec3(0,1500,-5000),vec3(-5000,1500,0),vec3(0,7000,0)]:
        up = if cam.y > 6000.0: vec3(0,0,1) else: vec3(0,1,0)
        vp = perspective(62.0*PI/180.0,1280.0/720.0,1.0,300000.0)*look_at(cam,render_world(v.center,cam),up)
        bounds = volume_bounds(v,cam,vp)
        loop l in cloud_lobes(16):
            point = v.center+cloud_to_world(l.center/a*v.extent,vec2(cos(v.heading),sin(v.heading)))
            clip = vp*vec4(render_world(point,cam),1)
            q = clamp(clip.xy/clip.w,vec2(-1,-1),vec2(1,1))
            assert(q.x >= bounds.x-0.001 and q.x <= bounds.z+0.001)
            assert(q.y >= bounds.y-0.001 and q.y <= bounds.w+0.001)

test "Nearest guide bound cannot accept an unresolved depth discontinuity":
    loop center in [1.0,20.0,100.0,1000.0,10000.0,1000000.0]:
        loop ratio in [0.0,0.01,0.1,0.5,0.9,1.0,1.1,2.0,10.0,1000.0]:
            near = center*ratio
            if not volume_nearest_resolves(f32(center),f32(near)): continue
            delta = abs(near-center)/max(8.0,center*0.025)
            # The closest of four taps always has a bilinear weight >=1/4.
            minimum = 0.25/(1.0+delta*delta*delta*delta)
            assert(minimum >= 0.0001)
    assert(not volume_nearest_resolves(100.0,1000.0))
    assert(not volume_nearest_resolves(1000.0,100.0))


test "Fair mornings are wide flat cumulus; towers stand where the air builds them":
    saved_active = weather_active; saved_hour = weather_hour_now
    saved_seconds = weather_seconds; saved_cells = weather_cells
    weather_active = true; weather_hour_now = 11.0; weather_seconds = 0.0; weather_cells = []
    loop cam in [vec3(0,600,-6000),vec3(0,600,0),vec3(9000,600,0)]:
        nearby = 0
        loop v in world_clouds(cam,vec2(0,0)):
            d = length(v.center.xz-cam.xz)
            if d >= 15000.0 or v.weather.x < 0.4: continue
            nearby += 1
            # Fair-weather cumulus are wider than tall.
            if v.shape < 2.0: assert(v.extent.y < v.extent.x)
        assert(nearby >= 5)
    towers = 0; huge = 0
    loop z in -4..5:
        loop x in -4..5:
            loop source in cloud_octave_group(x,z,1):
                built = cloud_evolve(source,WeatherAir(towers=1.0,cloud=0.8),300.0)
                if built.weather.x > 0.5 and built.shape == 2.0:
                    towers += 1
                    if built.extent.y*f32(CLOUD_MAX.y+CLOUD_BASE) > 3000.0: huge += 1
    assert(towers > 5 and huge > 0)
    weather_active = saved_active; weather_hour_now = saved_hour
    weather_seconds = saved_seconds; weather_cells = saved_cells

test "Cloud population covers three size octaves with stable clustered mass":
    smallest = 1000000.0; largest = 0.0
    loop level in 0..3:
        count = 0; cells = 0
        loop z in -10..11:
            loop x in -10..11:
                group = cloud_octave_group(x,z,level)
                assert(group == cloud_octave_group(x,z,level))
                if group.len() > 0: cells += 1
                loop v in group:
                    count += 1
                    smallest = min(smallest,f64(v.extent.x)); largest = max(largest,f64(v.extent.x))
                    # Uniform scale of each form's own proportions.
                    a = cloud_stamp_aspect(int(v.stamp))
                    assert(abs(v.extent.y/v.extent.x-a.y) < 0.0001)
                    # A group shares its air mass's condensation level.
                    assert(abs(v.center.y-v.extent.y*f32(CLOUD_BASE)-group[0].center.y+group[0].extent.y*f32(CLOUD_BASE)) < 400.0)
        assert(cells > 20 and cells < 300 and count >= cells)
    assert(largest/smallest > 15.0)

test "Haze preserves nearby pigment and separates far altitude layers":
    c = vec3(0.1,0.25,0.18); h = vec3(0.58,0.74,0.83)
    cam = vec3(0,2000,0)
    assert(aerial(c,cam+vec3(50,0,0),cam,h,0.00014) == c)
    near = aerial(c,cam+vec3(2000,0,0),cam,h,0.00014)
    far = aerial(c,cam+vec3(20000,0,0),cam,h,0.00014)
    assert(length(near-c) < length(far-c) and length(far-h) < length(near-h))
    assert(far.z-far.x > c.z-c.x)

test "Sky horizon matches distant haze and retains weather and hour palette":
    loop hour in [0.0,6.0,9.5,14.0,17.5]:
        L = light_at(hour)
        assert(length(sky_air_color(0.0,0.0,L.sun_dir.y,L.sky_top,L.sky_horizon,L.haze)-L.haze) < 0.00001)
        assert(length(sky_air_color(1.0,0.0,L.sun_dir.y,L.sky_top,L.sky_horizon,L.haze)-L.sky_top) < 0.00001)
    grey = vec3(0.3,0.35,0.4)
    assert(length(sky_air_color(0.5,0.0,1.0,grey,grey,grey)-grey) < 0.00001)


test "painted Sun and Moon share angular disc edges":
    assert(SKY_DISC_INNER>SKY_DISC_OUTER)
    assert(abs(SKY_DISC_RADIUS-sqrt(1.0-((SKY_DISC_INNER+SKY_DISC_OUTER)*0.5)^2))<0.00001)

test "calendar planets stay in the ecliptic and Venus stays near the Sun":
    pole=vec3(0,0.34202014,0.93969262)
    loop day in 0..400:
        planets=sky_planets(18.0,f64(day));next=sky_planets(18.0,f64(day+1))
        loop k in 0..4:
            assert(abs(length(planets[k].xyz)-1.0)<0.00001)
            assert(abs(dot(planets[k].xyz,pole))<0.2)
            assert(length(planets[k].xyz-next[k].xyz)>0.000001)
            assert(length(planets[k].xyz-next[k].xyz)<0.08)
        assert(dot(planets[0].xyz,sky_sun(18.0))>cos(49.0*PI/180.0))
        loop k in 1..4:assert(planets[0].w>planets[k].w)


test "cloud support rejects near sea-level effects but retains interiors and support faces":
    center=vec3(0,700,-100);extent=vec3(900,150,900);growth=vec4(0,0,0,0)
    loop heading in [0.0,0.7,1.9]:
        yaw=vec2(cos(heading),sin(heading))
        assert(cloud_veil_near(center,extent,yaw,growth,vec3(0,0,0))>700.0+150.0*CLOUD_MIN.y-1.0)
        assert(cloud_veil_near(center,extent,yaw,growth,center)==0)
        loop eye in [vec3(0,0,0),vec3(0,1200,0),vec3(2000,700,0)]:
            g=vec4(0,0,0.3,0.2)
            bound=cloud_veil_near(center,extent,yaw,g,eye)
            loop corner in 0..8:
                low=extent*(CLOUD_MIN-cloud_growth_padding(g));high=extent*(CLOUD_MAX+cloud_growth_padding(g))
                p=vec3(if corner&1==0:low.x else:high.x,if corner&2==0:low.y else:high.y,if corner&4==0:low.z else:high.z)
                world=render_world(center,eye)+cloud_to_world(p,yaw)
                assert(bound<=length(world-eye))
