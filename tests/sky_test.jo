test "Sun wraps continuously and Moon phase follows its solar elongation":
    loop hour in 0..25:
        sun = sky_sun(f64(hour)); moon = sky_moon(f64(hour), 0.0)
        assert(abs(length(sun) - 1.0) < 0.00001)
        assert(abs(length(moon) - 1.0) < 0.00001)
        assert(length(sun - sky_sun(f64(hour) + 24.0)) < 0.00001)
        assert(length(moon - sky_moon(f64(hour), LUNAR_MONTH)) < 0.00001)
    new_day = -LUNAR_EPOCH_AGE
    assert(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day)) < 0.003)
    assert(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day + LUNAR_MONTH / 2.0)) > 0.997)
    assert(abs(moon_illumination(sky_sun(12.0), sky_moon(12.0, new_day + LUNAR_MONTH / 4.0)) - 0.5) < 0.003)
    assert(sky_moon(0.0, new_day + LUNAR_MONTH / 2.0).y > 0.9)
    assert(sky_moon(12.0, new_day + LUNAR_MONTH / 2.0).y < -0.9)

test "Cloud cells are deterministic and independent of quality or global RNG":
    seed_random(42); expected = random()
    count = 0
    loop tier in 0..3:
        render_quality = quality_profile(tier)
        seed_random(42)
        loop z in -8..9:
            loop x in -8..9:
                a = cloud_cell(x, z); b = cloud_cell(x, z)
                assert(a == b)
                if a == none: continue
                v = a!; count += 1
                assert(v.center.y - v.extent.y * f32(CLOUD_BASE+0.01) > 500.0)
                assert(v.shape >= 0.0 and v.shape < f32(CLOUD_STAMPS))
        assert(random() == expected)
    assert(count > 100)
    render_quality = RenderQuality()

cloud_largest_component = (img: Image, kind: int) -> f64:
    n = CLOUD_VOXELS
    filled = fill(false, n * n * n)
    seen = fill(false, n * n * n)
    total = 0
    loop z in 0..n:
        sx = ((kind*CLOUD_VOXELS+z)%CLOUD_TILES)*CLOUD_SLICE
        sy = ((kind*CLOUD_VOXELS+z)/CLOUD_TILES)*CLOUD_SLICE
        loop y in 0..n:
            loop x in 0..n:
                alpha = img.get(sx + x + 1, sy + y + 1).w
                if alpha > 0.5:
                    q = vec3(f32(x), f32(y), f32(z)) * (2.0 / f32(n - 1)) - vec3(1, 1, 1)
                    margin: f32 = 2.0 / f32(n - 1)
                    loop axis in 0..3:
                        assert(q[axis] - margin >= CLOUD_MIN[axis] and q[axis] + margin <= CLOUD_MAX[axis])
                if alpha > 0.515:
                    filled[(z * n + y) * n + x] = true
                    total += 1
    largest = 0
    queue: int[]
    loop seed in 0..filled.len():
        if not filled[seed] or seen[seed]: continue
        queue.clear(); queue.push(seed); seen[seed] = true
        head = 0
        loop head < queue.len():
            at = queue[head]; head += 1
            x = at % n; y = (at / n) % n; z = at / (n * n)
            loop k in 0..6:
                if (k == 0 and x == 0) or (k == 1 and x == n - 1) or (k == 2 and y == 0) or (k == 3 and y == n - 1) or (k == 4 and z == 0) or (k == 5 and z == n - 1): continue
                next = at + (if k == 0: -1 else if k == 1: 1 else if k == 2: -n else if k == 3: n else if k == 4: -n * n else: n * n)
                if filled[next] and not seen[next]: seen[next] = true; queue.push(next)
        largest = max(largest, queue.len())
    f64(largest) / f64(max(total, 1))

test "Atlas gutters agree and density cannot clip at a stamp boundary":
    img = cloud_density_image()
    assert(img.width <= 2048 and img.height <= 2048)
    filled = 0
    loop kind in 0..CLOUD_STAMPS:
        # The baked flat cut agrees with the base used by cloud_evolve; this
        # guards against a visually floating floor as the height grows.
        lobes = cloud_lobes(kind)
        assert(abs(cloud_form_distance(vec3(0,f32(-CLOUD_BASE),0),lobes,kind)) < 0.005)
        assert(cloud_form_distance(vec3(0,f32(-CLOUD_BASE-0.02),0),lobes,kind) > 0.015)
        assert(cloud_form_distance(vec3(0,f32(-CLOUD_BASE+0.02),0),lobes,kind) < -0.015)
        loop z in 0..CLOUD_VOXELS:
            sx = ((kind*CLOUD_VOXELS+z)%CLOUD_TILES)*CLOUD_SLICE
            sy = ((kind*CLOUD_VOXELS+z)/CLOUD_TILES)*CLOUD_SLICE
            loop k in 0..CLOUD_VOXELS:
                assert(img.get(sx, sy + k + 1) == img.get(sx + 1, sy + k + 1))
                assert(img.get(sx + CLOUD_SLICE - 1, sy + k + 1) == img.get(sx + CLOUD_SLICE - 2, sy + k + 1))
                assert(img.get(sx + k + 1, sy) == img.get(sx + k + 1, sy + 1))
                assert(img.get(sx + k + 1, sy + CLOUD_SLICE - 1) == img.get(sx + k + 1, sy + CLOUD_SLICE - 2))
                assert(img.get(sx, sy + k + 1).w < 0.5)
                assert(img.get(sx + CLOUD_SLICE - 1, sy + k + 1).w < 0.5)
                assert(img.get(sx + k + 1, sy).w < 0.5)
                assert(img.get(sx + k + 1, sy + CLOUD_SLICE - 1).w < 0.5)
            if z == 0 or z == CLOUD_VOXELS - 1:
                loop y in 0..CLOUD_VOXELS:
                    loop x in 0..CLOUD_VOXELS: assert(img.get(sx + x + 1, sy + y + 1).w < 0.5)
            if img.get(sx + CLOUD_SLICE / 2, sy + CLOUD_SLICE / 2).w > 0.55: filled += 1
    assert(filled > 30)
    loop kind in 0..CLOUD_STAMPS: assert(cloud_largest_component(img, kind) > 0.995)

test "Height integrated haze stays clear at altitude and agrees at equal heights":
    c = vec3(0, 0, 0); haze = vec3(1, 1, 1)
    a = aerial(c, vec3(10000, 0, 0), vec3(0, 0, 0), haze, 0.00011)
    b = aerial(c, vec3(10000, 5000, 0), vec3(0, 5000, 0), haze, 0.00011)
    up = aerial(c, vec3(10000, 5000, 0), vec3(0, 0, 0), haze, 0.00011)
    down = aerial(c, vec3(0, 0, 0), vec3(10000, 5000, 0), haze, 0.00011)
    assert(abs(a.x - f32(1.0 - exp(-0.00011*9940.0))) < 0.00001)
    assert(b.x > 0.1 and b.x < 0.15 and up.x > b.x and up.x < a.x)
    assert(length(up - down) < 0.00001)

test "World cloud identities survive cache movement and wind advection":
    cam = vec3(0, 1000, 0)
    a = world_clouds(cam, vec2(0, 0))
    b = world_clouds(vec3(f32(CLOUD_CELL + 1.0), 1000, 0), vec2(0, 0))
    c = world_clouds(cam, vec2(30, -20))
    checked = 0
    loop v in a:
        if length(v.center.xz) > 4500.0: continue
        assert(any(b, (w: CloudVolume) -> bool: w == v))
        moved = v; moved.center += vec3(30, 0, -20)
        # Heating follows the actual land under an advected formation. It is
        # environmental input, not part of the persistent shape/cell identity.
        assert(any(c, (w: CloudVolume) -> bool:
            identity = w; identity.thermal = moved.thermal
            identity == moved))
        checked += 1
    assert(checked > 3)

test "Cloud shape bounds are world oriented from every camera side":
    v = CloudVolume(vec3(0,1500,0),vec3(1700,2300,1300),0,heading=0.7)
    loop cam in [vec3(0,1500,5000),vec3(5000,1500,0),vec3(0,1500,-5000),vec3(-5000,1500,0),vec3(0,7000,0)]:
        up = if cam.y > 6000.0: vec3(0,0,1) else: vec3(0,1,0)
        vp = perspective(62.0*PI/180.0,1280.0/720.0,1.0,300000.0)*look_at(cam,render_world(v.center,cam),up)
        bounds = volume_bounds(v,cam,vp)
        loop l in cloud_lobes(0):
            point = v.center+cloud_to_world(l.center*v.extent,vec2(cos(v.heading),sin(v.heading)))
            clip = vp*vec4(render_world(point,cam),1)
            q = clamp(clip.xy/clip.w,vec2(-1,-1),vec2(1,1))
            assert(q.x >= bounds.x-0.001 and q.x <= bounds.z+0.001)
            assert(q.y >= bounds.y-0.001 and q.y <= bounds.w+0.001)

test "Nearest guide bound cannot accept an unresolved depth discontinuity":
    loop center in [1.0,20.0,100.0,1000.0,10000.0,1000000.0]:
        loop ratio in [0.0,0.01,0.1,0.5,0.9,1.0,1.1,2.0,10.0,1000.0]:
            near = center*ratio
            if not volume_nearest_resolves(f32(center),f32(near)): continue
            delta = abs(near-center)/max(8.0,center*0.025)
            # The closest of four taps always has a bilinear weight >=1/4.
            minimum = 0.25/(1.0+delta*delta*delta*delta)
            assert(minimum >= 0.0001)
    assert(not volume_nearest_resolves(100.0,1000.0))
    assert(not volume_nearest_resolves(1000.0,100.0))


test "Fair-weather flight neighbourhoods contain developed cumulus and low banks":
    saved_active = weather_active; saved_hour = weather_hour_now
    saved_seconds = weather_seconds; saved_cells = weather_cells
    weather_active = true; weather_hour_now = 11.0; weather_seconds = 0.0; weather_cells = []
    towers = 0; huge = 0
    loop cam in [vec3(0,600,-6000),vec3(0,600,0),vec3(9000,600,0)]:
        nearby = 0
        loop v in world_clouds(cam,vec2(0,0)):
            d = length(v.center.xz-cam.xz)
            if d >= 15000.0 or v.weather.x < 0.4: continue
            if v.extent.y > 2000.0: nearby += 1; towers += 1
            if v.extent.y > 3000.0: huge += 1
        assert(nearby >= 1)
    assert(towers > 0 and huge > 0)
    loop z in -8..9:
        loop x in -8..9:
            if let bank = cloud_bank(x,z,heating=false): assert(bank.extent.y <= 1600.0)
    weather_active = saved_active; weather_hour_now = saved_hour
    weather_seconds = saved_seconds; weather_cells = saved_cells

test "Cloud population covers three size octaves with stable clustered mass":
    smallest = 1000000.0; largest = 0.0
    loop level in 0..3:
        count = 0
        loop z in -10..11:
            loop x in -10..11:
                if let v = cloud_octave(x,z,level):
                    count += 1
                    smallest = min(smallest,f64(v.extent.x)); largest = max(largest,f64(v.extent.x))
                    assert(cloud_octave(x,z,level) == cloud_octave(x,z,level))
        assert(count > 20 and count < 300)
    assert(largest/smallest > 30.0)


test "Haze preserves nearby pigment and separates far altitude layers":
    c = vec3(0.1,0.25,0.18); h = vec3(0.58,0.74,0.83)
    cam = vec3(0,2000,0)
    assert(aerial(c,cam+vec3(50,0,0),cam,h,0.00014) == c)
    near = aerial(c,cam+vec3(2000,0,0),cam,h,0.00014)
    far = aerial(c,cam+vec3(20000,0,0),cam,h,0.00014)
    assert(length(near-c) < length(far-c) and length(far-h) < length(near-h))
    assert(far.z-far.x > c.z-c.x)

test "Sky horizon matches distant haze and retains weather and hour palette":
    loop hour in [0.0,6.0,9.5,14.0,17.5]:
        L = light_at(hour)
        assert(length(sky_air_color(0.0,0.0,L.sun_dir.y,L.sky_top,L.sky_horizon,L.haze)-L.haze) < 0.00001)
        assert(length(sky_air_color(1.0,0.0,L.sun_dir.y,L.sky_top,L.sky_horizon,L.haze)-L.sky_top) < 0.00001)
    grey = vec3(0.3,0.35,0.4)
    assert(length(sky_air_color(0.5,0.0,1.0,grey,grey,grey)-grey) < 0.00001)
