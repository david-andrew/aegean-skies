# The Settings page's Sandbox and Accessibility sections as the options keep them: each switch
# saved, each off in a file from before them; and the pause menu's pages with "any aircraft".
use '../src/debugmenu.jo'
use '../src/options.jo'
use '../src/sandbox.jo'
use '../src/side_colours.jo'

# (a field written as `, name=...` in a struct's text, with whatever it holds, taken out)
_drop_field = (text: str, name: str) -> str:
    parts = split(text, ", {name}=")
    if parts.len() < 2: return text
    rest = join(parts[1..parts.len()], ", {name}=")
    depth = 0
    k = 0
    loop k < rest.len():
        c = rest[k..k + 1]
        if c == "(" or c == "[" or c == "{": depth += 1
        else if c == ")" or c == "]" or c == "}":
            if depth == 0: break
            depth -= 1
        else if c == "," and depth == 0: break
        k += 1
    parts[0] + rest[k..rest.len()]

_switches = [Sandbox(paint_anywhere = true), Sandbox(any_aircraft = true), Sandbox(unlimited_money = true), Sandbox(no_damage = true), Sandbox(no_fuel_use = true), Sandbox(endless_ammunition = true)]

test "the options keep each sandbox switch, and a new player's are all off":
    assert(Options().sandbox == Sandbox() and not sandbox_active(Options().sandbox))
    loop one in _switches:
        o = Options(sandbox = one)
        back = from_text[Options](to_text(o))
        assert(back is Options)
        if back is Options: assert(back.sandbox == one and back == o)

test "the options keep the colours of the sides":
    assert(Options().colour_vision == ColourVision.standard)
    loop v in COLOUR_VISIONS:
        back = from_text[Options](to_text(Options(colour_vision = v)))
        assert(back is Options)
        if back is Options: assert(back.colour_vision == v)

test "options saved before the sandbox and the colours load with every switch off and the standard colours":
    text = to_text(Options(sandbox = Sandbox(unlimited_money = true, no_damage = true), colour_vision = ColourVision.monochrome, invert_y = true))
    old = _drop_field(_drop_field(text, "sandbox"), "colour_vision")
    assert(not old.contains("sandbox=") and not old.contains("colour_vision=") and not old.contains("unlimited_money"), old)
    back = from_text[Options](old)
    assert(not (back is TextError), if back is TextError: back.message else: "")
    if back is Options: assert(back.sandbox == Sandbox() and back.colour_vision == ColourVision.standard and back.invert_y)

test "the options set the switches and the palette the game reads":
    loop one in _switches:
        apply_options(Options(sandbox = one))
        assert(sandbox == one)
    loop v in COLOUR_VISIONS:
        apply_options(Options(colour_vision = v))
        assert(colour_vision == v and side_palette == side_palette_for(v) and sandbox == Sandbox())
    apply_options(Options())
    assert(sandbox == Sandbox() and colour_vision == ColourVision.standard)

test "paint anywhere: the Paint page among the player's own only with the switch on":
    d = Debug(page = SETTINGS_PAGE)
    assert(not shown_pages(d).contains(PAINT_PAGE) and PAGE_ORDER.contains(PAINT_PAGE))
    d.opts.sandbox.paint_anywhere = true
    shown = shown_pages(d)
    assert(shown.contains(PAINT_PAGE) and shown.len() == PLAYER_PAGES.len() + 1 and not shown.contains(AIRCRAFT_PAGE))
    d.page = PAINT_PAGE
    assert(shown_pages(d) == shown)
    # (with both switches: both pages, the paint first)
    d.opts.sandbox.any_aircraft = true
    assert(shown_pages(d) == PLAYER_PAGES + [PAINT_PAGE, AIRCRAFT_PAGE])
    # (with Advanced settings, every page as ever)
    d.opts = Options(advanced = true)
    assert(shown_pages(d) == PAGE_ORDER)

test "any aircraft at any time: the Aircraft page among the player's own, and no other trial page":
    d = Debug(page = SETTINGS_PAGE)
    assert(not shown_pages(d).contains(AIRCRAFT_PAGE) and shown_pages(d) == PLAYER_PAGES)
    d.opts.sandbox.any_aircraft = true
    shown = shown_pages(d)
    assert(shown.contains(AIRCRAFT_PAGE) and shown.len() == PLAYER_PAGES.len() + 1)
    loop page in ADVANCED_PAGES:
        if page != AIRCRAFT_PAGE: assert(not shown.contains(page))
    # (and on that page the same tabs stay: it is one of the player's now)
    d.page = AIRCRAFT_PAGE
    assert(shown_pages(d) == shown)
    # (no other switch shows it)
    loop one in _switches:
        if one.any_aircraft: continue
        other = Debug(page = SETTINGS_PAGE)
        other.opts.sandbox = one
        # (paint anywhere shows the Paint page, and nothing else)
        assert(shown_pages(other) == (if one.paint_anywhere: PLAYER_PAGES + [PAINT_PAGE] else: PLAYER_PAGES))
