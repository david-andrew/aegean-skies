use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_money.jo'
use '../src/living_market.jo'

test "thirty day smoke exact money and goods accounting":
    loop seed in [0,1,7,42,127]:
        w = build_world(u64(seed))
        loop minute in 0..43200:
            advance_minutes(w,1)
            if minute%60 == 0:
                assert(money_balances(w) and goods_balance(w))
                loop p in w.places:
                    assert(inventory_valid(p.market.inventory))
                    loop g in 0..9:
                        price = p.market.price_cents[g]; base = w.goods[g].base_cents
                        assert(price >= base*45/100-1 and price <= base*180/100+1)
        print("seed {seed}: {w.ledger.external_in_cents}c in, {w.ledger.external_out_cents}c out, balanced")

test "stopping one fisher removes only their labor and cancelled ships add nothing":
    a = build_world(u64(42)); b = build_world(u64(42))
    b.people[7].injured_until = 10000
    advance_minutes(a,30); advance_minutes(b,30)
    factor = 600+draw1000000(a.seed,20,7,0)*800/1000000
    assert(a.goods_ledger.created[0]-b.goods_ledger.created[0] == (4000*factor*30/60000)*10)
    w = build_world()
    prepare_shipments(w)
    loop mut s in w.shipments: s.cancelled = true; s.arrival_minute = 0
    before = stock_totals(w); cash = w.ledger.external_out_cents
    advance_shipments(w)
    assert(stock_totals(w) == before and w.ledger.external_out_cents == cash)
    assert(money_balances(w) and goods_balance(w))
