use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_far_types.jo'
use '../src/living_news_bridge.jo'
use '../src/living_seed.jo'
use '../src/living_events.jo'
use '../src/living_news.jo'
use '../src/living_far_news.jo'
use '../src/living_far_economy.jo'
use '../src/living_place_context.jo'
use '../src/living_save.jo'

test "only public actually received detailed notices cross the tier and retain one event identity":
    w=build_world(u64(42)); contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    contexts.push(LifePlaceContext(100,"Distant port",1,100,vec3(100000,0,0)))
    assert(publish_place_contexts(w,1,contexts,[-1,100,-1]))
    assert(populate_settlement_economy(w,1,[FarPlaceSeed(0,80,0,3),FarPlaceSeed(100,80,1,0)],[]))
    event=emit_event(w,.raid,5,22,18,Reason(purpose=.raid,actor=22,counterparty=18,origin=5,destination=5,good=6,quantity=1000),4000)
    publish_events(w); bridge_core_news(w)
    assert(not (event in w.far.core_reports))
    notice=[loop n in w.places[5].news: if n.event==event: n][0]
    assert(receive_place(w,0,retell(notice,18,w.minute)))
    bridge_core_news(w)
    assert(event in w.far.core_reports)
    r=w.far.core_reports[event]
    assert(r.occurred_minute==notice.occurred_minute and r.hops==1 and r.source_person==18)
    loop _ in 0..10: bridge_core_news(w)
    assert([loop r in w.far.districts[0].reports: if r.id==w.far.core_reports[event].id: r].len()==1)
    assert(w.far.districts[100].reports.len()==0)
    assert(validate_save_world(w)=="")
