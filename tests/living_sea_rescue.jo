use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_sea_rescue.jo'
use '../src/living_far_aircraft.jo'
use '../src/living_far_stock.jo'
use '../src/living_war_rescue.jo'
use '../src/living_war_checks.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_checks.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_orders.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

sea_rescue_fixture = () -> World:
    w=commission_fixture()
    w.far.districts[300].target[0]+=20000
    w.far.vehicles[1].buying_order=counter_restock_order(w,1,300)
    w.tick=120; w.minute=1
    assert(far_depart(w,1))
    at=w.far.vehicles[1].pos
    id=record_downed_airman(w,8,2,at,0)
    assert(id>=0)
    w

test "a passing paid coaster pauses picks up the same pilot and carries them to its real port":
    w=sea_rescue_fixture(); population=far_population(w)
    id=w.war.survivors.keys()[0]; person=w.war.survivors[id].person
    assert(person==8)
    sea_rescue_minute(w)
    assert(w.war.survivors[id].assigned_boat==1 and w.people[person].far_boat== -1)
    boat=w.far.vehicles[1]; at=boat.pos
    # Real handling time, with neither abstract movement nor instant arrival.
    w.tick+=120; w.minute=w.tick/120
    far_advance_transport(w,w.tick); sea_rescue_minute(w)
    assert(w.far.vehicles[1].pos==at and w.people[person].far_boat== -1)
    w.tick=w.war.survivors[id].pickup_tick; w.minute=w.tick/120
    sea_rescue_minute(w)
    assert(w.people[person].far_boat==1 and person in w.far.vehicles[1].passengers)
    assert(person_world_position(w,person)==w.far.vehicles[1].pos and person_vehicle_bound(w,person))
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick); sea_rescue_minute(w)
    assert(w.far.vehicles[1].pos!=at)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick); sea_rescue_minute(w)
    assert(w.far.vehicles[1].place==300 and w.people[person].far_boat== -1)
    assert(w.people[person].far_visit==300 and w.war.survivors[id].resolved)
    assert(not (person in w.far.vehicles[1].passengers) and far_population(w)==population)
    assert(validate_far(w)=="" and validate_war(w)=="" and money_balances(w) and goods_balance(w))
    text=canonical_text(w); saved=from_text[World](text)
    assert(saved is World and canonical_text(saved)==text)


test "an air caller's released wreck hands its existing bound pilot to the living rescue owner once":
    w=commission_fixture(); assert(far_produce(w,100,5,2000))
    r=register_far_aircraft(w,100,.minnow,w.far.districts[100].household_account,"wreck:club")
    assert(r.craft>=0)
    w.aircraft[r.craft].state=.wrecked; w.aircraft[r.craft].hull=100
    w.aircraft[r.craft].pose.pos=vec3(1500,0,-20000)
    w.far.people[r.person].vehicle=r.craft
    identities=w.people.len(); population=far_population(w)
    far_wreck_survivors(w); id=w.aircraft[r.craft].rescue_event
    assert(id>=0 and w.war.survivors[id].person==r.person and w.people[r.person].state==.injured)
    far_wreck_survivors(w)
    assert(w.aircraft[r.craft].rescue_event==id and w.people.len()==identities and far_population(w)==population)
    assert(w.far.people[r.person].vehicle==r.craft)
