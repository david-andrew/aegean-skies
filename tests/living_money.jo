use '../src/living_money.jo'
use '../src/living_types.jo'

test "cash transfer and escrow rollback":
    w = World()
    a = new_account(w,"one",10000)
    b = new_account(w,"two",100)
    assert(not transfer(w,a,b,20000,.trade))
    assert(w.accounts[a].cents == 10000 and w.ledger.sequence == 0)
    assert(not transfer(w,-1,b,10,.trade))
    assert(transfer(w,-1,b,500,.subsidy))
    e = fund_escrow(w,a,2000,"escrow")
    assert(e == 2 and transfer(w,e,b,2000,.reward))
    assert(not transfer(w,e,b,2000,.reward) and money_balances(w))
    assert(fund_escrow(w,a,9000,"failed") == -1 and w.accounts.len() == 3)

test "goods reserve and one location transfer":
    a = Inventory(); b = Inventory()
    a.qty[0] = 5000
    assert(reserve(a,0,2000))
    assert(not move_stock(a,b,0,4000))
    assert(move_stock(a,b,0,2000,true))
    assert(a.qty[0] == 3000 and a.reserved[0] == 0 and b.qty[0] == 2000)
    assert(not move_stock(a,b,0,2000,true))
    assert(inventory_valid(a) and inventory_valid(b))

test "ten litre can tank and fuel burn exact":
    w = World()
    w.aircraft.push(AircraftRecord(id=0,kind=.gull))
    w.aircraft[0].cargo.qty[int(GoodKind.fuel)] = 1000
    w.goods_ledger.opening = stock_totals(w)
    assert(fill_from_cargo(w,0,1000))
    assert(w.aircraft[0].fuel_ml == 10000 and goods_balance(w))
    loop i in 0..333: assert(burn_fuel(w,0,30) == 30)
    assert(burn_fuel(w,0,30) == 10 and w.aircraft[0].fuel_ml == 0 and goods_balance(w))
