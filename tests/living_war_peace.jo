use '../src/living_types.jo'
use '../src/living_war.jo'
use '../src/living_war_peace.jo'
use '../src/living_far_news.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

test "two signed proposals must actually reach opposite councils before a ceasefire and cannot be reused":
    w=commission_fixture(); initialize_war(w); relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    money=w.ledger.opening_cents; stock=stock_totals(w)
    a=offer_ceasefire(w,1,2); b=offer_ceasefire(w,2,1)
    assert(a>=0 and b>=0 and offer_ceasefire(w,1,2)==a)
    ar=w.war.peace_offers[peace_key(1,2,1)]; br=w.war.peace_offers[peace_key(1,2,2)]
    settle_ceasefires(w); assert(w.diplomacy[relation].stage==.war)
    far_arriving_accounts(w,200,[ar]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.war)
    # A spoken claim is no substitute for the signed proposal, even if it is sincere.
    rumor=br; rumor.hops=1; rumor.confidence=850
    far_arriving_accounts(w,100,[rumor]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.war)
    far_arriving_accounts(w,100,[br]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.armistice and w.war.peace_offers.len()==0)
    w.diplomacy[relation].stage=.war; settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.war)
    assert(w.ledger.opening_cents==money and stock_totals(w)==stock and money_balances(w) and goods_balance(w))
    text=canonical_text(w); decoded=from_text[World](text)
    assert(decoded is World and canonical_text(decoded)==text and validate_save_world(decoded)=="")

test "a council proposes peace for actual exhaustion and no calendar forces its opponent to agree":
    w=commission_fixture(); initialize_war(w); relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    w.minute=360; w.tick=w.minute*120
    war_peace_minute(w); assert(w.war.peace_offers.len()==0)
    account=w.far.treasury[1]
    assert(transfer(w,account,w.far.districts[100].household_account,w.accounts[account].cents-40000,.trade))
    war_peace_minute(w)
    assert(w.war.peace_offers.len()==1 and peace_key(1,2,1) in w.war.peace_offers)
    assert(w.diplomacy[relation].stage==.war and money_balances(w))

test "opposing signed peace offers remain pending through a real sea-scale communication delay":
    w=commission_fixture(); initialize_war(w); relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    a=offer_ceasefire(w,1,2); b=offer_ceasefire(w,2,1)
    ar=w.war.peace_offers[peace_key(1,2,1)]; br=w.war.peace_offers[peace_key(1,2,2)]
    w.minute=60*1440; w.tick=w.minute*120
    # An undelivered proposal is not silently replaced before its return can arrive.
    assert(offer_ceasefire(w,1,2)==a and offer_ceasefire(w,2,1)==b)
    settle_ceasefires(w); assert(w.diplomacy[relation].stage==.war)
    far_arriving_accounts(w,200,[ar]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.war)
    far_arriving_accounts(w,100,[br]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.armistice and w.war.peace_offers.len()==0)
    assert(money_balances(w) and goods_balance(w))

test "credible losses arriving after a long crossing can move a council to seek peace without a new battle or a refreshed occurrence date":
    w=commission_fixture(); initialize_war(w); relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    loop _ in 0..2:
        far_local_news(w,100,"battle","A dated signed report records the loss of an existing charter.",country=1,aggressor=1,affected=2,state_backed=true,weight=100,severity=900)
    packets=w.far.districts[100].reports
    w.minute=40*1440; w.tick=w.minute*120
    war_peace_minute(w); assert(w.war.peace_offers.len()==0)
    far_arriving_accounts(w,200,packets); war_peace_minute(w)
    assert(peace_key(1,2,2) in w.war.peace_offers and not (peace_key(1,2,1) in w.war.peace_offers))
    assert(w.diplomacy[relation].stage==.war)
    received=[loop r in w.far.districts[200].reports: if r.kind=="battle": r][0]
    assert(received.occurred_minute==0 and received.learned_minute==w.minute)
    w.minute+=1440; w.tick=w.minute*120; far_arriving_accounts(w,200,packets)
    again=[loop r in w.far.districts[200].reports: if r.id==received.id: r][0]
    assert(again.learned_minute==received.learned_minute and again.occurred_minute==0)


test "a signed armistice closes its old incidents while actual later breaches can cause another war":
    w=commission_fixture(); a=war_charter(w,0,1); b=war_charter(w,1,2)
    war_supply(w,a); war_supply(w,b)
    loop _ in 0..3: war_incident(w,200,1,2,"armed_intrusion","A separate official armed inspection was witnessed.")
    war_diplomacy(w); relation=war_relation(w,1,2)
    assert(w.diplomacy[relation].stage==.war)
    w.minute=60; w.tick=w.minute*120
    war_supply(w,a); war_supply(w,b)
    assert(offer_ceasefire(w,1,2)>=0 and offer_ceasefire(w,2,1)>=0)
    ar=w.war.peace_offers[peace_key(1,2,1)]; br=w.war.peace_offers[peace_key(1,2,2)]
    far_arriving_accounts(w,200,[ar]); far_arriving_accounts(w,100,[br]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.armistice)
    war_diplomacy(w)
    assert(w.diplomacy[relation].stage==.armistice,"Readiness and the same settled reports immediately restarted the war")
    assert(w.diplomacy[relation].last_armistice_minute==60)
    legacy=w; legacy.diplomacy[relation].last_armistice_minute= -1; legacy.diplomacy[relation].last_armistice_news= -1; legacy.diplomacy[relation].last_armistice_event= -1
    war_diplomacy(legacy)
    assert(legacy.diplomacy[relation].stage==.armistice and legacy.diplomacy[relation].last_armistice_minute==60)
    loop _ in 0..2: war_incident(w,200,1,2,"armed_intrusion","A genuinely later inspection refused the border in the same clock minute.")
    war_diplomacy(w); assert(w.diplomacy[relation].stage==.armistice)
    w.minute=120; w.tick=w.minute*120; war_supply(w,a); war_supply(w,b)
    war_incident(w,200,1,2,"armed_intrusion","A third post-armistice inspection refused the agreed border.")
    war_diplomacy(w)
    assert(w.diplomacy[relation].stage==.war and money_balances(w) and goods_balance(w))
