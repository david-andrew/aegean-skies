use '../src/living_types.jo'
use '../src/living_war.jo'
use '../src/living_war_peace.jo'
use '../src/living_far_news.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

test "two signed proposals must actually reach opposite councils before a ceasefire and cannot be reused":
    w=commission_fixture(); initialize_war(w); relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    money=w.ledger.opening_cents; stock=stock_totals(w)
    a=offer_ceasefire(w,1,2); b=offer_ceasefire(w,2,1)
    assert(a>=0 and b>=0 and offer_ceasefire(w,1,2)==a)
    ar=w.war.peace_offers[peace_key(1,2,1)]; br=w.war.peace_offers[peace_key(1,2,2)]
    settle_ceasefires(w); assert(w.diplomacy[relation].stage==.war)
    far_arriving_accounts(w,200,[ar]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.war)
    # A spoken claim is no substitute for the signed proposal, even if it is sincere.
    rumor=br; rumor.hops=1; rumor.confidence=850
    far_arriving_accounts(w,100,[rumor]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.war)
    far_arriving_accounts(w,100,[br]); settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.armistice and w.war.peace_offers.len()==0)
    w.diplomacy[relation].stage=.war; settle_ceasefires(w)
    assert(w.diplomacy[relation].stage==.war)
    assert(w.ledger.opening_cents==money and stock_totals(w)==stock and money_balances(w) and goods_balance(w))
    text=canonical_text(w); decoded=from_text[World](text)
    assert(decoded is World and canonical_text(decoded)==text and validate_save_world(decoded)=="")

test "a council proposes peace for actual exhaustion and no calendar forces its opponent to agree":
    w=commission_fixture(); initialize_war(w); relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    w.minute=360; w.tick=w.minute*120
    war_peace_minute(w); assert(w.war.peace_offers.len()==0)
    account=w.far.treasury[1]
    assert(transfer(w,account,w.far.districts[100].household_account,w.accounts[account].cents-40000,.trade))
    war_peace_minute(w)
    assert(w.war.peace_offers.len()==1 and peace_key(1,2,1) in w.war.peace_offers)
    assert(w.diplomacy[relation].stage==.war and money_balances(w))
