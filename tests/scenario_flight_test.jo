import '../tests/scenarios_test.jo' as fixture
use '../src/flight.jo'
use '../src/pilot.jo'
use '../src/planes.jo'
use '../src/combat.jo'
use '../src/tweaks.jo'
use '../src/traffic.jo'
import '../src/living_scene.jo' as scene

# Use the real scenario constructor and registry binding, not a second copied fixture.
test "scenario and normal aircraft have identical pitch roll and ownership":
    situation=fixture.scenario_fixture();w=situation.world;f=situation.flyer
    adapter=scene.SceneAdapter();bind_living_player(f,w,adapter)
    normal=make_flyer(f.kind,f.model,f.spec.contacts,vec3(0,0,0),0.0)
    normal.spec.player=true;normal.spec.fuel_capacity=f.spec.fuel_capacity;normal.spec.fuel_burn=f.spec.fuel_burn
    normal.state=f.state
    assert(normal.spec==f.spec and f.spec.player and f.spec.handling_scale==3.3 and f.state.hull_damage==0)
    pi=combat_index(situation.battle,w.people[w.player].craft)
    actor=situation.battle.actors[pi]
    assert(actor.external and actor.human)
    loop trial in [false,true]:
        set_tweaks(Tweaks(chaotic_stalls=trial))
        loop mode in 0..2:
            a=f.state;b=normal.state
            battle=Battle(enabled=true,actors=[actor])
            peak=0.0
            loop i in 0..120:
                c=Controls(assist=0,throttle=0.6,pitch=if mode==0:0.6 else:0.0,roll=if mode==1:0.8 else:0.0)
                old=a.orientation
                step(f.spec,a,c,FlightEnv(),1.0/60.0);step(normal.spec,b,c,FlightEnv(),1.0/60.0)
                battle.actors[0].state=a
                step_battle(battle,FlightEnv(),a.position)
                assert(a==b and battle.actors[0].state.position==a.position and battle.actors[0].state.orientation==a.orientation)
                assert(battle.physics_steps==0 and battle.brain_steps==0)
                q=quat_mul(quat_inverse(old),a.orientation)
                component=if mode==0:f64(q.x) else:f64(q.z)
                peak=max(peak,abs(2.0*atan2(component,f64(q.w))*60.0*180.0/PI))
            print("scenario == normal: trial={trial} axis={mode} peak={peak:.3}deg/s")
    set_tweaks(Tweaks());set_speed_scale(1.0)

test "stall trial leaves attached normal manoeuvring exactly on original pose path":
    set_speed_scale(3.3)
    loop kind in [Craft.gull,Craft.heron,Craft.corsair,Craft.falco]:
        k=craft_spec(kind,build_craft(kind,LIVERIES[0]).contacts);k.player=true
        a=CraftState(position=vec3(0,450,0),velocity=vec3(0,0,-k.cruise_speed),fuel=k.fuel_capacity,throttle=0.8,water_age=1)
        b=a
        loop i in 0..600:
            # Ordinary bank reversals and modest pitch corrections, above the lift break.
            c=Controls(assist=0,throttle=0.8,pitch=0.06*sin(f64(i)*0.03),roll=0.25*sin(f64(i)*0.03),yaw=0.08*cos(f64(i)*0.03))
            set_tweaks(Tweaks(chaotic_stalls=false));step(k,a,c,FlightEnv(),1.0/60.0)
            set_tweaks(Tweaks(chaotic_stalls=true));step(k,b,c,FlightEnv(),1.0/60.0)
            assert(b.stall_blend==0)
            assert(a.position==b.position and a.velocity==b.velocity and a.orientation==b.orientation)
    set_tweaks(Tweaks());set_speed_scale(1.0)
