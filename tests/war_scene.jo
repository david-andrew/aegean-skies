use 'living_commissions.jo'

naval_fixture = () -> World:
    w=commission_fixture(); offset=vec3(0,0,-20000)
    loop key in w.place_contexts.keys(): w.place_contexts[key].center+=offset
    loop place in w.far.harbors.keys():
        loop k in 0..w.far.harbors[place].docks.len():
            w.far.harbors[place].docks[k]+=offset; w.far.harbors[place].quays[k]+=offset
        w.far.harbors[place].buoy+=offset
    loop k in 0..w.far.links.len():
        w.far.links[k].mode=.ship
        loop n in 0..w.far.links[k].points.len(): w.far.links[k].points[n]+=offset
    loop k in 0..w.far.vehicles.len():
        w.far.vehicles[k].kind=.ship; w.far.vehicles[k].pos+=offset
    a=war_charter(w,0,1); b=war_charter(w,1,2)
    assert(a==0 and b==1)
    war_supply(w,a); war_supply(w,b)
    r=war_relation(w,1,2); w.diplomacy[r].stage=.war
    begin_war_contacts(w)
    assert(w.war.contacts.len()==1)
    w

test "an offscene contact uses one saved variate applies finite losses once and replays":
    a=naval_fixture(); text=canonical_text(a); parsed=from_text[World](text); assert(parsed is World)
    b=parsed
    a.minute+=45; a.tick=a.minute*120
    b.minute+=45; b.tick=b.minute*120
    advance_war_contacts(a); advance_war_contacts(b)
    assert(canonical_text(a)==canonical_text(b))
    assert(a.war.contacts[0].state==.resolved and a.war.survivors.len()==1)
    after=canonical_text(a); advance_war_contacts(a); assert(canonical_text(a)==after)
    assert(far_stock_errors(a).len()==0 and goods_balance(a) and money_balances(a) and validate_war(a)=="")

test "nearby naval guns hit existing hulls through combat and preserve ordnance on save":
    w=naval_fixture(); observer=w.far.vehicles[0].pos
    fleet=VesselFleet(); b=Battle(enabled=true); bindings=VesselBindings()
    sync_far_vessels(fleet,w,observer)
    assert(fleet.ships.len()==2)
    prepare_war_scene(w,fleet,b,observer)
    assert(b.rounds.len()==2 and w.war.contacts[0].state==.physical)
    publish_vessel_targets(fleet,b,bindings,observer)
    step_battle(b,FlightEnv(),observer)
    receive_vessel_hits(fleet,b,bindings)
    sync_far_vessels(fleet,w,observer); commit_war_scene(w,fleet,b)
    saved=canonical_text(w); decoded=from_text[World](saved)
    assert(decoded is World and canonical_text(decoded)==saved and w.war.rounds.len()>0)
    restored=Battle(enabled=true)
    prepare_war_scene(decoded,fleet,restored,observer)
    assert(restored.rounds.len()==w.war.rounds.len())
    loop _ in 0..5400:
        if w.war.contacts[0].state==.resolved: break
        w.tick+=1; w.minute=w.tick/120
        prepare_war_scene(w,fleet,b,observer)
        publish_vessel_targets(fleet,b,bindings,observer)
        step_battle(b,FlightEnv(),observer)
        receive_vessel_hits(fleet,b,bindings)
        sync_far_vessels(fleet,w,observer); commit_war_scene(w,fleet,b)
    assert(w.war.contacts[0].state==.resolved and w.war.contacts[0].physical_seen)
    assert(w.war.contacts[0].shots[0]>0 and (w.far.vehicles[0].hull<1000 or w.far.vehicles[1].hull<1000))
    assert(far_stock_errors(w).len()==0 and goods_balance(w) and money_balances(w))
    assert(validate_war(w)=="" and validate_far(w)=="")


test "a full mid-battle checkpoint restores navigation ordnance counters and the same physical continuation":
    w=naval_fixture(); observer=w.far.vehicles[0].pos
    fleet=VesselFleet(); battle=Battle(enabled=true); bindings=VesselBindings()
    sync_far_vessels(fleet,w,observer)
    prepare_war_scene(w,fleet,battle,observer)
    publish_vessel_targets(fleet,battle,bindings,observer)
    step_battle(battle,FlightEnv(),observer)
    receive_vessel_hits(fleet,battle,bindings)
    sync_far_vessels(fleet,w,observer); commit_war_scene(w,fleet,battle)
    checkpoint_war_scene(w,fleet,battle)
    text=canonical_text(w); restored=from_text[World](text); assert(restored is World)
    copy_fleet=VesselFleet(); copy_battle=Battle(); copy_bindings=VesselBindings()
    assert(restore_war_scene(restored,copy_fleet,copy_battle))
    assert(to_text(copy_fleet)==to_text(fleet) and to_text(copy_battle)==to_text(battle))
    loop _ in 0..180:
        w.tick+=1; w.minute=w.tick/120
        restored.tick+=1; restored.minute=restored.tick/120
        prepare_war_scene(w,fleet,battle,observer)
        prepare_war_scene(restored,copy_fleet,copy_battle,observer)
        publish_vessel_targets(fleet,battle,bindings,observer)
        publish_vessel_targets(copy_fleet,copy_battle,copy_bindings,observer)
        step_battle(battle,FlightEnv(),observer); step_battle(copy_battle,FlightEnv(),observer)
        receive_vessel_hits(fleet,battle,bindings); receive_vessel_hits(copy_fleet,copy_battle,copy_bindings)
        sync_far_vessels(fleet,w,observer); sync_far_vessels(copy_fleet,restored,observer)
        commit_war_scene(w,fleet,battle); commit_war_scene(restored,copy_fleet,copy_battle)
    assert(canonical_text(w)==canonical_text(restored) and to_text(fleet)==to_text(copy_fleet) and to_text(battle)==to_text(copy_battle))
