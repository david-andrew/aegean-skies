use '../src/living_crop_calendar.jo'

test "crop dates follow the civil year and real sowing season across leap years":
    assert(crop_date(0)=="14 May 1928" and crop_year(0)==1928)
    assert(crop_date(crop_month_start(1928,2)+28)=="29 February 1928")
    assert(crop_date(crop_month_start(1929,2)+28)=="1 March 1929")
    assert(not crop_sowing_season(0))
    loop year in 1927..1931:
        assert(crop_sowing_season(crop_month_start(year,10)))
        assert(crop_sowing_season(crop_month_start(year,12)-1))
        assert(not crop_sowing_season(crop_month_start(year,12)))
        loop offset in 0..61:
            sow=crop_month_start(year,10)+offset
            ready=crop_ready_day(sow,offset)
            assert(ready-sow>=180 and crop_year(ready)==year+1)
            assert(ready>=crop_month_start(year+1,6) and ready<crop_month_start(year+1,7))

test "a standing opening crop was sown last autumn and is not ripe at the opening":
    sow=crop_opening_sown_day()
    assert(crop_date(sow)=="16 October 1927")
    loop field in 0..24:
        ready=crop_ready_day(sow,field)
        assert(ready>=18 and ready<=29 and ready-sow>=180)
