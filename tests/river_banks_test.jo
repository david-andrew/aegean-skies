use '../src/river_banks.jo'

test "shared bank tree meshes preserve every seeded crown and normal":
    loop kind in 0..2:
        loop detail in [false,true]:
            basis:Vertex3D[]
            river_tree(basis,vec3(0,0,0),kind,0.0,detail,true)
            loop seed in [-5.0,0.0,19.0,234.0,7113.0]:
                original:Vertex3D[]
                river_tree(original,vec3(0,0,0),kind,seed,detail)
                phase=vec4(cos(seed),sin(seed),f32(kind),1)
                assert(original.len()==basis.len())
                loop i in 0..basis.len():
                    assert(length(river_bank_point(basis[i],phase)-original[i].pos)<0.00001)
                    assert(length(river_bank_normal(basis[i],phase)-original[i].normal)<0.00001)
                    assert(basis[i].color==original[i].color)

test "shared reeds preserve the original taper and lighting at every height":
    basis:Vertex3D[]
    add_cylinder(basis,vec3(0,0,0),0.055,1.0,rgb(0.28,0.39,0.14),3,0.015)
    loop height in [0.4,1.4,1.9,2.4]:
        original:Vertex3D[]
        add_cylinder(original,vec3(0,0,0),0.055,height,rgb(0.28,0.39,0.14),3,0.015)
        phase=vec4(f32(height),0,2,1)
        loop i in 0..basis.len():
            assert(length(river_bank_point(basis[i],phase)-original[i].pos)<0.00001)
            assert(length(normalize(river_bank_normal(basis[i],phase))-original[i].normal)<0.00001)

test "indexed bank prototypes retain the exact ordered triangles":
    loop kind in 0..2:
        loop detail in [false,true]:
            basis:Vertex3D[]
            river_tree(basis,vec3(0,0,0),kind,0.0,detail,true)
            unique,indices=river_bank_indices(basis)
            assert(indices.len()==basis.len())
            assert(unique.len()*4<basis.len()*3)
            loop i in 0..basis.len():assert(unique[int(indices[i])]==basis[i])
