import 'scenarios_test.jo' as fixture
import '../src/living_checks.jo' as checks
import '../src/living_save.jo' as saves

test "64 against 64 has real conserved pilots and aircraft and survives saving":
    s=fixture.scenario_fixture(64)
    assert(s.battle.actors.len()==128)
    print("large engagement: {s.world.people.len()} people, {s.world.aircraft.len()} registered aircraft")
    assert(checks.invariant_errors(s.world).len()==0)
    assert(saves.validate_save_world(s.world)=="")
