# The town cats' memory of the player, and what a friendly cat does about it.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/cat_affinity_test.jo
use '../src/living_types.jo'
use '../src/cat_bonds.jo'
use '../src/cats.jo'

_flat_ground = (x: f64, z: f64) -> f64: 1.0

test "strokes and meals make a friend; a stroked-out cat gains less; fondness fades slowly":
    bonds: {int: CatBond}
    k = cat_key(120.3, -45.8)
    assert(cat_fondness(cat_bond(bonds, k), 0) == 0 and not cat_is_friend(bonds, k, 0))
    cat_stroke(bonds, k, 100)
    assert(cat_fondness(bonds[k], 100) == CAT_STROKE)
    # (four more strokes in the same hour: each worth two less, never under two)
    loop i in 0..4: cat_stroke(bonds, k, 101 + i)
    assert(cat_fondness(bonds[k], 104) == CAT_STROKE + 7 + 5 + 3 + 2)
    assert(cat_feed(bonds, k, 110))
    assert(not cat_feed(bonds, k, 200))                      # (not hungry again for eight hours)
    assert(not cat_hungry(bonds, k, 110 + CAT_HUNGRY_MINUTES - 1) and cat_hungry(bonds, k, 110 + CAT_HUNGRY_MINUTES))
    f = cat_fondness(bonds[k], 110)
    assert(f == CAT_STROKE + 17 + CAT_MEAL)
    # (a day away costs four points)
    assert(cat_fondness(bonds[k], 110 + 1440) == f - 4)
    # (an hour later strokes are worth their full value again; another meal makes a friend)
    cat_stroke(bonds, k, 110 + CAT_HUNGRY_MINUTES)
    assert(cat_feed(bonds, k, 110 + CAT_HUNGRY_MINUTES))
    assert(cat_is_friend(bonds, k, 110 + CAT_HUNGRY_MINUTES))
    # (forgotten after months: dropped from the list)
    prune_cat_bonds(bonds, 110 + CAT_HUNGRY_MINUTES + 360 * 101)
    assert(not (k in bonds))

test "a cat's key is its spot to the half metre, the same each time":
    assert(cat_key(10.0, 20.0) == cat_key(10.04, 19.97))
    assert(cat_key(10.0, 20.0) != cat_key(10.5, 20.0))
    assert(cat_key(-3000.2, 1.0) >= 0)
    # (spots a town apart, far out in the world, keep apart)
    seen: {int: bool}
    loop i in 0..40:
        k = cat_key(474.7 + f64(i % 8) * 3.1, -6320.7 - f64(i / 8) * 4.3)
        assert(not (k in seen))
        seen[k] = true

test "the bonds keep in the saved presentation state, and an older save reads as none":
    state = PresentationState()
    cat_stroke(state.cat_bonds, 77, 500)
    cat_feed(state.cat_bonds, 77, 500)
    back = from_text[PresentationState](to_text(state))
    assert(back is PresentationState)
    if back is PresentationState:
        assert(back.cat_bonds.get(77, CatBond()).fondness == CAT_STROKE + CAT_MEAL and back.cat_bonds[77].fed_minute == 500)
    old = from_text[PresentationState](to_text(PresentationState()).replace(", cat_bonds={{}}", ""))
    assert(old is PresentationState)
    if old is PresentationState: assert(old.cat_bonds.len() == 0)

test "a friend follows the player near its spot, waits by the moored aircraft, else goes home":
    home = vec3(0, 1, 0)
    c = Cat(5, home, 0.0, home, 0.0, 0)
    near = vec3(6, 1, 0)
    assert(cat_goal(c, true, near, true, none, vec3(0, 0, 0)).1)              # (follows)
    assert(not cat_goal(c, false, near, true, none, vec3(0, 0, 0)).1)         # (a stranger stays)
    anchor = vec3(20, 1, 0); craft = vec3(24, 0, 0)
    g = cat_goal(c, true, near, false, anchor, craft)                       # (the player aboard)
    assert(g.2 and length(g.0.xz - craft.xz) > 9.0 and length(g.0.xz - craft.xz) < 12.0)
    far = vec3(80, 1, 0)
    assert(length(cat_goal(c, true, far, true, none, craft).0 - home) < 0.001)  # (left behind: home)

test "a friendly cat walks over and follows; a stroke counts once it is done":
    s = CatScene()
    homes = [vec4(0, 1, 0, 0)]
    k = cat_key(0.0, 0.0)
    bonds: {int: CatBond} = {k: CatBond(fondness = 80, minute = 0)}
    player = vec3(8, 1, 0)
    loop i in 0..240: update_cats(s, homes, player, true, none, vec3(0, 0, 0), bonds, 10, _flat_ground, 1.0 / 30.0, f64(i) / 30.0)
    assert(s.cats.len() == 1 and s.cats[0].following)
    assert(length(s.cats[0].pos.xz - player.xz) < 1.6)
    # (stroked: the fondness grows when the stroke is done, and the card offers fish to a hungry cat)
    assert(nearest_cat(s, player) == 0)
    assert(cat_prompt(s, 0, bonds, 10, "fish") == "F  give the cat some fish" and cat_prompt(s, 0, bonds, 10, "") == "F  stroke the cat")
    cat_begin(s, 0, false, player)
    loop i in 0..30: update_cats(s, homes, player, true, none, vec3(0, 0, 0), bonds, 10, _flat_ground, 1.0 / 30.0, 8.0 + f64(i) / 30.0)
    assert(cat_busy(s) and bonds[k].fondness == 80)
    loop i in 0..120: update_cats(s, homes, player, true, none, vec3(0, 0, 0), bonds, 10, _flat_ground, 1.0 / 30.0, 9.0 + f64(i) / 30.0)
    assert(not cat_busy(s) and bonds[k].fondness == 80 + CAT_STROKE)
    # (the player steps a few metres at once, as off a boat: it still comes along)
    player = vec3(8, 1, 5)
    loop i in 0..240: update_cats(s, homes, player, true, none, vec3(0, 0, 0), bonds, 10, _flat_ground, 1.0 / 30.0, 14.0 + f64(i) / 30.0)
    assert(length(s.cats[0].pos.xz - player.xz) < 1.6)
    # (the player walks off far: it goes home, the way it came)
    away = vec3(60, 1, 0)
    loop i in 0..900: update_cats(s, homes, away, true, none, vec3(0, 0, 0), bonds, 10, _flat_ground, 1.0 / 30.0, 20.0 + f64(i) / 30.0)
    assert(not s.cats[0].following and length(s.cats[0].pos.xz) < 0.3)

test "a stranger becomes a friend through the scene, and says so once":
    s = CatScene()
    homes = [vec4(4, 1, 4, 0)]
    k = cat_key(4.0, 4.0)
    bonds: {int: CatBond} = {k: CatBond(fondness = 55, minute = 0)}
    player = vec3(4.5, 1, 4.5)
    update_cats(s, homes, player, true, none, vec3(0, 0, 0), bonds, 0, _flat_ground, 0.03, 0.0)
    cat_begin(s, 0, false, player)
    said = ""
    loop i in 0..200:
        w = update_cats(s, homes, player, true, none, vec3(0, 0, 0), bonds, 0, _flat_ground, 0.03, f64(i) * 0.03)
        if w != "": said = w
    assert(said == "The {cat_coat_name(s.cats[0].coat)} cat has taken to you")
