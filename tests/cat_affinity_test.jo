# The town cats' memory of the player, and what a friendly cat does about it.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/cat_affinity_test.jo
use '../src/living_types.jo'
use '../src/cat_bonds.jo'
use '../src/cats.jo'

_flat_ground = (x: f64, z: f64) -> f64: 1.0
_DAY = 1440

_on_foot = (p: vec3) -> CatPilot: CatPilot(pos = p, on_foot = true)

_step = (s: mut CatScene, homes: vec4[], me: CatPilot, bonds: mut {int: CatBond}, pet: mut CatCompanion, minute: int, t: f64, dt: f64 = 1.0 / 30.0) -> CatNews:
    update_cats(s, homes, me, CatCraft(), bonds, pet, minute, _flat_ground, dt, t)

test "strokes and meals build fondness; a stroked-out cat gains less; fondness fades slowly":
    bonds: {int: CatBond}
    k = cat_key(120.3, -45.8)
    bonds[k] = CatBond(temper = CAT_BOLD)
    assert(cat_fondness(cat_bond(bonds, k), 0) == 0 and not cat_is_friend(bonds, k, 0))
    cat_stroke(bonds, k, 100)
    assert(cat_fondness(bonds[k], 100) == CAT_STROKE)
    # (four more strokes in the same hour: each worth two less, never under two)
    loop i in 0..4: cat_stroke(bonds, k, 101 + i)
    assert(cat_fondness(bonds[k], 104) == CAT_STROKE + 7 + 5 + 3 + 2)
    assert(cat_feed(bonds, k, 110))
    assert(not cat_feed(bonds, k, 200))                      # (not hungry again for eight hours)
    assert(not cat_hungry(bonds, k, 110 + CAT_HUNGRY_MINUTES - 1) and cat_hungry(bonds, k, 110 + CAT_HUNGRY_MINUTES))
    # (a bold cat takes forty points from the player in a day at most)
    f = cat_fondness(bonds[k], 110)
    assert(f == 40)
    # (a day away costs four points)
    assert(cat_fondness(bonds[k], 110 + _DAY) == f - 4)
    # (forgotten after months: dropped from the list, unless it is the player's own)
    prune_cat_bonds(bonds, 110 + 360 * 101)
    assert(not (k in bonds))

test "trust comes over days, not at once, and slower for a wary cat":
    bonds: {int: CatBond}
    bold = 11; easy = 12; wary = 13
    bonds[bold] = CatBond(temper = CAT_BOLD); bonds[easy] = CatBond(temper = CAT_EASY); bonds[wary] = CatBond(temper = CAT_WARY)
    # (fed and stroked all through the first day: none recognises the player yet)
    loop key in [bold, easy, wary]:
        loop h in 0..2:
            m = 10 + h * (CAT_HUNGRY_MINUTES + 1)
            _ = cat_feed(bonds, key, m)
            loop i in 0..4: cat_stroke(bonds, key, m + 70 * i)
        assert(cat_stage(bonds, key, 860) == CAT_STRANGER)
    # (a meal and a stroke a day: the days each needs)
    known_on = fill(-1, 3)
    adopted_on = fill(-1, 3)
    keys = [bold, easy, wary]
    loop day in 1..12:
        loop j in 0..3:
            m = day * _DAY + 300
            _ = cat_feed(bonds, keys[j], m)
            cat_stroke(bonds, keys[j], m + 90)
            if known_on[j] < 0 and cat_stage(bonds, keys[j], m + 90) == CAT_KNOWS: known_on[j] = day
            if adopted_on[j] < 0 and cat_would_adopt(bonds, keys[j], m + 90): adopted_on[j] = day
    assert(known_on[0] >= 1 and known_on[0] <= known_on[1] and known_on[1] < known_on[2])
    assert(adopted_on[0] >= 4 and adopted_on[0] <= adopted_on[1] and adopted_on[1] < adopted_on[2])
    assert(adopted_on[2] <= 11)

test "a cat that recognises the player keeps doing so until it has faded far":
    bonds: {int: CatBond}
    k = 21
    bonds[k] = CatBond(temper = CAT_EASY)
    cat_set_stage(bonds, k, 1000, CAT_KNOWS)
    assert(cat_stage(bonds, k, 1000) == CAT_KNOWS)
    f = cat_fondness(bonds[k], 1000)
    # (under the first threshold after a few days, still known)
    later = 1000 + (f - CAT_FRIEND + 4) * CAT_FADE_MINUTES
    assert(cat_fondness(bonds[k], later) < CAT_FRIEND and cat_stage(bonds, k, later) == CAT_KNOWS)
    gone = 1000 + (f - CAT_FORGET + 1) * CAT_FADE_MINUTES
    assert(cat_stage(bonds, k, gone) == CAT_STRANGER)

test "at most one adopted cat; it stays his while fond, fades only when left alone":
    bonds: {int: CatBond}
    pet = CatCompanion()
    a = 31; b = 32
    cat_set_stage(bonds, a, 0, CAT_ADOPTED); cat_set_stage(bonds, b, 0, CAT_ADOPTED)
    assert(cat_would_adopt(bonds, a, 0) and cat_would_adopt(bonds, b, 0))
    assert(cat_adopt(pet, bonds, a, 2, vec3(1, 1, 1), 0))
    assert(not cat_adopt(pet, bonds, b, 3, vec3(2, 1, 2), 0))
    assert(pet.key == a and cat_stage(bonds, a, 0, true) == CAT_ADOPTED)
    # (with him for a fortnight: no fading at all)
    loop day in 0..15: _ = cat_companion_step(pet, bonds, day * _DAY)
    assert(cat_fondness(bonds[a], 14 * _DAY) == 100)
    # (left with someone for a fortnight: none either)
    assert(cat_leave_with(pet, 5, 2, vec3(3, 1, 3), 14 * _DAY))
    loop day in 14..29: _ = cat_companion_step(pet, bonds, day * _DAY)
    assert(cat_has(pet) and cat_fondness(bonds[a], 28 * _DAY) == 100)
    assert(not cat_collect(pet, 6, 28 * _DAY))                  # (only from whoever has it)
    assert(cat_collect(pet, 5, 28 * _DAY) and pet.with == CAT_WITH and pet.welcome.contains(5))
    # (left alone in a town: still his for a week, then it goes its own ways)
    cat_leave_alone(pet, vec3(9, 1, 9), 28 * _DAY)
    released = -1
    loop day in 28..50:
        if released < 0 and cat_companion_step(pet, bonds, day * _DAY): released = day
    assert(released >= 28 + 7 and released <= 28 + 9)
    assert(not cat_has(pet) and cat_stage(bonds, a, released * _DAY) == CAT_KNOWS)
    # (now another may adopt him)
    assert(cat_adopt(pet, bonds, b, 3, vec3(2, 1, 2), 50 * _DAY) and pet.key == b)

test "a cat's key is its spot to the half metre, the same each time":
    assert(cat_key(10.0, 20.0) == cat_key(10.04, 19.97))
    assert(cat_key(10.0, 20.0) != cat_key(10.5, 20.0))
    assert(cat_key(-3000.2, 1.0) >= 0)
    # (spots a town apart, far out in the world, keep apart)
    seen: {int: bool}
    loop i in 0..40:
        k = cat_key(474.7 + f64(i % 8) * 3.1, -6320.7 - f64(i / 8) * 4.3)
        assert(not (k in seen))
        seen[k] = true

test "tempers spread over the cats, and names suit the cat":
    counts = fill(0, 3)
    loop i in 0..300: counts[cat_own_temper(cat_key(f64(i) * 3.7, f64(i % 17) * 11.3))] += 1
    assert(counts[0] > 50 and counts[1] > 80 and counts[2] > 50)
    pet = CatCompanion(key = 4242, coat = 0, he = true)
    names = cat_name_choices(pet)
    assert(names.len() == 3 and names[0] == "Kanellos" and names[1] != names[2])
    assert(cat_called(pet) == "the cat")
    pet.name = names[2]
    assert(cat_called(pet) == names[2])

test "the bonds and the adopted cat keep in the saved presentation state; an older save reads as none":
    state = PresentationState()
    state.cat_bonds[77] = CatBond(temper = CAT_BOLD)
    cat_stroke(state.cat_bonds, 77, 500)
    _ = cat_feed(state.cat_bonds, 77, 500)
    _ = cat_adopt(state.cat, state.cat_bonds, 77, 4, vec3(5, 2, -7), 500)
    state.cat.name = "Pipitsa"
    _ = cat_leave_with(state.cat, 9, 3, vec3(6, 2, -7), 600)
    back = from_text[PresentationState](to_text(state))
    assert(back is PresentationState)
    if back is PresentationState:
        b = back.cat_bonds.get(77, CatBond())
        assert(b.fondness == CAT_STROKE + CAT_MEAL and b.fed_minute == 500 and b.days == 1 and b.temper == CAT_BOLD)
        assert(back.cat.key == 77 and back.cat.name == "Pipitsa" and back.cat.with == CAT_KEPT and back.cat.keeper == 9 and back.cat.welcome == [9])
        assert(length(back.cat.at - vec3(6, 2, -7)) < 0.001 and length(back.cat.home - vec3(5, 2, -7)) < 0.001)
    old = from_text[PresentationState](to_text(PresentationState()).replace(", cat_bonds={{}}", ""))
    assert(old is PresentationState)
    if old is PresentationState: assert(old.cat_bonds.len() == 0 and old.cat.key == -1)

test "a friend follows the player near its spot, waits by the moored aircraft, else goes home":
    home = vec3(0, 1, 0)
    c = Cat(5, home, 0.0, home, 0.0, 0)
    near = vec3(6, 1, 0)
    assert(cat_goal(c, true, near, true, none, vec3(0, 0, 0)).1)              # (follows)
    assert(not cat_goal(c, false, near, true, none, vec3(0, 0, 0)).1)         # (a stranger stays)
    anchor = vec3(20, 1, 0); craft = vec3(24, 0, 0)
    g = cat_goal(c, true, near, false, anchor, craft)                       # (the player aboard)
    assert(g.2 and length(g.0.xz - craft.xz) > 9.0 and length(g.0.xz - craft.xz) < 12.0)
    far = vec3(80, 1, 0)
    assert(length(cat_goal(c, true, far, true, none, craft).0 - home) < 0.001)  # (left behind: home)

test "a friendly cat walks over, rubs round his legs and follows; a stroke counts once it is done":
    s = CatScene()
    homes = [vec4(0, 1, 0, 0)]
    k = cat_key(0.0, 0.0)
    bonds: {int: CatBond} = {k: CatBond(fondness = 80, minute = 0, known = true, days = 3)}
    pet = CatCompanion()
    player = vec3(8, 1, 0)
    rubbed = false
    loop i in 0..300:
        _ = _step(s, homes, _on_foot(player), bonds, pet, 10, f64(i) / 30.0)
        if s.cats[0].rub > 0.0: rubbed = true
    assert(s.cats.len() == 1 and s.cats[0].following and rubbed)
    assert(length(s.cats[0].pos.xz - player.xz) < 1.6)
    # (stroked: the fondness grows when the stroke is done, and the card offers fish to a hungry cat)
    assert(nearest_cat(s, player) == 0)
    assert(cat_prompt(s, 0, bonds, 10, "fish") == "F  give the cat some fish" and cat_prompt(s, 0, bonds, 10, "") == "F  stroke the cat")
    cat_begin(s, 0, false, player)
    loop i in 0..30: _ = _step(s, homes, _on_foot(player), bonds, pet, 10, 10.0 + f64(i) / 30.0)
    assert(cat_busy(s) and bonds[k].fondness == 80)
    loop i in 0..120: _ = _step(s, homes, _on_foot(player), bonds, pet, 10, 11.0 + f64(i) / 30.0)
    assert(not cat_busy(s) and bonds[k].fondness == 80 + CAT_STROKE)
    # (the player steps a few metres at once, as off a boat: it still comes along)
    player = vec3(8, 1, 5)
    loop i in 0..240: _ = _step(s, homes, _on_foot(player), bonds, pet, 10, 16.0 + f64(i) / 30.0)
    assert(length(s.cats[0].pos.xz - player.xz) < 1.6)
    # (the player walks off far: it goes home, the way it came)
    away = vec3(60, 1, 0)
    loop i in 0..900: _ = _step(s, homes, _on_foot(away), bonds, pet, 10, 30.0 + f64(i) / 30.0)
    assert(not s.cats[0].following and length(s.cats[0].pos.xz) < 0.3)

test "a stranger becomes a friend through the scene, and says so once":
    s = CatScene()
    homes = [vec4(4, 1, 4, 0)]
    k = cat_key(4.0, 4.0)
    bonds: {int: CatBond} = {k: CatBond(fondness = 55, minute = 0, days = 3, temper = CAT_EASY)}
    pet = CatCompanion()
    player = vec3(4.5, 1, 4.5)
    _ = _step(s, homes, _on_foot(player), bonds, pet, 0, 0.0, 0.03)
    cat_begin(s, 0, false, player)
    said = ""
    loop i in 0..200:
        w = _step(s, homes, _on_foot(player), bonds, pet, 0, f64(i) * 0.03, 0.03)
        if w.said != "": said = w.said
    assert(said == "The {cat_coat_name(s.cats[0].coat)} cat has taken to you")

test "a wary stranger keeps out of reach, but creeps up to food held out, and eats":
    s = CatScene()
    homes = [vec4(0, 1, 0, 0)]
    k = cat_key(0.0, 0.0)
    bonds: {int: CatBond} = {k: CatBond(temper = CAT_WARY)}
    pet = CatCompanion()
    _ = _step(s, homes, _on_foot(vec3(10, 1, 0)), bonds, pet, 10, 0.0)
    assert(s.cats[0].temper == CAT_WARY)
    # (he walks up to it: it moves off, and won't be stroked)
    near = vec3(1.2, 1, 0)
    loop i in 0..150: _ = _step(s, homes, _on_foot(near), bonds, pet, 10, f64(i) / 30.0)
    assert(f64(length(s.cats[0].pos.xz - near.xz)) > CAT_SHY - 0.3)
    assert(cat_prompt(s, 0, bonds, 10, "") == "" and cat_prompt(s, 0, bonds, 10, "fish") == "F  give the cat some fish")
    # (he crouches and holds a fish out: it comes, slowly, and only then does the meal begin)
    cat_begin(s, 0, true, near)
    loop i in 0..30: _ = _step(s, homes, _on_foot(near), bonds, pet, 10, 5.0 + f64(i) / 30.0)
    assert(cat_food_held(s) and s.timer == 0.0)
    took = 0.0
    loop i in 0..900:
        _ = _step(s, homes, _on_foot(near), bonds, pet, 10, 6.0 + f64(i) / 30.0)
        if took == 0.0 and not cat_food_held(s): took = f64(i) / 30.0
        if not cat_busy(s): break
    assert(took > 2.0 and not cat_busy(s))
    assert(bonds[k].fondness == min(CAT_MEAL, cat_day_most(CAT_WARY)) and bonds[k].days == 1)
