use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_war_types.jo'
use '../src/living_far_orders.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_checks.jo'
use '../src/living_convoys.jo'
use '../src/living_war.jo'
use '../src/living_war_checks.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

convoy_fixture = () -> World:
    w=commission_fixture()
    w.far.links[0].mode=.ship
    w.far.links[0].points=[vec3(100,0,0),vec3(2100,0,0)]; w.far.links[0].length_mm=2000000
    w.place_contexts[200].center=vec3(2100,0,0)
    w.far.vehicles[0].kind=.ship; w.far.vehicles[0].speed_mm_sec=6500
    unit=war_charter(w,0,1); assert(unit==0); war_supply(w,unit)
    # A second existing fixture hull has a funded account and three actual local workers.
    account=new_account(w,"convoy-merchant")
    assert(transfer(w,w.far.districts[100].household_account,account,30000,.trade))
    w.far.districts[100].workers[1]-=3; w.far.crew_population[1]+=3
    w.far.vehicles.push(FarVehicle(2,.ship,100,100,1,account,-1,crew=[0,3,0],route=0,pos=vec3(100,0,0),capacity_grams=30000000,speed_mm_sec=6500,service_agreement=true))
    w.far.districts[200].target[3]+=20000
    w.far.vehicles[2].buying_order=counter_restock_order(w,2,200)
    assert(far_depart(w,2) and w.far.journeys[w.far.vehicles[2].journey].quantity>0)
    w

test "a paid convoy binds the original ships once follows behind without catch-up and completes at their real port":
    w=convoy_fixture(); people=w.people.len(); population=far_population(w); stock=stock_totals(w); roots=w.next_cargo_source
    money=w.accounts[w.far.vehicles[2].account].cents
    assert(form_convoy(w,0,2) and not form_convoy(w,0,2))
    assert(w.accounts[w.far.vehicles[2].account].cents==money-600)
    assert(w.far.vehicles.len()==3 and w.people.len()==people and far_population(w)==population)
    assert(stock_totals(w)==stock and w.next_cargo_source==roots)
    group=w.war.units[0].convoy!
    w.tick+=1860; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    escort=w.far.vehicles[0].pos; merchant=w.far.vehicles[2].pos
    assert(abs(f64(length(merchant-escort))-150.0)<0.01)
    assert(validate_save_world(w)=="",validate_save_world(w))
    far_advance_transport(w,w.tick); assert(w.far.vehicles[0].pos==escort)
    # A large catch-up while the merchant is stopped cannot pass through its hull.
    w.far.journeys[group.voyage].hold_until_tick=w.tick+6000
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].pos==escort and w.far.vehicles[2].pos==merchant)
    # Scene ownership of one body still advances just its own saved interval.
    w.far.vehicles[0].scene_owned=true
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].pos==escort)
    far_advance_transport(w,w.tick,0,true)
    assert(abs(f64(length(w.far.vehicles[2].pos-w.far.vehicles[0].pos))-150.0)<0.01)
    w.far.vehicles[0].scene_owned=false
    text=canonical_text(w); restored=from_text[World](text); assert(restored is World)
    assert(canonical_text(restored)==text)
    # This fixture then advances only shipping; the full-world replay advances the core
    # scheduled people too. Their intentionally unadvanced actions are not a convoy fault.
    assert(validate_far(restored)=="",validate_far(restored))
    assert(validate_war(restored)=="",validate_war(restored))
    w.tick+=50000; w.minute=w.tick/120; far_advance_transport(w,w.tick); convoys_minute(w)
    assert(w.far.vehicles[0].place==200 and w.far.vehicles[2].place==200)
    assert(w.war.units[0].convoy==none and w.war.convoys_formed==1 and w.war.convoys_delivered==1)
    assert(far_population(w)==population and money_balances(w) and goods_balance(w) and validate_war(w)=="")

test "a disabled escort releases its following constraint without deleting the merchant's goods crew or actual journey":
    w=convoy_fixture(); assert(form_convoy(w,0,2))
    group=w.war.units[0].convoy!; goods=w.far.vehicles[2].cargo; population=far_population(w)
    w.far.vehicles[0].hull=350; convoys_minute(w)
    assert(w.war.units[0].convoy==none and w.far.journeys[group.escort_voyage].follow_vehicle== -1)
    assert(w.far.vehicles[2].cargo==goods and w.far.vehicles[2].journey==group.voyage and far_population(w)==population)
    assert(w.war.convoys_delivered==0 and money_balances(w) and goods_balance(w))

test "a remote or unfunded merchant cannot hire a charter and refusals leave all ownership unchanged":
    w=convoy_fixture(); at=w.far.vehicles[2].pos
    w.far.vehicles[2].pos+=vec3(2000,0,0); before=canonical_text(w)
    assert(not form_convoy(w,0,2) and canonical_text(w)==before)
    w.far.vehicles[2].pos=at; account=w.far.vehicles[2].account
    assert(transfer(w,account,w.far.districts[100].household_account,w.accounts[account].cents,.trade))
    before=canonical_text(w)
    assert(not form_convoy(w,0,2) and canonical_text(w)==before)
