use '../src/voice_text.jo'
use '../src/voice_synth.jo'
use '../src/radio_synth.jo'
use '../src/radio.jo'

bank = voice_load()

test "announcer tables load and cover the phone set":
    assert(bank.ready and bank.phones.len() == 40 and bank.phones[0] == "pau")
    assert(bank.units.len() > 500 and bank.words.len() > 2000 and bank.rules.len() > 100)
    assert(bank.frames.len() == bank.units.len()*2*bank.half*bank.width)
    # every phone can start and end a phrase
    np = bank.phones.len()
    loop p in 1..np:
        f, _, _ = voice_half(bank,VOICE_PAU,p,1)
        g, _, _ = voice_half(bank,p,VOICE_PAU,0)
        assert(f >= 0 and g >= 0)
    loop v in bank.frames: assert(not is_nan(f64(v)) and abs(f64(v)) < 100.0)

test "numbers, clock times and punctuation become words":
    assert(voice_tokens("At 09:05, 7.5 metres; -3 degrees.") == ["at","nine","oh","five",",","seven","point","five","metres",";","minus","three","degrees","."])
    assert(voice_tokens("12:00 1941") == ["twelve","o'clock","one","thousand","nine","hundred","and","forty","one"])
    assert(voice_number(115) == "one hundred and fifteen")
    long = "word "*1000
    assert(voice_tokens(long).len() == VOICE_MAX_WORDS)

test "pronunciation: dictionary, plural and possessive stems, then rules":
    harbor = bank.words["harbor"]
    assert(voice_pronounce(bank,"harbors") == harbor+[38])
    assert(voice_pronounce(bank,"harbor's") == harbor+[38])
    # an invented name falls back to the letter rules, with one primary stress
    name = voice_pronounce(bank,"thalvery")
    stressed = 0
    loop p in name:
        if p >> 6 == 1: stressed += 1
    assert(name.len() >= 6 and stressed == 1)

test "a plan has positive durations, finite frames and voiced pitch in the narrator's range":
    plan = voice_plan(bank,"Good evening. Here is the weather for the islands.",VoiceStyle(coda=1.3),3)
    assert(plan.count > 400 and plan.count < 1000)
    loop p in plan.phones: assert(p.duration > 0)
    voiced = 0
    loop f in plan.f0:
        if f > 0:
            voiced += 1
            assert(f > 100 and f < 400)
    assert(voiced > plan.count/3)
    again = voice_plan(bank,"Good evening. Here is the weather for the islands.",VoiceStyle(coda=1.3),3)
    assert(again.frames == plan.frames and again.f0 == plan.f0)

test "the vocoder is bounded, deterministic and independent of how the stream is cut":
    plan = voice_plan(bank,"Ships should keep the marked channels clear.",VoiceStyle(),1)
    a = make_voice_synth(bank); b = make_voice_synth(bank)
    voice_start(a,plan,0,1); voice_start(b,plan,0,1)
    whole: f64[]
    cut: f64[]
    loop not voice_done(a): whole += voice_render(a,800)
    loop not voice_done(b):
        cut += voice_render(b,317)
        cut += voice_render(b,483)
    n = plan.count*VOICE_HOP
    assert(whole.len() >= n and cut.len() >= n)
    loop i in 0..n: assert(whole[i] == cut[i])
    loop i in n..whole.len(): assert(whole[i] == 0.0)
    energy = 0.0
    loop v in whole:
        assert(not is_nan(v) and abs(v) < 4.0)
        energy += v*v
    assert(energy/f64(whole.len()) > 0.0005)

test "a spoken bulletin repeats on the world clock through the receiver":
    s = make_radio_synth()
    radio_synth_program(s,.speech,3,100.0,[],"Weather at Kalamos: fair conditions.",VoiceStyle(),10.0)
    assert(s.speech_period >= 10*RADIO_RATE and s.speech_period%(10*RADIO_RATE) == 0)
    energy = 0.0
    loop k in 0..40:
        x = radio_render(s,800,1.0,0.0)
        assert(x.len() == 800)
        loop v in x:
            assert(abs(v) <= 0.95)
            energy += f64(v)*f64(v)
    assert(energy > 0.5)
    # the same moment rendered from a fresh programme matches a continuous one
    a = make_radio_synth(); b = make_radio_synth()
    radio_synth_program(a,.speech,3,50.0,[],"Weather at Kalamos: fair conditions.",VoiceStyle(),10.0)
    radio_synth_program(b,.speech,3,50.0,[],"Weather at Kalamos: fair conditions.",VoiceStyle(),10.0)
    loop k in 0..10:
        whole = radio_render(a,800,0.5,2)
        left = radio_render(b,317,0.5,2); right = radio_render(b,483,0.5,2)
        assert(whole == left+right)

test "which programmes are read aloud":
    assert(radio_spoken(0,.news) and radio_spoken(4,.weather) and radio_spoken(5,.quiz))
    assert(not radio_spoken(4,.shipping) and not radio_spoken(1,.music) and not radio_spoken(2,.off_air))
