use 'living_far_economy.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_stock.jo'
use '../src/living_types.jo'
use '../src/living_money.jo'
use '../src/living_war.jo'
use '../src/living_far_orders.jo'

keep_rations = (w: mut World, vehicle: int, qty: int, shelf: int = 0):
    v=w.far.vehicles[vehicle]
    batch=far_take_market(w,v.place,3,qty)
    assert(far_stock_add(w.far.vehicles[vehicle].provisions,batch))
    rest=far_market_qty(w,v.place,3)-shelf
    if rest>0: far_use(w,far_take_market(w,v.place,3,rest))

test "a crew's actual leg ration permits departure when the preferred safety refill is unavailable":
    w=far_fixture(); keep_rations(w,0,28)
    before=stock_totals(w); cash=w.accounts[w.far.vehicles[0].account].cents
    assert(far_leg_rations(w,0)==28 and far_provision(w,0))
    assert(w.far.vehicles[0].provisions.qty[3]==28)
    assert(stock_totals(w)==before and w.accounts[w.far.vehicles[0].account].cents==cash)
    assert(far_depart(w,0))
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==200)
    assert(money_balances(w) and goods_balance(w))

test "a paid partial purchase must cover the entire leg while a genuinely underfed crew still waits":
    w=far_fixture(); keep_rations(w,0,20,8)
    before=stock_totals(w); cash=w.accounts[w.far.vehicles[0].account].cents
    assert(far_provision(w,0) and w.far.vehicles[0].provisions.qty[3]==28)
    assert(far_market_qty(w,100,3)==0 and w.accounts[w.far.vehicles[0].account].cents<cash)
    assert(stock_totals(w)==before and money_balances(w) and goods_balance(w))
    short=far_fixture(); keep_rations(short,0,20,7)
    before=stock_totals(short); cash=short.accounts[short.far.vehicles[0].account].cents
    assert(not far_provision(short,0))
    assert(short.far.vehicles[0].provisions.qty[3]==20 and far_market_qty(short,100,3)==7)
    assert(stock_totals(short)==before and short.accounts[short.far.vehicles[0].account].cents==cash)

test "long passages count real local midnight meals and rescued passengers in the required food":
    w=far_fixture()
    w.far.links[0].length_mm=w.far.vehicles[0].speed_mm_sec*2*1440*2
    assert(far_leg_rations(w,0)==84) # today's unpaid meal and two future midnights
    w.far.vehicles[0].last_meal_day=day_index(w.minute)
    assert(far_leg_rations(w,0)==56)
    w.far.vehicles[0].passengers=[w.player]
    assert(far_leg_rations(w,0)==112)
    keep_rations(w,0,111)
    assert(not far_provision(w,0))
    # Emergency purchase remains an explicit risk; it does not invent the missing meal.
    assert(not far_provision(w,0,true) and w.far.vehicles[0].provisions.qty[3]==111)

test "an actual supplied patrol can start a short order with owned rations below its preferred reserve":
    w=far_fixture(); unit=war_charter(w,0,1); assert(unit>=0)
    crew=far_aboard_count(w,0); keep_rations(w,0,crew*28)
    war_supply(w,unit)
    assert(w.war.units[unit].supplied_until>=w.minute)
    assert(issue_war_order(w,unit,.patrol,200)>=0)
    before=stock_totals(w); war_orders(w)
    assert(w.far.vehicles[0].journey>=0 and stock_totals(w)==before)
    assert(money_balances(w) and goods_balance(w))

test "a paid ration refill and a freight sale cannot withdraw the same grain twice":
    w=far_fixture()
    # A real six-person crew and six-day route: the counter can cover the crossing,
    # but not both the preferred eight-day reserve and its earlier tentative sale.
    w.far.districts[100].workers[1]-=5; w.far.crew_population[1]+=5
    w.far.vehicles[0].crew[1]+=5
    span=w.far.vehicles[0].speed_mm_sec*2*1440*6
    w.far.links[0].length_mm=span
    w.far.links[0].points=[vec3(100,0,0),vec3(f32(100+f64(span)/1000.0),0,0)]
    w.far.districts[100].target[3]=1000
    extra=far_market_qty(w,100,3)-1250
    far_use(w,far_take_market(w,100,3,extra))
    w.far.districts[200].target[3]+=20000
    w.far.vehicles[0].buying_order=counter_restock_order(w,0,200)
    before=stock_totals(w); roots=w.next_cargo_source
    assert(not far_depart(w,0))
    assert(w.far.vehicles[0].journey<0 and w.far.vehicles[0].provisions.qty[3]==1250)
    assert(far_market_qty(w,100,3)==0 and stock_totals(w)==before and w.next_cargo_source==roots)
    w.minute+=30; w.tick=w.minute*120
    assert(far_depart(w,0) and w.far.journeys[w.far.vehicles[0].journey].survey)
    assert(stock_totals(w)==before and money_balances(w) and goods_balance(w))
