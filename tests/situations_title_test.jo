import '../src/cargo_scene.jo' as cargo
use '../src/traffic.jo'

# Every Situation, launched as the title launches one (draw_title_screen: load_scenario before
# title_begin), while the title still defers the new game's far economy, and again after the
# title's own deferred opening has run to its end on the startup's world. Each must be whole.
situations_world = () -> Town[]:
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    towns

check_situation = (key: str, s: ScenarioState):
    # (the start's far economy is made in play a few seconds in, as ever; the set pieces have theirs)
    if key != "start": assert(s.world.far.populated and s.world.far.harbors.len() > 0,"{key}: the far economy is missing")
    if key == "strait":
        assert(s.battle.actors.len() == 16,"strait: {s.battle.actors.len()} aircraft")
        assert(s.battle.homes.len() == 2,"strait: {s.battle.homes.len()} home harbours")

test "every Situation launches from the title, before and after the title's deferred far economy":
    towns=situations_world()
    models=build_craft_models()
    # (the title is showing: the new game's far economy is put off, a few ms a frame)
    set_far_opening_deferred(true)
    loop sc in SCENARIOS:
        s=build_scenario(sc.key,towns,models)
        assert(s != none,"{sc.key} did not build")
        check_situation(sc.key,s!)
        # (the title's deferral is the title's: a Situation leaves it as it found it)
        assert(daily_far_deferred())
    # (the startup's world, as the title prepares it: the registry finished, the world built with
    # its far economy put off, which is then made behind the title to the end)
    finish_settlement_registry()
    w=life.build_world(u64(0),harbors_from_towns(towns))
    cargo.configure_cargo_scene(w,towns)
    venues.configure_life_scene(w,towns)
    assert(not w.far.populated)
    far_opening_begin(w)
    loop far_opening_pending():
        if far_opening_advance(1.0e30): break
    made=far_opening_take()
    assert(made.far.populated)
    loop sc in SCENARIOS:
        s=build_scenario(sc.key,towns,models)
        assert(s != none,"{sc.key} did not build after the title's far economy")
        check_situation(sc.key,s!)
    set_far_opening_deferred(false)

test "the Situations page lists every situation but the start, each with a name":
    shown=[loop s in SCENARIOS: if s.key != "start": s]
    assert(shown.len() == SCENARIOS.len()-1)
    loop s in shown: assert(s.name != "" and s.description != "","situation {s.key} has no name")
