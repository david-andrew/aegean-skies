use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_weather.jo'
use '../src/living_travel.jo'
use '../src/living_conditions.jo'

test "closures expire and full docks use buoy with no overlap":
    w = build_world()
    w.weather.push(Weather(id=100,kind=.storm,center=vec2(0,0),radius_m=1000000,severity=1000,born_minute=0,expires_minute=180))
    advance_minutes(w,3)
    loop p in w.places: assert(p.harbor_closed)
    assert(not travel_feasible(w,9,1))
    advance_minutes(w,210)
    loop p in w.places: assert(not p.harbor_closed)
    assert(money_balances(w) and goods_balance(w))

test "offscreen ditch keeps one owner salvage rescue and bill":
    w = build_world()
    w.aircraft[1].fuel_ml = 0
    w.goods_ledger.opening = stock_totals(w)
    advance_minutes(w,1)
    assert(w.aftermath.len() == 1 and w.aircraft[1].state == .ditched)
    id = ditch(w,1,w.trips[0].reason)
    assert(ditch(w,1,w.trips[0].reason) == id and w.aftermath.len() == 1)
    assert(w.aftermath[id].pos.y == 0 and w.aircraft[1].cargo == Inventory())
    advance_minutes(w,200)
    assert(w.people[2].place >= 0 and w.people[2].injured_until > w.minute)
    assert(w.rescues.len() == 1 and w.rescues[0].billed)
    assert(w.aircraft[1].fuel_ml == 0 and w.aircraft[1].state == .ditched)
    assert(money_balances(w) and goods_balance(w))

test "pending incident is stored not rerolled and scenes own their fuel":
    w = build_world()
    w.trips[0].incident_at_mm = 120000
    advance_minutes(w,2)
    assert(w.trips[0].incident_resolved and w.aftermath.len() == 1)
    at = w.trips[0].incident_at_mm
    advance_minutes(w,10)
    assert(w.trips[0].incident_at_mm == at and w.aftermath.len() == 1)
    b = build_world()
    b.aircraft[1].move_owner = .scene
    fuel = b.aircraft[1].fuel_ml; pos = b.aircraft[1].pose
    advance_minutes(b,20)
    assert(b.aircraft[1].fuel_ml == fuel and b.aircraft[1].pose == pos)
