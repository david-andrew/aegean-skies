# Offshore moorings for the big boats (src/offshore_moorings.jo): every one found is in deep, clear
# water with a launch run from a dock; the same every time; open water found where needed.
# (All 318 sea harbours: tests/world_audit_test.jo, and tools/mooring_survey.jo for the report.)
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/offshore_moorings.jo'
from '../src/planes.jo' import Craft
from '../src/aircraft_boats.jo' import swing_radius

_world = ():
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()

test "the authored harbours and a spread of generated ones have clear moorings for the H-4 and Do X":
    _world()
    harbours: int[] = [0, 1, 2, 3, 4, 5]
    k = 0
    loop s in world_settlements:
        if s.legacy >= 0 or s.harbor.len() == 0 or abs(f64(s.harbor[0].at.y)) > 0.5: continue
        if k % 40 == 0: harbours.push(s.id)
        k += 1
    loop place in harbours:
        loop kind in [Craft.hughes_h4, Craft.dornier_dox]:
            ms = offshore_moorings(place, swing_radius(kind))
            assert(ms.len() >= 1, "no mooring for {kind} at {place}")
            loop m in ms:
                assert(verify_mooring(m) == "", "{kind} at {place}: {verify_mooring(m)}")
                assert(abs(f64(m.at.y)) < 0.01 and f64(length(m.at.xz - m.dock.xz)) < MOORING_REACH)
                assert(m.dock in harbour_docks(place))
            loop i in 0..ms.len():
                loop j in i + 1..ms.len(): assert(f64(length(ms[i].at - ms[j].at)) >= ms[i].radius * 2.0 + 20.0)

test "moorings are the same every time":
    _world()
    a = offshore_moorings(2, swing_radius(Craft.short_sarafand))
    mooring_cache = {}
    b = offshore_moorings(2, swing_radius(Craft.short_sarafand))
    assert(a.len() == b.len())
    loop i in 0..a.len(): assert(a[i].at == b[i].at and a[i].dock == b[i].dock)

test "open water is found off a harbour, and none on land":
    _world()
    dock = harbour_docks(0)[0]
    c = clear_water_near(dock.xz, swing_radius(Craft.hughes_h4))
    assert(c != none)
    assert(f64(length(c! - dock.xz)) > swing_radius(Craft.hughes_h4))
    assert(nearest_harbour(dock.xz) == 0)
    assert(offshore_moorings(-5, 50.0).len() == 0)

test "a moored aircraft swings head to wind and stays on its swing circle":
    buoy = vec3(100, 0, -40)
    loop len in [16.75, 40.0, 66.65]:
        wind = vec2(0.6, 0.8)
        target = wind_heading(wind)
        h = target + 2.0; rate = 0.0
        far = 0.0
        loop i in 0..60 * 120:
            s = buoy_swing(h, rate, wind, 8.0, len, 1.0 / 60.0)
            h = s.0; rate = s.1
            c = moored_centre(buoy, h, len)
            far = max(far, abs(f64(length((c - buoy).xz)) - (len * 0.5 + 4.0)))
            assert(abs(rate) <= 0.12)
        off = atan2(sin(target - h), cos(target - h))
        print("length {len}: off the wind {off:.4} rad after 2 min")
        assert(abs(off) < 0.02 and far < 0.001)
        # (nose into the wind: the aircraft's nose points the way the wind comes from)
        nose = vec2(f32(sin(h)), f32(-cos(h)))
        assert(f64(dot(nose, wind)) < -0.99)
    # (a calm: it lies as it is)
    s = buoy_swing(1.0, 0.0, vec2(1, 0), 0.3, 40.0, 1.0)
    assert(abs(s.0 - 1.0) < 0.000001)
