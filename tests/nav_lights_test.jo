# Navigation lights: dark-only, red to port and green to starboard on aircraft and vessels.
use '../src/nav_lights.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/vessel_types.jo'

test "navigation lights are off by day and full by night":
    assert(nav_light_level(0.9) == 0.0 and nav_light_level(0.2) == 0.0)
    assert(nav_light_level(-0.3) == 1.0)
    assert(nav_light_level(0.0) > 0.2 and nav_light_level(0.0) < 0.8)

test "aircraft lamps: red on the port tip, green on the starboard, white at the tail":
    loop id in 0..CRAFT_NAMES.len():
        kind = Craft(id)
        model = build_craft(kind,LIVERIES[0]); spec = craft_spec(kind,model.contacts)
        p = nav_craft_points(spec,kind)
        # (+x is starboard for aircraft: forward is -z)
        assert(p[0].x < -1.0 and p[1].x > 1.0,"{CRAFT_NAMES[id]} tips {p[0]} {p[1]}")
        assert(abs(p[0].x+p[1].x) < 0.5)
        assert(p[2].z > 1.0 and abs(p[2].x) < 0.01)
        # On the drawn wing: the outermost wing contact, height included.
        loop c in spec.wing_contacts: assert(abs(c.x) <= abs(p[1].x)-0.11)
        if spec.wing_contacts.len() > 0: assert(p[1].y != 0.0 or spec.wing_contacts.any((c: vec3): c.y == 0.0))

test "ships show red to port and green to starboard underway, one white lamp when still":
    v = Vessel(kind=.coastal_steamer,yaw=0.0,status=.underway)
    lamps = nav_vessel_offsets(v)
    assert(lamps.len() == 3)
    loop lamp in lamps:
        # Bow +z: port is +x.
        if lamp.1 == NAV_RED: assert(lamp.0.x > 0.0)
        if lamp.1 == NAV_GREEN: assert(lamp.0.x < 0.0)
        if lamp.1 == NAV_WHITE: assert(lamp.0.z < 0.0)
    v.status = .anchored
    assert(nav_vessel_offsets(v).len() == 1)
    small = Vessel(kind=.canal_launch,yaw=1.0,status=.underway)
    assert(nav_vessel_offsets(small).len() == 1)
    v.status = .sunk
    assert(nav_vessel_offsets(v).len() == 0)
