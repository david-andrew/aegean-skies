session_fixture = () -> (World,GameSession,SceneAdapter):
    w=build_world(u64(42)); c=w.people[w.player].craft
    w.aircraft[c].model_index=0
    flyer=make_flyer(.gull,0,[],w.aircraft[c].pose.pos,0)
    flyer.state.fuel=f64(w.aircraft[c].fuel_ml)/1000
    flyer.state.position=w.aircraft[c].pose.pos
    adapter=SceneAdapter(); bind_living_player(flyer,w,adapter)
    session=GameSession(flyer=flyer,player_position=w.people[w.player].pose.pos,player_point=world_point(w.people[w.player].pose.pos),world_time=12.25,accumulator=0.004)
    (w,session,adapter)

test "complete checkpoint roundtrips player physics cats and clock without releasing the live lease":
    f=session_fixture(); w=f.0; session=f.1; adapter=f.2
    c=w.people[w.player].craft
    w.people[w.player].move_owner=.scene
    session.leisure.sitting="hotel";session.leisure.strong=[w.minute]
    session.leisure_spent=125;session.leisure_had=["A glass of wine"]
    before=canonical_text(w)
    p=PresentationState(); p.cat_bonds[7]=CatBond(fondness=450,strokes=3)
    p.battle_cards[8]=true
    game=capture_game(w,p,session,[],adapter,VesselFleet(),Battle(),123,SaveSummary(minute=w.minute,place_name="Porto Vecchio"))
    assert(game is SaveGame)
    assert(canonical_text(w)==before and scene_bound(adapter,c))
    assert(game.world.aircraft[c].move_owner==.abstract_world)
    packed=pack_binary_living_save(game); restored=unpack_binary_living_save(packed.0,packed.1)
    assert(restored!=none and canonical_text(restored!.world)==canonical_text(game.world))
    runtime=read_game_session(restored!)
    assert(runtime is GameSession and to_text(runtime)==game.session)
    assert(restored!.presentation.cat_bonds[7].fondness==450 and restored!.presentation.battle_cards[8])
    assert(runtime.flyer.state.fuel==session.flyer.state.fuel and runtime.accumulator==0.004)
    assert(restored!.summary.place_name=="Porto Vecchio")
    assert(runtime.leisure.sitting=="hotel" and runtime.leisure.strong==[w.minute] and runtime.leisure_spent==125 and runtime.leisure_had==["A glass of wine"])

test "corrupt session cannot restore an otherwise valid world and old world-only banks remain readable":
    f=session_fixture(); game=capture_game(f.0,PresentationState(),f.1,[],f.2,VesselFleet(),Battle(),123,SaveSummary())
    assert(game is SaveGame)
    packed=pack_binary_living_save(game)
    packed.0.session_hash+=u64(1)
    assert(unpack_binary_living_save(packed.0,packed.1)==none)
    old=SaveGame(valid=true,world=game.world,terrain_key=123)
    packed=pack_binary_living_save(old)
    restored=unpack_binary_living_save(packed.0,packed.1)
    assert(restored!=none and restored!.session=="")
    assert(read_game_session(restored!) is LivingSaveError)

test "a malformed aircraft or a different tick is refused before replacing play":
    f=session_fixture(); game=capture_game(f.0,PresentationState(),f.1,[],f.2,VesselFleet(),Battle(),123,SaveSummary())
    assert(game is SaveGame)
    session=f.1; session.tick=game.world.tick+1
    assert(session_error(game,session)!="")
    session.tick=game.world.tick; session.flyer.state.fuel+=10
    assert(session_error(game,session)!="")

test "autosave waits for safety debounces arrival and backs off even on storage failure":
    clock=AutosaveClock()
    loop _ in 0..100: assert(not step_autosave(clock,0.1,false,true))
    loop _ in 0..29: assert(not step_autosave(clock,0.1,true,true))
    assert(step_autosave(clock,0.2,true,true)); ack_autosave(clock,true)
    loop _ in 0..300: assert(not step_autosave(clock,0.1,true,true))
    _=step_autosave(clock,0.1,false,true)
    loop _ in 0..31: _=step_autosave(clock,0.1,true,true)
    assert(step_autosave(clock,0.1,true,true)); ack_autosave(clock,false)
    loop _ in 0..299: assert(not step_autosave(clock,0.1,true,true))
    assert(not step_autosave(clock,999,true,false))

test "a save's own busy frames do not re-arm the arrival save":
    clock=AutosaveClock()
    loop _ in 0..29: assert(not step_autosave(clock,0.1,true,true))
    assert(step_autosave(clock,0.2,true,true))
    # Storage stays busy for a while (the request is acknowledged as pending, then done).
    ack_autosave(clock,false)
    loop _ in 0..20: assert(not step_autosave(clock,0.1,true,false))
    ack_autosave(clock,true)
    # Standing in the same safe place: the next save is the periodic one, 180 s on.
    loop _ in 0..1795: assert(not step_autosave(clock,0.1,true,true))
    fired=false
    loop _ in 0..10:
        if step_autosave(clock,0.1,true,true): fired=true; break
    assert(fired and clock.since_save>=180)
    # Leaving during a busy spell still counts as leaving.
    clock=AutosaveClock(safe_for=10,since_save=40,was_safe=true,due=false)
    assert(not step_autosave(clock,0.1,false,false))
    loop _ in 0..29: assert(not step_autosave(clock,0.1,true,true))
    assert(step_autosave(clock,0.2,true,true))

test "a periodic autosave failure retries after a bounded quiet interval":
    clock=AutosaveClock(safe_for=10,since_save=179.95,was_safe=true,due=false)
    assert(step_autosave(clock,0.1,true,true))
    ack_autosave(clock,false)
    loop _ in 0..299:assert(not step_autosave(clock,0.1,true,true))
    assert(step_autosave(clock,0.2,true,true))



test "an invalid player identity is refused before scene folding can index it":
    f=session_fixture();w=f.0;w.player=w.people.len()
    assert(capture_game(w,PresentationState(),f.1,[],f.2,VesselFleet(),Battle(),123,SaveSummary()) is LivingSaveError)
