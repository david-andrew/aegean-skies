# The period engines (tweaks.period_engines, src/engine_sound.jo): every aircraft has one, its loops
# whole seconds that come round clean, and its exhaust beats at its real firing rate.
use '../src/engine_sound.jo'
use '../src/distant.jo'
use '../src/tweaks.jo'
from '../src/planes.jo' import Craft, CRAFT_NAMES

# (the strength of one frequency in a channel of a sound: Goertzel)
engine_tone = (s: Sound,hz: f64) -> f64:
    n = s.samples.len()/2
    c = 2.0*cos(TAU*hz/f64(ENGINE_RATE)); a = 0.0; b = 0.0
    loop i in 0..n:
        v = f64(s.samples[i*2])+c*a-b; b = a; a = v
    sqrt(max(0.0,a*a+b*b-c*a*b))/f64(n)

test "every aircraft has an engine, and its loops come round clean":
    loop k in 0..CRAFT_NAMES.len():
        spec = engine_spec(Craft(k))
        assert(spec.cylinders >= 6 and spec.rpm > spec.idle and spec.blades >= 2 and spec.count >= 1,"{CRAFT_NAMES[k]}")
        assert(engine_reference(spec)%2 == 0)
        # (every type's sounds can be made: an engine with a cylinder early on its first firing once
        # wrote before the loop's start and stopped the game when the trial was on)
        e = PeriodEngine()
        engine_sound_make(e,Craft(k))
        assert(e.on_load.samples.len() == ENGINE_RATE*2 and e.overrun.samples.len() == ENGINE_RATE*2,"{CRAFT_NAMES[k]}")
    loop kind in [Craft.gull,.supermarine_s6b,.donnet_leveque,.dornier_dox]:
        spec = engine_spec(kind)
        loop s in [make_exhaust(spec,true,1),make_exhaust(spec,false,2),make_prop(spec),make_tips(spec,3)]:
            assert(s.samples.len() == ENGINE_RATE*2)
            steps = 0.0; peak = 0.0
            loop i in 1..ENGINE_RATE:
                steps += pow(f64(s.samples[i*2]-s.samples[(i-1)*2]),2); peak = max(peak,abs(f64(s.samples[i*2])))
            typical = sqrt(steps/f64(ENGINE_RATE-1))
            assert(peak < 1.0 and abs(s.samples[0]-s.samples[(ENGINE_RATE-1)*2]) < 8.0*typical+0.002,"{kind}: its seam")

test "the exhaust beats at the engine's firing rate, the propeller at its blade rate":
    # the Rolls-Royce R: twelve cylinders, six firings a turn; the Gull's radial nine, four and a half
    loop kind in [Craft.supermarine_s6b,.gull]:
        spec = engine_spec(kind)
        firing = f64(engine_reference(spec))*f64(spec.cylinders)/2.0
        ex = make_exhaust(spec,true,1)
        assert(engine_tone(ex,firing) > 3.0*engine_tone(ex,firing*1.13),"{kind}: firing at {firing} Hz")
        blade = f64(prop_reference(spec)*spec.blades)
        pr = make_prop(spec)
        assert(engine_tone(pr,blade) > 5.0*engine_tone(pr,blade*1.21),"{kind}: blades at {blade} Hz")

# When one aircraft passes close the rest dip a few dB, the way the ear goes to the nearest
# engine, and come back quickly once it has gone (src/distant.jo, the period engines only).
test "the others dip while one passes close, and come back":
    tweaks.period_engines = true
    camera3d(vec3(0,500,0),vec3(0,500,-10))
    h = make_hearing()
    ear = vec3(0,500,0)
    frame = (near: f64,t: f64):
        hear_engines(h,[EngineSource(1,vec3(f32(near),500,0),vec3(0,0,0),0.8,true,1.0,60.0,kind = int(Craft.fiat_cr20)),
            EngineSource(2,vec3(0,500,-900),vec3(0,0,0),0.8,true,1.0,60.0,kind = int(Craft.macchi_m33))],ear,vec3(0,0,0),t)
    loop f in 0..60: frame(30.0,f64(f)/60.0)
    assert(h.duck < 0.6,"dipped to {h.duck:.2}")
    loop f in 60..120: frame(600.0,f64(f)/60.0)
    assert(h.duck > 0.95,"back to {h.duck:.2} a second after")
    hush_engines(h)
    tweaks.period_engines = false
