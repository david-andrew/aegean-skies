# A month gate counts real goods arrivals, separately from paid counter-order rounds.
use '../src/living_types.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'
use '../src/living_far_economy.jo'
use 'living_wholesale.jo'

test "received-order services keep delivering actual goods throughout a month and a saved week replays exactly":
    # This producer can actually feed the connected towns. The tiny commission fixture
    # produces less than its own population consumes, so eventual scarcity there is real.
    w=wholesale_fixture(); windows: int[6]; last=w.far.cargo_deliveries
    replay: World?=none
    loop day in 0..30:
        advance_minutes(w,1440)
        windows[day/5]+=w.far.cargo_deliveries-last; last=w.far.cargo_deliveries
        errors=invariant_errors(w); assert(errors.len()==0,errors.join("; "))
        assert(far_population(w)==w.far.opening_population and validate_save_world(w)=="",validate_save_world(w))
        if day==14:
            parsed=from_text[World](canonical_text(w)); assert(parsed is World); replay=parsed
        else if day>14 and day<22:
            other=replay!; advance_minutes(other,1440)
            assert(canonical_text(other)==canonical_text(w)); replay=other
    print("FAR MONTH cargo={w.far.cargo_deliveries} orders={w.far.order_rounds} windows={windows}")
    loop n in windows: assert(n>0,"actual cargo stalled for a five-day window: {windows}")
