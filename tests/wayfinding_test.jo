# Pure tests for showing and pointing the way (src/wayfinding.jo) and verifying that lodging
# replies never move the pilot's position.
use '../src/living_types.jo'
use '../src/wayfinding.jo'
use '../src/living_seed.jo'
use '../src/living_conversation.jo'
use '../src/town_sites.jo'

test "choose_way_mode picks guide when close, free, warm and routable; point when visible; words otherwise":
    # Close, free, warm, routable -> guide
    assert(choose_way_mode(28.0, true, true, true, true) == .guide)
    assert(choose_way_mode(28.0, false, true, true, true) == .guide)
    # Too close (<= 5m): don't guide, point if visible
    assert(choose_way_mode(4.0, true, true, true, true) == .point)
    # Not warm or busy or unroutable -> point if visible
    assert(choose_way_mode(28.0, true, true, false, true) == .point)
    assert(choose_way_mode(28.0, true, false, true, true) == .point)
    assert(choose_way_mode(28.0, true, true, true, false) == .point)
    # Out of sight or too far -> words only
    assert(choose_way_mode(28.0, false, true, false, true) == .words)
    assert(choose_way_mode(180.0, true, true, true, true) == .words)
    assert(choose_way_mode(180.0, false, true, true, true) == .words)

test "way_visible respects house occlusion, terrain hills, and max distance":
    flat = (x: f64, z: f64) -> f64: 1.0
    # Clear sightline across 30m
    assert(way_visible([], vec3(0, 1, 0), vec3(0, 1, 30), 2.5, flat))
    # Blocked by a house standing directly between speaker and target
    blocker = TownSite(vec3(0, 1, 15), 0.0, 8.0, 6.0, 7.0, 42)
    assert(not way_visible([blocker], vec3(0, 1, 0), vec3(0, 1, 30), 2.5, flat))
    # House off to the side does not block
    beside = TownSite(vec3(15, 1, 15), 0.0, 6.0, 6.0, 7.0, 43)
    assert(way_visible([beside], vec3(0, 1, 0), vec3(0, 1, 30), 2.5, flat))
    # Target's own building does not self-occlude
    own = TownSite(vec3(0, 1, 30), 0.0, 8.0, 6.0, 7.0, 44)
    assert(way_visible([own], vec3(0, 1, 0), vec3(0, 1, 30), 2.5, flat))
    # Ridge rising in between blocks sight
    ridge = (x: f64, z: f64) -> f64: if z > 10.0 and z < 20.0: 8.0 else: 1.0
    assert(not way_visible([], vec3(0, 1, 0), vec3(0, 1, 30), 2.5, ridge))
    # Beyond 160m is out of visual pointing range
    assert(not way_visible([], vec3(0, 1, 0), vec3(0, 1, 200), 2.5, flat))

test "way_direction_words produces grounded visible and out-of-sight directions without quay":
    cafe = WayPlace("cafe", "the cafe", "Where is the cafe?", vec3(10, 1, 25), hint = "under the awning")
    vis = way_direction_words(vec3(0, 1, 0), 0.0, cafe, vec2(0, -1), true, 1)
    assert("awning" in lower(vis) and not ("quay" in lower(vis)), vis)
    assert("left" in lower(vis) or "ahead" in lower(vis), vis)
    # Uphill house gives "up the steps"
    home = WayPlace("home:1", "Eleni's place", "Where is Eleni's place?", vec3(-12, 4.5, 22), is_spare = true, hint = "the blue door")
    up_line = way_direction_words(vec3(0, 1, 0), 0.0, home, vec2(0, -1), true, 0)
    assert("steps" in lower(up_line) and "blue door" in lower(up_line) and "right" in lower(up_line), up_line)
    # Out of sight gives compass and walk length, never "quay"
    far = WayPlace("fuel", "the fuel pier", "Where is the fuel pier?", vec3(190, 1, -20), hint = "by the fuel tanks")
    far_line = way_direction_words(vec3(0, 1, 0), 0.0, far, vec2(0, 1), false, 2)
    assert("east" in lower(far_line) and "minutes" in lower(far_line) and not ("quay" in lower(far_line)), far_line)

test "way_point_strength and way_mark_strength rise, hold, and fade cleanly":
    wp = way_point_begin(7, vec3(0, 1, 0), vec3(0, 2, 20), 10.0)
    assert(way_point_strength(wp, 7, 9.9) == 0.0)
    assert(way_point_strength(wp, 8, 11.0) == 0.0)
    assert(way_point_strength(wp, 7, 11.5) > 0.95)
    assert(way_point_strength(wp, 7, 10.0 + WAY_POINT_SECONDS + 0.1) == 0.0)
    pl = WayPlace("cafe", "the cafe", "Where is the cafe?", vec3(0, 1, 20))
    wm = way_mark_begin(pl, 10.0)
    assert(way_mark_strength(wm, 11.0) > 0.99)
    assert(way_mark_strength(wm, 10.0 + WAY_MARK_SECONDS - 1.0) < 0.5)
    assert(way_mark_strength(wm, 10.0 + WAY_MARK_SECONDS + 0.1) == 0.0)

test "lodging replies never move the pilot's position":
    w = build_world(u64(42))
    # 1. Sofia Marinou (id 6) hotel room offer -> accept: pilot position unchanged.
    p0 = w.people[6].pose.pos + vec3(1.5, 0, 0)
    w.people[0].pose.pos = p0
    w.people[0].place = w.people[6].place
    tk = converse(w, 6, 0, .lodging)
    assert(tk.question_kind == .hotel_offer)
    ak = answer_conversation(w, 6, 0, .reassure)
    assert(ak.effect == "hotel_desk")
    assert(length(w.people[0].pose.pos - p0) == 0.0, "hotel reply moved pilot")
    # 2. Spare room offer in Kalamos -> accept: pilot position unchanged.
    found = false
    loop day in 0..10:
        w2 = build_world(u64(42))
        w2.minute += day * 1440
        loop q in w2.people:
            if q.id == 0 or q.home != 1 or q.place != 1 or q.occupation == .patrol or q.occupation == .pirate or q.occupation == .innkeeper or q.occupation == .hotelier: continue
            start_pos = q.pose.pos + vec3(1.5, 0, 0)
            w2.people[0].pose.pos = start_pos
            w2.people[0].place = 1
            seed_relationship(w2, q.id, 0)
            w2.relationships[w2.relationship_index[RelationshipKey(q.id, 0)]].affinity = 80
            tr = converse(w2, q.id, 0, .lodging)
            if tr.question_kind == .lodging_offer:
                ans = answer_conversation(w2, q.id, 0, .reassure)
                assert(ans.effect == "stay_family")
                assert(length(w2.people[0].pose.pos - start_pos) == 0.0, "spare room reply moved pilot")
                found = true
                break
        if found: break
    assert(found, "expected a spare room offer to verify no-warp")
