use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_choices.jo'
use '../src/living_claims.jo'

test "impossible debt yields to income and deterministic scoring relieves pressure":
    w = build_world()
    advance_minutes(w,40)
    p = 2; debt = w.obligation_keys["nikos_engine_bill"]
    assert(transfer(w,w.people[p].account,w.factions[0].account,w.accounts[w.people[p].account].cents,.debt))
    w.obligations[debt].due_minute = w.minute
    w.people[p].next_decision_minute = w.minute
    decide_person(w,p)
    assert(w.obligations[debt].state == .blocked and w.obligations[debt].next_retry_minute > w.minute)
    assert(w.people[p].action.activity == .work or w.people[p].action.activity == .fulfill)
    assert(w.people[p].vice_active)
    a = Candidate(activity=.rest,purpose=.visit,rest=1.0)
    w.people[p].pressures.rest = 1000
    assert(candidate_score(w,p,a,1) == candidate_score(w,p,a,1))
    assert(candidate_score(w,p,a,1) > 1.0)
    w.people[p].pressures.rest = 0; w.people[p].pressures.company = 1000
    c = Candidate(activity=.socialize,purpose=.visit,company=1.0,social=1.0)
    assert(candidate_score(w,p,c,2) > candidate_score(w,p,a,1))

test "tender competition is exclusive and couriers have choice windows":
    w = build_world()
    assert(not take_job(w,3,8))
    advance_minutes(w,90)
    assert(w.jobs[4].state == .claimed and w.jobs[4].carrier == 8)
    j = if w.jobs[3].state == .claimed: 3 else: 4
    carrier = w.jobs[j].carrier
    assert(not take_job(w,j,if carrier == 8: 2 else: 8))
    advance_minutes(w,48*60)
    loop p in [2,8,11]:
        assert(w.people[p].last_choice_minute >= w.minute-1440)
        assert(w.people[p].free_choice_minutes >= 15)
    assert(money_balances(w) and goods_balance(w))

test "stale quotes and vice recovery gambling conserve resources":
    w = build_world()
    assert(believed_price(w,2,0,6) > 0)
    w.minute = 721; w.tick = w.minute*120
    assert(believed_price(w,2,0,6) == -1)
    p = 8
    w.people[p].vice_active = true; w.people[p].vice_until = w.minute
    w.people[p].vice_recovery_minutes = 60
    refresh_pressures(w,p); update_vice(w,p)
    assert(not w.people[p].vice_active)
    assert(gamble(w,3))
    assert(not gamble(w,3) and w.accounts[3].cents >= 400)
    assert(money_balances(w) and goods_balance(w))
