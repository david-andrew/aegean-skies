test "a hungry paid force can retreat to actual supply without creating a ration or teleporting home":
    w=commission_fixture(); unit=war_charter(w,0,1); war_supply(w,unit)
    assert(issue_war_order(w,unit,.patrol,200)>=0); war_orders(w)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==200)
    # Prolonged real consumption empties the carried ration and this port's counter.
    ration=far_stock_take(w.far.vehicles[0].provisions,w.cargo_sources,3,w.far.vehicles[0].provisions.qty[3])
    assert(ration!=none); far_use(w,ration!)
    used=far_take_market(w,200,3,far_market_qty(w,200,3)); far_use(w,used)
    w.minute+=120; w.tick=w.minute*120; war_orders(w); war_decisions(w)
    assert(w.war.units[unit].supplied_until<w.minute)
    order=w.war.units[unit].order
    assert(order>=0 and w.war.orders[order].task==.repair and w.war.orders[order].target==100)
    at=w.far.vehicles[0].pos; before=stock_totals(w)
    war_orders(w)
    assert(w.far.vehicles[0].journey>=0 and w.far.vehicles[0].pos==at and w.far.vehicles[0].place== -1)
    assert(w.far.vehicles[0].provisions.qty[3]==0 and stock_totals(w)==before)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==100 and money_balances(w) and goods_balance(w))

test "a national charter recruits existing workers pays existing accounts and preserves title":
    w=commission_fixture(); before=stock_totals(w); cash=w.ledger.opening_cents
    workers=w.far.districts[100].workers[1]; crew=w.far.crew_population[1]
    unit=war_charter(w,0,1)
    assert(unit>=0 and w.far.districts[100].workers[1]==workers-8 and w.far.crew_population[1]==crew+8)
    assert(w.far.vehicles[0].duty==.patrol and war_charter(w,0,1)<0)
    assert(w.far.districts[100].target[5]>=6000 and w.far.districts[100].target[8]>=2000)
    assert(stock_totals(w)==before and w.ledger.opening_cents==cash and far_population(w)==w.far.opening_population)
    assert(validate_save_world(w)=="")

test "only physically received national evidence can escalate three independent incidents":
    w=commission_fixture()
    loop i in 0..3: war_incident(w,100,1,2,"armed_intrusion","A witnessed patrol crossed the border.",80)
    war_diplomacy(w)
    r=war_relation(w,1,2); assert(r>=0 and w.diplomacy[r].tension==0)
    # Actual postal/carrier arrival is the only producer of this destination knowledge.
    w.far.districts[200].recent_news=w.far.districts[100].recent_news
    war_diplomacy(w)
    assert(w.diplomacy[r].tension==240 and w.diplomacy[r].stage==.mobilizing)
    war_diplomacy(w); assert(w.diplomacy[r].tension==240)
    assert(w.diplomacy[r].stage!=.war) # no supplied force, regardless of calendar/tension

test "a supplied force must actually reach a hostile settlement before it can occupy it":
    w=commission_fixture(); unit=war_charter(w,0,1)
    assert(unit>=0)
    r=war_relation(w,1,2); w.diplomacy[r].stage=.war
    far_local_news(w,100,"war_declared","A received declaration of war.",country=1,other_country=2,severity=1000)
    far_local_news(w,200,"war_declared","A received declaration of war.",country=2,other_country=1,severity=1000)
    war_supply(w,unit)
    assert(w.war.units[unit].supplied_until>=w.minute)
    owner=w.far.districts[200].market_account
    citizens=w.far.districts[200].workers
    assert(not war_occupy(w,unit,200))
    assert(issue_war_order(w,unit,.occupy,200)>=0)
    war_orders(w)
    assert(w.far.vehicles[0].journey>=0 and w.far.districts[200].controller==2)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    # Supply expiration is real; refresh the fixture's still-carried food and ammunition.
    war_supply(w,unit); war_orders(w)
    assert(w.far.districts[200].controller==1 and w.far.districts[200].born_country==2)
    assert(w.far.districts[200].workers==citizens and w.far.districts[200].market_account==owner)
    assert(far_population(w)==w.far.opening_population and money_balances(w) and goods_balance(w))
    assert(validate_far(w)=="")

test "demobilization returns recruited citizens at the actual home and preserves stock":
    w=commission_fixture(); unit=war_charter(w,0,1); war_supply(w,unit)
    before=stock_totals(w); people=far_population(w)
    assert(issue_war_order(w,unit,.withdraw,100)>=0)
    war_orders(w)
    assert(w.war.units[unit].retired and w.far.vehicles[0].duty==.merchant)
    assert(w.far.vehicles[0].crew[1]==1 and far_population(w)==people and stock_totals(w)==before)
    assert(validate_save_world(w)=="")


test "an occupation ends when its actual landing force leaves rather than persisting as a remote flag":
    w=commission_fixture(); unit=war_charter(w,0,1); r=war_relation(w,1,2); w.diplomacy[r].stage=.war
    far_local_news(w,100,"war_declared","A received declaration of war.",country=1,other_country=2,severity=1000)
    far_local_news(w,200,"war_declared","A received declaration of war.",country=2,other_country=1,severity=1000)
    war_supply(w,unit); assert(issue_war_order(w,unit,.occupy,200)>=0); war_orders(w)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick); war_supply(w,unit); war_orders(w)
    assert(w.far.districts[200].controller==1 and 200 in w.war.occupations)
    w.far.vehicles[0].pos+=vec3(10000,0,0)
    war_occupations_minute(w)
    assert(w.far.districts[200].controller==2 and not (200 in w.war.occupations))
    assert(far_population(w)==w.far.opening_population and money_balances(w) and goods_balance(w))


test "a capital's declaration and ceasefire reach a force only by an actual received notice":
    w=commission_fixture(); unit=war_charter(w,0,1); relation=war_relation(w,1,2)
    w.diplomacy[relation].stage=.war
    assert(not war_unit_hostile(w,unit,2))
    id=far_local_news(w,200,"war_declared","The government declared war.",country=2,other_country=1,severity=1000)
    assert(not war_unit_hostile(w,unit,2))
    # A carrier/courier delivers the actual written account to the force's present port.
    far_arriving_accounts(w,100,w.far.districts[200].reports)
    war_force_notices(w); assert(war_unit_hostile(w,unit,2))
    w.far.districts[100].reports=[]
    assert(war_unit_hostile(w,unit,2)) # a soldier does not forget a war on journal eviction
    far_local_news(w,200,"armistice","Both governments signed a ceasefire.",country=1,other_country=2,severity=1000)
    w.diplomacy[relation].stage=.armistice
    assert(war_unit_hostile(w,unit,2)) # the distant global relation is not a radio
    far_arriving_accounts(w,100,w.far.districts[200].reports)
    war_force_notices(w); assert(not war_unit_hostile(w,unit,2))


test "a completed charter can rehire the same physical hull without growing identities or duplicating recruits":
    w=commission_fixture(); unit=war_charter(w,0,1); war_supply(w,unit)
    assert(issue_war_order(w,unit,.withdraw,100)>=0); war_orders(w)
    workers=w.far.districts[100].workers[1]; population=far_population(w); accounts=w.accounts.len()
    before=stock_totals(w)
    again=war_charter(w,0,1)
    assert(again==unit and w.war.units.len()==1 and w.far.vehicles[0].crew[1]==9)
    assert(w.far.districts[100].workers[1]==workers-8 and far_population(w)==population and stock_totals(w)==before)
    assert(w.accounts.len()==accounts and money_balances(w) and goods_balance(w))


test "a charter leaves actual local supply hands and cannot recruit the whole remaining workforce":
    w=commission_fixture(); available=w.far.districts[100].workers[1]
    w.far.districts[100].workers[1]=6; w.far.districts[100].dependents[1]+=available-6
    before=canonical_text(w)
    assert(war_charter(w,0,1)<0 and canonical_text(w)==before)
    w.far.districts[100].dependents[1]-=1; w.far.districts[100].workers[1]+=1
    unit=war_charter(w,0,1)
    assert(unit>=0 and w.war.units[unit].strength==4 and w.far.districts[100].workers[1]==3)
    assert(far_population(w)==w.far.opening_population and money_balances(w) and goods_balance(w))
