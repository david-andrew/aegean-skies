use '../src/night_sky.jo'
use '../src/sky.jo'
use '../src/day_air.jo'
use '../src/look.jo'
use '../src/celestial.jo'
use '../src/stargazing.jo'

# The night sky's lights (src/night_sky.jo): the Moon out as a light from sunset, the stars'
# spread and what the twilight, the Moon and the haze let through, and no hard edge anywhere in
# the night dome.

test "The celestial sphere turns with the sun and agrees with stargazing's places":
    loop hour in [0.0, 3.0, 6.5, 12.0, 18.75, 20.0, 23.0]:
        turn = sky_turn(sky_sun(hour))
        loop s in SKY_NAMES:
            assert(length(sky_turned(turn, celestial_place(s.ra, s.dec)) - sky_star(s.ra, s.dec, hour)) < 0.0001, "{s.english} at {hour}")
        q = celestial_place(17.2, -31.0)
        assert(length(sky_unturned(turn, sky_turned(turn, q)) - q) < 0.0001)

test "The figures are the real ones, not their mirror images":
    # (as the eye sees them: right of the view is forward x up. In the real sky the Summer Triangle
    # runs Vega, Deneb, Altair counter-clockwise, and the Scorpion's tail lies east of Antares, the
    # side its stars rise on)
    turns = (a: vec3, b: vec3, c: vec3) -> f32:
        f = normalize(a + b + c)
        right = normalize(cross(f, vec3(0, 1, 0)))
        up = cross(right, f)
        p = (d: vec3) -> vec2: vec2(dot(d, right), dot(d, up))
        u = p(b) - p(a); v = p(c) - p(a)
        u.x * v.y - u.y * v.x
    loop hour in [21.0, 23.0, 1.0]:
        assert(turns(sky_star(18.616, 38.78, hour), sky_star(20.69, 45.28, hour), sky_star(19.846, 8.87, hour)) > 0.01, "the Summer Triangle at {hour}")
        # (the Plough: Dubhe, Merak, Phecda turn clockwise as the eye sees them)
        assert(turns(sky_star(11.062, 61.75, hour), sky_star(11.031, 56.38, hour), sky_star(11.897, 53.69, hour)) < -0.0005, "the Plough at {hour}")

test "Many faint stars and few bright ones, the same every time":
    seed_random(7); expected = random()
    seed_random(7)
    stars = night_star_specs()
    assert(random() == expected)
    again = night_star_specs()
    assert(stars.len() == again.len() and stars.len() == BRIGHT_STARS.len() / 4 + FAINT_STARS)
    bins = [0, 0, 0, 0, 0, 0, 0]
    glints = 0; milky = 0; faint = 0
    loop k in 0..stars.len():
        s = stars[k]
        assert(abs(length(s.q) - 1.0) < 0.0001 and s.q == again[k].q and s.mag == again[k].mag)
        assert(s.mag > -1.6 and s.mag < 6.2)
        bins[clamp(int(floor(f64(s.mag))) + 1, 0, 6)] += 1
        if f64(s.mag) < STAR_GLINT_MAG: glints += 1
        if s.mag > 4.0:
            faint += 1
            if abs(f64(dot(s.q, GALAXY_Z))) < 0.26: milky += 1
    # (each magnitude more than the one before it, from the first on)
    loop k in 2..6: assert(bins[k+1] > bins[k] * 2, "magnitude {k}: {bins[k]} then {bins[k+1]}")
    assert(bins[0] + bins[1] < 15 and glints > 20 and glints < 50, "{bins} {glints}")
    # (thicker along the Milky Way: a quarter of the sky holds well over a quarter of the faint ones)
    assert(f64(milky) / f64(faint) > 0.4, "{milky} of {faint}")

test "The Moon is out as a light from sunset, its glow by its phase and the air":
    assert(moon_glow(0.2) == 0.0 and moon_glow(-0.2) == 1.0)
    assert(moon_glow(0.0) > 0.25 and moon_glow(0.0) < 0.6)
    # (18:45, three quarters of an hour after sunset: fully out; it used to wait for 19:10)
    assert(moon_glow(f64(sky_sun(18.75).y)) > 0.99)
    full_day = LUNAR_MONTH / 2.0 - LUNAR_EPOCH_AGE
    full = night_air(light_at(23.0, full_day))
    thin = night_air(light_at(19.5, full_day + LUNAR_MONTH / 2.0 + 2.5))
    assert(full.lit > 0.98 and thin.lit > 0.02 and thin.lit < 0.15)
    a = moon_look(full, sky_sun(23.0), f64(full.moon.y))
    b = moon_look(thin, sky_sun(19.5), f64(thin.moon.y))
    assert(a.out == 1.0 and a.glow.w > 0.6 and a.aureole.w > 0.4)
    assert(b.glow.w < a.glow.w * 0.1 and b.aureole.w < a.aureole.w * 0.1)
    # (a blown-out face: over-bright where it is plain, the maria just under)
    assert(min(a.face.x, min(a.face.y, a.face.z)) > 1.15)
    # (the glow at the disc's middle when full, toward the lit limb for a crescent)
    assert(length(a.toward) < 0.05 and length(b.toward) > 0.6)
    # (haze: a wider, milkier aureole and a corona; clear air has no corona)
    hazy = night_air(day_air_light(light_at(23.0, full_day), .hazy))
    h = moon_look(hazy, sky_sun(23.0), f64(hazy.moon.y))
    assert(h.reach > a.reach * 1.2 and h.aureole.w > a.aureole.w and h.ring.w > 0.1 and a.ring.w == 0.0)
    # (by day: the pale wash, no glow at all)
    noon = night_air(light_at(12.0, full_day + 7.0))
    assert(moon_look(noon, sky_sun(12.0), 0.5).out == 0.0 and moon_look(noon, sky_sun(12.0), 0.5).glow.w == 0.0)

test "Twilight, moonlight, haze and cloud take the faint stars first":
    new_day = LUNAR_MONTH - LUNAR_EPOCH_AGE
    full_day = LUNAR_MONTH / 2.0 - LUNAR_EPOCH_AGE
    last = -99.0
    loop hour in [17.5, 18.0, 18.4, 18.75, 19.2, 20.0, 21.0, 23.0]:
        limit = f64(night_air(light_at(hour, new_day)).limit)
        assert(limit >= last, "{hour}")
        last = limit
    dark = night_air(light_at(23.0, new_day))
    moonlit = night_air(light_at(23.0, full_day))
    hazy = night_air(day_air_light(light_at(23.0, new_day), .hazy))
    covered = night_air(light_at(23.0, new_day), 0.9)
    assert(dark.limit > 6.0 and moonlit.limit < dark.limit - 1.5 and hazy.limit < dark.limit - 0.6 and covered.limit < 0.0)
    # (the Milky Way only on a dark, clear, moonless night)
    assert(milky_way_gain(dark) > 0.4 and milky_way_gain(moonlit) == 0.0 and milky_way_gain(night_air(light_at(19.3, new_day))) == 0.0)
    assert(milky_way_gain(hazy) < milky_way_gain(dark) * 0.5)
    # (Venus at sunset, a first-magnitude star half an hour after it, a faint one only at night)
    up = vec3(0, 1, 0)
    none4 = vec4(0, 0, 0, 0)
    under = vec4(0, -1, 0, 0)
    seen = (hour: f64, mag: f64) -> f32:
        air = night_air(light_at(hour, new_day))
        night_seen(up, 1.0, f32(mag), vec4(air.limit, air.extinction, 0, 0), under, none4).x
    assert(seen(18.0, -4.3) > 0.4 and seen(18.0, 0.0) == 0.0)
    assert(seen(18.6, 0.0) > 0.1 and seen(18.6, 4.0) == 0.0)
    assert(seen(23.0, 4.0) > 0.9 and seen(23.0, 5.5) > 0.2)
    # (the low air dims and hides: less of a star near the horizon than overhead, nothing below it)
    air = vec4(dark.limit, dark.extinction, 0, 0)
    high = night_seen(up, 1.0, 3.0, air, under, none4)
    low = night_seen(normalize(vec3(1, 0.06, 0)), 0.06, 3.0, air, under, none4)
    assert(low.y < high.y * 0.8 and low.x <= high.x)
    assert(night_seen(normalize(vec3(1, -0.02, 0)), -0.02, -1.0, air, under, none4).x == 0.0)
    # (nothing shows through the Moon's disc, and its glare takes the faint stars about it)
    moon = vec4(up, 0.8)
    assert(night_seen(up, 1.0, -1.0, air, moon, none4).x == 0.0)
    near = normalize(vec3(0.1, 1, 0))
    assert(night_seen(near, near.y, 5.0, air, moon, none4).x < night_seen(near, near.y, 5.0, air, under, none4).x * 0.5)
    # (twilight's band takes the stars low on the sun's side)
    dusk = light_at(19.3, new_day)
    dusk_air = night_air(dusk)
    west = normalize(vec3(-1, 0.12, 0))
    air = vec4(dusk_air.limit, dusk_air.extinction, 0, 0)
    assert(dusk.afterglow.x > 0.5 and night_seen(west, west.y, 2.0, air, under, none4).x > 0.5)
    assert(night_seen(west, west.y, 2.0, air, under, dusk.afterglow).x < 0.1)

test "The planets: Venus and Jupiter the brightest, steady, each in its colour":
    assert(planet_magnitude(0, 1.8) < planet_magnitude(1, 1.25) and planet_magnitude(1, 1.25) < planet_magnitude(2, 0.85) - 1.5)
    turn = sky_turn(sky_sun(4.75))
    L = light_at(4.75, 0.0)
    vs = night_planet_vertices(L.planets, turn)
    assert(vs.len() == 16)
    loop k in 0..4:
        v = vs[k * 4]
        # (no twinkle; where the ephemeris puts it; brighter than any star but Sirius at most)
        assert(v.data.w == 0.0 and v.data.x < 1.6)
        assert(length(sky_turned(turn, v.q) - normalize(L.planets[k].xyz)) < 0.0001)
    # (Mars reddish, Saturn pale gold)
    assert(PLANET_TINTS[2].x > PLANET_TINTS[2].z * 2.5 and PLANET_TINTS[3].y > 0.75 and PLANET_TINTS[3].z < 0.6)

# ---- the night dome as it is drawn, for the sweep ----
# The sky's own gradient, the Milky Way's grid (interpolated between its vertices, nothing outside
# it), the Moon's aureole fan (between its rings, nothing past its rim) and the Moon's square (its
# own program, nothing outside the square), composed as the GPU blends them. The stars and planets
# are points, left out; twilight's glow band is checked with the sunset.

milky_grid = milky_way_grid()

milky_drawn = (q: vec3) -> vec3:
    z = f64(dot(q, GALAXY_Z))
    b = asin(clamp(z, -1.0, 1.0)) * 180.0 / PI
    if abs(b) >= MILKY_REACH: return vec3(0, 0, 0)
    l = atan2(f64(dot(q, GALAXY_Y)), f64(dot(q, GALAXY_X)))
    if l < 0.0: l += TAU
    x = l / TAU * f64(MILKY_COLUMNS)
    i = min(int(floor(x)), MILKY_COLUMNS - 1)
    j = 0
    loop k in 0..MILKY_ROWS:
        if b >= milky_row(k): j = k
    fx = f32(x - f64(i)); fy = f32((b - milky_row(j)) / (milky_row(j + 1) - milky_row(j)))
    rows = MILKY_ROWS + 1
    mix(mix(milky_grid[i*rows+j].light, milky_grid[(i+1)*rows+j].light, fx), mix(milky_grid[i*rows+j+1].light, milky_grid[(i+1)*rows+j+1].light, fx), fy)

aureole_drawn = (x: f64) -> f32:
    if x >= 1.0: return 0.0
    loop j in 0..AUREOLE_RINGS:
        a = aureole_ring(j); b = aureole_ring(j + 1)
        if x <= b: return mix(aureole_falloff(f32(a)), aureole_falloff(f32(b)), f32((x - a) / (b - a)))
    0.0

struct Dome:
    L: Light
    air: NightAir
    turn: SkyTurn
    look: MoonLook
    moon: MoonParams
    sky: SkyParams
    right: vec3
    up: vec3
    height: f64

dome_at = (hour: f64, day: f64, kind: DayAir) -> Dome:
    L = day_air_light(light_at(hour, day), kind)
    air = night_air(L)
    moon = normalize(air.moon)
    k = moon_look(air, L.sun_dir, f64(moon.y))
    right = normalize(cross(vec3(0, 1, 0), moon) + vec3(0.00001, 0, 0))
    sky = SkyParams(mat4(1), night_sky_top(L.sky_top, air), L.sky_horizon, L.haze, L.sea_deep, L.sun_dir, L.sun * L.glare, 0.0, 0.0, 0.0, 0.0)
    Dome(L, air, sky_turn(L.sun_dir), k, moon_disc_params(k, moon, L.sun_dir, f64(moon.y), mat4(1), 0.0), sky, right, cross(moon, right), f64(moon.y))

# the dome's light in a direction; none inside the Moon's own disc (its limb is a true edge)
dome_light = (d: Dome, dir: vec3) -> vec3?:
    c = sky_color(dir, d.sky)
    gain = f32(milky_way_gain(d.air))
    if gain > 0.002: c += milky_drawn(sky_unturned(d.turn, dir)) * (gain * milky_way_fade(dir.y, d.air.extinction))
    moon = normalize(d.air.moon)
    if d.height < -f64(d.look.reach): return c
    ang = acos(clamp(f64(dot(dir, moon)), -1.0, 1.0))
    rise = f32(smoothstep(-0.1, 0.06, d.height))
    if d.look.aureole.w * rise > 0.003:
        a = d.look.aureole.w * rise * aureole_drawn(ang / f64(d.look.reach))
        c = c * (1.0 - a * 0.5) + d.look.aureole.xyz * a
    if d.height > -f64(SKY_DISC_RADIUS) * 1.5 and dot(dir, moon) > 0.0:
        # (the square stands on the plane touching the sphere at the Moon)
        p = dir / dot(dir, moon) - moon
        at = vec2(dot(p, d.right), dot(p, d.up)) / SKY_DISC_RADIUS
        if length(at) < 1.25: return none
        if abs(at.x) <= MOON_QUAD and abs(at.y) <= MOON_QUAD:
            m = moon_disc_fs(MoonOut(vec4(0, 0, 0, 1), at), d.moon)
            c = c * (1.0 - m.w) + m.xyz
    c

# A step: one sample-to-sample change that stands alone, much larger than the changes on both sides
# of it. A smooth slope, however steep, changes about as much from one sample to the next, and the
# crest of a ridge (the Milky Way's grid has them, as any painted geometry does) rises and falls
# by about the same on its two sides: neither is an edge.
dome_sweep = (d: Dome, label: str, from: vec3, axis: vec3, degrees: f64) -> int:
    n = int(degrees / 0.15)
    prev: vec3? = none
    steps: vec3[] = []
    at = vec3(0, 0, 0)
    count = 0
    loop k in 0..n+1:
        a = f64(k) * 0.15 * PI / 180.0
        dir = normalize(from * f32(cos(a)) + cross(axis, from) * f32(sin(a)))
        c: vec3? = if dir.y < 0.004: none else: dome_light(d, dir)
        if let now = c:
            if let p = prev:
                steps.push(now - p)
                m = steps.len()
                if m >= 3:
                    jump = length(steps[m-2])
                    assert(jump < 0.008 + 2.5 * max(length(steps[m-3]), length(steps[m-1])), "{label}: a step of {jump:.4} at {at}")
            prev = now; at = dir
            count += 1
        else:
            prev = none; steps = []
    count

test "No hard edge anywhere in the night dome":
    full_day = LUNAR_MONTH / 2.0 - LUNAR_EPOCH_AGE
    new_day = LUNAR_MONTH - LUNAR_EPOCH_AGE
    samples = 0
    loop hour in [18.75, 20.0, 23.0, 3.0]:
        loop day in [full_day, new_day, full_day - 5.0, new_day + 3.0]:
            loop kind in [DayAir.clear, DayAir.hazy, DayAir.humid]:
                d = dome_at(hour, day, kind)
                label = "{hour:.2}h day {day:.1} {kind}"
                # (from the horizon over the zenith and down the other side, every 15 degrees round)
                loop b in 0..12:
                    a = f64(b) * 15.0 * PI / 180.0
                    flat = vec3(f32(cos(a)), 0, f32(sin(a)))
                    samples += dome_sweep(d, label, flat, cross(flat, vec3(0, 1, 0)), 180.0)
                # (round the sky at several heights)
                loop h in [4.0, 12.0, 25.0, 45.0, 70.0]:
                    e = h * PI / 180.0
                    samples += dome_sweep(d, label, vec3(f32(cos(e)), f32(sin(e)), 0), vec3(0, 1, 0), 360.0)
                # (and across the Moon itself, through its glow, its square's edges and its aureole's rim)
                moon = normalize(d.air.moon)
                if moon.y > 0.05:
                    loop b in 0..6:
                        a = f64(b) * 30.0 * PI / 180.0
                        axis = normalize(d.right * f32(cos(a)) + d.up * f32(sin(a)))
                        samples += dome_sweep(d, label, normalize(moon * f32(cos(0.6)) - cross(axis, moon) * f32(sin(0.6))), axis, 68.0)
                        # (a little off its middle: along the square's sides)
                        off = normalize(moon + axis * (SKY_DISC_RADIUS * MOON_QUAD * 0.98))
                        samples += dome_sweep(d, label, normalize(off * f32(cos(0.5)) - cross(axis, off) * f32(sin(0.5))), axis, 57.0)
    assert(samples > 500000, "{samples}")

test "The Milky Way's grid closes on itself and ends in the dark":
    rows = MILKY_ROWS + 1
    assert(milky_grid.len() == (MILKY_COLUMNS + 1) * rows)
    brightest: f32 = 0.0
    loop j in 0..rows:
        assert(milky_grid[j].light == milky_grid[MILKY_COLUMNS*rows+j].light and length(milky_grid[j].q - milky_grid[MILKY_COLUMNS*rows+j].q) < 0.00001)
    loop i in 0..MILKY_COLUMNS+1:
        assert(length(milky_grid[i*rows].light) == 0.0 and length(milky_grid[i*rows+MILKY_ROWS].light) == 0.0)
        loop j in 0..rows: brightest = max(brightest, length(milky_grid[i*rows+j].light))
    # (the brightest of it toward the centre, in Sagittarius)
    centre = milky_way_light(0.02, 0.0); far = milky_way_light(PI, 0.0)
    assert(brightest > 0.6 and brightest < 1.8 and length(centre) > length(far) * 1.5)

test "A bright star's halo keeps its own colour while it twinkles":
    # (Altair rising, 12 degrees up, on a dark night: the low air's colour flashes change its
    # core from moment to moment, never the halo's colour, which stays blue)
    low = normalize(vec3(1, 0.21, 0))
    vertex = StarVertex(low, vec2(1, 1), STAR_TINTS[1], vec4(0.77, 0.37, 1.0, 1.0))
    shade = (t: f64) -> StarOut:
        night_star_vs(vertex, StarParams(mat4(1), vec3(1, 0, 0), vec3(0, 1, 0), vec3(0, 0, 1), vec4(6.4, 0.035, 0, f32(t)), vec4(0, -1, 0, 0), vec4(0, 0, 0, 0), vec4(0.001, 0.001, 0.95, 1.0), 0.0))
    first = shade(0.0)
    cores: f32 = 0.0
    loop k in 1..40:
        now = shade(f64(k) * 0.173)
        assert(length(normalize(now.halo.xyz) - normalize(first.halo.xyz)) < 0.0001, "{k}")
        assert(now.halo.z > now.halo.x * 1.5 and now.halo.z > now.halo.y)
        cores = max(cores, length(normalize(now.core) - normalize(first.core)))
    assert(cores > 0.01, "{cores}")

test "A star's square and the Moon's end in nothing at their edges":
    params = StarParams(mat4(1), vec3(1, 0, 0), vec3(0, 1, 0), vec3(0, 0, 1), vec4(0, 0, 0, 0), vec4(0, 0, 0, 0), vec4(0, 0, 0, 0), vec4(0, 0, 0, 0), 0.0)
    loop half in [2.8, 9.0, 14.0]:
        loop k in 0..41:
            e = f32(f64(k) / 20.0 - 1.0) * f32(half)
            loop at in [vec2(e, f32(half)), vec2(f32(half), e), vec2(e, -f32(half)), vec2(-f32(half), e)]:
                c = night_star_fs(StarOut(vec4(0, 0, 0, 1), at, vec3(1.6, 1.6, 1.6), vec4(1, 1, 1, 0.1), vec4(0.8, f32(1.0 / (half * half)), f32(2.6 / half), 0.8)), params)
                assert(length(c) < 0.0001, "{half} {at}")
    d = dome_at(23.0, LUNAR_MONTH / 2.0 - LUNAR_EPOCH_AGE, .hazy)
    loop k in 0..81:
        e = f32(f64(k) / 40.0 - 1.0) * MOON_QUAD
        loop at in [vec2(e, MOON_QUAD), vec2(MOON_QUAD, e), vec2(e, -MOON_QUAD), vec2(-MOON_QUAD, e)]:
            assert(length(moon_disc_fs(MoonOut(vec4(0, 0, 0, 1), at), d.moon)) < 0.0001, "{at}")
    assert(aureole_falloff(1.0) == 0.0 and aureole_falloff(0.0) > 0.99)
