# The game's words are British (docs/glossary/README.md, "House style"): harbour, colour, grey,
# metre, centre, travelling, honour, manoeuvre, programme, -ise; and never "quay" (dock, pier, harbour
# or waterfront instead). Anything a player can read or hear
# comes from the string literals in the game's sources, so none may use the American spelling.
# Code is not text: identifiers, field names inside interpolations ({tw.center.x}), save keys and
# ids keep their names, and the strings below never reach a player.

# Strings that are internal: failure codes, consistency-check messages, save keys and ids (which
# must not change), profiler zones and shader source.
SPELLING_INTERNAL = ["harbor-labor-", "recovery-labor-", "harbor-boat-", "far-neighbor:", "registry:{{place}}:center",
    "invalid sparse harbor", "invalid paid crop labor", "invalid catalog", "unknown catalog neighbor", "invalid cargo harbor geometry",
    "departure blocked: harbor, fuel or repair", "injured; harbor rescue dispatched", "safe alternative harbor; return passage needed",
    "cloud color", "SlDepthColor", "invalid detailed catalog adapter",
    # (venue ids, the fish stall's capture print, the world audit's findings and mooring re-check)
    "scene:quay", ":quay:{{k}}", "FISH stall", "AuditFinding(", "audit_prop(", "swing circle reaches a quay", "the launch's run from the dock"]

SPELLING_AMERICAN = ["harbor","harbors","harbored","color","colors","colored","colorful","gray","grayish","meter","meters",
    "kilometer","kilometers","center","centers","centered","traveling","traveled","traveler","travelers","labor","honor","honors",
    "honored","favorite","favorites","favor","neighbor","neighbors","neighborhood","flavor","flavors","theater","defense","armor",
    "armored","rumor","rumors","behavior","vapor","odor","catalog","aluminum","mustache","fueling","fueled","canceled","canceling",
    "leveled","signaled","quarreled","modeled","marvelous","jewelry","pajamas","cozy","valor","endeavor","humor","parlor","vigor",
    "liter","liters","fiber","somber","maneuver","maneuvers","airplane","airplanes","skeptical","organize","organized","recognize",
    "realize","apologize",
    # and not American but never wanted: the user's words for the waterside are dock, pier, harbour and waterfront
    "quay","quays","quayside"]

spelling_word_char = (c: u8) -> bool: (c >= c'a' and c <= c'z') or (c >= c'A' and c <= c'Z') or (c >= c'0' and c <= c'9') or c == c'_'

# The text of one line: the characters inside its string literals, with interpolations (and the
# strings nested in them) and doubled braces left out; everything else becomes a space.
spelling_text = (row: str) -> str:
    out: u8[]
    stack = [0]                       # 0 code, 1 string, 2 interpolation, 3 braces in code
    i = 0
    loop i < row.len():
        c = row[i]
        top = stack[stack.len()-1]
        if top == 1:
            if c == c'\\':
                out.push(c' '); i += 2; continue
            if c == c'"': stack.pop()
            else if (c == c'{' or c == c'}') and i+1 < row.len() and row[i+1] == c:
                out.push(c' '); i += 2; continue
            else if c == c'{': stack.push(2)
            else:
                out.push(c); i += 1; continue
            out.push(c' ')
        else:
            if c == c'#' and stack.len() == 1: break
            if c == c'"': stack.push(1)
            else if c == c'{': stack.push(3)
            else if c == c'}' and stack.len() > 1: stack.pop()
            out.push(c' ')
        i += 1
    str_from_bytes(out)

# The American words in one line's string literals.
spelling_words = (row: str) -> str[]:
    out: str[]
    t = spelling_text(row)
    i = 0
    loop i < t.len():
        if not spelling_word_char(t[i]):
            i += 1
            continue
        a = i
        loop i < t.len() and spelling_word_char(t[i]): i += 1
        w = lower(t[a..i])
        if w in SPELLING_AMERICAN: out.push(w)
    out

test "the scan finds American spellings in text and leaves code alone":
    assert(spelling_words("x = \"Enter at the host harbor.\"") == ["harbor"])
    assert(spelling_words("x = \"Harbour Patrol\"") == [])
    assert(spelling_words("print(\"{{tw.name}}: {{tw.center.x:.0}}\") # the harbor") == [])
    assert(spelling_words("x = \"a {{if b: \"harbor\" else: \"y\"}} and AEGEAN_WEATHER_CENTER\"") == ["harbor"])
    assert(spelling_words("x = \"cloud COLOR\"") == ["color"])

test "no player-facing words in the game use American spelling":
    # (run from the repository or from tests/)
    root = if is_dir("src"): "" else: "../"
    sources = [root + "aegean.jo"]
    names = list_dir(root + "src")
    if names is str[]:
        loop name in names:
            if name.ends_with(".jo"): sources.push(root + "src/" + name)
    assert(sources.len() > 100, "{sources.len()} sources")
    bad: str[]
    loop path in sources:
        body = read_file(path)
        if not (body is str): continue
        n = 0
        loop row in split(body, "\n"):
            n += 1
            code = row.trim()
            if code.starts_with("#") or not code.contains("\""): continue
            internal = false
            loop k in SPELLING_INTERNAL:
                if code.contains(k): internal = true
            if internal: continue
            found = spelling_words(code)
            if found.len() > 0: bad.push("{path}:{n}: {found.join(", ")}: {code}")
    assert(bad.len() == 0, bad.join("\n"))
