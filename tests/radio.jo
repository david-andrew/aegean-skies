use '../src/radio_content.jo'
use '../src/radio.jo'
use '../src/radio_synth.jo'
import '../src/living_types.jo' as world_data
import '../src/living_seed.jo' as seed
import '../src/living_events.jo' as events
import '../src/living_news.jo' as news

flat = (x: f64,z: f64) -> f64: 0.0
ridge = (x: f64,z: f64) -> f64: 900.0

test "radio tuning has gaps bounds and a night-only pirate station":
    r = Radio()
    radio_tune(r,620)
    radio_receive(r,0,0,vec3(0,400,100),flat)
    assert(r.station == 0 and r.strength > 0.9)
    radio_step(r,1); assert(r.khz == 625)
    radio_receive(r,0,0,vec3(0,400,100),flat)
    assert(r.station == 0 and r.strength < 0.7)
    radio_tune(r,700); radio_receive(r,0,0,vec3(0,400,100),flat)
    assert(r.station == -1 and r.strength == 0)
    radio_tune(r,10000); assert(r.khz == RADIO_MAX_KHZ)
    radio_step(r,1); assert(r.khz == RADIO_MAX_KHZ)
    radio_tune(r,-100); assert(r.khz == RADIO_MIN_KHZ)
    assert(not radio_on_air(5,0) and radio_on_air(5,600) and radio_on_air(5,1000))
    assert(radio_programme(5,0) == .off_air)

test "radio reception responds to range height night obstruction and tuning":
    s = radio_stations()[0]
    low = vec3(40000,5,0); high = vec3(40000,2000,0)
    near = radio_reception(s,s.khz,vec3(1000,5,0),12)
    far = radio_reception(s,s.khz,low,12)
    assert(near > far)
    assert(radio_reception(s,s.khz,high,12) > far)
    assert(radio_reception(s,s.khz,low,23) > far)
    assert(radio_reception(s,s.khz,low,12,500) < far*0.3)
    assert(radio_reception(s,s.khz+18,low,12) == 0)
    assert(radio_obstruction(vec3(0,100,0),vec3(1000,100,0),flat) == 0)
    assert(radio_obstruction(vec3(0,100,0),vec3(1000,100,0),ridge) > 700)

test "radio schedule uses the saved 0930 epoch and distinguishes bulletin slots":
    assert(radio_programme(0,0) == .news)
    assert(radio_programme(0,5) == .editorial)
    assert(radio_programme(0,10) == .music)
    assert(radio_programme(3,5) == .advert)
    assert(radio_programme(4,0) == .weather)
    assert(radio_programme(4,15) == .shipping)
    assert(radio_programme(5,600+5) == .quiz)
    assert(radio_programme(0,1440) == radio_programme(0,0))
    assert(radio_local_minute(-571) == 1439)
    assert(radio_music_style(radio_stations()[0],-210) == .choir)

test "radio reports only heard public fresh news and does not mutate the world":
    w = seed.build_world()
    station = radio_stations()[0]
    before = w
    assert(radio_public_news(w,station).event < 0)
    assert(w == before)
    id = events.emit_event(w,.raid,0,22,8,world_data.Reason(purpose=.raid,actor=22,counterparty=8),5000)
    assert(radio_public_news(w,station).event < 0) # not published at a place yet
    news.publish_events(w)
    result = radio_public_news(w,station)
    assert(result.event == id and result.text.contains("attack"))
    assert(w.places[0].news[0].event == id)
    w.places[0].news = [w.places[0].news[0]]
    w.places[0].news[0].private_fact = true
    assert(radio_public_news(w,station).event < 0)
    w.places[0].news[0].private_fact = false
    w.places[0].news[0].confidence = 500
    assert(radio_public_news(w,station).event < 0)
    w.places[0].news[0].confidence = 700
    assert(radio_public_news(w,station).text.contains("unconfirmed"))
    w.minute = 1440
    assert(radio_public_news(w,station).event < 0)
    assert(radio_public_news(w,radio_stations()[1]).event < 0) # no remote-country seat assigned

test "radio weather and propaganda are explicit observations and editorials":
    w = seed.build_world()
    s = radio_stations()[4]
    report = radio_weather_content(w,s,false)
    assert(report.text.contains("observation") and report.text.contains("west"))
    assert(radio_weather_content(w,s,true).code == "SEA PORT OPEN")
    w.places[2].harbor_closed = true
    assert(radio_weather_content(w,s,true).code == "SEA PORT SHUT")
    loop i in 0..3:
        text = radio_content(w,radio_stations()[i],.editorial)
        assert(text.title == "State editorial" and text.code.contains("CIV"))

test "mute pause and leaving aircraft clear playback and hidden transcripts":
    r = Radio()
    radio_tune(r,620); radio_receive(r,0,10,vec3(0,400,0),flat)
    r.content = RadioContent("Test","Public test","ARC")
    assert(radio_snapshot(r).transcript == "")
    radio_mute(r,false)
    radio_play(r,20,true,false,0,false)
    assert(r.active and r.voice == -1 and not r.ready and r.generated == 0)
    assert(radio_snapshot(r).transcript == "Public test")
    radio_silence(r)
    assert(not r.active and radio_snapshot(r).transcript == "")
    radio_play(r,20,true,false,0,false)
    radio_play(r,20,false,false,0,false)
    assert(not r.active and radio_snapshot(r).station == -1)
    radio_mute(r,true); assert(r.muted and r.voice == -1)

test "radio stream work and queue are bounded and tuning releases the old voice":
    r = Radio(); radio_mute(r,false)
    radio_tune(r,620); radio_receive(r,0,10,vec3(0,400,0),flat)
    radio_play(r,20,true,true,1,true)  # SLOPPY_NO_AUDIO uses the silent mixer, never an audio device
    assert(r.ready and r.voice >= 0 and r.generated <= RADIO_RATE/4)
    assert(queued_samples(r.voice) <= RADIO_RATE/4)
    old = r.voice
    radio_tune(r,780)
    assert(r.voice == -1 and not is_playing(old))
    radio_receive(r,0,10,vec3(0,400,0),flat)
    radio_play(r,5000,true,true,1,true)
    assert(r.generated <= RADIO_RATE/4)
    radio_mute(r,true)
    assert(r.voice == -1 and not r.active)

test "station seeking wraps and skips the silent pirate transmitter":
    r = Radio(); radio_tune(r,1260)
    radio_seek(r,1,0); assert(r.khz == 620)
    radio_seek(r,-1,0); assert(r.khz == 1260)
    radio_seek(r,1,600); assert(r.khz == 1460)
    radio_seek(r,1,600); assert(r.khz == 620)
    radio_seek(r,-1,600); assert(r.khz == 1460)

test "world clock rewinds discard queued future programmes":
    r = Radio(); radio_mute(r,false)
    radio_tune(r,620); radio_receive(r,0,10,vec3(0,400,0),flat)
    radio_play(r,25,true,false,0,true)
    old = r.voice
    radio_play(r,20,true,false,0,true)
    assert(not is_playing(old) and r.voice != old)
    assert(r.synth.cursor == int(20.25*f64(RADIO_RATE)))
    radio_silence(r)


test "short bulletin identifiers fit within their ten second slots":
    loop code in ["ARC QRU","ARC ATK","KAL RES","ORN DITCH","ARC SHUT","ARC LOW","ARC DLV","ARC FIX","ARC ARR","ARC DEP","ARC FINE","ARC NEWS","ARC CIV","KAL CIV","ORN CIV","BLU AD","GUL QUIZ"]:
        assert(radio_morse(code).len()*1280 <= RADIO_RATE*10)

test "Morse joins the scheduled bulletin and maritime content remains stable for its slot":
    w = seed.build_world()
    r = Radio(); cache = RadioBulletinCache(); radio_mute(r,false)
    radio_tune(r,1260); radio_receive(r,0,0,vec3(5980,500,-4420),flat)
    radio_update_content(r,cache,w)
    assert(cache.slot == 570/15)
    w.minute = 5; w.places[2].harbor_closed = true
    radio_update_content(r,cache,w)
    assert(cache.slot == 570/15)
    radio_play(r,7,true,false,0,true)
    assert(r.synth.morse_origin == 0)
    radio_silence(r)
    radio_tune(r,620); radio_receive(r,0,5,vec3(0,400,0),flat)
    radio_play(r,13,true,false,0,true)
    assert(r.synth.morse_origin == 10*RADIO_RATE)
    radio_silence(r)
