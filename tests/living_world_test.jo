use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_checks.jo'
use '../src/living_travel.jo'
use '../src/living_pirates.jo'
use '../src/living_news.jo'
use '../src/living_text.jo'

sweep = (seeds: int[], days: int):
    loop seed in seeds:
        w = build_world(u64(seed))
        last_flight = 0; last_count = w.next_trip
        heard_raid = -1; patrol_before = 0
        loop minute in 1..days*1440+1:
            before_patrol = w.patrol_departures
            advance_minutes(w,1)
            if w.next_trip > last_count:
                loop id in last_count..w.next_trip:
                    if w.trips[id].mode == .aircraft and w.trips[id].actor != 0: last_flight = w.minute
                last_count = w.next_trip
            if heard_raid < 0:
                loop n in w.places[0].news:
                    if n.kind == .raid and n.reason.actor == 22:
                        heard_raid = w.minute; patrol_before = before_patrol
            if heard_raid >= 0 and w.minute == heard_raid+1440:
                assert(w.patrol_departures > patrol_before)
            if minute%60 == 0:
                errors = invariant_errors(w)
                if errors.len() > 0:
                    print("FAIL seed={seed}, minute={w.minute}: {errors}")
                    loop p in w.people:
                        if p.action.end_minute+60 < w.minute: print(p.id,p.action)
                assert(errors.len() == 0)
                # A reachable service world must not silently stop all NPC flight for two days.
                if w.minute-last_flight > 2880:
                    open = false
                    loop p in [2,8,11,9,22]:
                        loop destination in 0..6:
                            if travel_feasible(w,p,destination): open = true
                    if open: print("STALL seed={seed} minute={w.minute} last flight={last_flight}")
                    assert(not open)
        assert(w.raid_departures >= 1 and w.next_encounter >= 1 and w.patrol_departures >= 1)
        assert(w.raid_departures <= days+1)
        print("seed {seed}: {w.next_trip} trips; {w.raid_departures} sorties; {w.next_encounter} contacts; {w.patrol_departures} patrols; subsidies {w.emergency_subsidies}")

test "thirty days no silent absorbing state smoke or release seeds":
    if env("LIVING_RELEASE_SWEEP") == "1": sweep([0..128),30)
    else: sweep([0,1,7,42,127],30)
