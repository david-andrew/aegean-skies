use '../src/living_types.jo'
use '../src/living_far_people.jo'
use '../src/living_far_social.jo'
use '../src/living_far_news.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

test "far speech carries an actual dated account only at a real meeting and never from an occupant":
    w=commission_fixture(); a=promote_far_person(w,100,.trader); b=promote_far_person(w,100,.keeper)
    assert(a>=0 and b>=0)
    # The fixture's coincident counter is an actual venue, not a symbolic district match.
    venue=far_person_venue(w,a)
    w.people[a].pose.pos=venue.pos; w.people[b].pose.pos=venue.pos
    w.far.people[a].target=venue.pos; w.far.people[b].target=venue.pos
    event=far_local_news(w,100,"occupation","The flags were changed at the quay.",country=2,severity=900)
    far_hear_counter(w,a,100)
    assert(w.people[a].far_reports.len()>0,"The witness must actually hear the account.")
    assert(far_social_ready(w,a) and far_social_ready(w,b),"Both people must be free and arrived.")
    far_social_minute(w)
    # Ensure the bounded slice visits this district while the day is still at the market.
    loop i in 1..36:
        w.minute=i*5; w.tick=w.minute*120
        far_social_minute(w)
    assert([loop r in w.people[b].far_reports: if r.id==event: r].len()==1)
    assert(w.speech[a].sequence>0 and w.speech[b].sequence>0)
    prior=w.speech[a].sequence
    w.far.people[a].vehicle=0
    loop i in 36..60:
        w.minute=i*5; w.tick=w.minute*120; far_social_minute(w)
    assert(w.speech[a].sequence==prior)
