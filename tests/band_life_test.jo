# The hotel's band as people: they walk to the terrace of an evening, a number starts only once
# its players have walked to the stand and stepped up, they step down and go about their evening
# after; a number asked for waits for its players, who can be sent for through the ledger; one who
# can't come means their numbers are passed over. Nobody jumps from one place to another.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/life_types.jo'
use '../src/living_life.jo'
use '../src/leisure.jo'
use '../src/band_roster.jo'
use '../src/band_life.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'

_bar = () -> LeisurePlace: LeisurePlace("hotel", 0, .bar, "Hotel Ancora", "hotel and terrace bar", 6, opens = 420, closes = 120, room_cents = 600)

# The roles each number of the evening set needs (as the hotel's: the pianist alone, piano and
# violin with the singer, the pianist alone, guitar and mandolin, violin and guitar).
ROLES = [[1], [1, 3, 0], [1], [2, 3], [3, 2]]

# A seeded world with the hotel's terrace by Porto Vecchio's cafe, and the band's programme: each
# number twenty game minutes long, the stand's places and steps beside the terrace.
_band_world = (seed: int = 3) -> World:
    w = build_world(u64(seed))
    at = w.people[6].pose.pos
    loop v in w.life_venues:
        if v.place == 0 and v.kind == .cafe: at = v.pos
    terrace = at + vec3(18, 0, 6)
    publish_leisure_venue(w, LifeVenue(0, "hotel-ancora" + TERRACE_VENUE_SUFFIX, .cafe, terrace, facing = vec3(0, 0, 1), capacity = 16, covered = false, prop_pos = terrace + vec3(0, 0, -5)))
    numbers: BandNumber[]
    loop roles in ROLES:
        n = BandNumber(120 * 20, roles)
        n.spots = [loop r in 0..4: terrace + vec3(-14, 0.3, f32(r) * 1.2)]
        n.steps = [loop r in 0..4: terrace + vec3(-11.5, 0, f32(r) * 1.2)]
        n.yaws = fill(0.0, 4)
        numbers.push(n)
    band_publish(w, numbers, 1140, 1410, 420)
    w

_local = (w: World) -> int: local_minute(w.minute)

# Every band player's place a minute apart: none moves further than a walk (or a bicycle) allows.
_steady = (before: vec3[], w: World) -> bool:
    loop k in 0..BAND_ROSTER.len():
        if f64(length(w.people[BAND_ROSTER[k]].pose.pos - before[k])) > 9.0: return false
    true

_poses = (w: World) -> vec3[]: [loop p in BAND_ROSTER: w.people[p].pose.pos]

test "an evening: the players come to the terrace, each number waits for its players to step up, then they step down and go":
    w = _band_world()
    advance_minutes(w, 1020 - 570)                 # 17:00
    started = 0
    seen_waiting = false
    last_index = -1
    loop _m in 0..(1440 - 1020 - 5):
        before = _poses(w)
        advance_minutes(w, 1)
        assert(_steady(before, w), "a jump at {_local(w)}")
        b = w.band
        if b.index >= 0 and b.start < 0: seen_waiting = true
        # (a number only ever begins with all its players up, climbed and settled)
        if b.index >= 0 and b.start >= 0 and b.index != last_index:
            started += 1
            assert(b.called.len() == ROLES[b.index].len())
            loop k in 0..b.called.len():
                assert(b.up[k] >= 0 and b.up[k] + BAND_CLIMB + BAND_SETTLE <= b.start)
                assert(band_role(b.called[k]) in ROLES[b.index])
            last_index = b.index
        if b.index < 0: last_index = -1
        # (while a number plays, its players are at the stand's steps, held there by the world)
        if band_playing(b, w.tick):
            loop person in b.called:
                assert(w.daily_life[person].activity == .work and band_on_stage(w, person), "{w.people[person].name} at {_local(w)}: {w.daily_life[person].activity} {w.daily_life[person].reason} on {band_on_stage(w, person)} band {to_text(b)}")
    assert(started >= 2, "{started}")
    assert(seen_waiting)
    # after the evening: nobody on the stand, nobody called, the players gone from the hotel
    advance_minutes(w, 10)
    assert(w.band.called.len() == 0 and w.band.packing.len() == 0 and w.band.index < 0)
    loop p in BAND_ROSTER: assert(band_wanted(w, p) == 0 and not band_on_stage(w, p))

test "the same evening twice is the same evening":
    a = _band_world(); b = _band_world()
    advance_minutes(a, 1260 - 570); advance_minutes(b, 1260 - 570)
    assert(to_text(a.band) == to_text(b.band))
    assert(to_text(a.band) == to_text(from_text[BandState](to_text(a.band)).unwrap()))

test "a number asked for in the afternoon waits; the players sent for walk in, play it, and go":
    w = _band_world()
    lp = _bar()
    state = LeisureState()
    advance_minutes(w, 960 - 570)                  # 16:00
    r = leisure_request(w, lp, state, 1, "Ave Maria")
    assert(r.ok and r.cents == BAND_TIP)
    missing = band_missing(w, 1)
    assert(missing.len() > 0)
    # nothing starts while they aren't here
    advance_minutes(w, 20)
    assert(w.band.index < 0 or w.band.start < 0)
    total = 0
    loop a in w.accounts: total += a.cents
    mine = w.accounts[w.people[w.player].account].cents
    house = w.accounts[w.people[6].account].cents
    sent = 0
    loop q in missing:
        o = leisure_fetch(w, lp, q)
        if o.ok: sent += 1
        else: assert(o.message != "")
    assert(sent > 0)
    assert(w.accounts[w.people[w.player].account].cents == mine - sent * FETCH_TIP)
    assert(w.accounts[w.people[6].account].cents == house + sent * FETCH_TIP)
    after = 0
    loop a in w.accounts: after += a.cents
    assert(after == total and money_balances(w))
    # (any who couldn't be sent for are waited for as they come free; the rest walk in)
    began = -1
    loop _m in 0..240:
        before = _poses(w)
        advance_minutes(w, 1)
        assert(_steady(before, w))
        if w.band.index == 1 and w.band.start >= 0: began = _local(w); break
    assert(sent == missing.len() and began >= 0 and began < BAND_GATHER, "{sent} {began}")
    loop k in 0..w.band.called.len(): assert(w.band.up[k] >= 0)
    # played through, the ones sent for put their instruments away and go back to their day
    loop _m in 0..40:
        before = _poses(w)
        advance_minutes(w, 1)
        assert(_steady(before, w))
        if w.band.index < 0 and w.band.called.len() == 0 and w.band.packing.len() == 0: break
    assert(_local(w) < BAND_GATHER)
    loop p in missing: assert(band_wanted(w, p) == 0 and not band_on_stage(w, p))

test "a player who can't come tonight: their numbers are passed over, the rest are played":
    w = _band_world()
    # (the singer laid up for the evening)
    w.people[BAND_ROSTER[0]].injured_until = w.minute + 24 * 60
    advance_minutes(w, 1135 - 570)
    played: int[]
    loop _m in 0..270:
        advance_minutes(w, 1)
        if w.band.index >= 0 and w.band.start >= 0 and not (w.band.index in played): played.push(w.band.index)
    assert(played.len() >= 2)
    assert(not (1 in played))
    loop i in played: assert(not (0 in ROLES[i]))

test "the musicians can't be sent for in the night, away, or at work":
    w = _band_world()
    advance_minutes(w, 1400 - 570 + 60)            # past midnight's bed time
    assert(band_fetch_refusal(w, BAND_ROSTER[1]).contains("bed"))
    assert(band_fetch_refusal(w, 9).contains("don't play"))
    # (the fetch panel says those sharing a reason together, not once a name)
    abed = [BAND_ROSTER[0], BAND_ROSTER[1], BAND_ROSTER[2]]
    firsts = [loop q in abed: split(w.people[q].name, " ")[0]]
    said = band_missing_said(w, abed, (q: int) -> str: "is about")
    assert(said == "{firsts[0]}, {firsts[1]} and {firsts[2]} will have gone to bed.", said)
    # (at three in the afternoon, the pianist is at his desk in the harbour office)
    v = _band_world()
    advance_minutes(v, 900 - 570)
    assert(band_fetch_refusal(v, BAND_ROSTER[1]) == "Yannis can't come until the work is done.")
    o = leisure_fetch(v, _bar(), BAND_ROSTER[1])
    assert(not o.ok and o.cents == 0)

# A save of the world mid-evening (the band called, players up, numbers queued) reads back valid
# and identical, and the two go on identically for a day.
_band_roundtrip = (w: World):
    text = canonical_text(w)
    parsed = from_text[World](text)
    if parsed is TextError: panic("{parsed}")
    assert(validate_save_world(parsed) == "")
    assert(canonical_text(parsed) == text)
    a = w; b = parsed
    advance_minutes(a, 1440); advance_minutes(b, 1440)
    assert(canonical_text(a) == canonical_text(b))

# (BAND_LONG=1: thirty days each, as the long replays; otherwise two)
test "the band through many evenings on several seeds: the world's checks hold, saves mid-evening continue identically":
    days = if env("BAND_LONG") == "1": 30 else: 2
    loop seed in [0, 1, 7, 42, 127]:
        w = _band_world(seed)
        started = 0
        last_start = -1
        loop day in 0..days:
            # (through the evening a minute at a time, the rest of the day an hour at a time)
            advance_minutes(w, ((1080 - _local(w)) % 1440 + 1440) % 1440)
            loop _m in 0..400:
                advance_minutes(w, 1)
                b = w.band
                assert(b.called.len() == b.roles.len() and b.called.len() == b.up.len())
                assert(b.packing.len() == b.packing_role.len() and b.packing.len() == b.packing_until.len())
                if b.start >= 0 and b.start != last_start: started += 1; last_start = b.start
                # (a request mid-evening on the fifth day, and a save while the band is busy)
                if day == days / 2 and _m == 150:
                    band_ask(w, (seed + day) % w.band.numbers.len())
                    _band_roundtrip(w)
            errors = invariant_errors(w)
            if errors.len() > 0: print("FAIL seed={seed} day={day}: {errors}")
            assert(errors.len() == 0)
            assert(money_balances(w))
        assert(started >= days, "seed {seed}: {started} numbers in {days} evenings")
        print("seed {seed}: {started} numbers in {days} evenings")

test "the band's names read as a list, and none of its words say quay":
    assert(names_list([]) == "" and names_list(["Yannis"]) == "Yannis")
    assert(names_list(["Yannis", "Marta"]) == "Yannis and Marta")
    assert(names_list(["Yannis", "Marta", "Leila"]) == "Yannis, Marta and Leila")
    w = _band_world()
    lp = _bar()
    state = LeisureState()
    advance_minutes(w, 900 - 570)                  # 15:00: the pianist at his desk
    r = leisure_request(w, lp, state, 1, "Ave Maria")
    assert(r.ok and r.message.contains("Yannis, Marta and Leila") and not r.message.contains("quay"))
    loop p in BAND_ROSTER: assert(not band_fetch_refusal(w, p).contains("quay"))
