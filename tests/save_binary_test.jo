use 'game_session.jo'
use 'living_far_economy.jo'
use '../src/game_slots.jo'
use '../src/game_session.jo'
use '../src/living_types.jo'
use '../src/living_save.jo'
use '../src/living_save_codec.jo'
use '../src/combat.jo'
use '../src/vessel_types.jo'
use '../src/bytes_shim.jo'

# Saves in the binary form (slot encoding 4): the World as world_to_bytes writes it, read back by
# world_from_bytes; text saves (encodings 2 and 3) still load, and a slot's next save is written
# in the form save_binary says.

empty_slots = () -> GameSlots:
    slots=GameSlots(); init_game_slots(slots)
    loop id in 0..3: assert(delete_game_slot(slots,id) and slots.error=="")
    slots

slot_game = (fondness: int) -> SaveGame:
    f=session_fixture(); p=PresentationState(); p.cat_bonds[7]=CatBond(fondness=fondness)
    game=capture_game(f.0,p,f.1,[],f.2,VesselFleet(),Battle(),123,SaveSummary(minute=0,place=0,place_name="Porto Vecchio",player_name="Pilot",mode="walking"))
    assert(game is SaveGame)
    game

# (as the game saves: spread over many short steps)
save_spread = (slots: mut GameSlots, slot: int, game: SaveGame):
    assert(save_game_slot(slots,slot,game,spread=true),slots.error)
    loop slots.phase=="pack": step_game_slots(slots,0.0)
    assert(not slots.busy and slots.error=="",slots.error)

# the slot's newest header (the bank with the higher generation)
newest = (slot: int) -> BinaryLivingSave:
    a=slot_header(slot_header_text(slot,0)); b=slot_header(slot_header_text(slot,1))
    if b.valid and (not a.valid or b.generation>a.generation): b else: a

loaded = (slots: mut GameSlots, slot: int) -> SaveGame:
    assert(load_game_slot(slots,slot,123) and slots.error=="",slots.error)
    take_game_slot(slots)!

test "a World written as bytes reads back as the same World":
    w=far_fixture(); far_only_minutes(w,120)
    back=world_from_bytes(world_to_bytes(w))
    assert(back is World)
    assert(to_text(back)==to_text(w))

test "a binary save loads back the World it was made from, map order and all":
    set_save_binary(true)
    defer set_save_binary(false)
    slots=empty_slots()
    game=slot_game(250)
    save_spread(slots,0,game)
    assert(newest(0).encoding==4)
    back=loaded(slots,0)
    assert(to_text(back.world)==to_text(game.world))
    assert(back.presentation.cat_bonds[7].fondness==250 and back.session==game.session)

test "a text save still loads, and the slot's next save is written in bytes":
    slots=empty_slots()
    old=slot_game(100)
    set_save_binary(false)
    save_spread(slots,1,old)
    assert(newest(1).encoding==3)
    set_save_binary(true)
    defer set_save_binary(false)
    back=loaded(slots,1)
    # (a text save holds the canonical World, maps in key order; a binary one, the World as it was)
    assert(canonical_text(back.world)==canonical_text(old.world) and back.presentation.cat_bonds[7].fondness==100)
    later=slot_game(300)
    save_spread(slots,1,later)
    assert(newest(1).encoding==4)
    again=loaded(slots,1)
    assert(to_text(again.world)==to_text(later.world) and again.presentation.cat_bonds[7].fondness==300)
