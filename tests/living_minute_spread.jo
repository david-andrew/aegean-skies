use '../src/living_types.jo'
use '../src/living_sim.jo'
use '../src/living_guard.jo'
use '../src/living_save.jo'
use 'living_far_economy.jo'

# The minute's rules one unit per call, as a game spreads them over frames.
spread_minutes = (w: mut World, minutes: int) -> int:
    pieces=0
    loop _ in 0..minutes:
        target=(w.tick/TICKS_PER_MINUTE+1)*TICKS_PER_MINUTE
        w.tick=target; w.minute=target/TICKS_PER_MINUTE
        run=minute_run_begin(w)
        loop not minute_run_step(w,run,0.0): pieces+=1
    pieces

test "a world minute in pieces is the same minute as all at once":
    whole=far_fixture(); whole.far.districts[200].target[3]+=20000
    pieces=whole
    far_only_minutes(whole,2*1440)
    count=spread_minutes(pieces,2*1440)
    assert(count>2*1440*30)
    assert(canonical_text(pieces)==canonical_text(whole))

test "in recovery mode too, guarded checkpoint and all":
    whole=far_fixture(); whole.far.districts[200].target[3]+=20000
    pieces=whole
    set_living_strict(false)
    defer set_living_strict(true)
    epoch=living_fault_epoch()
    far_only_minutes(whole,1440)
    spread_minutes(pieces,1440)
    assert(living_fault_epoch()==epoch)
    assert(canonical_text(pieces)==canonical_text(whole))
