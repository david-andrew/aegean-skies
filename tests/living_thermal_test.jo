use '../src/living_types.jo'
use '../src/thermal_types.jo'
use '../src/life_types.jo'
use '../src/living_far_types.jo'
use '../src/living_money.jo'
use '../src/living_calendar.jo'
use '../src/living_thermal.jo'
use '../src/living_seed.jo'
use '../src/living_place_context.jo'
use '../src/living_far_economy.jo'
use '../src/living_checks.jo'

thermal_fixture=()->World:
    w=build_world(u64(42));contexts:LifePlaceContext[]
    loop k in 0..6:contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    contexts.push(LifePlaceContext(141625,"Saryerenos",1,4,vec3(-47284,138,-45986)))
    assert(publish_place_contexts(w,1,contexts,[-1,141625,-1]))
    assert(populate_settlement_economy(w,1,[FarPlaceSeed(141625,80,1,7)],[]));w

test "soaking advances the real world and restores existing fatigue without creating money":
    w=thermal_fixture();v=ThermalVisit();w.people[w.player].fatigue=600
    accounts=to_text(w.accounts);pos=vec3(-47284,139,-45986)
    assert(thermal_begin(w,v,141625,pos)=="")
    assert(to_text(w.accounts)==accounts and w.people[w.player].state==.resting)
    tick=w.tick;minute=w.minute
    assert(thermal_advance(w,v,60)==60 and w.minute==minute+60 and w.tick==tick+60*TICKS_PER_MINUTE)
    assert(w.people[w.player].fatigue==480 and money_balances(w))
    thermal_end(w,v);assert(not v.active and w.people[w.player].state==.idle)
    assert(invariant_errors(w).len()==0)

test "an inn charges real rent once and honours its booking after interruption and serialization":
    w=thermal_fixture();v=ThermalVisit();payer=w.people[w.player].account;owner=w.far.districts[141625].market_account
    before=w.accounts[payer].cents;received=w.accounts[owner].cents
    assert(thermal_begin(w,v,141625,vec3(1,2,3),true)=="")
    assert(w.accounts[payer].cents==before-THERMAL_INN_CENTS and w.accounts[owner].cents==received+THERMAL_INN_CENTS)
    assert(w.ledger.recent[w.ledger.recent.len()-1].kind==.rent and money_balances(w))
    due=v.paid_until;assert(local_minute(due)==420 and due>w.minute)
    thermal_end(w,v)
    saved=from_text[ThermalVisit](to_text(v));assert(saved is ThermalVisit);v=saved
    cash=to_text(w.accounts)
    assert(thermal_begin(w,v,141625,vec3(1,2,3),true)=="" and to_text(w.accounts)==cash and v.until==due)
    assert(thermal_begin(w,v,141625,vec3(1,2,3),true)!="" and to_text(w.accounts)==cash)

test "an unaffordable room refuses atomically and evening and morning cross midnight correctly":
    w=thermal_fixture();v=ThermalVisit();payer=w.people[w.player].account;owner=w.far.districts[141625].market_account
    assert(transfer(w,payer,owner,w.accounts[payer].cents,.trade))
    accounts=to_text(w.accounts);ledger=to_text(w.ledger);state=w.people[w.player].state
    assert(thermal_begin(w,v,141625,vec3(1,2,3),true)!="")
    assert(not v.active and v.paid_until<0 and to_text(w.accounts)==accounts and to_text(w.ledger)==ledger and w.people[w.player].state==state)
    loop minute in [0,570,870,1440,2880]:
        loop hour in [7,18]:
            target=thermal_until(minute,hour)
            assert(target>minute and target<=minute+1440 and local_minute(target)==hour*60)
