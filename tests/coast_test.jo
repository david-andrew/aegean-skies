use '../src/coast_field.jo'
use '../src/coast_mesh.jo'
use '../src/coast_support.jo'
use '../src/coast_atlas.jo'
use '../src/world.jo'
use '../src/world_source.jo'
use '../src/geography.jo'

test "coastal relief preserves canonical vertices and dry deep ground":
    h = vec4(-12,17,-3,42)
    loop p in [vec2(0,0),vec2(1,0),vec2(0,1),vec2(1,1)]:
        assert(coast_vertex_height(h,p,vec2(-5012,-2436)) == coast_triangle(h,p))
    loop y in [-60.0,-40.0,192.0,3000.0]:
        loop k in 0..31:
            f = vec2(f32(k)/31.0,0.31)
            flat = vec4(f32(y),f32(y),f32(y),f32(y))
            assert(coast_vertex_height(flat,f,vec2(220000,-120000)) == f32(y))

test "contact uses precisely the finest drawn triangles at negative and country coordinates":
    h = vec4(-12,17,-3,42)
    loop origin in [vec2(-5012,-2436),vec2(219996,-120008)]:
        loop k in 0..100:
            f = vec2(f32(k%13)/13.0,f32(k%19)/19.0)
            physics = coast_contact(f64(h.x),f64(h.y),f64(h.z),f64(h.w),f64(f.x),f64(f.y),f64(origin.x),f64(origin.y))
            rendered = coast_at_level(h,f,origin,6.0)
            assert(abs(physics-f64(rendered)) < 0.00001)

test "adjacent cells share every edge through arbitrary mixed morph levels":
    a = CoastInstance(vec2(0,0),vec2(-5012,-2436),vec2(0,0),vec4(-12,3,-3,7),5.6,vec4(5.6,2.35,5.6,5.6))
    b = CoastInstance(vec2(14,0),vec2(-4998,-2436),vec2(1,0),vec4(3,17,7,42),2.35,vec4(2.35,2.35,2.35,2.35))
    loop j in 0..65:
        f = f32(j)/64.0
        assert(abs(coast_mesh_height(a,vec2(1,f))-coast_mesh_height(b,vec2(0,f))) < 0.00002)

test "projection selects no far refinement and all tiers converge at contact":
    loop focal in [150.0,300.0,600.0,1200.0]:
        assert(coast_level(0,0,-3,12,vec3(4,2,4),focal) == 6.0)
        assert(coast_level(0,0,-3,12,vec3(4,2000,4),focal) == 0.0)
        loop distance in [2.0,50.0,300.0,2000.0]:
            cam = vec3(f32(distance),21,7)
            cpu = coast_level(0,0,-3,12,cam,focal)
            assert(cpu >= 0.0 and cpu <= 6.0)
            # Ground far above the eye must not receive contact tessellation.
            high_cell = coast_level(0,0,90,110,cam,focal)
            assert(high_cell <= cpu)

test "each sub source band adds actual geometric detail":
    h = vec4(-1,2,-2,3)
    origin = vec2(-5012,-2436)
    loop level in 1..7:
        difference = 0.0
        loop k in 0..200:
            f = vec2(f32(k%31)/31.0,f32(k%23)/23.0)
            difference += f64(abs(coast_at_level(h,f,origin,f32(level))-coast_at_level(h,f,origin,f32(level-1))))
        assert(difference > 0.02)

test "shallow fringes form emerged skerries and flooded inlets":
    raised = 0; flooded = 0
    loop cell in 0..8:
        loop j in 0..33:
            loop i in 0..33:
                f = vec2(f32(i)/32.0,f32(j)/32.0)
                origin = vec2(13160+f32(cell)*14.0,-37002)
                if coast_vertex_height(vec4(-0.1,-0.1,-0.1,-0.1),f,origin) > 0.1: raised += 1
                if coast_vertex_height(vec4(0.1,0.1,0.1,0.1),f,origin) < -0.1: flooded += 1
    assert(raised > 20 and flooded > 20)

test "new coast cached contact and pure physics agree without camera state":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    isl = small_islands[0]
    loop k in 0..100:
        x = f64(isl.center.x)+f64(isl.radii.x)+f64(k-50)*0.73
        z = f64(isl.center.y)+f64(k%13)*0.43
        assert(abs(world_source_surface(x,z)-new_land_surface(x,z)) < 0.00001)


test "refined shore contact leaves the broad optical band unchanged":
    loop optical in [0.1,1.0,3.0,12.0]:
        assert(coast_shore_depth(f32(optical),2.0) == f32(optical))
        assert(coast_shore_depth(f32(optical),0.0) == 0.0)
        value = coast_shore_depth(f32(optical),0.75)
        assert(value >= min(f32(optical),0.75) and value <= max(f32(optical),0.75))

test "independent tiles share edges despite different interior height bounds":
    cam = vec3(7,2,7)
    left: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
    right: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
    coast_add_patch(left,[-3,80,-2,90],2,2,0,0,0,0,1,vec2(0,0),cam,vec3(0,0,0),600,[])
    coast_add_patch(right,[80,110,90,120],2,2,14,0,0,0,1,vec2(0,0),cam,vec3(0,0,0),600,[])
    outer: CoastInstance[]
    loop group in left:
        loop part in group:
            if part.region.x+part.region.z == 1.0: outer.push(part)
    neighbor = CoastInstance()
    loop group in right:
        if group.len() > 0: neighbor = group[0]
    assert(outer.len() == 2 and neighbor.region.z == 1.0)
    loop part in outer:
        assert(part.edges.y == neighbor.edges.x)
        loop j in 0..33:
            f = part.region.y+part.region.z*f32(j)/32.0
            assert(abs(coast_mesh_height(part,vec2(1,f))-coast_mesh_height(neighbor,vec2(0,f))) < 0.00002)


test "cell selections survive small camera moves and invalidate changed sources":
    reset_coast_selection()
    before = coast_selection_builds
    loop frame in 0..4:
        begin_coast_selection()
        batches: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
        cam = vec3(if frame >= 2: 7.001 else: 7.0,2,7)
        coast_add_patch(batches,[-3,3,-2,4],2,2,0,0,0,0,1,vec2(0,0),cam,vec3(0,0,0),600,[],source_id=if frame == 3: 2 else: 1)
        expected = if frame == 3: 2 else: 1
        assert(coast_selection_builds-before == expected)
    reset_coast_selection()

test "local near-cell domains preserve internal edges through their morphs":
    inst = CoastInstance(vec2(0,0),vec2(0,0),vec2(0,0),vec4(-3,3,-2,4),6,vec4(4.2,4.2,4.2,4.2))
    batches: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
    coast_emit_cell(batches,inst,0,0,vec3(-4,2,3),600)
    parts: CoastInstance[]
    loop group in batches: parts.extend(group)
    assert(parts.len() == 4)
    loop a in parts:
        loop b in parts:
            if a.region.x+0.5 == b.region.x and a.region.y == b.region.y:
                loop j in 0..33:
                    p = vec2(b.region.x,a.region.y+f32(j)/64.0)
                    assert(abs(coast_mesh_height(a,p)-coast_mesh_height(b,p)) < 0.00002)
            if a.region.y+0.5 == b.region.y and a.region.x == b.region.x:
                loop j in 0..33:
                    p = vec2(a.region.x+f32(j)/64.0,b.region.y)
                    assert(abs(coast_mesh_height(a,p)-coast_mesh_height(b,p)) < 0.00002)

test "LOD hysteresis holds on reversal and snaps to exact contact":
    reset_coast_selection()
    key = CoastLevelKey(0,0,vec4(-3,3,-2,4),0)
    assert(coast_hold(key,2.0) == 2.0)
    assert(coast_hold(key,2.08) == 2.0)
    assert(coast_hold(key,2.10) == 2.125)
    assert(coast_hold(key,2.04) == 2.125)
    assert(coast_hold(key,2.02) == 2.0)
    assert(coast_hold(key,6.0) == 6.0)
    reset_coast_selection()

test "cached cell geometry rebinds atlas slots and render charts":
    reset_coast_selection()
    before = coast_selection_builds
    loop frame in 0..2:
        begin_coast_selection()
        batches: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
        origin = vec3(f32(frame)*1024.0,0,0)
        slot = vec2(f32(frame)*17.0,0)
        coast_add_patch(batches,[-3,3,-2,4],2,2,0,0,0,0,1,slot,vec3(7,2,7),origin,600,[],source_id=1)
        assert(coast_selection_builds == before+1)
        loop group in batches:
            loop part in group:
                assert(part.origin == -origin.xz and part.texel == slot)
    reset_coast_selection()

coast_test_edge = (batches: CoastInstance[][],p: vec2) -> f32:
    loop group in batches:
        loop part in group:
            r = part.region
            if p.x >= r.x and p.y >= r.y and p.x <= r.x+r.z and p.y <= r.y+r.z:
                n = f32(1<<coast_grid_level(part))
                step = r.z/n
                local = clamp(floor((p-r.xy)/step),vec2(0,0),vec2(n-1,n-1))
                a = r.xy+local*step
                h = vec4(coast_mesh_height(part,a),coast_mesh_height(part,a+vec2(step,0)),coast_mesh_height(part,a+vec2(0,step)),coast_mesh_height(part,a+vec2(step,step)))
                return coast_triangle(h,(p-a)/step)
    panic("missing edge owner")

test "shared edges retain parity when a streamed neighbor arrives during motion":
    reset_coast_selection()
    loop step in 0..40:
        begin_coast_selection()
        cam = vec3(-80+f32(step)*4.0,5,7)
        right: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
        coast_add_patch(right,[3,2,4,7],2,2,14,0,0,0,1,vec2(0,0),cam,vec3(0,0,0),600,[],source_id=2)
        if step%3 != 0: continue
        left: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
        coast_add_patch(left,[-3,3,-2,4],2,2,0,0,0,0,1,vec2(0,0),cam,vec3(0,0,0),600,[],source_id=1)
        loop k in 0..65:
            f = f32(k)/64.0
            assert(abs(coast_test_edge(left,vec2(1,f))-coast_test_edge(right,vec2(0,f))) < 0.00002)
    reset_coast_selection()

test "near depth bounds contain every refined vertex and reject distant batches":
    inst=CoastInstance(vec2(-7,-7),vec2(219996,-120008),vec2(0,0),vec4(-4,6,-2,8),6,vec4(6,6,6,6))
    eye=vec3(0,2,0)
    assert(coast_batch_near([inst],eye))
    loop j in 0..65:
        loop k in 0..65:
            f=vec2(f32(k)/64.0,f32(j)/64.0)
            xz=inst.origin+f*14.0
            assert(length(vec3(xz.x,coast_mesh_height(inst,f),xz.y)-eye)<126.0)
    far=inst;far.origin+=vec2(128,0)
    assert(not coast_batch_near([inst,far],eye))
    high=inst;high.heights+=vec4(128,128,128,128)
    assert(not coast_batch_near([high],eye))
    # Translating the chart and camera leaves the safety decision unchanged.
    inst.origin+=vec2(256,-512)
    assert(coast_batch_near([inst],eye+vec3(256,0,-512)))

coast_test_drawn = (batches: CoastInstance[][],p: vec2) -> f32:
    loop k in 0..COAST_LEVELS:
        loop inst in batches[k]:
            f = (p-inst.absolute)/14.0
            uv = inst.region.xy; end = uv+vec2(inst.region.z,inst.region.z)
            if f.x < uv.x or f.y < uv.y or f.x >= end.x or f.y >= end.y: continue
            step = inst.region.z/f32(1<<k)
            cell = floor((f-uv)/step)*step+uv
            hs = vec4(coast_mesh_height(inst,cell),coast_mesh_height(inst,cell+vec2(step,0)),coast_mesh_height(inst,cell+vec2(0,step)),coast_mesh_height(inst,cell+vec2(step,step)))
            return coast_triangle(hs,(f-cell)/step)
    panic("missing selected support triangle")

test "placed prop roots keep physical contact through moving coast LOD and tier changes":
    values = [loop j in 0..5: loop i in 0..5: f32(2.0+f64(i)*1.5+f64(j)*0.3)]
    loop origin in [vec2(-28,-28),vec2(219996,-120008)]:
        roots = [origin+vec2(14.03,14.01),origin+vec2(27.98,21.27),origin+vec2(21.13,22.19)]
        set_coast_support(roots)
        reset_coast_selection()
        loop focal in [300.0,400.0,600.0]:
            loop step in 0..20:
                begin_coast_selection()
                cam = vec3(origin.x+21.0+f32(step)*6.0,4,origin.y+21.0)
                batches: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
                coast_add_patch(batches,values,5,5,f64(origin.x),f64(origin.y),0,0,4,vec2(0,0),cam,vec3(0,0,0),focal,[])
                loop root in roots:
                    local = (root-origin)/14.0; cell = floor(local); f = local-cell
                    h = coast_corners(values,5,5,int(cell.x),int(cell.y))
                    absolute = origin+cell*14.0
                    physical = coast_contact(f64(h.x),f64(h.y),f64(h.z),f64(h.w),f64(f.x),f64(f.y),f64(absolute.x),f64(absolute.y))
                    drawn = coast_test_drawn(batches,root)
                    assert(abs(physical-f64(drawn)) < 0.001)
    set_coast_support([])
    reset_coast_selection()


test "compact prop domains share canonical seams and merge uniform regions":
    set_coast_support([vec2(14.03,7.11)])
    reset_coast_selection()
    loop step in 0..20:
        begin_coast_selection()
        cam = vec3(-100+f32(step)*12.0,4,7)
        left: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
        right: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
        coast_add_patch(left,[1,3,2,4],2,2,0,0,0,0,1,vec2(0,0),cam,vec3(0,0,0),400,[])
        coast_add_patch(right,[3,2,4,7],2,2,14,0,0,0,1,vec2(0,0),cam,vec3(0,0,0),400,[])
        loop k in 0..129:
            f = f32(k)/128.0
            gap = abs(coast_test_edge(left,vec2(1,f))-coast_test_edge(right,vec2(0,f)))
            if gap >= 0.00002:
                print("SEAM step={step} f={f} gap={gap}")
                loop group in left:
                    loop part in group:
                        if part.region.x+part.region.z == 1.0 and f >= part.region.y and f <= part.region.y+part.region.z: print("LEFT {part}")
                loop group in right:
                    loop part in group:
                        if part.region.x == 0.0 and f >= part.region.y and f <= part.region.y+part.region.z: print("RIGHT {part}")
            assert(gap < 0.00002)
    selected: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
    inst = CoastInstance(vec2(0,0),vec2(0,0),vec2(0,0),vec4(1,3,2,4),6,vec4(6,6,6,6))
    coast_emit_support(selected,inst,[loop k in 0..64: f32(6)],[])
    assert(selected[6].len() == 1 and selected[6][0].region == vec4(0,0,1,0))
    set_coast_support([])
    reset_coast_selection()


test "newly placed roots invalidate cached support before the next terrain draw":
    reset_coast_selection()
    roots = [vec2(7.31,7.14),vec2(21.43,8.21)]
    values = [loop j in 0..3: loop i in 0..3: f32(2.0+f64(i)*1.5+f64(j)*0.3)]
    loop root in roots:
        set_coast_support([root])
        begin_coast_selection()
        batches: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
        coast_add_patch(batches,values,3,3,0,0,0,0,2,vec2(0,0),vec3(140,4,7),vec3(0,0,0),400,[])
        cell = floor(root/14.0); f = root/14.0-cell
        h = coast_corners(values,3,3,int(cell.x),int(cell.y))
        p = cell*14.0
        physical = coast_contact(f64(h.x),f64(h.y),f64(h.z),f64(h.w),f64(f.x),f64(f.y),f64(p.x),f64(p.y))
        assert(abs(physical-f64(coast_test_drawn(batches,root))) < 0.001)
    set_coast_support([])
    reset_coast_selection()


test "camera validity balls preserve every selection through motion and invalidation":
    expected: CoastInstance[][][]
    loop mode in 0..2:
        coast_motion_cache = mode == 1
        reuses = coast_selection_reuses
        reset_coast_selection()
        set_coast_support([vec2(14.03,14.01),vec2(21.13,22.19)])
        values = [loop j in 0..5: loop i in 0..5: f32(2.0+f64(i)*1.5+f64(j)*0.3)]
        loop frame in 0..128:
            if frame == 70: values[0] += 0.1
            if frame == 90: set_coast_support([vec2(7.31,7.14)])
            begin_coast_selection()
            cam = vec3(5.0+f32(frame)/15.0,4,10.0+sin(f32(frame)*0.1))
            focal = (if frame < 42: 300.0 else: 400.0)+f64(frame%3)*0.000015
            limits = if frame < 100: vec4(6,6,6,6) else: vec4(6,6,6,3)
            batches: CoastInstance[][] = [loop k in 0..COAST_LEVELS: []]
            coast_add_patch(batches,values,5,5,0,0,0,0,4,vec2(0,0),cam,vec3(0,0,0),focal,[],limits)
            if mode == 0: expected.push(batches)
            else: assert(batches == expected[frame])
        if mode == 1: assert(coast_selection_reuses-reuses > 128)
    coast_motion_cache = true
    set_coast_support([])
    reset_coast_selection()
