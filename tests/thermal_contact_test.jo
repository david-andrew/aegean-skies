use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/thermal_sites.jo'
use '../src/objects.jo'
use '../src/world_point.jo'

some_level=(level:f64,site:ThermalSite)->f64?:some_level_of(level,site)
some_level_of=(level:f64,site:ThermalSite)->f64?:level-f64(site.center.y)

test "both baths climb from the path up their terraces by stone stairs, with solid walls":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    loop site in THERMAL_SITES:
        # Each terrace is a walking surface set into the slope: the ground under it
        # is cut below the paving, never standing through it.
        loop t in THERMAL_TERRACES:
            loop q in [mix(t.low,t.high,vec2(0.15,0.15)),mix(t.low,t.high,vec2(0.85,0.2)),mix(t.low,t.high,vec2(0.2,0.85))]:
                if length(q-THERMAL_POOL)<5.5 or length(q-THERMAL_COOL_POOL)<3.5:continue
                at=thermal_world(site,vec3(q.x,0,q.y));level=f64(site.center.y)-thermal_drop(site,t.index)
                if thermal_level(site,q)!=some_level(level,site):continue
                assert(abs(walk_height([],f64(at.x),f64(at.z))-level)<0.01,"{site.name} terrace {t.index} contact")
                assert(place_ground(at.xz)<=level+0.02,"{site.name} terrace {t.index}: ground stands through the paving at {at}")
        # From the path's arrival, up the three flights to the upper terrace.
        foot=thermal_local(site,site.road.xz)
        point=world_point(site.road);point.y=walk_height([],point.x,point.z)
        loop leg in [(vec2(4.5,f32(foot.y)),vec2(4.5,12.5)),(vec2(4.5,12.5),vec2(0,3.0)),(vec2(0,3.0),vec2(0,-3.0))]:
            goal=thermal_world(site,vec3(leg.1.x,0,leg.1.y))
            count=int(ceil(f64(length(goal.xz-vec2(f32(point.x),f32(point.z))))/0.1))
            loop k in 0..count:
                delta=vec2(f32(f64(goal.x)-point.x),f32(f64(goal.z)-point.z))/f32(count-k)
                point=walk_step_precise([],point,delta)
            assert(length(world_vec(point).xz-goal.xz)<0.3,"stairs blocked at {site.name}: {world_vec(point)} expected {goal}")
        assert(abs(point.y-f64(site.center.y))<0.05,"{site.name} upper terrace reached at {point.y}")
        entry=thermal_inn(site)
        assert(thermal_exclude(entry.xz,f64(entry.y))==entry.xz,"inn entrance blocked")
        wall=thermal_world(site,vec3(13.5,0,-8))
        assert(length(thermal_exclude(wall.xz,f64(wall.y))-wall.xz)>0.1,"inn wall is not solid")
        open=thermal_world(site,vec3(0,0,-0.5))
        assert(thermal_exclude(open.xz,f64(open.y))==open.xz)
        assert(not thermal_paved(site.center.xz+vec2(70,0)),"ground cover suppressed outside the terraces")
