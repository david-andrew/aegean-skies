use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/thermal_sites.jo'
use '../src/objects.jo'
use '../src/world_point.jo'

test "both bath terraces have walkable road stairs and solid walls without distant-coordinate snapping":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    loop site in THERMAL_SITES:
        from=thermal_world(site,vec3(0,0,28.2));to=thermal_world(site,vec3(0,0,14))
        point=WorldPoint(f64(from.x),walk_height([],f64(from.x),f64(from.z)),f64(from.z))
        direction=normalize(to.xz-from.xz)
        loop k in 0..150:point=walk_step_precise([],point,direction*0.1)
        assert(length(world_vec(point).xz-to.xz)<1.2,"stairs blocked at {site.name}: {world_vec(point)} expected {to}")
        assert(abs(point.y-f64(site.center.y))<0.03)
        entry=thermal_inn(site)
        assert(thermal_exclude(entry.xz,f64(entry.y))==entry.xz,"inn entrance blocked")
        wall=thermal_world(site,vec3(13.5,0,-8))
        assert(length(thermal_exclude(wall.xz,f64(wall.y))-wall.xz)>0.1,"inn wall is not solid")
        open=thermal_world(site,vec3(0,0,-0.5))
        assert(thermal_exclude(open.xz,f64(open.y))==open.xz)
        assert(not thermal_paved(site.center.xz+vec2(70,0)),"ground cover suppressed outside the terrace")
