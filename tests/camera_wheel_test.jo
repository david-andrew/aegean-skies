# The mouse wheel never moves a camera while any menu, panel or overlay is open: every UI state,
# the pause menu, the notebook, the chart, time passing and the table each keep the camera's
# distance as it was. (tools/wheel_probe.jo turns the real wheel in the running game.)
use '../src/ui_state.jo'
use '../src/options.jo'

test "every panel keeps the wheel from the camera":
    loop k in 0..UI_STATES:
        o = Overlays(ui = Ui(k))
        assert(overlays_open(o) == (k != 0), "ui {k}")
        if k != 0: assert(wheel_kept(3.1, 5.5, overlays_open(o)) == 5.5, "ui {k}")

test "the overlays beside the panels keep it too":
    loop o in [Overlays(paused = true), Overlays(notebook = true), Overlays(chart = true), Overlays(skip = true), Overlays(sitting = true)]:
        assert(overlays_open(o))
        assert(wheel_kept(3.1, 5.5, overlays_open(o)) == 5.5)

test "with nothing open the wheel zooms":
    assert(not overlays_open(Overlays()))
    assert(wheel_kept(3.1, 5.5, false) == 3.1)

test "sitting with only the table's bar, the wheel is the seat's view's; a menu opened there keeps it":
    assert(not overlays_open(Overlays(ui = .leisure, sitting = true, seat_view = true)))
    assert(overlays_open(Overlays(ui = .leisure, sitting = true)))
    assert(overlays_open(Overlays(ui = .leisure, sitting = true, seat_view = true, paused = true)))

test "seated, two drags add up: the second goes on from where the first left the view":
    v = ViewTurn(1.0, 0.2)
    a = view_turn(v, vec2(40, 10), false, vec2(0, 0), 0.016, 1.0, -0.1, 1.2)
    b = view_turn(a, vec2(30, 5), false, vec2(0, 0), 0.016, 1.0, -0.1, 1.2)
    assert(abs(b.yaw - (1.0 - 70.0 * 0.005)) < 1e-9 and abs(b.pitch - (0.2 + 15.0 * 0.004)) < 1e-9)
    # (a new touch: its first frame's jump from the last touch's end is no turn at all)
    c = view_turn(b, vec2(-600, 300), true, vec2(0, 0), 0.016, 1.0, -0.1, 1.2)
    assert(c.yaw == b.yaw and c.pitch == b.pitch)
    d = view_turn(c, vec2(20, 0), false, vec2(0, 0), 0.016, 1.0, -0.1, 1.2)
    assert(abs(d.yaw - (b.yaw - 0.1)) < 1e-9)
    # (the stick turns on from there too, and the pitch keeps within its limits)
    e = view_turn(d, vec2(0, 0), false, vec2(1, 1), 1.0, 1.0, -0.1, 1.2)
    assert(e.yaw < d.yaw and e.pitch == 1.2)

# The wheel's one speed and the cameras' zoom (wheel_zoom_step, smoothed over a few frames)
test "a notch's zoom comes over a few frames and adds up to WHEEL_ZOOM":
    wheel_zoom_take(0.0, 0.1, true)
    wheel_zoom_take(1.0, 1.0 / 60.0, false)
    first = wheel_zoom()
    assert(first < 1.0 and first > WHEEL_ZOOM, "a part of it at once: {first}")
    d = first
    loop _ in 0..30:
        wheel_zoom_take(0.0, 1.0 / 60.0, false)
        d *= wheel_zoom()
    assert(abs(d - WHEEL_ZOOM) < 1e-6, "all of it by half a second: {d}")
    wheel_zoom_take(0.0, 1.0 / 60.0, false)
    assert(wheel_zoom() == 1.0)

test "opening anything drops the zoom still to come":
    wheel_zoom_take(-2.0, 1.0 / 60.0, false)
    assert(wheel_zoom() > 1.0)
    wheel_zoom_take(0.0, 1.0 / 60.0, true)
    assert(wheel_zoom() == 1.0)
    wheel_zoom_take(0.0, 1.0 / 60.0, false)
    assert(wheel_zoom() == 1.0)

test "Scroll speed x1 is half a notch; x2 a whole one, as it was":
    apply_scroll_speed(Options().scroll_speed)
    assert(wheel_scale() == WHEEL_BASE and WHEEL_BASE == 0.5)
    apply_scroll_speed(2.0)
    assert(wheel_scale() == 1.0)
    apply_scroll_speed(1.0)
