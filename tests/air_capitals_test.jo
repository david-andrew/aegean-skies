use '../src/air_events.jo'
use '../src/air_race.jo'
use '../src/air_pilot.jo'
use '../src/planes.jo'
use '../src/world.jo'
use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/life_scene.jo'
import '../src/living_world.jo' as living
import '../src/living_calendar.jo' as calendar

test "baked capitals fund their own pilots and have water race and approach corridors":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true; init_settlements(false)
    w = living.build_world(); configure_life_scene(w, [])
    models = build_craft_models(); events = AirEvents()
    prepare_air_events(events, w, models)
    print("capital pilots={events.pilots.len()} sparse harbors={w.far.harbors.len()}")
    assert(events.pilots.len() >= 4)
    loop country in w.countries:
        id = country.capital_id
        if id < 0: continue
        assert(id in w.far.harbors)
        w.minute = calendar.next_capital_feast_minute(id, 0) - 120; w.tick = w.minute * 120
        before_errors = living.invariant_errors(w)
        prepare_air_events(events, w, models)
        assert(living.invariant_errors(w) == before_errors)
        matches = [loop meet in events.meets: if meet.capital == id: meet]
        assert(matches.len() > 0, "no safe water race at capital {id}")
        meet = matches[0]; h = w.far.harbors[id]
        runway = air_runway(w.place_contexts[id].center, h.out, vec3(4, 0, 3), surface_height)
        print("capital {id} {meet.name} racers={meet.entries.len()} crowd={meet.audience} runway={runway.valid}")
        assert(meet.entries.len() == 2 and meet.audience > 0 and runway.valid)
