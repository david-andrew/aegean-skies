use '../src/look.jo'
use '../src/day_air.jo'
use '../src/sky.jo'

# The day's air: one kind a day, the same for everyone; a clear day is the baseline sunset.

test "Every day has one kind of air, the same each time it is asked":
    loop d in 0..60:
        a = day_air_kind(d, 0.0, 0.0, 1.0)
        b = day_air_kind(d, 0.0, 0.0, 1.0)
        assert(a == b)

test "Over a few years all six kinds turn up, clear the most, heavy dust the rarest":
    counts = [0, 0, 0, 0, 0, 0]
    loop d in 0..1000:
        k = day_air_kind(d, 0.0, 0.0, 1.0)
        loop i in 0..6:
            if k == day_air_kinds[i]: counts[i] += 1
    loop i in 0..6: assert(counts[i] > 15)
    loop i in 0..6: assert(counts[3] <= counts[i])
    assert(counts[0] >= counts[1] and counts[0] >= counts[2])

test "Rain or a deck overhead makes the air humid; a clearing wind keeps it clean":
    loop d in 0..30:
        assert(day_air_kind(d, 0.3, 0.0, 1.0) == DayAir.humid)
        k = day_air_kind(d, 0.0, 0.0, 1.6)
        assert(k == DayAir.clear or k == DayAir.washed)

test "A clear day is the baseline: its light unchanged":
    L = light_at(17.8)
    C = day_air_light(L, DayAir.clear)
    assert(length(C.sun - L.sun) < 0.00001 and length(C.sky_horizon - L.sky_horizon) < 0.00001)
    assert(C.turbidity == 0.0)

test "In dust the disc starts warming twenty degrees up, gradually; a clear day's is white there":
    e = 20.0 * PI / 180.0
    clear = sun_disc_look(e, 0.0)
    dust = sun_disc_look(e, 1.0)
    assert(clear.top.z > 0.85 and clear.foot.z > 0.85)
    assert(dust.top.z < clear.top.z and dust.top.y > 0.6)
    assert(sun_disc_look(5.0 * PI / 180.0, -0.4).top.z > 0.6)

test "A reddened sun is an emitter: a small flat near-white disc, its colour in a red bloom":
    low = sun_disc_look(3.0 * PI / 180.0, 1.0)
    assert(low.top.x > 0.95 and low.top.z > 0.8 and length(low.top - low.foot) < 0.05)
    assert(low.bloom.w > 0.5 and low.bloom.x > low.bloom.y * 3.0 and low.size < 0.9)
    # (heavy dust near the water: the deepest red bloom)
    heavy = sun_disc_look(1.0 * PI / 180.0, 1.4)
    assert(heavy.bloom.x > heavy.bloom.y * 5.0)

test "A clear day's sun has no bloom; once any sun has set a red glow stays on the horizon":
    plain = sun_disc_look(3.0 * PI / 180.0, 0.0)
    assert(plain.bloom.w == 0.0 and plain.halo.x == 0.0 and plain.halo.w == SUN_QUAD)
    gone = sun_disc_look(-1.0 * PI / 180.0, 0.0)
    assert(gone.halo.x > 0.2 and gone.halo.w >= 20.0)

test "Sunset palette frequencies follow the guide (routine, episodic dust/smoke, rare exceptional)":
    counts = fill(0, sunset_palette_kinds.len())
    loop d in 0..5000:
        air = day_air_kind(d, 0.0, 0.0, 1.0)
        p = sunset_palette_kind(d, air, 0.0, 0.0, 1.0)
        assert(p == sunset_palette_kind(d, air, 0.0, 0.0, 1.0))
        counts[int(p)] += 1
    routine = counts[int(SunsetPalette.amber)] + counts[int(SunsetPalette.red)] + counts[int(SunsetPalette.peach)]
    episodic = counts[int(SunsetPalette.copper)] + counts[int(SunsetPalette.rose)]
    volcanic = counts[int(SunsetPalette.magenta)] + counts[int(SunsetPalette.lilac)]
    cool_disc = counts[int(SunsetPalette.blue)] + counts[int(SunsetPalette.purple)] + counts[int(SunsetPalette.green)]
    # Guide target: ~85% routine, ~14% hazy/dust/smoke, ~1% exceptional (glow-led outnumbering cool discs)
    assert(routine > 3800 and routine < 4600)
    assert(episodic > 350 and episodic < 1000)
    assert(volcanic + cool_disc >= 15 and volcanic + cool_disc <= 120)
    assert(volcanic > cool_disc)
    assert(counts[int(SunsetPalette.amber)] > 1000 and counts[int(SunsetPalette.copper)] > 150)

test "Each sunset palette keeps distinct disc, aureole, sky and sea-glitter layers":
    L0 = light_at(17.92)
    e1 = 1.0 * PI / 180.0
    # Amber: clear maritime stays golden-amber, never harsh crimson
    amb_L = sunset_light(L0, .clear, .amber)
    amb_d = sun_disc_look(e1, amb_L.turbidity, amb_L.sunset_kind)
    assert(amb_d.top.y > 0.80 and amb_L.glow_low.y > 0.55 and amb_L.glint_sun.y > 0.85)
    # Red: preserves existing baseline verbatim
    red_base = day_air_light(L0, .hazy)
    red_L = sunset_light(L0, .hazy, .red)
    assert(length(red_L.sun - red_base.sun) < 0.00001 and length(red_L.glow_low - red_base.glow_low) < 0.00001)
    # Copper: muted and dimmer than clear amber
    cop_L = sunset_light(L0, .dusty, .copper)
    cop_d = sun_disc_look(e1, cop_L.turbidity, cop_L.sunset_kind)
    assert(cop_d.top.x < 0.82 and cop_L.sun.x < amb_L.sun.x)
    # Rose: rose disc does not paint the opposite horizon belt bright pink
    rose_L = sunset_light(L0, .hazy, .rose)
    rose_d = sun_disc_look(e1, rose_L.turbidity, rose_L.sunset_kind)
    assert(rose_d.top.x > rose_d.top.y and rose_L.glow_belt.x < 0.65)
    # Magenta: warm-white / pale-rose disc, magenta carried by the glow and persistent after sunset
    mag_L = sunset_light(L0, .clear, .magenta)
    mag_d = sun_disc_look(e1, mag_L.turbidity, mag_L.sunset_kind)
    assert(mag_d.top.x > 0.90 and mag_d.top.y > 0.78 and mag_d.bloom.z > mag_d.bloom.y * 1.4)
    mag_set = sun_disc_look(-1.0 * PI / 180.0, mag_L.turbidity, mag_L.sunset_kind)
    assert(mag_set.halo.x > 0.4 and mag_set.set_colour.z > mag_set.set_colour.y)
    # Lilac: warm cream disc, cool lilac halo, warm low horizon under cool lilac upper band
    lil_L = sunset_light(L0, .clear, .lilac)
    lil_d = sun_disc_look(e1, lil_L.turbidity, lil_L.sunset_kind)
    assert(lil_d.top.x > lil_d.top.z and lil_d.bloom.z > lil_d.bloom.y)
    assert(lil_L.glow_low.x > lil_L.glow_low.z and lil_L.glow_high.z > lil_L.glow_high.y)
    # Rare cool discs: attenuated (dimmer than ordinary suns) with distinct hue families
    blu_d = sun_disc_look(e1, 0.6, int(SunsetPalette.blue))
    pur_d = sun_disc_look(e1, 0.6, int(SunsetPalette.purple))
    grn_d = sun_disc_look(e1, 0.6, int(SunsetPalette.green))
    assert(blu_d.top.z > blu_d.top.x and blu_d.top.z < 0.88)
    assert(pur_d.top.z > pur_d.top.y and pur_d.top.x > pur_d.top.y and pur_d.top.z < 0.88)
    assert(grn_d.top.y > grn_d.top.x and grn_d.top.y < 0.88)

test "Horizon flash requires clear sea air and colours only the final upper sliver":
    loop d in 0..400:
        assert(horizon_flash_kind(d, .hazy) == .none)
        assert(horizon_flash_kind(d, .dusty) == .none)
        assert(horizon_flash_kind(d, .heavy) == .none)
        assert(horizon_flash_kind(d, .humid) == .none)
        assert(horizon_flash_kind(d, .clear, rain = 0.2) == .none)
        assert(horizon_flash_kind(d, .washed, fog = 0.2) == .none)
        assert(horizon_flash_kind(d, .clear) != .blue)
    greens = 0; blues = 0
    loop d in 0..1000:
        f = horizon_flash_kind(d, .washed)
        if f == .green: greens += 1
        if f == .blue: blues += 1
    assert(greens > 100 and blues > 5 and blues < greens)
    # Off when sun is high, active on the final upper sliver, off once completely below horizon
    high = sun_disc_look(5.0 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.green))
    assert(high.flash.w == 0.0)
    # Find sliver elevation where top limb is ~0.15 radii above horizon
    sliver = sun_disc_look(-1.3 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.green))
    assert(sliver.flash.w > 0.3 and sliver.flash.y > sliver.flash.x)
    gone = sun_disc_look(-3.5 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.green))
    assert(gone.flash.w == 0.0)
