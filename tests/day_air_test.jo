use '../src/look.jo'
use '../src/day_air.jo'
use '../src/sky.jo'

# The day's air: one kind a day, the same for everyone; a clear day is the baseline sunset.

test "Every day has one kind of air, the same each time it is asked":
    loop d in 0..60:
        a = day_air_kind(d, 0.0, 0.0, 1.0)
        b = day_air_kind(d, 0.0, 0.0, 1.0)
        assert(a == b)

test "Over a few years all six kinds turn up, clear the most, heavy dust the rarest":
    counts = [0, 0, 0, 0, 0, 0]
    loop d in 0..1000:
        k = day_air_kind(d, 0.0, 0.0, 1.0)
        loop i in 0..6:
            if k == day_air_kinds[i]: counts[i] += 1
    loop i in 0..6: assert(counts[i] > 15)
    loop i in 0..6: assert(counts[3] <= counts[i])
    assert(counts[0] >= counts[1] and counts[0] >= counts[2])

test "Rain or a deck overhead makes the air humid; a clearing wind keeps it clean":
    loop d in 0..30:
        assert(day_air_kind(d, 0.3, 0.0, 1.0) == DayAir.humid)
        k = day_air_kind(d, 0.0, 0.0, 1.6)
        assert(k == DayAir.clear or k == DayAir.washed)

test "A clear day is the baseline: its light unchanged":
    L = light_at(17.8)
    C = day_air_light(L, DayAir.clear)
    assert(length(C.sun - L.sun) < 0.00001 and length(C.sky_horizon - L.sky_horizon) < 0.00001)
    assert(C.turbidity == 0.0)

test "In dust the disc starts warming twenty degrees up, gradually; a clear day's is white there":
    e = 20.0 * PI / 180.0
    clear = sun_disc_look(e, 0.0)
    dust = sun_disc_look(e, 1.0)
    assert(clear.top.z > 0.85 and clear.foot.z > 0.85)
    assert(dust.top.z < clear.top.z and dust.top.y > 0.6)
    assert(sun_disc_look(5.0 * PI / 180.0, -0.4).top.z > 0.6)

test "A reddened sun is an emitter: a small flat near-white disc, its colour in a red bloom":
    low = sun_disc_look(3.0 * PI / 180.0, 1.0)
    assert(low.top.x > 0.95 and low.top.z > 0.8 and length(low.top - low.foot) < 0.05)
    assert(low.bloom.w > 0.5 and low.bloom.x > low.bloom.y * 3.0 and low.size < 0.9)
    # (heavy dust near the water: the deepest red bloom)
    heavy = sun_disc_look(1.0 * PI / 180.0, 1.4)
    assert(heavy.bloom.x > heavy.bloom.y * 5.0)

test "A clear day's sun has no bloom; once any sun has set a red glow stays on the horizon":
    plain = sun_disc_look(3.0 * PI / 180.0, 0.0)
    assert(plain.bloom.w == 0.0 and plain.halo.x == 0.0 and plain.halo.w == SUN_QUAD)
    gone = sun_disc_look(-1.0 * PI / 180.0, 0.0)
    assert(gone.halo.x > 0.2 and gone.halo.w >= 20.0)

test "Sunset palette frequencies follow the guide (routine, episodic dust/smoke, rare exceptional)":
    counts = fill(0, sunset_palette_kinds.len())
    loop d in 0..5000:
        air = day_air_kind(d, 0.0, 0.0, 1.0)
        p = sunset_palette_kind(d, air, 0.0, 0.0, 1.0)
        assert(p == sunset_palette_kind(d, air, 0.0, 0.0, 1.0))
        counts[int(p)] += 1
    routine = counts[int(SunsetPalette.amber)] + counts[int(SunsetPalette.red)] + counts[int(SunsetPalette.peach)]
    episodic = counts[int(SunsetPalette.crimson)] + counts[int(SunsetPalette.copper)] + counts[int(SunsetPalette.rose)]
    volcanic = counts[int(SunsetPalette.magenta)] + counts[int(SunsetPalette.lilac)]
    cool_disc = counts[int(SunsetPalette.blue)] + counts[int(SunsetPalette.purple)] + counts[int(SunsetPalette.cyan)] + counts[int(SunsetPalette.green)]
    # Guide target: ~85% routine, ~14% hazy/dust/smoke, ~1% exceptional (glow-led outnumbering cool discs)
    assert(routine > 3600 and routine < 4600)
    assert(episodic > 450 and episodic < 1200)
    assert(volcanic + cool_disc >= 15 and volcanic + cool_disc <= 120)
    assert(volcanic > cool_disc)
    assert(counts[int(SunsetPalette.amber)] > 1000 and counts[int(SunsetPalette.copper)] > 150 and counts[int(SunsetPalette.crimson)] > 100)

test "Vividness intersperses muted, medium and bold evenings and responds smoothly to air and weather":
    muted = 0; mid = 0; bold = 0
    clear_sum = 0.0; heavy_sum = 0.0
    loop d in 0..1000:
        air = day_air_kind(d, 0.0, 0.0, 1.0)
        p = sunset_palette_kind(d, air)
        v = sunset_vividness(d, air, p)
        assert(v >= 0.0 and v <= 1.0)
        if v < 0.35: muted += 1
        else if v <= 0.70: mid += 1
        else: bold += 1
        clear_sum += f64(sunset_vividness(d, .clear, .amber))
        heavy_sum += f64(sunset_vividness(d, .heavy, .copper))
    assert(muted > 150 and mid > 200 and bold > 200)
    assert(clear_sum > heavy_sum)
    # Rain and cloud deck smoothly damp vividness
    v_fair = sunset_vividness(12, .clear, .amber, 0.0, 0.0, 1.0)
    v_rain = sunset_vividness(12, .clear, .amber, 0.6, 0.5, 1.0)
    assert(v_rain <= v_fair)

test "Each sunset palette keeps distinct disc, aureole, sky and sea-glitter layers across muted and bold":
    L0 = light_at(17.92)
    e1 = 1.0 * PI / 180.0
    # Amber: clear maritime stays golden-amber with clear disc-to-glow separation at both ends
    amb_m = sunset_light(L0, .clear, .amber, .none, 0.0)
    amb_b = sunset_light(L0, .clear, .amber, .none, 1.0)
    amb_dm = sun_disc_look(e1, amb_m.turbidity, amb_m.sunset_kind, 0, 0.0)
    amb_db = sun_disc_look(e1, amb_b.turbidity, amb_b.sunset_kind, 0, 1.0)
    assert(amb_db.top.y > 0.85 and amb_db.bloom.y < amb_db.top.y - 0.20 and amb_db.bloom.w > amb_dm.bloom.w)
    assert(amb_b.glow_low.y > 0.55 and amb_b.glint_sun.y > 0.85)
    # Red: bold end preserves existing baseline verbatim; muted end softens the aureole and band
    red_base = day_air_light(L0, .hazy)
    red_b = sunset_light(L0, .hazy, .red, .none, 1.0)
    red_m = sunset_light(L0, .hazy, .red, .none, 0.0)
    assert(length(red_b.sun - red_base.sun) < 0.00001 and length(red_b.glow_low - red_base.glow_low) < 0.00001)
    red_db = sun_disc_look(e1, red_b.turbidity, red_b.sunset_kind, 0, 1.0)
    red_dm = sun_disc_look(e1, red_m.turbidity, red_m.sunset_kind, 0, 0.0)
    assert(red_db.bloom.w > red_dm.bloom.w + 0.25)
    # Crimson: flat deep crimson disc, stronger at bold end
    cri_m = sun_disc_look(e1, 0.6, int(SunsetPalette.crimson), 0, 0.0)
    cri_b = sun_disc_look(e1, 0.6, int(SunsetPalette.crimson), 0, 1.0)
    assert(cri_m.top.x > cri_m.top.y * 2.0 and cri_b.bloom.w > cri_m.bloom.w)
    # Copper: muted dust stays subdued; heavy dust reaches dark reddish-brown
    cop_m = sunset_light(L0, .dusty, .copper, .none, 0.0)
    cop_dm = sun_disc_look(e1, cop_m.turbidity, cop_m.sunset_kind, 0, 0.0)
    cop_heavy = sun_disc_look(e1, 1.4, int(SunsetPalette.copper), 0, 0.0)
    assert(cop_dm.top.x < 0.82 and cop_m.sun.x < amb_b.sun.x and cop_heavy.foot.x < 0.60)
    # Rose: rose disc does not paint the opposite horizon belt bright pink
    rose_L = sunset_light(L0, .hazy, .rose, .none, 0.5)
    rose_d = sun_disc_look(e1, rose_L.turbidity, rose_L.sunset_kind, 0, 0.5)
    assert(rose_d.top.x > rose_d.top.y and rose_L.glow_belt.x < 0.65)
    # Magenta: warm-white / pale-rose disc at BOTH ends, bold glow carries vivid magenta
    mag_b = sunset_light(L0, .clear, .magenta, .none, 1.0)
    mag_db = sun_disc_look(e1, mag_b.turbidity, mag_b.sunset_kind, 0, 1.0)
    assert(mag_db.top.x > 0.90 and mag_db.top.y > 0.78 and mag_db.bloom.z > mag_db.bloom.y * 2.5 and mag_db.bloom.w > 0.85)
    mag_set = sun_disc_look(-1.0 * PI / 180.0, mag_b.turbidity, mag_b.sunset_kind, 0, 1.0)
    assert(mag_set.halo.x > 0.5 and mag_set.set_colour.z > mag_set.set_colour.y)
    # Lilac: warm cream disc, cool lilac halo, warm low horizon under cool lilac upper band
    lil_b = sunset_light(L0, .clear, .lilac, .none, 1.0)
    lil_db = sun_disc_look(e1, lil_b.turbidity, lil_b.sunset_kind, 0, 1.0)
    assert(lil_db.top.x > lil_db.top.z and lil_db.bloom.z > lil_db.bloom.y * 1.8)
    assert(lil_b.glow_low.x > lil_b.glow_low.z and lil_b.glow_high.z > lil_b.glow_high.y)
    # Rare cool discs: unmistakable blue, purple, blue-green (cyan) and green hues at both ends
    loop vv in [0.0, 1.0]:
        blu = sun_disc_look(e1, 0.6, int(SunsetPalette.blue), 0, f32(vv))
        pur = sun_disc_look(e1, 0.6, int(SunsetPalette.purple), 0, f32(vv))
        cyn = sun_disc_look(e1, 0.6, int(SunsetPalette.cyan), 0, f32(vv))
        grn = sun_disc_look(e1, 0.6, int(SunsetPalette.green), 0, f32(vv))
        assert(blu.top.z > blu.top.x + 0.25)
        assert(pur.top.z > pur.top.y + 0.15 and pur.top.x > pur.top.y + 0.08)
        assert(cyn.top.y > cyn.top.x + 0.18 and cyn.top.z > cyn.top.x + 0.18)
        assert(grn.top.y > grn.top.x + 0.10 and grn.top.y > grn.top.z + 0.18)

test "Horizon flash requires clear sea air and supports green, blue and violet flashes":
    loop d in 0..400:
        assert(horizon_flash_kind(d, .hazy) == .none)
        assert(horizon_flash_kind(d, .dusty) == .none)
        assert(horizon_flash_kind(d, .heavy) == .none)
        assert(horizon_flash_kind(d, .humid) == .none)
        assert(horizon_flash_kind(d, .clear, rain = 0.2) == .none)
        assert(horizon_flash_kind(d, .washed, fog = 0.2) == .none)
        assert(horizon_flash_kind(d, .clear) != .blue and horizon_flash_kind(d, .clear) != .violet)
    greens = 0; blues = 0; violets = 0
    loop d in 0..2000:
        f = horizon_flash_kind(d, .washed)
        if f == .green: greens += 1
        if f == .blue: blues += 1
        if f == .violet: violets += 1
    assert(greens > 200 and blues > 20 and violets > 2 and blues < greens and violets < blues)
    high = sun_disc_look(5.0 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.green))
    assert(high.flash.w == 0.0)
    sliver_g = sun_disc_look(-1.3 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.green))
    sliver_b = sun_disc_look(-1.3 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.blue))
    sliver_v = sun_disc_look(-1.3 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.violet))
    assert(sliver_g.flash.w > 0.3 and sliver_g.flash.y > sliver_g.flash.x)
    assert(sliver_b.flash.w > 0.3 and sliver_b.flash.z > sliver_b.flash.x)
    assert(sliver_v.flash.w > 0.3 and sliver_v.flash.z > sliver_v.flash.y)
    gone = sun_disc_look(-3.5 * PI / 180.0, 0.0, int(SunsetPalette.amber), int(HorizonFlash.green))
    assert(gone.flash.w == 0.0)

test "Sunset lighting transitions continuously from afternoon through twilight without single-step jumps":
    loop air in day_air_kinds:
        prev = sunset_light(light_at(16.0), air, .peach, .none, 1.0)
        loop k in 1..900:
            hr = 16.0 + f64(k) * 0.005
            cur = sunset_light(light_at(hr), air, .peach, .none, 1.0)
            assert(length(cur.sky_top - prev.sky_top) < 0.025)
            assert(length(cur.sky_horizon - prev.sky_horizon) < 0.03)
            assert(abs(cur.afterglow.x - prev.afterglow.x) < 0.04)
            if cur.afterglow.x > 0.05 and prev.afterglow.x > 0.05:
                assert(abs(1.0 / cur.afterglow.y - 1.0 / prev.afterglow.y) < 0.015)
            prev = cur
