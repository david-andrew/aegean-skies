use '../src/look.jo'
use '../src/day_air.jo'
use '../src/sky.jo'

# The day's air: one kind a day, the same for everyone; a clear day is the baseline sunset.

test "Every day has one kind of air, the same each time it is asked":
    loop d in 0..60:
        a = day_air_kind(d, 0.0, 0.0, 1.0)
        b = day_air_kind(d, 0.0, 0.0, 1.0)
        assert(a == b)

test "Over a few years all six kinds turn up, clear the most, heavy dust the rarest":
    counts = [0, 0, 0, 0, 0, 0]
    loop d in 0..1000:
        k = day_air_kind(d, 0.0, 0.0, 1.0)
        loop i in 0..6:
            if k == day_air_kinds[i]: counts[i] += 1
    loop i in 0..6: assert(counts[i] > 15)
    loop i in 0..6: assert(counts[3] <= counts[i])
    assert(counts[0] >= counts[1] and counts[0] >= counts[2])

test "Rain or a deck overhead makes the air humid; a clearing wind keeps it clean":
    loop d in 0..30:
        assert(day_air_kind(d, 0.3, 0.0, 1.0) == DayAir.humid)
        k = day_air_kind(d, 0.0, 0.0, 1.6)
        assert(k == DayAir.clear or k == DayAir.washed)

test "A clear day is the baseline: its light unchanged":
    L = light_at(17.8)
    C = day_air_light(L, DayAir.clear)
    assert(length(C.sun - L.sun) < 0.00001 and length(C.sky_horizon - L.sky_horizon) < 0.00001)
    assert(C.turbidity == 0.0)

test "In dust the disc is red twenty degrees up; on a clear day it is white there":
    e = 20.0 * PI / 180.0
    (top_clear, foot_clear, _, _, _, _) = sun_disc_look(e, 0.0)
    (top_dust, foot_dust, _, _, _, soft) = sun_disc_look(e, 1.0)
    assert(top_clear.z > 0.85 and foot_clear.z > 0.85)
    assert(top_dust.z < 0.3 and foot_dust.z < 0.15 and soft > 0.1)
    # (and a haze day's disc is orange at ten degrees, a washed day's still pale)
    (top_haze, _, _, _, _, _) = sun_disc_look(10.0 * PI / 180.0, 0.6)
    (top_washed, _, _, _, _, _) = sun_disc_look(5.0 * PI / 180.0, -0.4)
    assert(top_haze.z < 0.35 and top_washed.z > 0.6)

test "Heavy dust: the disc a deep red, not orange, from five to twenty degrees up":
    loop deg in [5.0, 10.0, 20.0]:
        (top, foot, _, _, _, _) = sun_disc_look(deg * PI / 180.0, 1.4)
        assert(top.x > top.y * 4.0 and foot.x > foot.y * 6.0 and top.y < 0.2)
