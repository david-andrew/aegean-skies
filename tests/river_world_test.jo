use '../src/geography.jo'
use '../src/river_field.jo'
use '../src/river_data.jo'
use '../src/world_source.jo'
use '../src/flight_ground.jo'
use '../src/flight.jo'
use '../src/planes.jo'

test "drainage descends to connected sea with a shared submerged bed":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    loop i in 0..RIVER_NODES.len()-1:
        if RIVER_BREAKS.contains(i):continue
        a=RIVER_NODES[i];b=RIVER_NODES[i+1]
        assert(a.z>=b.z)
        p=(a.xy+b.xy)*0.5
        r=river_at(f64(p.x),f64(p.y))
        assert(r.wet)
        ground=flight_surface_height(f64(p.x),f64(p.y))
        assert(ground<r.level-2.0)
        assert(abs(ground-world_source_surface(f64(p.x),f64(p.y)))<0.001)
    end=RIVER_NODES[RIVER_MAIN_COUNT-1]
    assert(end.z==0 and macro_sample(true,f64(end.x),f64(end.y)) < -1000)
    assert(not river_at(0,0).wet)

test "actual river supports landing taxi and takeoff":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    model=build_craft(Craft.gull,LIVERIES[0]);k=craft_spec(Craft.gull,model.contacts)
    p=RIVER_NODES[85];q=RIVER_NODES[86];dir=normalize(vec3(q.x-p.x,0,q.y-p.y))
    hd=atan2(f64(dir.x),-f64(dir.z))
    e=FlightEnv(has_swell=true,swell_ceiling=71.3,ground=flight_surface_height,current_at=river_current,
        swell=(x:f64,z:f64)->vec3:
            r=river_at(x,z)
            if r.wet:vec3(f32(r.level),r.slope.x,r.slope.y) else:vec3(0,0,0))
    s=water_start(k,vec3(p.x,p.z,p.y),hd)
    loop i in 0..300:step(k,s,Controls(throttle=0.17),e,1.0/60.0)
    assert(s.on_water and not s.crashed and river_at(f64(s.position.x),f64(s.position.z)).wet)
    plan=FlightPlan(takeoff_heading=hd)
    loop i in 0..1800:
        step(k,s,autopilot(k,s,plan,e),e,1.0/60.0)
        if not s.on_water and s.position.y>p.z+k.float_height+4:break
    assert(not s.on_water and not s.crashed and s.hull_damage==0)
    s=CraftState(position=vec3(p.x,p.z+k.float_height+3,p.y),velocity=dir*f32(k.stall_speed*1.15)+vec3(0,-0.6,0),orientation=quat_euler(-0.02,-hd,0),fuel=k.fuel_capacity)
    loop i in 0..1800:step(k,s,Controls(assist=0.0,water_brake=0.4),e,1.0/60.0)
    assert(s.on_water and not s.crashed and s.hull_damage<0.05)

use '../src/objects.jo'
use '../src/grass.jo'
use '../src/world_point.jo'

test "inland water excludes walking and meadow grass":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    a=RIVER_NODES[85]
    h=world_source_surface(f64(a.x),f64(a.y))
    p=WorldPoint(f64(a.x),h,f64(a.y))
    next=walk_step_precise([],p,vec2(0.2,0))
    assert(next.x==p.x and next.z==p.z)
    assert(grass_cover([],p.x,p.z)==0.0)
