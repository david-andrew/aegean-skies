use '../src/world.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/render_space.jo'
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/port_mesh.jo'

# Sample actual emitted quay triangles, independently of the contact function.
quay_mesh_height = (vertices: Vertex3D[],x: f64,z: f64) -> f64:
    result=-1e9
    loop i in 0..vertices.len()/3:
        a=vertices[i*3];b=vertices[i*3+1];c=vertices[i*3+2]
        if a.normal.y<0.5:continue
        bx=f64(b.pos.x)-f64(a.pos.x);bz=f64(b.pos.z)-f64(a.pos.z)
        cx=f64(c.pos.x)-f64(a.pos.x);cz=f64(c.pos.z)-f64(a.pos.z)
        dx=x-f64(a.pos.x);dz=z-f64(a.pos.z)
        det=bx*cz-bz*cx
        if abs(det)<0.0000001:continue
        u=(dx*cz-dz*cx)/det;v=(bx*dz-bz*dx)/det
        if u>=-0.000001 and v>=-0.000001 and u+v<=1.000001:
            result=max(result,f64(a.pos.y)+u*(f64(b.pos.y)-f64(a.pos.y))+v*(f64(c.pos.y)-f64(a.pos.y)))
    result

test "precise walking at both far ports keeps motion and emitted quay contact":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    init_settlements()
    checked=0
    loop s in world_settlements:
        if s.name!="Pheryalara" and s.name!="Thalvalissa":continue
        port=settlement_port(s)
        q=port.quays[2]
        direction=normalize(q.b.xz-q.a.xz)
        x=f64(q.a.x)+(f64(q.b.x)-f64(q.a.x))*0.2
        z=f64(q.a.z)+(f64(q.b.z)-f64(q.a.z))*0.2
        point=WorldPoint(x,walk_height([],x,z),z)
        vertices: Vertex3D[]
        loop quay in port.quays:port_quay_mesh(vertices,quay,true)
        worst=0.0;step_error=0.0
        loop frame in 0..120:
            old=point
            point=walk_step_precise([],point,direction*0.01)
            dx=point.x-old.x;dz=point.z-old.z
            step_error=max(step_error,abs(sqrt(dx*dx+dz*dz)-0.01))
            mesh=quay_mesh_height(vertices,point.x,point.z)
            assert(mesh>-1e8)
            worst=max(worst,abs(point.y-mesh))
            assert(abs(point.y-mesh)<0.005)
            assert(step_error<0.0000001)
        print("PORT {s.name}: emitted quay gap {worst:.9} m; 1 cm step error {step_error:.12} m")
        checked+=1
    assert(checked==2)
