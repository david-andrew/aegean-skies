use '../src/look.jo'
use '../src/day_air.jo'
use '../src/sky_air.jo'
use '../src/sky.jo'

# The twilight sky from horizon to zenith: the plain sky under the glow band as its strip draws
# it. A band that stops short of the zenith with any cover left leaves a visible ring in a view
# pitched up (it did, at 43 degrees). No step in brightness or hue anywhere up the sky.

# The largest jump up the sky: how far any sample a hundredth of a radian from its neighbours
# stands off the straight line between them (a smooth gradient, however steep, is near zero; a
# seam is the size of its step). In colour, so a step in brightness or in hue both count.
sky_sweep_jump = (hour: f64, bearing: f32, heights: f64[]) -> f32:
    L = light_at(hour)
    worst: f32 = 0.0
    a = vec3(0,0,0); b = vec3(0,0,0)
    loop k in 3..158:
        h = f32(k) * 0.01
        band = glow_band_drawn(vec2(bearing, h), L.afterglow, L.sunset, heights)
        sky = sky_air_color(sin(h), 0.0, L.sun_dir.y, L.sky_top, L.sky_horizon, L.haze)
        c = sky * (1.0 - band.w) + band.xyz
        if k > 4: worst = max(worst, length(c - b * 2.0 + a))
        a = b; b = c
    worst

TWILIGHT_HOURS = [17.6, 17.95, 18.3, 18.77, 19.35, 19.9, 5.25, 6.05]

test "The glow band's strip reaches the zenith and has faded to nothing there":
    top = GLOW_HEIGHTS[GLOW_HEIGHTS.len() - 1]
    assert(top > 1.57)
    loop hour in TWILIGHT_HOURS:
        L = light_at(hour)
        loop b in [0.0, 1.2, 3.14]:
            assert(glow_band_colour(vec2(f32(b), f32(top)), L.afterglow, L.sunset).w < 0.001)

test "No step in brightness or hue up the twilight sky, at any bearing":
    loop hour in TWILIGHT_HOURS:
        loop b in [0.0, 0.8, 1.6, 2.4, 3.14]:
            assert(sky_sweep_jump(hour, f32(b), GLOW_HEIGHTS) < 0.015)

test "The check sees the old seam: a strip stopped at 43 degrees jumps there":
    old = [0.0, 0.015, 0.04, 0.08, 0.13, 0.19, 0.27, 0.37, 0.5, 0.75]
    loop hour in [18.3, 18.77, 19.35]:
        assert(sky_sweep_jump(hour, 0.0, old) > 0.04)

test "No step in brightness or hue up the twilight sky for any sunset palette":
    loop pal in sunset_palette_kinds:
        air = match pal:
            .copper: DayAir.dusty
            .peach: DayAir.humid
            .red, .rose, .blue, .purple, .green: DayAir.hazy
            _: DayAir.clear
        loop hour in [17.7, 17.95, 18.3, 18.85, 19.35]:
            L = sunset_light(light_at(hour), air, pal)
            loop b in [0.0, 1.2, 3.14]:
                worst: f32 = 0.0
                a = vec3(0,0,0); prev = vec3(0,0,0)
                loop k in 3..158:
                    h = f32(k) * 0.01
                    band = glow_band_drawn_of(vec2(f32(b), h), L.afterglow, L.glow_low, L.glow_high, L.glow_belt, GLOW_HEIGHTS)
                    sky = sky_air_color(sin(h), 0.0, L.sun_dir.y, L.sky_top, L.sky_horizon, L.haze)
                    c = sky * (1.0 - band.w) + band.xyz
                    if k > 4: worst = max(worst, length(c - prev * 2.0 + a))
                    a = prev; prev = c
                assert(worst < 0.015)
