# The harbour launch (src/harbour_launch.jo): its fare goes through the ledger to the harbour, the
# world's cash still adds up, an empty purse rides free; the ride starts at the dock and ends
# alongside, in a few world minutes.
import '../src/harbour_launch.jo' as launches
import '../src/living_seed.jo' as seed
import '../src/living_money.jo' as money

test "the fare is paid to the harbour through the ledger":
    w = seed.build_world()
    p = w.people[w.player].account
    h = launches.harbour_account(w, 0)
    assert(money.account_valid(w, h) and h != p)
    before = w.accounts[p].cents; harbour = w.accounts[h].cents
    assert(launches.pay_launch(w, 0) == launches.LAUNCH_FARE)
    assert(w.accounts[p].cents == before - launches.LAUNCH_FARE and w.accounts[h].cents == harbour + launches.LAUNCH_FARE)
    assert(launches.ledger_balances(w))
    # (an empty purse: the boatman lets it go, and nothing moves)
    w.ledger.external_out_cents += w.accounts[p].cents
    w.accounts[p].cents = 0
    assert(launches.ledger_balances(w))
    harbour = w.accounts[h].cents
    assert(launches.pay_launch(w, 0) == 0 and w.accounts[h].cents == harbour and launches.ledger_balances(w))
    assert(launches.harbour_account(w, -3) == -1 and launches.pay_launch(w, -3) == 0)

test "a ride goes from the dock to alongside, and back":
    dock = vec3(100, 0, 0); alongside = vec3(100, 0, -300)
    r = launches.launch_ride(0, dock, alongside, true)
    assert(r.active and r.outward and r.from == dock and r.to == alongside)
    assert(r.duration >= 6.0 and r.duration <= 40.0 and r.minutes >= 2 and r.minutes < 10)
    assert(f64(length(launches.launch_pose(r).0 - dock)) < 0.01)
    r.t = r.duration
    assert(launches.launch_done(r) and f64(length(launches.launch_pose(r).0 - alongside)) < 0.01)
    # (heading roughly along the run, -z: a world turn of about PI)
    r.t = r.duration * 0.5
    assert(abs(abs(launches.launch_pose(r).1) - PI) < 0.5)
    back = launches.launch_ride(0, dock, alongside, false)
    assert(back.from == alongside and back.to == dock)
