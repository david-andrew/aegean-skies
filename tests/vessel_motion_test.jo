# Boats drawn moving smoothly: the fleet steps hulls at 1/30 s and the living world places external
# hulls in clusters around a held world minute; drawn poses (vessel_motion.jo) must still advance
# evenly, frame after frame, and a long frame must not throw a hull forward.
use '../src/vessel_types.jo'
use '../src/vessels.jo'
use '../src/vessel_motion.jo'
use '../src/world_point.jo'
use '../src/sea_routes.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true

# The drawn position of ship `id` at each frame, for these frame times.
_drawn_track = (f: mut VesselFleet,id: int,frames: f64[],external_move: (mut VesselFleet,f64,int) -> void) -> vec3[]:
    m = VesselMotion(); t = 0.0; out: vec3[]
    loop k in 0..frames.len():
        dt = frames[k]; t += dt
        external_move(f,dt,k)
        step_vessels(f,vec2(8,0),dt)
        loop s in vessel_render_ships(m,f,t):
            if s.id == id: out.push(s.position)
    out

# Each frame's step against its neighbours': none more than 1.5 times either (or under 1/1.5).
_steady = (p: vec3[],from: int) -> f64:
    worst = 1.0
    loop k in from+1..p.len()-1:
        a = f64(length(p[k]-p[k-1])); b = f64(length(p[k+1]-p[k]))
        if a < 1e-6 or b < 1e-6: return 1e9
        worst = max(worst,max(a/b,b/a))
    worst

_lane_fleet = () -> VesselFleet:
    f = VesselFleet()
    f.lanes.push(SeaLane(0,1,2,vec2(0,-20000),vec2(400,-20000),1.2,4,status=.ready,points=[vec2(0,-20000),vec2(400,-20000)],distance=400))
    assert(spawn_vessel(f,Vessel(11,.motor_caique,7,1,lane=0,position=vec3(0,0,-20000),yaw=PI/2,crew=[7])))
    f

test "a boat on its lane is drawn advancing evenly at a steady frame rate":
    f = _lane_fleet()
    # (up to speed first: the hull accelerates gently, then runs on)
    loop k in 0..1200: step_vessels(f,vec2(8,0),1.0/60.0)
    assert(f.ships[0].speed > 2.0)
    no_move = (fleet: mut VesselFleet,dt: f64,k: int): pass
    drawn = _drawn_track(f,11,[loop k in 0..240: 1.0/60.0],no_move)
    assert(_steady(drawn,2) < 1.5,"drawn steps uneven: {_steady(drawn,2):.2}")
    # (the simulated pose alone moves on every other frame: what used to be drawn)
    g = _lane_fleet()
    loop k in 0..1200: step_vessels(g,vec2(8,0),1.0/60.0)
    raw: vec3[]
    loop k in 0..60:
        step_vessels(g,vec2(8,0),1.0/60.0); raw.push(g.ships[0].position)
    assert(_steady(raw,2) > 1.5)

test "a long frame carries a boat on by its time, not in a jump":
    f = _lane_fleet()
    loop k in 0..1200: step_vessels(f,vec2(8,0),1.0/60.0)
    no_move = (fleet: mut VesselFleet,dt: f64,k: int): pass
    frames = [loop k in 0..90: (if k == 45: 0.1 else: 1.0/60.0)]
    drawn = _drawn_track(f,11,frames,no_move)
    speed = f.ships[0].speed
    loop k in 2..drawn.len():
        step = f64(length(drawn[k]-drawn[k-1]))
        assert(abs(step-speed*frames[k]) < speed*VESSEL_DT*0.5+0.002,"frame {k}: {step:.3} m for {frames[k]:.3} s at {speed:.2} m/s")

test "an external boat placed in clusters by the living world is drawn moving evenly":
    f = VesselFleet()
    assert(spawn_vessel(f,Vessel(500,.sail_caique,7,1,position=vec3(0,0,-20000),status=.underway,external=true,velocity=vec3(3,0,0),speed=3,yaw=PI/2)))
    # (the living world moves it at 3 m/s, but holds it for three frames in every twenty while a
    # world minute runs, then puts it where it should be: the clusters the player saw)
    held_at = 0.0; clock = 0.0
    place = (fleet: mut VesselFleet,dt: f64,k: int):
        clock += dt
        if k % 20 < 17: held_at = clock
        p = vec3(f32(held_at*3.0),0,-20000)
        fleet.ships[0].position = p; fleet.ships[0].precise = world_point(p); fleet.ships[0].published = p; fleet.ships[0].precise_ready = true
    drawn = _drawn_track(f,500,[loop k in 0..240: 1.0/60.0],place)
    assert(_steady(drawn,30) < 1.5,"drawn steps uneven: {_steady(drawn,30):.2}")
    # (and it stays where the world puts it: never more than half a metre off)
    assert(f64(abs(drawn[drawn.len()-1].x-f32(clock*3.0))) < 0.5)

test "a fishing boat whose pose comes once a world minute is drawn moving evenly":
    f = VesselFleet()
    assert(spawn_vessel(f,Vessel(501,.sail_caique,7,1,position=vec3(0,0,-20000),status=.underway,external=true,velocity=vec3(7.5,0,0),speed=7.5,yaw=PI/2)))
    # (the living world's trip pose: once every 120 frames, two seconds, the boat 15 m on)
    clock = 0.0
    place = (fleet: mut VesselFleet,dt: f64,k: int):
        clock += dt
        if k % 120 == 0:
            p = vec3(f32(clock*7.5),0,-20000)
            fleet.ships[0].position = p; fleet.ships[0].precise = world_point(p); fleet.ships[0].published = p; fleet.ships[0].precise_ready = true
    drawn = _drawn_track(f,501,[loop k in 0..480: 1.0/60.0],place)
    assert(_steady(drawn,30) < 1.5,"drawn steps uneven: {_steady(drawn,30):.2}")
    assert(f64(abs(drawn[drawn.len()-1].x-f32(clock*7.5))) < 0.5)

test "a hull put somewhere new is drawn there at once":
    f = VesselFleet()
    assert(spawn_vessel(f,Vessel(500,.sail_caique,7,1,position=vec3(0,0,-20000),status=.anchored,external=true)))
    m = VesselMotion()
    _ = vessel_render_ships(m,f,0.0)
    f.ships[0].position = vec3(300,0,-20000); f.ships[0].precise = world_point(f.ships[0].position)
    drawn = vessel_render_ships(m,f,1.0/60.0)
    assert(length(drawn[0].position-vec3(300,0,-20000)) < 0.01)
