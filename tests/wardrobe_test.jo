# What the town's people wear: each trade has a man's and a woman's period version, readable either
# way (the apron, the headscarf, the cloche, the helmet); flying kit is the same for both; crowds
# are mostly neutral with a clear colour now and then; hats on most men and half the women.
use '../src/folk.jo'
use '../src/living_types.jo'
use '../src/wardrobe.jo'

TRADES = [Occupation.merchant, Occupation.courier, Occupation.mechanic, Occupation.clerk, Occupation.innkeeper, Occupation.fisher, Occupation.patrol, Occupation.telegraphist, Occupation.oil_presser, Occupation.miller, Occupation.teacher, Occupation.nurse, Occupation.priest, Occupation.hotelier, Occupation.racer, Occupation.pirate, Occupation.quartermaster, Occupation.farmer, Occupation.sailor]

_skirted = (o: Outfit) -> bool: o.garb == .dress or o.garb == .blouse or o.garb == .cassock

# chroma of a colour (a rough a*b* from RGB): neutral below about 0.08
_chroma = (c: vec4) -> f64:
    m = (f64(c.x) + f64(c.y) + f64(c.z)) / 3.0
    sqrt(pow(f64(c.x) - m, 2.0) + pow(f64(c.y) - m, 2.0) + pow(f64(c.z) - m, 2.0))

test "every trade has a woman's version: a dress or a blouse and skirt, except where the work wants flying kit or a uniform":
    loop occ in TRADES:
        loop seed in [3, 17, 101]:
            her = outfit_for(occ, seed, 35, true, 4000)
            him = outfit_for(occ, seed, 35, false, 4000)
            if occ == .courier or occ == .racer or occ == .pirate or occ == .patrol or occ == .mechanic:
                # (the work's kit, the same for both)
                assert(her.garb == him.garb and her.hat_kind == him.hat_kind)
            else:
                assert(_skirted(her), "{occ}")
                if occ != .priest: assert(not _skirted(him), "{occ}")

test "the trade reads either way: the fish market, the shop, the well-to-do, the singer":
    fishwife = outfit_for(.fisher, 9, 40, true, 2000)
    assert(fishwife.hat_kind == 5 and fishwife.apron.w > 0.0 and fishwife.rolled)
    shop = outfit_for(.merchant, 9, 40, true, 3000)
    assert(shop.garb == .blouse and shop.apron.w > 0.0)
    lady = outfit_for(.merchant, 9, 40, true, 30000)
    assert(lady.garb == .dress and lady.hat_kind == 7 and lady.sash.w > 0.0)
    singer = evening_outfit(0, 9, true)
    assert(singer.garb == .dress and singer.sash.w > 0.0)
    gent = outfit_for(.merchant, 9, 40, false, 30000)
    assert(gent.garb == .coat and (gent.hat_kind == 2 or gent.hat_kind == 6))
    shopman = outfit_for(.merchant, 9, 40, false, 3000)
    assert(shopman.garb == .waistcoat and shopman.apron.w > 0.0)
    assert(outfit_for(.priest, 9, 60, false, 3000).garb == .cassock)
    assert(outfit_for(.nurse, 9, 30, true, 3000).hat_kind == 5)

test "crowds are mostly neutral, a clear colour now and then; hats on most men and half the women":
    clear = 0
    total = 0
    men = 0; men_hats = 0
    women = 0; women_hats = 0
    loop seed in 0..400:
        o = walker_outfit(seed * 7 + 1, 25 + seed % 45)
        total += 1
        if _chroma(o.top) > 0.09: clear += 1
        if walker_woman(seed * 7 + 1):
            women += 1
            if o.hat_kind != 0: women_hats += 1
        else:
            men += 1
            if o.hat_kind != 0: men_hats += 1
    assert(clear * 100 <= total * 30, "{clear} of {total}")
    assert(men_hats * 100 >= men * 60, "{men_hats} of {men}")
    assert(women_hats * 100 >= women * 35 and women_hats * 100 <= women * 75, "{women_hats} of {women}")
