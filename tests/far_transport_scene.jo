use '../src/vessels.jo'
use 'living_commissions.jo'

sea_freight_fixture = () -> World:
    w=commission_fixture(); offset=vec3(0,0,-20000)
    loop key in w.place_contexts.keys(): w.place_contexts[key].center+=offset
    loop k in 0..w.far.links.len():
        loop n in 0..w.far.links[k].points.len(): w.far.links[k].points[n]+=offset
    loop k in 0..w.far.vehicles.len(): w.far.vehicles[k].pos+=offset
    w.far.districts[300].target[0]+=20000
    w.far.vehicles[1].buying_order=counter_restock_order(w,1,300)
    w.tick=120; w.minute=1
    assert(far_depart(w,1))
    assert(w.far.journeys[w.far.vehicles[1].journey].quantity>0)
    w

test "visible cargo ship leases the actual service once and folds its exact progress":
    w=sea_freight_fixture(); fleet=VesselFleet(); origin=w.far.vehicles[1].pos
    roots=w.next_cargo_source; stocks=stock_totals(w)
    w.tick+=60
    sync_far_vessels(fleet,w,origin)
    assert(fleet.ships.len()==1 and fleet.ships[0].id==FAR_VESSEL_BASE+1 and fleet.ships[0].external)
    assert(w.far.vehicles[1].scene_owned and w.far.vehicles[1].pos!=origin)
    at=w.far.vehicles[1].pos
    far_advance_transport(w,w.tick); step_vessels(fleet,vec2(0,0),0.5)
    assert(w.far.vehicles[1].pos==at and fleet.ships[0].position==at)
    sync_far_vessels(fleet,w,origin+vec3(30000,0,0))
    assert(fleet.ships.len()==0 and not w.far.vehicles[1].scene_owned)
    assert(w.far.vehicles[1].pos==at and stock_totals(w)==stocks and w.next_cargo_source==roots)
    w.tick+=60; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[1].pos!=at and invariant_errors(w).len()==0)

test "physical hull damage stops the same manifest and fold never loses its custody":
    w=sea_freight_fixture(); fleet=VesselFleet(); origin=w.far.vehicles[1].pos
    sync_far_vessels(fleet,w,origin)
    assert(fleet.ships.len()==1)
    damage_vessel(fleet,FAR_VESSEL_BASE+1,0.3,999)
    sync_far_vessels(fleet,w,origin)
    at=w.far.vehicles[1].pos; cargo=w.far.vehicles[1].cargo
    assert(w.far.vehicles[1].hull==700 and w.far.vehicles[1].motion_blocked!="")
    fold_far_people(w)
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[1].pos==at and w.far.vehicles[1].cargo==cargo)
    text=canonical_text(w); restored=from_text[World](text)
    assert(restored is World and canonical_text(restored)==text and validate_save_world(restored)=="")

test "a visible idle coaster can accept a paid departure while only its scene owner moves it":
    w=commission_fixture(); offset=vec3(0,0,-20000)
    loop k in 0..w.far.links.len():
        w.far.links[k].mode=.ship
        loop n in 0..w.far.links[k].points.len(): w.far.links[k].points[n]+=offset
    loop k in 0..w.far.vehicles.len(): w.far.vehicles[k].kind=.ship; w.far.vehicles[k].pos+=offset
    observer=w.far.vehicles[0].pos; fleet=VesselFleet()
    assert(far_produce(w,100,3,10000)); w.far.districts[200].target[3]+=20000
    w.far.vehicles[0].buying_order=counter_restock_order(w,0,200)
    sync_far_vessels(fleet,w,observer)
    assert(w.far.vehicles[0].scene_owned and w.far.vehicles[0].journey<0)
    assert(far_depart(w,0))
    before=w.far.vehicles[0].pos; w.tick+=60
    far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].pos==before)
    sync_far_vessels(fleet,w,observer)
    assert(length(w.far.vehicles[0].pos-before)>1 and w.far.vehicles[0].scene_owned)
    at=w.far.vehicles[0].pos
    sync_far_vessels(fleet,w,observer)
    assert(w.far.vehicles[0].pos==at)

test "services sharing an anchorage get distinct physical footprints without duplicated goods or a teleport":
    w=sea_freight_fixture(); origin=w.far.vehicles[1].pos
    account=new_account(w,"second-service")
    assert(transfer(w,w.far.districts[200].household_account,account,30000,.trade))
    w.far.districts[200].workers[2]-=3; w.far.crew_population[2]+=3
    w.far.vehicles.push(FarVehicle(2,.ship,200,200,2,account,-1,crew=[0,0,3],route=1,pos=origin,capacity_grams=30000000,speed_mm_sec=6500,service_agreement=true))
    stocks=stock_totals(w); population=far_population(w); fleet=VesselFleet()
    sync_far_vessels(fleet,w,origin)
    assert(fleet.ships.len()==1 and w.far.vehicles[1].scene_owned and not w.far.vehicles[2].scene_owned)
    assert(w.far.vehicles[2].pos==origin and stock_totals(w)==stocks)
    w.tick+=600; w.minute=w.tick/120
    sync_far_vessels(fleet,w,origin); sync_far_vessels(fleet,w,origin)
    assert(fleet.ships.len()==2 and length(fleet.ships[0].position-fleet.ships[1].position)>50)
    assert(w.far.vehicles[2].pos==origin and stock_totals(w)==stocks and far_population(w)==population)
    assert(money_balances(w) and goods_balance(w))

test "damage in the last visible frame is committed before the hull folds out of view":
    w=sea_freight_fixture(); fleet=VesselFleet(); origin=w.far.vehicles[1].pos
    sync_far_vessels(fleet,w,origin)
    damage_vessel(fleet,FAR_VESSEL_BASE+1,0.3,999)
    assert(abs(fleet.ships[0].health-0.7)<0.0001)
    cargo=w.far.vehicles[1].cargo; at=w.far.vehicles[1].pos; stocks=stock_totals(w)
    sync_far_vessels(fleet,w,origin+vec3(30000,0,0))
    assert(fleet.ships.len()==0 and not w.far.vehicles[1].scene_owned and w.far.vehicles[1].hull==700)
    assert(w.far.vehicles[1].motion_blocked!="" and w.far.vehicles[1].cargo==cargo)
    w.tick+=120; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[1].pos==at and stock_totals(w)==stocks)
    assert(validate_save_world(w)=="",validate_save_world(w))


test "an active national combat pair takes the bounded leases ahead of closer idle traffic":
    w=naval_fixture(); observer=(w.far.vehicles[0].pos+w.far.vehicles[1].pos)*0.5
    account=new_account(w,"civilian-coaster")
    assert(transfer(w,w.far.districts[100].household_account,account,30000,.trade))
    w.far.districts[100].workers[1]-=3; w.far.crew_population[1]+=3
    w.far.vehicles.push(FarVehicle(2,.ship,100,100,1,account,-1,crew=[0,3,0],route=0,pos=observer,capacity_grams=30000000,speed_mm_sec=6500))
    stocks=stock_totals(w); fleet=VesselFleet()
    sync_far_vessels(fleet,w,observer,2)
    assert(fleet.ships.len()==2)
    assert(vessel_index(fleet,FAR_VESSEL_BASE)>=0 and vessel_index(fleet,FAR_VESSEL_BASE+1)>=0)
    assert(not w.far.vehicles[2].scene_owned and stock_totals(w)==stocks)
