use '../src/flight.jo'
use '../src/planes.jo'
use '../src/sea.jo'

sea_reads=0
counted_sea = (x:f64,z:f64)->vec3:
    global sea_reads
    sea_reads+=1
    vec3(2.0*sin(x*0.03+z*0.01),0.06*cos(x*0.03+z*0.01),0.02*cos(x*0.03+z*0.01))

test "wave clearance bound skips distant swell work with identical flight and contact states":
    k=craft_spec(.gull,build_craft(.gull,LIVERIES[0]).contacts)
    e=FlightEnv(has_swell=true,swell=counted_sea);bounded=e;bounded.swell_ceiling=2.001
    full_reads=0;bounded_reads=0
    loop altitude in [500.0,3.0,0.8]:
        a=CraftState(position=vec3(0,altitude,0),velocity=vec3(0,0,-k.cruise_speed),fuel=k.fuel_capacity,water_age=1)
        b=a
        loop i in 0..120:
            c=Controls(throttle=0.8,pitch=0.1,roll=0.2)
            sea_reads=0;step(k,a,c,e,1.0/60.0)
            if altitude==500:full_reads+=sea_reads
            sea_reads=0;step(k,b,c,bounded,1.0/60.0)
            if altitude==500:bounded_reads+=sea_reads
            assert(a==b)
    print("airborne swell calls: full={full_reads} bounded={bounded_reads}")
    assert(bounded_reads<full_reads/4)

test "rendered sea height stays inside the advertised flight clearance ceiling":
    loop rough in [0.0,1.0,3.0]:
        set_sea_rough(rough);ceiling=swell_height_bound()
        loop i in 0..1000:
            assert(f64(swell_at(f64(i*173-90000),f64(i*37-40000),f64(i)*0.7).x)<=ceiling)
    set_sea_rough(1)
