use '../src/wing_vapour.jo'
use '../src/flight_feedback.jo'
use '../src/title_shots.jo'
use '../src/flight.jo'
# The vapour over the wings forms only where it really does: a hard pull, fast, in very damp air;
# it comes and goes with the pull; in the title's race it shows for a moment at the pylon, no more.

test "only in the hardest pulls, fast, in very damp air":
    wet = vapour_dampness(20.0, true, 8.5, 0.0, 0.0, 0.0)
    dry = vapour_dampness(20.0, false, 14.0, 0.0, 0.0, 0.0)
    assert(wing_vapour_strength(46.0, 4.0, wet) == 0.0, "a 4 g pull makes none")
    assert(wing_vapour_strength(46.0, 7.0, dry) == 0.0, "nor dry air at 7 g")
    assert(wing_vapour_strength(30.0, 7.0, wet) == 0.0, "nor a slow aircraft")
    assert(wing_vapour_strength(48.0, 6.5, wet) > 0.5, "a 6.5 g pull fast in damp air: {wing_vapour_strength(48.0, 6.5, wet):.2}")
    # (a stricter thing than the wingtips' trails: wherever the sheet forms, the trails do too)
    loop load in [3.0, 4.5, 5.5, 6.5, 8.0]:
        loop speed in [36.0, 42.0, 50.0]:
            if wing_vapour_strength(speed, load, wet) > 0.0: assert(vapour_strength(speed, load, wet) > 0.0, "a sheet with no trails at {load} g, {speed} m/s")

test "it forms quickly and is gone soon after the pull eases":
    w = WingVapour()
    t = 0.0
    loop t < 0.3:
        wing_vapour_step(w, 0.8, t)
        t += 1.0 / 60.0
    assert(w.amount > 0.7, "formed: {w.amount:.2}")
    loop t < 1.0:
        wing_vapour_step(w, 0.0, t)
        t += 1.0 / 60.0
    assert(w.amount == 0.0, "gone: {w.amount:.3}")

_ground = (x: f64, z: f64) -> f64: -40.0
_sun = (h: f64) -> vec3: normalize(vec3(-1, f32(0.4), 0.2))

test "in the title's race it shows for a moment in the pylon turn":
    set_speed_scale(3.3)
    r = TitleRng(s = u64(51))
    shot = title_next_shot(r, none, vec3(0, 0, 0), [], _ground, _sun, "low-race")
    title_fly_race(shot, craft_spec(.falco, []))
    loop i in 0..2:
        tr = shot.race[i]
        shown = 0.0; most = 0.0
        loop k in 0..tr.at.len():
            damp = vapour_dampness(f64(tr.at[k].y), true, shot.hour, 0.0, 0.0, 0.0)
            s = wing_vapour_strength(f64(length(tr.velocity[k])) / 3.3, tr.load[k], damp)
            if s > 0.05: shown += 1.0 / 60.0
            most = max(most, s)
        print("racer {i}: the sheet for {shown:.2} s, at most {most:.2}")
        assert(shown > 0.2 and shown < 1.5, "racer {i}: the sheet for {shown:.2} s")
