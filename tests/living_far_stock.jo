use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_seed.jo'
use '../src/living_far_stock.jo'
use '../src/living_money.jo'
use '../src/living_cargo.jo'
use '../src/living_checks.jo'
use '../src/living_save.jo'

stock_fixture = () -> World:
    w = build_world(); w.far.version = 1
    loop id in [0,100,200]:
        market = if id == 0: w.places[0].market.account else: new_account(w,"far-market:{id}",5000)
        home = new_account(w,"far-households:{id}",5000)
        w.far.districts[id] = FarDistrict(id=id,core=if id == 0: 0 else: -1,born_country=1,controller=1,authority=1,market_account=market,household_account=home,output=3,productivity=100)
    w

test "far production transport and consumption keep exact shared source and goods partitions":
    w = stock_fixture(); before = stock_totals(w)
    assert(far_produce(w,100,3,1000,true))
    batch = far_take_market(w,100,3,400); far_put_market(w,200,batch)
    root = batch.roots.keys()[0]
    assert(w.cargo_sources[root].producer_place == 100 and w.cargo_sources[root].far_quantity == 1000)
    meal = far_take_market(w,200,3,100); far_use(w,meal)
    assert(w.cargo_sources[root].far_quantity == 900 and w.cargo_sources[root].consumed == 100)
    assert(stock_totals(w)[3] == before[3]+9000)
    assert(far_stock_errors(w).len() == 0 and invariant_errors(w).len() == 0)

test "a detailed gateway transfers the same physical roots in both directions without an import":
    w = stock_fixture(); before = stock_totals(w); created = w.goods_ledger.created
    sources = w.next_cargo_source
    batch = far_take_market(w,0,3,500)
    far_put_market(w,100,batch)
    root = batch.roots.keys()[0]
    assert(w.cargo_sources[root].far_quantity == 500)
    assert(stock_totals(w) == before and w.next_cargo_source == sources)
    back = far_take_market(w,100,3,500); far_put_market(w,0,back)
    assert(w.cargo_sources[root].far_quantity == 0 and stock_totals(w) == before)
    assert(w.goods_ledger.created == created and w.next_cargo_source == sources)
    assert(far_stock_errors(w).len() == 0 and validate_save_world(w) == "")

test "far producer lots become detailed owned crates with their original provenance":
    w = stock_fixture(); assert(far_produce(w,100,2,1000))
    batch = far_take_market(w,100,2,1000); root = batch.roots.keys()[0]
    far_put_market(w,0,batch)
    found = false
    loop _, lot in w.cargo:
        if lot.source == root:
            found = true; assert(lot.owner == w.places[0].market_owner and lot.holder == 0 and lot.quantity == 1000)
    assert(found and w.cargo_sources[root].far_quantity == 0 and invariant_errors(w).len() == 0)
    text = canonical_text(w); restored = from_text[World](text); assert(restored is World)
    assert(canonical_text(restored) == text and validate_save_world(restored) == "")

test "far maps and stock roots have a canonical insertion-order-independent save":
    a = stock_fixture()
    assert(far_produce(a,100,3,1000) and far_produce(a,100,2,500))
    b = a; reversed: {int: FarDistrict}
    keys = b.far.districts.keys(); keys.sort(descending=true)
    loop id in keys: reversed[id] = b.far.districts[id]
    b.far.districts = reversed
    assert(canonical_text(a) == canonical_text(b))
    text = canonical_text(b); restored = from_text[World](text); assert(restored is World)
    assert(canonical_text(restored) == text and far_stock_errors(restored).len() == 0)
