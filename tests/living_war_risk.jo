use '../src/living_types.jo'
use '../src/living_war.jo'
use '../src/living_war_contacts.jo'
use '../src/living_commissions.jo'
use '../src/living_far_economy.jo'
use '../src/living_money.jo'
use 'living_war_names.jo'
use '../src/living_far_transport.jo'
use '../src/living_war_views.jo'
use '../src/living_far_checks.jo'
use '../src/living_war_checks.jo'

# Scoped national travel fixture; unrelated core pilot plans are not advanced here.
offshore_contact_fixture = () -> World:
    w=battle_name_fixture()
    points=[vec3(100,0,0),vec3(150,0,30000),vec3(200,0,0)]
    length_mm=0
    loop k in 1..points.len(): length_mm+=int(round(f64(length(points[k]-points[k-1]))*1000.0))
    w.far.links[0].points=points; w.far.links[0].length_mm=length_mm
    loop vehicle in [0,1]:
        w.far.vehicles[vehicle].speed_mm_sec=6500
        w.far.vehicles[vehicle].capacity_grams=30000000
        assert(war_start_leg(w,vehicle,0,.patrol))
    far_crew_meals(w)
    half=int(round(f64(length(points[1]-points[0]))*1000.0))
    w.tick=(half*60+6499)/6500; w.minute=w.tick/120
    far_advance_transport(w,w.tick); far_crew_meals(w)
    war_supply(w,0); war_supply(w,1)
    assert(length(w.far.vehicles[0].pos-w.far.vehicles[1].pos)<1)
    assert(length(w.far.vehicles[0].pos-w.place_contexts[100].center)>29000)
    assert(validate_far(w)=="" and validate_war(w)=="",validate_far(w)+validate_war(w))
    w

test "an actual offshore contact cannot tell its distant home port through the chart's local danger":
    w=offshore_contact_fixture(); before=w.far.districts[100].danger
    begin_war_contacts(w); assert(w.war.contacts.len()==1)
    assert(w.far.districts[100].danger==before and w.far.districts[200].danger==0)
    w.people[0].pose.pos=far_counter(w,100)
    view=[loop v in war_places(w): if v.place==100: v][0]
    assert(view.danger==before and view.reason=="Observed locally.")
    assert(finish_war_contact(w,0,0))
    assert([loop r in w.far.districts[100].reports: if r.kind=="battle": r].len()==0)
    assert([loop r in w.far.vehicles[0].reports: if r.kind=="battle": r].len()==1)
    assert(money_balances(w) and goods_balance(w) and far_population(w)==w.far.opening_population)

test "nearby towns on both sides observe the actual local armed contact":
    w=battle_name_fixture(); begin_war_contacts(w)
    assert(w.war.contacts.len()==1)
    assert(w.far.districts[100].danger==100 and w.far.districts[200].danger==100)
    w.people[0].pose.pos=far_counter(w,200)
    view=[loop v in war_places(w): if v.place==200: v][0]
    assert(view.danger==100)
