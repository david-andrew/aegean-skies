# The strait as the scenario opens it; the player's aircraft put down on the sea where it was,
# out of fuel.
staged = () -> (Battle,int,data.World):
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    sc=build_scenario("strait",towns,build_craft_models())!
    b=sc.battle;w=sc.world
    b.homes=[]
    me=combat_index(b,w.people[w.player].craft)
    loop i in 0..b.actors.len():
        if b.actors[i].side!=b.actors[me].side: b.actors[i].present=false;b.actors[i].status=.escaped
    p=b.actors[me]
    p.state=water_start(p.spec,vec3(p.state.position.x,0,p.state.position.z),0.0);p.state.fuel=0
    p.previous=p.state.position;p.previous_point=world_point(p.state.position)
    b.actors[me]=p
    (b,me,w)

sit = (b: mut Battle, me: int, seconds: f64):
    loop _ in 0..int(seconds*60.0):
        p=b.actors[me]
        step_battle(b,flight_env(f64(b.tick)/60.0,p.state.position),p.state.position)

test "what the aircraft needs, the times said, the fees and the tow's geometry":
    s=water_start(CraftSpec(),vec3(0,0,0),0.0)
    s.fuel=100;assert(help_need(s,200.0)==.none)
    s.fuel=1;assert(help_need(s,200.0)==.fuel)
    s.engine_damage=0.9;assert(help_need(s,200.0)==.tow)
    air=CraftState(position=vec3(0,300,0));air.fuel=0
    assert(help_need(air,200.0)==.none)
    assert(help_eta_words(5)=="a few minutes" and help_eta_words(19)=="about twenty minutes" and help_eta_words(60)=="about an hour" and help_eta_words(150)=="about three hours")
    assert(tow_fee(10000.0,false)==TOW_BASE+400 and tow_fee(10000.0,true)==TOW_BASE+400+LAUNCH_CALL)
    along=help_alongside(vec3(0,0,0),vec3(500,0,0),12.0)
    # (abeam of the way it comes, off the wingtip; a boat farther off for its length)
    assert(abs(f64(along.z)-(6.0+ALONGSIDE_GAP))<0.01 and abs(f64(along.x))<0.01)
    big=help_alongside(vec3(0,0,0),vec3(500,0,0),12.0,26.0)
    assert(abs(f64(big.z)-31.0)<0.01 and abs(f64(big.x)-6.5)<0.01)
    v=Vessel(id=1,kind=.canal_launch,owner=0,side=0,position=vec3(100,0,0),yaw=PI/2.0)
    place=tow_place(v,TOW_LINE)
    # (astern, to the west of a boat heading east, and nosed east after it)
    assert(f64(place.0.x)<100.0-TOW_LINE and abs(f64(place.0.z))<0.01)
    assert(f64(length(heading_vector(place.1)-vec3(1,0,0)))<0.01)

test "one of the flight comes down alongside with the cans, and takes off again after":
    b,me,w=staged()
    at=b.actors[me].state.position
    wi=-1;near=1e18
    loop i in 0..b.actors.len():
        a=b.actors[i]
        if a.side==b.actors[me].side and i!=me and a.status==.flying and a.present:
            d=f64(length(a.state.position-at))
            if d<near:near=d;wi=i
    assert(wi>=0)
    along=help_alongside(at,b.actors[wi].state.position,b.actors[me].spec.span)
    e=flight_env(0.0,at)
    send_assist(b,b.actors[wi].craft,vec3(along.x,at.y,along.z),e.wind)
    waited=0.0
    loop waited<300.0 and b.actors[wi].pilot.plan.phase!=.done:
        sit(b,me,1.0);waited+=1.0
    a=b.actors[wi]
    print("wingman alongside after {waited:.0} s: {length(vec3(a.state.position.x-along.x,0,a.state.position.z-along.z)):.1} m from the spot, {length(a.state.position-at):.1} m from the aircraft, crashed {a.state.crashed}")
    assert(a.pilot.plan.phase==.done and a.status==.flying and not a.state.crashed)
    assert(f64(length(vec3(a.state.position.x-along.x,0,a.state.position.z-along.z)))<15.0)
    assert(f64(length(a.state.position-at))>4.0)
    b.assist.stage=2
    sit(b,me,5.0)
    release_assist(b,e.wind)
    up=0.0
    loop up<150.0 and f64(b.actors[wi].state.position.y)<120.0:
        sit(b,me,1.0);up+=1.0
    w2=b.actors[wi]
    print("off the water and up 120 m in {up:.0} s (at {w2.state.position.y:.0} m, {length(w2.state.velocity):.1} m/s, phase {w2.pilot.plan.phase}, moored {w2.state.moored}, on the water {w2.state.on_water})")
    assert(f64(b.actors[wi].state.position.y)>=120.0 and not b.actors[wi].state.crashed)
    end_assist(b)
    assert(b.assist.craft<0 and not b.actors[wi].pilot.plan.initialized)

test "a boat comes round the land to the aircraft, and tows it in to the harbour":
    b,me,w=staged()
    at=b.actors[me].state.position
    h=help_harbour(at,90000.0)
    assert(h>=0)
    berth=vessel_berth(h,.canal_launch)!
    f=VesselFleet()
    spec=vessel_spec(.canal_launch)
    along=help_alongside(at,vec3(berth.0.x,0,berth.0.y),12.0,spec.length)
    lane=request_sea_lane(f,-1,-1,berth.0,along.xz,spec.draft,spec.beam*0.5+2.0)
    assert(lane>=0 and spawn_vessel(f,Vessel(id=HELP_VESSEL+1,kind=.canal_launch,owner=0,side=0,lane=lane,position=vec3(berth.0.x,0,berth.0.y),status=.waiting_route)))
    n=0
    loop n<20000 and f.lanes[sea_lane_index(f,lane)].status!=.ready and f.lanes[sea_lane_index(f,lane)].status!=.blocked:
        step_sea_navigation(f,64);n+=1
    print("{help_harbour_name(h)}: the launch's lane {f.lanes[sea_lane_index(f,lane)].status} after {n} steps, {f.lanes[sea_lane_index(f,lane)].points.len()} points")
    assert(f.lanes[sea_lane_index(f,lane)].status==.ready)
    k=vessel_index(f,HELP_VESSEL+1)
    step_vessels(f,vec2(0,0),0.5)
    left=lane_left(f,f.ships[vessel_index(f,HELP_VESSEL+1)])
    print("{left:.0} m to come; told {help_eta_words(help_minutes(left,spec.speed))}")
    # (a wait skipped: on along the lane, the last 250 m left to be seen)
    lane_advance(f,HELP_VESSEL+1,1e9,250.0)
    v=f.ships[vessel_index(f,HELP_VESSEL+1)]
    assert(abs(lane_left(f,v)-250.0)<5.0)
    secs=0.0
    loop secs<600.0 and f.ships[vessel_index(f,HELP_VESSEL+1)].status==.underway:
        step_vessels(f,vec2(0,0),0.5);secs+=0.5
    v=f.ships[vessel_index(f,HELP_VESSEL+1)]
    print("alongside after {secs:.0} s: {length(v.position.xz-along.xz):.1} m from the spot, status {v.status}")
    assert(v.status==.docked and f64(length(v.position.xz-along.xz))<6.0)
    # (the tow: a new voyage from where it lies, in to the harbour's berth)
    lane2=request_sea_lane(f,-1,h,v.position.xz,berth.0,spec.draft,spec.beam*0.5+2.0,berth.1)
    assert(lane2>=0 and set_vessel_route(f,HELP_VESSEL+1,lane2))
    n=0
    loop n<20000 and f.lanes[sea_lane_index(f,lane2)].status!=.ready and f.lanes[sea_lane_index(f,lane2)].status!=.blocked:
        step_sea_navigation(f,64);n+=1
    assert(f.lanes[sea_lane_index(f,lane2)].status==.ready)
    step_vessels(f,vec2(0,0),0.5)
    lane_advance(f,HELP_VESSEL+1,1e9,150.0)
    secs=0.0;wet=0;tows=0
    loop secs<600.0 and f.ships[vessel_index(f,HELP_VESSEL+1)].status==.underway:
        step_vessels(f,vec2(0,0),0.5);secs+=0.5
        place=tow_place(f.ships[vessel_index(f,HELP_VESSEL+1)],TOW_LINE)
        tows+=1
        if sea_depth_ok(place.0.xz,0.5):wet+=1
    v=f.ships[vessel_index(f,HELP_VESSEL+1)]
    print("in at the berth after {secs:.0} s: {length(v.position.xz-berth.0):.1} m off it; the towed aircraft on water {wet} of {tows} steps")
    assert(v.status==.docked or v.status==.anchored)
    assert(wet*10>=tows*9)
    dock=help_dock(h,[])
    assert(dock!=none)
