use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_dispatch.jo'
use '../src/living_market.jo'
use '../src/living_claims.jo'
use '../src/living_jobs.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'

test "actual resolved import funds one local report without revealing it at remote HQ":
    w = build_world()
    prepare_shipments(w)
    w.shipments[1].state = 1
    w.shipments[1].arrival_minute = 0
    post_import_receipts(w)
    id = w.shipments[1].paperwork_job
    assert(id >= 5 and w.jobs[id].origin == 1 and w.jobs[id].cause.purpose == .report)
    assert(w.jobs[id].cause.beneficiary == 5 and w.jobs[id].wet_charter)
    count = w.next_job
    post_import_receipts(w)
    assert(w.next_job == count)
    assert(w.accounts[w.jobs[id].escrow_account].cents == w.jobs[id].reward_cents)
    assert(money_balances(w) and goods_balance(w))

test "charter transfers existing fuel once and cancellation cannot mint a free tank":
    w = build_world()
    prepare_shipments(w); w.shipments[1].state = 1
    post_import_receipts(w)
    id = w.shipments[1].paperwork_job
    # Put the player at the source, penniless, with an empty but healthy owned aircraft.
    w.people[0].place = 1; w.aircraft[0].place = 1; w.aircraft[0].dock = -1
    burn_fuel(w,0,w.aircraft[0].fuel_ml)
    assert(transfer(w,0,w.factions[1].account,w.accounts[0].cents,.trade))
    before = w.places[1].market.inventory.qty[4]
    assert(take_job(w,id,0))
    assert(w.aircraft[0].fuel_ml > 0 and w.places[1].market.inventory.qty[4] < before)
    fuel = w.aircraft[0].fuel_ml
    assert(not take_job(w,id,0) and w.aircraft[0].fuel_ml == fuel)
    assert(expire_job(w,id,true))
    assert("charter-no-show-{id}" in w.obligation_keys)
    assert(money_balances(w) and goods_balance(w))

test "many days of import business have real report departures and return reserves":
    w = build_world(u64(86))
    advance_minutes(w,1440*5)
    reports = 0
    loop _, trip in w.trips:
        if trip.reason.purpose == .report: reports += 1
    assert(reports >= 3)
    assert(money_balances(w) and goods_balance(w))

test "business charter fuel is reserved during public tender and released after cancellation":
    w = build_world()
    prepare_shipments(w); w.shipments[1].state = 1
    post_import_receipts(w)
    job = w.shipments[1].paperwork_job
    reserved = w.jobs[job].charter_reserved_milli
    assert(reserved > 0 and w.places[1].market.inventory.reserved[4] == reserved)
    assert(expire_job(w,job,true))
    assert(w.places[1].market.inventory.reserved[4] == 0 and w.jobs[job].charter_reserved_milli == 0)
    assert(money_balances(w) and goods_balance(w))
