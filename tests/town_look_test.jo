# The island towns' look (art direction, gap 8): walls muted with a coloured one now and then,
# every roof with a lit and a shaded pitch, and the home town climbing its slope in tiers with a
# landmark every dozen houses or so. Colours are judged as the midday sun lights them (the lit
# face's measured gain, about 1.09, 1.01, 0.89).
use '../src/objects.jo'
use '../src/world.jo'

_lin = (u: f64) -> f64: if u <= 0.04045: u / 12.92 else: pow((u + 0.055) / 1.055, 2.4)
_g = (t: f64) -> f64: if t > 0.008856: pow(t, 1.0 / 3.0) else: 7.787 * t + 16.0 / 116.0

# L*, C* of a colour lit by the midday sun
_lab = (c: vec4) -> vec2:
    r = _lin(clamp(f64(c.x) * 1.09, 0.0, 1.0)); g = _lin(clamp(f64(c.y) * 1.01, 0.0, 1.0)); b = _lin(clamp(f64(c.z) * 0.89, 0.0, 1.0))
    x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047
    y = 0.2126 * r + 0.7152 * g + 0.0722 * b
    z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883
    fx = _g(x); fy = _g(y); fz = _g(z)
    a = 500.0 * (fx - fy); bb = 200.0 * (fy - fz)
    vec2(f32(116.0 * fy - 16.0), f32(sqrt(a * a + bb * bb)))

test "walls are muted, with about one in five to eight a coloured accent":
    accents = 0
    loop c in WALLS:
        lc = _lab(c)
        if f64(lc.y) > 18.0: accents += 1
        else: assert(f64(lc.y) <= 14.5 and f64(lc.x) >= 50.0 and f64(lc.x) <= 86.0, "{c} {lc}")
    assert(accents * 8 >= WALLS.len() and accents * 4 <= WALLS.len(), "{accents} of {WALLS.len()}")

test "every roof has a lit and a shaded pitch at least 12 apart in lightness":
    loop c in ROOFS + [SLATE]:
        lit = _lab(c); shade = _lab(roof_shade(c))
        assert(f64(lit.x) - f64(shade.x) >= 12.0, "{c}: {lit} {shade}")
    # (and a gable is built with both, whichever way it faces)
    loop yaw in [0.0, 0.7, 1.6, 3.1, 4.4]:
        vs: Vertex3D[]
        add_gable(vs, vec3(0, 0, 0), 10.0, 9.0, 2.0, ROOFS[0], rotation_y(yaw))
        colours: vec4[]
        loop v in vs[0..12]:
            if not (v.color in colours): colours.push(v.color)
        assert(ROOFS[0] in colours and roof_shade(ROOFS[0]) in colours)

test "the home town climbs its slope in tiers, with a landmark every dozen houses or so":
    tw = build_town(SETTLEMENTS[0])
    assert(tw.houses.len() >= 60)
    out = tw.out
    lo = 1e9; hi = -1e9
    tiers: int[]
    loop h in tw.houses:
        inland = f64(dot(tw.center.xz - h.xz, out))
        lo = min(lo, inland); hi = max(hi, inland)
        t = int(floor(inland / 13.5))
        if not (t in tiers): tiers.push(t)
    assert(hi - lo >= 55.0, "{lo} {hi}")
    assert(tiers.len() >= 5, "{tiers}")
    # the verticals: chapels and churches, and the towers (narrow and tall)
    tall = tw.chapels.len()
    loop s in tw.sites:
        if s.width < 8.0 and s.depth < 8.0 and s.height > 15.0: tall += 1
    assert(tall * 15 >= tw.houses.len(), "{tall} for {tw.houses.len()}")
