use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_events.jo'
use '../src/living_news.jo'
use '../src/living_text.jo'
use '../src/living_sim.jo'
use '../src/living_duties.jo'

test "news local reputation idempotent occurrence expiry and private debt":
    w = build_world()
    r = Reason(purpose=.raid,actor=22,counterparty=18,origin=5,destination=5,good=6,quantity=2000)
    event = emit_event(w,.raid,5,22,18,r,4000)
    publish_events(w)
    key = ReputationKey(0,.person,22)
    assert(w.reputation.get(key,0) == 0)
    assert(not (NewsReceiptKey(0,0,event) in w.receipts))
    n = w.people[18].news[0]
    # A real carried account can reach Porto; a remote acquaintance alone cannot.
    assert(receive_place(w,0,retell(n,18,w.minute)))
    value = w.reputation[key]
    assert(value < 0)
    loop i in 0..100: receive_place(w,0,n)
    assert(w.reputation[key] == value)
    assert(w.places[0].news[0].confidence == 1000)
    w.minute = 10081; w.tick = w.minute*120
    assert(not receive_place(w,0,n) and w.reputation[key] == value)
    # Original private bill does not gossip out of participants.
    d = emit_event(w,.late,0,2,4,w.obligations[w.obligation_keys["nikos_engine_bill"]].reason,0,true)
    publish_events(w)
    loop news in w.places[0].news: assert(news.event != d)

test "rank preserves raid and relationship memory after event expiry":
    w = build_world()
    e = emit_event(w,.raid,5,22,18,Reason(purpose=.raid,actor=22,counterparty=18,origin=5,destination=5),10000)
    publish_events(w)
    loop i in 0..20:
        emit_event(w,.produced,5,25,-1,Reason(purpose=.trade,actor=25,destination=5,good=0,quantity=1000))
    publish_events(w)
    found = false
    loop n in w.places[5].news:
        if n.event == e: found = true
    assert(found and w.places[5].news.len() == 12)
    id = w.relationship_index[RelationshipKey(18,22)]
    assert(w.relationships[id].grievance == 400 and w.relationships[id].memories[0].event == e)
    w.events.remove(e)
    assert(w.relationships[id].memories[0].reason.counterparty == 18)

test "opening circumstances render specific lines and bark has saved cooldown":
    w = build_world()
    assert("Nikos Arvanitis" in say_reason(w,w.trips[0].reason))
    assert("Leila Demir" in say_reason(w,w.trips[0].reason))
    assert("medicine" in proximity_speech(w,1))
    assert("Dario Ferraro" in proximity_speech(w,8))
    advance_minutes(w,30)
    assert("late" in news_lines(w,0).join("\n"))
    state = PresentationState()
    line = bark(w,state,1,w.people[1].pose.pos)
    assert(line != "" and bark(w,state,1,w.people[1].pose.pos) == "")
