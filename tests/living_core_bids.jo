core_bid_fixture = () -> World:
    w=build_world(u64(42)); contexts: LifePlaceContext[]; seeds: FarPlaceSeed[]
    loop k in 0..6:
        contexts.push(LifePlaceContext(k,"Counter {k}",0,k,w.harbors[k].center,true,k))
        seeds.push(FarPlaceSeed(k,80,0,if k==2: 0 else: 3))
    assert(publish_place_contexts(w,1,contexts,[-1,-1,-1]))
    assert(populate_settlement_economy(w,1,seeds,[]))
    # Real household consumption, recorded against the original wine roots.
    used=far_take_market(w,2,1,2500); far_use(w,used)
    w.minute=1440; w.tick=w.minute*120; far_supply_requests(w,2)
    w

test "detailed courier work accepts only a received funded priced need and the business finances its real goods":
    w=core_bid_fixture(); count=w.next_job
    maintain_received_core_bids(w); assert(w.next_job==count)
    w.minute+=60; w.tick=w.minute*120
    far_arriving_accounts(w,0,w.far.districts[2].reports)
    goods=stock_totals(w); roots=w.next_cargo_source; external=w.ledger.external_in_cents
    maintain_received_core_bids(w)
    assert(w.next_job==count+1); j=w.jobs[count]
    assert(j.origin==0 and j.destination==2 and j.good==1 and j.buyer_account==w.places[2].market.account)
    assert(j.sale_unit_cents>0 and j.sale_delivery_fee==2400 and j.sale_payee==w.places[0].market.account)
    assert(j.reward_funder==w.places[0].market.account and j.provenance.freight_payer==j.reward_funder)
    assert(j.provenance.negotiated and j.provenance.request_report>=0 and j.provenance.heard_minute>j.provenance.requested_minute)
    assert(work_provenance_error(w,j.provenance)=="")
    assert(stock_totals(w)==goods and w.next_cargo_source==roots and w.ledger.external_in_cents==external)
    assert(j.provenance.request_report in w.far.accepted_requests)
    maintain_received_core_bids(w); assert(w.next_job==count+1)
    # Cancellation refunds only the unearned carrier escrow to the business; the
    # already bought goods retain their sender's physical ownership at the source.
    business=j.reward_funder; before=w.accounts[business].cents
    assert(expire_job(w,count,true) and w.accounts[business].cents==before+j.reward_cents)
    assert(stock_totals(w)==goods and money_balances(w) and goods_balance(w))

test "an expired buying order cannot create a courier job or spend a supplier advance":
    w=core_bid_fixture(); bids=w.far.districts[2].reports
    w.minute+=12000; w.tick=w.minute*120
    far_arriving_accounts(w,0,bids)
    before=w.next_job; money=w.accounts[w.places[0].market.account].cents
    maintain_received_core_bids(w)
    assert(w.next_job==before and w.accounts[w.places[0].market.account].cents==money)

test "far production and deliveries land on the real detailed counter shelf and its arsenal output is actually purchasable":
    w=core_bid_fixture()
    loop good in [4,5,6,8]:
        prior=far_market_qty(w,0,good)
        assert(far_produce(w,0,good,1500))
        assert(far_market_qty(w,0,good)==prior+1500,"detailed counter cannot sell its actual received good {good}")
        ids=cargo_ids(w,.market,0,good)
        loop id in ids:
            c=w.cargo[id]
            if w.cargo_sources[c.source].producer_place==0 and c.job<0:
                assert(cargo_at_market(w,c,w.places[0].market_owner,0))
    # Remove the output so the real arsenal recipe must refill it from existing inputs.
    stock=far_take_market(w,0,8,far_market_qty(w,0,8)); far_use(w,stock)
    w.minute=1800; w.tick=w.minute*120; initialize_war(w)
    w.countries[0].capital_id= -1; w.countries[0].seat=0
    before=far_market_qty(w,0,8); war_industry_minute(w)
    assert(far_market_qty(w,0,8)==before+1000)
    assert(money_balances(w) and goods_balance(w))

test "an existing detailed mail packet carries the accounts sealed at departure and informs its actual receiver only at collection":
    w=core_bid_fixture(); initialize_war(w)
    war_industry_minute(w)
    reports=[loop r in w.far.districts[0].reports: if r.kind=="arsenal": r]
    assert(reports.len()>0); report=reports[0]
    id=post_job(w,1,2,.sealed,-1,1,1800,w.minute+1000)
    assert(id>=0 and [loop r in w.jobs[id].carried_reports: if r.id==report.id: r].len()==1)
    assert([loop r in w.far.districts[2].reports: if r.id==report.id: r].len()==0)
    assert(take_job(w,id,0))
    loop _ in 0..200:
        if w.jobs[id].loaded: break
        advance_minutes(w,1)
    assert(w.jobs[id].loaded and start_trip(w,0,2,w.jobs[id].cause)>=0)
    loop _ in 0..400:
        if w.jobs[id].state==.delivered: break
        advance_minutes(w,1)
    assert(w.jobs[id].state==.delivered)
    delivered=[loop r in w.far.districts[2].reports: if r.id==report.id: r]
    assert(delivered.len()==1 and delivered[0].occurred_minute==report.occurred_minute and delivered[0].carriage==report.carriage+1)
    receiver=w.places[2].market_owner
    assert([loop r in w.people[receiver].far_reports: if r.id==report.id: r].len()==1)
    assert(not deliver_job(w,id,0) and money_balances(w) and goods_balance(w))
