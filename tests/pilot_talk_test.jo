# The pilot's small talk (src/pilot_talk.jo) and remarks he lets pass: ignoring what people say to
# him, outside a conversation, never lowers what they think of him; his own answers are short, come
# from what he did, and never speak of plans or what comes next.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/life_types.jo'
use '../src/speech.jo'
use '../src/reputation_types.jo'
use '../src/reputation.jo'
use '../src/reputation_talk.jo'
use '../src/pilot_day_types.jo'
use '../src/pilot_talk.jo'
use '../src/options.jo'
use '../src/world_bytes.jo'

_lean_ge = (a: RepLean, b: RepLean) -> bool: a.warmth >= b.warmth and a.honour >= b.honour and a.daring >= b.daring and a.reliability >= b.reliability

_affinity = (w: World, a: int, b: int) -> int:
    rel = w.relationship_index.get(RelationshipKey(a,b),-1)
    if rel >= 0: w.relationships[rel].affinity else: 0

test "remarks he lets pass, outside a conversation, never lower their opinion of him":
    base = build_world()
    advance_minutes(base,2)
    p = 6
    base.people[base.player].place = base.people[p].place
    rep_act(base,.asked_over,p)
    quiet = base; ignored = base
    # (an hour: one sits with him and passes remarks, the street's people too; he says nothing)
    loop m in 0..60:
        if m % 3 == 0:
            _ = passing_line(ignored,p)
            _ = table_remark(ignored,p,m/3)
            loop q in 1..6: _ = passing_line(ignored,q)
        advance_minutes(ignored,1)
        advance_minutes(quiet,1)
    loop q in 1..11:
        a = rep_view(ignored,q); b = rep_view(quiet,q)
        assert(_lean_ge(a.lean,b.lean) and a.regard >= b.regard,"{q}: {a.lean} < {b.lean}")
        assert(_affinity(ignored,q,ignored.player) >= _affinity(quiet,q,quiet.player))
        assert(rep_pull(ignored,q) >= rep_pull(quiet,q))

test "his answers never speak of plans or what comes next, and say one thing":
    w = build_world(); advance_minutes(w,600)
    ids = [loop pl in w.places: pl.id]
    banned = [" will "," I'll","'ll ","going to","tomorrow","next","later","plan","soon","tonight I","gonna"]
    names = ["Enzo","Marta","Kalamos","Porto Vecchio","Mikra"]
    doings: Doing[]
    pilot_did(doings,Doing(.flew,w.minute-90,where="Kalamos",rough=2))
    lines: str[]
    loop kind in [DoingKind.tavli_won,.tavli_lost,.swam,.fished,.sold_catch,.shave,.stars,.ride,.rescued,.set_ashore,.battle]:
        one = doings
        pilot_did(one,Doing(kind,w.minute-30,who="Enzo",where="Kalamos"))
        loop seq in 0..4: lines.push(pilot_on_day(w,one,seq))
    loop rough in 0..4:
        loop seq in 0..4: lines.push(pilot_on_weather(w,[Doing(.flew,w.minute-60,rough=rough)],false,3.0,seq))
    loop seq in 0..4:
        lines.push(pilot_on_weather(w,[],true,3.0,seq)); lines.push(pilot_on_weather(w,[],false,12.0,seq)); lines.push(pilot_on_day(w,[],seq))
    loop kind in [RepKind.rescued_foe,.rescued_friend,.rescued_survivors,.shot_down,.flew_home_in_formation,.left_the_fight,.job_done,.job_late,.job_failed,.debt_paid,.debt_defaulted]:
        loop storm in [0,900]:
            d = rep_deed(w,rep_record(w,kind,ids[1],ids[1],2,1,1,[],storm))!
            loop seq in 0..4:
                lines.push(pilot_on_deed(d,seq))
                lines.push(pilot_on_day(w,[],seq))
    assert(lines.len() > 100)
    loop l in lines:
        assert(l != "")
        loop b in banned: assert(not (" "+l+" ").contains(b),l)
        assert(split(l," ").len() <= 10,l)
        assert([loop n in names: if l.contains(n): 1].len() <= 1,l)

test "what he says comes from what he did":
    w = build_world(); advance_minutes(w,600)
    # (nothing done: nothing claimed)
    assert(pilot_on_day(w,[],0) in ["Quiet one.","Can't complain.","Same as ever."])
    # (a rough flight: rough air; a calm one: smooth)
    rough = pilot_on_weather(w,[Doing(.flew,w.minute-40,rough=2)],false,2.0,0)
    calm = pilot_on_weather(w,[Doing(.flew,w.minute-40,rough=0)],false,2.0,0)
    assert(rough.contains("Bumpy") or rough.contains("Lumpy") or rough.contains("all over"),rough)
    assert(calm.contains("Smooth") or calm.contains("glass") or calm.contains("bump"),calm)
    # (a delivery the world knows of, today)
    t = w.places[1].id
    rep_record(w,.job_done,t,t,3,-1,1,[],0)
    day = pilot_on_day(w,[],0)
    assert(day.contains("load") or day.contains("Freight"),day)
    # (a tavli win he had)
    w2 = build_world(); advance_minutes(w2,600)
    won = pilot_on_day(w2,[Doing(.tavli_won,w2.minute-20,who="Enzo")],0)
    assert(won.contains("tavli"),won)
    # (a storm rescue spoken of: modest)
    d = rep_deed(w,rep_record(w,.rescued_foe,-1,t,-1,1,1,[],900))!
    assert(pilot_on_deed(d,0) in ["Wet, mostly.","Wasn't much choice.","I was wetter than he was."])
    # (how rough a flight's air was)
    assert(flight_rough(0.0,0.0,3.0) == 0 and flight_rough(0.0,0.0,15.0) == 2 and flight_rough(0.8,0.5,10.0) == 3)

struct _SaveBefore:
    minute = 0
    seed = 0

struct _SaveAfter:
    minute = 0
    seed = 0
    pilot_day: Doing[] = []

test "his day is kept in the save, and an older save loads with an empty day":
    w = build_world(); advance_minutes(w,600)
    pilot_did(w.pilot_day,Doing(.flew,w.minute-90,where="Kalamos",rough=2,rain=true))
    pilot_did(w.pilot_day,Doing(.tavli_won,w.minute-20,who="Enzo"))
    got = world_from_bytes(world_to_bytes(w))
    if got is TextError: panic("{got}")
    assert(got.pilot_day == w.pilot_day and got.pilot_day.len() == 2)
    # (and what he says of it after the load is what he'd have said before)
    assert(pilot_on_day(got,got.pilot_day,0) == pilot_on_day(w,w.pilot_day,0))
    assert(pilot_on_weather(got,got.pilot_day,false,3.0,1) == pilot_on_weather(w,w.pilot_day,false,3.0,1))
    # (bytes written before the day was kept: the same reading gives an empty day)
    old = from_bytes[_SaveAfter](to_bytes(_SaveBefore(minute=5,seed=7)))
    if old is TextError: panic("{old}")
    assert(old.minute == 5 and old.pilot_day.len() == 0)
