# A night under a roof: who sits down to supper (the host's own household, as the table holds),
# when supper and the morning are, the talk at the table (the host most, a child now and then,
# spaced out), and the notebook's line.
use '../src/stay.jo'

test "at the family's table: those the host looks after, as many as the table holds":
    ids = [10, 11, 12, 13, 14, 15, 16]
    guardians = [5, 5, 9, 5, 5, 5, 5]
    h = stay_household(guardians, ids, 5)
    assert(h.len() == FAMILY_SEATS.len() - 2)
    loop id in h: assert(id != 12)
    assert(stay_household(guardians, ids, 7).len() == 0)

test "supper of an evening, coffee of a morning":
    assert(stay_supper_time(1140) and stay_supper_time(1080) and not stay_supper_time(1290) and not stay_supper_time(900))
    assert(stay_morning_time(420) and not stay_morning_time(800) and not stay_morning_time(200))

test "the host talks most; a child now and then; nobody all at once":
    s = Stay(stage = .supper)
    speakers: int[]
    loop k in 0..9:
        sp = stay_next_speaker(s, 2)
        speakers.push(sp)
        stay_said(s, sp, stay_line(s, sp, false), f64(k) * 10.0)
    hosts = [loop sp in speakers: if sp == -1: 1].len()
    assert(hosts == 6, "{speakers}")
    assert(0 in speakers and 1 in speakers)
    # (no children: the host alone)
    assert(stay_next_speaker(Stay(lines_said = 2), 0) == -1)

test "remarks spaced out, and only at the table":
    s = Stay(stage = .supper)
    assert(stay_line_due(s, 0.0))
    stay_said(s, -1, "Eat, eat.", 0.0)
    assert(not stay_line_due(s, 3.0) and stay_line_due(s, 12.0))
    s.stage = .asleep
    assert(not stay_line_due(s, 100.0))

test "the lines are the ordinary talk of a meal at home":
    loop l in HOST_SUPPER_LINES: assert(l.len() > 5 and l.len() < 90)
    loop l in CHILD_LINES: assert(l.ends_with("?") or l.ends_with("."))
    assert(stay_line(Stay(), -1, true) in HOST_MORNING_LINES)

test "the notebook's line says where and what":
    hotel = Stay(kind = .hotel, slept = true)
    assert(stay_note(hotel, "", "Porto Vecchio", "Hotel Ancora").contains("Hotel Ancora"))
    fam = Stay(kind = .family, slept = true, had_supper = true)
    line = stay_note(fam, "Eleni", "Porto Vecchio", "Hotel Ancora")
    assert(line.contains("Eleni") and line.contains("night") and line.contains("Supper"))
