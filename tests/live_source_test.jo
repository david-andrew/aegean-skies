# Live music placed in the world: heard to the side the source is on, quieter and darker far
# off and through walls, softer on top from behind, roomier indoors.
use '../src/music_synth.jo'
use '../src/live_source.jo'

_tone = (n: int) -> f64[]: [loop i in 0..n: sin(TAU * 440.0 * f64(i) / f64(MUSIC_RATE)) * 0.3 + sin(TAU * 3500.0 * f64(i) / f64(MUSIC_RATE)) * 0.1]

_levels = (h: LiveHearing) -> vec2:
    s = make_live_spatial()
    frames = live_process(s, h, _tone(MUSIC_RATE))
    l = 0.0; r = 0.0
    loop i in MUSIC_RATE / 2..MUSIC_RATE:
        l += f64(frames[i * 2]) * f64(frames[i * 2]); r += f64(frames[i * 2 + 1]) * f64(frames[i * 2 + 1])
    vec2(f32(sqrt(l)), f32(sqrt(r)))

test "a source to the camera's right is louder and earlier in the right ear":
    # looking along -z, a source at +x is to the right
    h = live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(6, 0, 0))
    assert(h.pan > 0.95 and abs(h.front) < 0.05)
    t = live_targets(h)
    assert(t.gain_r > t.gain_l * 2.5 and t.itd > 5.0)
    lv = _levels(h)
    assert(f64(lv.y) > f64(lv.x) * 2.0)
    left = _levels(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(-6, 0, 0)))
    assert(f64(left.x) > f64(left.y) * 2.0)

test "turning the camera moves the source across":
    pans = [loop k in 0..8: live_hearing(vec3(0, 0, 0), vec3(f32(sin(TAU * f64(k) / 8.0)), 0, f32(-cos(TAU * f64(k) / 8.0))), vec3(0, 0, -5)).pan]
    assert(abs(pans[0]) < 0.01 and pans[2] < -0.9 and pans[6] > 0.9)

test "far off it is quieter and darker; through a wall more so":
    near = live_targets(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, -4)))
    far = live_targets(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, -80)))
    walled = live_targets(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, -4), 0.9))
    assert(far.gain_l < near.gain_l * 0.1 and far.cut_l < near.cut_l)
    assert(walled.gain_l < near.gain_l * 0.4 and walled.cut_l < far.cut_l)

test "behind, the top is softened; indoors the room is fuller":
    ahead = live_targets(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, -8)))
    behind = live_targets(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, 8)))
    assert(ahead.shelf > 0.99 and behind.shelf < 0.6)
    room = live_targets(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, -8), 0.0, .indoors))
    assert(room.wet > ahead.wet * 2.0)

test "close by, the harbour hushes; walls and boxes":
    assert(live_duck(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, -4))) < 0.6)
    assert(live_duck(live_hearing(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 0, -60))) > 0.99)
    assert(box_blocks(vec3(0, 1, -5), vec3(0, 1, 5), vec3(-1, 0, -1), vec3(1, 3, 1)))
    assert(not box_blocks(vec3(3, 1, -5), vec3(3, 1, 5), vec3(-1, 0, -1), vec3(1, 3, 1)))
    assert(inside_box(vec3(0, 1, 0), vec3(-1, 0, -1), vec3(1, 3, 1)))
