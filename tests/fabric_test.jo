# The pilot's scarf: worn, its ends stay outside his torso whatever the wind and however he stands,
# sits or kneels, and hang no lower than the small of his back; in flight's wind the flutter is
# just as it was; after dark no face of it is lit from below.
use '../src/fabric.jo'
use '../src/folk.jo'

_pilot = () -> Figure: Figure(Mesh(), Mesh(), Mesh(), Mesh(), f32(1.025), Mesh(), Mesh(), f32(0.285))

# (each case: posture, stride; the walk and the run blow the air at him from ahead, as in the game)
_POSES = [(0, 0.0), (0, 0.7), (0, 1.0), (1, 0.0), (3, 0.0), (4, 0.0)]

_inside = (q: vec3, back: f64) -> bool:
    abs(f64(q.x)) < 0.28 - 0.002 and abs(f64(q.z)) < back - 0.002 and f64(q.y) > 0.9 + 0.002 and f64(q.y) < 1.48 - 0.002

# the scarf's vertices on foot, in his own (unscaled) frame, worn or (wearer false) as a free ribbon
_on_foot = (f: Figure, pose: int, stride: f64, yaw: f64, wind: vec3, t: f64, worn: bool) -> vec3[]:
    phase = t * 7.5
    frame = translation(vec3(3, 0, -2)) * rotation_y(yaw + PI) * scaling(f64(f.height)) * figure_pose(f, phase, stride, pose)
    fwd = vec3(f32(sin(yaw)), 0, f32(cos(yaw)))
    air = (wind - fwd * f32(stride * 3.0)) * 2.2
    vs: Vertex3D[]
    wearer: ClothWearer? = if worn: ClothWearer(frame, f64(f.back)) else: none
    loop c in pilot_scarf(0.75): cloth_vertices(vs, c, transform_point(frame, c.at), air, transform_dir(frame, vec3(0, 1, 0)), t, transform_dir(frame, c.drape), 95.0, wearer)
    back = inverse(frame)
    [loop v in vs: transform_point(back, v.pos)]

test "worn, the scarf's ends never pass through his torso, standing, walking, running, sitting or kneeling":
    f = _pilot()
    worn_in = 0
    free_in = 0
    lowest = 9.0
    loop pose in _POSES:
        loop d in 0..12:
            a = f64(d) / 12.0 * TAU
            loop speed in [0.0, 1.0, 2.5, 5.0]:
                wind = vec3(f32(cos(a) * speed), 0, f32(sin(a) * speed))
                loop k in 0..12:
                    t = f64(k) * 0.37
                    loop q in _on_foot(f, pose.0, pose.1, 0.6, wind, t, true):
                        if _inside(q, f64(f.back)): worn_in += 1
                        lowest = min(lowest, f64(q.y))
                    loop q in _on_foot(f, pose.0, pose.1, 0.6, wind, t, false):
                        if _inside(q, f64(f.back)): free_in += 1
    print("scarf points inside the torso: worn {worn_in}, free {free_in}; lowest {lowest:.3f}")
    assert(free_in > 0)             # (the case this guards: left free, the ribbon goes through him)
    assert(worn_in == 0)
    # (and it hangs no lower than the small of the back, above the jacket's hem)
    assert(lowest > 0.95)

test "in flight's wind the worn scarf flutters exactly as the free one did":
    f = _pilot()
    seat = translation(vec3(10, 300, 5)) * rotation_y(0.4) * rotation_x(0.08) * scaling(f64(f.height))
    loop speed in [30.0, 55.0, 80.0]:
        loop aoa in [-0.08, 0.0, 0.1]:
            loop slip in [-0.1, 0.0, 0.12]:
                air_here = normalize(vec3(f32(sin(slip)), f32(-sin(aoa)), 1.0)) * f32(speed)
                air = transform_dir(seat, air_here)
                loop k in 0..40:
                    t = f64(k) * 0.093
                    worn: Vertex3D[]
                    free: Vertex3D[]
                    loop c in pilot_scarf():
                        knot = transform_point(seat, c.at)
                        up = transform_dir(seat, vec3(0, 1, 0))
                        cloth_vertices(worn, c, knot, air, up, t, transform_dir(seat, c.drape), 120.0, ClothWearer(seat, f64(f.back)))
                        cloth_vertices(free, c, knot, air, up, t, transform_dir(seat, c.drape), 120.0)
                    assert(worn.len() == free.len())
                    loop j in 0..worn.len(): assert(length(worn[j].pos - free[j].pos) < 0.0001)

test "after dark no face of the cloth is lit from below; by day its faces keep their own normals":
    f = _pilot()
    frame = rotation_y(0.3) * scaling(f64(f.height))
    loop sun in [normalize(vec3(0.3, -0.8, 0.4)), normalize(vec3(-0.5, 0.7, 0.2))]:
        loop k in 0..20:
            vs: Vertex3D[]
            air = vec3(f32(sin(f64(k))) * 30.0, f32(cos(f64(k) * 1.7)) * 8.0, 25.0)
            loop c in pilot_scarf(): cloth_vertices(vs, c, transform_point(frame, c.at), air, vec3(0, 1, 0), f64(k) * 0.21, transform_dir(frame, c.drape), 95.0, none, sun)
            loop j in 0..vs.len() / 6:
                front = vs[j * 6].normal
                rear = vs[j * 6 + 3].normal
                if sun.y < 0.0:
                    assert(front.y >= 0.0 and rear.y >= 0.0)
                else:
                    assert(length(front + rear) < 0.0001)
