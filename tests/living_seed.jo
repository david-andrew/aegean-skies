use '../src/living_types.jo'
use '../src/living_money.jo'
use '../src/living_seed.jo'
use '../src/living_content.jo'

test "seed content is self consistent":
    w = build_world(u64(42))
    assert(w.people.len() == 26 and w.places.len() == 6 and w.aircraft.len() == 8)
    assert(w.goods.len() == 9 and w.factions.len() == 4)
    assert(w.jobs.len() == 5 and w.accounts.len() == 41 and w.obligation_keys.len() == 30)
    assert(money_balances(w) and goods_balance(w))
    loop id in 0..26:
        assert(w.people[id].id == id and w.people[id].account == id)
        loop key in PERSON_SEEDS[id].obligation_keys: assert(key in w.obligation_keys)
    assert(w.places[0].market.inventory.reserved[6] == 7000)
    assert(w.places[2].market.price_cents[6] == 3240)
    assert(w.places[1].market.price_cents[2] < 1400)
    assert(w.places[4].market.price_cents[1] > 1200)
    assert(w.aircraft[0].operator == -1)
    assert(w.aircraft[1].trip == 0 and w.people[2].trip == 0 and w.jobs[0].cargo_mode == .sealed)
    loop c in w.aircraft:
        assert(inventory_valid(c.cargo))
        assert(w.people[c.owner].craft == c.id)
        if c.operator >= 0: assert(c.owner == w.people[c.operator].id)
        assert(craft_grams(w,c.id) <= AIRFRAMES[int(c.kind)].cargo_grams)
        loop other in w.aircraft:
            if c.id != other.id and c.place >= 0 and c.dock >= 0:
                assert(c.place != other.place or c.dock != other.dock)
    loop id in 0..5:
        j = w.jobs[id]
        assert(w.accounts[j.escrow_account].cents == j.reward_cents)
        print("Job{id}: {w.people[j.poster].name} -> {PLACE_NAMES[j.destination]}, {j.reward_cents}c, {j.state}")
    print("Opening quotes Porto medicine {w.places[0].market.price_cents[6]}c; Selene wine {w.places[4].market.price_cents[1]}c")
