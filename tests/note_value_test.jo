# A played note's written value from its length against the score's quarter note: MIDI ticks over
# PPQ, or seconds against the tempo; snapped to the nearest value by ratio, dotted values included.
use '../src/music_data.jo'
use '../src/music_synth.jo'
use '../src/live_notes.jo'
use '../src/music_tempo.jo'
use '../src/note_value.jo'
use '../src/street_phrase.jo'

_v = (kind: int, dotted: bool = false) -> NoteValue: NoteValue(kind, dotted)

test "each value's own length in ticks is that value, at any PPQ":
    loop ppq in [96, 384, 480, 960]:
        assert(note_value_ticks(ppq * 4, ppq) == _v(NOTE_WHOLE))
        assert(note_value_ticks(ppq * 3, ppq) == _v(NOTE_HALF, true))
        assert(note_value_ticks(ppq * 2, ppq) == _v(NOTE_HALF))
        assert(note_value_ticks(ppq * 3 / 2, ppq) == _v(NOTE_QUARTER, true))
        assert(note_value_ticks(ppq, ppq) == _v(NOTE_QUARTER))
        assert(note_value_ticks(ppq * 3 / 4, ppq) == _v(NOTE_EIGHTH, true))
        assert(note_value_ticks(ppq / 2, ppq) == _v(NOTE_EIGHTH))
        assert(note_value_ticks(ppq * 3 / 8, ppq) == _v(NOTE_SIXTEENTH, true))
        assert(note_value_ticks(ppq / 4, ppq) == _v(NOTE_SIXTEENTH))

test "odd lengths go to the nearest value by ratio; beyond the ends, the ends":
    # (1.2 quarters: 1.2 from a quarter, 1.25 from a dotted quarter -> a quarter; 1.3 the other way)
    assert(note_value_ticks(576, 480) == _v(NOTE_QUARTER))
    assert(note_value_ticks(624, 480) == _v(NOTE_QUARTER, true))
    # (a held-over eighth, played a little long, and a clipped half)
    assert(note_value_ticks(270, 480) == _v(NOTE_EIGHTH))
    assert(note_value_ticks(860, 480) == _v(NOTE_HALF))
    # (a staccato note, much shorter than written, is a sixteenth; a tie over bars, a whole)
    assert(note_value_ticks(30, 480) == _v(NOTE_SIXTEENTH))
    assert(note_value_ticks(480 * 9, 480) == _v(NOTE_WHOLE))
    assert(note_value_of(0.0) == _v(NOTE_SIXTEENTH))
    # (no dotted whole: six quarters is nearer a whole than anything else shown)
    assert(note_value_of(6.0) == _v(NOTE_WHOLE))

test "seconds against the tempo (microseconds a quarter) or the quarter's seconds":
    # 120 to the quarter: 500000 us
    assert(note_value_tempo(0.5, 500000.0) == _v(NOTE_QUARTER))
    assert(note_value_tempo(1.0, 500000.0) == _v(NOTE_HALF))
    assert(note_value_tempo(0.75, 500000.0) == _v(NOTE_QUARTER, true))
    assert(note_value_tempo(0.125, 500000.0) == _v(NOTE_SIXTEENTH))
    # 60 to the quarter
    assert(note_value_tempo(0.25, 1000000.0) == _v(NOTE_SIXTEENTH))
    assert(note_value_tempo(4.1, 1000000.0) == _v(NOTE_WHOLE))
    assert(note_value_seconds(0.3, 0.6) == _v(NOTE_EIGHTH))
    loop kind in 0..5:
        loop dotted in [false, true]:
            if kind == NOTE_WHOLE and dotted: continue
            v = _v(kind, dotted)
            assert(note_value_seconds(note_value_quarters(v) * 0.9161, 0.9161) == v)

test "every catalogue piece with a score has its quarter note; the opening call has none":
    assert(MUSIC_TEMPO.len() == MUSIC_PIECES.len())
    loop p in 0..MUSIC_PIECES.len():
        if p == 1:
            assert(music_quarter_at(p, 3.0) == none)
            continue
        q = music_quarter_at(p, 10.0)
        assert(q != none)
        assert(q! > 0.2 and q! < 2.0)
    assert(music_quarter_at(-1, 0.0) == none and music_quarter_at(MUSIC_PIECES.len(), 0.0) == none)

test "a band number's notes come out as a mix of values, and the street phrase in eighths and longer":
    # (Adelita: the mandolin's tune over the guitar)
    s = MusicSynth()
    music_load(s, 10)
    kinds: {int: int}
    q = music_quarter_at(10, 0.0)!
    loop e in s.events:
        if e.instrument != 8: continue
        v = note_value_seconds(f64(e.duration) / f64(MUSIC_RATE), q)
        kinds[v.kind * 2 + (if v.dotted: 1 else: 0)] = kinds.get(v.kind * 2 + (if v.dotted: 1 else: 0), 0) + 1
    assert(kinds.len() >= 3, "{kinds}")
    street: {int: int}
    loop person in 0..6:
        loop k in 0..40:
            loop e in street_events(person, f64(k) * 2.0 + 3.0):
                v = note_value_seconds(f64(e.duration) / f64(MUSIC_RATE), STREET_QUARTER)
                assert(v.kind <= NOTE_EIGHTH)
                street[v.kind * 2 + (if v.dotted: 1 else: 0)] = street.get(v.kind * 2 + (if v.dotted: 1 else: 0), 0) + 1
    assert(street.get(NOTE_EIGHTH * 2, 0) > 0 and street.len() >= 2, "{street}")
