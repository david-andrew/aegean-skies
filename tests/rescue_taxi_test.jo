# A survivor in the strait's squall: an Orenthian put down on the water, climbed out beside it.
# Returns the scenario, the towns and the survivor's id.
staged = () -> (ScenarioState,Town[],int):
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    towns=[loop st in SETTLEMENTS:build_town(st)]
    init_world_towns(towns)
    set_speed_scale(3.3);set_lift_scale(3.3);data.scale_airframes(3.3)
    sc=build_scenario("strait",towns,build_craft_models())!
    b=sc.battle;w=sc.world
    me=combat_index(b,w.people[w.player].craft)
    foe=-1
    loop i in 0..b.actors.len():
        if b.actors[i].side==2 and foe<0:foe=i
    loop i in 0..b.actors.len():
        if i!=me and i!=foe:b.actors[i].present=false;b.actors[i].status=.escaped
    b.actors[me].present=false
    f=b.actors[foe]
    spot=vec3(STRAIT_CENTER.x,0,STRAIT_CENTER.z+2500)
    f.state=CraftState(position=spot+vec3(0,f32(f.spec.float_height),0),orientation=quat_euler(0,-1.1,0),fuel=f.state.fuel,on_water=true,water_age=1.0,damage=f.state.damage)
    f.state.damage.parts[1].health=0.0;refresh_damage(f.spec,f.state)
    f.status=.disabled;f.down_reported=true;f.pilot.mode=.ditching;f.gun.locked=true;f.pilot.formation=false
    f.previous=f.state.position;f.previous_point=world_point(f.state.position)
    b.actors[foe]=f
    loop _ in 0..30:step_battle(b,flight_env(f64(b.tick)/60.0,spot),spot)
    assert(b.actors[foe].ditched and b.descents.len()==1)
    commit_war_scene(w,VesselFleet(),b)
    id=-1
    loop k,v in w.war.survivors:
        if v.person==b.actors[foe].person:id=k
    assert(id>=0)
    sc.battle=b;sc.world=w
    (sc,towns,id)

test "taxied up by hand through the squall, the player is offered the swimmer and takes them aboard":
    sc,towns,id=staged()
    b=sc.battle;w=sc.world
    swimmer=b.descents[0].position
    k=sc.flyer.spec;s=sc.flyer.state
    # (on the water 220 m off, idling, the nose roughly toward them)
    toward=normalize(vec3(1,0,0.4))
    s=CraftState(position=swimmer-toward*220.0+vec3(0,f32(k.float_height),0),orientation=quat_euler(0,-atan2(f64(toward.x),-f64(toward.z)),0),fuel=s.fuel,on_water=true,water_age=1.0)
    r=RescueView()
    offered=-1.0;nearest=1e9
    craft=w.people[w.player].craft
    loop tick in 0..60*150:
        e=flight_env(f64(b.tick)/60.0,s.position)
        # (as a player does it: the rudder toward them, a little throttle, closed as they come near)
        to=b.descents[0].position-s.position;to.y=0
        d=f64(length(to))
        want=atan2(f64(to.x),-f64(to.z))
        c=Controls(throttle=if d>70.0: 0.22 else: if d>22.0: 0.08 else: 0.0,yaw=clamp(angle_delta(want,heading(s))*2.0,-1.0,1.0),assist=0.0)
        step(k,s,c,e,1.0/60.0)
        step_battle(b,e,s.position)
        nearest=min(nearest,d)
        if tick%20==0:
            commit_war_scene(w,VesselFleet(),b)
            _ = rescue_scan(r,w,s.position)
        if rescue_pickup_from(r,s)==id:offered=f64(tick)/60.0;break
    print("offered after {offered:.1} s, nearest {nearest:.1} m, speed {length(vec3(s.velocity.x,0,s.velocity.z)):.2} m/s across, {length(s.velocity):.2} in all")
    assert(offered>0 and not s.moored)
    # (the world's record of the aircraft, as the game commits it each tick)
    w.aircraft[craft].state=.taxi;w.aircraft[craft].pose.pos=s.position;w.aircraft[craft].pose.vel=s.velocity
    assert(living.board_survivors(w,id,w.player)==1)

test "lying to an anchor out at sea, the swimmer can still be taken aboard, and there is no shore to step to":
    sc,towns,id=staged()
    b=sc.battle;w=sc.world
    swimmer=b.descents[0].position
    s=sc.flyer.state
    s=CraftState(position=swimmer+vec3(14,f32(sc.flyer.spec.float_height),0),fuel=s.fuel,on_water=true,water_age=1.0)
    moor(s,s.position,0.0)
    assert(s.moored)
    r=RescueView()
    _ = rescue_scan(r,w,s.position)
    assert(rescue_pickup_from(r,s)==id)
    # (open sea: nothing to step ashore to, so it is never offered)
    assert(shore_point(towns,s.position)==none)
    # (and at a harbour's dock there is)
    assert(shore_point(towns,towns[0].docks[0])!=none)
