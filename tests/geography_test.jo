use '../src/geography.jo'
use '../src/world.jo'

test "country geography preserves every sampled legacy source and contact height":
    assert(load_land(embed('../assets/terrain.bin')))
    geography_enabled = false
    points: (f64,f64,f64,f64)[]
    loop j in 0..71:
        loop i in 0..71:
            x = -14000.0+f64(i)*400.0; z = -14000.0+f64(j)*400.0
            points.push((x,z,height(x,z),surface_height(x,z)))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    loop p in points:
        assert(height(p.0,p.1) == p.2)
        assert(surface_height(p.0,p.1) == p.3)

test "macro data validates identity length and checksum before publication":
    b = embed('../assets/world.bin')
    assert(load_geography(b))
    bad = b; bad[1234] = bad[1234] xor u8(1)
    assert(not load_geography(bad))
    assert(not load_geography(b[0..b.len()-1]))
    assert(load_geography(b))

test "new land is bounded diverse and its contact grid matches rendered vertices":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    assert(small_islands.len() >= 80)
    highest = 0.0; land = 0; sea = 0
    loop j in 0..101:
        loop i in 0..126:
            x = -250000.0+f64(i)*4000.0; z = -200000.0+f64(j)*4000.0
            h = new_land_height(x,z)
            assert(is_finite(h) and h >= -60.0 and h <= 3010.0)
            highest = max(highest,h)
            if h > 0.0: land += 1
            else: sea += 1
    assert(highest > 2700.0)
    assert(land > 2000 and sea > land)
    loop k in 0..500:
        x = -180600.0+f64(k)*14.0; z = -140000.0+f64(k%17)*14.0
        # Choose exact global canonical vertices, including negative indices.
        x = floor(x/14.0)*14.0; z = floor(z/14.0)*14.0
        assert(abs(new_land_surface(x,z)-new_land_canonical(x,z)) < 0.000001)
    loop isl in small_islands:
        assert(isl.peak <= 650.0)
        assert(abs(f64(isl.center.x)) > LEGACY_RESERVE or abs(f64(isl.center.y)) > LEGACY_RESERVE)

test "sampling order does not change a new terrain height or region":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    samples: (f64,int)[]
    loop k in 0..300:
        x = -188000.0+f64(k)*173.13; z = -104500.0+f64(k%73)*98.75
        samples.push((new_land_surface(x,z),land_region_at(x,z)))
    loop n in 0..300:
        k = 299-n
        x = -188000.0+f64(k)*173.13; z = -104500.0+f64(k%73)*98.75
        assert(samples[k].0 == new_land_surface(x,z))
        assert(samples[k].1 == land_region_at(x,z))
