# The wheeled types on the ground as a player handles them (tools/ground_survey.jo): a crosswind run,
# the stick held back on the keys, the amphibians off their wheels, a taxi turn and the brakes, on
# flight model v2 at the player's pure scale over flat grass.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/landplane_ground_test.jo
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as planes

const K = 3.3
const FIELD = 60.0
const D = 57.2958

_spec = (kind: planes.Craft) -> fl.CraftSpec:
    fl.set_speed_scale(K); fl.set_lift_scale(K)
    tw.set_tweaks(tw.Tweaks())
    k = fl.craft_spec(kind, planes.build_craft(kind, planes.LIVERIES[0]).contacts)
    k.player = true
    k

_reset = ():
    fl.set_speed_scale(1.0); tw.set_tweaks(tw.Tweaks())

_ground = (wind_true: vec3) -> fl.FlightEnv: fl.FlightEnv(ground = (x: f64, z: f64) -> f64: FIELD, wind = wind_true * f32(K))
_start = (k: fl.CraftSpec) -> fl.CraftState:
    s = fl.ground_start(k, vec3(0, f32(FIELD), 0)); s.gear = 1.0
    loop i in 0..120: fl.step(k, s, fl.Controls(gear = true), _ground(vec3(0, 0, 0)), 1.0 / 60.0)
    s
_vt = (s: fl.CraftState) -> f64: f64(length(s.velocity)) / K
_pitch = (s: fl.CraftState) -> f64: asin(clamp(f64(fl.forward(s).y), -1.0, 1.0))
_bank = (s: fl.CraftState) -> f64:
    r = quat_rotate(s.orientation, vec3(1, 0, 0)); u = quat_rotate(s.orientation, vec3(0, 1, 0))
    atan2(-f64(r.y), f64(u.y))
_dir = (heading: f64, climb: f64) -> vec3: vec3(f32(sin(heading) * cos(climb)), f32(sin(climb)), f32(-cos(heading) * cos(climb)))
_mouse = (k: fl.CraftSpec, s: fl.CraftState, heading: f64, climb: f64, throttle: f64) -> fl.Controls:
    c = fl.steer(k, s, _dir(heading, climb))
    c.throttle = throttle; c.gear = true
    c

# A 5 m/s crosswind on the run, the strip's heading held on the mouse: on her line (the air's grip
# that set her drifting with the wind is the tyres' on the wheels), wings level, no wing tip on the grass
# as she lifts (her bank kept within what her tip clears)
test "a crosswind take-off on the mouse: on her line, wings level, off without a wing strike":
    loop kind in [planes.Craft.fiat_cr20, planes.Craft.kea_chelidon]:
        k = _spec(kind)
        e = _ground(vec3(-5, 0, 0))
        s = _start(k)
        h0 = fl.heading(s); a = s.position
        lat = vec3(f32(cos(h0)), 0, f32(sin(h0)))
        off = -1.0; drift = 0.0; heel = 0.0; swing = 0.0
        loop i in 0..60 * 80:
            fl.step(k, s, _mouse(k, s, h0, if _vt(s) > k.stall_speed * 0.85: 0.07 else: 0.0, 1.0), e, 1.0 / 60.0)
            if s.on_ground:
                drift = abs(f64(dot(s.position - a, lat))) / K
                heel = max(heel, abs(_bank(s)) * D); swing = max(swing, abs(fl.angle_delta(fl.heading(s), h0)) * D)
            if not s.on_ground and f64(s.position.y) > FIELD + 10.0 * K: off = s.time; break
        print("{kind} crosswind take-off on the mouse: off at {off:.1} s, drift on the wheels {drift:.1} m, heel {heel:.1}, swing {swing:.1}, damage {s.hull_damage:.3}")
        assert(off > 0.0 and not s.crashed and s.hull_damage < 0.01 and drift < 20.0 and heel < 6.0 and swing < 12.0)
    _reset()

# On the keys, the stick pulled back from near her flying speed and held: rotated to her best lift and
# no further, so she flies off (sat on her tail past the stall, she only dragged along the grass)
test "the stick held back on the run rotates her and she flies off":
    loop kind in [planes.Craft.fiat_cr20, planes.Craft.kea_chelidon]:
        k = _spec(kind)
        e = _ground(vec3(0, 0, 0))
        s = _start(k)
        off = -1.0; steepest = 0.0
        loop i in 0..60 * 80:
            c = fl.Controls(throttle = 1.0, gear = true, pitch = if _vt(s) > k.stall_speed * 0.8: 1.0 else: 0.0)
            fl.step(k, s, c, e, 1.0 / 60.0)
            if s.on_ground: steepest = max(steepest, _pitch(s))
            if not s.on_ground and f64(s.position.y) > FIELD + 5.0 * K: off = s.time; break
        print("{kind} stick held back: off at {off:.1} s, the nose no higher than {steepest * D:.0} on the grass")
        assert(off > 0.0 and off < 40.0 and not s.crashed)
    _reset()

# The amphibians on their wheels: the elevator works there too, so they rotate and fly off a field
# (on the wheels they had none, and ran on nose-down or sat on their tails till the strip ran out)
test "the amphibians rotate on their wheels and fly off the grass":
    loop kind in [planes.Craft.sopwith_bat_boat, planes.Craft.albatross]:
        k = _spec(kind)
        e = _ground(vec3(0, 0, 0))
        s = _start(k)
        h0 = fl.heading(s)
        off = -1.0
        loop i in 0..60 * 100:
            fl.step(k, s, _mouse(k, s, h0, if _vt(s) > k.stall_speed * 0.85: 0.07 else: 0.0, 1.0), e, 1.0 / 60.0)
            if not s.on_ground and f64(s.position.y) > FIELD + 5.0 * K: off = s.time; break
        print("{kind} off the grass on her wheels at {off:.1} s")
        assert(off > 0.0 and not s.crashed and (kind != .sopwith_bat_boat or off < 45.0))
    _reset()

# A half turn on the mouse at a taxi, the aim put round behind: round in a few seconds, upright; and
# the brakes full on from a fast taxi: no standing on her nose
test "taxiing: a half turn on the mouse, upright; full brakes without nosing over":
    loop kind in [planes.Craft.fiat_cr20, planes.Craft.kea_chelidon, planes.Craft.albatross, planes.Craft.sopwith_bat_boat]:
        k = _spec(kind)
        e = _ground(vec3(0, 0, 0))
        s = _start(k)
        h0 = fl.heading(s)
        loop i in 0..60 * 10: fl.step(k, s, _mouse(k, s, h0, 0.0, 0.2), e, 1.0 / 60.0)
        turned = 0.0; last = fl.heading(s); secs = -1.0; heel = 0.0
        loop i in 0..60 * 30:
            fl.step(k, s, _mouse(k, s, h0 + PI * 0.95, 0.0, 0.2), e, 1.0 / 60.0)
            turned += abs(fl.angle_delta(fl.heading(s), last)); last = fl.heading(s)
            heel = max(heel, abs(_bank(s)) * D)
            if turned > PI * 0.9: secs = f64(i) / 60.0; break
        s = _start(k)
        loop i in 0..60 * 60:
            fl.step(k, s, fl.Controls(throttle = 1.0, gear = true), e, 1.0 / 60.0)
            if _vt(s) > k.stall_speed * 0.6: break
        nose = _pitch(s)
        loop i in 0..60 * 40:
            fl.step(k, s, fl.Controls(water_brake = 1.0, gear = true), e, 1.0 / 60.0)
            nose = min(nose, _pitch(s))
            if _vt(s) < 0.2: break
        print("{kind}: half turn on the mouse in {secs:.1} s, heel {heel:.1}; braked to a stop, the nose no lower than {nose * D:.1}")
        # (the Albatross's wheels stand well below her and just ahead of her middle: braked hard she
        # dips onto her keel's forefoot, some 12 degrees, but never over)
        assert(secs > 0.0 and secs < 12.0 and heel < 10.0 and not s.crashed and nose > -15.0 / D)
    _reset()
