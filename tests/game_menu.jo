use '../src/living_types.jo'
use '../src/game_slots.jo'
use '../src/game_menu.jo'
use '../src/title_screen.jo'
use '../src/aircraft_picker.jo'
use '../src/planes.jo'
use '../src/debugmenu.jo'

test "a saved slot reads as its time, place and aircraft, purse and day":
    s=SaveSummary(minute=1440+300,place=2,place_name="Porto Vecchio",player_name="Pilot",mode="walking",craft="Gull",cents=16321)
    row=game_row(GameSlotView(slot=1,exists=true,compatible=true,generation=3,summary=s),1)
    assert(row.slot==1 and row.exists and row.usable and row.autosave)
    assert(row.time.starts_with("Tuesday 4 June 1929, "),row.time)
    assert(row.place=="Porto Vecchio",row.place)
    assert(row.detail=="Gull, ¤163.21, day 2",row.detail)
    s.mode="aboard";s.cents=400
    aboard=game_row(GameSlotView(slot=0,exists=true,compatible=true,generation=1,summary=s),2)
    assert(aboard.place=="Aboard at Porto Vecchio" and aboard.detail=="Gull, ¤4, day 2" and not aboard.autosave)

test "an empty, foreign or older slot says so plainly":
    empty=game_row(GameSlotView(slot=2),-1)
    assert(not empty.exists and not empty.usable and empty.time=="" and empty.problem=="")
    old=SaveSummary(minute=10,place= -1,place_name="Away from a town",mode="aboard")
    row=game_row(GameSlotView(slot=0,exists=true,compatible=false,generation=1,summary=old),-1)
    assert(row.exists and not row.usable and row.problem!="")
    assert(row.place=="Aboard, away from a town" and row.detail=="day 1",row.detail)

test "the title's Continue loads the newest usable save, an older one by its world time":
    view=(slot: int,ok: bool,minute: int,at: f64) -> GameSlotView: GameSlotView(slot=slot,exists=true,compatible=ok,generation=1,summary=SaveSummary(minute=minute,place=0,place_name="Mikra",saved_at=at))
    pick=(views: GameSlotView[]) -> int: title_latest(game_rows(views,-1),[loop v in views: v.summary.saved_at],[loop v in views: v.summary.minute])
    assert(pick([view(0,true,9000,100.0),view(1,true,50,300.0),view(2,true,7000,200.0)])==1)
    # (made by another version: never what Continue loads, however new)
    assert(pick([view(0,true,9000,100.0),view(1,false,50,300.0),GameSlotView(slot=2)])==0)
    # (saved before the time was kept: the furthest on in the world)
    assert(pick([view(0,true,900,0.0),view(1,true,4000,0.0),GameSlotView(slot=2)])==1)
    assert(pick([GameSlotView(slot=0),GameSlotView(slot=1),GameSlotView(slot=2)])== -1)

test "the aircraft picker: every aircraft in its group, named in full, its year, what it is and what it needs":
    list = craft_entries()
    assert(list.len() == CRAFT_NAMES.len())
    counts = [loop g in 0..CRAFT_GROUPS.len(): [loop e in list: if e.group == g: e].len()]
    assert(counts == [16, 7, 4, 5, 1, 6], "groups {counts}")
    velos = list[int(Craft.blackburn_velos)]
    assert(velos.name == "Blackburn Velos" and velos.year == "1925" and velos.group == 5 and velos.needs == "", "{velos.name}|{velos.year}|{velos.group}")
    kea = list[int(Craft.kea_chelidon)]; short = list[int(Craft.short_184)]
    assert(kea.name == "KEA Chelidon" and kea.year == "1927" and kea.group == 5 and kea.needs == "airfield", "{kea.name}|{kea.year}|{kea.group}|{kea.needs}")
    assert(short.name == "Short Type 184" and short.year == "1915" and short.role == "torpedo and reconnaissance seaplane" and short.needs == "")
    s55 = list[int(Craft.sm_s55)]
    assert(s55.name == "Savoia-Marchetti S.55" and s55.year == "1924" and s55.role == "twin-hull long-range boat" and s55.needs == "", "{s55.name}|{s55.year}|{s55.role}")
    cr20 = list[int(Craft.fiat_cr20)]
    assert(cr20.name == "Fiat C.R.20" and cr20.year == "1926" and cr20.role == "single-seat land fighter" and cr20.needs == "airfield")
    assert(list[int(Craft.dornier_dox)].needs == "buoy" and list[int(Craft.hughes_h4)].needs == "buoy" and list[int(Craft.short_sarafand)].needs == "buoy")
    gull = list[int(Craft.gull)]
    assert(gull.name == "Gull" and gull.year == "" and gull.role == "utility / mail" and gull.needs == "")
    loop e in list: assert(e.year != "" or e.group == 0, "{e.name} has no year")

test "the pause menu's tabs: every page once, the player's first, the rest under Advanced settings":
    assert(PAGE_ORDER.len() == PAGES.len())
    loop k in 0..PAGES.len():
        n = 0
        loop s in PAGE_ORDER:
            if s == k: n += 1
        assert(n == 1, "page {k} {PAGES[k]}")
    assert(PAGE_ORDER[0] == 0 and PAGES[0] == "Game")
    names = [loop k in PLAYER_PAGES: PAGES[k]]
    assert(names == ["Game", "Settings", "Gamepad", "Paint"], "{names}")
    assert(PAGES[SETTINGS_PAGE] == "Settings" and PAGES[CONTROLS_PAGE] == "Gamepad")
    at = (name: str) -> int:
        loop s in 0..PAGE_ORDER.len():
            if PAGES[PAGE_ORDER[s]] == name: return s
        -1
    assert(at("Plane") == at("Aircraft") + 1)
    assert(PAGES[PLANE_PAGE] == "Plane" and PAGES[PAINT_PAGE] == "Paint")
    # (the player's tabs alone, until Advanced settings is on; an advanced page opened (a capture)
    # shows them all)
    d = Debug()
    d.page = SETTINGS_PAGE
    assert(shown_pages(d) == PLAYER_PAGES)
    d.opts.advanced = true
    assert(shown_pages(d) == PAGE_ORDER)
    d.opts.advanced = false; d.page = 4
    assert(shown_pages(d) == PAGE_ORDER)