use '../src/living_types.jo'
use '../src/game_slots.jo'
use '../src/game_menu.jo'

test "a saved slot reads as its time, place and aircraft, purse and day":
    s=SaveSummary(minute=1440+300,place=2,place_name="Porto Vecchio",player_name="Pilot",mode="walking",craft="Gull",cents=16321)
    row=game_row(GameSlotView(slot=1,exists=true,compatible=true,generation=3,summary=s),1)
    assert(row.slot==1 and row.exists and row.usable and row.autosave)
    assert(row.time.starts_with("Tuesday 4 June 1929, "),row.time)
    assert(row.place=="Porto Vecchio",row.place)
    assert(row.detail=="Gull, ¤163.21, day 2",row.detail)
    s.mode="aboard";s.cents=400
    aboard=game_row(GameSlotView(slot=0,exists=true,compatible=true,generation=1,summary=s),2)
    assert(aboard.place=="Aboard at Porto Vecchio" and aboard.detail=="Gull, ¤4, day 2" and not aboard.autosave)

test "an empty, foreign or older slot says so plainly":
    empty=game_row(GameSlotView(slot=2),-1)
    assert(not empty.exists and not empty.usable and empty.time=="" and empty.problem=="")
    old=SaveSummary(minute=10,place= -1,place_name="Away from a town",mode="aboard")
    row=game_row(GameSlotView(slot=0,exists=true,compatible=false,generation=1,summary=old),-1)
    assert(row.exists and not row.usable and row.problem!="")
    assert(row.place=="Aboard, away from a town" and row.detail=="day 1",row.detail)
