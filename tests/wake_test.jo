use '../src/wake.jo'
use '../src/world_point.jo'

# Independent reference to the original per-quad expression.
reference_profile=(x:f32,age:f64,strength:f32,skim:f32)->f32:
    ax=abs(x)
    ridge=exp(-((ax-1.0)/0.12)*((ax-1.0)/0.12))*(1.0-skim)
    mid=(1.0-smoothstep(0.0,0.5,ax))*0.4
    (ridge*0.35+mid*0.12)*strength*f32(exp(-age/9.0))

test "cached wake rows preserve the original raised cross-section and slope":
    origin=vec3(-207000,0,-96000)
    loop life in [0.0,0.15,2.0,12.0,40.0]:
        loop skim in [0.0,0.4,1.0]:
            loop strength in [0.0,0.12,1.0]:
                p=WakePoint(WorldPoint(-206885,0,-95795),vec2(0.6,0.8),0,3.5,f32(strength),55,f32(skim))
                row=wake_row(p,life,origin)
                o=f64(p.width)+min(life*f64(p.speed)*KELVIN,25.0)+life*0.25
                assert(row.len()==COLS.len())
                loop c in 0..COLS.len():
                    x=COLS[c]
                    h=reference_profile(x,life,p.strength,p.skim)
                    dx=(reference_profile(x+0.05,life,p.strength,p.skim)-reference_profile(x-0.05,life,p.strength,p.skim))/f32(0.1*o)
                    n=normalize(vec3(0,1,0)-vec3(p.side.x,0,p.side.y)*dx)
                    q=world_local(p.pos,origin).xz+p.side*f32(f64(x)*o)
                    assert(length(row[c].pos-vec3(q.x,0.05+h,q.y))<0.00001)
                    assert(length(row[c].normal-n)<0.00001)
                    assert(row[c].uv==vec2(x,f32(life)))
                    assert(row[c].color==vec4(p.strength,if p.skim>0.5:1.0 else:0.0,f32(min(o/64.0,1.0)),1))
