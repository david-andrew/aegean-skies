use '../src/wake.jo'
use '../src/world_point.jo'
use '../src/geography.jo'
use '../src/river_data.jo'

# Independent reference to the original per-quad expression.
reference_profile=(x:f32,age:f64,strength:f32,skim:f32)->f32:
    ax=abs(x)
    ridge=exp(-((ax-1.0)/0.12)*((ax-1.0)/0.12))*(1.0-skim)
    mid=(1.0-smoothstep(0.0,0.5,ax))*0.4
    (ridge*0.35+mid*0.12)*strength*f32(exp(-age/9.0))

test "cached wake rows preserve the original raised cross-section and slope":
    origin=vec3(-207000,0,-96000)
    loop life in [0.0,0.15,2.0,12.0,40.0]:
        loop skim in [0.0,0.4,1.0]:
            loop strength in [0.0,0.12,1.0]:
                p=WakePoint(WorldPoint(-206885,0,-95795),vec2(0.6,0.8),0,3.5,f32(strength),55,f32(skim))
                row=wake_row(p,life,origin)
                o=f64(p.width)+min(life*f64(p.speed)*KELVIN,25.0)+life*0.25
                assert(row.len()==COLS.len())
                loop c in 0..COLS.len():
                    x=COLS[c]
                    h=reference_profile(x,life,p.strength,p.skim)
                    dx=(reference_profile(x+0.05,life,p.strength,p.skim)-reference_profile(x-0.05,life,p.strength,p.skim))/f32(0.1*o)
                    n=normalize(vec3(0,1,0)-vec3(p.side.x,0,p.side.y)*dx)
                    q=world_local(p.pos,origin).xz+p.side*f32(f64(x)*o)
                    assert(length(row[c].pos-vec3(q.x,0.05+h,q.y))<0.00001)
                    assert(length(row[c].normal-n)<0.00001)
                    assert(row[c].uv==vec2(x,f32(life)))
                    assert(row[c].color==vec4(p.strength,if p.skim>0.5:1.0 else:0.0,f32(min(o/64.0,1.0)),1))

enable_geography=():
    global geography_enabled
    geography_enabled=true

# The same point with nothing kept: wake_row looks the current and every column's level up.
live_point=(p:WakePoint)->WakePoint:
    q=p;q.inland= -1;q.levels=[];q

test "points that keep their water draw the rows of points that look it up every frame":
    enable_geography()
    # (off Kalyrassa's quay out to sea; across Olythoria's lake)
    # (and down a river, from one of its nodes toward the next)
    a=RIVER_NODES[200];b=RIVER_NODES[201]
    down=normalize(b.xy-a.xy)
    loop case in [(WorldPoint(-117683,0,-84975),vec2(0.97,-0.26),20.0,0),(WorldPoint(-211362,0,-99962),vec2(0.6,0.8),8.0,1),(WorldPoint(f64(a.x),0,f64(a.y)),down,6.0,1)]:
        start,dir,speed,inland=case
        w=WakeTrail();t=0.0;worst=0.0;rows=0;moved=0
        loop step in 0..1200:
            t+=1.0/30.0
            at=WorldPoint(start.x+f64(dir.x)*speed*t,0,start.z+f64(dir.y)*speed*t)
            wake_step(w,at,vec3(dir.x,0,dir.y)*f32(speed),true,1.6,t)
            if step%60!=59:continue
            origin=vec3(f32(floor(at.x/1024.0)*1024.0),0,f32(floor(at.z/1024.0)*1024.0))
            loop p in w.pts:
                assert(p.inland==inland)
                kept=wake_row(p,t-p.born,origin);looked=wake_row(live_point(p),t-p.born,origin)
                loop c in 0..kept.len():
                    assert(kept[c].pos.x==looked[c].pos.x and kept[c].pos.z==looked[c].pos.z and kept[c].normal==looked[c].normal and kept[c].color==looked[c].color)
                    d=abs(f64(kept[c].pos.y-looked[c].pos.y));worst=max(worst,d)
                    if d>0.0:moved+=1
                rows+=1
        print("WAKE {start.x:.0},{start.z:.0} rows={rows} columns differing={moved} worst={worst:.6} m")
        assert(rows>500)
        if inland==0:assert(worst==0.0)
        else:assert(worst<0.01)

# The strip as it was assembled: a fresh row per point, a fresh array per frame.
reference_strip=(trails:WakeTrail[],t:f64,origin:vec3)->Vertex3D[]:
    vs:Vertex3D[]
    loop w in trails:
        if w.pts.len()<2:continue
        row=wake_row(w.pts[0],t-w.pts[0].born,origin)
        loop k in 0..w.pts.len()-1:
            a=w.pts[k];b=w.pts[k+1]
            previous=row
            row=wake_row(b,t-b.born,origin)
            if a.strength<=0.0 and b.strength<=0.0:continue
            loop c in 0..COLS.len()-1:
                vs.push(previous[c]);vs.push(row[c]);vs.push(previous[c+1])
                vs.push(previous[c+1]);vs.push(row[c]);vs.push(row[c+1])
    vs

test "the strip built in kept arrays is the strip built afresh, gaps and all":
    enable_geography()
    trails:WakeTrail[]=[WakeTrail(),WakeTrail()]
    t=0.0
    loop step in 0..900:
        t+=1.0/30.0
        # (the second craft lifts off the water for a while: a gap of no strength in its trail)
        loop k in 0..2:
            at=WorldPoint(-117683+f64(k)*40.0+12.0*t,0,-84975-3.0*t)
            wake_step(trails[k],at,vec3(12,0,-3),k==0 or step<300 or step>500,1.6,t)
    origin=vec3(-118784,0,-84992)
    vs:Vertex3D[];rows:Vertex3D[]
    loop again in 0..2: wake_strip(vs,rows,trails,t,origin)
    reference=reference_strip(trails,t,origin)
    assert(vs.len()>1000 and vs.len()==reference.len())
    loop i in 0..vs.len(): assert(vs[i]==reference[i])
