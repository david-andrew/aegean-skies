use '../src/living_types.jo'
use '../src/living_scene.jo'
use '../src/living_far_people.jo'
use '../src/living_far_checks.jo'
use '../src/living_commissions.jo'
use '../src/living_far_types.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'
use '../src/living_sim.jo'
use '../src/living_far_stock.jo'
use 'living_far_economy.jo'

commission_fixture = () -> World:
    w=far_fixture()
    assert(publish_far_harbors(w,[FarHarbor(100,vec3(0,0,1),[vec3(100,0,0)],[vec3(100,2,-10)],vec3(100,0,40)),FarHarbor(200,vec3(0,0,1),[vec3(200,0,0)],[vec3(200,2,-10)],vec3(200,0,40))]))
    w

test "sparse commission reserves original goods and funded pay without spawning stock":
    w=commission_fixture(); before=stock_totals(w); roots=w.next_cargo_source
    id=post_far_commission(w,100,200,3,1000)
    assert(id>=0 and w.far.commissions[id].phase==.open)
    assert(stock_totals(w)==before and w.next_cargo_source==roots)
    assert(w.accounts[w.far.commissions[id].escrow].cents==w.far.commissions[id].reward)
    assert(invariant_errors(w).len()==0 and validate_save_world(w)=="")

test "player carries a real sparse consignment loads at its aircraft and earns only on collection":
    w=commission_fixture(); id=post_far_commission(w,100,200,3,1000)
    c=w.far.commissions[id]; w.people[0].pose.pos=c.pos
    cash=w.accounts[w.people[0].account].cents
    assert(claim_far_commission(w,id) and pickup_far_commission(w,id))
    assert(not collect_far_commission(w,id) and not load_far_commission(w,id))
    w.aircraft[0].pose.pos=vec3(100,0,0); w.aircraft[0].state=.moored
    w.people[0].pose.pos=vec3(100,0,0)
    before=craft_grams(w,0)
    assert(load_far_commission(w,id) and craft_grams(w,0)==before+w.goods[3].package_grams)
    # A moored parcel may be taken back ashore here, including a walking transfer.
    assert(pickup_far_commission(w,id) and load_far_commission(w,id))
    w.aircraft[0].pose.pos=vec3(200,0,0); w.people[0].pose.pos=vec3(200,0,0)
    assert(pickup_far_commission(w,id))
    w.people[0].pose.pos=far_counter(w,200)
    assert(collect_far_commission(w,id) and not collect_far_commission(w,id))
    assert(w.accounts[w.people[0].account].cents==cash+c.reward)
    assert(w.far.commissions[id].phase==.delivered and invariant_errors(w).len()==0)
    text=canonical_text(w); restored=from_text[World](text)
    assert(restored is World and canonical_text(restored)==text and validate_save_world(restored)=="")

test "unclaimed expiry resells rather than erasing cargo or its buyer's title":
    w=commission_fixture(); id=post_far_commission(w,100,200,3,1000)
    before=stock_totals(w); w.far.commissions[id].deadline=w.minute+1
    w.minute+=2; w.tick=w.minute*120
    far_commissions_minute(w)
    assert(w.far.commissions[id].phase==.expired and w.far.commissions[id].cargo.roots.len()==0)
    assert(stock_totals(w)==before, "stock changed")
    errors=invariant_errors(w); assert(errors.len()==0,errors.join("; "))

test "a named sender and paid collector walk the same cargo without duplicating it":
    w=commission_fixture(); id=post_far_commission(w,100,200,3,1000)
    c=w.far.commissions[id]; w.people[0].pose.pos=c.pos
    w.aircraft[0].pose.pos=vec3(100,0,0); w.aircraft[0].state=.moored
    assert(claim_far_commission(w,id,0,.automatic))
    roots=w.next_cargo_source
    loop _ in 0..10:
        w.tick+=120; w.minute=w.tick/120
        far_commissions_minute(w); far_people_minute(w)
    assert(w.far.commissions[id].phase==.aboard and w.far.commissions[id].porter== -1)
    w.aircraft[0].pose.pos=vec3(200,0,0)
    cash=w.accounts[w.people[0].account].cents
    loop _ in 0..20:
        w.tick+=120; w.minute=w.tick/120
        far_commissions_minute(w); far_people_minute(w)
    assert(w.far.commissions[id].phase==.delivered)
    assert(w.accounts[w.people[0].account].cents==cash+c.reward-60)
    # Named meals are real consumption; no roots are minted for the commission itself.
    assert(w.next_cargo_source==roots and money_balances(w) and goods_balance(w))
    assert(far_stock_errors(w).len()==0 and validate_far(w)=="")

test "the actual player mooring adopts a sparse place without indexing the dense harbor array":
    w=commission_fixture()
    w.aircraft[0].place= -1; w.aircraft[0].dock= -1
    w.people[0].place= -1
    w.aircraft[0].pose.pos=vec3(100,0,0); w.aircraft[0].state=.moored
    scene_player_sparse_location(w)
    assert(person_place(w,0)==100 and w.people[0].far_visit==100)
    assert(w.aircraft[0].place== -1 and w.aircraft[0].dock== -1)
    before=canonical_text(w); scene_player_sparse_location(w)
    assert(canonical_text(w)==before)
    w.aircraft[0].state=.airborne; scene_player_sparse_location(w)
    assert(person_place(w,0)== -1 and not (0 in w.far.air_berths))
    assert(validate_save_world(w)=="")

test "an expired consignment retries its funded resale after the local buyer recovers cash":
    w=commission_fixture(); id=post_far_commission(w,100,200,3,1000)
    source=w.far.districts[100].market_account
    receiver=w.far.districts[200].market_account
    cash=w.accounts[source].cents; assert(transfer(w,source,receiver,cash,.trade))
    w.far.commissions[id].deadline=1; w.minute=2; w.tick=240
    far_commissions_minute(w)
    assert(w.far.commissions[id].phase==.open and w.far.commissions[id].failed_minute==2)
    assert(w.far.commissions[id].cargo.qty[3]==1000)
    assert(transfer(w,receiver,source,1000,.trade))
    w.minute=3; w.tick=360; far_commissions_minute(w)
    assert(w.far.commissions[id].phase==.expired and w.far.commissions[id].cargo.qty[3]==0)
    assert(money_balances(w) and goods_balance(w) and far_stock_errors(w).len()==0)

test "inland consignments can be walked to and from an actual neighboring harbor without changing their endpoints":
    w=commission_fixture(); stock=stock_totals(w); roots=w.next_cargo_source
    id=post_far_commission(w,300,100,5,1000)
    assert(id>=0 and not (300 in w.far.harbors))
    w.people[0].pose.pos=far_counter(w,300)
    assert(claim_far_commission(w,id) and pickup_far_commission(w,id))
    w.aircraft[0].pose.pos=vec3(200,0,0); w.aircraft[0].state=.moored
    assert(not load_far_commission(w,id)) # still at the inland counter, not beside the aircraft
    w.people[0].pose.pos=w.aircraft[0].pose.pos
    assert(load_far_commission(w,id) and w.far.commissions[id].origin==300)
    w.aircraft[0].pose.pos=vec3(100,0,0); w.people[0].pose.pos=w.aircraft[0].pose.pos
    assert(pickup_far_commission(w,id) and collect_far_commission(w,id))
    back=post_far_commission(w,100,300,3,1000); assert(back>=0)
    w.people[0].pose.pos=far_counter(w,100)
    assert(claim_far_commission(w,back) and pickup_far_commission(w,back) and load_far_commission(w,back))
    w.aircraft[0].pose.pos=vec3(200,0,0); w.people[0].pose.pos=w.aircraft[0].pose.pos
    assert(pickup_far_commission(w,back) and not collect_far_commission(w,back))
    w.people[0].pose.pos=far_counter(w,300)
    assert(collect_far_commission(w,back) and w.far.commissions[back].destination==300)
    assert(stock_totals(w)==stock and w.next_cargo_source==roots and money_balances(w) and goods_balance(w))

test "a player cannot take a parcel out of a handling leg already assigned to a named collector":
    w=commission_fixture(); id=post_far_commission(w,100,200,3,1000)
    w.people[0].pose.pos=far_counter(w,100); w.aircraft[0].pose.pos=vec3(100,0,0)
    assert(claim_far_commission(w,id,0,.automatic) and pickup_far_commission(w,id) and load_far_commission(w,id))
    w.aircraft[0].pose.pos=vec3(200,0,0); w.people[0].pose.pos=w.aircraft[0].pose.pos
    commission_portage(w,id)
    assert(w.far.commissions[id].porter>=0 and w.far.commissions[id].phase==.aboard)
    before=canonical_text(w)
    assert(not pickup_far_commission(w,id) and canonical_text(w)==before)
