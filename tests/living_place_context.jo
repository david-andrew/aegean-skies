use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_place_context.jo'
use '../src/living_save.jo'

test "sparse place context preserves countries venues and canonical saves without seeding stock":
    w = build_world(); before = w.goods_ledger; cash = w.ledger
    id = 1900000000
    contexts = [LifePlaceContext(0,"Porto",0,-1,vec3(0,0,0),true,0,neighbors=[id]),LifePlaceContext(id,"Kalyra's hill",1,1,vec3(50000,3,2000),neighbors=[0],venues=[LifeVenue(id,"hill:square",.square,vec3(50000,3,2000))])]
    assert(publish_place_contexts(w,1,contexts,[-1,id,-1]))
    assert(w.countries[1].key == "kalyra" and w.countries[2].key == "orenthia")
    assert(life_place_name(w,id) == "Kalyra's hill" and not w.place_contexts[id].aviation)
    assert(w.place_contexts[id].venues[0].place == id and w.countries[1].capital_id == id)
    assert(w.people.len() == 26 and w.places.len() == 6 and before == w.goods_ledger and cash == w.ledger)
    text = canonical_text(w)
    contexts.reverse(); assert(publish_place_contexts(w,1,contexts,[-1,id,-1]))
    assert(text == canonical_text(w))
    restored = from_text[World](text); assert(restored is World and validate_save_world(restored) == "")
    assert(route_pair(0,id) != route_pair(id,0))

test "catalog rejects unknown neighbors duplicate IDs and country capitals atomically":
    w = build_world(); before = canonical_text(w)
    assert(not publish_place_contexts(w,1,[LifePlaceContext(300,"Bad",1,1,vec3(0,0,0),neighbors=[900])],[-1,300,-1]))
    assert(canonical_text(w) == before)
    assert(not publish_place_contexts(w,1,[LifePlaceContext(300,"Bad",1,1,vec3(0,0,0))],[-1,-1,300]))
    assert(canonical_text(w) == before)
