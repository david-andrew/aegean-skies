use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_orders.jo'
use '../src/living_far_stock.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use 'living_far_economy.jo'

test "new distant need changes no cargo choice until its counter order actually travels back":
    w=far_fixture(); actual=w.far.vehicles[0].buying_order!
    w.far.districts[200].target[3]+=20000
    # This newly raised need was not part of the opening signed mandate.
    assert(actual.quantity[3]==0 and far_depart(w,0))
    j=w.far.journeys[w.far.vehicles[0].journey]
    assert(j.survey and j.good== -1 and j.quantity==0 and j.provenance.goods_cents==0)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.order_rounds==1 and w.far.cargo_deliveries==0)
    w.tick+=3600; w.minute=w.tick/120; assert(far_depart(w,0))
    returning=w.far.journeys[w.far.vehicles[0].journey]
    assert(returning.return_order!.place==200 and returning.return_order!.quantity[3]>0)
    assert(w.far.vehicles[0].buying_order!.place==100)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    received=w.far.vehicles[0].buying_order!
    assert(received.place==200 and received.minute==returning.departed_tick/120)
    # A later remote target revision cannot silently rewrite the mandate in this carrier.
    w.far.districts[200].target[3]+=30000
    w.tick+=172800; w.minute=w.tick/120
    assert(far_depart(w,0))
    load=w.far.journeys[w.far.vehicles[0].journey]
    assert(not load.survey and load.good==3 and load.quantity<=received.quantity[3])
    assert(load.provenance.negotiated and load.provenance.requested_minute==received.minute)
    assert(load.provenance.supply_roots.len()>0 and load.provenance.goods_cents>0)
    assert(money_balances(w) and goods_balance(w))
    text=canonical_text(w); parsed=from_text[World](text)
    assert(parsed is World and canonical_text(parsed)==text)

test "a carried buyer price ceiling is binding even if today's distant price would be profitable":
    w=far_fixture(); w.far.districts[200].target[3]+=20000
    order=counter_restock_order(w,0,200); order.price[3]=1
    w.far.vehicles[0].buying_order=order
    w.far.districts[200].prices[3]=100000
    before=stock_totals(w)
    assert(far_depart(w,0))
    j=w.far.journeys[w.far.vehicles[0].journey]
    assert(j.survey and j.quantity==0 and stock_totals(w)==before)
    # The only money received by this run is the real local counter's signed service fee.
    assert(j.provenance.freight_payer==w.far.districts[100].market_account and w.far.vehicles[0].freight_earned==40)

test "old distant-service saves require an explicit agreement migration and cannot silently gain remote knowledge":
    w=far_fixture(); w.far.procurement_version=0
    assert(validate_save_world(w)=="old distant service agreements require explicit migration; saved data retained")
