import '../src/combat.jo' as combat
use '../src/combat.jo'
use '../src/flight.jo'
use '../src/planes.jo'
use '../src/tweaks.jo'

scale_battle = () -> Battle:
    b=Battle(enabled=true);k=craft_spec(.gull,build_craft(.gull,LIVERIES[0]).contacts)
    loop i in 0..128:
        pos=vec3((i%16)*120,400,(i/16)*150)
        b.actors.push(Combatant(i,i,if i<64:0 else:1,k,CraftState(position=pos,fuel=k.fuel_capacity),previous=pos))
    loop i in 0..256:
        target=i%128;owner=(target+64)%128
        p=b.actors[target].state.position
        b.rounds.push(Round(p+vec3(0,0,20),vec3(0,0,-2400),owner,b.actors[owner].side,0.025,serial=i))
    b

test "128 craft swept grid preserves all hits and cuts broad pair work":
    b=scale_battle();a=b
    combat.step_combat_rounds(a,FlightEnv(),false);combat.step_combat_rounds(b,FlightEnv())
    print("128 craft: brute pairs={a.pair_tests}, indexed pairs={b.pair_tests}, narrow={b.narrow_tests}")
    assert(a.actors==b.actors and a.rounds==b.rounds and a.events==b.events and a.sweeps==b.sweeps)
    assert(b.events.len()>100 and b.pair_tests<a.pair_tests/4)

test "spatial index handles cell edges long rounds and very long body sweeps":
    b=scale_battle()
    b.actors[4].previous.x-=20000
    b.rounds.push(Round(vec3(-10000,400,0),vec3(1200000,0,0),127,1,0.02,serial=300))
    a=b;combat.step_combat_rounds(a,FlightEnv(),false);combat.step_combat_rounds(b,FlightEnv())
    assert(a.actors==b.actors and a.rounds==b.rounds and a.events==b.events and a.sweeps==b.sweeps)

test "player and NPC fighters obey identical energy lift and control equations in both settings":
    set_speed_scale(3.3)
    player=craft_spec(.gull,[]);player.player=true;npc=player;npc.player=false;npc.combat_flight=true
    loop enabled in [false,true]:
        set_tweaks(Tweaks(skybarons_response=enabled))
        a=CraftState(position=vec3(0,600,0),velocity=vec3(0,0,-190),fuel=player.fuel_capacity,throttle=0.8,water_age=1);b=a
        loop i in 0..900:
            c=Controls(assist=0,throttle=0.85,pitch=0.45+0.25*sin(f64(i)*0.03),roll=0.6*cos(f64(i)*0.02),yaw=0.1)
            step(player,a,c,FlightEnv(),1.0/60.0);step(npc,b,c,FlightEnv(),1.0/60.0)
            assert(a==b)
    set_speed_scale(1);set_tweaks(Tweaks())
