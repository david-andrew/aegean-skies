use '../src/lake_data.jo'
use '../src/lake_field.jo'
use '../src/water_field.jo'

test "terrain basins share flat water and a deep unobstructed takeoff lane":
    assert(SETTLEMENT_LAKES.len()>=2)
    ids:int[]
    loop lake in SETTLEMENT_LAKES:
        assert(lake.id>=100000 and not ids.contains(lake.id));ids.push(lake.id)
        side=vec2(-lake.axis.y,lake.axis.x)
        loop along in -72..73:
            loop across in [-40.0,0.0,40.0]:
                p=lake.center+lake.axis*f32(along*10)+side*f32(across)
                r=water_at(f64(p.x),f64(p.y))
                assert(r.wet and r.kind==.lake and r.id==lake.id,"dry navigation lane {lake.name}")
                assert(r.level==lake.level and r.current==vec3(0,0,0) and r.slope==vec2(0,0))
                assert(lake_carve(f64(p.x),f64(p.y),lake.level+10)<=lake.level-4.9)

test "connected basin footprint and packed terrain contour agree":
    loop lake in SETTLEMENT_LAKES:
        wet=0;dry=0
        loop j in 0..lake.nz-1:
            loop i in 0..lake.nx-1:
                p=lake.origin+vec2(f32(i)+0.37,f32(j)+0.61)*f32(lake.step)
                depth=lake_depth(lake,f64(p.x),f64(p.y));r=lake_at(f64(p.x),f64(p.y))
                assert(r.wet==(depth>0.0))
                if r.wet:
                    wet+=1
                    assert(lake_carve(f64(p.x),f64(p.y),lake.level-depth)<=lake.level)
                else:dry+=1
                # The outer grid is wholly dry: no domain-boundary artificial dam.
                if i==0 or j==0 or i==lake.nx-2 or j==lake.nz-2:assert(not r.wet)
        assert(wet>0 and dry>0)
        p=lake.origin-vec2(100,100)
        assert(not lake_at(f64(p.x),f64(p.y)).found)
        assert(lake_carve(f64(p.x),f64(p.y),100.0)==100.0)
    assert(lake_key()==lake_key() and lake_key()!=u64(0))
