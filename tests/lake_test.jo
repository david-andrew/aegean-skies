use '../src/lake_data.jo'
use '../src/lake_field.jo'
use '../src/water_field.jo'

test "all inland town basins share flat water and a deep 1080 metre takeoff lane":
    assert(SETTLEMENT_LAKES.len()==18)
    ids:int[]
    loop lake in SETTLEMENT_LAKES:
        assert(lake.id>=100000 and not ids.contains(lake.id));ids.push(lake.id)
        side=vec2(-lake.axis.y,lake.axis.x)
        loop along in -54..55:
            loop across in [-40.0,0.0,40.0]:
                p=lake.center+lake.axis*f32(along*10)+side*f32(across)
                r=water_at(f64(p.x),f64(p.y))
                assert(r.wet and r.kind==.lake and r.id==lake.id)
                assert(r.level==lake.level and r.current==vec3(0,0,0) and r.slope==vec2(0,0))
                assert(lake_carve(f64(p.x),f64(p.y),lake.level+10)<=lake.level-4.9)
        loop along in -72..73:
            loop across in [-40.0,0.0,40.0]:
                p=lake.center+lake.axis*f32(along*10)+side*f32(across)
                r=water_at(f64(p.x),f64(p.y))
                assert(r.wet and r.id==lake.id)
                assert(lake.level-lake_carve(f64(p.x),f64(p.y),lake.level+10)>2.0)

test "lake coverage and carved shores agree without discontinuities or distant changes":
    loop lake in SETTLEMENT_LAKES:
        loop angle in 0..48:
            direction=vec2(cos(f64(angle)*TAU/48.0),sin(f64(angle)*TAU/48.0))
            previous=lake.level-5.0
            loop k in 0..130:
                p=lake.center+vec2(lake.axis.x*direction.x*f32(lake.half_length)-lake.axis.y*direction.y*f32(lake.half_width),lake.axis.y*direction.x*f32(lake.half_length)+lake.axis.x*direction.y*f32(lake.half_width))*f32(k)*0.01
                r=lake_at(f64(p.x),f64(p.y));h=lake_carve(f64(p.x),f64(p.y),lake.level+4.0)
                assert(abs(h-previous)<0.8,"shore step at {lake.name}")
                if r.wet:assert(h<=lake.level)
                else:assert(h>=lake.level-0.001)
                previous=h
        assert(not lake_at(f64(lake.center.x)+2000,f64(lake.center.y)).found)
        assert(lake_carve(f64(lake.center.x)+2000,f64(lake.center.y),100)==100)
    assert(lake_key()==lake_key() and lake_key()!=u64(0))
