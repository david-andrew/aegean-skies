# Thunderstorms from inside: rough air through the flight model, and the
# lightning schedule shared by the bolts, the cloud's flash and the thunder.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 sloppy test tests/storm_test.jo
import '../src/flight.jo' as fl
import '../src/planes.jo' as planes
import '../src/lightning.jo' as lg
import '../src/living_types.jo' as lt
use '../src/weather_scene.jo'
use '../src/world_point.jo'
use '../src/pilot.jo'
use '../src/living_conditions.jo'
use '../src/cloud_field.jo'

_spec = (kind: planes.Craft) -> fl.CraftSpec:
    model = planes.build_craft(kind, planes.LIVERIES[0])
    fl.craft_spec(kind, model.contacts)
_kinds = [planes.Craft.gull, planes.Craft.heron, planes.Craft.corsair, planes.Craft.falco]

_storm = () -> lt.Weather:
    lt.Weather(id=991,kind=.storm,center=vec2(0,0),radius_m=9000,aspect=vec2(1,1),severity=950,wind_milli_m_per_sec=vec2(0,0),born_minute=-100,expires_minute=10000)

_bank = (s: fl.CraftState) -> f64:
    right = quat_rotate(s.orientation, vec3(1, 0, 0))
    f64(asin(clamp(right.y, -1.0, 1.0)))

# The thunderstorm fixture's system (AEGEAN_WEATHER=storm) round the origin, its air as
# the game gives it to the flight model: the cell's wind and gusts, the deck's rough air,
# and the cloud bodies drawn round the aircraft (refreshed as it flies), through the
# player's flight_env, with the player's speed scale.
_storm_air = ():
    global weather_cells, weather_active, weather_minute_now
    weather_cells = [lt.Weather(id=991,kind=.storm,center=vec2(0,0),radius_m=13000,aspect=vec2(1,1),severity=950,wind_milli_m_per_sec=vec2(7000,9000),born_minute=-100,expires_minute=10000)]
    weather_active = true
    weather_minute_now = 0.0

struct StormRun:
    trouble = 999.0                # when it first got into trouble: nose 25 degrees down, banked past 60, or under 100 m
    lowest = 0.0
    crashed = false
    jolt = 0.0                     # the largest change of vertical speed in a step, m/s^2
    swing = 0.0                    # the airspeed's range after the first five seconds, true m/s
    draught = 0.0                  # the strongest vertical air met, drawn m/s
    heading20 = 0.0                # the largest turn off the start's heading in the first 20 s, degrees
    bank20 = 0.0                   # the largest bank in the first 20 s, degrees
    climb20 = 0.0                  # the largest height gained or lost in the first 20 s, m

# A minute and a half from `start` in the storm, at `true_speed` through the air:
# hands off, or with a pilot holding the heading and the height.
_storm_run = (kind: planes.Craft, start: vec3, heading: f64, true_speed: f64, clock: f64, correcting: bool, seconds: int = 90, mouse: bool = false) -> StormRun:
    global weather_seconds
    _storm_air()
    k = _spec(kind)
    k.player = true
    scale = max(k.handling_scale, 1.0)
    dir = vec3(f32(sin(heading)), 0, f32(-cos(heading)))
    weather_seconds = clock
    cloud_weather_bodies(world_clouds(start, vec2(0, 0)), start)
    s = fl.CraftState(position = start, velocity = dir * f32(true_speed * scale) + flight_env(0.0, start).wind, orientation = quat_euler(0, -heading, 0), fuel = k.fuel_capacity, water_age = 1.0, throttle = 0.85, time = clock)
    out = StormRun(lowest = f64(start.y))
    lo = 1e9; hi = 0.0
    aim_h = heading; aim_c = 0.0
    loop i in 0..seconds * 60:
        t = f64(i) / 60.0
        weather_seconds = clock + t
        if i % 30 == 0: cloud_weather_bodies(world_clouds(s.position, vec2(0, 0)), s.position)
        e = flight_env(t, s.position)
        e.ground = (x: f64, z: f64) -> f64: -60.0          # (open sea under it: no island in the way)
        c = fl.Controls(throttle = 0.85)
        if correcting:
            c = fl.steer(k, s, dir * 400.0 + vec3(0, clamp(start.y - s.position.y, -120.0, 120.0), 0))
            c.throttle = 1.0
        else if mouse:
            # (the game's hands off with the mouse steering: its aim turned by the storm with the nose)
            aim_h += f64(s.gust_turn.x); aim_c = clamp(aim_c + f64(s.gust_turn.y), -1.5, 1.5)
            c = fl.steer(k, s, vec3(f32(sin(aim_h) * cos(aim_c)), f32(sin(aim_c)), f32(-cos(aim_h) * cos(aim_c))))
            c.throttle = 0.85
        before = s.velocity.y
        fl.step(k, s, c, e, 1.0 / 60.0)
        out.jolt = max(out.jolt, abs(f64(s.velocity.y - before)) * 60.0)
        out.draught = max(out.draught, abs(f64(e.wind.y)))
        out.lowest = min(out.lowest, f64(s.position.y))
        if i > 300: lo = min(lo, s.airspeed / scale); hi = max(hi, s.airspeed / scale)
        nose = quat_rotate(s.orientation, vec3(0, 0, -1))
        if i < 1200:
            flat = normalize(vec2(nose.x, nose.z))
            out.heading20 = max(out.heading20, f64(acos(clamp(dot(flat, vec2(dir.x, dir.z)), -1.0, 1.0))) * 57.3)
            out.bank20 = max(out.bank20, abs(_bank(s)) * 57.3)
            out.climb20 = max(out.climb20, abs(f64(s.position.y - start.y)))
        if out.trouble > 900.0 and (nose.y < -0.42 or abs(_bank(s)) > 1.05 or s.position.y < 100.0): out.trouble = t
        if s.crashed or s.position.y < 3.0:
            out.crashed = true
            break
    out.swing = hi - lo
    out

test "a thunderstorm's air knocks every aircraft about: left alone it wanders off over tens of seconds, a pilot gets through":
    loop kind in _kinds:
        k = _spec(kind)
        hands: f64[] = []
        loop n in 0..8:
            # (under the system's largest cell, rough throughout, slow and at cruise, on every heading)
            start = vec3(-4232.0 + f32((n % 4) * 900 - 1350), 500.0, -2463.0 + f32((n / 4) * 1800 - 900))
            speed = k.stall_speed * (if n % 2 == 0: 1.3 else: 2.2)
            off = _storm_run(kind, start, f64(n) * 0.8, speed, 1000.0 + f64(n) * 137.0, false)
            on = _storm_run(kind, start, f64(n) * 0.8, speed, 1000.0 + f64(n) * 137.0, true)
            hands.push(off.trouble)
            if n < 2: print("{kind} {n}: hands off in trouble at {off.trouble:.1}s, lowest {off.lowest:.0}m; flown: lowest {on.lowest:.0}m jolt {on.jolt:.1}m/s2 swing {on.swing:.1}m/s draught {on.draught:.0}m/s")
            assert(off.trouble > 5.0)                     # never thrown out of control at once (in 7 s at the soonest)
            assert(not off.crashed or off.trouble > 5.0)
            assert(not on.crashed and on.trouble > 900.0)  # a pilot correcting gets through
            assert(on.lowest > 300.0)
            assert(on.jolt > 6.0 and on.jolt < 60.0)       # hard jolts, half a g to six
            assert(on.swing > 3.0)                         # the airspeed swings
            assert(on.draught > 8.0)                       # strong up and down draughts
        hands.sort()
        print("{kind}: hands off, trouble after {hands[0]:.1}s at the soonest, {hands[4]:.1}s the median")
        assert(hands[4] < 60.0)                           # left alone, it does wander off

test "rough air is felt inside cloud bodies, violent in a storm's, and nowhere in clear air":
    weather_active = true
    weather_cells = []
    weather_bodies = [WeatherBody(WorldPoint(0,3000,0),vec3(4000,3500,4000),vec2(1,0),1.0),WeatherBody(WorldPoint(20000,1200,0),vec3(800,400,800),vec2(1,0),0.12)]
    assert(weather_turbulence(vec3(0,3000,0)) > 0.9)
    assert(weather_turbulence(vec3(20000,1100,0)) > 0.08 and weather_turbulence(vec3(20000,1100,0)) < 0.2)
    assert(weather_turbulence(vec3(10000,1500,0)) == 0.0)
    assert(length(weather_turbulent_gust(vec3(5,1500,9),0.0)) == 0.0)
    weather_active = false

test "lightning strikes are fixed by the storm and the clock, and each is heard after its distance":
    cell = _storm()
    found = lg.lightning_strikes_between([cell], 0.0, 300.0)
    print("strikes in 300 s: {found.len()}")
    assert(found.len() > 30 and found.len() < 60)            # one every five to ten seconds
    ground = 0
    loop s in found:
        if s.ground: ground += 1
        # (the same strike is alight from its first stroke for its life, and dark after)
        assert(lg.lightning_strike_at(cell, s.time + 0.01).key == s.key)
        assert(lg.lightning_brightness(s, 0.0) > 0.9 and lg.lightning_brightness(s, lg.LIGHTNING_LIFE) == 0.0)
        assert(length(vec2(f32(s.center.x), f32(s.center.z))) < 9000.0)   # (under the system's cells)
    assert(ground > 8 and ground < found.len() - 8)
    # Split windows find exactly the same strikes.
    a = lg.lightning_strikes_between([cell], 0.0, 137.3)
    b = lg.lightning_strikes_between([cell], 137.3, 300.0)
    assert(a.len() + b.len() == found.len())

test "a cloud to ground bolt runs from inside the cloud to the sea with branches; an in-cloud one stays under the base":
    cell = _storm()
    found = lg.lightning_strikes_between([cell], 0.0, 300.0)
    seen_ground = false; seen_cloud = false
    loop s in found:
        segs = lg.lightning_bolt(s, 800.0)
        lowest = 1e9; highest = -1e9
        loop g in segs: lowest = min(lowest, f64(min(g.a.y, g.b.y))); highest = max(highest, f64(max(g.a.y, g.b.y)))
        if s.ground:
            seen_ground = true
            assert(lowest <= 0.0 and highest >= 1100.0 and segs.len() > 40)
        else:
            seen_cloud = true
            assert(highest <= 870.0 and lowest > 0.0 and segs.len() > 30)
    assert(seen_ground and seen_cloud)

test "the pilot's head is knocked about by storm jolts, springs back, and stays within ten centimetres and six degrees":
    k = _spec(planes.Craft.gull)
    loop rough in [0.0, 1.0]:
        f = Flyer(planes.Craft.gull, 0, k, fl.CraftState(position = vec3(0, 1500, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, water_age = 1.0, throttle = 0.75))
        e = fl.FlightEnv(); e.turbulence = rough
        most = 0.0; turn = 0.0; snap = 0.0; last = vec3(0, 0, 0)
        loop i in 0..1800:
            e.wind = weather_turbulent_gust(f.state.position, f32(rough))
            fl.step(k, f.state, fl.Controls(throttle = 0.75), e, 1.0 / 60.0)
            head_step(f, rough, 1.0 / 60.0)
            most = max(most, f64(length(f.head_pos))); turn = max(turn, f64(length(f.head_rot)))
            assert(abs(f.head_pos.x) <= 0.1 and abs(f.head_pos.y) <= 0.1 and abs(f.head_rot.z) <= 0.105)
            # (no single-frame snap: the whole turn, buzz and all, moves no more a frame than a
            # smooth two-degree wobble at 15 Hz does, about three and a half degrees)
            shook = head_shake(f, f64(i) / 60.0).1
            if i > 0: snap = max(snap, f64(length(shook - last)))
            last = shook
        print("rough {rough}: head up to {most * 100.0:.1} cm, {turn * 57.3:.2} deg, at most {snap * 57.3:.2} deg a frame")
        assert(snap < 0.061)
        if rough == 0.0: assert(most < 0.004 and turn < 0.004)
        else: assert(most > 0.03 and turn > 0.04)

test "a thunderstorm in sight is told with its distance and whether it comes on or moves off":
    cell = _storm()
    cell.radius_m = 13000; cell.center = vec2(0,-30000); cell.velocity_milli_m_per_minute = vec2(0,120000)
    near = storm_sighting([cell], 0.0, vec3(0,0,0))
    assert(near.seen and abs(near.km - 17.0) < 0.5 and near.approaching and near.bearing.z < 0.0)
    cell.velocity_milli_m_per_minute = vec2(0,-120000)
    assert(not storm_sighting([cell], 0.0, vec3(0,0,0)).approaching)
    assert(not storm_sighting([cell], 0.0, vec3(0,0,80000)).seen)       # (beyond 60 km of its edge)
    cell.expires_minute = 0
    assert(not storm_sighting([cell], 1.0, vec3(0,0,0)).seen)

# Every type, the racers above all: the storm's air turns it off its heading and banks
# it within seconds hands off, and a pilot watching the instruments gets it through.
_every_kind = () -> planes.Craft[]: [loop i in 0..int(planes.Craft.donnet_leveque)+1: planes.Craft(i)]

test "a thunderstorm throws every type off its heading and attitude hands off, and a correcting pilot gets each through":
    loop kind in _every_kind():
        k = _spec(kind)
        loop n in 0..2:
            # (under the largest cell at 500 m, and under the deck between the cells at 300 m)
            start = if n == 0: vec3(-4232, 500, -2463) else: vec3(0, 300, 9000)
            speed = k.stall_speed * 2.0
            keys = _storm_run(kind, start, 0.7 + f64(n) * 2.1, speed, 1300.0 + f64(n) * 211.0, false, 20)
            mouse = _storm_run(kind, start, 0.7 + f64(n) * 2.1, speed, 1300.0 + f64(n) * 211.0, false, 20, true)
            on = _storm_run(kind, start, 0.7 + f64(n) * 2.1, speed, 1300.0 + f64(n) * 211.0, true, 60)
            if n == 0: print("{kind}: in 20 s hands off banked {keys.bank20:.0} deg turned {keys.heading20:.0}; on the mouse turned {mouse.heading20:.0} deg, {mouse.climb20:.0} m up or down; flown lowest {on.lowest:.0} m")
            # (hands off on the keys: banked and off its heading within 20 s)
            assert(keys.bank20 > 18.0 and keys.heading20 > 12.0)
            # (hands off with the mouse steering: held level, but turned off its course and carried
            # up or down by the draughts; the pilot must bring the aim back)
            assert(mouse.heading20 > 12.0 and mouse.climb20 > 40.0)
            # (a pilot watching the instruments and correcting gets every type through)
            assert(not on.crashed and on.trouble > 900.0 and on.lowest > f64(start.y) - 100.0)
