# The Hotel Ancora's bar room (src/bar_room.jo): when it is open, where the hotel's places move to,
# that the room's furniture fits inside its walls, and that whoever the world has at the terrace's
# tables, bar or stand is found at the same place in the room.
use '../src/bar_scene.jo'
use '../src/bar_room.jo'
use '../src/live_source.jo'

# the terrace's places as build_hotel makes them (the hotel's frame), in a frame turned and moved
F = translation(vec3(120, 0, -60)) * rotation_y(0.7)
_built = () -> HotelSpots:
    w = (p: vec3) -> vec3: transform_point(F, p)
    HotelSpots(w(TERRACE_PLAYER_TABLE + vec3(0.85, f32(DECK), 0)), w(TERRACE_PLAYER_TABLE + vec3(0, f32(DECK + TABLE_TOP), 0)), w(vec3(-12.5, f32(DECK + 0.3), 27.8)), w(vec3(0, f32(DECK), 21.0)), w(vec3(4.85, f32(DECK), 20.8)), w(TERRACE_PLAYER_TABLE + vec3(-0.15, f32(DECK), -0.85)), w(vec3(-1.1, f32(DECK), 19.05)), w(vec3(-2.4, f32(DECK), 19.0)), [loop x in BAR_STOOLS_X: w(vec3(f32(x), f32(DECK), 20.85))])

_in_room = (p: vec3) -> bool: inside_box(transform_point(inverse(F), p), ROOM_LO, ROOM_HI)

test "the room opens of an evening and in the rain, and once in, stays in until the rain has all but stopped":
    assert(room_level(14.0, 0.0, 0.0, 0) == 0)
    assert(room_level(19.0, 0.0, 0.0, 0) == 1 and room_level(1.5, 0.0, 0.0, 1) == 1)
    assert(room_level(14.0, 0.3, 0.0, 0) == 2 and room_level(21.0, 0.0, 0.3, 1) == 2)
    assert(room_level(14.0, 0.1, 0.0, 0) == 0 and room_level(14.0, 0.1, 0.0, 2) == 2)
    assert(room_level(14.0, 0.03, 0.0, 2) == 0)

test "the places move in: the bar of an evening, everything in the rain; as built otherwise":
    b = _built()
    t = room_spots(b, F, 0)
    assert(to_text(t) == to_text(b))
    e = room_spots(b, F, 1)
    loop s in e.stools: assert(_in_room(s))
    assert(_in_room(e.counter) and _in_room(e.bar_back) and _in_room(e.bar_rest))
    assert(not _in_room(e.seat) and not _in_room(e.stage) and e.waiter_pass == b.waiter_pass)
    r = room_spots(b, F, 2)
    loop p in [r.seat, r.table, r.stage, r.waiter_pass, r.waiter_serve, r.counter]: assert(_in_room(p), "{transform_point(inverse(F), p)}")

test "the room's furniture is inside its walls and clear of the stand, the arch and the bar":
    # (each table with its chairs, a body's width round it)
    loop c in ROOM_TABLES + [ROOM_PLAYER_TABLE]:
        assert(f64(abs(c.x)) + 0.85 + 0.45 < 10.7 and f64(c.z) - 1.25 - 0.4 > 6.3 and f64(c.z) + 1.25 + 0.4 < 17.7, "{c}")
        # (not on the stand, x -10.5..-6.3, z 9.2..14.8; not under the arch's piers; not at the bar)
        assert(f64(c.x) - 0.85 - 0.3 > -6.3 + 0.0 or f64(c.z) + 1.25 < 9.2 or f64(c.z) - 1.25 > 14.8)
        assert(abs(f64(c.x) - f64(ROOM_ARCH_X)) > 1.2 or (f64(c.z) - 1.25 > 7.6 and f64(c.z) + 1.25 < 16.4))
        assert(f64(c.z) - 1.25 > 9.3 or f64(c.x) + 0.85 < 2.0)
    # (tables apart)
    all = ROOM_TABLES + [ROOM_PLAYER_TABLE]
    loop i in 0..all.len():
        loop j in i + 1..all.len():
            d = all[i] - all[j]
            assert(f64(abs(d.x)) > 2.1 or f64(abs(d.z)) > 2.9, "{all[i]} {all[j]}")

test "whoever sits at a terrace table, stands at its bar or by its stand is found at the same place inside; walkers aren't":
    loop k in 0..4:
        s = room_shift_of(TERRACE_TABLES[k] + vec3(0.85, 1.2, 0))!
        assert(f64(length(TERRACE_TABLES[k] + s - ROOM_TABLES[k])) < 0.001)
    assert(room_shift_of(vec3(0, 1.2, 19.1))! == ROOM_BAR_SHIFT)
    assert(room_shift_of(vec3(-10.05, 1.2, 27.8))! == ROOM_STAGE_SHIFT)
    assert(room_shift_of(vec3(11.5, 1.2, 22.0)) == none)
