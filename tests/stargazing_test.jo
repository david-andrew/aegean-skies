# Stargazing: the stars stand on the same celestial sphere as the game's sun and moon (its pole 20
# degrees up toward the north, the sun at 6h on the equator), turn with the clock, show only at
# night, and their names show as one looks at them.
use '../src/celestial.jo'
use '../src/stargazing.jo'

_close = (a: vec3, b: vec3, within: f64) -> bool: f64(length(a - b)) < within

test "a star on the sun's place stands where the game's sun does, all day round":
    loop k in 0..24:
        hour = f64(k)
        assert(_close(sky_star(SUN_RA, 0.0, hour), sky_sun(hour), 0.001), "hour {hour}")

test "the pole star stays at the celestial pole while the others turn round it":
    pole = vec3(0, 0.34202014, 0.93969262)
    loop k in 0..12:
        assert(_close(sky_star(2.53, 89.26, f64(k) * 2.0), pole, 0.02))
    vega_eve = sky_star(18.616, 38.78, 21.0)
    vega_late = sky_star(18.616, 38.78, 3.0)
    assert(not _close(vega_eve, vega_late, 0.3))
    # (and keeps its distance from the pole as it goes)
    assert(abs(f64(dot(vega_eve, pole)) - f64(dot(vega_late, pole))) < 0.001)

test "summer evening: the Lyre high overhead, the Scorpion lower in the south (the game's pole is 20 degrees up)":
    vega = sky_star(18.616, 38.78, 22.0)
    antares = sky_star(16.49, -26.43, 22.0)
    assert(vega.y > 0.75, "{vega}")
    assert(antares.y > 0.0 and antares.y < 0.75 and antares.y < vega.y and antares.z < 0.0, "{antares}")

test "stars by night only":
    assert(star_night(12.0) == 0.0)
    assert(star_night(0.0) == 1.0 and star_night(23.0) == 1.0)

test "a name shows as one looks at it, and not when one looks away":
    look = sky_star(18.616, 38.78, 22.0)
    assert(name_alpha(look, look, false) == 1.0)
    away = normalize(look + vec3(0.6, 0, 0))
    assert(name_alpha(away, look, false) == 0.0)
    # (a constellation's name over its wider middle shows from further off than a star's)
    near = normalize(look + vec3(0.25, 0, 0))
    assert(name_alpha(near, look, true) > name_alpha(near, look, false))

test "the view drifts slowly round the sky, and does not tip past the zenith or under the horizon":
    g = Gaze(active = true)
    y0 = g.yaw
    loop k in 0..600: gaze_step(g, 0.05, 0.0, 0.0)
    assert(g.yaw > y0 and g.yaw - y0 < 0.5)
    loop k in 0..200: gaze_step(g, 0.05, 0.0, 1.0)
    assert(g.pitch <= 1.5)
    loop k in 0..400: gaze_step(g, 0.05, 0.0, -1.0)
    assert(g.pitch >= 0.35 and gaze_dir(g).y > 0.3)

test "every name in Greek and in English, the brighter stars brighter":
    loop s in SKY_NAMES:
        assert(s.greek != "" and s.english != "")
        assert(s.dec >= -90.0 and s.dec <= 90.0 and s.ra >= 0.0 and s.ra < 24.0)
    assert(star_size(-1.46) > star_size(2.0) and star_light(-1.46) >= star_light(2.0))
