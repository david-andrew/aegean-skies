# The Greek naval types (src/greek_planes.jo): each builds, rests on its floats at its float height,
# takes off by the production autopilot, climbs, turns, flies straight and level on both flight
# models at its historical top speed, lands, and runs the same twice.
import '../src/planes.jo' as planes
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/living_types.jo' as living
import '../src/aircraft_picker.jo' as picker

_greek = [planes.Craft.blackburn_velos, planes.Craft.fairey_iiif]

_finite = (s: fl.CraftState):
    assert(abs(f64(s.position.x)) < 1e7 and abs(f64(s.position.y)) < 1e7 and abs(f64(s.position.z)) < 1e7)
    assert(abs(f64(length(s.orientation)) - 1.0) < 0.0001)

_spec = (kind: planes.Craft, player: bool) -> fl.CraftSpec:
    fl.set_speed_scale(if player: 3.3 else: 1.0)
    m = planes.build_craft(kind, planes.LIVERIES[planes.DEFAULT_LIVERIES[int(kind)]])
    k = fl.craft_spec(kind, m.contacts)
    k.player = player
    k

test "the Greek types build with their parts, contacts, crews, identities and picker group":
    loop kind in _greek:
        id = int(kind); p = planes.aircraft_profile(kind)
        m = planes.build_craft(kind, planes.LIVERIES[planes.DEFAULT_LIVERIES[id]])
        k = fl.craft_spec(kind, m.contacts)
        a = living.AIRFRAMES[id]
        assert(str(kind) == str(living.Airframe(id)) and planes.DEFAULT_LIVERIES[id] == living.AIRFRAME_LIVERIES[id])
        assert(a.cruise_mps > 0 and a.price_cents > 0 and a.cargo_grams > 0 and a.seats >= 1 and a.tank_ml / a.burn_ml_sec > 700)
        assert(m.parts.len() == 7 and m.contacts.len() == 6 and m.shade.len() % 2 == 0 and m.prop_hubs.len() == 1 and m.cockpits.len() == 2)
        mass = 0.0; points = 0; vertices = 0
        loop part in m.parts:
            mass += part.spec.mass_share; points += part.spec.contacts.len(); vertices += part.mesh.count
            assert(part.mesh.count > 0 and part.spec.strength > 0)
        assert(abs(mass - 1) < 0.00001 and points == m.contacts.len() and vertices == m.body.count)
        loop c in m.contacts: assert(c in k.parts[planes.contact_part(kind, c)].contacts)
        # (the prop disc clears the floats)
        hub = m.prop_hubs[0]
        loop c in m.contacts: assert(length(vec2(c.x - hub.x, c.y - hub.y)) > m.prop_radius + 0.1 or abs(f64(c.z - hub.z)) > 0.3)
        assert(k.wing_contacts.len() == 4)
        e = picker.craft_entries()[id]
        assert(picker.CRAFT_GROUPS[e.group] == "Greek service" and e.year != "" and e.needs == "")
        print("{planes.CRAFT_NAMES[id]} ({e.year}): {m.body.count / 3} triangles, {k.mass:.0} kg, float height {k.float_height:.2}")

_exercise = (kind: planes.Craft, player: bool):
    k = _spec(kind, player)
    e = fl.FlightEnv()
    s = fl.water_start(k, vec3(0, 0, 0))
    loop i in 0..600: fl.step(k, s, fl.Controls(), e, 1.0 / 30.0)
    print("{kind} player={player} rest y={s.position.y:.3} expected={k.float_height:.3} speed={length(s.velocity):.3}")
    assert(abs(f64(s.position.y) - k.float_height) < 0.12 and length(s.velocity) < 0.1 and not s.crashed)
    s = fl.water_start(k, vec3(0, 0, 0))
    took_off = false; plan = fl.FlightPlan()
    loop i in 0..60 * 120:
        fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
        if not s.on_water and s.position.y > k.float_height + 5:
            took_off = true; break
    print("{kind} player={player} takeoff t={s.time:.2} distance={length(s.position.xz):.1} damage={s.hull_damage:.4}")
    assert(took_off and not s.crashed and s.hull_damage < 0.01)
    before = s.position.y
    loop i in 0..60 * 60:
        fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
        if s.position.y > before + 60: break
    _finite(s)
    assert(s.position.y > before + 15 and not s.crashed)
    s = fl.CraftState(position = vec3(0, 500, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = 0.75)
    loop i in 0..120: fl.step(k, s, fl.Controls(throttle = 0.75, roll = 0.12, yaw = 0.2), e, 1.0 / 60.0)
    print("{kind} player={player} turn heading={fl.heading(s):.3} y={s.position.y:.1}")
    assert(fl.heading(s) > 0.05 and fl.heading(s) < 1.4 and s.position.y > 450 and not s.crashed)
    s = fl.CraftState(position = vec3(0, k.float_height + 3, 0), velocity = vec3(0, -0.6, -k.stall_speed * 1.15 * fl.pure_k(k)),
        orientation = quat_euler(-0.02, 0, 0), fuel = k.fuel_capacity)
    touched = false; rebound = 0.0
    loop i in 0..60 * 150:
        fl.step(k, s, fl.Controls(assist = 0, water_brake = 0.4), e, 1.0 / 60.0)
        if s.on_water: touched = true
        if touched: rebound = max(rebound, f64(s.velocity.y))
    print("{kind} player={player} landing y={s.position.y:.3} speed={length(s.velocity):.3} rebound={rebound:.2} damage={s.hull_damage:.4}")
    _finite(s)
    assert(touched and not s.crashed and s.hull_damage < 0.05 and rebound < 2)
    assert(abs(f64(s.position.y) - k.float_height) < 0.15 and length(s.velocity) < 0.2)
    fl.set_speed_scale(1.0)

test "blackburn velos NPC and player: settle, takeoff, climb, turn, landing":
    _exercise(.blackburn_velos, false); _exercise(.blackburn_velos, true)

test "fairey iiif NPC and player: settle, takeoff, climb, turn, landing":
    _exercise(.fairey_iiif, false); _exercise(.fairey_iiif, true)

_level = (kind: planes.Craft, model: int):
    t = tw.tweaks; t.flight_model = model; tw.set_tweaks(t)
    k = _spec(kind, true)
    e = fl.FlightEnv()
    s = fl.CraftState(position = vec3(0, 600, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = 0.8)
    loop i in 0..60 * 20: fl.step(k, s, fl.Controls(throttle = 0.8), e, 1.0 / 60.0)
    _finite(s)
    print("{kind} model={model} level 20 s: y={s.position.y:.1} heading={fl.heading(s):.3} speed={length(s.velocity):.1}")
    assert(not s.crashed and s.position.y > 450 and s.position.y < 900 and abs(fl.heading(s)) < 0.15)
    t.flight_model = 0; tw.set_tweaks(t)
    fl.set_speed_scale(1.0)

test "they fly straight and level on both flight models and reach their historical top speeds":
    loop kind in _greek:
        _level(kind, 0); _level(kind, 1)
        k = _spec(kind, true); e = fl.FlightEnv()
        s = fl.CraftState(position = vec3(0, 400, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = 1)
        loop i in 0..60 * 60: fl.step(k, s, fl.Controls(throttle = 1), e, 1.0 / 60.0)
        v = f64(length(s.velocity)) / 3.3; p = planes.aircraft_profile(kind)
        print("{kind}: top {v * 3.6:.0} km/h true (historical {p.top * 3.6:.0})")
        assert(abs(v - p.top) < p.top * 0.08)
        fl.set_speed_scale(1.0)

test "the Greek types are deterministic":
    loop kind in _greek:
        runs: vec3[]
        loop r in 0..2:
            k = _spec(kind, true); e = fl.FlightEnv(); s = fl.water_start(k, vec3(0, 0, 0)); plan = fl.FlightPlan()
            loop i in 0..60 * 40: fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
            runs.push(s.position)
        assert(runs[0] == runs[1])
        fl.set_speed_scale(1.0)
