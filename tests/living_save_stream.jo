use 'game_session.jo'
use 'living_far_economy.jo'
use '../src/game_slots.jo'
use '../src/game_session.jo'
use '../src/living_types.jo'
use '../src/living_save.jo'
use '../src/living_save_stream.jo'
use '../src/save_stream.jo'
use '../src/combat.jo'
use '../src/vessel_types.jo'

streamed_text = (w: World, limit: int) -> TextStream:
    s=world_text_stream(w)
    loop not text_step(s,limit): pass
    s

test "the streamed save text is canonical_text exactly, on a living far world":
    w=far_fixture(); w.far.districts[200].target[3]+=20000
    far_only_minutes(w,600)
    reference=canonical_text(w)
    loop limit in [1,4096,10000000]:
        s=streamed_text(w,limit)
        assert(s.error=="",s.error)
        assert(str_from_bytes(s.out)==reference)
        assert(text_stream_hash(s)==hash(reference))

test "the save check in steps reaches the same verdict as validate_save_world":
    w=far_fixture(); far_only_minutes(w,90)
    loop step in 0..save_check_count(): assert(save_check_step(w,step)=="")
    assert(validate_save_world(w)=="")
    w.far.districts[100].workers[0]+=1
    failed=false
    loop step in 0..save_check_count():
        if save_check_step(w,step)!="": failed=true
    assert(failed and validate_save_world(w)!="")

test "a save spread over many short steps loads back as the same world and session":
    f=session_fixture(); p=PresentationState(); p.cat_bonds[7]=CatBond(fondness=321)
    game=capture_game_snapshot(f.0,p,f.1,[],f.2,VesselFleet(),Battle(),123,SaveSummary(minute=0,place=0,place_name="Porto Vecchio",player_name="Pilot",mode="walking"))
    assert(game is SaveGame)
    slots=GameSlots(); init_game_slots(slots)
    loop id in 0..3: assert(delete_game_slot(slots,id) and slots.error=="")
    assert(save_game_slot(slots,0,game,spread=true) and slots.busy and slots.phase=="pack")
    steps=0
    loop slots.phase=="pack":
        step_game_slots(slots,0.0); steps+=1
    assert(slots.error=="" and not slots.busy,slots.error)
    assert(steps>100)
    assert(load_game_slot(slots,0,123) and slots.error=="",slots.error)
    loaded=take_game_slot(slots)
    assert(loaded!=none)
    assert(canonical_text(loaded!.world)==canonical_text(game.world))
    assert(loaded!.session==game.session and loaded!.presentation.cat_bonds[7].fondness==321)

test "a spread save refuses a world that fails its checks and keeps the previous banks":
    f=session_fixture()
    good=capture_game_snapshot(f.0,PresentationState(),f.1,[],f.2,VesselFleet(),Battle(),123,SaveSummary())
    assert(good is SaveGame)
    slots=GameSlots(); init_game_slots(slots)
    loop id in 0..3: assert(delete_game_slot(slots,id) and slots.error=="")
    assert(save_game_slot(slots,0,good) and slots.error=="")
    before=load_data(slot_prefix(0)+"-a-data")!
    bad=good; bad.world.ledger.opening_cents+=1
    assert(save_game_slot(slots,0,bad,spread=true))
    loop slots.phase=="pack": step_game_slots(slots,0.0)
    assert(slots.error!="" and load_data(slot_prefix(0)+"-a-data")==before and load_data(slot_prefix(0)+"-b-data")==none)
