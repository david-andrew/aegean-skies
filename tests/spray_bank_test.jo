use '../src/spray_bank.jo'
use '../src/splash.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/pilot.jo'
use '../src/world_point.jo'
use '../src/sea.jo'
use '../src/look.jo'
use '../src/quality.jo'

# A planing Gull held at a steady run on calm water, stepped at hz for `secs`.
run_bank=(hz:int,secs:f64,run_speed:f64=26.0,wind:f64=4.0)->SprayBank:
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    s=water_start(k,vec3(0,0,0));s.velocity=vec3(0,0,f32(-run_speed*pure_k(k)))
    f=Flyer(.gull,0,k,s,cam_pos=s.position)
    bank=SprayBank();motion=SplashMotion()
    w=Wind(speed=wind)
    loop i in 0..int(secs*f64(hz)):
        t=f64(i)/f64(hz)
        f.state.time=t;f.sea_t=t
        f.state.position=vec3(0,f32(k.float_height-0.05),f32(-run_speed*pure_k(k)*t))
        f.state.precise=world_point(f.state.position);f.state.published=f.state.position;f.state.precise_ready=true
        targets=splash_targets(f,model,craft_transform(f),true)
        step_splash_motion(motion,targets,craft_point(f.state),t)
        step_spray_bank(bank,f,model,[loop sh in motion.sheets:sh],targets,t,w)
    bank

test "a full planing run raises a wall at least a float's length tall behind each float":
    model=build_craft(.gull,LIVERIES[0])
    length=spray_part_length(.gull,model,int(PartId.left_float))
    bank=run_bank(60,3.0)
    assert(bank.puffs.len()>20)
    t=3.0;tallest=0.0;left=false;right=false
    loop p in bank.puffs:
        now=spray_puff_now(p,t)
        top=now.point.y+f64(now.size.y)
        tallest=max(tallest,top)
        if now.point.x< -1.0:left=true
        if now.point.x>1.0:right=true
    # (the crown lobes ride a little above the main lobes' tops)
    assert(tallest>=length*0.8)
    assert(left and right)

test "the bank hangs for two to four seconds after it is thrown, then is gone":
    bank=run_bank(60,3.0)
    loop p in bank.puffs:assert(p.life>=1.8 and p.life<=6.0)
    # thrown at 2.5 s and still there at 4.5 s, all gone by 9 s
    alive=(t:f64)->int:
        n=0
        loop p in bank.puffs:
            if p.born>2.4 and p.born<2.6 and t-p.born<p.life and spray_puff_now(p,t).size.y>0.05:n+=1
        n
    assert(alive(2.6)>0 and alive(4.5)>0)
    loop p in bank.puffs:assert(spray_puff_now(p,p.born+p.life).size.y<0.001)

test "the bank is the same at 30, 60 and 120 Hz":
    a=run_bank(30,2.0);b=run_bank(60,2.0);c=run_bank(120,2.0)
    n=(x:SprayBank)->f64:f64(x.puffs.len())
    assert(abs(n(a)-n(b))<=n(b)*0.12+2.0 and abs(n(c)-n(b))<=n(b)*0.12+2.0)

test "bodies shrink away, never fade, and sink into the sea rather than being cut by it":
    bank=run_bank(60,3.0)
    out:SplashInstance[]
    spray_bank_instances(bank,vec3(0,0,0),vec3(0,500,0),3.0,out)
    assert(out.len()>0)
    loop b in out:
        assert(b.center.w==SPRAY_BIG)
        sea=f64(swell_at(f64(b.center.x),f64(b.center.z),3.0).x)
        # (the sea where the puff was thrown stands in for the sea under it now: within the swell)
        assert(f64(b.center.y+b.size.y)>sea-1.0)

test "a lobe the camera is about to pass through gives way":
    bank=run_bank(60,3.0)
    p=bank.puffs[bank.puffs.len()/2];now=spray_puff_now(p,3.0)
    eye=world_local(now.point,vec3(0,0,0))
    out:SplashInstance[]
    spray_bank_instances(SprayBank(puffs=[p]),vec3(0,0,0),eye,3.0,out)
    assert(out.len()==0)

test "a harder touchdown throws a bigger burst; only a float meeting the water throws one":
    burst=(sink:f64)->SprayBank:
        model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
        f=Flyer(.gull,0,k,water_start(k,vec3(0,0,0)),cam_pos=vec3(0,0,0))
        b=SprayBank()
        sh=SplashSheet(root=WorldPoint(0,0,0),run=0.6,amount=1)
        spray_burst(b,f,model,int(PartId.left_float),sh,1.0,sink,0.0,vec3(0,0,0))
        b
    soft=burst(0.5);hard=burst(4.0)
    biggest=(b:SprayBank)->f64:
        m=0.0
        loop p in b.puffs:m=max(m,f64(p.size.y))
        m
    assert(hard.puffs.len()>soft.puffs.len() and biggest(hard)>biggest(soft)*1.5)

test "rough water throws more and taller spray":
    calm=run_bank(60,2.5,26.0,2.0);rough=run_bank(60,2.5,26.0,14.0)
    top=(b:SprayBank)->f64:
        m=0.0
        loop p in b.puffs:
            now=spray_puff_now(p,2.5)
            m=max(m,now.point.y+f64(now.size.y))
        m
    assert(top(rough)>top(calm)*1.15 and rough.puffs.len()>=calm.puffs.len())

test "the low tier keeps the bank's puffs under its cap":
    render_quality=quality_profile(0)
    bank=run_bank(60,6.0,30.0,14.0)
    assert(bank.puffs.len()<=spray_bank_cap())
    render_quality=RenderQuality()

test "the bank leaves the game's random numbers alone":
    seed_random(42);before=random(0.0,1.0)
    seed_random(42);_=run_bank(60,1.5);after=random(0.0,1.0)
    assert(before==after)

test "a float's bank is one chain: each lobe is joined to the one thrown before it":
    bank=run_bank(60,3.0)
    linked=0;base=0
    loop p in bank.puffs:
        if p.prev.born> -1e8 or p.linked:
            base+=1
            if p.linked:
                linked+=1
                assert(p.born>=p.prev.born and p.born-p.prev.born<0.6)
    assert(base>10 and linked>=base*3/4)

test "bridging lobes close the gaps between neighbours, low on the water":
    bank=run_bank(60,3.0)
    out:SplashInstance[]
    spray_bank_instances(bank,vec3(0,0,0),vec3(0,500,0),3.0,out)
    alone:SplashInstance[]
    loop p in bank.puffs:
        q=p;q.linked=false
        spray_bank_instances(SprayBank(puffs=[q]),vec3(0,0,0),vec3(0,500,0),3.0,alone)
    assert(out.len()>alone.len())
    # Walk each chain: consecutive lobes overlap once their bridges are in.
    gaps=0;pairs=0
    loop p in bank.puffs:
        if not p.linked:continue
        a=spray_lobe(p.prev,vec3(0,0,0),vec3(0,500,0),3.0);b=spray_lobe(spray_path(p),vec3(0,0,0),vec3(0,500,0),3.0)
        if not a.shown or not b.shown:continue
        # (true neighbours only: lobes thrown far apart across a skip are not joined)
        if f64(length(vec3(b.local.x-a.local.x,0,b.local.z-a.local.z)))>f64(a.size.z+b.size.z)*3.0+2.0:continue
        pairs+=1
        mid=(a.local+b.local)*f32(0.5)
        covered=false
        loop i in out:
            d=(i.center.xyz-mid)
            if abs(d.x)<i.size.x+0.3 and abs(d.z)<max(i.size.z,i.size.x)+0.3:covered=true
        if not covered:gaps+=1
    assert(pairs>5 and gaps==0)

test "the lobes are not copies: their proportions vary":
    bank=run_bank(60,3.0)
    lo=1e9;hi=0.0;tall_lo=1e9;tall_hi=0.0
    loop p in bank.puffs:
        if not p.linked:continue
        r=f64(p.size.z/p.size.x);lo=min(lo,r);hi=max(hi,r)
        q=f64(p.size.y/p.size.x);tall_lo=min(tall_lo,q);tall_hi=max(tall_hi,q)
    assert(hi>lo*1.5 and tall_hi>tall_lo*1.4)

# The bank's size in an ordinary sea, as measured at 913f0ac3 on 2026-11-21: 153 lobes, 142 m and
# 7.9 m at full planing on the high tier, 55 lobes, 131 m and 8.7 m on the low tier (a take-off in
# the game measured the same there as at d34de485, the spray banks' first days). Held about 15 per
# cent under those, so a change that shrinks the wall or cuts it short fails here.
struct BankSize:
    live=0
    length=0.0
    top=0.0
    bodies=0
bank_size=(speed:f64,secs:f64=8.0)->BankSize:
    bank=run_bank(60,secs,speed,3.2)
    out=BankSize();lo=1e9;hi= -1e9
    loop p in bank.puffs:
        now=spray_puff_now(p,secs)
        if now.size.y<0.05:continue
        out.live+=1;lo=min(lo,now.point.z);hi=max(hi,now.point.z)
        out.top=max(out.top,now.point.y+f64(now.size.y))
    if out.live>0:out.length=hi-lo
    bodies:SplashInstance[]
    spray_bank_instances(bank,vec3(0,0,0),vec3(0,500,0),secs,bodies)
    out.bodies=bodies.len()
    out

test "at full planing in an ordinary sea the wall is long, tall and many-lobed":
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    length=spray_part_length(.gull,model,int(PartId.left_float))
    full=bank_size(k.stall_speed*1.1)
    assert(full.live>=130)
    # (the wall trails four seconds and more of the run behind the aircraft)
    assert(full.length>=k.stall_speed*1.1*3.9)
    assert(full.top>=length*1.15)
    assert(full.bodies>=540)
    # (and the medium tier's is the same wall)
    render_quality=quality_profile(1)
    medium=bank_size(k.stall_speed*1.1)
    render_quality=RenderQuality()
    assert(medium.live>=130 and medium.length>=k.stall_speed*1.1*3.9 and medium.top>=length*1.15)

test "at low planing speeds the bank is already a long low wall":
    slow=bank_size(14.0);mid=bank_size(20.0)
    assert(slow.live>=95 and slow.length>=40.0 and slow.top>=1.5)
    assert(mid.live>=100 and mid.length>=74.0 and mid.top>=6.5)

test "the low tier's wall is as tall and nearly as long, within its lobe budget":
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    length=spray_part_length(.gull,model,int(PartId.left_float))
    render_quality=quality_profile(0)
    full=bank_size(k.stall_speed*1.1);slow=bank_size(14.0)
    cap=spray_bank_cap()
    render_quality=RenderQuality()
    assert(full.live>=46 and full.length>=k.stall_speed*1.1*3.6 and full.top>=length*1.25)
    assert(slow.live>=37 and slow.length>=40.0 and slow.top>=1.9)
    # (the phone's budget: no more lobes drawn than a main and a bridging lobe for each puff)
    assert(full.live<=cap and full.bodies<=cap*2)

# The bank in a wind blowing `dir` (x, z), held as the run's own frame: what is alive, its lobes'
# summed volume, the highest top, and how far the lobes' centres stand downwind of the run's line.
struct WindBank:
    live=0
    volume=0.0
    top=0.0
    downwind=0.0
wind_bank=(speed:f64,wind:f64,dir:vec2,secs:f64=6.0)->WindBank:
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    s=water_start(k,vec3(0,0,0));s.velocity=vec3(0,0,f32(-speed*pure_k(k)))
    f=Flyer(.gull,0,k,s,cam_pos=s.position)
    bank=SprayBank();motion=SplashMotion()
    w=Wind(dir=dir,speed=wind)
    loop i in 0..int(secs*60.0):
        t=f64(i)/60.0
        f.state.time=t;f.sea_t=t
        f.state.position=vec3(0,f32(k.float_height-0.05),f32(-speed*pure_k(k)*t))
        f.state.precise=world_point(f.state.position);f.state.published=f.state.position;f.state.precise_ready=true
        targets=splash_targets(f,model,craft_transform(f),true)
        step_splash_motion(motion,targets,craft_point(f.state),t)
        step_spray_bank(bank,f,model,[loop sh in motion.sheets:sh],targets,t,w)
    out=WindBank()
    d=vec3(dir.x,0,dir.y)
    loop p in bank.puffs:
        now=spray_puff_now(p,secs)
        if now.size.y<0.05:continue
        out.live+=1
        out.volume+=f64(now.size.x*now.size.y*now.size.z)
        out.top=max(out.top,now.point.y+f64(now.size.y))
        across=f64(dot(world_delta(now.point,p.at),d))
        out.downwind+=across
    if out.live>0:out.downwind/=f64(out.live)
    out

test "a strong wind never makes the spray smaller: it bends it over and carries it downwind":
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    loop speed in [14.0,20.0,k.stall_speed*1.1]:
        light=wind_bank(speed,3.2,vec2(1,0))
        loop dir in [vec2(1,0),vec2(0,1)]:
            loop wind in [9.0,14.0,20.0]:
                strong=wind_bank(speed,wind,dir)
                print("run {speed:.1} m/s, wind {wind:.0} m/s toward {dir}: {strong.live} lobes (light air {light.live}), volume {strong.volume:.0} ({light.volume:.0}), top {strong.top:.1} m ({light.top:.1}), carried {strong.downwind:.1} m downwind ({light.downwind:.1})")
                # (as much spray and as tall a wall as in a light air, or more; in rough water the
                # lobes are bigger, so there may be fewer of them along the same wall)
                assert(strong.volume>=light.volume*0.97 and strong.top>=light.top*0.97 and strong.live>=light.live*0.6)
                # (carried off downwind, the more the stronger it blows)
                assert(strong.downwind>=wind*0.5 and strong.downwind>light.downwind+3.0)
    # (nothing is torn off a lobe as it is thrown, whatever the sea)
    whole=SprayBank();stormy=SprayBank(storm=1.0)
    spray_throw(whole,WorldPoint(0,0,0),vec3(1,0,0),vec3(0,0,-1),vec3(0,0,0),0.0,4.0,3.0,2.0,0.5,vec3(1,2,3))
    spray_throw(stormy,WorldPoint(0,0,0),vec3(1,0,0),vec3(0,0,-1),vec3(20,0,0),0.0,4.0,3.0,2.0,0.5,vec3(1,2,3))
    assert(whole.puffs[0].life==4.0 and whole.puffs[0].size==vec3(1,2,3) and whole.puffs[0].rise==2.0)
    assert(stormy.puffs[0].life==4.0 and stormy.puffs[0].size==vec3(1,2,3) and stormy.puffs[0].rise==2.0)
    # (the wall leans with the wind: a lobe riding high is carried on further than one at its foot)
    foot=SprayBank();top=SprayBank()
    spray_throw(foot,WorldPoint(0,0,0),vec3(1,0,0),vec3(0,0,-1),vec3(15,0,0),0.0,4.0,0.0,0.4,0.0,vec3(1,0.5,1))
    spray_throw(top,WorldPoint(0,0,0),vec3(1,0,0),vec3(0,0,-1),vec3(15,0,0),0.0,4.0,0.0,6.0,0.0,vec3(1,0.5,1))
    fx=spray_puff_now(foot.puffs[0],2.0).point.x;tx=spray_puff_now(top.puffs[0],2.0).point.x
    print("after 2 s in a 15 m/s wind: a lobe at the foot carried {fx:.1} m, one 6 m up {tx:.1} m")
    assert(tx>fx*1.15 and fx>12.0)
    # (drawn out along the wind as it ages, never shrunk across it)
    a=spray_puff_now(stormy.puffs[0],1.5);b=spray_puff_now(whole.puffs[0],1.5)
    assert(a.size.x>b.size.x*1.5 and a.size.y==b.size.y and a.size.z==b.size.z)
