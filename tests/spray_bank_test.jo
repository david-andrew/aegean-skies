use '../src/spray_bank.jo'
use '../src/splash.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/pilot.jo'
use '../src/world_point.jo'
use '../src/sea.jo'
use '../src/look.jo'
use '../src/quality.jo'

# A planing Gull held at a steady run on calm water, stepped at hz for `secs`.
run_bank=(hz:int,secs:f64,run_speed:f64=26.0,wind:f64=4.0)->SprayBank:
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    s=water_start(k,vec3(0,0,0));s.velocity=vec3(0,0,f32(-run_speed*pure_k(k)))
    f=Flyer(.gull,0,k,s,cam_pos=s.position)
    bank=SprayBank();motion=SplashMotion()
    w=Wind(speed=wind)
    loop i in 0..int(secs*f64(hz)):
        t=f64(i)/f64(hz)
        f.state.time=t;f.sea_t=t
        f.state.position=vec3(0,f32(k.float_height-0.05),f32(-run_speed*pure_k(k)*t))
        f.state.precise=world_point(f.state.position);f.state.published=f.state.position;f.state.precise_ready=true
        targets=splash_targets(f,model,craft_transform(f),true)
        step_splash_motion(motion,targets,craft_point(f.state),t)
        step_spray_bank(bank,f,model,[loop sh in motion.sheets:sh],targets,t,w)
    bank

test "a full planing run raises a wall at least a float's length tall behind each float":
    model=build_craft(.gull,LIVERIES[0])
    length=spray_part_length(.gull,model,int(PartId.left_float))
    bank=run_bank(60,3.0)
    assert(bank.puffs.len()>20)
    t=3.0;tallest=0.0;left=false;right=false
    loop p in bank.puffs:
        now=spray_puff_now(p,t)
        top=now.point.y+f64(now.size.y)
        tallest=max(tallest,top)
        if now.point.x< -1.0:left=true
        if now.point.x>1.0:right=true
    # (the crown lobes ride a little above the main lobes' tops)
    assert(tallest>=length*0.8)
    assert(left and right)

test "the bank hangs for two to four seconds after it is thrown, then is gone":
    bank=run_bank(60,3.0)
    loop p in bank.puffs:assert(p.life>=1.8 and p.life<=6.0)
    # thrown at 2.5 s and still there at 4.5 s, all gone by 9 s
    alive=(t:f64)->int:
        n=0
        loop p in bank.puffs:
            if p.born>2.4 and p.born<2.6 and t-p.born<p.life and spray_puff_now(p,t).size.y>0.05:n+=1
        n
    assert(alive(2.6)>0 and alive(4.5)>0)
    loop p in bank.puffs:assert(spray_puff_now(p,p.born+p.life).size.y<0.001)

test "the bank is the same at 30, 60 and 120 Hz":
    a=run_bank(30,2.0);b=run_bank(60,2.0);c=run_bank(120,2.0)
    n=(x:SprayBank)->f64:f64(x.puffs.len())
    assert(abs(n(a)-n(b))<=n(b)*0.12+2.0 and abs(n(c)-n(b))<=n(b)*0.12+2.0)

test "bodies shrink away, never fade, and sink into the sea rather than being cut by it":
    bank=run_bank(60,3.0)
    out:SplashInstance[]
    spray_bank_instances(bank,vec3(0,0,0),vec3(0,500,0),3.0,out)
    assert(out.len()>0)
    loop b in out:
        assert(b.center.w==SPRAY_BIG)
        sea=f64(swell_at(f64(b.center.x),f64(b.center.z),3.0).x)
        # (the sea where the puff was thrown stands in for the sea under it now: within the swell)
        assert(f64(b.center.y+b.size.y)>sea-1.0)

test "a lobe the camera is about to pass through gives way":
    bank=run_bank(60,3.0)
    p=bank.puffs[bank.puffs.len()/2];now=spray_puff_now(p,3.0)
    eye=world_local(now.point,vec3(0,0,0))
    out:SplashInstance[]
    spray_bank_instances(SprayBank(puffs=[p]),vec3(0,0,0),eye,3.0,out)
    assert(out.len()==0)

test "a harder touchdown throws a bigger burst; only a float meeting the water throws one":
    burst=(sink:f64)->SprayBank:
        model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
        f=Flyer(.gull,0,k,water_start(k,vec3(0,0,0)),cam_pos=vec3(0,0,0))
        b=SprayBank()
        sh=SplashSheet(root=WorldPoint(0,0,0),run=0.6,amount=1)
        spray_burst(b,f,model,int(PartId.left_float),sh,1.0,sink,0.0,vec3(0,0,0))
        b
    soft=burst(0.5);hard=burst(4.0)
    biggest=(b:SprayBank)->f64:
        m=0.0
        loop p in b.puffs:m=max(m,f64(p.size.y))
        m
    assert(hard.puffs.len()>soft.puffs.len() and biggest(hard)>biggest(soft)*1.5)

test "rough water throws more and taller spray":
    calm=run_bank(60,2.5,26.0,2.0);rough=run_bank(60,2.5,26.0,14.0)
    top=(b:SprayBank)->f64:
        m=0.0
        loop p in b.puffs:
            now=spray_puff_now(p,2.5)
            m=max(m,now.point.y+f64(now.size.y))
        m
    assert(top(rough)>top(calm)*1.15 and rough.puffs.len()>=calm.puffs.len())

test "the low tier keeps the bank's puffs under its cap":
    render_quality=quality_profile(0)
    bank=run_bank(60,6.0,30.0,14.0)
    assert(bank.puffs.len()<=spray_bank_cap())
    render_quality=RenderQuality()

test "the bank leaves the game's random numbers alone":
    seed_random(42);before=random(0.0,1.0)
    seed_random(42);_=run_bank(60,1.5);after=random(0.0,1.0)
    assert(before==after)
