use '../src/look.jo'
use '../src/plants.jo'
use '../src/sea.jo'
use '../src/paint.jo'
use '../src/objects.jo'

test "Paint steps keep bounded plateaus and filter continuously":
    previous: f32 = 0.0
    loop k in 0..201:
        v = paint_ramp(f32(k)/100.0-1.0)
        assert(v >= 0.0 and v <= 1.0 and v >= previous)
        previous = v
    assert(paint_ramp(-0.3) == 0.0 and paint_ramp(0.3) == 0.78 and paint_ramp(0.9) == 1.0)

test "Pigment sheet is periodic bounded and does not consume world randomness":
    seed_random(31); expected = random(); seed_random(31)
    loop y in 0..40:
        loop x in 0..40:
            p = vec2(f32(x)*0.37-1.3,f32(y)*0.41-2.7)
            a = paint_sheet_pixel(p)
            assert(length(a-paint_sheet_pixel(p+vec2(16,0))) < 0.0001)
            assert(length(a-paint_sheet_pixel(p+vec2(0,16))) < 0.0001)
            loop k in 0..4: assert(a[k] >= 0.0 and a[k] <= 1.0)
            assert(abs(length(a.xyz*2.0-vec3(1,1,1))-1.0) < 0.0001)
    assert(random() == expected)
    img = paint_surface_image()
    assert(img.width == 256 and img.height == 256 and img.pixels.len() == 256*256*4)

test "Painted recess tags preserve opening geometry color and triangle count":
    old: Vertex3D[]; painted: Vertex3D[]
    at = translation(vec3(40,20,-30))*rotation_y(0.73)
    color = vec4(0.3,0.4,0.6,0.5)
    add_box(old,vec3(2,4,7),vec3(1.4,1.9,0.12),color,at)
    add_painted_opening(painted,vec3(2,4,7),vec3(1.4,1.9,0.12),color,at)
    assert(old.len() == painted.len())
    loop k in 0..old.len():
        assert(length(old[k].pos-painted[k].pos) < 0.0001)
        assert(length(old[k].normal-painted[k].normal) < 0.0001)
        assert(old[k].color == painted[k].color)
        assert(painted[k].uv.x >= 180.0 and painted[k].uv.x <= 181.0)
        assert(painted[k].uv.y >= 0.0 and painted[k].uv.y <= 1.0)

# The streamed-town shader uses the same tags as the original-town shader.
test "Material tags distinguish tree crowns openings and aircraft colors":
    v = Vertex3D(vec3(0,0,0),vec3(0,1,0),vec2(173,4),vec4(0.2,0.4,0.1,1))
    assert(obj_surface(v).z == 1.0)
    v.color = vec4(0.5,0.3,0.1,1)
    assert(obj_surface(v).z == 0.0)
    v.uv = vec2(180.4,0.7)
    assert(obj_surface(v).z == 2.0)
    v.uv = vec2(0,0); v.color = vec4(0.2,0.4,0.1,1)
    assert(obj_surface(v).z == 0.0 and obj_surface(v,1.0).z == 1.0)


test "Plaster tags preserve geometry and do not key aircraft or doors by colour":
    old: Vertex3D[]; painted: Vertex3D[]
    m = translation(vec3(5,9,-7))*rotation_y(0.4)
    add_box(old,vec3(0,3,0),vec3(8,6,10),WALLS[0],m)
    add_plaster_box(painted,vec3(0,3,0),vec3(8,6,10),WALLS[0],m)
    assert(old.len() == painted.len())
    loop k in 0..old.len():
        assert(old[k].pos == painted[k].pos and old[k].normal == painted[k].normal)
        assert(old[k].color == painted[k].color)
        assert(obj_surface(painted[k]).z == 3.0 and obj_surface(old[k]).z == 0.0)
    full: Vertex3D[]; proxy: Vertex3D[]
    add_house(full,mat4(),8,10,7,0); add_house_proxy(proxy,mat4(),8,10,7,0)
    assert(obj_surface(full[0]).z == 3.0 and obj_surface(proxy[0]).z == 3.0)

test "Whitewash shade stays pale cool and follows night and weather brightness":
    day = light_at(14.0); night = light_at(0.0)
    fill = paint_plaster_fill(day.sun,day.shade)
    assert(fill.x > 0.65 and fill.z > fill.x and fill.z/fill.x < 1.2)
    assert(fill.x < day.sun.x and fill.y < day.sun.y and fill.z < day.sun.z)
    assert(length(paint_plaster_fill(night.sun,night.shade)) < length(fill)*0.3)
    assert(length(paint_plaster_fill(day.sun*0.5,day.shade*0.5)-fill*0.5) < 0.00001)

test "Summer cover is stable bounded and responds to aspect and height":
    south = normalize(vec3(0,0.8,0.6)); north = normalize(vec3(0,0.8,-0.6))
    seed_random(21); expected = random(); seed_random(21)
    loop h in [20.0,200.0,600.0,1200.0,2400.0]:
        loop patch in [0.0,0.3,0.5,0.7,1.0]:
            a = summer_cover(south,f32(h),0.1,f32(patch))
            b = summer_cover(north,f32(h),0.1,f32(patch))
            loop k in 0..3: assert(a[k] >= 0.0 and a[k] <= 1.0 and b[k] >= 0.0 and b[k] <= 1.0)
            assert(a.y+a.z <= 1.00001 and b.y+b.z <= 1.00001)
            assert(a.x >= b.x and b.z >= a.z)
    assert(summer_cover(north,600.0,0.0,0.7).z > summer_cover(north,20.0,0.0,0.7).z)
    assert(summer_cover(north,2400.0,0.0,0.7).z == 0.0)
    assert(random() == expected)

test "Open shelves turn blue before enclosed coves without a colour seam":
    previous: f32 = 1.0
    loop k in 0..601:
        d = f32(k)*0.1
        open = sea_shallow_mix(d,0.0); cove = sea_shallow_mix(d,1.0)
        assert(open >= 0.0 and open <= previous and cove >= open and cove <= 1.0)
        assert(previous-open < 0.03)
        previous = open
    assert(sea_shallow_mix(0.0,0.0) == 1.0 and sea_shallow_mix(60.0,1.0) == 0.0)
    assert(sea_shallow_mix(12.0,0.0) == 0.0 and sea_shallow_mix(6.0,1.0) > 0.7)
