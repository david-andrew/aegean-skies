use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_calendar.jo'
use '../src/living_save.jo'
use '../src/living_far_people.jo'
use 'living_far_people.jo'

test "capital patronal calendar is stable pure and rolls over four-week cycles":
    loop id in [0,17,100003,200006]:
        start=next_capital_feast_minute(id,0)
        assert(capital_feast_day(id,day_index(start)))
        assert(next_capital_feast_minute(id,start)==start)
        assert(next_capital_feast_minute(id,start+1)==start+28*1440)
        assert(not capital_feast_day(id,day_index(start)+1))
    assert(not capital_feast_day(-1,0) and not capital_feast_day(1,-1))

test "feast square intents use existing residents without adding population or wallets":
    w=resident_fixture(); id=promote_far_person(w,100,.trader)
    w.minute=next_capital_feast_minute(100,0); w.tick=w.minute*120
    before=canonical_text(w)
    views=capital_gatherings(w,w.minute)
    assert(views.len()==1 and views[0].place==100 and id in views[0].named_people)
    assert(views[0].cohort_people==39 and views[0].square.key=="test:square")
    assert(far_person_venue(w,id).kind==.square and canonical_text(w)==before)
    assert(capital_gatherings(w,w.minute+300).len()==0)
