use '../src/living_types.jo'
use '../src/speech_warmup.jo'
use '../src/living_save.jo'
use '../src/living_far_news.jo'
use 'living_commissions.jo'

test "browser speech warmup is bounded and leaves the complete world unchanged":
    w=commission_fixture();state=SpeechWarmup()
    far_local_news(w,100,"cargo_arrival","A cart brought fish to the counter.")
    far_local_news(w,100,"cargo_arrival","Another cart brought grain.")
    before=canonical_text(w)
    step_speech_warmup(w,state)
    assert(state.work_units==0) # the frame that advances a minute does no warm work
    loop frame in 0..500:
        units=state.work_units
        step_speech_warmup(w,state)
        assert(state.work_units<=units+1)
    assert(state.cursor==core_person_count(w)*10 and state.checksum>0)
    assert(state.kinds.len()>0 and canonical_text(w)==before)
    w.minute+=12;w.tick=w.minute*120
    before=canonical_text(w)
    step_speech_warmup(w,state);step_speech_warmup(w,state)
    assert(state.finished and canonical_text(w)==before)
    units=state.work_units
    loop frame in 0..120:step_speech_warmup(w,state)
    assert(state.work_units==units)
