use '../src/living_types.jo'
use '../src/living_war.jo'
use '../src/living_war_supply.jo'
use '../src/living_far_stock.jo'
use '../src/living_money.jo'
use 'living_commissions.jo'

test "an arsenal consumes actual parts fuel and treasury wages before producing ammunition":
    w=commission_fixture(); initialize_war(w)
    assert(far_produce(w,100,5,3000) and far_produce(w,100,4,200))
    stock=stock_totals(w); account=w.far.treasury[1]; cents=w.accounts[account].cents
    roots=w.next_cargo_source
    w.minute=360; w.tick=43200
    war_industry_minute(w)
    after=stock_totals(w)
    assert(after[5]==stock[5]-15000 and after[4]==stock[4]-1000 and after[8]==stock[8]+10000)
    assert(w.accounts[account].cents==cents-300)
    assert(w.next_cargo_source>=roots and goods_balance(w) and money_balances(w))
    # No output when there is no physical input left, regardless of a wealthy treasury.
    available=far_market_qty(w,100,5)
    batch=far_take_market(w,100,5,available); far_use(w,batch)
    before=stock_totals(w); w.minute=720; w.tick=86400
    war_industry_minute(w)
    assert(stock_totals(w)==before)
