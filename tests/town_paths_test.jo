use '../src/town_details.jo'
use '../src/settlements.jo'
use '../src/world.jo'
use '../src/geography.jo'

test "wide paving conforms to every canonical triangle without gaps":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    loop pair in [(vec2(-117963.8,-84900.6),vec2(-117930.0,-84890.0)),(vec2(-81989.88,-148787.5),vec2(-81970.0,-148775.0))]:
        vs: Vertex3D[]
        town_path(vs,pair.0,pair.1,25.0,true)
        assert(vs.len() > 0)
        area = 0.0
        loop k in 0..vs.len()/3:
            a = vs[k*3].pos; b = vs[k*3+1].pos; c = vs[k*3+2].pos
            area += abs(f64((b.x-a.x)*(c.z-a.z)-(b.z-a.z)*(c.x-a.x)))*0.5
        expected = f64(length(pair.1-pair.0))*25.0
        assert(abs(area-expected)/expected < 0.003)
        loop v in vs:
            assert(abs(f64(v.pos.y)-place_ground(v.pos.xz)-0.12) < 0.025)


test "street trees and pergola foliage stay at their supporting branch heights":
    loop kind in [10,17,2]:
        leaves = [loop v in town_prop_vertices(kind): if v.color.y > v.color.x*1.15 and v.color.y > v.color.z*1.15: v.pos]
        assert(leaves.len() > 0)
        low = 1e9; high = -1e9
        loop p in leaves: low = min(low,f64(p.y)); high = max(high,f64(p.y))
        if kind == 10: assert(low >= 5.3 and high <= 9.5)
        if kind == 17: assert(low < 2.0 and high < 10.0)
        if kind == 2: assert(low >= 2.8 and high <= 3.6)
