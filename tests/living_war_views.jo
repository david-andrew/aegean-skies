use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_war_types.jo'
use '../src/living_war.jo'
use '../src/living_war_views.jo'
use '../src/living_commissions.jo'
use '../src/living_far_news.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

test "the chart shows heard dated occupation rather than current unseen control":
    w=commission_fixture(); w.people[0].pose.pos=vec3(100000,0,100000)
    w.far.districts[200].controller=1
    before=canonical_text(w)
    view=[loop v in war_places(w): if v.place==200: v][0]
    assert(view.controller== -1 and view.observed_minute== -1 and canonical_text(w)==before)
    event=far_local_news(w,200,"occupation","Kalyra took Port 200.",country=1,severity=900)
    w.people[0].pose.pos=far_counter(w,200)
    far_hear_counter(w,0,200) # actual counter visit, not opening the chart
    w.people[0].pose.pos=vec3(100000,0,100000)
    w.far.districts[200].controller=2
    view=[loop v in war_places(w): if v.place==200: v][0]
    assert(view.controller==1 and view.confidence==1000 and view.observed_minute==0)
    assert([loop r in w.people[0].far_reports: if r.id==event: r].len()==1)
    w.people[0].pose.pos=w.place_contexts[200].center
    view=[loop v in war_places(w): if v.place==200: v][0]
    assert(view.controller==2 and view.reason=="Observed locally.")

test "war relations stay unknown until an actual declaration account is received":
    w=commission_fixture(); initialize_war(w)
    r=war_relation(w,1,2); w.diplomacy[r].stage=.war
    assert(not [loop v in war_relations(w): if v.a==1 and v.b==2: v][0].known)
    far_local_news(w,100,"war_declared","Kalyra declared war on Orenthia.",country=1,other_country=2,severity=1000)
    w.people[0].pose.pos=far_counter(w,100)
    far_hear_counter(w,0,100)
    v=[loop v in war_relations(w): if v.a==1 and v.b==2: v][0]
    assert(v.known and v.stage==.war and v.occurred_minute==0)
