# Planing across a chop the floats strike its crests: she hops a little and slams back (flight.jo
# _float_slams), more the rougher the chop, never in a calm, and it never makes a take-off harder:
# no damage, no capsize, airborne about as soon.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 sloppy test tests/float_slam_test.jo
import '../src/flight.jo' as fl
import '../src/planes.jo' as planes

_spec = (kind: planes.Craft) -> fl.CraftSpec:
    model = planes.build_craft(kind, planes.LIVERIES[0])
    fl.craft_spec(kind, model.contacts)

struct Run:
    hops = 0                        # times off the water for over a tenth of a second before flying
    slams = 0
    longest = 0.0                   # the longest hop, s
    highest = 0.0                   # the highest the floats rose over their waterline in a hop, m
    airborne = 0.0                  # when she flew (3 m up), s
    damage = 0.0
    crashed = false

# A take-off by the autopilot from rest, in a wind `wind` m/s on the nose and a chop `chop`.
# (the player's aircraft, as the game flies it: its pure speed scale and flight model)
_takeoff = (kind: planes.Craft, chop: f64, wind: f64, hz: int = 60) -> Run:
    k = _spec(kind); k.player = true
    e = fl.FlightEnv(wind = vec3(0, 0, f32(wind)), chop = (x: f64, z: f64) -> f64: chop)
    s = fl.water_start(k, vec3(0, 0, 0)); plan = fl.FlightPlan()
    out = Run()
    off = 0.0; up = 0.0
    loop i in 0..hz * 75:
        c = fl.autopilot(k, s, plan, e)
        fl.step(k, s, c, e, 1.0 / f64(hz))
        if s.position.y > k.float_height + 3:
            out.airborne = s.time
            break
        if s.water_age > 0.0:
            off += 1.0 / f64(hz)
            up = max(up, f64(s.position.y) - k.float_height)
        else:
            if off > 0.1: out.hops += 1; out.longest = max(out.longest, off); out.highest = max(out.highest, up)
            off = 0.0; up = 0.0
    out.slams = s.slams
    out.damage = s.hull_damage; out.crashed = s.crashed or s.capsized
    out

test "planing in a chop she hops and slams back, the more the rougher; never in a calm":
    loop kind in [planes.Craft.gull, planes.Craft.heron, planes.Craft.corsair, planes.Craft.falco]:
        calm = _takeoff(kind, 0.0, 0.0)
        assert(calm.airborne > 0.0 and calm.hops == 0, "{kind} hops {calm.hops} times on glassy water")
        hops = 0
        loop chop in [0.4, 0.7, 1.0]:
            # (the chop alone: the same light air on the nose each time, so a stronger wind's
            # shorter run does not hide what the chop does)
            wind = 3.0
            r = _takeoff(kind, chop, wind)
            print("{kind}, chop {chop:.1} in {wind:.0} m/s: {r.hops} hops ({r.slams} slams), longest {r.longest:.2} s, highest {r.highest:.2} m; flying at {r.airborne:.1} s (calm water {calm.airborne:.1} s); damage {r.damage:.3}")
            # (some hops, short and low: a lively run, not a bounce down the water)
            # (a few strikes, some of them clear of the water. The run here, from
            # rest, is short, five to seven seconds, and a strike late in it may throw her off into
            # her climb a moment early, as a real crest does; the game's runs plane far longer)
            assert(r.slams >= 2, "{kind}: {r.slams} slams in a chop of {chop}")
            hops += r.hops
            assert(r.longest < 0.9 and r.highest < 1.2)
            # (and no harder: no harm done, airborne about as soon)
            assert(not r.crashed and r.damage < 0.01 and r.airborne > 0.0 and r.airborne < calm.airborne * 1.25 + 2.0)
        assert(hops >= 2, "{kind}: {hops} hops over all three chops")

test "the slams are the same at 30 and 60 Hz, and the same each time":
    a = _takeoff(planes.Craft.gull, 0.8, 10.0, 60)
    b = _takeoff(planes.Craft.gull, 0.8, 10.0, 60)
    c = _takeoff(planes.Craft.gull, 0.8, 10.0, 30)
    assert(a.hops == b.hops and a.airborne == b.airborne)
    assert(abs(a.hops - c.hops) <= 2 and abs(a.airborne - c.airborne) < 1.5)
