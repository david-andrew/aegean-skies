test "additional road connections and island shore tracks remain dry and walkable":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    loop connection in ACCESS_CONNECTIONS:
        loop k in 1..connection.points.len():
            assert(feeder_segment_clear(connection.points[k-1],connection.points[k]),"blocked road {connection.a}/{connection.b} segment {k}")
    loop id,landing in SHORE_LANDINGS:
        s=world_settlements[settlement_by_id[id]]
        assert(s.harbor.len()==2 and s.remote_harbor)
        loop k in 1..landing.route.len():assert(feeder_segment_clear(landing.route[k-1],landing.route[k]),"blocked shore path {id} segment {k}")
        p=settlement_port(s)
        loop d in s.harbor:
            assert(place_ground(d.at.xz)< -2.0)
            assert(port_mooring(d.at)!=none and port_landing(d.at)!=none)
        previous=f64(landing.root.y)
        loop q in p.quays:
            n=max(1,int(ceil(f64(length(q.b-q.a))*2.0)))
            loop k in 0..n+1:
                at=mix(q.a,q.b,f32(k)/f32(n))
                h=port_quay_height(at.xz,place_ground(at.xz))
                assert(abs(h-f64(port_deck(q,f32(k)/f32(n))))<0.05,"buried deck {id}: at={at} ground={place_ground(at.xz)} actual={h} deck={port_deck(q,f32(k)/f32(n))}")
                assert(abs(h-previous)<0.8,"shore deck step {id}")
                previous=h

test "saved access upgrades preserve link IDs money population and rolling stock":
    w=build_world();w.far.populated=true;w.far.access_version=2
    loop connection in ACCESS_CONNECTIONS:
        loop id in [connection.a,connection.b]:
            if not (id in w.far.districts):w.far.districts[id]=FarDistrict(id=id)
    first=ACCESS_CONNECTIONS[0]
    w.far.links=[FarLink(0,first.a,first.b,.cart,first.points,1000,trail=true)]
    w.far.districts[first.a].links=[0];w.far.districts[first.b].links=[0]
    accounts=w.accounts;people=w.people;vehicles=w.far.vehicles;original=w.far.links[0]
    upgrade_access_links(w)
    assert(w.far.links[0]==original and w.far.links.len()==ACCESS_CONNECTIONS.len())
    assert(w.accounts==accounts and w.people==people and w.far.vehicles==vehicles)
    loop link in w.far.links:
        assert(link.id in w.far.districts[link.a].links and link.id in w.far.districts[link.b].links)
    once=to_text(w);upgrade_access_links(w);assert(to_text(w)==once)


test "new island roads reach their existing harbours through precise walking contact":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    assert(INLAND_ACCESS[301551].landing==301550)
    checked=0
    loop road in ACCESS_CONNECTIONS:
        if road.a!=301551 and road.a!=303831:continue
        assert(INLAND_ACCESS[road.a].landing==road.b)
        assert(road.b==road.a-1 and world_settlements[settlement_by_id[road.b]].harbor.len()==2)
        point=world_point(road.points[0]);point.y=walk_height([],point.x,point.z)
        loop k in 1..road.points.len():
            goal=road.points[k]
            count=max(1,int(ceil(f64(length(goal.xz-road.points[k-1].xz))/0.25)))
            loop step in 0..count:
                delta=vec2(f32(f64(goal.x)-point.x),f32(f64(goal.z)-point.z))/f32(count-step)
                old=point;point=walk_step_precise([],point,delta)
                assert(abs(point.x-old.x-f64(delta.x))<0.02 and abs(point.z-old.z-f64(delta.y))<0.02,"blocked island road segment {k}: {old} to {point} delta={delta}")
            assert(abs(point.x-f64(goal.x))<0.02 and abs(point.z-f64(goal.z))<0.02)
        checked+=1
    assert(checked==2)


test "Olythandra shore approach and quay loading points have continuous walking contact":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    landing=SHORE_LANDINGS[301041]
    s=world_settlements[settlement_by_id[301041]];port=settlement_port(s)
    assert(s.harbor.len()==2 and s.remote_harbor)
    assert(INLAND_ACCESS[301041].landing==301041)
    routes=[landing.route]
    loop route in port.routes:routes.push(route)
    routes.push([landing.root,port.board])
    loop route in routes:
        point=world_point(route[0]);point.y=walk_height([],point.x,point.z)
        loop k in 1..route.len():
            goal=route[k];count=max(1,int(ceil(f64(length(goal.xz-route[k-1].xz))/0.25)))
            loop step in 0..count:
                delta=vec2(f32(f64(goal.x)-point.x),f32(f64(goal.z)-point.z))/f32(count-step)
                old=point;point=walk_step_precise([],point,delta)
                assert(abs(point.x-old.x-f64(delta.x))<0.02 and abs(point.z-old.z-f64(delta.y))<0.02,"blocked Olythandra approach/quay segment {k}: old={old} new={point} delta={delta}")
            assert(abs(point.x-f64(goal.x))<0.02 and abs(point.z-f64(goal.z))<0.02)
    loop at in port.loading:assert(abs(walk_height([],f64(at.x),f64(at.z))-f64(at.y))<0.05)
