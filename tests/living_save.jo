use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
use '../src/living_claims.jo'
use '../src/living_duties.jo'
use '../src/living_weather.jo'
use '../src/living_checks.jo'

roundtrip = (w: World):
    text = canonical_text(w)
    parsed = from_text[World](text)
    if parsed is TextError: panic("{parsed}")
    assert(validate_save_world(parsed) == "")
    assert(canonical_text(parsed) == text)
    a = w; b = parsed
    advance_minutes(a,1440); advance_minutes(b,1440)
    assert(canonical_text(a) == canonical_text(b))

test "mid state roundtrips continue identically":
    w = build_world(u64(42)); roundtrip(w)
    assert(take_job(w,3,0)); roundtrip(w)
    advance_minutes(w,5); roundtrip(w)
    advance_minutes(w,160); roundtrip(w) # active raid/encounter
    d = w.obligation_keys["nikos_engine_bill"]
    pay_obligation(w,d,500); roundtrip(w)
    b = build_world(); advance_minutes(b,15)
    assert(start_repair(b,b.obligation_keys["dario_service"]))
    roundtrip(b)
    b = build_world(); ditch(b,1,b.trips[0].reason); roundtrip(b)

test "two slots corrupt newest falls back unsupported schema does not write":
    assert(env("SLOPPY_SAVE_DIR") != none)
    prefix = "living-test"
    delete_data("{prefix}-a"); delete_data("{prefix}-b")
    w = build_world(); state = PresentationState()
    generation = save_game(w,state,123,prefix)
    if generation is LivingSaveError: panic(generation.message)
    assert(generation == 1)
    advance_minutes(w,20)
    generation = save_game(w,state,123,prefix)
    if generation is LivingSaveError: panic(generation.message)
    assert(generation == 2)
    loaded = load_game(123,prefix)
    assert(loaded is SaveGame)
    assert(canonical_text(loaded.world) == canonical_text(w))
    assert(save_data("{prefix}-b","corrupt newest"))
    loaded = load_game(123,prefix)
    assert(loaded is SaveGame and loaded.generation == 1)
    future = SaveGame(schema=2,valid=true,generation=99,terrain_key=123,world=w)
    assert(save_value("{prefix}-b",future))
    before = load_data("{prefix}-b")
    assert(load_game(123,prefix) is LivingSaveError)
    assert(save_game(w,state,123,prefix) is LivingSaveError)
    assert(load_data("{prefix}-b") == before)
    assert(load_game(999,"missing-slot") is LivingSaveError)
    delete_data("{prefix}-a"); delete_data("{prefix}-b"); delete_data("{prefix}-b.bad")

test "bad references fail validation missing added field keeps documented default":
    w = build_world()
    w.aircraft[1].owner = 1000
    assert(validate_save_world(w) != "")
    w = build_world(); w.goods.clear()
    assert(validate_save_world(w) != "")
    parsed = from_text[SaveGame]("SaveGame(schema=1,valid=false)")
    assert(parsed is SaveGame and parsed.generation == 0 and parsed.world.content_version == 1)

test "canonical maps ignore insertion order and thirty day replay ignores cosmetic RNG":
    loop seed in [0,1,7,42,127]:
        a = build_world(u64(seed)); b = build_world(u64(seed))
        reversed: {int: Trip}
        ids = b.trips.keys(); ids.sort(descending=true)
        loop id in ids: reversed[id] = b.trips[id]
        b.trips = reversed
        cosmetic = 0.0
        loop day in 0..30:
            loop minute in 0..1440:
                advance_minutes(a,1)
                # 10000 cosmetic global draws over the run cannot affect stateless world draws.
                if day*1440+minute < 10000: cosmetic += random()
                advance_minutes(b,1)
            assert(canonical_hash(a) == canonical_hash(b))
            assert(validate_save_world(a) == "")
        print("seed {seed}: canonical daily replay and pruning pass; {a.events.len()} retained events")
        assert(cosmetic >= 0.0)
