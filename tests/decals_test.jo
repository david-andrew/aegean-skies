# Decals: every motif is drawn in code as convex pieces within its frame; a decal is projected
# onto the surface it meets, at the size and angle asked, in the part it lands on, and not
# through to what lies behind; the usual spots are found on real aircraft; a pointer finds its
# place on the aircraft.
use '../src/planes.jo'
use '../src/markings.jo'
use '../src/paint_parts.jo'
use '../src/decals.jo'
use '../src/aircraft_paint.jo'

_cross = (a: vec2, b: vec2) -> f64: f64(a.x) * f64(b.y) - f64(a.y) * f64(b.x)

_poly_area = (pts: vec2[]) -> f64:
    total = 0.0
    loop k in 0..pts.len(): total += _cross(pts[k], pts[(k + 1) % pts.len()])
    abs(total) * 0.5

_tri_area = (vs: Vertex3D[], from: int = 0) -> f64:
    total = 0.0
    loop t in from / 3..vs.len() / 3: total += f64(length(cross(vs[t * 3 + 1].pos - vs[t * 3].pos, vs[t * 3 + 2].pos - vs[t * 3].pos))) * 0.5
    total

# a flat plate 8 m by 8 m facing up at y = 1, in the left wing's bin, and another below it at y = 0
_plates = () -> Vertex3D[][]:
    bins: Vertex3D[][] = [[], [], [], [], [], [], []]
    add_box(bins[2], vec3(0, 0.95, 0), vec3(8, 0.1, 8), rgb(0.9, 0.9, 0.8))
    add_box(bins[3], vec3(0, -0.05, 0), vec3(8, 0.1, 8), rgb(0.9, 0.9, 0.8))
    bins

test "every motif is drawn: convex pieces, inside its frame, in its own colours":
    assert(DECAL_MOTIFS.len() >= 30)
    loop m in DECAL_MOTIFS:
        polys = decal_polys(m.key, if m.key == "text": "K-AB3" else: "")
        assert(polys.len() > 0, m.key)
        assert(m.colours.len() >= 1 and m.colours.len() <= 3 and m.group in DECAL_GROUPS, m.key)
        wide = decal_half_width(m.key, "K-AB3")
        loop q in polys:
            assert(q.pts.len() >= 3 and q.slot >= 0 and q.slot < m.colours.len() and q.layer >= 0 and q.layer < 2, m.key)
            turn = 0.0
            loop k in 0..q.pts.len():
                p = q.pts[k]
                assert(abs(f64(p.y)) <= 1.001 and abs(f64(p.x)) <= wide + 0.001, "{m.key} {p}")
                c = _cross(q.pts[(k + 1) % q.pts.len()] - p, q.pts[(k + 2) % q.pts.len()] - q.pts[(k + 1) % q.pts.len()])
                # (convex: it turns one way all the way round)
                if abs(c) > 0.00001:
                    assert(turn == 0.0 or (turn > 0.0) == (c > 0.0), "{m.key} is not convex")
                    turn = c
    # (keys are saved: each its own)
    loop a in 0..DECAL_MOTIFS.len():
        loop b in a + 1..DECAL_MOTIFS.len(): assert(DECAL_MOTIFS[a].key != DECAL_MOTIFS[b].key)
    assert(decal_polys("no such motif").len() == 0)

test "an outline cut into triangles keeps its area, whichever way round it is given":
    star: vec2[] = [loop k in 0..10: vec2(cos(TAU * f64(k) / 10.0) * (if k % 2 == 0: 1.0 else: 0.4), sin(TAU * f64(k) / 10.0) * (if k % 2 == 0: 1.0 else: 0.4))]
    back: vec2[] = [loop k in 0..10: star[9 - k]]
    loop outline in [star, back]:
        out: DecalPoly[]
        decal_outline(out, outline, 0, 0)
        total = 0.0
        loop q in out: total += _poly_area(q.pts)
        assert(out.len() == 8 and abs(total - _poly_area(star)) < 0.0001, "{out.len()} {total}")

test "letters and numbers: what the font can paint, each character its pieces":
    assert(decal_clean_text("k-ab 3?") == "K-AB 3")
    assert(decal_polys("text", "").len() == 0)
    one = decal_polys("text", "I").len()
    assert(one > 0 and decal_polys("text", "II").len() == one * 2)
    assert(decal_half_width("text", "K-AB3") > decal_half_width("text", "K"))

test "a disc projected from above lies on the plate it meets: its size, its part, just above the surface":
    bins = _plates(); was = bins
    s = decal_space(bins)
    d = Decal(motif = "disc", side = DECAL_ABOVE, u = 0.5, v = 0.5, size = 2.0, both = false)
    added = decals_apply(bins, s, [d])
    # (in the upper plate's bin and nowhere else: not through to the plate below)
    assert(added > 0 and bins[2].len() == was[2].len() + added and bins[3] == was[3])
    area = _tri_area(bins[2], was[2].len())
    assert(abs(area - PI) < 0.05, "{area}")
    loop k in was[2].len()..bins[2].len():
        v = bins[2][k]
        assert(v.pos.y > 1.005 and v.pos.y < 1.03 and v.normal.y > 0.99, "{v.pos}")
        assert(length(v.pos.xz) < 1.001 and v.color == DECAL_MOTIFS[0].colours[0])
    # (from below: the lower plate's underside)
    bins = _plates()
    d.side = DECAL_BELOW
    assert(decals_apply(bins, s, [d]) > 0 and bins[2] == was[2] and bins[3].len() > was[3].len())
    assert(bins[3][was[3].len()].pos.y < -0.1)

test "its size and angle are as asked: a band twice as long as high, turned a quarter, stands upright":
    extent = (angle: f64) -> vec3:
        bins = _plates()
        n = bins[2].len()
        decals_apply(bins, decal_space(bins), [Decal(motif = "band", side = DECAL_ABOVE, size = 1.0, angle = angle, both = false)])
        lo = vec3(1e9, 1e9, 1e9); hi = vec3(-1e9, -1e9, -1e9)
        loop k in n..bins[2].len():
            lo = min(lo, bins[2][k].pos); hi = max(hi, bins[2][k].pos)
        hi - lo
    flat = extent(0.0); turned = extent(90.0)
    assert(abs(flat.x - 2.0) < 0.01 and abs(flat.z - 0.5) < 0.01, "{flat}")
    assert(abs(turned.x - 0.5) < 0.01 and abs(turned.z - 2.0) < 0.01, "{turned}")

test "a decal wraps an edge onto the faces it meets and is cut at the surface's end":
    bins = _plates(); n = bins[2].len()
    # (at the plate's corner: only the quarter that lies on it)
    decals_apply(bins, decal_space(bins), [Decal(motif = "square", side = DECAL_ABOVE, u = 0.0, v = 0.0, size = 2.0, both = false)])
    assert(abs(_tri_area(bins[2], n) - 1.0) < 0.01, "{_tri_area(bins[2], n)}")

test "on both sides: the other side's copy, an animal mirrored to face the nose, letters still reading":
    bins = _plates(); s = decal_space(bins)
    left = decal_frame(s, Decal(motif = "cat", side = DECAL_LEFT, u = 0.3, v = 0.5, size = 1.0))
    right = decal_frame(s, Decal(motif = "cat", side = DECAL_LEFT, u = 0.3, v = 0.5, size = 1.0), true)
    assert(left.ok and right.ok and not left.flip and right.flip)
    assert(left.into == vec3(1, 0, 0) and right.into == vec3(-1, 0, 0) and left.origin.z == right.origin.z and left.origin.x < 0.0 and right.origin.x > 0.0)
    assert(not decal_frame(s, Decal(motif = "text", text = "K1", side = DECAL_LEFT), true).flip)
    # (from above, the copy is across the centreline)
    top = decal_frame(s, Decal(motif = "star", side = DECAL_ABOVE, u = 0.25, v = 0.5))
    across = decal_frame(s, Decal(motif = "star", side = DECAL_ABOVE, u = 0.25, v = 0.5), true)
    assert(top.origin.x < 0.0 and abs(top.origin.x + across.origin.x) < 0.0001)

test "the usual spots are found on real aircraft, and the decal lands on the part it names":
    loop kind in [Craft.gull, Craft.heron, Craft.falco, Craft.macchi_m5, Craft.curtiss_r3c2, Craft.sm_s55, Craft.tern]:
        lv = LIVERIES[DEFAULT_LIVERIES[int(kind)]]
        plain = build_craft(kind, lv)
        loop sp in DECAL_SPOTS:
            m = build_painted_craft(kind, lv, [], [Decal(motif = "disc", spot = sp.key, size = 0.0)])
            assert(m.body.count > plain.body.count, "{CRAFT_NAMES[int(kind)]} {sp.key}")
            # (in the part's mesh: it breaks away with the part)
            total = 0
            loop part in m.parts: total += part.mesh.count
            assert(total == m.body.count)
        wing = build_painted_craft(kind, lv, [], [Decal(motif = "roundel", spot = "wing-top", size = 0.0)])
        assert(wing.parts[2].mesh.count > plain.parts[2].mesh.count and wing.parts[3].mesh.count > plain.parts[3].mesh.count, CRAFT_NAMES[int(kind)])
        assert(wing.parts[0].mesh.count == plain.parts[0].mesh.count and wing.parts[6].mesh.count == plain.parts[6].mesh.count)
        rudder = build_painted_craft(kind, lv, [], [Decal(motif = "star", spot = "rudder", size = 0.0)])
        assert(rudder.parts[6].mesh.count > plain.parts[6].mesh.count and rudder.parts[2].mesh.count == plain.parts[2].mesh.count, CRAFT_NAMES[int(kind)])

test "a decal on the Gull's top wing stays on the top wing":
    lv = LIVERIES[0]
    build_painted_craft(.gull, lv, [], [Decal(motif = "disc", spot = "wing-top", size = 1.2, both = false)])
    space = last_painted_space()
    assert(space != none)
    if let s = space:
        bins = s.bins
        n = bins[2].len()
        decals_apply(bins, s, [Decal(motif = "disc", spot = "wing-top", size = 1.2, both = false)])
        assert(bins[2].len() > n)
        # (the Gull's upper wing is at 1.55, its lower at -0.5)
        loop k in n..bins[2].len(): assert(bins[2][k].pos.y > 1.5, "{bins[2][k].pos}")

test "the limits: a dozen decals, and no more triangles than the cap":
    bins = _plates(); s = decal_space(bins); n = bins[2].len()
    many = [loop k in 0..40: Decal(motif = "checks", side = DECAL_ABOVE, size = 1.0, both = false)]
    one = decals_apply(bins, s, [many[0]])
    bins = _plates()
    assert(decals_apply(bins, s, many) == one * DECAL_LIMIT)
    p = Paint(kind = 0)
    loop d in many: paint_add_decal(p, d)
    assert(p.decals.len() == DECAL_LIMIT and paint_add_decal(p, Decal(motif = "nothing")) == -1)
    paint_remove_decal(p, 0)
    assert(p.decals.len() == DECAL_LIMIT - 1)
    text = [loop k in 0..DECAL_LIMIT: Decal(motif = "text", text = "88888888", side = DECAL_ABOVE, size = 0.6, both = true)]
    bins = _plates()
    assert(decals_apply(bins, s, text) <= DECAL_CORNERS)
    assert(n == _plates()[2].len())

test "a pointer on the aircraft: the side it meets and the place there, which puts a decal under it":
    bins = _plates(); s = decal_space(bins)
    hit = decal_pick(s, vec3(1.0, 10, -2.0), vec3(0, -1, 0))
    assert(hit != none)
    if let h = hit:
        assert(h.0 == DECAL_ABOVE and abs(h.1 - 0.625) < 0.001 and abs(h.2 - 0.25) < 0.001, "{h}")
        n = bins[2].len()
        decals_apply(bins, s, [Decal(motif = "disc", side = h.0, u = h.1, v = h.2, size = 0.5, both = false)])
        lo = vec3(1e9, 1e9, 1e9); hi = vec3(-1e9, -1e9, -1e9)
        loop k in n..bins[2].len():
            lo = min(lo, bins[2][k].pos); hi = max(hi, bins[2][k].pos)
        mid = (lo + hi) * 0.5
        assert(abs(mid.x - 1.0) < 0.01 and abs(mid.z + 2.0) < 0.01, "{mid}")
    assert(decal_pick(s, vec3(20, 10, 0), vec3(0, -1, 0)) == none)
    side = decal_pick(s, vec3(-10, 0.95, 1.0), vec3(1, 0, 0))
    if let h = side: assert(h.0 == DECAL_LEFT, "{h}")
    else: assert(false)

test "a painted Gull with decals: built in a few milliseconds, the same every time":
    p = paint_from_spec("part.lwing=stripes:0.8,0.1,0.1:0.9,0.9,0.8:0:6 part.fuselage=gradient:0.1,0.2,0.6:0.9,0.9,0.8 decal=roundel:wing-top decal=text:fuselage:0:0:::::K-AB3 decal=cat:cowling", 0)
    a = paint_build(p, 0); b = paint_build(p, 0)
    assert(a.body.count == b.body.count and a.body.count > build_craft(.gull, LIVERIES[0]).body.count)
    assert(a.body.count < 12000, "{a.body.count}")
