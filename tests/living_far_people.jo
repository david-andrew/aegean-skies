resident_fixture = () -> World:
    w = build_world(u64(42))
    contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    venues = [LifeVenue(100,"test:market",.market,vec3(100,2,100)),LifeVenue(100,"test:home",.home,vec3(110,2,100)),LifeVenue(100,"test:square",.square,vec3(100,2,110)),LifeVenue(100,"test:fields",.fields,vec3(140,2,100))]
    contexts.push(LifePlaceContext(100,"Oria",2,100,vec3(100,2,100),venues=venues))
    assert(publish_place_contexts(w,1,contexts,[-1,-1,100]))
    assert(populate_settlement_economy(w,1,[FarPlaceSeed(100,40,2,3)],[]))
    w

test "promotion moves an actual citizen and purse once while preserving a persistent identity":
    w = resident_fixture(); population=far_population(w); cash=w.ledger.opening_cents
    households=w.accounts[w.far.districts[100].household_account].cents
    id=promote_far_person(w,100,.trader)
    assert(id==26 and w.people[id].far_home==100 and w.people[id].citizenship==2)
    assert(w.people[id].home== -1 and w.people[id].place== -1 and person_place(w,id)==100)
    assert(w.accounts[w.people[id].account].cents==households/40)
    assert(promote_far_person(w,100,.trader)==id and far_population(w)==population and w.ledger.opening_cents==cash)
    assert(invariant_errors(w).len()==0 and validate_save_world(w)=="")

test "far resident speech uses the unchanged question facade and actual witnessed counter quotes":
    w=resident_fixture(); id=promote_far_person(w,100,.trader)
    w.people[0].pose.pos=w.people[id].pose.pos
    before=canonical_text(w)
    turn=conversation_preview(w,id,0,.market)
    assert("Oria" in turn.text and "grain" in turn.text and canonical_text(w)==before)
    quoted=turn.text
    w.far.districts[100].prices[3] += 500
    assert(conversation_preview(w,id,0,.market).text==quoted)
    greeting=converse(w,id,0,.greeting)
    assert(greeting.text!="" and greeting.replies.len()>=2 and greeting.replies.len()<=4)
    answer=answer_conversation(w,id,0,.ask_back)
    assert("Oria" in answer.text)
    work=converse(w,id,0,.work)
    assert("commission of mine" in work.text or "Nothing I'm paying" in work.text)
    assert(work.job== -1 and w.active_jobs.len()==5)
    assert(validate_save_world(w)=="")

test "promoted people keep their own clock and do not enter legacy jobs fishing or daily routines":
    a=resident_fixture(); trader=promote_far_person(a,100,.trader); farmer=promote_far_person(a,100,.farmer)
    loop _ in 0..180: step_minute(a)
    assert(a.people[trader].trip== -1 and a.people[farmer].trip== -1)
    assert(not (trader in a.daily_life) and not (farmer in a.daily_life))
    text=canonical_text(a); restored=from_text[World](text); assert(restored is World)
    b=restored
    loop _ in 0..180: step_minute(a); step_minute(b)
    assert(canonical_text(a)==canonical_text(b) and invariant_errors(a).len()==0)
    assert(a.far.people[trader].last_meal_day>=0 and far_population(a)==a.far.opening_population)

test "carried cargo news is heard at a counter then relayed with its original date and source":
    w=resident_fixture(); id=promote_far_person(w,100,.trader)
    event=far_local_news(w,100,"cargo_arrival","A cart brought two sacks of grain to Oria.")
    assert(w.people[id].far_reports.len()==0 and w.people[0].far_reports.len()==0)
    far_hear_counter(w,id,100)
    w.people[0].pose.pos=w.people[id].pose.pos
    turn=converse(w,id,0,.news)
    assert(turn.far_news==event and "two sacks" in turn.text)
    assert(w.people[0].far_reports.len()==1)
    report=w.people[0].far_reports[0]
    assert(report.source_person==id and report.occurred_minute==0 and report.hops==1 and report.confidence==850)
    assert(not far_relay_report(w,id,0,event))
    assert(validate_save_world(w)=="")

test "nearby walking leases fold without duplicating residents or advancing the same interval twice":
    w=resident_fixture(); observer=w.place_contexts[100].center
    prepare_far_people(w,observer)
    assert(w.far.people.len()==3 and w.far.near_people.len()==3 and core_person_count(w)==26)
    id=w.far.near_people[0]; w.tick=1
    step_far_people_scene(w,[],observer,0.0)
    assert(w.people[id].move_owner==.scene and w.far.people[id].scene_owned)
    before=w.people[id].pose.pos; w.far.people[id].target=before+vec3(10,0,0)
    w.tick=2; far_walk_abstract(w,id,w.tick)
    assert(w.people[id].pose.pos==before)
    fold_far_people(w)
    assert(w.people[id].move_owner==.abstract_world and not w.far.people[id].scene_owned)
    w.tick=62; far_walk_abstract(w,id,w.tick)
    assert(abs(f64(length(w.people[id].pose.pos-before))-1.2)<0.001)
    assert(far_population(w)==w.far.opening_population and validate_save_world(w)=="")

test "vehicle occupants never walk or earn foot wages through a stale scene list":
    w=resident_fixture(); observer=w.place_contexts[100].center
    prepare_far_people(w,observer)
    id=w.far.near_people[0]
    w.far.people[id].vehicle=0 # this existing resident is aboard the existing player hull
    w.far.people[id].target=w.people[id].pose.pos+vec3(100,0,0)
    w.far.people[id].route=[w.people[id].pose.pos,w.far.people[id].target]
    w.far.people[id].waypoint=1; w.far.people[id].scene_owned=true
    at=w.people[id].pose.pos; purse=w.accounts[w.people[id].account].cents
    w.tick+=30
    far_walk_abstract(w,id,w.tick)
    assert(w.people[id].pose.pos==at and w.far.people[id].last_tick==w.tick)
    # next scan is still in the future; an old near_people entry must be harmless now.
    step_far_people_scene(w,[],observer,0.5)
    assert(w.people[id].pose.pos==at and not w.far.people[id].scene_owned)
    w.tick=120; w.minute=1; far_people_minute(w)
    assert(w.people[id].pose.pos==at and w.accounts[w.people[id].account].cents==purse)
    assert(w.far.people[id].last_tick==w.tick)
    w.far.people[id].vehicle= -1
    far_walk_abstract(w,id,w.tick)
    assert(w.people[id].pose.pos==at) # no elapsed aboard interval is caught up as walking
