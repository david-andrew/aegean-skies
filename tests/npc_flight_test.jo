# The other aircraft on flight model v2 (fdm2_npcs), flown by the production autopilot (flight.jo
# `autopilot`) at the player's pure scale: off the water, and trips to a dock for the types that
# tools/npc_survey.jo found could not finish one.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/npc_flight_test.jo
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as planes

const K = 3.3

_spec = (kind: planes.Craft) -> fl.CraftSpec:
    fl.set_speed_scale(K); fl.set_lift_scale(K)
    tw.set_tweaks(tw.Tweaks())
    k = fl.craft_spec(kind, planes.build_craft(kind, planes.LIVERIES[0]).contacts)
    k.player = false
    k

_reset = ():
    fl.set_speed_scale(1.0); tw.set_tweaks(tw.Tweaks())

_pitch = (s: fl.CraftState) -> f64: asin(clamp(f64(fl.forward(s).y), -1.0, 1.0))

# The autopilot's take-off holds the nose's attitude on the water and climbs away only once she is
# flying: no pitch-up into the stall as she leaves the water (the player's steering did, before)
test "the autopilot takes them off the water and away without a pitch-up into the stall":
    loop kind in [planes.Craft.heron, planes.Craft.macchi_m5, planes.Craft.pelican, planes.Craft.supermarine_s6b, planes.Craft.dornier_dox]:
        k = _spec(kind)
        s = fl.water_start(k, vec3(0, 0, 0))
        plan = fl.FlightPlan(target = vec3(0, 0, -40000), taxi_target = vec3(0, 0, -40100), altitude = 250.0)
        off = -1.0; steepest = 0.0; stalled = 0.0
        loop i in 0..30 * 100:
            fl.step(k, s, fl.autopilot(k, s, plan, fl.FlightEnv()), fl.FlightEnv(), 1.0 / 30.0)
            if off < 0.0 and not s.on_water and f64(s.position.y) > k.float_height + K: off = s.time
            if off >= 0.0:
                steepest = max(steepest, _pitch(s))
                if s.stalled and not s.on_water: stalled += 1.0 / 30.0
                if s.time > off + 15.0: break
        print("{kind} autopilot off the water at {off:.1} s: steepest {steepest * 57.3:.0} deg, stalled {stalled:.1} s, up {f64(s.position.y) / K:.0} m")
        assert(off > 0.0 and steepest < 0.45 and stalled < 0.5 and not s.on_water and not s.crashed and s.hull_damage < 0.02)
    _reset()

_trip = (kind: planes.Craft) -> (fl.CraftState, fl.FlightPlan):
    k = _spec(kind)
    s = fl.water_start(k, vec3(0, 0, 0), 0.4)
    plan = fl.FlightPlan(target = vec3(3000, 0, -4000), taxi_target = vec3(3020, 0, -4050), takeoff_heading = 0.4)
    loop i in 0..30 * 900:
        fl.step(k, s, fl.autopilot(k, s, plan, fl.FlightEnv()), fl.FlightEnv(), 1.0 / 30.0)
        if plan.phase == .done or plan.phase == .failed or s.crashed: break
    (s, plan)

# The H-4 came to a fix too near to line up from, at her slow roll, and went round four times: her
# final is as long as her size asks, and her slow nose flares from higher
test "the giants fly a trip to the dock: a final as long as they need, a flare begun high enough":
    loop kind in [planes.Craft.hughes_h4, planes.Craft.dornier_dox]:
        r = _trip(kind); s = r.0; plan = r.1
        print("{kind} trip: {plan.phase} after {s.time:.0} s, {plan.go_arounds} go-arounds, harm {s.hull_damage:.3}")
        assert(plan.phase == .done and s.moored and not s.crashed and plan.go_arounds <= 1 and s.hull_damage < 0.05)
    _reset()

# The P.7 lands on her foils and runs a long way out on them: turned toward the dock still up on
# them, a foil broached and dropped her hull in at speed; she runs straight on, settles, and taxis
# back on her water screw
test "the P.7 runs out straight on her foils after landing and taxis back to the dock":
    r = _trip(.piaggio_p7); s = r.0; plan = r.1
    print("P.7 trip: {plan.phase} after {s.time:.0} s, {plan.go_arounds} go-arounds, harm {s.hull_damage:.3}")
    assert(plan.phase == .done and s.moored and not s.crashed and s.hull_damage < 0.02)
    _reset()
