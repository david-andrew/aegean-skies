use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/town_sites.jo'
use '../src/town_details.jo'
use '../src/world_towns.jo'
use '../src/port_mesh.jo'

load_world = () -> int:
    global world_town_far,geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_settlements(false,true); finish_settlement_registry()
    world_town_far = [loop s in world_settlements: FarTown()]
    found = -1
    loop k in 0..world_settlements.len():
        if world_settlements[k].name == "Kalyrassa": found = k
    assert(found >= 0)
    found

test "a path paved a cell at a time is the path paved at once":
    _ = load_world()
    loop pair in [(vec2(-117963.8,-84900.6),vec2(-117930.0,-84890.0)),(vec2(-81989.88,-148787.5),vec2(-81970.0,-148775.0))]:
        whole: Vertex3D[]
        town_path(whole,pair.0,pair.1,25.0,true)
        parts: Vertex3D[]; cell = 0; calls = 0
        loop cell >= 0:
            cell = town_path_part(parts,pair.0,pair.1,25.0,true,vec3(0,0,0),cell,0.0)
            calls += 1
        assert(calls > 1)
        assert(parts.len() == whole.len() and hash(parts) == hash(whole))

test "a district and a far town built a slice at a time match the one-shot build":
    index = load_world()
    s = world_settlements[index]
    whole_far = build_far_town(s)
    job = FarJob(index=index); slices = 1
    loop not far_job_advance(job,0.0): slices += 1
    assert(slices > 3)
    assert(hash(job.town.houses) == hash(whole_far.houses) and hash(job.town.cells) == hash(whole_far.cells) and hash(job.town.harbor) == hash(whole_far.harbor) and hash(job.town.hill) == hash(whole_far.hill))
    world_town_far[index] = job.town
    # The square's district (with the port) and one beside it.
    loop xz in [(0,0),(1,0)]:
        whole = build_town_district(index,xz.0,xz.1,0.5)
        sliced = district_job(index,xz.0,xz.1,0.5); steps = 1
        loop not district_job_advance(sliced,0.0): steps += 1
        assert(steps > 10)
        d = sliced.district
        assert(d.key == whole.key and hash(d.houses) == hash(whole.houses) and hash(d.styles) == hash(whole.styles) and hash(d.props) == hash(whole.props))
        assert(d.paths.len() > 0 and d.paths.len() == whole.paths.len() and hash(d.paths) == hash(whole.paths))

test "the street plan is made once and clips as before":
    index = load_world()
    s = world_settlements[index]
    first = place_streets(s,0,0)
    assert(first.len() > 0 and s.id in place_street_plans)
    again = place_streets(s,0,0)
    assert(hash(first) == hash(again))

test "a road searched a piece at a time is the road searched at once":
    _ = load_world()
    assert(settlement_roads.len() > 40)
    checked = 0; routed = 0
    loop id in 0..settlement_roads.len():
        if id%10 != 0: continue
        road = settlement_roads[id]
        a = world_settlements[settlement_by_id[road.a]].center.xz; b = world_settlements[settlement_by_id[road.b]].center.xz
        whole = place_route(a,b)
        r = route_search(a,b); pieces = 1
        loop not route_search_step(r,0.0): pieces += 1
        assert(r.path.len() == whole.len() and hash(r.path) == hash(whole))
        if whole.len() > 0: assert(pieces > 31); routed += 1
        checked += 1
        if checked == 6: break
    assert(checked == 6 and routed > 0)
