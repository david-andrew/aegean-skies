# The big boats' spray (src/splash.jo _boat_targets): fixed stations per hull, sponson and float,
# wet or dry with hysteresis, the curtain's root sliding smoothly along the hull rather than
# jumping between contacts, and spray only at the water: none hanging from an aircraft flying low.
use '../src/splash.jo'
use '../src/pilot.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/world_point.jo'
use '../src/sea.jo'

_run = (kind: Craft) -> (f64, f64, int):
    m = build_craft(kind, LIVERIES[0])
    models = [m]
    f = make_flyer(kind, 0, m.contacts, vec3(0, 0, 0), 0.0)
    unmoor(f.state); f.spec.player = true
    e = FlightEnv(wave_height = 0.5)
    plan = FlightPlan()
    prev: f64[] = fill(0.0, 7); seen: bool[] = fill(false, 7)
    jump = 0.0; above = 0.0; frames = 0
    loop i in 0..60 * 80:
        fl_step = autopilot(f.spec, f.state, plan, e)
        step(f.spec, f.state, fl_step, e, 1.0 / 60.0)
        f.sea_t = f.state.time
        pose = translation(f.state.position) * quat_to_mat4(f.state.orientation)
        sheets = splash_targets(f, m, pose, true)
        back = quat_rotate(f.state.orientation, vec3(0, 0, 1))
        loop k in 0..7:
            sh = sheets[k]
            if sh.amount < 0.05:
                seen[k] = false
                continue
            d = world_delta(sh.root, craft_point(f.state))
            z = f64(dot(d, back))
            if seen[k]: jump = max(jump, abs(z - prev[k]))
            prev[k] = z; seen[k] = true
            # (a curtain's root is on the sea, never up at the aircraft)
            above = max(above, sh.root.y - f64(swell_at(sh.root.x, sh.root.z, f.sea_t).x))
            frames += 1
        if not f.state.on_water and f.state.position.y > f.spec.float_height + 30: break
    (jump, above, frames)

test "the big boats' spray roots slide along the hull and stay on the sea through a takeoff":
    loop kind in [Craft.hughes_h4, Craft.dornier_dox, Craft.short_sarafand, Craft.dornier_wal, Craft.sm_s55]:
        r = _run(kind)
        print("{kind}: largest root step {r.0:.2} m a frame, highest root {r.1:.2} m over the sea, {r.2} sheet-frames")
        assert(r.2 > 100 and r.0 < 1.0 and r.1 < 0.2)

test "flying low over the sea, a big boat throws no spray":
    loop kind in [Craft.hughes_h4, Craft.dornier_dox]:
        m = build_craft(kind, LIVERIES[0])
        f = make_flyer(kind, 0, m.contacts, vec3(0, 0, 0), 0.0)
        set_speed_scale(3.3)
        f.spec = craft_spec(kind, m.contacts); f.spec.player = true
        f.state = CraftState(position = vec3(0, 20, 0), velocity = vec3(0, 0, -180), fuel = f.spec.fuel_capacity, water_age = 1.0)
        pose = translation(f.state.position) * quat_to_mat4(f.state.orientation)
        loop i in 0..30:
            loop sh in splash_targets(f, m, pose, true): assert(sh.amount < 0.0001)
        set_speed_scale(1.0)
