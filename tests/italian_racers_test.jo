# The Italian racers: Macchi M.C.72 (contra-rotating pair), Savoia-Marchetti S.65 (push-pull
# tandem) and Piaggio P.7 (hydrofoils, a water screw and a clutch).
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/italian_racers_test.jo
import '../src/planes.jo' as planes
import '../src/flight.jo' as fl
import '../src/hydrofoil.jo' as foil
import '../src/tweaks.jo' as tw
import '../src/living_types.jo' as living
import '../src/flight_feedback.jo' as fb
import '../src/prop_disc.jo' as disc
import '../src/sea.jo' as sea
import '../src/look.jo' as look

RACERS: planes.Craft[] = [.macchi_mc72, .sm_s65, .piaggio_p7]

_finite = (s: fl.CraftState):
    assert(abs(f64(s.position.x)) < 1e7 and abs(f64(s.position.y)) < 1e7 and abs(f64(s.position.z)) < 1e7)
    assert(abs(f64(length(s.orientation)) - 1.0) < 0.0001)

_bank = (s: fl.CraftState) -> f64:
    r = quat_rotate(s.orientation, vec3(1, 0, 0)); u = quat_rotate(s.orientation, vec3(0, 1, 0))
    atan2(-f64(r.y), f64(u.y))

test "the racers build with their parts, props each way round and the world's data":
    loop kind in RACERS:
        id = int(kind); p = planes.aircraft_profile(kind)
        m = planes.build_craft(kind, planes.LIVERIES[planes.DEFAULT_LIVERIES[id]])
        k = fl.craft_spec(kind, m.contacts)
        assert(planes.CRAFT_NAMES.len() == living.AIRFRAMES.len() and str(kind) == str(living.Airframe(id)))
        assert(planes.DEFAULT_LIVERIES[id] == living.AIRFRAME_LIVERIES[id])
        # (player-switchable only: no NPC is seeded with one)
        loop choices in living.SEED_AIRFRAMES:
            loop a in choices: assert(int(a) != id)
        assert(m.parts.len() == 7 and m.contacts.len() >= 6 and m.shade.len() % 2 == 0 and m.cockpits.len() == 1)
        mass = 0.0; points = 0; vertices = 0
        loop part in m.parts:
            mass += part.spec.mass_share; points += part.spec.contacts.len(); vertices += part.mesh.count
            assert(part.mesh.count > 0 and part.spec.strength > 0)
        assert(abs(mass - 1) < 0.00001 and points == m.contacts.len() and vertices == m.body.count)
        assert(m.prop_hubs.len() == m.prop_spins.len() and m.prop_alt.count == m.prop.count)
        print("{planes.CRAFT_NAMES[id]}: {m.body.count / 3} triangles, {m.prop_hubs.len()} props, {m.contacts.len()} contacts, {k.mass:.0}kg, torque share {k.torque_share}")
    mc = planes.build_craft(.macchi_mc72, planes.LIVERIES[1])
    # coaxial: one axis, the rear rotor just behind the front, turning the other way
    assert(mc.prop_hubs.len() == 2 and mc.prop_hubs[0].xy == mc.prop_hubs[1].xy and mc.prop_hubs[0].z < mc.prop_hubs[1].z)
    assert(mc.prop_hubs[1].z - mc.prop_hubs[0].z < 0.5 and mc.prop_spins[0] == 1.0 and mc.prop_spins[1] == -1.0)
    s65 = planes.build_craft(.sm_s65, planes.LIVERIES[1])
    assert(s65.prop_hubs.len() == 2 and s65.prop_hubs[0].z < -3.0 and s65.prop_hubs[1].z > 2.0 and s65.prop_spins[1] == -1.0)
    p7 = planes.build_craft(.piaggio_p7, planes.LIVERIES[1])
    assert(p7.prop_hubs.len() == 1 and fl.craft_spec(.piaggio_p7, p7.contacts).foils.len() == 3)

_exercise = (kind: planes.Craft, player: bool):
    fl.set_speed_scale(if player: 3.3 else: 1.0)
    m = planes.build_craft(kind, planes.LIVERIES[1])
    k = fl.craft_spec(kind, m.contacts); k.player = player
    e = fl.FlightEnv()
    s = fl.water_start(k, vec3(0, 0, 0))
    loop i in 0..600: fl.step(k, s, fl.Controls(), e, 1.0 / 30.0)
    print("{kind} player={player} rest y={s.position.y:.3} expected={k.float_height:.3} speed={length(s.velocity):.3}")
    assert(abs(f64(s.position.y) - k.float_height) < 0.12 and length(s.velocity) < 0.1 and not s.crashed)
    # The production takeoff controller.
    s = fl.water_start(k, vec3(0, 0, 0))
    took_off = false; plan = fl.FlightPlan()
    loop i in 0..60 * 90:
        fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
        if not s.on_water and s.position.y > k.float_height + 5:
            took_off = true; break
    print("{kind} player={player} takeoff t={s.time:.2} distance={length(s.position.xz):.1} y={s.position.y:.1} damage={s.hull_damage:.4}")
    assert(took_off and not s.crashed and s.hull_damage < 0.01 and length(s.position.xz) < (if player: 5000 else: 1800))
    before = s.position.y
    loop i in 0..60 * 45:
        fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
        if s.position.y > before + 60: break
    _finite(s)
    assert(s.position.y > before + 15 and not s.crashed)
    # Straight and level at cruise: holds its height and heading, hands off.
    s = fl.CraftState(position = vec3(0, 500, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = fl.cruise_throttle(k, k.cruise_speed / fl.pure_k(k)))
    loop i in 0..60 * 20: fl.step(k, s, fl.Controls(throttle = s.throttle), e, 1.0 / 60.0)
    print("{kind} player={player} level y={s.position.y:.1} heading={fl.heading(s):.3} speed={length(s.velocity):.1}")
    assert(abs(f64(s.position.y) - 500) < 60 and abs(fl.heading(s)) < 0.1 and not s.crashed)
    # A turn.
    s = fl.CraftState(position = vec3(0, 500, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = 0.75)
    loop i in 0..120: fl.step(k, s, fl.Controls(throttle = 0.75, roll = 0.12, yaw = 0.2), e, 1.0 / 60.0)
    print("{kind} player={player} turn heading={fl.heading(s):.3} y={s.position.y:.1}")
    assert(fl.heading(s) > 0.05 and fl.heading(s) < 1.4 and s.position.y > 450 and not s.crashed)
    # A water landing from just above the stall, to rest.
    s = fl.CraftState(position = vec3(0, k.float_height + 3, 0), velocity = vec3(0, -0.6, -k.stall_speed * 1.15 * fl.pure_k(k)),
        orientation = quat_euler(-0.02, 0, 0), fuel = k.fuel_capacity)
    touched = false; rebound = 0.0
    # (the P.7 runs on far on her foils, with so little drag on them, before settling: give her longer)
    loop i in 0..60 * (if kind == .piaggio_p7: 180 else: 120):
        fl.step(k, s, fl.Controls(assist = 0, water_brake = 0.4), e, 1.0 / 60.0)
        if s.on_water: touched = true
        if touched: rebound = max(rebound, f64(s.velocity.y))
    print("{kind} player={player} landing y={s.position.y:.3} speed={length(s.velocity):.3} rebound={rebound:.2} damage={s.hull_damage:.4}")
    _finite(s)
    # (the P.7's foils, met at landing speed, lift harder than floats: she skips once)
    assert(touched and not s.crashed and s.hull_damage < 0.05 and rebound < (if kind == .piaggio_p7: 3.0 else: 2.0))
    assert(abs(f64(s.position.y) - k.float_height) < 0.15 and length(s.velocity) < 0.2)
    fl.set_speed_scale(1.0)

test "M.C.72 NPC design speed takeoff level turn water landing":
    _exercise(.macchi_mc72, false)
test "M.C.72 player 3.3 scale takeoff level turn water landing":
    _exercise(.macchi_mc72, true)
test "S.65 NPC design speed takeoff level turn water landing":
    _exercise(.sm_s65, false)
test "S.65 player 3.3 scale takeoff level turn water landing":
    _exercise(.sm_s65, true)
test "P.7 NPC design speed takeoff level turn water landing":
    _exercise(.piaggio_p7, false)
test "P.7 player 3.3 scale takeoff level turn water landing":
    _exercise(.piaggio_p7, true)

test "the racers fly the same twice over, on both flight models":
    loop model in [0, 1]:
        tw.set_tweaks(tw.Tweaks(flight_model = model))
        loop kind in RACERS:
            fl.set_speed_scale(3.3)
            m = planes.build_craft(kind, planes.LIVERIES[1])
            k = fl.craft_spec(kind, m.contacts); k.player = true
            e = fl.FlightEnv(wave_height = 0.15)
            ends: vec3[]
            loop run in 0..2:
                s = fl.water_start(k, vec3(0, 0, 0)); plan = fl.FlightPlan()
                loop i in 0..60 * 40: fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
                ends.push(s.position)
                assert(not s.crashed)
            assert(ends[0] == ends[1])
            print("model {model} {kind}: {ends[0]}")
    tw.set_tweaks(tw.Tweaks())
    fl.set_speed_scale(1.0)

# With the prop torque trial on, one propeller's reaction heels a seaplane on its take-off run
# (one float dug in) and rolls it in the air; a contra-rotating pair or a push-pull tandem cancel.
test "contra-rotating and push-pull pairs have no net torque swing":
    fl.set_speed_scale(1.0)
    loop kind in [planes.Craft.falco, planes.Craft.macchi_mc72, planes.Craft.sm_s65]:
        m = planes.build_craft(kind, planes.LIVERIES[1])
        k = fl.craft_spec(kind, m.contacts)
        e = fl.FlightEnv()
        # the same run with the trial off and on: on the water, then in the air (the trial model,
        # whose rough air is the same both times), full throttle, hands off
        heel: f64[]; banks: f64[]; torque = 0.0
        loop on in [false, true]:
            tw.set_tweaks(tw.Tweaks(prop_torque = on))
            k.player = false
            s = fl.water_start(k, vec3(0, 0, 0))
            worst = 0.0
            loop i in 0..60 * 6:
                fl.step(k, s, fl.Controls(throttle = 1.0, assist = 0.0), e, 1.0 / 60.0)
                worst = max(worst, abs(_bank(s)))
            heel.push(worst)
            torque = fl.prop_torque(k, s)
            tw.set_tweaks(tw.Tweaks(prop_torque = on, flight_model = 1))
            k.player = true
            a = fl.CraftState(position = vec3(0, 600, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = 1.0)
            loop i in 0..60 * 3: fl.step(k, a, fl.Controls(throttle = 1.0, assist = 0.0), e, 1.0 / 60.0)
            banks.push(_bank(a))
        print("{kind}: torque {torque:.0} N m, worst heel on the run {heel[0]:.5} -> {heel[1]:.5}, bank in the air {banks[0]:.4} -> {banks[1]:.4}")
        if kind == .falco:
            assert(abs(torque) > 1000.0 and heel[1] > heel[0] + 0.004 and abs(banks[1] - banks[0]) > 0.02)
        else:
            assert(k.torque_share == 0.0 and torque == 0.0 and heel[1] == heel[0] and banks[1] == banks[0])
    tw.set_tweaks(tw.Tweaks())

# The trial's direction follows the propeller's turning: a right-hand propeller (clockwise seen
# from the cockpit, the profile's default and most engines of the period) heels her to port on the
# run and rolls her to port in the air (left wing down: a negative bank); a left-hand one the other
# way. Racers with their own swing take none of it.
test "the prop torque trial rolls against each propeller's turning":
    fl.set_speed_scale(1.0)
    # (the game's own sixteen keep the left-hand props they were drawn with; the historical types
    # are right-hand, the S.6B's from the record: its torque buried the port float)
    loop id in 0..16: assert(planes.aircraft_profile(planes.Craft(id)).prop_hand == -1.0)
    loop kind in [planes.Craft.macchi_mc72, planes.Craft.sm_s65, planes.Craft.piaggio_p7, planes.Craft.supermarine_s6b]: assert(planes.aircraft_profile(kind).prop_hand == 1.0)
    loop id in 0..planes.CRAFT_NAMES.len():
        p = planes.aircraft_profile(planes.Craft(id))
        k = fl.craft_spec(planes.Craft(id), planes.build_craft(planes.Craft(id), planes.LIVERIES[1]).contacts)
        assert(abs(k.prop_hand) == 1.0)
        if p.contra or p.push_pull or p.swing > 0.0: assert(k.torque_share == 0.0)
    m = planes.build_craft(.falco, planes.LIVERIES[1])
    e = fl.FlightEnv()
    loop hand in [1.0, -1.0]:
        k = fl.craft_spec(.falco, m.contacts); k.prop_hand = hand
        heel: f64[]; banks: f64[]; torque = 0.0
        loop on in [false, true]:
            tw.set_tweaks(tw.Tweaks(prop_torque = on))
            k.player = false
            s = fl.water_start(k, vec3(0, 0, 0))
            mean = 0.0
            loop i in 0..60 * 6:
                fl.step(k, s, fl.Controls(throttle = 1.0, assist = 0.0), e, 1.0 / 60.0)
                if i >= 60 * 2: mean += _bank(s) / (60.0 * 4.0)
            heel.push(mean)
            torque = fl.prop_torque(k, s)
            tw.set_tweaks(tw.Tweaks(prop_torque = on, flight_model = 1))
            k.player = true
            a = fl.CraftState(position = vec3(0, 600, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = 1.0)
            loop i in 0..60 * 3: fl.step(k, a, fl.Controls(throttle = 1.0, assist = 0.0), e, 1.0 / 60.0)
            banks.push(_bank(a))
        print("falco hand {hand}: torque {torque:.0} N m, heel on the run {heel[0]:.4} -> {heel[1]:.4}, bank in the air {banks[0]:.4} -> {banks[1]:.4}")
        # (+ torque is to port; a negative bank is the left wing down)
        assert(torque * hand > 1000.0)
        assert((heel[1] - heel[0]) * hand < -0.003 and (banks[1] - banks[0]) * hand < -0.02)
    tw.set_tweaks(tw.Tweaks())

# The P.7's take-off, phase by phase: the screw pushes the hull; the foils' lift grows with the
# square of the speed and lifts the hull, whose drag falls; on the foils alone, the clutch hands
# the engine to the air propeller (never before the hull is clear and the propeller out of the
# sea); the air propeller pulls her up to flying speed and she flies off. And the ways it fails.
test "the P.7 takes off from her hull to her foils and into the air":
    fl.set_speed_scale(1.0)
    m = planes.build_craft(.piaggio_p7, planes.LIVERIES[1])
    k = fl.craft_spec(.piaggio_p7, m.contacts)
    e = fl.FlightEnv()
    # the foils' own lift, deep: the square of the speed (well below the cavitation knee)
    f = foil.P7_FOILS[0]
    l4 = f64(foil.foil_force(f, 1.0, 4.0, 0.0).x); l8 = f64(foil.foil_force(f, 1.0, 8.0, 0.0).x)
    assert(abs(l8 / l4 - 4.0) < 0.05)
    l12 = f64(foil.foil_force(f, 1.0, 12.0, 0.0).x)
    # and tops out near its cavitation limit (FOIL_CAVITATION Pa over its area), however fast
    assert(f64(foil.foil_force(f, 1.0, 60.0, 0.0).x) < foil.FOIL_CAVITATION * f.area * 1.001)
    assert(f64(foil.foil_force(f, 0.0, 12.0, 0.0).x) == 0.0 and f64(foil.foil_force(f, 0.1, 12.0, 0.0).x) < l12 * 0.3)
    s = fl.water_start(k, vec3(0, 0, 0))
    assert(s.foil.clutch == 0.0 and s.foil.air == 0.0)
    plan = fl.FlightPlan()
    t_foil = -1.0; t_clutch = -1.0; t_air = -1.0
    lift_at_5 = -1.0; lift_at_10 = -1.0; y_rest = f64(s.position.y)
    hull_drag_slow = 0.0; screw_at_clutch = -1.0
    loop i in 0..60 * 60:
        c = fl.autopilot(k, s, plan, e)
        was = s.foil
        fl.step(k, s, c, e, 1.0 / 60.0)
        v = f64(length(s.velocity))
        if lift_at_5 < 0 and v >= 5.0: lift_at_5 = s.foil.lift
        if lift_at_10 < 0 and v >= 10.0: lift_at_10 = s.foil.lift
        if s.foil.foilborne and t_foil < 0:
            t_foil = s.time
            print("P.7 foil-borne t={s.time:.2} v={v:.1} y={s.position.y:.2} (rest {y_rest:.2}) clutch={s.foil.clutch}")
            assert(s.foil.clutch == 0.0 and s.position.y > y_rest + 0.2)
        # the clutch never goes over before she is on her foils with the propeller clear
        if s.foil.clutch > 0.0 and was.clutch == 0.0:
            t_clutch = s.time
            print("P.7 clutch t={s.time:.2} v={v:.1} foil-borne {was.foilborne} for {was.clear_time:.2}s")
            assert(t_foil > 0 and was.foilborne and not was.prop_wet and v >= foil.FOIL_CARRY_SPEED)
        if t_clutch < 0: assert(s.foil.air == 0.0)
        if not s.on_water and t_air < 0:
            t_air = s.time
            print("P.7 airborne t={s.time:.2} v={v:.1} distance={length(s.position.xz):.0} air drive={s.foil.air}")
        if t_air > 0 and s.position.y > k.float_height + 10: break
    print("P.7 foil lift at 5 m/s {lift_at_5:.2} of her weight, at 10 m/s {lift_at_10:.2}")
    assert(lift_at_5 > 0.05 and lift_at_10 > lift_at_5 * 2.5)
    assert(t_foil > 0 and t_clutch > t_foil and t_air > t_clutch and s.foil.air == 1.0 and not s.crashed and s.hull_damage < 0.01)
    # Short of power (60% throttle) she climbs onto her foils more slowly and settles below 14 m/s:
    # the clutch still goes over (once she is on her foils with the propeller clear), and the
    # engine comes to no harm.
    s = fl.water_start(k, vec3(0, 0, 0)); plan = fl.FlightPlan()
    loop i in 0..60 * 40:
        c = fl.autopilot(k, s, plan, e); c.throttle = 0.6
        was = s.foil
        fl.step(k, s, c, e, 1.0 / 60.0)
        if s.foil.clutch > 0.0 and was.clutch == 0.0: assert(was.foilborne and not was.prop_wet)
    print("P.7 at 60% throttle: v={length(s.velocity):.1} foil-borne {s.foil.foilborne} clutch {s.foil.clutch}")
    assert(s.foil.clutch == 1.0 and s.engine_damage == 0.0)
    # The clutch thrown at rest: the air propeller beats the sea, gives nothing and hurts the engine.
    s = fl.water_start(k, vec3(0, 0, 0)); plan = fl.FlightPlan()
    loop i in 0..60 * 10:
        c = fl.autopilot(k, s, plan, e); c.clutch = true
        fl.step(k, s, c, e, 1.0 / 60.0)
    print("P.7 clutched at rest: v={length(s.velocity):.1} engine damage {s.engine_damage:.2} prop in the sea {s.foil.prop_wet}")
    assert(s.foil.prop_wet and length(s.velocity) < 8.0 and s.engine_damage > 0.3)
    # Throttle closed, slowed on the water: the clutch goes back to the screw for another try.
    loop i in 0..60 * 20: fl.step(k, s, fl.Controls(throttle = 0.0, water_brake = 1.0), e, 1.0 / 60.0)
    assert(s.foil.clutch == 0.0 and s.foil.air == 0.0)

# The blade's tip at the top, seen from the cockpit (looking ahead, -z; right is +x): a right-hand
# prop's moves right (clockwise), a left-hand one's left. Its disc is drawn mirrored to match.
_tip_motion = (m: planes.CraftModel, i: int) -> f64:
    f0 = planes.prop_frame(m, i, 0.0); f1 = planes.prop_frame(m, i, 0.1)
    f64((f1 * vec4(0, 1, 0, 1)).x - (f0 * vec4(0, 1, 0, 1)).x)

test "the presentation turns each prop its own way and the discs follow":
    mc = planes.build_craft(.macchi_mc72, planes.LIVERIES[1])
    # the M.C.72's front rotor right-hand, the one behind it the other way
    assert(_tip_motion(mc, 0) > 0.0 and _tip_motion(mc, 1) < 0.0)
    assert(planes.prop_turn(mc, 0) == -1.0 and planes.prop_turn(mc, 1) == 1.0)
    s65 = planes.build_craft(.sm_s65, planes.LIVERIES[1])
    assert(_tip_motion(s65, 0) > 0.0 and _tip_motion(s65, 1) < 0.0)

# Each aircraft's drawn propeller turns in its profile's hand, and the torque (the trial, or a
# Schneider racer's own swing, always to port) rolls against what is seen.
test "every aircraft's prop is drawn turning in its own hand and its torque rolls against it":
    loop id in 0..planes.CRAFT_NAMES.len():
        kind = planes.Craft(id); p = planes.aircraft_profile(kind)
        m = planes.build_craft(kind, planes.LIVERIES[planes.DEFAULT_LIVERIES[id]])
        k = fl.craft_spec(kind, m.contacts)
        hand = if p.prop_hand < 0.0: -1.0 else: 1.0
        assert(m.prop_hand == hand and k.prop_hand == hand)
        # (the main hub turns in the aircraft's hand: right-hand clockwise from the cockpit)
        assert(_tip_motion(m, 0) * hand > 0.0 and planes.prop_turn(m, 0) == -hand)
        if p.swing > 0.0: assert(hand == 1.0)          # (its swing rolls her to port)
        s = fl.CraftState(throttle = 1.0, fuel = 10.0)
        torque = fl.prop_torque(k, s)
        if k.torque_share > 0.0: assert(torque * hand > 0.0)   # (+ is to port: against a right-hand prop)
        else: assert(torque == 0.0)
        print("{planes.CRAFT_NAMES[id]}: {if hand > 0: "right" else: "left"}-hand, torque {torque:.0} N m")

# The P.7's air propeller as drawn: before the clutch, dragged round by the engine through its
# feathered blades, whirling as fast as solid blades can read (faster with the throttle), its disc
# and arcs held back; a blade in the sea drags a little and never hurts the engine. From the moment
# the clutch goes over, out of the sea, the engine's full turn: the disc and its arcs at once.
test "the P.7's propeller whirls in solid blades until the clutch, then spins at once to its full turn":
    fl.set_speed_scale(1.0)
    m = planes.build_craft(.piaggio_p7, planes.LIVERIES[1])
    k = fl.craft_spec(.piaggio_p7, m.contacts)
    e = fl.FlightEnv()
    s = fl.water_start(k, vec3(0, 0, 0)); plan = fl.FlightPlan()
    wet_turning = 0; clutch_at = -1.0; fastest_solid = 0.0; first_disc = -1.0; last = -1.0
    loop i in 0..60 * 40:
        fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
        w = fb.prop_rotation_speed(s, 0.0); dw = fb.prop_disc_speed(s, 0.0)
        engine = 8.0 + 70.0 * s.throttle
        if not s.foil.engaged:
            # declutched: whirling solid blades (never blurred), no disc, no harm to the engine
            assert(w > 0.0 and not disc.prop_disc_blurred(w) and dw < disc.PROP_DISC_FROM)
            fastest_solid = max(fastest_solid, w)
            assert(s.engine_damage == 0.0)
            if s.foil.prop_wet: wet_turning += 1
        else:
            # clutched: the engine's own turn, drawn as it is, the disc with it
            if clutch_at < 0.0: clutch_at = s.time; first_disc = dw
            assert(abs(w - engine) < 0.001 and dw == w)
        last = w
        if not s.on_water and s.position.y > k.float_height + 10: break
    print("P.7 prop: whirling to {fastest_solid:.1} rad/s before the clutch ({wet_turning} steps in the sea), clutch at {clutch_at:.2}s with the disc at once at {first_disc:.1} rad/s, now {last:.1}")
    # (flat out on the screw, at the top of the solid blades' speeds: about 300 rpm)
    assert(fastest_solid > 25.0 and fastest_solid < disc.PROP_BLADES_BELOW)
    assert(wet_turning > 60 and clutch_at > 0.0 and not s.on_water)
    # (the stylised disc and arcs from the clutch's first moment: past the blades' speeds)
    assert(disc.prop_disc_blurred(first_disc))
    # Every other aircraft's propeller turns, and its disc is drawn, exactly as before.
    g = fl.CraftState(throttle = 0.6, fuel = 10.0)
    assert(fb.prop_rotation_speed(g, 0.0) == 8.0 + 70.0 * 0.6 and fb.prop_disc_speed(g, 0.0) == 8.0 + 70.0 * 0.6)

# The auto clutch goes over as soon as the foils have held the hull and the air propeller clear of
# the water for a moment, fast enough for them to carry her: no settled foil phase first.
test "the P.7's clutch goes over as soon as her propeller is clear of the water":
    d = foil.water_drive()
    t = 0.0
    loop i in 0..60:
        foil.clutch_step(d, 1.0 / 60.0, false, true, 0.5, 12.0, 1.0, false)
        if d.engaged and t == 0.0: t = f64(i + 1) / 60.0
    assert(d.engaged and abs(t - foil.PROP_CLEAR_TIME) < 0.02)
    # a moment's clearance (a passing crest) is not enough: the clock starts again each dip
    d = foil.water_drive()
    loop i in 0..120:
        foil.clutch_step(d, 1.0 / 60.0, false, true, if i % 30 != 0: 0.5 else: 0.05, 12.0, 1.0, false)
    assert(not d.engaged)
    # nor with the hull still in the water, nor too slow for the foils to carry her, nor at low throttle
    loop case in 0..3:
        d = foil.water_drive()
        loop i in 0..300:
            foil.clutch_step(d, 1.0 / 60.0, false, case != 0, 0.5, if case == 1: 9.0 else: 12.0, if case == 2: 0.3 else: 1.0, false)
        assert(not d.engaged)

test "the P.7 knows when her engine is too worn to lift her":
    # (power is 0.3 + 0.7 x the engine's health; she needs FOIL_MIN_POWER)
    assert(not foil.foil_power_short(1.0) and not foil.foil_power_short(0.6))
    assert(foil.foil_power_short(0.55) and foil.foil_power_short(0.0))

# Fallen off her foils into the sea with the air propeller clutched in and in the water: the screw is
# clutched back in by itself (at any throttle), so she climbs up and tries again, never stopped dead.
test "the P.7 falls back to her water screw when she drops off her foils with the propeller in the sea":
    d = foil.FoilDrive()
    assert(d.engaged and d.clutch == 1.0)
    t = 0.0
    loop i in 0..120:
        foil.clutch_step(d, 1.0 / 60.0, false, false, -0.3, 8.0, 1.0, false)
        if not d.engaged and t == 0.0: t = f64(i + 1) / 60.0
    assert(not d.engaged and abs(t - foil.FALLEN_TIME) < 0.02 and d.clutch < 1.0)
    # a crest touching a blade for a moment, on her foils, is not a fall
    d = foil.FoilDrive()
    loop i in 0..120:
        foil.clutch_step(d, 1.0 / 60.0, false, true, if i % 40 < 10: -0.05 else: 0.3, 20.0, 1.0, false)
    assert(d.engaged)

# Off the open sea, in the game's own swell (src/sea.jo swell_at, the wind raising it): the
# production take-off, hands off and as her hint says (stick back on the foils), from calm to a
# moderate sea, at the player's speed scale.
_sea_takeoff = (wind: f64, back: bool) -> fl.CraftState:
    fl.set_speed_scale(3.3)
    look.wind_now = look.Wind(dir = vec2(0.8, 0.6), speed = wind)
    m = planes.build_craft(.piaggio_p7, planes.LIVERIES[1])
    k = fl.craft_spec(.piaggio_p7, m.contacts); k.player = true
    s = fl.water_start(k, vec3(0, 0, 0), 0.0)
    plan = fl.FlightPlan(target = vec3(0, 0, -40000), taxi_target = vec3(0, 0, -40100))
    t = 0.0
    loop i in 0..60 * 75:
        tt = t
        e = fl.FlightEnv(wind = vec3(0.8, 0, 0.6) * f32(wind * 0.7), swell = (x: f64, z: f64) -> vec3: sea.swell_at(x, z, tt), has_swell = true, swell_ceiling = sea.swell_height_bound())
        c = fl.autopilot(k, s, plan, e)
        if back and s.foil.air >= 1.0 and s.on_water: c.pitch = max(c.pitch, 0.5)
        fl.step(k, s, c, e, 1.0 / 60.0)
        t += 1.0 / 60.0
        if not s.on_water and s.position.y > k.float_height + 8: break
    fl.set_speed_scale(1.0)
    look.wind_now = look.Wind()
    s

test "the P.7 takes off from the open sea in calm and in a moderate swell":
    loop wind in [0.0, 3.0, 5.0]:
        loop back in [false, true]:
            s = _sea_takeoff(wind, back)
            print("P.7 sea take-off, wind {wind} (swell to {(0.003 + 0.0011 * wind) * 145.4 * (if wind > 0.0: 1.0 else: 0.0):.2} m), {if back: "stick back" else: "hands off"}: airborne {not s.on_water} at {s.time:.1}s, engine {s.engine_damage:.3}, hull {s.hull_damage:.3}")
            assert(not s.on_water and not s.crashed and s.time < 60.0 and s.engine_damage < 0.15 and s.hull_damage < 0.05)
