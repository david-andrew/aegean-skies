import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as pl
import '../tools/stalllab.jo' as lab
import '../tools/stallinertia.jo' as audit

_begin = ():
    fl.set_speed_scale(3.3)
    tw.set_tweaks(tw.Tweaks(chaotic_stalls = true))
_end = ():
    fl.set_speed_scale(1.0)
    tw.set_tweaks(tw.Tweaks())

test "trial nose drop overshoots airflow and swings back without pilot input":
    _begin()
    loop kind in [pl.Craft.gull, pl.Craft.falco, pl.Craft.tern, pl.Craft.corsair]:
        k = lab.stall_spec(kind); s = audit.inertia_start(k, 0)
        low = 0.0; returned = false
        loop i in 0..120 * 10:
            fl.step(k, s, fl.Controls(assist = 0), fl.FlightEnv(), 1.0 / 120.0)
            alpha = audit.flow_angle(s)
            low = min(low, alpha)
            if low < -0.04 and alpha > 0.005: returned = true
        print("nose {kind}: overshoot={-low * 180.0 / PI:.3}deg return={returned}")
        assert(low < -0.04 and returned and not s.crashed)
    _end()

test "trial wing drop overshoots the attitude where its initial rotation decelerates":
    _begin()
    loop kind in [pl.Craft.gull, pl.Craft.falco, pl.Craft.tern, pl.Craft.corsair]:
        k = lab.stall_spec(kind); s = audit.inertia_start(k, 1)
        settling = false; coasting = 0.0; reversed = false
        loop i in 0..120 * 6:
            q = s.orientation
            fl.step(k, s, fl.Controls(assist = 0), fl.FlightEnv(), 1.0 / 120.0)
            actual = audit.observed_rate(q, s.orientation, 1.0 / 120.0)
            if not settling and s.angular_velocity.z > -0.45: settling = true
            if settling and not reversed: coasting -= f64(actual.z) / 120.0
            if settling and s.angular_velocity.z > 0.03: reversed = true
        print("wing {kind}: coasts {coasting * 180.0 / PI:.3}deg after half-rate, reverses={reversed}")
        assert(settling and coasting > PI / 36.0 and not s.crashed)
    _end()

test "enabled trial has no sustained whole attitude plateau in departure fixtures":
    _begin()
    samples = 0; worst_error = 0.0; longest = 0.0; longest_pitch_cancellation = 0.0
    loop kind in [pl.Craft.gull, pl.Craft.falco, pl.Craft.tern, pl.Craft.pelican, pl.Craft.corsair]:
        k = lab.stall_spec(kind)
        loop scenario in [2, 3, 4]:
            s = audit.inertia_start(k, scenario)
            plateau = 0.0; pitch_cancellation = 0.0
            loop i in 0..120 * 8:
                q = s.orientation
                fl.step(k, s, audit.inertia_controls(scenario), fl.FlightEnv(), 1.0 / 120.0)
                # Do not confuse an Euler coordinate turning point with an attitude lock.
                # The liked trial still has direct bank/trim/gust corrections. Those can cancel
                # ONE body-rate component briefly; exact momentum/pose equality is not its contract.
                if not s.stalled or s.position.y < k.float_height + k.span * 3.0:
                    plateau = 0.0; pitch_cancellation = 0.0
                    continue
                actual = audit.observed_rate(q, s.orientation, 1.0 / 120.0)
                worst_error = max(worst_error, f64(length(actual - s.angular_velocity))); samples += 1
                if length(s.angular_velocity) > 0.1 and length(actual) < 0.03: plateau += 1.0 / 120.0
                else: plateau = 0.0
                longest = max(longest, plateau)
                if abs(f64(s.angular_velocity.x)) > 0.08 and abs(f64(actual.x)) < 0.02: pitch_cancellation += 1.0 / 120.0
                else: pitch_cancellation = 0.0
                longest_pitch_cancellation = max(longest_pitch_cancellation, pitch_cancellation)
    print("trial audit: {samples} stalled substeps, whole-attitude plateau={longest:.4}s, pitch-only cancellation={longest_pitch_cancellation:.4}s, rate discrepancy={worst_error:.6}rad/s")
    # A sustained lock is a vector rate below 0.03 rad/s for >=0.1s while stored rate >0.1.
    # This intentionally does not claim that every axis matches the angular-velocity state.
    assert(samples > 5000 and longest < 0.1)
    _end()
