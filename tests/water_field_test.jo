use '../src/water_types.jo'
use '../src/water_field.jo'
use '../src/river_field.jo'
use '../src/river_data.jo'
use '../src/lake_field.jo'

test "unified water preserves river identity and ocean fallback":
    node=RIVER_NODES[85]
    river=river_at(f64(node.x),f64(node.y))
    water=water_at(f64(node.x),f64(node.y))
    assert(water==river and water.wet and water.kind==.river and water.id==1)
    assert(water_current(f64(node.x),f64(node.y))==river.current)
    ocean=water_at(0,0)
    assert(ocean.kind==.ocean and ocean.id==0 and ocean.level==0 and not ocean.found)
    assert(not lake_at(0,0).found and lake_key()!=u64(0))
    assert(lake_carve(20,30,80)==80)

test "covered lake water wins over a dry river corridor without losing height current or identity":
    river=WaterSample(found=true,level=15,width=30,kind=.river,id=1)
    lake=WaterSample(found=true,wet=true,level=120,current=vec3(0.2,0,0.1),width=250,kind=.lake,id=100001)
    assert(water_resolve(river,lake)==lake)
    river.wet=true
    assert(water_resolve(river,lake)==lake)
    lake.wet=false
    assert(water_resolve(river,lake)==river)
