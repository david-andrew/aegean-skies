use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_war_types.jo'
use '../src/living_war.jo'
use '../src/living_war_contacts.jo'
use '../src/living_missions.jo'
use '../src/living_commissions.jo'
use '../src/living_far_news.jo'
use '../src/living_save.jo'
use '../src/war_view.jo'
use 'living_commissions.jo'

_war_fixture = () -> World:
    w=commission_fixture(); w.far.links[0].mode=.ship; w.far.vehicles[0].kind=.ship
    assert(war_charter(w,0,1)==0 and war_charter(w,1,2)==1)
    war_supply(w,0); war_supply(w,1)
    relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    far_local_news(w,100,"war_declared","A received declaration.",country=1,other_country=2,severity=1000)
    far_local_news(w,200,"war_declared","A received declaration.",country=2,other_country=1,severity=1000)
    w

test "a battle account gives back its name and where it was fought":
    text="Battle for Port 200: A Kalyra charter defeated a Orenthia unit near 1234, -567."
    assert(battle_report_name(text)=="Battle for Port 200")
    p=battle_report_pos(text); assert(p!=none and p!.x==1234 and p!.z==-567)
    assert(battle_report_name("A Kalyra charter defeated a Orenthia unit near 5, 6.")==none)
    assert(battle_report_pos("No place given.")==none)

test "a named battle in sight shows its card once and an unnamed clash shows none":
    w=_war_fixture(); assert(issue_war_order(w,0,.occupy,200)>=0)
    begin_war_contacts(w)
    c=w.war.contacts[0]; w.war.contacts[0].state=.physical
    before=canonical_text(w)
    card=BattleCard(); memory=PresentationState()
    assert(not battle_card_step(card,memory,w,c.pos+vec3(20000,0,0),0.0))   # out of sight
    assert(battle_card_step(card,memory,w,c.pos,1.0) and card.name==c.name! and card.line.contains("1929"))
    assert(not battle_card_step(card,memory,w,c.pos,20.0))                 # once per battle
    assert(memory.battles_seen.len()==1 and canonical_text(w)==before)     # reading changes nothing
    w=_war_fixture(); begin_war_contacts(w); w.war.contacts[0].state=.physical
    card=BattleCard(); memory=PresentationState()
    assert(w.war.contacts[0].name==none and not battle_card_step(card,memory,w,w.war.contacts[0].pos,1.0))

test "the chart's war layer shows what the player has heard, not the world's truth":
    w=_war_fixture(); actor=w.player
    w.people[actor].pose.pos=vec3(50000,0,50000)
    w.far.districts[200].controller=1                               # true, but unreported
    d=war_chart_data(w,actor,[])
    loop m in d.marks: assert(m.kind!="held")
    r=far_news_snapshot(w.far.news[far_local_news(w,200,"occupation","A supplied Kalyra force arrived at Port 200.",country=1,severity=1000)],w.minute)
    assert(far_receive_report(w,actor,r))
    held=0
    loop m in war_chart_data(w,actor,[]).marks:
        if m.kind=="held" and m.country==1: held+=1
    assert(held==1)

test "an office's military contract is a board notice that can be declined and accepted at the counter":
    w=commission_fixture(); actor=w.player
    id=post_mission(w,1,.reconnaissance,100,100,200,2400)
    assert(id>=0)
    clock=(m: int) -> str: "{m}"
    notices=military_notices(w,100,actor,{},clock)
    assert(notices.len()==1 and mission_of_notice(notices[0].id)==id and notices[0].pay==24)
    assert(military_notices(w,100,actor,{id: true},clock).len()==0)
    assert(mission_of_notice(-1)== -1)
    w.people[actor].pose.pos=vec3(50000,0,50000)
    _ = contract_act(w,id,0,actor); assert(w.war.missions[id].state==.open)   # away from the counter
    w.people[actor].pose.pos=far_counter(w,100)
    _ = contract_act(w,id,0,actor); assert(w.war.missions[id].state==.claimed and w.war.missions[id].carrier==actor)
    m=find_mission(w,id)!
    words=contract_answers(w,m,actor); assert(words.1==[2,6])

test "battle cards shown and battles seen survive a save and reload while the battle goes on":
    assert(env("SLOPPY_SAVE_DIR") != none)
    w=_war_fixture(); assert(issue_war_order(w,0,.occupy,200)>=0)
    begin_war_contacts(w)
    c=w.war.contacts[0]
    memory=PresentationState(); card=BattleCard()
    w.war.contacts[0].state=.physical
    assert(battle_card_step(card,memory,w,c.pos,1.0))
    w.war.contacts[0].state=.pending                 # (the save asks a fought contact to be checkpointed)
    prefix="war-view-cards"
    delete_data(prefix+"-a"); delete_data(prefix+"-b"); delete_data(prefix+"-a-data"); delete_data(prefix+"-b-data")
    assert(save_game(w,memory,123,prefix) is int)
    loaded=load_game(123,prefix)
    assert(loaded is SaveGame)
    restored=loaded.presentation
    assert(c.engagement in restored.battle_cards and restored.battles_seen.len()==1 and restored.battles_seen[0].name==c.name!)
    w2=loaded.world; w2.war.contacts[0].state=.physical
    again=BattleCard()
    assert(not battle_card_step(again,restored,w2,c.pos,1.0))   # no second card after the reload
    # A battle that is over drops out of the saved cards; the chart keeps its sighting.
    w.war.contacts.clear()
    assert(save_game(w,memory,123,prefix) is int)
    later=load_game(123,prefix)
    assert(later is SaveGame and later.presentation.battle_cards.len()==0 and later.presentation.battles_seen.len()==1)
    # An older save without these fields reads as nothing seen or declined.
    old=from_text[PresentationState]("PresentationState(last_hail_tick=3)")
    assert(old is PresentationState and old.battle_cards.len()==0 and old.battles_seen.len()==0 and old.declined_missions.len()==0)
    delete_data(prefix+"-a"); delete_data(prefix+"-b"); delete_data(prefix+"-a-data"); delete_data(prefix+"-b-data")

test "a declined contract stays off the board after a save and reload while the office offers it":
    assert(env("SLOPPY_SAVE_DIR") != none)
    w=commission_fixture(); actor=w.player
    id=post_mission(w,1,.reconnaissance,100,100,200,2400); assert(id>=0)
    clock=(m: int) -> str: "{m}"
    memory=PresentationState(); memory.declined_missions[id]=true
    prefix="war-view-declined"
    delete_data(prefix+"-a"); delete_data(prefix+"-b"); delete_data(prefix+"-a-data"); delete_data(prefix+"-b-data")
    assert(save_game(w,memory,123,prefix) is int)
    loaded=load_game(123,prefix); assert(loaded is SaveGame)
    assert(military_notices(loaded.world,100,actor,loaded.presentation.declined_missions,clock).len()==0)
    # Once the office no longer offers it, the saved refusal is dropped.
    w.war.missions[id].state=.expired
    assert(save_game(w,memory,123,prefix) is int)
    later=load_game(123,prefix); assert(later is SaveGame and later.presentation.declined_missions.len()==0)
    delete_data(prefix+"-a"); delete_data(prefix+"-b"); delete_data(prefix+"-a-data"); delete_data(prefix+"-b-data")

test "a claimed dispatch says where its packet is to be collected and where it goes":
    w=commission_fixture(); actor=w.player
    event=far_local_news(w,100,"orders","The frontier patrol requested its orders.",country=1,severity=400)
    id=post_mission(w,1,.mail,100,200,event,1800); assert(id>=0)
    parcel=w.war.missions[id].commission
    assert(packet_mark(w,find_mission(w,id)!)==none)                 # not the player's yet
    w.people[actor].pose.pos=far_counter(w,100)
    _ = contract_act(w,id,0,actor)
    m=find_mission(w,id)!; k=packet_mark(w,m)!
    assert(k.pos==w.far.commissions[parcel].pos and k.line.contains(w.place_contexts[100].name) and contract_status(w,m).contains("waits at the"))
    assert(packet_marks(w,actor,vec3(0,0,0)).len()==1)
    assert(pickup_far_commission(w,parcel,actor))
    k=packet_mark(w,find_mission(w,id)!)!
    assert(k.pos==far_counter(w,200) and k.label.contains(w.place_contexts[200].name))
