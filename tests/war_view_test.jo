use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_war_types.jo'
use '../src/living_war.jo'
use '../src/living_war_contacts.jo'
use '../src/living_missions.jo'
use '../src/living_commissions.jo'
use '../src/living_far_news.jo'
use '../src/living_save.jo'
use '../src/war_view.jo'
use 'living_commissions.jo'

_war_fixture = () -> World:
    w=commission_fixture(); w.far.links[0].mode=.ship; w.far.vehicles[0].kind=.ship
    assert(war_charter(w,0,1)==0 and war_charter(w,1,2)==1)
    war_supply(w,0); war_supply(w,1)
    relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    far_local_news(w,100,"war_declared","A received declaration.",country=1,other_country=2,severity=1000)
    far_local_news(w,200,"war_declared","A received declaration.",country=2,other_country=1,severity=1000)
    w

test "a battle account gives back its name and where it was fought":
    text="Battle for Port 200: A Kalyra charter defeated a Orenthia unit near 1234, -567."
    assert(battle_report_name(text)=="Battle for Port 200")
    p=battle_report_pos(text); assert(p!=none and p!.x==1234 and p!.z==-567)
    assert(battle_report_name("A Kalyra charter defeated a Orenthia unit near 5, 6.")==none)
    assert(battle_report_pos("No place given.")==none)

test "a named battle in sight shows its card once and an unnamed clash shows none":
    w=_war_fixture(); assert(issue_war_order(w,0,.occupy,200)>=0)
    begin_war_contacts(w)
    c=w.war.contacts[0]; w.war.contacts[0].state=.physical
    before=canonical_text(w)
    card=BattleCard()
    assert(not battle_card_step(card,w,c.pos+vec3(20000,0,0),0.0))   # out of sight
    assert(battle_card_step(card,w,c.pos,1.0) and card.name==c.name! and card.line.contains("1929"))
    assert(not battle_card_step(card,w,c.pos,20.0))                 # once per battle
    assert(card.seen.len()==1 and canonical_text(w)==before)        # reading changes nothing
    w=_war_fixture(); begin_war_contacts(w); w.war.contacts[0].state=.physical
    card=BattleCard()
    assert(w.war.contacts[0].name==none and not battle_card_step(card,w,w.war.contacts[0].pos,1.0))

test "the chart's war layer shows what the player has heard, not the world's truth":
    w=_war_fixture(); actor=w.player
    w.people[actor].pose.pos=vec3(50000,0,50000)
    w.far.districts[200].controller=1                               # true, but unreported
    d=war_chart_data(w,actor,[])
    loop m in d.marks: assert(m.kind!="held")
    r=far_news_snapshot(w.far.news[far_local_news(w,200,"occupation","A supplied Kalyra force arrived at Port 200.",country=1,severity=1000)],w.minute)
    assert(far_receive_report(w,actor,r))
    held=0
    loop m in war_chart_data(w,actor,[]).marks:
        if m.kind=="held" and m.country==1: held+=1
    assert(held==1)

test "an office's military contract is a board notice that can be declined and accepted at the counter":
    w=commission_fixture(); actor=w.player
    id=post_mission(w,1,.reconnaissance,100,100,200,2400)
    assert(id>=0)
    clock=(m: int) -> str: "{m}"
    notices=military_notices(w,100,actor,{},clock)
    assert(notices.len()==1 and mission_of_notice(notices[0].id)==id and notices[0].pay==24)
    assert(military_notices(w,100,actor,{id: true},clock).len()==0)
    assert(mission_of_notice(-1)== -1)
    w.people[actor].pose.pos=vec3(50000,0,50000)
    _ = contract_act(w,id,0,actor); assert(w.war.missions[id].state==.open)   # away from the counter
    w.people[actor].pose.pos=far_counter(w,100)
    _ = contract_act(w,id,0,actor); assert(w.war.missions[id].state==.claimed and w.war.missions[id].carrier==actor)
    m=find_mission(w,id)!
    words=contract_answers(w,m,actor); assert(words.1==[2,6])
