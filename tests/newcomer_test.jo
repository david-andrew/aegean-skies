# A new pilot's welcome (src/newcomer.jo, World.welcome): the harbour's mechanic kept on the dock
# beside the player's aircraft for the first hour by the living world itself, released after it;
# a saved world from before the welcome never greets; the welcome ends on each of its conditions;
# the words name the controls as this player has them; the radio reads the boards.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/life_types.jo'
use '../src/living_life.jo'
use '../src/living_save.jo'
use '../src/controller.jo'
use '../src/touch.jo'
use '../src/newcomer.jo'
import '../src/radio_content.jo' as broadcast

_world = () -> World:
    w = build_world(u64(3))
    craft = w.people[w.player].craft
    welcome_begin(w, w.minute, w.aircraft[craft].pose.pos + vec3(0, 1.2, 4))
    w

test "the harbour's mechanic waits on the dock by the new pilot's aircraft for the first hour":
    w = _world()
    g = w.welcome.greeter
    assert(not w.welcome.done and g >= 0 and w.people[g].occupation == .mechanic and w.people[g].home == w.people[w.player].home)
    craft = w.people[w.player].craft
    assert(f64(length(w.welcome.at.xz - w.aircraft[craft].pose.pos.xz)) < 8.0)
    # (the living world's own day: on the quay, waiting, and walked there within the hour)
    goal = life_daily_goal(w, g)
    assert(goal.venue == .quay and goal.activity == .wait, "{goal.venue} {goal.activity}")
    advance_minutes(w, 30)
    d = f64(length(w.people[g].pose.pos.xz - w.welcome.at.xz))
    assert(d < 2.0, "the mechanic is {d:.1} m from his place on the dock after half an hour")
    # (an hour in, he is let go to his own day)
    advance_minutes(w, 35)
    assert(not welcome_holds(w, g))
    goal = life_daily_goal(w, g)
    assert(not (goal.venue == .quay and goal.reason.contains("new pilot")))

test "a world saved before the welcome existed never greets":
    assert(WelcomeState().done)
    w = build_world(u64(3))
    text = to_text(w).replace(", welcome=" + to_text(w.welcome), "")
    assert(not text.contains("welcome="))
    back = from_text[World](text)
    assert(back is World)
    if back is World: assert(back.welcome.done and not welcome_holds(back, 4))

test "the welcome ends with the first job, two minutes aloft, a job taken after asking, or Hints off":
    wl = WelcomeState(done = false, greeter = 4)
    assert(not welcome_finished(wl, false, false, true))
    assert(welcome_finished(wl, true, true, true))
    assert(welcome_finished(wl, false, false, false))
    assert(not welcome_finished(wl, false, true, true), "a job taken without asking him: still new")
    wl.talked = true
    assert(welcome_finished(wl, false, true, true))
    wl.talked = false; wl.air_seconds = 119.0
    assert(not welcome_finished(wl, false, false, true))
    wl.air_seconds = 120.0
    assert(welcome_finished(wl, false, false, true))

test "the words name the controls as this player has them":
    c = ControlsConfig()
    assert(throttle_said(.keys, c) == "Shift" and throttle_back_said(.keys, c) == "Z")
    assert(throttle_said(.touch, c) == "the throttle slider")
    pad_name = throttle_said(.controller, c)
    assert(pad_name != "Shift" and pad_name != "", pad_name)
    loop h in [Hands.keys, Hands.controller, Hands.touch]:
        note = join(welcome_note_lines(h, c, true), " ")
        assert(note.contains(throttle_said(h, c).upper()[0..1]) and note.contains("— P."), note)
        if h != .keys: assert(not note.contains("Shift"), note)
        if h == .touch: assert(not note.contains("mouse"), note)
    assert(welcome_flying_words(.touch, c).contains("the throttle slider"))
    assert(welcome_work_words("Sofia wants wine carried across town", "") == "The board by the market, past the hotel. Sofia wants wine carried across town: an easy one, on foot.")

test "the maritime service reads out the work on the boards":
    w = build_world(u64(3))
    advance_minutes(w, 30)
    said = broadcast.radio_work_words(w)
    open = [loop id in w.active_jobs: if w.jobs[id].state == .open: id]
    if open.len() > 0:
        assert(said.contains("harbour office: work posted on the board"), said)
    else: assert(said == "")
