use 'game_session.jo'
use '../src/game_slots.jo'
use '../src/game_session.jo'
use '../src/living_types.jo'
use '../src/living_save.jo'
use '../src/living_save_codec.jo'
use '../src/combat.jo'
use '../src/vessel_types.jo'

empty_slots = () -> GameSlots:
    slots=GameSlots(); init_game_slots(slots)
    loop id in 0..3: assert(delete_game_slot(slots,id) and slots.error=="")
    slots

slot_fixture = (fondness: int = 450) -> SaveGame:
    f=session_fixture(); p=PresentationState(); p.cat_bonds[7]=CatBond(fondness=fondness)
    game=capture_game(f.0,p,f.1,[],f.2,VesselFleet(),Battle(),123,SaveSummary(minute=0,place=0,place_name="Porto Vecchio",player_name="Pilot",mode="walking"))
    assert(game is SaveGame)
    game

test "three separate complete slots list time and place and survive fresh controllers":
    slots=empty_slots()
    loop id in 0..3:
        game=slot_fixture(100+id*100)
        assert(save_game_slot(slots,id,game) and not slots.busy and slots.error=="",slots.error)
    again=GameSlots(); init_game_slots(again)
    views=list_game_slots(again,123)
    assert(views.len()==3)
    loop id in 0..3:
        assert(views[id].exists and views[id].compatible and views[id].summary.place_name=="Porto Vecchio" and views[id].summary.minute==0)
        assert(load_game_slot(again,id,123) and again.error=="",again.error)
        game=take_game_slot(again)
        assert(game!=none and game!.presentation.cat_bonds[7].fondness==100+id*100)
        assert(take_game_slot(again)==none)
    assert(delete_game_slot(again,1) and again.error=="")
    views=list_game_slots(again,123)
    assert(views[0].exists and not views[1].exists and views[2].exists)

test "damaged newest body falls back without moving either other slot":
    slots=empty_slots(); first=slot_fixture(100); second=slot_fixture(200)
    assert(save_game_slot(slots,0,first) and slots.error=="")
    assert(save_game_slot(slots,0,second) and slots.error=="")
    assert(save_game_slot(slots,1,second) and slots.error=="")
    assert(save_data(slot_prefix(0)+"-b-data","broken"))
    assert(load_game_slot(slots,0,123) and slots.error=="",slots.error)
    old=take_game_slot(slots)
    assert(old!=none and old!.presentation.cat_bonds[7].fondness==100)
    assert(save_game_slot(slots,0,second) and slots.error=="",slots.error)
    assert(load_game_slot(slots,1,123) and slots.error=="")
    other=take_game_slot(slots)
    assert(other!=none and other!.presentation.cat_bonds[7].fondness==200)

test "invalid session newest generation also falls back and incompatible terrain stays intact":
    slots=empty_slots(); game=slot_fixture()
    assert(save_game_slot(slots,0,game) and slots.error=="")
    assert(save_game_slot(slots,0,game) and slots.error=="")
    header=slot_header(load_data(slot_prefix(0)+"-b")!)
    header.session_hash+=u64(1)
    assert(save_value(slot_prefix(0)+"-b",header))
    before=load_data(slot_prefix(0)+"-a-data")!
    assert(load_game_slot(slots,0,123) and slots.error=="",slots.error)
    loaded=take_game_slot(slots); assert(loaded!=none and loaded!.generation==1)
    assert(load_game_slot(slots,0,999) and slots.error!="" and take_game_slot(slots)==none)
    game.terrain_key=999
    assert(save_game_slot(slots,0,game) and slots.error!="")
    assert(load_data(slot_prefix(0)+"-a-data")==before)
    assert(not save_game_slot(slots,3,game))

test "unsupported header is retained until explicit deletion":
    slots=empty_slots(); game=slot_fixture()
    assert(save_game_slot(slots,2,game) and slots.error=="")
    header=slot_header(load_data(slot_prefix(2)+"-a")!)
    header.schema=99
    assert(save_value(slot_prefix(2)+"-a",header))
    before=load_data(slot_prefix(2)+"-a-data")!
    assert(save_game_slot(slots,2,game) and slots.error!="")
    assert(load_data(slot_prefix(2)+"-a-data")==before)
    assert(delete_game_slot(slots,2) and slots.error=="")
    assert(save_game_slot(slots,2,game) and slots.error=="")

test "an oversized session never replaces the last readable generation":
    slots=empty_slots();game=slot_fixture()
    assert(save_game_slot(slots,0,game) and slots.error=="")
    header=load_data(slot_prefix(0)+"-a")!
    body=load_data(slot_prefix(0)+"-a-data")!
    failed=save_game(game.world,game.presentation,123,slot_prefix(0),repeat("x",8000001))
    assert(failed is LivingSaveError)
    assert(load_data(slot_prefix(0)+"-a")==header and load_data(slot_prefix(0)+"-a-data")==body)
    assert(load_game_slot(slots,0,123) and slots.error=="",slots.error)
    assert(take_game_slot(slots)!=none)


test "two damaged bodies are retained until the player explicitly deletes the slot":
    slots=empty_slots();game=slot_fixture()
    assert(save_game_slot(slots,0,game) and slots.error=="")
    assert(save_game_slot(slots,0,game) and slots.error=="")
    assert(save_data(slot_prefix(0)+"-a-data","bad-a") and save_data(slot_prefix(0)+"-b-data","bad-b"))
    assert(save_game_slot(slots,0,game) and slots.error!="")
    assert(load_data(slot_prefix(0)+"-a-data")=="bad-a" and load_data(slot_prefix(0)+"-b-data")=="bad-b")
    assert(delete_game_slot(slots,0) and slots.error=="")
    assert(save_game_slot(slots,0,game) and slots.error=="")
