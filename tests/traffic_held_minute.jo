# A world minute spread over frames does not stop the scene: the watched pilots fly on while it is
# in progress (held ticks), and the World takes the ticks it missed once it is over, the same
# trips and arrivals as when every minute is whole.
import '../src/living_world.jo' as living
import '../src/living_scene.jo' as scene
import '../src/traffic.jo' as air
import '../src/planes.jo' as planes

_models = () -> planes.CraftModel[]:
    [planes.build_craft(.gull, planes.LIVERIES[0]), planes.build_craft(.heron, planes.LIVERIES[5]), planes.build_craft(.corsair, planes.LIVERIES[3]), planes.build_craft(.falco, planes.LIVERIES[1]),
    planes.build_craft(.gull, planes.LIVERIES[1]), planes.build_craft(.gull, planes.LIVERIES[2]), planes.build_craft(.heron, planes.LIVERIES[4]), planes.build_craft(.gull, planes.LIVERIES[4]),
    planes.build_craft(.heron, planes.LIVERIES[2]), planes.build_craft(.gull, planes.LIVERIES[5]), planes.build_craft(.falco, planes.LIVERIES[3]), planes.build_craft(.corsair, planes.LIVERIES[4])]

test "scene pilots fly through a held world minute and the World catches up after it":
    # (no time for the minute in a frame: one of its units a frame, so each minute holds for many)
    scene.set_scene_minute_budget(0.0)
    defer scene.set_scene_minute_budget(-1.0)
    w = living.build_world(); models = _models()
    traffic = air.make_living_traffic(w, models)
    adapter = scene.SceneAdapter(observer = w.harbors[0].center)
    observer = w.harbors[0].center
    frames = 60 * 600
    held_frames = 0
    moved_while_held = 0
    loop k in 0..frames:
        was_held = adapter.holding
        before = [loop tr in traffic: tr.state.position]
        tick_before = w.tick
        air.update_traffic(traffic, w, adapter, observer, f64(k) / 60.0, 1.0 / 60.0)
        if was_held and adapter.holding:
            held_frames += 1
            # (the World's clock waits; the bodies in the scene do not)
            assert(w.tick == tick_before)
            loop i in 0..traffic.len():
                if traffic[i].materialized and length(traffic[i].state.position - before[i]) > 0.01: moved_while_held += 1
        if k % (60 * 10) == 0:
            errors = living.invariant_errors(w)
            if errors.len() > 0: print(errors)
            assert(errors.len() == 0)
    print("held frames {held_frames}, bodies moved in them {moved_while_held}, world tick {w.tick} of {frames}, held ticks {adapter.held_ticks}")
    assert(held_frames > 1000 and moved_while_held > 0)
    # Every frame's tick reaches the World, but for those of a minute still in progress.
    assert(w.tick + adapter.held_ticks == frames)
    assert(w.trips[0].state == .arrived and w.jobs[0].paid_cents > 0)
    assert(living.invariant_errors(w).len() == 0)
