test "a counter orders enough for its newly purchased wagons without inventing supplier stock":
    w=wholesale_fixture(fork=true,city_population=4000)
    finish_order_leg(w,1); finish_order_leg(w,1)
    finish_order_leg(w,0); finish_order_leg(w,0)
    # The first real supplier load uses its last wholesale grain. Its remaining
    # household reserve is not a claim that another load already exists.
    reserve=counter_sale_reserve(w,100,3)
    full=w.far.vehicles[0].capacity_grams*1000/w.goods[3].package_grams
    used=far_take_market(w,100,3,far_market_qty(w,100,3)-reserve-full); far_use(w,used)
    assert(far_depart(w,0)); j=w.far.journeys[w.far.vehicles[0].journey]
    assert(j.quantity==full)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    v=w.far.vehicles[0]
    assert(v.cart_assets.len()==1 and v.cart_assets[0].place==200 and cart_wagons(v)>1)
    q=[loop q in w.far.districts[200].supplier_quotes: if q.link==0: q][0]
    assert(q.available[3]==0 and q.delivered[3]==full)
    request=counter_restock_order(w,0,200)
    assert(request.quantity[3]*w.goods[3].package_grams/1000>=v.capacity_grams)
    assert(request.quantity[3]<=request.target[3]-request.observed[3])
    assert(q.available[3]==0 and goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))

caravan_receipt_fixture = () -> World:
    w=wholesale_fixture()
    finish_order_leg(w,1); finish_order_leg(w,1)
    finish_order_leg(w,0); finish_order_leg(w,0)
    assert(far_depart(w,0))
    assert(w.far.journeys[w.far.vehicles[0].journey].good==3)
    w

test "a full actual grain collection buys owned wagons hires adults and consumes real maintenance parts once":
    w=caravan_receipt_fixture(); id=w.far.vehicles[0].journey
    before=canonical_text(w)
    assert(grow_cart_service(w,id)==0 and canonical_text(w)==before) # still on the road
    population=far_population(w); people=w.people.len(); sources=w.next_cargo_source
    stock=stock_totals(w); purse=w.accounts[w.far.districts[200].household_account].cents
    pool=w.far.districts[200].spare_wagons; workers=w.far.districts[200].workers[1]
    capacity=w.far.vehicles[0].capacity_grams
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    v=w.far.vehicles[0]; units=cart_wagons(v)-1
    assert(units>0 and v.place==200 and v.journey<0 and v.cart_assets.len()==1)
    assert(v.capacity_grams==capacity+units*500000 and v.crew[1]==1+units)
    assert(w.far.districts[200].workers[1]==workers-units and w.far.districts[200].spare_wagons==pool-units)
    assert(w.accounts[w.far.districts[200].household_account].cents==purse+units*5100)
    assert(v.cart_assets[0].owner==w.far.districts[200].market_account and v.cart_assets[0].voyage==id)
    assert(v.cart_assets[0].parts_roots.len()>0 and w.next_cargo_source==sources)
    after=stock_totals(w)
    loop g in 0..9: assert(after[g]==stock[g]-(if g==5: units*500*10 else: 0))
    assert(far_population(w)==population and w.people.len()==people and validate_far(w)=="",validate_far(w))
    assert(money_balances(w) and goods_balance(w))
    text=canonical_text(w); restored=from_text[World](text)
    assert(restored is World and canonical_text(restored)==text)
    assert(grow_cart_service(w,id)==0 and canonical_text(w)==text)

test "an actual delivery cannot finance extra carriage without owned equipment parts funds or available adults":
    loop missing in ["wagons","parts","money","drivers","need"]:
        w=caravan_receipt_fixture(); place=200; d=w.far.districts[place]
        if missing=="wagons":
            w.far.opening_spare_wagons-=d.spare_wagons
            w.far.districts[place].spare_wagons=0
        if missing=="parts":
            batch=far_take_market(w,place,5,far_market_qty(w,place,5)); far_put_market(w,100,batch)
        if missing=="money": assert(transfer(w,d.market_account,d.household_account,w.accounts[d.market_account].cents,.trade))
        if missing=="drivers":
            retired=max(0,d.workers[1]-3)
            w.far.districts[place].workers[1]-=retired; w.far.districts[place].dependents[1]+=retired
        if missing=="need": w.far.districts[place].customer_orders=[]
        stock=stock_totals(w); population=far_population(w)
        w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
        assert(w.far.vehicles[0].cart_assets.len()==0 and w.far.vehicles[0].place==place,missing)
        if missing=="parts": assert(w.far.districts[place].cart_parts_target>1000)
        else: assert(w.far.districts[place].cart_parts_target==0)
        assert(stock_totals(w)==stock and far_population(w)==population and money_balances(w) and goods_balance(w))
        assert(validate_far(w)=="",validate_far(w))

test "staple buying reserves cover the known physical order round trip without creating stock":
    w=far_fixture(); before=stock_totals(w)
    w.far.links[1].length_mm=40000000
    w.far.links[1].points=[vec3(200,0,0),vec3(40200,0,0)]
    w.place_contexts[300].center=vec3(40200,0,0)
    # The relay has a faster road service; the far consumer has only the long sea call.
    assert(staple_cover_days(w,300)==7 and staple_cover_days(w,200)==3)
    order=counter_restock_order(w,1,300)
    assert(counter_own_target(w,300,3)==40*28*7)
    assert(order.target[3]==40*28*(7+5) and order.quantity[3]>0 and stock_totals(w)==before)
    assert(restock_order_valid(w,order))

test "an empty driver's seat cannot move a cart or its existing cargo":
    w=far_fixture(); v=w.far.vehicles[0]
    w.far.districts[100].workers[1]+=v.crew[1]
    w.far.crew_population[1]-=v.crew[1]; w.far.vehicles[0].crew[1]=0
    before=canonical_text(w)
    assert(not far_depart(w,0) and canonical_text(w)==before and validate_far(w)=="")

test "real funded carriage grows across a slow farm relay city chain and meets the later staple meals":
    w=build_world(u64(42)); contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    loop pair in [(100,100),(200,3100),(300,6100)]: contexts.push(LifePlaceContext(pair.0,"Supply {pair.0}",1,pair.0,vec3(f32(pair.1),0,0)))
    assert(publish_place_contexts(w,1,contexts,[-1,300,-1]))
    seeds=[FarPlaceSeed(100,4000,1,3,productivity=80),FarPlaceSeed(200,80,1,0),FarPlaceSeed(300,2000,1,5,productivity=80,raw_ore=10000000)]
    links=[FarLink(0,100,200,.cart,[vec3(100,0,0),vec3(3100,0,0)],3000000),FarLink(1,200,300,.cart,[vec3(3100,0,0),vec3(6100,0,0)],3000000)]
    assert(populate_settlement_economy(w,1,seeds,links))
    missing=0; peak=0
    loop minute in 1..14*1440+1:
        w.minute=minute; w.tick=minute*120
        far_economy_minute(w); far_transport_minute(w)
        peak=max(peak,w.far.districts[300].hunger)
        if minute==11*1440: missing=w.far.districts[300].unmet[3]
        if minute%1440==0:
            assert(goods_balance(w) and money_balances(w) and far_population(w)==w.far.opening_population)
            assert(validate_far(w)=="",validate_far(w))
    print("CARAVAN_CHAIN cargo={w.far.cargo_deliveries} wagons={[loop v in w.far.vehicles: cart_wagons(v)]} late_missing={w.far.districts[300].unmet[3]-missing} hunger={w.far.districts[300].hunger} peak={peak} grain={far_market_qty(w,300,3)}")
    assert(cart_wagons(w.far.vehicles[0])>1 and cart_wagons(w.far.vehicles[1])>1)
    assert(w.far.districts[300].unmet[3]==missing and far_market_qty(w,300,3)>0)
    text=canonical_text(w); copy=from_text[World](text)
    assert(copy is World and canonical_text(copy)==text)

test "a grain-producing wholesale relay can fund actual wagon growth while keeping its farm labor":
    w=build_world(u64(42)); contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k,"Core {k}",0,k,w.harbors[k].center,true,k))
    loop pair in [(100,100),(200,3100),(300,6100)]: contexts.push(LifePlaceContext(pair.0,"Grain chain {pair.0}",1,pair.0,vec3(f32(pair.1),0,0)))
    assert(publish_place_contexts(w,1,contexts,[-1,300,-1]))
    seeds=[FarPlaceSeed(100,6000,1,3,productivity=80),FarPlaceSeed(200,160,1,3,productivity=240),FarPlaceSeed(300,4000,1,5,productivity=80,raw_ore=10000000)]
    links=[FarLink(0,100,200,.cart,[vec3(100,0,0),vec3(3100,0,0)],3000000,road=0),FarLink(1,200,300,.cart,[vec3(3100,0,0),vec3(6100,0,0)],3000000,road=1)]
    assert(populate_settlement_economy(w,1,seeds,links))
    pool=w.far.districts[200].spare_wagons; assert(pool>0)
    missing=0
    loop minute in 1..14*1440+1:
        w.minute=minute; w.tick=minute*120
        far_economy_minute(w); far_transport_minute(w)
        if minute==11*1440: missing=w.far.districts[300].unmet[3]
        if minute%1440==0:
            assert(goods_balance(w) and money_balances(w) and far_population(w)==w.far.opening_population)
            assert(validate_far(w)=="",validate_far(w))
    d=w.far.districts[200]; population=0; workers=0
    loop c in 0..3: population+=d.workers[c]+d.dependents[c]; workers+=d.workers[c]
    print("FARM_RELAY cargo={w.far.cargo_deliveries} wagons={[loop v in w.far.vehicles: cart_wagons(v)]} remaining_teams={d.spare_wagons}/{pool} late_missing={w.far.districts[300].unmet[3]-missing} hunger={w.far.districts[300].hunger} production={workers*d.productivity} own_meals={population*28}")
    assert(cart_wagons(w.far.vehicles[0])>1 and d.spare_wagons<pool)
    assert(workers*d.productivity>=population*28)
    assert(w.far.districts[300].unmet[3]==missing and far_market_qty(w,300,3)>0)
    text=canonical_text(w); restored=from_text[World](text)
    assert(restored is World and canonical_text(restored)==text)

test "an actually paid full grain sale can buy its own local teams before the one departure":
    w=wholesale_fixture(fork=true,seller_teams=true,city_population=4000)
    finish_order_leg(w,1); finish_order_leg(w,1)
    finish_order_leg(w,2); finish_order_leg(w,2)
    finish_order_leg(w,0); finish_order_leg(w,0)
    assert(w.far.vehicles[0].cart_assets.len()==0)
    before=stock_totals(w); people=far_population(w); roots=w.next_cargo_source
    workers=w.far.districts[100].workers[1]; spare=w.far.districts[100].spare_wagons
    signed=w.far.vehicles[0].buying_order!; buyer_cash=w.accounts[signed.account].cents
    assert(far_depart(w,0))
    v=w.far.vehicles[0]; journey=v.journey; added=cart_wagons(v)-1
    assert(added>0 and v.cart_assets.len()==1 and v.cart_assets[0].place==100)
    assert(v.cart_assets[0].owner==w.far.districts[100].market_account and v.cart_assets[0].voyage==journey)
    assert(w.far.districts[100].spare_wagons==spare-added and w.far.districts[100].workers[1]==workers-added)
    assert(v.capacity_grams==500000+added*500000 and v.provisions.qty[3]>0)
    mass=v.cargo.qty[3]*w.goods[3].package_grams/1000
    assert(mass>=v.capacity_grams*4/5 and mass<=v.capacity_grams and mass>500000)
    paid=w.far.journeys[journey]
    assert(paid.quantity==v.cargo.qty[3] and paid.quantity<=signed.quantity[3])
    assert(w.accounts[signed.account].cents==buyer_cash-paid.provenance.goods_cents-signed.freight)
    after=stock_totals(w)
    loop g in 0..9: assert(after[g]==before[g]-(if g==5: added*500*10 else: 0))
    assert(far_population(w)==people and w.next_cargo_source==roots and money_balances(w) and goods_balance(w))
    text=canonical_text(w); assert(grow_paid_cart_sale(w,journey)==0 and canonical_text(w)==text)
    expected_missing=counter_stock_target(w,200,3)-far_market_qty(w,200,3)-v.cargo.qty[3]
    assert(expected_missing*w.goods[3].package_grams/1000>=cart_payload(w,v.id))
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    arrived=w.far.vehicles[0]
    assert(arrived.place==200 and arrived.cart_assets.len()==2)
    assert(arrived.cart_assets[1].place==200 and arrived.cart_assets[1].owner==w.far.districts[200].market_account)
    assert(arrived.cart_assets[1].voyage==journey and arrived.cart_assets[0].voyage==journey)
    assert(arrived.cart_assets[0].owner!=arrived.cart_assets[1].owner)
    text=canonical_text(w)
    assert(grow_cart_service(w,journey)==0 and canonical_text(w)==text)
    assert(money_balances(w) and goods_balance(w) and far_population(w)==people and validate_far(w)=="",validate_far(w))

test "a farming counter keeps enough productive adults for its households when offered carriage work":
    w=caravan_receipt_fixture(); place=200; d=w.far.districts[place]
    population=0
    loop c in 0..3: population+=d.workers[c]+d.dependents[c]
    farming=max(3,(population*28+d.productivity-1)/d.productivity)
    retired=d.workers[1]-farming
    w.far.districts[place].workers[1]-=retired; w.far.districts[place].dependents[1]+=retired
    w.far.districts[place].output=3
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].cart_assets.len()==0 and w.far.districts[place].workers[1]==farming)
    assert(far_population(w)==w.far.opening_population and goods_balance(w) and money_balances(w))

test "an old declared farm equipment pool is never refilled by loading or republishing":
    w=far_fixture(); old=w.far.districts[100].spare_wagons; assert(old>0)
    w.far.districts[100].spare_wagons=0; w.far.opening_spare_wagons-=old
    text=canonical_text(w); loaded=from_text[World](text); assert(loaded is World)
    assert(populate_settlement_economy(loaded,1,[],[]))
    assert(loaded.far.districts[100].spare_wagons==0 and canonical_text(loaded)==text)


test "diagnosing real carriage does not alter transactions RNG or canonical saves":
    plain=caravan_receipt_fixture(); observed=plain
    id=plain.far.vehicles[0].journey
    reset_caravan_audit(); set_caravan_audit(true)
    observed.tick+=6000; observed.minute=observed.tick/120; far_advance_transport(observed,observed.tick)
    set_caravan_audit(false)
    plain.tick+=6000; plain.minute=plain.tick/120; far_advance_transport(plain,plain.tick)
    assert(canonical_text(observed)==canonical_text(plain) and caravan_audit_report().len()>0)


test "teams loading now honor this crossing deadline rather than a hypothetical third crossing":
    w=wholesale_fixture(fork=true,seller_teams=true,city_population=4000)
    finish_order_leg(w,1); finish_order_leg(w,1)
    finish_order_leg(w,2); finish_order_leg(w,2)
    finish_order_leg(w,0); finish_order_leg(w,0)
    v=w.far.vehicles[0]; order=v.buying_order!
    leg=(w.far.links[v.route].length_mm+v.speed_mm_sec*2-1)/(v.speed_mm_sec*2)
    order.due=w.minute+leg+1
    loop g in 0..9: order.good_due[g]=order.due
    loop k in 0..order.extra_lines.len(): order.extra_lines[k].due=order.due
    w.far.vehicles[0].buying_order=order
    assert(far_depart(w,0))
    assert(w.far.vehicles[0].cart_assets.len()==1 and cart_wagons(w.far.vehicles[0])>1)
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="",validate_far(w))
