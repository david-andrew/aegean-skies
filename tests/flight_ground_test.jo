use '../src/flight_ground.jo'
use '../src/world.jo'
use '../src/geography.jo'

test "flight surface cache preserves exact contact heights across land sea seams and eviction":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    loop pass_index in 0..2:
        loop k in 0..16000:
            # Reverse the same sweep after deliberate direct-map evictions.
            i=if pass_index==0:k else:15999-k
            x= -249000.0+f64((i*7919)%498000)+0.125
            z= -199000.0+f64((i*12907)%398000)+0.875
            assert(flight_surface_height(x,z)==surface_height(x,z))
        loop isl in ISLANDS:
            loop k in 0..100:
                x=f64(isl.center.x)+f64(k-50)*53.7
                z=f64(isl.center.y)+f64(k%13-6)*147.3
                assert(flight_surface_height(x,z)==surface_height(x,z))
    assert(flight_ground_vertices.len()==FLIGHT_GROUND_SLOTS)

test "flight surface cache respects geography switches and reload revisions":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    x= -180600.25;z= -140000.5
    old=flight_surface_height(x,z)
    assert(old==surface_height(x,z))
    geography_enabled=false
    assert(flight_surface_height(x,z)==surface_height(x,z))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    assert(flight_surface_height(x,z)==old)
