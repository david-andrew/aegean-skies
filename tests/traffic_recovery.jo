import '../src/living_seed.jo' as seed
import '../src/living_types.jo' as data
import '../src/living_save.jo' as saving
import '../src/flight.jo' as physics
import '../src/traffic.jo' as traffic
use '../src/living_guard.jo'

test "player air brake and debug dive project to valid bounded scene records":
    w = seed.build_world(); c = 0
    w.tick = 1; w.aircraft[c].move_owner = .scene
    before = w.aircraft[c].pose; tank = w.aircraft[c].fuel_ml
    body = physics.CraftState(position=before.pos,velocity=vec3(0,-1700,0),orientation=before.rot,throttle=-0.5,fuel=f64(tank)/1000.0)
    traffic.commit_player_motion(w,body,before,tank,1.0)
    assert(w.aircraft[c].last_scene_tick == 1)
    assert(w.aircraft[c].pose.throttle == 0 and abs(length(w.aircraft[c].pose.vel)-900.0)<0.01)

test "refused player motion is nonfatal atomic and logged in game mode":
    w = seed.build_world(); w.aircraft[0].move_owner = .scene
    w.aircraft[0].last_scene_tick = w.tick # force refusal before any write
    c = w.aircraft[0]; before = saving.canonical_text(w)
    body = physics.CraftState(position=c.pose.pos,velocity=c.pose.vel,orientation=c.pose.rot,fuel=f64(c.fuel_ml)/1000.0)
    set_living_strict(false)
    defer set_living_strict(true)
    traffic.commit_player_motion(w,body,c.pose,c.fuel_ml,1.0)
    assert(saving.canonical_text(w) == before)
    seen = false
    loop fault in living_faults():
        if fault.site == "traffic.player_motion.refused": seen = true; assert("craft=0" in fault.context)
    assert(seen)

test "NPC air brake and refused revisions use the same recovery contract":
    w = seed.build_world(); craft = 1; w.tick = 1; w.aircraft[craft].move_owner = .scene
    c = w.aircraft[craft]
    tr = traffic.Traffic(craft=craft,person=c.owner,name=w.people[c.owner].name,kind=.gull,spec=physics.craft_spec(.gull,[]),state=physics.CraftState(position=c.pose.pos,velocity=vec3(0,0,-1500),orientation=c.pose.rot,throttle=-0.2,fuel=f64(c.fuel_ml)/1000.0))
    traffic.commit_traffic_motion(tr,w,false)
    assert(w.aircraft[craft].pose.throttle == 0 and length(w.aircraft[craft].pose.vel)<901)
    before = saving.canonical_text(w)
    set_living_strict(false)
    defer set_living_strict(true)
    traffic.commit_traffic_motion(tr,w,false)
    assert(saving.canonical_text(w) == before)
