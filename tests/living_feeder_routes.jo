use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_far_types.jo'
use '../src/living_far_catalog.jo'
use '../src/living_feeder_bake.jo'
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/life_scene.jo'
use '../src/far_scene.jo'
use '../src/living_save.jo'
use '../src/inland_connections_data.jo'

test "published feeder tracks are dry wagon-width paths between real disconnected road components":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true; init_settlements(true)
    packed=inflate(embed('../assets/living-routes.bin')); assert(packed!=none)
    catalog=from_text[FarRouteCatalog](str_from_bytes(packed!)); assert(catalog is FarRouteCatalog)
    index: {int: int}; parent: int[]
    ordered=world_settlements; ordered.sort((s: WorldSettlement): s.id)
    loop k in 0..ordered.len(): index[ordered[k].id]=k; parent.push(k)
    # Preexisting road/sea connectivity must not make an invented short-cut necessary.
    loop l in catalog.links:
        if l.trail: continue
        a=feeder_root(parent,index[l.a]); b=feeder_root(parent,index[l.b])
        if a!=b: parent[max(a,b)]=min(a,b)
    before: {int: int}
    loop k in 0..ordered.len():
        r=feeder_root(parent,k); before[r]=before.get(r,0)+1
    count=0
    loop l in catalog.links:
        if not l.trail: continue
        count+=1
        assert(l.mode==.cart and l.road<0 and l.points.len()>=2 and l.points.len()<=4096)
        a=feeder_root(parent,index[l.a]); b=feeder_root(parent,index[l.b])
        # Surveyed access connections (island roads, retained paid services) may close
        # a loop on purpose; only the spanning-tree feeders must join components.
        surveyed=false
        loop c in ACCESS_CONNECTIONS:
            if c.a==l.a and c.b==l.b or c.a==l.b and c.b==l.a:surveyed=true
        assert(surveyed or a!=b,"a feeder must join real disconnected components")
        assert(length(l.points[0]-ordered[index[l.a]].center)<0.1)
        assert(length(l.points[l.points.len()-1]-ordered[index[l.b]].center)<0.1)
        distance=0
        loop k in 1..l.points.len():
            p=l.points[k-1]; q=l.points[k]
            # Surveyed feeders straighten only across segments validated wagon-width
            # and dry (some cross whole plains); feeder_segment_clear below re-samples
            # each one every 3 m, so the station spacing itself is not a constraint.
            assert(feeder_segment_clear(p,q) and feeder_segment_clear(q,p),"unsafe feeder {l.id}, segment {k}")
            assert(abs(f64(q.y)-place_ground(q.xz))<0.05)
            distance+=int(round(f64(length(q-p))*1000.0))
        assert(abs(distance-l.length_mm)<=l.points.len()*2)
        parent[max(a,b)]=min(a,b)
    after: {int: int}
    loop k in 0..ordered.len():
        r=feeder_root(parent,k); after[r]=after.get(r,0)+1
    largest_before=0; largest_after=0
    loop _, n in before: largest_before=max(largest_before,n)
    loop _, n in after: largest_after=max(largest_after,n)
    print("FEEDER NETWORK added={count} largest_before={largest_before} largest_after={largest_after}")
    assert(count>0 and largest_after>largest_before and largest_after>=650)
    w=build_world(u64(42)); publish_settlement_life(w)
    assert(configure_far_economy(w))
    road_count=0; trail_count=0
    loop v in w.far.vehicles:
        l=w.far.links[v.route]
        if l.mode!=.cart: continue
        assert(v.crew[0]+v.crew[1]+v.crew[2]==1)
        if l.trail:
            assert(v.capacity_grams==500000); trail_count+=1
        else:
            assert(l.road>=0 and v.capacity_grams==1500000); road_count+=1
    assert(trail_count>0 and road_count>500)
    # Initialization is idempotent: an existing saved cart is never silently upgraded.
    w.far.vehicles[0].capacity_grams=400000
    saved_text=canonical_text(w)
    assert(configure_far_economy(w) and canonical_text(w)==saved_text)
