use '../src/sound.jo'
use '../src/distant.jo'
use '../src/aircraft_catalog.jo'

test "four engine timbres are finite distinct and shared by distant voices":
    inside = [loop i in 0..4: engine_loop(EngineVoice(i))]
    h = make_hearing()
    assert(h.near.len() == 4 and h.far.len() == 4)
    loop i in 0..4:
        loop s in [inside[i], h.near[i], h.far[i]]:
            peak = 0.0; energy = 0.0
            assert(s.samples.len() == MIX_RATE * 2)
            loop v in s.samples:
                peak = max(peak, abs(f64(v))); energy += f64(v) * f64(v)
                assert(abs(v) < 1.0)
            rms = sqrt(energy / f64(s.samples.len()))
            assert(rms > 0.005 and peak < 1.0)
        loop j in 0..i:
            assert(inside[i].samples != inside[j].samples and h.near[i].samples != h.near[j].samples)
        if let dir = env("AIRCRAFT_SOUND_DIR"):
            assert(save_wav(inside[i], dir + "/" + str(EngineVoice(i)) + "-cockpit.wav"))
            assert(save_wav(h.near[i], dir + "/" + str(EngineVoice(i)) + "-outside.wav"))

test "a distant source changing type replaces its voices without losing its trail":
    h = make_hearing()
    s = EngineSource(7, vec3(0, 40, -100), vec3(0, 0, 10), 0.7, true, 1.0, 50, voice = .rotary)
    hear_engines(h, [s], vec3(0, 0, 0), vec3(0, 0, 0), 0)
    assert(h.heard.len() == 1 and h.heard[0].voice == .rotary and h.heard[0].near_v >= 0)
    s.voice = .twin
    hear_engines(h, [s], vec3(0, 0, 0), vec3(0, 0, 0), 0.1)
    assert(h.heard[0].voice == .twin and h.heard[0].near_v >= 0)
    assert(h.heard[0].trail.len() == 2)
    hush_engines(h)
