use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_purpose.jo'
use '../src/living_far_catalog.jo'

test "visible cultivation preserves the existing economy and excludes original islands":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    packed=inflate(embed('../assets/living-routes.bin'));assert(packed!=none)
    catalog=from_text[FarRouteCatalog](str_from_bytes(packed!));assert(catalog is FarRouteCatalog)
    outputs:{int:int}
    loop seed in catalog.seeds:outputs[seed.id]=seed.output
    loop s in world_settlements:
        if s.id in outputs:assert(settlement_output(s)==outputs[s.id])
        if s.legacy>=0:assert(working_plots(s).len()==0)
        assert(working_landuse(s.center.xz,0,0)==vec4(0,0,0,0))
        assert(working_landuse(s.center.xz,400,0.5)==vec4(0,0,0,0))
