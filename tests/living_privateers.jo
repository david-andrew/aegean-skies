use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_privateers.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_news.jo'
use '../src/living_war.jo'
use '../src/living_war_checks.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

privateer_fixture = () -> World:
    w=commission_fixture()
    loop k in 0..w.far.links.len(): w.far.links[k].mode=.ship
    loop k in 0..w.far.vehicles.len(): w.far.vehicles[k].kind=.ship
    unit=war_charter(w,0,1); assert(unit==0)
    r=war_relation(w,1,2); w.diplomacy[r].stage=.war
    far_local_news(w,100,"war_declared","A declaration arrived.",country=1,other_country=2,severity=1000)
    war_supply(w,unit); assert(issue_marque(w,unit,2))
    w.far.vehicles[0].pos=vec3(190,0,0)
    w.far.vehicles[1].place=300; w.far.vehicles[1].pos=vec3(300,0,0)
    w.far.vehicles[1].next_departure=w.minute
    w.far.districts[200].target[5]+=15000
    assert(far_depart(w,1))
    w

test "a paid privateer takes existing enemy-owned cargo and must bring the same prize home for sale":
    w=privateer_fixture(); stock=stock_totals(w); population=far_population(w); cash=w.ledger.opening_cents
    victim=w.far.vehicles[1]; quantity=w.far.journeys[victim.journey].quantity
    qty=board_merchant(w,0,1)
    assert(qty>0 and w.far.journeys[victim.journey].quantity==quantity-qty)
    assert(w.far.vehicles[0].cargo.qty[5]==qty and w.far.vehicles[0].cargo_owner==w.far.vehicles[0].account)
    assert(board_merchant(w,0,1)==0)
    w.far.vehicles[0].place= -1
    assert(not sell_prize(w,0))
    w.far.vehicles[0].place=100
    assert(sell_prize(w,0) and not sell_prize(w,0))
    assert(w.war.prizes_total==1 and w.war.prizes_sold==1 and far_population(w)==population)
    # Only the three real milli-packages of ammunition used for boarding were consumed.
    after=stock_totals(w); assert(after[8]==stock[8]-30)
    loop g in 0..8: assert(after[g]==stock[g])
    assert(w.ledger.opening_cents==cash and money_balances(w) and goods_balance(w) and validate_war(w)=="")

test "an expired letter or an unarmed privateer cannot board an existing merchant":
    w=privateer_fixture(); original=w.far.vehicles[1].cargo
    # A disarmed raider and an expired letter leave the merchant's roots untouched.
    w.war.units[0].letter_until= -1
    assert(board_merchant(w,0,1)==0 and w.far.vehicles[1].cargo==original)
    w.war.units[0].letter_until=w.minute+60
    ammunition=w.war.units[0].stock.qty[8]
    assert(war_spend(w,0,8,ammunition))
    assert(board_merchant(w,0,1)==0 and w.far.vehicles[1].cargo==original)


test "a real supplied escort near the merchant prevents boarding without copying its cargo":
    w=privateer_fixture(); d=w.far.districts[200]
    account=new_account(w,"escort-test",0)
    assert(transfer(w,d.household_account,account,30000,.rent))
    id=w.far.vehicles.len()
    w.far.districts[200].workers[2]-=3; w.far.crew_population[2]+=3
    w.far.vehicles.push(FarVehicle(id,.ship,200,200,2,account,-1,crew=[0,0,3],route=1,pos=vec3(340,0,0),capacity_grams=30000000,speed_mm_sec=6500))
    escort=war_charter(w,id,2); assert(escort>=0); war_supply(w,escort)
    before=w.far.vehicles[1].cargo
    assert(merchant_protected(w,1,2) and board_merchant(w,0,1)==0)
    assert(w.far.vehicles[1].cargo==before and w.war.prizes_total==0)
    assert(money_balances(w) and goods_balance(w) and far_population(w)==w.far.opening_population)
