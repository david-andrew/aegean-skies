# The wing-strut streamers: on every aircraft each is tied to real structure of its own (a strut
# found in its own triangles), never in mid-air below it; the struts found are the ones laid down.
use '../src/planes.jo'
use '../src/craft_struts.jo'
use '../src/fabric.jo'

# (types with nothing above the water to tie to: the P.7's only struts are its hydrofoil legs)
_NONE = [Craft.piaggio_p7]

_on_segment = (p: vec3, s: StrutPiece) -> f64: f64(length(p - nearest_on_segment(p, s.a, s.b)))

test "struts are found again in the triangles exactly as laid down, crossed bracing apart":
    vs: Vertex3D[]
    pieces = [StrutPiece(vec3(3.4, -0.4, 0.1), vec3(3.36, 1.45, 0.15), 0.05), StrutPiece(vec3(0.5, 0, -1), vec3(2.5, 2, -1), 0.03),
        StrutPiece(vec3(0.5, 2, -1), vec3(2.5, 0, -1), 0.03), StrutPiece(vec3(-3.4, -0.4, 0.1), vec3(-3.36, 1.45, 0.15), 0.05)]
    loop s in pieces:
        from = vs.len()
        d = s.b - s.a
        add_box(vs, vec3(0, 0, 0), vec3(f32(s.r * 2.0), f32(s.r * 2.0), length(d)), rgb(0.3, 0.3, 0.3), translation((s.a + s.b) * 0.5) * facing(d))
        tag_strut(vs, from, s.a, s.b)
    add_box(vs, vec3(0, 1, 0), vec3(4, 0.1, 1), rgb(0.8, 0.8, 0.7))         # (a wing: not a strut)
    found = craft_struts([vs])
    assert(found.len() == pieces.len())
    loop s in pieces:
        hit = false
        loop f in found:
            if f64(length(f.a - s.a)) < 0.001 and f64(length(f.b - s.b)) < 0.001 and abs(f.r - s.r) < 0.001: hit = true
        assert(hit)

test "every aircraft's streamers are tied to its own struts, clear of the water, the same each side":
    loop id in 0..CRAFT_NAMES.len():
        kind = Craft(id)
        m = build_craft(kind, LIVERIES[DEFAULT_LIVERIES[id]])
        print("{CRAFT_NAMES[id]}: {m.struts.len()} struts, streamers at {m.streamers}")
        if kind in _NONE:
            assert(m.streamers.len() == 0)
            continue
        assert(m.streamers.len() == 2)
        water = 1e9
        loop c in m.contacts: water = min(water, f64(c.y))
        loop k in 0..2:
            tie = m.streamers[k]
            assert((f64(tie.x) < 0.0) == (k == 0))
            assert(f64(tie.y) > water + 0.3 and f64(tie.y) <= aircraft_profile(kind).wing_y + 0.3)
            # (on a strut of its own, within its thickness and a few centimetres)
            near = 1e9
            loop s in m.struts:
                if s.r >= 0.02: near = min(near, _on_segment(tie, s) - s.r)
            assert(near < 0.03)
        # (a mirror pair)
        l = m.streamers[0]; r = m.streamers[1]
        assert(f64(length(vec3(-l.x, l.y, l.z) - r)) < 0.05)
        # (and the cloth drawn starts there)
        vs: Vertex3D[]
        cs = cloths_for(m.streamers)
        assert(cs.len() == 2)
        loop c in cs: cloth_vertices(vs, c, c.at, vec3(0, 0, 40), vec3(0, 1, 0), 0.3)
        assert(f64(length(vs[0].pos - m.streamers[0])) < 0.15)

test "the original four keep streamers where they were drawn on their struts":
    gull = build_craft(.gull, LIVERIES[0]).streamers
    assert(f64(length(gull[1] - vec3(3.38, 0.53, 0.12))) < 0.05)
    corsair = build_craft(.corsair, LIVERIES[3]).streamers
    assert(f64(abs(corsair[1].x - 2.9)) < 0.05 and f64(abs(corsair[1].y - 0.46)) < 0.05)
    falco = build_craft(.falco, LIVERIES[1]).streamers
    assert(f64(abs(falco[1].x - 1.1)) < 0.05 and f64(abs(falco[1].y + 1.07)) < 0.05)
