# Natural standing orders must use actual hulls, stores, borders and carried reports.
use '../src/living_types.jo'
use '../src/living_war.jo'
use '../src/living_war_types.jo'
use '../src/living_war_contacts.jo'
use '../src/living_war_checks.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_economy.jo'
use '../src/living_far_news.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_checks.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
use 'living_commissions.jo'

naval_policy_fixture = () -> World:
    w=commission_fixture(); w.far.links[0].mode=.ship; w.far.vehicles[0].kind=.ship
    w

test "standing paid naval policies cause a local warning and battle without a fabricated declaration":
    w=naval_policy_fixture(); population=w.far.opening_population
    step_minute(w)
    assert(w.war.units.len()==2)
    loop u in w.war.units: assert(w.far.vehicles[u.vehicle].kind==.ship)
    loop w.war.warnings.len()==0 and w.minute<360: step_minute(w)
    assert(w.war.warnings.len()==1 and w.war.next_contact==0)
    parsed=from_text[World](canonical_text(w)); assert(parsed is World)
    other=parsed
    loop _ in 0..60: step_minute(w); step_minute(other)
    assert(canonical_text(w)==canonical_text(other))
    assert(w.war.next_contact==1)
    c=w.war.contacts[0]
    assert(c.cause>=0 and c.started>=125 and c.state==.resolved and c.name==none)
    assert(w.diplomacy[war_relation(w,1,2)].stage!=.war)
    assert(far_population(w)==population)
    assert(money_balances(w) and goods_balance(w) and validate_far(w)=="" and validate_war(w)=="")
    print("NATURAL_BORDER minute={w.minute} battle={c.started} cause={c.cause} winner={c.winner}")

test "a warned inspection that withdraws is not attacked and merchants are not warned":
    w=naval_policy_fixture()
    loop w.war.warnings.len()==0 and w.minute<360: step_minute(w)
    assert(w.war.warnings.len()==1)
    warning=w.war.warnings.values()[0]; unit=warning.intruder; u=w.war.units[unit]
    assert(w.war.orders[u.order].station_until>w.minute)
    w.war.orders.remove(u.order); w.war.units[unit].order= -1
    assert(issue_war_order(w,unit,.withdraw,u.home)>=0)
    loop _ in 0..8: step_minute(w)
    assert(w.war.next_contact==0)
    w.far.vehicles[u.vehicle].duty=.merchant
    assert(war_intrusion_cause(w,warning.defender,unit)<0)
    assert(money_balances(w) and goods_balance(w))

test "a council reconsiders received evidence when actual funded forces become ready":
    w=commission_fixture(); a=war_charter(w,0,1); b=war_charter(w,1,2)
    loop _ in 0..3: war_incident(w,200,1,2,"armed_intrusion","A separate actual inspection entered this harbor.")
    war_diplomacy(w)
    relation=war_relation(w,1,2)
    assert(w.diplomacy[relation].stage==.mobilizing and w.diplomacy[relation].incident_news.len()==3)
    war_supply(w,a); war_supply(w,b); war_diplomacy(w)
    assert(w.diplomacy[relation].stage==.war and w.diplomacy[relation].incident_news.len()==3)
    assert(money_balances(w) and goods_balance(w))

test "official dispatch decisions need an actual local signed report and a reachable council":
    w=commission_fixture(); unit=war_charter(w,1,2); war_supply(w,unit)
    # Country2's actual council is inland at300 for this route fixture.
    w.countries[2].capital_id=300
    assert(not war_dispatch_needed(w,unit))
    id=war_incident(w,100,1,2,"armed_intrusion","A distant inspection was witnessed.")
    assert(not war_dispatch_needed(w,unit))
    far_arriving_accounts(w,200,w.far.districts[100].reports)
    assert(war_dispatch_needed(w,unit))
    # Another courier's receipt at the distant council is not knowledge aboard this unit.
    far_arriving_accounts(w,300,w.far.districts[100].reports)
    war_diplomacy(w); assert("2:{id}" in w.war.heard)
    assert(war_dispatch_needed(w,unit))
    war_decisions(w)
    assert(w.war.orders[w.war.units[unit].order].task==.dispatch)
    assert(not (id in w.war.units[unit].dispatch_receipts))
    war_orders(w); assert(w.far.vehicles[1].journey>=0)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[1].place==300)
    war_diplomacy(w); assert("2:{id}" in w.war.heard)
    war_orders(w); assert(id in w.war.units[unit].dispatch_receipts)
    assert(money_balances(w) and goods_balance(w) and validate_war(w)=="")

test "border selection uses charted crossing length rather than catalog order":
    w=naval_policy_fixture()
    # Two genuine outgoing sea lanes; the shorter crossing is later in the registry.
    w.far.links[1].a=100
    w.far.districts[200].links=[0]; w.far.districts[100].links=[0,1]
    w.far.districts[300].born_country=2; w.far.districts[300].controller=2
    w.far.links[0].length_mm=300000; w.far.links[1].length_mm=100000
    assert(war_border_destination(w,100,.ship,1)==300)
    assert(war_border_destination(w,300,.ship,2)==300)
    assert(war_crossing_distance(w,100,.ship,1)==100)

test "local warning maps canonicalize independently of insertion order":
    a=naval_policy_fixture()
    loop a.war.warnings.len()==0 and a.minute<360: step_minute(a)
    assert(a.war.warnings.len()==1)
    first=a.war.warnings.values()[0]
    second=WarWarning(first.intruder,first.defender,first.cause,first.since)
    key="{first.defender}:{first.intruder}:{first.cause}"
    other="{second.defender}:{second.intruder}:{second.cause}"
    b=a; b.war.warnings={}
    a.war.warnings[other]=second
    b.war.warnings[other]=second; b.war.warnings[key]=first
    assert(canonical_text(a)==canonical_text(b) and validate_war(a)=="" and validate_war(b)=="")
