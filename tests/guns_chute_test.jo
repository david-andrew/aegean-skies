use '../src/combat.jo'
use '../src/flight.jo'
use '../src/bailout.jo'
use '../src/combat_sound.jo'
use '../src/descent_view.jo'

fixture = (human: bool = true,choice: int = 0) -> Battle:
    a=Combatant(1,1,0,craft_spec(.corsair,[]),CraftState(position=vec3(0,500,0)),human=human,external=true,
        pilot=CombatPilot(trigger=true),gun=CombatGun(locked=false,choice=choice))
    Battle(enabled=true,actors=[a])

test "player rapid stream restores sustained fire with generous finite ammunition":
    b=fixture()
    loop i in 0..600:
        step_battle(b,FlightEnv(),vec3(0,500,0))
        loop r in b.rounds:assert(r.tracer)
        assert(not b.actors[0].gun.jammed)
    g=b.actors[0].gun
    print("rapid: {g.shots} rounds/10 s, {g.ammo} left, heat {g.heat}")
    assert(g.shots>=109 and g.shots<=111 and g.ammo==PLAYER_AMMUNITION-g.shots)
    # Configuration changes do not replenish ammunition or remove safety.
    configure_player_gun(b.actors[0],1,false)
    assert(b.actors[0].gun.ammo==g.ammo)
    b.actors[0].gun.ammo=1;b.actors[0].gun.cool=0
    loop i in 0..60:step_battle(b,FlightEnv(),vec3(0,500,0))
    assert(b.actors[0].gun.ammo==0 and b.actors[0].gun.shots==g.shots+1)
    configure_player_gun(b.actors[0],0,true)
    loop i in 0..60:step_battle(b,FlightEnv(),vec3(0,500,0))
    assert(b.actors[0].gun.ammo==0 and b.actors[0].gun.shots>g.shots+8)
    shots=b.actors[0].gun.shots
    b.actors[0].gun.locked=true
    loop i in 0..60:step_battle(b,FlightEnv(),vec3(0,500,0))
    assert(b.actors[0].gun.shots==shots)
    b.actors[0].gun.locked=false
    configure_player_gun(b.actors[0],0,false)
    loop i in 0..60:step_battle(b,FlightEnv(),vec3(0,500,0))
    assert(b.actors[0].gun.shots==shots)

test "period choices have distinct cadence and voices while NPC configuration stays unchanged":
    loop choice in 1..4:
        b=fixture(choice=choice);shots=0
        loop i in 0..60:
            step_battle(b,FlightEnv(),vec3(0,500,0))
            loop e in b.events:
                if e.kind==.shot:shots+=1;assert(int(e.strength)==choice-1)
        expected=player_gun_spec(choice).rate
        print("period {choice}: {shots} rounds/second")
        assert(f64(shots)==expected)
        assert(gun_mounts(.corsair,combat_gun_spec(b.actors[0]).mounts).len()==(if choice==1:1 else:2))
    b=fixture(human=false)
    before=to_text(b.actors[0].gun)
    configure_player_gun(b.actors[0],1,true)
    assert(to_text(b.actors[0].gun)==before)
    loop i in 0..60:step_battle(b,FlightEnv(),vec3(0,500,0))
    assert(b.actors[0].gun.shots==12 and b.actors[0].gun.ammo==688)
    b.actors[0].gun.ammo=0;b.actors[0].gun.endless=true
    loop i in 0..60:step_battle(b,FlightEnv(),vec3(0,500,0))
    assert(b.actors[0].gun.shots==12)

test "gun noise variants are finite decaying and distinct without consuming combat randomness":
    loop kind in 0..3:
        previous=gun_report(kind,0)
        loop variant in 0..GUN_VARIANTS:
            s=gun_report(kind,variant);peak=0.0;head=0.0;tail=0.0;difference=0.0
            loop i in 0..s.samples.len()/2:
                x=f64(s.samples[i*2]);assert(x==x and s.samples[i*2]==s.samples[i*2+1])
                peak=max(peak,abs(x))
                if i<MIX_RATE/50:head+=x*x
                if i>=s.samples.len()/2-MIX_RATE/50:tail+=x*x
                difference+=abs(x-f64(previous.samples[i*2]))
            assert(peak>0.75 and peak<0.91 and tail<head*0.01)
            assert(s.samples[0]==0 and abs(f64(s.samples[s.samples.len()-1]))<0.0001)
            if variant>0:assert(difference>1)
            previous=s
    a=fixture();b=a
    loop i in 0..60:
        step_battle(a,FlightEnv(),vec3(0,500,0))
        if i%10==0:assert(gun_report(i%3,i%GUN_VARIANTS).samples.len()>0)
        step_battle(b,FlightEnv(),vec3(0,500,0))
    assert(to_text(a)==to_text(b))

test "bailout tumbles at Sky Barons rate then hangs upright from opening":
    d=Descent(1,1,vec3(0,500,0),vec3(0,0,-70))
    loop i in 0..75:
        d.age=f64(i)/60.0
        up=transform_dir(descent_frame(d),vec3(0,1,0))
        assert(abs(f64(up.y)-cos(f64(i)*0.15))<0.00001)
        assert(abs(f64(up.z)-sin(f64(i)*0.15))<0.00001)
    d.age=1.24
    step_descent(d,vec3(0,0,0),(x:f64,z:f64)->f64:-100.0,0,1.0/60.0)
    assert(d.phase==.canopy)
    assert(length(transform_dir(descent_frame(d),vec3(0,1,0))-vec3(0,1,0))<0.00001)
    d.age+=4
    assert(length(transform_dir(descent_frame(d),vec3(0,1,0))-vec3(0,1,0))<0.00001)

test "descent camera follows the falling pilot independently of somersaults":
    d=Descent(1,1,vec3(0,500,0),vec3(0,-20,-70))
    c=DescentCamera(look=follow_camera(distance=9,pitch=0,height=1.9),eye=vec3(0.7,501.9,9))
    loop i in 0..120:
        d.position+=d.velocity/60.0;d.age+=1.0/60.0
        update_descent_camera(c,d,1.0/60.0,input=false)
        direction=normalize(descent_aim(c)-c.eye)
        assert(length(direction-vec3(0,0,-1))<0.00001)
    assert(abs(f64(c.eye.x)-0.7)<0.001)
    assert(c.eye.z-d.position.z>9 and c.eye.z-d.position.z<15)
    assert(c.eye.y-d.position.y>1.9 and c.eye.y-d.position.y<3.5)
    d.phase=.canopy;d.velocity=vec3(0,0,0)
    loop i in 0..120:update_descent_camera(c,d,1.0/60.0,input=false)
    assert(length(c.eye-d.position-vec3(0.7,2,9))<0.001)


test "endless period guns still overheat and serialize their remaining magazine":
    b=fixture(choice=3)
    configure_player_gun(b.actors[0],3,true)
    b.actors[0].gun.ammo=17
    jammed=false
    loop i in 0..600:
        step_battle(b,FlightEnv(),vec3(0,500,0))
        if b.actors[0].gun.jammed:jammed=true
    assert(jammed and b.actors[0].gun.ammo==17)
    loaded=from_text[Battle](to_text(b))
    assert(loaded is Battle)
    configure_player_gun(loaded.actors[0],0,false)
    assert(loaded.actors[0].gun.ammo==17 and loaded.actors[0].gun.player_loaded)
