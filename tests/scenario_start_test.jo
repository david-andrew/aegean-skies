import 'scenarios_test.jo' as fixture
use '../src/scenarios.jo'
use '../src/scenario_catalog.jo'
use '../src/objects.jo'
use '../src/world.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/tweaks.jo'
import '../src/living_save.jo' as saves
import '../src/living_checks.jo' as checks

test "start of the game reconstructs the seeded quay start with no battle leftovers":
    war=fixture.scenario_fixture()
    towns=[loop st in SETTLEMENTS:build_town(st)];models=build_craft_models()
    set_tweaks(Tweaks())
    a=build_start_game(towns,models);b=build_start_game(towns,models)
    assert(SCENARIOS[0].key=="start" and a.mode==.walking and a.hour==9.5)
    assert(a.world.minute==0 and a.world.seed!=war.world.seed)
    assert(a.world.diplomacy!=war.world.diplomacy and a.world.weather!=war.world.weather)
    assert(a.flyer.kind==.gull and a.flyer.state.moored and a.flyer.spec.player and a.flyer.spec.handling_scale==3.3)
    print("fresh quay={a.position} aircraft={a.flyer.state.position} distance={length(a.position-a.flyer.state.position)} ground={walk_height(towns,a.position.x,a.position.z)}")
    assert(length(a.position-a.flyer.state.position)<30 and abs(f64(a.position.y)-walk_height(towns,a.position.x,a.position.z))<0.0001)
    assert(a.battle.actors.len()==1 and a.battle.rounds.len()==0 and a.battle.engagement== -1)
    assert(saves.canonical_hash(a.world)==saves.canonical_hash(b.world) and a.flyer==b.flyer)
    assert(checks.invariant_errors(a.world).len()==0 and saves.validate_save_world(a.world)=="")
