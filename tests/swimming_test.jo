# Swimming: wading in from a beach until it is deep enough to swim, along the surface with the
# swell, out again where the ground rises (only once one has been in), a dock's edge a wall one
# swims along, a dive off a dock into deep water, and climbing out onto a dock (not a beach).
use '../src/swimming.jo'

# a beach rising along +x: dry above x = 10, the sea deepening to 4 m at x = -20; a dock (a deck
# 1.2 m up) over deep water for z > 30
_ground = (x: f64, z: f64) -> f64:
    if z > 30.0 and x < 0.0: return 1.2
    if z > 30.0: return -3.0
    clamp(x * 0.2, -4.0, 2.0)
_level = (x: f64, z: f64) -> f64: 0.0

test "wade in from the beach, swim once it is deep, and walk out again":
    s = Swim()
    p = vec3(2.0, 0.4, 0.0)
    swim_begin(s, p, vec2(-1, 0), 0, _ground, _level)
    assert(s.active and s.diving < 0.0 and not s.swimming)
    # (the first steps are still on the sand: the swim doesn't end there)
    first = swim_step(s, p, vec2(-0.1, 0), 1.0 / 60.0, false, _ground, _level, _level)
    assert(not first.out)
    swam = false
    loop k in 0..1200:
        st = swim_step(s, p, vec2(-0.015, 0), 1.0 / 60.0, false, _ground, _level, _level)
        assert(not st.out)
        p = st.pos
        if s.swimming:
            swam = true
            assert(abs(f64(p.y) - (0.0 - SWIM_BODY)) < 0.001)
        else: assert(abs(f64(p.y) - _ground(f64(p.x), f64(p.z))) < 0.001)
    assert(swam and f64(p.x) < -6.0 and s.strokes > 3)
    # back the other way: out where the ground rises above the water
    out = false
    loop k in 0..3000:
        st = swim_step(s, p, vec2(0.02, 0), 1.0 / 60.0, false, _ground, _level, _level)
        p = st.pos
        if st.out:
            out = true; break
    assert(out and f64(p.x) > -1.5)

test "a dock's edge is a wall one swims along, and one climbs out onto it (not onto a beach)":
    s = Swim(active = true, wet = true)
    p = vec3(5.0, -0.95, 29.0)
    st = swim_step(s, p, vec2(0, 0), 1.0 / 60.0, false, _ground, _level, _level)
    p = st.pos
    loop k in 0..60:
        st = swim_step(s, p, vec2(-0.1, 0.05), 1.0 / 60.0, false, _ground, _level, _level)
        p = st.pos
    # (never onto the deck from the water)
    assert(_ground(f64(p.x), f64(p.z)) < 0.0)
    near = vec3(0.6, -0.95, 30.6)
    assert(swim_climb_out(near, _ground, _level) != none)
    assert(swim_climb_out(vec3(-3.0, -0.6, 0.0), _ground, _level) == none)

test "a dive off a dock lands swimming in deep water, with a splash":
    s = Swim()
    p = vec3(-1.0, 1.2, 31.0)
    swim_begin(s, p, vec2(1, 0), 0, _ground, _level)
    assert(s.diving == 0.0)
    splash = false
    loop k in 0..90:
        st = swim_step(s, p, vec2(0, 0), 1.0 / 60.0, false, _ground, _level, _level)
        p = st.pos
        if s.splash: splash = true
    assert(s.diving < 0.0 and s.swimming and splash)
    assert(abs(f64(p.x) - 1.6) < 0.01)
