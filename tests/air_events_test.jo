import '../src/living_save.jo' as save

club_fixture = () -> data.World:
    w = seed.build_world(u64(42))
    contexts: LifePlaceContext[]
    loop k in 0..6: contexts.push(LifePlaceContext(k, "Core {k}", 0, k, w.harbors[k].center, true, k))
    contexts.push(LifePlaceContext(100, "Capital", 1, 100, vec3(0, 0, 0)))
    assert(publish_place_contexts(w, 1, contexts, [-1, 100, -1]))
    assert(populate_settlement_economy(w, 1, [FarPlaceSeed(100, 3200, 1, 3)], []))
    assert(publish_far_harbors(w, [FarHarbor(100, vec3(0, 0, -1), [vec3(-70, 0, 0), vec3(70, 0, 0)], [vec3(-70, 2, 10), vec3(70, 2, 10)], vec3(0, 0, -100))]))
    w.people[w.player].pose.pos = vec3(20000, 0, 0); w.aircraft[0].pose.pos = vec3(20000, 0, 0)
    w

test "capital club purchases real aircraft once and preserves race and body state":
    set_speed_scale(1)
    w = club_fixture(); models = build_craft_models(); events = AirEvents()
    opening = w.ledger.external_in_cents
    w.minute = calendar.next_capital_feast_minute(100, 0) - 120; w.tick = w.minute * 120
    before_errors = save.validate_save_world(w)  # Fixture jumps the clock without advancing core jobs.
    prepare_air_events(events, w, models, (x: f64, z: f64) -> f64: -20.0)
    print("club pilots={events.pilots.len()} meets={events.meets.len()}")
    assert(events.pilots.len() == 2 and events.meets.len() == 1)
    assert(w.ledger.external_in_cents == opening and w.aircraft.len() == 10)
    assert(events.meets[0].entries.len() == 2)
    serialized = snapshot_air_events(events, w); restored = from_text[AirEvents](serialized)
    assert(restored is AirEvents and restored == events)
    assert(save.validate_save_world(w) == before_errors)
    world_copy = from_text[data.World](to_text(w))
    assert(world_copy is data.World and world_copy == w)
    assert(enter_player_air_meet(events, w, events.meets[0].id).accepted == false)
    player_craft = w.people[w.player].craft
    w.aircraft[player_craft].pose.pos = events.meets[0].gates[0].center
    w.aircraft[player_craft].hull = 1000; w.aircraft[player_craft].engine = 1000
    wallet = w.people[w.player].account; purse = air_meet_fee_account(w, events.meets[0].capital)
    paid = w.accounts[wallet].cents; held = w.accounts[purse].cents
    admission = enter_player_air_meet(events, w, events.meets[0].id)
    assert(admission.accepted, admission.reason)
    assert(w.accounts[wallet].cents == paid - AIR_MEET_FEE_CENTS and w.accounts[purse].cents == held + AIR_MEET_FEE_CENTS)
    assert(player_air_entry(events.meets[0], w.player) != none)
    assert(not enter_player_air_meet(events, w, events.meets[0].id).accepted)
    assert(withdraw_air_meet(events, events.meets[0].id, player_craft))
    prepare_air_events(events, w, models, (x: f64, z: f64) -> f64: -20.0)
    assert(w.aircraft.len() == 10 and checks.money_balances(w) and checks.goods_balance(w))

test "capital racers taxi take off fly the circuit and return to their reserved moorings":
    loop scale in [1.0, 3.3]:
        set_speed_scale(scale); set_tweaks(Tweaks(chaotic_stalls = true))
        w = club_fixture(); models = build_craft_models(); events = AirEvents()
        w.minute = calendar.next_capital_feast_minute(100, 0) - 120; w.tick = w.minute * 120
        prepare_air_events(events, w, models, (x: f64, z: f64) -> f64: -20.0)
        start = w.tick; airborne = false; returned = false
        loop tick in start + 1..start + 60 * 1500:
            w.tick = tick; w.minute = tick / 120
            update_air_events(events, w, models, vec3(0, 0, 0), ground = (x: f64, z: f64) -> f64: -20.0)
            if tick == start + 12000:
                text = snapshot_air_events(events, w); restored = from_text[AirEvents](text)
                assert(restored is AirEvents and restored == events)
                before = events
                update_air_events(events, w, models, vec3(0, 0, 0), ground = (x: f64, z: f64) -> f64: -20.0)
                assert(before == events, "same tick advanced a club aircraft twice")
            if tick % 3600 == 0:
                loop p in events.pilots: print("club tick={tick-start} craft={p.craft} phase={p.plan.phase} active={p.active} departure={p.departing} wet={p.state.on_water} pos={p.state.position} speed={length(p.state.velocity):.1} fuel={p.state.fuel:.1} damage={p.state.hull_damage}")
            loop p in events.pilots: if not p.state.on_water and p.state.position.y > 100: airborne = true
            if airborne and events.pilots[0].state.moored and events.pilots[1].state.moored:
                returned = true; break
        loop e in events.meets[0].entries: print("entry craft={e.craft} laps={e.laps} finish={e.finished_tick} dq={e.disqualified}")
        assert(airborne and returned, "scale={scale}")
        loop entry in events.meets[0].entries: assert(entry.laps == 2 and entry.finished_tick >= 0, "scale={scale} race incomplete")
        loop p in events.pilots: assert(not p.state.crashed and p.state.hull_damage < 0.01 and not p.active)
        assert(checks.money_balances(w) and checks.goods_balance(w))
    set_tweaks(Tweaks()); set_speed_scale(1)

test "withdrawing before the start returns the fee through the ledger and after the start keeps it":
    set_speed_scale(1)
    w = club_fixture(); models = build_craft_models(); events = AirEvents()
    w.minute = calendar.next_capital_feast_minute(100, 0) - 120; w.tick = w.minute * 120
    prepare_air_events(events, w, models, (x: f64, z: f64) -> f64: -20.0)
    id = events.meets[0].id
    player_craft = w.people[w.player].craft
    w.aircraft[player_craft].pose.pos = events.meets[0].gates[0].center
    w.aircraft[player_craft].hull = 1000; w.aircraft[player_craft].engine = 1000
    wallet = w.people[w.player].account; purse = air_meet_fee_account(w, events.meets[0].capital)
    paid = w.accounts[wallet].cents; held = w.accounts[purse].cents; total = w.ledger.external_in_cents
    assert(not withdraw_player_air_meet(events, w, id).accepted)          # not entered
    assert(enter_player_air_meet(events, w, id).accepted)
    assert(player_air_entry(events.meets[0], w.player)!.fee == AIR_MEET_FEE_CENTS)
    out = withdraw_player_air_meet(events, w, id)
    assert(out.accepted, out.reason)
    assert(w.accounts[wallet].cents == paid and w.accounts[purse].cents == held and w.ledger.external_in_cents == total)
    assert(player_air_entry(events.meets[0], w.player) == none and events.meets[0].entries.len() == 2)
    assert(checks.money_balances(w))
    # Entered again, then the race starts: withdrawing now keeps the fee.
    assert(enter_player_air_meet(events, w, id).accepted)
    events.meets[0].phase = .racing; w.tick = events.meets[0].race_tick + 60
    assert(withdraw_player_air_meet(events, w, id).accepted)
    assert(w.accounts[wallet].cents == paid - AIR_MEET_FEE_CENTS and w.accounts[purse].cents == held + AIR_MEET_FEE_CENTS)
    assert(player_air_entry(events.meets[0], w.player)!.disqualified and checks.money_balances(w))
    # A meeting called off returns the fees it still holds, once.
    events = AirEvents(); w = club_fixture()
    w.minute = calendar.next_capital_feast_minute(100, 0) - 120; w.tick = w.minute * 120
    prepare_air_events(events, w, models, (x: f64, z: f64) -> f64: -20.0)
    w.aircraft[player_craft].pose.pos = events.meets[0].gates[0].center
    w.aircraft[player_craft].hull = 1000; w.aircraft[player_craft].engine = 1000
    paid = w.accounts[wallet].cents
    assert(enter_player_air_meet(events, w, events.meets[0].id).accepted)
    events.meets[0].phase = .cancelled
    refund_cancelled_air_meet(events.meets[0], w); refund_cancelled_air_meet(events.meets[0], w)
    assert(w.accounts[wallet].cents == paid and checks.money_balances(w))

test "townsfolk mention the meet ahead in their own voice and the prompt offers withdrawal with the fee":
    set_speed_scale(1)
    w = club_fixture(); models = build_craft_models(); events = AirEvents()
    feast = calendar.next_capital_feast_minute(100, 0)
    w.minute = feast - 120; w.tick = w.minute * 120
    prepare_air_events(events, w, models, (x: f64, z: f64) -> f64: -20.0)
    said: {str: bool}
    loop speaker in 0..12:
        line = air_meet_remark(events, w, speaker, vec3(20000, 0, 0))
        assert(line.contains("Capital") and line.contains("this afternoon at five"), line)
        said[line] = true
    assert(said.len() >= 2)                                   # not one stock sentence for all
    # The day before the feast it is "tomorrow"; long after, nothing is said.
    w.minute = feast - 1440; w.tick = w.minute * 120; events = AirEvents()
    assert(air_meet_remark(events, w, 1, vec3(0, 0, 0)).contains("tomorrow at five"))
    w.minute = feast + 600; w.tick = w.minute * 120; events = AirEvents()
    assert(air_meet_remark(events, w, 1, vec3(0, 0, 0)) == "")
    # Entered, the same prompt offers withdrawal and names the fee returned.
    w = club_fixture(); events = AirEvents()
    w.minute = feast - 120; w.tick = w.minute * 120
    prepare_air_events(events, w, models, (x: f64, z: f64) -> f64: -20.0)
    player_craft = w.people[w.player].craft
    w.aircraft[player_craft].pose.pos = events.meets[0].gates[0].center
    w.aircraft[player_craft].hull = 1000; w.aircraft[player_craft].engine = 1000
    at = events.meets[0].gates[0].center
    assert(race_offer(events, w, at) == 0 and race_offer_text(events, w, 0).starts_with("F  enter"))
    assert(enter_player_air_meet(events, w, events.meets[0].id).accepted)
    assert(race_offer(events, w, at) == -1 and race_withdraw_offer(events, w, at) == 0)
    assert(race_offer_text(events, w, 0) == "F  withdraw from the race, ¤20 returned")

test "a meet beyond the fuel aboard points to the fuel pier on the board and the card":
    set_speed_scale(1)
    # The starter Gull's figures: 24 l short of 142 km, a full 80 l well past 170 km.
    assert(meet_reach_m(24.0, 0.06, 218.0) < 142000.0 and meet_reach_m(80.0, 0.06, 218.0) > 170000.0)
    assert(meet_reach_m(8.0, 0.06, 218.0) == 0.0)
    w = club_fixture(); events = AirEvents()
    feast = calendar.next_capital_feast_minute(100, 0)
    w.minute = feast - 1440; w.tick = w.minute * 120
    from = vec3(20000, 0, 0)
    clock = (m: int) -> str: "{m}"
    short = air_meet_notices(events, w, from, clock, reach = 10000.0)
    assert(short.len() == 1 and short[0].body.ends_with("Capital, 20 km: fill up at the fuel pier first."), short[0].body)
    full = air_meet_notices(events, w, from, clock, reach = 50000.0)
    assert(full.len() == 1 and not full[0].body.contains("fuel pier"))
    hint = meet_fuel_hint(events, w, from, 10000.0)
    assert(hint.0 == "Air race tomorrow at five.  Capital, 20 km: fill up at the fuel pier first." and hint.1 == feast, hint.0)
    assert(meet_fuel_hint(events, w, from, 50000.0).0 == "")
    # Long after the feast nothing is out of reach, for nothing is ahead.
    w.minute = feast + 600; w.tick = w.minute * 120
    assert(meet_fuel_hint(events, w, from, 0.0).0 == "")
    # The home harbours have fuel piers; open water has none.
    assert(fuel_pier_here(w, w.harbors[0].center)!.core == 0 and fuel_pier_here(w, vec3(9.0e6, 0, 9.0e6)) == none)
    # The hints send the player only to a pier that sells: a shut harbour or an empty pier is no
    # pier to fill up at, and the board says so.
    w.places[0].harbor_closed = true
    assert(fuel_pier_here(w, w.harbors[0].docks[0], 40.0) == none)
    w.places[0].harbor_closed = false
    assert(fuel_pier_here(w, w.harbors[0].docks[0], 40.0) != none)
    w.places[0].market.inventory.reserved[4] = w.places[0].market.inventory.qty[4]
    assert(fuel_pier_here(w, w.harbors[0].docks[0], 40.0) == none)
    w.minute = feast - 1440; w.tick = w.minute * 120
    dry = air_meet_notices(events, w, from, clock, reach = 10000.0, pier_sells = false)
    assert(dry.len() == 1 and dry[0].body.ends_with("Capital, 20 km: more than the fuel aboard, and this pier has none today."), dry[0].body)


test "club departure preparation is bounded and blocked pilots retry fairly":
    set_speed_scale(1)
    models=build_craft_models()
    morning=(600-data.EPOCH_LOCAL_MINUTE+1440)%1440
    assert(data.local_minute(morning)==600)
    w=club_fixture();events=AirEvents()
    w.minute=morning;w.tick=w.minute*120
    sea=(x:f64,z:f64)->f64: -20.0
    prepare_air_events(events,w,models,sea)
    assert(events.pilots.len()==2)
    w.tick+=1
    update_air_events(events,w,models,vec3(20000,0,0),ground=sea)
    assert(events.pilots[0].active and not events.pilots[1].active)
    before=events
    update_air_events(events,w,models,vec3(20000,0,0),ground=sea)
    assert(events==before) # no extra departure or physics on the same tick
    w.tick+=1
    update_air_events(events,w,models,vec3(20000,0,0),ground=sea)
    assert(events.pilots[0].active and events.pilots[1].active)
    w=club_fixture();events=AirEvents();w.minute=morning;w.tick=w.minute*120
    land=(x:f64,z:f64)->f64: 100.0
    prepare_air_events(events,w,models,sea)
    w.tick+=1
    update_air_events(events,w,models,vec3(20000,0,0),ground=land)
    first_retry=events.pilots[0].launch_retry_tick
    assert(first_retry==w.tick+60 and events.pilots[1].launch_retry_tick==0)
    w.tick+=1
    update_air_events(events,w,models,vec3(20000,0,0),ground=land)
    assert(events.pilots[0].launch_retry_tick==first_retry)
    assert(events.pilots[1].launch_retry_tick==w.tick+60)
    assert(not events.pilots[0].active and not events.pilots[1].active)
    assert(checks.money_balances(w) and checks.goods_balance(w))
    # An already waiting club does no cold launch work on the economy frame.
    w=club_fixture();events=AirEvents();w.minute=morning-1;w.tick=w.minute*120+119
    prepare_air_events(events,w,models,sea)
    w.tick+=1;w.minute=morning
    update_air_events(events,w,models,vec3(20000,0,0),ground=sea)
    assert(not events.pilots[0].active and not events.pilots[1].active)
    w.tick+=1
    update_air_events(events,w,models,vec3(20000,0,0),ground=sea)
    assert(events.pilots[0].active and not events.pilots[1].active)
