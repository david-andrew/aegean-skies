use '../src/canal_traffic.jo'
use '../src/vessel_types.jo'
use '../src/vessels.jo'
use '../src/river_field.jo'
use '../src/geography.jo'

test "canal hulls retain identity and elevated water contact through checkpoint replay":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    fleet=VesselFleet();ensure_canal_traffic(fleet,0)
    assert(fleet.ships.len()==12 and fleet.lanes.len()==6)
    ensure_canal_traffic(fleet,0);assert(fleet.ships.len()==12)
    loop ship in fleet.ships:
        assert(vessel_footprint_wet(ship,ship.position.xz,ship.yaw),"initial footprint {ship.id}")
    loop tick in 0..1800:step_vessels(fleet,vec2(0,0),1.0/30.0)
    saved=from_text[VesselFleet](to_text(fleet))
    assert(saved is VesselFleet)
    resumed=saved as VesselFleet
    loop tick in 0..7200:
        step_vessels(fleet,vec2(0,0),1.0/30.0)
        step_vessels(resumed,vec2(0,0),1.0/30.0)
    assert(to_text(fleet)==to_text(resumed))
    moving=0
    loop ship in fleet.ships:
        r=river_at(f64(ship.position.x),f64(ship.position.z))
        assert(r.wet and abs(f64(ship.position.y)-r.level)<0.04)
        if ship.status==.underway:moving+=1
    assert(moving==6,"only {moving} canal craft remain underway")

test "canal launches brake for a plane and resume after it clears":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    fleet=VesselFleet();ensure_canal_traffic(fleet,0)
    loop tick in 0..300:step_vessels(fleet,vec2(0,0),1.0/30.0)
    v=fleet.ships[1];before=v.speed
    obstacle=v.position+vec3(sin(v.yaw),0,cos(v.yaw))*15.0
    loop tick in 0..300:step_vessels(fleet,vec2(0,0),1.0/30.0,obstacle)
    assert(fleet.ships[1].speed<before*0.2)
    loop tick in 0..300:step_vessels(fleet,vec2(0,0),1.0/30.0)
    assert(fleet.ships[1].speed>0.5)
