# The pause menu's tabs: every label whole and near full size, on a phone held upright, a phone
# held sideways and the desktop's panels (the type comes down only where three a row is too few).
use '../src/debugmenu.jo'

test "every pause-menu tab label fits its tab at nearly full size":
    loop w in [336.0, 376.0, 520.0, 696.0]:
        loop size in [16.0, 21.0]:
            n = tabs_per_row(w, size)
            assert(n >= 3 and n <= 7)
            tw = (w - GAP * f64(n - 1)) / f64(n)
            loop name in PAGES:
                # (as drawn: the type shrinks to fit when the label is wider than the tab's room)
                drawn = size * min(1.0, (tw - 14.0) / text_width(name, size))
                assert(drawn >= size * 0.9, "{name} drawn at {drawn:.1} of {size} in {w}: {n} a row")
    # (the wide Aircraft page keeps its tabs to two rows)
    assert((PAGES.len() + tabs_per_row(696.0, 16.0) - 1) / tabs_per_row(696.0, 16.0) <= 2)
