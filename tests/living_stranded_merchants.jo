use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_stock.jo'
use '../src/living_far_checks.jo'
use '../src/living_money.jo'
use 'living_far_economy.jo'

empty_ration_and_counter = (w: mut World, vehicle: int):
    v=w.far.vehicles[vehicle]
    ration=far_stock_take(w.far.vehicles[vehicle].provisions,w.cargo_sources,3,v.provisions.qty[3])
    assert(ration!=none); far_use(w,ration!)
    food=far_take_market(w,v.place,3,far_market_qty(w,v.place,3)); far_use(w,food)

two_hungry_days = (w: mut World):
    loop _ in 0..2:
        w.minute+=1440; w.tick=w.minute*120; far_crew_meals(w)

test "a genuinely hungry merchant can travel home from an empty counter without a fabricated ration or a teleport":
    w=far_fixture(); assert(far_depart(w,0))
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==200)
    empty_ration_and_counter(w,0); two_hungry_days(w)
    assert(w.far.vehicles[0].hungry_days==2)
    before=stock_totals(w); roots=w.next_cargo_source; pos=w.far.vehicles[0].pos
    assert(far_depart(w,0))
    journey=w.far.journeys[w.far.vehicles[0].journey]
    assert(journey.destination==100 and w.far.vehicles[0].pos==pos and "hungry days" in journey.provenance.cause)
    assert(w.far.vehicles[0].provisions.qty[3]==0 and w.next_cargo_source==roots and stock_totals(w)==before)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[0].place==100 and goods_balance(w) and money_balances(w) and validate_far(w)=="")

test "seeking food uses the actual carried quote and does not discover a counter's later depleted stock":
    w=far_fixture(); letter=w.far.vehicles[0].buying_order!
    assert(letter.observed[3]>0)
    empty_ration_and_counter(w,0)
    # The letter really described opening stock. Later consumption is not a broadcast.
    other=far_take_market(w,200,3,far_market_qty(w,200,3)); far_use(w,other)
    two_hungry_days(w)
    before=stock_totals(w)
    assert(far_depart(w,0) and w.far.vehicles[0].provisions.qty[3]==0)
    j=w.far.journeys[w.far.vehicles[0].journey]
    assert(j.destination==200 and "carried quote" in j.provenance.cause and stock_totals(w)==before)
    assert(goods_balance(w) and money_balances(w) and validate_far(w)=="")

test "a normal or only briefly hungry crew cannot promise an unprovisioned trip and expired food quotes cannot justify one":
    w=far_fixture(); empty_ration_and_counter(w,0)
    assert(not far_depart(w,0) and w.far.vehicles[0].journey<0)
    w.minute+=1440; w.tick=w.minute*120; far_crew_meals(w)
    assert(not far_depart(w,0))
    letter=w.far.vehicles[0].buying_order!
    w.minute=letter.due+1; w.tick=w.minute*120; far_crew_meals(w)
    assert(w.far.vehicles[0].hungry_days==2 and not far_depart(w,0))
    assert(w.far.vehicles[0].journey<0 and w.far.vehicles[0].provisions.qty[3]==0 and goods_balance(w) and money_balances(w))
