use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_far_types.jo'
use '../src/living_far_stock.jo'
use '../src/living_ports.jo'
use '../src/living_portage.jo'
use '../src/living_cargo.jo'
use '../src/living_money.jo'
use '../src/living_checks.jo'
use '../src/living_save.jo'

port_economy_fixture = () -> World:
    w=build_world(); w.far.version=1; w.far.treasury=[-1,-1,-1]
    market=new_account(w,"test-port-market",20000); households=new_account(w,"test-port-households",20000)
    w.far.districts[100]=FarDistrict(id=100,core=-1,born_country=1,controller=1,authority=1,market_account=market,household_account=households,output=3,productivity=100)
    w.far.districts[100].prices=[100,200,300,400,500,600,700,800,900]
    door=vec3(100000,3,100000); loading=door+vec3(20,0,0); dock=loading+vec3(0,-3,12)
    w.place_contexts[100]=LifePlaceContext(100,"Test port",1,1,door,aviation=true,venues=[LifeVenue(100,"port:100:warehouse",.market,door)])
    w.people[w.player].place=-1; w.people[w.player].far_place=100; w.people[w.player].pose.pos=door
    craft=w.people[w.player].craft
    w.aircraft[craft].place=-1; w.aircraft[craft].dock=-1; w.aircraft[craft].port_place=100
    w.aircraft[craft].port_at=dock; w.aircraft[craft].pose.pos=dock; w.aircraft[craft].port_loading=loading
    assert(far_produce(w,100,3,10000,true))
    w

test "registry purchases are funded physical root transfers through hands and hold":
    w=port_economy_fixture(); actor=w.player; craft=w.people[actor].craft
    before=stock_totals(w); created=w.goods_ledger.created; sources=w.next_cargo_source
    cash=w.accounts[w.people[actor].account].cents
    pocket=w.people[actor].pocket.qty[3]; hold=w.aircraft[craft].cargo.qty[3]
    assert(port_trade(w,actor,100,3,1000,true))
    assert(w.accounts[w.people[actor].account].cents==cash-400)
    assert(w.far.districts[100].stock.qty[3]==9000 and w.people[actor].pocket.qty[3]==pocket+1000)
    ids=port_sale_lots(w,actor,100,3); assert(ids.len()==1)
    lot=ids[0]; root=w.cargo[lot].source
    assert(w.cargo_sources[root].producer_place==100 and w.cargo_sources[root].far_quantity==9000)
    assert(cargo_pick_up(w,actor,lot))
    assert(w.people[actor].carrying==lot)
    text=canonical_text(w); saved=from_text[World](text); assert(saved is World)
    assert(validate_save_world(saved)=="" and saved.people[actor].carrying==lot)
    cargo_person_pose(w,actor,w.aircraft[craft].port_loading)
    assert(cargo_put_down(w,actor,true))
    assert(w.aircraft[craft].cargo.qty[3]==hold+1000 and w.people[actor].pocket.qty[3]==pocket)
    assert(w.cargo[lot].where==.aircraft and w.cargo[lot].source==root)
    assert(cargo_pick_up(w,actor,lot))
    cargo_person_pose(w,actor,port_market_spot(w,100)!)
    assert(cargo_put_down(w,actor,false))
    assert(port_trade(w,actor,100,3,1000,false))
    assert(w.far.districts[100].stock.qty[3]==10000 and w.cargo_sources[root].far_quantity==10000)
    assert(w.aircraft[craft].cargo.qty[3]==hold and w.people[actor].pocket.qty[3]==pocket)
    assert(stock_totals(w)==before and w.goods_ledger.created==created and w.next_cargo_source==sources)
    assert(far_stock_errors(w).len()==0 and invariant_errors(w).len()==0 and validate_save_world(w)=="")

test "port trades reject remote goods, unaffordable purchases and stale loading anchors":
    w=port_economy_fixture(); actor=w.player; craft=w.people[actor].craft
    before=canonical_hash(w)
    assert(not port_trade(w,actor,100,3,100000,true))
    assert(canonical_hash(w)==before)
    assert(port_trade(w,actor,100,3,1000,true))
    lot=port_sale_lots(w,actor,100,3)[0]
    w.cargo[lot].pos+=vec3(1000,0,0)
    before=canonical_hash(w)
    assert(not port_trade(w,actor,100,3,1000,false))
    assert(canonical_hash(w)==before)
    w.aircraft[craft].state=.airborne
    assert(cargo_loading_spot(w,craft)==none)
    w.aircraft[craft].state=.moored; w.aircraft[craft].pose.pos+=vec3(100,0,0)
    assert(cargo_loading_spot(w,craft)==none)
    assert(invariant_errors(w).len()==0)
