# Dolphins (src/dolphins.jo): a pod roams its deep water surfacing now and then; it races a
# seaplane taxiing out, leaping, and peels off when the aircraft pulls away; it rides a caique's bow.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/dolphins_test.jo
use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/world.jo'
use '../src/objects.jo'
use '../src/vessel_types.jo'
use '../src/wildlife.jo'
use '../src/dolphins.jo'

# (open sea 40 m deep everywhere)
_sea = WildEnv(ground = (x: f64, z: f64) -> f64: -40.0, water = (x: f64, z: f64) -> f64: 0.0)

struct Run:
    surfacings = 0
    leaps = 0
    highest = -10.0
    deepest = 0.0
    near = 0                        # frames with most of the pod within 20 m of the aircraft

_run = (d: mut Dolphins, p: mut Pod, seconds: f64, plane: (f64) -> WildThreat?, boats: Vessel[] = []) -> Run:
    r = Run()
    marks: WildMark[]; calls: WildCall[]
    dt = 1.0 / 30.0
    up: bool[] = [loop dol in p.dolphins: dol.pos.y > 0.0]
    loop i in 0..int(seconds * 30.0):
        t = f64(i) * dt
        threats: WildThreat[]
        if let th = plane(t): threats.push(th)
        d.time += dt
        pod_step(p, d, threats, boats, _sea, dt, d.time, marks, calls)
        clear(calls); clear(marks)
        close = 0
        loop k in 0..p.dolphins.len():
            dol = p.dolphins[k]
            if dol.pos.y > 0.0 and not up[k]: r.surfacings += 1
            up[k] = dol.pos.y > 0.0
            if dol.airborne and dol.pos.y > 0.25: r.leaps += 1
            r.highest = max(r.highest, f64(dol.pos.y)); r.deepest = min(r.deepest, f64(dol.pos.y))
            if let th = plane(t):
                if f64(length(th.pos.xz - dol.pos.xz)) < 20.0: close += 1
        if close * 2 > p.dolphins.len(): r.near += 1
    r

_pod = () -> Pod: make_pod(PodSite(7900123, vec2(0, 0), vec2(1, 0)), _sea)

test "a pod is the same each day from its key, and roams its water surfacing to breathe":
    a = _pod(); b = _pod()
    assert(a.dolphins.len() >= 3 and a.dolphins.len() == b.dolphins.len())
    loop k in 0..a.dolphins.len(): assert(length(a.dolphins[k].pos - b.dolphins[k].pos) == 0.0)
    d = Dolphins()
    p = _pod()
    r = _run(d, p, 90.0, (t: f64) -> WildThreat?: none)
    print("roam: surfacings {r.surfacings} leaps {r.leaps} highest {r.highest:.2f} deepest {r.deepest:.2f}")
    # each breathes every 5-19 s: several surfacings each in a minute and a half, few leaps
    assert(r.surfacings >= p.dolphins.len() * 3)
    assert(r.highest < 1.2 and r.deepest > -4.0)
    assert(p.mode == .roam and f64(length(p.centre)) < 400.0)
    assert(d.spray.len() > 0)

test "they race a seaplane taxiing out, leaping, and peel off when it pulls away":
    d = Dolphins()
    p = _pod()
    # taxiing past at 6 m/s for 25 s, then the take-off run at 4 m/s^2
    plane = (t: f64) -> WildThreat?:
        x = if t < 25.0: -120.0 + 6.0 * t else: -120.0 + 150.0 + 6.0 * (t - 25.0) + 2.0 * (t - 25.0) * (t - 25.0)
        v = if t < 25.0: 6.0 else: 6.0 + 4.0 * (t - 25.0)
        WildThreat(vec3(f32(x), 0.5, 30.0), vec3(f32(v), 0, 0), true)
    r = _run(d, p, 25.0, plane)
    print("race: near {r.near} leaps {r.leaps} highest {r.highest:.2f} mode {int(p.mode)}")
    assert(p.mode == .race)
    assert(r.near > 30 * 8)
    assert(r.leaps > 10 and r.highest < 2.5)
    r2 = _run(d, p, 15.0, (t: f64) -> WildThreat?: plane(t + 25.0))
    print("pulled away: mode {int(p.mode)} near {r2.near}")
    assert(p.mode == .peel or p.mode == .roam)
    # (it is far ahead now; they are not with it)
    th = plane(40.0)!
    loop dol in p.dolphins: assert(f64(length(th.pos.xz - dol.pos.xz)) > 60.0)

test "they ride a caique's bow while it is underway":
    d = Dolphins()
    p = _pod()
    boat = Vessel(id = 5, kind = .sail_caique, owner = 1, side = 0, cargo = [], crew = [], position = vec3(-150, 0, 20), velocity = vec3(5, 0, 0), status = .underway, speed = 5.0)
    boats = [boat]
    marks: WildMark[]; calls: WildCall[]
    ahead = 0
    loop i in 0..30 * 40:
        boats[0].position = vec3(f32(-150.0 + 5.0 * f64(i) / 30.0), 0, 20)
        d.time += 1.0 / 30.0
        pod_step(p, d, [], boats, _sea, 1.0 / 30.0, d.time, marks, calls)
        clear(calls); clear(marks)
        loop dol in p.dolphins:
            rel = dol.pos.xz - boats[0].position.xz
            if rel.x > 2.0 and rel.x < 14.0 and abs(rel.y) < 6.0: ahead += 1
    print("bow: mode {int(p.mode)} ahead-frames {ahead}")
    assert(p.mode == .bow and ahead > 30 * 10 * 2)
