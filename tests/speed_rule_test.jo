# The one speed rule that sets every historical aircraft's top speed (src/aircraft_catalog.jo
# speed_rule): every historical type carries its real figures, the rule keeps their real order and
# leaves the game's own designs alone, and at its speeds every type settles, takes off, flies and lands.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 sloppy test tests/speed_rule_test.jo
import '../src/aircraft_catalog.jo' as cat
import '../src/planes.jo' as planes
import '../src/flight.jo' as fl

const OWN_DESIGNS = 16

test "every historical type carries its real top speed; the game's own designs none":
    loop i in 0..cat.AIRCRAFT.len():
        p = cat.AIRCRAFT[i]
        # (a new historical type needs real_top_kmh in its profile for the rule to place it)
        if i < OWN_DESIGNS: assert(p.real_top_kmh == 0.0, planes.CRAFT_NAMES[i])
        else: assert(p.real_top_kmh > 50.0 and p.real_top_kmh < 1000.0, "{planes.CRAFT_NAMES[i]} needs real_top_kmh")

test "the rule sets every historical top and the drag that makes it, in the real order":
    order: int[]
    loop i in OWN_DESIGNS..cat.AIRCRAFT.len(): order.push(i)
    order.sort((i: int) -> f64: cat.AIRCRAFT[i].real_top_kmh)
    loop n in 1..order.len():
        a = cat.AIRCRAFT[order[n - 1]]; b = cat.AIRCRAFT[order[n]]
        assert(a.top <= b.top + 0.001, "{planes.CRAFT_NAMES[order[n - 1]]} / {planes.CRAFT_NAMES[order[n]]}")
    loop i in OWN_DESIGNS..cat.AIRCRAFT.len():
        p = cat.AIRCRAFT[i]; name = planes.CRAFT_NAMES[i]
        assert(abs(p.top - cat.speed_rule_top(p.real_top_kmh)) < 0.001, name)
        # (thrust over drag makes the top; the cruise between the stall and the top)
        assert(abs(sqrt(p.thrust / p.drag) - p.top) < 0.001, name)
        assert(p.cruise > p.stall * 1.2 and p.cruise < p.top * 0.9, name)
    # (the game's own designs keep their own figures)
    own = cat.AIRCRAFT[0]
    kept = cat.speed_rule(own)
    assert(kept.top == own.top and kept.drag == own.drag and kept.cruise == own.cruise)

# At the rule's speeds, at the player's 3.3 scale: rest on the water, the production take-off, a climb,
# hands-off level flight at cruise, and a water landing from just above the stall to rest. The landplane
# flies its level leg only here (tests/aircraft_early_test.jo runs its airfield).
_exercise = (kind: planes.Craft):
    m = planes.build_craft(kind, planes.LIVERIES[1])
    k = fl.craft_spec(kind, m.contacts); k.player = true
    e = fl.FlightEnv()
    land = planes.aircraft_profile(kind).landplane
    if not land:
        s = fl.water_start(k, vec3(0, 0, 0))
        loop i in 0..600: fl.step(k, s, fl.Controls(), e, 1.0 / 30.0)
        assert(abs(f64(s.position.y) - k.float_height) < 0.15 and not s.crashed, "{kind} rest")
        s = fl.water_start(k, vec3(0, 0, 0))
        took_off = false; plan = fl.FlightPlan()
        loop i in 0..60 * 120:
            fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
            if not s.on_water and s.position.y > k.float_height + 5:
                took_off = true; break
        print("{kind} takeoff t={s.time:.1} run={length(s.position.xz):.0} m damage={s.hull_damage:.4}")
        assert(took_off and not s.crashed and s.hull_damage < 0.02, "{kind} takeoff")
        before = s.position.y
        loop i in 0..60 * 45:
            fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
            if s.position.y > before + 60: break
        assert(s.position.y > before + 15 and not s.crashed, "{kind} climb")
    s = fl.CraftState(position = vec3(0, 500, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = fl.cruise_throttle(k, k.cruise_speed / fl.pure_k(k)))
    loop i in 0..60 * 20: fl.step(k, s, fl.Controls(throttle = s.throttle), e, 1.0 / 60.0)
    print("{kind} level y={s.position.y:.1} speed={length(s.velocity) / 3.3:.1} m/s true")
    assert(abs(f64(s.position.y) - 500) < 80 and not s.crashed, "{kind} level")
    if not land:
        s = fl.CraftState(position = vec3(0, k.float_height + 3, 0), velocity = vec3(0, -0.6, -k.stall_speed * 1.15 * fl.pure_k(k)),
            orientation = quat_euler(-0.02, 0, 0), fuel = k.fuel_capacity)
        touched = false
        # (the giants coast for a long while: three minutes, as tests/aircraft_boats_test.jo)
        loop i in 0..60 * 180:
            fl.step(k, s, fl.Controls(assist = 0, water_brake = 0.4), e, 1.0 / 60.0)
            if s.on_water: touched = true
        print("{kind} landing damage={s.hull_damage:.4} speed={length(s.velocity):.2}")
        assert(touched and not s.crashed and s.hull_damage < 0.05 and length(s.velocity) < 0.3, "{kind} landing")

test "at the rule's speeds every historical type settles, takes off, climbs, flies level and lands":
    fl.set_speed_scale(3.3); fl.set_lift_scale(3.3)
    loop i in OWN_DESIGNS..cat.AIRCRAFT.len(): _exercise(planes.Craft(i))
    fl.set_speed_scale(1.0)
