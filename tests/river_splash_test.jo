use '../src/splash.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/pilot.jo'
use '../src/river_data.jo'
use '../src/geography.jo'

test "skim spray follows elevated inland water instead of sea level":
    before=geography_enabled;geography_enabled=true
    node=RIVER_NODES[300]
    model=build_craft(.gull,LIVERIES[0]);k=craft_spec(.gull,model.contacts)
    s=CraftState(position=vec3(node.x,node.z+f32(k.float_height)+1.5,node.y),velocity=vec3(0,0,-190))
    f=Flyer(.gull,0,k,s,cam_pos=s.position)
    sheets=splash_targets(f,model,craft_transform(f),true)
    assert([loop sheet in sheets:if sheet.amount>0.0:sheet].len()>0)
    f.state.position.y+=100
    assert([loop sheet in splash_targets(f,model,craft_transform(f),true):if sheet.amount>0.0:sheet].len()==0)
    geography_enabled=before
