# The mouse's steering on flight model v2 (flight_v2.jo steer_v2): small aim moves give small, settled
# nose moves, the feet (a skid) doing the fine work, the bank only for bigger ones; moving targets are
# followed. Flown by tools/aim_track.jo's cases, a perfect hand on the mouse.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 sloppy test tests/aim_track_test.jo
import '../tools/aim_track.jo' as aim
import '../src/flight.jo' as fl
import '../src/flight_v2.jo' as v2
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as planes

test "v2: a small aim step settles without swinging past or banking much":
    loop kind in [planes.Craft.gull, planes.Craft.supermarine_s6b]:
        k = aim.spec_for(kind, 1)
        v = k.cruise_speed / aim.K
        loop case in ["left1", "left3", "right3", "up3"]:
            r = aim.fly_case(kind, 1, v, case)
            print("{kind} {case}: rms {r.rms:.2} overshoot {r.overshoot:.2} bank {r.bank:.1} settle {r.settle:.2}")
            assert(r.overshoot < 0.6 and r.bank < 12.0 and r.settle > 0.0 and r.settle < 4.0, "{kind} {case}")
    tw.set_tweaks(tw.Tweaks())

test "v2: small quick moves, a drifting and a turning target are tracked without a big manoeuvre":
    loop kind in [planes.Craft.gull, planes.Craft.corsair]:
        k = aim.spec_for(kind, 1)
        v = k.cruise_speed / aim.K
        w = aim.fly_case(kind, 1, v, "wiggle")
        d = aim.fly_case(kind, 1, v, "drift")
        t = aim.fly_case(kind, 1, v, "turn")
        print("{kind}: wiggle rms {w.rms:.2} bank {w.bank:.1}; drift rms {d.rms:.2}; turn rms {t.rms:.2} peak {t.peak:.2}")
        assert(w.rms < 1.2 and w.bank < 10.0)
        assert(d.rms < 0.6 and d.peak < 1.0)
        assert(t.rms < 1.6 and t.peak < 2.5)
    tw.set_tweaks(tw.Tweaks())

test "v2: a full rudder on the keys holds a real skid, the nose round in under a second":
    fl.set_speed_scale(3.3); fl.set_lift_scale(3.3)
    tw.set_tweaks(tw.Tweaks(flight_model = 1))
    k = fl.craft_spec(.gull, planes.build_craft(.gull, planes.LIVERIES[0]).contacts); k.player = true
    v = k.cruise_speed
    s = fl.CraftState(position = vec3(0, 900, 0), velocity = vec3(0, 0, f32(-v)), fuel = k.fuel_capacity, water_age = 1.0)
    thr = fl.cruise_throttle(k, v / 3.3); s.throttle = thr; s.rpm = thr
    turned = -1.0
    loop i in 0..60:
        fl.step(k, s, fl.Controls(throttle = thr, yaw = 1.0), fl.FlightEnv(), 1.0 / 60.0)
        nose = fl.heading(s); path = atan2(f64(s.velocity.x), -f64(s.velocity.z))
        if turned < 0.0 and nose - path > 0.07: turned = s.time
    nose = fl.heading(s); path = atan2(f64(s.velocity.x), -f64(s.velocity.z))
    print("full rudder: skid {(nose - path) * 57.3:.1} deg after 1 s, 4 deg reached at {turned:.2} s")
    assert(nose - path > 0.1 and turned > 0.0 and turned < 1.0)
    tw.set_tweaks(tw.Tweaks()); fl.set_speed_scale(1.0)
