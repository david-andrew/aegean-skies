use '../src/living_far_stock.jo'
use '../src/living_war.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

test "a physical carrier retains its original account after journal pruning and delivers it once":
    w=commission_fixture()
    event=far_local_news(w,100,"occupation","Oria has changed hands.",country=1,severity=1000)
    assert(far_produce(w,100,3,10000)); w.far.districts[200].target[3]+=20000
    assert(far_depart(w,0)); journey=w.far.vehicles[0].journey
    assert(w.far.journeys[journey].reports.len()>0)
    loop k in 0..2100: far_local_news(w,300,"counter_quote","The local counter quoted grain.")
    assert(not (event in w.far.news))
    # No destination knowledge until the actual route endpoint.
    assert(w.far.districts[200].reports.len()==0)
    w.tick+=6000; w.minute=w.tick/120; far_advance_transport(w,w.tick)
    heard=[loop r in w.far.districts[200].reports: if r.id==event: r]
    assert(heard.len()==1 and heard[0].occurred_minute==0 and heard[0].hops==0 and heard[0].carriage==1)
    person=promote_far_person(w,200,.trader)
    far_hear_counter(w,person,200)
    known=[loop r in w.people[person].far_reports: if r.id==event: r]
    assert(known.len()==1 and known[0].learned_minute==w.minute)
    assert(validate_far(w)=="")

test "received signed incident snapshots retain their evidence when the global news is pruned":
    w=commission_fixture()
    id=war_incident(w,100,1,2,"armed_intrusion","A witnessed armed inspection crossed the border.",80)
    reports=w.far.districts[100].reports
    loop k in 0..2100: far_local_news(w,300,"counter_quote","The local grain quote changed.")
    w.war.evidence.remove(id)
    assert(not (id in w.far.news))
    war_diplomacy(w); r=war_relation(w,1,2); assert(w.diplomacy[r].tension==0)
    far_arriving_accounts(w,200,reports)
    war_diplomacy(w)
    assert(w.diplomacy[r].tension==80 and w.war.evidence[id].minute==0)
    before=canonical_text(w); war_diplomacy(w); assert(canonical_text(w)==before)

test "a stale foot pose cannot hear a counter while its person is flying elsewhere":
    w=commission_fixture(); event=far_local_news(w,100,"orders","A patrol brought a report.")
    w.people[0].pose.pos=far_counter(w,100)
    w.aircraft[0].state=.airborne; w.aircraft[0].pose.pos=vec3(10000,300,10000)
    far_hear_counter(w,0,100)
    assert([loop r in w.people[0].far_reports: if r.id==event: r].len()==0)
    w.aircraft[0].state=.moored
    far_hear_counter(w,0,100)
    assert([loop r in w.people[0].far_reports: if r.id==event: r].len()==1)


test "counter reading preserves transported provenance and offshore testimony stays aboard":
    w=commission_fixture(); id=far_local_news(w,100,"armed_intrusion","A patrol was witnessed.",country=1,severity=800,aggressor=1,affected=2,state_backed=true,weight=80)
    far_arriving_accounts(w,200,w.far.districts[100].reports)
    r=[loop r in w.far.districts[200].reports: if r.id==id: r][0]
    # The short journal index is a cache, not a fresh eyewitness at this counter.
    w.far.districts[200].recent_news.push(id)
    w.people[0].pose.pos=far_counter(w,200); far_hear_counter(w,0,200)
    heard=[loop r in w.people[0].far_reports: if r.id==id: r][0]
    assert(heard.confidence==r.confidence and heard.hops==0 and heard.carriage==1 and heard.state_backed and heard.weight==80)


test "a signed report travels beyond four actual ports while oral retelling remains bounded":
    w=commission_fixture(); id=far_local_news(w,100,"occupation","The port flags changed.",country=2,severity=900)
    report=w.far.districts[100].reports
    loop n in 0..12:
        destination=if n%2==0: 200 else: 300
        far_arriving_accounts(w,destination,report)
        report=[loop r in w.far.districts[destination].reports: if r.id==id: r]
        # This fixture revisits counters; clear only their copy so each real new paper leg
        # can be inspected without replacing the same report by a fresh eyewitness.
        w.far.districts[destination].reports=[]
    assert(report.len()==1 and report[0].carriage==12 and report[0].hops==0 and report[0].confidence==1000)
    w.people[0].pose.pos=far_counter(w,200); w.people[1].pose.pos=w.people[0].pose.pos
    w.people[0].far_place=200; w.people[0].place= -1
    w.people[0].far_reports=report
    assert(far_relay_report(w,0,1,id))
    assert(w.people[1].far_reports[0].hops==1 and w.people[1].far_reports[0].confidence==850)
