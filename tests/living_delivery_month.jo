# Sustained service, not a total inflated by foot errands or the opening preloaded flights.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'
use '../src/living_claims.jo'
use '../src/living_travel.jo'
use '../src/living_money.jo'

test "aircraft deliveries continue in every five day window through a saved month":
    w=build_world(u64(42)); seen: {int: bool}; windows: int[6]
    last=0; gap=0; delivered=0
    loop minute in 1..43201:
        step_minute(w)
        loop id,j in w.jobs:
            if j.delivery_mode!=.aircraft or j.state!=.delivered or id in seen: continue
            seen[id]=true; windows[min(5,(minute-1)/7200)] += 1
            delivered += 1; gap=max(gap,minute-last); last=minute
        if minute%1440==0:
            errors=invariant_errors(w); assert(errors.len()==0,errors.join("; "))
        if minute==21600:
            parsed=from_text[World](canonical_text(w)); assert(parsed is World)
            assert(canonical_text(parsed)==canonical_text(w)); w=parsed
    gap=max(gap,43200-last)
    print("AIRCRAFT MONTH delivered={delivered} windows={windows} last={last} max_gap={gap}")
    loop n in windows: assert(n>=3,"aircraft delivery stall: five-day windows {windows}")
    assert(gap<4320 and last>40320)
    assert(validate_save_world(w)=="")

test "a completed manifest cannot recall its idle pilot to a loading berth":
    w=build_world(); advance_minutes(w,80)
    assert(w.jobs[0].state==.delivered and w.aircraft[1].dock>=0)
    taxi=start_harbor_move(w,2,-1); assert(taxi>=0)
    w.tick=w.trips[taxi].eta_tick; w.minute=w.tick/120; advance_trips(w,w.tick)
    assert(w.aircraft[1].dock== -1 and w.aircraft[1].trip== -1)
    fuel=w.aircraft[1].fuel_ml
    advance_loads(w)
    assert(w.aircraft[1].trip== -1 and w.aircraft[1].fuel_ml==fuel)

test "a water taxi uses real taxi fuel without a flight reserve or a second landing bill":
    w=build_world(); advance_minutes(w,80); c=2; actor=w.aircraft[c].owner
    # A low-fuel delivery pilot gives up the actual working berth; no free tank refill.
    used=w.aircraft[c].fuel_ml-2000; burn_fuel(w,c,used)
    before_cash=w.accounts[w.people[actor].account].cents; before_fuel=w.aircraft[c].fuel_ml
    trip=start_harbor_move(w,actor,-1)
    assert(trip>=0 and w.trips[trip].harbor_move and w.aircraft[c].place== -1)
    assert(length(w.aircraft[c].pose.pos-w.harbors[0].docks[1])<0.1)
    # Drive only the saved motion, not unrelated wages/prices/weather.
    w.tick=w.trips[trip].eta_tick; w.minute=w.tick/120; advance_trips(w,w.tick)
    assert(w.aircraft[c].dock== -1 and w.aircraft[c].place==0)
    assert(w.aircraft[c].fuel_ml<before_fuel and w.aircraft[c].fuel_ml>0)
    assert(w.accounts[w.people[actor].account].cents==before_cash)
    assert(goods_balance(w) and money_balances(w))
