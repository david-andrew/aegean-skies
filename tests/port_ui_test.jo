# The port screens' projections: the map counter's rows and the rescue/standing readouts. They
# only read the living world; buying and boarding stay with its own transactions.
use '../src/phoenix.jo'
use '../src/living_types.jo'
use '../src/living_map_types.jo'
use '../src/living_maps.jo'
use '../src/living_seed.jo'
use '../src/living_save.jo'
use '../src/living_war_rescue.jo'
use '../src/map_counter.jo'
use '../src/rescue_view.jo'
use 'living_commissions.jo'

test "the counter lists one row per edition on sale, with prices and the editions one owns":
    w = build_world()
    rows = map_counter_rows(w,"porto-chandler",0)
    assert(rows.len() > 0)
    seen: {str: bool}
    loop r in rows:
        assert(r.job == -1 and r.copy in w.maps.copies and r.price_cents == w.maps.copies[r.copy].price_cents)
        assert(not seen.get(r.title,false))
        seen[r.title] = true
    owned = [loop r in rows: if r.have: r.title]
    assert(owned == ["Tourist map of Porto Vecchio, 1925"])
    w.people[0].pose.pos = vec3(100000,0,0)
    assert(map_counter_rows(w,"porto-chandler",0).len() == 0)

test "a sheet promised for an errand shows once taken and can be collected once delivered":
    w = build_world()
    job = w.maps.rewards.keys()[0]
    assert([loop r in map_counter_rows(w,"porto-chandler",0): if r.job >= 0: r].len() == 0)
    w.jobs[job].carrier = 0; w.jobs[job].state = .claimed
    promised = [loop r in map_counter_rows(w,"porto-chandler",0): if r.job >= 0: r]
    assert(promised.len() == 1 and promised[0].job == job and not promised[0].ready)
    w.jobs[job].state = .delivered
    promised = [loop r in map_counter_rows(w,"porto-chandler",0): if r.job >= 0: r]
    assert(promised[0].ready and promised[0].copy == w.maps.rewards[job])
    copy = promised[0].copy
    assert(claim_map_reward(w,job,0).ok)
    assert(w.maps.copies[copy].holder == .person and [loop r in map_counter_rows(w,"porto-chandler",0): if r.job >= 0: r].len() == 0)

test "prices read as the phoenix and a figure, small change in lepta":
    assert(phoenix_text(400) == "¤4" and phoenix_text(350) == "¤3.50" and phoenix_text(950) == "¤9.50" and phoenix_text(30) == "30 λ")

test "a pilot in the water is marked, can be taken aboard only alongside and slow, and is named":
    w = commission_fixture(); w.tick = 120; w.minute = 1
    at = vec3(5000,0,5000)
    id = record_downed_airman(w,8,2,at,0)
    assert(id >= 0)
    r = RescueView()
    assert(rescue_scan(r,w,at+vec3(2000,0,0)).len() == 0)
    assert(rescue_marks(r,at+vec3(2000,0,0)).len() == 1 and survivor_name(w,r.views[0]) == w.people[8].name)
    assert(rescue_pickup(r,at+vec3(12,0,0),true,1.0) == id)
    assert(rescue_pickup(r,at+vec3(12,0,0),true,8.0) == -1 and rescue_pickup(r,at+vec3(12,0,0),false,1.0) == -1)
    assert(rescue_pickup(r,at+vec3(45,0,0),true,1.0) == -1)
    # someone else's boat took them: the player hears so, once
    w.war.survivors[id].riding_vehicle = 1
    news = rescue_scan(r,w,at)
    assert(news.len() == 1 and news[0].contains("another crew") and rescue_scan(r,w,at).len() == 0)

test "standing reads each country, then the ports that have heard of the player":
    w = build_world()
    lines = standing_lines(w)
    assert(lines.len() == w.countries.len() and lines[0].ends_with("little known (0)"))
    w.war.reputation["{w.player}:1"] = 24
    w.reputation[ReputationKey(0,.person,w.player)] = -30
    lines = standing_lines(w)
    assert(lines[1] == "{w.countries[1].name}: well regarded (24)")
    assert(lines.len() == w.countries.len()+1 and lines[lines.len()-1].ends_with("poorly regarded (-30)"))
