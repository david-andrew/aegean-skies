use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/world.jo'

load_places = ():
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_settlements()

test "settlements retain legacy IDs and cover every major region with unique dry places":
    load_places()
    ids: {int: bool} = {}; names: {str: bool} = {}; regions: {int: int} = {}
    capitals = 0; farms = 0; large_islands = 0
    loop k in 0..world_settlements.len():
        s = world_settlements[k]
        assert(not (s.id in ids)); ids[s.id] = true
        assert(not (s.name in names)); names[s.name] = true
        assert(settlement_by_id[s.id] == k)
        regions[s.region] = regions.get(s.region,0)+1
        if k < 6:
            assert(s.id == k and s.legacy == k and s.name == SETTLEMENTS[k].name)
            p,out = coast_point(SETTLEMENTS[k].island,SETTLEMENTS[k].bearing)
            assert(length(s.center.xz-p) < 0.01 and length(s.out-out) < 0.001)
        else:
            assert(s.legacy == -1 and s.country >= 1 and s.country <= 2)
            assert(place_ground(s.center.xz) > 0.0)
            assert(abs(s.center.x) < 250000.0 and abs(s.center.z) < 200000.0)
            loop dock in s.harbor:
                assert(place_ground(dock.at.xz) < -2.0)
                assert(length(dock.quay_b-dock.quay_a) > 50.0)
                assert(settlement_quay_height((dock.quay_a+dock.quay_b)*0.5,-10.0) == 1.2)
        if s.kind == .capital:
            capitals += 1
            assert(s.size >= 2000 and s.harbor.len() == 2)
            assert(place_parcel(s,2,-1) == none) # warehouse/customs precinct
        if s.kind == .monastery and s.legacy < 0: assert(place_parcel(s,1,2) == none)
        if s.kind == .farm:
            farms += 1
            # Farm parcels were once accidentally swallowed by the square exclusion.
            assert(place_parcel(s,1,1) != none)
    loop r in LAND_REGIONS: assert(regions.get(r.id,0) >= 3)
    loop isl in small_islands:
        if max(isl.radii.x,isl.radii.y) >= 1000.0:
            large_islands += 1
            if regions.get(isl.id,0) < 1: print("missing island {isl.id} at {isl.center}")
            assert(regions.get(isl.id,0) >= 1)
    assert(capitals == 2 and farms > 20 and large_islands > 25)

test "roads are reciprocal dry bounded-grade routes on canonical ground":
    load_places()
    assert(settlement_roads.len() > 100)
    loop k in 0..settlement_roads.len():
        road = settlement_roads[k]
        a = world_settlements[settlement_by_id[road.a]]; b = world_settlements[settlement_by_id[road.b]]
        assert(a.region == b.region)
        assert(road.a in b.neighbors and road.b in a.neighbors)
        assert(k in a.roads and k in b.roads)
        assert(length(road.points[0]-a.center) < 0.1)
        assert(length(road.points[road.points.len()-1]-b.center) < 0.1)
        loop j in 0..road.points.len():
            p = road.points[j]
            assert(p.y > 0.0)
            assert(abs(f64(p.y)-surface_height(f64(p.x),f64(p.z))) < 0.02)
            if j > 0:
                prev = road.points[j-1]
                assert(abs(p.y-prev.y) <= length(p.xz-prev.xz)*0.39+0.01)

test "seeded places and routes are independent of source memo and global RNG":
    load_places()
    before = hash(world_settlements); roads = hash(settlement_roads)
    seed_random(93173)
    loop k in 0..120: random()
    init_settlements()
    assert(hash(world_settlements) == before)
    assert(hash(settlement_roads) == roads)
