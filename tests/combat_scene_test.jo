use '../src/combat.jo'
use '../src/combat_bridge.jo'
use '../src/planes.jo'
use '../src/flight.jo'
import '../src/traffic.jo' as air
import '../src/living_world.jo' as living
import '../src/living_scene.jo' as scene
import '../src/pilot.jo' as player
import '../src/combat_sound.jo' as sound

test "scene combat keeps one body commits damage and returns to a route without healing":
    set_speed_scale(1)
    w=living.build_world();models=build_craft_models()
    traffic=air.make_living_traffic(w,models);adapter=scene.SceneAdapter()
    b=Battle(enabled=true)
    observer=w.harbors[0].center
    air.update_traffic(traffic,w,adapter,observer,0,1.0/60.0,battle=b)
    ci=combat_index(b,1)
    assert(ci>=0 and scene.scene_bound(adapter,1))
    person=b.actors[ci].person;people=w.people.len();craft=w.aircraft.len()
    b.actors[ci].state.position+=vec3(0,400,0)
    b.actors[ci].state.velocity=vec3(0,0,-65);b.actors[ci].state.on_water=false
    b.actors[ci].state.moored=false
    observer=b.actors[ci].state.position
    apply_bullet_hit(b,ci,.body,observer,vec3(0,0,1),0.2,0)
    assert(combat_owns(b,1))
    fuel=b.actors[ci].state.fuel
    trip=w.aircraft[1].trip
    w.trips[trip].incident_at_mm=0;w.trips[trip].incident_resolved=false
    loop i in 0..30:air.update_traffic(traffic,w,adapter,observer,f64(i)/60.0,1.0/60.0,battle=b)
    assert(combat_owns(b,1) and not w.trips[trip].incident_resolved and w.aircraft[1].trip==trip)
    w.trips[trip].incident_at_mm=-1
    health=b.actors[ci].state.damage.parts[0].health
    assert(w.aircraft[1].hull<1000 and b.actors[ci].state.fuel<fuel)
    assert(air.traffic_for_craft(traffic,1)!.state==b.actors[ci].state)
    b.actors[ci].external=true;b.actors[ci].gun.locked=true
    loop i in 0..30:air.update_traffic(traffic,w,adapter,observer,f64(i)/60.0,1.0/60.0,battle=b)
    assert(b.actors[ci].state.damage.parts[0].health<=health)
    # A route-flight save keeps the marker that prevents the legacy wear map healing parts.
    saved_world=w;saved_traffic=traffic;saved_adapter=adapter
    air.fold_traffic_for_save(saved_traffic,saved_world,saved_adapter)
    snapshot=from_text[air.SceneFlightSnapshot](saved_world.aircraft[1].scene_extension)
    assert(snapshot is air.SceneFlightSnapshot and snapshot.combat_damage)
    assert(bail_combatant(b,ci))
    # Even an empty tank/total wreck must stay here while this same pilot is in the canopy.
    b.actors[ci].state.fuel=0
    loop mut part in b.actors[ci].state.damage.parts:part.health=0
    refresh_damage(b.actors[ci].spec,b.actors[ci].state)
    loop i in 0..120:air.update_traffic(traffic,w,adapter,observer,f64(i)/60.0,1.0/60.0,battle=b)
    assert(b.descents.len()==1 and b.descents[0].person==person)
    assert(w.people.len()==people and w.aircraft.len()==craft)
    assert(w.aircraft[1].trip==trip and w.aircraft[1].move_owner==.scene and w.aircraft[1].hull==0 and w.aircraft[1].fuel_ml==0)
    print("scene chute at {b.descents[0].position}, wreck at {b.actors[ci].state.position}, phase {b.descents[0].phase}")
    assert(b.descents[0].position.y>100 and b.actors[ci].state.position!=b.descents[0].position)
    assert(living.invariant_errors(w).len()==0)

test "human frame interpolation preserves hits and detached pieces across fixed substeps":
    w=living.build_world();models=build_craft_models()
    traffic=air.make_living_traffic(w,models);adapter=scene.SceneAdapter()
    p=player.make_flyer(.gull,0,models[0].contacts,w.harbors[0].docks[0],0)
    air.bind_living_player(p,w,adapter)
    unmoor(p.state);p.state.position+=vec3(0,400,0);p.state.on_water=false;p.state.velocity=vec3(0,0,-65)
    b=Battle(enabled=true)
    ci=register_combat_body(b,w,0,p.spec,p.state,true)
    p.state.fuel=0
    air.update_traffic(traffic,w,adapter,p.state.position,0,1.0/60.0,p.state,battle=b)
    assert(w.aircraft[0].move_owner==.scene and w.aircraft[0].fuel_ml==0 and w.aircraft[0].trip>=0 and not b.actors[ci].down_reported)
    apply_bullet_hit(b,ci,.left_wing,p.state.position,vec3(0,0,1),2,1)
    air.update_traffic(traffic,w,adapter,p.state.position,0,3.0/60.0,p.state,battle=b)
    assert(not b.actors[ci].state.damage.parts[int(PartId.left_wing)].attached)
    assert(b.actors[ci].state.damage.debris.len()>0 and w.aircraft[0].hull<1000)
    assert(b.actors[ci].external and not b.actors[ci].bailed)
    expired=b.actors[ci].state;expired.damage.debris.clear()
    air.update_traffic(traffic,w,adapter,p.state.position,0,1.0/60.0,expired,battle=b)
    assert(b.actors[ci].state.damage.debris.len()==0)
    assert(living.invariant_errors(w).len()==0)

test "combat sounds are finite bounded stereo and gun families differ":
    waves=[loop i in 0..9:sound.combat_wave(i)]
    loop wave in waves:
        assert(wave.samples.len()>1000 and wave.samples.len()%2==0)
        energy=0.0
        loop s in wave.samples:
            assert(s==s and abs(s)<=1)
            energy+=f64(s*s)
        assert(energy>0.1)
    assert(waves[0].samples!=waves[1].samples and waves[1].samples!=waves[2].samples)
    loop i in [5,6]:assert(abs(waves[i].samples[0])<0.001 and abs(waves[i].samples[waves[i].samples.len()-1])<0.001)
