use '../src/objects.jo'
use '../src/port_mesh.jo'
use '../src/town_architecture.jo'

test "stone foundations meet the plaster edge without coincident wall faces":
    loop base in [0.0,2.0,2.01,4.0,18.0]:
        foundation: Vertex3D[]
        port_foundation_mesh(foundation,mat4(),14,12,base)
        if base<=2:
            assert(foundation.len()==0)
            continue
        assert(foundation.len()==36)
        top= -1000.0; bottom=1000.0
        loop v in foundation:
            top=max(top,f64(v.pos.y)); bottom=min(bottom,f64(v.pos.y))
            assert(v.pos.y<= -2.0+0.00001)
        assert(abs(top+2)<0.00001 and abs(bottom+base)<0.00001)
        # Both houses and warehouses use the same -2 m plaster bottom.
        wall: Vertex3D[]
        add_plaster_box(wall,vec3(0,5.5,0),vec3(14,15,12),WALLS[0],mat4())
        loop v in wall: assert(v.pos.y>= -2.0)

test "window reveals and lit panes retain physical separation at every detail tier":
    loop lod in 0..3:
        loop kind in 0..3:
            vs=arch_vertices(kind,lod)
            # Reveal's front is 0.05 m; panes are 0.078 +/- 0.0125 m.
            # Test the actual triangles rather than the positioning constants.
            front= -100.0
            loop v in vs:
                if v.color==rgb(0.15,0.20,0.21): front=max(front,f64(v.pos.z))
            pane=arch_vertices(17,lod)
            back=100.0
            loop v in pane: back=min(back,f64(v.pos.z))
            assert(back-front>0.015)

test "close frontages clear the scaled base openings by real centimetres":
    base: Vertex3D[]
    add_house(base,mat4(),12,12,9,12)
    opening_front=0.0
    loop v in base:
        if v.uv.x>=180 and v.uv.x<=181: opening_front=max(opening_front,f64(v.pos.z)-6)
    # Generated parcels range from 6 to 14 metres deep. Their base mesh scales
    # the old flat openings too; the close kit deliberately keeps real depths.
    loop depth in [6.0,8.0,10.0,12.0,14.0]:
        old_front=opening_front*depth/12
        loop lod in 0..3:
            loop kind in 0..3:
                reveal= -100.0
                loop v in arch_vertices(kind,lod):
                    if v.color==rgb(0.15,0.20,0.21): reveal=max(reveal,f64(v.pos.z)+0.16)
                assert(reveal-old_front>0.069)
        cover= -100.0
        loop v in arch_vertices(16): cover=max(cover,f64(v.pos.z)*0.12+0.14)
        assert(cover-old_front>0.059)
