use '../src/music_synth.jo'

test "concert hall is selected only for classical pieces and clears on seek":
    s=make_music_synth()
    loop piece in 0..7:
        music_load(s,piece)
        assert(s.concert_hall == (piece==0 or piece==1))
        assert(s.hall_early.len() == (if s.concert_hall:2048 else:0))
        music_seek(s,0)
        loop block in 0..10:_=music_render(s,800)
        music_seek(s,0)
        assert(s.reverb_at==0)
        loop value in s.hall_early:assert(value==0)
        loop delay in s.delays:
            loop value in delay:assert(value==0)

test "concert hall tail is finite bounded and decays after its early reflections":
    s=make_music_synth();music_load(s,1);music_seek(s,0)
    early=0.0;middle=0.0;late=0.0
    loop i in 0..8*MUSIC_RATE:
        v=music_concert_hall_sample(s,if i==160:0.5 else:0.0)
        assert(v==v and abs(v)<0.6)
        if i>MUSIC_RATE/2 and i<MUSIC_RATE:early+=v*v
        if i>2*MUSIC_RATE and i<3*MUSIC_RATE:middle+=v*v
        if i>6*MUSIC_RATE:late+=v*v
    assert(early>0.00000001 and middle>early*0.000001)
    assert(middle<early*0.1 and late<middle*0.0001)

test "trumpet lip motion is deterministic across seeks and block boundaries":
    a=make_music_synth();b=make_music_synth()
    music_load(a,1);music_load(b,1)
    loop seconds in [0.0,10.9,13.3,0.0]:
        music_seek(a,seconds);music_seek(b,seconds)
        loop block in 0..20:
            expected=music_render(a,800)
            actual: f64[]
            loop part in 0..32:actual+=music_render(b,25)
            same=expected==actual;assert(same)
    assert(abs(a.lips[0].motion)<=1.0)
