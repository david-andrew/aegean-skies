# The altimeter's two hands: the long one turns once per 1,000 m (hundreds), the short one once per
# 10,000 m (thousands), on the HUD gauge and on every cockpit panel alike.
use '../src/hud.jo'
use '../src/cockpit.jo'
use '../src/flight.jo'
use '../src/planes.jo'

_near = (a: f64, b: f64) -> bool: abs(a - b) < 1e-9

test "the HUD altimeter's hands read hundreds and thousands of metres":
    h = altimeter_hands(1250.0)
    assert(_near(h.0, 0.25) and _near(h.1, 0.125), "{h}")
    h = altimeter_hands(0.0)
    assert(_near(h.0, 0.0) and _near(h.1, 0.0))
    # (past 10,000 m both hands come round again; below the sea they rest at zero)
    h = altimeter_hands(10300.0)
    assert(_near(h.0, 0.3) and _near(h.1, 0.03), "{h}")
    h = altimeter_hands(-20.0)
    assert(_near(h.0, 0.0) and _near(h.1, 0.0))

test "the cockpit altimeter's long hand turns once per thousand metres":
    loop kind in [Craft.gull, Craft.heron]:
        spec = craft_spec(kind, [])
        s = CraftState(position = vec3(0, 1250, 0), velocity = vec3(0, 0, -50))
        assert(_near(cockpit_values(spec, s)[1], 0.25), "{cockpit_values(spec, s)[1]}")
        s.position.y = 3700
        assert(abs(cockpit_values(spec, s)[1] - 0.7) < 1e-4)
