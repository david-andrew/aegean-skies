# A pleasure flight: the stage follows the aircraft (seated, flying once airborne, landed back on
# the water), each moment is spoken of once and not too fast, their house is pointed out, and the
# thanks fit the flight.
use '../src/joyride.jo'

_seated = (nervous: bool) -> Joyride:
    r = ride_begin(7, 2, nervous, vec3(0, 0, 0), vec3(100, 0, 0), true)
    r.stage = .seated
    r

test "only now and then does someone ask":
    n = [loop k in 0..100: if ride_asks(f64(k) / 100.0): 1].len()
    assert(n == 20)

test "the stage follows the aircraft: seated, flying, landed":
    r = _seated(false)
    _ = ride_step(r, RideView(on_water = true, throttle = 0.0), 0.0)
    assert(r.stage == .seated)
    # (the hull settling, off the water a moment: not flying)
    _ = ride_step(r, RideView(height = 3.0, speed = 1.0), 5.0)
    assert(r.stage == .seated)
    # (a skip on the run: off the water a moment, then back on it)
    _ = ride_step(r, RideView(height = 3.0, speed = 18.0), 6.0)
    _ = ride_step(r, RideView(on_water = true, speed = 18.0), 6.5)
    assert(r.stage == .seated)
    _ = ride_step(r, RideView(height = 12.0, climb = 3.0, speed = 30.0), 10.0)
    _ = ride_step(r, RideView(height = 15.0, climb = 3.0, speed = 30.0), 12.0)
    assert(r.stage == .flying and r.flew)
    _ = ride_step(r, RideView(height = 600.0), 20.0)
    assert(r.top >= 600.0)
    # (touching the water at speed and going on: still flying)
    _ = ride_step(r, RideView(on_water = true, speed = 25.0), 30.0)
    _ = ride_step(r, RideView(on_water = true, speed = 24.0), 33.0)
    assert(r.stage == .flying)
    _ = ride_step(r, RideView(on_water = true, speed = 6.0), 34.0)
    _ = ride_step(r, RideView(on_water = true, speed = 6.0), 37.0)
    assert(r.stage == .landed)

test "each moment once, and not one on top of another":
    r = _seated(true)
    a = ride_step(r, RideView(on_water = true), 0.0)
    assert(a.contains("never been up"))
    assert(ride_step(r, RideView(on_water = true), 1.0) == "")
    assert(ride_step(r, RideView(on_water = true), 20.0) == "")
    b = ride_step(r, RideView(on_water = true, throttle = 0.8, speed = 9.0), 30.0)
    assert(b != "" and b != a)

test "their house, pointed out, as the town passes below":
    r = _seated(false)
    r.stage = .flying; r.said = ["up"]
    line = ride_step(r, RideView(height = 200.0, house_near = true, over_town = true), 0.0)
    assert(line.contains("house") and r.pointing_until > 0.0)

test "another town by its name":
    r = _seated(false)
    r.stage = .flying; r.said = ["up"]
    line = ride_step(r, RideView(height = 300.0, place_seen = "Kalyrassa"), 0.0)
    assert(line.contains("Kalyrassa") and not line.contains("{"))

test "the thanks fit the flight":
    r = _seated(true)
    assert(ride_thanks(r).contains("Another time"))
    r.flew = true
    assert(ride_thanks(r).contains("terrified"))
    r.top = 800.0
    assert(ride_thanks(r).contains("whole island"))
    _ = ride_thank(r, 5.0)
    assert(r.stage == .thanked and r.line != "")

test "asked to wait, they wait: a remark or two if it's long, then give up after an hour":
    r = _seated(false)
    ride_wait_begin(r, 100)
    assert(r.stage == .waiting and r.line != "")
    assert(ride_wait_remark(r, 110) == "")
    assert(ride_wait_remark(r, 121) == "Still going up?")
    assert(ride_wait_remark(r, 125) == "")
    assert(ride_wait_remark(r, 141) != "")
    assert(ride_wait_remark(r, 150) == "")
    assert(not ride_wait_over(r, 159, true))
    assert(ride_wait_over(r, 160, true))
    # (the pilot gone from the island: at once)
    q = _seated(false)
    ride_wait_begin(q, 100)
    assert(ride_wait_over(q, 101, false))

test "back aboard, the flight goes on with them":
    r = _seated(false)
    ride_wait_begin(r, 100)
    assert(ride_resume(r, 105) == "Ready when you are." and r.stage == .seated)
    _ = ride_step(r, RideView(height = 12.0, climb = 3.0, speed = 30.0), 10.0)
    _ = ride_step(r, RideView(height = 15.0, climb = 3.0, speed = 30.0), 12.0)
    assert(r.stage == .flying)
    s = _seated(true)
    ride_wait_begin(s, 100)
    assert(ride_resume(s, 140).contains("started to wonder"))

test "another day: they go politely; given up, they say so in passing":
    r = _seated(false)
    assert(ride_put_off(r, 0.0).contains("Another day") and r.stage == .thanked)
    assert(ride_gave_up_line(false).contains("waited") and ride_gave_up_line(true).contains("waited"))

test "offered a flight, they answer out loud, as they are":
    assert(ride_accept_line(false) != "" and ride_accept_line(true) != ride_accept_line(false))

test "a lift to the springs: asked, thanked, and not set down just anywhere":
    a = ride_lift_ask_line(false, "Saryerenos baths", "Agia Marina")
    assert(a.contains("Saryerenos baths") and a.contains("Agia Marina"))
    assert(ride_lift_ask_line(true, "x", "y") != ride_lift_ask_line(false, "x", "y"))
    assert(ride_lift_not_here("Agia Marina").contains("Agia Marina"))
    assert(ride_lift_thanks(true) != ride_lift_thanks(false))
    r = Joyride()
    assert(r.dest == -1 and r.fare == 0)

test "agreeing to a lift, the notebook names the baths and where to land, and keeps them in the live errands":
    note = ride_lift_agreed_note("Anna", "Saryerenos baths", "Agia Marina", "¤1.50")
    assert(note.contains("Saryerenos baths") and note.contains("Agia Marina") and note.contains("Anna") and note.contains("¤1.50"))
    assert(ride_lift_live_line("Anna", "Saryerenos baths", "Agia Marina").contains("Saryerenos baths"))
    r = Joyride()
    # (no ride, a pleasure flight, one given up or done: no line)
    assert(ride_live_line(r, "Anna") == "")
    r.stage = .seated
    assert(ride_live_line(r, "Anna") == "")
    r.dest = 7; r.dest_name = "Agia Marina"; r.dest_site = "Saryerenos baths"
    live = ride_live_line(r, "Anna")
    assert(live.contains("Saryerenos baths") and live.contains("Agia Marina"))
    r.stage = .thanked
    assert(ride_live_line(r, "Anna") == "")
    # (a pleasure flight agreed says so, and that there is no place to go: nothing to land at)
    assert(ride_flight_agreed_note("Anna").contains("Anna"))
