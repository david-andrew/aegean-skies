use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/living_scene_surface.jo'
use '../src/sea_routes.jo'
use '../src/vessel_types.jo'
use '../src/vessels.jo'
use '../src/flight_ground.jo'
use '../src/surface_corners.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled=true; init_settlements(); finish_settlement_registry()

test "scene surface preserves exact canonical values through cache hits and bounded eviction":
    prepare_scene_surface()
    loop k in 0..1400:
        p=if k%7==0: vec2(-117940+f32(k%97),-84920+f32(k%113)) else: vec2(f32((k*7919)%28000)-14000,f32((k*12907)%28000)-14000)
        actual=place_ground(p)
        assert(scene_ground(p)==actual and scene_ground(p)==actual)
        loop draft in [0.35,2.4,6.0]: assert(scene_depth_ok(p,draft)==sea_depth_ok(p,draft))
        assert(scene_surface_corner_count()<=SCENE_SURFACE_CORNERS)

test "cached hull checks retain every draft footprint and real quay rejection":
    prepare_scene_surface(); wet=0; dry=0
    loop k in 0..120:
        p=vec2(f32((k*1319)%16000)-8000,f32((k*1997)%16000)-12000)
        loop kind in 0..18:
            ship=Vessel(id=1,owner=0,kind=VesselKind(kind))
            yaw=f64(k%19)*0.31
            original=vessel_footprint_wet(ship,p,yaw)
            assert(vessel_footprint_using(ship,p,yaw,scene_depth_ok)==original)
            if original: wet+=1
            else: dry+=1
    assert(wet>0 and dry>0)
    submerged_quays=0
    loop s in world_settlements:
        loop dock in s.harbor:
            p=(dock.quay_a+dock.quay_b)*0.5
            if place_ground(p)< -0.71:
                assert(not sea_depth_ok(p,0.35) and not scene_depth_ok(p,0.35))
                submerged_quays+=1
    assert(submerged_quays>0)

test "reloading the canonical bake invalidates scene corners without changing either source":
    prepare_scene_surface()
    points=[loop k in 0..32: ISLANDS[6].center+vec2(f32(k*13+25),f32(k*7+40))]
    before=[loop p in points: scene_ground(p)]
    land_tiles=[]; land_bake_hash=0
    prepare_scene_surface(); changed=false
    loop k in 0..points.len():
        actual=place_ground(points[k]); assert(scene_ground(points[k])==actual)
        if actual!=before[k]: changed=true
    assert(changed)
    assert(load_land(embed('../assets/terrain.bin')))
    prepare_scene_surface()
    loop k in 0..points.len(): assert(scene_ground(points[k])==before[k])

test "legacy flight queries retain submillimetre doubles and each island grid origin":
    sensitive=false
    loop isl in ISLANDS:
        ext=mesh_extent(isl)
        loop k in 0..96:
            x=f64(isl.center.x)+ext*(f64((k*37)%181)/100.0-0.9)+0.000000031
            z=f64(isl.center.y)+ext*(f64((k*61)%181)/100.0-0.9)+0.000000073
            expected=surface_height(x,z)
            assert(cached_legacy_surface(x,z)==expected and flight_surface_height(x,z)==expected)
            if surface_height(x+0.0000001,z)!=expected: sensitive=true
    assert(sensitive)
