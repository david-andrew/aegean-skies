use '../src/flight.jo'
use '../src/combat.jo'
use '../src/lead_marker.jo'

# A round fired along the marked lead, keeping the shooter's velocity and falling under gravity
# as combat's rounds do, passes within a metre of a target holding its course.
miss = (at: vec3, v: vec3, e: vec3, ev: vec3, speed: f64) -> f64:
    dir = normalize(gun_lead(at,v,e,ev,speed))
    p = at; rv = v+dir*f32(speed); q = e; best = 1e9
    # (relative motion, swept per step: a fast round crosses many metres between samples)
    step = 1.0/240.0
    loop _ in 0..480:
        a = p-q
        rv.y -= f32(9.81*step)
        p += rv*f32(step); q += ev*f32(step)
        d = (p-q)-a
        u = clamp(-f64(dot(a,d))/max(f64(dot(d,d)),1e-9),0.0,1.0)
        best = min(best,f64(length(a+d*f32(u))))
    best

test "rounds along the lead meet crossing, closing and climbing targets":
    speed = 420.0*5.0
    loop case in [vec4(400,0,0,180), vec4(700,60,-200,150), vec4(250,-30,120,190), vec4(900,100,0,120)]:
        at = vec3(1000,500,2000); v = vec3(0,0,-160)
        e = at+vec3(case.y,case.z*0.1,-case.x)
        ev = normalize(vec3(1,0.15,f32(case.z)*0.002))*case.w
        m = miss(at,v,e,ev,speed)
        assert(m < 1.0, "lead missed by {m:.2} m for {case}")
    # Slow rounds and a long crossing shot: the drop and the lead both matter.
    m = miss(vec3(0,400,0),vec3(0,0,-60),vec3(0,400,-600),vec3(90,0,0),420.0)
    assert(m < 1.5, "slow rounds missed by {m:.2} m")
    straight = normalize(vec3(0,400,-600)-vec3(0,400,0))
    assert(dot(normalize(gun_lead(vec3(0,400,0),vec3(0,0,-60),vec3(0,400,-600),vec3(90,0,0),420.0)),straight) < 0.99)

test "every hostile in reach is marked, at its lead; friends, the downed and the far are not":
    me = Combatant(1,1,1,CraftSpec(),CraftState(position=vec3(0,500,0),velocity=vec3(0,0,-80)),human=true,external=true)
    far = Combatant(2,2,2,CraftSpec(),CraftState(position=vec3(30,500,-650),velocity=vec3(80,0,0)))
    near = Combatant(3,3,2,CraftSpec(),CraftState(position=vec3(-20,500,-300),velocity=vec3(-80,0,0)))
    wide = Combatant(4,4,2,CraftSpec(),CraftState(position=vec3(300,500,-200),velocity=vec3(0,0,-80)))
    friend = Combatant(5,5,1,CraftSpec(),CraftState(position=vec3(0,500,-150),velocity=vec3(0,0,-80)))
    gone = Combatant(6,6,2,CraftSpec(),CraftState(position=vec3(0,500,-1200),velocity=vec3(0,0,-80)))
    b = Battle(enabled=true,actors=[me,far,near,wide,friend,gone],bullet_scale=5)
    ms = lead_marks(b,1,vec3(0,500,0),vec3(0,0,-80))
    assert(ms.len() == 3)
    assert([loop m in ms: m.craft] == [2,3,4])
    # (each at the meeting point of rounds and target: ahead of the crossing one, along its way)
    m = ms[1]
    assert(f64(m.intercept.x) < -20.0 and f64(m.intercept.x) > -40.0)
    b.actors[2].status = .disabled
    assert(lead_marks(b,1,vec3(0,500,0),vec3(0,0,-80)).len() == 2)

test "the player's own flight is marked from a few kilometres, by eye up close; enemies are not":
    me = Combatant(1,1,1,CraftSpec(),CraftState(position=vec3(0,500,0)),human=true,external=true)
    close = Combatant(2,2,1,CraftSpec(),CraftState(position=vec3(0,500,-80)))
    mid = Combatant(3,3,1,CraftSpec(),CraftState(position=vec3(2000,600,-3000)))
    far = Combatant(4,4,1,CraftSpec(),CraftState(position=vec3(0,500,-7000)))
    beyond = Combatant(5,5,1,CraftSpec(),CraftState(position=vec3(0,500,-9000)))
    enemy = Combatant(6,6,2,CraftSpec(),CraftState(position=vec3(0,500,-2000)))
    b = Battle(enabled=true,actors=[me,close,mid,far,beyond,enemy])
    ms = ally_marks(b,1,vec3(0,500,0))
    # (the near one by eye; the rest marked, out to ALLY_REACH, and the pointer's reach beyond it)
    assert(ms.len() == 3 and ms[1].range < ALLY_REACH and ms[2].range < ALLY_REACH)
    assert(ally_alpha(1000.0) > 0.8 and ally_alpha(ALLY_REACH) < 0.35 and ally_alpha(4000.0) < ally_alpha(3000.0))
    far = Combatant(7,7,1,CraftSpec(),CraftState(position=vec3(0,500,-25000)))
    b.actors.push(far)
    assert(ally_marks(b,1,vec3(0,500,0)).len() == 4)
    b.actors[2].bailed = true
    assert(ally_marks(b,1,vec3(0,500,0)).len() == 3)
    # (the one the flight forms on is the leader, marked as such)
    loop i in 0..b.actors.len():
        if b.actors[i].side == 1 and i != 0 and b.actors[i].craft != 3: b.actors[i].pilot.leader = 3
    b.actors[2].bailed = false
    assert(ally_leader(b,1) == 2)
    ms2 = ally_marks(b,1,vec3(0,500,0))
    lead = [loop m in ms2: if m.leader: m.range]
    assert(lead.len() == 1 and abs(lead[0]-f64(length(vec3(2000,100,-3000)))) < 1.0)
