use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_orders.jo'
use '../src/living_far_checks.jo'
use '../src/living_money.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
use '../src/living_guard.jo'
use 'living_far_economy.jo'

# The slices that report `error` for this world, out of FAR_CHECK_SLICES.
reporting_slices = (w: World, error: str) -> int[]:
    [loop s in 0..FAR_CHECK_SLICES: if validate_far(w,false,s,FAR_CHECK_SLICES)==error: s]

every_slice = () -> int[]: [loop s in 0..FAR_CHECK_SLICES: s]

test "rotated far checks pass a valid world in every slice":
    w=far_fixture()
    assert(w.far.districts[200].target[3]>=0 and far_depart(w,0))
    assert(validate_far(w)=="")
    assert(reporting_slices(w,"")==every_slice())

test "a bad record is found by the full check and by exactly the slice that owns it":
    # District 200 is the second published place, so slice 1 owns its records.
    w=far_fixture(); order=counter_restock_order(w,0,100); order.food_floor= -1
    w.far.districts[200].customer_orders.push(FarCustomerOrder(0,w.minute,order))
    assert(validate_far(w)=="invalid received counter order")
    assert(reporting_slices(w,"invalid received counter order")==[1])
    # A carried paper belongs to its vehicle's slice.
    w=far_fixture(); w.far.vehicles[0].buying_order!.food_floor= -1
    assert(validate_far(w)=="invalid carried restocking order")
    assert(reporting_slices(w,"invalid carried restocking order")==[0])
    # A journey's agreement belongs to its journey's slice.
    w=far_fixture(); w.far.districts[200].target[3]+=20000
    assert(far_depart(w,0)); id=w.far.vehicles[0].journey
    w.far.journeys[id].provenance.need_since=w.minute+5
    assert(validate_far(w)=="invalid underlying work need")
    assert(reporting_slices(w,"invalid underlying work need")==[id%FAR_CHECK_SLICES])

test "conservation, uniqueness and indexes are checked in every slice":
    w=far_fixture(); w.far.districts[100].workers[0]+=1
    assert(reporting_slices(w,"far population conservation")==every_slice())
    w=far_fixture()
    if w.far.districts[100].fields.len()>0:
        w.far.districts[200].fields.push(w.far.districts[100].fields[0])
        assert(reporting_slices(w,"two districts own the same arable parcel")==every_slice())
    w=far_fixture(); w.far.districts[200].target[3]+=20000
    assert(far_depart(w,0)); w.far.journeys[w.far.vehicles[0].journey].link=99999
    assert(reporting_slices(w,"invalid far journey")==every_slice())

test "recovery-mode minutes simulate exactly as strict minutes":
    strict=far_fixture(); strict.far.districts[200].target[3]+=20000
    relaxed=strict
    far_only_minutes(strict,3*1440)
    epoch=living_fault_epoch()
    set_living_strict(false)
    defer set_living_strict(true)
    far_only_minutes(relaxed,3*1440)
    assert(living_fault_epoch()==epoch)
    assert(canonical_text(relaxed)==canonical_text(strict))
    assert(validate_far(relaxed)=="" and money_balances(relaxed) and goods_balance(relaxed))
