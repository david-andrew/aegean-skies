use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_domestic.jo'
use '../src/living_life_seed.jo'
use '../src/living_seed.jo'
use '../src/living_life.jo'
use '../src/living_save.jo'
use '../src/living_sim.jo'
use '../src/living_money.jo'

_domestic_world = () -> World:
    w=build_world()
    w.people[1].action=Action(activity=.wait,purpose=.visit,end_minute=10000)
    home=choose_life_venue(w,0,.home,1)!
    loop kind in [VenueKind.seat,VenueKind.laundry,VenueKind.oven]:
        p=home.pos+vec3(f32(int(kind)-int(VenueKind.seat)+2),0,0)
        w.life_venues.push(LifeVenue(0,"fixture:{kind}",kind,p,capacity=1,prop_pos=p))
    w

test "domestic routines use real fixtures at the right hour and preserve work priority":
    w=_domestic_world(); w.minute=810-EPOCH_LOCAL_MINUTE
    goal=life_daily_goal(w,1)
    assert(goal.venue==.seat and goal.activity==.sit)
    set_life_destination(w,1,goal)
    assert(w.daily_life[1].target==core_domestic(w,1,.seat)!.pos)
    assert(w.daily_life[1].mobility==.walking)
    w.people[1].carriage=999
    assert(life_daily_goal(w,1).activity==.work)
    assert(active_domestic(w,1)==none)
    w.people[1].carriage=-1; w.places[0].harbor_closed=true
    assert(life_daily_goal(w,1).venue==.shelter)
    w.places[0].harbor_closed=false; w.minute=1200-EPOCH_LOCAL_MINUTE
    assert(not domestic_kind(life_daily_goal(w,1).venue))

test "fixture claims do not stack residents and absent geometry keeps the old routine":
    w=_domestic_world(); w.minute=810-EPOCH_LOCAL_MINUTE
    set_life_destination(w,1,life_daily_goal(w,1)); w.tick=w.minute*120
    w.people[3].place=0; w.people[3].home=0
    assert(core_domestic(w,3,.seat)==none)
    w.life_venues=[loop v in w.life_venues: if not domestic_kind(v.kind): v]
    assert(life_daily_goal(w,1).venue==.home)

test "domestic venue and routine state round trips without introducing residents or goods":
    w=_domestic_world(); count=w.people.len(); advance_minutes(w,240)
    w.people[1].action=Action(activity=.wait,purpose=.visit,end_minute=w.minute+60)
    set_life_destination(w,1,life_daily_goal(w,1)); w.tick=w.minute*120
    parsed=from_text[World](canonical_text(w)); assert(parsed is World)
    assert(validate_save_world(parsed)=="")
    assert(canonical_text(parsed)==canonical_text(w))
    assert(parsed.people.len()==count and money_balances(parsed) and goods_balance(parsed))
    advance_minutes(w,20); advance_minutes(parsed,20)
    assert(canonical_text(parsed)==canonical_text(w))
