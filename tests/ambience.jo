use '../src/calendar.jo'
use '../src/ambience.jo'
use '../src/ambience_synth.jo'
use '../src/ambience_scene.jo'
use '../src/vessel_types.jo'
import '../src/living_types.jo' as life
import '../src/living_seed.jo' as seed

flat_beach = (x: f64,z: f64) -> f64: x*0.05
rock_coast = (x: f64,z: f64) -> f64: x*3

test "civil calendar agrees with Sunday routines and has one shared feast list":
    a = calendar_date(0); assert(a.year == 1929 and a.month == 6 and a.day == 3 and a.weekday == 0)
    a = calendar_date(6); assert(a.day == 9 and a.weekday == 6)
    a = calendar_date(-3); assert(a.month == 5 and a.day == 31 and a.weekday == 4)
    a = calendar_date(212); assert(a.year == 1930 and a.month == 1 and a.day == 1)
    assert(calendar_feast(calendar_date(21)) == "Nativity of Saint John")
    assert(calendar_feast(calendar_date(26)) == "Saints Peter and Paul")
    assert(calendar_feast(calendar_date(73)) == "Dormition / Assumption")
    assert(calendar_service_day(6) and calendar_service_day(21) and not calendar_service_day(0))
    a = calendar_date(146097); assert(a.year == 2329 and a.month == 6 and a.day == 3 and a.weekday == 0)
    assert(calendar_leap(2000) and not calendar_leap(1900) and calendar_leap(1932))

test "hour bells and service peals follow the saved epoch without startup catchup":
    assert(ambience_bell_count(0) == 0)
    assert(ambience_bell_count(30) == 10)
    assert(ambience_bell_count(150) == 12)
    assert(ambience_bell_count(6*1440-30) == 16)
    assert(ambience_bell_count(21*1440-30) == 16)
    a = Ambience()
    churches = [AmbienceSource(0,.bell,vec3(0,8,0),0.24,1600)]
    ambience_bells(a,churches,150,10,vec3(0,2,0))
    assert(a.pending.len() == 12)
    assert(a.pending[11].due-a.pending[0].due == 11)
    a.enabled[0] = false; a.pending = []
    ambience_bells(a,churches,150,10,vec3(0,2,0)); assert(a.pending.len() == 0)

test "thunder is delayed from one lightning strike and ignores rewinds expiry and far storms":
    w = seed.build_world(); w.weather = []
    w.weather.push(life.Weather(id=0,kind=.storm,center=vec2(343,0),radius_m=9000,severity=900,born_minute=-1,expires_minute=100))
    a = Ambience()
    ambience_thunder(a,w,1.99,2.01,vec3(0,0,0))
    assert(a.pending.len() == 1 and abs(a.pending[0].due-3) < 0.001)
    ambience_thunder(a,w,2.20,2.24,vec3(0,0,0)); assert(a.pending.len() == 1)
    ambience_thunder(a,w,20,1,vec3(0,0,0)); assert(a.pending.len() == 1)
    a.pending = []; ambience_thunder(a,w,-1,2.01,vec3(0,0,0)); assert(a.pending.len() == 0)
    a.enabled[8] = false; ambience_thunder(a,w,1.99,2.01,vec3(0,0,0)); assert(a.pending.len() == 0)
    a.enabled[8] = true; w.weather[0].expires_minute = 0
    ambience_thunder(a,w,1.99,2.01,vec3(0,0,0)); assert(a.pending.len() == 0)

test "presence counts actual awake bodies and removes departures and carriage occupants":
    w = seed.build_world(); at = vec3(123456,10,123456)
    loop k in 0..w.people.len(): w.people[k].pose.pos = vec3(-100000,0,0)
    w.households = []
    assert(ambience_present(w,at,25) == 0)
    w.people[1].pose.pos = at; w.people[1].trip = -1; w.people[1].carriage = -1; w.people[1].state = .idle
    if 1 in w.daily_life: w.daily_life[1].activity = .talk
    assert(ambience_present(w,at,25) == 1)
    w.people[1].carriage = 2; assert(ambience_present(w,at,25) == 0)
    w.people[1].carriage = -1; w.people[1].state = .resting; assert(ambience_present(w,at,25) == 0)

test "shore sound follows real sea crossings and distinguishes a cliff from a beach":
    p,found,rocky = ambience_coast(vec3(30,2,0),flat_beach)
    assert(found and not rocky and abs(p.x) < 0.3)
    p,found,rocky = ambience_coast(vec3(30,90,0),rock_coast)
    assert(found and rocky and abs(p.x) < 0.3)
    p,found,rocky = ambience_coast(vec3(800,2,0),flat_beach)
    assert(not found)

test "ships sound only while operating and distinguish sails and powered hulls":
    v = Vessel(id=1,kind=.coastal_steamer,owner=-1,side=0,cargo=[],crew=[],position=vec3(0,0,0))
    assert(ambience_ship_source(v,vec3(0,0,5)) == none)
    v.status = .underway; v.speed = 3
    a = ambience_ship_source(v,vec3(0,0,5)); assert(a != none and a!.kind == .ship_engine)
    v.kind = .sail_caique
    a = ambience_ship_source(v,vec3(0,0,-8)); b = ambience_ship_source(v,vec3(0,0,8))
    assert(a!.kind == .luff and a!.gain > b!.gain)
    v.status = .sunk; assert(ambience_ship_source(v,vec3(0,0,5)) == none)

test "voice selection queues and category switches have strict bounds":
    a = Ambience(); sources: AmbienceSource[]; ear = vec3(0,0,0)
    loop k in 0..100:
        s = AmbienceSource(k,AmbienceKind(k%AMBIENCE_KINDS),vec3(f32(k),0,0),0.1,100)
        ambience_offer(sources,s,ear)
        ambience_queue(a,s,f64(k),ear)
    assert(sources.len() == AMBIENCE_LOOPS and a.pending.len() == AMBIENCE_PENDING)
    a.enabled[ambience_category(sources[0].kind)] = false; selected: AmbienceSource[]
    ambience_scene_offer(a,selected,sources[0],ear); assert(selected.len() == 0)
    assert(ambience_score(AmbienceSource(0,.bell,vec3(0,0,0),1,100),vec3(0,100,0)) == 0)
    clear = AmbienceSource(0,.bell,vec3(0,0,0),1,100)
    soft = clear; soft.soft = 1
    assert(ambience_score(soft,ear) < ambience_score(clear,ear)*0.3)
    ambience_hush(a); assert(a.pending.len() == 0 and a.loops.len() == 0 and a.hits.len() == 0 and a.last_time == -1)
    assert(not ambience_period(-1,100,0,10) and not ambience_period(20,1,0,10))

test "all instruments are finite repeatable bounded and do not touch global randomness":
    seed_random(897); expected = random(0.0,1.0); seed_random(897)
    loop kind in 0..AMBIENCE_KINDS:
        s = make_ambience(AmbienceKind(kind)); again = make_ambience(AmbienceKind(kind))
        assert(s.samples == again.samples)
        energy = 0.0
        loop v in s.samples:
            assert(abs(v) <= 0.451)
            energy += f64(v)*f64(v)
        assert(energy > 0.01 and s.samples.len() <= MIX_RATE*9)
        if ambience_loop(AmbienceKind(kind)):
            steps = 0.0
            loop i in 1..s.samples.len()/2: steps += pow(f64(s.samples[i*2]-s.samples[(i-1)*2]),2)
            typical = sqrt(steps/f64(s.samples.len()/2-1))
            assert(abs(s.samples[0]-s.samples[s.samples.len()-2]) < 6*typical+0.002)
        else: assert(abs(s.samples[0]) < 0.001 and abs(s.samples[s.samples.len()-2]) < 0.001)
    assert(random(0.0,1.0) == expected)

test "softening rejects treble and square reflections retain a quiet bounded tail":
    raw = fill(f32(0),MIX_RATE*2)
    loop i in 0..MIX_RATE: raw[i*2] = f32(sin(TAU*5000*f64(i)/f64(MIX_RATE))); raw[i*2+1] = raw[i*2]
    low = ambience_soften(Sound(raw)); energy = 0.0
    loop v in low.samples: energy += f64(v)*f64(v)
    assert(energy/f64(raw.len()) < 0.002)
    impulse = fill(f32(0),MIX_RATE/2); impulse[0] = 0.3; impulse[1] = 0.3
    echo = ambience_square_reverb(Sound(impulse))
    assert(echo.samples.len() > impulse.len() and echo.samples[0] == impulse[0])
    sum = 0.0
    loop i in 2..echo.samples.len(): sum += abs(f64(echo.samples[i]))
    assert(sum > 0.1 and sum < 0.25)

test "headless mixer retires disabled voices and pause clears delayed thunder":
    # Explicit device guard: even the engine playback API uses its silent mixer here.
    assert(env("SLOPPY_NO_AUDIO") != none)
    silence = Sound(fill(f32(0),960))
    a = Ambience(active=true,playback=true,sounds=fill(silence,AMBIENCE_KINDS),soft=fill(silence,AMBIENCE_KINDS))
    loop k in 0..20:
        ambience_offer(a.sources,AmbienceSource(k,AmbienceKind(k),vec3(0,0,0),0.2,100),vec3(0,0,0))
        ambience_queue(a,AmbienceSource(k,AmbienceKind(k),vec3(0,0,0),0.2,100),1.0,vec3(0,0,0))
    ambience_mix(a,vec3(0,0,0),0.1,1.0,false)
    assert(a.loops.len() <= AMBIENCE_LOOPS and a.hits.len() <= AMBIENCE_HITS)
    a.enabled = fill(false,AMBIENCE_CATEGORIES)
    loop k in 0..20: ambience_mix(a,vec3(0,0,0),0.1,1.1+f64(k)*0.1,true)
    assert(a.hits.len() == 0 and a.loops.len() == 0 and a.pending.len() == 0)
    a.enabled[8] = true
    ambience_queue(a,AmbienceSource(1,.thunder,vec3(0,0,0),0.3,1000),20,vec3(0,0,0))
    ambience_hush(a); assert(a.pending.len() == 0 and a.last_time == -1)

test "world scan counts changing crowds and only schedules crossed hour boundaries":
    w = seed.build_world(); w.weather = []
    at = vec3(1000000,5,1000000)
    loop k in 0..w.people.len(): w.people[k].pose.pos = vec3(0,0,0)
    w.households = []
    scene = AmbienceScene(sound=Ambience(active=true),center=at,registry_size=0)
    scene.sites = [AmbienceSite(20,1,at),AmbienceSite(21,0,at+vec3(0,8,0))]
    w.minute = 30; w.tick = 3600
    ambience_scene_step(scene,w,VesselFleet(),[],[],at,0.1,false,vec3(0,0,0))
    assert(scene.sound.sources.len() == 0 and scene.sound.pending.len() == 0)
    scene.previous_scan = 59.6; scene.sound.last_time = 59.9; scene.sound.refresh = 0
    ambience_scene_step(scene,w,VesselFleet(),[],[],at,0.1,false,vec3(0,0,0))
    assert(scene.sound.pending.len() == 10)
    w.people[1].pose.pos = at; w.people[1].trip = -1; w.people[1].carriage = -1; w.people[1].state = .idle
    if 1 in w.daily_life: w.daily_life[1].activity = .talk
    w.tick = 3630; scene.sound.refresh = 0
    ambience_scene_step(scene,w,VesselFleet(),[],[],at,0.1,false,vec3(0,0,0))
    assert(scene.sound.sources.len() == 1 and scene.sound.sources[0].kind == .murmur)
    assert(scene.sound.pending.len() == 10) # no second peal in the same minute
    w.people[1].trip = 10; w.tick = 3660; scene.sound.refresh = 0
    ambience_scene_step(scene,w,VesselFleet(),[],[],at,0.1,false,vec3(0,0,0))
    assert(scene.sound.sources.len() == 0)
    w.tick = 0; w.minute = 0
    ambience_scene_step(scene,w,VesselFleet(),[],[],at,0.1,false,vec3(0,0,0))
    assert(scene.sound.pending.len() == 0)
