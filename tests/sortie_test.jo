use '../src/sortie.jo'
import '../src/living_types.jo' as data
import '../src/life_types.jo' as social

test "the dawn patrol goes out at six while at war, once a day; a loose V; the leader eases onto each leg":
    assert(patrol_due(true, PATROL_MINUTE, 3, 2))
    assert(not patrol_due(true, PATROL_MINUTE - 1, 3, 2))
    assert(not patrol_due(true, PATROL_MINUTE + PATROL_WINDOW, 3, 2))
    assert(not patrol_due(true, PATROL_MINUTE + 10, 3, 3))
    assert(not patrol_due(false, PATROL_MINUTE + 10, 3, 2))
    assert(f64(length(patrol_offset(0))) < 0.01)
    # (the wings back and either side of the leader)
    assert(f64(patrol_offset(1).x) < 0.0 and f64(patrol_offset(2).x) > 0.0 and f64(patrol_offset(1).z) > 0.0)
    assert(compass_word(vec3(0, 0, -1)) == "north" and compass_word(vec3(1, 0, 0)) == "east" and compass_word(vec3(-1, 0, 1)) == "south-west")
    # (a turn of at most PATROL_TURN a second toward the leg's end)
    h = patrol_steer(0.0, vec3(0, 0, 0), vec3(1000, 0, 0), 1.0)
    assert(abs(h - PATROL_TURN) < 1e-9)
    near = patrol_steer(1.5, vec3(0, 0, 0), vec3(1000, 0, 0), 1.0)
    assert(abs(near - PI / 2.0) < PATROL_TURN)

test "the patrol flies only while Kalyra and Orenthia are at war":
    w = data.World()
    assert(not patrol_at_war(w))
    w.diplomacy.push(social.DiplomaticRelation(1, 2, tension = 300, stage = .calm))
    assert(not patrol_at_war(w))
    w.diplomacy[0].stage = .war
    assert(patrol_at_war(w))
