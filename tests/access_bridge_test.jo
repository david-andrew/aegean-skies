use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/access_bridges.jo'
use '../src/objects.jo'
use '../src/world_point.jo'
use '../src/living_feeder_bake.jo'
use '../src/water_field.jo'

test "inherited river crossings carry a cart and a precise walker above unchanged flowing water":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true;init_settlements()
    loop bridge in ACCESS_BRIDGES:
        assert(feeder_segment_clear(bridge.a,bridge.b),"bridge bank approach is too steep")
        axis=normalize(bridge.b.xz-bridge.a.xz);n=int(ceil(f64(length(bridge.b.xz-bridge.a.xz))/0.12))
        point=world_point(bridge.a);point.y=walk_height([],point.x,point.z)
        wet=0
        loop k in 0..n:
            point=walk_step_precise([],point,axis*0.12)
            r=water_at(point.x,point.z)
            if r.wet and place_ground(vec2(f32(point.x),f32(point.z)))<r.level:
                wet+=1;assert(point.y>r.level+4,"bridge clearance {point} water {r.level}")
        assert(length(world_vec(point).xz-bridge.b.xz)<0.3,"walker stalled on a bridge")
        assert(wet>100,"bridge does not cross the surveyed river")
