# Whoever the pilot talks with is held by the scene for the conversation (src/scene_hold.jo: the
# movement lease kept, the saved plan untouched), and what calls them away (src/talk_hold.jo).
# The game itself, played through a held conversation: tests/talk_hold_test.py.
import '../src/living_world.jo' as living
import '../src/living_types.jo' as data
import '../src/life_types.jo' as life_data
import '../src/living_life.jo' as daily
import '../src/living_scene.jo' as clock
import '../src/life_scene.jo' as scene
import '../src/cargo_scene.jo' as cargo
import '../src/living_portage.jo' as porter
import '../src/living_save.jo' as saves
import '../src/objects.jo' as objects
import '../src/world.jo' as land
use '../src/scene_hold.jo'
use '../src/talk_hold.jo'

_frame = (w: mut data.World, towns: objects.Town[]):
    clock.scene_clock_begin(w)
    cargo.step_cargo_scene(w,towns,w.harbors[0].center,1.0/60.0)
    scene.step_life_scene(w,towns,w.harbors[0].center,1.0/60.0)
    clock.scene_clock_end(w)

test "a held walker stands under the scene's lease with their plan untouched, turns, and walks on when let go":
    w = living.build_world()
    towns = [loop s in land.SETTLEMENTS: objects.build_town(s)]
    cargo.configure_cargo_scene(w,towns); scene.configure_life_scene(w,towns)
    daily.life_minute(w)
    # (walking first, as tests/life_scene.jo has them)
    start = w.people[1].pose.pos
    loop k in 0..90: _frame(w,towns)
    assert(length(w.people[1].pose.pos.xz-start.xz) > 0.5 and w.daily_life[1].scene_owned)
    plan = w.daily_life[1]
    stood = w.people[1].pose.pos
    # (the pilot beside them, off to one side of their way)
    nose = quat_rotate(w.people[1].pose.rot,vec3(0,0,-1))
    pilot = stood+vec3(nose.z,0,-nose.x)*2.0
    scene_hold(1,pilot)
    loop k in 0..120:
        _frame(w,towns)
        assert(w.people[1].pose.pos == stood)
        assert(w.daily_life[1].scene_owned and w.people[1].move_owner == .scene)
    # (the day's plan as it was: where to, by which way, how far along)
    held = w.daily_life[1]
    assert(held.route == plan.route and held.waypoint == plan.waypoint and held.target == plan.target)
    assert(held.path_revision == plan.path_revision and held.routed_revision == plan.routed_revision)
    assert(held.activity == plan.activity and held.venue == plan.venue and not held.arrived and held.blocked == "")
    # (turned to the pilot)
    to = pilot-stood
    assert(abs(angle_difference(pose_yaw(w.people[1].pose),atan2(f64(to.x),f64(to.z)))) < 0.02)
    # (a save in the middle of the talk folds the lease as ever, where they stand)
    kept = w
    scene.fold_life_for_save(kept); porter.fold_carriage_for_save(kept)
    assert(kept.people[1].pose.pos == stood and not kept.daily_life[1].scene_owned and saves.validate_save_world(kept) == "")
    scene_release()
    assert(not scene_holds(1))
    loop k in 0..90: _frame(w,towns)
    assert(length(w.people[1].pose.pos.xz-stood.xz) > 0.5)
    # (and on along the same way, not a new one)
    assert(w.daily_life[1].path_revision == plan.path_revision and w.daily_life[1].route == plan.route)

test "a seated person is held without being turned":
    w = living.build_world()
    before = w.people[3].pose.rot
    scene_hold(3,w.people[3].pose.pos+vec3(2,0,0),false)
    scene_hold_step(w,3,0.5)
    assert(w.people[3].pose.rot == before and scene_holds(3) and not scene_holds(1))
    scene_release()
    assert(not scene_holds(3) and not scene_holds(-1))

# (someone free, in a town, with a day)
_free = (w: data.World) -> int:
    loop p in 1..w.people.len():
        if p != w.player and p in w.daily_life and talk_errand(w,p) == .none and w.people[p].far_home < 0: return p
    -1

test "what calls someone away: work beginning, the bell, bed, someone waiting; a stroll does not":
    w = living.build_world()
    daily.life_minute(w)
    who = _free(w)
    assert(who > 0)
    at = w.people[who].pose.pos
    intent = w.daily_life[who]
    intent.activity = .stroll; intent.venue = .square; intent.arrived = true; intent.target = at
    intent.meeting = -1; intent.companion = -1; intent.path_revision = 4
    w.daily_life[who] = intent
    h = talk_hold_begin(w,who)
    assert(h.person == who and h.bound == .none and h.planned and talk_hold_step(w,h) == .none)
    # (the same part of the day, however long: they stay)
    w.minute += 600
    assert(talk_hold_step(w,h) == .none)
    # (a new stroll, somewhere else: it waits for the conversation)
    intent.path_revision = 5; intent.target = at+vec3(40,0,0); intent.arrived = false
    w.daily_life[who] = intent
    assert(talk_hold_step(w,h) == .none)
    # (work beginning across the town)
    loop want in [(life_data.LifeActivity.work,TalkCall.work),(life_data.LifeActivity.pray,TalkCall.prayer),(life_data.LifeActivity.sleep,TalkCall.bed)]:
        intent.path_revision += 1; intent.activity = want.0
        w.daily_life[who] = intent
        assert(talk_hold_step(w,h) == want.1, "{want.0}")
        # (said once: the same part of the day does not call again)
        assert(talk_hold_step(w,h) == .none)
    # (the same work given a new spot to stand on is no new call)
    intent.path_revision += 1; intent.activity = .work; intent.target = at+vec3(60,0,0)
    w.daily_life[who] = intent
    assert(talk_hold_step(w,h) == .work)
    intent.path_revision += 1; intent.target = at+vec3(62,0,0)
    w.daily_life[who] = intent
    assert(talk_hold_step(w,h) == .none)
    # (work where they already stand calls nobody: a merchant at her stall)
    intent.path_revision += 1; intent.activity = .work; intent.venue = .market; intent.target = at+vec3(1,0,0)
    w.daily_life[who] = intent
    assert(talk_hold_step(w,h) == .none)
    # (someone waiting for them by arrangement)
    other = if who == 1: 2 else: 1
    intent.path_revision += 1; intent.activity = .talk; intent.meeting = 0; intent.companion = other; intent.target = at+vec3(30,0,0)
    w.daily_life[who] = intent
    assert(talk_hold_step(w,h) == .meeting)
    assert(talk_waiting_name(w,who) == split(w.people[other].name," ")[0])

test "a world just begun gives its first plan without calling anyone away":
    w = living.build_world()
    who = 1
    w.daily_life[who] = life_data.DailyIntent(who,w.people[who].place,target=w.people[who].pose.pos)
    h = talk_hold_begin(w,who)
    assert(not h.planned)
    intent = w.daily_life[who]
    intent.path_revision = 1; intent.activity = .work; intent.target = w.people[who].pose.pos+vec3(50,0,0)
    w.daily_life[who] = intent
    assert(talk_hold_step(w,h) == .none and h.planned)
    # (the next part of the day is theirs to be called by)
    intent.path_revision = 2; intent.venue = .workshop
    w.daily_life[who] = intent
    assert(talk_hold_step(w,h) == .work)

test "a load taken up, a boat, and someone already under a load who spares a quarter of an hour":
    w = living.build_world()
    daily.life_minute(w)
    who = _free(w)
    h = talk_hold_begin(w,who)
    assert(h.errand == .none and h.bound == .none)
    # (a load in hand since the talk began)
    w.people[who].carrying = 0
    assert(talk_errand(w,who) == .load and talk_hold_step(w,h) == .load)
    # (stopped already under the load: they spare the pilot a while, then say so)
    busy = talk_hold_begin(w,who)
    assert(busy.errand == .load and busy.bound == .load and talk_hold_step(w,busy) == .none)
    w.minute += TALK_SPARE_MINUTES-1
    assert(talk_hold_step(w,busy) == .none)
    w.minute += 1
    assert(talk_hold_step(w,busy) == .load)
    w.people[who].carrying = -1
    # (their boat: always, at once)
    w.people[who].trip = 0
    assert(talk_errand(w,who) == .boat and talk_hold_step(w,h) == .boat)
    w.people[who].trip = -1
    # (someone the scene could not hold, walked on from where they stood)
    free = talk_hold_begin(w,who)
    w.people[who].pose.pos = w.people[who].pose.pos+vec3(f32(TALK_AWAY_METRES-0.5),0,0)
    assert(talk_hold_step(w,free) == .none)
    w.people[who].pose.pos = w.people[who].pose.pos+vec3(1,0,0)
    assert(talk_hold_step(w,free) == .away)
    nobody = TalkHold()
    assert(talk_hold_step(w,nobody) == .none)

test "a parting line for each call, short and plain, and the hold lasting through it":
    seen: str[]
    loop call in [TalkCall.boat,TalkCall.load,TalkCall.work,TalkCall.prayer,TalkCall.bed,TalkCall.meeting,TalkCall.away]:
        loop person in [4,7]:
            line = talk_call_line(call,person,"Eleni")
            assert(line != "" and char_count(line) <= 44 and (line.ends_with(".")), line)
            assert(not line.lower().contains("quay") and not (line in seen), line)
            seen.push(line)
    assert(talk_call_line(.meeting,4,"Eleni").starts_with("Eleni is waiting") and talk_call_line(.meeting,4) == "I'm expected. Another time.")
    assert(talk_call_line(.none,4) == "")
    # (held through the conversation, their parting line and a moment after it; then let go while
    # the panel still shows the line, which shuts by itself a few seconds on)
    h = TalkHold(5)
    assert(talk_holds(h,10.0) and not talk_holds(TalkHold(),10.0))
    h.call = .work
    assert(talk_holds(h,10.0))
    h.call_at = 12.0
    assert(talk_holds(h,12.0+TALK_PART_SECONDS-0.1) and not talk_holds(h,12.0+TALK_PART_SECONDS+0.1))
    assert(TALK_LEAVE_SECONDS > TALK_PART_SECONDS+1.0)
