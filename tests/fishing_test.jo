# Fishing from a dock: the float, the strike, the fish in the hand and the bucket (outside the
# living world's stock), then sold at the market or grilled and eaten (production into the stock
# and straight out of the pocket), with the goods and the money balanced at every step.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/fishing.jo'

_total = (w: World) -> int:
    t = 0
    loop a in w.accounts: t += a.cents
    t

# wait for the bite (or not), strike, and return what was landed
_fish = (a: mut Angling, seed: u64, strike_at: f64) -> Catch?:
    fishing_cast(a, seed, 600)
    loop k in 0..4000:
        strike = a.stage == 3 and a.clock >= strike_at or (strike_at < 0.0 and a.stage == 2 and a.clock > 1.0)
        if let c = fishing_step(a, 1.0 / 60.0, strike): return c
        if a.stage == 4 or a.stage == 0: return none
    none

test "the float bites after a while; strike while it is under, not before or after":
    a = Angling()
    got = 0; early = 0; late = 0
    loop k in 0..20:
        if let c = _fish(a, u64(k), 0.4):
            got += 1
            assert(c.grams >= FISH_KINDS[c.kind].lo and c.grams <= FISH_KINDS[c.kind].hi)
    assert(got == 20)
    loop k in 0..10:
        if _fish(a, u64(k), -1.0) == none: early += 1
    assert(early == 10 and a.line.contains("Too soon"))
    loop k in 0..10:
        if _fish(a, u64(k), STRIKE_WINDOW + 0.2) == none: late += 1
    assert(late == 10)
    # (it bites sooner at dusk than at noon)
    dusk = 0.0; noon = 0.0
    loop k in 0..50:
        dusk += fishing_wait(u64(9), k, 19 * 60)
        noon += fishing_wait(u64(9), k, 13 * 60)
    assert(dusk < noon)

test "a fish in the hand: into a bucket within reach, or back into the sea":
    h = FishHold()
    assert(not fish_in_hand(h))
    assert(fish_take(h, Catch(1, 240)))
    assert(not fish_take(h, Catch(0, 60)))         # (one at a time)
    assert(not fish_into_bucket(h, 0))             # (no bucket here)
    if let c = fish_throw_back(h): assert(c.kind == 1)
    else: assert(false)
    assert(not fish_in_hand(h) and fish_throw_back(h) == none)
    k = fish_new_bucket(h, 0, 0, BUCKET_DOWN, vec3(1, 1.2, 2), 0.0, vec3(1, 1.2, 2), 0.0)
    loop j in 0..BUCKET_FISH:
        assert(fish_take(h, Catch(j % FISH_KINDS.len(), 100 + j * 50)))
        assert(fish_into_bucket(h, k))
    assert(fish_take(h, Catch(0, 70)))
    assert(not fish_into_bucket(h, k) and fish_in_hand(h))   # (a bucket holds a handful)
    assert(fish_words(h.buckets[k].pail).contains("a sardine"))
    # (what one has about one: the hand, and the bucket only once it's carried)
    assert(fish_count(h) == 1)
    h.carrying = h.buckets[k].id; h.buckets[k].where = BUCKET_CARRIED
    assert(fish_count(h) == BUCKET_FISH + 1)
    assert(fish_hold_error(h) == "")
    # (the plate: the fish in the hand, else small ones from the bucket until there's enough)
    assert(fish_plate(h) == [0])
    _ = fish_throw_back(h)
    plate = fish_plate(h)
    assert(plate.len() >= 1 and fish_grams([loop i in plate: fish_pail(h)[i]]) >= PLATE_GRAMS)

test "the catch is outside the stock until sold at the market or eaten, then balanced":
    w = build_world(u64(3))
    p = w.player
    place = w.people[p].place
    assert(place >= 0)
    assert(goods_balance(w) and validate_save_world(w) == "")
    money = _total(w)
    stock = w.goods_ledger.created[FISH]
    h = FishHold()
    # (a bucket bought at the chandler's: money moves, nothing is made; it waits on the counter)
    cash0 = w.accounts[w.people[p].account].cents
    counter = vec3(5, 1.2, 5)
    k = fish_buy_bucket(w, h, w.maps.shops["porto-chandler"].account, place, counter, 0.0)
    assert(k >= 0 and h.buckets[k].where == BUCKET_DOWN and h.buckets[k].at == counter and h.carrying < 0)
    assert(w.accounts[w.people[p].account].cents == cash0 - BUCKET_CENTS and _total(w) == money)
    assert(fish_pick_up(w, h, k) and h.carrying == h.buckets[k].id)
    loop j in 0..5:
        assert(fish_take(h, Catch(j % FISH_KINDS.len(), 300 + j * 90)))
        assert(fish_into_bucket(h, k))
    assert(fish_take(h, Catch(4, 610)))
    # holding them changes nothing in the world
    assert(w.goods_ledger.created[FISH] == stock and fishing_tally(Angling()) == "Nothing yet.")
    assert(goods_balance(w) and validate_save_world(w) == "")
    # the kitchen grills the fish in the hand: made and eaten, the cook's charge to the house
    keeper = w.people[6].account
    eaten = fish_grill(w, h, keeper)
    assert(eaten == 610 and not fish_in_hand(h) and fish_pail(h).len() == 5)
    assert(w.goods_ledger.created[FISH] > stock and w.goods_ledger.consumed[FISH] > 0)
    assert(goods_balance(w) and _total(w) == money)
    # the rest at the market, at its price, through the ledger
    market = w.places[place].market.inventory.qty[FISH]
    cash = w.accounts[w.people[p].account].cents
    pocket = w.people[p].pocket.qty[FISH]
    worth = fish_quote(w, h, place)
    got = fish_sell(w, h)
    assert(got > 0 and abs(got - worth) <= 2)
    assert(fish_count(h) == 0 and h.carrying == h.buckets[k].id)     # (the bucket is still in the hand, empty)
    sold = w.places[place].market.inventory.qty[FISH] - market
    assert(sold > 0 and sold * w.goods[FISH].package_grams <= (300 + 390 + 480 + 570 + 660) * 1000)
    assert(w.people[p].pocket.qty[FISH] == pocket)
    assert(w.accounts[w.people[p].account].cents == cash + got)
    assert(goods_balance(w) and _total(w) == money)
    assert(validate_save_world(w) == "")
    # (nothing to sell, nothing changes)
    assert(fish_sell(w, h) == 0 and goods_balance(w))

test "a bucket is always somewhere: picked up where it is, put down where one stands":
    w = build_world(u64(3))
    h = FishHold()
    mine = fish_new_bucket(h, w.player, 0, BUCKET_LOCKER, vec3(3, 1.2, 4), 0.5, vec3(3, 1.2, 4), 0.5)
    theirs = fish_new_bucket(h, 2, 0, BUCKET_HOME, vec3(9, 1.2, 9), 1.0, vec3(9, 1.2, 9), 1.0)
    # someone else's, at home and not lent: not to be taken
    assert(not fish_pick_up(w, h, theirs))
    # one's own from the locker; down on the dock; it stays where it was left
    assert(fish_pick_up(w, h, mine) and h.buckets[mine].where == BUCKET_CARRIED)
    assert(not fish_pick_up(w, h, mine))           # (already in the hand)
    dock = vec3(20, 1.2, -4)
    assert(fish_put_down(h, dock, 2.0))
    assert(h.carrying < 0 and h.buckets[mine].where == BUCKET_DOWN and h.buckets[mine].at == dock)
    assert(fish_pick_up(w, h, mine))
    assert(fish_put_down(h, vec3(0, 0, 0), 0.0, BUCKET_LOCKER) and h.buckets[mine].where == BUCKET_LOCKER)
    assert(fish_hold_error(h, w.people.len()) == "")

test "borrowing a bucket: friendlier people lend, and they remember it coming back":
    w = build_world(u64(3))
    h = FishHold()
    fisher = 2
    k = fish_new_bucket(h, fisher, 0, BUCKET_HOME, vec3(9, 1.2, 9), 1.0, vec3(9, 1.2, 9), 1.0)
    # a cold acquaintance won't; a warm one will
    seed_relationship(w, fisher, w.player)
    rid = w.relationship_index[RelationshipKey(fisher, w.player)]
    w.relationships[rid].affinity = -300
    no = fish_ask_bucket(w, h, fisher, "by my boat")
    assert(not no.lent and not h.buckets[k].lent)
    w.relationships[rid].affinity = 200
    yes = fish_ask_bucket(w, h, fisher, "by my boat")
    assert(yes.lent and yes.line.contains("by my boat") and h.buckets[k].lent)
    # it is still at their boat: fetched from there, not handed out of the air
    assert(h.buckets[k].where == BUCKET_HOME and h.carrying < 0)
    assert(fish_pick_up(w, h, k))
    # asked again while it's out: no second one
    assert(not fish_ask_bucket(w, h, fisher, "by my boat").lent)
    # brought back the same day: home again, remembered, and they think the better of him
    before = w.relationships[rid].affinity
    _ = fish_take(h, Catch(1, 200)); _ = fish_into_bucket(h, k)
    said = fish_return_bucket(w, h, k)
    assert(said.contains("Thank you") and h.carrying < 0 and h.buckets[k].where == BUCKET_HOME and not h.buckets[k].lent)
    assert(h.buckets[k].pail.len() == 0 and h.buckets[k].at == h.buckets[k].home)
    assert(w.relationships[rid].affinity > before)
    assert(h.loans[fish_loan_index(h, fisher)].returned == 1)
    # kept for days: remembered as late, and next time they'd rather not
    w.relationships[rid].affinity = 20
    assert(fish_ask_bucket(w, h, fisher, "by my boat").lent)
    assert(fish_pick_up(w, h, k))
    w.minute += 3 * 24 * 60
    fish_note_late(w, h)
    assert(h.loans[fish_loan_index(h, fisher)].late == 1)
    said = fish_return_bucket(w, h, k)
    assert(said.contains("at last") and h.loans[fish_loan_index(h, fisher)].late == 1)
    assert(not fish_ask_bucket(w, h, fisher, "by my boat").lent)
    # a chandler would sooner sell one
    shopkeeper = 1
    s = fish_new_bucket(h, shopkeeper, 0, BUCKET_HOME, vec3(2, 1.2, 2), 0.0, vec3(2, 1.2, 2), 0.0)
    seed_relationship(w, shopkeeper, w.player)
    w.relationships[w.relationship_index[RelationshipKey(shopkeeper, w.player)]].affinity = 30
    sold = fish_ask_bucket(w, h, shopkeeper, "by the counter", seller = true)
    assert(not sold.lent and sold.line.contains("sell") and not h.buckets[s].lent)
    assert(fish_hold_error(h, w.people.len()) == "")

test "held fish and every bucket, where it is and whose, are kept by a save":
    h = FishHold(remainder = 17)
    k = fish_new_bucket(h, 0, 0, BUCKET_DOWN, vec3(4, 1.2, -7), 0.5, vec3(1, 1, 1), 0.0)
    _ = fish_take(h, Catch(2, 180)); _ = fish_into_bucket(h, k)
    j = fish_new_bucket(h, 3, 1, BUCKET_HOME, vec3(8, 1.2, 1), 1.5, vec3(8, 1.2, 1), 1.5)
    h.buckets[j].lent = true
    h.loans.push(BucketLoan(owner = 3, lent = 2, returned = 1, late = 1))
    _ = fish_take(h, Catch(6, 1400))
    back = from_text[FishHold](to_text(h))
    if back is FishHold:
        assert(back.remainder == 17 and back.hand.len() == 1 and back.hand[0].grams == 1400)
        assert(back.buckets.len() == 2 and back.buckets[0].at == vec3(4, 1.2, -7) and back.buckets[0].pail[0].kind == 2)
        assert(back.buckets[1].owner == 3 and back.buckets[1].lent and back.buckets[1].where == BUCKET_HOME)
        assert(back.loans[0].late == 1 and fish_hold_error(back) == "")
    else: assert(false)
    # an older save's one bought bucket becomes a bucket of the player's own, where it was
    old = FishHold(bucket = true, pail = [Catch(0, 50)], down = true, at = vec3(2, 1.2, 3))
    fish_upgrade(old, 0)
    assert(old.buckets.len() == 1 and old.buckets[0].owner == 0 and old.buckets[0].where == BUCKET_DOWN and old.buckets[0].pail.len() == 1 and not old.bucket)
    assert(fish_hold_error(old) == "")
    bad = FishHold(carrying = 5)
    assert(fish_hold_error(bad) != "")
