# Fishing from a dock: the float, the strike, the fish in the hand and the bucket (outside the
# living world's stock), then sold at the market or grilled and eaten (production into the stock
# and straight out of the pocket), with the goods and the money balanced at every step.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/fishing.jo'

_total = (w: World) -> int:
    t = 0
    loop a in w.accounts: t += a.cents
    t

# wait for the bite (or not), strike, and return what was landed
_fish = (a: mut Angling, seed: u64, strike_at: f64) -> Catch?:
    fishing_cast(a, seed, 600)
    loop k in 0..4000:
        strike = a.stage == 3 and a.clock >= strike_at or (strike_at < 0.0 and a.stage == 2 and a.clock > 1.0)
        if let c = fishing_step(a, 1.0 / 60.0, strike): return c
        if a.stage == 4 or a.stage == 0: return none
    none

test "the float bites after a while; strike while it is under, not before or after":
    a = Angling()
    got = 0; early = 0; late = 0
    loop k in 0..20:
        if let c = _fish(a, u64(k), 0.4):
            got += 1
            assert(c.grams >= FISH_KINDS[c.kind].lo and c.grams <= FISH_KINDS[c.kind].hi)
    assert(got == 20)
    loop k in 0..10:
        if _fish(a, u64(k), -1.0) == none: early += 1
    assert(early == 10 and a.line.contains("Too soon"))
    loop k in 0..10:
        if _fish(a, u64(k), STRIKE_WINDOW + 0.2) == none: late += 1
    assert(late == 10)
    # (it bites sooner at dusk than at noon)
    dusk = 0.0; noon = 0.0
    loop k in 0..50:
        dusk += fishing_wait(u64(9), k, 19 * 60)
        noon += fishing_wait(u64(9), k, 13 * 60)
    assert(dusk < noon)

test "a fish in the hand: into the bucket, or back into the sea":
    h = FishHold()
    assert(not fish_in_hand(h))
    assert(fish_take(h, Catch(1, 240)))
    assert(not fish_take(h, Catch(0, 60)))         # (one at a time)
    assert(not fish_into_bucket(h))                # (no bucket yet)
    if let c = fish_throw_back(h): assert(c.kind == 1)
    else: assert(false)
    assert(not fish_in_hand(h) and fish_throw_back(h) == none)
    h.bucket = true
    loop k in 0..BUCKET_FISH:
        assert(fish_take(h, Catch(k % FISH_KINDS.len(), 100 + k * 50)))
        assert(fish_into_bucket(h))
    assert(fish_take(h, Catch(0, 70)))
    assert(not fish_into_bucket(h) and fish_in_hand(h))   # (the bucket holds a handful)
    assert(fish_count(h) == BUCKET_FISH + 1)
    assert(fish_words(fish_all(h)).contains("sardines"))
    assert(fish_hold_error(h) == "")
    # (the plate: the fish in the hand, else small ones from the bucket until there's enough)
    assert(fish_plate(h) == [0])
    _ = fish_throw_back(h)
    plate = fish_plate(h)
    assert(plate.len() >= 1 and fish_grams([loop k in plate: h.pail[k]]) >= PLATE_GRAMS)

test "the catch is outside the stock until sold at the market or eaten, then balanced":
    w = build_world(u64(3))
    p = w.player
    place = w.people[p].place
    assert(place >= 0)
    assert(goods_balance(w) and validate_save_world(w) == "")
    money = _total(w)
    stock = w.goods_ledger.created[FISH]
    h = FishHold()
    # (a bucket from the market's own till: money moves, nothing is made)
    cash0 = w.accounts[w.people[p].account].cents
    assert(fish_buy_bucket(w, h, w.places[place].market.account))
    assert(not fish_buy_bucket(w, h, w.places[place].market.account))
    assert(w.accounts[w.people[p].account].cents == cash0 - BUCKET_CENTS and _total(w) == money)
    loop k in 0..5:
        assert(fish_take(h, Catch(k % FISH_KINDS.len(), 300 + k * 90)))
        assert(fish_into_bucket(h))
    assert(fish_take(h, Catch(4, 610)))
    # holding them changes nothing in the world
    assert(w.goods_ledger.created[FISH] == stock and fishing_tally(Angling()) == "Nothing yet.")
    assert(goods_balance(w) and validate_save_world(w) == "")
    # the kitchen grills the fish in the hand: made and eaten, the cook's charge to the house
    keeper = w.people[6].account
    eaten = fish_grill(w, h, keeper)
    assert(eaten == 610 and not fish_in_hand(h) and h.pail.len() == 5)
    assert(w.goods_ledger.created[FISH] > stock and w.goods_ledger.consumed[FISH] > 0)
    assert(goods_balance(w) and _total(w) == money)
    # the rest at the market, at its price, through the ledger
    market = w.places[place].market.inventory.qty[FISH]
    cash = w.accounts[w.people[p].account].cents
    pocket = w.people[p].pocket.qty[FISH]
    worth = fish_quote(w, h, place)
    got = fish_sell(w, h)
    assert(got > 0 and abs(got - worth) <= 2)
    assert(fish_count(h) == 0 and h.bucket)
    sold = w.places[place].market.inventory.qty[FISH] - market
    assert(sold > 0 and sold * w.goods[FISH].package_grams <= (300 + 390 + 480 + 570 + 660) * 1000)
    assert(w.people[p].pocket.qty[FISH] == pocket)
    assert(w.accounts[w.people[p].account].cents == cash + got)
    assert(goods_balance(w) and _total(w) == money)
    assert(validate_save_world(w) == "")
    # (nothing to sell, nothing changes)
    assert(fish_sell(w, h) == 0 and goods_balance(w))

test "a held fish and the bucket's fish are kept by a save":
    h = FishHold(bucket = true, remainder = 17)
    _ = fish_take(h, Catch(2, 180)); _ = fish_into_bucket(h)
    _ = fish_take(h, Catch(6, 1400))
    back = from_text[FishHold](to_text(h))
    if back is FishHold:
        assert(back.bucket and back.remainder == 17 and back.hand.len() == 1 and back.hand[0].grams == 1400 and back.pail.len() == 1 and back.pail[0].kind == 2)
        assert(fish_hold_error(back) == "")
    else: assert(false)
    bad = FishHold(pail = [Catch(0, 50)])
    assert(fish_hold_error(bad) != "")
