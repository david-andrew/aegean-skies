# Fishing from a dock: the float, the strike, and the catch going into the living world's stock
# (production into the pocket at the fish market), sold to the market or grilled and eaten, with
# the goods and the money balanced at every step.
use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'
use '../src/living_save.jo'
use '../src/fishing.jo'

_total = (w: World) -> int:
    t = 0
    loop a in w.accounts: t += a.cents
    t

# wait for the bite (or not), strike, and return what was landed
_fish = (a: mut Angling, seed: u64, strike_at: f64) -> Catch?:
    fishing_cast(a, seed, 600)
    loop k in 0..4000:
        strike = a.stage == 3 and a.clock >= strike_at or (strike_at < 0.0 and a.stage == 2 and a.clock > 1.0)
        if let c = fishing_step(a, 1.0 / 60.0, strike): return c
        if a.stage == 4 or a.stage == 0: return none
    none

test "the float bites after a while; strike while it is under, not before or after":
    a = Angling()
    got = 0; early = 0; late = 0
    loop k in 0..20:
        if let c = _fish(a, u64(k), 0.4):
            got += 1
            assert(c.grams >= FISH_KINDS[c.kind].lo and c.grams <= FISH_KINDS[c.kind].hi)
    assert(got == 20)
    loop k in 0..10:
        if _fish(a, u64(k), -1.0) == none: early += 1
    assert(early == 10 and a.line.contains("Too soon"))
    loop k in 0..10:
        if _fish(a, u64(k), STRIKE_WINDOW + 0.2) == none: late += 1
    assert(late == 10)
    # (it bites sooner at dusk than at noon)
    dusk = 0.0; noon = 0.0
    loop k in 0..50:
        dusk += fishing_wait(u64(9), k, 19 * 60)
        noon += fishing_wait(u64(9), k, 13 * 60)
    assert(dusk < noon)

test "the catch goes into the world's stock as production, then to the market or the table, balanced":
    w = build_world(u64(3))
    p = w.player
    assert(w.people[p].place >= 0)
    assert(goods_balance(w) and validate_save_world(w) == "")
    money = _total(w)
    a = Angling()
    landed = 0
    loop k in 0..12: landed += fishing_land(w, a, Catch(k % FISH_KINDS.len(), 300 + k * 90))
    assert(landed > 0 and fishing_held(w) == landed)
    assert(goods_balance(w))
    assert(validate_save_world(w) == "")
    assert(fishing_tally(a).contains("kilos"))
    # the kitchen grills a plate: fish eaten (recorded), the cook's charge to the house
    keeper = w.people[6].account
    used = fishing_grill(w, keeper)
    assert(used > 0 and fishing_held(w) == landed - used)
    assert(goods_balance(w) and _total(w) == money)
    # the rest to the market, at its price
    market = w.places[w.people[p].place].market.inventory.qty[FISH]
    cash = w.accounts[w.people[p].account].cents
    worth = fishing_worth(w)
    got = fishing_sell(w)
    assert(got > 0 and abs(got - worth) <= worth / 10 + 2)
    assert(fishing_held(w) == 0)
    assert(w.places[w.people[p].place].market.inventory.qty[FISH] == market + landed - used)
    assert(w.accounts[w.people[p].account].cents == cash + got)
    assert(goods_balance(w) and _total(w) == money)
    assert(validate_save_world(w) == "")
