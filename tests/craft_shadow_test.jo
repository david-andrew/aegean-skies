# The aircraft's flat, crisp shadow (src/craft_shadow.jo): how dark and how soft it is with height,
# where its mask lies along the sunlight, and the parts of a model it is cut from.
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/craft_shadow_test.jo
import '../src/craft_shadow.jo' as cs
import '../src/planes.jo' as planes

test "dark and crisp low down, fading and softening with height, gone a few hundred metres up":
    noon = 0.9
    assert(cs.craft_shadow_strength(2.0, noon) == 1.0 and cs.craft_shadow_strength(10.0, noon) == 1.0)
    a50 = cs.craft_shadow_strength(50.0, noon); a150 = cs.craft_shadow_strength(150.0, noon)
    assert(a50 > 0.9 and a150 > 0.3 and a150 < a50)
    assert(cs.craft_shadow_strength(cs.CRAFT_SHADOW_GONE, noon) == 0.0)
    # (a low sun: none at all below 5 degrees, as the sea's and the land's shadows always were)
    assert(cs.craft_shadow_strength(10.0, 0.06) == 0.0 and cs.craft_shadow_strength(10.0, 0.3) == 1.0)
    # (the sun's penumbra: none on the water, under two metres at 150 m, never more than 2.5)
    assert(cs.craft_shadow_soft(0.0) == 0.0 and cs.craft_shadow_soft(2.0) < 0.05)
    assert(abs(cs.craft_shadow_soft(150.0) - 1.8) < 0.001 and cs.craft_shadow_soft(1000.0) == cs.CRAFT_SHADOW_SOFT_MAX)

test "the mask lies under the aircraft along the sunlight":
    sun = normalize(vec3(0.3, 0.8, -0.4))
    focus = vec3(120, 50, -80)
    cs.craft_shadow_begin(focus, sun)
    # (its centre: where the sunlight through the aircraft meets sea level)
    k = vec2(sun.x / sun.y, sun.z / sun.y)
    want = focus.xz - k * focus.y - cs.craft_shadow_origin.xz
    assert(length(cs.craft_shadow_center - want) < 0.2)
    assert(cs.craft_shadow_covers(focus, 6.0) and cs.craft_shadow_covers(focus + vec3(20, 0, 0), 6.0))
    assert(not cs.craft_shadow_covers(focus + vec3(60, 0, 0), 6.0) and not cs.craft_shadow_covers(focus, 45.0))

test "the shadow is cut from the model's own parts":
    m = planes.build_craft(.gull, planes.LIVERIES[0])
    # (the Gull's upper wing reaches 5.5 m; her floats' bottoms 2.5 m below her centre)
    assert(abs(cs.craft_shadow_reach(m) - 5.5) < 0.01)
    assert(cs.craft_shadow_lowest(m) < -2.4 and cs.craft_shadow_lowest(m) > -2.6)
