use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/canal_geometry.jo'
use '../src/objects.jo'
use '../src/town_lights.jo'

_load_tl_world = ():
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_settlements(false, true)
    finish_settlement_registry()

test "staggered dusk turns lamps on before windows and stays off in daylight":
    # Full daylight: every layer strictly zero
    assert(town_light_dusk(0.30, 0.0, TL_LAMP) == 0.0)
    assert(town_light_dusk(0.30, 0.5, TL_CLUSTER) == 0.0)
    assert(town_light_dusk(0.30, 0.5, TL_HALO) == 0.0)
    assert(town_light_dusk(0.30, 0.5, TL_SKYGLOW) == 0.0)
    assert(town_light_dusk(0.05, 0.5, TL_SKYGLOW) == 0.0)
    assert(town_light_dusk(0.12, 0.0, TL_LAMP) == 0.0)
    # Early dusk (just before sunset, sun_y = +0.05): early lamps lit, late windows still dark
    early_lamp = town_light_dusk(0.05, 0.0, TL_LAMP)
    late_lamp = town_light_dusk(0.05, 1.0, TL_LAMP)
    early_win = town_light_dusk(0.05, 0.0, TL_CLUSTER)
    late_win = town_light_dusk(0.05, 1.0, TL_CLUSTER)
    assert(early_lamp > late_lamp)
    assert(early_lamp > early_win)
    assert(late_win < 0.05)
    # Civil twilight (sun_y = -0.04): lamps mostly on, windows partially staggered (not all at once)
    mid_early = town_light_dusk(-0.04, 0.05, TL_CLUSTER)
    mid_late = town_light_dusk(-0.04, 0.95, TL_CLUSTER)
    assert(mid_early > 0.7 and mid_late < 0.4, "expected staggered dusk: early={mid_early} late={mid_late}")
    # Full night (sun_y = -0.50): everything fully lit
    assert(town_light_dusk(-0.50, 0.0, TL_LAMP) > 0.99)
    assert(town_light_dusk(-0.50, 1.0, TL_CLUSTER) > 0.99)
    assert(town_light_dusk(-0.50, 0.5, TL_HALO) > 0.99)
    assert(town_light_dusk(-0.50, 0.5, TL_SKYGLOW) > 0.99)
    # Monotonic rise as sun descends from daylight to night
    prev = 0.0
    loop k in 0..40:
        sy = 0.12 - f64(k) * 0.015
        v = town_light_dusk(sy, 0.5, TL_CLUSTER)
        assert(v >= prev - 1e-9, "non-monotonic cluster dusk at sy={sy}: {v} < {prev}")
        prev = v

test "atmospheric extinction dims lights with distance, haze, fog, rain and overcast":
    # Clear baseline at 10, 25, 40 km from 500 m altitude
    t10, _ = town_light_extinction(10000.0, 500.0, 10.0, 0.00014, 0.0)
    t25, _ = town_light_extinction(25000.0, 500.0, 10.0, 0.00014, 0.0)
    t40, _ = town_light_extinction(40000.0, 500.0, 10.0, 0.00014, 0.0)
    assert(t10 > t25 and t25 > t40 and t40 > 0.10, "clear range: {t10} {t25} {t40}")
    # Hazy air (DayAir.hazy turbidity=0.6) dims 25 km strongly vs clear
    t25_hazy, _ = town_light_extinction(25000.0, 500.0, 10.0, 0.00014, 0.6)
    assert(t25_hazy < t25 * 0.65, "hazy={t25_hazy} clear={t25}")
    # Rain and fog extinguish distant lights severely
    t25_rain, _ = town_light_extinction(25000.0, 500.0, 10.0, 0.00014 * 4.15, 0.45)
    t25_fog, _ = town_light_extinction(25000.0, 500.0, 10.0, 0.00014 * 5.8, 0.45)
    assert(t25_rain < 0.05 and t25_fog < 0.02, "rain={t25_rain} fog={t25_fog}")
    # Overcast deck between camera and town blocks light
    t10_deck, _ = town_light_extinction(10000.0, 2000.0, 10.0, 0.00014, 0.0, 0.0, 0.0, 0.9)
    assert(t10_deck < t10 * 0.20)

test "calm sea reflects harbour lights much more strongly than rough wind or rain":
    c_calm = town_light_calm(1.5, 0.0)
    c_breeze = town_light_calm(6.5, 0.0)
    c_rough = town_light_calm(13.0, 0.0)
    c_rain = town_light_calm(2.0, 0.8)
    assert(c_calm > 0.95)
    assert(c_calm > c_breeze and c_breeze > 0.15)
    assert(c_rough == 0.0, "expected reflection gone in rough sea: {c_rough}")
    assert(c_rain < c_calm * 0.35)
    assert(town_light_roughness(1.0, 0.0) == 0.0)
    assert(town_light_roughness(7.0, 0.0) > 0.5 and town_light_roughness(12.0, 0.0) == 1.0)

test "settlement light layouts follow real extent, scale by size and place coastal reflections":
    _load_tl_world()
    legacy_towns = [loop st in SETTLEMENTS: build_town(st)]
    city_set = TownLightSet()
    town_set = TownLightSet()
    village_set = TownLightSet()
    porto_set = TownLightSet()
    canal_set = TownLightSet()
    lighthouse_set = TownLightSet()
    loop s in world_settlements:
        if s.name == "Kalyrassa": city_set = town_lights_for_settlement(s, legacy_towns)
        else if s.name == "Orenthonia": town_set = town_lights_for_settlement(s, legacy_towns)
        else if s.name == "Kalyaki": village_set = town_lights_for_settlement(s, legacy_towns)
        else if s.name == "Porto Vecchio": porto_set = town_lights_for_settlement(s, legacy_towns)
        else if s.id == CANAL_CITY_ID: canal_set = town_lights_for_settlement(s, legacy_towns)
        else if s.kind == .lighthouse and not lighthouse_set.ready: lighthouse_set = town_lights_for_settlement(s, legacy_towns)
    assert(city_set.ready and town_set.ready and village_set.ready and porto_set.ready and canal_set.ready and lighthouse_set.ready)
    # Visibility ranges scale monotonically: city > town > village
    assert(city_set.max_range > town_set.max_range and town_set.max_range > village_set.max_range)
    assert(city_set.max_range >= 70000.0 and village_set.max_range >= 38000.0)
    # Node counts reflect real settlement size (capital broad spread > port > village handful of points)
    assert(city_set.nodes.len() > town_set.nodes.len() and town_set.nodes.len() > village_set.nodes.len())
    assert(village_set.nodes.len() >= 4 and village_set.nodes.len() <= 12, "village nodes={village_set.nodes.len()}")
    assert(city_set.nodes.len() >= 40, "city nodes={city_set.nodes.len()}")
    assert(porto_set.nodes.len() >= 15 and porto_set.refls.len() >= 1)
    assert(canal_set.nodes.len() >= 25 and canal_set.refls.len() >= 2)
    assert(lighthouse_set.nodes.len() == 1 and lighthouse_set.refls.len() == 1)
    # Coastal harbours carry narrow vertical water reflection streaks; city has more than village
    assert(city_set.refls.len() >= 15 and city_set.refls.len() > village_set.refls.len() and village_set.refls.len() >= 2)
    loop rf in city_set.refls:
        assert(rf.half_width > 2.0 and rf.half_width < 12.0, "expected narrow vertical streak: hw={rf.half_width}")
    # Cities and towns carry a soft sky-glow dome; villages do not
    city_sky = len([loop n in city_set.nodes: if n.kind == TL_SKYGLOW: 1])
    town_sky = len([loop n in town_set.nodes: if n.kind == TL_SKYGLOW: 1])
    vill_sky = len([loop n in village_set.nodes: if n.kind == TL_SKYGLOW: 1])
    assert(city_sky >= 1 and town_sky >= 1 and vill_sky == 0, "sky-glow counts city={city_sky} town={town_sky} vill={vill_sky}")
    # Kalyrassa's light nodes span the city's real extent (>1200 m across, all on dry land)
    lo_x = 1e18; hi_x = -1e18; lo_z = 1e18; hi_z = -1e18
    loop n in city_set.nodes:
        lo_x = min(lo_x, n.x); hi_x = max(hi_x, n.x)
        lo_z = min(lo_z, n.z); hi_z = max(hi_z, n.z)
        assert(n.y_near > 2.0 and n.y_far >= n.y_near)
    span = sqrt((hi_x - lo_x) * (hi_x - lo_x) + (hi_z - lo_z) * (hi_z - lo_z))
    assert(span > 1200.0, "Kalyrassa light span too narrow: {span}")
