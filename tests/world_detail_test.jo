use '../src/geography.jo'
use '../src/world_source.jo'
use '../src/objects.jo'
use '../src/world_groves.jo'
use '../src/world_terrain.jo'

test "source memo matches pure canonical heights through collisions and reload":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    loop k in 0..180:
        x = -144000.0+f64(k%30)*17.13; z = -119000.0+f64(k/30)*31.73
        assert(world_source_sample(x,z).0 == new_land_height(x,z))
        assert(world_source_surface(x,z) == new_land_surface(x,z))
    before = world_source_sample(-144000.0,-119000.0)
    loop k in 0..9000: world_source_point(k-4500,k%91-45)
    assert(world_source_sample(-144000.0,-119000.0) == before)
    assert(load_geography(embed('../assets/world.bin')))
    assert(world_source_sample(-144000.0,-119000.0) == before)
    assert(world_source_points.len() == WORLD_SOURCE_SLOTS)

test "directional erosion is periodic continuous and bounded":
    assert(load_geography(embed('../assets/world.bin')))
    loop k in 0..8:
        loop j in 0..30:
            x = f64(j)*19.371; z = f64(j)*7.131
            a = erosion_basis(k,x,z); b = erosion_basis(k,x+512.0,z-512.0)
            assert(abs(a.0-b.0) < 0.0000001 and abs(a.1-b.1) < 0.0000001)
            assert(abs(a.0) < 50.0 and abs(a.1) <= 1.0)
    ridge_range = 0.0; height_change = 0.0
    loop k in 0..120:
        x = -144000.0+f64(k)*8.0; z = -119000.0
        h,r = new_land_sample(x,z)
        ridge_range = max(ridge_range,abs(r))
        height_change = max(height_change,abs(h-new_land_base(x,z).0))
    assert(ridge_range > 0.1 and height_change > 2.0)

test "island groups have a size tail open water and protected legacy space":
    assert(load_geography(embed('../assets/world.bin')))
    rocks = 0; small = 0; large = 0; low = 0
    groups = [0,0,0,0,0,0]
    loop isl in small_islands:
        groups[isl.group] += 1
        r = f64(max(isl.radii.x,isl.radii.y))
        if r < 300.0: rocks += 1
        else if r < 2000.0: small += 1
        else: large += 1
        if isl.peak <= 35.0: low += 1
        assert(f64(isl.radii.y) <= f64(isl.radii.x)*0.71)
        assert(abs(f64(isl.center.x)) >= LEGACY_RESERVE+r*1.9+1000.0 or abs(f64(isl.center.y)) >= LEGACY_RESERVE+r*1.9+1000.0)
    loop count in groups: assert(count > 5)
    assert(rocks > small and small > large and large >= 8 and low > small_islands.len()/3)
    # Open northern basin and an open southern crossing between island groups.
    loop p in [vec2(0,-95000),vec2(50000,-90000),vec2(25000,125000)]:
        assert(new_land_base(f64(p.x),f64(p.y)).0 < 0.0)

test "shared grove ecology preserves legacy random draw order":
    seed_random(12345)
    expected: int[]
    loop k in 0..1000:
        sl = f64(k%11)*0.07; dens = f64(k%13)*0.08; dh = f64(k%7)*16.0
        kind = -1
        if dh < 45.0 and random() < 0.3: kind = 1
        else if sl < 0.45 and dens > 0.52 and random() < (dens-0.45)*2.2: kind = 0
        else if dens > 0.4 and random() < 0.35: kind = 2
        expected.push(kind)
    after = random()
    seed_random(12345); r = rng(0)
    loop k in 0..1000:
        assert(grove_kind(f64(k%11)*0.07,f64(k%13)*0.08,f64(k%7)*16.0,r,true) == expected[k])
    assert(random() == after)

test "macro derivative shortcut matches the original finite footprint":
    assert(load_geography(embed('../assets/world.bin')))
    loop k in 0..250:
        x = -144000.0+f64(k)*13.87; z = -119000.0+f64(k%13)*7.91
        gx,gz = macro_gradient(x,z)
        dx = (macro_sample(false,x+4.0,z)-macro_sample(false,x-4.0,z))/8.0
        dz = (macro_sample(false,x,z+4.0)-macro_sample(false,x,z-4.0))/8.0
        assert(abs(gx-dx) < 0.000000001 and abs(gz-dz) < 0.000000001)

test "streamed grove instances are reproducible and grounded on canonical terrain":
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    x = int(floor((-112700.0-WORLD_ROOT_ORIGIN)/224.0))
    z = int(floor((-120000.0-WORLD_ROOT_ORIGIN)/224.0))
    a = world_grove_lists(x,z)
    n = 0
    loop kind in a:
        loop tree in kind:
            p = transform_point(tree.model,vec3(0,0,0))
            assert(abs(f64(p.y)-new_land_surface(f64(p.x),f64(p.z))) < 0.02)
            n += 1
    assert(n > 0)
    loop k in 0..9000: world_source_point(k-4500,k%91-45)
    assert(hash(a) == hash(world_grove_lists(x,z)))
