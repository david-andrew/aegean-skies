# End-to-end national causality, with actual paid orders and traveled legs rather than a
# test assigning CrisisStage.war or fabricating a battle/occupation event.
use '../src/living_types.jo'
use '../src/living_war.jo'
use '../src/living_war_contacts.jo'
use '../src/living_far_transport.jo'
use '../src/living_far_news.jo'
use '../src/living_far_economy.jo'
use '../src/living_money.jo'
use '../src/living_war_checks.jo'
use '../src/living_far_checks.jo'
use '../src/living_save.jo'
use 'living_commissions.jo'

campaign_arrive = (w: mut World, unit: int, target: int):
    assert(issue_war_order(w,unit,.patrol,target)>=0)
    war_orders(w)
    vehicle=w.war.units[unit].vehicle
    assert(w.far.vehicles[vehicle].journey>=0)
    w.minute+=50; w.tick=w.minute*120; far_advance_transport(w,w.tick)
    assert(w.far.vehicles[vehicle].place==target)
    war_orders(w)

test "three actual armed border entries reach a council then supplied forces fight and a traveled landing changes control":
    w=commission_fixture(); w.far.links[0].mode=.ship; w.far.vehicles[0].kind=.ship
    a=war_charter(w,0,1); b=war_charter(w,1,2); assert(a>=0 and b>=0)
    war_supply(w,a); war_supply(w,b)
    relation=war_relation(w,1,2); assert(w.diplomacy[relation].stage==.calm)
    loop k in 0..3:
        campaign_arrive(w,a,200)
        war_diplomacy(w)
        if k<2:
            assert(w.diplomacy[relation].stage!=.war)
            campaign_arrive(w,a,100)
    assert(w.diplomacy[relation].stage==.war and w.diplomacy[relation].incident_news.len()==3)
    assert(w.far.vehicles[0].place==200 and w.far.vehicles[1].place==200)
    war_force_notices(w); begin_war_contacts(w)
    assert(w.war.contacts.len()==1 and w.war.occupations_total==0)
    parsed=from_text[World](canonical_text(w)); assert(parsed is World)
    other=parsed
    w.minute+=45; w.tick=w.minute*120; advance_war_contacts(w)
    other.minute=w.minute; other.tick=w.tick; advance_war_contacts(other)
    assert(canonical_text(w)==canonical_text(other))
    contact=w.war.contacts[0]; assert(contact.state==.resolved and w.war.survivors.len()==1)
    winner=contact.winner; country=w.war.units[winner].country
    target=if country==1: 200 else: 100
    vehicle=w.war.units[winner].vehicle
    assert(issue_war_order(w,winner,.occupy,target)>=0)
    war_orders(w)
    if w.far.vehicles[vehicle].journey>=0:
        assert(w.far.districts[target].controller!=country)
        w.minute+=50; w.tick=w.minute*120; far_advance_transport(w,w.tick); war_orders(w)
    assert(w.far.districts[target].controller==country and w.war.occupations_total==1)
    assert(w.far.districts[target].born_country!=country)
    assert(money_balances(w) and goods_balance(w) and far_population(w)==w.far.opening_population)
    # This subsystem fixture advances national journeys, not unrelated core pilot plans.
    assert(validate_war(w)=="" and validate_far(w)=="",validate_war(w)+validate_far(w))
    restored=from_text[World](canonical_text(w))
    assert(restored is World and canonical_text(restored)==canonical_text(w))

test "a border cul-de-sac cannot manufacture repeated armed entries while its patrol remains in the same foreign town":
    w=commission_fixture(); unit=war_charter(w,0,1); assert(unit>=0)
    war_supply(w,unit); campaign_arrive(w,unit,200)
    assert(w.war.evidence.len()==1)
    # The home-side search used to revisit this foreign origin and return it as a new
    # target, creating a zero-length patrol order and another incident every hour.
    target=war_border_destination(w,200,.cart,1,unit)
    assert(target!=200 and target>=0)
    assert(issue_war_order(w,unit,.patrol,200)>=0)
    war_orders(w)
    assert(w.far.vehicles[0].place==200 and w.far.vehicles[0].journey<0)
    assert(w.war.evidence.len()==1 and w.war.units[unit].order<0)
    campaign_arrive(w,unit,100); campaign_arrive(w,unit,200)
    assert(w.war.evidence.len()==2) # another actual traveled entry still counts
    assert(money_balances(w) and goods_balance(w) and validate_war(w)=="" and validate_far(w)=="")
