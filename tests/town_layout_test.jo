use '../src/settlements.jo'
use '../src/geography.jo'
use '../src/world.jo'

assert(load_land(embed('../assets/terrain.bin')))
assert(load_geography(embed('../assets/world.bin')))
geography_enabled = true
init_settlements(false)

test "historic quarters and courtyard suburbs share deterministic varied parcels":
    loop s in world_settlements:
        if s.kind != .capital: continue
        lots = place_lots(s)
        assert(hash(lots) == hash(place_lots(s)))
        assert(lots.len() >= 2000)
        floors: {int: bool} = {}; old = 0; newer = 0; turns: {int: bool} = {}
        loop lot in lots:
            floors[lot.floors] = true; turns[int(lot.yaw*8.0)] = true
            if place_ring_coordinates(s,lot.local).x < f32(place_old_radius(s)+10.0): old += 1
            else: newer += 1
            assert(lot.width >= 7.0 and lot.width <= 18.0 and lot.depth >= 7.0 and lot.depth <= 14.0)
        assert(floors.len() == 4 and turns.len() > 12 and old > 400 and newer > 400)
    village = world_settlements[7]
    assert(village.size < 100)
    loop lot in place_lots(village): assert(length(lot.local-village.old) < 65.0)

test "warped lane inversion and contact find the same rotated footprints as rendering":
    checked = 0
    loop s in world_settlements:
        if s.kind != .capital and s.kind != .fishing: continue
        if s.legacy >= 0: continue
        lots = place_lots(s)
        loop k in 0..lots.len():
            if k%31 != 0: continue
            lot = lots[k]
            found = false
            loop cell in place_candidate_cells(s,lot.local):
                if let candidate = place_lot(s,cell.0,cell.1):
                    if candidate.seed == lot.seed: found = true; break
            assert(found)
            if let parcel = place_ground_lot(s,lot):
                far = place_ground_lot(s,lot,false)
                assert(far != none and length(far!.at.xz-parcel.at.xz) < 0.01)
                outside = settlement_avoid_buildings(parcel.at.xz)
                right = vec2(f32(cos(parcel.yaw)),f32(-sin(parcel.yaw)))
                forward = vec2(f32(sin(parcel.yaw)),f32(cos(parcel.yaw)))
                lane = normalize(place_to_world(s,lot.local+vec2(f32(cos(lot.yaw)),f32(sin(lot.yaw))))-place_to_world(s,lot.local))
                assert(abs(dot(lane,right)) > 0.999)
                d = outside-parcel.at.xz
                if abs(dot(d,right)) < f32(parcel.width*0.5) and abs(dot(d,forward)) < f32(parcel.depth*0.5): print("contact failed {s.name} lot={lot} at={parcel.at} outside={outside}")
                assert(abs(dot(d,right)) >= f32(parcel.width*0.5) or abs(dot(d,forward)) >= f32(parcel.depth*0.5))
                checked += 1
        if checked > 160: break
    assert(checked > 100)


test "square inventories vary deterministically and advertised venues match furniture":
    signatures: {u64:bool} = {}
    loop s in world_settlements:
        if s.legacy >= 0 or s.kind == .farm or s.kind == .lighthouse or s.kind == .chapel: continue
        plan = place_square(s)
        assert(hash(plan) == hash(place_square(s)))
        signatures[hash(plan)] = true
        cafes = 0; reported = 0
        loop p in plan.props:
            assert(p.scale > 0 and abs(p.local.x) <= 12.0 and abs(p.local.y) < 9.0)
            if p.kind == 0 and place_ground(place_to_world(s,p.local)) >= 0.4: cafes += 1
        loop landmark in place_landmarks(s):
            if landmark.kind == "cafe": reported += 1
        assert(cafes == reported)
        if s.kind == .monastery: assert(cafes == 0)
    assert(signatures.len() >= 10)
