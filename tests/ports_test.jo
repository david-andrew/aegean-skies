use '../src/canal_geometry.jo'
use '../src/river_field.jo'
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/objects.jo'
use '../src/world.jo'
use '../src/geography.jo'

port_test_world = ():
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    init_settlements()

test "every new coastal settlement has conserved docks and bounded deterministic harbour detail":
    port_test_world()
    before=hash(world_settlements); count=0
    loop s in world_settlements:
        if s.legacy>=0:
            assert(settlement_port(s).quays.len()==0)
            continue
        # Lake and island landings are timber piers, checked by their own tests.
        if s.harbor.len()==0 or s.remote_harbor: continue
        p=settlement_port(s); count+=1
        if s.id==CANAL_CITY_ID:
            # Neravessa's workshop and quays come from canal geometry, not coastal service lots.
            assert(p.docks.len()==1 and p.docks[0]==canal_launch)
            water=river_at(f64(canal_launch.x),f64(canal_launch.z))
            assert(water.wet and abs(water.level-f64(canal_launch.y))<0.05)
            assert(canal_floor(f64(canal_workshop.x),f64(canal_workshop.z),f64(canal_workshop.y)+0.1)>=f64(canal_workshop.y)-0.05)
            continue
        assert(p.id==s.id and p.name==s.name and p.docks.len()==s.harbor.len())
        assert(p.quays.len()>=2 and p.quays.len()<=44)
        assert(p.buildings.len()>=2)
        if s.kind==.port or s.kind==.capital: assert(p.boats.len()>0)
        assert(p.boat_headings.len()==p.boats.len())
        loop boat in p.boats:
            assert(place_ground(boat.xz)<-1.0)
            loop d in p.docks: assert(length(boat.xz-d.xz)>=26.0)
        assert(p.loading.len()==p.docks.len() and p.routes.len()<28)
        assert(place_ground(p.anchorage.xz)<-8.0)
        loop k in 0..p.docks.len():
            assert(p.docks[k]==s.harbor[k].at)
            assert(place_ground(p.docks[k].xz)<-2.0)
            assert(abs(port_quay_height(p.loading[k].xz,-10.0)-f64(p.loading[k].y))<0.05)
            assert(length(p.loading[k].xz-p.docks[k].xz)<18.0)
            assert(port_mooring(p.docks[k])==p.docks[k])
            assert(port_bollard(p.docks[k])!=none)
        assert(abs(port_quay_height(p.board.xz,-10.0)-f64(p.board.y))<0.05)
        assert(port_cache.len()<=PORT_CACHE_LIMIT)
        assert(hash(build_settlement_port(s))==hash(p))
    assert(count>30 and hash(world_settlements)==before)
    print("ports={count}; compact registry unchanged; cache={port_cache.len()}")

test "harbour loading routes and service doors are traversable on canonical contact":
    port_test_world()
    tested=0
    loop s in world_settlements:
        if s.legacy>=0 or s.harbor.len()==0 or s.remote_harbor: continue
        p=settlement_port(s)
        loop ri in 0..p.routes.len():
            route=p.routes[ri]
            # Walk every connecting segment in 0.5 m increments, just as player contact does.
            loop j in 1..route.len():
                a=route[j-1].xz; b=route[j].xz; len=f64(length(b-a))
                steps=max(1,int(ceil(len/0.5)))
                prev=walk_height([],f64(a.x),f64(a.y))
                loop k in 1..steps+1:
                    q=mix(a,b,f32(k)/f32(steps)); h=walk_height([],f64(q.x),f64(q.y))
                    if h<0.0 or abs(h-prev)>0.8:
                        print("blocked port {s.id} {s.name} route {ri}/{j}: {q} height {h} previous {prev} endpoints {route[j-1]} {route[j]}")
                    assert(h>=0.0 and abs(h-prev)<=0.8)
                    avoid=settlement_avoid_buildings(q)
                    if length(avoid-q)>0.1: print("building blocks {s.id} route {ri}/{j} local={place_to_local(s,q)} {q} -> {avoid}")
                    assert(length(avoid-q)<0.1)
                    prev=h
        tested+=1
    print("walkable ports={tested}")
