use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/ports_scene.jo'
use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_scene.jo'
use '../src/living_portage.jo'
use '../src/living_save.jo'
use '../src/living_checks.jo'

test "a saved registry port call suspends only the walking pilot and returns to the original harbour":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true; init_settlements()
    s=world_settlements[settlement_by_id[10001]]; p=settlement_port(s)
    w=build_world(); actor=w.player; craft=w.people[actor].craft
    w.place_contexts[s.id]=LifePlaceContext(s.id,s.name,s.country,s.region,s.center,aviation=true)
    prepare_port_venues(w,p.center)
    count=w.place_contexts[s.id].venues.len()
    assert(count>=5)
    prepare_port_venues(w,p.center)
    assert(w.place_contexts[s.id].venues.len()==count)
    core=hash(w.harbors); roots=w.next_cargo_source
    w.aircraft[craft].move_owner=.scene
    trip=scene_player_departure(w); assert(trip>=0)
    w.aircraft[craft].pose.pos=p.docks[0]; w.aircraft[craft].pose.vel=vec3(0,0,0)
    assert(arrive_registry_port(w,p.docks[0]))
    cargo_person_pose(w,actor,p.loading[0])
    assert(w.people[actor].place== -1 and w.people[actor].far_place==s.id and w.people[actor].trip== -1)
    assert(w.aircraft[craft].trip==trip and w.trips[trip].state!=.arrived)
    assert(cargo_loading_spot(w,craft)==p.loading[0])
    assert(near_port_board(p.board)==s.id)
    assert(w.next_cargo_source==roots and hash(w.harbors)==core)
    assert(invariant_errors(w).len()==0 and validate_save_world(w)=="")
    text=canonical_text(w); saved=from_text[World](text); assert(saved is World)
    assert(canonical_text(saved)==text and cargo_loading_spot(saved,craft)==p.loading[0])
    w=saved
    leave_registry_port(w)
    assert(w.people[actor].trip==trip and w.people[actor].far_place== -1 and w.aircraft[craft].port_place== -1)
    w.aircraft[craft].pose.pos=w.harbors[0].docks[0]; w.aircraft[craft].pose.vel=vec3(0,0,0)
    assert(scene_player_arrival(w,0,0))
    assert(w.people[actor].place==0 and w.people[actor].trip== -1 and w.aircraft[craft].place==0)
    assert(hash(w.harbors)==core and w.next_cargo_source==roots)
    assert(invariant_errors(w).len()==0 and validate_save_world(w)=="")
