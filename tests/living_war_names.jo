use '../src/living_types.jo'
use '../src/living_far_types.jo'
use '../src/living_war_types.jo'
use '../src/living_war.jo'
use '../src/living_war_contacts.jo'
use '../src/living_war_names.jo'
use '../src/living_far_news.jo'
use '../src/living_save.jo'
use '../src/living_money.jo'
use 'living_commissions.jo'

battle_name_fixture = () -> World:
    w=commission_fixture(); w.far.links[0].mode=.ship; w.far.vehicles[0].kind=.ship
    assert(war_charter(w,0,1)==0 and war_charter(w,1,2)==1)
    war_supply(w,0); war_supply(w,1)
    relation=war_relation(w,1,2); w.diplomacy[relation].stage=.war
    far_local_news(w,100,"war_declared","A received declaration.",country=1,other_country=2,severity=1000)
    far_local_news(w,200,"war_declared","A received declaration.",country=2,other_country=1,severity=1000)
    w

test "an actual contested capital order earns a saved period battle name without an observer":
    w=battle_name_fixture(); assert(issue_war_order(w,0,.occupy,200)>=0)
    stock=stock_totals(w); cash=w.ledger.opening_cents
    begin_war_contacts(w)
    c=w.war.contacts[0]
    assert(c.name=="Battle for Port 200" and c.engagement==NATIONAL_ENGAGEMENT_BASE)
    assert(engagement_name(w,c.engagement)==c.name and engagement_name(w,0)==none)
    before=canonical_text(w); assert(engagement_name(w,c.engagement)==c.name and canonical_text(w)==before)
    assert(war_engagements(w,c.pos).len()==0) # offscene names are not an omniscient join prompt
    w.war.contacts[0].state=.physical
    assert(war_engagements(w,c.pos)[0].name==c.name and war_engagements(w,c.pos+vec3(20000,0,0)).len()==0)
    w.war.contacts[0].state=.pending
    parsed=from_text[World](before); assert(parsed is World and canonical_text(parsed)==before and validate_save_world(parsed)=="")
    assert(stock_totals(w)==stock and w.ledger.opening_cents==cash and money_balances(w) and goods_balance(w))

test "routine two-ship clashes privateers and an unreceived future war do not acquire battle titles":
    w=battle_name_fixture(); begin_war_contacts(w)
    assert(w.war.contacts[0].name==none and engagement_name(w,w.war.contacts[0].engagement)==none)
    w=battle_name_fixture(); assert(issue_war_order(w,0,.occupy,200)>=0)
    w.far.vehicles[0].duty=.privateer
    assert(national_battle_name(w,0,1,vec3(150,0,0))==none)
    w.far.vehicles[0].duty=.patrol
    relation=war_relation(w,1,2); w.diplomacy[relation].stage=.strained
    assert(national_battle_name(w,0,1,vec3(150,0,0))==none)

test "a distant objective cannot name an unrelated contact as a capital battle":
    w=battle_name_fixture(); assert(issue_war_order(w,0,.occupy,200)>=0)
    w.place_contexts[200].center=vec3(50000,0,0)
    assert(national_battle_name(w,0,1,vec3(150,0,0))==none)
