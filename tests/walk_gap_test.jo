# Walking off a harbour edge: Saryanyra's waterfront had a sliver of shallows under every side
# quay's wall that the walker could step down into and never climb out of. The step now has a
# kerb (no drop the climb could not take back), and a walker shut in anyway is stepped up.
use '../src/canal_geometry.jo'
use '../src/water_field.jo'
use '../src/world_point.jo'
use '../src/world.jo'
use '../src/geography.jo'
use '../src/objects.jo'
use '../src/settlements.jo'
use '../src/settlement_ports.jo'
use '../src/walk_unstick.jo'

load_places = ():
    global geography_enabled
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true
    init_settlements()

port_named = (name: str) -> WorldSettlement:
    loop s in world_settlements:
        if s.name == name: return s
    assert(false)
    world_settlements[0]

# every cell of the harbour (one metre and a half apart) the walker can reach from the town's centre
# by real steps and cannot get back from
shut_in_cells = (s: WorldSettlement, cell: f64) -> (int, int):
    port = settlement_port(s)
    lo = vec2(1e9, 1e9); hi = vec2(-1e9, -1e9)
    loop q in port.quays:
        loop e in [q.a, q.b]:
            lo = vec2(min(lo.x, e.x), min(lo.y, e.z)); hi = vec2(max(hi.x, e.x), max(hi.y, e.z))
    lo = lo - vec2(12, 12); hi = hi + vec2(12, 12)
    nx = int((hi.x - lo.x) / f32(cell)) + 1; nz = int((hi.y - lo.y) / f32(cell)) + 1
    start = int((f64(s.center.x) - f64(lo.x)) / cell) * nz + int((f64(s.center.z) - f64(lo.y)) / cell)
    dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    fwd: bool[]; bwd: bool[]; rev: int[][]
    loop k in 0..nx * nz:
        fwd.push(false); bwd.push(false); rev.push([])
    step = (a: int, b: int) -> bool:
        px = f64(lo.x) + f64(a / nz) * cell; pz = f64(lo.y) + f64(a % nz) * cell
        d = vec2(f32(cell * f64(b / nz - a / nz)), f32(cell * f64(b % nz - a % nz)))
        q = walk_step_precise([], WorldPoint(px, walk_height([], px, pz), pz), d)
        abs(q.x - px - f64(d.x)) < 0.02 and abs(q.z - pz - f64(d.y)) < 0.02
    fwd[start] = true
    queue = [start]; head = 0
    loop head < queue.len():
        c = queue[head]; head += 1
        loop d in dirs:
            ax = c / nz + d.0; az = c % nz + d.1
            if ax < 0 or az < 0 or ax >= nx or az >= nz: continue
            n = ax * nz + az
            if step(c, n):
                rev[n].push(c)
                if not fwd[n]: fwd[n] = true; queue.push(n)
    bwd[start] = true
    queue = [start]; head = 0
    loop head < queue.len():
        c = queue[head]; head += 1
        loop a in rev[c]:
            if not bwd[a]: bwd[a] = true; queue.push(a)
    reached = 0; shut = 0
    loop k in 0..nx * nz:
        if fwd[k]: reached += 1
        if fwd[k] and not bwd[k]: shut += 1
    (reached, shut)

test "the harbour's edges are kerbs: nobody on a quay steps off into a place they cannot get back from":
    load_places()
    checked = 0
    loop name in ["Saryanyra", "Saryonouna", "Kalyrassa"]:
        port = settlement_port(port_named(name))
        loop q in port.quays:
            if q.profile or q.street: continue
            along = q.b.xz - q.a.xz
            len = f64(length(along))
            if len < 6.0: continue
            out = normalize(vec2(-along.y, along.x))
            loop side in [-1.0, 1.0]:
                loop frac in [0.25, 0.75]:
                    edge = mix(q.a.xz, q.b.xz, f32(frac)) + out * f32(side * (q.width * 0.5 - 0.4))
                    h0 = walk_height([], f64(edge.x), f64(edge.y))
                    if h0 < f64(q.a.y) - 0.3: continue
                    # (the walker on the deck at its edge, then four metres on out over it)
                    p = WorldPoint(f64(edge.x), h0, f64(edge.y))
                    dir = out * f32(side)
                    loop k in 0..27: p = walk_step_precise([], p, dir * 0.15)
                    shut, _, _ = walk_pocket([], p)
                    if shut: print("SHUT IN {name} quay at {edge} walker {p.x:.2},{p.z:.2} y {p.y:.2}")
                    assert(not shut)
                    # (and never below the deck by more than a step, or held there)
                    assert(p.y > h0 - 3.0 * WALK_STEP_HEIGHT or not shut)
                    checked += 1
    print("edges walked: {checked}")
    assert(checked > 60)

test "no pocket in the walkable surface at Saryanyra's harbour or two others built by the same code":
    load_places()
    loop name in ["Saryanyra", "Olythanti"]:
        reached, shut = shut_in_cells(port_named(name), 1.5)
        print("{name}: {reached} cells reached, {shut} shut in")
        assert(reached > 3000)
        assert(shut == 0)

# a pit to be put in: a cell of shallows hard under a quay's wall, from which the wall is out of
# reach and the water is too deep to wade
test "a walker put in a pit under a quay is stepped up onto open ground":
    load_places()
    port = settlement_port(port_named("Saryanyra"))
    found: WorldPoint[]
    loop q in port.quays:
        if q.profile or q.street or q.mole: continue
        along = q.b.xz - q.a.xz
        out = normalize(vec2(-along.y, along.x))
        loop frac in [0.2, 0.4, 0.6, 0.8]:
            loop side in [-1.0, 1.0]:
                loop gap in [0.2, 0.6, 1.0, 1.4]:
                    at = mix(q.a.xz, q.b.xz, f32(frac)) + out * f32(side * (q.width * 0.5 + gap))
                    h = walk_height([], f64(at.x), f64(at.y))
                    w = water_at(f64(at.x), f64(at.y))
                    deck = walk_height([], f64(at.x) - f64(out.x) * side * (gap + 0.6), f64(at.y) - f64(out.y) * side * (gap + 0.6))
                    if found.len() == 0 and h > -0.8 and h < 0.9 and deck - h > 1.5:
                        shut, _, _ = walk_pocket([], WorldPoint(f64(at.x), h, f64(at.y)))
                        if shut: found.push(WorldPoint(f64(at.x), h, f64(at.y)))
    assert(found.len() > 0)
    pit = found[0]
    out_of = walk_escape([], pit)
    assert(out_of != none)
    up = out_of!
    print("pit {pit.x:.1},{pit.z:.1} y {pit.y:.2} -> {up.x:.1},{up.z:.1} y {up.y:.2}")
    assert(walk_open_ground([], up.x, up.z))
    shut_there, _, _ = walk_pocket([], up)
    assert(not shut_there)
    away = sqrt((up.x - pit.x) * (up.x - pit.x) + (up.z - pit.z) * (up.z - pit.z))
    assert(away > 0.9 and away < f64(WALK_OUT_REACH))
    # (walking on the spot or against a wall is not being shut in: nobody is moved)
    open_p = port.docks[0]
    assert(walk_escape([], WorldPoint(f64(port.loading[0].x), walk_height([], f64(port.loading[0].x), f64(port.loading[0].z)), f64(port.loading[0].z))) == none)

test "a walker getting nowhere for three seconds, holding a direction, is looked at, and only then":
    s = WalkStuck()
    # moving freely: never
    loop k in 0..600: assert(not walk_stuck_step(s, 0.03, 0.03, 1.0 / 60.0))
    # not trying: never
    loop k in 0..600: assert(not walk_stuck_step(s, 0.0, 0.0, 1.0 / 60.0))
    # trying and getting nowhere: after three seconds
    fired = -1
    loop k in 0..600:
        if walk_stuck_step(s, 0.03, 0.0, 1.0 / 60.0): fired = k; break
    assert(fired >= 178 and fired <= 182)
    # sliding along a wall at a third of the pace asked is moving; a pause in the pushing clears the count
    loop k in 0..600: assert(not walk_stuck_step(s, 0.03, 0.01, 1.0 / 60.0))
    loop k in 0..170: _ = walk_stuck_step(s, 0.03, 0.0, 1.0 / 60.0)
    assert(not walk_stuck_step(s, 0.0, 0.0, 1.0 / 60.0))
    loop k in 0..170: assert(not walk_stuck_step(s, 0.03, 0.0, 1.0 / 60.0))
