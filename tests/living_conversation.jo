use '../src/living_types.jo'
use '../src/life_types.jo'
use '../src/living_seed.jo'
use '../src/living_save.jo'
use '../src/living_conversation.jo'
use '../src/living_events.jo'
use '../src/living_news.jo'

test "conversation previews are pure and committed voices do not repeat their recent window":
    w = build_world()
    before = canonical_text(w)
    a = conversation_preview(w,7,0,.greeting)
    b = conversation_preview(w,7,0,.greeting)
    assert(a == b and a.text != "" and canonical_text(w) == before)
    loop k in 0..30:
        recent = w.speech.get(7,SpeechLedger()).recent
        turn = converse(w,7,0,.greeting)
        if turn.exhausted: break
        loop old in recent:
            assert(turn.text != old.text)
            if turn.question != "": assert(turn.question != old.text)
    assert(w.speech[7].sequence >= 10 and w.speech[7].recent.len() <= SPEECH_RECENT_LINES)
    assert(voice_of(w,7) == .salt and voice_of(w,2) == .anxious and voice_of(w,5) == .formal)
    assert(conversation_topics(w,22,0).len() == 0)

test "a conversation knows only its speaker's dated evidence and attributes a retelling":
    w = build_world()
    e = emit_event(w,.raid,5,22,23,Reason(purpose=.raid,actor=22,counterparty=23,origin=5,destination=5),5000)
    publish_events(w)
    unknown = converse(w,1,0,.news)
    assert(unknown.source_event != e)
    n = w.people[22].news[0]; assert(n.event == e)
    assert(receive_person(w,1,retell(n,22,w.minute)))
    heard = converse(w,1,0,.news)
    assert(heard.source_event == e and heard.source_person == 22 and heard.confidence == 850)
    assert("told me" in heard.text)

test "private debt is not announced to a stranger in a public group":
    w = build_world()
    # Nikos begins airborne: use a real dockside debtor without moving anyone.
    person = 8
    id = w.obligation_keys["dario_service"]
    w.obligations[id].kind = .debt; w.obligations[id].amount_cents = 3217
    w.obligations[id].due_minute = w.minute
    turn = converse(w,person,0,.troubles)
    assert(not turn.private and not ("32.17" in turn.text))

test "saved dialogue and a pending question continue exactly and replies commit once":
    w = build_world(u64(42))
    greeting = converse(w,6,0,.greeting)
    assert(greeting.question != "" and greeting.replies.len() > 0)
    parsed = from_text[World](canonical_text(w)); assert(parsed is World)
    restored = parsed
    assert(validate_save_world(restored) == "")
    left = answer_conversation(w,6,0,.reassure)
    right = answer_conversation(restored,6,0,.reassure)
    assert(left == right and left.text != "" and canonical_text(w) == canonical_text(restored))
    assert(answer_conversation(w,6,0,.reassure).exhausted)
    assert(converse(w,6,0,.home) == converse(restored,6,0,.home))
    assert(canonical_text(w) == canonical_text(restored))
