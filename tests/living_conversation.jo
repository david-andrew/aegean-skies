test "conversation previews are pure and committed voices do not repeat their recent window":
    w = build_world()
    before = canonical_text(w)
    a = conversation_preview(w,7,0,.greeting)
    b = conversation_preview(w,7,0,.greeting)
    assert(a == b and a.text != "" and canonical_text(w) == before)
    loop k in 0..30:
        recent = w.speech.get(7,SpeechLedger()).recent
        turn = converse(w,7,0,.greeting)
        if turn.exhausted: break
        loop old in recent:
            assert(turn.text != old.text)
            if turn.question != "": assert(turn.question != old.text)
    assert(w.speech[7].sequence >= 10 and w.speech[7].recent.len() <= SPEECH_RECENT_LINES)
    assert(voice_of(w,7) == .salt and voice_of(w,2) == .anxious and voice_of(w,5) == .formal)
    assert(conversation_topics(w,22,0).len() == 0)

test "a conversation knows only its speaker's dated evidence and attributes a retelling":
    w = build_world()
    e = emit_event(w,.raid,5,22,23,Reason(purpose=.raid,actor=22,counterparty=23,origin=5,destination=5),5000)
    publish_events(w)
    unknown = converse(w,1,0,.news)
    assert(unknown.source_event != e)
    n = w.people[22].news[0]; assert(n.event == e)
    assert(receive_person(w,1,retell(n,22,w.minute)))
    heard = converse(w,1,0,.news)
    assert(heard.source_event == e and heard.source_person == 22 and heard.confidence == 850)
    assert("told me" in heard.text)
    learned = false
    loop n in w.people[0].news:
        if n.event == e:
            learned = true
            assert(n.source_person == 1 and n.confidence == 722 and n.occurred_minute == 0)
    assert(learned)

test "private debt is not announced to a stranger in a public group":
    w = build_world()
    # Nikos begins airborne: use a real dockside debtor without moving anyone.
    person = 8
    id = w.obligation_keys["dario_service"]
    w.obligations[id].kind = .debt; w.obligations[id].amount_cents = 3217
    w.obligations[id].due_minute = w.minute
    turn = converse(w,person,0,.troubles)
    assert(not turn.private and not ("32.17" in turn.text))

test "saved dialogue and a pending question continue exactly and replies commit once":
    w = build_world(u64(42))
    greeting = converse(w,6,0,.greeting)
    assert((greeting.question != "" or "?" in greeting.text) and greeting.replies.len() > 0)
    parsed = from_text[World](canonical_text(w)); assert(parsed is World)
    restored = parsed
    assert(validate_save_world(restored) == "")
    left = answer_conversation(w,6,0,.reassure)
    right = answer_conversation(restored,6,0,.reassure)
    assert(left == right and left.text != "" and canonical_text(w) == canonical_text(restored))
    assert(answer_conversation(w,6,0,.reassure).exhausted)
    assert(converse(w,6,0,.home) == converse(restored,6,0,.home))
    assert(canonical_text(w) == canonical_text(restored))

test "a click storm cannot evict fresh phrases and repeat them inside four hours":
    w = build_world(); used: {str: bool}; count = 0
    loop k in 0..250:
        topics = [TalkTopic.greeting,.home,.weather,.people,.news,.market,.farewell]
        turn = converse(w,7,0,topics[k%topics.len()])
        if turn.text == "": continue
        assert(not used.get(turn.text,false)); used[turn.text] = true; count += 1
        if turn.question != "": assert(not used.get(turn.question,false)); used[turn.question] = true
    assert(count > 20 and w.speech[7].recent.len() <= SPEECH_RECENT_LINES)
    w.minute += SPEECH_RECENT_MINUTES; w.tick = w.minute*120
    assert(converse(w,7,0,.greeting).text != "")

test "a speaker who heard the delivery stops repeating the same overdue promise":
    w = build_world()
    promise = Reason(purpose=.delivery,actor=8,beneficiary=3,origin=0,destination=0,good=3,quantity=1000,job=888)
    late = emit_event(w,.late,0,8,3,promise)
    publish_events(w)
    found = false
    loop candidate in news_candidates(w,3):
        if candidate.event == late: found = true
    assert(found)
    delivered = emit_event(w,.delivery,0,8,3,promise); publish_events(w)
    found = false
    loop candidate in news_candidates(w,3):
        assert(candidate.event != late)
        if candidate.event == delivered: found = true
    assert(found)


test "parents can speak of their actual named household without reading a child's hidden location":
    w = build_world(); candidates = conversation_candidates(w,7,0,.home)
    family = false
    loop c in candidates:
        if "Thaleia" in c.text: family = true
        assert(not ("at school" in c.text))
    assert(family)


test "a question in the greeting body is not immediately asked a second time":
    w = build_world(); seen = false
    loop k in 0..30:
        turn = converse(w,6,0,.greeting)
        if "?" in turn.text:
            seen = true
            assert(turn.question == "" and turn.replies.len() > 0)
            assert(w.speech[6].pending_question == turn.text)
    assert(seen)

test "conversation topics reflect the hour and real unfinished trouble":
    w = build_world()
    w.daily_life[6].venue = .cafe
    loop option in conversation_topics(w,6,0): assert(option.topic != .music)
    w.minute = 630; w.tick = w.minute*120 #20:00 local
    music = false
    loop option in conversation_topics(w,6,0):
        if option.topic == .music: music = true
    assert(music)
    loop id in w.people[6].obligations: w.obligations[id].state = .fulfilled
    loop option in conversation_topics(w,6,0): assert(option.topic != .troubles)


test "a spoken quote reaches the listener as dated second hand knowledge":
    w = build_world(); w.people[0].prices.clear()
    turn = converse(w,1,0,.market)
    assert(turn.text != "" and w.people[0].prices.len() == 1)
    quote = w.people[0].prices[0]
    assert(quote.source_person == 1 and quote.confidence == 850 and quote.observed_minute == 0)
    repeat = conversation_preview(w,1,0,.market)
    assert(w.people[0].prices.len() == 1 and repeat.text != "")

test "the live UI day question is not mistaken for a meal and has three or four matching replies":
    question = "And you? How has the day treated you?"
    options = conversation_replies(question)
    assert(options.len() >= 2 and options.len() <= 4)
    back = false
    loop option in options:
        assert(not ("eaten" in option.label) and not ("supper" in option.label))
        if option.reply == .ask_back: back = true; assert(option.label == question)
    assert(back)
    meal = conversation_replies("Have you eaten?")
    assert(meal.len() <= 4 and meal[2].label == "Have you eaten?")
    assert("eaten" in meal[0].label)

test "asking the actual day question back answers the speaker's own day":
    w = build_world()
    assert(converse(w,6,0,.greeting).text != "")
    ledger = w.speech[6]
    ledger.pending_question = "And you? How has the day treated you?"
    ledger.pending_kind = .day; ledger.pending_echo = ledger.pending_question
    ledger.pending_listener = 0; ledger.pending_open_topic = .home; ledger.question_minute = w.minute
    w.speech[6] = ledger
    expected = conversation_preview(w,6,0,.home)
    answer = answer_conversation(w,6,0,.ask_back)
    assert(answer.topic == .home and answer.text == expected.text and answer.text != "")

test "new questions carry a typed domain with matching replies and exact reciprocal wording":
    loop voice in [VoiceKind.salt,.shop,.formal,.anxious,.warm,.measured,.wry,.guarded]:
        loop topic in [TalkTopic.greeting,.home,.news]:
            loop q in followup_questions(voice,topic):
                assert(q.kind != .none and q.text != "" and q.echo == q.text)
                loop sequence in 0..3:
                    options = question_replies(q,sequence)
                    assert(options.len() >= 2 and options.len() <= 4)
                    assert(options[2].reply == .ask_back and options[2].label == q.text)
                    loop option in options:
                        assert(not ("eaten" in option.label) and not ("supper" in option.label))

test "asking about a route or company back stays in that domain and work refusal does not claim":
    w = build_world(); speaker = 6
    assert(converse(w,speaker,0,.greeting).text != "")
    loop kind in [QuestionKind.route,.company]:
        l = w.speech[speaker]
        l.pending_question = "test question"; l.pending_echo = l.pending_question
        l.pending_kind = kind; l.pending_listener = 0; l.question_minute = w.minute
        w.speech[speaker] = l
        expected = context_question_answer(w,speaker,TalkQuestion(kind,"test question","test question"))
        turn = answer_conversation(w,speaker,0,.ask_back)
        assert(turn.text in expected)
    before_jobs = to_text(w.jobs)
    l = w.speech[speaker]; l.pending_kind = .work; l.pending_question = "Can you take this work?"
    l.pending_listener = 0; l.question_minute = w.minute; w.speech[speaker] = l
    turn = answer_conversation(w,speaker,0,.decline)
    assert(turn.text != "" and to_text(w.jobs) == before_jobs and w.people[0].carriage < 0)


test "carrying speech describes the real lot pickup and foot destination":
    w = build_world(); assert(take_job(w,3,0,.porter))
    task = w.carriage[0]; actor = task.person
    load = ctx_load(w,w.jobs[3].good,w.cargo[task.cargo].quantity)
    loop c in context_work(w,actor): assert(load in c.text and "warehouse" in c.text)
    w.carriage[0].unloading = true
    loop c in context_work(w,actor): assert("aircraft" in c.text)
    w.carriage[0].unloading = false; w.carriage[0].phase = .carry
    w.jobs[3].delivery_mode = .foot; w.jobs[3].drop_store = .boat
    loop c in context_work(w,actor): assert("boat" in c.text and not ("aircraft" in c.text))

test "displayed body questions always carry their own answer domain":
    w = build_world()
    loop speaker in 1..w.people.len():
        loop topic in [TalkTopic.greeting,.work,.home,.weather,.music,.news,.troubles]:
            loop c in conversation_candidates(w,speaker,0,topic):
                if "?" in c.text: assert(c.ask.kind != .none)

test "an ambiguous old question expires rather than receiving answers to a different question":
    assert(conversation_replies("How do you find our town?").len() == 0)
    assert(conversation_replies("Who are you here to see?").len() == 0)
    assert(conversation_replies("Would you trust that account?").len() == 0)
