test "conversation previews are pure and committed voices do not repeat their recent window":
    w = build_world()
    before = canonical_text(w)
    a = conversation_preview(w,7,0,.greeting)
    b = conversation_preview(w,7,0,.greeting)
    assert(a == b and a.text != "" and canonical_text(w) == before)
    loop k in 0..30:
        recent = w.speech.get(7,SpeechLedger()).recent
        turn = converse(w,7,0,.greeting)
        if turn.exhausted: break
        loop old in recent:
            assert(turn.text != old.text)
            if turn.question != "": assert(turn.question != old.text)
    assert(w.speech[7].sequence >= 10 and w.speech[7].recent.len() <= SPEECH_RECENT_LINES)
    assert(voice_of(w,7) == .salt and voice_of(w,2) == .anxious and voice_of(w,5) == .formal)
    assert(conversation_topics(w,22,0).len() == 0)

test "a conversation knows only its speaker's dated evidence and attributes a retelling":
    w = build_world()
    e = emit_event(w,.raid,5,22,23,Reason(purpose=.raid,actor=22,counterparty=23,origin=5,destination=5),5000)
    publish_events(w)
    unknown = converse(w,1,0,.news)
    assert(unknown.source_event != e)
    n = w.people[22].news[0]; assert(n.event == e)
    assert(receive_person(w,1,retell(n,22,w.minute)))
    heard = converse(w,1,0,.news)
    assert(heard.source_event == e and heard.source_person == 22 and heard.confidence == 850)
    assert("told me" in heard.text)
    learned = false
    loop n in w.people[0].news:
        if n.event == e:
            learned = true
            assert(n.source_person == 1 and n.confidence == 722 and n.occurred_minute == 0)
    assert(learned)

test "private debt is not announced to a stranger in a public group":
    w = build_world()
    # Nikos begins airborne: use a real dockside debtor without moving anyone.
    person = 8
    id = w.obligation_keys["dario_service"]
    w.obligations[id].kind = .debt; w.obligations[id].amount_cents = 3217
    w.obligations[id].due_minute = w.minute
    turn = converse(w,person,0,.troubles)
    assert(not turn.private and not ("32.17" in turn.text))

test "private debt requires trust and no nearby bystander in the same place":
    w = build_world()
    id = w.obligation_keys["dario_service"]
    w.obligations[id].kind = .debt; w.obligations[id].amount_cents = 3217
    w.obligations[id].due_minute = w.minute
    seed_relationship(w,8,0,true)
    # Isolate the pair without removing people or changing their IDs.
    loop k in 0..w.people.len():
        if k != 8 and k != 0: w.people[k].place = -1
    has_private = (candidates: SpeechCandidate[]) -> bool:
        loop c in candidates:
            if c.private: return true
        false
    assert(has_private(conversation_candidates(w,8,0,.troubles,true)))
    assert(not has_private(conversation_candidates(w,8,0,.troubles,false)))
    w.relationships[w.relationship_index[RelationshipKey(8,0)]].trust = 649
    assert(not has_private(conversation_candidates(w,8,0,.troubles,true)))
    w.relationships[w.relationship_index[RelationshipKey(8,0)]].trust = 650
    w.people[1].pose.pos = w.people[8].pose.pos
    assert(has_private(conversation_candidates(w,8,0,.troubles,true)))
    w.people[1].place = w.people[8].place
    assert(not has_private(conversation_candidates(w,8,0,.troubles,true)))
    w.people[1].pose.pos.x += 7
    assert(has_private(conversation_candidates(w,8,0,.troubles,true)))

test "candidate interjections share only the current listener's unexpired history":
    w=build_world();w.minute=300
    w.speech[7]=SpeechLedger()
    w.speech[7].recent=[SpokenLine("a","Well, the boat came in.",299,0,.news),SpokenLine("b","Poor souls: bad luck.",299,1,.news),SpokenLine("c","Oh! A long time ago.",60,0,.news)]
    used:{str:bool}
    assert(fresh_opener_cached(w,7,0,"Well, fish came in.",used)=="Fish came in.")
    assert(fresh_opener_cached(w,7,0,"Well! Oil came in.",used)=="Oil came in.")
    assert(fresh_opener_cached(w,7,0,"Poor souls: the boat is late.",used)=="Poor souls: the boat is late.")
    assert(fresh_opener_cached(w,7,0,"Oh! The boat is late.",used)=="Oh! The boat is late.")
    # A later candidate pool sees newly committed words, including a prior miss.
    w.speech[7].recent.push(SpokenLine("d","Oh, that boat.",300,0,.news))
    next:{str:bool}
    assert(fresh_opener_cached(w,7,0,"Oh! More news.",next)=="More news.")

test "saved dialogue and a pending question continue exactly and replies commit once":
    w = build_world(u64(42))
    greeting = converse(w,6,0,.greeting)
    assert((greeting.question != "" or "?" in greeting.text) and greeting.replies.len() > 0)
    parsed = from_text[World](canonical_text(w)); assert(parsed is World)
    restored = parsed
    assert(validate_save_world(restored) == "")
    left = answer_conversation(w,6,0,.reassure)
    right = answer_conversation(restored,6,0,.reassure)
    assert(left == right and left.text != "" and canonical_text(w) == canonical_text(restored))
    assert(answer_conversation(w,6,0,.reassure).exhausted)
    assert(converse(w,6,0,.home) == converse(restored,6,0,.home))
    assert(canonical_text(w) == canonical_text(restored))

test "a click storm cannot evict fresh phrases and repeat them inside four hours":
    w = build_world(); used: {str: bool}; count = 0
    loop k in 0..250:
        topics = [TalkTopic.greeting,.home,.weather,.people,.news,.market,.farewell]
        turn = converse(w,7,0,topics[k%topics.len()])
        if turn.text == "": continue
        assert(not used.get(turn.text,false)); used[turn.text] = true; count += 1
        if turn.question != "": assert(not used.get(turn.question,false)); used[turn.question] = true
    assert(count > 20 and w.speech[7].recent.len() <= SPEECH_RECENT_LINES)
    w.minute += SPEECH_RECENT_MINUTES; w.tick = w.minute*120
    assert(converse(w,7,0,.greeting).text != "")

test "a speaker who heard the delivery stops repeating the same overdue promise":
    w = build_world()
    promise = Reason(purpose=.delivery,actor=8,beneficiary=3,origin=0,destination=0,good=3,quantity=1000,job=888)
    late = emit_event(w,.late,0,8,3,promise)
    publish_events(w)
    found = false
    loop candidate in news_candidates(w,3):
        if candidate.event == late: found = true
    assert(found)
    delivered = emit_event(w,.delivery,0,8,3,promise); publish_events(w)
    found = false
    loop candidate in news_candidates(w,3):
        assert(candidate.event != late)
        if candidate.event == delivered: found = true
    assert(found)


test "parents can speak of their actual named household without reading a child's hidden location":
    w = build_world(); candidates = conversation_candidates(w,7,0,.home)
    family = false
    loop c in candidates:
        if "Thaleia" in c.text: family = true
        assert(not ("at school" in c.text))
    assert(family)


test "a question in the greeting body is not immediately asked a second time":
    w = build_world(); seen = false
    loop k in 0..30:
        turn = converse(w,6,0,.greeting)
        if "?" in turn.text:
            seen = true
            assert(turn.question == "" and turn.replies.len() > 0)
            assert(w.speech[6].pending_question == turn.text)
    assert(seen)

test "conversation topics reflect the hour and real unfinished trouble":
    w = build_world()
    w.daily_life[6].venue = .cafe
    loop option in conversation_topics(w,6,0): assert(option.topic != .music)
    w.minute = 630; w.tick = w.minute*120 #20:00 local
    music = false
    loop option in conversation_topics(w,6,0):
        if option.topic == .music: music = true
    assert(music)
    loop id in w.people[6].obligations: w.obligations[id].state = .fulfilled
    loop option in conversation_topics(w,6,0): assert(option.topic != .troubles)


test "a spoken quote reaches the listener as dated second hand knowledge":
    w = build_world(); w.people[0].prices.clear()
    # The first answer about trade is the speaker's own view; a price comes on asking again.
    first = converse(w,1,0,.market)
    assert(first.text != "" and w.people[0].prices.len() == 0)
    turn = first
    loop _ in 0..5:
        if w.people[0].prices.len() > 0: break
        turn = converse(w,1,0,.market)
    assert(turn.text != "" and w.people[0].prices.len() == 1)
    quote = w.people[0].prices[0]
    assert(quote.source_person == 1 and quote.confidence == 850 and quote.observed_minute == 0)
    repeat = conversation_preview(w,1,0,.market)
    assert(w.people[0].prices.len() == 1 and repeat.text != "")

test "the live UI day question is not mistaken for a meal and has three or four matching replies":
    question = "And you? How has the day treated you?"
    options = conversation_replies(question)
    assert(options.len() >= 2 and options.len() <= 4)
    back = false
    loop option in options:
        assert(not ("eaten" in option.label) and not ("supper" in option.label))
        if option.reply == .ask_back: back = true; assert(option.label == question)
    assert(back)
    meal = conversation_replies("Have you eaten?")
    assert(meal.len() <= 4 and meal[2].label == "Have you eaten?")
    assert("eaten" in meal[0].label)

test "asking the actual day question back answers the speaker's own day":
    w = build_world()
    assert(converse(w,6,0,.greeting).text != "")
    ledger = w.speech[6]
    ledger.pending_question = "And you? How has the day treated you?"
    ledger.pending_kind = .day; ledger.pending_echo = ledger.pending_question
    ledger.pending_listener = 0; ledger.pending_open_topic = .home; ledger.question_minute = w.minute
    w.speech[6] = ledger
    expected = context_question_answer(w,6,TalkQuestion(.day,ledger.pending_question,ledger.pending_question))
    answer = answer_conversation(w,6,0,.ask_back)
    assert(answer.topic == .home and answer.text in expected and answer.text != "")

test "new questions carry a typed domain with matching replies and exact reciprocal wording":
    loop voice in [VoiceKind.salt,.shop,.formal,.anxious,.warm,.measured,.wry,.guarded]:
        loop topic in [TalkTopic.greeting,.home,.news]:
            loop q in followup_questions(voice,topic):
                assert(q.kind != .none and q.text != "" and q.echo == q.text)
                loop sequence in 0..3:
                    options = question_replies(q,sequence)
                    assert(options.len() >= 2 and options.len() <= 4)
                    assert(options[2].reply == .ask_back and options[2].label == q.text)
                    loop option in options:
                        assert(not ("eaten" in option.label) and not ("supper" in option.label))

test "asking about a route or company back stays in that domain and work refusal does not claim":
    w = build_world(); speaker = 6
    assert(converse(w,speaker,0,.greeting).text != "")
    loop kind in [QuestionKind.route,.company]:
        l = w.speech[speaker]
        l.pending_question = "test question"; l.pending_echo = l.pending_question
        l.pending_kind = kind; l.pending_listener = 0; l.question_minute = w.minute
        w.speech[speaker] = l
        expected = context_question_answer(w,speaker,TalkQuestion(kind,"test question","test question"))
        turn = answer_conversation(w,speaker,0,.ask_back)
        assert(turn.text in expected)
    before_jobs = to_text(w.jobs)
    l = w.speech[speaker]; l.pending_kind = .work; l.pending_question = "Can you take this work?"
    l.pending_listener = 0; l.question_minute = w.minute; w.speech[speaker] = l
    turn = answer_conversation(w,speaker,0,.decline)
    assert(turn.text != "" and to_text(w.jobs) == before_jobs and w.people[0].carriage < 0)


test "carrying speech describes the real lot pickup and foot destination":
    w = build_world(); assert(take_job(w,3,0,.porter))
    task = w.carriage[0]; actor = task.person
    load = ctx_load(w,w.jobs[3].good,w.cargo[task.cargo].quantity)
    loop c in context_work(w,actor): assert(load in c.text and "warehouse" in c.text)
    w.carriage[0].unloading = true
    loop c in context_work(w,actor): assert("aircraft" in c.text)
    w.carriage[0].unloading = false; w.carriage[0].phase = .carry
    w.jobs[3].delivery_mode = .foot; w.jobs[3].drop_store = .boat
    loop c in context_work(w,actor): assert("boat" in c.text and not ("aircraft" in c.text))

test "displayed body questions always carry their own answer domain":
    w = build_world()
    loop speaker in 1..w.people.len():
        loop topic in [TalkTopic.greeting,.work,.home,.weather,.music,.news,.troubles]:
            loop c in conversation_candidates(w,speaker,0,topic):
                if "?" in c.text: assert(c.ask.kind != .none)

test "an ambiguous old question expires rather than receiving answers to a different question":
    assert(conversation_replies("How do you find our town?").len() == 0)
    assert(conversation_replies("Who are you here to see?").len() == 0)
    assert(conversation_replies("Would you trust that account?").len() == 0)

test "walk-with-me invitations offer All right and Another time with real effects and no snub":
    w = build_world()
    # Marta Bellini (id 3, .shop voice) walking to the cafe: "I'm going to the cafe. Walk with me if you like."
    cands = walking_candidates(voice_of(w,3),"to the cafe","walk:cafe")
    assert(cands.len() == 2 and "Walk with me" in cands[1].text and cands[1].ask.kind == .walk_along)
    replies = question_replies(cands[1].ask,0)
    assert(replies.len() == 2 and replies[0].label == "All right." and replies[1].label == "Another time.")
    assert(question_replies(cands[1].ask,1)[0].label == "Lead on.")
    # Accepting triggers walk_along; declining triggers go_alone without lowering warmth.
    _ = set_pending_prompt(w,3,0,.walk_along,cands[1].text)
    yes = answer_conversation(w,3,0,.reassure)
    assert(yes.text != "" and yes.effect == "walk_along")
    before_warmth = w.rep.opinions.get(3,RepOpinion(person=3)).lean.warmth
    _ = set_pending_prompt(w,3,0,.walk_along,cands[1].text)
    no = answer_conversation(w,3,0,.decline)
    assert(no.text != "" and no.effect == "go_alone")
    assert(w.rep.opinions.get(3,RepOpinion(person=3)).lean.warmth >= before_warmth)

test "warnings, busy workers, thanks, secrets, apologies, missing boats and friend referrals offer fitting replies":
    w = build_world()
    # Storm warning -> watch/wait it out + note_weather effect
    w.weather.push(Weather(id=99,kind=.storm,center=vec2(f32(w.people[3].pose.pos.x)+15000.0,f32(w.people[3].pose.pos.z)),radius_m=12000,velocity_milli_m_per_minute=vec2(-100000,0),expires_minute=300))
    wc = context_weather(w,3,voice_of(w,3))
    assert(wc.len() == 3)
    loop c in wc: assert(c.ask.kind == .warning)
    _ = set_pending_prompt(w,3,0,.warning,wc[0].text)
    ack = answer_conversation(w,3,0,.reassure)
    assert(ack.text != "" and ack.effect == "note_weather")
    # Missing boat -> look out from the air + note_boat effect
    _ = set_pending_prompt(w,7,0,.missing_boat,"Kostas's boat should have been back by now.","Kostas")
    mb = answer_conversation(w,7,0,.reassure)
    assert(mb.text != "" and mb.effect == "note_boat" and mb.effect_note == "Kostas")
    # Apology reduces grievance
    seed_relationship(w,1,0)
    rid = w.relationship_index[RelationshipKey(1,0)]
    w.relationships[rid].grievance = 300
    _ = set_pending_prompt(w,1,0,.apology,"I know you. I haven't forgotten.")
    ap = answer_conversation(w,1,0,.reassure)
    assert(ap.text != "" and w.relationships[rid].grievance == 280)
    # Secret increases trust
    before_trust = w.relationships[rid].trust
    w.speech[1].last_reply_minute = -100000
    _ = set_pending_prompt(w,1,0,.secret,"I find myself making time for Paolo. Don't make a story of it.")
    sc = answer_conversation(w,1,0,.reassure)
    assert(sc.text != "" and w.relationships[rid].trust > before_trust)
    # Warm friend referral answers with the friend's real spot in town
    _ = set_pending_prompt(w,6,0,.meet_friend,"Paolo is a dear. You should meet them.","4")
    mf = answer_conversation(w,6,0,.reassure)
    assert("Paolo" in mf.text and "workshop" in mf.text, mf.text)
    # Busy carrying worker -> polite decline gives go_alone
    _ = set_pending_prompt(w,8,0,.busy,"Can't stop; I've a load on.")
    bz = answer_conversation(w,8,0,.decline)
    assert(bz.text != "" and bz.effect == "go_alone")

test "lodging topic is available everywhere and answers from the living world":
    w = build_world(u64(42))
    # 1. Hotel town (Porto Vecchio, place 0): stranger points to Hotel Ancora with price and directions.
    p8 = w.people[8]
    w.people[0].pose.pos = p8.pose.pos + vec3(1,0,0)
    w.people[0].place = p8.place
    topics0 = conversation_topics(w,8,0)
    has_lodging = false
    loop o in topics0:
        if o.topic == .lodging: has_lodging = true
    assert(has_lodging,"lodging topic should be offered in hotel town")
    t0 = converse(w,8,0,.lodging)
    low0 = lower(t0.text)
    assert("ancora" in low0 and "six phoinikes" in low0 and ("pier" in low0 or "waterfront" in low0),t0.text)
    # Keeper (Sofia Marinou, id 6) offers a room directly with hotel_offer replies.
    w.people[0].pose.pos = w.people[6].pose.pos + vec3(1,0,0)
    w.people[0].place = w.people[6].place
    tk = converse(w,6,0,.lodging)
    assert(tk.question_kind == .hotel_offer and tk.replies.len() >= 2,tk.text)
    ak = answer_conversation(w,6,0,.reassure)
    assert(ak.effect == "hotel_desk",ak.text)
    # 2. Town without a hotel (Kalamos, place 1): points to a real local resident who takes lodgers.
    kalamos_id = -1
    loop q in w.people:
        if q.id != 0 and q.home == 1 and q.place == 1 and q.occupation != .patrol and q.occupation != .pirate:
            kalamos_id = q.id; break
    assert(kalamos_id >= 0)
    w.people[0].pose.pos = w.people[kalamos_id].pose.pos + vec3(1,0,0)
    w.people[0].place = 1
    topics1 = conversation_topics(w,kalamos_id,0)
    has_lodging1 = false
    loop o in topics1:
        if o.topic == .lodging: has_lodging1 = true
    assert(has_lodging1,"lodging topic should be offered in non-hotel town")
    t1 = converse(w,kalamos_id,0,.lodging)
    low1 = lower(t1.text)
    assert(("no hotel" in low1 or "no inn" in low1) and ("lodger" in low1 or "spare room" in low1 or "travellers" in low1),t1.text)
    # 3. Good impression / grateful residents offer a spare room believably (not 100% of the time),
    # and accepting leads into family stay; cold impression never offers a room.
    offers = 0; non_offers = 0; offered_person = -1
    loop day in 0..10:
        w2 = build_world(u64(42))
        w2.minute += day * 1440
        loop q in w2.people:
            if q.id == 0 or q.home != 1 or q.place != 1 or q.occupation == .patrol or q.occupation == .pirate or q.occupation == .innkeeper or q.occupation == .hotelier: continue
            w2.people[0].pose.pos = q.pose.pos + vec3(1,0,0)
            w2.people[0].place = 1
            seed_relationship(w2,q.id,0)
            w2.relationships[w2.relationship_index[RelationshipKey(q.id,0)]].affinity = 45
            tr = converse(w2,q.id,0,.lodging)
            if tr.question_kind == .lodging_offer:
                offers += 1
                if offered_person < 0:
                    offered_person = q.id
                    ans = answer_conversation(w2,q.id,0,.reassure)
                    assert(ans.effect == "stay_family" and ans.text != "",ans.text)
            else:
                non_offers += 1
    assert(offers > 0 and non_offers > 0,"spare room offers should be believable, not never or always: offers={offers} non={non_offers}")
    # Cold impression never offers a spare room.
    w3 = build_world(u64(42))
    w3.people[0].pose.pos = w3.people[kalamos_id].pose.pos + vec3(1,0,0)
    w3.people[0].place = 1
    seed_relationship(w3,kalamos_id,0)
    w3.relationships[w3.relationship_index[RelationshipKey(kalamos_id,0)]].grievance = 400
    tc = converse(w3,kalamos_id,0,.lodging)
    assert(tc.question_kind != .lodging_offer and not ("stay with us" in lower(tc.text)),tc.text)
