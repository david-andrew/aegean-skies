# The landing grounds (src/airfields.jo): every strip holds the landplanes' take-off runs, the
# Orenthessa field the Bat Boat's on her wheels too (the Albatross uses the water); each field's
# stands, fuel point and windsocks are on it, and a landplane fetched home goes to the nearest.
# (The strips' level, their approaches and the buildings on the ground: tests/world_audit_test.jo.)
# env -u DISPLAY -u WAYLAND_DISPLAY SLOPPY_NO_AUDIO=1 SLOPPY_THREADS=1 sloppy test tests/landing_grounds_test.jo
import '../src/flight.jo' as fl
import '../src/tweaks.jo' as tw
import '../src/planes.jo' as planes
use '../src/world.jo'
use '../src/geography.jo'
use '../src/settlements.jo'
use '../src/airfields.jo'
use '../src/flight_ground.jo'

const K = 3.3
const FIELD = 60.0

_spec = (kind: planes.Craft) -> fl.CraftSpec:
    fl.set_speed_scale(K); fl.set_lift_scale(K)
    tw.set_tweaks(tw.Tweaks())
    k = fl.craft_spec(kind, planes.build_craft(kind, planes.LIVERIES[0]).contacts)
    k.player = true
    k

# A take-off on the mouse from rest over flat grass, the strip's heading held, the nose lifted once
# she is near her flying speed: the drawn distance from the start until her wheels are clear of the
# grass (a metre up, true), the rest of the climb out over the cleared ground beyond the strip's end.
_run = (kind: planes.Craft) -> f64:
    k = _spec(kind)
    e = fl.FlightEnv(ground = (x: f64, z: f64) -> f64: FIELD)
    s = fl.ground_start(k, vec3(0, f32(FIELD), 0)); s.gear = 1.0
    loop i in 0..120: fl.step(k, s, fl.Controls(gear = true), e, 1.0 / 60.0)
    a = s.position; h0 = fl.heading(s)
    loop i in 0..60 * 120:
        v = f64(length(s.velocity)) / K
        climb = if v > k.stall_speed * 0.85: 0.07 else: 0.0
        c = fl.steer(k, s, vec3(f32(sin(h0) * cos(climb)), f32(sin(climb)), f32(-cos(h0) * cos(climb))))
        c.throttle = 1.0; c.gear = true
        fl.step(k, s, c, e, 1.0 / 60.0)
        if not s.on_ground and f64(s.position.y) > FIELD + 1.0 * K: break
    assert(not s.crashed)
    f64(length((s.position - a).xz))

test "every strip holds the landplanes' take-off runs; Orenthessa's the Bat Boat's too":
    cr20 = _run(.fiat_cr20); chelidon = _run(.kea_chelidon); bat = _run(.sopwith_bat_boat); albatross = _run(.albatross)
    print("off the grass (drawn): C.R.20 {cr20:.0f} m, Chelidon {chelidon:.0f} m, Bat Boat {bat:.0f} m, Albatross {albatross:.0f} m")
    longest = 0.0
    loop f in AIRFIELDS:
        strip = f.half_length * 2.0
        print("{f.name}: {strip:.0f} m")
        assert(strip >= max(cr20, chelidon) * 1.05, "{f.name} is too short for the landplanes")
        longest = max(longest, strip)
    assert(AIRFIELDS[1].half_length * 2.0 >= bat * 1.05)
    # (the Albatross is a flying boat that has wheels: no field is hers)
    assert(albatross > longest)
    fl.set_speed_scale(1.0); tw.set_tweaks(tw.Tweaks())

test "each field's stands, fuel point and windsocks are on it, its strip clear of the others":
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]
        layout = airfield_layout(f)
        loop i in 0..layout.stands.len():
            assert(airfield_at(airfield_world(f, f64(layout.stands[i].x), f64(layout.stands[i].y))) == k)
        assert(airfield_at(airfield_world(f, f64(layout.fuel_stand.x), f64(layout.fuel_stand.y))) == k)
        loop s in airfield_socks(f): assert(airfield_at(airfield_world(f, f64(s.x), f64(s.y))) == k)
        # the turf under the stands and the fuel stand (aircraft stand on the apron), the strip's ends
        loop p in layout.stands + [layout.fuel_stand]:
            assert(f64(p.x) > f64(layout.apron.x) and f64(p.x) < f64(layout.apron.z) and f64(p.y) > f64(layout.apron.y) and f64(p.y) < f64(layout.apron.w))
        loop b in layout.buildings:
            # (behind the stands, off the strip)
            assert(b.v + b.depth * 0.5 < -f.half_width - 60.0)
        # (on the lattice and axis-aligned, so the turf lies on the terrain's cells)
        assert(abs(f64(f.center.x) / 14.0 - floor(f64(f.center.x) / 14.0 + 0.5)) < 1e-6 and abs(f64(f.center.y) / 14.0 - floor(f64(f.center.y) / 14.0 + 0.5)) < 1e-6)
        assert(f.heading == 0.0 or f.heading == PI * 0.5)
        loop j in 0..AIRFIELDS.len():
            if j != k: assert(length(AIRFIELDS[j].center - f.center) > 20000.0)

test "a landplane down anywhere is fetched to the nearest field; each serves a real town":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true; init_settlements()
    loop k in 0..AIRFIELDS.len():
        f = AIRFIELDS[k]
        # a few kilometres off each field, every way: that field is the nearest
        loop a in 0..8:
            p = f.center + vec2(f32(cos(f64(a) * PI / 4.0) * 6000.0), f32(sin(f64(a) * PI / 4.0) * 6000.0))
            assert(nearest_airfield(p) == k)
        town = -1
        loop i in 0..world_settlements.len():
            if world_settlements[i].id == f.place: town = i
        assert(town >= 0 and world_settlements[town].country == f.country and world_settlements[town].harbor.len() > 0)
        # (within an easy walk or a cart's ride of the town, never in it)
        d = f64(length(world_settlements[town].center.xz - f.center))
        print("{f.name}: {d:.0f} m from {world_settlements[town].name}")
        assert(d > 2000.0 and d < 8000.0 and airfield_at(world_settlements[town].center.xz) == -1)
    # halfway between the capitals' fields, the mail stop is the nearest
    assert(nearest_airfield((AIRFIELDS[0].center + AIRFIELDS[1].center) * 0.5) == 3)

# The ground the wheels run on down each strip, as the flight model meets it (src/pilot.jo): the
# drawn turf's own triangles, so its slope changes by no more than a few hundredths in a cell's length
# (the coast's sub-grid detail under the turf at the island fields broke it by up to a seventh, and
# a C.R.20's fuselage struck the grass on her run)
test "the wheels run on the drawn turf: every strip is smooth from end to end":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled = true; init_settlements()
    loop f in AIRFIELDS:
        worst = 0.0
        loop lane in [-14.0, 0.0, 14.0]:
            g = (u: f64) -> f64:
                p = airfield_world(f, u, lane)
                airfield_surface(f64(p.x), f64(p.y), flight_surface_height(f64(p.x), f64(p.y)))
            u = -f.half_length + 14.0
            loop u < f.half_length - 14.0:
                worst = max(worst, abs(g(u + 14.0) - 2.0 * g(u) + g(u - 14.0)) / 14.0)
                u += 7.0
        print("{f.name}: the slope changes by {worst * 100.0:.2f}% in 14 m at worst")
        assert(worst < 0.03)
