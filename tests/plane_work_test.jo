# Working on the aircraft by hand: from the quay when the job is within reach of it, otherwise
# aboard by the shortest step, climbing to the wing root for what is high and inboard.
use '../src/leisure.jo'
use '../src/plane_work.jo'

# the Gull's flat parts, hub, head and step-off point (src/planes.jo)
_gull = () -> CraftLayout:
    shade = [vec3(0, 0, 0.5), vec3(0.55, 0.6, 4.0), vec3(0, 1.55, -0.55), vec3(5.5, 0.08, 0.78), vec3(0, -0.5, -0.3), vec3(4.7, 0.07, 0.7), vec3(-1.55, -2.05, -0.4), vec3(0.42, 0.3, 3.2), vec3(1.55, -2.05, -0.4), vec3(0.42, 0.3, 3.2), vec3(0, 0.25, 4.0), vec3(1.7, 0.05, 0.45)]
    craft_layout(shade, vec3(0, 0, -3.95), 1.25, vec3(0, 1.0, 0.35), vec3(1.55, -1.7, -0.4))

# a straight quay along x, its edge at z = 0, its top at 1.2; one can stand within 3 m of a point
_quay = (p: vec3) -> vec3?:
    if f64(p.z) > 3.0: return none
    vec3(p.x, 1.2, min(p.z, 0.0))

# moored broadside, its right float toward the quay, the hull's origin 2.4 above the water
_broadside = () -> mat4: translation(vec3(0, 2.4, 3.6)) * rotation_y(PI * 0.5)
# moored nose-in, the propeller just off the quay's edge
_nose_in = () -> mat4: translation(vec3(0, 2.4, 4.4)) * rotation_y(0.0)

test "the layout has the floats, the lower wing's roots and the work places":
    l = _gull()
    assert(not l.boat)
    floats = 0; roots = 0
    loop s in l.surfaces:
        if s.kind == 0: floats += 1
        if s.kind == 1: roots += 1
        if s.kind == 0: assert(abs(f64(s.a.y) + 1.765) < 0.02)
    assert(floats == 2 and roots == 2)
    assert(abs(l.wing_y + 0.43) < 0.01 and l.tail_half.x > 1.0)

test "broadside: aboard by the near float; the windscreen from the wing root, the engine and the propeller from the float's nose":
    l = _gull(); frame = _broadside()
    b = choose_boarding(l, frame, _quay)
    assert(b.ok and l.surfaces[b.surface].kind == 0 and l.surfaces[b.surface].side > 0.0 and b.gap < 2.3)
    wipe = choose_stand(l, frame, task_stops(l, .wipe, 3, 1.0)[0], _quay)
    assert(not wipe.on_quay and not wipe.stretched and l.surfaces[wipe.surface].kind == 1)
    oil = choose_stand(l, frame, task_stops(l, .oil, 3, 1.0)[0], _quay)
    assert(not oil.on_quay and not oil.stretched and l.surfaces[oil.surface].kind == 0 and oil.spot.z < -2.5)
    polish = choose_stand(l, frame, task_stops(l, .polish, 3, 1.0)[0], _quay)
    assert(not polish.stretched and l.surfaces[polish.surface].kind == 0)
    # the way to the wing root: along the float, up the strut, onto the wing
    route = craft_route(l, b.surface, b.spot, wipe.surface, wipe.spot)
    assert(route.len() >= 3 and abs(f64(route[route.len() - 1].y) + 0.43) < 0.01)

test "inspecting crouches at the float struts and stands at the wing struts":
    l = _gull(); frame = _broadside()
    stops = task_stops(l, .inspect, 3, 1.0)
    assert(stops.len() >= 3)
    first = choose_stand(l, frame, stops[0], _quay)
    assert(first.pose == .crouch and not first.stretched)
    last = choose_stand(l, frame, stops[stops.len() - 1], _quay)
    assert(not last.stretched and last.pose != .crouch)

test "nose-in: the propeller is polished standing on the quay, no climbing":
    l = _gull(); frame = _nose_in()
    polish = choose_stand(l, frame, task_stops(l, .polish, 3, 1.0)[0], _quay)
    assert(polish.on_quay and abs(f64(polish.quay.y) - 1.2) < 0.001)

test "a patch goes to the damaged part, wherever it is":
    l = _gull(); frame = _broadside()
    left = choose_stand(l, frame, task_stops(l, .patch, 2, 1.0)[0], _quay)
    assert(left.target.x < 0.0 and left.spot.x < 0.0)
    tail = task_stops(l, .patch, 6, 1.0)[0]
    assert(tail.targets[0].z > 3.0)

test "a job's legs: ashore, aboard, to the stop, the work, back ashore":
    l = _gull()
    legs = plan_work(l, _broadside(), task_stops(l, .wipe, 3, 1.0), _quay)
    kinds = [loop g in legs: g.kind]
    assert(kinds == [LegKind.walk, .hop_on, .craft, .work, .craft, .hop_off])
    assert(legs[3].aboard and legs[3].seconds > 0.0)
    nose = plan_work(l, _nose_in(), task_stops(l, .polish, 3, 1.0), _quay)
    assert([loop g in nose: g.kind] == [LegKind.walk, .work] and not nose[1].aboard)
    # the far float's struts: over the fuselage and down the other side
    route = craft_route(l, 1, l.surfaces[1].a, 0, l.surfaces[0].a)
    top = 0
    loop p in route:
        if abs(f64(p.x)) < 0.01 and f64(p.y) > 0.5: top += 1
    assert(top == 1)

test "with no quay alongside, nothing is planned aboard":
    l = _gull()
    far = (p: vec3) -> vec3?: none
    legs = plan_work(l, _broadside(), task_stops(l, .wipe, 3, 1.0), far)
    assert(legs.len() == 0)

# the Heron, a flying boat with its engine in a pod over the wing
_heron = () -> CraftLayout:
    shade = [vec3(0, 0, 0.3), vec3(1.0, 0.8, 5.9), vec3(0, 2.3, -1.4), vec3(8.25, 0.1, 1.1), vec3(0, 1.2, 5.6), vec3(2.3, 0.06, 0.55), vec3(0, 3.35, -1.2), vec3(0.45, 0.45, 1.5)]
    craft_layout(shade, vec3(0, 3.35, -3.65), 1.4, vec3(0, 1.4, -3.4), vec3(0, 1.05, -1.0))

test "a flying boat: aboard onto the deck, up onto the wing to reach the engine in its pod":
    l = _heron()
    assert(l.boat and abs(l.wing_y - 2.4) < 0.01 and l.engine_radius < 0.5)
    frame = translation(vec3(0, 0.9, 2.6)) * rotation_y(PI * 0.5)
    b = choose_boarding(l, frame, _quay)
    assert(b.ok and l.surfaces[b.surface].kind == 2)
    oil = choose_stand(l, frame, task_stops(l, .oil, 3, 1.0)[0], _quay, 1.0)
    assert(not oil.on_quay and not oil.stretched and l.surfaces[oil.surface].kind == 1)
    legs = plan_work(l, frame, task_stops(l, .oil, 3, 1.0), _quay)
    assert([loop g in legs: g.kind] == [LegKind.walk, .hop_on, .craft, .work, .craft, .hop_off])
