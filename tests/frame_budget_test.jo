use '../src/world_point.jo'
use '../src/combat_trails.jo'
use '../src/frame_budget.jo'
use '../src/pilot.jo'
use '../src/planes.jo'
use '../src/flight.jo'
use '../src/world.jo'

test "hitches cannot accumulate more than three live-world ticks":
    spare=0.0; most=0
    loop i in 0..36000:
        dt=if i%71==0: 4.0 else: if i%17==0: 0.25 else: 1.0/60.0
        spare=frame_spare(spare,dt)
        ticks=0
        loop spare+1e-9>=FIXED_DT:
            spare=max(0.0,spare-FIXED_DT);ticks+=1
        most=max(most,ticks)
        assert(ticks<=FRAME_TICKS and spare<FIXED_DT)
    assert(most==3 and frame_dt(-1.0)==0)

test "exact camera spring decays after arbitrarily long frames":
    loop dt in [1.0/60.0,0.1,0.25,1.0,8.0]:
        p=vec3(1,-2,3);v=vec3(10,-30,50)
        initial=f64(dot(v,v)+dot(p,p)*121.0)
        loop i in 0..80:
            p,v=spring_vector(p,v,vec3(0,0,0),11.0,0.85,dt)
            energy=f64(dot(v,v)+dot(p,p)*121.0)
            assert(energy<=initial+0.01)
            initial=energy
        assert(length(p)<0.01 and length(v)<0.1)

test "chase has finite bounded state through recurring frame stalls":
    assert(load_land(embed('../assets/terrain.bin')))
    k=craft_spec(.gull,build_craft(.gull,LIVERIES[0]).contacts)
    s=CraftState(position=vec3(138000,460,-73000),velocity=vec3(0,0,-185))
    f=Flyer(kind=.gull,model=0,spec=k,state=s)
    clock=0.0;peak=0.0
    loop i in 0..12000:
        dt=if i%83==0: 2.0 else:if i%13==0:0.25 else:1.0/60.0
        clock+=dt
        f.state.velocity=vec3(sin(clock*0.7)*185.0,sin(clock)*25.0,-cos(clock*0.7)*185.0)
        f.state.orientation=quat_euler(0,clock*0.7,0.6*sin(clock))
        f.state.position+=f.state.velocity*f32(dt)
        chase(f,dt)
        peak=max(peak,f64(length(f.look_v)))
        assert(is_finite(f.look.x) and is_finite(f.cam_pos.x))
        assert(length(f.look_v)<20 and length(f.cam_ev)<10000)
        assert(abs(f64(length(f.look))-1)<0.0001)
    print("camera hitch stress: {clock:.1}s max look velocity={peak:.4}")

test "expired combat ribbons retire rather than filling the lifetime cap":
    tr=BattleTrails()
    loop i in 0..1000:
        push_battle_ribbon(tr,BattleRibbon(WorldPoint(0,0,0),WorldPoint(1,0,0),0,0.15,1,0,1),32)
        step_battle_trails(tr,vec3(1,0,0),1.0/60.0)
        assert(tr.ribbons.len()<=10)
    step_battle_trails(tr,vec3(1,0,0),1.0)
    assert(tr.ribbons.len()==0)
