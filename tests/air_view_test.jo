use '../src/air_view.jo'
use '../src/world_point.jo'
use '../src/traffic.jo'
use '../src/flight.jo'

test "distant cues fade with range and landing lights face the observer at dusk":
    s = CraftState(position = vec3(0, 300, 0), orientation = quat_euler(0, PI, 0))
    front = vec3(0, 300, 2000); sun = normalize(vec3(0, -0.1, -1))
    assert(air_cue(s, front, sun, .land, 1, 0).lamp > 0.9)
    assert(air_cue(s, front, sun, .cruise, 1, 0).lamp == 0)
    assert(air_cue(s, vec3(0, 300, -2000), sun, .land, 1, 0).lamp == 0)
    assert(air_cue(s, vec3(0, 300, 13000), sun, .land, 1, 0).dot == 0)
    assert(air_cue(s, vec3(0, 300, 200), sun, .land, 1, 0).dot == 0)
    glint = air_cue(s, s.position + vec3(0, 1200, 1600), normalize(vec3(0, 0.6, -0.8)), .cruise, 1, 0)
    assert(glint.glint > 0.9)
    s.on_water = true; assert(air_cue(s, front, sun, .land, 1, 0).lamp == 0)

test "exhaust histories stay bounded and handoff jumps never draw a long ribbon":
    v = AirView(); traffic: Traffic[]
    loop id in 0..40:
        traffic.push(Traffic(craft = id, kind = .gull, spec = craft_spec(.gull, []), state = CraftState(position = vec3(id * 30, 300, -2000), velocity = vec3(0, 0, -80), throttle = 0.7)))
    loop tick in 0..600:
        loop mut tr in traffic: tr.state.position += tr.state.velocity / 60.0
        update_air_view(v, traffic, vec3(2, 0, 0), vec3(0, 300, 0), 1.0 / 60.0)
    assert(v.exhaust.ribbons.len() <= 768 and v.exhaust.ribbons.len() > 100)
    loop mut tr in traffic: tr.state.position.x += 3000
    update_air_view(v, traffic, vec3(2, 0, 0), vec3(0, 300, 0), 0.6)
    loop ribbon in v.exhaust.ribbons: assert(length(world_delta(ribbon.b,ribbon.a)) < 100)
