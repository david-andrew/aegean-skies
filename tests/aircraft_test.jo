import '../src/planes.jo' as planes
import '../src/flight.jo' as fl
import '../src/living_types.jo' as living

_finite = (s: fl.CraftState):
    assert(abs(f64(s.position.x)) < 1e7 and abs(f64(s.position.y)) < 1e7 and abs(f64(s.position.z)) < 1e7)
    assert(abs(f64(length(s.orientation)) - 1.0) < 0.0001)

test "catalog IDs geometry damage and economy agree":
    assert(planes.CRAFT_NAMES.len() == living.AIRFRAMES.len() and planes.CRAFT_NAMES.len() == 16)
    loop id in 0..planes.CRAFT_NAMES.len():
        kind = planes.Craft(id); p = planes.aircraft_profile(kind)
        m = planes.build_craft(kind, planes.LIVERIES[0])
        k = fl.craft_spec(kind, m.contacts)
        a = living.AIRFRAMES[id]
        assert(str(kind) == str(living.Airframe(id)))
        assert(planes.DEFAULT_LIVERIES[id] == living.AIRFRAME_LIVERIES[id])
        assert(a.cruise_mps > 0 and a.price_cents > 0 and a.cargo_grams > 0 and a.tank_ml / a.burn_ml_sec > 700)
        assert(m.parts.len() == 7 and m.contacts.len() >= 6 and m.shade.len() % 2 == 0)
        assert(m.prop_hubs.len() == (if p.engine_x > 0: 2 else: 1))
        assert(m.cockpits.len() == p.cockpit_count)
        mass = 0.0; points = 0; vertices = 0
        loop part in m.parts:
            mass += part.spec.mass_share; points += part.spec.contacts.len(); vertices += part.mesh.count
            assert(part.mesh.count > 0 and part.spec.strength > 0)
        assert(abs(mass - 1) < 0.00001 and points == m.contacts.len() and vertices == m.body.count)
        loop c in m.contacts:
            owner = planes.contact_part(kind, c)
            assert(c in k.parts[owner].contacts)
            if id >= 4 and p.boat and abs(c.x) < p.width * 1.6: assert(owner == 0)
        print("{kind}: {m.body.count / 3} triangles, {m.prop_hubs.len()} props, {m.contacts.len()} contacts, {k.mass:.0}kg")

_exercise = (kind: planes.Craft, player: bool):
    fl.set_speed_scale(if player: 3.3 else: 1.0)
    m = planes.build_craft(kind, planes.LIVERIES[0])
    k = fl.craft_spec(kind, m.contacts); k.player = player
    e = fl.FlightEnv()
    # Calm-water settling verifies buoyancy and contact torque independently of the pilot.
    s = fl.water_start(k, vec3(0, 0, 0))
    loop i in 0..600: fl.step(k, s, fl.Controls(), e, 1.0 / 30.0)
    print("{kind} player={player} rest y={s.position.y:.3} expected={k.float_height:.3} speed={length(s.velocity):.3}")
    assert(abs(f64(s.position.y) - k.float_height) < 0.12 and length(s.velocity) < 0.1 and not s.crashed)
    # The production takeoff controller: no teleport or airborne reset before takeoff.
    s = fl.water_start(k, vec3(0, 0, 0))
    took_off = false; plan = fl.FlightPlan()
    loop i in 0..60 * 90:
        fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
        if not s.on_water and s.position.y > k.float_height + 5:
            took_off = true; break
    print("{kind} player={player} takeoff t={s.time:.2} distance={length(s.position.xz):.1} y={s.position.y:.1} damage={s.hull_damage:.4}")
    assert(took_off and not s.crashed and s.hull_damage < 0.01 and length(s.position.xz) < (if player: 5000 else: 1800))
    before = s.position.y
    loop i in 0..60 * 45:
        fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 60.0)
        if s.position.y > before + 60: break
    _finite(s)
    assert(s.position.y > before + 15 and not s.crashed)
    # A known level entry separates roll/yaw authority from takeoff trim.
    s = fl.CraftState(position = vec3(0, 500, 0), velocity = vec3(0, 0, -k.cruise_speed), fuel = k.fuel_capacity, throttle = 0.75)
    loop i in 0..120: fl.step(k, s, fl.Controls(throttle = 0.75, roll = 0.12, yaw = 0.2), e, 1.0 / 60.0)
    print("{kind} player={player} turn heading={fl.heading(s):.3} y={s.position.y:.1}")
    assert(fl.heading(s) > 0.05 and fl.heading(s) < 1.4 and s.position.y > 450 and not s.crashed)
    # The pure speed scale also scales the landing entry; water forces see the true speed.
    s = fl.CraftState(position = vec3(0, k.float_height + 3, 0), velocity = vec3(0, -0.6, -k.stall_speed * 1.15 * fl.pure_k(k)),
        orientation = quat_euler(-0.02, 0, 0), fuel = k.fuel_capacity)
    touched = false; rebound = 0.0
    loop i in 0..60 * 120:
        fl.step(k, s, fl.Controls(assist = 0, water_brake = 0.4), e, 1.0 / 60.0)
        if s.on_water: touched = true
        if touched: rebound = max(rebound, f64(s.velocity.y))
    print("{kind} player={player} landing y={s.position.y:.3} speed={length(s.velocity):.3} rebound={rebound:.2} damage={s.hull_damage:.4}")
    _finite(s)
    assert(touched and not s.crashed and s.hull_damage < 0.05 and rebound < 2)
    assert(abs(f64(s.position.y) - k.float_height) < 0.15 and length(s.velocity) < 0.2)
    fl.set_speed_scale(1.0)

test "tern NPC design speed takeoff climb turn water landing":
    _exercise(.tern, false)

test "tern player 3.3 scale takeoff climb turn water landing":
    _exercise(.tern, true)

