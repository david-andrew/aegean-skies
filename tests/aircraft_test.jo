test "amphibian gear extends folds and supports a rolling landing":
    fl.set_speed_scale(1)
    m = planes.build_craft(.albatross, planes.LIVERIES[0])
    k = fl.craft_spec(.albatross, m.contacts)
    assert(m.wheels.len() == 3 and k.gear_contacts.len() == 3)
    e = fl.FlightEnv(ground = (x: f64, z: f64) -> f64: 10.0)
    s = fl.CraftState(position = vec3(0, 13.3, 0), velocity = vec3(0, -0.3, -8), fuel = k.fuel_capacity, gear = 1)
    loop i in 0..60 * 20: fl.step(k, s, fl.Controls(gear = true, water_brake = 0.5), e, 1.0 / 60.0)
    print("gear landing y={s.position.y:.3} velocity={s.velocity} damage={s.hull_damage:.5} ground={s.on_ground} beach={s.beached}")
    assert(s.on_ground and not s.beached and not s.crashed and s.hull_damage < 0.01)
    assert(s.position.y > 12.3 and s.position.y < 13.3 and length(s.velocity) < 0.2)
    z = s.position.z
    loop i in 0..60 * 8: fl.step(k, s, fl.Controls(gear = true, throttle = 0.12), e, 1.0 / 60.0)
    assert(s.position.z < z - 2 and not s.crashed)
    # Check the actuator independently of ground contact: no retraction while sitting on it.
    s.position.y = 300; s.velocity = vec3(0, 0, -k.cruise_speed)
    loop i in 0..180: fl.step(k, s, fl.Controls(throttle = 0.75, gear = false), fl.FlightEnv(), 1.0 / 60.0)
    assert(s.gear == 0)
    a = planes.wheel_frame(m.wheels[0], 0) * vec4(0, -2.85, 0, 1)
    b = planes.wheel_frame(m.wheels[0], 1) * vec4(0, -2.85, 0, 1)
    assert(a.y > b.y + 2)

test "every new NPC airframe completes a five kilometre trip and docks":
    fl.set_speed_scale(1)
    loop id in 4..planes.CRAFT_NAMES.len():
        kind = planes.Craft(id); model = planes.build_craft(kind, planes.LIVERIES[0])
        k = fl.craft_spec(kind, model.contacts); s = fl.water_start(k, vec3(0, 0, 0))
        e = fl.FlightEnv(); plan = fl.FlightPlan()
        loop i in 0..30 * 650:
            fl.step(k, s, fl.autopilot(k, s, plan, e), e, 1.0 / 30.0)
            if plan.phase == .done or plan.phase == .failed or s.crashed: break
        print("catalog route {kind}: {plan.phase} time={s.time:.1} landing error={length(plan.touchdown.xz-plan.target.xz):.1} dock={length(s.position.xz-plan.taxi_target.xz):.2} damage={s.hull_damage:.4}")
        assert(plan.phase == .done and s.moored and not s.crashed and s.hull_damage < 0.1)
        assert(length(plan.touchdown.xz - plan.target.xz) < 300 and length(s.position.xz - plan.taxi_target.xz) < 10)

import '../src/living_seed.jo' as seed
import '../src/living_save.jo' as save

test "new saved identities and role assignments validate without replacing people":
    seen = fill(false, planes.CRAFT_NAMES.len())
    loop n in 0..12:
        w = seed.build_world(u64(n))
        assert(w.people.len() == 26 and w.aircraft.len() == 8)
        assert(save.validate_save_world(w) == "")
        loop c in w.aircraft: seen[int(c.kind)] = true
    loop id in 4..planes.CRAFT_NAMES.len(): assert(seen[id])
    loop id in 0..planes.CRAFT_NAMES.len():
        w = seed.build_world()
        w.aircraft[0].kind = living.Airframe(id)
        raw = save.canonical_text(w)
        decoded = from_text[living.World](raw)
        assert(decoded is living.World)
        assert(save.validate_save_world(decoded) == "" and int(decoded.aircraft[0].kind) == id)
