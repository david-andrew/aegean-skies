use '../src/combat.jo'
use '../src/flight.jo'
use '../src/frame_budget.jo'

test "fixed tick formation draws advance smoothly at 144 Hz instead of alternating held poses":
    k=craft_spec(.gull,[])
    a=Combatant(1,1,0,k,CraftState(position=vec3(138000,440,-73000),velocity=vec3(0,0,-180)),previous=vec3(138000,440,-73000),render_ready=true)
    spare=0.0;last=a.state.position;last_raw=last;worst=0.0;raw_worst=0.0
    loop frame in 0..1440:
        dt=1.0/144.0;spare+=dt
        loop spare>=FIXED_DT:
            a.previous=a.state.position;a.previous_rotation=a.state.orientation
            a.state.position+=a.state.velocity*f32(FIXED_DT)
            spare-=FIXED_DT
        before=a
        drawn=combat_render_state(a,spare/FIXED_DT)
        if frame>5:
            wanted=180.0*dt
            worst=max(worst,abs(f64(last.z-drawn.position.z)-wanted))
            raw_worst=max(raw_worst,abs(f64(last_raw.z-a.state.position.z)-wanted))
        assert(a==before)
        last=drawn.position;last_raw=a.state.position
    print("formation 144Hz: interpolated delta error={worst:.6}m fixed-only={raw_worst:.6}m")
    assert(worst<0.02 and raw_worst>1.0)

test "render rotations take short arc and human poses have no extra latency":
    a=Combatant(1,1,0,craft_spec(.gull,[]),CraftState(position=vec3(3,0,0),orientation=-quat_euler(0.1,0,0)),previous=vec3(0,0,0),render_ready=true)
    s=combat_render_state(a,0.5)
    assert(abs(s.position.x-1.5)<0.001 and abs(length(s.orientation)-1)<0.001)
    assert(abs(forward(s).y-sin(0.05))<0.001)
    a.external=true;a.human=true
    assert(combat_render_state(a,0.1)==a.state)

import 'scenarios_test.jo' as fixture
use '../src/traffic.jo'
use '../src/scenarios.jo'
use '../src/planes.jo'
use '../src/tweaks.jo'
import '../src/living_scene.jo' as scene

test "actual scenario adapter and presentation keep a formation leader smooth between combat ticks":
    s=fixture.scenario_fixture();w=s.world;b=s.battle;f=s.flyer
    set_tweaks(Tweaks())
    models=build_craft_models();adapter=scene.SceneAdapter();traffic=make_living_traffic(w,models)
    last=b.actors[0].state.position;last_raw=last;worst=0.0;raw=0.0
    loop i in 0..240:
        update_traffic(traffic,w,adapter,f.state.position,f64(i)/144.0,1.0/144.0,f.state,[],b)
        commit_scenario_aircraft(w,b)
        projected=scenario_air_traffic(w,b)
        before=b.actors[0].state
        drawn=combat_render_state(b.actors[0],b.render_alpha)
        if i>8:
            expected=before.velocity/f32(144)
            worst=max(worst,f64(length(drawn.position-last-expected)))
            raw=max(raw,f64(length(before.position-last_raw-expected)))
        assert(b.actors[0].state==before)
        assert(projected[0].state.position==drawn.position)
        assert(b.physics_steps<=15 and adapter.frame_ticks<=1)
        last=drawn.position;last_raw=before.position
    print("scenario formation: 144Hz frame displacement error interpolated={worst:.5}m tick-only={raw:.5}m")
    assert(worst<0.08 and raw>1)
    set_speed_scale(1)
