use '../src/combat.jo'
use '../src/flight.jo'
use '../src/frame_budget.jo'

test "fixed tick formation draws advance smoothly at 144 Hz instead of alternating held poses":
    k=craft_spec(.gull,[])
    a=Combatant(1,1,0,k,CraftState(position=vec3(138000,440,-73000),velocity=vec3(0,0,-180)),previous=vec3(138000,440,-73000),render_ready=true)
    spare=0.0;last=a.state.position;last_raw=last;worst=0.0;raw_worst=0.0
    loop frame in 0..1440:
        dt=1.0/144.0;spare+=dt
        loop spare>=FIXED_DT:
            a.previous=a.state.position;a.previous_rotation=a.state.orientation
            a.state.position+=a.state.velocity*f32(FIXED_DT)
            spare-=FIXED_DT
        before=a
        drawn=combat_render_state(a,spare/FIXED_DT)
        if frame>5:
            wanted=180.0*dt
            worst=max(worst,abs(f64(last.z-drawn.position.z)-wanted))
            raw_worst=max(raw_worst,abs(f64(last_raw.z-a.state.position.z)-wanted))
        assert(a==before)
        last=drawn.position;last_raw=a.state.position
    print("formation 144Hz: interpolated delta error={worst:.6}m fixed-only={raw_worst:.6}m")
    assert(worst<0.02 and raw_worst>1.0)

test "render rotations take short arc and human poses have no extra latency":
    a=Combatant(1,1,0,craft_spec(.gull,[]),CraftState(position=vec3(3,0,0),orientation=-quat_euler(0.1,0,0)),previous=vec3(0,0,0),render_ready=true)
    s=combat_render_state(a,0.5)
    assert(abs(s.position.x-1.5)<0.001 and abs(length(s.orientation)-1)<0.001)
    assert(abs(forward(s).y-sin(0.05))<0.001)
    a.external=true;a.human=true
    assert(combat_render_state(a,0.1)==a.state)
