use '../src/town_region.jo'
use '../src/settlements.jo'
use '../src/town_sites.jo'
use '../src/town_architecture.jo'
use '../src/port_mesh.jo'

test "regional styles remain distinct without extra per-house meshes":
    flat1=0;flat2=0
    loop seed in 0..240:
        if town_roof_flat(seed,1):flat1+=1
        if town_roof_flat(seed,2):flat2+=1
        assert(town_joinery(seed,1)!=0)
        assert(town_joinery(seed,2)!=2)
        assert(town_joinery(seed,0)==(seed/19)%3)
        assert(town_roof_flat(seed,0)==(seed%4==0))
    assert(flat1==30 and flat2==210)
    assert(town_service_flat(24,2,true) and not town_service_flat(24,1,true))
    assert(town_floor_height(1)>town_floor_height(2))
    assert(town_floor_height(0)==4)

test "new cornices and parapets have thickness and butt joints at far coordinates":
    loop country in [1,2]:
        loop flat in [false,true]:
            s=TownSite(vec3(237640,18,182720),0,14,12,9,25,2,flat,country=country)
            parts: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
            origin=vec3(237568,0,182272)
            arch_regional(parts,s,origin)
            assert(parts[16].len()==4)
            long=parts[16][2].model;short=parts[16][3].model
            # Side cap meets, but does not overlap, the front cap.
            assert(abs(transform_point(long,vec3(0,0,-0.5)).z-transform_point(short,vec3(0,0,0.5)).z)<0.001)
            loop inst in parts[16]:
                assert(length(inst.model[3].xz)<1024)
                assert(inst.model[1].y>=0.24)
                # Every outer face clears the wall; no replacement plinth.
                assert(inst.model[3].y>25)

test "warehouse window reveals clear old panes at every detail level":
    s=TownSite(vec3(237640,18,182720),0,24,16,11,25,2,false,service=true,door_y=18,country=2,warehouse=true)
    origin=vec3(237568,0,182272)
    parts: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
    arch_warehouse(parts,s,origin)
    pal=town_joinery(s.seed,s.country)
    assert(parts[pal].len()==3 and parts[3+pal].len()==1)
    loop lod in 0..3:
        reveal= -1000.0
        loop v in arch_vertices(pal,lod):
            if v.color==rgb(0.15,0.20,0.21):
                reveal=max(reveal,f64(transform_point(parts[pal][0].model,v.pos).z))
        old=f64(s.at.z-origin.z)+s.depth*0.5+0.11
        assert(reveal-old>0.17)

use '../src/town_details.jo'
use '../src/world.jo'
use '../src/geography.jo'

test "dirt and stone junctions have real vertical separation at country scale":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    a=vec2(237610,182745);b=a+vec2(7,2);origin=vec3(237568,0,182272)
    dirt: Vertex3D[];stone: Vertex3D[]
    town_path(dirt,a,b,3,false,origin)
    town_path(stone,a,b,3,true,origin)
    assert(dirt.len()>0 and stone.len()==dirt.len())
    loop k in 0..stone.len():
        assert(length(stone[k].pos.xz-dirt[k].pos.xz)<0.001)
        assert(abs(stone[k].pos.y-dirt[k].pos.y-0.04)<0.0001)

test "farm enclosure has rooted walls open gates and bounded planting":
    assert(load_land(embed('../assets/terrain.bin')))
    assert(load_geography(embed('../assets/world.bin')))
    geography_enabled=true
    s=TownSite(vec3(-236348,147.3167,-187209),0,12,10,6,17,country=1,rural=2)
    bounds=site_farm_yard(s)!
    assert(bounds==vec4(-14,-15,14,11))
    origin=vec3(-236544,0,-187392)
    parts: Instance3D[][]=[loop k in 0..ARCH_COUNT: []]
    props: Instance3D[][]=[loop k in 0..TOWN_PROP_COUNT: []]
    paths: Vertex3D[]
    arch_farmstead(parts,props,paths,s,true,origin)
    assert(parts[15].len()>30 and parts[15].len()<60)
    assert(props[10].len()==2 and paths.len()>0)
    loop inst in parts[15]:
        assert(length(inst.model[3].xz)<1024)
        # No wall crosses the centre of either walking gate.
        p=inst.model[3].xyz+origin
        gate=site_point(s,-s.width*0.2,if p.z<s.at.z:bounds.y else:bounds.w)
        assert(length(p.xz-gate)>1.7)
    loop inst in props[10]:
        p=inst.model[3].xyz+origin
        assert(abs(f64(p.y)-place_ground(p.xz))<0.001)
    s.rural=0;assert(site_farm_yard(s)==none)
