use '../src/flight_instruments.jo'
use '../src/flight.jo'
use '../src/planes.jo'

test "attitude follows pitch bank and upside down without changing flight":
    k=craft_spec(.gull,[])
    loop bank in [-2.8,-0.6,0.0,0.6,2.8]:
        s=CraftState(orientation=quat_euler(0.3,0,-bank),velocity=vec3(0,0,-60))
        before=s;d=FlightInstruments();instrument_step(d,k,s,1.0/60.0)
        assert(abs(d.pitch-0.3)<0.0001 and abs(d.bank-bank)<0.0001 and s==before)
        sky=horizon_half(d.pitch,d.bank,true);earth=horizon_half(d.pitch,d.bank,false)
        assert(sky.len()>2 and earth.len()>2)
        loop p in sky:assert(length(p)<=1.00001)
        loop p in earth:assert(length(p)<=1.00001)

test "turn ball centers in coordinated turn and deflects under lateral force":
    k=craft_spec(.gull,[]);k.handling_scale=3.3
    d=FlightInstruments();s=CraftState();speed=60.0;bank=0.4
    rate=FLIGHT_G*tan(bank)/speed
    loop i in 0..600:
        h=rate*f64(i)/60.0
        s.orientation=quat_euler(0,-h,-bank)
        s.velocity=heading_vector(h)*f32(speed*3.3)
        instrument_step(d,k,s,1.0/60.0)
    assert(abs(d.turn-rate)<0.0001 and abs(d.slip)<0.01)
    # Hold the same bank while accelerating to its left: the ball rolls right.
    h=heading(s);right=quat_rotate(s.orientation,vec3(1,0,0))
    loop i in 0..120:
        s.velocity-=right*f32(3.3*3.0/60.0)
        instrument_step(d,k,s,1.0/60.0)
    assert(d.slip>0.8)
