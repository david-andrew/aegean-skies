use '../src/living_types.jo'
use '../src/living_seed.jo'
use '../src/living_commands.jo'
use '../src/living_travel.jo'
use '../src/living_money.jo'
use '../src/living_sim.jo'

test "scene outcomes reject stale writes and abstract clock never burns their fuel":
    w = build_world()
    c = 1; w.aircraft[c].move_owner = .scene
    before = w.aircraft[c].fuel_ml
    pose = w.aircraft[c].pose
    revision = w.aircraft[c].revision
    assert(commit_scene_motion(w,c,revision,0,pose,before-10,850,850) >= 0)
    assert(commit_scene_motion(w,c,revision,0,pose,before-20,850,850) == -1)
    advance_minutes(w,1)
    assert(w.aircraft[c].fuel_ml == before-10)
    revision = w.aircraft[c].revision
    assert(commit_scene_motion(w,c,revision,w.tick,pose,before,850,850) == -1)
    assert(not commit_arrival(w,0,0,2,revision))
    pose.pos = w.harbors[0].docks[2]; pose.vel = vec3(0,0,0)
    revision = commit_scene_motion(w,c,revision,w.tick,pose,before-20,850,850)
    assert(revision >= 0 and commit_arrival(w,0,0,2,revision))
    assert(w.jobs[0].paid_cents == 1200 and money_balances(w) and goods_balance(w))

# Explicitly import the pure registry transaction; this is no scene/Pool/LOD adapter.
use '../src/living_pirates.jo'

test "physical encounter preserves already committed damage and resolves once":
    w = build_world()
    point = vec3(-2000,500,3000)
    w.trips[1] = Trip(id=1,actor=22,craft=6,mode=.aircraft,state=.active,origin=5,destination=5,reason=Reason(purpose=.raid,actor=22,counterparty=8,origin=5,destination=5),route=[point,point+vec3(1000,0,0)],cruise_mm_per_sec=65000)
    w.trips[2] = Trip(id=2,actor=8,craft=2,mode=.aircraft,state=.active,origin=3,destination=0,reason=w.jobs[1].cause,route=[point,point+vec3(1000,0,0)],cruise_mm_per_sec=55000)
    w.next_trip = 3
    w.encounters[0] = Encounter(id=0,raider_trip=1,victim_trip=2,started_tick=0,deadline_tick=1200)
    w.next_encounter = 1
    w.aircraft[6].move_owner = .scene; w.aircraft[2].move_owner = .scene
    rp = Pose(pos=point); vp = Pose(pos=point+vec3(100,0,0))
    rr = commit_scene_motion(w,6,w.aircraft[6].revision,0,rp,29990,500,500)
    vr = commit_scene_motion(w,2,w.aircraft[2].revision,0,vp,69990,700,600)
    assert(rr >= 0 and vr >= 0 and commit_encounter(w,0,rr,vr,false))
    assert(w.aircraft[6].hull == 500 and w.aircraft[6].engine == 500)
    assert(w.aircraft[2].hull == 700 and w.aircraft[2].engine == 600)
    assert(not commit_encounter(w,0,rr,vr,true))
    assert(money_balances(w) and goods_balance(w))
