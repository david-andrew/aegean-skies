# A player-owned landplane (the Fiat C.R.20) parked on an airfield saves and loads as it stood:
# its identity, its exact physical state on its wheels (not moved to a dock, not afloat), and it
# goes on standing there after the load.
# SLOPPY_THREADS=1 sloppy test tests/landplane_save_test.jo
use '../src/game_session.jo'
use '../src/living_seed.jo'
use '../src/living_save_codec.jo'
use '../src/living_save.jo'
use '../src/living_types.jo'
use '../src/living_scene.jo'
use '../src/traffic.jo'
use '../src/pilot.jo'
use '../src/flight.jo'
use '../src/planes.jo'
use '../src/world_point.jo'
use '../src/combat.jo'
use '../src/vessel_types.jo'
use '../src/war_checkpoint.jo'
use '../src/airfields.jo'

const FIELD = 163.0
_field = () -> FlightEnv: FlightEnv(ground = (x: f64, z: f64) -> f64: FIELD)

_parked = () -> (World, GameSession, SceneAdapter):
    w = build_world(u64(42)); c = w.people[w.player].craft
    w.aircraft[c].kind = .fiat_cr20
    model = default_craft_model(.fiat_cr20)
    w.aircraft[c].model_index = model
    w.aircraft[c].livery_index = DEFAULT_LIVERIES[int(Craft.fiat_cr20)]
    spec = craft_spec(.fiat_cr20, build_craft(.fiat_cr20, LIVERIES[0]).contacts)
    f = AIRFIELDS[0]
    at = vec3(f.center.x - 150.0, f32(FIELD), f.center.y + 200.0)
    st = ground_start(spec, at, airfield_stand_heading(f))
    loop i in 0..240: step(spec, st, Controls(), _field(), 1.0 / 60.0)
    flyer = Flyer(.fiat_cr20, model, spec, st, cam_pos = st.position)
    flyer.spec.player = true
    flyer.spec.fuel_capacity = f64(AIRFRAMES[int(Airframe.fiat_cr20)].tank_ml) / 1000.0
    flyer.state.fuel = f64(w.aircraft[c].fuel_ml) / 1000.0
    w.aircraft[c].state = .moored
    w.aircraft[c].pose.pos = flyer.state.position
    adapter = SceneAdapter()
    w.aircraft[c].scene_extension = to_text(flyer.state); w.aircraft[c].scene_extension_tick = w.tick
    bind_living_player(flyer, w, adapter)
    session = GameSession(flyer = flyer, player_position = flyer.state.position, player_point = world_point(flyer.state.position), player_mode = 1, world_time = 30.0)
    (w, session, adapter)

test "a parked C.R.20 saves and loads standing on its wheels at the airfield":
    p = _parked(); w = p.0; session = p.1; adapter = p.2
    before = session.flyer.state
    assert(before.on_ground and not before.on_water and not before.moored and length(before.velocity) < 0.05)
    assert(validate_save_world(w) == "")
    game = capture_game(w, PresentationState(), session, [], adapter, VesselFleet(), Battle(), 123, SaveSummary())
    assert(game is SaveGame)
    packed = pack_binary_living_save(game); restored = unpack_binary_living_save(packed.0, packed.1)
    assert(restored != none)
    runtime = read_game_session(restored!)
    assert(runtime is GameSession)
    after = runtime.flyer.state
    c = restored!.world.people[restored!.world.player].craft
    assert(restored!.world.aircraft[c].kind == .fiat_cr20 and runtime.flyer.kind == .fiat_cr20 and runtime.flyer.spec.landplane)
    assert(after.position == before.position and after.orientation == before.orientation and after.on_ground and after.gear == 1.0)
    assert(after.fuel == before.fuel)
    # the loaded aircraft goes on standing where it was, just as the one that was saved
    a = before; b = after
    loop i in 0..300:
        step(session.flyer.spec, a, Controls(), _field(), 1.0 / 60.0)
        step(runtime.flyer.spec, b, Controls(), _field(), 1.0 / 60.0)
    assert(a.position == b.position and length(b.velocity) < 0.05 and length(b.position - before.position) < 0.05 and not b.crashed)
